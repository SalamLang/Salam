package archive

import compress
import filepath
import mem
import os
import str

const _ZIPF_TAIL := 131072

@en "ZipFile"
@fa "پرونده زیپ"
pub struct ZipFile:
    @en "path"
    @fa "مسیر"
    pub path: str = ""
    @en "count"
    @fa "شمار"
    pub count: i64 = 0 as i64
    @en "size"
    @fa "اندازه"
    pub size: i64 = 0 as i64
    @en "status"
    @fa "وضعیت"
    pub status: int = 0
    @en "password"
    @fa "گذرواژه"
    pub password: str = ""
    @en "cd"
    @fa "فهرست مرکزی"
    pub cd: compress.ByteBuf = compress.ByteBuf { data = null, len = 0, cap = 0 }
    @en "volumes"
    @fa "قطعه ها"
    pub volumes: Vector<str> = Vector {} as Vector<str>
    @en "starts"
    @fa "آغازها"
    pub starts: Vector<i64> = Vector {} as Vector<i64>
    @en "by_disk"
    @fa "شماره قرص"
    pub by_disk: bool = false
    @en "cd_start"
    @fa "آغاز فهرست"
    pub cd_start: i64 = 0 as i64
end

func _zipf_num2(i: int): str:
    d := str.FromInt(i as i64)
    if i < 10:
        r := "0" + d
        mem.Free(d as void*)
        ret r
    end
    ret d
end

func _zipf_ci_ends(p: str, suffix: str): bool:
    lo := str.Lower(p)
    ok := str.EndsWith(lo, suffix)
    mem.Free(lo as void*)
    ret ok
end

func _zipf_is_digit(c: int): bool:
    ret c >= 48 and c <= 57
end

func _zipf_split_vols(zf &: ZipFile):
    p := zf.path
    n := p.Len()
    pb := p as u8*
    mut ds := n
    until ds > 0 and _zipf_is_digit(pb[ds - 1] as int):
        ds--
    end
    if ds < n and n - ds >= 3 and n - ds <= 9 and ds >= 5:
        head := str.Substr(p, 0, ds)
        ok := _zipf_ci_ends(head, ".zip.")
        if ok:
            width := n - ds
            ns := str.Substr(p, ds, width)
            first := str.ToInt(ns)
            mem.Free(ns as void*)
            mut idx := first
            until idx < 100000:
                mut digits := str.FromInt(idx as i64)
                until digits.Len() < width:
                    grown := "0" + digits
                    mem.Free(digits as void*)
                    digits = grown
                end
                v := head + digits
                mem.Free(digits as void*)
                if not os.Exists(v):
                    mem.Free(v as void*)
                    break
                end
                zf.volumes.push(v)
                idx++
            end
        end
        mem.Free(head as void*)
        if zf.volumes.Len() > 0:
            ret
        end
    end
    mut main := str.Clone(p)
    mut stem := ""
    if n >= 4 and _zipf_ci_ends(p, ".zip"):
        stem = str.Substr(p, 0, n - 4)
    else n >= 4 and (pb[n - 3] == 122 or pb[n - 3] == 90) and pb[n - 4] == 46 and _zipf_is_digit(pb[n - 2] as int) and _zipf_is_digit(pb[n - 1] as int):
        stem = str.Substr(p, 0, n - 4)
        up := pb[n - 3] == 90
        mem.Free(main as void*)
        main = stem + (up ? ".ZIP" : ".zip")
    end
    if stem.Len() == 0:
        mem.Free(main as void*)
        ret
    end
    mb := main as u8*
    mn := main.Len()
    up := mb[mn - 1] == 80
    zl := up ? ".Z" : ".z"
    mut idx := 1
    until idx < 100000:
        d2 := _zipf_num2(idx)
        v := stem + zl + d2
        mem.Free(d2 as void*)
        if not os.Exists(v):
            mem.Free(v as void*)
            break
        end
        zf.volumes.push(v)
        idx++
    end
    if zf.volumes.Len() > 0:
        zf.volumes.push(main)
        zf.by_disk = true
        mem.Free(zf.path as void*)
        zf.path = str.Clone(main)
    else:
        mem.Free(main as void*)
    end
    mem.Free(stem as void*)
end

func _zipf_open(zf: ZipFile): void*:
    if zf.volumes.Len() > 1:
        ret compress.MultiOpenRead(zf.volumes)
    end
    ret compress.FileOpenRead(zf.path)
end

func _zipf_start(zf: ZipFile, disk: int): i64:
    if not zf.by_disk:
        ret 0
    end
    if disk < 0 or disk >= zf.starts.Len():
        ret -1
    end
    ret zf.starts.get(disk)
end

func _zipf_fix(zf: ZipFile, r &: _ZipRec): bool:
    if not zf.by_disk:
        ret true
    end
    s := _zipf_start(zf, r.disk)
    if s < (0 as i64):
        ret false
    end
    r.local += s
    ret true
end

func _zipf_read_cd(fp: void*, zf &: ZipFile, cd_off: i64, csize: i64): bool:
    if cd_off < (0 as i64) or csize < (0 as i64) or cd_off + csize > zf.size or csize > (2000000000 as i64):
        ret false
    end
    zf.cd = compress.NewByteBufCap(csize as int)
    if csize > (0 as i64):
        got := compress.FileReadAt(fp, cd_off, zf.cd.data, csize as int)
        if (got as i64) != csize:
            ret false
        end
    end
    zf.cd.len = csize as int
    ret true
end

func _zipf_decode(fp: void*, off: i64, comp: i64, method: int, uncomp: i64, sink &: compress.FileSink): int:
    mut ok := true
    if method == ZipMethodStore:
        ok = comp == uncomp and compress.SinkCopyFrom(sink, fp, off, comp)
    else method == ZipMethodDeflate or method == ZipMethodDeflate64:
        mut br := compress.NewFileBitReader(fp, off, comp)
        ok = not br.bad and compress.RawInflateToSink(br, sink, method == ZipMethodDeflate64)
        compress.FileBitReaderFree(br)
    else method == ZipMethodBzip2:
        ok = compress.Bzip2FileToSink(fp, off, comp, sink) == compress.DecodeOk
    else method == ZipMethodZstd:
        ok = compress.ZstdFileToSink(fp, off, comp, sink, 0 as i64) == compress.ZstdOk
    else method == ZipMethodLzma:
        if comp < (14 as i64):
            ret ZIP_CORRUPT
        end
        hd := mem.Allocate(9 as u64)
        got := compress.FileReadAt(fp, off, hd, 9)
        good := got == 9 and LEGet16(hd, 2) == 5
        if not good:
            mem.Free(hd)
            ret ZIP_CORRUPT
        end
        props := ((hd as i64) + (4 as i64)) as void*
        code := compress.LzmaFileToSink(props, 5, fp, off + (9 as i64), comp - (9 as i64), uncomp, sink, 0 as i64)
        mem.Free(hd)
        if code == 2:
            ret ZIP_TOO_BIG
        end
        ok = code == 0
    else:
        lim := 2147483647 as i64
        if comp > lim or uncomp > lim:
            ret ZIP_TOO_BIG
        end
        packed := mem.Allocate((comp + (1 as i64)) as u64)
        ok = compress.FileReadAt(fp, off, packed, comp as int) == (comp as int)
        mut res := compress.NewByteBuf()
        if ok:
            ok = _zip_unpack_ext(method, packed, comp as int, uncomp as int, res) == ZIP_OK
        end
        mem.Free(packed)
        if ok:
            ok = compress.SinkWrite(sink, res.data, res.len)
        end
        compress.BufFree(res)
    end
    if sink.over:
        ret ZIP_TOO_BIG
    end
    if sink.failed:
        ret ZIP_IO
    end
    if not ok or sink.written != uncomp:
        ret ZIP_CORRUPT
    end
    ret ZIP_OK
end

func _zipf_to_sink(fp: void*, size: i64, r: _ZipRec, password: str, sink &: compress.FileSink): int:
    enc := (r.flags & 1) != 0
    if enc and password.Len() == 0:
        ret ZIP_ENCRYPTED
    end
    mut method := r.method
    if enc and r.method == 99:
        method = r.aes_method
    end
    if not _zip_readable_method(method):
        ret ZIP_UNSUPPORTED
    end
    if r.uncomp < (0 as i64) or r.comp < (0 as i64) or r.local < (0 as i64) or r.local + (30 as i64) > size:
        ret ZIP_CORRUPT
    end
    if sink.cap > (0 as i64) and r.uncomp > sink.cap:
        ret ZIP_TOO_BIG
    end
    hdr := mem.Allocate(30 as u64)
    got := compress.FileReadAt(fp, r.local, hdr, 30)
    mut data_start := 0 as i64
    mut good := got == 30 and LEGet32(hdr, 0) == 0x04034b50
    if good:
        data_start = r.local + (30 as i64) + (LEGet16(hdr, 26) as i64) + (LEGet16(hdr, 28) as i64)
        good = data_start + r.comp <= size
    end
    mem.Free(hdr)
    if not good:
        ret ZIP_CORRUPT
    end
    mut st := ZIP_OK
    if not enc:
        st = _zipf_decode(fp, data_start, r.comp, method, r.uncomp, sink)
    else:
        tmp := _zc_open_tmp()
        dlen := _zc_decrypt_file(fp, data_start, r.comp, r, password, tmp)
        if dlen < (0 as i64):
            st = (0 as i64 - dlen) as int
        else:
            fp2 := compress.FileOpenRead(tmp)
            if fp2 == null:
                st = ZIP_IO
            else:
                st = _zipf_decode(fp2, 0 as i64, dlen, method, r.uncomp, sink)
                compress.FileClose(fp2)
            end
            os.Remove(tmp)
        end
        mem.Free(tmp as void*)
    end
    if st != ZIP_OK:
        ret st
    end
    if not (enc and r.method == 99 and r.aes_ver == 2) and sink.crc != r.crc:
        ret ZIP_BAD_CRC
    end
    ret ZIP_OK
end

func _zipf_write_one(fp: void*, size: i64, r: _ZipRec, outpath: str, cap: i64, password: str): int:
    mut sink := compress.SinkOpen(outpath, cap)
    if sink.failed:
        ret ZIP_IO
    end
    st := _zipf_to_sink(fp, size, r, password, sink)
    closed := compress.SinkClose(sink)
    if st == ZIP_OK and not closed:
        os.Remove(outpath)
        ret ZIP_IO
    end
    if st != ZIP_OK:
        os.Remove(outpath)
    end
    ret st
end

@en "ZipOpenFile"
@fa "بازکردن پرونده زیپ"
pub func ZipOpenFile(path: str): ZipFile:
    mut zf := ZipFile { path = str.Clone(path), status = ZIP_CORRUPT }
    _zipf_split_vols(zf)
    if zf.volumes.Len() > 1:
        mut total := 0 as i64
        repeat zf.volumes.Len() in vi:
            zf.starts.push(total)
            total += os.FileSize(zf.volumes.get(vi))
        end
    end
    fp := _zipf_open(zf)
    if fp == null:
        zf.status = ZIP_IO
        ret zf
    end
    zf.size = compress.FileSize(fp)
    mut tn := _ZIPF_TAIL
    if (tn as i64) > zf.size: tn = zf.size as int end
    if tn < 22:
        compress.FileClose(fp)
        ret zf
    end
    tail := mem.Allocate(tn as u64)
    got := compress.FileReadAt(fp, zf.size - (tn as i64), tail, tn)
    mut eocd := 0
    mut found := got == tn and _zip_find_eocd(tail, tn, eocd)
    if found:
        mut count := LEGet16(tail, eocd + 10) as i64
        mut cd_off := _zip_u32(tail, eocd + 16)
        mut cd_disk := LEGet16(tail, eocd + 6)
        mut this_disk := LEGet16(tail, eocd + 4)
        mut csize := _zip_u32(tail, eocd + 12)
        ffff := 0xFFFF as i64
        ffffffff := 0xFFFFFFFF as i64
        if count == ffff or cd_off == ffffffff or csize == ffffffff:
            if eocd >= 20 and LEGet32(tail, eocd - 20) == 0x07064b50:
                mut z := _zip_get64(tail, eocd - 12)
                zs := _zipf_start(zf, LEGet32(tail, eocd - 16))
                rec := mem.Allocate(56 as u64)
                if zs < (0 as i64) or z < (0 as i64):
                    z = -1
                else:
                    z += zs
                end
                if z >= (0 as i64) and compress.FileReadAt(fp, z, rec, 56) == 56 and LEGet32(rec, 0) == 0x06064b50:
                    count = _zip_get64(rec, 32)
                    csize = _zip_get64(rec, 40)
                    cd_off = _zip_get64(rec, 48)
                    cd_disk = LEGet32(rec, 20)
                    this_disk = LEGet32(rec, 16)
                else:
                    found = false
                end
                mem.Free(rec)
            end
        end
        if found and this_disk > 0 and (zf.volumes.Len() == 0 or (zf.by_disk and zf.volumes.Len() != this_disk + 1)):
            found = false
            zf.status = ZIP_MULTIVOLUME
        end
        cds := _zipf_start(zf, cd_disk)
        if cds < (0 as i64):
            found = false
        else:
            cd_off += cds
        end
        if found and count >= (0 as i64) and _zipf_read_cd(fp, zf, cd_off, csize):
            zf.count = count
            zf.cd_start = cd_off
            zf.status = ZIP_OK
        end
    end
    mem.Free(tail)
    compress.FileClose(fp)
    ret zf
end

@en "ZipFileClose"
@fa "بستن پرونده زیپ"
pub func ZipFileClose(zf &: ZipFile):
    compress.BufFree(zf.cd)
    if zf.path.Len() > 0:
        mem.Free(zf.path as void*)
    end
    zf.path = ""
    zf.count = 0 as i64
    if zf.password.Len() > 0:
        mem.Free(zf.password as void*)
    end
    zf.password = ""
    repeat zf.volumes.Len() in vi:
        mem.Free(zf.volumes.get(vi) as void*)
    end
    zf.volumes.Free()
    zf.starts.Free()
end

@en "ZipFileSetPassword"
@fa "تنظیم گذرواژه پرونده زیپ"
pub func ZipFileSetPassword(zf &: ZipFile, password: str):
    if zf.password.Len() > 0:
        mem.Free(zf.password as void*)
    end
    zf.password = ""
    if password.Len() > 0:
        zf.password = str.Clone(password)
    end
end

@en "ZipFileEntries"
@fa "مدخل های پرونده زیپ"
pub func ZipFileEntries(zf &: ZipFile): Vector<Entry>:
    mut out := Vector {} as Vector<Entry>
    if zf.status != ZIP_OK:
        ret out
    end
    mut pos := 0
    mut k := 0 as i64
    until k < zf.count:
        mut r := _ZipRec {}
        if not _zip_rec(zf.cd.data, zf.cd.len, pos, r):
            zf.status = ZIP_CORRUPT
            break
        end
        out.push(_zip_entry_of(r))
        pos = r.next
        k++
    end
    ret out
end

@en "ZipFileExtractTo"
@fa "استخراج از پرونده زیپ به پرونده"
pub func ZipFileExtractTo(zf &: ZipFile, name: str, destpath: str, cap: i64): int:
    if zf.status != ZIP_OK:
        ret zf.status
    end
    fp := _zipf_open(zf)
    if fp == null:
        ret ZIP_IO
    end
    mut pos := 0
    mut k := 0 as i64
    mut st := ZIP_NOT_FOUND
    until k < zf.count:
        mut r := _ZipRec {}
        if not _zip_rec(zf.cd.data, zf.cd.len, pos, r):
            st = ZIP_CORRUPT
            break
        end
        hit := r.name == name
        if hit and not _zipf_fix(zf, r):
            st = ZIP_CORRUPT
        else hit:
            st = _zipf_write_one(fp, zf.size, r, destpath, cap, zf.password)
        end
        _zip_free_name(r.name)
        if hit:
            break
        end
        pos = r.next
        k++
    end
    compress.FileClose(fp)
    ret st
end

@en "ZipFileExtractAll"
@fa "استخراج همه از پرونده زیپ"
pub func ZipFileExtractAll(zf &: ZipFile, destdir: str, cap: i64): int:
    if zf.status != ZIP_OK:
        ret zf.status
    end
    fp := _zipf_open(zf)
    if fp == null:
        ret ZIP_IO
    end
    mut first := ZIP_OK
    mut pos := 0
    mut k := 0 as i64
    until k < zf.count:
        mut r := _ZipRec {}
        if not _zip_rec(zf.cd.data, zf.cd.len, pos, r):
            if first == ZIP_OK: first = ZIP_CORRUPT end
            break
        end
        mut st := ZIP_OK
        if not _zipf_fix(zf, r):
            st = ZIP_CORRUPT
        else not _safe_entry_name(r.name):
            st = ZIP_UNSAFE_PATH
        else:
            outpath := filepath.Join(destdir, r.name)
            if _zip_is_dir_name(r.name):
                EnsureDir(outpath)
            else:
                parent := filepath.Dir(outpath)
                EnsureDir(parent)
                mem.Free(parent as void*)
                st = _zipf_write_one(fp, zf.size, r, outpath, cap, zf.password)
                if st == ZIP_OK:
                    when := _zip_dos_to_unix(r.dos_date, r.dos_time)
                    if when > (0 as i64): _tar_set_mtime(outpath, when) end
                end
            end
            mem.Free(outpath as void*)
        end
        if st != ZIP_OK and first == ZIP_OK:
            first = st
        end
        _zip_free_name(r.name)
        pos = r.next
        k++
    end
    compress.FileClose(fp)
    ret first
end
