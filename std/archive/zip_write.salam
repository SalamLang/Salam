package archive

import compress
import mem
import os

struct _ZipW:
    pub fp: void*
    pub out: compress.ByteBuf*
    pub pos: i64
    pub central: compress.ByteBuf
    pub count: int
    pub failed: bool
end

struct _ZwMem:
    pub p: u8*
    pub n: i64
end

func _zw_raw(w &: _ZipW, p: void*, n: int):
    if w.failed or n <= 0:
        ret
    end
    if w.out != null:
        before := w.out[0].len
        compress.BufPushBytes(w.out[0], p, n)
        if w.out[0].len != before + n:
            w.failed = true
            ret
        end
        w.pos += n as i64
        ret
    end
    if (fwrite(p, 1 as u64, n as u64, w.fp) as int) != n:
        w.failed = true
        ret
    end
    w.pos += n as i64
end

func _zw_enc_kind(f: ZipFileInput): int:
    if f.password.Len() == 0:
        ret 0
    end
    if f.encryption == ZipEncZipCrypto:
        ret 1
    end
    if f.encryption == ZipEncAes128 or f.encryption == ZipEncAes192:
        ret f.encryption
    end
    ret ZipEncAes256
end

func _zw_overhead(enc: int): i64:
    if enc == 0:
        ret 0
    end
    if enc == 1:
        ret 12
    end
    slen := enc == ZipEncAes128 ? 8 : (enc == ZipEncAes192 ? 12 : 16)
    ret slen + 2 + 10
end

func _zw_crc_of_file(src: void*, size: i64, scratch: void*): i64:
    mut crc := 0 as u32
    mut at := 0 as i64
    until at < size:
        mut want := 262144
        if size - at < (want as i64):
            want = (size - at) as int
        end
        got := compress.FileReadAt(src, at, scratch, want)
        if got != want:
            ret -1
        end
        crc = compress.CRC32Update(crc, scratch, got)
        at += got as i64
    end
    ret crc as i64
end

func _zw_mem_read(o: i64, d: void*, n: int, c: void*): int:
    m := c as _ZwMem*
    if o < (0 as i64) or o >= m[0].n:
        ret 0
    end
    mut k := n
    if (k as i64) > m[0].n - o:
        k = (m[0].n - o) as int
    end
    mem.Copy(d, ((m[0].p as i64) + o) as void*, k as u64)
    ret k
end

func _zw_patch_comp(w &: _ZipW, hdr: i64, name_len: int, big: bool, comp: i64): bool:
    mut b := compress.NewByteBuf()
    mut at := hdr + (18 as i64)
    if big:
        at = hdr + (30 as i64) + (name_len as i64) + (12 as i64)
        _zip_put64(b, comp)
    else:
        LEPut32(b, comp as int)
    end
    if w.out != null:
        if at + (b.len as i64) > (w.out[0].len as i64):
            compress.BufFree(b)
            ret false
        end
        mem.Copy(((w.out[0].data as i64) + at) as void*, b.data, b.len as u64)
        compress.BufFree(b)
        ret true
    end
    mut ok := compress.FileSeek(w.fp, at)
    if ok:
        ok = (fwrite(b.data, 1 as u64, b.len as u64, w.fp) as int) == b.len
    end
    if ok:
        ok = compress.FileSeek(w.fp, w.pos)
    end
    compress.BufFree(b)
    ret ok
end

func _zw_emit(p: void*, n: int, c: void*): bool:
    cw := c as _ChunkWriter*
    ret _cw_write(cw[0], p, n)
end

func _zw_pack(cw &: _ChunkWriter, method: int, level: int, src: void*, size: i64): bool:
    holder := mem.AllocateZeroed(sizeof(_ChunkWriter)) as _ChunkWriter*
    holder[0] = cw
    emit := (p: void*, n: int, c: void*): ret _zw_emit(p, n, c) end
    mut sink := compress.SinkCallback(0 as i64, emit, holder as void*)
    mut ok := true
    if method == ZipMethodBzip2:
        ok = compress.Bzip2CompressFileToSink(src, 0 as i64, size, level >= 1 and level <= 9 ? level : 9, sink)
    else method == ZipMethodZstd:
        ok = compress.ZstdCompressFileToSink(src, 0 as i64, size, level >= 1 ? level : 3, sink)
    else:
        mut head := compress.NewByteBuf()
        compress.BufPush(head, 9)
        compress.BufPush(head, 4)
        LEPut16(head, 5)
        ok = _cw_write(holder[0], head.data, head.len)
        compress.BufFree(head)
        if ok:
            ok = compress.LzmaCompressFileToSink(src, 0 as i64, size, level >= 1 and level <= 9 ? level : 6, true, sink)
        end
    end
    cw = holder[0]
    mem.Free(holder as void*)
    ret ok and not cw.failed
end

func _zw_feed(cw &: _ChunkWriter, src: void*, size: i64, scratch: void*): bool:
    mut at := 0 as i64
    mut ok := true
    until at < size and ok:
        mut want := 262144
        if size - at < (want as i64):
            want = (size - at) as int
        end
        got := compress.FileReadAt(src, at, scratch, want)
        if got != want:
            ok = false
        else:
            ok = _cw_write(cw, scratch, got)
            at += got as i64
        end
    end
    ret ok
end

func _zw_entry(w &: _ZipW, f: ZipFileInput, force64: bool, scratch: void*): bool:
    name_len := f.name.Len()
    if name_len > 65535 or f.data_len < 0 or (f.path.Len() == 0 and f.data_ptr == null and f.data_len > 0):
        ret false
    end
    enc := _zw_enc_kind(f)
    mut method := _zip_known_method(f.method) ? f.method : 0
    ptr := f.data_ptr
    mut size := f.data_len as i64
    mut src := null as void*
    if f.path.Len() > 0:
        src = compress.FileOpenRead(f.path)
        if src == null:
            ret false
        end
        size = compress.FileSize(src)
        if size < (0 as i64):
            compress.FileClose(src)
            ret false
        end
    end
    if method != ZipMethodDeflate and size == (0 as i64):
        method = ZipMethodStore
    end
    streamed := method == ZipMethodBzip2 or method == ZipMethodZstd or method == ZipMethodLzma
    mut memctx := null as void*
    if streamed and src == null:
        mc := mem.AllocateZeroed(sizeof(_ZwMem)) as _ZwMem*
        mc[0].p = ptr as u8*
        mc[0].n = size
        memctx = mc as void*
        rd := (o: i64, d: void*, n: int, c: void*): ret _zw_mem_read(o, d, n, c) end
        src = compress.CallbackOpenRead(size, rd, memctx)
    end

    mut crc := 0 as u32
    mut dd := false
    mut ok := true
    if method == ZipMethodDeflate and (w.out == null or src != null or enc != 0):
        dd = true
    else:
        if src != null:
            c := _zw_crc_of_file(src, size, scratch)
            if c < (0 as i64):
                ok = false
            else:
                crc = c as u32
            end
        else:
            crc = compress.CRC32(ptr, size as int)
        end
    end

    mut dd_date := 0
    mut dd_time := 0
    _zip_unix_to_dos(f.mtime, dd_date, dd_time)
    big := force64 or size >= (0xF0000000 as i64) or size >= (0xF0000000 as i64)
    offset := w.pos
    flags := (_zip_has_high(f.name) ? 0x800 : 0) | (dd ? 8 : 0) | (enc != 0 ? 1 : 0)
    mut version := big ? 45 : 20
    if method == ZipMethodBzip2 and version < 46:
        version = 46
    else method == ZipMethodLzma or method == ZipMethodZstd:
        version = 63
    end
    if enc >= 2 and version < 51:
        version = 51
    end
    method_field := enc >= 2 ? 99 : method
    aes_strength := enc == ZipEncAes128 ? 1 : (enc == ZipEncAes192 ? 2 : 3)
    store_crc := enc >= 2 ? (0 as u32) : crc
    late := streamed or (method == ZipMethodDeflate and not dd)
    comp_known := late ? (0 as i64) : size + _zw_overhead(enc)

    mut lh := compress.NewByteBuf()
    LEPut32(lh, 0x04034b50)
    LEPut16(lh, version)
    LEPut16(lh, flags)
    LEPut16(lh, method_field)
    LEPut16(lh, dd_time)
    LEPut16(lh, dd_date)
    LEPut32(lh, dd ? 0 : (store_crc as int))
    mut extra := compress.NewByteBuf()
    if big:
        if dd:
            LEPut32(lh, 0)
            LEPut32(lh, 0)
        else:
            LEPut32(lh, -1)
            LEPut32(lh, -1)
        end
        LEPut16(extra, 1)
        LEPut16(extra, 16)
        _zip_put64(extra, dd ? (0 as i64) : size)
        _zip_put64(extra, dd ? (0 as i64) : comp_known)
    else:
        LEPut32(lh, dd ? 0 : (comp_known as int))
        LEPut32(lh, dd ? 0 : (size as int))
    end
    mut aes_extra := compress.NewByteBuf()
    if enc >= 2:
        LEPut16(aes_extra, 0x9901)
        LEPut16(aes_extra, 7)
        LEPut16(aes_extra, 2)
        compress.BufPush(aes_extra, 65)
        compress.BufPush(aes_extra, 69)
        compress.BufPush(aes_extra, aes_strength)
        LEPut16(aes_extra, method)
    end
    LEPut16(lh, name_len)
    LEPut16(lh, extra.len + aes_extra.len)
    compress.BufPushBytes(lh, f.name as void*, name_len)
    compress.BufPushBuf(lh, extra)
    compress.BufPushBuf(lh, aes_extra)
    _zw_raw(w, lh.data, lh.len)
    compress.BufFree(lh)

    mut cw := _cw_open(w.fp, method == ZipMethodDeflate ? _CW_DEFLATE : _CW_RAW, 0)
    if w.out != null:
        cw.mem = w.out
        cw.failed = false
    end
    cw.failed = cw.failed or w.failed or not ok
    if enc != 0 and not cw.failed:
        check := dd ? ((dd_time >> 8) & 255) : (((crc as int) >> 24) & 255)
        ok = _ze_begin(cw, enc, f.password, check)
    end
    if cw.failed:
        ok = false
    end
    if ok:
        if method == ZipMethodDeflate:
            if src != null:
                ok = _zw_feed(cw, src, size, scratch)
            else:
                ok = _cw_write(cw, ptr, size as int)
            end
            if ok:
                crc = cw.in_crc
            end
        else streamed:
            ok = _zw_pack(cw, method, f.level, src, size)
        else:
            if src != null:
                ok = _zw_feed(cw, src, size, scratch)
            else:
                ok = _cw_write(cw, ptr, size as int)
            end
        end
    end
    if ok:
        if method == ZipMethodDeflate:
            _cw_flush(cw, true)
        end
        _ze_end(cw)
        ok = not cw.failed
    end
    comp_total := cw.out_size
    mut uncomp_total := cw.in_size
    if method != ZipMethodDeflate:
        uncomp_total = size
    end
    w.pos += comp_total
    if late and ok:
        ok = _zw_patch_comp(w, offset, name_len, big, comp_total)
    end
    if not ok:
        w.failed = true
    end
    if cw.buf != null:
        mem.Free(cw.buf)
        cw.buf = null
    end
    compress.BitWriterFree(cw.w)
    if src != null:
        compress.FileClose(src)
    end
    if memctx != null:
        mem.Free(memctx)
    end
    if not ok:
        compress.BufFree(extra)
        compress.BufFree(aes_extra)
        ret false
    end

    final_crc := enc >= 2 ? (0 as u32) : crc
    if dd:
        mut d := compress.NewByteBuf()
        LEPut32(d, 0x08074b50)
        LEPut32(d, final_crc as int)
        if big:
            _zip_put64(d, comp_total)
            _zip_put64(d, uncomp_total)
        else:
            LEPut32(d, comp_total as int)
            LEPut32(d, uncomp_total as int)
        end
        _zw_raw(w, d.data, d.len)
        compress.BufFree(d)
    end

    mut cd := w.central
    need_size := big or uncomp_total >= (0xFFFFFFFF as i64) or comp_total >= (0xFFFFFFFF as i64)
    need_off := force64 or offset >= (0xFFFFFFFF as i64)
    mut cx := compress.NewByteBuf()
    if need_size or need_off:
        mut inner := compress.NewByteBuf()
        if need_size:
            _zip_put64(inner, uncomp_total)
            _zip_put64(inner, comp_total)
        end
        if need_off:
            _zip_put64(inner, offset)
        end
        LEPut16(cx, 1)
        LEPut16(cx, inner.len)
        compress.BufPushBuf(cx, inner)
        compress.BufFree(inner)
        if version < 45:
            version = 45
        end
    end
    compress.BufPushBuf(cx, aes_extra)
    LEPut32(cd, 0x02014b50)
    LEPut16(cd, version)
    LEPut16(cd, version)
    LEPut16(cd, flags)
    LEPut16(cd, method_field)
    LEPut16(cd, dd_time)
    LEPut16(cd, dd_date)
    LEPut32(cd, final_crc as int)
    LEPut32(cd, need_size ? -1 : (comp_total as int))
    LEPut32(cd, need_size ? -1 : (uncomp_total as int))
    LEPut16(cd, name_len)
    LEPut16(cd, cx.len)
    LEPut16(cd, 0)
    LEPut16(cd, 0)
    LEPut16(cd, 0)
    LEPut32(cd, 0)
    LEPut32(cd, need_off ? -1 : (offset as int))
    compress.BufPushBytes(cd, f.name as void*, name_len)
    compress.BufPushBuf(cd, cx)
    w.central = cd
    w.count++
    compress.BufFree(cx)
    compress.BufFree(extra)
    compress.BufFree(aes_extra)
    ret true
end

func _zip_check_mem(files: Vector<ZipFileInput>): bool:
    mut mem_total := 0 as i64
    mut v := 0
    until v < files.Len():
        f := files.Get(v)
        if f.path.Len() == 0:
            mem_total += (f.data_len as i64) + (f.name.Len() as i64) * (2 as i64) + (200 as i64)
        end
        v++
    end
    if mem_total > (1900000000 as i64):
        ret false
    end
    ret true
end

func _zip_write_fp(files: Vector<ZipFileInput>, fp: void*, out: compress.ByteBuf*, force64: bool): bool:
    mut w := _ZipW { fp = fp, out = out, pos = 0 as i64, central = compress.NewByteBuf(), count = 0, failed = false }
    scratch := mem.Allocate(262144 as u64)
    mut ok := true
    mut i := 0
    until i < files.Len() and ok:
        ok = _zw_entry(w, files.Get(i), force64, scratch)
        i++
    end
    mem.Free(scratch)
    if ok:
        cd_offset := w.pos
        cd_size := w.central.len as i64
        _zw_raw(w, w.central.data, w.central.len)
        wide := force64 or w.count >= 0xFFFF or cd_offset >= (0xFFFFFFFF as i64)
        mut t := compress.NewByteBuf()
        if wide:
            LEPut32(t, 0x06064b50)
            _zip_put64(t, 44 as i64)
            LEPut16(t, 45)
            LEPut16(t, 45)
            LEPut32(t, 0)
            LEPut32(t, 0)
            _zip_put64(t, w.count as i64)
            _zip_put64(t, w.count as i64)
            _zip_put64(t, cd_size)
            _zip_put64(t, cd_offset)
            LEPut32(t, 0x07064b50)
            LEPut32(t, 0)
            _zip_put64(t, w.pos)
            LEPut32(t, 1)
        end
        LEPut32(t, 0x06054b50)
        LEPut16(t, 0)
        LEPut16(t, 0)
        LEPut16(t, wide ? 0xFFFF : w.count)
        LEPut16(t, wide ? 0xFFFF : w.count)
        LEPut32(t, wide ? -1 : (cd_size as int))
        LEPut32(t, wide ? -1 : (cd_offset as int))
        LEPut16(t, 0)
        _zw_raw(w, t.data, t.len)
        compress.BufFree(t)
        ok = not w.failed
    end
    compress.BufFree(w.central)
    ret ok
end

func _zip_stream(files: Vector<ZipFileInput>, outpath: str, force64: bool): bool:
    if not _zip_check_mem(files):
        ret false
    end
    fp := compress.FileOpenWrite(outpath)
    if fp == null:
        ret false
    end
    mut ok := _zip_write_fp(files, fp, null as compress.ByteBuf*, force64)
    if fclose(fp) != 0:
        ok = false
    end
    if not ok:
        os.Remove(outpath)
    end
    ret ok
end

func _zip_stream_mem(files: Vector<ZipFileInput>, force64: bool): compress.ByteBuf:
    if not _zip_check_mem(files):
        ret compress.NewByteBuf()
    end
    holder := mem.AllocateZeroed(sizeof(compress.ByteBuf)) as compress.ByteBuf*
    holder[0] = compress.NewByteBuf()
    ok := _zip_write_fp(files, null, holder, force64)
    mut out := holder[0]
    mem.Free(holder as void*)
    if not ok:
        compress.BufFree(out)
        ret compress.NewByteBuf()
    end
    ret out
end
