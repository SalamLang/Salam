package archive

import compress

@en "ZstdCompressFile"
@fa "فشرده سازی پرونده زستد"
pub func ZstdCompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut out := compress.ZstdCompress(inbuf.data, inbuf.len)
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(inbuf)
    compress.BufFree(out)
    ret wok
end

@en "ZstdCompressFileLevel"
@fa "فشرده سازی پرونده زستد با سطح"
pub func ZstdCompressFileLevel(inpath: str, outpath: str, level: int): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut out := compress.ZstdCompressLevel(inbuf.data, inbuf.len, level)
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(inbuf)
    compress.BufFree(out)
    ret wok
end

@en "ZstdDecompressFile"
@fa "کدگشایی پرونده زستد"
pub func ZstdDecompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut zok := false
    mut out := compress.ZstdDecompress(inbuf.data, inbuf.len, zok)
    compress.BufFree(inbuf)
    if not zok:
        compress.BufFree(out)
        ret false
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok
end
