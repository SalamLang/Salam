package archive

import compress
import os

@en "ZstdCompressFile"
@fa "فشرده سازی پرونده زستد"
pub func ZstdCompressFile(inpath: str, outpath: str): bool:
    ret _cw_compress_path(inpath, outpath, _CW_ZSTD, 3)
end

@en "ZstdCompressFileLevel"
@fa "فشرده سازی پرونده زستد با سطح"
pub func ZstdCompressFileLevel(inpath: str, outpath: str, level: int): bool:
    ret _cw_compress_path(inpath, outpath, _CW_ZSTD, level < 1 ? 1 : level)
end

@en "ZstdDecompressFileCap"
@fa "کدگشایی پرونده زستد با سقف"
pub func ZstdDecompressFileCap(inpath: str, outpath: str, cap: i64): int:
    fp := compress.FileOpenRead(inpath)
    if fp == null:
        ret ARCHIVE_IO_ERROR
    end
    mut sink := compress.SinkOpen(outpath, cap)
    if sink.failed:
        compress.FileClose(fp)
        ret ARCHIVE_IO_ERROR
    end
    code := compress.ZstdFileToSink(fp, 0 as i64, compress.FileSize(fp), sink, 0 as i64)
    closed := compress.SinkClose(sink)
    compress.FileClose(fp)
    mut st := ARCHIVE_OK
    if code == compress.ZstdErrTooBig:
        st = ARCHIVE_TOO_BIG
    else sink.failed or (code == compress.ZstdOk and not closed):
        st = ARCHIVE_IO_ERROR
    else code != compress.ZstdOk:
        st = ARCHIVE_CORRUPT
    end
    if st != ARCHIVE_OK:
        os.Remove(outpath)
    end
    ret st
end

@en "ZstdDecompressFile"
@fa "کدگشایی پرونده زستد"
pub func ZstdDecompressFile(inpath: str, outpath: str): bool:
    ret ZstdDecompressFileCap(inpath, outpath, 0 as i64) == ARCHIVE_OK
end
