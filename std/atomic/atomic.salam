@en "atomic"
@fa "اتمی"
@ar "ذري"
package atomic

import mem
import sync

/*
 * Atomic cells with the usual load/store/add/swap/compare-and-swap surface.
 *
 * Two implementations sit behind one API.
 *
 * Everywhere except tcc, each operation is a single instruction: the compiler
 * lowers atomic_load/store/add/swap/cas to a __atomic_* builtin in the C
 * backend and to a real atomicrmw/cmpxchg in the LLVM one, both seq_cst. No
 * lock is taken and no mutex is allocated, so a cell is exactly 8 bytes.
 *
 * tcc 0.9.27 has neither the __atomic nor the __sync family - it parses the
 * name as an implicit declaration and then fails to link - so under
 * SALAM_CC_TCC a cell carries its own mutex instead. Same semantics, higher
 * cost, and the difference is invisible to callers.
 *
 * A cell is a handle either way: copying it copies a reference to the same
 * underlying value, which is what lets one live in a global or travel to a
 * worker inside a struct passed to spawn(f, arg).
 */
@en "I64"
@fa "صحیح۶۴"
@ar "صحيح٦٤"
pub struct I64:
    pub cell: i64* = null
    pub mu: sync.Mutex = sync.Mutex {}
end

@en "Flag"
@fa "پرچم"
@ar "راية"
pub struct Flag:
    pub cell: i64* = null
    pub mu: sync.Mutex = sync.Mutex {}
end

if defined(SALAM_CC_TCC):
    func cell_new(v: i64): I64:
        c := mem.AllocateZeroed(8 as u64) as i64*
        c[0] = v
        ret I64 { cell = c, mu = sync.NewMutex() }
    end

    func cell_load(a: I64): i64:
        c := a.cell
        sync.Lock(a.mu)
        v := c[0]
        sync.Unlock(a.mu)
        ret v
    end

    func cell_store(a: I64, v: i64):
        c := a.cell
        sync.Lock(a.mu)
        c[0] = v
        sync.Unlock(a.mu)
    end

    func cell_add(a: I64, delta: i64): i64:
        c := a.cell
        sync.Lock(a.mu)
        c[0] = c[0] + delta
        v := c[0]
        sync.Unlock(a.mu)
        ret v
    end

    func cell_swap(a: I64, v: i64): i64:
        c := a.cell
        sync.Lock(a.mu)
        old := c[0]
        c[0] = v
        sync.Unlock(a.mu)
        ret old
    end

    func cell_cas(a: I64, expected: i64, next: i64): bool:
        c := a.cell
        sync.Lock(a.mu)
        mut won := false
        if c[0] == expected:
            c[0] = next
            won = true
        end
        sync.Unlock(a.mu)
        ret won
    end

    func cell_free(a: I64):
        mem.Free(a.cell as void*)
        sync.Destroy(a.mu)
    end
else:
    func cell_new(v: i64): I64:
        c := mem.AllocateZeroed(8 as u64) as i64*
        atomic_store(c, v)
        ret I64 { cell = c, mu = sync.Mutex {} }
    end

    func cell_load(a: I64): i64: ret atomic_load(a.cell) end

    func cell_store(a: I64, v: i64): atomic_store(a.cell, v) end

    func cell_add(a: I64, delta: i64): i64: ret atomic_add(a.cell, delta) end

    func cell_swap(a: I64, v: i64): i64: ret atomic_swap(a.cell, v) end

    func cell_cas(a: I64, expected: i64, next: i64): bool:
        ret atomic_cas(a.cell, expected, next)
    end

    func cell_free(a: I64): mem.Free(a.cell as void*) end
end

@en "NewI64"
@fa "صحیح۶۴ جدید"
@ar "صحيح٦٤ جديد"
pub func NewI64(v: i64): I64: ret cell_new(v) end

@en "Load"
@fa "بارگذاری"
@ar "تحميل"
pub func Load(a: I64): i64: ret cell_load(a) end

@en "Store"
@fa "ذخیره"
@ar "تخزين"
pub func Store(a: I64, v: i64): cell_store(a, v) end

// Returns the value *after* the addition, so a counter can both increment and
// learn its own ticket number in one indivisible step.
@en "Add"
@fa "افزودن"
@ar "إضافة"
pub func Add(a: I64, delta: i64): i64: ret cell_add(a, delta) end

@en "Swap"
@fa "تعویض"
@ar "تبديل"
pub func Swap(a: I64, v: i64): i64: ret cell_swap(a, v) end

/*
 * Sets the cell to `next` only if it currently holds `expected`, reporting
 * whether it did. This is the primitive the others cannot express: it lets a
 * caller build a retry loop that is safe against another thread changing the
 * value in between the read and the write.
 */
@en "CompareAndSwap"
@fa "مقایسه و تعویض"
@ar "مقارنة وتبديل"
pub func CompareAndSwap(a: I64, expected: i64, next: i64): bool:
    ret cell_cas(a, expected, next)
end

@en "DestroyI64"
@fa "نابودسازی صحیح۶۴"
@ar "تدمير صحيح٦٤"
pub func DestroyI64(a: I64): cell_free(a) end

@en "NewFlag"
@fa "پرچم جدید"
@ar "راية جديدة"
pub func NewFlag(v: bool): Flag:
    mut n := 0 as i64
    if v: n = 1 end
    c := cell_new(n)
    ret Flag { cell = c.cell, mu = c.mu }
end

@en "Get"
@fa "گرفتن"
@ar "جلب"
pub func Get(f: Flag): bool:
    ret cell_load(I64 { cell = f.cell, mu = f.mu }) != 0
end

@en "Set"
@fa "تنظیم"
@ar "ضبط"
pub func Set(f: Flag, v: bool):
    mut n := 0 as i64
    if v: n = 1 end
    cell_store(I64 { cell = f.cell, mu = f.mu }, n)
end

/*
 * Raises the flag and reports whether this call is the one that raised it.
 * Exactly one caller ever sees true, which is what makes it usable as a
 * cancellation signal: the winner runs the shutdown path, everyone else
 * silently observes that it is already under way.
 */
@en "TestAndSet"
@fa "آزمون و تنظیم"
@ar "اختبار وضبط"
pub func TestAndSet(f: Flag): bool:
    ret cell_cas(I64 { cell = f.cell, mu = f.mu }, 0 as i64, 1 as i64)
end

@en "DestroyFlag"
@fa "نابودسازی پرچم"
@ar "تدمير الراية"
pub func DestroyFlag(f: Flag):
    cell_free(I64 { cell = f.cell, mu = f.mu })
end
