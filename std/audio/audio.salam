@en "audio"
@fa "صدا"
package audio

import mem

@en "MaxSamples"
@fa "بیشینه نمونه"
pub const MaxSamples := 536870912

@en "Clip"
@fa "قطعه"
pub struct Clip:
    @en "rate"
    @fa "نرخ"
    pub rate: int = 0
    @en "channels"
    @fa "کانال ها"
    pub channels: int = 0
    @en "frames"
    @fa "فریم ها"
    pub frames: int = 0
    @en "bits"
    @fa "بیت ها"
    pub bits: int = 0
    @en "samples"
    @fa "نمونه ها"
    pub samples: void* = null
end

func _sp(c: Clip): f32*:
    ret c.samples as f32*
end

func _total(frames: int, channels: int): i64:
    ret (frames as i64) * (channels as i64)
end

@en "New"
@fa "جدید"
pub func New(rate: int, channels: int, frames: int): Clip:
    if rate <= 0 or channels <= 0 or frames < 0:
        ret Clip {}
    end
    total := _total(frames, channels)
    if total > (MaxSamples as i64):
        ret Clip {}
    end
    mut out := Clip { rate = rate, channels = channels, frames = frames }
    if total == (0 as i64):
        ret out
    end
    p := mem.AllocateZeroed((total * (4 as i64)) as u64)
    if p == null:
        ret Clip {}
    end
    out.samples = p
    ret out
end

@en "NewSilence"
@fa "سکوت جدید"
pub func NewSilence(rate: int, channels: int, seconds: f64): Clip:
    if rate <= 0 or seconds < 0.0:
        ret Clip {}
    end
    frames := ((seconds * (rate as f64)) + 0.5) as int
    ret New(rate, channels, frames)
end

@en "Free"
@fa "آزادسازی"
pub func Free(c &: Clip):
    if c.samples != null:
        mem.Free(c.samples)
    end
    c.samples = null
    c.rate = 0
    c.channels = 0
    c.frames = 0
    c.bits = 0
end

@en "IsEmpty"
@fa "خالی است"
pub func IsEmpty(c: Clip): bool:
    ret c.rate <= 0 or c.channels <= 0 or c.frames <= 0 or c.samples == null
end

@en "Clone"
@fa "کپی"
pub func Clone(c: Clip): Clip:
    mut out := New(c.rate, c.channels, c.frames)
    if out.samples != null and c.samples != null:
        mem.Copy(out.samples, c.samples, (_total(c.frames, c.channels) * (4 as i64)) as u64)
    end
    out.bits = c.bits
    ret out
end

@en "SampleCount"
@fa "شمار نمونه"
pub func SampleCount(c: Clip): int:
    ret c.frames * c.channels
end

@en "InBounds"
@fa "در محدوده"
pub func InBounds(c: Clip, frame: int, ch: int): bool:
    ret frame >= 0 and ch >= 0 and frame < c.frames and ch < c.channels
end

@en "Sample"
@fa "نمونه"
pub func Sample(c: Clip, frame: int, ch: int): f64:
    if c.samples == null or not InBounds(c, frame, ch):
        ret 0.0
    end
    p := _sp(c)
    ret p[frame * c.channels + ch] as f64
end

@en "SetSample"
@fa "تنظیم نمونه"
pub func SetSample(c &: Clip, frame: int, ch: int, v: f64):
    if c.samples == null or not InBounds(c, frame, ch):
        ret
    end
    p := _sp(c)
    p[frame * c.channels + ch] = v as f32
end

@en "AddSample"
@fa "افزودن نمونه"
pub func AddSample(c &: Clip, frame: int, ch: int, v: f64):
    if c.samples == null or not InBounds(c, frame, ch):
        ret
    end
    p := _sp(c)
    p[frame * c.channels + ch] = (p[frame * c.channels + ch] as f64 + v) as f32
end

@en "Data"
@fa "داده"
pub func Data(c: Clip): f32*:
    ret _sp(c)
end

@en "Duration"
@fa "مدت"
pub func Duration(c: Clip): f64:
    if c.rate <= 0:
        ret 0.0
    end
    ret (c.frames as f64) / (c.rate as f64)
end

@en "FrameAt"
@fa "فریم در زمان"
pub func FrameAt(c: Clip, seconds: f64): int:
    if c.rate <= 0:
        ret 0
    end
    mut f := (seconds * (c.rate as f64)) as int
    if f < 0:
        f = 0
    end
    if f > c.frames:
        f = c.frames
    end
    ret f
end

@en "SecondsAt"
@fa "ثانیه در فریم"
pub func SecondsAt(c: Clip, frame: int): f64:
    if c.rate <= 0:
        ret 0.0
    end
    ret (frame as f64) / (c.rate as f64)
end

@en "Silence"
@fa "ساکت کردن"
pub func Silence(c &: Clip):
    if c.samples == null:
        ret
    end
    mem.Set(c.samples, 0, (_total(c.frames, c.channels) * (4 as i64)) as u64)
end
