@en "codec"
@fa "کدک"
package codec

import audio
import audio.wav
import audio.aiff
import audio.au
import audio.flac
import compress
import archive

@en "CanDecode"
@fa "کدگشایی شدنی"
pub func CanDecode(format: int): bool:
    ret format == audio.FormatWAV or format == audio.FormatAIFF or format == audio.FormatAU or format == audio.FormatFLAC
end

@en "CanEncode"
@fa "کدگذاری شدنی"
pub func CanEncode(format: int): bool:
    ret format == audio.FormatWAV or format == audio.FormatAIFF or format == audio.FormatAU or format == audio.FormatFLAC
end

@en "Formats"
@fa "قالب‌ها"
pub func Formats(): Vector<int>:
    mut out := Vector {} as Vector<int>
    out.push(audio.FormatWAV)
    out.push(audio.FormatAIFF)
    out.push(audio.FormatAU)
    out.push(audio.FormatFLAC)
    ret out
end

@en "Decode"
@fa "کدگشایی"
pub func Decode(p: void*, n: int, ok &: bool): audio.Clip:
    format := audio.DetectFormat(p, n)
    if format == audio.FormatWAV:
        ret wav.DecodeWAV(p, n, ok)
    end
    if format == audio.FormatAIFF:
        ret aiff.DecodeAIFF(p, n, ok)
    end
    if format == audio.FormatAU:
        ret au.DecodeAU(p, n, ok)
    end
    if format == audio.FormatFLAC:
        ret flac.DecodeFLAC(p, n, ok)
    end
    ok = false
    ret audio.Clip {}
end

@en "Probe"
@fa "بررسی"
pub func Probe(p: void*, n: int, ok &: bool): audio.Info:
    format := audio.DetectFormat(p, n)
    if format == audio.FormatWAV:
        ret wav.ProbeWAV(p, n, ok)
    end
    if format == audio.FormatAIFF:
        ret aiff.ProbeAIFF(p, n, ok)
    end
    if format == audio.FormatAU:
        ret au.ProbeAU(p, n, ok)
    end
    if format == audio.FormatFLAC:
        ret flac.ProbeFLAC(p, n, ok)
    end
    ok = false
    ret audio.Info {}
end

@en "Open"
@fa "بازکردن"
pub func Open(path: str, ok &: bool): audio.Clip:
    mut read_ok := false
    buf := archive.ReadBinaryFile(path, read_ok)
    if not read_ok:
        ok = false
        ret audio.Clip {}
    end
    out := Decode(buf.data, buf.len, ok)
    compress.BufFree(buf)
    ret out
end

@en "ProbeFile"
@fa "بررسی پرونده"
pub func ProbeFile(path: str, ok &: bool): audio.Info:
    mut read_ok := false
    buf := archive.ReadBinaryFile(path, read_ok)
    if not read_ok:
        ok = false
        ret audio.Info {}
    end
    out := Probe(buf.data, buf.len, ok)
    compress.BufFree(buf)
    ret out
end

@en "Encode"
@fa "کدگذاری"
pub func Encode(c: audio.Clip, format: int): compress.ByteBuf:
    if format == audio.FormatWAV:
        ret wav.EncodeWAV(c)
    end
    if format == audio.FormatAIFF:
        ret aiff.EncodeAIFF(c)
    end
    if format == audio.FormatAU:
        ret au.EncodeAU(c)
    end
    if format == audio.FormatFLAC:
        ret flac.EncodeFLAC(c)
    end
    ret compress.NewByteBuf()
end

@en "Save"
@fa "ذخیره"
pub func Save(c: audio.Clip, path: str): bool:
    format := audio.FormatFromExt(path)
    if not CanEncode(format):
        ret false
    end
    buf := Encode(c, format)
    if compress.BufLen(buf) == 0:
        compress.BufFree(buf)
        ret false
    end
    ok := archive.WriteBinaryFileBuf(path, buf)
    compress.BufFree(buf)
    ret ok
end
