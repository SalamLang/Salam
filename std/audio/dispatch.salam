package audio

import str
import filepath
import mem

@en "FormatUnknown"
@fa "قالب نامشخص"
pub const FormatUnknown := 0

@en "FormatWAV"
@fa "قالب ویو"
pub const FormatWAV := 1

@en "FormatMP3"
@fa "قالب ام‌پی‌تری"
pub const FormatMP3 := 2

@en "FormatFLAC"
@fa "قالب فلاک"
pub const FormatFLAC := 3

@en "FormatOGG"
@fa "قالب اوگ"
pub const FormatOGG := 4

@en "FormatAIFF"
@fa "قالب ایف"
pub const FormatAIFF := 5

@en "FormatAU"
@fa "قالب اواسنیدی"
pub const FormatAU := 6

@en "FormatOpus"
@fa "قالب اوپوس"
pub const FormatOpus := 7

@en "FormatAAC"
@fa "قالب ای‌ای‌سی"
pub const FormatAAC := 8

@en "FormatMIDI"
@fa "قالب میدی"
pub const FormatMIDI := 9

@en "Info"
@fa "آگاهی"
pub struct Info:
    @en "format"
    @fa "قالب"
    pub format: int = 0
    @en "rate"
    @fa "نرخ"
    pub rate: int = 0
    @en "channels"
    @fa "کانال ها"
    pub channels: int = 0
    @en "frames"
    @fa "فریم ها"
    pub frames: int = 0
    @en "bits"
    @fa "بیت ها"
    pub bits: int = 0
    @en "bitrate"
    @fa "نرخ بیت"
    pub bitrate: int = 0
    @en "vbr"
    @fa "نرخ متغیر"
    pub vbr: bool = false
    @en "duration"
    @fa "مدت"
    pub duration: f64 = 0.0
    @en "lossless"
    @fa "بی اتلاف"
    pub lossless: bool = false
end

func _b(p: void*, off: int): int:
    bp := p as u8*
    ret bp[off] as int
end

func _is4(p: void*, off: int, a: int, b: int, c: int, d: int): bool:
    ret _b(p, off) == a and _b(p, off + 1) == b and _b(p, off + 2) == c and _b(p, off + 3) == d
end

@en "DetectFormat"
@fa "شناسایی قالب"
pub func DetectFormat(p: void*, n: int): int:
    if n < 12:
        ret FormatUnknown
    end
    if _is4(p, 0, 82, 73, 70, 70) and _is4(p, 8, 87, 65, 86, 69):
        ret FormatWAV
    end
    if _is4(p, 0, 102, 76, 97, 67):
        ret FormatFLAC
    end
    if _is4(p, 0, 79, 103, 103, 83):
        ret FormatOGG
    end
    if _is4(p, 0, 70, 79, 82, 77):
        if _is4(p, 8, 65, 73, 70, 70) or _is4(p, 8, 65, 73, 70, 67):
            ret FormatAIFF
        end
    end
    if _is4(p, 0, 46, 115, 110, 100):
        ret FormatAU
    end
    if _is4(p, 0, 77, 84, 104, 100):
        ret FormatMIDI
    end
    if _is4(p, 4, 102, 116, 121, 112):
        ret FormatAAC
    end
    if _b(p, 0) == 73 and _b(p, 1) == 68 and _b(p, 2) == 51:
        ret FormatMP3
    end
    if _b(p, 0) == 255:
        second := _b(p, 1)
        if (second & 240) == 240:
            if (second & 6) != 0:
                ret FormatMP3
            end
            ret FormatAAC
        end
        if (second & 224) == 224:
            ret FormatMP3
        end
    end
    ret FormatUnknown
end

@en "FormatFromExt"
@fa "قالب از پسوند"
pub func FormatFromExt(path: str): int:
    raw := filepath.Ext(path)
    ext := str.Lower(raw)
    mem.Free(raw as void*)
    mut out := FormatUnknown
    if ext == ".wav" or ext == ".wave":
        out = FormatWAV
    else ext == ".mp3":
        out = FormatMP3
    else ext == ".flac":
        out = FormatFLAC
    else ext == ".ogg" or ext == ".oga":
        out = FormatOGG
    else ext == ".opus":
        out = FormatOpus
    else ext == ".aiff" or ext == ".aif" or ext == ".aifc":
        out = FormatAIFF
    else ext == ".au" or ext == ".snd":
        out = FormatAU
    else ext == ".aac" or ext == ".m4a" or ext == ".mp4":
        out = FormatAAC
    else ext == ".mid" or ext == ".midi":
        out = FormatMIDI
    end
    mem.Free(ext as void*)
    ret out
end

@en "FormatName"
@fa "نام قالب"
pub func FormatName(format: int): str:
    if format == FormatWAV:
        ret "wav"
    end
    if format == FormatMP3:
        ret "mp3"
    end
    if format == FormatFLAC:
        ret "flac"
    end
    if format == FormatOGG:
        ret "ogg"
    end
    if format == FormatAIFF:
        ret "aiff"
    end
    if format == FormatAU:
        ret "au"
    end
    if format == FormatOpus:
        ret "opus"
    end
    if format == FormatAAC:
        ret "aac"
    end
    if format == FormatMIDI:
        ret "midi"
    end
    ret "unknown"
end

@en "FormatIsLossless"
@fa "قالب بی‌اتلاف است"
pub func FormatIsLossless(format: int): bool:
    ret format == FormatWAV or format == FormatFLAC or format == FormatAIFF or format == FormatAU
end
