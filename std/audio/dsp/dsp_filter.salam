package dsp

import audio
import math

@en "Biquad"
@fa "دوقطبی"
pub struct Biquad:
    @en "b0"
    @fa "ب۰"
    pub b0: f64 = 1.0
    @en "b1"
    @fa "ب۱"
    pub b1: f64 = 0.0
    @en "b2"
    @fa "ب۲"
    pub b2: f64 = 0.0
    @en "a1"
    @fa "آ۱"
    pub a1: f64 = 0.0
    @en "a2"
    @fa "آ۲"
    pub a2: f64 = 0.0
    @en "z1"
    @fa "ز۱"
    pub z1: f64 = 0.0
    @en "z2"
    @fa "ز۲"
    pub z2: f64 = 0.0
end

func _norm(b0: f64, b1: f64, b2: f64, a0: f64, a1: f64, a2: f64): Biquad:
    if a0 == 0.0:
        ret Biquad {}
    end
    ret Biquad { b0 = b0 / a0, b1 = b1 / a0, b2 = b2 / a0, a1 = a1 / a0, a2 = a2 / a0 }
end

func _w0(freq: f64, rate: int): f64:
    ret 2.0 * math.PI * freq / (rate as f64)
end

@en "LowPass"
@fa "صافی پایین"
pub func LowPass(freq: f64, q: f64, rate: int): Biquad:
    w := _w0(freq, rate)
    c := math.Cos(w)
    alpha := math.Sin(w) / (2.0 * q)
    ret _norm((1.0 - c) / 2.0, 1.0 - c, (1.0 - c) / 2.0, 1.0 + alpha, -2.0 * c, 1.0 - alpha)
end

@en "HighPass"
@fa "صافی بالا"
pub func HighPass(freq: f64, q: f64, rate: int): Biquad:
    w := _w0(freq, rate)
    c := math.Cos(w)
    alpha := math.Sin(w) / (2.0 * q)
    ret _norm((1.0 + c) / 2.0, 0.0 - (1.0 + c), (1.0 + c) / 2.0, 1.0 + alpha, -2.0 * c, 1.0 - alpha)
end

@en "BandPass"
@fa "صافی میان"
pub func BandPass(freq: f64, q: f64, rate: int): Biquad:
    w := _w0(freq, rate)
    c := math.Cos(w)
    s := math.Sin(w)
    alpha := s / (2.0 * q)
    ret _norm(alpha, 0.0, 0.0 - alpha, 1.0 + alpha, -2.0 * c, 1.0 - alpha)
end

@en "Notch"
@fa "صافی شکاف"
pub func Notch(freq: f64, q: f64, rate: int): Biquad:
    w := _w0(freq, rate)
    c := math.Cos(w)
    alpha := math.Sin(w) / (2.0 * q)
    ret _norm(1.0, -2.0 * c, 1.0, 1.0 + alpha, -2.0 * c, 1.0 - alpha)
end

@en "AllPass"
@fa "صافی همه"
pub func AllPass(freq: f64, q: f64, rate: int): Biquad:
    w := _w0(freq, rate)
    c := math.Cos(w)
    alpha := math.Sin(w) / (2.0 * q)
    ret _norm(1.0 - alpha, -2.0 * c, 1.0 + alpha, 1.0 + alpha, -2.0 * c, 1.0 - alpha)
end

@en "Peaking"
@fa "قله"
pub func Peaking(freq: f64, q: f64, gain_db: f64, rate: int): Biquad:
    a := math.Pow(10.0, gain_db / 40.0)
    w := _w0(freq, rate)
    c := math.Cos(w)
    alpha := math.Sin(w) / (2.0 * q)
    ret _norm(1.0 + alpha * a, -2.0 * c, 1.0 - alpha * a, 1.0 + alpha / a, -2.0 * c, 1.0 - alpha / a)
end

@en "LowShelf"
@fa "قفسه پایین"
pub func LowShelf(freq: f64, q: f64, gain_db: f64, rate: int): Biquad:
    a := math.Pow(10.0, gain_db / 40.0)
    w := _w0(freq, rate)
    c := math.Cos(w)
    s := math.Sin(w)
    beta := s * math.Sqrt(a) / q
    ap := a + 1.0
    am := a - 1.0
    ret _norm(a * (ap - am * c + beta), 2.0 * a * (am - ap * c), a * (ap - am * c - beta), ap + am * c + beta, -2.0 * (am + ap * c), ap + am * c - beta)
end

@en "HighShelf"
@fa "قفسه بالا"
pub func HighShelf(freq: f64, q: f64, gain_db: f64, rate: int): Biquad:
    a := math.Pow(10.0, gain_db / 40.0)
    w := _w0(freq, rate)
    c := math.Cos(w)
    s := math.Sin(w)
    beta := s * math.Sqrt(a) / q
    ap := a + 1.0
    am := a - 1.0
    ret _norm(a * (ap + am * c + beta), -2.0 * a * (am + ap * c), a * (ap + am * c - beta), ap - am * c + beta, 2.0 * (am - ap * c), ap - am * c - beta)
end

@en "BiquadReset"
@fa "بازنشانی دوقطبی"
pub func BiquadReset(f &: Biquad):
    f.z1 = 0.0
    f.z2 = 0.0
end

@en "BiquadStep"
@fa "گام دوقطبی"
pub func BiquadStep(f &: Biquad, x: f64): f64:
    y := f.b0 * x + f.z1
    f.z1 = f.b1 * x - f.a1 * y + f.z2
    f.z2 = f.b2 * x - f.a2 * y
    ret y
end

@en "BiquadResponse"
@fa "پاسخ دوقطبی"
pub func BiquadResponse(f: Biquad, freq: f64, rate: int): f64:
    w := _w0(freq, rate)
    cw := math.Cos(w)
    sw := math.Sin(w)
    c2 := math.Cos(2.0 * w)
    s2 := math.Sin(2.0 * w)
    nr := f.b0 + f.b1 * cw + f.b2 * c2
    ni := 0.0 - (f.b1 * sw + f.b2 * s2)
    dr := 1.0 + f.a1 * cw + f.a2 * c2
    di := 0.0 - (f.a1 * sw + f.a2 * s2)
    dmag := math.Hypot(dr, di)
    if dmag == 0.0:
        ret 0.0
    end
    ret math.Hypot(nr, ni) / dmag
end

@en "BiquadProcess"
@fa "پردازش دوقطبی"
pub func BiquadProcess(f &: Biquad, c &: audio.Clip, ch: int):
    if audio.IsEmpty(c) or ch < 0 or ch >= c.channels:
        ret
    end
    p := audio.Data(c)
    mut i := 0
    until i < c.frames:
        idx := i * c.channels + ch
        p[idx] = BiquadStep(f, p[idx] as f64) as f32
        i += 1
    end
end

@en "BiquadProcessAll"
@fa "پردازش همه کانال‌ها"
pub func BiquadProcessAll(f: Biquad, c &: audio.Clip):
    mut ch := 0
    until ch < c.channels:
        mut local := f
        BiquadReset(local)
        BiquadProcess(local, c, ch)
        ch += 1
    end
end

@en "DCRemove"
@fa "حذف جریان مستقیم"
pub func DCRemove(c &: audio.Clip):
    if audio.IsEmpty(c):
        ret
    end
    off := audio.DcOffset(c)
    p := audio.Data(c)
    n := audio.SampleCount(c)
    mut i := 0
    until i < n:
        p[i] = ((p[i] as f64) - off) as f32
        i += 1
    end
end
