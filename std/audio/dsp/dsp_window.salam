package dsp

import math

@en "WindowRectangular"
@fa "پنجره مستطیلی"
pub const WindowRectangular := 0

@en "WindowHann"
@fa "پنجره هان"
pub const WindowHann := 1

@en "WindowHamming"
@fa "پنجره همینگ"
pub const WindowHamming := 2

@en "WindowBlackman"
@fa "پنجره بلکمن"
pub const WindowBlackman := 3

@en "WindowBlackmanHarris"
@fa "پنجره بلکمن هریس"
pub const WindowBlackmanHarris := 4

@en "WindowSine"
@fa "پنجره سینوسی"
pub const WindowSine := 5

@en "WindowVorbis"
@fa "پنجره وربیس"
pub const WindowVorbis := 6

@en "WindowKaiser"
@fa "پنجره کایزر"
pub const WindowKaiser := 7

@en "BesselI0"
@fa "بسل صفر"
pub func BesselI0(x: f64): f64:
    half := x / 2.0
    mut term := 1.0
    mut sum := 1.0
    mut k := 1
    until k < 64:
        term = term * (half / (k as f64))
        add := term * term
        sum += add
        if add < 0.000000000000001 * sum:
            break
        end
        k += 1
    end
    ret sum
end

@en "WindowValue"
@fa "مقدار پنجره"
pub func WindowValue(kind: int, i: int, n: int, param: f64): f64:
    if n <= 1:
        ret 1.0
    end
    d := (n - 1) as f64
    t := (i as f64) / d
    if kind == WindowRectangular:
        ret 1.0
    end
    if kind == WindowHann:
        ret 0.5 - 0.5 * math.Cos(2.0 * math.PI * t)
    end
    if kind == WindowHamming:
        ret 0.54 - 0.46 * math.Cos(2.0 * math.PI * t)
    end
    if kind == WindowBlackman:
        ret 0.42 - 0.5 * math.Cos(2.0 * math.PI * t) + 0.08 * math.Cos(4.0 * math.PI * t)
    end
    if kind == WindowBlackmanHarris:
        ret 0.35875 - 0.48829 * math.Cos(2.0 * math.PI * t) + 0.14128 * math.Cos(4.0 * math.PI * t) - 0.01168 * math.Cos(6.0 * math.PI * t)
    end
    if kind == WindowSine:
        ret math.Sin(math.PI * t)
    end
    if kind == WindowVorbis:
        s := math.Sin(math.PI * t)
        ret math.Sin(math.PI / 2.0 * s * s)
    end
    if kind == WindowKaiser:
        r := 2.0 * t - 1.0
        mut inside := 1.0 - r * r
        if inside < 0.0:
            inside = 0.0
        end
        ret BesselI0(param * math.Sqrt(inside)) / BesselI0(param)
    end
    ret 1.0
end

@en "WindowName"
@fa "نام پنجره"
pub func WindowName(kind: int): str:
    if kind == WindowRectangular:
        ret "rectangular"
    end
    if kind == WindowHann:
        ret "hann"
    end
    if kind == WindowHamming:
        ret "hamming"
    end
    if kind == WindowBlackman:
        ret "blackman"
    end
    if kind == WindowBlackmanHarris:
        ret "blackman-harris"
    end
    if kind == WindowSine:
        ret "sine"
    end
    if kind == WindowVorbis:
        ret "vorbis"
    end
    if kind == WindowKaiser:
        ret "kaiser"
    end
    ret "unknown"
end

@en "MakeWindow"
@fa "ساخت پنجره"
pub func MakeWindow(kind: int, n: int, param: f64): Vector<f64>:
    mut out := Vector {} as Vector<f64>
    mut i := 0
    until i < n:
        out.push(WindowValue(kind, i, n, param))
        i += 1
    end
    ret out
end

@en "ApplyWindow"
@fa "اعمال پنجره"
pub func ApplyWindow(p: f64*, n: int, kind: int, param: f64):
    mut i := 0
    until i < n:
        p[i] = p[i] * WindowValue(kind, i, n, param)
        i += 1
    end
end

@en "WindowSum"
@fa "جمع پنجره"
pub func WindowSum(kind: int, n: int, param: f64): f64:
    mut sum := 0.0
    mut i := 0
    until i < n:
        sum += WindowValue(kind, i, n, param)
        i += 1
    end
    ret sum
end
