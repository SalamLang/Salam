package audio

import math

@en "SilenceFloorDb"
@fa "کف سکوت"
pub const SilenceFloorDb := -200.0

@en "GainToDb"
@fa "بهره به دسیبل"
pub func GainToDb(gain: f64): f64:
    g := math.Abs(gain)
    if g <= 0.0:
        ret SilenceFloorDb
    end
    d := 20.0 * math.Log10(g)
    if d < SilenceFloorDb:
        ret SilenceFloorDb
    end
    ret d
end

@en "DbToGain"
@fa "دسیبل به بهره"
pub func DbToGain(db: f64): f64:
    if db <= SilenceFloorDb:
        ret 0.0
    end
    ret math.Pow(10.0, db / 20.0)
end

@en "Peak"
@fa "اوج"
pub func Peak(c: Clip): f64:
    if IsEmpty(c):
        ret 0.0
    end
    p := Data(c)
    n := SampleCount(c)
    mut hi := 0.0
    mut i := 0
    until i < n:
        v := math.Abs(p[i] as f64)
        if v > hi:
            hi = v
        end
        i += 1
    end
    ret hi
end

@en "PeakDb"
@fa "اوج دسیبل"
pub func PeakDb(c: Clip): f64:
    ret GainToDb(Peak(c))
end

@en "PeakChannel"
@fa "اوج کانال"
pub func PeakChannel(c: Clip, ch: int): f64:
    if IsEmpty(c) or ch < 0 or ch >= c.channels:
        ret 0.0
    end
    p := Data(c)
    mut hi := 0.0
    mut f := 0
    until f < c.frames:
        v := math.Abs(p[f * c.channels + ch] as f64)
        if v > hi:
            hi = v
        end
        f += 1
    end
    ret hi
end

@en "RMS"
@fa "جذر میانگین مربع"
pub func RMS(c: Clip): f64:
    if IsEmpty(c):
        ret 0.0
    end
    p := Data(c)
    n := SampleCount(c)
    mut sum := 0.0
    mut i := 0
    until i < n:
        v := p[i] as f64
        sum += v * v
        i += 1
    end
    ret math.Sqrt(sum / (n as f64))
end

@en "RMSDb"
@fa "جذر میانگین مربع دسیبل"
pub func RMSDb(c: Clip): f64:
    ret GainToDb(RMS(c))
end

@en "RMSRange"
@fa "جذر میانگین مربع بازه"
pub func RMSRange(c: Clip, from_frame: int, count: int): f64:
    if IsEmpty(c) or count <= 0:
        ret 0.0
    end
    mut start := from_frame
    if start < 0:
        start = 0
    end
    mut stop := start + count
    if stop > c.frames:
        stop = c.frames
    end
    if stop <= start:
        ret 0.0
    end
    p := Data(c)
    mut sum := 0.0
    mut f := start
    until f < stop:
        mut ch := 0
        until ch < c.channels:
            v := p[f * c.channels + ch] as f64
            sum += v * v
            ch += 1
        end
        f += 1
    end
    total := ((stop - start) * c.channels) as f64
    ret math.Sqrt(sum / total)
end

@en "DcOffset"
@fa "انحراف جریان مستقیم"
pub func DcOffset(c: Clip): f64:
    if IsEmpty(c):
        ret 0.0
    end
    p := Data(c)
    n := SampleCount(c)
    mut sum := 0.0
    mut i := 0
    until i < n:
        sum += p[i] as f64
        i += 1
    end
    ret sum / (n as f64)
end

@en "IsClipped"
@fa "بریده است"
pub func IsClipped(c: Clip): bool:
    ret Peak(c) >= 1.0
end

@en "CountClipped"
@fa "شمار بریده"
pub func CountClipped(c: Clip): int:
    if IsEmpty(c):
        ret 0
    end
    p := Data(c)
    n := SampleCount(c)
    mut hits := 0
    mut i := 0
    until i < n:
        if math.Abs(p[i] as f64) >= 1.0:
            hits += 1
        end
        i += 1
    end
    ret hits
end

@en "IsSilent"
@fa "ساکت است"
pub func IsSilent(c: Clip, threshold_db: f64): bool:
    ret Peak(c) <= DbToGain(threshold_db)
end

@en "FirstSound"
@fa "نخستین صدا"
pub func FirstSound(c: Clip, threshold_db: f64): int:
    if IsEmpty(c):
        ret -1
    end
    limit := DbToGain(threshold_db)
    p := Data(c)
    mut f := 0
    until f < c.frames:
        mut ch := 0
        until ch < c.channels:
            if math.Abs(p[f * c.channels + ch] as f64) > limit:
                ret f
            end
            ch += 1
        end
        f += 1
    end
    ret -1
end

@en "LastSound"
@fa "آخرین صدا"
pub func LastSound(c: Clip, threshold_db: f64): int:
    if IsEmpty(c):
        ret -1
    end
    limit := DbToGain(threshold_db)
    p := Data(c)
    mut f := c.frames - 1
    until f >= 0:
        mut ch := 0
        until ch < c.channels:
            if math.Abs(p[f * c.channels + ch] as f64) > limit:
                ret f
            end
            ch += 1
        end
        f -= 1
    end
    ret -1
end
