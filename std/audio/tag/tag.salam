@en "tag"
@fa "برچسب صدا"
package tag

import audio
import compress
import archive
import str
import mem

@en "Tags"
@fa "برچسب‌ها"
pub struct Tags:
    @en "title"
    @fa "عنوان"
    pub title: str = ""
    @en "artist"
    @fa "هنرمند"
    pub artist: str = ""
    @en "album"
    @fa "آلبوم"
    pub album: str = ""
    @en "albumartist"
    @fa "هنرمند آلبوم"
    pub albumartist: str = ""
    @en "composer"
    @fa "آهنگساز"
    pub composer: str = ""
    @en "genre"
    @fa "سبک"
    pub genre: str = ""
    @en "comment"
    @fa "یادداشت"
    pub comment: str = ""
    @en "lyrics"
    @fa "ترانه"
    pub lyrics: str = ""
    @en "art_mime"
    @fa "گونه هنر"
    pub art_mime: str = ""
    @en "year"
    @fa "سال"
    pub year: int = 0
    @en "track"
    @fa "شماره قطعه"
    pub track: int = 0
    @en "tracks"
    @fa "شمار قطعه‌ها"
    pub tracks: int = 0
    @en "disc"
    @fa "شماره دیسک"
    pub disc: int = 0
    @en "bpm"
    @fa "ضربان"
    pub bpm: int = 0
    @en "art"
    @fa "هنر"
    pub art: compress.ByteBuf = compress.ByteBuf { data = null, len = 0, cap = 0 }
end

func _decimal_len(v: int): int:
    if v <= 0:
        ret 1
    end
    mut n := 0
    mut x := v
    until x > 0:
        n += 1
        x = x / 10
    end
    ret n
end

func _push_decimal(b &: compress.ByteBuf, v: int):
    if v <= 0:
        compress.BufPush(b, 48)
        ret
    end
    mut digits: int[12]
    mut n := 0
    mut x := v
    until x > 0:
        digits[n] = 48 + (x % 10)
        n += 1
        x = x / 10
        if n >= 12:
            break
        end
    end
    mut i := n - 1
    until i >= 0:
        compress.BufPush(b, digits[i])
        i -= 1
    end
end

func _free_one(s: str):
    if s.len() > 0:
        mem.Free(s as void*)
    end
end

func _trim_pad(p: void*, off: int, max: int): str:
    bp := p as u8*
    mut last := -1
    mut i := 0
    until i < max:
        b := bp[off + i] as int
        if b != 0 and b != 32:
            last = i
        end
        i += 1
    end
    if last < 0:
        ret ""
    end
    mut sb := str.NewBuilder()
    mut j := 0
    until j < last + 1:
        b := bp[off + j] as int
        if b != 0:
            str.BufAppendCp(sb, b)
        end
        j += 1
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    if out.len() == 0:
        mem.Free(out as void*)
        ret ""
    end
    ret out
end

func _digits(p: void*, off: int, max: int): int:
    bp := p as u8*
    mut v := 0
    mut i := 0
    until i < max:
        b := bp[off + i] as int
        if b >= 48 and b <= 57:
            v = v * 10 + (b - 48)
        end
        i += 1
    end
    ret v
end

func _push_fixed(b &: compress.ByteBuf, s: str, width: int):
    cps := str.CodePoints(s)
    mut i := 0
    until i < width:
        if i < cps.len():
            cp := cps.get(i)
            if cp < 256:
                compress.BufPush(b, cp)
            else:
                compress.BufPush(b, 63)
            end
        else:
            compress.BufPush(b, 0)
        end
        i += 1
    end
    cps.free()
end

func _push_year(b &: compress.ByteBuf, year: int):
    if year <= 0 or year > 9999:
        mut i := 0
        until i < 4:
            compress.BufPush(b, 0)
            i += 1
        end
        ret
    end
    compress.BufPush(b, 48 + (year / 1000) % 10)
    compress.BufPush(b, 48 + (year / 100) % 10)
    compress.BufPush(b, 48 + (year / 10) % 10)
    compress.BufPush(b, 48 + year % 10)
end

@en "GenreName"
@fa "نام سبک"
pub func GenreName(id: int): str:
    if id == 0:
        ret "Blues"
    end
    if id == 1:
        ret "Classic Rock"
    end
    if id == 2:
        ret "Country"
    end
    if id == 7:
        ret "Hip-Hop"
    end
    if id == 8:
        ret "Jazz"
    end
    if id == 9:
        ret "Metal"
    end
    if id == 12:
        ret "Other"
    end
    if id == 13:
        ret "Pop"
    end
    if id == 17:
        ret "Rock"
    end
    if id == 20:
        ret "Alternative"
    end
    if id == 24:
        ret "Soundtrack"
    end
    if id == 32:
        ret "Classical"
    end
    if id == 52:
        ret "Electronic"
    end
    if id == 77:
        ret "Folk"
    end
    ret ""
end

@en "NewTags"
@fa "برچسب‌های جدید"
pub func NewTags(): Tags:
    ret Tags {}
end

@en "FreeTags"
@fa "آزادسازی برچسب‌ها"
pub func FreeTags(t &: Tags):
    _free_one(t.title)
    _free_one(t.artist)
    _free_one(t.album)
    _free_one(t.albumartist)
    _free_one(t.composer)
    _free_one(t.genre)
    _free_one(t.comment)
    _free_one(t.lyrics)
    _free_one(t.art_mime)
    t.title = ""
    t.artist = ""
    t.album = ""
    t.albumartist = ""
    t.composer = ""
    t.genre = ""
    t.comment = ""
    t.lyrics = ""
    t.art_mime = ""
    compress.BufFree(t.art)
    t.year = 0
    t.track = 0
    t.tracks = 0
    t.disc = 0
    t.bpm = 0
end

@en "HasTags"
@fa "برچسب دارد"
pub func HasTags(t: Tags): bool:
    ret t.title.len() > 0 or t.artist.len() > 0 or t.album.len() > 0 or t.year > 0 or t.track > 0
end

@en "HasID3v1"
@fa "آی‌دی۳ یک دارد"
pub func HasID3v1(p: void*, n: int): bool:
    if n < 128:
        ret false
    end
    bp := p as u8*
    at := n - 128
    ret (bp[at] as int) == 84 and (bp[at + 1] as int) == 65 and (bp[at + 2] as int) == 71
end

@en "ReadID3v1"
@fa "خواندن آی‌دی۳ یک"
pub func ReadID3v1(p: void*, n: int, out &: Tags): bool:
    if not HasID3v1(p, n):
        ret false
    end
    at := n - 128
    bp := p as u8*
    out.title = _trim_pad(p, at + 3, 30)
    out.artist = _trim_pad(p, at + 33, 30)
    out.album = _trim_pad(p, at + 63, 30)
    out.year = _digits(p, at + 93, 4)
    zero_at := bp[at + 125] as int
    trk := bp[at + 126] as int
    if zero_at == 0 and trk != 0:
        out.comment = _trim_pad(p, at + 97, 28)
        out.track = trk
    else:
        out.comment = _trim_pad(p, at + 97, 30)
    end
    g := bp[at + 127] as int
    name := GenreName(g)
    if name.len() > 0:
        out.genre = str.Clone(name)
    end
    ret true
end

@en "WriteID3v1"
@fa "نوشتن آی‌دی۳ یک"
pub func WriteID3v1(t: Tags): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    compress.BufPush(out, 84)
    compress.BufPush(out, 65)
    compress.BufPush(out, 71)
    _push_fixed(out, t.title, 30)
    _push_fixed(out, t.artist, 30)
    _push_fixed(out, t.album, 30)
    _push_year(out, t.year)
    _push_fixed(out, t.comment, 28)
    compress.BufPush(out, 0)
    mut trk := t.track
    if trk < 0 or trk > 255:
        trk = 0
    end
    compress.BufPush(out, trk)
    compress.BufPush(out, 255)
    ret out
end

@en "ReadTags"
@fa "خواندن برچسب‌ها"
pub func ReadTags(p: void*, n: int, ok &: bool): Tags:
    ok = false
    mut t := Tags {}
    mut any := false
    if HasID3v2(p, n):
        if ReadID3v2(p, n, t):
            any = true
        end
    end
    if IsFlacTagged(p, n):
        if ReadFlacTags(p, n, t):
            any = true
        end
    end
    if not any:
        if ReadID3v1(p, n, t):
            any = true
        end
    end
    ok = any
    ret t
end

@en "ReadTagsFile"
@fa "خواندن برچسب‌های پرونده"
pub func ReadTagsFile(path: str, ok &: bool): Tags:
    mut read_ok := false
    buf := archive.ReadBinaryFile(path, read_ok)
    if not read_ok:
        ok = false
        ret Tags {}
    end
    out := ReadTags(buf.data, buf.len, ok)
    compress.BufFree(buf)
    ret out
end

@en "StripTags"
@fa "برداشتن برچسب‌ها"
pub func StripTags(p: void*, n: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut start := 0
    mut stop := n
    if HasID3v2(p, n):
        start = ID3v2Size(p, n)
    end
    if HasID3v1(p, n):
        stop = n - 128
    end
    if stop < start:
        stop = start
    end
    bp := p as u8*
    mut i := start
    until i < stop:
        compress.BufPush(out, bp[i] as int)
        i += 1
    end
    ret out
end

@en "AudioStart"
@fa "آغاز صدا"
pub func AudioStart(p: void*, n: int): int:
    if HasID3v2(p, n):
        ret ID3v2Size(p, n)
    end
    ret 0
end

@en "AudioEnd"
@fa "پایان صدا"
pub func AudioEnd(p: void*, n: int): int:
    if HasID3v1(p, n):
        ret n - 128
    end
    ret n
end
