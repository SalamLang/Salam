package wav

import audio
import compress
import archive
import encoding.binary
import str

func _push_tag(b &: compress.ByteBuf, a: int, c: int, d: int, e: int):
    compress.BufPush(b, a)
    compress.BufPush(b, c)
    compress.BufPush(b, d)
    compress.BufPush(b, e)
end

func _header(b &: compress.ByteBuf, codec: int, channels: int, rate: int, bits: int, data_bytes: int):
    block_align := channels * (bits / 8)
    byte_rate := rate * block_align
    _push_tag(b, 82, 73, 70, 70)
    binary.WriteU32LE(b, 36 + data_bytes)
    _push_tag(b, 87, 65, 86, 69)
    _push_tag(b, 102, 109, 116, 32)
    binary.WriteU32LE(b, 16)
    binary.WriteU16LE(b, codec)
    binary.WriteU16LE(b, channels)
    binary.WriteU32LE(b, rate)
    binary.WriteU32LE(b, byte_rate)
    binary.WriteU16LE(b, block_align)
    binary.WriteU16LE(b, bits)
    _push_tag(b, 100, 97, 116, 97)
    binary.WriteU32LE(b, data_bytes)
end

@en "EncodeWAVBits"
@fa "کدگذاری ویو با بیت"
pub func EncodeWAVBits(c: audio.Clip, bits: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    if audio.IsEmpty(c):
        ret out
    end
    if bits != 8 and bits != 16 and bits != 24 and bits != 32:
        ret out
    end
    data_bytes := c.frames * c.channels * (bits / 8)
    _header(out, CodecPCM, c.channels, c.rate, bits, data_bytes)
    audio.EncodePcm(out, c, bits, false, bits == 8)
    ret out
end

@en "EncodeWAV"
@fa "کدگذاری ویو"
pub func EncodeWAV(c: audio.Clip): compress.ByteBuf:
    mut bits := c.bits
    if bits != 8 and bits != 16 and bits != 24 and bits != 32:
        bits = 16
    end
    ret EncodeWAVBits(c, bits)
end

@en "EncodeWAVFloat"
@fa "کدگذاری ویو اعشاری"
pub func EncodeWAVFloat(c: audio.Clip): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    if audio.IsEmpty(c):
        ret out
    end
    data_bytes := c.frames * c.channels * 4
    _header(out, CodecFloat, c.channels, c.rate, 32, data_bytes)
    audio.EncodeFloatPcm(out, c, 32, false)
    ret out
end

@en "EncodeMuLaw"
@fa "کدگذاری میولا"
pub func EncodeMuLaw(c: audio.Clip): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    if audio.IsEmpty(c):
        ret out
    end
    data_bytes := c.frames * c.channels
    _header(out, CodecMuLaw, c.channels, c.rate, 8, data_bytes)
    audio.EncodeLawPcm(out, c, false)
    ret out
end

@en "EncodeALaw"
@fa "کدگذاری ای‌لا"
pub func EncodeALaw(c: audio.Clip): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    if audio.IsEmpty(c):
        ret out
    end
    data_bytes := c.frames * c.channels
    _header(out, CodecALaw, c.channels, c.rate, 8, data_bytes)
    audio.EncodeLawPcm(out, c, true)
    ret out
end

@en "SaveWAVBits"
@fa "ذخیره ویو با بیت"
pub func SaveWAVBits(c: audio.Clip, path: str, bits: int): bool:
    buf := EncodeWAVBits(c, bits)
    if compress.BufLen(buf) == 0:
        compress.BufFree(buf)
        ret false
    end
    ok := archive.WriteBinaryFileBuf(path, buf)
    compress.BufFree(buf)
    ret ok
end

@en "SaveWAV"
@fa "ذخیره ویو"
pub func SaveWAV(c: audio.Clip, path: str): bool:
    buf := EncodeWAV(c)
    if compress.BufLen(buf) == 0:
        compress.BufFree(buf)
        ret false
    end
    ok := archive.WriteBinaryFileBuf(path, buf)
    compress.BufFree(buf)
    ret ok
end

@en "SaveWAVFloat"
@fa "ذخیره ویو اعشاری"
pub func SaveWAVFloat(c: audio.Clip, path: str): bool:
    buf := EncodeWAVFloat(c)
    if compress.BufLen(buf) == 0:
        compress.BufFree(buf)
        ret false
    end
    ok := archive.WriteBinaryFileBuf(path, buf)
    compress.BufFree(buf)
    ret ok
end
