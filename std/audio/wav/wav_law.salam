package wav

const _BIAS := 132
const _CLIP_MU := 8159
const _SEG_UEND := [63, 127, 255, 511, 1023, 2047, 4095, 8191]
const _SEG_AEND := [31, 63, 127, 255, 511, 1023, 2047, 4095]

func _search(val: int, ends: int[]): int:
    mut i := 0
    until i < 8:
        if val <= ends[i]:
            ret i
        end
        i += 1
    end
    ret 8
end

@en "DecodeMuLawByte"
@fa "کدگشایی میولا بایت"
pub func DecodeMuLawByte(b: int): int:
    u := (~b) & 255
    mut t := (((u & 15) << 3) + _BIAS) << ((u & 112) >> 4)
    t -= _BIAS
    if (u & 128) != 0:
        ret 0 - t
    end
    ret t
end

@en "EncodeMuLawByte"
@fa "کدگذاری میولا بایت"
pub func EncodeMuLawByte(sample: int): int:
    mut p := sample >> 2
    mut mask := 255
    if p < 0:
        p = 0 - p
        mask = 127
    end
    if p > _CLIP_MU:
        p = _CLIP_MU
    end
    p += _BIAS >> 2
    seg := _search(p, _SEG_UEND)
    if seg >= 8:
        ret (127 ^ mask) & 255
    end
    ret (((seg << 4) | ((p >> (seg + 1)) & 15)) ^ mask) & 255
end

@en "DecodeALawByte"
@fa "کدگشایی ای‌لا بایت"
pub func DecodeALawByte(b: int): int:
    a := b ^ 85
    mut t := (a & 15) << 4
    seg := (a & 112) >> 4
    if seg == 0:
        t += 8
    else seg == 1:
        t += 264
    else:
        t = (t + 264) << (seg - 1)
    end
    if (a & 128) != 0:
        ret t
    end
    ret 0 - t
end

@en "EncodeALawByte"
@fa "کدگذاری ای‌لا بایت"
pub func EncodeALawByte(sample: int): int:
    mut p := sample >> 3
    mut mask := 213
    if p < 0:
        p = 0 - p - 1
        mask = 85
    end
    seg := _search(p, _SEG_AEND)
    if seg >= 8:
        ret (127 ^ mask) & 255
    end
    mut aval := seg << 4
    if seg < 2:
        aval = aval | ((p >> 1) & 15)
    else:
        aval = aval | ((p >> seg) & 15)
    end
    ret (aval ^ mask) & 255
end
