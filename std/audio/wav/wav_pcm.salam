package wav

import audio

func _read_samples(p: void*, n_total: int, data_off: int, f: Format, out &: audio.Clip): bool:
    if f.codec == CodecPCM:
        ret audio.DecodePcm(p, data_off, out, f.bits, false, f.bits == 8)
    end
    if f.codec == CodecFloat:
        ret audio.DecodeFloatPcm(p, n_total, data_off, out, f.bits, false)
    end
    if f.codec == CodecALaw:
        ret audio.DecodeLawPcm(p, data_off, out, true)
    end
    if f.codec == CodecMuLaw:
        ret audio.DecodeLawPcm(p, data_off, out, false)
    end
    ret false
end
