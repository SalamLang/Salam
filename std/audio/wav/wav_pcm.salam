package wav

import audio
import compress
import encoding.binary

const _SCALE8 := 128.0
const _SCALE16 := 32768.0
const _SCALE24 := 8388608.0
const _SCALE32 := 2147483648.0

func _s16(p: void*, off: int): int:
    bp := p as u8*
    v := (bp[off] as int) | ((bp[off + 1] as int) << 8)
    if v >= 32768:
        ret v - 65536
    end
    ret v
end

func _s24(p: void*, off: int): int:
    bp := p as u8*
    v := (bp[off] as int) | ((bp[off + 1] as int) << 8) | ((bp[off + 2] as int) << 16)
    if v >= 8388608:
        ret v - 16777216
    end
    ret v
end

func _s32(p: void*, off: int): i64:
    bp := p as u8*
    v := (bp[off] as i64) | ((bp[off + 1] as i64) << 8) | ((bp[off + 2] as i64) << 16) | ((bp[off + 3] as i64) << 24)
    if v >= (2147483648 as i64):
        ret v - (4294967296 as i64)
    end
    ret v
end

func _read_pcm(p: void*, data_off: int, f: Format, out &: audio.Clip): bool:
    dst := audio.Data(out)
    n := out.frames * out.channels
    step := f.bits / 8
    mut i := 0
    until i < n:
        off := data_off + i * step
        if f.bits == 8:
            bp := p as u8*
            dst[i] = (((bp[off] as int) - 128) as f64 / _SCALE8) as f32
        else f.bits == 16:
            dst[i] = ((_s16(p, off) as f64) / _SCALE16) as f32
        else f.bits == 24:
            dst[i] = ((_s24(p, off) as f64) / _SCALE24) as f32
        else f.bits == 32:
            dst[i] = ((_s32(p, off) as f64) / _SCALE32) as f32
        else:
            ret false
        end
        i += 1
    end
    ret true
end

func _read_float(p: void*, n_total: int, data_off: int, f: Format, out &: audio.Clip): bool:
    if f.bits != 32 and f.bits != 64:
        ret false
    end
    dst := audio.Data(out)
    n := out.frames * out.channels
    mut rd := compress.NewByteReader(p, n_total)
    rd.pos = data_off
    mut i := 0
    until i < n:
        if f.bits == 32:
            dst[i] = binary.ReadF32(rd, false) as f32
        else:
            dst[i] = binary.ReadF64(rd, false) as f32
        end
        i += 1
    end
    ret not rd.bad
end

func _read_law(p: void*, data_off: int, f: Format, out &: audio.Clip): bool:
    dst := audio.Data(out)
    n := out.frames * out.channels
    bp := p as u8*
    mut i := 0
    until i < n:
        b := bp[data_off + i] as int
        mut v := 0
        if f.codec == CodecALaw:
            v = DecodeALawByte(b)
        else:
            v = DecodeMuLawByte(b)
        end
        dst[i] = ((v as f64) / _SCALE16) as f32
        i += 1
    end
    ret true
end

func _read_samples(p: void*, n_total: int, data_off: int, f: Format, out &: audio.Clip): bool:
    if f.codec == CodecPCM:
        ret _read_pcm(p, data_off, f, out)
    end
    if f.codec == CodecFloat:
        ret _read_float(p, n_total, data_off, f, out)
    end
    if f.codec == CodecALaw or f.codec == CodecMuLaw:
        ret _read_law(p, data_off, f, out)
    end
    ret false
end

func _round_clamp(v: f64, hi: f64, lo: f64): f64:
    mut q := v
    if q >= 0.0:
        q = q + 0.5
    else:
        q = q - 0.5
    end
    q = q as int as f64
    if q > hi:
        q = hi
    end
    if q < lo:
        q = lo
    end
    ret q
end

func _write_pcm(b &: compress.ByteBuf, c: audio.Clip, bits: int):
    src := audio.Data(c)
    n := c.frames * c.channels
    mut i := 0
    until i < n:
        v := src[i] as f64
        mut x := v
        if x > 1.0:
            x = 1.0
        end
        if x < -1.0:
            x = -1.0
        end
        if bits == 8:
            mut q := (x * _SCALE8 + 128.5) as int
            if q > 255:
                q = 255
            end
            if q < 0:
                q = 0
            end
            compress.BufPush(b, q)
        else bits == 16:
            q := _round_clamp(x * _SCALE16, 32767.0, -32768.0) as int
            binary.WriteI16LE(b, q)
        else bits == 24:
            q := _round_clamp(x * _SCALE24, 8388607.0, -8388608.0) as int
            mut u := q
            if u < 0:
                u += 16777216
            end
            compress.BufPush(b, u & 255)
            compress.BufPush(b, (u >> 8) & 255)
            compress.BufPush(b, (u >> 16) & 255)
        else:
            q := _round_clamp(x * _SCALE32, 2147483647.0, -2147483648.0)
            binary.WriteI32LE(b, q as int)
        end
        i += 1
    end
end

func _write_float(b &: compress.ByteBuf, c: audio.Clip):
    src := audio.Data(c)
    n := c.frames * c.channels
    mut i := 0
    until i < n:
        binary.WriteF32(b, src[i] as f64, false)
        i += 1
    end
end
