package auth

// The other half of a login route: checking the password before a token is
// ever minted, and comparing a fixed secret without leaking it through
// timing.
//
// The hashing itself is std/crypto's PBKDF2-HMAC-SHA256 with a random salt;
// these are named passthroughs so a login handler does not have to reach
// into two packages, and so the storage format has one owner.

// Constant-time string compare, for API keys, webhook signatures and any
// other fixed secret. `==` returns on the first differing byte, and that
// timing difference is enough to recover a secret one byte at a time.
func _consttime_eq(a: str, b: str): bool:
    if a.len() != b.len(): ret false end
    n := a.len()
    ap := (a as void*) as i8*
    bp := (b as void*) as i8*
    mut diff := 0
    repeat n with i:
        mut x := ap[i] as int
        if x < 0: x = x + 256 end
        mut y := bp[i] as int
        if y < 0: y = y + 256 end
        diff = diff | (x ^ y)
    end
    ret diff == 0
end

// Hash a password for storage. The result carries its own salt and
// iteration count, so it is the single string to put in the database.
@en "HashPassword"
@fa "هش گذرواژه"
@ar "تجزئة كلمة المرور"
pub func HashPassword(password: str): str:
    ret crypto.HashPassword(password)
end

// Check a password against a stored hash.
@en "VerifyPassword"
@fa "تایید گذرواژه"
@ar "تحقق كلمة المرور"
pub func VerifyPassword(password: str, encoded: str): bool:
    ret crypto.VerifyPassword(password, encoded)
end

// Compare a caller-supplied secret with the expected one in time that does
// not depend on where they differ.
@en "SecretEquals"
@fa "برابری راز"
@ar "تساوي السر"
pub func SecretEquals(given: str, expected: str): bool:
    if expected.len() == 0: ret false end
    ret _consttime_eq(given, expected)
end

// A random, URL-safe secret: for signing keys, API keys and one-off tokens.
// `bytes` is the entropy in bytes; 32 is a reasonable floor for a JWT
// signing key.
@en "RandomSecret"
@fa "راز تصادفی"
@ar "سر عشوائي"
pub func RandomSecret(bytes: int): str:
    ret crypto.RandomHex(bytes)
end
