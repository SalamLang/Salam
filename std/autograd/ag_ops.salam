@en "Reshape"
@fa "تغییر شکل"
@ar "إعادة تشكيل"
pub func Reshape(tp &: Tape, a: int, shape &: Vector<int>): int:
    va := Value(tp, a)
    out := tensor.Reshape(va, shape)
    needs_grad := tp.needs.get(a)
    id := _push_val(tp, out, true, needs_grad)
    if needs_grad: _record(tp, _OP_RESHAPE, a, 0 - 1, id, 0 - 1, 0, 0, 0.0) end
    ret id
end

@en "Transpose2D"
@fa "ترانهاده دوبعدی"
@ar "منقول ثنائي"
pub func Transpose2D(tp &: Tape, a: int): int:
    va := Value(tp, a)
    out := tensor.Transpose2D(va)
    needs_grad := tp.needs.get(a)
    id := _push_val(tp, out, true, needs_grad)
    if needs_grad: _record(tp, _OP_TRANSPOSE2D, a, 0 - 1, id, 0 - 1, 0, 0, 0.0) end
    ret id
end
