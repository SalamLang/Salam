@en "autograd"
@fa "مشتق‌گیری خودکار"
package autograd

import tensor

const _OP_ADD := 1
const _OP_SUB := 2
const _OP_MUL := 3
const _OP_DIV := 4
const _OP_NEG := 5
const _OP_SCALE := 6
const _OP_ADDS := 7
const _OP_EXP := 8
const _OP_LOG := 9
const _OP_TANH := 10
const _OP_SIGMOID := 11
const _OP_RELU := 12
const _OP_GELU := 13
const _OP_SQRT := 14
const _OP_SQUARE := 15
const _OP_POWS := 16
const _OP_MATMUL := 17
const _OP_SUM := 18
const _OP_MEAN := 19
const _OP_SUMAXIS := 20
const _OP_MEANAXIS := 21
const _OP_SOFTMAX := 22
const _OP_LOGSOFTMAX := 23
const _OP_RESHAPE := 24
const _OP_TRANSPOSE2D := 25
const _OP_CELOSS := 26
const _OP_BCEWL := 27
const _OP_CONV2D := 28
const _OP_MAXPOOL := 29
const _OP_AVGPOOL := 30
const _OP_BMM := 31
const _OP_PERMUTE := 32
const _OP_EMBED := 33
const _OP_DROPOUT := 34
const _OP_LAYERNORM := 35
const _OP_NARROW := 36
const _OP_CONCAT2 := 37
const _OP_SILU := 38
const _OP_ROPE := 39
const _OP_RMSNORM := 40
const _OP_BATCHNORM := 41
const _OP_GROUPNORM := 42

@en "Node"
@fa "گره"
pub struct Node:
    pub op: int = 0
    pub a: int = 0 - 1
    pub b: int = 0 - 1
    pub out: int = 0 - 1
    pub aux: int = 0 - 1
    pub s0: int = 0
    pub s1: int = 0
    pub f0: f64 = 0.0
end

@en "Tape"
@fa "نوار"
pub struct Tape:
    pub vals: Vector<tensor.Tensor> = Vector {}
    pub grads: Vector<tensor.Tensor> = Vector {}
    pub owns_val: Vector<bool> = Vector {}
    pub owns_grad: Vector<bool> = Vector {}
    pub needs: Vector<bool> = Vector {}
    pub nodes: Vector<Node> = Vector {}
    pub training: bool = true
    pub rng: tensor.Rng = tensor.Rng {}

    @en "len"
    @fa "طول"
    pub func len(): int: ret this.vals.len() end

    @en "reset"
    @fa "بازنشانی"
    pub func reset():
        n := this.vals.len()
        repeat n with i:
            if this.owns_val.get(i):
                mut v := this.vals.get(i)
                v.free()
            end
            if this.owns_grad.get(i):
                mut g := this.grads.get(i)
                g.free()
            end
        end
        this.vals.clear()
        this.grads.clear()
        this.owns_val.clear()
        this.owns_grad.clear()
        this.needs.clear()
        this.nodes.clear()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.reset()
        this.vals.free()
        this.grads.free()
        this.owns_val.free()
        this.owns_grad.free()
        this.needs.free()
        this.nodes.free()
    end
end

func _alias(t &: tensor.Tensor): tensor.Tensor:
    mut h := tensor.Tensor {}
    h.data = t.data
    h.shape = t.shape
    ret h
end

func _push_val(tp &: Tape, t: tensor.Tensor, owned: bool, needs_grad: bool): int:
    id := tp.vals.len()
    tp.vals.push(t)
    tp.grads.push(tensor.Tensor {})
    tp.owns_val.push(owned)
    tp.owns_grad.push(false)
    tp.needs.push(needs_grad)
    ret id
end

func _record(tp &: Tape, op: int, a: int, b: int, out: int, aux: int, s0: int, s1: int, f0: f64):
    mut n := Node {}
    n.op = op
    n.a = a
    n.b = b
    n.out = out
    n.aux = aux
    n.s0 = s0
    n.s1 = s1
    n.f0 = f0
    tp.nodes.push(n)
end

func _grad_of(tp &: Tape, v: int): tensor.Tensor:
    mut g := tp.grads.get(v)
    if g.data.len() == 0:
        val := tp.vals.get(v)
        g = tensor.Zeros(val.shape)
        tp.grads.set(v, g)
        tp.owns_grad.set(v, true)
    end
    ret g
end

@en "NewTape"
@fa "نوار نو"
pub func NewTape(seed: i64): Tape:
    mut tp := Tape {}
    tp.rng = tensor.NewRng(seed)
    ret tp
end

@en "Input"
@fa "ورودی"
pub func Input(tp &: Tape, t &: tensor.Tensor): int:
    ret _push_val(tp, _alias(t), false, false)
end

@en "Constant"
@fa "ثابت"
pub func Constant(tp &: Tape, t &: tensor.Tensor): int:
    ret _push_val(tp, tensor.Clone(t), true, false)
end

@en "Watch"
@fa "پایش"
pub func Watch(tp &: Tape, t &: tensor.Tensor): int:
    ret _push_val(tp, _alias(t), false, true)
end

@en "Param"
@fa "پارامتر"
pub func Param(tp &: Tape, val &: tensor.Tensor, grad &: tensor.Tensor): int:
    id := _push_val(tp, _alias(val), false, true)
    tp.grads.set(id, _alias(grad))
    ret id
end

@en "Value"
@fa "مقدار"
pub func Value(tp &: Tape, v: int): tensor.Tensor:
    mut t := tp.vals.get(v)
    ret _alias(t)
end

@en "Grad"
@fa "گرادیان"
pub func Grad(tp &: Tape, v: int): tensor.Tensor:
    g := _grad_of(tp, v)
    ret g
end

@en "Backward"
@fa "پس‌انتشار"
pub func Backward(tp &: Tape, loss: int):
    if loss < 0 || loss >= tp.vals.len(): ret end
    mut seed := _grad_of(tp, loss)
    tensor.SetAll(seed, 1.0)
    mut i := tp.nodes.len() - 1
    until i >= 0:
        n := tp.nodes.get(i)
        g := tp.grads.get(n.out)
        if g.data.len() > 0:
            _backprop_node(tp, n)
        end
        i -= 1
    end
end

@en "GradCheck"
@fa "بررسی گرادیان"
pub func GradCheck(f: func (tensor.Tensor) f64, x &: tensor.Tensor, analytic &: tensor.Tensor, h: f64, tol: f64): bool:
    if x.same_shape(analytic) == false: ret false end
    hx := _alias(x)
    n := x.numel()
    mut ok := true
    repeat n with k:
        orig := x.at(k)
        x.set_at(k, orig + h)
        fp := f(hx)
        x.set_at(k, orig - h)
        fm := f(hx)
        x.set_at(k, orig)
        numeric := (fp - fm) / (2.0 * h)
        want := analytic.at(k)
        mut diff := numeric - want
        if diff < 0.0: diff = 0.0 - diff end
        mut scale := 1.0
        mut aw := want
        if aw < 0.0: aw = 0.0 - aw end
        if aw > scale: scale = aw end
        if diff > tol * scale: ok = false end
    end
    ret ok
end
