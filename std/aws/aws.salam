@en "aws"
@fa "ای دبلیو اس"
package aws

@en "SERVICE_S3"
@fa "سرویس اس۳"
pub const SERVICE_S3 := "s3"
@en "ALGORITHM"
@fa "الگوریتم امضا"
pub const ALGORITHM := "AWS4-HMAC-SHA256"

@en "EMPTY_SHA256"
@fa "چکیده بدنه خالی"
pub const EMPTY_SHA256 := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

@en "UNSIGNED_PAYLOAD"
@fa "بار امضانشده"
pub const UNSIGNED_PAYLOAD := "UNSIGNED-PAYLOAD"

@en "Config"
@fa "پیکربندی"
pub struct Config:
    @en "endpoint"
    @fa "نقطه پایانی"
    pub endpoint: str = ""
    @en "region"
    @fa "منطقه"
    pub region: str = "us-east-1"
    @en "bucket"
    @fa "سطل"
    pub bucket: str = ""
    @en "access_key"
    @fa "کلید دسترسی"
    pub access_key: str = ""
    @en "secret_key"
    @fa "کلید رمز"
    pub secret_key: str = ""
    @en "session_token"
    @fa "توکن نشست"
    pub session_token: str = ""
    @en "path_style"
    @fa "سبک مسیر"
    pub path_style: bool = true
    @en "service"
    @fa "سرویس"
    pub service: str = "s3"
    @en "expires"
    @fa "انقضای پیش‌فرض"
    pub expires: int = 900
    @en "retry"
    @fa "شمار کوشش"
    pub retry: int = 3
    @en "retry_base_ms"
    @fa "فاصله پایه کوشش دوباره"
    pub retry_base_ms: int = 100
    @en "anonymous"
    @fa "بی‌امضا"
    pub anonymous: bool = false
    @en "request_payer"
    @fa "پرداخت‌کننده درخواست"
    pub request_payer: bool = false
    @en "timeout_ms"
    @fa "مهلت"
    pub timeout_ms: int = 0
end

@en "Result"
@fa "نتیجه"
pub struct Result:
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
    @en "status"
    @fa "وضعیت"
    pub status: int = 0
    @en "body"
    @fa "بدنه"
    pub body: str = ""
    @en "etag"
    @fa "ای تگ"
    pub etag: str = ""
    @en "length"
    @fa "طول"
    pub length: i64 = 0
    @en "error"
    @fa "خطا"
    pub error: str = ""
    @en "head"
    @fa "سرآیندهای خام"
    pub head: str = ""
    @en "code"
    @fa "کد"
    pub code: str = ""
    @en "request_id"
    @fa "شناسه درخواست"
    pub request_id: str = ""
    @en "version_id"
    @fa "شناسه نسخه"
    pub version_id: str = ""
end

@en "NewConfig"
@fa "پیکربندی جدید"
pub func NewConfig(endpoint: str, bucket: str): Config:
    ret Config { endpoint = endpoint, bucket = bucket }
end

@en "WithCredentials"
@fa "با اعتبارنامه"
pub func WithCredentials(cfg: Config, access_key: str, secret_key: str): Config:
    mut out := cfg
    out.access_key = access_key
    out.secret_key = secret_key
    ret out
end

@en "Configured"
@fa "پیکربندی شده"
pub func Configured(cfg: Config): bool:
    if cfg.endpoint.len() == 0 or cfg.bucket.len() == 0: ret false end
    if cfg.anonymous: ret true end
    ret cfg.access_key.len() > 0 and cfg.secret_key.len() > 0
end

@en "Failure"
@fa "شکست"
pub func Failure(reason: str): Result:
    ret Result { ok = false, error = reason }
end
