package aws

// AWS Signature Version 4, and the S3 API built on it.
//
// The signing half is generic: SignRequest() will sign a request for any AWS
// service, and S3 is simply the first caller. The S3 half covers what an
// application does with an object store - store an object, read it back, ask
// about it, list, copy, delete, upload something too large for one request,
// and hand a browser a URL or a form that works without a credential.
//
// It works against S3 itself and against the S3-compatible services that
// matter in practice: MinIO, Cloudflare R2, Backblaze B2, Wasabi, DigitalOcean
// Spaces, Ceph. What differs between them is addressing, which is the
// `path_style` flag, and s3_creds has a constructor per service so that the
// difference does not have to be remembered.
//
// Where things are:
//
//   aws.salam           Config and Result - the two types everything shares
//   sigv4.salam         the four steps of a signature
//   s3_wire.salam       Headers, Request, Do() - every S3 request goes here
//   s3.salam            one object: put, get, stat, copy, delete
//   s3_list.salam       listing, and deleting in bulk
//   s3_multipart.salam  uploads assembled from parts
//   s3_bucket.salam     the bucket itself, and its lifecycle rules
//   s3_tagging.salam    tags, ACLs and holds
//   s3_file.salam       local files, a chunk at a time, in bounded memory
//   s3_presign.salam    URLs and forms that carry no credential
//   s3_creds.salam      constructing a Config, and reading a stored key
//   service.salam       Call/Invoke - the same signing, for any AWS service
//   sts.salam           temporary credentials: roles, web identities, MFA
//   chain.salam         finding a credential: role profiles, ECS, EC2
//   sqs.salam           queues, and the receive/handle/delete loop
//
// The one rule this package holds to about credentials: it never goes looking
// for one behind the caller's back. Resolve() takes an explicit list of places
// to try, reports which one answered, and leaves the two that touch the
// network off unless asked - because a chain that silently tries everything is
// how a program ends up signing with a credential nobody expected.
//
// See tests/en/stdlib/aws_demo.salam, aws_sts_demo.salam, aws_sqs_demo.salam
// and aws_s3_loopback.salam.

pub const SERVICE_S3 := "s3"
pub const ALGORITHM := "AWS4-HMAC-SHA256"

// The hash of an empty body, which every GET, HEAD and DELETE signs over.
// Precomputed because it never changes and appears in every such request.
pub const EMPTY_SHA256 := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

// The literal S3 accepts instead of a body hash when the payload is not to be
// hashed. Only valid over HTTPS, where the transport already protects it.
pub const UNSIGNED_PAYLOAD := "UNSIGNED-PAYLOAD"

// Config - where the objects are and who is asking.
//
// `endpoint` carries the scheme and host and nothing else:
// "https://s3.eu-central-1.amazonaws.com", "http://127.0.0.1:9000" for a local
// MinIO. The bucket is added by the addressing mode rather than being written
// into the endpoint, so one Config can be reused across buckets by copying it.
pub struct Config:
    pub endpoint: str = ""
    pub region: str = "us-east-1"
    pub bucket: str = ""
    pub access_key: str = ""
    pub secret_key: str = ""
    // Set for temporary credentials from STS or an instance role. Travels as
    // X-Amz-Security-Token and is part of the signature.
    pub session_token: str = ""
    // Path style puts the bucket in the path (host/bucket/key); virtual-host
    // style puts it in the hostname (bucket.host/key). AWS has deprecated path
    // style for new buckets; every self-hosted alternative requires it, which
    // is why it is the default here.
    pub path_style: bool = true
    pub service: str = "s3"
    // Seconds a signature is honoured for. Only presigned URLs carry one; a
    // signed header is checked against its own timestamp.
    pub expires: int = 900
    // How many times a request that failed in a way worth retrying is sent
    // again. An object store answers 500 and 503 under load, and treating
    // those as final loses data a second attempt would have stored. One
    // disables retrying entirely, which is what a test wants.
    pub retry: int = 3
    // The first backoff, doubled per attempt and capped at ten seconds.
    pub retry_base_ms: int = 100
    // Send no credential at all. A great many buckets are readable by anyone -
    // public datasets, static sites, release archives - and signing a request
    // to one is not merely unnecessary, it is impossible without an account.
    // Only reads make sense anonymously; a write will be refused by the
    // service, which is the correct place for that decision.
    pub anonymous: bool = false
    // Accept the charges for a requester-pays bucket. Without it such a bucket
    // answers 403 to every request, saying nothing about why.
    pub request_payer: bool = false
    // A deadline in milliseconds on every socket operation. Zero waits
    // forever, which is the old behaviour and the wrong default for anything
    // reached over a network nobody controls - a stalled connection with no
    // deadline stops the program rather than the request.
    pub timeout_ms: int = 0
end

// Result - one operation's outcome.
//
// `ok` is the only field to test. A failure carries a status when the service
// answered and zero when it never did, and `error` is either the service's own
// message or this package's reason for not asking.
pub struct Result:
    pub ok: bool = false
    pub status: int = 0
    pub body: str = ""
    pub etag: str = ""
    pub length: i64 = 0
    pub error: str = ""
    // The whole response head, so a caller can read a header this struct does
    // not lift into a field of its own. ResultHeader() is the accessor.
    pub head: str = ""
    // The service's own error code - "NoSuchKey", "AccessDenied",
    // "PreconditionFailed". Worth branching on where `error` is only worth
    // showing to a person.
    pub code: str = ""
    pub request_id: str = ""
    // Set on a versioned bucket, for the version this call created or read.
    pub version_id: str = ""
end

// NewConfig - a Config with the two things that have no sensible default.
pub func NewConfig(endpoint: str, bucket: str): Config:
    ret Config { endpoint = endpoint, bucket = bucket }
end

// WithCredentials - the same Config with keys attached, so a caller can build
// one in a single expression.
pub func WithCredentials(cfg: Config, access_key: str, secret_key: str): Config:
    mut out := cfg
    out.access_key = access_key
    out.secret_key = secret_key
    ret out
end

// Configured - whether a Config has everything a request needs. Checked before
// signing, so a missing key is a clear refusal rather than a 403 from AWS.
//
// An anonymous Config needs no keys, only somewhere to send the request.
pub func Configured(cfg: Config): bool:
    if cfg.endpoint.len() == 0 || cfg.bucket.len() == 0: ret false end
    if cfg.anonymous: ret true end
    ret cfg.access_key.len() > 0 && cfg.secret_key.len() > 0
end

pub func Failure(reason: str): Result:
    ret Result { ok = false, error = reason }
end
