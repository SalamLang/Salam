package aws

pub const SERVICE_S3 := "s3"
pub const ALGORITHM := "AWS4-HMAC-SHA256"

pub const EMPTY_SHA256 := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

pub const UNSIGNED_PAYLOAD := "UNSIGNED-PAYLOAD"

pub struct Config:
    pub endpoint: str = ""
    pub region: str = "us-east-1"
    pub bucket: str = ""
    pub access_key: str = ""
    pub secret_key: str = ""
    pub session_token: str = ""
    pub path_style: bool = true
    pub service: str = "s3"
    pub expires: int = 900
    pub retry: int = 3
    pub retry_base_ms: int = 100
    pub anonymous: bool = false
    pub request_payer: bool = false
    pub timeout_ms: int = 0
end

pub struct Result:
    pub ok: bool = false
    pub status: int = 0
    pub body: str = ""
    pub etag: str = ""
    pub length: i64 = 0
    pub error: str = ""
    pub head: str = ""
    pub code: str = ""
    pub request_id: str = ""
    pub version_id: str = ""
end

pub func NewConfig(endpoint: str, bucket: str): Config:
    ret Config { endpoint = endpoint, bucket = bucket }
end

pub func WithCredentials(cfg: Config, access_key: str, secret_key: str): Config:
    mut out := cfg
    out.access_key = access_key
    out.secret_key = secret_key
    ret out
end

pub func Configured(cfg: Config): bool:
    if cfg.endpoint.len() == 0 || cfg.bucket.len() == 0: ret false end
    if cfg.anonymous: ret true end
    ret cfg.access_key.len() > 0 && cfg.secret_key.len() > 0
end

pub func Failure(reason: str): Result:
    ret Result { ok = false, error = reason }
end
