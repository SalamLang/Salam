package aws

import str
import encoding.xml

func _bucket_request(method: str, bucket: str): Request:
    if bucket.len() == 0: ret NewRequest(method, "") end
    ret NewBucketRequest(method, bucket, "")
end

func _create_body(region: str): str:
    if region.len() == 0 || region == "us-east-1": ret "" end
    ret "<CreateBucketConfiguration>" + "<LocationConstraint>" + _xml_escape(region) + "</LocationConstraint>" + "</CreateBucketConfiguration>"
end

func _tag_body(tags: Headers): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "<Tagging><TagSet>")
    mut i := 0
    until i < tags.names.len():
        str.BufAppend(sb, "<Tag><Key>")
        str.BufAppend(sb, _xml_escape(tags.names.get(i)))
        str.BufAppend(sb, "</Key><Value>")
        str.BufAppend(sb, _xml_escape(tags.values.get(i)))
        str.BufAppend(sb, "</Value></Tag>")
        i += 1
    end
    str.BufAppend(sb, "</TagSet></Tagging>")
    ret str.BufStr(sb)
end

func _parse_tags(res: Result): Headers:
    mut out := Headers {}
    if !res.ok: ret out end
    mut ok := false
    root := xml.DecodeStrict(res.body, ok)
    if !ok: ret out end
    set := xml.Child(root, "TagSet")
    if !xml.Found(set): ret out end
    rows := xml.Children(set, "Tag")
    mut i := 0
    until i < rows.items.len():
        node := rows.items.get(i)
        HeaderSet(out, _xml_text(node, "Key"), _xml_text(node, "Value"))
        i += 1
    end
    ret out
end

pub func S3CreateBucket(cfg: Config, bucket: str): Result:
    mut r := _bucket_request("PUT", bucket)
    body := _create_body(cfg.region)
    if body.len() > 0:
        SetText(r, body)
        SetHeader(r, "Content-Type", "application/xml")
    end
    ret Do(cfg, r)
end

pub func S3CreateBucketAcl(cfg: Config, bucket: str, acl: str): Result:
    mut r := _bucket_request("PUT", bucket)
    SetHeader(r, "x-amz-acl", acl)
    body := _create_body(cfg.region)
    if body.len() > 0:
        SetText(r, body)
        SetHeader(r, "Content-Type", "application/xml")
    end
    ret Do(cfg, r)
end

pub func S3DeleteBucket(cfg: Config, bucket: str): Result:
    ret Do(cfg, _bucket_request("DELETE", bucket))
end

pub func S3HeadBucket(cfg: Config, bucket: str): Result:
    ret Do(cfg, _bucket_request("HEAD", bucket))
end

pub func S3BucketExists(cfg: Config, bucket: str): bool:
    ret S3HeadBucket(cfg, bucket).ok
end

pub func S3ListBuckets(cfg: Config): BucketList:
    res := Do(cfg, NewServiceRequest("GET"))
    if !res.ok:
        ret BucketList { status = res.status, error = res.error, code = res.code }
    end
    mut ok := false
    root := xml.DecodeStrict(res.body, ok)
    if !ok:
        ret BucketList {
            status = res.status, error = "the bucket listing could not be parsed", code = "MalformedXML"
        }
    end
    mut out := BucketList { ok = true, status = res.status }
    owner := xml.Child(root, "Owner")
    if xml.Found(owner):
        out.owner = _xml_text(owner, "DisplayName")
        if out.owner.len() == 0: out.owner = _xml_text(owner, "ID") end
    end
    holder := xml.Child(root, "Buckets")
    if !xml.Found(holder): ret out end
    rows := xml.Children(holder, "Bucket")
    mut i := 0
    until i < rows.items.len():
        node := rows.items.get(i)
        mut b := BucketEntry {
            name = _xml_text(node, "Name"), created = _xml_text(node, "CreationDate"), region = _xml_text(node, "BucketRegion")
        }
        b.created_epoch = _iso_epoch(b.created)
        out.items.push(b)
        i += 1
    end
    ret out
end

pub func BucketCount(l: BucketList): int: ret l.items.len() end

pub func BucketAt(l: BucketList, i: int): BucketEntry:
    if i < 0 || i >= l.items.len(): ret BucketEntry {} end
    ret l.items.get(i)
end

pub func BucketListFree(l &: BucketList): l.items.free() end

pub func S3BucketRegion(cfg: Config, bucket: str): str:
    mut r := _bucket_request("GET", bucket)
    SetFlag(r, "location")
    res := Do(cfg, r)
    if !res.ok:
        hinted := ResultHeader(res, "x-amz-bucket-region")
        if hinted.len() > 0: ret hinted end
        ret ""
    end
    where := ResultTag(res.body, "LocationConstraint").trim()
    if where.len() == 0: ret "us-east-1" end
    ret where
end

pub func S3SetVersioning(cfg: Config, bucket: str, enabled: bool): Result:
    mut r := _bucket_request("PUT", bucket)
    SetFlag(r, "versioning")
    mut state := "Suspended"
    if enabled: state = "Enabled" end
    body := "<VersioningConfiguration><Status>" + state + "</Status></VersioningConfiguration>"
    SetText(r, body)
    SetHeader(r, "Content-Type", "application/xml")
    SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
    ret Do(cfg, r)
end

pub func S3Versioning(cfg: Config, bucket: str): str:
    mut r := _bucket_request("GET", bucket)
    SetFlag(r, "versioning")
    res := Do(cfg, r)
    if !res.ok: ret "" end
    ret ResultTag(res.body, "Status").trim()
end

pub func S3SetBucketTags(cfg: Config, bucket: str, tags: Headers): Result:
    mut r := _bucket_request("PUT", bucket)
    SetFlag(r, "tagging")
    body := _tag_body(tags)
    SetText(r, body)
    SetHeader(r, "Content-Type", "application/xml")
    SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
    ret Do(cfg, r)
end

pub func S3BucketTags(cfg: Config, bucket: str): Headers:
    mut r := _bucket_request("GET", bucket)
    SetFlag(r, "tagging")
    ret _parse_tags(Do(cfg, r))
end

pub func S3DeleteBucketTags(cfg: Config, bucket: str): Result:
    mut r := _bucket_request("DELETE", bucket)
    SetFlag(r, "tagging")
    ret Do(cfg, r)
end

pub func S3SetBucketPolicy(cfg: Config, bucket: str, policy_json: str): Result:
    if policy_json.len() == 0:
        ret Failure("a bucket policy cannot be empty; delete it instead")
    end
    mut r := _bucket_request("PUT", bucket)
    SetFlag(r, "policy")
    SetText(r, policy_json)
    SetHeader(r, "Content-Type", "application/json")
    ret Do(cfg, r)
end

pub func S3BucketPolicy(cfg: Config, bucket: str): str:
    mut r := _bucket_request("GET", bucket)
    SetFlag(r, "policy")
    res := Do(cfg, r)
    if !res.ok: ret "" end
    ret res.body
end

pub func S3DeleteBucketPolicy(cfg: Config, bucket: str): Result:
    mut r := _bucket_request("DELETE", bucket)
    SetFlag(r, "policy")
    ret Do(cfg, r)
end

pub func S3SetBucketCors(
    cfg: Config, bucket: str, origin: str, methods: str, max_age: int
): Result:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "<CORSConfiguration><CORSRule><AllowedOrigin>")
    str.BufAppend(sb, _xml_escape(origin))
    str.BufAppend(sb, "</AllowedOrigin>")
    mut rest := methods
    mut more := true
    until more:
        comma := rest.find(",")
        mut one := rest
        if comma >= 0:
            one = rest.substr(0, comma)
            rest = rest.substr(comma + 1, rest.len() - comma - 1)
        else:
            more = false
        end
        one = one.trim()
        if one.len() > 0:
            str.BufAppend(sb, "<AllowedMethod>")
            str.BufAppend(sb, one.upper())
            str.BufAppend(sb, "</AllowedMethod>")
        end
    end
    str.BufAppend(sb, "<AllowedHeader>*</AllowedHeader>")
    str.BufAppend(sb, "<ExposeHeader>ETag</ExposeHeader>")
    if max_age > 0:
        str.BufAppend(sb, "<MaxAgeSeconds>")
        str.BufAppendInt(sb, max_age as i64)
        str.BufAppend(sb, "</MaxAgeSeconds>")
    end
    str.BufAppend(sb, "</CORSRule></CORSConfiguration>")
    body := str.BufStr(sb)
    mut r := _bucket_request("PUT", bucket)
    SetFlag(r, "cors")
    SetText(r, body)
    SetHeader(r, "Content-Type", "application/xml")
    SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
    ret Do(cfg, r)
end

pub func S3BucketCors(cfg: Config, bucket: str): str:
    mut r := _bucket_request("GET", bucket)
    SetFlag(r, "cors")
    res := Do(cfg, r)
    if !res.ok: ret "" end
    ret res.body
end

pub func S3DeleteBucketCors(cfg: Config, bucket: str): Result:
    mut r := _bucket_request("DELETE", bucket)
    SetFlag(r, "cors")
    ret Do(cfg, r)
end

pub func S3SetLifecycle(cfg: Config, bucket: str, config_xml: str): Result:
    mut r := _bucket_request("PUT", bucket)
    SetFlag(r, "lifecycle")
    SetText(r, config_xml)
    SetHeader(r, "Content-Type", "application/xml")
    SetHeader(r, "Content-MD5", S3ContentMd5(config_xml as void*, config_xml.len()))
    ret Do(cfg, r)
end

pub func S3Lifecycle(cfg: Config, bucket: str): str:
    mut r := _bucket_request("GET", bucket)
    SetFlag(r, "lifecycle")
    res := Do(cfg, r)
    if !res.ok: ret "" end
    ret res.body
end

pub func S3DeleteLifecycle(cfg: Config, bucket: str): Result:
    mut r := _bucket_request("DELETE", bucket)
    SetFlag(r, "lifecycle")
    ret Do(cfg, r)
end

pub func S3ExpiryRule(prefix: str, days: int, abort_days: int): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "<LifecycleConfiguration><Rule><ID>salam-expiry</ID>")
    str.BufAppend(sb, "<Filter><Prefix>")
    str.BufAppend(sb, _xml_escape(prefix))
    str.BufAppend(sb, "</Prefix></Filter><Status>Enabled</Status>")
    if days > 0:
        str.BufAppend(sb, "<Expiration><Days>")
        str.BufAppendInt(sb, days as i64)
        str.BufAppend(sb, "</Days></Expiration>")
    end
    mut abort := abort_days
    if abort <= 0: abort = 7 end
    str.BufAppend(sb, "<AbortIncompleteMultipartUpload><DaysAfterInitiation>")
    str.BufAppendInt(sb, abort as i64)
    str.BufAppend(sb, "</DaysAfterInitiation></AbortIncompleteMultipartUpload>")
    str.BufAppend(sb, "</Rule></LifecycleConfiguration>")
    ret str.BufStr(sb)
end
