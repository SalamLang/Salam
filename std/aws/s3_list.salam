package aws

// Listing: what is in the bucket.
//
// S3 has no directories. What it has is a flat key space and a delimiter, and
// the illusion of a folder is what you get by listing with `prefix = "photos/"`
// and `delimiter = "/"`: keys directly under it come back as objects, and
// everything deeper is collapsed into a common prefix, which is the folder.
// That single fact explains the whole shape of this API.
//
// A listing is always paginated - a thousand keys at a time by default - and a
// caller that ignores the truncation flag silently sees a prefix of the truth.
// S3List() hands back one page and the token for the next; S3ListAll() follows
// the tokens itself and is the one to reach for unless the count is unbounded.

import str
import encoding.xml

// The page size S3 uses when none is asked for, and its hard ceiling.
const _S3_LIST_MAX := 1000

// The ceiling S3ListAll() stops at, so a mistaken prefix on a bucket with ten
// million keys fails visibly rather than running until memory is gone.
const _S3_LIST_ALL_CAP := 100000

// The number of keys one batch delete accepts. S3's limit, not this
// package's; DeleteMany() splits a longer list into batches of this size.
const _S3_DELETE_BATCH := 1000

// ObjectEntry - one row of a listing.
//
// A listing tells you less than a HEAD does: no content type, no user
// metadata. That is S3's answer, not a shortcut here - listing a thousand keys
// cannot afford to carry a thousand metadata blocks. Use S3Stat() when the
// missing fields matter.
pub struct ObjectEntry:
    pub key: str = ""
    pub size: i64 = 0
    pub etag: str = ""
    pub last_modified: str = ""
    pub modified_epoch: i64 = 0
    pub storage_class: str = ""
    pub owner: str = ""
    // Only a version listing fills these in.
    pub version_id: str = ""
    pub is_latest: bool = false
    pub delete_marker: bool = false
end

// ObjectList - one page of a listing.
//
// `truncated` and `next_token` are the pair that matters: while `truncated` is
// true there are more keys, and `next_token` is where to resume.
pub struct ObjectList:
    pub ok: bool = false
    pub status: int = 0
    pub items: Vector<ObjectEntry> = Vector {}
    // The "folders": prefixes collapsed by the delimiter.
    pub prefixes: Vector<str> = Vector {}
    pub truncated: bool = false
    pub next_token: str = ""
    // A version listing resumes on two markers rather than one token.
    pub next_key_marker: str = ""
    pub next_version_marker: str = ""
    pub key_count: int = 0
    pub name: str = ""
    pub prefix: str = ""
    pub delimiter: str = ""
    pub error: str = ""
    pub code: str = ""
end

// BucketEntry - one bucket of an account.
pub struct BucketEntry:
    pub name: str = ""
    pub created: str = ""
    pub created_epoch: i64 = 0
    pub region: str = ""
end

pub struct BucketList:
    pub ok: bool = false
    pub status: int = 0
    pub items: Vector<BucketEntry> = Vector {}
    pub owner: str = ""
    pub error: str = ""
    pub code: str = ""
end

// ListOptions - how to narrow a listing.
pub struct ListOptions:
    pub prefix: str = ""
    // "/" turns a flat key space into folders. Empty lists everything below
    // the prefix, however deep.
    pub delimiter: str = ""
    // Keys per page, capped at 1000 by S3. Zero takes the default.
    pub max_keys: int = 0
    // From a previous page's next_token.
    pub continuation_token: str = ""
    // Resume from just after this key, without a token. Useful for a resumable
    // scan that stores a key rather than an opaque token.
    pub start_after: str = ""
    pub fetch_owner: bool = false
    // Ask S3 to percent-encode the keys it returns. On by default, and worth
    // leaving on: without it a key containing a newline or a control character
    // produces XML that no parser can read back faithfully.
    pub url_encode: bool = true
end

// KeyList - a plain list of keys, for the calls that only need names.
//
// A struct rather than a bare Vector<str> because a public function that
// returns a generic vector across a package boundary does not compile; the
// same reason encoding.xml has an XMLNodeList.
pub struct KeyList:
    pub items: Vector<str> = Vector {}
end

func _list_query(r &: Request, o: ListOptions, v2: bool):
    if o.prefix.len() > 0: SetQuery(r, "prefix", o.prefix) end
    if o.delimiter.len() > 0: SetQuery(r, "delimiter", o.delimiter) end
    mut n := o.max_keys
    if n > _S3_LIST_MAX: n = _S3_LIST_MAX end
    if n > 0: SetQueryInt(r, "max-keys", n) end
    if o.url_encode: SetQuery(r, "encoding-type", "url") end
    if !v2: ret end
    if o.continuation_token.len() > 0:
        SetQuery(r, "continuation-token", o.continuation_token)
    end
    if o.start_after.len() > 0: SetQuery(r, "start-after", o.start_after) end
    if o.fetch_owner: SetQuery(r, "fetch-owner", "true") end
end

func _entry_of(node: xml.XMLNode, encoded: bool): ObjectEntry:
    mut e := ObjectEntry {
        key = _decoded(_xml_text(node, "Key"), encoded),
        size = _xml_int(node, "Size"),
        etag = Unquote(_xml_text(node, "ETag")),
        last_modified = _xml_text(node, "LastModified"),
        storage_class = _xml_text(node, "StorageClass"),
        version_id = _xml_text(node, "VersionId"),
        is_latest = _xml_bool(node, "IsLatest")
    }
    e.modified_epoch = _iso_epoch(e.last_modified)
    owner := xml.Child(node, "Owner")
    if xml.Found(owner):
        e.owner = _xml_text(owner, "DisplayName")
        if e.owner.len() == 0: e.owner = _xml_text(owner, "ID") end
    end
    ret e
end

func _fill_prefixes(root: xml.XMLNode, out &: ObjectList, encoded: bool):
    group := xml.Children(root, "CommonPrefixes")
    mut i := 0
    until i < group.items.len():
        p := _decoded(_xml_text(group.items.get(i), "Prefix"), encoded)
        if p.len() > 0: out.prefixes.push(p) end
        i += 1
    end
end

func _fill_contents(root: xml.XMLNode, tag: str, out &: ObjectList,
    encoded: bool, marker: bool):
    rows := xml.Children(root, tag)
    mut i := 0
    until i < rows.items.len():
        mut e := _entry_of(rows.items.get(i), encoded)
        e.delete_marker = marker
        out.items.push(e)
        i += 1
    end
end

func _list_failure(res: Result): ObjectList:
    ret ObjectList {
        ok = false, status = res.status, error = res.error, code = res.code
    }
end

// _parse_list - a ListBucketResult, from either list-type. The two differ only
// in how they say "there is more".
func _parse_list(res: Result): ObjectList:
    if !res.ok: ret _list_failure(res) end
    mut ok := false
    root := xml.DecodeStrict(res.body, ok)
    if !ok:
        ret ObjectList {
            status = res.status,
            error = "the listing could not be parsed",
            code = "MalformedXML"
        }
    end
    encoded := _xml_text(root, "EncodingType").lower() == "url"
    mut out := ObjectList {
        ok = true,
        status = res.status,
        name = _xml_text(root, "Name"),
        prefix = _decoded(_xml_text(root, "Prefix"), encoded),
        delimiter = _decoded(_xml_text(root, "Delimiter"), encoded),
        truncated = _xml_bool(root, "IsTruncated"),
        next_token = _xml_text(root, "NextContinuationToken"),
        next_key_marker = _decoded(_xml_text(root, "NextKeyMarker"), encoded),
        next_version_marker = _xml_text(root, "NextVersionIdMarker")
    }
    // V1 resumes on a marker; when S3 omits NextMarker on a truncated V1 page,
    // the last key is the marker, which is what the specification says to do.
    if out.next_token.len() == 0:
        out.next_token = _decoded(_xml_text(root, "NextMarker"), encoded)
    end
    _fill_contents(root, "Contents", out, encoded, false)
    _fill_contents(root, "Version", out, encoded, false)
    _fill_contents(root, "DeleteMarker", out, encoded, true)
    _fill_prefixes(root, out, encoded)
    out.key_count = out.items.len()
    if out.truncated && out.next_token.len() == 0 && out.items.len() > 0:
        out.next_token = out.items.get(out.items.len() - 1).key
    end
    ret out
end

// _delete_body - the XML a batch delete sends. Quiet mode asks S3 to report
// only failures, which is what turns a thousand-key delete into a short answer.
func _delete_body(keys: KeyList, from: int, count: int, quiet: bool): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "<Delete>")
    if quiet: str.BufAppend(sb, "<Quiet>true</Quiet>") end
    mut i := 0
    until i < count:
        str.BufAppend(sb, "<Object><Key>")
        str.BufAppend(sb, _xml_escape(keys.items.get(from + i)))
        str.BufAppend(sb, "</Key></Object>")
        i += 1
    end
    str.BufAppend(sb, "</Delete>")
    ret str.BufStr(sb)
end

// _list_result - a failed listing as a plain Result.
func _list_result(l: ObjectList): Result:
    ret Result {
        ok = l.ok, status = l.status, error = l.error, code = l.code,
        length = l.items.len() as i64
    }
end

// ------------------------------------------------------------- public API

// S3List - one page of a listing.
//
// The delimiter is what makes this feel like a filesystem: with "/" the answer
// separates keys directly under the prefix from the prefixes below it.
pub func S3List(cfg: Config, o: ListOptions): ObjectList:
    mut r := NewRequest("GET", "")
    SetQuery(r, "list-type", "2")
    _list_query(r, o, true)
    ret _parse_list(Do(cfg, r))
end

// S3ListPrefix - the short form: everything under a prefix, one page.
pub func S3ListPrefix(cfg: Config, prefix: str): ObjectList:
    ret S3List(cfg, ListOptions { prefix = prefix })
end

// S3ListFolder - one level under a prefix, with the deeper keys collapsed into
// `prefixes`. What a file browser shows.
pub func S3ListFolder(cfg: Config, prefix: str): ObjectList:
    ret S3List(cfg, ListOptions { prefix = prefix, delimiter = "/" })
end

// S3ListV1 - the older listing, for an S3-compatible service that never
// implemented list-type=2. The answer is the same shape.
pub func S3ListV1(cfg: Config, o: ListOptions, marker: str): ObjectList:
    mut r := NewRequest("GET", "")
    _list_query(r, o, false)
    if marker.len() > 0: SetQuery(r, "marker", marker) end
    ret _parse_list(Do(cfg, r))
end

// S3ListAll - every key under a prefix, following the pagination.
//
// Stops at a hundred thousand keys and says so in `truncated`, because the
// alternative is that a typo in a prefix turns into an unbounded allocation.
// A bucket genuinely larger than that wants S3List() and a loop that processes
// each page instead of collecting them.
pub func S3ListAll(cfg: Config, prefix: str): ObjectList:
    ret S3ListAllWith(cfg, ListOptions { prefix = prefix })
end

// S3ListAllWith - the same, with a delimiter or a page size.
pub func S3ListAllWith(cfg: Config, o: ListOptions): ObjectList:
    mut opts := o
    mut out := ObjectList { ok = true, prefix = o.prefix, delimiter = o.delimiter }
    until true:
        page := S3List(cfg, opts)
        if !page.ok: ret page end
        out.name = page.name
        out.status = page.status
        mut i := 0
        until i < page.items.len():
            out.items.push(page.items.get(i))
            i += 1
        end
        mut p := 0
        until p < page.prefixes.len():
            out.prefixes.push(page.prefixes.get(p))
            p += 1
        end
        if !page.truncated || page.next_token.len() == 0:
            out.key_count = out.items.len()
            ret out
        end
        if out.items.len() >= _S3_LIST_ALL_CAP:
            out.truncated = true
            out.next_token = page.next_token
            out.key_count = out.items.len()
            ret out
        end
        // A token that does not advance means the service is answering the
        // same page forever. Stopping is the only safe reading: continuing
        // collects the same keys until the cap, and reports a count that is
        // pure fiction.
        if page.next_token == opts.continuation_token:
            out.truncated = true
            out.next_token = page.next_token
            out.key_count = out.items.len()
            ret out
        end
        opts.continuation_token = page.next_token
    end
end

// S3ListVersions - every version and delete marker under a prefix, one page.
// Only a versioned bucket answers with more than the current versions.
pub func S3ListVersions(cfg: Config, o: ListOptions, key_marker: str,
    version_marker: str): ObjectList:
    mut r := NewRequest("GET", "")
    SetFlag(r, "versions")
    _list_query(r, o, false)
    if key_marker.len() > 0: SetQuery(r, "key-marker", key_marker) end
    if version_marker.len() > 0:
        SetQuery(r, "version-id-marker", version_marker)
    end
    ret _parse_list(Do(cfg, r))
end

// S3Keys - just the names, for a caller that does not need the sizes.
pub func S3Keys(cfg: Config, prefix: str): KeyList:
    listing := S3ListAll(cfg, prefix)
    mut out := KeyList {}
    mut i := 0
    until i < listing.items.len():
        out.items.push(listing.items.get(i).key)
        i += 1
    end
    ret out
end

// ListCount - the number of objects in a listing.
pub func ListCount(l: ObjectList): int: ret l.items.len() end

// ListAt - one entry. Out of range answers an empty entry rather than
// trapping, so a loop with an off-by-one misbehaves visibly instead of
// killing the process.
pub func ListAt(l: ObjectList, i: int): ObjectEntry:
    if i < 0 || i >= l.items.len(): ret ObjectEntry {} end
    ret l.items.get(i)
end

pub func ListPrefixCount(l: ObjectList): int: ret l.prefixes.len() end

pub func ListPrefixAt(l: ObjectList, i: int): str:
    if i < 0 || i >= l.prefixes.len(): ret "" end
    ret l.prefixes.get(i)
end

// ListTotalSize - the bytes a listing accounts for.
pub func ListTotalSize(l: ObjectList): i64:
    mut total := 0 as i64
    mut i := 0
    until i < l.items.len():
        total = total + l.items.get(i).size
        i += 1
    end
    ret total
end

pub func ListFree(l &: ObjectList):
    l.items.free()
    l.prefixes.free()
end

pub func KeyCount(k: KeyList): int: ret k.items.len() end

pub func KeyAt(k: KeyList, i: int): str:
    if i < 0 || i >= k.items.len(): ret "" end
    ret k.items.get(i)
end

pub func NewKeyList(): KeyList: ret KeyList {} end

pub func KeyPush(k &: KeyList, key: str): k.items.push(key) end

pub func KeyFree(k &: KeyList): k.items.free() end

// S3DeleteMany - remove up to a thousand objects per request.
//
// The reason to prefer this over a loop of deletes is not tidiness: it is one
// round trip instead of a thousand, which against a service on the other side
// of an ocean is the difference between a second and several minutes.
pub func S3DeleteMany(cfg: Config, keys: KeyList): Result:
    total := keys.items.len()
    if total == 0: ret Result { ok = true, status = 200 } end
    mut done := 0
    mut last := Result { ok = true, status = 200 }
    until done < total:
        mut count := total - done
        if count > _S3_DELETE_BATCH: count = _S3_DELETE_BATCH end
        body := _delete_body(keys, done, count, true)
        mut r := NewRequest("POST", "")
        SetFlag(r, "delete")
        SetText(r, body)
        SetHeader(r, "Content-Type", "application/xml")
        // S3 requires Content-MD5 on this one request, and several
        // S3-compatible services enforce it even where AWS no longer does.
        SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
        res := Do(cfg, r)
        if !res.ok: ret res end
        // A batch delete answers 200 even when individual keys failed; the
        // failures are in the body, and quiet mode means nothing else is.
        if res.body.find("<Error>") >= 0:
            mut bad := res
            bad.ok = false
            bad.code = ResultErrorCode(res.body)
            bad.error = ResultErrorMessage(res.body, res.status)
            ret bad
        end
        last = res
        done += count
    end
    ret last
end

// S3DeletePrefix - remove everything under a prefix.
//
// The operation a bucket has no primitive for, and the one an application
// most often means by "delete the folder". Lists, then deletes in batches,
// repeating while the listing is truncated.
pub func S3DeletePrefix(cfg: Config, prefix: str): Result:
    if prefix.len() == 0:
        ret Failure("refusing to delete every object in the bucket; pass a prefix")
    end
    mut token := ""
    mut removed := 0
    until true:
        page := S3List(cfg, ListOptions {
            prefix = prefix, continuation_token = token, max_keys = _S3_LIST_MAX
        })
        if !page.ok: ret _list_result(page) end
        if page.items.len() == 0:
            ret Result { ok = true, status = 200, length = removed as i64 }
        end
        mut batch := KeyList {}
        mut i := 0
        until i < page.items.len():
            batch.items.push(page.items.get(i).key)
            i += 1
        end
        res := S3DeleteMany(cfg, batch)
        batch.items.free()
        if !res.ok: ret res end
        removed += page.items.len()
        if !page.truncated || page.next_token.len() == 0:
            ret Result { ok = true, status = 200, length = removed as i64 }
        end
        if page.next_token == token:
            ret Failure("the listing stopped advancing at " + page.next_token)
        end
        token = page.next_token
    end
end

// ListToResult - a failed listing as a plain Result, for a caller threading
// one error type through several operations.
pub func ListToResult(l: ObjectList): Result:
    ret _list_result(l)
end

// ParseListing - a listing document that arrived from somewhere other than
// this package's own request.
//
// Public for two reasons: it is the only way to exercise the parser without a
// service in front of it, and an application that already has a stored answer
// - a cached page, a replayed capture - should not have to re-fetch it to read
// it back.
pub func ParseListing(body: str, status: int): ObjectList:
    ret _parse_list(Result {
        ok = status >= 200 && status < 300, status = status, body = body
    })
end
