package aws

import str

const _S3_TAG_MAX := 50

func _object_tag_request(method: str, key: str, version_id: str): Request:
    mut r := NewRequest(method, key)
    SetFlag(r, "tagging")
    if version_id.len() > 0: SetQuery(r, "versionId", version_id) end
    ret r
end

pub func NewTags(): Headers: ret Headers {} end

pub func TagSet(h &: Headers, name: str, value: str): HeaderSet(h, name, value) end

pub func TagString(tags: Headers): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < tags.names.len():
        if i > 0: str.BufAppend(sb, "&") end
        str.BufAppend(sb, UriEncode(tags.names.get(i), false))
        str.BufAppend(sb, "=")
        str.BufAppend(sb, UriEncode(tags.values.get(i), false))
        i += 1
    end
    ret str.BufStr(sb)
end

pub func S3SetObjectTags(cfg: Config, key: str, tags: Headers): Result:
    if tags.names.len() > _S3_TAG_MAX:
        ret Failure("an object may carry at most " + _S3_TAG_MAX + " tags")
    end
    mut r := _object_tag_request("PUT", key, "")
    body := _tag_body(tags)
    SetText(r, body)
    SetHeader(r, "Content-Type", "application/xml")
    SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
    ret Do(cfg, r)
end

pub func S3ObjectTags(cfg: Config, key: str): Headers:
    ret _parse_tags(Do(cfg, _object_tag_request("GET", key, "")))
end

pub func S3ObjectTagsVersion(cfg: Config, key: str, version_id: str): Headers:
    ret _parse_tags(Do(cfg, _object_tag_request("GET", key, version_id)))
end

pub func S3DeleteObjectTags(cfg: Config, key: str): Result:
    ret Do(cfg, _object_tag_request("DELETE", key, ""))
end

pub func S3AddObjectTag(cfg: Config, key: str, name: str, value: str): Result:
    mut tags := S3ObjectTags(cfg, key)
    HeaderSet(tags, name, value)
    res := S3SetObjectTags(cfg, key, tags)
    HeaderFree(tags)
    ret res
end

pub func S3SetObjectAcl(cfg: Config, key: str, acl: str): Result:
    mut r := NewRequest("PUT", key)
    SetFlag(r, "acl")
    SetHeader(r, "x-amz-acl", acl)
    ret Do(cfg, r)
end

pub func S3ObjectAcl(cfg: Config, key: str): str:
    mut r := NewRequest("GET", key)
    SetFlag(r, "acl")
    res := Do(cfg, r)
    if !res.ok: ret "" end
    ret res.body
end

pub func S3MakePublic(cfg: Config, key: str): Result:
    ret S3SetObjectAcl(cfg, key, "public-read")
end

pub func S3MakePrivate(cfg: Config, key: str): Result:
    ret S3SetObjectAcl(cfg, key, "private")
end

pub func S3SetLegalHold(cfg: Config, key: str, held: bool): Result:
    mut r := NewRequest("PUT", key)
    SetFlag(r, "legal-hold")
    mut state := "OFF"
    if held: state = "ON" end
    body := "<LegalHold><Status>" + state + "</Status></LegalHold>"
    SetText(r, body)
    SetHeader(r, "Content-Type", "application/xml")
    SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
    ret Do(cfg, r)
end

pub func S3LegalHold(cfg: Config, key: str): bool:
    mut r := NewRequest("GET", key)
    SetFlag(r, "legal-hold")
    res := Do(cfg, r)
    if !res.ok: ret false end
    ret ResultTag(res.body, "Status").trim().upper() == "ON"
end

pub func S3SetRetention(
    cfg: Config, key: str, mode: str, until_epoch: i64
): Result:
    mut r := NewRequest("PUT", key)
    SetFlag(r, "retention")
    mut m := mode.upper()
    if m != "COMPLIANCE": m = "GOVERNANCE" end
    body := "<Retention><Mode>" + m + "</Mode><RetainUntilDate>" + time.FormatISOUTC(until_epoch) + "</RetainUntilDate></Retention>"
    SetText(r, body)
    SetHeader(r, "Content-Type", "application/xml")
    SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
    ret Do(cfg, r)
end
