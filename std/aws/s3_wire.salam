package aws

import mem
import str
import time
import conv
import net.http

const _S3_HDR_MAX := 128

@en "Headers"
@fa "سرآیندها"
pub struct Headers:
    @en "names"
    @fa "نام‌ها"
    pub names: Vector<str> = Vector {}
    @en "values"
    @fa "مقدارها"
    pub values: Vector<str> = Vector {}
end

@en "Request"
@fa "درخواست"
pub struct Request:
    @en "method"
    @fa "روش"
    pub method: str = "GET"
    @en "key"
    @fa "کلید"
    pub key: str = ""
    @en "bucket"
    @fa "سطل"
    pub bucket: str = ""
    @en "service_level"
    @fa "سطح سرویس"
    pub service_level: bool = false
    @en "headers"
    @fa "سرآیندها"
    pub headers: Headers = Headers {}
    @en "query"
    @fa "پارامترهای پرسمان"
    pub query: Headers = Headers {}
    @en "body"
    @fa "بدنه"
    pub body: void* = null
    @en "body_len"
    @fa "طول بدنه"
    pub body_len: int = 0
    @en "body_hash"
    @fa "چکیده بدنه"
    pub body_hash: str = ""
end

@en "Bytes"
@fa "بایت‌ها"
pub struct Bytes:
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
    @en "status"
    @fa "وضعیت"
    pub status: int = 0
    @en "data"
    @fa "داده"
    pub data: void* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
    @en "etag"
    @fa "ای تگ"
    pub etag: str = ""
    @en "head"
    @fa "سرآیندهای خام"
    pub head: str = ""
    @en "code"
    @fa "کد"
    pub code: str = ""
    @en "error"
    @fa "خطا"
    pub error: str = ""
end

func _hdr_find(h: Headers, name: str): int:
    lower := name.Lower()
    mut i := 0
    until i < h.names.Len():
        if h.names.Get(i).Lower() == lower: ret i end
        i++
    end
    ret -1
end

func _hdr_set(h &: Headers, name: str, value: str):
    at := _hdr_find(h, name)
    if at >= 0:
        h.values.Set(at, value)
        ret
    end
    if h.names.Len() >= _S3_HDR_MAX: ret end
    h.names.Push(name)
    h.values.Push(value)
end

func _hdr_copy(src: Headers): Headers:
    mut out := Headers {}
    mut i := 0
    until i < src.names.Len():
        out.names.Push(src.names.Get(i))
        out.values.Push(src.values.Get(i))
        i++
    end
    ret out
end

func _hdr_sort(h &: Headers):
    n := h.names.Len()
    mut i := 1
    until i < n:
        nm := h.names.Get(i)
        vl := h.values.Get(i)
        mut j := i - 1
        until j >= 0 and str.Compare(h.names.Get(j), nm) > 0:
            h.names.Set(j + 1, h.names.Get(j))
            h.values.Set(j + 1, h.values.Get(j))
            j--
        end
        h.names.Set(j + 1, nm)
        h.values.Set(j + 1, vl)
        i++
    end
end

func _canon_value(v: str): str:
    mut out := v.Trim()
    until str.Contains(out, "  "):
        out = str.Replace(out, "  ", " ")
    end
    ret out
end

func _canon_headers(h: Headers, signed &: str): str:
    mut sorted := _hdr_copy(h)
    mut i := 0
    until i < sorted.names.Len():
        sorted.names.Set(i, sorted.names.Get(i).Lower())
        i++
    end
    _hdr_sort(sorted)
    mut block := str.NewBuilder()
    defer str.BufFree(block)
    mut list := str.NewBuilder()
    defer str.BufFree(list)
    mut k := 0
    until k < sorted.names.Len():
        nm := sorted.names.Get(k)
        str.BufAppend(block, nm)
        str.BufAppend(block, ":")
        str.BufAppend(block, _canon_value(sorted.values.Get(k)))
        str.BufAppend(block, "\n")
        if k > 0: str.BufAppend(list, ";") end
        str.BufAppend(list, nm)
        k++
    end
    signed = str.BufStr(list)
    ret str.BufStr(block)
end

func _canon_query(q: Headers): str:
    mut enc := Headers {}
    mut i := 0
    until i < q.names.Len():
        enc.names.Push(UriEncode(q.names.Get(i), false))
        enc.values.Push(UriEncode(q.values.Get(i), false))
        i++
    end
    _hdr_sort(enc)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut k := 0
    until k < enc.names.Len():
        if k > 0: str.BufAppend(sb, "&") end
        str.BufAppend(sb, enc.names.Get(k))
        str.BufAppend(sb, "=")
        str.BufAppend(sb, enc.values.Get(k))
        k++
    end
    ret str.BufStr(sb)
end

func _bucket_of(cfg: Config, r: Request): str:
    if r.service_level: ret "" end
    if r.bucket.Len() > 0: ret r.bucket end
    ret cfg.bucket
end

func _wire_host(cfg: Config, ep: http.Endpoint, bucket: str): str:
    mut host := ep.host
    if bucket.Len() > 0 and not cfg.path_style: host = bucket + "." + ep.host end
    if (ep.secure and ep.port != 443) or (not ep.secure and ep.port != 80):
        host = host + ":" + ep.port
    end
    ret host
end

func _wire_path(cfg: Config, bucket: str, key: str): str:
    if bucket.Len() == 0: ret "/" end
    if not cfg.path_style:
        if key.Len() == 0: ret "/" end
        ret EncodeKey(key)
    end
    if key.Len() == 0: ret "/" + bucket end
    ret "/" + bucket + EncodeKey(key)
end

func _tag_text(body: str, tag: str): str:
    open := "<" + tag + ">"
    at := body.Find(open)
    if at < 0: ret "" end
    start := at + open.Len()
    stop := str.IndexFrom(body, "</" + tag + ">", start)
    if stop < 0: ret "" end
    ret body.Substr(start, stop - start)
end

func _describe(status: int, body: str): str:
    msg := _tag_text(body, "Message")
    if msg.Len() > 0: ret msg end
    code := _tag_text(body, "Code")
    if code.Len() > 0: ret code end
    if status == 0: ret "the object store could not be reached" end
    ret "the object store answered " + status
end

func _retryable(status: int): bool:
    if status == 0: ret true end
    if status == 429: ret true end
    ret status == 500 or status == 502 or status == 503 or status == 504
end

func _backoff_ms(cfg: Config, attempt: int): int:
    mut base := cfg.retry_base_ms
    if base <= 0: base = 100 end
    mut wait := base
    repeat attempt:
        wait *= 2
        if wait > 10000: ret 10000 end
    end
    ret wait
end

func _head_block(
    method: str, path: str, query: str, authorization: str, signed_set: Headers, body_len: int
): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, method)
    str.BufAppend(sb, " ")
    str.BufAppend(sb, path)
    if query.Len() > 0:
        str.BufAppend(sb, "?")
        str.BufAppend(sb, query)
    end
    str.BufAppend(sb, " HTTP/1.1\r\n")
    mut i := 0
    until i < signed_set.names.Len():
        str.BufAppend(sb, signed_set.names.Get(i))
        str.BufAppend(sb, ": ")
        str.BufAppend(sb, signed_set.values.Get(i))
        str.BufAppend(sb, "\r\n")
        i++
    end
    if authorization.Len() > 0:
        str.BufAppend(sb, "Authorization: ")
        str.BufAppend(sb, authorization)
        str.BufAppend(sb, "\r\n")
    end
    str.BufAppend(sb, "Content-Length: ")
    str.BufAppendInt(sb, body_len as i64)
    str.BufAppend(sb, "\r\nConnection: close\r\n\r\n")
    ret str.BufStr(sb)
end

func _signing_set(
    cfg: Config, extra: Headers, host: str, amz_date: str, payload_hash: str
): Headers:
    mut out := Headers {}
    _hdr_set(out, "Host", host)
    mut i := 0
    until i < extra.names.Len():
        _hdr_set(out, extra.names.Get(i), extra.values.Get(i))
        i++
    end
    if cfg.request_payer: _hdr_set(out, "x-amz-request-payer", "requester") end
    if cfg.anonymous: ret out end
    _hdr_set(out, "x-amz-content-sha256", payload_hash)
    _hdr_set(out, "x-amz-date", amz_date)
    if cfg.session_token.Len() > 0:
        _hdr_set(out, "x-amz-security-token", cfg.session_token)
    end
    ret out
end

func _payload_hash(r: Request): str:
    if r.body_hash.Len() > 0: ret r.body_hash end
    if r.body_len > 0 and r.body != null: ret Sha256Bytes(r.body, r.body_len) end
    ret EMPTY_SHA256
end

func _dispatch(
    cfg: Config, ep: http.Endpoint, method: str, host: str, path: str, query: str, extra: Headers, body: void*, body_len: int, payload_hash: str, at: i64
): http.RawResponse:
    amz_date := AmzDate(at)
    signed_set := _signing_set(cfg, extra, host, amz_date, payload_hash)
    if cfg.anonymous:
        ret http.SendRawTimeout(
            ep, _head_block(method, path, query, "", signed_set, body_len), body, body_len, cfg.timeout_ms
        )
    end
    mut signed_names := ""
    canonical := _canon_headers(signed_set, signed_names)
    s := SignRequest(
        cfg, method, path, query, canonical, signed_names, payload_hash, at
    )
    if not s.ok: ret http.RawResponse { error = "the request could not be signed" } end
    head := _head_block(
        method, path, query, s.authorization, signed_set, body_len
    )
    ret http.SendRawTimeout(ep, head, body, body_len, cfg.timeout_ms)
end

func _send_once(cfg: Config, r: Request, at: i64): http.RawResponse:
    ep := http.ParseEndpoint(cfg.endpoint)
    if not ep.ok:
        ret http.RawResponse { error = "the endpoint could not be parsed: " + cfg.endpoint }
    end
    bucket := _bucket_of(cfg, r)
    ret _dispatch(
        cfg, ep, r.method, _wire_host(cfg, ep, bucket), _wire_path(cfg, bucket, r.key), _canon_query(r.query), r.headers, r.body, r.body_len, _payload_hash(r), at
    )
end

func _do_raw(cfg: Config, r: Request): http.RawResponse:
    mut attempts := cfg.retry
    if attempts < 1: attempts = 1 end
    if attempts > 10: attempts = 10 end
    mut n := 0
    until n < attempts:
        mut raw := _send_once(cfg, r, time.Now())
        if not _retryable(raw.status) or n == attempts - 1: ret raw end
        http.FreeRaw(raw)
        time.Sleep(_backoff_ms(cfg, n))
        n++
    end
    ret http.RawResponse { error = "the request was never attempted" }
end

func _fill_common(
    raw: http.RawResponse, status: int, ok &: bool, etag &: str, code &: str, error &: str, body: str
):
    ok = raw.ok
    etag = Unquote(http.HeaderValue(raw.head, "ETag"))
    if raw.error.Len() > 0:
        error = raw.error
        code = "Transport"
        ret
    end
    if not raw.ok:
        code = _tag_text(body, "Code")
        error = _describe(status, body)
    end
end

@en "NewHeaders"
@fa "سرآیندهای جدید"
pub func NewHeaders(): Headers:
    ret Headers {}
end

@en "HeaderSet"
@fa "تنظیم سرآیند"
pub func HeaderSet(h &: Headers, name: str, value: str):
    _hdr_set(h, name, value)
end

@en "HeaderAdd"
@fa "افزودن سرآیند"
pub func HeaderAdd(h &: Headers, name: str, value: str):
    if h.names.Len() >= _S3_HDR_MAX: ret end
    h.names.Push(name)
    h.values.Push(value)
end

@en "HeaderGet"
@fa "دریافت سرآیند"
pub func HeaderGet(h: Headers, name: str): str:
    at := _hdr_find(h, name)
    if at < 0: ret "" end
    ret h.values.Get(at)
end

@en "HeaderHas"
@fa "سرآیند دارد"
pub func HeaderHas(h: Headers, name: str): bool:
    ret _hdr_find(h, name) >= 0
end

@en "HeaderCount"
@fa "شمار سرآیندها"
pub func HeaderCount(h: Headers): int:
    ret h.names.Len()
end

@en "HeaderNameAt"
@fa "نام سرآیند شماره"
pub func HeaderNameAt(h: Headers, i: int): str:
    if i < 0 or i >= h.names.Len(): ret "" end
    ret h.names.Get(i)
end

@en "HeaderValueAt"
@fa "مقدار سرآیند شماره"
pub func HeaderValueAt(h: Headers, i: int): str:
    if i < 0 or i >= h.values.Len(): ret "" end
    ret h.values.Get(i)
end

@en "HeaderFree"
@fa "آزادسازی سرآیندها"
pub func HeaderFree(h &: Headers):
    h.names.Free()
    h.values.Free()
end

@en "NewRequest"
@fa "درخواست جدید"
pub func NewRequest(method: str, key: str): Request:
    ret Request { method = method, key = key }
end

@en "NewBucketRequest"
@fa "درخواست سطل جدید"
pub func NewBucketRequest(method: str, bucket: str, key: str): Request:
    ret Request { method = method, bucket = bucket, key = key }
end

@en "NewServiceRequest"
@fa "درخواست سرویس جدید"
pub func NewServiceRequest(method: str): Request:
    ret Request { method = method, service_level = true }
end

@en "SetQuery"
@fa "تنظیم پرسمان"
pub func SetQuery(r &: Request, name: str, value: str):
    _hdr_set(r.query, name, value)
end

@en "SetQueryInt"
@fa "تنظیم پرسمان عددی"
pub func SetQueryInt(r &: Request, name: str, value: int):
    _hdr_set(r.query, name, "" + value)
end

@en "SetFlag"
@fa "تنظیم پرچم"
pub func SetFlag(r &: Request, name: str):
    _hdr_set(r.query, name, "")
end

@en "SetHeader"
@fa "تنظیم سرآیند درخواست"
pub func SetHeader(r &: Request, name: str, value: str):
    if value.Len() == 0: ret end
    _hdr_set(r.headers, name, value)
end

@en "SetBody"
@fa "تنظیم بدنه"
pub func SetBody(r &: Request, p: void*, n: int):
    r.body = p
    r.body_len = n
end

@en "SetText"
@fa "تنظیم بدنه متنی"
pub func SetText(r &: Request, s: str):
    if s.Len() == 0:
        r.body = null
        r.body_len = 0
        ret
    end
    r.body = s as void*
    r.body_len = s.Len()
end

@en "SetUnsignedPayload"
@fa "تنظیم بار امضانشده"
pub func SetUnsignedPayload(r &: Request):
    r.body_hash = UNSIGNED_PAYLOAD
end

@en "Do"
@fa "اجرای درخواست"
pub func Do(cfg: Config, r: Request): Result:
    if not Configured(cfg): ret Failure("the object store is not configured") end
    mut raw := _do_raw(cfg, r)
    defer http.FreeRaw(raw)
    body := http.RawText(raw)
    mut out := Result { status = raw.status, body = body, head = raw.head }
    _fill_common(raw, raw.status, out.ok, out.etag, out.code, out.error, body)
    out.request_id = http.HeaderValue(raw.head, "x-amz-request-id")
    out.version_id = http.HeaderValue(raw.head, "x-amz-version-id")
    length := http.HeaderValue(raw.head, "Content-Length")
    if length.Len() > 0: out.length = conv.ParseIntOr(length, 0) end
    ret out
end

@en "DoBytes"
@fa "اجرای درخواست بایتی"
pub func DoBytes(cfg: Config, r: Request): Bytes:
    if not Configured(cfg):
        ret Bytes { error = "the object store is not configured", code = "Config" }
    end
    mut raw := _do_raw(cfg, r)
    mut out := Bytes { status = raw.status, head = raw.head }
    if raw.error.Len() > 0:
        http.FreeRaw(raw)
        out.error = raw.error
        out.code = "Transport"
        ret out
    end
    if not raw.ok:
        body := http.RawText(raw)
        http.FreeRaw(raw)
        out.code = _tag_text(body, "Code")
        out.error = _describe(raw.status, body)
        ret out
    end
    out.ok = true
    out.etag = Unquote(http.HeaderValue(raw.head, "ETag"))
    out.data = raw.data
    out.len = raw.len
    ret out
end

@en "FreeBytes"
@fa "آزادسازی بایت‌ها"
pub func FreeBytes(b &: Bytes):
    if b.data != null:
        mem.Free(b.data)
        b.data = null
    end
    b.len = 0
end

@en "ResultHeader"
@fa "سرآیند نتیجه"
pub func ResultHeader(r: Result, name: str): str:
    ret http.HeaderValue(r.head, name)
end

@en "BytesHeader"
@fa "سرآیند بایت‌ها"
pub func BytesHeader(b: Bytes, name: str): str:
    ret http.HeaderValue(b.head, name)
end

@en "ResultErrorCode"
@fa "کد خطای نتیجه"
pub func ResultErrorCode(body: str): str:
    ret _tag_text(body, "Code")
end

@en "ResultErrorMessage"
@fa "پیام خطای نتیجه"
pub func ResultErrorMessage(body: str, status: int): str:
    ret _describe(status, body)
end

@en "ResultTag"
@fa "برچسب نتیجه"
pub func ResultTag(body: str, tag: str): str:
    ret _tag_text(body, tag)
end

@en "Unquote"
@fa "حذف گیومه"
pub func Unquote(s: str): str:
    if s.Len() >= 2 and s.StartsWith("\"") and s.EndsWith("\""):
        ret s.Substr(1, s.Len() - 2)
    end
    ret s
end

@en "CanonicalRequest"
@fa "درخواست متعارف"
pub func CanonicalRequest(cfg: Config, r: Request, at: i64): str:
    ep := http.ParseEndpoint(cfg.endpoint)
    bucket := _bucket_of(cfg, r)
    host := _wire_host(cfg, ep, bucket)
    payload_hash := _payload_hash(r)
    signed_set := _signing_set(cfg, r.headers, host, AmzDate(at), payload_hash)
    mut signed_names := ""
    canonical := _canon_headers(signed_set, signed_names)
    ret r.method + "\n" + _wire_path(cfg, bucket, r.key) + "\n" + _canon_query(r.query) + "\n" + canonical + "\n" + signed_names + "\n" + payload_hash
end

@en "PreparedHead"
@fa "سرآیندهای آماده"
pub func PreparedHead(cfg: Config, r: Request, at: i64): str:
    ep := http.ParseEndpoint(cfg.endpoint)
    bucket := _bucket_of(cfg, r)
    host := _wire_host(cfg, ep, bucket)
    path := _wire_path(cfg, bucket, r.key)
    query := _canon_query(r.query)
    payload_hash := _payload_hash(r)
    amz_date := AmzDate(at)
    signed_set := _signing_set(cfg, r.headers, host, amz_date, payload_hash)
    mut signed_names := ""
    canonical := _canon_headers(signed_set, signed_names)
    s := SignRequest(
        cfg, r.method, path, query, canonical, signed_names, payload_hash, at
    )
    if cfg.anonymous:
        ret _head_block(r.method, path, query, "", signed_set, r.body_len)
    end
    ret _head_block(
        r.method, path, query, s.authorization, signed_set, r.body_len
    )
end
