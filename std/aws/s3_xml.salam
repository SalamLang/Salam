package aws

import str
import time
import conv
import encoding.xml

func _xml_text(node: xml.XMLNode, tag: str): str:
    ret xml.Child(node, tag).text.trim()
end

func _xml_int(node: xml.XMLNode, tag: str): i64:
    v := _xml_text(node, tag)
    if v.len() == 0: ret 0 end
    ret conv.ParseInt(v)
end

func _xml_bool(node: xml.XMLNode, tag: str): bool:
    ret _xml_text(node, tag).lower() == "true"
end

func _hexdigit(c: int): int:
    if c >= 48 && c <= 57: ret c - 48 end
    if c >= 97 && c <= 102: ret c - 87 end
    if c >= 65 && c <= 70: ret c - 55 end
    ret -1
end

func _pct_decode(s: str): str:
    if s.find("%") < 0: ret s end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    n := s.len()
    mut i := 0
    until i < n:
        c := s[i] as int
        if c == 37 && i + 2 < n:
            hi := _hexdigit(s[i + 1] as int)
            lo := _hexdigit(s[i + 2] as int)
            if hi >= 0 && lo >= 0:
                str.BufAppendChar(sb, hi * 16 + lo)
                i += 3
                continue
            end
        end
        str.BufAppendChar(sb, c)
        i += 1
    end
    ret str.BufStr(sb)
end

func _iso_epoch(s: str): i64:
    if s.len() == 0: ret 0 end
    when := time.ParseISO(s)
    if !when.ok: ret 0 end
    ret when.epoch
end

func _xml_escape(s: str): str:
    mut out := str.Replace(s, "&", "&amp;")
    out = str.Replace(out, "<", "&lt;")
    out = str.Replace(out, ">", "&gt;")
    out = str.Replace(out, "\"", "&quot;")
    ret str.Replace(out, "'", "&apos;")
end

func _decoded(s: str, encoded: bool): str:
    if !encoded: ret s end
    ret _pct_decode(s)
end
