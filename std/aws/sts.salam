package aws

import str
import time
import encoding.xml

pub const STS_VERSION := "2011-06-15"

pub const STS_MIN_DURATION := 900
pub const STS_MAX_DURATION := 43200

pub const STS_DEFAULT_SKEW := 300

pub struct Credentials:
    pub ok: bool = false
    pub access_key: str = ""
    pub secret_key: str = ""
    pub session_token: str = ""
    pub expires: str = ""
    pub expires_epoch: i64 = 0
    pub source: str = ""
    pub error: str = ""
    pub code: str = ""
end

pub struct Identity:
    pub ok: bool = false
    pub account: str = ""
    pub arn: str = ""
    pub user_id: str = ""
    pub error: str = ""
    pub code: str = ""
end

func _duration_of(seconds: int): int:
    mut d := seconds
    if d <= 0: ret 0 end
    if d < STS_MIN_DURATION: d = STS_MIN_DURATION end
    if d > STS_MAX_DURATION: d = STS_MAX_DURATION end
    ret d
end

func _sts_failure(res: Result, source: str): Credentials:
    ret Credentials {
        ok = false, error = res.error, code = res.code, source = source
    }
end

func _credentials_of(res: Result, source: str): Credentials:
    if !res.ok: ret _sts_failure(res, source) end
    mut ok := false
    root := xml.DecodeStrict(res.body, ok)
    if !ok:
        ret Credentials {
            error = "the security token service answer could not be parsed", code = "MalformedXML", source = source
        }
    end
    mut holder := xml.Child(root, "Credentials")
    if !xml.Found(holder):
        mut i := 0
        until i < root.children.len():
            found := xml.Child(root.children.get(i), "Credentials")
            if xml.Found(found):
                holder = found
                i = root.children.len()
            else:
                i += 1
            end
        end
    end
    if !xml.Found(holder):
        ret Credentials {
            error = "the answer carried no credentials", code = "MalformedXML", source = source
        }
    end
    mut out := Credentials {
        ok = true, access_key = _xml_text(holder, "AccessKeyId"), secret_key = _xml_text(holder, "SecretAccessKey"), session_token = _xml_text(holder, "SessionToken"), expires = _xml_text(holder, "Expiration"), source = source
    }
    out.expires_epoch = _iso_epoch(out.expires)
    if out.access_key.len() == 0 || out.secret_key.len() == 0:
        out.ok = false
        out.error = "the answer carried an incomplete credential"
        out.code = "MalformedXML"
    end
    ret out
end

func _sts_call(action: str): Call:
    mut c := NewQueryCall("sts", action, STS_VERSION)
    override := env.Get("AWS_ENDPOINT_URL_STS")
    if override.len() > 0: CallEndpoint(c, override) end
    ret c
end

pub func StsEndpoint(region: str): str:
    if region.len() == 0: ret "https://sts.amazonaws.com" end
    ret "https://sts." + region + ".amazonaws.com"
end

pub func AssumeRole(
    cfg: Config, role_arn: str, session_name: str, duration: int
): Credentials:
    ret AssumeRoleWith(cfg, role_arn, session_name, duration, "", "")
end

pub func AssumeRoleWith(
    cfg: Config, role_arn: str, session_name: str, duration: int, external_id: str, policy_arn: str
): Credentials:
    if role_arn.len() == 0:
        ret Credentials { error = "no role was named", code = "Config" }
    end
    mut name := session_name
    if name.len() == 0: name = "salam-session" end
    mut c := _sts_call("AssumeRole")
    CallParam(c, "RoleArn", role_arn)
    CallParam(c, "RoleSessionName", name)
    secs := _duration_of(duration)
    if secs > 0: CallParamInt(c, "DurationSeconds", secs) end
    CallParam(c, "ExternalId", external_id)
    if policy_arn.len() > 0:
        CallParam(c, "PolicyArns.member.1.arn", policy_arn)
    end
    res := Invoke(cfg, c)
    CallFree(c)
    ret _credentials_of(res, "AssumeRole " + role_arn)
end

pub func AssumeRoleWithWebIdentity(
    cfg: Config, role_arn: str, session_name: str, web_identity_token: str, duration: int
): Credentials:
    if role_arn.len() == 0 || web_identity_token.len() == 0:
        ret Credentials {
            error = "a role and a web identity token are both required", code = "Config"
        }
    end
    mut name := session_name
    if name.len() == 0: name = "salam-session" end
    mut anon := cfg
    anon.anonymous = true
    mut c := _sts_call("AssumeRoleWithWebIdentity")
    CallParam(c, "RoleArn", role_arn)
    CallParam(c, "RoleSessionName", name)
    CallParam(c, "WebIdentityToken", web_identity_token)
    secs := _duration_of(duration)
    if secs > 0: CallParamInt(c, "DurationSeconds", secs) end
    res := Invoke(anon, c)
    CallFree(c)
    ret _credentials_of(res, "AssumeRoleWithWebIdentity " + role_arn)
end

pub func GetSessionToken(
    cfg: Config, duration: int, mfa_serial: str, mfa_code: str
): Credentials:
    mut c := _sts_call("GetSessionToken")
    secs := _duration_of(duration)
    if secs > 0: CallParamInt(c, "DurationSeconds", secs) end
    CallParam(c, "SerialNumber", mfa_serial)
    CallParam(c, "TokenCode", mfa_code)
    res := Invoke(cfg, c)
    CallFree(c)
    ret _credentials_of(res, "GetSessionToken")
end

pub func GetFederationToken(
    cfg: Config, name: str, policy_json: str, duration: int
): Credentials:
    if name.len() == 0 || policy_json.len() == 0:
        ret Credentials {
            error = "a name and a policy are both required", code = "Config"
        }
    end
    mut c := _sts_call("GetFederationToken")
    CallParam(c, "Name", name)
    CallParam(c, "Policy", policy_json)
    secs := _duration_of(duration)
    if secs > 0: CallParamInt(c, "DurationSeconds", secs) end
    res := Invoke(cfg, c)
    CallFree(c)
    ret _credentials_of(res, "GetFederationToken " + name)
end

pub func GetCallerIdentity(cfg: Config): Identity:
    mut c := _sts_call("GetCallerIdentity")
    res := Invoke(cfg, c)
    CallFree(c)
    if !res.ok:
        ret Identity { error = res.error, code = res.code }
    end
    ret Identity {
        ok = true, account = ResultTag(res.body, "Account"), arn = ResultTag(res.body, "Arn"), user_id = ResultTag(res.body, "UserId")
    }
end

pub func Apply(cfg: Config, creds: Credentials): Config:
    mut out := cfg
    if !creds.ok: ret out end
    out.access_key = creds.access_key
    out.secret_key = creds.secret_key
    out.session_token = creds.session_token
    out.anonymous = false
    ret out
end

pub func StaticCredentials(access_key: str, secret_key: str): Credentials:
    ret Credentials {
        ok = access_key.len() > 0 && secret_key.len() > 0, access_key = access_key, secret_key = secret_key, source = "static"
    }
end

pub func Expired(creds: Credentials, now: i64, skew: int): bool:
    if !creds.ok: ret true end
    if creds.expires_epoch == 0 as i64: ret false end
    mut margin := skew
    if margin < 0: margin = STS_DEFAULT_SKEW end
    ret creds.expires_epoch - (margin as i64) <= now
end

pub func ExpiredNow(creds: Credentials): bool:
    ret Expired(creds, time.Now(), STS_DEFAULT_SKEW)
end

pub func SecondsRemaining(creds: Credentials, now: i64): i64:
    if creds.expires_epoch == 0 as i64: ret 0 - (1 as i64) end
    ret creds.expires_epoch - now
end

pub func DescribeCredentials(creds: Credentials): str:
    if !creds.ok: ret "credentials unavailable: " + creds.error end
    mut key := creds.access_key
    if key.len() > 4: key = key.substr(0, 4) + "..." end
    mut when := "no expiry"
    if creds.expires_epoch != 0 as i64: when = "expires " + creds.expires end
    mut kind := "long-lived"
    if creds.session_token.len() > 0: kind = "temporary" end
    ret kind + " " + key + ", " + when + ", from " + creds.source
end

pub func ParseCredentials(body: str, status: int, source: str): Credentials:
    ret _credentials_of(
        Result {
            ok = status >= 200 && status < 300, status = status, body = body
        }, source
    )
end
