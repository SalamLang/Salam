@en "baremetal"
@fa "کرنل"
package baremetal

extern:
    func salam_rt_outb(port: u16, value: u8)
    func salam_rt_inb(port: u16): u8
    func salam_rt_halt()
    func salam_rt_exit(code: int)
    func salam_rt_clear()
    func salam_rt_write_at(row: int, col: int, text: str, color: u8)
    func salam_rt_serial_write(text: str)
    func salam_rt_exit_qemu(code: int)
    func salam_rt_heap_used(): u64
    func salam_rt_heap_size(): u64
end

@en "Halt"
@fa "توقف"
pub func Halt():
    salam_rt_halt()
end

@en "Exit"
@fa "خروج"
pub func Exit(code: int):
    salam_rt_exit(code)
end

@en "Out8"
@fa "نوشتن پورت"
pub func Out8(port: u16, value: u8):
    salam_rt_outb(port, value)
end

@en "In8"
@fa "خواندن پورت"
pub func In8(port: u16): u8:
    ret salam_rt_inb(port)
end

@en "Clear"
@fa "پاک کردن"
pub func Clear():
    salam_rt_clear()
end

@en "WriteAt"
@fa "نوشتن جایگاه"
pub func WriteAt(row: int, col: int, text: str, color: u8):
    salam_rt_write_at(row, col, text, color)
end

@en "SerialWrite"
@fa "نوشتن سریال"
pub func SerialWrite(text: str):
    salam_rt_serial_write(text)
end

@en "Panic"
@fa "خطای مرگبار"
pub func Panic(message: str):
    println "kernel panic: ", message
    Halt()
end

@en "ExitQemu"
@fa "خروج شبیه ساز"
pub func ExitQemu(code: int):
    salam_rt_exit_qemu(code)
end

@en "HeapUsed"
@fa "حافظه مصرفی"
pub func HeapUsed(): u64:
    ret salam_rt_heap_used()
end

@en "HeapSize"
@fa "اندازه حافظه"
pub func HeapSize(): u64:
    ret salam_rt_heap_size()
end
