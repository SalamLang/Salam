@en "bidi"
@fa "دوسویه"
package bidi

import str
import unicode

@en "DirAuto"
@fa "جهت خودکار"
pub const DirAuto := 0
@en "DirLTR"
@fa "جهت چپ به راست"
pub const DirLTR := 1
@en "DirRTL"
@fa "جهت راست به چپ"
pub const DirRTL := 2

const _MAX_DEPTH := 125

const _OVR_NEUTRAL := 0
const _OVR_LTR := 1
const _OVR_RTL := 2

inline pure func _is_isolate_init(t: int): bool:
    ret t == unicode.BcLRI or t == unicode.BcRLI or t == unicode.BcFSI
end

inline pure func _is_removed(t: int): bool:
    if t == unicode.BcRLE or t == unicode.BcLRE: ret true end
    if t == unicode.BcRLO or t == unicode.BcLRO: ret true end
    ret t == unicode.BcPDF or t == unicode.BcBN
end

inline pure func _is_ni(t: int): bool:
    if t == unicode.BcB or t == unicode.BcS: ret true end
    if t == unicode.BcWS or t == unicode.BcON: ret true end
    ret _is_isolate_init(t) or t == unicode.BcPDI
end

inline pure func _level_dir(level: int): int:
    if level % 2 == 1: ret unicode.BcR end
    ret unicode.BcL
end

inline pure func _n_dir(t: int): int:
    if t == unicode.BcR or t == unicode.BcEN or t == unicode.BcAN: ret unicode.BcR end
    if t == unicode.BcL: ret unicode.BcL end
    ret 0 - 1
end

func _new_ints(n: int, fill: int): Vector<int>:
    out := Vector {} as Vector<int>
    repeat n in _: out.Push(fill) end
    ret out
end

func _auto_level(types: Vector<int>, from: int, stop: int): int:
    mut depth := 0
    mut i := from
    until i < stop:
        t := types.Get(i)
        if _is_isolate_init(t):
            depth++
        else t == unicode.BcPDI:
            if depth > 0: depth-- end
        else depth == 0:
            if t == unicode.BcL: ret 0 end
            if t == unicode.BcR or t == unicode.BcAL: ret 1 end
        end
        i++
    end
    ret 0
end

func _match_isolates(types: Vector<int>, pdi_of &: Vector<int>, init_of &: Vector<int>):
    n := types.Len()
    stack := Vector {} as Vector<int>
    defer stack.Free()
    repeat n in i:
        t := types.Get(i)
        if _is_isolate_init(t):
            stack.Push(i)
        else t == unicode.BcPDI:
            if stack.Len() > 0:
                j := stack.Pop()
                pdi_of.Set(j, i)
                init_of.Set(i, j)
            end
        end
    end
end

func _explicit_levels(types &: Vector<int>, pdi_of: Vector<int>, para: int, levels &: Vector<int>):
    n := types.Len()
    st_level := Vector {} as Vector<int>
    defer st_level.Free()
    st_over := Vector {} as Vector<int>
    defer st_over.Free()
    st_iso := Vector {} as Vector<int>
    defer st_iso.Free()

    st_level.Push(para)
    st_over.Push(_OVR_NEUTRAL)
    st_iso.Push(0)

    mut overflow_iso := 0
    mut overflow_emb := 0
    mut valid_iso := 0

    mut i := 0
    until i < n:
        t := types.Get(i)
        top := st_level.Len() - 1
        cur := st_level.Get(top)

        if t == unicode.BcRLE or t == unicode.BcLRE or t == unicode.BcRLO or t == unicode.BcLRO:
            levels.Set(i, cur)
            mut next := cur + 1
            if t == unicode.BcRLE or t == unicode.BcRLO:
                if next % 2 == 0: next++ end
            else:
                if next % 2 == 1: next++ end
            end
            if next <= _MAX_DEPTH and overflow_iso == 0 and overflow_emb == 0:
                st_level.Push(next)
                if t == unicode.BcRLO: st_over.Push(_OVR_RTL)
                else t == unicode.BcLRO: st_over.Push(_OVR_LTR)
                else:
                    st_over.Push(_OVR_NEUTRAL)
                end
                st_iso.Push(0)
            else:
                if overflow_iso == 0: overflow_emb++ end
            end
        else _is_isolate_init(t):
            levels.Set(i, cur)
            if st_over.Get(top) == _OVR_LTR: types.Set(i, unicode.BcL)
            else st_over.Get(top) == _OVR_RTL: types.Set(i, unicode.BcR) end

            mut rtl := t == unicode.BcRLI
            if t == unicode.BcFSI:
                mut stop := pdi_of.Get(i)
                if stop < 0: stop = n end
                rtl = _auto_level(types, i + 1, stop) == 1
            end
            mut next := cur + 1
            if rtl:
                if next % 2 == 0: next++ end
            else:
                if next % 2 == 1: next++ end
            end
            if next <= _MAX_DEPTH and overflow_iso == 0 and overflow_emb == 0:
                valid_iso++
                st_level.Push(next)
                st_over.Push(_OVR_NEUTRAL)
                st_iso.Push(1)
            else:
                overflow_iso++
            end
        else t == unicode.BcPDI:
            if overflow_iso > 0:
                overflow_iso--
            else valid_iso > 0:
                overflow_emb = 0
                until st_iso.Get(st_level.Len() - 1) == 0:
                    st_level.Pop()
                    st_over.Pop()
                    st_iso.Pop()
                end
                st_level.Pop()
                st_over.Pop()
                st_iso.Pop()
                valid_iso--
            end
            ntop := st_level.Len() - 1
            levels.Set(i, st_level.Get(ntop))
            if st_over.Get(ntop) == _OVR_LTR: types.Set(i, unicode.BcL)
            else st_over.Get(ntop) == _OVR_RTL: types.Set(i, unicode.BcR) end
        else t == unicode.BcPDF:
            levels.Set(i, cur)
            if overflow_iso <= 0:
                if overflow_emb > 0:
                    overflow_emb--
                else st_iso.Get(top) == 0 and st_level.Len() >= 2:
                    st_level.Pop()
                    st_over.Pop()
                    st_iso.Pop()
                end
            end
            levels.Set(i, st_level.Get(st_level.Len() - 1))
        else t == unicode.BcB:
            levels.Set(i, para)
        else:
            levels.Set(i, cur)
            if st_over.Get(top) == _OVR_LTR: types.Set(i, unicode.BcL)
            else st_over.Get(top) == _OVR_RTL: types.Set(i, unicode.BcR) end
        end
        i++
    end
end

func _resolve_weak(types &: Vector<int>, seq: Vector<int>, sos: int):
    m := seq.Len()

    mut prev := sos
    repeat m in k:
        p := seq.Get(k)
        t := types.Get(p)
        if t == unicode.BcNSM:
            if _is_isolate_init(prev) or prev == unicode.BcPDI:
                types.Set(p, unicode.BcON)
            else:
                types.Set(p, prev)
            end
        end
        prev = types.Get(p)
    end

    mut strong := sos
    repeat m in k:
        p := seq.Get(k)
        t := types.Get(p)
        if t == unicode.BcL or t == unicode.BcR or t == unicode.BcAL: strong = t end
        if t == unicode.BcEN and strong == unicode.BcAL:
            types.Set(p, unicode.BcAN)
        end
    end

    repeat m in k:
        p := seq.Get(k)
        if types.Get(p) == unicode.BcAL: types.Set(p, unicode.BcR) end
    end

    repeat m in k:
        if k == 0: continue end
        if k + 1 >= m: continue end
        p := seq.Get(k)
        t := types.Get(p)
        before := types.Get(seq.Get(k - 1))
        after := types.Get(seq.Get(k + 1))
        if t == unicode.BcES and before == unicode.BcEN and after == unicode.BcEN:
            types.Set(p, unicode.BcEN)
        else t == unicode.BcCS and before == unicode.BcEN and after == unicode.BcEN:
            types.Set(p, unicode.BcEN)
        else t == unicode.BcCS and before == unicode.BcAN and after == unicode.BcAN:
            types.Set(p, unicode.BcAN)
        end
    end

    mut k := 0
    until k < m:
        if types.Get(seq.Get(k)) != unicode.BcET:
            k++
            continue
        end
        mut e := k
        until e < m and types.Get(seq.Get(e)) == unicode.BcET:
            e++
        end
        mut adjacent := false
        if k > 0 and types.Get(seq.Get(k - 1)) == unicode.BcEN: adjacent = true end
        if e < m and types.Get(seq.Get(e)) == unicode.BcEN: adjacent = true end
        if adjacent:
            mut j := k
            until j < e:
                types.Set(seq.Get(j), unicode.BcEN)
                j++
            end
        end
        k = e
    end

    repeat m in q:
        p := seq.Get(q)
        t := types.Get(p)
        if t == unicode.BcET or t == unicode.BcES or t == unicode.BcCS:
            types.Set(p, unicode.BcON)
        end
    end

    strong = sos
    repeat m in q:
        p := seq.Get(q)
        t := types.Get(p)
        if t == unicode.BcL or t == unicode.BcR: strong = t end
        if t == unicode.BcEN and strong == unicode.BcL:
            types.Set(p, unicode.BcL)
        end
    end
end

inline pure func _canon_bracket(cp: int): int:
    if cp == 0x3008: ret 0x2329 end
    if cp == 0x3009: ret 0x232A end
    ret cp
end

func _resolve_brackets(cps: Vector<int>, types &: Vector<int>, seq: Vector<int>, level: int, sos: int):
    m := seq.Len()
    e := _level_dir(level)
    mut o := unicode.BcL
    if e == unicode.BcL: o = unicode.BcR end

    stack_pos := Vector {} as Vector<int>
    defer stack_pos.Free()
    stack_cp := Vector {} as Vector<int>
    defer stack_cp.Free()
    open_at := Vector {} as Vector<int>
    defer open_at.Free()
    close_at := Vector {} as Vector<int>
    defer close_at.Free()

    mut k := 0
    until k < m:
        p := seq.Get(k)
        if types.Get(p) == unicode.BcON:
            cp := cps.Get(p)
            bt := unicode.PairedBracketType(cp)
            if bt == unicode.PbtOpen:
                if stack_cp.Len() >= 63: break end
                stack_pos.Push(k)
                stack_cp.Push(_canon_bracket(unicode.PairedBracket(cp)))
            else bt == unicode.PbtClose:
                mut d := stack_cp.Len() - 1
                until d >= 0:
                    if stack_cp.Get(d) == _canon_bracket(cp):
                        open_at.Push(stack_pos.Get(d))
                        close_at.Push(k)
                        until stack_cp.Len() > d:
                            stack_cp.Pop()
                            stack_pos.Pop()
                        end
                        break
                    end
                    d--
                end
            end
        end
        k++
    end

    mut a := 0
    until a < open_at.Len():
        mut b := a + 1
        until b < open_at.Len():
            if open_at.Get(b) < open_at.Get(a):
                t1 := open_at.Get(a)
                open_at.Set(a, open_at.Get(b))
                open_at.Set(b, t1)
                t2 := close_at.Get(a)
                close_at.Set(a, close_at.Get(b))
                close_at.Set(b, t2)
            end
            b++
        end
        a++
    end

    mut pair := 0
    until pair < open_at.Len():
        ko := open_at.Get(pair)
        kc := close_at.Get(pair)

        mut found_e := false
        mut found_o := false
        mut q := ko + 1
        until q < kc:
            d := _n_dir(types.Get(seq.Get(q)))
            if d == e: found_e = true end
            if d == o: found_o = true end
            q++
        end

        mut chosen := 0 - 1
        if found_e:
            chosen = e
        else found_o:
            mut ctx := sos
            mut r := ko - 1
            until r >= 0:
                d := _n_dir(types.Get(seq.Get(r)))
                if d >= 0:
                    ctx = d
                    break
                end
                r--
            end
            if ctx == o: chosen = o
            else:
                chosen = e
            end
        end

        if chosen >= 0:
            types.Set(seq.Get(ko), chosen)
            types.Set(seq.Get(kc), chosen)
            mut z := ko + 1
            until z < m and _orig_nsm(cps, seq, z):
                types.Set(seq.Get(z), chosen)
                z++
            end
            z = kc + 1
            until z < m and _orig_nsm(cps, seq, z):
                types.Set(seq.Get(z), chosen)
                z++
            end
        end
        pair++
    end
end

inline func _orig_nsm(cps: Vector<int>, seq: Vector<int>, k: int): bool:
    ret unicode.BidiClass(cps.Get(seq.Get(k))) == unicode.BcNSM
end

func _resolve_neutrals(types &: Vector<int>, seq: Vector<int>, level: int, sos: int, eos: int):
    m := seq.Len()
    e := _level_dir(level)
    mut k := 0
    until k < m:
        if _is_ni(types.Get(seq.Get(k))) == false:
            k++
            continue
        end
        mut end_k := k
        until end_k < m and _is_ni(types.Get(seq.Get(end_k))):
            end_k++
        end
        mut before := sos
        if k > 0: before = _n_dir(types.Get(seq.Get(k - 1))) end
        mut after := eos
        if end_k < m: after = _n_dir(types.Get(seq.Get(end_k))) end
        mut fill := e
        if before == after and before >= 0: fill = before end
        mut j := k
        until j < end_k:
            types.Set(seq.Get(j), fill)
            j++
        end
        k = end_k
    end
end

func _resolve_implicit(types: Vector<int>, seq: Vector<int>, levels &: Vector<int>):
    m := seq.Len()
    repeat m in k:
        p := seq.Get(k)
        t := types.Get(p)
        lv := levels.Get(p)
        if lv % 2 == 0:
            if t == unicode.BcR: levels.Set(p, lv + 1)
            else t == unicode.BcAN or t == unicode.BcEN: levels.Set(p, lv + 2) end
        else:
            if t == unicode.BcL or t == unicode.BcAN or t == unicode.BcEN:
                levels.Set(p, lv + 1)
            end
        end
    end
end

func _code_points(s: str): Vector<int>:
    out := Vector {} as Vector<int>
    n := s.Len()
    mut i := 0
    mut cp := 0
    until i < n:
        i = str.CodePointAt(s, i, cp)
        if cp < 0: cp = 0xFFFD end
        out.Push(cp)
    end
    ret out
end

func _resolve(cps: Vector<int>, dir: int, levels &: Vector<int>): int:
    n := cps.Len()

    orig := Vector {} as Vector<int>
    defer orig.Free()
    mut types := Vector {} as Vector<int>
    defer types.Free()
    repeat n in i:
        c := unicode.BidiClass(cps.Get(i))
        orig.Push(c)
        types.Push(c)
    end

    mut pdi_of := _new_ints(n, 0 - 1)
    defer pdi_of.Free()
    mut init_of := _new_ints(n, 0 - 1)
    defer init_of.Free()
    _match_isolates(types, pdi_of, init_of)

    mut para := 0
    if dir == DirRTL: para = 1
    else dir == DirLTR: para = 0
    else:
        para = _auto_level(types, 0, n)
    end

    repeat n in i: levels.Set(i, para) end
    _explicit_levels(types, pdi_of, para, levels)

    explicit := _new_ints(n, 0)
    defer explicit.Free()
    repeat n in i: explicit.Set(i, levels.Get(i)) end

    retained := Vector {} as Vector<int>
    defer retained.Free()
    repeat n in i:
        if _is_removed(orig.Get(i)) == false: retained.Push(i) end
    end
    rn := retained.Len()

    run_start := Vector {} as Vector<int>
    defer run_start.Free()
    run_end := Vector {} as Vector<int>
    defer run_end.Free()
    run_of := _new_ints(n, 0 - 1)
    defer run_of.Free()
    mut k := 0
    until k < rn:
        mut e := k
        lv := explicit.Get(retained.Get(k))
        until e < rn and explicit.Get(retained.Get(e)) == lv:
            run_of.Set(retained.Get(e), run_start.Len())
            e++
        end
        run_start.Push(k)
        run_end.Push(e - 1)
        k = e
    end

    used := _new_ints(run_start.Len(), 0)
    defer used.Free()
    mut r := 0
    until r < run_start.Len():
        if used.Get(r) == 1:
            r++
            continue
        end
        first := retained.Get(run_start.Get(r))
        if orig.Get(first) == unicode.BcPDI and init_of.Get(first) >= 0:
            r++
            continue
        end

        seq := Vector {} as Vector<int>
        defer seq.Free()
        mut cur := r
        until true:
            used.Set(cur, 1)
            mut q := run_start.Get(cur)
            until q <= run_end.Get(cur):
                seq.Push(retained.Get(q))
                q++
            end
            last := retained.Get(run_end.Get(cur))
            if _is_isolate_init(orig.Get(last)) == false: break end
            nxt := pdi_of.Get(last)
            if nxt < 0: break end
            nr := run_of.Get(nxt)
            if nr < 0 or used.Get(nr) == 1: break end
            cur = nr
        end

        level := explicit.Get(seq.Get(0))
        mut prev_level := para
        pi := run_start.Get(r) - 1
        if pi >= 0: prev_level = explicit.Get(retained.Get(pi)) end
        mut hi := level
        if prev_level > hi: hi = prev_level end
        sos := _level_dir(hi)

        seq_last := seq.Get(seq.Len() - 1)
        mut next_level := para
        if _is_isolate_init(orig.Get(seq_last)) and pdi_of.Get(seq_last) < 0:
            next_level = para
        else:
            ni := run_end.Get(cur) + 1
            if ni < rn: next_level = explicit.Get(retained.Get(ni)) end
        end
        hi = level
        if next_level > hi: hi = next_level end
        eos := _level_dir(hi)

        _resolve_weak(types, seq, sos)
        _resolve_brackets(cps, types, seq, level, sos)
        _resolve_neutrals(types, seq, level, sos, eos)
        _resolve_implicit(types, seq, levels)
        r++
    end

    mut trailing := true
    mut q := rn - 1
    until q >= 0:
        p := retained.Get(q)
        t := orig.Get(p)
        if t == unicode.BcB or t == unicode.BcS:
            levels.Set(p, para)
            trailing = true
        else t == unicode.BcWS or _is_isolate_init(t) or t == unicode.BcPDI:
            if trailing: levels.Set(p, para) end
        else:
            trailing = false
        end
        q--
    end

    repeat n in i:
        if _is_removed(orig.Get(i)): levels.Set(i, 0 - 1) end
    end
    ret para
end

@en "ParagraphLevel"
@fa "تراز بند"
pub func ParagraphLevel(s: str, dir: int): int:
    cps := _code_points(s)
    defer cps.Free()
    mut levels := _new_ints(cps.Len(), 0)
    defer levels.Free()
    ret _resolve(cps, dir, levels)
end

@en "Levels"
@fa "ترازها"
pub func Levels(s: str, dir: int): Vector<int>:
    cps := _code_points(s)
    defer cps.Free()
    mut levels := _new_ints(cps.Len(), 0)
    _resolve(cps, dir, levels)
    ret levels
end

@en "VisualOrder"
@fa "ترتیب دیداری"
pub func VisualOrder(s: str, dir: int): Vector<int>:
    cps := _code_points(s)
    defer cps.Free()
    n := cps.Len()
    mut levels := _new_ints(n, 0)
    defer levels.Free()
    _resolve(cps, dir, levels)

    order := Vector {} as Vector<int>
    keep := Vector {} as Vector<int>
    defer keep.Free()
    repeat n in i:
        if levels.Get(i) >= 0:
            order.Push(i)
            keep.Push(levels.Get(i))
        end
    end
    m := order.Len()
    if m == 0: ret order end

    mut highest := 0
    mut lowest_odd := _MAX_DEPTH + 2
    repeat m in i:
        lv := keep.Get(i)
        if lv > highest: highest = lv end
        if lv % 2 == 1 and lv < lowest_odd: lowest_odd = lv end
    end

    mut lv := highest
    until lv >= lowest_odd:
        mut i := 0
        until i < m:
            if keep.Get(i) < lv:
                i++
                continue
            end
            mut e := i
            until e < m and keep.Get(e) >= lv:
                e++
            end
            mut a := i
            mut b := e - 1
            until a < b:
                t := order.Get(a)
                order.Set(a, order.Get(b))
                order.Set(b, t)
                a++
                b--
            end
            i = e
        end
        lv--
    end
    ret order
end

@en "Reorder"
@fa "بازچینش"
pub func Reorder(s: str, dir: int): str:
    cps := _code_points(s)
    defer cps.Free()
    order := VisualOrder(s, dir)
    defer order.Free()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat order.Len() in i:
        str.BufAppendCp(sb, cps.Get(order.Get(i)))
    end
    ret str.BufStr(sb)
end
