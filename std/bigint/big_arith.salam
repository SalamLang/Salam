package bigint

@en "Neg"
@fa "قرینه"
pub func Neg(x: Int): Int:
    mut r := x.clone()
    if !r.is_zero(): r.neg = !r.neg end
    ret r
end

@en "Abs"
@fa "قدرمطلق"
pub func Abs(x: Int): Int:
    mut r := x.clone()
    r.neg = false
    ret r
end

@en "Add"
@fa "جمع"
pub func Add(a: Int, b: Int): Int:
    if a.neg == b.neg:
        mut r := _uadd(a, b)
        r.neg = a.neg
        _norm(r)
        ret r
    end
    c := _ucmp(a, b)
    if c == 0: ret Int {} end
    if c > 0:
        mut r := _usub(a, b)
        r.neg = a.neg
        _norm(r)
        ret r
    end
    mut r := _usub(b, a)
    r.neg = b.neg
    _norm(r)
    ret r
end

@en "Sub"
@fa "تفریق"
pub func Sub(a: Int, b: Int): Int:
    mut nb := b.clone()
    defer nb.free()
    if !nb.is_zero(): nb.neg = !nb.neg end
    ret Add(a, nb)
end

@en "Mul"
@fa "ضرب"
pub func Mul(a: Int, b: Int): Int:
    mut r := _umul(a, b)
    r.neg = a.neg != b.neg
    _norm(r)
    ret r
end

@en "Sqr"
@fa "مربع"
pub func Sqr(x: Int): Int: ret Mul(x, x) end

@en "AddInt"
@fa "جمع صحیح"
pub func AddInt(a: Int, v: i64): Int:
    mut b := FromInt(v)
    defer b.free()
    ret Add(a, b)
end

@en "SubInt"
@fa "تفریق صحیح"
pub func SubInt(a: Int, v: i64): Int:
    mut b := FromInt(v)
    defer b.free()
    ret Sub(a, b)
end

@en "MulInt"
@fa "ضرب صحیح"
pub func MulInt(a: Int, v: i64): Int:
    mut b := FromInt(v)
    defer b.free()
    ret Mul(a, b)
end

@en "Shl"
@fa "شیفت چپ"
pub func Shl(x: Int, k: int): Int:
    if k < 0: ret Shr(x, 0 - k) end
    mut r := _ushl(x, k)
    r.neg = x.neg
    _norm(r)
    ret r
end

@en "Shr"
@fa "شیفت راست"
pub func Shr(x: Int, k: int): Int:
    if k < 0: ret Shl(x, 0 - k) end
    mut r := _ushr(x, k)
    if x.neg:
        if _has_low_bits(x, k):
            mut one := One()
            defer one.free()
            bumped := _uadd(r, one)
            r.free()
            r = bumped
        end
        r.neg = true
    end
    _norm(r)
    ret r
end

@en "Set"
@fa "تنظیم"
pub func Set(x &: Int, src: Int): _replace(x, src.clone()) end

@en "SetInt"
@fa "تنظیم صحیح"
pub func SetInt(x &: Int, v: i64): _replace(x, FromInt(v)) end

@en "AddTo"
@fa "افزودن به"
pub func AddTo(x &: Int, y: Int): _replace(x, Add(x, y)) end

@en "SubFrom"
@fa "کاستن از"
pub func SubFrom(x &: Int, y: Int): _replace(x, Sub(x, y)) end

@en "MulBy"
@fa "ضرب در"
pub func MulBy(x &: Int, y: Int): _replace(x, Mul(x, y)) end

@en "AddIntTo"
@fa "افزودن صحیح به"
pub func AddIntTo(x &: Int, v: i64): _replace(x, AddInt(x, v)) end

@en "MulIntBy"
@fa "ضرب در صحیح"
pub func MulIntBy(x &: Int, v: i64): _replace(x, MulInt(x, v)) end

@en "NegateIn"
@fa "قرینه‌سازی"
pub func NegateIn(x &: Int):
    if !x.is_zero(): x.neg = !x.neg end
end

@en "ShlBy"
@fa "شیفت چپ در جا"
pub func ShlBy(x &: Int, k: int): _replace(x, Shl(x, k)) end

@en "ShrBy"
@fa "شیفت راست در جا"
pub func ShrBy(x &: Int, k: int): _replace(x, Shr(x, k)) end
