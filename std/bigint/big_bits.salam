package bigint

const _OP_AND := 0
const _OP_OR := 1
const _OP_XOR := 2
const _OP_ANDNOT := 3

func _op_u32(a: u32, b: u32, op: int): u32:
    if op == _OP_AND: ret a & b end
    if op == _OP_OR: ret a | b end
    if op == _OP_XOR: ret a ^ b end
    ret a & (~b)
end

func _op_bool(a: bool, b: bool, op: int): bool:
    if op == _OP_AND: ret a && b end
    if op == _OP_OR: ret a || b end
    if op == _OP_XOR: ret a != b end
    ret a && !b
end

func _tc_prep(x: Int): Int:
    if !x.neg: ret Abs(x) end
    mut one := One()
    mut ax := Abs(x)
    r := _usub(ax, one)
    ax.free()
    one.free()
    ret r
end

func _tc_limb(p: Int, neg: bool, i: int): u32:
    v := _at(p, i)
    if neg: ret ~v end
    ret v
end

func _bitop(a: Int, b: Int, op: int): Int:
    mut pa := _tc_prep(a)
    mut pb := _tc_prep(b)
    mut n := pa.mag.len()
    if pb.mag.len() > n: n = pb.mag.len() end
    n += 1

    rneg := _op_bool(a.neg, b.neg, op)
    mut r := _blank(n)
    repeat n with i:
        r.mag.set(i, _op_u32(_tc_limb(pa, a.neg, i), _tc_limb(pb, b.neg, i), op))
    end
    pa.free()
    pb.free()

    if rneg:
        mut carry := 1 as u64
        repeat n with i:
            t := ((~r.mag.get(i)) as u64) + carry
            r.mag.set(i, (t & _LOW_MASK) as u32)
            carry = t >> 32
        end
        if carry != 0 as u64: r.mag.push(carry as u32) end
        r.neg = true
    end
    _norm(r)
    ret r
end

@en "And"
@fa "و بیتی"
@ar "و بتي"
pub func And(a: Int, b: Int): Int: ret _bitop(a, b, _OP_AND) end

@en "Or"
@fa "یا بیتی"
@ar "أو بتي"
pub func Or(a: Int, b: Int): Int: ret _bitop(a, b, _OP_OR) end

@en "Xor"
@fa "یای انحصاری"
@ar "أو حصري"
pub func Xor(a: Int, b: Int): Int: ret _bitop(a, b, _OP_XOR) end

@en "AndNot"
@fa "و نقیض"
@ar "و ليس"
pub func AndNot(a: Int, b: Int): Int: ret _bitop(a, b, _OP_ANDNOT) end

@en "Not"
@fa "نقیض بیتی"
@ar "ليس بتي"
pub func Not(x: Int): Int:
    mut one := One()
    defer one.free()
    mut s := Add(x, one)
    NegateIn(s)
    ret s
end

@en "PopCount"
@fa "شمار یک‌ها"
@ar "عدد الآحاد"
pub func PopCount(x: Int): int:
    mut c := 0
    repeat x.mag.len() with i:
        mut v := x.mag.get(i)
        while v != 0 as u32:
            v = v & (v - (1 as u32))
            c += 1
        end
    end
    ret c
end

@en "TrailingZeros"
@fa "صفرهای پایانی"
@ar "أصفار لاحقة"
pub func TrailingZeros(x: Int): int:
    if x.is_zero(): ret 0 - 1 end
    repeat x.mag.len() with i:
        v := x.mag.get(i)
        if v != 0 as u32:
            mut k := 0
            mut t := v
            while (t & (1 as u32)) == 0 as u32:
                t = t >> 1
                k += 1
            end
            ret i * _LIMB_BITS + k
        end
    end
    ret 0 - 1
end
