package bigint

import str

// Text and byte conversions.
//
// Both directions work in the largest chunk that still fits a limb rather than
// one digit at a time: for base 10 that is 10^9, so printing costs one long
// division per nine digits and parsing one short multiply per nine. The naive
// per-digit loop is nine times the work for the same answer.
//
// Parsing is permissive in the ways that help and strict in the ways that
// matter. It accepts a leading sign, `_` as a group separator (1_000_000), and
// Persian and Arabic-Indic digits alongside ASCII -- a Salam program reading a
// price out of a Persian invoice should not have to transliterate first. It
// rejects everything else, including an empty string, a lone sign, and a
// trailing separator, by setting ok = false rather than returning a partial
// number.

// Value of an ASCII digit or letter in the given base, or -1 if it is not one.
func _digit_val(c: int, base: int): int:
    mut d := 0 - 1
    if c >= 48 && c <= 57: d = c - 48
    else c >= 97 && c <= 122: d = c - 97 + 10
    else c >= 65 && c <= 90: d = c - 65 + 10
    end
    if d < 0 || d >= base: ret 0 - 1 end
    ret d
end

// Lowercase is the convention here, matching conv.FormatHex.
func _digit_char(d: int): int:
    if d < 10: ret 48 + d end
    ret 97 + (d - 10)
end

// ---------------------------------------------------------------------------
// Formatting
// ---------------------------------------------------------------------------

@en "ToStr"
@fa "به رشته"
@ar "إلى نص"
pub func ToStr(x: Int): str: ret ToStrBase(x, 10) end

// x written in the given base, 2 through 36, with a leading '-' when negative
// and no base prefix. An out-of-range base gives "".
@en "ToStrBase"
@fa "به رشته با پایه"
@ar "إلى نص بأساس"
pub func ToStrBase(x: Int, base: int): str:
    if base < 2 || base > 36: ret "" end
    if x.is_zero(): ret "0" end

    // The largest power of the base that still fits a limb, so one division
    // step yields `per` digits.
    mut pw := 1 as u64
    mut per := 0
    while pw * (base as u64) <= _LOW_MASK:
        pw = pw * (base as u64)
        per += 1
    end

    // Digits come out least significant first and are reversed on the way into
    // the builder.
    mut digits := Vector {} as Vector<int>
    mut cur := Abs(x)
    while !cur.is_zero():
        mut rem := 0 as u32
        nx := _udivmod_small(cur, pw as u32, rem)
        cur.free()
        cur = nx
        // u64, not int: the chunk is the largest power of the base below
        // 2^32, which for base 2 and base 36 is above the i32 ceiling and
        // would come back negative.
        mut chunk := rem as u64
        radix := base as u64
        if cur.is_zero():
            // Top chunk: emit only its significant digits, no leading zeros.
            while chunk > 0 as u64:
                digits.push((chunk % radix) as int)
                chunk = chunk / radix
            end
        else:
            // An interior chunk is exactly `per` digits, zeros included.
            repeat per:
                digits.push((chunk % radix) as int)
                chunk = chunk / radix
            end
        end
    end
    cur.free()

    mut b := str.NewBuilder()
    if x.neg: str.BufAppendChar(b, 45) end
    mut i := digits.len() - 1
    while i >= 0:
        str.BufAppendChar(b, _digit_char(digits.get(i)))
        i -= 1
    end
    digits.free()
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

// Lowercase hex, sign-prefixed, with no "0x".
@en "ToHex"
@fa "به شانزده‌شانزدهی"
@ar "إلى ست عشري"
pub func ToHex(x: Int): str: ret ToStrBase(x, 16) end

// ---------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------

@en "Parse"
@fa "تجزیه"
@ar "تحليل"
pub func Parse(s: str, ok &: bool): Int: ret ParseBase(s, 10, ok) end

// Parses s in the given base. Base 0 means "read the prefix": 0x/0X is 16,
// 0b/0B is 2, 0o/0O is 8, anything else is 10 -- so a leading zero alone is
// still decimal, unlike C, where 010 silently means 8.
@en "ParseBase"
@fa "تجزیه با پایه"
@ar "تحليل بأساس"
pub func ParseBase(s: str, base: int, ok &: bool): Int:
    ok = false
    if base != 0 && (base < 2 || base > 36): ret Int {} end

    // Fold Persian and Arabic-Indic digits down to ASCII before scanning, so
    // "۱۲۳" and "123" take the same path. The probe comes first because the
    // fold allocates a copy and almost every input is already ASCII.
    mut norm := s
    if str.HasPersianDigits(s) || str.HasArabicDigits(s):
        norm = str.ToEnglishDigits(s)
    end
    n := norm.len()
    mut i := 0
    while i < n && (norm[i] as int) == 32: i += 1 end

    mut neg := false
    if i < n:
        c := norm[i] as int
        if c == 45: neg = true i += 1
        else c == 43: i += 1
        end
    end

    mut b := base
    if b == 0:
        b = 10
        if i + 1 < n && (norm[i] as int) == 48:
            p := norm[i + 1] as int
            if p == 120 || p == 88: b = 16 i += 2
            else p == 98 || p == 66: b = 2 i += 2
            else p == 111 || p == 79: b = 8 i += 2
            end
        end
    end

    // Chunk size for the accumulate loop, mirroring the print loop.
    mut pw := 1 as u64
    mut per := 0
    while pw * (b as u64) <= _LOW_MASK:
        pw = pw * (b as u64)
        per += 1
    end

    mut acc := Int {}
    mut chunk := 0 as u64
    mut in_chunk := 0
    mut seen := 0
    mut bad := false
    mut last_sep := false
    while i < n:
        c := norm[i] as int
        i += 1
        if c == 95:
            // A separator is only legal between digits.
            if seen == 0: bad = true break end
            last_sep = true
            continue
        end
        d := _digit_val(c, b)
        if d < 0: bad = true break end
        last_sep = false
        seen += 1
        chunk = chunk * (b as u64) + (d as u64)
        in_chunk += 1
        if in_chunk == per:
            nx := _umul_add_small(acc, pw as u32, chunk as u32)
            acc.free()
            acc = nx
            chunk = 0 as u64
            in_chunk = 0
        end
    end

    if bad || seen == 0 || last_sep:
        acc.free()
        ret Int {}
    end

    if in_chunk > 0:
        // Fold the short tail in with the matching power of the base.
        mut mult := 1 as u64
        repeat in_chunk: mult = mult * (b as u64) end
        nx := _umul_add_small(acc, mult as u32, chunk as u32)
        acc.free()
        acc = nx
    end

    acc.neg = neg
    _norm(acc)
    ok = true
    ret acc
end

// Parses s, or returns zero when it is not a valid number in the base. For
// literals you know are well formed: bigint.ParseOr("2", 10) needs no out
// parameter to check.
@en "ParseOr"
@fa "تجزیه یا صفر"
@ar "تحليل أو صفر"
pub func ParseOr(s: str, base: int): Int:
    mut ok := false
    mut v := ParseBase(s, base, ok)
    if !ok:
        v.free()
        ret Int {}
    end
    ret v
end

// ---------------------------------------------------------------------------
// Machine number conversions
// ---------------------------------------------------------------------------

// x as an i64, setting ok = false and returning 0 if it does not fit.
@en "ToInt"
@fa "به صحیح"
@ar "إلى صحيح"
pub func ToInt(x: Int, ok &: bool): i64:
    ok = true
    n := x.mag.len()
    if n == 0: ret 0 end
    if n > 2:
        ok = false
        ret 0
    end
    mut u := x.mag.get(0) as u64
    if n == 2: u = u | ((x.mag.get(1) as u64) << 32) end
    if x.neg:
        // The negative range reaches one further than the positive one, and
        // 0 - i64_MIN is i64_MIN, so the boundary value converts on this path
        // without ever being representable as a positive i64.
        if u > 0x8000000000000000 as u64:
            ok = false
            ret 0
        end
        ret (0 as i64) - (u as i64)
    end
    if u > 0x7FFFFFFFFFFFFFFF as u64:
        ok = false
        ret 0
    end
    ret u as i64
end

// x as an i64, saturating at the ends of the range instead of failing.
@en "ToIntClamped"
@fa "به صحیح محدود"
@ar "إلى صحيح محدود"
pub func ToIntClamped(x: Int): i64:
    mut ok := true
    v := ToInt(x, ok)
    if ok: ret v end
    if x.neg: ret 0 - 0x7FFFFFFFFFFFFFFF as i64 - (1 as i64) end
    ret 0x7FFFFFFFFFFFFFFF
end

// x as the nearest f64. Values past ~1.8e308 come back as an infinity, and
// anything over 53 bits loses its low bits -- which is the whole reason this
// package exists, so use it only where an approximation is what you want.
@en "ToFloat"
@fa "به اعشاری"
@ar "إلى عشري"
pub func ToFloat(x: Int): f64:
    mut f := 0.0
    mut i := x.mag.len() - 1
    while i >= 0:
        f = f * 4294967296.0 + (x.mag.get(i) as f64)
        i -= 1
    end
    if x.neg: ret 0.0 - f end
    ret f
end

// ---------------------------------------------------------------------------
// Bytes
//
// Big-endian and unsigned, which is how integers appear in DER, in TLS, and in
// SSH wire format. The sign is not encoded: FromBytes always returns a value
// that is zero or positive, and ToBytes writes |x|.
// ---------------------------------------------------------------------------

// Bytes needed to write |x| with no leading zero byte; zero needs none.
@en "ByteLen"
@fa "طول بایت"
@ar "طول البايت"
pub func ByteLen(x: Int): int: ret (x.bit_len() + 7) / 8 end

@en "FromBytes"
@fa "از بایت‌ها"
@ar "من البايتات"
pub func FromBytes(p: void*, n: int): Int:
    mut r := Int {}
    if p == null || n <= 0: ret r end
    src := p as u8*
    nl := (n + 3) / 4
    r.mag.zeros(nl)
    // Walk from the least significant byte, which is the last one.
    mut i := 0
    while i < n:
        b := src[n - 1 - i] as u32
        li := i / 4
        sh := (i % 4) * 8
        r.mag.set(li, r.mag.get(li) | (b << sh))
        i += 1
    end
    _norm(r)
    ret r
end

// Writes |x| big-endian into n bytes, zero padded on the left. Returns false
// without writing anything when x does not fit, so a caller sizing a buffer
// from ByteLen never truncates a number silently.
@en "ToBytes"
@fa "به بایت‌ها"
@ar "إلى البايتات"
pub func ToBytes(x: Int, out: void*, n: int): bool:
    if out == null || n < 0: ret false end
    need := ByteLen(x)
    if need > n: ret false end
    dst := out as u8*
    mut i := 0
    while i < n:
        // Byte i counted from the least significant end lands at n-1-i.
        li := i / 4
        mut v := 0 as u32
        if li < x.mag.len(): v = (x.mag.get(li) >> ((i % 4) * 8)) & (0xFF as u32) end
        dst[n - 1 - i] = v as u8
        i += 1
    end
    ret true
end
