package bigint

func _half(x: Int): Int: ret _ushr(x, 1) end

@en "Pow"
@fa "توان"
@ar "أس"
pub func Pow(x: Int, e: int): Int:
    if e < 0: ret Int {} end
    if e == 0: ret One() end
    mut result := One()
    mut base := x.clone()
    mut n := e
    while n > 0:
        if (n & 1) == 1:
            t := Mul(result, base)
            result.free()
            result = t
        end
        n = n >> 1
        if n > 0:
            sq := Sqr(base)
            base.free()
            base = sq
        end
    end
    base.free()
    ret result
end

@en "Pow10"
@fa "توان ده"
@ar "أس عشرة"
pub func Pow10(n: int): Int:
    if n < 0: ret Int {} end
    mut r := One()
    mut k := n
    while k >= 9:
        t := _umul_add_small(r, 1000000000 as u32, 0 as u32)
        r.free()
        r = t
        k -= 9
    end
    if k > 0:
        mut m := 1 as u32
        repeat k: m = m * (10 as u32) end
        t := _umul_add_small(r, m, 0 as u32)
        r.free()
        r = t
    end
    ret r
end

@en "ModExp"
@fa "توان پیمانه‌ای"
@ar "أس تعديلي"
pub func ModExp(base: Int, e: Int, m: Int): Int:
    if m.is_zero() || e.neg: ret Int {} end
    mut mm := Abs(m)
    mut one := One()
    mut result := Mod(one, mm)
    one.free()
    mut b := Mod(base, mm)
    mut i := e.bit_len() - 1
    while i >= 0:
        sq := Sqr(result)
        result.free()
        result = Mod(sq, mm)
        sq.free()
        if Bit(e, i) == 1:
            p := Mul(result, b)
            result.free()
            result = Mod(p, mm)
            p.free()
        end
        i -= 1
    end
    b.free()
    mm.free()
    ret result
end

@en "Gcd"
@fa "ب م م"
@ar "قاسم مشترك أكبر"
pub func Gcd(a: Int, b: Int): Int:
    mut x := Abs(a)
    mut y := Abs(b)
    while !y.is_zero():
        r := Mod(x, y)
        x.free()
        x = y
        y = r
    end
    y.free()
    ret x
end

@en "Lcm"
@fa "ک م م"
@ar "مضاعف مشترك أصغر"
pub func Lcm(a: Int, b: Int): Int:
    if a.is_zero() || b.is_zero(): ret Int {} end
    mut g := Gcd(a, b)
    mut d := Div(a, g)
    g.free()
    mut p := Mul(d, b)
    d.free()
    r := Abs(p)
    p.free()
    ret r
end

@en "ExtGcd"
@fa "ب م م گسترده"
@ar "قاسم مشترك ممتد"
pub func ExtGcd(a: Int, b: Int, x &: Int, y &: Int): Int:
    mut old_r := Abs(a)
    mut r := Abs(b)
    mut old_s := One()
    mut s := Int {}
    mut old_t := Int {}
    mut t := One()
    while !r.is_zero():
        q := Div(old_r, r)
        qr := Mul(q, r)
        nr := Sub(old_r, qr)
        qr.free()
        old_r.free()
        old_r = r
        r = nr
        qs := Mul(q, s)
        ns := Sub(old_s, qs)
        qs.free()
        old_s.free()
        old_s = s
        s = ns
        qt := Mul(q, t)
        nt := Sub(old_t, qt)
        qt.free()
        old_t.free()
        old_t = t
        t = nt
        q.free()
    end
    r.free()
    s.free()
    t.free()
    if a.neg: NegateIn(old_s) end
    if b.neg: NegateIn(old_t) end
    _replace(x, old_s)
    _replace(y, old_t)
    ret old_r
end

@en "ModInverse"
@fa "وارون پیمانه‌ای"
@ar "معكوس تعديلي"
pub func ModInverse(a: Int, m: Int, ok &: bool): Int:
    ok = false
    if m.is_zero(): ret Int {} end
    mut mm := Abs(m)
    mut x := Int {}
    mut y := Int {}
    mut g := ExtGcd(a, mm, x, y)
    y.free()
    one := EqualsInt(g, 1 as i64)
    g.free()
    if !one:
        x.free()
        mm.free()
        ret Int {}
    end
    r := Mod(x, mm)
    x.free()
    mm.free()
    ok = true
    ret r
end

@en "Sqrt"
@fa "جذر"
@ar "جذر"
pub func Sqrt(x: Int): Int:
    if x.neg || x.is_zero(): ret Int {} end
    bl := x.bit_len()
    if bl <= 2: ret One() end
    mut one := One()
    mut a := Shl(one, (bl + 1) / 2)
    one.free()
    while true:
        d := Div(x, a)
        sum := Add(a, d)
        d.free()
        b := _half(sum)
        sum.free()
        if Cmp(b, a) >= 0:
            b.free()
            break
        end
        a.free()
        a = b
    end
    ret a
end

@en "Factorial"
@fa "فاکتوریل"
@ar "مضروب"
pub func Factorial(n: int): Int:
    if n < 0: ret Int {} end
    mut r := One()
    mut i := 2
    while i <= n:
        MulIntBy(r, i as i64)
        i += 1
    end
    ret r
end
