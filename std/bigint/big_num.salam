package bigint

func _half(x: Int): Int: ret _ushr(x, 1) end

@en "Pow"
@fa "توان"
pub func Pow(x: Int, e: int): Int:
    if e < 0: ret Int {} end
    if e == 0: ret One() end
    mut result := One()
    mut base := x.clone()
    mut n := e
    until n > 0:
        if (n & 1) == 1:
            t := Mul(result, base)
            result.Free()
            result = t
        end
        n >>= 1
        if n > 0:
            sq := Sqr(base)
            base.Free()
            base = sq
        end
    end
    base.Free()
    ret result
end

@en "Pow10"
@fa "توان ده"
pub func Pow10(n: int): Int:
    if n < 0: ret Int {} end
    mut r := One()
    mut k := n
    until k >= 9:
        t := _umul_add_small(r, 1000000000 as u32, 0 as u32)
        r.Free()
        r = t
        k -= 9
    end
    if k > 0:
        mut m := 1 as u32
        repeat k: m *= (10 as u32) end
        t := _umul_add_small(r, m, 0 as u32)
        r.Free()
        r = t
    end
    ret r
end

@en "ModExp"
@fa "توان پیمانه‌ای"
pub func ModExp(base: Int, e: Int, m: Int): Int:
    if m.is_zero() or e.neg: ret Int {} end
    mut mm := Abs(m)
    mut one := One()
    mut result := Mod(one, mm)
    one.Free()
    mut b := Mod(base, mm)
    mut i := e.bit_len() - 1
    until i >= 0:
        sq := Sqr(result)
        result.Free()
        result = Mod(sq, mm)
        sq.Free()
        if Bit(e, i) == 1:
            p := Mul(result, b)
            result.Free()
            result = Mod(p, mm)
            p.Free()
        end
        i--
    end
    b.Free()
    mm.Free()
    ret result
end

@en "Gcd"
@fa "ب م م"
pub func Gcd(a: Int, b: Int): Int:
    mut x := Abs(a)
    mut y := Abs(b)
    until not y.is_zero():
        r := Mod(x, y)
        x.Free()
        x = y
        y = r
    end
    y.Free()
    ret x
end

@en "Lcm"
@fa "ک م م"
pub func Lcm(a: Int, b: Int): Int:
    if a.is_zero() or b.is_zero(): ret Int {} end
    mut g := Gcd(a, b)
    mut d := Div(a, g)
    g.Free()
    mut p := Mul(d, b)
    d.Free()
    r := Abs(p)
    p.Free()
    ret r
end

@en "ExtGcd"
@fa "ب م م گسترده"
pub func ExtGcd(a: Int, b: Int, x &: Int, y &: Int): Int:
    mut old_r := Abs(a)
    mut r := Abs(b)
    mut old_s := One()
    mut s := Int {}
    mut old_t := Int {}
    mut t := One()
    until not r.is_zero():
        q := Div(old_r, r)
        qr := Mul(q, r)
        nr := Sub(old_r, qr)
        qr.Free()
        old_r.Free()
        old_r = r
        r = nr
        qs := Mul(q, s)
        ns := Sub(old_s, qs)
        qs.Free()
        old_s.Free()
        old_s = s
        s = ns
        qt := Mul(q, t)
        nt := Sub(old_t, qt)
        qt.Free()
        old_t.Free()
        old_t = t
        t = nt
        q.Free()
    end
    r.Free()
    s.Free()
    t.Free()
    if a.neg: NegateIn(old_s) end
    if b.neg: NegateIn(old_t) end
    _replace(x, old_s)
    _replace(y, old_t)
    ret old_r
end

@en "ModInverse"
@fa "وارون پیمانه‌ای"
pub func ModInverse(a: Int, m: Int, ok &: bool): Int:
    ok = false
    if m.is_zero(): ret Int {} end
    mut mm := Abs(m)
    mut x := Int {}
    mut y := Int {}
    mut g := ExtGcd(a, mm, x, y)
    y.Free()
    one := EqualsInt(g, 1 as i64)
    g.Free()
    if not one:
        x.Free()
        mm.Free()
        ret Int {}
    end
    r := Mod(x, mm)
    x.Free()
    mm.Free()
    ok = true
    ret r
end

@en "Sqrt"
@fa "جذر"
pub func Sqrt(x: Int): Int:
    if x.neg or x.is_zero(): ret Int {} end
    bl := x.bit_len()
    if bl <= 2: ret One() end
    mut one := One()
    mut a := Shl(one, (bl + 1) / 2)
    one.Free()
    until true:
        d := Div(x, a)
        sum := Add(a, d)
        d.Free()
        b := _half(sum)
        sum.Free()
        if Cmp(b, a) >= 0:
            b.Free()
            break
        end
        a.Free()
        a = b
    end
    ret a
end

@en "Factorial"
@fa "فاکتوریل"
pub func Factorial(n: int): Int:
    if n < 0: ret Int {} end
    mut r := One()
    mut i := 2
    until i <= n:
        MulIntBy(r, i as i64)
        i++
    end
    ret r
end
