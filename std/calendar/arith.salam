end

@en "AddMonthsHijri"
@fa "افزودن ماه هجری"
@ar "إضافة أشهر هجری"
pub func AddMonthsHijri(d: HijriDate, n: int): HijriDate:
    ym := _shiftMonth(d.year, d.month, n)
    mut day := d.day
    last := DaysInHijriMonth(ym.year, ym.month)
    if day > last: day = last end
    ret HijriDate { year = ym.year, month = ym.month, day = day }
end

@en "AddYearsHijri"
@fa "افزودن سال هجری"
@ar "إضافة سنوات هجری"
pub func AddYearsHijri(d: HijriDate, n: int): HijriDate:
    ret AddMonthsHijri(d, n * 12)
end

@en "DaysBetweenHijri"
@fa "روزهای بین هجری"
@ar "الأیام بین تاریخین هجریین"
pub func DaysBetweenHijri(from: HijriDate, toDate: HijriDate): i64:
    ret HijriToJDN(toDate) - HijriToJDN(from)
end

@en "StartOfMonthHijri"
@fa "آغاز ماه هجری"
@ar "بدایة الشهر الهجری"
pub func StartOfMonthHijri(d: HijriDate): HijriDate:
    ret HijriDate { year = d.year, month = d.month, day = 1 }
end

@en "EndOfMonthHijri"
@fa "پایان ماه هجری"
@ar "نهایة الشهر الهجری"
pub func EndOfMonthHijri(d: HijriDate): HijriDate:
    ret HijriDate { year = d.year, month = d.month, day = DaysInHijriMonth(d.year, d.month) }
end

// -- weekday helpers ------------------------------------------------------

// Weekday of a date in each calendar (0=Sunday .. 6=Saturday), saving the
// caller a manual trip through JDN.
@en "WeekdayGregorian"
@fa "روز هفته میلادی"
@ar "یوم الأسبوع المیلادی"
pub func WeekdayGregorian(d: GregorianDate): int: ret Weekday(GregorianToJDN(d)) end

@en "WeekdayJalali"
@fa "روز هفته جلالی"
@ar "یوم الأسبوع الجلالی"
pub func WeekdayJalali(d: JalaliDate): int: ret Weekday(JalaliToJDN(d)) end

@en "WeekdayHijri"
@fa "روز هفته هجری"
@ar "یوم الأسبوع الهجری"
pub func WeekdayHijri(d: HijriDate): int: ret Weekday(HijriToJDN(d)) end

// The next date on or after `d` that falls on `weekday` (0=Sunday). Useful
// for "the first Friday of the month" style rules - and used by tzif.salam
// to resolve POSIX DST rules like "the last Sunday in March".
@en "NextWeekdayOnOrAfter"
@fa "روز هفته بعدی"
@ar "یوم الأسبوع التالی"
pub func NextWeekdayOnOrAfter(d: GregorianDate, weekday: int): GregorianDate:
    jdn := GregorianToJDN(d)
    delta := _floormod((weekday as i64) - (Weekday(jdn) as i64), 7)
    ret JDNToGregorian(jdn + delta)
end
