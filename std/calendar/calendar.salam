@en "calendar"
@fa "تقویم"
package calendar

import time

const _UNIX_EPOCH_JDN := 2440588 as i64
const _SECONDS_PER_DAY := 86400 as i64

const _GREG_MONTH_DAYS := [
    31 as int, 28 as int, 31 as int, 30 as int, 31 as int, 30 as int
    31 as int, 31 as int, 30 as int, 31 as int, 30 as int, 31 as int
]

const _WEEKDAY_NAMES_EN := [
    "Sunday", "Monday", "Tuesday", "Wednesday"
    "Thursday", "Friday", "Saturday"
]

const _WEEKDAY_NAMES_FA := [
    "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه"
    "پنجشنبه", "جمعه", "شنبه"
]

const _WEEKDAY_NAMES_AR := [
    "الأحد", "الإثنین", "الثلاثاء", "الأربعاء"
    "الخمیس", "الجمعة", "السبت"
]

const _GREG_MONTH_NAMES_EN := [
    "January", "February", "March", "April"
    "May", "June", "July", "August"
    "September", "October", "November", "December"
]

@en "GregorianDate"
@fa "تاریخ میلادی"
pub struct GregorianDate:
    pub year: int = 1970
    pub month: int = 1
    pub day: int = 1
end

@en "JalaliDate"
@fa "تاریخ جلالی"
pub struct JalaliDate:
    pub year: int = 1
    pub month: int = 1
    pub day: int = 1
end

@en "HijriDate"
@fa "تاریخ هجری قمری"
pub struct HijriDate:
    pub year: int = 1
    pub month: int = 1
    pub day: int = 1
end

@en "ClockTime"
@fa "زمان ساعت"
pub struct ClockTime:
    pub hour: int = 0
    pub minute: int = 0
    pub second: int = 0
end

pure func _fdiv(a: i64, b: i64): i64: ret a / b end

pure func _fmod(a: i64, b: i64): i64: ret a - (a / b) * b end

pure func _floordiv(a: i64, b: i64): i64:
    q := a / b
    r := a - q * b
    if r != 0 && (r < 0) != (b < 0):
        ret q - 1
    end
    ret q
end

pure func _floormod(a: i64, b: i64): i64:
    ret a - _floordiv(a, b) * b
end

@en "GregorianToJDN"
@fa "میلادی به روز ژولیانی"
pub func GregorianToJDN(d: GregorianDate): i64:
    y := d.year as i64
    m := d.month as i64
    day := d.day as i64
    a := _fdiv(m - 8, 6)
    mut jdn := _fdiv((y + a + 100100) * 1461, 4) + _fdiv(153 * _fmod(m + 9, 12) + 2, 5) + day - 34840408
    jdn = jdn - _fdiv(_fdiv(y + 100100 + a, 100) * 3, 4) + 752
    ret jdn
end

@en "JDNToGregorian"
@fa "روز ژولیانی به میلادی"
pub func JDNToGregorian(jdn: i64): GregorianDate:
    mut j := 4 * jdn + 139361631
    j = j + _fdiv(_fdiv(4 * jdn + 183187720, 146097) * 3, 4) * 4 - 3908
    i := _fdiv(_fmod(j, 1461), 4) * 5 + 308
    d := _fdiv(_fmod(i, 153), 5) + 1
    m := _fmod(_fdiv(i, 153), 12) + 1
    y := _fdiv(j, 1461) - 100100 + _fdiv(8 - m, 6)
    ret GregorianDate { year = y as int, month = m as int, day = d as int }
end

@en "IsLeapGregorian"
@fa "سال کبیسه میلادی"
pub inline pure func IsLeapGregorian(year: int): bool:
    ret (_fmod(year as i64, 4) == 0 && _fmod(year as i64, 100) != 0) || _fmod(year as i64, 400) == 0
end

@en "DaysInGregorianMonth"
@fa "روزهای ماه میلادی"
pub func DaysInGregorianMonth(year: int, month: int): int:
    if month == 2 && IsLeapGregorian(year): ret 29 end
    ret _GREG_MONTH_DAYS[month - 1]
end

@en "IsValidGregorianDate"
@fa "تاریخ میلادی معتبر است"
pub func IsValidGregorianDate(year: int, month: int, day: int): bool:
    if month < 1 || month > 12: ret false end
    if day < 1: ret false end
    ret day <= DaysInGregorianMonth(year, month)
end

@en "Weekday"
@fa "روز هفته"
pub inline pure func Weekday(jdn: i64): int:
    ret _fmod(jdn + 1, 7) as int
end

@en "WeekdayNameEn"
@fa "نام روز هفته انگلیسی"
pub func WeekdayNameEn(weekday: int): str: ret _WEEKDAY_NAMES_EN[weekday] end

@en "WeekdayNameFa"
@fa "نام روز هفته فارسی"
pub func WeekdayNameFa(weekday: int): str: ret _WEEKDAY_NAMES_FA[weekday] end

@en "WeekdayNameAr"
@fa "نام روز هفته عربی"
pub func WeekdayNameAr(weekday: int): str: ret _WEEKDAY_NAMES_AR[weekday] end

@en "GregorianMonthNameEn"
@fa "نام ماه میلادی"
pub func GregorianMonthNameEn(month: int): str: ret _GREG_MONTH_NAMES_EN[month - 1] end

@en "CompareGregorian"
@fa "مقایسه تاریخ میلادی"
pub func CompareGregorian(a: GregorianDate, b: GregorianDate): int:
    da := GregorianToJDN(a)
    db := GregorianToJDN(b)
    if da < db: ret 0 - 1 end
    if da > db: ret 1 end
    ret 0
end
