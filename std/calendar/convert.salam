package calendar

import time

func _pad2(n: int): str:
    s := "" + n
    if s.len() < 2: ret "0" + s end
    ret s
end

@en "GregorianToJalali"
@fa "میلادی به جلالی"
pub func GregorianToJalali(d: GregorianDate): JalaliDate: ret JDNToJalali(GregorianToJDN(d)) end

@en "JalaliToGregorian"
@fa "جلالی به میلادی"
pub func JalaliToGregorian(d: JalaliDate): GregorianDate: ret JDNToGregorian(JalaliToJDN(d)) end

@en "GregorianToHijri"
@fa "میلادی به هجری"
pub func GregorianToHijri(d: GregorianDate): HijriDate: ret JDNToHijri(GregorianToJDN(d)) end

@en "HijriToGregorian"
@fa "هجری به میلادی"
pub func HijriToGregorian(d: HijriDate): GregorianDate: ret JDNToGregorian(HijriToJDN(d)) end

@en "JalaliToHijri"
@fa "جلالی به هجری"
pub func JalaliToHijri(d: JalaliDate): HijriDate: ret JDNToHijri(JalaliToJDN(d)) end

@en "HijriToJalali"
@fa "هجری به جلالی"
pub func HijriToJalali(d: HijriDate): JalaliDate: ret JDNToJalali(HijriToJDN(d)) end

@en "EpochToGregorian"
@fa "زمان به میلادی"
pub func EpochToGregorian(epoch: i64): GregorianDate:
    ret GregorianDate { year = time.Year(epoch), month = time.Month(epoch), day = time.Day(epoch) }
end

@en "EpochToJalali"
@fa "زمان به جلالی"
pub func EpochToJalali(epoch: i64): JalaliDate: ret GregorianToJalali(EpochToGregorian(epoch)) end

@en "EpochToHijri"
@fa "زمان به هجری"
pub func EpochToHijri(epoch: i64): HijriDate: ret GregorianToHijri(EpochToGregorian(epoch)) end

@en "EpochToClockTime"
@fa "زمان به ساعت"
pub func EpochToClockTime(epoch: i64): ClockTime:
    ret ClockTime { hour = time.Hour(epoch), minute = time.Minute(epoch), second = time.Second(epoch) }
end

@en "TodayGregorian"
@fa "امروز میلادی"
pub func TodayGregorian(): GregorianDate: ret EpochToGregorian(time.Now()) end

@en "TodayJalali"
@fa "امروز جلالی"
pub func TodayJalali(): JalaliDate: ret EpochToJalali(time.Now()) end

@en "TodayHijri"
@fa "امروز هجری"
pub func TodayHijri(): HijriDate: ret EpochToHijri(time.Now()) end

@en "NowClockTime"
@fa "ساعت اکنون"
pub func NowClockTime(): ClockTime: ret EpochToClockTime(time.Now()) end

@en "GregorianToUnixUTC"
@fa "میلادی به زمان یونیکس"
pub func GregorianToUnixUTC(d: GregorianDate, hour: int, minute: int, second: int): i64:
    days := GregorianToJDN(d) - _UNIX_EPOCH_JDN
    ret days * _SECONDS_PER_DAY + (hour as i64) * 3600 + (minute as i64) * 60 + (second as i64)
end

@en "JalaliToUnixUTC"
@fa "جلالی به زمان یونیکس"
pub func JalaliToUnixUTC(d: JalaliDate, hour: int, minute: int, second: int): i64:
    ret GregorianToUnixUTC(JalaliToGregorian(d), hour, minute, second)
end

@en "HijriToUnixUTC"
@fa "هجری به زمان یونیکس"
pub func HijriToUnixUTC(d: HijriDate, hour: int, minute: int, second: int): i64:
    ret GregorianToUnixUTC(HijriToGregorian(d), hour, minute, second)
end

@en "FormatGregorian"
@fa "قالب میلادی"
pub func FormatGregorian(d: GregorianDate): str:
    ret "" + d.year + "-" + _pad2(d.month) + "-" + _pad2(d.day)
end

@en "FormatJalali"
@fa "قالب جلالی"
pub func FormatJalali(d: JalaliDate): str:
    ret "" + d.year + "-" + _pad2(d.month) + "-" + _pad2(d.day)
end

@en "FormatHijri"
@fa "قالب هجری"
pub func FormatHijri(d: HijriDate): str:
    ret "" + d.year + "-" + _pad2(d.month) + "-" + _pad2(d.day)
end

@en "FormatClockTime"
@fa "قالب ساعت"
pub func FormatClockTime(t: ClockTime): str:
    ret _pad2(t.hour) + ":" + _pad2(t.minute) + ":" + _pad2(t.second)
end

@en "FormatJalaliLongFa"
@fa "قالب طولانی جلالی"
pub func FormatJalaliLongFa(d: JalaliDate): str:
    ret ("" + d.day) + " " + JalaliMonthNameFa(d.month) + " " + ("" + d.year)
end

@en "FormatHijriLongAr"
@fa "قالب طولانی هجری عربی"
pub func FormatHijriLongAr(d: HijriDate): str:
    ret ("" + d.day) + " " + HijriMonthNameAr(d.month) + " " + ("" + d.year)
end

@en "FormatHijriLongFa"
@fa "قالب طولانی هجری فارسی"
pub func FormatHijriLongFa(d: HijriDate): str:
    ret ("" + d.day) + " " + HijriMonthNameFa(d.month) + " " + ("" + d.year)
end

@en "FormatGregorianLongEn"
@fa "قالب طولانی میلادی"
pub func FormatGregorianLongEn(d: GregorianDate): str:
    ret GregorianMonthNameEn(d.month) + " " + ("" + d.day) + ", " + ("" + d.year)
end
