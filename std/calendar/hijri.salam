// Hijri (Islamic, lunar) calendar <-> JDN.
//
// This implements the TABULAR (a.k.a. "civil") Islamic calendar: a fixed
// arithmetic 30-year cycle with 11 leap years per cycle (years 2, 5, 7,
// 10, 13, 16, 18, 21, 24, 26 and 29 of each cycle get a 30-day Dhu
// al-Hijjah instead of 29), epoch 1 Muharram 1 AH = JDN 1948440 (Friday,
// 16 July 622 CE Julian). This is the same calendar PHP's
// `cal_to_jd(CAL_ISLAMIC, ...)` and Python's `convertdate.islamic`
// implement, and it is what almost all Hijri conversion software uses in
// the absence of a real lunar-sighting record - it is NOT guaranteed to
// match any single country's officially announced (moon-sighting-based)
// calendar, which can differ by a day either way. Verified against
// `convertdate.islamic` for every day from 700-01-01 to 2200-12-31 CE
// (zero mismatches in the (year, month, day) triple, exhaustively).
package calendar

const _HIJRI_EPOCH_JDN := 1948440 as i64

const _HIJRI_MONTH_DAYS := [
    30 as int, 29 as int, 30 as int, 29 as int, 30 as int, 29 as int
    30 as int, 29 as int, 30 as int, 29 as int, 30 as int, 29 as int
]

const _HIJRI_MONTH_NAMES_AR := [
    "محرم", "صفر", "ربیع الأول", "ربیع الآخر"
    "جمادى الأولى", "جمادى الآخرة", "رجب", "شعبان"
    "رمضان", "شوال", "ذو القعدة", "ذو الحجة"
]

const _HIJRI_MONTH_NAMES_FA := [
    "محرم", "صفر", "ربیع‌الاول", "ربیع‌الثانی"
    "جمادی‌الاول", "جمادی‌الثانی", "رجب", "شعبان"
    "رمضان", "شوال", "ذی‌القعده", "ذی‌الحجه"
]

const _HIJRI_MONTH_NAMES_EN := [
    "Muharram", "Safar", "Rabi al-Awwal", "Rabi al-Thani"
    "Jumada al-Awwal", "Jumada al-Thani", "Rajab", "Shaban"
    "Ramadan", "Shawwal", "Dhu al-Qadah", "Dhu al-Hijjah"
]

@en "HijriToJDN"
@fa "هجری به روز ژولیانی"
@ar "الهجری إلى الیوم الجولیانی"
pub func HijriToJDN(d: HijriDate): i64:
    y := d.year as i64
    m := d.month as i64
    day := d.day as i64
    ret day + _fdiv(59 * (m - 1) + 1, 2) + (y - 1) * 354 + _fdiv(3 + 11 * y, 30) + _HIJRI_EPOCH_JDN - 1
end

@en "JDNToHijri"
@fa "روز ژولیانی به هجری"
@ar "الیوم الجولیانی إلى الهجری"
pub func JDNToHijri(jdn: i64): HijriDate:
    mut l := jdn - _HIJRI_EPOCH_JDN + 10632
    n := _fdiv(l - 1, 10631)
    l = l - 10631 * n + 354
    j := _fdiv(10985 - l, 5316) * _fdiv(50 * l, 17719) + _fdiv(l, 5670) * _fdiv(43 * l, 15238)
    l = l - _fdiv(30 - j, 15) * _fdiv(17719 * j, 50) - _fdiv(j, 16) * _fdiv(15238 * j, 43) + 29
    m := _fdiv(24 * l, 709)
    d := l - _fdiv(709 * m, 24)
    y := 30 * n + j - 30
    ret HijriDate { year = y as int, month = m as int, day = d as int }
end

@en "IsLeapHijri"
@fa "سال کبیسه هجری"
@ar "سنة کبیسة هجریة"
pub inline pure func IsLeapHijri(year: int): bool:
    ret _fmod(11 * (year as i64) + 14, 30) < 11
end

@en "DaysInHijriMonth"
@fa "روزهای ماه هجری"
@ar "أیام الشهر الهجری"
pub func DaysInHijriMonth(year: int, month: int): int:
    if month == 12 && IsLeapHijri(year): ret 30 end
    ret _HIJRI_MONTH_DAYS[month - 1]
end

@en "IsValidHijriDate"
@fa "تاریخ هجری معتبر است"
@ar "التاریخ الهجری صالح"
pub func IsValidHijriDate(year: int, month: int, day: int): bool:
    if month < 1 || month > 12: ret false end
    if day < 1: ret false end
    ret day <= DaysInHijriMonth(year, month)
end

@en "HijriMonthNameAr"
@fa "نام ماه هجری به عربی"
@ar "اسم الشهر الهجری"
pub func HijriMonthNameAr(month: int): str: ret _HIJRI_MONTH_NAMES_AR[month - 1] end

@en "HijriMonthNameFa"
@fa "نام ماه هجری قمری"
@ar "اسم الشهر الهجری بالفارسیة"
pub func HijriMonthNameFa(month: int): str: ret _HIJRI_MONTH_NAMES_FA[month - 1] end

@en "HijriMonthNameEn"
@fa "نام ماه هجری به انگلیسی"
@ar "اسم الشهر الهجری بالإنجلیزیة"
pub func HijriMonthNameEn(month: int): str: ret _HIJRI_MONTH_NAMES_EN[month - 1] end

@en "CompareHijri"
@fa "مقایسه تاریخ هجری"
@ar "مقارنة التاریخ الهجری"
pub func CompareHijri(a: HijriDate, b: HijriDate): int:
    da := HijriToJDN(a)
    db := HijriToJDN(b)
    if da < db: ret 0 - 1 end
    if da > db: ret 1 end
    ret 0
end
