@en "chan"
@fa "کانال"
package chan

import mem
import sync

mut sel_mu := sync.NewMutex()
mut sel_cv := sync.NewCondVar()
mut sel_cells := mem.MustAllocateZeroed(16 as u64) as i64*

struct TimerArg:
    pub ch: Chan<i64> = Chan {} as Chan<i64>
    pub cancel: i64* = null
    pub ms: i64 = 0
    pub repeat_: i64 = 0
end

@en "Chan"
@fa "کانال"
pub struct Chan<T>:
    @en "buf"
    @fa "بافر"
    pub buf: T* = null
    @en "ctl"
    @fa "وضعیت درونی"
    pub ctl: i64* = null
    @en "cap"
    @fa "اندازه بافر"
    pub cap: i64 = 0
    @en "zidx"
    @fa "خانه صفر"
    pub zidx: i64 = 0
    @en "mu"
    @fa "قفل"
    pub mu: sync.Mutex = sync.Mutex {}
    @en "not_empty"
    @fa "شرط ناخالی"
    pub not_empty: sync.CondVar = sync.CondVar {}
    @en "not_full"
    @fa "شرط ناپر"
    pub not_full: sync.CondVar = sync.CondVar {}
    @en "taken"
    @fa "شرط برداشت"
    pub taken: sync.CondVar = sync.CondVar {}

    @en "Init"
    @fa "مقداردهی"
    pub func Init(capacity: i64):
        mut n := capacity
        if n < 0: n = 0 end
        this.cap = n
        mut slots := n + 1
        if n == 0: slots = 2 end
        this.zidx = slots - 1
        this.buf = mem.MustAllocateZeroed((slots * (sizeof(T) as i64)) as u64) as T*
        this.ctl = mem.MustAllocateZeroed(64 as u64) as i64*
        this.mu = sync.NewMutex()
        this.not_empty = sync.NewCondVar()
        this.not_full = sync.NewCondVar()
        this.taken = sync.NewCondVar()
    end

    @en "init"
    @fa "مقداردهی"
    pub func init(capacity: i64):
        this.Init(capacity)
    end

    @en "Send"
    @fa "فرستادن"
    pub func Send(v: T): bool:
        ret this.SendDeadline(v, 0 as i64, false)
    end

    @en "send"
    @fa "فرستادن"
    pub func send(v: T): bool:
        ret this.Send(v)
    end

    @en "SendTimeout"
    @fa "فرستادن با مهلت"
    pub func SendTimeout(v: T, ms: i64): bool:
        ret this.SendDeadline(v, ms, true)
    end

    @en "send_timeout"
    @fa "فرستادن با مهلت"
    pub func send_timeout(v: T, ms: i64): bool:
        ret this.SendTimeout(v, ms)
    end

    @en "SendDeadline"
    @fa "فرستادن با موعد"
    pub func SendDeadline(v: T, ms: i64, timed: bool): bool:
        c := this.ctl
        b := this.buf
        sync.Lock(this.mu)
        deadline := sync.NowMs() + ms
        mut expired := false

        mut room := this.cap
        if this.cap == 0: room = 1 end
        until c[3] == 0 and c[2] >= room and not expired:
            if timed:
                left := deadline - sync.NowMs()
                if left <= 0:
                    expired = true
                else:
                    _ := sync.WaitCondTimeout(this.not_full, this.mu, left)
                end
            else:
                sync.WaitCond(this.not_full, this.mu)
            end
        end
        if c[3] != 0 or expired:
            sync.Unlock(this.mu)
            ret false
        end

        if this.cap == 0:
            b[0] = v
            c[2] = 1
            mine := c[4] + 1
            c[4] = mine
            sync.Signal(this.not_empty)
            wake_selectors()
            until c[3] == 0 and c[5] < mine and not expired:
                if timed:
                    left := deadline - sync.NowMs()
                    if left <= 0:
                        expired = true
                    else:
                        _ := sync.WaitCondTimeout(this.taken, this.mu, left)
                    end
                else:
                    sync.WaitCond(this.taken, this.mu)
                end
            end
            if c[5] < mine:
                c[2] = 0
                sync.Signal(this.not_full)
                sync.Unlock(this.mu)
                ret false
            end
            sync.Unlock(this.mu)
            ret true
        end

        b[c[1]] = v
        c[1] = (c[1] + 1) % this.cap
        c[2]++
        sync.Signal(this.not_empty)
        sync.Unlock(this.mu)
        wake_selectors()
        ret true
    end

    @en "send_deadline"
    @fa "فرستادن با موعد"
    pub func send_deadline(v: T, ms: i64, timed: bool): bool:
        ret this.SendDeadline(v, ms, timed)
    end

    @en "Recv"
    @fa "دریافت"
    pub func Recv(ok &: bool): T:
        ret this.RecvDeadline(ok, 0 as i64, false)
    end

    @en "recv"
    @fa "دریافت"
    pub func recv(ok &: bool): T:
        ret this.Recv(ok)
    end

    @en "RecvTimeout"
    @fa "دریافت با مهلت"
    pub func RecvTimeout(ok &: bool, ms: i64): T:
        ret this.RecvDeadline(ok, ms, true)
    end

    @en "recv_timeout"
    @fa "دریافت با مهلت"
    pub func recv_timeout(ok &: bool, ms: i64): T:
        ret this.RecvTimeout(ok, ms)
    end

    @en "RecvDeadline"
    @fa "دریافت با موعد"
    pub func RecvDeadline(ok &: bool, ms: i64, timed: bool): T:
        c := this.ctl
        b := this.buf
        sync.Lock(this.mu)
        deadline := sync.NowMs() + ms
        mut expired := false
        until c[3] == 0 and c[2] <= 0 and not expired:
            if timed:
                left := deadline - sync.NowMs()
                if left <= 0:
                    expired = true
                else:
                    _ := sync.WaitCondTimeout(this.not_empty, this.mu, left)
                end
            else:
                sync.WaitCond(this.not_empty, this.mu)
            end
        end
        if c[2] <= 0:
            ok = false
            sync.Unlock(this.mu)
            ret b[this.zidx]
        end

        mut v := b[c[0]]
        if this.cap == 0:
            v = b[0]
            c[2] = 0
            c[5]++
            sync.Broadcast(this.taken)
        else:
            c[0] = (c[0] + 1) % this.cap
            c[2]--
        end
        ok = true
        sync.Signal(this.not_full)
        sync.Unlock(this.mu)
        wake_selectors()
        ret v
    end

    @en "recv_deadline"
    @fa "دریافت با موعد"
    pub func recv_deadline(ok &: bool, ms: i64, timed: bool): T:
        ret this.RecvDeadline(ok, ms, timed)
    end

    @en "TrySend"
    @fa "کوشش برای فرستادن"
    pub func TrySend(v: T): bool:
        if this.cap == 0:
            ret false
        end
        c := this.ctl
        b := this.buf
        sync.Lock(this.mu)
        if c[3] != 0 or c[2] >= this.cap:
            sync.Unlock(this.mu)
            ret false
        end
        b[c[1]] = v
        c[1] = (c[1] + 1) % this.cap
        c[2]++
        sync.Signal(this.not_empty)
        sync.Unlock(this.mu)
        wake_selectors()
        ret true
    end

    @en "try_send"
    @fa "کوشش برای فرستادن"
    pub func try_send(v: T): bool:
        ret this.TrySend(v)
    end

    @en "TryRecv"
    @fa "کوشش برای دریافت"
    pub func TryRecv(ok &: bool): T:
        c := this.ctl
        b := this.buf
        sync.Lock(this.mu)
        if c[2] <= 0:
            ok = false
            sync.Unlock(this.mu)
            ret b[this.zidx]
        end
        mut v := b[c[0]]
        if this.cap == 0:
            v = b[0]
            c[2] = 0
            c[5]++
            sync.Broadcast(this.taken)
        else:
            c[0] = (c[0] + 1) % this.cap
            c[2]--
        end
        ok = true
        sync.Signal(this.not_full)
        sync.Unlock(this.mu)
        wake_selectors()
        ret v
    end

    @en "try_recv"
    @fa "کوشش برای دریافت"
    pub func try_recv(ok &: bool): T:
        ret this.TryRecv(ok)
    end

    @en "Close"
    @fa "بستن"
    pub func Close():
        c := this.ctl
        sync.Lock(this.mu)
        c[3] = 1
        sync.Broadcast(this.not_empty)
        sync.Broadcast(this.not_full)
        sync.Broadcast(this.taken)
        sync.Unlock(this.mu)
        wake_selectors()
    end

    @en "close"
    @fa "بستن"
    pub func close():
        this.Close()
    end

    @en "IsClosed"
    @fa "بسته است"
    pub func IsClosed(): bool:
        c := this.ctl
        sync.Lock(this.mu)
        v := c[3] != 0
        sync.Unlock(this.mu)
        ret v
    end

    @en "is_closed"
    @fa "بسته است"
    pub func is_closed(): bool:
        ret this.IsClosed()
    end

    @en "Len"
    @fa "طول"
    pub func Len(): i64:
        c := this.ctl
        sync.Lock(this.mu)
        v := c[2]
        sync.Unlock(this.mu)
        ret v
    end

    @en "len"
    @fa "طول"
    pub func len(): i64:
        ret this.Len()
    end

    @en "Capacity"
    @fa "ظرفیت"
    pub func Capacity(): i64: ret this.cap end

    @en "capacity"
    @fa "ظرفیت"
    pub func capacity(): i64: ret this.Capacity() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        sync.DestroyCondVar(this.taken)
        sync.DestroyCondVar(this.not_full)
        sync.DestroyCondVar(this.not_empty)
        sync.Destroy(this.mu)
        mem.Free(this.ctl as void*)
        mem.Free(this.buf as void*)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

@en "Timer"
@fa "زمان‌سنج"
pub struct Timer:
    @en "c"
    @fa "کانال"
    pub c: Chan<i64> = Chan {} as Chan<i64>
    @en "cancel"
    @fa "لغو"
    pub cancel: i64* = null
    @en "arg"
    @fa "آرگومان"
    pub arg: void* = null
    @en "handle"
    @fa "دسته"
    pub handle: i64 = 0
end

func wake_selectors():
    if atomic_load(sel_cells) == 0:
        ret
    end
    sync.Lock(sel_mu)
    sel_cells[1]++
    sync.Broadcast(sel_cv)
    sync.Unlock(sel_mu)
end

func timer_run(ap: TimerArg*):
    a := ap[0]
    mut n := 0 as i64
    until true:
        mut left := a.ms
        until left > 0 as i64 and atomic_load(a.cancel) == 0:
            sync.SleepMs(1)
            left--
        end
        if atomic_load(a.cancel) != 0:
            break
        end
        n++
        a.ch.try_send(n)
        if a.repeat_ == 0:
            break
        end
    end
end

func timer_start(ms: i64, again: i64): Timer:
    mut t := Timer {}
    t.c = Chan {} as Chan<i64>
    t.c.init(1 as i64)
    t.cancel = mem.MustAllocateZeroed(8 as u64) as i64*
    ap := mem.MustAllocateZeroed(sizeof(TimerArg) as u64) as TimerArg*
    ap[0] = TimerArg { ch = t.c, cancel = t.cancel, ms = ms, repeat_ = again }
    t.arg = ap as void*
    t.handle = spawn(timer_run, ap)
    ret t
end

@en "New"
@fa "جدید"
pub func New<T>(capacity: i64): Chan<T>:
    mut c := Chan {} as Chan<T>
    c.init(capacity)
    ret c
end

@en "Send"
@fa "فرستادن"
pub func Send<T>(c: Chan<T>, v: T): bool:
    ret c.send(v)
end

@en "SendTimeout"
@fa "فرستادن با مهلت"
pub func SendTimeout<T>(c: Chan<T>, v: T, ms: i64): bool:
    ret c.send_timeout(v, ms)
end

@en "TrySend"
@fa "کوشش برای فرستادن"
pub func TrySend<T>(c: Chan<T>, v: T): bool:
    ret c.try_send(v)
end

@en "SendAll"
@fa "فرستادن همه"
pub func SendAll<T>(c: Chan<T>, values: Vector<T>): bool:
    mut ok := true
    repeat values.Len() in i:
        if not c.send(values.Get(i)):
            ok = false
            break
        end
    end
    ret ok
end

@en "Recv"
@fa "دریافت"
pub func Recv<T>(c: Chan<T>, ok &: bool): T:
    ret c.recv(ok)
end

@en "RecvTimeout"
@fa "دریافت با مهلت"
pub func RecvTimeout<T>(c: Chan<T>, ok &: bool, ms: i64): T:
    ret c.recv_timeout(ok, ms)
end

@en "TryRecv"
@fa "کوشش برای دریافت"
pub func TryRecv<T>(c: Chan<T>, ok &: bool): T:
    ret c.try_recv(ok)
end

@en "Drain"
@fa "تخلیه"
pub func Drain<T>(c: Chan<T>): Vector<T>:
    mut out := Vector {} as Vector<T>
    mut ok := true
    until true:
        v := c.recv(ok)
        if not ok:
            break
        end
        out.Push(v)
    end
    ret out
end

@en "Take"
@fa "برداشتن"
pub func Take<T>(c: Chan<T>, n: i64): Vector<T>:
    mut out := Vector {} as Vector<T>
    mut ok := true
    mut i := 0 as i64
    until i < n:
        v := c.recv(ok)
        if not ok:
            break
        end
        out.Push(v)
        i++
    end
    ret out
end

@en "Close"
@fa "بستن"
pub func Close<T>(c: Chan<T>):
    c.Close()
end

@en "Len"
@fa "طول"
pub func Len<T>(c: Chan<T>): i64:
    ret c.Len()
end

@en "Capacity"
@fa "ظرفیت"
pub func Capacity<T>(c: Chan<T>): i64:
    ret c.capacity()
end

@en "IsClosed"
@fa "بسته است"
pub func IsClosed<T>(c: Chan<T>): bool:
    ret c.is_closed()
end

@en "After"
@fa "پس از"
pub func After(ms: i64): Timer:
    ret timer_start(ms, 0 as i64)
end

@en "Tick"
@fa "ضربان"
pub func Tick(ms: i64): Timer:
    ret timer_start(ms, 1 as i64)
end

@en "StopTimer"
@fa "توقف زمان‌سنج"
pub func StopTimer(t: Timer):
    atomic_store(t.cancel, 1 as i64)
    join(t.handle)
    t.c.Free()
    mem.Free(t.cancel as void*)
    mem.Free(t.arg)
end

@en "Select"
@fa "گزینش"
pub func Select<T>(cs: Vector<Chan<T>>, v &: T, ms: i64): i64:
    start := sync.NowMs()
    atomic_add(sel_cells, 1 as i64)
    until true:
        sync.Lock(sel_mu)
        seen := sel_cells[1]
        sync.Unlock(sel_mu)
        mut open := 0 as i64
        mut i := 0 as i64
        until i < (cs.Len() as i64):
            c := cs.Get(i as int)
            mut ok := false
            got := c.try_recv(ok)
            if ok:
                v = got
                atomic_add(sel_cells, 0 as i64 - 1)
                ret i
            end
            if not c.is_closed():
                open++
            end
            i++
        end
        if open == 0:
            atomic_add(sel_cells, 0 as i64 - 1)
            ret 0 as i64 - 2
        end
        sync.Lock(sel_mu)
        if sel_cells[1] == seen:
            if ms < 0:
                sync.WaitCond(sel_cv, sel_mu)
            else:
                left := ms - (sync.NowMs() - start)
                if left <= 0:
                    sync.Unlock(sel_mu)
                    atomic_add(sel_cells, 0 as i64 - 1)
                    ret 0 as i64 - 1
                end
                _ := sync.WaitCondTimeout(sel_cv, sel_mu, left)
            end
        end
        sync.Unlock(sel_mu)
    end
end

@en "SelectRecv"
@fa "گزینش دریافت"
pub func SelectRecv<T>(cs: Vector<Chan<T>>, v &: T, ok &: bool, ms: i64): i64:
    idx := Select(cs, v, ms)
    if idx < 0:
        ok = false
        ret idx
    end
    ok = true
    ret idx
end

@en "TrySelect"
@fa "کوشش برای گزینش"
pub func TrySelect<T>(cs: Vector<Chan<T>>, v &: T): i64:
    ret Select(cs, v, 0 as i64)
end

@en "SelectSend"
@fa "گزینش فرستادن"
pub func SelectSend<T>(cs: Vector<Chan<T>>, v: T, ms: i64): i64:
    start := sync.NowMs()
    atomic_add(sel_cells, 1 as i64)
    until true:
        sync.Lock(sel_mu)
        seen := sel_cells[1]
        sync.Unlock(sel_mu)
        mut open := 0 as i64
        mut i := 0 as i64
        until i < (cs.Len() as i64):
            c := cs.Get(i as int)
            if c.try_send(v):
                atomic_add(sel_cells, 0 as i64 - 1)
                ret i
            end
            if not c.is_closed():
                open++
            end
            i++
        end
        if open == 0:
            atomic_add(sel_cells, 0 as i64 - 1)
            ret 0 as i64 - 2
        end
        sync.Lock(sel_mu)
        if sel_cells[1] == seen:
            if ms < 0:
                sync.WaitCond(sel_cv, sel_mu)
            else:
                left := ms - (sync.NowMs() - start)
                if left <= 0:
                    sync.Unlock(sel_mu)
                    atomic_add(sel_cells, 0 as i64 - 1)
                    ret 0 as i64 - 1
                end
                _ := sync.WaitCondTimeout(sel_cv, sel_mu, left)
            end
        end
        sync.Unlock(sel_mu)
    end
end

@en "TrySelectSend"
@fa "کوشش برای گزینش فرستادن"
pub func TrySelectSend<T>(cs: Vector<Chan<T>>, v: T): i64:
    ret SelectSend(cs, v, 0 as i64)
end
