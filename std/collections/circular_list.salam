package collections

@en "CircularList"
@fa "فهرست حلقوی"
pub struct CircularList<T>:
    @en "items"
    @fa "عضوها"
    pub items: Vector<T> = Vector {}
    @en "offset"
    @fa "جابجایی"
    pub offset: int = 0

    @en "Add"
    @fa "افزودن"
    pub func Add(x: T): this.items.Push(x) end
    @en "add"
    @fa "افزودن"
    pub func add(x: T): this.Add(x) end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.items.Len() end
    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.Size() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.items.IsEmpty() end
    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "Get"
    @fa "دریافت"
    pub func Get(i: int): T:
        n := this.items.Len()
        idx := (this.offset + i) % n
        ret this.items.Get(idx)
    end
    @en "get"
    @fa "دریافت"
    pub func get(i: int): T: ret this.Get(i) end

    @en "Rotate"
    @fa "چرخش"
    pub func Rotate(k: int):
        n := this.items.Len()
        if n == 0: ret end
        this.offset = (this.offset + k % n + n) % n
    end
    @en "rotate"
    @fa "چرخش"
    pub func rotate(k: int): this.Rotate(k) end

    @en "Current"
    @fa "فعلی"
    pub func Current(): T: ret this.Get(0) end
    @en "current"
    @fa "فعلی"
    pub func current(): T: ret this.Current() end

    @en "Advance"
    @fa "پیشروی"
    pub func Advance(): this.Rotate(1) end
    @en "advance"
    @fa "پیشروی"
    pub func advance(): this.Advance() end

    @en "ToVector"
    @fa "به بردار"
    pub func ToVector(): Vector<T>:
        mut out := Vector {} as Vector<T>
        n := this.items.Len()
        repeat n in i: out.Push(this.Get(i)) end
        ret out
    end
    @en "to_vector"
    @fa "به بردار"
    pub func to_vector(): Vector<T>: ret this.ToVector() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.items.Free() end
    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end
