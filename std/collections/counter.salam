package collections

@en "Counter"
@fa "شمارنده"
pub struct Counter<K>:
    @en "m"
    @fa "نگاشت"
    pub m: HashMap<K, int> = HashMap {}

    @en "add"
    @fa "افزودن"
    pub func add(k: K): this.m.put(k, this.count(k) + 1) end

    @en "add_n"
    @fa "افزودن چندتایی"
    pub func add_n(k: K, n: int): this.m.put(k, this.count(k) + n) end

    @en "count"
    @fa "شمارش"
    pub func count(k: K): int:
        if this.m.has(k): ret this.m.get(k) end
        ret 0
    end

    @en "distinct"
    @fa "متمایز"
    pub func distinct(): int: ret this.m.size() end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): CounterIter<K>:
        it := CounterIter {} as CounterIter<K> it.inner = this.m.iter()
        ret it
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.m.free() end
end

@en "CounterIter"
@fa "پیمایشگر شمارنده"
pub struct CounterIter<K>:
    @en "inner"
    @fa "پیمایشگر درونی"
    pub inner: MapIter<K, int> = MapIter {}

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.inner.has_next() end

    @en "key"
    @fa "کلید"
    pub func key(): K: ret this.inner.key() end

    @en "value"
    @fa "مقدار"
    pub func value(): int: ret this.inner.value() end

    @en "next"
    @fa "بعدی"
    pub func next(): this.inner.next() end
end
