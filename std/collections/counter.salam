package collections

@en "Counter"
@fa "شمارنده"
pub struct Counter<K>:
    @en "m"
    @fa "نگاشت"
    pub m: HashMap<K, int> = HashMap {}

    @en "Add"
    @fa "افزودن"
    pub func Add(k: K): this.m.Put(k, this.m.GetOr(k, 0) + 1) end
    @en "add"
    @fa "افزودن"
    pub func add(k: K): this.Add(k) end

    @en "Count"
    @fa "شمارش"
    pub func Count(k: K): int: ret this.m.GetOr(k, 0) end
    @en "count"
    @fa "شمارش"
    pub func count(k: K): int: ret this.Count(k) end

    @en "Total"
    @fa "مجموع"
    pub func Total(): int:
        mut sum := 0
        it := this.m.Iter()
        until it.HasNext():
            sum += it.Value()
            it.Next()
        end
        ret sum
    end
    @en "total"
    @fa "مجموع"
    pub func total(): int: ret this.Total() end

    @en "Distinct"
    @fa "یکتا"
    pub func Distinct(): int: ret this.m.Size() end
    @en "distinct"
    @fa "یکتا"
    pub func distinct(): int: ret this.Distinct() end

    @en "Iter"
    @fa "پیمایش"
    pub func Iter(): CounterIter<K>:
        it := CounterIter {} as CounterIter<K>
        it.inner = this.m.Iter()
        ret it
    end
    @en "iter"
    @fa "پیمایش"
    pub func iter(): CounterIter<K>: ret this.Iter() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.m.Free() end
    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "CounterIter"
@fa "پیمایشگر شمارنده"
pub struct CounterIter<K>:
    @en "inner"
    @fa "پیمایشگر درونی"
    pub inner: MapIter<K, int> = MapIter {}

    @en "HasNext"
    @fa "ادامه دارد"
    pub func HasNext(): bool: ret this.inner.HasNext() end
    @en "has_next"
    @fa "ادامه دارد"
    pub func has_next(): bool: ret this.HasNext() end

    @en "Key"
    @fa "کلید"
    pub func Key(): K: ret this.inner.Key() end
    @en "key"
    @fa "کلید"
    pub func key(): K: ret this.Key() end

    @en "Value"
    @fa "مقدار"
    pub func Value(): int: ret this.inner.Value() end
    @en "value"
    @fa "مقدار"
    pub func value(): int: ret this.Value() end

    @en "Next"
    @fa "بعدی"
    pub func Next(): this.inner.Next() end
    @en "next"
    @fa "بعدی"
    pub func next(): this.Next() end
end
