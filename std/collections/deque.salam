package collections

@en "Deque"
@fa "صف دوطرفه"
pub struct Deque<T>:
    @en "front"
    @fa "جلو"
    pub front: Vector<T> = Vector {}
    @en "back"
    @fa "عقب"
    pub back: Vector<T> = Vector {}

    @en "PushFront"
    @fa "افزودن به جلو"
    pub func PushFront(x: T): this.front.Push(x) end
    @en "push_front"
    @fa "افزودن به جلو"
    pub func push_front(x: T): this.PushFront(x) end

    @en "PushBack"
    @fa "افزودن به عقب"
    pub func PushBack(x: T): this.back.Push(x) end
    @en "push_back"
    @fa "افزودن به عقب"
    pub func push_back(x: T): this.PushBack(x) end

    @en "PopFront"
    @fa "برداشتن از جلو"
    pub func PopFront(): T:
        if this.front.IsEmpty():
            until this.back.Len() > 0: this.front.Push(this.back.Pop()) end
        end
        ret this.front.Pop()
    end
    @en "pop_front"
    @fa "برداشتن از جلو"
    pub func pop_front(): T: ret this.PopFront() end

    @en "PopBack"
    @fa "برداشتن از عقب"
    pub func PopBack(): T:
        if this.back.IsEmpty():
            until this.front.Len() > 0: this.back.Push(this.front.Pop()) end
        end
        ret this.back.Pop()
    end
    @en "pop_back"
    @fa "برداشتن از عقب"
    pub func pop_back(): T: ret this.PopBack() end

    @en "Front"
    @fa "جلو"
    pub func Front(): T:
        if this.front.IsEmpty():
            until this.back.Len() > 0: this.front.Push(this.back.Pop()) end
        end
        ret this.front.Last()
    end
    @en "front_val"
    @fa "جلو"
    pub func front_val(): T: ret this.Front() end

    @en "Back"
    @fa "عقب"
    pub func Back(): T:
        if this.back.IsEmpty():
            until this.front.Len() > 0: this.back.Push(this.front.Pop()) end
        end
        ret this.back.Last()
    end
    @en "back_val"
    @fa "عقب"
    pub func back_val(): T: ret this.Back() end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.front.Len() + this.back.Len() end
    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.Size() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.Size() == 0 end
    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "Get"
    @fa "دریافت"
    pub func Get(i: int): T:
        nf := this.front.Len()
        if i < nf: ret this.front.Get(nf - 1 - i) end
        ret this.back.Get(i - nf)
    end
    @en "get"
    @fa "دریافت"
    pub func get(i: int): T: ret this.Get(i) end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.front.Free()
        this.back.Free()
    end
    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end
