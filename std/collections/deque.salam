package collections

@en "Deque"
@fa "صف دوسر"
pub struct Deque<T>:
    @en "front"
    @fa "نیمه ابتدا"
    pub front: Vector<T> = Vector {}
    @en "back"
    @fa "نیمه انتها"
    pub back: Vector<T> = Vector {}

    @en "PushFront"
    @fa "افزودن به جلو"
    pub func PushFront(x: T): this.front.Push(x) end

    @en "PushBack"
    @fa "افزودن به عقب"
    pub func PushBack(x: T): this.back.Push(x) end

    @en "PopFront"
    @fa "برداشتن از جلو"
    pub func PopFront(): T:
        if this.front.IsEmpty():
            until this.back.Len() > 0: this.front.Push(this.back.Pop()) end
        end
        ret this.front.Pop()
    end

    @en "PopBack"
    @fa "برداشتن از عقب"
    pub func PopBack(): T:
        if this.back.IsEmpty():
            until this.front.Len() > 0: this.back.Push(this.front.Pop()) end
        end
        ret this.back.Pop()
    end

    @en "Front"
    @fa "جلو"
    pub func Front(): T:
        if this.front.IsEmpty():
            until this.back.Len() > 0: this.front.Push(this.back.Pop()) end
        end
        ret this.front.Last()
    end

    @en "FrontVal"
    @fa "جلو" "مقدار ابتدا"
    pub func FrontVal(): T: ret this.Front() end

    @en "Back"
    @fa "عقب"
    pub func Back(): T:
        if this.back.IsEmpty():
            until this.front.Len() > 0: this.back.Push(this.front.Pop()) end
        end
        ret this.back.Last()
    end

    @en "BackVal"
    @fa "عقب" "مقدار انتها"
    pub func BackVal(): T: ret this.Back() end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.front.Len() + this.back.Len() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.Size() == 0 end

    @en "Get"
    @fa "دریافت"
    pub func Get(i: int): T:
        nf := this.front.Len()
        if i < nf: ret this.front.Get(nf - 1 - i) end
        ret this.back.Get(i - nf)
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.front.Free()
        this.back.Free()
    end
end
