package collections

@en "HashMap"
@fa "نگاشت درهم"
pub struct HashMap<K, V>:
    @en "keys"
    @fa "کلیدها"
    pub keys: K* = null
    @en "vals"
    @fa "مقدارها"
    pub vals: V* = null
    @en "state"
    @fa "وضعیت خانه‌ها"
    pub state: i8* = null
    @en "cap"
    @fa "ظرفیت"
    pub cap: int = 0
    mask: int = 0
    @en "count"
    @fa "شمار"
    pub count: int = 0
    @en "used"
    @fa "خانه‌های استفاده‌شده"
    pub used: int = 0
    zbuf: V* = null

    pub func _index(k: K): int:
        mask := this.mask
        mut idx := (hash(k) as int) & mask
        mut firstdel := 0 - 1
        kp := this.keys
        stp := this.state
        go := true
        until go:
            st := stp[idx]
            if st == (1 as i8):
                if kp[idx] == k: ret idx end
            else st == (0 as i8):
                if firstdel >= 0: ret firstdel end
                ret idx
            else:
                if firstdel < 0: firstdel = idx end
            end
            idx = (idx + 1) & mask
        end
        ret idx
    end

    pub func _find(k: K): int:
        mask := this.mask
        mut idx := (hash(k) as int) & mask
        kp := this.keys
        stp := this.state
        go := true
        until go:
            st := stp[idx]
            if st == (1 as i8):
                if kp[idx] == k: ret idx end
            else st == (0 as i8):
                ret 0 - 1
            end
            idx = (idx + 1) & mask
        end
        ret 0 - 1
    end

    pub func _resize(newcap: int):
        ok := this.keys
        ov := this.vals
        os := this.state
        oc := this.cap
        nk := mem.MustAllocate((newcap as u64) * sizeof(K)) as K*
        nv := mem.MustAllocate((newcap as u64) * sizeof(V)) as V*
        ns := mem.MustAllocateZeroed(newcap as u64) as i8*
        mask := newcap - 1
        okp := ok
        ovp := ov
        repeat oc in i:
            if os[i] == (1 as i8):
                k := okp[i]
                mut idx := (hash(k) as int) & mask
                until ns[idx] == (0 as i8):
                    idx = (idx + 1) & mask
                end
                ns[idx] = 1 as i8
                nk[idx] = k
                nv[idx] = ovp[i]
            end
        end
        if ok != null: mem.Free(ok as void*) end
        if ov != null: mem.Free(ov as void*) end
        if os != null: mem.Free(os as void*) end
        this.keys = nk
        this.vals = nv
        this.state = ns
        this.cap = newcap
        this.mask = newcap - 1
        this.used = this.count
    end

    @en "Put"
    @fa "قراردادن"
    pub func Put(k: K, v: V):
        if this.cap == 0:
            this._resize(16)
        else:
            if (this.used + 1) * 5 >= this.cap * 3: this._resize(this.cap * 2) end
        end
        idx := this._index(k)
        st := this.state[idx]
        vp := this.vals
        if st == (1 as i8):
            vp[idx] = v
            ret
        end
        this.count++
        if st == (0 as i8): this.used++ end
        this.state[idx] = 1 as i8
        kp := this.keys
        kp[idx] = k
        vp[idx] = v
    end

    @en "put"
    @fa "قراردادن"
    pub func put(k: K, v: V): this.Put(k, v) end

    @en "Insert"
    @fa "درج"
    pub func Insert(k: K, v: V): this.Put(k, v) end

    @en "insert"
    @fa "درج"
    pub func insert(k: K, v: V): this.Insert(k, v) end

    @en "Has"
    @fa "دارد"
    pub func Has(k: K): bool:
        if this.cap == 0: ret false end
        ret this._find(k) >= 0
    end

    @en "has"
    @fa "دارد"
    pub func has(k: K): bool: ret this.Has(k) end

    @en "Get"
    @fa "دریافت"
    pub func Get(k: K): V:
        if this.cap != 0:
            idx := this._find(k)
            if idx >= 0:
                vp := this.vals
                ret vp[idx]
            end
        end
        if this.zbuf == null:
            this.zbuf = mem.MustAllocateZeroed(sizeof(V)) as V*
        end
        zp := this.zbuf
        ret zp[0]
    end

    @en "get"
    @fa "دریافت"
    pub func get(k: K): V: ret this.Get(k) end

    @en "GetOr"
    @fa "دریافت با پیش فرض"
    pub func GetOr(k: K, def: V): V:
        if this.cap == 0: ret def end
        idx := this._find(k)
        if idx >= 0:
            vp := this.vals
            ret vp[idx]
        end
        ret def
    end

    @en "get_or"
    @fa "دریافت با پیش فرض"
    pub func get_or(k: K, def: V): V: ret this.GetOr(k, def) end

    @en "Remove"
    @fa "حذف"
    pub func Remove(k: K): bool:
        if this.cap == 0: ret false end
        idx := this._find(k)
        if idx < 0: ret false end
        this.state[idx] = 2 as i8
        this.count--
        ret true
    end

    @en "remove"
    @fa "حذف"
    pub func remove(k: K): bool: ret this.Remove(k) end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.count end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.Size() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.count == 0 end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "Iter"
    @fa "پیمایشگر"
    pub func Iter(): MapIter<K, V>:
        it := MapIter {} as MapIter<K, V> it.keys = this.keys
        it.vals = this.vals
        it.state = this.state
        it.cap = this.cap
        it.pos = 0
        ret it
    end

    @en "iter"
    @fa "پیمایشگر"
    pub func iter(): MapIter<K, V>: ret this.Iter() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        if this.keys != null: mem.Free(this.keys as void*) end
        if this.vals != null: mem.Free(this.vals as void*) end
        if this.state != null: mem.Free(this.state as void*) end
        if this.zbuf != null: mem.Free(this.zbuf as void*) end
        this.keys = null
        this.vals = null
        this.state = null
        this.zbuf = null
        this.cap = 0
        this.mask = 0
        this.count = 0
        this.used = 0
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end

end

@en "MapIter"
@fa "پیمایشگر نگاشت"
pub struct MapIter<K, V>:
    @en "keys"
    @fa "کلیدها"
    pub keys: K* = null
    @en "vals"
    @fa "مقدارها"
    pub vals: V* = null
    @en "state"
    @fa "وضعیت خانه‌ها"
    pub state: i8* = null
    @en "cap"
    @fa "ظرفیت"
    pub cap: int = 0
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    pub func _seek():
        until this.pos < this.cap:
            if this.state[this.pos] == (1 as i8): ret end
            this.pos++
        end
    end

    @en "HasNext"
    @fa "بعدی دارد"
    pub func HasNext(): bool:
        this._seek()
        ret this.pos < this.cap
    end

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.HasNext() end

    @en "Key"
    @fa "کلید"
    pub func Key(): K:
        this._seek()
        kp := this.keys
        ret kp[this.pos]
    end

    @en "key"
    @fa "کلید"
    pub func key(): K: ret this.Key() end

    @en "Value"
    @fa "مقدار"
    pub func Value(): V:
        this._seek()
        vp := this.vals
        ret vp[this.pos]
    end

    @en "value"
    @fa "مقدار"
    pub func value(): V: ret this.Value() end

    @en "Next"
    @fa "بعدی"
    pub func Next(): this.pos++ end

    @en "next"
    @fa "بعدی"
    pub func next(): this.Next() end


end
