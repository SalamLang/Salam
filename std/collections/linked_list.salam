package collections

@en "LinkedList"
@fa "لیست پیوندی"
pub struct LinkedList<T>:
    @en "vals"
    @fa "مقدارها"
    pub vals: Vector<T> = Vector {}
    @en "nxt"
    @fa "گره‌های بعدی"
    pub nxt: Vector<int> = Vector {}
    @en "prv"
    @fa "گره‌های قبلی"
    pub prv: Vector<int> = Vector {}
    @en "head"
    @fa "نخستین گره"
    pub head: int = 0 - 1
    @en "tail"
    @fa "آخرین گره"
    pub tail: int = 0 - 1
    @en "freed"
    @fa "گره‌های آزادشده"
    pub freed: int = 0 - 1
    @en "count"
    @fa "شمار"
    pub count: int = 0

    pub func _alloc(v: T): int:
        if this.freed >= 0:
            idx := this.freed
            this.freed = this.nxt.Get(idx)
            this.vals.Set(idx, v)
            ret idx
        end
        idx := this.vals.Len()
        this.vals.Push(v)
        this.nxt.Push(0 - 1)
        this.prv.Push(0 - 1)
        ret idx
    end

    @en "push_back"
    @fa "افزودن به انتها"
    pub func push_back(v: T):
        n := this._alloc(v)
        this.nxt.Set(n, 0 - 1)
        this.prv.Set(n, this.tail)
        if this.tail >= 0: this.nxt.Set(this.tail, n) else:
            this.head = n
        end
        this.tail = n
        this.count++
    end

    pub func PushBack(v: T): this.push_back(v) end

    @en "push_front"
    @fa "افزودن به ابتدا"
    pub func push_front(v: T):
        n := this._alloc(v)
        this.prv.Set(n, 0 - 1)
        this.nxt.Set(n, this.head)
        if this.head >= 0: this.prv.Set(this.head, n) else:
            this.tail = n
        end
        this.head = n
        this.count++
    end

    pub func PushFront(v: T): this.push_front(v) end

    pub func _unlink(n: int):
        p := this.prv.Get(n)
        q := this.nxt.Get(n)
        if p >= 0: this.nxt.Set(p, q) else:
            this.head = q
        end
        if q >= 0: this.prv.Set(q, p) else:
            this.tail = p
        end
        this.nxt.Set(n, this.freed)
        this.freed = n
        this.count--
    end

    @en "pop_front"
    @fa "برداشتن از ابتدا"
    pub func pop_front(): T:
        if SALAM_SAFE:
            if this.head < 0: salam_panic("LinkedList.pop_front: empty") end
        end
        n := this.head
        v := this.vals.Get(n)
        this._unlink(n)
        ret v
    end

    pub func PopFront(): T: ret this.pop_front() end

    @en "pop_back"
    @fa "برداشتن از انتها"
    pub func pop_back(): T:
        if SALAM_SAFE:
            if this.tail < 0: salam_panic("LinkedList.pop_back: empty") end
        end
        n := this.tail
        v := this.vals.Get(n)
        this._unlink(n)
        ret v
    end

    pub func PopBack(): T: ret this.pop_back() end

    @en "front_val"
    @fa "مقدار ابتدا"
    pub func FrontVal(): T: ret this.vals.Get(this.head) end

    pub func front_val(): T: ret this.FrontVal() end

    @en "back_val"
    @fa "مقدار انتها"
    pub func BackVal(): T: ret this.vals.Get(this.tail) end

    pub func back_val(): T: ret this.BackVal() end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.Size() end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.count end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.count == 0 end

    @en "get"
    @fa "دریافت"
    pub func get(i: int): T:
        if SALAM_SAFE:
            if i < 0 or i >= this.count: salam_panic("LinkedList.get: index out of bounds") end
        end
        mut cur := this.head
        repeat i:
            cur = this.nxt.Get(cur)
        end
        ret this.vals.Get(cur)
    end

    pub func Get(i: int): T: ret this.get(i) end

    @en "to_vector"
    @fa "تبدیل به بردار"
    pub func to_vector(): Vector<T>:
        mut out := Vector {} as Vector<T>
        mut cur := this.head
        until cur >= 0:
            out.Push(this.vals.Get(cur))
            cur = this.nxt.Get(cur)
        end
        ret out
    end

    pub func ToVector(): Vector<T>: ret this.to_vector() end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.vals.Free()
        this.nxt.Free()
        this.prv.Free()
    end

    pub func Free(): this.free() end
end
