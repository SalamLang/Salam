package collections

@en "OrderedMap"
@fa "نگاشت مرتب"
pub struct OrderedMap:
    @en "keys"
    @fa "کلیدها"
    pub keys: Vector<str> = Vector {}
    @en "vals"
    @fa "مقدارها"
    pub vals: Vector<str> = Vector {}
    @en "idx"
    @fa "جدول نمایه"
    pub idx: HashMap<str, int> = HashMap {}

    @en "IndexOf"
    @fa "نمایه کلید"
    pub func IndexOf(k: str): int: ret this.idx.Get(k) - 1 end

    @en "index_of"
    @fa "نمایه کلید"
    pub func index_of(k: str): int: ret this.IndexOf(k) end

    @en "Len"
    @fa "طول"
    pub func Len(): int: ret this.keys.Len() end

    @en "len"
    @fa "طول"
    pub func len(): int: ret this.Len() end

    @en "Has"
    @fa "دارد"
    pub func Has(k: str): bool: ret this.idx.Get(k) > 0 end

    @en "has"
    @fa "دارد"
    pub func has(k: str): bool: ret this.Has(k) end

    @en "Get"
    @fa "دریافت"
    pub func Get(k: str): str:
        i := this.idx.Get(k) - 1
        if i < 0: ret "" end
        ret this.vals.Get(i)
    end

    @en "get"
    @fa "دریافت"
    pub func get(k: str): str: ret this.Get(k) end

    @en "GetOr"
    @fa "دریافت با پیش فرض"
    pub func GetOr(k: str, def: str): str:
        i := this.idx.Get(k) - 1
        if i < 0: ret def end
        ret this.vals.Get(i)
    end

    @en "get_or"
    @fa "دریافت با پیش فرض"
    pub func get_or(k: str, def: str): str: ret this.GetOr(k, def) end

    @en "Set"
    @fa "تنظیم"
    pub func Set(k: str, v: str): int:
        i := this.idx.Get(k) - 1
        if i >= 0:
            this.vals.Set(i, v)
            ret i
        end
        n := this.keys.Len()
        this.keys.Push(k)
        this.vals.Push(v)
        this.idx.Put(k, n + 1)
        ret n
    end

    @en "set"
    @fa "تنظیم"
    pub func set(k: str, v: str): int: ret this.Set(k, v) end

    @en "KeyAt"
    @fa "کلید در"
    pub func KeyAt(i: int): str:
        if i < 0 or i >= this.keys.Len(): ret "" end
        ret this.keys.Get(i)
    end

    @en "key_at"
    @fa "کلید در"
    pub func key_at(i: int): str: ret this.KeyAt(i) end

    @en "ValAt"
    @fa "مقدار در"
    pub func ValAt(i: int): str:
        if i < 0 or i >= this.vals.Len(): ret "" end
        ret this.vals.Get(i)
    end

    @en "val_at"
    @fa "مقدار در"
    pub func val_at(i: int): str: ret this.ValAt(i) end

    @en "SetAt"
    @fa "تنظیم در"
    pub func SetAt(i: int, v: str):
        if i < 0 or i >= this.vals.Len(): ret end
        this.vals.Set(i, v)
    e
    @en "set_at"
    @fa "تنظیم در"
    pub func set_at(i: int, v: str): this.SetAt(i, v) end
nd

    @en "Remove"
    @fa "حذف"
    pub func Remove(k: str): int:
        i := this.idx.Get(k) - 1
        if i < 0: ret 0 - 1 end
        this.keys.RemoveAt(i)
        this.vals.RemoveAt(i)
        this.idx.Remove(k)
        mut j := i
        until j < this.keys.Len():
            this.idx.Put(this.keys.Get(j), j + 1)
            j++
        end
        ret i
    end

    @en "remove"
    @fa "حذف"
    pub func remove(k: str): int: ret this.Remove(k) end

    @en "CloneKeys"
    @fa "رونوشت کلیدها"
    pub func CloneKeys(): Vector<str>: ret clone(this.keys) end

    @en "clone_keys"
    @fa "رونوشت کلیدها"
    pub func clone_keys(): Vector<str>: ret this.CloneKeys() end

    @en "Iter"
    @fa "پیمایش"
    pub func Iter(): OrderedMapIter:
        mut it := OrderedMapIter {}
        it.keys = this.keys
        it.vals = this.vals
        ret it
    end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): OrderedMapIter: ret this.Iter() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.keys.Free()
        this.vals.Free()
        this.idx.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "OrderedMapIter"
@fa "پیمایشگر نگاشت مرتب"
pub struct OrderedMapIter:
    @en "keys"
    @fa "کلیدها"
    pub keys: Vector<str> = Vector {}
    @en "vals"
    @fa "مقدارها"
    pub vals: Vector<str> = Vector {}
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "HasNext"
    @fa "بعدی دارد"
    pub func HasNext(): bool: ret this.pos < this.keys.Len() end

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.HasNext() end

    @en "Key"
    @fa "کلید"
    pub func Key(): str: ret this.keys.Get(this.pos) end

    @en "key"
    @fa "کلید"
    pub func key(): str: ret this.Key() end

    @en "Value"
    @fa "مقدار"
    pub func Value(): str: ret this.vals.Get(this.pos) end

    @en "value"
    @fa "مقدار"
    pub func value(): str: ret this.Value() end

    @en "Next"
    @fa "بعدی"
    pub func Next(): this.pos++ end

    @en "next"
    @fa "بعدی"
    pub func next(): this.Next() end
end
