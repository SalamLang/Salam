package collections

@en "OrderedMap"
@fa "نگاشت مرتب"
pub struct OrderedMap:
    @en "keys"
    @fa "کلیدها"
    pub keys: Vector<str> = Vector {}
    @en "vals"
    @fa "مقدارها"
    pub vals: Vector<str> = Vector {}
    @en "idx"
    @fa "جدول نمایه"
    pub idx: HashMap<str, int> = HashMap {}

    @en "index_of"
    @fa "نمایه کلید"
    pub func index_of(k: str): int: ret this.idx.get(k) - 1 end

    @en "len"
    @fa "طول"
    pub func len(): int: ret this.keys.len() end

    @en "has"
    @fa "دارد"
    pub func has(k: str): bool: ret this.idx.get(k) > 0 end

    @en "get"
    @fa "دریافت"
    pub func get(k: str): str:
        i := this.idx.get(k) - 1
        if i < 0: ret "" end
        ret this.vals.get(i)
    end

    @en "get_or"
    @fa "دریافت با پیش فرض"
    pub func get_or(k: str, def: str): str:
        i := this.idx.get(k) - 1
        if i < 0: ret def end
        ret this.vals.get(i)
    end

    @en "set"
    @fa "تنظیم"
    pub func set(k: str, v: str): int:
        i := this.idx.get(k) - 1
        if i >= 0:
            this.vals.set(i, v)
            ret i
        end
        n := this.keys.len()
        this.keys.push(k)
        this.vals.push(v)
        this.idx.put(k, n + 1)
        ret n
    end

    @en "key_at"
    @fa "کلید در"
    pub func key_at(i: int): str:
        if i < 0 or i >= this.keys.len(): ret "" end
        ret this.keys.get(i)
    end

    @en "val_at"
    @fa "مقدار در"
    pub func val_at(i: int): str:
        if i < 0 or i >= this.vals.len(): ret "" end
        ret this.vals.get(i)
    end

    @en "set_at"
    @fa "تنظیم در"
    pub func set_at(i: int, v: str):
        if i < 0 or i >= this.vals.len(): ret end
        this.vals.set(i, v)
    end

    @en "remove"
    @fa "حذف"
    pub func remove(k: str): int:
        i := this.idx.get(k) - 1
        if i < 0: ret 0 - 1 end
        this.keys.remove_at(i)
        this.vals.remove_at(i)
        this.idx.remove(k)
        mut j := i
        until j < this.keys.len():
            this.idx.put(this.keys.get(j), j + 1)
            j += 1
        end
        ret i
    end

    @en "clone_keys"
    @fa "رونوشت کلیدها"
    pub func clone_keys(): Vector<str>: ret clone(this.keys) end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): OrderedMapIter:
        mut it := OrderedMapIter {}
        it.keys = this.keys
        it.vals = this.vals
        ret it
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.keys.free()
        this.vals.free()
        this.idx.free()
    end
end

@en "OrderedMapIter"
@fa "پیمایشگر نگاشت مرتب"
pub struct OrderedMapIter:
    @en "keys"
    @fa "کلیدها"
    pub keys: Vector<str> = Vector {}
    @en "vals"
    @fa "مقدارها"
    pub vals: Vector<str> = Vector {}
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.pos < this.keys.len() end

    @en "key"
    @fa "کلید"
    pub func key(): str: ret this.keys.get(this.pos) end

    @en "value"
    @fa "مقدار"
    pub func value(): str: ret this.vals.get(this.pos) end

    @en "next"
    @fa "بعدی"
    pub func next(): this.pos = this.pos + 1 end
end
