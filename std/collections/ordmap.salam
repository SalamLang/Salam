package collections

// OrderedMap - a string to string map that remembers insertion order.
//
// HashMap alone is the wrong tool for configuration data. It answers
// "what is the value of this key" in constant time but it cannot answer
// "what order were these written in", because open addressing iterates
// in bucket order. Formats like .env and INI need both: a lookup by key,
// and a faithful order for expansion (a later entry may reference an
// earlier one) and for writing the file back out.
//
// So this keeps the entries in a pair of vectors, which is what gives
// order, and adds a HashMap from key to position, which is what makes
// lookup O(1) instead of a linear scan. The vectors are an
// implementation detail behind the methods, not something callers index
// into by hand.
//
// Cost: lookup, insert and overwrite are O(1); remove is O(n) because
// the entries after it shift down and their recorded positions move
// with them. That is the right trade for config data, which is read and
// written far more often than it is deleted from.
@en "OrderedMap"
@fa "نگاشت مرتب"
@ar "خریطة مرتبة"
pub struct OrderedMap:
    pub keys: Vector<str> = Vector {}
    pub vals: Vector<str> = Vector {}
    pub idx: HashMap<str, int> = HashMap {}

    // Positions are stored offset by one. A HashMap miss reports the
    // zero value, and without the offset that would be indistinguishable
    // from a genuine hit on the first entry.
    @en "index_of"
    @fa "نمایه کلید"
    @ar "موضع المفتاح"
    pub func index_of(k: str): int: ret this.idx.get(k) - 1 end

    @en "len"
    @fa "طول"
    @ar "طول"
    pub func len(): int: ret this.keys.len() end

    @en "has"
    @fa "دارد"
    @ar "یملک"
    pub func has(k: str): bool: ret this.idx.get(k) > 0 end

    @en "get"
    @fa "دریافت"
    @ar "جلب"
    pub func get(k: str): str:
        i := this.idx.get(k) - 1
        if i < 0: ret "" end
        ret this.vals.get(i)
    end

    @en "get_or"
    @fa "دریافت یا"
    @ar "جلب أو"
    pub func get_or(k: str, def: str): str:
        i := this.idx.get(k) - 1
        if i < 0: ret def end
        ret this.vals.get(i)
    end

    // Overwrites in place, keeping the entry where it already was, or
    // appends a new one. Returns the entry's position either way, so a
    // caller keeping data alongside the map can stay in step with it.
    @en "set"
    @fa "تنظیم"
    @ar "تعیین"
    pub func set(k: str, v: str): int:
        i := this.idx.get(k) - 1
        if i >= 0:
            this.vals.set(i, v)
            ret i
        end
        n := this.keys.len()
        this.keys.push(k)
        this.vals.push(v)
        this.idx.put(k, n + 1)
        ret n
    end

    @en "key_at"
    @fa "کلید در"
    @ar "مفتاح عند"
    pub func key_at(i: int): str:
        if i < 0 || i >= this.keys.len(): ret "" end
        ret this.keys.get(i)
    end

    @en "val_at"
    @fa "مقدار در"
    @ar "قیمة عند"
    pub func val_at(i: int): str:
        if i < 0 || i >= this.vals.len(): ret "" end
        ret this.vals.get(i)
    end

    @en "set_at"
    @fa "تنظیم در"
    @ar "تعیین عند"
    pub func set_at(i: int, v: str):
        if i < 0 || i >= this.vals.len(): ret end
        this.vals.set(i, v)
    end

    // Returns the position that was removed, or -1 if the key was
    // absent. Everything after it slides down one, so their recorded
    // positions are rewritten.
    @en "remove"
    @fa "حذف"
    @ar "إزالة"
    pub func remove(k: str): int:
        i := this.idx.get(k) - 1
        if i < 0: ret 0 - 1 end
        this.keys.remove_at(i)
        this.vals.remove_at(i)
        this.idx.remove(k)
        mut j := i
        until j < this.keys.len():
            this.idx.put(this.keys.get(j), j + 1)
            j += 1
        end
        ret i
    end

    @en "clone_keys"
    @fa "رونوشت کلیدها"
    @ar "نسخ المفاتیح"
    pub func clone_keys(): Vector<str>: ret clone(this.keys) end

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free():
        this.keys.free()
        this.vals.free()
        this.idx.free()
    end
end
