package collections

@en "PriorityQueue"
@fa "صف اولویت"
pub struct PriorityQueue<T>:
    @en "h"
    @fa "هرم"
    pub h: Vector<T> = Vector {}

    func _sift_up(i: int):
        mut c := i
        until c > 0:
            p := (c - 1) / 2
            if this.h.Get(c) < this.h.Get(p):
                t := this.h.Get(c)
                this.h.Set(c, this.h.Get(p))
                this.h.Set(p, t)
                c = p
            else:
                c = 0
            end
        end
    end

    func _sift_down(i: int):
        mut p := i
        n := this.h.Len()
        until true:
            mut s := p
            l := 2 * p + 1
            r := l + 1
            if l < n and this.h.Get(l) < this.h.Get(s): s = l end
            if r < n and this.h.Get(r) < this.h.Get(s): s = r end
            if s == p: ret end
            t := this.h.Get(p)
            this.h.Set(p, this.h.Get(s))
            this.h.Set(s, t)
            p = s
        end
    end

    @en "Push"
    @fa "افزودن"
    pub func Push(x: T):
        this.h.Push(x)
        this._sift_up(this.h.Len() - 1)
    end
    @en "push"
    @fa "افزودن"
    pub func push(x: T): this.Push(x) end

    @en "Peek"
    @fa "مشاهده"
    pub func Peek(): T: ret this.h.Get(0) end
    @en "peek"
    @fa "مشاهده"
    pub func peek(): T: ret this.Peek() end

    @en "Pop"
    @fa "برداشتن"
    pub func Pop(): T:
        top := this.h.Get(0)
        last := this.h.Pop()
        if this.h.Len() > 0:
            this.h.Set(0, last)
            this._sift_down(0)
        end
        ret top
    end
    @en "pop"
    @fa "برداشتن"
    pub func pop(): T: ret this.Pop() end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.h.Len() end
    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.Size() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.h.IsEmpty() end
    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.h.Free() end
    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end
