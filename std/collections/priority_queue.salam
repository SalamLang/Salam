package collections

@en "PriorityQueue"
@fa "صف اولویت دار"
pub struct PriorityQueue<T>:
    @en "h"
    @fa "هرم"
    pub h: Vector<T> = Vector {}

    pub func _swap(i: int, j: int):
        a := this.h.Get(i)
        b := this.h.Get(j)
        this.h.Set(i, b)
        this.h.Set(j, a)
    end

    @en "push"
    @fa "افزودن"
    pub func push(x: T):
        this.h.push(x)
        mut i := this.h.Len() - 1
        mut go := true
        until go:
            if i == 0:
                go = false
            else:
                p := (i - 1) / 2
                if this.h.Get(i) < this.h.Get(p):
                    this._swap(i, p)
                    i = p
                else:
                    go = false
                end
            end
        end
    end

    @en "peek"
    @fa "مشاهده"
    pub func peek(): T: ret this.h.Get(0) end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.h.Len() end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.Size() end
    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.h.Len() == 0 end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.IsEmpty() end
    @en "pop"
    @fa "برداشتن"
    pub func pop(): T:
        if SALAM_SAFE:
            if this.h.Len() == 0: salam_panic("PriorityQueue.pop: empty") end
        end
        n := this.h.Len()
        top := this.h.Get(0)
        last := this.h.pop()
        if n > 1:
            this.h.Set(0, last)
            mut i := 0
            mut go := true
            until go:
                l := 2 * i + 1
                r := 2 * i + 2
                mut sm := i
                if l < this.h.Len() and this.h.Get(l) < this.h.Get(sm): sm = l end
                if r < this.h.Len() and this.h.Get(r) < this.h.Get(sm): sm = r end
                if sm == i: go = false
                else:
                    this._swap(i, sm)
                    i = sm
                end
            end
        end
        ret top
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.h.Free() end
    @en "Free"
    @fa "آزاد"
    pub func Free(): this.Free() end
end
