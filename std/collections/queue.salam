package collections

@en "Queue"
@fa "صف"
pub struct Queue<T>:
    @en "inbox"
    @fa "ورودی‌ها"
    pub inbox: Vector<T> = Vector {}
    @en "outbox"
    @fa "خروجی‌ها"
    pub outbox: Vector<T> = Vector {}

    pub func _shift():
        if this.outbox.len() == 0:
            until this.inbox.len() > 0: this.outbox.push(this.inbox.pop()) end
        end
    end

    @en "enqueue"
    @fa "وارد کردن"
    pub func enqueue(x: T): this.inbox.push(x) end

    @en "dequeue"
    @fa "خارج کردن"
    pub func dequeue(): T:
        this._shift()
        ret this.outbox.pop()
    end

    @en "peek"
    @fa "مشاهده"
    pub func peek(): T:
        this._shift()
        ret this.outbox.last()
    end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.inbox.len() + this.outbox.len() end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): QueueIter<T>:
        it := QueueIter {} as QueueIter<T> it.outbox = this.outbox
        it.inbox = this.inbox
        ret it
    end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.size() == 0 end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.inbox.free()
        this.outbox.free()
    end
end

@en "QueueIter"
@fa "پیمایشگر صف"
pub struct QueueIter<T>:
    @en "outbox"
    @fa "خروجی‌ها"
    pub outbox: Vector<T> = Vector {}
    @en "inbox"
    @fa "ورودی‌ها"
    pub inbox: Vector<T> = Vector {}
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.pos < this.outbox.len() + this.inbox.len() end

    @en "value"
    @fa "مقدار"
    pub func value(): T:
        n := this.outbox.len()
        if this.pos < n: ret this.outbox.get(n - 1 - this.pos) end
        ret this.inbox.get(this.pos - n)
    end

    @en "next"
    @fa "بعدی"
    pub func next(): this.pos = this.pos + 1 end
end
