package collections

@en "Queue"
@fa "صف"
pub struct Queue<T>:
    pub inbox: Vector<T> = Vector {}
    pub outbox: Vector<T> = Vector {}

    pub func _shift():
        if this.outbox.len() == 0:
            until this.inbox.len() > 0: this.outbox.push(this.inbox.pop()) end
        end
    end

    @en "enqueue"
    @fa "وارد کردن"
    pub func enqueue(x: T): this.inbox.push(x) end

    @en "dequeue"
    @fa "خارج کردن"
    pub func dequeue(): T:
        this._shift()
        ret this.outbox.pop()
    end

    @en "peek"
    @fa "مشاهده"
    pub func peek(): T:
        this._shift()
        ret this.outbox.last()
    end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.inbox.len() + this.outbox.len() end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.size() == 0 end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.inbox.free()
        this.outbox.free()
    end
end
