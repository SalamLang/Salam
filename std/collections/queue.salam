package collections

@en "Queue"
@fa "صف"
pub struct Queue<T>:
    @en "inbox"
    @fa "ورودی‌ها"
    pub inbox: Vector<T> = Vector {}
    @en "outbox"
    @fa "خروجی‌ها"
    pub outbox: Vector<T> = Vector {}

    pub func _shift():
        if this.outbox.Len() == 0:
            until this.inbox.Len() > 0: this.outbox.Push(this.inbox.Pop()) end
        end
    end

    @en "Enqueue"
    @fa "وارد کردن"
    pub func Enqueue(x: T): this.inbox.Push(x) end

    @en "enqueue"
    @fa "وارد کردن"
    pub func enqueue(x: T): this.Enqueue(x) end

    @en "Dequeue"
    @fa "خارج کردن"
    pub func Dequeue(): T:
        this._shift()
        ret this.outbox.Pop()
    end

    @en "dequeue"
    @fa "خارج کردن"
    pub func dequeue(): T: ret this.Dequeue() end

    @en "Peek"
    @fa "مشاهده"
    pub func Peek(): T:
        this._shift()
        ret this.outbox.Last()
    end

    @en "peek"
    @fa "مشاهده"
    pub func peek(): T: ret this.Peek() end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.inbox.Len() + this.outbox.Len() end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.Size() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.Size() == 0 end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "Iter"
    @fa "پیمایش"
    pub func Iter(): QueueIter<T>:
        it := QueueIter {} as QueueIter<T>
        it.outbox = this.outbox
        it.inbox = this.inbox
        ret it
    end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): QueueIter<T>: ret this.Iter() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.inbox.Free()
        this.outbox.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "QueueIter"
@fa "پیمایشگر صف"
pub struct QueueIter<T>:
    @en "outbox"
    @fa "خروجی‌ها"
    pub outbox: Vector<T> = Vector {}
    @en "inbox"
    @fa "ورودی‌ها"
    pub inbox: Vector<T> = Vector {}
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "HasNext"
    @fa "بعدی دارد"
    pub func HasNext(): bool: ret this.pos < this.outbox.Len() + this.inbox.Len() end

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.HasNext() end

    @en "Value"
    @fa "مقدار"
    pub func Value(): T:
        n := this.outbox.Len()
        if this.pos < n: ret this.outbox.Get(n - 1 - this.pos) end
        ret this.inbox.Get(this.pos - n)
    end

    @en "value"
    @fa "مقدار"
    pub func value(): T: ret this.Value() end

    @en "Next"
    @fa "بعدی"
    pub func Next(): this.pos++ end

    @en "next"
    @fa "بعدی"
    pub func next(): this.Next() end
end
