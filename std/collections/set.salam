package collections

@en "Set"
@fa "مجموعه"
pub struct Set<T>:
    @en "m"
    @fa "نگاشت"
    pub m: HashMap<T, bool> = HashMap {}

    @en "Add"
    @fa "افزودن"
    pub func Add(x: T): this.m.Put(x, true) end

    @en "add"
    @fa "افزودن"
    pub func add(x: T): this.Add(x) end

    @en "Has"
    @fa "دارد"
    pub func Has(x: T): bool: ret this.m.Has(x) end

    @en "has"
    @fa "دارد"
    pub func has(x: T): bool: ret this.Has(x) end

    @en "Remove"
    @fa "حذف"
    pub func Remove(x: T): bool: ret this.m.Remove(x) end

    @en "remove"
    @fa "حذف"
    pub func remove(x: T): bool: ret this.Remove(x) end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.m.Size() end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.Size() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.m.IsEmpty() end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "Iter"
    @fa "پیمایش"
    pub func Iter(): SetIter<T>:
        it := SetIter {} as SetIter<T>
        it.inner = this.m.Iter()
        ret it
    end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): SetIter<T>: ret this.Iter() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.m.Free() end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "SetIter"
@fa "پیمایشگر مجموعه"
pub struct SetIter<T>:
    @en "inner"
    @fa "پیمایشگر درونی"
    pub inner: MapIter<T, bool> = MapIter {}

    @en "HasNext"
    @fa "بعدی دارد"
    pub func HasNext(): bool: ret this.inner.HasNext() end

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.HasNext() end

    @en "Value"
    @fa "مقدار"
    pub func Value(): T: ret this.inner.Key() end

    @en "value"
    @fa "مقدار"
    pub func value(): T: ret this.Value() end

    @en "Next"
    @fa "بعدی"
    pub func Next(): this.inner.Next() end

    @en "next"
    @fa "بعدی"
    pub func next(): this.Next() end
end
