package collections

@en "Set"
@fa "مجموعه"
pub struct Set<T>:
    @en "m"
    @fa "نگاشت"
    pub m: HashMap<T, bool> = HashMap {}

    @en "add"
    @fa "افزودن"
    pub func add(x: T): this.m.put(x, true) end

    @en "has"
    @fa "دارد"
    pub func has(x: T): bool: ret this.m.has(x) end

    @en "remove"
    @fa "حذف"
    pub func remove(x: T): bool: ret this.m.remove(x) end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.m.size() end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.m.is_empty() end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): SetIter<T>:
        it := SetIter {} as SetIter<T> it.inner = this.m.iter()
        ret it
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.m.free() end
end

@en "SetIter"
@fa "پیمایشگر مجموعه"
pub struct SetIter<T>:
    @en "inner"
    @fa "پیمایشگر درونی"
    pub inner: MapIter<T, bool> = MapIter {}

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.inner.has_next() end

    @en "value"
    @fa "مقدار"
    pub func value(): T: ret this.inner.key() end

    @en "next"
    @fa "بعدی"
    pub func next(): this.inner.next() end
end
