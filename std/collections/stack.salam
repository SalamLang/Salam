package collections

@en "Stack"
@fa "پشته"
pub struct Stack<T>:
    @en "items"
    @fa "عضوها"
    pub items: Vector<T> = Vector {}

    @en "Push"
    @fa "افزودن"
    pub func Push(x: T): this.items.Push(x) end

    @en "push"
    @fa "افزودن"
    pub func push(x: T): this.Push(x) end

    @en "Pop"
    @fa "برداشتن"
    pub func Pop(): T: ret this.items.Pop() end

    @en "pop"
    @fa "برداشتن"
    pub func pop(): T: ret this.Pop() end

    @en "Peek"
    @fa "مشاهده"
    pub func Peek(): T: ret this.items.Last() end

    @en "peek"
    @fa "مشاهده"
    pub func peek(): T: ret this.Peek() end

    @en "Size"
    @fa "اندازه"
    pub func Size(): int: ret this.items.Len() end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.Size() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.items.IsEmpty() end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "Clear"
    @fa "پاک‌سازی"
    pub func Clear(): this.items.Clear() end

    @en "clear"
    @fa "پاک‌سازی"
    pub func clear(): this.Clear() end

    @en "Iter"
    @fa "پیمایش"
    pub func Iter(): StackIter<T>:
        it := StackIter {} as StackIter<T>
        it.items = this.items
        ret it
    end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): StackIter<T>: ret this.Iter() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.items.Free() end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "StackIter"
@fa "پیمایشگر پشته"
pub struct StackIter<T>:
    @en "items"
    @fa "عضوها"
    pub items: Vector<T> = Vector {}
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "HasNext"
    @fa "ادامه دارد"
    pub func HasNext(): bool: ret this.pos < this.items.Len() end

    @en "has_next"
    @fa "ادامه دارد"
    pub func has_next(): bool: ret this.HasNext() end

    @en "Value"
    @fa "مقدار"
    pub func Value(): T: ret this.items.Get(this.pos) end

    @en "value"
    @fa "مقدار"
    pub func value(): T: ret this.Value() end

    @en "Next"
    @fa "بعدی"
    pub func Next(): this.pos++ end

    @en "next"
    @fa "بعدی"
    pub func next(): this.Next() end
end
