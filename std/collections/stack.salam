package collections

@en "Stack"
@fa "پشته"
pub struct Stack<T>:
    @en "items"
    @fa "عضوها"
    pub items: Vector<T> = Vector {}

    @en "push"
    @fa "افزودن"
    pub func push(x: T): this.items.push(x) end

    @en "pop"
    @fa "برداشتن"
    pub func pop(): T: ret this.items.pop() end

    @en "peek"
    @fa "مشاهده"
    pub func peek(): T: ret this.items.last() end

    @en "size"
    @fa "اندازه"
    pub func size(): int: ret this.items.len() end

    @en "iter"
    @fa "پیمایش"
    pub func iter(): StackIter<T>:
        it := StackIter {} as StackIter<T> it.items = this.items
        ret it
    end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.items.is_empty() end

    @en "clear"
    @fa "پاک‌سازی"
    pub func clear(): this.items.clear() end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.items.free() end
end

@en "StackIter"
@fa "پیمایشگر پشته"
pub struct StackIter<T>:
    @en "items"
    @fa "عضوها"
    pub items: Vector<T> = Vector {}
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.pos < this.items.len() end

    @en "value"
    @fa "مقدار"
    pub func value(): T: ret this.items.get(this.pos) end

    @en "next"
    @fa "بعدی"
    pub func next(): this.pos = this.pos + 1 end
end
