package collections

@en "Vector"
@fa "بردار"
pub struct Vector<T>:
    pub data: T* = null
    count: int = 0
    capacity: int = 0

    @en "reserve"
    @fa "رزرو"
    pub func reserve(need: int):
        if need <= this.capacity: ret end
        mut c := this.capacity
        if c == 0: c = 4 end
        until c < need: c = c * 2 end
        this.data = mem.Reallocate(this.data as void*, (c as u64) * sizeof(T)) as T*
        this.capacity = c
    end

    @en "push"
    @fa "افزودن"
    pub func push(x: T):
        this.reserve(this.count + 1)
        d := this.data
        d[this.count] = x
        this.count += 1
    end

    @en "pop"
    @fa "برداشتن"
    pub func pop(): T:
        if SALAM_SAFE:
            if this.count <= 0: salam_panic("Vector.pop: empty") end
        end
        this.count -= 1
        d := this.data
        ret d[this.count]
    end

    @en "get"
    @fa "دریافت"
    pub func get(i: int): T:
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.get: index out of bounds")
            end
        end
        d := this.data
        ret d[i]
    end

    @en "ref"
    @fa "ارجاع"
    pub func ref(i: int): T*:
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.ref: index out of bounds")
            end
        end
        ret (this.data as i64 + (i as i64) * (sizeof(T) as i64)) as T*
    end

    @en "set"
    @fa "تنظیم"
    pub func set(i: int, x: T):
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.set: index out of bounds")
            end
        end
        d := this.data
        d[i] = x
    end

    @en "resize_set"
    @fa "تنظیم با تغییر اندازه"
    pub func resize_set(i: int, x: T):
        if SALAM_SAFE:
            if i < 0: salam_panic("Vector.resize_set: negative index") end
        end
        if i >= this.count:
            this.reserve(i + 1)
            this.count = i + 1
        end
        d := this.data
        d[i] = x
    end

    @en "zeros"
    @fa "صفرها"
    pub func zeros(n: int):
        if n <= 0: ret end
        if this.data != null: mem.Free(this.data as void*) end
        this.data = mem.AllocateZeroed((n as u64) * sizeof(T)) as T*
        this.capacity = n
        this.count = n
    end

    @en "alloc"
    @fa "تخصیص"
    pub func alloc(n: int):
        if n <= 0:
            this.count = 0
            ret
        end
        if this.data != null: mem.Free(this.data as void*) end
        this.data = mem.Allocate((n as u64) * sizeof(T)) as T*
        this.capacity = n
        this.count = n
    end

    @en "len"
    @fa "طول"
    pub func len(): int: ret this.count end

    @en "cap"
    @fa "ظرفیت"
    pub func cap(): int: ret this.capacity end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.count == 0 end

    @en "first"
    @fa "اول"
    pub func first(): T: ret this.get(0) end

    @en "last"
    @fa "آخر"
    pub func last(): T: ret this.get(this.count - 1) end

    @en "clear"
    @fa "پاک‌سازی"
    pub func clear(): this.count = 0 end

    @en "insert"
    @fa "درج"
    pub func insert(i: int, x: T):
        if SALAM_SAFE:
            if i < 0 || i > this.count: salam_panic("Vector.insert: index out of bounds") end
        end
        this.reserve(this.count + 1)
        d := this.data
        mut j := this.count
        until j > i:
            d[j] = d[j - 1]
            j -= 1
        end
        d[i] = x
        this.count += 1
    end

    @en "remove_at"
    @fa "حذف در"
    pub func remove_at(i: int): T:
        if SALAM_SAFE:
            if i < 0 || i >= this.count: salam_panic("Vector.remove_at: index out of bounds") end
        end
        d := this.data
        out := d[i]
        mut j := i
        until j < this.count - 1:
            d[j] = d[j + 1]
            j += 1
        end
        this.count -= 1
        ret out
    end

    @en "operator_index"
    @fa "عملگر اندیس"
    pub func operator_index(i: int): T:
        ret this.get(i)
    end

    @en "operator_index_set"
    @fa "تنظیم عملگر اندیس"
    pub func operator_index_set(i: int, x: T):
        this.set(i, x)
    end

    @en "iter"
    @fa "پیمایشگر"
    pub func iter(): VectorIter<T>:
        it := VectorIter {} as VectorIter<T> it.data = this.data
        it.len = this.count
        it.pos = 0
        ret it
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        if this.data != null: mem.Free(this.data as void*) end
        this.data = null
        this.count = 0
        this.capacity = 0
    end
end

@en "VectorIter"
@fa "پیمایشگر بردار"
pub struct VectorIter<T>:
    pub data: T* = null
    pub len: int = 0
    pub pos: int = 0

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.pos < this.len end

    @en "value"
    @fa "مقدار"
    pub func value(): T:
        d := this.data
        ret d[this.pos]
    end

    @en "next"
    @fa "بعدی"
    pub func next(): this.pos = this.pos + 1 end
end
