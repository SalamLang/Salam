package collections

@en "Vector"
@fa "بردار"
pub struct Vector<T>:
    @en "data"
    @fa "داده"
    pub data: T* = null
    count: int = 0
    capacity: int = 0

    @en "Reserve"
    @fa "رزرو"
    pub func Reserve(need: int):
        if need <= this.capacity: ret end
        mut c := this.capacity as i64
        if c == 0: c = 4 end
        want := need as i64
        until c < want: c *= 2 end
        if c > 2147483647: c = 2147483647 end
        this.data = mem.MustReallocate(this.data as void*, (c as u64) * sizeof(T)) as T*
        this.capacity = c as int
    end

    @en "Push"
    @fa "افزودن"
    pub func Push(x: T):
        c := this.count
        if c < this.capacity:
            d := this.data
            d[c] = x
            this.count = c + 1
            ret
        end
        if c >= 2147483647: salam_panic("Vector.push: too many elements") end
        this.Reserve(c + 1)
        d := this.data
        d[c] = x
        this.count = c + 1
    end

    @en "Pop"
    @fa "برداشتن"
    pub func Pop(): T:
        if SALAM_SAFE:
            if this.count <= 0: salam_panic("Vector.pop: empty") end
        end
        this.count--
        d := this.data
        ret d[this.count]
    end

    @en "Get"
    @fa "دریافت"
    pub func Get(i: int): T:
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.get: index out of bounds")
            end
        end
        d := this.data
        ret d[i]
    end

    @en "Ref"
    @fa "ارجاع"
    pub func Ref(i: int): T*:
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.ref: index out of bounds")
            end
        end
        ret (this.data as i64 + (i as i64) * (sizeof(T) as i64)) as T*
    end

    @en "Set"
    @fa "تنظیم"
    pub func Set(i: int, x: T):
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.set: index out of bounds")
            end
        end
        d := this.data
        d[i] = x
    end

    @en "ResizeSet"
    @fa "تنظیم با تغییر اندازه"
    pub func ResizeSet(i: int, x: T):
        if SALAM_SAFE:
            if i < 0: salam_panic("Vector.resize_set: negative index") end
        end
        if i == this.count:
            this.Push(x)
            ret
        end
        if i > this.count:
            if i >= 2147483647: salam_panic("Vector.resize_set: too many elements") end
            this.Reserve(i + 1)
            this.count = i + 1
        end
        d := this.data
        d[i] = x
    end

    @en "Zeros"
    @fa "صفرها" "صفر"
    pub func Zeros(n: int):
        if n <= 0:
            this.count = 0
            ret
        end
        if this.capacity < n:
            if this.data != null: mem.Free(this.data as void*) end
            this.data = mem.MustAllocateZeroed((n as u64) * sizeof(T)) as T*
            this.capacity = n
        else:
            mem.Set(this.data as void*, 0, (n as u64) * sizeof(T))
        end
        this.count = n
    end

    @en "Alloc"
    @fa "تخصیص"
    pub func Alloc(n: int):
        if n <= 0:
            this.count = 0
            ret
        end
        if this.capacity < n:
            if this.data != null: mem.Free(this.data as void*) end
            this.data = mem.MustAllocate((n as u64) * sizeof(T)) as T*
            this.capacity = n
        end
        this.count = n
    end

    @en "Len"
    @fa "طول"
    pub func Len(): int: ret this.count end

    @en "Cap"
    @fa "ظرفیت"
    pub func Cap(): int: ret this.capacity end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.count == 0 end

    @en "First"
    @fa "اول" "اولین"
    pub func First(): T: ret this.Get(0) end

    @en "Last"
    @fa "آخر" "آخرین"
    pub func Last(): T: ret this.Get(this.count - 1) end

    @en "Clear"
    @fa "پاک‌سازی" "پاک کردن"
    pub func Clear(): this.count = 0 end

    @en "Insert"
    @fa "درج"
    pub func Insert(i: int, x: T):
        if SALAM_SAFE:
            if i < 0 or i > this.count: salam_panic("Vector.insert: index out of bounds") end
        end
        if i == this.count:
            this.Push(x)
            ret
        end
        if this.count >= 2147483647: salam_panic("Vector.insert: too many elements") end
        this.Reserve(this.count + 1)
        d := this.data
        mem.MemMove((d as u64 + ((i + 1) as u64) * sizeof(T)) as void*, (d as u64 + (i as u64) * sizeof(T)) as void*, ((this.count - i) as u64) * sizeof(T))
        d[i] = x
        this.count++
    end

    @en "RemoveAt"
    @fa "حذف در" "حذف از"
    pub func RemoveAt(i: int): T:
        if SALAM_SAFE:
            if i < 0 or i >= this.count: salam_panic("Vector.remove_at: index out of bounds") end
        end
        d := this.data
        out := d[i]
        n := this.count - 1 - i
        if n > 0:
            mem.MemMove((d as u64 + (i as u64) * sizeof(T)) as void*, (d as u64 + ((i + 1) as u64) * sizeof(T)) as void*, (n as u64) * sizeof(T))
        end
        this.count--
        ret out
    end

    @en "operator_index"
    @fa "عملگر اندیس"
    pub func operator_index(i: int): T:
        ret this.Get(i)
    end

    @en "operator_index_set"
    @fa "تنظیم عملگر اندیس"
    pub func operator_index_set(i: int, x: T):
        this.Set(i, x)
    end

    @en "Iter"
    @fa "پیمایشگر"
    pub func Iter(): VectorIter<T>:
        it := VectorIter {} as VectorIter<T> it.data = this.data
        it.len = this.count
        it.pos = 0
        ret it
    end

    @en "Free"
    @fa "آزادسازی" "آزاد"
    pub func Free():
        if this.data != null: mem.Free(this.data as void*) end
        this.data = null
        this.count = 0
        this.capacity = 0
    end

end

@en "VectorIter"
@fa "پیمایشگر بردار"
pub struct VectorIter<T>:
    @en "data"
    @fa "داده"
    pub data: T* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "HasNext"
    @fa "بعدی دارد" "ادامه دارد"
    pub func HasNext(): bool: ret this.pos < this.len end

    @en "Value"
    @fa "مقدار"
    pub func Value(): T:
        d := this.data
        ret d[this.pos]
    end

    @en "Next"
    @fa "بعدی"
    pub func Next(): this.pos++ end

end
