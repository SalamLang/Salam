package collections

@en "Vector"
@fa "بردار"
pub struct Vector<T>:
    @en "data"
    @fa "داده"
    pub data: T* = null
    count: int = 0
    capacity: int = 0

    @en "reserve"
    @fa "رزرو"
    pub func reserve(need: int):
        if need <= this.capacity: ret end
        mut c := this.capacity
        if c == 0: c = 4 end
        until c < need: c *= 2 end
        this.data = mem.MustReallocate(this.data as void*, (c as u64) * sizeof(T)) as T*
        this.capacity = c
    end

    @en "push"
    @fa "افزودن"
    pub func push(x: T):
        c := this.count
        if c < this.capacity:
            d := this.data
            d[c] = x
            this.count = c + 1
            ret
        end
        this.Reserve(c + 1)
        d := this.data
        d[c] = x
        this.count = c + 1
    end

    @en "pop"
    @fa "برداشتن"
    pub func pop(): T:
        if SALAM_SAFE:
            if this.count <= 0: salam_panic("Vector.pop: empty") end
        end
        this.count--
        d := this.data
        ret d[this.count]
    end

    @en "get"
    @fa "دریافت"
    pub func get(i: int): T:
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.get: index out of bounds")
            end
        end
        d := this.data
        ret d[i]
    end

    @en "ref"
    @fa "ارجاع"
    pub func ref(i: int): T*:
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.ref: index out of bounds")
            end
        end
        ret (this.data as i64 + (i as i64) * (sizeof(T) as i64)) as T*
    end

    @en "set"
    @fa "تنظیم"
    pub func set(i: int, x: T):
        if SALAM_SAFE:
            if (i as u32) >= (this.count as u32):
                salam_panic("Vector.set: index out of bounds")
            end
        end
        d := this.data
        d[i] = x
    end

    @en "resize_set"
    @fa "تنظیم با تغییر اندازه"
    pub func resize_set(i: int, x: T):
        if SALAM_SAFE:
            if i < 0: salam_panic("Vector.resize_set: negative index") end
        end
        if i == this.count:
            this.Push(x)
            ret
        end
        if i > this.count:
            this.Reserve(i + 1)
            this.count = i + 1
        end
        d := this.data
        d[i] = x
    end

    @en "zeros"
    @fa "صفرها"
    pub func zeros(n: int):
        if n <= 0:
            this.count = 0
            ret
        end
        if this.capacity < n:
            if this.data != null: mem.Free(this.data as void*) end
            this.data = mem.MustAllocateZeroed((n as u64) * sizeof(T)) as T*
            this.capacity = n
        else:
            mem.Set(this.data as void*, 0, (n as u64) * sizeof(T))
        end
        this.count = n
    end

    @en "alloc"
    @fa "تخصیص"
    pub func alloc(n: int):
        if n <= 0:
            this.count = 0
            ret
        end
        if this.capacity < n:
            if this.data != null: mem.Free(this.data as void*) end
            this.data = mem.MustAllocate((n as u64) * sizeof(T)) as T*
            this.capacity = n
        end
        this.count = n
    end

    @en "len"
    @fa "طول"
    pub func len(): int: ret this.count end

    @en "cap"
    @fa "ظرفیت"
    pub func cap(): int: ret this.capacity end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool: ret this.count == 0 end

    @en "first"
    @fa "اول"
    pub func first(): T: ret this.Get(0) end

    @en "last"
    @fa "آخر"
    pub func last(): T: ret this.Get(this.count - 1) end

    @en "clear"
    @fa "پاک‌سازی"
    pub func clear(): this.count = 0 end

    @en "insert"
    @fa "درج"
    pub func insert(i: int, x: T):
        if SALAM_SAFE:
            if i < 0 or i > this.count: salam_panic("Vector.insert: index out of bounds") end
        end
        if i == this.count:
            this.Push(x)
            ret
        end
        this.Reserve(this.count + 1)
        d := this.data
        mem.MemMove((d as u64 + ((i + 1) as u64) * sizeof(T)) as void*, (d as u64 + (i as u64) * sizeof(T)) as void*, ((this.count - i) as u64) * sizeof(T))
        d[i] = x
        this.count++
    end

    @en "remove_at"
    @fa "حذف در"
    pub func remove_at(i: int): T:
        if SALAM_SAFE:
            if i < 0 or i >= this.count: salam_panic("Vector.remove_at: index out of bounds") end
        end
        d := this.data
        out := d[i]
        n := this.count - 1 - i
        if n > 0:
            mem.MemMove((d as u64 + (i as u64) * sizeof(T)) as void*, (d as u64 + ((i + 1) as u64) * sizeof(T)) as void*, (n as u64) * sizeof(T))
        end
        this.count--
        ret out
    end

    @en "operator_index"
    @fa "عملگر اندیس"
    pub func operator_index(i: int): T:
        ret this.Get(i)
    end

    @en "operator_index_set"
    @fa "تنظیم عملگر اندیس"
    pub func operator_index_set(i: int, x: T):
        this.Set(i, x)
    end

    @en "iter"
    @fa "پیمایشگر"
    pub func iter(): VectorIter<T>:
        it := VectorIter {} as VectorIter<T> it.data = this.data
        it.len = this.count
        it.pos = 0
        ret it
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        if this.data != null: mem.Free(this.data as void*) end
        this.data = null
        this.count = 0
        this.capacity = 0
    end
    @en "Reserve"
    @fa "رزرو"
    pub func Reserve(need: int): this.Reserve(need) end

    @en "Push"
    @fa "افزودن"
    pub func Push(x: T): this.Push(x) end

    @en "Pop"
    @fa "برداشتن"
    pub func Pop(): T: ret this.Pop() end

    @en "Get"
    @fa "دریافت"
    pub func Get(i: int): T: ret this.Get(i) end

    @en "Ref"
    @fa "ارجاع"
    pub func Ref(i: int): T*: ret this.Ref(i) end

    @en "Set"
    @fa "تنظیم"
    pub func Set(i: int, x: T): this.Set(i, x) end

    @en "ResizeSet"
    @fa "تنظیم با تغییر اندازه"
    pub func ResizeSet(i: int, x: T): this.resize_set(i, x) end

    @en "Zeros"
    @fa "صفر"
    pub func Zeros(n: int): this.zeros(n) end

    @en "Alloc"
    @fa "تخصیص"
    pub func Alloc(n: int): this.Alloc(n) end

    @en "Len"
    @fa "طول"
    pub func Len(): int: ret this.Len() end

    @en "Cap"
    @fa "ظرفیت"
    pub func Cap(): int: ret this.Cap() end

    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.IsEmpty() end

    @en "First"
    @fa "اولین"
    pub func First(): T: ret this.First() end

    @en "Last"
    @fa "آخرین"
    pub func Last(): T: ret this.Last() end

    @en "Clear"
    @fa "پاک کردن"
    pub func Clear(): this.Clear() end

    @en "Insert"
    @fa "درج"
    pub func Insert(i: int, x: T): this.Insert(i, x) end

    @en "RemoveAt"
    @fa "حذف از"
    pub func RemoveAt(i: int): T: ret this.RemoveAt(i) end

    @en "Iter"
    @fa "پیمایشگر"
    pub func Iter(): VectorIter<T>: ret this.Iter() end

    @en "Free"
    @fa "آزاد"
    pub func Free(): this.Free() end

end

@en "VectorIter"
@fa "پیمایشگر بردار"
pub struct VectorIter<T>:
    @en "data"
    @fa "داده"
    pub data: T* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "has_next"
    @fa "بعدی دارد"
    pub func has_next(): bool: ret this.pos < this.len end

    @en "value"
    @fa "مقدار"
    pub func value(): T:
        d := this.data
        ret d[this.pos]
    end

    @en "next"
    @fa "بعدی"
    pub func next(): this.pos++ end

    @en "HasNext"
    @fa "ادامه دارد"
    pub func HasNext(): bool: ret this.HasNext() end

    @en "Value"
    @fa "مقدار"
    pub func Value(): T: ret this.Value() end

    @en "Next"
    @fa "بعدی"
    pub func Next(): this.Next() end

end
