package collections

@en "Vector"
@fa "بردار"
@ar "قائمة"
pub struct Vector<T>:
    pub data: T* = null
    pub _len: int = 0
    pub _cap: int = 0

    @en "reserve"
    @fa "رزرو"
    @ar "حجز"
    pub func reserve(need: int):
        if need <= this._cap: ret end
        mut c := this._cap
        if c == 0: c = 4 end
        until c < need: c = c * 2 end
        this.data = mem.Reallocate(this.data as void*, (c as u64) * sizeof(T)) as T*
        this._cap = c
    end

    @en "push"
    @fa "افزودن"
    @ar "إضافة"
    pub func push(x: T):
        this.reserve(this._len + 1)
        d := this.data
        d[this._len] = x
        this._len += 1
    end

    // n elements of all-zero bytes, in one allocation. The equivalent of C's
    // calloc and Rust's `vec![0; n]`, and the reason they exist: filling by
    // push costs a capacity test and a store per element, while this hands
    // back kernel pages that are already zero. Only meaningful for a T whose
    // zero value is all-zero bytes, which is every numeric type, bool and a
    // null pointer - do not reach for it to fill a struct with defaults.
    @en "zeros"
    @fa "صفرها"
    @ar "أصفار"
    pub func zeros(n: int):
        if n <= 0: ret end
        if this.data != null: mem.Free(this.data as void*) end
        this.data = mem.AllocateZeroed((n as u64) * sizeof(T)) as T*
        this._len = n
        this._cap = n
    end

    @en "pop"
    @fa "برداشتن"
    @ar "سحب"
    pub func pop(): T:
        if SALAM_SAFE:
            if this._len <= 0: salam_panic("Vector.pop: empty") end
        end
        this._len -= 1
        d := this.data
        ret d[this._len]
    end

    @en "get"
    @fa "دریافت"
    @ar "جلب"
    pub func get(i: int): T*:
        if SALAM_SAFE:
            // One unsigned compare covers both ends: _len is never negative, so
            // a negative i reinterprets as a huge u32 and fails the same test.
            // Two compares cost more than the extra instruction suggests - they
            // keep LLVM from folding the guard into the loop's own exit test.
            if (i as u32) >= (this._len as u32):
                salam_panic("Vector.get: index out of bounds")
            end
        end
        ret (this.data as i64 + (i as i64) * (sizeof(T) as i64)) as T*
    end

    // Writes an element that is already there. Out of range is a panic, not a
    // resize - see resize_set for the growing form.
    //
    // Growing here put a realloc on a path inside every loop that writes a
    // vector, and that one call is enough to stop LLVM proving `data` and
    // `_len` unchanged across an iteration: bounds checks stay, loop-invariant
    // element loads are reloaded every time, and stores are never forwarded.
    // Splitting the two meanings apart is worth up to half the instructions in
    // a DP kernel.
    //
    // The guard sits under SALAM_SAFE, same as gets, so the two accessors
    // agree about what --release means. Code written against the older,
    // growing set therefore panics in a default build and stores out of
    // bounds in a --release one; that is the same bargain --release already
    // offers for every other indexed access.
    @en "set"
    @fa "تنظیم"
    @ar "تعیین"
    pub func set(i: int, x: T):
        if SALAM_SAFE:
            if (i as u32) >= (this._len as u32):
                salam_panic("Vector.set: index out of bounds")
            end
        end
        d := this.data
        d[i] = x
    end

    // set that grows the vector to fit, filling up to `i` with whatever
    // reserve left there. This is what set itself used to do.
    @en "resize_set"
    @fa "تنظیم با تغییر اندازه"
    @ar "تعيين مع تغيير الحجم"
    pub func resize_set(i: int, x: T):
        if SALAM_SAFE:
            if i < 0: salam_panic("Vector.resize_set: negative index") end
        end
        if i >= this._len:
            this.reserve(i + 1)
            this._len = i + 1
        end
        d := this.data
        d[i] = x
    end

    @en "len"
    @fa "طول"
    @ar "طول"
    pub func len(): int: ret this._len end

    @en "cap"
    @fa "ظرفیت"
    @ar "سعة"
    pub func cap(): int: ret this._cap end

    @en "is_empty"
    @fa "خالی است"
    @ar "فارغ"
    pub func is_empty(): bool: ret this._len == 0 end

    @en "first"
    @fa "اول"
    @ar "أول"
    pub func first(): T: ret this.get(0)[0] end

    @en "last"
    @fa "آخر"
    @ar "أخیر"
    pub func last(): T: ret this.get(this._len - 1)[0] end

    @en "clear"
    @fa "پاک‌سازی"
    @ar "مسح"
    pub func clear(): this._len = 0 end

    @en "insert"
    @fa "درج"
    @ar "إدراج"
    pub func insert(i: int, x: T):
        if SALAM_SAFE:
            if i < 0 || i > this._len: salam_panic("Vector.insert: index out of bounds") end
        end
        this.reserve(this._len + 1)
        d := this.data
        mut j := this._len
        until j > i:
            d[j] = d[j - 1]
            j -= 1
        end
        d[i] = x
        this._len += 1
    end

    @en "remove_at"
    @fa "حذف در"
    @ar "إزالة عند"
    pub func remove_at(i: int): T:
        if SALAM_SAFE:
            if i < 0 || i >= this._len: salam_panic("Vector.remove_at: index out of bounds") end
        end
        d := this.data
        out := d[i]
        mut j := i
        until j < this._len - 1:
            d[j] = d[j + 1]
            j += 1
        end
        this._len -= 1
        ret out
    end

    @en "operator_index"
    @fa "عملگر اندیس"
    @ar "عامل الفهرسة"
    pub func operator_index(i: int): T:
        ret this.get(i)[0]
    end

    @en "operator_index_set"
    @fa "تنظیم عملگر اندیس"
    @ar "تعیین عامل الفهرسة"
    pub func operator_index_set(i: int, x: T):
        this.set(i, x)
    end

    @en "iter"
    @fa "پیمایشگر"
    @ar "مكرر"
    pub func iter(): VectorIter<T>:
        it := VectorIter {} as VectorIter<T> it.data = this.data
        it.len = this._len
        it.pos = 0
        ret it
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free():
        if this.data != null: mem.Free(this.data as void*) end
        this.data = null
        this._len = 0
        this._cap = 0
    end
end

@en "VectorIter"
@fa "پیمایشگر بردار"
@ar "مکرر قائمة"
pub struct VectorIter<T>:
    pub data: T* = null
    pub len: int = 0
    pub pos: int = 0

    @en "has_next"
    @fa "بعدی دارد"
    @ar "له تالٍ"
    pub func has_next(): bool: ret this.pos < this.len end

    @en "value"
    @fa "مقدار"
    @ar "قیمة"
    pub func value(): T:
        d := this.data
        ret d[this.pos]
    end

    @en "next"
    @fa "بعدی"
    @ar "التالی"
    pub func next(): this.pos = this.pos + 1 end
end
