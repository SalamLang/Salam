package collections

@en "contains"
@fa "دارد"
pub func contains<T>(v: Vector<T>, x: T): bool:
    n := v.len()
    d := v.data
    repeat n in i:
        if d[i] == x: ret true end
    end
    ret false
end

@en "index_of"
@fa "اندیس"
pub func index_of<T>(v: Vector<T>, x: T): int:
    n := v.len()
    d := v.data
    repeat n in i:
        if d[i] == x: ret i end
    end
    ret 0 - 1
end

@en "reverse"
@fa "برعکس"
pub func reverse<T>(v: Vector<T>): Vector<T>:
    n := v.len()
    mut out := Vector {} as Vector<T>
    if n <= 0: ret out end
    out.reserve(n)
    mut i := n - 1
    until i >= 0:
        out.push(v.get(i))
        i--
    end
    ret out
end

@en "clone"
@fa "رونوشت"
pub func clone<T>(v: Vector<T>): Vector<T>:
    n := v.len()
    mut out := Vector {} as Vector<T>
    if n <= 0: ret out end
    out.data = mem.MustAllocate((n as u64) * sizeof(T)) as T*
    mem.Copy(out.data as void*, v.data as void*, (n as u64) * sizeof(T))
    out.capacity = n
    out.count = n
    ret out
end

@en "slice"
@fa "برش"
pub func slice<T>(v: Vector<T>, start: int, count: int): Vector<T>:
    mut out := Vector {} as Vector<T>
    mut s := start
    if s < 0: s = 0 end
    mut e := s + count
    n := v.len()
    if e > n: e = n end
    if e <= s: ret out end
    m := e - s
    out.data = mem.MustAllocate((m as u64) * sizeof(T)) as T*
    mem.Copy(out.data as void*, (v.data as u64 + (s as u64) * sizeof(T)) as void*, (m as u64) * sizeof(T))
    out.capacity = m
    out.count = m
    ret out
end

@en "swap"
@fa "جابجایی"
pub func swap<T>(v: Vector<T>, i: int, j: int):
    if SALAM_SAFE:
        if (i as u32) >= (v.count as u32) or (j as u32) >= (v.count as u32):
            salam_panic("Vector.swap: index out of bounds")
        end
    end
    d := v.data
    t := d[i]
    d[i] = d[j]
    d[j] = t
end

@en "count_of"
@fa "شمارش"
pub func count_of<T>(v: Vector<T>, x: T): int:
    mut n := 0
    total := v.len()
    d := v.data
    repeat total in i:
        if d[i] == x: n++ end
    end
    ret n
end

@en "last_index_of"
@fa "آخرین اندیس"
pub func last_index_of<T>(v: Vector<T>, x: T): int:
    mut i := v.len() - 1
    d := v.data
    until i >= 0:
        if d[i] == x: ret i end
        i--
    end
    ret 0 - 1
end

@en "extend"
@fa "گسترش"
pub func extend<T>(dst &: Vector<T>, src: Vector<T>):
    sn := src.len()
    if sn <= 0: ret end
    dst.reserve(dst.len() + sn)
    repeat sn in i:
        dst.push(src.get(i))
    end
end
