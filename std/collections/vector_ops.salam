package collections

@en "contains"
@fa "دارد"
pub func Contains<T>(v: Vector<T>, x: T): bool:
    n := v.Len()
    d := v.data
    repeat n in i:
        if d[i] == x: ret true end
    end
    ret false
end

@en "contains"
@fa "دارد"
pub func contains<T>(v: Vector<T>, x: T): bool:
    ret Contains<T>(v, x)
end

@en "index_of"
@fa "اندیس"
pub func IndexOf<T>(v: Vector<T>, x: T): int:
    n := v.Len()
    d := v.data
    repeat n in i:
        if d[i] == x: ret i end
    end
    ret 0 - 1
end

@en "index_of"
@fa "اندیس"
pub func index_of<T>(v: Vector<T>, x: T): int:
    ret IndexOf<T>(v, x)
end

@en "reverse"
@fa "برعکس"
pub func Reverse<T>(v: Vector<T>): Vector<T>:
    n := v.Len()
    mut out := Vector {} as Vector<T>
    if n <= 0: ret out end
    out.data = mem.MustAllocate((n as u64) * sizeof(T)) as T*
    out.capacity = n
    out.count = n
    od := out.data
    vd := v.data
    mut i := 0
    until i < n:
        od[i] = vd[n - 1 - i]
        i++
    end
    ret out
end

@en "reverse"
@fa "برعکس"
pub func reverse<T>(v: Vector<T>): Vector<T>:
    ret Reverse<T>(v)
end

@en "clone"
@fa "رونوشت"
pub func Clone<T>(v: Vector<T>): Vector<T>:
    n := v.Len()
    mut out := Vector {} as Vector<T>
    if n <= 0: ret out end
    out.data = mem.MustAllocate((n as u64) * sizeof(T)) as T*
    mem.Copy(out.data as void*, v.data as void*, (n as u64) * sizeof(T))
    out.capacity = n
    out.count = n
    ret out
end

@en "clone"
@fa "رونوشت"
pub func clone<T>(v: Vector<T>): Vector<T>:
    ret Clone<T>(v)
end

@en "slice"
@fa "برش"
pub func Slice<T>(v: Vector<T>, start: int, count: int): Vector<T>:
    mut out := Vector {} as Vector<T>
    mut s := start
    if s < 0: s = 0 end
    mut e := s + count
    n := v.Len()
    if e > n: e = n end
    if e <= s: ret out end
    m := e - s
    out.data = mem.MustAllocate((m as u64) * sizeof(T)) as T*
    mem.Copy(out.data as void*, (v.data as u64 + (s as u64) * sizeof(T)) as void*, (m as u64) * sizeof(T))
    out.capacity = m
    out.count = m
    ret out
end

@en "slice"
@fa "برش"
pub func slice<T>(v: Vector<T>, start: int, count: int): Vector<T>:
    ret Slice<T>(v, start, count)
end

@en "swap"
@fa "جابجایی"
pub func Swap<T>(v: Vector<T>, i: int, j: int):
    if SALAM_SAFE:
        if (i as u32) >= (v.count as u32) or (j as u32) >= (v.count as u32):
            salam_panic("Vector.swap: index out of bounds")
        end
    end
    d := v.data
    t := d[i]
    d[i] = d[j]
    d[j] = t
end

@en "swap"
@fa "جابجایی"
pub func swap<T>(v: Vector<T>, i: int, j: int):
    Swap<T>(v, i, j)
end

@en "count_of"
@fa "شمارش"
pub func CountOf<T>(v: Vector<T>, x: T): int:
    mut n := 0
    total := v.Len()
    d := v.data
    repeat total in i:
        if d[i] == x: n++ end
    end
    ret n
end

@en "count_of"
@fa "شمارش"
pub func count_of<T>(v: Vector<T>, x: T): int:
    ret CountOf<T>(v, x)
end

@en "last_index_of"
@fa "آخرین اندیس"
pub func LastIndexOf<T>(v: Vector<T>, x: T): int:
    mut i := v.Len() - 1
    d := v.data
    until i >= 0:
        if d[i] == x: ret i end
        i--
    end
    ret 0 - 1
end

@en "last_index_of"
@fa "آخرین اندیس"
pub func last_index_of<T>(v: Vector<T>, x: T): int:
    ret LastIndexOf<T>(v, x)
end

@en "extend"
@fa "گسترش"
pub func Extend<T>(dst &: Vector<T>, src: Vector<T>):
    sn := src.Len()
    if sn <= 0: ret end
    dn := dst.Len()
    dst.Reserve(dn + sn)
    mem.Copy((dst.data as u64 + (dn as u64) * sizeof(T)) as void*, src.data as void*, (sn as u64) * sizeof(T))
    dst.count = dn + sn
end

@en "extend"
@fa "گسترش"
pub func extend<T>(dst &: Vector<T>, src: Vector<T>):
    Extend<T>(dst, src)
end
