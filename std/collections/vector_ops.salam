package collections

import mem

@en "contains"
@fa "دارد"
pub func Contains<T>(v: Vector<T>, x: T): bool:
    n := v.Len()
    d := v.data
    repeat n in i:
        if d[i] == x: ret true end
    end
    ret false
end

@en "index_of"
@fa "اندیس"
pub func IndexOf<T>(v: Vector<T>, x: T): int:
    n := v.Len()
    d := v.data
    repeat n in i:
        if d[i] == x: ret i end
    end
    ret 0 - 1
end

@en "reverse"
@fa "برعکس"
pub func Reverse<T>(v: Vector<T>): Vector<T>:
    n := v.Len()
    mut out := Vector {} as Vector<T>
    if n <= 0: ret out end
    out.Reserve(n)
    mut i := n - 1
    until i >= 0:
        out.Push(v.Get(i))
        i--
    end
    ret out
end

@en "clone"
@fa "رونوشت"
pub func Clone<T>(v: Vector<T>): Vector<T>:
    n := v.Len()
    mut out := Vector {} as Vector<T>
    repeat n in i:
        out.Push(v.Get(i))
    end
    ret out
end

@en "slice"
@fa "برش"
pub func Slice<T>(v: Vector<T>, start: int, count: int): Vector<T>:
    mut out := Vector {} as Vector<T>
    mut s := start
    if s < 0: s = 0 end
    mut e := s + count
    n := v.Len()
    if e > n: e = n end
    if e <= s: ret out end
    out.Reserve(e - s)
    mut i := s
    until i < e:
        out.Push(v.Get(i))
        i++
    end
    ret out
end

@en "swap"
@fa "جابجایی"
pub func Swap<T>(v: Vector<T>, i: int, j: int):
    if SALAM_SAFE:
        if (i as u32) >= (v.len() as u32) or (j as u32) >= (v.len() as u32):
            salam_panic("Vector.swap: index out of bounds")
        end
    end
    d := v.data
    t := d[i]
    d[i] = d[j]
    d[j] = t
end

@en "count_of"
@fa "شمارش"
pub func CountOf<T>(v: Vector<T>, x: T): int:
    mut n := 0
    total := v.Len()
    d := v.data
    repeat total in i:
        if d[i] == x: n++ end
    end
    ret n
end

@en "last_index_of"
@fa "آخرین اندیس"
pub func LastIndexOf<T>(v: Vector<T>, x: T): int:
    mut i := v.Len() - 1
    d := v.data
    until i >= 0:
        if d[i] == x: ret i end
        i--
    end
    ret 0 - 1
end

@en "extend"
@fa "گسترش"
pub func Extend<T>(dst &: Vector<T>, src: Vector<T>):
    sn := src.Len()
    if sn <= 0: ret end
    mut s := src
    is_self := dst.data == s.data
    dst.Reserve(dst.Len() + sn)
    if is_self: s.data = dst.data end
    mut i := 0
    until i < sn:
        dst.Push(s.Get(i))
        i++
    end
end
