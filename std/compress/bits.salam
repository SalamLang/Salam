package compress

import mem

@en "BitWriter"
@fa "نویسنده بیت"
pub struct BitWriter:
    @en "buf"
    @fa "بافر"
    pub buf: ByteBuf = ByteBuf { data = null, len = 0, cap = 0 }
    @en "acc"
    @fa "انباره"
    pub acc: int = 0
    @en "nbits"
    @fa "شمار بیت‌ها"
    pub nbits: int = 0
end

@en "BitReader"
@fa "خواننده بیت"
pub struct BitReader:
    @en "data"
    @fa "داده"
    pub data: void* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0
    @en "acc"
    @fa "انباره"
    pub acc: int = 0
    @en "nbits"
    @fa "شمار بیت‌ها"
    pub nbits: int = 0
    @en "bad"
    @fa "خراب"
    pub bad: bool = false
    @en "fp"
    @fa "پرونده"
    pub fp: void* = null
    @en "left"
    @fa "باقی مانده"
    pub left: i64 = 0 as i64
    @en "foff"
    @fa "جایگاه پرونده"
    pub foff: i64 = 0 as i64
end

func _br_refill(r &: BitReader): bool:
    if r.fp == null or r.left <= (0 as i64):
        ret false
    end
    want := r.left > (65536 as i64) ? 65536 : (r.left as int)
    got := FileReadAt(r.fp, r.foff, r.data, want)
    if got <= 0:
        ret false
    end
    r.foff += got as i64
    r.len = got
    r.pos = 0
    r.left -= got as i64
    ret true
end

@en "NewBitWriter"
@fa "نویسنده بیت جدید"
pub func NewBitWriter(): BitWriter:
    ret BitWriter { acc = 0, nbits = 0 }
end

@en "BitWriteBit"
@fa "نوشتن بیت"
pub func BitWriteBit(w &: BitWriter, bit: int):
    if bit != 0:
        w.acc |= (1 << w.nbits)
    end
    w.nbits++
    if w.nbits == 8:
        BufPush(w.buf, w.acc)
        w.acc = 0
        w.nbits = 0
    end
end

@en "BitWriteBits"
@fa "نوشتن بیت‌ها"
pub func BitWriteBits(w &: BitWriter, value: int, count: int):
    mut v := value
    mut left := count
    until left > 0:
        take := left > 16 ? 16 : left
        w.acc |= ((v & ((1 << take) - 1)) << w.nbits)
        w.nbits += take
        until w.nbits >= 8:
            BufPush(w.buf, w.acc & 255)
            w.acc >>= 8
            w.nbits -= 8
        end
        v >>= take
        left -= take
    end
end

@en "BitFlush"
@fa "تخلیه بیت"
pub func BitFlush(w &: BitWriter):
    if w.nbits > 0:
        BufPush(w.buf, w.acc)
        w.acc = 0
        w.nbits = 0
    end
end

@en "BitWriterLen"
@fa "طول نویسنده بیت"
pub func BitWriterLen(w &: BitWriter): int: ret BufLen(w.buf) end

@en "BitWriterFree"
@fa "آزادسازی نویسنده بیت"
pub func BitWriterFree(w &: BitWriter): BufFree(w.buf) end

@en "NewBitReader"
@fa "خواننده بیت جدید"
pub func NewBitReader(p: void*, n: int): BitReader:
    ret BitReader { data = p, len = n, pos = 0, acc = 0, nbits = 0, bad = false }
end

@en "NewFileBitReader"
@fa "خواننده بیت از پرونده"
pub func NewFileBitReader(fp: void*, off: i64, len: i64): BitReader:
    mut r := BitReader { data = null, len = 0, pos = 0, acc = 0, nbits = 0, bad = false, fp = fp, left = len, foff = off }
    if off < (0 as i64):
        r.bad = true
        ret r
    end
    r.data = mem.Allocate(65536 as u64)
    ret r
end

@en "FileBitReaderFree"
@fa "آزادسازی خواننده بیت پرونده"
pub func FileBitReaderFree(r &: BitReader):
    if r.fp != null and r.data != null:
        mem.Free(r.data)
        r.data = null
    end
end

@en "BitReaderFromBuf"
@fa "خواننده بیت از بافر"
pub func BitReaderFromBuf(b: ByteBuf): BitReader:
    ret NewBitReader(b.data, b.len)
end

@en "BitReadBit"
@fa "خواندن بیت"
pub func BitReadBit(r &: BitReader): int:
    if r.nbits == 0:
        if r.bad:
            ret 0
        end
        if r.pos >= r.len and not _br_refill(r):
            r.bad = true
            ret 0
        end
        r.acc = _bget(r.data, r.pos)
        r.pos++
        r.nbits = 8
    end
    bit := r.acc & 1
    r.acc >>= 1
    r.nbits--
    ret bit
end

@en "BitReadBits"
@fa "خواندن بیت‌ها"
pub func BitReadBits(r &: BitReader, count: int): int:
    if count <= 0:
        ret 0
    end
    until r.nbits < count:
        if r.bad or (r.pos >= r.len and not _br_refill(r)):
            r.bad = true
            part := r.acc & ((1 << r.nbits) - 1)
            r.acc = 0
            r.nbits = 0
            ret part
        end
        r.acc |= _bget(r.data, r.pos) << r.nbits
        r.pos++
        r.nbits += 8
    end
    v := r.acc & ((1 << count) - 1)
    r.acc >>= count
    r.nbits -= count
    ret v
end
