package compress

@en "BitWriter"
@fa "نویسنده بیت"
pub struct BitWriter:
    pub buf: ByteBuf = ByteBuf { data = null, len = 0, cap = 0 }
    pub acc: int = 0
    pub nbits: int = 0
end

@en "BitReader"
@fa "خواننده بیت"
pub struct BitReader:
    pub data: void* = null
    pub len: int = 0
    pub pos: int = 0
    pub acc: int = 0
    pub nbits: int = 0
    pub bad: bool = false
end

@en "NewBitWriter"
@fa "نویسنده بیت جدید"
pub func NewBitWriter(): BitWriter:
    ret BitWriter { acc = 0, nbits = 0 }
end

@en "BitWriteBit"
@fa "نوشتن بیت"
pub func BitWriteBit(w &: BitWriter, bit: int):
    if bit != 0:
        w.acc = w.acc | (1 << w.nbits)
    end
    w.nbits += 1
    if w.nbits == 8:
        BufPush(w.buf, w.acc)
        w.acc = 0
        w.nbits = 0
    end
end

@en "BitWriteBits"
@fa "نوشتن بیت‌ها"
pub func BitWriteBits(w &: BitWriter, value: int, count: int):
    mut i := 0
    until i < count:
        BitWriteBit(w, (value >> i) & 1)
        i += 1
    end
end

@en "BitFlush"
@fa "تخلیه بیت"
pub func BitFlush(w &: BitWriter):
    if w.nbits > 0:
        BufPush(w.buf, w.acc)
        w.acc = 0
        w.nbits = 0
    end
end

@en "BitWriterLen"
@fa "طول نویسنده بیت"
pub func BitWriterLen(w &: BitWriter): int: ret BufLen(w.buf) end

@en "BitWriterFree"
@fa "آزادسازی نویسنده بیت"
pub func BitWriterFree(w &: BitWriter): BufFree(w.buf) end

@en "NewBitReader"
@fa "خواننده بیت جدید"
pub func NewBitReader(p: void*, n: int): BitReader:
    ret BitReader { data = p, len = n, pos = 0, acc = 0, nbits = 0, bad = false }
end

@en "BitReaderFromBuf"
@fa "خواننده بیت از بافر"
pub func BitReaderFromBuf(b: ByteBuf): BitReader:
    ret NewBitReader(b.data, b.len)
end

@en "BitReadBit"
@fa "خواندن بیت"
pub func BitReadBit(r &: BitReader): int:
    if r.nbits == 0:
        if r.bad || r.pos >= r.len:
            r.bad = true
            ret 0
        end
        r.acc = _bget(r.data, r.pos)
        r.pos += 1
        r.nbits = 8
    end
    bit := r.acc & 1
    r.acc = r.acc >> 1
    r.nbits -= 1
    ret bit
end

@en "BitReadBits"
@fa "خواندن بیت‌ها"
pub func BitReadBits(r &: BitReader, count: int): int:
    mut v := 0
    mut i := 0
    until i < count:
        b := BitReadBit(r)
        v = v | (b << i)
        i += 1
    end
    ret v
end
