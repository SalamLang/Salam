package compress

// CRC-32 (the IEEE 802.3 / zlib / gzip / PNG polynomial 0xEDB88320) and
// Adler-32 (zlib's own checksum). Both are computed bit-by-bit rather than
// through a precomputed 256-entry table, trading a little speed for a much
// shorter, easier-to-verify implementation; the results are byte-identical
// to the table-driven versions used everywhere else.
//
// NOTE: this exercises u32 wraparound arithmetic, which only the compiled
// backend implements correctly - verify with `salam build`/`salam run`,
// not `salam exec` (see SKILL.md's interpreter caveat).

const _CRC32_POLY := 0xEDB88320 as u32
const _ADLER_MOD := 65521 as u32

@en "CRC32"
@fa "چک جمع سی آر سی"
@ar "المجموع الاختباري سي آر سي"
pub func CRC32(p: void*, n: int): u32:
    bp := p as u8*
    mut crc := 0xFFFFFFFF as u32
    mut i := 0
    until i < n:
        crc = crc ^ (bp[i] as u32)
        mut k := 0
        until k < 8:
            if (crc & (1 as u32)) != (0 as u32):
                crc = (crc >> 1) ^ _CRC32_POLY
            else:
                crc = crc >> 1
            end
            k += 1
        end
        i += 1
    end
    ret crc ^ (0xFFFFFFFF as u32)
end

@en "CRC32Str"
@fa "چک جمع سی آر سی رشته"
@ar "المجموع الاختباري سي آر سي للنص"
pub func CRC32Str(s: str): u32: ret CRC32(s as void*, s.len()) end

@en "CRC32Buf"
@fa "چک جمع سی آر سی بافر"
@ar "المجموع الاختباري سي آر سي للمخزن"
pub func CRC32Buf(b: ByteBuf): u32: ret CRC32(b.data, b.len) end

@en "Adler32"
@fa "چک جمع ادلر"
@ar "المجموع الاختباري أدلر"
pub func Adler32(p: void*, n: int): u32:
    bp := p as u8*
    mut a := 1 as u32
    mut b := 0 as u32
    mut i := 0
    until i < n:
        a = (a + (bp[i] as u32)) % _ADLER_MOD
        b = (b + a) % _ADLER_MOD
        i += 1
    end
    ret (b << 16) | a
end

@en "Adler32Str"
@fa "چک جمع ادلر رشته"
@ar "المجموع الاختباري أدلر للنص"
pub func Adler32Str(s: str): u32: ret Adler32(s as void*, s.len()) end

@en "Adler32Buf"
@fa "چک جمع ادلر بافر"
@ar "المجموع الاختباري أدلر للمخزن"
pub func Adler32Buf(b: ByteBuf): u32: ret Adler32(b.data, b.len) end
