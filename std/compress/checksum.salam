package compress

import mem

const _CRC32_POLY := 0xEDB88320 as u32
const _ADLER_MOD := 65521 as u32

mut _crc_table := null as u32*

func _crc_init():
    if _crc_table != null:
        ret
    end
    t := mem.AllocateZeroed(1024 as u64) as u32*
    mut i := 0
    until i < 256:
        mut c := i as u32
        mut k := 0
        until k < 8:
            if (c & (1 as u32)) != (0 as u32):
                c = (c >> 1) ^ _CRC32_POLY
            else:
                c >>= 1
            end
            k++
        end
        t[i] = c
        i++
    end
    _crc_table = t
end

@en "CRC32Update"
@fa "به‌روزرسانی چک جمع سی آر سی"
pub func CRC32Update(state: u32, p: void*, n: int): u32:
    _crc_init()
    bp := p as u8*
    t := _crc_table
    mut crc := state ^ (0xFFFFFFFF as u32)
    mut i := 0
    until i < n:
        crc = t[((crc ^ (bp[i] as u32)) & (255 as u32)) as int] ^ (crc >> 8)
        i++
    end
    ret crc ^ (0xFFFFFFFF as u32)
end

@en "CRC32"
@fa "چک جمع سی آر سی"
pub func CRC32(p: void*, n: int): u32:
    ret CRC32Update(0 as u32, p, n)
end

@en "CRC32Str"
@fa "چک جمع سی آر سی رشته"
pub func CRC32Str(s: str): u32: ret CRC32(s as void*, s.len()) end

@en "CRC32Buf"
@fa "چک جمع سی آر سی بافر"
pub func CRC32Buf(b: ByteBuf): u32: ret CRC32(b.data, b.len) end

@en "Adler32"
@fa "چک جمع ادلر"
pub func Adler32(p: void*, n: int): u32:
    bp := p as u8*
    mut a := 1 as u32
    mut b := 0 as u32
    mut i := 0
    until i < n:
        mut stop := i + 5552
        if stop > n:
            stop = n
        end
        until i < stop:
            a += (bp[i] as u32)
            b += a
            i++
        end
        a %= _ADLER_MOD
        b %= _ADLER_MOD
    end
    ret (b << 16) | a
end

@en "Adler32Str"
@fa "چک جمع ادلر رشته"
pub func Adler32Str(s: str): u32: ret Adler32(s as void*, s.len()) end

@en "Adler32Buf"
@fa "چک جمع ادلر بافر"
pub func Adler32Buf(b: ByteBuf): u32: ret Adler32(b.data, b.len) end
