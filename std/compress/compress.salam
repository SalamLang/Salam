@en "compress"
@fa "فشرده سازی"
@ar "ضغط"
package compress

import mem
import encoding

@en "Method"
@fa "روش"
@ar "طريقة"
pub enum Method: None, RLE, Huffman, LZ77, LZW, Deflate, BWT end

@en "ByteBuf"
@fa "بافر بایت"
@ar "مخزن بايتات"
pub struct ByteBuf:
    pub data: void* = null
    pub len: int = 0
    pub cap: int = 0
end

@en "ByteReader"
@fa "خواننده بایت"
@ar "قارئ بايتات"
pub struct ByteReader:
    pub data: void* = null
    pub len: int = 0
    pub pos: int = 0
    pub bad: bool = false
end

inline func _bget(p: void*, i: int): int:
    bp := p as u8*
    ret bp[i] as int
end

inline func _bput(p: void*, i: int, v: int):
    bp := p as u8*
    bp[i] = (v & 255) as u8
end
