@en "compress"
@fa "فشرده سازی"
package compress

import mem
import encoding

@en "Method"
@fa "روش"
pub enum Method:
    @en "None"
    @fa "هیچ"
    None
    @en "RLE"
    @fa "آر ال ای"
    RLE
    @en "Huffman"
    @fa "هافمن"
    Huffman
    @en "LZ77"
    @fa "الزد۷۷"
    LZ77
    @en "LZW"
    @fa "ال زد دبلیو"
    LZW
    @en "Deflate"
    @fa "دیفلیت"
    Deflate
    @en "BWT"
    @fa "باروز ویلر"
    BWT
end

@en "ByteBuf"
@fa "بافر بایت"
pub struct ByteBuf:
    @en "data"
    @fa "داده"
    pub data: void* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
    @en "cap"
    @fa "ظرفیت"
    pub cap: int = 0
end

@en "ByteReader"
@fa "خواننده بایت"
pub struct ByteReader:
    @en "data"
    @fa "داده"
    pub data: void* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0
    @en "bad"
    @fa "خراب"
    pub bad: bool = false
end

inline func _bget(p: void*, i: int): int:
    bp := p as u8*
    ret bp[i] as int
end

inline func _bput(p: void*, i: int, v: int):
    bp := p as u8*
    bp[i] = (v & 255) as u8
end
