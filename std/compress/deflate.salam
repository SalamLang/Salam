package compress

const _DEFLATE_WINDOW := 32768
const _DEFLATE_MIN_MATCH := 3
const _DEFLATE_MAX_MATCH := 254

func _deflate_find_match(p: void*, n: int, pos: int, bestlen &: int, bestdist &: int):
    bp := p as u8*
    bestlen = 0
    bestdist = 0
    mut winstart := pos - _DEFLATE_WINDOW
    if winstart < 0: winstart = 0 end
    mut cand := winstart
    until cand < pos:
        mut len := 0
        until len < _DEFLATE_MAX_MATCH and pos + len < n and (bp[cand + len] as int) == (bp[pos + len] as int):
            len++
        end
        if len > bestlen:
            bestlen = len
            bestdist = pos - cand
        end
        cand++
    end
end

@en "DeflateCompress"
@fa "فشرده سازی دیفلیت"
pub func DeflateCompress(p: void*, n: int): ByteBuf:
    mut out := NewByteBuf()
    BufPushU32(out, n)

    mut tagw := NewBitWriter()
    mut litlen := NewByteBuf()
    mut dist := NewByteBuf()

    bp := p as u8*
    mut pos := 0
    until pos < n:
        mut bestlen := 0
        mut bestdist := 0
        _deflate_find_match(p, n, pos, bestlen, bestdist)
        if bestlen >= _DEFLATE_MIN_MATCH:
            BitWriteBit(tagw, 1)
            BufPush(litlen, bestlen - _DEFLATE_MIN_MATCH)
            BufPush(dist, ((bestdist - 1) >> 8) & 255)
            BufPush(dist, (bestdist - 1) & 255)
            pos += bestlen
        else:
            BitWriteBit(tagw, 0)
            BufPush(litlen, bp[pos] as int)
            pos++
        end
    end
    BitFlush(tagw)

    BufPushU32(out, BufLen(tagw.buf))
    BufPushBuf(out, tagw.buf)
    BitWriterFree(tagw)

    mut huffLit := HuffmanCompress(litlen.data, litlen.len)
    BufPushU32(out, BufLen(huffLit))
    BufPushBuf(out, huffLit)
    BufFree(huffLit)
    BufFree(litlen)

    mut huffDist := HuffmanCompress(dist.data, dist.len)
    BufPushU32(out, BufLen(huffDist))
    BufPushBuf(out, huffDist)
    BufFree(huffDist)
    BufFree(dist)

    ret out
end

@en "DeflateDecompressMax"
@fa "کدگشایی دیفلیت با سقف"
pub func DeflateDecompressMax(p: void*, n: int, max: int, ok &: bool): ByteBuf:
    ok = false
    mut r := NewByteReader(p, n)
    origLen := RdU32(r)
    if r.bad or not _dec_size_ok(origLen, n, max): ret NewByteBuf() end
    mut out := NewByteBufCap(_dec_cap(origLen))

    tagLen := RdU32(r)
    mut tagBytes := RdBytes(r, tagLen)
    mut tagr := BitReaderFromBuf(tagBytes)

    huffLitLen := RdU32(r)
    mut huffLitBytes := RdBytes(r, huffLitLen)
    mut litok := false
    mut litlen := HuffmanDecompressMax(huffLitBytes.data, huffLitBytes.len, max, litok)
    BufFree(huffLitBytes)

    huffDistLen := RdU32(r)
    mut huffDistBytes := RdBytes(r, huffDistLen)
    mut distok := false
    mut dist := HuffmanDecompressMax(huffDistBytes.data, huffDistBytes.len, max, distok)
    BufFree(huffDistBytes)

    mut good := not r.bad and litok and distok

    mut litpos := 0
    mut distpos := 0
    until BufLen(out) < origLen and good:
        bit := BitReadBit(tagr)
        if tagr.bad:
            good = false
        else bit == 0:
            if litpos >= litlen.len:
                good = false
            else:
                BufPush(out, BufGet(litlen, litpos))
                litpos++
            end
        else:
            if litpos >= litlen.len or distpos + 1 >= dist.len:
                good = false
            else:
                lb := BufGet(litlen, litpos)
                litpos++
                length := lb + _DEFLATE_MIN_MATCH
                hi := BufGet(dist, distpos)
                lo := BufGet(dist, distpos + 1)
                distpos += 2
                d := ((hi << 8) | lo) + 1
                start := BufLen(out) - d
                if start < 0:
                    good = false
                else:
                    mut k := 0
                    until k < length:
                        BufPush(out, BufGet(out, start + k))
                        k++
                    end
                end
            end
        end
    end

    BufFree(tagBytes)
    BufFree(litlen)
    BufFree(dist)
    if not good or BufLen(out) != origLen:
        BufFree(out)
        ret NewByteBuf()
    end
    ok = true
    ret out
end

@en "DeflateDecompress"
@fa "کدگشایی دیفلیت"
pub func DeflateDecompress(p: void*, n: int): ByteBuf:
    mut ok := false
    ret DeflateDecompressMax(p, n, 0, ok)
end
