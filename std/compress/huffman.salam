package compress

const _HUFF_ALPHA := 256
const _HUFF_MAX_NODES := 512

func _huff_canonical_codes(lengths: int[:], codes_out: int[:]):
    mut blcount: int[256]
    repeat 256 in i: blcount[i] = 0 end
    mut maxlen := 0
    repeat _HUFF_ALPHA in s:
        l := lengths[s]
        if l > maxlen: maxlen = l end
        if l > 0: blcount[l]++ end
    end
    mut nextcode: int[256]
    repeat 256 in i: nextcode[i] = 0 end
    mut code := 0
    mut len := 1
    until len <= maxlen:
        code = (code + blcount[len - 1]) * 2
        nextcode[len] = code
        len++
    end
    repeat _HUFF_ALPHA in s:
        l := lengths[s]
        if l > 0:
            codes_out[s] = nextcode[l]
            nextcode[l]++
        else:
            codes_out[s] = 0
        end
    end
end

func _huff_lengths(p: void*, n: int, lengths_out: int[:]): int:
    mut freq: i64[256]
    repeat 256 in i: freq[i] = 0 as i64 end
    bp := p as u8*
    mut i := 0
    until i < n:
        b := bp[i] as int
        freq[b]++
        i++
    end

    mut nfreq: i64[512]
    mut nleft: int[512]
    mut nright: int[512]
    mut nsym: int[512]
    mut nleaf: bool[512]
    repeat _HUFF_MAX_NODES in k:
        nfreq[k] = 0 as i64
        nleft[k] = -1
        nright[k] = -1
        nsym[k] = -1
        nleaf[k] = false
    end
    mut nodecount := 0
    mut active: int[256]
    mut activecount := 0
    repeat 256 in s:
        if freq[s] > (0 as i64):
            nfreq[nodecount] = freq[s]
            nleaf[nodecount] = true
            nsym[nodecount] = s
            active[activecount] = nodecount
            activecount++
            nodecount++
        end
    end

    distinct := activecount
    if distinct == 0: ret 0 end
    if distinct == 1:
        lengths_out[nsym[active[0]]] = 1
        ret 1
    end

    until activecount > 1:
        mut i1 := 0
        repeat activecount in k:
            if nfreq[active[k]] < nfreq[active[i1]]: i1 = k end
        end
        idx1 := active[i1]
        active[i1] = active[activecount - 1]
        activecount--

        mut i2 := 0
        repeat activecount in k:
            if nfreq[active[k]] < nfreq[active[i2]]: i2 = k end
        end
        idx2 := active[i2]
        active[i2] = active[activecount - 1]
        activecount--

        newidx := nodecount
        nfreq[newidx] = nfreq[idx1] + nfreq[idx2]
        nleft[newidx] = idx1
        nright[newidx] = idx2
        nleaf[newidx] = false
        nodecount++

        active[activecount] = newidx
        activecount++
    end

    root := active[0]
    mut stacknode: int[512]
    mut stackdepth: int[512]
    stacknode[0] = root
    stackdepth[0] = 0
    mut stacktop := 1
    until stacktop > 0:
        stacktop--
        cur := stacknode[stacktop]
        d := stackdepth[stacktop]
        if nleaf[cur]:
            lengths_out[nsym[cur]] = d
        else:
            stacknode[stacktop] = nleft[cur]
            stackdepth[stacktop] = d + 1
            stacktop++
            stacknode[stacktop] = nright[cur]
            stackdepth[stacktop] = d + 1
            stacktop++
        end
    end
    ret distinct
end

@en "HuffmanCompress"
@fa "فشرده سازی هافمن"
pub func HuffmanCompress(p: void*, n: int): ByteBuf:
    mut lengths: int[256]
    repeat 256 in i: lengths[i] = 0 end
    distinct := _huff_lengths(p, n, lengths[:])

    mut out := NewByteBuf()
    BufPushU32(out, n)

    if distinct == 0:
        BufPush(out, 0)
        ret out
    end
    BufPush(out, 2)

    mut codes: int[256]
    repeat 256 in i: codes[i] = 0 end
    _huff_canonical_codes(lengths[:], codes[:])

    repeat 256 in s:
        BufPush(out, lengths[s])
    end

    mut w := NewBitWriter()
    bp := p as u8*
    mut i := 0
    until i < n:
        b := bp[i] as int
        len := lengths[b]
        code := codes[b]
        mut bit := len - 1
        until bit >= 0:
            BitWriteBit(w, (code >> bit) & 1)
            bit--
        end
        i++
    end
    BitFlush(w)
    BufPushBuf(out, w.buf)
    BitWriterFree(w)
    ret out
end

@en "HuffmanDecompressMax"
@fa "کدگشایی هافمن با سقف"
pub func HuffmanDecompressMax(p: void*, n: int, max: int, ok &: bool): ByteBuf:
    ok = false
    mut r := NewByteReader(p, n)
    origLen := RdU32(r)
    mode := RdByte(r)
    if r.bad or not _dec_size_ok(origLen, n, max): ret NewByteBuf() end
    mut out := NewByteBufCap(_dec_cap(origLen))
    if mode == 0:
        ok = origLen == 0
        ret out
    end

    mut lengths: int[256]
    repeat 256 in s:
        lengths[s] = RdByte(r)
        if lengths[s] > 60 or lengths[s] < 0: r.bad = true end
    end
    if r.bad:
        BufFree(out)
        ret NewByteBuf()
    end
    mut codes: int[256]
    repeat 256 in i: codes[i] = 0 end
    _huff_canonical_codes(lengths[:], codes[:])

    mut tleft: int[512]
    mut tright: int[512]
    mut tsym: int[512]
    mut tleaf: bool[512]
    repeat _HUFF_MAX_NODES in k:
        tleft[k] = -1
        tright[k] = -1
        tsym[k] = -1
        tleaf[k] = false
    end
    mut nodecount := 1
    mut good := true

    repeat 256 in s:
        len := lengths[s]
        if len > 0 and good:
            code := codes[s]
            mut cur := 0
            mut bit := len - 1
            until bit >= 0 and good:
                b := (code >> bit) & 1
                if nodecount >= _HUFF_MAX_NODES - 1:
                    good = false
                else b == 0:
                    if tleft[cur] < 0:
                        tleft[cur] = nodecount
                        nodecount++
                    end
                    cur = tleft[cur]
                else:
                    if tright[cur] < 0:
                        tright[cur] = nodecount
                        nodecount++
                    end
                    cur = tright[cur]
                end
                bit--
            end
            if good:
                tleaf[cur] = true
                tsym[cur] = s
            end
        end
    end
    if not good:
        BufFree(out)
        ret NewByteBuf()
    end

    remaining := RdLeft(r)
    mut br := NewBitReader(((r.data as i64) + (r.pos as i64)) as void*, remaining)
    until BufLen(out) < origLen and good:
        mut cur := 0
        until not tleaf[cur] and good:
            bit := BitReadBit(br)
            if br.bad:
                good = false
            else bit == 0:
                cur = tleft[cur]
            else:
                cur = tright[cur]
            end
            if cur < 0:
                good = false
                cur = 0
            end
        end
        if good: BufPush(out, tsym[cur]) end
    end
    if not good:
        BufFree(out)
        ret NewByteBuf()
    end
    ok = true
    ret out
end

@en "HuffmanDecompress"
@fa "کدگشایی هافمن"
pub func HuffmanDecompress(p: void*, n: int): ByteBuf:
    mut ok := false
    ret HuffmanDecompressMax(p, n, 0, ok)
end
