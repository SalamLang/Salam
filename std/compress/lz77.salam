package compress

const _LZ_WINDOW := 4096
const _LZ_MIN_MATCH := 3
const _LZ_MAX_MATCH := 18

func _lz77_find_match(p: void*, n: int, pos: int, bestlen &: int, bestdist &: int):
    bp := p as u8*
    bestlen = 0
    bestdist = 0
    mut winstart := pos - _LZ_WINDOW
    if winstart < 0: winstart = 0 end
    mut cand := winstart
    until cand < pos:
        mut len := 0
        until len < _LZ_MAX_MATCH and pos + len < n and (bp[cand + len] as int) == (bp[pos + len] as int):
            len++
        end
        if len > bestlen:
            bestlen = len
            bestdist = pos - cand
        end
        cand++
    end
end

@en "LZ77Compress"
@fa "فشرده سازی الزد۷۷"
pub func LZ77Compress(p: void*, n: int): ByteBuf:
    mut out := NewByteBuf()
    BufPushU32(out, n)
    mut w := NewBitWriter()
    bp := p as u8*
    mut pos := 0
    until pos < n:
        mut bestlen := 0
        mut bestdist := 0
        _lz77_find_match(p, n, pos, bestlen, bestdist)
        if bestlen >= _LZ_MIN_MATCH:
            BitWriteBit(w, 1)
            BitWriteBits(w, bestdist - 1, 12)
            BitWriteBits(w, bestlen - _LZ_MIN_MATCH, 4)
            pos += bestlen
        else:
            BitWriteBit(w, 0)
            BitWriteBits(w, bp[pos] as int, 8)
            pos++
        end
    end
    BitFlush(w)
    BufPushBuf(out, w.buf)
    BitWriterFree(w)
    ret out
end

@en "LZ77DecompressMax"
@fa "کدگشایی الزد۷۷ با سقف"
pub func LZ77DecompressMax(p: void*, n: int, max: int, ok &: bool): ByteBuf:
    ok = false
    mut r := NewByteReader(p, n)
    origLen := RdU32(r)
    if r.bad or not _dec_size_ok(origLen, n, max): ret NewByteBuf() end
    mut out := NewByteBufCap(_dec_cap(origLen))
    remaining := RdLeft(r)
    mut br := NewBitReader(((r.data as i64) + (r.pos as i64)) as void*, remaining)
    mut good := true
    until BufLen(out) < origLen and good:
        bit := BitReadBit(br)
        if bit == 0:
            b := BitReadBits(br, 8)
            BufPush(out, b)
        else:
            dist := BitReadBits(br, 12) + 1
            length := BitReadBits(br, 4) + _LZ_MIN_MATCH
            start := BufLen(out) - dist
            if start < 0:
                good = false
            else:
                mut k := 0
                until k < length:
                    BufPush(out, BufGet(out, start + k))
                    k++
                end
            end
        end
        if br.bad: good = false end
    end
    if not good or BufLen(out) != origLen:
        BufFree(out)
        ret NewByteBuf()
    end
    ok = true
    ret out
end

@en "LZ77Decompress"
@fa "کدگشایی الزد۷۷"
pub func LZ77Decompress(p: void*, n: int): ByteBuf:
    mut ok := false
    ret LZ77DecompressMax(p, n, 0, ok)
end
