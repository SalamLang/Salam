package compress

const _RLE_MAX_RUN := 128

func _rle_run_len(p: void*, n: int, i: int): int:
    bp := p as u8*
    mut r := 1
    until r < _RLE_MAX_RUN and i + r < n and (bp[i + r] as int) == (bp[i] as int):
        r++
    end
    ret r
end

@en "RLECompress"
@fa "فشرده سازی طول اجرا"
pub func RLECompress(p: void*, n: int): ByteBuf:
    mut out := NewByteBuf()
    BufPushU32(out, n)
    bp := p as u8*
    mut i := 0
    until i < n:
        r := _rle_run_len(p, n, i)
        if r >= 3:
            BufPush(out, 257 - r)
            BufPush(out, bp[i] as int)
            i += r
        else:
            litstart := i
            mut litlen := 0
            until litlen < _RLE_MAX_RUN and i < n:
                rr := _rle_run_len(p, n, i)
                if rr >= 3: break end
                litlen++
                i++
            end
            BufPush(out, litlen - 1)
            BufPushBytes(out, ((p as i64) + (litstart as i64)) as void*, litlen)
        end
    end
    ret out
end

@en "RLEDecompressMax"
@fa "کدگشایی طول اجرا با سقف"
pub func RLEDecompressMax(p: void*, n: int, max: int, ok &: bool): ByteBuf:
    ok = false
    mut r := NewByteReader(p, n)
    origLen := RdU32(r)
    if r.bad or not _dec_size_ok(origLen, n, max): ret NewByteBuf() end
    mut out := NewByteBufCap(_dec_cap(origLen))
    until BufLen(out) < origLen and not r.bad:
        c := RdByte(r)
        if c <= 127:
            litlen := c + 1
            repeat litlen:
                BufPush(out, RdByte(r))
            end
        else:
            runlen := 257 - c
            b := RdByte(r)
            repeat runlen:
                BufPush(out, b)
            end
        end
    end
    if r.bad or BufLen(out) != origLen:
        BufFree(out)
        ret NewByteBuf()
    end
    ok = true
    ret out
end

@en "RLEDecompress"
@fa "کدگشایی طول اجرا"
pub func RLEDecompress(p: void*, n: int): ByteBuf:
    mut ok := false
    ret RLEDecompressMax(p, n, 0, ok)
end
