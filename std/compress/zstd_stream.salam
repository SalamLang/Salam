package compress

import mem

const _ZSF_DEFAULT_WINDOW := 1073741824
const _ZSF_CLAMP := 2147000000

struct _XxhS:
    pub v1: u64
    pub v2: u64
    pub v3: u64
    pub v4: u64
    pub buf: u8*
    pub bl: int
    pub total: i64
end

func _xxs_new(): _XxhS:
    seed := 0 as u64
    ret _XxhS { v1 = seed + _XX_P1 + _XX_P2, v2 = seed + _XX_P2, v3 = seed, v4 = seed - _XX_P1, buf = mem.Allocate(32 as u64) as u8*, bl = 0, total = 0 as i64 }
end

func _xxs_stripe(x &: _XxhS, bp: u8*, i: int):
    x.v1 = _xx_round(x.v1, _xx_rd64(bp, i))
    x.v2 = _xx_round(x.v2, _xx_rd64(bp, i + 8))
    x.v3 = _xx_round(x.v3, _xx_rd64(bp, i + 16))
    x.v4 = _xx_round(x.v4, _xx_rd64(bp, i + 24))
end

func _xxs_update(x &: _XxhS, p: void*, n: int):
    bp := p as u8*
    x.total += n as i64
    mut i := 0
    if x.bl > 0:
        mut take := 32 - x.bl
        if take > n:
            take = n
        end
        mem.Copy(((x.buf as i64) + (x.bl as i64)) as void*, p, take as u64)
        x.bl += take
        i = take
        if x.bl == 32:
            _xxs_stripe(x, x.buf, 0)
            x.bl = 0
        end
    end
    until i + 32 <= n:
        _xxs_stripe(x, bp, i)
        i += 32
    end
    if i < n:
        rest := n - i
        mem.Copy(((x.buf as i64) + (x.bl as i64)) as void*, ((p as i64) + (i as i64)) as void*, rest as u64)
        x.bl += rest
    end
end

func _xxs_digest(x: _XxhS): u64:
    mut h := x.v3 + _XX_P5
    if x.total >= (32 as i64):
        h = _xx_rotl(x.v1, 1) + _xx_rotl(x.v2, 7) + _xx_rotl(x.v3, 12) + _xx_rotl(x.v4, 18)
        h = _xx_merge(h, x.v1)
        h = _xx_merge(h, x.v2)
        h = _xx_merge(h, x.v3)
        h = _xx_merge(h, x.v4)
    end
    h += x.total as u64
    bp := x.buf
    n := x.bl
    mut i := 0
    until i + 8 <= n:
        h ^= _xx_round(0 as u64, _xx_rd64(bp, i))
        h = _xx_rotl(h, 27) * _XX_P1 + _XX_P4
        i += 8
    end
    if i + 4 <= n:
        h ^= _xx_rd32(bp, i) * _XX_P1
        h = _xx_rotl(h, 23) * _XX_P2 + _XX_P3
        i += 4
    end
    until i < n:
        h ^= (bp[i] as u64) * _XX_P5
        h = _xx_rotl(h, 11) * _XX_P1
        i++
    end
    h ^= h >> 33
    h *= _XX_P2
    h ^= h >> 29
    h *= _XX_P3
    h ^= h >> 32
    ret h
end

func _zsf_drain(d &: _Zd, out &: ByteBuf, sink &: FileSink, xx &: _XxhS, keep: int, ftotal &: i64, all: bool): int:
    mut n := out.len - keep
    if all:
        n = out.len
    end
    if n <= 0:
        ret ZstdOk
    end
    if not SinkWrite(sink, out.data, n):
        ret sink.over ? ZstdErrTooBig : ZstdErrCorrupt
    end
    _xxs_update(xx, out.data, n)
    ftotal += n as i64
    left := out.len - n
    if left > 0:
        mem.MemMove(out.data, ((out.data as i64) + (n as i64)) as void*, left as u64)
    end
    out.len = left
    mut cur := ftotal + (left as i64)
    if cur > (_ZSF_CLAMP as i64):
        cur = _ZSF_CLAMP as i64
    end
    d.fstart = left - (cur as int)
    ret ZstdOk
end

func _zsf_frame(d &: _Zd, fp: void*, pos &: i64, stop: i64, out &: ByteBuf, sink &: FileSink, memcap: i64, buf: u8*): int:
    mut hn := 18
    if stop - pos < (hn as i64):
        hn = (stop - pos) as int
    end
    if hn < 5:
        ret ZstdErrTruncated
    end
    h := buf
    if FileReadAt(fp, pos, h as void*, hn) != hn:
        ret ZstdErrTruncated
    end
    fhd := h[4] as int
    mut hp := 5
    if (fhd & 8) != 0:
        ret ZstdErrFormat
    end
    fcsf := fhd >> 6
    single := (fhd >> 5) & 1
    csum := (fhd >> 2) & 1
    didf := fhd & 3
    mut wd := 0
    if single == 0:
        if hp + 1 > hn:
            ret ZstdErrTruncated
        end
        wd = h[hp] as int
        if wd >> 3 > 21:
            ret ZstdErrFormat
        end
        hp++
    end
    mut dsz := didf
    if didf == 3:
        dsz = 4
    end
    mut fsz := 0
    if fcsf == 0:
        fsz = single
    else fcsf == 1:
        fsz = 2
    else fcsf == 2:
        fsz = 4
    else:
        fsz = 8
    end
    if hp + dsz + fsz > hn:
        ret ZstdErrTruncated
    end
    mut fdid := 0 as i64
    repeat dsz in i:
        fdid |= (h[hp + i] as i64) << (8 * i)
    end
    hp += dsz
    mut fcs := 0 - 1 as i64
    if fsz > 0:
        fcs = 0 as i64
        repeat fsz in i:
            fcs |= (h[hp + i] as i64) << (8 * i)
        end
        if fsz == 2:
            fcs += 256
        end
    end
    hp += fsz
    pos += hp as i64
    _zs_dict_init(d)
    if fdid != 0:
        ret ZstdErrDict
    end
    mut wsize := 0 as i64
    if single == 1:
        wsize = fcs
    else:
        wlog := 10 + (wd >> 3)
        base := (1 as i64) << wlog
        wsize = base + (base >> 3) * ((wd & 7) as i64)
    end
    limit := memcap > (0 as i64) ? memcap : (_ZSF_DEFAULT_WINDOW as i64)
    if wsize > limit:
        ret ZstdErrTooBig
    end
    if sink.cap > (0 as i64) and fcs > sink.cap:
        ret ZstdErrTooBig
    end
    mut keep := wsize as int
    if keep < 131072:
        keep = 131072
    end
    mut xx := _xxs_new()
    mut ftotal := 0 as i64
    out.len = 0
    d.fstart = 0
    mut st := ZstdOk
    mut last := false
    until not last or st != ZstdOk:
        if stop - pos < (3 as i64) or FileReadAt(fp, pos, buf as void*, 3) != 3:
            st = ZstdErrTruncated
            break
        end
        bh := (buf[0] as int) | ((buf[1] as int) << 8) | ((buf[2] as int) << 16)
        pos += 3
        last = (bh & 1) == 1
        bt := (bh >> 1) & 3
        bsz := bh >> 3
        if bt == 3 or bsz > _ZS_MAXBLOCK:
            st = ZstdErrCorrupt
            break
        end
        if bt == 1:
            if stop - pos < (1 as i64) or FileReadAt(fp, pos, buf as void*, 1) != 1:
                st = ZstdErrTruncated
                break
            end
            _buf_grow(out, bsz)
            mem.Set(((out.data as i64) + (out.len as i64)) as void*, buf[0] as int, bsz as u64)
            out.len += bsz
            pos++
        else:
            if stop - pos < (bsz as i64) or FileReadAt(fp, pos, buf as void*, bsz) != bsz:
                st = ZstdErrTruncated
                break
            end
            if bt == 0:
                _buf_grow(out, bsz)
                mem.Copy(((out.data as i64) + (out.len as i64)) as void*, buf as void*, bsz as u64)
                out.len += bsz
            else:
                st = _zs_block(d, out, buf, bsz)
            end
            pos += bsz as i64
        end
        if st == ZstdOk and out.len > keep + 524288:
            st = _zsf_drain(d, out, sink, xx, keep, ftotal, false)
        end
    end
    if st == ZstdOk:
        st = _zsf_drain(d, out, sink, xx, keep, ftotal, true)
    end
    if st == ZstdOk and fcs >= (0 as i64) and ftotal != fcs:
        st = ZstdErrCorrupt
    end
    if st == ZstdOk and csum == 1:
        if stop - pos < (4 as i64) or FileReadAt(fp, pos, buf as void*, 4) != 4:
            st = ZstdErrTruncated
        else:
            want := _zs_le32(buf, 0)
            got := _xxs_digest(xx)
            if ((got & (0xFFFFFFFF as u64)) as i64) != want:
                st = ZstdErrChecksum
            end
            pos += 4
        end
    end
    mem.Free(xx.buf as void*)
    ret st
end

@en "ZstdFileToSink"
@fa "کدگشایی زستد از پرونده به مقصد"
pub func ZstdFileToSink(fp: void*, off: i64, len: i64, sink &: FileSink, memcap: i64): int:
    if fp == null or off < (0 as i64) or len < (4 as i64):
        ret ZstdErrTruncated
    end
    mut d := _zd_new(null, 0)
    d.cap = 2147483000
    mut out := NewByteBuf()
    buf := mem.Allocate((_ZS_MAXBLOCK + 64) as u64) as u8*
    stop := off + len
    mut pos := off
    mut st := ZstdOk
    until pos < stop and st == ZstdOk:
        if stop - pos < (4 as i64) or FileReadAt(fp, pos, buf as void*, 8) < 4:
            st = ZstdErrFormat
            break
        end
        magic := _zs_le32(buf, 0)
        if magic == _ZS_MAGIC:
            st = _zsf_frame(d, fp, pos, stop, out, sink, memcap, buf)
        else (magic & 0xFFFFFFF0) == _ZS_SKIP:
            if stop - pos < (8 as i64):
                st = ZstdErrTruncated
            else:
                sz := _zs_le32(buf, 4)
                if pos + (8 as i64) + sz > stop:
                    st = ZstdErrTruncated
                else:
                    pos += (8 as i64) + sz
                end
            end
        else:
            st = ZstdErrFormat
        end
    end
    BufFree(out)
    mem.Free(buf as void*)
    _zd_free(d)
    ret st
end
