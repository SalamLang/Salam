@en "config"
@fa "پیکربندی"
@ar "إعداد"
package config

import str
import conv
import io
import collections
import encoding.yaml
import encoding.envfile

// A flat, ORDERED key to value model, whatever the source format was.
// Order is what lets FormatINI group sections and FormatEnv reproduce a
// file in the order it was written; the OrderedMap underneath keeps that
// order while still resolving a key without scanning the whole config,
// which matters once a flattened YAML document runs to hundreds of
// dotted keys.
@en "Config"
@fa "پیکربندی"
@ar "إعداد"
pub struct Config:
    pub m: collections.OrderedMap = collections.OrderedMap {}
end

func _yaml_flatten(out &: Config, text: str, path: str):
    keys := yaml.Keys(text, path)
    defer keys.free()
    repeat keys.len() with i:
        k := keys.get(i)
        mut full := k
        if path.len() > 0: full = path.concat(".").concat(k) end
        t := yaml.TypeOf(text, full)
        if t == "map":
            _yaml_flatten(out, text, full)
        else:
            Set(out, full, yaml.Get(text, full))
        end
    end
end

// INI and .env agree on how a scalar is written: optional quotes, an
// inline comment after whitespace, surrounding space ignored. Rather
// than keep a second implementation of those rules here, both go through
// encoding.envfile, which owns them. The `true` says INI also lets ';'
// open an inline comment, which .env does not.
func _parse_value(raw: str): str:
    ret envfile.ParseScalarEx(raw, true)
end

// Config and envfile.Doc are the same shape (flat, ordered, string to
// string), so converting is a copy. These keep the .env format handling
// in one place while Config stays the model the rest of std talks to.
func _from_doc(d &: envfile.Doc): Config:
    mut out := Config {}
    repeat envfile.Len(d) with i:
        Set(out, envfile.KeyAt(d, i), envfile.ValueAt(d, i))
    end
    ret out
end

func _to_doc(c &: Config): envfile.Doc:
    mut d := envfile.New()
    repeat c.m.len() with i:
        envfile.Set(d, c.m.key_at(i), c.m.val_at(i))
    end
    ret d
end

func _section_of(key: str): str:
    dot := key.find(".")
    if dot < 0: ret "" end
    ret key.substr(0, dot)
end

func _name_of(key: str): str:
    dot := key.find(".")
    if dot < 0: ret key end
    ret key.substr(dot + 1, key.len() - dot - 1)
end

@en "New"
@fa "جدید"
@ar "جدید"
pub func New(): Config:
    ret Config {}
end

@en "Len"
@fa "طول"
@ar "طول"
pub func Len(c &: Config): int: ret c.m.len() end

@en "Has"
@fa "دارد"
@ar "یملک"
pub func Has(c &: Config, key: str): bool: ret c.m.has(key) end

@en "Set"
@fa "تنظیم"
@ar "تعیین"
pub func Set(c &: Config, key: str, val: str):
    c.m.set(key, val)
end

@en "Get"
@fa "دریافت"
@ar "جلب"
pub func Get(c &: Config, key: str): str: ret c.m.get(key) end

@en "GetOr"
@fa "دریافت یا"
@ar "جلب أو"
pub func GetOr(c &: Config, key: str, def: str): str: ret c.m.get_or(key, def) end

@en "GetInt"
@fa "دریافت صحیح"
@ar "جلب صحیح"
pub func GetInt(c &: Config, key: str, def: i64): i64:
    i := c.m.index_of(key)
    if i < 0: ret def end
    ret conv.ParseInt(c.m.val_at(i))
end

@en "GetFloat"
@fa "دریافت اعشاری"
@ar "جلب عشری"
pub func GetFloat(c &: Config, key: str, def: f64): f64:
    i := c.m.index_of(key)
    if i < 0: ret def end
    ret conv.ParseFloat(c.m.val_at(i))
end

@en "GetBool"
@fa "دریافت منطقی"
@ar "جلب منطقی"
pub func GetBool(c &: Config, key: str, def: bool): bool:
    i := c.m.index_of(key)
    if i < 0: ret def end
    ret conv.ParseBool(c.m.val_at(i))
end

@en "Remove"
@fa "حذف"
@ar "إزالة"
pub func Remove(c &: Config, key: str): bool:
    ret c.m.remove(key) >= 0
end

@en "Keys"
@fa "کلیدها"
@ar "المفاتیح"
pub func Keys(c &: Config): Vector<str>:
    ret c.m.clone_keys()
end

@en "Section"
@fa "بخش"
@ar "قسم"
pub func Section(c &: Config, name: str): Config:
    mut out := Config {}
    prefix := name.concat(".")
    repeat c.m.len() with i:
        k := c.m.key_at(i)
        if str.StartsWith(k, prefix):
            Set(out, k.substr(prefix.len(), k.len() - prefix.len()), c.m.val_at(i))
        end
    end
    ret out
end

// Merge layers override on top of base (override wins on key conflicts) and
// returns a new Config; base and override are left untouched. Chain calls
// to build up defaults -> file -> env -> flags style layered configuration:
// Merge(Merge(Merge(defaults, file), envCfg), flagsCfg).
@en "Merge"
@fa "ادغام"
@ar "دمج"
pub func Merge(base &: Config, override &: Config): Config:
    mut out := Config {}
    repeat base.m.len() with i:
        Set(out, base.m.key_at(i), base.m.val_at(i))
    end
    repeat override.m.len() with i:
        Set(out, override.m.key_at(i), override.m.val_at(i))
    end
    ret out
end

@en "Free"
@fa "آزادسازی"
@ar "تحریر"
pub func Free(c &: Config):
    c.m.free()
end

@en "ParseINI"
@fa "تجزیه آی ان آی"
@ar "تحلیل إعداد"
pub func ParseINI(text: str): Config:
    mut out := Config {}
    mut section := ""
    lines := text.split("\n")
    defer lines.free()
    repeat lines.len() with i:
        line := str.Trim(lines.get(i))
        mut head := ""
        if line.len() > 0: head = line.substr(0, 1) end
        if head != "" && head != "#" && head != ";":
            if head == "[" && str.EndsWith(line, "]"):
                section = str.Trim(line.substr(1, line.len() - 2))
            else:
                eq := line.find("=")
                if eq > 0:
                    mut key := str.Trim(line.substr(0, eq))
                    val := _parse_value(line.substr(eq + 1, line.len() - eq - 1))
                    if section.len() > 0:
                        key = section.concat(".").concat(key)
                    end
                    Set(out, key, val)
                end
            end
        end
    end
    ret out
end

// ParseEnv reads .env text through encoding.envfile rather than a loop of
// its own, so Config picks up the whole format for free: quoted values
// that span lines, escapes, and ${VAR} references resolved against
// earlier entries. To resolve against the real process environment as
// well, load through std/env instead, which supplies that layer.
@en "ParseEnv"
@fa "تجزیه محیط"
@ar "تحلیل بیئة"
pub func ParseEnv(text: str): Config:
    mut d := envfile.Parse(text)
    defer envfile.Free(d)
    ret _from_doc(d)
end

// ParseYAML flattens a YAML document into dotted keys (nested maps become
// "parent.child" keys), the same shape Section()/ParseINI already use -
// Config stays a single flat key/value model regardless of source format.
@en "ParseYAML"
@fa "تجزیه یامل"
@ar "تحلیل یامل"
pub func ParseYAML(text: str): Config:
    mut out := Config {}
    _yaml_flatten(out, text, "")
    ret out
end

@en "LoadINI"
@fa "بارگذاری آی ان آی"
@ar "تحمیل إعداد"
pub func LoadINI(path: str): Config:
    ret ParseINI(io.ReadFile(path))
end

@en "LoadEnv"
@fa "بارگذاری محیط"
@ar "تحمیل بیئة"
pub func LoadEnv(path: str): Config:
    ret ParseEnv(io.ReadFile(path))
end

@en "LoadYAML"
@fa "بارگذاری یامل"
@ar "تحمیل یامل"
pub func LoadYAML(path: str): Config:
    ret ParseYAML(io.ReadFile(path))
end

@en "FormatINI"
@fa "قالب آی ان آی"
@ar "تنسیق إعداد"
pub func FormatINI(c &: Config): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    repeat c.m.len() with i:
        k := c.m.key_at(i)
        if _section_of(k) == "":
            str.BufAppend(b, k)
            str.BufAppend(b, " = ")
            str.BufAppend(b, envfile.Quote(c.m.val_at(i)))
            str.BufAppend(b, "\n")
        end
    end
    done := Vector {} as Vector<str> defer done.free()
    repeat c.m.len() with i:
        sec := _section_of(c.m.key_at(i))
        if sec != "" && collections.contains(done, sec) == false:
            done.push(sec)
            str.BufAppend(b, "[")
            str.BufAppend(b, sec)
            str.BufAppend(b, "]\n")
            repeat c.m.len() with j:
                kj := c.m.key_at(j)
                if _section_of(kj) == sec:
                    str.BufAppend(b, _name_of(kj))
                    str.BufAppend(b, " = ")
                    str.BufAppend(b, envfile.Quote(c.m.val_at(j)))
                    str.BufAppend(b, "\n")
                end
            end
        end
    end
    out := str.BufStr(b)
    ret out
end

@en "FormatEnv"
@fa "قالب محیط"
@ar "تنسیق بیئة"
pub func FormatEnv(c &: Config): str:
    mut d := _to_doc(c)
    defer envfile.Free(d)
    ret envfile.Format(d)
end

// Same as FormatEnv with an 'export ' on every line, for a file meant to
// be sourced by a shell.
@en "FormatEnvExport"
@fa "قالب محیط صادراتی"
@ar "تنسیق بیئة تصدیر"
pub func FormatEnvExport(c &: Config): str:
    mut d := _to_doc(c)
    defer envfile.Free(d)
    ret envfile.FormatExport(d)
end
