@en "console"
@fa "کنسول"
package console

import mem
import conv.numfmt
import str

extern:
    func printf(fmt: str, ...): int
end

if SALAM_OS_WINDOWS:
    extern:
        func _write(fd: int, buf: void*, n: u32): int
    end
else not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
    extern:
        func write(fd: int, buf: void*, n: u64): i64
    end
else:
    extern:
        func write(fd: int, buf: void*, n: u32): int
    end
end

export:
    func salam_tostr_i32(x: int): str: ret numfmt.FormatInt(x as i64) end
    func salam_tostr_i64(x: i64): str: ret numfmt.FormatInt(x) end
    func salam_tostr_u32(x: u32): str: ret numfmt.FormatUint(x as u64) end
    func salam_tostr_u64(x: u64): str: ret numfmt.FormatUint(x) end
    func salam_tostr_bool(b: bool): str:
        ret str.Clone(numfmt.FormatBool(b))
    end
    func salam_tostr_char(c: char): str:
        ret char_from_code(c as int)
    end
end

if not SALAM_KERNEL:
    export:
        func salam_tostr_f64(x: f64): str: ret numfmt.FormatFloat(x) end
    end
end

if SALAM_OS_WINDOWS:
    func _err_raw(s: str): _write(2, s as void*, s.Len() as u32) end
    func _out_raw(s: str): _write(1, s as void*, s.Len() as u32) end
else not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
    func _err_raw(s: str): write(2, s as void*, s.Len() as u64) end
    func _out_raw(s: str): write(1, s as void*, s.Len() as u64) end
else:
    func _err_raw(s: str): write(2, s as void*, s.Len() as u32) end
    func _out_raw(s: str): write(1, s as void*, s.Len() as u32) end
end

export:
    func salam_emit(s: str, err: int):
        if err != 0:
            _err_raw(s)
        else:
            if SALAM_FREESTANDING:
                _out_raw(s)
            else:
                printf("%s", s)
            end
        end
    end
    func salam_emit_owned(s: str, err: int):
        salam_emit(s, err)
        mem.Free(s as void*)
    end
end
