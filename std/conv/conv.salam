@en "conv"
@fa "تبدیل"
package conv

import conv.numfmt
import mem

func _fill_hex(p: i8*, x: u64, ndigits: int):
    p[ndigits] = 0 as i8
    mut v := x
    mut i := ndigits - 1
    until i >= 0:
        d := (v % (16 as u64)) as int
        if d < 10:
            p[i] = (d + 48) as i8
        else:
            p[i] = (d + 87) as i8
        end
        v /= (16 as u64)
        i--
    end
end

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end


pure func _native_digit(bp: i8*, i: int, n: int): int:
    if i + 1 >= n:
        ret 0 - 1
    end
    c := _ub(bp, i)
    d := _ub(bp, i + 1)
    if c == 219 and d >= 176 and d <= 185:
        ret d - 176
    end
    if c == 217 and d >= 160 and d <= 169:
        ret d - 160
    end
    ret 0 - 1
end

inline pure func _is_space(c: int): bool:
    ret c == 32 or c == 9 or c == 10 or c == 13
end


pure func _kw(bp: i8*, i: int, w: int, kw: str): bool:
    if w != kw.Len(): ret false end
    kp := _bp(kw)
    repeat w in k:
        if bp[i + k] != kp[k]: ret false end
    end
    ret true
end

pure func _kw_ci(bp: i8*, i: int, w: int, kw: str): bool:
    if w != kw.Len(): ret false end
    kp := _bp(kw)
    repeat w in k:
        mut c := _ub(bp, i + k)
        if c >= 65 and c <= 90: c += 32 end
        if c != _ub(kp, k): ret false end
    end
    ret true
end

pure func _lead(bp: i8*, n: int): int:
    mut i := 0
    until i < n and _is_space(_ub(bp, i)):
        i++
    end
    ret i
end

pure func _trail(bp: i8*, i: int, n: int): int:
    mut e := n
    until e > i and _is_space(_ub(bp, e - 1)):
        e--
    end
    ret e
end

func _conv_err(s: str, kind: ErrorKind, message: str, offset: int, code: str): Error:
    bp := _bp(s)
    lim := offset < s.Len() ? offset : s.Len()
    mut line := 1
    mut column := 1
    repeat lim in i:
        b := _ub(bp, i)
        if b == 10:
            line++
            column = 1
        else (b & 192) != 128:
            column++
        end
    end
    ret Error.At(kind, message, offset).with_position(offset, line, column).with_code(code).wrap("conv")
end

pure func _char_desc(s: str, bp: i8*, i: int, n: int): str:
    c := _ub(bp, i)
    if c == 32: ret "space" end
    if c == 9: ret "tab" end
    if c == 10: ret "line break" end
    if c == 13: ret "carriage return" end
    if c > 32 and c < 127: ret "character '" + char_from_code(c) + "'" end
    mut w := 0
    if c >= 194 and c <= 223: w = 2
    else c >= 224 and c <= 239: w = 3
    else c >= 240 and c <= 244: w = 4
    end
    if w > 0 and i + w <= n:
        mut whole := true
        mut k := 1
        until k < w:
            if (_ub(bp, i + k) & 192) != 128: whole = false end
            k++
        end
        if whole: ret "character '" + s.substr(i, w) + "'" end
    end
    hex := "0123456789ABCDEF"
    ret "byte 0x" + hex.substr(c / 16, 1) + hex.substr(c % 16, 1)
end

func _bad_char(s: str, bp: i8*, i: int, n: int): Error:
    ret _conv_err(s, ErrorKind.Syntax, "invalid " + _char_desc(s, bp, i, n), i, "conv.invalid_char")
end

func _empty_err(s: str, at: int): Error:
    ret _conv_err(s, ErrorKind.Syntax, "empty input", at, "conv.empty")
end

func _parse_int(s: str, max_pos: i64, bits: str): i64 throws:
    n := s.Len()
    bp := _bp(s)
    mut i := _lead(bp, n)
    e := _trail(bp, i, n)
    if i >= e:
        throw _empty_err(s, i)
    end
    start := i
    c0 := _ub(bp, i)
    mut neg := false
    if c0 == 45 or c0 == 43:
        neg = c0 == 45
        i++
    end
    lim := neg ? 0 - max_pos - 1 : 0 - max_pos
    mut v := 0 as i64
    mut any := false
    until i < e:
        c := _ub(bp, i)
        mut d := 0 - 1
        mut w := 1
        if c >= 48 and c <= 57:
            d = c - 48
        else:
            d = _native_digit(bp, i, n)
            w = 2
        end
        if d < 0:
            throw _bad_char(s, bp, i, n)
        end
        if v < (lim + (d as i64)) / 10:
            throw _conv_err(s, ErrorKind.OutOfRange, "number does not fit in " + bits, start, "conv.overflow")
        end
        v = v * 10 - (d as i64)
        any = true
        i += w
    end
    if not any:
        throw _conv_err(s, ErrorKind.Syntax, "no digits after '" + char_from_code(c0) + "'", i, "conv.no_digits")
    end
    if neg: ret v end
    ret 0 - v
end

pure func _hex_digit(c: int): int:
    if c >= 48 and c <= 57: ret c - 48
    else c >= 97 and c <= 102: ret c - 87
    else c >= 65 and c <= 70: ret c - 55
    else:
        ret 0 - 1
    end
end

pure func _float_digit(bp: i8*, i: int, n: int): int:
    c := _ub(bp, i)
    if c >= 48 and c <= 57: ret 1 end
    if _native_digit(bp, i, n) >= 0: ret 2 end
    ret 0
end

func _float_check(s: str): int throws:
    n := s.Len()
    bp := _bp(s)
    mut i := _lead(bp, n)
    e := _trail(bp, i, n)
    if i >= e:
        throw _empty_err(s, i)
    end
    start := i
    c0 := _ub(bp, i)
    if c0 == 45 or c0 == 43:
        i++
    end
    w := e - i
    if _kw_ci(bp, i, w, "inf") or _kw_ci(bp, i, w, "infinity") or _kw_ci(bp, i, w, "nan"):
        ret 0 - 1
    end
    mut digits := false
    mut point := false
    until i < e:
        c := _ub(bp, i)
        dw := _float_digit(bp, i, n)
        if dw > 0:
            digits = true
            i += dw
        else not point and c == 46:
            point = true
            i++
        else not point and c == 217 and i + 1 < n and _ub(bp, i + 1) == 171:
            point = true
            i += 2
        else:
            break
        end
    end
    if not digits:
        if i < e:
            throw _bad_char(s, bp, i, n)
        end
        throw _conv_err(s, ErrorKind.Syntax, "no digits after '" + s.substr(start, i - start) + "'", i, "conv.no_digits")
    end
    if i < e and (_ub(bp, i) == 101 or _ub(bp, i) == 69):
        i++
        if i < e and (_ub(bp, i) == 43 or _ub(bp, i) == 45):
            i++
        end
        mut ed := false
        until i < e:
            dw := _float_digit(bp, i, n)
            if dw == 0: break end
            ed = true
            i += dw
        end
        if not ed:
            if i < e:
                throw _bad_char(s, bp, i, n)
            end
            throw _conv_err(s, ErrorKind.Syntax, "no digits in the exponent", i, "conv.no_digits")
        end
    end
    if i < e:
        throw _bad_char(s, bp, i, n)
    end
    ret start
end

if not SALAM_KERNEL:
    func _digits6(d: i64): str:
        mut ds := ""
        mut t := d
        until t > 0:
            ds = char_from_code((t % 10) as int + 48).concat(ds)
            t /= 10
        end
        until ds.Len() > 1 and ds.ends_with("0"):
            ds = ds.substr(0, ds.Len() - 1)
        end
        ret ds
    end

    func _exp_str(e: int): str:
        mut es := "e+"
        mut ea := e
        if e < 0:
            es = "e-"
            ea = 0 - e
        end
        en := FormatInt(ea as i64)
        if ea < 10: ret es.concat("0").concat(en) end
        ret es.concat(en)
    end
end

@en "FormatUint"
@fa "قالب عدد بی علامت"
pub func FormatUint(x: u64): str: ret numfmt.FormatUint(x) end

@en "FormatInt"
@fa "قالب عدد"
pub func FormatInt(n: i64): str: ret numfmt.FormatInt(n) end

@en "FormatBool"
@fa "قالب منطقی"
pub inline pure func FormatBool(b: bool): str:
    if b: ret "true" end
    ret "false"
end

@en "ParseBool"
@fa "تجزیه منطقی"
pub func ParseBool(s: str): bool throws:
    n := s.Len()
    bp := _bp(s)
    i := _lead(bp, n)
    e := _trail(bp, i, n)
    w := e - i
    if w == 0:
        throw _empty_err(s, i)
    end
    if _kw(bp, i, w, "true") or _kw(bp, i, w, "1") or _kw(bp, i, w, "yes") or _kw(bp, i, w, "on"):
        ret true
    end
    if _kw(bp, i, w, "false") or _kw(bp, i, w, "0") or _kw(bp, i, w, "no") or _kw(bp, i, w, "off"):
        ret false
    end
    throw _conv_err(s, ErrorKind.Syntax, "'" + s.substr(i, w) + "' is not a boolean", i, "conv.not_bool")
end

@en "ParseBoolOr"
@fa "تجزیه منطقی با پیش فرض"
pub func ParseBoolOr(s: str, fallback: bool): bool:
    try:
        ret ParseBool(s)
    catch:
        ret fallback
    end
end

@en "ParseInt"
@fa "تجزیه عدد"
pub func ParseInt(s: str): i64 throws:
    ret try _parse_int(s, 9223372036854775807 as i64, "64 bits")
end

@en "ParseIntOr"
@fa "تجزیه عدد با پیش فرض"
pub func ParseIntOr(s: str, fallback: i64): i64:
    try:
        ret ParseInt(s)
    catch:
        ret fallback
    end
end

@en "Atoi"
@fa "رشته به عدد"
pub inline func Atoi(s: str): int throws:
    ret (try _parse_int(s, 2147483647 as i64, "32 bits")) as int
end

@en "AtoiOr"
@fa "رشته به عدد با پیش فرض"
pub func AtoiOr(s: str, fallback: int): int:
    try:
        ret Atoi(s)
    catch:
        ret fallback
    end
end

if not SALAM_KERNEL:
    @en "ParseFloat"
    @fa "تجزیه اعشار"
    pub func ParseFloat(s: str): f64 throws:
        start := try _float_check(s)
        v := numfmt.ScanFloat(s)
        if start >= 0 and v != 0.0 and v / 2.0 == v:
            throw _conv_err(s, ErrorKind.OutOfRange, "number does not fit in a 64-bit float", start, "conv.overflow")
        end
        ret v
    end

    @en "ParseFloatOr"
    @fa "تجزیه اعشار با پیش فرض"
    pub func ParseFloatOr(s: str, fallback: f64): f64:
        try:
            ret ParseFloat(s)
        catch:
            ret fallback
        end
    end

    @en "IsNaNF"
    @fa "نامعتبر است"
    pub inline pure func IsNaNF(x: f64): bool: ret x != x end

    @en "FormatFloat"
    @fa "قالب اعشار"
    pub func FormatFloat(x: f64): str: ret numfmt.FormatFloat(x) end

    @en "FormatFloatShort"
    @fa "قالب اعشار کوتاه"
    pub func FormatFloatShort(x: f64): str:
        if x != x: ret "nan" end
        mut v := x
        mut sign := ""
        if v < 0.0:
            sign = "-"
            v = 0.0 - v
        end
        if v == 0.0: ret sign.concat("0") end
        if v / 2.0 == v: ret sign.concat("inf") end
        mut e := 0
        until v >= 10.0:
            v /= 10.0
            e++
        end
        until v < 1.0:
            v *= 10.0
            e--
        end
        mut d := (v * 100000.0 + 0.5) as i64
        if d >= 1000000:
            d /= 10
            e++
        end
        ds := _digits6(d)
        if e < (0 - 4) or e >= 6:
            mut m := ds.substr(0, 1)
            if ds.Len() > 1:
                m = m.concat(".").concat(ds.substr(1, ds.Len() - 1))
            end
            ret sign.concat(m).concat(_exp_str(e))
        else e >= 0:
            k := e + 1
            if ds.Len() <= k:
                mut out := ds
                mut pad := k - ds.Len()
                until pad > 0:
                    out = out.concat("0")
                    pad--
                end
                ret sign.concat(out)
            end
            ret sign.concat(ds.substr(0, k)).concat(".").concat(ds.substr(k, ds.Len() - k))
        else:
            mut zeros := ""
            mut z := 0 - e - 1
            until z > 0:
                zeros = zeros.concat("0")
                z--
            end
            ret sign.concat("0.").concat(zeros).concat(ds)
        end
    end

    @en "FormatFloatPrec"
    @fa "قالب اعشار با دقت"
    pub func FormatFloatPrec(x: f64, prec: int): str:
        if x != x: ret "nan" end
        mut v := x
        mut sign := ""
        if v < 0.0:
            sign = "-"
            v = 0.0 - v
        end
        if v / 2.0 == v and v > 0.0: ret sign.concat("inf") end
        mut p := prec
        if p < 0: p = 0 end
        if p > 15: p = 15 end
        if v > 900000000000000.0: ret sign.concat(FormatFloat(v)) end
        mut scale := 1 as i64
        repeat p:
            scale *= 10
        end
        total := (v * (scale as f64) + 0.5) as i64
        ip := total / scale
        if p == 0: ret sign.concat(FormatUint(ip as u64)) end
        fp := total % scale
        mut fs := FormatUint(fp as u64)
        until fs.Len() < p:
            fs = "0".concat(fs)
        end
        ret sign.concat(FormatUint(ip as u64)).concat(".").concat(fs)
    end
end

@en "FormatHex"
@fa "قالب شانزده"
pub func FormatHex(x: u64): str:
    mut ndigits := 1
    mut t := x
    until t >= (16 as u64):
        t /= (16 as u64)
        ndigits++
    end
    buf := mem.MustAllocate((ndigits + 1) as u64) as str
    _fill_hex(buf as i8*, x, ndigits)
    ret buf
end

@en "ParseHex"
@fa "تجزیه شانزده"
pub func ParseHex(s: str): i64 throws:
    n := s.Len()
    bp := _bp(s)
    mut i := _lead(bp, n)
    e := _trail(bp, i, n)
    if i >= e:
        throw _empty_err(s, i)
    end
    start := i
    if i + 1 < e and _ub(bp, i) == 48 and _ub(bp, i + 1) == 120:
        i += 2
    end
    mut v := 0 as u64
    mut any := false
    until i < e:
        d := _hex_digit(_ub(bp, i))
        if d < 0:
            throw _bad_char(s, bp, i, n)
        end
        if v > (1152921504606846975 as u64):
            throw _conv_err(s, ErrorKind.OutOfRange, "number does not fit in 64 bits", start, "conv.overflow")
        end
        v = v * (16 as u64) + (d as u64)
        any = true
        i++
    end
    if not any:
        throw _conv_err(s, ErrorKind.Syntax, "no digits after '0x'", i, "conv.no_digits")
    end
    ret v as i64
end

@en "ParseHexOr"
@fa "تجزیه شانزده با پیش فرض"
pub func ParseHexOr(s: str, fallback: i64): i64:
    try:
        ret ParseHex(s)
    catch:
        ret fallback
    end
end
