package conv

const BN_CAP := 264
const BN_BYTES := 1064

const DEC_CHUNK := 1000000000

const POW5_13 := 1220703125
const POW5_13_EXP := 13

const POW2_29_EXP := 29

const MAX_DIGITS := 800
const DIGIT_BUF := 1200

const EXP_BIAS := 1023
const MANT_BITS := 52
const SUBNORMAL_EXP := -1074

const BN_REGS := 7
const OFF_DIGITS := 7448
const OFF_PUN := 8648
pub const SCRATCH_BYTES := 8704

const TWO52 := 0x10000000000000
const TWO53 := 0x20000000000000

mut _scratch := 0 as u64
mut _ready := false

func _bn_len(b: u32*): int:
    ret b[0] as int
end

func _bn_set_len(b: u32*, n: int):
    b[0] = n as u32
end

func _bn_at(b: u32*, i: int): u32:
    ret b[1 + i]
end

func _bn_put(b: u32*, i: int, v: u32):
    b[1 + i] = v
end

func _reg(i: int): u32*:
    r := (_scratch + ((i * BN_BYTES) as u64)) as u32*
    r[0] = 0 as u32
    ret r
end

func _digit_buf(): u8*:
    ret (_scratch + (OFF_DIGITS as u64)) as u8*
end

if SALAM_KERNEL:
else:
    func _pun_bits(v: f64): u64:
        fp := (_scratch + (OFF_PUN as u64)) as f64*
        fp[0] = v
        up := (_scratch + (OFF_PUN as u64)) as u64*
        ret up[0]
    end

    func _pun_f64(bits: u64): f64:
        up := (_scratch + (OFF_PUN as u64)) as u64*
        up[0] = bits
        fp := (_scratch + (OFF_PUN as u64)) as f64*
        ret fp[0]
    end
end

func _bn_zero(b: u32*):
    _bn_set_len(b, 0)
end

func _bn_is_zero(b: u32*): bool:
    ret _bn_len(b) == 0
end

func _bn_from_u64(b: u32*, v: u64):
    if v == (0 as u64):
        _bn_set_len(b, 0)
        ret
    end
    lo := (v & (0xFFFFFFFF as u64)) as u32
    hi := (v >> (32 as u64)) as u32
    _bn_put(b, 0, lo)
    if hi == (0 as u32):
        _bn_set_len(b, 1)
    else:
        _bn_put(b, 1, hi)
        _bn_set_len(b, 2)
    end
end

func _bn_copy(dst: u32*, src: u32*):
    n := _bn_len(src)
    mut i := 0
    until i < n:
        _bn_put(dst, i, _bn_at(src, i))
        i += 1
    end
    _bn_set_len(dst, n)
end

func _bn_trim(b: u32*):
    mut n := _bn_len(b)
    until n > 0 && _bn_at(b, n - 1) == (0 as u32):
        n -= 1
    end
    _bn_set_len(b, n)
end

func _bn_mul_small(b: u32*, m: u32): bool:
    n := _bn_len(b)
    mut carry := 0 as u64
    mut i := 0
    until i < n:
        cur := ((_bn_at(b, i) as u64) * (m as u64)) + carry
        _bn_put(b, i, (cur & (0xFFFFFFFF as u64)) as u32)
        carry = cur >> (32 as u64)
        i += 1
    end
    mut len := n
    until carry != (0 as u64):
        if len >= BN_CAP:
            ret false
        end
        _bn_put(b, len, (carry & (0xFFFFFFFF as u64)) as u32)
        carry = carry >> (32 as u64)
        len += 1
    end
    _bn_set_len(b, len)
    _bn_trim(b)
    ret true
end

func _bn_add_small(b: u32*, a: u32): bool:
    n := _bn_len(b)
    mut carry := a as u64
    mut i := 0
    until i < n && carry != (0 as u64):
        cur := (_bn_at(b, i) as u64) + carry
        _bn_put(b, i, (cur & (0xFFFFFFFF as u64)) as u32)
        carry = cur >> (32 as u64)
        i += 1
    end
    mut len := n
    until carry != (0 as u64):
        if len >= BN_CAP:
            ret false
        end
        _bn_put(b, len, (carry & (0xFFFFFFFF as u64)) as u32)
        carry = carry >> (32 as u64)
        len += 1
    end
    _bn_set_len(b, len)
    ret true
end

func _bn_divmod_small(b: u32*, d: u32): u32:
    n := _bn_len(b)
    mut rem := 0 as u64
    mut i := n - 1
    until i >= 0:
        cur := (rem << (32 as u64)) | (_bn_at(b, i) as u64)
        _bn_put(b, i, (cur / (d as u64)) as u32)
        rem = cur % (d as u64)
        i -= 1
    end
    _bn_trim(b)
    ret rem as u32
end

func _bn_bitlen(b: u32*): int:
    n := _bn_len(b)
    if n == 0:
        ret 0
    end
    top := _bn_at(b, n - 1)
    mut bits := 0
    mut t := top
    until t != (0 as u32):
        bits += 1
        t = t >> (1 as u32)
    end
    ret ((n - 1) * 32) + bits
end

func _bn_shl(b: u32*, k: int): bool:
    if k <= 0 || _bn_len(b) == 0:
        ret true
    end
    limbs := k / 32
    bits := k % 32
    n := _bn_len(b)
    mut newlen := n + limbs
    if bits != 0:
        newlen += 1
    end
    if newlen > BN_CAP:
        ret false
    end
    mut i := newlen - 1
    until i >= 0:
        mut v := 0 as u32
        src := i - limbs
        if src >= 0 && src < n:
            if bits == 0:
                v = _bn_at(b, src)
            else:
                v = _bn_at(b, src) << (bits as u32)
            end
        end
        if bits != 0 && (src - 1) >= 0 && (src - 1) < n:
            v = v | (_bn_at(b, src - 1) >> ((32 - bits) as u32))
        end
        _bn_put(b, i, v)
        i -= 1
    end
    _bn_set_len(b, newlen)
    _bn_trim(b)
    ret true
end

func _bn_shr1(b: u32*):
    n := _bn_len(b)
    if n == 0:
        ret
    end
    mut i := 0
    until i < n:
        mut v := _bn_at(b, i) >> (1 as u32)
        if (i + 1) < n:
            v = v | (_bn_at(b, i + 1) << (31 as u32))
        end
        _bn_put(b, i, v)
        i += 1
    end
    _bn_trim(b)
end

func _bn_cmp(a: u32*, b: u32*): int:
    na := _bn_len(a)
    nb := _bn_len(b)
    if na != nb:
        if na < nb:
            ret -1
        end
        ret 1
    end
    mut i := na - 1
    until i >= 0:
        x := _bn_at(a, i)
        y := _bn_at(b, i)
        if x != y:
            if x < y:
                ret -1
            end
            ret 1
        end
        i -= 1
    end
    ret 0
end

func _bn_sub(a: u32*, b: u32*):
    na := _bn_len(a)
    nb := _bn_len(b)
    mut borrow := 0 as u64
    mut i := 0
    until i < na:
        mut sub := borrow
        if i < nb:
            sub += _bn_at(b, i) as u64
        end
        av := _bn_at(a, i) as u64
        if av >= sub:
            _bn_put(a, i, ((av - sub) & (0xFFFFFFFF as u64)) as u32)
            borrow = 0 as u64
        else:
            _bn_put(a, i, (((av + (0x100000000 as u64)) - sub) & (0xFFFFFFFF as u64)) as u32)
            borrow = 1 as u64
        end
        i += 1
    end
    _bn_trim(a)
end

func _bn_mul_pow5(b: u32*, e: int): bool:
    mut left := e
    until left >= POW5_13_EXP:
        if !_bn_mul_small(b, POW5_13 as u32):
            ret false
        end
        left -= POW5_13_EXP
    end
    mut acc := 1 as u32
    mut i := 0
    until i < left:
        acc = acc * (5 as u32)
        i += 1
    end
    if acc != (1 as u32):
        ret _bn_mul_small(b, acc)
    end
    ret true
end

func _bn_mul_pow10(b: u32*, e: int): bool:
    if !_bn_mul_pow5(b, e):
        ret false
    end
    ret _bn_shl(b, e)
end

func _bn_div(p: u32*, q: u32*, t: u32*): u64:
    bp := _bn_bitlen(p)
    bq := _bn_bitlen(q)
    if bq == 0 || bp < bq:
        ret 0
    end
    n := bp - bq
    _bn_copy(t, q)
    if !_bn_shl(t, n):
        ret 0
    end
    mut quo := 0 as u64
    mut i := n
    until i >= 0:
        quo = quo << (1 as u64)
        if _bn_cmp(t, p) <= 0:
            _bn_sub(p, t)
            quo = quo | (1 as u64)
        end
        _bn_shr1(t)
        i -= 1
    end
    ret quo
end

func _u64_bitlen(v: u64): int:
    mut n := 0
    mut t := v
    until t != (0 as u64):
        n += 1
        t = t >> (1 as u64)
    end
    ret n
end

func _exact_digits(bits: u64, digits: u8*, out: i64*, work: u32*): int:
    be := ((bits >> (52 as u64)) & (0x7FF as u64)) as int
    frac := bits & (0xFFFFFFFFFFFFF as u64)
    mut mant := frac
    mut exp2 := 0
    if be == 0:
        exp2 = SUBNORMAL_EXP
    else:
        mant = frac | (0x10000000000000 as u64)
        exp2 = be - 1075
    end

    if mant == (0 as u64):
        digits[0] = 48 as u8
        out[0] = 0 as i64
        ret 1
    end

    _bn_from_u64(work, mant)
    mut decexp := 0
    if exp2 >= 0:
        if !_bn_shl(work, exp2):
            ret -1
        end
    else:
        j := 0 - exp2
        if !_bn_mul_pow5(work, j):
            ret -1
        end
        decexp = 0 - j
    end

    mut pos := 0
    until !_bn_is_zero(work):
        mut r := _bn_divmod_small(work, DEC_CHUNK as u32)
        mut c := 0
        until c < 9:
            if pos >= DIGIT_BUF:
                ret -1
            end
            digits[pos] = (48 + ((r % (10 as u32)) as int)) as u8
            r = r / (10 as u32)
            pos += 1
            c += 1
        end
    end
    until pos > 1 && digits[pos - 1] == (48 as u8):
        pos -= 1
    end

    mut i := 0
    mut j2 := pos - 1
    until i < j2:
        t := digits[i]
        digits[i] = digits[j2]
        digits[j2] = t
        i += 1
        j2 -= 1
    end
    out[0] = decexp as i64
    ret pos
end

func _round_to(digits: u8*, ndig: int, p: int): int:
    if ndig <= p || p < 1:
        ret 0
    end
    rd := (digits[p] as int) - 48
    mut up := false
    if rd > 5:
        up = true
    else:
        if rd == 5:
            mut sticky := false
            mut i := p + 1
            until i < ndig:
                if digits[i] != (48 as u8):
                    sticky = true
                    i = ndig
                else:
                    i += 1
                end
            end
            if sticky:
                up = true
            else:
                up = (((digits[p - 1] as int) - 48) % 2) == 1
            end
        end
    end
    if !up:
        ret 0
    end
    mut k := p - 1
    until k >= 0:
        if digits[k] == (57 as u8):
            digits[k] = 48 as u8
            k -= 1
        else:
            digits[k] = digits[k] + (1 as u8)
            ret 0
        end
    end
    mut m := p - 1
    until m > 0:
        digits[m] = digits[m - 1]
        m -= 1
    end
    digits[0] = 49 as u8
    ret 1
end

func _put(buf: u8*, cap: int, pos: int, c: u8): int:
    if pos < cap:
        buf[pos] = c
    end
    ret pos + 1
end

func _emit_exponent(buf: u8*, cap: int, start: int, x: int): int:
    mut pos := _put(buf, cap, start, 101 as u8)
    mut v := x
    if v < 0:
        pos = _put(buf, cap, pos, 45 as u8)
        v = 0 - v
    else:
        pos = _put(buf, cap, pos, 43 as u8)
    end
    mut d := [0, 0, 0, 0, 0, 0]
    mut n := 0
    if v == 0:
        n = 1
    else:
        until v > 0:
            d[n] = v % 10
            v = v / 10
            n += 1
        end
    end
    if n < 2:
        n = 2
    end
    mut i := n - 1
    until i >= 0:
        pos = _put(buf, cap, pos, (48 + d[i]) as u8)
        i -= 1
    end
    ret pos
end

func _digit_at(digits: u8*, ndig: int, i: int): u8:
    if i < 0 || i >= ndig:
        ret 48
    end
    ret digits[i]
end

func _format(bits: u64, prec: int, kind: int, buf: u8*, cap: int, digits: u8*, out: i64*, work: u32*): int:
    mut pos := 0
    neg := (bits >> (63 as u64)) != (0 as u64)
    be := ((bits >> (52 as u64)) & (0x7FF as u64)) as int
    frac := bits & (0xFFFFFFFFFFFFF as u64)

    if be == 0x7FF:
        if neg:
            pos = _put(buf, cap, pos, 45 as u8)
        end
        if frac != (0 as u64):
            pos = _put(buf, cap, pos, 110 as u8)
            pos = _put(buf, cap, pos, 97 as u8)
            pos = _put(buf, cap, pos, 110 as u8)
        else:
            pos = _put(buf, cap, pos, 105 as u8)
            pos = _put(buf, cap, pos, 110 as u8)
            pos = _put(buf, cap, pos, 102 as u8)
        end
        ret pos
    end

    ndig0 := _exact_digits(bits, digits, out, work)
    if ndig0 < 0:
        ret -1
    end
    mut ndig := ndig0
    decexp := out[0] as int

    if neg:
        pos = _put(buf, cap, pos, 45 as u8)
    end

    mut x := (ndig - 1) + decexp
    zero := ndig == 1 && digits[0] == (48 as u8)
    if zero:
        x = 0
    end

    mut p := prec
    if kind == 103:
        if p < 1:
            p = 1
        end
    end

    mut style := kind
    if kind == 103:
        if x < -4 || x >= p:
            style = 101
        else:
            style = 102
        end
    end

    mut sig := p
    mut ndec := 0
    if style == 101 && kind != 103:
        sig = p + 1
        ndec = p
    end
    if style == 102 && kind != 103:
        sig = (x + 1) + p
        ndec = p
    end

    if kind == 102 && sig <= 0 && !zero:
        mut carry := false
        if sig == 0:
            rd := (digits[0] as int) - 48
            if rd > 5:
                carry = true
            else:
                if rd == 5:
                    mut i := 1
                    until i < ndig:
                        if digits[i] != (48 as u8):
                            carry = true
                            i = ndig
                        else:
                            i += 1
                        end
                    end
                end
            end
        end
        digits[0] = carry ? (49 as u8) : (48 as u8)
        ndig = 1
        x = carry ? (0 - p) : 0
        sig = 1
    end

    if ndig > sig && sig > 0:
        x += _round_to(digits, ndig, sig)
        ndig = sig
    end

    if kind == 103:
        mut show := sig
        until show > 1 && _digit_at(digits, ndig, show - 1) == (48 as u8):
            show -= 1
        end
        ndec = (show - x) - 1
        if ndec < 0:
            ndec = 0
        end
        if style == 101:
            ndec = show - 1
        end
    end

    if style == 101:
        pos = _put(buf, cap, pos, _digit_at(digits, ndig, 0))
        if ndec > 0:
            pos = _put(buf, cap, pos, 46 as u8)
            mut i := 1
            until i <= ndec:
                pos = _put(buf, cap, pos, _digit_at(digits, ndig, i))
                i += 1
            end
        end
        pos = _emit_exponent(buf, cap, pos, x)
        ret pos
    end

    if x < 0:
        pos = _put(buf, cap, pos, 48 as u8)
    else:
        mut i := 0
        until i <= x:
            pos = _put(buf, cap, pos, _digit_at(digits, ndig, i))
            i += 1
        end
    end
    if ndec > 0:
        pos = _put(buf, cap, pos, 46 as u8)
        mut k := 0
        until k < ndec:
            pos = _put(buf, cap, pos, _digit_at(digits, ndig, (x + 1) + k))
            k += 1
        end
    end
    ret pos
end

func _round_quotient(q: u64, excess: int, sticky: bool): u64:
    if excess <= 0:
        ret q
    end
    mask := ((1 as u64) << (excess as u64)) - (1 as u64)
    dropped := q & mask
    half := (1 as u64) << ((excess - 1) as u64)
    mut m := q >> (excess as u64)
    if dropped > half:
        m += 1 as u64
    else:
        if dropped == half:
            if sticky || (m & (1 as u64)) != (0 as u64):
                m += 1 as u64
            end
        end
    end
    ret m
end

func _encode(neg: bool, m: u64, e2: int): u64:
    mut bits := 0 as u64
    if m == (0 as u64):
        bits = 0 as u64
    else:
        if m < (TWO52 as u64):
            bits = m
        else:
            be := e2 + 1075
            if be >= 2047:
                bits = 0x7FF0000000000000 as u64
            else:
                bits = ((be as u64) << (52 as u64)) | (m & (0xFFFFFFFFFFFFF as u64))
            end
        end
    end
    if neg:
        bits = bits | (0x8000000000000000 as u64)
    end
    ret bits
end

func _decimal_to_bits(neg: bool, d: u32*, nd: int, dexp: int, trunc: bool, p: u32*, q: u32*, t: u32*, p0: u32*, q0: u32*): u64:
    if _bn_is_zero(d):
        ret _encode(neg, 0 as u64, 0)
    end
    mag := (nd + dexp) - 1
    if mag > 309:
        ret _encode(neg, 0 as u64, 0) | (0x7FF0000000000000 as u64) | (neg ? (0x8000000000000000 as u64) : (0 as u64))
    end
    if mag < -400:
        ret _encode(neg, 0 as u64, 0)
    end

    _bn_copy(p0, d)
    _bn_from_u64(q0, 1 as u64)
    if dexp >= 0:
        if !_bn_mul_pow10(p0, dexp):
            ret _encode(neg, 0 as u64, 0)
        end
    else:
        if !_bn_mul_pow10(q0, 0 - dexp):
            ret _encode(neg, 0 as u64, 0)
        end
    end

    bp := _bn_bitlen(p0)
    bq := _bn_bitlen(q0)
    shift := 54 - (bp - bq)
    _bn_copy(p, p0)
    _bn_copy(q, q0)
    if shift > 0:
        if !_bn_shl(p, shift):
            ret _encode(neg, 0 as u64, 0)
        end
    else:
        if !_bn_shl(q, 0 - shift):
            ret _encode(neg, 0 as u64, 0)
        end
    end

    mut quo := _bn_div(p, q, t)
    mut sticky := trunc || !_bn_is_zero(p)
    bl := _u64_bitlen(quo)
    e2 := 0 - shift
    excess := bl - 53
    mut m := _round_quotient(quo, excess, sticky)
    mut fe := e2 + excess
    if m >= (TWO53 as u64):
        m = m >> (1 as u64)
        fe += 1
    end

    if fe < SUBNORMAL_EXP:
        _bn_copy(p, p0)
        _bn_copy(q, q0)
        if !_bn_shl(p, 1075):
            ret _encode(neg, 0 as u64, 0)
        end
        quo = _bn_div(p, q, t)
        sticky = trunc || !_bn_is_zero(p)
        m = _round_quotient(quo, 1, sticky)
        fe = SUBNORMAL_EXP
        if m >= (TWO52 as u64):
            ret _encode(neg, m, fe)
        end
        mut bits := m
        if neg:
            bits = bits | (0x8000000000000000 as u64)
        end
        ret bits
    end

    if (fe + 1075) >= 2047:
        mut inf := 0x7FF0000000000000 as u64
        if neg:
            inf = inf | (0x8000000000000000 as u64)
        end
        ret inf
    end
    ret _encode(neg, m, fe)
end

func _is_digit(c: int): bool:
    ret c >= 48 && c <= 57
end

func _lower(c: int): int:
    if c >= 65 && c <= 90:
        ret c + 32
    end
    ret c
end

inline func _byte(s: i8*, i: int): int:
    ret _ub(s, i)
end

func _strtod_core(sp: i8*, out: i64*): u64:
    mut i := 0
    mut c := _byte(sp, i)
    until c == 32 || (c >= 9 && c <= 13):
        i += 1
        c = _byte(sp, i)
    end

    mut neg := false
    if c == 43 || c == 45:
        neg = c == 45
        i += 1
        c = _byte(sp, i)
    end

    if _lower(c) == 105:
        if _lower(_byte(sp, i + 1)) == 110 && _lower(_byte(sp, i + 2)) == 102:
            mut j := i + 3
            if _lower(_byte(sp, j)) == 105 && _lower(_byte(sp, j + 1)) == 110 && _lower(_byte(sp, j + 2)) == 105 && _lower(_byte(sp, j + 3)) == 116 && _lower(_byte(sp, j + 4)) == 121:
                j += 5
            end
            out[0] = j as i64
            mut b := 0x7FF0000000000000 as u64
            if neg:
                b = b | (0x8000000000000000 as u64)
            end
            ret b
        end
    end
    if _lower(c) == 110:
        if _lower(_byte(sp, i + 1)) == 97 && _lower(_byte(sp, i + 2)) == 110:
            out[0] = (i + 3) as i64
            mut b := 0x7FF8000000000000 as u64
            if neg:
                b = b | (0x8000000000000000 as u64)
            end
            ret b
        end
    end

    d := _reg(0)
    _bn_zero(d)

    mut nd := 0
    mut dexp := 0
    mut seen_point := false
    mut any := false
    mut trunc := false
    mut ok := true

    c = _byte(sp, i)
    until _is_digit(c) || (c == 46 && !seen_point):
        if c == 46:
            seen_point = true
            i += 1
            c = _byte(sp, i)
        else:
            any = true
            v := c - 48
            if nd == 0 && v == 0:
                if seen_point:
                    dexp -= 1
                end
            else:
                if nd < MAX_DIGITS:
                    if !_bn_mul_small(d, 10 as u32):
                        ok = false
                    end
                    if !_bn_add_small(d, v as u32):
                        ok = false
                    end
                    nd += 1
                    if seen_point:
                        dexp -= 1
                    end
                else:
                    if v != 0:
                        trunc = true
                    end
                    if !seen_point:
                        dexp += 1
                    end
                end
            end
            i += 1
            c = _byte(sp, i)
        end
    end

    if !any:
        out[0] = 0 as i64
        ret 0
    end

    mut endpos := i
    if _lower(c) == 101:
        mut j := i + 1
        mut esign := 1
        ec := _byte(sp, j)
        if ec == 43 || ec == 45:
            if ec == 45:
                esign = -1
            end
            j += 1
        end
        if _is_digit(_byte(sp, j)):
            mut ev := 0
            until _is_digit(_byte(sp, j)):
                if ev < 100000:
                    ev = (ev * 10) + (_byte(sp, j) - 48)
                end
                j += 1
            end
            dexp += esign * ev
            endpos = j
        end
    end
    out[0] = endpos as i64

    if !ok:
        ret _encode(neg, 0 as u64, 0)
    end

    bits := _decimal_to_bits(neg, d, nd, dexp, trunc, _reg(1), _reg(2), _reg(3), _reg(4), _reg(5))
    ret bits
end

func _dtoa_into(bits: u64, prec: int, kind: int, out: u8*, cap: int): int:
    if !_dtoa_ready():
        ret -1
    end
    outv := (_scratch + (OFF_PUN as u64)) as i64*
    n := _format(bits, prec, kind, out, cap, _digit_buf(), outv, _reg(6))
    if cap > 0 && n >= 0:
        if n < cap:
            out[n] = 0 as u8
        else:
            out[cap - 1] = 0 as u8
        end
    end
    ret n
end

func _dtoa_ready(): bool:
    if _scratch == (0 as u64):
        b := malloc(SCRATCH_BYTES as u64)
        if b == null:
            ret false
        end
        _scratch = b as u64
    end
    ret true
end

if SALAM_KERNEL:
else:
    func _dtoa_shortest(v: f64, out: void*, cap: int): int:
        if !_dtoa_ready():
            ret -1
        end
        bits := _pun_bits(v)
        mut prec := 15
        until prec < 17:
            n := _dtoa_into(bits, prec, 103, out as u8*, cap)
            if n > 0 && n < cap:
                if _pun_bits(_dtoa_parse(out as str, null)) == bits:
                    ret n
                end
            end
            prec += 1
        end
        ret _dtoa_into(bits, 17, 103, out as u8*, cap)
    end

    func _dtoa_parse(s: str, endp: void*): f64:
        if !_dtoa_ready() || (s as void*) as u64 == (0 as u64):
            ret 0.0
        end
        outv := (_scratch + (OFF_PUN as u64)) as i64*
        outv[0] = 0 as i64
        bits := _strtod_core(_bp(s), outv)
        if (endp as u64) != (0 as u64):
            e := (endp as u64) as u64*
            e[0] = ((s as void*) as u64) + (outv[0] as u64)
        end
        ret _pun_f64(bits)
    end
end
