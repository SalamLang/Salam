@en "core"
@fa "هسته"
@ar "نواة"
package core

import mem
import conv
import map
import str
import text
import console
import fs
import thread

extern:
    func getchar(): int
    pure func strcmp(a: str, b: str): int
    pure func strstr(haystack: str, needle: str): str
    func strtol(s: str, endptr: void*, base: int): i64
    func strtod(s: str, endptr: void*): f64
    pure func strlen(s: str): u64
    noret func abort()
end

// Not `_argc`/`_argv`: codegen escapes a leading `_` to `__`, and
// `__argc`/`__argv` are exactly what mingw-w64's <stdlib.h> declares (as
// macros over __p___argc()/__p___argv()). Any translation unit that pulls
// stdlib.h in - which every GUI-mode module does, via windows.h - then had
// two incompatible declarations of the same name and gcc rejected the file
// outright. tcc never includes stdlib.h here, so this only showed up when
// the C backend was pointed at gcc.
mut _salam_argc := 0
mut _salam_argv := null as void*

func _strptr(s: str): i64:
    v := s as void*
    ret v as i64
end

extern:
    /*
     * The hash entry points behind the generic HashMap. They live in core
     * because a HashMap<K,V> instantiation is emitted into the header of
     * whichever module first uses the map, and that module has no reason to
     * import crypto - core is one of the two packages the driver always
     * links, so the symbol is always there to resolve against.
     */
    func salam_str_hash(s: str): u64:
        bp := (s as void*) as i8*
        mut h := 14695981039346656037 as u64
        mut j := 0
        until bp[j] != 0:
            mut c := bp[j] as int
            if c < 0: c = c + 256 end
            h *= 1099511628211
            h += (c as u64)
            j += 1
        end
        ret h
    end
    func salam_hash_int(x: u64): u64:
        mut h := x + 14695981039346656037
        h *= 1099511628211
        h += 1099511628211
        h *= 1099511628211
        ret h
    end
    func salam_idx(idx: i64, len: i64): i64:
        if idx < 0 || idx >= len:
            printerrln "salam: array index ".concat(conv.FormatInt(idx)).concat(" out of bounds [0,").concat(conv.FormatInt(len)).concat(")")
            abort()
        end
        ret idx
    end
    noret func salam_panic(msg: str):
        printerrln "salam panic: ".concat(msg)
        abort()
    end
    func salam_input(): str:
        mut sb := str.NewBuilder()
        defer str.BufFree(sb)
        mut c := getchar()
        until c != -1 && c != 10:
            str.BufAppendChar(sb, c)
            c = getchar()
        end
        out := str.BufStr(sb)
        ret out
    end
    func salam_set_args(argc: int, argv: void*):
        _salam_argc = argc
        _salam_argv = argv
    end
    // Indexed as `str*`, not `i64*`: argv is an array of pointers, and on a
    // 32-bit host those are 4 bytes each. Reading it through an i64* view
    // fetched two argv entries glued together as one address, and the
    // strlen() on that garbage pointer segfaulted before main ever ran -
    // which is what a 32-bit self-hosted build died of on startup. sizeof
    // keeps the allocation in step with the element type.
    func salam_args(out_count: void*): void*:
        oc := out_count as int*
        n := _salam_argc
        mut slots := n
        if slots < 1: slots = 1 end
        arr := mem.Allocate((slots as u64) * (sizeof(str) as u64)) as str*
        av := _salam_argv as str*
        repeat n with i:
            s := av[i]
            arr[i] = s.substr(0, s.len())
        end
        oc[0] = n
        ret arr as void*
    end
end

@en "Panic"
@fa "خطای مرگبار"
@ar "خطأ فادح"
pub noret func Panic(msg: str): salam_panic(msg) end
