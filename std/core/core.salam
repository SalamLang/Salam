@en "core"
@fa "هسته"
package core

import mem
import conv
import map
import str
import text
import console

if not SALAM_FREESTANDING:
    import fs
    import thread
end

extern:
    func getchar(): int
    pure func strcmp(a: str, b: str): int
    pure func strstr(haystack: str, needle: str): str
    func strtol(s: str, endptr: void*, base: int): i64
    func strtod(s: str, endptr: void*): f64
    pure func strlen(s: str): u64
    noret func abort()
    noret func exit(code: int)
end

mut _salam_argc := 0
mut _salam_argv := null as void*

@en "ErrorKind"
@fa "نوع خطا"
pub enum ErrorKind:
    @en "Other"
    @fa "دیگر"
    Other
    @en "Syntax"
    @fa "نحو"
    Syntax
    @en "UnexpectedEnd"
    @fa "اتمام ناگهانی"
    UnexpectedEnd
    @en "TypeMismatch"
    @fa "ناهمخوانی نوع"
    TypeMismatch
    @en "MissingKey"
    @fa "کلید ناموجود"
    MissingKey
    @en "OutOfRange"
    @fa "خارج از بازه"
    OutOfRange
    @en "InvalidUtf8"
    @fa "یوتی‌اف۸ نامعتبر"
    InvalidUtf8
    @en "InvalidArgument"
    @fa "آرگومان نامعتبر"
    InvalidArgument
    @en "NotFound"
    @fa "یافت نشد"
    NotFound
    @en "AlreadyExists"
    @fa "از قبل موجود"
    AlreadyExists
    @en "PermissionDenied"
    @fa "دسترسی رد شد"
    PermissionDenied
    @en "Io"
    @fa "ورودی خروجی"
    Io
    @en "Timeout"
    @fa "اتمام زمان"
    Timeout
    @en "Canceled"
    @fa "لغو شد"
    Canceled
    @en "Unavailable"
    @fa "ناموجود"
    Unavailable
    @en "Unsupported"
    @fa "پشتیبانی نشده"
    Unsupported
    @en "Internal"
    @fa "داخلی"
    Internal
end

@en "Error"
@fa "خطا"
pub struct Error:
    @en "kind"
    @fa "نوع"
    pub kind: ErrorKind = ErrorKind.Other
    @en "code"
    @fa "کد"
    pub code: str = ""
    @en "message"
    @fa "پیام"
    pub message: str = ""
    @en "context"
    @fa "زمینه"
    pub context: str = ""
    @en "path"
    @fa "مسیر"
    pub path: str = ""
    @en "offset"
    @fa "جایگاه"
    pub offset: int = 0 - 1
    @en "line"
    @fa "خط"
    pub line: int = 0
    @en "column"
    @fa "ستون"
    pub column: int = 0

    @en "New"
    @fa "جدید"
    pub static func New(kind: ErrorKind, message: str): Error:
        ret Error { kind = kind, message = message }
    end

    @en "At"
    @fa "در جایگاه"
    pub static func At(kind: ErrorKind, message: str, offset: int): Error:
        ret Error { kind = kind, message = message, offset = offset }
    end

    @en "is"
    @fa "است"
    pub func is(kind: ErrorKind): bool:
        ret this.kind == kind
    end

    @en "wrap"
    @fa "بپیچ"
    pub func wrap(message: str): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        if out.context == "":
            out.context = message
        else:
            out.context = message + ": " + out.context
        end
        ret out
    end

    @en "with_code"
    @fa "با کد"
    pub func with_code(code: str): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        out.code = code
        ret out
    end

    @en "with_path"
    @fa "با مسیر"
    pub func with_path(path: str): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        out.path = path
        ret out
    end

    @en "with_position"
    @fa "با موقعیت"
    pub func with_position(offset: int, line: int, column: int): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        out.offset = offset
        out.line = line
        out.column = column
        ret out
    end

    @en "kind_name"
    @fa "نام نوع"
    pub func kind_name(): str:
        ret _error_kind_text(this.kind)
    end

    @en "to_str"
    @fa "به رشته"
    pub func to_str(): str:
        mut out := this.message
        if out == "":
            out = _error_kind_text(this.kind)
        end
        if this.context != "":
            out = this.context + ": " + out
        end
        if this.path != "":
            out = out + " at " + this.path
        end
        if this.line > 0:
            out = out + " (line " + this.line + ", column " + this.column + ")"
        else this.offset >= 0:
            out = out + " (offset " + this.offset + ")"
        end
        ret out
    end
end

@en "Throws"
@fa "نتیجه پرتاب"
pub enum Throws<T>:
    @en "Ok"
    @fa "موفق"
    Ok(value: T)
    @en "Err"
    @fa "ناموفق"
    Err(error: Error)
end

func _error_kind_text(kind: ErrorKind): str:
    ret match kind:
        ErrorKind.Syntax: "syntax error" end
        ErrorKind.UnexpectedEnd: "unexpected end of input" end
        ErrorKind.TypeMismatch: "type mismatch" end
        ErrorKind.MissingKey: "missing key" end
        ErrorKind.OutOfRange: "out of range" end
        ErrorKind.InvalidUtf8: "invalid UTF-8" end
        ErrorKind.InvalidArgument: "invalid argument" end
        ErrorKind.NotFound: "not found" end
        ErrorKind.AlreadyExists: "already exists" end
        ErrorKind.PermissionDenied: "permission denied" end
        ErrorKind.Io: "I/O error" end
        ErrorKind.Timeout: "timed out" end
        ErrorKind.Canceled: "canceled" end
        ErrorKind.Unavailable: "unavailable" end
        ErrorKind.Unsupported: "unsupported" end
        ErrorKind.Internal: "internal error" end
        ErrorKind.Other: "error" end
    end
end

func _strptr(s: str): i64:
    v := s as void*
    ret v as i64
end

noret func _core_oom():
    printerrln "salam: out of memory"
    abort()
end

func _core_alloc(n: u64): void*:
    p := mem.Allocate(n)
    if p == null:
        _core_oom()
    end
    ret p
end

export:
    func salam_str_hash(s: str): u64:
        bp := (s as void*) as i8*
        mut h := 14695981039346656037 as u64
        mut j := 0
        until bp[j] != 0:
            mut c := bp[j] as int
            if c < 0: c = c + 256 end
            h *= 1099511628211
            h += (c as u64)
            j += 1
        end
        ret h
    end
    func salam_hash_int(x: u64): u64:
        mut h := x + 14695981039346656037
        h *= 1099511628211
        h += 1099511628211
        h *= 1099511628211
        ret h
    end
    func salam_idx(idx: i64, len: i64): i64:
        if idx < 0 or idx >= len:
            printerrln "salam: array index ".concat(conv.FormatInt(idx)).concat(" out of bounds [0,").concat(conv.FormatInt(len)).concat(")")
            abort()
        end
        ret idx
    end
    func salam_div0(kind: int): i64:
        printerrln kind == 1 ? "runtime error: modulo by zero" : "runtime error: division by zero"
        if SALAM_FREESTANDING:
            abort()
        else:
            exit(1)
        end
    end
    noret func salam_panic(msg: str):
        printerrln "salam panic: ".concat(msg)
        abort()
    end
    func salam_input(): str:
        mut sb := str.NewBuilder()
        defer str.BufFree(sb)
        mut c := getchar()
        until c != -1 and c != 10:
            str.BufAppendChar(sb, c)
            c = getchar()
        end
        out := str.BufStr(sb)
        ret out
    end
    func salam_set_args(argc: int, argv: void*):
        _salam_argc = argc
        _salam_argv = argv
    end
    func salam_args(out_count: void*): void*:
        oc := out_count as int*
        n := _salam_argc
        mut slots := n
        if slots < 1: slots = 1 end
        arr := _core_alloc((slots as u64) * (sizeof(str) as u64)) as str*
        av := _salam_argv as str*
        repeat n in i:
            s := av[i]
            arr[i] = s.substr(0, s.len())
        end
        oc[0] = n
        ret arr as void*
    end
end

@en "Panic"
@fa "خطای مرگبار"
pub noret func Panic(msg: str): salam_panic(msg) end
