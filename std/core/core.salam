@en "core"
@fa "هسته"
package core

import mem
import conv.numfmt
import map
import str
import text
import console

if not SALAM_FREESTANDING:
    import thread
end

extern:
    func getchar(): int
    pure func strcmp(a: str, b: str): int
    pure func strstr(haystack: str, needle: str): str
    func strtol(s: str, endptr: void*, base: int): i64
    func strtod(s: str, endptr: void*): f64
    pure func strlen(s: str): u64
    noret func abort()
    noret func exit(code: int)
end

mut _salam_argc := 0
mut _salam_argv := null as void*

@en "ErrorKind"
@fa "نوع خطا"
pub enum ErrorKind:
    @en "Other"
    @fa "دیگر"
    Other
    @en "Syntax"
    @fa "نحو"
    Syntax
    @en "UnexpectedEnd"
    @fa "اتمام ناگهانی"
    UnexpectedEnd
    @en "TypeMismatch"
    @fa "ناهمخوانی نوع"
    TypeMismatch
    @en "MissingKey"
    @fa "کلید ناموجود"
    MissingKey
    @en "OutOfRange"
    @fa "خارج از بازه"
    OutOfRange
    @en "InvalidUtf8"
    @fa "یوتی‌اف۸ نامعتبر"
    InvalidUtf8
    @en "InvalidArgument"
    @fa "آرگومان نامعتبر"
    InvalidArgument
    @en "NotFound"
    @fa "یافت نشد"
    NotFound
    @en "AlreadyExists"
    @fa "از قبل موجود"
    AlreadyExists
    @en "PermissionDenied"
    @fa "دسترسی رد شد"
    PermissionDenied
    @en "Io"
    @fa "ورودی خروجی"
    Io
    @en "Timeout"
    @fa "اتمام زمان"
    Timeout
    @en "Canceled"
    @fa "لغو شد"
    Canceled
    @en "Unavailable"
    @fa "ناموجود"
    Unavailable
    @en "Unsupported"
    @fa "پشتیبانی نشده"
    Unsupported
    @en "Internal"
    @fa "داخلی"
    Internal
end

@en "Error"
@fa "خطا"
pub struct Error:
    @en "kind"
    @fa "نوع"
    pub kind: ErrorKind = ErrorKind.Other
    @en "code"
    @fa "کد"
    pub code: str = ""
    @en "message"
    @fa "پیام"
    pub message: str = ""
    @en "context"
    @fa "زمینه"
    pub context: str = ""
    @en "path"
    @fa "مسیر"
    pub path: str = ""
    @en "offset"
    @fa "جایگاه"
    pub offset: int = 0 - 1
    @en "line"
    @fa "خط"
    pub line: int = 0
    @en "column"
    @fa "ستون"
    pub column: int = 0

    @en "New"
    @fa "جدید"
    pub static func New(kind: ErrorKind, message: str): Error:
        ret Error { kind = kind, message = message }
    end

    @en "At"
    @fa "در جایگاه"
    pub static func At(kind: ErrorKind, message: str, offset: int): Error:
        ret Error { kind = kind, message = message, offset = offset }
    end

    @en "Is"
    @fa "است"
    pub func Is(kind: ErrorKind): bool:
        ret this.kind == kind
    end

    @en "is"
    @fa "است"
    pub func is(kind: ErrorKind): bool: ret this.Is(kind) end

    @en "Wrap"
    @fa "بپیچ"
    pub func Wrap(message: str): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        if out.context == "":
            out.context = message
        else:
            out.context = message + ": " + out.context
        end
        ret out
    end

    @en "wrap"
    @fa "بپیچ"
    pub func wrap(message: str): Error: ret this.Wrap(message) end

    @en "WithCode"
    @fa "با کد"
    pub func WithCode(code: str): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        out.code = code
        ret out
    end

    @en "with_code"
    @fa "با کد"
    pub func with_code(code: str): Error: ret this.WithCode(code) end

    @en "WithPath"
    @fa "با مسیر"
    pub func WithPath(path: str): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        out.path = path
        ret out
    end

    @en "with_path"
    @fa "با مسیر"
    pub func with_path(path: str): Error: ret this.WithPath(path) end

    @en "WithPosition"
    @fa "با موقعیت"
    pub func WithPosition(offset: int, line: int, column: int): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        out.offset = offset
        out.line = line
        out.column = column
        ret out
    end

    @en "with_position"
    @fa "با موقعیت"
    pub func with_position(offset: int, line: int, column: int): Error: ret this.WithPosition(offset, line, column) end

    @en "Locate"
    @fa "مکان یابی"
    pub func Locate(text: str): Error:
        mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
        if this.offset < 0:
            ret out
        end
        n := text.Len()
        lim := this.offset < n ? this.offset : n
        head := text.Substr(0, lim)
        mut lines := head.Split("\n")
        line := lines.Len() > 0 ? lines.Len() : 1
        column := lines.Len() > 0 ? lines.Get(lines.Len() - 1).CharCount() + 1 : 1
        lines.Free()
        out.line = line
        out.column = column
        ret out
    end

    @en "locate"
    @fa "مکان یابی"
    pub func locate(text: str): Error: ret this.Locate(text) end

    @en "KindName"
    @fa "نام نوع"
    pub func KindName(): str:
        ret _error_kind_text(this.kind)
    end

    @en "kind_name"
    @fa "نام نوع"
    pub func kind_name(): str: ret this.KindName() end

    @en "ToStr"
    @fa "به رشته"
    pub func ToStr(): str:
        mut out := this.message
        if out == "":
            out = _error_kind_text(this.kind)
        end
        if this.context != "":
            out = this.context + ": " + out
        end
        if this.path != "":
            out = out + " at " + this.path
        end
        if this.line > 0:
            out = out + " (line " + this.line + ", column " + this.column + ")"
        else this.offset >= 0:
            out = out + " (offset " + this.offset + ")"
        end
        ret out
    end

    @en "to_str"
    @fa "به رشته"
    pub func to_str(): str: ret this.ToStr() end
end

@en "Throws"
@fa "نتیجه پرتاب"
pub enum Throws<T>:
    @en "Ok"
    @fa "موفق"
    Ok(value: T)
    @en "Err"
    @fa "ناموفق"
    Err(error: Error)
end

pub struct Tuple2<A, B>:
    pub f0: A
    pub f1: B
end

pub struct Tuple3<A, B, C>:
    pub f0: A
    pub f1: B
    pub f2: C
end

pub struct Tuple4<A, B, C, D>:
    pub f0: A
    pub f1: B
    pub f2: C
    pub f3: D
end

pub struct Tuple5<A, B, C, D, E>:
    pub f0: A
    pub f1: B
    pub f2: C
    pub f3: D
    pub f4: E
end

pub struct Tuple6<A, B, C, D, E, F>:
    pub f0: A
    pub f1: B
    pub f2: C
    pub f3: D
    pub f4: E
    pub f5: F
end

pub struct Tuple7<A, B, C, D, E, F, G>:
    pub f0: A
    pub f1: B
    pub f2: C
    pub f3: D
    pub f4: E
    pub f5: F
    pub f6: G
end

pub struct Tuple8<A, B, C, D, E, F, G, H>:
    pub f0: A
    pub f1: B
    pub f2: C
    pub f3: D
    pub f4: E
    pub f5: F
    pub f6: G
    pub f7: H
end

@en "Option"
@fa "اختیاری"
pub struct Option<T>:
    @en "value"
    @fa "مقدار"
    pub value: T
    @en "present"
    @fa "موجود"
    pub present: bool

    @en "IsSome"
    @fa "دارد"
    pub func IsSome(): bool: ret this.present
    end

    @en "is_some"
    @fa "دارد"
    pub func is_some(): bool: ret this.IsSome() end

    @en "IsNone"
    @fa "ندارد"
    pub func IsNone(): bool: ret this.present == false
    end

    @en "is_none"
    @fa "ندارد"
    pub func is_none(): bool: ret this.IsNone() end

    @en "UnwrapOr"
    @fa "یابرگردان"
    pub func UnwrapOr(fallback: T): T:
        if this.present: ret this.value end
        ret fallback
    end

    @en "unwrap_or"
    @fa "یابرگردان"
    pub func unwrap_or(fallback: T): T: ret this.UnwrapOr(fallback) end

    @en "Unwrap"
    @fa "بازکن"
    pub func Unwrap(): T:
        if this.present == false: salam_panic("called unwrap on a None value") end
        ret this.value
    end

    @en "unwrap"
    @fa "بازکن"
    pub func unwrap(): T: ret this.Unwrap() end
end

func _error_kind_text(kind: ErrorKind): str:
    ret match kind:
        ErrorKind.Syntax: "syntax error" end
        ErrorKind.UnexpectedEnd: "unexpected end of input" end
        ErrorKind.TypeMismatch: "type mismatch" end
        ErrorKind.MissingKey: "missing key" end
        ErrorKind.OutOfRange: "out of range" end
        ErrorKind.InvalidUtf8: "invalid UTF-8" end
        ErrorKind.InvalidArgument: "invalid argument" end
        ErrorKind.NotFound: "not found" end
        ErrorKind.AlreadyExists: "already exists" end
        ErrorKind.PermissionDenied: "permission denied" end
        ErrorKind.Io: "I/O error" end
        ErrorKind.Timeout: "timed out" end
        ErrorKind.Canceled: "canceled" end
        ErrorKind.Unavailable: "unavailable" end
        ErrorKind.Unsupported: "unsupported" end
        ErrorKind.Internal: "internal error" end
        ErrorKind.Other: "error" end
    end
end

func _strptr(s: str): i64:
    v := s as void*
    ret v as i64
end

func _w128_div_small(lo: u64, hi: u64, d: u64, ql &: u64, qh &: u64, r &: u64):
    mask := 4294967295 as u64
    c3 := hi >> 32
    q3 := c3 / d
    c2 := ((c3 % d) << 32) | (hi & mask)
    q2 := c2 / d
    c1 := ((c2 % d) << 32) | (lo >> 32)
    q1 := c1 / d
    c0 := ((c1 % d) << 32) | (lo & mask)
    q0 := c0 / d
    ql = (q1 << 32) | q0
    qh = (q3 << 32) | q2
    r = c0 % d
end

export:
    func salam_str_hash(s: str): u64:
        bp := (s as void*) as i8*
        mut h := 14695981039346656037 as u64
        mut j := 0
        until bp[j] != 0:
            mut c := bp[j] as int
            if c < 0: c += 256 end
            h *= 1099511628211
            h += (c as u64)
            j++
        end
        ret h
    end
    func salam_hash_int(x: u64): u64:
        mut h := x + 14695981039346656037
        h *= 1099511628211
        h += 1099511628211
        h *= 1099511628211
        ret h
    end
    func salam_idx(idx: i64, len: i64): i64:
        if idx < 0 or idx >= len:
            printerrln "salam: array index ".Concat(numfmt.FormatInt(idx)).Concat(" out of bounds [0,").Concat(numfmt.FormatInt(len)).Concat(")")
            abort()
        end
        ret idx
    end
    func salam_div0(kind: int): i64:
        printerrln kind == 1 ? "runtime error: modulo by zero" : "runtime error: division by zero"
        if SALAM_FREESTANDING:
            abort()
        else:
            exit(1)
        end
    end
    func salam_w128_str(lo: u64, hi: u64, sgn: int): str:
        mut a := lo
        mut b := hi
        neg := sgn != 0 and (hi >> 63) != 0
        if neg:
            a = 0 - lo
            b = (0 - hi) - (lo != 0 ? 1 as u64 : 0 as u64)
        end
        if b == 0 and not neg:
            ret numfmt.FormatUint(a)
        end
        buf := mem.MustAllocate(48 as u64) as char*
        mut i := 47
        buf[i] = 0 as char
        until (a | b) != 0 or i == 47:
            mut piece := 0 as u64
            _w128_div_small(a, b, 1000000000 as u64, a, b, piece)
            mut left := 9
            until left > 0 and (piece != 0 or (a | b) != 0):
                i--
                buf[i] = (48 + ((piece % 10) as int)) as char
                piece /= 10
                left--
            end
        end
        if neg:
            i--
            buf[i] = 45 as char
        end
        mut j := 0
        until i <= 47:
            buf[j] = buf[i]
            j++
            i++
        end
        ret buf as str
    end
    func salam_w128_divmod(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64, mode: int, out: u64*):
        if (b_lo | b_hi) == 0:
            _r := salam_div0((mode >> 1) & 1)
        end
        sgn := (mode & 1) != 0
        na := sgn and (a_hi >> 63) != 0
        nb := sgn and (b_hi >> 63) != 0
        mut xl := a_lo
        mut xh := a_hi
        mut yl := b_lo
        mut yh := b_hi
        if na:
            xl = 0 - a_lo
            xh = (0 - a_hi) - (a_lo != 0 ? 1 as u64 : 0 as u64)
        end
        if nb:
            yl = 0 - b_lo
            yh = (0 - b_hi) - (b_lo != 0 ? 1 as u64 : 0 as u64)
        end
        mut ql := 0 as u64
        mut qh := 0 as u64
        mut rl := 0 as u64
        mut rh := 0 as u64
        if yh == 0 and xh == 0:
            ql = xl / yl
            rl = xl % yl
        else yh == 0 and yl <= 4294967295:
            _w128_div_small(xl, xh, yl, ql, qh, rl)
        else:
            mut i := 127
            until i >= 0:
                carry := rh >> 63
                rh = (rh << 1) | (rl >> 63)
                rl = (rl << 1) | ((i >= 64 ? xh >> (i - 64) : xl >> i) & 1)
                if carry != 0 or rh > yh or (rh == yh and rl >= yl):
                    borrow := rl < yl ? 1 as u64 : 0 as u64
                    rl -= yl
                    rh = rh - yh - borrow
                    if i >= 64:
                        qh |= ((1 as u64) << (i - 64))
                    else:
                        ql |= ((1 as u64) << i)
                    end
                end
                i--
            end
        end
        if na != nb:
            nql := 0 - ql
            qh = (0 - qh) - (ql != 0 ? 1 as u64 : 0 as u64)
            ql = nql
        end
        if na:
            nrl := 0 - rl
            rh = (0 - rh) - (rl != 0 ? 1 as u64 : 0 as u64)
            rl = nrl
        end
        out[0] = ql
        out[1] = qh
        out[2] = rl
        out[3] = rh
    end
    func salam_w128_to_f64(lo: u64, hi: u64, sgn: int): f64:
        mut a := lo
        mut b := hi
        neg := sgn != 0 and (hi >> 63) != 0
        if neg:
            a = 0 - lo
            b = (0 - hi) - (lo != 0 ? 1 as u64 : 0 as u64)
        end
        mut n := 0
        until (b >> n) != 0 and n < 64:
            n++
        end
        mut kept := a
        if n == 64:
            kept = b | (a != 0 ? 1 as u64 : 0 as u64)
        else n > 0:
            kept = (b << (64 - n)) | (a >> n) | ((a << (64 - n)) != 0 ? 1 as u64 : 0 as u64)
        end
        mut r := kept as f64
        repeat n:
            r *= 2.0
        end
        ret neg ? 0.0 - r : r
    end
    func salam_w128_to_f32(lo: u64, hi: u64, sgn: int): f32:
        mut a := lo
        mut b := hi
        neg := sgn != 0 and (hi >> 63) != 0
        if neg:
            a = 0 - lo
            b = (0 - hi) - (lo != 0 ? 1 as u64 : 0 as u64)
        end
        mut n := 0
        until (b >> n) != 0 and n < 64:
            n++
        end
        mut kept := a
        if n == 64:
            kept = b | (a != 0 ? 1 as u64 : 0 as u64)
        else n > 0:
            kept = (b << (64 - n)) | (a >> n) | ((a << (64 - n)) != 0 ? 1 as u64 : 0 as u64)
        end
        mut r := kept as f32
        two := 2.0 as f32
        repeat n:
            r *= two
        end
        ret neg ? (0.0 as f32) - r : r
    end
    func salam_w128_from_f64(f: f64, sgn: int, out: u64*):
        mut lo := 0 as u64
        mut hi := 0 as u64
        if f == f:
            neg := f < 0.0
            mag := neg ? 0.0 - f : f
            if sgn != 0 and mag >= 170141183460469231731687303715884105728.0:
                lo = neg ? 0 as u64 : ~(0 as u64)
                hi = neg ? (1 as u64) << 63 : ~(0 as u64) >> 1
            else sgn == 0 and neg:
                lo = 0 as u64
            else mag >= 340282366920938463463374607431768211456.0:
                lo = ~(0 as u64)
                hi = ~(0 as u64)
            else mag >= 1.0:
                mut e := 0
                mut m := mag
                until m >= 18446744073709551616.0:
                    m /= 2.0
                    e++
                end
                v := m as u64
                if e == 0:
                    lo = v
                else e >= 64:
                    hi = v << (e - 64)
                else:
                    lo = v << e
                    hi = v >> (64 - e)
                end
                if neg:
                    nl := 0 - lo
                    hi = (0 - hi) - (lo != 0 ? 1 as u64 : 0 as u64)
                    lo = nl
                end
            end
        end
        out[0] = lo
        out[1] = hi
    end
    func salam_w128_hash(lo: u64, hi: u64): u64:
        ret salam_hash_int(salam_hash_int(hi) ^ lo)
    end
    noret func salam_panic(msg: str):
        printerrln "salam panic: ".Concat(msg)
        abort()
    end
    func salam_input(): str:
        mut sb := str.NewBuilder()
        defer str.BufFree(sb)
        mut c := getchar()
        until c != -1 and c != 10:
            str.BufAppendChar(sb, c)
            c = getchar()
        end
        out := str.BufStr(sb)
        ret out
    end
    func salam_set_args(argc: int, argv: void*):
        _salam_argc = argc
        _salam_argv = argv
    end
    func salam_args(out_count: void*): void*:
        oc := out_count as int*
        n := _salam_argc
        mut slots := n
        if slots < 1: slots = 1 end
        arr := mem.MustAllocate((slots as u64) * (sizeof(str) as u64)) as str*
        av := _salam_argv as str*
        repeat n in i:
            s := av[i]
            arr[i] = s.Substr(0, s.Len())
        end
        oc[0] = n
        ret arr as void*
    end
end

@en "Panic"
@fa "خطای مرگبار"
pub noret func Panic(msg: str): salam_panic(msg) end

@en "Some"
@fa "یک مقدار"
pub func Some<T>(x: T): Option<T>:
    ret Option { value = x, present = true }
end

@en "None"
@fa "هیچ مقدار"
pub func None<T>(): Option<T>:
    p := mem.MustAllocateZeroed(sizeof(T))
    vp := p as T*
    v := vp[0]
    mem.Free(p)
    ret Option { value = v, present = false }
end

@en "IsSome"
@fa "دارد"
pub func IsSome<T>(o: Option<T>): bool:
    ret o.present
end

@en "IsNone"
@fa "ندارد"
pub func IsNone<T>(o: Option<T>): bool:
    ret not o.present
end

@en "UnwrapOr"
@fa "با پیش فرض"
pub func UnwrapOr<T>(o: Option<T>, fallback: T): T:
    ret o.present ? o.value : fallback
end

@en "Expect"
@fa "انتظار"
pub func Expect<T>(o: Option<T>, msg: str): T:
    if not o.present:
        salam_panic(msg)
    end
    ret o.value
end

@en "Unwrap"
@fa "باز کردن"
pub func Unwrap<T>(o: Option<T>): T:
    ret Expect(o, "called Unwrap on a value that has none")
end
