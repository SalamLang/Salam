@en "cron"
@fa "کرون"
package cron

// Five-field cron expressions (minute hour day-of-month month day-of-week)
// and a minute-resolution scheduler. Fields accept *, n, a-b, lists, and
// /step; months and weekdays also accept three-letter names. As in Vixie
// cron, when both day fields are restricted a time matches either of them.

import str
import conv
import mem
import time
import calendar
import rand
import sync
import os
import fs

if SALAM_OS_WINDOWS:
    extern:
        func _beginthreadex(sec: void *, stack: u32, start: void *, arg: void *, flags: u32, thrdaddr: void *): u64
        func CloseHandle(h: void *): int
        func GetCurrentThreadId(): u32
        noret func _endthreadex(code: u32)
    end
else:
    extern:
        func pthread_create(thread: void *, attr: void *, start: void *, arg: void *): int
        func pthread_detach(thread: u64): int
        func pthread_self(): u64
        noret func pthread_exit(value: void *)
    end
end

const CRON_KIND_PLAIN := 0
const CRON_KIND_MONTH := 1
const CRON_KIND_DOW := 2
const CRON_MAX_SCAN := 2000000

const JOB_CRON := 0
const JOB_EVERY := 1
const JOB_BETWEEN := 2
const JOB_ONCE := 3

const S_BUSY := 0
const S_REMOVED := 1
const S_INTERVAL := 2
const S_MAX := 3
const S_NEXT := 4
const S_LIMIT := 5
const S_RUNS := 6
const S_STARTED := 7
const S_FINISHED := 8
const S_SLOT := 9
const S_START_AT := 10
const S_STOP_AT := 11
const S_AFTER_DONE := 12
const S_QUEUE := 13
const S_PENDING := 14
const S_FAILED := 15
const S_FAILS := 16
const S_NSTEP := 17
const S_NUNIT := 18
const S_NANCHOR := 19
const S_ZMIN := 20
const S_ZVAL := 21
const S_TID := 22
const S_GRANTED := 23
const S_FIRING := 24
const S_T0 := 25
const S_LAST_MS := 26
const S_TOTAL_MS := 27
const S_MAX_MS := 28
const S_PANICS := 29
const S_SKIP_BUSY := 30
const S_SKIP_CAP := 31
const S_LOCK_DENIED := 32
const S_COUNT := 33

const EV_START := 1
const EV_END := 2
const EV_FAIL := 3
const EV_PANIC := 4
const EV_SKIP_BUSY := 5
const EV_SKIP_CAP := 6
const EV_LOCK_DENIED := 7

mut _jobs := Vector {} as Vector<_Job>
mut _zone_name := "UTC"
mut _zone_fallback := 0
mut _stop := null as i64*
mut _last_minute := 0 as i64

mut _mu := sync.NewMutex()
mut _gcell := mem.AllocateZeroed(16 as u64) as i64*
mut _off_minute := (0 as i64) - (1 as i64)
mut _off_value := 0 as i64
mut _on_error := 0 as i64
mut _on_panic := 0 as i64
mut _monitor := 0 as i64
mut _lock_fn := 0 as i64
mut _unlock_fn := 0 as i64
mut _lock_dir := ""
mut _lock_ttl := 120 as i64
mut _last_sweep := 0 as i64
mut _hooked := false
mut _last_panic := ""
mut _before := 0 as i64
mut _after := 0 as i64

struct _Job:
    pub name: str = ""
    pub tags: str = ""
    pub kind: int = 0
    pub zone: str = ""
    pub zfb: int = 0
    pub expr: Expr = Expr {}
    pub fn: i64 = 0
    pub cell: i64 = 0
end

@en "Expr"
@fa "عبارت زمان‌بندی"
pub struct Expr:
    @en "minutes"
    @fa "دقیقه‌ها"
    pub minutes: i64 = 0
    @en "hours"
    @fa "ساعت‌ها"
    pub hours: i64 = 0
    @en "days"
    @fa "روزها"
    pub days: i64 = 0
    @en "months"
    @fa "ماه‌ها"
    pub months: i64 = 0
    @en "weekdays"
    @fa "روزهای هفته"
    pub weekdays: i64 = 0
    @en "dom_star"
    @fa "همه روزها"
    pub dom_star: bool = true
    @en "dow_star"
    @fa "همه روزهای هفته"
    pub dow_star: bool = true
    @en "seconds"
    @fa "ثانیه‌ها"
    pub seconds: i64 = 1
    @en "with_seconds"
    @fa "با ثانیه"
    pub with_seconds: bool = false
    @en "ok"
    @fa "معتبر"
    pub ok: bool = false
end

func _job(i: int): _Job:
    sync.Lock(_mu)
    j := _jobs.get(i)
    sync.Unlock(_mu)
    ret j
end

func _n(): int:
    sync.Lock(_mu)
    n := _jobs.len()
    sync.Unlock(_mu)
    ret n
end

func _slot(base: i64, slot: int): i64*: ret (base + ((slot * 8) as i64)) as i64* end
func _cell(id: int): i64: ret _job(id).cell end
func _get(id: int, slot: int): i64: ret atomic_load(_slot(_cell(id), slot)) end
func _put(id: int, slot: int, v: i64): atomic_store(_slot(_cell(id), slot), v) end

if SALAM_OS_WINDOWS:
    export:
        func salam_cron_spawn(fn: i64, arg: i64):
            h := _beginthreadex(null, 0 as u32, fn as void *, arg as void *, 0 as u32, null)
            if h != (0 as u64): CloseHandle(h as void *) end
        end
    end
else:
    export:
        func salam_cron_spawn(fn: i64, arg: i64):
            t := mem.Allocate(8 as u64)
            if pthread_create(t, null, fn as void *, arg as void *) == 0:
                tp := t as i64 *
                pthread_detach(tp[0] as u64)
            end
            mem.Free(t)
        end
    end
end

func _bit(v: int): i64: ret (1 as i64) << (v as i64) end

func _has(mask: i64, v: int): bool:
    ret ((mask >> (v as i64)) & (1 as i64)) == (1 as i64)
end

func _name_value(s: str, kind: int): int:
    if kind == CRON_KIND_MONTH:
        names := "janfebmaraprmayjunjulaugsepoctnovdec"
        repeat 12 in i:
            if str.EqualFold(s, names.substr(i * 3, 3)): ret i + 1 end
        end
    end
    if kind == CRON_KIND_DOW:
        names := "sunmontuewedthufrisat"
        repeat 7 in i:
            if str.EqualFold(s, names.substr(i * 3, 3)): ret i end
        end
    end
    ret 0 - 1
end

func _num(s: str, kind: int): int:
    n := s.len()
    if n == 0: ret 0 - 1 end
    mut digits := true
    repeat n in i:
        c := s[i]
        if c < '0' or c > '9': digits = false end
    end
    if digits:
        if n > 4: ret 0 - 1 end
        ret conv.AtoiOr(s, 0 - 1)
    end
    ret _name_value(s, kind)
end

func _parse_item(item: str, lo: int, hi: int, kind: int, mask &: i64, star &: bool): bool:
    mut base := item
    mut step := 1
    slash := item.find("/")
    if slash >= 0:
        base = item.substr(0, slash)
        step = _num(item.substr(slash + 1, item.len() - slash - 1), CRON_KIND_PLAIN)
        if step <= 0: ret false end
    end
    mut a := lo
    mut b := hi
    if base == "*":
        star = true
    else:
        dash := base.find("-")
        if dash > 0:
            a = _num(base.substr(0, dash), kind)
            b = _num(base.substr(dash + 1, base.len() - dash - 1), kind)
        else:
            a = _num(base, kind)
            if slash >= 0:
                b = hi
            else:
                b = a
            end
        end
    end
    if a < lo or b > hi or a > b: ret false end
    mut v := a
    until v <= b:
        mask = mask | _bit(v)
        v += step
    end
    ret true
end

func _parse_field(text: str, lo: int, hi: int, kind: int, mask &: i64, star &: bool): bool:
    items := str.Split(text, ",")
    defer items.free()
    if items.len() == 0: ret false end
    star = false
    mut i := 0
    until i < items.len():
        if not _parse_item(items.get(i), lo, hi, kind, mask, star): ret false end
        i += 1
    end
    ret true
end

func _expand_macro(spec: str): str:
    if spec == "@yearly" or spec == "@annually": ret "0 0 1 1 *" end
    if spec == "@monthly": ret "0 0 1 * *" end
    if spec == "@weekly": ret "0 0 * * 0" end
    if spec == "@daily" or spec == "@midnight": ret "0 0 * * *" end
    if spec == "@hourly": ret "0 * * * *" end
    ret spec
end

func _offset(z: calendar.Zone, fallback_minutes: int, epoch: i64): i64:
    if z.ok: ret calendar.ZoneOffsetSeconds(z, epoch) end
    ret fallback_minutes * 60
end

func _tid(): i64:
    if SALAM_OS_WINDOWS:
        ret GetCurrentThreadId() as i64
    else:
        ret pthread_self() as i64
    end
end

func _thread_exit():
    if SALAM_OS_WINDOWS:
        _endthreadex(0 as u32)
    else:
        pthread_exit(null)
    end
end

func _event(i: int, kind: int):
    if _monitor != (0 as i64): callhandler(_monitor, ((i * 16 + kind) as i64)) end
end

func _bump(i: int, slot: int):
    atomic_add(_slot(_cell(i), slot), 1 as i64)
end

func _finish(i: int, panicked: bool):
    id := i as i64
    j := _job(i)
    done := time.Now()
    _put(i, S_FINISHED, done)
    dur := sync.NowMs() - _get(i, S_T0)
    _put(i, S_LAST_MS, dur)
    atomic_add(_slot(_cell(i), S_TOTAL_MS), dur)
    if dur > _get(i, S_MAX_MS): _put(i, S_MAX_MS, dur) end
    if _after != (0 as i64): callhandler(_after, id) end
    if _get(i, S_AFTER_DONE) != (0 as i64):
        mut next := done + _get(i, S_INTERVAL)
        if j.kind == JOB_BETWEEN: next = done + _pick(i) end
        _put(i, S_NEXT, next)
    end
    if panicked:
        _bump(i, S_PANICS)
        _put(i, S_FAILS, _get(i, S_FAILS) + (1 as i64))
        _put(i, S_FAILED, 0 as i64)
        _event(i, EV_PANIC)
        if _on_panic != (0 as i64): callhandler(_on_panic, id) end
    else _get(i, S_FAILED) != (0 as i64):
        _put(i, S_FAILS, _get(i, S_FAILS) + (1 as i64))
        _put(i, S_FAILED, 0 as i64)
        _event(i, EV_FAIL)
        if _on_error != (0 as i64): callhandler(_on_error, id) end
    end
    _event(i, EV_END)
    if _unlock_fn != (0 as i64) and _get(i, S_GRANTED) != (0 as i64): callhandler(_unlock_fn, id) end
    _put(i, S_GRANTED, 0 as i64)
    _put(i, S_TID, 0 as i64)
    atomic_add(_slot(_gcell as i64, 1), 0 as i64 - (1 as i64))
    _put(i, S_BUSY, 0 as i64)
    if _get(i, S_PENDING) != (0 as i64):
        _put(i, S_PENDING, 0 as i64)
        _launch(i, time.Now())
    end
end

// Runs on the faulting thread when the language reports a panic, an index
// out of range or a division by zero. If the thread is a cron job it is
// retired here and only that thread ends; any other thread is left alone and
// the fault takes its normal course.
func _cron_panic(_kind: i64):
    me := _tid()
    n := _n()
    repeat n in i:
        if _get(i, S_TID) == me and _get(i, S_BUSY) != (0 as i64):
            _last_panic = core.PanicMessage()
            _finish(i, true)
            _thread_exit()
        end
    end
end

func _safe(s: str): str:
    mut out := ""
    repeat s.len() in k:
        c := s[k]
        keep := (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '-' or c == '_'
        if keep:
            out = out + s.substr(k, 1)
        else:
            out = out + "_"
        end
    end
    ret out
end

func _sweep():
    now := time.Now()
    if now - _last_sweep < (60 as i64): ret end
    _last_sweep = now
    names := os.ListDir(_lock_dir)
    repeat names.len() in k:
        p := _lock_dir + "/" + names.get(k)
        if now - fs.ModTime(p) > _lock_ttl: os.Rmdir(p) end
    end
end

func _file_lock(id: i64):
    i := id as int
    path := _lock_dir + "/" + _safe(_job(i).name) + "_" + conv.FormatInt(_get(i, S_FIRING))
    _sweep()
    if os.Mkdir(path) == 0: _put(i, S_GRANTED, 1 as i64) end
end

func _label(s: str): str:
    mut out := ""
    repeat s.len() in k:
        c := s[k]
        if c == '"' or c == '\\':
            out = out + "\\" + s.substr(k, 1)
        else c == '\n':
            out = out + "\\n"
        else:
            out = out + s.substr(k, 1)
        end
    end
    ret out
end

func _cron_entry(id: i64):
    i := id as int
    j := _job(i)
    _put(i, S_TID, _tid())
    _put(i, S_T0, sync.NowMs())
    if _lock_fn != (0 as i64):
        _put(i, S_GRANTED, 0 as i64)
        callhandler(_lock_fn, id)
        if _get(i, S_GRANTED) == (0 as i64):
            _bump(i, S_LOCK_DENIED)
            _event(i, EV_LOCK_DENIED)
            _put(i, S_RUNS, _get(i, S_RUNS) - (1 as i64))
            _put(i, S_TID, 0 as i64)
            atomic_add(_slot(_gcell as i64, 1), 0 as i64 - (1 as i64))
            _put(i, S_BUSY, 0 as i64)
            ret
        end
    end
    if _before != (0 as i64): callhandler(_before, id) end
    _put(i, S_STARTED, time.Now())
    _event(i, EV_START)
    callhandler(j.fn, id)
    _finish(i, false)
end

func _pick(i: int): i64:
    lo := _get(i, S_INTERVAL)
    hi := _get(i, S_MAX)
    if hi <= lo: ret lo end
    ret rand.IntRange(lo, hi)
end

func _launch(i: int, at: i64): bool:
    cap := atomic_load(_gcell)
    if cap > (0 as i64) and atomic_load(_slot(_gcell as i64, 1)) >= cap:
        _bump(i, S_SKIP_CAP)
        _event(i, EV_SKIP_CAP)
        ret false
    end
    if atomic_swap(_slot(_cell(i), S_BUSY), 1 as i64) != (0 as i64):
        if _get(i, S_QUEUE) != (0 as i64): _put(i, S_PENDING, 1 as i64) end
        _bump(i, S_SKIP_BUSY)
        _event(i, EV_SKIP_BUSY)
        ret false
    end
    if not _hooked:
        _hooked = true
        core.SetPanicHook(_cron_panic)
    end
    atomic_add(_slot(_gcell as i64, 1), 1 as i64)
    _put(i, S_RUNS, _get(i, S_RUNS) + (1 as i64))
    _put(i, S_FIRING, at)
    lim := _get(i, S_LIMIT)
    if lim > (0 as i64) and _get(i, S_RUNS) >= lim: _put(i, S_REMOVED, 1 as i64) end
    salam_cron_spawn(_cron_entry, i as i64)
    ret true
end

func _job_offset(i: int, now: i64): i64:
    j := _job(i)
    if j.zone == "": ret _cached_offset(now) end
    minute := now / (60 as i64)
    if _get(i, S_ZMIN) == minute + (1 as i64): ret _get(i, S_ZVAL) end
    v := OffsetSeconds(j.zone, j.zfb, now)
    _put(i, S_ZVAL, v)
    _put(i, S_ZMIN, minute + (1 as i64))
    ret v
end

func _job_zone(i: int): str:
    j := _job(i)
    if j.zone == "": ret _zone_name end
    ret j.zone
end

func _job_fallback(i: int): int:
    j := _job(i)
    if j.zone == "": ret _zone_fallback end
    ret j.zfb
end

func _cached_offset(now: i64): i64:
    minute := now / (60 as i64)
    if minute == _off_minute: ret _off_value end
    v := OffsetSeconds(_zone_name, _zone_fallback, now)
    _off_value = v
    _off_minute = minute
    ret v
end

func _loop():
    until atomic_load(_stop) == (0 as i64):
        _fire_due(time.Now(), true)
        time.Sleep(200)
    end
end

func _cron_loop(arg: i64):
    _loop()
end

// True when t is the second pass over a wall-clock hour that a clock change
// repeated (autumn fall-back); a job runs only on the first pass.
func _is_repeat(zone: str, t: i64): bool:
    mut z := calendar.LoadZone(zone)
    if not z.ok: ret false end
    here := calendar.ZoneOffsetSeconds(z, t)
    d := calendar.ZoneOffsetSeconds(z, t - (3600 as i64)) - here
    mut rep := false
    if d > (0 as i64):
        rep = calendar.ZoneOffsetSeconds(z, t - d) == here + d
    end
    calendar.FreeZone(z)
    ret rep
end

func _next_minute(e: Expr, after: i64, zone: str, fallback_minutes: int): i64:
    mut z := calendar.LoadZone(zone)
    mut found := 0 as i64
    mut t := (after / (60 as i64) + (1 as i64)) * (60 as i64)
    mut steps := 0
    until steps < CRON_MAX_SCAN and found == (0 as i64):
        local := t + _offset(z, fallback_minutes, t)
        sod := local % (86400 as i64)
        if not _has(e.months, time.MonthUTC(local)):
            t += (86400 as i64) - sod
        else not _has(e.hours, time.HourUTC(local)):
            t += (3600 as i64) - (local % (3600 as i64))
        else MatchesLocal(e, local) and not _is_repeat(zone, t):
            found = t
        else:
            t += 60 as i64
        end
        steps += 1
    end
    if z.ok: calendar.FreeZone(z) end
    ret found
end

func _register(name: str, kind: int, e: Expr, fn: i64, interval: i64, hi: i64, first: i64): int:
    cell := mem.AllocateZeroed((S_COUNT * 8) as u64) as i64*
    atomic_store(_slot(cell as i64, S_INTERVAL), interval)
    atomic_store(_slot(cell as i64, S_MAX), hi)
    atomic_store(_slot(cell as i64, S_NEXT), first)
    sync.Lock(_mu)
    _jobs.push(_Job { name = str.Clone(name), kind = kind, expr = e, fn = fn, cell = cell as i64 })
    id := _jobs.len() - 1
    sync.Unlock(_mu)
    ret id
end

// "H:M" or "H:M:S" to the leading cron fields "[S ]M H". Empty when invalid.
func _at_fields(at: str): str:
    parts := str.Split(at, ":")
    defer parts.free()
    n := parts.len()
    if n < 2 or n > 3: ret "" end
    h := _num(parts.get(0), CRON_KIND_PLAIN)
    m := _num(parts.get(1), CRON_KIND_PLAIN)
    mut sec := 0
    if n == 3: sec = _num(parts.get(2), CRON_KIND_PLAIN) end
    if h < 0 or h > 23 or m < 0 or m > 59 or sec < 0 or sec > 59: ret "" end
    if n == 3: ret conv.FormatInt(sec as i64) + " " + conv.FormatInt(m as i64) + " " + conv.FormatInt(h as i64) end
    ret conv.FormatInt(m as i64) + " " + conv.FormatInt(h as i64)
end

func _period(unit: int, local: i64): i64:
    day := local / (86400 as i64)
    if unit == 2: ret (day + (3 as i64)) / (7 as i64) end
    if unit == 3: ret time.YearUTC(local) * 12 + time.MonthUTC(local) end
    ret day
end

func _step_ok(i: int, local: i64): bool:
    n := _get(i, S_NSTEP)
    if n <= (1 as i64): ret true end
    ret (_period(_get(i, S_NUNIT) as int, local) - _get(i, S_NANCHOR)) % n == (0 as i64)
end

func _set_step(id: int, n: int, unit: int):
    if id < 0 or id >= _n() or n < 1: ret end
    now := time.Now()
    _put(id, S_NSTEP, n as i64)
    _put(id, S_NUNIT, unit as i64)
    _put(id, S_NANCHOR, _period(unit, now + _job_offset(id, now)))
end

func _due(i: int, now: i64, dedupe: bool): bool:
    if _get(i, S_REMOVED) != (0 as i64): ret false end
    st := _get(i, S_START_AT)
    if st > (0 as i64) and now < st: ret false end
    stop := _get(i, S_STOP_AT)
    if stop > (0 as i64) and now > stop: ret false end
    j := _job(i)
    if j.kind != JOB_CRON:
        nx := _get(i, S_NEXT)
        if nx == (0 as i64) or now < nx: ret false end
        ret true
    end
    local := now + _job_offset(i, now)
    if not MatchesLocal(j.expr, local): ret false end
    if _is_repeat(_job_zone(i), now): ret false end
    if not _step_ok(i, local): ret false end
    mut slot := now / (60 as i64)
    if j.expr.with_seconds:
        if not _has(j.expr.seconds, time.SecondUTC(local)): ret false end
        slot = now
    end
    if dedupe:
        if _get(i, S_SLOT) == slot + (1 as i64): ret false end
    end
    ret true
end

func _advance(i: int, now: i64):
    j := _job(i)
    if j.kind == JOB_CRON:
        slot := now / (60 as i64)
        if j.expr.with_seconds: _put(i, S_SLOT, now + (1 as i64)) else:
            _put(i, S_SLOT, slot + (1 as i64))
        end
        ret
    end
    if j.kind == JOB_ONCE:
        _put(i, S_NEXT, 0 as i64)
        _put(i, S_REMOVED, 1 as i64)
        ret
    end
    if _get(i, S_AFTER_DONE) != (0 as i64):
        _put(i, S_NEXT, 0 as i64)
        ret
    end
    mut step := _get(i, S_INTERVAL)
    if j.kind == JOB_BETWEEN: step = _pick(i) end
    mut nx := _get(i, S_NEXT) + step
    if nx <= now: nx = now + step end
    _put(i, S_NEXT, nx)
end

func _firing_time(i: int, now: i64): i64:
    j := _job(i)
    if j.kind == JOB_CRON:
        if j.expr.with_seconds: ret now end
        ret now - (now % (60 as i64))
    end
    ret _get(i, S_NEXT)
end

func _fire_due(now: i64, dedupe: bool): int:
    mut started := 0
    n := _n()
    repeat n in i:
        if _due(i, now, dedupe):
            at := _firing_time(i, now)
            _advance(i, now)
            if _launch(i, at): started += 1 end
        end
    end
    ret started
end

@en "Parse"
@fa "تجزیه"
pub func Parse(spec: str): Expr:
    mut e := Expr {}
    fields := str.Fields(_expand_macro(spec))
    defer fields.free()
    n := fields.len()
    if n != 5 and n != 6: ret e end
    mut star := false
    mut at := 0
    if n == 6:
        e.seconds = 0
        if not _parse_field(fields.get(0), 0, 59, CRON_KIND_PLAIN, e.seconds, star): ret e end
        e.with_seconds = true
        at = 1
    end
    if not _parse_field(fields.get(at + 0), 0, 59, CRON_KIND_PLAIN, e.minutes, star): ret e end
    if not _parse_field(fields.get(at + 1), 0, 23, CRON_KIND_PLAIN, e.hours, star): ret e end
    if not _parse_field(fields.get(at + 2), 1, 31, CRON_KIND_PLAIN, e.days, star): ret e end
    e.dom_star = star
    if not _parse_field(fields.get(at + 3), 1, 12, CRON_KIND_MONTH, e.months, star): ret e end
    if not _parse_field(fields.get(at + 4), 0, 7, CRON_KIND_DOW, e.weekdays, star): ret e end
    e.dow_star = star
    if _has(e.weekdays, 7):
        e.weekdays = e.weekdays | _bit(0)
    end
    e.ok = true
    ret e
end

@en "MatchFields"
@fa "تطبیق فیلدها"
pub func MatchFields(e: Expr, minute: int, hour: int, day: int, month: int, weekday: int): bool:
    if not e.ok: ret false end
    if not _has(e.minutes, minute) or not _has(e.hours, hour) or not _has(e.months, month):
        ret false
    end
    dom := _has(e.days, day)
    dow := _has(e.weekdays, weekday)
    if e.dom_star or e.dow_star:
        ret dom and dow
    end
    ret dom or dow
end

// Matches against a wall-clock instant: seconds since the epoch already
// shifted by the zone offset.
@en "MatchesLocal"
@fa "تطبیق محلی"
pub func MatchesLocal(e: Expr, local: i64): bool:
    days := local / (86400 as i64)
    weekday := ((days + (4 as i64)) % (7 as i64)) as int
    ret MatchFields(e, time.MinuteUTC(local), time.HourUTC(local), time.DayUTC(local), time.MonthUTC(local), weekday)
end

// Offset of zone at epoch in seconds; fallback_minutes when the zone
// database is unavailable.
@en "OffsetSeconds"
@fa "اختلاف ثانیه منطقه"
pub func OffsetSeconds(zone: str, fallback_minutes: int, epoch: i64): i64:
    mut z := calendar.LoadZone(zone)
    off := _offset(z, fallback_minutes, epoch)
    if z.ok: calendar.FreeZone(z) end
    ret off
end

// First minute strictly after `after` (UTC seconds) that matches e in the
// given zone, or 0 when none is found within the scan limit.
@en "Next"
@fa "بعدی"
pub func Next(e: Expr, after: i64, zone: str, fallback_minutes: int): i64:
    if not e.ok: ret 0 end
    if not e.with_seconds: ret _next_minute(e, after, zone, fallback_minutes) end
    t0 := after + (1 as i64)
    base := t0 - (t0 % (60 as i64))
    first := (t0 % (60 as i64)) as int
    local := base + OffsetSeconds(zone, fallback_minutes, base)
    if MatchesLocal(e, local) and not _is_repeat(zone, base):
        repeat 60 - first in k:
            sec := first + k
            if _has(e.seconds, sec): ret base + (sec as i64) end
        end
    end
    m := _next_minute(e, base, zone, fallback_minutes)
    if m == (0 as i64): ret 0 end
    repeat 60 in sec:
        if _has(e.seconds, sec): ret m + (sec as i64) end
    end
    ret 0
end

@en "SetZone"
@fa "تنظیم منطقه"
pub func SetZone(name: str, fallback_minutes: int):
    _zone_name = str.Clone(name)
    _zone_fallback = fallback_minutes
    _off_minute = (0 as i64) - (1 as i64)
end

// Registers fn (a func(id: i64)) under spec. Register every job before Run.
// spec has five fields, or six with a leading seconds field.
// Returns the job id, or -1 when spec does not parse.
@en "Add"
@fa "افزودن"
pub func Add(name: str, spec: str, fn: i64): int:
    e := Parse(spec)
    if not e.ok: ret 0 - 1 end
    ret _register(name, JOB_CRON, e, fn, 0 as i64, 0 as i64, 0 as i64)
end

// Runs fn every `seconds` seconds, the first time `seconds` from now.
@en "Every"
@fa "هر"
pub func Every(name: str, seconds: int, fn: i64): int:
    if seconds <= 0: ret 0 - 1 end
    ret _register(name, JOB_EVERY, Expr {}, fn, seconds as i64, 0 as i64, time.Now() + (seconds as i64))
end

// Runs fn at a random gap between lo and hi seconds.
@en "EveryBetween"
@fa "هر بین"
pub func EveryBetween(name: str, lo: int, hi: int, fn: i64): int:
    if lo <= 0 or hi < lo: ret 0 - 1 end
    id := _register(name, JOB_BETWEEN, Expr {}, fn, lo as i64, hi as i64, 0 as i64)
    _put(id, S_NEXT, time.Now() + _pick(id))
    ret id
end

// Runs fn once at the given instant (UTC seconds since the epoch).
@en "Once"
@fa "یک بار"
pub func Once(name: str, at: i64, fn: i64): int:
    id := _register(name, JOB_ONCE, Expr {}, fn, 0 as i64, 0 as i64, at)
    _put(id, S_LIMIT, 1 as i64)
    ret id
end

@en "DailyAt"
@fa "روزانه در"
pub func DailyAt(name: str, at: str, fn: i64): int:
    f := _at_fields(at)
    if f == "": ret 0 - 1 end
    ret Add(name, f + " * * *", fn)
end

// days is a cron weekday list such as "mon,wed,fri" or "1-5".
@en "WeeklyAt"
@fa "هفتگی در"
pub func WeeklyAt(name: str, days: str, at: str, fn: i64): int:
    f := _at_fields(at)
    if f == "": ret 0 - 1 end
    ret Add(name, f + " * * " + days, fn)
end

@en "MonthlyAt"
@fa "ماهانه در"
pub func MonthlyAt(name: str, day: int, at: str, fn: i64): int:
    f := _at_fields(at)
    if f == "" or day < 1 or day > 31: ret 0 - 1 end
    ret Add(name, f + " " + conv.FormatInt(day as i64) + " * *", fn)
end

@en "Count"
@fa "تعداد"
pub func Count(): int:
    mut n := 0
    repeat _n() in i:
        if _get(i, S_REMOVED) == (0 as i64): n += 1 end
    end
    ret n
end

// Every id ever issued, including removed jobs (ids are never reused).
@en "Total"
@fa "کل"
pub func Total(): int: ret _n() end

@en "Name"
@fa "نام"
pub func Name(id: int): str: ret _job(id).name end

@en "Find"
@fa "یافتن"
pub func Find(name: str): int:
    repeat _n() in i:
        if _job(i).name == name and _get(i, S_REMOVED) == (0 as i64): ret i end
    end
    ret 0 - 1
end

@en "IsBusy"
@fa "مشغول است"
pub func IsBusy(id: int): bool:
    ret _get(id, S_BUSY) != (0 as i64)
end

@en "Remove"
@fa "حذف"
pub func Remove(id: int):
    if id >= 0 and id < _n(): _put(id, S_REMOVED, 1 as i64) end
end

// Comma separated tags, replacing any earlier ones.
@en "SetTags"
@fa "تنظیم برچسب"
pub func SetTags(id: int, tags: str):
    j := _job(id)
    sync.Lock(_mu)
    _jobs.set(id, _Job { name = j.name, tags = "," + tags + ",", kind = j.kind, zone = j.zone, zfb = j.zfb, expr = j.expr, fn = j.fn, cell = j.cell })
    sync.Unlock(_mu)
end

// Gives one job its own time zone (an IANA name such as "Asia/Tehran"),
// with fallback_minutes used when the zone database cannot load it.
// An empty name returns the job to the scheduler zone.
@en "SetJobZone"
@fa "تنظیم منطقه کار"
pub func SetJobZone(id: int, name: str, fallback_minutes: int):
    if id < 0 or id >= _n(): ret end
    j := _job(id)
    sync.Lock(_mu)
    _jobs.set(id, _Job { name = j.name, tags = j.tags, kind = j.kind, zone = str.Clone(name), zfb = fallback_minutes, expr = j.expr, fn = j.fn, cell = j.cell })
    sync.Unlock(_mu)
    _put(id, S_ZMIN, 0 as i64)
    if _get(id, S_NSTEP) > (1 as i64):
        now := time.Now()
        _put(id, S_NANCHOR, _period(_get(id, S_NUNIT) as int, now + _job_offset(id, now)))
    end
end

@en "JobZone"
@fa "منطقه کار"
pub func JobZone(id: int): str: ret _job_zone(id) end

// True when the zone database knows the name.
@en "ZoneExists"
@fa "منطقه وجود دارد"
pub func ZoneExists(name: str): bool:
    mut z := calendar.LoadZone(name)
    ok := z.ok
    if ok: calendar.FreeZone(z) end
    ret ok
end

@en "HasTag"
@fa "برچسب دارد"
pub func HasTag(id: int, tag: str): bool:
    ret str.Contains(_job(id).tags, "," + tag + ",")
end

@en "RemoveByTag"
@fa "حذف با برچسب"
pub func RemoveByTag(tag: str): int:
    mut n := 0
    repeat _n() in i:
        if HasTag(i, tag) and _get(i, S_REMOVED) == (0 as i64):
            Remove(i)
            n += 1
        end
    end
    ret n
end

// Stops the job after n runs.
@en "Limit"
@fa "محدودیت"
pub func Limit(id: int, n: int):
    _put(id, S_LIMIT, n as i64)
end

// The job does not fire before `at` / after `at` (UTC seconds). 0 clears.
@en "StartAt"
@fa "شروع از"
pub func StartAt(id: int, at: i64):
    _put(id, S_START_AT, at)
end

@en "StopAt"
@fa "توقف در"
pub func StopAt(id: int, at: i64):
    _put(id, S_STOP_AT, at)
end

// Interval jobs count the next gap from the end of a run, not its start.
@en "FromCompletion"
@fa "از اتمام اجرا"
pub func FromCompletion(id: int):
    _put(id, S_AFTER_DONE, 1 as i64)
end

// A firing that finds the job busy waits and runs after it, instead of being skipped.
@en "Queue"
@fa "صف"
pub func Queue(id: int):
    _put(id, S_QUEUE, 1 as i64)
end

@en "OnBefore"
@fa "پیش از اجرا"
pub func OnBefore(fn: i64):
    _before = fn
end

@en "OnAfter"
@fa "پس از اجرا"
pub func OnAfter(fn: i64):
    _after = fn
end

// Call from inside a handler to mark the current run as failed.
@en "Fail"
@fa "شکست"
pub func Fail(id: i64):
    _put(id as int, S_FAILED, 1 as i64)
end

// Registers a handler (taking the job id) that runs after a run that called Fail.
@en "OnError"
@fa "هنگام خطا"
pub func OnError(fn: i64):
    _on_error = fn
end

@en "Failures"
@fa "تعداد شکست"
pub func Failures(id: int): i64: ret _get(id, S_FAILS) end

// At most n jobs run at once; a firing past the cap is skipped. 0 removes the cap.
@en "ConcurrencyLimit"
@fa "سقف هم‌زمانی"
pub func ConcurrencyLimit(n: int):
    atomic_store(_gcell, n as i64)
end

// Fires only every nth day / week / month, counted from today (this week, this month).
// Use it on DailyAt, WeeklyAt, MonthlyAt or any cron job.
@en "EveryNDays"
@fa "هر چند روز"
pub func EveryNDays(id: int, n: int):
    _set_step(id, n, 1)
end

@en "EveryNWeeks"
@fa "هر چند هفته"
pub func EveryNWeeks(id: int, n: int):
    _set_step(id, n, 2)
end

@en "EveryNMonths"
@fa "هر چند ماه"
pub func EveryNMonths(id: int, n: int):
    _set_step(id, n, 3)
end

// Makes sure only one scheduler instance runs each firing. lock_fn runs on
// the job thread before the job and must call Grant(id) when it won the
// firing; if it does not, the job is skipped on this instance. unlock_fn (0
// for none) runs after the job, but only when the lock was granted. Use
// LockKey(id) as the key in Redis, a database row or a file. Intervals are
// not coordinated across instances; use cron expressions or DailyAt and its
// siblings so every instance computes the same firing.
@en "SetLocker"
@fa "تنظیم قفل"
pub func SetLocker(lock_fn: i64, unlock_fn: i64):
    _lock_fn = lock_fn
    _unlock_fn = unlock_fn
end

// Call from a lock handler when this instance won the firing.
@en "Grant"
@fa "اعطا"
pub func Grant(id: i64):
    _put(id as int, S_GRANTED, 1 as i64)
end

// "name@seconds": identical on every instance for the same firing.
@en "LockKey"
@fa "کلید قفل"
pub func LockKey(id: int): str:
    ret _job(id).name + "@" + conv.FormatInt(_get(id, S_FIRING))
end

// Built-in locker on a shared directory (a network mount, for instance):
// the instance that creates the firing's folder first runs the job. Folders
// older than ttl_seconds are swept. A crashed winner means that one firing
// is missed, never doubled.
@en "FileLocker"
@fa "قفل پوشه"
pub func FileLocker(dir: str, ttl_seconds: int): bool:
    if os.MkdirAll(dir) != 0 and not os.IsDir(dir): ret false end
    _lock_dir = str.Clone(dir)
    _lock_ttl = ttl_seconds as i64
    _lock_fn = _file_lock
    _unlock_fn = 0 as i64
    ret true
end

@en "ClearLocker"
@fa "حذف قفل"
pub func ClearLocker():
    _lock_fn = 0 as i64
    _unlock_fn = 0 as i64
end

// Runs after a job that panicked, hit an index out of range or divided by
// zero. Only that job's thread ends; the scheduler and every other job keep
// running. Faults on other threads, and crashes such as a null dereference,
// still stop the program. A job that faults while holding a lock or in the
// middle of printing can leave that lock held.
@en "OnPanic"
@fa "هنگام خطای مرگبار"
pub func OnPanic(fn: i64):
    _on_panic = fn
end

// The message of the last isolated fault.
@en "LastPanic"
@fa "آخرین خطای مرگبار"
pub func LastPanic(): str: ret _last_panic end

@en "Panics"
@fa "تعداد خطای مرگبار"
pub func Panics(id: int): i64: ret _get(id, S_PANICS) end

// Monitor: fn receives job*16+kind for every start, end, failure, panic, skip
// and denied lock. Decode with EventJob and EventKind.
@en "OnEvent"
@fa "هنگام رویداد"
pub func OnEvent(fn: i64):
    _monitor = fn
end

@en "EventJob"
@fa "کار رویداد"
pub func EventJob(arg: i64): int: ret (arg / (16 as i64)) as int end

// 1 start, 2 end, 3 failure, 4 panic, 5 skipped busy, 6 skipped by the cap, 7 lock denied.
@en "EventKind"
@fa "نوع رویداد"
pub func EventKind(arg: i64): int: ret (arg % (16 as i64)) as int end

@en "SkippedBusy"
@fa "ردشده مشغول"
pub func SkippedBusy(id: int): i64: ret _get(id, S_SKIP_BUSY) end

@en "SkippedCap"
@fa "ردشده سقف"
pub func SkippedCap(id: int): i64: ret _get(id, S_SKIP_CAP) end

@en "LockDenied"
@fa "قفل رد شد"
pub func LockDenied(id: int): i64: ret _get(id, S_LOCK_DENIED) end

// Milliseconds the last run took, the total of all runs, and the longest.
@en "LastMs"
@fa "آخرین میلی‌ثانیه"
pub func LastMs(id: int): i64: ret _get(id, S_LAST_MS) end

@en "TotalMs"
@fa "کل میلی‌ثانیه"
pub func TotalMs(id: int): i64: ret _get(id, S_TOTAL_MS) end

@en "MaxMs"
@fa "بیشینه میلی‌ثانیه"
pub func MaxMs(id: int): i64: ret _get(id, S_MAX_MS) end

// Number of jobs running right now.
@en "Running"
@fa "در حال اجرا"
pub func Running(): i64: ret atomic_load(_slot(_gcell as i64, 1)) end

// All counters in the Prometheus text format, ready to serve on /metrics.
@en "Metrics"
@fa "سنجه‌ها"
pub func Metrics(): str:
    mut out := "# TYPE cron_jobs_running gauge\ncron_jobs_running " + conv.FormatInt(Running()) + "\n"
    names := Vector {} as Vector<str>
    names.push("runs_total")
    names.push("failures_total")
    names.push("panics_total")
    names.push("skipped_busy_total")
    names.push("skipped_cap_total")
    names.push("lock_denied_total")
    names.push("duration_ms_total")
    names.push("duration_ms_max")
    slots := Vector {} as Vector<int>
    slots.push(S_RUNS)
    slots.push(S_FAILS)
    slots.push(S_PANICS)
    slots.push(S_SKIP_BUSY)
    slots.push(S_SKIP_CAP)
    slots.push(S_LOCK_DENIED)
    slots.push(S_TOTAL_MS)
    slots.push(S_MAX_MS)
    repeat names.len() in m:
        mut kind := "counter"
        if names.get(m) == "duration_ms_max": kind = "gauge" end
        out = out + "# TYPE cron_job_" + names.get(m) + " " + kind + "\n"
        repeat _n() in i:
            if _get(i, S_REMOVED) == (0 as i64):
                out = out + "cron_job_" + names.get(m) + "{job=\"" + _label(_job(i).name) + "\"} " + conv.FormatInt(_get(i, slots.get(m))) + "\n"
            end
        end
    end
    ret out
end

@en "Runs"
@fa "تعداد اجرا"
pub func Runs(id: int): i64: ret _get(id, S_RUNS) end

@en "LastRun"
@fa "آخرین اجرا"
pub func LastRun(id: int): i64: ret _get(id, S_STARTED) end

@en "LastFinished"
@fa "آخرین اتمام"
pub func LastFinished(id: int): i64: ret _get(id, S_FINISHED) end

// Next firing after `after` (UTC seconds), or 0 when the job will not fire again.
@en "NextRun"
@fa "اجرای بعدی"
pub func NextRun(id: int, after: i64): i64:
    if _get(id, S_REMOVED) != (0 as i64): ret 0 end
    j := _job(id)
    mut t := 0 as i64
    if j.kind == JOB_CRON:
        t = Next(j.expr, after, _job_zone(id), _job_fallback(id))
    else:
        t = _get(id, S_NEXT)
    end
    st := _get(id, S_START_AT)
    if st > (0 as i64) and t < st:
        if j.kind == JOB_CRON: t = Next(j.expr, st - (1 as i64), _job_zone(id), _job_fallback(id)) else:
            t = st
        end
    end
    stop := _get(id, S_STOP_AT)
    if stop > (0 as i64) and t > stop: ret 0 end
    ret t
end

// Starts every job due at now (UTC seconds), each on its own thread. Cron
// jobs without a seconds field match any second of the minute. A job still
// running from an earlier firing is skipped unless Queue was set.
// Returns how many jobs were started.
@en "RunDue"
@fa "اجرای موعد"
pub func RunDue(now: i64): int:
    ret _fire_due(now, false)
end

// Runs job id immediately, outside its schedule.
@en "RunNow"
@fa "اجرای فوری"
pub func RunNow(id: int): bool:
    if id < 0 or id >= _n(): ret false end
    ret _launch(id, time.Now())
end

// Blocks, checking once per second and firing due jobs until Stop is called.
@en "Run"
@fa "اجرا"
pub func Run():
    if _stop == null:
        _stop = mem.AllocateZeroed(8 as u64) as i64*
    end
    atomic_store(_stop, 0 as i64)
    _loop()
end

@en "RunBackground"
@fa "اجرا در پس‌زمینه"
pub func RunBackground():
    if _stop == null:
        _stop = mem.AllocateZeroed(8 as u64) as i64*
    end
    atomic_store(_stop, 0 as i64)
    salam_cron_spawn(_cron_loop, 0 as i64)
end

// Asks Run to return.
@en "Stop"
@fa "توقف"
pub func Stop():
    if _stop != null:
        atomic_store(_stop, 1 as i64)
    end
end

// Stops, then waits up to timeout_ms for running jobs to finish.
@en "StopWait"
@fa "توقف و انتظار"
pub func StopWait(timeout_ms: int):
    Stop()
    mut waited := 0
    until waited < timeout_ms:
        mut any := false
        repeat _n() in i:
            if IsBusy(i): any = true end
        end
        if not any: ret end
        time.Sleep(10)
        waited += 10
    end
end
