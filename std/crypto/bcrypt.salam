func _bf_init(): u32*:
    st := mem.Allocate((BCRYPT_STATE_WORDS * 4) as u64) as u32*
    repeat 18 in i:
        st[i] = BCRYPT_P_INIT[i]
    end
    repeat 1024 in i:
        st[18 + i] = BCRYPT_S_INIT[i]
    end
    ret st
end

func _bf_f(st: u32*, x: u32): u32:
    a := ((x >> (24 as u32)) & (255 as u32)) as int
    b := ((x >> (16 as u32)) & (255 as u32)) as int
    c := ((x >> (8 as u32)) & (255 as u32)) as int
    d := (x & (255 as u32)) as int
    ret ((st[18 + a] + st[274 + b]) ^ st[530 + c]) + st[786 + d]
end

// Encrypts the 64-bit block lr[0]:lr[1] in place.
func _bf_encipher(st: u32*, lr: u32*):
    mut l := lr[0] ^ st[0]
    mut r := lr[1]
    mut i := 1
    until i <= 16:
        r = r ^ _bf_f(st, l) ^ st[i]
        l = l ^ _bf_f(st, r) ^ st[i + 1]
        i += 2
    end
    lr[0] = r ^ st[17]
    lr[1] = l
end

// Reads the next big-endian word from data, cycling over its n bytes.
func _bf_stream2word(data: void*, n: int, j &: int): u32:
    mut w := 0 as u32
    repeat 4:
        w = (w << (8 as u32)) | (_bget(data, j) as u32)
        j = (j + 1) % n
    end
    ret w
end

// Fills P and S by repeated encryption; with salt != null each block is
// first mixed with the next two salt words (Blowfish_expandstate).
func _bf_fill(st: u32*, salt: void*, slen: int):
    lr := mem.Allocate(8 as u64) as u32*
    defer mem.Free(lr as void*)
    lr[0] = 0 as u32
    lr[1] = 0 as u32
    mut j := 0
    mut i := 0
    until i < BCRYPT_STATE_WORDS:
        if salt != null:
            lr[0] = lr[0] ^ _bf_stream2word(salt, slen, j)
            lr[1] = lr[1] ^ _bf_stream2word(salt, slen, j)
        end
        _bf_encipher(st, lr)
        st[i] = lr[0]
        st[i + 1] = lr[1]
        i += 2
    end
end

func _bf_mix_key(st: u32*, key: void*, klen: int):
    mut j := 0
    repeat 18 in i:
        st[i] = st[i] ^ _bf_stream2word(key, klen, j)
    end
end

func _bcrypt_alpha(): str:
    ret "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
end

func _bcrypt_index(c: int): int:
    if c == 46: ret 0 end
    if c == 47: ret 1 end
    if c >= 65 and c <= 90: ret c - 63 end
    if c >= 97 and c <= 122: ret c - 69 end
    if c >= 48 and c <= 57: ret c + 6 end
    ret -1
end

func _bcrypt_encode(data: void*, n: int): str:
    alpha := _bcrypt_alpha() as void*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut p := 0
    until p < n:
        mut c1 := _bget(data, p)
        p += 1
        str.BufAppendChar(sb, _bget(alpha, c1 / 4))
        c1 = (c1 % 4) * 16
        if p >= n:
            str.BufAppendChar(sb, _bget(alpha, c1))
            break
        end
        mut c2 := _bget(data, p)
        p += 1
        c1 = c1 + c2 / 16
        str.BufAppendChar(sb, _bget(alpha, c1))
        c1 = (c2 % 16) * 4
        if p >= n:
            str.BufAppendChar(sb, _bget(alpha, c1))
            break
        end
        c2 = _bget(data, p)
        p += 1
        c1 = c1 + c2 / 64
        str.BufAppendChar(sb, _bget(alpha, c1))
        str.BufAppendChar(sb, _bget(alpha, c2 % 64))
    end
    out := str.BufStr(sb)
    ret out
end

// Decodes the 22-character salt into 16 bytes at out; false on a bad digit.
func _bcrypt_decode_salt(s: str, out: void*): bool:
    if s.len() < 22:
        ret false
    end
    sp := s as void*
    mut bp := 0
    mut i := 0
    until bp < BCRYPT_SALT_LEN:
        c1 := _bcrypt_index(_bget(sp, i))
        c2 := _bcrypt_index(_bget(sp, i + 1))
        if c1 < 0 or c2 < 0: ret false end
        _bput(out, bp, c1 * 4 + (c2 / 16) % 4)
        bp += 1
        if bp >= BCRYPT_SALT_LEN: break end
        c3 := _bcrypt_index(_bget(sp, i + 2))
        if c3 < 0: ret false end
        _bput(out, bp, (c2 % 16) * 16 + (c3 / 4) % 16)
        bp += 1
        if bp >= BCRYPT_SALT_LEN: break end
        c4 := _bcrypt_index(_bget(sp, i + 3))
        if c4 < 0: ret false end
        _bput(out, bp, (c3 % 4) * 64 + c4)
        bp += 1
        i += 4
    end
    ret true
end

// Runs EksBlowfish and returns the 31-character hash part.
func _bcrypt_core(password: str, salt: void*, cost: int): str:
    plen := password.len()
    mut klen := plen
    if klen > 72:
        klen = 72
    end
    key := mem.Allocate((klen + 1) as u64)
    defer mem.Free(key)
    pp := password as void*
    repeat klen in i:
        _bput(key, i, _bget(pp, i))
    end
    _bput(key, klen, 0)
    klen += 1

    st := _bf_init()
    defer mem.Free(st as void*)
    _bf_mix_key(st, key, klen)
    _bf_fill(st, salt, BCRYPT_SALT_LEN)
    rounds := (1 as i64) << (cost as i64)
    mut r := 0 as i64
    until r < rounds:
        _bf_mix_key(st, key, klen)
        _bf_fill(st, null, 0)
        _bf_mix_key(st, salt, BCRYPT_SALT_LEN)
        _bf_fill(st, null, 0)
        r += 1
    end

    magic := "OrpheanBeholderScryDoubt"
    cdata := mem.Allocate(24 as u64) as u32*
    defer mem.Free(cdata as void*)
    mut j := 0
    repeat 6 in i:
        cdata[i] = _bf_stream2word(magic as void*, 24, j)
    end
    repeat 64:
        repeat 3 in i:
            _bf_encipher(st, (cdata as u64 + ((i * 8) as u64)) as u32*)
        end
    end
    raw := mem.Allocate(24 as u64)
    defer mem.Free(raw)
    repeat 6 in i:
        w := cdata[i]
        _bput(raw, i * 4, ((w >> (24 as u32)) & (255 as u32)) as int)
        _bput(raw, i * 4 + 1, ((w >> (16 as u32)) & (255 as u32)) as int)
        _bput(raw, i * 4 + 2, ((w >> (8 as u32)) & (255 as u32)) as int)
        _bput(raw, i * 4 + 3, (w & (255 as u32)) as int)
    end
    ret _bcrypt_encode(raw, BCRYPT_HASH_LEN)
end

func _bcrypt_cost_str(cost: int): str:
    if cost < 10:
        ret "0".concat(conv.FormatInt(cost as i64))
    end
    ret conv.FormatInt(cost as i64)
end

@en "BcryptHashWithSalt"
@fa "درهم بی کریپت با نمک"
pub func BcryptHashWithSalt(password: str, cost: int, salt: void*): str:
    mut c := cost
    if c < BCRYPT_MIN_COST: c = BCRYPT_MIN_COST end
    if c > BCRYPT_MAX_COST: c = BCRYPT_MAX_COST end
    ret "$2y$".concat(_bcrypt_cost_str(c)).concat("$").concat(_bcrypt_encode(salt, BCRYPT_SALT_LEN)).concat(_bcrypt_core(password, salt, c))
end

@en "BcryptHash"
@fa "درهم بی کریپت"
pub func BcryptHash(password: str, cost: int): str:
    salt := mem.Allocate(BCRYPT_SALT_LEN as u64)
    defer mem.Free(salt)
    RandomBytes(salt, BCRYPT_SALT_LEN)
    ret BcryptHashWithSalt(password, cost, salt)
end

@en "IsBcryptHash"
@fa "درهم بی کریپت است"
pub func IsBcryptHash(encoded: str): bool:
    if encoded.len() != 60:
        ret false
    end
    prefix := encoded.substr(0, 4)
    ret prefix == "$2y$" or prefix == "$2b$" or prefix == "$2a$"
end

@en "BcryptCost"
@fa "هزینه بی کریپت"
pub func BcryptCost(encoded: str): int:
    if not IsBcryptHash(encoded):
        ret -1
    end
    ret conv.ParseInt(encoded.substr(4, 2)) as int
end

@en "BcryptVerify"
@fa "تایید بی کریپت"
pub func BcryptVerify(password: str, encoded: str): bool:
    if not IsBcryptHash(encoded):
        ret false
    end
    if encoded.substr(6, 1) != "$":
        ret false
    end
    cost := BcryptCost(encoded)
    if cost < BCRYPT_MIN_COST or cost > BCRYPT_MAX_COST:
        ret false
    end
    salt := mem.Allocate(BCRYPT_SALT_LEN as u64)
    defer mem.Free(salt)
    if not _bcrypt_decode_salt(encoded.substr(7, 22), salt):
        ret false
    end
    computed := _bcrypt_core(password, salt, cost)
    ret _consttime_eq(computed, encoded.substr(29, 31))
end
