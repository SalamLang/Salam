package crypto

// HMAC-SHA1 (RFC 2104 over RFC 3174).
//
// SHA-1 is not a safe choice for anything new, and nothing here should be read
// as a recommendation. It is provided because two widely deployed protocols
// specify it and give no alternative: coturn's TURN REST API, which derives a
// relay credential as base64(HMAC-SHA1(secret, "expiry:user")), and AWS
// Signature Version 2. Interoperating with those means computing this exact
// value; reimplementing it per project is worse than having it once, correct,
// and labelled.
//
// For anything you control the other end of, use HmacSha256Hex.

import mem
import str
import encoding

const SHA1_BLOCK_SIZE := 64
const SHA1_DIGEST_SIZE := 20

// _at - a pointer `off` bytes into `p`. Salam has no arithmetic on typed
// pointers, so the offset is taken through an integer, which is what the rest
// of the standard library does too.
func _at(p: void*, off: int): void*:
    ret ((p as i64) + (off as i64)) as void*
end

// _sha1_key - the key, reduced to one block: hashed if it is longer, zero
// padded if it is shorter. RFC 2104's preparation step.
func _sha1_key(key: void*, klen: int, out: void*):
    if klen > SHA1_BLOCK_SIZE:
        Sha1Bytes(key, klen, out)
    else:
        mem.Copy(out, key, klen as u64)
    end
end

// _sha1_pads - the inner and outer padded keys.
func _sha1_pads(key: void*, klen: int, ipad: void*, opad: void*):
    kb := mem.AllocateZeroed(SHA1_BLOCK_SIZE as u64)
    defer mem.Free(kb)
    _sha1_key(key, klen, kb)
    kp := kb as u8*
    ip := ipad as u8*
    op := opad as u8*
    repeat SHA1_BLOCK_SIZE with i:
        ip[i] = ((kp[i] as int) ^ 0x36) as u8
        op[i] = ((kp[i] as int) ^ 0x5c) as u8
    end
end

@en "HmacSha1Raw"
@fa "اچ مک شا۱ خام"
@ar "اتش ماک شا١ خام"
pub func HmacSha1Raw(key: void*, klen: int, msg: void*, mlen: int, out: void*):
    ipad := mem.AllocateZeroed(SHA1_BLOCK_SIZE as u64)
    defer mem.Free(ipad)
    opad := mem.AllocateZeroed(SHA1_BLOCK_SIZE as u64)
    defer mem.Free(opad)
    _sha1_pads(key, klen, ipad, opad)
    inner_input := mem.Allocate((SHA1_BLOCK_SIZE + mlen) as u64)
    defer mem.Free(inner_input)
    mem.Copy(inner_input, ipad, SHA1_BLOCK_SIZE as u64)
    mem.Copy(_at(inner_input, SHA1_BLOCK_SIZE), msg, mlen as u64)
    inner := mem.Allocate(SHA1_DIGEST_SIZE as u64)
    defer mem.Free(inner)
    Sha1Bytes(inner_input, SHA1_BLOCK_SIZE + mlen, inner)
    outer_input := mem.Allocate((SHA1_BLOCK_SIZE + SHA1_DIGEST_SIZE) as u64)
    defer mem.Free(outer_input)
    mem.Copy(outer_input, opad, SHA1_BLOCK_SIZE as u64)
    mem.Copy(_at(outer_input, SHA1_BLOCK_SIZE), inner, SHA1_DIGEST_SIZE as u64)
    Sha1Bytes(outer_input, SHA1_BLOCK_SIZE + SHA1_DIGEST_SIZE, out)
end

@en "HmacSha1Bytes"
@fa "اچ مک شا۱ بایتی"
@ar "اتش ماک شا١ بایت"
pub func HmacSha1Bytes(key: str, msg: str, out: void*):
    HmacSha1Raw(key as void*, key.len(), msg as void*, msg.len(), out)
end

@en "HmacSha1Hex"
@fa "اچ مک شا۱ شانزدهی"
@ar "اتش ماک شا١ سداسی"
pub func HmacSha1Hex(key: str, msg: str): str:
    out := mem.Allocate(SHA1_DIGEST_SIZE as u64)
    defer mem.Free(out)
    HmacSha1Bytes(key, msg, out)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    bp := out as u8*
    repeat SHA1_DIGEST_SIZE with i:
        str.BufAppend(sb, _hex_byte(bp[i] as int))
    end
    ret str.BufStr(sb)
end

// HmacSha1Base64 - the form the TURN REST API wants: the raw 20 bytes, base64
// encoded, used directly as the relay password.
@en "HmacSha1Base64"
@fa "اچ مک شا۱ بیس۶۴"
@ar "اتش ماک شا١ بیس٦٤"
pub func HmacSha1Base64(key: str, msg: str): str:
    out := mem.Allocate(SHA1_DIGEST_SIZE as u64)
    defer mem.Free(out)
    HmacSha1Bytes(key, msg, out)
    ret encoding.Base64EncodeBytes(out, SHA1_DIGEST_SIZE)
end
