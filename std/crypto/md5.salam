package crypto

// MD5 (RFC 1321).
//
// BROKEN FOR ANY SECURITY PURPOSE. Practical collisions have existed since
// 2004 and chosen-prefix collisions since 2009. It is here only for legacy
// interoperability: file checksums, and the TLS 1.0/1.1 PRF, which specifies
// MD5 in combination with SHA-1. Never use it for signatures, certificates,
// password hashing or integrity against an adversary.

const MD5_SIZE := 16
const MD5_BLOCK := 64

const MD5_S := [
    7 as u32, 12 as u32, 17 as u32, 22 as u32
    5 as u32, 9 as u32, 14 as u32, 20 as u32
    4 as u32, 11 as u32, 16 as u32, 23 as u32
    6 as u32, 10 as u32, 15 as u32, 21 as u32
] as u32[16]

const MD5_K := [
    0xd76aa478 as u32, 0xe8c7b756 as u32, 0x242070db as u32, 0xc1bdceee as u32
    0xf57c0faf as u32, 0x4787c62a as u32, 0xa8304613 as u32, 0xfd469501 as u32
    0x698098d8 as u32, 0x8b44f7af as u32, 0xffff5bb1 as u32, 0x895cd7be as u32
    0x6b901122 as u32, 0xfd987193 as u32, 0xa679438e as u32, 0x49b40821 as u32
    0xf61e2562 as u32, 0xc040b340 as u32, 0x265e5a51 as u32, 0xe9b6c7aa as u32
    0xd62f105d as u32, 0x02441453 as u32, 0xd8a1e681 as u32, 0xe7d3fbc8 as u32
    0x21e1cde6 as u32, 0xc33707d6 as u32, 0xf4d50d87 as u32, 0x455a14ed as u32
    0xa9e3e905 as u32, 0xfcefa3f8 as u32, 0x676f02d9 as u32, 0x8d2a4c8a as u32
    0xfffa3942 as u32, 0x8771f681 as u32, 0x6d9d6122 as u32, 0xfde5380c as u32
    0xa4beea44 as u32, 0x4bdecfa9 as u32, 0xf6bb4b60 as u32, 0xbebfbc70 as u32
    0x289b7ec6 as u32, 0xeaa127fa as u32, 0xd4ef3085 as u32, 0x04881d05 as u32
    0xd9d4d039 as u32, 0xe6db99e5 as u32, 0x1fa27cf8 as u32, 0xc4ac5665 as u32
    0xf4292244 as u32, 0x432aff97 as u32, 0xab9423a7 as u32, 0xfc93a039 as u32
    0x655b59c3 as u32, 0x8f0ccc92 as u32, 0xffeff47d as u32, 0x85845dd1 as u32
    0x6fa87e4f as u32, 0xfe2ce6e0 as u32, 0xa3014314 as u32, 0x4e0811a1 as u32
    0xf7537e82 as u32, 0xbd3af235 as u32, 0x2ad7d2bb as u32, 0xeb86d391 as u32
] as u32[64]

struct Md5:
    pub h: u32[4] = [0 as u32, 0 as u32, 0 as u32, 0 as u32]
    pub blk: u8[64] = [
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
    ]
    pub blen: int = 0
    pub total: u64 = 0 as u64
end

// ---------------------------------------------------------------- MD5

func _md5_init(): Md5:
    mut s := Md5 {}
    s.h[0] = 0x67452301 as u32
    s.h[1] = 0xefcdab89 as u32
    s.h[2] = 0x98badcfe as u32
    s.h[3] = 0x10325476 as u32
    s.blen = 0
    s.total = 0 as u64
    ret s
end

func _md5_block(s &: Md5):
    // MD5 is little-endian, unlike every other hash in this package
    mut m: u32[16]
    repeat 16 with t:
        o := t * 4
        m[t] = (s.blk[o] as u32) | ((s.blk[o + 1] as u32) << (8 as u32)) | ((s.blk[o + 2] as u32) << (16 as u32)) | ((s.blk[o + 3] as u32) << (24 as u32))
    end
    mut a := s.h[0]
    mut b := s.h[1]
    mut c := s.h[2]
    mut d := s.h[3]
    repeat 64 with i:
        mut f := 0 as u32
        mut g := 0
        if i < 16:
            f = (b & c) | ((~b) & d)
            g = i
        else if i < 32:
            f = (d & b) | ((~d) & c)
            g = (5 * i + 1) % 16
        else if i < 48:
            f = b ^ c ^ d
            g = (3 * i + 5) % 16
        else:
            f = c ^ (b | (~d))
            g = (7 * i) % 16
        end
        tmp := d
        d = c
        c = b
        rot := MD5_S[(i / 16) * 4 + (i % 4)]
        x := a + f + MD5_K[i] + m[g]
        b = b + ((x << rot) | (x >> ((32 as u32) - rot)))
        a = tmp
    end
    s.h[0] += a
    s.h[1] += b
    s.h[2] += c
    s.h[3] += d
end

func _md5_update(s &: Md5, p: void*, n: int):
    mut i := 0
    until i < n:
        space := MD5_BLOCK - s.blen
        mut take := n - i
        if take > space:
            take = space
        end
        repeat take with j:
            s.blk[s.blen + j] = _bget(p, i + j) as u8
        end
        s.blen += take
        i += take
        s.total += take as u64
        if s.blen == MD5_BLOCK:
            _md5_block(s)
            s.blen = 0
        end
    end
end

func _md5_final(s0: Md5, out: void*):
    mut s := s0
    bits := s.total * (8 as u64)
    s.blk[s.blen] = 0x80 as u8
    s.blen += 1
    if s.blen > 56:
        until s.blen < MD5_BLOCK:
            s.blk[s.blen] = 0 as u8
            s.blen += 1
        end
        _md5_block(s)
        s.blen = 0
    end
    until s.blen < 56:
        s.blk[s.blen] = 0 as u8
        s.blen += 1
    end
    // length is little-endian here too
    repeat 8 with i:
        sh := (i * 8) as u64
        s.blk[56 + i] = ((bits >> sh) & (0xFF as u64)) as u8
    end
    _md5_block(s)
    repeat 4 with i:
        v := s.h[i]
        _bput(out, i * 4, (v & (0xFF as u32)) as int)
        _bput(out, i * 4 + 1, ((v >> (8 as u32)) & (0xFF as u32)) as int)
        _bput(out, i * 4 + 2, ((v >> (16 as u32)) & (0xFF as u32)) as int)
        _bput(out, i * 4 + 3, ((v >> (24 as u32)) & (0xFF as u32)) as int)
    end
end

func _md5(p: void*, n: int, out: void*):
    mut s := _md5_init()
    _md5_update(s, p, n)
    _md5_final(s, out)
end


@en "Md5Bytes"
@fa "ام دی ۵ بایت"
@ar "ام دی ۵ بایتات"
pub func Md5Bytes(p: void*, n: int, out: void*):
    _md5(p, n, out)
end

@en "Md5Hex"
@fa "ام دی ۵ شانزدهی"
@ar "ام دی ۵ سداسی"
pub func Md5Hex(data: str): str:
    d := mem.Allocate(MD5_SIZE as u64)
    defer mem.Free(d)
    _md5(data as void*, data.len(), d)
    mut r := ""
    repeat MD5_SIZE with i:
        r = r.concat(_hex_byte(_bget(d, i)))
    end
    ret r
end
