package crypto

@en "Pbkdf2HmacSha256Hex"
@fa "پی بی کِی دی اف۲ شانزدهی"
@ar "بی بی کی دی اف٢ سداسی"
pub func Pbkdf2HmacSha256Hex(password: str, salt: str, iterations: int, keylen: int): str:
    plen := password.len()
    slen := salt.len()
    outp := mem.Allocate(keylen as u64)
    defer mem.Free(outp)
    _pbkdf2_hmac_sha256_core(password as void*, plen, salt as void*, slen, iterations, outp, keylen)
    mut result := ""
    repeat keylen with i:
        result = result.concat(_hex_byte(_bget(outp, i)))
    end
    ret result
end

@en "HashPassword"
@fa "درهم گذرواژه"
@ar "بصمة کلمة مرور"
pub func HashPassword(password: str): str:
    salt := RandomHex(16)
    dk := Pbkdf2HmacSha256Hex(password, salt, PBKDF2_DEFAULT_ITERATIONS, 32)
    ret "pbkdf2-sha256$".concat(conv.FormatInt(PBKDF2_DEFAULT_ITERATIONS as i64)).concat("$").concat(salt).concat("$").concat(dk)
end

@en "VerifyPassword"
@fa "تایید گذرواژه"
@ar "تحقق کلمة مرور"
pub func VerifyPassword(password: str, encoded: str): bool:
    parts := str.Split(encoded, "$")
    if parts.len() != 4:
        ret false
    end
    if parts.get(0) != "pbkdf2-sha256":
        ret false
    end
    iterations := conv.ParseInt(parts.get(1)) as int
    if iterations <= 0:
        ret false
    end
    salt := parts.get(2)
    stored := parts.get(3)
    keylen := stored.len() / 2
    computed := Pbkdf2HmacSha256Hex(password, salt, iterations, keylen)
    ret _consttime_eq(computed, stored)
end

// Compare two secrets in time that does not depend on where they differ.
//
// `==` on a str stops at the first differing byte, and that timing is
// measurable across a network: an attacker who can ask repeatedly recovers a
// secret one byte at a time. Use this for API keys, webhook signatures,
// password reset tokens - anything an attacker supplies and the server
// compares against a stored value.
//
// THE EMPTY-SECRET TRAP: this is an exact comparison, so SecretEquals("", "")
// is true. If `expected` comes from configuration that might not have loaded,
// an empty one would match an empty candidate and let everyone in. Guard it
// at the call site:
//
//     if expected.len() == 0: ret false end
//     if !crypto.SecretEquals(given, expected): ret false end
@en "SecretEquals"
@fa "برابری راز"
@ar "تساوي السر"
pub func SecretEquals(a: str, b: str): bool:
    ret _consttime_eq(a, b)
end
