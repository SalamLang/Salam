package crypto

@en "RandomHex"
@fa "تصادفی ایمن شانزدهی"
@ar "عشوائی سداسی"
pub func RandomHex(n: int): str:
    if n <= 0:
        ret ""
    end
    buf := mem.Allocate(n as u64)
    defer mem.Free(buf)
    _os_random_fill(buf, n)
    mut result := ""
    repeat n with i:
        result = result.concat(_hex_byte(_bget(buf, i)))
    end
    ret result
end

@en "RandomToken"
@fa "توکن تصادفی ایمن"
@ar "رمز عشوائی"
pub func RandomToken(n: int): str:
    ret RandomHex(n)
end

// Fill a buffer with `n` bytes from the OS entropy source.
//
// The Hex and Token forms above return strings, which is the wrong shape for
// anything generating key material: a TLS private key or ClientHello random is
// raw bytes, and going via hex would double the allocation and leave a copy of
// the secret in a string nobody wipes.
//
// Aborts rather than returning an error if the OS source cannot be read. A
// caller that ignored a failure return would proceed with predictable bytes,
// which for key generation is worse than not starting.
@en "RandomBytes"
@fa "بایت های تصادفی"
@ar "بایتات عشوائیة"
pub func RandomBytes(p: void*, n: int):
    if n <= 0:
        ret
    end
    _os_random_fill(p, n)
end
