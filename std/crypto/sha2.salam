// ---------------------------------------------------------------- SHA-256

// Rotation counts are always in 1..31 here, so the `x << (32 - n)` half never
// becomes an undefined shift-by-width.
inline func _sha2_rotr32(x: u32, n: u32): u32:
    ret (x >> n) | (x << ((32 as u32) - n))
end

func _sha256_init(): Sha256:
    mut s := Sha256 {}
    repeat 8 with i:
        s.h[i] = SHA2_IV256[i]
    end
    s.blen = 0
    s.total = 0 as u64
    ret s
end

func _sha256_block(s &: Sha256):
    mut w: u32[64]
    repeat 16 with t:
        o := t * 4
        w[t] = ((s.blk[o] as u32) << (24 as u32)) | ((s.blk[o + 1] as u32) << (16 as u32)) | ((s.blk[o + 2] as u32) << (8 as u32)) | (s.blk[o + 3] as u32)
    end
    repeat 48 with k:
        t := k + 16
        x15 := w[t - 15]
        x2 := w[t - 2]
        s0 := _sha2_rotr32(x15, 7 as u32) ^ _sha2_rotr32(x15, 18 as u32) ^ (x15 >> (3 as u32))
        s1 := _sha2_rotr32(x2, 17 as u32) ^ _sha2_rotr32(x2, 19 as u32) ^ (x2 >> (10 as u32))
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
    end
    mut a := s.h[0]
    mut b := s.h[1]
    mut c := s.h[2]
    mut d := s.h[3]
    mut e := s.h[4]
    mut f := s.h[5]
    mut g := s.h[6]
    mut hh := s.h[7]
    repeat 64 with t:
        bigs1 := _sha2_rotr32(e, 6 as u32) ^ _sha2_rotr32(e, 11 as u32) ^ _sha2_rotr32(e, 25 as u32)
        ch := (e & f) ^ ((~e) & g)
        t1 := hh + bigs1 + ch + SHA2_K256[t] + w[t]
        bigs0 := _sha2_rotr32(a, 2 as u32) ^ _sha2_rotr32(a, 13 as u32) ^ _sha2_rotr32(a, 22 as u32)
        maj := (a & b) ^ (a & c) ^ (b & c)
        t2 := bigs0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    end
    s.h[0] += a
    s.h[1] += b
    s.h[2] += c
    s.h[3] += d
    s.h[4] += e
    s.h[5] += f
    s.h[6] += g
    s.h[7] += hh
end

func _sha256_update(s &: Sha256, p: void*, n: int):
    mut i := 0
    until i < n:
        space := SHA2_SHA256_BLOCK - s.blen
        mut take := n - i
        if take > space:
            take = space
        end
        repeat take with j:
            s.blk[s.blen + j] = _bget(p, i + j) as u8
        end
        s.blen += take
        i += take
        s.total += take as u64
        if s.blen == SHA2_SHA256_BLOCK:
            _sha256_block(s)
            s.blen = 0
        end
    end
end

// Takes the state by value: pads and finishes a copy so the caller's running
// transcript hash is left intact and can keep absorbing messages.
func _sha256_final(s0: Sha256, out: void*):
    mut s := s0
    bits := s.total * (8 as u64)
    s.blk[s.blen] = 0x80 as u8
    s.blen += 1
    if s.blen > 56:
        until s.blen < SHA2_SHA256_BLOCK:
            s.blk[s.blen] = 0 as u8
            s.blen += 1
        end
        _sha256_block(s)
        s.blen = 0
    end
    until s.blen < 56:
        s.blk[s.blen] = 0 as u8
        s.blen += 1
    end
    repeat 8 with i:
        sh := ((7 - i) * 8) as u64
        s.blk[56 + i] = ((bits >> sh) & (0xFF as u64)) as u8
    end
    _sha256_block(s)
    repeat 8 with i:
        v := s.h[i]
        _bput(out, i * 4, ((v >> (24 as u32)) & (0xFF as u32)) as int)
        _bput(out, i * 4 + 1, ((v >> (16 as u32)) & (0xFF as u32)) as int)
        _bput(out, i * 4 + 2, ((v >> (8 as u32)) & (0xFF as u32)) as int)
        _bput(out, i * 4 + 3, (v & (0xFF as u32)) as int)
    end
end

// ---------------------------------------------------------------- SHA-512/384

inline func _sha2_rotr64(x: u64, n: u64): u64:
    ret (x >> n) | (x << ((64 as u64) - n))
end

func _sha512_init_with(iv: u64[8], outlen: int): Sha512:
    mut s := Sha512 {}
    repeat 8 with i:
        s.h[i] = iv[i]
    end
    s.blen = 0
    s.total = 0 as u64
    s.outlen = outlen
    ret s
end

func _sha512_init(): Sha512:
    ret _sha512_init_with(SHA2_IV512, SHA2_SHA512_SIZE)
end

func _sha384_init(): Sha512:
    ret _sha512_init_with(SHA2_IV384, SHA2_SHA384_SIZE)
end

func _sha512_block(s &: Sha512):
    mut w: u64[80]
    repeat 16 with t:
        o := t * 8
        mut v := 0 as u64
        repeat 8 with j:
            v = (v << (8 as u64)) | (s.blk[o + j] as u64)
        end
        w[t] = v
    end
    repeat 64 with k:
        t := k + 16
        x15 := w[t - 15]
        x2 := w[t - 2]
        s0 := _sha2_rotr64(x15, 1 as u64) ^ _sha2_rotr64(x15, 8 as u64) ^ (x15 >> (7 as u64))
        s1 := _sha2_rotr64(x2, 19 as u64) ^ _sha2_rotr64(x2, 61 as u64) ^ (x2 >> (6 as u64))
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
    end
    mut a := s.h[0]
    mut b := s.h[1]
    mut c := s.h[2]
    mut d := s.h[3]
    mut e := s.h[4]
    mut f := s.h[5]
    mut g := s.h[6]
    mut hh := s.h[7]
    repeat 80 with t:
        bigs1 := _sha2_rotr64(e, 14 as u64) ^ _sha2_rotr64(e, 18 as u64) ^ _sha2_rotr64(e, 41 as u64)
        ch := (e & f) ^ ((~e) & g)
        t1 := hh + bigs1 + ch + SHA2_K512[t] + w[t]
        bigs0 := _sha2_rotr64(a, 28 as u64) ^ _sha2_rotr64(a, 34 as u64) ^ _sha2_rotr64(a, 39 as u64)
        maj := (a & b) ^ (a & c) ^ (b & c)
        t2 := bigs0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    end
    s.h[0] += a
    s.h[1] += b
    s.h[2] += c
    s.h[3] += d
    s.h[4] += e
    s.h[5] += f
    s.h[6] += g
    s.h[7] += hh
end

func _sha512_update(s &: Sha512, p: void*, n: int):
    mut i := 0
    until i < n:
        space := SHA2_SHA512_BLOCK - s.blen
        mut take := n - i
        if take > space:
            take = space
        end
        repeat take with j:
            s.blk[s.blen + j] = _bget(p, i + j) as u8
        end
        s.blen += take
        i += take
        s.total += take as u64
        if s.blen == SHA2_SHA512_BLOCK:
            _sha512_block(s)
            s.blen = 0
        end
    end
end

func _sha512_final(s0: Sha512, out: void*):
    mut s := s0
    bits := s.total * (8 as u64)
    s.blk[s.blen] = 0x80 as u8
    s.blen += 1
    if s.blen > 112:
        until s.blen < SHA2_SHA512_BLOCK:
            s.blk[s.blen] = 0 as u8
            s.blen += 1
        end
        _sha512_block(s)
        s.blen = 0
    end
    until s.blen < 112:
        s.blk[s.blen] = 0 as u8
        s.blen += 1
    end
    // The length field is 128 bits; the high half stays zero because `total`
    // counts bytes in a u64 and can never reach 2^61 bytes.
    repeat 8 with i:
        s.blk[112 + i] = 0 as u8
    end
    repeat 8 with i:
        sh := ((7 - i) * 8) as u64
        s.blk[120 + i] = ((bits >> sh) & (0xFF as u64)) as u8
    end
    _sha512_block(s)
    n := s.outlen
    repeat n with i:
        word := s.h[i / 8]
        sh := ((7 - (i % 8)) * 8) as u64
        _bput(out, i, ((word >> sh) & (0xFF as u64)) as int)
    end
end

// ---------------------------------------------------------------- one-shot

func _sha256(p: void*, n: int, out: void*):
    mut s := _sha256_init()
    _sha256_update(s, p, n)
    _sha256_final(s, out)
end

func _sha384(p: void*, n: int, out: void*):
    mut s := _sha384_init()
    _sha512_update(s, p, n)
    _sha512_final(s, out)
end

func _sha512(p: void*, n: int, out: void*):
    mut s := _sha512_init()
    _sha512_update(s, p, n)
    _sha512_final(s, out)
end

// ---------------------------------------------------------------- public API

@en "Sha256Bytes"
@fa "شا۲۵۶ بایت"
@ar "شا۲۵۶ بایتات"
pub func Sha256Bytes(p: void*, n: int, out: void*):
    _sha256(p, n, out)
end

@en "Sha384Bytes"
@fa "شا۳۸۴ بایت"
@ar "شا۳۸۴ بایتات"
pub func Sha384Bytes(p: void*, n: int, out: void*):
    _sha384(p, n, out)
end

@en "Sha512Bytes"
@fa "شا۵۱۲ بایت"
@ar "شا۵۱۲ بایتات"
pub func Sha512Bytes(p: void*, n: int, out: void*):
    _sha512(p, n, out)
end

// Streaming handles. Copying a state is a plain assignment, and Final takes
// its state by value, so a running hash can be branched or digested without
// being consumed.

@en "Sha256New"
@fa "شا۲۵۶ جدید"
@ar "شا۲۵۶ جدید"
pub func Sha256New(): Sha256:
    ret _sha256_init()
end

@en "Sha256Update"
@fa "به روز رسانی شا۲۵۶"
@ar "تحدیث شا۲۵۶"
pub func Sha256Update(s &: Sha256, p: void*, n: int):
    _sha256_update(s, p, n)
end

@en "Sha256Final"
@fa "نهایی شا۲۵۶"
@ar "إنهاء شا۲۵۶"
pub func Sha256Final(s: Sha256, out: void*):
    _sha256_final(s, out)
end

@en "Sha384New"
@fa "شا۳۸۴ جدید"
@ar "شا۳۸۴ جدید"
pub func Sha384New(): Sha512:
    ret _sha384_init()
end

@en "Sha512New"
@fa "شا۵۱۲ جدید"
