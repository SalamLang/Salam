@en "Sha512Update"
@fa "به روز رسانی شا۵۱۲"
@ar "تحدیث شا۵۱۲"
pub func Sha512Update(s &: Sha512, p: void*, n: int):
    _sha512_update(s, p, n)
end

@en "Sha512Final"
@fa "نهایی شا۵۱۲"
