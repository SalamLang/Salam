package crypto

// SHA-2 (FIPS 180-4): SHA-256, SHA-384 and SHA-512.
//
// Streaming, byte-oriented, and written with native bitwise operators. It
// replaces the arithmetic in crypto.salam, which predates those operators and
// emulated XOR and AND with nibble lookup tables; _sha256_core and
// _sha512_core now delegate here, so every existing caller gets the faster
// path without changing.
//
// The streaming form matters beyond speed. A running hash that can be cloned,
// and digested without being disturbed, is what a TLS handshake transcript
// needs, and it is why `final` takes its state BY VALUE: it pads and finishes
// a copy, leaving the caller free to keep appending.


// SHA-2 family: SHA-256, SHA-384, SHA-512 (FIPS 180-4).
//
// Streaming (init/update/final) rather than one-shot, because TLS needs a
// running *transcript hash* over every handshake message and must be able to
// take a digest of the transcript-so-far at several points without disturbing
// the running state. `final` therefore takes its state BY VALUE: it pads and
// finishes a copy, leaving the caller free to keep appending. Cloning the
// transcript is likewise just an assignment, since Salam copies struct-embedded
// fixed arrays by value.
//
// Unlike std/crypto (which predates Salam's bitwise operators and emulates them
// with nibble lookup tables), this uses native u32/u64 operations throughout.
// NOTE: these must be exercised via the compiled backend -- `salam exec` does
// not implement unsigned wraparound.

const SHA2_SHA256_SIZE := 32
const SHA2_SHA384_SIZE := 48
const SHA2_SHA512_SIZE := 64
const SHA2_SHA256_BLOCK := 64
const SHA2_SHA512_BLOCK := 128

const SHA2_K256 := [
    0x428a2f98 as u32, 0x71374491 as u32, 0xb5c0fbcf as u32, 0xe9b5dba5 as u32
    0x3956c25b as u32, 0x59f111f1 as u32, 0x923f82a4 as u32, 0xab1c5ed5 as u32
    0xd807aa98 as u32, 0x12835b01 as u32, 0x243185be as u32, 0x550c7dc3 as u32
    0x72be5d74 as u32, 0x80deb1fe as u32, 0x9bdc06a7 as u32, 0xc19bf174 as u32
    0xe49b69c1 as u32, 0xefbe4786 as u32, 0x0fc19dc6 as u32, 0x240ca1cc as u32
