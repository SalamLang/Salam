package data

import conv
import encoding.csv
import io
import mem
import math
import matrix
import os
import str

@en "Table"
@fa "جدول"
pub struct Table:
    @en "names"
    @fa "نام‌ها"
    pub names: Vector<str> = Vector {}
    @en "kinds"
    @fa "گونه‌ها"
    pub kinds: Vector<int> = Vector {}
    @en "cats"
    @fa "سطح‌ها"
    pub cats: Vector<Vector<str>> = Vector {}
    @en "raw"
    @fa "متن خام"
    pub raw: Vector<Vector<str>> = Vector {}
    @en "cells"
    @fa "خانه‌ها"
    pub cells: matrix.Matrix = matrix.Matrix {}

    @en "Rows"
    @fa "سطرها"
    pub func Rows(): int: ret this.cells.rows end

    @en "rows"
    @fa "سطرها"
    pub func rows(): int: ret this.Rows() end

    @en "Cols"
    @fa "ستون‌ها"
    pub func Cols(): int: ret this.names.Len() end

    @en "cols"
    @fa "ستون‌ها"
    pub func cols(): int: ret this.Cols() end

    @en "ColIndex"
    @fa "نمایه ستون"
    pub func ColIndex(name: str): int:
        repeat this.names.Len() in j:
            if str.Equals(this.names.get(j), name): ret j end
        end
        ret 0 - 1
    end

    @en "col_index"
    @fa "نمایه ستون"
    pub func col_index(name: str): int:
        ret this.ColIndex(name)
    end

    @en "CatLevels"
    @fa "سطوح رده‌ای"
    pub func CatLevels(name: str): Vector<str>:
        mut out := Vector {} as Vector<str>
        j := this.ColIndex(name)
        if j < 0 or this.kinds.get(j) != COL_CAT: ret out end
        lv := this.cats.get(j)
        repeat lv.Len() in i: out.push(lv.get(i)) end
        ret out
    end

    @en "cat_levels"
    @fa "سطوح رده‌ای"
    pub func cat_levels(name: str): Vector<str>:
        ret this.CatLevels(name)
    end

    @en "ToMatrix"
    @fa "به ماتریس"
    pub func ToMatrix(): matrix.Matrix:
        mut keep := Vector {} as Vector<int>
        repeat this.kinds.Len() in j:
            if this.kinds.get(j) != COL_STR: keep.push(j) end
        end
        r := _select_cols(this.cells, keep)
        keep.free()
        ret r
    end

    @en "to_matrix"
    @fa "به ماتریس"
    pub func to_matrix(): matrix.Matrix:
        ret this.ToMatrix()
    end

    @en "SplitXY"
    @fa "جداسازی ویژگی از برچسب"
    pub func SplitXY(label: str, x &: matrix.Matrix, y &: matrix.Matrix): bool:
        lj := this.ColIndex(label)
        if lj < 0 or this.kinds.get(lj) == COL_STR: ret false end
        mut keep := Vector {} as Vector<int>
        repeat this.kinds.Len() in j:
            if j != lj and this.kinds.get(j) != COL_STR: keep.push(j) end
        end
        matrix.Free(x)
        matrix.Free(y)
        x = _select_cols(this.cells, keep)
        mut one := Vector {} as Vector<int>
        one.push(lj)
        y = _select_cols(this.cells, one)
        keep.free()
        one.free()
        ret true
    end

    @en "SplitXy"
    @fa "جداسازی ویژگی از برچسب"
    pub func SplitXy(label: str, x &: matrix.Matrix, y &: matrix.Matrix): bool:
        ret this.SplitXY(label, x, y)
    end

    @en "split_xy"
    @fa "جداسازی ویژگی از برچسب"
    pub func split_xy(label: str, x &: matrix.Matrix, y &: matrix.Matrix): bool: ret this.SplitXy(label, x, y) end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        repeat this.names.Len() in j: mem.Free(this.names.get(j) as void*) end
        this.names.free()
        this.kinds.free()
        repeat this.cats.Len() in j:
            mut lv := this.cats.get(j)
            _free_strs(lv)
        end
        this.cats.free()
        repeat this.raw.Len() in j:
            mut rv := this.raw.get(j)
            _free_strs(rv)
        end
        this.raw.free()
        matrix.Free(this.cells)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

func _free_strs(v &: Vector<str>):
    repeat v.Len() in i: mem.Free(v.get(i) as void*) end
    v.free()
end

func _trim(s: str): str:
    mid := str.TrimRight(s)
    out := str.TrimLeft(mid)
    mem.Free(mid as void*)
    ret out
end

func _is_number(s: str, whole &: bool): bool:
    n := str.Len(s)
    bp := _bp(s)
    mut i := 0
    if i < n and (_ub(bp, i) == 43 or _ub(bp, i) == 45): i++ end
    mut digits := 0
    until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
        i++
        digits++
    end
    whole = true
    if i < n and _ub(bp, i) == 46:
        whole = false
        i++
        until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
            i++
            digits++
        end
    end
    if digits == 0: ret false end
    if i < n and (_ub(bp, i) == 101 or _ub(bp, i) == 69):
        whole = false
        i++
        if i < n and (_ub(bp, i) == 43 or _ub(bp, i) == 45): i++ end
        mut ed := 0
        until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
            i++
            ed++
        end
        if ed == 0: ret false end
    end
    ret i == n
end

func _select_cols(cells &: matrix.Matrix, keep &: Vector<int>): matrix.Matrix:
    mut r := matrix.Zeros(cells.rows, keep.Len())
    repeat cells.rows in i:
        repeat keep.Len() in t: r.set(i, t, cells.at(i, keep.get(t))) end
    end
    ret r
end

func _level_index(levels &: Vector<str>, v: str): int:
    repeat levels.Len() in i:
        if str.Equals(levels.get(i), v): ret i end
    end
    ret 0 - 1
end

@en "LoadCsv"
@fa "بارگذاری سی‌اس‌وی"
pub func LoadCsv(text: str, header: bool): Table throws:
    mut t := Table {}
    mut parsed := try csv.ReadAll(text)
    total := parsed.rows.Len()
    if total == 0: ret t end
    mut first := 0
    ncols := parsed.rows.get(0).fields.Len()
    if header:
        hdr := parsed.rows.get(0)
        repeat ncols in j: t.names.push(_trim(hdr.fields.get(j))) end
        first = 1
    else:
        repeat ncols in j: t.names.push("col" + j) end
    end
    n := total - first
    t.cells = matrix.Zeros(n, ncols)
    nan := math.NaN()
    repeat ncols in j:
        mut all_int := true
        mut all_num := true
        mut levels := Vector {} as Vector<str>
        mut texts := Vector {} as Vector<str>
        repeat n in i:
            row := parsed.rows.get(first + i)
            mut cell := ""
            if j < row.fields.Len(): cell = _trim(row.fields.get(j)) end
            texts.push(cell)
            if str.Len(cell) > 0:
                mut whole := false
                if _is_number(cell, whole):
                    if whole == false: all_int = false end
                else:
                    all_int = false
                    all_num = false
                end
            end
            if _level_index(levels, cell) < 0: levels.push(str.Clone(cell)) end
        end
        mut kind := COL_STR
        if all_num:
            kind = COL_FLOAT
            if all_int: kind = COL_INT end
        else:
            mut cap := n / 10
            if cap < 20: cap = 20 end
            if levels.Len() <= cap and levels.Len() < n: kind = COL_CAT end
        end
        t.kinds.push(kind)
        repeat n in i:
            cell := texts.get(i)
            mut v := nan
            if kind == COL_CAT:
                v = _level_index(levels, cell) as f64
            else kind != COL_STR:
                if str.Len(cell) > 0: v = conv.ParseFloatOr(cell, nan) end
            end
            t.cells.set(i, j, v)
        end
        if kind == COL_CAT:
            t.cats.push(levels)
        else:
            _free_strs(levels)
            t.cats.push(Vector {} as Vector<str>)
        end
        if kind == COL_STR:
            t.raw.push(texts)
        else:
            _free_strs(texts)
            t.raw.push(Vector {} as Vector<str>)
        end
    end
    csv.FreeTable(parsed)
    ret t
end

@en "LoadCsvFile"
@fa "بارگذاری پرونده سی‌اس‌وی"
pub func LoadCsvFile(path: str, header: bool): Table throws:
    if os.Exists(path) == false:
        throw Error.New(ErrorKind.NotFound, "file not found").with_path(path)
    end
    text := io.ReadFile(path)
    defer mem.Free(text as void*)
    try:
        ret LoadCsv(text, header)
    catch e:
        throw e.with_path(path)
    end
end
