package data

import matrix
import ai.tensor

@en "BatchIter"
@fa "پیمایشگر دسته"
pub struct BatchIter:
    @en "x"
    @fa "ویژگی‌ها"
    pub x: matrix.Matrix = matrix.Matrix {}
    @en "y"
    @fa "برچسب‌ها"
    pub y: matrix.Matrix = matrix.Matrix {}
    @en "batch"
    @fa "اندازه دسته"
    pub batch: int = 32
    @en "shuffle"
    @fa "درهم‌ریزی"
    pub shuffle: bool = true
    @en "seed"
    @fa "بذر"
    pub seed: i64 = 0
    @en "order"
    @fa "ترتیب"
    pub order: Vector<int> = Vector {}
    @en "pos"
    @fa "جایگاه"
    pub pos: int = 0

    @en "Reset"
    @fa "بازنشانی"
    pub func Reset(epoch: i64):
        n := this.x.rows
        this.order.clear()
        repeat n in i: this.order.push(i) end
        if this.shuffle:
            mut g := matrix.NewRng(this.seed + epoch)
            mut i := n - 1
            until i > 0:
                j := (g.next_float() * ((i + 1) as f64)) as int
                t := this.order.get(i)
                this.order.set(i, this.order.get(j))
                this.order.set(j, t)
                i--
            end
        end
        this.pos = 0
    end

    @en "reset"
    @fa "بازنشانی"
    pub func reset(epoch: i64):
        this.Reset(epoch)
    end

    @en "Next"
    @fa "بعدی"
    pub func Next(x_out &: matrix.Matrix, y_out &: matrix.Matrix): bool:
        n := this.order.Len()
        if this.pos >= n: ret false end
        mut cnt := this.batch
        if this.pos + cnt > n: cnt = n - this.pos end
        matrix.Free(x_out)
        matrix.Free(y_out)
        x_out = matrix.Zeros(cnt, this.x.cols)
        y_out = matrix.Zeros(cnt, this.y.cols)
        repeat cnt in i:
            src := this.order.get(this.pos + i)
            repeat this.x.cols in j: x_out.set(i, j, this.x.at(src, j)) end
            repeat this.y.cols in j: y_out.set(i, j, this.y.at(src, j)) end
        end
        this.pos += cnt
        ret true
    end

    @en "next"
    @fa "بعدی"
    pub func next(x_out &: matrix.Matrix, y_out &: matrix.Matrix): bool:
        ret this.Next(x_out, y_out)
    end

    @en "NextTensor"
    @fa "بعدی تانسور"
    pub func NextTensor(x_out &: tensor.Tensor, labels_out &: Vector<int>): bool:
        n := this.order.Len()
        if this.pos >= n: ret false end
        mut cnt := this.batch
        if this.pos + cnt > n: cnt = n - this.pos end
        x_out.free()
        x_out = tensor.Zeros2(cnt, this.x.cols)
        labels_out.clear()
        p := x_out.data.data
        repeat cnt in i:
            src := this.order.get(this.pos + i)
            repeat this.x.cols in j: p[i * this.x.cols + j] = this.x.at(src, j) as f32 end
            labels_out.push(this.y.at(src, 0) as int)
        end
        this.pos += cnt
        ret true
    end

    @en "next_tensor"
    @fa "بعدی تانسور"
    pub func next_tensor(x_out &: tensor.Tensor, labels_out &: Vector<int>): bool:
        ret this.NextTensor(x_out, labels_out)
    end

    @en "BatchesPerEpoch"
    @fa "شمار دسته در دور"
    pub func BatchesPerEpoch(): int:
        n := this.x.rows
        if this.batch <= 0: ret 0 end
        ret (n + this.batch - 1) / this.batch
    end

    @en "batches_per_epoch"
    @fa "شمار دسته در دور"
    pub func batches_per_epoch(): int:
        ret this.BatchesPerEpoch()
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.order.free() end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "MatrixDataset"
@fa "مجموعه‌داده ماتریسی"
pub struct MatrixDataset:
    @en "x"
    @fa "ویژگی‌ها"
    pub x: matrix.Matrix = matrix.Matrix {}
    @en "y"
    @fa "برچسب‌ها"
    pub y: matrix.Matrix = matrix.Matrix {}

    @en "Len"
    @fa "طول"
    pub func Len(): int: ret this.x.rows end

    @en "len"
    @fa "طول"
    pub func len(): int: ret this.Len() end

    @en "Batches"
    @fa "دسته‌ها"
    pub func Batches(batch: int, shuffle: bool, seed: i64): BatchIter:
        mut it := BatchIter {}
        it.x = this.x
        it.y = this.y
        it.batch = batch
        it.shuffle = shuffle
        it.seed = seed
        it.Reset(0)
        ret it
    end

    @en "batches"
    @fa "دسته‌ها"
    pub func batches(batch: int, shuffle: bool, seed: i64): BatchIter:
        ret this.Batches(batch, shuffle, seed)
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.x)
        matrix.Free(this.y)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

@en "XTensor"
@fa "تانسور ویژگی"
pub func XTensor(x &: matrix.Matrix): tensor.Tensor:
    ret tensor.FromMatrix(x)
end

@en "YLabels"
@fa "برچسب‌ها"
pub func YLabels(y &: matrix.Matrix): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat y.rows in i: out.push(y.at(i, 0) as int) end
    ret out
end
