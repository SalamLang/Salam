package clickhouse

import db

struct _DbRows:
    rows: Rows = Rows {}

    @en "Ok"
    @fa "معتبر"
    pub func Ok(): bool:
        ret this.rows.Ok()
    end

    @en "Next"
    @fa "بعدی"
    pub func Next(): bool:
        ret this.rows.Next()
    end

    @en "ColumnCount"
    @fa "تعداد ستون"
    pub func ColumnCount(): int:
        ret this.rows.ColumnCount()
    end

    @en "ColumnName"
    @fa "نام ستون"
    pub func ColumnName(col: int): str:
        ret this.rows.ColumnName(col)
    end

    @en "ColumnType"
    @fa "نوع ستون"
    pub func ColumnType(col: int): int:
        if this.rows.IsNull(col): ret db.TYPE_NULL end
        kind := this.rows.ColumnKind(col)
        if kind == KIND_INT or kind == KIND_UINT or kind == KIND_BOOL: ret db.TYPE_INT end
        if kind == KIND_FLOAT or kind == KIND_DECIMAL: ret db.TYPE_FLOAT end
        ret db.TYPE_TEXT
    end

    @en "IsNull"
    @fa "خالی است"
    pub func IsNull(col: int): bool:
        ret this.rows.IsNull(col)
    end

    @en "Text"
    @fa "متن"
    pub func Text(col: int): str:
        ret this.rows.Text(col)
    end

    @en "Int"
    @fa "عدد صحیح"
    pub func Int(col: int): int:
        ret this.rows.Int(col)
    end

    @en "Int64"
    @fa "عدد صحیح۶۴"
    pub func Int64(col: int): i64:
        ret this.rows.Int64(col)
    end

    @en "Float"
    @fa "عدد اعشار"
    pub func Float(col: int): f64:
        ret this.rows.Float(col)
    end

    @en "Close"
    @fa "بستن"
    pub func Close(): int:
        this.rows.Close()
        ret 0
    end
end

struct _DbTx:
    conn: Conn = Conn {}

    @en "Ok"
    @fa "معتبر"
    pub func Ok(): bool:
        ret this.conn.connected
    end

    @en "Exec"
    @fa "اجرا"
    pub func Exec(sql: str): int:
        ret this.conn.ExecParams(sql, HashMap {} as HashMap<str, str>) ? 0 : -1
    end

    @en "Query"
    @fa "پرسمان"
    pub func Query(sql: str): dyn db.Rows:
        ret _DbRows { rows = this.conn.QueryParams(sql, HashMap {} as HashMap<str, str>) }
    end

    @en "Commit"
    @fa "ثبت تراکنش"
    pub func Commit(): int:
        ret 0
    end

    @en "Rollback"
    @fa "بازگردانی"
    pub func Rollback(): int:
        ret -1
    end
end

struct _DbConn:
    conn: Conn = Conn {}

    @en "Kind"
    @fa "نوع"
    pub func Kind(): str:
        ret db.CLICKHOUSE
    end

    @en "Ok"
    @fa "معتبر"
    pub func Ok(): bool:
        ret this.conn.connected
    end

    @en "Ping"
    @fa "پینگ"
    pub func Ping(): bool:
        ret this.conn.Ping()
    end

    @en "Exec"
    @fa "اجرا"
    pub func Exec(sql: str): int:
        ret this.conn.ExecParams(sql, HashMap {} as HashMap<str, str>) ? 0 : -1
    end

    @en "Query"
    @fa "پرسمان"
    pub func Query(sql: str): dyn db.Rows:
        ret _DbRows { rows = this.conn.QueryParams(sql, HashMap {} as HashMap<str, str>) }
    end

    @en "Begin"
    @fa "شروع تراکنش"
    pub func Begin(): dyn db.Tx:
        ret _DbTx { conn = this.conn }
    end

    @en "LastInsertId"
    @fa "شناسه آخرین درج"
    pub func LastInsertId(): i64:
        ret 0
    end

    @en "Changes"
    @fa "تعداد تغییرات"
    pub func Changes(): i64:
        ret this.conn.written_rows
    end

    @en "Error"
    @fa "خطا"
    pub func Error(): str:
        ret this.conn.Error()
    end

    @en "Quote"
    @fa "نقل قول"
    pub func Quote(s: str): str:
        ret StrArg(s)
    end

    @en "Close"
    @fa "بستن"
    pub func Close(): int:
        this.conn.Close()
        ret 0
    end
end

@en "AsDb"
@fa "به دیتابیس"
pub func AsDb(c: Conn): dyn db.Connection:
    ret _DbConn { conn = c }
end
