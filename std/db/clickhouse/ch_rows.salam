package clickhouse

import str
import math
import conv
import encoding.json

@en "Rows"
@fa "ردیف‌ها"
pub struct Rows:
    @en "names"
    @fa "نام‌ها"
    pub names: Vector<str> = Vector {}
    @en "types"
    @fa "نوع‌ها"
    pub types: Vector<str> = Vector {}
    @en "rows"
    @fa "ردیف‌ها"
    pub rows: Vector<str> = Vector {}
    @en "cells"
    @fa "سلول‌ها"
    pub cells: Vector<str> = Vector {}
    @en "pos"
    @fa "جایگاه"
    pub pos: int = -1
    @en "total"
    @fa "جمع"
    pub total: i64 = 0
    @en "err"
    @fa "پیام خطا"
    pub err: str = ""

    @en "Ok"
    @fa "معتبر"
    pub func Ok(): bool:
        ret this.err.Len() == 0
    end

    @en "Error"
    @fa "خطا"
    pub func Error(): str:
        ret this.err
    end

    @en "Next"
    @fa "بعدی"
    pub func Next(): bool:
        if this.err.Len() > 0 or this.pos + 1 >= this.rows.Len(): ret false end
        this.pos++
        this.cells = json.Items(this.rows.get(this.pos))
        ret true
    end

    @en "RowCount"
    @fa "تعداد ردیف"
    pub func RowCount(): int:
        ret this.rows.Len()
    end

    @en "ColumnCount"
    @fa "تعداد ستون"
    pub func ColumnCount(): int:
        ret this.names.Len()
    end

    @en "ColumnName"
    @fa "نام ستون"
    pub func ColumnName(col: int): str:
        if col < 0 or col >= this.names.Len(): ret "" end
        ret this.names.get(col)
    end

    @en "ColumnType"
    @fa "نوع ستون"
    pub func ColumnType(col: int): str:
        if col < 0 or col >= this.types.Len(): ret "" end
        ret this.types.get(col)
    end

    @en "ColumnKind"
    @fa "دسته ستون"
    pub func ColumnKind(col: int): int:
        ret TypeKind(this.ColumnType(col))
    end

    @en "ColumnIndex"
    @fa "شماره ستون"
    pub func ColumnIndex(name: str): int:
        repeat this.names.Len() in i:
            if this.names.get(i) == name: ret i end
        end
        ret -1
    end

    func _raw(col: int): str:
        if col < 0 or col >= this.cells.Len(): ret "" end
        ret this.cells.get(col)
    end

    @en "Raw"
    @fa "خام"
    pub func Raw(col: int): str:
        ret this._raw(col)
    end

    @en "IsNull"
    @fa "تهی است"
    pub func IsNull(col: int): bool:
        raw := this._raw(col)
        ret raw == "null" or raw.Len() == 0
    end

    @en "Text"
    @fa "متن"
    pub func Text(col: int): str:
        ret _cell_text(this._raw(col))
    end

    @en "Int64"
    @fa "صحیح۶۴"
    pub func Int64(col: int): i64:
        ret _to_i64(_cell_text(this._raw(col)))
    end

    @en "Int"
    @fa "صحیح"
    pub func Int(col: int): int:
        ret this.Int64(col) as int
    end

    @en "UInt64"
    @fa "طبیعی۶۴"
    pub func UInt64(col: int): u64:
        ret _to_u64(_cell_text(this._raw(col)))
    end

    @en "Float"
    @fa "اعشار"
    pub func Float(col: int): f64:
        ret _to_f64(_cell_text(this._raw(col)))
    end

    @en "Bool"
    @fa "منطقی"
    pub func Bool(col: int): bool:
        t := _cell_text(this._raw(col))
        ret t == "true" or t == "1"
    end

    @en "List"
    @fa "فهرست"
    pub func List(col: int): Vector<str>:
        mut out := Vector {} as Vector<str>
        each item in json.Items(this._raw(col)):
            out.push(_cell_text(item))
        end
        ret out
    end

    @en "TextBy"
    @fa "متن با نام"
    pub func TextBy(name: str): str:
        ret this.Text(this.ColumnIndex(name))
    end

    @en "Int64By"
    @fa "صحیح۶۴ با نام"
    pub func Int64By(name: str): i64:
        ret this.Int64(this.ColumnIndex(name))
    end

    @en "FloatBy"
    @fa "اعشار با نام"
    pub func FloatBy(name: str): f64:
        ret this.Float(this.ColumnIndex(name))
    end

    @en "Row"
    @fa "ردیف"
    pub func Row(): Vector<str>:
        mut out := Vector {} as Vector<str>
        repeat this.cells.Len() in i:
            out.push(this.Text(i))
        end
        ret out
    end

    @en "Close"
    @fa "بستن"
    pub func Close():
        this.rows.free()
        this.cells.free()
        this.rows = Vector {} as Vector<str>
        this.cells = Vector {} as Vector<str>
        this.pos = -1
    end
end

@en "Batch"
@fa "دسته"
pub struct Batch:
    @en "head"
    @fa "سرآیند"
    pub head: str = ""
    @en "width"
    @fa "پهنا"
    pub width: int = 0
    @en "rows"
    @fa "ردیف‌ها"
    pub rows: Vector<str> = Vector {}
    @en "err"
    @fa "پیام خطا"
    pub err: str = ""

    @en "Append"
    @fa "افزودن"
    pub func Append(values: Vector<str>): bool:
        if this.width > 0 and values.Len() != this.width:
            this.err = "the row has " + str.FromInt(values.Len() as i64) + " values but the insert names " + str.FromInt(this.width as i64) + " columns"
            ret false
        end
        this.rows.push("(" + str.Join(values, ", ") + ")")
        ret true
    end

    @en "Len"
    @fa "طول"
    pub func Len(): int:
        ret this.rows.Len()
    end

    @en "Error"
    @fa "خطا"
    pub func Error(): str:
        ret this.err
    end

    @en "Abort"
    @fa "رها کردن"
    pub func Abort():
        this.rows.free()
        this.rows = Vector {} as Vector<str>
        this.err = ""
    end
end

func _cell_text(raw: str): str:
    if raw == "null": ret str.Clone("") end
    if str.StartsWith(raw, "\""): ret json.Unquote(raw) end
    ret raw
end

func _to_i64(text: str): i64:
    ret conv.ParseIntOr(text, 0 as i64)
end

func _to_u64(text: str): u64:
    mut out := 0 as u64
    n := str.ByteLen(text)
    repeat n in i:
        d := "0123456789".find(str.ByteSub(text, i, 1))
        if d < 0: ret 0 end
        out = out * (10 as u64) + (d as u64)
    end
    ret out
end

func _to_f64(text: str): f64:
    if text == "nan": ret math.NaN() end
    if text == "inf": ret math.Inf() end
    if text == "-inf": ret 0.0 - math.Inf() end
    ret conv.ParseFloatOr(text, 0.0)
end

func _parse_rows(body: str): Rows:
    if not json.Valid(body): ret Rows { err = "the server sent a reply that is not JSON" } end
    mut r := Rows {}
    each m in json.Items(json.Get(body, "meta")):
        r.names.push(json.Get(m, "name"))
        r.types.push(json.Get(m, "type"))
    end
    r.rows = json.Items(json.Get(body, "data"))
    r.total = conv.ParseIntOr(json.Get(body, "rows"), 0 as i64)
    ret r
end

func _new_batch(sql: str): Batch:
    mut head := str.Trim(sql)
    until str.EndsWith(head, ";"):
        head = str.Trim(head.substr(0, head.Len() - 1))
    end
    if str.EndsWith(head.upper(), " VALUES"):
        head = str.Trim(head.substr(0, head.Len() - 7))
    end
    if not str.StartsWith(head.upper(), "INSERT INTO "):
        ret Batch { err = "a batch must start with INSERT INTO" }
    end
    mut width := 0
    open_at := head.find("(")
    if open_at >= 0:
        close_at := str.IndexFrom(head, ")", open_at)
        if close_at > open_at:
            width = head.substr(open_at + 1, close_at - open_at - 1).split(",").Len()
        end
    end
    ret Batch { head = head, width = width }
end
