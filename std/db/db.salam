@en "db"
@fa "دیتابیس"
package db

@en "SQLITE"
@fa "اس کیو لایت"
pub const SQLITE := "sqlite"

@en "MYSQL"
@fa "مای اس کیو ال"
pub const MYSQL := "mysql"

@en "POSTGRES"
@fa "پستگرس"
pub const POSTGRES := "postgres"

@en "TYPE_NULL"
@fa "نوع خالی"
pub const TYPE_NULL := 0

@en "TYPE_INT"
@fa "نوع صحیح"
pub const TYPE_INT := 1

@en "TYPE_FLOAT"
@fa "نوع اعشاری"
pub const TYPE_FLOAT := 2

@en "TYPE_TEXT"
@fa "نوع متن"
pub const TYPE_TEXT := 3

@en "TYPE_BLOB"
@fa "نوع دودویی"
pub const TYPE_BLOB := 4

@en "Rows"
@fa "ردیف ها"
pub interface Rows:
    @en "Ok"
    @fa "معتبر"
    func Ok(): bool
    @en "Next"
    @fa "بعدی"
    func Next(): bool
    @en "ColumnCount"
    @fa "تعداد ستون"
    func ColumnCount(): int
    @en "ColumnName"
    @fa "نام ستون"
    func ColumnName(col: int): str
    @en "ColumnType"
    @fa "نوع ستون"
    func ColumnType(col: int): int
    @en "IsNull"
    @fa "خالی است"
    func IsNull(col: int): bool
    @en "Text"
    @fa "متن"
    func Text(col: int): str
    @en "Int"
    @fa "عدد صحیح"
    func Int(col: int): int
    @en "Int64"
    @fa "عدد صحیح۶۴"
    func Int64(col: int): i64
    @en "Float"
    @fa "عدد اعشار"
    func Float(col: int): f64
    @en "Close"
    @fa "بستن"
    func Close(): int
end

@en "Tx"
@fa "تراکنش"
pub interface Tx:
    @en "Ok"
    @fa "معتبر"
    func Ok(): bool
    @en "Exec"
    @fa "اجرا"
    func Exec(sql: str): int
    @en "Query"
    @fa "پرسمان"
    func Query(sql: str): dyn Rows
    @en "Commit"
    @fa "ثبت تراکنش"
    func Commit(): int
    @en "Rollback"
    @fa "بازگردانی"
    func Rollback(): int
end

@en "Connection"
@fa "اتصال"
pub interface Connection:
    @en "Kind"
    @fa "نوع"
    func Kind(): str
    @en "Ok"
    @fa "معتبر"
    func Ok(): bool
    @en "Ping"
    @fa "پینگ"
    func Ping(): bool
    @en "Exec"
    @fa "اجرا"
    func Exec(sql: str): int
    @en "Query"
    @fa "پرسمان"
    func Query(sql: str): dyn Rows
    @en "Begin"
    @fa "شروع تراکنش"
    func Begin(): dyn Tx
    @en "LastInsertId"
    @fa "شناسه آخرین درج"
    func LastInsertId(): i64
    @en "Changes"
    @fa "تعداد تغییرات"
    func Changes(): i64
    @en "Error"
    @fa "خطا"
    func Error(): str
    @en "Quote"
    @fa "نقل قول"
    func Quote(s: str): str
    @en "Close"
    @fa "بستن"
    func Close(): int
end

@en "QueryInt"
@fa "پرسمان عدد"
pub func QueryInt(c: dyn Connection, sql: str): int:
    r := c.Query(sql)
    mut out := 0
    if r.Ok():
        if r.Next():
            out = r.Int(0)
        end
        r.Close()
    end
    ret out
end

@en "QueryInt64"
@fa "پرسمان عدد۶۴"
pub func QueryInt64(c: dyn Connection, sql: str): i64:
    r := c.Query(sql)
    mut out := 0 as i64
    if r.Ok():
        if r.Next():
            out = r.Int64(0)
        end
        r.Close()
    end
    ret out
end

@en "QueryFloat"
@fa "پرسمان اعشار"
pub func QueryFloat(c: dyn Connection, sql: str): f64:
    r := c.Query(sql)
    mut out := 0.0
    if r.Ok():
        if r.Next():
            out = r.Float(0)
        end
        r.Close()
    end
    ret out
end

@en "QueryText"
@fa "پرسمان متن"
pub func QueryText(c: dyn Connection, sql: str): str:
    r := c.Query(sql)
    mut out := ""
    if r.Ok():
        if r.Next():
            out = r.Text(0)
        end
        r.Close()
    end
    ret out
end

@en "CountRows"
@fa "شمارش ردیف ها"
pub func CountRows(c: dyn Connection, sql: str): int:
    r := c.Query(sql)
    mut n := 0
    if r.Ok():
        until r.Next():
            n = n + 1
        end
        r.Close()
    end
    ret n
end

@en "Run"
@fa "اجرا کن"
pub func Run(c: dyn Connection, sql: str): bool:
    ret c.Exec(sql) == 0
end

@en "RunAll"
@fa "اجرای همه"
pub func RunAll(c: dyn Connection, stmts: Vector<str>): int:
    mut done := 0
    mut i := 0
    until i < stmts.len():
        if c.Exec(stmts.get(i)) != 0:
            ret done
        end
        done = done + 1
        i = i + 1
    end
    ret done
end

@en "InTx"
@fa "در تراکنش"
pub func InTx(c: dyn Connection, stmts: Vector<str>): bool:
    t := c.Begin()
    if not t.Ok():
        ret false
    end
    mut i := 0
    until i < stmts.len():
        if t.Exec(stmts.get(i)) != 0:
            t.Rollback()
            ret false
        end
        i = i + 1
    end
    ret t.Commit() == 0
end

@en "QuoteLiteral"
@fa "نقل قول"
pub func QuoteLiteral(s: str): str:
    mut out := "'"
    mut i := 0
    until i < len(s):
        ch := s[i]
        if ch == '\'':
            out = out + "''"
        else:
            out = out + ch
        end
        i = i + 1
    end
    ret out + "'"
end
