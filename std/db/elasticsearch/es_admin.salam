package elasticsearch

import str
import encoding.json

@en "AsyncSearch"
@fa "جستجوی ناهمگام"
pub struct AsyncSearch:
    pub ok: bool = false
    pub id: str = ""
    pub running: bool = false
    pub partial: bool = false
    pub result: SearchResult = SearchResult {}
    pub error: str = ""
end

@en "Task"
@fa "کار"
pub struct Task:
    pub ok: bool = false
    pub id: str = ""
    pub completed: bool = false
    pub action: str = ""
    pub response: str = ""
    pub raw: str = ""
end

func _raw_or_empty(r: Response): str:
    if not r.ok: ret str.Clone("") end
    ret r.body
end

func _task_id(r: Response): str:
    if not r.ok: ret str.Clone("") end
    ret json.Get(r.body, "task")
end

func _async_of(r: Response): AsyncSearch:
    if not r.ok: ret AsyncSearch { error = r.error } end
    body := r.body
    mut res := ParseSearchResult(json.Get(body, "response"))
    res.status = r.status
    ret AsyncSearch {
        ok = true,
        id = json.Get(body, "id"),
        running = json.Get(body, "is_running") == "true" or json.Get(body, "state") == "RUNNING",
        partial = json.Get(body, "is_partial") == "true",
        result = res
    }
end

func _async_path(c: Client, id: str): str:
    if _opensearch(c): ret "/_plugins/_asynchronous_search/" + _seg(id) end
    ret "/_async_search/" + _seg(id)
end

func _policy_path(c: Client, name: str): str:
    if _opensearch(c): ret "/_plugins/_ism/policies/" + _seg(name) end
    ret "/_ilm/policy/" + _seg(name)
end

func _wait_false(path: str): str:
    if path.find("?") >= 0: ret path + "&wait_for_completion=false" end
    ret path + "?wait_for_completion=false"
end

@en "PutPipeline"
@fa "تنظیم خط لوله"
pub func PutPipeline(c: Client, id: str, body: str): bool:
    ret Perform(c, "PUT", "/_ingest/pipeline/" + _seg(id), body).ok
end

@en "GetPipeline"
@fa "دریافت خط لوله"
pub func GetPipeline(c: Client, id: str): str:
    ret _raw_or_empty(Perform(c, "GET", "/_ingest/pipeline/" + _seg(id), ""))
end

@en "DeletePipeline"
@fa "حذف خط لوله"
pub func DeletePipeline(c: Client, id: str): bool:
    ret Perform(c, "DELETE", "/_ingest/pipeline/" + _seg(id), "").ok
end

@en "SimulatePipeline"
@fa "شبیه‌سازی خط لوله"
pub func SimulatePipeline(c: Client, id: str, body: str): str:
    mut path := "/_ingest/pipeline/_simulate"
    if id.len() > 0: path = "/_ingest/pipeline/" + _seg(id) + "/_simulate" end
    ret _raw_or_empty(Perform(c, "POST", path, body))
end

