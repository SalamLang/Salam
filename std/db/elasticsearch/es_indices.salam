package elasticsearch

import str
import encoding.json

func _ipath(index: str, op: str): str:
    if op.len() == 0: ret "/" + _idx(index) end
    ret "/" + _idx(index) + "/" + op
end

func _alias_action(kind: str, index: str, alias: str): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("index", index))
    m.push(json.Member("alias", alias))
    ret _one(kind, json.Object(m))
end

@en "CreateIndex"
@fa "ایجاد نمایه"
pub func CreateIndex(c: Client, index: str, body: str): bool:
    ret Perform(c, "PUT", _ipath(index, ""), body).ok
end

@en "DeleteIndex"
@fa "حذف نمایه"
pub func DeleteIndex(c: Client, index: str): bool:
    ret Perform(c, "DELETE", _ipath(index, ""), "").ok
end

@en "IndexExists"
@fa "نمایه موجود است"
pub func IndexExists(c: Client, index: str): bool:
    ret Perform(c, "HEAD", _ipath(index, ""), "").status == 200
end

@en "GetIndex"
@fa "دریافت نمایه"
pub func GetIndex(c: Client, index: str): str:
    r := Perform(c, "GET", _ipath(index, ""), "")
    if not r.ok: ret str.Clone("") end
    ret r.body
end

@en "GetMapping"
@fa "دریافت نگاشت"
pub func GetMapping(c: Client, index: str): str:
    r := Perform(c, "GET", _ipath(index, "_mapping"), "")
    if not r.ok: ret str.Clone("") end
    ret r.body
end

@en "PutMapping"
@fa "تنظیم نگاشت"
pub func PutMapping(c: Client, index: str, body: str): bool:
    ret Perform(c, "PUT", _ipath(index, "_mapping"), body).ok
end

@en "GetSettings"
@fa "دریافت تنظیمات"
pub func GetSettings(c: Client, index: str): str:
    r := Perform(c, "GET", _ipath(index, "_settings"), "")
    if not r.ok: ret str.Clone("") end
    ret r.body
end

@en "PutSettings"
@fa "تنظیم تنظیمات"
pub func PutSettings(c: Client, index: str, body: str): bool:
    ret Perform(c, "PUT", _ipath(index, "_settings"), body).ok
end

@en "Refresh"
@fa "تازه‌سازی"
pub func Refresh(c: Client, index: str): bool:
    if index.len() == 0: ret Perform(c, "POST", "/_refresh", "").ok end
    ret Perform(c, "POST", _ipath(index, "_refresh"), "").ok
end

@en "Flush"
@fa "تخلیه"
pub func Flush(c: Client, index: str): bool:
    if index.len() == 0: ret Perform(c, "POST", "/_flush", "").ok end
    ret Perform(c, "POST", _ipath(index, "_flush"), "").ok
end

@en "ForceMerge"
@fa "ادغام اجباری"
pub func ForceMerge(c: Client, index: str, max_segments: int): bool:
    mut path := _ipath(index, "_forcemerge")
    if max_segments > 0: path = path + "?max_num_segments=" + str.FromInt(max_segments as i64) end
    ret Perform(c, "POST", path, "").ok
end

@en "OpenIndex"
@fa "گشودن نمایه"
pub func OpenIndex(c: Client, index: str): bool:
    ret Perform(c, "POST", _ipath(index, "_open"), "").ok
end

@en "CloseIndex"
@fa "بستن نمایه"
pub func CloseIndex(c: Client, index: str): bool:
    ret Perform(c, "POST", _ipath(index, "_close"), "").ok
end

@en "PutAlias"
@fa "تنظیم نام مستعار"
pub func PutAlias(c: Client, index: str, alias: str): bool:
    ret Perform(c, "PUT", _ipath(index, "_alias/" + _seg(alias)), "").ok
end

@en "DeleteAlias"
@fa "حذف نام مستعار"
pub func DeleteAlias(c: Client, index: str, alias: str): bool:
    ret Perform(c, "DELETE", _ipath(index, "_alias/" + _seg(alias)), "").ok
end

@en "AliasExists"
@fa "نام مستعار موجود است"
pub func AliasExists(c: Client, alias: str): bool:
    ret Perform(c, "HEAD", "/_alias/" + _seg(alias), "").status == 200
end

@en "GetAlias"
@fa "دریافت نام مستعار"
pub func GetAlias(c: Client, alias: str): Vector<str>:
    r := Perform(c, "GET", "/_alias/" + _seg(alias), "")
    if not r.ok: ret Vector {} end
    ret json.Keys(r.body)
end

@en "SwapAlias"
@fa "جابجایی نام مستعار"
pub func SwapAlias(c: Client, alias: str, old_index: str, new_index: str): bool:
    mut actions := Vector {} as Vector<str>
    if old_index.len() > 0: actions.push(_alias_action("remove", old_index, alias)) end
    actions.push(_alias_action("add", new_index, alias))
    ret UpdateAliases(c, json.Array(actions))
end

@en "UpdateAliases"
@fa "به‌روزرسانی نام‌های مستعار"
pub func UpdateAliases(c: Client, actions: str): bool:
    ret Perform(c, "POST", "/_aliases", _one("actions", actions)).ok
end

@en "PutIndexTemplate"
@fa "تنظیم الگوی نمایه"
pub func PutIndexTemplate(c: Client, name: str, body: str): bool:
    ret Perform(c, "PUT", "/_index_template/" + _seg(name), body).ok
end

@en "DeleteIndexTemplate"
@fa "حذف الگوی نمایه"
pub func DeleteIndexTemplate(c: Client, name: str): bool:
    ret Perform(c, "DELETE", "/_index_template/" + _seg(name), "").ok
end

@en "IndexTemplateExists"
@fa "الگوی نمایه موجود است"
pub func IndexTemplateExists(c: Client, name: str): bool:
    ret Perform(c, "HEAD", "/_index_template/" + _seg(name), "").status == 200
end

@en "Reindex"
@fa "نمایه‌سازی دوباره"
pub func Reindex(c: Client, source: str, dest: str): i64:
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("source", _one("index", json.Str(source))))
    m.push(json.MemberRaw("dest", _one("index", json.Str(dest))))
    r := Perform(c, "POST", "/_reindex?refresh=true", json.Object(m))
    if not r.ok: ret -1 end
    ret _i64(json.Get(r.body, "created")) + _i64(json.Get(r.body, "updated"))
end

@en "Analyze"
@fa "تحلیل"
pub func Analyze(c: Client, index: str, analyzer: str, text: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut m := Vector {} as Vector<str>
    if analyzer.len() > 0: m.push(json.Member("analyzer", analyzer)) end
    m.push(json.Member("text", text))
    mut path := "/_analyze"
    if index.len() > 0: path = _ipath(index, "_analyze") end
    r := Perform(c, "POST", path, json.Object(m))
    if not r.ok: ret out end
    each raw in json.Items(json.Get(r.body, "tokens")):
        out.push(json.Get(raw, "token"))
    end
    ret out
end
