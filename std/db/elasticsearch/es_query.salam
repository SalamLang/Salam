@en "AddAgg"
@fa "افزودن تجمیع"
pub func AddAgg(aggs: str, name: str, agg: str): str:
    ret _append_member(aggs, json.MemberRaw(name, agg))
end

@en "SubAggs"
@fa "زیرتجمیع‌ها"
pub func SubAggs(agg: str, aggs: str): str:
    ret _append_member(agg, json.MemberRaw("aggs", aggs))
end

@en "AddMember"
@fa "افزودن عضو"
pub func AddMember(obj: str, key: str, raw: str): str:
    ret _append_member(obj, json.MemberRaw(key, raw))
end

@en "SearchBody"
@fa "بدنه جستجو"
pub func SearchBody(req: SearchRequest): str:
    mut m := Vector {} as Vector<str>
    if req.query.len() > 0: m.push(json.MemberRaw("query", req.query)) end
    if req.from >= 0: m.push(json.MemberInt("from", req.from as i64)) end
    if req.size >= 0: m.push(json.MemberInt("size", req.size as i64)) end
    if req.sort.len() > 0: m.push(json.MemberRaw("sort", json.Array(req.sort))) end
    switch true:
        req.no_source:
            m.push(json.MemberRaw("_source", "false"))
            break
        end
        req.source_excludes.len() > 0:
            mut src := Vector {} as Vector<str>
            if req.source.len() > 0: src.push(json.MemberRaw("includes", _strs(req.source))) end
            src.push(json.MemberRaw("excludes", _strs(req.source_excludes)))
            m.push(json.MemberRaw("_source", json.Object(src)))
            break
        end
        req.source.len() > 0:
            m.push(json.MemberRaw("_source", _strs(req.source)))
        end
    end
    if req.fields.len() > 0: m.push(json.MemberRaw("fields", _strs(req.fields))) end
    if req.aggs.len() > 0: m.push(json.MemberRaw("aggs", req.aggs)) end
    if req.highlight.len() > 0: m.push(json.MemberRaw("highlight", req.highlight)) end
    if req.post_filter.len() > 0: m.push(json.MemberRaw("post_filter", req.post_filter)) end
    if req.knn.len() > 0: m.push(json.MemberRaw("knn", req.knn)) end
    if req.collapse.len() > 0: m.push(json.MemberRaw("collapse", _one("field", json.Str(req.collapse)))) end
    if req.suggest.len() > 0: m.push(json.MemberRaw("suggest", req.suggest)) end
    if req.search_after.len() > 0: m.push(json.MemberRaw("search_after", req.search_after)) end
    if req.pit_id.len() > 0:
        mut pit := Vector {} as Vector<str>
        pit.push(json.Member("id", req.pit_id))
        if req.pit_keep_alive.len() > 0: pit.push(json.Member("keep_alive", req.pit_keep_alive)) end
        m.push(json.MemberRaw("pit", json.Object(pit)))
    end
    if req.track_total_hits.len() > 0: m.push(json.MemberRaw("track_total_hits", req.track_total_hits)) end
    if req.min_score.len() > 0: m.push(json.MemberRaw("min_score", req.min_score)) end
    if req.timeout.len() > 0: m.push(json.Member("timeout", req.timeout)) end
    each x in req.extra:
        m.push(x)
    end
    ret json.Object(m)
end
