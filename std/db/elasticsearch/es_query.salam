package elasticsearch

import str
import conv
import encoding.json

func _wrap(kind: str, body: str): str:
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw(kind, body))
    ret json.Object(m)
end

func _field_obj(kind: str, field: str, raw: str): str:
    mut inner := Vector {} as Vector<str>
    inner.push(json.MemberRaw(field, raw))
    ret _wrap(kind, json.Object(inner))
end

func _one(key: str, raw: str): str:
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw(key, raw))
    ret json.Object(m)
end

func _append_member(obj: str, member: str): str:
    t := str.Trim(obj)
    if t.len() < 2 or not str.StartsWith(t, "{"):
        ret _one_member(member)
    end
    body := str.Trim(t.substr(1, t.len() - 2))
    if body.len() == 0: ret "{" + member + "}" end
    ret "{" + body + ", " + member + "}"
end

func _one_member(member: str): str:
    mut m := Vector {} as Vector<str>
    m.push(member)
    ret json.Object(m)
end

func _bool_part(m &: Vector<str>, key: str, clauses: Vector<str>):
    if clauses.len() == 0: ret end
    m.push(json.MemberRaw(key, json.Array(clauses)))
end

@en "MatchAll"
@fa "تطبیق همه"
pub func MatchAll(): str:
    ret str.Clone(`{"match_all": {}}`)
end

@en "MatchNone"
@fa "تطبیق هیچ"
pub func MatchNone(): str:
    ret str.Clone(`{"match_none": {}}`)
end

@en "Match"
@fa "تطبیق"
pub func Match(field: str, text: str): str:
    ret _field_obj("match", field, json.Str(text))
end

@en "MatchAnd"
@fa "تطبیق همه واژه‌ها"
pub func MatchAnd(field: str, text: str): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("query", text))
    m.push(json.Member("operator", "and"))
    ret _field_obj("match", field, json.Object(m))
end

@en "MatchFuzzy"
@fa "تطبیق تقریبی"
pub func MatchFuzzy(field: str, text: str): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("query", text))
    m.push(json.Member("fuzziness", "AUTO"))
    ret _field_obj("match", field, json.Object(m))
end

@en "MatchPhrase"
@fa "تطبیق عبارت"
pub func MatchPhrase(field: str, text: str): str:
    ret _field_obj("match_phrase", field, json.Str(text))
end

@en "MatchPhrasePrefix"
@fa "تطبیق پیشوند عبارت"
pub func MatchPhrasePrefix(field: str, text: str): str:
    ret _field_obj("match_phrase_prefix", field, json.Str(text))
end

@en "MultiMatch"
@fa "تطبیق چندگانه"
pub func MultiMatch(text: str, fields: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("query", text))
    m.push(json.MemberRaw("fields", _strs(fields)))
    ret _wrap("multi_match", json.Object(m))
end

@en "Term"
@fa "واژه"
pub func Term(field: str, value: str): str:
    ret _field_obj("term", field, json.Str(value))
end

@en "TermInt"
@fa "واژه عددی"
pub func TermInt(field: str, value: i64): str:
    ret _field_obj("term", field, conv.FormatInt(value))
end

@en "TermBool"
@fa "واژه منطقی"
pub func TermBool(field: str, value: bool): str:
    ret _field_obj("term", field, value ? "true" : "false")
end

@en "Terms"
@fa "واژه‌ها"
pub func Terms(field: str, values: Vector<str>): str:
    ret _field_obj("terms", field, _strs(values))
end

@en "Range"
@fa "بازه"
pub func Range(field: str, low: str, high: str): str:
    mut m := Vector {} as Vector<str>
    if low.len() > 0: m.push(json.Member("gte", low)) end
    if high.len() > 0: m.push(json.Member("lte", high)) end
    ret _field_obj("range", field, json.Object(m))
end

@en "RangeExclusive"
@fa "بازه باز"
pub func RangeExclusive(field: str, low: str, high: str): str:
    mut m := Vector {} as Vector<str>
    if low.len() > 0: m.push(json.Member("gt", low)) end
    if high.len() > 0: m.push(json.Member("lt", high)) end
    ret _field_obj("range", field, json.Object(m))
end

