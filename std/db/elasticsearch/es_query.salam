@en "Highlight"
@fa "برجسته‌سازی"
pub func Highlight(fields: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    each f in fields:
        m.push(json.MemberRaw(f, "{}"))
    end
    ret _one("fields", json.Object(m))
end

