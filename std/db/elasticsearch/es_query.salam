@en "Ids"
@fa "شناسه‌ها"
pub func Ids(ids: Vector<str>): str:
    ret _wrap("ids", _one("values", _strs(ids)))
end

@en "QueryString"
@fa "رشته پرسمان"
pub func QueryString(query: str): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("query", query))
    ret _wrap("query_string", json.Object(m))
end

@en "SimpleQueryString"
@fa "رشته پرسمان ساده"
pub func SimpleQueryString(query: str, fields: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("query", query))
    if fields.len() > 0: m.push(json.MemberRaw("fields", _strs(fields))) end
    ret _wrap("simple_query_string", json.Object(m))
end

@en "Bool"
@fa "ترکیب منطقی"
pub func Bool(must: Vector<str>, filter: Vector<str>, should: Vector<str>, must_not: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    _bool_part(m, "must", must)
    _bool_part(m, "filter", filter)
    _bool_part(m, "should", should)
    _bool_part(m, "must_not", must_not)
    if must.len() == 0 and filter.len() == 0 and should.len() > 0:
        m.push(json.MemberInt("minimum_should_match", 1 as i64))
    end
    ret _wrap("bool", json.Object(m))
end

@en "And"
@fa "همه شرط‌ها"
pub func And(clauses: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    _bool_part(m, "must", clauses)
    ret _wrap("bool", json.Object(m))
end

@en "Or"
@fa "یکی از شرط‌ها"
pub func Or(clauses: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    _bool_part(m, "should", clauses)
    m.push(json.MemberInt("minimum_should_match", 1 as i64))
    ret _wrap("bool", json.Object(m))
end

@en "Not"
@fa "نقیض"
pub func Not(clause: str): str:
    mut one := Vector {} as Vector<str>
    one.push(clause)
    mut m := Vector {} as Vector<str>
    _bool_part(m, "must_not", one)
    ret _wrap("bool", json.Object(m))
end

@en "Filtered"
@fa "پالایش شده"
pub func Filtered(query: str, filters: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    if query.len() > 0: m.push(json.MemberRaw("must", query)) end
    _bool_part(m, "filter", filters)
    ret _wrap("bool", json.Object(m))
end

@en "ConstantScore"
@fa "امتیاز ثابت"
pub func ConstantScore(filter: str): str:
    ret _wrap("constant_score", _one("filter", filter))
end

@en "Nested"
@fa "تودرتو"
pub func Nested(path: str, query: str): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("path", path))
    m.push(json.MemberRaw("query", query))
    ret _wrap("nested", json.Object(m))
end

@en "GeoDistance"
@fa "فاصله جغرافیایی"
pub func GeoDistance(field: str, lat: f64, lon: f64, distance: str): str:
    mut pt := Vector {} as Vector<str>
    pt.push(json.MemberFloat("lat", lat))
    pt.push(json.MemberFloat("lon", lon))
    mut m := Vector {} as Vector<str>
    m.push(json.Member("distance", distance))
    m.push(json.MemberRaw(field, json.Object(pt)))
    ret _wrap("geo_distance", json.Object(m))
end

@en "Knn"
@fa "نزدیک‌ترین همسایه‌ها"
pub func Knn(field: str, vector: Vector<f64>, k: int, num_candidates: int): str:
    mut nums := Vector {} as Vector<str>
    each x in vector:
        nums.push(conv.FormatFloat(x))
    end
    mut m := Vector {} as Vector<str>
    m.push(json.Member("field", field))
    m.push(json.MemberRaw("query_vector", json.Array(nums)))
    m.push(json.MemberInt("k", k as i64))
    m.push(json.MemberInt("num_candidates", num_candidates as i64))
    ret json.Object(m)
end

@en "SortAsc"
@fa "مرتب صعودی"
pub func SortAsc(field: str): str:
    ret _one(field, _one("order", json.Str("asc")))
end

@en "SortDesc"
@fa "مرتب نزولی"
pub func SortDesc(field: str): str:
