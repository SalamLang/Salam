package meilisearch

@en "Version"
@fa "نسخه"
pub struct Version:
    pub pkg_version: str = ""
    pub commit_sha: str = ""
    pub commit_date: str = ""
end

@en "Stats"
@fa "آمار"
pub struct Stats:
    pub database_size: i64 = 0
    pub used_database_size: i64 = 0
    pub last_update: str = ""
    pub indexes: str = ""
end

@en "Health"
@fa "سلامت"
pub func Health(c: Client, err &: Error): str:
    ret _get_str(_call(c, "GET", "/health", "", err), "status")
end

@en "IsHealthy"
@fa "سالم است"
pub func IsHealthy(c: Client): bool:
    mut err := Error {}
    ret Health(c, err) == "available"
end

@en "GetVersion"
@fa "دریافت نسخه"
pub func GetVersion(c: Client, err &: Error): Version:
    body := _call(c, "GET", "/version", "", err)
    ret Version {
        pkg_version = _get_str(body, "pkgVersion"), commit_sha = _get_str(body, "commitSha"),
        commit_date = _get_str(body, "commitDate")
    }
end

@en "GetStats"
@fa "دریافت آمار"
pub func GetStats(c: Client, err &: Error): Stats:
    body := _call(c, "GET", "/stats", "", err)
    ret Stats {
        database_size = _get_i64(body, "databaseSize", 0 as i64), used_database_size = _get_i64(body, "usedDatabaseSize", 0 as i64),
        last_update = _get_str(body, "lastUpdate"), indexes = _get_raw(body, "indexes")
    }
end

@en "CreateDump"
@fa "ایجاد دامپ"
pub func CreateDump(c: Client, err &: Error): TaskInfo:
    ret _task_info(_call(c, "POST", "/dumps", "", err))
end

@en "CreateSnapshot"
@fa "ایجاد اسنپ‌شات"
pub func CreateSnapshot(c: Client, err &: Error): TaskInfo:
    ret _task_info(_call(c, "POST", "/snapshots", "", err))
end

@en "GetExperimentalFeatures"
@fa "دریافت ویژگی‌های آزمایشی"
pub func GetExperimentalFeatures(c: Client, err &: Error): str:
    ret _call(c, "GET", "/experimental-features", "", err)
end

@en "UpdateExperimentalFeatures"
@fa "به‌روزرسانی ویژگی‌های آزمایشی"
pub func UpdateExperimentalFeatures(c: Client, features: str, err &: Error): str:
    ret _call(c, "PATCH", "/experimental-features", features, err)
end

@en "GetNetwork"
@fa "دریافت شبکه"
pub func GetNetwork(c: Client, err &: Error): str:
    ret _call(c, "GET", "/network", "", err)
end

@en "UpdateNetwork"
@fa "به‌روزرسانی شبکه"
pub func UpdateNetwork(c: Client, network: str, err &: Error): str:
    ret _call(c, "PATCH", "/network", network, err)
end

@en "Export"
@fa "صدور"
pub func Export(c: Client, request: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, "POST", "/export", request, err))
end

@en "GetMetrics"
@fa "دریافت معیارها"
pub func GetMetrics(c: Client, err &: Error): str:
    ret _send(c, "GET", "/metrics", "", "", err)
end

@en "SetStderrLogs"
@fa "تنظیم گزارش خطای استاندارد"
pub func SetStderrLogs(c: Client, target: str, err &: Error): bool:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("target", target))
    _call(c, "POST", "/logs/stderr", json.Object(m), err)
    ret Ok(err)
end

@en "NetworkControl"
@fa "کنترل شبکه"
pub func NetworkControl(c: Client, change: str, err &: Error): str:
    ret _call(c, "POST", "/network/control", change, err)
end

@en "RenderTemplate"
@fa "اجرای قالب"
pub func RenderTemplate(c: Client, query: str, err &: Error): str:
    ret _call(c, "POST", "/render-template", query, err)
end
