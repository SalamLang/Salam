package meilisearch

@en "ChatWorkspacePage"
@fa "صفحه فضای گفتگو"
pub struct ChatWorkspacePage:
    @en "results"
    @fa "نتیجه‌ها"
    pub results: Vector<str> = Vector {} as Vector<str>
    @en "offset"
    @fa "جابجایی"
    pub offset: i64 = 0
    @en "limit"
    @fa "حد"
    pub limit: i64 = 0
    @en "total"
    @fa "کل"
    pub total: i64 = 0
end

func _chat_path(workspace: str): str:
    ret "/chats/" + _esc(workspace)
end

@en "ListChatWorkspaces"
@fa "فهرست فضاهای گفتگو"
pub func ListChatWorkspaces(c: Client, offset: int, limit: int, err &: Error): ChatWorkspacePage:
    body := _call(c, "GET", "/chats" + _paging(offset, limit), "", err)
    mut out := ChatWorkspacePage {
        offset = _get_i64(body, "offset", 0 as i64), limit = _get_i64(body, "limit", 0 as i64),
        total = _get_i64(body, "total", 0 as i64)
    }
    each item in _elements(_get_raw(body, "results")):
        out.results.push(_get_str(item, "uid"))
    end
    ret out
end

@en "GetChatWorkspace"
@fa "دریافت فضای گفتگو"
pub func GetChatWorkspace(c: Client, workspace: str, err &: Error): str:
    ret _call(c, "GET", _chat_path(workspace), "", err)
end

@en "DeleteChatWorkspace"
@fa "حذف فضای گفتگو"
pub func DeleteChatWorkspace(c: Client, workspace: str, err &: Error): bool:
    _call(c, "DELETE", _chat_path(workspace), "", err)
    ret Ok(err)
end

@en "GetChatSettings"
@fa "دریافت تنظیمات گفتگو"
pub func GetChatSettings(c: Client, workspace: str, err &: Error): str:
    ret _call(c, "GET", _chat_path(workspace) + "/settings", "", err)
end

@en "UpdateChatSettings"
@fa "به‌روزرسانی تنظیمات گفتگو"
pub func UpdateChatSettings(c: Client, workspace: str, settings: str, err &: Error): str:
    ret _call(c, "PATCH", _chat_path(workspace) + "/settings", settings, err)
end

@en "ResetChatSettings"
@fa "بازنشانی تنظیمات گفتگو"
pub func ResetChatSettings(c: Client, workspace: str, err &: Error): str:
    ret _call(c, "DELETE", _chat_path(workspace) + "/settings", "", err)
end

@en "ChatCompletion"
@fa "تکمیل گفتگو"
pub func ChatCompletion(c: Client, workspace: str, request: str, err &: Error): str:
    ret _call(c, "POST", _chat_path(workspace) + "/chat/completions", request, err)
end
