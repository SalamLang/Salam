package meilisearch

@en "SearchRule"
@fa "قاعده جستجو"
pub struct SearchRule:
    pub uid: str = ""
    pub last_updated_at: str = ""
    pub precedence: i64 = -1
    pub active: bool = false
    pub conditions: str = ""
    pub actions: str = ""
    pub raw: str = ""
end

@en "SearchRuleQuery"
@fa "پرسش قاعده جستجو"
pub struct SearchRuleQuery:
    pub offset: int = -1
    pub limit: int = -1
    pub query: str = ""
    pub active: int = -1
end

@en "SearchRulePage"
@fa "صفحه قاعده جستجو"
pub struct SearchRulePage:
    pub results: Vector<SearchRule> = Vector {} as Vector<SearchRule>
    pub offset: i64 = 0
    pub limit: i64 = 0
    pub total: i64 = 0
end

func _search_rule(body: str): SearchRule:
    ret SearchRule {
        uid = _get_str(body, "uid"), last_updated_at = _get_str(body, "lastUpdatedAt"), precedence = _get_i64(body, "precedence", -1 as i64),
        active = _get_bool(body, "active"), conditions = _get_raw(body, "conditions"), actions = _get_raw(body, "actions"),
        raw = body
    }
end

@en "ListSearchRules"
@fa "فهرست قاعده‌های جستجو"
pub func ListSearchRules(c: Client, q: SearchRuleQuery, err &: Error): SearchRulePage:
    mut m := Vector {} as Vector<str>
    _int_member(m, "offset", q.offset)
    _int_member(m, "limit", q.limit)
    mut f := Vector {} as Vector<str>
    _str_member(f, "query", q.query)
    if q.active >= 0: f.push(json.MemberBool("active", q.active > 0)) end
    if f.len() > 0: m.push(json.MemberRaw("filter", json.Object(f))) end
    body := _call(c, "POST", "/dynamic-search-rules", json.Object(m), err)
    mut out := SearchRulePage {
        offset = _get_i64(body, "offset", 0 as i64), limit = _get_i64(body, "limit", 0 as i64),
        total = _get_i64(body, "total", 0 as i64)
    }
    each item in _elements(_get_raw(body, "results")):
        out.results.push(_search_rule(item))
    end
    ret out
end

@en "GetSearchRule"
@fa "دریافت قاعده جستجو"
pub func GetSearchRule(c: Client, uid: str, err &: Error): SearchRule:
    body := _call(c, "GET", "/dynamic-search-rules/" + _esc(uid), "", err)
    if not Ok(err): ret SearchRule {} end
    ret _search_rule(body)
end

@en "UpdateSearchRule"
@fa "به‌روزرسانی قاعده جستجو"
pub func UpdateSearchRule(c: Client, uid: str, rule: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, "PATCH", "/dynamic-search-rules/" + _esc(uid), rule, err))
end

@en "DeleteSearchRule"
@fa "حذف قاعده جستجو"
pub func DeleteSearchRule(c: Client, uid: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, "DELETE", "/dynamic-search-rules/" + _esc(uid), "", err))
end

@en "DeleteAllSearchRules"
@fa "حذف همه قاعده‌های جستجو"
pub func DeleteAllSearchRules(c: Client, err &: Error): TaskInfo:
    ret _task_info(_call(c, "DELETE", "/dynamic-search-rules", "", err))
end
