package meilisearch

@en "MATCH_LAST"
@fa "تطبیق آخر"
pub const MATCH_LAST := "last"

@en "MATCH_ALL"
@fa "تطبیق همه"
pub const MATCH_ALL := "all"

@en "MATCH_FREQUENCY"
@fa "تطبیق فراوانی"
pub const MATCH_FREQUENCY := "frequency"

@en "SearchRequest"
@fa "درخواست جستجو"
pub struct SearchRequest:
    pub query: str = ""
    pub offset: int = -1
    pub limit: int = -1
    pub page: int = -1
    pub hits_per_page: int = -1
    pub filter: str = ""
    pub facets: Vector<str> = Vector {} as Vector<str>
    pub attributes_to_retrieve: Vector<str> = Vector {} as Vector<str>
    pub attributes_to_crop: Vector<str> = Vector {} as Vector<str>
    pub crop_length: int = -1
    pub crop_marker: str = ""
    pub attributes_to_highlight: Vector<str> = Vector {} as Vector<str>
    pub highlight_pre_tag: str = ""
    pub highlight_post_tag: str = ""
    pub show_matches_position: bool = false
    pub sort: Vector<str> = Vector {} as Vector<str>
    pub matching_strategy: str = ""
    pub show_ranking_score: bool = false
    pub show_ranking_score_details: bool = false
    pub ranking_score_threshold: f64 = -1.0
    pub attributes_to_search_on: Vector<str> = Vector {} as Vector<str>
    pub distinct: str = ""
    pub locales: Vector<str> = Vector {} as Vector<str>
    pub vector: Vector<f64> = Vector {} as Vector<f64>
    pub hybrid_embedder: str = ""
    pub hybrid_semantic_ratio: f64 = -1.0
    pub retrieve_vectors: bool = false
    pub media: str = ""
    pub show_performance_details: bool = false
    pub use_network: bool = false
    pub personalize: str = ""
    pub inline_rule: str = ""
    pub extra: str = ""
end

@en "SearchResult"
@fa "نتیجه جستجو"
pub struct SearchResult:
    pub index_uid: str = ""
    pub hits: Vector<str> = Vector {} as Vector<str>
    pub query: str = ""
    pub processing_time_ms: i64 = 0
    pub offset: i64 = -1
    pub limit: i64 = -1
    pub estimated_total_hits: i64 = -1
    pub page: i64 = -1
    pub hits_per_page: i64 = -1
    pub total_hits: i64 = -1
    pub total_pages: i64 = -1
    pub facet_distribution: str = ""
    pub facet_stats: str = ""
    pub semantic_hit_count: i64 = -1
    pub performance_details: str = ""
    pub query_vector: str = ""
    pub remote_errors: str = ""
    pub request_uid: str = ""
    pub metadata: str = ""
    pub facets_by_index: str = ""
    pub raw: str = ""
end

@en "MultiQuery"
@fa "پرسش چندگانه"
pub struct MultiQuery:
    pub index_uid: str = ""
    pub request: SearchRequest = SearchRequest {}
    pub weight: f64 = -1.0
    pub remote: str = ""
    pub query_position: int = -1
end

@en "Federation"
@fa "فدراسیون"
pub struct Federation:
    pub offset: int = -1
    pub limit: int = -1
    pub page: int = -1
    pub hits_per_page: int = -1
    pub facets_by_index: str = ""
    pub merge_facets: str = ""
    pub distinct: str = ""
    pub personalize: str = ""
    pub show_performance_details: bool = false
end

@en "FacetSearchRequest"
@fa "درخواست جستجوی وجه"
pub struct FacetSearchRequest:
    pub facet_name: str = ""
    pub facet_query: str = ""
    pub query: str = ""
    pub filter: str = ""
    pub matching_strategy: str = ""
    pub attributes_to_search_on: Vector<str> = Vector {} as Vector<str>
    pub exhaustive_facet_count: bool = false
    pub ranking_score_threshold: f64 = -1.0
    pub locales: Vector<str> = Vector {} as Vector<str>
    pub vector: Vector<f64> = Vector {} as Vector<f64>
    pub hybrid_embedder: str = ""
    pub hybrid_semantic_ratio: f64 = -1.0
    pub media: str = ""
    pub use_network: bool = false
end

@en "FacetHit"
@fa "نتیجه وجه"
pub struct FacetHit:
    pub value: str = ""
    pub count: i64 = 0
end

@en "FacetSearchResult"
@fa "نتیجه جستجوی وجه"
pub struct FacetSearchResult:
    pub hits: Vector<FacetHit> = Vector {} as Vector<FacetHit>
    pub facet_query: str = ""
    pub processing_time_ms: i64 = 0
    pub remote_errors: str = ""
end

@en "SimilarRequest"
@fa "درخواست مشابه"
pub struct SimilarRequest:
    pub id: str = ""
    pub embedder: str = ""
    pub offset: int = -1
    pub limit: int = -1
    pub filter: str = ""
    pub attributes_to_retrieve: Vector<str> = Vector {} as Vector<str>
    pub show_ranking_score: bool = false
    pub show_ranking_score_details: bool = false
    pub ranking_score_threshold: f64 = -1.0
    pub retrieve_vectors: bool = false
    pub show_performance_details: bool = false
end

func _floats_json(items: Vector<f64>): str:
    mut parts := Vector {} as Vector<str>
    each f in items:
        parts.push(conv.FormatFloatShort(f))
    end
    ret json.Array(parts)
end

func _int_member(m &: Vector<str>, key: str, v: int):
    if v >= 0: m.push(json.MemberInt(key, v as i64)) end
end

func _list_member(m &: Vector<str>, key: str, v: Vector<str>):
    if v.len() > 0: m.push(json.MemberRaw(key, _strs_json(v))) end
end

func _str_member(m &: Vector<str>, key: str, v: str):
    if v.len() > 0: m.push(json.Member(key, v)) end
end

func _extra_members(m &: Vector<str>, extra: str):
    t := str.TrimRight(extra)
    if t.len() < 2 or t.substr(0, 1) != "{": ret end
    inner := str.TrimRight(t.substr(1, t.len() - 2))
    if inner.len() > 0: m.push(inner) end
end

func _hybrid_member(m &: Vector<str>, embedder: str, ratio: f64):
    if embedder.len() == 0: ret end
    mut h := Vector {} as Vector<str>
    h.push(json.Member("embedder", embedder))
    if ratio >= 0.0:
        h.push(json.MemberRaw("semanticRatio", conv.FormatFloatShort(ratio)))
    end
    m.push(json.MemberRaw("hybrid", json.Object(h)))
end

func _score_member(m &: Vector<str>, threshold: f64):
    if threshold >= 0.0:
        m.push(json.MemberRaw("rankingScoreThreshold", conv.FormatFloatShort(threshold)))
    end
end

func _flag_member(m &: Vector<str>, key: str, enabled: bool):
    if enabled: m.push(json.MemberBool(key, true)) end
end

func _raw_member(m &: Vector<str>, key: str, raw: str):
    if raw.len() > 0: m.push(json.MemberRaw(key, raw)) end
end

func _search_members(r: SearchRequest): Vector<str>:
    mut m := Vector {} as Vector<str>
    _str_member(m, "q", r.query)
    _int_member(m, "offset", r.offset)
    _int_member(m, "limit", r.limit)
    _int_member(m, "page", r.page)
    _int_member(m, "hitsPerPage", r.hits_per_page)
    if r.filter.len() > 0: m.push(json.MemberRaw("filter", _filter_json(r.filter))) end
    _list_member(m, "facets", r.facets)
    _list_member(m, "attributesToRetrieve", r.attributes_to_retrieve)
    _list_member(m, "attributesToCrop", r.attributes_to_crop)
    _int_member(m, "cropLength", r.crop_length)
    _str_member(m, "cropMarker", r.crop_marker)
    _list_member(m, "attributesToHighlight", r.attributes_to_highlight)
    _str_member(m, "highlightPreTag", r.highlight_pre_tag)
    _str_member(m, "highlightPostTag", r.highlight_post_tag)
    if r.show_matches_position: m.push(json.MemberBool("showMatchesPosition", true)) end
    _list_member(m, "sort", r.sort)
    _str_member(m, "matchingStrategy", r.matching_strategy)
    if r.show_ranking_score: m.push(json.MemberBool("showRankingScore", true)) end
    if r.show_ranking_score_details: m.push(json.MemberBool("showRankingScoreDetails", true)) end
    _score_member(m, r.ranking_score_threshold)
    _list_member(m, "attributesToSearchOn", r.attributes_to_search_on)
    _str_member(m, "distinct", r.distinct)
    _list_member(m, "locales", r.locales)
    if r.vector.len() > 0: m.push(json.MemberRaw("vector", _floats_json(r.vector))) end
    _hybrid_member(m, r.hybrid_embedder, r.hybrid_semantic_ratio)
    _flag_member(m, "retrieveVectors", r.retrieve_vectors)
    _raw_member(m, "media", r.media)
    _flag_member(m, "showPerformanceDetails", r.show_performance_details)
    _flag_member(m, "useNetwork", r.use_network)
    _raw_member(m, "personalize", r.personalize)
    _raw_member(m, "inlineRule", r.inline_rule)
    _extra_members(m, r.extra)
    ret m
end

func _search_result(body: str): SearchResult:
    ret SearchResult {
        index_uid = _get_str(body, "indexUid"), hits = _elements(_get_raw(body, "hits")), query = _get_str(body, "query"),
        processing_time_ms = _get_i64(body, "processingTimeMs", 0 as i64), offset = _get_i64(body, "offset", -1 as i64),
        limit = _get_i64(body, "limit", -1 as i64), estimated_total_hits = _get_i64(body, "estimatedTotalHits", -1 as i64),
        page = _get_i64(body, "page", -1 as i64), hits_per_page = _get_i64(body, "hitsPerPage", -1 as i64),
        total_hits = _get_i64(body, "totalHits", -1 as i64), total_pages = _get_i64(body, "totalPages", -1 as i64),
        facet_distribution = _get_raw(body, "facetDistribution"), facet_stats = _get_raw(body, "facetStats"),
        semantic_hit_count = _get_i64(body, "semanticHitCount", -1 as i64), performance_details = _get_raw(body, "performanceDetails"),
        query_vector = _get_raw(body, "queryVector"), remote_errors = _get_raw(body, "remoteErrors"),
        request_uid = _get_str(body, "requestUid"), metadata = _get_raw(body, "metadata"),
        facets_by_index = _get_raw(body, "facetsByIndex"), raw = body
    }
end

func _multi_members(q: MultiQuery): Vector<str>:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("indexUid", q.index_uid))
    each item in _search_members(q.request):
        m.push(item)
    end
    if q.weight >= 0.0 or q.remote.len() > 0 or q.query_position >= 0:
        mut f := Vector {} as Vector<str>
        if q.weight >= 0.0:
            f.push(json.MemberRaw("weight", conv.FormatFloatShort(q.weight)))
        end
        _str_member(f, "remote", q.remote)
        _int_member(f, "queryPosition", q.query_position)
        m.push(json.MemberRaw("federationOptions", json.Object(f)))
    end
    ret m
end

func _multi_body(queries: Vector<MultiQuery>, federation: str): str:
    mut items := Vector {} as Vector<str>
    each q in queries:
        items.push(json.Object(_multi_members(q)))
    end
    mut m := Vector {} as Vector<str>
    if federation.len() > 0:
        m.push(json.MemberRaw("federation", federation))
    end
    m.push(json.MemberRaw("queries", json.Array(items)))
    ret json.Object(m)
end

@en "Search"
@fa "جستجو"
pub func Search(c: Client, uid: str, r: SearchRequest, err &: Error): SearchResult:
    body := _call(c, "POST", _ipath(uid) + "/search", json.Object(_search_members(r)), err)
    if not Ok(err): ret SearchResult {} end
    ret _search_result(body)
end

@en "Query"
@fa "پرسش"
pub func Query(c: Client, uid: str, q: str, err &: Error): SearchResult:
    ret Search(c, uid, SearchRequest { query = q }, err)
end

@en "HitsAs"
@fa "نتایج به نوع"
pub func HitsAs<T>(r: SearchResult, out &: Vector<T>, err &: Error): bool:
    each item in r.hits:
        mut v := T {}
        mut e := encerr.EncodingError {}
        if not json.UnmarshalLenient(item, v, e):
            _decode_error(e, err)
            ret false
        end
        out.push(v)
    end
    ret true
end

@en "MultiSearch"
@fa "جستجوی چندگانه"
pub func MultiSearch(c: Client, queries: Vector<MultiQuery>, err &: Error): Vector<SearchResult>:
    mut out := Vector {} as Vector<SearchResult>
    body := _call(c, "POST", "/multi-search", _multi_body(queries, ""), err)
    if not Ok(err): ret out end
    each item in _elements(_get_raw(body, "results")):
        out.push(_search_result(item))
    end
    ret out
end

@en "FederatedSearch"
@fa "جستجوی فدرال"
pub func FederatedSearch(c: Client, queries: Vector<MultiQuery>, f: Federation, err &: Error): SearchResult:
    mut m := Vector {} as Vector<str>
    _int_member(m, "offset", f.offset)
    _int_member(m, "limit", f.limit)
    _int_member(m, "page", f.page)
    _int_member(m, "hitsPerPage", f.hits_per_page)
    if f.facets_by_index.len() > 0: m.push(json.MemberRaw("facetsByIndex", f.facets_by_index)) end
    if f.merge_facets.len() > 0: m.push(json.MemberRaw("mergeFacets", f.merge_facets)) end
    _str_member(m, "distinct", f.distinct)
    _raw_member(m, "personalize", f.personalize)
    _flag_member(m, "showPerformanceDetails", f.show_performance_details)
    body := _call(c, "POST", "/multi-search", _multi_body(queries, json.Object(m)), err)
    if not Ok(err): ret SearchResult {} end
    ret _search_result(body)
end

@en "FacetSearch"
@fa "جستجوی وجه"
pub func FacetSearch(c: Client, uid: str, r: FacetSearchRequest, err &: Error): FacetSearchResult:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("facetName", r.facet_name))
    _str_member(m, "facetQuery", r.facet_query)
    _str_member(m, "q", r.query)
    if r.filter.len() > 0: m.push(json.MemberRaw("filter", _filter_json(r.filter))) end
    _str_member(m, "matchingStrategy", r.matching_strategy)
    _list_member(m, "attributesToSearchOn", r.attributes_to_search_on)
    if r.exhaustive_facet_count: m.push(json.MemberBool("exhaustiveFacetCount", true)) end
    _score_member(m, r.ranking_score_threshold)
    _list_member(m, "locales", r.locales)
    if r.vector.len() > 0: m.push(json.MemberRaw("vector", _floats_json(r.vector))) end
    _hybrid_member(m, r.hybrid_embedder, r.hybrid_semantic_ratio)
    _raw_member(m, "media", r.media)
    _flag_member(m, "useNetwork", r.use_network)
    body := _call(c, "POST", _ipath(uid) + "/facet-search", json.Object(m), err)
    mut out := FacetSearchResult {
        facet_query = _get_str(body, "facetQuery"), processing_time_ms = _get_i64(body, "processingTimeMs", 0 as i64),
        remote_errors = _get_raw(body, "remoteErrors")
    }
    each item in _elements(_get_raw(body, "facetHits")):
        out.hits.push(FacetHit { value = _get_str(item, "value"), count = _get_i64(item, "count", 0 as i64) })
    end
    ret out
end

@en "SimilarDocuments"
@fa "سندهای مشابه"
pub func SimilarDocuments(c: Client, uid: str, r: SimilarRequest, err &: Error): SearchResult:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("id", r.id))
    m.push(json.Member("embedder", r.embedder))
    _int_member(m, "offset", r.offset)
    _int_member(m, "limit", r.limit)
    if r.filter.len() > 0: m.push(json.MemberRaw("filter", _filter_json(r.filter))) end
    _list_member(m, "attributesToRetrieve", r.attributes_to_retrieve)
    if r.show_ranking_score: m.push(json.MemberBool("showRankingScore", true)) end
    if r.show_ranking_score_details: m.push(json.MemberBool("showRankingScoreDetails", true)) end
    if r.ranking_score_threshold >= 0.0:
        m.push(json.MemberRaw("rankingScoreThreshold", conv.FormatFloatShort(r.ranking_score_threshold)))
    end
    if r.retrieve_vectors: m.push(json.MemberBool("retrieveVectors", true)) end
    _flag_member(m, "showPerformanceDetails", r.show_performance_details)
    body := _call(c, "POST", _ipath(uid) + "/similar", json.Object(m), err)
    if not Ok(err): ret SearchResult {} end
    ret _search_result(body)
end
