@en "GetSearchCutoffMs"
@fa "دریافت_مهلت_جستجو"
pub func GetSearchCutoffMs(c: Client, uid: str, err &: Error): i64:
    v := GetSetting(c, uid, "search-cutoff-ms", err)
    if v.len() == 0 or v == "null": ret -1 end
    ret _i64(v)
end

@en "UpdateSearchCutoffMs"
@fa "به_روزرسانی_مهلت_جستجو"
pub func UpdateSearchCutoffMs(c: Client, uid: str, value: i64, err &: Error): TaskInfo:
    ret UpdateSetting(c, uid, "search-cutoff-ms", conv.FormatInt(value), err)
end

@en "ResetSearchCutoffMs"
@fa "بازنشانی_مهلت_جستجو"
pub func ResetSearchCutoffMs(c: Client, uid: str, err &: Error): TaskInfo:
    ret ResetSetting(c, uid, "search-cutoff-ms", err)
end

