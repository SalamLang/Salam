package meilisearch

func _setting_path(uid: str, name: str): str:
    ret _ipath(uid) + "/settings/" + name
end

func _setting_method(name: str): str:
    if name == "typo-tolerance" or name == "pagination" or name == "faceting" or name == "embedders" or name == "chat":
        ret "PATCH"
    end
    ret "PUT"
end

func _get_list(c: Client, uid: str, name: str, err &: Error): Vector<str>:
    ret _strings(_call(c, "GET", _setting_path(uid, name), "", err))
end

func _put_list(c: Client, uid: str, name: str, items: Vector<str>, err &: Error): TaskInfo:
    ret UpdateSetting(c, uid, name, _strs_json(items), err)
end

@en "GetSettings"
@fa "دریافت_تنظیمات"
pub func GetSettings(c: Client, uid: str, err &: Error): str:
    ret _call(c, "GET", _ipath(uid) + "/settings", "", err)
end

@en "UpdateSettings"
@fa "به_روزرسانی_تنظیمات"
pub func UpdateSettings(c: Client, uid: str, settings: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, "PATCH", _ipath(uid) + "/settings", settings, err))
end

@en "ResetSettings"
@fa "بازنشانی_تنظیمات"
pub func ResetSettings(c: Client, uid: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, "DELETE", _ipath(uid) + "/settings", "", err))
end

@en "GetSetting"
@fa "دریافت_تنظیم"
pub func GetSetting(c: Client, uid: str, name: str, err &: Error): str:
    ret _call(c, "GET", _setting_path(uid, name), "", err)
end

@en "UpdateSetting"
@fa "به_روزرسانی_تنظیم"
pub func UpdateSetting(c: Client, uid: str, name: str, value: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, _setting_method(name), _setting_path(uid, name), value, err))
end

@en "ResetSetting"
@fa "بازنشانی_تنظیم"
pub func ResetSetting(c: Client, uid: str, name: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, "DELETE", _setting_path(uid, name), "", err))
end

@en "GetRankingRules"
@fa "دریافت_قواعد_رتبه_بندی"
pub func GetRankingRules(c: Client, uid: str, err &: Error): Vector<str>:
    ret _get_list(c, uid, "ranking-rules", err)
end

@en "UpdateRankingRules"
@fa "به_روزرسانی_قواعد_رتبه_بندی"
pub func UpdateRankingRules(c: Client, uid: str, items: Vector<str>, err &: Error): TaskInfo:
    ret _put_list(c, uid, "ranking-rules", items, err)
end

@en "ResetRankingRules"
@fa "بازنشانی_قواعد_رتبه_بندی"
pub func ResetRankingRules(c: Client, uid: str, err &: Error): TaskInfo:
    ret ResetSetting(c, uid, "ranking-rules", err)
end

