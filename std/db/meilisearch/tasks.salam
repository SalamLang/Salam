package meilisearch

@en "STATUS_ENQUEUED"
@fa "وضعیت در صف"
pub const STATUS_ENQUEUED := "enqueued"

@en "STATUS_PROCESSING"
@fa "وضعیت در حال پردازش"
pub const STATUS_PROCESSING := "processing"

@en "STATUS_SUCCEEDED"
@fa "وضعیت موفق"
pub const STATUS_SUCCEEDED := "succeeded"

@en "STATUS_FAILED"
@fa "وضعیت ناموفق"
pub const STATUS_FAILED := "failed"

@en "STATUS_CANCELED"
@fa "وضعیت لغو شده"
pub const STATUS_CANCELED := "canceled"

@en "TaskInfo"
@fa "اطلاعات کار"
pub struct TaskInfo:
    pub task_uid: i64 = -1
    pub index_uid: str = ""
    pub status: str = ""
    pub kind: str = ""
    pub enqueued_at: str = ""
    pub custom_metadata: str = ""
end

@en "Task"
@fa "کار"
pub struct Task:
    pub uid: i64 = -1
    pub batch_uid: i64 = -1
    pub index_uid: str = ""
    pub status: str = ""
    pub kind: str = ""
    pub canceled_by: i64 = -1
    pub details: str = ""
    pub error: Error = Error {}
    pub duration: str = ""
    pub enqueued_at: str = ""
    pub started_at: str = ""
    pub finished_at: str = ""
    pub custom_metadata: str = ""
    pub network: str = ""
end

@en "TaskQuery"
@fa "پرسش کار"
pub struct TaskQuery:
    pub uids: Vector<i64> = Vector {} as Vector<i64>
    pub batch_uids: Vector<i64> = Vector {} as Vector<i64>
    pub canceled_by: Vector<i64> = Vector {} as Vector<i64>
    pub statuses: Vector<str> = Vector {} as Vector<str>
    pub types: Vector<str> = Vector {} as Vector<str>
    pub index_uids: Vector<str> = Vector {} as Vector<str>
    pub limit: int = 0
    pub from: i64 = -1
    pub reverse: bool = false
    pub before_enqueued_at: str = ""
    pub after_enqueued_at: str = ""
    pub before_started_at: str = ""
    pub after_started_at: str = ""
    pub before_finished_at: str = ""
    pub after_finished_at: str = ""
end

@en "TaskCompaction"
@fa "فشرده‌سازی کارها"
pub struct TaskCompaction:
    pub status: str = ""
    pub pre_size: str = ""
    pub post_size: str = ""
    pub action_required: str = ""
    pub error_message: str = ""
end

@en "TaskPage"
@fa "صفحه کار"
pub struct TaskPage:
    pub results: Vector<Task> = Vector {} as Vector<Task>
    pub limit: i64 = 0
    pub from: i64 = -1
    pub next: i64 = -1
    pub total: i64 = 0
end

@en "Batch"
@fa "دسته"
pub struct Batch:
    pub uid: i64 = -1
    pub details: str = ""
    pub stats: str = ""
    pub progress: str = ""
    pub batch_strategy: str = ""
    pub duration: str = ""
    pub started_at: str = ""
    pub finished_at: str = ""
end

@en "BatchPage"
@fa "صفحه دسته"
pub struct BatchPage:
    pub results: Vector<Batch> = Vector {} as Vector<Batch>
    pub limit: i64 = 0
    pub from: i64 = -1
    pub next: i64 = -1
    pub total: i64 = 0
end

func _task_info(body: str): TaskInfo:
    if body.len() == 0: ret TaskInfo {} end
    ret TaskInfo {
        task_uid = _get_i64(body, "taskUid", -1 as i64), index_uid = _get_str(body, "indexUid"),
        status = _get_str(body, "status"), kind = _get_str(body, "type"), enqueued_at = _get_str(body, "enqueuedAt"),
        custom_metadata = _get_str(body, "customMetadata")
    }
end

func _task_error(raw: str): Error:
    if raw.len() == 0: ret Error {} end
    ret Error {
        code = _get_str(raw, "code"), kind = _get_str(raw, "type"), message = _get_str(raw, "message"),
        link = _get_str(raw, "link")
    }
end

func _task(body: str): Task:
    if body.len() == 0: ret Task {} end
    ret Task {
        uid = _get_i64(body, "uid", -1 as i64), batch_uid = _get_i64(body, "batchUid", -1 as i64),
        index_uid = _get_str(body, "indexUid"), status = _get_str(body, "status"), kind = _get_str(body, "type"),
        canceled_by = _get_i64(body, "canceledBy", -1 as i64), details = _get_raw(body, "details"),
        error = _task_error(_get_raw(body, "error")), duration = _get_str(body, "duration"),
        enqueued_at = _get_str(body, "enqueuedAt"), started_at = _get_str(body, "startedAt"),
        finished_at = _get_str(body, "finishedAt"), custom_metadata = _get_str(body, "customMetadata"),
        network = _get_raw(body, "network")
    }
end

func _batch(body: str): Batch:
    if body.len() == 0: ret Batch {} end
    ret Batch {
        uid = _get_i64(body, "uid", -1 as i64), details = _get_raw(body, "details"), stats = _get_raw(body, "stats"),
        progress = _get_raw(body, "progress"), batch_strategy = _get_str(body, "batchStrategy"),
        duration = _get_str(body, "duration"), started_at = _get_str(body, "startedAt"),
        finished_at = _get_str(body, "finishedAt")
    }
end

func _join_i64(items: Vector<i64>): str:
    mut out := ""
    repeat items.len() in i:
        if i > 0: out = out + "," end
        out = out + conv.FormatInt(items.get(i))
    end
    ret out
end

func _task_query(q: TaskQuery, paged: bool): str:
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<str>
    if q.uids.len() > 0:
        keys.push("uids")
        vals.push(_join_i64(q.uids))
    end
    if q.batch_uids.len() > 0:
        keys.push("batchUids")
        vals.push(_join_i64(q.batch_uids))
    end
    if q.canceled_by.len() > 0:
        keys.push("canceledBy")
        vals.push(_join_i64(q.canceled_by))
    end
    if q.statuses.len() > 0:
        keys.push("statuses")
        vals.push(str.Join(q.statuses, ","))
    end
    if q.types.len() > 0:
        keys.push("types")
        vals.push(str.Join(q.types, ","))
    end
    if q.index_uids.len() > 0:
        keys.push("indexUids")
        vals.push(str.Join(q.index_uids, ","))
    end
    if paged:
        if q.limit > 0:
            keys.push("limit")
            vals.push(conv.FormatInt(q.limit as i64))
        end
        if q.from >= 0 as i64:
            keys.push("from")
            vals.push(conv.FormatInt(q.from))
        end
        if q.reverse:
            keys.push("reverse")
            vals.push("true")
        end
    end
    if q.before_enqueued_at.len() > 0:
        keys.push("beforeEnqueuedAt")
        vals.push(q.before_enqueued_at)
    end
    if q.after_enqueued_at.len() > 0:
        keys.push("afterEnqueuedAt")
        vals.push(q.after_enqueued_at)
    end
    if q.before_started_at.len() > 0:
        keys.push("beforeStartedAt")
        vals.push(q.before_started_at)
    end
    if q.after_started_at.len() > 0:
        keys.push("afterStartedAt")
        vals.push(q.after_started_at)
    end
    if q.before_finished_at.len() > 0:
        keys.push("beforeFinishedAt")
        vals.push(q.before_finished_at)
    end
    if q.after_finished_at.len() > 0:
        keys.push("afterFinishedAt")
        vals.push(q.after_finished_at)
    end
    ret _query(keys, vals)
end

func _finished(status: str): bool:
    ret status == STATUS_SUCCEEDED or status == STATUS_FAILED or status == STATUS_CANCELED
end

@en "GetTask"
@fa "دریافت کار"
pub func GetTask(c: Client, uid: i64, err &: Error): Task:
    ret _task(_call(c, "GET", "/tasks/" + conv.FormatInt(uid), "", err))
end

@en "GetTasks"
@fa "دریافت کارها"
pub func GetTasks(c: Client, q: TaskQuery, err &: Error): TaskPage:
    body := _call(c, "GET", "/tasks" + _task_query(q, true), "", err)
    mut out := TaskPage {
        limit = _get_i64(body, "limit", 0 as i64), from = _get_i64(body, "from", -1 as i64), next = _get_i64(body, "next", -1 as i64),
        total = _get_i64(body, "total", 0 as i64)
    }
    each item in _elements(_get_raw(body, "results")):
        out.results.push(_task(item))
    end
    ret out
end

@en "WaitForTask"
@fa "انتظار برای کار"
pub func WaitForTask(c: Client, uid: i64, timeout_ms: int, interval_ms: int, err &: Error): Task:
    mut wait := interval_ms
    if wait <= 0: wait = 50 end
    start := time.NowMillis()
    until true:
        t := GetTask(c, uid, err)
        if not Ok(err): ret t end
        if _finished(t.status):
            if t.status == STATUS_FAILED:
                err.status = 0
                err.code = t.error.code
                err.kind = t.error.kind
                err.message = t.error.message
                err.link = t.error.link
                if err.code.len() == 0: err.code = "task_failed" end
            end
            ret t
        end
        if timeout_ms > 0 and time.NowMillis() - start >= timeout_ms as i64:
            _fail(err, 0, "timeout", "timeout", "task " + conv.FormatInt(uid) + " did not finish in " + conv.FormatInt(timeout_ms as i64) + " ms")
            ret t
        end
        time.Sleep(wait)
    end
end

@en "Wait"
@fa "انتظار"
pub func Wait(c: Client, info: TaskInfo, err &: Error): Task:
    if not Ok(err): ret Task {} end
    ret WaitForTask(c, info.task_uid, 5000, 50, err)
end

@en "CancelTasks"
@fa "لغو کارها"
pub func CancelTasks(c: Client, q: TaskQuery, err &: Error): TaskInfo:
    ret _task_info(_call(c, "POST", "/tasks/cancel" + _task_query(q, false), "", err))
end

@en "DeleteTasks"
@fa "حذف کارها"
pub func DeleteTasks(c: Client, q: TaskQuery, err &: Error): TaskInfo:
    ret _task_info(_call(c, "DELETE", "/tasks" + _task_query(q, false), "", err))
end

@en "GetBatch"
@fa "دریافت دسته"
pub func GetBatch(c: Client, uid: i64, err &: Error): Batch:
    ret _batch(_call(c, "GET", "/batches/" + conv.FormatInt(uid), "", err))
end

@en "GetBatches"
@fa "دریافت دسته‌ها"
pub func GetBatches(c: Client, q: TaskQuery, err &: Error): BatchPage:
    body := _call(c, "GET", "/batches" + _task_query(q, true), "", err)
    mut out := BatchPage {
        limit = _get_i64(body, "limit", 0 as i64), from = _get_i64(body, "from", -1 as i64), next = _get_i64(body, "next", -1 as i64),
        total = _get_i64(body, "total", 0 as i64)
    }
    each item in _elements(_get_raw(body, "results")):
        out.results.push(_batch(item))
    end
    ret out
end

@en "GetTaskDocuments"
@fa "دریافت سندهای کار"
pub func GetTaskDocuments(c: Client, uid: i64, err &: Error): str:
    ret _send(c, "GET", "/tasks/" + conv.FormatInt(uid) + "/documents", "", "", err)
end

@en "CompactTasks"
@fa "فشرده‌سازی صف کارها"
pub func CompactTasks(c: Client, err &: Error): TaskCompaction:
    body := _call(c, "POST", "/tasks/compact", "", err)
    ret TaskCompaction {
        status = _get_str(body, "status"), pre_size = _get_str(body, "preSize"), post_size = _get_str(body, "postSize"),
        action_required = _get_str(body, "actionRequired"), error_message = _get_str(body, "errorMessage")
    }
end
