package mysql

if SALAM_DB_MOCK:
    extern:
        func mysql_init(conn: void*): void*
        func mysql_real_connect(conn: void*, host: str, user: str, passwd: str, db: str, port: u32, unix_socket: void*, client_flag: u64): void*
        func mysql_close(conn: void*)
        func mysql_ping(conn: void*): int
        func mysql_select_db(conn: void*, db: str): int
        func mysql_set_character_set(conn: void*, csname: str): int
        func mysql_query(conn: void*, stmt: str): int
        func mysql_store_result(conn: void*): void*
        func mysql_free_result(result: void*)
        func mysql_fetch_row(result: void*): void*
        func mysql_num_fields(result: void*): u32
        func mysql_num_rows(result: void*): u64
        func mysql_fetch_field_direct(result: void*, fieldnr: u32): void*
        func mysql_affected_rows(conn: void*): u64
        func mysql_insert_id(conn: void*): u64
        func mysql_autocommit(conn: void*, mode: bool): bool
        func mysql_commit(conn: void*): bool
        func mysql_rollback(conn: void*): bool
        func mysql_real_escape_string(conn: void*, dst: void*, from: str, length: u64): u64
        func mysql_error(conn: void*): str
        func mysql_errno(conn: void*): u32
        func mysql_get_client_info(): str
        func mysql_thread_init(): bool
        func mysql_thread_end()
        func mysql_server_init(argc: int, argv: void*, groups: void*): int
        func mysql_server_end()
        func mysql_get_server_info(conn: void*): str
    end

    func _my_init(conn: void*): void*:
        ret mysql_init(conn)
    end

    func _my_real_connect(conn: void*, host: str, user: str, passwd: str, db: str, port: u32, unix_socket: void*, client_flag: u64): void*:
        ret mysql_real_connect(conn, host, user, passwd, db, port, unix_socket, client_flag)
    end

    func _my_close(conn: void*):
        mysql_close(conn)
    end

    func _my_ping(conn: void*): int:
        ret mysql_ping(conn)
    end

    func _my_select_db(conn: void*, db: str): int:
        ret mysql_select_db(conn, db)
    end

    func _my_set_character_set(conn: void*, csname: str): int:
        ret mysql_set_character_set(conn, csname)
    end

    func _my_query(conn: void*, stmt: str): int:
        ret mysql_query(conn, stmt)
    end

    func _my_store_result(conn: void*): void*:
        ret mysql_store_result(conn)
    end

    func _my_free_result(result: void*):
        mysql_free_result(result)
    end

    func _my_fetch_row(result: void*): void*:
        ret mysql_fetch_row(result)
    end

    func _my_num_fields(result: void*): u32:
        ret mysql_num_fields(result)
    end

    func _my_num_rows(result: void*): u64:
        ret mysql_num_rows(result)
    end

    func _my_fetch_field_direct(result: void*, fieldnr: u32): void*:
        ret mysql_fetch_field_direct(result, fieldnr)
    end

    func _my_affected_rows(conn: void*): u64:
        ret mysql_affected_rows(conn)
    end

    func _my_insert_id(conn: void*): u64:
        ret mysql_insert_id(conn)
    end

    func _my_autocommit(conn: void*, mode: bool): bool:
        ret mysql_autocommit(conn, mode)
    end

    func _my_commit(conn: void*): bool:
        ret mysql_commit(conn)
    end

    func _my_rollback(conn: void*): bool:
        ret mysql_rollback(conn)
    end

    func _my_real_escape_string(conn: void*, dst: void*, from: str, length: u64): u64:
        ret mysql_real_escape_string(conn, dst, from, length)
    end

    func _my_error(conn: void*): str:
        ret mysql_error(conn)
    end

    func _my_errno(conn: void*): u32:
        ret mysql_errno(conn)
    end

    func _my_get_client_info(): str:
        ret mysql_get_client_info()
    end

    func _my_thread_init(): bool:
        ret mysql_thread_init()
    end

    func _my_thread_end():
        mysql_thread_end()
    end

    func _my_server_init(argc: int, argv: void*, groups: void*): int:
        ret mysql_server_init(argc, argv, groups)
    end

    func _my_server_end():
        mysql_server_end()
    end

    func _my_get_server_info(conn: void*): str:
        ret mysql_get_server_info(conn)
    end
end
