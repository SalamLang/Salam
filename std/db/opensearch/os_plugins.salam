@en "ExplainPolicy"
@fa "توضیح سیاست"
pub func ExplainPolicy(c: Client, index: str): str:
    ret _os_plugin(c, "GET", "/_plugins/_ism/explain/" + _os_idx(index), "")
end

@en "PolicyIdOf"
@fa "شناسه سیاست نمایه"
pub func PolicyIdOf(c: Client, index: str): str:
    raw := ExplainPolicy(c, index)
    if raw.len() == 0: ret str.Clone("") end
    entry := _os_raw_member(raw, index)
    v := _os_jstr(entry, "index.plugins.index_state_management.policy_id")
    if v.len() > 0: ret v end
    ret _os_jstr(entry, "policy_id")
end

@en "DeleteAfterPolicy"
@fa "سیاست حذف پس از"
pub func DeleteAfterPolicy(description: str, min_index_age: str, patterns: Vector<str>): str:
    cond := _os_one("min_index_age", json.Str(min_index_age))
    trans := "[" + _os_two("state_name", `"delete"`, "conditions", cond) + "]"
    mut hot := Vector {} as Vector<str>
    hot.push(_os_m("name", `"hot"`))
    hot.push(_os_m("actions", "[]"))
    hot.push(_os_m("transitions", trans))
    mut del := Vector {} as Vector<str>
    del.push(_os_m("name", `"delete"`))
    del.push(_os_m("actions", `[{"delete":{}}]`))
    del.push(_os_m("transitions", "[]"))
    mut m := Vector {} as Vector<str>
    m.push(_os_m("description", json.Str(description)))
    m.push(_os_m("default_state", `"hot"`))
    m.push(_os_m("states", "[" + _os_obj(hot) + "," + _os_obj(del) + "]"))
    if patterns.len() > 0:
        m.push(_os_m("ism_template", "[" + _os_two("index_patterns", _os_strs(patterns), "priority", "100") + "]"))
    end
    ret _os_obj(m)
end

@en "WhoAmI"
@fa "من کیستم"
pub func WhoAmI(c: Client): AuthInfo:
    r := Perform(c, "GET", "/_plugins/_security/authinfo", "")
    if not r.ok: ret AuthInfo { error = r.error } end
    ret AuthInfo {
        ok = true, user = _os_jstr(r.body, "user_name"), roles = _os_strings(_os_jraw(r.body, "roles")),
        backend_roles = _os_strings(_os_jraw(r.body, "backend_roles")), tenants = json.Keys(_os_jraw(r.body, "tenants"))
    }
end

