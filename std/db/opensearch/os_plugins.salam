@en "PutPolicy"
@fa "تنظیم سیاست"
pub func PutPolicy(c: Client, id: str, policy: str): bool:
    r := Perform(c, "PUT", "/_plugins/_ism/policies/" + _os_seg(id), _os_one("policy", policy))
    ret r.ok
end

@en "UpdatePolicy"
@fa "به‌روزرسانی سیاست"
pub func UpdatePolicy(c: Client, id: str, policy: str, seq_no: i64, primary_term: i64): bool:
    q := "?if_seq_no=" + conv.FormatInt(seq_no) + "&if_primary_term=" + conv.FormatInt(primary_term)
    ret Perform(c, "PUT", "/_plugins/_ism/policies/" + _os_seg(id) + q, _os_one("policy", policy)).ok
end

