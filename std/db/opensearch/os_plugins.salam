@en "ChangePolicy"
@fa "تغییر سیاست"
pub func ChangePolicy(c: Client, index: str, policy_id: str, state: str): int:
    mut m := Vector {} as Vector<str>
    m.push(_os_m("policy_id", json.Str(policy_id)))
    if state.len() > 0: m.push(_os_m("state", json.Str(state))) end
    ret _os_ism_count(Perform(c, "POST", "/_plugins/_ism/change_policy/" + _os_idx(index), _os_obj(m)))
end

