@en "RoleBody"
@fa "بدنه نقش"
pub func RoleBody(cluster_permissions: Vector<str>, index_patterns: Vector<str>, allowed_actions: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    if cluster_permissions.len() > 0: m.push(_os_m("cluster_permissions", _os_strs(cluster_permissions))) end
    if index_patterns.len() > 0:
        perm := _os_two("index_patterns", _os_strs(index_patterns), "allowed_actions", _os_strs(allowed_actions))
        m.push(_os_m("index_permissions", "[" + perm + "]"))
    end
    ret _os_obj(m)
end

