    if not r.ok: ret str.Clone("") end
    ret _os_jstr(r.body, "status")
end

@en "PutUser"
@fa "تنظیم کاربر"
pub func PutUser(c: Client, name: str, password: str, backend_roles: Vector<str>, attributes: str): bool:
    mut m := Vector {} as Vector<str>
    m.push(_os_m("password", json.Str(password)))
    if backend_roles.len() > 0: m.push(_os_m("backend_roles", _os_strs(backend_roles))) end
    if attributes.len() > 0: m.push(_os_m("attributes", attributes)) end
    ret Perform(c, "PUT", "/_plugins/_security/api/internalusers/" + _os_seg(name), _os_obj(m)).ok
end

