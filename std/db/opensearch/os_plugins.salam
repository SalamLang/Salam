@en "NormalizationPipeline"
@fa "خط لوله نرمال‌سازی"
pub func NormalizationPipeline(normalization: str, combination: str, weights: Vector<f64>): str:
    mut comb := Vector {} as Vector<str>
    comb.push(_os_m("technique", json.Str(combination)))
    if weights.len() > 0: comb.push(_os_m("parameters", _os_one("weights", _os_floats(weights)))) end
    proc := _os_two("normalization", _os_one("technique", json.Str(normalization)), "combination", _os_obj(comb))
    ret _os_one("phase_results_processors", "[" + _os_one("normalization-processor", proc) + "]")
end

