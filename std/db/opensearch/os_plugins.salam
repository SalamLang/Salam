package opensearch

import str
import conv
import encoding.json

@en "AuthInfo"
@fa "اطلاعات احراز"
pub struct AuthInfo:
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
    @en "user"
    @fa "کاربر"
    pub user: str = ""
    @en "roles"
    @fa "نقش‌ها"
    pub roles: Vector<str> = Vector {}
    @en "backend_roles"
    @fa "نقش‌های بک‌اند"
    pub backend_roles: Vector<str> = Vector {}
    @en "tenants"
    @fa "مستأجر‌ها"
    pub tenants: Vector<str> = Vector {}
    @en "error"
    @fa "خطا"
    pub error: str = ""
end

@en "KnnMethod"
@fa "روش همسایه‌یابی"
pub struct KnnMethod:
    @en "name"
    @fa "نام"
    pub name: str = "hnsw"
    @en "engine"
    @fa "موتور"
    pub engine: str = "lucene"
    @en "space_type"
    @fa "نوع فضا"
    pub space_type: str = "l2"
    @en "m"
    @fa "تعداد پیوند"
    pub m: int = 0
    @en "ef_construction"
    @fa "کیفیت ساخت"
    pub ef_construction: int = 0
end

func _os_strings(raw: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    each it in _os_items(raw):
        out.push(_os_unquote(it))
    end
    ret out
end

func _os_plugin(c: Client, method: str, path: str, body: str): str:
    r := Perform(c, method, path, body)
    if not r.ok: ret str.Clone("") end
    ret r.body
end

func _os_ism_count(r: Response): int:
    if not r.ok: ret -1 end
    if _os_jbool(r.body, "failures"): ret -1 end
    ret _os_int(_os_jraw(r.body, "updated_indices"))
end

@en "KnnIndexSettings"
@fa "تنظیمات نمایه همسایه‌یابی"
pub func KnnIndexSettings(shards: int, replicas: int): str:
    mut idx := Vector {} as Vector<str>
    idx.push(_os_m("knn", "true"))
    if shards > 0: idx.push(_os_m("number_of_shards", str.FromInt(shards as i64))) end
    if replicas >= 0: idx.push(_os_m("number_of_replicas", str.FromInt(replicas as i64))) end
    ret _os_one("index", _os_obj(idx))
end

@en "KnnVectorField"
@fa "فیلد بردار همسایه‌یابی"
pub func KnnVectorField(dimension: int, method: KnnMethod): str:
    mut mm := Vector {} as Vector<str>
    mm.push(_os_m("name", json.Str(method.name)))
    mm.push(_os_m("engine", json.Str(method.engine)))
    mm.push(_os_m("space_type", json.Str(method.space_type)))
    mut params := Vector {} as Vector<str>
    if method.m > 0: params.push(_os_m("m", str.FromInt(method.m as i64))) end
    if method.ef_construction > 0: params.push(_os_m("ef_construction", str.FromInt(method.ef_construction as i64))) end
    if params.len() > 0: mm.push(_os_m("parameters", _os_obj(params))) end
    mut m := Vector {} as Vector<str>
    m.push(_os_m("type", `"knn_vector"`))
    m.push(_os_m("dimension", str.FromInt(dimension as i64)))
    m.push(_os_m("method", _os_obj(mm)))
    ret _os_obj(m)
end

@en "KnnIndexBody"
@fa "بدنه نمایه همسایه‌یابی"
pub func KnnIndexBody(field: str, dimension: int, method: KnnMethod, extra_properties: Vector<str>): str:
    mut props := Vector {} as Vector<str>
    props.push(_os_m(field, KnnVectorField(dimension, method)))
    each p in extra_properties:
        props.push(p)
    end
    ret _os_two("settings", KnnIndexSettings(0, -1), "mappings", _os_one("properties", _os_obj(props)))
end

@en "KnnVector"
@fa "بردار همسایه‌یابی"
pub func KnnVector(values: Vector<f64>): str:
    ret _os_floats(values)
end

