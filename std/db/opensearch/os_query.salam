end

@en "CompositeAgg"
@fa "تجمیع ترکیبی"
pub func CompositeAgg(fields: Vector<str>, size: int): str:
    mut sources := Vector {} as Vector<str>
    each f in fields:
        sources.push(_os_one(f, _os_one("terms", _os_one("field", json.Str(f)))))
    end
    ret _os_one("composite", _os_two("size", str.FromInt(size as i64), "sources", _os_arr(sources)))
end

@en "AddAgg"
@fa "افزودن تجمیع"
pub func AddAgg(aggs: str, name: str, agg: str): str:
    ret AddMember(aggs, name, agg)
end

@en "SubAggs"
@fa "زیرتجمیع‌ها"
pub func SubAggs(agg: str, aggs: str): str:
    ret AddMember(agg, "aggs", aggs)
end

@en "AddMember"
@fa "افزودن عضو"
pub func AddMember(obj: str, key: str, raw: str): str:
    body := _os_strip_obj(obj)
    member := _os_m(key, raw)
    if body.len() == 0: ret "{" + member + "}" end
    ret "{" + body + "," + member + "}"
end

@en "SearchBody"
@fa "بدنه جستجو"
pub func SearchBody(req: SearchRequest): str:
    mut m := Vector {} as Vector<str>
    if req.query.len() > 0: m.push(_os_m("query", req.query)) end
    if req.from >= 0: m.push(_os_m("from", str.FromInt(req.from as i64))) end
    if req.size >= 0: m.push(_os_m("size", str.FromInt(req.size as i64))) end
    if req.sort.len() > 0: m.push(_os_m("sort", _os_arr(req.sort))) end
    if req.no_source:
        m.push(_os_m("_source", "false"))
    else req.source.len() > 0 or req.source_excludes.len() > 0:
        mut src := Vector {} as Vector<str>
        if req.source.len() > 0: src.push(_os_m("includes", _os_strs(req.source))) end
        if req.source_excludes.len() > 0: src.push(_os_m("excludes", _os_strs(req.source_excludes))) end
        m.push(_os_m("_source", _os_obj(src)))
    end
    if req.fields.len() > 0: m.push(_os_m("fields", _os_strs(req.fields))) end
    if req.docvalue_fields.len() > 0: m.push(_os_m("docvalue_fields", _os_strs(req.docvalue_fields))) end
    if req.aggs.len() > 0: m.push(_os_m("aggs", req.aggs)) end
    if req.highlight.len() > 0: m.push(_os_m("highlight", req.highlight)) end
    if req.post_filter.len() > 0: m.push(_os_m("post_filter", req.post_filter)) end
    if req.collapse.len() > 0: m.push(_os_m("collapse", req.collapse)) end
    if req.suggest.len() > 0: m.push(_os_m("suggest", req.suggest)) end
    if req.rescore.len() > 0: m.push(_os_m("rescore", req.rescore)) end
    if req.script_fields.len() > 0: m.push(_os_m("script_fields", req.script_fields)) end
    if req.search_after.len() > 0: m.push(_os_m("search_after", req.search_after)) end
    if req.pit_id.len() > 0:
        mut pit := Vector {} as Vector<str>
        pit.push(_os_m("id", json.Str(req.pit_id)))
        if req.pit_keep_alive.len() > 0: pit.push(_os_m("keep_alive", json.Str(req.pit_keep_alive))) end
        m.push(_os_m("pit", _os_obj(pit)))
    end
    if req.track_total_hits.len() > 0:
        tth := req.track_total_hits
        if tth == "true" or tth == "false" or str.IsDigit(char_code(tth.substr(0, 1))):
            m.push(_os_m("track_total_hits", tth))
        else:
            m.push(_os_m("track_total_hits", json.Str(tth)))
        end
    end
    if req.track_scores: m.push(_os_m("track_scores", "true")) end
    if req.min_score.len() > 0: m.push(_os_m("min_score", req.min_score)) end
    if req.timeout.len() > 0: m.push(_os_m("timeout", json.Str(req.timeout))) end
    if req.explain: m.push(_os_m("explain", "true")) end
    if req.version: m.push(_os_m("version", "true")) end
    if req.seq_no_primary_term: m.push(_os_m("seq_no_primary_term", "true")) end
    if req.ext.len() > 0: m.push(_os_m("ext", req.ext)) end
    each e in req.extra:
        m.push(e)
    end
    ret _os_obj(m)
end
