@en "BoolOf"
@fa "پرسمان منطقی ساخته"
pub func BoolOf(q: BoolQuery): str:
    mut m := Vector {} as Vector<str>
    _os_bool_part(m, "must", q.must)
    _os_bool_part(m, "filter", q.filter)
    _os_bool_part(m, "should", q.should)
    _os_bool_part(m, "must_not", q.must_not)
    if q.minimum_should_match.len() > 0:
        m.push(_os_m("minimum_should_match", json.Str(q.minimum_should_match)))
    end
    if q.boost > 0.0: m.push(_os_m("boost", conv.FormatFloat(q.boost))) end
    ret _os_one("bool", _os_obj(m))
end

@en "Bool"
@fa "منطقی"
pub func Bool(must: Vector<str>, filter: Vector<str>, should: Vector<str>, must_not: Vector<str>): str:
    ret BoolOf(BoolQuery { must = must, filter = filter, should = should, must_not = must_not })
end

@en "And"
@fa "همه شرط‌ها"
pub func And(clauses: Vector<str>): str:
    ret BoolOf(BoolQuery { must = clauses })
end

@en "Or"
@fa "یکی از شرط‌ها"
pub func Or(clauses: Vector<str>): str:
    ret BoolOf(BoolQuery { should = clauses, minimum_should_match = "1" })
end

@en "Not"
@fa "نقیض"
pub func Not(clause: str): str:
    mut neg := Vector {} as Vector<str>
    neg.push(clause)
    ret BoolOf(BoolQuery { must_not = neg })
end

@en "Filtered"
@fa "پالایش شده"
pub func Filtered(query: str, filters: Vector<str>): str:
    mut must := Vector {} as Vector<str>
    must.push(query)
    ret BoolOf(BoolQuery { must = must, filter = filters })
end

