@en "Range"
@fa "بازه"
pub func Range(field: str, low: str, high: str): str:
    mut m := Vector {} as Vector<str>
    if low.len() > 0: m.push(_os_m("gte", json.Str(low))) end
    if high.len() > 0: m.push(_os_m("lte", json.Str(high))) end
    ret _os_field_obj("range", field, _os_obj(m))
end

