@en "Highlight"
@fa "برجسته‌سازی"
pub func Highlight(fields: Vector<str>): str:
    mut m := Vector {} as Vector<str>
    each f in fields:
        m.push(_os_m(f, "{}"))
    end
    ret _os_one("fields", _os_obj(m))
end

@en "HighlightTags"
@fa "برجسته‌سازی با برچسب"
pub func HighlightTags(fields: Vector<str>, pre: str, post: str): str:
    mut m := Vector {} as Vector<str>
    each f in fields:
        m.push(_os_m(f, "{}"))
    end
    mut pre_tags := Vector {} as Vector<str>
    pre_tags.push(pre)
    mut post_tags := Vector {} as Vector<str>
    post_tags.push(post)
    mut out := Vector {} as Vector<str>
    out.push(_os_m("pre_tags", _os_strs(pre_tags)))
    out.push(_os_m("post_tags", _os_strs(post_tags)))
    out.push(_os_m("fields", _os_obj(m)))
    ret _os_obj(out)
end

