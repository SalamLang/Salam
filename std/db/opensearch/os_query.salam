@en "RangeAgg"
@fa "تجمیع بازه"
pub func RangeAgg(field: str, bounds: Vector<f64>): str:
    mut ranges := Vector {} as Vector<str>
    n := bounds.len()
    if n > 0: ranges.push(_os_one("to", conv.FormatFloat(bounds.get(0)))) end
    repeat n in i:
        if i + 1 < n:
            ranges.push(_os_two("from", conv.FormatFloat(bounds.get(i)), "to", conv.FormatFloat(bounds.get(i + 1))))
        end
    end
    if n > 0: ranges.push(_os_one("from", conv.FormatFloat(bounds.get(n - 1)))) end
    ret _os_one("range", _os_two("field", json.Str(field), "ranges", _os_arr(ranges)))
end

