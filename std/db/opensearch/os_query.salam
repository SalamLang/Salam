    if boost_mode.len() > 0: m.push(_os_m("boost_mode", json.Str(boost_mode))) end
    ret _os_one("function_score", _os_obj(m))
end

@en "FieldValueFactor"
@fa "ضریب مقدار فیلد"
pub func FieldValueFactor(field: str, factor: f64, modifier: str): str:
    mut m := Vector {} as Vector<str>
    m.push(_os_m("field", json.Str(field)))
    m.push(_os_m("factor", conv.FormatFloat(factor)))
    if modifier.len() > 0: m.push(_os_m("modifier", json.Str(modifier))) end
    m.push(_os_m("missing", "1"))
    ret _os_one("field_value_factor", _os_obj(m))
end

