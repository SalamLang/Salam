@en "QueryStringFields"
@fa "رشته پرسمان در فیلدها"
pub func QueryStringFields(query: str, fields: Vector<str>, default_operator: str): str:
    mut m := Vector {} as Vector<str>
    m.push(_os_m("query", json.Str(query)))
    if fields.len() > 0: m.push(_os_m("fields", _os_strs(fields))) end
    if default_operator.len() > 0: m.push(_os_m("default_operator", json.Str(default_operator))) end
    ret _os_one("query_string", _os_obj(m))
end

