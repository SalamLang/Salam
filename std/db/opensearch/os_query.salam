@en "Script"
@fa "اسکریپت"
pub func Script(source: str, params: str): str:
    mut m := Vector {} as Vector<str>
    m.push(_os_m("source", json.Str(source)))
    m.push(_os_m("lang", `"painless"`))
    if params.len() > 0: m.push(_os_m("params", params)) end
    ret _os_obj(m)
end

