package opensearch

import str
import conv
import encoding.json

@en "BoolQuery"
@fa "پرسمان منطقی"
pub struct BoolQuery:
    @en "must"
    @fa "الزامی"
    pub must: Vector<str> = Vector {}
    @en "filter"
    @fa "فیلتر"
    pub filter: Vector<str> = Vector {}
    @en "should"
    @fa "ترجیحی"
    pub should: Vector<str> = Vector {}
    @en "must_not"
    @fa "ممنوع"
    pub must_not: Vector<str> = Vector {}
    @en "minimum_should_match"
    @fa "کمترین تطابق ترجیحی"
    pub minimum_should_match: str = ""
    @en "boost"
    @fa "ضریب"
    pub boost: f64 = 0.0
end

func _os_m(key: str, raw: str): str:
    ret json.Str(key) + ":" + raw
end

func _os_obj(members: Vector<str>): str:
    ret "{" + str.Join(members, ",") + "}"
end

func _os_arr(items: Vector<str>): str:
    ret "[" + str.Join(items, ",") + "]"
end

func _os_field_obj(kind: str, field: str, raw: str): str:
    ret _os_one(kind, _os_one(field, raw))
end

func _os_floats(values: Vector<f64>): str:
    mut parts := Vector {} as Vector<str>
    each v in values:
        parts.push(conv.FormatFloat(v))
    end
    ret _os_arr(parts)
end

func _os_bool_part(m &: Vector<str>, key: str, clauses: Vector<str>):
    if clauses.len() == 0: ret end
    m.push(_os_m(key, _os_arr(clauses)))
end

func _os_strip_obj(obj: str): str:
    t := str.Trim(obj)
    if t.len() < 2 or not str.StartsWith(t, "{"): ret str.Clone("") end
    ret str.Trim(t.substr(1, t.len() - 2))
end

@en "MatchAll"
@fa "تطبیق همه"
pub func MatchAll(): str:
    ret str.Clone(`{"match_all":{}}`)
end

@en "MatchNone"
@fa "تطبیق هیچ"
pub func MatchNone(): str:
    ret str.Clone(`{"match_none":{}}`)
end

@en "Match"
@fa "تطبیق"
pub func Match(field: str, text: str): str:
    ret _os_field_obj("match", field, json.Str(text))
end

