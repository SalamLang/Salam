package postgres

if SALAM_DB_MOCK:
    extern:
        func PQconnectdb(conninfo: str): void*
        func PQstatus(conn: void*): int
        func PQfinish(conn: void*)
        func PQreset(conn: void*)
        func PQerrorMessage(conn: void*): str
        func PQexec(conn: void*, query: str): void*
        func PQresultStatus(res: void*): int
        func PQntuples(res: void*): int
        func PQnfields(res: void*): int
        func PQfname(res: void*, col: int): str
        func PQftype(res: void*, col: int): u32
        func PQgetvalue(res: void*, row: int, col: int): void*
        func PQgetisnull(res: void*, row: int, col: int): int
        func PQcmdTuples(res: void*): str
        func PQclear(res: void*)
        func PQlibVersion(): int
        func PQserverVersion(conn: void*): int
        func PQescapeLiteral(conn: void*, s: str, length: u64): void*
        func PQfreemem(p: void*)
        func PQdb(conn: void*): str
        func PQuser(conn: void*): str
        func PQhost(conn: void*): str
        func PQport(conn: void*): str
    end

    func _pq_connectdb(conninfo: str): void*:
        ret PQconnectdb(conninfo)
    end

    func _pq_status(conn: void*): int:
        ret PQstatus(conn)
    end

    func _pq_finish(conn: void*):
        PQfinish(conn)
    end

    func _pq_reset(conn: void*):
        PQreset(conn)
    end

    func _pq_error_message(conn: void*): str:
        ret PQerrorMessage(conn)
    end

    func _pq_exec(conn: void*, query: str): void*:
        ret PQexec(conn, query)
    end

    func _pq_result_status(res: void*): int:
        ret PQresultStatus(res)
    end

    func _pq_ntuples(res: void*): int:
        ret PQntuples(res)
    end

    func _pq_nfields(res: void*): int:
        ret PQnfields(res)
    end

    func _pq_fname(res: void*, col: int): str:
        ret PQfname(res, col)
    end

    func _pq_ftype(res: void*, col: int): u32:
        ret PQftype(res, col)
    end

    func _pq_getvalue(res: void*, row: int, col: int): void*:
        ret PQgetvalue(res, row, col)
    end

    func _pq_getisnull(res: void*, row: int, col: int): int:
        ret PQgetisnull(res, row, col)
    end

    func _pq_cmd_tuples(res: void*): str:
        ret PQcmdTuples(res)
    end

    func _pq_clear(res: void*):
        PQclear(res)
    end

    func _pq_lib_version(): int:
        ret PQlibVersion()
    end

    func _pq_server_version(conn: void*): int:
        ret PQserverVersion(conn)
    end

    func _pq_escape_literal(conn: void*, s: str, length: u64): void*:
        ret PQescapeLiteral(conn, s, length)
    end

    func _pq_freemem(p: void*):
        PQfreemem(p)
    end

    func _pq_db(conn: void*): str:
        ret PQdb(conn)
    end

    func _pq_user(conn: void*): str:
        ret PQuser(conn)
    end

    func _pq_host(conn: void*): str:
        ret PQhost(conn)
    end

    func _pq_port(conn: void*): str:
        ret PQport(conn)
    end
end
