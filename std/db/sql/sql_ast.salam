const J_INNER := 0
const J_LEFT := 1
const J_RIGHT := 2
const J_FULL := 3
const J_CROSS := 4

struct Node:
    pub kind: int = 0
    pub tok: int = 0 - 1
    pub t1: int = 0 - 1
    pub t2: int = 0 - 1
    pub op: int = 0
    pub flags: int = 0
    pub a: int = 0 - 1
    pub b: int = 0 - 1
    pub c: int = 0 - 1
    pub d: int = 0 - 1
    pub e: int = 0 - 1
    pub f: int = 0 - 1
    pub g: int = 0 - 1
    pub list: Vector<int> = Vector {}
end

struct Ast:
    pub nodes: Vector<Node> = Vector {}
    pub roots: Vector<int> = Vector {}
end

func nd_new(a &: Ast, kind: int, tok: int): int:
    id := a.nodes.len()
    a.nodes.push(Node { kind = kind, tok = tok })
    ret id
end

func nd_kind(a: Ast, id: int): int:
    if id < 0 or id >= a.nodes.len():
        ret N_NONE
    end
    ret a.nodes.get(id).kind
end

func nd_set_list(a &: Ast, id: int, items: Vector<int>):
    if id < 0 or id >= a.nodes.len():
        ret
    end
    mut n := a.nodes.ref(id)
    n.list = items
end

func nd_set_a(a &: Ast, id: int, v: int):
    if id < 0 or id >= a.nodes.len():
        ret
    end
    mut n := a.nodes.ref(id)
    n.a = v
end

func nd_set_b(a &: Ast, id: int, v: int):
    if id < 0 or id >= a.nodes.len():
        ret
    end
    mut n := a.nodes.ref(id)
