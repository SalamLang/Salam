func nd_set_t2(a &: Ast, id: int, v: int):
    if id < 0 or id >= a.nodes.len():
        ret
    end
    mut n := a.nodes.ref(id)
    n.t2 = v
end

func nd_set_op(a &: Ast, id: int, v: int):
    if id < 0 or id >= a.nodes.len():
        ret
    end
    mut n := a.nodes.ref(id)
    n.op = v
end

func nd_add_flag(a &: Ast, id: int, v: int):
    if id < 0 or id >= a.nodes.len():
        ret
    end
    mut n := a.nodes.ref(id)
    n.flags = n.flags | v
end

func nd_set_tok(a &: Ast, id: int, v: int):
    if id < 0 or id >= a.nodes.len():
        ret
    end
    mut n := a.nodes.ref(id)
    n.tok = v
end

func nd_push(a &: Ast, id: int, v: int):
    if id < 0 or id >= a.nodes.len():
        ret
    end
    mut n := a.nodes.ref(id)
    n.list.push(v)
end

func free_ast(a &: Ast):
    mut i := 0
    until i < a.nodes.len():
        mut n := a.nodes.ref(i)
        n.list.free()
        i = i + 1
    end
    a.nodes.free()
    a.roots.free()
end
