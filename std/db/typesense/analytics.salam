@en "AnalyticsRule"
@fa "قاعده تحلیل"
pub struct AnalyticsRule:
    pub name: str = ""
    pub kind: str = ""
    pub collection: str = ""
    pub event_type: str = ""
    pub rule_tag: str = ""
    pub params: str = ""
    pub raw: str = ""
end

@en "ConversationModel"
@fa "مدل گفتگو"
pub struct ConversationModel:
    pub id: str = ""
    pub model_name: str = ""
    pub api_key: str = ""
    pub history_collection: str = ""
    pub system_prompt: str = ""
    pub max_bytes: int = 0
    pub ttl: int = 0
    pub account_id: str = ""
    pub vllm_url: str = ""
    pub extra: str = ""
end

func _rule(raw: str): AnalyticsRule:
    ret AnalyticsRule {
        name = _get_str(raw, "name"), kind = _get_str(raw, "type"), collection = _get_str(raw, "collection"),
        event_type = _get_str(raw, "event_type"), rule_tag = _get_str(raw, "rule_tag"), params = _get_raw(raw, "params"),
        raw = raw
    }
end

func _model_json(m: ConversationModel): str:
    mut o := Vector {} as Vector<str>
    if m.id.len() > 0: o.push(json.Member("id", m.id)) end
    if m.model_name.len() > 0: o.push(json.Member("model_name", m.model_name)) end
    if m.api_key.len() > 0: o.push(json.Member("api_key", m.api_key)) end
    if m.history_collection.len() > 0: o.push(json.Member("history_collection", m.history_collection)) end
    if m.system_prompt.len() > 0: o.push(json.Member("system_prompt", m.system_prompt)) end
    if m.max_bytes > 0: o.push(json.MemberInt("max_bytes", m.max_bytes as i64)) end
    if m.ttl > 0: o.push(json.MemberInt("ttl", m.ttl as i64)) end
    if m.account_id.len() > 0: o.push(json.Member("account_id", m.account_id)) end
    if m.vllm_url.len() > 0: o.push(json.Member("vllm_url", m.vllm_url)) end
    ret _object_with(o, m.extra)
end

@en "AnalyticsRuleJSON"
@fa "جیسون قاعده تحلیل"
pub func AnalyticsRuleJSON(r: AnalyticsRule): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("name", r.name))
    m.push(json.Member("type", r.kind))
    if r.collection.len() > 0: m.push(json.Member("collection", r.collection)) end
    if r.event_type.len() > 0: m.push(json.Member("event_type", r.event_type)) end
    if r.rule_tag.len() > 0: m.push(json.Member("rule_tag", r.rule_tag)) end
    if r.params.len() > 0: m.push(json.MemberRaw("params", r.params)) end
    ret json.Object(m)
end

@en "CreateAnalyticsRuleJSON"
@fa "ساخت قاعده تحلیل از جیسون"
pub func CreateAnalyticsRuleJSON(c: Client, rule: str, err &: Error): str:
    ret _call(c, "POST", "/analytics/rules", rule, err)
end

@en "UpsertAnalyticsRuleJSON"
@fa "درج قاعده تحلیل از جیسون"
pub func UpsertAnalyticsRuleJSON(c: Client, name: str, rule: str, err &: Error): str:
    ret _call(c, "PUT", "/analytics/rules/" + _esc(name), rule, err)
end

@en "CreateAnalyticsRule"
@fa "ساخت قاعده تحلیل"
pub func CreateAnalyticsRule(c: Client, r: AnalyticsRule, err &: Error): AnalyticsRule:
    body := CreateAnalyticsRuleJSON(c, AnalyticsRuleJSON(r), err)
    if not _ts_ok(err): ret AnalyticsRule {} end
    ret _rule(body)
end

@en "UpsertAnalyticsRule"
@fa "درج قاعده تحلیل"
pub func UpsertAnalyticsRule(c: Client, r: AnalyticsRule, err &: Error): AnalyticsRule:
    body := UpsertAnalyticsRuleJSON(c, r.name, AnalyticsRuleJSON(r), err)
    if not _ts_ok(err): ret AnalyticsRule {} end
    ret _rule(body)
end

@en "GetAnalyticsRule"
@fa "دریافت قاعده تحلیل"
pub func GetAnalyticsRule(c: Client, name: str, err &: Error): AnalyticsRule:
    body := _call(c, "GET", "/analytics/rules/" + _esc(name), "", err)
    if not _ts_ok(err): ret AnalyticsRule {} end
    ret _rule(body)
end

@en "ListAnalyticsRules"
@fa "فهرست قاعده های تحلیل"
pub func ListAnalyticsRules(c: Client, rule_tag: str, err &: Error): Vector<AnalyticsRule>:
    mut q := ""
    if rule_tag.len() > 0: q = "?rule_tag=" + _esc(rule_tag) end
    body := _call(c, "GET", "/analytics/rules" + q, "", err)
    mut out := Vector {} as Vector<AnalyticsRule>
    if not _ts_ok(err): ret out end
    each item in _named_list(body, "rules"):
        out.push(_rule(item))
    end
    ret out
end

@en "DeleteAnalyticsRule"
@fa "حذف قاعده تحلیل"
pub func DeleteAnalyticsRule(c: Client, name: str, err &: Error): str:
    body := _call(c, "DELETE", "/analytics/rules/" + _esc(name), "", err)
    if not _ts_ok(err): ret "" end
    ret _get_str(body, "name")
end

@en "SendEventJSON"
@fa "ارسال رویداد از جیسون"
pub func SendEventJSON(c: Client, event: str, err &: Error): bool:
    body := _call(c, "POST", "/analytics/events", event, err)
    ret _ts_ok(err) and _get_bool(body, "ok")
end

@en "SendEvent"
@fa "ارسال رویداد"
pub func SendEvent(c: Client, name: str, event_type: str, data: str, err &: Error): bool:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("name", name))
    m.push(json.Member("event_type", event_type))
    m.push(json.MemberRaw("data", data))
    ret SendEventJSON(c, json.Object(m), err)
end

@en "GetEvents"
@fa "دریافت رویدادها"
pub func GetEvents(c: Client, user_id: str, name: str, n: int, err &: Error): Vector<str>:
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<str>
    keys.push("user_id")
    vals.push(user_id)
    keys.push("name")
    vals.push(name)
    keys.push("n")
    vals.push(str.FromInt(n as i64))
    body := _call(c, "GET", "/analytics/events" + _query(keys, vals), "", err)
    ret _named_list(body, "events")
end

@en "FlushAnalytics"
@fa "تخلیه تحلیل"
pub func FlushAnalytics(c: Client, err &: Error): bool:
    body := _call(c, "POST", "/analytics/flush", "", err)
    ret _ts_ok(err) and _get_bool(body, "ok")
end

@en "AnalyticsStatus"
@fa "وضعیت تحلیل"
pub func AnalyticsStatus(c: Client, err &: Error): str:
    ret _call(c, "GET", "/analytics/status", "", err)
end

@en "ConversationModelJSON"
@fa "جیسون مدل گفتگو"
pub func ConversationModelJSON(m: ConversationModel): str:
    ret _model_json(m)
end

@en "CreateConversationModel"
@fa "ساخت مدل گفتگو"
pub func CreateConversationModel(c: Client, m: ConversationModel, err &: Error): str:
