package typesense

@en "RULE_POPULAR_QUERIES"
@fa "قاعده پرسمان های پرطرفدار"
pub const RULE_POPULAR_QUERIES := "popular_queries"

@en "RULE_NOHITS_QUERIES"
@fa "قاعده پرسمان های بی نتیجه"
pub const RULE_NOHITS_QUERIES := "nohits_queries"

@en "RULE_COUNTER"
@fa "قاعده شمارنده"
pub const RULE_COUNTER := "counter"

@en "RULE_LOG"
@fa "قاعده گزارش"
pub const RULE_LOG := "log"

