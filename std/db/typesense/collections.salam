package typesense

@en "TYPE_STRING"
@fa "نوع متن"
pub const TYPE_STRING := "string"

@en "TYPE_STRING_ARRAY"
@fa "نوع آرایه متن"
pub const TYPE_STRING_ARRAY := "string[]"

@en "TYPE_STRING_ANY"
@fa "نوع متن ستاره"
pub const TYPE_STRING_ANY := "string*"

@en "TYPE_INT32"
@fa "نوع عدد۳۲"
pub const TYPE_INT32 := "int32"

@en "TYPE_INT32_ARRAY"
@fa "نوع آرایه عدد۳۲"
pub const TYPE_INT32_ARRAY := "int32[]"

@en "TYPE_INT64"
@fa "نوع عدد۶۴"
pub const TYPE_INT64 := "int64"

@en "TYPE_INT64_ARRAY"
@fa "نوع آرایه عدد۶۴"
pub const TYPE_INT64_ARRAY := "int64[]"

@en "TYPE_FLOAT"
@fa "نوع اعشاری"
pub const TYPE_FLOAT := "float"

@en "TYPE_FLOAT_ARRAY"
@fa "نوع آرایه اعشاری"
pub const TYPE_FLOAT_ARRAY := "float[]"

@en "TYPE_BOOL"
@fa "نوع بولی"
pub const TYPE_BOOL := "bool"

@en "TYPE_BOOL_ARRAY"
@fa "نوع آرایه بولی"
pub const TYPE_BOOL_ARRAY := "bool[]"

@en "TYPE_GEOPOINT"
@fa "نوع نقطه جغرافیایی"
pub const TYPE_GEOPOINT := "geopoint"

@en "TYPE_GEOPOINT_ARRAY"
@fa "نوع آرایه نقطه جغرافیایی"
pub const TYPE_GEOPOINT_ARRAY := "geopoint[]"

@en "TYPE_GEOPOLYGON"
@fa "نوع چندضلعی جغرافیایی"
pub const TYPE_GEOPOLYGON := "geopolygon"

@en "TYPE_OBJECT"
@fa "نوع شیء"
pub const TYPE_OBJECT := "object"

@en "TYPE_OBJECT_ARRAY"
@fa "نوع آرایه شیء"
pub const TYPE_OBJECT_ARRAY := "object[]"

@en "TYPE_IMAGE"
@fa "نوع تصویر"
pub const TYPE_IMAGE := "image"

@en "TYPE_AUTO"
@fa "نوع خودکار"
pub const TYPE_AUTO := "auto"

@en "Field"
@fa "فیلد"
pub struct Field:
    pub name: str = ""
    pub kind: str = ""
    pub facet: bool = false
    pub optional: bool = false
    pub index: bool = true
    pub store: bool = true
    pub sort: int = 0
    pub infix: bool = false
    pub locale: str = ""
    pub stem: bool = false
    pub stem_dictionary: str = ""
    pub range_index: bool = false
    pub reference: str = ""
    pub async_reference: bool = false
    pub num_dim: int = 0
    pub vec_dist: str = ""
    pub embed: str = ""
    pub token_separators: Vector<str> = Vector {} as Vector<str>
    pub symbols_to_index: Vector<str> = Vector {} as Vector<str>
    pub truncate_len: int = 0
    pub drop: bool = false
    pub extra: str = ""
end

@en "Schema"
@fa "طرح"
pub struct Schema:
    pub name: str = ""
    pub fields: Vector<Field> = Vector {} as Vector<Field>
    pub default_sorting_field: str = ""
    pub enable_nested_fields: bool = false
    pub token_separators: Vector<str> = Vector {} as Vector<str>
    pub symbols_to_index: Vector<str> = Vector {} as Vector<str>
    pub synonym_sets: Vector<str> = Vector {} as Vector<str>
    pub curation_sets: Vector<str> = Vector {} as Vector<str>
    pub metadata: str = ""
    pub voice_query_model: str = ""
    pub extra: str = ""
end

@en "Collection"
@fa "مجموعه"
pub struct Collection:
    pub name: str = ""
    pub num_documents: i64 = 0
    pub created_at: i64 = 0
    pub default_sorting_field: str = ""
    pub enable_nested_fields: bool = false
    pub fields: Vector<Field> = Vector {} as Vector<Field>
    pub token_separators: Vector<str> = Vector {} as Vector<str>
    pub symbols_to_index: Vector<str> = Vector {} as Vector<str>
    pub synonym_sets: Vector<str> = Vector {} as Vector<str>
    pub curation_sets: Vector<str> = Vector {} as Vector<str>
    pub metadata: str = ""
    pub raw: str = ""
end

@en "Alias"
@fa "نام مستعار"
pub struct Alias:
    pub name: str = ""
    pub collection_name: str = ""
end

func _field(raw: str): Field:
    mut sort := 0
    s := json.Get(raw, "sort")
    if s == "true": sort = 1 end
    if s == "false": sort = 0 - 1 end
    ret Field {
        name = _get_str(raw, "name"), kind = _get_str(raw, "type"), facet = _get_bool(raw, "facet"),
        optional = _get_bool(raw, "optional"), index = json.Get(raw, "index") != "false",
        store = json.Get(raw, "store") != "false", sort = sort, infix = _get_bool(raw, "infix"),
        locale = _get_str(raw, "locale"), stem = _get_bool(raw, "stem"),
        stem_dictionary = _get_str(raw, "stem_dictionary"), range_index = _get_bool(raw, "range_index"),
        reference = _get_str(raw, "reference"), async_reference = _get_bool(raw, "async_reference"),
        num_dim = _get_i64(raw, "num_dim", 0 as i64) as int, vec_dist = _get_str(raw, "vec_dist"),
        embed = _get_raw(raw, "embed"), token_separators = _strings(_get_raw(raw, "token_separators")),
        symbols_to_index = _strings(_get_raw(raw, "symbols_to_index")),
        truncate_len = _get_i64(raw, "truncate_len", 0 as i64) as int, drop = _get_bool(raw, "drop")
    }
end

func _collection(raw: str): Collection:
    mut fields := Vector {} as Vector<Field>
    each item in _items(_get_raw(raw, "fields")):
        fields.push(_field(item))
    end
    ret Collection {
        name = _get_str(raw, "name"), num_documents = _get_i64(raw, "num_documents", 0 as i64),
        created_at = _get_i64(raw, "created_at", 0 as i64), default_sorting_field = _get_str(raw, "default_sorting_field"),
        enable_nested_fields = _get_bool(raw, "enable_nested_fields"), fields = fields,
        token_separators = _strings(_get_raw(raw, "token_separators")),
        symbols_to_index = _strings(_get_raw(raw, "symbols_to_index")),
        synonym_sets = _strings(_get_raw(raw, "synonym_sets")), curation_sets = _strings(_get_raw(raw, "curation_sets")),
        metadata = _get_raw(raw, "metadata"), raw = raw
    }
end

func _alias(raw: str): Alias:
    ret Alias { name = _get_str(raw, "name"), collection_name = _get_str(raw, "collection_name") }
end

func _fields_json(fields: Vector<Field>): str:
    mut items := Vector {} as Vector<str>
    each f in fields:
        items.push(FieldJSON(f))
    end
    ret json.Array(items)
end

@en "NewField"
@fa "فیلد جدید"
pub func NewField(name: str, kind: str): Field:
    ret Field { name = name, kind = kind }
end

@en "FacetField"
@fa "فیلد دسته بندی"
pub func FacetField(name: str, kind: str): Field:
    ret Field { name = name, kind = kind, facet = true }
end

@en "VectorField"
@fa "فیلد بردار"
pub func VectorField(name: str, num_dim: int): Field:
    ret Field { name = name, kind = TYPE_FLOAT_ARRAY, num_dim = num_dim }
end

@en "EmbeddingField"
@fa "فیلد جاسازی"
pub func EmbeddingField(name: str, from: Vector<str>, model_name: str): Field:
    mut model := Vector {} as Vector<str>
    model.push(json.Member("model_name", model_name))
    mut embed := Vector {} as Vector<str>
    embed.push(json.MemberRaw("from", _strs_json(from)))
    embed.push(json.MemberRaw("model_config", json.Object(model)))
    ret Field { name = name, kind = TYPE_FLOAT_ARRAY, embed = json.Object(embed) }
end

@en "FieldJSON"
@fa "جیسون فیلد"
pub func FieldJSON(f: Field): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("name", f.name))
    if f.drop:
        m.push(json.MemberBool("drop", true))
        ret _object_with(m, f.extra)
    end
    m.push(json.Member("type", f.kind))
    if f.facet: m.push(json.MemberBool("facet", true)) end
    if f.optional: m.push(json.MemberBool("optional", true)) end
    if not f.index: m.push(json.MemberBool("index", false)) end
    if not f.store: m.push(json.MemberBool("store", false)) end
    if f.sort > 0: m.push(json.MemberBool("sort", true)) end
    if f.sort < 0: m.push(json.MemberBool("sort", false)) end
    if f.infix: m.push(json.MemberBool("infix", true)) end
    if f.locale.len() > 0: m.push(json.Member("locale", f.locale)) end
    if f.stem: m.push(json.MemberBool("stem", true)) end
    if f.stem_dictionary.len() > 0: m.push(json.Member("stem_dictionary", f.stem_dictionary)) end
    if f.range_index: m.push(json.MemberBool("range_index", true)) end
    if f.reference.len() > 0: m.push(json.Member("reference", f.reference)) end
    if f.async_reference: m.push(json.MemberBool("async_reference", true)) end
    if f.num_dim > 0: m.push(json.MemberInt("num_dim", f.num_dim as i64)) end
    if f.vec_dist.len() > 0: m.push(json.Member("vec_dist", f.vec_dist)) end
    if f.embed.len() > 0: m.push(json.MemberRaw("embed", f.embed)) end
    if f.token_separators.len() > 0: m.push(json.MemberRaw("token_separators", _strs_json(f.token_separators))) end
    if f.symbols_to_index.len() > 0: m.push(json.MemberRaw("symbols_to_index", _strs_json(f.symbols_to_index))) end
    if f.truncate_len > 0: m.push(json.MemberInt("truncate_len", f.truncate_len as i64)) end
    ret _object_with(m, f.extra)
end

@en "SchemaJSON"
@fa "جیسون طرح"
pub func SchemaJSON(s: Schema): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("name", s.name))
    m.push(json.MemberRaw("fields", _fields_json(s.fields)))
    if s.default_sorting_field.len() > 0: m.push(json.Member("default_sorting_field", s.default_sorting_field)) end
    if s.enable_nested_fields: m.push(json.MemberBool("enable_nested_fields", true)) end
    if s.token_separators.len() > 0: m.push(json.MemberRaw("token_separators", _strs_json(s.token_separators))) end
    if s.symbols_to_index.len() > 0: m.push(json.MemberRaw("symbols_to_index", _strs_json(s.symbols_to_index))) end
    if s.synonym_sets.len() > 0: m.push(json.MemberRaw("synonym_sets", _strs_json(s.synonym_sets))) end
    if s.curation_sets.len() > 0: m.push(json.MemberRaw("curation_sets", _strs_json(s.curation_sets))) end
    if s.metadata.len() > 0: m.push(json.MemberRaw("metadata", s.metadata)) end
    if s.voice_query_model.len() > 0: m.push(json.MemberRaw("voice_query_model", s.voice_query_model)) end
    ret _object_with(m, s.extra)
end

@en "CreateCollection"
@fa "ساخت مجموعه"
pub func CreateCollection(c: Client, schema: Schema, err &: Error): Collection:
    ret CreateCollectionJSON(c, SchemaJSON(schema), err)
end

@en "CreateCollectionJSON"
@fa "ساخت مجموعه از جیسون"
pub func CreateCollectionJSON(c: Client, schema: str, err &: Error): Collection:
    body := _call(c, "POST", "/collections", schema, err)
    if not _ts_ok(err): ret Collection {} end
    ret _collection(body)
end

@en "CloneCollection"
@fa "رونوشت مجموعه"
pub func CloneCollection(c: Client, source: str, name: str, err &: Error): Collection:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("name", name))
    body := _call(c, "POST", "/collections?src_name=" + _esc(source), json.Object(m), err)
    if not _ts_ok(err): ret Collection {} end
    ret _collection(body)
end

@en "GetCollection"
@fa "دریافت مجموعه"
pub func GetCollection(c: Client, name: str, err &: Error): Collection:
    body := _call(c, "GET", _cpath(name), "", err)
    if not _ts_ok(err): ret Collection {} end
    ret _collection(body)
end

@en "CollectionExists"
@fa "مجموعه وجود دارد"
pub func CollectionExists(c: Client, name: str, err &: Error): bool:
    _call(c, "GET", _cpath(name), "", err)
    if IsNotFound(err):
        _clear(err)
        ret false
    end
    ret _ts_ok(err)
end

@en "ListCollections"
@fa "فهرست مجموعه ها"
pub func ListCollections(c: Client, err &: Error): Vector<Collection>:
    ret ListCollectionsPage(c, 0, 0, Vector {} as Vector<str>, err)
end

@en "ListCollectionsPage"
@fa "صفحه مجموعه ها"
pub func ListCollectionsPage(c: Client, offset: int, limit: int, exclude_fields: Vector<str>, err &: Error): Vector<Collection>:
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<str>
    if offset > 0:
        keys.push("offset")
        vals.push(str.FromInt(offset as i64))
    end
    if limit > 0:
        keys.push("limit")
        vals.push(str.FromInt(limit as i64))
    end
    if exclude_fields.len() > 0:
        keys.push("exclude_fields")
        vals.push(str.Join(exclude_fields, ","))
    end
    body := _call(c, "GET", "/collections" + _query(keys, vals), "", err)
    mut out := Vector {} as Vector<Collection>
    if not _ts_ok(err): ret out end
    each item in _items(body):
        out.push(_collection(item))
    end
    ret out
end

@en "UpdateCollection"
@fa "به‌روزرسانی مجموعه"
pub func UpdateCollection(c: Client, name: str, changes: str, err &: Error): str:
    ret _call(c, "PATCH", _cpath(name), changes, err)
end

@en "AddFields"
@fa "افزودن فیلدها"
pub func AddFields(c: Client, name: str, fields: Vector<Field>, err &: Error): str:
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("fields", _fields_json(fields)))
    ret UpdateCollection(c, name, json.Object(m), err)
end

@en "DropFields"
@fa "حذف فیلدها"
pub func DropFields(c: Client, name: str, fields: Vector<str>, err &: Error): str:
    mut dropped := Vector {} as Vector<Field>
    each f in fields:
        dropped.push(Field { name = f, drop = true })
    end
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("fields", _fields_json(dropped)))
    ret UpdateCollection(c, name, json.Object(m), err)
end

@en "SetCollectionMetadata"
@fa "تنظیم فراداده مجموعه"
pub func SetCollectionMetadata(c: Client, name: str, metadata: str, err &: Error): str:
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("metadata", metadata))
    ret UpdateCollection(c, name, json.Object(m), err)
end

@en "DeleteCollection"
@fa "حذف مجموعه"
pub func DeleteCollection(c: Client, name: str, err &: Error): Collection:
    body := _call(c, "DELETE", _cpath(name), "", err)
    if not _ts_ok(err): ret Collection {} end
    ret _collection(body)
end

@en "TruncateCollection"
@fa "خالی کردن مجموعه"
pub func TruncateCollection(c: Client, name: str, err &: Error): i64:
    body := _call(c, "DELETE", _cpath(name) + "/documents?truncate=true", "", err)
    if not _ts_ok(err): ret 0 end
    ret _get_i64(body, "num_deleted", 0 as i64)
end

@en "UpsertAlias"
@fa "درج نام مستعار"
pub func UpsertAlias(c: Client, name: str, collection: str, err &: Error): Alias:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("collection_name", collection))
    body := _call(c, "PUT", "/aliases/" + _esc(name), json.Object(m), err)
    if not _ts_ok(err): ret Alias {} end
    ret _alias(body)
end

@en "GetAlias"
@fa "دریافت نام مستعار"
pub func GetAlias(c: Client, name: str, err &: Error): Alias:
    body := _call(c, "GET", "/aliases/" + _esc(name), "", err)
    if not _ts_ok(err): ret Alias {} end
    ret _alias(body)
end

@en "ListAliases"
@fa "فهرست نام های مستعار"
pub func ListAliases(c: Client, err &: Error): Vector<Alias>:
    body := _call(c, "GET", "/aliases", "", err)
    mut out := Vector {} as Vector<Alias>
    if not _ts_ok(err): ret out end
    each item in _items(_get_raw(body, "aliases")):
        out.push(_alias(item))
    end
    ret out
end

@en "DeleteAlias"
@fa "حذف نام مستعار"
pub func DeleteAlias(c: Client, name: str, err &: Error): Alias:
    body := _call(c, "DELETE", "/aliases/" + _esc(name), "", err)
    if not _ts_ok(err): ret Alias {} end
    ret _alias(body)
end
