@en "ImportStemmingJSONL"
@fa "درون ریزی ریشه یابی جیسون خطی"
pub func ImportStemmingJSONL(c: Client, id: str, jsonl: str, err &: Error): bool:
    _ := _send(c, "POST", "/stemming/dictionaries/import?id=" + _esc(id), "text/plain", jsonl, err)
    ret _ts_ok(err)
end

@en "ImportStemmingDictionary"
@fa "درون ریزی واژه نامه ریشه یابی"
pub func ImportStemmingDictionary(c: Client, id: str, words: Vector<StemWord>, err &: Error): bool:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat words.len() in i:
        w := words.get(i)
        mut m := Vector {} as Vector<str>
        m.push(json.Member("word", w.word))
        m.push(json.Member("root", w.root))
        if i > 0: str.BufAppend(sb, "\n") end
        str.BufAppend(sb, json.Minify(json.Object(m)))
    end
    ret ImportStemmingJSONL(c, id, str.BufStr(sb), err)
end

@en "GetStemmingDictionary"
@fa "دریافت واژه نامه ریشه یابی"
pub func GetStemmingDictionary(c: Client, id: str, err &: Error): StemmingDictionary:
    body := _call(c, "GET", "/stemming/dictionaries/" + _esc(id), "", err)
    if not _ts_ok(err): ret StemmingDictionary {} end
    mut words := Vector {} as Vector<StemWord>
    each item in _items(_get_raw(body, "words")):
        words.push(StemWord { word = _get_str(item, "word"), root = _get_str(item, "root") })
    end
    ret StemmingDictionary { id = _get_str(body, "id"), words = words }
end

