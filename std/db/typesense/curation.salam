@en "DeleteStemmingDictionary"
@fa "حذف واژه نامه ریشه یابی"
pub func DeleteStemmingDictionary(c: Client, id: str, err &: Error): str:
    body := _call(c, "DELETE", "/stemming/dictionaries/" + _esc(id), "", err)
    if not _ts_ok(err): ret "" end
    ret _get_str(body, "id")
end
