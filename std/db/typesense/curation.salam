package typesense

@en "MATCH_EXACT"
@fa "تطابق دقیق"
pub const MATCH_EXACT := "exact"

@en "MATCH_CONTAINS"
@fa "تطابق شامل"
pub const MATCH_CONTAINS := "contains"

@en "Synonym"
@fa "مترادف"
pub struct Synonym:
    pub id: str = ""
    pub synonyms: Vector<str> = Vector {} as Vector<str>
    pub root: str = ""
    pub locale: str = ""
    pub symbols_to_index: Vector<str> = Vector {} as Vector<str>
end

@en "SynonymSet"
@fa "دسته مترادف"
pub struct SynonymSet:
    pub name: str = ""
    pub items: Vector<Synonym> = Vector {} as Vector<Synonym>
end

@en "Pin"
@fa "سنجاق"
pub struct Pin:
    pub id: str = ""
    pub position: int = 0
end

@en "CurationRule"
@fa "قاعده گزینش"
pub struct CurationRule:
    pub id: str = ""
    pub query: str = ""
    pub match_type: str = ""
    pub rule_filter_by: str = ""
    pub tags: Vector<str> = Vector {} as Vector<str>
    pub includes: Vector<Pin> = Vector {} as Vector<Pin>
    pub excludes: Vector<str> = Vector {} as Vector<str>
    pub filter_by: str = ""
    pub sort_by: str = ""
    pub replace_query: str = ""
    pub remove_matched_tokens: bool = false
    pub filter_curated_hits: bool = false
    pub stop_processing: bool = true
    pub effective_from_ts: i64 = 0
    pub effective_to_ts: i64 = 0
    pub metadata: str = ""
    pub extra: str = ""
end

@en "CurationSet"
@fa "دسته گزینش"
pub struct CurationSet:
    pub name: str = ""
    pub items: Vector<CurationRule> = Vector {} as Vector<CurationRule>
end

@en "Preset"
@fa "پیش تنظیم"
pub struct Preset:
    pub name: str = ""
    pub value: str = ""
end

@en "Stopwords"
@fa "کلمات توقف"
pub struct Stopwords:
    pub id: str = ""
    pub stopwords: Vector<str> = Vector {} as Vector<str>
    pub locale: str = ""
end

@en "StemWord"
@fa "ریشه کلمه"
pub struct StemWord:
    pub word: str = ""
    pub root: str = ""
end

@en "StemmingDictionary"
@fa "واژه نامه ریشه یابی"
pub struct StemmingDictionary:
    pub id: str = ""
    pub words: Vector<StemWord> = Vector {} as Vector<StemWord>
end

func _synonym(raw: str): Synonym:
    ret Synonym {
        id = _get_str(raw, "id"), synonyms = _strings(_get_raw(raw, "synonyms")), root = _get_str(raw, "root"),
        locale = _get_str(raw, "locale"), symbols_to_index = _strings(_get_raw(raw, "symbols_to_index"))
    }
end

func _synonyms(raw: str): Vector<Synonym>:
    mut out := Vector {} as Vector<Synonym>
    each item in _items(raw):
        out.push(_synonym(item))
    end
    ret out
end

func _synonym_set(raw: str): SynonymSet:
    ret SynonymSet { name = _get_str(raw, "name"), items = _synonyms(_get_raw(raw, "items")) }
end

func _synonym_body(s: Synonym, with_id: bool): str:
    mut m := Vector {} as Vector<str>
    if with_id and s.id.len() > 0: m.push(json.Member("id", s.id)) end
    m.push(json.MemberRaw("synonyms", _strs_json(s.synonyms)))
    if s.root.len() > 0: m.push(json.Member("root", s.root)) end
    if s.locale.len() > 0: m.push(json.Member("locale", s.locale)) end
    if s.symbols_to_index.len() > 0: m.push(json.MemberRaw("symbols_to_index", _strs_json(s.symbols_to_index))) end
    ret json.Object(m)
end

func _curation(raw: str): CurationRule:
    rule := _get_raw(raw, "rule")
    mut includes := Vector {} as Vector<Pin>
    each item in _items(_get_raw(raw, "includes")):
        includes.push(Pin { id = _get_str(item, "id"), position = _get_i64(item, "position", 0 as i64) as int })
    end
    mut excludes := Vector {} as Vector<str>
    each item in _items(_get_raw(raw, "excludes")):
        excludes.push(_get_str(item, "id"))
    end
    ret CurationRule {
        id = _get_str(raw, "id"), query = _get_str(rule, "query"), match_type = _get_str(rule, "match"),
        rule_filter_by = _get_str(rule, "filter_by"), tags = _strings(_get_raw(rule, "tags")), includes = includes,
        excludes = excludes, filter_by = _get_str(raw, "filter_by"), sort_by = _get_str(raw, "sort_by"),
        replace_query = _get_str(raw, "replace_query"), remove_matched_tokens = _get_bool(raw, "remove_matched_tokens"),
        filter_curated_hits = _get_bool(raw, "filter_curated_hits"), stop_processing = json.Get(raw, "stop_processing") != "false",
        effective_from_ts = _get_i64(raw, "effective_from_ts", 0 as i64), effective_to_ts = _get_i64(raw, "effective_to_ts", 0 as i64),
        metadata = _get_raw(raw, "metadata")
    }
end

func _curations(raw: str): Vector<CurationRule>:
    mut out := Vector {} as Vector<CurationRule>
    each item in _items(raw):
        out.push(_curation(item))
    end
    ret out
end

func _curation_set(raw: str): CurationSet:
    ret CurationSet { name = _get_str(raw, "name"), items = _curations(_get_raw(raw, "items")) }
end

func _stopwords(raw: str): Stopwords:
    ret Stopwords { id = _get_str(raw, "id"), stopwords = _strings(_get_raw(raw, "stopwords")), locale = _get_str(raw, "locale") }
end

func _named_list(body: str, key: str): Vector<str>:
    if _starts_with_byte(body, 91): ret _items(body) end
    ret _items(_get_raw(body, key))
end

@en "SynonymJSON"
@fa "جیسون مترادف"
pub func SynonymJSON(s: Synonym): str:
    ret _synonym_body(s, true)
end

@en "CurationJSON"
@fa "جیسون گزینش"
pub func CurationJSON(r: CurationRule): str:
    mut rule := Vector {} as Vector<str>
    if r.query.len() > 0: rule.push(json.Member("query", r.query)) end
    if r.match_type.len() > 0: rule.push(json.Member("match", r.match_type)) end
    if r.rule_filter_by.len() > 0: rule.push(json.Member("filter_by", r.rule_filter_by)) end
    if r.tags.len() > 0: rule.push(json.MemberRaw("tags", _strs_json(r.tags))) end
    mut m := Vector {} as Vector<str>
    if r.id.len() > 0: m.push(json.Member("id", r.id)) end
    m.push(json.MemberRaw("rule", json.Object(rule)))
    if r.includes.len() > 0:
        mut pins := Vector {} as Vector<str>
        each p in r.includes:
            mut pm := Vector {} as Vector<str>
            pm.push(json.Member("id", p.id))
            pm.push(json.MemberInt("position", p.position as i64))
            pins.push(json.Object(pm))
        end
        m.push(json.MemberRaw("includes", json.Array(pins)))
    end
    if r.excludes.len() > 0:
        mut ex := Vector {} as Vector<str>
        each id in r.excludes:
            mut em := Vector {} as Vector<str>
            em.push(json.Member("id", id))
            ex.push(json.Object(em))
        end
        m.push(json.MemberRaw("excludes", json.Array(ex)))
    end
    if r.filter_by.len() > 0: m.push(json.Member("filter_by", r.filter_by)) end
    if r.sort_by.len() > 0: m.push(json.Member("sort_by", r.sort_by)) end
    if r.replace_query.len() > 0: m.push(json.Member("replace_query", r.replace_query)) end
    if r.remove_matched_tokens: m.push(json.MemberBool("remove_matched_tokens", true)) end
    if r.filter_curated_hits: m.push(json.MemberBool("filter_curated_hits", true)) end
    if not r.stop_processing: m.push(json.MemberBool("stop_processing", false)) end
    if r.effective_from_ts > 0: m.push(json.MemberInt("effective_from_ts", r.effective_from_ts)) end
    if r.effective_to_ts > 0: m.push(json.MemberInt("effective_to_ts", r.effective_to_ts)) end
    if r.metadata.len() > 0: m.push(json.MemberRaw("metadata", r.metadata)) end
    ret _object_with(m, r.extra)
end

@en "UpsertSynonymSet"
@fa "درج دسته مترادف"
pub func UpsertSynonymSet(c: Client, name: str, items: Vector<Synonym>, err &: Error): SynonymSet:
    mut list := Vector {} as Vector<str>
    each s in items:
        list.push(SynonymJSON(s))
    end
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("items", json.Array(list)))
    body := _call(c, "PUT", "/synonym_sets/" + _esc(name), json.Object(m), err)
    if not _ts_ok(err): ret SynonymSet {} end
    ret _synonym_set(body)
end

@en "GetSynonymSet"
@fa "دریافت دسته مترادف"
pub func GetSynonymSet(c: Client, name: str, err &: Error): SynonymSet:
    body := _call(c, "GET", "/synonym_sets/" + _esc(name), "", err)
    if not _ts_ok(err): ret SynonymSet {} end
    ret _synonym_set(body)
end

@en "ListSynonymSets"
@fa "فهرست دسته های مترادف"
pub func ListSynonymSets(c: Client, err &: Error): Vector<SynonymSet>:
    body := _call(c, "GET", "/synonym_sets", "", err)
    mut out := Vector {} as Vector<SynonymSet>
    if not _ts_ok(err): ret out end
    each item in _items(body):
        out.push(_synonym_set(item))
    end
    ret out
end

