@en "UpsertStopwords"
@fa "درج کلمات توقف"
pub func UpsertStopwords(c: Client, id: str, words: Vector<str>, locale: str, err &: Error): Stopwords:
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("stopwords", _strs_json(words)))
    if locale.len() > 0: m.push(json.Member("locale", locale)) end
    body := _call(c, "PUT", "/stopwords/" + _esc(id), json.Object(m), err)
    if not _ts_ok(err): ret Stopwords {} end
    ret _stopwords(body)
end

@en "GetStopwords"
@fa "دریافت کلمات توقف"
pub func GetStopwords(c: Client, id: str, err &: Error): Stopwords:
    body := _call(c, "GET", "/stopwords/" + _esc(id), "", err)
    if not _ts_ok(err): ret Stopwords {} end
    inner := _get_raw(body, "stopwords")
    if _starts_with_byte(inner, 123): ret _stopwords(inner) end
    ret _stopwords(body)
end

@en "ListStopwords"
