package typesense

@en "MAX_GET_QUERY"
@fa "بیشینه پرسمان دریافت"
pub const MAX_GET_QUERY := 4000

@en "SearchParams"
@fa "پارامترهای جستجو"
pub struct SearchParams:
    pub q: str = ""
    pub query_by: str = ""
    pub query_by_weights: str = ""
    pub text_match_type: str = ""
    pub prefix: str = ""
    pub infix: str = ""
    pub filter_by: str = ""
    pub sort_by: str = ""
    pub facet_by: str = ""
    pub facet_query: str = ""
    pub max_facet_values: int = 0
    pub group_by: str = ""
    pub group_limit: int = 0
    pub include_fields: str = ""
    pub exclude_fields: str = ""
    pub highlight_fields: str = ""
    pub highlight_full_fields: str = ""
    pub highlight_start_tag: str = ""
    pub highlight_end_tag: str = ""
    pub snippet_threshold: int = 0
    pub num_typos: str = ""
    pub typo_tokens_threshold: int = 0
    pub drop_tokens_threshold: int = 0
    pub page: int = 0
    pub per_page: int = 0
    pub offset: int = 0
    pub limit: int = 0
    pub pinned_hits: str = ""
    pub hidden_hits: str = ""
    pub override_tags: str = ""
    pub preset: str = ""
    pub vector_query: str = ""
    pub stopwords: str = ""
    pub exhaustive_search: bool = false
    pub search_cutoff_ms: int = 0
    pub use_cache: bool = false
    pub cache_ttl: int = 0
    pub conversation: bool = false
    pub conversation_id: str = ""
    pub conversation_model_id: str = ""
    pub nl_query: bool = false
    pub nl_model_id: str = ""
    pub keys: Vector<str> = Vector {} as Vector<str>
    pub values: Vector<str> = Vector {} as Vector<str>
end

@en "SearchRequest"
@fa "درخواست جستجو"
pub struct SearchRequest:
    pub collection: str = ""
    pub params: SearchParams = SearchParams {}
    pub api_key: str = ""
end

@en "Hit"
@fa "یافته"
pub struct Hit:
    pub document: str = ""
    pub text_match: i64 = 0
    pub highlight: str = ""
    pub highlights: str = ""
    pub text_match_info: str = ""
    pub geo_distance_meters: str = ""
    pub vector_distance: f64 = 0.0
    pub hybrid_search_info: str = ""
    pub curated: bool = false
    pub collection: str = ""
    pub search_index: int = 0
    pub raw: str = ""
end

@en "FacetCount"
@fa "شمار دسته"
pub struct FacetCount:
    pub value: str = ""
    pub count: i64 = 0
    pub highlighted: str = ""
end

@en "Facet"
@fa "دسته"
pub struct Facet:
    pub field_name: str = ""
    pub counts: Vector<FacetCount> = Vector {} as Vector<FacetCount>
    pub sampled: bool = false
    pub stats: str = ""
end

@en "Group"
@fa "گروه"
pub struct Group:
    pub key: Vector<str> = Vector {} as Vector<str>
    pub found: i64 = 0
    pub hits: Vector<Hit> = Vector {} as Vector<Hit>
end

@en "SearchResult"
@fa "نتیجه جستجو"
pub struct SearchResult:
    pub found: i64 = 0
    pub found_docs: i64 = 0
    pub out_of: i64 = 0
    pub page: int = 0
    pub search_time_ms: i64 = 0
    pub search_cutoff: bool = false
    pub hits: Vector<Hit> = Vector {} as Vector<Hit>
    pub groups: Vector<Group> = Vector {} as Vector<Group>
    pub facets: Vector<Facet> = Vector {} as Vector<Facet>
    pub request_params: str = ""
    pub conversation: str = ""
    pub parsed_nl_query: str = ""
    pub code: int = 0
    pub error: str = ""
    pub raw: str = ""
end

func _pair(keys &: Vector<str>, vals &: Vector<str>, raws &: Vector<bool>, key: str, value: str, raw: bool):
    keys.push(key)
    vals.push(value)
    raws.push(raw)
end

func _is_number(s: str): bool:
    l := str.ByteLen(s)
    if l == 0: ret false end
    bp := _bp(s)
    mut digits := 0
    repeat l in i:
        code := _ub(bp, i)
        if code >= 48 and code <= 57:
            digits += 1
        else code == 45:
            if i != 0: ret false end
        else code == 46:
            if digits == 0: ret false end
        else:
            ret false
        end
    end
    ret digits > 0
end

func _params(p: SearchParams, keys &: Vector<str>, vals &: Vector<str>, raws &: Vector<bool>):
    if p.q.len() > 0: _pair(keys, vals, raws, "q", p.q, false) end
    if p.query_by.len() > 0: _pair(keys, vals, raws, "query_by", p.query_by, false) end
    if p.query_by_weights.len() > 0: _pair(keys, vals, raws, "query_by_weights", p.query_by_weights, false) end
    if p.text_match_type.len() > 0: _pair(keys, vals, raws, "text_match_type", p.text_match_type, false) end
    if p.prefix.len() > 0: _pair(keys, vals, raws, "prefix", p.prefix, false) end
    if p.infix.len() > 0: _pair(keys, vals, raws, "infix", p.infix, false) end
    if p.filter_by.len() > 0: _pair(keys, vals, raws, "filter_by", p.filter_by, false) end
    if p.sort_by.len() > 0: _pair(keys, vals, raws, "sort_by", p.sort_by, false) end
    if p.facet_by.len() > 0: _pair(keys, vals, raws, "facet_by", p.facet_by, false) end
    if p.facet_query.len() > 0: _pair(keys, vals, raws, "facet_query", p.facet_query, false) end
    if p.max_facet_values > 0: _pair(keys, vals, raws, "max_facet_values", str.FromInt(p.max_facet_values as i64), true) end
    if p.group_by.len() > 0: _pair(keys, vals, raws, "group_by", p.group_by, false) end
    if p.group_limit > 0: _pair(keys, vals, raws, "group_limit", str.FromInt(p.group_limit as i64), true) end
    if p.include_fields.len() > 0: _pair(keys, vals, raws, "include_fields", p.include_fields, false) end
    if p.exclude_fields.len() > 0: _pair(keys, vals, raws, "exclude_fields", p.exclude_fields, false) end
    if p.highlight_fields.len() > 0: _pair(keys, vals, raws, "highlight_fields", p.highlight_fields, false) end
    if p.highlight_full_fields.len() > 0: _pair(keys, vals, raws, "highlight_full_fields", p.highlight_full_fields, false) end
    if p.highlight_start_tag.len() > 0: _pair(keys, vals, raws, "highlight_start_tag", p.highlight_start_tag, false) end
    if p.highlight_end_tag.len() > 0: _pair(keys, vals, raws, "highlight_end_tag", p.highlight_end_tag, false) end
    if p.snippet_threshold > 0: _pair(keys, vals, raws, "snippet_threshold", str.FromInt(p.snippet_threshold as i64), true) end
    if p.num_typos.len() > 0: _pair(keys, vals, raws, "num_typos", p.num_typos, false) end
    if p.typo_tokens_threshold > 0: _pair(keys, vals, raws, "typo_tokens_threshold", str.FromInt(p.typo_tokens_threshold as i64), true) end
    if p.drop_tokens_threshold > 0: _pair(keys, vals, raws, "drop_tokens_threshold", str.FromInt(p.drop_tokens_threshold as i64), true) end
    if p.page > 0: _pair(keys, vals, raws, "page", str.FromInt(p.page as i64), true) end
    if p.per_page > 0: _pair(keys, vals, raws, "per_page", str.FromInt(p.per_page as i64), true) end
    if p.offset > 0: _pair(keys, vals, raws, "offset", str.FromInt(p.offset as i64), true) end
    if p.limit > 0: _pair(keys, vals, raws, "limit", str.FromInt(p.limit as i64), true) end
    if p.pinned_hits.len() > 0: _pair(keys, vals, raws, "pinned_hits", p.pinned_hits, false) end
    if p.hidden_hits.len() > 0: _pair(keys, vals, raws, "hidden_hits", p.hidden_hits, false) end
    if p.override_tags.len() > 0: _pair(keys, vals, raws, "override_tags", p.override_tags, false) end
    if p.preset.len() > 0: _pair(keys, vals, raws, "preset", p.preset, false) end
    if p.vector_query.len() > 0: _pair(keys, vals, raws, "vector_query", p.vector_query, false) end
    if p.stopwords.len() > 0: _pair(keys, vals, raws, "stopwords", p.stopwords, false) end
    if p.exhaustive_search: _pair(keys, vals, raws, "exhaustive_search", "true", true) end
    if p.search_cutoff_ms > 0: _pair(keys, vals, raws, "search_cutoff_ms", str.FromInt(p.search_cutoff_ms as i64), true) end
    if p.use_cache: _pair(keys, vals, raws, "use_cache", "true", true) end
    if p.cache_ttl > 0: _pair(keys, vals, raws, "cache_ttl", str.FromInt(p.cache_ttl as i64), true) end
    if p.conversation: _pair(keys, vals, raws, "conversation", "true", true) end
    if p.conversation_id.len() > 0: _pair(keys, vals, raws, "conversation_id", p.conversation_id, false) end
    if p.conversation_model_id.len() > 0: _pair(keys, vals, raws, "conversation_model_id", p.conversation_model_id, false) end
    if p.nl_query: _pair(keys, vals, raws, "nl_query", "true", true) end
    if p.nl_model_id.len() > 0: _pair(keys, vals, raws, "nl_model_id", p.nl_model_id, false) end
    repeat p.keys.len() in i:
        v := p.values.get(i)
        _pair(keys, vals, raws, p.keys.get(i), v, v == "true" or v == "false" or _is_number(v))
    end
end

func _params_json(p: SearchParams, extra: Vector<str>): str:
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<str>
    mut raws := Vector {} as Vector<bool>
    _params(p, keys, vals, raws)
    mut m := Vector {} as Vector<str>
    each e in extra:
        m.push(e)
    end
    repeat keys.len() in i:
        if raws.get(i):
            m.push(json.MemberRaw(keys.get(i), vals.get(i)))
        else:
            m.push(json.Member(keys.get(i), vals.get(i)))
        end
    end
    ret json.Object(m)
end

func _hit(raw: str): Hit:
    ret Hit {
        document = _get_raw(raw, "document"), text_match = _get_i64(raw, "text_match", 0 as i64),
        highlight = _get_raw(raw, "highlight"), highlights = _get_raw(raw, "highlights"),
        text_match_info = _get_raw(raw, "text_match_info"), geo_distance_meters = _get_raw(raw, "geo_distance_meters"),
        vector_distance = _f64(json.Get(raw, "vector_distance")), hybrid_search_info = _get_raw(raw, "hybrid_search_info"),
        curated = _get_bool(raw, "curated"), collection = _get_str(raw, "collection"),
        search_index = _get_i64(raw, "search_index", 0 as i64) as int, raw = raw
    }
end

func _hits(raw: str): Vector<Hit>:
    mut out := Vector {} as Vector<Hit>
    each item in _items(raw):
        out.push(_hit(item))
    end
    ret out
end

func _facet(raw: str): Facet:
    mut counts := Vector {} as Vector<FacetCount>
    each item in _items(_get_raw(raw, "counts")):
        counts.push(FacetCount {
            value = _get_str(item, "value"), count = _get_i64(item, "count", 0 as i64), highlighted = _get_str(item, "highlighted")
        })
    end
    ret Facet {
        field_name = _get_str(raw, "field_name"), counts = counts, sampled = _get_bool(raw, "sampled"),
        stats = _get_raw(raw, "stats")
    }
end

func _search_get(c: Client, collection: str, p: SearchParams, err &: Error): str:
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<str>
    mut raws := Vector {} as Vector<bool>
    _params(p, keys, vals, raws)
    q := _query(keys, vals)
    if q.len() <= MAX_GET_QUERY:
        ret _call(c, "GET", _dpath(collection) + "/search" + q, "", err)
    end
    mut extra := Vector {} as Vector<str>
    extra.push(json.Member("collection", collection))
    mut searches := Vector {} as Vector<str>
    searches.push(_params_json(p, extra))
    mut body := Vector {} as Vector<str>
    body.push(json.MemberRaw("searches", json.Array(searches)))
    out := _call(c, "POST", "/multi_search", json.Object(body), err)
    if not _ts_ok(err): ret "" end
    results := _items(_get_raw(out, "results"))
    if results.len() == 0:
        _fail(err, 0, KIND_DECODE, "multi_search returned no result")
        ret ""
    end
    first := results.get(0)
    code := _get_i64(first, "code", 0 as i64) as int
    if code >= 400:
        _fail(err, code, KIND_HTTP, _get_str(first, "error"))
        ret ""
    end
    ret first
end

func _multi_body(searches: Vector<SearchRequest>, union: bool): str:
    mut items := Vector {} as Vector<str>
    each s in searches:
        mut extra := Vector {} as Vector<str>
        if s.collection.len() > 0: extra.push(json.Member("collection", s.collection)) end
        if s.api_key.len() > 0: extra.push(json.Member("x-typesense-api-key", s.api_key)) end
        items.push(_params_json(s.params, extra))
    end
    mut body := Vector {} as Vector<str>
    if union: body.push(json.MemberBool("union", true)) end
    body.push(json.MemberRaw("searches", json.Array(items)))
    ret json.Object(body)
end

func _common_query(common: SearchParams): str:
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<str>
    mut raws := Vector {} as Vector<bool>
    _params(common, keys, vals, raws)
    ret _query(keys, vals)
end

@en "NewSearch"
@fa "جستجوی جدید"
pub func NewSearch(q: str, query_by: str): SearchParams:
    ret SearchParams { q = q, query_by = query_by }
end

@en "Set"
@fa "تنظیم پارامتر"
pub func Set(p &: SearchParams, key: str, value: str):
    repeat p.keys.len() in i:
        if p.keys.get(i) == key:
            p.values.set(i, value)
            ret
        end
    end
    p.keys.push(key)
    p.values.push(value)
end

@en "SearchQuery"
@fa "متن پرسمان جستجو"
pub func SearchQuery(p: SearchParams): str:
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<str>
    mut raws := Vector {} as Vector<bool>
    _params(p, keys, vals, raws)
    q := _query(keys, vals)
    if q.len() == 0: ret "" end
    ret q.substr(1, q.len() - 1)
end

@en "SearchParamsJSON"
@fa "جیسون پارامترهای جستجو"
pub func SearchParamsJSON(p: SearchParams): str:
    ret _params_json(p, Vector {} as Vector<str>)
end

@en "ParseSearchResult"
@fa "تجزیه نتیجه جستجو"
pub func ParseSearchResult(body: str): SearchResult:
    mut groups := Vector {} as Vector<Group>
    each item in _items(_get_raw(body, "grouped_hits")):
        groups.push(Group {
            key = _strings(_get_raw(item, "group_key")), found = _get_i64(item, "found", 0 as i64),
            hits = _hits(_get_raw(item, "hits"))
        })
    end
    mut facets := Vector {} as Vector<Facet>
    each item in _items(_get_raw(body, "facet_counts")):
        facets.push(_facet(item))
    end
    ret SearchResult {
        found = _get_i64(body, "found", 0 as i64), found_docs = _get_i64(body, "found_docs", 0 as i64),
        out_of = _get_i64(body, "out_of", 0 as i64), page = _get_i64(body, "page", 0 as i64) as int,
        search_time_ms = _get_i64(body, "search_time_ms", 0 as i64), search_cutoff = _get_bool(body, "search_cutoff"),
        hits = _hits(_get_raw(body, "hits")), groups = groups, facets = facets,
        request_params = _get_raw(body, "request_params"), conversation = _get_raw(body, "conversation"),
        parsed_nl_query = _get_raw(body, "parsed_nl_query"), code = _get_i64(body, "code", 0 as i64) as int,
        error = _get_str(body, "error"), raw = body
    }
end

@en "SearchRaw"
@fa "جستجوی خام"
pub func SearchRaw(c: Client, collection: str, p: SearchParams, err &: Error): str:
    ret _search_get(c, collection, p, err)
end

@en "Search"
@fa "جستجو"
pub func Search(c: Client, collection: str, p: SearchParams, err &: Error): SearchResult:
    body := _search_get(c, collection, p, err)
    if not _ts_ok(err): ret SearchResult {} end
    ret ParseSearchResult(body)
end

@en "MultiSearchRaw"
@fa "جستجوی چندگانه خام"
pub func MultiSearchRaw(c: Client, searches: Vector<SearchRequest>, common: SearchParams, err &: Error): str:
    ret _call(c, "POST", "/multi_search" + _common_query(common), _multi_body(searches, false), err)
end

@en "MultiSearch"
@fa "جستجوی چندگانه"
pub func MultiSearch(c: Client, searches: Vector<SearchRequest>, common: SearchParams, err &: Error): Vector<SearchResult>:
    body := MultiSearchRaw(c, searches, common, err)
    mut out := Vector {} as Vector<SearchResult>
    if not _ts_ok(err): ret out end
    each item in _items(_get_raw(body, "results")):
        out.push(ParseSearchResult(item))
    end
    ret out
end

@en "UnionSearch"
@fa "جستجوی اجتماع"
pub func UnionSearch(c: Client, searches: Vector<SearchRequest>, common: SearchParams, err &: Error): SearchResult:
    body := _call(c, "POST", "/multi_search" + _common_query(common), _multi_body(searches, true), err)
    if not _ts_ok(err): ret SearchResult {} end
    ret ParseSearchResult(body)
end

@en "HitsAs"
@fa "یافته ها به نوع"
pub func HitsAs<T>(r: SearchResult, out &: Vector<T>, err &: Error): bool:
    each h in r.hits:
        mut v := T {}
        mut e := encerr.EncodingError {}
        if not json.UnmarshalLenient(h.document, v, e):
            _ts_decode_fail(e, err)
            ret false
        end
        out.push(v)
    end
    ret true
end

@en "Highlight"
@fa "برجسته"
pub func Highlight(h: Hit, field: str): str:
    f := _get_raw(h.highlight, field)
    if f.len() == 0: ret "" end
    if _starts_with_byte(f, 123):
        ret _get_str(f, "snippet")
    end
    mut parts := Vector {} as Vector<str>
    each item in _items(f):
        s := _get_str(item, "snippet")
        if s.len() > 0: parts.push(s) end
    end
    ret str.Join(parts, " ")
end

@en "FreeResult"
@fa "آزادسازی نتیجه"
pub func FreeResult(r &: SearchResult):
    each g in r.groups:
        mut hits := g.hits
        hits.free()
        mut key := g.key
        key.free()
    end
    each f in r.facets:
        mut counts := f.counts
        counts.free()
    end
    r.hits.free()
    r.groups.free()
    r.facets.free()
    r.hits = Vector {} as Vector<Hit>
    r.groups = Vector {} as Vector<Group>
    r.facets = Vector {} as Vector<Facet>
end
