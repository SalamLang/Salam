package decimal

import bigint

// Arithmetic.
//
// Add, Sub and Mul are exact and never consult a rounding mode: two decimals
// always have an exact decimal sum and product, and the scale that holds it is
// known in advance (the larger scale for a sum, the sum of scales for a
// product). Div is the exception -- 1/3 has no finite decimal form -- so it
// takes the result scale and the rounding mode as arguments. That asymmetry is
// deliberate and is the whole safety property of the type: you cannot lose a
// digit by accident, only by asking.

@en "Neg"
@fa "قرینه"
@ar "سالب"
pub func Neg(d: Dec): Dec: ret _adopt(bigint.Neg(d.unscaled), d.scale) end

@en "Abs"
@fa "قدرمطلق"
@ar "قيمة مطلقة"
pub func Abs(d: Dec): Dec: ret _adopt(bigint.Abs(d.unscaled), d.scale) end

// Exact. The result carries the larger of the two scales.
@en "Add"
@fa "جمع"
@ar "جمع"
pub func Add(a: Dec, b: Dec): Dec:
    mut s := a.scale
    if b.scale > s: s = b.scale end
    mut ax := _shift10(a.unscaled, s - a.scale)
    mut bx := _shift10(b.unscaled, s - b.scale)
    sum := bigint.Add(ax, bx)
    ax.free()
    bx.free()
    ret _adopt(sum, s)
end

// Exact. The result carries the larger of the two scales.
@en "Sub"
@fa "تفریق"
@ar "طرح"
pub func Sub(a: Dec, b: Dec): Dec:
    mut s := a.scale
    if b.scale > s: s = b.scale end
    mut ax := _shift10(a.unscaled, s - a.scale)
    mut bx := _shift10(b.unscaled, s - b.scale)
    diff := bigint.Sub(ax, bx)
    ax.free()
    bx.free()
    ret _adopt(diff, s)
end

// Exact. The result's scale is the sum of the operands' scales, so 0.05 * 0.05
// is 0.0025 at scale 4 rather than 0.00 at scale 2. Round it afterwards if a
// narrower scale is what you want to store.
@en "Mul"
@fa "ضرب"
@ar "ضرب"
pub func Mul(a: Dec, b: Dec): Dec:
    ret _adopt(bigint.Mul(a.unscaled, b.unscaled), a.scale + b.scale)
end

// a / b to exactly `scale` decimal places under `mode`. Division is the one
// operation that cannot be exact, so both arguments are required -- there is
// no default precision to be surprised by. A zero divisor yields zero.
@en "Div"
@fa "تقسیم"
@ar "قسمة"
pub func Div(a: Dec, b: Dec, scale: int, mode: Rounding): Dec:
    mut sc := scale
    if sc < 0: sc = 0 end
    // The quotient of the unscaled parts is off by 10^(a.scale - b.scale) from
    // the quotient of the values, and the answer wants 10^sc more digits.
    // Applying that power to whichever side needs it keeps both operands whole.
    k := sc + b.scale - a.scale
    mut num := a.unscaled.clone()
    mut den := b.unscaled.clone()
    if k >= 0:
        t := _shift10(num, k)
        num.free()
        num = t
    else:
        t := _shift10(den, 0 - k)
        den.free()
        den = t
    end
    q := _div_round(num, den, mode)
    num.free()
    den.free()
    ret _adopt(q, sc)
end

// a / b at `scale` places with banker's rounding, the money default.
@en "DivRound"
@fa "تقسیم گردشده"
@ar "قسمة مقربة"
pub func DivRound(a: Dec, b: Dec, scale: int): Dec:
    ret Div(a, b, scale, Rounding.HalfEven)
end

// d^n for n >= 0, exact: the scale is multiplied by n. A negative exponent
// gives zero, since its exact value generally has no finite decimal form.
@en "Pow"
@fa "توان"
@ar "أس"
pub func Pow(d: Dec, n: int): Dec:
    if n < 0: ret Dec {} end
    if n == 0: ret FromInt(1 as i64) end
    ret _adopt(bigint.Pow(d.unscaled, n), d.scale * n)
end

// ---------------------------------------------------------------------------
// Mixed operations with machine integers
// ---------------------------------------------------------------------------

// Exact: multiplying by a whole number cannot need more decimal places than
// the operand already has, so the scale is unchanged.
@en "MulInt"
@fa "ضرب صحیح"
@ar "ضرب صحيح"
pub func MulInt(d: Dec, v: i64): Dec:
    ret _adopt(bigint.MulInt(d.unscaled, v), d.scale)
end

@en "AddInt"
@fa "جمع صحیح"
@ar "جمع صحيح"
pub func AddInt(d: Dec, v: i64): Dec:
    mut b := FromInt(v)
    defer b.free()
    ret Add(d, b)
end

@en "SubInt"
@fa "تفریق صحیح"
@ar "طرح صحيح"
pub func SubInt(d: Dec, v: i64): Dec:
    mut b := FromInt(v)
    defer b.free()
    ret Sub(d, b)
end

@en "DivInt"
@fa "تقسیم صحیح"
@ar "قسمة صحيح"
pub func DivInt(d: Dec, v: i64, scale: int, mode: Rounding): Dec:
    mut b := FromInt(v)
    defer b.free()
    ret Div(d, b, scale, mode)
end

// pct percent of d, i.e. d * pct / 100, rounded to `scale` places with
// banker's rounding. Written out because a tax or discount line is the single
// most common decimal calculation there is, and doing it as a float is the
// single most common way to get one wrong.
@en "Percent"
@fa "درصد"
@ar "نسبة مئوية"
pub func Percent(d: Dec, pct: Dec, scale: int): Dec:
    mut p := Mul(d, pct)
    defer p.free()
    mut hundred := FromInt(100 as i64)
    defer hundred.free()
    ret Div(p, hundred, scale, Rounding.HalfEven)
end

// The sum of a list, exact, carrying the largest scale present. An empty list
// sums to zero at scale 0.
@en "Sum"
@fa "مجموع"
@ar "مجموع"
pub func Sum(items: Vector<Dec>): Dec:
    mut total := Dec {}
    repeat items.len() with i:
        next := Add(total, items.get(i))
        total.free()
        total = next
    end
    ret total
end
