package decimal

import bigint

@en "Neg"
@fa "قرینه"
@ar "سالب"
pub func Neg(d: Dec): Dec: ret _adopt(bigint.Neg(d.unscaled), d.scale) end

@en "Abs"
@fa "قدرمطلق"
@ar "قيمة مطلقة"
pub func Abs(d: Dec): Dec: ret _adopt(bigint.Abs(d.unscaled), d.scale) end

@en "Add"
@fa "جمع"
@ar "جمع"
pub func Add(a: Dec, b: Dec): Dec:
    mut s := a.scale
    if b.scale > s: s = b.scale end
    mut ax := _shift10(a.unscaled, s - a.scale)
    mut bx := _shift10(b.unscaled, s - b.scale)
    sum := bigint.Add(ax, bx)
    ax.free()
    bx.free()
    ret _adopt(sum, s)
end

@en "Sub"
@fa "تفریق"
@ar "طرح"
pub func Sub(a: Dec, b: Dec): Dec:
    mut s := a.scale
    if b.scale > s: s = b.scale end
    mut ax := _shift10(a.unscaled, s - a.scale)
    mut bx := _shift10(b.unscaled, s - b.scale)
    diff := bigint.Sub(ax, bx)
    ax.free()
    bx.free()
    ret _adopt(diff, s)
end

@en "Mul"
@fa "ضرب"
@ar "ضرب"
pub func Mul(a: Dec, b: Dec): Dec:
    ret _adopt(bigint.Mul(a.unscaled, b.unscaled), a.scale + b.scale)
end

@en "Div"
@fa "تقسیم"
@ar "قسمة"
pub func Div(a: Dec, b: Dec, scale: int, mode: Rounding): Dec:
    mut sc := scale
    if sc < 0: sc = 0 end
    k := sc + b.scale - a.scale
    mut num := a.unscaled.clone()
    mut den := b.unscaled.clone()
    if k >= 0:
        t := _shift10(num, k)
        num.free()
        num = t
    else:
        t := _shift10(den, 0 - k)
        den.free()
        den = t
    end
    q := _div_round(num, den, mode)
    num.free()
    den.free()
    ret _adopt(q, sc)
end

@en "DivRound"
@fa "تقسیم گردشده"
@ar "قسمة مقربة"
pub func DivRound(a: Dec, b: Dec, scale: int): Dec:
    ret Div(a, b, scale, Rounding.HalfEven)
end

@en "Pow"
@fa "توان"
@ar "أس"
pub func Pow(d: Dec, n: int): Dec:
    if n < 0: ret Dec {} end
    if n == 0: ret FromInt(1 as i64) end
    ret _adopt(bigint.Pow(d.unscaled, n), d.scale * n)
end

@en "MulInt"
@fa "ضرب صحیح"
@ar "ضرب صحيح"
pub func MulInt(d: Dec, v: i64): Dec:
    ret _adopt(bigint.MulInt(d.unscaled, v), d.scale)
end

@en "AddInt"
@fa "جمع صحیح"
@ar "جمع صحيح"
pub func AddInt(d: Dec, v: i64): Dec:
    mut b := FromInt(v)
    defer b.free()
    ret Add(d, b)
end

@en "SubInt"
@fa "تفریق صحیح"
@ar "طرح صحيح"
pub func SubInt(d: Dec, v: i64): Dec:
    mut b := FromInt(v)
    defer b.free()
    ret Sub(d, b)
end

@en "DivInt"
@fa "تقسیم صحیح"
@ar "قسمة صحيح"
pub func DivInt(d: Dec, v: i64, scale: int, mode: Rounding): Dec:
    mut b := FromInt(v)
    defer b.free()
    ret Div(d, b, scale, mode)
end

@en "Percent"
@fa "درصد"
@ar "نسبة مئوية"
pub func Percent(d: Dec, pct: Dec, scale: int): Dec:
    mut p := Mul(d, pct)
    defer p.free()
    mut hundred := FromInt(100 as i64)
    defer hundred.free()
    ret Div(p, hundred, scale, Rounding.HalfEven)
end

@en "Sum"
@fa "مجموع"
@ar "مجموع"
pub func Sum(items: Vector<Dec>): Dec:
    mut total := Dec {}
    repeat items.len() with i:
        next := Add(total, items.get(i))
        total.free()
        total = next
    end
    ret total
end
