package decimal

import bigint

func _ulp_parts(q: bigint.Int, extra: int, sc: int): Dec:
    if extra == 0: ret _adopt(q.clone(), sc) end
    mut one := bigint.FromInt(extra as i64)
    r := bigint.Add(q, one)
    one.free()
    ret _adopt(r, sc)
end

@en "Split"
@fa "تقسیم برابر"
@ar "تقسيم متساو"
pub func Split(total: Dec, n: int): Vector<Dec>:
    mut out := Vector {} as Vector<Dec>
    if n < 1: ret out end
    mut divisor := bigint.FromInt(n as i64)
    mut q := bigint.Int {}
    mut r := bigint.Int {}
    _ok := bigint.FloorDivMod(total.unscaled, divisor, q, r)
    divisor.free()
    extra := bigint.ToIntClamped(r) as int
    r.free()
    repeat n with i:
        mut bonus := 0
        if i < extra: bonus = 1 end
        out.push(_ulp_parts(q, bonus, total.scale))
    end
    q.free()
    ret out
end

@en "Allocate"
@fa "تخصیص نسبی"
@ar "توزيع نسبي"
pub func Allocate(total: Dec, ratios: Vector<i64>): Vector<Dec>:
    mut out := Vector {} as Vector<Dec>
    k := ratios.len()
    if k == 0: ret out end

    mut sum := bigint.Int {}
    mut negative_ratio := false
    repeat k with i:
        if ratios.get(i) < 0 as i64: negative_ratio = true end
        bigint.AddIntTo(sum, ratios.get(i))
    end
    if negative_ratio || sum.sign() <= 0:
        sum.free()
        ret out
    end

    mut shares := Vector {} as Vector<bigint.Int>
    mut given := bigint.Int {}
    repeat k with i:
        mut num := bigint.MulInt(total.unscaled, ratios.get(i))
        s := bigint.FloorDiv(num, sum)
        num.free()
        bigint.AddTo(given, s)
        shares.push(s)
    end
    sum.free()

    mut left := bigint.Sub(total.unscaled, given)
    given.free()
    extra := bigint.ToIntClamped(left) as int
    left.free()

    repeat k with i:
        mut bonus := 0
        if i < extra: bonus = 1 end
        out.push(_ulp_parts(shares.get(i), bonus, total.scale))
        mut s := shares.get(i)
        s.free()
    end
    shares.free()
    ret out
end

@en "FreeAll"
@fa "آزادسازی همه"
@ar "تحرير الكل"
pub func FreeAll(v &: Vector<Dec>):
    repeat v.len() with i:
        mut d := v.get(i)
        d.free()
    end
    v.free()
end
