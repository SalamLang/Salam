@en "decimal"
@fa "اعشاری"
package decimal

import bigint

@en "Rounding"
@fa "شیوه گردکردن"
pub enum Rounding:
    @en "Down"
    @fa "به سمت صفر"
    Down
    @en "Up"
    @fa "دور از صفر"
    Up
    @en "Floor"
    @fa "رو به پایین"
    Floor
    @en "Ceil"
    @fa "رو به بالا"
    Ceil
    @en "HalfUp"
    @fa "نیم رو به بالا"
    HalfUp
    @en "HalfDown"
    @fa "نیم رو به پایین"
    HalfDown
    @en "HalfEven"
    @fa "نیم به زوج"
    HalfEven
end

@en "Dec"
@fa "اعشاری"
pub struct Dec:
    @en "unscaled"
    @fa "مقدار بدون مقیاس"
    pub unscaled: bigint.Int = bigint.Int {}

    @en "scale"
    @fa "مقیاس"
    pub scale: int = 0

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.unscaled.Free() end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end

    @en "IsZero"
    @fa "صفر است"
    pub func IsZero(): bool: ret this.unscaled.is_zero() end

    @en "is_zero"
    @fa "صفر است"
    pub func is_zero(): bool: ret this.IsZero() end

    @en "Sign"
    @fa "علامت"
    pub func Sign(): int: ret this.unscaled.sign() end

    @en "sign"
    @fa "علامت"
    pub func sign(): int: ret this.Sign() end

    @en "Clone"
    @fa "همانند"
    pub func Clone(): Dec:
        mut r := Dec {}
        r.unscaled = this.unscaled.Clone()
        r.scale = this.scale
        ret r
    end

    @en "clone"
    @fa "همانند"
    pub func clone(): Dec: ret this.Clone() end

    @en "ToStr"
    @fa "به رشته"
    pub func ToStr(): str: ret ToStr(this[0]) end

    @en "to_str"
    @fa "به رشته"
    pub func to_str(): str: ret this.ToStr() end
end

func _adopt(u: bigint.Int, scale: int): Dec:
    mut d := Dec {}
    if scale < 0:
        mut p := bigint.Pow10(0 - scale)
        d.unscaled = bigint.Mul(u, p)
        p.Free()
        mut tmp := u
        tmp.Free()
        d.scale = 0
        ret d
    end
    d.unscaled = u
    d.scale = scale
    ret d
end

func _shift10(x: bigint.Int, k: int): bigint.Int:
    if k <= 0: ret x.Clone() end
    mut p := bigint.Pow10(k)
    r := bigint.Mul(x, p)
    p.Free()
    ret r
end

@en "Zero"
@fa "صفر"
pub func Zero(): Dec: ret Dec {} end

@en "FromInt"
@fa "از صحیح"
pub func FromInt(v: i64): Dec: ret _adopt(bigint.FromInt(v), 0) end

@en "FromScaled"
@fa "از مقیاس"
pub func FromScaled(unscaled: i64, scale: int): Dec:
    ret _adopt(bigint.FromInt(unscaled), scale)
end

@en "New"
@fa "جدید"
pub func New(unscaled: bigint.Int, scale: int): Dec:
    ret _adopt(unscaled.Clone(), scale)
end

@en "Clone"
@fa "همانند"
pub func Clone(d: Dec): Dec: ret d.Clone() end

@en "Free"
@fa "آزادسازی"
pub func Free(d &: Dec): d.unscaled.Free() end

@en "FromFloat"
@fa "از اعشاری ماشین"
pub func FromFloat(f: f64, scale: int): Dec:
    mut sc := scale
    if sc < 0: sc = 0 end
    mut scaled := f
    repeat sc: scaled *= 10.0 end
    if scaled < 0.0:
        scaled -= 0.5
    else:
        scaled += 0.5
    end
    ret _adopt(bigint.FromInt(scaled as i64), sc)
end

@en "IsZero"
@fa "صفر است"
pub func IsZero(d: Dec): bool: ret d.unscaled.is_zero() end

@en "Sign"
@fa "علامت"
pub func Sign(d: Dec): int: ret d.unscaled.sign() end

@en "IsNegative"
@fa "منفی است"
pub func IsNegative(d: Dec): bool: ret d.unscaled.sign() < 0 end

@en "Scale"
@fa "مقیاس"
pub func Scale(d: Dec): int: ret d.scale end

@en "Unscaled"
@fa "بی‌مقیاس"
pub func Unscaled(d: Dec): bigint.Int: ret d.unscaled.Clone() end

@en "Cmp"
@fa "مقایسه"
pub func Cmp(a: Dec, b: Dec): int:
    mut s := a.scale
    if b.scale > s: s = b.scale end
    mut ax := _shift10(a.unscaled, s - a.scale)
    mut bx := _shift10(b.unscaled, s - b.scale)
    c := bigint.Cmp(ax, bx)
    ax.Free()
    bx.Free()
    ret c
end

@en "Equals"
@fa "یکسان است"
pub func Equals(a: Dec, b: Dec): bool: ret Cmp(a, b) == 0 end

@en "Less"
@fa "کمتر است"
pub func Less(a: Dec, b: Dec): bool: ret Cmp(a, b) < 0 end

@en "Greater"
@fa "بیشتر است"
pub func Greater(a: Dec, b: Dec): bool: ret Cmp(a, b) > 0 end

@en "Min"
@fa "کمینه"
pub func Min(a: Dec, b: Dec): Dec:
    if Cmp(a, b) <= 0: ret a.Clone() end
    ret b.Clone()
end

@en "Max"
@fa "بیشینه"
pub func Max(a: Dec, b: Dec): Dec:
    if Cmp(a, b) >= 0: ret a.Clone() end
    ret b.Clone()
end
