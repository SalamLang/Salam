@en "desktop/bundle"
@fa "نصب ساز رومیزی"
package bundle

import archive
import compress
import desktop.pack
import filepath
import fs
import io
import mem
import os
import os.shell
import str

const USAGE := `Usage: salam bundle [dir] [--target=TRIPLE] [--format=a,b] [--output=DIR] [--backend=B]

Builds the app described by the [app] table of salam.toml into installable packages.

  --target=TRIPLE  Build for another system (default: this one)
  --format=a,b     tar, deb, rpm, appimage on Linux; zip, nsis on Windows;
                   app, tar, dmg on macOS (default: tar,deb / zip / app,tar)
  --output=DIR     Where the packages go (default: dist)
  --backend=NAME   Compiler backend (default: native for Windows and macOS)

salam.toml:

  [app]
  id = "com.example.notes"
  name = "Notes"
  version = "1.0.0"
  main = "main.salam"
  assets = "www"
  icon = "icon.png"
  description = "Take notes"
  publisher = "Example"
  category = "Utility"
`

const WINDOWS_MANIFEST := `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency><dependentAssembly><assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/></dependentAssembly></dependency>
  <application xmlns="urn:schemas-microsoft-com:asm.v3"><windowsSettings>
    <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
  </windowsSettings></application>
</assembly>
`

struct _Build:
    pub manifest: Manifest = Manifest {}
    pub project: str = ""
    pub output: str = ""
    pub work: str = ""
    pub target: str = ""
    pub os_name: str = ""
    pub arch: str = ""
    pub backend: str = ""
    pub salam: str = "salam"
    pub exe: str = ""
    pub pack: str = ""
    pub base: str = ""
end

@en "Manifest"
@fa "شناسنامه"
pub struct Manifest:
    @en "id"
    @fa "شناسه"
    pub id: str = ""
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "version"
    @fa "نگارش"
    pub version: str = "0.1.0"
    @en "main"
    @fa "ورودی"
    pub main: str = "main.salam"
    @en "assets"
    @fa "دارایی ها"
    pub assets: str = ""
    @en "icon"
    @fa "نماد"
    pub icon: str = ""
    @en "description"
    @fa "توضیح"
    pub description: str = ""
    @en "publisher"
    @fa "ناشر"
    pub publisher: str = ""
    @en "category"
    @fa "دسته"
    pub category: str = "Utility"
    @en "slug"
    @fa "نام کوتاه"
    pub slug: str = ""
end

func _say(text: str):
    println "bundle: " + text
end

func _fail(text: str): int:
    printerrln "bundle: " + text
    ret 1
end

func _unquote(value: str): str:
    t := str.Trim(value)
    n := str.Len(t)
    if n >= 2 and (t as u8*)[0] == (34 as u8) and (t as u8*)[n - 1] == (34 as u8):
        ret str.Substr(t, 1, n - 2)
    end
    ret t
end

func _slug(name: str): str:
    mut b := str.NewBuilder()
    lower := str.Lower(name)
    bytes := lower as u8*
    mut dash := false
    repeat str.Len(lower) in i:
        c := bytes[i] as int
        if (c >= 97 and c <= 122) or (c >= 48 and c <= 57):
            if dash and str.BufLen(b) > 0:
                str.BufAppendChar(b, 45)
            end
            dash = false
            str.BufAppendChar(b, c)
        else:
            dash = true
        end
    end
    out := str.BufStr(b)
    if out.len() == 0:
        ret str.Clone("app")
    end
    ret out
end

func _os_of(target: str): str:
    if target.len() == 0:
        if SALAM_OS_WINDOWS:
            ret "windows"
        else SALAM_OS_MAC:
            ret "macos"
        else:
            ret "linux"
        end
    end
    if str.Contains(target, "windows") or str.Contains(target, "mingw"):
        ret "windows"
    end
    if str.Contains(target, "apple") or str.Contains(target, "darwin") or str.Contains(target, "macos"):
        ret "macos"
    end
    ret "linux"
end

func _arch_of(target: str): str:
    mut source := target
    if target.len() == 0:
        source = SALAM_ARCH_ARM64 ? "aarch64" : (SALAM_ARCH_X86 ? "i686" : "x86_64")
    end
    if str.StartsWith(source, "aarch64") or str.StartsWith(source, "arm64"):
        ret "arm64"
    end
    if str.StartsWith(source, "i686") or str.StartsWith(source, "i386"):
        ret "x86"
    end
    ret "x64"
end

func _deb_arch(arch: str): str:
    if arch == "arm64":
        ret "arm64"
    else arch == "x86":
        ret "i386"
    end
    ret "amd64"
end

func _rpm_arch(arch: str): str:
    if arch == "arm64":
        ret "aarch64"
    else arch == "x86":
        ret "i686"
    end
    ret "x86_64"
end

func _on_path(tool: str): bool:
    folders := os.Env("PATH").split(SALAM_OS_WINDOWS ? ";" : ":")
    defer folders.free()
    each folder in folders:
        if folder.len() > 0:
            path := filepath.Join(folder, tool)
            if os.Exists(path) and not os.IsDir(path):
                ret true
            end
            if SALAM_OS_WINDOWS and os.Exists(path + ".exe"):
                ret true
            end
        end
    end
    ret false
end

func _write(path: str, text: str): bool:
    ret io.WriteFile(path, text) >= 0
end

func _read_bytes(path: str, size_out &: i64): void*:
    size_out = os.FileSize(path)
    if size_out < 0:
        ret null
    end
    ret pack.ReadRange(path, 0 as i64, size_out)
end

func _copy_file(from_path: str, to_path: str): bool:
    mut size := 0 as i64
    data := _read_bytes(from_path, size)
    if data == null:
        ret false
    end
    defer mem.Free(data)
    ret archive.WriteBinaryFile(to_path, data, size as int)
end

func _tar_add(files &: Vector<archive.TarFileInput>, name: str, data: void*, size: i64, mode: int):
    files.push(archive.TarFileInput { name = name, data_ptr = data, data_len = size as int, mode = mode })
end

func _tar_add_dir(files &: Vector<archive.TarFileInput>, name: str):
    files.push(archive.TarFileInput { name = name, is_dir = true })
end

func _tar_add_file(files &: Vector<archive.TarFileInput>, name: str, path: str, mode: int): bool:
    mut size := 0 as i64
    data := _read_bytes(path, size)
    if data == null:
        ret false
    end
    _tar_add(files, name, data, size, mode)
    ret true
end

func _tar_add_text(files &: Vector<archive.TarFileInput>, name: str, text: str, mode: int = 0):
    _tar_add(files, name, text as void*, str.Len(text) as i64, mode)
end

func _write_targz(files: Vector<archive.TarFileInput>, path: str): bool:
    tar := archive.TarCreate(files)
    packed := compress.GzipCompress(tar.data, tar.len)
    ret archive.WriteBinaryFileBuf(path, packed)
end

func _targz_bytes(files: Vector<archive.TarFileInput>): compress.ByteBuf:
    tar := archive.TarCreate(files)
    ret compress.GzipCompress(tar.data, tar.len)
end

func _ar_field(buf &: compress.ByteBuf, text: str, width: int):
    n := str.Len(text)
    compress.BufPushBytes(buf, text as void*, n)
    repeat width - n:
        compress.BufPush(buf, 32)
    end
end

func _ar_member(buf &: compress.ByteBuf, name: str, data: void*, size: int):
    _ar_field(buf, name, 16)
    _ar_field(buf, "0", 12)
    _ar_field(buf, "0", 6)
    _ar_field(buf, "0", 6)
    _ar_field(buf, "100644", 8)
    _ar_field(buf, str.FromInt(size as i64), 10)
    compress.BufPush(buf, 96)
    compress.BufPush(buf, 10)
    compress.BufPushBytes(buf, data, size)
    if size % 2 == 1:
        compress.BufPush(buf, 10)
    end
end

func _one_line(text: str): str:
    ret str.Replace(str.Replace(text, "\r", " "), "\n", " ")
end

func _desktop_entry(b: _Build, exec_path: str, icon_name: str): str:
    m := b.manifest
    mut out := "[Desktop Entry]\nType=Application\nName=" + _one_line(m.name) + "\nExec=" + exec_path + " %U\nIcon=" + icon_name
    if m.description.len() > 0:
        out = out + "\nComment=" + _one_line(m.description)
    end
    ret out + "\nCategories=" + m.category + ";\nTerminal=false\nStartupWMClass=" + m.id + "\n"
end

func _package_tar_linux(b: _Build): bool:
    mut files := Vector {} as Vector<archive.TarFileInput>
    defer files.free()
    _tar_add_dir(files, b.base + "/")
    if not _tar_add_file(files, b.base + "/" + b.manifest.slug, b.exe, 0o755):
        ret false
    end
    if b.manifest.icon.len() > 0:
        if not _tar_add_file(files, b.base + "/icon" + filepath.Ext(b.manifest.icon), b.manifest.icon, 0o644):
            ret false
        end
    end
    _tar_add_text(files, b.base + "/" + b.manifest.id + ".desktop", _desktop_entry(b, b.manifest.slug, "icon"))
    ret _write_targz(files, filepath.Join(b.output, b.base + ".tar.gz"))
end

func _package_deb(b: _Build): bool:
    m := b.manifest
    mut data := Vector {} as Vector<archive.TarFileInput>
    defer data.free()
    each dir in ["./", "./usr/", "./usr/bin/", "./usr/share/", "./usr/share/applications/"]:
        _tar_add_dir(data, dir)
    end
    if not _tar_add_file(data, "./usr/bin/" + m.slug, b.exe, 0o755):
        ret false
    end
    _tar_add_text(data, "./usr/share/applications/" + m.id + ".desktop", _desktop_entry(b, "/usr/bin/" + m.slug, m.id))
    if m.icon.len() > 0:
        each dir in ["./usr/share/icons/", "./usr/share/icons/hicolor/", "./usr/share/icons/hicolor/256x256/", "./usr/share/icons/hicolor/256x256/apps/"]:
            _tar_add_dir(data, dir)
        end
        if not _tar_add_file(data, "./usr/share/icons/hicolor/256x256/apps/" + m.id + ".png", m.icon, 0o644):
            ret false
        end
    end
    size_kb := os.FileSize(b.exe) / (1024 as i64) + (1 as i64)
    mut control := "Package: " + m.slug + "\nVersion: " + m.version + "\nArchitecture: " + _deb_arch(b.arch)
    control = control + "\nMaintainer: " + (m.publisher.len() > 0 ? m.publisher : m.name)
    control = control + "\nInstalled-Size: " + str.FromInt(size_kb) + "\nSection: utils\nPriority: optional"
    control = control + "\nDepends: libgtk-3-0t64 | libgtk-3-0, libwebkit2gtk-4.1-0, libsoup-3.0-0, libjavascriptcoregtk-4.1-0"
    control = control + "\nDescription: " + (m.description.len() > 0 ? m.description : m.name) + "\n"
    mut meta := Vector {} as Vector<archive.TarFileInput>
    defer meta.free()
    _tar_add_dir(meta, "./")
    _tar_add_text(meta, "./control", control)
    control_gz := _targz_bytes(meta)
    data_gz := _targz_bytes(data)
    mut out := compress.NewByteBuf()
    magic := "!<arch>\n"
    compress.BufPushBytes(out, magic as void*, 8)
    version_text := "2.0\n"
    _ar_member(out, "debian-binary", version_text as void*, 4)
    _ar_member(out, "control.tar.gz", control_gz.data, control_gz.len)
    _ar_member(out, "data.tar.gz", data_gz.data, data_gz.len)
    ret archive.WriteBinaryFileBuf(filepath.Join(b.output, m.slug + "_" + m.version + "_" + _deb_arch(b.arch) + ".deb"), out)
end

func _rpm_text(text: str): str:
    ret str.Replace(_one_line(text), "%", "%%")
end

func _package_rpm(b: _Build): bool:
    if not _on_path("rpmbuild"):
        _say("rpm needs rpmbuild, which is not installed")
        ret false
    end
    m := b.manifest
    root := filepath.Join(b.work, "rpm")
    _mk := os.MkdirAll(root)
    mut spec := "%global _build_id_links none\n%global __strip /bin/true\n%define debug_package %{nil}\nName: " + m.slug + "\nVersion: " + str.Replace(m.version, "-", "_") + "\nRelease: 1\nSummary: " + _rpm_text(m.description.len() > 0 ? m.description : m.name)
    spec = spec + "\nLicense: Proprietary\nBuildArch: " + _rpm_arch(b.arch) + "\nAutoReqProv: no\nRequires: gtk3, webkit2gtk4.1\n\n%description\n" + _rpm_text(m.description.len() > 0 ? m.description : m.name)
    spec = spec + "\n\n%install\nmkdir -p %{buildroot}/usr/bin %{buildroot}/usr/share/applications\ncp " + b.exe + " %{buildroot}/usr/bin/" + m.slug + "\ncp " + filepath.Join(b.work, m.id + ".desktop") + " %{buildroot}/usr/share/applications/\n\n%files\n/usr/bin/" + m.slug + "\n/usr/share/applications/" + m.id + ".desktop\n"
    if not _write(filepath.Join(b.work, m.id + ".desktop"), _desktop_entry(b, "/usr/bin/" + m.slug, m.id)):
        ret false
    end
    spec_path := filepath.Join(b.work, m.slug + ".spec")
    if not _write(spec_path, spec):
        ret false
    end
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push("-bb")
    args.push("--define")
    args.push("_topdir " + root)
    args.push("--define")
    args.push("_rpmdir " + b.output)
    args.push("--define")
    args.push("_build_name_fmt %%{NAME}-%%{VERSION}-%%{RELEASE}.%%{ARCH}.rpm")
    args.push(spec_path)
    ret shell.Run("rpmbuild", args).code == 0
end

func _package_appimage(b: _Build): bool:
    if not _on_path("appimagetool"):
        _say("appimage needs appimagetool, which is not installed")
        ret false
    end
    m := b.manifest
    dir := filepath.Join(b.work, m.slug + ".AppDir")
    _mk := os.MkdirAll(filepath.Join(dir, "usr/bin"))
    target_exe := filepath.Join(dir, "usr/bin/" + m.slug)
    if not _copy_file(b.exe, target_exe):
        ret false
    end
    _exec := fs.Chmod(target_exe, 0o755)
    run_path := filepath.Join(dir, "AppRun")
    if not _write(run_path, "#!/bin/sh\nexec \"$(dirname \"$0\")/usr/bin/" + m.slug + "\" \"$@\"\n"):
        ret false
    end
    _exec2 := fs.Chmod(run_path, 0o755)
    if not _write(filepath.Join(dir, m.id + ".desktop"), _desktop_entry(b, m.slug, m.id)):
        ret false
    end
    if m.icon.len() > 0:
        _ok := _copy_file(m.icon, filepath.Join(dir, m.id + ".png"))
    end
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push(dir)
    args.push(filepath.Join(b.output, b.base + ".AppImage"))
    ret shell.Run("appimagetool", args).code == 0
end

func _package_zip_windows(b: _Build): bool:
    mut files := Vector {} as Vector<archive.ZipFileInput>
    defer files.free()
    mut size := 0 as i64
    data := _read_bytes(b.exe, size)
    if data == null:
        ret false
    end
    files.push(archive.MakeZipFileInput(b.base + "/" + b.manifest.slug + ".exe", data, size as int, 8))
    ok := archive.ZipCreateFile(files, filepath.Join(b.output, b.base + ".zip"))
    mem.Free(data)
    ret ok
end

func _nsis(text: str): str:
    dollar := str.Replace(text, "$", "$$")
    ret str.Replace(dollar, "\"", "$\\\"")
end

func _package_nsis(b: _Build): bool:
    if not _on_path("makensis"):
        _say("nsis needs makensis, which is not installed")
        ret false
    end
    m := b.manifest
    name := _nsis(m.name)
    script := filepath.Join(b.work, "installer.nsi")
    mut text := "Unicode true\nName \"" + name + "\"\nOutFile \"" + filepath.Join(b.output, b.base + "-setup.exe") + "\"\nInstallDir \"$LOCALAPPDATA\\Programs\\" + name + "\"\nRequestExecutionLevel user\nPage directory\nPage instfiles\nUninstPage uninstConfirm\nUninstPage instfiles\nSection\nSetOutPath \"$INSTDIR\"\nFile \"/oname=" + m.slug + ".exe\" \"" + b.exe + "\"\n"
    text = text + "WriteUninstaller \"$INSTDIR\\uninstall.exe\"\nCreateShortcut \"$SMPROGRAMS\\" + name + ".lnk\" \"$INSTDIR\\" + m.slug + ".exe\"\nSectionEnd\nSection Uninstall\nDelete \"$SMPROGRAMS\\" + name + ".lnk\"\nDelete \"$INSTDIR\\" + m.slug + ".exe\"\nDelete \"$INSTDIR\\uninstall.exe\"\nRMDir \"$INSTDIR\"\nSectionEnd\n"
    if not _write(script, text):
        ret false
    end
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push(script)
    ret shell.Run("makensis", args).code == 0
end

func _icns_tag(width: int): str:
    if width >= 1024:
        ret "ic10"
    else width >= 512:
        ret "ic09"
    else width >= 256:
        ret "ic08"
    end
    ret "ic07"
end

func _png_to_icns(path: str, out_path: str): bool:
    mut size := 0 as i64
    data := _read_bytes(path, size)
    if data == null or size < 24:
        ret false
    end
    defer mem.Free(data)
    bytes := data as u8*
    width := ((bytes[18] as int) << 8) | (bytes[19] as int)
    mut out := compress.NewByteBuf()
    magic := "icns"
    compress.BufPushBytes(out, magic as void*, 4)
    _push_be32(out, (size + 16) as int)
    tag := _icns_tag(width)
    compress.BufPushBytes(out, tag as void*, 4)
    _push_be32(out, (size + 8) as int)
    compress.BufPushBytes(out, data, size as int)
    ret archive.WriteBinaryFileBuf(out_path, out)
end

func _push_be32(out &: compress.ByteBuf, value: int):
    compress.BufPush(out, (value >> 24) & 0xFF)
    compress.BufPush(out, (value >> 16) & 0xFF)
    compress.BufPush(out, (value >> 8) & 0xFF)
    compress.BufPush(out, value & 0xFF)
end

func _png_to_ico(path: str, out_path: str): bool:
    mut size := 0 as i64
    data := _read_bytes(path, size)
    if data == null or size < 24:
        ret false
    end
    defer mem.Free(data)
    bytes := data as u8*
    width := ((bytes[18] as int) << 8) | (bytes[19] as int)
    height := ((bytes[22] as int) << 8) | (bytes[23] as int)
    mut out := compress.NewByteBuf()
    archive.LEPut16(out, 0)
    archive.LEPut16(out, 1)
    archive.LEPut16(out, 1)
    compress.BufPush(out, width >= 256 ? 0 : width)
    compress.BufPush(out, height >= 256 ? 0 : height)
    compress.BufPush(out, 0)
    compress.BufPush(out, 0)
    archive.LEPut16(out, 1)
    archive.LEPut16(out, 32)
    archive.LEPut32(out, size as int)
    archive.LEPut32(out, 22)
    compress.BufPushBytes(out, data, size as int)
    ret archive.WriteBinaryFileBuf(out_path, out)
end

func _xml(text: str): str:
    amps := str.Replace(text, "&", "&amp;")
    opens := str.Replace(amps, "<", "&lt;")
    closes := str.Replace(opens, ">", "&gt;")
    ret str.Replace(closes, "\"", "&quot;")
end

func _info_plist(b: _Build, has_icon: bool): str:
    m := b.manifest
    mut out := `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>` + _xml(m.name) + `</string>
<key>CFBundleDisplayName</key><string>` + _xml(m.name) + `</string>
<key>CFBundleIdentifier</key><string>` + _xml(m.id) + `</string>
<key>CFBundleExecutable</key><string>` + _xml(m.slug) + `</string>
<key>CFBundleVersion</key><string>` + _xml(m.version) + `</string>
<key>CFBundleShortVersionString</key><string>` + _xml(m.version) + `</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>NSHighResolutionCapable</key><true/>
<key>LSMinimumSystemVersion</key><string>11.0</string>
`
    if has_icon:
        out = out + "<key>CFBundleIconFile</key><string>app.icns</string>\n"
    end
    ret out + "</dict></plist>\n"
end

func _mac_app_files(b: _Build, files &: Vector<archive.TarFileInput>): bool:
    m := b.manifest
    root := m.name + ".app/"
    each dir in ["", "Contents/", "Contents/MacOS/", "Contents/Resources/"]:
        _tar_add_dir(files, root + dir)
    end
    if not _tar_add_file(files, root + "Contents/MacOS/" + m.slug, b.exe, 0o755):
        ret false
    end
    if b.pack.len() > 0:
        if not _tar_add_file(files, root + "Contents/Resources/app.pack", b.pack, 0o644):
            ret false
        end
    end
    mut has_icon := false
    if m.icon.len() > 0:
        icns := filepath.Join(b.work, "app.icns")
        made := str.EndsWith(m.icon, ".icns") ? _copy_file(m.icon, icns) : _png_to_icns(m.icon, icns)
        if made:
            has_icon = _tar_add_file(files, root + "Contents/Resources/app.icns", icns, 0o644)
        end
    end
    _tar_add_text(files, root + "Contents/Info.plist", _info_plist(b, has_icon))
    ret true
end

func _package_tar_mac(b: _Build): bool:
    mut files := Vector {} as Vector<archive.TarFileInput>
    defer files.free()
    if not _mac_app_files(b, files):
        ret false
    end
    ret _write_targz(files, filepath.Join(b.output, b.base + ".tar.gz"))
end

func _package_app_dir(b: _Build): bool:
    mut files := Vector {} as Vector<archive.TarFileInput>
    defer files.free()
    if not _mac_app_files(b, files):
        ret false
    end
    tar := archive.TarCreate(files)
    if not archive.TarExtractAll(tar.data, tar.len, b.output):
        ret false
    end
    _exec := fs.Chmod(filepath.Join(b.output, b.manifest.name + ".app/Contents/MacOS/" + b.manifest.slug), 0o755)
    ret true
end

func _package_dmg(b: _Build): bool:
    if not _on_path("hdiutil"):
        _say("dmg needs hdiutil, which only exists on macOS")
        ret false
    end
    source := filepath.Join(b.work, "dmg")
    _mk := os.MkdirAll(source)
    mut files := Vector {} as Vector<archive.TarFileInput>
    defer files.free()
    if not _mac_app_files(b, files):
        ret false
    end
    tar := archive.TarCreate(files)
    if not archive.TarExtractAll(tar.data, tar.len, source):
        ret false
    end
    _exec := fs.Chmod(filepath.Join(source, b.manifest.name + ".app/Contents/MacOS/" + b.manifest.slug), 0o755)
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push("create")
    args.push("-volname")
    args.push(b.manifest.name)
    args.push("-srcfolder")
    args.push(source)
    args.push("-ov")
    args.push("-format")
    args.push("UDZO")
    args.push(filepath.Join(b.output, b.base + ".dmg"))
    ret shell.Run("hdiutil", args).code == 0
end

func _compile(b &: _Build): bool:
    m := b.manifest
    exe_name := b.os_name == "windows" ? m.slug + ".exe" : m.slug
    b.exe = filepath.Join(b.work, exe_name)
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push("build")
    args.push(filepath.Join(b.project, m.main))
    args.push("--release")
    args.push("--log-level=error")
    args.push("--output=" + b.exe)
    if b.target.len() > 0:
        args.push("--target=" + b.target)
    end
    backend := b.backend.len() > 0 ? b.backend : (b.os_name == "linux" ? "" : "native")
    if backend.len() > 0:
        args.push("--backend=" + backend)
    end
    if b.os_name == "windows":
        args.push("--subsystem=windows")
        manifest_path := filepath.Join(b.work, "app.manifest")
        if _write(manifest_path, WINDOWS_MANIFEST):
            args.push("--manifest=" + manifest_path)
        end
        args.push("--version-info=version=" + m.version)
        args.push("--version-info=product=" + m.name)
        if m.publisher.len() > 0:
            args.push("--version-info=company=" + m.publisher)
        end
        if m.description.len() > 0:
            args.push("--version-info=description=" + m.description)
        end
        if m.icon.len() > 0:
            ico := filepath.Join(b.work, "app.ico")
            made := str.EndsWith(m.icon, ".ico") ? _copy_file(m.icon, ico) : _png_to_ico(m.icon, ico)
            if made:
                args.push("--icon=" + ico)
            end
        end
    end
    here := os.Cwd()
    _moved := os.Chdir(b.work)
    result := shell.Run(b.salam, args)
    _back := os.Chdir(here)
    if result.code != 0:
        printerrln result.out
        printerrln result.err
        ret false
    end
    ret os.Exists(b.exe)
end

@en "ReadManifest"
@fa "خواندن شناسنامه"
pub func ReadManifest(path: str, out &: Manifest): bool:
    if not os.Exists(path):
        ret false
    end
    text := io.ReadFile(path)
    lines := str.Split(text, "\n")
    defer lines.free()
    mut inside := false
    mut seen := false
    each raw in lines:
        line := str.Trim(raw)
        if str.StartsWith(line, "["):
            inside = line == "[app]"
            seen = seen or inside
            continue
        end
        sign := str.IndexOf(line, "=")
        if not inside or sign <= 0 or str.StartsWith(line, "#"):
            continue
        end
        key := str.Trim(str.Substr(line, 0, sign))
        value := _unquote(str.Substr(line, sign + 1, str.Len(line) - sign - 1))
        if key == "id":
            out.id = value
        else key == "name":
            out.name = value
        else key == "version":
            out.version = value
        else key == "main":
            out.main = value
        else key == "assets":
            out.assets = value
        else key == "icon":
            out.icon = value
        else key == "description":
            out.description = value
        else key == "publisher":
            out.publisher = value
        else key == "category":
            out.category = value
        end
    end
    if out.name.len() == 0:
        out.name = out.id
    end
    out.slug = _slug(out.name)
    ret seen
end

@en "Main"
@fa "اجرا"
pub func Main(args: Vector<str>): int:
    mut project := ""
    mut target := ""
    mut backend := ""
    mut output := "dist"
    mut formats := ""
    mut caller := ""
    mut self_path := os.Env("SALAM_SELF")
    repeat args.len() in i:
        if i == 0:
            continue
        end
        arg := args[i]
        if arg == "--help" or arg == "-h":
            println USAGE
            ret 0
        else str.StartsWith(arg, "--target="):
            target = str.Substr(arg, 9, str.Len(arg) - 9)
        else str.StartsWith(arg, "--backend="):
            backend = str.Substr(arg, 10, str.Len(arg) - 10)
        else str.StartsWith(arg, "--output="):
            output = str.Substr(arg, 9, str.Len(arg) - 9)
        else str.StartsWith(arg, "--format="):
            formats = str.Substr(arg, 9, str.Len(arg) - 9)
        else str.StartsWith(arg, "--cwd="):
            caller = str.Substr(arg, 6, str.Len(arg) - 6)
        else str.StartsWith(arg, "--salam="):
            self_path = str.Substr(arg, 8, str.Len(arg) - 8)
        else str.StartsWith(arg, "-"):
            printerrln USAGE
            ret _fail("unknown option " + arg)
        else:
            project = arg
        end
    end
    if caller.len() > 0:
        _moved := os.Chdir(caller)
    end
    if project.len() == 0:
        project = "."
    end
    root := filepath.Abs(project)
    mut m := Manifest {}
    if not ReadManifest(filepath.Join(root, "salam.toml"), m):
        ret _fail("no [app] table in " + filepath.Join(root, "salam.toml"))
    end
    if m.id.len() == 0:
        ret _fail("[app] needs an id, for example id = \"com.example.notes\"")
    end
    if m.icon.len() > 0:
        m.icon = filepath.Join(root, m.icon)
    end
    mut b := _Build {
        manifest = m, project = root, output = filepath.IsAbs(output) ? output : filepath.Join(os.Cwd(), output),
        target = target, os_name = _os_of(target), arch = _arch_of(target), backend = backend,
        salam = self_path.len() > 0 ? self_path : "salam"
    }
    b.base = m.slug + "-" + m.version + "-" + b.os_name + "-" + b.arch
    b.work = filepath.Join(os.TempDir(), "salam-bundle-" + m.slug + "-" + b.os_name + "-" + b.arch)
    _clean := os.RemoveAll(b.work)
    _a := os.MkdirAll(b.work)
    _b := os.MkdirAll(b.output)
    _say("building " + m.name + " " + m.version + " for " + b.os_name + " " + b.arch)
    if not _compile(b):
        ret _fail("the build failed")
    end
    if m.assets.len() > 0:
        assets_dir := filepath.Join(root, m.assets)
        if not os.IsDir(assets_dir):
            ret _fail("assets folder not found: " + assets_dir)
        end
        b.pack = filepath.Join(b.work, "app.pack")
        count := pack.PackDir(assets_dir, b.pack, m.id)
        if count < 0:
            ret _fail("could not pack " + assets_dir)
        end
        _say("packed " + str.FromInt(count as i64) + " assets")
        if b.os_name != "macos":
            if not pack.AppendPack(b.exe, b.pack):
                ret _fail("could not add the assets to " + b.exe)
            end
        end
    end
    if formats.len() == 0:
        if b.os_name == "linux":
            formats = "tar,deb"
        else b.os_name == "windows":
            formats = "zip"
        else:
            formats = "app,tar"
        end
    end
    wanted := str.Split(formats, ",")
    defer wanted.free()
    each format in wanted:
        mut ok := false
        if b.os_name == "linux" and format == "tar":
            ok = _package_tar_linux(b)
        else b.os_name == "linux" and format == "deb":
            ok = _package_deb(b)
        else b.os_name == "linux" and format == "rpm":
            ok = _package_rpm(b)
        else b.os_name == "linux" and format == "appimage":
            ok = _package_appimage(b)
        else b.os_name == "windows" and format == "zip":
            ok = _package_zip_windows(b)
        else b.os_name == "windows" and format == "nsis":
            ok = _package_nsis(b)
        else b.os_name == "macos" and format == "tar":
            ok = _package_tar_mac(b)
        else b.os_name == "macos" and format == "app":
            ok = _package_app_dir(b)
        else b.os_name == "macos" and format == "dmg":
            ok = _package_dmg(b)
        else:
            ret _fail("format '" + format + "' does not apply to " + b.os_name)
        end
        if not ok:
            ret _fail("could not make " + format)
        end
        _say("made " + format)
    end
    _say("packages are in " + b.output)
    ret 0
end
