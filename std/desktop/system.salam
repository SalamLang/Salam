package desktop

mut _menu_ids := Vector {} as Vector<str>
mut _on_menu := (_id: str): ret end
mut _on_tray_click := (): ret end
mut _on_second := (_args: Vector<str>): ret end
mut _on_notify_click := (): ret end

@en "MenuItem"
@fa "مورد‌منو"
pub struct MenuItem:
    @en "id"
    @fa "شناسه"
    pub id: str = ""
    @en "label"
    @fa "برچسب"
    pub label: str = ""
    @en "separator"
    @fa "جداکننده"
    pub separator: bool = false
    @en "children"
    @fa "زیرمنو"
    pub children: Vector<MenuItem> = Vector {}
end

func _menu_id(id: str): int:
    _menu_ids.push(str.Clone(id))
    ret _menu_ids.len() + 999
end

func _fire_menu(native: int):
    at := native - 1000
    if at >= 0 and at < _menu_ids.len():
        _on_menu(_menu_ids[at])
    end
end

func _parent_native(): void*:
    mut last := null as void*
    each w in _wins:
        if not w.view.IsClosed():
            if w.view.IsActive():
                ret w.view.Native()
            end
            last = w.view.Native()
        end
    end
    ret last
end

func _secret_file(key: str): str:
    dir := DataDir()
    defer mem.Free(dir as void*)
    folder := filepath.Join(dir, "secrets")
    _mk := os.MkdirAll(folder)
    _private := fs.Chmod(folder, 0o700)
    name := crypto.Sha256Hex(key)
    defer mem.Free(name as void*)
    out := filepath.Join(folder, name)
    mem.Free(folder as void*)
    ret out
end

func _secret_id(): str:
    ret _cfg.id.len() > 0 ? _cfg.id : "ir.salamlang.app"
end

func _split_args(data: void*, size: int): Vector<str>:
    mut out := Vector {} as Vector<str>
    bytes := data as u8*
    mut start := 0
    repeat size in i:
        if bytes[i] == (0 as u8):
            piece := mem.Allocate((i - start + 1) as u64)
            mem.Copy(piece, ((data as i64) + (start as i64)) as void*, (i - start) as u64)
            (piece as u8*)[i - start] = 0 as u8
            out.push(piece as str)
            start = i + 1
        end
    end
    ret out
end

func _join_args(size_out &: int): void*:
    args := os.Args()
    mut total := 0
    each a in args:
        total += str.Len(a) + 1
    end
    buf := mem.AllocateZeroed((total + 1) as u64)
    mut at := 0
    each a in args:
        n := str.Len(a)
        mem.Copy(((buf as i64) + (at as i64)) as void*, a as void*, n as u64)
        at += n + 1
    end
    size_out = total
    ret buf
end

@en "OpenURL"
@fa "باز کردن نشانی"
pub func OpenURL(url: str): bool:
    if str.StartsWith(url, "http://") or str.StartsWith(url, "https://") or str.StartsWith(url, "mailto:") or str.StartsWith(url, "tel:"):
        ret _open_external(url)
    end
    ret false
end

@en "PickFolder"
@fa "انتخاب پوشه"
pub func PickFolder(title: str = "Select a folder"): str:
    ret _os_pick(title, 1, "", "", "")
end

@en "PickFile"
@fa "انتخاب پرونده"
pub func PickFile(title: str = "Open", filter_name: str = "", patterns: str = ""): str:
    ret _os_pick(title, 0, "", filter_name, patterns)
end

@en "SaveFile"
@fa "ذخیره پرونده"
pub func SaveFile(title: str = "Save", default_name: str = ""): str:
    ret _os_pick(title, 2, default_name, "", "")
end

@en "Message"
@fa "پیام"
pub func Message(title: str, text: str):
    _ignored := _os_message(title, text, false)
end

@en "Confirm"
@fa "تایید"
pub func Confirm(title: str, text: str): bool:
    ret _os_message(title, text, true)
end

@en "Notify"
@fa "اعلان"
pub func Notify(title: str, body: str, sound: str = ""): bool:
    ret _os_notify(title, body, sound)
end

@en "OnNotifyClick"
@fa "هنگام کلیک اعلان"
pub func OnNotifyClick(handler: func ()):
    _on_notify_click = handler
end

@en "RequestAttention"
@fa "درخواست توجه"
pub func RequestAttention(window: Window):
    _os_attention(window.Native())
end

@en "SecretSet"
@fa "ذخیره راز"
pub func SecretSet(key: str, value: str): bool:
    path := _secret_file(key)
    defer mem.Free(path as void*)
    if _os_secret_set(_secret_id(), key, value):
        if os.Exists(path):
            _removed := os.Remove(path)
        end
        ret true
    end
    if file.WriteBytes(path, value) < 0:
        ret false
    end
    _private := fs.Chmod(path, 0o600)
    ret true
end

@en "SecretGet"
@fa "خواندن راز"
pub func SecretGet(key: str): str:
    stored := _os_secret_get(_secret_id(), key)
    if stored.len() > 0:
        ret stored
    end
    path := _secret_file(key)
    defer mem.Free(path as void*)
    if os.Exists(path):
        mem.Free(stored as void*)
        ret io.ReadFile(path)
    end
    ret stored
end

@en "SecretDelete"
@fa "حذف راز"
pub func SecretDelete(key: str):
    _gone := _os_secret_delete(_secret_id(), key)
    path := _secret_file(key)
    defer mem.Free(path as void*)
    if os.Exists(path):
        _removed := os.Remove(path)
    end
end

@en "Item"
@fa "مورد"
pub func Item(id: str, label: str): MenuItem:
    ret MenuItem { id = id, label = label }
end

@en "Separator"
@fa "خط جداکننده"
pub func Separator(): MenuItem:
    ret MenuItem { separator = true }
end

@en "Submenu"
@fa "زیرمنوی تازه"
pub func Submenu(label: str, items: Vector<MenuItem>): MenuItem:
    ret MenuItem { label = label, children = items }
end

@en "OnMenu"
@fa "هنگام منو"
pub func OnMenu(handler: func (str)):
    _on_menu = handler
    webview.OnCommand((native: int): _fire_menu(native) end)
end

@en "SetMenu"
@fa "تنظیم منو"
pub func SetMenu(window: Window, items: Vector<MenuItem>):
    if window.index >= 0 and window.index < _wins.len():
        _os_set_menu(_wins[window.index].view, items)
    end
end

@en "SetTray"
@fa "تنظیم سینی"
pub func SetTray(icon: str, tooltip: str, items: Vector<MenuItem>): bool:
    _startup()
    ret _os_set_tray(icon, tooltip, items)
end

@en "RemoveTray"
@fa "حذف سینی"
pub func RemoveTray():
    _os_remove_tray()
end

@en "OnTrayClick"
@fa "هنگام کلیک سینی"
pub func OnTrayClick(handler: func ()):
    _on_tray_click = handler
end

@en "SingleInstance"
@fa "نمونه یکتا"
pub func SingleInstance(on_second: func (Vector<str>)): bool:
    _on_second = on_second
    ret _os_single_instance()
end
