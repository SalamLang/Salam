@en "binary"
@fa "دودویی"
package binary

import compress
import mem

@en "BinaryOptions"
@fa "گزینه‌های دودویی"
pub struct BinaryOptions:
    @en "big_endian"
    @fa "بزرگ‌انتها"
    pub big_endian: bool = false
end

func f64_bits(v: f64): i64:
    buf := mem.Allocate(8 as u64)
    p := buf as f64*
    p[0] = v
    q := buf as i64*
    bits := q[0]
    mem.Free(buf)
    ret bits
end

func bits_to_f64(bits: i64): f64:
    buf := mem.Allocate(8 as u64)
    p := buf as i64*
    p[0] = bits
    q := buf as f64*
    v := q[0]
    mem.Free(buf)
    ret v
end

func f32_bits(v: f32): int:
    buf := mem.Allocate(4 as u64)
    p := buf as f32*
    p[0] = v
    q := buf as u32*
    bits := q[0] as int
    mem.Free(buf)
    ret bits
end

func bits_to_f32(bits: int): f32:
    buf := mem.Allocate(4 as u64)
    p := buf as u32*
    p[0] = bits as u32
    q := buf as f32*
    v := q[0]
    mem.Free(buf)
    ret v
end

inline func _b(p: void*, i: int): int:
    bp := p as u8*
    ret bp[i] as int
end

func _short(r: compress.ByteReader, n: int): Error:
    mut left := r.len - r.pos
    if r.bad or left < 0: left = 0 end
    mut unit := " bytes, "
    if n == 1: unit = " byte, " end
    ret Error.At(ErrorKind.UnexpectedEnd, "unexpected end of data: needed " + n + unit + left + " left", r.pos).with_code("binary.unexpected_end")
end

@en "WriteU8"
@fa "نوشتن طبیعی۸"
pub func WriteU8(b &: compress.ByteBuf, v: int): compress.BufPush(b, v & 255) end

@en "WriteU16BE"
@fa "نوشتن طبیعی۱۶ بزرگ‌انتها"
pub func WriteU16BE(b &: compress.ByteBuf, v: int):
    compress.BufPush(b, (v >> 8) & 255)
    compress.BufPush(b, v & 255)
end

@en "WriteU16LE"
@fa "نوشتن طبیعی۱۶ کوچک‌انتها"
pub func WriteU16LE(b &: compress.ByteBuf, v: int):
    compress.BufPush(b, v & 255)
    compress.BufPush(b, (v >> 8) & 255)
end

@en "WriteU32BE"
@fa "نوشتن طبیعی۳۲ بزرگ‌انتها"
pub func WriteU32BE(b &: compress.ByteBuf, v: int): compress.BufPushU32(b, v) end

@en "WriteU32LE"
@fa "نوشتن طبیعی۳۲ کوچک‌انتها"
pub func WriteU32LE(b &: compress.ByteBuf, v: int):
    compress.BufPush(b, v & 255)
    compress.BufPush(b, (v >> 8) & 255)
    compress.BufPush(b, (v >> 16) & 255)
    compress.BufPush(b, (v >> 24) & 255)
end

@en "WriteU64BE"
@fa "نوشتن طبیعی۶۴ بزرگ‌انتها"
pub func WriteU64BE(b &: compress.ByteBuf, v: i64):
    mut shift := 56
    until shift >= 0:
        compress.BufPush(b, ((v >> shift) & (255 as i64)) as int)
        shift -= 8
    end
end

@en "WriteU64LE"
@fa "نوشتن طبیعی۶۴ کوچک‌انتها"
pub func WriteU64LE(b &: compress.ByteBuf, v: i64):
    mut shift := 0
    until shift <= 56:
        compress.BufPush(b, ((v >> shift) & (255 as i64)) as int)
        shift += 8
    end
end

@en "WriteI16BE"
@fa "نوشتن صحیح۱۶ بزرگ‌انتها"
pub func WriteI16BE(b &: compress.ByteBuf, v: int): WriteU16BE(b, v) end
@en "WriteI16LE"
@fa "نوشتن صحیح۱۶ کوچک‌انتها"
pub func WriteI16LE(b &: compress.ByteBuf, v: int): WriteU16LE(b, v) end
@en "WriteI32BE"
@fa "نوشتن صحیح۳۲ بزرگ‌انتها"
pub func WriteI32BE(b &: compress.ByteBuf, v: int): WriteU32BE(b, v) end
@en "WriteI32LE"
@fa "نوشتن صحیح۳۲ کوچک‌انتها"
pub func WriteI32LE(b &: compress.ByteBuf, v: int): WriteU32LE(b, v) end
@en "WriteI64BE"
@fa "نوشتن صحیح۶۴ بزرگ‌انتها"
pub func WriteI64BE(b &: compress.ByteBuf, v: i64): WriteU64BE(b, v) end
@en "WriteI64LE"
@fa "نوشتن صحیح۶۴ کوچک‌انتها"
pub func WriteI64LE(b &: compress.ByteBuf, v: i64): WriteU64LE(b, v) end

@en "WriteF64"
@fa "نوشتن اعشار۶۴"
pub func WriteF64(b &: compress.ByteBuf, v: f64, big_endian: bool):
    bits := f64_bits(v)
    if big_endian: WriteU64BE(b, bits) else:
        WriteU64LE(b, bits)
    end
end

@en "WriteF32"
@fa "نوشتن اعشار۳۲"
pub func WriteF32(b &: compress.ByteBuf, v: f64, big_endian: bool):
    bits := f32_bits(v as f32)
    if big_endian: WriteU32BE(b, bits) else:
        WriteU32LE(b, bits)
    end
end

@en "ReadU8"
@fa "خواندن طبیعی۸"
pub func ReadU8(r &: compress.ByteReader): int throws:
    if r.bad or r.pos >= r.len: throw _short(r, 1) end
    v := _b(r.data, r.pos)
    r.pos++
    ret v
end

@en "ReadU16BE"
@fa "خواندن طبیعی۱۶ بزرگ‌انتها"
pub func ReadU16BE(r &: compress.ByteReader): int throws:
    i := r.pos
    if r.bad or i + 2 > r.len: throw _short(r, 2) end
    p := r.data
    r.pos = i + 2
    ret (_b(p, i) << 8) | _b(p, i + 1)
end

@en "ReadU16LE"
@fa "خواندن طبیعی۱۶ کوچک‌انتها"
pub func ReadU16LE(r &: compress.ByteReader): int throws:
    i := r.pos
    if r.bad or i + 2 > r.len: throw _short(r, 2) end
    p := r.data
    r.pos = i + 2
    ret _b(p, i) | (_b(p, i + 1) << 8)
end

@en "ReadU32BE"
@fa "خواندن طبیعی۳۲ بزرگ‌انتها"
pub func ReadU32BE(r &: compress.ByteReader): int throws:
    i := r.pos
    if r.bad or i + 4 > r.len: throw _short(r, 4) end
    p := r.data
    r.pos = i + 4
    ret (_b(p, i) << 24) | (_b(p, i + 1) << 16) | (_b(p, i + 2) << 8) | _b(p, i + 3)
end

@en "ReadU32LE"
@fa "خواندن طبیعی۳۲ کوچک‌انتها"
pub func ReadU32LE(r &: compress.ByteReader): int throws:
    i := r.pos
    if r.bad or i + 4 > r.len: throw _short(r, 4) end
    p := r.data
    r.pos = i + 4
    ret _b(p, i) | (_b(p, i + 1) << 8) | (_b(p, i + 2) << 16) | (_b(p, i + 3) << 24)
end

@en "ReadU64BE"
@fa "خواندن طبیعی۶۴ بزرگ‌انتها"
pub func ReadU64BE(r &: compress.ByteReader): i64 throws:
    i := r.pos
    if r.bad or i + 8 > r.len: throw _short(r, 8) end
    p := r.data
    r.pos = i + 8
    mut out := 0 as i64
    repeat 8 in k:
        out = (out << (8 as i64)) | (_b(p, i + k) as i64)
    end
    ret out
end

@en "ReadU64LE"
@fa "خواندن طبیعی۶۴ کوچک‌انتها"
pub func ReadU64LE(r &: compress.ByteReader): i64 throws:
    i := r.pos
    if r.bad or i + 8 > r.len: throw _short(r, 8) end
    p := r.data
    r.pos = i + 8
    mut out := 0 as i64
    mut k := 7
    until k >= 0:
        out = (out << (8 as i64)) | (_b(p, i + k) as i64)
        k--
    end
    ret out
end

@en "ReadI16BE"
@fa "خواندن صحیح۱۶ بزرگ‌انتها"
pub func ReadI16BE(r &: compress.ByteReader): int throws:
    v := try ReadU16BE(r)
    if v >= 32768: ret v - 65536 end
    ret v
end
@en "ReadI16LE"
@fa "خواندن صحیح۱۶ کوچک‌انتها"
pub func ReadI16LE(r &: compress.ByteReader): int throws:
    v := try ReadU16LE(r)
    if v >= 32768: ret v - 65536 end
    ret v
end
@en "ReadI32BE"
@fa "خواندن صحیح۳۲ بزرگ‌انتها"
pub func ReadI32BE(r &: compress.ByteReader): int throws: ret try ReadU32BE(r) end
@en "ReadI32LE"
@fa "خواندن صحیح۳۲ کوچک‌انتها"
pub func ReadI32LE(r &: compress.ByteReader): int throws: ret try ReadU32LE(r) end
@en "ReadI64BE"
@fa "خواندن صحیح۶۴ بزرگ‌انتها"
pub func ReadI64BE(r &: compress.ByteReader): i64 throws: ret try ReadU64BE(r) end
@en "ReadI64LE"
@fa "خواندن صحیح۶۴ کوچک‌انتها"
pub func ReadI64LE(r &: compress.ByteReader): i64 throws: ret try ReadU64LE(r) end

@en "ReadF64"
@fa "خواندن اعشار۶۴"
pub func ReadF64(r &: compress.ByteReader, big_endian: bool): f64 throws:
    mut bits := 0 as i64
    if big_endian: bits = try ReadU64BE(r) else:
        bits = try ReadU64LE(r)
    end
    ret bits_to_f64(bits)
end

@en "ReadF32"
@fa "خواندن اعشار۳۲"
pub func ReadF32(r &: compress.ByteReader, big_endian: bool): f64 throws:
    mut bits := 0
    if big_endian: bits = try ReadU32BE(r) else:
        bits = try ReadU32LE(r)
    end
    ret bits_to_f32(bits)
end
