package binary

import compress
import mem

@en "View"
@fa "نمای بایت"
pub struct View:
    @en "data"
    @fa "داده"
    pub data: void* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
end

func _vget(v: View, off: int, n: int, big: bool): i64:
    if v.data == null or off < 0 or n < 0 or off > v.len - n:
        ret 0
    end
    bp := v.data as u8*
    mut r := 0 as i64
    repeat n in i:
        k := big ? i : n - 1 - i
        r = (r << 8) | ((bp[off + k] as i64) & 255)
    end
    ret r
end

func _vput(v: View, off: int, n: int, big: bool, x: i64): bool:
    if v.data == null or off < 0 or n < 0 or off > v.len - n:
        ret false
    end
    bp := v.data as u8*
    repeat n in i:
        k := big ? n - 1 - i : i
        bp[off + k] = ((x >> ((i * 8) as i64)) & 255) as u8
    end
    ret true
end

@en "NewView"
@fa "نمای بایت جدید"
pub func NewView(p: void*, n: int): View:
    ret View { data = p, len = n }
end

@en "ViewOf"
@fa "نمای بافر"
pub func ViewOf(b: compress.ByteBuf): View:
    ret View { data = b.data, len = b.len }
end

@en "Has"
@fa "دارد"
pub func Has(v: View, off: int, n: int): bool:
    ret v.data != null and off >= 0 and n >= 0 and off <= v.len - n
end

@en "GetU8"
@fa "گرفتن طبیعی۸"
pub func GetU8(v: View, off: int): int: ret _vget(v, off, 1, false) as int end

@en "GetU16LE"
@fa "گرفتن طبیعی۱۶ کوچک‌انتها"
pub func GetU16LE(v: View, off: int): int: ret _vget(v, off, 2, false) as int end

@en "GetU16BE"
@fa "گرفتن طبیعی۱۶ بزرگ‌انتها"
pub func GetU16BE(v: View, off: int): int: ret _vget(v, off, 2, true) as int end

@en "GetU32LE"
@fa "گرفتن طبیعی۳۲ کوچک‌انتها"
pub func GetU32LE(v: View, off: int): i64: ret _vget(v, off, 4, false) end

@en "GetU32BE"
@fa "گرفتن طبیعی۳۲ بزرگ‌انتها"
pub func GetU32BE(v: View, off: int): i64: ret _vget(v, off, 4, true) end

@en "GetU64LE"
@fa "گرفتن طبیعی۶۴ کوچک‌انتها"
pub func GetU64LE(v: View, off: int): i64: ret _vget(v, off, 8, false) end

@en "GetU64BE"
@fa "گرفتن طبیعی۶۴ بزرگ‌انتها"
pub func GetU64BE(v: View, off: int): i64: ret _vget(v, off, 8, true) end

@en "PutU8"
@fa "گذاشتن طبیعی۸"
pub func PutU8(v: View, off: int, x: i64): bool: ret _vput(v, off, 1, false, x) end

@en "PutU16LE"
@fa "گذاشتن طبیعی۱۶ کوچک‌انتها"
pub func PutU16LE(v: View, off: int, x: i64): bool: ret _vput(v, off, 2, false, x) end

@en "PutU16BE"
@fa "گذاشتن طبیعی۱۶ بزرگ‌انتها"
pub func PutU16BE(v: View, off: int, x: i64): bool: ret _vput(v, off, 2, true, x) end

@en "PutU32LE"
@fa "گذاشتن طبیعی۳۲ کوچک‌انتها"
pub func PutU32LE(v: View, off: int, x: i64): bool: ret _vput(v, off, 4, false, x) end

@en "PutU32BE"
@fa "گذاشتن طبیعی۳۲ بزرگ‌انتها"
pub func PutU32BE(v: View, off: int, x: i64): bool: ret _vput(v, off, 4, true, x) end

@en "PutU64LE"
@fa "گذاشتن طبیعی۶۴ کوچک‌انتها"
pub func PutU64LE(v: View, off: int, x: i64): bool: ret _vput(v, off, 8, false, x) end

@en "PutU64BE"
@fa "گذاشتن طبیعی۶۴ بزرگ‌انتها"
pub func PutU64BE(v: View, off: int, x: i64): bool: ret _vput(v, off, 8, true, x) end

@en "CStringAt"
@fa "رشته با صفر پایانی"
pub func CStringAt(v: View, off: int): str:
    if v.data == null or off < 0 or off >= v.len:
        ret ""
    end
    bp := v.data as u8*
    mut end_at := off
    until end_at < v.len and bp[end_at] != 0:
        end_at += 1
    end
    size := end_at - off
    buf := mem.Allocate((size + 1) as u64)
    mem.Copy(buf, ((bp as i64) + (off as i64)) as void*, size as u64)
    out := buf as u8*
    out[size] = 0 as u8
    ret buf as str
end

@en "FixedStringAt"
@fa "رشته با پهنای ثابت"
pub func FixedStringAt(v: View, off: int, width: int): str:
    if v.data == null or off < 0 or width <= 0 or off > v.len - width:
        ret ""
    end
    sub := View { data = v.data, len = off + width }
    ret CStringAt(sub, off)
end
