@en "csv"
@fa "سی اس وی"
package csv

import str
import mem

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

func _sep_byte(sep: str): int:
    if sep.Len() != 1: ret 0 - 1 end
    c := _ub(_bp(sep), 0)
    if c == 34 or c == 10 or c == 13: ret 0 - 1 end
    ret c
end

func _write_sep(opts: CSVOptions): int:
    c := _sep_byte(opts.separator)
    if c < 0: ret 44 end
    ret c
end

func _read_sep(opts: CSVOptions, err &: Error): int:
    c := _sep_byte(opts.separator)
    if c < 0:
        err = Error.New(ErrorKind.InvalidArgument, "the separator must be one character other than a quote or a line break, got '" + opts.separator + "'").with_code("csv.bad_separator")
    end
    ret c
end

func _eol_len(bp: i8*, n: int, i: int): int:
    c := _ub(bp, i)
    if c == 10: ret 1 end
    if c == 13:
        if i + 1 == n: ret 1 end
        if _ub(bp, i + 1) == 10: ret 2 end
    end
    ret 0
end

func _sep_name(sep: int): str:
    if sep == 9: ret "a tab" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 39)
    str.BufAppendChar(sb, sep)
    str.BufAppendChar(sb, 39)
    ret str.BufStr(sb)
end

func _free_fields(fields &: Vector<str>):
    repeat fields.Len() in i: mem.Free(fields.get(i) as void*) end
    fields.Free()
end

func _read_quoted(sb &: str.StringBuilder, bp: i8*, n: int, start: int, err &: Error): int:
    mut i := start + 1
    until i < n:
        c := _ub(bp, i)
        if c == 34:
            if i + 1 < n and _ub(bp, i + 1) == 34:
                str.BufAppendChar(sb, 34)
                i += 2
            else:
                ret i + 1
            end
        else:
            str.BufAppendChar(sb, c)
            i++
        end
    end
    err = Error.At(ErrorKind.Syntax, "unterminated quoted field", start).with_code("csv.unterminated_quote")
    ret n
end

func _read_bare(sb &: str.StringBuilder, bp: i8*, n: int, start: int, sep: int, err &: Error): int:
    mut i := start
    until i < n:
        c := _ub(bp, i)
        if c == sep or _eol_len(bp, n, i) > 0: ret i end
        if c == 34:
            err = Error.At(ErrorKind.Syntax, "a quote inside an unquoted field; quote the whole field and double the quote", i).with_code("csv.bare_quote")
            ret n
        end
        str.BufAppendChar(sb, c)
        i++
    end
    ret n
end

func _read_record(text: str, n: int, start: int, sep: int, row &: Vector<str>, at &: Vector<int>, err &: Error): int:
    bp := _bp(text)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := start
    until true:
        str.BufReset(sb)
        at.push(i)
        quoted := i < n and _ub(bp, i) == 34
        if quoted:
            i = _read_quoted(sb, bp, n, i, err)
        else:
            i = _read_bare(sb, bp, n, i, sep, err)
        end
        if err.message != "": ret n end
        row.push(str.BufStr(sb))
        if i >= n: ret n end
        c := _ub(bp, i)
        if c == sep:
            i++
        else:
            eol := _eol_len(bp, n, i)
            if eol > 0: ret i + eol end
            err = Error.At(ErrorKind.Syntax, "unexpected text after a closing quote; expected " + _sep_name(sep) + " or a line break", i).with_code("csv.text_after_quote")
            ret n
        end
    end
end

func _read_line(line: str, sep: int, err &: Error): Vector<str>:
    mut row := Vector {} as Vector<str>
    mut at := Vector {} as Vector<int>
    defer at.Free()
    n := line.Len()
    next := _read_record(line, n, 0, sep, row, at, err)
    if err.message == "" and next < n:
        err = Error.At(ErrorKind.Syntax, "more than one row; read several rows with ReadAll", next).with_code("csv.multiple_rows")
    end
    if err.message != "": _free_fields(row) end
    ret row
end

pure func _needs_quote(field: str, sep: int): bool:
    bp := _bp(field)
    n := field.Len()
    repeat n in i:
        c := _ub(bp, i)
        if c == sep or c == 34 or c == 10 or c == 13: ret true end
    end
    ret false
end

func _write_line(sb &: str.StringBuilder, fields: Vector<str>, sep: int):
    repeat fields.Len() in i:
        if i > 0:
            str.BufAppendChar(sb, sep)
        end
        f := fields.get(i)
        if _needs_quote(f, sep):
            str.BufAppendChar(sb, 34)
            bp := _bp(f)
            repeat f.Len() in k:
                c := _ub(bp, k)
                if c == 34: str.BufAppendChar(sb, 34) end
                str.BufAppendChar(sb, c)
            end
            str.BufAppendChar(sb, 34)
        else:
            str.BufAppend(sb, f)
        end
    end
end

@en "ReadLineWith"
@fa "خواندن خط سفارشی"
pub func ReadLineWith(line: str, opts: CSVOptions): Vector<str> throws:
    mut err := Error {}
    sep := _read_sep(opts, err)
    if err.message != "": throw err.wrap("csv") end
    row := _read_line(line, sep, err)
    if err.message != "": throw err.locate(line).wrap("csv") end
    ret row
end

@en "ReadLine"
@fa "خواندن خط"
pub func ReadLine(line: str): Vector<str> throws:
    mut err := Error {}
    row := _read_line(line, 44, err)
    if err.message != "": throw err.locate(line).wrap("csv") end
    ret row
end

@en "WriteLineWith"
@fa "نوشتن خط سفارشی"
pub func WriteLineWith(fields: Vector<str>, opts: CSVOptions): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    _write_line(sb, fields, _write_sep(opts))
    ret str.BufStr(sb)
end

@en "WriteLine"
@fa "نوشتن خط"
pub func WriteLine(fields: Vector<str>): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    _write_line(sb, fields, 44)
    ret str.BufStr(sb)
end
