package csv

import encoding.value
import mem
import str
import conv

pub struct CSVRow:
    pub fields: Vector<str> = Vector {}
end

pub struct CSVTable:
    pub rows: Vector<CSVRow> = Vector {}
end

pub struct CSVOptions:
    pub header: bool = true
end

func _split_lines(text: str): Vector<str>:
    norm := str.Replace(text, "\r\n", "\n")
    out := str.Split(norm, "\n")
    mem.Free(norm as void*)
    ret out
end

func _free_lines(lines &: Vector<str>):
    repeat lines.len() with i: mem.Free(lines.get(i) as void*) end
    lines.free()
end

func _index_key(i: int): str:
    ret "col".concat(conv.FormatInt(i as i64))
end

pub func ReadAll(text: str): CSVTable:
    mut out := CSVTable {}
    mut lines := _split_lines(text)
    mut i := 0
    until i < lines.len():
        line := lines.get(i)
        i += 1
        if line.len() == 0: continue end
        mut row := CSVRow {}
        row.fields = ReadLine(line)
        out.rows.push(row)
    end
    _free_lines(lines)
    ret out
end

pub func FreeTable(t &: CSVTable):
    repeat t.rows.len() with i:
        mut r := t.rows.get(i)
        repeat r.fields.len() with j: mem.Free(r.fields.get(j) as void*) end
        r.fields.free()
    end
    t.rows.free()
end

pub func WriteAll(table: CSVTable): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < table.rows.len():
        if i > 0: str.BufAppend(sb, "\r\n") end
        str.BufAppend(sb, WriteLine(table.rows.get(i).fields))
        i += 1
    end
    ret str.BufStr(sb)
end

pub func ToValueWith(text: str, opts: CSVOptions): value.Value:
    table := ReadAll(text)
    mut out := value.NewValueArray()
    if table.rows.len() == 0: ret out end
    mut headerIdx := 0
    mut header := Vector {} as Vector<str>
    if opts.header:
        header = table.rows.get(0).fields
        headerIdx = 1
    end
    mut i := headerIdx
    until i < table.rows.len():
        row := table.rows.get(i).fields
        mut obj := value.NewValueObject()
        mut j := 0
        until j < row.len():
            mut key := _index_key(j)
            if opts.header && j < header.len(): key = header.get(j) end
            value.ObjectSet(obj, key, value.ValueString(row.get(j)))
            j += 1
        end
        value.ArrayPush(out, obj)
        i += 1
    end
    ret out
end

pub func ToValue(text: str): value.Value:
    ret ToValueWith(text, CSVOptions {})
end

pub func FromValueWith(v: value.Value, opts: CSVOptions): str:
    mut table := CSVTable {}
    n := value.ArrayLen(v)
    if n == 0: ret "" end
    first := value.ArrayGet(v, 0)
    header := value.ObjectKeys(first)
    if opts.header:
        mut headerRow := CSVRow {}
        headerRow.fields = header
        table.rows.push(headerRow)
    end
    mut i := 0
    until i < n:
        item := value.ArrayGet(v, i)
        mut fields := Vector {} as Vector<str>
        mut j := 0
        until j < header.len():
            fields.push(value.AsString(value.ObjectGet(item, header.get(j))))
            j += 1
        end
        mut r := CSVRow {}
        r.fields = fields
        table.rows.push(r)
        i += 1
    end
    ret WriteAll(table)
end

pub func FromValue(v: value.Value): str:
    ret FromValueWith(v, CSVOptions {})
end
