package csv

import encoding.value
import mem
import str
import conv

@en "CSVRow"
@fa "ردیف سی اس وی"
pub struct CSVRow:
    @en "fields"
    @fa "خانه‌ها"
    pub fields: Vector<str> = Vector {}
end

@en "CSVTable"
@fa "جدول سی اس وی"
pub struct CSVTable:
    @en "rows"
    @fa "ردیف‌ها"
    pub rows: Vector<CSVRow> = Vector {}
end

@en "CSVOptions"
@fa "گزینه‌های سی اس وی"
pub struct CSVOptions:
    @en "header"
    @fa "سرستون"
    pub header: bool = true
    @en "separator"
    @fa "جداکننده"
    pub separator: str = ","
    @en "keep_blank"
    @fa "نگه داشتن خط خالی"
    pub keep_blank: bool = false
end

func _index_key(i: int): str:
    ret "col".concat(conv.FormatInt(i as i64))
end

func _free_rows(t &: CSVTable):
    repeat t.rows.len() in i:
        mut r := t.rows.get(i)
        repeat r.fields.len() in j: mem.Free(r.fields.get(j) as void*) end
        r.fields.free()
    end
    t.rows.free()
end

func _read_table(text: str, sep: int, keep_blank: bool, header_at &: Vector<int>, err &: Error): CSVTable:
    mut out := CSVTable {}
    bp := _bp(text)
    n := text.len()
    mut at := Vector {} as Vector<int>
    defer at.free()
    mut pos := 0
    until pos < n:
        eol := _eol_len(bp, n, pos)
        if eol > 0 and keep_blank == false:
            pos += eol
            continue
        end
        mut row := CSVRow {}
        at.clear()
        pos = _read_record(text, n, pos, sep, row.fields, at, err)
        if err.message != "":
            _free_fields(row.fields)
            _free_rows(out)
            ret CSVTable {}
        end
        if out.rows.len() == 0:
            repeat at.len() in k: header_at.push(at.get(k)) end
        end
        out.rows.push(row)
    end
    ret out
end

func _check_header(table: CSVTable, at: Vector<int>, err &: Error):
    header := table.rows.get(0).fields
    repeat header.len() in j:
        repeat j in k:
            if str.Equals(header.get(k), header.get(j)):
                mut off := 0
                if j < at.len(): off = at.get(j) end
                err = Error.At(ErrorKind.AlreadyExists, "duplicate column name '" + header.get(j) + "'", off).with_code("csv.duplicate_header")
                ret
            end
        end
    end
end

@en "ReadAllWith"
@fa "خواندن همه سفارشی"
pub func ReadAllWith(text: str, opts: CSVOptions): CSVTable throws:
    mut err := Error {}
    sep := _read_sep(opts, err)
    if err.message != "": throw err.wrap("csv") end
    mut hat := Vector {} as Vector<int>
    defer hat.free()
    out := _read_table(text, sep, opts.keep_blank, hat, err)
    if err.message != "": throw err.locate(text).wrap("csv") end
    ret out
end

@en "ReadAll"
@fa "خواندن همه"
pub func ReadAll(text: str): CSVTable throws:
    ret try ReadAllWith(text, CSVOptions {})
end

@en "FreeTable"
@fa "آزادسازی جدول"
pub func FreeTable(t &: CSVTable):
    _free_rows(t)
end

@en "WriteAllWith"
@fa "نوشتن همه سفارشی"
pub func WriteAllWith(table: CSVTable, opts: CSVOptions): str:
    sep := _write_sep(opts)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat table.rows.len() in i:
        if i > 0: str.BufAppend(sb, "\r\n") end
        _write_line(sb, table.rows.get(i).fields, sep)
    end
    ret str.BufStr(sb)
end

@en "WriteAll"
@fa "نوشتن همه"
pub func WriteAll(table: CSVTable): str:
    ret WriteAllWith(table, CSVOptions {})
end

@en "ToValueWith"
@fa "به مقدار سفارشی"
pub func ToValueWith(text: str, opts: CSVOptions): value.Value throws:
    mut err := Error {}
    sep := _read_sep(opts, err)
    if err.message != "": throw err.wrap("csv") end
    mut hat := Vector {} as Vector<int>
    defer hat.free()
    mut table := _read_table(text, sep, opts.keep_blank, hat, err)
    if err.message == "" and opts.header and table.rows.len() > 0:
        _check_header(table, hat, err)
        if err.message != "": _free_rows(table) end
    end
    if err.message != "": throw err.locate(text).wrap("csv") end
    mut out := value.NewValueArray()
    if table.rows.len() == 0: ret out end
    mut headerIdx := 0
    mut header := Vector {} as Vector<str>
    if opts.header:
        header = table.rows.get(0).fields
        headerIdx = 1
    end
    mut i := headerIdx
    until i < table.rows.len():
        row := table.rows.get(i).fields
        mut obj := value.NewValueObject()
        mut j := 0
        until j < row.len():
            mut key := _index_key(j)
            if opts.header and j < header.len(): key = header.get(j) end
            value.ObjectSet(obj, key, value.ValueString(row.get(j)))
            j++
        end
        value.ArrayPush(out, obj)
        i++
    end
    ret out
end

@en "ToValue"
@fa "به مقدار"
pub func ToValue(text: str): value.Value throws:
    ret try ToValueWith(text, CSVOptions {})
end

@en "FromValueWith"
@fa "از مقدار سفارشی"
pub func FromValueWith(v: value.Value, opts: CSVOptions): str:
    mut table := CSVTable {}
    n := value.ArrayLen(v)
    if n == 0: ret "" end
    first := value.ArrayGet(v, 0)
    header := value.ObjectKeys(first)
    if opts.header:
        mut headerRow := CSVRow {}
        headerRow.fields = header
        table.rows.push(headerRow)
    end
    mut i := 0
    until i < n:
        item := value.ArrayGet(v, i)
        mut fields := Vector {} as Vector<str>
        mut j := 0
        until j < header.len():
            fields.push(value.AsString(value.ObjectGet(item, header.get(j))))
            j++
        end
        mut r := CSVRow {}
        r.fields = fields
        table.rows.push(r)
        i++
    end
    ret WriteAllWith(table, opts)
end

@en "FromValue"
@fa "از مقدار"
pub func FromValue(v: value.Value): str:
    ret FromValueWith(v, CSVOptions {})
end
