package encerr

// encerr - the shared structured-error type for every encoding.* format
// package. Own leaf package (mirrors std/os/error's shape) rather than
// folded into encoding.value, since packages like encoding.binary/
// encoding.query need to report errors without pulling in a Value
// dependency.
//
// Unlike std/os/error's global "last error" singleton, EncodingError is
// threaded via an `err &: EncodingError` out-parameter (generalizing
// encoding.Base64DecodeStrict's `ok &: bool` to carry a struct) - decoders
// are recursive (_decode_value -> _decode_array -> _decode_value), so a
// shared mutable global would get clobbered by inner calls before the outer
// call gets to read it.

pub const KindNone := 0
pub const KindUnexpectedEOF := 1
pub const KindUnexpectedToken := 2
pub const KindInvalidUTF8 := 3
pub const KindInvalidNumber := 4
pub const KindDepthExceeded := 5
pub const KindTypeMismatch := 6
pub const KindKeyNotFound := 7
pub const KindTrailingData := 8
pub const KindCustom := 99

pub struct EncodingError:
    pub kind: int = KindNone
    pub message: str = ""
    pub position: int = 0 - 1
end

pub func NoError(): EncodingError: ret EncodingError {} end

pub func NewError(kind: int, message: str, position: int): EncodingError:
    ret EncodingError { kind = kind, message = message, position = position }
end

pub func ErrUnexpectedEOF(position: int): EncodingError:
    ret NewError(KindUnexpectedEOF, "unexpected end of input", position)
end

pub func ErrUnexpectedToken(message: str, position: int): EncodingError:
    ret NewError(KindUnexpectedToken, message, position)
end

pub func ErrTypeMismatch(expected: str, position: int): EncodingError:
    ret NewError(KindTypeMismatch, "expected ".concat(expected), position)
end

pub func IsError(e: EncodingError): bool: ret e.kind != KindNone end
