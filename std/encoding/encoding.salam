@en "encoding"
@fa "کدگذاری"
package encoding

import str

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

pure func _b64val(code: int): int:
    if code >= 65 and code <= 90: ret code - 65
    else code >= 97 and code <= 122: ret code - 71
    else code >= 48 and code <= 57: ret code + 4
    else code == 43 or code == 45: ret 62
    else code == 47 or code == 95: ret 63
    else:
        ret 0 - 1
    end
end

pure func _hexval(code: int): int:
    if code >= 48 and code <= 57: ret code - 48
    else code >= 97 and code <= 102: ret code - 87
    else code >= 65 and code <= 70: ret code - 55
    else:
        ret 0 - 1
    end
end

pure func _url_safe(code: int): bool:
    if code >= 65 and code <= 90: ret true
    else code >= 97 and code <= 122: ret true
    else code >= 48 and code <= 57: ret true
    else code == 45 or code == 95 or code == 46 or code == 126: ret true
    else:
        ret false
    end
end

func _byte_desc(code: int): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    if code == 32:
        str.BufAppend(sb, "space")
    else code > 32 and code < 127:
        str.BufAppend(sb, "character ")
        str.BufAppendChar(sb, 39)
        str.BufAppendChar(sb, code)
        str.BufAppendChar(sb, 39)
    else:
        digits := "0123456789ABCDEF"
        hp := _bp(digits)
        str.BufAppend(sb, "byte 0x")
        str.BufAppendChar(sb, _ub(hp, code / 16))
        str.BufAppendChar(sb, _ub(hp, code % 16))
    end
    out := str.BufStr(sb)
    ret out
end

func _enc_err(text: str, kind: ErrorKind, message: str, offset: int, context: str): Error:
    ret Error.At(kind, message, offset).locate(text).wrap(context)
end

func _b64_decode_into(s: str, sb &: str.StringBuilder, op: u8*, cap: int): int throws:
    n := s.len()
    bp := _bp(s)
    mut written := 0
    mut acc := 0
    mut nbits := 0
    mut digits := 0
    mut pad := 0
    mut pad_at := 0 - 1
    mut extra_pad_at := 0 - 1
    mut i := 0
    until i < n:
        code := _ub(bp, i)
        if code == 32 or code == 9 or code == 10 or code == 13:
            i += 1
            continue
        end
        if code == 61:
            if pad == 0: pad_at = i end
            pad += 1
            if pad == 3: extra_pad_at = i end
            i += 1
            continue
        end
        v := _b64val(code)
        if v < 0:
            throw _enc_err(s, ErrorKind.Syntax, "invalid " + _byte_desc(code), i, "base64")
        end
        if pad > 0:
            throw _enc_err(s, ErrorKind.Syntax, "data after '=' padding", i, "base64")
        end
        digits += 1
        acc = (acc << 6) | v
        nbits += 6
        if nbits >= 8:
            nbits -= 8
            b := (acc >> nbits) & 255
            if cap < 0:
                str.BufAppendChar(sb, b)
            else written < cap:
                op[written] = b as u8
            end
            written += 1
            acc = acc & ((1 << nbits) - 1)
        end
        i += 1
    end
    r := digits % 4
    if r == 1:
        throw _enc_err(s, ErrorKind.UnexpectedEnd, "input ends one character into a group of four", n, "base64")
    end
    if pad > 0:
        mut need := 0
        if r == 2: need = 2 end
        if r == 3: need = 1 end
        if need == 0:
            throw _enc_err(s, ErrorKind.Syntax, "unexpected '=' padding", pad_at, "base64")
        end
        if pad < need:
            throw _enc_err(s, ErrorKind.UnexpectedEnd, "missing '=' padding", n, "base64")
        end
        if pad > need:
            mut at := extra_pad_at
            if need == 1:
                mut j := pad_at + 1
                until j < n and _ub(bp, j) != 61:
                    j += 1
                end
                at = j
            end
            throw _enc_err(s, ErrorKind.Syntax, "too much '=' padding", at, "base64")
        end
    end
    ret written
end

func _b64_encode_bytes(p: void*, n: int): str:
    alpha := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    ap := _bp(alpha)
    dp := p as i8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        b0 := _ub(dp, i)
        mut b1 := 0
        mut b2 := 0
        if i + 1 < n: b1 = _ub(dp, i + 1) end
        if i + 2 < n: b2 = _ub(dp, i + 2) end
        str.BufAppendChar(sb, _ub(ap, b0 / 4))
        str.BufAppendChar(sb, _ub(ap, (b0 % 4) * 16 + b1 / 16))
        if i + 1 < n:
            str.BufAppendChar(sb, _ub(ap, (b1 % 16) * 4 + b2 / 64))
        else:
            str.BufAppendChar(sb, 61)
        end
        if i + 2 < n:
            str.BufAppendChar(sb, _ub(ap, b2 % 64))
        else:
            str.BufAppendChar(sb, 61)
        end
        i += 3
    end
    out := str.BufStr(sb)
    ret out
end

@en "Base64Encode"
@fa "کدگذاری پایه۶۴"
pub func Base64Encode(data: str): str:
    ret _b64_encode_bytes(data as void*, data.len())
end

@en "Base64EncodeBytes"
@fa "کدگذاری بایت‌ها پایه۶۴"
pub func Base64EncodeBytes(data: void*, n: int): str:
    ret _b64_encode_bytes(data, n)
end

@en "Base64Decode"
@fa "کدگشایی پایه۶۴"
pub func Base64Decode(s: str): str throws:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    try _b64_decode_into(s, sb, null, 0 - 1)
    out := str.BufStr(sb)
    ret out
end

@en "HexEncode"
@fa "کدگذاری شانزده"
pub func HexEncode(data: str): str:
    digits := "0123456789abcdef"
    hp := _bp(digits)
    dp := _bp(data)
    n := data.len()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n in i:
        b := _ub(dp, i)
        str.BufAppendChar(sb, _ub(hp, b / 16))
        str.BufAppendChar(sb, _ub(hp, b % 16))
    end
    out := str.BufStr(sb)
    ret out
end

@en "HexVal"
@fa "مقدار شانزده"
pub inline pure func HexVal(c: str): int: ret _hexval(char_code(c)) end

@en "HexDecode"
@fa "کدگشایی شانزده"
pub func HexDecode(s: str): str throws:
    n := s.len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        hi := _hexval(_ub(bp, i))
        if hi < 0:
            throw _enc_err(s, ErrorKind.Syntax, "invalid " + _byte_desc(_ub(bp, i)), i, "hex")
        end
        if i + 1 >= n:
            throw _enc_err(s, ErrorKind.UnexpectedEnd, "odd number of hex digits", n, "hex")
        end
        lo := _hexval(_ub(bp, i + 1))
        if lo < 0:
            throw _enc_err(s, ErrorKind.Syntax, "invalid " + _byte_desc(_ub(bp, i + 1)), i + 1, "hex")
        end
        str.BufAppendChar(sb, hi * 16 + lo)
        i += 2
    end
    out := str.BufStr(sb)
    ret out
end

@en "URLEncode"
@fa "کدگذاری نشانی"
pub func URLEncode(s: str): str:
    digits := "0123456789ABCDEF"
    hp := _bp(digits)
    bp := _bp(s)
    n := s.len()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n in i:
        code := _ub(bp, i)
        if _url_safe(code):
            str.BufAppendChar(sb, code)
        else:
            str.BufAppendChar(sb, 37)
            str.BufAppendChar(sb, _ub(hp, code / 16))
            str.BufAppendChar(sb, _ub(hp, code % 16))
        end
    end
    out := str.BufStr(sb)
    ret out
end

@en "URLDecode"
@fa "کدگشایی نشانی"
pub func URLDecode(s: str): str throws:
    n := s.len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        code := _ub(bp, i)
        if code == 37:
            if i + 1 < n and _hexval(_ub(bp, i + 1)) < 0:
                throw _enc_err(s, ErrorKind.Syntax, "malformed percent escape", i, "url")
            end
            if i + 2 < n and _hexval(_ub(bp, i + 2)) < 0:
                throw _enc_err(s, ErrorKind.Syntax, "malformed percent escape", i, "url")
            end
            if i + 2 >= n:
                throw _enc_err(s, ErrorKind.UnexpectedEnd, "incomplete percent escape", i, "url")
            end
            str.BufAppendChar(sb, _hexval(_ub(bp, i + 1)) * 16 + _hexval(_ub(bp, i + 2)))
            i += 3
        else:
            if code == 43:
                str.BufAppendChar(sb, 32)
            else:
                str.BufAppendChar(sb, code)
            end
            i += 1
        end
    end
    out := str.BufStr(sb)
    ret out
end

@en "Base64DecodeBytes"
@fa "کدگشایی پایه۶۴ به بایت"
pub func Base64DecodeBytes(s: str, out: void*, cap: int): int throws:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut room := cap
    if room < 0: room = 0 end
    written := try _b64_decode_into(s, sb, out as u8*, room)
    if written > room:
        throw Error.New(ErrorKind.OutOfRange, "decoded data needs " + written + " bytes but the buffer holds " + room).wrap("base64")
    end
    ret written
end
