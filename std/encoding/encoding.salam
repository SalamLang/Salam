@en "encoding"
@fa "کدگذاری"
@ar "ترمیز"
package encoding

import str

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

pure func _b64val(code: int): int:
    if code >= 65 && code <= 90: ret code - 65
    else code >= 97 && code <= 122: ret code - 71
    else code >= 48 && code <= 57: ret code + 4
    else code == 43: ret 62
    else code == 47: ret 63
    else:
        ret 0 - 1
    end
end

pure func _hexval(code: int): int:
    if code >= 48 && code <= 57: ret code - 48
    else code >= 97 && code <= 102: ret code - 87
    else code >= 65 && code <= 70: ret code - 55
    else:
        ret 0 - 1
    end
end

pure func _url_safe(code: int): bool:
    if code >= 65 && code <= 90: ret true
    else code >= 97 && code <= 122: ret true
    else code >= 48 && code <= 57: ret true
    else code == 45 || code == 95 || code == 46 || code == 126: ret true
    else:
        ret false
    end
end

func _b64_encode_bytes(p: void*, n: int): str:
    alpha := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    ap := _bp(alpha)
    dp := p as i8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        b0 := _ub(dp, i)
        mut b1 := 0
        mut b2 := 0
        if i + 1 < n: b1 = _ub(dp, i + 1) end
        if i + 2 < n: b2 = _ub(dp, i + 2) end
        str.BufAppendChar(sb, _ub(ap, b0 / 4))
        str.BufAppendChar(sb, _ub(ap, (b0 % 4) * 16 + b1 / 16))
        if i + 1 < n:
            str.BufAppendChar(sb, _ub(ap, (b1 % 16) * 4 + b2 / 64))
        else:
            str.BufAppendChar(sb, 61)
        end
        if i + 2 < n:
            str.BufAppendChar(sb, _ub(ap, b2 % 64))
        else:
            str.BufAppendChar(sb, 61)
        end
        i += 3
    end
    out := str.BufStr(sb)
    ret out
end

@en "Base64Encode"
@fa "کدگذاری شصت و چهار"
@ar "تشفیر ستینی"
pub func Base64Encode(data: str): str:
    ret _b64_encode_bytes(data as void*, data.len())
end

@en "Base64EncodeBytes"
@fa "کدگذاری بایت‌ها شصت و چهار"
@ar "تشفیر بایتات ستینی"
pub func Base64EncodeBytes(data: void*, n: int): str:
    ret _b64_encode_bytes(data, n)
end

@en "Base64Decode"
@fa "کدگشایی شصت و چهار"
@ar "فک تشفیر ستینی"
pub func Base64Decode(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut qi := 0
    mut q0 := 0
    mut q1 := 0
    mut q2 := 0
    mut i := 0
    until i < n:
        code := _ub(bp, i)
        i += 1
        if code != 32 && code != 9 && code != 10 && code != 13:
            v := _b64val(code)
            if v >= 0:
                if qi == 0:
                    q0 = v
                    qi = 1
                else qi == 1:
                    q1 = v
                    qi = 2
                else qi == 2:
                    q2 = v
                    qi = 3
                else:
                    str.BufAppendChar(sb, q0 * 4 + q1 / 16)
                    str.BufAppendChar(sb, (q1 % 16) * 16 + q2 / 4)
                    str.BufAppendChar(sb, (q2 % 4) * 64 + v)
                    qi = 0
                end
            end
        end
    end
    if qi >= 2:
        str.BufAppendChar(sb, q0 * 4 + q1 / 16)
    end
    if qi >= 3:
        str.BufAppendChar(sb, (q1 % 16) * 16 + q2 / 4)
    end
    out := str.BufStr(sb)
    ret out
end

@en "HexEncode"
@fa "کدگذاری شانزده"
@ar "ترمیز سداسی"
pub func HexEncode(data: str): str:
    digits := "0123456789abcdef"
    hp := _bp(digits)
    dp := _bp(data)
    n := data.len()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n with i:
        b := _ub(dp, i)
        str.BufAppendChar(sb, _ub(hp, b / 16))
        str.BufAppendChar(sb, _ub(hp, b % 16))
    end
    out := str.BufStr(sb)
    ret out
end

@en "HexVal"
@fa "مقدار شانزده"
@ar "قیمة سداسیة"
pub inline pure func HexVal(c: str): int: ret _hexval(char_code(c)) end

@en "HexDecode"
@fa "کدگشایی شانزده"
@ar "فک ترمیز سداسی"
pub func HexDecode(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i + 1 < n:
        hi := _hexval(_ub(bp, i))
        lo := _hexval(_ub(bp, i + 1))
        if hi < 0 || lo < 0:
            out0 := str.BufStr(sb)
            ret out0
        end
        str.BufAppendChar(sb, hi * 16 + lo)
        i += 2
    end
    out := str.BufStr(sb)
    ret out
end

@en "URLEncode"
@fa "کدگذاری نشانی"
@ar "ترمیز عنوان"
pub func URLEncode(s: str): str:
    digits := "0123456789ABCDEF"
    hp := _bp(digits)
    bp := _bp(s)
    n := s.len()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n with i:
        code := _ub(bp, i)
        if _url_safe(code):
            str.BufAppendChar(sb, code)
        else:
            str.BufAppendChar(sb, 37)
            str.BufAppendChar(sb, _ub(hp, code / 16))
            str.BufAppendChar(sb, _ub(hp, code % 16))
        end
    end
    out := str.BufStr(sb)
    ret out
end

@en "URLDecode"
@fa "کدگشایی نشانی"
@ar "فک ترمیز عنوان"
pub func URLDecode(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        code := _ub(bp, i)
        if code == 37 && i + 2 < n:
            hi := _hexval(_ub(bp, i + 1))
            lo := _hexval(_ub(bp, i + 2))
            if hi >= 0 && lo >= 0:
                str.BufAppendChar(sb, hi * 16 + lo)
                i += 3
            else:
                str.BufAppendChar(sb, code)
                i += 1
            end
        else:
            if code == 43:
                str.BufAppendChar(sb, 32)
            else:
                str.BufAppendChar(sb, code)
            end
            i += 1
        end
    end
    out := str.BufStr(sb)
    ret out
end

// Base64 decode that REPORTS failure instead of skipping what it cannot read.
//
// Base64Decode above is deliberately lenient: any byte outside the alphabet is
// ignored, which is what you want for hand-wrapped text. That is the wrong
// default for anything security-relevant, where a corrupted block should be
// rejected rather than silently decoded into whatever survived the skipping.
// PEM trust stores are the motivating case.
//
// LIMITATION: the result is a `str`, so this cannot carry arbitrary binary.
// Decoded data containing a 0x00 byte is truncated there by any caller that
// measures the result. Base64 of text is fine; base64 of a certificate, a key
// or a compressed blob is not. std/tls decodes PEM into its own byte buffer
// for exactly this reason. A byte-oriented variant writing into a caller
// buffer would fix it and is worth adding.
//
// Whitespace is still accepted, since every real encoder wraps lines. `ok` is
// set false on any other stray character, on data after padding, or on a
// length that cannot be a whole number of quanta.
@en "Base64DecodeStrict"
@fa "کدگشایی شصت و چهار سخت گیرانه"
@ar "فك ترمیز ستة أربعة صارم"
pub func Base64DecodeStrict(s: str, ok &: bool): str:
    ok = true
    n := s.len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut acc := 0
    mut nbits := 0
    mut pad := 0
    mut ndigits := 0
    mut i := 0
    until i < n:
        code := _ub(bp, i)
        i += 1
        if code == 32 || code == 9 || code == 10 || code == 13:
            continue
        end
        if code == 61:
            pad += 1
            if pad > 2:
                ok = false
                ret ""
            end
            continue
        end
        if pad > 0:
            // data after padding is malformed, not merely odd
            ok = false
            ret ""
        end
        v := _b64val(code)
        if v < 0:
            ok = false
            ret ""
        end
        ndigits += 1
        acc = acc * 64 + v
        nbits += 6
        if nbits >= 8:
            nbits -= 8
            mut shift := 1
            repeat nbits with _k:
                shift = shift * 2
            end
            str.BufAppendChar(sb, (acc / shift) % 256)
            acc = acc % shift
        end
    end
    if (ndigits + pad) % 4 != 0:
        ok = false
        ret ""
    end
    out := str.BufStr(sb)
    ret out
end

// Strict, binary-safe base64 decode into a caller-supplied buffer.
//
// This is the form to use for anything that is not text. The `str`-returning
// decoders above cannot carry binary at all: decoded data containing a 0x00
// byte is truncated there by any caller that measures the result, which rules
// them out for certificates, keys and compressed blobs.
//
// Returns the number of bytes written, or 0 with `ok` false. `ok` is set false
// on a stray character, on data after padding, on a length that is not a whole
// number of quanta, or if the output would exceed `cap`. Whitespace is
// accepted, since every real encoder wraps lines.
@en "Base64DecodeBytes"
@fa "کدگشایی شصت و چهار به بایت"
@ar "فك ترمیز ستة أربعة إلى بایتات"
pub func Base64DecodeBytes(s: str, out: void*, cap: int, ok &: bool): int:
    ok = true
    n := s.len()
    bp := _bp(s)
    op := out as u8*
    mut written := 0
    mut acc := 0
    mut nbits := 0
    mut pad := 0
    mut ndigits := 0
    mut i := 0
    until i < n:
        code := _ub(bp, i)
        i += 1
        if code == 32 || code == 9 || code == 10 || code == 13:
            continue
        end
        if code == 61:
            pad += 1
            if pad > 2:
                ok = false
                ret 0
            end
            continue
        end
        if pad > 0:
            // data after padding is malformed, not merely unusual
            ok = false
            ret 0
        end
        v := _b64val(code)
        if v < 0:
            ok = false
            ret 0
        end
        ndigits += 1
        acc = acc * 64 + v
        nbits += 6
        if nbits >= 8:
            nbits -= 8
            mut shift := 1
            repeat nbits with _k:
                shift = shift * 2
            end
            if written >= cap:
                ok = false
                ret 0
            end
            op[written] = ((acc / shift) % 256) as u8
            written += 1
            acc = acc % shift
        end
    end
    if (ndigits + pad) % 4 != 0:
        ok = false
        ret 0
    end
    ret written
end
