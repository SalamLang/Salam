@en "envfile"
@fa "پرونده محیط"
package envfile

import collections

const _LITERAL := 0
const _EXPANDABLE := 1

@en "Doc"
@fa "سند"
pub struct Doc:
    @en "m"
    @fa "نگاشت"
    pub m: collections.OrderedMap = collections.OrderedMap {}
    @en "flags"
    @fa "پرچم‌های جایگذاری"
    pub flags: Vector<int> = Vector {}
end

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

func _push(d &: Doc, key: str, val: str, flag: int):
    i := d.m.Set(key, val)
    if i == d.flags.Len():
        d.flags.Push(flag)
    else:
        d.flags.Set(i, flag)
    end
end

@en "New"
@fa "جدید"
pub func New(): Doc:
    ret Doc {}
end

@en "Len"
@fa "طول"
pub func Len(d &: Doc): int: ret d.m.Len() end

@en "Has"
@fa "دارد"
pub func Has(d &: Doc, key: str): bool: ret d.m.Has(key) end

@en "Get"
@fa "دریافت"
pub func Get(d &: Doc, key: str): str: ret d.m.Get(key) end

@en "GetOr"
@fa "دریافت با پیش فرض"
pub func GetOr(d &: Doc, key: str, def: str): str: ret d.m.GetOr(key, def) end

@en "Set"
@fa "تنظیم"
pub func Set(d &: Doc, key: str, val: str):
    _push(d, key, val, _LITERAL)
end

@en "Remove"
@fa "حذف"
pub func Remove(d &: Doc, key: str): bool:
    i := d.m.Remove(key)
    if i < 0: ret false end
    d.flags.RemoveAt(i)
    ret true
end

@en "KeyAt"
@fa "کلید در"
pub func KeyAt(d &: Doc, i: int): str: ret d.m.key_at(i) end

@en "ValueAt"
@fa "مقدار در"
pub func ValueAt(d &: Doc, i: int): str: ret d.m.val_at(i) end

@en "Keys"
@fa "کلیدها"
pub func Keys(d &: Doc): Vector<str>:
    ret d.m.CloneKeys()
end

@en "MergeInto"
@fa "ادغام در"
pub func MergeInto(dst &: Doc, src &: Doc):
    repeat src.m.Len() in i:
        _push(dst, src.m.key_at(i), src.m.val_at(i), src.flags.Get(i))
    end
end

@en "Free"
@fa "آزادسازی"
pub func Free(d &: Doc):
    d.m.Free()
    d.flags.Free()
end
