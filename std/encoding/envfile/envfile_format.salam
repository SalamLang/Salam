package envfile

import str

// Writing a Doc back out. The one rule that matters here is that
// Parse(Format(d)) must give back d, so anything the reader would treat
// as syntax has to be quoted or escaped on the way out. A '$' is the
// easy one to miss: written bare it would come back as an expansion.

func _special(c: int): bool:
    if c == 32 || c == 9 || c == 10 || c == 13: ret true end
    ret c == 35 || c == 59 || c == 34 || c == 39 || c == 36 || c == 92
end

// Quotes are added only when the value would not survive being written
// bare, so ordinary values stay readable and diffs stay small.
func _needs_quotes(v: str): bool:
    n := v.len()
    if n == 0: ret false end
    if str.Trim(v) != v: ret true end
    bp := _bp(v)
    repeat n with i:
        if _special(_ub(bp, i)): ret true end
    end
    ret false
end

func _escape_dq(v: str): str:
    n := v.len()
    bp := _bp(v)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n with i:
        c := _ub(bp, i)
        if c == 92 || c == 34 || c == 36:
            str.BufAppendChar(sb, 92)
            str.BufAppendChar(sb, c)
        else c == 10:
            str.BufAppend(sb, "\\n")
        else c == 13:
            str.BufAppend(sb, "\\r")
        else c == 9:
            str.BufAppend(sb, "\\t")
        else:
            str.BufAppendChar(sb, c)
        end
    end
    out := str.BufStr(sb)
    ret out
end

func _format(d &: Doc, prefix: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    repeat d.m.len() with i:
        str.BufAppend(b, prefix)
        str.BufAppend(b, d.m.key_at(i))
        str.BufAppend(b, "=")
        str.BufAppend(b, Quote(d.m.val_at(i)))
        str.BufAppend(b, "\n")
    end
    out := str.BufStr(b)
    ret out
end

// Renders one value as .env source: bare when that round-trips, double
// quoted with escapes when it does not. Shared with std/config, which
// needs the same decision for INI values.
@en "Quote"
@fa "نقل قول"
@ar "اقتباس"
pub func Quote(v: str): str:
    if _needs_quotes(v) == false: ret v end
    ret `"`.concat(_escape_dq(v)).concat(`"`)
end

@en "Format"
@fa "قالب"
@ar "تنسیق"
pub func Format(d &: Doc): str:
    ret _format(d, "")
end

// Same output with an 'export ' prefix on every line, for a file meant
// to be sourced by a POSIX shell rather than read by a program.
@en "FormatExport"
@fa "قالب صادراتی"
@ar "تنسیق تصدیر"
pub func FormatExport(d &: Doc): str:
    ret _format(d, "export ")
end
