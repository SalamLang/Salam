package json

import conv
import str

func __jdnew(): str.StringBuilder:
    ret str.NewBuilder()
end

func __jdadd(b &: str.StringBuilder, s: str):
    str.BufAppend(b, s)
end

func __jdfin(b &: str.StringBuilder): str:
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func __jdqs(s: str): str:
    l := s.len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    repeat l with i:
        code := _ub(bp, i)
        if code == 34:
            str.BufAppend(sb, "\\\"")
        else code == 92:
            str.BufAppend(sb, "\\\\")
        else code == 10:
            str.BufAppend(sb, "\\n")
        else code == 9:
            str.BufAppend(sb, "\\t")
        else code == 13:
            str.BufAppend(sb, "\\r")
        else code == 8:
            str.BufAppend(sb, "\\b")
        else code == 12:
            str.BufAppend(sb, "\\f")
        else code < 32:
            str.BufAppend(sb, "\\u00")
            str.BufAppendChar(sb, __jdhex(code / 16))
            str.BufAppendChar(sb, __jdhex(code % 16))
        else:
            str.BufAppendChar(sb, code)
        end
    end
    body := str.BufStr(sb)
    str.BufFree(sb)
    ret "\"" + body + "\""
end

func __jdhex(n: int): int:
    if n < 10: ret 48 + n end
    ret 87 + n
end

func __jdi(n: i64): str:
    ret conv.FormatInt(n)
end

func __jdu(n: u64): str:
    ret conv.FormatUint(n)
end

if SALAM_KERNEL:
else:
func __jdf(x: f64): str:
    if x != x: ret "null" end
    if x > 1.7976931348623157e308: ret "null" end
    if x < -1.7976931348623157e308: ret "null" end
    ret conv.FormatFloat(x)
end
end

func __jdb(v: bool): str:
    if v: ret "true" end
    ret "false"
end

func __jdch(code: int): str:
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, code)
    one := str.BufStr(sb)
    str.BufFree(sb)
    ret __jdqs(one)
end
