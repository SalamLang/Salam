package json

import str
import mem

// The scanning half of the runtime layer the compiler-derived JSON decoders
// call. See json_derive.salam for the encoding half and for why none of this
// is public.
//
// Every scanner reports failure through an `endpos` of -1 rather than a
// sentinel value a caller would have to know how to recognise, so a generated
// body checks one thing after every read no matter what it read.


// _derr - the single failure path. Returns -1 so a generated body can say
// `ret _derr(...)` in one line, and leaves the first error in place: a struct
// twelve levels down reports where it actually went wrong rather than having
// its message overwritten by every frame on the way out.
func _derr(e &: str, ep &: int, msg: str, pos: int): int:
    if e == "":
        e = msg
        ep = pos
    end
    ret -1
end

// _dbyte - the byte at `i`, or -1 at the end of the document.
//
// A str is NUL-terminated, and that terminator is what marks the end here: a
// bounds test would be `i >= s.len()`, and s.len() is strlen, so asking it once
// per byte makes decoding quadratic in the size of the document. A 1 MB payload
// took minutes before this read the terminator instead.
func _dbyte(s: str, i: int): int:
    if i < 0: ret -1 end
    v := _ub(_bp(s), i)
    if v == 0: ret -1 end
    ret v
end

// _dat - true when `word` sits at `i`. Used for the three JSON literals.
// Byte-by-byte for the same reason _dbyte is.
func _dat(s: str, i: int, word: str): bool:
    if i < 0: ret false end
    n := word.len()
    bp := _bp(s)
    wp := _bp(word)
    repeat n with k:
        if _ub(bp, i + k) != _ub(wp, k): ret false end
    end
    ret true
end

// _dws - whitespace skip. json.salam's _jws is the same scan but measures the
// string first; every generated decoder calls this between every token.
func _dws(s: str, i: int): int:
    mut p := i
    if p < 0: p = 0 end
    bp := _bp(s)
    until true:
        c := _ub(bp, p)
        if c != 32 && c != 9 && c != 10 && c != 13: ret p end
        p += 1
    end
end

// _dnum - the extent of a JSON number at `i`, or -1. json.salam's _jnum again,
// without the leading strlen.
func _dnum(s: str, i: int): int:
    bp := _bp(s)
    mut p := i
    if _ub(bp, p) == 45: p += 1 end
    start := p
    p = _ddigits(bp, p)
    if p == start: ret -1 end
    if _ub(bp, p) == 46:
        p = _ddigits(bp, p + 1)
    end
    if _ub(bp, p) == 101 || _ub(bp, p) == 69:
        p += 1
        if _ub(bp, p) == 43 || _ub(bp, p) == 45: p += 1 end
        p = _ddigits(bp, p)
    end
    ret p
end

func _ddigits(bp: i8*, i: int): int:
    mut p := i
    until true:
        c := _ub(bp, p)
        if c < 48 || c > 57: ret p end
        p += 1
    end
end

// _dstrend - the position just past a string token, without decoding it.
// json.salam's _jstr, again without the leading strlen.
func _dstrend(s: str, i: int): int:
    bp := _bp(s)
    if _ub(bp, i) != 34: ret -1 end
    mut p := i + 1
    until true:
        c := _ub(bp, p)
        if c == 0: ret -1 end
        if c == 34: ret p + 1 end
        if c == 92:
            p += 1
            if _ub(bp, p) == 0: ret -1 end
        end
        p += 1
    end
end

func _dnullat(s: str, i: int): int:
    if _dat(s, i, "null"): ret i + 4 end
    ret -1
end

// _dalloc - storage for a pointer field the document turned out to have a
// value for. Salam has no address-of operator, so a decoded pointee has to
// live on the heap; zeroed, so a field the derived body does not reach keeps
// a defined value.
func _dalloc(n: u64): void*:
    ret mem.AllocateZeroed(n)
end

// _dgstr - decodes a JSON string at `i`, resolving escapes. endpos is the
// position just past the closing quote, or -1 when there is no string here.
func _dgstr(s: str, i: int, endpos &: int): str:
    bp := _bp(s)
    if i < 0 || _ub(bp, i) != 34:
        endpos = -1
        ret ""
    end
    mut sb := str.NewBuilder()
    mut p := i + 1
    until true:
        c := _ub(bp, p)
        if c == 0: break end
        if c == 34:
            endpos = p + 1
            out := str.BufStr(sb)
            str.BufFree(sb)
            ret out
        end
        if c == 92:
            p += 1
            e := _ub(bp, p)
            if e == 0: break end
            if e == 34: str.BufAppendChar(sb, 34)
            else e == 92: str.BufAppendChar(sb, 92)
            else e == 47: str.BufAppendChar(sb, 47)
            else e == 98: str.BufAppendChar(sb, 8)
            else e == 102: str.BufAppendChar(sb, 12)
            else e == 110: str.BufAppendChar(sb, 10)
            else e == 114: str.BufAppendChar(sb, 13)
            else e == 116: str.BufAppendChar(sb, 9)
            else e == 117:
                q := _dcp(s, p, sb)
                if q < 0: break end
                p = q
            else:
                str.BufFree(sb)
                endpos = -1
                ret ""
            end
            p += 1
        else:
            str.BufAppendChar(sb, c)
            p += 1
        end
    end
    str.BufFree(sb)
    endpos = -1
    ret ""
end

// _dslice - the bytes of s[i..e] as their own string. s.substr does the same
// thing but measures s first, and s here is the whole document: one substr per
// number is one full scan per number, which is quadratic all over again.
func _dslice(s: str, i: int, e: int): str:
    bp := _bp(s)
    mut sb := str.NewBuilder()
    mut p := i
    until p < e:
        str.BufAppendChar(sb, _ub(bp, p))
        p += 1
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _dhex4(s: str, i: int): int:
    mut v := 0
    repeat 4 with k:
        d := _dhexval(_dbyte(s, i + k))
        if d < 0: ret -1 end
        v = v * 16 + d
    end
    ret v
end

func _dhexval(c: int): int:
    if c >= 48 && c <= 57: ret c - 48 end
    if c >= 97 && c <= 102: ret c - 87 end
    if c >= 65 && c <= 70: ret c - 55 end
    ret -1
end

// _dcp - resolves the \uXXXX escape whose 'u' sits at `p` and appends the code
// point it denotes as UTF-8. Returns the index of the last byte consumed, or
// -1 when the four hex digits are not there.
//
// Python's json.dumps and PHP's json_encode escape every non-ASCII character
// by default, so this - not the raw-UTF-8 path - is what a Salam service
// actually receives from such a client. Appending the value as a single byte
// truncated each code point to its low byte, so U+0645 arrived as 'E' and a
// Persian name reached the database as mojibake with no error anywhere.
//
// A code point past the BMP is written as a UTF-16 surrogate pair
// (`\uD83D\uDE00`), so a high surrogate looks ahead for its low half and
// joins the two. A surrogate that stays unpaired is not a code point at all;
// it becomes U+FFFD rather than the CESU-8 that encoding it on its own would
// produce.
func _dcp(s: str, p: int, sb &: str.StringBuilder): int:
    hi := _dhex4(s, p + 1)
    if hi < 0: ret -1 end
    mut q := p + 4
    mut cp := hi
    if hi >= 0xD800 && hi <= 0xDBFF && _dbyte(s, q + 1) == 92 && _dbyte(s, q + 2) == 117:
        lo := _dhex4(s, q + 3)
        if lo >= 0xDC00 && lo <= 0xDFFF:
            cp = 0x10000 + ((hi - 0xD800) * 0x400) + (lo - 0xDC00)
            q = q + 6
        end
    end
    if cp >= 0xD800 && cp <= 0xDFFF: cp = 0xFFFD end
    str.BufAppendCp(sb, cp)
    ret q
end

// _dpint - digits to i64, by hand. str.to_int() is 32 bits wide, so an id
// past two billion would come back saturated and a range check downstream
// would see a value that was in range only because it had already been
// clipped. Overflow is reported, never clamped.
func _dpint(s: str, beg: int, stop: int, neg: bool, ok &: bool): i64:
    mut v := 0 as i64
    mut p := beg
    ok = true
    if p >= stop:
        ok = false
        ret 0
    end
    until p < stop:
        d := (_dbyte(s, p) - 48) as i64
        if v > 922337203685477580 as i64:
            ok = false
            ret 0
        end
        v = v * (10 as i64)
        if v > (9223372036854775807 as i64) - d:
            ok = false
            ret 0
        end
        v = v + d
        p += 1
    end
    if neg: ret 0 as i64 - v end
    ret v
end

func _dpuint(s: str, beg: int, stop: int, ok &: bool): u64:
    mut v := 0 as u64
    mut p := beg
    ok = true
    if p >= stop:
        ok = false
        ret 0
    end
    until p < stop:
        d := (_dbyte(s, p) - 48) as u64
        if v > 1844674407370955161 as u64:
            ok = false
            ret 0
        end
        v = v * (10 as u64)
        if v > (18446744073709551615 as u64) - d:
            ok = false
            ret 0
        end
        v = v + d
        p += 1
    end
    ret v
end

// _dgint - a JSON number that has to land in an integer. A fractional or
// exponent form is rejected rather than truncated: a decoder that silently
// turns 1.9 into 1 hides a schema mismatch instead of reporting it.
func _dgint(s: str, i: int, endpos &: int): i64:
    e := _dnum(s, i)
    if e < 0 || e == i || _dfractional(s, i, e):
        endpos = -1
        ret 0
    end
    neg := _dbyte(s, i) == 45
    mut ok := false
    mut start := i
    if neg: start = i + 1 end
    v := _dpint(s, start, e, neg, ok)
    if ok == false:
        endpos = -1
        ret 0
    end
    endpos = e
    ret v
end

// A number an integer field cannot take: it has a fraction or an exponent.
// Read off the bytes rather than a substring, so decoding a large document
// does not allocate once per number.
func _dfractional(s: str, i: int, e: int): bool:
    bp := _bp(s)
    mut p := i
    until p < e:
        c := _ub(bp, p)
        if c == 46 || c == 101 || c == 69: ret true end
        p += 1
    end
    ret false
end

func _dguint(s: str, i: int, endpos &: int): u64:
    e := _dnum(s, i)
    if e < 0 || e == i || _dfractional(s, i, e):
        endpos = -1
        ret 0
    end
    if _dbyte(s, i) == 45:
        endpos = -1
        ret 0
    end
    mut ok := false
    v := _dpuint(s, i, e, ok)
    if ok == false:
        endpos = -1
        ret 0
    end
    endpos = e
    ret v
end

func _dgflt(s: str, i: int, endpos &: int): f64:
    e := _dnum(s, i)
    if e < 0 || e == i:
        endpos = -1
        ret 0.0
    end
    endpos = e
    ret _dslice(s, i, e).to_float()
end

func _dgbool(s: str, i: int, endpos &: int): bool:
    if _dat(s, i, "true"):
        endpos = i + 4
        ret true
    end
    if _dat(s, i, "false"):
        endpos = i + 5
        ret false
    end
    endpos = -1
    ret false
end

// _dgch - the one-character string a `char` field encodes to.
func _dgch(s: str, i: int, endpos &: int): int:
    text := _dgstr(s, i, endpos)
    if endpos < 0: ret 0 end
    if text.len() != 1:
        endpos = -1
        ret 0
    end
    ret _dbyte(text, 0)
end

// _drange - the bounds check a narrow integer field needs. i64 is what every
// JSON number decodes to; a u8 field handed 300 is a schema error, not a
// value to truncate.
func _drange(v: i64, lo: i64, hi: i64, endpos &: int): i64:
    if endpos < 0: ret 0 end
    if v < lo || v > hi:
        endpos = -1
        ret 0
    end
    ret v
end

// _dskip - steps over one complete value without decoding it, for the
// unknown keys a lenient decode is allowed to drop. -1 when the text is not
// a value at all.
func _dskip(s: str, i: int): int:
    p := _dws(s, i)
    c := _dbyte(s, p)
    if c == 34:
        ret _dstrend(s, p)
    end
    if c == 123: ret _dskip_pair(s, p, 123, 125) end
    if c == 91: ret _dskip_pair(s, p, 91, 93) end
    if _dat(s, p, "true"): ret p + 4 end
    if _dat(s, p, "false"): ret p + 5 end
    if _dat(s, p, "null"): ret p + 4 end
    ret _dnum(s, p)
end

// Bracket matching that steps over strings, so a '}' inside a value does not
// close the object that contains it.
func _dskip_pair(s: str, i: int, open: int, close: int): int:
    mut depth := 0
    mut p := i
    until true:
        c := _dbyte(s, p)
        if c < 0: ret -1 end
        if c == 34:
            q := _dstrend(s, p)
            if q < 0: ret -1 end
            p = q
            continue
        end
        if c == open: depth += 1 end
        if c == close:
            depth -= 1
            if depth == 0: ret p + 1 end
        end
        p += 1
    end
end
