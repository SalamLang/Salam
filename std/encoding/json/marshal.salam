package json

import str

func _dec_kind(text: str, msg: str, pos: int): ErrorKind:
    if msg.starts_with("missing key"):
        ret ErrorKind.MissingKey
    end
    if msg.starts_with("unknown key") or msg.starts_with("duplicate key") or msg.starts_with("no enum member") or msg.starts_with("value rejected"):
        ret ErrorKind.InvalidArgument
    end
    if _jws(text, pos) >= text.Len():
        ret ErrorKind.UnexpectedEnd
    end
    if msg.starts_with("value does not match"):
        ret ErrorKind.TypeMismatch
    end
    ret ErrorKind.Syntax
end

@en "Marshal"
@fa "سریال سازی"
pub func Marshal<T>(v: T): str:
    ret jsonenc(v)
end

@en "MarshalIndent"
@fa "سریال سازی با تورفتگی"
pub func MarshalIndent<T>(v: T, unit: str): str:
    ret IndentWith(jsonenc(v), unit)
end

@en "Unmarshal"
@fa "واسریال سازی"
pub func Unmarshal<T>(text: str, out &: T) throws:
    mut msg := ""
    mut pos := 0
    p := jsondec(text, 0, out, msg, pos, true)
    if p < 0:
        throw Error.At(_dec_kind(text, msg, pos), msg, pos).locate(text).wrap("json")
    end
    q := _jws(text, p)
    if q < text.Len():
        throw Error.At(ErrorKind.Syntax, "trailing data after JSON value", q).with_code("json.trailing_data").locate(text).wrap("json")
    end
end

@en "UnmarshalLenient"
@fa "واسریال سازی آسان گیر"
pub func UnmarshalLenient<T>(text: str, out &: T) throws:
    mut msg := ""
    mut pos := 0
    p := jsondec(text, 0, out, msg, pos, false)
    if p < 0:
        throw Error.At(_dec_kind(text, msg, pos), msg, pos).locate(text).wrap("json")
    end
    q := _jws(text, p)
    if q < text.Len():
        throw Error.At(ErrorKind.Syntax, "trailing data after JSON value", q).with_code("json.trailing_data").locate(text).wrap("json")
    end
end
