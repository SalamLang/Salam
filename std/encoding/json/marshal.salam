package json

import str
import encoding.encerr

@en "Marshal"
@fa "سریال سازی"
pub func Marshal<T>(v: T): str:
    ret jsonenc(v)
end

@en "MarshalIndent"
@fa "سریال سازی با تورفتگی"
pub func MarshalIndent<T>(v: T, unit: str): str:
    ret IndentWith(jsonenc(v), unit)
end

@en "Unmarshal"
@fa "واسریال سازی"
pub func Unmarshal<T>(text: str, out &: T, err &: encerr.EncodingError): bool:
    mut msg := ""
    mut pos := 0
    p := jsondec(text, 0, out, msg, pos, true)
    if p < 0:
        err = encerr.ErrUnexpectedToken(msg, pos)
        ret false
    end
    q := _jws(text, p)
    if q < text.len():
        err = encerr.NewError(encerr.KindTrailingData, "trailing data after JSON value", q)
        ret false
    end
    ret true
end

@en "UnmarshalLenient"
@fa "واسریال سازی آسان گیر"
pub func UnmarshalLenient<T>(text: str, out &: T, err &: encerr.EncodingError): bool:
    mut msg := ""
    mut pos := 0
    p := jsondec(text, 0, out, msg, pos, false)
    if p < 0:
        err = encerr.ErrUnexpectedToken(msg, pos)
        ret false
    end
    q := _jws(text, p)
    if q < text.len():
        err = encerr.NewError(encerr.KindTrailingData, "trailing data after JSON value", q)
        ret false
    end
    ret true
end
