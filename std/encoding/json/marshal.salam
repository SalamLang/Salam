package json

import str
import encoding.encerr

// Typed JSON, without writing a codec by hand.
//
//     struct User:
//         pub name: str = ""
//         pub age: int = 0
//     end
//
//     text := json.Marshal(u)
//     mut back := User {}
//     mut err := encerr.NoError()
//     if json.Unmarshal(text, back, err): ...
//
// These are generic wrappers over two compiler hooks. Each is monomorphised
// per concrete type before its body is checked, and `jsonenc`/`jsondec` then
// derive a codec for that exact type (c/src/semantic/sema_derive_json.c). The
// result is ordinary generated code: no reflection, no runtime type tags, and
// nothing to keep in step by hand when a field is added.
//
// A field can say how it appears on the wire:
//
//     @json "user_name"                renames it
//     @json "-"                        drops it from both directions
//     @json "" "omitempty"             leaves it out when empty, and lets it
//                                      be missing on the way back in
//     @json "" "optional"              lets it be missing
//     @json "" "string"                sends a number or bool as a string
//
// Decoding is strict: an unknown key, a missing key that is not optional, a
// repeated key or a value of the wrong type all fail with a position.
// UnmarshalLenient drops the first three and keeps a missing field's default.

@en "Marshal"
@fa "سریال سازی"
@ar "تسلسل"
pub func Marshal<T>(v: T): str:
    ret jsonenc(v)
end

@en "MarshalIndent"
@fa "سریال سازی با تورفتگی"
@ar "تسلسل مع مسافة"
pub func MarshalIndent<T>(v: T, unit: str): str:
    ret IndentWith(jsonenc(v), unit)
end

@en "Unmarshal"
@fa "واسریال سازی"
@ar "فك التسلسل"
pub func Unmarshal<T>(text: str, out &: T, err &: encerr.EncodingError): bool:
    mut msg := ""
    mut pos := 0
    p := jsondec(text, 0, out, msg, pos, true)
    if p < 0:
        err = encerr.ErrUnexpectedToken(msg, pos)
        ret false
    end
    q := _jws(text, p)
    if q < text.len():
        err = encerr.NewError(encerr.KindTrailingData, "trailing data after JSON value", q)
        ret false
    end
    ret true
end

@en "UnmarshalLenient"
@fa "واسریال سازی آسان گیر"
@ar "فك التسلسل المتساهل"
pub func UnmarshalLenient<T>(text: str, out &: T, err &: encerr.EncodingError): bool:
    mut msg := ""
    mut pos := 0
    p := jsondec(text, 0, out, msg, pos, false)
    if p < 0:
        err = encerr.ErrUnexpectedToken(msg, pos)
        ret false
    end
    q := _jws(text, p)
    if q < text.len():
        err = encerr.NewError(encerr.KindTrailingData, "trailing data after JSON value", q)
        ret false
    end
    ret true
end
