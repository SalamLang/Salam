package json

// What a type looks like on the wire, as a JSON Schema document.
//
//     struct User:
//         pub name: str = ""
//         @json "" "omitempty"
//         pub nickname: str = ""
//     end
//
//     println json.Schema(User {})
//
//     {"$schema":"https://json-schema.org/draft/2020-12/schema",
//      "$defs":{"User":{"title":"User","type":"object","properties":{
//         "name":{"type":"string"},"nickname":{"type":"string"}},
//         "required":["name"],"additionalProperties":false}},
//      "$ref":"#/$defs/User"}
//
// The argument is a value, not a type, only because that is how a generic
// binds: nothing reads it, and `User {}` is the usual way to write one. What
// comes back is derived from the declaration - the same pass, the same
// `@json` markers and the same field walk that produce Marshal's encoder (see
// compiler/semantic/sema_derive_json_schema.salam), so a schema cannot fall
// out of step with the codec that implements it. A field left out of
// `required` is one marked `omitempty` or `optional`; `additionalProperties`
// is false because Unmarshal rejects unknown keys.
//
// Every named struct and enum reached becomes a `$defs` entry referenced by
// `$ref`, which is what lets a self-referential type - a tree node holding a
// Vector of itself - have a schema at all.

// The envelope `jsonschema` hands back, before the two halves are merged:
//
//     {"defs":{"User":{...}},"schema":{"$ref":"#/$defs/User"}}
//
// Schema below merges them into one document. net/http/swagger wants them
// apart instead - the defs belong in `components/schemas` there, not in
// `$defs` - so it takes the envelope and splits it with Get.
@en "SchemaEnvelope"
@fa "پوشش طرحواره"
@ar "غلاف المخطط"
pub func SchemaEnvelope<T>(v: T): str:
    ret jsonschema(v)
end

// A standalone JSON Schema document for `T`.
@en "Schema"
@fa "طرحواره"
@ar "مخطط"
pub func Schema<T>(v: T): str:
    ret SchemaMerge(jsonschema(v))
end

// The merge step, on an envelope from SchemaEnvelope. Split out so a caller
// holding an envelope already does not have to derive a second one.
@en "SchemaMerge"
@fa "ادغام طرحواره"
@ar "دمج المخطط"
pub func SchemaMerge(envelope: str): str:
    root := Get(envelope, "schema")
    defs := Get(envelope, "defs")
    if root.len() < 2:
        ret "{}"
    end
    mut out := "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\""
    // "{}" is two characters and means the type reached no named struct or
    // enum - a scalar, or an array of one.
    if defs.len() > 2:
        out = out.concat(",\"$defs\":").concat(defs)
    end
    inner := root.substr(1, root.len() - 2)
    if inner.len() > 0:
        out = out.concat(",").concat(inner)
    end
    ret out.concat("}")
end
