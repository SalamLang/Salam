package json

import encoding.value
import encoding.encerr
import io
import str

@en "JSONEncoder"
@fa "کدگذار جیسون"
pub struct JSONEncoder:
    pub dst: File* = null
    pub useFile: bool = false
    pub buf: str.StringBuilder = str.StringBuilder {}
    pub indent: str = ""
    pub count: int = 0

    @en "Encode"
    @fa "کدگذاری"
    pub func Encode(v: value.Value): bool:
        mut text := _encode_value(v, JSONOptions {})
        if this.indent != "": text = IndentWith(text, this.indent) end
        if this.count > 0:
            if this.useFile: this.dst.write("\n") else:
                str.BufAppendChar(this.buf, 10)
            end
        end
        if this.useFile:
            this.dst.write(text)
        else:
            str.BufAppend(this.buf, text)
        end
        this.count += 1
        ret true
    end

    @en "String"
    @fa "متن"
    pub func String(): str: ret str.BufStr(this.buf) end

    @en "Close"
    @fa "بستن"
    pub func Close():
        if this.useFile and this.dst != null: this.dst.close() end
    end
end

@en "JSONDecoder"
@fa "کدگشای جیسون"
pub struct JSONDecoder:
    pub src: File* = null
    pub useFile: bool = false
    pub buf: str = ""
    pub pos: int = 0
    pub loaded: bool = false
    pub eof: bool = false
    pub bad: bool = false

    func _ensureLoaded():
        if this.loaded: ret end
        if this.useFile: this.buf = io.ReadAll(this.src) end
        this.loaded = true
    end

    @en "More"
    @fa "باز هم"
    pub func More(): bool:
        this._ensureLoaded()
        p := _skip_ws(this.buf, this.pos)
        ret p < this.buf.len()
    end

    @en "Decode"
    @fa "کدگشایی"
    pub func Decode(): value.Value:
        this._ensureLoaded()
        p := _skip_ws(this.buf, this.pos)
        if p >= this.buf.len():
            this.eof = true
            ret value.ValueNull()
        end
        mut ep := p
        mut err := encerr.NoError()
        v := _pval(this.buf, p, ep, err)
        if encerr.IsError(err):
            this.bad = true
            this.eof = true
            ret value.ValueNull()
        end
        this.pos = ep
        ret v
    end
end

@en "NewEncoder"
@fa "کدگذار جدید"
pub func NewEncoder(f: File*): JSONEncoder:
    mut e := JSONEncoder {}
    e.dst = f
    e.useFile = true
    ret e
end

@en "NewEncoderIndent"
@fa "کدگذار جدید با تورفتگی"
pub func NewEncoderIndent(f: File*, unit: str): JSONEncoder:
    mut e := NewEncoder(f)
    e.indent = unit
    ret e
end

@en "NewBufEncoder"
@fa "کدگذار حافظه"
pub func NewBufEncoder(): JSONEncoder:
    ret JSONEncoder {}
end

@en "NewBufEncoderIndent"
@fa "کدگذار حافظه با تورفتگی"
pub func NewBufEncoderIndent(unit: str): JSONEncoder:
    mut e := JSONEncoder {}
    e.indent = unit
    ret e
end

@en "NewDecoder"
@fa "کدگشای جدید"
pub func NewDecoder(f: File*): JSONDecoder:
    mut d := JSONDecoder {}
    d.src = f
    d.useFile = true
    ret d
end

@en "NewBufDecoder"
@fa "کدگشای رشته"
pub func NewBufDecoder(s: str): JSONDecoder:
    mut d := JSONDecoder {}
    d.buf = s
    d.loaded = true
    ret d
end
