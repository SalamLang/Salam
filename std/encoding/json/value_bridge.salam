package json

import compress
import encoding.value
import encoding
import conv
import str

@en "JSONOptions"
@fa "گزینه‌های جیسون"
pub struct JSONOptions:
    @en "indent"
    @fa "تورفتگی"
    pub indent: str = ""
    @en "sort_keys"
    @fa "چیدن کلیدها"
    pub sort_keys: bool = false
    @en "ignore_null"
    @fa "چشم‌پوشی از تهی"
    pub ignore_null: bool = false
end

func _skip_ws_n(s: str, n: int, i: int): int:
    mut p := i
    until p < n:
        c := _ub(_bp(s), p)
        if c != 32 and c != 9 and c != 10 and c != 13: ret p end
        p++
    end
    ret p
end

func _skip_ws(s: str, i: int): int: ret _skip_ws_n(s, str.ByteLen(s), i) end

func _pstr_n(s: str, n: int, i: int, endpos &: int, err &: Error): str:
    bp := _bp(s)
    if i >= n or _ub(bp, i) != 34:
        err = Error.At(ErrorKind.Syntax, `expected '"'`, i)
        endpos = i
        ret ""
    end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut p := i + 1
    until p < n:
        c := _ub(bp, p)
        if c == 34:
            endpos = p + 1
            ret str.BufStr(sb)
        end
        if c == 92:
            p++
            if p >= n:
                err = Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", p)
                endpos = p
                ret str.BufStr(sb)
            end
            e := _ub(bp, p)
            if e == 34: str.BufAppendChar(sb, 34)
            else e == 92: str.BufAppendChar(sb, 92)
            else e == 47: str.BufAppendChar(sb, 47)
            else e == 98: str.BufAppendChar(sb, 8)
            else e == 102: str.BufAppendChar(sb, 12)
            else e == 110: str.BufAppendChar(sb, 10)
            else e == 114: str.BufAppendChar(sb, 13)
            else e == 116: str.BufAppendChar(sb, 9)
            else e == 117:
                q := __jdcp(s, p, sb)
                if q < 0:
                    err = Error.At(ErrorKind.Syntax, "invalid \\u escape", p)
                    endpos = p
                    ret str.BufStr(sb)
                end
                p = q
            else:
                str.BufAppendChar(sb, e)
            end
            p++
        else:
            str.BufAppendChar(sb, c)
            p++
        end
    end
    err = Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", p)
    endpos = p
    ret str.BufStr(sb)
end

func _pval(s: str, i: int, endpos &: int, err &: Error): value.Value:
    ret _pval_d_n(s, str.ByteLen(s), i, endpos, err, 0)
end

func _pval_d_n(s: str, n: int, i: int, endpos &: int, err &: Error, depth: int): value.Value:
    if err.message != "":
        endpos = i
        ret value.ValueNull()
    end
    if depth > 512:
        err = Error.At(ErrorKind.OutOfRange, "JSON nesting is deeper than 512 levels", i)
        endpos = i
        ret value.ValueNull()
    end
    p0 := _skip_ws_n(s, n, i)
    if p0 >= n:
        err = Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", p0)
        endpos = p0
        ret value.ValueNull()
    end
    bp := _bp(s)
    c := _ub(bp, p0)
    if c == 34:
        mut ep := p0
        text := _pstr_n(s, n, p0, ep, err)
        endpos = ep
        ret value.ValueString(text)
    end
    if c == 123:
        mut out := value.NewValueObject()
        mut q := _skip_ws_n(s, n, p0 + 1)
        if q < n and _ub(bp, q) == 125:
            endpos = q + 1
            ret out
        end
        until true:
            q = _skip_ws_n(s, n, q)
            if q >= n or _ub(bp, q) != 34:
                err = q >= n ? Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", q) : Error.At(ErrorKind.Syntax, "expected object key", q)
                endpos = q
                ret out
            end
            mut kend := q
            key := _pstr_n(s, n, q, kend, err)
            if err.message != "": endpos = kend ret out end
            q = _skip_ws_n(s, n, kend)
            if q >= n or _ub(bp, q) != 58:
                err = q >= n ? Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", q) : Error.At(ErrorKind.Syntax, "expected ':'", q)
                endpos = q
                ret out
            end
            mut vend := q + 1
            v := _pval_d_n(s, n, q + 1, vend, err, depth + 1)
            if err.message != "": endpos = vend ret out end
            value.ObjectSet(out, key, v)
            q = _skip_ws_n(s, n, vend)
            if q < n and _ub(bp, q) == 44:
                q++
                continue
            end
            if q < n and _ub(bp, q) == 125:
                endpos = q + 1
                ret out
            end
            err = q >= n ? Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", q) : Error.At(ErrorKind.Syntax, "expected ',' or '}'", q)
            endpos = q
            ret out
        end
    end
    if c == 91:
        mut out := value.NewValueArray()
        mut q := _skip_ws_n(s, n, p0 + 1)
        if q < n and _ub(bp, q) == 93:
            endpos = q + 1
            ret out
        end
        until true:
            mut vend := q
            v := _pval_d_n(s, n, q, vend, err, depth + 1)
            if err.message != "": endpos = vend ret out end
            value.ArrayPush(out, v)
            q = _skip_ws_n(s, n, vend)
            if q < n and _ub(bp, q) == 44:
                q++
                continue
            end
            if q < n and _ub(bp, q) == 93:
                endpos = q + 1
                ret out
            end
            err = q >= n ? Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", q) : Error.At(ErrorKind.Syntax, "expected ',' or ']'", q)
            endpos = q
            ret out
        end
    end
    if p0 + 4 <= n and _match_at(bp, p0, _bp("true"), 4):
        endpos = p0 + 4
        ret value.ValueBool(true)
    end
    if p0 + 5 <= n and _match_at(bp, p0, _bp("false"), 5):
        endpos = p0 + 5
        ret value.ValueBool(false)
    end
    if p0 + 4 <= n and _match_at(bp, p0, _bp("null"), 4):
        endpos = p0 + 4
        ret value.ValueNull()
    end
    ep := _jnum_n(s, n, p0)
    if ep < 0 or ep == p0:
        err = Error.At(ErrorKind.Syntax, "invalid value", p0)
        endpos = p0
        ret value.ValueNull()
    end
    numtext := __jdslice(s, p0, ep)
    endpos = ep
    if str.Contains(numtext, ".") or str.Contains(numtext, "e") or str.Contains(numtext, "E"):
        ret value.ValueFloat(numtext.ToFloat())
    end
    mut fits := true
    v := _parse_i64(numtext, fits)
    if not fits:
        ret value.ValueFloat(numtext.ToFloat())
    end
    ret value.ValueInt(v)
end

func _parse_i64(text: str, fits &: bool): i64:
    fits = true
    n := str.ByteLen(text)
    mut i := 0
    mut neg := false
    if n > 0 and str.ByteSub(text, 0, 1) == "-":
        neg = true
        i = 1
    end
    mut limit := 9223372036854775807 as u64
    if neg:
        limit = 9223372036854775808 as u64
    end
    mut acc := 0 as u64
    until i < n:
        d := (str.ByteSub(text, i, 1).ToInt()) as u64
        if acc > (limit - d) / 10:
            fits = false
            ret 0
        end
        acc = acc * 10 + d
        i++
    end
    if neg:
        ret (0 as u64 - acc) as i64
    end
    ret acc as i64
end

func _sort_keys(keys &: Vector<str>):
    n := keys.Len()
    mut i := 1
    until i < n:
        mut j := i
        until j > 0:
            a := keys.get(j - 1)
            b := keys.get(j)
            if a <= b: break end
            keys.set(j - 1, b)
            keys.set(j, a)
            j--
        end
        i++
    end
end

func _encode_value(v: value.Value, opts: JSONOptions): str:
    if value.IsNull(v): ret "null" end
    if value.IsBool(v):
        if value.AsBool(v): ret "true" end
        ret "false"
    end
    if value.IsInt(v): ret conv.FormatInt(value.AsInt(v)) end
    if value.IsFloat(v):
        if SALAM_KERNEL:
            ret "null"
        else:
            ret conv.FormatFloat(value.AsFloat(v))
        end
    end
    if value.IsString(v): ret Str(value.AsString(v)) end
    if value.IsBytes(v):
        mut b := value.BytesToBuf(v)
        out := Str(encoding.Base64EncodeBytes(b.data, b.len))
        compress.BufFree(b)
        ret out
    end
    if value.IsExt(v):
        mut b := value.ExtDataToBuf(v)
        data := encoding.Base64EncodeBytes(b.data, b.len)
        compress.BufFree(b)
        mut parts := Vector {} as Vector<str>
        parts.push(MemberInt("$ext_type", value.ExtType(v) as i64))
        parts.push(Member("$ext_data", data))
        ret Object(parts)
    end
    if value.IsArray(v):
        mut parts := Vector {} as Vector<str>
        mut i := 0
        n := value.ArrayLen(v)
        until i < n:
            parts.push(_encode_value(value.ArrayGet(v, i), opts))
            i++
        end
        ret Array(parts)
    end
    if value.IsObject(v):
        mut keys := value.ObjectKeys(v)
        if opts.sort_keys: _sort_keys(keys) end
        mut parts := Vector {} as Vector<str>
        mut i := 0
        until i < keys.Len():
            k := keys.get(i)
            fv := value.ObjectGet(v, k)
            if opts.ignore_null and value.IsNull(fv):
                i++
                continue
            end
            parts.push(MemberRaw(k, _encode_value(fv, opts)))
            i++
        end
        ret Object(parts)
    end
    ret "null"
end

@en "Decode"
@fa "کدگشایی"
pub func Decode(text: str): value.Value throws:
    mut err := Error {}
    mut endpos := 0
    v := _pval(text, 0, endpos, err)
    if err.message == "":
        p := _skip_ws(text, endpos)
        if p < str.ByteLen(text):
            err = Error.At(ErrorKind.Syntax, "trailing data after JSON value", p).with_code("json.trailing_data")
        end
    end
    if err.message != "":
        throw err.locate(text).wrap("json")
    end
    ret v
end

@en "Encode"
@fa "کدگذاری"
pub func Encode(v: value.Value, opts: JSONOptions): str:
    text := _encode_value(v, opts)
    if opts.indent != "": ret IndentWith(text, opts.indent) end
    ret text
end

@en "EncodeDefault"
@fa "کدگذاری پیش فرض"
pub func EncodeDefault(v: value.Value): str:
    ret Encode(v, JSONOptions {})
end
