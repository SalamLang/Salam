@en "msgpack"
@fa "مسج‌پک"
package msgpack

import compress
import encoding.binary
import encoding.value

@en "MsgpackOptions"
@fa "گزینه‌های مسج‌پک"
pub struct MsgpackOptions:
    @en "use_str8"
    @fa "قالب کوتاه رشته"
    pub use_str8: bool = true
end

func _fits_u8(v: i64): bool: ret v >= 0 and v <= 255 end
func _fits_u16(v: i64): bool: ret v >= 0 and v <= 65535 end
func _fits_u32(v: i64): bool: ret v >= 0 and v <= 4294967295 end
func _fits_i8(v: i64): bool: ret v >= (0 - 128) and v <= 127 end
func _fits_i16(v: i64): bool: ret v >= (0 - 32768) and v <= 32767 end
func _fits_i32(v: i64): bool: ret v >= (0 - 2147483648) and v <= 2147483647 end

func _marshal_int(buf &: compress.ByteBuf, v: i64):
    if v >= 0 and v <= 127:
        binary.WriteU8(buf, v as int)
        ret
    end
    if v < 0 and v >= (0 - 32):
        binary.WriteU8(buf, (v as int) & 255)
        ret
    end
    if v >= 0:
        if _fits_u8(v):
            binary.WriteU8(buf, 0xcc)
            binary.WriteU8(buf, v as int)
        else _fits_u16(v):
            binary.WriteU8(buf, 0xcd)
            binary.WriteU16BE(buf, v as int)
        else _fits_u32(v):
            binary.WriteU8(buf, 0xce)
            binary.WriteU32BE(buf, v as int)
        else:
            binary.WriteU8(buf, 0xcf)
            binary.WriteU64BE(buf, v)
        end
        ret
    end
    if _fits_i8(v):
        binary.WriteU8(buf, 0xd0)
        binary.WriteU8(buf, (v as int) & 255)
    else _fits_i16(v):
        binary.WriteU8(buf, 0xd1)
        binary.WriteU16BE(buf, (v as int) & 65535)
    else _fits_i32(v):
        binary.WriteU8(buf, 0xd2)
        binary.WriteU32BE(buf, v as int)
    else:
        binary.WriteU8(buf, 0xd3)
        binary.WriteI64BE(buf, v)
    end
end

func _marshal_str(buf &: compress.ByteBuf, s: str, use_str8: bool):
    n := s.Len()
    if n <= 31:
        binary.WriteU8(buf, 0xa0 | n)
    else n <= 255 and use_str8:
        binary.WriteU8(buf, 0xd9)
        binary.WriteU8(buf, n)
    else n <= 65535:
        binary.WriteU8(buf, 0xda)
        binary.WriteU16BE(buf, n)
    else:
        binary.WriteU8(buf, 0xdb)
        binary.WriteU32BE(buf, n)
    end
    compress.BufPushBytes(buf, s as void*, n)
end

func _marshal_bytes(buf &: compress.ByteBuf, p: void*, n: int):
    if n <= 255:
        binary.WriteU8(buf, 0xc4)
        binary.WriteU8(buf, n)
    else n <= 65535:
        binary.WriteU8(buf, 0xc5)
        binary.WriteU16BE(buf, n)
    else:
        binary.WriteU8(buf, 0xc6)
        binary.WriteU32BE(buf, n)
    end
    compress.BufPushBytes(buf, p, n)
end

func _marshal_ext(buf &: compress.ByteBuf, typeId: int, p: void*, n: int):
    t := typeId & 255
    if n == 1: binary.WriteU8(buf, 0xd4)
    else n == 2: binary.WriteU8(buf, 0xd5)
    else n == 4: binary.WriteU8(buf, 0xd6)
    else n == 8: binary.WriteU8(buf, 0xd7)
    else n == 16: binary.WriteU8(buf, 0xd8)
    else n <= 255:
        binary.WriteU8(buf, 0xc7)
        binary.WriteU8(buf, n)
    else n <= 65535:
        binary.WriteU8(buf, 0xc8)
        binary.WriteU16BE(buf, n)
    else:
        binary.WriteU8(buf, 0xc9)
        binary.WriteU32BE(buf, n)
    end
    binary.WriteU8(buf, t)
    compress.BufPushBytes(buf, p, n)
end

func _marshal(buf &: compress.ByteBuf, v: value.Value, opts: MsgpackOptions):
    if value.IsNull(v):
        binary.WriteU8(buf, 0xc0)
        ret
    end
    if value.IsBool(v):
        if value.AsBool(v): binary.WriteU8(buf, 0xc3) else:
            binary.WriteU8(buf, 0xc2)
        end
        ret
    end
    if value.IsInt(v):
        _marshal_int(buf, value.AsInt(v))
        ret
    end
    if value.IsFloat(v):
        binary.WriteU8(buf, 0xcb)
        binary.WriteF64(buf, value.AsFloat(v), true)
        ret
    end
    if value.IsString(v):
        _marshal_str(buf, value.AsString(v), opts.use_str8)
        ret
    end
    if value.IsBytes(v):
        mut b := value.BytesToBuf(v)
        _marshal_bytes(buf, b.data, b.len)
        compress.BufFree(b)
        ret
    end
    if value.IsExt(v):
        mut b := value.ExtDataToBuf(v)
        _marshal_ext(buf, value.ExtType(v), b.data, b.len)
        compress.BufFree(b)
        ret
    end
    if value.IsArray(v):
        n := value.ArrayLen(v)
        if n <= 15:
            binary.WriteU8(buf, 0x90 | n)
        else n <= 65535:
            binary.WriteU8(buf, 0xdc)
            binary.WriteU16BE(buf, n)
        else:
            binary.WriteU8(buf, 0xdd)
            binary.WriteU32BE(buf, n)
        end
        mut i := 0
        until i < n:
            _marshal(buf, value.ArrayGet(v, i), opts)
            i++
        end
        ret
    end
    if value.IsObject(v):
        n := value.ObjectLen(v)
        if n <= 15:
            binary.WriteU8(buf, 0x80 | n)
        else n <= 65535:
            binary.WriteU8(buf, 0xde)
            binary.WriteU16BE(buf, n)
        else:
            binary.WriteU8(buf, 0xdf)
            binary.WriteU32BE(buf, n)
        end
        keys := value.ObjectKeys(v)
        mut i := 0
        until i < keys.Len():
            k := keys.Get(i)
            _marshal_str(buf, k, opts.use_str8)
            _marshal(buf, value.ObjectGet(v, k), opts)
            i++
        end
        ret
    end
end

func _read_str(r &: compress.ByteReader, n: int): str:
    mut b := compress.RdBytes(r, n)
    out := compress.BufToStrUnsafe(b)
    compress.BufFree(b)
    ret out
end

func _read_bin(r &: compress.ByteReader, n: int, err &: Error): value.Value:
    if not _mp_fits(r, n, 1, err): ret value.ValueNull() end
    mut b := compress.RdBytes(r, n)
    out := value.ValueBinary(b.data, b.len)
    compress.BufFree(b)
    ret out
end

func _read_ext(r &: compress.ByteReader, typeId: int, n: int, err &: Error): value.Value:
    if not _mp_fits(r, n, 1, err): ret value.ValueNull() end
    mut b := compress.RdBytes(r, n)
    out := value.ValueExt(typeId, b.data, b.len)
    compress.BufFree(b)
    ret out
end

func _mp_fits(r &: compress.ByteReader, n: int, per: int, err &: Error): bool:
    if r.bad or n < 0 or (n as i64) * (per as i64) > ((r.len - r.pos) as i64):
        err = Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", r.pos)
        ret false
    end
    ret true
end

func _unmarshal(r &: compress.ByteReader, err &: Error): value.Value:
    ret _unmarshal_d(r, err, 0)
end

func _unmarshal_tag(r &: compress.ByteReader, err &: Error, depth: int): value.Value throws:
    tag := try binary.ReadU8(r)
    if tag <= 0x7f: ret value.ValueInt(tag as i64) end
    if tag >= 0xe0: ret value.ValueInt((tag - 256) as i64) end
    if tag >= 0x80 and tag <= 0x8f:
        n := tag & 15
        ret _unmarshal_map(r, n, err, depth)
    end
    if tag >= 0x90 and tag <= 0x9f:
        n := tag & 15
        ret _unmarshal_array(r, n, err, depth)
    end
    if tag >= 0xa0 and tag <= 0xbf:
        n := tag & 31
        ret _mp_fits(r, n, 1, err) ? value.ValueString(_read_str(r, n)) : value.ValueNull()
    end
    if tag == 0xc0: ret value.ValueNull() end
    if tag == 0xc2: ret value.ValueBool(false) end
    if tag == 0xc3: ret value.ValueBool(true) end
    if tag == 0xca: ret value.ValueFloat(try binary.ReadF32(r, true)) end
    if tag == 0xcb: ret value.ValueFloat(try binary.ReadF64(r, true)) end
    if tag == 0xcc: ret value.ValueInt(try binary.ReadU8(r) as i64) end
    if tag == 0xcd: ret value.ValueInt(try binary.ReadU16BE(r) as i64) end
    if tag == 0xce: ret value.ValueInt(try binary.ReadU32BE(r) as i64) end
    if tag == 0xcf: ret value.ValueInt(try binary.ReadU64BE(r)) end
    if tag == 0xd0:
        b := try binary.ReadU8(r)
        mut sv := b as i64
        if b > 127: sv -= 256 end
        ret value.ValueInt(sv)
    end
    if tag == 0xd1:
        b := try binary.ReadU16BE(r)
        mut sv := b as i64
        if b > 32767: sv -= 65536 end
        ret value.ValueInt(sv)
    end
    if tag == 0xd2:
        b := try binary.ReadU32BE(r)
        mut sv := b as i64
        if b > 2147483647: sv -= 4294967296 end
        ret value.ValueInt(sv)
    end
    if tag == 0xd3: ret value.ValueInt(try binary.ReadI64BE(r)) end
    if tag == 0xd9:
        n := try binary.ReadU8(r)
        ret _mp_fits(r, n, 1, err) ? value.ValueString(_read_str(r, n)) : value.ValueNull()
    end
    if tag == 0xda:
        n := try binary.ReadU16BE(r)
        ret _mp_fits(r, n, 1, err) ? value.ValueString(_read_str(r, n)) : value.ValueNull()
    end
    if tag == 0xdb:
        n := try binary.ReadU32BE(r)
        ret _mp_fits(r, n, 1, err) ? value.ValueString(_read_str(r, n)) : value.ValueNull()
    end
    if tag == 0xc4:
        n := try binary.ReadU8(r)
        ret _read_bin(r, n, err)
    end
    if tag == 0xc5:
        n := try binary.ReadU16BE(r)
        ret _read_bin(r, n, err)
    end
    if tag == 0xc6:
        n := try binary.ReadU32BE(r)
        ret _read_bin(r, n, err)
    end
    if tag >= 0xd4 and tag <= 0xd8:
        mut n := 1
        if tag == 0xd5: n = 2
        else tag == 0xd6: n = 4
        else tag == 0xd7: n = 8
        else tag == 0xd8: n = 16
        end
        t := try binary.ReadU8(r)
        mut tv := t
        if t > 127: tv -= 256 end
        ret _read_ext(r, tv, n, err)
    end
    if tag == 0xc7 or tag == 0xc8 or tag == 0xc9:
        mut n := 0
        if tag == 0xc7: n = try binary.ReadU8(r)
        else tag == 0xc8: n = try binary.ReadU16BE(r)
        else: n = try binary.ReadU32BE(r)
        end
        t := try binary.ReadU8(r)
        mut tv := t
        if t > 127: tv -= 256 end
        ret _read_ext(r, tv, n, err)
    end
    if tag == 0xdc:
        n := try binary.ReadU16BE(r)
        ret _unmarshal_array(r, n, err, depth)
    end
    if tag == 0xdd:
        n := try binary.ReadU32BE(r)
        ret _unmarshal_array(r, n, err, depth)
    end
    if tag == 0xde:
        n := try binary.ReadU16BE(r)
        ret _unmarshal_map(r, n, err, depth)
    end
    if tag == 0xdf:
        n := try binary.ReadU32BE(r)
        ret _unmarshal_map(r, n, err, depth)
    end
    err = Error.At(ErrorKind.Unsupported, "unsupported msgpack tag " + tag, r.pos)
    ret value.ValueNull()
end

func _unmarshal_d(r &: compress.ByteReader, err &: Error, depth: int): value.Value:
    if err.message != "": ret value.ValueNull() end
    if depth > 512:
        err = Error.At(ErrorKind.OutOfRange, "msgpack nesting is deeper than 512 levels", r.pos)
        ret value.ValueNull()
    end
    try:
        ret _unmarshal_tag(r, err, depth)
    catch e:
        err = e
        ret value.ValueNull()
    end
end

func _unmarshal_array(r &: compress.ByteReader, n: int, err &: Error, depth: int): value.Value:
    if not _mp_fits(r, n, 1, err): ret value.ValueNull() end
    mut out := value.NewValueArray()
    mut i := 0
    until i < n:
        item := _unmarshal_d(r, err, depth + 1)
        if err.message != "": ret value.ValueNull() end
        value.ArrayPush(out, item)
        i++
    end
    ret out
end

func _unmarshal_map(r &: compress.ByteReader, n: int, err &: Error, depth: int): value.Value:
    if not _mp_fits(r, n, 2, err): ret value.ValueNull() end
    mut out := value.NewValueObject()
    mut i := 0
    until i < n:
        k := _unmarshal_d(r, err, depth + 1)
        if err.message != "": ret value.ValueNull() end
        v := _unmarshal_d(r, err, depth + 1)
        if err.message != "": ret value.ValueNull() end
        value.ObjectSet(out, value.AsString(k), v)
        i++
    end
    ret out
end

@en "MarshalWith"
@fa "سریال سازی سفارشی"
pub func MarshalWith(v: value.Value, opts: MsgpackOptions): compress.ByteBuf:
    mut buf := compress.NewByteBuf()
    _marshal(buf, v, opts)
    ret buf
end

@en "Marshal"
@fa "سریال سازی"
pub func Marshal(v: value.Value): compress.ByteBuf:
    ret MarshalWith(v, MsgpackOptions {})
end

@en "UnmarshalBytes"
@fa "واسریال سازی بایت‌ها"
pub func UnmarshalBytes(p: void*, n: int): value.Value throws:
    mut r := compress.NewByteReader(p, n)
    mut err := Error {}
    v := _unmarshal(r, err)
    if err.message != "":
        throw err.wrap("msgpack")
    end
    ret v
end

@en "Unmarshal"
@fa "واسریال سازی"
pub func Unmarshal(b: compress.ByteBuf): value.Value throws:
    ret try UnmarshalBytes(b.data, b.len)
end
