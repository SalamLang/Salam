package protobuf

@en "FK_DOUBLE"
@fa "نوع فیلد اعشار۶۴"
pub const FK_DOUBLE := 1
@en "FK_FLOAT"
@fa "نوع فیلد اعشار۳۲"
pub const FK_FLOAT := 2
@en "FK_INT32"
@fa "نوع فیلد صحیح۳۲"
pub const FK_INT32 := 3
@en "FK_INT64"
@fa "نوع فیلد صحیح۶۴"
pub const FK_INT64 := 4
@en "FK_UINT32"
@fa "نوع فیلد طبیعی۳۲"
pub const FK_UINT32 := 5
@en "FK_UINT64"
@fa "نوع فیلد طبیعی۶۴"
pub const FK_UINT64 := 6
@en "FK_SINT32"
@fa "نوع فیلد صحیح۳۲ زیگزاگ"
pub const FK_SINT32 := 7
@en "FK_SINT64"
@fa "نوع فیلد صحیح۶۴ زیگزاگ"
pub const FK_SINT64 := 8
@en "FK_FIXED32"
@fa "نوع فیلد ثابت۳۲"
pub const FK_FIXED32 := 9
@en "FK_FIXED64"
@fa "نوع فیلد ثابت۶۴"
pub const FK_FIXED64 := 10
@en "FK_SFIXED32"
@fa "نوع فیلد ثابت علامت‌دار۳۲"
pub const FK_SFIXED32 := 11
@en "FK_SFIXED64"
@fa "نوع فیلد ثابت علامت‌دار۶۴"
pub const FK_SFIXED64 := 12
@en "FK_BOOL"
@fa "نوع فیلد منطقی"
pub const FK_BOOL := 13
@en "FK_STRING"
@fa "نوع فیلد رشته"
pub const FK_STRING := 14
@en "FK_BYTES"
@fa "نوع فیلد بایت‌ها"
pub const FK_BYTES := 15
@en "FK_MESSAGE"
@fa "نوع فیلد پیام"
pub const FK_MESSAGE := 16
@en "FK_ENUM"
@fa "نوع فیلد شمارشی"
pub const FK_ENUM := 17
@en "FK_MAP"
@fa "نوع فیلد نگاشت"
pub const FK_MAP := 18

@en "PField"
@fa "فیلد پروتو"
pub struct PField:
    pub name: str = ""
    pub kind: int = 0
    pub typeName: str = ""
    pub keyKind: int = 0
    pub mapValueKind: int = 0
    pub mapValueTypeName: str = ""
    pub number: int = 0
    pub repeated: bool = false
    pub packedOpt: bool = true
    pub oneofIndex: int = 0 - 1
    pub is_deprecated: bool = false
end

@en "POneof"
@fa "گروه یکی از"
pub struct POneof:
    pub name: str = ""
    pub fieldIndices: Vector<int> = Vector {}
end

@en "PEnumValue"
@fa "مقدار شمارشی پروتو"
pub struct PEnumValue:
    pub name: str = ""
    pub number: int = 0
end

@en "PEnum"
@fa "شمارشی پروتو"
pub struct PEnum:
    pub name: str = ""
    pub values: Vector<PEnumValue> = Vector {}
end

@en "PMessage"
@fa "پیام پروتو"
pub struct PMessage:
    pub name: str = ""
    pub fields: Vector<PField> = Vector {}
    pub oneofs: Vector<POneof> = Vector {}
    pub nestedMessages: Vector<PMessage> = Vector {}
    pub nestedEnums: Vector<PEnum> = Vector {}
end

@en "PMethod"
@fa "متد پروتو"
pub struct PMethod:
    pub name: str = ""
    pub inputType: str = ""
    pub outputType: str = ""
    pub clientStream: bool = false
    pub serverStream: bool = false
end

@en "PService"
@fa "سرویس پروتو"
pub struct PService:
    pub name: str = ""
    pub methods: Vector<PMethod> = Vector {}
end

@en "PFile"
@fa "پرونده پروتو"
pub struct PFile:
    pub packageName: str = ""
    pub messages: Vector<PMessage> = Vector {}
    pub enums: Vector<PEnum> = Vector {}
    pub imports: Vector<str> = Vector {}
    pub services: Vector<PService> = Vector {}
end

@en "FieldKindName"
@fa "نام نوع فیلد"
pub func FieldKindName(k: int): str:
    if k == FK_DOUBLE: ret "double" end
    if k == FK_FLOAT: ret "float" end
    if k == FK_INT32: ret "int32" end
    if k == FK_INT64: ret "int64" end
    if k == FK_UINT32: ret "uint32" end
    if k == FK_UINT64: ret "uint64" end
    if k == FK_SINT32: ret "sint32" end
    if k == FK_SINT64: ret "sint64" end
    if k == FK_FIXED32: ret "fixed32" end
    if k == FK_FIXED64: ret "fixed64" end
    if k == FK_SFIXED32: ret "sfixed32" end
    if k == FK_SFIXED64: ret "sfixed64" end
    if k == FK_BOOL: ret "bool" end
    if k == FK_STRING: ret "string" end
    if k == FK_BYTES: ret "bytes" end
    if k == FK_MESSAGE: ret "message" end
    if k == FK_ENUM: ret "enum" end
    if k == FK_MAP: ret "map" end
    ret "?"
end

@en "ScalarKindFromName"
@fa "نوع ساده از نام"
pub func ScalarKindFromName(name: str): int:
    if name == "double": ret FK_DOUBLE end
    if name == "float": ret FK_FLOAT end
    if name == "int32": ret FK_INT32 end
    if name == "int64": ret FK_INT64 end
    if name == "uint32": ret FK_UINT32 end
    if name == "uint64": ret FK_UINT64 end
    if name == "sint32": ret FK_SINT32 end
    if name == "sint64": ret FK_SINT64 end
    if name == "fixed32": ret FK_FIXED32 end
    if name == "fixed64": ret FK_FIXED64 end
    if name == "sfixed32": ret FK_SFIXED32 end
    if name == "sfixed64": ret FK_SFIXED64 end
    if name == "bool": ret FK_BOOL end
    if name == "string": ret FK_STRING end
    if name == "bytes": ret FK_BYTES end
    ret 0
end
