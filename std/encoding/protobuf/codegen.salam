package protobuf

import str
import conv

func _scalar_salam_type(kind: int): str:
    if kind == FK_STRING: ret "str" end
    if kind == FK_BYTES: ret "str" end
    if kind == FK_BOOL: ret "bool" end
    if kind == FK_DOUBLE: ret "f64" end
    if kind == FK_FLOAT: ret "f64" end
    ret "i64"
end

func _is_scalar_or_string(kind: int): bool:
    ret kind != FK_MESSAGE and kind != FK_MAP and kind != 0
end

func _has_scalar(msg: PMessage): bool:
    mut fi := 0
    until fi < msg.fields.Len():
        if _is_scalar_or_string(msg.fields.Get(fi).kind): ret true end
        fi++
    end
    ret false
end

func _salam_field_type(f: PField): str:
    base := _scalar_salam_type(f.kind)
    if f.repeated: ret "Vector<".Concat(base).Concat(">") end
    ret base
end

func _salam_field_default(f: PField): str:
    if f.repeated: ret "Vector {}" end
    if f.kind == FK_STRING or f.kind == FK_BYTES: ret "\"\"" end
    if f.kind == FK_BOOL: ret "false" end
    if f.kind == FK_DOUBLE or f.kind == FK_FLOAT: ret "0.0" end
    ret "0 as i64"
end

func _wire_type_const(kind: int): str:
    if kind == FK_STRING or kind == FK_BYTES: ret "protobuf.WT_LEN" end
    if kind == FK_DOUBLE: ret "protobuf.WT_FIXED64" end
    if kind == FK_FLOAT: ret "protobuf.WT_FIXED32" end
    if kind == FK_FIXED32 or kind == FK_SFIXED32: ret "protobuf.WT_FIXED32" end
    if kind == FK_FIXED64 or kind == FK_SFIXED64: ret "protobuf.WT_FIXED64" end
    ret "protobuf.WT_VARINT"
end

func _write_stmt(kind: int, expr: str): str:
    if kind == FK_STRING or kind == FK_BYTES:
        ret "protobuf.WriteLenPrefixedStr(buf, ".Concat(expr).Concat(")")
    end
    if kind == FK_DOUBLE: ret "protobuf.WriteDouble(buf, ".Concat(expr).Concat(")") end
    if kind == FK_FLOAT: ret "protobuf.WriteFloat(buf, ".Concat(expr).Concat(")") end
    if kind == FK_BOOL:
        ret "protobuf.WriteVarint(buf, (".Concat(expr).Concat(" ? 1 : 0) as u64)")
    end
    if kind == FK_SINT32:
        ret "protobuf.WriteVarint(buf, protobuf.ZigZagEncode32(".Concat(expr).Concat(" as i32) as u64)")
    end
    if kind == FK_SINT64:
        ret "protobuf.WriteVarint(buf, protobuf.ZigZagEncode64(".Concat(expr).Concat(") as u64)")
    end
    if kind == FK_FIXED32 or kind == FK_SFIXED32:
        ret "protobuf.WriteFixed32(buf, ".Concat(expr).Concat(" as u32)")
    end
    if kind == FK_FIXED64 or kind == FK_SFIXED64:
        ret "protobuf.WriteFixed64(buf, ".Concat(expr).Concat(" as u64)")
    end
    ret "protobuf.WriteVarint(buf, ".Concat(expr).Concat(" as u64)")
end

func _read_expr(kind: int): str:
    if kind == FK_STRING or kind == FK_BYTES: ret "protobuf.ReadLenPrefixedStr(r)" end
    if kind == FK_DOUBLE: ret "protobuf.ReadDouble(r)" end
    if kind == FK_FLOAT: ret "protobuf.ReadFloat(r)" end
    if kind == FK_BOOL: ret "protobuf.ReadVarint(r) != (0 as u64)" end
    if kind == FK_SINT32: ret "protobuf.ZigZagDecode32(protobuf.ReadVarint(r) as u32) as i64" end
    if kind == FK_SINT64: ret "protobuf.ZigZagDecode64(protobuf.ReadVarint(r))" end
    if kind == FK_FIXED32 or kind == FK_SFIXED32: ret "protobuf.ReadFixed32(r) as i64" end
    if kind == FK_FIXED64 or kind == FK_SFIXED64: ret "protobuf.ReadFixed64(r) as i64" end
    ret "protobuf.ReadVarint(r) as i64"
end

func _nonzero_check(f: PField): str:
    if f.kind == FK_STRING or f.kind == FK_BYTES: ret "m.".Concat(f.name).Concat(".Len() > 0") end
    if f.kind == FK_BOOL: ret "m.".Concat(f.name) end
    if f.kind == FK_DOUBLE or f.kind == FK_FLOAT: ret "m.".Concat(f.name).Concat(" != 0.0") end
    ret "m.".Concat(f.name).Concat(" != (0 as i64)")
end

func _emit_struct(sb &: str.StringBuilder, msg: PMessage):
    str.BufAppend(sb, "pub struct ")
    str.BufAppend(sb, msg.name)
    str.BufAppend(sb, ":\n")
    mut fi := 0
    until fi < msg.fields.Len():
        f := msg.fields.Get(fi)
        if _is_scalar_or_string(f.kind):
            str.BufAppend(sb, "    pub ")
            str.BufAppend(sb, f.name)
            str.BufAppend(sb, ": ")
            str.BufAppend(sb, _salam_field_type(f))
            str.BufAppend(sb, " = ")
            str.BufAppend(sb, _salam_field_default(f))
            str.BufAppendChar(sb, 10)
        end
        fi++
    end
    if not _has_scalar(msg):
        str.BufAppend(sb, "    pub _empty: bool = false\n")
    end
    str.BufAppend(sb, "end\n\n")
end

func _emit_marshal(sb &: str.StringBuilder, msg: PMessage):
    if not _has_scalar(msg):
        str.BufAppend(sb, "pub func Marshal")
        str.BufAppend(sb, msg.name)
        str.BufAppend(sb, "(_m: ")
        str.BufAppend(sb, msg.name)
        str.BufAppend(sb, "): compress.ByteBuf:\n")
        str.BufAppend(sb, "    ret compress.NewByteBuf()\n")
        str.BufAppend(sb, "end\n\n")
        ret
    end
    str.BufAppend(sb, "pub func Marshal")
    str.BufAppend(sb, msg.name)
    str.BufAppend(sb, "(m: ")
    str.BufAppend(sb, msg.name)
    str.BufAppend(sb, "): compress.ByteBuf:\n")
    str.BufAppend(sb, "    mut buf := compress.NewByteBuf()\n")
    mut fi := 0
    until fi < msg.fields.Len():
        f := msg.fields.Get(fi)
        if _is_scalar_or_string(f.kind):
            numStr := conv.FormatInt(f.number as i64)
            if f.repeated:
                str.BufAppend(sb, "    mut ri")
                str.BufAppend(sb, numStr)
                str.BufAppend(sb, " := 0\n")
                str.BufAppend(sb, "    until ri")
                str.BufAppend(sb, numStr)
                str.BufAppend(sb, " < m.")
                str.BufAppend(sb, f.name)
                str.BufAppend(sb, ".Len():\n")
                str.BufAppend(sb, "        protobuf.WriteTag(buf, ")
                str.BufAppend(sb, numStr)
                str.BufAppend(sb, ", ")
                str.BufAppend(sb, _wire_type_const(f.kind))
                str.BufAppend(sb, ")\n        ")
                elemExpr := "m.".Concat(f.name).Concat(".Get(ri").Concat(numStr).Concat(")")
                str.BufAppend(sb, _write_stmt(f.kind, elemExpr))
                str.BufAppendChar(sb, 10)
                str.BufAppend(sb, "        ri")
                str.BufAppend(sb, numStr)
                str.BufAppend(sb, " += 1\n    end\n")
            else:
                str.BufAppend(sb, "    if ")
                str.BufAppend(sb, _nonzero_check(f))
                str.BufAppend(sb, ":\n        protobuf.WriteTag(buf, ")
                str.BufAppend(sb, numStr)
                str.BufAppend(sb, ", ")
                str.BufAppend(sb, _wire_type_const(f.kind))
                str.BufAppend(sb, ")\n        ")
                str.BufAppend(sb, _write_stmt(f.kind, "m.".Concat(f.name)))
                str.BufAppendChar(sb, 10)
                str.BufAppend(sb, "    end\n")
            end
        end
        fi++
    end
    str.BufAppend(sb, "    ret buf\n")
    str.BufAppend(sb, "end\n\n")
end

func _emit_unmarshal(sb &: str.StringBuilder, msg: PMessage):
    str.BufAppend(sb, "pub func Unmarshal")
    str.BufAppend(sb, msg.name)
    str.BufAppend(sb, "(data: void*, n: int): ")
    str.BufAppend(sb, msg.name)
    str.BufAppend(sb, " throws:\n")
    scalar := _has_scalar(msg)
    if scalar:
        str.BufAppend(sb, "    mut out := ")
        str.BufAppend(sb, msg.name)
        str.BufAppend(sb, " {}\n")
    end
    str.BufAppend(sb, "    mut r := compress.NewByteReader(data, n)\n")
    str.BufAppend(sb, "    try:\n")
    str.BufAppend(sb, "        until compress.RdLeft(r) > 0:\n")
    if scalar: str.BufAppend(sb, "            at := r.pos\n") end
    str.BufAppend(sb, "            mut fnum := 0\n")
    str.BufAppend(sb, "            mut wtype := 0\n")
    str.BufAppend(sb, "            protobuf.ReadTag(r, fnum, wtype)\n")
    mut fi := 0
    mut any := false
    until fi < msg.fields.Len():
        f := msg.fields.Get(fi)
        if _is_scalar_or_string(f.kind):
            numStr := conv.FormatInt(f.number as i64)
            wire := _wire_type_const(f.kind)
            mut kw := "if"
            if any: kw = "else" end
            any = true
            str.BufAppend(sb, "            ")
            str.BufAppend(sb, kw)
            str.BufAppend(sb, " fnum == ")
            str.BufAppend(sb, numStr)
            str.BufAppend(sb, ":\n")
            str.BufAppend(sb, "                if wtype != ")
            str.BufAppend(sb, wire)
            str.BufAppend(sb, ":\n")
            str.BufAppend(sb, "                    throw Error.At(ErrorKind.TypeMismatch, \"field ")
            str.BufAppend(sb, numStr)
            str.BufAppend(sb, " (")
            str.BufAppend(sb, f.name)
            str.BufAppend(sb, ") has wire type \" + wtype + \", expected \" + ")
            str.BufAppend(sb, wire)
            str.BufAppend(sb, ", at).with_code(\"protobuf.wire_type_mismatch\").wrap(\"protobuf\")\n")
            str.BufAppend(sb, "                end\n")
            str.BufAppend(sb, "                out.")
            str.BufAppend(sb, f.name)
            if f.repeated:
                str.BufAppend(sb, ".Push(")
                str.BufAppend(sb, _read_expr(f.kind))
                str.BufAppend(sb, ")\n")
            else:
                str.BufAppend(sb, " = ")
                str.BufAppend(sb, _read_expr(f.kind))
                str.BufAppendChar(sb, 10)
            end
        end
        fi++
    end
    if any:
        str.BufAppend(sb, "            else:\n")
        str.BufAppend(sb, "                protobuf.SkipFieldFor(r, fnum, wtype)\n")
        str.BufAppend(sb, "            end\n")
    else:
        str.BufAppend(sb, "            protobuf.SkipFieldFor(r, fnum, wtype)\n")
    end
    str.BufAppend(sb, "        end\n")
    str.BufAppend(sb, "    catch e:\n")
    str.BufAppend(sb, "        throw e.wrap(\"")
    str.BufAppend(sb, msg.name)
    str.BufAppend(sb, "\")\n")
    str.BufAppend(sb, "    end\n")
    if scalar:
        str.BufAppend(sb, "    ret out\n")
    else:
        str.BufAppend(sb, "    ret ")
        str.BufAppend(sb, msg.name)
        str.BufAppend(sb, " {}\n")
    end
    str.BufAppend(sb, "end\n\n")
end

func _emit_enum(sb &: str.StringBuilder, en: PEnum):
    mut vi := 0
    until vi < en.values.Len():
        v := en.values.Get(vi)
        str.BufAppend(sb, "pub const ")
        str.BufAppend(sb, en.name)
        str.BufAppendChar(sb, 95)
        str.BufAppend(sb, v.name)
        str.BufAppend(sb, " := ")
        str.BufAppend(sb, conv.FormatInt(v.number as i64))
        str.BufAppendChar(sb, 10)
        vi++
    end
    str.BufAppendChar(sb, 10)
end

func _generate(f: PFile, services: bool): str:
    mut sb := str.NewBuilder()
    str.BufAppend(sb, "// Generated by encoding.protobuf - DO NOT EDIT.\n\n")
    str.BufAppend(sb, "package generated_pb\n\n")
    str.BufAppend(sb, "import encoding.protobuf\n")
    str.BufAppend(sb, "import compress\n")
    withServices := services and f.services.Len() > 0
    if withServices: str.BufAppend(sb, "import grpc\n") end
    str.BufAppendChar(sb, 10)
    mut ei := 0
    until ei < f.enums.Len():
        _emit_enum(sb, f.enums.Get(ei))
        ei++
    end
    if withServices: _emit_service_consts(sb, f) end
    mut mi := 0
    until mi < f.messages.Len():
        _emit_struct(sb, f.messages.Get(mi))
        mi++
    end
    mi = 0
    until mi < f.messages.Len():
        _emit_marshal(sb, f.messages.Get(mi))
        _emit_unmarshal(sb, f.messages.Get(mi))
        mi++
    end
    if withServices: _emit_service_funcs(sb, f) end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

@en "GenerateSingle"
@fa "تولید کد"
pub func GenerateSingle(protoSource: str): str throws:
    f := try ParseFile(protoSource)
    ret _generate(f, false)
end
