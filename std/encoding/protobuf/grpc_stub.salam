package protobuf

import str
import conv

func _svc_prefix(f: PFile, svc: PService): str:
    if f.packageName == "": ret svc.name end
    ret f.packageName + "." + svc.name
end

func _path_const(svc: PService, m: PMethod): str:
    ret svc.name + m.name + "Path"
end

func _emit_path_const(sb &: str.StringBuilder, f: PFile, svc: PService, m: PMethod):
    str.BufAppend(sb, "pub const ")
    str.BufAppend(sb, _path_const(svc, m))
    str.BufAppend(sb, " := \"/")
    str.BufAppend(sb, _svc_prefix(f, svc))
    str.BufAppend(sb, "/")
    str.BufAppend(sb, m.name)
    str.BufAppend(sb, "\"\n")
end

func _emit_decode_raw(sb &: str.StringBuilder, m: PMethod):
    str.BufAppend(sb, "    try:\n")
    str.BufAppend(sb, "        out := Unmarshal")
    str.BufAppend(sb, m.outputType)
    str.BufAppend(sb, "(raw.data, compress.BufLen(raw))\n")
    str.BufAppend(sb, "        compress.BufFree(raw)\n")
    str.BufAppend(sb, "        ret out\n")
    str.BufAppend(sb, "    catch e:\n")
    str.BufAppend(sb, "        compress.BufFree(raw)\n")
    str.BufAppend(sb, "        throw e\n")
    str.BufAppend(sb, "    end\n")
end

func _emit_unary(sb &: str.StringBuilder, svc: PService, m: PMethod):
    str.BufAppend(sb, "pub func ")
    str.BufAppend(sb, svc.name)
    str.BufAppend(sb, m.name)
    str.BufAppend(sb, "(ch &: grpc.Channel, req: ")
    str.BufAppend(sb, m.inputType)
    str.BufAppend(sb, ", md: grpc.Metadata, st &: grpc.Status): ")
    str.BufAppend(sb, m.outputType)
    str.BufAppend(sb, " throws:\n")
    str.BufAppend(sb, "    mut body := Marshal")
    str.BufAppend(sb, m.inputType)
    str.BufAppend(sb, "(req)\n")
    str.BufAppend(sb, "    mut raw := grpc.UnaryCall(ch, ")
    str.BufAppend(sb, _path_const(svc, m))
    str.BufAppend(sb, ", body, md, st)\n")
    str.BufAppend(sb, "    compress.BufFree(body)\n")
    _emit_decode_raw(sb, m)
    str.BufAppend(sb, "end\n\n")
end

func _emit_stream(sb &: str.StringBuilder, svc: PService, m: PMethod):
    base := svc.name + m.name
    str.BufAppend(sb, "pub func ")
    str.BufAppend(sb, base)
    str.BufAppend(sb, "Start(ch &: grpc.Channel, md: grpc.Metadata): int:\n")
    str.BufAppend(sb, "    ret grpc.StartCall(ch, ")
    str.BufAppend(sb, _path_const(svc, m))
    str.BufAppend(sb, ", md)\n")
    str.BufAppend(sb, "end\n\n")

    str.BufAppend(sb, "pub func ")
    str.BufAppend(sb, base)
    str.BufAppend(sb, "Send(ch &: grpc.Channel, sid: int, req: ")
    str.BufAppend(sb, m.inputType)
    str.BufAppend(sb, ", last: bool): bool:\n")
    str.BufAppend(sb, "    mut body := Marshal")
    str.BufAppend(sb, m.inputType)
    str.BufAppend(sb, "(req)\n")
    str.BufAppend(sb, "    sent := grpc.SendMessage(ch, sid, body, last)\n")
    str.BufAppend(sb, "    compress.BufFree(body)\n")
    str.BufAppend(sb, "    ret sent\n")
    str.BufAppend(sb, "end\n\n")

    str.BufAppend(sb, "pub func ")
    str.BufAppend(sb, base)
    str.BufAppend(sb, "Recv(ch &: grpc.Channel, sid: int, got &: bool): ")
    str.BufAppend(sb, m.outputType)
    str.BufAppend(sb, " throws:\n")
    str.BufAppend(sb, "    mut raw := grpc.RecvMessage(ch, sid, got)\n")
    str.BufAppend(sb, "    if not got:\n")
    str.BufAppend(sb, "        compress.BufFree(raw)\n")
    str.BufAppend(sb, "        ret ")
    str.BufAppend(sb, m.outputType)
    str.BufAppend(sb, " {}\n")
    str.BufAppend(sb, "    end\n")
    _emit_decode_raw(sb, m)
    str.BufAppend(sb, "end\n\n")

    str.BufAppend(sb, "pub func ")
    str.BufAppend(sb, base)
    str.BufAppend(sb, "Finish(ch &: grpc.Channel, sid: int): grpc.Status:\n")
    str.BufAppend(sb, "    ret grpc.FinishCall(ch, sid)\n")
    str.BufAppend(sb, "end\n\n")
end

func _emit_register(sb &: str.StringBuilder, svc: PService, m: PMethod):
    str.BufAppend(sb, "pub func Register")
    str.BufAppend(sb, svc.name)
    str.BufAppend(sb, m.name)
    str.BufAppend(sb, "(fn: i64):\n")
    if m.clientStream or m.serverStream:
        str.BufAppend(sb, "    grpc.RegisterStreamMethod(")
        str.BufAppend(sb, _path_const(svc, m))
        str.BufAppend(sb, ", fn, ")
        if m.clientStream: str.BufAppend(sb, "true, ") else:
            str.BufAppend(sb, "false, ")
        end
        if m.serverStream: str.BufAppend(sb, "true)\n") else:
            str.BufAppend(sb, "false)\n")
        end
    else:
        str.BufAppend(sb, "    grpc.RegisterMethod(")
        str.BufAppend(sb, _path_const(svc, m))
        str.BufAppend(sb, ", fn)\n")
    end
    str.BufAppend(sb, "end\n\n")
end

func _emit_service_consts(sb &: str.StringBuilder, f: PFile):
    mut si := 0
    until si < f.services.len():
        svc := f.services.get(si)
        mut i := 0
        until i < svc.methods.len():
            _emit_path_const(sb, f, svc, svc.methods.get(i))
            i++
        end
        si++
    end
    str.BufAppendChar(sb, 10)
end

func _emit_service_funcs(sb &: str.StringBuilder, f: PFile):
    mut si := 0
    until si < f.services.len():
        svc := f.services.get(si)
        mut i := 0
        until i < svc.methods.len():
            m := svc.methods.get(i)
            if m.clientStream or m.serverStream:
                _emit_stream(sb, svc, m)
            else:
                _emit_unary(sb, svc, m)
            end
            _emit_register(sb, svc, m)
            i++
        end
        si++
    end
end

@en "ServiceCount"
@fa "تعداد سرویس‌ها"
pub func ServiceCount(f: PFile): int:
    ret f.services.len()
end

@en "ServiceNameAt"
@fa "نام سرویس"
pub func ServiceNameAt(f: PFile, i: int): str:
    if i < 0 or i >= f.services.len(): ret "" end
    ret f.services.get(i).name
end

@en "ServiceMethodCount"
@fa "تعداد متدهای سرویس"
pub func ServiceMethodCount(f: PFile, i: int): int:
    if i < 0 or i >= f.services.len(): ret 0 end
    ret f.services.get(i).methods.len()
end

@en "ServiceMethodSignature"
@fa "امضای متد"
pub func ServiceMethodSignature(f: PFile, si: int, mi: int): str:
    if si < 0 or si >= f.services.len(): ret "" end
    svc := f.services.get(si)
    if mi < 0 or mi >= svc.methods.len(): ret "" end
    m := svc.methods.get(mi)
    mut out := m.name + "("
    if m.clientStream: out += "stream " end
    out = out + m.inputType + ") returns ("
    if m.serverStream: out += "stream " end
    ret out + m.outputType + ")"
end

@en "GenerateServices"
@fa "تولید سرویس‌ها"
pub func GenerateServices(f: PFile): str:
    if f.services.len() == 0: ret "" end
    mut sb := str.NewBuilder()
    _emit_service_consts(sb, f)
    _emit_service_funcs(sb, f)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

@en "GenerateWithServices"
@fa "تولید با سرویس‌ها"
pub func GenerateWithServices(protoSource: str): str throws:
    f := try ParseFile(protoSource)
    ret _generate(f, true)
end

@en "ServiceSummary"
@fa "خلاصه سرویس"
pub func ServiceSummary(protoSource: str): str throws:
    f := try ParseFile(protoSource)
    mut out := ""
    mut si := 0
    until si < f.services.len():
        svc := f.services.get(si)
        out = out + "service " + svc.name + " (" + conv.FormatInt(svc.methods.len() as i64) + " methods)\n"
        mut mi := 0
        until mi < svc.methods.len():
            out = out + "  rpc " + ServiceMethodSignature(f, si, mi) + "\n"
            mi++
        end
        si++
    end
    ret out
end
