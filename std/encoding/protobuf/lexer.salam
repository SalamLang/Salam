package protobuf

import str

struct Lx:
    pub s: str = ""
    pub n: int = 0
    pub pos: int = 0
    pub line: int = 1
    pub err: str = ""
    pub errPos: int = 0
    pub errEnd: bool = false
    pub errCode: str = ""
end

@en "PTokenStream"
@fa "جریان نشانه پروتو"
pub struct PTokenStream:
    @en "toks"
    @fa "نشانه‌ها"
    pub toks: Vector<PToken> = Vector {}
end

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

func _is_digit(c: int): bool: ret c >= 48 and c <= 57 end

func _is_ident_start(c: int): bool:
    ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
end

func _is_ident_cont(c: int): bool:
    ret _is_ident_start(c) or _is_digit(c)
end

func _is_hex_digit(c: int): bool:
    ret _is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
end

func _lx_peek(lx: Lx): int:
    if lx.pos >= lx.n: ret -1 end
    ret _ub(_bp(lx.s), lx.pos)
end

func _lx_peek2(lx: Lx): int:
    if lx.pos + 1 >= lx.n: ret -1 end
    ret _ub(_bp(lx.s), lx.pos + 1)
end

func _lx_fail(lx &: Lx, msg: str, pos: int, atEnd: bool, code: str):
    if lx.err != "": ret end
    lx.err = msg
    lx.errPos = pos
    lx.errEnd = atEnd
    lx.errCode = code
end

func _lx_skip_trivia(lx &: Lx):
    until true:
        c := _lx_peek(lx)
        if c == 32 or c == 9 or c == 13:
            lx.pos++
        else c == 10:
            lx.pos++
            lx.line++
        else c == 47 and _lx_peek2(lx) == 47:
            until _lx_peek(lx) != 10 and _lx_peek(lx) != -1:
                lx.pos++
            end
        else c == 47 and _lx_peek2(lx) == 42:
            start := lx.pos
            lx.pos += 2
            until true:
                d := _lx_peek(lx)
                if d == -1:
                    _lx_fail(lx, "unterminated comment", start, true, "protobuf.unterminated_comment")
                    ret
                end
                if d == 42 and _lx_peek2(lx) == 47:
                    lx.pos += 2
                    break
                end
                if d == 10: lx.line++ end
                lx.pos++
            end
        else:
            ret
        end
    end
end

func _lx_string(lx &: Lx): PToken:
    quote := _lx_peek(lx)
    startLine := lx.line
    start := lx.pos
    lx.pos++
    mut sb := str.NewBuilder()
    until true:
        c := _lx_peek(lx)
        if c == -1 or c == 10:
            str.BufFree(sb)
            _lx_fail(lx, "unterminated string", start, c == -1, "protobuf.unterminated_string")
            ret PToken { kind = PTK_ERROR, line = startLine, offset = start }
        end
        if c == quote:
            lx.pos++
            out := str.BufStr(sb)
            str.BufFree(sb)
            mut tok := PToken { kind = PTK_STRING }
            tok.sval = out
            tok.line = startLine
            tok.offset = start
            ret tok
        end
        if c == 92:
            lx.pos++
            e := _lx_peek(lx)
            if e == 110: str.BufAppendChar(sb, 10)
            else e == 116: str.BufAppendChar(sb, 9)
            else e == 114: str.BufAppendChar(sb, 13)
            else e == 92: str.BufAppendChar(sb, 92)
            else e == 34: str.BufAppendChar(sb, 34)
            else e == 39: str.BufAppendChar(sb, 39)
            else:
                str.BufAppendChar(sb, e)
            end
            lx.pos++
        else:
            str.BufAppendChar(sb, c)
            lx.pos++
        end
    end
end

func _lx_number(lx &: Lx): PToken:
    startLine := lx.line
    start := lx.pos
    mut isFloat := false
    if _lx_peek(lx) == 48 and (_lx_peek2(lx) == 120 or _lx_peek2(lx) == 88):
        lx.pos += 2
        until _is_hex_digit(_lx_peek(lx)):
            lx.pos++
        end
        text := lx.s.substr(start, lx.pos - start)
        mut tok := PToken { kind = PTK_INT }
        tok.lexeme = text
        tok.ival = _hex_to_i64(text.substr(2, text.len() - 2))
        tok.line = startLine
        tok.offset = start
        ret tok
    end
    until _is_digit(_lx_peek(lx)):
        lx.pos++
    end
    if _lx_peek(lx) == 46 and _is_digit(_lx_peek2(lx)):
        isFloat = true
        lx.pos++
        until _is_digit(_lx_peek(lx)):
            lx.pos++
        end
    end
    if _lx_peek(lx) == 101 or _lx_peek(lx) == 69:
        isFloat = true
        lx.pos++
        if _lx_peek(lx) == 43 or _lx_peek(lx) == 45: lx.pos++ end
        until _is_digit(_lx_peek(lx)):
            lx.pos++
        end
    end
    text := lx.s.substr(start, lx.pos - start)
    if isFloat:
        mut tok := PToken { kind = PTK_FLOAT }
        tok.lexeme = text
        tok.fval = text.ToFloat()
        tok.line = startLine
        tok.offset = start
        ret tok
    end
    mut tok := PToken { kind = PTK_INT }
    tok.lexeme = text
    tok.ival = text.ToInt() as i64
    tok.line = startLine
    tok.offset = start
    ret tok
end

func _hex_digit_val(c: int): i64:
    if c >= 48 and c <= 57: ret (c - 48) end
    if c >= 97 and c <= 102: ret (c - 97 + 10) end
    if c >= 65 and c <= 70: ret (c - 65 + 10) end
    ret 0
end

func _hex_to_i64(s: str): i64:
    n := s.len()
    bp := _bp(s)
    mut out := 0 as i64
    mut i := 0
    until i < n:
        out = out * (16 as i64) + _hex_digit_val(_ub(bp, i))
        i++
    end
    ret out
end

func _lx_ident(lx &: Lx): PToken:
    startLine := lx.line
    start := lx.pos
    until _is_ident_cont(_lx_peek(lx)):
        lx.pos++
    end
    mut tok := PToken { kind = PTK_IDENT }
    tok.lexeme = lx.s.substr(start, lx.pos - start)
    tok.line = startLine
    tok.offset = start
    ret tok
end

func _lx_punct_kind(c: int): int:
    if c == 59: ret PTK_SEMI end
    if c == 123: ret PTK_LBRACE end
    if c == 125: ret PTK_RBRACE end
    if c == 40: ret PTK_LPAREN end
    if c == 41: ret PTK_RPAREN end
    if c == 91: ret PTK_LBRACKET end
    if c == 93: ret PTK_RBRACKET end
    if c == 60: ret PTK_LANGLE end
    if c == 62: ret PTK_RANGLE end
    if c == 61: ret PTK_EQ end
    if c == 44: ret PTK_COMMA end
    if c == 46: ret PTK_DOT end
    if c == 45: ret PTK_MINUS end
    ret PTK_ERROR
end

func _lx_next(lx &: Lx): PToken:
    _lx_skip_trivia(lx)
    line := lx.line
    start := lx.pos
    if lx.err != "": ret PToken { kind = PTK_ERROR, line = line, offset = lx.errPos } end
    c := _lx_peek(lx)
    if c == -1: ret PToken { kind = PTK_EOF, line = line, offset = start } end
    if _is_ident_start(c): ret _lx_ident(lx) end
    if _is_digit(c): ret _lx_number(lx) end
    if c == 34 or c == 39: ret _lx_string(lx) end
    kind := _lx_punct_kind(c)
    mut n := 1
    if c >= 128:
        until n < 4 and start + n < lx.n and (_ub(_bp(lx.s), start + n) & 192) == 128:
            n++
        end
    end
    lx.pos += n
    mut tok := PToken { kind = kind, line = line, offset = start }
    tok.lexeme = lx.s.substr(start, n)
    if kind == PTK_ERROR:
        _lx_fail(lx, "unexpected character '" + tok.lexeme + "'", start, false, "protobuf.unexpected_char")
    end
    ret tok
end

@en "Tokenize"
@fa "نشانه گذاری"
pub func Tokenize(source: str): PTokenStream throws:
    mut lx := Lx { s = source }
    lx.n = source.len()
    mut out := PTokenStream {}
    until true:
        tok := _lx_next(lx)
        if lx.err != "":
            kind := lx.errEnd ? ErrorKind.UnexpectedEnd : ErrorKind.Syntax
            throw Error.At(kind, lx.err, lx.errPos).with_code(lx.errCode).locate(source).wrap("protobuf")
        end
        out.toks.push(tok)
        if tok.kind == PTK_EOF: ret out end
    end
end
