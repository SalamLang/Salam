package protobuf

struct Pp:
    pub toks: PTokenStream = PTokenStream {}
    pub count: int = 0
    pub pos: int = 0
    pub hadError: bool = false
    pub errMsg: str = ""
    pub errOffset: int = 0
    pub errAtEnd: bool = false
end

func pp_peek(p: Pp): PToken: ret p.toks.toks.get(p.pos) end

func pp_check(p: Pp, kind: int): bool: ret pp_peek(p).kind == kind end

func pp_check_ident(p: Pp, lexeme: str): bool:
    t := pp_peek(p)
    ret t.kind == PTK_IDENT and t.lexeme == lexeme
end

func pp_advance(p &: Pp): PToken:
    t := pp_peek(p)
    if p.pos < p.count - 1: p.pos++ end
    ret t
end

func pp_match(p &: Pp, kind: int): bool:
    if pp_check(p, kind):
        pp_advance(p)
        ret true
    end
    ret false
end

func pp_match_ident(p &: Pp, lexeme: str): bool:
    if pp_check_ident(p, lexeme):
        pp_advance(p)
        ret true
    end
    ret false
end

func pp_describe(t: PToken): str:
    if t.kind == PTK_EOF: ret "end of input" end
    if t.kind == PTK_STRING: ret "a string" end
    ret "'" + t.lexeme + "'"
end

func pp_error(p &: Pp, what: str):
    if p.hadError: ret end
    t := pp_peek(p)
    p.hadError = true
    p.errMsg = "expected " + what + ", found " + pp_describe(t)
    p.errOffset = t.offset
    p.errAtEnd = t.kind == PTK_EOF
end

func pp_expect(p &: Pp, kind: int, what: str): bool:
    if pp_check(p, kind):
        pp_advance(p)
        ret true
    end
    pp_error(p, what)
    ret false
end

func pp_expect_ident(p &: Pp, what: str): PToken:
    if not pp_check(p, PTK_IDENT): pp_error(p, what) end
    ret pp_advance(p)
end

func pp_expect_int(p &: Pp, what: str): PToken:
    if not pp_check(p, PTK_INT): pp_error(p, what) end
    ret pp_advance(p)
end

func pp_sync(p &: Pp):
    until not (pp_check(p, PTK_SEMI) or pp_check(p, PTK_RBRACE) or pp_check(p, PTK_EOF)):
        pp_advance(p)
    end
    if pp_check(p, PTK_SEMI): pp_advance(p) end
end

func pp_skip_balanced(p &: Pp):
    pp_expect(p, PTK_LBRACE, "'{'")
    mut depth := 1
    until depth > 0 and not pp_check(p, PTK_EOF):
        if pp_check(p, PTK_LBRACE): depth++ end
        if pp_check(p, PTK_RBRACE): depth-- end
        pp_advance(p)
    end
end

func parse_type_name(p &: Pp): str:
    mut sb := ""
    if pp_check(p, PTK_DOT):
        pp_advance(p)
        sb = "."
    end
    t := pp_expect_ident(p, "a type name")
    sb = sb.concat(t.lexeme)
    until pp_check(p, PTK_DOT) and not p.hadError:
        pp_advance(p)
        t2 := pp_expect_ident(p, "a name after '.'")
        sb = sb.concat(".").concat(t2.lexeme)
    end
    ret sb
end

func parse_field_options(p &: Pp, f &: PField):
    if not pp_match(p, PTK_LBRACKET): ret end
    until not p.hadError:
        nameTok := pp_expect_ident(p, "an option name")
        pp_expect(p, PTK_EQ, "'='")
        valTok := pp_advance(p)
        if nameTok.lexeme == "packed":
            f.packedOpt = valTok.kind == PTK_IDENT and valTok.lexeme == "true"
        end
        if nameTok.lexeme == "deprecated":
            f.is_deprecated = valTok.kind == PTK_IDENT and valTok.lexeme == "true"
        end
        if not pp_match(p, PTK_COMMA): break end
    end
    pp_expect(p, PTK_RBRACKET, "']'")
end

func parse_field_with_type(p &: Pp, msg &: PMessage, typeName: str, repeated: bool): bool:
    mut f := PField {}
    f.repeated = repeated
    scalarKind := ScalarKindFromName(typeName)
    if scalarKind != 0:
        f.kind = scalarKind
    else:
        f.kind = FK_MESSAGE
        f.typeName = typeName
    end
    nameTok := pp_expect_ident(p, "a field name")
    f.name = nameTok.lexeme
    if not pp_expect(p, PTK_EQ, "'='"):
        pp_sync(p)
        ret false
    end
    numTok := pp_expect_int(p, "a field number")
    f.number = numTok.ival as int
    parse_field_options(p, f)
    if not pp_expect(p, PTK_SEMI, "';'"):
        pp_sync(p)
        ret false
    end
    msg.fields.push(f)
    ret true
end

func parse_map_field(p &: Pp, msg &: PMessage): bool:
    pp_advance(p)
    pp_expect(p, PTK_LANGLE, "'<'")
    keyTypeName := parse_type_name(p)
    pp_expect(p, PTK_COMMA, "','")
    valTypeName := parse_type_name(p)
    pp_expect(p, PTK_RANGLE, "'>'")
    nameTok := pp_expect_ident(p, "a field name")
    if not pp_expect(p, PTK_EQ, "'='"):
        pp_sync(p)
        ret false
    end
    numTok := pp_expect_int(p, "a field number")
    mut f := PField {}
    f.name = nameTok.lexeme
    f.kind = FK_MAP
    f.keyKind = ScalarKindFromName(keyTypeName)
    valScalar := ScalarKindFromName(valTypeName)
    if valScalar != 0:
        f.mapValueKind = valScalar
    else:
        f.mapValueKind = FK_MESSAGE
        f.mapValueTypeName = valTypeName
    end
    f.number = numTok.ival as int
    parse_field_options(p, f)
    if not pp_expect(p, PTK_SEMI, "';'"):
        pp_sync(p)
        ret false
    end
    msg.fields.push(f)
    ret true
end

func parse_oneof(p &: Pp, msg &: PMessage): bool:
    pp_advance(p)
    nameTok := pp_expect_ident(p, "a oneof name")
    mut oneof := POneof { name = nameTok.lexeme }
    if not pp_expect(p, PTK_LBRACE, "'{'"):
        pp_sync(p)
        ret false
    end
    until not p.hadError:
        if pp_check(p, PTK_RBRACE) or pp_check(p, PTK_EOF): break end
        if pp_match(p, PTK_SEMI): continue end
        idx := msg.fields.Len()
        typeName := parse_type_name(p)
        ok := parse_field_with_type(p, msg, typeName, false)
        if ok:
            mut lastField := msg.fields.get(idx)
            lastField.oneofIndex = msg.oneofs.Len()
            msg.fields.set(idx, lastField)
            oneof.fieldIndices.push(idx)
        end
    end
    pp_expect(p, PTK_RBRACE, "'}'")
    msg.oneofs.push(oneof)
    ret true
end

func parse_reserved(p &: Pp):
    pp_advance(p)
    until not (pp_check(p, PTK_SEMI) or pp_check(p, PTK_EOF)):
        pp_advance(p)
    end
    pp_match(p, PTK_SEMI)
end

func parse_option_stmt(p &: Pp):
    pp_advance(p)
    until not (pp_check(p, PTK_SEMI) or pp_check(p, PTK_EOF)):
        pp_advance(p)
    end
    pp_match(p, PTK_SEMI)
end

func parse_enum(p &: Pp, out &: PEnum): bool:
    pp_advance(p)
    nameTok := pp_expect_ident(p, "an enum name")
    out.name = nameTok.lexeme
    if not pp_expect(p, PTK_LBRACE, "'{'"):
        pp_sync(p)
        ret false
    end
    until not p.hadError:
        if pp_check(p, PTK_RBRACE) or pp_check(p, PTK_EOF): break end
        if pp_match(p, PTK_SEMI): continue end
        if pp_check_ident(p, "option"):
            parse_option_stmt(p)
            continue
        end
        if pp_check_ident(p, "reserved"):
            parse_reserved(p)
            continue
        end
        valNameTok := pp_expect_ident(p, "an enum value name")
        if not pp_expect(p, PTK_EQ, "'='"):
            pp_sync(p)
            continue
        end
        mut sign := 1 as i64
        if pp_match(p, PTK_MINUS): sign = 0 - 1 as i64 end
        numTok := pp_expect_int(p, "an enum value number")
        mut ev := PEnumValue { name = valNameTok.lexeme }
        ev.number = (sign * numTok.ival) as int
        if pp_check(p, PTK_LBRACKET):
            mut dummy := PField {}
            parse_field_options(p, dummy)
        end
        out.values.push(ev)
        pp_expect(p, PTK_SEMI, "';'")
    end
    pp_expect(p, PTK_RBRACE, "'}'")
    ret true
end

func parse_message(p &: Pp, out &: PMessage): bool:
    pp_advance(p)
    nameTok := pp_expect_ident(p, "a message name")
    out.name = nameTok.lexeme
    if not pp_expect(p, PTK_LBRACE, "'{'"):
        pp_sync(p)
        ret false
    end
    until not p.hadError:
        if pp_check(p, PTK_RBRACE) or pp_check(p, PTK_EOF): break end
        if pp_match(p, PTK_SEMI): continue end
        if pp_check_ident(p, "message"):
            mut nested := PMessage {}
            parse_message(p, nested)
            out.nestedMessages.push(nested)
            continue
        end
        if pp_check_ident(p, "enum"):
            mut nestedEnum := PEnum {}
            parse_enum(p, nestedEnum)
            out.nestedEnums.push(nestedEnum)
            continue
        end
        if pp_check_ident(p, "oneof"):
            parse_oneof(p, out)
            continue
        end
        if pp_check_ident(p, "map"):
            parse_map_field(p, out)
            continue
        end
        if pp_check_ident(p, "reserved"):
            parse_reserved(p)
            continue
        end
        if pp_check_ident(p, "option"):
            parse_option_stmt(p)
            continue
        end
        mut repeated := false
        if pp_match_ident(p, "repeated"):
            repeated = true
        else:
            pp_match_ident(p, "optional")
        end
        typeName := parse_type_name(p)
        parse_field_with_type(p, out, typeName, repeated)
    end
    pp_expect(p, PTK_RBRACE, "'}'")
    ret true
end

func parse_rpc(p &: Pp, out &: PService):
    pp_advance(p)
    nameTok := pp_expect_ident(p, "a method name")
    mut m := PMethod {}
    m.name = nameTok.lexeme
    pp_expect(p, PTK_LPAREN, "'('")
    if pp_match_ident(p, "stream"): m.clientStream = true end
    m.inputType = parse_type_name(p)
    pp_expect(p, PTK_RPAREN, "')'")
    if not pp_match_ident(p, "returns"):
        pp_error(p, "'returns'")
        pp_sync(p)
        ret
    end
    pp_expect(p, PTK_LPAREN, "'('")
    if pp_match_ident(p, "stream"): m.serverStream = true end
    m.outputType = parse_type_name(p)
    pp_expect(p, PTK_RPAREN, "')'")
    if pp_check(p, PTK_LBRACE):
        pp_skip_balanced(p)
    else:
        pp_expect(p, PTK_SEMI, "';'")
    end
    out.methods.push(m)
end

func parse_service(p &: Pp, out &: PFile):
    pp_advance(p)
    nameTok := pp_expect_ident(p, "a service name")
    mut svc := PService {}
    svc.name = nameTok.lexeme
    pp_expect(p, PTK_LBRACE, "'{'")
    until not pp_check(p, PTK_RBRACE) and not pp_check(p, PTK_EOF) and not p.hadError:
        if pp_match(p, PTK_SEMI): continue end
        if pp_check_ident(p, "option"):
            parse_option_stmt(p)
            continue
        end
        if pp_check_ident(p, "rpc"):
            parse_rpc(p, svc)
            continue
        end
        pp_error(p, "'rpc' or 'option' in the service body")
        pp_sync(p)
    end
    pp_expect(p, PTK_RBRACE, "'}'")
    out.services.push(svc)
end

func parse_package_stmt(p &: Pp, out &: PFile):
    pp_advance(p)
    name := parse_type_name(p)
    out.packageName = name
    pp_expect(p, PTK_SEMI, "';'")
end

func parse_import_stmt(p &: Pp, out &: PFile):
    pp_advance(p)
    pp_match_ident(p, "public")
    pp_match_ident(p, "weak")
    if not pp_check(p, PTK_STRING): pp_error(p, "a file name in quotes") end
    strTok := pp_advance(p)
    out.imports.push(strTok.sval)
    pp_expect(p, PTK_SEMI, "';'")
end

func parse_syntax_stmt(p &: Pp):
    pp_advance(p)
    pp_expect(p, PTK_EQ, "'='")
    if not pp_check(p, PTK_STRING): pp_error(p, "the syntax name in quotes") end
    pp_advance(p)
    pp_expect(p, PTK_SEMI, "';'")
end

@en "ParseFile"
@fa "تجزیه پرونده"
pub func ParseFile(source: str): PFile throws:
    mut out := PFile {}
    ts := try Tokenize(source)
    mut p := Pp {}
    p.toks = ts
    p.count = ts.toks.Len()
    p.pos = 0
    until not p.hadError:
        if pp_check(p, PTK_EOF): break end
        if pp_match(p, PTK_SEMI): continue end
        if pp_check_ident(p, "syntax"):
            parse_syntax_stmt(p)
            continue
        end
        if pp_check_ident(p, "package"):
            parse_package_stmt(p, out)
            continue
        end
        if pp_check_ident(p, "import"):
            parse_import_stmt(p, out)
            continue
        end
        if pp_check_ident(p, "option"):
            parse_option_stmt(p)
            continue
        end
        if pp_check_ident(p, "message"):
            mut msg := PMessage {}
            parse_message(p, msg)
            out.messages.push(msg)
            continue
        end
        if pp_check_ident(p, "enum"):
            mut en := PEnum {}
            parse_enum(p, en)
            out.enums.push(en)
            continue
        end
        if pp_check_ident(p, "service"):
            parse_service(p, out)
            continue
        end
        pp_error(p, "'message', 'enum', 'service' or another top-level statement")
    end
    if p.hadError:
        kind := p.errAtEnd ? ErrorKind.UnexpectedEnd : ErrorKind.Syntax
        code := p.errAtEnd ? "protobuf.unexpected_end" : "protobuf.unexpected_token"
        throw Error.At(kind, p.errMsg, p.errOffset).with_code(code).locate(source).wrap("protobuf")
    end
    ret out
end
