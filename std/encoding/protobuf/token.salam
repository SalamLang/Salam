package protobuf

@en "PTK_EOF"
@fa "نشانه اتمام"
pub const PTK_EOF := 0
@en "PTK_IDENT"
@fa "نشانه شناسه"
pub const PTK_IDENT := 1
@en "PTK_INT"
@fa "نشانه عدد صحیح"
pub const PTK_INT := 2
@en "PTK_FLOAT"
@fa "نشانه عدد اعشاری"
pub const PTK_FLOAT := 3
@en "PTK_STRING"
@fa "نشانه رشته"
pub const PTK_STRING := 4
@en "PTK_SEMI"
@fa "نشانه نقطه‌ویرگول"
pub const PTK_SEMI := 5
@en "PTK_LBRACE"
@fa "نشانه آکولاد باز"
pub const PTK_LBRACE := 6
@en "PTK_RBRACE"
@fa "نشانه آکولاد بسته"
pub const PTK_RBRACE := 7
@en "PTK_LPAREN"
@fa "نشانه پرانتز باز"
pub const PTK_LPAREN := 8
@en "PTK_RPAREN"
@fa "نشانه پرانتز بسته"
pub const PTK_RPAREN := 9
@en "PTK_LBRACKET"
@fa "نشانه کروشه باز"
pub const PTK_LBRACKET := 10
@en "PTK_RBRACKET"
@fa "نشانه کروشه بسته"
pub const PTK_RBRACKET := 11
@en "PTK_LANGLE"
@fa "نشانه زاویه باز"
pub const PTK_LANGLE := 12
@en "PTK_RANGLE"
@fa "نشانه زاویه بسته"
pub const PTK_RANGLE := 13
@en "PTK_EQ"
@fa "نشانه مساوی"
pub const PTK_EQ := 14
@en "PTK_COMMA"
@fa "نشانه ویرگول"
pub const PTK_COMMA := 15
@en "PTK_DOT"
@fa "نشانه نقطه"
pub const PTK_DOT := 16
@en "PTK_MINUS"
@fa "نشانه منها"
pub const PTK_MINUS := 17
@en "PTK_ERROR"
@fa "نشانه خطا"
pub const PTK_ERROR := 18

@en "PToken"
@fa "نشانه پروتو"
pub struct PToken:
    pub kind: int = PTK_EOF
    pub lexeme: str = ""
    pub ival: i64 = 0
    pub fval: f64 = 0.0
    pub sval: str = ""
    pub line: int = 0
end
