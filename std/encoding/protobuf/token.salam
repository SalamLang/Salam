package protobuf

// token - .proto lexical tokens. Keywords (message/repeated/oneof/map/...)
// are NOT separate token kinds - the parser matches PTK_IDENT by lexeme,
// since some .proto keywords are contextual (valid as field/message names
// in places), matching how compiler/parser.salam treats Salam's own
// keywords in similar contexts.

pub const PTK_EOF := 0
pub const PTK_IDENT := 1
pub const PTK_INT := 2
pub const PTK_FLOAT := 3
pub const PTK_STRING := 4
pub const PTK_SEMI := 5
pub const PTK_LBRACE := 6
pub const PTK_RBRACE := 7
pub const PTK_LPAREN := 8
pub const PTK_RPAREN := 9
pub const PTK_LBRACKET := 10
pub const PTK_RBRACKET := 11
pub const PTK_LANGLE := 12
pub const PTK_RANGLE := 13
pub const PTK_EQ := 14
pub const PTK_COMMA := 15
pub const PTK_DOT := 16
pub const PTK_MINUS := 17
pub const PTK_ERROR := 18

pub struct PToken:
    pub kind: int = PTK_EOF
    pub lexeme: str = ""
    pub ival: i64 = 0
    pub fval: f64 = 0.0
    pub sval: str = ""
    pub line: int = 0
end
