package protobuf

import compress
import encoding.binary

@en "WT_VARINT"
@fa "نوع سیم متغیر"
pub const WT_VARINT := 0
@en "WT_FIXED64"
@fa "نوع سیم ثابت۶۴"
pub const WT_FIXED64 := 1
@en "WT_LEN"
@fa "نوع سیم طول‌دار"
pub const WT_LEN := 2
@en "WT_FIXED32"
@fa "نوع سیم ثابت۳۲"
pub const WT_FIXED32 := 5

@en "MakeTag"
@fa "ساخت برچسب"
pub func MakeTag(fieldNum: int, wireType: int): u64:
    ret ((fieldNum as u64) << (3 as u64)) | (wireType as u64)
end

@en "WriteVarint"
@fa "نوشتن عدد متغیر"
pub func WriteVarint(buf &: compress.ByteBuf, n: u64):
    mut v := n
    until true:
        b := (v & (127 as u64)) as int
        v = v >> (7 as u64)
        if v != (0 as u64):
            compress.BufPush(buf, b | 128)
        else:
            compress.BufPush(buf, b)
            ret
        end
    end
end

@en "ReadVarint"
@fa "خواندن عدد متغیر"
pub func ReadVarint(r &: compress.ByteReader, ok &: bool): u64:
    mut result := 0 as u64
    mut shift := 0 as u64
    mut i := 0
    until i < 10:
        b := compress.RdByte(r)
        if r.bad:
            ok = false
            ret 0
        end
        result = result | (((b & 127) as u64) << shift)
        if (b & 128) == 0:
            ok = true
            ret result
        end
        shift = shift + (7 as u64)
        i += 1
    end
    ok = false
    ret 0
end

@en "WriteTag"
@fa "نوشتن برچسب"
pub func WriteTag(buf &: compress.ByteBuf, fieldNum: int, wireType: int):
    WriteVarint(buf, MakeTag(fieldNum, wireType))
end

@en "ReadTag"
@fa "خواندن برچسب"
pub func ReadTag(r &: compress.ByteReader, fieldNum &: int, wireType &: int, ok &: bool):
    mut vok := false
    tag := ReadVarint(r, vok)
    if not vok:
        ok = false
        ret
    end
    fieldNum = (tag >> (3 as u64)) as int
    wireType = (tag & (7 as u64)) as int
    ok = true
end

@en "ZigZagEncode32"
@fa "کدگذاری زیگزاگ۳۲"
pub func ZigZagEncode32(n: i32): u32: ret ((n << 1) ^ (n >> 31)) as u32 end
@en "ZigZagDecode32"
@fa "کدگشایی زیگزاگ۳۲"
pub func ZigZagDecode32(n: u32): i32:
    ni := n as i32
    ret ((ni >> 1) ^ (0 - (ni & 1)))
end

@en "ZigZagEncode64"
@fa "کدگذاری زیگزاگ۶۴"
pub func ZigZagEncode64(n: i64): u64: ret ((n << 1) ^ (n >> 63)) as u64 end
@en "ZigZagDecode64"
@fa "کدگشایی زیگزاگ۶۴"
pub func ZigZagDecode64(n: u64): i64:
    ni := n as i64
    ret ((ni >> 1) ^ (0 - (ni & 1)))
end

@en "WriteFixed32"
@fa "نوشتن ثابت۳۲"
pub func WriteFixed32(buf &: compress.ByteBuf, v: u32): binary.WriteU32LE(buf, v as int) end
@en "ReadFixed32"
@fa "خواندن ثابت۳۲"
pub func ReadFixed32(r &: compress.ByteReader, ok &: bool): u32:
    if compress.RdLeft(r) < 4:
        ok = false
        ret 0
    end
    ok = true
    ret binary.ReadU32LE(r) as u32
end

@en "WriteFixed64"
@fa "نوشتن ثابت۶۴"
pub func WriteFixed64(buf &: compress.ByteBuf, v: u64): binary.WriteU64LE(buf, v as i64) end
@en "ReadFixed64"
@fa "خواندن ثابت۶۴"
pub func ReadFixed64(r &: compress.ByteReader, ok &: bool): u64:
    if compress.RdLeft(r) < 8:
        ok = false
        ret 0
    end
    ok = true
    ret binary.ReadU64LE(r) as u64
end

@en "WriteFloat"
@fa "نوشتن اعشار۳۲"
pub func WriteFloat(buf &: compress.ByteBuf, v: f64): binary.WriteF32(buf, v, false) end
@en "ReadFloat"
@fa "خواندن اعشار۳۲"
pub func ReadFloat(r &: compress.ByteReader, ok &: bool): f64:
    if compress.RdLeft(r) < 4:
        ok = false
        ret 0.0
    end
    ok = true
    ret binary.ReadF32(r, false)
end

@en "WriteDouble"
@fa "نوشتن اعشار۶۴"
pub func WriteDouble(buf &: compress.ByteBuf, v: f64): binary.WriteF64(buf, v, false) end
@en "ReadDouble"
@fa "خواندن اعشار۶۴"
pub func ReadDouble(r &: compress.ByteReader, ok &: bool): f64:
    if compress.RdLeft(r) < 8:
        ok = false
        ret 0.0
    end
    ok = true
    ret binary.ReadF64(r, false)
end

@en "WriteLenPrefixedBytes"
@fa "نوشتن بایت‌های طول‌دار"
pub func WriteLenPrefixedBytes(buf &: compress.ByteBuf, p: void*, n: int):
    WriteVarint(buf, n as u64)
    compress.BufPushBytes(buf, p, n)
end

@en "WriteLenPrefixedStr"
@fa "نوشتن رشته طول‌دار"
pub func WriteLenPrefixedStr(buf &: compress.ByteBuf, s: str):
    WriteLenPrefixedBytes(buf, s as void*, s.len())
end

@en "ReadLenPrefixedBuf"
@fa "خواندن بافر طول‌دار"
pub func ReadLenPrefixedBuf(r &: compress.ByteReader, ok &: bool): compress.ByteBuf:
    mut vok := false
    n := ReadVarint(r, vok)
    if not vok or compress.RdLeft(r) < (n as int):
        ok = false
        ret compress.NewByteBuf()
    end
    ok = true
    ret compress.RdBytes(r, n as int)
end

@en "ReadLenPrefixedStr"
@fa "خواندن رشته طول‌دار"
pub func ReadLenPrefixedStr(r &: compress.ByteReader, ok &: bool): str:
    mut b := ReadLenPrefixedBuf(r, ok)
    out := compress.BufToStrUnsafe(b)
    compress.BufFree(b)
    ret out
end

@en "SkipField"
@fa "رد کردن فیلد"
pub func SkipField(r &: compress.ByteReader, wireType: int, ok &: bool):
    if wireType == WT_VARINT:
        mut vok := false
        ReadVarint(r, vok)
        ok = vok
        ret
    end
    if wireType == WT_FIXED64:
        if compress.RdLeft(r) < 8:
            ok = false
            ret
        end
        binary.ReadU64LE(r)
        ok = true
        ret
    end
    if wireType == WT_FIXED32:
        if compress.RdLeft(r) < 4:
            ok = false
            ret
        end
        binary.ReadU32LE(r)
        ok = true
        ret
    end
    if wireType == WT_LEN:
        mut bok := false
        mut b := ReadLenPrefixedBuf(r, bok)
        compress.BufFree(b)
        ok = bok
        ret
    end
    ok = false
end
