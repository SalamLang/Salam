package protobuf

import compress
import encoding.binary

@en "WT_VARINT"
@fa "نوع سیم متغیر"
pub const WT_VARINT := 0
@en "WT_FIXED64"
@fa "نوع سیم ثابت۶۴"
pub const WT_FIXED64 := 1
@en "WT_LEN"
@fa "نوع سیم طول‌دار"
pub const WT_LEN := 2
@en "WT_FIXED32"
@fa "نوع سیم ثابت۳۲"
pub const WT_FIXED32 := 5

func _pb_err(kind: ErrorKind, msg: str, offset: int, code: str): Error:
    ret Error.At(kind, msg, offset).with_code(code).wrap("protobuf")
end

func _pb_need(r: compress.ByteReader, n: int, what: str) throws:
    if r.bad or compress.RdLeft(r) < n:
        throw _pb_err(ErrorKind.UnexpectedEnd, what + " needs " + n + " bytes, " + compress.RdLeft(r) + " left", r.pos, "protobuf.truncated")
    end
end

func _pb_len(r &: compress.ByteReader): int throws:
    start := r.pos
    n := try ReadVarint(r)
    left := compress.RdLeft(r)
    if n > (left as u64):
        throw _pb_err(ErrorKind.UnexpectedEnd, "length-prefixed field needs " + n + " bytes, " + left + " left", start, "protobuf.truncated")
    end
    ret n as int
end

@en "MakeTag"
@fa "ساخت برچسب"
pub func MakeTag(fieldNum: int, wireType: int): u64:
    ret ((fieldNum as u64) << (3 as u64)) | (wireType as u64)
end

@en "WriteVarint"
@fa "نوشتن عدد متغیر"
pub func WriteVarint(buf &: compress.ByteBuf, n: u64):
    mut v := n
    until true:
        b := (v & (127 as u64)) as int
        v = v >> (7 as u64)
        if v != (0 as u64):
            compress.BufPush(buf, b | 128)
        else:
            compress.BufPush(buf, b)
            ret
        end
    end
end

@en "ReadVarint"
@fa "خواندن عدد متغیر"
pub func ReadVarint(r &: compress.ByteReader): u64 throws:
    start := r.pos
    mut result := 0 as u64
    mut shift := 0 as u64
    mut i := 0
    until i < 10:
        if r.bad or compress.RdLeft(r) < 1:
            throw _pb_err(ErrorKind.UnexpectedEnd, "varint is cut short", r.pos, "protobuf.truncated")
        end
        b := compress.RdByte(r)
        if i == 9 and b > 1:
            throw _pb_err(ErrorKind.OutOfRange, "varint does not fit in 64 bits", start, "protobuf.varint_overflow")
        end
        result = result | (((b & 127) as u64) << shift)
        if (b & 128) == 0:
            ret result
        end
        shift = shift + (7 as u64)
        i += 1
    end
    throw _pb_err(ErrorKind.OutOfRange, "varint is longer than 10 bytes", start, "protobuf.varint_overflow")
end

@en "WriteTag"
@fa "نوشتن برچسب"
pub func WriteTag(buf &: compress.ByteBuf, fieldNum: int, wireType: int):
    WriteVarint(buf, MakeTag(fieldNum, wireType))
end

@en "ReadTag"
@fa "خواندن برچسب"
pub func ReadTag(r &: compress.ByteReader, fieldNum &: int, wireType &: int) throws:
    start := r.pos
    tag := try ReadVarint(r)
    num := tag >> (3 as u64)
    wt := (tag & (7 as u64)) as int
    if num == (0 as u64) or num > (536870911 as u64):
        throw _pb_err(ErrorKind.Syntax, "invalid field number " + num, start, "protobuf.bad_field_number")
    end
    if wt == 6 or wt == 7:
        throw _pb_err(ErrorKind.Syntax, "invalid wire type " + wt + " for field " + num, start, "protobuf.bad_wire_type")
    end
    fieldNum = num as int
    wireType = wt
end

@en "ZigZagEncode32"
@fa "کدگذاری زیگزاگ۳۲"
pub func ZigZagEncode32(n: i32): u32: ret ((n << 1) ^ (n >> 31)) as u32 end
@en "ZigZagDecode32"
@fa "کدگشایی زیگزاگ۳۲"
pub func ZigZagDecode32(n: u32): i32:
    ni := n as i32
    ret ((ni >> 1) ^ (0 - (ni & 1)))
end

@en "ZigZagEncode64"
@fa "کدگذاری زیگزاگ۶۴"
pub func ZigZagEncode64(n: i64): u64: ret ((n << 1) ^ (n >> 63)) as u64 end
@en "ZigZagDecode64"
@fa "کدگشایی زیگزاگ۶۴"
pub func ZigZagDecode64(n: u64): i64:
    ni := n as i64
    ret ((ni >> 1) ^ (0 - (ni & 1)))
end

@en "WriteFixed32"
@fa "نوشتن ثابت۳۲"
pub func WriteFixed32(buf &: compress.ByteBuf, v: u32): binary.WriteU32LE(buf, v as int) end
@en "ReadFixed32"
@fa "خواندن ثابت۳۲"
pub func ReadFixed32(r &: compress.ByteReader): u32 throws:
    try _pb_need(r, 4, "fixed32")
    ret try binary.ReadU32LE(r) as u32
end

@en "WriteFixed64"
@fa "نوشتن ثابت۶۴"
pub func WriteFixed64(buf &: compress.ByteBuf, v: u64): binary.WriteU64LE(buf, v as i64) end
@en "ReadFixed64"
@fa "خواندن ثابت۶۴"
pub func ReadFixed64(r &: compress.ByteReader): u64 throws:
    try _pb_need(r, 8, "fixed64")
    ret try binary.ReadU64LE(r) as u64
end

@en "WriteFloat"
@fa "نوشتن اعشار۳۲"
pub func WriteFloat(buf &: compress.ByteBuf, v: f64): binary.WriteF32(buf, v, false) end
@en "ReadFloat"
@fa "خواندن اعشار۳۲"
pub func ReadFloat(r &: compress.ByteReader): f64 throws:
    try _pb_need(r, 4, "float")
    ret try binary.ReadF32(r, false)
end

@en "WriteDouble"
@fa "نوشتن اعشار۶۴"
pub func WriteDouble(buf &: compress.ByteBuf, v: f64): binary.WriteF64(buf, v, false) end
@en "ReadDouble"
@fa "خواندن اعشار۶۴"
pub func ReadDouble(r &: compress.ByteReader): f64 throws:
    try _pb_need(r, 8, "double")
    ret try binary.ReadF64(r, false)
end

@en "WriteLenPrefixedBytes"
@fa "نوشتن بایت‌های طول‌دار"
pub func WriteLenPrefixedBytes(buf &: compress.ByteBuf, p: void*, n: int):
    WriteVarint(buf, n as u64)
    compress.BufPushBytes(buf, p, n)
end

@en "WriteLenPrefixedStr"
@fa "نوشتن رشته طول‌دار"
pub func WriteLenPrefixedStr(buf &: compress.ByteBuf, s: str):
    WriteLenPrefixedBytes(buf, s as void*, s.len())
end

@en "ReadLenPrefixedBuf"
@fa "خواندن بافر طول‌دار"
pub func ReadLenPrefixedBuf(r &: compress.ByteReader): compress.ByteBuf throws:
    n := try _pb_len(r)
    ret compress.RdBytes(r, n)
end

@en "ReadLenPrefixedStr"
@fa "خواندن رشته طول‌دار"
pub func ReadLenPrefixedStr(r &: compress.ByteReader): str throws:
    n := try _pb_len(r)
    b := compress.RdBytes(r, n)
    out := compress.BufToStrUnsafe(b)
    compress.BufFree(b)
    ret out
end

@en "SkipField"
@fa "رد کردن فیلد"
pub func SkipField(r &: compress.ByteReader, wireType: int) throws:
    start := r.pos
    if wireType == WT_VARINT:
        try ReadVarint(r)
    else wireType == WT_FIXED64:
        try _pb_need(r, 8, "fixed64")
        r.pos += 8
    else wireType == WT_FIXED32:
        try _pb_need(r, 4, "fixed32")
        r.pos += 4
    else wireType == WT_LEN:
        n := try _pb_len(r)
        r.pos += n
    else wireType == 3 or wireType == 4:
        throw _pb_err(ErrorKind.Unsupported, "groups (wire type " + wireType + ") are not supported", start, "protobuf.group")
    else:
        throw _pb_err(ErrorKind.Syntax, "invalid wire type " + wireType, start, "protobuf.bad_wire_type")
    end
end
