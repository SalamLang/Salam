@en "query"
@fa "پرس‌وجو"
package query

import str
import encoding

@en "QueryOptions"
@fa "گزینه‌های پرس‌وجو"
pub struct QueryOptions:
    @en "space_as_plus"
    @fa "فاصله پلاس"
    pub space_as_plus: bool = true
end

@en "QueryValues"
@fa "مقدارهای پرس‌وجو"
pub struct QueryValues:
    @en "items"
    @fa "مقدارها"
    pub items: Vector<str> = Vector {}
end

@en "QueryMap"
@fa "نگاشت پرس‌وجو"
pub struct QueryMap:
    @en "data"
    @fa "داده"
    pub data: HashMap<str, QueryValues> = HashMap {} as HashMap<str, QueryValues>
    @en "order"
    @fa "ترتیب"
    pub order: Vector<str> = Vector {}
end

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

func _hexval(code: int): int:
    if code >= 48 and code <= 57: ret code - 48 end
    if code >= 65 and code <= 70: ret code - 55 end
    if code >= 97 and code <= 102: ret code - 87 end
    ret 0 - 1
end

func _pct_decode(text: str, from: int, stop: int, plus_as_space: bool, strict: bool, err &: Error): str:
    bp := _bp(text)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := from
    until i < stop:
        code := _ub(bp, i)
        if code == 37:
            mut hi := 0 - 1
            mut lo := 0 - 1
            if i + 1 < stop: hi = _hexval(_ub(bp, i + 1)) end
            if i + 2 < stop: lo = _hexval(_ub(bp, i + 2)) end
            if hi >= 0 and lo >= 0:
                str.BufAppendChar(sb, hi * 16 + lo)
                i += 3
            else:
                if strict and err.message == "":
                    mut kind := ErrorKind.Syntax
                    mut message := "malformed percent escape"
                    if i + 2 >= stop and (i + 1 >= stop or hi >= 0):
                        kind = ErrorKind.UnexpectedEnd
                        message = "incomplete percent escape"
                    end
                    err = Error.At(kind, message, i).locate(text).wrap("query")
                end
                str.BufAppendChar(sb, code)
                i++
            end
        else code == 43 and plus_as_space:
            str.BufAppendChar(sb, 32)
            i++
        else:
            str.BufAppendChar(sb, code)
            i++
        end
    end
    ret str.BufStr(sb)
end

func _parse(qs: str, opts: QueryOptions, strict: bool, err &: Error): QueryMap:
    mut out := QueryMap {}
    n := qs.Len()
    bp := _bp(qs)
    mut pos := 0
    if n > 0 and _ub(bp, 0) == 63: pos = 1 end
    until pos < n:
        mut pend := pos
        until pend < n and _ub(bp, pend) != 38:
            pend++
        end
        if pend > pos:
            mut eq_at := pos
            until eq_at < pend and _ub(bp, eq_at) != 61:
                eq_at++
            end
            key := _pct_decode(qs, pos, eq_at, opts.space_as_plus, strict, err)
            mut val := ""
            if eq_at < pend:
                val = _pct_decode(qs, eq_at + 1, pend, opts.space_as_plus, strict, err)
            end
            if strict and err.message != "": ret out end
            mut qv := QueryValues {}
            if out.data.has(key):
                qv = out.data.get(key)
            else:
                out.order.push(key)
            end
            qv.items.push(val)
            out.data.put(key, qv)
        end
        pos = pend + 1
    end
    ret out
end

func _encode_component(s: str, space_as_plus: bool): str:
    enc := encoding.URLEncode(s)
    if space_as_plus: ret str.Replace(enc, "%20", "+") end
    ret enc
end

@en "NewQueryMap"
@fa "نگاشت پرس‌وجو جدید"
pub func NewQueryMap(): QueryMap: ret QueryMap {} end

@en "DecodeWith"
@fa "کدگشایی سفارشی"
pub func DecodeWith(qs: str, opts: QueryOptions): QueryMap throws:
    mut err := Error {}
    out := _parse(qs, opts, true, err)
    if err.message != "": throw err end
    ret out
end

@en "Decode"
@fa "کدگشایی"
pub func Decode(qs: str): QueryMap throws:
    ret try DecodeWith(qs, QueryOptions {})
end

@en "EncodeWith"
@fa "کدگذاری سفارشی"
pub func EncodeWith(values: QueryMap, opts: QueryOptions): str:
    mut out := str.NewBuilder()
    mut first := true
    mut i := 0
    until i < values.order.Len():
        k := values.order.get(i)
        i++
        if values.data.has(k) == false: continue end
        qv := values.data.get(k)
        mut j := 0
        until j < qv.items.Len():
            if not first: str.BufAppendChar(out, 38) end
            first = false
            str.BufAppend(out, _encode_component(k, opts.space_as_plus))
            str.BufAppendChar(out, 61)
            str.BufAppend(out, _encode_component(qv.items.get(j), opts.space_as_plus))
            j++
        end
    end
    ret str.BufStr(out)
end

@en "Encode"
@fa "کدگذاری"
pub func Encode(values: QueryMap): str:
    ret EncodeWith(values, QueryOptions {})
end

@en "GetAll"
@fa "همه مقدارها"
pub func GetAll(qs: str, key: str): Vector<str>:
    mut err := Error {}
    m := _parse(qs, QueryOptions {}, false, err)
    if m.data.has(key): ret m.data.get(key).items end
    ret Vector {}
end

@en "Get"
@fa "مقدار"
pub func Get(qs: str, key: str): str:
    vs := GetAll(qs, key)
    if vs.Len() > 0: ret vs.get(0) end
    ret ""
end

@en "Has"
@fa "دارد"
pub func Has(qs: str, key: str): bool:
    mut err := Error {}
    m := _parse(qs, QueryOptions {}, false, err)
    ret m.data.has(key)
end

@en "Size"
@fa "اندازه"
pub func Size(m: QueryMap): int: ret m.data.size() end

@en "Add"
@fa "افزودن"
pub func Add(values &: QueryMap, key: str, val: str):
    mut qv := QueryValues {}
    if values.data.has(key):
        qv = values.data.get(key)
    else:
        values.order.push(key)
    end
    qv.items.push(val)
    values.data.put(key, qv)
end

@en "Set"
@fa "تنظیم"
pub func Set(values &: QueryMap, key: str, val: str):
    mut qv := QueryValues {}
    qv.items.push(val)
    if values.data.has(key) == false: values.order.push(key) end
    values.data.put(key, qv)
end

@en "Keys"
@fa "کلیدها"
pub func Keys(values: QueryMap): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut i := 0
    until i < values.order.Len():
        out.push(values.order.get(i))
        i++
    end
    ret out
end

@en "Remove"
@fa "حذف"
pub func Remove(values &: QueryMap, key: str): bool:
    if values.data.has(key) == false: ret false end
    values.data.remove(key)
    mut i := 0
    until i < values.order.Len():
        if values.order.get(i) == key:
            values.order.remove_at(i)
            ret true
        end
        i++
    end
    ret true
end

@en "Retain"
@fa "نگه داشتن"
pub func Retain(values &: QueryMap, keep: Vector<str>):
    ks := Keys(values)
    defer ks.free()
    mut i := 0
    until i < ks.Len():
        k := ks.get(i)
        mut found := false
        mut j := 0
        until j < keep.Len():
            if keep.get(j) == k: found = true end
            j++
        end
        if found == false: Remove(values, k) end
        i++
    end
end
