@en "serde"
@fa "تبدیل قالب"
package serde

import encoding.value
import encoding.json
import encoding.yaml
import encoding.toml
import encoding.xml
import encoding.csv
import str

@en "FormatUnknown"
@fa "قالب ناشناخته"
pub const FormatUnknown := 0
@en "FormatJSON"
@fa "قالب جیسون"
pub const FormatJSON := 1
@en "FormatYAML"
@fa "قالب یامل"
pub const FormatYAML := 2
@en "FormatTOML"
@fa "قالب تامل"
pub const FormatTOML := 3
@en "FormatXML"
@fa "قالب اکس‌ام‌ال"
pub const FormatXML := 4
@en "FormatCSV"
@fa "قالب سی اس وی"
pub const FormatCSV := 5

func _trim_leading_ws(s: str): str:
    n := s.len()
    mut i := 0
    until i < n:
        c := s.substr(i, 1)
        if c != " " and c != "\t" and c != "\n" and c != "\r": break end
        i += 1
    end
    ret s.substr(i, n - i)
end

func _looks_toml(s: str): bool:
    lines := str.Split(s, "\n")
    mut i := 0
    until i < lines.len():
        line := _trim_leading_ws(lines.get(i))
        if line.len() > 0 and str.CharAt(line, 0) != "#":
            if str.CharAt(line, 0) == "[": ret true end
            eq_at := str.IndexOf(line, "=")
            colon := str.IndexOf(line, ":")
            if eq_at >= 0 and (colon < 0 or eq_at < colon): ret true end
        end
        i += 1
    end
    ret false
end

func _same_width(t: csv.CSVTable): bool:
    if t.rows.len() < 2: ret false end
    first := t.rows.get(0).fields.len()
    if first < 2: ret false end
    repeat t.rows.len() in j:
        if t.rows.get(j).fields.len() != first: ret false end
    end
    ret true
end

func _looks_csv(s: str): bool:
    try:
        mut t := csv.ReadAll(s)
        out := _same_width(t)
        csv.FreeTable(t)
        ret out
    catch:
        ret false
    end
end

func _decode_by_name(data: str, from: str): value.Value throws:
    if from == "json":
        ret try json.Decode(data)
    end
    if from == "yaml":
        ret try yaml.Decode(data)
    end
    if from == "toml":
        ret try toml.Decode(data)
    end
    if from == "xml":
        node := try xml.Decode(data)
        ret xml.ToValue(node)
    end
    if from == "csv":
        ret try csv.ToValue(data)
    end
    throw Error.New(ErrorKind.InvalidArgument, "unknown format '" + from + "'").wrap("serde")
end

func _encode_by_name(v: value.Value, dest: str): str throws:
    if dest == "json": ret json.EncodeDefault(v) end
    if dest == "yaml": ret yaml.Encode(v) end
    if dest == "toml": ret try toml.Encode(v) end
    if dest == "xml": ret xml.EncodeDeclaration(xml.FromValue(v, "root")) end
    if dest == "csv": ret csv.FromValue(v) end
    throw Error.New(ErrorKind.InvalidArgument, "unknown format '" + dest + "'").wrap("serde")
end

@en "DetectFormat"
@fa "تشخیص شماره قالب"
pub func DetectFormat(text: str): int:
    trimmed := _trim_leading_ws(text)
    if trimmed.len() == 0: ret FormatUnknown end
    if str.CharAt(trimmed, 0) == "<": ret FormatXML end
    if json.Valid(trimmed): ret FormatJSON end
    if _looks_toml(trimmed) and toml.Valid(trimmed): ret FormatTOML end
    if _looks_csv(trimmed): ret FormatCSV end
    if yaml.Valid(trimmed): ret FormatYAML end
    ret FormatUnknown
end

@en "Detect"
@fa "تشخیص قالب"
pub func Detect(text: str): str:
    f := DetectFormat(text)
    if f == FormatJSON: ret "json" end
    if f == FormatYAML: ret "yaml" end
    if f == FormatTOML: ret "toml" end
    if f == FormatXML: ret "xml" end
    if f == FormatCSV: ret "csv" end
    ret ""
end

@en "TranscodeStrict"
@fa "تبدیل قالب سخت گیرانه"
pub func TranscodeStrict(data: str, from: str, dest: str): str throws:
    v := try _decode_by_name(data, from)
    ret try _encode_by_name(v, dest)
end

@en "Transcode"
@fa "تبدیل قالب"
pub func Transcode(data: str, from: str, dest: str): str:
    try:
        ret TranscodeStrict(data, from, dest)
    catch:
        ret ""
    end
end
