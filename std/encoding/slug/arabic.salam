func _arab_vowelish(cp: int): bool:
    switch cp:
        0x627, 0x622, 0x623, 0x625, 0x671, 0x648, 0x64A, 0x6CC, 0x649, 0x624, 0x626: ret true end
    end
    ret false
end

func _arab_adj(cps: Vector<int>, i: int, step: int): int:
    n := cps.len()
    mut k := i + step
    until k >= 0 and k < n and _is_mark(cps.get(k)) and cps.get(k) != 0x200C:
        k += step
    end
    if k < 0 or k >= n: ret 0 end
    c := cps.get(k)
    if _script_of(c) != S_ARABIC: ret 0 end
    ret c
end

func _arab_letter(cp: int, fa: bool): str:
    switch cp:
        0x622, 0x627, 0x623, 0x625, 0x671: ret "a" end
        0x628: ret "b" end
        0x67E: ret "p" end
        0x62A, 0x629, 0x67C, 0x679: ret "t" end
        0x62C: ret "j" end
        0x686: ret "ch" end
        0x62D, 0x647, 0x6BE, 0x6C1, 0x6D5: ret "h" end
        0x62E: ret "kh" end
        0x62F, 0x688: ret "d" end
        0x631, 0x691: ret "r" end
        0x632: ret "z" end
        0x698: ret "zh" end
        0x633, 0x635: ret "s" end
        0x634: ret "sh" end
        0x637: ret "t" end
        0x638: ret "z" end
        0x639: ret "a" end
        0x63A: ret "gh" end
        0x641, 0x6A2, 0x6A3: ret "f" end
        0x6A4, 0x6A5: ret "v" end
        0x643, 0x6A9, 0x6AA: ret "k" end
        0x6AF, 0x6AD: ret "g" end
        0x644: ret "l" end
        0x645: ret "m" end
        0x646, 0x6BA: ret "n" end
        0x6C0: ret "e" end
        0x6D2, 0x6D3: ret "y" end
    end
    if cp == 0x62B: ret fa ? "s" : "th" end
    if cp == 0x630: ret fa ? "z" : "dh" end
    if cp == 0x636: ret fa ? "z" : "d" end
    if cp == 0x642: ret fa ? "gh" : "q" end
    ret ""
end

func _arabic(b &: str.StringBuilder, lang: str, cps: Vector<int>, i: int): int:
    cp := cps.get(i)
    fa := lang != "ar"
    pv := _arab_adj(cps, i, -1)
    nx := _arab_adj(cps, i, 1)
    if cp == 0x627 and pv == 0 and (nx == 0x6CC or nx == 0x64A):
        mut j := i + 1
        until _is_mark(cps.get(j)):
            j++
        end
        after := _arab_adj(cps, j, 1)
        if not _arab_vowelish(after):
            str.BufAppend(b, "i")
            ret j - i + 1
        end
    end
    if cp == 0x648 and pv == 0 and nx == 0:
        str.BufAppend(b, fa ? "va" : "wa")
        ret 1
    end
    if cp == 0x648 or cp == 0x624:
        if cp == 0x624:
            str.BufAppend(b, "o")
        else not fa:
            str.BufAppend(b, "w")
        else pv == 0 or _arab_vowelish(nx):
            str.BufAppend(b, "v")
        else:
            str.BufAppend(b, "u")
        end
        ret 1
    end
    if cp == 0x6CC or cp == 0x64A or cp == 0x649:
        if cp == 0x649 and not fa:
            str.BufAppend(b, "a")
        else pv == 0 or _arab_vowelish(pv) or _arab_vowelish(nx):
            str.BufAppend(b, "y")
        else:
            str.BufAppend(b, "i")
        end
        ret 1
    end
    if cp == 0x639 and (nx == 0x627 or nx == 0x622): ret 1 end
    str.BufAppend(b, _arab_letter(cp, fa))
    ret 1
end
