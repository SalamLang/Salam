package slug

import str

func _kana_tab(cp: int): str:
    switch cp:
        0x3042, 0x30A2: ret "a" end
        0x3048, 0x3091, 0x30A8, 0x30F1: ret "e" end
        0x3044, 0x3090, 0x30A4, 0x30F0: ret "i" end
        0x3093, 0x30F3: ret "n" end
        0x304A, 0x3092, 0x30AA, 0x30F2: ret "o" end
        0x3046, 0x30A6: ret "u" end
        0x3070, 0x30D0: ret "ba" end
        0x3079, 0x30D9: ret "be" end
        0x3073, 0x30D3: ret "bi" end
        0x307C, 0x30DC: ret "bo" end
        0x3076, 0x30D6: ret "bu" end
        0x3060, 0x30C0: ret "da" end
        0x3067, 0x30C7: ret "de" end
        0x3069, 0x30C9: ret "do" end
        0x3075, 0x30D5: ret "fu" end
        0x304C, 0x30AC: ret "ga" end
        0x3052, 0x30B2: ret "ge" end
        0x304E, 0x30AE: ret "gi" end
        0x3054, 0x30B4: ret "go" end
        0x3050, 0x30B0: ret "gu" end
        0x306F, 0x30CF: ret "ha" end
        0x3078, 0x30D8: ret "he" end
        0x3072, 0x30D2: ret "hi" end
        0x307B, 0x30DB: ret "ho" end
        0x3058, 0x3062, 0x30B8, 0x30C2: ret "ji" end
        0x304B, 0x3095, 0x30AB, 0x30F5: ret "ka" end
        0x3051, 0x3096, 0x30B1, 0x30F6: ret "ke" end
        0x304D, 0x30AD: ret "ki" end
        0x3053, 0x30B3: ret "ko" end
        0x304F, 0x30AF: ret "ku" end
        0x307E, 0x30DE: ret "ma" end
        0x3081, 0x30E1: ret "me" end
        0x307F, 0x30DF: ret "mi" end
        0x3082, 0x30E2: ret "mo" end
        0x3080, 0x30E0: ret "mu" end
        0x306A, 0x30CA: ret "na" end
        0x306D, 0x30CD: ret "ne" end
        0x306B, 0x30CB: ret "ni" end
        0x306E, 0x30CE: ret "no" end
        0x306C, 0x30CC: ret "nu" end
        0x3071, 0x30D1: ret "pa" end
        0x307A, 0x30DA: ret "pe" end
        0x3074, 0x30D4: ret "pi" end
        0x307D, 0x30DD: ret "po" end
        0x3077, 0x30D7: ret "pu" end
        0x3089, 0x30E9: ret "ra" end
        0x308C, 0x30EC: ret "re" end
        0x308A, 0x30EA: ret "ri" end
        0x308D, 0x30ED: ret "ro" end
        0x308B, 0x30EB: ret "ru" end
        0x3055, 0x30B5: ret "sa" end
        0x305B, 0x30BB: ret "se" end
        0x305D, 0x30BD: ret "so" end
        0x3059, 0x30B9: ret "su" end
        0x305F, 0x30BF: ret "ta" end
        0x3066, 0x30C6: ret "te" end
        0x3068, 0x30C8: ret "to" end
        0x30F7: ret "va" end
        0x30F9: ret "ve" end
        0x30F8: ret "vi" end
        0x30FA: ret "vo" end
        0x3094, 0x30F4: ret "vu" end
        0x308F, 0x30EF: ret "wa" end
        0x3041, 0x30A1: ret "xa" end
        0x3047, 0x30A7: ret "xe" end
        0x3043, 0x30A3: ret "xi" end
        0x3049, 0x30A9: ret "xo" end
        0x3045, 0x30A5: ret "xu" end
        0x3084, 0x30E4: ret "ya" end
        0x3088, 0x30E8: ret "yo" end
        0x3086, 0x30E6: ret "yu" end
        0x3056, 0x30B6: ret "za" end
        0x305C, 0x30BC: ret "ze" end
        0x305E, 0x30BE: ret "zo" end
        0x305A, 0x3065, 0x30BA, 0x30C5: ret "zu" end
        0x3061, 0x30C1: ret "chi" end
        0x3057, 0x30B7: ret "shi" end
        0x3064, 0x30C4: ret "tsu" end
        0x308E, 0x30EE: ret "xwa" end
        0x3083, 0x30E3: ret "xya" end
        0x3087, 0x30E7: ret "xyo" end
        0x3085, 0x30E5: ret "xyu" end
        0x3063, 0x30C3: ret "xtsu" end
    end
    ret ""
end

func _hangul(b &: str.StringBuilder, cp: int):
    if cp < 0xAC00 or cp > 0xD7A3: ret end
    s := cp - 0xAC00
    l := s / 588
    v := (s % 588) / 28
    t := s % 28
    ini := ["g", "kk", "n", "d", "tt", "r", "m", "b", "pp", "s", "ss", "", "j", "jj", "ch", "k", "t", "p", "h"]
    vow := ["a", "ae", "ya", "yae", "eo", "e", "yeo", "ye", "o", "wa", "wae", "oe", "yo", "u", "wo", "we", "wi", "yu", "eu", "ui", "i"]
    fin := ["", "k", "kk", "k", "n", "n", "n", "t", "l", "k", "m", "l", "l", "l", "p", "l", "m", "p", "p", "t", "t", "ng", "t", "t", "k", "t", "p", "t"]
    str.BufAppend(b, ini[l])
    str.BufAppend(b, vow[v])
    str.BufAppend(b, fin[t])
end

func _kana_small_y(cp: int): bool:
    ret cp == 0x3083 or cp == 0x3085 or cp == 0x3087 or cp == 0x30E3 or cp == 0x30E5 or cp == 0x30E7
end

func _kana_small_v(cp: int): bool:
    ret cp == 0x3041 or cp == 0x3043 or cp == 0x3045 or cp == 0x3047 or cp == 0x3049 or cp == 0x30A1 or cp == 0x30A3 or cp == 0x30A5 or cp == 0x30A7 or cp == 0x30A9
end

func _kana_vowel(c: int): bool:
    ret c == 97 or c == 101 or c == 105 or c == 111 or c == 117
end

func _app_part(b &: str.StringBuilder, s: str, from: int, cnt: int):
    bp := s as u8*
    repeat cnt in k:
        str.BufAppendChar(b, bp[from + k] as int)
    end
end

func _kana(b &: str.StringBuilder, cps: Vector<int>, i: int): int:
    cp := cps.get(i)
    n := cps.len()
    r := _kana_tab(cp)
    if r.Len() == 0: ret 1 end
    rp := r as u8*
    rn := r.Len()
    if rp[0] == 120:
        if cp == 0x3063 or cp == 0x30C3:
            if i + 1 < n:
                t := _kana_tab(cps.get(i + 1))
                if t.Len() > 0:
                    f := (t as u8*)[0] as int
                    if not _kana_vowel(f) and f != 120 and f != 110:
                        if f == 99:
                            str.BufAppend(b, "t")
                        else:
                            str.BufAppendChar(b, f)
                        end
                    end
                end
            end
            ret 1
        end
        _app_part(b, r, 1, rn - 1)
        ret 1
    end
    if i + 1 < n:
        nx := cps.get(i + 1)
        if _kana_small_y(nx):
            y := _kana_tab(nx)
            vch := (y as u8*)[2] as int
            if r == "shi" or r == "chi" or r == "ji":
                _app_part(b, r, 0, rn - 1)
                str.BufAppendChar(b, vch)
            else rn == 2 and rp[1] == 105:
                str.BufAppendChar(b, rp[0] as int)
                str.BufAppend(b, "y")
                str.BufAppendChar(b, vch)
            else:
                str.BufAppend(b, r)
                str.BufAppend(b, "y")
                str.BufAppendChar(b, vch)
            end
            ret 2
        else _kana_small_v(nx):
            sv := _kana_tab(nx)
            vch := (sv as u8*)[1] as int
            if rn == 1 and rp[0] == 117:
                str.BufAppend(b, "w")
                str.BufAppendChar(b, vch)
            else _kana_vowel(rp[rn - 1] as int) and rn >= 2:
                _app_part(b, r, 0, rn - 1)
                str.BufAppendChar(b, vch)
            else:
                str.BufAppend(b, r)
                str.BufAppendChar(b, vch)
            end
            ret 2
        end
    end
    str.BufAppend(b, r)
    ret 1
end
