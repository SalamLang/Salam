package slug

import str

func _cased(b &: str.StringBuilder, s: str, up: bool, next_up: bool):
    if s.Len() == 0: ret end
    if not up:
        str.BufAppend(b, s)
        ret
    end
    bp := s as u8*
    n := s.Len()
    if next_up:
        repeat n in k:
            mut c := bp[k] as int
            if c >= 97 and c <= 122: c -= 32 end
            str.BufAppendChar(b, c)
        end
    else:
        repeat n in k:
            mut c := bp[k] as int
            if k == 0 and c >= 97 and c <= 122: c -= 32 end
            str.BufAppendChar(b, c)
        end
    end
end

func _cyr_lang(lo: int, lang: str, ws: bool): str:
    if lang == "uk":
        if not ws:
            switch lo:
                0x457: ret "i" end
                0x454: ret "ie" end
                0x44E: ret "iu" end
                0x44F: ret "ia" end
                0x439: ret "i" end
            end
        end
        switch lo:
            0x433: ret "h" end
            0x491: ret "g" end
            0x438: ret "y" end
            0x456: ret "i" end
            0x457: ret "yi" end
            0x454: ret "ye" end
            0x439: ret "y" end
            0x44F: ret "ya" end
        end
    end
    if lang == "bg":
        switch lo:
            0x449: ret "sht" end
            0x44A: ret "a" end
            0x445: ret "h" end
        end
    end
    if lang == "sr" or lang == "mk" or lang == "hr" or lang == "bs":
        switch lo:
            0x452: ret "dj" end
            0x458: ret "j" end
            0x459: ret "lj" end
            0x45A: ret "nj" end
            0x45B: ret "c" end
            0x447: ret "c" end
            0x448: ret "s" end
            0x436: ret "z" end
            0x45F: ret "dz" end
            0x445: ret "h" end
            0x446: ret "c" end
            0x453: ret "gj" end
            0x45C: ret "kj" end
            0x455: ret "dz" end
        end
    end
    if lang == "be":
        switch lo:
            0x433: ret "h" end
            0x45E: ret "u" end
            0x456: ret "i" end
        end
    end
    ret ""
end

func _cyr_tab(lo: int): str:
    switch lo:
        0x430: ret "a" end
        0x431: ret "b" end
        0x432: ret "v" end
        0x433, 0x491: ret "g" end
        0x434: ret "d" end
        0x435, 0x44D, 0x454: ret "e" end
        0x451: ret "yo" end
        0x436: ret "zh" end
        0x437: ret "z" end
        0x438, 0x456, 0x4E3: ret "i" end
        0x439, 0x44B, 0x458: ret "y" end
        0x43A: ret "k" end
        0x43B: ret "l" end
        0x43C: ret "m" end
        0x43D: ret "n" end
        0x43E: ret "o" end
        0x43F: ret "p" end
        0x440: ret "r" end
        0x441: ret "s" end
        0x442: ret "t" end
        0x443, 0x45E: ret "u" end
        0x444: ret "f" end
        0x445: ret "kh" end
        0x446: ret "ts" end
        0x447: ret "ch" end
        0x448: ret "sh" end
        0x449: ret "shch" end
        0x44E: ret "yu" end
        0x44F: ret "ya" end
        0x457: ret "yi" end
        0x452: ret "dj" end
        0x459: ret "lj" end
        0x45A: ret "nj" end
        0x45B: ret "c" end
        0x45F: ret "dz" end
        0x453: ret "gj" end
        0x45C: ret "kj" end
        0x455: ret "dz" end
        0x4D9: ret "a" end
        0x493: ret "gh" end
        0x49B: ret "q" end
        0x4A3: ret "n" end
        0x4AF, 0x4B1: ret "u" end
        0x4BB: ret "h" end
        0x4E9: ret "o" end
    end
    ret ""
end

func _cyrillic(b &: str.StringBuilder, lang: str, cps: Vector<int>, i: int):
    cp := cps.Get(i)
    lo := _fold(cp)
    up := lo != cp
    mut nup := false
    if i + 1 < cps.Len(): nup = _is_upper(cps.Get(i + 1)) and _script_of(cps.Get(i + 1)) == S_CYRILLIC end
    mut ws := true
    if i > 0 and _script_of(cps.Get(i - 1)) == S_CYRILLIC: ws = false end
    mut s := _cyr_lang(lo, lang, ws)
    if s.Len() == 0: s = _cyr_tab(lo) end
    _cased(b, s, up, nup)
end
