package slug

import str
import mem

func _sub(s: str, start: int, cnt: int): str:
    if cnt <= 0:
        ret str.Clone("")
    end
    r := mem.MustAllocateZeroed((cnt + 1) as u64)
    mem.Copy(r, (((s as void*) as i64) + (start as i64)) as void*, cnt as u64)
    ret r as str
end

func _free(s: str):
    mem.Free(s as void*)
end

func _lang_norm(lang: str): str:
    n := lang.Len()
    bp := lang as u8*
    mut b := str.NewBuilder()
    mut i := 0
    until i < n and bp[i] != 45 and bp[i] != 95:
        mut c := bp[i] as int
        if c >= 65 and c <= 90: c += 32 end
        str.BufAppendChar(b, c)
        i++
    end
    mut r := str.BufStr(b)
    str.BufFree(b)
    if r == "nb" or r == "nn":
        _free(r)
        r = str.Clone("no")
    else r == "fas" or r == "per":
        _free(r)
        r = str.Clone("fa")
    end
    ret r
end

func _auto_lang(cps: Vector<int>): str:
    dom := _dominant(cps)
    if dom == S_ARABIC:
        repeat cps.Len() in i:
            c := cps.Get(i)
            if c == 0x67E or c == 0x686 or c == 0x698 or c == 0x6AF or c == 0x6A9 or c == 0x6CC or
                (c >= 0x6F0 and c <= 0x6F9):
                ret "fa"
            end
        end
        repeat cps.Len() in i:
            c := cps.Get(i)
            if c == 0x629 or c == 0x649 or c == 0x64A or c == 0x643 or c == 0x623 or c == 0x625 or
                c == 0x671:
                ret "ar"
            end
        end
        ret "fa"
    end
    if dom == S_CYRILLIC:
        repeat cps.Len() in i:
            c := cps.Get(i)
            if c == 0x456 or c == 0x457 or c == 0x454 or c == 0x491 or c == 0x406 or c == 0x407 or
                c == 0x404 or c == 0x490:
                ret "uk"
            end
            if c == 0x452 or c == 0x45B or c == 0x459 or c == 0x45A or c == 0x45F or c == 0x402 or
                c == 0x40B:
                ret "sr"
            end
            if c == 0x45E: ret "be" end
        end
        ret "ru"
    end
    if dom == S_GREEK: ret "el" end
    if dom == S_HEBREW: ret "he" end
    if dom == S_DEVANAGARI: ret "hi" end
    ret ""
end

func _apply_repl(text: str, pairs: Vector<str>): str:
    n := text.Len()
    bp := text as u8*
    mut b := str.NewBuilder()
    mut i := 0
    until i < n:
        mut hit := false
        mut k := 0
        until k < pairs.Len() and not hit:
            f := pairs.Get(k)
            fl := f.Len()
            fp := f as u8*
            if fl > 0 and i + fl <= n and bp[i] == fp[0]:
                mut j := 1
                until j < fl and bp[i + j] == fp[j]:
                    j++
                end
                if j == fl:
                    str.BufAppend(b, pairs.Get(k + 1))
                    i += fl
                    hit = true
                end
            end
            k += 2
        end
        if not hit:
            str.BufAppendChar(b, bp[i] as int)
            i++
        end
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func _convert(text: str, o: Options, raw: bool): str:
    mut cps := Vector {} as Vector<int>
    defer cps.Free()
    if not raw and o.replacements.Len() > 0:
        src := _apply_repl(text, o.replacements)
        _decode(src, cps)
        _free(src)
    else:
        _decode(text, cps)
    end
    mut lang := _lang_norm(o.lang)
    if lang.Len() == 0:
        _free(lang)
        lang = str.Clone(_auto_lang(cps))
    end
    c := _Ctx {
        lang = lang,
        keep = o.keep_unicode and not raw,
        han = o.keep_han,
        lower = o.lowercase,
        allow = o.allow,
        sym = o.symbols,
        raw = raw
    }
    mut b := str.NewBuilder()
    mut i := 0
    until i < cps.Len():
        i += _step(b, c, cps, i)
    end
    mut r := str.BufStr(b)
    str.BufFree(b)
    _free(lang)
    if o.lowercase and not raw:
        rp := r as u8*
        repeat r.Len() in k:
            v := rp[k] as int
            if v >= 65 and v <= 90: rp[k] = (v + 32) as u8 end
        end
    end
    ret r
end

func _eq_ci(a: str, b: str): bool:
    n := a.Len()
    if n != b.Len(): ret false end
    ap := a as u8*
    bp := b as u8*
    repeat n in i:
        mut x := ap[i] as int
        mut y := bp[i] as int
        if x >= 65 and x <= 90: x += 32 end
        if y >= 65 and y <= 90: y += 32 end
        if x != y: ret false end
    end
    ret true
end

func _is_stop(w: str, stop: Vector<str>): bool:
    repeat stop.Len() in i:
        if _eq_ci(w, stop.Get(i)): ret true end
    end
    ret false
end

func _cplen(s: str): int:
    n := s.Len()
    bp := s as u8*
    mut cnt := 0
    repeat n in i:
        if ((bp[i] as int) & 0xC0) != 0x80: cnt++ end
    end
    ret cnt
end

func _cut_cp(s: str, maxcp: int): str:
    n := s.Len()
    bp := s as u8*
    mut cnt := 0
    mut i := 0
    until i < n:
        if ((bp[i] as int) & 0xC0) != 0x80:
            if cnt == maxcp: break end
            cnt++
        end
        i++
    end
    ret _sub(s, 0, i)
end

func _free_all(v: Vector<str>):
    repeat v.Len() in i:
        _free(v.Get(i))
    end
end

func _glue(a: str, w: str, allow: str): bool:
    if allow.Len() == 0: ret false end
    an := a.Len()
    if an > 0 and _has_allow(allow, (a as u8*)[an - 1] as int): ret true end
    if w.Len() > 0 and _has_allow(allow, (w as u8*)[0] as int): ret true end
    ret false
end

func _strip_edges(words &: Vector<str>, allow: str):
    until words.Len() > 0:
        w := words.Get(0)
        n := w.Len()
        bp := w as u8*
        mut k := 0
        until k < n and _has_allow(allow, bp[k] as int):
            k++
        end
        if k == 0: break end
        if k == n:
            words.RemoveAt(0)
        else:
            words.Set(0, _sub(w, k, n - k))
        end
        _free(w)
    end
    until words.Len() > 0:
        last := words.Len() - 1
        w := words.Get(last)
        n := w.Len()
        bp := w as u8*
        mut k := n
        until k > 0 and _has_allow(allow, bp[k - 1] as int):
            k--
        end
        if k == n: break end
        if k == 0:
            words.RemoveAt(last)
        else:
            words.Set(last, _sub(w, 0, k))
        end
        _free(w)
    end
end

func _finish(r: str, o: Options, stop: Vector<str>): str:
    n := r.Len()
    bp := r as u8*
    mut words := Vector {} as Vector<str>
    mut skipped := Vector {} as Vector<str>
    lead := n > 0 and
        bp[0] == 1
    trail := n > 0 and bp[n - 1] == 1
    sepn := _cplen(o.separator)
    mut total := 0
    mut early := false
    mut s := 0
    mut i := 0
    until i <= n and not early:
        if i == n or bp[i] == 1:
            if i > s or not o.collapse:
                w := _sub(r, s, i - s)
                if stop.Len() > 0 and i > s and _is_stop(w, stop):
                    skipped.Push(w)
                else:
                    words.Push(w)
                    total += _cplen(w) + sepn
                    if o.max_length > 0 and total > o.max_length + sepn + 1: early = true end
                end
            end
            s = i + 1
        end
        i++
    end
    if words.Len() == 0 and skipped.Len() > 0:
        words.Free()
        words = skipped
    else:
        _free_all(skipped)
        skipped.Free()
    end
    if o.trim and not early:
        if not o.collapse:
            until words.Len() > 0 and words.Get(0).Len() == 0:
                _free(words.Get(0))
                words.RemoveAt(0)
            end
            until words.Len() > 0 and words.Get(words.Len() - 1).Len() == 0:
                _free(words.Get(words.Len() - 1))
                words.RemoveAt(words.Len() - 1)
            end
        end
        if o.allow.Len() > 0: _strip_edges(words, o.allow) end
    end
    mut used := 0
    mut sum := 0
    mut hard := false
    until used < words.Len() and not hard:
        wl := _cplen(words.Get(used))
        mut add := wl
        if used > 0 and not _glue(words.Get(used - 1), words.Get(used), o.allow): add += sepn end
        if o.max_length > 0 and sum + add > o.max_length:
            if used == 0: hard = true end
            break
        end
        sum += add
        used++
    end
    mut b := str.NewBuilder()
    if lead and not o.trim and o.collapse: str.BufAppend(b, o.separator) end
    if hard:
        cut := _cut_cp(words.Get(0), o.max_length)
        str.BufAppend(b, cut)
        _free(cut)
    else:
        repeat used in k:
            if k > 0 and not _glue(words.Get(k - 1), words.Get(k), o.allow): str.BufAppend(b, o.separator) end
            str.BufAppend(b, words.Get(k))
        end
    end
    if trail and not o.trim and o.collapse: str.BufAppend(b, o.separator) end
    _free_all(words)
    words.Free()
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func _stop_list(o: Options): Vector<str>:
    mut stop := Vector {} as Vector<str>
    repeat o.stop_words.Len() in i:
        r := _convert(o.stop_words.Get(i), o, false)
        n := r.Len()
        bp := r as u8*
        mut s := 0
        mut k := 0
        until k <= n:
            if k == n or bp[k] == 1:
                if k > s: stop.Push(_sub(r, s, k - s)) end
                s = k + 1
            end
            k++
        end
        _free(r)
    end
    ret stop
end

func _post(slug: str, o: Options): str:
    mut s := slug
    if o.identifier and s.Len() > 0:
        c := (s as u8*)[0] as int
        if c >= 48 and c <= 57:
            mut b := str.NewBuilder()
            str.BufAppend(b, "_")
            str.BufAppend(b, s)
            _free(s)
            s = str.BufStr(b)
            str.BufFree(b)
        end
    end
    if s.Len() == 0:
        _free(s)
        ret str.Clone(o.fallback)
    end
    ret s
end
