package slug

import str

func _gbase(cp: int): int:
    switch cp:
        0x386, 0x391, 0x3AC, 0x3B1, 0x1F00 to 0x1F0F, 0x1F70, 0x1F71, 0x1F80 to 0x1F87, 0x1FB0 to 0x1FB4, 0x1FB6 to 0x1FBB: ret 0x3B1 end
        0x392, 0x3B2: ret 0x3B2 end
        0x393, 0x3B3: ret 0x3B3 end
        0x394, 0x3B4: ret 0x3B4 end
        0x388, 0x395, 0x3AD, 0x3B5, 0x1F10 to 0x1F15, 0x1F18 to 0x1F1D, 0x1F72, 0x1F73, 0x1FC8, 0x1FC9: ret 0x3B5 end
        0x396, 0x3B6: ret 0x3B6 end
        0x389, 0x397, 0x3AE, 0x3B7, 0x1F20 to 0x1F2F, 0x1F74, 0x1F75, 0x1F90 to 0x1F97, 0x1FC2 to 0x1FC4, 0x1FC6, 0x1FC7, 0x1FCA, 0x1FCB: ret 0x3B7 end
        0x398, 0x3B8: ret 0x3B8 end
        0x38A, 0x390, 0x399, 0x3AA, 0x3AF, 0x3B9, 0x3CA, 0x1F30 to 0x1F3F, 0x1F76, 0x1F77, 0x1FBE, 0x1FD0 to 0x1FD3, 0x1FD6 to 0x1FDB: ret 0x3B9 end
        0x39A, 0x3BA: ret 0x3BA end
        0x39B, 0x3BB: ret 0x3BB end
        0x39C, 0x3BC: ret 0x3BC end
        0x39D, 0x3BD: ret 0x3BD end
        0x39E, 0x3BE: ret 0x3BE end
        0x38C, 0x39F, 0x3BF, 0x3CC, 0x1F40 to 0x1F45, 0x1F48 to 0x1F4D, 0x1F78, 0x1F79, 0x1FF8, 0x1FF9: ret 0x3BF end
        0x3A0, 0x3C0: ret 0x3C0 end
        0x3A1, 0x3C1, 0x1FE4, 0x1FE5, 0x1FEC: ret 0x3C1 end
        0x3A3, 0x3C2, 0x3C3: ret 0x3C3 end
        0x3A4, 0x3C4: ret 0x3C4 end
        0x38E, 0x3A5, 0x3AB, 0x3B0, 0x3C5, 0x3CB, 0x3CD, 0x1F50 to 0x1F57, 0x1F59, 0x1F5B, 0x1F5D, 0x1F5F, 0x1F7A, 0x1F7B, 0x1FE0 to 0x1FE3, 0x1FE6 to 0x1FEB: ret 0x3C5 end
        0x3A6, 0x3C6: ret 0x3C6 end
        0x3A7, 0x3C7: ret 0x3C7 end
        0x3A8, 0x3C8: ret 0x3C8 end
        0x38F, 0x3A9, 0x3C9, 0x3CE, 0x1F60 to 0x1F6F, 0x1F7C, 0x1F7D, 0x1FA0 to 0x1FA7, 0x1FF2 to 0x1FF4, 0x1FF6, 0x1FF7, 0x1FFA, 0x1FFB: ret 0x3C9 end
    end
    ret 0
end

func _gupper(cp: int): bool:
    switch cp:
        0x386, 0x388 to 0x38A, 0x38C, 0x38E, 0x38F, 0x391 to 0x3A1, 0x3A3 to 0x3AB, 0x1F08 to 0x1F0F, 0x1F18 to 0x1F1D, 0x1F28 to 0x1F2F, 0x1F38 to 0x1F3F, 0x1F48 to 0x1F4D, 0x1F59, 0x1F5B, 0x1F5D, 0x1F5F, 0x1F68 to 0x1F6F, 0x1FB8 to 0x1FBB, 0x1FC8 to 0x1FCB, 0x1FD8 to 0x1FDB, 0x1FE8 to 0x1FEC, 0x1FF8 to 0x1FFB: ret true end
    end
    ret false
end

func _greek_letter(g: int): str:
    switch g:
        0x3B1: ret "a" end
        0x3B2: ret "v" end
        0x3B3: ret "g" end
        0x3B4: ret "d" end
        0x3B5: ret "e" end
        0x3B6: ret "z" end
        0x3B7: ret "i" end
        0x3B8: ret "th" end
        0x3B9: ret "i" end
        0x3BA: ret "k" end
        0x3BB: ret "l" end
        0x3BC: ret "m" end
        0x3BD: ret "n" end
        0x3BE: ret "x" end
        0x3BF: ret "o" end
        0x3C0: ret "p" end
        0x3C1: ret "r" end
        0x3C3: ret "s" end
        0x3C4: ret "t" end
        0x3C5: ret "y" end
        0x3C6: ret "f" end
        0x3C7: ret "ch" end
        0x3C8: ret "ps" end
        0x3C9: ret "o" end
    end
    ret ""
end

func _greek_voiced(g: int): bool:
    switch g:
        0x3B1, 0x3B5, 0x3B7, 0x3B9, 0x3BF, 0x3C5, 0x3C9, 0x3B2, 0x3B3, 0x3B4, 0x3B6, 0x3BB, 0x3BC, 0x3BD, 0x3C1: ret true end
    end
    ret false
end

func _greek(b &: str.StringBuilder, cps: Vector<int>, i: int): int:
    cp := cps.get(i)
    g := _gbase(cp)
    if g == 0: ret 1 end
    up := _gupper(cp)
    n := cps.len()
    mut g2 := 0
    mut plain2 := false
    if i + 1 < n:
        c2 := cps.get(i + 1)
        g2 = _gbase(c2)
        plain2 = c2 != 0x3CA and c2 != 0x3CB and c2 != 0x3AA and c2 != 0x3AB and c2 != 0x390 and c2 != 0x3B0
    end
    mut word_start := true
    if i > 0 and _gbase(cps.get(i - 1)) != 0: word_start = false end
    nup := g2 != 0 and _gupper(cps.get(i + 1))
    mut out := ""
    mut used := 1
    if g == 0x3BF and g2 == 0x3C5 and plain2:
        out = "ou"
        used = 2
    else g == 0x3B3 and g2 == 0x3B3:
        out = "ng"
        used = 2
    else g == 0x3B3 and g2 == 0x3BA:
        out = word_start ? "g" : "nk"
        used = 2
    else g == 0x3B3 and g2 == 0x3C7:
        out = "nch"
        used = 2
    else g == 0x3BC and g2 == 0x3C0:
        out = word_start ? "b" : "mp"
        used = 2
    else g == 0x3BD and g2 == 0x3C4:
        out = word_start ? "d" : "nt"
        used = 2
    else (g == 0x3B1 or g == 0x3B5) and g2 == 0x3C5 and plain2:
        mut after := 0
        if i + 2 < n: after = _gbase(cps.get(i + 2)) end
        voiced := after == 0 or _greek_voiced(after)
        if g == 0x3B1:
            out = voiced ? "av" : "af"
        else:
            out = voiced ? "ev" : "ef"
        end
        used = 2
    else:
        out = _greek_letter(g)
    end
    _cased(b, out, up, nup)
    ret used
end
