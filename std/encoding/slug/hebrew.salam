package slug

import str

func _hebrew_letter(cp: int): str:
    switch cp:
        0x5D0, 0x5E2: ret "a" end
        0x5D1: ret "b" end
        0x5D2: ret "g" end
        0x5D3: ret "d" end
        0x5D4: ret "h" end
        0x5D5: ret "v" end
        0x5D6: ret "z" end
        0x5D7: ret "kh" end
        0x5D8, 0x5EA: ret "t" end
        0x5D9: ret "y" end
        0x5DB, 0x5DA, 0x5E7: ret "k" end
        0x5DC: ret "l" end
        0x5DE, 0x5DD: ret "m" end
        0x5E0, 0x5DF: ret "n" end
        0x5E1: ret "s" end
        0x5E4: ret "p" end
        0x5E3: ret "f" end
        0x5E6, 0x5E5: ret "ts" end
        0x5E8: ret "r" end
        0x5E9: ret "sh" end
    end
    ret ""
end

func _hebrew(b &: str.StringBuilder, cp: int):
    str.BufAppend(b, _hebrew_letter(cp))
end
