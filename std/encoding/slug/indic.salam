package slug

import str

func _deva_vowel(cp: int): str:
    switch cp:
        0x905, 0x906: ret "a" end
        0x907, 0x908: ret "i" end
        0x909, 0x90A: ret "u" end
        0x90B: ret "ri" end
        0x90F, 0x90D, 0x90E: ret "e" end
        0x910: ret "ai" end
        0x913, 0x911, 0x912: ret "o" end
        0x914: ret "au" end
    end
    ret ""
end

func _deva_cons(cp: int): str:
    switch cp:
        0x915: ret "k" end
        0x916: ret "kh" end
        0x917: ret "g" end
        0x918: ret "gh" end
        0x919, 0x91E, 0x923, 0x928, 0x929: ret "n" end
        0x91A: ret "ch" end
        0x91B: ret "chh" end
        0x91C: ret "j" end
        0x91D: ret "jh" end
        0x91F, 0x924: ret "t" end
        0x920, 0x925: ret "th" end
        0x921, 0x926: ret "d" end
        0x922, 0x927: ret "dh" end
        0x92A: ret "p" end
        0x92B: ret "ph" end
        0x92C: ret "b" end
        0x92D: ret "bh" end
        0x92E: ret "m" end
        0x92F: ret "y" end
        0x930, 0x931: ret "r" end
        0x932, 0x933: ret "l" end
        0x935: ret "v" end
        0x936, 0x937: ret "sh" end
        0x938: ret "s" end
        0x939: ret "h" end
        0x958: ret "q" end
        0x959: ret "kh" end
        0x95A: ret "gh" end
        0x95B: ret "z" end
        0x95C: ret "r" end
        0x95D: ret "rh" end
        0x95E: ret "f" end
        0x95F: ret "y" end
    end
    ret ""
end

func _deva_matra(cp: int): str:
    switch cp:
        0x93E: ret "a" end
        0x93F, 0x940: ret "i" end
        0x941, 0x942: ret "u" end
        0x943: ret "ri" end
        0x945, 0x946, 0x947: ret "e" end
        0x948: ret "ai" end
        0x949, 0x94A, 0x94B: ret "o" end
        0x94C: ret "au" end
        0x901, 0x902: ret "n" end
        0x903: ret "h" end
    end
    ret ""
end

func _deva_is_cons(cp: int): bool:
    ret (cp >= 0x915 and cp <= 0x939) or (cp >= 0x958 and cp <= 0x95F)
end

func _devanagari(b &: str.StringBuilder, cps: Vector<int>, i: int):
    cp := cps.Get(i)
    if _deva_is_cons(cp):
        str.BufAppend(b, _deva_cons(cp))
        n := cps.Len()
        mut k := i + 1
        if k < n and cps.Get(k) == 0x93C: k++ end
        if k >= n: ret end
        nx := cps.Get(k)
        if nx == 0x94D or (nx >= 0x93E and nx <= 0x94C): ret end
        if (nx >= 0x901 and nx <= 0x903) or _deva_is_cons(nx) or (nx >= 0x904 and nx <= 0x914):
            str.BufAppend(b, "a")
        end
        ret
    end
    if cp >= 0x904 and cp <= 0x914:
        str.BufAppend(b, _deva_vowel(cp))
        ret
    end
    str.BufAppend(b, _deva_matra(cp))
end

func _thai_cons(cp: int): str:
    switch cp:
        0xE01: ret "k" end
        0xE02, 0xE03, 0xE04, 0xE05, 0xE06: ret "kh" end
        0xE07: ret "ng" end
        0xE08, 0xE09, 0xE0A, 0xE0C: ret "ch" end
        0xE0B, 0xE28, 0xE29, 0xE2A: ret "s" end
        0xE0D, 0xE22: ret "y" end
        0xE0E, 0xE14: ret "d" end
        0xE0F, 0xE15: ret "t" end
        0xE10, 0xE11, 0xE12, 0xE16, 0xE17, 0xE18: ret "th" end
        0xE13, 0xE19: ret "n" end
        0xE1A: ret "b" end
        0xE1B: ret "p" end
        0xE1C, 0xE1E, 0xE20: ret "ph" end
        0xE1D, 0xE1F: ret "f" end
        0xE21: ret "m" end
        0xE23: ret "r" end
        0xE25, 0xE2C: ret "l" end
        0xE27: ret "w" end
        0xE2B, 0xE2E: ret "h" end
    end
    ret ""
end

func _thai_vowel(cp: int): str:
    switch cp:
        0xE30, 0xE31, 0xE32, 0xE45: ret "a" end
        0xE33: ret "am" end
        0xE34, 0xE35: ret "i" end
        0xE36, 0xE37: ret "ue" end
        0xE38, 0xE39: ret "u" end
        0xE40: ret "e" end
        0xE41: ret "ae" end
        0xE42: ret "o" end
        0xE43, 0xE44: ret "ai" end
        0xE24: ret "rue" end
        0xE26: ret "lue" end
    end
    ret ""
end

func _thai(b &: str.StringBuilder, cps: Vector<int>, i: int): int:
    cp := cps.Get(i)
    if cp >= 0xE40 and cp <= 0xE44 and i + 1 < cps.Len():
        nx := cps.Get(i + 1)
        if _thai_cons(nx).Len() > 0 or nx == 0xE2D:
            str.BufAppend(b, _thai_cons(nx))
            str.BufAppend(b, _thai_vowel(cp))
            ret 2
        end
    end
    c := _thai_cons(cp)
    if c.Len() > 0:
        str.BufAppend(b, c)
        ret 1
    end
    str.BufAppend(b, _thai_vowel(cp))
    ret 1
end
