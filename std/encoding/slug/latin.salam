func _latin_lang(b &: str.StringBuilder, lang: str, cp: int): bool:
    if lang == "de":
        switch cp:
            0xE4: str.BufAppend(b, "ae") ret true end
            0xC4: str.BufAppend(b, "Ae") ret true end
            0xF6: str.BufAppend(b, "oe") ret true end
            0xD6: str.BufAppend(b, "Oe") ret true end
            0xFC: str.BufAppend(b, "ue") ret true end
            0xDC: str.BufAppend(b, "Ue") ret true end
        end
    end
    if lang == "da" or lang == "no":
        switch cp:
            0xE5: str.BufAppend(b, "aa") ret true end
            0xC5: str.BufAppend(b, "Aa") ret true end
            0xF8: str.BufAppend(b, "oe") ret true end
            0xD8: str.BufAppend(b, "Oe") ret true end
        end
    end
    ret false
end
