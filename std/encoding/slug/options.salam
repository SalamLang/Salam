package slug

import str
import mem

@en "Options"
@fa "گزینه ها"
pub struct Options:
    pub separator: str = "-"
    pub lowercase: bool = true
    pub max_length: int = 0
    pub lang: str = ""
    pub keep_unicode: bool = false
    pub keep_han: bool = true
    pub stop_words: Vector<str> = Vector {}
    pub replacements: Vector<str> = Vector {}
    pub trim: bool = true
    pub collapse: bool = true
    pub allow: str = ""
    pub symbols: bool = true
    pub identifier: bool = false
    pub fallback: str = ""
end

@en "DefaultOptions"
@fa "گزینه های پیش فرض"
pub func DefaultOptions(): Options:
    ret Options {}
end

@en "URL"
@fa "آدرس وب"
pub func URL(): Options:
    ret Options { max_length = 100 }
end

@en "Filename"
@fa "نام پرونده"
pub func Filename(): Options:
    ret Options { separator = "_", lowercase = false, allow = ".-", max_length = 200, fallback = "file" }
end

@en "Snake"
@fa "اسنیک"
pub func Snake(): Options:
    ret Options { separator = "_" }
end

@en "Identifier"
@fa "شناسه"
pub func Identifier(): Options:
    ret Options { separator = "_", identifier = true, fallback = "_" }
end

@en "Unicode"
@fa "یونیکد"
pub func Unicode(): Options:
    ret Options { keep_unicode = true }
end

@en "AddStopWords"
@fa "افزودن کلمه های توقف"
pub func AddStopWords(o &: Options, words: str):
    n := words.Len()
    bp := words as u8*
    mut b := str.NewBuilder()
    repeat n in i:
        c := bp[i] as int
        if c == 32 or c == 44 or c == 10 or c == 9:
            if str.BufLen(b) > 0:
                o.stop_words.push(str.BufStr(b))
                str.BufReset(b)
            end
        else:
            str.BufAppendChar(b, c)
        end
    end
    if str.BufLen(b) > 0: o.stop_words.push(str.BufStr(b)) end
    str.BufFree(b)
end

@en "AddReplacement"
@fa "افزودن جایگزین"
pub func AddReplacement(o &: Options, pattern: str, value: str):
    if pattern.Len() == 0: ret end
    o.replacements.push(str.Clone(pattern))
    o.replacements.push(str.Clone(value))
end

@en "FreeOptions"
@fa "آزادسازی گزینه ها"
pub func FreeOptions(o &: Options):
    repeat o.stop_words.len() in i:
        mem.Free(o.stop_words.get(i) as void*)
    end
    repeat o.replacements.len() in i:
        mem.Free(o.replacements.get(i) as void*)
    end
    o.stop_words.free()
    o.replacements.free()
end
