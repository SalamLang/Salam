@en "slug"
@fa "اسلاگ"
package slug

import str

func _utf8_at(bp: u8*, i: int, w: int): int:
    mut cp := (bp[i] as int) & (0xFF >> (w + 1))
    repeat 1 to w - 1 in k:
        cp = (cp << 6) | ((bp[i + k] as int) & 0x3F)
    end
    ret cp
end

func _valid_char(cp: int, o: Options): bool:
    if cp < 0x80:
        if cp >= 48 and cp <= 57: ret true end
        if cp >= 97 and cp <= 122: ret true end
        if cp >= 65 and cp <= 90: ret not o.lowercase end
        ret _has_allow(o.allow, cp)
    end
    if not o.keep_unicode:
        ret o.keep_han and _script_of(cp) == S_HAN
    end
    if _is_comb(cp): ret true end
    if _script_of(cp) == S_NONE: ret false end
    if o.lowercase and _is_upper(cp): ret false end
    ret true
end

@en "MakeWith"
@fa "ساخت با گزینه"
pub func MakeWith(text: str, o: Options): str:
    stop := _stop_list(o)
    r := _convert(text, o, false)
    s := _finish(r, o, stop)
    _free(r)
    _free_all(stop)
    stop.free()
    ret _post(s, o)
end

@en "Make"
@fa "ساخت"
pub func Make(text: str): str:
    ret MakeWith(text, DefaultOptions())
end

@en "Transliterate"
@fa "نویسه گردانی"
pub func Transliterate(text: str, lang: str): str:
    o := Options { lang = lang }
    ret _convert(text, o, true)
end

@en "Numbered"
@fa "شماره دار"
pub func Numbered(slug: str, n: int, separator: str): str:
    if n <= 1: ret str.Clone(slug) end
    mut b := str.NewBuilder()
    str.BufAppend(b, slug)
    str.BufAppend(b, separator)
    str.BufAppendInt(b, n as i64)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

@en "UniqueWith"
@fa "یکتا با جداکننده"
pub func UniqueWith(slug: str, separator: str, exists: func (str) bool): str:
    if not exists(slug): ret str.Clone(slug) end
    mut n := 2
    until n < 10000:
        cand := Numbered(slug, n, separator)
        if not exists(cand): ret cand end
        _free(cand)
        n++
    end
    ret Numbered(slug, n, separator)
end

@en "Unique"
@fa "یکتا"
pub func Unique(slug: str, exists: func (str) bool): str:
    ret UniqueWith(slug, "-", exists)
end

@en "IsSlugWith"
@fa "اسلاگ است با گزینه"
pub func IsSlugWith(s: str, o: Options): bool:
    n := s.Len()
    if n == 0: ret false end
    if o.max_length > 0 and _cplen(s) > o.max_length: ret false end
    sep := o.separator
    sl := sep.Len()
    bp := s as u8*
    sp := sep as u8*
    mut i := 0
    mut prev_sep := false
    until i < n:
        mut is_sep := false
        if sl > 0 and i + sl <= n:
            mut j := 0
            until j < sl and bp[i + j] == sp[j]:
                j++
            end
            is_sep = j == sl
        end
        if is_sep:
            if prev_sep and o.collapse: ret false end
            if i == 0 and o.trim: ret false end
            prev_sep = true
            i += sl
        else:
            c := bp[i] as int
            mut w := 1
            if c >= 0xF0:
                w = 4
            else c >= 0xE0:
                w = 3
            else c >= 0xC0:
                w = 2
            end
            mut cp := c
            if w > 1:
                if i + w > n: ret false end
                cp = _utf8_at(bp, i, w)
            end
            if not _valid_char(cp, o): ret false end
            prev_sep = false
            i += w
        end
    end
    if prev_sep and o.trim: ret false end
    if o.identifier:
        c0 := bp[0] as int
        if c0 >= 48 and c0 <= 57: ret false end
    end
    ret true
end

@en "IsSlug"
@fa "اسلاگ است"
pub func IsSlug(s: str): bool:
    ret IsSlugWith(s, DefaultOptions())
end
