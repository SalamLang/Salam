package slug

import str

struct _Ctx:
    pub lang: str = ""
    pub keep: bool = false
    pub han: bool = true
    pub lower: bool = true
    pub allow: str = ""
    pub sym: bool = true
    pub raw: bool = false
end

func _bound(b &: str.StringBuilder, c: _Ctx):
    if c.raw:
        str.BufAppendChar(b, 32)
    else:
        str.BufAppendChar(b, 1)
    end
end

func _word(b &: str.StringBuilder, c: _Ctx, w: str):
    _bound(b, c)
    str.BufAppend(b, w)
    _bound(b, c)
end

func _and_word(lang: str): str:
    if lang == "de": ret "und" end
    if lang == "fr": ret "et" end
    if lang == "es": ret "y" end
    if lang == "it" or lang == "pt": ret "e" end
    if lang == "nl": ret "en" end
    if lang == "sv": ret "och" end
    if lang == "da" or lang == "no": ret "og" end
    if lang == "fi": ret "ja" end
    if lang == "pl" or lang == "ru" or lang == "uk" or lang == "bg" or lang == "sr": ret "i" end
    if lang == "cs": ret "a" end
    if lang == "tr": ret "ve" end
    if lang == "el": ret "kai" end
    if lang == "fa": ret "va" end
    if lang == "ar": ret "wa" end
    if lang == "he": ret "ve" end
    if lang == "hi": ret "aur" end
    ret "and"
end

func _percent_word(lang: str): str:
    if lang == "de": ret "prozent" end
    if lang == "fr": ret "pourcent" end
    if lang == "es": ret "porciento" end
    if lang == "it": ret "percento" end
    if lang == "pt": ret "porcento" end
    if lang == "nl" or lang == "pl" or lang == "cs": ret "procent" end
    if lang == "ru": ret "protsent" end
    if lang == "uk": ret "vidsotok" end
    if lang == "tr": ret "yuzde" end
    if lang == "fa": ret "darsad" end
    ret "percent"
end

func _has_allow(allow: str, cp: int): bool:
    n := allow.Len()
    if n == 0: ret false end
    bp := allow as u8*
    repeat n in k:
        if (bp[k] as int) == cp: ret true end
    end
    ret false
end

func _space(cp: int): bool:
    if cp == 0xA0 or cp == 0x1680 or cp == 0x202F or cp == 0x205F or cp == 0x3000: ret true end
    ret (cp >= 0x2000 and cp <= 0x200A) or cp == 0x2028 or cp == 0x2029
end

func _ascii(b &: str.StringBuilder, c: _Ctx, cp: int):
    if (cp >= 48 and cp <= 57) or (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122):
        str.BufAppendChar(b, cp)
        ret
    end
    if c.raw:
        str.BufAppendChar(b, cp)
        ret
    end
    if _has_allow(c.allow, cp):
        str.BufAppendChar(b, cp)
        ret
    end
    if cp == 39 or cp == 96: ret end
    if c.sym:
        if cp == 38:
            _word(b, c, _and_word(c.lang))
            ret
        else cp == 64:
            _word(b, c, "at")
            ret
        else cp == 37:
            _word(b, c, _percent_word(c.lang))
            ret
        else cp == 43:
            _word(b, c, "plus")
            ret
        else cp == 36:
            _word(b, c, "dollar")
            ret
        end
    end
    _bound(b, c)
end

func _symbol(b &: str.StringBuilder, c: _Ctx, cp: int): bool:
    mut w := ""
    switch cp:
        0x20AC: w = "euro" break end
        0xA3: w = "pound" break end
        0xA5: w = "yen" break end
        0x20B9: w = "rupee" break end
        0x20BD: w = "ruble" break end
        0x20BA: w = "lira" break end
        0x20A9: w = "won" break end
        0x20AA: w = "shekel" break end
        0x20AB: w = "dong" break end
        0x20BF: w = "bitcoin" break end
        0xA2: w = "cent" break end
        0x66A: w = _percent_word(c.lang) break end
    end
    if w.Len() == 0: ret false end
    _word(b, c, w)
    ret true
end

func _punct_raw(b &: str.StringBuilder, cp: int): bool:
    switch cp:
        0x60C, 0x66C: str.BufAppend(b, ",") ret true end
        0x61B: str.BufAppend(b, ";") ret true end
        0x61F: str.BufAppend(b, "?") ret true end
        0x66B: str.BufAppend(b, ".") ret true end
        0x66A: str.BufAppend(b, "%") ret true end
        0xAB, 0xBB, 0x201C, 0x201D, 0x201E: str.BufAppend(b, "\"") ret true end
        0x2013, 0x2014, 0x2212: str.BufAppend(b, "-") ret true end
        0x2026: str.BufAppend(b, "...") ret true end
        0x3001: str.BufAppend(b, ",") ret true end
        0x3002: str.BufAppend(b, ".") ret true end
    end
    ret false
end

func _keep(b &: str.StringBuilder, c: _Ctx, cp: int):
    mut x := cp
    if x >= 0xFF21 and x <= 0xFF3A:
        x = x - 0xFF21 + 65
    else x >= 0xFF41 and x <= 0xFF5A:
        x = x - 0xFF41 + 97
    end
    if x == 0x64A or x == 0x649: x = 0x6CC end
    if x == 0x643: x = 0x6A9 end
    if c.lower: x = _fold(x) end
    str.BufAppendCp(b, x)
end

func _step(b &: str.StringBuilder, c: _Ctx, cps: Vector<int>, i: int): int:
    cp := cps.Get(i)
    if cp < 0x80:
        _ascii(b, c, cp)
        ret 1
    end
    if cp == 0x200C or cp == 0x200B or _space(cp):
        _bound(b, c)
        ret 1
    end
    d := _digit(cp)
    if d >= 0:
        str.BufAppendChar(b, 48 + d)
        ret 1
    end
    if _is_mark(cp): ret 1 end
    s := _script_of(cp)
    if s == S_NONE:
        if _is_comb(cp):
            if c.keep: str.BufAppendCp(b, cp) end
            ret 1
        end
        if cp == 0x2019 or cp == 0x2018 or cp == 0x2BC or cp == 0xB4:
            if c.raw: str.BufAppend(b, "'") end
            ret 1
        end
        if c.sym and not c.raw and _symbol(b, c, cp): ret 1 end
        if c.raw and _punct_raw(b, cp): ret 1 end
        _bound(b, c)
        ret 1
    end
    if c.keep:
        _keep(b, c, cp)
        ret 1
    end
    if s == S_LATIN:
        if not _latin_lang(b, c.lang, cp):
            _r := _latin_tab(b, cp)
        end
    else s == S_CYRILLIC:
        _cyrillic(b, c.lang, cps, i)
    else s == S_GREEK:
        ret _greek(b, cps, i)
    else s == S_ARABIC:
        ret _arabic(b, c.lang, cps, i)
    else s == S_HEBREW:
        _hebrew(b, cp)
    else s == S_DEVANAGARI:
        _devanagari(b, cps, i)
    else s == S_THAI:
        ret _thai(b, cps, i)
    else s == S_KANA:
        ret _kana(b, cps, i)
    else s == S_HANGUL:
        _hangul(b, cp)
    else s == S_HAN:
        if c.han: str.BufAppendCp(b, cp) end
    end
    ret 1
end
