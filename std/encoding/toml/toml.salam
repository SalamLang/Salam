@en "toml"
@fa "تامل"
package toml

import encoding.value
import str
import conv
import mem

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

func _tsub(s: str, start: int, cnt: int): str:
    bp := _bp(s)
    mut sb := str.NewBuilder()
    mut k := 0
    until k < cnt:
        str.BufAppendChar(sb, bp[start + k] as int)
        k++
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

func _fail(err &: Error, kind: ErrorKind, message: str, at: int, code: str):
    if err.message != "": ret end
    err = Error.At(kind, message, at).with_code(code)
end

func _is_digit(c: int): bool: ret c >= 48 and c <= 57 end

func _is_bare_key_char(c: int): bool:
    ret _is_digit(c) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95
end

func _skip_inline_ws(s: str, n: int, i: int): int:
    bp := _bp(s)
    mut p := i
    until p < n:
        c := _ub(bp, p)
        if c != 32 and c != 9: ret p end
        p++
    end
    ret p
end

func _skip_loose(s: str, n: int, i: int): int:
    bp := _bp(s)
    mut p := i
    until p < n:
        c := _ub(bp, p)
        if c == 32 or c == 9 or c == 10 or c == 13:
            p++
        else c == 35:
            until p < n and _ub(bp, p) != 10:
                p++
            end
        else:
            ret p
        end
    end
    ret p
end

func _end_of_line(s: str, n: int, i: int, what: str, err &: Error): bool:
    p := _skip_inline_ws(s, n, i)
    if p >= n: ret true end
    c := _ub(_bp(s), p)
    if c == 10 or c == 13 or c == 35: ret true end
    _fail(err, ErrorKind.Syntax, "expected the end of the line after " + what, p, "toml.expected_newline")
    ret false
end

func _digit_val(c: int): int:
    if c >= 48 and c <= 57: ret c - 48 end
    if c >= 97 and c <= 102: ret c - 97 + 10 end
    if c >= 65 and c <= 70: ret c - 65 + 10 end
    ret 0 - 1
end

func _hexn(s: str, n: int, i: int, cnt: int): int:
    if i + cnt > n: ret 0 - 1 end
    bp := _bp(s)
    mut out := 0
    repeat cnt in k:
        d := _digit_val(_ub(bp, i + k))
        if d < 0: ret 0 - 1 end
        if out <= 0x10FFFF: out = out * 16 + d end
    end
    ret out
end

func _parse_int_base(s: str, first: int, base: int, neg: bool, fits &: bool): i64:
    fits = true
    n := s.Len()
    bp := _bp(s)
    mut limit := 9223372036854775807 as u64
    if neg: limit = 9223372036854775808 as u64 end
    mut acc := 0 as u64
    mut i := first
    until i < n:
        d := _digit_val(_ub(bp, i))
        if d >= 0 and d < base:
            if acc > (limit - (d as u64)) / (base as u64):
                fits = false
                ret 0
            end
            acc = acc * (base as u64) + (d as u64)
        end
        i++
    end
    if neg: ret (0 as u64 - acc) as i64 end
    ret acc as i64
end

func _bits_to_f64(bits: i64): f64:
    buf := mem.Allocate(8 as u64)
    p := buf as i64*
    p[0] = bits
    q := buf as f64*
    v := q[0]
    mem.Free(buf)
    ret v
end

func _pos_inf(): f64: ret _bits_to_f64((0x7FF0000000000000 as u64) as i64) end
func _neg_inf(): f64: ret _bits_to_f64((0xFFF0000000000000 as u64) as i64) end
func _nan_val(): f64: ret _bits_to_f64((0x7FF8000000000000 as u64) as i64) end

func _unterminated(err &: Error, n: int, start: int, stop: int):
    if stop >= n:
        _fail(err, ErrorKind.UnexpectedEnd, "the string is not closed", start, "toml.unterminated_string")
    else:
        _fail(err, ErrorKind.Syntax, "the string is not closed before the end of the line", start, "toml.unterminated_string")
    end
end

func _skip_toml_newline(bp: i8*, n: int, p: int): int:
    if p >= n: ret p end
    c := _ub(bp, p)
    if c == 10: ret p + 1 end
    if c == 13 and p + 1 < n and _ub(bp, p + 1) == 10: ret p + 2 end
    ret p
end

func _skip_toml_ws_nl(bp: i8*, n: int, p: int): int:
    mut q := p
    until q < n:
        c := _ub(bp, q)
        if c != 32 and c != 9 and c != 10 and c != 13: break end
        q++
    end
    ret q
end

func _append_basic_escape(s: str, n: int, p: int, sb &: str.StringBuilder, err &: Error): int:
    // p points at the backslash, returns the next unread byte (or n on error).
    if p + 1 >= n:
        _fail(err, ErrorKind.UnexpectedEnd, "the string is not closed", p, "toml.unterminated_string")
        ret n
    end
    e := _ub(_bp(s), p + 1)
    if e == 34: str.BufAppendChar(sb, 34)
    else e == 92: str.BufAppendChar(sb, 92)
    else e == 110: str.BufAppendChar(sb, 10)
    else e == 116: str.BufAppendChar(sb, 9)
    else e == 114: str.BufAppendChar(sb, 13)
    else e == 98: str.BufAppendChar(sb, 8)
    else e == 102: str.BufAppendChar(sb, 12)
    else e == 117 or e == 85:
        cnt := e == 117 ? 4 : 8
        cp := _hexn(s, n, p + 2, cnt)
        if cp < 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF):
            _fail(err, ErrorKind.Syntax, "invalid unicode escape '" + _tsub(s, p, 2) + "'", p, "toml.invalid_escape")
            ret n
        end
        str.BufAppendCp(sb, cp)
        ret p + 2 + cnt
    else:
        _fail(err, ErrorKind.Syntax, "invalid escape '" + _tsub(s, p, 2) + "'", p, "toml.invalid_escape")
        ret n
    end
    ret p + 2
end

func _parse_basic_multiline(s: str, n: int, i: int, endpos &: int, err &: Error): str:
    bp := _bp(s)
    endpos = n
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut p := _skip_toml_newline(bp, n, i + 3)
    until p < n:
        c := _ub(bp, p)
        if c == 34:
            mut q := p
            until q < n and _ub(bp, q) == 34:
                q++
            end
            run := q - p
            if run >= 3:
                if run > 5:
                    _fail(err, ErrorKind.Syntax, "too many quotes close a multi-line string", p, "toml.invalid_string")
                    ret ""
                end
                mut extra := 0
                until extra < run - 3:
                    str.BufAppendChar(sb, 34)
                    extra++
                end
                endpos = q
                ret str.BufStr(sb)
            end
            mut k := 0
            until k < run:
                str.BufAppendChar(sb, 34)
                k++
            end
            p = q
            continue
        end
        if c == 92:
            e := _ub(bp, p + 1)
            if e == 10 or (e == 13 and p + 2 < n and _ub(bp, p + 2) == 10):
                p = _skip_toml_ws_nl(bp, n, p + 2)
                continue
            end
            p = _append_basic_escape(s, n, p, sb, err)
            if err.message != "": ret "" end
            continue
        end
        if c == 13:
            if p + 1 < n and _ub(bp, p + 1) == 10:
                p++
            end
            str.BufAppendChar(sb, 10)
            p++
            continue
        end
        if c == 10:
            str.BufAppendChar(sb, 10)
            p++
            continue
        end
        if c < 32 and c != 9:
            _fail(err, ErrorKind.Syntax, "a control character is not allowed in a string", p, "toml.invalid_string")
            ret ""
        end
        str.BufAppendChar(sb, c)
        p++
    end
    _unterminated(err, n, i, p)
    ret ""
end

func _parse_literal_multiline(s: str, n: int, i: int, endpos &: int, err &: Error): str:
    bp := _bp(s)
    endpos = n
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut p := _skip_toml_newline(bp, n, i + 3)
    until p < n:
        c := _ub(bp, p)
        if c == 39:
            mut q := p
            until q < n and _ub(bp, q) == 39:
                q++
            end
            run := q - p
            if run >= 3:
                if run > 5:
                    _fail(err, ErrorKind.Syntax, "too many quotes close a multi-line string", p, "toml.invalid_string")
                    ret ""
                end
                mut extra := 0
                until extra < run - 3:
                    str.BufAppendChar(sb, 39)
                    extra++
                end
                endpos = q
                ret str.BufStr(sb)
            end
            mut k := 0
            until k < run:
                str.BufAppendChar(sb, 39)
                k++
            end
            p = q
            continue
        end
        if c == 13:
            if p + 1 < n and _ub(bp, p + 1) == 10:
                p++
            end
            str.BufAppendChar(sb, 10)
            p++
            continue
        end
        if c == 10:
            str.BufAppendChar(sb, 10)
            p++
            continue
        end
        str.BufAppendChar(sb, c)
        p++
    end
    _unterminated(err, n, i, p)
    ret ""
end

func _parse_basic_string(s: str, n: int, i: int, endpos &: int, err &: Error): str:
    bp := _bp(s)
    endpos = n
    if i + 2 < n and _ub(bp, i + 1) == 34 and _ub(bp, i + 2) == 34:
        ret _parse_basic_multiline(s, n, i, endpos, err)
    end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut p := i + 1
    until p < n:
        c := _ub(bp, p)
        if c == 34:
            endpos = p + 1
            ret str.BufStr(sb)
        end
        if c == 10 or c == 13: break end
        if c == 92:
            if p + 1 >= n:
                p = n
                break
            end
            e := _ub(bp, p + 1)
            if e == 34: str.BufAppendChar(sb, 34)
            else e == 92: str.BufAppendChar(sb, 92)
            else e == 110: str.BufAppendChar(sb, 10)
            else e == 116: str.BufAppendChar(sb, 9)
            else e == 114: str.BufAppendChar(sb, 13)
            else e == 98: str.BufAppendChar(sb, 8)
            else e == 102: str.BufAppendChar(sb, 12)
            else e == 117 or e == 85:
                cnt := e == 117 ? 4 : 8
                cp := _hexn(s, n, p + 2, cnt)
                if cp < 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF):
                    _fail(err, ErrorKind.Syntax, "invalid unicode escape '" + _tsub(s, p, 2) + "'", p, "toml.invalid_escape")
                    ret ""
                end
                str.BufAppendCp(sb, cp)
                p += cnt
            else:
                _fail(err, ErrorKind.Syntax, "invalid escape '" + _tsub(s, p, 2) + "'", p, "toml.invalid_escape")
                ret ""
            end
            p += 2
        else:
            str.BufAppendChar(sb, c)
            p++
        end
    end
    _unterminated(err, n, i, p)
    ret ""
end

func _parse_literal_string(s: str, n: int, i: int, endpos &: int, err &: Error): str:
    bp := _bp(s)
    endpos = n
    if i + 2 < n and _ub(bp, i + 1) == 39 and _ub(bp, i + 2) == 39:
        ret _parse_literal_multiline(s, n, i, endpos, err)
    end
    mut p := i + 1
    start := p
    until p < n:
        c := _ub(bp, p)
        if c == 39:
            endpos = p + 1
            ret _tsub(s, start, p - start)
        end
        if c == 10 or c == 13: break end
        p++
    end
    _unterminated(err, n, i, p)
    ret ""
end

func _parse_key(s: str, n: int, i: int, endpos &: int, err &: Error): str:
    endpos = i
    if i >= n:
        _fail(err, ErrorKind.UnexpectedEnd, "expected a key", i, "toml.expected_key")
        ret ""
    end
    bp := _bp(s)
    c := _ub(bp, i)
    if c == 34: ret _parse_basic_string(s, n, i, endpos, err) end
    if c == 39: ret _parse_literal_string(s, n, i, endpos, err) end
    mut p := i
    until p < n and _is_bare_key_char(_ub(bp, p)):
        p++
    end
    endpos = p
    if p == i:
        _fail(err, ErrorKind.Syntax, "expected a key", i, "toml.expected_key")
        ret ""
    end
    ret _tsub(s, i, p - i)
end

func _parse_key_path(s: str, n: int, i: int, endpos &: int, err &: Error): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut p := i
    bp := _bp(s)
    until true:
        p = _skip_inline_ws(s, n, p)
        mut kend := p
        k := _parse_key(s, n, p, kend, err)
        if err.message != "":
            endpos = kend
            ret out
        end
        out.Push(k)
        p = _skip_inline_ws(s, n, kend)
        if p < n and _ub(bp, p) == 46:
            p++
        else:
            endpos = p
            ret out
        end
    end
end

func _dotted(path: Vector<str>, count: int): str:
    mut out := ""
    mut i := 0
    until i < count:
        if i > 0: out += "." end
        out += path.Get(i)
        i++
    end
    ret out
end

func _kind_name(v: value.Value): str:
    if value.IsObject(v): ret "a table" end
    if value.IsArray(v): ret "an array" end
    if value.IsString(v): ret "a string" end
    if value.IsInt(v): ret "an integer" end
    if value.IsFloat(v): ret "a float" end
    if value.IsBool(v): ret "a boolean" end
    ret "null"
end

func _scan_bare_token(s: str, n: int, i: int, endpos &: int): str:
    bp := _bp(s)
    mut p := i
    until p < n:
        c := _ub(bp, p)
        if c == 44 or c == 93 or c == 125 or c == 32 or c == 9 or c == 10 or c == 13 or c == 35:
            break
        end
        p++
    end
    endpos = p
    ret _tsub(s, i, p - i)
end

func _looks_datetime(tok: str): bool:
    n := tok.Len()
    if n < 5: ret false end
    bp := _bp(tok)
    is_date := n >= 10 and _ub(bp, 4) == 45
    is_clock := _ub(bp, 2) == 58
    if not is_date and not is_clock: ret false end
    lead := is_date ? 4 : 2
    repeat lead in k:
        if not _is_digit(_ub(bp, k)): ret false end
    end
    repeat n in k:
        c := _ub(bp, k)
        if not (_is_digit(c) or c == 45 or c == 58 or c == 46 or c == 43 or c == 84 or c == 116 or c == 90 or c == 122):
            ret false
        end
    end
    ret true
end

func _digits_ok(s: str, lo: int, hi: int, base: int): bool:
    if lo >= hi: ret false end
    bp := _bp(s)
    mut prev_digit := false
    mut i := lo
    until i < hi:
        c := _ub(bp, i)
        if c == 95:
            if not prev_digit: ret false end
            prev_digit = false
        else:
            d := _digit_val(c)
            if d < 0 or d >= base: ret false end
            prev_digit = true
        end
        i++
    end
    ret prev_digit
end

func _scan_digits(s: str, n: int, i: int): int:
    bp := _bp(s)
    mut p := i
    until p < n and (_is_digit(_ub(bp, p)) or _ub(bp, p) == 95):
        p++
    end
    ret p
end

func _prefix_base(tok: str): int:
    if tok.Len() < 3 or _ub(_bp(tok), 0) != 48: ret 0 end
    c := _ub(_bp(tok), 1)
    if c == 120: ret 16 end
    if c == 111: ret 8 end
    if c == 98: ret 2 end
    ret 0
end

func _valid_number(tok: str): bool:
    n := tok.Len()
    if n == 0: ret false end
    bp := _bp(tok)
    base := _prefix_base(tok)
    if base > 0: ret _digits_ok(tok, 2, n, base) end
    mut i := 0
    c0 := _ub(bp, 0)
    if c0 == 43 or c0 == 45: i = 1 end
    rest := tok.Substr(i, n - i)
    if rest == "inf" or rest == "nan": ret true end
    start := i
    i = _scan_digits(tok, n, i)
    if not _digits_ok(tok, start, i, 10): ret false end
    if i - start > 1 and _ub(bp, start) == 48: ret false end
    if i < n and _ub(bp, i) == 46:
        fs := i + 1
        i = _scan_digits(tok, n, fs)
        if not _digits_ok(tok, fs, i, 10): ret false end
    end
    if i < n and (_ub(bp, i) == 101 or _ub(bp, i) == 69):
        i++
        if i < n and (_ub(bp, i) == 43 or _ub(bp, i) == 45): i++ end
        es := i
        i = _scan_digits(tok, n, es)
        if not _digits_ok(tok, es, i, 10): ret false end
    end
    ret i == n
end

func _parse_number(tok: str, at: int, err &: Error): value.Value:
    base := _prefix_base(tok)
    mut fits := true
    if base > 0:
        v := _parse_int_base(tok, 2, base, false, fits)
        if not fits:
            _fail(err, ErrorKind.OutOfRange, "the integer " + tok + " does not fit in 64 bits", at, "toml.int_overflow")
        end
        ret value.ValueInt(v)
    end
    clean := str.Replace(tok, "_", "")
    if clean == "inf" or clean == "+inf": ret value.ValueFloat(_pos_inf()) end
    if clean == "-inf": ret value.ValueFloat(_neg_inf()) end
    if clean == "nan" or clean == "+nan" or clean == "-nan": ret value.ValueFloat(_nan_val()) end
    if str.Contains(clean, ".") or str.Contains(clean, "e") or str.Contains(clean, "E"):
        ret value.ValueFloat(clean.ToFloat())
    end
    c0 := _ub(_bp(clean), 0)
    neg := c0 == 45
    mut first := 0
    if c0 == 43 or c0 == 45: first = 1 end
    v := _parse_int_base(clean, first, 10, neg, fits)
    if not fits:
        _fail(err, ErrorKind.OutOfRange, "the integer " + tok + " does not fit in 64 bits", at, "toml.int_overflow")
    end
    ret value.ValueInt(v)
end

func _parse_value_d(s: str, n: int, i: int, endpos &: int, err &: Error, depth: int): value.Value:
    p0 := _skip_inline_ws(s, n, i)
    endpos = p0
    if depth > 512:
        _fail(err, ErrorKind.OutOfRange, "the value is nested deeper than 512 levels", p0, "toml.too_deep")
        ret value.ValueNull()
    end
    if p0 >= n:
        _fail(err, ErrorKind.UnexpectedEnd, "expected a value", p0, "toml.expected_value")
        ret value.ValueNull()
    end
    bp := _bp(s)
    c := _ub(bp, p0)
    if c == 34: ret value.ValueString(_parse_basic_string(s, n, p0, endpos, err)) end
    if c == 39: ret value.ValueString(_parse_literal_string(s, n, p0, endpos, err)) end
    if c == 91: ret _parse_array(s, n, p0, endpos, err, depth) end
    if c == 123: ret _parse_inline_table(s, n, p0, endpos, err, depth) end
    mut ep := p0
    tok := _scan_bare_token(s, n, p0, ep)
    endpos = ep
    if tok.Len() == 0:
        _fail(err, ErrorKind.Syntax, "expected a value", p0, "toml.expected_value")
        ret value.ValueNull()
    end
    if tok == "true": ret value.ValueBool(true) end
    if tok == "false": ret value.ValueBool(false) end
    if _looks_datetime(tok):
        if tok.Len() == 10 and ep + 3 < n and _ub(bp, ep) == 32 and _is_digit(_ub(bp, ep + 1)) and _is_digit(_ub(bp, ep + 2)) and _ub(bp, ep + 3) == 58:
            mut ep2 := ep + 1
            clock := _scan_bare_token(s, n, ep + 1, ep2)
            endpos = ep2
            ret value.ValueString(tok + " " + clock)
        end
        ret value.ValueString(tok)
    end
    if _valid_number(tok): ret _parse_number(tok, p0, err) end
    _fail(err, ErrorKind.Syntax, "invalid value '" + tok + "'", p0, "toml.invalid_value")
    ret value.ValueNull()
end

func _parse_array(s: str, n: int, i: int, endpos &: int, err &: Error, depth: int): value.Value:
    mut out := value.NewValueArray()
    bp := _bp(s)
    mut p := _skip_loose(s, n, i + 1)
    until true:
        if p >= n: break end
        if _ub(bp, p) == 93:
            endpos = p + 1
            ret out
        end
        mut vend := p
        item := _parse_value_d(s, n, p, vend, err, depth + 1)
        if err.message != "":
            endpos = vend
            ret out
        end
        value.ArrayPush(out, item)
        p = _skip_loose(s, n, vend)
        if p < n and _ub(bp, p) == 44:
            p = _skip_loose(s, n, p + 1)
            continue
        end
        if p < n and _ub(bp, p) == 93:
            endpos = p + 1
            ret out
        end
        if p < n:
            _fail(err, ErrorKind.Syntax, "expected ',' or ']' in the array", p, "toml.expected_comma")
            endpos = p
            ret out
        end
    end
    _fail(err, ErrorKind.UnexpectedEnd, "the array is not closed", i, "toml.unclosed_array")
    endpos = n
    ret out
end

func _descend(root &: value.Value, path: Vector<str>, idx: int, child &: value.Value, at: int, err &: Error): bool:
    key := path.Get(idx)
    child = value.NewValueObject()
    if not value.ObjectHas(root, key): ret true end
    child = value.ObjectGet(root, key)
    if value.IsObject(child): ret true end
    if value.IsArray(child) and value.ArrayLen(child) > 0 and value.IsObject(value.ArrayGet(child, value.ArrayLen(child) - 1)): ret true end
    _fail(err, ErrorKind.TypeMismatch, "'" + _dotted(path, idx + 1) + "' is " + _kind_name(child) + ", not a table", at, "toml.not_a_table")
    ret false
end

func _store(root &: value.Value, key: str, child &: value.Value, item: value.Value):
    if value.IsArray(child):
        value.ArraySet(child, value.ArrayLen(child) - 1, item)
        value.ObjectSet(root, key, child)
    else:
        value.ObjectSet(root, key, item)
    end
end

func _inner(child: value.Value): value.Value:
    if value.IsArray(child): ret value.ArrayGet(child, value.ArrayLen(child) - 1) end
    ret child
end

func _put(root &: value.Value, path: Vector<str>, idx: int, leaf: value.Value, at: int, err &: Error): bool:
    key := path.Get(idx)
    if idx == path.Len() - 1:
        if value.ObjectHas(root, key):
            _fail(err, ErrorKind.AlreadyExists, "duplicate key '" + _dotted(path, idx + 1) + "'", at, "toml.duplicate_key")
            ret false
        end
        value.ObjectSet(root, key, leaf)
        ret true
    end
    mut child := value.NewValueObject()
    if not _descend(root, path, idx, child, at, err): ret false end
    mut item := _inner(child)
    if not _put(item, path, idx + 1, leaf, at, err): ret false end
    _store(root, key, child, item)
    ret true
end

func _parse_inline_table(s: str, n: int, i: int, endpos &: int, err &: Error, depth: int): value.Value:
    mut out := value.NewValueObject()
    bp := _bp(s)
    mut p := _skip_inline_ws(s, n, i + 1)
    if p < n and _ub(bp, p) == 125:
        endpos = p + 1
        ret out
    end
    until true:
        p = _skip_inline_ws(s, n, p)
        kstart := p
        mut kend := p
        path := _parse_key_path(s, n, p, kend, err)
        if err.message != "":
            endpos = kend
            ret out
        end
        p = _skip_inline_ws(s, n, kend)
        if p >= n or _ub(bp, p) != 61:
            if p >= n:
                _fail(err, ErrorKind.UnexpectedEnd, "the inline table is not closed", i, "toml.unclosed_table")
            else:
                _fail(err, ErrorKind.Syntax, "expected '=' after the key", p, "toml.expected_equals")
            end
            endpos = p
            ret out
        end
        p++
        mut vend := p
        v := _parse_value_d(s, n, p, vend, err, depth + 1)
        if err.message != "":
            endpos = vend
            ret out
        end
        if not _put(out, path, 0, v, kstart, err):
            endpos = vend
            ret out
        end
        p = _skip_inline_ws(s, n, vend)
        if p < n and _ub(bp, p) == 44:
            p++
            continue
        end
        if p < n and _ub(bp, p) == 125:
            endpos = p + 1
            ret out
        end
        if p >= n:
            _fail(err, ErrorKind.UnexpectedEnd, "the inline table is not closed", i, "toml.unclosed_table")
        else:
            _fail(err, ErrorKind.Syntax, "expected ',' or '}' in the inline table", p, "toml.expected_comma")
        end
        endpos = p
        ret out
    end
end

func _open_table(root &: value.Value, path: Vector<str>, idx: int, is_array: bool, at: int, err &: Error): bool:
    key := path.Get(idx)
    if idx < path.Len() - 1:
        mut child := value.NewValueObject()
        if not _descend(root, path, idx, child, at, err): ret false end
        mut item := _inner(child)
        if not _open_table(item, path, idx + 1, is_array, at, err): ret false end
        _store(root, key, child, item)
        ret true
    end
    name := _dotted(path, path.Len())
    has := value.ObjectHas(root, key)
    existing := value.ObjectGet(root, key)
    if is_array:
        mut arr := value.NewValueArray()
        if has:
            if not value.IsArray(existing):
                _fail(err, ErrorKind.TypeMismatch, "'" + name + "' is " + _kind_name(existing) + ", not an array of tables", at, "toml.not_a_table")
                ret false
            end
            arr = existing
        end
        value.ArrayPush(arr, value.NewValueObject())
        value.ObjectSet(root, key, arr)
        ret true
    end
    if not has:
        value.ObjectSet(root, key, value.NewValueObject())
        ret true
    end
    if not value.IsObject(existing):
        _fail(err, ErrorKind.TypeMismatch, "'" + name + "' is " + _kind_name(existing) + ", not a table", at, "toml.not_a_table")
        ret false
    end
    ret true
end

func _path_key(path: Vector<str>): str:
    mut out := ""
    mut i := 0
    until i < path.Len():
        k := path.Get(i)
        out = out + conv.FormatInt(k.Len() as i64) + ":" + k + ";"
        i++
    end
    ret out
end

func _forget_below(defined &: HashMap<str, bool>, prefix: str):
    mut drop := Vector {} as Vector<str>
    each k, _ in defined:
        if str.StartsWith(k, prefix): drop.Push(k) end
    end
    each k in drop:
        defined.Remove(k)
    end
    drop.Free()
end

func _read_header(root &: value.Value, s: str, n: int, start: int, defined &: HashMap<str, bool>, cur_path &: Vector<str>, err &: Error): int:
    bp := _bp(s)
    mut is_array := false
    mut hstart := start + 1
    if hstart < n and _ub(bp, hstart) == 91:
        is_array = true
        hstart++
    end
    mut hend := hstart
    path := _parse_key_path(s, n, hstart, hend, err)
    if err.message != "": ret n end
    mut q := _skip_inline_ws(s, n, hend)
    mut closed := q < n and _ub(bp, q) == 93
    if is_array: closed = q + 1 < n and _ub(bp, q) == 93 and _ub(bp, q + 1) == 93 end
    if not closed:
        mut want := "']'"
        if is_array: want = "']]'" end
        if q >= n:
            _fail(err, ErrorKind.UnexpectedEnd, "the table header is not closed", start, "toml.unclosed_header")
        else:
            _fail(err, ErrorKind.Syntax, "expected " + want + " to close the table header", q, "toml.unclosed_header")
        end
        ret n
    end
    q += is_array ? 2 : 1
    if not _end_of_line(s, n, q, "the table header", err): ret n end
    key := _path_key(path)
    if is_array:
        _forget_below(defined, key)
    else:
        if defined.Has(key):
            _fail(err, ErrorKind.AlreadyExists, "the table [" + _dotted(path, path.Len()) + "] is defined twice", start, "toml.duplicate_table")
            ret n
        end
        defined.Put(key, true)
    end
    if not _open_table(root, path, 0, is_array, start, err): ret n end
    cur_path = path
    ret q
end

func _decode(text: str, err &: Error): value.Value:
    mut root := value.NewValueObject()
    n := text.Len()
    bp := _bp(text)
    mut start := 0
    if n >= 3 and _ub(bp, 0) == 0xEF and _ub(bp, 1) == 0xBB and _ub(bp, 2) == 0xBF: start = 3 end
    mut p := _skip_loose(text, n, start)
    mut cur_path := Vector {} as Vector<str>
    mut defined := HashMap {} as HashMap<str, bool>
    until p < n:
        if _ub(bp, p) == 91:
            q := _read_header(root, text, n, p, defined, cur_path, err)
            if err.message != "": ret root end
            p = _skip_loose(text, n, q)
            continue
        end
        kstart := p
        mut kend := p
        keypath := _parse_key_path(text, n, p, kend, err)
        if err.message != "": ret root end
        mut q := _skip_inline_ws(text, n, kend)
        if q >= n or _ub(bp, q) != 61:
            if q >= n:
                _fail(err, ErrorKind.UnexpectedEnd, "expected '=' after the key", q, "toml.expected_equals")
            else:
                _fail(err, ErrorKind.Syntax, "expected '=' after the key", q, "toml.expected_equals")
            end
            ret root
        end
        q++
        mut vend := q
        v := _parse_value_d(text, n, q, vend, err, 0)
        if err.message != "": ret root end
        if not _end_of_line(text, n, vend, "the value", err): ret root end
        mut full := Vector {} as Vector<str>
        each seg in cur_path:
            full.Push(seg)
        end
        each seg in keypath:
            full.Push(seg)
        end
        if not _put(root, full, 0, v, kstart, err): ret root end
        p = _skip_loose(text, n, vend)
    end
    ret root
end

func _needs_quote_key(k: str): bool:
    n := k.Len()
    if n == 0: ret true end
    bp := _bp(k)
    mut i := 0
    until i < n:
        if not _is_bare_key_char(_ub(bp, i)): ret true end
        i++
    end
    ret false
end

func _hex_digit(d: int): int:
    if d < 10: ret 48 + d end
    ret 55 + d
end

func _escape_toml_string(s: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    n := s.Len()
    bp := _bp(s)
    mut i := 0
    until i < n:
        c := _ub(bp, i)
        if c == 34: str.BufAppend(sb, `\"`)
        else c == 92: str.BufAppend(sb, "\\\\")
        else c == 10: str.BufAppend(sb, "\\n")
        else c == 9: str.BufAppend(sb, "\\t")
        else c == 13: str.BufAppend(sb, "\\r")
        else c == 8: str.BufAppend(sb, "\\b")
        else c == 12: str.BufAppend(sb, "\\f")
        else c < 32 or c == 127:
            str.BufAppend(sb, "\\u00")
            str.BufAppendChar(sb, _hex_digit(c >> 4))
            str.BufAppendChar(sb, _hex_digit(c & 15))
        else:
            str.BufAppendChar(sb, c)
        end
        i++
    end
    ret str.BufStr(sb)
end

func _encode_key(k: str): str:
    if _needs_quote_key(k): ret `"`.Concat(_escape_toml_string(k)).Concat(`"`) end
    ret k
end

func _join_key(prefix: str, k: str): str:
    if prefix == "": ret k end
    ret prefix + "." + k
end

func _encode_inline_value(v: value.Value, path: str, err &: Error): str:
    if value.IsNull(v):
        if err.message == "":
            err = Error.New(ErrorKind.Unsupported, "TOML has no null value").with_code("toml.null").with_path(path)
        end
        ret ""
    end
    if value.IsBool(v):
        if value.AsBool(v): ret "true" end
        ret "false"
    end
    if value.IsInt(v): ret conv.FormatInt(value.AsInt(v)) end
    if value.IsFloat(v):
        f := conv.FormatFloat(value.AsFloat(v))
        if str.Contains(f, ".") or str.Contains(f, "e") or str.Contains(f, "n"): ret f end
        ret f.Concat(".0")
    end
    if value.IsString(v): ret `"`.Concat(_escape_toml_string(value.AsString(v))).Concat(`"`) end
    if value.IsBytes(v) or value.IsExt(v):
        if err.message == "":
            err = Error.New(ErrorKind.Unsupported, "TOML has no binary or extension value").with_code("toml.unsupported_value").with_path(path)
        end
        ret ""
    end
    if value.IsArray(v):
        mut sb := str.NewBuilder()
        str.BufAppendChar(sb, 91)
        n := value.ArrayLen(v)
        mut i := 0
        until i < n:
            if i > 0: str.BufAppend(sb, ", ") end
            str.BufAppend(sb, _encode_inline_value(value.ArrayGet(v, i), path + "[" + conv.FormatInt(i as i64) + "]", err))
            i++
        end
        str.BufAppendChar(sb, 93)
        arr_out := str.BufStr(sb)
        str.BufFree(sb)
        ret arr_out
    end
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 123)
    keys := value.ObjectKeys(v)
    mut i := 0
    until i < keys.Len():
        if i > 0: str.BufAppend(sb, ", ") end
        k := keys.Get(i)
        str.BufAppend(sb, _encode_key(k))
        str.BufAppend(sb, " = ")
        str.BufAppend(sb, _encode_inline_value(value.ObjectGet(v, k), _join_key(path, k), err))
        i++
    end
    str.BufAppendChar(sb, 125)
    obj_out := str.BufStr(sb)
    str.BufFree(sb)
    ret obj_out
end

func _encode_table(sb &: str.StringBuilder, v: value.Value, prefix: Vector<str>, err &: Error):
    keys := value.ObjectKeys(v)
    here := _dotted(prefix, prefix.Len())
    mut sub_keys := Vector {} as Vector<str>
    mut i := 0
    until i < keys.Len():
        k := keys.Get(i)
        fv := value.ObjectGet(v, k)
        if value.IsObject(fv):
            sub_keys.Push(k)
        else value.IsNull(fv) == false:
            str.BufAppend(sb, _encode_key(k))
            str.BufAppend(sb, " = ")
            str.BufAppend(sb, _encode_inline_value(fv, _join_key(here, k), err))
            str.BufAppendChar(sb, 10)
        end
        i++
    end
    mut si := 0
    until si < sub_keys.Len():
        k := sub_keys.Get(si)
        mut path := Vector {} as Vector<str>
        mut pi := 0
        until pi < prefix.Len():
            path.Push(prefix.Get(pi))
            pi++
        end
        path.Push(k)
        str.BufAppendChar(sb, 91)
        mut j := 0
        until j < path.Len():
            if j > 0: str.BufAppendChar(sb, 46) end
            str.BufAppend(sb, _encode_key(path.Get(j)))
            j++
        end
        str.BufAppendChar(sb, 93)
        str.BufAppendChar(sb, 10)
        _encode_table(sb, value.ObjectGet(v, k), path, err)
        si++
    end
end

@en "Decode"
@fa "کدگشایی"
pub func Decode(text: str): value.Value throws:
    mut err := Error {}
    v := _decode(text, err)
    if err.message != "":
        throw err.locate(text).wrap("toml")
    end
    ret v
end

@en "Valid"
@fa "معتبر"
pub func Valid(text: str): bool:
    mut err := Error {}
    _decode(text, err)
    ret err.message == ""
end

@en "Encode"
@fa "کدگذاری"
pub func Encode(v: value.Value): str throws:
    if not value.IsObject(v):
        throw Error.New(ErrorKind.Unsupported, "the top level must be an object, since a TOML document is a table, not " + _kind_name(v)).with_code("toml.not_a_table").wrap("toml")
    end
    mut err := Error {}
    mut sb := str.NewBuilder()
    prefix := Vector {} as Vector<str>
    _encode_table(sb, v, prefix, err)
    out := str.BufStr(sb)
    str.BufFree(sb)
    if err.message != "":
        throw err.wrap("toml")
    end
    ret out
end
