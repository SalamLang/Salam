package ulid

import time

func _now_ms(): i64:
    ms := time.NowMillis()
    if ms < 0: ret 0 end
    if ms > MAX_TIME: ret MAX_TIME end
    ret ms
end

@en "Now"
@fa "اکنون"
pub func Now(): i64:
    ret _now_ms()
end
