package ulid

import str

func _val(c: int, strict: bool): int:
    mut u := c
    if not strict:
        if u >= 97 and u <= 122: u -= 32 end
        if u == 73 or u == 76: u = 49 end
        if u == 79: u = 48 end
    end
    a := _ALPHABET as u8*
    repeat 32 in i:
        if (a[i] as int) == u: ret i end
    end
    ret -1
end

func _dec(p: u8*, start: int, n: int, strict: bool): i64:
    mut v := 0 as i64
    repeat n in k:
        d := _val(p[start + k] as int, strict)
        if d < 0: ret -1 end
        v = (v << 5) | (d as i64)
    end
    ret v
end

func _parse(s: str, strict: bool): Result:
    if s.Len() != 26: ret _fail(ERR_LENGTH) end
    p := s as u8*
    first := _val(p[0] as int, strict)
    if first < 0: ret _fail(ERR_CHAR) end
    if first > 7: ret _fail(ERR_OVERFLOW) end
    t := _dec(p, 0, 10, strict)
    h := _dec(p, 10, 8, strict)
    l := _dec(p, 18, 8, strict)
    if t < 0 or h < 0 or l < 0: ret _fail(ERR_CHAR) end
    ret _ok(ULID { time = t, hi = h, lo = l })
end

@en "Parse"
@fa "تجزیه"
pub func Parse(s: str): Result:
    ret _parse(s, false)
end

@en "ParseStrict"
@fa "تجزیه سخت گیرانه"
pub func ParseStrict(s: str): Result:
    ret _parse(s, true)
end

@en "ParseOr"
@fa "تجزیه با پیش فرض"
pub func ParseOr(s: str, fallback: ULID): ULID:
    r := _parse(s, false)
    if r.ok: ret r.id end
    ret fallback
end

@en "IsValid"
@fa "معتبر است"
pub func IsValid(s: str): bool:
    ret _parse(s, false).ok
end
