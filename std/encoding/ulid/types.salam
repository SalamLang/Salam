package ulid

import sync

@en "MAX_TIME"
@fa "بیشینه زمان"
pub const MAX_TIME := 281474976710655

@en "OK"
@fa "بدون خطا"
pub const OK := 0
@en "ERR_LENGTH"
@fa "خطای طول"
pub const ERR_LENGTH := 1
@en "ERR_CHAR"
@fa "خطای نویسه"
pub const ERR_CHAR := 2
@en "ERR_OVERFLOW"
@fa "خطای سرریز"
pub const ERR_OVERFLOW := 3
@en "ERR_TIME"
@fa "خطای زمان"
pub const ERR_TIME := 4
@en "ERR_ENTROPY"
@fa "خطای تصادف"
pub const ERR_ENTROPY := 5
@en "ERR_BYTES"
@fa "خطای بایت"
pub const ERR_BYTES := 6

const _ALPHABET := "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
const _MASK40 := 1099511627775
const _POW40 := 1099511627776

@en "ULID"
@fa "شناسه یولید"
pub struct ULID:
    @en "time"
    @fa "زمان"
    pub time: i64 = 0
    @en "hi"
    @fa "بالا"
    pub hi: i64 = 0
    @en "lo"
    @fa "پایین"
    pub lo: i64 = 0
end

@en "Result"
@fa "نتیجه"
pub struct Result:
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
    @en "id"
    @fa "شناسه"
    pub id: ULID = ULID {}
    @en "err"
    @fa "خطا"
    pub err: int = 0
end

@en "Generator"
@fa "تولیدکننده"
pub struct Generator:
    @en "state"
    @fa "وضعیت"
    pub state: i64* = null
    @en "mu"
    @fa "قفل"
    pub mu: sync.Mutex = sync.Mutex {}
    @en "clock"
    @fa "ساعت"
    pub clock: func () i64
    @en "entropy"
    @fa "تصادف"
    pub entropy: func () i64
end

func _ok(id: ULID): Result:
    ret Result { ok = true, id = id, err = OK }
end

func _fail(code: int): Result:
    ret Result { ok = false, id = ULID {}, err = code }
end

@en "ErrorText"
@fa "متن خطا"
pub func ErrorText(code: int): str:
    if code == OK: ret "ok" end
    if code == ERR_LENGTH: ret "a ULID is 26 characters" end
    if code == ERR_CHAR: ret "invalid character in ULID" end
    if code == ERR_OVERFLOW: ret "ULID value is larger than 7ZZZZZZZZZZZZZZZZZZZZZZZZZ" end
    if code == ERR_TIME: ret "timestamp is outside 0 to 281474976710655" end
    if code == ERR_ENTROPY: ret "the entropy source failed" end
    if code == ERR_BYTES: ret "wrong number of bytes" end
    ret "unknown error"
end
