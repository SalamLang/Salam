@en "ulid"
@fa "یولید"
package ulid

_default := NewGenerator()

@en "Default"
@fa "پیش فرض"
pub func Default(): Generator:
    ret _default
end

@en "New"
@fa "جدید"
pub func New(): ULID:
    r := Next(_default)
    ret r.id
end

@en "NewString"
@fa "رشته جدید"
pub func NewString(): str:
    ret String(New())
end

@en "NewAt"
@fa "جدید برای"
pub func NewAt(ms: i64): Result:
    if ms < 0 or ms > MAX_TIME: ret _fail(ERR_TIME) end
    a := _sys_entropy()
    b := _sys_entropy()
    ret _ok(ULID { time = ms, hi = a, lo = b })
end

@en "NewBatch"
@fa "دسته جدید"
pub func NewBatch(n: int): Vector<ULID>:
    ret Batch(_default, n)
end
