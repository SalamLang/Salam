package ulid

import str

func _enc(sb &: str.StringBuilder, v: i64, n: int):
    mut k := n - 1
    until k >= 0:
        d := ((v >> (k * 5)) & 31) as int
        a := _ALPHABET as u8*
        str.BufAppendChar(sb, a[d] as int)
        k--
    end
end

func _put_bytes(out &: Vector<u8>, v: i64, n: int):
    mut k := n - 1
    until k >= 0:
        out.Push(((v >> (k * 8)) & 255) as u8)
        k--
    end
end

func _get_bytes(b: Vector<u8>, start: int, n: int): i64:
    mut v := 0 as i64
    repeat n in k:
        v = (v << 8) | (b.Get(start + k) as i64)
    end
    ret v
end

func _clamp(ms: i64): i64:
    if ms < 0: ret 0 end
    if ms > MAX_TIME: ret MAX_TIME end
    ret ms
end

@en "FromParts"
@fa "از اجزا"
pub func FromParts(ms: i64, entropy: Vector<u8>): Result:
    if ms < 0 or ms > MAX_TIME: ret _fail(ERR_TIME) end
    if entropy.Len() != 10: ret _fail(ERR_BYTES) end
    ret _ok(ULID { time = ms, hi = _get_bytes(entropy, 0, 5), lo = _get_bytes(entropy, 5, 5) })
end

@en "FromBytes"
@fa "از بایت ها"
pub func FromBytes(b: Vector<u8>): Result:
    if b.Len() != 16: ret _fail(ERR_BYTES) end
    ret _ok(ULID { time = _get_bytes(b, 0, 6), hi = _get_bytes(b, 6, 5), lo = _get_bytes(b, 11, 5) })
end

@en "FromUUIDBytes"
@fa "از بایت های یو یو آی دی"
pub func FromUUIDBytes(b: Vector<u8>): Result:
    ret FromBytes(b)
end

@en "String"
@fa "رشته"
pub func String(id: ULID): str:
    mut sb := str.NewBuilder()
    _enc(sb, id.time, 10)
    _enc(sb, id.hi, 8)
    _enc(sb, id.lo, 8)
    s := str.BufStr(sb)
    str.BufFree(sb)
    ret s
end

@en "Bytes"
@fa "بایت ها"
pub func Bytes(id: ULID): Vector<u8>:
    mut out := Vector {} as Vector<u8>
    _put_bytes(out, id.time, 6)
    _put_bytes(out, id.hi, 5)
    _put_bytes(out, id.lo, 5)
    ret out
end

@en "ToUUIDBytes"
@fa "به بایت های یو یو آی دی"
pub func ToUUIDBytes(id: ULID): Vector<u8>:
    ret Bytes(id)
end

@en "Entropy"
@fa "بخش تصادفی"
pub func Entropy(id: ULID): Vector<u8>:
    mut out := Vector {} as Vector<u8>
    _put_bytes(out, id.hi, 5)
    _put_bytes(out, id.lo, 5)
    ret out
end

@en "Time"
@fa "زمان شناسه"
pub func Time(id: ULID): i64:
    ret id.time
end

@en "Compare"
@fa "مقایسه"
pub func Compare(a: ULID, b: ULID): int:
    if a.time != b.time: ret a.time < b.time ? -1 : 1 end
    if a.hi != b.hi: ret a.hi < b.hi ? -1 : 1 end
    if a.lo != b.lo: ret a.lo < b.lo ? -1 : 1 end
    ret 0
end

@en "Equal"
@fa "برابر است"
pub func Equal(a: ULID, b: ULID): bool:
    ret Compare(a, b) == 0
end

@en "Less"
@fa "کوچکتر است"
pub func Less(a: ULID, b: ULID): bool:
    ret Compare(a, b) < 0
end

@en "IsZero"
@fa "صفر است"
pub func IsZero(id: ULID): bool:
    ret id.time == 0 and id.hi == 0 and id.lo == 0
end

@en "MinAt"
@fa "کمینه برای"
pub func MinAt(ms: i64): ULID:
    ret ULID { time = _clamp(ms), hi = 0, lo = 0 }
end

@en "MaxAt"
@fa "بیشینه برای"
pub func MaxAt(ms: i64): ULID:
    ret ULID { time = _clamp(ms), hi = _MASK40, lo = _MASK40 }
end

@en "Increment"
@fa "افزایش"
pub func Increment(id: ULID): Result:
    if id.lo < _MASK40:
        ret _ok(ULID { time = id.time, hi = id.hi, lo = id.lo + 1 })
    end
    if id.hi < _MASK40:
        ret _ok(ULID { time = id.time, hi = id.hi + 1, lo = 0 })
    end
    ret _fail(ERR_OVERFLOW)
end
