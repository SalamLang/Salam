@en "url"
@fa "نشانی وب"
package url

import mem
import str
import encoding
import encoding.query

@en "URL"
@fa "نشانی وب"
pub struct URL:
    @en "scheme"
    @fa "طرح"
    pub scheme: str = ""
    @en "userinfo"
    @fa "اطلاعات کاربر"
    pub userinfo: str = ""
    @en "host"
    @fa "میزبان"
    pub host: str = ""
    @en "port"
    @fa "درگاه"
    pub port: int = 0
    @en "path"
    @fa "مسیر"
    pub path: str = ""
    @en "raw_query"
    @fa "پرس‌وجوی خام"
    pub raw_query: str = ""
    @en "fragment"
    @fa "قطعه"
    pub fragment: str = ""
end

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

func _hexdigit(v: int): int:
    if v >= 0 and v <= 9: ret 48 + v end
    ret 65 + (v - 10)
end

func _hexval(c: int): int:
    if c >= 48 and c <= 57: ret c - 48 end
    if c >= 65 and c <= 70: ret c - 65 + 10 end
    if c >= 97 and c <= 102: ret c - 97 + 10 end
    ret 0 - 1
end

func _path_seg_safe(code: int): bool:
    if code >= 65 and code <= 90: ret true end
    if code >= 97 and code <= 122: ret true end
    if code >= 48 and code <= 57: ret true end
    if code == 45 or code == 95 or code == 46 or code == 126: ret true end
    if code == 58 or code == 64: ret true end
    if code == 33 or code == 36 or code == 38 or code == 39: ret true end
    if code == 40 or code == 41 or code == 42 or code == 43: ret true end
    if code == 44 or code == 59 or code == 61: ret true end
    ret false
end

func _url_err(text: str, kind: ErrorKind, message: str, offset: int): Error:
    ret Error.At(kind, message, offset).locate(text).wrap("url")
end

func _byte_desc(code: int): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    if code == 32:
        str.BufAppend(sb, "space")
    else code > 32 and code < 127:
        str.BufAppend(sb, "character ")
        str.BufAppendChar(sb, 39)
        str.BufAppendChar(sb, code)
        str.BufAppendChar(sb, 39)
    else:
        str.BufAppend(sb, "byte 0x")
        str.BufAppendChar(sb, _hexdigit(code / 16))
        str.BufAppendChar(sb, _hexdigit(code % 16))
    end
    ret str.BufStr(sb)
end

func _pct_decode_no_plus(s: str): str throws:
    n := s.Len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        code := _ub(bp, i)
        if code == 37:
            try _check_escape(s, i, n)
            str.BufAppendChar(sb, _hexval(_ub(bp, i + 1)) * 16 + _hexval(_ub(bp, i + 2)))
            i += 3
        else:
            str.BufAppendChar(sb, code)
            i++
        end
    end
    ret str.BufStr(sb)
end

func _check_escape(raw: str, i: int, stop: int) throws:
    bp := _bp(raw)
    if i + 1 < stop and _hexval(_ub(bp, i + 1)) < 0:
        throw _url_err(raw, ErrorKind.Syntax, "malformed percent escape", i)
    end
    if i + 2 < stop and _hexval(_ub(bp, i + 2)) < 0:
        throw _url_err(raw, ErrorKind.Syntax, "malformed percent escape", i)
    end
    if i + 2 >= stop:
        throw _url_err(raw, ErrorKind.UnexpectedEnd, "incomplete percent escape", i)
    end
end

func _check_escapes(raw: str, from: int, stop: int) throws:
    bp := _bp(raw)
    mut i := from
    until i < stop:
        if _ub(bp, i) == 37:
            try _check_escape(raw, i, stop)
            i += 3
        else:
            i++
        end
    end
end

func _is_alpha(code: int): bool:
    ret (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
end

func _is_digit(code: int): bool:
    ret code >= 48 and code <= 57
end

func _sub_delim(code: int): bool:
    ret code == 33 or code == 36 or code == 38 or code == 39 or code == 40 or code == 41 or code == 42 or code == 43 or code == 44 or code == 59 or code == 61
end

func _name_char(code: int): bool:
    if _is_alpha(code) or _is_digit(code) or code >= 128: ret true end
    if code == 45 or code == 46 or code == 95 or code == 126 or code == 37: ret true end
    ret _sub_delim(code)
end

func _check_scheme(raw: str, stop: int) throws:
    if stop == 0:
        throw _url_err(raw, ErrorKind.Syntax, "missing scheme before '://'", 0)
    end
    bp := _bp(raw)
    repeat stop in i:
        code := _ub(bp, i)
        mut good := _is_alpha(code)
        if i > 0 and (_is_digit(code) or code == 43 or code == 45 or code == 46): good = true end
        if not good:
            throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code) + " in scheme", i)
        end
    end
end

func _check_name(raw: str, from: int, stop: int, what: str, allow_colon: bool) throws:
    bp := _bp(raw)
    mut i := from
    until i < stop:
        code := _ub(bp, i)
        if not _name_char(code) and not (allow_colon and code == 58):
            throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code) + " in " + what, i)
        end
        i++
    end
    try _check_escapes(raw, from, stop)
end

func _parse_port(raw: str, from: int, stop: int): int throws:
    bp := _bp(raw)
    mut port := 0
    mut i := from
    until i < stop:
        code := _ub(bp, i)
        if not _is_digit(code):
            throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code) + " in port", i)
        end
        port = port * 10 + (code - 48)
        if port > 65535:
            throw _url_err(raw, ErrorKind.OutOfRange, "port is larger than 65535", from)
        end
        i++
    end
    ret port
end

func _index_from(raw: str, code: int, from: int, stop: int): int:
    bp := _bp(raw)
    mut i := from
    until i < stop:
        if _ub(bp, i) == code: ret i end
        i++
    end
    ret 0 - 1
end

func _parse_authority(raw: str, from: int, stop: int, u &: URL) throws:
    bp := _bp(raw)
    mut hs := from
    mut at := 0 - 1
    mut i := from
    until i < stop:
        if _ub(bp, i) == 64: at = i end
        i++
    end
    if at >= 0:
        try _check_name(raw, from, at, "userinfo", true)
        u.userinfo = raw.substr(from, at - from)
        hs = at + 1
    end
    mut port_at := 0 - 1
    if hs < stop and _ub(bp, hs) == 91:
        close := _index_from(raw, 93, hs, stop)
        if close < 0:
            throw _url_err(raw, ErrorKind.Syntax, "missing ']' after the IPv6 address", hs)
        end
        if close == hs + 1:
            throw _url_err(raw, ErrorKind.Syntax, "empty IPv6 address", hs)
        end
        mut j := hs + 1
        until j < close:
            code := _ub(bp, j)
            if _hexval(code) < 0 and code != 58 and code != 46:
                throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code) + " in IPv6 address", j)
            end
            j++
        end
        u.host = raw.substr(hs + 1, close - hs - 1)
        if close + 1 < stop:
            if _ub(bp, close + 1) != 58:
                throw _url_err(raw, ErrorKind.Syntax, "unexpected " + _byte_desc(_ub(bp, close + 1)) + " after the IPv6 address", close + 1)
            end
            port_at = close + 1
        end
    else:
        port_at = _index_from(raw, 58, hs, stop)
        mut he := stop
        if port_at >= 0: he = port_at end
        try _check_name(raw, hs, he, "host", false)
        u.host = raw.substr(hs, he - hs)
    end
    if port_at >= 0:
        u.port = try _parse_port(raw, port_at + 1, stop)
    end
end

func _remove_dots(p: str): str:
    if p.find("/.") < 0 and not p.starts_with("."):
        ret p
    end
    parts := p.split("/")
    defer parts.free()
    mut out := Vector {} as Vector<str>
    defer out.free()
    n := parts.Len()
    repeat n in i:
        seg := parts.get(i)
        if seg == ".":
            if i == n - 1: out.push("") end
        else seg == "..":
            if out.Len() > 1: _ := out.pop() end
            if i == n - 1: out.push("") end
        else:
            out.push(seg)
        end
    end
    mut r := ""
    repeat out.Len() in j:
        if j > 0: r += "/" end
        r += out.get(j)
    end
    if p.starts_with("/") and not r.starts_with("/"): r = "/" + r end
    ret r
end

func _path_dir(p: str): str:
    mut slash := 0 - 1
    mut i := p.Len() - 1
    until i >= 0:
        if p.substr(i, 1) == "/":
            slash = i
            i = 0 - 1
        else:
            i--
        end
    end
    if slash < 0: ret "" end
    ret p.substr(0, slash + 1)
end

@en "Parse"
@fa "تجزیه نشانی"
pub func Parse(raw: str): URL throws:
    n := raw.Len()
    if n == 0:
        throw _url_err(raw, ErrorKind.InvalidArgument, "empty URL", 0)
    end
    bp := _bp(raw)
    repeat n in i:
        code := _ub(bp, i)
        if code <= 32 or code == 127:
            throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code), i)
        end
    end
    mut u := URL {}
    mut stop := n
    hash := _index_from(raw, 35, 0, n)
    if hash >= 0:
        try _check_escapes(raw, hash + 1, n)
        u.fragment = raw.substr(hash + 1, n - hash - 1)
        stop = hash
    end
    q := _index_from(raw, 63, 0, stop)
    if q >= 0:
        try _check_escapes(raw, q + 1, stop)
        u.raw_query = raw.substr(q + 1, stop - q - 1)
        stop = q
    end
    mut pos := 0
    mut has_authority := false
    before_stop := raw.substr(0, stop)
    scheme_end := before_stop.find("://")
    mem.Free(before_stop as void*)
    if scheme_end >= 0 and _index_from(raw, 47, 0, scheme_end) < 0:
        try _check_scheme(raw, scheme_end)
        u.scheme = raw.substr(0, scheme_end)
        pos = scheme_end + 3
        has_authority = true
    else stop >= 2 and _ub(bp, 0) == 47 and _ub(bp, 1) == 47:
        pos = 2
        has_authority = true
    end
    if has_authority:
        mut aend := _index_from(raw, 47, pos, stop)
        if aend < 0: aend = stop end
        try _parse_authority(raw, pos, aend, u)
        if u.host == "" and str.Lower(u.scheme) != "file":
            throw _url_err(raw, ErrorKind.Syntax, "missing host", pos)
        end
        pos = aend
    end
    try _check_escapes(raw, pos, stop)
    u.path = raw.substr(pos, stop - pos)
    ret u
end

@en "HostPort"
@fa "میزبان با درگاه"
pub func HostPort(u: URL): str:
    mut h := u.host
    if h.find(":") >= 0:
        h = "[" + h + "]"
    end
    if u.port != 0:
        ret h + ":" + str.FromInt(u.port as i64)
    end
    ret h
end

@en "String"
@fa "متن"
pub func String(u: URL): str:
    mut out := ""
    mut has_authority := u.host.Len() > 0
    if u.scheme.Len() > 0:
        out += u.scheme + "://"
        has_authority = true
    else has_authority:
        out += "//"
    end
    if has_authority:
        if u.userinfo.Len() > 0:
            out += u.userinfo + "@"
        end
        out += HostPort(u)
    end
    out += u.path
    if u.raw_query.Len() > 0:
        out += "?" + u.raw_query
    end
    if u.fragment.Len() > 0:
        out += "#" + u.fragment
    end
    ret out
end

@en "DecodedPath"
@fa "مسیر کدگشایی‌شده"
pub func DecodedPath(u: URL): str throws:
    ret try _pct_decode_no_plus(u.path)
end

@en "DecodedUserinfo"
@fa "اطلاعات کاربر کدگشایی‌شده"
pub func DecodedUserinfo(u: URL): str throws:
    ret try _pct_decode_no_plus(u.userinfo)
end

@en "EncodePathSegment"
@fa "کدگذاری بخش مسیر"
pub func EncodePathSegment(s: str): str:
    n := s.Len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        code := _ub(bp, i)
        if _path_seg_safe(code):
            str.BufAppendChar(sb, code)
        else:
            str.BufAppendChar(sb, 37)
            str.BufAppendChar(sb, _hexdigit(code / 16))
            str.BufAppendChar(sb, _hexdigit(code % 16))
        end
        i++
    end
    ret str.BufStr(sb)
end

@en "Query"
@fa "پرس‌وجو"
pub func Query(u: URL): query.QueryMap throws:
    ret try query.Decode(u.raw_query)
end

@en "SetQuery"
@fa "تنظیم پرس‌وجو"
pub func SetQuery(u &: URL, q: query.QueryMap):
    u.raw_query = query.Encode(q)
end

@en "Join"
@fa "پیوستن نشانی"
pub func Join(base: URL, ref: str): URL throws:
    if ref.Len() == 0: ret base end
    r := try Parse(ref)
    if r.scheme.Len() > 0: ret r end
    if r.host.Len() > 0:
        mut out := r
        out.scheme = base.scheme
        ret out
    end
    mut u := base
    u.fragment = r.fragment
    if r.path.Len() == 0:
        if ref.starts_with("?"): u.raw_query = r.raw_query end
        ret u
    end
    u.raw_query = r.raw_query
    if r.path.starts_with("/"):
        u.path = _remove_dots(r.path)
    else:
        mut dir := _path_dir(base.path)
        if dir == "" and base.host.Len() > 0: dir = "/" end
        u.path = _remove_dots(dir + r.path)
    end
    ret u
end
