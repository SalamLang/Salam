package url

import str
import encoding.query

const _SUFFIX2 := " co.uk ac.uk gov.uk org.uk net.uk sch.uk ltd.uk plc.uk me.uk com.au net.au org.au edu.au gov.au id.au co.nz net.nz org.nz govt.nz ac.nz co.za org.za web.za com.br net.br org.br gov.br edu.br com.cn net.cn org.cn gov.cn edu.cn com.mx org.mx net.mx com.ar net.ar org.ar com.tr net.tr org.tr gov.tr co.jp ne.jp or.jp ac.jp go.jp co.kr or.kr ne.kr go.kr co.in net.in org.in gov.in ac.in com.sg com.hk org.hk com.tw com.my org.my com.ph com.vn co.il org.il com.pk com.eg com.sa com.ua co.id or.id com.ng com.gh co.ke co.th in.th com.pe com.co com.ec com.uy com.py com.bo com.ve "

func _is_suffix2(s: str): bool:
    ret str.Contains(_SUFFIX2, " ".concat(s).concat(" "))
end

func _all_digits(s: str): bool:
    if s.len() == 0: ret false end
    bp := _bp(s)
    repeat s.len() with i:
        if str.IsAsciiDigit(_ub(bp, i)) == false: ret false end
    end
    ret true
end

func _join_range(labels: Vector<str>, start: int, endx: int): str:
    mut out := ""
    mut i := start
    until i < endx:
        if i > start: out = out.concat(".") end
        out = out.concat(labels.get(i))
        i += 1
    end
    ret out
end

func _suffix_len(labels: Vector<str>): int:
    n := labels.len()
    if n >= 3:
        last2 := labels.get(n - 2).concat(".").concat(labels.get(n - 1))
        if _is_suffix2(last2): ret 2 end
    end
    ret 1
end

func _rebuild_query(u &: URL, q: query.QueryMap):
    u.raw_query = query.Encode(q)
end

@en "Hostname"
@fa "نام میزبان"
@ar "اسم المضیف"
pub func Hostname(u: URL): str:
    ret u.host
end

@en "IsIP"
@fa "نشانی عددی است"
@ar "عنوان رقمی"
pub func IsIP(u: URL): bool:
    if u.host.len() == 0: ret false end
    if u.host.find(":") >= 0: ret true end
    parts := u.host.split(".")
    defer parts.free()
    if parts.len() != 4: ret false end
    mut ok := true
    repeat parts.len() with i:
        if _all_digits(parts.get(i)) == false: ok = false end
    end
    ret ok
end

@en "Labels"
@fa "برچسب‌های میزبان"
@ar "مقاطع المضیف"
pub func Labels(u: URL): Vector<str>:
    ret u.host.split(".")
end

@en "PublicSuffix"
@fa "پسوند عمومی"
@ar "اللاحقة العامة"
pub func PublicSuffix(u: URL): str:
    if IsIP(u): ret "" end
    labels := u.host.split(".")
    defer labels.free()
    n := labels.len()
    if n < 2: ret "" end
    ret _join_range(labels, n - _suffix_len(labels), n)
end

@en "Domain"
@fa "دامنه"
@ar "النطاق"
pub func Domain(u: URL): str:
    if IsIP(u): ret u.host end
    labels := u.host.split(".")
    defer labels.free()
    n := labels.len()
    if n < 2: ret u.host end
    take := _suffix_len(labels) + 1
    if n <= take: ret u.host end
    ret _join_range(labels, n - take, n)
end

@en "Subdomain"
@fa "زیردامنه"
@ar "النطاق الفرعی"
pub func Subdomain(u: URL): str:
    if IsIP(u): ret "" end
    labels := u.host.split(".")
    defer labels.free()
    n := labels.len()
    take := _suffix_len(labels) + 1
    if n <= take: ret "" end
    ret _join_range(labels, 0, n - take)
end

@en "RemoveParam"
@fa "حذف پارامتر"
@ar "إزالة معامل"
pub func RemoveParam(u &: URL, key: str): bool:
    mut q := query.Decode(u.raw_query)
    ok := query.Remove(q, key)
    _rebuild_query(u, q)
    ret ok
end

@en "SetParam"
@fa "تنظیم پارامتر"
@ar "تعیین معامل"
pub func SetParam(u &: URL, key: str, val: str):
    mut q := query.Decode(u.raw_query)
    query.Set(q, key, val)
    _rebuild_query(u, q)
end

@en "KeepParams"
@fa "نگه داشتن پارامترها"
@ar "إبقاء المعاملات"
pub func KeepParams(u &: URL, keep: Vector<str>):
    mut q := query.Decode(u.raw_query)
    query.Retain(q, keep)
    _rebuild_query(u, q)
end

@en "ClearQuery"
@fa "پاک کردن پرس‌وجو"
@ar "مسح الاستعلام"
pub func ClearQuery(u &: URL):
    u.raw_query = ""
end

@en "ParamNames"
@fa "نام پارامترها"
@ar "أسماء المعاملات"
pub func ParamNames(u: URL): Vector<str>:
    q := query.Decode(u.raw_query)
    ret query.Keys(q)
end
