package uuid

import str

func _hex_digit(n: int, upper: bool): int:
    if n < 10: ret 48 + n end
    if upper: ret 55 + n end
    ret 87 + n
end

func _put_hex(b &: str.StringBuilder, v: u64, digits: int, upper: bool):
    mut k := digits - 1
    until k >= 0:
        d := ((v >> ((k * 4) as u64)) & (15 as u64)) as int
        str.BufAppendChar(b, _hex_digit(d, upper))
        k--
    end
end

func _format(u: UUID, upper: bool, hyphens: bool): str:
    mut b := str.NewBuilder()
    _put_hex(b, u.hi >> (32 as u64), 8, upper)
    if hyphens: str.BufAppendChar(b, 45) end
    _put_hex(b, (u.hi >> (16 as u64)) & (65535 as u64), 4, upper)
    if hyphens: str.BufAppendChar(b, 45) end
    _put_hex(b, u.hi & (65535 as u64), 4, upper)
    if hyphens: str.BufAppendChar(b, 45) end
    _put_hex(b, u.lo >> (48 as u64), 4, upper)
    if hyphens: str.BufAppendChar(b, 45) end
    _put_hex(b, u.lo & (0xFFFFFFFFFFFF as u64), 12, upper)
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

@en "String"
@fa "به متن"
pub func String(u: UUID): str:
    ret _format(u, false, true)
end

@en "Upper"
@fa "به متن بزرگ"
pub func Upper(u: UUID): str:
    ret _format(u, true, true)
end

@en "Compact"
@fa "به متن فشرده"
pub func Compact(u: UUID): str:
    ret _format(u, false, false)
end

@en "Braced"
@fa "به متن آکولادی"
pub func Braced(u: UUID): str:
    ret "{" + _format(u, false, true) + "}"
end

@en "URN"
@fa "به متن یو آر ان"
pub func URN(u: UUID): str:
    ret "urn:uuid:" + _format(u, false, true)
end
