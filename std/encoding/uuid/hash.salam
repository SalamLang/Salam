package uuid

import crypto
import mem

func _stamp(hi: u64, lo: u64, version: int): UUID:
    h := (hi & (0xFFFFFFFFFFFF0FFF as u64)) | ((version as u64) << (12 as u64))
    l := (lo & (0x3FFFFFFFFFFFFFFF as u64)) | (0x8000000000000000 as u64)
    ret UUID { hi = h, lo = l }
end

func _name_buffer(ns: UUID, name: str): void*:
    n := name.Len()
    buf := mem.Allocate((16 + n) as u64)
    ToBuffer(ns, buf)
    if n > 0:
        mem.Copy(((buf as i64) + 16) as void*, name as void*, n as u64)
    end
    ret buf
end

@en "Stamp"
@fa "مهر نسخه"
pub func Stamp(hi: u64, lo: u64, version: int): UUID:
    ret _stamp(hi, lo, version)
end

@en "NewV3"
@fa "ساخت نسخه۳"
pub func NewV3(ns: UUID, name: str): UUID:
    buf := _name_buffer(ns, name)
    out := mem.Allocate(16 as u64)
    crypto.Md5Bytes(buf, 16 + name.Len(), out)
    p := out as u8*
    r := _stamp(_be64(p, 0), _be64(p, 8), 3)
    mem.Free(out)
    mem.Free(buf)
    ret r
end

@en "NewV5"
@fa "ساخت نسخه۵"
pub func NewV5(ns: UUID, name: str): UUID:
    buf := _name_buffer(ns, name)
    out := mem.Allocate(20 as u64)
    crypto.Sha1Bytes(buf, 16 + name.Len(), out)
    p := out as u8*
    r := _stamp(_be64(p, 0), _be64(p, 8), 5)
    mem.Free(out)
    mem.Free(buf)
    ret r
end
