package uuid

const _NS_LO := 0x80B400C04FD430C8

func _namespace(hi: u64): UUID:
    ret UUID { hi = hi, lo = _NS_LO }
end

@en "NamespaceDNS"
@fa "فضای نام دی ان اس"
pub func NamespaceDNS(): UUID:
    ret _namespace(0x6BA7B8109DAD11D1 as u64)
end

@en "NamespaceURL"
@fa "فضای نام یو آر ال"
pub func NamespaceURL(): UUID:
    ret _namespace(0x6BA7B8119DAD11D1 as u64)
end

@en "NamespaceOID"
@fa "فضای نام او آی دی"
pub func NamespaceOID(): UUID:
    ret _namespace(0x6BA7B8129DAD11D1 as u64)
end

@en "NamespaceX500"
@fa "فضای نام ایکس۵۰۰"
pub func NamespaceX500(): UUID:
    ret _namespace(0x6BA7B8149DAD11D1 as u64)
end
