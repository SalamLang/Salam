package uuid

import os
import str

@en "ParseResult"
@fa "نتیجه تجزیه"
pub struct ParseResult:
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
    @en "id"
    @fa "مقدار"
    pub id: UUID = UUID {}
    @en "error"
    @fa "خطا"
    pub error: str = ""
end

func _hex_value(c: int): int:
    if c >= 48 and c <= 57: ret c - 48 end
    if c >= 97 and c <= 102: ret c - 87 end
    if c >= 65 and c <= 70: ret c - 55 end
    ret 0 - 1
end

func _lower(c: int): int:
    if c >= 65 and c <= 90: ret c + 32 end
    ret c
end

func _has_urn_prefix(p: u8*): bool:
    want := "urn:uuid:" as u8*
    repeat 9 in i:
        if _lower(p[i] as int) != (want[i] as int): ret false end
    end
    ret true
end

func _fail(msg: str): ParseResult:
    ret ParseResult { ok = false, id = UUID {}, error = msg }
end

func _parse_digits(p: u8*, start: int, n: int, hyphens: bool): ParseResult:
    mut hi := 0 as u64
    mut lo := 0 as u64
    mut count := 0
    repeat n in i:
        c := p[start + i] as int
        if hyphens and (i == 8 or i == 13 or i == 18 or i == 23):
            if c != 45: ret _fail("uuid: expected a hyphen at position " + str.FromInt((start + i) as i64)) end
        else:
            v := _hex_value(c)
            if v < 0: ret _fail("uuid: invalid character at position " + str.FromInt((start + i) as i64)) end
            if count < 16:
                hi = (hi << (4 as u64)) | (v as u64)
            else:
                lo = (lo << (4 as u64)) | (v as u64)
            end
            count++
        end
    end
    ret ParseResult { ok = true, id = UUID { hi = hi, lo = lo }, error = "" }
end

@en "Parse"
@fa "تجزیه"
pub func Parse(s: str): ParseResult:
    n := s.Len()
    p := s as u8*
    if n == 36: ret _parse_digits(p, 0, 36, true) end
    if n == 32: ret _parse_digits(p, 0, 32, false) end
    if n == 38:
        if p[0] as int != 123 or p[37] as int != 125: ret _fail("uuid: braces expected around a 36 character uuid") end
        ret _parse_digits(p, 1, 36, true)
    end
    if n == 45:
        if not _has_urn_prefix(p): ret _fail("uuid: the prefix urn:uuid: was expected") end
        ret _parse_digits(p, 9, 36, true)
    end
    ret _fail("uuid: invalid length " + str.FromInt(n as i64))
end

@en "ParseOr"
@fa "تجزیه با پیش فرض"
pub func ParseOr(s: str, fallback: UUID): UUID:
    r := Parse(s)
    if r.ok: ret r.id end
    ret fallback
end

@en "IsValid"
@fa "معتبر است"
pub func IsValid(s: str): bool:
    ret Parse(s).ok
end

@en "MustParse"
@fa "تجزیه الزامی"
pub func MustParse(s: str): UUID:
    r := Parse(s)
    if not r.ok:
        printerrln r.error
        os.Exit(2)
    end
    ret r.id
end
