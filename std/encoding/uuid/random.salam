package uuid

func _random_uuid(): UUID:
    mut a := 0 as u64
    mut b := 0 as u64
    _random_pair(a, b)
    ret UUID { hi = a, lo = b }
end

@en "FromV4Parts"
@fa "نسخه۴ از اجزا"
pub func FromV4Parts(hi: u64, lo: u64): UUID:
    ret _stamp(hi, lo, 4)
end

@en "FromV7Parts"
@fa "نسخه۷ از اجزا"
pub func FromV7Parts(unix_ms: i64, rand_a: u64, rand_b: u64): UUID:
    hi := (((unix_ms as u64) & (0xFFFFFFFFFFFF as u64)) << (16 as u64)) | ((7 as u64) << (12 as u64)) | (rand_a & (0xFFF as u64))
    lo := (0x8000000000000000 as u64) | (rand_b & (0x3FFFFFFFFFFFFFFF as u64))
    ret UUID { hi = hi, lo = lo }
end

@en "FromV8Parts"
@fa "نسخه۸ از اجزا"
pub func FromV8Parts(custom_a: u64, custom_b: u64, custom_c: u64): UUID:
    hi := ((custom_a & (0xFFFFFFFFFFFF as u64)) << (16 as u64)) | ((8 as u64) << (12 as u64)) | (custom_b & (0xFFF as u64))
    lo := (0x8000000000000000 as u64) | (custom_c & (0x3FFFFFFFFFFFFFFF as u64))
    ret UUID { hi = hi, lo = lo }
end

@en "NewV4"
@fa "ساخت نسخه۴"
pub func NewV4(): UUID:
    r := _random_uuid()
    ret _stamp(r.hi, r.lo, 4)
end

@en "NewV7"
@fa "ساخت نسخه۷"
pub func NewV7(): UUID:
    mut a := 0 as u64
    mut b := 0 as u64
    _random_pair(a, b)
    mut ms := 0 as i64
    mut ctr := 0 as u64
    _next_v7(ms, ctr, a)
    rand_a := ctr >> (30 as u64)
    rand_b := ((ctr & (0x3FFFFFFF as u64)) << (32 as u64)) | (b & (0xFFFFFFFF as u64))
    ret FromV7Parts(ms, rand_a, rand_b)
end

@en "NewV8"
@fa "ساخت نسخه۸"
pub func NewV8(hi: u64, lo: u64): UUID:
    ret _stamp(hi, lo, 8)
end
