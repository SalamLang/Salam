package uuid

import str

const _B64 := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
const _B32 := "abcdefghijklmnopqrstuvwxyz234567"

func _bit(u: UUID, pos: int): int:
    if pos >= 128: ret 0 end
    if pos < 64: ret ((u.hi >> ((63 - pos) as u64)) & (1 as u64)) as int end
    ret ((u.lo >> ((127 - pos) as u64)) & (1 as u64)) as int
end

func _encode_bits(u: UUID, bits: int, alphabet: str): str:
    chars := (128 + bits - 1) / bits
    letters := alphabet as u8*
    mut b := str.NewBuilder()
    repeat chars in k:
        mut v := 0
        repeat bits in j:
            v = (v << 1) | _bit(u, k * bits + j)
        end
        str.BufAppendChar(b, letters[v] as int)
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func _index_of(alphabet: str, c: int): int:
    letters := alphabet as u8*
    repeat alphabet.Len() in i:
        if letters[i] as int == c: ret i end
    end
    ret 0 - 1
end

func _decode_bits(s: str, bits: int, alphabet: str, name: str, fold: bool): ParseResult:
    chars := (128 + bits - 1) / bits
    if s.Len() != chars: ret _fail("uuid: " + name + " text must have " + str.FromInt(chars as i64) + " characters") end
    p := s as u8*
    mut hi := 0 as u64
    mut lo := 0 as u64
    repeat chars in k:
        mut c := p[k] as int
        if fold: c = _lower(c) end
        v := _index_of(alphabet, c)
        if v < 0: ret _fail("uuid: invalid " + name + " character at position " + str.FromInt(k as i64)) end
        repeat bits in j:
            pos := k * bits + j
            bit := (v >> (bits - 1 - j)) & 1
            if pos >= 128:
                if bit != 0: ret _fail("uuid: the padding bits of the " + name + " text must be zero") end
            else:
                if pos < 64:
                    hi |= (bit as u64) << ((63 - pos) as u64)
                else:
                    lo |= (bit as u64) << ((127 - pos) as u64)
                end
            end
        end
    end
    ret ParseResult { ok = true, id = UUID { hi = hi, lo = lo }, error = "" }
end

@en "Base64URL"
@fa "پایه۶۴ آدرس"
pub func Base64URL(u: UUID): str:
    ret _encode_bits(u, 6, _B64)
end

@en "FromBase64URL"
@fa "از پایه۶۴ آدرس"
pub func FromBase64URL(s: str): ParseResult:
    ret _decode_bits(s, 6, _B64, "base64url", false)
end

@en "Base32"
@fa "پایه۳۲"
pub func Base32(u: UUID): str:
    ret _encode_bits(u, 5, _B32)
end

@en "FromBase32"
@fa "از پایه۳۲"
pub func FromBase32(s: str): ParseResult:
    ret _decode_bits(s, 5, _B32, "base32", true)
end
