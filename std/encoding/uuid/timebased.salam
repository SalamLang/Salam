package uuid

const _TS_MASK := 0x0FFFFFFFFFFFFFFF
const _SEQ_MASK := 0x3FFF
const _NODE_MASK := 0xFFFFFFFFFFFF

func _clock_tail(seq: u64, node: u64): u64:
    ret ((0x8000 as u64) | (seq & (_SEQ_MASK as u64))) << (48 as u64) | (node & (_NODE_MASK as u64))
end

func _v1_timestamp(u: UUID): u64:
    low := u.hi >> (32 as u64)
    mid := (u.hi >> (16 as u64)) & (0xFFFF as u64)
    high := u.hi & (0xFFF as u64)
    ret (high << (48 as u64)) | (mid << (32 as u64)) | low
end

func _v6_timestamp(u: UUID): u64:
    ret ((u.hi >> (16 as u64)) << (12 as u64)) | (u.hi & (0xFFF as u64))
end

@en "FromV1Parts"
@fa "نسخه۱ از اجزا"
pub func FromV1Parts(ts: i64, clock_seq: int, node: i64): UUID:
    t := (ts as u64) & (_TS_MASK as u64)
    low := t & (0xFFFFFFFF as u64)
    mid := (t >> (32 as u64)) & (0xFFFF as u64)
    high := t >> (48 as u64)
    hi := (low << (32 as u64)) | (mid << (16 as u64)) | (1 as u64) << (12 as u64) | high
    ret UUID { hi = hi, lo = _clock_tail(clock_seq as u64, node as u64) }
end

@en "FromV6Parts"
@fa "نسخه۶ از اجزا"
pub func FromV6Parts(ts: i64, clock_seq: int, node: i64): UUID:
    t := (ts as u64) & (_TS_MASK as u64)
    hi := ((t >> (12 as u64)) << (16 as u64)) | ((6 as u64) << (12 as u64)) | (t & (0xFFF as u64))
    ret UUID { hi = hi, lo = _clock_tail(clock_seq as u64, node as u64) }
end

@en "NewV1"
@fa "ساخت نسخه۱"
pub func NewV1(): UUID:
    mut ts := 0 as i64
    mut seq := 0 as u64
    mut node := 0 as u64
    _next_v1(ts, seq, node)
    ret FromV1Parts(ts, seq as int, node as i64)
end

@en "NewV1WithNode"
@fa "ساخت نسخه۱ با گره"
pub func NewV1WithNode(node: i64): UUID:
    mut ts := 0 as i64
    mut seq := 0 as u64
    mut other := 0 as u64
    _next_v1(ts, seq, other)
    ret FromV1Parts(ts, seq as int, node)
end

@en "NewV6"
@fa "ساخت نسخه۶"
pub func NewV6(): UUID:
    mut ts := 0 as i64
    mut seq := 0 as u64
    mut node := 0 as u64
    _next_v1(ts, seq, node)
    ret FromV6Parts(ts, seq as int, node as i64)
end

@en "HasTime"
@fa "زمان دارد"
pub func HasTime(u: UUID): bool:
    v := Version(u)
    ret Variant(u) == VARIANT_RFC and (v == 1 or v == 6 or v == 7)
end

@en "Timestamp"
@fa "برچسب زمانی"
pub func Timestamp(u: UUID): i64:
    v := Version(u)
    if v == 1: ret _v1_timestamp(u) as i64 end
    if v == 6: ret _v6_timestamp(u) as i64 end
    ret 0
end

@en "UnixNanos"
@fa "نانو ثانیه یونیکس"
pub func UnixNanos(u: UUID): i64:
    v := Version(u)
    if v == 1 or v == 6: ret (Timestamp(u) - _GREG_OFFSET) * 100 end
    if v == 7: ret ((u.hi >> (16 as u64)) as i64) * 1000000 end
    ret 0
end

@en "UnixMillis"
@fa "میلی ثانیه یونیکس"
pub func UnixMillis(u: UUID): i64:
    ret UnixNanos(u) / 1000000
end

@en "ClockSequence"
@fa "دنباله ساعت"
pub func ClockSequence(u: UUID): int:
    v := Version(u)
    if v == 1 or v == 6: ret ((u.lo >> (48 as u64)) & (_SEQ_MASK as u64)) as int end
    ret 0
end

@en "Node"
@fa "گره"
pub func Node(u: UUID): i64:
    v := Version(u)
    if v == 1 or v == 6: ret (u.lo & (_NODE_MASK as u64)) as i64 end
    ret 0
end
