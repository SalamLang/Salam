package uuid

@en "VARIANT_NCS"
@fa "گونه قدیمی"
pub const VARIANT_NCS := 0
@en "VARIANT_RFC"
@fa "گونه استاندارد"
pub const VARIANT_RFC := 1
@en "VARIANT_MICROSOFT"
@fa "گونه مایکروسافت"
pub const VARIANT_MICROSOFT := 2
@en "VARIANT_FUTURE"
@fa "گونه آینده"
pub const VARIANT_FUTURE := 3

@en "UUID"
@fa "شناسه"
pub struct UUID:
    @en "hi"
    @fa "نیمه بالا"
    pub hi: u64 = 0
    @en "lo"
    @fa "نیمه پایین"
    pub lo: u64 = 0

    @en "to_str"
    @fa "به متن"
    pub func to_str(): str:
        ret String(UUID { hi = this.hi, lo = this.lo })
    end
end

func _byte_at(u: UUID, i: int): int:
    if i < 8:
        ret ((u.hi >> ((56 - i * 8) as u64)) & (255 as u64)) as int
    end
    ret ((u.lo >> ((56 - (i - 8) * 8) as u64)) & (255 as u64)) as int
end

func _be64(p: u8*, off: int): u64:
    mut v := 0 as u64
    repeat 8 in i:
        v = (v << (8 as u64)) | (p[off + i] as u64)
    end
    ret v
end

@en "Nil"
@fa "شناسه تهی"
pub func Nil(): UUID:
    ret UUID { hi = 0 as u64, lo = 0 as u64 }
end

@en "Max"
@fa "شناسه بیشینه"
pub func Max(): UUID:
    ret UUID { hi = 0xFFFFFFFFFFFFFFFF as u64, lo = 0xFFFFFFFFFFFFFFFF as u64 }
end

@en "IsNil"
@fa "شناسه تهی است"
pub func IsNil(u: UUID): bool:
    ret u.hi == (0 as u64) and u.lo == (0 as u64)
end

@en "IsMax"
@fa "شناسه بیشینه است"
pub func IsMax(u: UUID): bool:
    ret u.hi == (0xFFFFFFFFFFFFFFFF as u64) and u.lo == (0xFFFFFFFFFFFFFFFF as u64)
end

@en "Equal"
@fa "یکسان است"
pub func Equal(a: UUID, b: UUID): bool:
    ret a.hi == b.hi and a.lo == b.lo
end

@en "Compare"
@fa "مقایسه"
pub func Compare(a: UUID, b: UUID): int:
    if a.hi < b.hi: ret 0 - 1 end
    if a.hi > b.hi: ret 1 end
    if a.lo < b.lo: ret 0 - 1 end
    if a.lo > b.lo: ret 1 end
    ret 0
end

@en "Less"
@fa "پیش از"
pub func Less(a: UUID, b: UUID): bool:
    ret Compare(a, b) < 0
end

@en "Version"
@fa "نسخه"
pub func Version(u: UUID): int:
    ret ((u.hi >> (12 as u64)) & (15 as u64)) as int
end

@en "Variant"
@fa "رده"
pub func Variant(u: UUID): int:
    top := (u.lo >> (61 as u64)) as int
    if top < 4: ret VARIANT_NCS end
    if top < 6: ret VARIANT_RFC end
    if top < 7: ret VARIANT_MICROSOFT end
    ret VARIANT_FUTURE
end

@en "Byte"
@fa "بایت"
pub func Byte(u: UUID, i: int): int:
    if i < 0 or i > 15: ret 0 end
    ret _byte_at(u, i)
end

@en "Bytes"
@fa "بایت ها"
pub func Bytes(u: UUID): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    repeat 16 in i:
        v.push(_byte_at(u, i) as u8)
    end
    ret v
end

@en "FromBytes"
@fa "از بایت ها"
pub func FromBytes(b: Vector<u8>): UUID:
    if b.len() != 16: ret Nil() end
    mut hi := 0 as u64
    mut lo := 0 as u64
    repeat 8 in i:
        hi = (hi << (8 as u64)) | (b.get(i) as u64)
        lo = (lo << (8 as u64)) | (b.get(i + 8) as u64)
    end
    ret UUID { hi = hi, lo = lo }
end

@en "ToBuffer"
@fa "نوشتن به حافظه"
pub func ToBuffer(u: UUID, out: void*):
    p := out as u8*
    repeat 16 in i:
        p[i] = _byte_at(u, i) as u8
    end
end

@en "FromBuffer"
@fa "خواندن از حافظه"
pub func FromBuffer(src: void*): UUID:
    p := src as u8*
    ret UUID { hi = _be64(p, 0), lo = _be64(p, 8) }
end
