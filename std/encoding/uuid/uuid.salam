@en "uuid"
@fa "یو یو آی دی"
package uuid

@en "New"
@fa "جدید"
pub func New(): UUID:
    ret NewV4()
end

@en "NewString"
@fa "متن جدید"
pub func NewString(): str:
    ret String(NewV4())
end

@en "Batch"
@fa "دسته"
pub func Batch(n: int): Vector<UUID>:
    mut v := Vector {} as Vector<UUID>
    repeat n:
        v.push(NewV4())
    end
    ret v
end

@en "BatchV7"
@fa "دسته نسخه۷"
pub func BatchV7(n: int): Vector<UUID>:
    mut v := Vector {} as Vector<UUID>
    repeat n:
        v.push(NewV7())
    end
    ret v
end
