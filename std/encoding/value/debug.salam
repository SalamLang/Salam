package value

import conv

// ToDebugString - a debug rendering for test output/troubleshooting. This is
// NOT valid JSON (values are tagged with their kind) - use encoding.json's
// Encode for a real JSON string.
pub func ToDebugString(v: Value): str:
    if v.kind == KindNull: ret "null" end
    if v.kind == KindBool:
        if v.b: ret "bool(true)" end
        ret "bool(false)"
    end
    if v.kind == KindInt: ret "int(" + conv.FormatInt(v.i) + ")" end
    if v.kind == KindFloat: ret "float(" + conv.FormatFloat(v.n) + ")" end
    if v.kind == KindString: ret "string(" + v.s + ")" end
    if v.kind == KindArray:
        mut out := "array["
        mut i := 0
        until i < v.arr.len():
            if i > 0: out = out + ", " end
            out = out + ToDebugString(v.arr.get(i)[0])
            i += 1
        end
        ret out + "]"
    end
    if v.kind == KindObject:
        mut out := "object{"
        mut it := v.obj.iter()
        mut first := true
        until it.has_next():
            if !first: out = out + ", " end
            first = false
            out = out + it.key() + ": " + ToDebugString(it.value())
            it.next()
        end
        ret out + "}"
    end
    ret "?"
end
