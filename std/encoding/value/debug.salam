package value

import conv

pub func ToDebugString(v: Value): str:
    if v.kind == KindNull: ret "null" end
    if v.kind == KindBool:
        if v.b: ret "bool(true)" end
        ret "bool(false)"
    end
    if v.kind == KindInt: ret "int(" + conv.FormatInt(v.i) + ")" end
    if v.kind == KindFloat:
        if SALAM_KERNEL:
            ret "float(?)"
        else:
            ret "float(" + conv.FormatFloat(v.n) + ")"
        end
    end
    if v.kind == KindString: ret "string(" + v.s + ")" end
    if v.kind == KindArray:
        mut out := "array["
        mut i := 0
        until i < v.arr.len():
            if i > 0: out = out + ", " end
            out = out + ToDebugString(v.arr.get(i))
            i += 1
        end
        ret out + "]"
    end
    if v.kind == KindObject:
        mut out := "object{"
        mut it := v.obj.iter()
        mut first := true
        until it.has_next():
            if !first: out = out + ", " end
            first = false
            out = out + it.key() + ": " + ToDebugString(it.value())
            it.next()
        end
        ret out + "}"
    end
    ret "?"
end
