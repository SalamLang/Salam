package value

import conv

@en "ToDebugString"
@fa "رشته اشکال زدایی"
pub func ToDebugString(v: Value): str:
    if v.kind == KindNull: ret "null" end
    if v.kind == KindBool:
        if v.b: ret "bool(true)" end
        ret "bool(false)"
    end
    if v.kind == KindInt: ret "int(" + conv.FormatInt(v.i) + ")" end
    if v.kind == KindFloat:
        if SALAM_KERNEL:
            ret "float(?)"
        else:
            ret "float(" + conv.FormatFloat(v.n) + ")"
        end
    end
    if v.kind == KindString: ret "string(" + v.s + ")" end
    if v.kind == KindBytes: ret "bytes(" + conv.FormatInt(v.bin.Len() as i64) + ")" end
    if v.kind == KindExt: ret "ext(" + conv.FormatInt(v.i) + ", " + conv.FormatInt(v.bin.Len() as i64) + ")" end
    if v.kind == KindArray:
        mut out := "array["
        mut i := 0
        until i < v.arr.Len():
            if i > 0: out += ", " end
            out += ToDebugString(v.arr.Get(i))
            i++
        end
        ret out + "]"
    end
    if v.kind == KindObject:
        mut out := "object{"
        keys := ObjectKeys(v)
        repeat keys.Len() in i:
            if i > 0: out += ", " end
            k := keys.Get(i)
            out = out + k + ": " + ToDebugString(v.obj.Get(k))
        end
        ret out + "}"
    end
    ret "?"
end
