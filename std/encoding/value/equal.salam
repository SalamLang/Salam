package value

func _bin_equal(a: Vector<u8>, b: Vector<u8>): bool:
    if a.Len() != b.Len(): ret false end
    mut i := 0
    until i < a.Len():
        if a.Get(i) != b.Get(i): ret false end
        i++
    end
    ret true
end

@en "Equal"
@fa "یکسان است"
pub func Equal(a: Value, b: Value): bool:
    if a.kind != b.kind: ret false end
    if a.kind == KindNull: ret true end
    if a.kind == KindBool: ret a.b == b.b end
    if a.kind == KindInt: ret a.i == b.i end
    if a.kind == KindFloat: ret a.n == b.n end
    if a.kind == KindString: ret a.s == b.s end
    if a.kind == KindBytes: ret _bin_equal(a.bin, b.bin) end
    if a.kind == KindExt: ret a.i == b.i and _bin_equal(a.bin, b.bin) end
    if a.kind == KindArray:
        if a.arr.Len() != b.arr.Len(): ret false end
        mut i := 0
        until i < a.arr.Len():
            if not Equal(a.arr.Get(i), b.arr.Get(i)): ret false end
            i++
        end
        ret true
    end
    if a.kind == KindObject:
        if a.obj.Size() != b.obj.Size(): ret false end
        mut it := a.obj.Iter()
        until it.HasNext():
            k := it.Key()
            if not b.obj.Has(k): ret false end
            if not Equal(it.Value(), b.obj.Get(k)): ret false end
            it.Next()
        end
        ret true
    end
    ret false
end
