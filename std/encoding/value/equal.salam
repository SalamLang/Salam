package value

// Equal - structural equality. Arrays are order-sensitive; objects are NOT
// (HashMap iteration order isn't guaranteed, and two objects built by
// inserting the same keys in a different order should still compare equal).
pub func Equal(a: Value, b: Value): bool:
    if a.kind != b.kind: ret false end
    if a.kind == KindNull: ret true end
    if a.kind == KindBool: ret a.b == b.b end
    if a.kind == KindInt: ret a.i == b.i end
    if a.kind == KindFloat: ret a.n == b.n end
    if a.kind == KindString: ret a.s == b.s end
    if a.kind == KindArray:
        if a.arr.len() != b.arr.len(): ret false end
        mut i := 0
        until i < a.arr.len():
            if !Equal(a.arr.get(i)[0], b.arr.get(i)[0]): ret false end
            i += 1
        end
        ret true
    end
    if a.kind == KindObject:
        if a.obj.size() != b.obj.size(): ret false end
        mut it := a.obj.iter()
        until it.has_next():
            k := it.key()
            if !b.obj.has(k): ret false end
            if !Equal(it.value(), b.obj.get(k)): ret false end
            it.next()
        end
        ret true
    end
    ret false
end
