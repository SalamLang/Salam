@en "value"
@fa "مقدار"
package value

import mem

@en "KindNull"
@fa "نوع تهی"
pub const KindNull := 0
@en "KindBool"
@fa "نوع منطقی"
pub const KindBool := 1
@en "KindInt"
@fa "نوع صحیح"
pub const KindInt := 2
@en "KindFloat"
@fa "نوع اعشاری"
pub const KindFloat := 3
@en "KindString"
@fa "نوع رشته"
pub const KindString := 4
@en "KindArray"
@fa "نوع آرایه"
pub const KindArray := 5
@en "KindObject"
@fa "نوع شیء"
pub const KindObject := 6

@en "Value"
@fa "مقدار"
pub struct Value:
    @en "kind"
    @fa "نوع"
    pub kind: int = KindNull
    @en "b"
    @fa "مقدار منطقی"
    pub b: bool = false
    @en "i"
    @fa "مقدار صحیح"
    pub i: i64 = 0
    @en "n"
    @fa "مقدار اعشاری"
    pub n: f64 = 0.0
    @en "s"
    @fa "مقدار رشته"
    pub s: str = ""
    @en "arr"
    @fa "عضوهای آرایه"
    pub arr: Vector<Value> = Vector {}
    @en "obj"
    @fa "عضوهای شیء"
    pub obj: HashMap<str, Value> = HashMap {} as HashMap<str, Value>
    @en "order"
    @fa "ترتیب کلیدها"
    pub order: i64 = 0
end

func _ord_new(): i64:
    h := mem.AllocateZeroed(24 as u64) as i64 *
    h[1] = 4 as i64
    h[2] = mem.Allocate(32 as u64) as i64
    ret h as i64
end

func _ord_len(o: i64): int:
    if o == (0 as i64): ret 0 end
    ret (o as i64 *)[0] as int
end

func _ord_at(o: i64, i: int): str:
    h := o as i64 *
    ret (((h[2] + (i as i64) * (8 as i64)) as i64 *)[0] as void *) as str
end

func _ord_push(o: i64, key: str):
    if o == (0 as i64): ret end
    h := o as i64 *
    if h[0] == h[1]:
        h[1] = h[1] * (2 as i64)
        h[2] = mem.Reallocate(h[2] as void *, (h[1] * (8 as i64)) as u64) as i64
    end
    slot := (h[2] + h[0] * (8 as i64)) as i64 *
    slot[0] = (key as void *) as i64
    h[0] = h[0] + (1 as i64)
end

func _ord_remove(o: i64, key: str):
    n := _ord_len(o)
    h := o as i64 *
    repeat n in i:
        if _ord_at(o, i) == key:
            mut j := i
            until j + 1 < n:
                dst := (h[2] + (j as i64) * (8 as i64)) as i64 *
                src := (h[2] + ((j + 1) as i64) * (8 as i64)) as i64 *
                dst[0] = src[0]
                j += 1
            end
            h[0] = h[0] - (1 as i64)
            ret
        end
    end
end

func _ord_free(o: i64):
    if o == (0 as i64): ret end
    h := o as i64 *
    mem.Free(h[2] as void *)
    mem.Free(o as void *)
end

@en "ValueNull"
@fa "مقدار تهی"
pub func ValueNull(): Value: ret Value { kind = KindNull } end
@en "ValueBool"
@fa "مقدار منطقی"
pub func ValueBool(b: bool): Value: ret Value { kind = KindBool, b = b } end
@en "ValueInt"
@fa "مقدار صحیح"
pub func ValueInt(i: i64): Value: ret Value { kind = KindInt, i = i } end
@en "ValueFloat"
@fa "مقدار اعشاری"
pub func ValueFloat(n: f64): Value: ret Value { kind = KindFloat, n = n } end
@en "ValueString"
@fa "مقدار رشته"
pub func ValueString(s: str): Value: ret Value { kind = KindString, s = s } end

@en "ValueArray"
@fa "مقدار آرایه"
pub func ValueArray(items: Vector<Value>): Value:
    mut v := Value { kind = KindArray }
    v.arr = items
    ret v
end

@en "ValueObject"
@fa "مقدار شیء"
pub func ValueObject(fields: HashMap<str, Value>): Value:
    mut v := Value { kind = KindObject, order = _ord_new() }
    v.obj = fields
    mut it := fields.iter()
    until it.has_next():
        _ord_push(v.order, it.key())
        it.next()
    end
    ret v
end

@en "NewValueArray"
@fa "آرایه جدید"
pub func NewValueArray(): Value:
    ret Value { kind = KindArray, arr = Vector {} as Vector<Value> }
end

@en "NewValueObject"
@fa "شیء جدید"
pub func NewValueObject(): Value:
    ret Value { kind = KindObject, obj = HashMap {} as HashMap<str, Value>, order = _ord_new() }
end

@en "IsNull"
@fa "تهی است"
pub func IsNull(v: Value): bool: ret v.kind == KindNull end
@en "IsBool"
@fa "منطقی است"
pub func IsBool(v: Value): bool: ret v.kind == KindBool end
@en "IsInt"
@fa "صحیح است"
pub func IsInt(v: Value): bool: ret v.kind == KindInt end
@en "IsFloat"
@fa "اعشاری است"
pub func IsFloat(v: Value): bool: ret v.kind == KindFloat end
@en "IsNumber"
@fa "عدد است"
pub func IsNumber(v: Value): bool: ret v.kind == KindInt or v.kind == KindFloat end
@en "IsString"
@fa "رشته است"
pub func IsString(v: Value): bool: ret v.kind == KindString end
@en "IsArray"
@fa "آرایه است"
pub func IsArray(v: Value): bool: ret v.kind == KindArray end
@en "IsObject"
@fa "شیء است"
pub func IsObject(v: Value): bool: ret v.kind == KindObject end

@en "AsBool"
@fa "به منطقی"
pub func AsBool(v: Value): bool: ret v.b end

@en "AsInt"
@fa "به صحیح"
pub func AsInt(v: Value): i64:
    if v.kind == KindFloat: ret v.n as i64 end
    ret v.i
end

@en "AsFloat"
@fa "به اعشاری"
pub func AsFloat(v: Value): f64:
    if v.kind == KindInt: ret v.i as f64 end
    ret v.n
end

@en "AsString"
@fa "به رشته"
pub func AsString(v: Value): str: ret v.s end

@en "ArrayLen"
@fa "طول آرایه"
pub func ArrayLen(v: Value): int: ret v.arr.len() end

@en "ArrayGet"
@fa "عضو آرایه"
pub func ArrayGet(v: Value, i: int): Value: ret v.arr.get(i) end

@en "ArraySet"
@fa "تنظیم عضو آرایه"
pub func ArraySet(v &: Value, i: int, item: Value): v.arr.set(i, item) end

@en "ArrayPush"
@fa "افزودن به آرایه"
pub func ArrayPush(v &: Value, item: Value): v.arr.push(item) end

@en "ObjectLen"
@fa "طول شیء"
pub func ObjectLen(v: Value): int: ret v.obj.size() end

@en "ObjectHas"
@fa "شیء دارد"
pub func ObjectHas(v: Value, key: str): bool: ret v.obj.has(key) end

@en "ObjectGet"
@fa "مقدار کلید"
pub func ObjectGet(v: Value, key: str): Value:
    if v.obj.has(key): ret v.obj.get(key) end
    ret ValueNull()
end

@en "ObjectGetOk"
@fa "مقدار کلید با وضعیت"
pub func ObjectGetOk(v: Value, key: str, ok &: bool): Value:
    ok = v.obj.has(key)
    if ok: ret v.obj.get(key) end
    ret ValueNull()
end

@en "ObjectSet"
@fa "تنظیم کلید"
pub func ObjectSet(v &: Value, key: str, item: Value):
    if not v.obj.has(key): _ord_push(v.order, key) end
    v.obj.put(key, item)
end

@en "ObjectDelete"
@fa "حذف کلید"
pub func ObjectDelete(v &: Value, key: str): bool:
    if not v.obj.remove(key): ret false end
    _ord_remove(v.order, key)
    ret true
end

@en "ObjectKeys"
@fa "کلیدهای شیء"
pub func ObjectKeys(v: Value): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut seen := HashMap {} as HashMap<str, bool>
    repeat _ord_len(v.order) in i:
        k := _ord_at(v.order, i)
        if v.obj.has(k) and not seen.has(k):
            out.push(k)
            seen.put(k, true)
        end
    end
    mut it := v.obj.iter()
    until it.has_next():
        k := it.key()
        if not seen.has(k):
            out.push(k)
        end
        it.next()
    end
    seen.free()
    ret out
end

@en "ValueClone"
@fa "رونوشت مقدار"
pub func ValueClone(v: Value): Value:
    if v.kind == KindArray:
        mut out := Vector {} as Vector<Value>
        mut i := 0
        until i < v.arr.len():
            out.push(ValueClone(v.arr.get(i)))
            i += 1
        end
        ret ValueArray(out)
    end
    if v.kind == KindObject:
        mut out := NewValueObject()
        keys := ObjectKeys(v)
        repeat keys.len() in i:
            k := keys.get(i)
            ObjectSet(out, k, ValueClone(v.obj.get(k)))
        end
        ret out
    end
    ret v
end

@en "ValueFree"
@fa "آزادسازی مقدار"
pub func ValueFree(v &: Value):
    if v.kind == KindArray:
        mut i := 0
        until i < v.arr.len():
            mut child := v.arr.get(i)
            ValueFree(child)
            i += 1
        end
        v.arr.free()
    else v.kind == KindObject:
        mut it := v.obj.iter()
        until it.has_next():
            mut child := it.value()
            ValueFree(child)
            it.next()
        end
        v.obj.free()
        _ord_free(v.order)
        v.order = 0 as i64
    end
end
