@en "value"
@fa "مقدار"
package value

import mem

@en "KindNull"
@fa "نوع تهی"
pub const KindNull := 0
@en "KindBool"
@fa "نوع منطقی"
pub const KindBool := 1
@en "KindInt"
@fa "نوع صحیح"
pub const KindInt := 2
@en "KindFloat"
@fa "نوع اعشاری"
pub const KindFloat := 3
@en "KindString"
@fa "نوع رشته"
pub const KindString := 4
@en "KindArray"
@fa "نوع آرایه"
pub const KindArray := 5
@en "KindObject"
@fa "نوع شیء"
pub const KindObject := 6

@en "Value"
@fa "مقدار"
pub struct Value:
    pub kind: int = KindNull
    pub b: bool = false
    pub i: i64 = 0
    pub n: f64 = 0.0
    pub s: str = ""
    pub arr: Vector<Value> = Vector {}
    pub obj: HashMap<str, Value> = HashMap {} as HashMap<str, Value>
end

@en "ValueNull"
@fa "مقدار تهی"
pub func ValueNull(): Value: ret Value { kind = KindNull } end
@en "ValueBool"
@fa "مقدار منطقی"
pub func ValueBool(b: bool): Value: ret Value { kind = KindBool, b = b } end
@en "ValueInt"
@fa "مقدار صحیح"
pub func ValueInt(i: i64): Value: ret Value { kind = KindInt, i = i } end
@en "ValueFloat"
@fa "مقدار اعشاری"
pub func ValueFloat(n: f64): Value: ret Value { kind = KindFloat, n = n } end
@en "ValueString"
@fa "مقدار رشته"
pub func ValueString(s: str): Value: ret Value { kind = KindString, s = s } end

@en "ValueArray"
@fa "مقدار آرایه"
pub func ValueArray(items: Vector<Value>): Value:
    mut v := Value { kind = KindArray }
    v.arr = items
    ret v
end

@en "ValueObject"
@fa "مقدار شیء"
pub func ValueObject(fields: HashMap<str, Value>): Value:
    mut v := Value { kind = KindObject }
    v.obj = fields
    ret v
end

@en "NewValueArray"
@fa "آرایه جدید"
pub func NewValueArray(): Value:
    ret Value { kind = KindArray, arr = Vector {} as Vector<Value> }
end

@en "NewValueObject"
@fa "شیء جدید"
pub func NewValueObject(): Value:
    ret Value { kind = KindObject, obj = HashMap {} as HashMap<str, Value> }
end

@en "IsNull"
@fa "تهی است"
pub func IsNull(v: Value): bool: ret v.kind == KindNull end
@en "IsBool"
@fa "منطقی است"
pub func IsBool(v: Value): bool: ret v.kind == KindBool end
@en "IsInt"
@fa "صحیح است"
pub func IsInt(v: Value): bool: ret v.kind == KindInt end
@en "IsFloat"
@fa "اعشاری است"
pub func IsFloat(v: Value): bool: ret v.kind == KindFloat end
@en "IsNumber"
@fa "عدد است"
pub func IsNumber(v: Value): bool: ret v.kind == KindInt or v.kind == KindFloat end
@en "IsString"
@fa "رشته است"
pub func IsString(v: Value): bool: ret v.kind == KindString end
@en "IsArray"
@fa "آرایه است"
pub func IsArray(v: Value): bool: ret v.kind == KindArray end
@en "IsObject"
@fa "شیء است"
pub func IsObject(v: Value): bool: ret v.kind == KindObject end

@en "AsBool"
@fa "به منطقی"
pub func AsBool(v: Value): bool: ret v.b end

@en "AsInt"
@fa "به صحیح"
pub func AsInt(v: Value): i64:
    if v.kind == KindFloat: ret v.n as i64 end
    ret v.i
end

@en "AsFloat"
@fa "به اعشاری"
pub func AsFloat(v: Value): f64:
    if v.kind == KindInt: ret v.i as f64 end
    ret v.n
end

@en "AsString"
@fa "به رشته"
pub func AsString(v: Value): str: ret v.s end

@en "ArrayLen"
@fa "طول آرایه"
pub func ArrayLen(v: Value): int: ret v.arr.len() end

@en "ArrayGet"
@fa "عضو آرایه"
pub func ArrayGet(v: Value, i: int): Value: ret v.arr.get(i) end

@en "ArraySet"
@fa "تنظیم عضو آرایه"
pub func ArraySet(v &: Value, i: int, item: Value): v.arr.set(i, item) end

@en "ArrayPush"
@fa "افزودن به آرایه"
pub func ArrayPush(v &: Value, item: Value): v.arr.push(item) end

@en "ObjectLen"
@fa "طول شیء"
pub func ObjectLen(v: Value): int: ret v.obj.size() end

@en "ObjectHas"
@fa "شیء دارد"
pub func ObjectHas(v: Value, key: str): bool: ret v.obj.has(key) end

@en "ObjectGet"
@fa "مقدار کلید"
pub func ObjectGet(v: Value, key: str): Value: ret v.obj.get(key) end

@en "ObjectGetOk"
@fa "مقدار کلید با وضعیت"
pub func ObjectGetOk(v: Value, key: str, ok &: bool): Value:
    ok = v.obj.has(key)
    if ok: ret v.obj.get(key) end
    ret ValueNull()
end

@en "ObjectSet"
@fa "تنظیم کلید"
pub func ObjectSet(v &: Value, key: str, item: Value): v.obj.put(key, item) end

@en "ObjectDelete"
@fa "حذف کلید"
pub func ObjectDelete(v &: Value, key: str): bool: ret v.obj.remove(key) end

@en "ObjectKeys"
@fa "کلیدهای شیء"
pub func ObjectKeys(v: Value): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut it := v.obj.iter()
    until it.has_next():
        out.push(it.key())
        it.next()
    end
    ret out
end

@en "ValueClone"
@fa "رونوشت مقدار"
pub func ValueClone(v: Value): Value:
    if v.kind == KindArray:
        mut out := Vector {} as Vector<Value>
        mut i := 0
        until i < v.arr.len():
            out.push(ValueClone(v.arr.get(i)))
            i += 1
        end
        ret ValueArray(out)
    end
    if v.kind == KindObject:
        mut out := HashMap {} as HashMap<str, Value>
        mut it := v.obj.iter()
        until it.has_next():
            out.put(it.key(), ValueClone(it.value()))
            it.next()
        end
        ret ValueObject(out)
    end
    ret v
end

@en "ValueFree"
@fa "آزادسازی مقدار"
pub func ValueFree(v &: Value):
    if v.kind == KindArray:
        mut i := 0
        until i < v.arr.len():
            mut child := v.arr.get(i)
            ValueFree(child)
            i += 1
        end
        v.arr.free()
    else v.kind == KindObject:
        mut it := v.obj.iter()
        until it.has_next():
            mut child := it.value()
            ValueFree(child)
            it.next()
        end
        v.obj.free()
    end
end
