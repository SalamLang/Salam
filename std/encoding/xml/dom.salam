package xml

@en "KindDocument"
@fa "نوع سند"
pub const KindDocument := 0
@en "KindElement"
@fa "نوع عنصر"
pub const KindElement := 1
@en "KindText"
@fa "نوع متن"
pub const KindText := 2
@en "KindCData"
@fa "نوع سی‌دیتا"
pub const KindCData := 3
@en "KindComment"
@fa "نوع توضیح"
pub const KindComment := 4
@en "KindProcessingInstruction"
@fa "نوع دستور پردازش"
pub const KindProcessingInstruction := 5
@en "KindDoctype"
@fa "نوع اعلان سند"
pub const KindDoctype := 6

@en "XMLNamespaceURI"
@fa "نشانی فضای نام اکس‌ام‌ال"
pub const XMLNamespaceURI := "http://www.w3.org/XML/1998/namespace"
@en "XMLNSNamespaceURI"
@fa "نشانی فضای نام اکس‌ام‌ال‌ان‌اس"
pub const XMLNSNamespaceURI := "http://www.w3.org/2000/xmlns/"

@en "Attribute"
@fa "ویژگی"
pub struct Attribute:
    pub owner: int = 0 - 1
    pub name: str = ""
    pub prefix: str = ""
    pub local: str = ""
    pub uri: str = ""
    pub value: str = ""
    pub line: int = 0
    pub col: int = 0
end

@en "Node"
@fa "گره"
pub struct Node:
    pub kind: int = 0
    pub name: str = ""
    pub prefix: str = ""
    pub local: str = ""
    pub uri: str = ""
    pub value: str = ""
    pub parent: int = 0 - 1
    pub children: Vector<int> = Vector {}
    pub attrs: Vector<int> = Vector {}
    pub line: int = 0
    pub col: int = 0
end

@en "Document"
@fa "سند"
pub struct Document:
    pub nodes: Vector<Node> = Vector {}
    pub attributes: Vector<Attribute> = Vector {}
    pub version: str = ""
    pub encoding: str = ""
    pub standalone: str = ""
    pub doctype: str = ""
    pub doctype_public: str = ""
    pub doctype_system: str = ""
    pub internal_subset: str = ""
    pub entity_names: Vector<str> = Vector {}
    pub entity_values: Vector<str> = Vector {}
    pub owned: Vector<str> = Vector {}
end

@en "NodeList"
@fa "فهرست گره"
pub struct NodeList:
    pub items: Vector<int> = Vector {}
end

func release(text: str):
    if str.Len(text) > 0: mem.Free(text as void*) end
end

func own(d &: Document, text: str): str:
    if str.Len(text) > 0: d.owned.push(text) end
    ret text
end

func new_element(d &: Document, name: str): int:
    ret new_node(d, KindElement, name)
end

func node_at(d: Document, id: int): Node:
    if id < 0 or id >= d.nodes.len(): ret Node { kind = 0 - 1 } end
    ret d.nodes.get(id)
end

func attr_at(d: Document, id: int): Attribute:
    if id < 0 or id >= d.attributes.len(): ret Attribute {} end
    ret d.attributes.get(id)
end

func new_node(d &: Document, kind: int, name: str): int:
    id := d.nodes.len()
    d.nodes.push(Node { kind = kind, name = name, local = name })
    ret id
end

func attach(d &: Document, parent: int, child: int):
    mut p := d.nodes.get(parent)
    p.children.push(child)
    d.nodes.set(parent, p)
    mut c := d.nodes.get(child)
    c.parent = parent
    d.nodes.set(child, c)
end

func set_attribute_on(d &: Document, id: int, name: str, prefix: str, local: str, uri: str, value: str, line: int, col: int):
    mut owner := d.nodes.get(id)
    mut i := 0
    until i < owner.attrs.len():
        existing := d.attributes.get(owner.attrs.get(i))
        if existing.name == name:
            mut updated := existing
            updated.value = value
            d.attributes.set(owner.attrs.get(i), updated)
            ret
        end
        i += 1
    end
    aid := d.attributes.len()
    d.attributes.push(Attribute { owner = id, name = name, prefix = prefix, local = local, uri = uri, value = value, line = line, col = col })
    owner.attrs.push(aid)
    d.nodes.set(id, owner)
end

func collect_text(d: Document, id: int, sb &: str.StringBuilder, with_cdata: bool):
    n := node_at(d, id)
    if n.kind == KindText: str.BufAppend(sb, n.value) end
    if n.kind == KindCData and with_cdata: str.BufAppend(sb, n.value) end
    mut i := 0
    until i < n.children.len():
        collect_text(d, n.children.get(i), sb, with_cdata)
        i += 1
    end
end

func collect_descendants(d: Document, id: int, out &: NodeList):
    n := node_at(d, id)
    mut i := 0
    until i < n.children.len():
        child := n.children.get(i)
        out.items.push(child)
        collect_descendants(d, child, out)
        i += 1
    end
end

func index_among_named_siblings(d: Document, id: int): int:
    n := node_at(d, id)
    if n.parent < 0: ret 1 end
    p := node_at(d, n.parent)
    mut seen := 0
    mut i := 0
    until i < p.children.len():
        c := node_at(d, p.children.get(i))
        if c.kind == n.kind and c.name == n.name:
            seen += 1
            if p.children.get(i) == id: ret seen end
        end
        i += 1
    end
    ret seen
end

@en "NewDocument"
@fa "سند جدید"
pub func NewDocument(): Document:
    mut d := Document { version = "1.0", encoding = "UTF-8" }
    _root := new_node(d, KindDocument, "#document")
    ret d
end

@en "Free"
@fa "آزادسازی"
pub func Free(d &: Document):
    mut i := 0
    until i < d.nodes.len():
        mut n := d.nodes.get(i)
        n.children.free()
        n.attrs.free()
        i += 1
    end
    mut k := 0
    until k < d.owned.len():
        mem.Free(d.owned.get(k) as void*)
        k += 1
    end
    d.nodes.free()
    d.attributes.free()
    d.entity_names.free()
    d.entity_values.free()
    d.owned.free()
end

@en "FreeList"
@fa "آزادسازی فهرست"
pub func FreeList(list &: NodeList):
    list.items.free()
end

@en "NodeCount"
@fa "شمار گره‌ها"
pub func NodeCount(d: Document): int: ret d.nodes.len() end

@en "DocumentNode"
@fa "گره سند"
pub func DocumentNode(d: Document): int:
    if d.nodes.len() == 0: ret 0 - 1 end
    ret 0
end

@en "Root"
@fa "عنصر ریشه"
pub func Root(d: Document): int:
    doc := node_at(d, 0)
    mut i := 0
    until i < doc.children.len():
        child := doc.children.get(i)
        if node_at(d, child).kind == KindElement: ret child end
        i += 1
    end
    ret 0 - 1
end

@en "Exists"
@fa "وجود دارد"
pub func Exists(d: Document, id: int): bool:
    ret id >= 0 and id < d.nodes.len()
end

@en "Kind"
@fa "نوع"
pub func Kind(d: Document, id: int): int: ret node_at(d, id).kind end
@en "Name"
@fa "نام"
pub func Name(d: Document, id: int): str: ret node_at(d, id).name end
@en "LocalName"
@fa "نام محلی"
pub func LocalName(d: Document, id: int): str: ret node_at(d, id).local end
@en "Prefix"
@fa "پیشوند"
pub func Prefix(d: Document, id: int): str: ret node_at(d, id).prefix end
@en "NamespaceURI"
@fa "نشانی فضای نام"
pub func NamespaceURI(d: Document, id: int): str: ret node_at(d, id).uri end
@en "Value"
@fa "مقدار"
pub func Value(d: Document, id: int): str: ret node_at(d, id).value end
@en "Parent"
@fa "والد"
pub func Parent(d: Document, id: int): int: ret node_at(d, id).parent end
@en "Line"
@fa "خط"
pub func Line(d: Document, id: int): int: ret node_at(d, id).line end
@en "Column"
@fa "ستون"
pub func Column(d: Document, id: int): int: ret node_at(d, id).col end

@en "IsElement"
@fa "عنصر است"
pub func IsElement(d: Document, id: int): bool: ret node_at(d, id).kind == KindElement end

@en "ChildCount"
@fa "شمار فرزندان"
pub func ChildCount(d: Document, id: int): int: ret node_at(d, id).children.len() end

@en "ChildAt"
@fa "فرزند شماره"
pub func ChildAt(d: Document, id: int, index: int): int:
    n := node_at(d, id)
    if index < 0 or index >= n.children.len(): ret 0 - 1 end
    ret n.children.get(index)
end

@en "ChildNodes"
@fa "گره‌های فرزند"
pub func ChildNodes(d: Document, id: int): NodeList:
    mut out := NodeList {}
    n := node_at(d, id)
    mut i := 0
    until i < n.children.len():
        out.items.push(n.children.get(i))
        i += 1
    end
    ret out
end

@en "Elements"
@fa "عنصرها"
pub func Elements(d: Document, id: int): NodeList:
    mut out := NodeList {}
    n := node_at(d, id)
    mut i := 0
    until i < n.children.len():
        child := n.children.get(i)
        if node_at(d, child).kind == KindElement: out.items.push(child) end
        i += 1
    end
    ret out
end

@en "ElementsNamed"
@fa "عنصرهای با نام"
pub func ElementsNamed(d: Document, id: int, name: str): NodeList:
    mut out := NodeList {}
    n := node_at(d, id)
    mut i := 0
    until i < n.children.len():
        child := n.children.get(i)
        c := node_at(d, child)
        if c.kind == KindElement and (c.name == name or c.local == name): out.items.push(child) end
        i += 1
    end
    ret out
end

@en "FirstElementNamed"
@fa "نخستین عنصر با نام"
pub func FirstElementNamed(d: Document, id: int, name: str): int:
    n := node_at(d, id)
    mut i := 0
    until i < n.children.len():
        child := n.children.get(i)
        c := node_at(d, child)
        if c.kind == KindElement and (c.name == name or c.local == name): ret child end
        i += 1
    end
    ret 0 - 1
end

@en "Descendants"
@fa "نوادگان"
pub func Descendants(d: Document, id: int): NodeList:
    mut out := NodeList {}
    collect_descendants(d, id, out)
    ret out
end

@en "Ancestors"
@fa "نیاکان"
pub func Ancestors(d: Document, id: int): NodeList:
    mut out := NodeList {}
    mut at := node_at(d, id).parent
    until at >= 0:
        out.items.push(at)
        at = node_at(d, at).parent
    end
    ret out
end

@en "NextSibling"
@fa "گره هم‌سطح بعدی"
pub func NextSibling(d: Document, id: int): int:
    n := node_at(d, id)
    if n.parent < 0: ret 0 - 1 end
    p := node_at(d, n.parent)
    mut i := 0
    until i < p.children.len():
        if p.children.get(i) == id and i + 1 < p.children.len(): ret p.children.get(i + 1) end
        i += 1
    end
    ret 0 - 1
end

@en "PreviousSibling"
@fa "گره هم‌سطح قبلی"
pub func PreviousSibling(d: Document, id: int): int:
    n := node_at(d, id)
    if n.parent < 0: ret 0 - 1 end
    p := node_at(d, n.parent)
    mut i := 0
    until i < p.children.len():
        if p.children.get(i) == id and i > 0: ret p.children.get(i - 1) end
        i += 1
    end
    ret 0 - 1
end

@en "Depth"
@fa "عمق"
pub func Depth(d: Document, id: int): int:
    mut count := 0
    mut at := node_at(d, id).parent
    until at >= 0:
        count += 1
        at = node_at(d, at).parent
    end
    ret count
end

@en "AttributeCount"
@fa "شمار ویژگی‌ها"
pub func AttributeCount(d: Document, id: int): int: ret node_at(d, id).attrs.len() end

@en "AttributeAt"
@fa "ویژگی شماره"
pub func AttributeAt(d: Document, id: int, index: int): Attribute:
    n := node_at(d, id)
    if index < 0 or index >= n.attrs.len(): ret Attribute {} end
    ret attr_at(d, n.attrs.get(index))
end

@en "HasAttribute"
@fa "ویژگی دارد"
pub func HasAttribute(d: Document, id: int, name: str): bool:
    n := node_at(d, id)
    mut i := 0
    until i < n.attrs.len():
        if attr_at(d, n.attrs.get(i)).name == name: ret true end
        i += 1
    end
    ret false
end

@en "AttributeValue"
@fa "مقدار ویژگی"
pub func AttributeValue(d: Document, id: int, name: str): str:
    n := node_at(d, id)
    mut i := 0
    until i < n.attrs.len():
        a := attr_at(d, n.attrs.get(i))
        if a.name == name: ret a.value end
        i += 1
    end
    ret ""
end

@en "AttributeValueNS"
@fa "مقدار ویژگی با فضای نام"
pub func AttributeValueNS(d: Document, id: int, uri: str, local: str): str:
    n := node_at(d, id)
    mut i := 0
    until i < n.attrs.len():
        a := attr_at(d, n.attrs.get(i))
        if a.uri == uri and a.local == local: ret a.value end
        i += 1
    end
    ret ""
end

@en "Text"
@fa "متن"
pub func Text(d: Document, id: int): str:
    mut sb := str.NewBuilder()
    collect_text(d, id, sb, true)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

@en "DirectText"
@fa "متن مستقیم"
pub func DirectText(d: Document, id: int): str:
    mut sb := str.NewBuilder()
    n := node_at(d, id)
    mut i := 0
    until i < n.children.len():
        c := node_at(d, n.children.get(i))
        if c.kind == KindText or c.kind == KindCData: str.BufAppend(sb, c.value) end
        i += 1
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

@en "Path"
@fa "مسیر"
pub func Path(d: Document, id: int): str:
    if not Exists(d, id): ret "" end
    n := node_at(d, id)
    if n.kind == KindDocument: ret "/" end
    parent := n.parent
    mut head := ""
    if parent > 0: head = Path(d, parent) end
    mut label := n.name
    if n.kind == KindText: label = "text()" end
    if n.kind == KindComment: label = "comment()" end
    if n.kind == KindCData: label = "text()" end
    if n.kind == KindProcessingInstruction: label = "processing-instruction()" end
    ret head + "/" + label + "[" + str.FromInt(index_among_named_siblings(d, id) as i64) + "]"
end

@en "EntityCount"
@fa "شمار موجودیت‌ها"
pub func EntityCount(d: Document): int: ret d.entity_names.len() end

@en "EntityValue"
@fa "مقدار موجودیت"
pub func EntityValue(d: Document, name: str): str:
    mut i := 0
    until i < d.entity_names.len():
        if d.entity_names.get(i) == name: ret d.entity_values.get(i) end
        i += 1
    end
    ret ""
end

@en "CreateElement"
@fa "ساخت عنصر"
pub func CreateElement(d &: Document, name: str): int:
    id := new_node(d, KindElement, name)
    mut n := d.nodes.get(id)
    colon := str.IndexOf(name, ":")
    if colon > 0:
        n.prefix = own(d, str.Substr(name, 0, colon))
        n.local = own(d, str.Substr(name, colon + 1, str.Len(name) - colon - 1))
    end
    d.nodes.set(id, n)
    ret id
end

@en "CreateText"
@fa "ساخت متن"
pub func CreateText(d &: Document, text: str): int:
    id := new_node(d, KindText, "#text")
    mut n := d.nodes.get(id)
    n.value = text
    d.nodes.set(id, n)
    ret id
end

@en "CreateCData"
@fa "ساخت سی‌دیتا"
pub func CreateCData(d &: Document, text: str): int:
    id := new_node(d, KindCData, "#cdata-section")
    mut n := d.nodes.get(id)
    n.value = text
    d.nodes.set(id, n)
    ret id
end

@en "CreateComment"
@fa "ساخت توضیح"
pub func CreateComment(d &: Document, text: str): int:
    id := new_node(d, KindComment, "#comment")
    mut n := d.nodes.get(id)
    n.value = text
    d.nodes.set(id, n)
    ret id
end

@en "CreateProcessingInstruction"
@fa "ساخت دستور پردازش"
pub func CreateProcessingInstruction(d &: Document, target: str, data: str): int:
    id := new_node(d, KindProcessingInstruction, target)
    mut n := d.nodes.get(id)
    n.value = data
    d.nodes.set(id, n)
    ret id
end

@en "Append"
@fa "افزودن فرزند"
pub func Append(d &: Document, parent: int, child: int):
    if not Exists(d, parent) or not Exists(d, child): ret end
    attach(d, parent, child)
end

@en "InsertBefore"
@fa "درج پیش از"
pub func InsertBefore(d &: Document, parent: int, child: int, before: int):
    if not Exists(d, parent) or not Exists(d, child): ret end
    mut p := d.nodes.get(parent)
    mut at := p.children.len()
    mut i := 0
    mut found := false
    until not found and i < p.children.len():
        if p.children.get(i) == before:
            at = i
            found = true
        end
        i += 1
    end
    p.children.insert(at, child)
    d.nodes.set(parent, p)
    mut c := d.nodes.get(child)
    c.parent = parent
    d.nodes.set(child, c)
end

@en "RemoveChild"
@fa "حذف فرزند"
pub func RemoveChild(d &: Document, parent: int, child: int): bool:
    if not Exists(d, parent): ret false end
    mut p := d.nodes.get(parent)
    mut i := 0
    until i < p.children.len():
        if p.children.get(i) == child:
            p.children.remove_at(i)
            d.nodes.set(parent, p)
            mut c := d.nodes.get(child)
            c.parent = 0 - 1
            d.nodes.set(child, c)
            ret true
        end
        i += 1
    end
    ret false
end

@en "SetAttribute"
@fa "تنظیم ویژگی"
pub func SetAttribute(d &: Document, id: int, name: str, value: str):
    if not Exists(d, id): ret end
    mut prefix := ""
    mut local := name
    colon := str.IndexOf(name, ":")
    if colon > 0:
        prefix = own(d, str.Substr(name, 0, colon))
        local = own(d, str.Substr(name, colon + 1, str.Len(name) - colon - 1))
    end
    set_attribute_on(d, id, name, prefix, local, "", value, 0, 0)
end

@en "RemoveAttribute"
@fa "حذف ویژگی"
pub func RemoveAttribute(d &: Document, id: int, name: str): bool:
    if not Exists(d, id): ret false end
    mut n := d.nodes.get(id)
    mut i := 0
    until i < n.attrs.len():
        if attr_at(d, n.attrs.get(i)).name == name:
            n.attrs.remove_at(i)
            d.nodes.set(id, n)
            ret true
        end
        i += 1
    end
    ret false
end

@en "SetText"
@fa "تنظیم متن"
pub func SetText(d &: Document, id: int, text: str):
    if not Exists(d, id): ret end
    mut n := d.nodes.get(id)
    n.children.clear()
    d.nodes.set(id, n)
    child := CreateText(d, text)
    attach(d, id, child)
end
