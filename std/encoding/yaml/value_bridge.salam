package yaml

if not SALAM_KERNEL:
    import encoding.value
    import encoding.json

    @en "Decode"
    @fa "کدگشایی"
    pub func Decode(text: str): value.Value throws:
        try:
            ret json.Decode(ToJSON(text))
        catch e:
            throw Error.New(e.kind, e.message).with_code(e.code).wrap("yaml")
        end
    end

    @en "Encode"
    @fa "کدگذاری"
    pub func Encode(v: value.Value): str:
        ret Dump(json.EncodeDefault(v))
    end
end
