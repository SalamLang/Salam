package yaml

import encoding.value
import encoding.encerr
import encoding.json

// value_bridge - Value-based Decode/Encode, additive alongside yaml.salam's
// existing string-based Parse/ToJSON/Dump API. Bridges through JSON text
// rather than writing a third parser: YAML's flow style is a superset of
// JSON, so ToJSON already does the real parsing work, and Dump already
// renders JSON-shaped text as YAML (its own Parse step normalizes JSON
// input as a degenerate case of flow YAML).

pub func Decode(text: str, err &: encerr.EncodingError): value.Value:
    ret json.Decode(ToJSON(text), err)
end

pub func Encode(v: value.Value): str:
    ret Dump(json.EncodeDefault(v))
end
