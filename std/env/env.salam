@en "env"
@fa "محیط"
@ar "بیئة"
package env

import str
import conv
import io
import fs.path
import encoding.envfile

if SALAM_OS_WINDOWS:
    extern:
        func getenv(name: str): void*
        func _putenv_s(name: str, value: str): int
    end
else:
    extern:
        func getenv(name: str): void*
        func setenv(name: str, value: str, overwrite: int): int
        func unsetenv(name: str): int
    end
end

func _base_from_names(names: Vector<str>): envfile.Doc:
    mut base := envfile.New()
    repeat names.len() with i:
        n := names.get(i)
        if Has(n): envfile.Set(base, n, Get(n)) end
    end
    ret base
end

func _env_base(raw &: envfile.Doc): envfile.Doc:
    names := envfile.RefNames(raw)
    defer names.free()
    ret _base_from_names(names)
end

func _apply_doc(d &: envfile.Doc, override: bool): int:
    mut count := 0
    repeat envfile.Len(d) with i:
        k := envfile.KeyAt(d, i)
        if override || Has(k) == false:
            Set(k, envfile.ValueAt(d, i))
            count += 1
        end
    end
    ret count
end

func _apply_raw(raw &: envfile.Doc, override: bool): int:
    mut base := _env_base(raw)
    defer envfile.Free(base)
    mut d := envfile.ExpandDoc(raw, base)
    defer envfile.Free(d)
    ret _apply_doc(d, override)
end

func _apply_text(text: str, override: bool): int:
    mut raw := envfile.ParseRaw(text)
    defer envfile.Free(raw)
    ret _apply_raw(raw, override)
end

func _merge_file(dst &: envfile.Doc, p: str):
    mut raw := envfile.ParseRaw(io.ReadFile(p))
    defer envfile.Free(raw)
    envfile.MergeInto(dst, raw)
end

@en "Get"
@fa "دریافت"
@ar "جلب"
pub func Get(name: str): str:
    v := getenv(name)
    if v == null: ret "" end
    ret str.Clone(v as str)
end

@en "GetOr"
@fa "دریافت یا"
@ar "جلب أو"
pub func GetOr(name: str, def: str): str:
    v := Get(name)
    if v.len() == 0: ret def end
    ret v
end

@en "Has"
@fa "دارد"
@ar "یملک"
pub func Has(name: str): bool: ret getenv(name) != null end

@en "GetInt"
@fa "دریافت صحیح"
@ar "جلب صحیح"
pub func GetInt(name: str, def: i64): i64:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseInt(v)
end

@en "GetFloat"
@fa "دریافت اعشاری"
@ar "جلب عشری"
pub func GetFloat(name: str, def: f64): f64:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseFloat(v)
end

@en "GetBool"
@fa "دریافت منطقی"
@ar "جلب منطقی"
pub func GetBool(name: str, def: bool): bool:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseBool(v)
end

if SALAM_OS_WINDOWS:
    @en "Set"
    @fa "تنظیم"
    @ar "تعیین"
    pub func Set(name: str, value: str): bool: ret _putenv_s(name, value) == 0 end

    @en "Unset"
    @fa "حذف"
    @ar "إزالة"
    pub func Unset(name: str): bool: ret _putenv_s(name, "") == 0 end
else:
    @en "Set"
    @fa "تنظیم"
    @ar "تعیین"
    pub func Set(name: str, value: str): bool: ret setenv(name, value, 1) == 0 end

    @en "Unset"
    @fa "حذف"
    @ar "إزالة"
    pub func Unset(name: str): bool: ret unsetenv(name) == 0 end
end

@en "Mask"
@fa "پوشاندن"
@ar "إخفاء"
pub func Mask(value: str): str:
    n := value.len()
    if n == 0: ret "" end
    if n <= 8:
        mut out := ""
        repeat n: out = out.concat("*") end
        ret out
    end
    ret value.substr(0, 2).concat("****").concat(value.substr(n - 2, 2))
end

@en "GetMasked"
@fa "دریافت پوشیده"
@ar "جلب مخفي"
pub func GetMasked(name: str): str: ret Mask(Get(name)) end

@en "Profile"
@fa "نمایه"
@ar "ملف تعریف"
pub func Profile(): str:
    v := GetOr("SALAM_ENV", GetOr("APP_ENV", GetOr("ENV", "development")))
    ret str.Lower(v)
end

@en "IsProduction"
@fa "تولید است"
@ar "إنتاج"
pub func IsProduction(): bool: ret Profile() == "production" || Profile() == "prod" end

@en "IsDevelopment"
@fa "توسعه است"
@ar "تطویر"
pub func IsDevelopment(): bool: ret Profile() == "development" || Profile() == "dev" end

@en "IsTest"
@fa "آزمایش است"
@ar "اختبار"
pub func IsTest(): bool: ret Profile() == "test" || Profile() == "testing" end

@en "IsStaging"
@fa "آزمایشی است"
@ar "مرحلي"
pub func IsStaging(): bool: ret Profile() == "staging" end

@en "Load"
@fa "بارگذاری"
@ar "تحمیل"
pub func Load(path: str): int:
    ret _apply_text(io.ReadFile(path), false)
end

@en "Overload"
@fa "بارگذاری اجباری"
@ar "تحمیل قسری"
pub func Overload(path: str): int:
    ret _apply_text(io.ReadFile(path), true)
end

@en "LoadText"
@fa "بارگذاری متن"
@ar "تحمیل نص"
pub func LoadText(text: str): int:
    ret _apply_text(text, false)
end

@en "LoadDotEnv"
@fa "بارگذاری نقطه‌محیط"
@ar "تحمیل ملف بیئة"
pub func LoadDotEnv(path: str): int:
    ret _apply_text(io.ReadFile(path), true)
end

@en "LoadProfile"
@fa "بارگذاری نمایه"
@ar "تحمیل ملف تعریف"
pub func LoadProfile(dir: str): int:
    p := Profile()
    mut d := envfile.New()
    defer envfile.Free(d)
    _merge_file(d, path.Join(dir, ".env"))
    _merge_file(d, path.Join(dir, ".env.local"))
    _merge_file(d, path.Join(dir, ".env.".concat(p)))
    _merge_file(d, path.Join(dir, ".env.".concat(p).concat(".local")))
    ret _apply_raw(d, false)
end

@en "Expand"
@fa "گسترش"
@ar "توسیع"
pub func Expand(text: str): str:
    names := envfile.RefNamesIn(text)
    defer names.free()
    mut base := _base_from_names(names)
    defer envfile.Free(base)
    mut none := envfile.New()
    defer envfile.Free(none)
    ret envfile.Expand(text, none, base)
end
