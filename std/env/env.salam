@en "env"
@fa "محیط"
@ar "بیئة"
package env

import str
import conv
import config

if SALAM_OS_WINDOWS:
    extern:
        func getenv(name: str): void*
        func _putenv_s(name: str, value: str): int
    end
else:
    extern:
        func getenv(name: str): void*
        func setenv(name: str, value: str, overwrite: int): int
        func unsetenv(name: str): int
    end
end

@en "Get"
@fa "دریافت"
@ar "جلب"
pub func Get(name: str): str:
    v := getenv(name)
    if v == null: ret "" end
    ret str.Clone(v as str)
end

@en "GetOr"
@fa "دریافت یا"
@ar "جلب أو"
pub func GetOr(name: str, def: str): str:
    v := Get(name)
    if v.len() == 0: ret def end
    ret v
end

@en "Has"
@fa "دارد"
@ar "یملک"
pub func Has(name: str): bool: ret getenv(name) != null end

@en "GetInt"
@fa "دریافت صحیح"
@ar "جلب صحیح"
pub func GetInt(name: str, def: i64): i64:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseInt(v)
end

@en "GetFloat"
@fa "دریافت اعشاری"
@ar "جلب عشری"
pub func GetFloat(name: str, def: f64): f64:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseFloat(v)
end

@en "GetBool"
@fa "دریافت منطقی"
@ar "جلب منطقی"
pub func GetBool(name: str, def: bool): bool:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseBool(v)
end

if SALAM_OS_WINDOWS:
    @en "Set"
    @fa "تنظیم"
    @ar "تعیین"
    pub func Set(name: str, value: str): bool: ret _putenv_s(name, value) == 0 end

    @en "Unset"
    @fa "حذف"
    @ar "إزالة"
    pub func Unset(name: str): bool: ret _putenv_s(name, "") == 0 end
else:
    @en "Set"
    @fa "تنظیم"
    @ar "تعیین"
    pub func Set(name: str, value: str): bool: ret setenv(name, value, 1) == 0 end

    @en "Unset"
    @fa "حذف"
    @ar "إزالة"
    pub func Unset(name: str): bool: ret unsetenv(name) == 0 end
end

// Mask redacts a secret value for safe logging: short values are fully
// starred out, longer ones keep a few leading/trailing characters so the
// value can still be recognized without exposing it.
@en "Mask"
@fa "پوشاندن"
@ar "إخفاء"
pub func Mask(value: str): str:
    n := value.len()
    if n == 0: ret "" end
    if n <= 8:
        mut out := ""
        repeat n with i: out = out.concat("*") end
        ret out
    end
    ret value.substr(0, 2).concat("****").concat(value.substr(n - 2, 2))
end

@en "GetMasked"
@fa "دریافت پوشیده"
@ar "جلب مخفي"
pub func GetMasked(name: str): str: ret Mask(Get(name)) end

@en "Profile"
@fa "نمایه"
@ar "ملف تعریف"
pub func Profile(): str:
    v := GetOr("SALAM_ENV", GetOr("APP_ENV", GetOr("ENV", "development")))
    ret str.Lower(v)
end

@en "IsProduction"
@fa "تولید است"
@ar "إنتاج"
pub func IsProduction(): bool: ret Profile() == "production" || Profile() == "prod" end

@en "IsDevelopment"
@fa "توسعه است"
@ar "تطویر"
pub func IsDevelopment(): bool: ret Profile() == "development" || Profile() == "dev" end

@en "IsTest"
@fa "آزمایش است"
@ar "اختبار"
pub func IsTest(): bool: ret Profile() == "test" || Profile() == "testing" end

@en "IsStaging"
@fa "آزمایشی است"
@ar "مرحلي"
pub func IsStaging(): bool: ret Profile() == "staging" end

// LoadDotEnv reads a .env-style file (KEY=VALUE per line, '#' comments,
// optional 'export ' prefix) and applies each entry to the real process
// environment via Set. Existing variables are overwritten. Returns the
// number of entries applied.
@en "LoadDotEnv"
@fa "بارگذاری نقطه‌محیط"
@ar "تحمیل ملف بیئة"
pub func LoadDotEnv(path: str): int:
    c := config.LoadEnv(path)
    keys := config.Keys(c)
    defer keys.free()
    repeat keys.len() with i:
        k := keys.get(i)[0]
        Set(k, config.Get(c, k))
    end
    ret keys.len()
end
