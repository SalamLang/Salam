@en "env"
@fa "محیط"
@ar "بیئة"
package env

import str
import conv
import io
import fs.path
import encoding.dotenv

if SALAM_OS_WINDOWS:
    extern:
        func getenv(name: str): void*
        func _putenv_s(name: str, value: str): int
    end
else:
    extern:
        func getenv(name: str): void*
        func setenv(name: str, value: str, overwrite: int): int
        func unsetenv(name: str): int
    end
end

// The .env format itself lives in std/encoding/dotenv. This package adds
// the one thing that package deliberately does not know about: the real
// process environment, both as the source of values a file references
// and as the destination the file is applied to.

// Collects the values of `names` that are actually set. This is the
// fallback layer expansion resolves against once a file's own entries
// have been tried.
func _base_from_names(names: Vector<str>): dotenv.Doc:
    mut base := dotenv.New()
    repeat names.len() with i:
        n := names.get(i)
        if Has(n): dotenv.Set(base, n, Get(n)) end
    end
    ret base
end

// There is no portable way to enumerate the environment, so instead of
// trying, ask the document which names it references and look up exactly
// those. RefNames exists for this.
func _env_base(raw &: dotenv.Doc): dotenv.Doc:
    names := dotenv.RefNames(raw)
    defer names.free()
    ret _base_from_names(names)
end

func _apply_doc(d &: dotenv.Doc, override: bool): int:
    mut count := 0
    repeat dotenv.Len(d) with i:
        k := dotenv.KeyAt(d, i)
        if override || Has(k) == false:
            Set(k, dotenv.ValueAt(d, i))
            count += 1
        end
    end
    ret count
end

// Expansion runs after every layer has been merged, so a later file can
// reference a value an earlier one defined.
func _apply_raw(raw &: dotenv.Doc, override: bool): int:
    mut base := _env_base(raw)
    defer dotenv.Free(base)
    mut d := dotenv.ExpandDoc(raw, base)
    defer dotenv.Free(d)
    ret _apply_doc(d, override)
end

func _apply_text(text: str, override: bool): int:
    mut raw := dotenv.ParseRaw(text)
    defer dotenv.Free(raw)
    ret _apply_raw(raw, override)
end

// A missing file reads as empty text and merges as nothing, so the
// cascade in LoadProfile needs no existence check.
func _merge_file(dst &: dotenv.Doc, p: str):
    mut raw := dotenv.ParseRaw(io.ReadFile(p))
    defer dotenv.Free(raw)
    dotenv.MergeInto(dst, raw)
end

@en "Get"
@fa "دریافت"
@ar "جلب"
pub func Get(name: str): str:
    v := getenv(name)
    if v == null: ret "" end
    ret str.Clone(v as str)
end

@en "GetOr"
@fa "دریافت یا"
@ar "جلب أو"
pub func GetOr(name: str, def: str): str:
    v := Get(name)
    if v.len() == 0: ret def end
    ret v
end

@en "Has"
@fa "دارد"
@ar "یملک"
pub func Has(name: str): bool: ret getenv(name) != null end

@en "GetInt"
@fa "دریافت صحیح"
@ar "جلب صحیح"
pub func GetInt(name: str, def: i64): i64:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseInt(v)
end

@en "GetFloat"
@fa "دریافت اعشاری"
@ar "جلب عشری"
pub func GetFloat(name: str, def: f64): f64:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseFloat(v)
end

@en "GetBool"
@fa "دریافت منطقی"
@ar "جلب منطقی"
pub func GetBool(name: str, def: bool): bool:
    v := Get(name)
    if v.len() == 0: ret def end
    ret conv.ParseBool(v)
end

if SALAM_OS_WINDOWS:
    @en "Set"
    @fa "تنظیم"
    @ar "تعیین"
    pub func Set(name: str, value: str): bool: ret _putenv_s(name, value) == 0 end

    @en "Unset"
    @fa "حذف"
    @ar "إزالة"
    pub func Unset(name: str): bool: ret _putenv_s(name, "") == 0 end
else:
    @en "Set"
    @fa "تنظیم"
    @ar "تعیین"
    pub func Set(name: str, value: str): bool: ret setenv(name, value, 1) == 0 end

    @en "Unset"
    @fa "حذف"
    @ar "إزالة"
    pub func Unset(name: str): bool: ret unsetenv(name) == 0 end
end

// Mask redacts a secret value for safe logging: short values are fully
// starred out, longer ones keep a few leading/trailing characters so the
// value can still be recognized without exposing it.
@en "Mask"
@fa "پوشاندن"
@ar "إخفاء"
pub func Mask(value: str): str:
    n := value.len()
    if n == 0: ret "" end
    if n <= 8:
        mut out := ""
        repeat n: out = out.concat("*") end
        ret out
    end
    ret value.substr(0, 2).concat("****").concat(value.substr(n - 2, 2))
end

@en "GetMasked"
@fa "دریافت پوشیده"
@ar "جلب مخفي"
pub func GetMasked(name: str): str: ret Mask(Get(name)) end

@en "Profile"
@fa "نمایه"
@ar "ملف تعریف"
pub func Profile(): str:
    v := GetOr("SALAM_ENV", GetOr("APP_ENV", GetOr("ENV", "development")))
    ret str.Lower(v)
end

@en "IsProduction"
@fa "تولید است"
@ar "إنتاج"
pub func IsProduction(): bool: ret Profile() == "production" || Profile() == "prod" end

@en "IsDevelopment"
@fa "توسعه است"
@ar "تطویر"
pub func IsDevelopment(): bool: ret Profile() == "development" || Profile() == "dev" end

@en "IsTest"
@fa "آزمایش است"
@ar "اختبار"
pub func IsTest(): bool: ret Profile() == "test" || Profile() == "testing" end

@en "IsStaging"
@fa "آزمایشی است"
@ar "مرحلي"
pub func IsStaging(): bool: ret Profile() == "staging" end

// Load applies a .env file to the real process environment WITHOUT
// touching variables that are already set. That is the default every
// .env reader uses, and it is the one that composes: the real
// environment outranks the file, so a container or a CI job can override
// what the checked-in file says without editing it. Returns how many
// variables were actually set.
//
// A '${VAR}' inside the file resolves against entries defined earlier in
// the same file first, then against the real environment.
@en "Load"
@fa "بارگذاری"
@ar "تحمیل"
pub func Load(path: str): int:
    ret _apply_text(io.ReadFile(path), false)
end

// Overload is Load with the opposite precedence: the file wins over what
// is already in the environment.
@en "Overload"
@fa "بارگذاری اجباری"
@ar "تحمیل قسری"
pub func Overload(path: str): int:
    ret _apply_text(io.ReadFile(path), true)
end

// LoadText is Load for a document already in memory.
@en "LoadText"
@fa "بارگذاری متن"
@ar "تحمیل نص"
pub func LoadText(text: str): int:
    ret _apply_text(text, false)
end

// LoadDotEnv is the original name for this, kept with its original
// overwriting behaviour. New code wants Load or Overload, which say
// which precedence they mean.
@en "LoadDotEnv"
@fa "بارگذاری نقطه‌محیط"
@ar "تحمیل ملف بیئة"
pub func LoadDotEnv(path: str): int:
    ret _apply_text(io.ReadFile(path), true)
end

// LoadProfile applies the conventional cascade from `dir`, each file
// overriding the one before it but none of them overriding a variable
// already in the real environment:
//
//   .env                    committed defaults
//   .env.local              local overrides, normally not committed
//   .env.<profile>          per profile, e.g. .env.production
//   .env.<profile>.local    per profile local overrides
//
// <profile> is whatever Profile() reports. Files that do not exist are
// skipped. Expansion happens once, after all four are merged, so a later
// file can reference a value an earlier one set.
@en "LoadProfile"
@fa "بارگذاری نمایه"
@ar "تحمیل ملف تعریف"
pub func LoadProfile(dir: str): int:
    p := Profile()
    mut d := dotenv.New()
    defer dotenv.Free(d)
    _merge_file(d, path.Join(dir, ".env"))
    _merge_file(d, path.Join(dir, ".env.local"))
    _merge_file(d, path.Join(dir, ".env.".concat(p)))
    _merge_file(d, path.Join(dir, ".env.".concat(p).concat(".local")))
    ret _apply_raw(d, false)
end

// Expand resolves '$VAR', '${VAR}' and '${VAR:-default}' in an arbitrary
// string against the real environment. Useful for a path or a connection
// string read from somewhere other than a .env file.
@en "Expand"
@fa "گسترش"
@ar "توسیع"
pub func Expand(text: str): str:
    names := dotenv.RefNamesIn(text)
    defer names.free()
    mut base := _base_from_names(names)
    defer dotenv.Free(base)
    mut none := dotenv.New()
    defer dotenv.Free(none)
    ret dotenv.Expand(text, none, base)
end
