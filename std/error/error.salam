@en "error"
@fa "خطا"
@ar "خطأ"
package error

import str
import fmt
import collections

@en "KindUnknown"
@fa "نوع نامشخص"
@ar "نوع غیر معروف"
pub const KindUnknown := "unknown"

@en "KindNotFound"
@fa "یافت نشد"
@ar "غیر موجود"
pub const KindNotFound := "not_found"

@en "KindInvalidArgument"
@fa "آرگومان نامعتبر"
@ar "وسیطة غیر صالحة"
pub const KindInvalidArgument := "invalid_argument"

@en "KindPermissionDenied"
@fa "دسترسی رد شد"
@ar "الإذن مرفوض"
pub const KindPermissionDenied := "permission_denied"

@en "KindAlreadyExists"
@fa "از قبل موجود است"
@ar "موجود بالفعل"
pub const KindAlreadyExists := "already_exists"

@en "KindUnavailable"
@fa "در دسترس نیست"
@ar "غیر متاح"
pub const KindUnavailable := "unavailable"

@en "KindTimeout"
@fa "پایان زمان"
@ar "انتهاء المهلة"
pub const KindTimeout := "timeout"

@en "KindCanceled"
@fa "لغو شد"
@ar "ألغي"
pub const KindCanceled := "canceled"

@en "KindInternal"
@fa "داخلی"
@ar "داخلی"
pub const KindInternal := "internal"

@en "KindIO"
@fa "ورودی خروجی"
@ar "إدخال إخراج"
pub const KindIO := "io"

@en "KindUnimplemented"
@fa "پیاده سازی نشده"
@ar "غیر منفذ"
pub const KindUnimplemented := "unimplemented"

// Error is a structured, chainable error value. The zero value (kind == "")
// represents "no error" - check with IsNil/Ok instead of comparing to a
// language-level null, since Salam has no interface/nil-error type.
@en "Error"
@fa "خطا"
@ar "خطأ"
pub struct Error:
    pub kind: str = ""
    pub messages: Vector<str> = Vector {}
    pub kinds: Vector<str> = Vector {}
    pub trace: Vector<str> = Vector {}
    pub meta_keys: Vector<str> = Vector {}
    pub meta_vals: Vector<str> = Vector {}
end

@en "RetryPolicy"
@fa "سیاست تکرار"
@ar "سیاسة إعادة المحاولة"
pub struct RetryPolicy:
    pub max_attempts: int = 3
    pub base_delay_ms: int = 100
    pub max_delay_ms: int = 5000
end

func _new(kind: str, message: str, at: str): Error:
    mut k := kind
    if k == "": k = KindUnknown end
    mut e := Error { kind = k }
    e.messages.push(message)
    e.kinds.push(k)
    if at != "": e.trace.push(at) end
    ret e
end

@en "Nil"
@fa "خالی"
@ar "فارغ"
pub func Nil(): Error: ret Error {} end

@en "IsNil"
@fa "خالی است"
@ar "هل فارغ"
pub func IsNil(e: Error): bool: ret e.kind == "" end

@en "Ok"
@fa "بدون خطا"
@ar "لا خطأ"
pub func Ok(e: Error): bool: ret e.kind == "" end

@en "New"
@fa "جدید"
@ar "جدید"
pub func New(kind: str, message: str): Error: ret _new(kind, message, "") end

@en "NewAt"
@fa "جدید در"
@ar "جدید عند"
pub func NewAt(kind: str, message: str, at: str): Error: ret _new(kind, message, at) end

@en "Newf"
@fa "جدید قالبی"
@ar "جدید منسق"
pub func Newf(kind: str, tmpl: str, args: Vector<str>): Error: ret _new(kind, fmt.Sprintf(tmpl, args), "") end

@en "Wrap"
@fa "پیچیدن"
@ar "التفاف"
pub func Wrap(e: Error, message: str): Error:
    if IsNil(e): ret New(KindUnknown, message) end
    mut out := Error { kind = e.kind }
    out.messages = collections.clone(e.messages)
    out.messages.push(message)
    out.kinds = collections.clone(e.kinds)
    out.trace = collections.clone(e.trace)
    out.meta_keys = collections.clone(e.meta_keys)
    out.meta_vals = collections.clone(e.meta_vals)
    ret out
end

@en "WrapAt"
@fa "پیچیدن در"
@ar "التفاف عند"
pub func WrapAt(e: Error, message: str, at: str): Error:
    mut out := Wrap(e, message)
    if at != "": out.trace.push(at) end
    ret out
end

@en "WrapKind"
@fa "پیچیدن با نوع"
@ar "التفاف بنوع"
pub func WrapKind(e: Error, kind: str, message: str): Error:
    mut out := Wrap(e, message)
    out.kind = kind
    out.kinds.push(kind)
    ret out
end

@en "WithMeta"
@fa "با فراداده"
@ar "بواسطة بیانات وصفیة"
pub func WithMeta(e: Error, key: str, val: str): Error:
    mut src := e
    if IsNil(src): src = New(KindUnknown, "") end
    mut out := Error { kind = src.kind }
    out.messages = collections.clone(src.messages)
    out.kinds = collections.clone(src.kinds)
    out.trace = collections.clone(src.trace)
    out.meta_keys = collections.clone(src.meta_keys)
    out.meta_vals = collections.clone(src.meta_vals)
    out.meta_keys.push(key)
    out.meta_vals.push(val)
    ret out
end

@en "Meta"
@fa "فراداده"
@ar "بیانات وصفیة"
pub func Meta(e: Error, key: str): str:
    repeat e.meta_keys.len() with i:
        if e.meta_keys.get(i)[0] == key: ret e.meta_vals.get(i)[0] end
    end
    ret ""
end

@en "Kind"
@fa "نوع"
@ar "نوع"
pub func Kind(e: Error): str: ret e.kind end

@en "Is"
@fa "است"
@ar "هو"
pub func Is(e: Error, kind: str): bool:
    repeat e.kinds.len() with i:
        if e.kinds.get(i)[0] == kind: ret true end
    end
    ret false
end

@en "Message"
@fa "پیام"
@ar "رسالة"
pub func Message(e: Error): str:
    n := e.messages.len()
    if n == 0: ret "" end
    mut out := e.messages.get(n - 1)[0]
    mut i := n - 2
    until i >= 0:
        out = out.concat(": ").concat(e.messages.get(i)[0])
        i -= 1
    end
    ret out
end

@en "RootMessage"
@fa "پیام ریشه"
@ar "رسالة الجذر"
pub func RootMessage(e: Error): str:
    if e.messages.len() == 0: ret "" end
    ret e.messages.get(0)[0]
end

@en "Trace"
@fa "ردیابی"
@ar "تتبع"
pub func Trace(e: Error): str:
    mut out := str.NewBuilder()
    defer str.BufFree(out)
    repeat e.trace.len() with i:
        if i > 0: str.BufAppend(out, " -> ") end
        str.BufAppend(out, e.trace.get(i)[0])
    end
    ret str.BufStr(out)
end

@en "Format"
@fa "قالب"
@ar "تنسیق"
pub func Format(e: Error): str:
    if IsNil(e): ret "<nil>" end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, "[")
    str.BufAppend(b, e.kind)
    str.BufAppend(b, "] ")
    str.BufAppend(b, Message(e))
    if e.trace.len() > 0:
        str.BufAppend(b, "\n  trace: ")
        str.BufAppend(b, Trace(e))
    end
    repeat e.meta_keys.len() with i:
        str.BufAppend(b, "\n  ")
        str.BufAppend(b, e.meta_keys.get(i)[0])
        str.BufAppend(b, "=")
        str.BufAppend(b, e.meta_vals.get(i)[0])
    end
    ret str.BufStr(b)
end

@en "IsNotFound"
@fa "یافت نشد است"
@ar "غیر موجود"
pub func IsNotFound(e: Error): bool: ret Is(e, KindNotFound) end

@en "IsInvalidArgument"
@fa "آرگومان نامعتبر است"
@ar "وسیطة غیر صالحة"
pub func IsInvalidArgument(e: Error): bool: ret Is(e, KindInvalidArgument) end

@en "IsPermissionDenied"
@fa "دسترسی رد شد است"
@ar "الإذن مرفوض"
pub func IsPermissionDenied(e: Error): bool: ret Is(e, KindPermissionDenied) end

@en "IsAlreadyExists"
@fa "از قبل موجود است"
@ar "موجود بالفعل"
pub func IsAlreadyExists(e: Error): bool: ret Is(e, KindAlreadyExists) end

@en "IsTimeout"
@fa "پایان زمان است"
@ar "انتهاء المهلة"
pub func IsTimeout(e: Error): bool: ret Is(e, KindTimeout) end

@en "IsCanceled"
@fa "لغو شد است"
@ar "ألغي"
pub func IsCanceled(e: Error): bool: ret Is(e, KindCanceled) end

@en "IsUnavailable"
@fa "در دسترس نیست است"
@ar "غیر متاح"
pub func IsUnavailable(e: Error): bool: ret Is(e, KindUnavailable) end

@en "IsInternal"
@fa "داخلی است"
@ar "داخلی"
pub func IsInternal(e: Error): bool: ret Is(e, KindInternal) end

// IsRetryable reports whether retrying the failed operation later has a
// reasonable chance of succeeding (timeouts, unavailability, transient I/O).
@en "IsRetryable"
@fa "قابل تکرار است"
@ar "قابل للإعادة"
pub func IsRetryable(e: Error): bool:
    ret Is(e, KindTimeout) || Is(e, KindUnavailable) || Is(e, KindIO)
end

@en "NewRetryPolicy"
@fa "سیاست تکرار جدید"
@ar "سیاسة إعادة محاولة جدیدة"
pub func NewRetryPolicy(max_attempts: int, base_delay_ms: int, max_delay_ms: int): RetryPolicy:
    ret RetryPolicy { max_attempts = max_attempts, base_delay_ms = base_delay_ms, max_delay_ms = max_delay_ms }
end

// DelayForAttempt returns an exponential backoff delay (ms) for a 1-based
// attempt number, capped at max_delay_ms. Callers drive their own retry loop
// (Salam has no first-class closures to accept here) and sleep this long
// between attempts, e.g. via thread.Sleep.
@en "DelayForAttempt"
@fa "تاخیر برای تلاش"
@ar "تأخیر للمحاولة"
pub func DelayForAttempt(p &: RetryPolicy, attempt: int): int:
    if attempt <= 1: ret p.base_delay_ms end
    mut delay := p.base_delay_ms
    mut i := 1
    until i < attempt:
        delay *= 2
        if delay >= p.max_delay_ms: ret p.max_delay_ms end
        i += 1
    end
    ret delay
end

@en "ShouldRetry"
@fa "باید تکرار شود"
@ar "یجب إعادة المحاولة"
pub func ShouldRetry(p &: RetryPolicy, e: Error, attempt: int): bool:
    if IsNil(e): ret false end
    if attempt >= p.max_attempts: ret false end
    ret IsRetryable(e)
end

@en "Free"
@fa "آزادسازی"
@ar "تحریر"
pub func Free(e &: Error):
    e.messages.free()
    e.kinds.free()
    e.trace.free()
    e.meta_keys.free()
    e.meta_vals.free()
end
