package excel

import encoding.csv
import os
import str

@en "SheetToCSV"
@fa "برگه به سی‌اس‌وی"
pub func SheetToCSV(sheet: Sheet): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    nr := sheet.row_count()
    nc := sheet.col_count()
    mut r := 0
    until r < nr:
        mut fields := Vector {} as Vector<str>
        mut c := 0
        until c < nc:
            fields.Push(sheet.get_string(r, c))
            c++
        end
        str.BufAppend(sb, csv.WriteLine(fields))
        fields.Free()
        if r < nr - 1: str.BufAppend(sb, "\n") end
        r++
    end
    out := str.BufStr(sb)
    ret out
end

@en "CSVToSheet"
@fa "سی‌اس‌وی به برگه"
pub func CSVToSheet(text: str, sheet_name: str): Sheet throws:
    mut table := try csv.ReadAllWith(text, csv.CSVOptions { keep_blank = true })
    mut sh := NewSheet(sheet_name)
    repeat table.rows.Len() in r:
        mut fields := table.rows.Get(r).fields
        repeat fields.Len() in c:
            sh.set_string(r, c, fields.Get(c))
        end
        fields.Free()
    end
    table.rows.Free()
    ret sh
end

@en "ReadCSVWorkbook"
@fa "خواندن کتاب کار سی‌اس‌وی"
pub func ReadCSVWorkbook(path: str, ok &: bool, err &: str): Workbook:
    ok = false
    err = ""
    if not os.Exists(path):
        err = "cannot open file: ".Concat(path)
        ret NewWorkbook()
    end
    text := os.ReadFile(path)
    mut book := NewWorkbook()
    try:
        sh := CSVToSheet(text, "Sheet1")
        book.sheets.Push(sh)
    catch e:
        err = e.with_path(path).ToStr()
        ret book
    end
    book.format = FormatCSV
    book.source_path = path
    ok = true
    ret book
end

@en "WriteCSVWorkbook"
@fa "نوشتن کتاب کار سی‌اس‌وی"
pub func WriteCSVWorkbook(book &: Workbook, path: str): bool:
    if book.sheets.Len() == 0: ret false end
    mut idx := book.active_sheet
    if idx < 0 or idx >= book.sheets.Len(): idx = 0 end
    sh := book.sheets.Get(idx)
    text := SheetToCSV(sh)
    ret os.WriteFile(path, text) >= 0
end
