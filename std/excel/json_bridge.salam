package excel

import encoding.json
import str

// Sheet -> JSON export (SheetToJSON) is built on std/encoding/json's
// string-assembly helpers (Array/Str) directly - a JSON array of arrays of
// each cell's display text, row-major.
//
// JSON -> Sheet import (JSONToSheet) cannot be built the same way: the
// json package's public API is a flat key/value text-searcher (Get/GetInt/
// Has), with no array-element or iteration accessor, because that is all
// std/json's own callers have needed so far. Reading an array of arrays
// back out therefore needs a real (if narrowly-scoped) scanner, so this
// file has its own minimal one below - it understands exactly the shape
// SheetToJSON produces (an array of arrays of JSON strings/numbers/
// booleans/null), not arbitrary JSON.

func _json_ws(s: str, i: int): int:
    n := s.len()
    bp := _bp(s)
    mut p := i
    until p < n:
        c := _ub(bp, p)
        if c != 32 && c != 9 && c != 10 && c != 13: ret p end
        p += 1
    end
    ret p
end

func _json_parse_string(s: str, i: int, out_val &: str): int:
    n := s.len()
    bp := _bp(s)
    if i >= n || _ub(bp, i) != 34: ret -1 end
    mut p := i + 1
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    until p < n:
        c := _ub(bp, p)
        if c == 34:
            out_val = str.BufStr(sb)
            ret p + 1
        end
        if c == 92 && p + 1 < n:
            nc := _ub(bp, p + 1)
            if nc == 34: str.BufAppendChar(sb, 34)
            else nc == 92: str.BufAppendChar(sb, 92)
            else nc == 110: str.BufAppendChar(sb, 10)
            else nc == 116: str.BufAppendChar(sb, 9)
            else nc == 114: str.BufAppendChar(sb, 13)
            else: str.BufAppendChar(sb, nc)
            end
            p += 2
        else:
            str.BufAppendChar(sb, c)
            p += 1
        end
    end
    ret -1
end

func _json_parse_token(s: str, i: int, out_val &: str): int:
    n := s.len()
    bp := _bp(s)
    mut p := i
    until p < n:
        c := _ub(bp, p)
        if c == 44 || c == 93 || c == 32 || c == 9 || c == 10 || c == 13: break end
        p += 1
    end
    out_val = s.substr(i, p - i)
    ret p
end

func _json_parse_value(s: str, i: int, out_val &: str): int:
    p := _json_ws(s, i)
    n := s.len()
    if p >= n: ret -1 end
    bp := _bp(s)
    if _ub(bp, p) == 34: ret _json_parse_string(s, p, out_val) end
    ret _json_parse_token(s, p, out_val)
end

// Parses one JSON array of scalar values starting at/before `i`'s '[',
// pushing each element's decoded text onto `out`. Returns the index just
// past the closing ']', or -1 on malformed input.
func _json_parse_row_array(s: str, i: int, out &: Vector<str>): int:
    mut p := _json_ws(s, i)
    n := s.len()
    if p >= n: ret -1 end
    bp := _bp(s)
    if _ub(bp, p) != 91: ret -1 end
    p += 1
    p = _json_ws(s, p)
    if p < n && _ub(bp, p) == 93: ret p + 1 end
    until true:
        mut val := ""
        p = _json_parse_value(s, p, val)
        if p < 0: ret -1 end
        out.push(val)
        p = _json_ws(s, p)
        if p >= n: ret -1 end
        c := _ub(bp, p)
        if c == 44:
            p += 1
            p = _json_ws(s, p)
        else c == 93:
            ret p + 1
        else:
            ret -1
        end
    end
end

// Exports `sheet` as a JSON array of arrays of strings, row-major
// (`row_count()` rows, each `col_count()` cells wide - the same dense
// shape Sheet.get_all/set_table use), one array element per cell's
// display text.
@en "SheetToJSON"
@fa "برگه به جیسون"
@ar "ورقة إلى جیسون"
pub func SheetToJSON(sheet: Sheet): str:
    mut rows := Vector {} as Vector<str>
    defer rows.free()
    nr := sheet.row_count()
    nc := sheet.col_count()
    mut r := 0
    until r < nr:
        mut cells := Vector {} as Vector<str>
        mut c := 0
        until c < nc:
            cells.push(json.Str(sheet.get_string(r, c)))
            c += 1
        end
        rows.push(json.Array(cells))
        cells.free()
        r += 1
    end
    out := json.Array(rows)
    ret out
end

// Imports a JSON array of arrays (as produced by SheetToJSON) into a new
// Sheet, every element read as its display text regardless of its JSON
// type (string/number/boolean/null all become the corresponding cell
// text via set_string - there is no type inference back to
// number/bool/date cells). Malformed input yields whatever rows were
// successfully parsed before the error, not a partial-row rollback.
@en "JSONToSheet"
@fa "جیسون به برگه"
@ar "جیسون إلى ورقة"
pub func JSONToSheet(text: str, sheet_name: str): Sheet:
    mut sh := NewSheet(sheet_name)
    n := text.len()
    p := _json_ws(text, 0)
    if p >= n: ret sh end
    bp := _bp(text)
    if _ub(bp, p) != 91: ret sh end
    mut pos := p + 1
    pos = _json_ws(text, pos)
    if pos < n && _ub(bp, pos) == 93: ret sh end

    mut row := 0
    mut go := true
    until go:
        mut fields := Vector {} as Vector<str>
        np := _json_parse_row_array(text, pos, fields)
        if np < 0:
            fields.free()
            go = false
        else:
            mut c := 0
            until c < fields.len():
                sh.set_string(row, c, fields.get(c)[0])
                c += 1
            end
            fields.free()
            pos = _json_ws(text, np)
            if pos >= n:
                go = false
            else:
                cc := _ub(bp, pos)
                if cc == 44:
                    pos += 1
                    pos = _json_ws(text, pos)
                    row += 1
                else:
                    go = false
                end
            end
        end
    end
    ret sh
end
