package excel

import os

// File-level metadata (sheet names/dimensions, file size) without
// requiring the caller to keep a fully-loaded Workbook around afterward.
// Inspect still parses the whole file internally (there is no lazy/
// streaming reader in this package - see each format's own reader comment
// for why: xlsx/ods are both re-read from a fully in-memory ZIP anyway,
// matching std/archive's own whole-file-in-memory approach), but frees the
// Workbook before returning, keeping only the small summary below.
@en "FileMeta"
@fa "فراداده پرونده"
@ar "بیانات الملف الوصفیة"
pub struct FileMeta:
    pub path: str = ""
    pub format: int = 0
    pub exists: bool = false
    pub size: i64 = 0
    pub sheet_names: Vector<str> = Vector {} as Vector<str>
    pub sheet_rows: Vector<int> = Vector {} as Vector<int>
    pub sheet_cols: Vector<int> = Vector {} as Vector<int>

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free():
        this.sheet_names.free()
        this.sheet_rows.free()
        this.sheet_cols.free()
    end
end

// Inspects `path`: file size plus, if it parses successfully, every
// sheet's name/row-count/col-count. `ok` is false (and `err` set) if the
// file does not exist or fails to parse - `meta.exists`/`meta.size` are
// still filled in first, so a caller can tell "missing" apart from
// "present but unreadable".
@en "Inspect"
@fa "بازرسی"
@ar "فحص"
pub func Inspect(path: str, ok &: bool, err &: str): FileMeta:
    ok = false
    err = ""
    mut meta := FileMeta { path = path }
    if !os.Exists(path):
        err = "file does not exist: ".concat(path)
        ret meta
    end
    meta.exists = true
    meta.size = os.FileSize(path)
    meta.format = DetectFormat(path)

    mut open_ok := false
    mut open_err := ""
    mut book := Open(path, open_ok, open_err)
    if !open_ok:
        err = open_err
        book.free()
        ret meta
    end

    mut i := 0
    until i < book.sheets.len():
        sh := book.sheets.get(i)[0]
        meta.sheet_names.push(sh.name)
        meta.sheet_rows.push(sh.row_count())
        meta.sheet_cols.push(sh.col_count())
        i += 1
    end
    book.free()
    ok = true
    ret meta
end
