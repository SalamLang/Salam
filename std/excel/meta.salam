package excel

import os

@en "FileMeta"
@fa "فراداده پرونده"
@ar "بیانات الملف الوصفیة"
pub struct FileMeta:
    pub path: str = ""
    pub format: int = 0
    pub exists: bool = false
    pub size: i64 = 0
    pub sheet_names: Vector<str> = Vector {} as Vector<str>
    pub sheet_rows: Vector<int> = Vector {} as Vector<int>
    pub sheet_cols: Vector<int> = Vector {} as Vector<int>

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free():
        this.sheet_names.free()
        this.sheet_rows.free()
        this.sheet_cols.free()
    end
end

@en "Inspect"
@fa "بازرسی"
@ar "فحص"
pub func Inspect(path: str, ok &: bool, err &: str): FileMeta:
    ok = false
    err = ""
    mut meta := FileMeta { path = path }
    if !os.Exists(path):
        err = "file does not exist: ".concat(path)
        ret meta
    end
    meta.exists = true
    meta.size = os.FileSize(path)
    meta.format = DetectFormat(path)

    mut open_ok := false
    mut open_err := ""
    mut book := Open(path, open_ok, open_err)
    if !open_ok:
        err = open_err
        book.free()
        ret meta
    end

    mut i := 0
    until i < book.sheets.len():
        sh := book.sheets.get(i)
        meta.sheet_names.push(sh.name)
        meta.sheet_rows.push(sh.row_count())
        meta.sheet_cols.push(sh.col_count())
        i += 1
    end
    defer book.free()
    ok = true
    ret meta
end
