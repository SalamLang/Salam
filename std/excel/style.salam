package excel

// Cell formatting: font, alignment, and number/date display format.
// Alignment is a plain int constant set (not a `pub enum`, which cannot
// cross a package boundary in this compiler) shared by the horizontal and
// vertical fields with different meanings per field.

@en "AlignDefault"
@fa "چیدمان پیش‌فرض"
@ar "محاذاة افتراضیة"
pub const AlignDefault := 0

@en "AlignLeft"
@fa "چپ‌چین"
@ar "محاذاة یسار"
pub const AlignLeft := 1

@en "AlignCenter"
@fa "میان‌چین"
@ar "توسیط"
pub const AlignCenter := 2

@en "AlignRight"
@fa "راست‌چین"
@ar "محاذاة یمین"
pub const AlignRight := 3

@en "AlignTop"
@fa "بالاچین"
@ar "محاذاة أعلى"
pub const AlignTop := 1

@en "AlignMiddle"
@fa "میان‌چین عمودی"
@ar "توسیط عمودي"
pub const AlignMiddle := 2

@en "AlignBottom"
@fa "پایین‌چین"
@ar "محاذاة أسفل"
pub const AlignBottom := 3

// One cell's visual formatting. Colors are "RRGGBB" hex with no leading
// '#'; an empty color/num_format means "use the format's default" (black
// text, no fill, General number format).
@en "Style"
@fa "سبک"
@ar "نمط"
pub struct Style:
    pub bold: bool = false
    pub italic: bool = false
    pub underline: bool = false
    pub font_name: str = "Calibri"
    pub font_size: int = 11
    pub font_color: str = ""
    pub bg_color: str = ""
    pub align_h: int = 0
    pub align_v: int = 0
    pub num_format: str = ""

    @en "equals"
    @fa "برابر است"
    @ar "یساوي"
    pub func equals(other: Style): bool:
        if this.bold != other.bold: ret false end
        if this.italic != other.italic: ret false end
        if this.underline != other.underline: ret false end
        if this.font_name != other.font_name: ret false end
        if this.font_size != other.font_size: ret false end
        if this.font_color != other.font_color: ret false end
        if this.bg_color != other.bg_color: ret false end
        if this.align_h != other.align_h: ret false end
        if this.align_v != other.align_v: ret false end
        if this.num_format != other.num_format: ret false end
        ret true
    end
end

// A deduplicated table of styles, indexed by position (style_id). Every
// Workbook owns one; writers emit index 0 as the default style, matching
// both OOXML's styles.xml and ODF's automatic-styles convention of a
// baseline style at the front.
@en "StyleSheet"
@fa "جدول سبک‌ها"
@ar "جدول الأنماط"
pub struct StyleSheet:
    pub styles: Vector<Style> = Vector {} as Vector<Style>

    @en "get_or_add"
    @fa "دریافت یا افزودن"
    @ar "جلب أو إضافة"
    pub func get_or_add(s: Style): int:
        mut i := 0
        until i < this.styles.len():
            if this.styles.get(i)[0].equals(s):
                ret i
            end
            i += 1
        end
        this.styles.push(s)
        ret this.styles.len() - 1
    end

    @en "get"
    @fa "دریافت"
    @ar "جلب"
    pub func get(id: int): Style:
        if id < 0 || id >= this.styles.len(): ret Style {} end
        ret this.styles.get(id)[0]
    end

    @en "count"
    @fa "شمار"
    @ar "عدد"
    pub func count(): int: ret this.styles.len() end

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free(): this.styles.free() end
end

@en "NewStyleSheet"
@fa "جدول سبک جدید"
@ar "جدول أنماط جدید"
pub func NewStyleSheet(): StyleSheet:
    mut ss := StyleSheet {}
    ss.styles.push(Style {})
    ret ss
end
