package excel

@en "AlignDefault"
@fa "آرایش پیش‌فرض"
pub const AlignDefault := 0

@en "AlignLeft"
@fa "چپ‌چین"
pub const AlignLeft := 1

@en "AlignCenter"
@fa "میان‌چین"
pub const AlignCenter := 2

@en "AlignRight"
@fa "راست‌چین"
pub const AlignRight := 3

@en "AlignTop"
@fa "بالاچین"
pub const AlignTop := 1

@en "AlignMiddle"
@fa "میان‌چین عمودی"
pub const AlignMiddle := 2

@en "AlignBottom"
@fa "پایین‌چین"
pub const AlignBottom := 3

@en "Style"
@fa "سبک"
pub struct Style:
    pub bold: bool = false
    pub italic: bool = false
    pub underline: bool = false
    pub font_name: str = "Calibri"
    pub font_size: int = 11
    pub font_color: str = ""
    pub bg_color: str = ""
    pub align_h: int = 0
    pub align_v: int = 0
    pub num_format: str = ""

    @en "equals"
    @fa "برابر است"
    pub func equals(other: Style): bool:
        if this.bold != other.bold: ret false end
        if this.italic != other.italic: ret false end
        if this.underline != other.underline: ret false end
        if this.font_name != other.font_name: ret false end
        if this.font_size != other.font_size: ret false end
        if this.font_color != other.font_color: ret false end
        if this.bg_color != other.bg_color: ret false end
        if this.align_h != other.align_h: ret false end
        if this.align_v != other.align_v: ret false end
        if this.num_format != other.num_format: ret false end
        ret true
    end
end

@en "StyleSheet"
@fa "جدول سبک‌ها"
pub struct StyleSheet:
    pub styles: Vector<Style> = Vector {} as Vector<Style>

    @en "get_or_add"
    @fa "دریافت یا افزودن"
    pub func get_or_add(s: Style): int:
        mut i := 0
        until i < this.styles.len():
            if this.styles.get(i).equals(s):
                ret i
            end
            i += 1
        end
        this.styles.push(s)
        ret this.styles.len() - 1
    end

    @en "get"
    @fa "دریافت"
    pub func get(id: int): Style:
        if id < 0 || id >= this.styles.len(): ret Style {} end
        ret this.styles.get(id)
    end

    @en "count"
    @fa "شمار"
    pub func count(): int: ret this.styles.len() end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.styles.free() end
end

@en "NewStyleSheet"
@fa "جدول سبک جدید"
pub func NewStyleSheet(): StyleSheet:
    mut ss := StyleSheet {}
    ss.styles.push(Style {})
    ret ss
end
