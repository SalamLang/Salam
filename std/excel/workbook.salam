package excel

// A workbook: an ordered list of sheets, a shared style table, and the
// bookkeeping (source path, detected format, last error message) that
// Open/Save use. `add_sheet` returns a `Sheet*` pointing directly into the
// `sheets` Vector's backing storage for the ergonomic
// `book.add_sheet("Sheet1").set_cell(...)` one-liner - but like any pointer
// into a Vector, it is only valid until the next call that might grow the
// Vector (another add_sheet, in practice). Re-fetch with `sheet_at`/`sheet`
// rather than holding one across further sheet additions.
@en "Workbook"
@fa "کتاب کار"
@ar "مصنف"
pub struct Workbook:
    pub sheets: Vector<Sheet> = Vector {} as Vector<Sheet>
    pub styles: StyleSheet = StyleSheet {}
    pub active_sheet: int = 0
    pub source_path: str = ""
    pub format: int = 0
    pub last_error: str = ""

    @en "add_sheet"
    @fa "افزودن برگه"
    @ar "إضافة ورقة"
    pub func add_sheet(name: str): Sheet*:
        this.sheets.push(NewSheet(name))
        ret this.sheets.get(this.sheets.len() - 1)
    end

    @en "remove_sheet"
    @fa "حذف برگه"
    @ar "إزالة ورقة"
    pub func remove_sheet(idx: int): bool:
        if idx < 0 || idx >= this.sheets.len(): ret false end
        this.sheets.get(idx)[0].free()
        this.sheets.remove_at(idx)
        if this.active_sheet >= this.sheets.len():
            this.active_sheet = this.sheets.len() - 1
        end
        ret true
    end

    @en "remove_sheet_named"
    @fa "حذف برگه با نام"
    @ar "إزالة ورقة بالاسم"
    pub func remove_sheet_named(name: str): bool:
        idx := this.sheet_index(name)
        if idx < 0: ret false end
        ret this.remove_sheet(idx)
    end

    @en "rename_sheet"
    @fa "تغییر نام برگه"
    @ar "إعادة تسمیة ورقة"
    pub func rename_sheet(idx: int, new_name: str): bool:
        if idx < 0 || idx >= this.sheets.len(): ret false end
        p := this.sheets.get(idx)
        p[0].name = new_name
        ret true
    end

    @en "sheet_index"
    @fa "اندیس برگه"
    @ar "فهرس الورقة"
    pub func sheet_index(name: str): int:
        mut i := 0
        until i < this.sheets.len():
            if this.sheets.get(i)[0].name == name: ret i end
            i += 1
        end
        ret -1
    end

    @en "sheet_count"
    @fa "شمار برگه‌ها"
    @ar "عدد الأوراق"
    pub func sheet_count(): int: ret this.sheets.len() end

    @en "sheet_names"
    @fa "نام برگه‌ها"
    @ar "أسماء الأوراق"
    pub func sheet_names(): Vector<str>:
        mut out := Vector {} as Vector<str>
        mut i := 0
        until i < this.sheets.len():
            out.push(this.sheets.get(i)[0].name)
            i += 1
        end
        ret out
    end

    @en "sheet_at"
    @fa "برگه در"
    @ar "الورقة عند"
    pub func sheet_at(idx: int): Sheet*:
        if idx < 0 || idx >= this.sheets.len(): ret null end
        ret this.sheets.get(idx)
    end

    @en "sheet"
    @fa "برگه"
    @ar "الورقة"
    pub func sheet(name: str): Sheet*:
        ret this.sheet_at(this.sheet_index(name))
    end

    @en "active"
    @fa "برگه فعال"
    @ar "الورقة النشطة"
    pub func active(): Sheet*:
        ret this.sheet_at(this.active_sheet)
    end

    @en "set_active"
    @fa "تنظیم برگه فعال"
    @ar "تعیین الورقة النشطة"
    pub func set_active(idx: int): bool:
        if idx < 0 || idx >= this.sheets.len(): ret false end
        this.active_sheet = idx
        ret true
    end

    // Saves to `path`, detecting the target format from its extension (see
    // excel.Save/excel.DetectFormat). Convenience wrapper so callers can
    // write `book.save("file.xlsx")` instead of `excel.Save(book, ...)`.
    @en "save"
    @fa "ذخیره"
    @ar "حفظ"
    pub func save(path: str): bool:
        ret Save(this[0], path)
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free():
        mut i := 0
        until i < this.sheets.len():
            this.sheets.get(i)[0].free()
            i += 1
        end
        this.sheets.free()
        this.styles.free()
    end
end

@en "NewWorkbook"
@fa "کتاب کار جدید"
@ar "مصنف جدید"
pub func NewWorkbook(): Workbook:
    ret Workbook {}
end
