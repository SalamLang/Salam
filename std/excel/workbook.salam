package excel

@en "Workbook"
@fa "کتاب کار"
pub struct Workbook:
    @en "sheets"
    @fa "برگه‌ها"
    pub sheets: Vector<Sheet> = Vector {} as Vector<Sheet>
    @en "styles"
    @fa "سبک‌ها"
    pub styles: StyleSheet = StyleSheet {}
    @en "active_sheet"
    @fa "شماره برگه فعال"
    pub active_sheet: int = 0
    @en "source_path"
    @fa "مسیر منبع"
    pub source_path: str = ""
    @en "format"
    @fa "قالب"
    pub format: int = 0
    @en "last_error"
    @fa "آخرین خطا"
    pub last_error: str = ""

    @en "add_sheet"
    @fa "افزودن برگه"
    pub func AddSheet(name: str): Sheet*:
        this.sheets.push(NewSheet(name))
        ret this.sheets.ref(this.sheets.Len() - 1)
    end

    pub func add_sheet(name: str): Sheet*: ret this.AddSheet(name) end

    @en "remove_sheet"
    @fa "حذف برگه"
    pub func RemoveSheet(idx: int): bool:
        if idx < 0 or idx >= this.sheets.Len(): ret false end
        this.sheets.ref(idx)[0].free()
        this.sheets.remove_at(idx)
        if this.active_sheet >= this.sheets.Len():
            this.active_sheet = this.sheets.Len() - 1
        end
        ret true
    end

    pub func remove_sheet(idx: int): bool: ret this.RemoveSheet(idx) end

    @en "remove_sheet_named"
    @fa "حذف برگه با نام"
    pub func RemoveSheetNamed(name: str): bool:
        idx := this.sheet_index(name)
        if idx < 0: ret false end
        ret this.remove_sheet(idx)
    end

    pub func remove_sheet_named(name: str): bool: ret this.RemoveSheetNamed(name) end

    @en "rename_sheet"
    @fa "تغییر نام برگه"
    pub func RenameSheet(idx: int, new_name: str): bool:
        if idx < 0 or idx >= this.sheets.Len(): ret false end
        p := this.sheets.ref(idx)
        p[0].name = new_name
        ret true
    end

    pub func rename_sheet(idx: int, new_name: str): bool: ret this.RenameSheet(idx, new_name) end

    @en "sheet_index"
    @fa "اندیس برگه"
    pub func SheetIndex(name: str): int:
        mut i := 0
        until i < this.sheets.Len():
            if this.sheets.get(i).name == name: ret i end
            i++
        end
        ret -1
    end

    pub func sheet_index(name: str): int: ret this.SheetIndex(name) end

    @en "sheet_count"
    @fa "شمار برگه‌ها"
    pub func SheetCount(): int: ret this.sheets.Len() end

    pub func sheet_count(): int: ret this.SheetCount() end

    @en "sheet_names"
    @fa "نام برگه‌ها"
    pub func SheetNames(): Vector<str>:
        mut out := Vector {} as Vector<str>
        mut i := 0
        until i < this.sheets.Len():
            out.push(this.sheets.get(i).name)
            i++
        end
        ret out
    end

    pub func sheet_names(): Vector<str>: ret this.SheetNames() end

    @en "sheet_at"
    @fa "برگه در"
    pub func SheetAt(idx: int): Sheet*:
        if idx < 0 or idx >= this.sheets.Len(): ret null end
        ret this.sheets.ref(idx)
    end

    pub func sheet_at(idx: int): Sheet*: ret this.SheetAt(idx) end

    @en "sheet"
    @fa "برگه"
    pub func Sheet(name: str): Sheet*:
        ret this.sheet_at(this.sheet_index(name))
    end

    pub func sheet(name: str): Sheet*: ret this.Sheet(name) end

    @en "active"
    @fa "برگه فعال"
    pub func Active(): Sheet*:
        ret this.sheet_at(this.active_sheet)
    end

    pub func active(): Sheet*: ret this.Active() end

    @en "set_active"
    @fa "تنظیم برگه فعال"
    pub func SetActive(idx: int): bool:
        if idx < 0 or idx >= this.sheets.Len(): ret false end
        this.active_sheet = idx
        ret true
    end

    pub func set_active(idx: int): bool: ret this.SetActive(idx) end

    @en "save"
    @fa "ذخیره"
    pub func Save(path: str): bool:
        ret Save(this[0], path)
    end

    pub func save(path: str): bool: ret this.Save(path) end

    @en "free"
    @fa "آزادسازی"
    pub func Free():
        mut i := 0
        until i < this.sheets.Len():
            this.sheets.ref(i)[0].free()
            i++
        end
        this.sheets.free()
        this.styles.free()
    end

    pub func free(): this.Free() end
end

@en "NewWorkbook"
@fa "کتاب کار جدید"
pub func NewWorkbook(): Workbook:
    ret Workbook {}
end
