package excel

// Legacy .xls (BIFF, pre-2007 Excel binary format wrapped in an OLE2/
// Compound File Binary compound document) is intentionally NOT parsed:
// CFB directory parsing plus BIFF8 record decoding (dozens of record
// types, several distinct cell-value encodings, and either a workbook-
// global or per-sheet compressed/uncompressed string table) is a large
// undertaking in its own right, and unlike ZIP/TAR/GZIP - or this
// package's own .xlsx/.ods, both plain XML+ZIP and so verifiable by
// re-parsing what was just written - there was no real .xls file or tool
// available in this environment to validate a hand-written parser
// against. Rather than ship unverified binary-format parsing that could
// silently misread a real file, IsXLS only detects the container format
// (so excel.Open's extension-based dispatch still routes .xls somewhere),
// and ReadXLS reports a clear, actionable failure instead of guessing.
//
// There is no .xls writer either, for the same reason: every other
// format here can be checked by reading back what was just written; a
// from-scratch BIFF writer would have no equivalent way to confirm Excel
// itself would accept its output.

func _ole2_sig_match(p: void*, n: int): bool:
    if n < 8: ret false end
    bp := p as u8*
    ret bp[0] as int == 0xd0 && bp[1] as int == 0xcf && bp[2] as int == 0x11 && bp[3] as int == 0xe0 && bp[4] as int == 0xa1 && bp[5] as int == 0xb1 && bp[6] as int == 0x1a && bp[7] as int == 0xe1
end

// True if `p`/`n` starts with the OLE2/CFB signature every legacy .xls
// file uses (D0 CF 11 E0 A1 B1 1A E1). This detects the container format
// only - it does not confirm the CFB actually contains a BIFF "Workbook"
// stream (other CFB-based formats, like old .doc/.ppt, share the same
// signature), since that would require the directory parsing this package
// does not implement.
@en "IsXLS"
@fa "آیا ایکس‌ال‌اس است"
@ar "هل هو إكس إل إس"
pub func IsXLS(p: void*, n: int): bool:
    ret _ole2_sig_match(p, n)
end

// Always fails: legacy .xls reading is not implemented (see this file's
// header comment for why). `ok` is set to false and `err` to an
// actionable message recommending conversion to .xlsx/.ods. Kept as a
// real function - not a compile-time error - so excel.Open's format
// dispatch stays uniform across every extension it recognizes.
@en "ReadXLS"
@fa "خواندن ایکس‌ال‌اس"
@ar "قراءة إكس إل إس"
pub func ReadXLS(path: str, ok &: bool, err &: str): Workbook:
    ok = false
    err = "legacy .xls file '".concat(path).concat(`' is not supported (BIFF binary format); convert it to .xlsx or .ods (e.g. via LibreOffice or Excel's "Save As") and open that instead`)
    ret NewWorkbook()
end
