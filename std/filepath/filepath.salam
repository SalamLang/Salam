@en "filepath"
@fa "مسیر پرونده"
package filepath

import mem
import str

if SALAM_OS_WINDOWS:
    extern:
        func GetCurrentDirectoryA(sz: int, buf: void*): int
    end
else:
    extern:
        func getcwd(buf: void*, sz: int): void*
    end
end

@en "Separator"
@fa "جداکننده"
pub const Separator := "/"

inline func _fp_sep(c: int): bool: ret c == 47 or c == 92 end

inline func _fp_end(c: int): bool: ret c == 0 or c == 47 or c == 92 end

inline func _fp_drive_len(src: u8*, n: int): int:
    if n >= 2:
        c := src[0] as int
        if ((c >= 65 and c <= 90) or (c >= 97 and c <= 122)) and src[1] as int == 58:
            if n >= 3 and _fp_sep(src[2] as int):
                ret 3
            end
            ret 2
        end
    end
    ret 0
end

func _fp_put(dst: u8*, at: int, src: u8*, from: int, n: int):
    repeat n in i:
        c := src[from + i]
        dst[at + i] = c as int == 92 ? 47 as u8 : c
    end
end

func _fp_cwd(): str:
    buf := mem.Allocate(2048 as u64)
    mut s := str.Clone("")
    if SALAM_OS_WINDOWS:
        n := GetCurrentDirectoryA(2048, buf)
        if n > 0 and n < 2048:
            t := str.Clone(buf as str)
            mem.Free(s as void*)
            s = t
        end
    else:
        r := getcwd(buf, 2048)
        if r != null:
            t := str.Clone(r as str)
            mem.Free(s as void*)
            s = t
        end
    end
    mem.Free(buf)
    ret s
end

func _fp_segments(p: str): Vector<str>:
    parts := p.split("/")
    defer parts.Free()
    out := Vector {} as Vector<str>
    repeat parts.Len() in i:
        seg := parts.get(i)
        if seg.Len() > 0:
            out.push(seg)
        else:
            mem.Free(seg as void*)
        end
    end
    ret out
end

func _fp_free_segments(v &: Vector<str>):
    repeat v.Len() in i:
        mem.Free(v.get(i) as void*)
    end
    v.Free()
end

@en "Normalize"
@fa "نرمال سازی"
pub func Normalize(p: str): str:
    n := p.Len()
    out := mem.Allocate((n + 1) as u64) as u8*
    _fp_put(out, 0, p as u8*, 0, n)
    out[n] = 0 as u8
    ret out as str
end

@en "IsAbs"
@fa "مطلق است"
pub func IsAbs(p: str): bool:
    n := p.Len()
    if n == 0: ret false end
    src := p as u8*
    if _fp_sep(src[0] as int): ret true end
    ret _fp_drive_len(src, n) == 3
end

@en "Join"
@fa "پیوند"
pub func Join(a: str, b: str): str:
    na := a.Len()
    nb := b.Len()
    if na == 0: ret Normalize(b) end
    if nb == 0: ret Normalize(a) end
    ap := a as u8*
    bp := b as u8*
    out := mem.Allocate((na + nb + 2) as u64) as u8*
    _fp_put(out, 0, ap, 0, na)
    mut w := na
    a_sep := _fp_sep(ap[na - 1] as int)
    b_sep := _fp_sep(bp[0] as int)
    mut from := 0
    if a_sep and b_sep:
        from = 1
    else not a_sep and not b_sep:
        out[w] = 47 as u8
        w++
    end
    _fp_put(out, w, bp, from, nb - from)
    out[w + nb - from] = 0 as u8
    ret out as str
end

@en "Base"
@fa "نام پایه"
pub func Base(p: str): str:
    mut q := Normalize(p)
    dlen := _fp_drive_len(q as u8*, q.Len())
    if dlen == 3 and q.Len() == 3:
        mem.Free(q as void*)
        ret str.Clone("/")
    end
    until q.Len() > 1 and str.EndsWith(q, "/"):
        if dlen == 3 and q.Len() <= 3:
            break
        end
        shorter := q.substr(0, q.Len() - 1)
        mem.Free(q as void*)
        q = shorter
    end
    if q == "/" or (dlen == 3 and q.Len() == 3):
        mem.Free(q as void*)
        ret str.Clone("/")
    else q.Len() == 0:
        mem.Free(q as void*)
        ret str.Clone(".")
    end
    idx := str.LastIndex(q, "/")
    if idx < 0: ret q end
    out := q.substr(idx + 1, q.Len() - idx - 1)
    mem.Free(q as void*)
    ret out
end

@en "Dir"
@fa "پوشه"
pub func Dir(p: str): str:
    mut q := Normalize(p)
    dlen := _fp_drive_len(q as u8*, q.Len())
    if dlen == 3 and q.Len() == 3:
        ret q
    end
    until q.Len() > 1 and str.EndsWith(q, "/"):
        if dlen == 3 and q.Len() <= 3:
            break
        end
        t := q.substr(0, q.Len() - 1)
        mem.Free(q as void*)
        q = t
    end
    if dlen == 3 and q.Len() == 3:
        ret q
    end
    idx := str.LastIndex(q, "/")
    mut out := ""
    if idx < 0:
        if dlen == 2:
            out = q.substr(0, 2)
        else:
            out = str.Clone(".")
        end
    else idx == 0:
        out = str.Clone("/")
    else dlen == 3 and idx == 2:
        out = q.substr(0, 3)
    else:
        out = q.substr(0, idx)
    end
    mem.Free(q as void*)
    ret out
end

@en "Ext"
@fa "پسوند"
pub func Ext(p: str): str:
    b := Base(p)
    idx := str.LastIndex(b, ".")
    if idx <= 0:
        mem.Free(b as void*)
        ret str.Clone("")
    end
    out := b.substr(idx, b.Len() - idx)
    mem.Free(b as void*)
    ret out
end

@en "Stem"
@fa "نام بدون پسوند"
pub func Stem(p: str): str:
    b := Base(p)
    idx := str.LastIndex(b, ".")
    if idx <= 0: ret b end
    out := b.substr(0, idx)
    mem.Free(b as void*)
    ret out
end

@en "Clean"
@fa "پاک سازی"
pub func Clean(p: str): str:
    n := p.Len()
    if n == 0: ret str.Clone(".") end
    src := p as u8*
    out := mem.Allocate((n + 3) as u64) as u8*
    dlen := _fp_drive_len(src, n)
    mut rooted := false
    mut r := 0
    mut w := 0
    mut dotdot := 0
    if dlen == 3:
        out[0] = src[0]
        out[1] = 58 as u8
        out[2] = 47 as u8
        w = 3
        r = 3
        rooted = true
        dotdot = 3
    else dlen == 2:
        out[0] = src[0]
        out[1] = 58 as u8
        w = 2
        r = 2
        dotdot = 2
    else _fp_sep(src[0] as int):
        out[0] = 47 as u8
        w = 1
        r = 1
        rooted = true
        dotdot = 1
    end
    until r < n:
        c := src[r] as int
        if _fp_sep(c):
            r++
        else c == 46 and _fp_end(src[r + 1] as int):
            r++
        else c == 46 and src[r + 1] as int == 46 and _fp_end(src[r + 2] as int):
            r += 2
            if w > dotdot:
                w--
                until w > dotdot and out[w] as int != 47:
                    w--
                end
            else not rooted:
                if (dlen == 2 and w > 2) or (dlen != 2 and w > 0):
                    out[w] = 47 as u8
                    w++
                end
                out[w] = 46 as u8
                out[w + 1] = 46 as u8
                w += 2
                dotdot = w
            end
        else:
            if (rooted and w != dotdot) or (not rooted and w != dlen):
                out[w] = 47 as u8
                w++
            end
            until r < n and not _fp_sep(src[r] as int):
                out[w] = src[r]
                w++
                r++
            end
        end
    end
    if w == 0:
        out[0] = 46 as u8
        w = 1
    end
    out[w] = 0 as u8
    ret out as str
end

@en "Abs"
@fa "مسیر مطلق"
pub func Abs(p: str): str:
    if IsAbs(p): ret Clean(p) end
    cwd := _fp_cwd()
    defer mem.Free(cwd as void*)
    j := Join(cwd, p)
    defer mem.Free(j as void*)
    ret Clean(j)
end

@en "Rel"
@fa "مسیر نسبی"
pub func Rel(base: str, target: str): str:
    ab := Abs(base)
    defer mem.Free(ab as void*)
    at := Abs(target)
    defer mem.Free(at as void*)
    bs := _fp_segments(ab)
    defer _fp_free_segments(bs)
    ts := _fp_segments(at)
    defer _fp_free_segments(ts)
    mut common := 0
    until common < bs.Len() and common < ts.Len() and bs.get(common) == ts.get(common):
        common++
    end
    out := Vector {} as Vector<str>
    defer out.Free()
    mut up := common
    until up < bs.Len():
        out.push(str.Clone(".."))
        up++
    end
    mut i := common
    until i < ts.Len():
        out.push(str.Clone(ts.get(i)))
        i++
    end
    if out.Len() == 0: ret str.Clone(".") end
    result := str.Join(out, "/")
    repeat out.Len() in j:
        mem.Free(out.get(j) as void*)
    end
    ret result
end

@en "Validate"
@fa "اعتبارسنجی مسیر"
pub func Validate(p: str): bool:
    ret p.Len() > 0
end

@en "IsSafe"
@fa "مسیر امن است"
pub func IsSafe(base: str, p: str): bool:
    if Validate(p) == false: ret false end
    ab := Abs(base)
    defer mem.Free(ab as void*)
    b := Clean(ab)
    defer mem.Free(b as void*)
    j := Join(b, p)
    defer mem.Free(j as void*)
    full := Clean(j)
    defer mem.Free(full as void*)
    if full == b: ret true end
    prefix := b.concat("/")
    defer mem.Free(prefix as void*)
    ret str.StartsWith(full, prefix)
end
