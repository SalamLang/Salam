@en "filepath"
@fa "مسیر پرونده"
@ar "مسار الملف"
package filepath

import mem
import str

if SALAM_OS_WINDOWS:
    extern:
        func GetCurrentDirectoryA(sz: int, buf: void*): int
    end
else:
    extern:
        func getcwd(buf: void*, sz: int): void*
    end
end

@en "Separator"
@fa "جداکننده"
@ar "فاصل"
pub const Separator := "/"

func _fp_cwd(): str:
    buf := mem.Allocate(2048 as u64)
    mut s := ""
    if SALAM_OS_WINDOWS:
        n := GetCurrentDirectoryA(2048, buf)
        if n > 0 && n < 2048: s = str.Clone(buf as str) end
    else:
        r := getcwd(buf, 2048)
        if r != null: s = str.Clone(r as str) end
    end
    mem.Free(buf)
    ret s
end

func _fp_segments(p: str): Vector<str>:
    parts := p.split("/")
    defer parts.free()
    out := Vector {} as Vector<str>
    repeat parts.len() with i:
        seg := parts.get(i)[0]
        if seg.len() > 0:
            out.push(seg)
        end
    end
    ret out
end

@en "Normalize"
@fa "نرمال سازی"
@ar "تسویة"
pub func Normalize(p: str): str:
    ret str.Replace(p, "\\", "/")
end

@en "IsAbs"
@fa "مطلق است"
@ar "هل مطلق"
pub func IsAbs(p: str): bool:
    q := Normalize(p)
    if str.StartsWith(q, "/"): ret true
    else q.len() >= 2 && q.substr(1, 1) == ":":
        c := char_code(q.substr(0, 1))
        ret str.IsAlpha(c)
    end
    ret false
end

@en "Join"
@fa "پیوند"
@ar "دمج"
pub func Join(a: str, b: str): str:
    if a.len() == 0: ret Normalize(b) end
    if b.len() == 0: ret Normalize(a) end
    x := Normalize(a)
    y := Normalize(b)
    if str.EndsWith(x, "/"):
        if str.StartsWith(y, "/"):
            ret x.concat(y.substr(1, y.len() - 1))
        end
        ret x.concat(y)
    end
    if str.StartsWith(y, "/"):
        ret x.concat(y)
    end
    ret x.concat("/").concat(y)
end

@en "Base"
@fa "نام پایه"
@ar "الاسم الأساسی"
pub func Base(p: str): str:
    mut q := Normalize(p)
    until q.len() > 1 && str.EndsWith(q, "/"):
        q = q.substr(0, q.len() - 1)
    end
    if q == "/": ret "/"
    else q.len() == 0: ret "."
    end
    idx := str.LastIndex(q, "/")
    if idx < 0: ret q end
    ret q.substr(idx + 1, q.len() - idx - 1)
end

@en "Dir"
@fa "پوشه"
@ar "مجلد"
pub func Dir(p: str): str:
    mut q := Normalize(p)
    until q.len() > 1 && str.EndsWith(q, "/"):
        q = q.substr(0, q.len() - 1)
    end
    idx := str.LastIndex(q, "/")
    if idx < 0: ret "." end
    if idx == 0: ret "/" end
    ret q.substr(0, idx)
end

@en "Ext"
@fa "پسوند"
@ar "امتداد"
pub func Ext(p: str): str:
    b := Base(p)
    idx := str.LastIndex(b, ".")
    if idx <= 0: ret "" end
    ret b.substr(idx, b.len() - idx)
end

@en "Stem"
@fa "نام بدون پسوند"
@ar "اسم بدون امتداد"
pub func Stem(p: str): str:
    b := Base(p)
    idx := str.LastIndex(b, ".")
    if idx <= 0: ret b end
    ret b.substr(0, idx)
end

@en "Clean"
@fa "پاک سازی"
@ar "تنظیف"
pub func Clean(p: str): str:
    q := Normalize(p)
    if q.len() == 0: ret "." end
    abs := str.StartsWith(q, "/")
    parts := q.split("/")
    defer parts.free()
    kept := Vector {} as Vector<str> defer kept.free()
    repeat parts.len() with i:
        seg := parts.get(i)[0]
        if seg.len() > 0 && seg != ".":
            if seg == "..":
                if kept.len() > 0 && kept.last() != "..":
                    kept.pop()
                else:
                    if abs == false:
                        kept.push(seg)
                    end
                end
            else:
                kept.push(seg)
            end
        end
    end
    out := str.Join(kept, "/")
    if abs: ret "/".concat(out) end
    if out.len() == 0: ret "." end
    ret out
end

@en "Abs"
@fa "مسیر مطلق"
@ar "مسار مطلق"
pub func Abs(p: str): str:
    if IsAbs(p): ret Clean(p) end
    cwd := _fp_cwd()
    ret Clean(Join(cwd, p))
end

@en "Rel"
@fa "مسیر نسبی"
@ar "مسار نسبی"
pub func Rel(base: str, target: str): str:
    ab := Abs(base)
    at := Abs(target)
    bs := _fp_segments(ab)
    defer bs.free()
    ts := _fp_segments(at)
    defer ts.free()
    mut common := 0
    until common < bs.len() && common < ts.len() && bs.get(common)[0] == ts.get(common)[0]:
        common += 1
    end
    out := Vector {} as Vector<str>
    defer out.free()
    mut up := common
    until up < bs.len():
        out.push("..")
        up += 1
    end
    mut i := common
    until i < ts.len():
        out.push(ts.get(i)[0])
        i += 1
    end
    if out.len() == 0: ret "." end
    ret str.Join(out, "/")
end

@en "Validate"
@fa "اعتبارسنجی مسیر"
@ar "التحقق من المسار"
pub func Validate(p: str): bool:
    ret p.len() > 0
end

@en "IsSafe"
@fa "مسیر امن است"
@ar "هل المسار آمن"
pub func IsSafe(base: str, p: str): bool:
    if Validate(p) == false: ret false end
    b := Clean(Abs(base))
    full := Clean(Join(b, p))
    if full == b: ret true end
    prefix := b.concat("/")
    ret str.StartsWith(full, prefix)
end
