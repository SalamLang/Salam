@en "filepath"
@fa "مسیر پرونده"
@ar "مسار الملف"
package filepath

import mem
import str

if SALAM_OS_WINDOWS:
    extern:
        func GetCurrentDirectoryA(sz: int, buf: void*): int
    end
else:
    extern:
        func getcwd(buf: void*, sz: int): void*
    end
end

@en "Separator"
@fa "جداکننده"
@ar "فاصل"
pub const Separator := "/"

func _fp_cwd(): str:
    buf := mem.Allocate(2048 as u64)
    mut s := ""
    if SALAM_OS_WINDOWS:
        n := GetCurrentDirectoryA(2048, buf)
        if n > 0 && n < 2048: s = str.Clone(buf as str) end
    else:
        r := getcwd(buf, 2048)
        if r != null: s = str.Clone(r as str) end
    end
    mem.Free(buf)
    ret s
end

func _fp_segments(p: str): Vector<str>:
    parts := p.split("/")
    defer parts.free()
    out := Vector {} as Vector<str>
    repeat parts.len() with i:
        seg := parts.get(i)
        if seg.len() > 0:
            out.push(seg)
        end
    end
    ret out
end

@en "Normalize"
@fa "نرمال سازی"
@ar "تسویة"
pub func Normalize(p: str): str:
    ret str.Replace(p, "\\", "/")
end

@en "IsAbs"
@fa "مطلق است"
@ar "هل مطلق"
pub func IsAbs(p: str): bool:
    q := Normalize(p)
    if str.StartsWith(q, "/"): ret true
    else q.len() >= 2 && q.substr(1, 1) == ":":
        c := char_code(q.substr(0, 1))
        ret str.IsAsciiAlpha(c)
    end
    ret false
end

@en "Join"
@fa "پیوند"
@ar "دمج"
// Returns a heap string the CALLER owns and must free.
pub func Join(a: str, b: str): str:
    if a.len() == 0: ret Normalize(b) end
    if b.len() == 0: ret Normalize(a) end
    x := Normalize(a)
    y := Normalize(b)
    mut out := ""
    if str.EndsWith(x, "/") && str.StartsWith(y, "/"):
        tail := y.substr(1, y.len() - 1)
        out = x.concat(tail)
        mem.Free(tail as void*)
    else str.EndsWith(x, "/") || str.StartsWith(y, "/"):
        out = x.concat(y)
    else:
        // One concat, not two: `x.concat("/").concat(y)` throws away the
        // intermediate that holds x + "/".
        mut sb := str.NewBuilder()
        str.BufAppend(sb, x)
        str.BufAppend(sb, "/")
        str.BufAppend(sb, y)
        out = str.BufStr(sb)
        str.BufFree(sb)
    end
    mem.Free(x as void*)
    mem.Free(y as void*)
    ret out
end

@en "Base"
@fa "نام پایه"
@ar "الاسم الأساسی"
// Returns a heap string the CALLER owns and must free, in every branch.
pub func Base(p: str): str:
    mut q := Normalize(p)
    until q.len() > 1 && str.EndsWith(q, "/"):
        shorter := q.substr(0, q.len() - 1)
        mem.Free(q as void*)
        q = shorter
    end
    if q == "/":
        mem.Free(q as void*)
        ret str.Clone("/")
    else q.len() == 0:
        mem.Free(q as void*)
        ret str.Clone(".")
    end
    idx := str.LastIndex(q, "/")
    if idx < 0: ret q end
    out := q.substr(idx + 1, q.len() - idx - 1)
    mem.Free(q as void*)
    ret out
end

@en "Dir"
@fa "پوشه"
@ar "مجلد"
pub func Dir(p: str): str:
    mut q := Normalize(p)
    until q.len() > 1 && str.EndsWith(q, "/"):
        q = q.substr(0, q.len() - 1)
    end
    idx := str.LastIndex(q, "/")
    if idx < 0: ret "." end
    if idx == 0: ret "/" end
    ret q.substr(0, idx)
end

@en "Ext"
@fa "پسوند"
@ar "امتداد"
// Returns a heap string the CALLER owns and must free, "" included.
pub func Ext(p: str): str:
    b := Base(p)
    idx := str.LastIndex(b, ".")
    if idx <= 0:
        mem.Free(b as void*)
        ret str.Clone("")
    end
    out := b.substr(idx, b.len() - idx)
    mem.Free(b as void*)
    ret out
end

@en "Stem"
@fa "نام بدون پسوند"
@ar "اسم بدون امتداد"
pub func Stem(p: str): str:
    b := Base(p)
    idx := str.LastIndex(b, ".")
    if idx <= 0: ret b end
    ret b.substr(0, idx)
end

@en "Clean"
@fa "پاک سازی"
@ar "تنظیف"
// Returns a heap string the CALLER owns and must free, in every branch.
//
// `parts.free()` releases the vector's backing array and nothing else: split
// heap-allocates each piece, and dropping the vector abandoned every one of
// them. On net/http's static-file route that was a dozen small strings per
// request, which is what made serving a stylesheet leak more than serving a
// JSON body.
pub func Clean(p: str): str:
    q := Normalize(p)
    if q.len() == 0:
        mem.Free(q as void*)
        ret str.Clone(".")
    end
    abs := str.StartsWith(q, "/")
    parts := q.split("/")
    kept := Vector {} as Vector<str> defer kept.free()
    repeat parts.len() with i:
        seg := parts.get(i)
        if seg.len() > 0 && seg != ".":
            if seg == "..":
                if kept.len() > 0 && kept.last() != "..":
                    kept.pop()
                else:
                    if abs == false:
                        kept.push(seg)
                    end
                end
            else:
                kept.push(seg)
            end
        end
    end
    // Join copies what it needs, so the pieces can go once it has run. `kept`
    // only ever holds pointers that came out of `parts`.
    out := str.Join(kept, "/")
    repeat parts.len() with i:
        mem.Free(parts.get(i) as void*)
    end
    parts.free()
    mem.Free(q as void*)
    if abs:
        rooted := "/".concat(out)
        mem.Free(out as void*)
        ret rooted
    end
    if out.len() == 0:
        mem.Free(out as void*)
        ret str.Clone(".")
    end
    ret out
end

@en "Abs"
@fa "مسیر مطلق"
@ar "مسار مطلق"
pub func Abs(p: str): str:
    if IsAbs(p): ret Clean(p) end
    cwd := _fp_cwd()
    ret Clean(Join(cwd, p))
end

@en "Rel"
@fa "مسیر نسبی"
@ar "مسار نسبی"
pub func Rel(base: str, target: str): str:
    ab := Abs(base)
    at := Abs(target)
    bs := _fp_segments(ab)
    defer bs.free()
    ts := _fp_segments(at)
    defer ts.free()
    mut common := 0
    until common < bs.len() && common < ts.len() && bs.get(common) == ts.get(common):
        common += 1
    end
    out := Vector {} as Vector<str>
    defer out.free()
    mut up := common
    until up < bs.len():
        out.push("..")
        up += 1
    end
    mut i := common
    until i < ts.len():
        out.push(ts.get(i))
        i += 1
    end
    if out.len() == 0: ret "." end
    ret str.Join(out, "/")
end

@en "Validate"
@fa "اعتبارسنجی مسیر"
@ar "التحقق من المسار"
pub func Validate(p: str): bool:
    ret p.len() > 0
end

@en "IsSafe"
@fa "مسیر امن است"
@ar "هل المسار آمن"
pub func IsSafe(base: str, p: str): bool:
    if Validate(p) == false: ret false end
    b := Clean(Abs(base))
    full := Clean(Join(b, p))
    if full == b: ret true end
    prefix := b.concat("/")
    ret str.StartsWith(full, prefix)
end
