package filepath

func _gl_len(lead: int): int:
    if lead >= 240: ret 4 end
    if lead >= 224: ret 3 end
    if lead >= 192: ret 2 end
    ret 1
end

func _gl_cp(bp: u8*, n: int, at: int): int:
    lead := bp[at] as int
    size := _gl_len(lead)
    if size == 1 or at + size > n:
        ret lead
    end
    mut cp := 0
    if size == 2:
        cp = lead & 31
    else size == 3:
        cp = lead & 15
    else:
        cp = lead & 7
    end
    repeat size - 1 in k:
        cp = (cp << 6) | ((bp[at + 1 + k] as int) & 63)
    end
    ret cp
end

func _gl_class(pp: u8*, pn: int, open: int, cp: int, after &: int): bool:
    mut i := open + 1
    mut negate := false
    if i < pn and (pp[i] == 33 or pp[i] == 94):
        negate = true
        i++
    end
    mut hit := false
    mut first := true
    until i < pn and (pp[i] != 93 or first):
        first = false
        mut lo := 0
        if pp[i] == 92 and i + 1 < pn:
            i++
        end
        lo = _gl_cp(pp, pn, i)
        i += _gl_len(pp[i] as int)
        mut hi := lo
        if i + 1 < pn and pp[i] == 45 and pp[i + 1] != 93:
            i++
            if pp[i] == 92 and i + 1 < pn:
                i++
            end
            hi = _gl_cp(pp, pn, i)
            i += _gl_len(pp[i] as int)
        end
        if cp >= lo and cp <= hi:
            hit = true
        end
    end
    if i >= pn:
        after = 0 - 1
        ret false
    end
    after = i + 1
    ret hit != negate
end

func _gl_match(pp: u8*, pn: int, pi: int, sp: u8*, sn: int, si: int): bool:
    mut p := pi
    mut s := si
    until p < pn:
        c := pp[p] as int
        if c == 42:
            mut stars := 0
            until p < pn and pp[p] == 42:
                stars++
                p++
            end
            deep := stars >= 2
            mut dirs := false
            if deep and p < pn and pp[p] == 47:
                dirs = true
                p++
            end
            if p >= pn:
                if deep: ret true end
                mut k := s
                until k < sn:
                    if sp[k] == 47: ret false end
                    k++
                end
                ret true
            end
            mut k := s
            until k <= sn:
                if not dirs or k == s or sp[k - 1] == 47:
                    if _gl_match(pp, pn, p, sp, sn, k):
                        ret true
                    end
                end
                if k < sn and sp[k] == 47 and not deep:
                    break
                end
                if k < sn:
                    k += _gl_len(sp[k] as int)
                else:
                    k++
                end
            end
            ret false
        end
        if s >= sn:
            ret false
        end
        if c == 63:
            if sp[s] == 47: ret false end
            s += _gl_len(sp[s] as int)
            p++
        else c == 91:
            if sp[s] == 47: ret false end
            mut after := 0
            ok := _gl_class(pp, pn, p, _gl_cp(sp, sn, s), after)
            if after < 0 or not ok: ret false end
            s += _gl_len(sp[s] as int)
            p = after
        else:
            mut lit := p
            if c == 92 and p + 1 < pn:
                lit = p + 1
            end
            if pp[lit] != sp[s]: ret false end
            p = lit + 1
            s++
        end
    end
    ret s >= sn
end

@en "Match"
@fa "تطبیق الگو"
pub func Match(pattern: str, name: str): bool:
    ret _gl_match(pattern as u8*, pattern.Len(), 0, name as u8*, name.Len(), 0)
end

@en "HasMeta"
@fa "الگو دارد"
pub func HasMeta(pattern: str): bool:
    n := pattern.Len()
    bp := pattern as u8*
    repeat n in i:
        c := bp[i]
        if c == 42 or c == 63 or c == 91 or c == 92:
            ret true
        end
    end
    ret false
end
