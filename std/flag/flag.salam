@en "flag"
@fa "پرچم"
package flag

import str
import conv
import collections

@en "FlagKindBool"
@fa "نوع منطقی"
pub const FlagKindBool := 0

@en "FlagKindStr"
@fa "نوع رشته"
pub const FlagKindStr := 1

@en "FlagKindInt"
@fa "نوع صحیح"
pub const FlagKindInt := 2

@en "FlagKindFloat"
@fa "نوع اعشاری"
pub const FlagKindFloat := 3

@en "FlagSet"
@fa "مجموعه پرچم"
pub struct FlagSet:
    @en "prog"
    @fa "برنامه"
    pub prog: str = ""
    @en "desc"
    @fa "شرح"
    pub desc: str = ""
    @en "names"
    @fa "نام‌ها"
    pub names: Vector<str> = Vector {}
    @en "shorts"
    @fa "نام‌های کوتاه"
    pub shorts: Vector<str> = Vector {}
    @en "kinds"
    @fa "گونه‌ها"
    pub kinds: Vector<int> = Vector {}
    @en "vals"
    @fa "مقدارها"
    pub vals: Vector<str> = Vector {}
    @en "defs"
    @fa "پیش‌فرض‌ها"
    pub defs: Vector<str> = Vector {}
    @en "helps"
    @fa "راهنماها"
    pub helps: Vector<str> = Vector {}
    @en "was_set"
    @fa "تنظیم‌شده"
    pub was_set: Vector<bool> = Vector {}
    @en "pos"
    @fa "موقعیتی‌ها"
    pub pos: Vector<str> = Vector {}
    @en "err"
    @fa "خطا"
    pub err: str = ""
    @en "help_wanted"
    @fa "راهنما خواسته شد"
    pub help_wanted: bool = false
end

func _register(fs &: FlagSet, name: str, short: str, kind: int, def: str, help: str):
    fs.names.Push(name)
    fs.shorts.Push(short)
    fs.kinds.Push(kind)
    fs.defs.Push(def)
    fs.vals.Push(def)
    fs.helps.Push(help)
    fs.was_set.Push(false)
end

func _find(fs &: FlagSet, name: str): int:
    repeat fs.names.Len() in i:
        if fs.names.Get(i) == name: ret i end
    end
    ret 0 - 1
end

func _find_short(fs &: FlagSet, short: str): int:
    repeat fs.shorts.Len() in i:
        s := fs.shorts.Get(i)
        if s.Len() > 0 and s == short: ret i end
    end
    ret 0 - 1
end

func _assign(fs &: FlagSet, idx: int, val: str):
    fs.vals.Set(idx, val)
    fs.was_set.Set(idx, true)
end

func _valid_number(raw: str, kind: int): bool:
    t := str.Replace(str.ToEnglishDigits(str.Trim(raw)), "٫", ".")
    n := t.Len()
    mut i := 0
    if n > 0 and (t.StartsWith("-") or t.StartsWith("+")):
        i = 1
    end
    mut digits := 0
    mut dots := 0
    mut exp := false
    until i < n:
        c := t.Substr(i, 1)
        if str.IsAsciiDigit(char_code(c)):
            digits++
        else kind == 3 and c == "." and dots == 0 and not exp:
            dots++
        else kind == 3 and (c == "e" or c == "E") and digits > 0 and not exp:
            exp = true
            if i + 1 < n and (t.Substr(i + 1, 1) == "-" or t.Substr(i + 1, 1) == "+"):
                i++
            end
        else:
            ret false
        end
        i++
    end
    ret digits > 0
end

func _kind_hint(kind: int): str:
    if kind == 1: ret " <string>"
    else kind == 2: ret " <int>"
    else kind == 3: ret " <float>"
    else:
        ret ""
    end
end

@en "New"
@fa "جدید"
pub func New(prog_name: str, description: str): FlagSet:
    fs := FlagSet {}
    fs.prog = prog_name
    fs.desc = description
    ret fs
end

@en "AddBool"
@fa "افزودن منطقی"
pub func AddBool(fs &: FlagSet, name: str, short: str, def: bool, help: str):
    _register(fs, name, short, 0, conv.FormatBool(def), help)
end

@en "AddStr"
@fa "افزودن رشته"
pub func AddStr(fs &: FlagSet, name: str, short: str, def: str, help: str):
    _register(fs, name, short, 1, def, help)
end

@en "AddInt"
@fa "افزودن صحیح"
pub func AddInt(fs &: FlagSet, name: str, short: str, def: i64, help: str):
    _register(fs, name, short, 2, conv.FormatInt(def), help)
end

@en "AddFloat"
@fa "افزودن اعشاری"
pub func AddFloat(fs &: FlagSet, name: str, short: str, def: f64, help: str):
    _register(fs, name, short, 3, conv.FormatFloat(def), help)
end

@en "Parse"
@fa "تجزیه"
pub func Parse(fs &: FlagSet, arglist: Vector<str>): bool:
    fs.err = ""
    mut i := 0
    mut only_pos := false
    until i < arglist.Len():
        arg := arglist.Get(i)
        if only_pos:
            fs.pos.Push(arg)
            i++
        else:
            if arg == "--":
                only_pos = true
                i++
            else:
                if str.StartsWith(arg, "--") or (str.StartsWith(arg, "-") and arg.Len() > 1):
                    mut body := arg.Substr(1, arg.Len() - 1)
                    mut long := false
                    if str.StartsWith(arg, "--"):
                        body = arg.Substr(2, arg.Len() - 2)
                        long = true
                    end
                    mut name := body
                    mut inline_val := ""
                    mut has_inline := false
                    eq_at := body.Find("=")
                    if eq_at >= 0:
                        name = body.Substr(0, eq_at)
                        inline_val = body.Substr(eq_at + 1, body.Len() - eq_at - 1)
                        has_inline = true
                    end
                    if name == "help" or name == "h":
                        fs.help_wanted = true
                        i++
                    else:
                        mut idx := 0 - 1
                        if long:
                            idx = _find(fs, name)
                        else:
                            idx = _find_short(fs, name)
                            if idx < 0: idx = _find(fs, name) end
                        end
                        if idx < 0:
                            fs.err = "unknown flag: ".Concat(arg)
                            ret false
                        end
                        if fs.kinds.Get(idx) == 0:
                            if has_inline:
                                _assign(fs, idx, inline_val)
                            else:
                                _assign(fs, idx, "true")
                            end
                            i++
                        else:
                            if has_inline:
                                _assign(fs, idx, inline_val)
                                i++
                            else:
                                if i + 1 >= arglist.Len():
                                    fs.err = "missing value for flag: ".Concat(arg)
                                    ret false
                                end
                                _assign(fs, idx, arglist.Get(i + 1))
                                i += 2
                            end
                        end
                    end
                else:
                    fs.pos.Push(arg)
                    i++
                end
            end
        end
    end
    repeat fs.names.Len() in k:
        kind := fs.kinds.Get(k)
        if (kind == 2 or kind == 3) and fs.was_set.Get(k) and not _valid_number(fs.vals.Get(k), kind):
            fs.err = "invalid " + (kind == 2 ? "int" : "float") + " value for --" + fs.names.Get(k) + ": " + fs.vals.Get(k)
            ret false
        end
    end
    ret true
end

@en "GetStr"
@fa "دریافت رشته"
pub func GetStr(fs &: FlagSet, name: str): str:
    idx := _find(fs, name)
    if idx < 0: ret "" end
    ret fs.vals.Get(idx)
end

@en "GetInt"
@fa "دریافت صحیح"
pub func GetInt(fs &: FlagSet, name: str): i64:
    idx := _find(fs, name)
    if idx < 0: ret 0 end
    ret conv.ParseIntOr(fs.vals.Get(idx), 0)
end

@en "GetFloat"
@fa "دریافت اعشاری"
pub func GetFloat(fs &: FlagSet, name: str): f64:
    idx := _find(fs, name)
    if idx < 0: ret 0.0 end
    ret conv.ParseFloatOr(fs.vals.Get(idx), 0.0)
end

@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(fs &: FlagSet, name: str): bool:
    idx := _find(fs, name)
    if idx < 0: ret false end
    ret conv.ParseBoolOr(fs.vals.Get(idx), false)
end

@en "WasSet"
@fa "تنظیم شده"
pub func WasSet(fs &: FlagSet, name: str): bool:
    idx := _find(fs, name)
    if idx < 0: ret false end
    ret fs.was_set.Get(idx)
end

@en "Positional"
@fa "موقعیتی"
pub func Positional(fs &: FlagSet): Vector<str>:
    ret collections.Clone(fs.pos)
end

@en "HelpWanted"
@fa "راهنما خواسته"
pub func HelpWanted(fs &: FlagSet): bool: ret fs.help_wanted end

@en "Error"
@fa "خطا"
pub func Error(fs &: FlagSet): str: ret fs.err end

@en "Usage"
@fa "راهنما"
pub func Usage(fs &: FlagSet): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, "Usage: ")
    str.BufAppend(b, fs.prog)
    str.BufAppend(b, " [options] [args]\n")
    if fs.desc.Len() > 0:
        str.BufAppend(b, "  ")
        str.BufAppend(b, fs.desc)
        str.BufAppend(b, "\n")
    end
    str.BufAppend(b, "Options:\n")
    repeat fs.names.Len() in i:
        str.BufAppend(b, "  ")
        short := fs.shorts.Get(i)
        if short.Len() > 0:
            str.BufAppend(b, "-")
            str.BufAppend(b, short)
            str.BufAppend(b, ", ")
        end
        str.BufAppend(b, "--")
        str.BufAppend(b, fs.names.Get(i))
        str.BufAppend(b, _kind_hint(fs.kinds.Get(i)))
        help := fs.helps.Get(i)
        if help.Len() > 0:
            str.BufAppend(b, "  ")
            str.BufAppend(b, help)
        end
        def := fs.defs.Get(i)
        if fs.kinds.Get(i) != 0 and def.Len() > 0:
            str.BufAppend(b, " (default: ")
            str.BufAppend(b, def)
            str.BufAppend(b, ")")
        end
        str.BufAppend(b, "\n")
    end
    str.BufAppend(b, "  -h, --help  show this help\n")
    out := str.BufStr(b)
    ret out
end

@en "Free"
@fa "آزادسازی"
pub func Free(fs &: FlagSet):
    fs.names.Free()
    fs.shorts.Free()
    fs.kinds.Free()
    fs.vals.Free()
    fs.defs.Free()
    fs.helps.Free()
    fs.was_set.Free()
    fs.pos.Free()
end
