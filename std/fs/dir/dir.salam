@en "dir"
@fa "پوشه"
@ar "المجلد"
package dir

import os
import fs
import fs.file
import fs.path
import os.error

@en "Mkdir"
@fa "ساخت پوشه"
@ar "إنشاء مجلد"
pub func Mkdir(p: str): int:
    if os.Mkdir(p) != 0:
        error.Set(error.IOError, "mkdir failed", "Mkdir", p, 0)
        ret 0 - 1
    end
    ret 0
end

@en "MkdirAll"
@fa "ساخت پوشه ها"
@ar "إنشاء المجلدات"
pub func MkdirAll(p: str): int:
    if os.MkdirAll(p) != 0:
        error.Set(error.IOError, "mkdir -p failed", "MkdirAll", p, 0)
        ret 0 - 1
    end
    ret 0
end

@en "Remove"
@fa "حذف"
@ar "إزالة"
pub func Remove(p: str): int:
    if os.Rmdir(p) != 0:
        error.Set(error.IOError, "rmdir failed", "Remove", p, 0)
        ret 0 - 1
    end
    ret 0
end

@en "RemoveAll"
@fa "حذف همه"
@ar "إزالة الکل"
pub func RemoveAll(p: str): int:
    if os.RemoveAll(p) != 0:
        error.Set(error.IOError, "recursive remove failed", "RemoveAll", p, 0)
        ret 0 - 1
    end
    ret 0
end

@en "List"
@fa "فهرست"
@ar "سرد"
pub func List(p: str): Vector<str>: ret os.ListDir(p) end

@en "ListDirs"
@fa "فهرست پوشه ها"
@ar "سرد المجلدات"
pub func ListDirs(p: str): Vector<str>: ret os.ListDirs(p) end

@en "ListFiles"
@fa "فهرست پرونده ها"
@ar "سرد الملفات"
pub func ListFiles(p: str): Vector<str>:
    entries := os.ListDir(p)
    defer entries.free()
    out := Vector {} as Vector<str>
    repeat entries.len() with i:
        name := entries.get(i)[0]
        full := path.Join(p, name)
        if os.IsDir(full) == false:
            out.push(name)
        end
    end
    ret out
end

@en "Walk"
@fa "پیمایش"
@ar "اجتیاز"
pub func Walk(p: str): Vector<str>: ret os.Walk(p) end

@en "Copy"
@fa "کپی"
@ar "نسخ"
pub func Copy(src: str, dst: str): int:
    if os.CopyTree(src, dst) != 0:
        error.Set(error.IOError, "copy tree failed", "Copy", src, 0)
        ret 0 - 1
    end
    ret 0
end

@en "Move"
@fa "جابجایی"
@ar "نقل"
pub func Move(src: str, dst: str): int:
    if os.Move(src, dst) == 0: ret 0 end
    if os.CopyTree(src, dst) != 0:
        error.Set(error.IOError, "move (copy phase) failed", "Move", src, 0)
        ret 0 - 1
    end
    if os.RemoveAll(src) != 0:
        error.Set(error.IOError, "move (cleanup phase) failed", "Move", src, 0)
        ret 0 - 1
    end
    ret 0
end

@en "Exists"
@fa "وجود دارد"
@ar "موجود"
pub func Exists(p: str): bool: ret os.Exists(p) && os.IsDir(p) end

@en "IsDir"
@fa "پوشه است"
@ar "هل مجلد"
pub func IsDir(p: str): bool: ret os.IsDir(p) end

@en "Size"
@fa "اندازه"
@ar "الحجم"
pub func Size(p: str): i64:
    files := os.Walk(p)
    defer files.free()
    mut total := 0 as i64
    repeat files.len() with i:
        f := files.get(i)[0]
        sz := file.Size(f)
        if sz > 0: total += sz end
    end
    ret total
end

@en "Permissions"
@fa "مجوزها"
@ar "الأذونات"
pub func Permissions(p: str): int: ret fs.Permissions(p) end

@en "ModTime"
@fa "زمان تغییر"
@ar "وقت التعدیل"
pub func ModTime(p: str): i64: ret fs.ModTime(p) end
