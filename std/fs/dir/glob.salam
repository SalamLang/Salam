package dir

import os
import str
import sort
import filepath

func _glob_join(base: str, name: str): str:
    if base.Len() == 0:
        ret str.Clone(name)
    end
    if base == "/":
        ret "/" + name
    end
    ret base + "/" + name
end

func _glob_expand(base: str, segs: Vector<str>, at: int, out &: Vector<str>):
    if at >= segs.Len():
        if base.Len() > 0 and os.Exists(base):
            out.push(str.Clone(base))
        end
        ret
    end
    seg := segs.get(at)
    if seg == "**":
        _glob_expand(base, segs, at + 1, out)
        entries := os.ListDir(base.Len() == 0 ? "." : base)
        defer entries.Free()
        repeat entries.Len() in i:
            full := _glob_join(base, entries.get(i))
            if os.IsDir(full):
                _glob_expand(full, segs, at, out)
            end
        end
        ret
    end
    if not filepath.HasMeta(seg):
        _glob_expand(_glob_join(base, seg), segs, at + 1, out)
        ret
    end
    if base.Len() > 0 and not os.IsDir(base):
        ret
    end
    entries := os.ListDir(base.Len() == 0 ? "." : base)
    defer entries.Free()
    repeat entries.Len() in i:
        name := entries.get(i)
        if filepath.Match(seg, name):
            _glob_expand(_glob_join(base, name), segs, at + 1, out)
        end
    end
end

@en "Glob"
@fa "الگوجویی"
pub func Glob(pattern: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    parts := str.Split(pattern, "/")
    defer parts.Free()
    mut segs := Vector {} as Vector<str>
    defer segs.Free()
    repeat parts.Len() in i:
        if parts.get(i).Len() > 0:
            segs.push(parts.get(i))
        end
    end
    base := str.StartsWith(pattern, "/") ? "/" : ""
    _glob_expand(base, segs, 0, out)
    sort.Sort(out)
    mut unique := Vector {} as Vector<str>
    repeat out.Len() in i:
        if i == 0 or out.get(i) != out.get(i - 1):
            unique.push(out.get(i))
        end
    end
    out.Free()
    ret unique
end

@en "WalkMatch"
@fa "پیمایش با الگو"
pub func WalkMatch(root: str, pattern: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    files := os.Walk(root)
    defer files.Free()
    prefix := root.Len() == 0 ? "" : (str.EndsWith(root, "/") ? root : root + "/")
    byname := str.IndexOf(pattern, "/") < 0
    repeat files.Len() in i:
        full := files.get(i)
        rel := str.StartsWith(full, prefix) ? full.substr(prefix.Len(), full.Len() - prefix.Len()) : full
        target := byname ? filepath.Base(rel) : rel
        if filepath.Match(pattern, target):
            out.push(full)
        end
    end
    sort.Sort(out)
    ret out
end
