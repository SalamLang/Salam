@en "file"
@fa "پرونده"
@ar "الملف"
package file

import io
import os
import fs
import fs.path
import crypto
import str
import os.error

if SALAM_OS_WINDOWS:
    extern:
        func MoveFileExA(existing: str, new_path: str, flags: int): int
    end
end

@en "FileInfo"
@fa "اطلاعات پرونده"
@ar "معلومات ملف"
pub struct FileInfo:
    pub size: i64 = 0
    pub mod_time: i64 = 0
    pub accessed_time: i64 = 0
    pub created_time: i64 = 0
    pub permissions: int = 0
    pub exists: bool = false
end

if SALAM_OS_WINDOWS:
    func _atomic_rename(tmp: str, path: str): int:
        if MoveFileExA(tmp, path, 1) == 0: ret 0 - 1 end
        ret 0
    end
else:
    func _atomic_rename(tmp: str, path: str): int:
        if os.Move(tmp, path) != 0: ret 0 - 1 end
        ret 0
    end
end

func _strip_cr(s: str): str:
    if str.EndsWith(s, "\r"): ret s.substr(0, s.len() - 1) end
    ret s
end

func _write_binary(path: str, mode: str, data: str): int:
    f := os.Open(path, mode)
    if f == null: ret 0 - 1 end
    n := io.Write(f, data)
    io.Close(f)
    ret n
end

@en "Open"
@fa "بازکردن"
@ar "فتح"
pub func Open(path: str, mode: str): File*: ret os.Open(path, mode) end

@en "Close"
@fa "بستن"
@ar "إغلاق"
pub func Close(f: File*): io.Close(f) end

@en "ReadText"
@fa "خواندن متن"
@ar "قراءة نص"
pub func ReadText(path: str): str: ret io.ReadFile(path) end

@en "ReadAll"
@fa "خواندن همه"
@ar "قراءة الکل"
pub func ReadAll(path: str): str: ret io.ReadFile(path) end

@en "ReadBytes"
@fa "خواندن بایت‌ها"
@ar "قراءة البایتات"
pub func ReadBytes(path: str, n: int): str:
    f := os.Open(path, "rb")
    if f == null: ret "" end
    out := io.Read(f, n as u64)
    io.Close(f)
    ret out
end

@en "ReadLines"
@fa "خواندن خط‌ها"
@ar "قراءة الأسطر"
pub func ReadLines(path: str): Vector<str>:
    raw := io.Lines(path)
    defer raw.free()
    out := Vector {} as Vector<str>
    n := raw.len()
    mut i := 0
    until i < n:
        out.push(_strip_cr(raw.get(i)[0]))
        i += 1
    end
    ret out
end

@en "WriteText"
@fa "نوشتن متن"
@ar "کتابة نص"
pub func WriteText(path: str, data: str): int: ret _write_binary(path, "wb", data) end

@en "WriteBytes"
@fa "نوشتن بایت‌ها"
@ar "کتابة البایتات"
pub func WriteBytes(path: str, data: str): int: ret _write_binary(path, "wb", data) end

@en "Append"
@fa "افزودن"
@ar "إلحاق"
pub func Append(path: str, data: str): int: ret _write_binary(path, "ab", data) end

@en "AtomicWrite"
@fa "نوشتن اتمی"
@ar "کتابة ذریة"
pub func AtomicWrite(path: str, data: str): int:
    tmp := path.concat(".tmp")
    if _write_binary(tmp, "wb", data) < 0:
        error.Set(error.IOError, "atomic write failed", "AtomicWrite", path, 0)
        ret 0 - 1
    end
    if _atomic_rename(tmp, path) != 0:
        error.Set(error.IOError, "atomic rename failed", "AtomicWrite", path, 0)
        ret 0 - 1
    end
    ret 0
end

@en "Size"
@fa "اندازه"
@ar "الحجم"
pub func Size(p: str): i64: ret os.FileSize(p) end

@en "ModTime"
@fa "زمان تغییر"
@ar "وقت التعدیل"
pub func ModTime(p: str): i64: ret fs.ModTime(p) end

@en "AccessedTime"
@fa "زمان دسترسی"
@ar "وقت الوصول"
pub func AccessedTime(p: str): i64: ret fs.AccessedTime(p) end

@en "CreatedTime"
@fa "زمان ایجاد"
@ar "وقت الإنشاء"
pub func CreatedTime(p: str): i64: ret fs.CreatedTime(p) end

@en "Permissions"
@fa "مجوزها"
@ar "الأذونات"
pub func Permissions(p: str): int: ret fs.Permissions(p) end

@en "Chmod"
@fa "تغییر مجوز"
@ar "تغییر الإذن"
pub func Chmod(p: str, mode: int): int: ret fs.Chmod(p, mode) end

@en "Extension"
@fa "پسوند"
@ar "امتداد"
pub func Extension(p: str): str: ret path.Ext(p) end

@en "MimeType"
@fa "نوع مایم"
@ar "نوع مايم"
pub func MimeType(p: str): str:
    ext := str.Lower(path.Ext(p))
    if ext == ".txt": ret "text/plain"
    else ext == ".html": ret "text/html"
    else ext == ".htm": ret "text/html"
    else ext == ".css": ret "text/css"
    else ext == ".js": ret "text/javascript"
    else ext == ".json": ret "application/json"
    else ext == ".xml": ret "application/xml"
    else ext == ".csv": ret "text/csv"
    else ext == ".md": ret "text/markdown"
    else ext == ".pdf": ret "application/pdf"
    else ext == ".zip": ret "application/zip"
    else ext == ".gz": ret "application/gzip"
    else ext == ".tar": ret "application/x-tar"
    else ext == ".png": ret "image/png"
    else ext == ".jpg": ret "image/jpeg"
    else ext == ".jpeg": ret "image/jpeg"
    else ext == ".gif": ret "image/gif"
    else ext == ".svg": ret "image/svg+xml"
    else ext == ".webp": ret "image/webp"
    else ext == ".ico": ret "image/x-icon"
    else ext == ".mp3": ret "audio/mpeg"
    else ext == ".wav": ret "audio/wav"
    else ext == ".mp4": ret "video/mp4"
    else ext == ".wasm": ret "application/wasm"
    end
    ret "application/octet-stream"
end

@en "Stat"
@fa "وضعیت"
@ar "حالة"
pub func Stat(p: str): FileInfo:
    if os.Exists(p) == false: ret FileInfo { exists = false } end
    ret FileInfo {
        size = Size(p),
        mod_time = ModTime(p),
        accessed_time = AccessedTime(p),
        created_time = CreatedTime(p),
        permissions = Permissions(p),
        exists = true
    }
end

@en "Copy"
@fa "کپی"
@ar "نسخ"
pub func Copy(src: str, dst: str): int:
    if os.Copy(src, dst) != 0:
        error.Set(error.IOError, "copy failed", "Copy", src, 0)
        ret 0 - 1
    end
    ret 0
end

@en "Move"
@fa "جابجایی"
@ar "نقل"
pub func Move(src: str, dst: str): int:
    if os.Move(src, dst) != 0:
        error.Set(error.IOError, "move failed", "Move", src, 0)
        ret 0 - 1
    end
    ret 0
end

@en "Rename"
@fa "تغییر نام"
@ar "إعادة تسمیة"
pub func Rename(src: str, dst: str): int: ret Move(src, dst) end

@en "Delete"
@fa "حذف"
@ar "حذف"
pub func Delete(p: str): int:
    if os.Remove(p) != 0:
        error.Set(error.FileNotFound, "delete failed", "Delete", p, 0)
        ret 0 - 1
    end
    ret 0
end

@en "Exists"
@fa "وجود دارد"
@ar "موجود"
pub func Exists(p: str): bool: ret os.Exists(p) end

@en "Md5Hex"
@fa "هش ام‌دی۵"
@ar "تجزئة إم‌دی۵"
pub func Md5Hex(p: str): str: ret crypto.Md5Hex(io.ReadFile(p)) end

@en "Sha1Hex"
@fa "هش شا۱"
@ar "تجزئة شا۱"
pub func Sha1Hex(p: str): str: ret crypto.Sha1Hex(io.ReadFile(p)) end

@en "Sha256Hex"
@fa "هش شا۲۵۶"
@ar "تجزئة شا۲۵۶"
pub func Sha256Hex(p: str): str: ret crypto.Sha256Hex(io.ReadFile(p)) end

@en "Sha512Hex"
@fa "هش شا۵۱۲"
@ar "تجزئة شا۵۱۲"
pub func Sha512Hex(p: str): str: ret crypto.Sha512Hex(io.ReadFile(p)) end
