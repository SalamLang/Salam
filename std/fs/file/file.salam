@en "file"
@fa "پرونده"
package file

import fs

@en "FileInfo"
@fa "اطلاعات پرونده"
pub type FileInfo = fs.FileInfo

@en "Open"
@fa "بازکردن"
pub func Open(path: str, mode: str): File*: ret fs.Open(path, mode) end

@en "Close"
@fa "بستن"
pub func Close(f: File*): fs.Close(f) end

@en "ReadText"
@fa "خواندن متن"
pub func ReadText(path: str): str: ret fs.ReadText(path) end

@en "ReadAll"
@fa "خواندن همه"
pub func ReadAll(path: str): str: ret fs.ReadAll(path) end

@en "ReadBytes"
@fa "خواندن بایت‌ها"
pub func ReadBytes(path: str, n: int): str: ret fs.ReadBytes(path, n) end

@en "ReadLines"
@fa "خواندن خط‌ها"
pub func ReadLines(path: str): Vector<str>: ret fs.ReadLines(path) end

@en "WriteText"
@fa "نوشتن متن"
pub func WriteText(path: str, data: str): int: ret fs.WriteText(path, data) end

@en "WriteBytes"
@fa "نوشتن بایت‌ها"
pub func WriteBytes(path: str, data: str): int: ret fs.WriteBytes(path, data) end

@en "Append"
@fa "افزودن"
pub func Append(path: str, data: str): int: ret fs.Append(path, data) end

@en "AtomicWrite"
@fa "نوشتن اتمی"
pub func AtomicWrite(path: str, data: str): int: ret fs.AtomicWrite(path, data) end

@en "Size"
@fa "اندازه"
pub func Size(p: str): i64: ret fs.Size(p) end

@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(p: str): i64: ret fs.ModTime(p) end

@en "AccessedTime"
@fa "زمان دسترسی"
pub func AccessedTime(p: str): i64: ret fs.AccessedTime(p) end

@en "CreatedTime"
@fa "زمان ایجاد"
pub func CreatedTime(p: str): i64: ret fs.CreatedTime(p) end

@en "Permissions"
@fa "مجوزها"
pub func Permissions(p: str): int: ret fs.Permissions(p) end

@en "Chmod"
@fa "تغییر مجوز"
pub func Chmod(p: str, mode: int): int: ret fs.Chmod(p, mode) end

@en "Extension"
@fa "پسوند"
pub func Extension(p: str): str: ret fs.Extension(p) end

@en "MimeType"
@fa "نوع مایم"
pub func MimeType(p: str): str: ret fs.MimeType(p) end

@en "Stat"
@fa "وضعیت"
pub func Stat(p: str): FileInfo: ret fs.Stat(p) end

@en "Copy"
@fa "کپی"
pub func Copy(src: str, dst: str): int: ret fs.Copy(src, dst) end

@en "Move"
@fa "جابجایی"
pub func Move(src: str, dst: str): int: ret fs.Move(src, dst) end

@en "Rename"
@fa "تغییر نام"
pub func Rename(src: str, dst: str): int: ret fs.Rename(src, dst) end

@en "Delete"
@fa "حذف"
pub func Delete(p: str): int: ret fs.Delete(p) end

@en "Exists"
@fa "وجود دارد"
pub func Exists(p: str): bool: ret fs.Exists(p) end

@en "Md5Hex"
@fa "هش ام‌دی۵"
pub func Md5Hex(p: str): str: ret fs.Md5Hex(p) end

@en "Sha1Hex"
@fa "هش شا۱"
pub func Sha1Hex(p: str): str: ret fs.Sha1Hex(p) end

@en "Sha256Hex"
@fa "هش شا۲۵۶"
pub func Sha256Hex(p: str): str: ret fs.Sha256Hex(p) end

@en "Sha512Hex"
@fa "هش شا۵۱۲"
pub func Sha512Hex(p: str): str: ret fs.Sha512Hex(p) end
