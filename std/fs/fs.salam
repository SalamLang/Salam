@en "fs"
@fa "سیستم پرونده"
package fs

import mem
import str

if SALAM_OS_WINDOWS:
    extern:
        func MultiByteToWideChar(
            codepage: u32, flags: u32, src: str, srclen: i32, dst: void*, dstlen: i32
        ): i32
        func _wstat64(path: void*, buf: void*): int
        func _wchmod(path: void*, mode: int): int
    end
else SALAM_OS_ANDROID:
    extern:
        func chmod(path: str, mode: int): int
    end
    if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
        extern:
            func stat64(path: str, buf: void*): int
        end
    else:
        extern:
            func stat(path: str, buf: void*): int
        end
    end
else SALAM_OS_LINUX:
    extern:
        func chmod(path: str, mode: int): int
    end
    if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
        extern:
            func syscall(nr: i64, a: i64, b: i64, c: i64, d: i64, e: i64): i64
            func stat(path: str, buf: void*): int
        end
    else:
        extern:
            func syscall(nr: int, a: int, b: int, c: int, d: int, e: int): int
        end
    end
else SALAM_OS_MAC or SALAM_OS_FREEBSD:
    extern:
        func chmod(path: str, mode: int): int
        func stat(path: str, buf: void*): int
    end
else:
    extern:
        func chmod(path: str, mode: int): int
        func fgetc(stream: void*): int
        func popen(cmd: str, mode: str): void*
        func pclose(fp: void*): int
    end
end

struct _Meta:
    pub ok: bool = false
    pub size: i64 = 0
    pub mode: int = 0
    pub atime: i64 = 0
    pub mtime: i64 = 0
    pub btime: i64 = 0
end

func _at(base: void*, off: int): void*:
    ret ((base as i64) + (off as i64)) as void*
end

func _i64_at(base: void*, off: int): i64:
    ret (_at(base, off) as i64*)[0]
end

func _u16_at(base: void*, off: int): int:
    ret (_at(base, off) as u16*)[0] as int
end

func _u32_at(base: void*, off: int): int:
    ret (_at(base, off) as u32*)[0] as int
end

func _u32_wide_at(base: void*, off: int): i64:
    ret (_at(base, off) as u32*)[0] as i64
end

if SALAM_OS_WINDOWS:
    func _wide(path: str): void*:
        n := MultiByteToWideChar(65001 as u32, 0 as u32, path, 0 - 1, null, 0)
        if n <= 0:
            ret mem.MustAllocateZeroed(2 as u64)
        end
        w := mem.MustAllocateZeroed((n * 2) as u64)
        MultiByteToWideChar(65001 as u32, 0 as u32, path, 0 - 1, w, n)
        ret w
    end

    func _meta(path: str): _Meta:
        buf := mem.MustAllocateZeroed(64 as u64)
        defer mem.Free(buf)
        w := _wide(path)
        r := _wstat64(w, buf)
        mem.Free(w)
        if r != 0: ret _Meta {} end
        ret _Meta {
            ok = true,
            mode = _u16_at(buf, 6),
            size = _i64_at(buf, 24),
            atime = _i64_at(buf, 32),
            mtime = _i64_at(buf, 40),
            btime = _i64_at(buf, 48)
        }
    end

    func _chmod_path(path: str, mode: int): int:
        w := _wide(path)
        r := _wchmod(w, mode)
        mem.Free(w)
        ret r
    end
else SALAM_OS_ANDROID:
    func _from_stat(
        buf: void*, mode_at: int, size_at: int, atime_at: int, mtime_at: int, wide: bool
    ): _Meta:
        mut m := _Meta { ok = true, mode = _u32_at(buf, mode_at), size = _i64_at(buf, size_at) }
        if wide:
            m.atime = _i64_at(buf, atime_at)
            m.mtime = _i64_at(buf, mtime_at)
        else:
            m.atime = _u32_wide_at(buf, atime_at)
            m.mtime = _u32_wide_at(buf, mtime_at)
        end
        ret m
    end

    func _meta(path: str): _Meta:
        buf := mem.MustAllocateZeroed(256 as u64)
        defer mem.Free(buf)
        if SALAM_ARCH_X86:
            if stat64(path, buf) != 0: ret _Meta {} end
            ret _from_stat(buf, 16, 44, 64, 72, false)
        else SALAM_ARCH_ARM:
            if stat64(path, buf) != 0: ret _Meta {} end
            ret _from_stat(buf, 16, 48, 72, 80, false)
        else SALAM_ARCH_X64:
            if stat(path, buf) != 0: ret _Meta {} end
            ret _from_stat(buf, 24, 48, 72, 88, true)
        else:
            if stat(path, buf) != 0: ret _Meta {} end
            ret _from_stat(buf, 16, 48, 72, 88, true)
        end
    end

    func _chmod_path(path: str, mode: int): int: ret chmod(path, mode) end
else SALAM_OS_LINUX:
    if SALAM_ARCH_X64:
        func _statx_nr(): i64: ret 332 end
    else SALAM_ARCH_X86:
        func _statx_nr(): i64: ret 383 end
    else SALAM_ARCH_ARM:
        func _statx_nr(): i64: ret 397 end
    else:
        func _statx_nr(): i64: ret 291 end
    end

    if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
        func _statx(path: str, buf: void*): bool:
            ret syscall(
                _statx_nr(),
                (0 - 100) as i64,
                (path as void*) as i64,
                0 as i64,
                4095 as i64,
                buf as i64
            ) == (0 as i64)
        end
    else:
        func _statx(path: str, buf: void*): bool:
            ret syscall(
                _statx_nr() as int,
                0 - 100,
                ((path as void*) as i64) as int,
                0,
                4095,
                (buf as i64) as int
            ) == 0
        end
    end

    if SALAM_ARCH_X64:
        func _stat_fallback(path: str, buf: void*): _Meta:
            if stat(path, buf) != 0: ret _Meta {} end
            ret _Meta {
                ok = true,
                mode = _u32_at(buf, 24),
                size = _i64_at(buf, 48),
                atime = _i64_at(buf, 72),
                mtime = _i64_at(buf, 88)
            }
        end
    else SALAM_ARCH_ARM64 or SALAM_ARCH_RISCV64:
        func _stat_fallback(path: str, buf: void*): _Meta:
            if stat(path, buf) != 0: ret _Meta {} end
            ret _Meta {
                ok = true,
                mode = _u32_at(buf, 16),
                size = _i64_at(buf, 48),
                atime = _i64_at(buf, 72),
                mtime = _i64_at(buf, 88)
            }
        end
    else:
        func _stat_fallback(path: str, buf: void*): _Meta: ret _Meta {} end
    end

    func _meta(path: str): _Meta:
        buf := mem.MustAllocateZeroed(256 as u64)
        defer mem.Free(buf)
        if _statx(path, buf) == false: ret _stat_fallback(path, buf) end
        mut born := 0 as i64
        if (_u32_at(buf, 0) & 2048) != 0: born = _i64_at(buf, 80) end
        ret _Meta {
            ok = true,
            mode = _u16_at(buf, 28),
            size = _i64_at(buf, 40),
            atime = _i64_at(buf, 64),
            mtime = _i64_at(buf, 112),
            btime = born
        }
    end

    func _chmod_path(path: str, mode: int): int: ret chmod(path, mode) end
else SALAM_OS_MAC:
    func _meta(path: str): _Meta:
        buf := mem.MustAllocateZeroed(256 as u64)
        defer mem.Free(buf)
        if stat(path, buf) != 0: ret _Meta {} end
        ret _Meta {
            ok = true,
            mode = _u16_at(buf, 4),
            atime = _i64_at(buf, 32),
            mtime = _i64_at(buf, 48),
            btime = _i64_at(buf, 80),
            size = _i64_at(buf, 96)
        }
    end

    func _chmod_path(path: str, mode: int): int: ret chmod(path, mode) end
else SALAM_OS_FREEBSD:
    func _meta(path: str): _Meta:
        buf := mem.MustAllocateZeroed(256 as u64)
        defer mem.Free(buf)
        if stat(path, buf) != 0: ret _Meta {} end
        ret _Meta {
            ok = true,
            mode = _u16_at(buf, 24),
            atime = _i64_at(buf, 48),
            mtime = _i64_at(buf, 64),
            btime = _i64_at(buf, 96),
            size = _i64_at(buf, 112)
        }
    end

    func _chmod_path(path: str, mode: int): int: ret chmod(path, mode) end
else:
    func _fs_shell_quote(path: str): str:
        mut sb := str.NewBuilder()
        str.BufAppendChar(sb, 39)
        bp := path as u8*
        repeat path.Len() in i:
            c := bp[i] as int
            if c == 39:
                str.BufAppend(sb, "'\\''")
            else:
                str.BufAppendChar(sb, c)
            end
        end
        str.BufAppendChar(sb, 39)
        out := str.BufStr(sb)
        str.BufFree(sb)
        ret out
    end

    func _fs_stat_field(path: str, fmt: str, base: int): i64:
        quoted := _fs_shell_quote(path)
        defer mem.Free(quoted as void*)
        mut cb := str.NewBuilder()
        str.BufAppend(cb, "stat -f ")
        str.BufAppend(cb, fmt)
        str.BufAppend(cb, " ")
        str.BufAppend(cb, quoted)
        str.BufAppend(cb, " 2>/dev/null")
        cmd := str.BufStr(cb)
        str.BufFree(cb)
        fp := popen(cmd, "r")
        mem.Free(cmd as void*)
        if fp == null: ret 0 - 1 end
        mut v := 0 as i64
        mut digits := 0
        mut neg := false
        mut bad := false
        mut c := fgetc(fp)
        until c != -1 and c != 10:
            if c == 45 and digits == 0:
                neg = true
            else c >= 48 and c < 48 + base and digits < 18:
                v = v * (base as i64) + ((c - 48) as i64)
                digits++
            else:
                bad = true
            end
            c = fgetc(fp)
        end
        pclose(fp)
        if bad or digits == 0: ret 0 - 1 end
        if neg: ret 0 - v end
        ret v
    end

    func _meta(path: str): _Meta:
        m := _fs_stat_field(path, "%Lp", 8)
        if m < (0 as i64): ret _Meta {} end
        b := _fs_stat_field(path, "%B", 10)
        ret _Meta {
            ok = true,
            mode = m as int,
            size = _fs_stat_field(path, "%z", 10),
            atime = _fs_stat_field(path, "%a", 10),
            mtime = _fs_stat_field(path, "%m", 10),
            btime = b < (0 as i64) ? 0 as i64 : b
        }
    end

    func _chmod_path(path: str, mode: int): int: ret chmod(path, mode) end
end

@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(path: str): i64:
    m := _meta(path)
    if m.ok == false: ret 0 - 1 end
    ret m.mtime
end

@en "AccessedTime"
@fa "زمان دسترسی"
pub func AccessedTime(path: str): i64:
    m := _meta(path)
    if m.ok == false: ret 0 - 1 end
    ret m.atime
end

@en "CreatedTime"
@fa "زمان ایجاد"
pub func CreatedTime(path: str): i64:
    m := _meta(path)
    if m.ok == false: ret 0 - 1 end
    if m.btime < (0 as i64): ret 0 end
    ret m.btime
end

@en "Chmod"
@fa "تغییر مجوز"
pub func Chmod(path: str, mode: int): int:
    if _chmod_path(path, mode & 4095) == 0: ret 0 end
    ret 0 - 1
end

@en "Permissions"
@fa "مجوزها"
pub func Permissions(path: str): int:
    m := _meta(path)
    if m.ok == false: ret 0 - 1 end
    ret m.mode & 4095
end
