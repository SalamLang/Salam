@en "fs"
@fa "سیستم پرونده"
@ar "نظام الملفات"
package fs

import mem
import str
import conv

extern:
    func fopen(path: str, mode: str): void*
    func fclose(fp: void*): int
    func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
    func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
    func fgetc(stream: void*): int
    func fseek(fp: void*, off: int, whence: int): int
end

if SALAM_OS_WINDOWS:
    extern:
        func _fseeki64(fp: void*, off: i64, whence: int): int
    end
else:
    extern:
        func fseeko(fp: void*, off: i64, whence: int): int
    end
end

if SALAM_OS_WINDOWS:
    extern:
        func FindFirstFileA(pat: str, data: void*): void*
        func FindNextFileA(h: void*, data: void*): int
        func FindClose(h: void*): int
    end
else:
    extern:
        func opendir(path: str): void*
        func readdir(d: void*): void*
        func closedir(d: void*): int
    end
    if SALAM_OS_LINUX || SALAM_OS_ANDROID:
        // dirfd on the DIR* opendir already returns, rather than open/close:
        // fs already has Open/Close of its own for files, and a second pair
        // of externs by those names collides with them. opendir does not
        // read any entries until the first readdir, so the descriptor is
        // still at offset zero when getdents64 takes over.
        extern:
            func dirfd(d: void*): int
        end
        // syscall() is `long syscall(long, ...)`, and `long` is the pointer
        // width - so the argument types have to change with it. Declared
        // non-variadic: integer arguments land in the same registers either
        // way on x86, x86_64, arm and aarch64.
        if SALAM_ARCH_X64 || SALAM_ARCH_ARM64:
            extern:
                func syscall(nr: i64, a: i64, b: i64, c: i64): i64
            end
        else:
            extern:
                func syscall(nr: int, a: int, b: int, c: int): int
            end
        end
    end
end

if SALAM_OS_WINDOWS:
    extern:
        func GetFileAttributesExA(path: str, level: int, data: void*): int
        func _chmod(path: str, mode: int): int
    end
else:
    extern:
        func chmod(path: str, mode: int): int
        func popen(cmd: str, mode: str): void*
        func pclose(fp: void*): int
    end
end

func _byte_at(base: void*, off: i64): int:
    p := ((base as i64) + off) as u8*
    ret p[0] as int
end

func _strptr(s: str): i64:
    v := s as void*
    ret v as i64
end

extern:
    func salam_open(path: str, mode: str): File*:
        fp := fopen(path, mode)
        if fp == null: ret null end
        ret fp as File*
    end
    func salam_file_read(f: File*, size: u64): str:
        if f == null: ret "" end
        fp := f as void*
        buf := mem.AllocateZeroed(size + (1 as u64))
        got := fread(buf, 1 as u64, size, fp)
        // Terminate where the read actually stopped. The buffer is zeroed and
        // one byte longer than the request, so a short read is already a valid
        // shorter string, but glibc declares fread warn_unused_result and gcc
        // will not let the count be dropped on the floor.
        mem.Set(((buf as i64) + (got as i64)) as void*, 0, 1 as u64)
        ret buf as str
    end
    func salam_file_readline(f: File*): str:
        if f == null: ret "" end
        fp := f as void*
        mut sb := str.NewBuilder()
        defer str.BufFree(sb)
        mut c := fgetc(fp)
        until c != -1 && c != 10:
            str.BufAppendChar(sb, c)
            c = fgetc(fp)
        end
        out := str.BufStr(sb)
        ret out
    end
    func salam_file_write(f: File*, data: str): int:
        if f == null: ret 0 - 1 end
        fp := f as void*
        n := data.len() as u64
        w := fwrite(data as void*, 1 as u64, n, fp)
        ret w as int
    end
    func salam_file_close(f: File*):
        if f == null: ret end
        fclose(f as void*)
    end
    func salam_file_seek(f: File*, off: i64, whence: int): int:
        if f == null: ret 0 - 1 end
        fp := f as void*
        mut w := 0

        if whence == 1: w = 1
        else whence == 2: w = 2
        end

        if _fs_seek64(fp, off, w) == 0: ret 0 end
        ret 0 - 1
    end
end

if SALAM_OS_WINDOWS:
    func _fs_seek64(fp: void*, off: i64, w: int): int: ret _fseeki64(fp, off, w) end
else:
    func _fs_seek64(fp: void*, off: i64, w: int): int: ret fseeko(fp, off, w) end
end

func _ld_push(arr: void*, n: int, cap_box: void*, name: str): void*:
    cap := cap_box as int*
    mut a := arr
    if n >= cap[0]:
        if cap[0] == 0: cap[0] = 8 else:
            cap[0] = cap[0] * 2
        end
        a = mem.Reallocate(a, (cap[0] as u64) * (sizeof(str) as u64))
    end
    slots := a as str*
    slots[n] = name.substr(0, name.len())
    ret a
end

func _ld_skip(name: str): bool:
    if name == ".": ret true
    else name == "..": ret true
    else:
        ret false
    end
end

if SALAM_OS_WINDOWS:
    extern:
        func salam_os_listdir(path: str, out_count: void*): void*:
            mut oc := out_count as int*
            fd := mem.Allocate(320 as u64)
            h := FindFirstFileA(path.concat("/*"), fd)
            mut arr := null as void*
            mut n := 0
            cap_box := mem.AllocateZeroed(4 as u64)
            if (h as i64) != (0 - 1):
                mut more := 1
                until more != 0:
                    np := ((fd as i64) + 44) as void*
                    nm := np as str
                    if _ld_skip(nm) == false:
                        arr = _ld_push(arr, n, cap_box, nm)
                        n += 1
                    end
                    more = FindNextFileA(h, fd)
                end
                FindClose(h)
            end
            mem.Free(fd)
            mem.Free(cap_box)
            if arr == null: arr = mem.Allocate(8 as u64) end
            oc[0] = n
            ret arr
        end
    end
else:
    // Linux reads directories through getdents64 rather than readdir.
    //
    // readdir is the wrong door on a 32-bit glibc. <dirent.h> there
    // redirects it to readdir64 (Debian armhf builds with
    // _FILE_OFFSET_BITS=64), but the generated C declares the function
    // itself and never includes that header, so what actually got called was
    // the non-LFS readdir - which returns NULL with EOVERFLOW the moment a
    // directory holds an inode number wider than 32 bits, as an overlayfs
    // one does. listdir then reported every directory as empty, imports
    // resolved to nothing, and the build died with "package 'str' has no
    // exported function 'NewBuilder'" on armhf. i386 happened to have small
    // inodes and got away with it.
    //
    // Going through the syscall sidesteps the whole libc question, and the
    // kernel's linux_dirent64 has one fixed shape on every architecture:
    // d_ino(8) d_off(8) d_reclen(2) d_type(1) then the name at 19. No
    // per-platform offset table, no probing. The syscall numbers below were
    // read out of <sys/syscall.h> on each architecture rather than recalled.
    if SALAM_OS_LINUX || SALAM_OS_ANDROID:
        // if/else, not a run of early returns: condcomp folds the arch
        // test to a constant, and a `ret` under an always-true `if` makes
        // everything after it unreachable (E070).
        if SALAM_ARCH_X86:
            func _gd_nr(): i64: ret 220 as i64 end
        else SALAM_ARCH_ARM64:
            func _gd_nr(): i64: ret 61 as i64 end
        else:
            func _gd_nr(): i64: ret 217 as i64 end
        end

        if SALAM_ARCH_X64 || SALAM_ARCH_ARM64:
            func _getdents(fd: int, buf: void*, cap: int): i64:
                ret syscall(_gd_nr(), fd as i64, buf as i64, cap as i64)
            end
        else:
            func _getdents(fd: int, buf: void*, cap: int): i64:
                ret syscall(_gd_nr() as int, fd, (buf as i64) as int, cap) as i64
            end
        end

        extern:
            func salam_os_listdir(path: str, out_count: void*): void*:
                oc := out_count as int*
                mut arr := null as void*
                mut n := 0
                cap_box := mem.AllocateZeroed(4 as u64)
                dp := opendir(path)
                if dp != null:
                    fd := dirfd(dp)
                    bcap := 32768
                    buf := mem.Allocate(bcap as u64)
                    mut got := _getdents(fd, buf, bcap)
                    until got > (0 as i64):
                        mut p := 0 as i64
                        until p < got:
                            rl := (_byte_at(buf, p + (16 as i64)) + _byte_at(buf, p + (17 as i64)) * 256) as i64
                            if rl < (1 as i64):
                                break
                            end
                            nm := (((buf as i64) + p + (19 as i64)) as void*) as str
                            if _ld_skip(nm) == false:
                                arr = _ld_push(arr, n, cap_box, nm)
                                n += 1
                            end
                            p += rl
                        end
                        got = _getdents(fd, buf, bcap)
                    end
                    mem.Free(buf)
                    closedir(dp)
                end
                mem.Free(cap_box)
                if arr == null: arr = mem.Allocate(sizeof(str) as u64) end
                oc[0] = n
                ret arr
            end
        end
    else:
        // macOS and the BSDs keep readdir: their struct dirent is already
        // 64-bit clean, and each has its own d_name offset.
        if SALAM_OS_MAC:
            func _dname_off(): i64: ret 21 end
        else:
            func _dname_off(): i64: ret 24 end
        end
        extern:
            func salam_os_listdir(path: str, out_count: void*): void*:
                oc := out_count as int*
                mut arr := null as void*
                mut n := 0
                cap_box := mem.AllocateZeroed(4 as u64)
                off := _dname_off()
                d := opendir(path)
                if d != null:
                    mut e := readdir(d)
                    until e != null:
                        np := ((e as i64) + off) as void*
                        nm := np as str
                        if _ld_skip(nm) == false:
                            arr = _ld_push(arr, n, cap_box, nm)
                            n += 1
                        end
                        e = readdir(d)
                    end
                    closedir(d)
                end
                mem.Free(cap_box)
                if arr == null: arr = mem.Allocate(sizeof(str) as u64) end
                oc[0] = n
                ret arr
            end
        end
    end
end

func _u32_at(base: void*, off: i64): u32:
    p := ((base as i64) + off) as u32*
    ret p[0]
end

func _filetime_to_unix(low: u32, high: u32): i64:
    combined := (high as u64) * (4294967296 as u64) + (low as u64)
    epoch := 116444736000000000 as u64
    if combined < epoch: ret 0 end
    ret ((combined - epoch) / (10000000 as u64)) as i64
end

if SALAM_OS_WINDOWS:
    func _fs_times(path: str): i64*:
        buf := mem.AllocateZeroed(40 as u64)
        out := mem.Allocate(24 as u64) as i64*
        ok := GetFileAttributesExA(path, 0, buf)
        if ok == 0:
            out[0] = 0 - 1
            out[1] = 0 - 1
            out[2] = 0 - 1
            mem.Free(buf)
            ret out
        end
        ctime := _filetime_to_unix(_u32_at(buf, 4), _u32_at(buf, 8))
        atime := _filetime_to_unix(_u32_at(buf, 12), _u32_at(buf, 16))
        mtime := _filetime_to_unix(_u32_at(buf, 20), _u32_at(buf, 24))
        out[0] = mtime
        out[1] = atime
        out[2] = ctime
        mem.Free(buf)
        ret out
    end
else:
    func _fs_stat_field(path: str, fmt: str): i64:
        mut cmd := ""
        if SALAM_OS_MAC:
            cmd = "stat -f ".concat(fmt).concat(" ").concat(path).concat(" 2>/dev/null")
        else:
            cmd = "stat -c ".concat(fmt).concat(" ").concat(path).concat(" 2>/dev/null")
        end
        fp := popen(cmd, "r")
        if fp == null: ret 0 - 1 end
        buf := mem.Allocate(256 as u64)
        mut sb := str.NewBuilder()
        mut c := fgetc(fp)
        until c != -1 && c != 10:
            str.BufAppendChar(sb, c)
            c = fgetc(fp)
        end
        mem.Free(buf)
        line := str.BufStr(sb)
        str.BufFree(sb)
        pclose(fp)
        if line.len() == 0: ret 0 - 1 end
        ret conv.ParseInt(line)
    end
end

if SALAM_OS_WINDOWS:
    @en "ModTime"
    @fa "زمان تغییر"
    @ar "وقت التعدیل"
    pub func ModTime(path: str): i64:
        t := _fs_times(path)
        ret t[0]
    end

    @en "AccessedTime"
    @fa "زمان دسترسی"
    @ar "وقت الوصول"
    pub func AccessedTime(path: str): i64:
        t := _fs_times(path)
        ret t[1]
    end

    @en "CreatedTime"
    @fa "زمان ایجاد"
    @ar "وقت الإنشاء"
    pub func CreatedTime(path: str): i64:
        t := _fs_times(path)
        ret t[2]
    end

    @en "Chmod"
    @fa "تغییر مجوز"
    @ar "تغییر الإذن"
    pub func Chmod(path: str, mode: int): int:
        if _chmod(path, mode) == 0: ret 0 end
        ret 0 - 1
    end

    @en "Permissions"
    @fa "مجوزها"
    @ar "الأذونات"
    pub func Permissions(path: str): int:
        buf := mem.AllocateZeroed(40 as u64)
        ok := GetFileAttributesExA(path, 0, buf)
        if ok == 0:
            mem.Free(buf)
            ret 0 - 1
        end
        attrs := _u32_at(buf, 0)
        mem.Free(buf)
        if (attrs as int) % 2 == 1: ret 292 end
        ret 438
    end
else:
    @en "ModTime"
    @fa "زمان تغییر"
    @ar "وقت التعدیل"
    pub func ModTime(path: str): i64: ret _fs_stat_field(path, "%Y") end

    @en "AccessedTime"
    @fa "زمان دسترسی"
    @ar "وقت الوصول"
    pub func AccessedTime(path: str): i64: ret _fs_stat_field(path, "%X") end

    @en "CreatedTime"
    @fa "زمان ایجاد"
    @ar "وقت الإنشاء"
    pub func CreatedTime(path: str): i64:
        if SALAM_OS_MAC:
            ret _fs_stat_field(path, "%B")
        else:
            ret _fs_stat_field(path, "%W")
        end
    end

    @en "Chmod"
    @fa "تغییر مجوز"
    @ar "تغییر الإذن"
    pub func Chmod(path: str, mode: int): int:
        if chmod(path, mode) == 0: ret 0 end
        ret 0 - 1
    end

    @en "Permissions"
    @fa "مجوزها"
    @ar "الأذونات"
    pub func Permissions(path: str): int: ret _fs_stat_field(path, "%a") as int end
end
