@en "fs"
@fa "سیستم پرونده"
package fs

import mem
import str

extern:
    func fgetc(stream: void*): int
end

if SALAM_OS_WINDOWS:
    extern:
        func GetFileAttributesExA(path: str, level: int, data: void*): int
        func _chmod(path: str, mode: int): int
    end
else:
    extern:
        func chmod(path: str, mode: int): int
        func popen(cmd: str, mode: str): void*
        func pclose(fp: void*): int
    end
end

func _byte_at(base: void*, off: i64): int:
    p := ((base as i64) + off) as u8*
    ret p[0] as int
end

func _u32_at(base: void*, off: i64): u32:
    p := ((base as i64) + off) as u32*
    ret p[0]
end

func _filetime_to_unix(low: u32, high: u32): i64:
    combined := (high as u64) * (4294967296 as u64) + (low as u64)
    epoch := 116444736000000000 as u64
    if combined < epoch: ret 0 end
    ret ((combined - epoch) / (10000000 as u64)) as i64
end

if SALAM_OS_WINDOWS:
    func _fs_times(path: str): i64*:
        buf := mem.MustAllocateZeroed(40 as u64)
        out := mem.MustAllocate(24 as u64) as i64*
        ok := GetFileAttributesExA(path, 0, buf)
        if ok == 0:
            out[0] = 0 - 1
            out[1] = 0 - 1
            out[2] = 0 - 1
            mem.Free(buf)
            ret out
        end
        ctime := _filetime_to_unix(_u32_at(buf, 4), _u32_at(buf, 8))
        atime := _filetime_to_unix(_u32_at(buf, 12), _u32_at(buf, 16))
        mtime := _filetime_to_unix(_u32_at(buf, 20), _u32_at(buf, 24))
        out[0] = mtime
        out[1] = atime
        out[2] = ctime
        mem.Free(buf)
        ret out
    end
else:
    func _fs_shell_quote(path: str): str:
        mut sb := str.NewBuilder()
        str.BufAppendChar(sb, 39)
        pp := path as void*
        repeat path.len() in i:
            c := _byte_at(pp, i as i64)
            if c == 39:
                str.BufAppend(sb, "'\\''")
            else:
                str.BufAppendChar(sb, c)
            end
        end
        str.BufAppendChar(sb, 39)
        out := str.BufStr(sb)
        str.BufFree(sb)
        ret out
    end

    func _fs_stat_field(path: str, fmt: str): i64:
        quoted := _fs_shell_quote(path)
        defer mem.Free(quoted as void*)
        mut cb := str.NewBuilder()
        if SALAM_OS_MAC or SALAM_OS_BSD:
            str.BufAppend(cb, "stat -f ")
        else:
            str.BufAppend(cb, "stat -c ")
        end
        str.BufAppend(cb, fmt)
        str.BufAppend(cb, " ")
        str.BufAppend(cb, quoted)
        str.BufAppend(cb, " 2>/dev/null")
        cmd := str.BufStr(cb)
        str.BufFree(cb)
        fp := popen(cmd, "r")
        mem.Free(cmd as void*)
        if fp == null: ret 0 - 1 end
        mut sb := str.NewBuilder()
        mut c := fgetc(fp)
        until c != -1 and c != 10:
            str.BufAppendChar(sb, c)
            c = fgetc(fp)
        end
        line := str.BufStr(sb)
        str.BufFree(sb)
        pclose(fp)
        defer mem.Free(line as void*)
        if line.len() == 0: ret 0 - 1 end
        lp := line as void*
        mut k := 0
        neg := _byte_at(lp, 0 as i64) == 45
        if neg: k = 1 end
        if k >= line.len() or line.len() - k > 18: ret 0 - 1 end
        mut v := 0 as i64
        until k < line.len():
            c2 := _byte_at(lp, k as i64)
            if c2 < 48 or c2 > 57: ret 0 - 1 end
            v = v * 10 + ((c2 - 48) as i64)
            k++
        end
        if neg: ret 0 - v end
        ret v
    end
end

if SALAM_OS_WINDOWS:
    @en "ModTime"
    @fa "زمان تغییر"
    pub func ModTime(path: str): i64:
        t := _fs_times(path)
        v := t[0]
        mem.Free(t as void*)
        ret v
    end

    @en "AccessedTime"
    @fa "زمان دسترسی"
    pub func AccessedTime(path: str): i64:
        t := _fs_times(path)
        v := t[1]
        mem.Free(t as void*)
        ret v
    end

    @en "CreatedTime"
    @fa "زمان ایجاد"
    pub func CreatedTime(path: str): i64:
        t := _fs_times(path)
        v := t[2]
        mem.Free(t as void*)
        ret v
    end

    @en "Chmod"
    @fa "تغییر مجوز"
    pub func Chmod(path: str, mode: int): int:
        if _chmod(path, mode) == 0: ret 0 end
        ret 0 - 1
    end

    @en "Permissions"
    @fa "مجوزها"
    pub func Permissions(path: str): int:
        buf := mem.MustAllocateZeroed(40 as u64)
        ok := GetFileAttributesExA(path, 0, buf)
        if ok == 0:
            mem.Free(buf)
            ret 0 - 1
        end
        attrs := _u32_at(buf, 0)
        mem.Free(buf)
        is_dir := ((attrs as int) / 16) % 2 == 1
        if (attrs as int) % 2 == 1:
            if is_dir: ret 555 end
            ret 444
        end
        if is_dir: ret 777 end
        ret 666
    end
else:
    @en "ModTime"
    @fa "زمان تغییر"
    pub func ModTime(path: str): i64:
        if SALAM_OS_MAC or SALAM_OS_BSD:
            ret _fs_stat_field(path, "%m")
        else:
            ret _fs_stat_field(path, "%Y")
        end
    end

    @en "AccessedTime"
    @fa "زمان دسترسی"
    pub func AccessedTime(path: str): i64:
        if SALAM_OS_MAC or SALAM_OS_BSD:
            ret _fs_stat_field(path, "%a")
        else:
            ret _fs_stat_field(path, "%X")
        end
    end

    @en "CreatedTime"
    @fa "زمان ایجاد"
    pub func CreatedTime(path: str): i64:
        if SALAM_OS_MAC or SALAM_OS_BSD:
            ret _fs_stat_field(path, "%B")
        else:
            ret _fs_stat_field(path, "%W")
        end
    end

    @en "Chmod"
    @fa "تغییر مجوز"
    pub func Chmod(path: str, mode: int): int:
        if chmod(path, mode) == 0: ret 0 end
        ret 0 - 1
    end

    @en "Permissions"
    @fa "مجوزها"
    pub func Permissions(path: str): int:
        if SALAM_OS_MAC or SALAM_OS_BSD:
            ret _fs_stat_field(path, "%Lp") as int
        else:
            ret _fs_stat_field(path, "%a") as int
        end
    end
end
