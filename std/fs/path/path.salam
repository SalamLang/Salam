@en "path"
@fa "مسیر"
@ar "المسار"
package path

import filepath

@en "PathParts"
@fa "اجزای مسیر"
@ar "أجزاء المسار"
pub struct PathParts:
    pub dir: str = ""
    pub base: str = ""
end

@en "Join"
@fa "پیوند"
@ar "دمج"
pub func Join(a: str, b: str): str: ret filepath.Join(a, b) end

@en "Split"
@fa "تقسیم"
@ar "تقسیم"
pub func Split(p: str): PathParts:
    ret PathParts { dir = filepath.Dir(p), base = filepath.Base(p) }
end

@en "Normalize"
@fa "نرمال سازی"
@ar "تسویة"
pub func Normalize(p: str): str: ret filepath.Normalize(p) end

@en "Clean"
@fa "پاک سازی"
@ar "تنظیف"
pub func Clean(p: str): str: ret filepath.Clean(p) end

@en "IsAbs"
@fa "مطلق است"
@ar "هل مطلق"
pub func IsAbs(p: str): bool: ret filepath.IsAbs(p) end

@en "Abs"
@fa "مسیر مطلق"
@ar "مسار مطلق"
pub func Abs(p: str): str: ret filepath.Abs(p) end

@en "Rel"
@fa "مسیر نسبی"
@ar "مسار نسبی"
pub func Rel(base: str, target: str): str: ret filepath.Rel(base, target) end

@en "Parent"
@fa "پوشه والد"
@ar "المجلد الأصل"
pub func Parent(p: str): str: ret filepath.Dir(p) end

@en "Dirname"
@fa "نام پوشه"
@ar "اسم المجلد"
pub func Dirname(p: str): str: ret filepath.Dir(p) end

@en "Filename"
@fa "نام پرونده"
@ar "اسم الملف"
pub func Filename(p: str): str: ret filepath.Base(p) end

@en "Basename"
@fa "نام پایه"
@ar "الاسم الأساسی"
pub func Basename(p: str): str: ret filepath.Stem(p) end

@en "Ext"
@fa "پسوند"
@ar "امتداد"
pub func Ext(p: str): str: ret filepath.Ext(p) end

@en "Stem"
@fa "نام بدون پسوند"
@ar "اسم بدون امتداد"
pub func Stem(p: str): str: ret filepath.Stem(p) end

@en "IsSafe"
@fa "مسیر امن است"
@ar "هل المسار آمن"
pub func IsSafe(base: str, p: str): bool: ret filepath.IsSafe(base, p) end

@en "Validate"
@fa "اعتبارسنجی مسیر"
@ar "التحقق من المسار"
pub func Validate(p: str): bool: ret filepath.Validate(p) end
