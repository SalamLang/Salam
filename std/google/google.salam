@en "google"
@fa "گوگل"
package google

import mem
import sync
import str
import net.http
import encoding
import encoding.json
import crypto
import tls
import time

const RENEW_MARGIN_SECONDS := 60
const ASSERTION_TTL_SECONDS := 3600

const GRANT_TYPE := "urn:ietf:params:oauth:grant-type:jwt-bearer"

@en "SCOPE_FCM"
@fa "دامنه اف سی ام"
pub const SCOPE_FCM := "https://www.googleapis.com/auth/firebase.messaging"
@en "SCOPE_STORAGE"
@fa "دامنه ذخیره‌سازی"
pub const SCOPE_STORAGE := "https://www.googleapis.com/auth/devstorage.read_write"
@en "SCOPE_CLOUD"
@fa "دامنه ابر"
pub const SCOPE_CLOUD := "https://www.googleapis.com/auth/cloud-platform"

mut _cache_lock := sync.NewMutex()
mut _cache_keys := Vector {} as Vector<str>
mut _cache_tokens := Vector {} as Vector<str>
mut _cache_expiry := Vector {} as Vector<i64>

@en "ServiceAccount"
@fa "حساب سرویس"
pub struct ServiceAccount:
    @en "client_email"
    @fa "ایمیل حساب"
    pub client_email: str = ""
    @en "private_key"
    @fa "کلید خصوصی"
    pub private_key: str = ""
    @en "token_uri"
    @fa "نشانی توکن"
    pub token_uri: str = "https://oauth2.googleapis.com/token"
    @en "project_id"
    @fa "شناسه پروژه"
    pub project_id: str = ""
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
end

func _b64url(standard: str): str:
    mut out := str.Replace(str.Replace(standard, "+", "-"), "/", "_")
    until out.EndsWith("="):
        out = out.Substr(0, out.Len() - 1)
    end
    ret out
end

func _part(payload: str): str:
    ret _b64url(encoding.Base64Encode(payload))
end

func _digest(signing_input: str): str:
    out := mem.AllocateZeroed(32 as u64)
    defer mem.Free(out)
    crypto.Sha256Bytes(signing_input as void*, signing_input.Len(), out)
    ret encoding.Base64EncodeBytes(out, 32)
end

func _assertion(sa: ServiceAccount, scope: str, now: i64): str:
    header := _part(`{"alg":"RS256","typ":"JWT"}`)
    claims := _part(
        `{"iss":"` + sa.client_email + `","scope":"` + scope + `","aud":"` + sa.token_uri + `","iat":` + _num(now) + `,"exp":` + _num(now + (ASSERTION_TTL_SECONDS as i64)) + `}`
    )
    signing_input := header + "." + claims
    mut ok := false
    signature := tls.RsaSignPkcs1Sha256(sa.private_key, _digest(signing_input), ok)
    if not ok: ret "" end
    ret signing_input + "." + _b64url(signature)
end

func _num(value: i64): str:
    mut v := value
    if v <= 0 as i64: ret "0" end
    mut out := ""
    until v > 0 as i64:
        out = "0123456789".Substr((v % (10 as i64)) as int, 1) + out
        v /= (10 as i64)
    end
    ret out
end

func _cached(key: str, now: i64): str:
    repeat _cache_keys.Len() in i:
        if _cache_keys.Get(i) == key and _cache_expiry.Get(i) > now:
            ret _cache_tokens.Get(i)
        end
    end
    ret ""
end

func _remember(key: str, token: str, expires_at: i64):
    repeat _cache_keys.Len() in i:
        if _cache_keys.Get(i) == key:
            _cache_tokens.Set(i, token)
            _cache_expiry.Set(i, expires_at)
            ret
        end
    end
    _cache_keys.Push(key)
    _cache_tokens.Push(token)
    _cache_expiry.Push(expires_at)
end

func _exchange(sa: ServiceAccount, scope: str, now: i64, ok &: bool): str:
    ok = false
    assertion := _assertion(sa, scope, now)
    if assertion.Len() == 0: ret "" end
    mut headers := http.NewHeaders()
    defer headers.Free()
    headers.Put("Content-Type", "application/x-www-form-urlencoded")
    body := "grant_type=" + encoding.URLEncode(GRANT_TYPE) + "&assertion=" + assertion
    response := http.PostWith(sa.token_uri, body, headers)
    if not http.Ok(response): ret "" end
    token := json.Get(http.Body(response), "access_token")
    if token.Len() == 0: ret "" end
    ok = true
    ret token
end

func _mint(sa: ServiceAccount, scope: str, key: str, now: i64, ok &: bool): str:
    token := _exchange(sa, scope, now, ok)
    if not ok: ret "" end
    sync.Lock(_cache_lock)
    _remember(key, token, now + (ASSERTION_TTL_SECONDS as i64) - (RENEW_MARGIN_SECONDS as i64))
    sync.Unlock(_cache_lock)
    ret token
end

@en "ParseServiceAccount"
@fa "تجزیه حساب سرویس"
pub func ParseServiceAccount(document: str): ServiceAccount:
    if document.Len() == 0: ret ServiceAccount {} end
    email := json.Get(document, "client_email")
    key := json.Get(document, "private_key")
    if email.Len() == 0 or key.Len() == 0: ret ServiceAccount {} end
    mut sa := ServiceAccount {
        client_email = email, private_key = key, project_id = json.Get(document, "project_id"), ok = true
    }
    uri := json.Get(document, "token_uri")
    if uri.Len() > 0: sa.token_uri = uri end
    ret sa
end

@en "AccessToken"
@fa "توکن دسترسی"
pub func AccessToken(sa: ServiceAccount, scope: str, ok &: bool): str:
    ok = false
    if not sa.ok or scope.Len() == 0: ret "" end
    now := time.Now()
    key := sa.client_email + "|" + scope
    sync.Lock(_cache_lock)
    hit := _cached(key, now)
    sync.Unlock(_cache_lock)
    if hit.Len() > 0:
        ok = true
        ret hit
    end
    ret _mint(sa, scope, key, now, ok)
end

@en "Forget"
@fa "فراموش کردن توکن"
pub func Forget(sa: ServiceAccount):
    sync.Lock(_cache_lock)
    mut keys := Vector {} as Vector<str>
    mut tokens := Vector {} as Vector<str>
    mut expiry := Vector {} as Vector<i64>
    repeat _cache_keys.Len() in i:
        if not str.StartsWith(_cache_keys.Get(i), sa.client_email + "|"):
            keys.Push(_cache_keys.Get(i))
            tokens.Push(_cache_tokens.Get(i))
            expiry.Push(_cache_expiry.Get(i))
        end
    end
    _cache_keys.Free()
    _cache_tokens.Free()
    _cache_expiry.Free()
    _cache_keys = keys
    _cache_tokens = tokens
    _cache_expiry = expiry
    sync.Unlock(_cache_lock)
end

@en "Authorization"
@fa "سرآیند مجوز"
pub func Authorization(token: str): str:
    ret "Bearer " + token
end
