package graph


@en "FloydWarshall"
@fa "فلوید-وارشال"
pub func FloydWarshall(g &: Graph): Matrix:
    mut next := NewIntMatrix(0, 0, 0)
    m := FloydWarshallPaths(g, next)
    defer next.free()
    ret m
end

@en "FloydWarshallPaths"
@fa "فلوید-وارشال با مسیر"
pub func FloydWarshallPaths(g &: Graph, next &: IntMatrix): Matrix:
    n := g.n
    mut d := WeightMatrix(g)
    next.rows = n
    next.cols = n
    FillInt(next.a, n * n, GRAPH_NONE)
    _init_next(g, d, next)
    repeat n with k:
        repeat n with i:
            if d.at(i, k) < GRAPH_INF: _fw_row(d, next, i, k, n) end
        end
    end
    ret d
end

@en "FloydPath"
@fa "مسیر فلوید"
pub func FloydPath(next &: IntMatrix, s: int, t: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    if next.at(s, t) == GRAPH_NONE: ret out end
    mut u := s
    out.push(u)
    until u != t:
        u = next.at(u, t)
        out.push(u)
    end
    ret out
end

@en "Johnson"
@fa "جانسون"
pub func Johnson(g &: Graph): Matrix:
    n := g.n
    mut out := NewMatrix(n, n)
    mut pot := Vector {} as Vector<f64>
    defer pot.free()
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    FillFloat(pot, n, 0.0)
    FillInt(parent, n, GRAPH_NONE)
    mut round := 0
    until round < n:
        if _bf_pass(g, pot, parent) == false: break end
        round += 1
    end
    if round == n: ret _all_inf(out, n) end
    _johnson_rows(g, pot, out)
    ret out
end

@en "AStar"
@fa "ای‌استار"
pub func AStar(g &: Graph, src: int, target: int, heuristic: Vector<f64>): Vector<int>:
    mut dist := Vector {} as Vector<f64>
    defer dist.free()
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    FillFloat(dist, g.n, GRAPH_INF)
    FillInt(parent, g.n, GRAPH_NONE)
    mut h := MinHeap { }
    defer h.free()
    dist.set(src, 0.0)
    h.push(heuristic.get(src), src)
    until h.is_empty() == false:
        u := h.pop()
        if u == target: break end
        _relax_astar(g, u, dist, parent, h, heuristic)
    end
    ret PathFromParents(parent, src, target)
end

@en "KShortestLengths"
@fa "کوتاه‌ترین طول‌ها"
pub func KShortestLengths(g &: Graph, s: int, t: int, k: int): Vector<f64>:
    mut out := Vector {} as Vector<f64>
    mut count := Vector {} as Vector<int>
    defer count.free()
    FillInt(count, g.n, 0)
    mut h := MinHeap { }
    defer h.free()
    h.push(0.0, s)
    until h.is_empty() == false:
        if out.len() >= k: break end
        d := h.top_key()
        u := h.pop()
        if count.get(u) < k:
            count.set(u, count.get(u) + 1)
            if u == t: out.push(d) end
            _push_successors(g, u, d, h)
        end
    end
    ret out
end

@en "AllPairsHops"
@fa "همه فاصله‌های گامی"
pub func AllPairsHops(g &: Graph): IntMatrix:
    n := g.n
    mut m := NewIntMatrix(n, n, GRAPH_NONE)
    mut dist := Vector {} as Vector<int>
    defer dist.free()
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    repeat n with s:
        BFSFrom(g, s, dist, parent)
        repeat n with t: m.set(s, t, dist.get(t)) end
    end
    ret m
end
