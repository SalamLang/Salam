package graph

import math

// The chromatic polynomial: how many proper colourings a graph has with k
// colours, computed exactly by deletion-contraction.
//
// P(G, k) = P(G - e, k) - P(G/e, k) for any edge e. Every step removes an
// edge or a node, so the recursion bottoms out on an edgeless graph where
// all k^n assignments are proper. It is exponential in the number of edges,
// which is what an exact count of an NP-hard quantity costs.
//
// Evaluating it is a second, independent route to the chromatic number: the
// count is zero exactly when k is below it, which is what the tests use to
// cross-check the branch-and-bound search in gr_color.salam.

func _has_loop(g &: Graph): bool:
    repeat g.size() with e:
        if g.edge_from(e) == g.edge_to(e): ret true end
    end
    ret false
end

// Contract edge `drop`, whose ends are u and v: v disappears into u and the
// edge itself goes with it. Every other edge is kept exactly as it is, which
// includes any parallel copy of `drop` that is now a self loop on the merged
// node. Those loops are the whole point: a loop means no proper colouring,
// and dropping them would inflate every count.
func _contract(g &: Graph, drop: int, u: int, v: int): Graph:
    mut map := Vector {} as Vector<int>
    defer map.free()
    mut next := 0
    repeat g.n with x:
        if x == v: map.push(GRAPH_NONE)
        else:
            map.push(next)
            next += 1
        end
    end
    map.set(v, map.get(u))
    mut h := New(next, false)
    repeat g.size() with e:
        if e != drop:
            h.add_edge(map.get(g.edge_from(e)), map.get(g.edge_to(e)))
        end
    end
    ret h
end

func _delete_edge(g &: Graph, drop: int): Graph:
    mut h := New(g.n, false)
    repeat g.size() with e:
        if e != drop: h.add_edge(g.edge_from(e), g.edge_to(e)) end
    end
    ret h
end

// The chromatic polynomial by deletion-contraction: P(G) = P(G - e) - P(G/e).
// Every step removes an edge or a node, so the recursion terminates on the
// empty graph, where every one of the k^n assignments is proper.
//
// Contraction is where this is easy to get wrong. Merging the ends of one of
// two parallel edges turns the other into a self loop, and a self loop means
// no proper colouring at all. Dropping those loops instead would make
// P(two parallel edges) come out as P(one edge) minus P(a bare node) rather
// than minus zero, and every count above a triangle would be too high.
func _count_colorings(g &: Graph, k: int): f64:
    if _has_loop(g): ret 0.0 end
    if g.size() == 0: ret math.Pow(k as f64, g.n as f64) end
    e := 0
    u := g.edge_from(e)
    v := g.edge_to(e)
    mut del := _delete_edge(g, e)
    mut con := _contract(g, e, u, v)
    a := _count_colorings(del, k)
    b := _count_colorings(con, k)
    del.free()
    con.free()
    ret a - b
end

// The number of proper colourings with k colours: the chromatic polynomial
// evaluated at k. Zero exactly when k is below the chromatic number, which
// makes it a second, independent way to compute that number.
@en "CountColorings"
@fa "شمار رنگ‌آمیزی‌ها"
@ar "عدد التلوينات"
pub func CountColorings(g &: Graph, k: int): f64:
    mut s := Simplify(g)
    repeat g.size() with e:
        if g.edge_from(e) == g.edge_to(e):
            s.free()
            ret 0.0
        end
    end
    v := _count_colorings(s, k)
    s.free()
    ret v
end

