package graph

import math

func _has_loop(g &: Graph): bool:
    repeat g.Size() in e:
        if g.EdgeFrom(e) == g.EdgeTo(e): ret true end
    end
    ret false
end

func _contract(g &: Graph, drop: int, u: int, v: int): Graph:
    mut map := Vector {} as Vector<int>
    defer map.Free()
    mut next := 0
    repeat g.n in x:
        if x == v: map.Push(GRAPH_NONE)
        else:
            map.Push(next)
            next++
        end
    end
    map.Set(v, map.Get(u))
    mut h := New(next, false)
    repeat g.Size() in e:
        if e != drop:
            h.AddEdge(map.Get(g.EdgeFrom(e)), map.Get(g.EdgeTo(e)))
        end
    end
    ret h
end

func _delete_edge(g &: Graph, drop: int): Graph:
    mut h := New(g.n, false)
    repeat g.Size() in e:
        if e != drop: h.AddEdge(g.EdgeFrom(e), g.EdgeTo(e)) end
    end
    ret h
end

func _count_colorings(g &: Graph, k: int): f64:
    if _has_loop(g): ret 0.0 end
    if g.Size() == 0: ret math.Pow(k as f64, g.n as f64) end
    e := 0
    u := g.EdgeFrom(e)
    v := g.EdgeTo(e)
    mut del := _delete_edge(g, e)
    mut con := _contract(g, e, u, v)
    a := _count_colorings(del, k)
    b := _count_colorings(con, k)
    defer del.Free()
    defer con.Free()
    ret a - b
end

@en "CountColorings"
@fa "شمار رنگ‌آمیزی‌ها"
pub func CountColorings(g &: Graph, k: int): f64:
    mut s := Simplify(g)
    repeat g.Size() in e:
        if g.EdgeFrom(e) == g.EdgeTo(e):
            s.Free()
            ret 0.0
        end
    end
    v := _count_colorings(s, k)
    defer s.Free()
    ret v
end
