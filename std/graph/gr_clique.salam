package graph

import math

func _bk_pivot(adj &: HashMap<i64, bool>, n: int, p: Vector<int>, x: Vector<int>): int:
    mut best := GRAPH_NONE
    mut bestc := GRAPH_NONE
    repeat p.Len() in i: _bk_offer(adj, n, p, p.Get(i), best, bestc) end
    repeat x.Len() in i: _bk_offer(adj, n, p, x.Get(i), best, bestc) end
    ret best
end

func _bk_offer(adj &: HashMap<i64, bool>, n: int, p: Vector<int>, u: int, best &: int, bestc &: int):
    mut c := 0
    repeat p.Len() in i:
        if adj.Has(_color_key(n, u, p.Get(i))): c++ end
    end
    if c > bestc:
        bestc = c
        best = u
    end
end

func _bk_filter(adj &: HashMap<i64, bool>, n: int, src: Vector<int>, v: int, out &: Vector<int>):
    out.Clear()
    repeat src.Len() in i:
        u := src.Get(i)
        if adj.Has(_color_key(n, v, u)): out.Push(u) end
    end
end

func _bk_run(adj &: HashMap<i64, bool>, n: int, r &: Vector<int>, p: Vector<int>, x: Vector<int>, best &: Vector<int>):
    if p.Len() == 0:
        if x.Len() == 0: _bk_record(r, best) end
        ret
    end
    pivot := _bk_pivot(adj, n, p, x)
    mut cand := Vector {} as Vector<int>
    defer cand.Free()
    repeat p.Len() in i:
        v := p.Get(i)
        if adj.Has(_color_key(n, pivot, v)) == false: cand.Push(v) end
    end
    mut px := Vector {} as Vector<int>
    defer px.Free()
    mut xx := Vector {} as Vector<int>
    defer xx.Free()
    _bk_branch(adj, n, r, p, x, best, cand, px, xx)
end

func _bk_branch(adj &: HashMap<i64, bool>, n: int, r &: Vector<int>, p: Vector<int>, x: Vector<int>, best &: Vector<int>, cand: Vector<int>, px &: Vector<int>, xx &: Vector<int>):
    mut live := Vector {} as Vector<int>
    defer live.Free()
    mut done := Vector {} as Vector<int>
    defer done.Free()
    repeat p.Len() in i: live.Push(p.Get(i)) end
    repeat x.Len() in i: done.Push(x.Get(i)) end
    repeat cand.Len() in i:
        v := cand.Get(i)
        _bk_filter(adj, n, live, v, px)
        _bk_filter(adj, n, done, v, xx)
        r.Push(v)
        _bk_run(adj, n, r, px, xx, best)
        r.Pop()
        _bk_drop(live, v)
        done.Push(v)
    end
end

func _bk_drop(v &: Vector<int>, x: int):
    mut keep := Vector {} as Vector<int>
    repeat v.Len() in i:
        if v.Get(i) != x: keep.Push(v.Get(i)) end
    end
    v.Clear()
    repeat keep.Len() in i: v.Push(keep.Get(i)) end
    defer keep.Free()
end

func _bk_record(r: Vector<int>, best &: Vector<int>):
    if r.Len() <= best.Len(): ret end
    best.Clear()
    repeat r.Len() in i: best.Push(r.Get(i)) end
end

@en "MaxClique"
@fa "بیشینه خوشه"
pub func MaxClique(g &: Graph): Vector<int>:
    mut adj := _color_adj(g)
    defer adj.Free()
    mut r := Vector {} as Vector<int>
    defer r.Free()
    mut p := Vector {} as Vector<int>
    defer p.Free()
    mut x := Vector {} as Vector<int>
    defer x.Free()
    mut best := Vector {} as Vector<int>
    Iota(p, g.n)
    _bk_run(adj, g.n, r, p, x, best)
    ret best
end

@en "CliqueNumber"
@fa "عدد خوشه"
pub func CliqueNumber(g &: Graph): int:
    mut c := MaxClique(g)
    defer c.Free()
    ret c.Len()
end

@en "MaximumIndependentSet"
@fa "بیشینه مجموعه مستقل"
pub func MaximumIndependentSet(g &: Graph): Vector<int>:
    mut c := Complement(g)
    best := MaxClique(c)
    defer c.Free()
    ret best
end

@en "IndependenceNumber"
@fa "عدد استقلال"
pub func IndependenceNumber(g &: Graph): int:
    mut s := MaximumIndependentSet(g)
    defer s.Free()
    ret s.Len()
end

@en "VertexCoverNumber"
@fa "عدد پوشش رأسی"
pub func VertexCoverNumber(g &: Graph): int:
    ret g.n - IndependenceNumber(g)
end

@en "GreedyVertexCover"
@fa "پوشش رأسی حریصانه"
pub func GreedyVertexCover(g &: Graph, cover &: Vector<bool>): int:
    FillBool(cover, g.n, false)
    mut count := 0
    repeat g.Size() in e:
        u := g.edge_from(e)
        v := g.edge_to(e)
        if u != v:
            if cover.Get(u) == false:
                if cover.Get(v) == false:
                    cover.Set(u, true)
                    cover.Set(v, true)
                    count += 2
                end
            end
        end
    end
    ret count
end
