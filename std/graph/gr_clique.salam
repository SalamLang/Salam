package graph
import math

// Cliques, independent sets and vertex covers: three views of the same
// problem, tied together by two classical identities.
//
// A set is independent in G exactly when it is a clique in the complement of
// G, so one maximum-clique search answers both. Gallai's identity says a set
// is independent exactly when its complement is a vertex cover, so the
// independence number and the vertex cover number always add up to n.
//
// All three are NP-hard. MaxClique is exact (Bron-Kerbosch with pivoting) and
// exponential; GreedyVertexCover is the linear-time 2-approximation for when
// that is too slow.

// A maximum clique, exactly, by Bron-Kerbosch with pivoting.
@en "MaxClique"
@fa "بیشینه خوشه"
@ar "أكبر زمرة"
pub func MaxClique(g &: Graph): Vector<int>:
    mut adj := _color_adj(g)
    defer adj.free()
    mut r := Vector {} as Vector<int>
    defer r.free()
    mut p := Vector {} as Vector<int>
    defer p.free()
    mut x := Vector {} as Vector<int>
    defer x.free()
    mut best := Vector {} as Vector<int>
    Iota(p, g.n)
    _bk_run(adj, g.n, r, p, x, best)
    ret best
end

@en "CliqueNumber"
@fa "عدد خوشه"
@ar "عدد الزمرة"
pub func CliqueNumber(g &: Graph): int:
    mut c := MaxClique(g)
    defer c.free()
    ret c.len()
end

// A maximum independent set: a maximum clique of the complement, since
// non-adjacency in G is adjacency in its complement.
@en "MaximumIndependentSet"
@fa "بیشینه مجموعه مستقل"
@ar "أكبر مجموعة مستقلة"
pub func MaximumIndependentSet(g &: Graph): Vector<int>:
    mut c := Complement(g)
    best := MaxClique(c)
    c.free()
    ret best
end

@en "IndependenceNumber"
@fa "عدد استقلال"
@ar "عدد الاستقلال"
pub func IndependenceNumber(g &: Graph): int:
    mut s := MaximumIndependentSet(g)
    defer s.free()
    ret s.len()
end

// Gallai's identity: a set is independent exactly when its complement is a
// vertex cover, so the two numbers add up to n.
@en "VertexCoverNumber"
@fa "عدد پوشش رأسی"
@ar "عدد غطاء الرؤوس"
pub func VertexCoverNumber(g &: Graph): int:
    ret g.n - IndependenceNumber(g)
end

// The textbook 2-approximation: take both ends of any uncovered edge. Never
// more than twice the optimum, and linear time, which is what you use when
// the exact routine is too slow.
@en "GreedyVertexCover"
@fa "پوشش رأسی حریصانه"
@ar "غطاء رؤوس جشع"
pub func GreedyVertexCover(g &: Graph, cover &: Vector<bool>): int:
    FillBool(cover, g.n, false)
    mut count := 0
    repeat g.size() with e:
        u := g.edge_from(e)
        v := g.edge_to(e)
        if u != v:
            if cover.get(u) == false:
                if cover.get(v) == false:
                    cover.set(u, true)
                    cover.set(v, true)
                    count += 2
                end
            end
        end
    end
    ret count
end

