package graph
import math

// Local structure: clustering coefficients, triangles, girth and degree
// assortativity.
//
// These are what distinguish a real network from a random one with the same
// density. Random graphs have clustering equal to their density and no
// degree correlation; social networks have far more clustering and positive
// assortativity, and technological ones negative.
//
// Every count here is over the underlying simple graph: parallel edges and
// self loops are ignored, since a triangle through the same edge twice is not
// a triangle.

// The fraction of u's neighbour pairs that are themselves adjacent: how
// close u's neighbourhood is to a clique. Zero degree and degree one give 0.
@en "LocalClustering"
@fa "خوشگی محلی"
@ar "التكتل المحلي"
pub func LocalClustering(g &: Graph, u: int): f64:
    mut adj := _adjacency_set(g)
    defer adj.free()
    mut nb := Vector {} as Vector<int>
    defer nb.free()
    _distinct_neighbors(g, u, nb)
    k := nb.len()
    if k < 2: ret 0.0 end
    links := _links_among(adj, nb, g.n)
    ret 2.0 * (links as f64) / ((k as f64) * ((k as f64) - 1.0))
end

// The mean local clustering coefficient, Watts and Strogatz's definition.
@en "AverageClustering"
@fa "میانگین خوشگی"
@ar "متوسط التكتل"
pub func AverageClustering(g &: Graph): f64:
    if g.n == 0: ret 0.0 end
    mut adj := _adjacency_set(g)
    defer adj.free()
    mut nb := Vector {} as Vector<int>
    defer nb.free()
    mut total := 0.0
    repeat g.n with u:
        _distinct_neighbors(g, u, nb)
        k := nb.len()
        if k > 1:
            links := _links_among(adj, nb, g.n)
            total += 2.0 * (links as f64) / ((k as f64) * ((k as f64) - 1.0))
        end
    end
    ret total / (g.n as f64)
end

// Transitivity: three times the number of triangles over the number of
// connected triples. This is the global coefficient, and it differs from the
// average of the local ones because it weights high degree nodes more.
@en "Transitivity"
@fa "تعدی"
@ar "التعدي"
pub func Transitivity(g &: Graph): f64:
    mut adj := _adjacency_set(g)
    defer adj.free()
    mut nb := Vector {} as Vector<int>
    defer nb.free()
    mut closed := 0
    mut triples := 0
    repeat g.n with u:
        _distinct_neighbors(g, u, nb)
        k := nb.len()
        triples += k * (k - 1) / 2
        closed += _links_among(adj, nb, g.n)
    end
    if triples == 0: ret 0.0 end
    ret (closed as f64) / (triples as f64)
end

// The number of triangles. Each is counted once: the sum over nodes of
// adjacent neighbour pairs counts every triangle three times.
@en "TriangleCount"
@fa "شمار مثلث"
@ar "عدد المثلثات"
pub func TriangleCount(g &: Graph): int:
    mut adj := _adjacency_set(g)
    defer adj.free()
    mut nb := Vector {} as Vector<int>
    defer nb.free()
    mut total := 0
    repeat g.n with u:
        _distinct_neighbors(g, u, nb)
        total += _links_among(adj, nb, g.n)
    end
    ret total / 3
end

// Degree assortativity: the Pearson correlation between the degrees at the
// two ends of an edge. Positive means high degree nodes attach to each other
// (social networks), negative means they attach to low degree ones
// (technological and biological networks).
@en "Assortativity"
@fa "همگون‌گرایی"
@ar "التماثل"
pub func Assortativity(g &: Graph): f64:
    m := g.size()
    if m == 0: ret 0.0 end
    mut s1 := 0.0
    mut s2 := 0.0
    mut s3 := 0.0
    repeat m with e:
        a := (g.degree(g.edge_from(e)) as f64) - 1.0
        b := (g.degree(g.edge_to(e)) as f64) - 1.0
        s1 += a * b
        s2 += a + b
        s3 += a * a + b * b
    end
    mf := m as f64
    num := s1 / mf - (s2 / (2.0 * mf)) * (s2 / (2.0 * mf))
    den := s3 / (2.0 * mf) - (s2 / (2.0 * mf)) * (s2 / (2.0 * mf))
    if math.Abs(den) < 0.000000000001: ret 0.0 end
    ret num / den
end

// The circuit rank m - n + c: the number of independent cycles, the
// dimension of the cycle space, and the number of edges you must remove to
// leave a spanning forest.
@en "CircuitRank"
@fa "رتبه مدار"
@ar "رتبة الدارة"
pub func CircuitRank(g &: Graph): int:
    ret g.size() - g.n + ComponentCount(g)
end

// The greatest weighted distance between any two nodes that can reach each
// other, by Dijkstra from every node.
@en "WeightedDiameter"
@fa "قطر وزنی"
@ar "قطر موزون"
pub func WeightedDiameter(g &: Graph): f64:
    mut best := 0.0
    mut dist := Vector {} as Vector<f64>
    defer dist.free()
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    repeat g.n with s:
        Dijkstra(g, s, dist, parent)
        repeat g.n with t:
            d := dist.get(t)
            if d < GRAPH_INF:
                if d > best: best = d end
            end
        end
    end
    ret best
end
