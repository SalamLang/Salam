package graph

func _color_key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end

func _color_adj(g &: Graph): HashMap<i64, bool>:
    mut s := HashMap {} as HashMap<i64, bool>
    repeat g.Size() in e:
        u := g.edge_from(e)
        v := g.edge_to(e)
        if u != v:
            s.Put(_color_key(g.n, u, v), true)
            s.Put(_color_key(g.n, v, u), true)
        end
    end
    ret s
end

func _lowest_free(g &: Graph, u: int, color: Vector<int>, used &: Vector<bool>): int:
    FillBool(used, g.n + 1, false)
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        c := color.Get(v)
        if c != GRAPH_NONE: used.Set(c, true) end
        k++
    end
    mut c := 0
    until used.Get(c): c++ end
    ret c
end

func _saturation(g &: Graph, u: int, color: Vector<int>, seen &: Vector<bool>): int:
    FillBool(seen, g.n + 1, false)
    mut count := 0
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        c := color.Get(g.adj_node(k))
        if c != GRAPH_NONE:
            if seen.Get(c) == false:
                seen.Set(c, true)
                count++
            end
        end
        k++
    end
    ret count
end

func _dsatur_pick(g &: Graph, color: Vector<int>, seen &: Vector<bool>): int:
    mut best := GRAPH_NONE
    mut bestsat := GRAPH_NONE
    repeat g.n in u:
        if color.Get(u) == GRAPH_NONE:
            sat := _saturation(g, u, color, seen)
            if _dsatur_better(g, u, best, sat, bestsat):
                best = u
                bestsat = sat
            end
        end
    end
    ret best
end

func _dsatur_better(g &: Graph, u: int, best: int, sat: int, bestsat: int): bool:
    if best == GRAPH_NONE: ret true end
    if sat > bestsat: ret true end
    if sat < bestsat: ret false end
    ret g.degree(u) > g.degree(best)
end

func _can_use(g &: Graph, u: int, c: int, color: Vector<int>): bool:
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        if v != u:
            if color.Get(v) == c: ret false end
        end
        k++
    end
    ret true
end

func _color_search(g &: Graph, k: int, u: int, color &: Vector<int>, high: int): bool:
    if u >= g.n: ret true end
    mut top := high + 1
    if top > k - 1: top = k - 1 end
    mut c := 0
    until c <= top:
        if _can_use(g, u, c, color):
            color.Set(u, c)
            mut nh := high
            if c > nh: nh = c end
            if _color_search(g, k, u + 1, color, nh): ret true end
            color.Set(u, GRAPH_NONE)
        end
        c++
    end
    ret false
end

func _mark_incident(g &: Graph, u: int, ecolor: Vector<int>, used &: Vector<bool>):
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        c := ecolor.Get(g.adj_edge(k))
        if c != GRAPH_NONE: used.Set(c, true) end
        k++
    end
end

@en "GreedyColoring"
@fa "رنگ‌آمیزی حریصانه"
pub func GreedyColoring(g &: Graph, order: Vector<int>): Vector<int>:
    mut color := Vector {} as Vector<int>
    mut used := Vector {} as Vector<bool>
    defer used.Free()
    FillInt(color, g.n, GRAPH_NONE)
    repeat order.Len() in i:
        u := order.Get(i)
        color.Set(u, _lowest_free(g, u, color, used))
    end
    ret color
end

@en "GreedyColoringNatural"
@fa "رنگ‌آمیزی حریصانه طبیعی"
pub func GreedyColoringNatural(g &: Graph): Vector<int>:
    mut order := Vector {} as Vector<int>
    defer order.Free()
    Iota(order, g.n)
    ret GreedyColoring(g, order)
end

@en "WelshPowell"
@fa "ولش پاول"
pub func WelshPowell(g &: Graph): Vector<int>:
    mut h := MinHeap {}
    defer h.Free()
    repeat g.n in u: h.Push(0.0 - (g.degree(u) as f64), u) end
    mut order := Vector {} as Vector<int>
    defer order.Free()
    until h.IsEmpty() == false: order.Push(h.Pop()) end
    ret GreedyColoring(g, order)
end

@en "DSatur"
@fa "دی‌سچور"
pub func DSatur(g &: Graph): Vector<int>:
    mut color := Vector {} as Vector<int>
    mut used := Vector {} as Vector<bool>
    defer used.Free()
    mut seen := Vector {} as Vector<bool>
    defer seen.Free()
    FillInt(color, g.n, GRAPH_NONE)
    repeat g.n:
        u := _dsatur_pick(g, color, seen)
        if u == GRAPH_NONE: break end
        color.Set(u, _lowest_free(g, u, color, used))
    end
    ret color
end

@en "ColorCount"
@fa "شمار رنگ"
pub func ColorCount(color: Vector<int>): int:
    mut best := GRAPH_NONE
    repeat color.Len() in u:
        if color.Get(u) > best: best = color.Get(u) end
    end
    ret best + 1
end

@en "IsProperColoring"
@fa "رنگ‌آمیزی معتبر است"
pub func IsProperColoring(g &: Graph, color: Vector<int>): bool:
    repeat g.Size() in e:
        u := g.edge_from(e)
        v := g.edge_to(e)
        if u != v:
            if color.Get(u) == color.Get(v): ret false end
        end
    end
    ret true
end

@en "ChromaticNumber"
@fa "عدد رنگی"
pub func ChromaticNumber(g &: Graph): int:
    if g.n == 0: ret 0 end
    repeat g.Size() in e:
        if g.edge_from(e) == g.edge_to(e): ret GRAPH_NONE end
    end
    mut color := Vector {} as Vector<int>
    defer color.Free()
    mut upper := DSatur(g)
    limit := ColorCount(upper)
    defer upper.Free()
    mut k := 1
    until k <= limit:
        FillInt(color, g.n, GRAPH_NONE)
        if _color_search(g, k, 0, color, GRAPH_NONE): ret k end
        k++
    end
    ret limit
end

@en "EdgeColoringGreedy"
@fa "رنگ‌آمیزی یالی حریصانه"
pub func EdgeColoringGreedy(g &: Graph): Vector<int>:
    mut ecolor := Vector {} as Vector<int>
    mut used := Vector {} as Vector<bool>
    defer used.Free()
    FillInt(ecolor, g.Size(), GRAPH_NONE)
    repeat g.Size() in e:
        FillBool(used, 2 * g.n + 2, false)
        _mark_incident(g, g.edge_from(e), ecolor, used)
        _mark_incident(g, g.edge_to(e), ecolor, used)
        mut c := 0
        until used.Get(c): c++ end
        ecolor.Set(e, c)
    end
    ret ecolor
end
