package graph

import math

// Colouring, cliques, independent sets and vertex covers: the NP-hard corner
// of the library, where the honest thing is to say which routines are exact
// and which are heuristics.
//
//   GreedyColoring    heuristic, <= maxdegree + 1 colours, O(n + m)
//   WelshPowell       greedy in descending degree order, usually better
//   DSatur            greedy by saturation, exact on bipartite and chordal
//   ChromaticNumber   exact, branch and bound, exponential
//   CountColorings    exact chromatic polynomial value, deletion-contraction
//   MaxClique         exact, Bron-Kerbosch with pivoting, exponential
//
// The exact routines are for graphs of tens of nodes, not thousands. That is
// not an implementation limit; it is what the problems cost.
//
// Colours are 0-based integers. A colouring is proper when no edge joins two
// nodes of the same colour, which IsProperColoring checks and every routine
// here guarantees, self loops excepted: a self loop makes a proper colouring
// impossible and is ignored rather than making everything fail.

func _color_key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end

func _color_adj(g &: Graph): HashMap<i64, bool>:
    mut s := HashMap {} as HashMap<i64, bool>
    repeat g.size() with e:
        u := g.edge_from(e)
        v := g.edge_to(e)
        if u != v:
            s.put(_color_key(g.n, u, v), true)
            s.put(_color_key(g.n, v, u), true)
        end
    end
    ret s
end

// The lowest colour not used by any neighbour, which is the greedy choice.
func _lowest_free(g &: Graph, u: int, color: Vector<int>, used &: Vector<bool>): int:
    FillBool(used, g.n + 1, false)
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        c := color.get(v)
        if c != GRAPH_NONE: used.set(c, true) end
        k += 1
    end
    mut c := 0
    until used.get(c): c += 1 end
    ret c
end

// Saturation: how many distinct colours already surround a node. DSatur
// always takes the most constrained node next, breaking ties by degree.
func _saturation(g &: Graph, u: int, color: Vector<int>, seen &: Vector<bool>): int:
    FillBool(seen, g.n + 1, false)
    mut count := 0
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        c := color.get(g.adj_node(k))
        if c != GRAPH_NONE:
            if seen.get(c) == false:
                seen.set(c, true)
                count += 1
            end
        end
        k += 1
    end
    ret count
end

func _dsatur_pick(g &: Graph, color: Vector<int>, seen &: Vector<bool>): int:
    mut best := GRAPH_NONE
    mut bestsat := GRAPH_NONE
    repeat g.n with u:
        if color.get(u) == GRAPH_NONE:
            sat := _saturation(g, u, color, seen)
            if _dsatur_better(g, u, best, sat, bestsat):
                best = u
                bestsat = sat
            end
        end
    end
    ret best
end

func _dsatur_better(g &: Graph, u: int, best: int, sat: int, bestsat: int): bool:
    if best == GRAPH_NONE: ret true end
    if sat > bestsat: ret true end
    if sat < bestsat: ret false end
    ret g.degree(u) > g.degree(best)
end

func _can_use(g &: Graph, u: int, c: int, color: Vector<int>): bool:
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        if v != u:
            if color.get(v) == c: ret false end
        end
        k += 1
    end
    ret true
end

// Backtracking k-colouring. Colours are tried in order and a node may only
// open a colour one higher than the highest used so far, which kills the k!
// symmetry between equivalent colourings and is what makes this finish.
func _color_search(g &: Graph, k: int, u: int, color &: Vector<int>, high: int): bool:
    if u >= g.n: ret true end
    mut top := high + 1
    if top > k - 1: top = k - 1 end
    mut c := 0
    until c <= top:
        if _can_use(g, u, c, color):
            color.set(u, c)
            mut nh := high
            if c > nh: nh = c end
            if _color_search(g, k, u + 1, color, nh): ret true end
            color.set(u, GRAPH_NONE)
        end
        c += 1
    end
    ret false
end

func _has_loop(g &: Graph): bool:
    repeat g.size() with e:
        if g.edge_from(e) == g.edge_to(e): ret true end
    end
    ret false
end

// Contract edge `drop`, whose ends are u and v: v disappears into u and the
// edge itself goes with it. Every other edge is kept exactly as it is, which
// includes any parallel copy of `drop` that is now a self loop on the merged
// node. Those loops are the whole point: a loop means no proper colouring,
// and dropping them would inflate every count.
func _contract(g &: Graph, drop: int, u: int, v: int): Graph:
    mut map := Vector {} as Vector<int>
    defer map.free()
    mut next := 0
    repeat g.n with x:
        if x == v: map.push(GRAPH_NONE)
        else:
            map.push(next)
            next += 1
        end
    end
    map.set(v, map.get(u))
    mut h := New(next, false)
    repeat g.size() with e:
        if e != drop:
            h.add_edge(map.get(g.edge_from(e)), map.get(g.edge_to(e)))
        end
    end
    ret h
end

func _delete_edge(g &: Graph, drop: int): Graph:
    mut h := New(g.n, false)
    repeat g.size() with e:
        if e != drop: h.add_edge(g.edge_from(e), g.edge_to(e)) end
    end
    ret h
end

// The chromatic polynomial by deletion-contraction: P(G) = P(G - e) - P(G/e).
// Every step removes an edge or a node, so the recursion terminates on the
// empty graph, where every one of the k^n assignments is proper.
//
// Contraction is where this is easy to get wrong. Merging the ends of one of
// two parallel edges turns the other into a self loop, and a self loop means
// no proper colouring at all. Dropping those loops instead would make
// P(two parallel edges) come out as P(one edge) minus P(a bare node) rather
// than minus zero, and every count above a triangle would be too high.
func _count_colorings(g &: Graph, k: int): f64:
    if _has_loop(g): ret 0.0 end
    if g.size() == 0: ret math.Pow(k as f64, g.n as f64) end
    e := 0
    u := g.edge_from(e)
    v := g.edge_to(e)
    mut del := _delete_edge(g, e)
    mut con := _contract(g, e, u, v)
    a := _count_colorings(del, k)
    b := _count_colorings(con, k)
    del.free()
    con.free()
    ret a - b
end

// Bron-Kerbosch with pivoting. The pivot is a node of P union X with the most
// neighbours in P; only non-neighbours of the pivot need to be branched on,
// since any maximal clique must contain the pivot or one of them.
func _bk_pivot(adj &: HashMap<i64, bool>, n: int, p: Vector<int>, x: Vector<int>): int:
    mut best := GRAPH_NONE
    mut bestc := GRAPH_NONE
    repeat p.len() with i: _bk_offer(adj, n, p, p.get(i), best, bestc) end
    repeat x.len() with i: _bk_offer(adj, n, p, x.get(i), best, bestc) end
    ret best
end

func _bk_offer(adj &: HashMap<i64, bool>, n: int, p: Vector<int>, u: int, best &: int, bestc &: int):
    mut c := 0
    repeat p.len() with i:
        if adj.has(_color_key(n, u, p.get(i))): c += 1 end
    end
    if c > bestc:
        bestc = c
        best = u
    end
end

func _bk_filter(adj &: HashMap<i64, bool>, n: int, src: Vector<int>, v: int, out &: Vector<int>):
    out.clear()
    repeat src.len() with i:
        u := src.get(i)
        if adj.has(_color_key(n, v, u)): out.push(u) end
    end
end

func _bk_run(adj &: HashMap<i64, bool>, n: int, r &: Vector<int>, p: Vector<int>, x: Vector<int>, best &: Vector<int>):
    if p.len() == 0:
        if x.len() == 0: _bk_record(r, best) end
        ret
    end
    pivot := _bk_pivot(adj, n, p, x)
    mut cand := Vector {} as Vector<int>
    defer cand.free()
    repeat p.len() with i:
        v := p.get(i)
        if adj.has(_color_key(n, pivot, v)) == false: cand.push(v) end
    end
    mut px := Vector {} as Vector<int>
    defer px.free()
    mut xx := Vector {} as Vector<int>
    defer xx.free()
    _bk_branch(adj, n, r, p, x, best, cand, px, xx)
end

func _bk_branch(adj &: HashMap<i64, bool>, n: int, r &: Vector<int>, p: Vector<int>, x: Vector<int>, best &: Vector<int>, cand: Vector<int>, px &: Vector<int>, xx &: Vector<int>):
    mut live := Vector {} as Vector<int>
    defer live.free()
    mut done := Vector {} as Vector<int>
    defer done.free()
    repeat p.len() with i: live.push(p.get(i)) end
    repeat x.len() with i: done.push(x.get(i)) end
    repeat cand.len() with i:
        v := cand.get(i)
        _bk_filter(adj, n, live, v, px)
        _bk_filter(adj, n, done, v, xx)
        r.push(v)
        _bk_run(adj, n, r, px, xx, best)
        r.pop()
        _bk_drop(live, v)
        done.push(v)
    end
end

func _bk_drop(v &: Vector<int>, x: int):
    mut keep := Vector {} as Vector<int>
    repeat v.len() with i:
        if v.get(i) != x: keep.push(v.get(i)) end
    end
    v.clear()
    repeat keep.len() with i: v.push(keep.get(i)) end
    keep.free()
end

func _bk_record(r: Vector<int>, best &: Vector<int>):
    if r.len() <= best.len(): ret end
    best.clear()
    repeat r.len() with i: best.push(r.get(i)) end
end

func _mark_incident(g &: Graph, u: int, ecolor: Vector<int>, used &: Vector<bool>):
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        c := ecolor.get(g.adj_edge(k))
        if c != GRAPH_NONE: used.set(c, true) end
        k += 1
    end
end

// Greedy colouring in the given node order: each node takes the lowest colour
// none of its neighbours has. Never needs more than maxdegree + 1 colours,
// and the order is what decides how close to optimal it gets.
@en "GreedyColoring"
@fa "رنگ‌آمیزی حریصانه"
@ar "تلوين جشع"
pub func GreedyColoring(g &: Graph, order: Vector<int>): Vector<int>:
    mut color := Vector {} as Vector<int>
    mut used := Vector {} as Vector<bool>
    defer used.free()
    FillInt(color, g.n, GRAPH_NONE)
    repeat order.len() with i:
        u := order.get(i)
        color.set(u, _lowest_free(g, u, color, used))
    end
    ret color
end

@en "GreedyColoringNatural"
@fa "رنگ‌آمیزی حریصانه طبیعی"
@ar "تلوين جشع طبيعي"
pub func GreedyColoringNatural(g &: Graph): Vector<int>:
    mut order := Vector {} as Vector<int>
    defer order.free()
    Iota(order, g.n)
    ret GreedyColoring(g, order)
end

// Welsh-Powell: greedy in order of descending degree. The high degree nodes
// are the constrained ones, so colouring them first leaves fewer conflicts.
@en "WelshPowell"
@fa "ولش-پاول"
@ar "ويلش-باول"
pub func WelshPowell(g &: Graph): Vector<int>:
    mut h := MinHeap { }
    defer h.free()
    repeat g.n with u: h.push(0.0 - (g.degree(u) as f64), u) end
    mut order := Vector {} as Vector<int>
    defer order.free()
    until h.is_empty() == false: order.push(h.pop()) end
    ret GreedyColoring(g, order)
end

// DSatur: at every step colour the node with the most differently-coloured
// neighbours. It is exact on bipartite, cycle and chordal graphs, and is the
// best of the greedy heuristics in general.
@en "DSatur"
@fa "دی‌سچور"
@ar "دي ساتور"
pub func DSatur(g &: Graph): Vector<int>:
    mut color := Vector {} as Vector<int>
    mut used := Vector {} as Vector<bool>
    defer used.free()
    mut seen := Vector {} as Vector<bool>
    defer seen.free()
    FillInt(color, g.n, GRAPH_NONE)
    repeat g.n:
        u := _dsatur_pick(g, color, seen)
        if u == GRAPH_NONE: break end
        color.set(u, _lowest_free(g, u, color, used))
    end
    ret color
end

@en "ColorCount"
@fa "شمار رنگ"
@ar "عدد الألوان"
pub func ColorCount(color: Vector<int>): int:
    mut best := GRAPH_NONE
    repeat color.len() with u:
        if color.get(u) > best: best = color.get(u) end
    end
    ret best + 1
end

@en "IsProperColoring"
@fa "رنگ‌آمیزی درست است"
@ar "تلوين صحيح"
pub func IsProperColoring(g &: Graph, color: Vector<int>): bool:
    repeat g.size() with e:
        u := g.edge_from(e)
        v := g.edge_to(e)
        if u != v:
            if color.get(u) == color.get(v): ret false end
        end
    end
    ret true
end

// The exact chromatic number, by asking "is there a proper k-colouring" for
// k = 1, 2, ... until one succeeds. The greedy result bounds the search from
// above and the answer is never below the size of any clique.
@en "ChromaticNumber"
@fa "عدد رنگی"
@ar "العدد اللوني"
pub func ChromaticNumber(g &: Graph): int:
    if g.n == 0: ret 0 end
    repeat g.size() with e:
        if g.edge_from(e) == g.edge_to(e): ret GRAPH_NONE end
    end
    mut color := Vector {} as Vector<int>
    defer color.free()
    mut upper := DSatur(g)
    limit := ColorCount(upper)
    upper.free()
    mut k := 1
    until k <= limit:
        FillInt(color, g.n, GRAPH_NONE)
        if _color_search(g, k, 0, color, GRAPH_NONE): ret k end
        k += 1
    end
    ret limit
end

// The number of proper colourings with k colours: the chromatic polynomial
// evaluated at k. Zero exactly when k is below the chromatic number, which
// makes it a second, independent way to compute that number.
@en "CountColorings"
@fa "شمار رنگ‌آمیزی‌ها"
@ar "عدد التلوينات"
pub func CountColorings(g &: Graph, k: int): f64:
    mut s := Simplify(g)
    repeat g.size() with e:
        if g.edge_from(e) == g.edge_to(e):
            s.free()
            ret 0.0
        end
    end
    v := _count_colorings(s, k)
    s.free()
    ret v
end

// Greedy edge colouring: adjacent edges get different colours. Vizing's
// theorem says maxdegree or maxdegree + 1 colours always suffice; greedy can
// use up to 2 maxdegree - 1, so this is an upper bound, not the index.
@en "EdgeColoringGreedy"
@fa "رنگ‌آمیزی یالی حریصانه"
@ar "تلوين الأضلاع الجشع"
pub func EdgeColoringGreedy(g &: Graph): Vector<int>:
    mut ecolor := Vector {} as Vector<int>
    mut used := Vector {} as Vector<bool>
    defer used.free()
    FillInt(ecolor, g.size(), GRAPH_NONE)
    repeat g.size() with e:
        FillBool(used, 2 * g.n + 2, false)
        _mark_incident(g, g.edge_from(e), ecolor, used)
        _mark_incident(g, g.edge_to(e), ecolor, used)
        mut c := 0
        until used.get(c): c += 1 end
        ecolor.set(e, c)
    end
    ret ecolor
end

