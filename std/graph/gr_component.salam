package graph

@en "Components"
@fa "مؤلفه‌ها"
pub func Components(g &: Graph, comp &: Vector<int>): int:
    FillInt(comp, g.n, GRAPH_NONE)
    mut id := 0
    repeat g.n with u:
        if comp.get(u) == GRAPH_NONE:
            _comp_bfs(g, u, id, comp)
            id += 1
        end
    end
    ret id
end

@en "ComponentCount"
@fa "شمار مؤلفه"
pub func ComponentCount(g &: Graph): int:
    mut comp := Vector {} as Vector<int>
    defer comp.free()
    ret Components(g, comp)
end

@en "ComponentSizes"
@fa "اندازه مؤلفه‌ها"
pub func ComponentSizes(g &: Graph): Vector<int>:
    mut comp := Vector {} as Vector<int>
    defer comp.free()
    c := Components(g, comp)
    mut out := Vector {} as Vector<int>
    FillInt(out, c, 0)
    repeat g.n with u:
        i := comp.get(u)
        out.set(i, out.get(i) + 1)
    end
    ret out
end

@en "IsConnected"
@fa "همبند است"
pub func IsConnected(g &: Graph): bool:
    if g.n == 0: ret true end
    ret ComponentCount(g) == 1
end

@en "IsBipartite"
@fa "دوبخشی است"
pub func IsBipartite(g &: Graph, color &: Vector<int>): bool:
    FillInt(color, g.n, GRAPH_NONE)
    if g.directed == false: ret _bipartite_all(g, color, g.n) end
    mut u := ToUndirected(g)
    ok := _bipartite_all(u, color, g.n)
    defer u.free()
    ret ok
end

@en "Bipartite"
@fa "دوبخشی"
pub func Bipartite(g &: Graph): bool:
    mut color := Vector {} as Vector<int>
    defer color.free()
    ret IsBipartite(g, color)
end

@en "TopologicalSort"
@fa "مرتب‌سازی توپولوژیک"
pub func TopologicalSort(g &: Graph, order &: Vector<int>): bool:
    order.clear()
    mut deg := Vector {} as Vector<int>
    defer deg.free()
    _indegrees(g, deg)
    mut q := Vector {} as Vector<int>
    defer q.free()
    repeat g.n with u:
        if deg.get(u) == 0: q.push(u) end
    end
    mut head := 0
    until head < q.len():
        u := q.get(head)
        head += 1
        order.push(u)
        _relax_indegree(g, u, deg, q)
    end
    ret order.len() == g.n
end

@en "TopologicalSortLex"
@fa "مرتب‌سازی توپولوژیک الفبایی"
pub func TopologicalSortLex(g &: Graph, order &: Vector<int>): bool:
    order.clear()
    mut deg := Vector {} as Vector<int>
    defer deg.free()
    _indegrees(g, deg)
    mut h := MinHeap { }
    defer h.free()
    repeat g.n with u:
        if deg.get(u) == 0: h.push(u as f64, u) end
    end
    until h.is_empty() == false:
        u := h.pop()
        order.push(u)
        _relax_indegree_heap(g, u, deg, h)
    end
    ret order.len() == g.n
end

@en "IsDAG"
@fa "گراف جهت‌دار بی‌دور است"
pub func IsDAG(g &: Graph): bool:
    if g.directed == false: ret false end
    mut order := Vector {} as Vector<int>
    defer order.free()
    ret TopologicalSort(g, order)
end

@en "FindCycle"
@fa "یافتن دور"
pub func FindCycle(g &: Graph): Vector<int>:
    mut out := Vector {} as Vector<int>
    mut state := Vector {} as Vector<int>
    defer state.free()
    FillInt(state, g.n, 0)
    repeat g.n with u:
        if state.get(u) == 0:
            if _find_cycle_from(g, u, state, out): ret out end
        end
    end
    ret out
end

@en "HasCycle"
@fa "دارای دور"
pub func HasCycle(g &: Graph): bool:
    mut c := FindCycle(g)
    defer c.free()
    ret c.len() > 0
end
