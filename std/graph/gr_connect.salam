package graph

func _tarjan_walk(g &: Graph, root: int, disc &: Vector<int>, low &: Vector<int>, comp &: Vector<int>, onstk &: Vector<bool>, timer &: int, ncomp &: int):
    mut stk := Vector {} as Vector<int>
    defer stk.Free()
    mut call := Vector {} as Vector<int>
    defer call.Free()
    mut it := Vector {} as Vector<int>
    defer it.Free()
    _tarjan_open(g, root, disc, low, onstk, stk, call, it, timer)
    until call.Len() > 0:
        u := call.Last()
        k := it.Last()
        if k < g.adj_stop(u):
            it.Set(it.Len() - 1, k + 1)
            _tarjan_edge(g, u, g.adj_node(k), disc, low, onstk, stk, call, it, timer)
        else:
            _tarjan_close(u, disc, low, comp, onstk, stk, call, it, ncomp)
        end
    end
end

func _tarjan_open(g &: Graph, v: int, disc &: Vector<int>, low &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, timer &: int):
    disc.Set(v, timer)
    low.Set(v, timer)
    timer++
    stk.Push(v)
    onstk.Set(v, true)
    call.Push(v)
    it.Push(g.adj_start(v))
end

func _tarjan_edge(g &: Graph, u: int, v: int, disc &: Vector<int>, low &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, timer &: int):
    if disc.Get(v) == GRAPH_NONE:
        _tarjan_open(g, v, disc, low, onstk, stk, call, it, timer)
        ret
    end
    if onstk.Get(v):
        if disc.Get(v) < low.Get(u): low.Set(u, disc.Get(v)) end
    end
end

func _tarjan_close(u: int, disc &: Vector<int>, low &: Vector<int>, comp &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, ncomp &: int):
    if low.Get(u) == disc.Get(u):
        until true:
            w := stk.Pop()
            onstk.Set(w, false)
            comp.Set(w, ncomp)
            if w == u: break end
        end
        ncomp++
    end
    call.Pop()
    it.Pop()
    if call.Len() > 0:
        p := call.Last()
        if low.Get(u) < low.Get(p): low.Set(p, low.Get(u)) end
    end
end

func _bcc_open(g &: Graph, v: int, e: int, disc &: Vector<int>, low &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, timer &: int):
    disc.Set(v, timer)
    low.Set(v, timer)
    timer++
    call.Push(v)
    it.Push(g.adj_start(v))
    via.Push(e)
    kids.Push(0)
end

func _bcc_close(u: int, p: int, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, estack &: Vector<int>, kids: Vector<int>, e: int, ncomp &: int):
    if low.Get(u) < low.Get(p): low.Set(p, low.Get(u)) end
    if low.Get(u) > disc.Get(p): bridge.Set(e, true) end
    if low.Get(u) >= disc.Get(p):
        if p != root: isart.Set(p, true)
        else kids.Get(kids.Len() - 1) > 1: isart.Set(p, true)
        end
        until true:
            f := estack.Pop()
            ecomp.Set(f, ncomp)
            if f == e: break end
        end
        ncomp++
    end
end

func _bcc_walk(g &: Graph, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, timer &: int, ncomp &: int):
    mut call := Vector {} as Vector<int>
    defer call.Free()
    mut it := Vector {} as Vector<int>
    defer it.Free()
    mut via := Vector {} as Vector<int>
    defer via.Free()
    mut kids := Vector {} as Vector<int>
    defer kids.Free()
    mut estack := Vector {} as Vector<int>
    defer estack.Free()
    _bcc_open(g, root, GRAPH_NONE, disc, low, call, it, via, kids, timer)
    until call.Len() > 0:
        u := call.Last()
        k := it.Last()
        if k < g.adj_stop(u):
            it.Set(it.Len() - 1, k + 1)
            _bcc_step(g, u, k, disc, low, call, it, via, kids, estack, timer)
        else:
            _bcc_pop(u, root, disc, low, isart, bridge, ecomp, estack, call, it, via, kids, ncomp)
        end
    end
end

func _bcc_step(g &: Graph, u: int, k: int, disc &: Vector<int>, low &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, estack &: Vector<int>, timer &: int):
    e := g.adj_edge(k)
    v := g.adj_node(k)
    if e == via.Last(): ret end
    if disc.Get(v) == GRAPH_NONE:
        estack.Push(e)
        kids.Set(kids.Len() - 1, kids.Last() + 1)
        _bcc_open(g, v, e, disc, low, call, it, via, kids, timer)
        ret
    end
    if disc.Get(v) < disc.Get(u):
        estack.Push(e)
        if disc.Get(v) < low.Get(u): low.Set(u, disc.Get(v)) end
    end
end

func _bcc_pop(u: int, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, estack &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, ncomp &: int):
    e := via.Last()
    call.Pop()
    it.Pop()
    via.Pop()
    kids.Pop()
    if call.Len() > 0:
        p := call.Last()
        _bcc_close(u, p, root, disc, low, isart, bridge, ecomp, estack, kids, e, ncomp)
    end
end

func _dedupe_arc(seen &: HashMap<i64, bool>, h &: Graph, a: int, b: int, n: int):
    k := (a as i64) * (n as i64) + (b as i64)
    if seen.Has(k): ret end
    seen.Put(k, true)
    h.add_edge(a, b)
end

func _kosaraju_pass(t &: Graph, order: Vector<int>, comp &: Vector<int>): int:
    mut ncomp := 0
    mut i := order.Len() - 1
    until i >= 0:
        u := order.Get(i)
        if comp.Get(u) == GRAPH_NONE:
            _label_reachable(t, u, ncomp, comp)
            ncomp++
        end
        i--
    end
    ret ncomp
end

func _label_reachable(t &: Graph, s: int, id: int, comp &: Vector<int>):
    mut q := Vector {} as Vector<int>
    defer q.Free()
    comp.Set(s, id)
    q.Push(s)
    mut head := 0
    until head < q.Len():
        u := q.Get(head)
        head++
        mut k := t.adj_start(u)
        stop := t.adj_stop(u)
        until k < stop:
            v := t.adj_node(k)
            if comp.Get(v) == GRAPH_NONE:
                comp.Set(v, id)
                q.Push(v)
            end
            k++
        end
    end
end

func _bcc_all(g &: Graph, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>): int:
    if g.directed == false: ret _bcc_run(g, isart, bridge, ecomp) end
    mut u := ToUndirected(g)
    c := _bcc_run(u, isart, bridge, ecomp)
    defer u.Free()
    ret c
end

func _bcc_run(g &: Graph, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>): int:
    mut disc := Vector {} as Vector<int>
    defer disc.Free()
    mut low := Vector {} as Vector<int>
    defer low.Free()
    FillInt(disc, g.n, GRAPH_NONE)
    FillInt(low, g.n, 0)
    FillBool(isart, g.n, false)
    FillBool(bridge, g.Size(), false)
    FillInt(ecomp, g.Size(), GRAPH_NONE)
    mut timer := 0
    mut ncomp := 0
    repeat g.n in u:
        if disc.Get(u) == GRAPH_NONE:
            _bcc_walk(g, u, disc, low, isart, bridge, ecomp, timer, ncomp)
        end
    end
    ret ncomp
end

@en "StronglyConnected"
@fa "مؤلفه‌های همبند قوی"
pub func StronglyConnected(g &: Graph, comp &: Vector<int>): int:
    mut disc := Vector {} as Vector<int>
    defer disc.Free()
    mut low := Vector {} as Vector<int>
    defer low.Free()
    mut onstk := Vector {} as Vector<bool>
    defer onstk.Free()
    FillInt(disc, g.n, GRAPH_NONE)
    FillInt(low, g.n, 0)
    FillBool(onstk, g.n, false)
    FillInt(comp, g.n, GRAPH_NONE)
    mut timer := 0
    mut ncomp := 0
    repeat g.n in u:
        if disc.Get(u) == GRAPH_NONE:
            _tarjan_walk(g, u, disc, low, comp, onstk, timer, ncomp)
        end
    end
    ret ncomp
end

@en "SCCCount"
@fa "شمار مؤلفه قوی"
pub func SCCCount(g &: Graph): int:
    mut comp := Vector {} as Vector<int>
    defer comp.Free()
    ret StronglyConnected(g, comp)
end

@en "IsStronglyConnected"
@fa "همبند قوی است"
pub func IsStronglyConnected(g &: Graph): bool:
    if g.n == 0: ret true end
    ret SCCCount(g) == 1
end

@en "Kosaraju"
@fa "کوساراجو"
pub func Kosaraju(g &: Graph, comp &: Vector<int>): int:
    mut order := Vector {} as Vector<int>
    defer order.Free()
    mut seen := Vector {} as Vector<bool>
    defer seen.Free()
    mut pre := Vector {} as Vector<int>
    defer pre.Free()
    FillBool(seen, g.n, false)
    repeat g.n in u: _dfs_walk(g, u, pre, order, seen) end
    mut t := Transpose(g)
    FillInt(comp, g.n, GRAPH_NONE)
    ncomp := _kosaraju_pass(t, order, comp)
    defer t.Free()
    ret ncomp
end

@en "Condensation"
@fa "چگالش"
pub func Condensation(g &: Graph, comp &: Vector<int>): Graph:
    ncomp := StronglyConnected(g, comp)
    mut h := New(ncomp, true)
    mut seen := HashMap {} as HashMap<i64, bool>
    defer seen.Free()
    repeat g.Size() in e:
        a := comp.Get(g.edge_from(e))
        b := comp.Get(g.edge_to(e))
        if a != b: _dedupe_arc(seen, h, a, b, ncomp) end
    end
    ret h
end

@en "Bridges"
@fa "پل‌ها"
pub func Bridges(g &: Graph): Vector<int>:
    mut isart := Vector {} as Vector<bool>
    defer isart.Free()
    mut bridge := Vector {} as Vector<bool>
    defer bridge.Free()
    mut ecomp := Vector {} as Vector<int>
    defer ecomp.Free()
    _bcc_all(g, isart, bridge, ecomp)
    mut out := Vector {} as Vector<int>
    repeat g.Size() in e:
        if bridge.Get(e): out.Push(e) end
    end
    ret out
end

@en "ArticulationPoints"
@fa "نقاط برش"
pub func ArticulationPoints(g &: Graph): Vector<int>:
    mut isart := Vector {} as Vector<bool>
    defer isart.Free()
    mut bridge := Vector {} as Vector<bool>
    defer bridge.Free()
    mut ecomp := Vector {} as Vector<int>
    defer ecomp.Free()
    _bcc_all(g, isart, bridge, ecomp)
    mut out := Vector {} as Vector<int>
    repeat g.n in u:
        if isart.Get(u): out.Push(u) end
    end
    ret out
end

@en "BiconnectedComponents"
@fa "مؤلفه‌های دوهمبند"
pub func BiconnectedComponents(g &: Graph, ecomp &: Vector<int>): int:
    mut isart := Vector {} as Vector<bool>
    defer isart.Free()
    mut bridge := Vector {} as Vector<bool>
    defer bridge.Free()
    ret _bcc_all(g, isart, bridge, ecomp)
end

@en "IsBiconnected"
@fa "دوهمبند است"
pub func IsBiconnected(g &: Graph): bool:
    if g.n < 3: ret false end
    if IsConnected(g) == false: ret false end
    mut a := ArticulationPoints(g)
    defer a.Free()
    ret a.Len() == 0
end

@en "IsTwoEdgeConnected"
@fa "دو یال همبند است"
pub func IsTwoEdgeConnected(g &: Graph): bool:
    if g.n < 2: ret false end
    if IsConnected(g) == false: ret false end
    mut b := Bridges(g)
    defer b.Free()
    ret b.Len() == 0
end

@en "TwoEdgeComponents"
@fa "مؤلفه‌های دویالی"
pub func TwoEdgeComponents(g &: Graph, comp &: Vector<int>): int:
    mut bridge := Vector {} as Vector<bool>
    defer bridge.Free()
    mut isart := Vector {} as Vector<bool>
    defer isart.Free()
    mut ecomp := Vector {} as Vector<int>
    defer ecomp.Free()
    _bcc_all(g, isart, bridge, ecomp)
    mut keep := Vector {} as Vector<bool>
    defer keep.Free()
    repeat g.Size() in e: keep.Push(bridge.Get(e) == false) end
    mut h := EdgeSubgraph(g, keep)
    c := Components(h, comp)
    defer h.Free()
    ret c
end
