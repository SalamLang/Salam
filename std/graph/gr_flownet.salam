package graph

@en "FlowNet"
@fa "شبکه شار"
pub struct FlowNet:
    pub n: int = 0
    pub head: Vector<int> = Vector {}
    pub to: Vector<int> = Vector {}
    pub cap: Vector<f64> = Vector {}
    pub cost: Vector<f64> = Vector {}
    pub orig: Vector<f64> = Vector {}
    pub nxt: Vector<int> = Vector {}

    @en "arc_count"
    @fa "شمار کمان"
    pub func arc_count(): int: ret this.to.len() end

    @en "add_arc"
    @fa "افزودن کمان"
    pub func add_arc(u: int, v: int, c: f64): int:
        ret this.add_cost_arc(u, v, c, 0.0)
    end

    @en "add_cost_arc"
    @fa "افزودن کمان هزینه‌دار"
    pub func add_cost_arc(u: int, v: int, c: f64, k: f64): int:
        e := this.to.len()
        this._push(u, v, c, k)
        this._push(v, u, 0.0, 0.0 - k)
        ret e
    end

    @en "add_edge"
    @fa "افزودن یال"
    pub func add_edge(u: int, v: int, c: f64): int:
        e := this.to.len()
        this._push(u, v, c, 0.0)
        this._push(v, u, c, 0.0)
        ret e
    end

    pub func _push(u: int, v: int, c: f64, k: f64):
        this.to.push(v)
        this.cap.push(c)
        this.orig.push(c)
        this.cost.push(k)
        this.nxt.push(this.head.get(u))
        this.head.set(u, this.to.len() - 1)
    end

    @en "flow_on"
    @fa "شار روی"
    pub func flow_on(e: int): f64: ret this.orig.get(e) - this.cap.get(e) end

    @en "reset"
    @fa "بازنشانی"
    pub func reset():
        repeat this.cap.len() with e: this.cap.set(e, this.orig.get(e)) end
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.head.free()
        this.to.free()
        this.cap.free()
        this.cost.free()
        this.orig.free()
        this.nxt.free()
    end
end
