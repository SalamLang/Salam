package graph

// The residual network that flow algorithms run on.
//
// A graph is not enough for flow: every arc needs a mutable remaining
// capacity and a paired reverse arc that carries the flow already pushed, so
// that an augmentation can be undone later. Arcs live in one array with
// paired indices, which is why the reverse of arc e is always e xor 1 - no
// bookkeeping, one xor.
//
// Adjacency is a linked list per node (head/nxt) rather than the CSR index a
// Graph uses, because arcs are added incrementally and Dinic's current-arc
// optimisation wants a per-node cursor that advances through them and never
// looks back within a phase.

// minimum cut readable afterwards: the nodes still reachable from the source
// form one side, by the max-flow min-cut theorem. Call Reset to run a second
// flow on the same network.

@en "FlowNet"
@fa "شبکه شار"
@ar "شبكة التدفق"
pub struct FlowNet:
    pub n: int = 0
    pub head: Vector<int> = Vector {}
    pub to: Vector<int> = Vector {}
    pub cap: Vector<f64> = Vector {}
    pub cost: Vector<f64> = Vector {}
    pub orig: Vector<f64> = Vector {}
    pub nxt: Vector<int> = Vector {}

    @en "arc_count"
    @fa "شمار کمان"
    @ar "عدد الأقواس"
    pub func arc_count(): int: ret this.to.len() end

    // A directed arc u->v of capacity c, plus its zero-capacity reverse.
    @en "add_arc"
    @fa "افزودن کمان"
    @ar "إضافة قوس"
    pub func add_arc(u: int, v: int, c: f64): int:
        ret this.add_cost_arc(u, v, c, 0.0)
    end

    @en "add_cost_arc"
    @fa "افزودن کمان هزینه‌دار"
    @ar "إضافة قوس بتكلفة"
    pub func add_cost_arc(u: int, v: int, c: f64, k: f64): int:
        e := this.to.len()
        this._push(u, v, c, k)
        this._push(v, u, 0.0, 0.0 - k)
        ret e
    end

    // An undirected edge: capacity c available in either direction, which is
    // the pair of arcs each holding c rather than an arc and its zero reverse.
    @en "add_edge"
    @fa "افزودن یال"
    @ar "إضافة ضلع"
    pub func add_edge(u: int, v: int, c: f64): int:
        e := this.to.len()
        this._push(u, v, c, 0.0)
        this._push(v, u, c, 0.0)
        ret e
    end

    pub func _push(u: int, v: int, c: f64, k: f64):
        this.to.push(v)
        this.cap.push(c)
        this.orig.push(c)
        this.cost.push(k)
        this.nxt.push(this.head.get(u))
        this.head.set(u, this.to.len() - 1)
    end

    // The flow currently on arc e: how much of its original capacity is gone.
    @en "flow_on"
    @fa "شار روی"
    @ar "التدفق على"
    pub func flow_on(e: int): f64: ret this.orig.get(e) - this.cap.get(e) end

    @en "reset"
    @fa "بازنشانی"
    @ar "إعادة"
    pub func reset():
        repeat this.cap.len() with e: this.cap.set(e, this.orig.get(e)) end
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        this.head.free()
        this.to.free()
        this.cap.free()
        this.cost.free()
        this.orig.free()
        this.nxt.free()
    end
end
