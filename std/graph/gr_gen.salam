package graph

import rand

// Graph constructors: the named families that theorems are stated about, and
// the random models that real networks are compared against.
//
// The named ones are exact and deterministic, which makes them the natural
// test fixtures: K(n) has n(n-1)/2 edges and chromatic number n, C(n) is
// bipartite exactly when n is even, the Petersen graph has girth 5 and
// chromatic number 3, Q(d) is d-regular and bipartite.
//
// The random ones each fail to reproduce something real networks have, which
// is the point of having three:
//
//   ErdosRenyi      every pair independently: Poisson degrees, no clustering
//   BarabasiAlbert  rich get richer: a power law tail, still no clustering
//   WattsStrogatz   a rewired ring: high clustering and short paths, but
//                   degrees that are far too uniform
//
// They draw from the `rand` package, so seed it (rand.Seed) for a
// reproducible graph and rand.SeedAuto for a different one each run.

func _link_all(g &: Graph, a: int, b: int):
    mut i := a
    until i < b:
        mut j := i + 1
        until j < b:
            g.add_edge(i, j)
            j += 1
        end
        i += 1
    end
end

func _grid_index(r: int, c: int, cols: int): int: ret r * cols + c end

// The number of nodes a complete b-ary tree of the given depth has, which is
// what the balanced tree generator needs before it can allocate.
func _tree_size(branch: int, depth: int): int:
    mut total := 1
    mut level := 1
    repeat depth:
        level = level * branch
        total += level
    end
    ret total
end

func _hypercube_bit(u: int, b: int): int: ret u ^ (1 << b) end

// One preferential-attachment step: pick targets with probability
// proportional to degree by drawing uniformly from the list of edge
// endpoints, which is exactly a degree-weighted draw.
func _ba_targets(pool: Vector<int>, m: int, picked &: Vector<int>):
    picked.clear()
    mut guard := 0
    until picked.len() < m:
        if guard > 1000: break end
        guard += 1
        if pool.len() == 0: break end
        cand := pool.get(rand.IntN(pool.len() as i64) as int)
        if _already(picked, cand) == false: picked.push(cand) end
    end
end

func _already(v: Vector<int>, x: int): bool:
    repeat v.len() with i:
        if v.get(i) == x: ret true end
    end
    ret false
end

func _circ_link(g &: Graph, seen &: HashMap<i64, bool>, u: int, off: int, n: int):
    if off <= 0: ret end
    v := (u + off) % n
    if v == u: ret end
    mut lo := u
    mut hi := v
    if lo > hi:
        lo = v
        hi = u
    end
    key := (lo as i64) * (n as i64) + (hi as i64)
    if seen.has(key): ret end
    seen.put(key, true)
    g.add_edge(lo, hi)
end

func _random_edge(g &: Graph, seen &: HashMap<i64, bool>, n: int): bool:
    u := rand.IntN(n as i64) as int
    v := rand.IntN(n as i64) as int
    if u == v: ret false end
    mut lo := u
    mut hi := v
    if lo > hi:
        lo = v
        hi = u
    end
    key := (lo as i64) * (n as i64) + (hi as i64)
    if seen.has(key): ret false end
    seen.put(key, true)
    g.add_edge(lo, hi)
    ret true
end

func _seed_pool(g &: Graph, pool &: Vector<int>):
    repeat g.size() with e:
        pool.push(g.edge_from(e))
        pool.push(g.edge_to(e))
    end
end

func _ba_attach(g &: Graph, pool &: Vector<int>, picked: Vector<int>, v: int):
    repeat picked.len() with i:
        t := picked.get(i)
        g.add_edge(v, t)
        pool.push(v)
        pool.push(t)
    end
end

func _rewire(ring &: Graph, p: f64, n: int): Graph:
    mut g := New(n, false)
    mut seen := HashMap {} as HashMap<i64, bool>
    defer seen.free()
    repeat ring.size() with e:
        u := ring.edge_from(e)
        mut v := ring.edge_to(e)
        if rand.Float() < p: v = rand.IntN(n as i64) as int end
        if v != u: _circ_link(g, seen, u, (v - u + n) % n, n) end
    end
    ret g
end

@en "EmptyGraph"
@fa "گراف تهی"
@ar "بيان فارغ"
pub func EmptyGraph(n: int): Graph: ret New(n, false) end

// K(n): every pair joined. The densest simple graph, chromatic number n,
// n^(n-2) spanning trees.
@en "CompleteGraph"
@fa "گراف کامل"
@ar "بيان كامل"
pub func CompleteGraph(n: int): Graph:
    mut g := New(n, false)
    _link_all(g, 0, n)
    ret g
end

// K(a,b): every node of the first part joined to every node of the second,
// none within a part. Bipartite by construction.
@en "CompleteBipartite"
@fa "دوبخشی کامل"
@ar "ثنائي كامل"
pub func CompleteBipartite(a: int, b: int): Graph:
    mut g := New(a + b, false)
    repeat a with i:
        repeat b with j: g.add_edge(i, a + j) end
    end
    ret g
end

// P(n): a path. n-1 edges, a tree, diameter n-1.
@en "PathGraph"
@fa "گراف مسیر"
@ar "بيان مسار"
pub func PathGraph(n: int): Graph:
    mut g := New(n, false)
    mut i := 0
    until i < n - 1:
        g.add_edge(i, i + 1)
        i += 1
    end
    ret g
end

// C(n): a cycle. 2-regular, bipartite exactly when n is even.
@en "CycleGraph"
@fa "گراف دور"
@ar "بيان دورة"
pub func CycleGraph(n: int): Graph:
    mut g := PathGraph(n)
    if n > 2: g.add_edge(n - 1, 0) end
    ret g
end

// A star: one centre joined to n-1 leaves. The extreme case for degree and
// betweenness centrality.
@en "StarGraph"
@fa "گراف ستاره"
@ar "بيان نجمي"
pub func StarGraph(n: int): Graph:
    mut g := New(n, false)
    mut i := 1
    until i < n:
        g.add_edge(0, i)
        i += 1
    end
    ret g
end

// A wheel: a cycle plus a hub joined to all of it.
@en "WheelGraph"
@fa "گراف چرخ"
@ar "بيان العجلة"
pub func WheelGraph(n: int): Graph:
    if n < 4: ret CycleGraph(n) end
    mut g := New(n, false)
    mut i := 1
    until i < n - 1:
        g.add_edge(i, i + 1)
        i += 1
    end
    g.add_edge(n - 1, 1)
    mut j := 1
    until j < n:
        g.add_edge(0, j)
        j += 1
    end
    ret g
end

// A rows-by-cols lattice, nodes numbered row by row. Bipartite, and the
// standard test case for shortest paths and planarity.
@en "GridGraph"
@fa "گراف شبکه"
@ar "بيان شبكي"
pub func GridGraph(rows: int, cols: int): Graph:
    mut g := New(rows * cols, false)
    repeat rows with r:
        repeat cols with c:
            if c + 1 < cols: g.add_edge(_grid_index(r, c, cols), _grid_index(r, c + 1, cols)) end
            if r + 1 < rows: g.add_edge(_grid_index(r, c, cols), _grid_index(r + 1, c, cols)) end
        end
    end
    ret g
end

// Q(d): nodes are the d-bit numbers, joined when they differ in one bit.
// d-regular, bipartite, vertex-transitive, diameter d.
@en "HypercubeGraph"
@fa "گراف مکعبی"
@ar "بيان مكعبي"
pub func HypercubeGraph(d: int): Graph:
    n := 1 << d
    mut g := New(n, false)
    repeat n with u:
        repeat d with b:
            v := _hypercube_bit(u, b)
            if v > u: g.add_edge(u, v) end
        end
    end
    ret g
end

// The Petersen graph: 10 nodes, 3-regular, girth 5, chromatic number 3, not
// Hamiltonian, and the standard counterexample in graph theory.
@en "PetersenGraph"
@fa "گراف پترسن"
@ar "بيان بيترسن"
pub func PetersenGraph(): Graph:
    mut g := New(10, false)
    repeat 5 with i:
        g.add_edge(i, (i + 1) % 5)
        g.add_edge(i, i + 5)
        g.add_edge(5 + i, 5 + (i + 2) % 5)
    end
    ret g
end

// A circulant graph: node i joined to i +/- each offset, modulo n. Cycles,
// complete graphs and Moebius-Kantor style graphs are all special cases.
@en "CirculantGraph"
@fa "گراف دوری"
@ar "بيان دائري"
pub func CirculantGraph(n: int, offsets: Vector<int>): Graph:
    mut g := New(n, false)
    mut seen := HashMap {} as HashMap<i64, bool>
    defer seen.free()
    repeat n with u:
        repeat offsets.len() with k:
            _circ_link(g, seen, u, offsets.get(k), n)
        end
    end
    ret g
end

// A complete b-ary tree of the given depth, nodes in breadth-first order.
@en "BalancedTree"
@fa "درخت متوازن"
@ar "شجرة متوازنة"
pub func BalancedTree(branch: int, depth: int): Graph:
    n := _tree_size(branch, depth)
    mut g := New(n, false)
    mut i := 1
    until i < n:
        g.add_edge((i - 1) / branch, i)
        i += 1
    end
    ret g
end

// G(n,p): each of the n(n-1)/2 pairs present independently with probability
// p. Degrees are binomial, clustering is p, and a giant component appears
// abruptly at p = 1/n, which is the classic phase transition.
@en "ErdosRenyi"
@fa "اردوش-رنی"
@ar "إردوش-ريني"
pub func ErdosRenyi(n: int, p: f64): Graph:
    mut g := New(n, false)
    repeat n with u:
        mut v := u + 1
        until v < n:
            if rand.Float() < p: g.add_edge(u, v) end
            v += 1
        end
    end
    ret g
end

// G(n,m): exactly m edges, chosen uniformly at random without repetition.
@en "RandomGraph"
@fa "گراف تصادفی"
@ar "بيان عشوائي"
pub func RandomGraph(n: int, m: int): Graph:
    mut g := New(n, false)
    mut seen := HashMap {} as HashMap<i64, bool>
    defer seen.free()
    mut added := 0
    mut guard := 0
    until added < m:
        if guard > 100 * m + 1000: break end
        guard += 1
        if _random_edge(g, seen, n): added += 1 end
    end
    ret g
end

// A uniformly random labelled tree, drawn by generating a random Prufer
// sequence and decoding it. Uniform because the encoding is a bijection.
@en "RandomTree"
@fa "درخت تصادفی"
@ar "شجرة عشوائية"
pub func RandomTree(n: int): Graph:
    if n < 2: ret New(n, false) end
    mut code := Vector {} as Vector<int>
    defer code.free()
    repeat n - 2: code.push(rand.IntN(n as i64) as int) end
    ret PruferDecode(code)
end

// Barabasi-Albert preferential attachment: start with a small clique and add
// nodes that each attach to m existing nodes chosen in proportion to their
// degree. Produces the heavy-tailed degree distribution that real citation,
// web and protein networks show and that Erdos-Renyi cannot.
@en "BarabasiAlbert"
@fa "باراباشی-آلبرت"
@ar "باراباسي-ألبرت"
pub func BarabasiAlbert(n: int, m: int): Graph:
    if n <= m: ret CompleteGraph(n) end
    mut g := CompleteGraph(m + 1)
    mut pool := Vector {} as Vector<int>
    defer pool.free()
    _seed_pool(g, pool)
    mut picked := Vector {} as Vector<int>
    defer picked.free()
    mut v := m + 1
    until v < n:
        _ba_targets(pool, m, picked)
        _ba_attach(g, pool, picked, v)
        v += 1
    end
    ret g
end

// Watts-Strogatz: a ring where each node is joined to its k nearest
// neighbours, then every edge is rewired with probability p. Small p keeps
// the ring's high clustering while the few long-range edges collapse the
// diameter, which is the small-world effect.
@en "WattsStrogatz"
@fa "واتس-استروگاتز"
@ar "واتس-ستروغاتز"
pub func WattsStrogatz(n: int, k: int, p: f64): Graph:
    mut ring := New(n, false)
    half := k / 2
    repeat n with u:
        mut d := 1
        until d <= half:
            ring.add_edge(u, (u + d) % n)
            d += 1
        end
    end
    g := _rewire(ring, p, n)
    ring.free()
    ret g
end

