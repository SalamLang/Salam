package graph

// Isomorphism, automorphisms, and degree sequences.
//
// Graph isomorphism sits in its own complexity class: no polynomial
// algorithm is known and it is not known to be NP-complete either. What
// works in practice is cheap invariants first, backtracking second, which is
// what Isomorphic does. It rejects most non-isomorphic pairs on the degree
// sequence or the triangle count alone, without ever searching.
//
// Degree sequences are the other half. Erdos-Gallai decides whether a
// sequence of numbers can be the degree sequence of any simple graph, and
// Havel-Hakimi builds one when it can, which is how you get a graph with
// prescribed degrees without rejection sampling.

func _iso_invariants_match(a &: Graph, b &: Graph): bool:
    if a.n != b.n: ret false end
    if a.size() != b.size(): ret false end
    mut da := DegreeSequence(a)
    defer da.free()
    mut db := DegreeSequence(b)
    defer db.free()
    repeat da.len() with i:
        if da.get(i) != db.get(i): ret false end
    end
    ret TriangleCount(a) == TriangleCount(b)
end

func _iso_adj(g &: Graph): HashMap<i64, bool>:
    mut s := HashMap {} as HashMap<i64, bool>
    repeat g.size() with e:
        u := g.edge_from(e)
        v := g.edge_to(e)
        s.put((u as i64) * (g.n as i64) + (v as i64), true)
        s.put((v as i64) * (g.n as i64) + (u as i64), true)
    end
    ret s
end

func _linked(adj &: HashMap<i64, bool>, n: int, u: int, v: int): bool:
    ret adj.has((u as i64) * (n as i64) + (v as i64))
end

// Extend a partial mapping by one node. Candidate images must have the same
// degree and must agree with every edge and non-edge already decided, so a
// wrong guess dies at the next node rather than at the end.
func _iso_extend(a &: Graph, b &: Graph, adja &: HashMap<i64, bool>, adjb &: HashMap<i64, bool>, map &: Vector<int>, used &: Vector<bool>, u: int): bool:
    if u >= a.n: ret true end
    repeat b.n with v:
        if used.get(v) == false:
            if a.degree(u) == b.degree(v):
                if _iso_consistent(a, b, adja, adjb, map, u, v):
                    map.set(u, v)
                    used.set(v, true)
                    if _iso_extend(a, b, adja, adjb, map, used, u + 1): ret true end
                    map.set(u, GRAPH_NONE)
                    used.set(v, false)
                end
            end
        end
    end
    ret false
end

func _iso_consistent(a &: Graph, b &: Graph, adja &: HashMap<i64, bool>, adjb &: HashMap<i64, bool>, map: Vector<int>, u: int, v: int): bool:
    repeat u with w:
        img := map.get(w)
        if _linked(adja, a.n, u, w) != _linked(adjb, b.n, v, img): ret false end
    end
    ret true
end

func _count_maps(g &: Graph, adj &: HashMap<i64, bool>, map &: Vector<int>, used &: Vector<bool>, u: int): int:
    if u >= g.n: ret 1 end
    mut total := 0
    repeat g.n with v:
        if used.get(v) == false:
            if g.degree(u) == g.degree(v):
                if _iso_consistent(g, g, adj, adj, map, u, v):
                    map.set(u, v)
                    used.set(v, true)
                    total += _count_maps(g, adj, map, used, u + 1)
                    map.set(u, GRAPH_NONE)
                    used.set(v, false)
                end
            end
        end
    end
    ret total
end

func _sorted_copy(seq: Vector<int>): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat seq.len() with i: out.push(seq.get(i)) end
    mut i := 1
    until i < out.len():
        x := out.get(i)
        mut j := i - 1
        until j >= 0:
            if out.get(j) >= x: break end
            out.set(j + 1, out.get(j))
            j = j - 1
        end
        out.set(j + 1, x)
        i += 1
    end
    ret out
end

func _erdos_gallai(d: Vector<int>, n: int): bool:
    mut k := 1
    until k <= n:
        mut lhs := 0
        repeat k with i: lhs += d.get(i) end
        mut rhs := k * (k - 1)
        mut j := k
        until j < n:
            mut t := d.get(j)
            if t > k: t = k end
            rhs += t
            j += 1
        end
        if lhs > rhs: ret false end
        k += 1
    end
    ret true
end

func _largest_left(left: Vector<int>, n: int): int:
    mut best := GRAPH_NONE
    repeat n with i:
        if left.get(i) > 0:
            if best == GRAPH_NONE: best = i
            else left.get(i) > left.get(best): best = i
            end
        end
    end
    ret best
end

func _hh_connect(g &: Graph, left &: Vector<int>, u: int, n: int):
    need := left.get(u)
    left.set(u, 0)
    repeat need:
        v := _largest_left(left, n)
        if v == GRAPH_NONE: ret end
        g.add_edge(u, v)
        left.set(v, left.get(v) - 1)
    end
end

// Whether two graphs are isomorphic: same structure under some relabelling.
// Cheap invariants reject most negatives immediately; what survives goes to
// a degree-pruned backtracking search.
@en "Isomorphic"
@fa "یکریخت"
@ar "متماثل"
pub func Isomorphic(a &: Graph, b &: Graph): bool:
    if _iso_invariants_match(a, b) == false: ret false end
    if a.n == 0: ret true end
    mut adja := _iso_adj(a)
    defer adja.free()
    mut adjb := _iso_adj(b)
    defer adjb.free()
    mut map := Vector {} as Vector<int>
    defer map.free()
    mut used := Vector {} as Vector<bool>
    defer used.free()
    FillInt(map, a.n, GRAPH_NONE)
    FillBool(used, b.n, false)
    ret _iso_extend(a, b, adja, adjb, map, used, 0)
end

// The isomorphism itself, as a node mapping from a to b, or an empty vector
// when there is none.
@en "IsomorphismMap"
@fa "نگاشت یکریختی"
@ar "خريطة التماثل"
pub func IsomorphismMap(a &: Graph, b &: Graph, map &: Vector<int>): bool:
    FillInt(map, a.n, GRAPH_NONE)
    if _iso_invariants_match(a, b) == false: ret false end
    mut adja := _iso_adj(a)
    defer adja.free()
    mut adjb := _iso_adj(b)
    defer adjb.free()
    mut used := Vector {} as Vector<bool>
    defer used.free()
    FillBool(used, b.n, false)
    ret _iso_extend(a, b, adja, adjb, map, used, 0)
end

// The size of the automorphism group: the number of ways the graph maps onto
// itself. 1 means the graph is asymmetric, n! means it is complete or empty.
@en "AutomorphismCount"
@fa "شمار خودریختی"
@ar "عدد التماثلات الذاتية"
pub func AutomorphismCount(g &: Graph): int:
    if g.n == 0: ret 1 end
    mut adj := _iso_adj(g)
    defer adj.free()
    mut map := Vector {} as Vector<int>
    defer map.free()
    mut used := Vector {} as Vector<bool>
    defer used.free()
    FillInt(map, g.n, GRAPH_NONE)
    FillBool(used, g.n, false)
    ret _count_maps(g, adj, map, used, 0)
end

// Erdos-Gallai: a non-increasing sequence is the degree sequence of some
// simple graph exactly when its sum is even and, for every k, the first k
// degrees do not exceed what k nodes can absorb among themselves plus what
// the rest can offer.
@en "IsGraphical"
@fa "گرافیک است"
@ar "قابل للتمثيل"
pub func IsGraphical(seq: Vector<int>): bool:
    mut d := _sorted_copy(seq)
    defer d.free()
    n := d.len()
    mut total := 0
    repeat n with i:
        if d.get(i) < 0: ret false end
        if d.get(i) > n - 1: ret false end
        total += d.get(i)
    end
    if total % 2 == 1: ret false end
    ret _erdos_gallai(d, n)
end

// Havel-Hakimi: repeatedly take the largest remaining degree and join it to
// the next largest ones. It succeeds exactly when the sequence is graphical,
// so it doubles as a constructive proof of Erdos-Gallai.
@en "HavelHakimi"
@fa "هاول-حکیمی"
@ar "هافل-حكيمي"
pub func HavelHakimi(seq: Vector<int>): Graph:
    n := seq.len()
    mut g := New(n, false)
    if IsGraphical(seq) == false: ret g end
    mut left := Vector {} as Vector<int>
    defer left.free()
    repeat n with i: left.push(seq.get(i)) end
    repeat n:
        u := _largest_left(left, n)
        if u == GRAPH_NONE: break end
        _hh_connect(g, left, u, n)
    end
    ret g
end

// Whether two graphs have the same degree sequence: necessary for
// isomorphism, nowhere near sufficient, and the cheapest useful filter.
@en "SameDegreeSequence"
@fa "دنباله درجه یکسان"
@ar "نفس متتالية الدرجات"
pub func SameDegreeSequence(a &: Graph, b &: Graph): bool:
    if a.n != b.n: ret false end
    mut da := DegreeSequence(a)
    defer da.free()
    mut db := DegreeSequence(b)
    defer db.free()
    repeat da.len() with i:
        if da.get(i) != db.get(i): ret false end
    end
    ret true
end

