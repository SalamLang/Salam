package graph

import math

@en "Matrix"
@fa "ماتریس"
pub struct Matrix:
    @en "rows"
    @fa "سطرها"
    pub rows: int = 0
    @en "cols"
    @fa "ستون‌ها"
    pub cols: int = 0
    @en "a"
    @fa "درایه‌ها"
    pub a: Vector<f64> = Vector {}

    @en "at"
    @fa "عنصر"
    pub func At(i: int, j: int): f64: ret this.a.get(i * this.cols + j) end

    pub func at(i: int, j: int): f64: ret this.At(i, j) end

    @en "set"
    @fa "تنظیم"
    pub func Set(i: int, j: int, v: f64): this.a.set(i * this.cols + j, v) end

    pub func set(i: int, j: int, v: f64): this.Set(i, j, v) end

    @en "add_at"
    @fa "افزودن در"
    pub func AddAt(i: int, j: int, v: f64):
        this.a.set(i * this.cols + j, this.a.get(i * this.cols + j) + v)
    end

    pub func add_at(i: int, j: int, v: f64): this.AddAt(i, j, v) end

    @en "trace"
    @fa "رد"
    pub func Trace(): f64:
        mut s := 0.0
        mut n := this.rows
        if this.cols < n: n = this.cols end
        repeat n in i: s += this.At(i, i) end
        ret s
    end

    pub func trace(): f64: ret this.Trace() end

    @en "row_sum"
    @fa "مجموع سطر"
    pub func RowSum(i: int): f64:
        mut s := 0.0
        repeat this.cols in j: s += this.At(i, j) end
        ret s
    end

    pub func row_sum(i: int): f64: ret this.RowSum(i) end

    @en "free"
    @fa "آزادسازی"
    pub func Free(): this.a.free() end

    pub func free(): this.Free() end
end

@en "IntMatrix"
@fa "ماتریس صحیح"
pub struct IntMatrix:
    @en "rows"
    @fa "سطرها"
    pub rows: int = 0
    @en "cols"
    @fa "ستون‌ها"
    pub cols: int = 0
    @en "a"
    @fa "درایه‌ها"
    pub a: Vector<int> = Vector {}

    @en "at"
    @fa "عنصر"
    pub func At(i: int, j: int): int: ret this.a.get(i * this.cols + j) end

    pub func at(i: int, j: int): int: ret this.At(i, j) end

    @en "set"
    @fa "تنظیم"
    pub func Set(i: int, j: int, v: int): this.a.set(i * this.cols + j, v) end

    pub func set(i: int, j: int, v: int): this.Set(i, j, v) end

    @en "free"
    @fa "آزادسازی"
    pub func Free(): this.a.free() end

    pub func free(): this.Free() end
end

func _matrix_copy(x &: Matrix): Matrix:
    mut r := NewMatrix(x.rows, x.cols)
    repeat x.rows * x.cols in i: r.a.set(i, x.a.get(i)) end
    ret r
end

func _fill_weights(g &: Graph, m &: Matrix):
    repeat g.Size() in e:
        u := g.EdgeFrom(e)
        v := g.EdgeTo(e)
        w := g.EdgeWeight(e)
        if w < m.At(u, v): m.Set(u, v, w) end
        if g.directed == false:
            if w < m.At(v, u): m.Set(v, u, w) end
        end
    end
end

func _fill_normalized(g &: Graph, a &: Matrix, m &: Matrix):
    repeat g.n in i:
        di := g.Degree(i) as f64
        repeat g.n in j:
            dj := g.Degree(j) as f64
            if di > 0.0:
                if i == j: m.Set(i, j, 1.0)
                else dj > 0.0: m.Set(i, j, (0.0 - a.At(i, j)) / math.Sqrt(di * dj))
                end
            end
        end
    end
end

func _pivot(m &: Matrix, c: int, n: int): int:
    mut best := GRAPH_NONE
    mut bv := 0.000000001
    mut r := c
    until r < n:
        v := math.Abs(m.At(r, c))
        if v > bv:
            bv = v
            best = r
        end
        r++
    end
    ret best
end

func _swap_rows(m &: Matrix, i: int, j: int, n: int):
    repeat n in c:
        t := m.At(i, c)
        m.Set(i, c, m.At(j, c))
        m.Set(j, c, t)
    end
end

func _eliminate(m &: Matrix, c: int, n: int):
    mut r := c + 1
    until r < n:
        f := m.At(r, c) / m.At(c, c)
        if f != 0.0:
            mut j := c
            until j < n:
                m.Set(r, j, m.At(r, j) - f * m.At(c, j))
                j++
            end
        end
        r++
    end
end

func _off_diagonal(m &: Matrix, n: int): f64:
    mut s := 0.0
    repeat n in i:
        repeat n in j:
            if i != j: s += m.At(i, j) * m.At(i, j) end
        end
    end
    ret s
end

func _jacobi_rotate(m &: Matrix, n: int, p: int, q: int):
    apq := m.At(p, q)
    if math.Abs(apq) < 1.0e-290: ret end
    theta := (m.At(q, q) - m.At(p, p)) / (2.0 * apq)
    mut t := 1.0 / (math.Abs(theta) + math.Sqrt(theta * theta + 1.0))
    if theta < 0.0: t = 0.0 - t end
    c := 1.0 / math.Sqrt(t * t + 1.0)
    s := t * c
    _apply_rotation(m, n, p, q, c, s)
end

func _apply_rotation(m &: Matrix, n: int, p: int, q: int, c: f64, s: f64):
    repeat n in k:
        akp := m.At(k, p)
        akq := m.At(k, q)
        m.Set(k, p, c * akp - s * akq)
        m.Set(k, q, s * akp + c * akq)
    end
    repeat n in k:
        apk := m.At(p, k)
        aqk := m.At(q, k)
        m.Set(p, k, c * apk - s * aqk)
        m.Set(q, k, s * apk + c * aqk)
    end
end

func _jacobi_sweep(m &: Matrix, n: int):
    mut p := 0
    until p < n - 1:
        mut q := p + 1
        until q < n:
            _jacobi_rotate(m, n, p, q)
            q++
        end
        p++
    end
end

func _sort_floats(v &: Vector<f64>):
    mut i := 1
    until i < v.Len():
        x := v.get(i)
        mut j := i - 1
        until j >= 0:
            if v.get(j) <= x: break end
            v.set(j + 1, v.get(j))
            j--
        end
        v.set(j + 1, x)
        i++
    end
end

@en "NewMatrix"
@fa "ماتریس جدید"
pub func NewMatrix(rows: int, cols: int): Matrix:
    mut m := Matrix {}
    m.rows = rows
    m.cols = cols
    FillFloat(m.a, rows * cols, 0.0)
    ret m
end

@en "NewIntMatrix"
@fa "ماتریس صحیح جدید"
pub func NewIntMatrix(rows: int, cols: int, fill: int): IntMatrix:
    mut m := IntMatrix {}
    m.rows = rows
    m.cols = cols
    FillInt(m.a, rows * cols, fill)
    ret m
end

@en "AdjacencyMatrix"
@fa "ماتریس مجاورت"
pub func AdjacencyMatrix(g &: Graph): Matrix:
    mut m := NewMatrix(g.n, g.n)
    repeat g.Size() in e:
        u := g.EdgeFrom(e)
        v := g.EdgeTo(e)
        m.AddAt(u, v, 1.0)
        if g.directed == false:
            m.AddAt(v, u, 1.0)
        end
    end
    ret m
end

@en "WeightMatrix"
@fa "ماتریس وزن"
pub func WeightMatrix(g &: Graph): Matrix:
    mut m := NewMatrix(g.n, g.n)
    repeat g.n in i:
        repeat g.n in j:
            if i == j: m.Set(i, j, 0.0)
            else:
                m.Set(i, j, GRAPH_INF)
            end
        end
    end
    _fill_weights(g, m)
    ret m
end

@en "DegreeMatrix"
@fa "ماتریس درجه"
pub func DegreeMatrix(g &: Graph): Matrix:
    mut m := NewMatrix(g.n, g.n)
    repeat g.n in u: m.Set(u, u, g.Degree(u) as f64) end
    ret m
end

@en "LaplacianMatrix"
@fa "ماتریس لاپلاس"
pub func LaplacianMatrix(g &: Graph): Matrix:
    mut a := AdjacencyMatrix(g)
    mut m := NewMatrix(g.n, g.n)
    repeat g.n in i:
        repeat g.n in j:
            if i == j: m.Set(i, j, a.RowSum(i) - a.At(i, i))
            else:
                m.Set(i, j, 0.0 - a.At(i, j))
            end
        end
    end
    defer a.Free()
    ret m
end

@en "NormalizedLaplacian"
@fa "لاپلاس بهنجار"
pub func NormalizedLaplacian(g &: Graph): Matrix:
    mut a := AdjacencyMatrix(g)
    mut m := NewMatrix(g.n, g.n)
    _fill_normalized(g, a, m)
    defer a.Free()
    ret m
end

@en "IncidenceMatrix"
@fa "ماتریس وقوع"
pub func IncidenceMatrix(g &: Graph): Matrix:
    m := g.Size()
    mut r := NewMatrix(g.n, m)
    repeat m in e:
        u := g.EdgeFrom(e)
        v := g.EdgeTo(e)
        if g.directed:
            r.AddAt(u, e, 0.0 - 1.0)
            r.AddAt(v, e, 1.0)
        else:
            r.AddAt(u, e, 1.0)
            r.AddAt(v, e, 1.0)
        end
    end
    ret r
end

@en "MatrixMultiply"
@fa "ضرب ماتریس"
pub func MatrixMultiply(x &: Matrix, y &: Matrix): Matrix:
    mut r := NewMatrix(x.rows, y.cols)
    repeat x.rows in i:
        repeat x.cols in k:
            v := x.At(i, k)
            if v != 0.0:
                repeat y.cols in j: r.AddAt(i, j, v * y.At(k, j)) end
            end
        end
    end
    ret r
end

@en "MatrixIdentity"
@fa "ماتریس همانی"
pub func MatrixIdentity(n: int): Matrix:
    mut r := NewMatrix(n, n)
    repeat n in i: r.Set(i, i, 1.0) end
    ret r
end

@en "MatrixPower"
@fa "توان ماتریس"
pub func MatrixPower(x &: Matrix, k: int): Matrix:
    mut result := MatrixIdentity(x.rows)
    mut base := _matrix_copy(x)
    mut e := k
    until e > 0:
        if e % 2 == 1:
            t := MatrixMultiply(result, base)
            result.Free()
            result = t
        end
        e /= 2
        if e > 0:
            s := MatrixMultiply(base, base)
            base.Free()
            base = s
        end
    end
    defer base.Free()
    ret result
end

@en "WalkCount"
@fa "شمار گشت"
pub func WalkCount(g &: Graph, k: int, u: int, v: int): f64:
    mut a := AdjacencyMatrix(g)
    mut p := MatrixPower(a, k)
    r := p.At(u, v)
    defer p.Free()
    defer a.Free()
    ret r
end
