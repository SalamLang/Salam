package graph

func _sorted_edges(g &: Graph, order &: Vector<int>, sign: f64):
    mut h := MinHeap { }
    repeat g.size() with e: h.push(sign * g.edge_weight(e), e) end
    order.clear()
    until h.is_empty() == false: order.push(h.pop()) end
    defer h.free()
end

func _kruskal_run(g &: Graph, chosen &: Vector<int>, sign: f64): f64:
    mut order := Vector {} as Vector<int>
    defer order.free()
    _sorted_edges(g, order, sign)
    mut ds := NewDisjointSet(g.n)
    defer ds.free()
    chosen.clear()
    mut total := 0.0
    repeat order.len() with i:
        e := order.get(i)
        if ds.union(g.edge_from(e), g.edge_to(e)):
            chosen.push(e)
            total += g.edge_weight(e)
        end
    end
    ret total
end

func _prim_scan(g &: Graph, u: int, inside &: Vector<bool>, best &: Vector<f64>, parent &: Vector<int>, h &: MinHeap):
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        w := g.adj_weight(k)
        if inside.get(v) == false:
            if w < best.get(v):
                best.set(v, w)
                parent.set(v, u)
                h.push(w, v)
            end
        end
        k += 1
    end
end

func _prim_run(g &: Graph, root: int, parent &: Vector<int>): f64:
    mut inside := Vector {} as Vector<bool>
    defer inside.free()
    mut best := Vector {} as Vector<f64>
    defer best.free()
    FillBool(inside, g.n, false)
    FillFloat(best, g.n, GRAPH_INF)
    FillInt(parent, g.n, GRAPH_NONE)
    if g.n == 0: ret 0.0 end
    mut h := MinHeap { }
    defer h.free()
    mut total := 0.0
    best.set(root, 0.0)
    h.push(0.0, root)
    until h.is_empty() == false:
        u := h.pop()
        if inside.get(u) == false:
            inside.set(u, true)
            total += best.get(u)
            _prim_scan(g, u, inside, best, parent, h)
        end
    end
    ret total
end

func _boruvka_round(g &: Graph, ds &: DisjointSet, pick &: Vector<int>):
    FillInt(pick, g.n, GRAPH_NONE)
    repeat g.size() with e:
        a := ds.find(g.edge_from(e))
        b := ds.find(g.edge_to(e))
        if a != b:
            _boruvka_offer(g, pick, a, e)
            _boruvka_offer(g, pick, b, e)
        end
    end
end

func _boruvka_offer(g &: Graph, pick &: Vector<int>, comp: int, e: int):
    cur := pick.get(comp)
    if cur == GRAPH_NONE:
        pick.set(comp, e)
        ret
    end
    if g.edge_weight(e) < g.edge_weight(cur):
        pick.set(comp, e)
        ret
    end
    if g.edge_weight(e) == g.edge_weight(cur):
        if e < cur: pick.set(comp, e) end
    end
end

@en "Kruskal"
@fa "کروسکال"
@ar "كروسكال"
pub func Kruskal(g &: Graph, chosen &: Vector<int>): f64:
    ret _kruskal_run(g, chosen, 1.0)
end

@en "MaximumSpanningTree"
@fa "درخت پوشای بیشینه"
@ar "شجرة ممتدة عظمى"
pub func MaximumSpanningTree(g &: Graph, chosen &: Vector<int>): f64:
    ret _kruskal_run(g, chosen, 0.0 - 1.0)
end

@en "Prim"
@fa "پریم"
@ar "بريم"
pub func Prim(g &: Graph, root: int, parent &: Vector<int>): f64:
    if g.directed == false: ret _prim_run(g, root, parent) end
    mut u := ToUndirected(g)
    t := _prim_run(u, root, parent)
    defer u.free()
    ret t
end

@en "Boruvka"
@fa "بوروفکا"
@ar "بوروفكا"
pub func Boruvka(g &: Graph, chosen &: Vector<int>): f64:
    chosen.clear()
    mut ds := NewDisjointSet(g.n)
    defer ds.free()
    mut pick := Vector {} as Vector<int>
    defer pick.free()
    mut total := 0.0
    mut progress := true
    until progress:
        progress = false
        _boruvka_round(g, ds, pick)
        repeat g.n with c:
            e := pick.get(c)
            if e != GRAPH_NONE:
                if ds.union(g.edge_from(e), g.edge_to(e)):
                    chosen.push(e)
                    total += g.edge_weight(e)
                    progress = true
                end
            end
        end
    end
    ret total
end

@en "MSTWeight"
@fa "وزن درخت پوشا"
@ar "وزن الشجرة الممتدة"
pub func MSTWeight(g &: Graph): f64:
    mut chosen := Vector {} as Vector<int>
    defer chosen.free()
    ret Kruskal(g, chosen)
end

@en "MinimumSpanningTree"
@fa "درخت پوشای کمینه"
@ar "شجرة ممتدة صغرى"
pub func MinimumSpanningTree(g &: Graph): Graph:
    mut chosen := Vector {} as Vector<int>
    defer chosen.free()
    Kruskal(g, chosen)
    mut h := New(g.n, false)
    repeat chosen.len() with i:
        e := chosen.get(i)
        h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
    end
    ret h
end

@en "SpanningAgreement"
@fa "توافق پوشا"
@ar "توافق الامتداد"
pub func SpanningAgreement(g &: Graph): bool:
    mut a := Vector {} as Vector<int>
    defer a.free()
    mut b := Vector {} as Vector<int>
    defer b.free()
    mut p := Vector {} as Vector<int>
    defer p.free()
    ka := Kruskal(g, a)
    kb := Boruvka(g, b)
    if IsClose(ka, kb) == false: ret false end
    if IsConnected(g) == false: ret true end
    pr := Prim(g, 0, p)
    ret IsClose(ka, pr)
end
