package graph

import str

func _key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end

func _kept(keep: Vector<bool>, i: int): bool:
    if i >= keep.Len(): ret false end
    ret keep.Get(i)
end

func _copy_names(src &: Graph, dst &: Graph, shift: int):
    repeat src.names.Len() in u:
        s := src.name(u)
        if str.Len(s) > 0: dst.SetName(u + shift, s) end
    end
end

func _append_edges(src &: Graph, dst &: Graph, shift: int):
    repeat src.Size() in e:
        dst.AddWeighted(src.EdgeFrom(e) + shift, src.EdgeTo(e) + shift, src.EdgeWeight(e))
    end
end

func _fill_sub(g &: Graph, h &: Graph, map: Vector<int>):
    repeat g.Size() in e:
        a := map.Get(g.EdgeFrom(e))
        b := map.Get(g.EdgeTo(e))
        if a != GRAPH_NONE:
            if b != GRAPH_NONE: h.AddWeighted(a, b, g.EdgeWeight(e)) end
        end
    end
end

func _fill_complement(g &: Graph, h &: Graph, seen &: HashMap<i64, bool>):
    repeat g.n in u:
        repeat g.n in v:
            if u != v:
                if seen.Has(_key(g.n, u, v)) == false:
                    if g.directed: h.AddEdge(u, v)
                    else v > u: h.AddEdge(u, v)
                    end
                end
            end
        end
    end
end

func _link_incident(g &: Graph, h &: Graph, seen &: HashMap<i64, bool>, u: int, m: int):
    start := g.AdjStart(u)
    stop := g.AdjStop(u)
    mut i := start
    until i < stop:
        mut j := i + 1
        until j < stop:
            a := g.AdjEdge(i)
            b := g.AdjEdge(j)
            if a != b:
                mut lo := a
                mut hi := b
                if lo > hi:
                    lo = b
                    hi = a
                end
                k := _key(m, lo, hi)
                if seen.Has(k) == false:
                    seen.Put(k, true)
                    h.AddEdge(lo, hi)
                end
            end
            j++
        end
        i++
    end
end

func _collect_best(g &: Graph, best &: HashMap<i64, f64>, order &: Vector<i64>):
    repeat g.Size() in e:
        u := g.EdgeFrom(e)
        v := g.EdgeTo(e)
        if u != v:
            mut a := u
            mut b := v
            if g.directed == false:
                if a > b:
                    a = v
                    b = u
                end
            end
            k := _key(g.n, a, b)
            w := g.EdgeWeight(e)
            if best.Has(k):
                if w < best.Get(k): best.Put(k, w) end
            else:
                best.Put(k, w)
                order.Push(k)
            end
        end
    end
end

@en "Clone"
@fa "همانندسازی"
pub func Clone(g &: Graph): Graph:
    mut h := New(g.n, g.directed)
    m := g.Size()
    repeat m in e:
        h.AddWeighted(g.EdgeFrom(e), g.EdgeTo(e), g.EdgeWeight(e))
    end
    _copy_names(g, h, 0)
    ret h
end

@en "Transpose"
@fa "ترانهاده"
pub func Transpose(g &: Graph): Graph:
    mut h := New(g.n, g.directed)
    m := g.Size()
    repeat m in e:
        h.AddWeighted(g.EdgeTo(e), g.EdgeFrom(e), g.EdgeWeight(e))
    end
    _copy_names(g, h, 0)
    ret h
end

@en "Reverse"
@fa "برعکس"
pub func Reverse(g &: Graph): Graph: ret Transpose(g) end

@en "ToUndirected"
@fa "به بی‌جهت"
pub func ToUndirected(g &: Graph): Graph:
    mut h := New(g.n, false)
    m := g.Size()
    repeat m in e:
        h.AddWeighted(g.EdgeFrom(e), g.EdgeTo(e), g.EdgeWeight(e))
    end
    _copy_names(g, h, 0)
    ret h
end

@en "ToDirected"
@fa "به جهت‌دار"
pub func ToDirected(g &: Graph): Graph:
    mut h := New(g.n, true)
    m := g.Size()
    repeat m in e:
        u := g.EdgeFrom(e)
        v := g.EdgeTo(e)
        w := g.EdgeWeight(e)
        h.AddWeighted(u, v, w)
        if u != v: h.AddWeighted(v, u, w) end
    end
    _copy_names(g, h, 0)
    ret h
end

@en "SubgraphMap"
@fa "زیرگراف با نگاشت"
pub func SubgraphMap(g &: Graph, keep: Vector<bool>, map &: Vector<int>): Graph:
    map.Clear()
    mut k := 0
    repeat g.n in u:
        if _kept(keep, u):
            map.Push(k)
            k++
        else:
            map.Push(GRAPH_NONE)
        end
    end
    mut h := New(k, g.directed)
    _fill_sub(g, h, map)
    repeat g.n in u:
        if map.Get(u) != GRAPH_NONE: h.SetName(map.Get(u), g.name(u)) end
    end
    ret h
end

@en "Subgraph"
@fa "زیرگراف"
pub func Subgraph(g &: Graph, keep: Vector<bool>): Graph:
    mut map := Vector {} as Vector<int>
    defer map.Free()
    ret SubgraphMap(g, keep, map)
end

@en "EdgeSubgraph"
@fa "زیرگراف یالی"
pub func EdgeSubgraph(g &: Graph, keep: Vector<bool>): Graph:
    mut h := New(g.n, g.directed)
    m := g.Size()
    repeat m in e:
        if _kept(keep, e): h.AddWeighted(g.EdgeFrom(e), g.EdgeTo(e), g.EdgeWeight(e)) end
    end
    _copy_names(g, h, 0)
    ret h
end

@en "Complement"
@fa "مکمل"
pub func Complement(g &: Graph): Graph:
    mut h := New(g.n, g.directed)
    mut seen := HashMap {} as HashMap<i64, bool>
    defer seen.Free()
    m := g.Size()
    repeat m in e:
        seen.Put(_key(g.n, g.EdgeFrom(e), g.EdgeTo(e)), true)
        if g.directed == false: seen.Put(_key(g.n, g.EdgeTo(e), g.EdgeFrom(e)), true) end
    end
    _fill_complement(g, h, seen)
    _copy_names(g, h, 0)
    ret h
end

@en "Union"
@fa "اجتماع"
pub func Union(a &: Graph, b &: Graph): Graph:
    mut n := a.n
    if b.n > n: n = b.n end
    mut h := New(n, a.directed)
    _append_edges(a, h, 0)
    _append_edges(b, h, 0)
    _copy_names(a, h, 0)
    ret h
end

@en "DisjointUnion"
@fa "اجتماع مجزا"
pub func DisjointUnion(a &: Graph, b &: Graph): Graph:
    mut h := New(a.n + b.n, a.directed)
    _append_edges(a, h, 0)
    _append_edges(b, h, a.n)
    _copy_names(a, h, 0)
    _copy_names(b, h, a.n)
    ret h
end

@en "Intersection"
@fa "اشتراک"
pub func Intersection(a &: Graph, b &: Graph): Graph:
    mut n := a.n
    if b.n > n: n = b.n end
    mut h := New(n, a.directed)
    mut seen := HashMap {} as HashMap<i64, bool>
    defer seen.Free()
    m := a.Size()
    repeat m in e:
        u := a.EdgeFrom(e)
        v := a.EdgeTo(e)
        k := _key(n, u, v)
        if seen.Has(k) == false:
            if b.HasEdge(u, v):
                seen.Put(k, true)
                h.AddWeighted(u, v, a.EdgeWeight(e))
            end
        end
    end
    ret h
end

@en "LineGraph"
@fa "گراف یالی"
pub func LineGraph(g &: Graph): Graph:
    m := g.Size()
    mut h := New(m, false)
    mut seen := HashMap {} as HashMap<i64, bool>
    defer seen.Free()
    repeat g.n in u:
        _link_incident(g, h, seen, u, m)
    end
    ret h
end

@en "Simplify"
@fa "ساده‌سازی"
pub func Simplify(g &: Graph): Graph:
    mut h := New(g.n, g.directed)
    mut best := HashMap {} as HashMap<i64, f64>
    defer best.Free()
    mut order := Vector {} as Vector<i64>
    defer order.Free()
    _collect_best(g, best, order)
    repeat order.Len() in i:
        k := order.Get(i)
        h.AddWeighted((k / (g.n as i64)) as int, (k % (g.n as i64)) as int, best.Get(k))
    end
    _copy_names(g, h, 0)
    ret h
end

@en "RemoveSelfLoops"
@fa "حذف طوقه‌ها"
pub func RemoveSelfLoops(g &: Graph): Graph:
    mut h := New(g.n, g.directed)
    m := g.Size()
    repeat m in e:
        if g.EdgeFrom(e) != g.EdgeTo(e):
            h.AddWeighted(g.EdgeFrom(e), g.EdgeTo(e), g.EdgeWeight(e))
        end
    end
    _copy_names(g, h, 0)
    ret h
end

@en "SelfLoopCount"
@fa "شمار طوقه"
pub func SelfLoopCount(g &: Graph): int:
    mut c := 0
    repeat g.Size() in e:
        if g.EdgeFrom(e) == g.EdgeTo(e): c++ end
    end
    ret c
end

@en "HasSelfLoop"
@fa "دارای طوقه"
pub func HasSelfLoop(g &: Graph): bool: ret SelfLoopCount(g) > 0 end

@en "ParallelEdgeCount"
@fa "شمار یال موازی"
pub func ParallelEdgeCount(g &: Graph): int:
    mut seen := HashMap {} as HashMap<i64, bool>
    defer seen.Free()
    mut c := 0
    repeat g.Size() in e:
        u := g.EdgeFrom(e)
        v := g.EdgeTo(e)
        k := _key(g.n, u, v)
        if seen.Has(k): c++
        else:
            seen.Put(k, true)
        end
        if g.directed == false: seen.Put(_key(g.n, v, u), true) end
    end
    ret c
end

@en "IsSimple"
@fa "ساده است"
pub func IsSimple(g &: Graph): bool:
    if HasSelfLoop(g): ret false end
    ret ParallelEdgeCount(g) == 0
end

@en "TotalWeight"
@fa "وزن کل"
pub func TotalWeight(g &: Graph): f64:
    mut s := 0.0
    repeat g.Size() in e: s += g.EdgeWeight(e) end
    ret s
end
