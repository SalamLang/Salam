package graph

func _visit_out(g &: Graph, u: int, id: int, comp &: Vector<int>, q &: Vector<int>):
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        if comp.Get(v) == GRAPH_NONE:
            comp.Set(v, id)
            q.Push(v)
        end
        k++
    end
end

func _visit_in(g &: Graph, u: int, id: int, comp &: Vector<int>, q &: Vector<int>):
    mut k := g.in_start(u)
    stop := g.in_stop(u)
    until k < stop:
        v := g.in_node(k)
        if comp.Get(v) == GRAPH_NONE:
            comp.Set(v, id)
            q.Push(v)
        end
        k++
    end
end

func _comp_bfs(g &: Graph, s: int, id: int, comp &: Vector<int>):
    mut q := Vector {} as Vector<int>
    defer q.Free()
    q.Push(s)
    comp.Set(s, id)
    mut head := 0
    until head < q.Len():
        u := q.Get(head)
        head++
        _visit_out(g, u, id, comp, q)
        if g.directed: _visit_in(g, u, id, comp, q) end
    end
end

func _dfs_walk(g &: Graph, src: int, pre &: Vector<int>, post &: Vector<int>, seen &: Vector<bool>):
    if seen.Get(src): ret end
    mut stack := Vector {} as Vector<int>
    defer stack.Free()
    mut it := Vector {} as Vector<int>
    defer it.Free()
    seen.Set(src, true)
    pre.Push(src)
    stack.Push(src)
    it.Push(g.adj_start(src))
    until stack.Len() > 0:
        u := stack.Last()
        k := it.Last()
        if k < g.adj_stop(u):
            it.Set(it.Len() - 1, k + 1)
            v := g.adj_node(k)
            if seen.Get(v) == false:
                seen.Set(v, true)
                pre.Push(v)
                stack.Push(v)
                it.Push(g.adj_start(v))
            end
        else:
            post.Push(u)
            stack.Pop()
            it.Pop()
        end
    end
end

func _color_bfs(g &: Graph, s: int, color &: Vector<int>): bool:
    mut q := Vector {} as Vector<int>
    defer q.Free()
    mut ok := true
    color.Set(s, 0)
    q.Push(s)
    mut head := 0
    until head < q.Len():
        u := q.Get(head)
        head++
        if _color_step(g, u, color, q) == false: ok = false end
    end
    ret ok
end

func _color_step(g &: Graph, u: int, color &: Vector<int>, q &: Vector<int>): bool:
    mut ok := true
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        if color.Get(v) == GRAPH_NONE:
            color.Set(v, 1 - color.Get(u))
            q.Push(v)
        else color.Get(v) == color.Get(u):
            ok = false
        end
        k++
    end
    ret ok
end

func _stack_index(stack: Vector<int>, v: int): int:
    mut i := stack.Len() - 1
    until i >= 0:
        if stack.Get(i) == v: ret i end
        i--
    end
    ret GRAPH_NONE
end

func _cycle_from(stack: Vector<int>, at: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    mut i := at
    until i < stack.Len():
        out.Push(stack.Get(i))
        i++
    end
    ret out
end

func _find_cycle_from(g &: Graph, src: int, state &: Vector<int>, out &: Vector<int>): bool:
    mut stack := Vector {} as Vector<int>
    defer stack.Free()
    mut it := Vector {} as Vector<int>
    defer it.Free()
    mut via := Vector {} as Vector<int>
    defer via.Free()
    state.Set(src, 1)
    stack.Push(src)
    it.Push(g.adj_start(src))
    via.Push(GRAPH_NONE)
    until stack.Len() > 0:
        u := stack.Last()
        k := it.Last()
        if k >= g.adj_stop(u):
            state.Set(u, 2)
            stack.Pop()
            it.Pop()
            via.Pop()
            continue
        end
        it.Set(it.Len() - 1, k + 1)
        e := g.adj_edge(k)
        v := g.adj_node(k)
        if g.directed == false:
            if e == via.Last(): continue end
        end
        if state.Get(v) == 1:
            at := _stack_index(stack, v)
            mut c := _cycle_from(stack, at)
            repeat c.Len() in i: out.Push(c.Get(i)) end
            c.Free()
            ret true
        end
        if state.Get(v) == 0:
            state.Set(v, 1)
            stack.Push(v)
            it.Push(g.adj_start(v))
            via.Push(e)
        end
    end
    ret false
end

func _relax_indegree(g &: Graph, u: int, deg &: Vector<int>, q &: Vector<int>):
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        deg.Set(v, deg.Get(v) - 1)
        if deg.Get(v) == 0: q.Push(v) end
        k++
    end
end

func _relax_indegree_heap(g &: Graph, u: int, deg &: Vector<int>, h &: MinHeap):
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        deg.Set(v, deg.Get(v) - 1)
        if deg.Get(v) == 0: h.Push(v as f64, v) end
        k++
    end
end

func _bipartite_all(g &: Graph, color &: Vector<int>, n: int): bool:
    mut ok := true
    repeat n in s:
        if color.Get(s) == GRAPH_NONE:
            if _color_bfs(g, s, color) == false: ok = false end
        end
    end
    ret ok
end

func _indegrees(g &: Graph, deg &: Vector<int>):
    FillInt(deg, g.n, 0)
    repeat g.Size() in e:
        v := g.edge_to(e)
        deg.Set(v, deg.Get(v) + 1)
    end
end

@en "BFSFrom"
@fa "پیمایش سطحی از"
pub func BFSFrom(g &: Graph, src: int, dist &: Vector<int>, parent &: Vector<int>):
    FillInt(dist, g.n, GRAPH_NONE)
    FillInt(parent, g.n, GRAPH_NONE)
    if src < 0: ret end
    if src >= g.n: ret end
    mut q := Vector {} as Vector<int>
    defer q.Free()
    dist.Set(src, 0)
    q.Push(src)
    mut head := 0
    until head < q.Len():
        u := q.Get(head)
        head++
        mut k := g.adj_start(u)
        stop := g.adj_stop(u)
        until k < stop:
            v := g.adj_node(k)
            if dist.Get(v) == GRAPH_NONE:
                dist.Set(v, dist.Get(u) + 1)
                parent.Set(v, u)
                q.Push(v)
            end
            k++
        end
    end
end

@en "BFS"
@fa "پیمایش سطحی"
pub func BFS(g &: Graph, src: int): Vector<int>:
    mut dist := Vector {} as Vector<int>
    mut parent := Vector {} as Vector<int>
    defer parent.Free()
    BFSFrom(g, src, dist, parent)
    ret dist
end

@en "BFSOrder"
@fa "ترتیب سطحی"
pub func BFSOrder(g &: Graph, src: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    if src < 0: ret out end
    if src >= g.n: ret out end
    mut seen := Vector {} as Vector<bool>
    defer seen.Free()
    FillBool(seen, g.n, false)
    seen.Set(src, true)
    out.Push(src)
    mut head := 0
    until head < out.Len():
        u := out.Get(head)
        head++
        mut k := g.adj_start(u)
        stop := g.adj_stop(u)
        until k < stop:
            v := g.adj_node(k)
            if seen.Get(v) == false:
                seen.Set(v, true)
                out.Push(v)
            end
            k++
        end
    end
    ret out
end

@en "DFSOrder"
@fa "ترتیب عمقی"
pub func DFSOrder(g &: Graph, src: int): Vector<int>:
    mut pre := Vector {} as Vector<int>
    mut post := Vector {} as Vector<int>
    defer post.Free()
    mut seen := Vector {} as Vector<bool>
    defer seen.Free()
    FillBool(seen, g.n, false)
    _dfs_walk(g, src, pre, post, seen)
    ret pre
end

@en "DFSPostOrder"
@fa "ترتیب پسین عمقی"
pub func DFSPostOrder(g &: Graph, src: int): Vector<int>:
    mut pre := Vector {} as Vector<int>
    defer pre.Free()
    mut post := Vector {} as Vector<int>
    mut seen := Vector {} as Vector<bool>
    defer seen.Free()
    FillBool(seen, g.n, false)
    _dfs_walk(g, src, pre, post, seen)
    ret post
end

@en "DFSForest"
@fa "جنگل عمقی"
pub func DFSForest(g &: Graph): Vector<int>:
    mut pre := Vector {} as Vector<int>
    mut post := Vector {} as Vector<int>
    defer post.Free()
    mut seen := Vector {} as Vector<bool>
    defer seen.Free()
    FillBool(seen, g.n, false)
    repeat g.n in u: _dfs_walk(g, u, pre, post, seen) end
    ret pre
end

@en "Reachable"
@fa "دست‌یافتنی"
pub func Reachable(g &: Graph, src: int): Vector<bool>:
    mut dist := Vector {} as Vector<int>
    defer dist.Free()
    mut parent := Vector {} as Vector<int>
    defer parent.Free()
    BFSFrom(g, src, dist, parent)
    mut out := Vector {} as Vector<bool>
    repeat g.n in u: out.Push(dist.Get(u) != GRAPH_NONE) end
    ret out
end

@en "ReachableCount"
@fa "شمار دست‌یافتنی"
pub func ReachableCount(g &: Graph, src: int): int:
    mut r := Reachable(g, src)
    defer r.Free()
    mut c := 0
    repeat r.Len() in u:
        if r.Get(u): c++ end
    end
    ret c
end

@en "HopDistance"
@fa "فاصله گامی"
pub func HopDistance(g &: Graph, s: int, t: int): int:
    mut d := BFS(g, s)
    defer d.Free()
    if t < 0: ret GRAPH_NONE end
    if t >= g.n: ret GRAPH_NONE end
    ret d.Get(t)
end

@en "PathFromParents"
@fa "مسیر از والدها"
pub func PathFromParents(parent: Vector<int>, s: int, t: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    if t < 0: ret out end
    if t >= parent.Len(): ret out end
    if t != s:
        if parent.Get(t) == GRAPH_NONE: ret out end
    end
    mut c := t
    until c != GRAPH_NONE:
        out.Push(c)
        if c == s: break end
        c = parent.Get(c)
    end
    ReverseInt(out)
    ret out
end

@en "HopPath"
@fa "مسیر گامی"
pub func HopPath(g &: Graph, s: int, t: int): Vector<int>:
    mut dist := Vector {} as Vector<int>
    defer dist.Free()
    mut parent := Vector {} as Vector<int>
    defer parent.Free()
    BFSFrom(g, s, dist, parent)
    ret PathFromParents(parent, s, t)
end
