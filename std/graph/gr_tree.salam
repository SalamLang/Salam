package graph

import math
import str
import conv

func _tree_far(g &: Graph, s: int, dist &: Vector<int>, parent &: Vector<int>): int:
    BFSFrom(g, s, dist, parent)
    mut best := s
    repeat g.n in u:
        if dist.Get(u) != GRAPH_NONE:
            if dist.Get(u) > dist.Get(best): best = u end
        end
    end
    ret best
end

func _lift_levels(n: int): int:
    mut k := 1
    mut span := 1
    until span < n:
        span *= 2
        k++
    end
    ret k
end

func _peel_leaves(g &: Graph, alive &: Vector<bool>, deg &: Vector<int>, left: int): Vector<int>:
    mut remaining := left
    mut layer := Vector {} as Vector<int>
    repeat g.n in u:
        if alive.Get(u):
            if deg.Get(u) <= 1: layer.Push(u) end
        end
    end
    until remaining > 2:
        remaining -= layer.Len()
        mut nxt := Vector {} as Vector<int>
        _peel_step(g, alive, deg, layer, nxt)
        layer.Free()
        layer = nxt
    end
    ret layer
end

func _peel_step(g &: Graph, alive &: Vector<bool>, deg &: Vector<int>, layer: Vector<int>, nxt &: Vector<int>):
    repeat layer.Len() in i:
        u := layer.Get(i)
        alive.Set(u, false)
        mut k := g.adj_start(u)
        stop := g.adj_stop(u)
        until k < stop:
            v := g.adj_node(k)
            if alive.Get(v):
                deg.Set(v, deg.Get(v) - 1)
                if deg.Get(v) == 1: nxt.Push(v) end
            end
            k++
        end
    end
end

func _ahu_name(g &: Graph, u: int, parent: int): str:
    mut parts := Vector {} as Vector<str>
    defer parts.Free()
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        if v != parent: parts.Push(_ahu_name(g, v, u)) end
        k++
    end
    _sort_strings(parts)
    mut out := "("
    repeat parts.Len() in i: out += parts.Get(i) end
    ret out + ")"
end

func _sort_strings(v &: Vector<str>):
    mut i := 1
    until i < v.Len():
        x := v.Get(i)
        mut j := i - 1
        until j >= 0:
            if str.Compare(v.Get(j), x) <= 0: break end
            v.Set(j + 1, v.Get(j))
            j--
        end
        v.Set(j + 1, x)
        i++
    end
end

func _canonical_rooted(g &: Graph): str:
    mut c := TreeCenter(g)
    defer c.Free()
    if c.Len() == 0: ret "" end
    a := _ahu_name(g, c.Get(0), GRAPH_NONE)
    if c.Len() == 1: ret a end
    b := _ahu_name(g, c.Get(1), GRAPH_NONE)
    if str.Compare(a, b) <= 0: ret a + b end
    ret b + a
end

func _render(g &: Graph, u: int, parent: int): str:
    mut out := conv.FormatInt(u as i64)
    mut kids := Vector {} as Vector<str>
    defer kids.Free()
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        if v != parent: kids.Push(_render(g, v, u)) end
        k++
    end
    if kids.Len() == 0: ret out end
    out += "("
    repeat kids.Len() in i:
        if i > 0: out += " " end
        out += kids.Get(i)
    end
    ret out + ")"
end

func _is_centroid(g &: Graph, u: int, size: Vector<int>, parent: Vector<int>): bool:
    half := g.n / 2
    mut biggest := g.n - size.Get(u)
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        if parent.Get(v) == u:
            if size.Get(v) > biggest: biggest = size.Get(v) end
        end
        k++
    end
    ret biggest <= half
end

func _lca_depths(g &: Graph, root: int, parent: Vector<int>, order: Vector<int>, ix &: LCAIndex):
    FillInt(ix.depth, g.n, 0)
    repeat order.Len() in i:
        u := order.Get(i)
        p := parent.Get(u)
        if p != GRAPH_NONE: ix.depth.Set(u, ix.depth.Get(p) + 1) end
    end
    ix.depth.Set(root, 0)
end

func _lca_table(parent: Vector<int>, ix &: LCAIndex):
    n := ix.n
    FillInt(ix.up, ix.levels * n, GRAPH_NONE)
    repeat n in v:
        p := parent.Get(v)
        if p == GRAPH_NONE: ix.up.Set(v, v)
        else:
            ix.up.Set(v, p)
        end
    end
    mut k := 1
    until k < ix.levels:
        repeat n in v:
            mid := ix.up.Get((k - 1) * n + v)
            ix.up.Set(k * n + v, ix.up.Get((k - 1) * n + mid))
        end
        k++
    end
end

func _lift_to(ix &: LCAIndex, u0: int, want: int): int:
    mut u := u0
    mut k := ix.levels - 1
    until k >= 0:
        if ix.depth.Get(ix.ancestor(k, u)) >= want: u = ix.ancestor(k, u) end
        k--
    end
    ret u
end

func _lowest_leaf(deg: Vector<int>, alive: Vector<bool>, n: int): int:
    repeat n in u:
        if alive.Get(u):
            if deg.Get(u) == 1: ret u end
        end
    end
    ret GRAPH_NONE
end

func _only_neighbor(g &: Graph, u: int, alive: Vector<bool>): int:
    mut k := g.adj_start(u)
    stop := g.adj_stop(u)
    until k < stop:
        v := g.adj_node(k)
        if alive.Get(v): ret v end
        k++
    end
    ret GRAPH_NONE
end

func _prufer_build(g &: Graph, code: Vector<int>, deg &: Vector<int>, n: int):
    mut h := MinHeap {}
    defer h.Free()
    repeat n in u:
        if deg.Get(u) == 1: h.Push(u as f64, u) end
    end
    repeat code.Len() in i:
        p := code.Get(i)
        leaf := h.Pop()
        g.add_edge(leaf, p)
        deg.Set(p, deg.Get(p) - 1)
        if deg.Get(p) == 1: h.Push(p as f64, p) end
    end
    a := h.Pop()
    b := h.Pop()
    g.add_edge(a, b)
end

@en "IsTree"
@fa "درخت است"
pub func IsTree(g &: Graph): bool:
    if g.n == 0: ret false end
    mut s := Simplify(g)
    ok := s.Size() == g.n - 1
    defer s.Free()
    if ok == false: ret false end
    if HasSelfLoop(g): ret false end
    ret IsConnected(g)
end

@en "IsForest"
@fa "جنگل است"
pub func IsForest(g &: Graph): bool:
    if HasSelfLoop(g): ret false end
    mut s := Simplify(g)
    ok := s.Size() == g.n - ComponentCount(g)
    defer s.Free()
    ret ok
end

@en "RootTree"
@fa "ریشه‌دار کردن"
pub func RootTree(g &: Graph, root: int, parent &: Vector<int>, order &: Vector<int>):
    mut dist := Vector {} as Vector<int>
    defer dist.Free()
    BFSFrom(g, root, dist, parent)
    order.Clear()
    mut best := 0
    repeat g.n in u:
        if dist.Get(u) != GRAPH_NONE:
            if dist.Get(u) > best: best = dist.Get(u) end
        end
    end
    mut d := 0
    until d <= best:
        repeat g.n in u:
            if dist.Get(u) == d: order.Push(u) end
        end
        d++
    end
end

@en "SubtreeSizes"
@fa "اندازه زیردرخت‌ها"
pub func SubtreeSizes(g &: Graph, root: int): Vector<int>:
    mut parent := Vector {} as Vector<int>
    defer parent.Free()
    mut order := Vector {} as Vector<int>
    defer order.Free()
    RootTree(g, root, parent, order)
    mut size := Vector {} as Vector<int>
    FillInt(size, g.n, 1)
    mut i := order.Len() - 1
    until i >= 0:
        u := order.Get(i)
        p := parent.Get(u)
        if p != GRAPH_NONE: size.Set(p, size.Get(p) + size.Get(u)) end
        i--
    end
    ret size
end

@en "TreeDiameter"
@fa "قطر درخت"
pub func TreeDiameter(g &: Graph, ends &: Vector<int>): int:
    ends.Clear()
    if g.n == 0: ret GRAPH_NONE end
    mut dist := Vector {} as Vector<int>
    defer dist.Free()
    mut parent := Vector {} as Vector<int>
    defer parent.Free()
    a := _tree_far(g, 0, dist, parent)
    b := _tree_far(g, a, dist, parent)
    ends.Push(a)
    ends.Push(b)
    ret dist.Get(b)
end

@en "TreeCenter"
@fa "مرکز درخت"
pub func TreeCenter(g &: Graph): Vector<int>:
    mut out := Vector {} as Vector<int>
    if g.n == 0: ret out end
    if g.n <= 2:
        repeat g.n in u: out.Push(u) end
        ret out
    end
    mut alive := Vector {} as Vector<bool>
    defer alive.Free()
    mut deg := Vector {} as Vector<int>
    defer deg.Free()
    FillBool(alive, g.n, true)
    FillInt(deg, g.n, 0)
    repeat g.n in u: deg.Set(u, g.degree(u)) end
    defer out.Free()
    ret _peel_leaves(g, alive, deg, g.n)
end

@en "TreeCentroid"
@fa "مرکز ثقل درخت"
pub func TreeCentroid(g &: Graph): Vector<int>:
    mut out := Vector {} as Vector<int>
    if g.n == 0: ret out end
    mut size := SubtreeSizes(g, 0)
    defer size.Free()
    mut parent := Vector {} as Vector<int>
    defer parent.Free()
    mut order := Vector {} as Vector<int>
    defer order.Free()
    RootTree(g, 0, parent, order)
    repeat g.n in u:
        if _is_centroid(g, u, size, parent): out.Push(u) end
    end
    ret out
end
