package graph
import math
import str
import conv

@en "LCAIndex"
@fa "نمایه نیای مشترک"
pub struct LCAIndex:
    pub n: int = 0
    pub levels: int = 0
    pub depth: Vector<int> = Vector {}
    pub up: Vector<int> = Vector {}

    @en "ancestor"
    @fa "نیا"
    pub func ancestor(k: int, v: int): int: ret this.up.get(k * this.n + v) end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.depth.free()
        this.up.free()
    end
end

@en "BuildLCA"
@fa "ساخت نیای مشترک"
pub func BuildLCA(g &: Graph, root: int): LCAIndex:
    mut ix := LCAIndex { }
    ix.n = g.n
    ix.levels = _lift_levels(g.n)
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    mut order := Vector {} as Vector<int>
    defer order.free()
    RootTree(g, root, parent, order)
    _lca_depths(g, root, parent, order, ix)
    _lca_table(parent, ix)
    ret ix
end

@en "LCA"
@fa "نیای مشترک"
pub func LCA(ix &: LCAIndex, u0: int, v0: int): int:
    mut u := u0
    mut v := v0
    if ix.depth.get(u) < ix.depth.get(v):
        t := u
        u = v
        v = t
    end
    u = _lift_to(ix, u, ix.depth.get(v))
    if u == v: ret u end
    mut k := ix.levels - 1
    until k >= 0:
        if ix.ancestor(k, u) != ix.ancestor(k, v):
            u = ix.ancestor(k, u)
            v = ix.ancestor(k, v)
        end
        k = k - 1
    end
    ret ix.ancestor(0, u)
end

@en "TreeDistance"
@fa "فاصله درختی"
pub func TreeDistance(ix &: LCAIndex, u: int, v: int): int:
    a := LCA(ix, u, v)
    if a == GRAPH_NONE: ret GRAPH_NONE end
    ret ix.depth.get(u) + ix.depth.get(v) - 2 * ix.depth.get(a)
end

@en "PruferEncode"
@fa "کد پروفر"
pub func PruferEncode(g &: Graph): Vector<int>:
    mut code := Vector {} as Vector<int>
    if g.n < 2: ret code end
    mut deg := Vector {} as Vector<int>
    defer deg.free()
    mut alive := Vector {} as Vector<bool>
    defer alive.free()
    FillInt(deg, g.n, 0)
    FillBool(alive, g.n, true)
    repeat g.n with u: deg.set(u, g.degree(u)) end
    repeat g.n - 2:
        leaf := _lowest_leaf(deg, alive, g.n)
        p := _only_neighbor(g, leaf, alive)
        code.push(p)
        alive.set(leaf, false)
        deg.set(p, deg.get(p) - 1)
    end
    ret code
end

@en "PruferDecode"
@fa "کدگشایی پروفر"
pub func PruferDecode(code: Vector<int>): Graph:
    n := code.len() + 2
    mut g := New(n, false)
    mut deg := Vector {} as Vector<int>
    defer deg.free()
    FillInt(deg, n, 1)
    repeat code.len() with i:
        p := code.get(i)
        deg.set(p, deg.get(p) + 1)
    end
    _prufer_build(g, code, deg, n)
    ret g
end

@en "TreeIsomorphic"
@fa "درخت‌های یکریخت"
pub func TreeIsomorphic(a &: Graph, b &: Graph): bool:
    if a.n != b.n: ret false end
    if IsTree(a) == false: ret false end
    if IsTree(b) == false: ret false end
    ca := _canonical_rooted(a)
    cb := _canonical_rooted(b)
    ret str.Equals(ca, cb)
end

@en "TreeCanonicalForm"
@fa "شکل متعارف درخت"
pub func TreeCanonicalForm(g &: Graph): str:
    if IsTree(g) == false: ret "" end
    ret _canonical_rooted(g)
end

@en "LabeledTreeCount"
@fa "شمار درخت برچسب‌دار"
pub func LabeledTreeCount(n: int): f64:
    if n < 1: ret 0.0 end
    if n < 3: ret 1.0 end
    ret math.Pow(n as f64, (n - 2) as f64)
end

@en "TreeToString"
@fa "درخت به رشته"
pub func TreeToString(g &: Graph, root: int): str:
    if g.n == 0: ret "" end
    ret _render(g, root, GRAPH_NONE)
end
