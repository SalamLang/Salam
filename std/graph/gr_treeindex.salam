package graph

@en "TreeIndex"
@fa "نمایه درخت"
pub struct TreeIndex:
    @en "n"
    @fa "شمار گره‌ها"
    pub n: int = 0
    @en "depth"
    @fa "عمق"
    pub depth: Vector<int> = Vector {}
    @en "log"
    @fa "لگاریتم"
    pub log: int = 0
    @en "up"
    @fa "بالا"
    pub up: Vector<int> = Vector {}
    @en "tin"
    @fa "ورود"
    pub tin: Vector<int> = Vector {}
    @en "tout"
    @fa "خروج"
    pub tout: Vector<int> = Vector {}

    @en "ancestor"
    @fa "جد"
    pub func Ancestor(k: int, v: int): int: ret this.up.get(k * this.n + v) end

    pub func ancestor(k: int, v: int): int: ret this.Ancestor(k, v) end

    @en "free"
    @fa "آزادسازی"
    pub func Free():
        this.depth.Free()
        this.up.Free()
        this.tin.Free()
        this.tout.Free()
    end

    pub func free(): this.Free() end
end
