package graph

@en "MinHeap"
@fa "هرم کمینه"
pub struct MinHeap:
    @en "key"
    @fa "کلیدها"
    pub key: Vector<f64> = Vector {}
    @en "val"
    @fa "مقدارها"
    pub val: Vector<int> = Vector {}

    func _swap(i: int, j: int):
        ka := this.key.get(i)
        kb := this.key.get(j)
        this.key.set(i, kb)
        this.key.set(j, ka)
        va := this.val.get(i)
        vb := this.val.get(j)
        this.val.set(i, vb)
        this.val.set(j, va)
    end

    @en "push"
    @fa "افزودن"
    pub func Push(k: f64, v: int):
        this.key.push(k)
        this.val.push(v)
        mut i := this.key.Len() - 1
        until i > 0:
            p := (i - 1) / 2
            if this.key.get(p) <= this.key.get(i): break end
            this._swap(i, p)
            i = p
        end
    end

    pub func push(k: f64, v: int): this.Push(k, v) end

    @en "size"
    @fa "اندازه"
    pub func Size(): int: ret this.val.Len() end

    pub func size(): int: ret this.Size() end

    @en "is_empty"
    @fa "تهی است"
    pub func IsEmpty(): bool: ret this.val.Len() == 0 end

    pub func is_empty(): bool: ret this.IsEmpty() end

    @en "top_key"
    @fa "کلید بالا"
    pub func TopKey(): f64: ret this.key.get(0) end

    pub func top_key(): f64: ret this.TopKey() end

    @en "top_value"
    @fa "مقدار بالا"
    pub func TopValue(): int: ret this.val.get(0) end

    pub func top_value(): int: ret this.TopValue() end

    @en "pop"
    @fa "برداشتن"
    pub func Pop(): int:
        top := this.val.get(0)
        last := this.val.Len() - 1
        this.key.set(0, this.key.get(last))
        this.val.set(0, this.val.get(last))
        this.key.pop()
        this.val.pop()
        this._sift(0)
        ret top
    end

    pub func pop(): int: ret this.Pop() end

    func _sift(from: int):
        n := this.val.Len()
        mut i := from
        until true:
            l := 2 * i + 1
            if l >= n: break end
            mut s := l
            r := l + 1
            if r < n:
                if this.key.get(r) < this.key.get(l): s = r end
            end
            if this.key.get(i) <= this.key.get(s): break end
            this._swap(i, s)
            i = s
        end
    end

    @en "clear"
    @fa "پاکسازی"
    pub func Clear():
        this.key.clear()
        this.val.clear()
    end

    pub func clear(): this.Clear() end

    @en "free"
    @fa "آزادسازی"
    pub func Free():
        this.key.Free()
        this.val.Free()
    end

    pub func free(): this.Free() end
end

@en "DisjointSet"
@fa "مجموعه‌های مجزا"
pub struct DisjointSet:
    @en "parent"
    @fa "والدها"
    pub parent: Vector<int> = Vector {}
    @en "sz"
    @fa "اندازه‌ها"
    pub sz: Vector<int> = Vector {}
    @en "groups"
    @fa "شمار مجموعه‌ها"
    pub groups: int = 0

    @en "reset"
    @fa "بازنشانی"
    pub func Reset(n: int):
        this.parent.clear()
        this.sz.clear()
        repeat n in i:
            this.parent.push(i)
            this.sz.push(1)
        end
        this.groups = n
    end

    pub func reset(n: int): this.Reset(n) end

    @en "find"
    @fa "یافتن"
    pub func Find(x: int): int:
        mut r := x
        until this.parent.get(r) != r: r = this.parent.get(r) end
        mut c := x
        until this.parent.get(c) != c:
            nx := this.parent.get(c)
            this.parent.set(c, r)
            c = nx
        end
        ret r
    end

    pub func find(x: int): int: ret this.Find(x) end

    @en "union"
    @fa "یکی‌سازی"
    pub func Union(a: int, b: int): bool:
        mut ra := this.Find(a)
        mut rb := this.Find(b)
        if ra == rb: ret false end
        if this.sz.get(ra) < this.sz.get(rb):
            t := ra
            ra = rb
            rb = t
        end
        this.parent.set(rb, ra)
        this.sz.set(ra, this.sz.get(ra) + this.sz.get(rb))
        this.groups--
        ret true
    end

    pub func union(a: int, b: int): bool: ret this.Union(a, b) end

    @en "connected"
    @fa "متصل"
    pub func Connected(a: int, b: int): bool: ret this.Find(a) == this.Find(b) end

    pub func connected(a: int, b: int): bool: ret this.Connected(a, b) end

    @en "set_size"
    @fa "اندازه مجموعه"
    pub func SetSize(a: int): int: ret this.sz.get(this.Find(a)) end

    pub func set_size(a: int): int: ret this.SetSize(a) end

    @en "count"
    @fa "شمار"
    pub func Count(): int: ret this.groups end

    pub func count(): int: ret this.Count() end

    @en "free"
    @fa "آزادسازی"
    pub func Free():
        this.parent.Free()
        this.sz.Free()
    end

    pub func free(): this.Free() end
end

@en "NewDisjointSet"
@fa "مجموعه مجزا جدید"
pub func NewDisjointSet(n: int): DisjointSet:
    mut d := DisjointSet {}
    d.Reset(n)
    ret d
end

@en "FillInt"
@fa "پرکردن صحیح"
pub func FillInt(v &: Vector<int>, n: int, x: int):
    v.clear()
    repeat n: v.push(x) end
end

@en "FillFloat"
@fa "پرکردن اعشاری"
pub func FillFloat(v &: Vector<f64>, n: int, x: f64):
    v.clear()
    repeat n: v.push(x) end
end

@en "FillBool"
@fa "پرکردن منطقی"
pub func FillBool(v &: Vector<bool>, n: int, x: bool):
    v.clear()
    repeat n: v.push(x) end
end

@en "Iota"
@fa "دنباله"
pub func Iota(v &: Vector<int>, n: int):
    v.clear()
    repeat n in i: v.push(i) end
end

@en "MaxInt"
@fa "بیشینه صحیح"
pub func MaxInt(v: Vector<int>): int:
    if v.Len() == 0: ret 0 end
    mut b := v.get(0)
    repeat v.Len() in i:
        if v.get(i) > b: b = v.get(i) end
    end
    ret b
end

@en "SumInt"
@fa "مجموع صحیح"
pub func SumInt(v: Vector<int>): int:
    mut s := 0
    repeat v.Len() in i: s += v.get(i) end
    ret s
end

@en "SumFloat"
@fa "مجموع اعشاری"
pub func SumFloat(v: Vector<f64>): f64:
    mut s := 0.0
    repeat v.Len() in i: s += v.get(i) end
    ret s
end

@en "ReverseInt"
@fa "وارونه‌سازی"
pub func ReverseInt(v &: Vector<int>):
    mut i := 0
    mut j := v.Len() - 1
    until i < j:
        a := v.get(i)
        b := v.get(j)
        v.set(i, b)
        v.set(j, a)
        i++
        j--
    end
end
