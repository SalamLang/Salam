@en "graph"
@fa "گراف"
package graph

const _GRAPH_EPS := 0.000000000001

@en "GRAPH_INF"
@fa "بی‌نهایت گراف"
pub const GRAPH_INF := 1.0e300

@en "GRAPH_NONE"
@fa "هیچ"
pub const GRAPH_NONE := -1

@en "Graph"
@fa "گراف"
pub struct Graph:
    @en "directed"
    @fa "جهت‌دار"
    pub directed: bool = false
    @en "n"
    @fa "شمار گره‌ها"
    pub n: int = 0
    @en "eu"
    @fa "آغاز یال‌ها"
    pub eu: Vector<int> = Vector {}
    @en "ev"
    @fa "انتهای یال‌ها"
    pub ev: Vector<int> = Vector {}
    @en "ew"
    @fa "وزن یال‌ها"
    pub ew: Vector<f64> = Vector {}
    @en "names"
    @fa "نام گره‌ها"
    pub names: Vector<str> = Vector {}
    @en "off"
    @fa "آغاز مجاورت‌ها"
    pub off: Vector<int> = Vector {}
    @en "nbr"
    @fa "گره‌های مجاور"
    pub nbr: Vector<int> = Vector {}
    @en "eix"
    @fa "یال‌های مجاور"
    pub eix: Vector<int> = Vector {}
    @en "roff"
    @fa "آغاز ورودی‌ها"
    pub roff: Vector<int> = Vector {}
    @en "rnbr"
    @fa "گره‌های‌ورودی"
    pub rnbr: Vector<int> = Vector {}
    @en "reix"
    @fa "یال‌های‌ورودی"
    pub reix: Vector<int> = Vector {}
    @en "built"
    @fa "ساخته شده"
    pub built: bool = false

    @en "add_node"
    @fa "افزودن گره"
    pub func AddNode(): int:
        id := this.n
        this.n++
        this.built = false
        ret id
    end

    pub func add_node(): int: ret this.AddNode() end

    @en "add_nodes"
    @fa "افزودن گره‌ها"
    pub func AddNodes(k: int):
        if k <= 0: ret end
        this.n += k
        this.built = false
    end

    pub func add_nodes(k: int): this.AddNodes(k) end

    @en "add_edge"
    @fa "افزودن یال"
    pub func AddEdge(u: int, v: int): int:
        ret this.AddWeighted(u, v, 1.0)
    end

    pub func add_edge(u: int, v: int): int: ret this.AddEdge(u, v) end

    @en "add_weighted"
    @fa "افزودن یال وزن‌دار"
    pub func AddWeighted(u: int, v: int, w: f64): int:
        if u < 0: ret GRAPH_NONE end
        if v < 0: ret GRAPH_NONE end
        if u >= this.n: this.n = u + 1 end
        if v >= this.n: this.n = v + 1 end
        this.eu.Push(u)
        this.ev.Push(v)
        this.ew.Push(w)
        this.built = false
        ret this.eu.Len() - 1
    end

    pub func add_weighted(u: int, v: int, w: f64): int: ret this.AddWeighted(u, v, w) end

    @en "order"
    @fa "مرتبه"
    pub func Order(): int: ret this.n end

    pub func order(): int: ret this.Order() end

    @en "size"
    @fa "اندازه"
    pub func Size(): int: ret this.eu.Len() end

    pub func size(): int: ret this.Size() end

    @en "edge_from"
    @fa "سر یال"
    pub func EdgeFrom(e: int): int: ret this.eu.Get(e) end

    pub func edge_from(e: int): int: ret this.EdgeFrom(e) end

    @en "edge_to"
    @fa "ته یال"
    pub func EdgeTo(e: int): int: ret this.ev.Get(e) end

    pub func edge_to(e: int): int: ret this.EdgeTo(e) end

    @en "edge_weight"
    @fa "وزن یال"
    pub func EdgeWeight(e: int): f64: ret this.ew.Get(e) end

    pub func edge_weight(e: int): f64: ret this.EdgeWeight(e) end

    @en "set_weight"
    @fa "تنظیم وزن"
    pub func SetWeight(e: int, w: f64): this.ew.Set(e, w) end

    pub func set_weight(e: int, w: f64): this.SetWeight(e, w) end

    @en "set_name"
    @fa "تنظیم نام"
    pub func SetName(u: int, s: str):
        if u < 0: ret end
        if u >= this.n: this.n = u + 1 end
        until this.names.Len() <= u: this.names.Push("") end
        this.names.Set(u, s)
    end

    pub func set_name(u: int, s: str): this.SetName(u, s) end

    @en "name"
    @fa "نام"
    pub func Name(u: int): str:
        if u < 0: ret "" end
        if u >= this.names.Len(): ret "" end
        ret this.names.Get(u)
    end

    pub func name(u: int): str: ret this.Name(u) end

    @en "build"
    @fa "ساخت"
    pub func Build():
        if this.built: ret end
        _csr(this.eu, this.ev, this.n, this.directed == false, this.off, this.nbr, this.eix)
        if this.directed:
            _csr(this.ev, this.eu, this.n, false, this.roff, this.rnbr, this.reix)
        end
        this.built = true
    end

    pub func build(): this.Build() end

    @en "adj_start"
    @fa "آغاز مجاورت"
    pub func AdjStart(u: int): int:
        this.Build()
        ret this.off.Get(u)
    end

    pub func adj_start(u: int): int: ret this.AdjStart(u) end

    @en "adj_stop"
    @fa "پایان مجاورت"
    pub func AdjStop(u: int): int:
        this.Build()
        ret this.off.Get(u + 1)
    end

    pub func adj_stop(u: int): int: ret this.AdjStop(u) end

    @en "adj_node"
    @fa "گره مجاور"
    pub func AdjNode(k: int): int: ret this.nbr.Get(k) end

    pub func adj_node(k: int): int: ret this.AdjNode(k) end

    @en "adj_edge"
    @fa "یال مجاور"
    pub func AdjEdge(k: int): int: ret this.eix.Get(k) end

    pub func adj_edge(k: int): int: ret this.AdjEdge(k) end

    @en "adj_weight"
    @fa "وزن مجاور"
    pub func AdjWeight(k: int): f64: ret this.ew.Get(this.eix.Get(k)) end

    pub func adj_weight(k: int): f64: ret this.AdjWeight(k) end

    @en "in_start"
    @fa "آغاز ورودی"
    pub func InStart(u: int): int:
        this.Build()
        if this.directed: ret this.roff.Get(u) end
        ret this.off.Get(u)
    end

    pub func in_start(u: int): int: ret this.InStart(u) end

    @en "in_stop"
    @fa "پایان ورودی"
    pub func InStop(u: int): int:
        this.Build()
        if this.directed: ret this.roff.Get(u + 1) end
        ret this.off.Get(u + 1)
    end

    pub func in_stop(u: int): int: ret this.InStop(u) end

    @en "in_node"
    @fa "گره ورودی"
    pub func InNode(k: int): int:
        if this.directed: ret this.rnbr.Get(k) end
        ret this.nbr.Get(k)
    end

    pub func in_node(k: int): int: ret this.InNode(k) end

    @en "in_edge"
    @fa "یال ورودی"
    pub func InEdge(k: int): int:
        if this.directed: ret this.reix.Get(k) end
        ret this.eix.Get(k)
    end

    pub func in_edge(k: int): int: ret this.InEdge(k) end

    @en "out_degree"
    @fa "درجه خروجی"
    pub func OutDegree(u: int): int:
        ret this.AdjStop(u) - this.AdjStart(u)
    end

    pub func out_degree(u: int): int: ret this.OutDegree(u) end

    @en "in_degree"
    @fa "درجه ورودی"
    pub func InDegree(u: int): int:
        ret this.InStop(u) - this.InStart(u)
    end

    pub func in_degree(u: int): int: ret this.InDegree(u) end

    @en "degree"
    @fa "درجه"
    pub func Degree(u: int): int:
        if this.directed: ret this.OutDegree(u) + this.InDegree(u) end
        ret this.OutDegree(u)
    end

    pub func degree(u: int): int: ret this.Degree(u) end

    @en "has_edge"
    @fa "دارای یال"
    pub func HasEdge(u: int, v: int): bool:
        ret this.FindEdge(u, v) != GRAPH_NONE
    end

    pub func has_edge(u: int, v: int): bool: ret this.HasEdge(u, v) end

    @en "find_edge"
    @fa "یافتن یال"
    pub func FindEdge(u: int, v: int): int:
        if u < 0: ret GRAPH_NONE end
        if u >= this.n: ret GRAPH_NONE end
        mut k := this.AdjStart(u)
        stop := this.AdjStop(u)
        until k < stop:
            if this.AdjNode(k) == v: ret this.AdjEdge(k) end
            k++
        end
        ret GRAPH_NONE
    end

    pub func find_edge(u: int, v: int): int: ret this.FindEdge(u, v) end

    @en "weight_between"
    @fa "وزن میان"
    pub func WeightBetween(u: int, v: int): f64:
        e := this.FindEdge(u, v)
        if e == GRAPH_NONE: ret GRAPH_INF end
        ret this.ew.Get(e)
    end

    pub func weight_between(u: int, v: int): f64: ret this.WeightBetween(u, v) end

    @en "neighbors"
    @fa "همسایگان"
    pub func Neighbors(u: int): Vector<int>:
        mut out := Vector {} as Vector<int>
        mut k := this.AdjStart(u)
        stop := this.AdjStop(u)
        until k < stop:
            out.Push(this.AdjNode(k))
            k++
        end
        ret out
    end

    pub func neighbors(u: int): Vector<int>: ret this.Neighbors(u) end

    @en "free"
    @fa "آزادسازی"
    pub func Free():
        this.eu.Free()
        this.ev.Free()
        this.ew.Free()
        this.names.Free()
        this.off.Free()
        this.nbr.Free()
        this.eix.Free()
        this.roff.Free()
        this.rnbr.Free()
        this.reix.Free()
    end

    pub func free(): this.Free() end
end

func _csr(a: Vector<int>, b: Vector<int>, n: int, both: bool, off &: Vector<int>, nbr &: Vector<int>, eix &: Vector<int>):
    m := a.Len()
    off.zeros(n + 1)
    repeat m in i:
        _bump(off, a.Get(i) + 1)
        if both: _bump(off, b.Get(i) + 1) end
    end
    repeat n in i:
        off.Set(i + 1, off.Get(i + 1) + off.Get(i))
    end
    total := off.Get(n)
    nbr.Clear()
    eix.Clear()
    if total > 0:
        nbr.zeros(total)
        eix.zeros(total)
    end
    mut cur := Vector {} as Vector<int>
    defer cur.Free()
    cur.zeros(n + 1)
    repeat n + 1 in i: cur.Set(i, off.Get(i)) end
    repeat m in i:
        _place(cur, nbr, eix, a.Get(i), b.Get(i), i)
        if both: _place(cur, nbr, eix, b.Get(i), a.Get(i), i) end
    end
end

func _bump(v &: Vector<int>, i: int): v.Set(i, v.Get(i) + 1) end

func _place(cur &: Vector<int>, nbr &: Vector<int>, eix &: Vector<int>, u: int, v: int, e: int):
    p := cur.Get(u)
    nbr.Set(p, v)
    eix.Set(p, e)
    cur.Set(u, p + 1)
end

@en "New"
@fa "جدید"
pub func New(n: int, directed: bool): Graph:
    mut g := Graph {}
    g.directed = directed
    g.AddNodes(n)
    ret g
end

@en "NewUndirected"
@fa "بی‌جهت جدید"
pub func NewUndirected(n: int): Graph: ret New(n, false) end

@en "NewDirected"
@fa "جهت‌دار جدید"
pub func NewDirected(n: int): Graph: ret New(n, true) end

@en "FromEdges"
@fa "از یال‌ها"
pub func FromEdges(n: int, us: Vector<int>, vs: Vector<int>, directed: bool): Graph:
    mut g := New(n, directed)
    m := us.Len()
    repeat m in i:
        g.AddEdge(us.Get(i), vs.Get(i))
    end
    ret g
end

@en "IsClose"
@fa "نزدیک است"
pub func IsClose(a: f64, b: f64): bool:
    d := a - b
    if d < 0.0: ret 0.0 - d < _GRAPH_EPS end
    ret d < _GRAPH_EPS
end
