package graphql

@en "VAL_NULL"
@fa "مقدار تهی"
pub const VAL_NULL := 0
@en "VAL_BOOL"
@fa "مقدار بولی"
pub const VAL_BOOL := 1
@en "VAL_INT"
@fa "مقدار صحیح"
pub const VAL_INT := 2
@en "VAL_FLOAT"
@fa "مقدار اعشاری"
pub const VAL_FLOAT := 3
@en "VAL_STRING"
@fa "مقدار رشته"
pub const VAL_STRING := 4
@en "VAL_ENUM"
@fa "مقدار شمارشی"
pub const VAL_ENUM := 5
@en "VAL_LIST"
@fa "مقدار فهرست"
pub const VAL_LIST := 6
@en "VAL_OBJECT"
@fa "مقدار شیء"
pub const VAL_OBJECT := 7
@en "VAL_VARIABLE"
@fa "مقدار متغیر"
pub const VAL_VARIABLE := 8

@en "TREF_NAMED"
@fa "ارجاع نوع نام‌دار"
pub const TREF_NAMED := 0
@en "TREF_LIST"
@fa "ارجاع نوع فهرست"
pub const TREF_LIST := 1

@en "SEL_FIELD"
@fa "گزینش فیلد"
pub const SEL_FIELD := 0
@en "SEL_FRAGMENT_SPREAD"
@fa "گزینش پخش قطعه"
pub const SEL_FRAGMENT_SPREAD := 1
@en "SEL_INLINE_FRAGMENT"
@fa "گزینش قطعه درون‌خطی"
pub const SEL_INLINE_FRAGMENT := 2

@en "OP_QUERY"
@fa "عملیات پرسمان"
pub const OP_QUERY := 0
@en "OP_MUTATION"
@fa "عملیات تغییر"
pub const OP_MUTATION := 1
@en "OP_SUBSCRIPTION"
@fa "عملیات اشتراک"
pub const OP_SUBSCRIPTION := 2

@en "AstValue"
@fa "مقدار نحوی"
pub struct AstValue:
    @en "kind"
    @fa "نوع"
    pub kind: int = VAL_NULL
    @en "b"
    @fa "مقدار منطقی"
    pub b: bool = false
    @en "i"
    @fa "مقدار صحیح"
    pub i: i64 = 0
    @en "f"
    @fa "مقدار اعشاری"
    pub f: f64 = 0.0
    @en "s"
    @fa "مقدار رشته"
    pub s: str = ""
    @en "items"
    @fa "عناصر"
    pub items: Vector<int> = Vector {}
    @en "keys"
    @fa "کلیدها"
    pub keys: Vector<str> = Vector {}
    @en "line"
    @fa "خط"
    pub line: int = 0
end

@en "AstTypeRef"
@fa "ارجاع نوع"
pub struct AstTypeRef:
    @en "kind"
    @fa "نوع"
    pub kind: int = TREF_NAMED
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "inner"
    @fa "درونی"
    pub inner: int = 0 - 1
    @en "nonNull"
    @fa "غیرتهی"
    pub nonNull: bool = false
end

@en "AstArgument"
@fa "آرگومان نحوی"
pub struct AstArgument:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "value"
    @fa "مقدار"
    pub value: int = 0 - 1
    @en "line"
    @fa "خط"
    pub line: int = 0
end

@en "AstDirective"
@fa "دستورالعمل نحوی"
pub struct AstDirective:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "args"
    @fa "آرگومان‌ها"
    pub args: Vector<AstArgument> = Vector {}
    @en "line"
    @fa "خط"
    pub line: int = 0
end

@en "AstSelection"
@fa "گزینش نحوی"
pub struct AstSelection:
    @en "kind"
    @fa "نوع"
    pub kind: int = SEL_FIELD
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "alias"
    @fa "نام مستعار"
    pub alias: str = ""
    @en "typeCondition"
    @fa "شرط نوع"
    pub typeCondition: str = ""
    @en "hasTypeCondition"
    @fa "دارای شرط نوع"
    pub hasTypeCondition: bool = false
    @en "args"
    @fa "آرگومان‌ها"
    pub args: Vector<AstArgument> = Vector {}
    @en "directives"
    @fa "دستورالعمل‌ها"
    pub directives: Vector<AstDirective> = Vector {}
    @en "selections"
    @fa "گزینش‌ها"
    pub selections: Vector<int> = Vector {}
    @en "line"
    @fa "خط"
    pub line: int = 0
    @en "col"
    @fa "ستون"
    pub col: int = 0
end

@en "AstVariableDef"
@fa "تعریف متغیر"
pub struct AstVariableDef:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "typeRef"
    @fa "ارجاع نوع"
    pub typeRef: int = 0 - 1
    @en "defaultValue"
    @fa "مقدار پیش‌فرض"
    pub defaultValue: int = 0 - 1
    @en "hasDefault"
    @fa "دارای پیش‌فرض"
    pub hasDefault: bool = false
    @en "directives"
    @fa "دستورالعمل‌ها"
    pub directives: Vector<AstDirective> = Vector {}
    @en "line"
    @fa "خط"
    pub line: int = 0
end

@en "AstOperation"
@fa "عملیات نحوی"
pub struct AstOperation:
    @en "optype"
    @fa "نوع عملیات"
    pub optype: int = OP_QUERY
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "varDefs"
    @fa "تعریف‌های متغیر"
    pub varDefs: Vector<AstVariableDef> = Vector {}
    @en "directives"
    @fa "دستورالعمل‌ها"
    pub directives: Vector<AstDirective> = Vector {}
    @en "selections"
    @fa "گزینش‌ها"
    pub selections: Vector<int> = Vector {}
    @en "shorthand"
    @fa "کوتاه‌نویسی"
    pub shorthand: bool = false
    @en "line"
    @fa "خط"
    pub line: int = 0
end

@en "AstFragment"
@fa "قطعه نحوی"
pub struct AstFragment:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "typeCondition"
    @fa "شرط نوع"
    pub typeCondition: str = ""
    @en "directives"
    @fa "دستورالعمل‌ها"
    pub directives: Vector<AstDirective> = Vector {}
    @en "selections"
    @fa "گزینش‌ها"
    pub selections: Vector<int> = Vector {}
    @en "line"
    @fa "خط"
    pub line: int = 0
end

@en "Document"
@fa "سند"
pub struct Document:
    @en "ops"
    @fa "عملیات‌ها"
    pub ops: Vector<AstOperation> = Vector {}
    @en "frags"
    @fa "قطعه‌ها"
    pub frags: Vector<AstFragment> = Vector {}
    @en "sels"
    @fa "گزینش‌ها"
    pub sels: Vector<AstSelection> = Vector {}
    @en "vals"
    @fa "مقدارها"
    pub vals: Vector<AstValue> = Vector {}
    @en "trefs"
    @fa "ارجاع‌های نوع"
    pub trefs: Vector<AstTypeRef> = Vector {}
end

func _doc_add_value(doc &: Document, v: AstValue): int:
    id := doc.vals.len()
    doc.vals.push(v)
    ret id
end

func _doc_add_selection(doc &: Document, s: AstSelection): int:
    id := doc.sels.len()
    doc.sels.push(s)
    ret id
end

func _doc_add_tref(doc &: Document, t: AstTypeRef): int:
    id := doc.trefs.len()
    doc.trefs.push(t)
    ret id
end

func _free_directives(ds: Vector<AstDirective>):
    mut i := 0
    until i < ds.len():
        mut d := ds.get(i)
        d.args.free()
        i += 1
    end
    mut dv := ds
    defer dv.free()
end

func _free_var_defs(vs: Vector<AstVariableDef>):
    mut i := 0
    until i < vs.len():
        _free_directives(vs.get(i).directives)
        i += 1
    end
    mut vv := vs
    defer vv.free()
end

func _free_ops(doc &: Document):
    mut i := 0
    until i < doc.ops.len():
        mut o := doc.ops.get(i)
        _free_directives(o.directives)
        _free_var_defs(o.varDefs)
        o.selections.free()
        i += 1
    end
    doc.ops.free()
end

func _free_frags(doc &: Document):
    mut i := 0
    until i < doc.frags.len():
        mut f := doc.frags.get(i)
        _free_directives(f.directives)
        f.selections.free()
        i += 1
    end
    doc.frags.free()
end

func _free_sels(doc &: Document):
    mut i := 0
    until i < doc.sels.len():
        mut s := doc.sels.get(i)
        _free_directives(s.directives)
        s.args.free()
        s.selections.free()
        i += 1
    end
    doc.sels.free()
end

func _free_vals(doc &: Document):
    mut i := 0
    until i < doc.vals.len():
        mut v := doc.vals.get(i)
        v.items.free()
        v.keys.free()
        i += 1
    end
    doc.vals.free()
end

@en "SelectionAt"
@fa "گزینش در"
pub func SelectionAt(doc: Document, id: int): AstSelection:
    if id < 0 or id >= doc.sels.len(): ret AstSelection {} end
    ret doc.sels.get(id)
end

@en "ValueAt"
@fa "مقدار در"
pub func ValueAt(doc: Document, id: int): AstValue:
    if id < 0 or id >= doc.vals.len(): ret AstValue {} end
    ret doc.vals.get(id)
end

@en "TypeRefAt"
@fa "ارجاع نوع در"
pub func TypeRefAt(doc: Document, id: int): AstTypeRef:
    if id < 0 or id >= doc.trefs.len(): ret AstTypeRef {} end
    ret doc.trefs.get(id)
end

@en "FindOperation"
@fa "یافتن عملیات"
pub func FindOperation(doc: Document, name: str): int:
    if name == "":
        if doc.ops.len() == 1: ret 0 end
        ret 0 - 1
    end
    mut i := 0
    until i < doc.ops.len():
        if doc.ops.get(i).name == name: ret i end
        i += 1
    end
    ret 0 - 1
end

@en "FindFragment"
@fa "یافتن قطعه"
pub func FindFragment(doc: Document, name: str): int:
    mut i := 0
    until i < doc.frags.len():
        if doc.frags.get(i).name == name: ret i end
        i += 1
    end
    ret 0 - 1
end

@en "OperationTypeName"
@fa "نام نوع عملیات"
pub func OperationTypeName(optype: int): str:
    if optype == OP_MUTATION: ret "mutation" end
    if optype == OP_SUBSCRIPTION: ret "subscription" end
    ret "query"
end

@en "ResponseKey"
@fa "کلید پاسخ"
pub func ResponseKey(sel: AstSelection): str:
    if sel.alias != "": ret sel.alias end
    ret sel.name
end

@en "FreeDocument"
@fa "آزادسازی سند"
pub func FreeDocument(doc &: Document):
    _free_sels(doc)
    _free_vals(doc)
    _free_ops(doc)
    _free_frags(doc)
    doc.trefs.free()
end
