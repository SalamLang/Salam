package graphql

import encoding.value

@en "FieldGroup"
@fa "گروه فیلد"
pub struct FieldGroup:
    @en "key"
    @fa "کلید"
    pub key: str = ""
    @en "sels"
    @fa "گزینش‌ها"
    pub sels: Vector<int> = Vector {}
end

@en "FieldGroups"
@fa "گروه‌های فیلد"
pub struct FieldGroups:
    @en "items"
    @fa "گروه‌ها"
    pub items: Vector<FieldGroup> = Vector {}
end

func _cl_group_index(gs: FieldGroups, key: str): int:
    mut i := 0
    until i < gs.items.Len():
        if gs.items.Get(i).key == key: ret i end
        i++
    end
    ret 0 - 1
end

func _cl_add(gs &: FieldGroups, key: str, selId: int):
    idx := _cl_group_index(gs, key)
    if idx >= 0:
        mut g := gs.items.Get(idx)
        g.sels.Push(selId)
        gs.items.Set(idx, g)
        ret
    end
    mut g := FieldGroup {}
    g.key = key
    g.sels.Push(selId)
    gs.items.Push(g)
end

func _cl_visited(names: Vector<str>, name: str): bool:
    mut i := 0
    until i < names.Len():
        if names.Get(i) == name: ret true end
        i++
    end
    ret false
end

func _cl_directive_if(sch: Schema, doc: Document, d: AstDirective, vars: value.Value, fallback: bool): bool:
    mut i := 0
    until i < d.args.Len():
        a := d.args.Get(i)
        if a.name == "if":
            r := LiteralToValue(sch, doc, a.value, vars)
            if r.ok and value.IsBool(r.value): ret value.AsBool(r.value) end
            ret fallback
        end
        i++
    end
    ret fallback
end

func _cl_should_include(sch: Schema, doc: Document, ds: Vector<AstDirective>, vars: value.Value): bool:
    mut keep := true
    mut i := 0
    until i < ds.Len():
        d := ds.Get(i)
        if d.name == "skip":
            if _cl_directive_if(sch, doc, d, vars, false): ret false end
        else d.name == "include":
            if not _cl_directive_if(sch, doc, d, vars, true): keep = false end
        end
        i++
    end
    ret keep
end

func _cl_fragment_applies(sch: Schema, condition: str, objectType: str, hasCondition: bool): bool:
    if not hasCondition: ret true end
    ret IsPossibleType(sch, condition, objectType)
end

func _cl_visit_spread(sch: Schema, doc: Document, s: AstSelection, objectType: str, vars: value.Value, gs &: FieldGroups, visited &: Vector<str>):
    if _cl_visited(visited, s.name): ret end
    fragIdx := FindFragment(doc, s.name)
    if fragIdx < 0: ret end
    frag := doc.frags.Get(fragIdx)
    if not IsPossibleType(sch, frag.typeCondition, objectType): ret end
    visited.Push(s.name)
    _cl_walk(sch, doc, frag.selections, objectType, vars, gs, visited)
end

func _cl_walk(sch: Schema, doc: Document, sels: Vector<int>, objectType: str, vars: value.Value, gs &: FieldGroups, visited &: Vector<str>):
    mut i := 0
    until i < sels.Len():
        selId := sels.Get(i)
        s := SelectionAt(doc, selId)
        i++
        if not _cl_should_include(sch, doc, s.directives, vars): continue end
        if s.kind == SEL_FIELD:
            _cl_add(gs, ResponseKey(s), selId)
        else s.kind == SEL_FRAGMENT_SPREAD:
            _cl_visit_spread(sch, doc, s, objectType, vars, gs, visited)
        else:
            if _cl_fragment_applies(sch, s.typeCondition, objectType, s.hasTypeCondition):
                _cl_walk(sch, doc, s.selections, objectType, vars, gs, visited)
            end
        end
    end
end

@en "CollectFields"
@fa "گردآوری فیلدها"
pub func CollectFields(sch: Schema, doc: Document, sels: Vector<int>, objectType: str, vars: value.Value): FieldGroups:
    mut gs := FieldGroups {}
    mut visited := Vector {} as Vector<str>
    defer visited.Free()
    _cl_walk(sch, doc, sels, objectType, vars, gs, visited)
    ret gs
end

@en "MergeSelections"
@fa "ادغام گزینش‌ها"
pub func MergeSelections(doc: Document, g: FieldGroup): Vector<int>:
    mut out := Vector {} as Vector<int>
    mut i := 0
    until i < g.sels.Len():
        s := SelectionAt(doc, g.sels.Get(i))
        mut j := 0
        until j < s.selections.Len():
            out.Push(s.selections.Get(j))
            j++
        end
        i++
    end
    ret out
end

@en "FreeFieldGroups"
@fa "آزادسازی گروه‌های فیلد"
pub func FreeFieldGroups(gs &: FieldGroups):
    mut i := 0
    until i < gs.items.Len():
        mut g := gs.items.Get(i)
        g.sels.Free()
        i++
    end
    gs.items.Free()
end
