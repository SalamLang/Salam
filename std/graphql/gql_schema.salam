package graphql


pub const TYPE_SCALAR := 0
pub const TYPE_OBJECT := 1
pub const TYPE_INTERFACE := 2
pub const TYPE_UNION := 3
pub const TYPE_ENUM := 4
pub const TYPE_INPUT_OBJECT := 5

@en "InputValueDef"
@fa "تعریف مقدار ورودی"
@ar "تعریف قیمة الإدخال"
pub struct InputValueDef:
    pub name: str = ""
    pub description: str = ""
    pub typeRef: int = 0 - 1
    pub defaultValue: int = 0 - 1
    pub hasDefault: bool = false
    pub is_deprecated: bool = false
    pub deprecationReason: str = ""
end

@en "FieldDef"
@fa "تعریف فیلد"
@ar "تعریف الحقل"
pub struct FieldDef:
    pub name: str = ""
    pub description: str = ""
    pub typeRef: int = 0 - 1
    pub args: Vector<InputValueDef> = Vector {}
    pub is_deprecated: bool = false
    pub deprecationReason: str = ""
    pub resolver: i64 = 0
end

@en "EnumValueDef"
@fa "تعریف مقدار شمارشی"
@ar "تعریف قیمة التعداد"
pub struct EnumValueDef:
    pub name: str = ""
    pub description: str = ""
    pub is_deprecated: bool = false
    pub deprecationReason: str = ""
end

@en "TypeDef"
@fa "تعریف نوع"
@ar "تعریف النوع"
pub struct TypeDef:
    pub kind: int = TYPE_SCALAR
    pub name: str = ""
    pub description: str = ""
    pub fields: Vector<FieldDef> = Vector {}
    pub inputFields: Vector<InputValueDef> = Vector {}
    pub interfaces: Vector<str> = Vector {}
    pub unionMembers: Vector<str> = Vector {}
    pub enumValues: Vector<EnumValueDef> = Vector {}
    pub specifiedByURL: str = ""
end

@en "DirectiveDef"
@fa "تعریف دستورالعمل"
@ar "تعریف التوجیه"
pub struct DirectiveDef:
    pub name: str = ""
    pub description: str = ""
    pub args: Vector<InputValueDef> = Vector {}
    pub locations: Vector<str> = Vector {}
    pub repeatable: bool = false
end

@en "Schema"
@fa "طرح‌واره"
@ar "مخطط"
pub struct Schema:
    pub doc: Document = Document {}
    pub types: Vector<TypeDef> = Vector {}
    pub directives: Vector<DirectiveDef> = Vector {}
    pub queryType: str = "Query"
    pub mutationType: str = ""
    pub subscriptionType: str = ""
    pub description: str = ""
    pub hasSchemaDef: bool = false
end

func _sch_find_index(s: Schema, name: str): int:
    mut i := 0
    until i < s.types.len():
        if s.types.get(i).name == name: ret i end
        i += 1
    end
    ret 0 - 1
end

func _sch_in_names(names: Vector<str>, want: str): bool:
    mut i := 0
    until i < names.len():
        if names.get(i) == want: ret true end
        i += 1
    end
    ret false
end

@en "TypeRefIsNonNull"
@fa "ارجاع نوع ناتهی است"
@ar "مرجع النوع غیر فارغ"
pub func TypeRefIsNonNull(doc: Document, id: int): bool:
    ret TypeRefAt(doc, id).nonNull
end

@en "TypeRefIsList"
@fa "ارجاع نوع فهرست است"
@ar "مرجع النوع قائمة"
pub func TypeRefIsList(doc: Document, id: int): bool:
    ret TypeRefAt(doc, id).kind == TREF_LIST
end

@en "TypeRefElement"
@fa "عنصر ارجاع نوع"
@ar "عنصر مرجع النوع"
pub func TypeRefElement(doc: Document, id: int): int:
    t := TypeRefAt(doc, id)
    if t.kind != TREF_LIST: ret 0 - 1 end
    ret t.inner
end

@en "TypeRefName"
@fa "نام ارجاع نوع"
@ar "اسم مرجع النوع"
pub func TypeRefName(doc: Document, id: int): str:
    mut cur := id
    mut guard := 0
    until guard < 64:
        t := TypeRefAt(doc, cur)
        if t.kind != TREF_LIST: ret t.name end
        cur = t.inner
        guard += 1
    end
    ret ""
end

@en "FindType"
@fa "یافتن نوع"
@ar "إیجاد النوع"
pub func FindType(s: Schema, name: str): TypeDef:
    idx := _sch_find_index(s, name)
    if idx < 0: ret TypeDef { kind = 0 - 1 } end
    ret s.types.get(idx)
end

@en "HasType"
@fa "نوع دارد"
@ar "یملک النوع"
pub func HasType(s: Schema, name: str): bool:
    ret _sch_find_index(s, name) >= 0
end

@en "TypeIndex"
@fa "نمایه نوع"
@ar "فهرس النوع"
pub func TypeIndex(s: Schema, name: str): int: ret _sch_find_index(s, name) end

@en "TypeCount"
@fa "تعداد نوع"
@ar "عدد الأنواع"
pub func TypeCount(s: Schema): int: ret s.types.len() end

@en "TypeAt"
@fa "نوع در"
@ar "النوع عند"
pub func TypeAt(s: Schema, i: int): TypeDef:
    if i < 0 || i >= s.types.len(): ret TypeDef { kind = 0 - 1 } end
    ret s.types.get(i)
end

@en "FindField"
@fa "یافتن فیلد"
@ar "إیجاد الحقل"
pub func FindField(t: TypeDef, name: str): FieldDef:
    mut i := 0
    until i < t.fields.len():
        if t.fields.get(i).name == name: ret t.fields.get(i) end
        i += 1
    end
    ret FieldDef { typeRef = 0 - 1 }
end

@en "HasField"
@fa "فیلد دارد"
@ar "یملک الحقل"
pub func HasField(t: TypeDef, name: str): bool:
    ret FindField(t, name).name != ""
end

@en "FindInputField"
@fa "یافتن فیلد ورودی"
@ar "إیجاد حقل الإدخال"
pub func FindInputField(t: TypeDef, name: str): InputValueDef:
    mut i := 0
    until i < t.inputFields.len():
        if t.inputFields.get(i).name == name: ret t.inputFields.get(i) end
        i += 1
    end
    ret InputValueDef { typeRef = 0 - 1 }
end

@en "FindArg"
@fa "یافتن آرگومان"
@ar "إیجاد الوسیط"
pub func FindArg(f: FieldDef, name: str): InputValueDef:
    mut i := 0
    until i < f.args.len():
        if f.args.get(i).name == name: ret f.args.get(i) end
        i += 1
    end
    ret InputValueDef { typeRef = 0 - 1 }
end

@en "FindDirectiveDef"
@fa "یافتن تعریف دستورالعمل"
@ar "إیجاد تعریف التوجیه"
pub func FindDirectiveDef(s: Schema, name: str): DirectiveDef:
    mut i := 0
    until i < s.directives.len():
        if s.directives.get(i).name == name: ret s.directives.get(i) end
        i += 1
    end
    ret DirectiveDef {}
end

@en "HasEnumValue"
@fa "مقدار شمارشی دارد"
@ar "یملک قیمة التعداد"
pub func HasEnumValue(t: TypeDef, name: str): bool:
    mut i := 0
    until i < t.enumValues.len():
        if t.enumValues.get(i).name == name: ret true end
        i += 1
    end
    ret false
end

@en "IsInputType"
@fa "نوع ورودی است"
@ar "نوع إدخال"
pub func IsInputType(s: Schema, name: str): bool:
    k := FindType(s, name).kind
    ret k == TYPE_SCALAR || k == TYPE_ENUM || k == TYPE_INPUT_OBJECT
end

@en "IsOutputType"
@fa "نوع خروجی است"
@ar "نوع إخراج"
pub func IsOutputType(s: Schema, name: str): bool:
    k := FindType(s, name).kind
    ret k == TYPE_SCALAR || k == TYPE_ENUM || k == TYPE_OBJECT || k == TYPE_INTERFACE || k == TYPE_UNION
end

@en "IsAbstractType"
@fa "نوع انتزاعی است"
@ar "نوع مجرد"
pub func IsAbstractType(s: Schema, name: str): bool:
    k := FindType(s, name).kind
    ret k == TYPE_INTERFACE || k == TYPE_UNION
end

@en "IsLeafType"
@fa "نوع برگ است"
@ar "نوع ورقي"
pub func IsLeafType(s: Schema, name: str): bool:
    k := FindType(s, name).kind
    ret k == TYPE_SCALAR || k == TYPE_ENUM
end

@en "IsPossibleType"
@fa "نوع ممکن است"
@ar "نوع ممکن"
pub func IsPossibleType(s: Schema, abstractName: str, objectName: str): bool:
    if abstractName == objectName: ret true end
    absType := FindType(s, abstractName)
    if absType.kind == TYPE_UNION: ret _sch_in_names(absType.unionMembers, objectName) end
    if absType.kind == TYPE_INTERFACE:
        objType := FindType(s, objectName)
        ret _sch_in_names(objType.interfaces, abstractName)
    end
    ret false
end

@en "PossibleTypes"
@fa "انواع ممکن"
@ar "الأنواع الممکنة"
pub func PossibleTypes(s: Schema, name: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    t := FindType(s, name)
    if t.kind == TYPE_UNION:
        mut i := 0
        until i < t.unionMembers.len():
            out.push(t.unionMembers.get(i))
            i += 1
        end
        ret out
    end
    if t.kind == TYPE_OBJECT:
        out.push(name)
        ret out
    end
    if t.kind != TYPE_INTERFACE: ret out end
    mut j := 0
    until j < s.types.len():
        objType := s.types.get(j)
        if objType.kind == TYPE_OBJECT && _sch_in_names(objType.interfaces, name):
            out.push(objType.name)
        end
        j += 1
    end
    ret out
end

@en "RootTypeName"
@fa "نام نوع ریشه"
@ar "اسم نوع الجذر"
pub func RootTypeName(s: Schema, optype: int): str:
    if optype == OP_MUTATION: ret s.mutationType end
    if optype == OP_SUBSCRIPTION: ret s.subscriptionType end
    ret s.queryType
end
