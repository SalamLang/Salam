package graphql

import encoding.value

// slot - the resolver call slot's shape.
//
// Split out of gql_resolver.salam because the slot table is a
// file-level global there, and this compiler requires a global to be
// declared above every type definition in its own file (E085). Keeping
// the structs here lets the global sit at the top of gql_resolver.salam
// while still naming a type declared elsewhere, the same arrangement
// std/rpc uses for its MethodTable.

@en "ResolverSlot"
@fa "شکاف حل‌کننده"
@ar "خانة المحلل"
pub struct ResolverSlot:
    pub busy: bool = false
    pub parent: value.Value = value.Value {}
    pub args: value.Value = value.Value {}
    pub ctx: value.Value = value.Value {}
    pub fieldName: str = ""
    pub parentType: str = ""
    pub result: value.Value = value.Value {}
    pub resolved: bool = false
    pub failed: bool = false
    pub message: str = ""
end

@en "SlotTable"
@fa "جدول شکاف"
@ar "جدول الخانات"
pub struct GqlSlotTable:
    pub items: Vector<ResolverSlot> = Vector {}
end
