package graphql

pub const TOK_EOF := 0
pub const TOK_NAME := 1
pub const TOK_INT := 2
pub const TOK_FLOAT := 3
pub const TOK_STRING := 4
pub const TOK_BLOCK_STRING := 5
pub const TOK_BANG := 6
pub const TOK_DOLLAR := 7
pub const TOK_AMP := 8
pub const TOK_LPAREN := 9
pub const TOK_RPAREN := 10
pub const TOK_SPREAD := 11
pub const TOK_COLON := 12
pub const TOK_EQUALS := 13
pub const TOK_AT := 14
pub const TOK_LBRACKET := 15
pub const TOK_RBRACKET := 16
pub const TOK_LBRACE := 17
pub const TOK_RBRACE := 18
pub const TOK_PIPE := 19
pub const TOK_ERROR := 20

@en "Token"
@fa "توکن"
@ar "رمز"
pub struct GqlToken:
    pub kind: int = TOK_EOF
    pub lexeme: str = ""
    pub sval: str = ""
    pub ival: i64 = 0
    pub fval: f64 = 0.0
    pub line: int = 0
    pub col: int = 0
    pub pos: int = 0
end

@en "TokenStream"
@fa "جریان توکن"
@ar "تدفق الرموز"
pub struct GqlTokenStream:
    pub toks: Vector<GqlToken> = Vector {}
end

@en "TokenKindName"
@fa "نام نوع توکن"
@ar "اسم نوع الرمز"
pub func TokenKindName(kind: int): str:
    if kind == TOK_EOF: ret "<EOF>" end
    if kind == TOK_NAME: ret "Name" end
    if kind == TOK_INT: ret "Int" end
    if kind == TOK_FLOAT: ret "Float" end
    if kind == TOK_STRING: ret "String" end
    if kind == TOK_BLOCK_STRING: ret "BlockString" end
    if kind == TOK_BANG: ret "!" end
    if kind == TOK_DOLLAR: ret "$" end
    if kind == TOK_AMP: ret "&" end
    if kind == TOK_LPAREN: ret "(" end
    if kind == TOK_RPAREN: ret ")" end
    if kind == TOK_SPREAD: ret "..." end
    if kind == TOK_COLON: ret ":" end
    if kind == TOK_EQUALS: ret "=" end
    if kind == TOK_AT: ret "@" end
    if kind == TOK_LBRACKET: ret "[" end
    if kind == TOK_RBRACKET: ret "]" end
    if kind == TOK_LBRACE: ret "{" end
    if kind == TOK_RBRACE: ret "}" end
    if kind == TOK_PIPE: ret "|" end
    ret "<error>"
end

@en "IsStringToken"
@fa "توکن رشته است"
@ar "رمز نصی"
pub func IsStringToken(kind: int): bool:
    ret kind == TOK_STRING || kind == TOK_BLOCK_STRING
end
