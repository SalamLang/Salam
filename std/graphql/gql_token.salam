package graphql

// token - GraphQL lexical tokens (June 2018 / October 2021 spec, section 2.1).
//
// GraphQL has no reserved words at the lexical level: `query`, `type`,
// `fragment`, `on`, `true`, `null` and friends are all ordinary Name
// tokens that the parser matches by lexeme, exactly the way
// encoding/protobuf's lexer treats .proto keywords. That is not a
// shortcut, it is required by the spec: `{ type { on } }` is a legal
// query selecting a field literally named `on`, and a type may declare a
// field called `query`. Making them token kinds would reject valid
// documents.
//
// Discriminants are plain int consts rather than a pub enum because enum
// values cannot cross a package boundary in this compiler, and callers in
// other packages need to read token kinds back off a GqlToken.

pub const TOK_EOF := 0
pub const TOK_NAME := 1
pub const TOK_INT := 2
pub const TOK_FLOAT := 3
pub const TOK_STRING := 4
pub const TOK_BLOCK_STRING := 5
pub const TOK_BANG := 6
pub const TOK_DOLLAR := 7
pub const TOK_AMP := 8
pub const TOK_LPAREN := 9
pub const TOK_RPAREN := 10
pub const TOK_SPREAD := 11
pub const TOK_COLON := 12
pub const TOK_EQUALS := 13
pub const TOK_AT := 14
pub const TOK_LBRACKET := 15
pub const TOK_RBRACKET := 16
pub const TOK_LBRACE := 17
pub const TOK_RBRACE := 18
pub const TOK_PIPE := 19
pub const TOK_ERROR := 20

// A single lexical token.
//
// `lexeme` carries the raw source text for names and numbers; `sval`
// carries the *decoded* text of a string token (escapes resolved, block
// string indentation stripped) since that differs from the raw source.
// `ival` / `fval` carry the parsed numeric payload so the parser never
// re-scans a number.
@en "Token"
@fa "توکن"
@ar "رمز"
pub struct GqlToken:
    pub kind: int = TOK_EOF
    pub lexeme: str = ""
    pub sval: str = ""
    pub ival: i64 = 0
    pub fval: f64 = 0.0
    pub line: int = 0
    pub col: int = 0
    pub pos: int = 0
end

@en "TokenStream"
@fa "جریان توکن"
@ar "تدفق الرموز"
pub struct GqlTokenStream:
    pub toks: Vector<GqlToken> = Vector {}
end

// Human-readable token-kind name, used verbatim in parser error messages
// ("expected Name, found }") the way graphql-js phrases them.
@en "TokenKindName"
@fa "نام نوع توکن"
@ar "اسم نوع الرمز"
pub func TokenKindName(kind: int): str:
    if kind == TOK_EOF: ret "<EOF>" end
    if kind == TOK_NAME: ret "Name" end
    if kind == TOK_INT: ret "Int" end
    if kind == TOK_FLOAT: ret "Float" end
    if kind == TOK_STRING: ret "String" end
    if kind == TOK_BLOCK_STRING: ret "BlockString" end
    if kind == TOK_BANG: ret "!" end
    if kind == TOK_DOLLAR: ret "$" end
    if kind == TOK_AMP: ret "&" end
    if kind == TOK_LPAREN: ret "(" end
    if kind == TOK_RPAREN: ret ")" end
    if kind == TOK_SPREAD: ret "..." end
    if kind == TOK_COLON: ret ":" end
    if kind == TOK_EQUALS: ret "=" end
    if kind == TOK_AT: ret "@" end
    if kind == TOK_LBRACKET: ret "[" end
    if kind == TOK_RBRACKET: ret "]" end
    if kind == TOK_LBRACE: ret "{" end
    if kind == TOK_RBRACE: ret "}" end
    if kind == TOK_PIPE: ret "|" end
    ret "<error>"
end

// True for the two token kinds that both carry decoded text in `sval`.
// Descriptions in SDL accept either form, so parsing code asks this
// rather than testing both constants at every site.
@en "IsStringToken"
@fa "توکن رشته است"
@ar "رمز نصی"
pub func IsStringToken(kind: int): bool:
    ret kind == TOK_STRING || kind == TOK_BLOCK_STRING
end
