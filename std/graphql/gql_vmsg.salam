package graphql

// vmsg - the wording of every validation error.
//
// Kept in one file so the phrasing stays consistent and so a message
// can be reworded without touching the rule that raises it. The
// wording follows graphql-js closely, since that is what most GraphQL
// developers have learned to read.

func _gql_dup_operation_msg(name: str): str:
    ret "there can be only one operation named " + _gql_quote(name)
end

func _gql_lone_anonymous_msg(): str:
    ret "this anonymous operation must be the only defined operation"
end

func _gql_dup_fragment_msg(name: str): str:
    ret "there can be only one fragment named " + _gql_quote(name)
end

func _gql_unknown_fragment_msg(name: str): str:
    ret "unknown fragment " + _gql_quote(name)
end

func _gql_unused_fragment_msg(name: str): str:
    ret "fragment " + _gql_quote(name) + " is never used"
end

func _gql_fragment_cycle_msg(name: str): str:
    ret "cannot spread fragment " + _gql_quote(name) + " within itself"
end

func _gql_unknown_type_msg(name: str): str:
    ret "unknown type " + _gql_quote(name)
end

func _gql_not_composite_msg(name: str): str:
    ret "fragment cannot condition on non-composite type " + _gql_quote(name)
end

func _gql_not_input_type_msg(varName: str, typeName: str): str:
    ret "variable " + _gql_quote("$" + varName) + " cannot be non-input type " + _gql_quote(typeName)
end

func _gql_dup_variable_msg(name: str): str:
    ret "there can be only one variable named " + _gql_quote("$" + name)
end

func _gql_undefined_variable_msg(name: str): str:
    ret "variable " + _gql_quote("$" + name) + " is not defined by the operation"
end

func _gql_unused_variable_msg(name: str): str:
    ret "variable " + _gql_quote("$" + name) + " is never used"
end

func _gql_unknown_directive_msg(name: str): str:
    ret "unknown directive " + _gql_quote("@" + name)
end

func _gql_directive_location_msg(name: str, location: str): str:
    ret "directive " + _gql_quote("@" + name) + " may not be used on " + location
end

func _gql_dup_directive_msg(name: str): str:
    ret "the directive " + _gql_quote("@" + name) + " can only be used once at this location"
end

func _gql_dup_argument_msg(name: str): str:
    ret "there can be only one argument named " + _gql_quote(name)
end

func _gql_owner_label(owner: str, isDirective: bool): str:
    if isDirective: ret "directive " + _gql_quote("@" + owner) end
    ret "field " + _gql_quote(owner)
end

func _gql_unknown_argument_msg(name: str, owner: str, isDirective: bool): str:
    ret "unknown argument " + _gql_quote(name) + " on " + _gql_owner_label(owner, isDirective)
end

func _gql_missing_argument_msg(name: str, owner: str, isDirective: bool): str:
    ret _gql_owner_label(owner, isDirective) + " requires argument " + _gql_quote(name)
end

func _gql_leaf_selection_msg(fieldName: str, typeName: str): str:
    ret "field " + _gql_quote(fieldName) + " of type " + _gql_quote(typeName) + " must not have a selection set"
end

func _gql_missing_selection_msg(fieldName: str, typeName: str): str:
    ret "field " + _gql_quote(fieldName) + " of type " + _gql_quote(typeName) + " must have a selection set"
end

func _gql_spread_incompatible_msg(name: str, cond: str, parent: str): str:
    ret "fragment " + _gql_quote(name) + " cannot be spread here as objects of type " + _gql_quote(parent) + " can never be of type " + _gql_quote(cond)
end

func _gql_inline_incompatible_msg(cond: str, parent: str): str:
    ret "fragment cannot be spread here as objects of type " + _gql_quote(parent) + " can never be of type " + _gql_quote(cond)
end

func _gql_single_root_field_msg(): str:
    ret "a subscription operation must select exactly one root field"
end
