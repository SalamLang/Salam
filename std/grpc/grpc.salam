@en "grpc"
@fa "جی آر پی سی"
@ar "جی آر بی سی"
package grpc

import compress
import net.http2

pub const GRPC_OK := 0
pub const GRPC_CANCELLED := 1
pub const GRPC_UNKNOWN := 2
pub const GRPC_INVALID_ARGUMENT := 3
pub const GRPC_DEADLINE_EXCEEDED := 4
pub const GRPC_NOT_FOUND := 5
pub const GRPC_ALREADY_EXISTS := 6
pub const GRPC_PERMISSION_DENIED := 7
pub const GRPC_RESOURCE_EXHAUSTED := 8
pub const GRPC_FAILED_PRECONDITION := 9
pub const GRPC_ABORTED := 10
pub const GRPC_OUT_OF_RANGE := 11
pub const GRPC_UNIMPLEMENTED := 12
pub const GRPC_INTERNAL := 13
pub const GRPC_UNAVAILABLE := 14
pub const GRPC_DATA_LOSS := 15
pub const GRPC_UNAUTHENTICATED := 16

pub const GRPC_CONTENT_TYPE := "application/grpc"
pub const GRPC_CONTENT_TYPE_PROTO := "application/grpc+proto"
pub const GRPC_CONTENT_TYPE_JSON := "application/grpc+json"

pub const GRPC_COMP_NONE := 0
pub const GRPC_COMP_GZIP := 1

pub const GRPC_MAX_FRAMES := 100000

@en "Status"
@fa "وضعیت"
@ar "حالة"
pub struct Status:
    pub code: int = 0
    pub message: str = ""
end

@en "MDEntry"
@fa "مدخل فراداده"
@ar "مدخل البیانات الوصفیة"
pub struct MDEntry:
    pub key: str = ""
    pub value: str = ""
    pub binary: bool = false
end

@en "Metadata"
@fa "فراداده"
@ar "بیانات وصفیة"
pub struct Metadata:
    pub items: Vector<MDEntry> = Vector {}
end

@en "CallCtx"
@fa "زمینه فراخوانی"
@ar "سیاق الاستدعاء"
pub struct CallCtx:
    pub stream_id: int = 0
    pub method: str = ""
    pub headers: http2.HeaderList = http2.HeaderList {}
    pub recv: compress.ByteBuf = compress.ByteBuf {}
    pub recv_pos: int = 0
    pub client_done: bool = false
    pub sent_headers: bool = false
    pub status: Status = Status {}
    pub busy: bool = false
    pub failed: bool = false
end

@en "CallTable"
@fa "جدول فراخوانی‌ها"
@ar "جدول الاستدعاءات"
pub struct CallTable:
    pub items: Vector<CallCtx> = Vector {}
end

@en "MethodDesc"
@fa "توصیف متد"
@ar "وصف الطریقة"
pub struct MethodDesc:
    pub path: str = ""
    pub fn: i64 = 0
    pub client_stream: bool = false
    pub server_stream: bool = false
end

@en "MethodTable"
@fa "جدول متدها"
@ar "جدول الطرق"
pub struct MethodTable:
    pub items: Vector<MethodDesc> = Vector {}
end

@en "Cursor"
@fa "مکان‌نما"
@ar "مؤشر"
pub struct Cursor:
    pub stream_id: int = 0
    pub pos: int = 0
end

@en "CursorTable"
@fa "جدول مکان‌نماها"
@ar "جدول المؤشرات"
pub struct CursorTable:
    pub items: Vector<Cursor> = Vector {}
end

@en "NewStatus"
@fa "وضعیت جدید"
@ar "حالة جدیدة"
pub func NewStatus(code: int, message: str): Status:
    mut s := Status {}
    s.code = code
    s.message = message
    ret s
end

@en "StatusOk"
@fa "وضعیت موفق"
@ar "حالة ناجحة"
pub func StatusOk(s: Status): bool:
    ret s.code == GRPC_OK
end

@en "MethodPath"
@fa "مسیر متد"
@ar "مسار الطریقة"
pub func MethodPath(service: str, method: str): str:
    ret "/" + service + "/" + method
end
