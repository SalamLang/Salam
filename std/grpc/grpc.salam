@en "grpc"
@fa "جی آر پی سی"
package grpc

import compress
import net.http2

@en "GRPC_OK"
@fa "وضعیت بدون خطا"
pub const GRPC_OK := 0
@en "GRPC_CANCELLED"
@fa "وضعیت لغو شده"
pub const GRPC_CANCELLED := 1
@en "GRPC_UNKNOWN"
@fa "وضعیت ناشناخته"
pub const GRPC_UNKNOWN := 2
@en "GRPC_INVALID_ARGUMENT"
@fa "وضعیت آرگومان نامعتبر"
pub const GRPC_INVALID_ARGUMENT := 3
@en "GRPC_DEADLINE_EXCEEDED"
@fa "وضعیت گذشت مهلت"
pub const GRPC_DEADLINE_EXCEEDED := 4
@en "GRPC_NOT_FOUND"
@fa "وضعیت یافت نشد"
pub const GRPC_NOT_FOUND := 5
@en "GRPC_ALREADY_EXISTS"
@fa "وضعیت از پیش موجود"
pub const GRPC_ALREADY_EXISTS := 6
@en "GRPC_PERMISSION_DENIED"
@fa "وضعیت دسترسی رد شد"
pub const GRPC_PERMISSION_DENIED := 7
@en "GRPC_RESOURCE_EXHAUSTED"
@fa "وضعیت منابع تمام شد"
pub const GRPC_RESOURCE_EXHAUSTED := 8
@en "GRPC_FAILED_PRECONDITION"
@fa "وضعیت پیش‌شرط ناموفق"
pub const GRPC_FAILED_PRECONDITION := 9
@en "GRPC_ABORTED"
@fa "وضعیت قطع شده"
pub const GRPC_ABORTED := 10
@en "GRPC_OUT_OF_RANGE"
@fa "وضعیت خارج از محدوده"
pub const GRPC_OUT_OF_RANGE := 11
@en "GRPC_UNIMPLEMENTED"
@fa "وضعیت پیاده‌سازی نشده"
pub const GRPC_UNIMPLEMENTED := 12
@en "GRPC_INTERNAL"
@fa "وضعیت خطای داخلی"
pub const GRPC_INTERNAL := 13
@en "GRPC_UNAVAILABLE"
@fa "وضعیت ناموجود"
pub const GRPC_UNAVAILABLE := 14
@en "GRPC_DATA_LOSS"
@fa "وضعیت از دست رفتن داده"
pub const GRPC_DATA_LOSS := 15
@en "GRPC_UNAUTHENTICATED"
@fa "وضعیت احراز نشده"
pub const GRPC_UNAUTHENTICATED := 16

@en "GRPC_CONTENT_TYPE"
@fa "نوع محتوا"
pub const GRPC_CONTENT_TYPE := "application/grpc"
@en "GRPC_CONTENT_TYPE_PROTO"
@fa "نوع محتوای پروتو"
pub const GRPC_CONTENT_TYPE_PROTO := "application/grpc+proto"
@en "GRPC_CONTENT_TYPE_JSON"
@fa "نوع محتوای جیسون"
pub const GRPC_CONTENT_TYPE_JSON := "application/grpc+json"

@en "GRPC_COMP_NONE"
@fa "بدون فشرده‌سازی"
pub const GRPC_COMP_NONE := 0
@en "GRPC_COMP_GZIP"
@fa "فشرده‌سازی جی زیپ"
pub const GRPC_COMP_GZIP := 1

@en "GRPC_MAX_FRAMES"
@fa "بیشینه قاب‌ها"
pub const GRPC_MAX_FRAMES := 100000

@en "Status"
@fa "وضعیت"
pub struct Status:
    pub code: int = 0
    pub message: str = ""
end

@en "MDEntry"
@fa "مدخل فراداده"
pub struct MDEntry:
    pub key: str = ""
    pub value: str = ""
    pub binary: bool = false
end

@en "Metadata"
@fa "فراداده"
pub struct Metadata:
    pub items: Vector<MDEntry> = Vector {}
end

@en "CallCtx"
@fa "زمینه فراخوان"
pub struct CallCtx:
    pub stream_id: int = 0
    pub method: str = ""
    pub headers: http2.HeaderList = http2.HeaderList {}
    pub recv: compress.ByteBuf = compress.ByteBuf {}
    pub recv_pos: int = 0
    pub client_done: bool = false
    pub sent_headers: bool = false
    pub status: Status = Status {}
    pub busy: bool = false
    pub failed: bool = false
end

@en "CallTable"
@fa "جدول فراخوان‌ها"
pub struct CallTable:
    pub items: Vector<CallCtx> = Vector {}
end

@en "MethodDesc"
@fa "توصیف متد"
pub struct MethodDesc:
    pub path: str = ""
    pub fn: i64 = 0
    pub client_stream: bool = false
    pub server_stream: bool = false
end

@en "MethodTable"
@fa "جدول متدها"
pub struct MethodTable:
    pub items: Vector<MethodDesc> = Vector {}
end

@en "Cursor"
@fa "مکان‌نما"
pub struct Cursor:
    pub stream_id: int = 0
    pub pos: int = 0
end

@en "CursorTable"
@fa "جدول مکان‌نماها"
pub struct CursorTable:
    pub items: Vector<Cursor> = Vector {}
end

@en "NewStatus"
@fa "وضعیت جدید"
pub func NewStatus(code: int, message: str): Status:
    mut s := Status {}
    s.code = code
    s.message = message
    ret s
end

@en "StatusOk"
@fa "وضعیت موفق"
pub func StatusOk(s: Status): bool:
    ret s.code == GRPC_OK
end

@en "MethodPath"
@fa "مسیر متد"
pub func MethodPath(service: str, method: str): str:
    ret "/" + service + "/" + method
end
