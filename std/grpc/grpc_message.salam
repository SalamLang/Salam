package grpc

import compress

pub const GRPC_MAX_MESSAGE := 4194304

@en "FrameMessage"
@fa "قاب‌بندی پیام"
pub func FrameMessage(msg: compress.ByteBuf, compressed: bool): compress.ByteBuf:
    n := compress.BufLen(msg)
    mut out := compress.NewByteBufCap(n + 5)
    mut flag := 0
    if compressed: flag = 1 end
    compress.BufPush(out, flag)
    compress.BufPush(out, (n >> 24) & 255)
    compress.BufPush(out, (n >> 16) & 255)
    compress.BufPush(out, (n >> 8) & 255)
    compress.BufPush(out, n & 255)
    compress.BufPushBuf(out, msg)
    ret out
end

@en "FrameMessageGzip"
@fa "قاب‌بندی فشرده"
pub func FrameMessageGzip(msg: compress.ByteBuf, use_gzip: bool): compress.ByteBuf:
    if !use_gzip: ret FrameMessage(msg, false) end
    mut z := compress.GzipCompressBuf(msg)
    if compress.BufLen(z) >= compress.BufLen(msg):
        compress.BufFree(z)
        ret FrameMessage(msg, false)
    end
    out := FrameMessage(z, true)
    compress.BufFree(z)
    ret out
end

@en "FrameMessageStr"
@fa "قاب‌بندی پیام متنی"
pub func FrameMessageStr(msg: str): compress.ByteBuf:
    mut b := compress.BufFromStr(msg)
    out := FrameMessage(b, false)
    compress.BufFree(b)
    ret out
end

@en "HasMessage"
@fa "پیام کامل دارد"
pub func HasMessage(data: compress.ByteBuf, pos: int): bool:
    n := compress.BufLen(data)
    if pos + 5 > n: ret false end
    len := (compress.BufGet(data, pos + 1) << 24) | (compress.BufGet(data, pos + 2) << 16) | (compress.BufGet(data, pos + 3) << 8) | compress.BufGet(data, pos + 4)
    if len < 0 || len > GRPC_MAX_MESSAGE: ret false end
    ret pos + 5 + len <= n
end

@en "NextMessage"
@fa "پیام بعدی"
pub func NextMessage(data: compress.ByteBuf, pos &: int, ok &: bool): compress.ByteBuf:
    if !HasMessage(data, pos):
        ok = false
        ret compress.NewByteBuf()
    end
    flag := compress.BufGet(data, pos)
    len := (compress.BufGet(data, pos + 1) << 24) | (compress.BufGet(data, pos + 2) << 16) | (compress.BufGet(data, pos + 3) << 8) | compress.BufGet(data, pos + 4)
    mut raw := compress.NewByteBufCap(len + 1)
    mut i := 0
    until i < len:
        compress.BufPush(raw, compress.BufGet(data, pos + 5 + i))
        i += 1
    end
    pos += 5 + len
    if flag == 0:
        ok = true
        ret raw
    end
    mut zok := false
    plain := compress.GzipDecompressBuf(raw, zok)
    compress.BufFree(raw)
    ok = zok
    ret plain
end

@en "MessageCount"
@fa "تعداد پیام‌ها"
pub func MessageCount(data: compress.ByteBuf): int:
    mut pos := 0
    mut n := 0
    until HasMessage(data, pos):
        len := (compress.BufGet(data, pos + 1) << 24) | (compress.BufGet(data, pos + 2) << 16) | (compress.BufGet(data, pos + 3) << 8) | compress.BufGet(data, pos + 4)
        pos += 5 + len
        n += 1
    end
    ret n
end
