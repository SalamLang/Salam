package grpc

import compress
import net.http2
import net.internal.rawsock

// The gRPC server: a registry of methods, an accept loop, and the
// dispatch that turns one HTTP/2 stream into one handler invocation.
//
// Handler ABI, same shape as std/rpc's and for the same reason -
// `callhandler(fn, arg)` calls a `void(i64)` pointer and Salam has no
// closures, so a handler receives a *call slot* and works through it:
//
//     func say(call: i64):
//         mut ok := false
//         req := grpc.Recv(call, ok)
//         grpc.Send(call, reply)
//         grpc.SetStatus(call, grpc.GRPC_OK, "")
//     end
//
//     grpc.RegisterMethod(srv, "/echo.Echo/Say", funcptr(say))
//
// A handler that sends nothing and sets no status still produces a
// well-formed reply (OK with no messages), so a forgotten Send can never
// leave a client hanging.
//
// Concurrency: connections are served one at a time, and the streams on
// a connection are served in the order their headers complete. The
// registry and the call slots are module-level state, and with no
// closures there is nowhere else for per-connection state to live, so a
// thread-per-connection server would serialise on a lock around all of
// it anyway. Streams still multiplex correctly on one connection, which
// is what gRPC clients actually rely on.

mut _methods := MethodTable {}
mut _calls := CallTable {}
mut _conn := http2.NewConn(http2.PlainTransport(0 - 1), true)
mut _conn_live := false

@en "Server"
@fa "سرور جی آر پی سی"
@ar "خادم جی آر بی سی"
pub struct Server:
    pub port: int = 0
    pub listen_fd: i64 = 0 - 1
    pub running: bool = false
    pub served: int = 0
end

@en "NewServer"
@fa "سرور جدید"
@ar "خادم جدید"
pub func NewServer(port: int): Server:
    mut s := Server {}
    s.port = port
    ret s
end
