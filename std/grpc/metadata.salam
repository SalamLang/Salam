package grpc

import encoding
import net.http2

func _is_reserved(key: str): bool:
    if key.starts_with(":"): ret true end
    if key == "content-type": ret true end
    if key == "te": ret true end
    if key == "grpc-status": ret true end
    if key == "grpc-message": ret true end
    if key == "grpc-timeout": ret true end
    if key == "grpc-encoding": ret true end
    if key == "grpc-accept-encoding": ret true end
    if key == "user-agent": ret true end
    ret false
end

func _lower(s: str): str:
    ret s.lower()
end

func _valid_key(key: str): bool:
    n := key.Len()
    if n == 0: ret false end
    p := key as i8 *
    repeat n in i:
        c := (p[i] as int) & 255
        ok := (c >= 48 and c <= 57) or (c >= 97 and c <= 122) or c == 45 or c == 95 or c == 46
        if not ok: ret false end
    end
    ret true
end

func _valid_text(value: str): bool:
    p := value as i8 *
    repeat value.Len() in i:
        c := (p[i] as int) & 255
        if c < 32 or c > 126: ret false end
    end
    ret true
end

func _ends_bin(key: str): bool:
    ret key.ends_with("-bin")
end

@en "NewMetadata"
@fa "فراداده جدید"
pub func NewMetadata(): Metadata:
    ret Metadata {}
end

@en "MDAdd"
@fa "افزودن فراداده"
pub func MDAdd(md &: Metadata, key: str, value: str): bool:
    k := _lower(key)
    if not _valid_key(k) or not _valid_text(value): ret false end
    if _is_reserved(k) or _ends_bin(k): ret false end
    mut e := MDEntry {}
    e.key = k
    e.value = value
    md.items.push(e)
    ret true
end

@en "MDAddBinary"
@fa "افزودن فراداده دودویی"
pub func MDAddBinary(md &: Metadata, key: str, value: str): bool:
    k := _lower(key)
    if not _valid_key(k): ret false end
    if _is_reserved(k) or not _ends_bin(k): ret false end
    mut e := MDEntry {}
    e.key = k
    e.value = value
    e.binary = true
    md.items.push(e)
    ret true
end

@en "MDGet"
@fa "دریافت فراداده"
pub func MDGet(md: Metadata, key: str): str:
    k := _lower(key)
    mut i := 0
    until i < md.items.Len():
        e := md.items.get(i)
        if e.key == k: ret e.value end
        i++
    end
    ret ""
end

@en "MDHas"
@fa "فراداده دارد"
pub func MDHas(md: Metadata, key: str): bool:
    k := _lower(key)
    mut i := 0
    until i < md.items.Len():
        if md.items.get(i).key == k: ret true end
        i++
    end
    ret false
end

@en "MDGetAll"
@fa "دریافت همه فراداده"
pub func MDGetAll(md: Metadata, key: str): Vector<str>:
    k := _lower(key)
    mut out := Vector {} as Vector<str>
    mut i := 0
    until i < md.items.Len():
        e := md.items.get(i)
        if e.key == k: out.push(e.value) end
        i++
    end
    ret out
end

@en "MDCount"
@fa "تعداد فراداده"
pub func MDCount(md: Metadata): int:
    ret md.items.Len()
end

@en "MDKeyAt"
@fa "کلید فراداده"
pub func MDKeyAt(md: Metadata, i: int): str:
    if i < 0 or i >= md.items.Len(): ret "" end
    ret md.items.get(i).key
end

@en "MDValueAt"
@fa "مقدار فراداده"
pub func MDValueAt(md: Metadata, i: int): str:
    if i < 0 or i >= md.items.Len(): ret "" end
    ret md.items.get(i).value
end

@en "MDToHeaders"
@fa "فراداده به سرآیند"
pub func MDToHeaders(md: Metadata, hl &: http2.HeaderList):
    mut i := 0
    until i < md.items.Len():
        e := md.items.get(i)
        if e.binary:
            http2.HeadersAdd(hl, e.key, encoding.Base64Encode(e.value))
        else:
            http2.HeadersAdd(hl, e.key, e.value)
        end
        i++
    end
end

@en "MDFromHeaders"
@fa "فراداده از سرآیند"
pub func MDFromHeaders(hl: http2.HeaderList): Metadata:
    mut md := Metadata {}
    mut i := 0
    until i < hl.items.Len():
        h := hl.items.get(i)
        if not _is_reserved(h.name):
            mut e := MDEntry {}
            e.key = h.name
            if _ends_bin(h.name):
                e.binary = true
                try:
                    e.value = encoding.Base64Decode(h.value)
                catch:
                    e.value = h.value
                end
            else:
                e.value = h.value
            end
            md.items.push(e)
        end
        i++
    end
    ret md
end
