package grpc

import conv
import str

// The 17 gRPC status codes and the two headers that carry them:
// `grpc-status` (the numeric code) and `grpc-message` (a human-readable
// detail, percent-encoded because a trailer value must be printable
// US-ASCII).

func _hexdig(v: int): str:
    if v < 10: ret conv.FormatInt(v as i64) end
    if v == 10: ret "A" end
    if v == 11: ret "B" end
    if v == 12: ret "C" end
    if v == 13: ret "D" end
    if v == 14: ret "E" end
    ret "F"
end

func _hexval(c: int): int:
    if c >= 48 && c <= 57: ret c - 48 end
    if c >= 97 && c <= 102: ret c - 87 end
    if c >= 65 && c <= 70: ret c - 55 end
    ret 0 - 1
end

func _byte_of(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

func _chr(v: int): str:
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, v)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

@en "StatusName"
@fa "نام وضعیت"
@ar "اسم الحالة"
pub func StatusName(code: int): str:
    if code == GRPC_OK: ret "OK" end
    if code == GRPC_CANCELLED: ret "CANCELLED" end
    if code == GRPC_UNKNOWN: ret "UNKNOWN" end
    if code == GRPC_INVALID_ARGUMENT: ret "INVALID_ARGUMENT" end
    if code == GRPC_DEADLINE_EXCEEDED: ret "DEADLINE_EXCEEDED" end
    if code == GRPC_NOT_FOUND: ret "NOT_FOUND" end
    if code == GRPC_ALREADY_EXISTS: ret "ALREADY_EXISTS" end
    if code == GRPC_PERMISSION_DENIED: ret "PERMISSION_DENIED" end
    if code == GRPC_RESOURCE_EXHAUSTED: ret "RESOURCE_EXHAUSTED" end
    if code == GRPC_FAILED_PRECONDITION: ret "FAILED_PRECONDITION" end
    if code == GRPC_ABORTED: ret "ABORTED" end
    if code == GRPC_OUT_OF_RANGE: ret "OUT_OF_RANGE" end
    if code == GRPC_UNIMPLEMENTED: ret "UNIMPLEMENTED" end
    if code == GRPC_INTERNAL: ret "INTERNAL" end
    if code == GRPC_UNAVAILABLE: ret "UNAVAILABLE" end
    if code == GRPC_DATA_LOSS: ret "DATA_LOSS" end
    if code == GRPC_UNAUTHENTICATED: ret "UNAUTHENTICATED" end
    ret "UNKNOWN"
end

// Percent-encodes everything outside printable ASCII, plus '%' itself.
// gRPC calls this "Percent-Encoded" in its wire spec; it is not URL
// encoding (space stays a space, '+' has no special meaning).
@en "EncodeStatusMessage"
@fa "کدگذاری پیام وضعیت"
@ar "ترمیز رسالة الحالة"
pub func EncodeStatusMessage(msg: str): str:
    mut out := ""
    mut i := 0
    until i < msg.len():
        c := _byte_of(msg, i)
        if c < 32 || c > 126 || c == 37:
            out = out + "%" + _hexdig((c >> 4) & 15) + _hexdig(c & 15)
        else:
            out = out + _chr(c)
        end
        i += 1
    end
    ret out
end

@en "DecodeStatusMessage"
@fa "کدگشایی پیام وضعیت"
@ar "فک ترمیز رسالة الحالة"
pub func DecodeStatusMessage(msg: str): str:
    mut sb := str.NewBuilder()
    mut i := 0
    n := msg.len()
    until i < n:
        c := _byte_of(msg, i)
        if c == 37 && i + 2 < n:
            hi := _hexval(_byte_of(msg, i + 1))
            lo := _hexval(_byte_of(msg, i + 2))
            if hi >= 0 && lo >= 0:
                str.BufAppendChar(sb, hi * 16 + lo)
                i += 3
                continue
            end
        end
        str.BufAppendChar(sb, c)
        i += 1
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

@en "FormatStatusCode"
@fa "قالب‌بندی کد وضعیت"
@ar "تنسیق رمز الحالة"
pub func FormatStatusCode(code: int): str:
    ret conv.FormatInt(code as i64)
end

@en "ParseStatusCode"
@fa "تجزیه کد وضعیت"
@ar "تحلیل رمز الحالة"
pub func ParseStatusCode(text: str): int:
    if text == "": ret GRPC_UNKNOWN end
    mut n := 0
    mut i := 0
    mut any := false
    until i < text.len():
        c := _byte_of(text, i)
        if c < 48 || c > 57: break end
        n = n * 10 + (c - 48)
        any = true
        i += 1
    end
    if !any: ret GRPC_UNKNOWN end
    ret n
end

@en "StatusString"
@fa "متن وضعیت"
@ar "نص الحالة"
pub func StatusString(s: Status): str:
    if s.message == "": ret StatusName(s.code) end
    ret StatusName(s.code) + ": " + s.message
end
