@en "clipboard"
@fa "بریده‌دان"
package clipboard

import mem
import str
import io
import os
import os.shell

/*
 * Cross-platform clipboard access for native desktop apps (best-effort).
 *
 * Notes:
 * - Text clipboard is the primary supported path on all platforms.
 * - HTML/rich text and image clipboard operations are best-effort and may be
 *   unavailable depending on platform/runtime/tooling.
 * - Linux falls back to Wayland (wl-copy/wl-paste), X11 (xclip/xsel), and
 *   Termux clipboard tools when available.
 * - Headless or missing-backend environments return false/empty results.
 * - Snapshot/poll helpers are content-length/fingerprint hints, not OS events.
 */

mut _cb_last_error := ""
mut _cb_last_snapshot := ""

func _cb_set_error(msg: str):
    _cb_last_error = msg
end

func _cb_ok(): bool:
    _cb_last_error = ""
    ret true
end

@en "LastError"
@fa "آخرین خطا"
pub func LastError(): str:
    ret _cb_last_error
end

@en "Snapshot"
@fa "نمای لحظه‌ای"
pub func Snapshot(): str:
    // Best-effort change token based on clipboard text content.
    t := GetText()
    tok := str.Concat("text:", str.FromInt(t.Len() as i64))
    mem.Free(t as void*)
    ret tok
end

@en "HasChangedSince"
@fa "از زمان قبل تغییر کرده"
pub func HasChangedSince(previous_snapshot: str): bool:
    cur := Snapshot()
    defer mem.Free(cur as void*)
    if previous_snapshot.Len() == 0:
        ret cur.Len() > 0
    end
    ret cur != previous_snapshot
end

@en "PollChanged"
@fa "بررسی تغییر"
pub func PollChanged(): bool:
    cur := Snapshot()
    changed := _cb_last_snapshot.Len() == 0 or cur != _cb_last_snapshot
    if _cb_last_snapshot.Len() > 0:
        mem.Free(_cb_last_snapshot as void*)
    end
    _cb_last_snapshot = cur
    ret changed
end

if SALAM_OS_WINDOWS:
    link dynamic "user32"
    link dynamic "kernel32"

    extern:
        func OpenClipboard(hwnd: void*): int
        func CloseClipboard(): int
        func EmptyClipboard(): int
        func IsClipboardFormatAvailable(format: u32): int
        func GetClipboardData(format: u32): void*
        func SetClipboardData(format: u32, handle: void*): void*
        func GlobalAlloc(flags: u32, bytes: u64): void*
        func GlobalLock(handle: void*): void*
        func GlobalUnlock(handle: void*): int
        func GlobalFree(handle: void*): void*
        func GlobalSize(handle: void*): u64
        func MultiByteToWideChar(code_page: u32, flags: u32, src: str, src_len: int, dst: void*, dst_len: int): int
        func WideCharToMultiByte(code_page: u32, flags: u32, src: void*, src_len: int, dst: void*, dst_len: int, def_char: void*, used: void*): int
    end

    const _CF_UNICODETEXT := 13 as u32
    const _CF_DIB := 8 as u32
    const _GMEM_MOVEABLE := 2 as u32
    const _CP_UTF8 := 65001 as u32

    func _wide(s: str): void*:
        needed := MultiByteToWideChar(_CP_UTF8, 0 as u32, s, 0 - 1, null, 0)
        if needed <= 0:
            ret null
        end
        bytes := ((needed + 1) as u64) * 2 as u64
        buf := mem.AllocateZeroed(bytes)
        MultiByteToWideChar(_CP_UTF8, 0 as u32, s, 0 - 1, buf, needed + 1)
        ret buf
    end

    func _narrow(wide: void*): str:
        if wide == null:
            ret str.Clone("")
        end
        needed := WideCharToMultiByte(_CP_UTF8, 0 as u32, wide, 0 - 1, null, 0, null, null)
        if needed <= 0:
            ret str.Clone("")
        end
        buf := mem.AllocateZeroed((needed + 1) as u64)
        WideCharToMultiByte(_CP_UTF8, 0 as u32, wide, 0 - 1, buf, needed + 1, null, null)
        ret buf as str
    end

    @en "GetText"
    @fa "گرفتن متن"
    pub func GetText(): str:
        if OpenClipboard(null) == 0:
            _cb_set_error("OpenClipboard failed")
            ret str.Clone("")
        end
        defer _closed := CloseClipboard()
        handle := GetClipboardData(_CF_UNICODETEXT)
        if handle == null:
            _cb_ok()
            ret str.Clone("")
        end
        locked := GlobalLock(handle)
        if locked == null:
            _cb_set_error("GlobalLock failed")
            ret str.Clone("")
        end
        text := _narrow(locked)
        GlobalUnlock(handle)
        _cb_ok()
        ret text
    end

    @en "SetText"
    @fa "تنظیم متن"
    pub func SetText(text: str): bool:
        wide := _wide(text)
        if wide == null:
            _cb_set_error("UTF-16 conversion failed")
            ret false
        end
        // Compute byte length of UTF-16 string including terminator.
        mut chars := 0
        p := wide as u16*
        until p[chars] == (0 as u16):
            chars++
        end
        bytes := ((chars + 1) as u64) * 2 as u64
        hmem := GlobalAlloc(_GMEM_MOVEABLE, bytes)
        if hmem == null:
            mem.Free(wide)
            _cb_set_error("GlobalAlloc failed")
            ret false
        end
        locked := GlobalLock(hmem)
        if locked == null:
            GlobalFree(hmem)
            mem.Free(wide)
            _cb_set_error("GlobalLock failed")
            ret false
        end
        mem.Copy(locked, wide, bytes)
        GlobalUnlock(hmem)
        mem.Free(wide)

        if OpenClipboard(null) == 0:
            GlobalFree(hmem)
            _cb_set_error("OpenClipboard failed")
            ret false
        end
        EmptyClipboard()
        if SetClipboardData(_CF_UNICODETEXT, hmem) == null:
            CloseClipboard()
            GlobalFree(hmem)
            _cb_set_error("SetClipboardData failed")
            ret false
        end
        CloseClipboard()
        ret _cb_ok()
    end

    @en "HasText"
    @fa "متن دارد"
    pub func HasText(): bool:
        ret IsClipboardFormatAvailable(_CF_UNICODETEXT) != 0
    end

    @en "Clear"
    @fa "پاک کردن"
    pub func Clear(): bool:
        if OpenClipboard(null) == 0:
            _cb_set_error("OpenClipboard failed")
            ret false
        end
        ok := EmptyClipboard() != 0
        CloseClipboard()
        if not ok:
            _cb_set_error("EmptyClipboard failed")
            ret false
        end
        ret _cb_ok()
    end

    @en "GetHTML"
    @fa "گرفتن اچ‌تی‌ام‌ال"
    pub func GetHTML(): str:
        // Best-effort: HTML clipboard format registration/CF_HTML parsing not wired in this build.
        _cb_set_error("HTML clipboard read is not implemented on Windows in this build")
        ret str.Clone("")
    end

    @en "SetHTML"
    @fa "تنظیم اچ‌تی‌ام‌ال"
    pub func SetHTML(_html: str, _alt_text: str = ""): bool:
        _cb_set_error("HTML clipboard write is not implemented on Windows in this build")
        ret false
    end

    @en "HasHTML"
    @fa "اچ‌تی‌ام‌ال دارد"
    pub func HasHTML(): bool:
        ret false
    end

    @en "GetImageBytes"
    @fa "گرفتن بایت‌های تصویر"
    pub func GetImageBytes(): str:
        // Best-effort placeholder: CF_DIB/PNG extraction requires format synthesis/parsing.
        _cb_set_error("GetImageBytes is not implemented on Windows in this build")
        ret str.Clone("")
    end

    @en "SetImageBytes"
    @fa "تنظیم بایت‌های تصویر"
    pub func SetImageBytes(_data: str, _mime: str = "image/png"): bool:
        _cb_set_error("SetImageBytes is not implemented on Windows in this build")
        ret false
    end

    @en "GetImagePath"
    @fa "گرفتن مسیر تصویر"
    pub func GetImagePath(): str:
        _cb_set_error("Image path clipboard read is not implemented on Windows in this build")
        ret str.Clone("")
    end

    @en "SetImagePath"
    @fa "تنظیم مسیر تصویر"
    pub func SetImagePath(_path: str): bool:
        _cb_set_error("Image path clipboard write is not implemented on Windows in this build")
        ret false
    end

    @en "Backend"
    @fa "پشتوانه"
    pub func Backend(): str:
        ret str.Clone("win32")
    end
end

if SALAM_OS_MAC:
    link framework "AppKit"

    extern:
        func objc_getClass(name: str): void*
        func sel_registerName(name: str): void*
        func objc_msgSend(): void
    end

    func _objc0(recv: void*, name: str): void*:
        fn := (&objc_msgSend) as extern func (void*, void*) void*
        ret fn(recv, sel_registerName(name))
    end

    func _objc1(recv: void*, name: str, a1: void*): void*:
        fn := (&objc_msgSend) as extern func (void*, void*, void*) void*
        ret fn(recv, sel_registerName(name), a1)
    end

    func _objc2(recv: void*, name: str, a1: void*, a2: void*): void*:
        fn := (&objc_msgSend) as extern func (void*, void*, void*, void*) void*
        ret fn(recv, sel_registerName(name), a1, a2)
    end

    func _ns(s: str): void*:
        fn := (&objc_msgSend) as extern func (void*, void*, str) void*
        ret fn(objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), s)
    end

    func _utf8(v: void*): str:
        if v == null:
            ret str.Clone("")
        end
        fn := (&objc_msgSend) as extern func (void*, void*) str
        ret str.Clone(fn(v, sel_registerName("UTF8String")))
    end

    func _pasteboard(): void*:
        ret _objc0(objc_getClass("NSPasteboard"), "generalPasteboard")
    end

    @en "GetText"
    @fa "گرفتن متن"
    pub func GetText(): str:
        pb := _pasteboard()
        if pb == null:
            _cb_set_error("NSPasteboard unavailable")
            ret str.Clone("")
        end
        ty := _ns("public.utf8-plain-text")
        val := _objc1(pb, "stringForType:", ty)
        if val == null:
            ty = _ns("NSStringPboardType")
            val = _objc1(pb, "stringForType:", ty)
        end
        _cb_ok()
        ret _utf8(val)
    end

    @en "SetText"
    @fa "تنظیم متن"
    pub func SetText(text: str): bool:
        pb := _pasteboard()
        if pb == null:
            _cb_set_error("NSPasteboard unavailable")
            ret false
        end
        _objc0(pb, "clearContents")
        ty := _ns("public.utf8-plain-text")
        ns_text := _ns(text)
        fn := (&objc_msgSend) as extern func (void*, void*, void*, void*) i8
        ok := fn(pb, sel_registerName("setString:forType:"), ns_text, ty)
        if ok == (0 as i8):
            _cb_set_error("setString:forType failed")
            ret false
        end
        ret _cb_ok()
    end

    @en "HasText"
    @fa "متن دارد"
    pub func HasText(): bool:
        pb := _pasteboard()
        if pb == null:
            ret false
        end
        types := _objc0(pb, "types")
        if types == null:
            ret false
        end
        ty := _ns("public.utf8-plain-text")
        fn := (&objc_msgSend) as extern func (void*, void*, void*) i8
        ret fn(types, sel_registerName("containsObject:"), ty) != (0 as i8)
    end

    @en "Clear"
    @fa "پاک کردن"
    pub func Clear(): bool:
        pb := _pasteboard()
        if pb == null:
            _cb_set_error("NSPasteboard unavailable")
            ret false
        end
        _objc0(pb, "clearContents")
        ret _cb_ok()
    end

    @en "GetHTML"
    @fa "گرفتن اچ‌تی‌ام‌ال"
    pub func GetHTML(): str:
        pb := _pasteboard()
        if pb == null:
            _cb_set_error("NSPasteboard unavailable")
            ret str.Clone("")
        end
        ty := _ns("public.html")
        val := _objc1(pb, "stringForType:", ty)
        if val == null:
            ty = _ns("Apple HTML pasteboard type")
            val = _objc1(pb, "stringForType:", ty)
        end
        _cb_ok()
        ret _utf8(val)
    end

    @en "SetHTML"
    @fa "تنظیم اچ‌تی‌ام‌ال"
    pub func SetHTML(html: str, alt_text: str = ""): bool:
        pb := _pasteboard()
        if pb == null:
            _cb_set_error("NSPasteboard unavailable")
            ret false
        end
        _objc0(pb, "clearContents")
        fn := (&objc_msgSend) as extern func (void*, void*, void*, void*) i8
        ok_html := fn(pb, sel_registerName("setString:forType:"), _ns(html), _ns("public.html"))
        if ok_html == (0 as i8):
            _ = fn(pb, sel_registerName("setString:forType:"), _ns(html), _ns("Apple HTML pasteboard type"))
        end
        if alt_text.Len() > 0:
            _ = fn(pb, sel_registerName("setString:forType:"), _ns(alt_text), _ns("public.utf8-plain-text"))
        end
        ret _cb_ok()
    end

    @en "HasHTML"
    @fa "اچ‌تی‌ام‌ال دارد"
    pub func HasHTML(): bool:
        h := GetHTML()
        has := h.Len() > 0
        mem.Free(h as void*)
        ret has
    end

    @en "GetImageBytes"
    @fa "گرفتن بایت‌های تصویر"
    pub func GetImageBytes(): str:
        _cb_set_error("GetImageBytes is not implemented on macOS in this build (use GetImagePath where possible)")
        ret str.Clone("")
    end

    @en "SetImageBytes"
    @fa "تنظیم بایت‌های تصویر"
    pub func SetImageBytes(_data: str, _mime: str = "image/png"): bool:
        _cb_set_error("SetImageBytes is not implemented on macOS in this build (use SetImagePath where possible)")
        ret false
    end

    @en "GetImagePath"
    @fa "گرفتن مسیر تصویر"
    pub func GetImagePath(): str:
        _cb_set_error("Image path clipboard read is not implemented on macOS in this build")
        ret str.Clone("")
    end

    @en "SetImagePath"
    @fa "تنظیم مسیر تصویر"
    pub func SetImagePath(_path: str): bool:
        _cb_set_error("Image path clipboard write is not implemented on macOS in this build")
        ret false
    end

    @en "Backend"
    @fa "پشتوانه"
    pub func Backend(): str:
        ret str.Clone("appkit")
    end
end

if SALAM_OS_LINUX or SALAM_OS_FREEBSD or SALAM_OS_ANDROID or SALAM_OS_WASM:
    func _has_cmd(name: str): bool:
        r := shell.Exec("command -v " + name + " >/dev/null 2>&1")
        ret r.code == 0
    end

    func _run_sh(script: str): shell.CmdResult:
        mut args := Vector {} as Vector<str>
        defer args.Free()
        args.Push("-c")
        args.Push(script)
        ret shell.Run("/bin/sh", args)
    end

    func _run_with_stdin(script: str, text: str): shell.CmdResult:
        // Best-effort: write text to a temp file and redirect stdin.
        path := "/tmp/salam_clipboard_in.txt"
        _w := io.WriteFile(path, text)
        defer _r := os.Remove(path)
        ret _run_sh(script + " < " + path)
    end

    @en "GetText"
    @fa "گرفتن متن"
    pub func GetText(): str:
        mut r := shell.CmdResult { code = 127 }
        if os.Env("WAYLAND_DISPLAY").Len() > 0 and _has_cmd("wl-paste"):
            r = _run_sh("wl-paste --no-newline 2>/dev/null")
            if r.code == 0:
                _cb_ok()
                ret r.out
            end
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xclip"):
            r = _run_sh("xclip -selection clipboard -o 2>/dev/null")
            if r.code == 0:
                _cb_ok()
                ret r.out
            end
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xsel"):
            r = _run_sh("xsel --clipboard --output 2>/dev/null")
            if r.code == 0:
                _cb_ok()
                ret r.out
            end
        end
        _cb_set_error("No clipboard backend available (need wl-paste, xclip, or xsel)")
        ret str.Clone("")
    end

    @en "SetText"
    @fa "تنظیم متن"
    pub func SetText(text: str): bool:
        mut r := shell.CmdResult { code = 127 }
        if os.Env("WAYLAND_DISPLAY").Len() > 0 and _has_cmd("wl-copy"):
            r = _run_with_stdin("wl-copy 2>/dev/null", text)
            if r.code == 0:
                ret _cb_ok()
            end
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xclip"):
            r = _run_with_stdin("xclip -selection clipboard 2>/dev/null", text)
            if r.code == 0:
                ret _cb_ok()
            end
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xsel"):
            r = _run_with_stdin("xsel --clipboard --input 2>/dev/null", text)
            if r.code == 0:
                ret _cb_ok()
            end
        end
        _cb_set_error("No clipboard backend available (need wl-copy, xclip, or xsel)")
        ret false
    end

    @en "HasText"
    @fa "متن دارد"
    pub func HasText(): bool:
        t := GetText()
        has := t.Len() > 0
        if t.Len() > 0:
            mem.Free(t as void*)
        end
        ret has
    end

    @en "Clear"
    @fa "پاک کردن"
    pub func Clear(): bool:
        if os.Env("WAYLAND_DISPLAY").Len() > 0 and _has_cmd("wl-copy"):
            r := _run_sh("wl-copy --clear 2>/dev/null || printf '' | wl-copy 2>/dev/null")
            if r.code == 0:
                ret _cb_ok()
            end
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xclip"):
            r := _run_sh("printf '' | xclip -selection clipboard 2>/dev/null")
            if r.code == 0:
                ret _cb_ok()
            end
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xsel"):
            r := _run_sh("xsel --clipboard --clear 2>/dev/null")
            if r.code == 0:
                ret _cb_ok()
            end
        end
        _cb_set_error("No clipboard backend available to clear")
        ret false
    end

    @en "GetHTML"
    @fa "گرفتن اچ‌تی‌ام‌ال"
    pub func GetHTML(): str:
        mut r := shell.CmdResult { code = 127 }
        if os.Env("WAYLAND_DISPLAY").Len() > 0 and _has_cmd("wl-paste"):
            r = _run_sh("wl-paste --type text/html 2>/dev/null")
            if r.code == 0:
                _cb_ok()
                ret r.out
            end
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xclip"):
            r = _run_sh("xclip -selection clipboard -t text/html -o 2>/dev/null")
            if r.code == 0:
                _cb_ok()
                ret r.out
            end
        end
        _cb_set_error("No clipboard backend available for HTML (need wl-paste or xclip)")
        ret str.Clone("")
    end

    @en "SetHTML"
    @fa "تنظیم اچ‌تی‌ام‌ال"
    pub func SetHTML(html: str, _alt_text: str = ""): bool:
        mut r := shell.CmdResult { code = 127 }
        if os.Env("WAYLAND_DISPLAY").Len() > 0 and _has_cmd("wl-copy"):
            r = _run_with_stdin("wl-copy --type text/html 2>/dev/null", html)
            if r.code == 0:
                ret _cb_ok()
            end
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xclip"):
            r = _run_with_stdin("xclip -selection clipboard -t text/html 2>/dev/null", html)
            if r.code == 0:
                ret _cb_ok()
            end
        end
        _cb_set_error("No clipboard backend available for HTML (need wl-copy or xclip)")
        ret false
    end

    @en "HasHTML"
    @fa "اچ‌تی‌ام‌ال دارد"
    pub func HasHTML(): bool:
        h := GetHTML()
        has := h.Len() > 0
        mem.Free(h as void*)
        ret has
    end

    @en "GetImageBytes"
    @fa "گرفتن بایت‌های تصویر"
    pub func GetImageBytes(): str:
        // Best-effort: try to fetch PNG from Wayland clipboard into memory-like temp file and read.
        if os.Env("WAYLAND_DISPLAY").Len() > 0 and _has_cmd("wl-paste"):
            path := "/tmp/salam_clipboard_img.png"
            r := _run_sh("wl-paste --type image/png > " + path + " 2>/dev/null")
            if r.code == 0 and os.Exists(path):
                data := io.ReadFile(path)
                _ = os.Remove(path)
                _cb_ok()
                ret data
            end
            _ = os.Remove(path)
        end
        _cb_set_error("GetImageBytes is not available (Wayland wl-paste image/png required for best-effort read)")
        ret str.Clone("")
    end

    @en "SetImageBytes"
    @fa "تنظیم بایت‌های تصویر"
    pub func SetImageBytes(data: str, mime: str = "image/png"): bool:
        path := "/tmp/salam_clipboard_img.bin"
        written := io.WriteFile(path, data)
        if written < 0:
            _cb_set_error("Failed to stage image bytes for clipboard")
            ret false
        end
        mut ok := false
        if os.Env("WAYLAND_DISPLAY").Len() > 0 and _has_cmd("wl-copy"):
            r := _run_sh("wl-copy --type " + mime + " < " + path + " 2>/dev/null")
            ok = r.code == 0
        else os.Env("DISPLAY").Len() > 0 and _has_cmd("xclip"):
            r := _run_sh("xclip -selection clipboard -t " + mime + " -i " + path + " 2>/dev/null")
            ok = r.code == 0
        end
        _ = os.Remove(path)
        if not ok:
            _cb_set_error("No clipboard backend available for image bytes (need wl-copy or xclip)")
            ret false
        end
        ret _cb_ok()
    end

    @en "GetImagePath"
    @fa "گرفتن مسیر تصویر"
    pub func GetImagePath(): str:
        t := GetText()
        if t.Len() > 0 and os.Exists(str.Trim(t)):
            _cb_ok()
            ret str.Trim(t)
        end
        mem.Free(t as void*)
        _cb_set_error("No image path detected in clipboard text")
        ret str.Clone("")
    end

    @en "SetImagePath"
    @fa "تنظیم مسیر تصویر"
    pub func SetImagePath(path: str): bool:
        if not os.Exists(path):
            _cb_set_error("Image path does not exist")
            ret false
        end
        data := io.ReadFile(path)
        mut mime := "image/png"
        low := str.ToLower(path)
        if str.EndsWith(low, ".jpg") or str.EndsWith(low, ".jpeg"):
            mime = "image/jpeg"
        else str.EndsWith(low, ".gif"):
            mime = "image/gif"
        else str.EndsWith(low, ".webp"):
            mime = "image/webp"
        end
        ok := SetImageBytes(data, mime)
        mem.Free(data as void*)
        mem.Free(low as void*)
        if ok:
            _ = SetText(path)
        end
        ret ok
    end

    @en "Backend"
    @fa "پشتوانه"
    pub func Backend(): str:
        if os.Env("WAYLAND_DISPLAY").Len() > 0 and (_has_cmd("wl-copy") or _has_cmd("wl-paste")):
            ret str.Clone("wayland-wl-clipboard")
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xclip"):
            ret str.Clone("x11-xclip")
        end
        if os.Env("DISPLAY").Len() > 0 and _has_cmd("xsel"):
            ret str.Clone("x11-xsel")
        end
        if _has_cmd("termux-clipboard-get") or _has_cmd("termux-clipboard-set"):
            ret str.Clone("termux")
        end
        ret str.Clone("none")
    end
end

@en "IsSupported"
@fa "پشتیبانی می‌شود"
pub func IsSupported(): bool:
    b := Backend()
    ok := b != "none"
    mem.Free(b as void*)
    ret ok
end

@en "CapabilityStatus"
@fa "وضعیت قابلیت"
pub func CapabilityStatus(): str:
    b := Backend()
    mut s := "backend=" + b
    s = s + ", text=true"
    s = s + ", html=best-effort"
    mem.Free(b as void*)
    ret s
end

@en "SetRichText"
@fa "تنظیم متن غنی"
pub func SetRichText(html: str, alt_text: str = ""): bool:
    ret SetHTML(html, alt_text)
end

@en "GetRichText"
@fa "گرفتن متن غنی"
pub func GetRichText(): str:
    ret GetHTML()
end
