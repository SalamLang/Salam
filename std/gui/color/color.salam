@en "color"
@fa "رنگ"
package color

import str
import math

@en "Color"
@fa "رنگ"
pub struct Color:
    @en "r"
    @fa "قرمز"
    pub r: f64 = 0.0
    @en "g"
    @fa "سبز"
    pub g: f64 = 0.0
    @en "b"
    @fa "آبی"
    pub b: f64 = 0.0
    @en "a"
    @fa "آلفا"
    pub a: f64 = 1.0
    @en "current"
    @fa "کنونی"
    pub current: bool = false
    @en "has_dark"
    @fa "دارای تیره"
    pub has_dark: bool = false
    @en "dark_r"
    @fa "قرمز تیره"
    pub dark_r: f64 = 0.0
    @en "dark_g"
    @fa "سبز تیره"
    pub dark_g: f64 = 0.0
    @en "dark_b"
    @fa "آبی تیره"
    pub dark_b: f64 = 0.0
    @en "dark_a"
    @fa "آلفای تیره"
    pub dark_a: f64 = 1.0
    @en "dark_current"
    @fa "کنونی تیره"
    pub dark_current: bool = false
end

func _gc_color_of(v: _GcV3, a: f64): Color:
    ret Color { r = v.x, g = v.y, b = v.z, a = a }
end

func _gc_rgb_of(c: Color): _GcV3:
    ret _gc_v3(c.r, c.g, c.b)
end

func _gc_clamp01(v: f64): f64:
    if v != v or v < 0.0:
        ret 0.0
    end
    if v > 1.0:
        ret 1.0
    end
    ret v
end

func _gc_byte(v: f64): int:
    ret math.Floor(_gc_clamp01(v) * 255.0 + 0.5) as int
end

func _gc_fmt(v: f64, digits: int): str:
    mut scale := 1.0
    repeat digits:
        scale *= 10.0
    end
    if v != v:
        ret str.Clone("0")
    end
    x := math.Floor(math.Abs(v) * scale + 0.5)
    if x >= 9.0e15:
        ret str.FromInt((v as i64))
    end
    n := x as i64
    sc := scale as i64
    ip := n / sc
    mut fp := n % sc
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    if v < 0.0 and n > 0:
        str.BufAppendChar(sb, 45)
    end
    str.BufAppendInt(sb, ip)
    if fp > 0:
        mut w := digits
        until fp % 10 == 0:
            fp /= 10
            w--
        end
        str.BufAppendChar(sb, 46)
        digs := str.FromInt(fp)
        repeat w - digs.len():
            str.BufAppendChar(sb, 48)
        end
        str.BufAppend(sb, digs)
        _gc_free(digs)
    end
    ret str.BufStr(sb)
end

func _gc_hex2(sb &: str.StringBuilder, v: int):
    h := "0123456789abcdef"
    str.BufAppendChar(sb, h[v / 16] as int)
    str.BufAppendChar(sb, h[v % 16] as int)
end

func _gc_in(v: f64, eps: f64): bool:
    ret v >= 0.0 - eps and v <= 1.0 + eps
end

func _gc_in_srgb(c: Color): bool:
    eps := 0.5 / 255.0
    ret _gc_in(c.r, eps) and _gc_in(c.g, eps) and _gc_in(c.b, eps)
end

func _gc_css1(c: Color): str:
    if c.current:
        ret str.Clone("currentColor")
    end
    al := _gc_clamp01(c.a)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    if _gc_in_srgb(c):
        str.BufAppendChar(sb, 35)
        _gc_hex2(sb, _gc_byte(c.r))
        _gc_hex2(sb, _gc_byte(c.g))
        _gc_hex2(sb, _gc_byte(c.b))
        if _gc_byte(al) < 255:
            _gc_hex2(sb, _gc_byte(al))
        end
        ret str.BufStr(sb)
    end
    p3 := _gc_xyz_to_space(_gc_srgb_to_xyz(_gc_rgb_of(c)), _GC_P3)
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    if _gc_in(p3.x, 0.0001) and _gc_in(p3.y, 0.0001) and _gc_in(p3.z, 0.0001):
        str.BufAppend(sb, "color(display-p3 ")
        parts.push(_gc_fmt(_gc_clamp01(p3.x), 4))
        parts.push(_gc_fmt(_gc_clamp01(p3.y), 4))
        parts.push(_gc_fmt(_gc_clamp01(p3.z), 4))
    else:
        o := _gc_to_space(_gc_rgb_of(c), _GC_OKLCH)
        str.BufAppend(sb, "oklch(")
        parts.push(_gc_fmt(o.x, 4))
        parts.push(_gc_fmt(o.y, 4))
        parts.push(_gc_fmt(o.z, 2))
    end
    each i, s in parts:
        if i > 0:
            str.BufAppendChar(sb, 32)
        end
        str.BufAppend(sb, s)
        _gc_free(s)
    end
    if al < 1.0:
        str.BufAppend(sb, " / ")
        as_text := _gc_fmt(al, 4)
        str.BufAppend(sb, as_text)
        _gc_free(as_text)
    end
    str.BufAppendChar(sb, 41)
    ret str.BufStr(sb)
end

func _gc_exact_byte(v: f64): bool:
    x := v * 255.0
    ret v >= 0.0 and v <= 1.0 and math.Abs(x - math.Floor(x + 0.5)) < 1.0e-6
end

func _gc_source1(c: Color): str:
    if c.current:
        ret str.Clone("color.Current()")
    end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    exact := _gc_exact_byte(c.r) and _gc_exact_byte(c.g) and _gc_exact_byte(c.b)
    if exact:
        str.BufAppend(sb, c.a == 1.0 ? "color.Rgb(" : "color.Rgba(")
        str.BufAppendInt(sb, _gc_byte(c.r) as i64)
        str.BufAppend(sb, ", ")
        str.BufAppendInt(sb, _gc_byte(c.g) as i64)
        str.BufAppend(sb, ", ")
        str.BufAppendInt(sb, _gc_byte(c.b) as i64)
        if c.a != 1.0:
            str.BufAppend(sb, ", ")
            t := _gc_fmt_f(c.a)
            str.BufAppend(sb, t)
            _gc_free(t)
        end
        str.BufAppendChar(sb, 41)
        ret str.BufStr(sb)
    end
    str.BufAppend(sb, "color.New(")
    each i, v in [c.r, c.g, c.b, c.a]:
        if i > 0:
            str.BufAppend(sb, ", ")
        end
        t := _gc_fmt_f(v)
        str.BufAppend(sb, t)
        _gc_free(t)
    end
    str.BufAppendChar(sb, 41)
    ret str.BufStr(sb)
end

func _gc_fmt_f(v: f64): str:
    t := _gc_fmt(v, 9)
    if str.Contains(t, "."):
        ret t
    end
    r := t + ".0"
    _gc_free(t)
    ret r
end

func _gc_mix1(a: Color, b: Color, t: f64, sp: int): Color:
    if a.current or b.current:
        if t < 0.5:
            ret a
        end
        ret b
    end
    mut ca := _gc_to_space(_gc_rgb_of(a), sp)
    mut cb := _gc_to_space(_gc_rgb_of(b), sp)
    hi := _gc_hue_index(sp)
    if hi >= 0:
        na := _gc_achromatic(ca, sp)
        nb := _gc_achromatic(cb, sp)
        if na and not nb:
            _gc_set(ca, hi, _gc_get(cb, hi))
        else nb and not na:
            _gc_set(cb, hi, _gc_get(ca, hi))
        end
        ha := _gc_get(ca, hi)
        hb := _gc_get(cb, hi)
        if hb - ha > 180.0:
            _gc_set(ca, hi, ha + 360.0)
        else hb - ha < -180.0:
            _gc_set(cb, hi, hb + 360.0)
        end
    end
    aa := _gc_clamp01(a.a)
    ab := _gc_clamp01(b.a)
    al := aa + (ab - aa) * t
    mut out := _gc_v3(0.0, 0.0, 0.0)
    repeat 3 in k:
        x := _gc_get(ca, k)
        y := _gc_get(cb, k)
        mut v := x + (y - x) * t
        if k != hi and al > 0.0:
            v = (x * aa + (y * ab - x * aa) * t) / al
        end
        if k == hi:
            v = _gc_wrap_hue(v)
        end
        _gc_set(out, k, v)
    end
    ret _gc_color_of(_gc_from_space(out, sp), _gc_clamp01(al))
end

func _gc_mix_space(a: Color, b: Color, t: f64, sp: int): Color:
    if not a.has_dark and not b.has_dark:
        ret _gc_mix1(a, b, t, sp)
    end
    ret LightDark(_gc_mix1(Light(a), Light(b), t, sp), _gc_mix1(Dark(a), Dark(b), t, sp))
end

func _gc_shift_l(c: Color, amount: f64): Color:
    if c.current:
        ret c
    end
    mut o := _gc_to_space(_gc_rgb_of(c), _GC_OKLCH)
    o.x = _gc_clamp01(o.x + amount)
    ret _gc_color_of(_gc_from_space(o, _GC_OKLCH), c.a)
end

func _gc_lum_ch(v: f64): f64:
    x := _gc_clamp01(v)
    if x <= 0.04045:
        ret x / 12.92
    end
    ret math.Pow((x + 0.055) / 1.055, 2.4)
end

func _gc_same(x: f64, y: f64): bool:
    ret math.Abs(x - y) < 1.0e-7
end

@en "Parse"
@fa "تجزیه"
pub func Parse(text: str, out &: Color): bool:
    mut err := ""
    ret _gc_parse(text, out, err)
end

@en "Error"
@fa "خطا"
pub func Error(text: str): str:
    mut err := ""
    mut c := Color {}
    if _gc_parse(text, c, err):
        ret str.Clone("")
    end
    ret err
end

@en "New"
@fa "تازه"
pub func New(r: f64, g: f64, b: f64, a: f64): Color:
    ret Color { r = r, g = g, b = b, a = a }
end

@en "Rgb"
@fa "آر جی بی"
pub func Rgb(r: int, g: int, b: int): Color:
    ret Color { r = r as f64 / 255.0, g = g as f64 / 255.0, b = b as f64 / 255.0 }
end

@en "Rgba"
@fa "آر جی بی آلفا"
pub func Rgba(r: int, g: int, b: int, a: f64): Color:
    ret Color { r = r as f64 / 255.0, g = g as f64 / 255.0, b = b as f64 / 255.0, a = a }
end

@en "Hex"
@fa "هگز"
pub func Hex(v: int): Color:
    ret Rgb((v >> 16) & 255, (v >> 8) & 255, v & 255)
end

@en "FromArgb"
@fa "از ای آر جی بی"
pub func FromArgb(v: u32): Color:
    a := ((v >> 24) & (255 as u32)) as int
    r := ((v >> 16) & (255 as u32)) as int
    g := ((v >> 8) & (255 as u32)) as int
    b := (v & (255 as u32)) as int
    ret Rgba(r, g, b, a as f64 / 255.0)
end

@en "Argb"
@fa "ای آر جی بی"
pub func Argb(c: Color): u32:
    if c.current:
        ret 0
    end
    a := _gc_byte(c.a) as u32
    r := _gc_byte(c.r) as u32
    g := _gc_byte(c.g) as u32
    b := _gc_byte(c.b) as u32
    ret (a << (24 as u32)) | (r << (16 as u32)) | (g << (8 as u32)) | b
end

@en "Hsl"
@fa "اچ اس ال"
pub func Hsl(h: f64, s: f64, l: f64): Color:
    ret _gc_color_of(_gc_hsl_to_srgb(_gc_v3(h, s, l)), 1.0)
end

@en "Hwb"
@fa "اچ دبلیو بی"
pub func Hwb(h: f64, w: f64, b: f64): Color:
    ret _gc_color_of(_gc_hwb_to_srgb(_gc_v3(h, w, b)), 1.0)
end

@en "Lab"
@fa "ال ای بی"
pub func Lab(l: f64, a: f64, b: f64): Color:
    ret _gc_color_of(_gc_from_space(_gc_v3(l, a, b), _GC_LAB), 1.0)
end

@en "Lch"
@fa "ال سی اچ"
pub func Lch(l: f64, c: f64, h: f64): Color:
    ret _gc_color_of(_gc_from_space(_gc_v3(l, c, h), _GC_LCH), 1.0)
end

@en "Oklab"
@fa "اوکی ال ای بی"
pub func Oklab(l: f64, a: f64, b: f64): Color:
    ret _gc_color_of(_gc_from_space(_gc_v3(l, a, b), _GC_OKLAB), 1.0)
end

@en "Oklch"
@fa "اوکی ال سی اچ"
pub func Oklch(l: f64, c: f64, h: f64): Color:
    ret _gc_color_of(_gc_from_space(_gc_v3(l, c, h), _GC_OKLCH), 1.0)
end

@en "Cmyk"
@fa "سی ام وای کی"
pub func Cmyk(c: f64, m: f64, y: f64, k: f64): Color:
    ret New((1.0 - c) * (1.0 - k), (1.0 - m) * (1.0 - k), (1.0 - y) * (1.0 - k), 1.0)
end

@en "WithAlpha"
@fa "با آلفا"
pub func WithAlpha(c: Color, a: f64): Color:
    mut r := c
    r.a = a
    if r.has_dark:
        r.dark_a = a
    end
    ret r
end

@en "Current"
@fa "رنگ کنونی"
pub func Current(): Color:
    ret Color { current = true }
end

@en "LightDark"
@fa "روشن تیره"
pub func LightDark(light: Color, dark: Color): Color:
    l := Light(light)
    d := Dark(dark)
    ret Color { r = l.r, g = l.g, b = l.b, a = l.a, current = l.current, has_dark = true, dark_r = d.r, dark_g = d.g, dark_b = d.b, dark_a = d.a, dark_current = d.current }
end

@en "Light"
@fa "روشن"
pub func Light(c: Color): Color:
    ret Color { r = c.r, g = c.g, b = c.b, a = c.a, current = c.current }
end

@en "Dark"
@fa "تیره"
pub func Dark(c: Color): Color:
    if not c.has_dark:
        ret Light(c)
    end
    ret Color { r = c.dark_r, g = c.dark_g, b = c.dark_b, a = c.dark_a, current = c.dark_current }
end

@en "HasDark"
@fa "تیره دارد"
pub func HasDark(c: Color): bool:
    ret c.has_dark
end

@en "Css"
@fa "سی اس اس"
pub func Css(c: Color): str:
    if not c.has_dark:
        ret _gc_css1(c)
    end
    l := _gc_css1(Light(c))
    d := _gc_css1(Dark(c))
    r := "light-dark(" + l + ", " + d + ")"
    _gc_free(l)
    _gc_free(d)
    ret r
end

@en "Source"
@fa "کد سلام"
pub func Source(c: Color): str:
    if not c.has_dark:
        ret _gc_source1(c)
    end
    l := _gc_source1(Light(c))
    d := _gc_source1(Dark(c))
    r := "color.LightDark(" + l + ", " + d + ")"
    _gc_free(l)
    _gc_free(d)
    ret r
end

@en "Mix"
@fa "آمیختن"
pub func Mix(a: Color, b: Color, amount: f64): Color:
    ret _gc_mix_space(a, b, _gc_clamp01(amount), _GC_OKLAB)
end

@en "MixIn"
@fa "آمیختن با فضا"
pub func MixIn(a: Color, b: Color, amount: f64, space: str): Color:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    cps := str.CodePoints(space)
    defer cps.free()
    each ch in cps:
        if ch != 32 and ch != 45 and ch != 95 and ch != 0x200C:
            str.BufAppendCp(sb, _gc_norm_cp(ch))
        end
    end
    key := str.BufStr(sb)
    defer _gc_free(key)
    mut sp := _gc_space_of_key(key, true)
    if sp < 0:
        sp = _GC_OKLAB
    end
    ret _gc_mix_space(a, b, _gc_clamp01(amount), sp)
end

@en "Lerp"
@fa "درون یابی"
pub func Lerp(a: Color, b: Color, t: f64): Color:
    ret _gc_mix_space(a, b, t, _GC_OKLAB)
end

@en "Luminance"
@fa "درخشندگی"
pub func Luminance(c: Color): f64:
    ret 0.2126 * _gc_lum_ch(c.r) + 0.7152 * _gc_lum_ch(c.g) + 0.0722 * _gc_lum_ch(c.b)
end

@en "Contrast"
@fa "نسبت تضاد"
pub func Contrast(a: Color, b: Color): f64:
    la := Luminance(a)
    lb := Luminance(b)
    if la > lb:
        ret (la + 0.05) / (lb + 0.05)
    end
    ret (lb + 0.05) / (la + 0.05)
end

@en "Lighten"
@fa "روشن تر"
pub func Lighten(c: Color, amount: f64): Color:
    if not c.has_dark:
        ret _gc_shift_l(c, amount)
    end
    ret LightDark(_gc_shift_l(Light(c), amount), _gc_shift_l(Dark(c), amount))
end

@en "Darken"
@fa "تیره تر"
pub func Darken(c: Color, amount: f64): Color:
    ret Lighten(c, 0.0 - amount)
end

@en "InGamut"
@fa "درون گستره"
pub func InGamut(c: Color): bool:
    if c.current:
        ret true
    end
    if c.has_dark and not c.dark_current and not _gc_in_srgb(Dark(c)):
        ret false
    end
    ret _gc_in_srgb(c)
end

@en "Equal"
@fa "یکسان"
pub func Equal(a: Color, b: Color): bool:
    if a.current != b.current or a.has_dark != b.has_dark:
        ret false
    end
    if not a.current and not (_gc_same(a.r, b.r) and _gc_same(a.g, b.g) and _gc_same(a.b, b.b) and _gc_same(a.a, b.a)):
        ret false
    end
    if not a.has_dark:
        ret true
    end
    if a.dark_current != b.dark_current:
        ret false
    end
    ret a.dark_current or (_gc_same(a.dark_r, b.dark_r) and _gc_same(a.dark_g, b.dark_g) and _gc_same(a.dark_b, b.dark_b) and _gc_same(a.dark_a, b.dark_a))
end
