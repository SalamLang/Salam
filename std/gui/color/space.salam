package color

import math

const _GC_SRGB := 0
const _GC_SRGB_LINEAR := 1
const _GC_P3 := 2
const _GC_A98 := 3
const _GC_PROPHOTO := 4
const _GC_REC2020 := 5
const _GC_XYZ_D50 := 6
const _GC_XYZ_D65 := 7
const _GC_LAB := 8
const _GC_LCH := 9
const _GC_OKLAB := 10
const _GC_OKLCH := 11
const _GC_HSL := 12
const _GC_HWB := 13

struct _GcV3:
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
end

func _gc_v3(x: f64, y: f64, z: f64): _GcV3:
    ret _GcV3 { x = x, y = y, z = z }
end

func _gc_sign(v: f64): f64:
    if v < 0.0:
        ret -1.0
    end
    ret 1.0
end

func _gc_srgb_lin(v: f64): f64:
    a := math.Abs(v)
    if a <= 0.04045:
        ret v / 12.92
    end
    ret _gc_sign(v) * math.Pow((a + 0.055) / 1.055, 2.4)
end

func _gc_srgb_enc(v: f64): f64:
    a := math.Abs(v)
    if a > 0.0031308:
        ret _gc_sign(v) * (1.055 * math.Pow(a, 1.0 / 2.4) - 0.055)
    end
    ret 12.92 * v
end

func _gc_a98_lin(v: f64): f64:
    ret _gc_sign(v) * math.Pow(math.Abs(v), 563.0 / 256.0)
end

func _gc_a98_enc(v: f64): f64:
    ret _gc_sign(v) * math.Pow(math.Abs(v), 256.0 / 563.0)
end

func _gc_pro_lin(v: f64): f64:
    a := math.Abs(v)
    if a <= 16.0 / 512.0:
        ret v / 16.0
    end
    ret _gc_sign(v) * math.Pow(a, 1.8)
end

func _gc_pro_enc(v: f64): f64:
    a := math.Abs(v)
    if a >= 1.0 / 512.0:
        ret _gc_sign(v) * math.Pow(a, 1.0 / 1.8)
    end
    ret 16.0 * v
end

func _gc_r2020_lin(v: f64): f64:
    al := 1.09929682680944
    be := 0.018053968510807
    a := math.Abs(v)
    if a < be * 4.5:
        ret v / 4.5
    end
    ret _gc_sign(v) * math.Pow((a + al - 1.0) / al, 1.0 / 0.45)
end

func _gc_r2020_enc(v: f64): f64:
    al := 1.09929682680944
    be := 0.018053968510807
    a := math.Abs(v)
    if a > be:
        ret _gc_sign(v) * (al * math.Pow(a, 0.45) - (al - 1.0))
    end
    ret 4.5 * v
end

func _gc_lin_srgb_to_xyz(v: _GcV3): _GcV3:
    ret _gc_v3(0.41239079926595934 * v.x + 0.357584339383878 * v.y + 0.1804807884018343 * v.z, 0.21263900587151027 * v.x + 0.715168678767756 * v.y + 0.07219231536073371 * v.z, 0.01933081871559182 * v.x + 0.11919477979462598 * v.y + 0.9505321522496607 * v.z)
end

func _gc_xyz_to_lin_srgb(v: _GcV3): _GcV3:
    ret _gc_v3(3.2409699419045226 * v.x - 1.537383177570094 * v.y - 0.4986107602930034 * v.z, -0.9692436362808796 * v.x + 1.8759675015077202 * v.y + 0.04155505740717559 * v.z, 0.05563007969699366 * v.x - 0.20397695888897652 * v.y + 1.0569715142428786 * v.z)
end

func _gc_lin_p3_to_xyz(v: _GcV3): _GcV3:
    ret _gc_v3(0.4865709486482162 * v.x + 0.26566769316909306 * v.y + 0.1982172852343625 * v.z, 0.2289745640697488 * v.x + 0.6917385218365064 * v.y + 0.079286914093745 * v.z, 0.04511338185890264 * v.y + 1.043944368900976 * v.z)
end

func _gc_xyz_to_lin_p3(v: _GcV3): _GcV3:
    ret _gc_v3(2.493496911941425 * v.x - 0.9313836179191239 * v.y - 0.40271078445071684 * v.z, -0.8294889695615747 * v.x + 1.7626640603183463 * v.y + 0.023624685841943577 * v.z, 0.03584583024378447 * v.x - 0.07617238926804182 * v.y + 0.9568845240076872 * v.z)
end

func _gc_lin_a98_to_xyz(v: _GcV3): _GcV3:
    ret _gc_v3(0.5766690429101305 * v.x + 0.1855582379065463 * v.y + 0.1882286462349947 * v.z, 0.29734497525053605 * v.x + 0.6273635662554661 * v.y + 0.0752914584939978 * v.z, 0.02703136138641234 * v.x + 0.07068885253582723 * v.y + 0.9913375368376388 * v.z)
end

func _gc_xyz_to_lin_a98(v: _GcV3): _GcV3:
    ret _gc_v3(2.0415879038107465 * v.x - 0.5650069742788596 * v.y - 0.34473135077832956 * v.z, -0.9692436362808795 * v.x + 1.8759675015077202 * v.y + 0.04155505740717557 * v.z, 0.013444280632031142 * v.x - 0.11836239223101838 * v.y + 1.0151749943912054 * v.z)
end

func _gc_lin_2020_to_xyz(v: _GcV3): _GcV3:
    ret _gc_v3(0.6369580483012914 * v.x + 0.14461690358620832 * v.y + 0.1688809751641721 * v.z, 0.2627002120112671 * v.x + 0.6779980715188708 * v.y + 0.05930171646986196 * v.z, 0.028072693049087428 * v.y + 1.060985057710791 * v.z)
end

func _gc_xyz_to_lin_2020(v: _GcV3): _GcV3:
    ret _gc_v3(1.7166511879712674 * v.x - 0.35567078377639233 * v.y - 0.25336628137365974 * v.z, -0.6666843518324892 * v.x + 1.6164812366349395 * v.y + 0.01576854581391113 * v.z, 0.017639857445310783 * v.x - 0.042770613257808524 * v.y + 0.9421031212354738 * v.z)
end

func _gc_lin_pro_to_xyz50(v: _GcV3): _GcV3:
    ret _gc_v3(0.7977666449006423 * v.x + 0.13518129740053308 * v.y + 0.0313477341283922 * v.z, 0.2880748288194013 * v.x + 0.711835234241873 * v.y + 0.00008993693872564 * v.z, 0.8251046025104602 * v.z)
end

func _gc_xyz50_to_lin_pro(v: _GcV3): _GcV3:
    ret _gc_v3(1.3457868816471583 * v.x - 0.25557208737979464 * v.y - 0.05110186497554526 * v.z, -0.5446307051249019 * v.x + 1.5082477428451468 * v.y + 0.02052744743642139 * v.z, 1.2119675456389452 * v.z)
end

func _gc_d65_to_d50(v: _GcV3): _GcV3:
    ret _gc_v3(1.0479297925449969 * v.x + 0.022946870601609652 * v.y - 0.05019226628920524 * v.z, 0.02962780877005599 * v.x + 0.9904344267538799 * v.y - 0.017073799063418826 * v.z, -0.009243040646204504 * v.x + 0.015055191490298152 * v.y + 0.7518742814281371 * v.z)
end

func _gc_d50_to_d65(v: _GcV3): _GcV3:
    ret _gc_v3(0.955473421488075 * v.x - 0.02309845494876471 * v.y + 0.06325924320057072 * v.z, -0.0283697093338637 * v.x + 1.0099953980813041 * v.y + 0.021041441191917323 * v.z, 0.012314014864481998 * v.x - 0.020507649298898964 * v.y + 1.330365926242124 * v.z)
end

func _gc_xyz_to_oklab(v: _GcV3): _GcV3:
    l := math.Cbrt(0.819022437996703 * v.x + 0.3619062600528904 * v.y - 0.1288737815209879 * v.z)
    m := math.Cbrt(0.0329836539323885 * v.x + 0.9292868615863434 * v.y + 0.0361446663506424 * v.z)
    s := math.Cbrt(0.0481771893596242 * v.x + 0.2642395317527308 * v.y + 0.6335478284694309 * v.z)
    ret _gc_v3(0.210454268309314 * l + 0.7936177747023054 * m - 0.0040720430116193 * s, 1.9779985324311684 * l - 2.42859224204858 * m + 0.450593709617411 * s, 0.0259040424655478 * l + 0.7827717124575296 * m - 0.8086757549230774 * s)
end

func _gc_oklab_to_xyz(v: _GcV3): _GcV3:
    l0 := v.x + 0.3963377773761749 * v.y + 0.2158037573099136 * v.z
    m0 := v.x - 0.1055613458156586 * v.y - 0.0638541728258133 * v.z
    s0 := v.x - 0.0894841775298119 * v.y - 1.2914855480194092 * v.z
    l := l0 * l0 * l0
    m := m0 * m0 * m0
    s := s0 * s0 * s0
    ret _gc_v3(1.2268798758459243 * l - 0.5578149944602171 * m + 0.2813910456659647 * s, -0.0405757452148008 * l + 1.112286803280317 * m - 0.0717110580655164 * s, -0.0763729366746601 * l - 0.4214933324022432 * m + 1.5869240198367816 * s)
end

func _gc_lab_f(v: f64): f64:
    if v > 216.0 / 24389.0:
        ret math.Cbrt(v)
    end
    ret (24389.0 / 27.0 * v + 16.0) / 116.0
end

func _gc_xyz50_to_lab(v: _GcV3): _GcV3:
    f0 := _gc_lab_f(v.x / 0.9642956764295677)
    f1 := _gc_lab_f(v.y)
    f2 := _gc_lab_f(v.z / 0.8251046025104602)
    ret _gc_v3(116.0 * f1 - 16.0, 500.0 * (f0 - f1), 200.0 * (f1 - f2))
end

func _gc_lab_to_xyz50(v: _GcV3): _GcV3:
    k := 24389.0 / 27.0
    ep := 216.0 / 24389.0
    f1 := (v.x + 16.0) / 116.0
    f0 := v.y / 500.0 + f1
    f2 := f1 - v.z / 200.0
    mut x := (116.0 * f0 - 16.0) / k
    if f0 * f0 * f0 > ep:
        x = f0 * f0 * f0
    end
    mut y := v.x / k
    if v.x > k * ep:
        y = f1 * f1 * f1
    end
    mut z := (116.0 * f2 - 16.0) / k
    if f2 * f2 * f2 > ep:
        z = f2 * f2 * f2
    end
    ret _gc_v3(x * 0.9642956764295677, y, z * 0.8251046025104602)
end

func _gc_wrap_hue(h: f64): f64:
    r := h - math.Floor(h / 360.0) * 360.0
    if r >= 360.0:
        ret 0.0
    end
    ret r
end

func _gc_to_polar(v: _GcV3): _GcV3:
    c := math.Sqrt(v.y * v.y + v.z * v.z)
    h := math.Atan2(v.z, v.y) * 180.0 / math.PI
    ret _gc_v3(v.x, c, _gc_wrap_hue(h))
end

func _gc_from_polar(v: _GcV3): _GcV3:
    r := v.z * math.PI / 180.0
    ret _gc_v3(v.x, v.y * math.Cos(r), v.y * math.Sin(r))
end

func _gc_hsl_channel(n: f64, h: f64, s: f64, l: f64): f64:
    k0 := n + h / 30.0
    k := k0 - math.Floor(k0 / 12.0) * 12.0
    a := s * math.Min(l, 1.0 - l)
    ret l - a * math.Max(-1.0, math.Min(math.Min(k - 3.0, 9.0 - k), 1.0))
end

func _gc_hsl_to_srgb(v: _GcV3): _GcV3:
    h := _gc_wrap_hue(v.x)
    ret _gc_v3(_gc_hsl_channel(0.0, h, v.y, v.z), _gc_hsl_channel(8.0, h, v.y, v.z), _gc_hsl_channel(4.0, h, v.y, v.z))
end

func _gc_hwb_to_srgb(v: _GcV3): _GcV3:
    w := v.y
    bl := v.z
    if w + bl >= 1.0:
        g := w / (w + bl)
        ret _gc_v3(g, g, g)
    end
    base := _gc_hsl_to_srgb(_gc_v3(v.x, 1.0, 0.5))
    f := 1.0 - w - bl
    ret _gc_v3(base.x * f + w, base.y * f + w, base.z * f + w)
end

func _gc_srgb_to_hsl(v: _GcV3): _GcV3:
    mx := math.Max(v.x, math.Max(v.y, v.z))
    mn := math.Min(v.x, math.Min(v.y, v.z))
    l := (mx + mn) / 2.0
    d := mx - mn
    mut h := 0.0
    mut s := 0.0
    if d != 0.0:
        if l != 0.0 and l != 1.0:
            s = (mx - l) / math.Min(l, 1.0 - l)
        end
        if mx == v.x:
            h = (v.y - v.z) / d
            if v.y < v.z:
                h += 6.0
            end
        else mx == v.y:
            h = (v.z - v.x) / d + 2.0
        else:
            h = (v.x - v.y) / d + 4.0
        end
        h *= 60.0
    end
    if s < 0.0:
        h += 180.0
        s = math.Abs(s)
    end
    ret _gc_v3(_gc_wrap_hue(h), s, l)
end

func _gc_srgb_to_hwb(v: _GcV3): _GcV3:
    hs := _gc_srgb_to_hsl(v)
    w := math.Min(v.x, math.Min(v.y, v.z))
    b := 1.0 - math.Max(v.x, math.Max(v.y, v.z))
    ret _gc_v3(hs.x, w, b)
end

func _gc_srgb_to_xyz(v: _GcV3): _GcV3:
    ret _gc_lin_srgb_to_xyz(_gc_v3(_gc_srgb_lin(v.x), _gc_srgb_lin(v.y), _gc_srgb_lin(v.z)))
end

func _gc_xyz_to_srgb(v: _GcV3): _GcV3:
    l := _gc_xyz_to_lin_srgb(v)
    ret _gc_v3(_gc_srgb_enc(l.x), _gc_srgb_enc(l.y), _gc_srgb_enc(l.z))
end

func _gc_space_to_xyz(v: _GcV3, sp: int): _GcV3:
    switch sp:
        _GC_SRGB: ret _gc_srgb_to_xyz(v) end
        _GC_SRGB_LINEAR: ret _gc_lin_srgb_to_xyz(v) end
        _GC_P3: ret _gc_lin_p3_to_xyz(_gc_v3(_gc_srgb_lin(v.x), _gc_srgb_lin(v.y), _gc_srgb_lin(v.z))) end
        _GC_A98: ret _gc_lin_a98_to_xyz(_gc_v3(_gc_a98_lin(v.x), _gc_a98_lin(v.y), _gc_a98_lin(v.z))) end
        _GC_PROPHOTO: ret _gc_d50_to_d65(_gc_lin_pro_to_xyz50(_gc_v3(_gc_pro_lin(v.x), _gc_pro_lin(v.y), _gc_pro_lin(v.z)))) end
        _GC_REC2020: ret _gc_lin_2020_to_xyz(_gc_v3(_gc_r2020_lin(v.x), _gc_r2020_lin(v.y), _gc_r2020_lin(v.z))) end
        _GC_XYZ_D50: ret _gc_d50_to_d65(v) end
        _GC_XYZ_D65: ret v end
        _GC_LAB: ret _gc_d50_to_d65(_gc_lab_to_xyz50(v)) end
        _GC_LCH: ret _gc_d50_to_d65(_gc_lab_to_xyz50(_gc_from_polar(v))) end
        _GC_OKLAB: ret _gc_oklab_to_xyz(v) end
        _GC_OKLCH: ret _gc_oklab_to_xyz(_gc_from_polar(v)) end
        _GC_HSL: ret _gc_srgb_to_xyz(_gc_hsl_to_srgb(v)) end
        else: ret _gc_srgb_to_xyz(_gc_hwb_to_srgb(v)) end
    end
    ret v
end

func _gc_xyz_to_space(v: _GcV3, sp: int): _GcV3:
    switch sp:
        _GC_SRGB: ret _gc_xyz_to_srgb(v) end
        _GC_SRGB_LINEAR: ret _gc_xyz_to_lin_srgb(v) end
        _GC_P3:
            l := _gc_xyz_to_lin_p3(v)
            ret _gc_v3(_gc_srgb_enc(l.x), _gc_srgb_enc(l.y), _gc_srgb_enc(l.z))
        end
        _GC_A98:
            l := _gc_xyz_to_lin_a98(v)
            ret _gc_v3(_gc_a98_enc(l.x), _gc_a98_enc(l.y), _gc_a98_enc(l.z))
        end
        _GC_PROPHOTO:
            l := _gc_xyz50_to_lin_pro(_gc_d65_to_d50(v))
            ret _gc_v3(_gc_pro_enc(l.x), _gc_pro_enc(l.y), _gc_pro_enc(l.z))
        end
        _GC_REC2020:
            l := _gc_xyz_to_lin_2020(v)
            ret _gc_v3(_gc_r2020_enc(l.x), _gc_r2020_enc(l.y), _gc_r2020_enc(l.z))
        end
        _GC_XYZ_D50: ret _gc_d65_to_d50(v) end
        _GC_XYZ_D65: ret v end
        _GC_LAB: ret _gc_xyz50_to_lab(_gc_d65_to_d50(v)) end
        _GC_LCH: ret _gc_to_polar(_gc_xyz50_to_lab(_gc_d65_to_d50(v))) end
        _GC_OKLAB: ret _gc_xyz_to_oklab(v) end
        _GC_OKLCH: ret _gc_to_polar(_gc_xyz_to_oklab(v)) end
        _GC_HSL: ret _gc_srgb_to_hsl(_gc_xyz_to_srgb(v)) end
        else: ret _gc_srgb_to_hwb(_gc_xyz_to_srgb(v)) end
    end
    ret v
end

func _gc_to_space(rgb: _GcV3, sp: int): _GcV3:
    switch sp:
        _GC_SRGB: ret rgb end
        _GC_HSL: ret _gc_srgb_to_hsl(rgb) end
        _GC_HWB: ret _gc_srgb_to_hwb(rgb) end
        else: ret _gc_xyz_to_space(_gc_srgb_to_xyz(rgb), sp) end
    end
    ret rgb
end

func _gc_from_space(v: _GcV3, sp: int): _GcV3:
    switch sp:
        _GC_SRGB: ret v end
        _GC_HSL: ret _gc_hsl_to_srgb(v) end
        _GC_HWB: ret _gc_hwb_to_srgb(v) end
        else: ret _gc_xyz_to_srgb(_gc_space_to_xyz(v, sp)) end
    end
    ret v
end

func _gc_hue_index(sp: int): int:
    switch sp:
        _GC_LCH, _GC_OKLCH: ret 2 end
        _GC_HSL, _GC_HWB: ret 0 end
        else: ret -1 end
    end
    ret -1
end

func _gc_achromatic(v: _GcV3, sp: int): bool:
    switch sp:
        _GC_LCH: ret v.y < 0.0015 end
        _GC_OKLCH: ret v.y < 0.000004 end
        _GC_HSL: ret v.y < 1.0e-9 or v.z <= 0.0 or v.z >= 1.0 end
        _GC_HWB: ret v.y + v.z >= 1.0 - 1.0e-9 end
        else: ret false end
    end
    ret false
end

func _gc_get(v: _GcV3, k: int): f64:
    switch k:
        0: ret v.x end
        1: ret v.y end
        else: ret v.z end
    end
    ret v.z
end

func _gc_set(v &: _GcV3, k: int, x: f64):
    switch k:
        0: v.x = x break end
        1: v.y = x break end
        else: v.z = x end
    end
end

func _gc_space_name(sp: int): str:
    switch sp:
        _GC_SRGB: ret "srgb" end
        _GC_SRGB_LINEAR: ret "srgb-linear" end
        _GC_P3: ret "display-p3" end
        _GC_A98: ret "a98-rgb" end
        _GC_PROPHOTO: ret "prophoto-rgb" end
        _GC_REC2020: ret "rec2020" end
        _GC_XYZ_D50: ret "xyz-d50" end
        _GC_XYZ_D65: ret "xyz-d65" end
        _GC_LAB: ret "lab" end
        _GC_LCH: ret "lch" end
        _GC_OKLAB: ret "oklab" end
        _GC_OKLCH: ret "oklch" end
        _GC_HSL: ret "hsl" end
        else: ret "hwb" end
    end
    ret ""
end
