package css

import str
import math
import gui.cssbox

func pct_len(p: f64): Len:
    ret Len { pct = p, has_pct = true }
end

func p_auto_len(t: Vector<Tok>, s: int, e: int, cx: Cx, neg: bool, out &: Len): bool:
    k := kw_id_at(t, s, e)
    if k == KW_AUTO:
        out = Len { kind = LenKind.Auto }
        ret true
    end
    ret single(t, s, e) and p_len(t, s, e, cx, true, neg, out)
end

func p_size_len(t: Vector<Tok>, s: int, e: int, cx: Cx, none_kw: int, out &: Len): bool:
    k := kw_id_at(t, s, e)
    switch k:
        KW_MIN_CONTENT, KW_X_WEBKIT_MIN_CONTENT:
            out = Len { kind = LenKind.MinContent }
            ret true
        end
        KW_MAX_CONTENT, KW_X_WEBKIT_MAX_CONTENT:
            out = Len { kind = LenKind.MaxContent }
            ret true
        end
        KW_FIT_CONTENT, KW_X_WEBKIT_FIT_CONTENT, KW_X_MOZ_FIT_CONTENT:
            out = Len { kind = LenKind.FitContent }
            ret true
        end
        KW_STRETCH, KW_X_WEBKIT_FILL_AVAILABLE:
            out = Len { kind = LenKind.Auto }
            ret true
        end
        else:
        end
    end
    if k >= 0 and k == none_kw:
        out = Len { kind = none_kw == KW_NONE ? LenKind.None : LenKind.Auto }
        ret true
    end
    if single(t, s, e) and t[s].k == TK_FUNC and t[s].id == KW_FIT_CONTENT:
        out = Len { kind = LenKind.FitContent }
        ret true
    end
    ret single(t, s, e) and p_len(t, s, e, cx, true, false, out)
end

func border_width_of(t: Vector<Tok>, s: int, e: int, cx: Cx, out &: f64): bool:
    k := kw_id_at(t, s, e)
    switch k:
        KW_THIN: out = 1.0 break end
        KW_MEDIUM: out = 3.0 break end
        KW_THICK: out = 5.0 break end
        else:
            mut l := Len {}
            if not single(t, s, e) or not p_len(t, s, e, cx, false, false, l):
                ret false
            end
            if l.calc.Len() > 0 or l.has_pct:
                ret false
            end
            out = l.px
        end
    end
    ret true
end

func snap_border(w: f64): f64:
    if w <= 0.0:
        ret 0.0
    end
    if w < 1.0:
        ret 1.0
    end
    ret math.Floor(w)
end

func border_style_of(k: int, outline: bool, out &: BorderStyle): bool:
    switch k:
        KW_NONE: out = BorderStyle.None break end
        KW_HIDDEN:
            if outline:
                ret false
            end
            out = BorderStyle.Hidden
            break
        end
        KW_SOLID: out = BorderStyle.Solid break end
        KW_DASHED: out = BorderStyle.Dashed break end
        KW_DOTTED: out = BorderStyle.Dotted break end
        KW_DOUBLE: out = BorderStyle.Double break end
        KW_GROOVE: out = BorderStyle.Groove break end
        KW_RIDGE: out = BorderStyle.Ridge break end
        KW_INSET: out = BorderStyle.Inset break end
        KW_OUTSET: out = BorderStyle.Outset break end
        KW_AUTO:
            if not outline:
                ret false
            end
            out = BorderStyle.Auto
            break
        end
        else: ret false end
    end
    ret true
end

func align_of(t: Vector<Tok>, s: int, e: int, self_kw: bool, out &: cssbox.Align): bool:
    mut i := s
    if is_kw_id(t, i, e, KW_SAFE) or is_kw_id(t, i, e, KW_UNSAFE) or is_kw_id(t, i, e, KW_FIRST) or is_kw_id(t, i, e, KW_LEGACY):
        i++
    end
    if i >= e or t[i].k != TK_IDENT:
        ret false
    end
    k := t[i].id
    if i + 1 != e:
        if not (is_kw_id(t, i + 1, e, KW_LEGACY) and i + 2 == e) and not (k == KW_LAST and is_kw_id(t, i + 1, e, KW_BASELINE) and i + 2 == e):
            ret false
        end
        if k == KW_LAST:
            out = cssbox.Align.Baseline
            ret true
        end
    end
    switch k:
        KW_NORMAL: out = cssbox.Align.Normal break end
        KW_START, KW_SELF_START, KW_LEFT: out = cssbox.Align.Start break end
        KW_END, KW_SELF_END, KW_RIGHT: out = cssbox.Align.End break end
        KW_FLEX_START: out = cssbox.Align.FlexStart break end
        KW_FLEX_END: out = cssbox.Align.FlexEnd break end
        KW_CENTER: out = cssbox.Align.Center break end
        KW_BASELINE: out = cssbox.Align.Baseline break end
        KW_STRETCH: out = cssbox.Align.Stretch break end
        KW_SPACE_BETWEEN: out = cssbox.Align.SpaceBetween break end
        KW_SPACE_AROUND: out = cssbox.Align.SpaceAround break end
        KW_SPACE_EVENLY: out = cssbox.Align.SpaceEvenly break end
        KW_AUTO:
            if not self_kw:
                ret false
            end
            out = cssbox.Align.Auto
            break
        end
        else: ret false end
    end
    ret true
end

func display_of(t: Vector<Tok>, s: int, e: int, out &: Display): bool:
    n := count_items(t, s, e)
    if n == 2 and t[s].k == TK_IDENT and t[s + 1].k == TK_IDENT:
        a := t[s].id
        b := t[s + 1].id
        mut outer := a
        mut inner := b
        if a != KW_INLINE and a != KW_BLOCK and a != KW_RUN_IN:
            outer = b
            inner = a
        end
        inl := outer == KW_INLINE
        switch inner:
            KW_FLOW: out = inl ? Display.Inline : Display.Block break end
            KW_FLOW_ROOT: out = inl ? Display.InlineBlock : Display.FlowRoot break end
            KW_FLEX: out = inl ? Display.InlineFlex : Display.Flex break end
            KW_GRID: out = inl ? Display.InlineGrid : Display.Grid break end
            KW_TABLE: out = inl ? Display.InlineTable : Display.Table break end
            KW_LIST_ITEM: out = inl ? Display.Inline : Display.ListItem break end
            else: ret false end
        end
        ret true
    end
    k := kw_id_at(t, s, e)
    switch k:
        KW_BLOCK: out = Display.Block break end
        KW_INLINE, KW_RUBY, KW_RUBY_TEXT, KW_RUBY_BASE: out = Display.Inline break end
        KW_INLINE_BLOCK: out = Display.InlineBlock break end
        KW_FLOW_ROOT: out = Display.FlowRoot break end
        KW_FLEX, KW_X_WEBKIT_BOX, KW_X_WEBKIT_FLEX: out = Display.Flex break end
        KW_INLINE_FLEX, KW_X_WEBKIT_INLINE_BOX: out = Display.InlineFlex break end
        KW_GRID: out = Display.Grid break end
        KW_INLINE_GRID: out = Display.InlineGrid break end
        KW_LIST_ITEM: out = Display.ListItem break end
        KW_TABLE: out = Display.Table break end
        KW_INLINE_TABLE: out = Display.InlineTable break end
        KW_TABLE_ROW_GROUP: out = Display.TableRowGroup break end
        KW_TABLE_HEADER_GROUP: out = Display.TableHeaderGroup break end
        KW_TABLE_FOOTER_GROUP: out = Display.TableFooterGroup break end
        KW_TABLE_ROW: out = Display.TableRow break end
        KW_TABLE_CELL: out = Display.TableCell break end
        KW_TABLE_COLUMN: out = Display.TableColumn break end
        KW_TABLE_COLUMN_GROUP: out = Display.TableColumnGroup break end
        KW_TABLE_CAPTION: out = Display.TableCaption break end
        KW_CONTENTS: out = Display.Contents break end
        KW_NONE: out = Display.None break end
        else: ret false end
    end
    ret true
end

func overflow_of(k: int, out &: cssbox.Overflow): bool:
    switch k:
        KW_VISIBLE: out = cssbox.Overflow.Visible break end
        KW_HIDDEN: out = cssbox.Overflow.Hidden break end
        KW_CLIP: out = cssbox.Overflow.Clip break end
        KW_SCROLL: out = cssbox.Overflow.Scroll break end
        KW_AUTO, KW_OVERLAY: out = cssbox.Overflow.Auto break end
        else: ret false end
    end
    ret true
end

func pos_kw(k: int, horizontal: bool, out &: f64): bool:
    switch k:
        KW_CENTER: out = 50.0 break end
        KW_LEFT:
            if not horizontal:
                ret false
            end
            out = 0.0
            break
        end
        KW_RIGHT:
            if not horizontal:
                ret false
            end
            out = 100.0
            break
        end
        KW_TOP:
            if horizontal:
                ret false
            end
            out = 0.0
            break
        end
        KW_BOTTOM:
            if horizontal:
                ret false
            end
            out = 100.0
            break
        end
        else: ret false end
    end
    ret true
end

func is_hkw(k: int): bool:
    ret k == KW_LEFT or k == KW_RIGHT
end

func is_vkw(k: int): bool:
    ret k == KW_TOP or k == KW_BOTTOM
end

func axis_value(t: Vector<Tok>, i: int, e: int, cx: Cx, horizontal: bool, out &: Len): bool:
    if t[i].k == TK_IDENT:
        mut p := 0.0
        if not pos_kw(t[i].id, horizontal, p):
            ret false
        end
        out = pct_len(p)
        ret true
    end
    ret p_len(t, i, e, cx, true, true, out)
end

func edge_offset(edge: int, off: Len): Len:
    if edge == KW_RIGHT or edge == KW_BOTTOM:
        if off.calc.Len() > 0:
            ret Len { has_pct = true, calc = intern_own("calc(100% - " + off.calc + ")") }
        end
        ret Len { px = 0.0 - off.px, pct = 100.0 - off.pct, has_pct = true }
    end
    ret off
end

func parse_position(t: Vector<Tok>, s: int, e: int, cx: Cx, ox &: Len, oy &: Len): bool:
    mut idx := Vector {} as Vector<int>
    defer idx.free()
    mut i := s
    until i < e:
        idx.push(i)
        i = nxt(t, i)
    end
    n := idx.Len()
    if n == 1:
        a := idx[0]
        if t[a].k == TK_IDENT and is_vkw(t[a].id):
            ox = pct_len(50.0)
            ret axis_value(t, a, e, cx, false, oy)
        end
        oy = pct_len(50.0)
        ret axis_value(t, a, e, cx, true, ox)
    end
    if n == 2:
        a := idx[0]
        b := idx[1]
        ka := t[a].k == TK_IDENT ? t[a].id : -1
        kb := t[b].k == TK_IDENT ? t[b].id : -1
        if is_vkw(ka) or is_hkw(kb):
            if t[a].k != TK_IDENT or t[b].k != TK_IDENT:
                ret false
            end
            ret axis_value(t, b, e, cx, true, ox) and axis_value(t, a, e, cx, false, oy)
        end
        ret axis_value(t, a, e, cx, true, ox) and axis_value(t, b, e, cx, false, oy)
    end
    if n == 3 or n == 4:
        mut have_x := false
        mut have_y := false
        mut k := 0
        until k < n:
            a := idx[k]
            if t[a].k != TK_IDENT:
                ret false
            end
            kw := t[a].id
            mut off := Len {}
            mut has_off := false
            if k + 1 < n and t[idx[k + 1]].k != TK_IDENT:
                if not p_len(t, idx[k + 1], e, cx, true, true, off):
                    ret false
                end
                has_off = true
            end
            mut horizontal := is_hkw(kw)
            if kw == KW_CENTER:
                horizontal = not have_x
                if has_off:
                    ret false
                end
            else not is_hkw(kw) and not is_vkw(kw):
                ret false
            end
            mut v := Len {}
            if has_off:
                v = edge_offset(kw, off)
            else:
                mut p := 0.0
                _ok := pos_kw(kw, horizontal, p)
                v = pct_len(p)
            end
            if horizontal:
                if have_x:
                    ret false
                end
                have_x = true
                ox = v
            else:
                if have_y:
                    ret false
                end
                have_y = true
                oy = v
            end
            k += has_off ? 2 : 1
        end
        if not have_x:
            ox = pct_len(50.0)
        end
        if not have_y:
            oy = pct_len(50.0)
        end
        ret true
    end
    ret false
end

func parse_pos_axis(t: Vector<Tok>, s: int, e: int, cx: Cx, horizontal: bool, out &: Len): bool:
    n := count_items(t, s, e)
    if n == 1:
        ret axis_value(t, s, e, cx, horizontal, out)
    end
    if n == 2 and t[s].k == TK_IDENT:
        kw := t[s].id
        if (horizontal and not is_hkw(kw)) or (not horizontal and not is_vkw(kw)):
            ret false
        end
        mut off := Len {}
        if not p_len(t, s + 1, e, cx, true, true, off):
            ret false
        end
        out = edge_offset(kw, off)
        ret true
    end
    ret false
end

func parse_stops(t: Vector<Tok>, parts: Vector<int>, from: int, cx: Cx, conic: bool, out &: Vector<ColorStop>): bool:
    mut k := from
    until k + 1 < parts.Len():
        s := parts[k]
        e := parts[k + 1]
        if s >= e:
            ret false
        end
        mut c := Color {}
        cs0 := nxt(t, s)
        if parse_color_at(t, s, cs0, cx.dark, cx.color, c):
            mut i := cs0
            mut n := 0
            until i < e:
                mut l := Len {}
                if conic:
                    mut ang := 0.0
                    if t[i].k == TK_PCT:
                        l = pct_len(t[i].n)
                    else p_angle(t, i, e, cx, true, ang):
                        l = Len { px = ang }
                    else:
                        ret false
                    end
                else not p_len(t, i, e, cx, true, true, l):
                    ret false
                end
                out.push(ColorStop { color = c, pos = l, has_pos = true })
                n++
                if n > 2:
                    ret false
                end
                i = nxt(t, i)
            end
            if n == 0:
                out.push(ColorStop { color = c })
            end
        else:
            if not single(t, s, e):
                ret false
            end
            mut l := Len {}
            if conic:
                mut ang := 0.0
                if t[s].k == TK_PCT:
                    l = pct_len(t[s].n)
                else p_angle(t, s, e, cx, true, ang):
                    l = Len { px = ang }
                else:
                    ret false
                end
            else not p_len(t, s, e, cx, true, true, l):
                ret false
            end
            out.push(ColorStop { pos = l, has_pos = true, hint = true })
        end
        k += 2
    end
    mut colors := 0
    repeat out.Len() in j:
        if not out[j].hint:
            colors++
        end
    end
    ret colors >= 2
end

func gradient_base(name: str, skip: int): str:
    rest := name.substr(skip, name.Len() - skip)
    r := intern(rest)
    sfree(rest)
    ret r
end

func parse_gradient(t: Vector<Tok>, i: int, cx: Cx, out &: BgLayer): bool:
    f := t[i]
    s := i + 1
    e := f.close
    if e < 0:
        ret false
    end
    mut base := f.s
    if str.StartsWith(base, "-webkit-"):
        base = gradient_base(base, 8)
    end
    out.repeating = str.StartsWith(base, "repeating-")
    if out.repeating:
        base = gradient_base(base, 10)
    end
    mut parts := Vector {} as Vector<int>
    defer parts.free()
    split_commas(t, s, e, parts)
    mut first := 0
    mut gs := parts[0]
    mut ge := parts[1]
    mut sp := -1
    mut method := HUE_SHORTER
    if not take_interp(t, parts[0], parts[1], gs, ge, sp, method):
        ret false
    end
    explicit := sp >= 0
    if sp >= 0 and gs == ge:
        first = 2
    end
    mut c := Color {}
    starts_color := sp < 0 and gs < ge and parse_color_at(t, gs, nxt(t, gs), cx.dark, cx.color, c)
    switch name_id(base):
        KW_LINEAR_GRADIENT:
            out.image = ImageKind.Linear
            if not starts_color and gs < ge:
                first = 2
                if is_kw_id(t, gs, ge, KW_TO):
                    mut j := gs + 1
                    mut x := 0
                    mut y := 0
                    until j < ge:
                        if t[j].k != TK_IDENT:
                            ret false
                        end
                        switch t[j].id:
                            KW_LEFT: x = -1 break end
                            KW_RIGHT: x = 1 break end
                            KW_TOP: y = -1 break end
                            KW_BOTTOM: y = 1 break end
                            else: ret false end
                        end
                        j++
                    end
                    if x == 0 and y == 0:
                        ret false
                    end
                    if x != 0 and y != 0:
                        out.to_x = x
                        out.to_y = y
                    else x != 0:
                        out.angle = x > 0 ? 90.0 : 270.0
                    else:
                        out.angle = y > 0 ? 180.0 : 0.0
                    end
                else:
                    mut a := 0.0
                    if not single(t, gs, ge) or not p_angle(t, gs, ge, cx, true, a):
                        ret false
                    end
                    out.angle = a
                end
            end
            break
        end
        KW_RADIAL_GRADIENT:
            out.image = ImageKind.Radial
            if not starts_color and gs < ge:
                first = 2
                mut j := gs
                mut sizes := 0
                until j < ge:
                    if is_kw_id(t, j, ge, KW_AT):
                        mut cxl := Len {}
                        mut cyl := Len {}
                        if not parse_position(t, j + 1, ge, cx, cxl, cyl):
                            ret false
                        end
                        out.center_x = cxl
                        out.center_y = cyl
                        break
                    end
                    if t[j].k == TK_IDENT:
                        switch t[j].id:
                            KW_CIRCLE: out.shape = RadialShape.Circle break end
                            KW_ELLIPSE: out.shape = RadialShape.Ellipse break end
                            KW_CLOSEST_SIDE: out.extent = RadialExtent.ClosestSide break end
                            KW_CLOSEST_CORNER: out.extent = RadialExtent.ClosestCorner break end
                            KW_FARTHEST_SIDE: out.extent = RadialExtent.FarthestSide break end
                            KW_FARTHEST_CORNER: out.extent = RadialExtent.FarthestCorner break end
                            else: ret false end
                        end
                    else:
                        mut l := Len {}
                        if not p_len(t, j, ge, cx, true, false, l):
                            ret false
                        end
                        if sizes == 0:
                            out.radius_x = l
                            out.radius_y = l
                        else:
                            out.radius_y = l
                            out.shape = RadialShape.Ellipse
                        end
                        sizes++
                        out.extent = RadialExtent.Explicit
                    end
                    j = nxt(t, j)
                end
                if sizes == 1 and out.radius_x.has_pct:
                    ret false
                end
                if sizes == 1:
                    out.shape = RadialShape.Circle
                end
            end
            break
        end
        KW_CONIC_GRADIENT:
            out.image = ImageKind.Conic
            out.angle = 0.0
            if not starts_color and gs < ge:
                first = 2
                mut j := gs
                until j < ge:
                    if is_kw_id(t, j, ge, KW_FROM):
                        mut a := 0.0
                        if not p_angle(t, j + 1, ge, cx, true, a):
                            ret false
                        end
                        out.angle = a
                        j = nxt(t, j + 1)
                        continue
                    end
                    if is_kw_id(t, j, ge, KW_AT):
                        mut cxl := Len {}
                        mut cyl := Len {}
                        if not parse_position(t, j + 1, ge, cx, cxl, cyl):
                            ret false
                        end
                        out.center_x = cxl
                        out.center_y = cyl
                        break
                    end
                    ret false
                end
            end
            break
        end
        else:
            ret false
        end
    end
    out.stops.free()
    out.stops = Vector {} as Vector<ColorStop>
    if not parse_stops(t, parts, first, cx, out.image == ImageKind.Conic, out.stops):
        ret false
    end
    if sp < 0:
        mut k := first
        until k + 1 < parts.Len():
            if parts[k] < parts[k + 1] and not color_is_legacy(t, parts[k], nxt(t, parts[k]), cx.dark, cx.color):
                sp = SP_OKLAB
            end
            k += 2
        end
    end
    out.interpolation_set = explicit
    if sp >= 0:
        out.interpolation = sp
        out.hue_interpolation = method
    end
    ret true
end

func parse_image(t: Vector<Tok>, s: int, e: int, cx: Cx, out &: BgLayer): bool:
    if not single(t, s, e):
        ret false
    end
    tk := t[s]
    if tk.k == TK_IDENT and tk.id == KW_NONE:
        out.image = ImageKind.None
        ret true
    end
    if tk.k == TK_URL:
        out.image = ImageKind.Url
        out.url = intern(tk.s)
        ret true
    end
    if tk.k == TK_FUNC and tk.id == KW_URL:
        if s + 1 < tk.close and t[s + 1].k == TK_STR:
            out.image = ImageKind.Url
            out.url = intern(t[s + 1].s)
            ret true
        end
        ret false
    end
    if tk.k == TK_FUNC and str.EndsWith(tk.s, "gradient"):
        ret parse_gradient(t, s, cx, out)
    end
    ret false
end

func parse_shadow(t: Vector<Tok>, s: int, e: int, cx: Cx, text: bool, out &: Shadow): bool:
    mut lens := 0
    mut have_color := false
    mut i := s
    mut sh := Shadow { color = cx.color }
    until i < e:
        if is_kw_id(t, i, e, KW_INSET) and not text:
            if sh.inset:
                ret false
            end
            sh.inset = true
            i++
            continue
        end
        mut c := Color {}
        if not have_color and parse_color_at(t, i, nxt(t, i), cx.dark, cx.color, c):
            sh.color = c
            have_color = true
            i = nxt(t, i)
            continue
        end
        mut l := Len {}
        if lens >= 4 or (text and lens >= 3) or not p_len(t, i, e, cx, false, true, l) or l.calc.Len() > 0:
            ret false
        end
        switch lens:
            0: sh.x = l.px break end
            1: sh.y = l.px break end
            2:
                if l.px < 0.0:
                    ret false
                end
                sh.blur = l.px
                break
            end
            else: sh.spread = l.px end
        end
        lens++
        i = nxt(t, i)
    end
    if lens < 2:
        ret false
    end
    out = sh
    ret true
end

func parse_shadow_list(t: Vector<Tok>, s: int, e: int, cx: Cx, text: bool, out &: Vector<Shadow>): bool:
    if kw_id_at(t, s, e) == KW_NONE:
        ret true
    end
    mut parts := Vector {} as Vector<int>
    defer parts.free()
    split_commas(t, s, e, parts)
    mut k := 0
    until k + 1 < parts.Len():
        mut sh := Shadow {}
        if not parse_shadow(t, parts[k], parts[k + 1], cx, text, sh):
            ret false
        end
        out.push(sh)
        k += 2
    end
    ret true
end

func fn_args(t: Vector<Tok>, i: int, out &: Vector<int>):
    s := i + 1
    e := t[i].close
    mut j := s
    until j < e:
        if t[j].k != TK_COMMA:
            out.push(j)
        end
        j = nxt(t, j)
    end
end

func parse_filter_fn(t: Vector<Tok>, i: int, cx: Cx, out &: FilterFn): bool:
    f := t[i]
    e := f.close
    mut a := Vector {} as Vector<int>
    defer a.free()
    fn_args(t, i, a)
    n := a.Len()
    switch f.id:
        KW_BLUR:
            out.name = "blur"
            out.amount = 0.0
            if n == 0:
                ret true
            end
            mut l := Len {}
            if n != 1 or not p_len(t, a[0], e, cx, false, false, l) or l.calc.Len() > 0:
                ret false
            end
            out.amount = l.px
            ret true
        end
        KW_BRIGHTNESS, KW_CONTRAST, KW_GRAYSCALE, KW_SEPIA, KW_SATURATE, KW_INVERT, KW_OPACITY:
            out.name = f.id == KW_BRIGHTNESS ? "brightness" : (f.id == KW_CONTRAST ? "contrast" : (f.id == KW_GRAYSCALE ? "grayscale" : (f.id == KW_SEPIA ? "sepia" : (f.id == KW_SATURATE ? "saturate" : (f.id == KW_INVERT ? "invert" : "opacity")))))
            out.amount = 1.0
            if n == 0:
                ret true
            end
            mut v := 0.0
            if n != 1 or not p_num_or_pct(t, a[0], e, cx, v) or v < 0.0:
                ret false
            end
            out.amount = v
            ret true
        end
        KW_HUE_ROTATE:
            out.name = "hue-rotate"
            out.amount = 0.0
            if n == 0:
                ret true
            end
            mut ang := 0.0
            if n != 1 or not p_angle(t, a[0], e, cx, true, ang):
                ret false
            end
            out.amount = ang
            ret true
        end
        KW_DROP_SHADOW:
            out.name = "drop-shadow"
            mut sh := Shadow {}
            if i + 1 >= e or not parse_shadow(t, i + 1, e, cx, true, sh):
                ret false
            end
            out.shadow = sh
            ret true
        end
        else:
            ret false
        end
    end
    ret false
end

func parse_transform_fn(t: Vector<Tok>, i: int, cx: Cx, out &: TransformFn): bool:
    f := t[i]
    e := f.close
    mut a := Vector {} as Vector<int>
    defer a.free()
    fn_args(t, i, a)
    n := a.Len()
    switch f.id:
        KW_TRANSLATE, KW_TRANSLATE3D, KW_TRANSLATEX, KW_TRANSLATEY, KW_TRANSLATEZ:
            out.kind = TransformKind.Translate
            if f.id == KW_TRANSLATEZ:
                ret n == 1
            end
            if n < 1 or n > 3:
                ret false
            end
            mut x := Len {}
            mut y := Len {}
            if not p_len(t, a[0], e, cx, true, true, x):
                ret false
            end
            if n >= 2 and not p_len(t, a[1], e, cx, true, true, y):
                ret false
            end
            if f.id == KW_TRANSLATEY:
                if n != 1:
                    ret false
                end
                out.y = x
                ret true
            end
            out.x = x
            out.y = y
            ret true
        end
        KW_SCALE, KW_SCALE3D, KW_SCALEX, KW_SCALEY, KW_SCALEZ:
            out.kind = TransformKind.Scale
            if n < 1 or n > 3:
                ret false
            end
            mut sx := 1.0
            mut sy := 1.0
            if not p_num_or_pct(t, a[0], e, cx, sx):
                ret false
            end
            sy = sx
            if n >= 2 and not p_num_or_pct(t, a[1], e, cx, sy):
                ret false
            end
            switch f.id:
                KW_SCALEX:
                    out.a = sx
                    break
                end
                KW_SCALEY:
                    out.d = sx
                    break
                end
                KW_SCALEZ:
                    out.a = 1.0
                    break
                end
                else:
                    out.a = sx
                    out.d = sy
                end
            end
            ret true
        end
        KW_ROTATE, KW_ROTATEZ:
            out.kind = TransformKind.Rotate
            mut ang := 0.0
            if n != 1 or not p_angle(t, a[0], e, cx, true, ang):
                ret false
            end
            out.a = ang
            ret true
        end
        KW_ROTATEX, KW_ROTATEY, KW_ROTATE3D, KW_PERSPECTIVE:
            out.kind = TransformKind.Scale
            out.a = 1.0
            out.d = 1.0
            ret n >= 1
        end
        KW_SKEW, KW_SKEWX, KW_SKEWY:
            out.kind = TransformKind.Skew
            mut ax := 0.0
            mut ay := 0.0
            if n < 1 or n > 2 or not p_angle(t, a[0], e, cx, true, ax):
                ret false
            end
            if n == 2 and not p_angle(t, a[1], e, cx, true, ay):
                ret false
            end
            if f.id == KW_SKEWY:
                out.a = 0.0
                out.b = ax
            else:
                out.a = ax
                out.b = ay
            end
            ret true
        end
        KW_MATRIX, KW_MATRIX3D:
            out.kind = TransformKind.Matrix
            want := f.id == KW_MATRIX ? 6 : 16
            if n != want:
                ret false
            end
            mut m := Vector {} as Vector<f64>
            defer m.free()
            repeat n in k:
                mut v := 0.0
                if not p_num(t, a[k], e, cx, v):
                    ret false
                end
                m.push(v)
            end
            if want == 6:
                out.a = m[0]
                out.b = m[1]
                out.c = m[2]
                out.d = m[3]
                out.e = m[4]
                out.f = m[5]
            else:
                out.a = m[0]
                out.b = m[1]
                out.c = m[4]
                out.d = m[5]
                out.e = m[12]
                out.f = m[13]
            end
            ret true
        end
        else:
            ret false
        end
    end
    ret false
end

func timing_of(t: Vector<Tok>, i: int, cx: Cx, out &: Timing): bool:
    tk := t[i]
    if tk.k == TK_IDENT:
        switch tk.id:
            KW_EASE: out = Timing {} break end
            KW_LINEAR: out = Timing { kind = TimingKind.Linear, x1 = 0.0, y1 = 0.0, x2 = 1.0, y2 = 1.0 } break end
            KW_EASE_IN: out = Timing { x1 = 0.42, y1 = 0.0, x2 = 1.0, y2 = 1.0 } break end
            KW_EASE_OUT: out = Timing { x1 = 0.0, y1 = 0.0, x2 = 0.58, y2 = 1.0 } break end
            KW_EASE_IN_OUT: out = Timing { x1 = 0.42, y1 = 0.0, x2 = 0.58, y2 = 1.0 } break end
            KW_STEP_START: out = Timing { kind = TimingKind.Steps, steps = 1, step_position = StepPosition.JumpStart } break end
            KW_STEP_END: out = Timing { kind = TimingKind.Steps, steps = 1, step_position = StepPosition.JumpEnd } break end
            else: ret false end
        end
        ret true
    end
    if tk.k != TK_FUNC:
        ret false
    end
    mut a := Vector {} as Vector<int>
    defer a.free()
    fn_args(t, i, a)
    switch tk.id:
        KW_CUBIC_BEZIER:
            if a.Len() != 4:
                ret false
            end
            mut v := [0.0, 0.0, 0.0, 0.0]
            repeat 4 in k:
                if not p_num(t, a[k], tk.close, cx, v[k]):
                    ret false
                end
            end
            if v[0] < 0.0 or v[0] > 1.0 or v[2] < 0.0 or v[2] > 1.0:
                ret false
            end
            out = Timing { x1 = v[0], y1 = v[1], x2 = v[2], y2 = v[3] }
            ret true
        end
        KW_STEPS:
            if a.Len() < 1 or a.Len() > 2:
                ret false
            end
            mut n := 0
            if not p_int(t, a[0], tk.close, cx, n) or n < 1:
                ret false
            end
            mut pos := StepPosition.JumpEnd
            if a.Len() == 2:
                if t[a[1]].k != TK_IDENT:
                    ret false
                end
                switch t[a[1]].id:
                    KW_JUMP_START, KW_START: pos = StepPosition.JumpStart break end
                    KW_JUMP_END, KW_END: pos = StepPosition.JumpEnd break end
                    KW_JUMP_NONE:
                        if n < 2:
                            ret false
                        end
                        pos = StepPosition.JumpNone
                        break
                    end
                    KW_JUMP_BOTH: pos = StepPosition.JumpBoth break end
                    else: ret false end
                end
            end
            out = Timing { kind = TimingKind.Steps, steps = n, step_position = pos }
            ret true
        end
        KW_LINEAR:
            out = Timing { kind = TimingKind.Linear, x1 = 0.0, y1 = 0.0, x2 = 1.0, y2 = 1.0 }
            ret a.Len() >= 1
        end
        else:
            ret false
        end
    end
    ret false
end

func is_generic_family(k: int): bool:
    switch k:
        KW_SERIF, KW_SANS_SERIF, KW_MONOSPACE, KW_CURSIVE, KW_FANTASY, KW_SYSTEM_UI, KW_UI_SERIF, KW_UI_SANS_SERIF, KW_UI_MONOSPACE, KW_UI_ROUNDED, KW_EMOJI, KW_MATH, KW_FANGSONG, KW_X_WEBKIT_BODY:
            ret true
        end
        else:
            ret false
        end
    end
    ret false
end

func family_list(t: Vector<Tok>, s: int, e: int, out &: str): bool:
    mut parts := Vector {} as Vector<int>
    defer parts.free()
    split_commas(t, s, e, parts)
    mut b := str.NewBuilder()
    mut k := 0
    mut ok := true
    until k + 1 < parts.Len():
        ps := parts[k]
        pe := parts[k + 1]
        if ps >= pe:
            ok = false
            break
        end
        if k > 0:
            str.BufAppend(b, ", ")
        end
        if single(t, ps, pe) and t[ps].k == TK_STR:
            str.BufAppend(b, t[ps].s)
        else:
            mut j := ps
            until j < pe:
                if t[j].k != TK_IDENT:
                    ok = false
                    break
                end
                if j > ps:
                    str.BufAppend(b, " ")
                end
                if single(t, ps, pe) and is_generic_family(t[j].id):
                    str.BufAppend(b, t[j].s)
                else:
                    str.BufAppend(b, t[j].raw)
                end
                j++
            end
        end
        k += 2
    end
    r := str.BufStr(b)
    str.BufFree(b)
    if not ok:
        sfree(r)
        ret false
    end
    out = intern_own(r)
    ret true
end

func font_size_kw(k: int, pfs: f64, out &: f64): bool:
    switch k:
        KW_XX_SMALL: out = 9.0 break end
        KW_X_SMALL: out = 10.0 break end
        KW_SMALL: out = 13.0 break end
        KW_MEDIUM: out = 16.0 break end
        KW_LARGE: out = 18.0 break end
        KW_X_LARGE: out = 24.0 break end
        KW_XX_LARGE: out = 32.0 break end
        KW_XXX_LARGE: out = 48.0 break end
        KW_SMALLER: out = pfs / 1.2 break end
        KW_LARGER: out = pfs * 1.2 break end
        KW_MATH: out = pfs break end
        else: ret false end
    end
    ret true
end

func font_weight_of(t: Vector<Tok>, s: int, e: int, cx: Cx, pw: int, out &: int): bool:
    k := kw_id_at(t, s, e)
    switch k:
        KW_NORMAL:
            out = 400
            ret true
        end
        KW_BOLD:
            out = 700
            ret true
        end
        KW_BOLDER:
            out = pw < 350 ? 400 : (pw < 550 ? 700 : 900)
            ret true
        end
        KW_LIGHTER:
            out = pw < 550 ? 100 : (pw < 750 ? 400 : 700)
            ret true
        end
        else:
        end
    end
    mut v := 0.0
    if not single(t, s, e) or not p_num(t, s, e, cx, v) or v < 1.0 or v > 1000.0:
        ret false
    end
    out = math.Floor(v + 0.5) as int
    ret true
end

func font_stretch_of(t: Vector<Tok>, s: int, e: int, out &: f64): bool:
    k := kw_id_at(t, s, e)
    switch k:
        KW_NORMAL: out = 100.0 break end
        KW_ULTRA_CONDENSED: out = 50.0 break end
        KW_EXTRA_CONDENSED: out = 62.5 break end
        KW_CONDENSED: out = 75.0 break end
        KW_SEMI_CONDENSED: out = 87.5 break end
        KW_SEMI_EXPANDED: out = 112.5 break end
        KW_EXPANDED: out = 125.0 break end
        KW_EXTRA_EXPANDED: out = 150.0 break end
        KW_ULTRA_EXPANDED: out = 200.0 break end
        else:
            if single(t, s, e) and t[s].k == TK_PCT and t[s].n >= 0.0:
                out = t[s].n
                ret true
            end
            ret false
        end
    end
    ret true
end

func line_height_of(t: Vector<Tok>, s: int, e: int, cx: Cx, cs &: ComputedStyle): bool:
    if kw_id_at(t, s, e) == KW_NORMAL:
        cs.line_height_normal = true
        cs.line_height_factor = 0.0
        cs.line_height = cx.fs * 1.2
        ret true
    end
    if not single(t, s, e):
        ret false
    end
    mut f := 0.0
    if p_num(t, s, e, cx, f):
        if f < 0.0:
            ret false
        end
        cs.line_height_normal = false
        cs.line_height_factor = f
        cs.line_height = f * cx.fs
        ret true
    end
    mut c2 := cx
    c2.basis = cx.fs
    mut l := Len {}
    if not p_len(t, s, e, c2, true, false, l):
        ret false
    end
    cs.line_height_normal = false
    cs.line_height_factor = 0.0
    cs.line_height = l.px
    ret true
end

func repeat_kw(k: int, out &: Repeat): bool:
    switch k:
        KW_REPEAT: out = Repeat.Repeat break end
        KW_NO_REPEAT: out = Repeat.NoRepeat break end
        KW_SPACE: out = Repeat.Space break end
        KW_ROUND: out = Repeat.Round break end
        else: ret false end
    end
    ret true
end

func area_kw(k: int, allow_text: bool, out &: BoxArea): bool:
    switch k:
        KW_BORDER_BOX: out = BoxArea.BorderBox break end
        KW_PADDING_BOX: out = BoxArea.PaddingBox break end
        KW_CONTENT_BOX: out = BoxArea.ContentBox break end
        KW_TEXT:
            if not allow_text:
                ret false
            end
            out = BoxArea.Text
            break
        end
        else: ret false end
    end
    ret true
end

func apply_bg_list(cs &: ComputedStyle, p: int, t: Vector<Tok>, s: int, e: int, cx: Cx): bool:
    mut parts := Vector {} as Vector<int>
    defer parts.free()
    split_commas(t, s, e, parts)
    n := parts.Len() / 2
    if p == P_BG_IMAGE:
        mut layers := Vector {} as Vector<BgLayer>
        mut k := 0
        until k + 1 < parts.Len():
            mut l := BgLayer {}
            if not parse_image(t, parts[k], parts[k + 1], cx, l):
                l.stops.free()
                free_layers(layers)
                ret false
            end
            layers.push(l)
            k += 2
        end
        free_layers(cs.backgrounds)
        cs.backgrounds = layers
        ret true
    end
    mut vals := Vector {} as Vector<BgLayer>
    defer vals.free()
    mut k := 0
    until k + 1 < parts.Len():
        ps := parts[k]
        pe := parts[k + 1]
        mut l := BgLayer {}
        switch p:
            P_BG_POS_X:
                if not parse_pos_axis(t, ps, pe, cx, true, l.position_x):
                    ret false
                end
                break
            end
            P_BG_POS_Y:
                if not parse_pos_axis(t, ps, pe, cx, false, l.position_y):
                    ret false
                end
                break
            end
            P_BG_SIZE:
                kk := kw_id_at(t, ps, pe)
                if kk == KW_COVER:
                    l.size_kind = SizeKind.Cover
                else kk == KW_CONTAIN:
                    l.size_kind = SizeKind.Contain
                else:
                    c := count_items(t, ps, pe)
                    if c < 1 or c > 2:
                        ret false
                    end
                    mut w := Len {}
                    mut h := Len { kind = LenKind.Auto }
                    if not p_auto_len(t, ps, nxt(t, ps), cx, false, w):
                        ret false
                    end
                    if c == 2 and not p_auto_len(t, nxt(t, ps), pe, cx, false, h):
                        ret false
                    end
                    l.size_w = w
                    l.size_h = h
                end
                break
            end
            P_BG_REPEAT:
                c := count_items(t, ps, pe)
                kk := kw_id_at(t, ps, pe)
                if kk == KW_REPEAT_X:
                    l.repeat_x = Repeat.Repeat
                    l.repeat_y = Repeat.NoRepeat
                else kk == KW_REPEAT_Y:
                    l.repeat_x = Repeat.NoRepeat
                    l.repeat_y = Repeat.Repeat
                else c == 1 and t[ps].k == TK_IDENT:
                    if not repeat_kw(t[ps].id, l.repeat_x):
                        ret false
                    end
                    l.repeat_y = l.repeat_x
                else c == 2 and t[ps].k == TK_IDENT and t[ps + 1].k == TK_IDENT:
                    if not repeat_kw(t[ps].id, l.repeat_x) or not repeat_kw(t[ps + 1].id, l.repeat_y):
                        ret false
                    end
                else:
                    ret false
                end
                break
            end
            P_BG_CLIP:
                if not area_kw(kw_id_at(t, ps, pe), true, l.clip):
                    ret false
                end
                break
            end
            P_BG_ORIGIN:
                if not area_kw(kw_id_at(t, ps, pe), false, l.origin):
                    ret false
                end
                break
            end
            else:
                kk := kw_id_at(t, ps, pe)
                if kk == KW_FIXED:
                    l.fixed = true
                else kk != KW_SCROLL and kk != KW_LOCAL:
                    ret false
                end
            end
        end
        vals.push(l)
        k += 2
    end
    if n == 0:
        ret false
    end
    repeat cs.backgrounds.Len() in i:
        o := vals[i % n]
        mut l := cs.backgrounds.ref(i)
        switch p:
            P_BG_POS_X: l.position_x = o.position_x break end
            P_BG_POS_Y: l.position_y = o.position_y break end
            P_BG_SIZE:
                l.size_kind = o.size_kind
                l.size_w = o.size_w
                l.size_h = o.size_h
                break
            end
            P_BG_REPEAT:
                l.repeat_x = o.repeat_x
                l.repeat_y = o.repeat_y
                break
            end
            P_BG_CLIP: l.clip = o.clip break end
            P_BG_ORIGIN: l.origin = o.origin break end
            else: l.fixed = o.fixed end
        end
    end
    ret true
end

func apply_tr_list(cs &: ComputedStyle, p: int, t: Vector<Tok>, s: int, e: int, cx: Cx): bool:
    mut parts := Vector {} as Vector<int>
    defer parts.free()
    split_commas(t, s, e, parts)
    n := parts.Len() / 2
    if n == 0:
        ret false
    end
    mut vals := Vector {} as Vector<Transition>
    defer vals.free()
    mut k := 0
    until k + 1 < parts.Len():
        ps := parts[k]
        pe := parts[k + 1]
        mut tr := Transition {}
        switch p:
            P_TR_PROPERTY:
                kk := kw_at(t, ps, pe)
                if kk.Len() == 0:
                    ret false
                end
                if t[ps].id == KW_NONE and n > 1:
                    ret false
                end
                tr.property = intern(kk)
                break
            end
            P_TR_DURATION, P_TR_DELAY:
                mut v := 0.0
                if not single(t, ps, pe) or not p_time(t, ps, pe, cx, v):
                    ret false
                end
                if p == P_TR_DURATION:
                    if v < 0.0:
                        ret false
                    end
                    tr.duration = v
                else:
                    tr.delay = v
                end
                break
            end
            else:
                if not single(t, ps, pe) or not timing_of(t, ps, cx, tr.timing):
                    ret false
                end
            end
        end
        vals.push(tr)
        k += 2
    end
    if p == P_TR_PROPERTY:
        mut old := cs.transitions
        mut fresh := Vector {} as Vector<Transition>
        repeat n in i:
            mut tr := Transition { property = vals[i].property }
            if old.Len() > 0:
                o := old[i % old.Len()]
                tr.duration = o.duration
                tr.delay = o.delay
                tr.timing = o.timing
            end
            fresh.push(tr)
        end
        old.free()
        cs.transitions = fresh
        ret true
    end
    repeat cs.transitions.Len() in i:
        o := vals[i % n]
        mut tr := cs.transitions.ref(i)
        switch p:
            P_TR_DURATION: tr.duration = o.duration break end
            P_TR_DELAY: tr.delay = o.delay break end
            else: tr.timing = o.timing end
        end
    end
    ret true
end

func set_len_prop(cs &: ComputedStyle, p: int, l: Len):
    switch p:
        P_TOP: cs.top = l break end
        P_RIGHT: cs.right = l break end
        P_BOTTOM: cs.bottom = l break end
        P_LEFT: cs.left = l break end
        P_WIDTH: cs.width = l break end
        P_HEIGHT: cs.height = l break end
        P_MIN_WIDTH: cs.min_width = l break end
        P_MIN_HEIGHT: cs.min_height = l break end
        P_MAX_WIDTH: cs.max_width = l break end
        P_MAX_HEIGHT: cs.max_height = l break end
        P_MARGIN_TOP: cs.margin_top = l break end
        P_MARGIN_TOP + 1: cs.margin_right = l break end
        P_MARGIN_TOP + 2: cs.margin_bottom = l break end
        P_MARGIN_TOP + 3: cs.margin_left = l break end
        P_PADDING_TOP: cs.padding_top = l break end
        P_PADDING_TOP + 1: cs.padding_right = l break end
        P_PADDING_TOP + 2: cs.padding_bottom = l break end
        P_PADDING_TOP + 3: cs.padding_left = l break end
        P_FLEX_BASIS: cs.flex_basis = l break end
        P_ROW_GAP: cs.row_gap = l break end
        P_COLUMN_GAP: cs.column_gap = l break end
        P_TEXT_INDENT: cs.text_indent = l break end
        P_TD_THICKNESS: cs.decoration_thickness = l break end
        else:
        end
    end
end

func set_corner(cs &: ComputedStyle, k: int, c: Corner):
    switch k:
        0: cs.radius_top_left = c break end
        1: cs.radius_top_right = c break end
        2: cs.radius_bottom_right = c break end
        else: cs.radius_bottom_left = c end
    end
end

func bi_sides(t: Vector<Tok>, s: int, e: int, out &: Vector<int>): bool:
    mut i := s
    until i < e:
        out.push(i)
        i = nxt(t, i)
    end
    ret out.Len() >= 1 and out.Len() <= 4
end

func bi_side_index(n: int, side: int): int:
    pick := [[0, 0, 0, 0], [0, 1, 0, 1], [0, 1, 2, 1], [0, 1, 2, 3]]
    ret pick[n - 1][side]
end

func bi_set(b &: BorderImage, what: int, side: int, l: Len):
    switch what * 4 + side:
        0: b.slice_top = l break end
        1: b.slice_right = l break end
        2: b.slice_bottom = l break end
        3: b.slice_left = l break end
        4: b.width_top = l break end
        5: b.width_right = l break end
        6: b.width_bottom = l break end
        7: b.width_left = l break end
        8: b.outset_top = l break end
        9: b.outset_right = l break end
        10: b.outset_bottom = l break end
        else: b.outset_left = l end
    end
end

func bi_item(t: Vector<Tok>, i: int, e: int, cx: Cx, what: int, out &: Len): bool:
    tk := t[i]
    if tk.k == TK_NUM or (tk.k == TK_FUNC and is_math_fn(tk.s) and what != 1):
        mut n := 0.0
        if p_num(t, i, e, cx, n):
            if n < 0.0:
                ret false
            end
            out = Len { kind = LenKind.Number, px = n }
            ret true
        end
    end
    if what == 0:
        if tk.k == TK_PCT and tk.n >= 0.0:
            out = pct_len(tk.n)
            ret true
        end
        ret false
    end
    if what == 1 and tk.k == TK_IDENT and tk.id == KW_AUTO:
        out = Len { kind = LenKind.Auto }
        ret true
    end
    ret p_len(t, i, e, cx, what == 1, false, out)
end

func apply_border_image(cs &: ComputedStyle, p: int, t: Vector<Tok>, s: int, e: int, cx: Cx): bool:
    if p == P_BI_SOURCE:
        mut l := BgLayer {}
        l.stops = Vector {} as Vector<ColorStop>
        if kw_id_at(t, s, e) != KW_NONE and not parse_image(t, s, e, cx, l):
            l.stops.free()
            ret false
        end
        cs.border_image.source.stops.free()
        cs.border_image.source = l
        ret true
    end
    if p == P_BI_REPEAT:
        c := count_items(t, s, e)
        if c < 1 or c > 2:
            ret false
        end
        mut rx := Repeat.Stretch
        mut ry := Repeat.Stretch
        if not bi_repeat_kw(t[s].id, rx):
            ret false
        end
        ry = rx
        if c == 2 and not bi_repeat_kw(t[nxt(t, s)].id, ry):
            ret false
        end
        cs.border_image.repeat_x = rx
        cs.border_image.repeat_y = ry
        ret true
    end
    what := p == P_BI_SLICE ? 0 : (p == P_BI_WIDTH ? 1 : 2)
    mut items := Vector {} as Vector<int>
    defer items.free()
    mut fill := false
    mut i := s
    until i < e:
        if what == 0 and t[i].k == TK_IDENT and t[i].id == KW_FILL:
            if fill or (items.Len() > 0 and nxt(t, i) < e):
                ret false
            end
            fill = true
        else:
            items.push(i)
        end
        i = nxt(t, i)
    end
    n := items.Len()
    if n < 1 or n > 4:
        ret false
    end
    mut vals := [Len {}, Len {}, Len {}, Len {}]
    repeat n in k:
        if not bi_item(t, items[k], e, cx, what, vals[k]):
            ret false
        end
    end
    repeat 4 in side:
        bi_set(cs.border_image, what, side, vals[bi_side_index(n, side)])
    end
    if what == 0:
        cs.border_image.fill = fill
    end
    ret true
end

func bi_repeat_kw(k: int, out &: Repeat): bool:
    switch k:
        KW_STRETCH: out = Repeat.Stretch break end
        KW_REPEAT: out = Repeat.Repeat break end
        KW_ROUND: out = Repeat.Round break end
        KW_SPACE: out = Repeat.Space break end
        else: ret false end
    end
    ret true
end

func apply_prop(cs &: ComputedStyle, p: int, t: Vector<Tok>, s: int, e: int, cx: Cx): bool:
    if s >= e:
        ret false
    end
    k := kw_id_at(t, s, e)
    if p >= P_GRID_TEMPLATE_COLUMNS and p <= P_CAPTION_SIDE:
        ret apply_grid_prop(cs, p, t, s, e, cx)
    end
    if p >= P_TOP and p <= P_LEFT:
        mut l := Len {}
        if not p_auto_len(t, s, e, cx, true, l):
            ret false
        end
        set_len_prop(cs, p, l)
        ret true
    end
    if p >= P_MARGIN_TOP and p < P_MARGIN_TOP + 4:
        mut l := Len {}
        if not p_auto_len(t, s, e, cx, true, l):
            ret false
        end
        set_len_prop(cs, p, l)
        ret true
    end
    if p >= P_PADDING_TOP and p < P_PADDING_TOP + 4:
        mut l := Len {}
        if not single(t, s, e) or not p_len(t, s, e, cx, true, false, l):
            ret false
        end
        set_len_prop(cs, p, l)
        ret true
    end
    if p >= P_BORDER_TOP_WIDTH and p < P_BORDER_TOP_WIDTH + 4:
        mut w := 0.0
        if not border_width_of(t, s, e, cx, w):
            ret false
        end
        mut sd := side_of(cs, p - P_BORDER_TOP_WIDTH)
        sd.width = snap_border(w)
        set_side(cs, p - P_BORDER_TOP_WIDTH, sd)
        ret true
    end
    if p >= P_BORDER_TOP_STYLE and p < P_BORDER_TOP_STYLE + 4:
        mut sd := side_of(cs, p - P_BORDER_TOP_STYLE)
        if not border_style_of(k, false, sd.style):
            ret false
        end
        set_side(cs, p - P_BORDER_TOP_STYLE, sd)
        ret true
    end
    if p >= P_BORDER_TOP_COLOR and p < P_BORDER_TOP_COLOR + 4:
        mut sd := side_of(cs, p - P_BORDER_TOP_COLOR)
        if not parse_color_at(t, s, e, cx.dark, cx.color, sd.color):
            ret false
        end
        set_side(cs, p - P_BORDER_TOP_COLOR, sd)
        ret true
    end
    if p >= P_RADIUS_TL and p < P_RADIUS_TL + 4:
        c := count_items(t, s, e)
        if c < 1 or c > 2:
            ret false
        end
        mut h := Len {}
        if not p_len(t, s, e, cx, true, false, h):
            ret false
        end
        mut v := h
        if c == 2 and not p_len(t, nxt(t, s), e, cx, true, false, v):
            ret false
        end
        set_corner(cs, p - P_RADIUS_TL, Corner { h = h, v = v })
        ret true
    end
    if p >= P_BG_IMAGE and p <= P_BG_ATTACH:
        ret apply_bg_list(cs, p, t, s, e, cx)
    end
    if p >= P_TR_PROPERTY and p <= P_TR_DELAY:
        ret apply_tr_list(cs, p, t, s, e, cx)
    end
    if p >= P_BI_SOURCE and p <= P_BI_REPEAT:
        ret apply_border_image(cs, p, t, s, e, cx)
    end
    switch p:
        P_DISPLAY:
            ret display_of(t, s, e, cs.display)
        end
        P_POSITION:
            switch k:
                KW_STATIC: cs.position = cssbox.Position.Static break end
                KW_RELATIVE: cs.position = cssbox.Position.Relative break end
                KW_ABSOLUTE: cs.position = cssbox.Position.Absolute break end
                KW_FIXED: cs.position = cssbox.Position.Fixed break end
                KW_STICKY, KW_X_WEBKIT_STICKY: cs.position = cssbox.Position.Sticky break end
                else: ret false end
            end
            break
        end
        P_BOX_SIZING:
            switch k:
                KW_CONTENT_BOX: cs.box_sizing = cssbox.BoxSizing.ContentBox break end
                KW_BORDER_BOX: cs.box_sizing = cssbox.BoxSizing.BorderBox break end
                else: ret false end
            end
            break
        end
        P_WIDTH, P_HEIGHT, P_MIN_WIDTH, P_MIN_HEIGHT, P_FLEX_BASIS:
            mut l := Len {}
            if k == KW_CONTENT and p == P_FLEX_BASIS:
                l = Len { kind = LenKind.Content }
            else not p_size_len(t, s, e, cx, KW_AUTO, l):
                ret false
            end
            set_len_prop(cs, p, l)
            break
        end
        P_MAX_WIDTH, P_MAX_HEIGHT:
            mut l := Len {}
            if not p_size_len(t, s, e, cx, KW_NONE, l):
                ret false
            end
            set_len_prop(cs, p, l)
            break
        end
        P_ASPECT_RATIO:
            mut i := s
            mut ratio := 0.0
            mut seen := false
            until i < e:
                if is_kw_id(t, i, e, KW_AUTO):
                    i++
                    continue
                end
                if seen:
                    ret false
                end
                mut a := 0.0
                if not p_num(t, i, e, cx, a) or a < 0.0:
                    ret false
                end
                i = nxt(t, i)
                mut b := 1.0
                if is_delim(t, i, e, 47):
                    if not p_num(t, i + 1, e, cx, b) or b < 0.0:
                        ret false
                    end
                    i = nxt(t, i + 1)
                end
                ratio = b > 0.0 ? a / b : 0.0
                seen = true
            end
            cs.aspect_ratio = ratio
            break
        end
        P_OVERFLOW_X:
            ret overflow_of(k, cs.overflow_x)
        end
        P_OVERFLOW_Y:
            ret overflow_of(k, cs.overflow_y)
        end
        P_DIRECTION:
            switch k:
                KW_LTR: cs.direction = cssbox.Direction.Ltr break end
                KW_RTL: cs.direction = cssbox.Direction.Rtl break end
                else: ret false end
            end
            break
        end
        P_FLEX_DIRECTION:
            switch k:
                KW_ROW: cs.flex_direction = cssbox.FlexDirection.Row break end
                KW_ROW_REVERSE: cs.flex_direction = cssbox.FlexDirection.RowReverse break end
                KW_COLUMN: cs.flex_direction = cssbox.FlexDirection.Column break end
                KW_COLUMN_REVERSE: cs.flex_direction = cssbox.FlexDirection.ColumnReverse break end
                else: ret false end
            end
            break
        end
        P_FLEX_WRAP:
            switch k:
                KW_NOWRAP: cs.flex_wrap = cssbox.FlexWrap.NoWrap break end
                KW_WRAP: cs.flex_wrap = cssbox.FlexWrap.Wrap break end
                KW_WRAP_REVERSE: cs.flex_wrap = cssbox.FlexWrap.WrapReverse break end
                else: ret false end
            end
            break
        end
        P_FLEX_GROW, P_FLEX_SHRINK:
            mut v := 0.0
            if not single(t, s, e) or not p_num(t, s, e, cx, v) or v < 0.0:
                ret false
            end
            if p == P_FLEX_GROW:
                cs.flex_grow = v
            else:
                cs.flex_shrink = v
            end
            break
        end
        P_JUSTIFY_CONTENT:
            ret align_of(t, s, e, false, cs.justify_content)
        end
        P_ALIGN_ITEMS:
            ret align_of(t, s, e, false, cs.align_items)
        end
        P_ALIGN_SELF:
            ret align_of(t, s, e, true, cs.align_self)
        end
        P_ALIGN_CONTENT:
            ret align_of(t, s, e, false, cs.align_content)
        end
        P_JUSTIFY_ITEMS:
            ret align_of(t, s, e, false, cs.justify_items)
        end
        P_JUSTIFY_SELF:
            ret align_of(t, s, e, true, cs.justify_self)
        end
        P_ROW_GAP, P_COLUMN_GAP:
            mut l := Len {}
            if k == KW_NORMAL:
                l = Len { kind = LenKind.Normal }
            else not single(t, s, e) or not p_len(t, s, e, cx, true, false, l):
                ret false
            end
            set_len_prop(cs, p, l)
            break
        end
        P_ORDER:
            mut v := 0
            if not single(t, s, e) or not p_int(t, s, e, cx, v):
                ret false
            end
            cs.order = v
            break
        end
        P_Z_INDEX:
            if k == KW_AUTO:
                cs.z_auto = true
                cs.z_index = 0
            else:
                mut v := 0
                if not single(t, s, e) or not p_int(t, s, e, cx, v):
                    ret false
                end
                cs.z_auto = false
                cs.z_index = v
            end
            break
        end
        P_FLOAT:
            switch k:
                KW_NONE: cs.float_mode = Float.None break end
                KW_LEFT: cs.float_mode = Float.Left break end
                KW_RIGHT: cs.float_mode = Float.Right break end
                KW_INLINE_START: cs.float_mode = cx.rtl ? Float.Right : Float.Left break end
                KW_INLINE_END: cs.float_mode = cx.rtl ? Float.Left : Float.Right break end
                else: ret false end
            end
            break
        end
        P_CLEAR:
            switch k:
                KW_NONE: cs.clear = Clear.None break end
                KW_LEFT: cs.clear = Clear.Left break end
                KW_RIGHT: cs.clear = Clear.Right break end
                KW_BOTH: cs.clear = Clear.Both break end
                KW_INLINE_START: cs.clear = cx.rtl ? Clear.Right : Clear.Left break end
                KW_INLINE_END: cs.clear = cx.rtl ? Clear.Left : Clear.Right break end
                else: ret false end
            end
            break
        end
        P_VERTICAL_ALIGN:
            switch k:
                KW_BASELINE: cs.vertical_align = VerticalAlign.Baseline break end
                KW_SUB: cs.vertical_align = VerticalAlign.Sub break end
                KW_SUPER: cs.vertical_align = VerticalAlign.Super break end
                KW_TOP: cs.vertical_align = VerticalAlign.Top break end
                KW_TEXT_TOP: cs.vertical_align = VerticalAlign.TextTop break end
                KW_MIDDLE: cs.vertical_align = VerticalAlign.Middle break end
                KW_BOTTOM: cs.vertical_align = VerticalAlign.Bottom break end
                KW_TEXT_BOTTOM: cs.vertical_align = VerticalAlign.TextBottom break end
                else:
                    mut c2 := cx
                    c2.basis = cs.line_height
                    mut l := Len {}
                    if not single(t, s, e) or not p_len(t, s, e, c2, true, true, l):
                        ret false
                    end
                    cs.vertical_align = VerticalAlign.Length
                    cs.vertical_align_len = l
                end
            end
            break
        end
        P_COLOR:
            ret parse_color_at(t, s, e, cx.dark, cx.pcolor, cs.color)
        end
        P_BG_COLOR:
            ret parse_color_at(t, s, e, cx.dark, cx.color, cs.background_color)
        end
        P_BOX_SHADOW, P_TEXT_SHADOW:
            mut list := Vector {} as Vector<Shadow>
            if not parse_shadow_list(t, s, e, cx, p == P_TEXT_SHADOW, list):
                list.free()
                ret false
            end
            if p == P_BOX_SHADOW:
                cs.box_shadows.free()
                cs.box_shadows = list
            else:
                cs.text_shadows.free()
                cs.text_shadows = list
            end
            break
        end
        P_OUTLINE_WIDTH:
            mut w := 0.0
            if not border_width_of(t, s, e, cx, w):
                ret false
            end
            cs.outline.width = snap_border(w)
            break
        end
        P_OUTLINE_STYLE:
            ret border_style_of(k, true, cs.outline.style)
        end
        P_OUTLINE_COLOR:
            if k == KW_INVERT or k == KW_AUTO:
                cs.outline.color = cx.color
                ret true
            end
            ret parse_color_at(t, s, e, cx.dark, cx.color, cs.outline.color)
        end
        P_OUTLINE_OFFSET:
            mut l := Len {}
            if not single(t, s, e) or not p_len(t, s, e, cx, false, true, l) or l.calc.Len() > 0:
                ret false
            end
            cs.outline_offset = l.px
            break
        end
        P_OPACITY:
            mut v := 0.0
            if not single(t, s, e) or not p_num_or_pct(t, s, e, cx, v):
                ret false
            end
            cs.opacity = clamp01(v)
            break
        end
        P_TRANSFORM:
            mut list := Vector {} as Vector<TransformFn>
            if k != KW_NONE:
                mut i := s
                until i < e:
                    mut fnv := TransformFn {}
                    if t[i].k != TK_FUNC or not parse_transform_fn(t, i, cx, fnv):
                        list.free()
                        ret false
                    end
                    list.push(fnv)
                    i = nxt(t, i)
                end
            end
            cs.transforms.free()
            cs.transforms = list
            break
        end
        P_FILTER, P_BACKDROP_FILTER:
            mut list := Vector {} as Vector<FilterFn>
            if k != KW_NONE:
                mut i := s
                until i < e:
                    mut fv := FilterFn {}
                    if t[i].k != TK_FUNC or not parse_filter_fn(t, i, cx, fv):
                        list.free()
                        ret false
                    end
                    list.push(fv)
                    i = nxt(t, i)
                end
            end
            if p == P_FILTER:
                cs.filters.free()
                cs.filters = list
            else:
                cs.backdrop_filters.free()
                cs.backdrop_filters = list
            end
            break
        end
        P_TRANSFORM_ORIGIN, P_OBJECT_POSITION:
            mut ox := Len {}
            mut oy := Len {}
            mut e2 := e
            if p == P_TRANSFORM_ORIGIN and count_items(t, s, e) == 3:
                mut last := s
                mut i := s
                until i < e:
                    last = i
                    i = nxt(t, i)
                end
                if t[last].k != TK_DIM and t[last].k != TK_NUM:
                    ret false
                end
                e2 = last
            end
            if not parse_position(t, s, e2, cx, ox, oy):
                ret false
            end
            if p == P_TRANSFORM_ORIGIN:
                cs.transform_origin_x = ox
                cs.transform_origin_y = oy
            else:
                cs.object_position_x = ox
                cs.object_position_y = oy
            end
            break
        end
        P_TRANSLATE:
            if k == KW_NONE:
                cs.translate_x = Len {}
                cs.translate_y = Len {}
                ret true
            end
            c := count_items(t, s, e)
            if c < 1 or c > 3:
                ret false
            end
            mut x := Len {}
            mut y := Len {}
            if not p_len(t, s, e, cx, true, true, x):
                ret false
            end
            if c >= 2 and not p_len(t, nxt(t, s), e, cx, true, true, y):
                ret false
            end
            cs.translate_x = x
            cs.translate_y = y
            break
        end
        P_ROTATE:
            if k == KW_NONE:
                cs.rotate = 0.0
                ret true
            end
            mut i := s
            mut found := false
            until i < e:
                mut a := 0.0
                if p_angle(t, i, e, cx, false, a):
                    cs.rotate = a
                    found = true
                end
                i = nxt(t, i)
            end
            ret found
        end
        P_SCALE:
            if k == KW_NONE:
                cs.scale_x = 1.0
                cs.scale_y = 1.0
                ret true
            end
            c := count_items(t, s, e)
            if c < 1 or c > 3:
                ret false
            end
            mut sx := 1.0
            if not p_num_or_pct(t, s, e, cx, sx):
                ret false
            end
            mut sy := sx
            if c >= 2 and not p_num_or_pct(t, nxt(t, s), e, cx, sy):
                ret false
            end
            cs.scale_x = sx
            cs.scale_y = sy
            break
        end
        P_VISIBILITY:
            switch k:
                KW_VISIBLE: cs.visibility = Visibility.Visible break end
                KW_HIDDEN: cs.visibility = Visibility.Hidden break end
                KW_COLLAPSE: cs.visibility = Visibility.Collapse break end
                else: ret false end
            end
            break
        end
        P_CURSOR:
            mut i := s
            mut last := ""
            until i < e:
                if t[i].k == TK_IDENT:
                    last = t[i].s
                end
                i = nxt(t, i)
            end
            if last.Len() == 0:
                ret false
            end
            cs.cursor = intern(last)
            break
        end
        P_POINTER_EVENTS:
            if not ident_at(t, s, e):
                ret false
            end
            cs.pointer_events = k != KW_NONE
            break
        end
        P_USER_SELECT:
            switch k:
                KW_AUTO, KW_CONTAIN: cs.user_select = UserSelect.Auto break end
                KW_NONE: cs.user_select = UserSelect.None break end
                KW_TEXT: cs.user_select = UserSelect.Text break end
                KW_ALL: cs.user_select = UserSelect.All break end
                else: ret false end
            end
            break
        end
        P_FONT_FAMILY:
            ret family_list(t, s, e, cs.font_family)
        end
        P_FONT_SIZE:
            base := cx.mono ? 13.0 : 16.0
            mut v := 0.0
            mut kwf := 0.0
            if k >= 0:
                if not font_size_kw(k, cx.pfs, v):
                    ret false
                end
                if k == KW_LARGER or k == KW_SMALLER:
                    if cx.pkw > 0.0:
                        kwf = k == KW_LARGER ? cx.pkw * 1.2 : cx.pkw / 1.2
                    end
                else k != KW_MATH:
                    kwf = v / 16.0
                else:
                    kwf = cx.pkw
                end
            else:
                mut c2 := cx
                c2.fs = cx.pfs
                c2.basis = cx.pfs
                mut l := Len {}
                if not single(t, s, e) or not p_len(t, s, e, c2, true, false, l):
                    ret false
                end
                v = l.px
                tk := t[s]
                relative := tk.k == TK_PCT or (tk.k == TK_DIM and (tk.id == KW_EM or tk.id == KW_EX or tk.id == KW_CH))
                if relative and cx.pkw > 0.0 and cx.pfs > 0.0:
                    kwf = cx.pkw * v / cx.pfs
                end
            end
            if kwf > 0.0:
                v = kwf * base
            end
            cs.font_size = v
            cs.font_size_keyword = kwf
            break
        end
        P_FONT_WEIGHT:
            ret font_weight_of(t, s, e, cx, cs.font_weight, cs.font_weight)
        end
        P_FONT_STYLE:
            switch k:
                KW_NORMAL: cs.font_style = FontStyle.Normal break end
                KW_ITALIC: cs.font_style = FontStyle.Italic break end
                KW_OBLIQUE: cs.font_style = FontStyle.Oblique break end
                else:
                    if is_kw_id(t, s, e, KW_OBLIQUE) and count_items(t, s, e) == 2:
                        mut a := 0.0
                        if not p_angle(t, s + 1, e, cx, true, a):
                            ret false
                        end
                        cs.font_style = FontStyle.Oblique
                        ret true
                    end
                    ret false
                end
            end
            break
        end
        P_FONT_VARIANT_CAPS:
            switch k:
                KW_NORMAL, KW_UNICASE, KW_TITLING_CAPS: cs.small_caps = false break end
                KW_SMALL_CAPS, KW_ALL_SMALL_CAPS, KW_PETITE_CAPS, KW_ALL_PETITE_CAPS: cs.small_caps = true break end
                else: ret false end
            end
            break
        end
        P_FONT_STRETCH:
            ret font_stretch_of(t, s, e, cs.font_stretch)
        end
        P_LINE_HEIGHT:
            ret line_height_of(t, s, e, cx, cs)
        end
        P_LETTER_SPACING, P_WORD_SPACING:
            mut v := 0.0
            if k != KW_NORMAL:
                mut c2 := cx
                c2.basis = cx.fs
                mut l := Len {}
                if not single(t, s, e) or not p_len(t, s, e, c2, true, true, l):
                    ret false
                end
                v = l.px
            end
            if p == P_LETTER_SPACING:
                cs.letter_spacing = v
            else:
                cs.word_spacing = v
            end
            break
        end
        P_TEXT_ALIGN:
            switch k:
                KW_START: cs.text_align = TextAlign.Start break end
                KW_END: cs.text_align = TextAlign.End break end
                KW_LEFT, KW_X_WEBKIT_LEFT: cs.text_align = TextAlign.Left break end
                KW_RIGHT, KW_X_WEBKIT_RIGHT: cs.text_align = TextAlign.Right break end
                KW_CENTER, KW_X_WEBKIT_CENTER: cs.text_align = TextAlign.Center break end
                KW_JUSTIFY: cs.text_align = TextAlign.Justify break end
                KW_MATCH_PARENT: cs.text_align = TextAlign.MatchParent break end
                else: ret false end
            end
            break
        end
        P_TEXT_INDENT:
            mut l := Len {}
            mut found := false
            mut i := s
            until i < e:
                if t[i].k == TK_IDENT:
                    if t[i].id != KW_HANGING and t[i].id != KW_EACH_LINE:
                        ret false
                    end
                else:
                    if found or not p_len(t, i, e, cx, true, true, l):
                        ret false
                    end
                    found = true
                end
                i = nxt(t, i)
            end
            if not found:
                ret false
            end
            cs.text_indent = l
            break
        end
        P_TEXT_TRANSFORM:
            switch k:
                KW_NONE: cs.text_transform = TextTransform.None break end
                KW_CAPITALIZE: cs.text_transform = TextTransform.Capitalize break end
                KW_UPPERCASE: cs.text_transform = TextTransform.Uppercase break end
                KW_LOWERCASE: cs.text_transform = TextTransform.Lowercase break end
                KW_FULL_WIDTH: cs.text_transform = TextTransform.FullWidth break end
                else: ret false end
            end
            break
        end
        P_WHITE_SPACE:
            switch k:
                KW_NORMAL: cs.white_space = WhiteSpace.Normal break end
                KW_PRE: cs.white_space = WhiteSpace.Pre break end
                KW_NOWRAP: cs.white_space = WhiteSpace.NoWrap break end
                KW_PRE_WRAP: cs.white_space = WhiteSpace.PreWrap break end
                KW_PRE_LINE: cs.white_space = WhiteSpace.PreLine break end
                KW_BREAK_SPACES: cs.white_space = WhiteSpace.BreakSpaces break end
                else: ret false end
            end
            break
        end
        P_TD_LINE:
            mut u := false
            mut o := false
            mut strike := false
            if k != KW_NONE:
                mut i := s
                until i < e:
                    if t[i].k != TK_IDENT:
                        ret false
                    end
                    switch t[i].id:
                        KW_UNDERLINE: u = true break end
                        KW_OVERLINE: o = true break end
                        KW_LINE_THROUGH: strike = true break end
                        KW_BLINK, KW_SPELLING_ERROR, KW_GRAMMAR_ERROR: break end
                        else: ret false end
                    end
                    i++
                end
            end
            cs.underline = u
            cs.overline = o
            cs.line_through = strike
            break
        end
        P_TD_STYLE:
            switch k:
                KW_SOLID: cs.decoration_style = DecorationStyle.Solid break end
                KW_DOUBLE: cs.decoration_style = DecorationStyle.Double break end
                KW_DOTTED: cs.decoration_style = DecorationStyle.Dotted break end
                KW_DASHED: cs.decoration_style = DecorationStyle.Dashed break end
                KW_WAVY: cs.decoration_style = DecorationStyle.Wavy break end
                else: ret false end
            end
            break
        end
        P_TD_COLOR:
            ret parse_color_at(t, s, e, cx.dark, cx.color, cs.decoration_color)
        end
        P_TD_THICKNESS:
            if k == KW_AUTO or k == KW_FROM_FONT:
                cs.decoration_thickness = Len { kind = LenKind.Auto }
                ret true
            end
            mut c2 := cx
            c2.basis = cx.fs
            mut l := Len {}
            if not single(t, s, e) or not p_len(t, s, e, c2, true, false, l):
                ret false
            end
            cs.decoration_thickness = l
            break
        end
        P_TEXT_OVERFLOW:
            switch k:
                KW_CLIP: cs.text_overflow = TextOverflow.Clip break end
                KW_ELLIPSIS: cs.text_overflow = TextOverflow.Ellipsis break end
                else:
                    if single(t, s, e) and t[s].k == TK_STR:
                        cs.text_overflow = TextOverflow.Clip
                        ret true
                    end
                    ret false
                end
            end
            break
        end
        P_WORD_BREAK:
            switch k:
                KW_NORMAL, KW_AUTO_PHRASE: cs.word_break = WordBreak.Normal break end
                KW_BREAK_ALL: cs.word_break = WordBreak.BreakAll break end
                KW_KEEP_ALL: cs.word_break = WordBreak.KeepAll break end
                KW_BREAK_WORD: cs.word_break = WordBreak.BreakWord break end
                else: ret false end
            end
            break
        end
        P_OVERFLOW_WRAP:
            switch k:
                KW_NORMAL: cs.overflow_wrap = OverflowWrap.Normal break end
                KW_ANYWHERE: cs.overflow_wrap = OverflowWrap.Anywhere break end
                KW_BREAK_WORD: cs.overflow_wrap = OverflowWrap.BreakWord break end
                else: ret false end
            end
            break
        end
        P_TAB_SIZE:
            mut v := 0.0
            if single(t, s, e) and p_num(t, s, e, cx, v):
                if v < 0.0:
                    ret false
                end
                cs.tab_size = v
                cs.tab_size_px = 0.0
                ret true
            end
            mut l := Len {}
            if not single(t, s, e) or not p_len(t, s, e, cx, false, false, l):
                ret false
            end
            cs.tab_size = 0.0
            cs.tab_size_px = l.px
            break
        end
        P_LIST_TYPE:
            if single(t, s, e) and t[s].k == TK_STR:
                cs.list_style_type = intern("\"" + t[s].s + "\"")
                ret true
            end
            if not ident_at(t, s, e):
                ret false
            end
            cs.list_style_type = intern(t[s].s)
            break
        end
        P_LIST_POSITION:
            switch k:
                KW_OUTSIDE: cs.list_style_position = ListPosition.Outside break end
                KW_INSIDE: cs.list_style_position = ListPosition.Inside break end
                else: ret false end
            end
            break
        end
        P_LIST_IMAGE:
            if k == KW_NONE:
                cs.list_style_image = ""
                ret true
            end
            mut l := BgLayer {}
            ok := parse_image(t, s, e, cx, l)
            l.stops.free()
            if not ok or l.image != ImageKind.Url:
                ret false
            end
            cs.list_style_image = l.url
            break
        end
        P_BORDER_COLLAPSE:
            switch k:
                KW_SEPARATE: cs.border_collapse = BorderCollapse.Separate break end
                KW_COLLAPSE: cs.border_collapse = BorderCollapse.Collapse break end
                else: ret false end
            end
            break
        end
        P_BORDER_SPACING:
            c := count_items(t, s, e)
            if c < 1 or c > 2:
                ret false
            end
            mut h := Len {}
            if not p_len(t, s, e, cx, false, false, h) or h.calc.Len() > 0:
                ret false
            end
            mut v := h
            if c == 2 and (not p_len(t, nxt(t, s), e, cx, false, false, v) or v.calc.Len() > 0):
                ret false
            end
            cs.border_spacing_x = h.px
            cs.border_spacing_y = v.px
            break
        end
        P_TABLE_LAYOUT:
            switch k:
                KW_AUTO: cs.table_layout = TableLayout.Auto break end
                KW_FIXED: cs.table_layout = TableLayout.Fixed break end
                else: ret false end
            end
            break
        end
        P_CARET_COLOR:
            if k == KW_AUTO:
                cs.caret_color = cx.color
                ret true
            end
            ret parse_color_at(t, s, e, cx.dark, cx.color, cs.caret_color)
        end
        P_ACCENT_COLOR:
            if k == KW_AUTO:
                cs.accent_auto = true
                mut ac := Color {}
                _ok := system_color("accentcolor", cx.dark, ac)
                cs.accent_color = ac
                ret true
            end
            if not parse_color_at(t, s, e, cx.dark, cx.color, cs.accent_color):
                ret false
            end
            cs.accent_auto = false
            break
        end
        P_APPEARANCE:
            if not ident_at(t, s, e):
                ret false
            end
            cs.appearance = intern(t[s].s)
            break
        end
        P_COLOR_SCHEME:
            if k == KW_NORMAL:
                cs.color_scheme = ColorScheme.Normal
                ret true
            end
            mut light := false
            mut dark := false
            mut i := s
            until i < e:
                if t[i].k != TK_IDENT:
                    ret false
                end
                if t[i].id == KW_LIGHT:
                    light = true
                else t[i].id == KW_DARK:
                    dark = true
                end
                i++
            end
            if light and dark:
                cs.color_scheme = ColorScheme.LightDark
            else dark:
                cs.color_scheme = ColorScheme.Dark
            else light:
                cs.color_scheme = ColorScheme.Light
            else:
                cs.color_scheme = ColorScheme.Normal
            end
            break
        end
        P_OBJECT_FIT:
            switch k:
                KW_FILL: cs.object_fit = ObjectFit.Fill break end
                KW_CONTAIN: cs.object_fit = ObjectFit.Contain break end
                KW_COVER: cs.object_fit = ObjectFit.Cover break end
                KW_NONE: cs.object_fit = ObjectFit.None break end
                KW_SCALE_DOWN: cs.object_fit = ObjectFit.ScaleDown break end
                else: ret false end
            end
            break
        end
        else:
            ret false
        end
    end
    ret true
end
