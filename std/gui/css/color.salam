package css

import str
import math

mut g_colors := HashMap {} as HashMap<str, int>
mut g_colors_ready := false

func init_colors():
    if g_colors_ready:
        ret
    end
    g_colors_ready = true
    table := "aliceblue f0f8ff antiquewhite faebd7 aqua 00ffff aquamarine 7fffd4 azure f0ffff beige f5f5dc bisque ffe4c4 black 000000 blanchedalmond ffebcd blue 0000ff blueviolet 8a2be2 brown a52a2a burlywood deb887 cadetblue 5f9ea0 chartreuse 7fff00 chocolate d2691e coral ff7f50 cornflowerblue 6495ed cornsilk fff8dc crimson dc143c cyan 00ffff darkblue 00008b darkcyan 008b8b darkgoldenrod b8860b darkgray a9a9a9 darkgreen 006400 darkgrey a9a9a9 darkkhaki bdb76b darkmagenta 8b008b darkolivegreen 556b2f darkorange ff8c00 darkorchid 9932cc darkred 8b0000 darksalmon e9967a darkseagreen 8fbc8f darkslateblue 483d8b darkslategray 2f4f4f darkslategrey 2f4f4f darkturquoise 00ced1 darkviolet 9400d3 deeppink ff1493 deepskyblue 00bfff dimgray 696969 dimgrey 696969 dodgerblue 1e90ff firebrick b22222 floralwhite fffaf0 forestgreen 228b22 fuchsia ff00ff gainsboro dcdcdc ghostwhite f8f8ff gold ffd700 goldenrod daa520 gray 808080 green 008000 greenyellow adff2f grey 808080 honeydew f0fff0 hotpink ff69b4 indianred cd5c5c indigo 4b0082 ivory fffff0 khaki f0e68c lavender e6e6fa lavenderblush fff0f5 lawngreen 7cfc00 lemonchiffon fffacd lightblue add8e6 lightcoral f08080 lightcyan e0ffff lightgoldenrodyellow fafad2 lightgray d3d3d3 lightgreen 90ee90 lightgrey d3d3d3 lightpink ffb6c1 lightsalmon ffa07a lightseagreen 20b2aa lightskyblue 87cefa lightslategray 778899 lightslategrey 778899 lightsteelblue b0c4de lightyellow ffffe0 lime 00ff00 limegreen 32cd32 linen faf0e6 magenta ff00ff maroon 800000 mediumaquamarine 66cdaa mediumblue 0000cd mediumorchid ba55d3 mediumpurple 9370db mediumseagreen 3cb371 mediumslateblue 7b68ee mediumspringgreen 00fa9a mediumturquoise 48d1cc mediumvioletred c71585 midnightblue 191970 mintcream f5fffa mistyrose ffe4e1 moccasin ffe4b5 navajowhite ffdead navy 000080 oldlace fdf5e6 olive 808000 olivedrab 6b8e23 orange ffa500 orangered ff4500 orchid da70d6 palegoldenrod eee8aa palegreen 98fb98 paleturquoise afeeee palevioletred db7093 papayawhip ffefd5 peachpuff ffdab9 peru cd853f pink ffc0cb plum dda0dd powderblue b0e0e6 purple 800080 rebeccapurple 663399 red ff0000 rosybrown bc8f8f royalblue 4169e1 saddlebrown 8b4513 salmon fa8072 sandybrown f4a460 seagreen 2e8b57 seashell fff5ee sienna a0522d silver c0c0c0 skyblue 87ceeb slateblue 6a5acd slategray 708090 slategrey 708090 snow fffafa springgreen 00ff7f steelblue 4682b4 tan d2b48c teal 008080 thistle d8bfd8 tomato ff6347 turquoise 40e0d0 violet ee82ee wheat f5deb3 white ffffff whitesmoke f5f5f5 yellow ffff00 yellowgreen 9acd32"
    mut parts := str.Fields(table)
    mut i := 0
    until i + 1 < parts.len():
        g_colors.put(parts[i], hex_value(parts[i + 1]))
        i += 2
    end
    parts.free()
end

func hex_digit(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    if c >= 65 and c <= 70:
        ret c - 55
    end
    ret -1
end

func hex_value(s: str): int:
    p := (s as void*) as u8*
    mut v := 0
    repeat s.len() in i:
        v = v * 16 + hex_digit(p[i] as int)
    end
    ret v
end

func rgb_of(v: int, a: int): Color:
    ret Color { r = (v >> 16) & 255, g = (v >> 8) & 255, b = v & 255, a = a }
end

func clamp255(v: f64): int:
    if v != v:
        ret 0
    end
    r := math.Floor(v + 0.5)
    if r < 0.0:
        ret 0
    end
    if r > 255.0:
        ret 255
    end
    ret r as int
end

func clamp01(v: f64): f64:
    if v < 0.0:
        ret 0.0
    end
    if v > 1.0:
        ret 1.0
    end
    ret v
end

func parse_hex_color(h: str, out &: Color): bool:
    n := h.len()
    p := (h as void*) as u8*
    repeat n in i:
        if hex_digit(p[i] as int) < 0:
            ret false
        end
    end
    if n == 3 or n == 4:
        r := hex_digit(p[0] as int)
        g := hex_digit(p[1] as int)
        b := hex_digit(p[2] as int)
        mut a := 15
        if n == 4:
            a = hex_digit(p[3] as int)
        end
        out = Color { r = r * 17, g = g * 17, b = b * 17, a = a * 17 }
        ret true
    end
    if n == 6 or n == 8:
        r := hex_digit(p[0] as int) * 16 + hex_digit(p[1] as int)
        g := hex_digit(p[2] as int) * 16 + hex_digit(p[3] as int)
        b := hex_digit(p[4] as int) * 16 + hex_digit(p[5] as int)
        mut a := 255
        if n == 8:
            a = hex_digit(p[6] as int) * 16 + hex_digit(p[7] as int)
        end
        out = Color { r = r, g = g, b = b, a = a }
        ret true
    end
    ret false
end

func system_color(name: str, dark: bool, out &: Color): bool:
    switch name:
        "canvas":
            out = dark ? rgb_of(0x121212, 255) : rgb_of(0xffffff, 255)
        end
        "canvastext", "buttontext", "fieldtext", "marktext", "selecteditemtext", "highlighttext", "windowtext":
            if name == "marktext":
                out = rgb_of(0x000000, 255)
            else:
                out = dark ? rgb_of(0xffffff, 255) : rgb_of(0x000000, 255)
            end
        end
        "buttonface":
            out = dark ? rgb_of(0x6b6b6b, 255) : rgb_of(0xefefef, 255)
        end
        "buttonborder":
            out = dark ? rgb_of(0x6b6b6b, 255) : rgb_of(0x767676, 255)
        end
        "field":
            out = dark ? rgb_of(0x3b3b3b, 255) : rgb_of(0xffffff, 255)
        end
        "graytext":
            out = dark ? rgb_of(0x8e8e8e, 255) : rgb_of(0x6d6d6d, 255)
        end
        "linktext":
            out = dark ? rgb_of(0x9e9eff, 255) : rgb_of(0x0000ee, 255)
        end
        "visitedtext":
            out = dark ? rgb_of(0xd0adf0, 255) : rgb_of(0x551a8b, 255)
        end
        "activetext":
            out = dark ? rgb_of(0xff9e9e, 255) : rgb_of(0xff0000, 255)
        end
        "highlight", "selecteditem":
            out = dark ? rgb_of(0x99c8ff, 255) : rgb_of(0x0075ff, 255)
        end
        "mark":
            out = rgb_of(0xffff00, 255)
        end
        "accentcolor":
            out = dark ? rgb_of(0x99c8ff, 255) : rgb_of(0x0075ff, 255)
        end
        "accentcolortext":
            out = dark ? rgb_of(0x000000, 255) : rgb_of(0xffffff, 255)
        end
        "window", "background":
            out = dark ? rgb_of(0x121212, 255) : rgb_of(0xffffff, 255)
        end
        "buttonhighlight", "threedhighlight":
            out = rgb_of(0xdddddd, 255)
        end
        "buttonshadow", "threedshadow", "threeddarkshadow":
            out = rgb_of(0x888888, 255)
        end
        else:
            ret false
        end
    end
    ret true
end

func hue_to_rgb(m1: f64, m2: f64, h0: f64): f64:
    mut h := h0
    if h < 0.0:
        h++
    end
    if h > 1.0:
        h--
    end
    if h * 6.0 < 1.0:
        ret m1 + (m2 - m1) * h * 6.0
    end
    if h * 2.0 < 1.0:
        ret m2
    end
    if h * 3.0 < 2.0:
        ret m1 + (m2 - m1) * (2.0 / 3.0 - h) * 6.0
    end
    ret m1
end

func hsl_color(h0: f64, s0: f64, l0: f64, a: f64): Color:
    mut h := h0 - math.Floor(h0 / 360.0) * 360.0
    h /= 360.0
    s := clamp01(s0)
    l := clamp01(l0)
    m2 := l <= 0.5 ? l * (s + 1.0) : l + s - l * s
    m1 := l * 2.0 - m2
    r := hue_to_rgb(m1, m2, h + 1.0 / 3.0)
    g := hue_to_rgb(m1, m2, h)
    b := hue_to_rgb(m1, m2, h - 1.0 / 3.0)
    ret Color { r = clamp255(r * 255.0), g = clamp255(g * 255.0), b = clamp255(b * 255.0), a = clamp255(clamp01(a) * 255.0) }
end

func hwb_color(h: f64, w0: f64, b0: f64, a: f64): Color:
    w := clamp01(w0)
    bl := clamp01(b0)
    if w + bl >= 1.0:
        g := w / (w + bl)
        v := clamp255(g * 255.0)
        ret Color { r = v, g = v, b = v, a = clamp255(clamp01(a) * 255.0) }
    end
    base := hsl_color(h, 1.0, 0.5, 1.0)
    f := 1.0 - w - bl
    r := (base.r as f64 / 255.0) * f + w
    gg := (base.g as f64 / 255.0) * f + w
    b := (base.b as f64 / 255.0) * f + w
    ret Color { r = clamp255(r * 255.0), g = clamp255(gg * 255.0), b = clamp255(b * 255.0), a = clamp255(clamp01(a) * 255.0) }
end

func angle_deg(t: Tok, out &: f64): bool:
    if t.k == TK_NUM:
        out = t.n
        ret true
    end
    if t.k != TK_DIM:
        ret false
    end
    switch t.s:
        "deg": out = t.n end
        "rad": out = t.n * 180.0 / math.PI end
        "grad": out = t.n * 0.9 end
        "turn": out = t.n * 360.0 end
        else: ret false end
    end
    ret true
end

func color_args(t: Vector<Tok>, s: int, e: int, vals &: Vector<Tok>, alpha &: Tok, has_alpha &: bool): bool:
    mut i := s
    mut commas := false
    mut after_slash := false
    until i < e:
        tk := t[i]
        if tk.k == TK_COMMA:
            commas = true
            i++
            continue
        end
        if tk.k == TK_DELIM and tk.d == 47:
            after_slash = true
            i++
            continue
        end
        if tk.k == TK_FUNC:
            ret false
        end
        if after_slash:
            alpha = tk
            has_alpha = true
        else:
            vals.push(tk)
        end
        i++
    end
    if commas and vals.len() == 4 and not has_alpha:
        alpha = vals.pop()
        has_alpha = true
    end
    ret vals.len() == 3
end

func alpha_of(t: Tok, has: bool): f64:
    if not has:
        ret 1.0
    end
    if t.k == TK_PCT:
        ret clamp01(t.n / 100.0)
    end
    if t.k == TK_NUM:
        ret clamp01(t.n)
    end
    ret 0.0
end

func chan_val(t: Tok, scale: f64): f64:
    if t.k == TK_PCT:
        ret t.n * scale / 100.0
    end
    if t.k == TK_NUM:
        ret t.n
    end
    ret 0.0
end

func parse_color_fn(t: Vector<Tok>, i: int, dark: bool, cur: Color, out &: Color): bool:
    f := t[i]
    s := i + 1
    e := f.close
    if e < 0:
        ret false
    end
    if f.s == "light-dark":
        mut parts := Vector {} as Vector<int>
        defer parts.free()
        split_commas(t, s, e, parts)
        if parts.len() != 4:
            ret false
        end
        mut a := Color {}
        mut b := Color {}
        if not parse_color_at(t, parts[0], parts[1], dark, cur, a) or not parse_color_at(t, parts[2], parts[3], dark, cur, b):
            ret false
        end
        out = dark ? b : a
        ret true
    end
    mut vals := Vector {} as Vector<Tok>
    defer vals.free()
    mut al := Tok {}
    mut has_a := false
    if not color_args(t, s, e, vals, al, has_a):
        ret false
    end
    a := alpha_of(al, has_a)
    if has_a and al.k != TK_NUM and al.k != TK_PCT and not (al.k == TK_IDENT and al.s == "none"):
        ret false
    end
    switch f.s:
        "rgb", "rgba":
            repeat 3 in k:
                kk := vals[k].k
                if kk != TK_NUM and kk != TK_PCT and not (kk == TK_IDENT and vals[k].s == "none"):
                    ret false
                end
            end
            out = Color { r = clamp255(chan_val(vals[0], 255.0)), g = clamp255(chan_val(vals[1], 255.0)), b = clamp255(chan_val(vals[2], 255.0)), a = clamp255(a * 255.0) }
            ret true
        end
        "hsl", "hsla":
            mut h := 0.0
            if not (vals[0].k == TK_IDENT and vals[0].s == "none") and not angle_deg(vals[0], h):
                ret false
            end
            ret_s := vals[1].k == TK_PCT ? vals[1].n / 100.0 : vals[1].n / 100.0
            ret_l := vals[2].k == TK_PCT ? vals[2].n / 100.0 : vals[2].n / 100.0
            out = hsl_color(h, ret_s, ret_l, a)
            ret true
        end
        "hwb":
            mut h := 0.0
            if not (vals[0].k == TK_IDENT and vals[0].s == "none") and not angle_deg(vals[0], h):
                ret false
            end
            out = hwb_color(h, vals[1].n / 100.0, vals[2].n / 100.0, a)
            ret true
        end
        else:
            ret false
        end
    end
    ret false
end

func parse_color_at(t: Vector<Tok>, s: int, e: int, dark: bool, cur: Color, out &: Color): bool:
    if s >= e or nxt(t, s) != e:
        ret false
    end
    tk := t[s]
    if tk.k == TK_HASH:
        ret parse_hex_color(tk.s, out)
    end
    if tk.k == TK_FUNC:
        ret parse_color_fn(t, s, dark, cur, out)
    end
    if tk.k != TK_IDENT:
        ret false
    end
    if tk.s == "transparent":
        out = Color { a = 0 }
        ret true
    end
    if tk.s == "currentcolor":
        out = cur
        ret true
    end
    init_colors()
    if g_colors.has(tk.s):
        out = rgb_of(g_colors.get(tk.s), 255)
        ret true
    end
    ret system_color(tk.s, dark, out)
end

func is_color_start(t: Vector<Tok>, i: int): bool:
    mut c := Color {}
    ret parse_color_at(t, i, nxt(t, i), false, Color {}, c)
end

func fmt_num(v: f64): str:
    r := math.Floor(v * 1000.0 + 0.5) / 1000.0
    if r == math.Floor(r) and r < 1.0e15 and r > -1.0e15:
        ret str.FromInt(r as i64)
    end
    ret str.FromFloat(r)
end

func color_text(c: Color): str:
    if c.a == 255:
        ret "rgb(" + c.r + ", " + c.g + ", " + c.b + ")"
    end
    na := fmt_alpha(c.a)
    out := "rgba(" + c.r + ", " + c.g + ", " + c.b + ", " + na + ")"
    sfree(na)
    ret out
end

func fmt_alpha(a: int): str:
    mut best := math.Floor(a as f64 / 255.0 * 100.0 + 0.5) / 100.0
    if clamp255(best * 255.0) != a:
        best = math.Floor(a as f64 / 255.0 * 1000.0 + 0.5) / 1000.0
    end
    ret fmt_num(best)
end
