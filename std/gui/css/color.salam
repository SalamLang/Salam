package css

import str
import math

mut g_colors := HashMap {} as HashMap<str, int>
mut g_colors_ready := false

func init_colors():
    if g_colors_ready:
        ret
    end
    g_colors_ready = true
    table := "aliceblue 0xf0f8ff antiquewhite 0xfaebd7 aqua 0x00ffff aquamarine 0x7fffd4 azure 0xf0ffff beige 0xf5f5dc bisque 0xffe4c4 black 0x000000 blanchedalmond 0xffebcd blue 0x0000ff blueviolet 0x8a2be2 brown 0xa52a2a burlywood 0xdeb887 cadetblue 0x5f9ea0 chartreuse 0x7fff00 chocolate 0xd2691e coral 0xff7f50 cornflowerblue 0x6495ed cornsilk 0xfff8dc crimson 0xdc143c cyan 0x00ffff darkblue 0x00008b darkcyan 0x008b8b darkgoldenrod 0xb8860b darkgray 0xa9a9a9 darkgreen 0x006400 darkgrey 0xa9a9a9 darkkhaki 0xbdb76b darkmagenta 0x8b008b darkolivegreen 0x556b2f darkorange 0xff8c00 darkorchid 0x9932cc darkred 0x8b0000 darksalmon 0xe9967a darkseagreen 0x8fbc8f darkslateblue 0x483d8b darkslategray 0x2f4f4f darkslategrey 0x2f4f4f darkturquoise 0x00ced1 darkviolet 0x9400d3 deeppink 0xff1493 deepskyblue 0x00bfff dimgray 0x696969 dimgrey 0x696969 dodgerblue 0x1e90ff firebrick 0xb22222 floralwhite 0xfffaf0 forestgreen 0x228b22 fuchsia 0xff00ff gainsboro 0xdcdcdc ghostwhite 0xf8f8ff gold 0xffd700 goldenrod 0xdaa520 gray 0x808080 green 0x008000 greenyellow 0xadff2f grey 0x808080 honeydew 0xf0fff0 hotpink 0xff69b4 indianred 0xcd5c5c indigo 0x4b0082 ivory 0xfffff0 khaki 0xf0e68c lavender 0xe6e6fa lavenderblush 0xfff0f5 lawngreen 0x7cfc00 lemonchiffon 0xfffacd lightblue 0xadd8e6 lightcoral 0xf08080 lightcyan 0xe0ffff lightgoldenrodyellow 0xfafad2 lightgray 0xd3d3d3 lightgreen 0x90ee90 lightgrey 0xd3d3d3 lightpink 0xffb6c1 lightsalmon 0xffa07a lightseagreen 0x20b2aa lightskyblue 0x87cefa lightslategray 0x778899 lightslategrey 0x778899 lightsteelblue 0xb0c4de lightyellow 0xffffe0 lime 0x00ff00 limegreen 0x32cd32 linen 0xfaf0e6 magenta 0xff00ff maroon 0x800000 mediumaquamarine 0x66cdaa mediumblue 0x0000cd mediumorchid 0xba55d3 mediumpurple 0x9370db mediumseagreen 0x3cb371 mediumslateblue 0x7b68ee mediumspringgreen 0x00fa9a mediumturquoise 0x48d1cc mediumvioletred 0xc71585 midnightblue 0x191970 mintcream 0xf5fffa mistyrose 0xffe4e1 moccasin 0xffe4b5 navajowhite 0xffdead navy 0x000080 oldlace 0xfdf5e6 olive 0x808000 olivedrab 0x6b8e23 orange 0xffa500 orangered 0xff4500 orchid 0xda70d6 palegoldenrod 0xeee8aa palegreen 0x98fb98 paleturquoise 0xafeeee palevioletred 0xdb7093 papayawhip 0xffefd5 peachpuff 0xffdab9 peru 0xcd853f pink 0xffc0cb plum 0xdda0dd powderblue 0xb0e0e6 purple 0x800080 rebeccapurple 0x663399 red 0xff0000 rosybrown 0xbc8f8f royalblue 0x4169e1 saddlebrown 0x8b4513 salmon 0xfa8072 sandybrown 0xf4a460 seagreen 0x2e8b57 seashell 0xfff5ee sienna 0xa0522d silver 0xc0c0c0 skyblue 0x87ceeb slateblue 0x6a5acd slategray 0x708090 slategrey 0x708090 snow 0xfffafa springgreen 0x00ff7f steelblue 0x4682b4 tan 0xd2b48c teal 0x008080 thistle 0xd8bfd8 tomato 0xff6347 turquoise 0x40e0d0 violet 0xee82ee wheat 0xf5deb3 white 0xffffff whitesmoke 0xf5f5f5 yellow 0xffff00 yellowgreen 0x9acd32"
    mut parts := str.Fields(table)
    mut i := 0
    until i + 1 < parts.Len():
        g_colors.Put(parts[i], hex_value(parts[i + 1].Substr(2, 6)))
        sfree(parts[i + 1])
        i += 2
    end
    parts.Free()
end

func hex_digit(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    if c >= 65 and c <= 70:
        ret c - 55
    end
    ret -1
end

func hex_value(s: str): int:
    p := (s as void*) as u8*
    mut v := 0
    repeat s.Len() in i:
        v = v * 16 + hex_digit(p[i] as int)
    end
    ret v
end

func rgb_of(v: int, a: int): Color:
    ret Color { r = (v >> 16) & 255, g = (v >> 8) & 255, b = v & 255, a = a }
end

func clamp255(v: f64): int:
    if v != v:
        ret 0
    end
    r := math.Floor(v + 0.5)
    if r < 0.0:
        ret 0
    end
    if r > 255.0:
        ret 255
    end
    ret r as int
end

func clamp01(v: f64): f64:
    if v < 0.0:
        ret 0.0
    end
    if v > 1.0:
        ret 1.0
    end
    ret v
end

func parse_hex_color(h: str, out &: Color): bool:
    n := h.Len()
    p := (h as void*) as u8*
    repeat n in i:
        if hex_digit(p[i] as int) < 0:
            ret false
        end
    end
    if n == 3 or n == 4:
        r := hex_digit(p[0] as int)
        g := hex_digit(p[1] as int)
        b := hex_digit(p[2] as int)
        mut a := 15
        if n == 4:
            a = hex_digit(p[3] as int)
        end
        out = Color { r = r * 17, g = g * 17, b = b * 17, a = a * 17 }
        ret true
    end
    if n == 6 or n == 8:
        r := hex_digit(p[0] as int) * 16 + hex_digit(p[1] as int)
        g := hex_digit(p[2] as int) * 16 + hex_digit(p[3] as int)
        b := hex_digit(p[4] as int) * 16 + hex_digit(p[5] as int)
        mut a := 255
        if n == 8:
            a = hex_digit(p[6] as int) * 16 + hex_digit(p[7] as int)
        end
        out = Color { r = r, g = g, b = b, a = a }
        ret true
    end
    ret false
end

func system_color(name: str, dark: bool, out &: Color): bool:
    switch name:
        "canvas", "window", "background":
            out = dark ? rgb_of(0x121212, 255) : rgb_of(0xffffff, 255)
            break
        end
        "canvastext", "buttontext", "fieldtext", "windowtext", "buttonborder":
            out = dark ? rgb_of(0xffffff, 255) : rgb_of(0x000000, 255)
            break
        end
        "buttonface":
            out = dark ? rgb_of(0x6b6b6b, 255) : rgb_of(0xefefef, 255)
            break
        end
        "field":
            out = dark ? rgb_of(0x3b3b3b, 255) : rgb_of(0xffffff, 255)
            break
        end
        "graytext":
            out = rgb_of(0x808080, 255)
            break
        end
        "linktext":
            out = dark ? rgb_of(0x9e9eff, 255) : rgb_of(0x0000ee, 255)
            break
        end
        "visitedtext":
            out = dark ? rgb_of(0xd0adf0, 255) : rgb_of(0x551a8b, 255)
            break
        end
        "activetext":
            out = rgb_of(0xff0000, 255)
            break
        end
        "highlight":
            out = rgb_of(0x0041c6, 204)
            break
        end
        "highlighttext", "accentcolortext":
            out = rgb_of(0xffffff, 255)
            break
        end
        "selecteditem":
            out = dark ? rgb_of(0x99c8ff, 255) : rgb_of(0x1967d2, 255)
            break
        end
        "selecteditemtext":
            out = dark ? rgb_of(0x3b3b3b, 255) : rgb_of(0xffffff, 255)
            break
        end
        "mark":
            out = rgb_of(0xffff00, 255)
            break
        end
        "marktext":
            out = rgb_of(0x000000, 255)
            break
        end
        "accentcolor":
            out = rgb_of(0x0075ff, 255)
            break
        end
        "buttonhighlight", "threedhighlight":
            out = rgb_of(0xdddddd, 255)
            break
        end
        "buttonshadow", "threedshadow", "threeddarkshadow":
            out = rgb_of(0x888888, 255)
            break
        end
        else:
            ret false
        end
    end
    ret true
end

func hsl_channel(n: f64, h: f64, s: f64, l: f64): f64:
    k0 := n + h / 30.0
    k := k0 - math.Floor(k0 / 12.0) * 12.0
    a := s * math.Min(l, 1.0 - l)
    ret l - a * math.Max(-1.0, math.Min(math.Min(k - 3.0, 9.0 - k), 1.0))
end

func angle_deg(t: Tok, out &: f64): bool:
    if t.k == TK_NUM:
        out = t.n
        ret true
    end
    if t.k != TK_DIM:
        ret false
    end
    switch t.s:
        "deg": out = t.n break end
        "rad": out = t.n * 180.0 / math.PI break end
        "grad": out = t.n * 0.9 break end
        "turn": out = t.n * 360.0 break end
        else: ret false end
    end
    ret true
end

func pack_color(c: Color): i64:
    ret ((c.r as i64) << 24) | ((c.g as i64) << 16) | ((c.b as i64) << 8) | (c.a as i64)
end

func unpack_color(v: i64): Color:
    ret Color { r = ((v >> 24) & 255) as int, g = ((v >> 16) & 255) as int, b = ((v >> 8) & 255) as int, a = (v & 255) as int }
end

func space_of(name: str): int:
    switch name:
        "srgb": ret SP_SRGB end
        "srgb-linear": ret SP_SRGB_LINEAR end
        "display-p3": ret SP_P3 end
        "a98-rgb": ret SP_A98 end
        "prophoto-rgb": ret SP_PROPHOTO end
        "rec2020": ret SP_REC2020 end
        "xyz-d50": ret SP_XYZ_D50 end
        "xyz", "xyz-d65": ret SP_XYZ_D65 end
        "lab": ret SP_LAB end
        "lch": ret SP_LCH end
        "oklab": ret SP_OKLAB end
        "oklch": ret SP_OKLCH end
        "hsl": ret SP_HSL end
        "hwb": ret SP_HWB end
        else: ret -1 end
    end
    ret -1
end

func hue_method_of(name: str): int:
    switch name:
        "shorter": ret HUE_SHORTER end
        "longer": ret HUE_LONGER end
        "increasing": ret HUE_INCREASING end
        "decreasing": ret HUE_DECREASING end
        else: ret -1 end
    end
    ret -1
end

func rel_channel(sp: int, fn_rgb: bool, origin: CF, name: str, out &: f64): bool:
    if name == "alpha":
        out = origin.al
        ret true
    end
    o := cf_convert(origin, sp)
    switch sp:
        SP_SRGB:
            mul := fn_rgb ? 255.0 : 1.0
            switch name:
                "r": out = o.c0 * mul ret true end
                "g": out = o.c1 * mul ret true end
                "b": out = o.c2 * mul ret true end
                else: ret false end
            end
        end
        SP_HSL:
            switch name:
                "h": out = o.c0 ret true end
                "s": out = o.c1 * 100.0 ret true end
                "l": out = o.c2 * 100.0 ret true end
                else: ret false end
            end
        end
        SP_HWB:
            switch name:
                "h": out = o.c0 ret true end
                "w": out = o.c1 * 100.0 ret true end
                "b": out = o.c2 * 100.0 ret true end
                else: ret false end
            end
        end
        SP_LAB, SP_OKLAB:
            switch name:
                "l": out = o.c0 ret true end
                "a": out = o.c1 ret true end
                "b": out = o.c2 ret true end
                else: ret false end
            end
        end
        SP_LCH, SP_OKLCH:
            switch name:
                "l": out = o.c0 ret true end
                "c": out = o.c1 ret true end
                "h": out = o.c2 ret true end
                else: ret false end
            end
        end
        SP_XYZ_D50, SP_XYZ_D65:
            switch name:
                "x": out = o.c0 ret true end
                "y": out = o.c1 ret true end
                "z": out = o.c2 ret true end
                else: ret false end
            end
        end
        else:
            switch name:
                "r": out = o.c0 ret true end
                "g": out = o.c1 ret true end
                "b": out = o.c2 ret true end
                else: ret false end
            end
        end
    end
    ret false
end

func rel_calc(t: Vector<Tok>, i: int, hue: bool, pct: f64, sp: int, fn_rgb: bool, origin: CF, out &: f64): bool:
    e := t[i].close
    if e < 0:
        ret false
    end
    mut v := Vector {} as Vector<Tok>
    defer v.Free()
    mut j := i
    until j <= e:
        mut tk := t[j]
        tk.stat = true
        if tk.close >= 0:
            tk.close -= i
        end
        mut x := 0.0
        if tk.k == TK_IDENT and rel_channel(sp, fn_rgb, origin, tk.s, x):
            tk = Tok { k = TK_NUM, n = x, ws = tk.ws, stat = true }
        end
        v.Push(tk)
        j++
    end
    a := calc_fn(v, 0, Cx {})
    if not a.ok or a.nl.Len() > 0:
        lin_free(a)
        ret false
    end
    if a.kind == K_ANG and hue:
        out = a.v
        ret true
    end
    if a.kind != K_NUM:
        ret false
    end
    out = a.v + (a.has_pct ? a.pct * pct / 100.0 : 0.0)
    ret true
end

func chan_of(t: Vector<Tok>, i: int, hue: bool, pct: f64, rel: bool, sp: int, fn_rgb: bool, origin: CF, out &: f64, none &: bool): bool:
    tk := t[i]
    none = false
    switch tk.k:
        TK_NUM:
            out = tk.n
            ret true
        end
        TK_PCT:
            if hue:
                ret false
            end
            out = tk.n * pct / 100.0
            ret true
        end
        TK_DIM:
            ret hue and angle_deg(tk, out)
        end
        TK_IDENT:
            if tk.s == "none":
                none = true
                out = 0.0
                ret true
            end
            ret rel and rel_channel(sp, fn_rgb, origin, tk.s, out)
        end
        TK_FUNC:
            if not is_math_fn(tk.s):
                ret false
            end
            if rel:
                ret rel_calc(t, i, hue, pct, sp, fn_rgb, origin, out)
            end
            a := calc_fn(t, i, Cx {})
            if not a.ok or a.nl.Len() > 0:
                lin_free(a)
                ret false
            end
            if a.kind == K_ANG:
                if not hue:
                    ret false
                end
                out = a.v
                ret true
            end
            if a.kind != K_NUM:
                ret false
            end
            out = a.v + (a.has_pct ? a.pct * pct / 100.0 : 0.0)
            ret true
        end
        else:
            ret false
        end
    end
    ret false
end

func clamp_to(v: f64, lo: f64, hi: f64): f64:
    if v < lo:
        ret lo
    end
    if v > hi:
        ret hi
    end
    ret v
end

func parse_space_fn(t: Vector<Tok>, i: int, dark: bool, cur: Color, out &: CF): bool:
    f := t[i]
    e := f.close
    mut items := Vector {} as Vector<int>
    defer items.Free()
    mut commas := false
    mut slash := -1
    mut j := i + 1
    until j < e:
        tk := t[j]
        if tk.k == TK_COMMA:
            commas = true
        else tk.k == TK_DELIM and tk.d == 47:
            if slash >= 0:
                ret false
            end
            slash = items.Len()
        else:
            items.Push(j)
        end
        j = nxt(t, j)
    end
    mut k := 0
    mut rel := false
    mut origin := CF {}
    if items.Len() > 0 and t[items[0]].k == TK_IDENT and t[items[0]].s == "from":
        if items.Len() < 2 or commas:
            ret false
        end
        o := items[1]
        if not parse_cf_at(t, o, nxt(t, o), dark, cur, origin):
            ret false
        end
        rel = true
        k = 2
    end
    mut sp := SP_SRGB
    mut fn_rgb := false
    switch f.s:
        "rgb", "rgba": fn_rgb = true break end
        "hsl", "hsla": sp = SP_HSL break end
        "hwb": sp = SP_HWB break end
        "lab": sp = SP_LAB break end
        "lch": sp = SP_LCH break end
        "oklab": sp = SP_OKLAB break end
        "oklch": sp = SP_OKLCH break end
        "color":
            if k >= items.Len() or t[items[k]].k != TK_IDENT:
                ret false
            end
            sp = space_of(t[items[k]].s)
            if sp < 0 or sp == SP_LAB or sp == SP_LCH or sp == SP_OKLAB or sp == SP_OKLCH or sp == SP_HSL or sp == SP_HWB:
                ret false
            end
            k++
            break
        end
        else: ret false end
    end
    if commas and (rel or f.s == "color" or f.s == "lab" or f.s == "lch" or f.s == "oklab" or f.s == "oklch"):
        ret false
    end
    mut nch := items.Len() - k
    mut alpha_at := -1
    if slash >= 0:
        if slash != k + 3 or items.Len() != k + 4 or commas:
            ret false
        end
        alpha_at = items[k + 3]
        nch = 3
    else commas and nch == 4:
        alpha_at = items[k + 3]
        nch = 3
    end
    if nch != 3:
        ret false
    end
    mut v := [0.0, 0.0, 0.0]
    mut none := 0
    repeat 3 in c:
        mut hue := false
        mut pct := 1.0
        switch sp:
            SP_SRGB:
                pct = fn_rgb ? 255.0 : 1.0
                break
            end
            SP_HSL, SP_HWB:
                hue = c == 0
                pct = 100.0
                break
            end
            SP_LAB:
                pct = c == 0 ? 100.0 : 125.0
                break
            end
            SP_LCH:
                hue = c == 2
                pct = c == 0 ? 100.0 : 150.0
                break
            end
            SP_OKLAB:
                pct = c == 0 ? 1.0 : 0.4
                break
            end
            SP_OKLCH:
                hue = c == 2
                pct = c == 0 ? 1.0 : 0.4
                break
            end
            else:
                break
            end
        end
        mut x := 0.0
        mut nn := false
        tk := t[items[k + c]]
        if commas and tk.k == TK_IDENT:
            ret false
        end
        if commas and (sp == SP_HSL or sp == SP_HWB) and c > 0 and tk.k != TK_PCT:
            ret false
        end
        if not chan_of(t, items[k + c], hue, pct, rel, sp, fn_rgb, origin, x, nn):
            ret false
        end
        if nn:
            none |= (1 << c)
        end
        v[c] = x
    end
    mut al := 1.0
    if alpha_at >= 0:
        mut nn := false
        if not chan_of(t, alpha_at, false, 1.0, rel, sp, fn_rgb, origin, al, nn):
            ret false
        end
        if nn:
            none |= NA
        end
    else rel:
        al = origin.al
    end
    al = clamp01(al)
    mut r := CF { sp = sp, al = al, none = none }
    switch sp:
        SP_SRGB:
            if fn_rgb:
                r.c0 = clamp01(v[0] / 255.0)
                r.c1 = clamp01(v[1] / 255.0)
                r.c2 = clamp01(v[2] / 255.0)
                r.legacy = not rel
            else:
                r.c0 = v[0]
                r.c1 = v[1]
                r.c2 = v[2]
            end
            break
        end
        SP_HSL, SP_HWB:
            r.c0 = wrap_hue(v[0])
            r.c1 = clamp01(v[1] / 100.0)
            r.c2 = clamp01(v[2] / 100.0)
            r.legacy = not rel
            break
        end
        SP_LAB:
            r.c0 = clamp_to(v[0], 0.0, 100.0)
            r.c1 = v[1]
            r.c2 = v[2]
            break
        end
        SP_LCH:
            r.c0 = clamp_to(v[0], 0.0, 100.0)
            r.c1 = math.Max(v[1], 0.0)
            r.c2 = wrap_hue(v[2])
            break
        end
        SP_OKLAB:
            r.c0 = clamp_to(v[0], 0.0, 1.0)
            r.c1 = v[1]
            r.c2 = v[2]
            break
        end
        SP_OKLCH:
            r.c0 = clamp_to(v[0], 0.0, 1.0)
            r.c1 = math.Max(v[1], 0.0)
            r.c2 = wrap_hue(v[2])
            break
        end
        else:
            r.c0 = v[0]
            r.c1 = v[1]
            r.c2 = v[2]
            break
        end
    end
    out = r
    ret true
end

func mix_part(t: Vector<Tok>, s: int, e: int, dark: bool, cur: Color, c &: CF, p &: f64, has_p &: bool): bool:
    has_p = false
    mut got := false
    mut i := s
    until i < e:
        tk := t[i]
        n := nxt(t, i)
        if tk.k == TK_PCT and not has_p:
            if tk.n < 0.0 or tk.n > 100.0:
                ret false
            end
            p = tk.n
            has_p = true
        else not got:
            if not parse_cf_at(t, i, n, dark, cur, c):
                ret false
            end
            got = true
        else:
            ret false
        end
        i = n
    end
    ret got
end

func parse_color_mix(t: Vector<Tok>, i: int, dark: bool, cur: Color, out &: CF): bool:
    e := t[i].close
    mut parts := Vector {} as Vector<int>
    defer parts.Free()
    split_commas(t, i + 1, e, parts)
    mut sp := SP_OKLAB
    mut method := HUE_SHORTER
    mut first := 0
    if parts.Len() == 6:
        mut j := parts[0]
        pe := parts[1]
        if not is_kw(t, j, pe, "in"):
            ret false
        end
        j++
        if j >= pe or t[j].k != TK_IDENT:
            ret false
        end
        sp = space_of(t[j].s)
        if sp < 0:
            ret false
        end
        j++
        if j < pe:
            if hue_index(sp) < 0 or t[j].k != TK_IDENT:
                ret false
            end
            method = hue_method_of(t[j].s)
            if method < 0 or not is_kw(t, j + 1, pe, "hue") or j + 2 != pe:
                ret false
            end
        end
        first = 2
    else parts.Len() != 4:
        ret false
    end
    mut a := CF {}
    mut b := CF {}
    mut pa := 0.0
    mut pb := 0.0
    mut ha := false
    mut hb := false
    if not mix_part(t, parts[first], parts[first + 1], dark, cur, a, pa, ha) or not mix_part(t, parts[first + 2], parts[first + 3], dark, cur, b, pb, hb):
        ret false
    end
    if not ha and not hb:
        pa = 50.0
        pb = 50.0
    else not ha:
        pa = 100.0 - pb
    else not hb:
        pb = 100.0 - pa
    end
    sum := pa + pb
    if sum <= 0.0:
        ret false
    end
    mut r := cf_mix(a, b, pb / sum, sp, method)
    if sum < 100.0:
        r.al *= sum / 100.0
    end
    out = r
    ret true
end

func parse_color_fn(t: Vector<Tok>, i: int, dark: bool, cur: Color, out &: CF): bool:
    f := t[i]
    s := i + 1
    e := f.close
    if e < 0:
        ret false
    end
    if f.s == "light-dark":
        mut parts := Vector {} as Vector<int>
        defer parts.Free()
        split_commas(t, s, e, parts)
        if parts.Len() != 4:
            ret false
        end
        mut a := CF {}
        mut b := CF {}
        if not parse_cf_at(t, parts[0], parts[1], dark, cur, a) or not parse_cf_at(t, parts[2], parts[3], dark, cur, b):
            ret false
        end
        out = dark ? b : a
        ret true
    end
    if f.s == "color-mix":
        ret parse_color_mix(t, i, dark, cur, out)
    end
    ret parse_space_fn(t, i, dark, cur, out)
end

func parse_cf_at(t: Vector<Tok>, s: int, e: int, dark: bool, cur: Color, out &: CF): bool:
    if s >= e or nxt(t, s) != e:
        ret false
    end
    tk := t[s]
    if tk.k == TK_COLOR:
        out = cf_from_color(unpack_color(dark ? tk.c2 : tk.c))
        out.legacy = (tk.d & 2) == 0
        ret true
    end
    mut c := Color {}
    if tk.k == TK_HASH:
        if not parse_hex_color(tk.s, c):
            ret false
        end
        out = cf_from_color(c)
        ret true
    end
    if tk.k == TK_FUNC:
        ret parse_color_fn(t, s, dark, cur, out)
    end
    if tk.k != TK_IDENT:
        ret false
    end
    if tk.s == "transparent":
        out = CF { sp = SP_SRGB, al = 0.0, legacy = true }
        ret true
    end
    if tk.s == "currentcolor":
        out = cf_from_color(cur)
        ret true
    end
    init_colors()
    if g_colors.Has(tk.s):
        out = cf_from_color(rgb_of(g_colors.Get(tk.s), 255))
        ret true
    end
    if not system_color(tk.s, dark, c):
        ret false
    end
    out = cf_from_color(c)
    ret true
end

func parse_color_at(t: Vector<Tok>, s: int, e: int, dark: bool, cur: Color, out &: Color): bool:
    if s < e and t[s].k == TK_COLOR and s + 1 == e:
        out = unpack_color(dark ? t[s].c2 : t[s].c)
        out.legacy = (t[s].d & 2) == 0
        ret true
    end
    mut c := CF {}
    if not parse_cf_at(t, s, e, dark, cur, c):
        ret false
    end
    out = cf_to_color(c)
    out.legacy = c.legacy
    ret true
end

func is_color_start(t: Vector<Tok>, i: int): bool:
    mut c := Color {}
    ret parse_color_at(t, i, nxt(t, i), false, Color {}, c)
end

func fmt_num(v: f64): str:
    r := math.Floor(v * 1000.0 + 0.5) / 1000.0
    if r == math.Floor(r) and r < 1.0e15 and r > -1.0e15:
        ret str.FromInt(r as i64)
    end
    ret str.FromFloat(r)
end

func color_text(c: Color): str:
    if c.a == 255:
        ret "rgb(" + c.r + ", " + c.g + ", " + c.b + ")"
    end
    na := fmt_alpha(c.a)
    out := "rgba(" + c.r + ", " + c.g + ", " + c.b + ", " + na + ")"
    sfree(na)
    ret out
end

func fmt_alpha(a: int): str:
    mut best := math.Floor(a as f64 / 255.0 * 100.0 + 0.5) / 100.0
    if clamp255(best * 255.0) != a:
        best = math.Floor(a as f64 / 255.0 * 1000.0 + 0.5) / 1000.0
    end
    ret fmt_num(best)
end
