func free_layers(v &: Vector<BgLayer>):
    repeat v.len() in i:
        mut l := v.ref(i)
        l.stops.free()
    end
    v.free()
end

func clone_layers(v: Vector<BgLayer>): Vector<BgLayer>:
    mut out := Vector {} as Vector<BgLayer>
    repeat v.len() in i:
        mut l := v[i]
        mut st := Vector {} as Vector<ColorStop>
        repeat l.stops.len() in k:
            st.push(l.stops[k])
        end
        l.stops = st
        out.push(l)
    end
    ret out
end

func clone_shadows(v: Vector<Shadow>): Vector<Shadow>:
    mut out := Vector {} as Vector<Shadow>
    repeat v.len() in i:
        out.push(v[i])
    end
    ret out
end

func clone_transforms(v: Vector<TransformFn>): Vector<TransformFn>:
    mut out := Vector {} as Vector<TransformFn>
    repeat v.len() in i:
        out.push(v[i])
    end
    ret out
end

func clone_transitions(v: Vector<Transition>): Vector<Transition>:
    mut out := Vector {} as Vector<Transition>
    repeat v.len() in i:
        out.push(v[i])
    end
    ret out
end

func free_style(cs &: ComputedStyle):
    free_layers(cs.backgrounds)
    cs.box_shadows.free()
    cs.text_shadows.free()
    cs.transforms.free()
    cs.transitions.free()
end

func initial_style(): ComputedStyle:
    mut cs := ComputedStyle {}
    cs.backgrounds = Vector {} as Vector<BgLayer>
    cs.backgrounds.push(BgLayer {})
    cs.box_shadows = Vector {} as Vector<Shadow>
    cs.text_shadows = Vector {} as Vector<Shadow>
    cs.transforms = Vector {} as Vector<TransformFn>
    cs.transitions = Vector {} as Vector<Transition>
    cs.transitions.push(Transition {})
    ret cs
end

func inherit_into(cs &: ComputedStyle, p: ComputedStyle):
    cs.direction = p.direction
    cs.color = p.color
    cs.visibility = p.visibility
    cs.cursor = p.cursor
    cs.pointer_events = p.pointer_events
    cs.font_family = p.font_family
    cs.font_size = p.font_size
    cs.font_size_keyword = p.font_size_keyword
    cs.font_weight = p.font_weight
    cs.font_style = p.font_style
    cs.small_caps = p.small_caps
    cs.font_stretch = p.font_stretch
    cs.line_height = p.line_height
    cs.line_height_factor = p.line_height_factor
    cs.line_height_normal = p.line_height_normal
    cs.letter_spacing = p.letter_spacing
    cs.word_spacing = p.word_spacing
    cs.text_align = p.text_align
    cs.text_indent = p.text_indent
    cs.text_transform = p.text_transform
    cs.white_space = p.white_space
    cs.text_shadows.free()
    cs.text_shadows = clone_shadows(p.text_shadows)
    cs.word_break = p.word_break
    cs.overflow_wrap = p.overflow_wrap
    cs.tab_size = p.tab_size
    cs.tab_size_px = p.tab_size_px
    cs.list_style_type = p.list_style_type
    cs.list_style_position = p.list_style_position
    cs.list_style_image = p.list_style_image
    cs.border_collapse = p.border_collapse
    cs.border_spacing_x = p.border_spacing_x
    cs.border_spacing_y = p.border_spacing_y
    cs.caret_color = p.caret_color
    cs.accent_color = p.accent_color
    cs.accent_auto = p.accent_auto
    cs.color_scheme = p.color_scheme
    cs.used_dark = p.used_dark
end

func side_of(cs: ComputedStyle, k: int): BorderSide:
    switch k:
        0: ret cs.border_top end
        1: ret cs.border_right end
        2: ret cs.border_bottom end
        else: ret cs.border_left end
    end
    ret cs.border_top
end

func set_side(cs &: ComputedStyle, k: int, s: BorderSide):
    switch k:
        0: cs.border_top = s break end
        1: cs.border_right = s break end
        2: cs.border_bottom = s break end
        else: cs.border_left = s end
    end
end

func copy_prop(cs &: ComputedStyle, src: ComputedStyle, p: int):
    if p >= P_MARGIN_TOP and p < P_MARGIN_TOP + 4:
        switch p - P_MARGIN_TOP:
            0: cs.margin_top = src.margin_top break end
            1: cs.margin_right = src.margin_right break end
            2: cs.margin_bottom = src.margin_bottom break end
            else: cs.margin_left = src.margin_left end
        end
        ret
    end
    if p >= P_PADDING_TOP and p < P_PADDING_TOP + 4:
        switch p - P_PADDING_TOP:
            0: cs.padding_top = src.padding_top break end
            1: cs.padding_right = src.padding_right break end
            2: cs.padding_bottom = src.padding_bottom break end
            else: cs.padding_left = src.padding_left end
        end
        ret
    end
    if p >= P_BORDER_TOP_WIDTH and p < P_BORDER_TOP_WIDTH + 12:
        k := (p - P_BORDER_TOP_WIDTH) % 4
        what := (p - P_BORDER_TOP_WIDTH) / 4
        mut s := side_of(cs, k)
        o := side_of(src, k)
        switch what:
            0: s.width = o.width break end
            1: s.style = o.style break end
            else: s.color = o.color end
        end
        set_side(cs, k, s)
        ret
    end
    if p >= P_RADIUS_TL and p < P_RADIUS_TL + 4:
        switch p - P_RADIUS_TL:
            0: cs.radius_top_left = src.radius_top_left break end
            1: cs.radius_top_right = src.radius_top_right break end
            2: cs.radius_bottom_right = src.radius_bottom_right break end
            else: cs.radius_bottom_left = src.radius_bottom_left end
        end
        ret
    end
    if p >= P_BG_IMAGE and p <= P_BG_ATTACH:
        copy_bg_prop(cs, src, p)
        ret
    end
    switch p:
        P_DISPLAY: cs.display = src.display break end
        P_POSITION: cs.position = src.position break end
        P_TOP: cs.top = src.top break end
        P_RIGHT: cs.right = src.right break end
        P_BOTTOM: cs.bottom = src.bottom break end
        P_LEFT: cs.left = src.left break end
        P_BOX_SIZING: cs.box_sizing = src.box_sizing break end
        P_WIDTH: cs.width = src.width break end
        P_HEIGHT: cs.height = src.height break end
        P_MIN_WIDTH: cs.min_width = src.min_width break end
        P_MIN_HEIGHT: cs.min_height = src.min_height break end
        P_MAX_WIDTH: cs.max_width = src.max_width break end
        P_MAX_HEIGHT: cs.max_height = src.max_height break end
        P_ASPECT_RATIO: cs.aspect_ratio = src.aspect_ratio break end
        P_OVERFLOW_X: cs.overflow_x = src.overflow_x break end
        P_OVERFLOW_Y: cs.overflow_y = src.overflow_y break end
        P_DIRECTION: cs.direction = src.direction break end
        P_FLEX_DIRECTION: cs.flex_direction = src.flex_direction break end
        P_FLEX_WRAP: cs.flex_wrap = src.flex_wrap break end
        P_FLEX_GROW: cs.flex_grow = src.flex_grow break end
        P_FLEX_SHRINK: cs.flex_shrink = src.flex_shrink break end
        P_FLEX_BASIS: cs.flex_basis = src.flex_basis break end
        P_JUSTIFY_CONTENT: cs.justify_content = src.justify_content break end
        P_ALIGN_ITEMS: cs.align_items = src.align_items break end
        P_ALIGN_SELF: cs.align_self = src.align_self break end
        P_ALIGN_CONTENT: cs.align_content = src.align_content break end
        P_JUSTIFY_ITEMS: cs.justify_items = src.justify_items break end
        P_JUSTIFY_SELF: cs.justify_self = src.justify_self break end
        P_ROW_GAP: cs.row_gap = src.row_gap break end
        P_COLUMN_GAP: cs.column_gap = src.column_gap break end
        P_ORDER: cs.order = src.order break end
        P_Z_INDEX:
            cs.z_index = src.z_index
            cs.z_auto = src.z_auto
            break
        end
        P_FLOAT: cs.float_mode = src.float_mode break end
        P_CLEAR: cs.clear = src.clear break end
        P_VERTICAL_ALIGN:
            cs.vertical_align = src.vertical_align
            cs.vertical_align_len = src.vertical_align_len
            break
        end
        P_COLOR: cs.color = src.color break end
        P_BG_COLOR: cs.background_color = src.background_color break end
        P_BOX_SHADOW:
            cs.box_shadows.free()
            cs.box_shadows = clone_shadows(src.box_shadows)
            break
        end
        P_OUTLINE_WIDTH: cs.outline.width = src.outline.width break end
        P_OUTLINE_STYLE: cs.outline.style = src.outline.style break end
        P_OUTLINE_COLOR: cs.outline.color = src.outline.color break end
        P_OUTLINE_OFFSET: cs.outline_offset = src.outline_offset break end
        P_OPACITY: cs.opacity = src.opacity break end
        P_TRANSFORM:
            cs.transforms.free()
            cs.transforms = clone_transforms(src.transforms)
            break
        end
        P_TRANSFORM_ORIGIN:
            cs.transform_origin_x = src.transform_origin_x
            cs.transform_origin_y = src.transform_origin_y
            break
        end
        P_TRANSLATE:
            cs.translate_x = src.translate_x
            cs.translate_y = src.translate_y
            break
        end
        P_ROTATE: cs.rotate = src.rotate break end
        P_SCALE:
            cs.scale_x = src.scale_x
            cs.scale_y = src.scale_y
            break
        end
        P_VISIBILITY: cs.visibility = src.visibility break end
        P_CURSOR: cs.cursor = src.cursor break end
        P_POINTER_EVENTS: cs.pointer_events = src.pointer_events break end
        P_USER_SELECT: cs.user_select = src.user_select break end
        P_FONT_FAMILY: cs.font_family = src.font_family break end
        P_FONT_SIZE:
            cs.font_size = src.font_size
            cs.font_size_keyword = src.font_size_keyword
            break
        end
        P_FONT_WEIGHT: cs.font_weight = src.font_weight break end
        P_FONT_STYLE: cs.font_style = src.font_style break end
        P_FONT_VARIANT_CAPS: cs.small_caps = src.small_caps break end
        P_FONT_STRETCH: cs.font_stretch = src.font_stretch break end
        P_LINE_HEIGHT:
            cs.line_height = src.line_height
            cs.line_height_factor = src.line_height_factor
            cs.line_height_normal = src.line_height_normal
            break
        end
        P_LETTER_SPACING: cs.letter_spacing = src.letter_spacing break end
        P_WORD_SPACING: cs.word_spacing = src.word_spacing break end
        P_TEXT_ALIGN: cs.text_align = src.text_align break end
        P_TEXT_INDENT: cs.text_indent = src.text_indent break end
        P_TEXT_TRANSFORM: cs.text_transform = src.text_transform break end
        P_WHITE_SPACE: cs.white_space = src.white_space break end
        P_TD_LINE:
            cs.underline = src.underline
            cs.overline = src.overline
            cs.line_through = src.line_through
            break
        end
        P_TD_STYLE: cs.decoration_style = src.decoration_style break end
        P_TD_COLOR: cs.decoration_color = src.decoration_color break end
        P_TD_THICKNESS: cs.decoration_thickness = src.decoration_thickness break end
        P_TEXT_SHADOW:
            cs.text_shadows.free()
            cs.text_shadows = clone_shadows(src.text_shadows)
            break
        end
        P_TEXT_OVERFLOW: cs.text_overflow = src.text_overflow break end
        P_WORD_BREAK: cs.word_break = src.word_break end
        P_OVERFLOW_WRAP: cs.overflow_wrap = src.overflow_wrap break end
        P_TAB_SIZE:
            cs.tab_size = src.tab_size
            cs.tab_size_px = src.tab_size_px
            break
        end
        P_LIST_TYPE: cs.list_style_type = src.list_style_type break end
        P_LIST_POSITION: cs.list_style_position = src.list_style_position break end
        P_LIST_IMAGE: cs.list_style_image = src.list_style_image break end
        P_BORDER_COLLAPSE: cs.border_collapse = src.border_collapse break end
        P_BORDER_SPACING:
            cs.border_spacing_x = src.border_spacing_x
            cs.border_spacing_y = src.border_spacing_y
            break
        end
        P_TABLE_LAYOUT: cs.table_layout = src.table_layout break end
        P_TR_PROPERTY, P_TR_DURATION, P_TR_TIMING, P_TR_DELAY:
            copy_tr_prop(cs, src, p)
            break
        end
        P_CARET_COLOR: cs.caret_color = src.caret_color break end
        P_ACCENT_COLOR:
            cs.accent_color = src.accent_color
            cs.accent_auto = src.accent_auto
            break
        end
        P_APPEARANCE: cs.appearance = src.appearance break end
        P_COLOR_SCHEME:
            cs.color_scheme = src.color_scheme
            cs.used_dark = src.used_dark
            break
        end
        P_OBJECT_FIT: cs.object_fit = src.object_fit break end
        P_OBJECT_POSITION:
            cs.object_position_x = src.object_position_x
            cs.object_position_y = src.object_position_y
            break
        end
        else:
        end
    end
end

func copy_bg_prop(cs &: ComputedStyle, src: ComputedStyle, p: int):
    if p == P_BG_IMAGE:
        free_layers(cs.backgrounds)
        cs.backgrounds = clone_layers(src.backgrounds)
        ret
    end
    n := src.backgrounds.len()
    if n == 0:
        ret
    end
    repeat cs.backgrounds.len() in i:
        o := src.backgrounds[i % n]
        mut l := cs.backgrounds.ref(i)
        switch p:
            P_BG_POS_X: l.position_x = o.position_x break end
            P_BG_POS_Y: l.position_y = o.position_y break end
            P_BG_SIZE:
                l.size_kind = o.size_kind
                l.size_w = o.size_w
                l.size_h = o.size_h
                break
            end
            P_BG_REPEAT:
                l.repeat_x = o.repeat_x
                l.repeat_y = o.repeat_y
                break
            end
            P_BG_CLIP: l.clip = o.clip break end
            P_BG_ORIGIN: l.origin = o.origin break end
            else: l.fixed = o.fixed end
        end
    end
end

func copy_tr_prop(cs &: ComputedStyle, src: ComputedStyle, p: int):
    if p == P_TR_PROPERTY:
        cs.transitions.free()
        cs.transitions = clone_transitions(src.transitions)
        ret
    end
    n := src.transitions.len()
    if n == 0:
        ret
    end
    repeat cs.transitions.len() in i:
        o := src.transitions[i % n]
        mut t := cs.transitions.ref(i)
        switch p:
            P_TR_DURATION: t.duration = o.duration break end
            P_TR_TIMING: t.timing = o.timing break end
            else: t.delay = o.delay end
        end
    end
end
