@en "Element"
@fa "عنصر"
pub struct Element:
    @en "kind"
    @fa "کلید عنصر"
    pub kind: str = "box"
    @en "tag"
    @fa "برچسب عنصر"
    pub tag: str = "div"
    @en "id"
    @fa "شناسه عنصر"
    pub id: str = ""
    @en "classes"
    @fa "کلاس های عنصر"
    pub classes: str = ""
    @en "parent"
    @fa "والد عنصر"
    pub parent: int = -1
    @en "base"
    @fa "اعلان های پایه"
    pub base: str = ""
    @en "hover"
    @fa "اعلان های اشاره"
    pub hover: str = ""
    @en "focus"
    @fa "اعلان های تمرکز"
    pub focus: str = ""
    @en "active"
    @fa "اعلان های فشردن"
    pub active: str = ""
    @en "hovered"
    @fa "زیر اشاره"
    pub hovered: bool = false
    @en "focused"
    @fa "دارای تمرکز"
    pub focused: bool = false
    @en "focus_visible"
    @fa "تمرکز نمایان"
    pub focus_visible: bool = false
    @en "pressed"
    @fa "فشرده"
    pub pressed: bool = false
    @en "attr_names"
    @fa "نام ویژگی ها"
    pub attr_names: Vector<str> = Vector {}
    @en "attr_values"
    @fa "مقدار ویژگی ها"
    pub attr_values: Vector<str> = Vector {}
    @en "media_conditions"
    @fa "شرط های رسانه"
    pub media_conditions: Vector<str> = Vector {}
    @en "media_declarations"
    @fa "اعلان های رسانه"
    pub media_declarations: Vector<str> = Vector {}

    @en "AddAttr"
    @fa "افزودن ویژگی"
    pub func AddAttr(name: str, value: str):
        this.attr_names.push(name)
        this.attr_values.push(value)
    end

    @en "AddMedia"
    @fa "افزودن رسانه"
    pub func AddMedia(condition: str, declarations: str):
        this.media_conditions.push(condition)
        this.media_declarations.push(declarations)
    end

    @en "HasAttr"
    @fa "ویژگی دارد"
    pub func HasAttr(name: str): bool:
        repeat this.attr_names.len() in i:
            if this.attr_names[i] == name:
                ret true
            end
        end
        ret false
    end

    @en "Free"
    @fa "آزادسازی عنصر"
    pub func Free():
        this.attr_names.free()
        this.attr_values.free()
        this.media_conditions.free()
        this.media_declarations.free()
    end
end
