@en "BgLayer"
@fa "لایه‌پس‌زمینه"
pub struct BgLayer:
    @en "image"
    @fa "نوع تصویر لایه"
    pub image: ImageKind = ImageKind.None
    @en "url"
    @fa "نشانی تصویر"
    pub url: str = ""
    @en "repeating"
    @fa "گرادیان تکراری"
    pub repeating: bool = false
    @en "angle"
    @fa "زاویه گرادیان"
    pub angle: f64 = 180.0
    @en "to_x"
    @fa "سوی افقی گرادیان"
    pub to_x: int = 0
    @en "to_y"
    @fa "سوی عمودی گرادیان"
    pub to_y: int = 0
    @en "shape"
    @fa "شکل گرادیان"
    pub shape: RadialShape = RadialShape.Ellipse
    @en "extent"
    @fa "گستره گرادیان"
    pub extent: RadialExtent = RadialExtent.FarthestCorner
    @en "radius_x"
    @fa "شعاع افقی گرادیان"
    pub radius_x: Len = Len {}
    @en "radius_y"
    @fa "شعاع عمودی گرادیان"
    pub radius_y: Len = Len {}
    @en "center_x"
    @fa "مرکز افقی گرادیان"
    pub center_x: Len = Len { pct = 50.0, has_pct = true }
    @en "center_y"
    @fa "مرکز عمودی گرادیان"
    pub center_y: Len = Len { pct = 50.0, has_pct = true }
    @en "stops"
    @fa "ایستگاه های رنگ"
    pub stops: Vector<ColorStop> = Vector {}
    @en "position_x"
    @fa "جای افقی لایه"
    pub position_x: Len = Len { has_pct = true }
    @en "position_y"
    @fa "جای عمودی لایه"
    pub position_y: Len = Len { has_pct = true }
    @en "size_kind"
    @fa "ابعاد لایه"
    pub size_kind: SizeKind = SizeKind.Explicit
    @en "size_w"
    @fa "پهنای لایه"
    pub size_w: Len = Len { kind = LenKind.Auto }
    @en "size_h"
    @fa "بلندی لایه"
    pub size_h: Len = Len { kind = LenKind.Auto }
    @en "repeat_x"
    @fa "کاشی افقی لایه"
    pub repeat_x: Repeat = Repeat.Repeat
    @en "repeat_y"
    @fa "کاشی عمودی لایه"
    pub repeat_y: Repeat = Repeat.Repeat
    @en "clip"
    @fa "برش لایه"
    pub clip: BoxArea = BoxArea.BorderBox
    @en "origin"
    @fa "مبدأ لایه"
    pub origin: BoxArea = BoxArea.PaddingBox
    @en "fixed"
    @fa "لایه ثابت"
    pub fixed: bool = false
end

