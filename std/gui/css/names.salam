        680: ret "grid-template-columns" end
        681: ret "grid-template-rows" end
        682: ret "grid-template-areas" end
        683: ret "grid-auto-columns" end
        684: ret "grid-auto-rows" end
        685: ret "grid-auto-flow" end
        686: ret "grid-row-start" end
        687: ret "grid-row-end" end
        688: ret "grid-column-start" end
        689: ret "grid-column-end" end
        690: ret "grid-row" end
        691: ret "grid-column" end
        692: ret "grid-area" end
        693: ret "grid-template" end
        else: ret "" end
    end
    ret ""
end

func name_id(s: str): int:
    if not g_name_ids_ready:
        g_name_ids_ready = true
        repeat NAME_COUNT in i:
            g_name_ids.put(name_of(i), i)
        end
    end
    if g_name_ids.has(s):
        ret g_name_ids.get(s)
    end
    ret -1
end
