end

func name_id(s: str): int:
    if not g_name_ids_ready:
        g_name_ids_ready = true
        repeat NAME_COUNT in i:
            g_name_ids.put(name_of(i), i)
        end
    end
    if g_name_ids.has(s):
        ret g_name_ids.get(s)
    end
    ret -1
end
