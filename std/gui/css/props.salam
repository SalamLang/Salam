const S_LAST := 249

const L_FIRST := 300
const L_MARGIN := 300
const L_PADDING := 304
const L_INSET := 308
const L_BW := 312
const L_BS := 316
const L_BC := 320
const L_INLINE_SIZE := 324
const L_BLOCK_SIZE := 325
const L_MIN_INLINE := 326
const L_MIN_BLOCK := 327
const L_MAX_INLINE := 328
const L_MAX_BLOCK := 329
const L_RADIUS := 330
const L_LAST := 333

const P_CUSTOM := 400

mut g_props := HashMap {} as HashMap<str, int>
mut g_props_ready := false
mut g_inherited := Vector {} as Vector<bool>
mut g_names := Vector {} as Vector<str>
mut g_inherit_ready := false

func add_names(list: str, base: int):
    mut parts := str.Fields(list)
    until g_names.len() < 500:
        g_names.push("")
    end
    repeat parts.len() in i:
        g_props.put(parts[i], base + i)
        g_names[base + i] = parts[i]
    end
    parts.free()
end

func init_props():
    if g_props_ready:
        ret
    end
    g_props_ready = true
    add_names(
        "display position top right bottom left box-sizing width height min-width min-height max-width max-height aspect-ratio margin-top margin-right margin-bottom margin-left padding-top padding-right padding-bottom padding-left border-top-width border-right-width border-bottom-width border-left-width border-top-style border-right-style border-bottom-style border-left-style border-top-color border-right-color border-bottom-color border-left-color border-top-left-radius border-top-right-radius border-bottom-right-radius border-bottom-left-radius overflow-x overflow-y direction flex-direction flex-wrap flex-grow flex-shrink flex-basis justify-content align-items align-self align-content justify-items justify-self row-gap column-gap order z-index float clear vertical-align color background-color background-image background-position-x background-position-y background-size background-repeat background-clip background-origin background-attachment box-shadow outline-width outline-style outline-color outline-offset opacity transform transform-origin translate rotate scale visibility cursor pointer-events user-select font-family font-size font-weight font-style font-variant-caps font-stretch line-height letter-spacing word-spacing text-align text-indent text-transform white-space text-decoration-line text-decoration-style text-decoration-color text-decoration-thickness text-shadow text-overflow word-break overflow-wrap tab-size list-style-type list-style-position list-style-image border-collapse border-spacing table-layout transition-property transition-duration transition-timing-function transition-delay caret-color accent-color appearance color-scheme object-fit object-position filter backdrop-filter grid-template-columns grid-template-rows grid-template-areas grid-auto-columns grid-auto-rows grid-auto-flow grid-row-start grid-row-end grid-column-start grid-column-end caption-side", 0
    )
    add_names(
        "margin padding inset border border-top border-right border-bottom border-left border-width border-style border-color border-radius outline overflow flex flex-flow gap place-items place-content place-self background font list-style text-decoration transition margin-block margin-inline padding-block padding-inline inset-block inset-inline border-block border-inline border-block-start border-block-end border-inline-start border-inline-end border-block-width border-block-style border-block-color border-inline-width border-inline-style border-inline-color background-position font-variant grid-row grid-column grid-area grid-template grid", S_FIRST
    )
    add_names(
        "margin-block-start margin-block-end margin-inline-start margin-inline-end padding-block-start padding-block-end padding-inline-start padding-inline-end inset-block-start inset-block-end inset-inline-start inset-inline-end border-block-start-width border-block-end-width border-inline-start-width border-inline-end-width border-block-start-style border-block-end-style border-inline-start-style border-inline-end-style border-block-start-color border-block-end-color border-inline-start-color border-inline-end-color inline-size block-size min-inline-size min-block-size max-inline-size max-block-size border-start-start-radius border-start-end-radius border-end-start-radius border-end-end-radius", L_FIRST
    )
    g_props.put("word-wrap", P_OVERFLOW_WRAP)
    g_props.put("grid-gap", S_GAP)
    g_props.put("grid-row-gap", P_ROW_GAP)
    g_props.put("grid-column-gap", P_COLUMN_GAP)
    g_props.put("-webkit-appearance", P_APPEARANCE)
    g_props.put("-webkit-user-select", P_USER_SELECT)
    g_props.put("-webkit-box-shadow", P_BOX_SHADOW)
    g_props.put("-webkit-transform", P_TRANSFORM)
    g_props.put("-webkit-transition", S_TRANSITION)
    g_props.put("-webkit-filter", P_FILTER)
    g_props.put("-webkit-backdrop-filter", P_BACKDROP_FILTER)
end

func init_inherit():
    if g_inherit_ready:
        ret
    end
    g_inherit_ready = true
    repeat NPROP:
        g_inherited.push(false)
    end
    inherit_ids := [P_DIRECTION, P_COLOR, P_VISIBILITY, P_CURSOR, P_POINTER_EVENTS, P_FONT_FAMILY, P_FONT_SIZE, P_FONT_WEIGHT, P_FONT_STYLE, P_FONT_VARIANT_CAPS, P_FONT_STRETCH, P_LINE_HEIGHT, P_LETTER_SPACING, P_WORD_SPACING, P_TEXT_ALIGN, P_TEXT_INDENT, P_TEXT_TRANSFORM, P_WHITE_SPACE, P_TEXT_SHADOW, P_WORD_BREAK, P_OVERFLOW_WRAP, P_TAB_SIZE, P_LIST_TYPE, P_LIST_POSITION, P_LIST_IMAGE, P_BORDER_COLLAPSE, P_BORDER_SPACING, P_CAPTION_SIDE, P_CARET_COLOR, P_ACCENT_COLOR, P_COLOR_SCHEME]
    repeat len(inherit_ids) in i:
        g_inherited[inherit_ids[i]] = true
    end
end

func prop_id(name: str): int:
    init_props()
    if name.len() > 2 and str.StartsWith(name, "--"):
        ret P_CUSTOM
    end
    if g_props.has(name):
        ret g_props.get(name)
    end
    ret -1
end

func prop_name(p: int): str:
    init_props()
    if p >= 0 and p < g_names.len():
        ret g_names[p]
    end
    ret ""
end

func is_inherited(p: int): bool:
    init_inherit()
    if p < 0 or p >= NPROP:
        ret p == P_CUSTOM
    end
    ret g_inherited[p]
end

func phys_side(side: int, rtl: bool): int:
    switch side:
        0: ret 0 end
        1: ret 2 end
        2: ret rtl ? 1 : 3 end
        else: ret rtl ? 3 : 1 end
    end
    ret 0
end

func logical_to_physical(p: int, rtl: bool): int:
    if p < L_FIRST or p > L_LAST:
        ret p
    end
    if p < L_INLINE_SIZE:
        group := (p - L_FIRST) / 4
        side := (p - L_FIRST) % 4
        ps := phys_side(side, rtl)
        switch group:
            0: ret P_MARGIN_TOP + ps end
            1: ret P_PADDING_TOP + ps end
            2: ret P_TOP + ps end
            3: ret P_BORDER_TOP_WIDTH + ps end
            4: ret P_BORDER_TOP_STYLE + ps end
            else: ret P_BORDER_TOP_COLOR + ps end
        end
    end
    switch p:
        L_INLINE_SIZE: ret P_WIDTH end
        L_BLOCK_SIZE: ret P_HEIGHT end
        L_MIN_INLINE: ret P_MIN_WIDTH end
        L_MIN_BLOCK: ret P_MIN_HEIGHT end
        L_MAX_INLINE: ret P_MAX_WIDTH end
        L_MAX_BLOCK: ret P_MAX_HEIGHT end
        else:
            k := p - L_RADIUS
            switch k:
                0: ret rtl ? P_RADIUS_TL + 1 : P_RADIUS_TL end
                1: ret rtl ? P_RADIUS_TL : P_RADIUS_TL + 1 end
                2: ret rtl ? P_RADIUS_TL + 2 : P_RADIUS_TL + 3 end
                else: ret rtl ? P_RADIUS_TL + 3 : P_RADIUS_TL + 2 end
            end
        end
    end
    ret p
end
