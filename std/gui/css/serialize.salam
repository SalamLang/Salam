package css

import str
import math
import gui.cssbox

func fmt_sig(v: f64): str:
    if v != v:
        ret str.Clone("0")
    end
    neg := v < 0.0
    av := math.Abs(v)
    mut digits := 1
    mut t := av
    until t >= 10.0:
        t /= 10.0
        digits++
    end
    mut d := 6 - digits
    if d < 0:
        d = 0
    end
    mut pw := 1 as i64
    repeat d:
        pw *= 10
    end
    scaled := math.Floor(av * pw as f64 + 0.5) as i64
    ip := scaled / pw
    mut fp := scaled % pw
    mut b := str.NewBuilder()
    if neg and scaled != 0:
        str.BufAppend(b, "-")
    end
    str.BufAppendInt(b, ip)
    if fp != 0:
        mut fd := d
        until fp % 10 == 0:
            fp /= 10
            fd--
        end
        str.BufAppend(b, ".")
        fs := str.FromInt(fp)
        repeat fd - fs.len():
            str.BufAppend(b, "0")
        end
        str.BufAppend(b, fs)
        sfree(fs)
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func px_text(v: f64): str:
    n := fmt_sig(v)
    out := n + "px"
    sfree(n)
    ret out
end

func lenx(l: Len): str:
    if l.kind == LenKind.Length and l.calc.len() == 0 and not (l.has_pct and l.px != 0.0):
        if l.has_pct:
            n := fmt_sig(l.pct)
            out := n + "%"
            sfree(n)
            ret out
        end
        ret px_text(l.px)
    end
    ret len_text(l)
end

func align_text(a: cssbox.Align): str:
    switch a:
        cssbox.Align.Auto: ret "auto" end
        cssbox.Align.Normal: ret "normal" end
        cssbox.Align.Start: ret "start" end
        cssbox.Align.End: ret "end" end
        cssbox.Align.FlexStart: ret "flex-start" end
        cssbox.Align.FlexEnd: ret "flex-end" end
        cssbox.Align.Center: ret "center" end
        cssbox.Align.Baseline: ret "baseline" end
        cssbox.Align.Stretch: ret "stretch" end
        cssbox.Align.SpaceBetween: ret "space-between" end
        cssbox.Align.SpaceAround: ret "space-around" end
        else: ret "space-evenly" end
    end
    ret "normal"
end

func display_text(d: Display): str:
    switch d:
        Display.Block: ret "block" end
        Display.Inline: ret "inline" end
        Display.InlineBlock: ret "inline-block" end
        Display.FlowRoot: ret "flow-root" end
        Display.Flex: ret "flex" end
        Display.InlineFlex: ret "inline-flex" end
        Display.Grid: ret "grid" end
        Display.InlineGrid: ret "inline-grid" end
        Display.ListItem: ret "list-item" end
        Display.Table: ret "table" end
        Display.InlineTable: ret "inline-table" end
        Display.TableRowGroup: ret "table-row-group" end
        Display.TableHeaderGroup: ret "table-header-group" end
        Display.TableFooterGroup: ret "table-footer-group" end
        Display.TableRow: ret "table-row" end
        Display.TableCell: ret "table-cell" end
        Display.TableColumn: ret "table-column" end
        Display.TableColumnGroup: ret "table-column-group" end
        Display.TableCaption: ret "table-caption" end
        Display.Contents: ret "contents" end
        else: ret "none" end
    end
    ret "none"
end

func style_text(s: BorderStyle): str:
    switch s:
        BorderStyle.None: ret "none" end
        BorderStyle.Hidden: ret "hidden" end
        BorderStyle.Solid: ret "solid" end
        BorderStyle.Dashed: ret "dashed" end
        BorderStyle.Dotted: ret "dotted" end
        BorderStyle.Double: ret "double" end
        BorderStyle.Groove: ret "groove" end
        BorderStyle.Ridge: ret "ridge" end
        BorderStyle.Inset: ret "inset" end
        BorderStyle.Outset: ret "outset" end
        else: ret "auto" end
    end
    ret "none"
end

func overflow_text(o: cssbox.Overflow): str:
    switch o:
        cssbox.Overflow.Visible: ret "visible" end
        cssbox.Overflow.Hidden: ret "hidden" end
        cssbox.Overflow.Clip: ret "clip" end
        cssbox.Overflow.Scroll: ret "scroll" end
        else: ret "auto" end
    end
    ret "visible"
end

func shadows_text(v: Vector<Shadow>, text: bool): str:
    if v.len() == 0:
        ret str.Clone("none")
    end
    mut b := str.NewBuilder()
    repeat v.len() in i:
        s := v[i]
        if i > 0:
            str.BufAppend(b, ", ")
        end
        c := color_text(s.color)
        str.BufAppend(b, c)
        sfree(c)
        vals := [s.x, s.y, s.blur, s.spread]
        n := text ? 3 : 4
        repeat n in k:
            str.BufAppend(b, " ")
            t := px_text(vals[k])
            str.BufAppend(b, t)
            sfree(t)
        end
        if s.inset:
            str.BufAppend(b, " inset")
        end
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func stops_text(b &: str.StringBuilder, l: BgLayer):
    repeat l.stops.len() in i:
        st := l.stops[i]
        str.BufAppend(b, ", ")
        if not st.hint:
            c := color_text(st.color)
            str.BufAppend(b, c)
            sfree(c)
        end
        if st.has_pos:
            if not st.hint:
                str.BufAppend(b, " ")
            end
            mut p := ""
            if l.image == ImageKind.Conic and not st.pos.has_pct:
                n := fmt_sig(st.pos.px)
                p = n + "deg"
                sfree(n)
            else:
                p = lenx(st.pos)
            end
            str.BufAppend(b, p)
            sfree(p)
        end
    end
end

func at_text(parts &: str.StringBuilder, l: BgLayer):
    cxs := lenx(l.center_x)
    cys := lenx(l.center_y)
    if cxs != "50%" or cys != "50%":
        if str.BufLen(parts) > 0:
            str.BufAppend(parts, " ")
        end
        str.BufAppend(parts, "at ")
        str.BufAppend(parts, cxs)
        str.BufAppend(parts, " ")
        str.BufAppend(parts, cys)
    end
    sfree(cxs)
    sfree(cys)
end

func strip_lead(s: str): str:
    i := str.IndexOf(s, "(, ")
    if i < 0:
        ret s
    end
    a := s.substr(0, i + 1)
    b := s.substr(i + 3, s.len() - i - 3)
    out := a + b
    sfree(a)
    sfree(b)
    sfree(s)
    ret out
end

func image_text(l: BgLayer): str:
    switch l.image:
        ImageKind.None: ret str.Clone("none") end
        ImageKind.Url: ret "url(\"" + l.url + "\")" end
        else:
        end
    end
    mut b := str.NewBuilder()
    if l.repeating:
        str.BufAppend(b, "repeating-")
    end
    switch l.image:
        ImageKind.Linear:
            str.BufAppend(b, "linear-gradient(")
            if l.to_x != 0 or l.to_y != 0:
                str.BufAppend(b, "to ")
                str.BufAppend(b, l.to_y < 0 ? "top " : "bottom ")
                str.BufAppend(b, l.to_x < 0 ? "left" : "right")
            else:
                n := fmt_sig(l.angle)
                str.BufAppend(b, n)
                str.BufAppend(b, "deg")
                sfree(n)
            end
            break
        end
        ImageKind.Radial:
            str.BufAppend(b, "radial-gradient(")
            mut parts := str.NewBuilder()
            if l.extent == RadialExtent.Explicit:
                rx := lenx(l.radius_x)
                str.BufAppend(parts, rx)
                sfree(rx)
                if l.shape == RadialShape.Ellipse:
                    ry := lenx(l.radius_y)
                    str.BufAppend(parts, " ")
                    str.BufAppend(parts, ry)
                    sfree(ry)
                end
            else:
                if l.shape == RadialShape.Circle:
                    str.BufAppend(parts, "circle")
                end
                mut ek := ""
                switch l.extent:
                    RadialExtent.FarthestSide: ek = "farthest-side" break end
                    RadialExtent.ClosestCorner: ek = "closest-corner" break end
                    RadialExtent.ClosestSide: ek = "closest-side" break end
                    else: ek = "" end
                end
                if ek.len() > 0:
                    if str.BufLen(parts) > 0:
                        str.BufAppend(parts, " ")
                    end
                    str.BufAppend(parts, ek)
                end
            end
            at_text(parts, l)
            pt := str.BufStr(parts)
            str.BufFree(parts)
            str.BufAppend(b, pt)
            if pt.len() == 0:
                stops_text(b, l)
                sfree(pt)
                str.BufAppend(b, ")")
                out0 := str.BufStr(b)
                str.BufFree(b)
                ret strip_lead(out0)
            end
            sfree(pt)
            break
        end
        else:
            str.BufAppend(b, "conic-gradient(")
            mut parts := str.NewBuilder()
            if l.angle != 0.0:
                n := fmt_sig(l.angle)
                str.BufAppend(parts, "from ")
                str.BufAppend(parts, n)
                str.BufAppend(parts, "deg")
                sfree(n)
            end
            at_text(parts, l)
            pt := str.BufStr(parts)
            str.BufFree(parts)
            str.BufAppend(b, pt)
            if pt.len() == 0:
                stops_text(b, l)
                sfree(pt)
                str.BufAppend(b, ")")
                out0 := str.BufStr(b)
                str.BufFree(b)
                ret strip_lead(out0)
            end
            sfree(pt)
        end
    end
    stops_text(b, l)
    str.BufAppend(b, ")")
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func layers_text(cs: ComputedStyle, which: int): str:
    mut b := str.NewBuilder()
    repeat cs.backgrounds.len() in i:
        l := cs.backgrounds[i]
        if i > 0:
            str.BufAppend(b, ", ")
        end
        mut t := ""
        switch which:
            0: t = image_text(l) break end
            1: t = lenx(l.position_x) break end
            2: t = lenx(l.position_y) break end
            3:
                if l.size_kind == SizeKind.Cover:
                    t = str.Clone("cover")
                else l.size_kind == SizeKind.Contain:
                    t = str.Clone("contain")
                else:
                    w := lenx(l.size_w)
                    h := lenx(l.size_h)
                    t = h == "auto" ? str.Clone(w) : w + " " + h
                    sfree(w)
                    sfree(h)
                end
                break
            end
            else:
                rx := l.repeat_x
                ry := l.repeat_y
                if rx == Repeat.Repeat and ry == Repeat.NoRepeat:
                    t = str.Clone("repeat-x")
                else rx == Repeat.NoRepeat and ry == Repeat.Repeat:
                    t = str.Clone("repeat-y")
                else:
                    a := repeat_text(rx)
                    t = rx == ry ? str.Clone(a) : a + " " + repeat_text(ry)
                end
            end
        end
        str.BufAppend(b, t)
        sfree(t)
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func repeat_text(r: Repeat): str:
    switch r:
        Repeat.Repeat: ret "repeat" end
        Repeat.NoRepeat: ret "no-repeat" end
        Repeat.Space: ret "space" end
        else: ret "round" end
    end
    ret "repeat"
end

func timing_text(t: Timing): str:
    switch t.kind:
        TimingKind.Linear: ret str.Clone("linear") end
        TimingKind.Steps:
            n := str.FromInt(t.steps as i64)
            mut pos := ""
            switch t.step_position:
                StepPosition.JumpStart: pos = ", jump-start" break end
                StepPosition.JumpNone: pos = ", jump-none" break end
                StepPosition.JumpBoth: pos = ", jump-both" break end
                else: pos = "" end
            end
            out := "steps(" + n + pos + ")"
            sfree(n)
            ret out
        end
        else:
            if t.x1 == 0.25 and t.y1 == 0.1 and t.x2 == 0.25 and t.y2 == 1.0:
                ret str.Clone("ease")
            end
            if t.x1 == 0.42 and t.y1 == 0.0 and t.x2 == 1.0 and t.y2 == 1.0:
                ret str.Clone("ease-in")
            end
            if t.x1 == 0.0 and t.y1 == 0.0 and t.x2 == 0.58 and t.y2 == 1.0:
                ret str.Clone("ease-out")
            end
            if t.x1 == 0.42 and t.y1 == 0.0 and t.x2 == 0.58 and t.y2 == 1.0:
                ret str.Clone("ease-in-out")
            end
            a := fmt_sig(t.x1)
            b := fmt_sig(t.y1)
            c := fmt_sig(t.x2)
            d := fmt_sig(t.y2)
            out := "cubic-bezier(" + a + ", " + b + ", " + c + ", " + d + ")"
            sfree(a)
            sfree(b)
            sfree(c)
            sfree(d)
            ret out
        end
    end
    ret str.Clone("ease")
end

func seconds_text(ms: f64): str:
    n := fmt_sig(ms / 1000.0)
    out := n + "s"
    sfree(n)
    ret out
end

func transitions_text(cs: ComputedStyle, which: int): str:
    mut b := str.NewBuilder()
    repeat cs.transitions.len() in i:
        t := cs.transitions[i]
        if i > 0:
            str.BufAppend(b, ", ")
        end
        mut s := ""
        switch which:
            0: s = str.Clone(t.property) break end
            1: s = seconds_text(t.duration) break end
            2: s = timing_text(t.timing) break end
            else: s = seconds_text(t.delay) end
        end
        str.BufAppend(b, s)
        sfree(s)
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func families_text(f: str): str:
    mut parts := str.Split(f, ", ")
    mut b := str.NewBuilder()
    repeat parts.len() in i:
        if i > 0:
            str.BufAppend(b, ", ")
        end
        p := parts[i]
        if str.Contains(p, " ") and not is_generic_family(p):
            str.BufAppend(b, "\"")
            str.BufAppend(b, p)
            str.BufAppend(b, "\"")
        else:
            str.BufAppend(b, p)
        end
        sfree(p)
    end
    parts.free()
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func corner_text(c: Corner): str:
    h := lenx(c.h)
    v := lenx(c.v)
    if h == v:
        sfree(v)
        ret h
    end
    out := h + " " + v
    sfree(h)
    sfree(v)
    ret out
end

func matrix_text(cs: ComputedStyle): str:
    if cs.transforms.len() == 0:
        ret str.Clone("none")
    end
    mut c := cs
    c.transform_origin_x = Len {}
    c.transform_origin_y = Len {}
    c.translate_x = Len {}
    c.translate_y = Len {}
    c.rotate = 0.0
    c.scale_x = 1.0
    c.scale_y = 1.0
    m := matrix_of(c, 0.0, 0.0)
    vals := [m.a, m.b, m.c, m.d, m.e, m.f]
    mut b := str.NewBuilder()
    str.BufAppend(b, "matrix(")
    repeat 6 in k:
        if k > 0:
            str.BufAppend(b, ", ")
        end
        n := fmt_sig(vals[k])
        str.BufAppend(b, n)
        sfree(n)
    end
    str.BufAppend(b, ")")
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func value_text(cs: ComputedStyle, name: str): str:
    switch name:
        "display": ret str.Clone(display_text(cs.display)) end
        "position":
            switch cs.position:
                cssbox.Position.Static: ret str.Clone("static") end
                cssbox.Position.Relative: ret str.Clone("relative") end
                cssbox.Position.Absolute: ret str.Clone("absolute") end
                cssbox.Position.Fixed: ret str.Clone("fixed") end
                else: ret str.Clone("sticky") end
            end
        end
        "top": ret lenx(cs.top) end
        "right": ret lenx(cs.right) end
        "bottom": ret lenx(cs.bottom) end
        "left": ret lenx(cs.left) end
        "width": ret lenx(cs.width) end
        "height": ret lenx(cs.height) end
        "min-width": ret lenx(cs.min_width) end
        "min-height": ret lenx(cs.min_height) end
        "max-width": ret lenx(cs.max_width) end
        "max-height": ret lenx(cs.max_height) end
        "margin-top": ret lenx(cs.margin_top) end
        "margin-right": ret lenx(cs.margin_right) end
        "margin-bottom": ret lenx(cs.margin_bottom) end
        "margin-left": ret lenx(cs.margin_left) end
        "padding-top": ret lenx(cs.padding_top) end
        "padding-right": ret lenx(cs.padding_right) end
        "padding-bottom": ret lenx(cs.padding_bottom) end
        "padding-left": ret lenx(cs.padding_left) end
        "border-top-width": ret px_text(cs.border_top.width) end
        "border-right-width": ret px_text(cs.border_right.width) end
        "border-bottom-width": ret px_text(cs.border_bottom.width) end
        "border-left-width": ret px_text(cs.border_left.width) end
        "border-top-style": ret str.Clone(style_text(cs.border_top.style)) end
        "border-right-style": ret str.Clone(style_text(cs.border_right.style)) end
        "border-bottom-style": ret str.Clone(style_text(cs.border_bottom.style)) end
        "border-left-style": ret str.Clone(style_text(cs.border_left.style)) end
        "border-top-color": ret color_text(cs.border_top.color) end
        "border-right-color": ret color_text(cs.border_right.color) end
        "border-bottom-color": ret color_text(cs.border_bottom.color) end
        "border-left-color": ret color_text(cs.border_left.color) end
        "border-top-left-radius": ret corner_text(cs.radius_top_left) end
        "border-top-right-radius": ret corner_text(cs.radius_top_right) end
        "border-bottom-right-radius": ret corner_text(cs.radius_bottom_right) end
        "border-bottom-left-radius": ret corner_text(cs.radius_bottom_left) end
        "color": ret color_text(cs.color) end
        "background-color": ret color_text(cs.background_color) end
        "background-image": ret layers_text(cs, 0) end
        "background-position-x": ret layers_text(cs, 1) end
        "background-position-y": ret layers_text(cs, 2) end
        "background-size": ret layers_text(cs, 3) end
        "background-repeat": ret layers_text(cs, 4) end
        "box-shadow": ret shadows_text(cs.box_shadows, false) end
        "text-shadow": ret shadows_text(cs.text_shadows, true) end
        "outline-width": ret px_text(cs.outline.width) end
        "outline-style": ret str.Clone(style_text(cs.outline.style)) end
        "outline-color": ret color_text(cs.outline.color) end
        "outline-offset": ret px_text(cs.outline_offset) end
        "opacity": ret fmt_sig(cs.opacity) end
        "transform": ret matrix_text(cs) end
        "visibility":
            switch cs.visibility:
                Visibility.Visible: ret str.Clone("visible") end
                Visibility.Hidden: ret str.Clone("hidden") end
                else: ret str.Clone("collapse") end
            end
        end
        "cursor": ret str.Clone(cs.cursor) end
        "pointer-events": ret str.Clone(cs.pointer_events ? "auto" : "none") end
        "font-family": ret families_text(cs.font_family) end
        "font-size": ret px_text(cs.font_size) end
        "font-weight": ret str.FromInt(cs.font_weight as i64) end
        "font-style":
            switch cs.font_style:
                FontStyle.Normal: ret str.Clone("normal") end
                FontStyle.Italic: ret str.Clone("italic") end
                else: ret str.Clone("oblique") end
            end
        end
        "line-height":
            if cs.line_height_normal:
                ret str.Clone("normal")
            end
            ret px_text(cs.line_height)
        end
        "letter-spacing":
            if cs.letter_spacing == 0.0:
                ret str.Clone("normal")
            end
            ret px_text(cs.letter_spacing)
        end
        "word-spacing": ret px_text(cs.word_spacing) end
        "text-align":
            switch cs.text_align:
                TextAlign.Start: ret str.Clone("start") end
                TextAlign.End: ret str.Clone("end") end
                TextAlign.Left: ret str.Clone("left") end
                TextAlign.Right: ret str.Clone("right") end
                TextAlign.Center: ret str.Clone("center") end
                TextAlign.Justify: ret str.Clone("justify") end
                else: ret str.Clone("match-parent") end
            end
        end
        "text-indent": ret lenx(cs.text_indent) end
        "text-transform":
            switch cs.text_transform:
                TextTransform.None: ret str.Clone("none") end
                TextTransform.Capitalize: ret str.Clone("capitalize") end
                TextTransform.Uppercase: ret str.Clone("uppercase") end
                TextTransform.Lowercase: ret str.Clone("lowercase") end
                else: ret str.Clone("full-width") end
            end
        end
        "white-space":
            switch cs.white_space:
                WhiteSpace.Normal: ret str.Clone("normal") end
                WhiteSpace.Pre: ret str.Clone("pre") end
                WhiteSpace.NoWrap: ret str.Clone("nowrap") end
                WhiteSpace.PreWrap: ret str.Clone("pre-wrap") end
                WhiteSpace.PreLine: ret str.Clone("pre-line") end
                else: ret str.Clone("break-spaces") end
            end
        end
        "text-decoration-line":
            if not cs.underline and not cs.overline and not cs.line_through:
                ret str.Clone("none")
            end
            mut b := str.NewBuilder()
            if cs.underline:
                str.BufAppend(b, "underline")
            end
            if cs.overline:
                if str.BufLen(b) > 0:
                    str.BufAppend(b, " ")
                end
                str.BufAppend(b, "overline")
            end
            if cs.line_through:
                if str.BufLen(b) > 0:
                    str.BufAppend(b, " ")
                end
                str.BufAppend(b, "line-through")
            end
            out := str.BufStr(b)
            str.BufFree(b)
            ret out
        end
        "text-decoration-color": ret color_text(cs.decoration_color) end
        "list-style-type": ret str.Clone(cs.list_style_type) end
        "list-style-position": ret str.Clone(cs.list_style_position == ListPosition.Inside ? "inside" : "outside") end
        "border-collapse": ret str.Clone(cs.border_collapse == BorderCollapse.Collapse ? "collapse" : "separate") end
        "border-spacing":
            h := px_text(cs.border_spacing_x)
            if cs.border_spacing_x == cs.border_spacing_y:
                ret h
            end
            v := px_text(cs.border_spacing_y)
            out := h + " " + v
            sfree(h)
            sfree(v)
            ret out
        end
        "table-layout": ret str.Clone(cs.table_layout == TableLayout.Fixed ? "fixed" : "auto") end
        "caption-side": ret str.Clone(cs.caption_side == cssbox.CaptionSide.Bottom ? "bottom" : "top") end
        "grid-template-columns": ret str.Clone(cs.grid_template_columns.len() > 0 ? cs.grid_template_columns : "none") end
        "grid-template-rows": ret str.Clone(cs.grid_template_rows.len() > 0 ? cs.grid_template_rows : "none") end
        "grid-template-areas": ret str.Clone(cs.grid_template_areas.len() > 0 ? cs.grid_template_areas : "none") end
        "grid-auto-columns": ret str.Clone(cs.grid_auto_columns.len() > 0 ? cs.grid_auto_columns : "auto") end
        "grid-auto-rows": ret str.Clone(cs.grid_auto_rows.len() > 0 ? cs.grid_auto_rows : "auto") end
        "grid-auto-flow":
            switch cs.grid_auto_flow:
                cssbox.GridAutoFlow.Column: ret str.Clone("column") end
                cssbox.GridAutoFlow.RowDense: ret str.Clone("row dense") end
                cssbox.GridAutoFlow.ColumnDense: ret str.Clone("column dense") end
                else: ret str.Clone("row") end
            end
        end
        "grid-row-start": ret str.Clone(cs.grid_row_start.len() > 0 ? cs.grid_row_start : "auto") end
        "grid-row-end": ret str.Clone(cs.grid_row_end.len() > 0 ? cs.grid_row_end : "auto") end
        "grid-column-start": ret str.Clone(cs.grid_column_start.len() > 0 ? cs.grid_column_start : "auto") end
        "grid-column-end": ret str.Clone(cs.grid_column_end.len() > 0 ? cs.grid_column_end : "auto") end
        "transition-property": ret transitions_text(cs, 0) end
        "transition-duration": ret transitions_text(cs, 1) end
        "transition-timing-function": ret transitions_text(cs, 2) end
        "transition-delay": ret transitions_text(cs, 3) end
        "z-index":
            if cs.z_auto:
                ret str.Clone("auto")
            end
            ret str.FromInt(cs.z_index as i64)
        end
        "order": ret str.FromInt(cs.order as i64) end
        "flex-grow": ret fmt_sig(cs.flex_grow) end
        "flex-shrink": ret fmt_sig(cs.flex_shrink) end
        "flex-basis": ret lenx(cs.flex_basis) end
        "flex-direction":
            switch cs.flex_direction:
                cssbox.FlexDirection.Row: ret str.Clone("row") end
                cssbox.FlexDirection.RowReverse: ret str.Clone("row-reverse") end
                cssbox.FlexDirection.Column: ret str.Clone("column") end
                else: ret str.Clone("column-reverse") end
            end
        end
        "flex-wrap":
            switch cs.flex_wrap:
                cssbox.FlexWrap.NoWrap: ret str.Clone("nowrap") end
                cssbox.FlexWrap.Wrap: ret str.Clone("wrap") end
                else: ret str.Clone("wrap-reverse") end
            end
        end
        "align-items": ret str.Clone(align_text(cs.align_items)) end
        "align-self": ret str.Clone(align_text(cs.align_self)) end
        "align-content": ret str.Clone(align_text(cs.align_content)) end
        "justify-content": ret str.Clone(align_text(cs.justify_content)) end
        "justify-items": ret str.Clone(align_text(cs.justify_items)) end
        "justify-self": ret str.Clone(align_text(cs.justify_self)) end
        "row-gap": ret lenx(cs.row_gap) end
        "column-gap": ret lenx(cs.column_gap) end
        "overflow-x": ret str.Clone(overflow_text(cs.overflow_x)) end
        "overflow-y": ret str.Clone(overflow_text(cs.overflow_y)) end
        "direction": ret str.Clone(cs.direction == cssbox.Direction.Rtl ? "rtl" : "ltr") end
        "box-sizing": ret str.Clone(cs.box_sizing == cssbox.BoxSizing.BorderBox ? "border-box" : "content-box") end
        "vertical-align":
            switch cs.vertical_align:
                VerticalAlign.Baseline: ret str.Clone("baseline") end
                VerticalAlign.Sub: ret str.Clone("sub") end
                VerticalAlign.Super: ret str.Clone("super") end
                VerticalAlign.Top: ret str.Clone("top") end
                VerticalAlign.TextTop: ret str.Clone("text-top") end
                VerticalAlign.Middle: ret str.Clone("middle") end
                VerticalAlign.Bottom: ret str.Clone("bottom") end
                VerticalAlign.TextBottom: ret str.Clone("text-bottom") end
                else: ret lenx(cs.vertical_align_len) end
            end
        end
        "appearance": ret str.Clone(cs.appearance) end
        "aspect-ratio":
            if cs.aspect_ratio == 0.0:
                ret str.Clone("auto")
            end
            ret fmt_sig(cs.aspect_ratio)
        end
        else: ret str.Clone("") end
    end
    ret str.Clone("")
end
