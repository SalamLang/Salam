package css

import str

func longhands_of(id: int, out &: Vector<int>):
    switch id:
        S_MARGIN, S_PADDING, S_INSET, S_BORDER_WIDTH, S_BORDER_STYLE, S_BORDER_COLOR, S_BORDER_RADIUS:
            mut base := P_MARGIN_TOP
            switch id:
                S_PADDING: base = P_PADDING_TOP break end
                S_INSET: base = P_TOP break end
                S_BORDER_WIDTH: base = P_BORDER_TOP_WIDTH break end
                S_BORDER_STYLE: base = P_BORDER_TOP_STYLE break end
                S_BORDER_COLOR: base = P_BORDER_TOP_COLOR break end
                S_BORDER_RADIUS: base = P_RADIUS_TL break end
                else: end
            end
            repeat 4 in i:
                out.push(base + i)
            end
            break
        end
        S_BORDER:
            repeat 12 in i:
                out.push(P_BORDER_TOP_WIDTH + i)
            end
            break
        end
        S_BORDER_TOP, S_BORDER_RIGHT, S_BORDER_BOTTOM, S_BORDER_LEFT:
            side := id - S_BORDER_TOP
            out.push(P_BORDER_TOP_WIDTH + side)
            out.push(P_BORDER_TOP_STYLE + side)
            out.push(P_BORDER_TOP_COLOR + side)
            break
        end
        S_OUTLINE:
            out.push(P_OUTLINE_WIDTH)
            out.push(P_OUTLINE_STYLE)
            out.push(P_OUTLINE_COLOR)
            break
        end
        S_OVERFLOW:
            out.push(P_OVERFLOW_X)
            out.push(P_OVERFLOW_Y)
            break
        end
        S_FLEX:
            out.push(P_FLEX_GROW)
            out.push(P_FLEX_SHRINK)
            out.push(P_FLEX_BASIS)
            break
        end
        S_FLEX_FLOW:
            out.push(P_FLEX_DIRECTION)
            out.push(P_FLEX_WRAP)
            break
        end
        S_GAP:
            out.push(P_ROW_GAP)
            out.push(P_COLUMN_GAP)
            break
        end
        S_PLACE_ITEMS:
            out.push(P_ALIGN_ITEMS)
            out.push(P_JUSTIFY_ITEMS)
            break
        end
        S_PLACE_CONTENT:
            out.push(P_ALIGN_CONTENT)
            out.push(P_JUSTIFY_CONTENT)
            break
        end
        S_PLACE_SELF:
            out.push(P_ALIGN_SELF)
            out.push(P_JUSTIFY_SELF)
            break
        end
        S_BACKGROUND:
            out.push(P_BG_IMAGE)
            out.push(P_BG_POS_X)
            out.push(P_BG_POS_Y)
            out.push(P_BG_SIZE)
            out.push(P_BG_REPEAT)
            out.push(P_BG_ATTACH)
            out.push(P_BG_ORIGIN)
            out.push(P_BG_CLIP)
            out.push(P_BG_COLOR)
            break
        end
        S_BG_POSITION:
            out.push(P_BG_POS_X)
            out.push(P_BG_POS_Y)
            break
        end
        S_FONT:
            out.push(P_FONT_STYLE)
            out.push(P_FONT_VARIANT_CAPS)
            out.push(P_FONT_WEIGHT)
            out.push(P_FONT_STRETCH)
            out.push(P_FONT_SIZE)
            out.push(P_LINE_HEIGHT)
            out.push(P_FONT_FAMILY)
            break
        end
        S_FONT_VARIANT:
            out.push(P_FONT_VARIANT_CAPS)
            break
        end
        S_LIST_STYLE:
            out.push(P_LIST_TYPE)
            out.push(P_LIST_POSITION)
            out.push(P_LIST_IMAGE)
            break
        end
        S_TEXT_DECORATION:
            out.push(P_TD_LINE)
            out.push(P_TD_STYLE)
            out.push(P_TD_COLOR)
            out.push(P_TD_THICKNESS)
            break
        end
        S_TRANSITION:
            out.push(P_TR_PROPERTY)
            out.push(P_TR_DURATION)
            out.push(P_TR_TIMING)
            out.push(P_TR_DELAY)
            break
        end
        S_MARGIN_BLOCK, S_PADDING_BLOCK, S_INSET_BLOCK, S_BORDER_BLOCK_WIDTH, S_BORDER_BLOCK_STYLE, S_BORDER_BLOCK_COLOR:
            b := block_base(id)
            out.push(b)
            out.push(b + 1)
            break
        end
        S_MARGIN_INLINE, S_PADDING_INLINE, S_INSET_INLINE, S_BORDER_INLINE_WIDTH, S_BORDER_INLINE_STYLE, S_BORDER_INLINE_COLOR:
            b := block_base(id)
            out.push(b + 2)
            out.push(b + 3)
            break
        end
        S_BORDER_BLOCK, S_BORDER_INLINE:
            off := id == S_BORDER_BLOCK ? 0 : 2
            repeat 2 in k:
                out.push(L_BW + off + k)
                out.push(L_BS + off + k)
                out.push(L_BC + off + k)
            end
            break
        end
        S_BORDER_BLOCK_START, S_BORDER_BLOCK_END, S_BORDER_INLINE_START, S_BORDER_INLINE_END:
            side := id - S_BORDER_BLOCK_START
            out.push(L_BW + side)
            out.push(L_BS + side)
            out.push(L_BC + side)
            break
        end
        else:
            out.push(id)
        end
    end
end

func block_base(id: int): int:
    switch id:
        S_MARGIN_BLOCK, S_MARGIN_INLINE: ret L_MARGIN end
        S_PADDING_BLOCK, S_PADDING_INLINE: ret L_PADDING end
        S_INSET_BLOCK, S_INSET_INLINE: ret L_INSET end
        S_BORDER_BLOCK_WIDTH, S_BORDER_INLINE_WIDTH: ret L_BW end
        S_BORDER_BLOCK_STYLE, S_BORDER_INLINE_STYLE: ret L_BS end
        else: ret L_BC end
    end
    ret L_MARGIN
end

func tok_text(src: str, t: Vector<Tok>, s: int, e: int): str:
    if s >= e:
        ret str.Clone("")
    end
    mut last := s
    mut i := s
    until i < e:
        last = i
        i = nxt(t, i)
    end
    p0 := t[s].p0
    mut p1 := t[last].p1
    if t[last].k == TK_FUNC and t[last].close >= 0:
        p1 = t[t[last].close].p1
    end
    ret src.substr(p0, p1 - p0)
end

func push_val(ids &: Vector<int>, vals &: Vector<str>, id: int, v: str):
    ids.push(id)
    vals.push(v)
end

func push_lit(ids &: Vector<int>, vals &: Vector<str>, id: int, v: str):
    ids.push(id)
    vals.push(str.Clone(v))
end

func items_of(t: Vector<Tok>, s: int, e: int, out &: Vector<int>):
    mut i := s
    until i < e:
        out.push(i)
        i = nxt(t, i)
    end
    out.push(e)
end

func four_sides(src: str, t: Vector<Tok>, s: int, e: int, base: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    mut it := Vector {} as Vector<int>
    defer it.free()
    items_of(t, s, e, it)
    n := it.len() - 1
    if n < 1 or n > 4:
        ret false
    end
    pick := [[0, 0, 0, 0], [0, 1, 0, 1], [0, 1, 2, 1], [0, 1, 2, 3]]
    repeat 4 in k:
        j := pick[n - 1][k]
        push_val(ids, vals, base + k, tok_text(src, t, it[j], it[j + 1]))
    end
    ret true
end

func two_sides(src: str, t: Vector<Tok>, s: int, e: int, a: int, b: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    mut it := Vector {} as Vector<int>
    defer it.free()
    items_of(t, s, e, it)
    n := it.len() - 1
    if n < 1 or n > 2:
        ret false
    end
    push_val(ids, vals, a, tok_text(src, t, it[0], it[1]))
    j := n == 2 ? 1 : 0
    push_val(ids, vals, b, tok_text(src, t, it[j], it[j + 1]))
    ret true
end

func border_parts(src: str, t: Vector<Tok>, s: int, e: int, w &: str, st &: str, c &: str): bool:
    cx := Cx {}
    mut i := s
    mut hw := false
    mut hs := false
    mut hc := false
    until i < e:
        j := nxt(t, i)
        mut wv := 0.0
        mut bs := BorderStyle.None
        if not hs and t[i].k == TK_IDENT and border_style_of(t[i].s, false, bs):
            st = tok_text(src, t, i, j)
            hs = true
        else not hw and border_width_of(t, i, j, cx, wv):
            w = tok_text(src, t, i, j)
            hw = true
        else not hc and is_color_start(t, i):
            c = tok_text(src, t, i, j)
            hc = true
        else:
            ret false
        end
        i = j
    end
    if not hw:
        w = str.Clone("medium")
    end
    if not hs:
        st = str.Clone("none")
    end
    if not hc:
        c = str.Clone("currentcolor")
    end
    ret true
end

func outline_parts(src: str, t: Vector<Tok>, s: int, e: int, w &: str, st &: str, c &: str): bool:
    cx := Cx {}
    mut i := s
    mut hw := false
    mut hs := false
    mut hc := false
    until i < e:
        j := nxt(t, i)
        mut wv := 0.0
        mut bs := BorderStyle.None
        if not hs and t[i].k == TK_IDENT and border_style_of(t[i].s, true, bs):
            st = tok_text(src, t, i, j)
            hs = true
        else not hw and border_width_of(t, i, j, cx, wv):
            w = tok_text(src, t, i, j)
            hw = true
        else not hc and (is_color_start(t, i) or is_kw(t, i, j, "invert")):
            c = tok_text(src, t, i, j)
            hc = true
        else:
            ret false
        end
        i = j
    end
    if not hw:
        w = str.Clone("medium")
    end
    if not hs:
        st = str.Clone("none")
    end
    if not hc:
        c = str.Clone("currentcolor")
    end
    ret true
end

func is_pos_item(t: Vector<Tok>, i: int, e: int): bool:
    tk := t[i]
    if tk.k == TK_IDENT:
        ret tk.s == "left" or tk.s == "right" or tk.s == "top" or tk.s == "bottom" or tk.s == "center"
    end
    mut l := Len {}
    ret p_len(t, i, e, Cx {}, true, true, l)
end

func position_texts(src: str, t: Vector<Tok>, s: int, e: int, xs &: str, ys &: str): bool:
    mut it := Vector {} as Vector<int>
    defer it.free()
    items_of(t, s, e, it)
    n := it.len() - 1
    if n == 1:
        a := t[it[0]]
        if a.k == TK_IDENT and (a.s == "top" or a.s == "bottom"):
            xs = str.Clone("center")
            ys = tok_text(src, t, it[0], it[1])
        else:
            xs = tok_text(src, t, it[0], it[1])
            ys = str.Clone("center")
        end
        ret true
    end
    if n == 2:
        a := t[it[0]]
        b := t[it[1]]
        if (a.k == TK_IDENT and (a.s == "top" or a.s == "bottom")) or (b.k == TK_IDENT and (b.s == "left" or b.s == "right")):
            xs = tok_text(src, t, it[1], it[2])
            ys = tok_text(src, t, it[0], it[1])
        else:
            xs = tok_text(src, t, it[0], it[1])
            ys = tok_text(src, t, it[1], it[2])
        end
        ret true
    end
    if n == 3 or n == 4:
        mut have_x := false
        mut have_y := false
        mut k := 0
        until k < n:
            a := t[it[k]]
            if a.k != TK_IDENT:
                ret false
            end
            mut ge := k + 1
            if k + 1 < n and t[it[k + 1]].k != TK_IDENT:
                ge = k + 2
            end
            txt := tok_text(src, t, it[k], it[ge])
            horizontal := a.s == "left" or a.s == "right" or (a.s == "center" and not have_x)
            if horizontal and not have_x:
                xs = txt
                have_x = true
            else not have_y:
                ys = txt
                have_y = true
            else:
                sfree(txt)
                ret false
            end
            k = ge
        end
        if not have_x:
            xs = str.Clone("center")
        end
        if not have_y:
            ys = str.Clone("center")
        end
        ret true
    end
    ret false
end

func is_image_item(t: Vector<Tok>, i: int): bool:
    tk := t[i]
    if tk.k == TK_URL:
        ret true
    end
    if tk.k == TK_FUNC:
        ret tk.s == "url" or str.EndsWith(tk.s, "gradient") or tk.s == "image-set" or tk.s == "-webkit-image-set"
    end
    ret tk.k == TK_IDENT and tk.s == "none"
end

func is_repeat_kw(t: Vector<Tok>, i: int): bool:
    tk := t[i]
    ret tk.k == TK_IDENT and (tk.s == "repeat" or tk.s == "repeat-x" or tk.s == "repeat-y" or tk.s == "no-repeat" or tk.s == "space" or tk.s == "round")
end

func join_into(b &: str.StringBuilder, first: bool, v: str):
    if not first:
        str.BufAppend(b, ", ")
    end
    str.BufAppend(b, v)
end

func expand_background(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    mut parts := Vector {} as Vector<int>
    defer parts.free()
    split_commas(t, s, e, parts)
    mut bi := str.NewBuilder()
    mut bx := str.NewBuilder()
    mut bpy := str.NewBuilder()
    mut bz := str.NewBuilder()
    mut br := str.NewBuilder()
    mut ba := str.NewBuilder()
    mut bo := str.NewBuilder()
    mut bc := str.NewBuilder()
    mut color := str.Clone("transparent")
    mut ok := true
    nl := parts.len() / 2
    mut k := 0
    until k + 1 < parts.len() and ok:
        ls := parts[k]
        le := parts[k + 1]
        last := k + 2 >= parts.len()
        first := k == 0
        mut img := "none"
        mut img_own := false
        mut px := "0%"
        mut py := "0%"
        mut pos_own := false
        mut size := "auto"
        mut size_own := false
        mut rep := "repeat"
        mut rep_own := false
        mut att := "scroll"
        mut origin := "padding-box"
        mut clip := "border-box"
        mut boxes := 0
        mut have_img := false
        mut have_pos := false
        mut have_color := false
        mut i := ls
        if ls >= le:
            ok = false
        end
        until i < le and ok:
            j := nxt(t, i)
            tk := t[i]
            if not have_img and is_image_item(t, i):
                img = tok_text(src, t, i, j)
                img_own = true
                have_img = true
                i = j
                continue
            end
            if is_repeat_kw(t, i):
                if rep_own:
                    ok = false
                    break
                end
                mut je := j
                if je < le and (t[je].k == TK_IDENT and (t[je].s == "repeat" or t[je].s == "no-repeat" or t[je].s == "space" or t[je].s == "round")) and tk.s != "repeat-x" and tk.s != "repeat-y":
                    je = nxt(t, je)
                end
                rep = tok_text(src, t, i, je)
                rep_own = true
                i = je
                continue
            end
            if tk.k == TK_IDENT and (tk.s == "scroll" or tk.s == "fixed" or tk.s == "local"):
                att = tk.s
                i = j
                continue
            end
            if tk.k == TK_IDENT and (tk.s == "border-box" or tk.s == "padding-box" or tk.s == "content-box" or tk.s == "text"):
                if boxes == 0:
                    origin = tk.s == "text" ? "padding-box" : tk.s
                    clip = tk.s
                else boxes == 1:
                    clip = tk.s
                else:
                    ok = false
                    break
                end
                boxes++
                i = j
                continue
            end
            if not have_pos and is_pos_item(t, i, le):
                mut pe := i
                until pe < le and is_pos_item(t, pe, le):
                    pe = nxt(t, pe)
                end
                mut xs := ""
                mut ys := ""
                if not position_texts(src, t, i, pe, xs, ys):
                    ok = false
                    break
                end
                px = xs
                py = ys
                pos_own = true
                have_pos = true
                i = pe
                if is_delim(t, i, le, 47):
                    mut se := i + 1
                    mut cnt := 0
                    until se < le and cnt < 2 and (is_kw(t, se, le, "auto") or is_kw(t, se, le, "cover") or is_kw(t, se, le, "contain") or t[se].k != TK_IDENT) and not is_color_start(t, se):
                        se = nxt(t, se)
                        cnt++
                    end
                    if cnt == 0:
                        ok = false
                        break
                    end
                    size = tok_text(src, t, i + 1, se)
                    size_own = true
                    i = se
                end
                continue
            end
            if last and not have_color and is_color_start(t, i):
                sfree(color)
                color = tok_text(src, t, i, j)
                have_color = true
                i = j
                continue
            end
            ok = false
        end
        join_into(bi, first, img)
        join_into(bx, first, px)
        join_into(bpy, first, py)
        join_into(bz, first, size)
        join_into(br, first, rep)
        join_into(ba, first, att)
        join_into(bo, first, origin)
        join_into(bc, first, clip)
        if img_own:
            sfree(img)
        end
        if pos_own:
            sfree(px)
            sfree(py)
        end
        if size_own:
            sfree(size)
        end
        if rep_own:
            sfree(rep)
        end
        k += 2
    end
    if nl == 0:
        ok = false
    end
    push_val(ids, vals, P_BG_IMAGE, str.BufStr(bi))
    push_val(ids, vals, P_BG_POS_X, str.BufStr(bx))
    push_val(ids, vals, P_BG_POS_Y, str.BufStr(bpy))
    push_val(ids, vals, P_BG_SIZE, str.BufStr(bz))
    push_val(ids, vals, P_BG_REPEAT, str.BufStr(br))
    push_val(ids, vals, P_BG_ATTACH, str.BufStr(ba))
    push_val(ids, vals, P_BG_ORIGIN, str.BufStr(bo))
    push_val(ids, vals, P_BG_CLIP, str.BufStr(bc))
    push_val(ids, vals, P_BG_COLOR, color)
    str.BufFree(bi)
    str.BufFree(bx)
    str.BufFree(bpy)
    str.BufFree(bz)
    str.BufFree(br)
    str.BufFree(ba)
    str.BufFree(bo)
    str.BufFree(bc)
    ret ok
end

func is_font_size_item(t: Vector<Tok>, i: int, e: int): bool:
    tk := t[i]
    if tk.k == TK_IDENT:
        mut v := 0.0
        ret font_size_kw(tk.s, 16.0, v)
    end
    if tk.k == TK_NUM:
        ret false
    end
    mut l := Len {}
    ret p_len(t, i, e, Cx {}, true, false, l)
end

func expand_font(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    k := kw_at(t, s, e)
    switch k:
        "caption", "icon", "menu", "message-box", "small-caption", "status-bar", "-webkit-small-control", "-webkit-mini-control", "-webkit-control":
            push_lit(ids, vals, P_FONT_STYLE, "normal")
            push_lit(ids, vals, P_FONT_VARIANT_CAPS, "normal")
            push_lit(ids, vals, P_FONT_WEIGHT, "normal")
            push_lit(ids, vals, P_FONT_STRETCH, "normal")
            push_lit(ids, vals, P_FONT_SIZE, "13.333333px")
            push_lit(ids, vals, P_LINE_HEIGHT, "normal")
            push_lit(ids, vals, P_FONT_FAMILY, "system-ui")
            ret true
        end
        else:
        end
    end
    mut style := ""
    mut variant := ""
    mut weight := ""
    mut stretch := ""
    mut i := s
    mut size_at := -1
    cx := Cx {}
    until i < e:
        j := nxt(t, i)
        if is_font_size_item(t, i, e):
            size_at = i
            break
        end
        tk := t[i]
        mut fw := 0
        mut fsr := 0.0
        if tk.k == TK_IDENT and tk.s == "normal":
            i = j
            continue
        end
        if style.len() == 0 and tk.k == TK_IDENT and (tk.s == "italic" or tk.s == "oblique"):
            style = tk.s
        else variant.len() == 0 and tk.k == TK_IDENT and tk.s == "small-caps":
            variant = tk.s
        else weight.len() == 0 and font_weight_of(t, i, j, cx, 400, fw):
            weight = tok_text(src, t, i, j)
        else stretch.len() == 0 and font_stretch_of(t, i, j, fsr):
            stretch = tk.s
        else:
            sfree(weight)
            ret false
        end
        i = j
    end
    if size_at < 0:
        sfree(weight)
        ret false
    end
    mut j := nxt(t, size_at)
    mut lh := "normal"
    mut lh_own := false
    if is_delim(t, j, e, 47):
        if j + 1 >= e:
            sfree(weight)
            ret false
        end
        lh = tok_text(src, t, j + 1, nxt(t, j + 1))
        lh_own = true
        j = nxt(t, j + 1)
    end
    if j >= e:
        sfree(weight)
        if lh_own:
            sfree(lh)
        end
        ret false
    end
    push_lit(ids, vals, P_FONT_STYLE, style.len() > 0 ? style : "normal")
    push_lit(ids, vals, P_FONT_VARIANT_CAPS, variant.len() > 0 ? variant : "normal")
    if weight.len() > 0:
        push_val(ids, vals, P_FONT_WEIGHT, weight)
    else:
        push_lit(ids, vals, P_FONT_WEIGHT, "normal")
    end
    push_lit(ids, vals, P_FONT_STRETCH, stretch.len() > 0 ? stretch : "normal")
    push_val(ids, vals, P_FONT_SIZE, tok_text(src, t, size_at, nxt(t, size_at)))
    if lh_own:
        push_val(ids, vals, P_LINE_HEIGHT, lh)
    else:
        push_lit(ids, vals, P_LINE_HEIGHT, "normal")
    end
    push_val(ids, vals, P_FONT_FAMILY, tok_text(src, t, j, e))
    ret true
end

func is_time_item(t: Vector<Tok>, i: int, e: int): bool:
    mut v := 0.0
    ret p_time(t, i, e, Cx {}, v)
end

func is_timing_item(t: Vector<Tok>, i: int): bool:
    mut tm := Timing {}
    ret timing_of(t, i, Cx {}, tm)
end

func expand_transition(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    mut parts := Vector {} as Vector<int>
    defer parts.free()
    split_commas(t, s, e, parts)
    mut bp := str.NewBuilder()
    mut bd := str.NewBuilder()
    mut bt := str.NewBuilder()
    mut bl := str.NewBuilder()
    mut ok := true
    mut k := 0
    until k + 1 < parts.len() and ok:
        ps := parts[k]
        pe := parts[k + 1]
        first := k == 0
        mut prop := "all"
        mut dur := "0s"
        mut del := "0s"
        mut tim := "ease"
        mut dur_own := false
        mut del_own := false
        mut tim_own := false
        mut times := 0
        mut have_prop := false
        mut have_tim := false
        mut i := ps
        if ps >= pe:
            ok = false
        end
        until i < pe and ok:
            j := nxt(t, i)
            if is_time_item(t, i, pe):
                if times == 0:
                    dur = tok_text(src, t, i, j)
                    dur_own = true
                else times == 1:
                    del = tok_text(src, t, i, j)
                    del_own = true
                else:
                    ok = false
                end
                times++
            else not have_tim and is_timing_item(t, i):
                tim = tok_text(src, t, i, j)
                tim_own = true
                have_tim = true
            else not have_prop and t[i].k == TK_IDENT:
                prop = t[i].s
                have_prop = true
            else:
                ok = false
            end
            i = j
        end
        join_into(bp, first, prop)
        join_into(bd, first, dur)
        join_into(bt, first, tim)
        join_into(bl, first, del)
        if dur_own:
            sfree(dur)
        end
        if del_own:
            sfree(del)
        end
        if tim_own:
            sfree(tim)
        end
        k += 2
    end
    push_val(ids, vals, P_TR_PROPERTY, str.BufStr(bp))
    push_val(ids, vals, P_TR_DURATION, str.BufStr(bd))
    push_val(ids, vals, P_TR_TIMING, str.BufStr(bt))
    push_val(ids, vals, P_TR_DELAY, str.BufStr(bl))
    str.BufFree(bp)
    str.BufFree(bd)
    str.BufFree(bt)
    str.BufFree(bl)
    ret ok
end

func expand_flex(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    k := kw_at(t, s, e)
    if k == "none":
        push_lit(ids, vals, P_FLEX_GROW, "0")
        push_lit(ids, vals, P_FLEX_SHRINK, "0")
        push_lit(ids, vals, P_FLEX_BASIS, "auto")
        ret true
    end
    if k == "auto":
        push_lit(ids, vals, P_FLEX_GROW, "1")
        push_lit(ids, vals, P_FLEX_SHRINK, "1")
        push_lit(ids, vals, P_FLEX_BASIS, "auto")
        ret true
    end
    cx := Cx {}
    mut grow := ""
    mut shrink := ""
    mut basis := ""
    mut i := s
    mut ok := true
    until i < e and ok:
        j := nxt(t, i)
        mut v := 0.0
        if p_num(t, i, j, cx, v) and not (t[i].k == TK_NUM and t[i].n == 0.0 and grow.len() > 0 and shrink.len() > 0):
            if grow.len() == 0:
                grow = tok_text(src, t, i, j)
            else shrink.len() == 0 and basis.len() == 0:
                shrink = tok_text(src, t, i, j)
            else:
                ok = false
            end
        else basis.len() == 0:
            mut l := Len {}
            if is_kw(t, i, j, "content") or is_kw(t, i, j, "auto") or p_size_len(t, i, j, cx, "auto", l):
                basis = tok_text(src, t, i, j)
            else:
                ok = false
            end
        else:
            ok = false
        end
        i = j
    end
    if not ok:
        sfree(grow)
        sfree(shrink)
        sfree(basis)
        ret false
    end
    if grow.len() > 0:
        push_val(ids, vals, P_FLEX_GROW, grow)
    else:
        push_lit(ids, vals, P_FLEX_GROW, "1")
    end
    if shrink.len() > 0:
        push_val(ids, vals, P_FLEX_SHRINK, shrink)
    else:
        push_lit(ids, vals, P_FLEX_SHRINK, "1")
    end
    if basis.len() > 0:
        push_val(ids, vals, P_FLEX_BASIS, basis)
    else:
        push_lit(ids, vals, P_FLEX_BASIS, "0%")
    end
    ret true
end

func expand_place(src: str, t: Vector<Tok>, s: int, e: int, a: int, b: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    mut it := Vector {} as Vector<int>
    defer it.free()
    items_of(t, s, e, it)
    n := it.len() - 1
    mut split := -1
    mut j := 0
    until j < n:
        kw := t[it[j]].k == TK_IDENT ? t[it[j]].s : ""
        if kw == "safe" or kw == "unsafe" or kw == "first" or kw == "last":
            j += 2
        else:
            j++
        end
        if split < 0 and j < n:
            split = j
        end
    end
    if split < 0:
        push_val(ids, vals, a, tok_text(src, t, s, e))
        push_val(ids, vals, b, tok_text(src, t, s, e))
        ret true
    end
    push_val(ids, vals, a, tok_text(src, t, s, it[split]))
    push_val(ids, vals, b, tok_text(src, t, it[split], e))
    ret true
end

func expand_list_style(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    mut typ := ""
    mut pos := ""
    mut img := ""
    mut nones := 0
    mut i := s
    until i < e:
        j := nxt(t, i)
        tk := t[i]
        if tk.k == TK_IDENT and tk.s == "none":
            nones++
        else pos.len() == 0 and tk.k == TK_IDENT and (tk.s == "inside" or tk.s == "outside"):
            pos = tok_text(src, t, i, j)
        else img.len() == 0 and (tk.k == TK_URL or (tk.k == TK_FUNC and (tk.s == "url" or str.EndsWith(tk.s, "gradient")))):
            img = tok_text(src, t, i, j)
        else typ.len() == 0 and (tk.k == TK_IDENT or tk.k == TK_STR):
            typ = tok_text(src, t, i, j)
        else:
            sfree(typ)
            sfree(pos)
            sfree(img)
            ret false
        end
        i = j
    end
    if typ.len() > 0 and img.len() > 0 and nones > 0:
        ret false
    end
    if typ.len() > 0:
        push_val(ids, vals, P_LIST_TYPE, typ)
    else:
        push_lit(ids, vals, P_LIST_TYPE, nones > 0 ? "none" : "disc")
    end
    if pos.len() > 0:
        push_val(ids, vals, P_LIST_POSITION, pos)
    else:
        push_lit(ids, vals, P_LIST_POSITION, "outside")
    end
    if img.len() > 0:
        push_val(ids, vals, P_LIST_IMAGE, img)
    else:
        push_lit(ids, vals, P_LIST_IMAGE, "none")
    end
    ret true
end

func expand_text_decoration(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    mut lines := str.NewBuilder()
    mut nlines := 0
    mut style := ""
    mut color := ""
    mut thick := ""
    mut i := s
    mut ok := true
    cx := Cx {}
    until i < e and ok:
        j := nxt(t, i)
        tk := t[i]
        if tk.k == TK_IDENT and (tk.s == "underline" or tk.s == "overline" or tk.s == "line-through" or tk.s == "blink" or tk.s == "none"):
            if nlines > 0:
                str.BufAppend(lines, " ")
            end
            str.BufAppend(lines, tk.s)
            nlines++
        else style.len() == 0 and tk.k == TK_IDENT and (tk.s == "solid" or tk.s == "double" or tk.s == "dotted" or tk.s == "dashed" or tk.s == "wavy"):
            style = tk.s
        else color.len() == 0 and is_color_start(t, i):
            color = tok_text(src, t, i, j)
        else thick.len() == 0:
            mut l := Len {}
            if is_kw(t, i, j, "auto") or is_kw(t, i, j, "from-font") or p_len(t, i, j, cx, true, false, l):
                thick = tok_text(src, t, i, j)
            else:
                ok = false
            end
        else:
            ok = false
        end
        i = j
    end
    lv := str.BufStr(lines)
    str.BufFree(lines)
    if not ok:
        sfree(lv)
        sfree(color)
        sfree(thick)
        ret false
    end
    if nlines > 0:
        push_val(ids, vals, P_TD_LINE, lv)
    else:
        sfree(lv)
        push_lit(ids, vals, P_TD_LINE, "none")
    end
    push_lit(ids, vals, P_TD_STYLE, style.len() > 0 ? style : "solid")
    if color.len() > 0:
        push_val(ids, vals, P_TD_COLOR, color)
    else:
        push_lit(ids, vals, P_TD_COLOR, "currentcolor")
    end
    if thick.len() > 0:
        push_val(ids, vals, P_TD_THICKNESS, thick)
    else:
        push_lit(ids, vals, P_TD_THICKNESS, "auto")
    end
    ret true
end

func expand_radius(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    mut slash := -1
    mut i := s
    until i < e:
        if is_delim(t, i, e, 47):
            slash = i
        end
        i = nxt(t, i)
    end
    mut hi := Vector {} as Vector<int>
    defer hi.free()
    mut vi := Vector {} as Vector<int>
    defer vi.free()
    he := slash >= 0 ? slash : e
    items_of(t, s, he, hi)
    if slash >= 0:
        items_of(t, slash + 1, e, vi)
    else:
        items_of(t, s, he, vi)
    end
    nh := hi.len() - 1
    nv := vi.len() - 1
    if nh < 1 or nh > 4 or nv < 1 or nv > 4:
        ret false
    end
    pick := [[0, 0, 0, 0], [0, 1, 0, 1], [0, 1, 2, 1], [0, 1, 2, 3]]
    repeat 4 in k:
        a := pick[nh - 1][k]
        b := pick[nv - 1][k]
        hs := tok_text(src, t, hi[a], hi[a + 1])
        vs := tok_text(src, t, vi[b], vi[b + 1])
        push_val(ids, vals, P_RADIUS_TL + k, hs + " " + vs)
        sfree(hs)
        sfree(vs)
    end
    ret true
end

func expand(id: int, src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
    switch id:
        S_MARGIN: ret four_sides(src, t, s, e, P_MARGIN_TOP, ids, vals) end
        S_PADDING: ret four_sides(src, t, s, e, P_PADDING_TOP, ids, vals) end
        S_INSET: ret four_sides(src, t, s, e, P_TOP, ids, vals) end
        S_BORDER_WIDTH: ret four_sides(src, t, s, e, P_BORDER_TOP_WIDTH, ids, vals) end
        S_BORDER_STYLE: ret four_sides(src, t, s, e, P_BORDER_TOP_STYLE, ids, vals) end
        S_BORDER_COLOR: ret four_sides(src, t, s, e, P_BORDER_TOP_COLOR, ids, vals) end
        S_BORDER_RADIUS: ret expand_radius(src, t, s, e, ids, vals) end
        S_BORDER, S_BORDER_TOP, S_BORDER_RIGHT, S_BORDER_BOTTOM, S_BORDER_LEFT, S_BORDER_BLOCK, S_BORDER_INLINE, S_BORDER_BLOCK_START, S_BORDER_BLOCK_END, S_BORDER_INLINE_START, S_BORDER_INLINE_END:
            mut w := ""
            mut st := ""
            mut c := ""
            if not border_parts(src, t, s, e, w, st, c):
                sfree(w)
                sfree(st)
                sfree(c)
                ret false
            end
            mut lh := Vector {} as Vector<int>
            longhands_of(id, lh)
            repeat lh.len() in k:
                p := lh[k]
                mut what := 0
                if (p >= P_BORDER_TOP_STYLE and p < P_BORDER_TOP_STYLE + 4) or (p >= L_BS and p < L_BS + 4):
                    what = 1
                else (p >= P_BORDER_TOP_COLOR and p < P_BORDER_TOP_COLOR + 4) or (p >= L_BC and p < L_BC + 4):
                    what = 2
                end
                push_lit(ids, vals, p, what == 0 ? w : (what == 1 ? st : c))
            end
            lh.free()
            sfree(w)
            sfree(st)
            sfree(c)
            ret true
        end
        S_OUTLINE:
            mut w := ""
            mut st := ""
            mut c := ""
            if not outline_parts(src, t, s, e, w, st, c):
                sfree(w)
                sfree(st)
                sfree(c)
                ret false
            end
            push_val(ids, vals, P_OUTLINE_WIDTH, w)
            push_val(ids, vals, P_OUTLINE_STYLE, st)
            push_val(ids, vals, P_OUTLINE_COLOR, c)
            ret true
        end
        S_OVERFLOW: ret two_sides(src, t, s, e, P_OVERFLOW_X, P_OVERFLOW_Y, ids, vals) end
        S_GAP: ret two_sides(src, t, s, e, P_ROW_GAP, P_COLUMN_GAP, ids, vals) end
        S_FLEX: ret expand_flex(src, t, s, e, ids, vals) end
        S_FLEX_FLOW:
            mut dir := ""
            mut wrap := ""
            mut i := s
            until i < e:
                k := t[i].k == TK_IDENT ? t[i].s : ""
                if dir.len() == 0 and (k == "row" or k == "row-reverse" or k == "column" or k == "column-reverse"):
                    dir = k
                else wrap.len() == 0 and (k == "nowrap" or k == "wrap" or k == "wrap-reverse"):
                    wrap = k
                else:
                    ret false
                end
                i = nxt(t, i)
            end
            push_lit(ids, vals, P_FLEX_DIRECTION, dir.len() > 0 ? dir : "row")
            push_lit(ids, vals, P_FLEX_WRAP, wrap.len() > 0 ? wrap : "nowrap")
            ret true
        end
        S_PLACE_ITEMS: ret expand_place(src, t, s, e, P_ALIGN_ITEMS, P_JUSTIFY_ITEMS, ids, vals) end
        S_PLACE_CONTENT: ret expand_place(src, t, s, e, P_ALIGN_CONTENT, P_JUSTIFY_CONTENT, ids, vals) end
        S_PLACE_SELF: ret expand_place(src, t, s, e, P_ALIGN_SELF, P_JUSTIFY_SELF, ids, vals) end
        S_BACKGROUND: ret expand_background(src, t, s, e, ids, vals) end
        S_BG_POSITION:
            mut parts := Vector {} as Vector<int>
            defer parts.free()
            split_commas(t, s, e, parts)
            mut bx := str.NewBuilder()
            mut bpy := str.NewBuilder()
            mut ok := true
            mut k := 0
            until k + 1 < parts.len():
                mut xs := ""
                mut ys := ""
                if not position_texts(src, t, parts[k], parts[k + 1], xs, ys):
                    ok = false
                    break
                end
                join_into(bx, k == 0, xs)
                join_into(bpy, k == 0, ys)
                sfree(xs)
                sfree(ys)
                k += 2
            end
            push_val(ids, vals, P_BG_POS_X, str.BufStr(bx))
            push_val(ids, vals, P_BG_POS_Y, str.BufStr(bpy))
            str.BufFree(bx)
            str.BufFree(bpy)
            ret ok
        end
        S_FONT: ret expand_font(src, t, s, e, ids, vals) end
        S_FONT_VARIANT:
            k := kw_at(t, s, e)
            if k == "small-caps" or k == "all-small-caps" or k == "petite-caps" or k == "all-petite-caps":
                push_lit(ids, vals, P_FONT_VARIANT_CAPS, k)
            else:
                push_lit(ids, vals, P_FONT_VARIANT_CAPS, "normal")
            end
            ret true
        end
        S_LIST_STYLE: ret expand_list_style(src, t, s, e, ids, vals) end
        S_TEXT_DECORATION: ret expand_text_decoration(src, t, s, e, ids, vals) end
        S_TRANSITION: ret expand_transition(src, t, s, e, ids, vals) end
        S_MARGIN_BLOCK, S_PADDING_BLOCK, S_INSET_BLOCK, S_BORDER_BLOCK_WIDTH, S_BORDER_BLOCK_STYLE, S_BORDER_BLOCK_COLOR:
            b := block_base(id)
            ret two_sides(src, t, s, e, b, b + 1, ids, vals)
        end
        S_MARGIN_INLINE, S_PADDING_INLINE, S_INSET_INLINE, S_BORDER_INLINE_WIDTH, S_BORDER_INLINE_STYLE, S_BORDER_INLINE_COLOR:
            b := block_base(id)
            ret two_sides(src, t, s, e, b + 2, b + 3, ids, vals)
        end
        else:
            ret false
        end
    end
    ret false
end
