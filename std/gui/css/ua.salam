package css

import str

const UA_CSS := `
html, address, blockquote, body, center, dialog, div, figure, figcaption, footer, form, header, hr, legend, listing, main, p, plaintext, pre, search, xmp { display: block }
area, base, datalist, head, link, meta, noscript, param, rp, script, style, template, title, track, source { display: none }
[hidden] { display: none }
html { color: canvastext }
body { margin: 8px }
p { margin-block: 1em; margin-inline: 0 }
address, cite, dfn, em, i, var { font-style: italic }
blockquote, figure { margin-block: 1em; margin-inline: 40px }
center { text-align: center }
hr { color: gray; overflow: hidden; margin-block: 0.5em; margin-inline: auto; border-style: inset; border-width: 1px }
article, aside, footer, header, hgroup, main, nav, section, search { display: block }
h1, h2, h3, h4, h5, h6 { display: block; font-weight: bold; margin-inline: 0 }
h1 { font-size: 2em; margin-block: 0.67em }
article h1, aside h1, nav h1, section h1 { font-size: 1.5em; margin-block: 0.83em }
article article h1, article aside h1, article nav h1, article section h1, aside article h1, aside aside h1, aside nav h1, aside section h1, nav article h1, nav aside h1, nav nav h1, nav section h1, section article h1, section aside h1, section nav h1, section section h1 { font-size: 1.17em; margin-block: 1em }
h2 { font-size: 1.5em; margin-block: 0.83em }
h3 { font-size: 1.17em; margin-block: 1em }
h4 { margin-block: 1.33em }
h5 { font-size: 0.83em; margin-block: 1.67em }
h6 { font-size: 0.67em; margin-block: 2.33em }
ul, menu, dir { display: block; list-style-type: disc; margin-block: 1em; margin-inline: 0; padding-inline-start: 40px }
ol { display: block; list-style-type: decimal; margin-block: 1em; margin-inline: 0; padding-inline-start: 40px }
li { display: list-item; text-align: match-parent }
ul ul, ol ul, menu ul, ul menu, ol menu, menu menu { list-style-type: circle }
ul ul ul, ul ol ul, ol ul ul, ol ol ul, ul ul menu, ol ol menu, ul ol menu, ol ul menu { list-style-type: square }
ul ul, ul ol, ul dl, ul menu, ol ul, ol ol, ol dl, ol menu, dl ul, dl ol, dl dl, dl menu, menu ul, menu ol, menu dl, menu menu { margin-block: 0 }
dd { display: block; margin-inline-start: 40px }
dl { display: block; margin-block: 1em; margin-inline: 0 }
dt { display: block }
table { display: table; box-sizing: border-box; border-spacing: 2px; border-collapse: separate; text-indent: 0; border-color: gray }
caption { display: table-caption; text-align: center }
thead { display: table-header-group; vertical-align: middle; border-color: inherit }
tbody { display: table-row-group; vertical-align: middle; border-color: inherit }
tfoot { display: table-footer-group; vertical-align: middle; border-color: inherit }
col { display: table-column }
colgroup { display: table-column-group }
tr { display: table-row; vertical-align: inherit; border-color: inherit }
td, th { display: table-cell; vertical-align: inherit; padding: 1px }
th { font-weight: bold; text-align: center }
b, strong { font-weight: bolder }
code, kbd, samp, tt { font-family: monospace }
pre, xmp, plaintext, listing { font-family: monospace; white-space: pre; margin-block: 1em; margin-inline: 0 }
big { font-size: larger }
small { font-size: smaller }
sub { vertical-align: sub; font-size: smaller }
sup { vertical-align: super; font-size: smaller }
s, strike, del { text-decoration: line-through }
u, ins { text-decoration: underline }
abbr[title], acronym[title] { text-decoration: dotted underline }
mark { background-color: mark; color: marktext }
a:any-link { color: linktext; text-decoration: underline; cursor: pointer }
a:any-link:active { color: activetext }
ruby { display: ruby }
rt { font-size: 50% }
nobr { white-space: nowrap }
wbr { display: inline }
details, summary { display: block }
details > summary:first-of-type { display: list-item; list-style: disclosure-closed inside }
details[open] > summary:first-of-type { list-style-type: disclosure-open }
dialog { position: absolute; inset-inline-start: 0; inset-inline-end: 0; width: fit-content; height: fit-content; margin: auto; border: solid; padding: 1em; background-color: canvas; color: canvastext }
dialog:not([open]) { display: none }
fieldset { display: block; margin-inline: 2px; border: 2px groove rgb(192, 192, 192); padding-block: 0.35em 0.625em; padding-inline: 0.75em; min-inline-size: min-content }
legend { display: block; padding-inline: 2px }
input, textarea, select, button { margin: 0; font: -webkit-small-control; color: fieldtext; letter-spacing: normal; word-spacing: normal; line-height: normal; text-transform: none; text-indent: 0; text-shadow: none; display: inline-block; text-align: start }
input { appearance: auto; padding-block: 1px; padding-inline: 2px; background-color: field; border: 2px inset light-dark(rgb(118, 118, 118), rgb(133, 133, 133)); cursor: text }
input[type="hidden"] { display: none }
input[type="checkbox"] { appearance: auto; box-sizing: border-box; margin: 3px 3px 3px 4px; padding: 0; border: 0 none; background-color: transparent; cursor: default }
input[type="radio"] { appearance: auto; box-sizing: border-box; margin: 3px 3px 0 5px; padding: 0; border: 0 none; background-color: transparent; cursor: default }
input[type="range"] { appearance: auto; margin: 2px; padding: 0; border: 0 none; background-color: transparent; cursor: default; color: rgb(16, 16, 16) }
input[type="color"] { appearance: auto; inline-size: 50px; block-size: 27px; border: 1px solid light-dark(rgb(118, 118, 118), rgb(133, 133, 133)); padding: 1px 2px; background-color: buttonface; cursor: default; box-sizing: border-box }
input[type="file"] { appearance: none; padding: 0; border: 0 none; background-color: transparent; cursor: default }
input[type="button"], input[type="submit"], input[type="reset"], button { appearance: auto; padding-block: 1px; padding-inline: 6px; border: 2px outset buttonborder; background-color: buttonface; color: buttontext; align-items: flex-start; text-align: center; cursor: default; box-sizing: border-box }
textarea { appearance: auto; font-family: monospace; margin-block: 1px; border: 1px solid light-dark(rgb(118, 118, 118), rgb(133, 133, 133)); padding: 2px; background-color: field; white-space: pre-wrap; overflow-wrap: break-word; cursor: text }
select { appearance: auto; box-sizing: border-box; align-items: center; border: 1px solid light-dark(rgb(118, 118, 118), rgb(133, 133, 133)); border-radius: 0; white-space: pre; background-color: field; cursor: default }
option { display: block; padding-inline: 2px 1px; padding-block-end: 1px; white-space: nowrap; min-block-size: 1.2em }
optgroup { display: block; font-weight: bolder }
progress { appearance: auto; box-sizing: border-box; display: inline-block; block-size: 1em; inline-size: 10em; vertical-align: -0.2em }
meter { appearance: auto; box-sizing: border-box; display: inline-block; block-size: 1em; inline-size: 5em; vertical-align: -0.2em }
label { cursor: default }
img, video, canvas { overflow: clip }
video { object-fit: contain }
audio:not([controls]) { display: none }
[dir="rtl"] { direction: rtl }
[dir="ltr"] { direction: ltr }
:focus-visible { outline: auto 1px rgb(16, 16, 16) }
input:focus-visible, textarea:focus-visible, select:focus-visible { outline-offset: 0 }
a:focus-visible { outline-offset: 1px }
`

func norm_kind(kind: str): str:
    lk := lower_ascii(kind)
    r := str.Replace(lk, "_", " ")
    sfree(lk)
    ret r
end

func tag_of(kind: str): str:
    k := norm_kind(kind)
    defer sfree(k)
    switch k:
        "page", "layout": ret "body" end
        "box": ret "div" end
        "abbreviation": ret "abbr" end
        "sidebar", "aside": ret "aside" end
        "block quote", "blockquote": ret "blockquote" end
        "bold", "b": ret "b" end
        "break", "br": ret "br" end
        "cell", "column": ret "td" end
        "column definition", "col": ret "col" end
        "column group", "colgroup": ret "colgroup" end
        "data list", "datalist": ret "datalist" end
        "definition", "dfn": ret "dfn" end
        "deleted", "del": ret "del" end
        "description", "dd", "description in box": ret "dd" end
        "description list", "dl": ret "dl" end
        "direction override", "bdo": ret "bdo" end
        "emphasis", "em": ret "em" end
        "field set", "fieldset": ret "fieldset" end
        "figure caption", "figcaption": ret "figcaption" end
        "head link": ret "link" end
        "heading": ret "h1" end
        "heading group", "hgroup": ret "hgroup" end
        "image", "img": ret "img" end
        "image map", "map": ret "map" end
        "inserted", "ins": ret "ins" end
        "isolate", "bdi": ret "bdi" end
        "italic", "i": ret "i" end
        "item", "li": ret "li" end
        "keyboard", "kbd": ret "kbd" end
        "line", "hr": ret "hr" end
        "link", "a": ret "a" end
        "list", "ul": ret "ul" end
        "mark", "highlight": ret "mark" end
        "meter", "gauge": ret "meter" end
        "no script", "noscript": ret "noscript" end
        "option group", "optgroup": ret "optgroup" end
        "ordered list", "numbered list", "ol": ret "ol" end
        "paragraph", "p": ret "p" end
        "preformatted", "pre": ret "pre" end
        "quote", "q": ret "q" end
        "row", "tr": ret "tr" end
        "ruby parenthesis", "rp": ret "rp" end
        "ruby text", "rt": ret "rt" end
        "sample", "samp": ret "samp" end
        "select", "dropdown": ret "select" end
        "strikethrough", "s": ret "s" end
        "subscript", "sub": ret "sub" end
        "superscript", "sup": ret "sup" end
        "term", "dt", "term in box": ret "dt" end
        "text area", "textarea": ret "textarea" end
        "underline", "u": ret "u" end
        "variable", "var": ret "var" end
        "word break", "wbr": ret "wbr" end
        "table head", "thead": ret "thead" end
        "table body", "tbody": ret "tbody" end
        "table foot", "tfoot": ret "tfoot" end
        "header cell", "th": ret "th" end
        else:
            p := (k as void*) as u8*
            mut ok := k.len() > 0
            repeat k.len() in i:
                c := p[i] as int
                if not ((c >= 97 and c <= 122) or (c >= 48 and c <= 57)):
                    ok = false
                end
            end
            if ok:
                ret intern(k)
            end
            ret "div"
        end
    end
    ret "div"
end
