@en "cssbox"
@fa "جعبه سی اس اس"
package cssbox

const NO := -1.0e300
const BIG := 1.0e300
const MINC := -3.0e300
const MAXC := 3.0e300

@en "LengthKind"
@fa "نوع‌درازا"
pub enum LengthKind:
    @en "Auto"
    @fa "درازای خودکار"
    Auto
    @en "Px"
    @fa "درازای پیکسلی"
    Px
    @en "Percent"
    @fa "درازای درصدی"
    Percent
    @en "MinContent"
    @fa "درازای کمینه محتوا"
    MinContent
    @en "MaxContent"
    @fa "درازای بیشینه محتوا"
    MaxContent
    @en "FitContent"
    @fa "درازای اندازه محتوا"
    FitContent
    @en "Stretch"
    @fa "درازای کشیده"
    Stretch
end

@en "Display"
@fa "نوع‌نمایش"
pub enum Display:
    @en "Block"
    @fa "بلوکی"
    Block
    @en "InlineBlock"
    @fa "بلوکی درون خطی"
    InlineBlock
    @en "FlowRoot"
    @fa "ریشه جریان"
    FlowRoot
    @en "Flex"
    @fa "فلکس"
    Flex
    @en "InlineFlex"
    @fa "فلکس درون خطی"
    InlineFlex
    @en "Contents"
    @fa "فقط فرزندان"
    Contents
    @en "None"
    @fa "بدون نمایش"
    None
end

@en "Position"
@fa "نوع‌جایگاه"
pub enum Position:
    @en "Static"
    @fa "عادی"
    Static
    @en "Relative"
    @fa "نسبی"
    Relative
    @en "Absolute"
    @fa "مطلق"
    Absolute
    @en "Fixed"
    @fa "ثابت"
    Fixed
    @en "Sticky"
    @fa "چسبان"
    Sticky
end

@en "BoxSizing"
@fa "نوع‌سنجش‌جعبه"
pub enum BoxSizing:
    @en "ContentBox"
    @fa "جعبه محتوا"
    ContentBox
    @en "BorderBox"
    @fa "جعبه مرز"
    BorderBox
end

@en "Overflow"
@fa "نوع‌سرریز"
pub enum Overflow:
    @en "Visible"
    @fa "نمایان"
    Visible
    @en "Hidden"
    @fa "مخفی"
    Hidden
    @en "Clip"
    @fa "بریده"
    Clip
    @en "Scroll"
    @fa "پیمایشی"
    Scroll
    @en "Auto"
    @fa "پیمایش خودکار"
    Auto
end

@en "Direction"
@fa "نوع‌جهت"
pub enum Direction:
    @en "Ltr"
    @fa "چپ به راست"
    Ltr
    @en "Rtl"
    @fa "راست به چپ"
    Rtl
end

@en "FlexDirection"
@fa "جهت‌فلکس"
pub enum FlexDirection:
    @en "Row"
    @fa "سطری"
    Row
    @en "RowReverse"
    @fa "سطری وارون"
    RowReverse
    @en "Column"
    @fa "ستونی"
    Column
    @en "ColumnReverse"
    @fa "ستونی وارون"
    ColumnReverse
end

@en "FlexWrap"
@fa "شکست‌فلکس"
pub enum FlexWrap:
    @en "NoWrap"
    @fa "بی شکست"
    NoWrap
    @en "Wrap"
    @fa "شکستن"
    Wrap
    @en "WrapReverse"
    @fa "شکستن وارون"
    WrapReverse
end

@en "Align"
@fa "نوع‌تراز"
pub enum Align:
    @en "Auto"
    @fa "تراز خودکار"
    Auto
    @en "Normal"
    @fa "تراز معمولی"
    Normal
    @en "Start"
    @fa "تراز آغاز"
    Start
    @en "End"
    @fa "تراز انتها"
    End
    @en "FlexStart"
    @fa "تراز آغاز فلکس"
    FlexStart
    @en "FlexEnd"
    @fa "تراز انتهای فلکس"
    FlexEnd
    @en "Center"
    @fa "تراز میانه"
    Center
    @en "Baseline"
    @fa "تراز خط پایه"
    Baseline
    @en "Stretch"
    @fa "تراز کشیده"
    Stretch
    @en "SpaceBetween"
    @fa "فاصله میان"
    SpaceBetween
    @en "SpaceAround"
    @fa "فاصله پیرامون"
    SpaceAround
    @en "SpaceEvenly"
    @fa "فاصله یکنواخت"
    SpaceEvenly
end

@en "SpaceKind"
@fa "نوع‌فضا"
pub enum SpaceKind:
    @en "Definite"
    @fa "فضای معین"
    Definite
    @en "MinContent"
    @fa "فضای کمینه محتوا"
    MinContent
    @en "MaxContent"
    @fa "فضای بیشینه محتوا"
    MaxContent
end

@en "Length"
@fa "درازا"
pub struct Length:
    @en "kind"
    @fa "نوع درازا"
    pub kind: LengthKind = LengthKind.Auto
    @en "value"
    @fa "مقدار درازا"
    pub value: f64 = 0.0
end

@en "Sides"
@fa "چهارسو"
pub struct Sides:
    @en "top"
    @fa "سوی بالا"
    pub top: Length = Length { kind = LengthKind.Px }
    @en "right"
    @fa "سوی راست"
    pub right: Length = Length { kind = LengthKind.Px }
    @en "bottom"
    @fa "سوی پایین"
    pub bottom: Length = Length { kind = LengthKind.Px }
    @en "left"
    @fa "سوی چپ"
    pub left: Length = Length { kind = LengthKind.Px }
end

@en "Edges"
@fa "لبه‌ها"
pub struct Edges:
    @en "top"
    @fa "لبه بالا"
    pub top: f64 = 0.0
    @en "right"
    @fa "لبه راست"
    pub right: f64 = 0.0
    @en "bottom"
    @fa "لبه پایین"
    pub bottom: f64 = 0.0
    @en "left"
    @fa "لبه چپ"
    pub left: f64 = 0.0
end

@en "Style"
@fa "سبک"
pub struct Style:
    @en "display"
    @fa "نمایش"
    pub display: Display = Display.Block
    @en "position"
    @fa "جایگاه"
    pub position: Position = Position.Static
    @en "inset"
    @fa "فاصله جایگاه"
    pub inset: Sides = Sides { top = Length {}, right = Length {}, bottom = Length {}, left = Length {} }
    @en "box_sizing"
    @fa "سنجش جعبه"
    pub box_sizing: BoxSizing = BoxSizing.ContentBox
    @en "width"
    @fa "پهنا"
    pub width: Length = Length {}
    @en "height"
    @fa "بلندی"
    pub height: Length = Length {}
    @en "min_width"
    @fa "کمینه پهنا"
    pub min_width: Length = Length {}
    @en "min_height"
    @fa "کمینه بلندی"
    pub min_height: Length = Length {}
    @en "max_width"
    @fa "بیشینه پهنا"
    pub max_width: Length = Length {}
    @en "max_height"
    @fa "بیشینه بلندی"
    pub max_height: Length = Length {}
    @en "aspect_ratio"
    @fa "نسبت ابعاد"
    pub aspect_ratio: f64 = 0.0
    @en "margin"
    @fa "حاشیه بیرونی"
    pub margin: Sides = Sides {}
    @en "padding"
    @fa "حاشیه درونی"
    pub padding: Sides = Sides {}
    @en "border"
    @fa "مرز"
    pub border: Sides = Sides {}
    @en "overflow_x"
    @fa "سرریز افقی"
    pub overflow_x: Overflow = Overflow.Visible
    @en "overflow_y"
    @fa "سرریز عمودی"
    pub overflow_y: Overflow = Overflow.Visible
    @en "scrollbar_width"
    @fa "پهنای نوار پیمایش"
    pub scrollbar_width: f64 = 0.0
    @en "direction"
    @fa "جهت"
    pub direction: Direction = Direction.Ltr
    @en "flex_direction"
    @fa "جهت فلکس"
    pub flex_direction: FlexDirection = FlexDirection.Row
    @en "flex_wrap"
    @fa "شکست فلکس"
    pub flex_wrap: FlexWrap = FlexWrap.NoWrap
    @en "flex_grow"
    @fa "رشد فلکس"
    pub flex_grow: f64 = 0.0
    @en "flex_shrink"
    @fa "کوچک شدن فلکس"
    pub flex_shrink: f64 = 1.0
    @en "flex_basis"
    @fa "پایه فلکس"
    pub flex_basis: Length = Length {}
    @en "justify_content"
    @fa "چینش محتوا"
    pub justify_content: Align = Align.Normal
    @en "align_items"
    @fa "تراز آیتم ها"
    pub align_items: Align = Align.Normal
    @en "align_self"
    @fa "تراز خود"
    pub align_self: Align = Align.Auto
    @en "align_content"
    @fa "تراز محتوا"
    pub align_content: Align = Align.Normal
    @en "row_gap"
    @fa "فاصله سطرها"
    pub row_gap: Length = Length { kind = LengthKind.Px }
    @en "column_gap"
    @fa "فاصله ستون ها"
    pub column_gap: Length = Length { kind = LengthKind.Px }
    @en "order"
    @fa "ترتیب"
    pub order: int = 0
end

@en "Space"
@fa "فضا"
pub struct Space:
    @en "kind"
    @fa "نوع فضا"
    pub kind: SpaceKind = SpaceKind.MaxContent
    @en "value"
    @fa "مقدار فضا"
    pub value: f64 = 0.0
end

@en "MeasureInput"
@fa "داده‌سنجش"
pub struct MeasureInput:
    @en "node"
    @fa "گره سنجش"
    pub node: int = 0
    @en "known_width"
    @fa "پهنای معلوم"
    pub known_width: f64 = 0.0
    @en "has_known_width"
    @fa "پهنا معلوم است"
    pub has_known_width: bool = false
    @en "known_height"
    @fa "بلندی معلوم"
    pub known_height: f64 = 0.0
    @en "has_known_height"
    @fa "بلندی معلوم است"
    pub has_known_height: bool = false
    @en "available_width"
    @fa "پهنای موجود"
    pub available_width: Space = Space {}
    @en "available_height"
    @fa "بلندی موجود"
    pub available_height: Space = Space {}
end

@en "MeasureOutput"
@fa "سنجیده"
pub struct MeasureOutput:
    @en "width"
    @fa "پهنای سنجیده"
    pub width: f64 = 0.0
    @en "height"
    @fa "بلندی سنجیده"
    pub height: f64 = 0.0
    @en "baseline"
    @fa "خط پایه سنجیده"
    pub baseline: f64 = 0.0
    @en "has_baseline"
    @fa "خط پایه دارد"
    pub has_baseline: bool = false
end

@en "BoxLayout"
@fa "جانمایی"
pub struct BoxLayout:
    @en "x"
    @fa "ایکس"
    pub x: f64 = 0.0
    @en "y"
    @fa "ایگرگ"
    pub y: f64 = 0.0
    @en "abs_x"
    @fa "ایکس مطلق"
    pub abs_x: f64 = 0.0
    @en "abs_y"
    @fa "ایگرگ مطلق"
    pub abs_y: f64 = 0.0
    @en "width"
    @fa "پهنای جعبه"
    pub width: f64 = 0.0
    @en "height"
    @fa "بلندی جعبه"
    pub height: f64 = 0.0
    @en "content_x"
    @fa "ایکس محتوا"
    pub content_x: f64 = 0.0
    @en "content_y"
    @fa "ایگرگ محتوا"
    pub content_y: f64 = 0.0
    @en "content_width"
    @fa "پهنای محتوا"
    pub content_width: f64 = 0.0
    @en "content_height"
    @fa "بلندی محتوا"
    pub content_height: f64 = 0.0
    @en "padding"
    @fa "حاشیه درونی جعبه"
    pub padding: Edges = Edges {}
    @en "border"
    @fa "مرز جعبه"
    pub border: Edges = Edges {}
    @en "margin"
    @fa "حاشیه بیرونی جعبه"
    pub margin: Edges = Edges {}
    @en "scrollbar_width"
    @fa "پهنای نوار پیمایش جعبه"
    pub scrollbar_width: f64 = 0.0
    @en "scrollbar_height"
    @fa "بلندی نوار پیمایش جعبه"
    pub scrollbar_height: f64 = 0.0
    @en "scroll_width"
    @fa "پهنای پیمایش"
    pub scroll_width: f64 = 0.0
    @en "scroll_height"
    @fa "بلندی پیمایش"
    pub scroll_height: f64 = 0.0
    @en "baseline"
    @fa "خط پایه"
    pub baseline: f64 = 0.0
    @en "has_baseline"
    @fa "دارای خط پایه"
    pub has_baseline: bool = false
end

struct Inp:
    pub kw: f64 = NO
    pub kh: f64 = NO
    pub kw_def: bool = true
    pub kh_def: bool = true
    pub pw: f64 = NO
    pub ph: f64 = NO
    pub aw: f64 = MAXC
    pub ah: f64 = MAXC
    pub inherent: bool = false
    pub axis: int = 2
    pub perform: bool = false
    pub cstart: bool = false
    pub cend: bool = false
end

struct Out:
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub baseline: f64 = NO
    pub tpos: f64 = 0.0
    pub tneg: f64 = 0.0
    pub bpos: f64 = 0.0
    pub bneg: f64 = 0.0
    pub collapse: bool = false
end

struct R4:
    pub t: f64 = 0.0
    pub r: f64 = 0.0
    pub b: f64 = 0.0
    pub l: f64 = 0.0
end

struct Node:
    pub style: Style = Style {}
    pub children: Vector<int> = Vector {}
    pub parent: int = -1
    pub has_measure: bool = false
    pub measure: func (MeasureInput) MeasureOutput = (_mi: MeasureInput): ret MeasureOutput {} end
    pub fin_ok: bool = false
    pub fin_key: Inp = Inp {}
    pub fin_out: Out = Out {}
    pub ckeys: Vector<Inp> = Vector {}
    pub couts: Vector<Out> = Vector {}
    pub cnext: int = 0
    pub lx: f64 = 0.0
    pub ly: f64 = 0.0
    pub lw: f64 = 0.0
    pub lh: f64 = 0.0
    pub pad: R4 = R4 {}
    pub bor: R4 = R4 {}
    pub mar: R4 = R4 {}
    pub sbw: f64 = 0.0
    pub sbh: f64 = 0.0
    pub base: f64 = NO
    pub spx_s: f64 = 0.0
    pub spx_e: f64 = 0.0
    pub spx_a: int = 0
    pub spy_s: f64 = 0.0
    pub spy_e: f64 = 0.0
    pub spy_a: int = 0
    pub ax: f64 = 0.0
    pub ay: f64 = 0.0
    pub ovr: f64 = 0.0
    pub ovb: f64 = 0.0
    pub ovl: f64 = 0.0
    pub ovt: f64 = 0.0
    pub cmw: f64 = 0.0
    pub cmh: f64 = 0.0
    pub fin: BoxLayout = BoxLayout {}
end

@en "Px"
@fa "پیکسل"
pub func Px(v: f64): Length:
    ret Length { kind = LengthKind.Px, value = v }
end

@en "Percent"
@fa "درصد"
pub func Percent(v: f64): Length:
    ret Length { kind = LengthKind.Percent, value = v }
end

@en "Auto"
@fa "خودکار"
pub func Auto(): Length:
    ret Length {}
end

@en "MinContent"
@fa "کمینه محتوا"
pub func MinContent(): Length:
    ret Length { kind = LengthKind.MinContent }
end

@en "MaxContent"
@fa "بیشینه محتوا"
pub func MaxContent(): Length:
    ret Length { kind = LengthKind.MaxContent }
end

@en "FitContent"
@fa "اندازه محتوا"
pub func FitContent(): Length:
    ret Length { kind = LengthKind.FitContent }
end

@en "Stretch"
@fa "کشیده"
pub func Stretch(): Length:
    ret Length { kind = LengthKind.Stretch }
end

@en "AllSides"
@fa "همه سوها"
pub func AllSides(v: Length): Sides:
    ret Sides { top = v, right = v, bottom = v, left = v }
end

@en "SidesOf"
@fa "چهار سو"
pub func SidesOf(top: Length, right: Length, bottom: Length, left: Length): Sides:
    ret Sides { top = top, right = right, bottom = bottom, left = left }
end

@en "Definite"
@fa "معین"
pub func Definite(v: f64): Space:
    ret Space { kind = SpaceKind.Definite, value = v }
end

@en "MinContentSpace"
@fa "فضای کمینه"
pub func MinContentSpace(): Space:
    ret Space { kind = SpaceKind.MinContent }
end

@en "MaxContentSpace"
@fa "فضای بیشینه"
pub func MaxContentSpace(): Space:
    ret Space { kind = SpaceKind.MaxContent }
end

@en "Measured"
@fa "سنجش شده"
pub func Measured(width: f64, height: f64): MeasureOutput:
    ret MeasureOutput { width = width, height = height }
end

@en "MeasuredWithBaseline"
@fa "سنجش شده با خط پایه"
pub func MeasuredWithBaseline(width: f64, height: f64, baseline: f64): MeasureOutput:
    ret MeasureOutput { width = width, height = height, baseline = baseline, has_baseline = true }
end
