    @fa "خط پایه"
    pub baseline: f64 = 0.0
    @en "has_baseline"
    @fa "دارای خط پایه"
    pub has_baseline: bool = false
end

struct Inp:
    pub kw: f64 = NO
    pub kh: f64 = NO
    pub kw_def: bool = true
    pub kh_def: bool = true
    pub pw: f64 = NO
    pub ph: f64 = NO
    pub aw: f64 = MAXC
    pub ah: f64 = MAXC
    pub inherent: bool = false
    pub axis: int = 2
    pub perform: bool = false
    pub cstart: bool = false
    pub cend: bool = false
end

struct Out:
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub baseline: f64 = NO
    pub top_pos: f64 = 0.0
    pub top_neg: f64 = 0.0
    pub bot_pos: f64 = 0.0
    pub bot_neg: f64 = 0.0
    pub collapse: bool = false
end

struct R4:
    pub t: f64 = 0.0
    pub r: f64 = 0.0
    pub b: f64 = 0.0
    pub l: f64 = 0.0
end

struct CEdge:
    pub w: f64 = 0.0
    pub rank: int = 0
    pub origin: int = -1
    pub node: int = -1
    pub side: int = 0
    pub hidden: bool = false
end

struct TBord:
    pub h: Vector<CEdge> = Vector {}
    pub v: Vector<CEdge> = Vector {}
    pub xs: Vector<f64> = Vector {}
    pub ys: Vector<f64> = Vector {}
    pub nr: int = 0
    pub nc: int = 0
end

struct Node:
    pub style: Style = Style {}
    pub children: Vector<int> = Vector {}
    pub parent: int = -1
    pub has_measure: bool = false
    pub measure: func (MeasureInput) MeasureOutput = (_mi: MeasureInput): ret MeasureOutput {} end
    pub fin_ok: bool = false
    pub fin_key: Inp = Inp {}
    pub fin_out: Out = Out {}
    pub ckeys: Vector<Inp> = Vector {}
    pub couts: Vector<Out> = Vector {}
    pub cnext: int = 0
    pub lx: f64 = 0.0
    pub ly: f64 = 0.0
    pub lw: f64 = 0.0
