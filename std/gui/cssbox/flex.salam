package cssbox

struct FItem:
    pub id: int = 0
    pub order: int = 0
    pub w: f64 = NO
    pub h: f64 = NO
    pub wst: Length = Length {}
    pub hst: Length = Length {}
    pub minw: f64 = NO
    pub minh: f64 = NO
    pub maxw: f64 = NO
    pub maxh: f64 = NO
    pub ratio: f64 = 0.0
    pub align: Align = Align.Stretch
    pub ovx: Overflow = Overflow.Visible
    pub ovy: Overflow = Overflow.Visible
    pub grow: f64 = 0.0
    pub shrink: f64 = 1.0
    pub basis_def: bool = false
    pub rmin: f64 = 0.0
    pub rel_main: f64 = 0.0
    pub rel_cross: f64 = 0.0
    pub mar: R4 = R4 {}
    pub at: bool = false
    pub ar: bool = false
    pub ab: bool = false
    pub al: bool = false
    pub pad: R4 = R4 {}
    pub bor: R4 = R4 {}
    pub basis: f64 = 0.0
    pub ibasis: f64 = 0.0
    pub viol: f64 = 0.0
    pub frozen: bool = false
    pub cff: f64 = 0.0
    pub hiw: f64 = 0.0
    pub hih: f64 = 0.0
    pub how: f64 = 0.0
    pub hoh: f64 = 0.0
    pub tw: f64 = 0.0
    pub th: f64 = 0.0
    pub otw: f64 = 0.0
    pub oth: f64 = 0.0
    pub base: f64 = 0.0
    pub offm: f64 = 0.0
    pub offc: f64 = 0.0
end

struct FLine:
    pub s: int = 0
    pub e: int = 0
    pub cross: f64 = 0.0
    pub off: f64 = 0.0
end

struct FC:
    pub row: bool = true
    pub rev: bool = false
    pub rtl: bool = false
    pub wrap: bool = false
    pub wrap_rev: bool = false
    pub minw: f64 = NO
    pub minh: f64 = NO
    pub maxw: f64 = NO
    pub maxh: f64 = NO
    pub bor: R4 = R4 {}
    pub cbi: R4 = R4 {}
    pub pbi: R4 = R4 {}
    pub sgx: f64 = 0.0
    pub sgy: f64 = 0.0
    pub gapw: f64 = 0.0
    pub gaph: f64 = 0.0
    pub align_items: Align = Align.Stretch
    pub align_content: Align = Align.Stretch
    pub justify: Align = Align.FlexStart
    pub now: f64 = NO
    pub noh: f64 = NO
    pub niw: f64 = NO
    pub nih: f64 = NO
    pub kmain_def: bool = false
    pub def_main: bool = false
    pub def_cross: bool = false
    pub cross_av_def: bool = false
    pub cw: f64 = 0.0
    pub ch: f64 = 0.0
    pub icw: f64 = 0.0
    pub ich: f64 = 0.0
end

func _m(row: bool, w: f64, h: f64): f64:
    if row:
        ret w
    end
    ret h
end

func _c(row: bool, w: f64, h: f64): f64:
    if row:
        ret h
    end
    ret w
end

func _child_baseline(first: f64, h: f64, ovy: Overflow): f64:
    if _scroller(ovy):
        ret _fmax(_fmin(_or(first, h), h), 0.0)
    end
    ret first
end

func _content_fallback(a: Align, free: f64, n: int): Align:
    mut k := a
    if k == Align.Normal:
        k = Align.Stretch
    end
    mut safe := false
    if n <= 1 or free <= 0.0:
        switch k:
            Align.Stretch:
                k = Align.FlexStart
                break
            end
            Align.SpaceBetween:
                k = Align.FlexStart
                safe = true
                break
            end
            Align.SpaceAround, Align.SpaceEvenly:
                k = Align.Center
                safe = true
                break
            end
            else:
            end
        end
    end
    if free <= 0.0 and safe:
        ret Align.Start
    end
    ret k
end

func _content_offset(free: f64, n: int, gap: f64, mode: Align, rev: bool, first: bool): f64:
    if first:
        switch mode:
            Align.Start:
                ret 0.0
            end
            Align.FlexStart:
                ret rev ? free : 0.0
            end
            Align.End:
                ret free
            end
            Align.FlexEnd:
                ret rev ? 0.0 : free
            end
            Align.Center:
                ret free / 2.0
            end
            Align.SpaceAround:
                if free >= 0.0:
                    ret (free / (n as f64)) / 2.0
                end
                ret free / 2.0
            end
            Align.SpaceEvenly:
                if free >= 0.0:
                    ret free / ((n + 1) as f64)
                end
                ret free / 2.0
            end
            else:
                ret 0.0
            end
        end
    end
    fs := _fmax(free, 0.0)
    switch mode:
        Align.SpaceBetween:
            ret gap + fs / ((n - 1) as f64)
        end
        Align.SpaceAround:
            ret gap + fs / (n as f64)
        end
        Align.SpaceEvenly:
            ret gap + fs / ((n + 1) as f64)
        end
        else:
            ret gap
        end
    end
    ret gap
end

func _norm_align(a: Align): Align:
    if a == Align.Normal or a == Align.Auto:
        ret Align.Stretch
    end
    ret a
end

func _flex_stretched(it: FItem, row: bool): bool:
    cs := row ? it.hst : it.wst
    cauto := row ? (it.at or it.ab) : (it.al or it.ar)
    ret not cauto and (cs.kind == LengthKind.Stretch or (it.align == Align.Stretch and cs.kind == LengthKind.Auto))
end

func _flex_baseline_item(it: FItem, row: bool): bool:
    cauto := row ? (it.at or it.ab) : (it.al or it.ar)
    ret it.align == Align.Baseline and not cauto
end

func _flex_kdef_w(fc: FC, it: FItem): bool:
    if fc.row:
        ret fc.def_main or it.basis_def
    end
    ret _flex_stretched(it, fc.row) or _is(it.w) or (not fc.row and fc.cross_av_def)
end

func _flex_kdef_h(fc: FC, it: FItem): bool:
    if not fc.row:
        ret fc.def_main or it.basis_def
    end
    ret _flex_stretched(it, fc.row) or _is(it.h)
end

func _measure(t &: Engine, id: int, kw: f64, kh: f64, pw: f64, ph: f64, aw: f64, ah: f64, axis: int): f64:
    o := _layout(t, id, Inp { kw = kw, kh = kh, pw = pw, ph = ph, aw = aw, ah = ah, axis = axis })
    if axis == 0:
        ret o.w
    end
    ret o.h
end

func _keyword_avail(l: Length, stretch: f64, exact &: f64): f64:
    exact = NO
    switch l.kind:
        LengthKind.MinContent:
            ret MINC
        end
        LengthKind.MaxContent:
            ret MAXC
        end
        LengthKind.FitContent:
            if _is(stretch):
                ret stretch
            end
            ret NO
        end
        LengthKind.Stretch:
            exact = stretch
            ret NO
        end
        else:
            ret NO
        end
    end
    ret NO
end

func _flex_consts(t &: Engine, id: int, inp: Inp): FC:
    n := t.nodes.Ref(id)
    st := n.style
    mut fc := FC {}
    fd := st.flex_direction
    fc.row = fd == FlexDirection.Row or fd == FlexDirection.RowReverse
    fc.rev = fd == FlexDirection.RowReverse or fd == FlexDirection.ColumnReverse
    fc.wrap = st.flex_wrap != FlexWrap.NoWrap
    fc.wrap_rev = st.flex_wrap == FlexWrap.WrapReverse
    ratio := st.aspect_ratio
    pad := _r4(st.padding, inp.pw)
    bor := _r4(st.border, inp.pw)
    pbw := pad.l + pad.r + bor.l + bor.r
    pbh := pad.t + pad.b + bor.t + bor.b
    adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
    adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
    fc.align_items = _norm_align(st.align_items)
    fc.align_content = st.align_content == Align.Normal ? Align.Stretch : st.align_content
    fc.justify = st.justify_content == Align.Normal ? Align.FlexStart : st.justify_content
    fc.rtl = st.direction == Direction.Rtl
    fc.sgx = st.overflow_y == Overflow.Scroll ? st.scrollbar_width : 0.0
    fc.sgy = st.overflow_x == Overflow.Scroll ? st.scrollbar_width : 0.0
    mut cbi := _r4add(pad, bor)
    cbi.b += fc.sgy
    if fc.rtl:
        cbi.l += fc.sgx
    else:
        cbi.r += fc.sgx
    end
    fc.cbi = cbi
    fc.bor = bor
    fc.pbi = R4 { t = bor.t, b = bor.b + fc.sgy, l = bor.l + (fc.rtl ? fc.sgx : 0.0), r = bor.r + (fc.rtl ? 0.0 : fc.sgx) }
    fc.now = inp.kw
    fc.noh = inp.kh
    fc.niw = _sub(inp.kw, cbi.l + cbi.r)
    fc.nih = _sub(inp.kh, cbi.t + cbi.b)
    fc.kmain_def = fc.row ? inp.kw_def : inp.kh_def
    fc.def_main = fc.kmain_def and _is(_m(fc.row, inp.kw, inp.kh))
    fc.def_cross = (fc.row ? inp.kh_def : inp.kw_def) and _is(_c(fc.row, inp.kw, inp.kh))
    fc.cross_av_def = fc.def_cross or _def(_c(fc.row, inp.aw, inp.ah))
    fc.gapw = _res0(st.column_gap, _or(fc.niw, 0.0))
    fc.gaph = _res0(st.row_gap, _or(fc.nih, 0.0))
    mnw0 := _res(st.min_width, inp.pw)
    mnh0 := _res(st.min_height, inp.ph)
    mxw0 := _res(st.max_width, inp.pw)
    mxh0 := _res(st.max_height, inp.ph)
    fc.minw = _add(_arw(mnw0, mnh0, ratio), adjw)
    fc.minh = _add(_arh(mnw0, mnh0, ratio), adjh)
    fc.maxw = _add(_arw(mxw0, mxh0, ratio), adjw)
    fc.maxh = _add(_arh(mxw0, mxh0, ratio), adjh)
    ret fc
end

func _flex_items(t &: Engine, kids: Vector<int>, fc: FC): Vector<FItem>:
    mut items := Vector {} as Vector<FItem>
    prw := fc.niw
    prh := fc.kmain_def ? fc.nih : (fc.row ? fc.nih : NO)
    prw2 := fc.kmain_def ? fc.niw : (fc.row ? NO : fc.niw)
    repeat kids.Len() in i:
        c := kids.Get(i)
        n := t.nodes.Ref(c)
        st := n.style
        if _oof(st.position) or st.display == Display.None:
            continue
        end
        ratio := st.aspect_ratio
        pad := _r4(st.padding, prw)
        bor := _r4(st.border, prw)
        pbw := pad.l + pad.r + bor.l + bor.r
        pbh := pad.t + pad.b + bor.t + bor.b
        adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
        adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
        w0 := _res(st.width, prw2)
        h0 := _res(st.height, prh)
        mut it := FItem { id = c, order = st.order, wst = st.width, hst = st.height, ratio = ratio, pad = pad, bor = bor }
        it.w = _add(_arw(w0, h0, ratio), adjw)
        it.h = _add(_arh(w0, h0, ratio), adjh)
        it.minw = _add(_res(st.min_width, prw2), adjw)
        it.minh = _add(_res(st.min_height, prh), adjh)
        it.maxw = _add(_res(st.max_width, prw2), adjw)
        it.maxh = _add(_res(st.max_height, prh), adjh)
        if _isrel(st.position):
            iw := _r4opt(st.inset, fc.niw)
            ih := _r4opt(st.inset, fc.nih)
            ins := R4 { t = ih.t, b = ih.b, l = iw.l, r = iw.r }
            if fc.row:
                if fc.rtl:
                    it.rel_main = _is(ins.r) ? ins.r : (_is(ins.l) ? 0.0 - ins.l : 0.0)
                else:
                    it.rel_main = _is(ins.l) ? ins.l : (_is(ins.r) ? 0.0 - ins.r : 0.0)
                end
                it.rel_cross = _is(ins.t) ? ins.t : (_is(ins.b) ? 0.0 - ins.b : 0.0)
            else:
                it.rel_main = _is(ins.t) ? ins.t : (_is(ins.b) ? 0.0 - ins.b : 0.0)
                if fc.rtl:
                    it.rel_cross = _is(ins.r) ? 0.0 - ins.r : (_is(ins.l) ? ins.l : 0.0)
                else:
                    it.rel_cross = _is(ins.l) ? ins.l : (_is(ins.r) ? 0.0 - ins.r : 0.0)
                end
            end
        end
        it.mar = _r4(st.margin, fc.niw)
        it.at = _isauto(st.margin.top)
        it.ar = _isauto(st.margin.right)
        it.ab = _isauto(st.margin.bottom)
        it.al = _isauto(st.margin.left)
        it.align = _norm_align(st.align_self == Align.Auto ? fc.align_items : st.align_self)
        it.ovx = st.overflow_x
        it.ovy = st.overflow_y
        it.grow = st.flex_grow
        it.shrink = st.flex_shrink
        mut j := items.Len()
        until j > 0 and items.Get(j - 1).order > it.order:
            j--
        end
        items.Insert(j, it)
    end
    ret items
end

func _flex_base_sizes(t &: Engine, items &: Vector<FItem>, fc: FC, aw: f64, ah: f64):
    row := fc.row
    repeat items.Len() in i:
        mut it := items.Get(i)
        n := t.nodes.Ref(it.id)
        st := n.style
        cross_parent := _c(row, fc.niw, fc.nih)
        cpw := row ? NO : cross_parent
        cph := row ? cross_parent : NO
        tminw := _arw(it.minw, it.minh, it.ratio)
        tminh := _arh(it.minw, it.minh, it.ratio)
        tmaxw := _arw(it.maxw, it.maxh, it.ratio)
        tmaxh := _arh(it.maxw, it.maxh, it.ratio)
        min_cross := _c(row, tminw, tminh)
        max_cross := _c(row, tmaxw, tmaxh)
        avc := _c(row, aw, ah)
        mut cross_av := avc
        if _def(avc):
            cross_av = _clampf(_fmax(_or(cross_parent, avc) - _c(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b), 0.0), min_cross, max_cross)
        else avc < 0.0:
            cross_av = _is(min_cross) ? min_cross : MINC
        else:
            cross_av = _is(max_cross) ? max_cross : MAXC
        end
        mut cross_def := _is(_c(row, it.w, it.h))
        mut ckc := _clamp(_c(row, it.w, it.h), min_cross, max_cross)
        cauto := row ? (it.at or it.ab) : (it.al or it.ar)
        if it.align == Align.Stretch and not cauto and not _is(ckc):
            ckc = _avopt(cross_av)
            cross_def = not fc.wrap and fc.def_cross and _is(cross_parent)
        end
        ckw := row ? NO : ckc
        ckh := row ? ckc : NO
        pbw := it.pad.l + it.pad.r + it.bor.l + it.bor.r
        pbh := it.pad.t + it.pad.b + it.bor.t + it.bor.b
        adj_main := st.box_sizing == BoxSizing.ContentBox ? _m(row, pbw, pbh) : 0.0
        pct_main := fc.kmain_def ? _m(row, fc.niw, fc.nih) : NO
        bst := st.flex_basis
        fb := _add(_res(bst, pct_main), adj_main)
        main_size := _m(row, it.w, it.h)
        main_stretch := _mmax(_sub(pct_main, _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)), 0.0)
        mut kav := NO
        mut done := false
        mut basis := 0.0
        mut ex := NO
        if _iskeyword(bst):
            kav = _keyword_avail(bst, main_stretch, ex)
            if _is(ex):
                done = true
                basis = ex
                it.basis_def = true
            end
        else:
            if _is(fb):
                done = true
                basis = fb
                it.basis_def = true
            else _isauto(bst) and _is(main_size):
                done = true
                basis = main_size
                it.basis_def = true
            else _isauto(bst):
                kav = _keyword_avail(row ? it.wst : it.hst, main_stretch, ex)
                if _is(ex):
                    done = true
                    basis = ex
                    it.basis_def = true
                end
            end
        end
        if not done and cross_def and it.ratio > 0.0 and _is(ckc):
            done = true
            it.basis_def = true
            basis = row ? ckc * it.ratio : ckc / it.ratio
        end
        if not done:
            mut am := _m(row, aw, ah) <= -1.0e299 ? MINC : MAXC
            if kav != NO:
                am = kav
            end
            caw := row ? am : cross_av
            cah := row ? cross_av : am
            basis = _measure(t, it.id, ckw, ckh, cpw, cph, caw, cah, row ? 0 : 1)
        end
        pbm := _m(row, pbw, pbh)
        basis = _fmax(basis, pbm)
        it.basis = basis
        it.ibasis = basis - pbm
        ov_main := row ? it.ovx : it.ovy
        mut smin := _m(row, it.minw, it.minh)
        if not _is(smin) and _scroller(ov_main):
            smin = 0.0
        end
        if _is(smin):
            it.rmin = smin
        else:
            minc_w := row ? MINC : cross_av
            minc_h := row ? cross_av : MINC
            mc := _measure(t, it.id, ckw, ckh, cpw, cph, minc_w, minc_h, row ? 0 : 1)
            clamped := _mmin(_mmin(mc, main_size), _m(row, tmaxw, tmaxh))
            it.rmin = _fmax(clamped, pbm)
        end
        hmin := _fmax(_fmax(it.rmin, _or(_m(row, tminw, tminh), it.rmin)), pbm)
        hi := _clampf(basis, hmin, _m(row, tmaxw, tmaxh))
        ho := hi + _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
        if row:
            it.hiw = hi
            it.how = ho
        else:
            it.hih = hi
            it.hoh = ho
        end
        items.Set(i, it)
    end
end

func _hyp_main_outer(it: FItem, row: bool): f64:
    ret row ? it.how : it.hoh
end

func _flex_lines(items: Vector<FItem>, fc: FC, aw: f64, ah: f64): Vector<FLine>:
    mut lines := Vector {} as Vector<FLine>
    row := fc.row
    nitems := items.Len()
    if not fc.wrap or not fc.kmain_def:
        lines.Push(FLine { s = 0, e = nitems })
        ret lines
    end
    avm := _m(row, aw, ah)
    maxm := _m(row, fc.maxw, fc.maxh)
    mut mav := avm
    if _is(maxm):
        mut av := _def(avm) ? avm : maxm
        if not fc.def_main:
            av = _fmin(av, maxm)
        end
        mav = _fmax(av, _or(_m(row, fc.minw, fc.minh), av))
    else not row and not fc.def_main and _def(avm):
        mav = MAXC
    end
    if mav >= 1.0e299:
        lines.Push(FLine { s = 0, e = nitems })
        ret lines
    end
    if mav <= -1.0e299:
        repeat nitems in i:
            lines.Push(FLine { s = i, e = i + 1 })
        end
        ret lines
    end
    gap := _m(row, fc.gapw, fc.gaph)
    mut start := 0
    until start < nitems:
        mut len := 0.0
        mut idx := start
        mut brk := nitems
        until idx < nitems:
            gc := idx == start ? 0.0 : gap
            len += _hyp_main_outer(items.Get(idx), row) + gc
            if len > mav and idx != start:
                brk = idx
                break
            end
            idx++
        end
        lines.Push(FLine { s = start, e = brk })
        start = brk
    end
    ret lines
end

func _item_main_len(it: FItem, row: bool): f64:
    pbm := row ? it.pad.l + it.pad.r + it.bor.l + it.bor.r : it.pad.t + it.pad.b + it.bor.t + it.bor.b
    mm := row ? it.mar.l + it.mar.r : it.mar.t + it.mar.b
    ret _fmax(_fmax(it.basis, _or(row ? it.minw : it.minh, it.basis)) + mm, pbm)
end

func _flex_main_size(t &: Engine, items &: Vector<FItem>, lines: Vector<FLine>, fc &: FC, aw: f64, ah: f64):
    row := fc.row
    cbm := row ? fc.cbi.l + fc.cbi.r : fc.cbi.t + fc.cbi.b
    gap := _m(row, fc.gapw, fc.gaph)
    avm := _m(row, aw, ah)
    mut outer := _m(row, fc.now, fc.noh)
    if not _is(outer):
        if _def(avm):
            mut longest := 0.0
            mut first := true
            each ln in lines:
                mut tot := _gaps(gap, ln.e - ln.s)
                repeat ln.e - ln.s in k:
                    tot += _item_main_len(items.Get(ln.s + k), row)
                end
                if first or tot > longest:
                    longest = tot
                end
                first = false
            end
            size := longest + cbm
            if lines.Len() > 1:
                outer = _fmax(size, avm)
            else:
                outer = size
            end
        else avm <= -1.0e299 and fc.wrap:
            mut longest := 0.0
            mut first := true
            each ln in lines:
                mut tot := _gaps(gap, ln.e - ln.s)
                repeat ln.e - ln.s in k:
                    tot += _item_main_len(items.Get(ln.s + k), row)
                end
                if first or tot > longest:
                    longest = tot
                end
                first = false
            end
            outer = longest + cbm
        else:
            mut main_size := 0.0
            each ln in lines:
                repeat ln.e - ln.s in k:
                    idx := ln.s + k
                    mut it := items.Get(idx)
                    smin := _m(row, it.minw, it.minh)
                    msum := _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
                    spref := _m(row, it.w, it.h)
                    smax := _m(row, it.maxw, it.maxh)
                    clb := row ? _mmax(it.basis, spref) : it.basis
                    fbmin := it.shrink == 0.0 ? clb : NO
                    fbmax := it.grow == 0.0 ? clb : NO
                    minm := _fmax(_or(_or(_mmax(smin, fbmin), fbmin), it.rmin), it.rmin)
                    maxm := _or(_or(_mmin(smax, fbmax), fbmax), BIG)
                    mut contrib := 0.0
                    is_sc := _scroller(it.ovx) or _scroller(it.ovy)
                    if _is(spref) and (maxm <= minm or maxm <= spref):
                        contrib = _fmax(_fmin(spref, maxm), minm) + msum
                    else maxm <= minm:
                        contrib = minm + msum
                    else is_sc:
                        contrib = it.basis + msum
                    else _is(spref):
                        pbm := row ? it.pad.l + it.pad.r + it.bor.l + it.bor.r : it.pad.t + it.pad.b + it.bor.t + it.bor.b
                        inner := _fmax(spref, pbm)
                        if row:
                            contrib = _clampf(inner + msum, smin, smax)
                        else:
                            contrib = _clampf(_fmax(inner, it.basis) + msum, smin, smax)
                        end
                    else:
                        cross_parent := _c(row, fc.niw, fc.nih)
                        cmin := _c(row, it.minw, it.minh)
                        cmax := _c(row, it.maxw, it.maxh)
                        avc := _c(row, aw, ah)
                        mut cav := avc
                        if _def(avc):
                            cav = _fmax(_or(cross_parent, avc) - _c(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b), 0.0)
                        end
                        cav = _avclamp(cav, cmin, cmax)
                        caw := row ? aw : cav
                        cah := row ? cav : ah
                        tminw := _arw(it.minw, it.minh, it.ratio)
                        tminh := _arh(it.minw, it.minh, it.ratio)
                        tmaxw := _arw(it.maxw, it.maxh, it.ratio)
                        tmaxh := _arh(it.maxw, it.maxh, it.ratio)
                        mut ckc := _clamp(_c(row, it.w, it.h), _c(row, tminw, tminh), _c(row, tmaxw, tmaxh))
                        if it.align == Align.Stretch and not _is(ckc):
                            ckc = _avopt(cav)
                        end
                        ckw := row ? NO : ckc
                        ckh := row ? ckc : NO
                        mm := _measure(t, it.id, ckw, ckh, fc.niw, fc.nih, caw, cah, row ? 0 : 1)
                        mut tr := NO
                        if it.ratio > 0.0 and _is(ckc):
                            tr = row ? ckc * it.ratio : ckc / it.ratio
                        end
                        inner := _fmax(mm, _or(tr, mm))
                        if row:
                            contrib = _clampf(inner + msum, smin, smax)
                        else:
                            contrib = _clampf(_fmax(inner, it.basis) + msum, smin, smax)
                        end
                    end
                    diff := contrib - msum - it.basis
                    if diff > 0.0:
                        it.cff = diff / _fmax(1.0, it.grow)
                    else diff < 0.0:
                        it.cff = diff / (_fmax(1.0, it.shrink) * it.ibasis)
                    else:
                        it.cff = 0.0
                    end
                    items.Set(idx, it)
                end
                floor_largest := fc.wrap and row
                mut largest := 0.0
                mut sum := 0.0
                repeat ln.e - ln.s in k:
                    it := items.Get(ln.s + k)
                    mut fcon := 0.0
                    if it.cff > 0.0:
                        fcon = _fmax(1.0, it.grow) * it.cff
                    else it.cff < 0.0:
                        ssf := _fmax(1.0, it.shrink) * it.ibasis
                        fcon = ssf == 0.0 ? 0.0 : ssf * it.cff
                    end
                    sz := it.basis + fcon + _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
                    if floor_largest:
                        largest = _fmax(largest, sz)
                    end
                    sum += sz
                end
                gs := _gaps(gap, ln.e - ln.s)
                main_size = _fmax(main_size, _fmax(largest, sum + gs))
            end
            outer = main_size + cbm
        end
    end
    sgm := row ? fc.sgx : fc.sgy
    outer = _fmax(_clampf(outer, _m(row, fc.minw, fc.minh), _m(row, fc.maxw, fc.maxh)), cbm - sgm)
    inner := _fmax(outer - cbm, 0.0)
    if row:
        fc.cw = outer
        fc.icw = inner
        fc.niw = inner
    else:
        fc.ch = outer
        fc.ich = inner
        fc.nih = inner
    end
end

func _isnormal(v: f64): bool:
    ret (v > 1.0e-300 and v < 1.0e299) or (v < -1.0e-300 and v > -1.0e299)
end

func _flex_resolve(items &: Vector<FItem>, ln: FLine, fc: FC):
    row := fc.row
    count := ln.e - ln.s
    gap := _m(row, fc.gapw, fc.gaph)
    tgap := _gaps(gap, count)
    mut thyp := 0.0
    repeat count in k:
        thyp += _hyp_main_outer(items.Get(ln.s + k), row)
    end
    used_ff := tgap + thyp
    nim := _m(row, fc.niw, fc.nih)
    growing := used_ff < _or(nim, 0.0)
    shrinking := used_ff > _or(nim, 0.0)
    exact := not growing and not shrinking
    repeat count in k:
        mut it := items.Get(ln.s + k)
        hi := row ? it.hiw : it.hih
        if row:
            it.tw = hi
        else:
            it.th = hi
        end
        it.frozen = false
        if exact or (it.grow == 0.0 and it.shrink == 0.0) or (growing and it.basis > hi) or (shrinking and it.basis < hi):
            it.frozen = true
            outer_t := hi + _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
            if row:
                it.otw = outer_t
            else:
                it.oth = outer_t
            end
        end
        items.Set(ln.s + k, it)
    end
    if exact:
        ret
    end
    mut used0 := tgap
    repeat count in k:
        it := items.Get(ln.s + k)
        if it.frozen:
            used0 += row ? it.otw : it.oth
        else:
            used0 += it.basis + _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
        end
    end
    initial_free := _or(_sub(nim, used0), 0.0)
    until true:
        mut all_frozen := true
        mut items_space := 0.0
        mut sgrow := 0.0
        mut sshrink := 0.0
        repeat count in k:
            it := items.Get(ln.s + k)
            if it.frozen:
                items_space += row ? it.otw : it.oth
            else:
                all_frozen = false
                items_space += it.basis + _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
                sgrow += it.grow
                sshrink += it.shrink
            end
        end
        if all_frozen:
            break
        end
        used := tgap + items_space
        mut free := 0.0
        if growing and sgrow < 1.0:
            free = _fmin(initial_free * sgrow - tgap, _or(_sub(nim, used), BIG))
        else shrinking and sshrink < 1.0:
            free = _fmax(initial_free * sshrink - tgap, _or(_sub(nim, used), 0.0 - BIG))
        else:
            free = _or(_sub(nim, used), used_ff - used)
        end
        if _isnormal(free):
            if growing and sgrow > 0.0:
                repeat count in k:
                    mut it := items.Get(ln.s + k)
                    if not it.frozen:
                        v := it.basis + free * (it.grow / sgrow)
                        if row:
                            it.tw = v
                        else:
                            it.th = v
                        end
                        items.Set(ln.s + k, it)
                    end
                end
            else shrinking and sshrink > 0.0:
                mut ssum := 0.0
                repeat count in k:
                    it := items.Get(ln.s + k)
                    if not it.frozen:
                        ssum += it.ibasis * it.shrink
                    end
                end
                if ssum > 0.0:
                    repeat count in k:
                        mut it := items.Get(ln.s + k)
                        if not it.frozen:
                            v := it.basis + free * ((it.ibasis * it.shrink) / ssum)
                            if row:
                                it.tw = v
                            else:
                                it.th = v
                            end
                            items.Set(ln.s + k, it)
                        end
                    end
                end
            end
        end
        mut tviol := 0.0
        repeat count in k:
            mut it := items.Get(ln.s + k)
            if not it.frozen:
                tg := row ? it.tw : it.th
                cl := _fmax(_clampf(tg, it.rmin, _m(row, it.maxw, it.maxh)), 0.0)
                it.viol = cl - tg
                mm := _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
                if row:
                    it.tw = cl
                    it.otw = cl + mm
                else:
                    it.th = cl
                    it.oth = cl + mm
                end
                tviol += it.viol
                items.Set(ln.s + k, it)
            end
        end
        repeat count in k:
            mut it := items.Get(ln.s + k)
            if not it.frozen:
                if tviol > 0.0:
                    it.frozen = it.viol > 0.0
                else tviol < 0.0:
                    it.frozen = it.viol < 0.0
                else:
                    it.frozen = true
                end
                items.Set(ln.s + k, it)
            end
        end
    end
end

func _flex_hyp_cross(t &: Engine, items &: Vector<FItem>, ln: FLine, fc: FC, kw: f64, kh: f64, aw: f64, ah: f64):
    row := fc.row
    known := not fc.wrap and _is(_c(row, kw, kh))
    repeat ln.e - ln.s in k:
        idx := ln.s + k
        mut it := items.Get(idx)
        pbc := row ? it.pad.t + it.pad.b + it.bor.t + it.bor.b : it.pad.l + it.pad.r + it.bor.l + it.bor.r
        if known and _flex_stretched(it, row) and not _flex_baseline_item(it, row):
            continue
        end
        mm := _m(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
        mc := _c(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
        cam := _fmax(_m(row, fc.cw, fc.ch) - mm, 0.0)
        tminc := _c(row, _arw(it.minw, it.minh, it.ratio), _arh(it.minw, it.minh, it.ratio))
        tmaxc := _c(row, _arw(it.maxw, it.maxh, it.ratio), _arh(it.maxw, it.maxh, it.ratio))
        ccross := _mmax(_clamp(_c(row, it.w, it.h), tminc, tmaxc), pbc)
        avc := _c(row, aw, ah)
        mut cac := avc
        if _def(avc):
            cac = _fmax(avc - mc, 0.0)
        end
        cac = _avmax(_avclamp(cac, tminc, tmaxc), pbc)
        stretch := _mmax(_sub(_c(row, fc.niw, fc.nih), mc), 0.0)
        mut ex := NO
        kav := _keyword_avail(row ? it.hst : it.wst, stretch, ex)
        if kav != NO:
            cac = kav
        end
        mut inner := ccross
        if not _is(inner):
            iw := row ? it.tw : ccross
            ih := row ? ccross : it.th
            caw := row ? cam : cac
            cah := row ? cac : cam
            o := _layout(t, it.id, Inp { kw = iw, kh = ih, kw_def = _flex_kdef_w(fc, it), kh_def = _flex_kdef_h(fc, it), pw = fc.niw, ph = fc.nih, aw = caw, ah = cah, axis = row ? 1 : 0 })
            inner = _fmax(_clampf(_c(row, o.w, o.h), tminc, tmaxc), pbc)
        end
        if row:
            it.hih = inner
            it.hoh = inner + mc
        else:
            it.hiw = inner
            it.how = inner + mc
        end
        items.Set(idx, it)
    end
end

func _flex_baselines(t &: Engine, items &: Vector<FItem>, lines: Vector<FLine>, fc: FC, kh: f64, ah: f64):
    if not fc.row:
        ret
    end
    each ln in lines:
        mut cnt := 0
        repeat ln.e - ln.s in k:
            if _flex_baseline_item(items.Get(ln.s + k), true):
                cnt++
            end
        end
        if cnt <= 1:
            continue
        end
        repeat ln.e - ln.s in k:
            idx := ln.s + k
            mut it := items.Get(idx)
            if not _flex_baseline_item(it, true):
                continue
            end
            caw := _fmax(fc.cw - it.mar.l - it.mar.r, 0.0)
            mut cah := _avset(ah, kh)
            if _def(cah):
                cah = _fmax(cah - it.mar.t - it.mar.b, 0.0)
            end
            o := _layout(t, it.id, Inp { kw = it.tw, kh = it.hih, kw_def = _flex_kdef_w(fc, it), kh_def = _flex_kdef_h(fc, it), pw = fc.niw, ph = fc.nih, aw = caw, ah = cah, axis = 2, perform = true })
            b := _or(_child_baseline(o.baseline, o.h, it.ovy), o.h)
            it.base = b + it.mar.t
            items.Set(idx, it)
        end
    end
end

func _flex_cross_size(items: Vector<FItem>, lines &: Vector<FLine>, fc: FC, kw: f64, kh: f64):
    row := fc.row
    cpb := _c(row, fc.cbi.l + fc.cbi.r, fc.cbi.t + fc.cbi.b)
    cmin := _c(row, fc.minw, fc.minh)
    cmax := _c(row, fc.maxw, fc.maxh)
    kc := _c(row, kw, kh)
    if not fc.wrap and _is(kc):
        mut l0 := lines.Get(0)
        l0.cross = _or(_mmax(_sub(_clamp(kc, cmin, cmax), cpb), 0.0), 0.0)
        lines.Set(0, l0)
        ret
    end
    repeat lines.Len() in li:
        mut ln := lines.Get(li)
        mut maxb := 0.0
        repeat ln.e - ln.s in k:
            maxb = _fmax(maxb, items.Get(ln.s + k).base)
        end
        mut cs := 0.0
        repeat ln.e - ln.s in k:
            it := items.Get(ln.s + k)
            hoc := row ? it.hoh : it.how
            if _flex_baseline_item(it, row):
                cs = _fmax(cs, maxb - it.base + hoc)
            else:
                cs = _fmax(cs, hoc)
            end
        end
        ln.cross = cs
        lines.Set(li, ln)
    end
    if not fc.wrap:
        mut l0 := lines.Get(0)
        l0.cross = _clampf(l0.cross, _sub(cmin, cpb), _sub(cmax, cpb))
        lines.Set(0, l0)
    end
end

func _flex_align_stretch(lines &: Vector<FLine>, fc: FC, kw: f64, kh: f64):
    if fc.align_content != Align.Stretch:
        ret
    end
    row := fc.row
    cpb := _c(row, fc.cbi.l + fc.cbi.r, fc.cbi.t + fc.cbi.b)
    cmin := _c(row, fc.minw, fc.minh)
    cmax := _c(row, fc.maxw, fc.maxh)
    minc := _or(_mmax(_sub(_clamp(_or(_c(row, kw, kh), cmin), cmin, cmax), cpb), 0.0), 0.0)
    mut tot := _gaps(_c(row, fc.gapw, fc.gaph), lines.Len())
    each ln in lines:
        tot += ln.cross
    end
    if tot < minc:
        add := (minc - tot) / (lines.Len() as f64)
        repeat lines.Len() in li:
            mut ln := lines.Get(li)
            ln.cross += add
            lines.Set(li, ln)
        end
    end
end

func _flex_used_cross(t &: Engine, items &: Vector<FItem>, lines: Vector<FLine>, fc: FC):
    row := fc.row
    each ln in lines:
        repeat ln.e - ln.s in k:
            idx := ln.s + k
            mut it := items.Get(idx)
            mc := _c(row, it.mar.l + it.mar.r, it.mar.t + it.mar.b)
            mut v := row ? it.hih : it.hiw
            if _flex_stretched(it, row):
                n := t.nodes.Ref(it.id)
                st := n.style
                pbw := it.pad.l + it.pad.r + it.bor.l + it.bor.r
                pbh := it.pad.t + it.pad.b + it.bor.t + it.bor.b
                adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
                adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
                mxw := _add(_res(st.max_width, fc.niw), adjw)
                mxh := _add(_res(st.max_height, fc.nih), adjh)
                v = _clampf(_fmax(ln.cross - mc, 0.0), _c(row, it.minw, it.minh), _c(row, mxw, mxh))
            end
            if row:
                it.th = v
                it.oth = v + mc
            else:
                it.tw = v
                it.otw = v + mc
            end
            items.Set(idx, it)
        end
    end
end

func _flex_distribute(items &: Vector<FItem>, lines: Vector<FLine>, fc: FC):
    row := fc.row
    gap := _m(row, fc.gapw, fc.gaph)
    each ln in lines:
        count := ln.e - ln.s
        mut used := _gaps(gap, count)
        mut nauto := 0
        repeat count in k:
            it := items.Get(ln.s + k)
            used += row ? it.otw : it.oth
            if row ? it.al : it.at:
                nauto++
            end
            if row ? it.ar : it.ab:
                nauto++
            end
        end
        mut free := _m(row, fc.icw, fc.ich) - used
        if free > 0.0 and nauto > 0:
            mg := free / (nauto as f64)
            repeat count in k:
                mut it := items.Get(ln.s + k)
                if row:
                    if it.al:
                        it.mar.l = mg
                    end
                    if it.ar:
                        it.mar.r = mg
                    end
                else:
                    if it.at:
                        it.mar.t = mg
                    end
                    if it.ab:
                        it.mar.b = mg
                    end
                end
                items.Set(ln.s + k, it)
            end
            free = 0.0
        end
        mode := _content_fallback(fc.justify, free, count)
        repeat count in k:
            idx := fc.rev ? ln.e - 1 - k : ln.s + k
            mut it := items.Get(idx)
            it.offm = _content_offset(free, count, gap, mode, fc.rev, k == 0)
            items.Set(idx, it)
        end
    end
end

func _flex_cross_align_item(it: FItem, free: f64, maxb: f64, maxbb: f64, fc: FC): f64:
    rev := not fc.row and fc.rtl
    switch it.align:
        Align.Start:
            ret rev ? free : 0.0
        end
        Align.End:
            ret rev ? 0.0 : free
        end
        Align.FlexEnd:
            ret (fc.wrap_rev != rev) ? 0.0 : free
        end
        Align.Center:
            ret free / 2.0
        end
        Align.Baseline:
            if fc.row:
                if fc.wrap_rev:
                    lcs := free + it.oth
                    ret lcs - maxbb - it.base
                end
                ret maxb - it.base
            end
            bcr := rev and not fc.wrap
            ret (fc.wrap_rev != bcr) ? free : 0.0
        end
        else:
            ret (fc.wrap_rev != rev) ? free : 0.0
        end
    end
    ret 0.0
end

func _flex_cross_margins(items &: Vector<FItem>, lines: Vector<FLine>, fc: FC):
    row := fc.row
    each ln in lines:
        mut maxb := 0.0
        mut maxbb := 0.0
        repeat ln.e - ln.s in k:
            it := items.Get(ln.s + k)
            maxb = _fmax(maxb, it.base)
            if _flex_baseline_item(it, row):
                maxbb = _fmax(maxbb, (row ? it.oth : it.otw) - it.base)
            end
        end
        repeat ln.e - ln.s in k:
            idx := ln.s + k
            mut it := items.Get(idx)
            free := ln.cross - (row ? it.oth : it.otw)
            cs := row ? it.at : it.al
            ce := row ? it.ab : it.ar
            if cs and ce:
                if row:
                    it.mar.t = free / 2.0
                    it.mar.b = free / 2.0
                else:
                    it.mar.l = free / 2.0
                    it.mar.r = free / 2.0
                end
            else cs:
                if row:
                    it.mar.t = free
                else:
                    it.mar.l = free
                end
            else ce:
                if row:
                    it.mar.b = free
                else:
                    it.mar.r = free
                end
            else:
                it.offc = _flex_cross_align_item(it, free, maxb, maxbb, fc)
            end
            items.Set(idx, it)
        end
    end
end

func _flex_container_cross(lines: Vector<FLine>, fc &: FC, kw: f64, kh: f64): f64:
    row := fc.row
    tgap := _gaps(_c(row, fc.gapw, fc.gaph), lines.Len())
    mut tot := 0.0
    each ln in lines:
        tot += ln.cross
    end
    pbs := _c(row, fc.cbi.l + fc.cbi.r, fc.cbi.t + fc.cbi.b)
    sgc := row ? fc.sgy : fc.sgx
    kc := _c(row, kw, kh)
    outer := _fmax(_clampf(_or(kc, tot + tgap + pbs), _c(row, fc.minw, fc.minh), _c(row, fc.maxw, fc.maxh)), pbs - sgc)
    inner := _fmax(outer - pbs, 0.0)
    if row:
        fc.ch = outer
        fc.ich = inner
    else:
        fc.cw = outer
        fc.icw = inner
    end
    ret tot
end

func _flex_align_lines(lines &: Vector<FLine>, fc: FC, tot: f64):
    row := fc.row
    nl := lines.Len()
    gap := _c(row, fc.gapw, fc.gaph)
    free := _c(row, fc.icw, fc.ich) - tot - _gaps(gap, nl)
    mode := _content_fallback(fc.align_content, free, nl)
    repeat nl in k:
        idx := fc.wrap_rev ? nl - 1 - k : k
        mut ln := lines.Get(idx)
        ln.off = _content_offset(free, nl, gap, mode, fc.wrap_rev, k == 0)
        lines.Set(idx, ln)
    end
end

func _flex_place_item(t &: Engine, items &: Vector<FItem>, idx: int, tom &: f64, toc: f64, loc: f64, fc: FC):
    mut it := items.Get(idx)
    row := fc.row
    o := _layout(t, it.id, Inp { kw = it.tw, kh = it.th, kw_def = _flex_kdef_w(fc, it), kh_def = _flex_kdef_h(fc, it), pw = fc.niw, ph = fc.nih, aw = _fmax(fc.cw - it.mar.l - it.mar.r, 0.0), ah = _fmax(fc.ch - it.mar.t - it.mar.b, 0.0), axis = 2, perform = true })
    rtl_row := row and fc.rtl
    rtl_col := not row and fc.rtl
    elo := rtl_col ? 0.0 : loc
    mstart := row ? it.mar.l : it.mar.t
    mend := row ? it.mar.r : it.mar.b
    cstart := row ? it.mar.t : it.mar.l
    mut offm := 0.0
    if rtl_row:
        offm = tom - it.offm - mend - it.rel_main - o.w
    else:
        offm = tom + it.offm + mstart + it.rel_main
    end
    offc := toc + it.offc + elo + cstart + it.rel_cross
    ib := _or(_child_baseline(o.baseline, o.h, it.ovy), o.h)
    if row:
        it.base = toc + it.offc + elo + cstart + ib
    else:
        it.base = tom + it.offm + mstart + ib
    end
    lx := row ? offm : offc
    ly := row ? offc : offm
    _set_layout(t, it.id, lx, ly, o.w, o.h, it.pad, it.bor, it.mar)
    msum := row ? it.mar.l + it.mar.r : it.mar.t + it.mar.b
    sz := row ? o.w : o.h
    if rtl_row:
        tom -= it.offm + msum + sz
    else:
        tom += it.offm + msum + sz
    end
    items.Set(idx, it)
end

func _flex_final(t &: Engine, items &: Vector<FItem>, lines: Vector<FLine>, fc: FC):
    row := fc.row
    mut toc := 0.0
    if not row and fc.rtl:
        toc = fc.cw - fc.cbi.r
    else:
        toc = row ? fc.cbi.t : fc.cbi.l
    end
    nl := lines.Len()
    repeat nl in li:
        ln := lines.Get(fc.wrap_rev ? nl - 1 - li : li)
        mut tom := 0.0
        if fc.rtl and row:
            tom = fc.cw - fc.cbi.r
        else:
            tom = row ? fc.cbi.l : fc.cbi.t
        end
        rtl_col := fc.rtl and not row
        if rtl_col:
            toc -= ln.off + ln.cross
        end
        count := ln.e - ln.s
        repeat count in k:
            idx := fc.rev ? ln.e - 1 - k : ln.s + k
            _flex_place_item(t, items, idx, tom, toc, ln.off, fc)
        end
        if not rtl_col:
            toc += ln.off + ln.cross
        end
    end
end

func _flex_static_positions(t &: Engine, kids: Vector<int>, fc: FC):
    row := fc.row
    main_rtl := row and fc.rtl
    cross_rtl := not row and fc.rtl
    main_flip := fc.rev != main_rtl
    cross_flip := fc.wrap_rev != cross_rtl
    ms := row ? fc.cbi.l : fc.cbi.t
    me := row ? fc.cw - fc.cbi.r : fc.ch - fc.cbi.b
    cs := row ? fc.cbi.t : fc.cbi.l
    ce := row ? fc.ch - fc.cbi.b : fc.cw - fc.cbi.r
    each c in kids:
        n := t.nodes.Ref(c)
        st := n.style
        if st.display == Display.None or not _oof(st.position):
            continue
        end
        a := _norm_align(st.align_self == Align.Auto ? fc.align_items : st.align_self)
        mut medge := 0
        switch fc.justify:
            Align.Start:
                medge = main_rtl ? 1 : 0
                break
            end
            Align.End:
                medge = main_rtl ? 0 : 1
                break
            end
            Align.FlexEnd:
                medge = main_flip ? 0 : 1
                break
            end
            Align.Center, Align.SpaceAround, Align.SpaceEvenly:
                medge = 2
                break
            end
            else:
                medge = main_flip ? 1 : 0
            end
        end
        mut cedge := 0
        switch a:
            Align.Start, Align.Baseline:
                cedge = cross_rtl ? 1 : 0
                break
            end
            Align.End:
                cedge = cross_rtl ? 0 : 1
                break
            end
            Align.FlexEnd:
                cedge = cross_flip ? 0 : 1
                break
            end
            Align.Center:
                cedge = 2
                break
            end
            else:
                cedge = cross_flip ? 1 : 0
            end
        end
        if row:
            n.spx_s = ms
            n.spx_e = me
            n.spx_a = medge
            n.spy_s = cs
            n.spy_e = ce
            n.spy_a = cedge
        else:
            n.spx_s = cs
            n.spx_e = ce
            n.spx_a = cedge
            n.spy_s = ms
            n.spy_e = me
            n.spy_a = medge
        end
    end
end

func _flex(t &: Engine, id: int, inp: Inp): Out:
    n := t.nodes.Ref(id)
    st := n.style
    ratio := st.aspect_ratio
    pad := _r4(st.padding, inp.pw)
    bor := _r4(st.border, inp.pw)
    pbw := pad.l + pad.r + bor.l + bor.r
    pbh := pad.t + pad.b + bor.t + bor.b
    adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
    adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
    mnw0 := _res(st.min_width, inp.pw)
    mnh0 := _res(st.min_height, inp.ph)
    mxw0 := _res(st.max_width, inp.pw)
    mxh0 := _res(st.max_height, inp.ph)
    minw := _add(_arw(mnw0, mnh0, ratio), adjw)
    minh := _add(_arh(mnw0, mnh0, ratio), adjh)
    maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
    maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
    mut csw := NO
    mut csh := NO
    if inp.inherent:
        sw0 := _res(st.width, inp.pw)
        sh0 := _res(st.height, inp.ph)
        csw = _clamp(_add(_arw(sw0, sh0, ratio), adjw), minw, maxw)
        csh = _clamp(_add(_arh(sw0, sh0, ratio), adjh), minh, maxh)
    end
    mmw := (_is(minw) and _is(maxw) and maxw <= minw) ? minw : NO
    mmh := (_is(minh) and _is(maxh) and maxh <= minh) ? minh : NO
    kw := _or(inp.kw, _mmax(_or(mmw, csw), pbw))
    kh := _or(inp.kh, _mmax(_or(mmh, csh), pbh))
    if not inp.perform:
        if _is(kw) and _is(kh):
            ret Out { w = kw, h = kh }
        end
        if inp.axis == 0 and _is(kw):
            ret Out { w = kw, h = 0.0 }
        end
    end
    mut inp2 := inp
    inp2.kw = kw
    inp2.kh = kh
    inp2.kw_def = inp.kw_def or not _is(inp.kw)
    inp2.kh_def = inp.kh_def or not _is(inp.kh)
    ret _flex_pre(t, id, inp2)
end

func _flex_pre(t &: Engine, id: int, inp: Inp): Out:
    mut fc := _flex_consts(t, id, inp)
    row := fc.row
    kids := _kids(t, id)
    defer kids.Free()
    mut items := _flex_items(t, kids, fc)
    defer items.Free()
    mut aw := 0.0
    mut ah := 0.0
    if _is(inp.kw):
        aw = _fmax(inp.kw - fc.cbi.l - fc.cbi.r, 0.0)
    else:
        aw = _avmax(_avsub(inp.aw, fc.cbi.l + fc.cbi.r), 0.0)
    end
    if _is(inp.kh):
        ah = _fmax(inp.kh - fc.cbi.t - fc.cbi.b, 0.0)
    else:
        ah = _avmax(_avsub(inp.ah, fc.cbi.t + fc.cbi.b), 0.0)
    end
    _flex_base_sizes(t, items, fc, aw, ah)
    mut lines := _flex_lines(items, fc, aw, ah)
    defer lines.Free()
    nim := _m(row, fc.niw, fc.nih)
    if _is(nim):
        cbm := row ? fc.cbi.l + fc.cbi.r : fc.cbi.t + fc.cbi.b
        if row:
            fc.icw = nim
            fc.cw = nim + cbm
        else:
            fc.ich = nim
            fc.ch = nim + cbm
        end
    else:
        _flex_main_size(t, items, lines, fc, aw, ah)
        st := t.nodes.Ref(id).style
        if row:
            fc.now = fc.cw
            fc.gapw = _res0(st.column_gap, fc.icw)
        else:
            fc.noh = fc.ch
            fc.gaph = _res0(st.row_gap, fc.ich)
        end
    end
    if not inp.perform and ((inp.axis == 0 and row) or (inp.axis == 1 and not row)):
        if row:
            ret Out { w = fc.cw, h = 0.0 }
        end
        ret Out { w = 0.0, h = fc.ch }
    end
    each ln in lines:
        _flex_resolve(items, ln, fc)
    end
    each ln in lines:
        _flex_hyp_cross(t, items, ln, fc, inp.kw, inp.kh, aw, ah)
    end
    _flex_baselines(t, items, lines, fc, inp.kh, ah)
    _flex_cross_size(items, lines, fc, inp.kw, inp.kh)
    _flex_align_stretch(lines, fc, inp.kw, inp.kh)
    _flex_used_cross(t, items, lines, fc)
    _flex_distribute(items, lines, fc)
    _flex_cross_margins(items, lines, fc)
    tot := _flex_container_cross(lines, fc, inp.kw, inp.kh)
    if not inp.perform:
        ret Out { w = fc.cw, h = fc.ch }
    end
    _flex_align_lines(lines, fc, tot)
    _flex_final(t, items, lines, fc)
    _flex_static_positions(t, kids, fc)
    _hide_display_none(t, kids)
    mut base := NO
    if lines.Len() > 0 and items.Len() > 0:
        ln := lines.Get(fc.wrap_rev ? lines.Len() - 1 : 0)
        if ln.e > ln.s:
            if not row:
                base = items.Get(fc.rev ? ln.e - 1 : ln.s).base
            else:
                mut found := -1
                repeat ln.e - ln.s in k:
                    if found < 0 and _flex_baseline_item(items.Get(ln.s + k), true):
                        found = ln.s + k
                    end
                end
                if found < 0:
                    found = ln.s
                end
                base = items.Get(found).base
            end
        end
    end
    ret Out { w = fc.cw, h = fc.ch, baseline = base }
end
