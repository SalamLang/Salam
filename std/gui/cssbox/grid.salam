package cssbox

const NOLINE := -100000

struct GTr:
    pub gut: bool = false
    pub collapsed: bool = false
    pub mk: int = 0
    pub mv: f64 = 0.0
    pub xk: int = 0
    pub xv: f64 = 0.0
    pub off: f64 = 0.0
    pub base: f64 = 0.0
    pub glim: f64 = 0.0
    pub adj: f64 = 0.0
    pub inc: f64 = 0.0
    pub bpi: f64 = 0.0
    pub gpi: f64 = 0.0
    pub ig: bool = false
    pub fcl: f64 = BIG
end

struct GIt:
    pub id: int = 0
    pub src: int = 0
    pub c0: int = 0
    pub c1: int = 0
    pub r0: int = 0
    pub r1: int = 0
    pub ci0: int = 0
    pub ci1: int = 0
    pub ri0: int = 0
    pub ri1: int = 0
    pub ovx: Overflow = Overflow.Visible
    pub ovy: Overflow = Overflow.Visible
    pub aself: Align = Align.Normal
    pub jself: Align = Align.Normal
    pub base: f64 = NO
    pub shim: f64 = 0.0
    pub fc: bool = false
    pub fr: bool = false
    pub ic: bool = false
    pub ir: bool = false
    pub ga_ok: bool = false
    pub gaw: f64 = NO
    pub gah: f64 = NO
    pub kd_ok: bool = false
    pub kd_gw: f64 = NO
    pub kd_gh: f64 = NO
    pub kdw: f64 = NO
    pub kdh: f64 = NO
    pub mincw: f64 = NO
    pub minch: f64 = NO
    pub maxcw: f64 = NO
    pub maxch: f64 = NO
    pub minsw: f64 = NO
    pub minsh: f64 = NO
    pub ypos: f64 = 0.0
    pub hgt: f64 = 0.0
    pub ibase: f64 = NO
end

struct GPx:
    pub k0: int = 0
    pub v0: int = 0
    pub k1: int = 0
    pub v1: int = 0
end

struct GPlc:
    pub col: GPx = GPx {}
    pub row: GPx = GPx {}
end

struct Occ:
    pub nr0: int = 0
    pub nc0: int = 0
    pub nrt: int = 0
    pub nct: int = 0
    pub cells: Vector<u8> = Vector {}
    pub rcur: Vector<int> = Vector {}
    pub ccur: Vector<int> = Vector {}
end

struct GC:
    pub tr: Vector<GTr> = Vector {}
    pub nct: int = 0
    pub nrt: int = 0
    pub items: Vector<GIt> = Vector {}
    pub cneg: int = 0
    pub cexp: int = 0
    pub cpos: int = 0
    pub rneg: int = 0
    pub rexp: int = 0
    pub rpos: int = 0
end

struct GInfo:
    pub ok: bool = false
    pub tr: Vector<GTr> = Vector {}
    pub nct: int = 0
    pub nrt: int = 0
    pub cneg: int = 0
    pub cexp: int = 0
    pub cpos: int = 0
    pub rneg: int = 0
    pub rexp: int = 0
    pub rpos: int = 0
    pub creps: int = 0
    pub rreps: int = 0
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub bor: R4 = R4 {}
    pub sgx: f64 = 0.0
    pub sgy: f64 = 0.0
    pub rtl: bool = false
end

func _dv(k: int, v: f64, p: f64): f64:
    if k == K_PX:
        ret v
    end
    if k == K_PCT and _is(p):
        ret v * p / 100.0
    end
    ret NO
end

func _dl(k: int, v: f64, p: f64): f64:
    if k == K_FITPX:
        ret v
    end
    if k == K_FITPCT:
        if _is(p):
            ret v * p / 100.0
        end
        ret NO
    end
    ret _dv(k, v, p)
end

func _fcl_of(k: int, v: f64, p: f64): f64:
    if k == K_FITPX:
        ret v
    end
    if k == K_FITPCT and _is(p):
        ret v * p / 100.0
    end
    ret BIG
end

func _intr(k: int): bool:
    ret k == K_AUTO or k == K_MINC or k == K_MAXC or k == K_FITPX or k == K_FITPCT
end

func _mcalike(k: int): bool:
    ret k == K_AUTO or k == K_MAXC or k == K_FITPX or k == K_FITPCT
end

func _mofc(k: int): bool:
    ret k == K_MAXC or k == K_FITPX or k == K_FITPCT
end

func _usepct(k: int): bool:
    ret k == K_PCT or k == K_FITPCT
end

func _bauto(k: int, p: f64): bool:
    ret k == K_AUTO or (not _is(p) and k == K_PCT)
end

func _hdv(k: int, p: f64): bool:
    ret k == K_PX or (k == K_PCT and _is(p))
end

func _tr_flex(tr: GTr): bool:
    ret tr.xk == K_FR
end

func _tr_ff(tr: GTr): f64:
    if tr.xk == K_FR:
        ret tr.xv
    end
    ret 0.0
end

func _tr_pct(tr: GTr): bool:
    ret _usepct(tr.mk) or _usepct(tr.xk)
end

func _tr_intr(tr: GTr): bool:
    ret _intr(tr.mk) or _intr(tr.xk)
end

func _tr_fclg(tr: GTr): f64:
    ret _fmin(tr.glim, tr.fcl)
end

func _tr_collapse(tr &: GTr):
    tr.collapsed = true
    tr.mk = K_PX
    tr.mv = 0.0
    tr.xk = K_PX
    tr.xv = 0.0
    tr.fcl = BIG
end

func _tb(g: GC, a: int): int:
    if a == 0:
        ret 0
    end
    ret g.nct
end

func _tn(g: GC, a: int): int:
    if a == 0:
        ret g.nct
    end
    ret g.nrt
end

func _i0(it: GIt, a: int): int:
    if a == 0:
        ret it.ci0
    end
    ret it.ri0
end

func _i1(it: GIt, a: int): int:
    if a == 0:
        ret it.ci1
    end
    ret it.ri1
end

func _span(it: GIt, a: int): int:
    d := a == 0 ? it.c1 - it.c0 : it.r1 - it.r0
    if d < 0:
        ret 0
    end
    ret d
end

func _cflex(it: GIt, a: int): bool:
    if a == 0:
        ret it.fc
    end
    ret it.fr
end

func _cintr(it: GIt, a: int): bool:
    if a == 0:
        ret it.ic
    end
    ret it.ir
end

func _scr(o: Overflow): bool:
    ret o == Overflow.Hidden or o == Overflow.Scroll or o == Overflow.Auto or o == Overflow.Clip
end

func _it_scroll(it: GIt, a: int): bool:
    if a == 0:
        ret _scroller(it.ovx)
    end
    ret _scroller(it.ovy)
end

func _pick(a: int, w: f64, h: f64): f64:
    if a == 0:
        ret w
    end
    ret h
end

func _oz_of(line: int, explicit: int): int:
    if line > 0:
        ret line - 1
    end
    ret line + explicit + 1
end

func _area_edge(gd: GData, a: int, name: str, endp: bool): int:
    mut best := 0
    each ar in gd.areas:
        if ar.name == name:
            v := a == 0 ? (endp ? ar.ce : ar.cs) : (endp ? ar.re : ar.rs)
            best = v
        end
    end
    ret best
end

func _names_lines(names: Vector<LName>, nm: str, out &: Vector<int>):
    each ln in names:
        if ln.name == nm:
            out.push(ln.line)
        end
    end
end

func _sort_dedup(v &: Vector<int>):
    n := v.len()
    repeat n in i:
        mut j := i
        until j > 0 and v[j - 1] > v[j]:
            tmp := v[j]
            v[j] = v[j - 1]
            v[j - 1] = tmp
            j--
        end
    end
    mut out := 0
    repeat n in i:
        if out == 0 or v[out - 1] != v[i]:
            v[out] = v[i]
            out++
        end
    end
    until v.len() > out:
        _x := v.pop()
    end
end

func _ends_with(s: str, suf: str): bool:
    if s.len() < suf.len():
        ret false
    end
    ret s.ends_with(suf)
end

func _area_line(gd: GData, names: Vector<LName>, a: int, name: str, endp: bool): int:
    mut best := _area_edge(gd, a, name, endp)
    full := name + (endp ? "-end" : "-start")
    each ln in names:
        if ln.name == full:
            v := ln.line + 1
            if best == 0 or v < best:
                best = v
            end
        end
    end
    _sfree(full)
    ret best
end

func _lines_named(gd: GData, names: Vector<LName>, a: int, nm: str, out &: Vector<int>):
    _names_lines(names, nm, out)
    if _ends_with(nm, "-start"):
        base := nm.substr(0, nm.len() - 6)
        e := _area_edge(gd, a, base, false)
        if e > 0:
            out.push(e - 1)
        end
        _sfree(base)
    else _ends_with(nm, "-end"):
        base := nm.substr(0, nm.len() - 4)
        e := _area_edge(gd, a, base, true)
        if e > 0:
            out.push(e - 1)
        end
        _sfree(base)
    end
    _sort_dedup(out)
end

func _nth_fwd(lines: Vector<int>, first_line: int, n: int, explicit: int): int:
    first := first_line < 0 ? 0 : first_line
    mut cnt := 0
    each l in lines:
        if l >= first:
            cnt++
            if cnt == n:
                ret l
            end
        end
    end
    st := first > explicit + 1 ? first : explicit + 1
    ret st + (n - cnt) - 1
end

func _nth_bwd(lines: Vector<int>, last_line: int, n: int, explicit: int): int:
    last := last_line < explicit ? last_line : explicit
    mut sel := Vector {} as Vector<int>
    defer sel.free()
    each l in lines:
        if l <= last:
            sel.push(l)
        end
    end
    if sel.len() >= n:
        ret sel[sel.len() - n]
    end
    lm := last < -1 ? last : -1
    ret lm - (n - sel.len()) + 1
end

func _find_named(gd: GData, names: Vector<LName>, a: int, nm: str, idx: int, endp: bool, explicit: int): int:
    if idx == 0:
        al := _area_line(gd, names, a, nm, endp)
        if al != 0:
            ret al - 1
        end
    end
    mut lines := Vector {} as Vector<int>
    defer lines.free()
    _lines_named(gd, names, a, nm, lines)
    if idx >= 0:
        ret _nth_fwd(lines, 0, idx < 1 ? 1 : idx, explicit)
    end
    ret _nth_bwd(lines, explicit, 0 - idx, explicit)
end

func _resolve_pl(gd: GData, names: Vector<LName>, a: int, ps: GPl, pe: GPl, explicit: int): GPx:
    mut k0 := GP_AUTO
    mut v0 := 0
    mut k1 := GP_AUTO
    mut v1 := 0
    switch ps.kind:
        GP_LINE:
            k0 = GP_LINE
            v0 = _oz_of(ps.n, explicit)
            break
        end
        GP_SPAN:
            k0 = GP_SPAN
            v0 = ps.n
            break
        end
        GP_NLINE:
            k0 = GP_LINE
            v0 = _find_named(gd, names, a, ps.name, ps.n, false, explicit)
            break
        end
        GP_NSPAN:
            k0 = GP_NSPAN
            v0 = ps.n
            break
        end
        else:
        end
    end
    switch pe.kind:
        GP_LINE:
            k1 = GP_LINE
            v1 = _oz_of(pe.n, explicit)
            break
        end
        GP_SPAN:
            k1 = GP_SPAN
            v1 = pe.n
            break
        end
        GP_NLINE:
            k1 = GP_LINE
            v1 = _find_named(gd, names, a, pe.name, pe.n, true, explicit)
            break
        end
        GP_NSPAN:
            k1 = GP_NSPAN
            v1 = pe.n
            break
        end
        else:
        end
    end
    if k0 == GP_LINE and k1 == GP_NSPAN:
        mut lines := Vector {} as Vector<int>
        _lines_named(gd, names, a, pe.name, lines)
        v1 = _nth_fwd(lines, v0 + 1, v1 < 1 ? 1 : v1, explicit)
        k1 = GP_LINE
        lines.free()
    else k0 == GP_NSPAN and k1 == GP_LINE:
        mut lines := Vector {} as Vector<int>
        _lines_named(gd, names, a, ps.name, lines)
        v0 = _nth_bwd(lines, v1 - 1, v0 < 1 ? 1 : v0, explicit)
        k0 = GP_LINE
        lines.free()
    end
    if k0 == GP_NSPAN:
        k0 = GP_SPAN
        v0 = 1
    end
    if k1 == GP_NSPAN:
        k1 = GP_SPAN
        v1 = 1
    end
    if k0 == GP_SPAN and k1 == GP_SPAN:
        k1 = GP_AUTO
    end
    ret GPx { k0 = k0, v0 = v0, k1 = k1, v1 = v1 }
end

func _px_def(p: GPx): bool:
    ret p.k0 == GP_LINE or p.k1 == GP_LINE
end

func _px_lines(p: GPx, s &: int, e &: int):
    if p.k0 == GP_LINE and p.k1 == GP_LINE:
        if p.v0 == p.v1:
            s = p.v0
            e = p.v0 + 1
        else:
            s = p.v0 < p.v1 ? p.v0 : p.v1
            e = p.v0 < p.v1 ? p.v1 : p.v0
        end
        ret
    end
    if p.k0 == GP_LINE:
        s = p.v0
        e = p.k1 == GP_SPAN ? p.v0 + p.v1 : p.v0 + 1
        ret
    end
    e = p.v1
    s = p.k0 == GP_SPAN ? p.v1 - p.v0 : p.v1 - 1
end

func _px_span(p: GPx): int:
    if p.k0 == GP_SPAN:
        ret p.v0
    end
    if p.k1 == GP_SPAN:
        ret p.v1
    end
    ret 1
end

func _px_minmax(p: GPx, mn &: int, mx &: int, sp &: int):
    if p.k0 == GP_LINE and p.k1 == GP_LINE:
        if p.v0 == p.v1:
            mn = p.v0
            mx = p.v0 + 1
        else:
            mn = p.v0 < p.v1 ? p.v0 : p.v1
            mx = p.v0 < p.v1 ? p.v1 : p.v0
        end
        sp = 1
    else p.k0 == GP_LINE:
        mn = p.v0
        mx = p.k1 == GP_SPAN ? p.v0 + p.v1 : p.v0 + 1
        sp = 1
    else p.k1 == GP_LINE:
        mn = p.k0 == GP_SPAN ? p.v1 - p.v0 : p.v1 - 1
        mx = p.v1
        sp = 1
    else:
        mn = 0
        mx = 0
        sp = _px_span(p)
    end
    if mn < 0 - GMAX:
        mn = 0 - GMAX
    end
    if mx > GMAX:
        mx = GMAX
    end
end

func _occ_new(nneg_c: int, nexp_c: int, npos_c: int, nneg_r: int, nexp_r: int, npos_r: int): Occ:
    mut o := Occ { nr0 = nneg_r, nc0 = nneg_c, nrt = nneg_r + nexp_r + npos_r, nct = nneg_c + nexp_c + npos_c }
    o.cells = Vector {} as Vector<u8>
    repeat o.nrt * o.nct:
        o.cells.push(0 as u8)
    end
    o.rcur = Vector {} as Vector<int>
    repeat o.nrt:
        o.rcur.push(NOLINE)
    end
    o.ccur = Vector {} as Vector<int>
    repeat o.nct:
        o.ccur.push(NOLINE)
    end
    ret o
end

func _occ_free(o &: Occ):
    o.cells.free()
    o.rcur.free()
    o.ccur.free()
end

func _occ_at(o: Occ, c: int, r: int): bool:
    ci := c + o.nc0
    ri := r + o.nr0
    if ci < 0 or ci >= o.nct or ri < 0 or ri >= o.nrt:
        ret false
    end
    ret (o.cells[ri * o.nct + ci] as int) != 0
end

func _occ_expand(o &: Occ, r0: int, r1: int, c0: int, c1: int):
    nr := _imax(0 - o.nr0 - r0, 0)
    pr := _imax(r1 - (o.nrt - o.nr0), 0)
    nc := _imax(0 - o.nc0 - c0, 0)
    pc := _imax(c1 - (o.nct - o.nc0), 0)
    if nr == 0 and pr == 0 and nc == 0 and pc == 0:
        ret
    end
    nrt := o.nrt + nr + pr
    nct := o.nct + nc + pc
    mut cells := Vector {} as Vector<u8>
    repeat nrt * nct:
        cells.push(0 as u8)
    end
    repeat o.nrt in ri:
        repeat o.nct in ci:
            cells[(ri + nr) * nct + ci + nc] = o.cells[ri * o.nct + ci]
        end
    end
    o.cells.free()
    o.cells = cells
    mut rc := Vector {} as Vector<int>
    repeat nr:
        rc.push(NOLINE)
    end
    each v in o.rcur:
        rc.push(v)
    end
    repeat pr:
        rc.push(NOLINE)
    end
    o.rcur.free()
    o.rcur = rc
    mut cc := Vector {} as Vector<int>
    repeat nc:
        cc.push(NOLINE)
    end
    each v in o.ccur:
        cc.push(v)
    end
    repeat pc:
        cc.push(NOLINE)
    end
    o.ccur.free()
    o.ccur = cc
    o.nrt = nrt
    o.nct = nct
    o.nr0 += nr
    o.nc0 += nc
end

func _imax(a: int, b: int): int:
    if a > b:
        ret a
    end
    ret b
end

func _imin(a: int, b: int): int:
    if a < b:
        ret a
    end
    ret b
end

func _occ_mark(o &: Occ, pa: int, ps: int, pe: int, ss: int, se: int, auto: bool):
    c0 := pa == 0 ? ps : ss
    c1 := pa == 0 ? pe : se
    r0 := pa == 0 ? ss : ps
    r1 := pa == 0 ? se : pe
    _occ_expand(o, r0, r1, c0, c1)
    if auto and ps < pe and ss < se:
        if pa == 0:
            ri := ss + o.nr0
            if o.rcur[ri] < pe:
                o.rcur[ri] = pe
            end
        else:
            ci := ss + o.nc0
            if o.ccur[ci] < pe:
                o.ccur[ci] = pe
            end
        end
    end
    mut r := r0
    until r < r1:
        mut c := c0
        until c < c1:
            o.cells[(r + o.nr0) * o.nct + c + o.nc0] = 1 as u8
            c++
        end
        r++
    end
end

func _occ_start(o: Occ, a: int): int:
    if a == 0:
        ret 0 - o.nc0
    end
    ret 0 - o.nr0
end

func _occ_end(o: Occ, a: int): int:
    if a == 0:
        ret o.nct - o.nc0
    end
    ret o.nrt - o.nr0
end

func _occ_cell(o: Occ, pa: int, p: int, s: int): bool:
    if pa == 0:
        ret _occ_at(o, p, s)
    end
    ret _occ_at(o, s, p)
end

func _occ_jump(o: Occ, pa: int, ps: int, pe: int, ss: int, se: int): int:
    sa := 1 - pa
    s0 := _imax(ss, _occ_start(o, sa))
    s1 := _imin(se, _occ_end(o, sa))
    pend := _occ_end(o, pa)
    mut best := NOLINE
    mut s := s0
    until s < s1:
        mut p := _imax(ps, _occ_start(o, pa))
        until p < pe and p < pend:
            if _occ_cell(o, pa, p, s):
                mut q := p
                until q < pend and _occ_cell(o, pa, q, s):
                    q++
                end
                if q > best:
                    best = q
                end
                p = q
            else:
                p++
            end
        end
        s++
    end
    ret best
end

func _occ_track_jump(o: Occ, a: int, s: int, e: int): int:
    s0 := _imax(s, _occ_start(o, a))
    s1 := _imin(e, _occ_end(o, a))
    oa := 1 - a
    mut k := s1 - 1
    until k >= s0:
        mut q := _occ_start(o, oa)
        until q < _occ_end(o, oa):
            if _occ_cell(o, oa, q, k):
                ret k + 1
            end
            q++
        end
        k--
    end
    ret NOLINE
end

func _occ_cursor(o: Occ, pa: int, s: int): int:
    if pa == 0:
        ri := s + o.nr0
        if ri < 0 or ri >= o.nrt:
            ret NOLINE
        end
        ret o.rcur[ri]
    end
    ci := s + o.nc0
    if ci < 0 or ci >= o.nct:
        ret NOLINE
    end
    ret o.ccur[ci]
end

func _occ_track_used(o: Occ, a: int, idx: int): bool:
    oa := 1 - a
    line := idx - (a == 0 ? o.nc0 : o.nr0)
    mut q := _occ_start(o, oa)
    until q < _occ_end(o, oa):
        if _occ_cell(o, oa, q, line):
            ret true
        end
        q++
    end
    ret false
end

func _clamp_line(s &: int, e &: int):
    if s < 0 - GMAX:
        s = 0 - GMAX
    end
    if s > GMAX - 1:
        s = GMAX - 1
    end
    if e < s + 1:
        e = s + 1
    end
    if e > GMAX:
        e = GMAX
    end
end

func _gpx_axis(pl: GPlc, a: int): GPx:
    if a == 0:
        ret pl.col
    end
    ret pl.row
end

func _record(o &: Occ, it &: GIt, pa: int, ps0: int, pe0: int, ss0: int, se0: int, auto: bool):
    mut ps := ps0
    mut pe := pe0
    mut ss := ss0
    mut se := se0
    _clamp_line(ps, pe)
    _clamp_line(ss, se)
    _occ_mark(o, pa, ps, pe, ss, se, auto)
    if pa == 0:
        it.c0 = ps
        it.c1 = pe
        it.r0 = ss
        it.r1 = se
    else:
        it.c0 = ss
        it.c1 = se
        it.r0 = ps
        it.r1 = pe
    end
end

func _place(o &: Occ, items &: Vector<GIt>, pls: Vector<GPlc>, flow: GridAutoFlow):
    pa := (flow == GridAutoFlow.Row or flow == GridAutoFlow.RowDense) ? 0 : 1
    sa := 1 - pa
    dense := flow == GridAutoFlow.RowDense or flow == GridAutoFlow.ColumnDense
    repeat items.len() in i:
        pl := pls[i]
        if not (_px_def(pl.col) and _px_def(pl.row)):
            continue
        end
        mut ps := 0
        mut pe := 0
        mut ss := 0
        mut se := 0
        _px_lines(_gpx_axis(pl, pa), ps, pe)
        _px_lines(_gpx_axis(pl, sa), ss, se)
        _record(o, items.ref(i), pa, ps, pe, ss, se, false)
    end
    repeat items.len() in i:
        pl := pls[i]
        if not (_px_def(_gpx_axis(pl, sa)) and not _px_def(_gpx_axis(pl, pa))):
            continue
        end
        mut ss := 0
        mut se := 0
        _px_lines(_gpx_axis(pl, sa), ss, se)
        pstart := _occ_start(o, pa)
        mut pos := pstart
        if not dense:
            cur := _occ_cursor(o, pa, ss)
            if cur != NOLINE:
                pos = cur
            end
        end
        span := _px_span(_gpx_axis(pl, pa))
        until true:
            j := _occ_jump(o, pa, pos, pos + span, ss, se)
            if j == NOLINE:
                break
            end
            pos = j
        end
        _record(o, items.ref(i), pa, pos, pos + span, ss, se, true)
    end
    gstart_p := _occ_start(o, pa)
    gstart_s := _occ_start(o, sa)
    mut cp := gstart_p
    mut cs := gstart_s
    repeat items.len() in i:
        pl := pls[i]
        if _px_def(_gpx_axis(pl, sa)):
            continue
        end
        pst := _gpx_axis(pl, pa)
        sspan := _px_span(_gpx_axis(pl, sa))
        mut rps := 0
        mut rpe := 0
        mut rss := 0
        mut rse := 0
        pstart := _occ_start(o, pa)
        pend := _occ_end(o, pa)
        sstart := _occ_start(o, sa)
        if _px_def(pst):
            mut ps := 0
            mut pe := 0
            _px_lines(pst, ps, pe)
            mut sidx := cs
            if dense:
                sidx = sstart
            else ps < cp:
                sidx = cs + 1
            end
            until true:
                j := _occ_jump(o, sa, sidx, sidx + sspan, ps, pe)
                if j == NOLINE:
                    break
                end
                sidx = j
            end
            rps = ps
            rpe = pe
            rss = sidx
            rse = sidx + sspan
        else:
            pspan := _px_span(pst)
            all := pspan >= pend - pstart
            mut pidx := cp
            mut sidx := cs
            until true:
                ppe := pidx + pspan
                if ppe > pend:
                    if pidx == pstart:
                        break
                    end
                    sidx++
                    pidx = pstart
                    continue
                end
                if all:
                    tj := _occ_track_jump(o, sa, sidx, sidx + sspan)
                    if tj != NOLINE:
                        sidx = tj
                        pidx = pstart
                        continue
                    end
                    break
                end
                j := _occ_jump(o, pa, pidx, ppe, sidx, sidx + sspan)
                if j != NOLINE:
                    pidx = j
                    continue
                end
                break
            end
            rps = pidx
            rpe = pidx + pspan
            rss = sidx
            rse = sidx + sspan
        end
        _record(o, items.ref(i), pa, rps, rpe, rss, rse, true)
        if dense:
            cp = gstart_p
            cs = gstart_s
        else:
            it := items[i]
            cp = pa == 0 ? it.c1 : it.r1
            cs = pa == 0 ? it.r0 : it.c0
        end
    end
end

func _tpl_count(tpl: GTpl, size: f64, max_fit: bool, gap: Length, reps &: int): int:
    reps = 0
    if not tpl.ok:
        ret 0
    end
    nrep := tpl.tracks.len()
    if tpl.rep == 0:
        ret _imin(nrep, GMAX)
    end
    m := tpl.rtracks.len()
    mut num := 1
    if _is(size):
        mut used := 0.0
        each d in tpl.tracks:
            used += _tdef_val(d, size)
        end
        g := _res0(gap, size)
        mut per := 0.0
        each d in tpl.rtracks:
            per += _tdef_val(d, size)
        end
        first := used + per + (((nrep + m - 1) as f64) * g)
        if first > size:
            num = 1
        else:
            per_rep := per + (m as f64) * g
            fit := (size - first) / per_rep
            fl := fit as int
            if max_fit:
                num = fl + 1
            else:
                mut ce := fl
                if (ce as f64) < fit:
                    ce++
                end
                num = ce + 1
            end
        end
    end
    rem := GMAX - tpl.rep_at
    if rem <= 0:
        num = 0
    else:
        mx := (rem + m - 1) / m
        if num < 1:
            num = 1
        end
        if num > mx:
            num = mx
        end
    end
    reps = num
    ret _imin(nrep + m * num, GMAX)
end

func _tdef_val(d: TDef, p: f64): f64:
    mx := _dv(d.xk, d.xv, p)
    mn := _dv(d.mk, d.mv, p)
    if _is(mx):
        ret _mmax(mx, mn)
    end
    ret _or(mn, 0.0)
end

func _tpl_expand(tpl: GTpl, reps: int, tracks &: Vector<TDef>, names &: Vector<LName>):
    if not tpl.ok:
        ret
    end
    m := tpl.rtracks.len()
    repeat tpl.tracks.len() in i:
        if tpl.rep != 0 and i == tpl.rep_at:
            repeat reps:
                each d in tpl.rtracks:
                    tracks.push(d)
                end
            end
        end
        tracks.push(tpl.tracks[i])
    end
    if tpl.rep != 0 and tpl.rep_at == tpl.tracks.len():
        repeat reps:
            each d in tpl.rtracks:
                tracks.push(d)
            end
        end
    end
    shift := tpl.rep != 0 ? reps * m : 0
    each ln in tpl.names:
        mut l := ln.line
        if tpl.rep != 0 and (l > tpl.rep_at or (l == tpl.rep_at and ln.after)):
            l += shift
        end
        names.push(LName { line = l, name = ln.name })
    end
    if tpl.rep != 0:
        repeat reps in r:
            each ln in tpl.rnames:
                names.push(LName { line = tpl.rep_at + r * m + ln.line, name = ln.name })
            end
        end
    end
end

func _gutter(gap: Length): GTr:
    if gap.kind == LengthKind.Percent:
        ret GTr { gut = true, mk = K_PCT, mv = gap.value, xk = K_PCT, xv = gap.value }
    end
    v := gap.kind == LengthKind.Px ? gap.value : 0.0
    ret GTr { gut = true, mk = K_PX, mv = v, xk = K_PX, xv = v }
end

func _track(d: TDef): GTr:
    ret GTr { mk = d.mk, mv = d.mv, xk = d.xk, xv = d.xv }
end

func _init_tracks(tr &: Vector<GTr>, neg: int, nexp: int, pos: int, tpl: GTpl, reps: int, autos: Vector<TDef>, gap: Length, fit: bool, o: Occ, a: int):
    b0 := tr.len()
    tr.push(_gutter(gap))
    na := autos.len()
    if neg > 0:
        repeat neg in i:
            if na == 0:
                tr.push(_track(TDef {}))
            else:
                off := na - (neg % na)
                tr.push(_track(autos[(off + i) % na]))
            end
            tr.push(_gutter(gap))
        end
    end
    mut cur := neg
    lim := neg + nexp
    if nexp > 0 and tpl.ok:
        m := tpl.rtracks.len()
        repeat tpl.tracks.len() + 1 in i:
            if tpl.rep != 0 and i == tpl.rep_at:
                repeat reps * m in k:
                    if cur < lim:
                        mut t2 := _track(tpl.rtracks[k % m])
                        mut gu := _gutter(gap)
                        if fit and not _occ_track_used(o, a, cur):
                            _tr_collapse(t2)
                            _tr_collapse(gu)
                        end
                        tr.push(t2)
                        tr.push(gu)
                        cur++
                    end
                end
                if fit and cur == neg + nexp + pos:
                    mut q := tr.len() - 1
                    until q >= b0:
                        mut tq := tr[q]
                        if not tq.gut and not tq.collapsed:
                            break
                        end
                        _tr_collapse(tq)
                        tr[q] = tq
                        q--
                    end
                end
            end
            if i < tpl.tracks.len() and cur < lim:
                tr.push(_track(tpl.tracks[i]))
                tr.push(_gutter(gap))
                cur++
            end
        end
    end
    rest := neg + nexp - cur + pos
    repeat rest in i:
        if na == 0:
            tr.push(_track(TDef {}))
        else:
            tr.push(_track(autos[i % na]))
        end
        tr.push(_gutter(gap))
    end
    mut first := tr[b0]
    _tr_collapse(first)
    tr[b0] = first
    mut last := tr[tr.len() - 1]
    _tr_collapse(last)
    tr[tr.len() - 1] = last
end

func _gt(g &: GC, a: int, i: int): GTr:
    ret g.tr[_tb(g, a) + i]
end

func _gm(t &: Engine, id: int, kw: f64, kh: f64, pw: f64, ph: f64, aw: f64, ah: f64, axis: int): f64:
    o := _layout(t, id, Inp { kw = kw, kh = kh, pw = pw, ph = ph, aw = aw, ah = ah, inherent = true, axis = axis })
    if axis == 0:
        ret o.w
    end
    ret o.h
end

func _stretchy(a: Align): bool:
    ret a == Align.Stretch or a == Align.Normal
end

func _g_margins(st: Style, iw: f64, shim: f64, mx &: f64, my &: f64):
    mx = _res0(st.margin.left, 0.0) + _res0(st.margin.right, 0.0)
    my = _res0(st.margin.top, iw) + _res0(st.margin.bottom, iw) + shim
end

func _g_known(t &: Engine, it: GIt, gw: f64, gh: f64, kw &: f64, kh &: f64):
    st := t.nodes.ref(it.id).style
    ratio := st.aspect_ratio
    mut mx := 0.0
    mut my := 0.0
    _g_margins(st, gw, it.shim, mx, my)
    pad := _r4(st.padding, gw)
    bor := _r4(st.border, gw)
    pbw := pad.l + pad.r + bor.l + bor.r
    pbh := pad.t + pad.b + bor.t + bor.b
    adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
    adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
    sw0 := _res(st.width, gw)
    sh0 := _res(st.height, gh)
    isw := _add(_arw(sw0, sh0, ratio), adjw)
    ish := _add(_arh(sw0, sh0, ratio), adjh)
    mnw0 := _res(st.min_width, gw)
    mnh0 := _res(st.min_height, gh)
    minw := _fmax(_or(_add(_arw(mnw0, mnh0, ratio), adjw), pbw), pbw)
    minh := _fmax(_or(_add(_arh(mnw0, mnh0, ratio), adjh), pbh), pbh)
    mxw0 := _res(st.max_width, gw)
    mxh0 := _res(st.max_height, gh)
    maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
    maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
    gmw := _is(gw) ? _fmax(gw - mx, 0.0) : NO
    gmh := _is(gh) ? _fmax(gh - my, 0.0) : NO
    mut w := isw
    if not _is(w):
        if _iskeyword(st.width):
            mut ex := NO
            _kav := _keyword_avail(st.width, gmw, ex)
            w = ex
        else not _isauto(st.margin.left) and not _isauto(st.margin.right) and _stretchy(it.jself):
            w = gmw
        end
    end
    w2 := _arw(w, ish, ratio)
    mut h := _arh(w, ish, ratio)
    if not _is(h):
        if _iskeyword(st.height):
            mut ex := NO
            _kav := _keyword_avail(st.height, gmh, ex)
            h = ex
        else not _isauto(st.margin.top) and not _isauto(st.margin.bottom) and _stretchy(it.aself):
            h = gmh
        end
    end
    w3 := _arw(w2, h, ratio)
    h3 := _arh(w2, h, ratio)
    kw = _clamp(w3, minw, maxw)
    kh = _clamp(h3, minh, maxh)
end

func _g_kd(t &: Engine, it &: GIt, gw: f64, gh: f64, kw &: f64, kh &: f64):
    if it.kd_ok and it.kd_gw == gw and it.kd_gh == gh:
        kw = it.kdw
        kh = it.kdh
        ret
    end
    _g_known(t, it, gw, gh, kw, kh)
    it.kd_ok = true
    it.kd_gw = gw
    it.kd_gh = gh
    it.kdw = kw
    it.kdh = kh
end

func _g_kwadj(st: Style, gw: f64, gh: f64, shim: f64, aw &: f64, ah &: f64):
    if not _iskeyword(st.width) and not _iskeyword(st.height):
        ret
    end
    mut mx := 0.0
    mut my := 0.0
    _g_margins(st, gw, shim, mx, my)
    if _iskeyword(st.width):
        sw := _is(gw) ? _fmax(gw - mx, 0.0) : NO
        mut ex := NO
        kav := _keyword_avail(st.width, sw, ex)
        if kav != NO:
            aw = kav
        end
    end
    if _iskeyword(st.height):
        sh := _is(gh) ? _fmax(gh - my, 0.0) : NO
        mut ex := NO
        kav := _keyword_avail(st.height, sh, ex)
        if kav != NO:
            ah = kav
        end
    end
end

func _g_contrib(t &: Engine, it &: GIt, a: int, gw: f64, gh: f64, avw: f64, avh: f64, maxc: bool): f64:
    mut kw := NO
    mut kh := NO
    _g_kd(t, it, gw, gh, kw, kh)
    if a == 0 and _is(kw):
        ret kw
    end
    if a == 1 and _is(kh):
        ret kh
    end
    st := t.nodes.ref(it.id).style
    mut aw := avw
    mut ah := avh
    if _is(avw) or _is(avh):
        mar := _r4(st.margin, gw)
        if _is(aw):
            aw = _fmax(aw - mar.l - mar.r, 0.0)
        end
        if _is(ah):
            ah = _fmax(ah - mar.t - mar.b - it.shim, 0.0)
        end
    end
    fill := maxc ? MAXC : MINC
    if not _is(aw):
        aw = fill
    end
    if not _is(ah):
        ah = fill
    end
    _g_kwadj(st, gw, gh, it.shim, aw, ah)
    ret _gm(t, it.id, kw, kh, gw, gh, aw, ah, a)
end

func _g_minc(t &: Engine, it &: GIt, a: int, gw: f64, gh: f64, avw: f64, avh: f64): f64:
    if a == 0 and _is(it.mincw):
        ret it.mincw
    end
    if a == 1 and _is(it.minch):
        ret it.minch
    end
    v := _g_contrib(t, it, a, gw, gh, avw, avh, false)
    if a == 0:
        it.mincw = v
    else:
        it.minch = v
    end
    ret v
end

func _g_maxc(t &: Engine, it &: GIt, a: int, gw: f64, gh: f64, avw: f64, avh: f64): f64:
    if a == 0 and _is(it.maxcw):
        ret it.maxcw
    end
    if a == 1 and _is(it.maxch):
        ret it.maxch
    end
    v := _g_contrib(t, it, a, gw, gh, avw, avh, true)
    if a == 0:
        it.maxcw = v
    else:
        it.maxch = v
    end
    ret v
end

func _g_area(g &: GC, it &: GIt, a: int, iw: f64, ih: f64, est: int, gw &: f64, gh &: f64):
    if it.ga_ok:
        gw = it.gaw
        gh = it.gah
        ret
    end
    oa := 1 - a
    pa := _pick(a, iw, ih)
    po := _pick(oa, iw, ih)
    mut sa := 0.0
    mut k := _i0(it, a) + 1
    until k < _i1(it, a):
        tr := _gt(g, a, k)
        mn := _dv(tr.mk, tr.mv, pa)
        mx := _dv(tr.xk, tr.xv, pa)
        if _is(mn) and _is(mx) and mn == mx and _is(sa):
            sa += tr.base
        else:
            sa = NO
        end
        k++
    end
    mut so := 0.0
    k = _i0(it, oa) + 1
    until k < _i1(it, oa):
        tr := _gt(g, oa, k)
        mut e := NO
        if est == 0:
            e = _dv(tr.xk, tr.xv, po)
        else:
            e = tr.base
        end
        if _is(e) and _is(so):
            so += e + tr.adj
        else:
            so = NO
        end
        k++
    end
    if a == 0:
        gw = sa
        gh = so
    else:
        gw = so
        gh = sa
    end
    it.ga_ok = true
    it.gaw = gw
    it.gah = gh
end

func _ms_minc(t &: Engine, g &: GC, idx: int, a: int, iw: f64, ih: f64, est: int): f64:
    it := g.items.ref(idx)
    mut gw := NO
    mut gh := NO
    _g_area(g, it, a, iw, ih, est, gw, gh)
    avw := a == 0 ? NO : gw
    avh := a == 1 ? NO : gh
    st := t.nodes.ref(it.id).style
    mut mx := 0.0
    mut my := 0.0
    _g_margins(st, avw, it.shim, mx, my)
    c := _g_minc(t, it, a, gw, gh, avw, avh)
    ret c + _pick(a, mx, my)
end

func _ms_maxc(t &: Engine, g &: GC, idx: int, a: int, iw: f64, ih: f64, est: int): f64:
    it := g.items.ref(idx)
    mut gw := NO
    mut gh := NO
    _g_area(g, it, a, iw, ih, est, gw, gh)
    avw := a == 0 ? NO : gw
    avh := a == 1 ? NO : gh
    st := t.nodes.ref(it.id).style
    mut mx := 0.0
    mut my := 0.0
    _g_margins(st, avw, it.shim, mx, my)
    c := _g_maxc(t, it, a, gw, gh, avw, avh)
    ret c + _pick(a, mx, my)
end

func _ms_mins(t &: Engine, g &: GC, idx: int, a: int, iw: f64, ih: f64, est: int): f64:
    it := g.items.ref(idx)
    mut gw := NO
    mut gh := NO
    _g_area(g, it, a, iw, ih, est, gw, gh)
    avw := a == 0 ? NO : gw
    st := t.nodes.ref(it.id).style
    mut mx := 0.0
    mut my := 0.0
    _g_margins(st, avw, it.shim, mx, my)
    mut c := a == 0 ? it.minsw : it.minsh
    if not _is(c):
        c = _g_minimum(t, g, idx, a, gw, gh, iw, ih)
        it2 := g.items.ref(idx)
        if a == 0:
            it2.minsw = c
        else:
            it2.minsh = c
        end
    end
    ret c + _pick(a, mx, my)
end

func _g_minimum(t &: Engine, g &: GC, idx: int, a: int, gw: f64, gh: f64, iw: f64, ih: f64): f64:
    it := g.items.ref(idx)
    st := t.nodes.ref(it.id).style
    ratio := st.aspect_ratio
    pad := _r4(st.padding, gw)
    bor := _r4(st.border, gw)
    pbw := pad.l + pad.r + bor.l + bor.r
    pbh := pad.t + pad.b + bor.t + bor.b
    adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
    adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
    sw0 := _res(st.width, gw)
    sh0 := _res(st.height, gh)
    sz := a == 0 ? _add(_arw(sw0, sh0, ratio), adjw) : _add(_arh(sw0, sh0, ratio), adjh)
    if _is(sz):
        mnl := a == 0 ? st.min_width : st.min_height
        mxl := a == 0 ? st.max_width : st.max_height
        if _isauto(mnl) and _isauto(mxl):
            ret sz
        end
        basis := _pick(a, gw, gh)
        adj := _pick(a, adjw, adjh)
        ret _clamp(sz, _add(_res(mnl, basis), adj), _add(_res(mxl, basis), adj))
    end
    szl := a == 0 ? st.width : st.height
    if _iskeyword(szl) and szl.kind != LengthKind.Stretch:
        ret _g_minc(t, it, a, gw, gh, gw, gh)
    end
    mnw0 := _res(st.min_width, _or(gw, 0.0))
    mnh0 := _res(st.min_height, _or(gh, 0.0))
    mn := a == 0 ? _add(_arw(mnw0, mnh0, ratio), adjw) : _add(_arh(mnw0, mnh0, ratio), adjh)
    if _is(mn):
        ret mn
    end
    if _it_scroll(it[0], a):
        ret 0.0
    end
    pin := _pick(a, iw, ih)
    i0 := _i0(it[0], a)
    i1 := _i1(it[0], a)
    mut spans_auto := false
    mut any_fr := false
    mut k := i0 + 1
    until k < i1:
        tr := _gt(g, a, k)
        if _bauto(tr.mk, pin):
            spans_auto = true
        end
        if tr.xk == K_FR:
            any_fr = true
        end
        k++
    end
    one := i1 - i0 - 1 == 1
    if spans_auto and (one or not any_fr):
        mc := _g_minc(t, it, a, gw, gh, gw, gh)
        mut lim := 0.0
        k = i0 + 1
        until k < i1:
            tr := _gt(g, a, k)
            v := _dv(tr.xk, tr.xv, pin)
            if _is(v) and _is(lim):
                lim += v
            else:
                lim = NO
            end
            k++
        end
        if _is(lim):
            mut mx := 0.0
            mut my := 0.0
            _g_margins(st, gw, it.shim, mx, my)
            ret _fmin(mc, _fmax(lim - _pick(a, mx, my), _pick(a, pbw, pbh)))
        end
        ret mc
    end
    ret 0.0
end

func _spanned_limit(g &: GC, it: GIt, a: int, p: f64): f64:
    mut lim := 0.0
    mut k := _i0(it, a) + 1
    until k < _i1(it, a):
        tr := _gt(g, a, k)
        v := _dl(tr.xk, tr.xv, p)
        if not _is(v):
            ret NO
        end
        lim += v
        k++
    end
    ret lim
end

func _ff_sum(g &: GC, it: GIt, a: int): f64:
    mut s := 0.0
    mut k := _i0(it, a) + 1
    until k < _i1(it, a):
        s += _tr_ff(_gt(g, a, k))
        k++
    end
    ret s
end

func _inflex_sum(g &: GC, it: GIt, a: int): f64:
    mut s := 0.0
    mut k := _i0(it, a) + 1
    until k < _i1(it, a):
        tr := _gt(g, a, k)
        if not _tr_flex(tr):
            s += tr.base
        end
        k++
    end
    ret s
end

func _spans_match(g &: GC, it: GIt, a: int, mode: int, p: f64): bool:
    mut k := _i0(it, a) + 1
    until k < _i1(it, a):
        if _tr_match(_gt(g, a, k), mode, p):
            ret true
        end
        k++
    end
    ret false
end

func _tr_match(tr: GTr, mode: int, p: f64): bool:
    switch mode:
        0:
            ret not _is(_dv(tr.mk, tr.mv, p))
        end
        1:
            ret tr.mk == K_MINC or tr.mk == K_MAXC
        end
        2:
            ret tr.mk == K_AUTO and tr.xk != K_MINC
        end
        3:
            ret tr.mk == K_MAXC
        end
        4:
            ret not _hdv(tr.xk, p)
        end
        5:
            ret _mcalike(tr.xk) or (_usepct(tr.xk) and not _is(p))
        end
        6:
            ret (tr.mk == K_AUTO and tr.xk != K_MINC) or tr.mk == K_MAXC
        end
        else:
            ret true
        end
    end
    ret true
end

func _dist_limits(g &: GC, a: int, s0: int, s1: int, space0: f64, affm: int, p: f64, flexonly: bool, prop_flex: bool, prop_affect: int, lim: int): f64:
    mut space := space0
    nn := s1 - s0 + 1
    repeat nn:
        if space <= 0.01:
            break
        end
        mut psum := 0.0
        mut minlim := BIG
        mut any := false
        mut k := s0
        until k < s1:
            tr := _gt(g, a, k)
            if _dl_aff(tr, affm, p, flexonly):
                ap := _dl_prop(tr, prop_affect)
                lv := _dl_lim(tr, lim)
                if ap + tr.inc < lv:
                    pr := _dl_ratio(tr, prop_flex)
                    psum += pr
                    if pr > 0.0:
                        q := (lv - ap - tr.inc) / pr
                        if not any or q < minlim:
                            minlim = q
                        end
                        any = true
                    end
                end
            end
            k++
        end
        if psum == 0.0:
            break
        end
        inc := _fmin(minlim, space / psum)
        k = s0
        until k < s1:
            tr := g.tr.ref(_tb(g, a) + k)
            if _dl_aff(tr[0], affm, p, flexonly):
                incr := inc * _dl_ratio(tr[0], prop_flex)
                if incr > 0.0 and _dl_prop(tr[0], prop_affect) + tr.inc + incr <= _dl_lim(tr[0], lim) + 0.01:
                    tr.inc += incr
                    space -= incr
                end
            end
            k++
        end
    end
    ret space
end

func _dl_aff(tr: GTr, affm: int, p: f64, flexonly: bool): bool:
    if flexonly and not _tr_flex(tr):
        ret false
    end
    if affm >= 100:
        if not _tr_match(tr, affm - 100, p):
            ret false
        end
        ret true
    end
    if affm == 50:
        ret true
    end
    if affm == 51:
        ret _intr(tr.xk)
    end
    if affm == 52:
        ret _mofc(tr.xk)
    end
    if affm == 60:
        ret tr.ig or tr.glim == BIG
    end
    ret _tr_match(tr, affm, p)
end

func _dl_prop(tr: GTr, which: int): f64:
    if which == 1:
        if tr.glim == BIG:
            ret tr.base
        end
        ret tr.glim
    end
    ret tr.base
end

func _dl_lim(tr: GTr, which: int): f64:
    switch which:
        0:
            ret tr.glim
        end
        1:
            ret _tr_fclg(tr)
        end
        2:
            ret BIG
        end
        3:
            ret tr.fcl
        end
        else:
            ret BIG
        end
    end
    ret BIG
end

func _dl_ratio(tr: GTr, prop_flex: bool): f64:
    if prop_flex:
        ret _tr_ff(tr)
    end
    ret 1.0
end

func _g_any_aff(g &: GC, a: int, s0: int, s1: int, affm: int, p: f64, flexonly: bool): int:
    mut c := 0
    mut k := s0
    until k < s1:
        if _dl_aff(_gt(g, a, k), affm, p, flexonly):
            c++
        end
        k++
    end
    ret c
end

func _dist_base(g &: GC, a: int, s0: int, s1: int, is_flex: bool, space: f64, affm: int, p: f64, lim: int, maxtype: bool):
    if is_flex:
        mut ffs := 0.0
        mut k := s0
        until k < s1:
            tr := _gt(g, a, k)
            if _tr_flex(tr) and _dl_aff(tr, affm, p, false):
                ffs += _tr_ff(tr)
            end
            k++
        end
        _dist_base_inner(g, a, s0, s1, space, affm, p, true, ffs > 0.0, lim, maxtype)
    else:
        _dist_base_inner(g, a, s0, s1, space, affm, p, false, false, lim, maxtype)
    end
end

func _dist_base_inner(g &: GC, a: int, s0: int, s1: int, space: f64, affm: int, p: f64, flexonly: bool, byff: bool, lim: int, maxtype: bool):
    if space == 0.0 or _g_any_aff(g, a, s0, s1, affm, p, flexonly) == 0:
        ret
    end
    mut sizes := 0.0
    mut k := s0
    until k < s1:
        sizes += _gt(g, a, k).base
        k++
    end
    extra := _fmax(0.0, space - sizes)
    rest := _dist_limits(g, a, s0, s1, extra, affm, p, flexonly, byff, 0, lim)
    if rest > 0.000001:
        mut f := maxtype ? 52 : 51
        mut cnt := 0
        k = s0
        until k < s1:
            tr := _gt(g, a, k)
            if _dl_aff(tr, affm, p, flexonly) and _dl_aff(tr, f, p, false):
                cnt++
            end
            k++
        end
        if cnt == 0:
            f = 50
        end
        _dist_beyond(g, a, s0, s1, rest, affm, f, p, flexonly, byff)
    end
    k = s0
    until k < s1:
        tr := g.tr.ref(_tb(g, a) + k)
        if tr.inc > tr.bpi:
            tr.bpi = tr.inc
        end
        tr.inc = 0.0
        k++
    end
end

func _dist_beyond(g &: GC, a: int, s0: int, s1: int, space0: f64, affm: int, f: int, p: f64, flexonly: bool, byff: bool):
    mut space := space0
    nn := s1 - s0 + 1
    repeat nn:
        if space <= 0.01:
            break
        end
        mut psum := 0.0
        mut minlim := BIG
        mut any := false
        mut k := s0
        until k < s1:
            tr := _gt(g, a, k)
            if _dl_aff(tr, affm, p, flexonly) and _dl_aff(tr, f, p, false):
                if tr.base + tr.inc < tr.fcl:
                    pr := byff ? _tr_ff(tr) : 1.0
                    psum += pr
                    if pr > 0.0:
                        q := (tr.fcl - tr.base - tr.inc) / pr
                        if not any or q < minlim:
                            minlim = q
                        end
                        any = true
                    end
                end
            end
            k++
        end
        if psum == 0.0:
            break
        end
        inc := _fmin(minlim, space / psum)
        k = s0
        until k < s1:
            tr := g.tr.ref(_tb(g, a) + k)
            if _dl_aff(tr[0], affm, p, flexonly) and _dl_aff(tr[0], f, p, false):
                incr := inc * (byff ? _tr_ff(tr[0]) : 1.0)
                if incr > 0.0 and tr.base + tr.inc + incr <= tr.fcl + 0.01:
                    tr.inc += incr
                    space -= incr
                end
            end
            k++
        end
    end
end

func _dist_glim(g &: GC, a: int, s0: int, s1: int, space: f64, affm: int, p: f64):
    if space == 0.0 or _g_any_aff(g, a, s0, s1, affm, p, false) == 0:
        ret
    end
    mut sizes := 0.0
    mut k := s0
    until k < s1:
        tr := _gt(g, a, k)
        sizes += tr.glim == BIG ? tr.base : tr.glim
        k++
    end
    extra := _fmax(0.0, space - sizes)
    rest := _dist_glim_lim(g, a, s0, s1, extra, affm, p, true)
    if rest > 0.0:
        _r := _dist_glim_lim(g, a, s0, s1, rest, affm, p, false)
    end
    k = s0
    until k < s1:
        tr := g.tr.ref(_tb(g, a) + k)
        if tr.inc > tr.gpi:
            tr.gpi = tr.inc
        end
        tr.inc = 0.0
        k++
    end
end

func _dist_glim_lim(g &: GC, a: int, s0: int, s1: int, space0: f64, affm: int, p: f64, growable_only: bool): f64:
    mut space := space0
    nn := s1 - s0 + 1
    repeat nn:
        if space <= 0.01:
            break
        end
        mut psum := 0.0
        mut minlim := BIG
        mut k := s0
        until k < s1:
            tr := _gt(g, a, k)
            ok := _dl_aff(tr, affm, p, false) and (not growable_only or tr.ig or tr.glim == BIG)
            ap := tr.glim == BIG ? tr.base : tr.glim
            if ok and ap + tr.inc < tr.fcl:
                psum++
                q := tr.fcl - ap - tr.inc
                if q < minlim:
                    minlim = q
                end
            end
            k++
        end
        if psum == 0.0:
            break
        end
        inc := _fmin(minlim, space / psum)
        k = s0
        until k < s1:
            tr := g.tr.ref(_tb(g, a) + k)
            ok := _dl_aff(tr[0], affm, p, false) and (not growable_only or tr.ig or tr.glim == BIG)
            ap := tr.glim == BIG ? tr.base : tr.glim
            if ok and inc > 0.0 and ap + tr.inc + inc <= tr.fcl + 0.01:
                tr.inc += inc
                space -= inc
            end
            k++
        end
    end
    ret space
end

func _flush_base(g &: GC, a: int):
    repeat _tn(g, a) in k:
        tr := g.tr.ref(_tb(g, a) + k)
        tr.base += tr.bpi
        tr.bpi = 0.0
    end
end

func _flush_glim(g &: GC, a: int, setig: bool):
    repeat _tn(g, a) in k:
        tr := g.tr.ref(_tb(g, a) + k)
        if tr.gpi > 0.0:
            if tr.glim == BIG:
                tr.glim = tr.base + tr.gpi
            else:
                tr.glim += tr.gpi
            end
            tr.ig = setig
        else:
            tr.ig = false
        end
        tr.gpi = 0.0
    end
end

func _g_baselines(t &: Engine, g &: GC, iw: f64, ih: f64):
    n := g.items.len()
    mut done := Vector {} as Vector<bool>
    defer done.free()
    repeat n:
        done.push(false)
    end
    repeat n in i:
        if done[i]:
            continue
        end
        row := g.items[i].r0
        mut cnt := 0
        repeat n in j:
            if g.items[j].r0 == row:
                done[j] = true
                if _g_base_part(t, g.items[j]):
                    cnt++
                end
            end
        end
        if cnt <= 1:
            continue
        end
        mut maxb := MINC
        repeat n in j:
            itj := g.items[j]
            if itj.r0 == row and _g_base_part(t, itj):
                o := _layout(t, itj.id, Inp { pw = iw, ph = ih, aw = MINC, ah = MINC, inherent = true, axis = 2, perform = true })
                st := t.nodes.ref(itj.id).style
                bl := _or(_child_baseline(o.baseline, o.h, st.overflow_y), o.h)
                ir := g.items.ref(j)
                ir.ibase = bl
                mb := bl + _res0(st.margin.top, iw)
                if mb > maxb:
                    maxb = mb
                end
            end
        end
        repeat n in j:
            itj := g.items[j]
            if itj.r0 == row and _g_base_part(t, itj):
                st := t.nodes.ref(itj.id).style
                ir := g.items.ref(j)
                ir.shim = maxb - (itj.ibase + _res0(st.margin.top, iw))
                ir.kd_ok = false
            end
        end
    end
end

func _g_base_part(t &: Engine, it: GIt): bool:
    if it.aself != Align.Baseline:
        ret false
    end
    st := t.nodes.ref(it.id).style
    if _isauto(st.margin.top) or _isauto(st.margin.bottom):
        ret false
    end
    if st.height.kind == LengthKind.Percent and (it.ir or it.fr):
        ret false
    end
    ret true
end

func _gutter_adj(g &: GC, a: int, align: Align, inner: f64, est: int): f64:
    n := _tn(g, a)
    if n <= 1:
        ret 0.0
    end
    mut outer := 0
    mut innerw := 0
    switch align:
        Align.Start, Align.FlexStart, Align.End, Align.FlexEnd, Align.Center:
            outer = 1
            break
        end
        Align.SpaceBetween:
            innerw = 1
            break
        end
        Align.SpaceAround:
            outer = 1
            innerw = 2
            break
        end
        Align.SpaceEvenly:
            outer = 1
            innerw = 1
            break
        end
        else:
        end
    end
    if innerw == 0 or not _is(inner):
        ret 0.0
    end
    mut sum := 0.0
    repeat n in k:
        tr := _gt(g, a, k)
        e := est == 0 ? _dv(tr.xk, tr.xv, inner) : tr.base
        if not _is(e) or not _is(sum):
            sum = NO
        else:
            sum += e
        end
    end
    free := _is(sum) ? _fmax(0.0, inner - sum) : 0.0
    wtc := ((n - 3) / 2) * innerw + 2 * outer
    if wtc <= 0:
        ret 0.0
    end
    ret (free / (wtc as f64)) * (innerw as f64)
end

func _sizing(t &: Engine, g &: GC, a: int, amin: f64, amax: f64, aal: Align, oal: Align, agw: f64, agh: f64, iw: f64, ih: f64, est: int, has_base: bool):
    pin := _pick(a, iw, ih)
    base := _tb(g, a)
    n := _tn(g, a)
    pb := _or(pin, amin)
    repeat n in k:
        tr := g.tr.ref(base + k)
        tr.base = _or(_dv(tr.mk, tr.mv, pb), 0.0)
        tr.glim = _dv(tr.xk, tr.xv, pb)
        if not _is(tr.glim):
            tr.glim = BIG
        end
        if tr.glim < tr.base:
            tr.glim = tr.base
        end
        tr.fcl = _fcl_of(tr.xk, tr.xv, pin)
    end
    if has_base:
        _g_baselines(t, g, iw, ih)
    end
    mut all_fixed := true
    repeat n in k:
        tr := _gt(g, a, k)
        if not (tr.base == tr.glim and _is(_dv(tr.mk, tr.mv, pb))):
            all_fixed = false
            break
        end
    end
    if all_fixed:
        ret
    end
    oa := 1 - a
    adjv := _gutter_adj(g, oa, oal, _pick(oa, iw, ih), est)
    onn := _tn(g, oa)
    if onn > 3:
        mut k := 2
        until k < onn:
            tr := g.tr.ref(_tb(g, oa) + k)
            tr.adj = adjv
            k += 2
        end
    end
    aspace := _pick(a, agw, agh)
    _intrinsic(t, g, a, aspace, iw, ih, est)
    _maximise(g, a, aspace)
    mut exp := NO
    if _is(pin):
        exp = pin
    else aspace == MINC and a == 0:
        exp = MINC
    else:
        exp = MAXC
    end
    _expand_flex(t, g, a, amin, amax, exp, iw, ih, est)
    if aal == Align.Stretch:
        _stretch_auto(g, a, amin, exp)
    end
end

func _order(g &: GC, a: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    n := g.items.len()
    mut maxsp := 1
    repeat n in i:
        it := g.items[i]
        if not _cflex(it, a):
            sp := _span(it, a)
            if sp > maxsp:
                maxsp = sp
            end
        end
    end
    mut sp := 0
    until sp <= maxsp:
        repeat n in i:
            it := g.items[i]
            if not _cflex(it, a) and _span(it, a) == sp:
                out.push(i)
            end
        end
        sp++
    end
    repeat n in i:
        if _cflex(g.items[i], a):
            out.push(i)
        end
    end
    ret out
end

func _intrinsic(t &: Engine, g &: GC, a: int, aspace: f64, iw: f64, ih: f64, est: int):
    pin := _pick(a, iw, ih)
    mut ord := _order(g, a)
    defer ord.free()
    mut bi := 0
    until bi < ord.len():
        first := g.items[ord[bi]]
        is_flex := _cflex(first, a)
        sp := _span(first, a)
        mut be := bi
        if is_flex:
            be = ord.len()
        else:
            until be < ord.len() and not _cflex(g.items[ord[be]], a) and _span(g.items[ord[be]], a) == sp:
                be++
            end
        end
        if not is_flex and sp == 1:
            mut q := bi
            until q < be:
                idx := ord[q]
                it := g.items[idx]
                ti := _i0(it, a) + 1
                tr := _gt(g, a, ti)
                mut nb := tr.base
                if tr.mk == K_MINC:
                    nb = _fmax(tr.base, _ms_minc(t, g, idx, a, iw, ih, est))
                else tr.mk == K_MAXC:
                    nb = _fmax(tr.base, _ms_maxc(t, g, idx, a, iw, ih, est))
                else _bauto(tr.mk, pin):
                    mut sv := 0.0
                    if (aspace == MINC or aspace == MAXC) and not _it_scroll(it, a):
                        mins := _ms_mins(t, g, idx, a, iw, ih, est)
                        minc := _ms_minc(t, g, idx, a, iw, ih, est)
                        lim := _dl(tr.xk, tr.xv, pin)
                        sv = _fmax(_mmin(minc, lim), mins)
                    else:
                        sv = _ms_mins(t, g, idx, a, iw, ih, est)
                    end
                    nb = _fmax(tr.base, sv)
                end
                trr := g.tr.ref(_tb(g, a) + ti)
                trr.base = nb
                tr2 := _gt(g, a, ti)
                mut mcc := NO
                if _tr_intr(tr2):
                    mcc = _ms_minc(t, g, idx, a, iw, ih, est)
                end
                mut planned := NO
                if tr2.xk == K_FITPX or tr2.xk == K_FITPCT:
                    mxc := _fmin(_ms_maxc(t, g, idx, a, iw, ih, est), tr2.fcl)
                    if _is(mcc) and not _it_scroll(it, a):
                        planned = _fmax(mcc, mxc)
                    else:
                        planned = mxc
                    end
                else _mcalike(tr2.xk) or (_usepct(tr2.xk) and not _is(pin)):
                    planned = _ms_maxc(t, g, idx, a, iw, ih, est)
                else _intr(tr2.xk):
                    planned = mcc
                end
                if _is(planned):
                    trp := g.tr.ref(_tb(g, a) + ti)
                    trp.gpi = _fmax(trp.gpi, planned)
                end
                q++
            end
            repeat _tn(g, a) in k:
                tr := g.tr.ref(_tb(g, a) + k)
                if tr.gpi > 0.0:
                    if tr.glim == BIG:
                        tr.glim = tr.gpi
                    else:
                        tr.glim = _fmax(tr.glim, tr.gpi)
                    end
                end
                tr.ig = false
                tr.gpi = 0.0
                if tr.glim < tr.base:
                    tr.glim = tr.base
                end
            end
            bi = be
            continue
        end
        mut q := bi
        until q < be:
            idx := ord[q]
            it := g.items[idx]
            if _cintr(it, a):
                mut sv := 0.0
                if (aspace == MINC or aspace == MAXC) and not _it_scroll(it, a):
                    mins := _ms_mins(t, g, idx, a, iw, ih, est)
                    minc := _ms_minc(t, g, idx, a, iw, ih, est)
                    lim := _spanned_limit(g, it, a, pin)
                    lmc := _fmax(_mmin(minc, lim), mins)
                    if is_flex:
                        infl := _inflex_sum(g, it, a)
                        scale := _fmin(_ff_sum(g, it, a), 1.0)
                        excess := _fmax(lmc - infl, 0.0)
                        sv = _fmax(mins, infl + excess * scale)
                    else:
                        sv = lmc
                    end
                else:
                    sv = _ms_mins(t, g, idx, a, iw, ih, est)
                end
                if sv > 0.0:
                    lm := _it_scroll(it, a) ? 1 : 0
                    _dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 0, pin, lm, false)
                end
            end
            q++
        end
        _flush_base(g, a)
        q = bi
        until q < be:
            idx := ord[q]
            it := g.items[idx]
            if _spans_match(g, it, a, 1, pin):
                sv := _ms_minc(t, g, idx, a, iw, ih, est)
                if sv > 0.0:
                    lm := _it_scroll(it, a) ? 1 : 0
                    _dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 1, pin, lm, false)
                end
            end
            q++
        end
        _flush_base(g, a)
        if aspace == MAXC:
            q = bi
            until q < be:
                idx := ord[q]
                it := g.items[idx]
                if _spans_match(g, it, a, 6, pin):
                    mxc := _ms_maxc(t, g, idx, a, iw, ih, est)
                    lim := _spanned_limit(g, it, a, pin)
                    mut sv := _mmin(mxc, lim)
                    if is_flex:
                        infl := _inflex_sum(g, it, a)
                        scale := _fmin(_ff_sum(g, it, a), 1.0)
                        sv = infl + _fmax(sv - infl, 0.0) * scale
                    end
                    if sv > 0.0:
                        if _spans_match(g, it, a, 3, pin):
                            _dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 3, pin, 2, true)
                        else:
                            _dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 2, pin, 1, true)
                        end
                    end
                end
                q++
            end
            _flush_base(g, a)
        end
        q = bi
        until q < be:
            idx := ord[q]
            it := g.items[idx]
            if _spans_match(g, it, a, 3, pin):
                sv := _ms_maxc(t, g, idx, a, iw, ih, est)
                if sv > 0.0:
                    _dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 3, pin, 0, true)
                end
            end
            q++
        end
        _flush_base(g, a)
        repeat _tn(g, a) in k:
            tr := g.tr.ref(_tb(g, a) + k)
            if tr.glim < tr.base:
                tr.glim = tr.base
            end
        end
        if not is_flex:
            q = bi
            until q < be:
                idx := ord[q]
                it := g.items[idx]
                if _spans_match(g, it, a, 4, pin):
                    sv := _ms_minc(t, g, idx, a, iw, ih, est)
                    if sv > 0.0:
                        _dist_glim(g, a, _i0(it, a) + 1, _i1(it, a), sv, 4, pin)
                    end
                end
                q++
            end
            _flush_glim(g, a, true)
            q = bi
            until q < be:
                idx := ord[q]
                it := g.items[idx]
                if _spans_match(g, it, a, 5, pin):
                    sv := _ms_maxc(t, g, idx, a, iw, ih, est)
                    if sv > 0.0:
                        _dist_glim(g, a, _i0(it, a) + 1, _i1(it, a), sv, 5, pin)
                    end
                end
                q++
            end
            _flush_glim(g, a, false)
        end
        bi = be
    end
    repeat _tn(g, a) in k:
        tr := g.tr.ref(_tb(g, a) + k)
        if tr.glim == BIG:
            tr.glim = tr.base
        end
    end
end

func _maximise(g &: GC, a: int, aspace: f64):
    mut used := 0.0
    repeat _tn(g, a) in k:
        used += _gt(g, a, k).base
    end
    mut free := 0.0
    if aspace == MAXC:
        free = BIG
    else aspace == MINC:
        free = 0.0
    else:
        free = aspace - used
    end
    if free == BIG:
        repeat _tn(g, a) in k:
            tr := g.tr.ref(_tb(g, a) + k)
            tr.base = tr.glim
        end
    else free > 0.0:
        _r := _dist_limits(g, a, 0, _tn(g, a), free, 50, NO, false, false, 0, 1)
        repeat _tn(g, a) in k:
            tr := g.tr.ref(_tb(g, a) + k)
            tr.base += tr.inc
            tr.inc = 0.0
        end
    end
end

func _fr_size(g &: GC, a: int, s0: int, s1: int, space: f64): f64:
    if space == 0.0:
        ret 0.0
    end
    mut hyp := BIG
    mut prev := BIG
    nn := s1 - s0 + 1
    repeat nn:
        mut used := 0.0
        mut ffs := 0.0
        mut k := s0
        until k < s1:
            tr := _gt(g, a, k)
            if tr.xk == K_FR and (hyp == BIG ? tr.xv > 0.0 : tr.xv * hyp >= tr.base):
                ffs += tr.xv
            else:
                used += tr.base
            end
            k++
        end
        left := space - used
        ff := _fmax(ffs, 1.0)
        prev = hyp
        hyp = left / ff
        mut valid := true
        k = s0
        until k < s1:
            tr := _gt(g, a, k)
            if tr.xk == K_FR:
                if not (tr.xv * hyp >= tr.base or (prev != BIG and tr.xv * prev < tr.base)):
                    valid = false
                end
            end
            k++
        end
        if valid:
            break
        end
    end
    ret hyp
end

func _expand_flex(t &: Engine, g &: GC, a: int, amin: f64, amax: f64, exp: f64, iw: f64, ih: f64, est: int):
    n := _tn(g, a)
    mut ff := 0.0
    if exp == MINC:
        ff = 0.0
    else exp == MAXC:
        mut m1 := 0.0
        mut has1 := false
        repeat n in k:
            tr := _gt(g, a, k)
            if tr.xk == K_FR:
                v := tr.xv > 1.0 ? tr.base / tr.xv : tr.base
                if not has1 or v > m1:
                    m1 = v
                end
                has1 = true
            end
        end
        mut m2 := 0.0
        mut has2 := false
        repeat g.items.len() in i:
            it := g.items[i]
            if _cflex(it, a):
                mxc := _ms_maxc(t, g, i, a, iw, ih, est)
                it2 := g.items[i]
                v := _fr_size(g, a, _i0(it2, a) + 1, _i1(it2, a), mxc)
                if not has2 or v > m2:
                    m2 = v
                end
                has2 = true
            end
        end
        ff = _fmax(m1, m2)
        mut hyp := 0.0
        repeat n in k:
            tr := _gt(g, a, k)
            if tr.xk == K_FR:
                hyp += _fmax(tr.base, tr.xv * ff)
            else:
                hyp += tr.base
            end
        end
        mn := _or(amin, 0.0)
        mx := _or(amax, BIG)
        if hyp < mn:
            ff = _fr_size(g, a, 0, n, mn)
        else hyp > mx:
            ff = _fr_size(g, a, 0, n, mx)
        end
    else:
        mut used := 0.0
        repeat n in k:
            used += _gt(g, a, k).base
        end
        if exp - used <= 0.0:
            ff = 0.0
        else:
            ff = _fr_size(g, a, 0, n, exp)
        end
    end
    repeat n in k:
        tr := g.tr.ref(_tb(g, a) + k)
        if tr.xk == K_FR:
            tr.base = _fmax(tr.base, tr.xv * ff)
        end
    end
end

func _stretch_auto(g &: GC, a: int, amin: f64, exp: f64):
    n := _tn(g, a)
    mut na := 0
    mut used := 0.0
    repeat n in k:
        tr := _gt(g, a, k)
        if tr.xk == K_AUTO and not tr.gut:
            na++
        end
        used += tr.base
    end
    if na == 0:
        ret
    end
    mut free := 0.0
    if exp != MINC and exp != MAXC:
        free = exp - used
    else _is(amin):
        free = amin - used
    end
    if free > 0.0:
        per := free / (na as f64)
        repeat n in k:
            tr := g.tr.ref(_tb(g, a) + k)
            if tr.xk == K_AUTO and not tr.gut:
                tr.base += per
            end
        end
    end
end

func _align_tracks(g &: GC, a: int, size: f64, ps: f64, bs: f64, align: Align, rev: bool):
    n := _tn(g, a)
    mut used := 0.0
    mut nt := 0
    repeat n in k:
        tr := _gt(g, a, k)
        used += tr.base
        if k % 2 == 1 and not tr.collapsed:
            nt++
        end
    end
    free := size - used
    origin := ps + bs
    mut al := _content_fallback(align, free, nt)
    if rev:
        switch al:
            Align.Start:
                al = Align.End
                break
            end
            Align.End:
                al = Align.Start
                break
            end
            Align.FlexStart:
                al = Align.FlexEnd
                break
            end
            Align.FlexEnd:
                al = Align.FlexStart
                break
            end
            Align.Stretch:
                al = Align.End
                break
            end
            else:
            end
        end
    end
    empty_off := nt == 0 ? _content_offset(free, nt, 0.0, al, false, true) : 0.0
    mut tot := origin + empty_off
    mut seen := false
    repeat n in i:
        k := rev ? n - 1 - i : i
        tr := g.tr.ref(_tb(g, a) + k)
        gutter := i % 2 == 0
        real := not gutter and not tr.collapsed
        first := real and not seen
        off := real ? _content_offset(free, nt, 0.0, al, false, first) : 0.0
        tr.off = tot + off
        tot = tot + off + tr.base
        if real:
            seen = true
        end
    end
end

func _align_in_area(s: f64, e: f64, al: Align, size: f64, oof: bool, ins_s: f64, ins_e: f64, mar_s: f64, mar_e: f64, shim: f64, rtl: bool, rm_s &: f64, rm_e &: f64): f64:
    nm_s := _or(mar_s, 0.0) + shim
    nm_e := _or(mar_e, 0.0)
    gas := _fmax(e - s, 0.0)
    free := _fmax(gas - size - nm_s - nm_e, 0.0)
    mut autos := 0
    if not _is(mar_s):
        autos++
    end
    if not _is(mar_e):
        autos++
    end
    am := autos > 0 ? free / (autos as f64) : 0.0
    rm_s = _or(mar_s, am) + shim
    rm_e = _or(mar_e, am)
    mut off := 0.0
    switch al:
        Align.End, Align.FlexEnd:
            off = rtl ? rm_s : gas - size - rm_e
            break
        end
        Align.Center:
            off = (gas - size + rm_s - rm_e) / 2.0
            break
        end
        else:
            off = rtl ? gas - size - rm_e : rm_s
        end
    end
    if oof:
        if _is(ins_s) and _is(ins_e):
            off = rtl ? gas - ins_e - size - nm_e : ins_s + nm_s
        else _is(ins_s):
            off = ins_s + nm_s
        else _is(ins_e):
            off = gas - ins_e - size - nm_e
        end
    end
    ret s + off
end

func _g_position(t &: Engine, it &: GIt, left: f64, right: f64, top: f64, bottom: f64, ji: Align, ai: Align, rtl: bool):
    n := t.nodes.ref(it.id)
    st := n.style
    cbw := right - left
    cbh := bottom - top
    ratio := st.aspect_ratio
    mut js := st.justify_self == Align.Auto ? ji : st.justify_self
    mut a_self := st.align_self == Align.Auto ? ai : st.align_self
    pad := _r4(st.padding, cbw)
    bor := _r4(st.border, cbw)
    pbw := pad.l + pad.r + bor.l + bor.r
    pbh := pad.t + pad.b + bor.t + bor.b
    adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
    adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
    sw0 := _res(st.width, cbw)
    sh0 := _res(st.height, cbh)
    isw := _add(_arw(sw0, sh0, ratio), adjw)
    ish := _add(_arh(sw0, sh0, ratio), adjh)
    mnw0 := _res(st.min_width, cbw)
    mnh0 := _res(st.min_height, cbh)
    mnw1 := _fmax(_or(_add(mnw0, adjw), pbw), pbw)
    mnh1 := _fmax(_or(_add(mnh0, adjh), pbh), pbh)
    minw := _arw(mnw1, mnh1, ratio)
    minh := _arh(mnw1, mnh1, ratio)
    mxw0 := _res(st.max_width, cbw)
    mxh0 := _res(st.max_height, cbh)
    maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
    maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
    if js == Align.Normal:
        js = (_is(isw) or _iskeyword(st.width)) ? Align.Start : Align.Stretch
    end
    if a_self == Align.Normal:
        a_self = (_is(ish) or _iskeyword(st.height) or ratio > 0.0) ? Align.Start : Align.Stretch
    end
    mar := _r4opt(st.margin, cbw)
    gmw := _fmax(cbw - _or(mar.l, 0.0) - _or(mar.r, 0.0), 0.0)
    gmh := _fmax(cbh - _or(mar.t, 0.0) - _or(mar.b, 0.0) - it.shim, 0.0)
    mut kxw := NO
    mut kxh := NO
    mut kex_w := NO
    mut kex_h := NO
    if not _is(isw):
        kxw = _keyword_avail(st.width, gmw, kex_w)
    end
    if not _is(ish):
        kxh = _keyword_avail(st.height, gmh, kex_h)
    end
    mut both_w := NO
    mut both_h := NO
    if kxw != NO and kxh != NO:
        o := _layout(t, it.id, Inp { pw = cbw, ph = cbh, aw = kxw, ah = kxh, inherent = true, axis = 2 })
        both_w = o.w
        both_h = o.h
    end
    mut w := isw
    if not _is(w):
        if _is(kex_w):
            w = kex_w
        else kxw != NO:
            if _is(both_w):
                w = both_w
            else:
                w = _gm(t, it.id, NO, NO, cbw, cbh, kxw, gmh, 0)
            end
        else _is(mar.l) and _is(mar.r) and js == Align.Stretch:
            w = gmw
        end
    end
    w2 := _arw(w, ish, ratio)
    mut h := _arh(w, ish, ratio)
    if not _is(h):
        if _is(kex_h):
            h = kex_h
        else kxh != NO:
            if _is(both_h):
                h = both_h
            else:
                h = _gm(t, it.id, w2, NO, cbw, cbh, _is(w2) ? w2 : gmw, kxh, 1)
            end
        else _is(mar.t) and _is(mar.b) and a_self == Align.Stretch:
            h = gmh
        end
    end
    w3 := _clamp(_arw(w2, h, ratio), minw, maxw)
    h3 := _clamp(_arh(w2, h, ratio), minh, maxh)
    o := _layout(t, it.id, Inp { kw = w3, kh = h3, pw = cbw, ph = cbh, aw = gmw, ah = gmh, inherent = true, axis = 2, perform = true })
    fw := _clampf(_or(w3, o.w), minw, maxw)
    fh := _clampf(_or(h3, o.h), minh, maxh)
    mut ml := 0.0
    mut mr := 0.0
    mut mt := 0.0
    mut mb := 0.0
    insh := _r4opt(st.inset, cbw)
    insv := _r4opt(st.inset, cbh)
    x0 := _align_in_area(left, right, js, fw, false, NO, NO, mar.l, mar.r, 0.0, rtl, ml, mr)
    y0 := _align_in_area(top, bottom, a_self, fh, false, NO, NO, mar.t, mar.b, it.shim, false, mt, mb)
    mut rx := 0.0
    mut ry := 0.0
    if _isrel(st.position):
        if rtl:
            rx = _is(insh.r) ? 0.0 - insh.r : _or(insh.l, 0.0)
        else:
            rx = _is(insh.l) ? insh.l : (_is(insh.r) ? 0.0 - insh.r : 0.0)
        end
        ry = _is(insv.t) ? insv.t : (_is(insv.b) ? 0.0 - insv.b : 0.0)
    end
    _set_layout(t, it.id, x0 + rx, y0 + ry, fw, fh, pad, bor, R4 { l = ml, r = mr, t = mt, b = mb })
    it.ypos = y0
    it.hgt = fh
    it.ibase = _child_baseline(o.baseline, fh, st.overflow_y)
end

func _g_crosses(g &: GC):
    repeat g.items.len() in i:
        it := g.items.ref(i)
        it.fc = false
        it.ic = false
        it.fr = false
        it.ir = false
        mut k := it.ci0 + 1
        until k < it.ci1:
            tr := g.tr[k]
            if _tr_flex(tr):
                it.fc = true
            end
            if _tr_intr(tr):
                it.ic = true
            end
            k++
        end
        k = it.ri0 + 1
        until k < it.ri1:
            tr := g.tr[g.nct + k]
            if _tr_flex(tr):
                it.fr = true
            end
            if _tr_intr(tr):
                it.ir = true
            end
            k++
        end
    end
end

func _sum_base(g &: GC, a: int): f64:
    mut s := 0.0
    repeat _tn(g, a) in k:
        s += _gt(g, a, k).base
    end
    ret s
end

func _any_pct(g &: GC, a: int): bool:
    repeat _tn(g, a) in k:
        if _tr_pct(_gt(g, a, k)):
            ret true
        end
    end
    ret false
end

func _recheck(t &: Engine, g &: GC, a: int, iw: f64, ih: f64): bool:
    mut changed := false
    repeat g.items.len() in i:
        it := g.items.ref(i)
        if not _cintr(it[0], a):
            continue
        end
        it.ga_ok = false
        mut gw := NO
        mut gh := NO
        _g_area(g, it, a, iw, ih, 1, gw, gh)
        avw := a == 0 ? NO : gw
        avh := a == 1 ? NO : gh
        old := a == 0 ? it.mincw : it.minch
        nv := _g_contrib(t, it, a, gw, gh, avw, avh, false)
        if not _is(old) or old != nv:
            changed = true
        end
        if a == 0:
            it.mincw = nv
            it.maxcw = NO
            it.minsw = NO
        else:
            it.minch = nv
            it.maxch = NO
            it.minsh = NO
        end
    end
    ret changed
end

func _clear_caches(g &: GC, a: int):
    repeat g.items.len() in i:
        it := g.items.ref(i)
        it.ga_ok = false
        if a == 0:
            it.mincw = NO
            it.maxcw = NO
            it.minsw = NO
        else:
            it.minch = NO
            it.maxch = NO
            it.minsh = NO
        end
    end
end

func _grid_child_pl(t &: Engine, c: int, gd: GData, cnames: Vector<LName>, rnames: Vector<LName>, ncol: int, nrow: int): GPlc:
    cd := t.nodes.ref(c).gd
    ret GPlc { col = _resolve_pl(gd, cnames, 0, cd.pcs, cd.pce, ncol), row = _resolve_pl(gd, rnames, 1, cd.prs, cd.pre, nrow) }
end

func _align_edge(a: Align, rtl: bool): int:
    if a == Align.Center:
        ret 2
    end
    endk := a == Align.End or a == Align.FlexEnd
    st := endk == rtl
    ret st ? 0 : 1
end

func _grid(t &: Engine, id: int, inp: Inp): Out:
    n := t.nodes.ref(id)
    st := n.style
    gd := n.gd
    rtl := st.direction == Direction.Rtl
    ratio := st.aspect_ratio
    pad := _r4(st.padding, inp.pw)
    bor := _r4(st.border, inp.pw)
    pbw := pad.l + pad.r + bor.l + bor.r
    pbh := pad.t + pad.b + bor.t + bor.b
    adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
    adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
    mnw0 := _res(st.min_width, inp.pw)
    mnh0 := _res(st.min_height, inp.ph)
    mxw0 := _res(st.max_width, inp.pw)
    mxh0 := _res(st.max_height, inp.ph)
    minw := _add(_arw(mnw0, mnh0, ratio), adjw)
    minh := _add(_arh(mnw0, mnh0, ratio), adjh)
    maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
    maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
    mut prw := NO
    mut prh := NO
    if inp.inherent:
        sw0 := _res(st.width, inp.pw)
        sh0 := _res(st.height, inp.ph)
        prw = _add(_arw(sw0, sh0, ratio), adjw)
        prh = _add(_arh(sw0, sh0, ratio), adjh)
    end
    sgx := st.overflow_y == Overflow.Scroll ? st.scrollbar_width : 0.0
    sgy := st.overflow_x == Overflow.Scroll ? st.scrollbar_width : 0.0
    mut cbi := _r4add(pad, bor)
    cbi.b += sgy
    if rtl:
        cbi.l += sgx
    else:
        cbi.r += sgx
    end
    cbx := cbi.l + cbi.r
    cby := cbi.t + cbi.b
    jc := st.justify_content == Align.Normal ? Align.Stretch : st.justify_content
    ac := st.align_content == Align.Normal ? Align.Stretch : st.align_content
    ai := st.align_items
    ji := st.justify_items
    kw0 := _or(inp.kw, prw)
    kh0 := _or(inp.kh, prh)
    mut caw := _is(kw0) ? kw0 : inp.aw
    mut cah := _is(kh0) ? kh0 : inp.ah
    if _def(caw):
        caw = _fmax(_clampf(caw, minw, maxw), pbw)
    end
    if _def(cah):
        cah = _fmax(_clampf(cah, minh, maxh), pbh)
    end
    agw := _def(caw) ? caw - cbx : caw
    agh := _def(cah) ? cah - cby : cah
    outer_w := _is(kw0) ? _fmax(_clampf(kw0, minw, maxw), pbw) : NO
    outer_h := _is(kh0) ? _fmax(_clampf(kh0, minh, maxh), pbh) : NO
    iminw := _sub(minw, cbx)
    iminh := _sub(minh, cby)
    imaxw := _sub(maxw, cbx)
    imaxh := _sub(maxh, cby)
    mut inner_w := _sub(outer_w, cbx)
    mut inner_h := _sub(outer_h, cby)
    if not inp.perform:
        if _is(outer_w) and _is(outer_h):
            ret Out { w = outer_w, h = outer_h }
        end
        if inp.axis == 0 and _is(outer_w):
            ret Out { w = outer_w, h = 0.0 }
        end
    end
    mut afw := _or(_or(outer_w, maxw), minw)
    if _is(afw):
        afw = _sub(_fmax(_clampf(afw, minw, maxw), pbw), cbx)
    end
    mut afh := _or(_or(outer_h, maxh), minh)
    if _is(afh):
        afh = _sub(_fmax(_clampf(afh, minh, maxh), pbh), cby)
    end
    mut creps := 0
    mut rreps := 0
    ccount := _tpl_count(gd.cols, afw, _is(_or(outer_w, maxw)), st.column_gap, creps)
    rcount := _tpl_count(gd.rows, afh, _is(_or(outer_h, maxh)), st.row_gap, rreps)
    mut ctr := Vector {} as Vector<TDef>
    defer ctr.free()
    mut cnames := Vector {} as Vector<LName>
    defer cnames.free()
    mut rtr := Vector {} as Vector<TDef>
    defer rtr.free()
    mut rnames := Vector {} as Vector<LName>
    defer rnames.free()
    _tpl_expand(gd.cols, creps, ctr, cnames)
    _tpl_expand(gd.rows, rreps, rtr, rnames)
    ecol := _imin(_imax(ccount, gd.area_nc), GMAX)
    erow := _imin(_imax(rcount, gd.area_nr), GMAX)
    kids := _kids(t, id)
    defer kids.free()
    mut g := GC {}
    g.tr = Vector {} as Vector<GTr>
    g.items = Vector {} as Vector<GIt>
    defer g.tr.free()
    defer g.items.free()
    mut pls := Vector {} as Vector<GPlc>
    defer pls.free()
    mut sorted := Vector {} as Vector<int>
    defer sorted.free()
    repeat kids.len() in i:
        c := kids[i]
        cst := t.nodes.ref(c).style
        if cst.display == Display.None or _oof(cst.position):
            continue
        end
        sorted.push(i)
    end
    repeat sorted.len() in i:
        mut j := i
        until j > 0 and t.nodes.ref(kids[sorted[j - 1]]).style.order > t.nodes.ref(kids[sorted[j]]).style.order:
            tmp := sorted[j]
            sorted[j] = sorted[j - 1]
            sorted[j - 1] = tmp
            j--
        end
    end
    each si in sorted:
        c := kids[si]
        cst := t.nodes.ref(c).style
        pls.push(_grid_child_pl(t, c, gd, cnames, rnames, ecol, erow))
        a_s := cst.align_self == Align.Auto ? ai : cst.align_self
        j_s := cst.justify_self == Align.Auto ? ji : cst.justify_self
        g.items.push(GIt { id = c, src = si, ovx = cst.overflow_x, ovy = cst.overflow_y, aself = a_s, jself = j_s })
    end
    mut cmin := 0
    mut cmax := 0
    mut cspan := 0
    mut rmin := 0
    mut rmax := 0
    mut rspan := 0
    each pl in pls:
        mut mn := 0
        mut mx := 0
        mut sp := 0
        _px_minmax(pl.col, mn, mx, sp)
        cmin = _imin(cmin, mn)
        cmax = _imax(cmax, mx)
        cspan = _imax(cspan, sp)
        _px_minmax(pl.row, mn, mx, sp)
        rmin = _imin(rmin, mn)
        rmax = _imax(rmax, mx)
        rspan = _imax(rspan, sp)
    end
    cneg0 := cmin < 0 ? 0 - cmin : 0
    mut cpos0 := cmax > ecol ? cmax - ecol : 0
    if cneg0 + ecol + cpos0 < cspan:
        cpos0 = cspan - ecol - cneg0
    end
    if cneg0 + ecol + cpos0 > GMAX:
        cpos0 = _imax(0, GMAX - cneg0 - ecol)
    end
    rneg0 := rmin < 0 ? 0 - rmin : 0
    mut rpos0 := rmax > erow ? rmax - erow : 0
    if rneg0 + erow + rpos0 < rspan:
        rpos0 = rspan - erow - rneg0
    end
    if rneg0 + erow + rpos0 > GMAX:
        rpos0 = _imax(0, GMAX - rneg0 - erow)
    end
    mut occ := _occ_new(cneg0, ecol, cpos0, rneg0, erow, rpos0)
    defer _occ_free(occ)
    _place(occ, g.items, pls, st.grid_auto_flow)
    g.cneg = occ.nc0
    g.cexp = ecol
    g.cpos = occ.nct - occ.nc0 - ecol
    g.rneg = occ.nr0
    g.rexp = erow
    g.rpos = occ.nrt - occ.nr0 - erow
    _init_tracks(g.tr, g.cneg, g.cexp, g.cpos, gd.cols, creps, gd.acols, st.column_gap, gd.cols.rep == 2, occ, 0)
    g.nct = g.tr.len()
    _init_tracks(g.tr, g.rneg, g.rexp, g.rpos, gd.rows, rreps, gd.arows, st.row_gap, gd.rows.rep == 2, occ, 1)
    g.nrt = g.tr.len() - g.nct
    repeat g.items.len() in i:
        it := g.items.ref(i)
        it.ci0 = 2 * (it.c0 + g.cneg)
        it.ci1 = 2 * (it.c1 + g.cneg)
        it.ri0 = 2 * (it.r0 + g.rneg)
        it.ri1 = 2 * (it.r1 + g.rneg)
    end
    _g_crosses(g)
    mut has_base := false
    repeat g.items.len() in i:
        if _g_base_part(t, g.items[i]):
            has_base = true
        end
    end
    _sizing(t, g, 0, iminw, imaxw, jc, ac, agw, agh, inner_w, inner_h, 0, has_base)
    icol := _sum_base(g, 0)
    if not _is(inner_w):
        inner_w = icol
    end
    if not inp.perform and inp.axis == 0:
        w := _fmax(_clampf(icol + cbx, minw, maxw), pbw)
        ret Out { w = w, h = 0.0 }
    end
    repeat g.items.len() in i:
        it := g.items.ref(i)
        it.ga_ok = false
    end
    _sizing(t, g, 1, iminh, imaxh, ac, jc, agw, agh, inner_w, inner_h, 1, false)
    irow := _sum_base(g, 1)
    rsw := _or(inp.kw, prw)
    rsh := _or(inp.kh, prh)
    mut bw := _fmax(_clampf(_or(rsw, icol + cbx), minw, maxw), pbw)
    mut bh := _fmax(_clampf(_or(rsh, irow + cby), minh, maxh), pbh)
    mut cw := _fmax(0.0, bw - cbx)
    mut ch := _fmax(0.0, bh - cby)
    if not inp.perform:
        ret Out { w = bw, h = bh }
    end
    inner_w = cw
    inner_h = ch
    hpc := _any_pct(g, 0)
    hpr := _any_pct(g, 1)
    mut rerun_c := not _is(outer_w) and hpc
    mut cchanged := false
    if not rerun_c:
        cchanged = _recheck(t, g, 0, inner_w, inner_h)
        rerun_c = cchanged
    else:
        _clear_caches(g, 0)
    end
    mut rerun_r := not _is(outer_h) and hpr
    mut rchanged := false
    if rerun_r:
        _clear_caches(g, 1)
    end
    if rerun_c:
        _sizing(t, g, 0, iminw, imaxw, jc, ac, agw, agh, inner_w, inner_h, 1, has_base)
        if not rerun_r:
            rchanged = _recheck(t, g, 1, inner_w, inner_h)
            rerun_r = rchanged
        end
    end
    if rerun_r:
        _sizing(t, g, 1, iminh, imaxh, ac, jc, agw, agh, inner_w, inner_h, 1, false)
    end
    if (cchanged and not hpc) or (rchanged and not hpr):
        if cchanged and not hpc:
            bw = _fmax(_clampf(_or(rsw, _sum_base(g, 0) + cbx), minw, maxw), pbw)
            cw = _fmax(0.0, bw - cbx)
        end
        if rchanged and not hpr:
            bh = _fmax(_clampf(_or(rsh, _sum_base(g, 1) + cby), minh, maxh), pbh)
            ch = _fmax(0.0, bh - cby)
        end
    end
    iws := _fmax(bw - pbw, 0.0)
    gx := _fmin(sgx, iws)
    _align_tracks(g, 0, cw, pad.l + (rtl ? gx : 0.0), bor.l, jc, rtl)
    _align_tracks(g, 1, ch, pad.t, bor.t, ac, false)
    repeat g.items.len() in i:
        it := g.items.ref(i)
        top := g.tr[g.nct + it.ri0 + 1].off
        bottom := g.tr[g.nct + it.ri1].off
        mut left := 0.0
        mut right := 0.0
        if rtl:
            left = g.tr[it.ci1 - 1].off
            right = g.tr[it.ci0].off
        else:
            left = g.tr[it.ci0 + 1].off
            right = g.tr[it.ci1].off
        end
        _g_position(t, it, left, right, top, bottom, ji, ai, rtl)
    end
    each c in kids:
        cn := t.nodes.ref(c)
        cst := cn.style
        if cst.display == Display.None or not _oof(cst.position):
            continue
        end
        js := cst.justify_self == Align.Auto ? ji : cst.justify_self
        a_self := cst.align_self == Align.Auto ? ai : cst.align_self
        cn.spx_s = bor.l + pad.l + (rtl ? sgx : 0.0)
        cn.spx_e = bw - bor.r - pad.r - (rtl ? 0.0 : sgx)
        cn.spx_a = _align_edge(js, rtl)
        cn.spy_s = bor.t + pad.t
        cn.spy_e = bh - bor.b - pad.b - sgy
        cn.spy_a = _align_edge(a_self, false)
    end
    _hide_display_none(t, kids)
    nn := t.nodes.ref(id)
    nn.gi.tr.free()
    nn.gi = GInfo { ok = true, nct = g.nct, nrt = g.nrt, cneg = g.cneg, cexp = g.cexp, cpos = g.cpos, rneg = g.rneg, rexp = g.rexp, rpos = g.rpos, creps = creps, rreps = rreps, w = bw, h = bh, bor = bor, sgx = sgx, sgy = sgy, rtl = rtl }
    nn.gi.tr = Vector {} as Vector<GTr>
    each tr in g.tr:
        nn.gi.tr.push(tr)
    end
    if g.items.len() == 0:
        ret Out { w = bw, h = bh }
    end
    mut first_row := g.items[0].ri0
    each it in g.items:
        if it.ri0 < first_row:
            first_row = it.ri0
        end
    end
    mut pick := -1
    repeat g.items.len() in i:
        it := g.items[i]
        if it.ri0 == first_row:
            if pick < 0:
                pick = i
            end
            if _g_base_part(t, it) and not _g_base_part(t, g.items[pick]):
                pick = i
            end
        end
    end
    pit := g.items[pick]
    ret Out { w = bw, h = bh, baseline = pit.ypos + _or(pit.ibase, pit.hgt) }
end

func _grid_abs_area(t &: Engine, cb: int, child: int, left &: f64, right &: f64, top &: f64, bottom &: f64): bool:
    cn := t.nodes.ref(cb)
    gi := cn.gi
    if not gi.ok:
        ret false
    end
    gd := cn.gd
    mut ctr := Vector {} as Vector<TDef>
    defer ctr.free()
    mut cnames := Vector {} as Vector<LName>
    defer cnames.free()
    mut rtr := Vector {} as Vector<TDef>
    defer rtr.free()
    mut rnames := Vector {} as Vector<LName>
    defer rnames.free()
    _tpl_expand(gd.cols, gi.creps, ctr, cnames)
    _tpl_expand(gd.rows, gi.rreps, rtr, rnames)
    pl := _grid_child_pl(t, child, gd, cnames, rnames, gi.cexp, gi.rexp)
    ps_l := gi.bor.l + (gi.rtl ? gi.sgx : 0.0)
    ps_r := gi.w - gi.bor.r - (gi.rtl ? 0.0 : gi.sgx)
    ps_t := gi.bor.t
    ps_b := gi.h - gi.bor.b - gi.sgy
    mut cs := NOLINE
    mut ce := NOLINE
    _abs_lines(pl.col, cs, ce)
    mut rs := NOLINE
    mut re := NOLINE
    _abs_lines(pl.row, rs, re)
    cmin := 0 - gi.cneg
    cmax := gi.cexp + gi.cpos
    rmin := 0 - gi.rneg
    rmax := gi.rexp + gi.rpos
    if cs != NOLINE and (cs < cmin or cs > cmax):
        cs = NOLINE
    end
    if ce != NOLINE and (ce < cmin or ce > cmax):
        ce = NOLINE
    end
    if rs != NOLINE and (rs < rmin or rs > rmax):
        rs = NOLINE
    end
    if re != NOLINE and (re < rmin or re > rmax):
        re = NOLINE
    end
    ntc := (gi.nct - 1) / 2
    ntr := (gi.nrt - 1) / 2
    mut s_x := gi.rtl ? ps_r : ps_l
    mut e_x := gi.rtl ? ps_l : ps_r
    if ntc == 0:
        if cs != NOLINE:
            s_x = gi.tr[0].off
        end
        if ce != NOLINE:
            e_x = gi.tr[0].off
        end
    else cs != NOLINE:
        k := cs + gi.cneg
        if k < ntc:
            s_x = _abs_edge(gi, 0, k, true)
        else ntc > 0:
            s_x = _abs_edge(gi, 0, ntc - 1, false)
        end
    end
    if ce != NOLINE and ntc > 0:
        k := ce + gi.cneg - 1
        if k >= 0 and k < ntc:
            e_x = _abs_edge(gi, 0, k, false)
        else ntc > 0:
            e_x = _abs_edge(gi, 0, 0, true)
        end
    end
    mut s_y := ps_t
    mut e_y := ps_b
    if ntr == 0:
        if rs != NOLINE:
            s_y = gi.tr[gi.nct].off
        end
        if re != NOLINE:
            e_y = gi.tr[gi.nct].off
        end
    else rs != NOLINE:
        k := rs + gi.rneg
        if k < ntr:
            s_y = _abs_edge(gi, 1, k, true)
        else ntr > 0:
            s_y = _abs_edge(gi, 1, ntr - 1, false)
        end
    end
    if re != NOLINE and ntr > 0:
        k := re + gi.rneg - 1
        if k >= 0 and k < ntr:
            e_y = _abs_edge(gi, 1, k, false)
        else ntr > 0:
            e_y = _abs_edge(gi, 1, 0, true)
        end
    end
    if gi.rtl:
        left = _fmin(s_x, e_x)
        right = s_x
    else:
        left = s_x
        right = _fmax(s_x, e_x)
    end
    top = s_y
    bottom = _fmax(s_y, e_y)
    ret true
end

func _abs_lines(p: GPx, s &: int, e &: int):
    s = NOLINE
    e = NOLINE
    if p.k0 == GP_LINE and p.k1 == GP_LINE:
        if p.v0 == p.v1:
            s = p.v0
            e = p.v0 + 1
        else:
            s = _imin(p.v0, p.v1)
            e = _imax(p.v0, p.v1)
        end
    else p.k0 == GP_LINE and p.k1 == GP_SPAN:
        s = p.v0
        e = p.v0 + p.v1
    else p.k0 == GP_LINE:
        s = p.v0
    else p.k0 == GP_SPAN and p.k1 == GP_LINE:
        s = p.v1 - p.v0
        e = p.v1
    else p.k1 == GP_LINE:
        e = p.v1
    end
end

func _abs_edge(gi: GInfo, a: int, k0: int, is_start: bool): f64:
    base := a == 0 ? 0 : gi.nct
    nt := ((a == 0 ? gi.nct : gi.nrt) - 1) / 2
    mut k := k0
    if gi.tr[base + 2 * k + 1].collapsed:
        mut rs := k
        until rs > 0 and gi.tr[base + 2 * (rs - 1) + 1].collapsed:
            rs--
        end
        mut re := k
        until re < nt and gi.tr[base + 2 * re + 1].collapsed:
            re++
        end
        if is_start and re < nt:
            k = re
        else not is_start and rs > 0:
            k = rs - 1
        end
    end
    tr := gi.tr[base + 2 * k + 1]
    rev := a == 0 and gi.rtl
    if is_start != rev:
        ret tr.off
    end
    ret tr.off + tr.base
end
