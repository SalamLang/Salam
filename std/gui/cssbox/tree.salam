package cssbox

struct Engine:
    pub nodes: Vector<Node> = Vector {}
    pub rounding: bool = true
    pub measure_calls: int = 0
    pub layout_calls: int = 0
    pub vw: f64 = MAXC
    pub vh: f64 = MAXC
    pub oofs: Vector<int> = Vector {}
end

@en "Tree"
@fa "درخت"
pub struct Tree:
    e: Engine = Engine {}

    @en "AddNode"
    @fa "افزودن گره"
    pub func AddNode(style: Style): int:
        mut st := style
        mut gd := GData {}
        _gd_set(gd, st)
        this.e.nodes.Push(Node { style = st, gd = gd, ubor = st.border })
        ret this.e.nodes.Len() - 1
    end

    @en "NodeCount"
    @fa "شمار گره ها"
    pub func NodeCount(): int:
        ret this.e.nodes.Len()
    end

    @en "SetChildren"
    @fa "تنظیم فرزندان"
    pub func SetChildren(node: int, children: Vector<int>):
        if node < 0 or node >= this.e.nodes.Len():
            ret
        end
        n := this.e.nodes.Ref(node)
        each old in n.children:
            if old >= 0 and old < this.e.nodes.Len():
                c := this.e.nodes.Ref(old)
                if c.parent == node:
                    c.parent = -1
                end
            end
        end
        n.children.Clear()
        each c in children:
            if c >= 0 and c < this.e.nodes.Len() and c != node:
                n.children.Push(c)
                cn := this.e.nodes.Ref(c)
                cn.parent = node
            end
        end
        this.MarkDirty(node)
    end

    @en "AddChild"
    @fa "افزودن فرزند"
    pub func AddChild(node: int, child: int):
        if node < 0 or node >= this.e.nodes.Len() or child < 0 or child >= this.e.nodes.Len() or child == node:
            ret
        end
        n := this.e.nodes.Ref(node)
        n.children.Push(child)
        cn := this.e.nodes.Ref(child)
        cn.parent = node
        this.MarkDirty(node)
    end

    @en "ChildCount"
    @fa "شمار فرزندان"
    pub func ChildCount(node: int): int:
        if node < 0 or node >= this.e.nodes.Len():
            ret 0
        end
        ret this.e.nodes.Ref(node).children.Len()
    end

    @en "Child"
    @fa "فرزند"
    pub func Child(node: int, index: int): int:
        if node < 0 or node >= this.e.nodes.Len():
            ret -1
        end
        n := this.e.nodes.Ref(node)
        if index < 0 or index >= n.children.Len():
            ret -1
        end
        ret n.children.Get(index)
    end

    @en "Parent"
    @fa "والد"
    pub func Parent(node: int): int:
        if node < 0 or node >= this.e.nodes.Len():
            ret -1
        end
        ret this.e.nodes.Ref(node).parent
    end

    @en "GetStyle"
    @fa "سبک گره"
    pub func GetStyle(node: int): Style:
        if node < 0 or node >= this.e.nodes.Len():
            ret Style {}
        end
        n := this.e.nodes.Ref(node)
        if n.bov:
            mut st := n.style
            st.border = n.ubor
            ret st
        end
        ret n.style
    end

    @en "SetStyle"
    @fa "تنظیم سبک"
    pub func SetStyle(node: int, style: Style):
        if node < 0 or node >= this.e.nodes.Len():
            ret
        end
        n := this.e.nodes.Ref(node)
        if _style_eq(n.bov ? _with_border(n.style, n.ubor) : n.style, style):
            ret
        end
        mut st := style
        _gd_set(n.gd, st)
        n.style = st
        n.ubor = st.border
        n.bov = false
        this.MarkDirty(node)
    end

    @en "SetMeasure"
    @fa "تنظیم سنجش"
    pub func SetMeasure(node: int, measure: func (MeasureInput) MeasureOutput):
        if node < 0 or node >= this.e.nodes.Len():
            ret
        end
        n := this.e.nodes.Ref(node)
        n.measure = measure
        n.has_measure = true
        this.MarkDirty(node)
    end

    @en "ClearMeasure"
    @fa "حذف سنجش"
    pub func ClearMeasure(node: int):
        if node < 0 or node >= this.e.nodes.Len():
            ret
        end
        n := this.e.nodes.Ref(node)
        n.has_measure = false
        this.MarkDirty(node)
    end

    @en "MarkDirty"
    @fa "علامت تغییر"
    pub func MarkDirty(node: int):
        mut cur := node
        mut guard := 0
        until cur >= 0 and cur < this.e.nodes.Len() and guard <= this.e.nodes.Len():
            n := this.e.nodes.Ref(cur)
            n.fin_ok = false
            n.ckeys.Clear()
            n.couts.Clear()
            n.cnext = 0
            cur = n.parent
            guard++
        end
    end

    @en "IsDirty"
    @fa "تغییر کرده است"
    pub func IsDirty(node: int): bool:
        if node < 0 or node >= this.e.nodes.Len():
            ret false
        end
        n := this.e.nodes.Ref(node)
        ret not n.fin_ok and n.ckeys.Len() == 0
    end

    @en "SetRounding"
    @fa "تنظیم گردکردن"
    pub func SetRounding(enabled: bool):
        this.e.rounding = enabled
    end

    @en "MeasureCalls"
    @fa "شمار سنجش ها"
    pub func MeasureCalls(): int:
        ret this.e.measure_calls
    end

    @en "LayoutCalls"
    @fa "شمار محاسبه ها"
    pub func LayoutCalls(): int:
        ret this.e.layout_calls
    end

    @en "ResetCounters"
    @fa "صفر کردن شمارنده ها"
    pub func ResetCounters():
        this.e.measure_calls = 0
        this.e.layout_calls = 0
    end

    @en "Compute"
    @fa "محاسبه"
    pub func Compute(root: int, width: Space, height: Space):
        if root < 0 or root >= this.e.nodes.Len():
            ret
        end
        _compute_root(this.e, root, _space_out(width), _space_out(height))
    end

    @en "Layout"
    @fa "جانمایی گره"
    pub func Layout(node: int): BoxLayout:
        if node < 0 or node >= this.e.nodes.Len():
            ret BoxLayout {}
        end
        ret this.e.nodes.Ref(node).fin
    end

    @en "CollapsedBorders"
    @fa "مرزهای ادغامی"
    pub func CollapsedBorders(table: int): Vector<CollapsedBorder>:
        mut out := Vector {} as Vector<CollapsedBorder>
        if table >= 0 and table < this.e.nodes.Len() and this.e.nodes.Ref(table).style.border_collapse == BorderCollapse.Collapse:
            _tb_segments(this.e, table, out)
        end
        ret out
    end

    @en "Free"
    @fa "آزاد کردن"
    pub func Free():
        repeat this.e.nodes.Len() in i:
            n := this.e.nodes.Ref(i)
            n.children.Free()
            n.ckeys.Free()
            n.couts.Free()
            _gd_free(n.gd)
            n.gi.tr.Free()
            _tb_free(n.tb)
        end
        this.e.nodes.Free()
        this.e.oofs.Free()
    end
end

func _len_eq(a: Length, b: Length): bool:
    ret a.kind == b.kind and a.value == b.value
end

func _sides_eq(a: Sides, b: Sides): bool:
    ret _len_eq(a.top, b.top) and _len_eq(a.right, b.right) and _len_eq(a.bottom, b.bottom) and _len_eq(a.left, b.left)
end

func _with_border(s: Style, b: Sides): Style:
    mut r := s
    r.border = b
    ret r
end

func _style_eq(a: Style, b: Style): bool:
    if not (a.display == b.display):
        ret false
    end
    if not (a.position == b.position):
        ret false
    end
    if not (_sides_eq(a.inset, b.inset)):
        ret false
    end
    if not (a.box_sizing == b.box_sizing):
        ret false
    end
    if not (_len_eq(a.width, b.width)):
        ret false
    end
    if not (_len_eq(a.height, b.height)):
        ret false
    end
    if not (_len_eq(a.min_width, b.min_width)):
        ret false
    end
    if not (_len_eq(a.min_height, b.min_height)):
        ret false
    end
    if not (_len_eq(a.max_width, b.max_width)):
        ret false
    end
    if not (_len_eq(a.max_height, b.max_height)):
        ret false
    end
    if not (a.aspect_ratio == b.aspect_ratio):
        ret false
    end
    if not (_sides_eq(a.margin, b.margin)):
        ret false
    end
    if not (_sides_eq(a.padding, b.padding)):
        ret false
    end
    if not (_sides_eq(a.border, b.border)):
        ret false
    end
    if not (a.overflow_x == b.overflow_x):
        ret false
    end
    if not (a.overflow_y == b.overflow_y):
        ret false
    end
    if not (a.scrollbar_width == b.scrollbar_width):
        ret false
    end
    if not (a.direction == b.direction):
        ret false
    end
    if not (a.flex_direction == b.flex_direction):
        ret false
    end
    if not (a.flex_wrap == b.flex_wrap):
        ret false
    end
    if not (a.flex_grow == b.flex_grow):
        ret false
    end
    if not (a.flex_shrink == b.flex_shrink):
        ret false
    end
    if not (_len_eq(a.flex_basis, b.flex_basis)):
        ret false
    end
    if not (a.justify_content == b.justify_content):
        ret false
    end
    if not (a.align_items == b.align_items):
        ret false
    end
    if not (a.align_self == b.align_self):
        ret false
    end
    if not (a.align_content == b.align_content):
        ret false
    end
    if not (_len_eq(a.row_gap, b.row_gap)):
        ret false
    end
    if not (_len_eq(a.column_gap, b.column_gap)):
        ret false
    end
    if not (a.order == b.order):
        ret false
    end
    if not (a.justify_items == b.justify_items):
        ret false
    end
    if not (a.justify_self == b.justify_self):
        ret false
    end
    if not (a.grid_template_columns == b.grid_template_columns):
        ret false
    end
    if not (a.grid_template_rows == b.grid_template_rows):
        ret false
    end
    if not (a.grid_template_areas == b.grid_template_areas):
        ret false
    end
    if not (a.grid_auto_columns == b.grid_auto_columns):
        ret false
    end
    if not (a.grid_auto_rows == b.grid_auto_rows):
        ret false
    end
    if not (a.grid_auto_flow == b.grid_auto_flow):
        ret false
    end
    if not (a.grid_row_start == b.grid_row_start):
        ret false
    end
    if not (a.grid_row_end == b.grid_row_end):
        ret false
    end
    if not (a.grid_column_start == b.grid_column_start):
        ret false
    end
    if not (a.grid_column_end == b.grid_column_end):
        ret false
    end
    if not (a.table_layout == b.table_layout):
        ret false
    end
    if not (a.border_kinds.top == b.border_kinds.top and a.border_kinds.right == b.border_kinds.right and a.border_kinds.bottom == b.border_kinds.bottom and a.border_kinds.left == b.border_kinds.left):
        ret false
    end
    if not (a.border_collapse == b.border_collapse):
        ret false
    end
    if not (a.border_spacing_x == b.border_spacing_x):
        ret false
    end
    if not (a.border_spacing_y == b.border_spacing_y):
        ret false
    end
    if not (a.caption_side == b.caption_side):
        ret false
    end
    if not (a.vertical_align == b.vertical_align):
        ret false
    end
    if not (a.col_span == b.col_span):
        ret false
    end
    if not (a.row_span == b.row_span):
        ret false
    end
    ret true
end

func _kids(t &: Engine, id: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    n := t.nodes.Ref(id)
    each c in n.children:
        cn := t.nodes.Ref(c)
        if cn.style.display == Display.Contents:
            _set_zero(t, c)
            sub := _kids(t, c)
            each s in sub:
                out.Push(s)
            end
            sub.Free()
        else:
            out.Push(c)
        end
    end
    ret out
end

func _set_zero(t &: Engine, id: int):
    n := t.nodes.Ref(id)
    n.lx = 0.0
    n.ly = 0.0
    n.lw = 0.0
    n.lh = 0.0
    n.pad = R4 {}
    n.bor = R4 {}
    n.mar = R4 {}
    n.sbw = 0.0
    n.sbh = 0.0
    n.base = NO
    n.cmw = 0.0
    n.cmh = 0.0
end

func _set_layout(t &: Engine, id: int, x: f64, y: f64, w: f64, h: f64, pad: R4, bor: R4, mar: R4):
    n := t.nodes.Ref(id)
    n.lx = x
    n.ly = y
    n.lw = w
    n.lh = h
    n.pad = pad
    n.bor = bor
    n.mar = mar
    n.sbw = n.style.overflow_y == Overflow.Scroll ? n.style.scrollbar_width : 0.0
    n.sbh = n.style.overflow_x == Overflow.Scroll ? n.style.scrollbar_width : 0.0
end

func _hide(t &: Engine, id: int):
    n := t.nodes.Ref(id)
    n.fin_ok = false
    n.ckeys.Clear()
    n.couts.Clear()
    n.cnext = 0
    _set_zero(t, id)
    n2 := t.nodes.Ref(id)
    each c in n2.children:
        _hide(t, c)
    end
end

func _hide_display_none(t &: Engine, kids: Vector<int>):
    each c in kids:
        if t.nodes.Ref(c).style.display == Display.None:
            _hide(t, c)
        end
    end
end

func _same_key(a: Inp, b: Inp): bool:
    ret a.kw == b.kw and a.kh == b.kh and a.kw_def == b.kw_def and a.kh_def == b.kh_def and a.pw == b.pw and a.ph == b.ph and a.aw == b.aw and a.ah == b.ah and a.inherent == b.inherent and a.cstart == b.cstart and a.cend == b.cend
end

func _norm_key(inp: Inp): Inp:
    mut k := inp
    k.kw_def = inp.kw_def or not _is(inp.kw)
    k.kh_def = inp.kh_def or not _is(inp.kh)
    if _is(inp.kw):
        k.aw = 0.0
    end
    if _is(inp.kh):
        k.ah = 0.0
    end
    ret k
end

func _layout(t &: Engine, id: int, inp: Inp): Out:
    key := _norm_key(inp)
    n := t.nodes.Ref(id)
    if inp.perform:
        if n.fin_ok and _same_key(n.fin_key, key):
            ret n.fin_out
        end
    else:
        repeat n.ckeys.Len() in i:
            ck := n.ckeys.Get(i)
            if _same_key(ck, key) and (ck.axis == 2 or ck.axis == key.axis):
                ret n.couts.Get(i)
            end
        end
    end
    t.layout_calls++
    d := n.style.display
    mut o := Out {}
    if d == Display.None:
        _hide(t, id)
        ret o
    end
    if n.children.Len() == 0 and d != Display.Grid and d != Display.InlineGrid and d != Display.Table and d != Display.InlineTable:
        o = _leaf(t, id, inp)
    else d == Display.Flex or d == Display.InlineFlex:
        o = _flex(t, id, inp)
    else d == Display.Grid or d == Display.InlineGrid:
        o = _grid(t, id, inp)
    else d == Display.Table or d == Display.InlineTable:
        o = _table(t, id, inp)
    else:
        o = _block(t, id, inp)
    end
    n2 := t.nodes.Ref(id)
    if inp.perform:
        n2.fin_ok = true
        n2.fin_key = key
        n2.fin_out = o
        n2.base = o.baseline
    else:
        if n2.ckeys.Len() < 9:
            n2.ckeys.Push(key)
            n2.couts.Push(o)
        else:
            n2.ckeys.Set(n2.cnext, key)
            n2.couts.Set(n2.cnext, o)
            n2.cnext = (n2.cnext + 1) % 9
        end
    end
    ret o
end
