package cssbox

func _is(v: f64): bool:
    ret v > -1.0e299
end

func _def(a: f64): bool:
    ret a > -1.0e299 and a < 1.0e299
end

func _or(a: f64, b: f64): f64:
    if a > -1.0e299:
        ret a
    end
    ret b
end

func _fmin(a: f64, b: f64): f64:
    if a < b:
        ret a
    end
    ret b
end

func _fmax(a: f64, b: f64): f64:
    if a > b:
        ret a
    end
    ret b
end

func _mmin(a: f64, b: f64): f64:
    if not _is(a):
        ret NO
    end
    if not _is(b):
        ret a
    end
    ret _fmin(a, b)
end

func _mmax(a: f64, b: f64): f64:
    if not _is(a):
        ret NO
    end
    if not _is(b):
        ret a
    end
    ret _fmax(a, b)
end

func _clamp(v: f64, mn: f64, mx: f64): f64:
    if not _is(v):
        ret NO
    end
    mut r := v
    if _is(mx) and r > mx:
        r = mx
    end
    if _is(mn) and r < mn:
        r = mn
    end
    ret r
end

func _clampf(v: f64, mn: f64, mx: f64): f64:
    mut r := v
    if _is(mx) and r > mx:
        r = mx
    end
    if _is(mn) and r < mn:
        r = mn
    end
    ret r
end

func _add(a: f64, b: f64): f64:
    if _is(a):
        ret a + b
    end
    ret NO
end

func _sub(a: f64, b: f64): f64:
    if _is(a):
        ret a - b
    end
    ret NO
end

func _avsub(a: f64, b: f64): f64:
    if _def(a):
        ret a - b
    end
    ret a
end

func _avmax(a: f64, b: f64): f64:
    if _def(a) and a < b:
        ret b
    end
    ret a
end

func _avopt(a: f64): f64:
    if _def(a):
        ret a
    end
    ret NO
end

func _avset(a: f64, o: f64): f64:
    if _is(o):
        ret o
    end
    ret a
end

func _avclamp(a: f64, mn: f64, mx: f64): f64:
    if _def(a):
        ret _clampf(a, mn, mx)
    end
    ret a
end

func _res(l: Length, basis: f64): f64:
    switch l.kind:
        LengthKind.Px:
            ret l.value
        end
        LengthKind.Percent:
            if _is(basis):
                ret basis * l.value / 100.0
            end
            ret NO
        end
        else:
            ret NO
        end
    end
    ret NO
end

func _res0(l: Length, basis: f64): f64:
    v := _res(l, basis)
    if _is(v):
        ret v
    end
    ret 0.0
end

func _isauto(l: Length): bool:
    ret l.kind == LengthKind.Auto
end

func _iskeyword(l: Length): bool:
    ret l.kind == LengthKind.MinContent or l.kind == LengthKind.MaxContent or l.kind == LengthKind.FitContent or l.kind == LengthKind.Stretch
end

func _r4(s: Sides, basis: f64): R4:
    ret R4 { t = _res0(s.top, basis), r = _res0(s.right, basis), b = _res0(s.bottom, basis), l = _res0(s.left, basis) }
end

func _r4opt(s: Sides, basis: f64): R4:
    ret R4 { t = _res(s.top, basis), r = _res(s.right, basis), b = _res(s.bottom, basis), l = _res(s.left, basis) }
end

func _r4add(a: R4, b: R4): R4:
    ret R4 { t = a.t + b.t, r = a.r + b.r, b = a.b + b.b, l = a.l + b.l }
end

func _arw(w: f64, h: f64, ratio: f64): f64:
    if ratio > 0.0 and not _is(w) and _is(h):
        ret h * ratio
    end
    ret w
end

func _arh(w: f64, h: f64, ratio: f64): f64:
    if ratio > 0.0 and _is(w) and not _is(h):
        ret w / ratio
    end
    ret h
end

func _scroller(o: Overflow): bool:
    ret o == Overflow.Hidden or o == Overflow.Scroll or o == Overflow.Auto
end

func _oof(p: Position): bool:
    ret p == Position.Absolute or p == Position.Fixed
end

func _isrel(p: Position): bool:
    ret p == Position.Relative or p == Position.Sticky
end

func _gaps(gap: f64, n: int): f64:
    if n <= 1:
        ret 0.0
    end
    ret gap * ((n - 1) as f64)
end

func _round(v: f64): f64:
    x := v + 0.5
    mut i := x as i64
    if (i as f64) > x:
        i--
    end
    ret i as f64
end

func _space_in(a: f64): Space:
    if a <= -1.0e299:
        ret Space { kind = SpaceKind.MinContent }
    end
    if a >= 1.0e299:
        ret Space { kind = SpaceKind.MaxContent }
    end
    ret Space { kind = SpaceKind.Definite, value = a }
end

func _space_out(s: Space): f64:
    switch s.kind:
        SpaceKind.MinContent:
            ret MINC
        end
        SpaceKind.MaxContent:
            ret MAXC
        end
        SpaceKind.Definite:
            ret s.value
        end
    end
    ret MAXC
end
