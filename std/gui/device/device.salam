@en "HapticKind"
@fa "نوع لرزش"
pub enum HapticKind:
    @en "Tap"
    @fa "ضربه"
    Tap, @en "Heavy"
    @fa "سنگین"
    Heavy, @en "Success"
    @fa "موفق"
    Success, @en "Failure"
    @fa "ناموفق"
    Failure
end

@en "Platform"
@fa "سکو"
pub func Platform(): str:
    ret _os_platform()
end

@en "CanShare"
@fa "قابل اشتراک"
pub func CanShare(): bool:
    ret _os_can_share()
end

@en "Share"
@fa "اشتراک‌گذاری"
pub func Share(text: str, url: str): bool:
    if text.Len() == 0 and url.Len() == 0:
        ret false
    end
    ret _os_share(text, url)
end

@en "CanVibrate"
@fa "قابل لرزش"
pub func CanVibrate(): bool:
    ret _os_can_vibrate()
end

@en "Vibrate"
@fa "لرزاندن"
pub func Vibrate(ms: int): bool:
    if ms <= 0:
        ret false
    end
    if ms > 5000:
        ret _os_vibrate(5000)
    end
    ret _os_vibrate(ms)
end

@en "Haptic"
@fa "بازخورد لمسی"
pub func Haptic(kind: HapticKind): bool:
    code := match kind:
        HapticKind.Tap: 0 end
        HapticKind.Heavy: 1 end
        HapticKind.Success: 2 end
        else: 3 end
    end
    ret _os_haptic(code)
end
