@en "device"
@fa "دستگاه"
package device

/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

mut _hook := (): ret end
mut _hook_set := false

@en "Permission"
@fa "مجوز"
pub enum Permission:
    @en "Camera"
    @fa "دوربین"
    Camera, @en "Microphone"
    @fa "میکروفون"
    Microphone, @en "Location"
    @fa "مکان"
    Location, @en "Notifications"
    @fa "اعلان ها"
    Notifications
end

@en "PermissionState"
@fa "وضعیت مجوز"
pub enum PermissionState:
    @en "NotAsked"
    @fa "پرسیده نشده"
    NotAsked, @en "Granted"
    @fa "داده شده"
    Granted, @en "Denied"
    @fa "رد شده"
    Denied
end

@en "PhotoState"
@fa "وضعیت عکس"
pub enum PhotoState:
    @en "Idle"
    @fa "بیکار"
    Idle, @en "Pending"
    @fa "در انتظار"
    Pending, @en "Ready"
    @fa "آماده"
    Ready, @en "Failed"
    @fa "ناموفق"
    Failed
end

@en "LocationState"
@fa "وضعیت مکان"
pub enum LocationState:
    @en "Idle"
    @fa "بیکار"
    Idle, @en "Pending"
    @fa "در انتظار"
    Pending, @en "Ready"
    @fa "آماده"
    Ready, @en "Failed"
    @fa "ناموفق"
    Failed
end

@en "Location"
@fa "جای"
pub struct Location:
    @en "latitude"
    @fa "عرض جغرافیایی"
    pub latitude: f64 = 0.0
    @en "longitude"
    @fa "طول جغرافیایی"
    pub longitude: f64 = 0.0
    @en "accuracy"
    @fa "دقت"
    pub accuracy: f64 = 0.0
end

@en "HapticKind"
@fa "نوع لرزش"
pub enum HapticKind:
    @en "Tap"
    @fa "ضربه"
    Tap, @en "Heavy"
    @fa "سنگین"
    Heavy, @en "Success"
    @fa "موفق"
    Success, @en "Failure"
    @fa "ناموفق"
    Failure
end

func _perm_name(p: Permission): str:
    ret match p:
        Permission.Camera: "camera" end
        Permission.Microphone: "microphone" end
        Permission.Location: "location" end
        else: "notifications" end
    end
end

@en "Platform"
@fa "سکو"
pub func Platform(): str:
    ret _os_platform()
end

@en "CanShare"
@fa "قابل اشتراک"
pub func CanShare(): bool:
    ret _os_can_share()
end

@en "Share"
@fa "اشتراک‌گذاری"
pub func Share(text: str, url: str): bool:
    if text.Len() == 0 and url.Len() == 0:
        ret false
    end
    ret _os_share(text, url)
end

@en "CanVibrate"
@fa "قابل لرزش"
pub func CanVibrate(): bool:
    ret _os_can_vibrate()
end

@en "Vibrate"
@fa "لرزاندن"
pub func Vibrate(ms: int): bool:
    if ms <= 0:
        ret false
    end
    if ms > 5000:
        ret _os_vibrate(5000)
    end
    ret _os_vibrate(ms)
end

@en "Haptic"
@fa "بازخورد لمسی"
pub func Haptic(kind: HapticKind): bool:
    code := match kind:
        HapticKind.Tap: 0 end
        HapticKind.Heavy: 1 end
        HapticKind.Success: 2 end
        else: 3 end
    end
    ret _os_haptic(code)
end

@en "OnChange"
@fa "هنگام تغییر"
pub func OnChange(hook: func ()):
    _hook = hook
    _hook_set = true
end

@en "Notify"
@fa "آگاه کردن"
pub func Notify():
    if _hook_set:
        _hook()
    end
end

@en "CheckPermission"
@fa "بررسی مجوز"
pub func CheckPermission(p: Permission): PermissionState:
    ret match _os_perm_state(_perm_name(p)):
        1: PermissionState.Granted end
        2: PermissionState.Denied end
        else: PermissionState.NotAsked end
    end
end

@en "RequestPermission"
@fa "درخواست مجوز"
pub func RequestPermission(p: Permission): bool:
    ret _os_perm_request(_perm_name(p))
end

@en "ShowNotification"
@fa "نمایش اعلان"
pub func ShowNotification(id: int, title: str, body: str): bool:
    if title.Len() == 0 and body.Len() == 0:
        ret false
    end
    ret _os_notify(id, title, body, 0)
end

@en "ScheduleNotification"
@fa "زمان بندی اعلان"
pub func ScheduleNotification(id: int, title: str, body: str, seconds: int): bool:
    if seconds <= 0 or (title.Len() == 0 and body.Len() == 0):
        ret false
    end
    if seconds > 2000000:
        ret _os_notify(id, title, body, 2000000000)
    end
    ret _os_notify(id, title, body, seconds * 1000)
end

@en "CancelNotification"
@fa "لغو اعلان"
pub func CancelNotification(id: int): bool:
    ret _os_notify_cancel(id)
end

@en "RequestLocation"
@fa "درخواست مکان"
pub func RequestLocation(): bool:
    ret _os_location_request()
end

@en "LocationStatus"
@fa "وضعیت یابی"
pub func LocationStatus(): LocationState:
    ret match _os_location_state():
        1: LocationState.Pending end
        2: LocationState.Ready end
        3: LocationState.Failed end
        else: LocationState.Idle end
    end
end

@en "LastLocation"
@fa "آخرین مکان"
pub func LastLocation(): Location:
    ret _os_location()
end

@en "PickPhoto"
@fa "برگزیدن عکس"
pub func PickPhoto(): bool:
    ret _os_photo_request(false)
end

@en "TakePhoto"
@fa "گرفتن عکس"
pub func TakePhoto(): bool:
    ret _os_photo_request(true)
end

@en "PhotoStatus"
@fa "وضعیت عکس گیری"
pub func PhotoStatus(): PhotoState:
    ret match _os_photo_state():
        1: PhotoState.Pending end
        2: PhotoState.Ready end
        3: PhotoState.Failed end
        else: PhotoState.Idle end
    end
end

@en "LastPhoto"
@fa "آخرین عکس"
pub func LastPhoto(): str:
    ret _os_photo_path()
end
