package device

import mem

if SALAM_OS_ANDROID or defined(SALAM_OS_IOS):
    extern:
        func salam_host_share(text: str, url: str): int
        func salam_host_vibrate(ms: int): int
        func salam_host_notify(id: int, title: str, body: str, delay_ms: int): int
        func salam_host_notify_cancel(id: int): int
        func salam_host_location_request(): int
        func salam_host_location_get(out: f64*): int
        func salam_host_perm_state(name: str): int
        func salam_host_perm_request(name: str): int
        func salam_host_haptic(kind: int): int
    end

    mut _loc_buf := null as f64*

    if SALAM_OS_ANDROID:
        func _os_platform(): str:
            ret "android"
        end
    else:
        func _os_platform(): str:
            ret "ios"
        end
    end

    func _os_can_share(): bool:
        ret true
    end

    func _os_share(text: str, url: str): bool:
        ret salam_host_share(text, url) != 0
    end

    func _os_can_vibrate(): bool:
        ret true
    end

    func _os_vibrate(ms: int): bool:
        ret salam_host_vibrate(ms) != 0
    end

    func _os_haptic(kind: int): bool:
        ret salam_host_haptic(kind) != 0
    end

    func _os_perm_state(name: str): int:
        ret salam_host_perm_state(name)
    end

    func _os_perm_request(name: str): bool:
        ret salam_host_perm_request(name) != 0
    end

    func _os_notify(id: int, title: str, body: str, delay_ms: int): bool:
        ret salam_host_notify(id, title, body, delay_ms) != 0
    end

    func _os_notify_cancel(id: int): bool:
        ret salam_host_notify_cancel(id) != 0
    end

    func _os_location_request(): bool:
        ret salam_host_location_request() != 0
    end

    func _os_location_state(): int:
        if _loc_buf == null:
            _loc_buf = mem.AllocateZeroed(24 as u64) as f64*
        end
        ret salam_host_location_get(_loc_buf)
    end

    func _os_location(): Location:
        _s := _os_location_state()
        ret Location { latitude = _loc_buf[0], longitude = _loc_buf[1], accuracy = _loc_buf[2] }
    end
end
