package device

if not SALAM_OS_ANDROID and not defined(SALAM_OS_IOS):
    func _os_platform(): str:
        ret "none"
    end

    func _os_can_share(): bool:
        ret false
    end

    func _os_share(_text: str, _url: str): bool:
        ret false
    end

    func _os_can_vibrate(): bool:
        ret false
    end

    func _os_vibrate(_ms: int): bool:
        ret false
    end

    func _os_haptic(_kind: int): bool:
        ret false
    end

    func _os_path(_kind: int): str:
        ret ""
    end

    func _os_secure_set(_key: str, _value: str): bool:
        ret false
    end

    func _os_secure_get(_key: str): str:
        ret ""
    end

    func _os_secure_delete(_key: str): bool:
        ret false
    end

    func _os_perm_state(_name: str): int:
        ret 2
    end

    func _os_perm_request(_name: str): bool:
        ret false
    end

    func _os_notify(_id: int, _title: str, _body: str, _delay_ms: int): bool:
        ret false
    end

    func _os_notify_cancel(_id: int): bool:
        ret false
    end

    func _os_location_request(): bool:
        ret false
    end

    func _os_location_state(): int:
        ret 0
    end

    func _os_location(): Location:
        ret Location {}
    end

    func _os_photo_request(_camera: bool): bool:
        ret false
    end

    func _os_photo_state(): int:
        ret 0
    end

    func _os_photo_path(): str:
        ret ""
    end
end
