@en "drag"
@fa "کشیدن"
package drag

import mem
import str
import os
import os.shell

// Drag-source initiation abstractions (best-effort).
//
// Native drag-and-drop source APIs are highly platform- and widget-toolkit-specific.
// This module provides a portable, additive API surface and best-effort fallbacks:
// - Stages drag payload descriptors for host integrations.
// - On Linux, attempts to start an external drag helper when available (dragon,
//   ripdrag) as a pragmatic desktop fallback.
// - On Windows/macOS, returns false with a reason unless a host backend is wired.
//
// For drop-target handling, see gui.drop.

pub const SOURCE_NONE := 0
pub const SOURCE_FILES := 1
pub const SOURCE_TEXT := 2
pub const SOURCE_URI := 4
pub const SOURCE_IMAGE_PATH := 8

mut _last_error := ""
mut _last_payload_kind := 0
mut _last_payload_count := 0

@en "DragPayload"
@fa "بار کشیدن"
pub struct DragPayload:
    @en "kind"
    @fa "نوع"
    pub kind: int = SOURCE_NONE
    @en "files"
    @fa "پرونده‌ها"
    pub files: Vector<str> = Vector {}
    @en "text"
    @fa "متن"
    pub text: str = ""
    @en "uri"
    @fa "نشانی"
    pub uri: str = ""
    @en "image_path"
    @fa "مسیر تصویر"
    pub image_path: str = ""
    @en "mime"
    @fa "مایم"
    pub mime: str = ""
end

@en "DragOptions"
@fa "گزینه‌های کشیدن"
pub struct DragOptions:
    @en "allowed_effects"
    @fa "اثرهای مجاز"
    pub allowed_effects: int = 7
    @en "preferred_effect"
    @fa "اثر ترجیحی"
    pub preferred_effect: int = 1
end

func _set_error(msg: str):
    _last_error = msg
end

func _ok(): bool:
    _last_error = ""
    ret true
end

func _quote_sh(s: str): str:
    if s.Len() == 0: ret str.Clone("''") end
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 39)
    n := s.Len()
    mut i := 0
    until i < n:
        ch := s.Substr(i, 1)
        if ch == "'":
            str.BufAppend(sb, "'\\''")
        else:
            str.BufAppend(sb, ch)
        end
        mem.Free(ch as void*)
        i++
    end
    str.BufAppendChar(sb, 39)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _has_cmd(name: str): bool:
    r := shell.Exec("command -v " + name + " >/dev/null 2>&1")
    ret r.code == 0
end

@en "LastError"
@fa "آخرین خطا"
pub func LastError(): str:
    ret _last_error
end

@en "Supported"
@fa "پشتیبانی‌شده"
pub func Supported(): bool:
    if SALAM_OS_LINUX or SALAM_OS_BSD:
        ret _has_cmd("dragon") or _has_cmd("dragon-drop") or _has_cmd("ripdrag")
    end
    // Native in-app drag-source initiation requires toolkit/backend hooks not exposed here.
    ret false
end

@en "Note"
@fa "یادداشت"
pub func Note(): str:
    if SALAM_OS_LINUX or SALAM_OS_BSD:
        if Supported():
            ret str.Clone("Best-effort drag source via external helper (dragon/ripdrag) when available.")
        end
        ret str.Clone("No external drag-source helper found (install dragon or ripdrag) and no native toolkit hook is wired.")
    else SALAM_OS_WINDOWS:
        ret str.Clone("Windows drag-source initiation (DoDragDrop/OLE) requires host widget integration; not wired in this std helper.")
    else SALAM_OS_MAC:
        ret str.Clone("macOS drag-source initiation (NSDraggingSource/NSPasteboard) requires host view integration; not wired in this std helper.")
    end
    ret str.Clone("Drag-source initiation is not supported on this platform.")
end

@en "NewFilesPayload"
@fa "بار پرونده‌ها"
pub func NewFilesPayload(files: Vector<str>): DragPayload:
    mut p := DragPayload { kind = SOURCE_FILES, files = Vector {} }
    repeat files.Len() in i:
        p.files.Push(str.Clone(files.Get(i)))
    end
    ret p
end

@en "NewTextPayload"
@fa "بار متن"
pub func NewTextPayload(text: str): DragPayload:
    ret DragPayload { kind = SOURCE_TEXT, text = str.Clone(text) }
end

@en "NewURIPayload"
@fa "بار نشانی"
pub func NewURIPayload(uri: str): DragPayload:
    ret DragPayload { kind = SOURCE_URI, uri = str.Clone(uri) }
end

@en "NewImagePathPayload"
@fa "بار مسیر تصویر"
pub func NewImagePathPayload(path: str, mime: str = ""): DragPayload:
    ret DragPayload { kind = SOURCE_IMAGE_PATH, image_path = str.Clone(path), mime = str.Clone(mime) }
end

@en "PayloadSummary"
@fa "خلاصه بار"
pub func PayloadSummary(p: DragPayload): str:
    mut s := "kind=" + str.FromInt(p.kind as i64)
    if p.files.Len() > 0:
        s = s + " files=" + str.FromInt(p.files.Len() as i64)
    end
    if p.text.Len() > 0:
        s = s + " text_len=" + str.FromInt(p.text.Len() as i64)
    end
    if p.uri.Len() > 0:
        s = s + " uri=1"
    end
    if p.image_path.Len() > 0:
        s = s + " image_path=1"
    end
    ret s
end

@en "StartDrag"
@fa "آغاز کشیدن"
pub func StartDrag(_native: void*, payload: DragPayload, _options: DragOptions = DragOptions {}): bool:
    _last_payload_kind = payload.kind
    _last_payload_count = payload.files.Len()
    if payload.kind == SOURCE_NONE:
        _set_error("Empty drag payload")
        ret false
    end

    if SALAM_OS_LINUX or SALAM_OS_BSD:
        // Best-effort: delegate to external drag helpers for file/image-path payloads.
        if (payload.kind & SOURCE_FILES) != 0 or (payload.kind & SOURCE_IMAGE_PATH) != 0:
            mut cmd := ""
            if _has_cmd("dragon"):
                cmd = "dragon --and-exit"
            else _has_cmd("dragon-drop"):
                cmd = "dragon-drop --and-exit"
            else _has_cmd("ripdrag"):
                cmd = "ripdrag -a -s 48"
            end
            if cmd.Len() == 0:
                _set_error("No drag helper available")
                ret false
            end
            mut sb := str.NewBuilder()
            str.BufAppend(sb, cmd)
            if (payload.kind & SOURCE_IMAGE_PATH) != 0 and payload.image_path.Len() > 0:
                q := _quote_sh(payload.image_path)
                str.BufAppend(sb, " ")
                str.BufAppend(sb, q)
                mem.Free(q as void*)
            end
            repeat payload.files.Len() in i:
                q := _quote_sh(payload.files.Get(i))
                str.BufAppend(sb, " ")
                str.BufAppend(sb, q)
                mem.Free(q as void*)
            end
            str.BufAppend(sb, " >/dev/null 2>&1 &")
            final := str.BufStr(sb)
            str.BufFree(sb)
            ok := shell.System(final) == 0
            mem.Free(final as void*)
            if not ok:
                _set_error("Failed to start drag helper")
                ret false
            end
            ret _ok()
        end
        _set_error("Text/URI drag-source initiation is not implemented for Linux fallback; use toolkit integration")
        ret false
    end

    _set_error(Note())
    ret false
end

@en "StartDragFiles"
@fa "آغاز کشیدن پرونده‌ها"
pub func StartDragFiles(native: void*, files: Vector<str>, options: DragOptions = DragOptions {}): bool:
    p := NewFilesPayload(files)
    ok := StartDrag(native, p, options)
    p.files.Free()
    ret ok
end

@en "StartDragText"
@fa "آغاز کشیدن متن"
pub func StartDragText(native: void*, text: str, options: DragOptions = DragOptions {}): bool:
    p := NewTextPayload(text)
    ok := StartDrag(native, p, options)
    mem.Free(p.text as void*)
    ret ok
end

@en "StartDragURI"
@fa "آغاز کشیدن نشانی"
pub func StartDragURI(native: void*, uri: str, options: DragOptions = DragOptions {}): bool:
    p := NewURIPayload(uri)
    ok := StartDrag(native, p, options)
    mem.Free(p.uri as void*)
    ret ok
end

@en "StartDragImagePath"
@fa "آغاز کشیدن مسیر تصویر"
pub func StartDragImagePath(native: void*, path: str, mime: str = "", options: DragOptions = DragOptions {}): bool:
    p := NewImagePathPayload(path, mime)
    ok := StartDrag(native, p, options)
    mem.Free(p.image_path as void*)
    mem.Free(p.mime as void*)
    ret ok
end
