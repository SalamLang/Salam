@en "flow"
@fa "چیدمان"
package flow

@en "LEN_FIXED"
@fa "درازای‌ثابت"
pub const LEN_FIXED := 0
@en "LEN_AUTO"
@fa "درازای‌خودکار"
pub const LEN_AUTO := 1
@en "LEN_FILL"
@fa "درازای‌پرکننده"
pub const LEN_FILL := 2
@en "LEN_FIT"
@fa "درازای‌اندازه‌محتوا"
pub const LEN_FIT := 3
@en "LEN_MIN_CONTENT"
@fa "درازای‌کمینه‌محتوا"
pub const LEN_MIN_CONTENT := 4
@en "LEN_MAX_CONTENT"
@fa "درازای‌بیشینه‌محتوا"
pub const LEN_MAX_CONTENT := 5
@en "LEN_NONE"
@fa "درازای‌تهی"
pub const LEN_NONE := 6

@en "LAYOUT_COLUMN"
@fa "چینش‌ستونی"
pub const LAYOUT_COLUMN := 0
@en "LAYOUT_ROW"
@fa "چینش‌سطری"
pub const LAYOUT_ROW := 1
@en "LAYOUT_GRID"
@fa "چینش‌شبکه‌ای"
pub const LAYOUT_GRID := 2
@en "LAYOUT_STACK"
@fa "چینش‌پشته‌ای"
pub const LAYOUT_STACK := 3
@en "LAYOUT_FLOW"
@fa "چینش‌جریانی"
pub const LAYOUT_FLOW := 4

@en "ALIGN_AUTO"
@fa "تراز‌خودکار"
pub const ALIGN_AUTO := 0
@en "ALIGN_START"
@fa "تراز‌آغاز"
pub const ALIGN_START := 1
@en "ALIGN_CENTER"
@fa "تراز‌وسط"
pub const ALIGN_CENTER := 2
@en "ALIGN_END"
@fa "تراز‌انتها"
pub const ALIGN_END := 3
@en "ALIGN_STRETCH"
@fa "تراز‌کشیده"
pub const ALIGN_STRETCH := 4
@en "ALIGN_BASELINE"
@fa "تراز‌خط‌پایه"
pub const ALIGN_BASELINE := 5
@en "ALIGN_BETWEEN"
@fa "تراز‌فاصله‌میانی"
pub const ALIGN_BETWEEN := 6
@en "ALIGN_AROUND"
@fa "تراز‌فاصله‌پیرامون"
pub const ALIGN_AROUND := 7
@en "ALIGN_EVENLY"
@fa "تراز‌فاصله‌یکسان"
pub const ALIGN_EVENLY := 8

@en "POS_NORMAL"
@fa "جایگاه‌عادی"
pub const POS_NORMAL := 0
@en "POS_ABSOLUTE"
@fa "جایگاه‌مطلق"
pub const POS_ABSOLUTE := 1
@en "POS_FIXED"
@fa "جایگاه‌ثابت"
pub const POS_FIXED := 2
@en "POS_STICKY"
@fa "جایگاه‌چسبان"
pub const POS_STICKY := 3

@en "OVERFLOW_VISIBLE"
@fa "سرریز‌پیدا"
pub const OVERFLOW_VISIBLE := 0
@en "OVERFLOW_HIDDEN"
@fa "سرریز‌پنهان"
pub const OVERFLOW_HIDDEN := 1
@en "OVERFLOW_SCROLL"
@fa "سرریز‌پیمایش"
pub const OVERFLOW_SCROLL := 2
@en "OVERFLOW_AUTO"
@fa "سرریز‌خودکار"
pub const OVERFLOW_AUTO := 3

@en "DIR_INHERIT"
@fa "جهت‌موروثی"
pub const DIR_INHERIT := 0
@en "DIR_LTR"
@fa "جهت‌چپ‌به‌راست"
pub const DIR_LTR := 1
@en "DIR_RTL"
@fa "جهت‌راست‌به‌چپ"
pub const DIR_RTL := 2

@en "AUTO_FLOW_ROW"
@fa "جریان‌سطری"
pub const AUTO_FLOW_ROW := 0
@en "AUTO_FLOW_COLUMN"
@fa "جریان‌ستونی"
pub const AUTO_FLOW_COLUMN := 1
@en "AUTO_FLOW_ROW_DENSE"
@fa "جریان‌سطری‌فشرده"
pub const AUTO_FLOW_ROW_DENSE := 2
@en "AUTO_FLOW_COLUMN_DENSE"
@fa "جریان‌ستونی‌فشرده"
pub const AUTO_FLOW_COLUMN_DENSE := 3

@en "TEXT_START"
@fa "متن‌از‌آغاز"
pub const TEXT_START := 0
@en "TEXT_CENTER"
@fa "متن‌وسط"
pub const TEXT_CENTER := 1
@en "TEXT_END"
@fa "متن‌از‌انتها"
pub const TEXT_END := 2
@en "TEXT_JUSTIFY"
@fa "متن‌تمام‌چین"
pub const TEXT_JUSTIFY := 3
@en "TEXT_LEFT"
@fa "متن‌چپ"
pub const TEXT_LEFT := 4
@en "TEXT_RIGHT"
@fa "متن‌راست"
pub const TEXT_RIGHT := 5

@en "REPEAT_FILL"
@fa "تکرار‌پرکننده"
pub const REPEAT_FILL := -1
@en "REPEAT_FIT"
@fa "تکرار‌اندازه‌محتوا"
pub const REPEAT_FIT := -2

const _UNK := -1.0
const _AV_MAX := -1.0
const _AV_MIN := -2.0
const _INF := 1.0e300
const _EPS := 0.000001

@en "Len"
@fa "درازا"
pub struct Len:
    @en "px"
    @fa "پیکسل"
    pub px: f64 = 0.0
    @en "pct"
    @fa "درصد"
    pub pct: f64 = 0.0
    @en "kind"
    @fa "نوع"
    pub kind: int = 0
end

@en "Size"
@fa "ابعاد"
pub struct Size:
    @en "w"
    @fa "پهنا"
    pub w: f64 = 0.0
    @en "h"
    @fa "بلندی"
    pub h: f64 = 0.0
    @en "baseline"
    @fa "خط پایه"
    pub baseline: f64 = -1.0
end

@en "Edges"
@fa "لبه‌ها"
pub struct Edges:
    @en "top"
    @fa "بالا"
    pub top: Len = Len { kind = LEN_NONE }
    @en "end"
    @fa "انتها"
    pub end: Len = Len { kind = LEN_NONE }
    @en "bottom"
    @fa "پایین"
    pub bottom: Len = Len { kind = LEN_NONE }
    @en "start"
    @fa "آغاز"
    pub start: Len = Len { kind = LEN_NONE }
    @en "left"
    @fa "چپ"
    pub left: Len = Len { kind = LEN_NONE }
    @en "right"
    @fa "راست"
    pub right: Len = Len { kind = LEN_NONE }
end

@en "Track"
@fa "شیار"
pub struct Track:
    @en "min"
    @fa "کمینه"
    pub min: Len = Len { kind = LEN_AUTO }
    @en "max"
    @fa "بیشینه"
    pub max: Len = Len { kind = LEN_AUTO }
    @en "fr"
    @fa "سهم"
    pub fr: f64 = 0.0
    @en "fit"
    @fa "اندازه محتوا"
    pub fit: bool = false
    @en "count"
    @fa "شمار تکرار"
    pub count: int = 0
    @en "tracks"
    @fa "شیارها"
    pub tracks: Vector<Track> = Vector {}
end

@en "FlowStyle"
@fa "سبک چیدمان"
pub struct FlowStyle:
    @en "layout"
    @fa "چینش"
    pub layout: int = LAYOUT_COLUMN
    @en "row_gap"
    @fa "فاصله سطرها"
    pub row_gap: Len = Len {}
    @en "column_gap"
    @fa "فاصله ستون‌ها"
    pub column_gap: Len = Len {}
    @en "align"
    @fa "تراز"
    pub align: int = ALIGN_STRETCH
    @en "justify"
    @fa "پخش"
    pub justify: int = ALIGN_START
    @en "align_content"
    @fa "تراز محتوا"
    pub align_content: int = ALIGN_START
    @en "wrap"
    @fa "شکستن"
    pub wrap: bool = false
    @en "reverse"
    @fa "برعکس"
    pub reverse: bool = false
    @en "columns"
    @fa "ستون‌ها"
    pub columns: Vector<Track> = Vector {}
    @en "rows"
    @fa "سطرها"
    pub rows: Vector<Track> = Vector {}
    @en "auto_columns"
    @fa "ستون‌های خودکار"
    pub auto_columns: Track = Track {}
    @en "auto_rows"
    @fa "سطرهای خودکار"
    pub auto_rows: Track = Track {}
    @en "auto_flow"
    @fa "جریان خودکار"
    pub auto_flow: int = AUTO_FLOW_ROW
    @en "grow"
    @fa "رشد"
    pub grow: f64 = 0.0
    @en "shrink"
    @fa "کاهش"
    pub shrink: f64 = 1.0
    @en "basis"
    @fa "پایه"
    pub basis: Len = Len { kind = LEN_AUTO }
    @en "align_self"
    @fa "تراز اختصاصی"
    pub align_self: int = ALIGN_AUTO
    @en "justify_self"
    @fa "پخش اختصاصی"
    pub justify_self: int = ALIGN_AUTO
    @en "column"
    @fa "ستون"
    pub column: int = 0
    @en "row"
    @fa "سطر"
    pub row: int = 0
    @en "column_span"
    @fa "گستره ستون"
    pub column_span: int = 1
    @en "row_span"
    @fa "گستره سطر"
    pub row_span: int = 1
    @en "order"
    @fa "ترتیب"
    pub order: int = 0
    @en "position"
    @fa "جایگاه"
    pub position: int = POS_NORMAL
    @en "inset"
    @fa "فاصله جایگاه"
    pub inset: Edges = Edges {}
    @en "layer"
    @fa "لایه"
    pub layer: int = 0
    @en "width"
    @fa "پهنا"
    pub width: Len = Len { kind = LEN_AUTO }
    @en "height"
    @fa "بلندی"
    pub height: Len = Len { kind = LEN_AUTO }
    @en "min_width"
    @fa "کمینه پهنا"
    pub min_width: Len = Len { kind = LEN_AUTO }
    @en "min_height"
    @fa "کمینه بلندی"
    pub min_height: Len = Len { kind = LEN_AUTO }
    @en "max_width"
    @fa "بیشینه پهنا"
    pub max_width: Len = Len { kind = LEN_NONE }
    @en "max_height"
    @fa "بیشینه بلندی"
    pub max_height: Len = Len { kind = LEN_NONE }
    @en "aspect_ratio"
    @fa "نسبت ابعاد"
    pub aspect_ratio: f64 = 0.0
    @en "padding"
    @fa "فاصله درونی"
    pub padding: Edges = Edges {}
    @en "margin"
    @fa "فاصله بیرونی"
    pub margin: Edges = Edges {}
    @en "border"
    @fa "پهنای مرز"
    pub border: Edges = Edges {}
    @en "overflow_x"
    @fa "سرریز افقی"
    pub overflow_x: int = OVERFLOW_VISIBLE
    @en "overflow_y"
    @fa "سرریز عمودی"
    pub overflow_y: int = OVERFLOW_VISIBLE
    @en "visible"
    @fa "پیدا"
    pub visible: bool = true
    @en "direction"
    @fa "جهت"
    pub direction: int = DIR_INHERIT
    @en "text_align"
    @fa "تراز متن"
    pub text_align: int = TEXT_START
end

@en "Px"
@fa "پیکسلی"
pub func Px(v: f64): Len:
    ret Len { px = v, kind = LEN_FIXED }
end

@en "Pct"
@fa "درصدی"
pub func Pct(fraction: f64): Len:
    ret Len { pct = fraction, kind = LEN_FIXED }
end

@en "PxPct"
@fa "پیکسل باضافه درصد"
pub func PxPct(v: f64, fraction: f64): Len:
    ret Len { px = v, pct = fraction, kind = LEN_FIXED }
end

@en "Auto"
@fa "خودکار"
pub func Auto(): Len:
    ret Len { kind = LEN_AUTO }
end

@en "Fill"
@fa "پرکننده"
pub func Fill(): Len:
    ret Len { kind = LEN_FILL }
end

@en "Fit"
@fa "به اندازه محتوا"
pub func Fit(): Len:
    ret Len { kind = LEN_FIT }
end

@en "MinContent"
@fa "کمینه محتوا"
pub func MinContent(): Len:
    ret Len { kind = LEN_MIN_CONTENT }
end

@en "MaxContent"
@fa "بیشینه محتوا"
pub func MaxContent(): Len:
    ret Len { kind = LEN_MAX_CONTENT }
end

@en "NoLimit"
@fa "بی‌حد"
pub func NoLimit(): Len:
    ret Len { kind = LEN_NONE }
end

@en "All"
@fa "همه لبه‌ها"
pub func All(v: Len): Edges:
    ret Edges { top = v, end = v, bottom = v, start = v }
end

@en "Sides"
@fa "چهار لبه"
pub func Sides(top: Len, trailing: Len, bottom: Len, leading: Len): Edges:
    ret Edges { top = top, end = trailing, bottom = bottom, start = leading }
end

@en "TrackLen"
@fa "شیار با درازا"
pub func TrackLen(v: Len): Track:
    ret Track { min = v, max = v }
end

@en "TrackFr"
@fa "شیار سهمی"
pub func TrackFr(fr: f64): Track:
    ret Track { fr = fr }
end

@en "TrackAuto"
@fa "شیار خودکار"
pub func TrackAuto(): Track:
    ret Track {}
end

@en "TrackMinMax"
@fa "شیار کمینه بیشینه"
pub func TrackMinMax(lo: Track, hi: Track): Track:
    mut lo_len := lo.min
    if lo.fr > 0.0:
        lo_len = Len { kind = LEN_AUTO }
    end
    ret Track { min = lo_len, max = hi.max, fr = hi.fr, fit = hi.fit }
end

@en "TrackFit"
@fa "شیار اندازه محتوا"
pub func TrackFit(limit: Len): Track:
    ret Track { max = limit, fit = true }
end

@en "Repeat"
@fa "شیارهای تکراری"
pub func Repeat(count: int, tracks: Vector<Track>): Track:
    ret Track { count = count, tracks = tracks }
end
