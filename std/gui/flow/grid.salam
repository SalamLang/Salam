package flow

func _grid_intrinsic(t &: Eng, id: int, minmode: bool): f64:
    if minmode:
        ret t.nodes.ref(id).w
    end
    ret 0.0
end

func _grid(t &: Eng, id: int, kw: f64, kh: f64, minh: f64, maxh: f64, bx: Box, final: bool): Out:
    if final or t.nodes.ref(id).dirty:
        ret Out { w = kw, h = _clamp(kh, minh, maxh) }
    end
    ret Out { w = kw, h = bx.pt + bx.pb }
end
