package flow

const _K_FLEX := 10

struct GTrack:
    pub minf: Len = Len { kind = LEN_AUTO }
    pub maxf: Len = Len { kind = LEN_AUTO }
    pub fr: f64 = 0.0
    pub fit: bool = false
    pub autofit: bool = false
    pub collapsed: bool = false
    pub base: f64 = 0.0
    pub limit: f64 = 0.0
    pub pos: f64 = 0.0
end

struct GItem:
    pub id: int = 0
    pub order: int = 0
    pub c0: int = -1
    pub cs: int = 1
    pub r0: int = -1
    pub rs: int = 1
    pub minc: f64 = 0.0
    pub maxc: f64 = 0.0
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub bl: f64 = 0.0
    pub al: int = 0
    pub js: int = 0
end

func _gt_from(tr: Track, autofit: bool): GTrack:
    ret GTrack { minf = tr.min, maxf = tr.max, fr = tr.fr, fit = tr.fit, autofit = autofit }
end

func _lenv(l: Len, ref: f64): f64:
    if l.kind != LEN_FIXED:
        ret _UNK
    end
    if l.pct != 0.0 and ref < 0.0:
        ret _UNK
    end
    ret _max(0.0, l.px + l.pct * _max(ref, 0.0))
end

func _track_fixed(tr: Track, ref: f64): f64:
    if tr.fr <= 0.0 and not tr.fit:
        v := _lenv(tr.max, ref)
        if v >= 0.0:
            ret v
        end
    end
    v := _lenv(tr.min, ref)
    if v >= 0.0:
        ret v
    end
    ret 0.0
end

func _expand(list: Vector<Track>, avail: f64, gap: f64, out &: Vector<GTrack>):
    mut others := 0.0
    mut ocount := 0
    mut rep := -1
    repeat list.Len() in i:
        tr := list.get(i)
        if tr.count < 0:
            if rep < 0:
                rep = i
            end
        else tr.count > 0:
            repeat tr.count:
                each inner in tr.tracks:
                    others += _track_fixed(inner, avail)
                    ocount++
                end
            end
        else:
            others += _track_fixed(tr, avail)
            ocount++
        end
    end
    mut reps := 1
    if rep >= 0 and avail >= 0.0:
        rt := list.get(rep)
        k := rt.tracks.Len()
        mut rsum := 0.0
        each inner in rt.tracks:
            rsum += _track_fixed(inner, avail)
        end
        per := rsum + gap * (k as f64)
        room := avail - others - gap * ((ocount - 1) as f64)
        if k > 0 and per > 0.0 and room > 0.0:
            reps = (room / per) as int
        end
        if reps < 1:
            reps = 1
        end
    end
    each tr in list:
        if tr.count > 0:
            repeat tr.count:
                each inner in tr.tracks:
                    out.push(_gt_from(inner, false))
                end
            end
        else tr.count < 0:
            repeat reps:
                each inner in tr.tracks:
                    out.push(_gt_from(inner, tr.count == REPEAT_FIT))
                end
            end
        else:
            out.push(_gt_from(tr, false))
        end
    end
end

func _min_kind(minf: Len, ref: f64): int:
    k := minf.kind
    if k == LEN_FIXED:
        if _lenv(minf, ref) >= 0.0:
            ret LEN_FIXED
        end
        ret LEN_AUTO
    end
    if k == LEN_MIN_CONTENT or k == LEN_MAX_CONTENT:
        ret k
    end
    ret LEN_AUTO
end

func _max_kind(fr: f64, fit: bool, maxf: Len, ref: f64): int:
    if fr > 0.0:
        ret _K_FLEX
    end
    k := maxf.kind
    if fit:
        if _lenv(maxf, ref) >= 0.0:
            ret LEN_FIT
        end
        ret LEN_MAX_CONTENT
    end
    if k == LEN_FIXED:
        if _lenv(maxf, ref) >= 0.0:
            ret LEN_FIXED
        end
        ret LEN_AUTO
    end
    if k == LEN_MIN_CONTENT or k == LEN_MAX_CONTENT:
        ret k
    end
    ret LEN_AUTO
end

func _line_start(line: int, span: int, explicit: int): int:
    if line > 0:
        ret line - 1
    end
    if line < 0:
        s := explicit + 1 + line - span
        if s < 0:
            ret 0
        end
        ret s
    end
    ret -1
end

func _occ_free(occ &: Vector<bool>, nmn: int, mj: int, mn: int, mjs: int, mns: int): bool:
    if mn < 0 or mn + mns > nmn:
        ret false
    end
    repeat mjs in a:
        row := mj + a
        if row * nmn >= occ.Len():
            continue
        end
        repeat mns in b:
            if occ.get(row * nmn + mn + b):
                ret false
            end
        end
    end
    ret true
end

func _occ_mark(occ &: Vector<bool>, nmn: int, mj: int, mn: int, mjs: int, mns: int):
    until occ.Len() < (mj + mjs) * nmn:
        occ.push(false)
    end
    repeat mjs in a:
        repeat mns in b:
            c := mn + b
            if c < nmn:
                occ.set((mj + a) * nmn + c, true)
            end
        end
    end
end

func _grid_place(t &: Eng, id: int, items &: Vector<GItem>, ec: int, er: int): (int, int):
    n := t.nodes.ref(id)
    colflow := n.st.auto_flow == AUTO_FLOW_COLUMN or n.st.auto_flow == AUTO_FLOW_COLUMN_DENSE
    dense := n.st.auto_flow == AUTO_FLOW_ROW_DENSE or n.st.auto_flow == AUTO_FLOW_COLUMN_DENSE
    mut nmn := ec
    if colflow:
        nmn = er
    end
    each it in items:
        mut mn := it.c0
        mut mns := it.cs
        if colflow:
            mn = it.r0
            mns = it.rs
        end
        if mn >= 0:
            if mn + mns > nmn:
                nmn = mn + mns
            end
        else mns > nmn:
            nmn = mns
        end
    end
    if nmn < 1:
        nmn = 1
    end
    mut occ := Vector {} as Vector<bool>
    defer occ.Free()
    mut cursor := Vector {} as Vector<int>
    defer cursor.Free()
    repeat items.Len() in i:
        it := items.ref(i)
        if it.c0 >= 0 and it.r0 >= 0:
            if colflow:
                _occ_mark(occ, nmn, it.c0, it.r0, it.cs, it.rs)
            else:
                _occ_mark(occ, nmn, it.r0, it.c0, it.rs, it.cs)
            end
        end
    end
    repeat items.Len() in i:
        it := items.ref(i)
        mut mj := it.r0
        mut mn := it.c0
        mut mjs := it.rs
        mut mns := it.cs
        if colflow:
            mj = it.c0
            mn = it.r0
            mjs = it.cs
            mns = it.rs
        end
        if mj < 0 or mn >= 0:
            continue
        end
        until cursor.Len() <= mj:
            cursor.push(0)
        end
        mut c := cursor.get(mj)
        if dense:
            c = 0
        end
        until c + mns <= nmn and not _occ_free(occ, nmn, mj, c, mjs, mns):
            c++
        end
        if c + mns > nmn:
            c = 0
        end
        _occ_mark(occ, nmn, mj, c, mjs, mns)
        cursor.set(mj, c + mns)
        if colflow:
            it.r0 = c
        else:
            it.c0 = c
        end
    end
    mut cmj := 0
    mut cmn := 0
    repeat items.Len() in i:
        it := items.ref(i)
        mut mj := it.r0
        mut mn := it.c0
        mut mjs := it.rs
        mut mns := it.cs
        if colflow:
            mj = it.c0
            mn = it.r0
            mjs = it.cs
            mns = it.rs
        end
        if mj >= 0:
            continue
        end
        if dense:
            cmj = 0
            cmn = 0
        end
        if mn >= 0:
            if not dense and mn < cmn:
                cmj++
            end
            cmn = mn
            until not _occ_free(occ, nmn, cmj, mn, mjs, mns):
                cmj++
            end
        else:
            until true:
                if cmn + mns > nmn:
                    cmj++
                    cmn = 0
                    continue
                end
                if _occ_free(occ, nmn, cmj, cmn, mjs, mns):
                    break
                end
                cmn++
            end
        end
        _occ_mark(occ, nmn, cmj, cmn, mjs, mns)
        if colflow:
            it.c0 = cmj
            it.r0 = cmn
        else:
            it.r0 = cmj
            it.c0 = cmn
        end
        cmn += mns
    end
    mut ncols := nmn
    mut nrows := er
    if colflow:
        ncols = ec
        nrows = nmn
    end
    each it in items:
        if it.c0 + it.cs > ncols:
            ncols = it.c0 + it.cs
        end
        if it.r0 + it.rs > nrows:
            nrows = it.r0 + it.rs
        end
    end
    ret ncols, nrows
end

func _gaps(tracks &: Vector<GTrack>, gap: f64): f64:
    mut n := 0
    each tr in tracks:
        if not tr.collapsed:
            n++
        end
    end
    if n < 2:
        ret 0.0
    end
    ret gap * ((n - 1) as f64)
end

func _span_of(it: GItem, cols: bool): (int, int):
    if cols:
        ret it.c0, it.cs
    end
    ret it.r0, it.rs
end

func _size_axis(tracks &: Vector<GTrack>, items &: Vector<GItem>, cols: bool, avail: f64, gap: f64, stretch: bool):
    nt := tracks.Len()
    if nt == 0:
        ret
    end
    ref := avail
    repeat nt in i:
        tr := tracks.ref(i)
        if tr.collapsed:
            tr.base = 0.0
            tr.limit = 0.0
            continue
        end
        mut b := 0.0
        if _min_kind(tr.minf, ref) == LEN_FIXED:
            b = _lenv(tr.minf, ref)
        end
        tr.base = b
        mut l := _INF
        if _max_kind(tr.fr, tr.fit, tr.maxf, ref) == LEN_FIXED:
            l = _max(b, _lenv(tr.maxf, ref))
        end
        tr.limit = l
    end
    mut maxspan := 1
    each it in items:
        _, sp := _span_of(it, cols)
        if sp > maxspan:
            maxspan = sp
        end
    end
    repeat maxspan in si:
        span := si + 1
        each it in items:
            s0, sp := _span_of(it, cols)
            if sp != span or s0 < 0 or s0 + sp > nt:
                continue
            end
            mut flex := false
            repeat sp in k:
                if tracks.get(s0 + k).fr > 0.0:
                    flex = true
                end
            end
            if flex:
                continue
            end
            mut minc := it.minc
            if avail == _AV_MAX:
                minc = it.maxc
            end
            if sp == 1:
                tr := tracks.ref(s0)
                if tr.collapsed:
                    continue
                end
                mk := _min_kind(tr.minf, ref)
                if mk == LEN_AUTO or mk == LEN_MIN_CONTENT:
                    tr.base = _max(tr.base, minc)
                else mk == LEN_MAX_CONTENT:
                    tr.base = _max(tr.base, it.maxc)
                end
                xk := _max_kind(tr.fr, tr.fit, tr.maxf, ref)
                if xk != LEN_FIXED:
                    mut c := it.maxc
                    if xk == LEN_MIN_CONTENT:
                        c = it.minc
                    else xk == LEN_FIT:
                        c = _min(it.maxc, _lenv(tr.maxf, ref))
                    end
                    if tr.limit >= _INF:
                        tr.limit = c
                    else:
                        tr.limit = _max(tr.limit, c)
                    end
                end
            else:
                mut sumb := gap * ((sp - 1) as f64)
                mut nint := 0
                mut suml := gap * ((sp - 1) as f64)
                mut nx := 0
                repeat sp in k:
                    tr := tracks.get(s0 + k)
                    sumb += tr.base
                    if _min_kind(tr.minf, ref) != LEN_FIXED:
                        nint++
                    end
                    if tr.limit >= _INF:
                        suml += tr.base
                    else:
                        suml += tr.limit
                    end
                    if _max_kind(tr.fr, tr.fit, tr.maxf, ref) != LEN_FIXED:
                        nx++
                    end
                end
                need := minc - sumb
                if need > 0.0 and nint > 0:
                    repeat sp in k:
                        tr := tracks.ref(s0 + k)
                        if _min_kind(tr.minf, ref) != LEN_FIXED:
                            tr.base += need / (nint as f64)
                        end
                    end
                end
                need2 := it.maxc - suml
                repeat sp in k:
                    tr := tracks.ref(s0 + k)
                    if _max_kind(tr.fr, tr.fit, tr.maxf, ref) != LEN_FIXED:
                        mut cur := tr.limit
                        if cur >= _INF:
                            cur = tr.base
                        end
                        if need2 > 0.0 and nx > 0:
                            cur += need2 / (nx as f64)
                        end
                        tr.limit = cur
                    end
                end
            end
        end
    end
    repeat nt in i:
        tr := tracks.ref(i)
        if tr.fr <= 0.0 and tr.limit >= _INF:
            tr.limit = tr.base
        end
        if tr.limit < tr.base:
            tr.limit = tr.base
        end
    end
    mut anyflex := false
    each tr in tracks:
        if tr.fr > 0.0 and not tr.collapsed:
            anyflex = true
        end
    end
    if anyflex:
        each it in items:
            s0, sp := _span_of(it, cols)
            if s0 < 0 or s0 + sp > nt:
                continue
            end
            mut sumb := gap * ((sp - 1) as f64)
            mut nf := 0
            repeat sp in k:
                tr := tracks.get(s0 + k)
                sumb += tr.base
                if tr.fr > 0.0 and _min_kind(tr.minf, ref) != LEN_FIXED:
                    nf++
                end
            end
            need := it.minc - sumb
            if need > 0.0 and nf > 0:
                repeat sp in k:
                    tr := tracks.ref(s0 + k)
                    if tr.fr > 0.0 and _min_kind(tr.minf, ref) != LEN_FIXED:
                        tr.base += need / (nf as f64)
                    end
                end
            end
        end
    end
    gaps := _gaps(tracks, gap)
    if avail >= 0.0:
        mut free := avail - gaps
        each tr in tracks:
            free -= tr.base
        end
        mut guard := 0
        until free > _EPS and guard <= nt:
            guard++
            mut cand := 0
            each tr in tracks:
                if tr.fr <= 0.0 and not tr.collapsed and tr.base < tr.limit - _EPS:
                    cand++
                end
            end
            if cand == 0:
                break
            end
            share := free / (cand as f64)
            repeat nt in i:
                tr := tracks.ref(i)
                if tr.fr <= 0.0 and not tr.collapsed and tr.base < tr.limit - _EPS:
                    add := _min(share, tr.limit - tr.base)
                    tr.base += add
                    free -= add
                end
            end
        end
    else avail == _AV_MAX:
        repeat nt in i:
            tr := tracks.ref(i)
            if tr.fr <= 0.0:
                tr.base = _max(tr.base, tr.limit)
            end
        end
    end
    if anyflex:
        if avail >= 0.0:
            mut inflex := Vector {} as Vector<bool>
            defer inflex.Free()
            repeat nt:
                inflex.push(false)
            end
            mut leftover := avail - gaps
            each tr in tracks:
                if tr.fr <= 0.0:
                    leftover -= tr.base
                end
            end
            mut guard := 0
            until guard <= nt:
                guard++
                mut sumfr := 0.0
                mut lo := leftover
                repeat nt in i:
                    tr := tracks.get(i)
                    if tr.fr > 0.0 and not tr.collapsed:
                        if inflex.get(i):
                            lo -= tr.base
                        else:
                            sumfr += tr.fr
                        end
                    end
                end
                hyp := _max(0.0, lo) / _max(1.0, sumfr)
                mut changed := false
                repeat nt in i:
                    tr := tracks.get(i)
                    if tr.fr > 0.0 and not tr.collapsed and not inflex.get(i) and tr.base > hyp * tr.fr:
                        inflex.set(i, true)
                        changed = true
                    end
                end
                if not changed:
                    repeat nt in i:
                        tr := tracks.ref(i)
                        if tr.fr > 0.0 and not tr.collapsed and not inflex.get(i):
                            tr.base = _max(tr.base, hyp * tr.fr)
                        end
                    end
                    break
                end
            end
        else:
            mut frac := 0.0
            each tr in tracks:
                if tr.fr > 0.0 and not tr.collapsed:
                    if tr.fr > 1.0:
                        frac = _max(frac, tr.base / tr.fr)
                    else:
                        frac = _max(frac, tr.base)
                    end
                end
            end
            each it in items:
                s0, sp := _span_of(it, cols)
                if s0 < 0 or s0 + sp > nt:
                    continue
                end
                mut c := it.maxc
                if avail == _AV_MIN:
                    c = it.minc
                end
                mut rest := c - gap * ((sp - 1) as f64)
                mut sfr := 0.0
                repeat sp in k:
                    tr := tracks.get(s0 + k)
                    if tr.fr > 0.0:
                        sfr += tr.fr
                    else:
                        rest -= tr.base
                    end
                end
                if sfr > 0.0:
                    frac = _max(frac, rest / _max(1.0, sfr))
                end
            end
            repeat nt in i:
                tr := tracks.ref(i)
                if tr.fr > 0.0 and not tr.collapsed:
                    tr.base = _max(tr.base, frac * tr.fr)
                end
            end
        end
    end
    if stretch and avail >= 0.0:
        mut free := avail - gaps
        mut autos := 0
        each tr in tracks:
            free -= tr.base
            if tr.fr <= 0.0 and not tr.collapsed and _max_kind(tr.fr, tr.fit, tr.maxf, ref) == LEN_AUTO:
                autos++
            end
        end
        if free > 0.0 and autos > 0:
            repeat nt in i:
                tr := tracks.ref(i)
                if tr.fr <= 0.0 and not tr.collapsed and _max_kind(tr.fr, tr.fit, tr.maxf, ref) == LEN_AUTO:
                    tr.base += free / (autos as f64)
                end
            end
        end
    end
end

func _positions(tracks &: Vector<GTrack>, avail: f64, gap: f64, mode: int): f64:
    mut n := 0
    mut sum := 0.0
    each tr in tracks:
        if not tr.collapsed:
            n++
            sum += tr.base
        end
    end
    if n > 1:
        sum += gap * ((n - 1) as f64)
    end
    mut free := 0.0
    if avail >= 0.0:
        free = avail - sum
    end
    mut m := mode
    if m == ALIGN_STRETCH:
        m = ALIGN_START
    end
    start, between := _distribute(m, free, n, gap)
    mut p := start
    repeat tracks.Len() in i:
        tr := tracks.ref(i)
        tr.pos = p
        if not tr.collapsed:
            p += tr.base + between
        end
    end
    ret sum
end

func _area(tracks &: Vector<GTrack>, s0: int, sp: int): (f64, f64):
    if s0 < 0 or tracks.Len() == 0:
        ret 0.0, 0.0
    end
    mut e := s0 + sp - 1
    if e >= tracks.Len():
        e = tracks.Len() - 1
    end
    a := tracks.get(s0).pos
    last := tracks.get(e)
    ret a, _max(0.0, last.pos + last.base - a)
end

func _grid_setup(t &: Eng, id: int, inner_w: f64, inner_h: f64, cols &: Vector<GTrack>, rows &: Vector<GTrack>, items &: Vector<GItem>):
    n := t.nodes.ref(id)
    cg := _gap(n.st.column_gap, inner_w)
    rg := _gap(n.st.row_gap, inner_h)
    _expand(n.st.columns, inner_w, cg, cols)
    mut rh := inner_h
    if rh < 0.0:
        rh = _UNK
    end
    _expand(n.st.rows, rh, rg, rows)
    ec := cols.Len()
    er := rows.Len()
    each k in n.kids:
        kn := t.nodes.ref(k)
        if not _in_flow(kn):
            continue
        end
        mut cs := kn.st.column_span
        if cs < 1:
            cs = 1
        end
        mut rs := kn.st.row_span
        if rs < 1:
            rs = 1
        end
        items.push(GItem { id = k, order = kn.st.order, cs = cs, rs = rs, c0 = _line_start(kn.st.column, cs, ec), r0 = _line_start(kn.st.row, rs, er) })
    end
    mut i := 1
    until i < items.Len():
        cur := items.get(i)
        mut j := i
        until j > 0 and items.get(j - 1).order > cur.order:
            items.set(j, items.get(j - 1))
            j--
        end
        items.set(j, cur)
        i++
    end
    nc, nr := _grid_place(t, id, items, ec, er)
    n2 := t.nodes.ref(id)
    until cols.Len() < nc:
        cols.push(_gt_from(n2.st.auto_columns, false))
    end
    until rows.Len() < nr:
        rows.push(_gt_from(n2.st.auto_rows, false))
    end
    each it in items:
        repeat it.cs in k:
            c := cols.ref(it.c0 + k)
            c.autofit = false
        end
        repeat it.rs in k:
            r := rows.ref(it.r0 + k)
            r.autofit = false
        end
    end
    repeat cols.Len() in ci:
        c := cols.ref(ci)
        c.collapsed = c.autofit
    end
    repeat rows.Len() in ri:
        r := rows.ref(ri)
        r.collapsed = r.autofit
    end
end

func _grid_intrinsic(t &: Eng, id: int, minmode: bool): f64:
    mut cols := Vector {} as Vector<GTrack>
    defer cols.Free()
    mut rows := Vector {} as Vector<GTrack>
    defer rows.Free()
    mut items := Vector {} as Vector<GItem>
    defer items.Free()
    _grid_setup(t, id, _UNK, _UNK, cols, rows, items)
    repeat items.Len() in i:
        it := items.ref(i)
        it.minc = _contrib(t, it.id, true)
        it.maxc = _contrib(t, it.id, false)
    end
    mut a := _AV_MAX
    if minmode:
        a = _AV_MIN
    end
    cg := _gap(t.nodes.ref(id).st.column_gap, _UNK)
    _size_axis(cols, items, true, a, cg, false)
    mut sum := _gaps(cols, cg)
    each c in cols:
        sum += c.base
    end
    ret sum
end

func _grid(t &: Eng, id: int, kw: f64, kh: f64, minh: f64, maxh: f64, bx: Box, final: bool): Out:
    n := t.nodes.ref(id)
    rtl := n.rtl
    inner_w := _max(0.0, kw - bx.pl - bx.pr)
    pby := bx.pt + bx.pb
    mut inner_h := _UNK
    if kh >= 0.0:
        inner_h = _max(0.0, kh - pby)
    end
    mut cols := Vector {} as Vector<GTrack>
    defer cols.Free()
    mut rows := Vector {} as Vector<GTrack>
    defer rows.Free()
    mut items := Vector {} as Vector<GItem>
    defer items.Free()
    _grid_setup(t, id, inner_w, inner_h, cols, rows, items)
    n2 := t.nodes.ref(id)
    cg := _gap(n2.st.column_gap, inner_w)
    rg := _gap(n2.st.row_gap, inner_h)
    align := n2.st.align
    justify := n2.st.justify
    acontent := n2.st.align_content
    repeat items.Len() in i:
        it := items.ref(i)
        it.minc = _contrib(t, it.id, true)
        it.maxc = _contrib(t, it.id, false)
    end
    _size_axis(cols, items, true, inner_w, cg, justify == ALIGN_STRETCH)
    _positions(cols, inner_w, cg, justify)
    repeat items.Len() in i:
        it := items.ref(i)
        _resolve_dir(t, it.id)
        _, aw := _area(cols, it.c0, it.cs)
        kb := _box(t, it.id, aw)
        kn := t.nodes.ref(it.id)
        mx := kb.ml + kb.mr
        my := kb.mt + kb.mb
        mut js := kn.st.justify_self
        if js == ALIGN_AUTO or (js != ALIGN_START and js != ALIGN_CENTER and js != ALIGN_END):
            js = ALIGN_STRETCH
        end
        it.js = js
        it.al = _self_align(kn.st.align_self, align)
        if js == ALIGN_STRETCH and kn.st.width.kind == LEN_AUTO and kn.st.aspect_ratio <= 0.0 and not kb.aml and not kb.amr:
            lo := _max(_min_len(t, it.id, kn.st.min_width, aw, mx, true), kb.pl + kb.pr)
            hi := _max_len(t, it.id, kn.st.max_width, aw, mx, true)
            it.w = _clamp(aw - mx, lo, hi)
        else:
            it.w = _compute(t, it.id, _UNK, _UNK, _max(0.0, aw - mx), aw, _UNK, false).w
        end
        o := _compute(t, it.id, it.w, _UNK, it.w, aw, _UNK, false)
        it.h = o.h
        it.bl = o.base
        it.minc = o.h + my
        it.maxc = o.h + my
    end
    stretch_rows := acontent == ALIGN_STRETCH
    _size_axis(rows, items, false, inner_h, rg, stretch_rows)
    mut used := _positions(rows, inner_h, rg, acontent)
    if inner_h < 0.0:
        inner_h = _max(0.0, _clamp(used + pby, minh, maxh) - pby)
        if inner_h > used + _EPS:
            _size_axis(rows, items, false, inner_h, rg, stretch_rows)
        end
        used = _positions(rows, inner_h, rg, acontent)
    end
    mut ascs := Vector {} as Vector<f64>
    defer ascs.Free()
    repeat rows.Len():
        ascs.push(0.0)
    end
    repeat items.Len() in i:
        it := items.ref(i)
        _, ah := _area(rows, it.r0, it.rs)
        kn := t.nodes.ref(it.id)
        _, aw := _area(cols, it.c0, it.cs)
        kb := _box(t, it.id, aw)
        my := kb.mt + kb.mb
        if it.al == ALIGN_STRETCH and kn.st.height.kind == LEN_AUTO and kn.st.aspect_ratio <= 0.0 and not kb.amt and not kb.amb:
            lo := _max(_min_len(t, it.id, kn.st.min_height, ah, my, false), kb.pt + kb.pb)
            hi := _max_len(t, it.id, kn.st.max_height, ah, my, false)
            nh := _clamp(ah - my, lo, hi)
            if nh != it.h:
                it.h = nh
                it.bl = _compute(t, it.id, it.w, nh, it.w, aw, ah, false).base
            end
        end
        if it.al == ALIGN_BASELINE and it.rs == 1:
            ascs.set(it.r0, _max(ascs.get(it.r0), kb.mt + it.bl))
        end
    end
    mut base := -1.0
    repeat items.Len() in i:
        it := items.ref(i)
        ax, aw := _area(cols, it.c0, it.cs)
        ay, ah := _area(rows, it.r0, it.rs)
        kb := _box(t, it.id, aw)
        mut ms := kb.ml
        mut ams := kb.aml
        mut ame := kb.amr
        if rtl:
            ms = kb.mr
            ams = kb.amr
            ame = kb.aml
        end
        mut x := ax + _place_in(it.js, aw - it.w - kb.ml - kb.mr, ms, ams, ame)
        if rtl:
            x = inner_w - x - it.w
        end
        mut y := 0.0
        if it.al == ALIGN_BASELINE and it.rs == 1:
            y = ay + ascs.get(it.r0) - it.bl
        else:
            y = ay + _place_in(it.al, ah - it.h - kb.mt - kb.mb, kb.mt, kb.amt, kb.amb)
        end
        if base < 0.0 and it.r0 == 0:
            base = bx.pt + y + it.bl
        end
        if final:
            _compute(t, it.id, it.w, it.h, it.w, aw, ah, true)
            kn := t.nodes.ref(it.id)
            kn.x = bx.pl + x
            kn.y = bx.pt + y
            kn.in_fixed = false
        end
    end
    ret Out { w = kw, h = used + pby, base = base }
end
