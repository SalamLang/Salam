inline func _mul8(c: u32, f: u32): u32:
    mut rb := (c & (0x00FF00FF as u32)) * f + (0x00800080 as u32)
    rb = ((rb + ((rb >> 8) & (0x00FF00FF as u32))) >> 8) & (0x00FF00FF as u32)
    mut ag := ((c >> 8) & (0x00FF00FF as u32)) * f + (0x00800080 as u32)
    ag = (ag + ((ag >> 8) & (0x00FF00FF as u32))) & (0xFF00FF00 as u32)
    ret rb | ag
end

inline func _over(dst: u32, src: u32): u32:
    ret src + _mul8(dst, (255 as u32) - (src >> 24))
end

inline func _div255(v: int): int:
    t := v + 128
    ret (t + (t >> 8)) >> 8
end

inline func _lerp_px(a: u32, b: u32, t: int): u32:
    ret _mul8(a, (255 - t) as u32) + _mul8(b, t as u32)
end

func _premul(c: Color): u32:
    a := _clamp255(c.a)
    r := _div255(_clamp255(c.r) * a)
    g := _div255(_clamp255(c.g) * a)
    b := _div255(_clamp255(c.b) * a)
    ret ((a as u32) << 24) | ((r as u32) << 16) | ((g as u32) << 8) | (b as u32)
end

inline func _clamp255(v: int): int:
    if v < 0:
        ret 0
    end
    if v > 255:
        ret 255
    end
    ret v
end

inline func _clampi(v: int, lo: int, hi: int): int:
    if v < lo:
        ret lo
    end
    if v > hi:
        ret hi
    end
    ret v
end

inline func _mini(a: int, b: int): int:
    ret a < b ? a : b
end

inline func _maxi(a: int, b: int): int:
    ret a > b ? a : b
end

inline func _minf(a: f64, b: f64): f64:
    ret a < b ? a : b
end

inline func _maxf(a: f64, b: f64): f64:
    ret a > b ? a : b
end

inline func _posf(v: f64): f64:
    ret v > 0.0 ? v : 0.0
end

inline func _zero_if(a: f64, other: f64): f64:
    ret other > 0.0 ? a : 0.0
end

func _fx(v: f64): int:
    if not (v == v):
        ret 0
    end
    mut t := v * 256.0
    if t > 536870912.0:
        t = 536870912.0
    end
    if t < -536870912.0:
        t = -536870912.0
    end
    ret math.Floor(t + 0.5) as int
end

func _fx16(v: f64): i64:
    if not (v == v):
        ret 0
    end
    mut t := v * 65536.0
    if t > 1099511627776.0:
        t = 1099511627776.0
    end
    if t < -1099511627776.0:
        t = -1099511627776.0
    end
    ret math.Floor(t + 0.5) as i64
end

func _isqrt(n: i64): i64:
    if n <= (0 as i64):
        ret 0
    end
    mut r := math.Sqrt(n as f64) as i64
    until r * r > n:
        r--
    end
    until (r + (1 as i64)) * (r + (1 as i64)) <= n:
        r++
    end
    ret r
end

func _angle_units(degrees: f64): int:
    if not (degrees == degrees):
        ret 0
    end
    turns := degrees / 360.0
    frac := turns - math.Floor(turns)
    ret (math.Floor(frac * 65536.0 + 0.5) as int) & 65535
end

func _sin_quarter(i: int): int:
    idx := i >> 6
    if idx >= 256:
        ret _SIN[256]
    end
    fr := i & 63
    a := _SIN[idx]
    ret a + (((_SIN[idx + 1] - a) * fr) >> 6)
end

func _sin_au(au: int): int:
    v := au & 65535
    q := v >> 14
    i := v & 16383
    switch q:
        0: ret _sin_quarter(i) end
        1: ret _sin_quarter(16384 - i) end
        2: ret 0 - _sin_quarter(i) end
    end
    ret 0 - _sin_quarter(16384 - i)
end

func _cos_au(au: int): int:
    ret _sin_au(au + 16384)
end

func _atan_frac(t: i64): int:
    idx := (t >> 8) as int
    if idx >= 256:
        ret _ATAN[256]
    end
    fr := (t & (255 as i64)) as int
    a := _ATAN[idx]
    ret a + (((_ATAN[idx + 1] - a) * fr) >> 8)
end

func _atan2_au(y: i64, x: i64): int:
    ax := x < (0 as i64) ? (0 as i64) - x : x
    ay := y < (0 as i64) ? (0 as i64) - y : y
    if ax == (0 as i64) and ay == (0 as i64):
        ret 0
    end
    mut a := 0
    if ax >= ay:
        a = _atan_frac((ay << 16) / ax)
    else:
        a = 16384 - _atan_frac((ax << 16) / ay)
    end
    if x < (0 as i64):
        a = 32768 - a
    end
    if y < (0 as i64):
        a = 65536 - a
    end
    ret a & 65535
end

func _phi(t: i64): int:
    v := t + (262144 as i64)
    if v <= (0 as i64):
        ret 0
    end
    if v >= (524288 as i64):
        ret 65536
    end
    i := (v >> 11) as int
    fr := (v & (2047 as i64)) as int
    a := _PHI[i]
    ret a + (((_PHI[i + 1] - a) * fr) >> 11)
end

@en "Rgb"
@fa "رنگ از سه مولفه"
pub func Rgb(r: int, g: int, b: int): Color:
    ret Color { r = r, g = g, b = b, a = 255 }
end

@en "Rgba"
@fa "رنگ از چهار مولفه"
pub func Rgba(r: int, g: int, b: int, a: int): Color:
    ret Color { r = r, g = g, b = b, a = a }
end

@en "Premultiply"
@fa "پیش ضرب"
pub func Premultiply(c: Color): u32:
    ret _premul(c)
end

@en "Unpremultiply"
@fa "حذف پیش ضرب"
pub func Unpremultiply(v: u32): Color:
    a := ((v >> 24) & (255 as u32)) as int
    if a == 0:
        ret Color { r = 0, g = 0, b = 0, a = 0 }
    end
    r := ((v >> 16) & (255 as u32)) as int
    g := ((v >> 8) & (255 as u32)) as int
    b := (v & (255 as u32)) as int
    ret Color { r = _clamp255((r * 255 + a / 2) / a), g = _clamp255((g * 255 + a / 2) / a), b = _clamp255((b * 255 + a / 2) / a), a = a }
end
