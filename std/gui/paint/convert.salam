package paint

import ai.image

@en "FromImage"
@fa "بوم از تصویر"
pub func FromImage(img: image.Image): Canvas:
    if img.pixels == null or img.width <= 0 or img.height <= 0:
        ret Canvas {}
    end
    out := NewCanvas(img.width, img.height)
    if out.pixels == null:
        ret out
    end
    src := img.pixels as u8*
    dst := out.pixels as u32*
    repeat img.width * img.height in i:
        k := i * 4
        dst[i] = _premul(Color { r = src[k] as int, g = src[k + 1] as int, b = src[k + 2] as int, a = src[k + 3] as int })
    end
    ret out
end

@en "ToImage"
@fa "تصویر از بوم"
pub func ToImage(cv: Canvas): image.Image:
    if cv.pixels == null:
        ret image.New(0, 0)
    end
    img := image.New(cv.width, cv.height)
    if img.pixels == null:
        ret img
    end
    src := cv.pixels as u32*
    dst := img.pixels as u8*
    spx := cv.stride / 4
    repeat cv.height in y:
        repeat cv.width in x:
            c := Unpremultiply(src[y * spx + x])
            k := (y * cv.width + x) * 4
            dst[k] = c.r as u8
            dst[k + 1] = c.g as u8
            dst[k + 2] = c.b as u8
            dst[k + 3] = c.a as u8
        end
    end
    ret img
end

@en "SavePNG"
@fa "ذخیره پی ان جی"
pub func SavePNG(cv: Canvas, path: str): bool:
    mut img := ToImage(cv)
    ok := image.SavePNG(img, path)
    image.Free(img)
    ret ok
end

@en "LoadPNG"
@fa "خواندن پی ان جی"
pub func LoadPNG(path: str, ok &: bool): Canvas:
    mut img := image.OpenPNG(path, ok)
    if not ok:
        image.Free(img)
        ret Canvas {}
    end
    out := FromImage(img)
    image.Free(img)
    ret out
end
