package paint

import mem
import math

func _cv_begin_layer(cv &: Canvas, r: Rect):
    _cv_ready(cv)
    sh := cv.state.sh
    zero := Radii {}
    mut x0 := cv.state.cx0
    mut y0 := cv.state.cy0
    mut x1 := x0
    mut y1 := y0
    if _shape_from(cv, r, zero, sh, 108):
        x0 = _maxi(cv.state.cx0, sh[108] >> 8)
        y0 = _maxi(cv.state.cy0, sh[109] >> 8)
        x1 = _mini(cv.state.cx1, (sh[110] + 255) >> 8)
        y1 = _mini(cv.state.cy1, (sh[111] + 255) >> 8)
    end
    if x1 < x0:
        x1 = x0
    end
    if y1 < y0:
        y1 = y0
    end
    cv.state.layers.push((cv.state.tpix as usize) as i64)
    cv.state.layers.push(cv.state.tox as i64)
    cv.state.layers.push(cv.state.toy as i64)
    cv.state.layers.push(cv.state.tw as i64)
    cv.state.layers.push(cv.state.th as i64)
    cv.state.layers.push(cv.state.tspx as i64)
    cv.state.layers.push(x0 as i64)
    cv.state.layers.push(y0 as i64)
    cv.state.layers.push(x1 as i64)
    cv.state.layers.push(y1 as i64)
    w := x1 - x0
    h := y1 - y0
    mut buf := null as u32*
    if w > 0 and h > 0:
        buf = mem.AllocateZeroed(((w as i64) * (h as i64) * (4 as i64)) as u64) as u32*
    end
    cv.state.tpix = buf
    cv.state.tox = x0
    cv.state.toy = y0
    cv.state.tw = w
    cv.state.th = h
    cv.state.tspx = w
    cv.state.clips.push(cv.state.cx0)
    cv.state.clips.push(cv.state.cy0)
    cv.state.clips.push(cv.state.cx1)
    cv.state.clips.push(cv.state.cy1)
    cv.state.clips.push(0)
    cv.state.cx0 = x0
    cv.state.cy0 = y0
    cv.state.cx1 = buf == null ? x0 : x1
    cv.state.cy1 = buf == null ? y0 : y1
end

func _cv_end_layer(cv &: Canvas, opacity: f64):
    _cv_ready(cv)
    if cv.state.layers.len() < 10:
        ret
    end
    buf := cv.state.tpix
    y1 := cv.state.layers.pop() as int
    x1 := cv.state.layers.pop() as int
    y0 := cv.state.layers.pop() as int
    x0 := cv.state.layers.pop() as int
    cv.state.tspx = cv.state.layers.pop() as int
    cv.state.th = cv.state.layers.pop() as int
    cv.state.tw = cv.state.layers.pop() as int
    cv.state.toy = cv.state.layers.pop() as int
    cv.state.tox = cv.state.layers.pop() as int
    cv.state.tpix = (cv.state.layers.pop() as usize) as u32*
    _cv_pop_clip(cv)
    if buf == null:
        ret
    end
    op := _clamp255(math.Floor(opacity * 255.0 + 0.5) as int)
    if op > 0:
        cv.state.i_pix = buf
        cv.state.i_spx = x1 - x0
        cv.state.i_ox = x0
        cv.state.i_oy = y0
        cv.state.i_w = x1 - x0
        cv.state.i_h = y1 - y0
        cv.state.i_op = op
        cv.state.i_tile = false
        cv.state.i_affine = false
        ya := _maxi(y0, cv.state.cy0)
        yb := _mini(y1, cv.state.cy1)
        xa := _maxi(x0, cv.state.cx0)
        xb := _mini(x1, cv.state.cx1)
        if xa < xb:
            repeat yb - ya in k:
                n := _rpush(cv.state.ra, 0, xa, xb, 256)
                _emit(cv, ya + k, n, _K_IMAGE, 0 as u32)
            end
        end
    end
    mem.Free(buf as void*)
end
