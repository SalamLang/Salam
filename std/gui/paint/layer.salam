package paint

import mem
import math

func _cv_begin_layer(cv &: Canvas, r: Rect):
    _cv_begin_layer_with(cv, r, false)
end

func _cv_begin_layer_with(cv &: Canvas, r: Rect, whole: bool):
    _cv_ready(cv)
    sh := cv.state.sh
    zero := Radii {}
    mut x0 := cv.state.cx0
    mut y0 := cv.state.cy0
    mut x1 := x0
    mut y1 := y0
    if _shape_from(cv, r, zero, sh, 108):
        x0 = _maxi(cv.state.cx0, sh[108] >> 8)
        y0 = _maxi(cv.state.cy0, sh[109] >> 8)
        x1 = _mini(cv.state.cx1, (sh[110] + 255) >> 8)
        y1 = _mini(cv.state.cy1, (sh[111] + 255) >> 8)
    end
    if x1 < x0:
        x1 = x0
    end
    if y1 < y0:
        y1 = y0
    end
    cv.state.layers.Push((cv.state.tpix as usize) as i64)
    cv.state.layers.Push(cv.state.tox as i64)
    cv.state.layers.Push(cv.state.toy as i64)
    cv.state.layers.Push(cv.state.tw as i64)
    cv.state.layers.Push(cv.state.th as i64)
    cv.state.layers.Push(cv.state.tspx as i64)
    cv.state.layers.Push(x0 as i64)
    cv.state.layers.Push(y0 as i64)
    cv.state.layers.Push(x1 as i64)
    cv.state.layers.Push(y1 as i64)
    cv.state.layers.Push(cv.state.has_region ? 1 as i64 : 0 as i64)
    if whole:
        cv.state.has_region = false
    end
    w := x1 - x0
    h := y1 - y0
    mut buf := null as u32*
    if w > 0 and h > 0:
        buf = mem.AllocateZeroed(((w as i64) * (h as i64) * (4 as i64)) as u64) as u32*
    end
    cv.state.tpix = buf
    cv.state.tox = x0
    cv.state.toy = y0
    cv.state.tw = w
    cv.state.th = h
    cv.state.tspx = w
    cv.state.clips.Push(cv.state.cx0)
    cv.state.clips.Push(cv.state.cy0)
    cv.state.clips.Push(cv.state.cx1)
    cv.state.clips.Push(cv.state.cy1)
    cv.state.clips.Push(0)
    cv.state.cx0 = x0
    cv.state.cy0 = y0
    cv.state.cx1 = buf == null ? x0 : x1
    cv.state.cy1 = buf == null ? y0 : y1
end

func _cv_end_layer(cv &: Canvas, opacity: f64):
    _cv_end_layer_with(cv, opacity, FilterChain {})
end

func _cv_end_layer_masked(cv &: Canvas, opacity: f64):
    _cv_ready(cv)
    if cv.state.layers.Len() < 22:
        _cv_end_layer(cv, opacity)
        ret
    end
    mbuf := cv.state.tpix
    cv.state.has_region = cv.state.layers.Pop() != (0 as i64)
    my1 := cv.state.layers.Pop() as int
    mx1 := cv.state.layers.Pop() as int
    my0 := cv.state.layers.Pop() as int
    mx0 := cv.state.layers.Pop() as int
    cv.state.tspx = cv.state.layers.Pop() as int
    cv.state.th = cv.state.layers.Pop() as int
    cv.state.tw = cv.state.layers.Pop() as int
    cv.state.toy = cv.state.layers.Pop() as int
    cv.state.tox = cv.state.layers.Pop() as int
    cv.state.tpix = (cv.state.layers.Pop() as usize) as u32*
    _cv_pop_clip(cv)
    cbuf := cv.state.tpix
    if cbuf != null:
        mw := mx1 - mx0
        repeat cv.state.th in y:
            gy := cv.state.toy + y
            row := y * cv.state.tspx
            repeat cv.state.tw in x:
                gx := cv.state.tox + x
                mut a := 0 as u32
                if mbuf != null and gx >= mx0 and gx < mx1 and gy >= my0 and gy < my1:
                    a = (mbuf[(gy - my0) * mw + (gx - mx0)] >> 24) & (255 as u32)
                end
                if a == (255 as u32):
                    continue
                end
                if a == (0 as u32):
                    cbuf[row + x] = 0 as u32
                    continue
                end
                p := cbuf[row + x]
                ca := (((p >> 24) & (255 as u32)) * a + (127 as u32)) / (255 as u32)
                cr := (((p >> 16) & (255 as u32)) * a + (127 as u32)) / (255 as u32)
                cg := (((p >> 8) & (255 as u32)) * a + (127 as u32)) / (255 as u32)
                cb := ((p & (255 as u32)) * a + (127 as u32)) / (255 as u32)
                cbuf[row + x] = (ca << 24) | (cr << 16) | (cg << 8) | cb
            end
        end
    end
    if mbuf != null:
        mem.Free(mbuf as void*)
    end
    _cv_end_layer(cv, opacity)
end

func _cv_end_layer_with(cv &: Canvas, opacity: f64, chain: FilterChain):
    _cv_end_layer_mode(cv, opacity, chain, 0)
end

func _blend_code(m: BlendMode): int:
    switch m:
        BlendMode.Multiply: ret 1 end
        BlendMode.Screen: ret 2 end
        BlendMode.Overlay: ret 3 end
        BlendMode.Darken: ret 4 end
        BlendMode.Lighten: ret 5 end
        BlendMode.ColorDodge: ret 6 end
        BlendMode.ColorBurn: ret 7 end
        BlendMode.HardLight: ret 8 end
        BlendMode.SoftLight: ret 9 end
        BlendMode.Difference: ret 10 end
        BlendMode.Exclusion: ret 11 end
        BlendMode.Hue: ret 12 end
        BlendMode.Saturation: ret 13 end
        BlendMode.Color: ret 14 end
        BlendMode.Luminosity: ret 15 end
        else: ret 0 end
    end
    ret 0
end

func _bl_hard(cb: f64, cs: f64): f64:
    if cs <= 0.5:
        ret cb * 2.0 * cs
    end
    t := 2.0 * cs - 1.0
    ret cb + t - cb * t
end

func _bl_ch(mode: int, cb: f64, cs: f64): f64:
    switch mode:
        1: ret cb * cs end
        2: ret cb + cs - cb * cs end
        3: ret _bl_hard(cs, cb) end
        4: ret cb < cs ? cb : cs end
        5: ret cb > cs ? cb : cs end
        6:
            if cb <= 0.0:
                ret 0.0
            end
            if cs >= 1.0:
                ret 1.0
            end
            ret _minf(1.0, cb / (1.0 - cs))
        end
        7:
            if cb >= 1.0:
                ret 1.0
            end
            if cs <= 0.0:
                ret 0.0
            end
            ret 1.0 - _minf(1.0, (1.0 - cb) / cs)
        end
        8: ret _bl_hard(cb, cs) end
        9:
            if cs <= 0.5:
                ret cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb)
            end
            mut d := math.Sqrt(cb)
            if cb <= 0.25:
                d = ((16.0 * cb - 12.0) * cb + 4.0) * cb
            end
            ret cb + (2.0 * cs - 1.0) * (d - cb)
        end
        10: ret cb > cs ? cb - cs : cs - cb end
        11: ret cb + cs - 2.0 * cb * cs end
    end
    ret cs
end

func _bl_lum(c: f64[]): f64:
    ret 0.3 * c[0] + 0.59 * c[1] + 0.11 * c[2]
end

func _bl_clip(c: f64[]):
    l := _bl_lum(c)
    n := _minf(c[0], _minf(c[1], c[2]))
    x := _maxf(c[0], _maxf(c[1], c[2]))
    if n < 0.0:
        repeat 3 in i:
            c[i] = l + (c[i] - l) * l / (l - n)
        end
    end
    if x > 1.0:
        repeat 3 in i:
            c[i] = l + (c[i] - l) * (1.0 - l) / (x - l)
        end
    end
end

func _bl_set_lum(c: f64[], l: f64):
    d := l - _bl_lum(c)
    c[0] += d
    c[1] += d
    c[2] += d
    _bl_clip(c)
end

func _bl_sat(c: f64[]): f64:
    ret _maxf(c[0], _maxf(c[1], c[2])) - _minf(c[0], _minf(c[1], c[2]))
end

func _bl_set_sat(c: f64[], s: f64):
    mut mx := 0
    mut mn := 0
    repeat 3 in i:
        if c[i] > c[mx]:
            mx = i
        end
        if c[i] < c[mn]:
            mn = i
        end
    end
    if mx == mn:
        c[0] = 0.0
        c[1] = 0.0
        c[2] = 0.0
        ret
    end
    md := 3 - mx - mn
    cmax := c[mx]
    cmin := c[mn]
    cmid := c[md]
    c[md] = (cmid - cmin) * s / (cmax - cmin)
    c[mx] = s
    c[mn] = 0.0
end

func _bl_nonsep(mode: int, cb: f64[], cs: f64[], out: f64[]):
    switch mode:
        12:
            out[0] = cs[0]
            out[1] = cs[1]
            out[2] = cs[2]
            _bl_set_sat(out, _bl_sat(cb))
            _bl_set_lum(out, _bl_lum(cb))
            break
        end
        13:
            out[0] = cb[0]
            out[1] = cb[1]
            out[2] = cb[2]
            _bl_set_sat(out, _bl_sat(cs))
            _bl_set_lum(out, _bl_lum(cb))
            break
        end
        14:
            out[0] = cs[0]
            out[1] = cs[1]
            out[2] = cs[2]
            _bl_set_lum(out, _bl_lum(cb))
            break
        end
        else:
            out[0] = cb[0]
            out[1] = cb[1]
            out[2] = cb[2]
            _bl_set_lum(out, _bl_lum(cs))
            break
        end
    end
end

func _blend_layer(cv &: Canvas, buf: u32*, x0: int, y0: int, x1: int, y1: int, mode: int):
    tp := cv.state.tpix
    if tp == null:
        ret
    end
    w := x1 - x0
    mut cb := [0.0, 0.0, 0.0]
    mut cs := [0.0, 0.0, 0.0]
    mut bo := [0.0, 0.0, 0.0]
    repeat y1 - y0 in y:
        gy := y0 + y
        if gy < cv.state.toy or gy >= cv.state.toy + cv.state.th:
            continue
        end
        repeat w in x:
            gx := x0 + x
            if gx < cv.state.tox or gx >= cv.state.tox + cv.state.tw:
                continue
            end
            sp := buf[y * w + x]
            sa := ((sp >> 24) & (255 as u32)) as int
            if sa == 0:
                continue
            end
            dp := tp[(gy - cv.state.toy) * cv.state.tspx + (gx - cv.state.tox)]
            da := ((dp >> 24) & (255 as u32)) as int
            if da == 0:
                continue
            end
            fsa := (sa as f64) / 255.0
            fda := (da as f64) / 255.0
            cs[0] = (((sp >> 16) & (255 as u32)) as f64) / 255.0 / fsa
            cs[1] = (((sp >> 8) & (255 as u32)) as f64) / 255.0 / fsa
            cs[2] = ((sp & (255 as u32)) as f64) / 255.0 / fsa
            cb[0] = (((dp >> 16) & (255 as u32)) as f64) / 255.0 / fda
            cb[1] = (((dp >> 8) & (255 as u32)) as f64) / 255.0 / fda
            cb[2] = ((dp & (255 as u32)) as f64) / 255.0 / fda
            if mode >= 12:
                _bl_nonsep(mode, cb, cs, bo)
            else:
                bo[0] = _bl_ch(mode, cb[0], cs[0])
                bo[1] = _bl_ch(mode, cb[1], cs[1])
                bo[2] = _bl_ch(mode, cb[2], cs[2])
            end
            mut o := 0 as u32
            repeat 3 in i:
                m := (1.0 - fda) * cs[i] + fda * bo[i]
                v := _clamp255(math.Floor(m * fsa * 255.0 + 0.5) as int)
                o = (o << 8) | (v as u32)
            end
            buf[y * w + x] = (((sa as u32) << 24)) | o
        end
    end
end

func _cv_end_layer_mode(cv &: Canvas, opacity: f64, chain: FilterChain, mode: int):
    _cv_ready(cv)
    if cv.state.layers.Len() < 11:
        ret
    end
    buf := cv.state.tpix
    cv.state.has_region = cv.state.layers.Pop() != (0 as i64)
    y1 := cv.state.layers.Pop() as int
    x1 := cv.state.layers.Pop() as int
    y0 := cv.state.layers.Pop() as int
    x0 := cv.state.layers.Pop() as int
    cv.state.tspx = cv.state.layers.Pop() as int
    cv.state.th = cv.state.layers.Pop() as int
    cv.state.tw = cv.state.layers.Pop() as int
    cv.state.toy = cv.state.layers.Pop() as int
    cv.state.tox = cv.state.layers.Pop() as int
    cv.state.tpix = (cv.state.layers.Pop() as usize) as u32*
    _cv_pop_clip(cv)
    if buf == null:
        ret
    end
    if chain.items.Len() > 0:
        _apply_chain(cv, buf, x1 - x0, y1 - y0, chain)
    end
    if mode > 0:
        _blend_layer(cv, buf, x0, y0, x1, y1, mode)
    end
    op := _clamp255(math.Floor(opacity * 255.0 + 0.5) as int)
    if op > 0:
        cv.state.i_pix = buf
        cv.state.i_spx = x1 - x0
        cv.state.i_ox = x0
        cv.state.i_oy = y0
        cv.state.i_w = x1 - x0
        cv.state.i_h = y1 - y0
        cv.state.i_op = op
        cv.state.i_tile = false
        cv.state.i_affine = false
        ya := _maxi(y0, cv.state.cy0)
        yb := _mini(y1, cv.state.cy1)
        xa := _maxi(x0, cv.state.cx0)
        xb := _mini(x1, cv.state.cx1)
        if xa < xb:
            repeat yb - ya in k:
                n := _rpush(cv.state.ra, 0, xa, xb, 256)
                _emit(cv, ya + k, n, _K_IMAGE, 0 as u32)
            end
        end
    end
    mem.Free(buf as void*)
end
