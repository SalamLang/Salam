@en "Canvas"
@fa "بوم"
pub struct Canvas:
    @en "pixels"
    @fa "پیکسل ها"
    pub pixels: void* = null
    @en "width"
    @fa "پهنا"
    pub width: int = 0
    @en "height"
    @fa "بلندی"
    pub height: int = 0
    @en "stride"
    @fa "گام ردیف"
    pub stride: int = 0
    @en "owned"
    @fa "مالک است"
    pub owned: bool = false
    @en "state"
    @fa "وضعیت"
    pub state: _State = _State {}

    @en "Free"
    @fa "رهاسازی"
    pub func Free():
        _cv_free(this)
    end

    @en "Clear"
    @fa "پاک کردن"
    pub func Clear(c: Color):
        _cv_clear(this, c)
    end

    @en "Pixel"
    @fa "پیکسل"
    pub func Pixel(x: int, y: int): Color:
        ret Unpremultiply(this.RawPixel(x, y))
    end

    @en "RawPixel"
    @fa "پیکسل خام"
    pub func RawPixel(x: int, y: int): u32:
        if this.pixels == null or x < 0 or y < 0 or x >= this.width or y >= this.height:
            ret 0
        end
        ret (this.pixels as u32*)[y * (this.stride / 4) + x]
    end

    @en "Hash"
    @fa "چکیده"
    pub func Hash(): str:
        ret _cv_hash(this)
    end

    @en "Sub"
    @fa "زیربوم"
    pub func Sub(r: IntRect): Canvas:
        ret _cv_sub(this, r)
    end

    @en "PushClip"
    @fa "افزودن برش"
    pub func PushClip(r: Rect):
        _cv_push_clip(this, r, Radii {}, false)
    end

    @en "PushRoundedClip"
    @fa "افزودن برش گرد"
    pub func PushRoundedClip(r: Rect, radii: Radii):
        _cv_push_clip(this, r, radii, true)
    end

    @en "PopClip"
    @fa "برداشتن برش"
    pub func PopClip():
        _cv_pop_clip(this)
    end

    @en "ClipBounds"
    @fa "کرانه برش"
    pub func ClipBounds(): IntRect:
        _cv_ready(this)
        ret IntRect { x = this.state.cx0, y = this.state.cy0, width = this.state.cx1 - this.state.cx0, height = this.state.cy1 - this.state.cy0 }
    end

    @en "PushTransform"
    @fa "افزودن تبدیل"
    pub func PushTransform(t: Transform):
        _cv_push_transform(this, t)
    end

    @en "Translate"
    @fa "جابجا کردن"
    pub func Translate(dx: f64, dy: f64):
        _cv_push_transform(this, Translation(dx, dy))
    end

    @en "PopTransform"
    @fa "برداشتن تبدیل"
    pub func PopTransform():
        _cv_pop_transform(this)
    end

    @en "SetRegion"
    @fa "تنظیم ناحیه"
    pub func SetRegion(r: Region):
        _cv_ready(this)
        this.state.region = r
        this.state.has_region = true
        bb := r.Bounds()
        this.state.rg_x0 = bb.x
        this.state.rg_y0 = bb.y
        this.state.rg_x1 = bb.x + bb.width
        this.state.rg_y1 = bb.y + bb.height
    end

    @en "ClearRegion"
    @fa "حذف ناحیه"
    pub func ClearRegion():
        this.state.has_region = false
    end

    @en "FillRect"
    @fa "پرکردن مستطیل"
    pub func FillRect(r: Rect, c: Color):
        _cv_fill_rounded(this, r, Radii {}, c)
    end

    @en "FillRoundedRect"
    @fa "پرکردن مستطیل گرد"
    pub func FillRoundedRect(r: Rect, radii: Radii, c: Color):
        _cv_fill_rounded(this, r, radii, c)
    end

    @en "DrawBorder"
    @fa "رسم کادر"
    pub func DrawBorder(r: Rect, radii: Radii, b: Border):
        _cv_border(this, r, radii, b)
    end

    @en "DrawOutline"
    @fa "رسم دورخط"
    pub func DrawOutline(r: Rect, radii: Radii, width: f64, offset: f64, c: Color):
        _cv_outline(this, r, radii, width, offset, c)
    end

    @en "FillGradient"
    @fa "پرکردن گرادیان"
    pub func FillGradient(r: Rect, radii: Radii, g: Gradient):
        _cv_gradient(this, r, radii, g)
    end

    @en "DrawShadow"
    @fa "رسم سایه"
    pub func DrawShadow(r: Rect, radii: Radii, s: Shadow):
        _cv_shadow(this, r, radii, s)
    end

    @en "DrawImage"
    @fa "رسم تصویر"
    pub func DrawImage(src: Canvas, dst: Rect, opacity: f64):
        _cv_image(this, src, IntRect { x = 0, y = 0, width = src.width, height = src.height }, dst, dst, opacity, false)
    end

    @en "DrawImagePart"
    @fa "رسم تکه تصویر"
    pub func DrawImagePart(src: Canvas, part: IntRect, dst: Rect, opacity: f64):
        _cv_image(this, src, part, dst, dst, opacity, false)
    end

    @en "DrawImageTiled"
    @fa "رسم تصویر کاشی"
    pub func DrawImageTiled(src: Canvas, area: Rect, tile: Rect, opacity: f64):
        _cv_image(this, src, IntRect { x = 0, y = 0, width = src.width, height = src.height }, area, tile, opacity, true)
    end

    @en "DrawMask"
    @fa "رسم ماسک"
    pub func DrawMask(m: Mask, x: int, y: int, c: Color):
        _cv_mask(this, m, x, y, c)
    end

    @en "DrawGlyph"
    @fa "رسم گلیف"
    pub func DrawGlyph(m: Mask, x: int, baseline: int, c: Color):
        _cv_mask(this, m, x + m.left, baseline - m.top, c)
    end

    @en "FillPath"
    @fa "پرکردن مسیر"
    pub func FillPath(p: Path, rule: FillRule, c: Color):
        _cv_fill_path(this, p, rule, c)
    end

    @en "StrokePath"
    @fa "خط کشی مسیر"
    pub func StrokePath(p: Path, s: Stroke, c: Color):
        _cv_stroke_path(this, p, s, c)
    end

    @en "BeginLayer"
    @fa "آغاز لایه"
    pub func BeginLayer(r: Rect):
        _cv_begin_layer(this, r)
    end

    @en "EndLayer"
    @fa "ادغام لایه"
    pub func EndLayer(opacity: f64):
        _cv_end_layer(this, opacity)
    end

    @en "BeginFilterLayer"
    @fa "آغاز لایه پالایه"
    pub func BeginFilterLayer(r: Rect, chain: FilterChain):
        e := chain.Extent()
        _cv_begin_layer_with(this, Rect { x = r.x - e, y = r.y - e, width = r.width + 2.0 * e, height = r.height + 2.0 * e }, true)
    end

    @en "EndLayerFiltered"
    @fa "ادغام لایه با پالایه"
    pub func EndLayerFiltered(chain: FilterChain, opacity: f64):
        _cv_end_layer_with(this, opacity, chain)
    end

    @en "DrawNineSlice"
    @fa "رسم نه برش"
    pub func DrawNineSlice(src: Canvas, area: Rect, ns: NineSlice, opacity: f64):
        _cv_nine_slice(this, src, area, ns, opacity)
    end

    @en "BackdropFilter"
    @fa "پالایه پس زمینه"
    pub func BackdropFilter(r: Rect, radii: Radii, chain: FilterChain, opacity: f64 = 1.0):
        _cv_backdrop(this, r, radii, chain, opacity)
    end

    @en "DrawOutlineStyled"
    @fa "رسم دورخط با سبک"
    pub func DrawOutlineStyled(r: Rect, radii: Radii, width: f64, offset: f64, c: Color, style: BorderStyle):
        _cv_outline_styled(this, r, radii, width, offset, c, style)
    end
end

func _irect_union(a: IntRect, b: IntRect): IntRect:
    x0 := a.x < b.x ? a.x : b.x
    y0 := a.y < b.y ? a.y : b.y
    ax1 := a.x + a.width
    bx1 := b.x + b.width
    ay1 := a.y + a.height
    by1 := b.y + b.height
    x1 := ax1 > bx1 ? ax1 : bx1
    y1 := ay1 > by1 ? ay1 : by1
    ret IntRect { x = x0, y = y0, width = x1 - x0, height = y1 - y0 }
end

func _irect_contains(a: IntRect, b: IntRect): bool:
    ret b.x >= a.x and b.y >= a.y and b.x + b.width <= a.x + a.width and b.y + b.height <= a.y + a.height
end

func _irect_area(a: IntRect): i64:
    ret (a.width as i64) * (a.height as i64)
end

@en "NewCanvas"
@fa "بوم تازه"
pub func NewCanvas(width: int, height: int): Canvas:
    if width <= 0 or height <= 0 or (width as i64) * (height as i64) > (268435456 as i64):
        ret Canvas {}
    end
    p := mem.AllocateZeroed(((width as i64) * (height as i64) * (4 as i64)) as u64)
    if p == null:
        ret Canvas {}
    end
    ret Canvas { pixels = p, width = width, height = height, stride = width * 4, owned = true }
end

@en "WrapCanvas"
@fa "بوم روی حافظه"
pub func WrapCanvas(pixels: void*, width: int, height: int, stride: int): Canvas:
    if pixels == null or width <= 0 or height <= 0 or stride < width * 4 or stride % 4 != 0:
        ret Canvas {}
    end
    ret Canvas { pixels = pixels, width = width, height = height, stride = stride, owned = false }
end

@en "RectOf"
@fa "مستطیل از"
pub func RectOf(x: f64, y: f64, width: f64, height: f64): Rect:
    ret Rect { x = x, y = y, width = width, height = height }
end

@en "IntRectOf"
@fa "مستطیل پیکسلی از"
pub func IntRectOf(x: int, y: int, width: int, height: int): IntRect:
    ret IntRect { x = x, y = y, width = width, height = height }
end

@en "Uniform"
@fa "شعاع یکسان"
pub func Uniform(r: f64): Radii:
    ret Radii {
        top_left_x = r, top_left_y = r, top_right_x = r, top_right_y = r,
        bottom_right_x = r, bottom_right_y = r, bottom_left_x = r, bottom_left_y = r
    }
end

@en "Corners"
@fa "شعاع گوشه ها"
pub func Corners(top_left: f64, top_right: f64, bottom_right: f64, bottom_left: f64): Radii:
    ret Radii {
        top_left_x = top_left, top_left_y = top_left, top_right_x = top_right, top_right_y = top_right,
        bottom_right_x = bottom_right, bottom_right_y = bottom_right, bottom_left_x = bottom_left, bottom_left_y = bottom_left
    }
end

@en "FitRadii"
@fa "برازش شعاع ها"
pub func FitRadii(r: Rect, radii: Radii): Radii:
    tlx := _zero_if(_posf(radii.top_left_x), _posf(radii.top_left_y))
    tly := _zero_if(_posf(radii.top_left_y), _posf(radii.top_left_x))
    trx := _zero_if(_posf(radii.top_right_x), _posf(radii.top_right_y))
    tr_y := _zero_if(_posf(radii.top_right_y), _posf(radii.top_right_x))
    brx := _zero_if(_posf(radii.bottom_right_x), _posf(radii.bottom_right_y))
    bry := _zero_if(_posf(radii.bottom_right_y), _posf(radii.bottom_right_x))
    blx := _zero_if(_posf(radii.bottom_left_x), _posf(radii.bottom_left_y))
    bly := _zero_if(_posf(radii.bottom_left_y), _posf(radii.bottom_left_x))
    w := _posf(r.width)
    h := _posf(r.height)
    mut f := 1.0
    if tlx + trx > w:
        f = _minf(f, w / (tlx + trx))
    end
    if blx + brx > w:
        f = _minf(f, w / (blx + brx))
    end
    if tly + bly > h:
        f = _minf(f, h / (tly + bly))
    end
    if tr_y + bry > h:
        f = _minf(f, h / (tr_y + bry))
    end
    ret Radii {
        top_left_x = tlx * f, top_left_y = tly * f,
        top_right_x = trx * f, top_right_y = tr_y * f,
        bottom_right_x = brx * f, bottom_right_y = bry * f,
        bottom_left_x = blx * f, bottom_left_y = bly * f
    }
end

@en "SolidBorder"
@fa "کادر توپر"
pub func SolidBorder(width: f64, c: Color): Border:
    ret Border {
        top_width = width, right_width = width, bottom_width = width, left_width = width,
        top_color = c, right_color = c, bottom_color = c, left_color = c
    }
end

@en "NewPath"
@fa "مسیر تازه"
pub func NewPath(): Path:
    ret Path {}
end

@en "Identity"
@fa "تبدیل همانی"
pub func Identity(): Transform:
    ret Transform {}
end

@en "Translation"
@fa "تبدیل جابجایی"
pub func Translation(dx: f64, dy: f64): Transform:
    ret Transform { e = dx, f = dy }
end

@en "Scaling"
@fa "تبدیل مقیاس"
pub func Scaling(sx: f64, sy: f64): Transform:
    ret Transform { a = sx, d = sy }
end

@en "Skewing"
@fa "تبدیل کجی"
pub func Skewing(x_degrees: f64, y_degrees: f64): Transform:
    ret Transform { c = _tan_deg(x_degrees), b = _tan_deg(y_degrees) }
end

@en "NewFilter"
@fa "پالایه تازه"
pub func NewFilter(kind: FilterKind, amount: f64): Filter:
    ret Filter { kind = kind, amount = amount }
end

@en "DropShadowFilter"
@fa "پالایه سایه افتاده"
pub func DropShadowFilter(offset_x: f64, offset_y: f64, blur: f64, c: Color): Filter:
    ret Filter { kind = FilterKind.DropShadow, amount = blur, offset_x = offset_x, offset_y = offset_y, color = c }
end

@en "Rotation"
@fa "تبدیل چرخش"
pub func Rotation(degrees: f64): Transform:
    au := _angle_units(degrees)
    s := (_sin_au(au) as f64) / 65536.0
    c := (_cos_au(au) as f64) / 65536.0
    ret Transform { a = c, b = s, c = 0.0 - s, d = c }
end
