package raylib

extern:
    @en "InitAudioDevice"
    @fa "راه‌اندازی دستگاه صدا"
    pub func InitAudioDevice()
    @en "CloseAudioDevice"
    @fa "بستن دستگاه صدا"
    pub func CloseAudioDevice()
    @en "IsAudioDeviceReady"
    @fa "دستگاه صدا آماده است"
    pub func IsAudioDeviceReady(): bool
    @en "SetMasterVolume"
    @fa "تنظیم بلندی کل"
    pub func SetMasterVolume(volume: f32)
    @en "GetMasterVolume"
    @fa "بلندی کل"
    pub func GetMasterVolume(): f32
    @en "LoadWave"
    @fa "بارگذاری موج"
    pub func LoadWave(fileName: str): Wave
    @en "IsWaveValid"
    @fa "موج معتبر است"
    pub func IsWaveValid(wave: Wave): bool
    @en "LoadSound"
    @fa "بارگذاری صدا"
    pub func LoadSound(fileName: str): Sound
    @en "LoadSoundFromWave"
    @fa "بارگذاری صدا از موج"
    pub func LoadSoundFromWave(wave: Wave): Sound
    @en "LoadSoundAlias"
    @fa "بارگذاری نام مستعار صدا"
    pub func LoadSoundAlias(source: Sound): Sound
    @en "IsSoundValid"
    @fa "صدا معتبر است"
    pub func IsSoundValid(sound: Sound): bool
    @en "UpdateSound"
    @fa "به‌روزرسانی صدا"
    pub func UpdateSound(sound: Sound, data: void*, sampleCount: int)
    @en "UnloadWave"
    @fa "آزادسازی موج"
    pub func UnloadWave(wave: Wave)
    @en "UnloadSound"
    @fa "آزادسازی صدا"
    pub func UnloadSound(sound: Sound)
    @en "UnloadSoundAlias"
    @fa "آزادسازی نام مستعار صدا"
    pub func UnloadSoundAlias(alias: Sound)
    @en "ExportWave"
    @fa "صدور موج"
    pub func ExportWave(wave: Wave, fileName: str): bool
    @en "PlaySound"
    @fa "پخش صدا"
    pub func PlaySound(sound: Sound)
    @en "StopSound"
    @fa "توقف صدا"
    pub func StopSound(sound: Sound)
    @en "PauseSound"
    @fa "مکث صدا"
    pub func PauseSound(sound: Sound)
    @en "ResumeSound"
    @fa "ادامه صدا"
    pub func ResumeSound(sound: Sound)
    @en "IsSoundPlaying"
    @fa "صدا در حال پخش است"
    pub func IsSoundPlaying(sound: Sound): bool
    @en "SetSoundVolume"
    @fa "تنظیم بلندی صدا"
    pub func SetSoundVolume(sound: Sound, volume: f32)
    @en "SetSoundPitch"
    @fa "تنظیم زیروبمی صدا"
    pub func SetSoundPitch(sound: Sound, pitch: f32)
    @en "SetSoundPan"
    @fa "تنظیم توازن صدا"
    pub func SetSoundPan(sound: Sound, pan: f32)
    @en "WaveCopy"
    @fa "نسخه موج"
    pub func WaveCopy(wave: Wave): Wave
    @en "WaveCrop"
    @fa "برش موج"
    pub func WaveCrop(wave &: Wave, initFrame: int, finalFrame: int)
    @en "WaveFormat"
    @fa "تغییر قالب موج"
    pub func WaveFormat(wave &: Wave, sampleRate: int, sampleSize: int, channels: int)
    @en "LoadWaveSamples"
    @fa "بارگذاری نمونه‌های موج"
    pub func LoadWaveSamples(wave: Wave): f32*
    @en "UnloadWaveSamples"
    @fa "آزادسازی نمونه‌های موج"
    pub func UnloadWaveSamples(samples: f32*)
    @en "LoadMusicStream"
    @fa "بارگذاری جریان موسیقی"
    pub func LoadMusicStream(fileName: str): Music
    @en "IsMusicValid"
    @fa "موسیقی معتبر است"
    pub func IsMusicValid(music: Music): bool
    @en "UnloadMusicStream"
    @fa "آزادسازی جریان موسیقی"
    pub func UnloadMusicStream(music: Music)
    @en "PlayMusicStream"
    @fa "پخش موسیقی"
    pub func PlayMusicStream(music: Music)
    @en "IsMusicStreamPlaying"
    @fa "موسیقی در حال پخش است"
    pub func IsMusicStreamPlaying(music: Music): bool
    @en "UpdateMusicStream"
    @fa "به‌روزرسانی موسیقی"
    pub func UpdateMusicStream(music: Music)
    @en "StopMusicStream"
    @fa "توقف موسیقی"
    pub func StopMusicStream(music: Music)
    @en "PauseMusicStream"
    @fa "مکث موسیقی"
    pub func PauseMusicStream(music: Music)
    @en "ResumeMusicStream"
    @fa "ادامه موسیقی"
    pub func ResumeMusicStream(music: Music)
    @en "SeekMusicStream"
    @fa "پرش در موسیقی"
    pub func SeekMusicStream(music: Music, position: f32)
    @en "SetMusicVolume"
    @fa "تنظیم بلندی موسیقی"
    pub func SetMusicVolume(music: Music, volume: f32)
    @en "SetMusicPitch"
    @fa "تنظیم زیروبمی موسیقی"
    pub func SetMusicPitch(music: Music, pitch: f32)
    @en "SetMusicPan"
    @fa "تنظیم توازن موسیقی"
    pub func SetMusicPan(music: Music, pan: f32)
    @en "GetMusicTimeLength"
    @fa "طول زمانی موسیقی"
    pub func GetMusicTimeLength(music: Music): f32
    @en "GetMusicTimePlayed"
    @fa "زمان پخش‌شده موسیقی"
    pub func GetMusicTimePlayed(music: Music): f32
end

@en "SetMasterVolume"
@fa "تنظیم بلندی کل"
pub func SetMasterVolume(volume: f64):
    SetMasterVolume(volume as f32)
end

@en "SetSoundVolume"
@fa "تنظیم بلندی صدا"
pub func SetSoundVolume(sound: Sound, volume: f64):
    SetSoundVolume(sound, volume as f32)
end

@en "SetSoundPitch"
@fa "تنظیم زیروبمی صدا"
pub func SetSoundPitch(sound: Sound, pitch: f64):
    SetSoundPitch(sound, pitch as f32)
end

@en "SetSoundPan"
@fa "تنظیم توازن صدا"
pub func SetSoundPan(sound: Sound, pan: f64):
    SetSoundPan(sound, pan as f32)
end

@en "SeekMusicStream"
@fa "پرش در موسیقی"
pub func SeekMusicStream(music: Music, position: f64):
    SeekMusicStream(music, position as f32)
end

@en "SetMusicVolume"
@fa "تنظیم بلندی موسیقی"
pub func SetMusicVolume(music: Music, volume: f64):
    SetMusicVolume(music, volume as f32)
end

@en "SetMusicPitch"
@fa "تنظیم زیروبمی موسیقی"
pub func SetMusicPitch(music: Music, pitch: f64):
    SetMusicPitch(music, pitch as f32)
end

@en "SetMusicPan"
@fa "تنظیم توازن موسیقی"
pub func SetMusicPan(music: Music, pan: f64):
    SetMusicPan(music, pan as f32)
end
