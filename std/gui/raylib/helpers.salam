package raylib

@en "Vec2"
@fa "ساخت بردار دو"
pub func Vec2(x: f64, y: f64): Vector2:
    ret Vector2 { x = x as f32, y = y as f32 }
end

@en "Vec3"
@fa "ساخت بردار سه"
pub func Vec3(x: f64, y: f64, z: f64): Vector3:
    ret Vector3 { x = x as f32, y = y as f32, z = z as f32 }
end

@en "Vec4"
@fa "ساخت بردار چهار"
pub func Vec4(x: f64, y: f64, z: f64, w: f64): Vector4:
    ret Vector4 { x = x as f32, y = y as f32, z = z as f32, w = w as f32 }
end

@en "Rect"
@fa "ساخت مستطیل"
pub func Rect(x: f64, y: f64, width: f64, height: f64): Rectangle:
    ret Rectangle { x = x as f32, y = y as f32, width = width as f32, height = height as f32 }
end

@en "RGB"
@fa "ساخت رنگ"
pub func RGB(r: int, g: int, b: int): Color:
    ret Color { r = r as u8, g = g as u8, b = b as u8, a = 255 as u8 }
end

@en "RGBA"
@fa "ساخت رنگ شفاف"
pub func RGBA(r: int, g: int, b: int, a: int): Color:
    ret Color { r = r as u8, g = g as u8, b = b as u8, a = a as u8 }
end

@en "NewCamera2D"
@fa "ساخت دوربین دوبعدی"
pub func NewCamera2D(offset: Vector2, target: Vector2, rotation: f64, zoom: f64): Camera2D:
    ret Camera2D { offset = offset, target = target, rotation = rotation as f32, zoom = zoom as f32 }
end

@en "NewCamera3D"
@fa "ساخت دوربین سه‌بعدی"
pub func NewCamera3D(position: Vector3, target: Vector3, up: Vector3, fovy: f64, projection: int): Camera3D:
    ret Camera3D { position = position, target = target, up = up, fovy = fovy as f32, projection = projection }
end

@en "LightGray"
@fa "خاکستری روشن"
pub func LightGray(): Color:
    ret Color { r = 200 as u8, g = 200 as u8, b = 200 as u8, a = 255 as u8 }
end

