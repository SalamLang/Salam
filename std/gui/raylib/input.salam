package raylib

extern:
    @en "IsKeyPressed"
    @fa "کلید فشرده شد"
    pub func IsKeyPressed(key: int): bool
    @en "IsKeyPressedRepeat"
    @fa "کلید تکراری فشرده شد"
    pub func IsKeyPressedRepeat(key: int): bool
    @en "IsKeyDown"
    @fa "کلید پایین است"
    pub func IsKeyDown(key: int): bool
    @en "IsKeyReleased"
    @fa "کلید رها شد"
    pub func IsKeyReleased(key: int): bool
    @en "IsKeyUp"
    @fa "کلید بالا است"
    pub func IsKeyUp(key: int): bool
    @en "GetKeyPressed"
    @fa "کلید فشرده‌شده"
    pub func GetKeyPressed(): int
    @en "GetCharPressed"
    @fa "نویسه فشرده‌شده"
    pub func GetCharPressed(): int
    @en "SetExitKey"
    @fa "تنظیم کلید خروج"
    pub func SetExitKey(key: int)
    @en "IsGamepadAvailable"
    @fa "دسته بازی در دسترس است"
    pub func IsGamepadAvailable(gamepad: int): bool
    @en "GetGamepadName"
    @fa "نام دسته بازی"
    pub func GetGamepadName(gamepad: int): str
    @en "IsGamepadButtonPressed"
    @fa "دکمه دسته بازی فشرده شد"
    pub func IsGamepadButtonPressed(gamepad: int, button: int): bool
    @en "IsGamepadButtonDown"
    @fa "دکمه دسته بازی پایین است"
    pub func IsGamepadButtonDown(gamepad: int, button: int): bool
    @en "IsGamepadButtonReleased"
    @fa "دکمه دسته بازی رها شد"
    pub func IsGamepadButtonReleased(gamepad: int, button: int): bool
    @en "IsGamepadButtonUp"
    @fa "دکمه دسته بازی بالا است"
    pub func IsGamepadButtonUp(gamepad: int, button: int): bool
    @en "GetGamepadButtonPressed"
    @fa "دکمه دسته بازی فشرده‌شده"
    pub func GetGamepadButtonPressed(): int
    @en "GetGamepadAxisCount"
    @fa "شمار محورهای دسته بازی"
    pub func GetGamepadAxisCount(gamepad: int): int
    @en "GetGamepadAxisMovement"
    @fa "حرکت محور دسته بازی"
    pub func GetGamepadAxisMovement(gamepad: int, axis: int): f32
    @en "SetGamepadMappings"
    @fa "تنظیم نگاشت دسته بازی"
    pub func SetGamepadMappings(mappings: str): int
    @en "SetGamepadVibration"
    @fa "تنظیم لرزش دسته بازی"
    pub func SetGamepadVibration(gamepad: int, leftMotor: f32, rightMotor: f32, duration: f32)
    @en "IsMouseButtonPressed"
    @fa "دکمه ماوس فشرده شد"
    pub func IsMouseButtonPressed(button: int): bool
    @en "IsMouseButtonDown"
    @fa "دکمه ماوس پایین است"
    pub func IsMouseButtonDown(button: int): bool
    @en "IsMouseButtonReleased"
    @fa "دکمه ماوس رها شد"
    pub func IsMouseButtonReleased(button: int): bool
    @en "IsMouseButtonUp"
    @fa "دکمه ماوس بالا است"
    pub func IsMouseButtonUp(button: int): bool
    @en "GetMouseX"
    @fa "ایکس ماوس"
    pub func GetMouseX(): int
    @en "GetMouseY"
    @fa "وای ماوس"
    pub func GetMouseY(): int
    @en "GetMousePosition"
    @fa "مکان ماوس"
    pub func GetMousePosition(): Vector2
    @en "GetMouseDelta"
    @fa "جابه‌جایی ماوس"
    pub func GetMouseDelta(): Vector2
    @en "SetMousePosition"
    @fa "تنظیم مکان ماوس"
    pub func SetMousePosition(x: int, y: int)
    @en "SetMouseOffset"
    @fa "تنظیم انحراف ماوس"
    pub func SetMouseOffset(offsetX: int, offsetY: int)
    @en "SetMouseScale"
    @fa "تنظیم مقیاس ماوس"
    pub func SetMouseScale(scaleX: f32, scaleY: f32)
    @en "GetMouseWheelMove"
    @fa "حرکت چرخ ماوس"
    pub func GetMouseWheelMove(): f32
    @en "GetMouseWheelMoveV"
    @fa "حرکت برداری چرخ ماوس"
    pub func GetMouseWheelMoveV(): Vector2
    @en "SetMouseCursor"
    @fa "تنظیم شکل نشانگر ماوس"
    pub func SetMouseCursor(cursor: int)
    @en "GetTouchX"
    @fa "ایکس لمس"
    pub func GetTouchX(): int
    @en "GetTouchY"
    @fa "وای لمس"
    pub func GetTouchY(): int
    @en "GetTouchPosition"
    @fa "مکان لمس"
    pub func GetTouchPosition(index: int): Vector2
    @en "GetTouchPointId"
    @fa "شناسه نقطه لمس"
    pub func GetTouchPointId(index: int): int
    @en "GetTouchPointCount"
    @fa "شمار نقطه‌های لمس"
    pub func GetTouchPointCount(): int
    @en "SetGesturesEnabled"
    @fa "فعال کردن ژست‌ها"
    pub func SetGesturesEnabled(flags: u32)
    @en "IsGestureDetected"
    @fa "ژست شناسایی شد"
    pub func IsGestureDetected(gesture: u32): bool
    @en "GetGestureDetected"
    @fa "ژست شناسایی‌شده"
    pub func GetGestureDetected(): int
    @en "GetGestureHoldDuration"
    @fa "مدت نگه داشتن ژست"
    pub func GetGestureHoldDuration(): f32
    @en "GetGestureDragVector"
    @fa "بردار کشیدن ژست"
    pub func GetGestureDragVector(): Vector2
    @en "GetGestureDragAngle"
    @fa "زاویه کشیدن ژست"
    pub func GetGestureDragAngle(): f32
    @en "GetGesturePinchVector"
    @fa "بردار انبری ژست"
    pub func GetGesturePinchVector(): Vector2
    @en "GetGesturePinchAngle"
    @fa "زاویه انبری ژست"
    pub func GetGesturePinchAngle(): f32
    @en "UpdateCamera"
    @fa "به‌روزرسانی دوربین"
    pub func UpdateCamera(camera &: Camera3D, mode: int)
    @en "UpdateCameraPro"
    @fa "به‌روزرسانی پیشرفته دوربین"
    pub func UpdateCameraPro(camera &: Camera3D, movement: Vector3, rotation: Vector3, zoom: f32)
end

@en "SetGamepadVibration"
@fa "تنظیم لرزش دسته بازی"
pub func SetGamepadVibration(gamepad: int, leftMotor: f64, rightMotor: f64, duration: f64):
    SetGamepadVibration(gamepad, leftMotor as f32, rightMotor as f32, duration as f32)
end

@en "SetMouseScale"
@fa "تنظیم مقیاس ماوس"
pub func SetMouseScale(scaleX: f64, scaleY: f64):
    SetMouseScale(scaleX as f32, scaleY as f32)
end

@en "UpdateCameraPro"
@fa "به‌روزرسانی پیشرفته دوربین"
pub func UpdateCameraPro(camera &: Camera3D, movement: Vector3, rotation: Vector3, zoom: f64):
    UpdateCameraPro(camera, movement, rotation, zoom as f32)
end
