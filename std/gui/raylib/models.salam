@en "DrawCircle3D"
@fa "رسم دایره سه‌بعدی"
pub func DrawCircle3D(center: Vector3, radius: f64, rotationAxis: Vector3, rotationAngle: f64, color: Color):
    DrawCircle3D(center, radius as f32, rotationAxis, rotationAngle as f32, color)
end

@en "DrawCube"
