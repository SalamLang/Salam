package raylib

extern:
    @en "GetFontDefault"
    @fa "قلم پیش‌فرض"
    pub func GetFontDefault(): Font
    @en "LoadFont"
    @fa "بارگذاری قلم"
    pub func LoadFont(fileName: str): Font
    @en "LoadFontEx"
    @fa "بارگذاری قلم گسترده"
    pub func LoadFontEx(fileName: str, fontSize: int, codepoints: int*, codepointCount: int): Font
    @en "LoadFontFromImage"
    @fa "بارگذاری قلم از تصویر"
    pub func LoadFontFromImage(image: Image, key: Color, firstChar: int): Font
    @en "IsFontValid"
    @fa "قلم معتبر است"
    pub func IsFontValid(font: Font): bool
    @en "UnloadFont"
    @fa "آزادسازی قلم"
    pub func UnloadFont(font: Font)
    @en "DrawFPS"
    @fa "رسم نرخ فریم"
    pub func DrawFPS(posX: int, posY: int)
    @en "DrawText"
    @fa "رسم متن"
    pub func DrawText(text: str, posX: int, posY: int, fontSize: int, color: Color)
    @en "DrawTextEx"
    @fa "رسم متن با قلم"
    pub func DrawTextEx(font: Font, text: str, position: Vector2, fontSize: f32, spacing: f32, tint: Color)
    @en "DrawTextPro"
    @fa "رسم پیشرفته متن"
    pub func DrawTextPro(font: Font, text: str, position: Vector2, origin: Vector2, rotation: f32, fontSize: f32, spacing: f32, tint: Color)
    @en "DrawTextCodepoint"
    @fa "رسم نویسه"
    pub func DrawTextCodepoint(font: Font, codepoint: int, position: Vector2, fontSize: f32, tint: Color)
    @en "SetTextLineSpacing"
    @fa "تنظیم فاصله خطوط متن"
    pub func SetTextLineSpacing(spacing: int)
    @en "MeasureText"
    @fa "اندازه‌گیری متن"
    pub func MeasureText(text: str, fontSize: int): int
    @en "MeasureTextEx"
    @fa "اندازه‌گیری متن با قلم"
    pub func MeasureTextEx(font: Font, text: str, fontSize: f32, spacing: f32): Vector2
    @en "GetGlyphIndex"
    @fa "اندیس نویسه"
    pub func GetGlyphIndex(font: Font, codepoint: int): int
    @en "TextLength"
    @fa "طول متن"
    pub func TextLength(text: str): u32
    @en "TextIsEqual"
    @fa "متن‌ها برابرند"
    pub func TextIsEqual(text1: str, text2: str): bool
    @en "TextSubtext"
    @fa "زیرمتن"
    pub func TextSubtext(text: str, position: int, length: int): str
    @en "TextReplace"
    @fa "جایگزینی در متن"
    pub func TextReplace(text: str, search: str, replacement: str): str
    @en "TextFindIndex"
    @fa "اندیس یافتن در متن"
    pub func TextFindIndex(text: str, find: str): int
    @en "TextToUpper"
    @fa "متن به حروف بزرگ"
    pub func TextToUpper(text: str): str
    @en "TextToLower"
    @fa "متن به حروف کوچک"
    pub func TextToLower(text: str): str
    @en "TextToPascal"
    @fa "متن به قالب پاسکال"
    pub func TextToPascal(text: str): str
    @en "TextToSnake"
    @fa "متن به قالب مار"
    pub func TextToSnake(text: str): str
    @en "TextToCamel"
    @fa "متن به قالب شتر"
    pub func TextToCamel(text: str): str
    @en "TextToInteger"
    @fa "متن به عدد صحیح"
    pub func TextToInteger(text: str): int
end

@en "DrawTextEx"
@fa "رسم متن با قلم"
pub func DrawTextEx(font: Font, text: str, position: Vector2, fontSize: f64, spacing: f64, tint: Color):
    DrawTextEx(font, text, position, fontSize as f32, spacing as f32, tint)
end

@en "DrawTextPro"
@fa "رسم پیشرفته متن"
pub func DrawTextPro(font: Font, text: str, position: Vector2, origin: Vector2, rotation: f64, fontSize: f64, spacing: f64, tint: Color):
    DrawTextPro(font, text, position, origin, rotation as f32, fontSize as f32, spacing as f32, tint)
end

@en "DrawTextCodepoint"
@fa "رسم نویسه"
pub func DrawTextCodepoint(font: Font, codepoint: int, position: Vector2, fontSize: f64, tint: Color):
    DrawTextCodepoint(font, codepoint, position, fontSize as f32, tint)
end

@en "MeasureTextEx"
@fa "اندازه‌گیری متن با قلم"
pub func MeasureTextEx(font: Font, text: str, fontSize: f64, spacing: f64): Vector2:
    ret MeasureTextEx(font, text, fontSize as f32, spacing as f32)
end
