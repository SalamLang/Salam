@en "GenImageGradientRadial"
@fa "تولید تصویر شیب شعاعی"
pub func GenImageGradientRadial(width: int, height: int, density: f64, inner: Color, outer: Color): Image:
    ret GenImageGradientRadial(width, height, density as f32, inner, outer)
end

@en "GenImageGradientSquare"
@fa "تولید تصویر شیب مربعی"
pub func GenImageGradientSquare(width: int, height: int, density: f64, inner: Color, outer: Color): Image:
    ret GenImageGradientSquare(width, height, density as f32, inner, outer)
end

@en "GenImageWhiteNoise"
@fa "تولید نویز سفید"
pub func GenImageWhiteNoise(width: int, height: int, factor: f64): Image:
    ret GenImageWhiteNoise(width, height, factor as f32)
end

@en "GenImagePerlinNoise"
@fa "تولید نویز پرلین"
pub func GenImagePerlinNoise(width: int, height: int, offsetX: int, offsetY: int, scale: f64): Image:
    ret GenImagePerlinNoise(width, height, offsetX, offsetY, scale as f32)
end

@en "ImageAlphaCrop"
@fa "برش شفافیت تصویر"
pub func ImageAlphaCrop(image &: Image, threshold: f64):
    ImageAlphaCrop(image, threshold as f32)
end

@en "ImageAlphaClear"
@fa "پاک کردن شفافیت تصویر"
pub func ImageAlphaClear(image &: Image, color: Color, threshold: f64):
    ImageAlphaClear(image, color, threshold as f32)
end

@en "ImageColorContrast"
@fa "تنظیم تضاد تصویر"
pub func ImageColorContrast(image &: Image, contrast: f64):
    ImageColorContrast(image, contrast as f32)
end

@en "GetImageAlphaBorder"
@fa "کرانه شفافیت تصویر"
pub func GetImageAlphaBorder(image: Image, threshold: f64): Rectangle:
    ret GetImageAlphaBorder(image, threshold as f32)
end

@en "DrawTextureEx"
@fa "رسم بافت چرخان"
pub func DrawTextureEx(texture: Texture, position: Vector2, rotation: f64, scale: f64, tint: Color):
    DrawTextureEx(texture, position, rotation as f32, scale as f32, tint)
end

@en "DrawTexturePro"
@fa "رسم پیشرفته بافت"
pub func DrawTexturePro(texture: Texture, source: Rectangle, dest: Rectangle, origin: Vector2, rotation: f64, tint: Color):
    DrawTexturePro(texture, source, dest, origin, rotation as f32, tint)
end

@en "DrawTextureNPatch"
@fa "رسم بافت تکه‌های نه‌گانه"
pub func DrawTextureNPatch(texture: Texture, nPatchInfo: NPatchInfo, dest: Rectangle, origin: Vector2, rotation: f64, tint: Color):
    DrawTextureNPatch(texture, nPatchInfo, dest, origin, rotation as f32, tint)
end

@en "Fade"
@fa "کم‌رنگ کردن"
pub func Fade(color: Color, alpha: f64): Color:
    ret Fade(color, alpha as f32)
end

@en "ColorFromHSV"
@fa "رنگ از اچ‌اس‌وی"
pub func ColorFromHSV(hue: f64, saturation: f64, value: f64): Color:
    ret ColorFromHSV(hue as f32, saturation as f32, value as f32)
end

@en "ColorBrightness"
@fa "روشنایی رنگ"
pub func ColorBrightness(color: Color, factor: f64): Color:
    ret ColorBrightness(color, factor as f32)
end

@en "ColorContrast"
@fa "تضاد رنگ"
pub func ColorContrast(color: Color, contrast: f64): Color:
    ret ColorContrast(color, contrast as f32)
end

@en "ColorAlpha"
@fa "شفافیت رنگ"
pub func ColorAlpha(color: Color, alpha: f64): Color:
    ret ColorAlpha(color, alpha as f32)
end

@en "ColorLerp"
@fa "درون‌یابی رنگ"
pub func ColorLerp(color1: Color, color2: Color, factor: f64): Color:
    ret ColorLerp(color1, color2, factor as f32)
