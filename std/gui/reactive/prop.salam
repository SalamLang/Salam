package reactive

import mem

struct PropCell<T>:
    pub value: T
    pub calc: func () T
end

@en "Prop"
@fa "ویژگی"
pub struct Prop<T>:
    @en "node"
    @fa "گره"
    pub node: int = -1
    @en "cell"
    @fa "خانه"
    pub cell: void* = null

    @en "Get"
    @fa "بخوان"
    pub func Get(): T:
        _rx_get_raw(this.node)
        pc := this.cell as PropCell<T>*
        ret pc[0].value
    end

    @en "Peek"
    @fa "نگاه"
    pub func Peek(): T:
        _rx_update(this.node)
        pc := this.cell as PropCell<T>*
        ret pc[0].value
    end

    @en "Set"
    @fa "بنشان"
    pub func Set(v: T):
        if not _rx_check_set(this.node):
            ret
        end
        _rx_drop_binding(this.node)
        pc := this.cell as PropCell<T>*
        pc[0].value = v
        _rx_changed(this.node)
    end

    @en "Bind"
    @fa "پیوند"
    pub func Bind(calc: func () T):
        pc := this.cell as PropCell<T>*
        pc[0].calc = calc
        th := (c: void*):
            q := c as PropCell<T>*
            g := q[0].calc
            q[0].value = g()
        end
        _rx_bind_fn(this.node, _B_CTX, _rx_slot_ctx(th, this.cell))
    end

    @en "OnChange"
    @fa "هنگام تغییر"
    pub func OnChange(body: func ()): Handler:
        ret _rx_on_change(this.node, body)
    end

    @en "Name"
    @fa "نام بده"
    pub func Name(name: str): Prop<T>:
        _rx_set_name(this.node, name)
        ret this[0]
    end

    @en "HasBinding"
    @fa "پیوند دارد"
    pub func HasBinding(): bool:
        ret _rx_has_binding(this.node)
    end

    @en "Free"
    @fa "آزاد کن"
    pub func Free():
        if this.cell == null:
            ret
        end
        _rx_node_free(this.node)
        mem.Free(this.cell)
    end
end

@en "NewProp"
@fa "ویژگی تازه"
pub func NewProp<T>(v: T): Prop<T>:
    pc := mem.AllocateZeroed(sizeof(PropCell<T>)) as PropCell<T>*
    pc[0].value = v
    n := _rx_node_new(_K_EXT)
    ret Prop { node = n, cell = pc as void* }
end
