func _rx_has_binding(n: int): bool:
    if n < 0 or not _rx_live(n):
        ret false
    end
    b := _n_bind.get(n)
    if b >= 0 and _b_kind.get(b) == _B_ANIM:
        ret _rx_has_binding(_rx_anim_target(_b_aux.get(b)))
    end
    ret b >= 0
end

func _rx_is_dirty(n: int): bool:
    ret n >= 0 and _rx_live(n) and (_n_flags.get(n) & _F_DIRTY) != 0
end

func _rx_route(n: int): int:
    if n < 0:
        _rx_error("a constant property cannot be set")
        ret -1
    end
    if not _rx_live(n):
        _rx_error("set on a freed property")
        ret -1
    end
    if not _rx_check_set(n):
        ret -1
    end
    b := _n_bind.get(n)
    if b < 0:
        ret n
    end
    bk := _b_kind.get(b)
    if bk == _B_TWOWAY:
        ret _rx_route(_b_aux.get(b))
    end
    if bk == _B_ANIM:
        ret _rx_route(_rx_anim_target(_b_aux.get(b)))
    end
    _rx_drop_binding(n)
    ret n
end

func _rx_bind_target(n: int): int:
    if n < 0:
        _rx_error("a constant property cannot be bound")
        ret -1
    end
    if not _rx_live(n):
        _rx_error("bind on a freed property")
        ret -1
    end
    b := _n_bind.get(n)
    if b >= 0:
        bk := _b_kind.get(b)
        if bk == _B_TWOWAY:
            ret _rx_bind_target(_b_aux.get(b))
        end
        if bk == _B_ANIM:
            ret _rx_bind_target(_rx_anim_target(_b_aux.get(b)))
        end
    end
    ret n
end

func _rx_notify(n: int):
    if _n_deps.get(n) >= 0:
        _rx_push_hold()
        _rx_mark(n)
        _rx_pop_hold()
    end
end

func _rx_set_scalar(n: int, v: i64):
    t := _rx_route(n)
    if t < 0:
        ret
    end
    if _rx_store_raw(t, v):
        _rx_notify(t)
    end
end

func _rx_set_f64(n: int, v: f64):
    t := _rx_route(n)
    if t < 0:
        ret
    end
    if _rx_store_f64(t, v):
        _rx_notify(t)
    end
end

func _rx_set_str(n: int, v: str):
    t := _rx_route(n)
    if t < 0:
        ret
    end
    if _rx_store_str(t, v, false):
        _rx_notify(t)
    end
end

func _rx_new_node_like(kind: int): int:
    n := _rx_node_new(kind)
    if kind == _K_F64:
        _n_val.set(n, _rx_f64_slot(0.0) as i64)
    else kind == _K_STR:
        _n_val.set(n, _rx_str_slot(str.Clone("")) as i64)
    end
    ret n
end

func _rx_copy_value(dst: int, src: int): bool:
    k := _rx_kind(dst)
    if k == _K_F64:
        ret _rx_store_f64(dst, _f64s.get(_n_val.get(src) as int))
    else k == _K_STR:
        ret _rx_store_str(dst, _strs.get(_n_val.get(src) as int), false)
    end
    ret _rx_store_raw(dst, _n_val.get(src))
end

func _rx_move_binding(src: int, dst: int):
    b := _n_bind.get(src)
    if b < 0:
        ret
    end
    _n_bind.set(src, -1)
    _n_bind.set(dst, b)
    _b_node.set(b, dst)
    mut e := _b_reads.get(b)
    until e >= 0:
        _e_dep.set(e, dst)
        e = _e_bnext.get(e)
    end
    if (_n_flags.get(src) & _F_DIRTY) != 0:
        _n_flags.set(dst, _n_flags.get(dst) | _F_DIRTY)
        _n_flags.set(src, _n_flags.get(src) & ~_F_DIRTY)
    end
end

func _rx_shared_of(n: int): int:
    b := _n_bind.get(n)
    if b >= 0 and _b_kind.get(b) == _B_TWOWAY:
        ret _b_aux.get(b)
    end
    ret -1
end

func _rx_shared_release(c: int):
    if not _shared_refs.has(c):
        ret
    end
    r := _shared_refs.get(c) - 1
    if r <= 0:
        _shared_refs.remove(c)
        _rx_node_free(c)
    else:
        _shared_refs.put(c, r)
    end
end

func _rx_join(n: int, c: int):
    if _rx_shared_of(n) == c:
        ret
    end
    _rx_drop_binding(n)
    _p := _rx_bind_new(n, _B_TWOWAY, -1, c)
    if _shared_refs.has(c):
        _shared_refs.put(c, _shared_refs.get(c) + 1)
    else:
        _shared_refs.put(c, 1)
    end
    _rx_mark_self(n)
end

func _rx_link(a: int, b: int):
    if a < 0 or b < 0:
        _rx_error("a constant property cannot be linked")
        ret
    end
    if not _rx_live(a) or not _rx_live(b) or a == b:
        ret
    end
    if _rx_kind(a) != _rx_kind(b):
        _rx_error("linked properties must have the same type")
        ret
    end
    ba := _n_bind.get(a)
    bb := _n_bind.get(b)
    if (ba >= 0 and _b_kind.get(ba) == _B_ANIM) or (bb >= 0 and _b_kind.get(bb) == _B_ANIM):
        _rx_error("an animated property cannot be linked")
        ret
    end
    mut c := _rx_shared_of(a)
    if c >= 0:
        _rx_join(b, c)
        ret
    end
    c = _rx_shared_of(b)
    if c >= 0:
        _rx_join(a, c)
        ret
    end
    _rx_update(a)
    c = _rx_new_node_like(_rx_kind(a))
    _p := _rx_copy_value(c, a)
    _rx_move_binding(a, c)
    _rx_join(a, c)
    _rx_join(b, c)
end

func _rx_unlink(n: int):
    if n < 0 or not _rx_live(n):
        ret
    end
    if _rx_shared_of(n) < 0:
        ret
    end
    _rx_update(n)
    _rx_drop_binding(n)
end

func _rx_eval_twoway(n: int, c: int):
    _rx_get_raw(c)
    _p := _rx_copy_value(n, c)
end

@en "NewInt"
@fa "صحیح تازه"
pub func NewInt(v: int): IntProp:
    n := _rx_node_new(_K_INT)
    _n_val.set(n, v as i64)
    ret IntProp { node = n }
end

@en "NewI64"
@fa "صحیح۶۴ تازه"
pub func NewI64(v: i64): I64Prop:
    n := _rx_node_new(_K_I64)
    _n_val.set(n, v)
    ret I64Prop { node = n }
end

@en "NewF64"
@fa "اعشاری تازه"
pub func NewF64(v: f64): F64Prop:
    n := _rx_node_new(_K_F64)
    _n_val.set(n, _rx_f64_slot(v) as i64)
    ret F64Prop { node = n }
end

@en "NewBool"
@fa "منطقی تازه"
pub func NewBool(v: bool): BoolProp:
    n := _rx_node_new(_K_BOOL)
    if v:
        _n_val.set(n, 1 as i64)
    end
    ret BoolProp { node = n }
end

@en "NewStr"
@fa "متن تازه"
pub func NewStr(v: str): StrProp:
    n := _rx_node_new(_K_STR)
    _n_val.set(n, _rx_str_slot(str.Clone(v)) as i64)
    ret StrProp { node = n }
end

@en "ConstInt"
@fa "صحیح ثابت"
pub func ConstInt(v: int): IntProp:
    ret IntProp { fixed = v }
end

@en "ConstI64"
@fa "صحیح۶۴ ثابت"
pub func ConstI64(v: i64): I64Prop:
    ret I64Prop { fixed = v }
end

@en "ConstF64"
@fa "اعشاری ثابت"
pub func ConstF64(v: f64): F64Prop:
    ret F64Prop { fixed = v }
end

@en "ConstBool"
@fa "منطقی ثابت"
pub func ConstBool(v: bool): BoolProp:
    ret BoolProp { fixed = v }
end

@en "ConstStr"
@fa "متن ثابت"
pub func ConstStr(v: str): StrProp:
    ret StrProp { fixed = v }
end

@en "Link"
@fa "همبند کن"
pub func Link(a: IntProp, b: IntProp):
    _rx_link(a.node, b.node)
end

@en "Link"
@fa "همبند کن"
pub func Link(a: I64Prop, b: I64Prop):
    _rx_link(a.node, b.node)
end

@en "Link"
@fa "همبند کن"
pub func Link(a: F64Prop, b: F64Prop):
    _rx_link(a.node, b.node)
end

@en "Link"
@fa "همبند کن"
pub func Link(a: BoolProp, b: BoolProp):
    _rx_link(a.node, b.node)
end

@en "Link"
@fa "همبند کن"
pub func Link(a: StrProp, b: StrProp):
    _rx_link(a.node, b.node)
end
