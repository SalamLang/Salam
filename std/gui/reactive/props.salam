package reactive

import mem
import str

@en "IntProp"
@fa "ویژگی‌صحیح"
pub struct IntProp:
    @en "node"
    @fa "گره"
    pub node: int = -1
    @en "fixed"
    @fa "مقدار ثابت"
    pub fixed: int = 0

    @en "Get"
    @fa "بخوان"
    pub func Get(): int:
        if this.node < 0:
            ret this.fixed
        end
        _rx_get_raw(this.node)
        ret _n_val.get(this.node) as int
    end

    @en "Peek"
    @fa "نگاه"
    pub func Peek(): int:
        if this.node < 0:
            ret this.fixed
        end
        _rx_update(this.node)
        ret _n_val.get(this.node) as int
    end

    @en "Set"
    @fa "بنشان"
    pub func Set(v: int):
        _rx_set_scalar(this.node, v as i64)
    end

    @en "Bind"
    @fa "پیوند"
    pub func Bind(calc: func () int):
        t := _rx_bind_target(this.node)
        if t >= 0:
            _rx_bind_fn(t, _B_INT, _rx_slot_int(calc))
        end
    end

    @en "Animate"
    @fa "پویانمایی"
    pub func Animate(spec: Animation):
        _rx_animate(this.node, spec)
    end

    @en "Name"
    @fa "نام بده"
    pub func Name(name: str): IntProp:
        _rx_set_name(this.node, name)
        ret this[0]
    end

    @en "HasBinding"
    @fa "پیوند دارد"
    pub func HasBinding(): bool:
        ret _rx_has_binding(this.node)
    end

    @en "IsDirty"
    @fa "کهنه است"
    pub func IsDirty(): bool:
        ret _rx_is_dirty(this.node)
    end

    @en "Unlink"
    @fa "جدا کن"
    pub func Unlink():
        _rx_unlink(this.node)
    end

    @en "Free"
    @fa "آزاد کن"
    pub func Free():
        _rx_node_free(this.node)
    end
end

