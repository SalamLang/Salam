@en "BoolProp"
@fa "ویژگی‌منطقی"
pub struct BoolProp:
    @en "node"
    @fa "گره"
    pub node: int = -1
    @en "fixed"
    @fa "مقدار ثابت"
    pub fixed: bool = false

    @en "Get"
    @fa "بخوان"
    pub func Get(): bool:
        if this.node < 0:
            ret this.fixed
        end
        _rx_get_raw(this.node)
        ret _n_val.get(this.node) != 0
    end

    @en "Peek"
    @fa "نگاه"
    pub func Peek(): bool:
        if this.node < 0:
            ret this.fixed
        end
        _rx_update(this.node)
        ret _n_val.get(this.node) != 0
    end

    @en "Set"
    @fa "بنشان"
    pub func Set(v: bool):
        mut raw := 0 as i64
        if v:
            raw = 1 as i64
        end
        _rx_set_scalar(this.node, raw)
    end

    @en "Bind"
    @fa "پیوند"
    pub func Bind(calc: func () bool):
        t := _rx_bind_target(this.node)
        if t >= 0:
            _rx_bind_fn(t, _B_BOOL, _rx_slot_bool(calc))
        end
    end

    @en "Name"
    @fa "نام بده"
    pub func Name(name: str): BoolProp:
        _rx_set_name(this.node, name)
        ret this[0]
    end

    @en "HasBinding"
    @fa "پیوند دارد"
    pub func HasBinding(): bool:
        ret _rx_has_binding(this.node)
    end

    @en "IsDirty"
    @fa "کهنه است"
    pub func IsDirty(): bool:
        ret _rx_is_dirty(this.node)
    end

    @en "Unlink"
    @fa "جدا کن"
    pub func Unlink():
        _rx_unlink(this.node)
    end

    @en "Free"
    @fa "آزاد کن"
    pub func Free():
        _rx_node_free(this.node)
    end
end

