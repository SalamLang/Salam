]

noinline func _it(v: Value, i: int): Item:
    if i < 0 or i >= v.items.Len():
        ret Item {}
    end
    ret v.items.Get(i)
end

func _dim_of(it: Item): Dim:
    if it.kind == ITEM_WORD:
        ret Dim { word = it.word }
    end
    ret Dim { len = it.len }
end

func _dim_item(d: Dim): Item:
    if d.word != 0:
        ret OfWord(d.word)
    end
    ret OfLen(d.len)
end

func _side_index(n: int, k: int): int:
    if n == 1:
        ret 0
    end
    if n == 2:
        ret k % 2
    end
    if n == 3 and k == 3:
        ret 1
    end
    ret k
end

noinline func _side4(v: Value, k: int): Item:
    ret _it(v, _side_index(v.items.Len(), k))
end

noinline func _put_len(d &: Len, v &: Len):
    d = v
end

noinline func _put_color(d &: color.Color, v &: color.Color):
    d = v
end

noinline func _put_dim(d &: Dim, it &: Item):
    d = _dim_of(it)
end

func _physical(direction: int, word: int): int:
    rtl := direction == KW_RTL
    if word == KW_LEFT:
        ret rtl ? KW_END : KW_START
    end
    if word == KW_RIGHT:
        ret rtl ? KW_START : KW_END
    end
    ret word
end

func _set_inset(s &: Style, side: int, d &: Dim):
    switch side:
        KW_TOP: s.inset_top = d break end
        KW_END: s.inset_end = d break end
        KW_BOTTOM: s.inset_bottom = d break end
        KW_START: s.inset_start = d break end
    end
end

func _set_padding(s &: Style, side: int, l &: Len):
    switch side:
        KW_TOP: s.padding_top = l break end
        KW_END: s.padding_end = l break end
        KW_BOTTOM: s.padding_bottom = l break end
        KW_START: s.padding_start = l break end
    end
end

func _set_margin(s &: Style, side: int, d &: Dim):
    switch side:
        KW_TOP: s.margin_top = d break end
        KW_END: s.margin_end = d break end
        KW_BOTTOM: s.margin_bottom = d break end
        KW_START: s.margin_start = d break end
    end
end

noinline func _set_border(s &: Style, side: int, w &: Len, st: int, c &: color.Color):
    switch side:
        KW_TOP:
            s.border_top_width = w
            s.border_top_style = st
            s.border_top_color = c
            break
        end
        KW_END:
            s.border_end_width = w
            s.border_end_style = st
            s.border_end_color = c
            break
        end
        KW_BOTTOM:
            s.border_bottom_width = w
            s.border_bottom_style = st
            s.border_bottom_color = c
            break
        end
        KW_START:
            s.border_start_width = w
            s.border_start_style = st
            s.border_start_color = c
            break
        end
    end
end

noinline func _set_side_dim(s &: Style, prop: int, side: int, it &: Item):
    mut d := _dim_of(it)
    switch prop:
        P_INSET, P_LEFT, P_RIGHT: _set_inset(s, side, d) break end
        else: _set_margin(s, side, d) break end
    end
end

noinline func _set_side_padding(s &: Style, side: int, it &: Item):
    _set_padding(s, side, it.len)
end

noinline func _set_border_value(s &: Style, side: int, v: Value):
    mut w := _it(v, 0)
    st := _it(v, 1)
    mut c := _it(v, 2)
    _set_border(s, side, w.len, st.word, c.color)
end

noinline func _put_side_len(d &: Len, v: Value, k: int):
    it := _side4(v, k)
    d = it.len
end

noinline func _put_side_color(d &: color.Color, v: Value, k: int):
    it := _side4(v, k)
    d = it.color
end

func _sides(): int[4]:
    ret [KW_TOP, KW_END, KW_BOTTOM, KW_START]
end

func _weight(it: Item): int:
    if it.kind != ITEM_WORD:
        ret it.num as int
    end
    switch it.word:
        KW_THIN: ret 100 end
        KW_LIGHT: ret 300 end
        KW_MEDIUM: ret 500 end
        KW_SEMIBOLD: ret 600 end
        KW_BOLD: ret 700 end
        KW_BLACK: ret 900 end
    end
    ret 400
end

func _paint_of(it: Item): Paint:
    if it.kind == ITEM_COLOR:
        ret Paint { kind = PAINT_COLOR, color = it.color }
    end
    ret it.paint
end

func _shadows(v: Value, text: bool): Vector<Shadow>:
    mut out := Vector {} as Vector<Shadow>
    if v.items.Len() == 0 or _it(v, 0).kind == ITEM_WORD:
        ret out
    end
    each g in v.starts:
        if text:
            out.Push(Shadow {
                x = _it(v, g).len,
                y = _it(v, g + 1).len,
                blur = _it(v, g + 2).len,
                color = _it(v, g + 3).color
            })
        else:
            out.Push(Shadow {
                x = _it(v, g).len,
                y = _it(v, g + 1).len,
                blur = _it(v, g + 2).len,
                spread = _it(v, g + 3).len,
                color = _it(v, g + 4).color,
                inset = _it(v, g + 5).num != 0.0
            })
        end
    end
    ret out
end

func _tracks(v: Value): Vector<Track>:
    mut out := Vector {} as Vector<Track>
    each it in v.items:
        if it.kind == ITEM_TRACK:
            out.Push(it.track)
        end
    end
    ret out
end

func _set_filter(s &: Style, prop: int, it &: Item):
    switch prop:
        P_BLUR: s.blur = it.len break end
        P_BRIGHTNESS: s.brightness = it.num break end
        P_CONTRAST: s.contrast = it.num break end
        P_GRAYSCALE: s.grayscale = it.num break end
        P_SATURATE: s.saturate = it.num break end
        P_SEPIA: s.sepia = it.num break end
        P_INVERT: s.invert = it.num break end
        P_HUE_ROTATE: s.hue_rotate = it.num break end
        P_BACKDROP_BLUR: s.backdrop_blur = it.len break end
        P_BACKDROP_BRIGHTNESS: s.backdrop_brightness = it.num break end
        P_BACKDROP_CONTRAST: s.backdrop_contrast = it.num break end
        P_BACKDROP_GRAYSCALE: s.backdrop_grayscale = it.num break end
        P_BACKDROP_SATURATE: s.backdrop_saturate = it.num break end
        P_BACKDROP_SEPIA: s.backdrop_sepia = it.num break end
        P_BACKDROP_INVERT: s.backdrop_invert = it.num break end
        P_BACKDROP_HUE_ROTATE: s.backdrop_hue_rotate = it.num break end
    end
end

noinline func _get_filter(s &: Style, prop: int): Item:
    switch prop:
        P_BLUR: ret OfLen(s.blur) end
        P_BRIGHTNESS: ret OfNum(s.brightness) end
        P_CONTRAST: ret OfNum(s.contrast) end
        P_GRAYSCALE: ret OfNum(s.grayscale) end
        P_SATURATE: ret OfNum(s.saturate) end
        P_SEPIA: ret OfNum(s.sepia) end
        P_INVERT: ret OfNum(s.invert) end
        P_HUE_ROTATE: ret OfAngle(s.hue_rotate) end
        P_BACKDROP_BLUR: ret OfLen(s.backdrop_blur) end
        P_BACKDROP_BRIGHTNESS: ret OfNum(s.backdrop_brightness) end
        P_BACKDROP_CONTRAST: ret OfNum(s.backdrop_contrast) end
        P_BACKDROP_GRAYSCALE: ret OfNum(s.backdrop_grayscale) end
        P_BACKDROP_SATURATE: ret OfNum(s.backdrop_saturate) end
        P_BACKDROP_SEPIA: ret OfNum(s.backdrop_sepia) end
        P_BACKDROP_INVERT: ret OfNum(s.backdrop_invert) end
        P_BACKDROP_HUE_ROTATE: ret OfAngle(s.backdrop_hue_rotate) end
    end
    ret Item {}
end

noinline func _len_value(a &: Len): Value:
    ret One(OfLen(a))
end

noinline func _dim_value(d &: Dim): Value:
    ret One(_dim_item(d))
end

noinline func _color_value(c &: color.Color): Value:
    ret One(OfColor(c))
end

noinline func _num_value(kind: int, n: f64): Value:
    ret One(Item { kind = kind, num = n })
end

noinline func _bool_value(b: bool): Value:
    ret _num_value(ITEM_BOOL, b ? 1.0 : 0.0)
end

noinline func _word_value(w: int): Value:
    ret One(OfWord(w))
end

noinline func _int_value(n: int): Value:
    ret One(OfInt(n))
end

noinline func _words(a: int, b: int): Value:
    ret One(OfWord(a)).And(OfWord(b))
end

noinline func _lens(a &: Len, b &: Len): Value:
    ret One(OfLen(a)).And(OfLen(b))
end

noinline func _dims(a &: Dim, b &: Dim): Value:
    ret One(_dim_item(a)).And(_dim_item(b))
end

noinline func _colors(a &: color.Color, b &: color.Color): Value:
    ret One(OfColor(a)).And(OfColor(b))
end

noinline func _nums(kind: int, a: f64, b: f64): Value:
    ret One(Item { kind = kind, num = a }).And(Item { kind = kind, num = b })
end

noinline func _four_lens(a &: Len, b &: Len, c &: Len, d &: Len): Value:
    ret _lens(a, b).And(OfLen(c)).And(OfLen(d))
end

noinline func _four_dims(a &: Dim, b &: Dim, c &: Dim, d &: Dim): Value:
    ret _dims(a, b).And(_dim_item(c)).And(_dim_item(d))
end

noinline func _four_colors(a &: color.Color, b &: color.Color, c &: color.Color, d &: color.Color): Value:
    ret _colors(a, b).And(OfColor(c)).And(OfColor(d))
end

func _shadow_value(list: Vector<Shadow>, text: bool): Value:
    if list.Len() == 0:
        ret One(OfWord(KW_NONE))
    end
    mut v := Value {}
    each sh in list:
        first := OfLen(sh.x)
        if v.items.Len() == 0:
            v = One(first)
        else:
            v = v.Then(first)
        end
        v = v.And(OfLen(sh.y)).And(OfLen(sh.blur))
        if not text:
            v = v.And(OfLen(sh.spread))
        end
        v = v.And(OfColor(sh.color))
        if not text:
            v = v.And(OfBool(sh.inset))
        end
    end
    ret v
end

func _tracks_value(list: Vector<Track>, empty: int): Value:
    if list.Len() == 0:
        ret One(OfWord(empty))
    end
    mut v := Value {}
    each tr in list:
        if v.items.Len() == 0:
            v = One(OfTrack(tr))
        else:
            v = v.And(OfTrack(tr))
        end
    end
    ret v
end

noinline func _border_value(w &: Len, st: int, c &: color.Color): Value:
    ret One(OfLen(w)).And(OfWord(st)).And(OfColor(c))
end

func _get(s &: Style, prop: int): Value:
    switch prop:
        P_LAYOUT: ret _word_value(s.layout_kind) end
        P_GAP: ret _lens(s.gap_row, s.gap_column) end
        P_ALIGN: ret _word_value(s.align) end
        P_JUSTIFY: ret _word_value(s.justify) end
        P_ALIGN_CONTENT: ret _word_value(s.align_content) end
        P_WRAP: ret _bool_value(s.wrap) end
        P_REVERSE: ret _bool_value(s.reverse) end
        P_COLUMNS: ret _tracks_value(s.columns, KW_NONE) end
        P_ROWS: ret _tracks_value(s.rows, KW_NONE) end
        P_AUTO_COLUMNS: ret _tracks_value(s.auto_columns, KW_AUTO) end
        P_AUTO_ROWS: ret _tracks_value(s.auto_rows, KW_AUTO) end
        P_AUTO_FLOW: ret _word_value(s.auto_flow) end
        P_GROW: ret _num_value(ITEM_NUM, s.grow) end
        P_SHRINK: ret _num_value(ITEM_NUM, s.shrink) end
        P_BASIS: ret _dim_value(s.basis) end
        P_ALIGN_SELF: ret _word_value(s.align_self) end
        P_JUSTIFY_SELF: ret _word_value(s.justify_self) end
        P_COLUMN: ret s.column == 0 ? _word_value(KW_AUTO) : _int_value(s.column) end
        P_ROW: ret s.row == 0 ? _word_value(KW_AUTO) : _int_value(s.row) end
        P_COLUMN_SPAN: ret _int_value(s.column_span) end
        P_ROW_SPAN: ret _int_value(s.row_span) end
        P_ORDER: ret _int_value(s.order) end
        P_POSITION: ret _word_value(s.position) end
        P_TOP: ret _dim_value(s.inset_top) end
        P_BOTTOM: ret _dim_value(s.inset_bottom) end
        P_START, P_LEFT:
            if _physical(s.direction, prop == P_LEFT ? KW_LEFT : KW_START) == KW_START:
                ret _dim_value(s.inset_start)
            end
            ret _dim_value(s.inset_end)
        end
        P_END, P_RIGHT:
            if _physical(s.direction, prop == P_RIGHT ? KW_RIGHT : KW_END) == KW_END:
                ret _dim_value(s.inset_end)
            end
            ret _dim_value(s.inset_start)
        end
        P_INSET: ret _four_dims(s.inset_top, s.inset_end, s.inset_bottom, s.inset_start) end
        P_LAYER: ret _int_value(s.layer) end
        P_WIDTH: ret _dim_value(s.width) end
        P_HEIGHT: ret _dim_value(s.height) end
        P_MIN_WIDTH: ret _dim_value(s.min_width) end
        P_MIN_HEIGHT: ret _dim_value(s.min_height) end
        P_MAX_WIDTH: ret _dim_value(s.max_width) end
        P_MAX_HEIGHT: ret _dim_value(s.max_height) end
        P_ASPECT_RATIO: ret One(s.aspect_ratio == 0.0 ? OfWord(KW_NONE) : OfNum(s.aspect_ratio)) end
        P_PADDING: ret _four_lens(s.padding_top, s.padding_end, s.padding_bottom, s.padding_start) end
        P_PADDING_TOP, P_PADDING_Y: ret _len_value(s.padding_top) end
        P_PADDING_BOTTOM: ret _len_value(s.padding_bottom) end
        P_PADDING_START, P_PADDING_X: ret _len_value(s.padding_start) end
        P_PADDING_END: ret _len_value(s.padding_end) end
        P_PADDING_LEFT:
            if _physical(s.direction, KW_LEFT) == KW_START:
                ret _len_value(s.padding_start)
            end
            ret _len_value(s.padding_end)
        end
        P_PADDING_RIGHT:
            if _physical(s.direction, KW_RIGHT) == KW_END:
                ret _len_value(s.padding_end)
            end
            ret _len_value(s.padding_start)
        end
        P_MARGIN: ret _four_dims(s.margin_top, s.margin_end, s.margin_bottom, s.margin_start) end
        P_MARGIN_TOP, P_MARGIN_Y: ret _dim_value(s.margin_top) end
        P_MARGIN_BOTTOM: ret _dim_value(s.margin_bottom) end
        P_MARGIN_START, P_MARGIN_X: ret _dim_value(s.margin_start) end
        P_MARGIN_END: ret _dim_value(s.margin_end) end
        P_MARGIN_LEFT:
            if _physical(s.direction, KW_LEFT) == KW_START:
                ret _dim_value(s.margin_start)
            end
            ret _dim_value(s.margin_end)
        end
        P_MARGIN_RIGHT:
            if _physical(s.direction, KW_RIGHT) == KW_END:
                ret _dim_value(s.margin_end)
            end
            ret _dim_value(s.margin_start)
        end
        P_OVERFLOW: ret _words(s.overflow_x, s.overflow_y) end
        P_OVERFLOW_X: ret _word_value(s.overflow_x) end
        P_OVERFLOW_Y: ret _word_value(s.overflow_y) end
        P_VISIBLE: ret _bool_value(s.visible) end
        P_CLIP: ret _bool_value(s.clip) end
        P_BACKGROUND:
            if s.background.Len() == 0:
                ret One(OfColor(color.Color { a = 0.0 }))
            end
            mut v := Value {}
            each p in s.background:
                it := p.kind == PAINT_COLOR ? OfColor(p.color) : OfPaint(p)
                v = v.items.Len() == 0 ? One(it) : v.And(it)
            end
            ret v
        end
        P_BACKGROUND_SIZE:
            if s.background_size_x.word == KW_COVER or s.background_size_x.word == KW_CONTAIN:
                ret One(OfWord(s.background_size_x.word))
            end
            ret _dims(s.background_size_x, s.background_size_y)
        end
        P_BACKGROUND_POSITION: ret _dims(s.background_x, s.background_y) end
        P_BACKGROUND_REPEAT: ret _word_value(s.background_repeat) end
        P_BORDER, P_BORDER_TOP: ret _border_value(s.border_top_width, s.border_top_style, s.border_top_color) end
        P_BORDER_BOTTOM: ret _border_value(s.border_bottom_width, s.border_bottom_style, s.border_bottom_color) end
        P_BORDER_START, P_BORDER_LEFT, P_BORDER_END, P_BORDER_RIGHT:
            mut side := prop == P_BORDER_START ? KW_START : (prop == P_BORDER_END ? KW_END : (prop == P_BORDER_LEFT ? KW_LEFT : KW_RIGHT))
            side = _physical(s.direction, side)
            if side == KW_START:
                ret _border_value(s.border_start_width, s.border_start_style, s.border_start_color)
            end
            ret _border_value(s.border_end_width, s.border_end_style, s.border_end_color)
        end
        P_BORDER_WIDTH: ret _four_lens(s.border_top_width, s.border_end_width, s.border_bottom_width, s.border_start_width) end
        P_BORDER_STYLE: ret _word_value(s.border_top_style) end
        P_BORDER_COLOR: ret _four_colors(s.border_top_color, s.border_end_color, s.border_bottom_color, s.border_start_color) end
        P_RADIUS: ret _four_lens(s.radius_top_start, s.radius_top_end, s.radius_bottom_end, s.radius_bottom_start) end
        P_RADIUS_TOP_START: ret _len_value(s.radius_top_start) end
        P_RADIUS_TOP_END: ret _len_value(s.radius_top_end) end
        P_RADIUS_BOTTOM_END: ret _len_value(s.radius_bottom_end) end
        P_RADIUS_BOTTOM_START: ret _len_value(s.radius_bottom_start) end
        P_OUTLINE: ret _border_value(s.outline_width, s.outline_style, s.outline_color) end
        P_OUTLINE_OFFSET: ret _len_value(s.outline_offset) end
        P_SHADOW: ret _shadow_value(s.shadow, false) end
        P_OPACITY: ret _num_value(ITEM_NUM, s.opacity) end
        P_BLEND: ret _word_value(s.blend) end
        P_TRANSLATE: ret _lens(s.translate_x, s.translate_y) end
        P_ROTATE: ret _num_value(ITEM_ANGLE, s.rotate) end
        P_SCALE: ret _nums(ITEM_NUM, s.scale_x, s.scale_y) end
        P_SKEW: ret _nums(ITEM_ANGLE, s.skew_x, s.skew_y) end
        P_ORIGIN: ret _dims(s.origin_x, s.origin_y) end
        P_CURSOR: ret _word_value(s.cursor) end
        P_INTERACTIVE: ret _bool_value(s.interactive) end
        P_SELECTABLE: ret _bool_value(s.selectable) end
        P_IMAGE_FIT: ret _word_value(s.image_fit) end
        P_ACCENT: ret _color_value(s.accent) end
        P_CARET: ret _color_value(s.caret) end
        P_SCROLLBAR: ret _word_value(s.scrollbar) end
        P_SCROLLBAR_COLOR: ret _colors(s.scrollbar_thumb, s.scrollbar_track) end
        P_COLOR: ret _color_value(s.color) end
        P_FONT:
            if s.font.Len() == 0:
                ret _word_value(KW_SANS)
            end
            mut v := Value {}
            each f in s.font:
                w := f == "sans" ? KW_SANS : (f == "serif" ? KW_SERIF : (f == "mono" ? KW_MONO : (f == "system" ? KW_SYSTEM : 0)))
                it := w != 0 ? OfWord(w) : OfStr(f)
                v = v.items.Len() == 0 ? One(it) : v.And(it)
            end
            ret v
        end
        P_FONT_SIZE: ret _len_value(s.font_size) end
        P_FONT_WEIGHT: ret One(OfNum(s.font_weight as f64)) end
        P_ITALIC: ret _bool_value(s.italic) end
        P_LINE_HEIGHT: ret One(s.line_height > 0.0 ? OfNum(s.line_height) : OfLen(s.line_height_len)) end
        P_LETTER_SPACING: ret _len_value(s.letter_spacing) end
        P_WORD_SPACING: ret _len_value(s.word_spacing) end
        P_TEXT_ALIGN: ret _word_value(s.text_align) end
        P_DECORATION: ret _word_value(s.decoration) end
        P_DECORATION_COLOR: ret _color_value(s.decoration_color) end
        P_DECORATION_STYLE: ret _word_value(s.decoration_style) end
        P_DECORATION_THICKNESS: ret _dim_value(s.decoration_thickness) end
        P_TRANSFORM_TEXT: ret _word_value(s.transform_text) end
        P_WRAP_TEXT: ret _bool_value(s.wrap_text) end
        P_MAX_LINES: ret s.max_lines == 0 ? _word_value(KW_NONE) : _int_value(s.max_lines) end
        P_ELLIPSIS: ret _bool_value(s.ellipsis) end
        P_DIRECTION: ret _word_value(s.direction) end
        P_WHITE_SPACE: ret _word_value(s.white_space) end
        P_TAB_SIZE: ret _int_value(s.tab_size) end
        P_TOUCH_ACTION: ret _word_value(s.touch_action) end
        P_TEXT_SHADOW: ret _shadow_value(s.text_shadow, true) end
        P_FONT_FEATURES:
            if s.font_features.Len() == 0:
                ret _word_value(KW_NONE)
            end
            mut v := Value {}
            each f in s.font_features:
                v = v.items.Len() == 0 ? One(OfStr(f)) : v.And(OfStr(f))
            end
            ret v
        end
        P_TRANSITION:
            if s.transition.Len() == 0:
                ret _word_value(KW_NONE)
            end
            mut v := Value {}
            each tr in s.transition:
                first := OfTime(tr.duration)
                v = v.items.Len() == 0 ? One(first) : v.Then(first)
                v = v.And(OfEase(tr.easing)).And(OfTime(tr.delay))
            end
            ret v
        end
        P_TRANSITION_PROPERTIES:
            if s.transition_props.Len() == 0:
                ret _word_value(KW_ALL)
            end
            mut v := Value {}
            each p in s.transition_props:
                v = v.items.Len() == 0 ? One(OfProp(p)) : v.And(OfProp(p))
            end
            ret v
        end
    end
    if prop >= P_BLUR and prop <= P_BACKDROP_HUE_ROTATE:
        ret One(_get_filter(s, prop))
    end
    ret Value {}
end

func _element_key(name: str): str:
    n := _name_key(name)
    if str.IndexFrom(n, "|", 0) >= 0:
        ret ""
    end
    q := "|" + n + "|"
    each i, list in _ELEMENT_NAMES:
        if str.IndexFrom(list, q, 0) >= 0:
            ret _ELEMENT_KEYS[i]
        end
    end
    ret ""
end

noinline func _dim_px(d &: Dim, n: f64):
    d = Dim { len = Px(n) }
end

noinline func _dim_em(d &: Dim, n: f64):
    d = Dim { len = Em(n) }
end

noinline func _dim_word(d &: Dim, word: int):
    d = Dim { word = word }
end

noinline func _round(s &: Style, n: f64):
    mut r := Px(n)
    _put_len(s.radius_top_start, r)
    _put_len(s.radius_top_end, r)
    _put_len(s.radius_bottom_end, r)
    _put_len(s.radius_bottom_start, r)
end

noinline func _pad(s &: Style, y: f64, x: f64):
    mut v := Px(y)
    mut h := Px(x)
    _put_len(s.padding_top, v)
    _put_len(s.padding_bottom, v)
    _put_len(s.padding_start, h)
    _put_len(s.padding_end, h)
end

noinline func _margin_block(s &: Style, n: f64):
    _dim_em(s.margin_top, n)
    _dim_em(s.margin_bottom, n)
end

noinline func _fill(s &: Style, r: f64, g: f64, b: f64):
    s.background.Push(Paint { kind = PAINT_COLOR, color = color.Color { r = r, g = g, b = b } })
end

func _text_flow(s &: Style):
    s.layout_kind = KW_FLOW
end

func _block_text(s &: Style):
    s.layout_kind = KW_FLOW
    _margin_block(s, 0.5)
end

func _heading(s &: Style, size: f64):
    _block_text(s)
    s.font_size = Em(size)
    s.font_weight = 700
    s.line_height = 1.25
end

func _gray_border(s &: Style):
    mut c := color.Color { r = 0.5607843137254902, g = 0.5607843137254902, b = 0.615686274509804 }
    mut w := Px(1.0)
    each side in _sides():
        _set_border(s, side, w, KW_SOLID, c)
    end
end

func _field(s &: Style):
    _gray_border(s)
    _pad(s, 4.0, 8.0)
    _round(s, 4.0)
    _fill(s, 1.0, 1.0, 1.0)
end

@en "Get"
@fa "بگیر"
pub func Get(s: Style, prop: int): Value:
    mut c := s
    ret _get(c, prop)
end

@en "Set"
@fa "بگذار"
pub func Set(s &: Style, prop: int, v: Value):
    if v.items.Len() == 0:
        ret
    end
    mut a := _it(v, 0)
    n := v.items.Len()
    switch prop:
        P_LAYOUT: s.layout_kind = a.word ret end
        P_GAP:
            _put_len(s.gap_row, a.len)
            s.gap_column = n > 1 ? _it(v, 1).len : a.len
            ret
        end
        P_ALIGN: s.align = a.word ret end
        P_JUSTIFY: s.justify = a.word ret end
        P_ALIGN_CONTENT: s.align_content = a.word ret end
        P_WRAP: s.wrap = a.num != 0.0 ret end
        P_REVERSE: s.reverse = a.num != 0.0 ret end
        P_COLUMNS: s.columns = _tracks(v) ret end
        P_ROWS: s.rows = _tracks(v) ret end
        P_AUTO_COLUMNS: s.auto_columns = _tracks(v) ret end
        P_AUTO_ROWS: s.auto_rows = _tracks(v) ret end
        P_AUTO_FLOW: s.auto_flow = a.word ret end
        P_GROW: s.grow = a.num ret end
        P_SHRINK: s.shrink = a.num ret end
        P_BASIS: _put_dim(s.basis, a) ret end
        P_ALIGN_SELF: s.align_self = a.word ret end
        P_JUSTIFY_SELF: s.justify_self = a.word ret end
        P_COLUMN: s.column = a.kind == ITEM_WORD ? 0 : a.num as int ret end
        P_ROW: s.row = a.kind == ITEM_WORD ? 0 : a.num as int ret end
        P_COLUMN_SPAN: s.column_span = a.num as int ret end
        P_ROW_SPAN: s.row_span = a.num as int ret end
        P_ORDER: s.order = a.num as int ret end
        P_POSITION: s.position = a.word ret end
        P_TOP: _put_dim(s.inset_top, a) ret end
        P_BOTTOM: _put_dim(s.inset_bottom, a) ret end
        P_START: _put_dim(s.inset_start, a) ret end
        P_END: _put_dim(s.inset_end, a) ret end
        P_LEFT: _set_side_dim(s, P_INSET, _physical(s.direction, KW_LEFT), a) ret end
        P_RIGHT: _set_side_dim(s, P_INSET, _physical(s.direction, KW_RIGHT), a) ret end
        P_INSET:
            each k, side in _sides():
                mut it := _side4(v, k)
                _set_side_dim(s, P_INSET, side, it)
            end
            ret
        end
        P_LAYER: s.layer = a.num as int ret end
        P_WIDTH: _put_dim(s.width, a) ret end
        P_HEIGHT: _put_dim(s.height, a) ret end
        P_MIN_WIDTH: _put_dim(s.min_width, a) ret end
        P_MIN_HEIGHT: _put_dim(s.min_height, a) ret end
        P_MAX_WIDTH: _put_dim(s.max_width, a) ret end
        P_MAX_HEIGHT: _put_dim(s.max_height, a) ret end
        P_ASPECT_RATIO: s.aspect_ratio = a.kind == ITEM_WORD ? 0.0 : a.num ret end
        P_PADDING:
            each k, side in _sides():
                mut it := _side4(v, k)
                _set_side_padding(s, side, it)
            end
            ret
        end
        P_PADDING_TOP: _put_len(s.padding_top, a.len) ret end
        P_PADDING_BOTTOM: _put_len(s.padding_bottom, a.len) ret end
        P_PADDING_START: _put_len(s.padding_start, a.len) ret end
        P_PADDING_END: _put_len(s.padding_end, a.len) ret end
        P_PADDING_LEFT: _set_side_padding(s, _physical(s.direction, KW_LEFT), a) ret end
        P_PADDING_RIGHT: _set_side_padding(s, _physical(s.direction, KW_RIGHT), a) ret end
        P_PADDING_X:
            _put_len(s.padding_start, a.len)
            _put_len(s.padding_end, a.len)
            ret
        end
        P_PADDING_Y:
            _put_len(s.padding_top, a.len)
            _put_len(s.padding_bottom, a.len)
            ret
        end
        P_MARGIN:
            each k, side in _sides():
                mut it := _side4(v, k)
                _set_side_dim(s, P_MARGIN, side, it)
            end
            ret
        end
        P_MARGIN_TOP: _put_dim(s.margin_top, a) ret end
        P_MARGIN_BOTTOM: _put_dim(s.margin_bottom, a) ret end
        P_MARGIN_START: _put_dim(s.margin_start, a) ret end
        P_MARGIN_END: _put_dim(s.margin_end, a) ret end
        P_MARGIN_LEFT: _set_side_dim(s, P_MARGIN, _physical(s.direction, KW_LEFT), a) ret end
        P_MARGIN_RIGHT: _set_side_dim(s, P_MARGIN, _physical(s.direction, KW_RIGHT), a) ret end
        P_MARGIN_X:
            _put_dim(s.margin_start, a)
            _put_dim(s.margin_end, a)
            ret
        end
        P_MARGIN_Y:
            _put_dim(s.margin_top, a)
            _put_dim(s.margin_bottom, a)
            ret
        end
        P_OVERFLOW:
            s.overflow_x = a.word
            s.overflow_y = n > 1 ? _it(v, 1).word : a.word
            ret
        end
        P_OVERFLOW_X: s.overflow_x = a.word ret end
        P_OVERFLOW_Y: s.overflow_y = a.word ret end
        P_VISIBLE: s.visible = a.num != 0.0 ret end
        P_CLIP: s.clip = a.num != 0.0 ret end
        P_BACKGROUND:
            mut list := Vector {} as Vector<Paint>
            if a.kind != ITEM_WORD:
                each it in v.items:
                    list.Push(_paint_of(it))
                end
            end
            s.background = list
            ret
        end
        P_BACKGROUND_SIZE:
            if a.kind == ITEM_WORD and (a.word == KW_COVER or a.word == KW_CONTAIN):
                s.background_size_x = Dim { word = a.word }
                _dim_word(s.background_size_y, KW_AUTO)
                ret
            end
            _put_dim(s.background_size_x, a)
            s.background_size_y = n > 1 ? _dim_of(_it(v, 1)) : Dim { word = KW_AUTO }
            ret
        end
        P_BACKGROUND_POSITION:
            if n == 1 and a.kind == ITEM_WORD:
                if a.word == KW_TOP or a.word == KW_BOTTOM:
                    _dim_word(s.background_x, KW_CENTER)
                    s.background_y = Dim { word = a.word }
                    ret
                end
                s.background_x = Dim { word = a.word }
                _dim_word(s.background_y, KW_CENTER)
                ret
            end
            _put_dim(s.background_x, a)
            s.background_y = n > 1 ? _dim_of(_it(v, 1)) : Dim { word = KW_CENTER }
            ret
        end
        P_BACKGROUND_REPEAT: s.background_repeat = a.word ret end
        P_BORDER:
            each side in _sides():
                _set_border_value(s, side, v)
            end
            ret
        end
        P_BORDER_TOP: _set_border_value(s, KW_TOP, v) ret end
        P_BORDER_BOTTOM: _set_border_value(s, KW_BOTTOM, v) ret end
        P_BORDER_START: _set_border_value(s, KW_START, v) ret end
        P_BORDER_END: _set_border_value(s, KW_END, v) ret end
        P_BORDER_LEFT: _set_border_value(s, _physical(s.direction, KW_LEFT), v) ret end
        P_BORDER_RIGHT: _set_border_value(s, _physical(s.direction, KW_RIGHT), v) ret end
        P_BORDER_WIDTH:
            _put_side_len(s.border_top_width, v, 0)
            _put_side_len(s.border_end_width, v, 1)
            _put_side_len(s.border_bottom_width, v, 2)
            _put_side_len(s.border_start_width, v, 3)
            ret
        end
        P_BORDER_STYLE:
            s.border_top_style = a.word
            s.border_end_style = a.word
            s.border_bottom_style = a.word
            s.border_start_style = a.word
            ret
        end
        P_BORDER_COLOR:
            _put_side_color(s.border_top_color, v, 0)
            _put_side_color(s.border_end_color, v, 1)
            _put_side_color(s.border_bottom_color, v, 2)
            _put_side_color(s.border_start_color, v, 3)
            ret
        end
        P_RADIUS:
            _put_side_len(s.radius_top_start, v, 0)
            _put_side_len(s.radius_top_end, v, 1)
            _put_side_len(s.radius_bottom_end, v, 2)
            _put_side_len(s.radius_bottom_start, v, 3)
            ret
        end
        P_RADIUS_TOP_START: _put_len(s.radius_top_start, a.len) ret end
        P_RADIUS_TOP_END: _put_len(s.radius_top_end, a.len) ret end
        P_RADIUS_BOTTOM_END: _put_len(s.radius_bottom_end, a.len) ret end
        P_RADIUS_BOTTOM_START: _put_len(s.radius_bottom_start, a.len) ret end
        P_OUTLINE:
            _put_len(s.outline_width, a.len)
            s.outline_style = _it(v, 1).word
            s.outline_color = _it(v, 2).color
            ret
        end
        P_OUTLINE_OFFSET: _put_len(s.outline_offset, a.len) ret end
        P_SHADOW: s.shadow = _shadows(v, false) ret end
        P_OPACITY: s.opacity = a.num ret end
        P_BLEND: s.blend = a.word ret end
        P_TRANSLATE:
            _put_len(s.translate_x, a.len)
            s.translate_y = n > 1 ? _it(v, 1).len : Len {}
            ret
        end
        P_ROTATE: s.rotate = a.num ret end
        P_SCALE:
            s.scale_x = a.num
            s.scale_y = n > 1 ? _it(v, 1).num : a.num
            ret
        end
        P_SKEW:
            s.skew_x = a.num
            s.skew_y = n > 1 ? _it(v, 1).num : 0.0
            ret
        end
        P_ORIGIN:
            if n == 1 and a.kind == ITEM_WORD and (a.word == KW_TOP or a.word == KW_BOTTOM):
                _dim_word(s.origin_x, KW_CENTER)
                s.origin_y = Dim { word = a.word }
                ret
            end
            _put_dim(s.origin_x, a)
            s.origin_y = n > 1 ? _dim_of(_it(v, 1)) : Dim { word = KW_CENTER }
            ret
        end
        P_CURSOR: s.cursor = a.word ret end
        P_INTERACTIVE: s.interactive = a.num != 0.0 ret end
        P_SELECTABLE: s.selectable = a.num != 0.0 ret end
        P_IMAGE_FIT: s.image_fit = a.word ret end
        P_ACCENT: _put_color(s.accent, a.color) ret end
        P_CARET: _put_color(s.caret, a.color) ret end
        P_SCROLLBAR: s.scrollbar = a.word ret end
        P_SCROLLBAR_COLOR:
            _put_color(s.scrollbar_thumb, a.color)
            s.scrollbar_track = n > 1 ? _it(v, 1).color : color.Color { a = 0.0 }
            ret
        end
        P_COLOR: _put_color(s.color, a.color) ret end
        P_FONT:
            mut list := Vector {} as Vector<str>
            each it in v.items:
                list.Push(it.kind == ITEM_WORD ? _kw_en(it.word) : it.text)
            end
            s.font = list
            ret
        end
        P_FONT_SIZE: _put_len(s.font_size, a.len) ret end
        P_FONT_WEIGHT: s.font_weight = _weight(a) ret end
        P_ITALIC: s.italic = a.num != 0.0 ret end
        P_LINE_HEIGHT:
            if a.kind == ITEM_NUM:
                s.line_height = a.num
                s.line_height_len = Len {}
            else:
                s.line_height = 0.0
                _put_len(s.line_height_len, a.len)
            end
            ret
        end
        P_LETTER_SPACING: _put_len(s.letter_spacing, a.len) ret end
        P_WORD_SPACING: _put_len(s.word_spacing, a.len) ret end
        P_TEXT_ALIGN: s.text_align = a.word ret end
        P_DECORATION: s.decoration = a.word ret end
        P_DECORATION_COLOR: _put_color(s.decoration_color, a.color) ret end
        P_DECORATION_STYLE: s.decoration_style = a.word ret end
        P_DECORATION_THICKNESS: _put_dim(s.decoration_thickness, a) ret end
        P_TRANSFORM_TEXT: s.transform_text = a.word ret end
        P_WRAP_TEXT: s.wrap_text = a.num != 0.0 ret end
        P_MAX_LINES: s.max_lines = a.kind == ITEM_WORD ? 0 : a.num as int ret end
        P_ELLIPSIS: s.ellipsis = a.num != 0.0 ret end
        P_DIRECTION: s.direction = a.word ret end
        P_WHITE_SPACE: s.white_space = a.word ret end
        P_TAB_SIZE: s.tab_size = a.num as int ret end
        P_TOUCH_ACTION: s.touch_action = a.word ret end
        P_TEXT_SHADOW: s.text_shadow = _shadows(v, true) ret end
        P_FONT_FEATURES:
            mut list := Vector {} as Vector<str>
            if a.kind != ITEM_WORD:
                each it in v.items:
                    list.Push(it.text)
                end
            end
            s.font_features = list
            ret
        end
        P_TRANSITION:
            mut list := Vector {} as Vector<Transition>
            if a.kind != ITEM_WORD:
                each g in v.starts:
                    list.Push(
                        Transition {
                            duration = _it(v, g).num,
                            easing = _it(v, g + 1).ease,
                            delay = _it(v, g + 2).num
                        }
                    )
                end
            end
            s.transition = list
            ret
        end
        P_TRANSITION_PROPERTIES:
            mut list := Vector {} as Vector<int>
            if a.kind != ITEM_WORD:
                each it in v.items:
                    list.Push(it.word)
                end
            end
            s.transition_props = list
            ret
        end
    end
    if prop >= P_BLUR and prop <= P_BACKDROP_HUE_ROTATE:
        _set_filter(s, prop, a)
    end
end

@en "Inherit"
@fa "ارث بری"
pub func Inherit(parent: Style, child &: Style):
    base := Style {}
    repeat PROP_COUNT in p:
        if not _prop_info(p).inherited:
            continue
        end
        if Format(p, Get(child, p)) == Format(p, Get(base, p)):
            Set(child, p, Get(parent, p))
        end
    end
end

@en "Default"
@fa "پیش فرض"
pub func Default(element: str): Style:
    mut s := Style {}
    key := _element_key(element)
    switch key:
        "page":
            s.min_height = Dim { len = Vh(100.0) }
            _fill(s, 1.0, 1.0, 1.0)
            break
        end
        "h1": _heading(s, 2.0) break end
        "h2": _heading(s, 1.5) break end
        "h3": _heading(s, 1.25) break end
        "h4": _heading(s, 1.0) break end
        "h5": _heading(s, 0.875) break end
        "h6": _heading(s, 0.75) break end
        "paragraph", "caption", "summary": _block_text(s) break end
        "span", "label", "option": _text_flow(s) break end
        "bold":
            _text_flow(s)
            s.font_weight = 700
            break
        end
        "italic":
            _text_flow(s)
            s.italic = true
            break
        end
        "code":
            _text_flow(s)
            s.font.Push("mono")
            s.font_size = Em(0.875)
            break
        end
        "preformatted":
            _block_text(s)
            s.font.Push("mono")
            s.font_size = Em(0.875)
            s.white_space = KW_KEEP
            s.wrap_text = false
            break
        end
        "link":
            _text_flow(s)
            s.color = color.Color {
                r = 0.10196078431372549, g = 0.45098039215686275, b = 0.9098039215686274
            }
            s.decoration = KW_UNDERLINE
            s.cursor = KW_POINTER
            break
        end
        "small":
            _text_flow(s)
            s.font_size = Em(0.833)
            break
        end
        "subscript":
            _text_flow(s)
            s.font_size = Em(0.75)
            break
        end
        "mark":
            _text_flow(s)
            _fill(s, 1.0, 1.0, 0.0)
            s.color = color.Color {}
            break
        end
        "deleted":
            _text_flow(s)
            s.decoration = KW_STRIKE
            break
        end
        "inserted":
            _text_flow(s)
            s.decoration = KW_UNDERLINE
            break
        end
        "abbreviation":
            _text_flow(s)
            s.decoration = KW_UNDERLINE
            s.decoration_style = KW_DOTTED
            break
        end
        "button":
            s.layout_kind = KW_ROW
            s.align = KW_CENTER
            s.justify = KW_CENTER
            _pad(s, 4.0, 12.0)
            _gray_border(s)
            _round(s, 4.0)
            _fill(s, 0.9411764705882353, 0.9411764705882353, 0.9411764705882353)
            s.cursor = KW_POINTER
            s.selectable = false
            break
        end
        "input", "select":
            _field(s)
            s.width = key == "input" ? Dim { len = Em(12.0) } : Dim { word = KW_AUTO }
            s.cursor = key == "input" ? KW_TEXT : KW_POINTER
            break
        end
        "textarea":
            _field(s)
            _dim_em(s.width, 20.0)
            _dim_em(s.height, 5.0)
            s.cursor = KW_TEXT
            s.white_space = KW_KEEP
            break
        end
        "range":
            _dim_em(s.width, 12.0)
            _dim_px(s.height, 16.0)
            s.cursor = KW_POINTER
            break
        end
        "checkbox", "radio":
            _dim_px(s.width, 16.0)
            _dim_px(s.height, 16.0)
            s.cursor = KW_POINTER
            break
        end
        "image", "video":
            s.layout_kind = KW_FLOW
            break
        end
        "dialog":
            s.position = KW_FIXED
            _dim_px(s.inset_top, 0.0)
            _dim_px(s.inset_bottom, 0.0)
            _dim_px(s.inset_start, 0.0)
            _dim_px(s.inset_end, 0.0)
            _dim_word(s.margin_top, KW_AUTO)
            _dim_word(s.margin_bottom, KW_AUTO)
            _dim_word(s.margin_start, KW_AUTO)
            _dim_word(s.margin_end, KW_AUTO)
            _dim_word(s.width, KW_FIT)
            _dim_word(s.height, KW_FIT)
            s.max_width = Dim { len = Vw(90.0) }
            s.max_height = Dim { len = Vh(90.0) }
            s.layer = 1000
            _pad(s, 16.0, 16.0)
            _gray_border(s)
            _round(s, 8.0)
            _fill(s, 1.0, 1.0, 1.0)
            break
        end
        "list", "ordered list":
            s.padding_start = Em(2.0)
            _margin_block(s, 0.5)
            break
        end
        "item", "description":
            _text_flow(s)
            if key == "description":
                _dim_em(s.margin_start, 2.0)
            end
            break
        end
        "table row":
            s.layout_kind = KW_ROW
            break
        end
        "cell", "header cell":
            _text_flow(s)
            s.grow = 1.0
            s.basis = Dim {}
            _pad(s, 2.0, 4.0)
            if key == "header cell":
                s.font_weight = 700
                s.text_align = KW_CENTER
            end
            break
        end
        "line":
            s.border_top_width = Px(1.0)
            s.border_top_color = color.Color {
                r = 0.5607843137254902, g = 0.5607843137254902, b = 0.615686274509804
            }
            _margin_block(s, 0.5)
            break
        end
        "block quote":
            _margin_block(s, 0.5)
            _dim_em(s.margin_start, 2.0)
            _dim_em(s.margin_end, 2.0)
            break
        end
        "field set":
            _gray_border(s)
            _pad(s, 8.0, 12.0)
            break
        end
        "progress":
            _dim_em(s.width, 10.0)
            _dim_em(s.height, 1.0)
            break
        end
    end
    if key == "summary":
        s.cursor = KW_POINTER
    end
    if key == "caption":
        s.text_align = KW_CENTER
    end
    ret s
end
