package style

import gui.color

func _it(v: Value, i: int): Item:
    if i < 0 or i >= v.items.Len():
        ret Item {}
    end
    ret v.items.Get(i)
end

func _dim_of(it: Item): Dim:
    if it.kind == ITEM_WORD:
        ret Dim { word = it.word }
    end
    ret Dim { len = it.len }
end

func _dim_item(d: Dim): Item:
    if d.word != 0:
        ret OfWord(d.word)
    end
    ret OfLen(d.len)
end

func _side4(v: Value, k: int): Item:
    n := v.items.Len()
    if n == 1:
        ret _it(v, 0)
    end
    if n == 2:
        ret _it(v, k % 2)
    end
    if n == 3:
        ret k == 3 ? _it(v, 1) : _it(v, k)
    end
    ret _it(v, k)
end

func _corner4(v: Value, k: int): Item:
    ret _side4(v, k)
end

func _physical(s: Style, word: int): int:
    rtl := s.direction == KW_RTL
    if word == KW_LEFT:
        ret rtl ? KW_END : KW_START
    end
    if word == KW_RIGHT:
        ret rtl ? KW_START : KW_END
    end
    ret word
end

func _set_inset(s &: Style, side: int, d: Dim):
    switch side:
        KW_TOP: s.inset_top = d break end
        KW_END: s.inset_end = d break end
        KW_BOTTOM: s.inset_bottom = d break end
        KW_START: s.inset_start = d break end
    end
end

func _set_padding(s &: Style, side: int, l: Len):
    switch side:
        KW_TOP: s.padding_top = l break end
        KW_END: s.padding_end = l break end
        KW_BOTTOM: s.padding_bottom = l break end
        KW_START: s.padding_start = l break end
    end
end

func _set_margin(s &: Style, side: int, d: Dim):
    switch side:
        KW_TOP: s.margin_top = d break end
        KW_END: s.margin_end = d break end
        KW_BOTTOM: s.margin_bottom = d break end
        KW_START: s.margin_start = d break end
    end
end

func _set_border(s &: Style, side: int, w: Len, st: int, c: color.Color):
    switch side:
        KW_TOP:
            s.border_top_width = w
            s.border_top_style = st
            s.border_top_color = c
            break
        end
        KW_END:
            s.border_end_width = w
            s.border_end_style = st
            s.border_end_color = c
            break
        end
        KW_BOTTOM:
            s.border_bottom_width = w
            s.border_bottom_style = st
            s.border_bottom_color = c
            break
        end
        KW_START:
            s.border_start_width = w
            s.border_start_style = st
            s.border_start_color = c
            break
        end
    end
end

func _sides(): int[4]:
    ret [KW_TOP, KW_END, KW_BOTTOM, KW_START]
end

func _weight(it: Item): int:
    if it.kind != ITEM_WORD:
        ret it.num as int
    end
    switch it.word:
        KW_THIN: ret 100 end
        KW_LIGHT: ret 300 end
        KW_MEDIUM: ret 500 end
        KW_SEMIBOLD: ret 600 end
        KW_BOLD: ret 700 end
        KW_BLACK: ret 900 end
    end
    ret 400
end

func _paint_of(it: Item): Paint:
    if it.kind == ITEM_COLOR:
        ret Paint { kind = PAINT_COLOR, color = it.color }
    end
    ret it.paint
end

func _shadows(v: Value, text: bool): Vector<Shadow>:
    mut out := Vector {} as Vector<Shadow>
    if v.items.Len() == 0 or _it(v, 0).kind == ITEM_WORD:
        ret out
    end
    each g in v.starts:
        if text:
            out.Push(Shadow { x = _it(v, g).len, y = _it(v, g + 1).len, blur = _it(v, g + 2).len, color = _it(v, g + 3).color })
        else:
            out.Push(Shadow { x = _it(v, g).len, y = _it(v, g + 1).len, blur = _it(v, g + 2).len, spread = _it(v, g + 3).len, color = _it(v, g + 4).color, inset = _it(v, g + 5).num != 0.0 })
        end
    end
    ret out
end

func _tracks(v: Value): Vector<Track>:
    mut out := Vector {} as Vector<Track>
    each it in v.items:
        if it.kind == ITEM_TRACK:
            out.Push(it.track)
        end
    end
    ret out
end

func _set_filter(s &: Style, prop: int, it: Item):
    switch prop:
        P_BLUR: s.blur = it.len break end
        P_BRIGHTNESS: s.brightness = it.num break end
        P_CONTRAST: s.contrast = it.num break end
        P_GRAYSCALE: s.grayscale = it.num break end
        P_SATURATE: s.saturate = it.num break end
        P_SEPIA: s.sepia = it.num break end
        P_INVERT: s.invert = it.num break end
        P_HUE_ROTATE: s.hue_rotate = it.num break end
        P_BACKDROP_BLUR: s.backdrop_blur = it.len break end
        P_BACKDROP_BRIGHTNESS: s.backdrop_brightness = it.num break end
        P_BACKDROP_CONTRAST: s.backdrop_contrast = it.num break end
        P_BACKDROP_GRAYSCALE: s.backdrop_grayscale = it.num break end
        P_BACKDROP_SATURATE: s.backdrop_saturate = it.num break end
        P_BACKDROP_SEPIA: s.backdrop_sepia = it.num break end
        P_BACKDROP_INVERT: s.backdrop_invert = it.num break end
        P_BACKDROP_HUE_ROTATE: s.backdrop_hue_rotate = it.num break end
    end
end

func _get_filter(s: Style, prop: int): Item:
    switch prop:
        P_BLUR: ret OfLen(s.blur) end
        P_BRIGHTNESS: ret OfNum(s.brightness) end
        P_CONTRAST: ret OfNum(s.contrast) end
        P_GRAYSCALE: ret OfNum(s.grayscale) end
        P_SATURATE: ret OfNum(s.saturate) end
        P_SEPIA: ret OfNum(s.sepia) end
        P_INVERT: ret OfNum(s.invert) end
        P_HUE_ROTATE: ret OfAngle(s.hue_rotate) end
        P_BACKDROP_BLUR: ret OfLen(s.backdrop_blur) end
        P_BACKDROP_BRIGHTNESS: ret OfNum(s.backdrop_brightness) end
        P_BACKDROP_CONTRAST: ret OfNum(s.backdrop_contrast) end
        P_BACKDROP_GRAYSCALE: ret OfNum(s.backdrop_grayscale) end
        P_BACKDROP_SATURATE: ret OfNum(s.backdrop_saturate) end
        P_BACKDROP_SEPIA: ret OfNum(s.backdrop_sepia) end
        P_BACKDROP_INVERT: ret OfNum(s.backdrop_invert) end
        P_BACKDROP_HUE_ROTATE: ret OfAngle(s.backdrop_hue_rotate) end
    end
    ret Item {}
end

func _four(a: Item, b: Item, c: Item, d: Item): Value:
    ret One(a).And(b).And(c).And(d)
end

func _shadow_value(list: Vector<Shadow>, text: bool): Value:
    if list.Len() == 0:
        ret One(OfWord(KW_NONE))
    end
    mut v := Value {}
    each sh in list:
        first := OfLen(sh.x)
        if v.items.Len() == 0:
            v = One(first)
        else:
            v = v.Then(first)
        end
        v = v.And(OfLen(sh.y)).And(OfLen(sh.blur))
        if not text:
            v = v.And(OfLen(sh.spread))
        end
        v = v.And(OfColor(sh.color))
        if not text:
            v = v.And(OfBool(sh.inset))
        end
    end
    ret v
end

func _tracks_value(list: Vector<Track>, empty: int): Value:
    if list.Len() == 0:
        ret One(OfWord(empty))
    end
    mut v := Value {}
    each tr in list:
        if v.items.Len() == 0:
            v = One(OfTrack(tr))
        else:
            v = v.And(OfTrack(tr))
        end
    end
    ret v
end

func _border_value(w: Len, st: int, c: color.Color): Value:
    ret One(OfLen(w)).And(OfWord(st)).And(OfColor(c))
end

func _element_key(name: str): str:
    n := _name_key(name)
    switch n:
        "box", "div", "جعبه": ret "box" end
        "page", "body", "html", "root", "صفحه": ret "page" end
        "heading", "h1", "سرتیتر", "heading 1": ret "h1" end
        "h2", "heading 2": ret "h2" end
        "h3", "heading 3": ret "h3" end
        "h4", "heading 4": ret "h4" end
        "h5", "heading 5": ret "h5" end
        "h6", "heading 6": ret "h6" end
        "paragraph", "p", "پاراگراف": ret "paragraph" end
        "span", "تکه", "isolate", "bdi", "direction override", "bdo", "data", "time", "output", "زمان", "داده", "خروجی": ret "span" end
        "bold", "b", "پررنگ", "strong", "قوی": ret "bold" end
        "italic", "i", "کج", "emphasis", "em", "تاکید", "cite", "نام اثر", "variable", "var", "متغیر", "definition", "dfn", "تعریف": ret "italic" end
        "code", "کد", "keyboard", "kbd", "sample", "samp", "صفحه کلید", "نمونه خروجی": ret "code" end
        "preformatted", "pre", "پیش قالب": ret "preformatted" end
        "link", "a", "پیوند": ret "link" end
        "small", "ریز": ret "small" end
        "subscript", "sub", "زیرنویس", "superscript", "sup", "بالانویس": ret "subscript" end
        "mark", "highlight", "برجسته": ret "mark" end
        "deleted", "del", "حذف شده", "strikethrough", "s", "خط خورده": ret "deleted" end
        "inserted", "ins", "افزوده", "underline", "u", "زیرخط": ret "inserted" end
        "abbreviation", "abbr", "کوته نوشت": ret "abbreviation" end
        "quote", "q", "نقل قول": ret "span" end
        "button", "دکمه": ret "button" end
        "input", "ورودی": ret "input" end
        "text area", "textarea", "متن بلند": ret "textarea" end
        "select", "dropdown", "انتخاب": ret "select" end
        "checkbox", "جعبه تیک": ret "checkbox" end
        "radio", "دکمه رادیویی": ret "radio" end
        "option", "گزینه", "option group", "optgroup", "گروه گزینه": ret "option" end
        "image", "img", "تصویر", "picture", "عکس": ret "image" end
        "video", "ویدیو", "canvas", "بوم", "iframe", "قاب درونی", "svg", "embed", "object", "audio", "صدا": ret "video" end
        "list", "ul", "فهرست", "menu", "منو": ret "list" end
        "ordered list", "numbered list", "ol", "فهرست شماره دار": ret "ordered list" end
        "item", "li", "مورد": ret "item" end
        "table", "جدول": ret "table" end
        "row", "tr", "ردیف": ret "table row" end
        "column", "cell", "td", "ستون", "سلول": ret "cell" end
        "header cell", "th", "سلول سرستون": ret "header cell" end
        "thead", "tbody", "tfoot", "table header", "table body", "table footer": ret "table section" end
        "caption", "عنوان جدول", "figure caption", "figcaption", "زیرنویس شکل", "legend", "عنوان گروه": ret "caption" end
        "line", "hr", "separator", "خط", "جداکننده": ret "line" end
        "form", "فرم", "nav", "ناوبری", "header", "سرصفحه", "footer", "پاورقی", "section", "بخش", "article", "مقاله", "main", "اصلی", "aside", "sidebar", "کناری", "search", "جستجو", "details", "جزئیات", "dialog", "پنجره گفتگو", "heading group", "hgroup", "گروه سرتیتر", "address", "آدرس": ret "section" end
        "label", "برچسب": ret "label" end
        "summary", "خلاصه": ret "summary" end
        "block quote", "blockquote", "نقل قول بلند", "figure", "شکل": ret "block quote" end
        "field set", "fieldset", "گروه فیلد": ret "field set" end
        "description list", "dl", "فهرست تعریف", "term", "dt", "واژه": ret "paragraph" end
        "description", "dd", "شرح": ret "description" end
        "progress", "پیشرفت", "meter", "gauge", "سنجه": ret "progress" end
    end
    ret ""
end

func _text_flow(s &: Style):
    s.layout_kind = KW_FLOW
end

func _block_text(s &: Style):
    s.layout_kind = KW_FLOW
    s.margin_top = Dim { len = Em(0.5) }
    s.margin_bottom = Dim { len = Em(0.5) }
end

func _heading(s &: Style, size: f64):
    _block_text(s)
    s.font_size = Em(size)
    s.font_weight = 700
    s.line_height = 1.25
end

func _gray_border(s &: Style):
    c := color.Color { r = 0.5607843137254902, g = 0.5607843137254902, b = 0.615686274509804 }
    each side in _sides():
        _set_border(s, side, Px(1.0), KW_SOLID, c)
    end
end

func _field(s &: Style):
    _gray_border(s)
    s.padding_top = Px(4.0)
    s.padding_bottom = Px(4.0)
    s.padding_start = Px(8.0)
    s.padding_end = Px(8.0)
    s.radius_top_start = Px(4.0)
    s.radius_top_end = Px(4.0)
    s.radius_bottom_end = Px(4.0)
    s.radius_bottom_start = Px(4.0)
    s.background.Push(Paint { kind = PAINT_COLOR, color = color.Color { r = 1.0, g = 1.0, b = 1.0 } })
end

@en "Get"
@fa "بگیر"
pub func Get(s: Style, prop: int): Value:
    switch prop:
        P_LAYOUT: ret One(OfWord(s.layout_kind)) end
        P_GAP: ret One(OfLen(s.gap_row)).And(OfLen(s.gap_column)) end
        P_ALIGN: ret One(OfWord(s.align)) end
        P_JUSTIFY: ret One(OfWord(s.justify)) end
        P_ALIGN_CONTENT: ret One(OfWord(s.align_content)) end
        P_WRAP: ret One(OfBool(s.wrap)) end
        P_REVERSE: ret One(OfBool(s.reverse)) end
        P_COLUMNS: ret _tracks_value(s.columns, KW_NONE) end
        P_ROWS: ret _tracks_value(s.rows, KW_NONE) end
        P_AUTO_COLUMNS: ret _tracks_value(s.auto_columns, KW_AUTO) end
        P_AUTO_ROWS: ret _tracks_value(s.auto_rows, KW_AUTO) end
        P_AUTO_FLOW: ret One(OfWord(s.auto_flow)) end
        P_GROW: ret One(OfNum(s.grow)) end
        P_SHRINK: ret One(OfNum(s.shrink)) end
        P_BASIS: ret One(_dim_item(s.basis)) end
        P_ALIGN_SELF: ret One(OfWord(s.align_self)) end
        P_JUSTIFY_SELF: ret One(OfWord(s.justify_self)) end
        P_COLUMN: ret One(s.column == 0 ? OfWord(KW_AUTO) : OfInt(s.column)) end
        P_ROW: ret One(s.row == 0 ? OfWord(KW_AUTO) : OfInt(s.row)) end
        P_COLUMN_SPAN: ret One(OfInt(s.column_span)) end
        P_ROW_SPAN: ret One(OfInt(s.row_span)) end
        P_ORDER: ret One(OfInt(s.order)) end
        P_POSITION: ret One(OfWord(s.position)) end
        P_TOP: ret One(_dim_item(s.inset_top)) end
        P_BOTTOM: ret One(_dim_item(s.inset_bottom)) end
        P_START, P_LEFT: ret One(_dim_item(_physical(s, prop == P_LEFT ? KW_LEFT : KW_START) == KW_START ? s.inset_start : s.inset_end)) end
        P_END, P_RIGHT: ret One(_dim_item(_physical(s, prop == P_RIGHT ? KW_RIGHT : KW_END) == KW_END ? s.inset_end : s.inset_start)) end
        P_INSET: ret _four(_dim_item(s.inset_top), _dim_item(s.inset_end), _dim_item(s.inset_bottom), _dim_item(s.inset_start)) end
        P_LAYER: ret One(OfInt(s.layer)) end
        P_WIDTH: ret One(_dim_item(s.width)) end
        P_HEIGHT: ret One(_dim_item(s.height)) end
        P_MIN_WIDTH: ret One(_dim_item(s.min_width)) end
        P_MIN_HEIGHT: ret One(_dim_item(s.min_height)) end
        P_MAX_WIDTH: ret One(_dim_item(s.max_width)) end
        P_MAX_HEIGHT: ret One(_dim_item(s.max_height)) end
        P_ASPECT_RATIO: ret One(s.aspect_ratio == 0.0 ? OfWord(KW_NONE) : OfNum(s.aspect_ratio)) end
        P_PADDING: ret _four(OfLen(s.padding_top), OfLen(s.padding_end), OfLen(s.padding_bottom), OfLen(s.padding_start)) end
        P_PADDING_TOP, P_PADDING_Y: ret One(OfLen(s.padding_top)) end
        P_PADDING_BOTTOM: ret One(OfLen(s.padding_bottom)) end
        P_PADDING_START, P_PADDING_X: ret One(OfLen(s.padding_start)) end
        P_PADDING_END: ret One(OfLen(s.padding_end)) end
        P_PADDING_LEFT: ret One(OfLen(_physical(s, KW_LEFT) == KW_START ? s.padding_start : s.padding_end)) end
        P_PADDING_RIGHT: ret One(OfLen(_physical(s, KW_RIGHT) == KW_END ? s.padding_end : s.padding_start)) end
        P_MARGIN: ret _four(_dim_item(s.margin_top), _dim_item(s.margin_end), _dim_item(s.margin_bottom), _dim_item(s.margin_start)) end
        P_MARGIN_TOP, P_MARGIN_Y: ret One(_dim_item(s.margin_top)) end
        P_MARGIN_BOTTOM: ret One(_dim_item(s.margin_bottom)) end
        P_MARGIN_START, P_MARGIN_X: ret One(_dim_item(s.margin_start)) end
        P_MARGIN_END: ret One(_dim_item(s.margin_end)) end
        P_MARGIN_LEFT: ret One(_dim_item(_physical(s, KW_LEFT) == KW_START ? s.margin_start : s.margin_end)) end
        P_MARGIN_RIGHT: ret One(_dim_item(_physical(s, KW_RIGHT) == KW_END ? s.margin_end : s.margin_start)) end
        P_OVERFLOW: ret One(OfWord(s.overflow_x)).And(OfWord(s.overflow_y)) end
        P_OVERFLOW_X: ret One(OfWord(s.overflow_x)) end
        P_OVERFLOW_Y: ret One(OfWord(s.overflow_y)) end
        P_VISIBLE: ret One(OfBool(s.visible)) end
        P_CLIP: ret One(OfBool(s.clip)) end
        P_BACKGROUND:
            if s.background.Len() == 0:
                ret One(OfColor(color.Color { a = 0.0 }))
            end
            mut v := Value {}
            each p in s.background:
                it := p.kind == PAINT_COLOR ? OfColor(p.color) : OfPaint(p)
                v = v.items.Len() == 0 ? One(it) : v.And(it)
            end
            ret v
        end
        P_BACKGROUND_SIZE:
            if s.background_size_x.word == KW_COVER or s.background_size_x.word == KW_CONTAIN:
                ret One(OfWord(s.background_size_x.word))
            end
            ret One(_dim_item(s.background_size_x)).And(_dim_item(s.background_size_y))
        end
        P_BACKGROUND_POSITION: ret One(_dim_item(s.background_x)).And(_dim_item(s.background_y)) end
        P_BACKGROUND_REPEAT: ret One(OfWord(s.background_repeat)) end
        P_BORDER, P_BORDER_TOP: ret _border_value(s.border_top_width, s.border_top_style, s.border_top_color) end
        P_BORDER_BOTTOM: ret _border_value(s.border_bottom_width, s.border_bottom_style, s.border_bottom_color) end
        P_BORDER_START, P_BORDER_LEFT, P_BORDER_END, P_BORDER_RIGHT:
            mut side := prop == P_BORDER_START ? KW_START : (prop == P_BORDER_END ? KW_END : (prop == P_BORDER_LEFT ? KW_LEFT : KW_RIGHT))
            side = _physical(s, side)
            if side == KW_START:
                ret _border_value(s.border_start_width, s.border_start_style, s.border_start_color)
            end
            ret _border_value(s.border_end_width, s.border_end_style, s.border_end_color)
        end
        P_BORDER_WIDTH: ret _four(OfLen(s.border_top_width), OfLen(s.border_end_width), OfLen(s.border_bottom_width), OfLen(s.border_start_width)) end
        P_BORDER_STYLE: ret One(OfWord(s.border_top_style)) end
        P_BORDER_COLOR: ret _four(OfColor(s.border_top_color), OfColor(s.border_end_color), OfColor(s.border_bottom_color), OfColor(s.border_start_color)) end
        P_RADIUS: ret _four(OfLen(s.radius_top_start), OfLen(s.radius_top_end), OfLen(s.radius_bottom_end), OfLen(s.radius_bottom_start)) end
        P_RADIUS_TOP_START: ret One(OfLen(s.radius_top_start)) end
        P_RADIUS_TOP_END: ret One(OfLen(s.radius_top_end)) end
        P_RADIUS_BOTTOM_END: ret One(OfLen(s.radius_bottom_end)) end
        P_RADIUS_BOTTOM_START: ret One(OfLen(s.radius_bottom_start)) end
        P_OUTLINE: ret _border_value(s.outline_width, s.outline_style, s.outline_color) end
        P_OUTLINE_OFFSET: ret One(OfLen(s.outline_offset)) end
        P_SHADOW: ret _shadow_value(s.shadow, false) end
        P_OPACITY: ret One(OfNum(s.opacity)) end
        P_BLEND: ret One(OfWord(s.blend)) end
        P_TRANSLATE: ret One(OfLen(s.translate_x)).And(OfLen(s.translate_y)) end
        P_ROTATE: ret One(OfAngle(s.rotate)) end
        P_SCALE: ret One(OfNum(s.scale_x)).And(OfNum(s.scale_y)) end
        P_SKEW: ret One(OfAngle(s.skew_x)).And(OfAngle(s.skew_y)) end
        P_ORIGIN: ret One(_dim_item(s.origin_x)).And(_dim_item(s.origin_y)) end
        P_CURSOR: ret One(OfWord(s.cursor)) end
        P_INTERACTIVE: ret One(OfBool(s.interactive)) end
        P_SELECTABLE: ret One(OfBool(s.selectable)) end
        P_IMAGE_FIT: ret One(OfWord(s.image_fit)) end
        P_ACCENT: ret One(OfColor(s.accent)) end
        P_CARET: ret One(OfColor(s.caret)) end
        P_SCROLLBAR: ret One(OfWord(s.scrollbar)) end
        P_SCROLLBAR_COLOR: ret One(OfColor(s.scrollbar_thumb)).And(OfColor(s.scrollbar_track)) end
        P_COLOR: ret One(OfColor(s.color)) end
        P_FONT:
            if s.font.Len() == 0:
                ret One(OfWord(KW_SANS))
            end
            mut v := Value {}
            each f in s.font:
                w := f == "sans" ? KW_SANS : (f == "serif" ? KW_SERIF : (f == "mono" ? KW_MONO : (f == "system" ? KW_SYSTEM : 0)))
                it := w != 0 ? OfWord(w) : OfStr(f)
                v = v.items.Len() == 0 ? One(it) : v.And(it)
            end
            ret v
        end
        P_FONT_SIZE: ret One(OfLen(s.font_size)) end
        P_FONT_WEIGHT: ret One(OfNum(s.font_weight as f64)) end
        P_ITALIC: ret One(OfBool(s.italic)) end
        P_LINE_HEIGHT: ret One(s.line_height > 0.0 ? OfNum(s.line_height) : OfLen(s.line_height_len)) end
        P_LETTER_SPACING: ret One(OfLen(s.letter_spacing)) end
        P_WORD_SPACING: ret One(OfLen(s.word_spacing)) end
        P_TEXT_ALIGN: ret One(OfWord(s.text_align)) end
        P_DECORATION: ret One(OfWord(s.decoration)) end
        P_DECORATION_COLOR: ret One(OfColor(s.decoration_color)) end
        P_DECORATION_STYLE: ret One(OfWord(s.decoration_style)) end
        P_DECORATION_THICKNESS: ret One(_dim_item(s.decoration_thickness)) end
        P_TRANSFORM_TEXT: ret One(OfWord(s.transform_text)) end
        P_WRAP_TEXT: ret One(OfBool(s.wrap_text)) end
        P_MAX_LINES: ret One(s.max_lines == 0 ? OfWord(KW_NONE) : OfInt(s.max_lines)) end
        P_ELLIPSIS: ret One(OfBool(s.ellipsis)) end
        P_DIRECTION: ret One(OfWord(s.direction)) end
        P_WHITE_SPACE: ret One(OfWord(s.white_space)) end
        P_TEXT_SHADOW: ret _shadow_value(s.text_shadow, true) end
        P_FONT_FEATURES:
            if s.font_features.Len() == 0:
                ret One(OfWord(KW_NONE))
            end
            mut v := Value {}
            each f in s.font_features:
                v = v.items.Len() == 0 ? One(OfStr(f)) : v.And(OfStr(f))
            end
            ret v
        end
        P_TRANSITION:
            if s.transition.Len() == 0:
                ret One(OfWord(KW_NONE))
            end
            mut v := Value {}
            each tr in s.transition:
                first := OfTime(tr.duration)
                v = v.items.Len() == 0 ? One(first) : v.Then(first)
                v = v.And(OfEase(tr.easing)).And(OfTime(tr.delay))
            end
            ret v
        end
        P_TRANSITION_PROPERTIES:
            if s.transition_props.Len() == 0:
                ret One(OfWord(KW_ALL))
            end
            mut v := Value {}
            each p in s.transition_props:
                v = v.items.Len() == 0 ? One(OfProp(p)) : v.And(OfProp(p))
            end
            ret v
        end
    end
    if prop >= P_BLUR and prop <= P_BACKDROP_HUE_ROTATE:
        ret One(_get_filter(s, prop))
    end
    ret Value {}
end

@en "Set"
@fa "بگذار"
pub func Set(s &: Style, prop: int, v: Value):
    if v.items.Len() == 0:
        ret
    end
    a := _it(v, 0)
    n := v.items.Len()
    switch prop:
        P_LAYOUT: s.layout_kind = a.word ret end
        P_GAP:
            s.gap_row = a.len
            s.gap_column = n > 1 ? _it(v, 1).len : a.len
            ret
        end
        P_ALIGN: s.align = a.word ret end
        P_JUSTIFY: s.justify = a.word ret end
        P_ALIGN_CONTENT: s.align_content = a.word ret end
        P_WRAP: s.wrap = a.num != 0.0 ret end
        P_REVERSE: s.reverse = a.num != 0.0 ret end
        P_COLUMNS: s.columns = _tracks(v) ret end
        P_ROWS: s.rows = _tracks(v) ret end
        P_AUTO_COLUMNS: s.auto_columns = _tracks(v) ret end
        P_AUTO_ROWS: s.auto_rows = _tracks(v) ret end
        P_AUTO_FLOW: s.auto_flow = a.word ret end
        P_GROW: s.grow = a.num ret end
        P_SHRINK: s.shrink = a.num ret end
        P_BASIS: s.basis = _dim_of(a) ret end
        P_ALIGN_SELF: s.align_self = a.word ret end
        P_JUSTIFY_SELF: s.justify_self = a.word ret end
        P_COLUMN: s.column = a.kind == ITEM_WORD ? 0 : a.num as int ret end
        P_ROW: s.row = a.kind == ITEM_WORD ? 0 : a.num as int ret end
        P_COLUMN_SPAN: s.column_span = a.num as int ret end
        P_ROW_SPAN: s.row_span = a.num as int ret end
        P_ORDER: s.order = a.num as int ret end
        P_POSITION: s.position = a.word ret end
        P_TOP: s.inset_top = _dim_of(a) ret end
        P_BOTTOM: s.inset_bottom = _dim_of(a) ret end
        P_START: s.inset_start = _dim_of(a) ret end
        P_END: s.inset_end = _dim_of(a) ret end
        P_LEFT: _set_inset(s, _physical(s, KW_LEFT), _dim_of(a)) ret end
        P_RIGHT: _set_inset(s, _physical(s, KW_RIGHT), _dim_of(a)) ret end
        P_INSET:
            each k, side in _sides():
                _set_inset(s, side, _dim_of(_side4(v, k)))
            end
            ret
        end
        P_LAYER: s.layer = a.num as int ret end
        P_WIDTH: s.width = _dim_of(a) ret end
        P_HEIGHT: s.height = _dim_of(a) ret end
        P_MIN_WIDTH: s.min_width = _dim_of(a) ret end
        P_MIN_HEIGHT: s.min_height = _dim_of(a) ret end
        P_MAX_WIDTH: s.max_width = _dim_of(a) ret end
        P_MAX_HEIGHT: s.max_height = _dim_of(a) ret end
        P_ASPECT_RATIO: s.aspect_ratio = a.kind == ITEM_WORD ? 0.0 : a.num ret end
        P_PADDING:
            each k, side in _sides():
                _set_padding(s, side, _side4(v, k).len)
            end
            ret
        end
        P_PADDING_TOP: s.padding_top = a.len ret end
        P_PADDING_BOTTOM: s.padding_bottom = a.len ret end
        P_PADDING_START: s.padding_start = a.len ret end
        P_PADDING_END: s.padding_end = a.len ret end
        P_PADDING_LEFT: _set_padding(s, _physical(s, KW_LEFT), a.len) ret end
        P_PADDING_RIGHT: _set_padding(s, _physical(s, KW_RIGHT), a.len) ret end
        P_PADDING_X:
            s.padding_start = a.len
            s.padding_end = a.len
            ret
        end
        P_PADDING_Y:
            s.padding_top = a.len
            s.padding_bottom = a.len
            ret
        end
        P_MARGIN:
            each k, side in _sides():
                _set_margin(s, side, _dim_of(_side4(v, k)))
            end
            ret
        end
        P_MARGIN_TOP: s.margin_top = _dim_of(a) ret end
        P_MARGIN_BOTTOM: s.margin_bottom = _dim_of(a) ret end
        P_MARGIN_START: s.margin_start = _dim_of(a) ret end
        P_MARGIN_END: s.margin_end = _dim_of(a) ret end
        P_MARGIN_LEFT: _set_margin(s, _physical(s, KW_LEFT), _dim_of(a)) ret end
        P_MARGIN_RIGHT: _set_margin(s, _physical(s, KW_RIGHT), _dim_of(a)) ret end
        P_MARGIN_X:
            s.margin_start = _dim_of(a)
            s.margin_end = _dim_of(a)
            ret
        end
        P_MARGIN_Y:
            s.margin_top = _dim_of(a)
            s.margin_bottom = _dim_of(a)
            ret
        end
        P_OVERFLOW:
            s.overflow_x = a.word
            s.overflow_y = n > 1 ? _it(v, 1).word : a.word
            ret
        end
        P_OVERFLOW_X: s.overflow_x = a.word ret end
        P_OVERFLOW_Y: s.overflow_y = a.word ret end
        P_VISIBLE: s.visible = a.num != 0.0 ret end
        P_CLIP: s.clip = a.num != 0.0 ret end
        P_BACKGROUND:
            mut list := Vector {} as Vector<Paint>
            if a.kind != ITEM_WORD:
                each it in v.items:
                    list.Push(_paint_of(it))
                end
            end
            s.background = list
            ret
        end
        P_BACKGROUND_SIZE:
            if a.kind == ITEM_WORD and (a.word == KW_COVER or a.word == KW_CONTAIN):
                s.background_size_x = Dim { word = a.word }
                s.background_size_y = Dim { word = KW_AUTO }
                ret
            end
            s.background_size_x = _dim_of(a)
            s.background_size_y = n > 1 ? _dim_of(_it(v, 1)) : Dim { word = KW_AUTO }
            ret
        end
        P_BACKGROUND_POSITION:
            if n == 1 and a.kind == ITEM_WORD:
                if a.word == KW_TOP or a.word == KW_BOTTOM:
                    s.background_x = Dim { word = KW_CENTER }
                    s.background_y = Dim { word = a.word }
                    ret
                end
                s.background_x = Dim { word = a.word }
                s.background_y = Dim { word = KW_CENTER }
                ret
            end
            s.background_x = _dim_of(a)
            s.background_y = n > 1 ? _dim_of(_it(v, 1)) : Dim { word = KW_CENTER }
            ret
        end
        P_BACKGROUND_REPEAT: s.background_repeat = a.word ret end
        P_BORDER:
            each side in _sides():
                _set_border(s, side, a.len, _it(v, 1).word, _it(v, 2).color)
            end
            ret
        end
        P_BORDER_TOP: _set_border(s, KW_TOP, a.len, _it(v, 1).word, _it(v, 2).color) ret end
        P_BORDER_BOTTOM: _set_border(s, KW_BOTTOM, a.len, _it(v, 1).word, _it(v, 2).color) ret end
        P_BORDER_START: _set_border(s, KW_START, a.len, _it(v, 1).word, _it(v, 2).color) ret end
        P_BORDER_END: _set_border(s, KW_END, a.len, _it(v, 1).word, _it(v, 2).color) ret end
        P_BORDER_LEFT: _set_border(s, _physical(s, KW_LEFT), a.len, _it(v, 1).word, _it(v, 2).color) ret end
        P_BORDER_RIGHT: _set_border(s, _physical(s, KW_RIGHT), a.len, _it(v, 1).word, _it(v, 2).color) ret end
        P_BORDER_WIDTH:
            s.border_top_width = _side4(v, 0).len
            s.border_end_width = _side4(v, 1).len
            s.border_bottom_width = _side4(v, 2).len
            s.border_start_width = _side4(v, 3).len
            ret
        end
        P_BORDER_STYLE:
            s.border_top_style = a.word
            s.border_end_style = a.word
            s.border_bottom_style = a.word
            s.border_start_style = a.word
            ret
        end
        P_BORDER_COLOR:
            s.border_top_color = _side4(v, 0).color
            s.border_end_color = _side4(v, 1).color
            s.border_bottom_color = _side4(v, 2).color
            s.border_start_color = _side4(v, 3).color
            ret
        end
        P_RADIUS:
            s.radius_top_start = _corner4(v, 0).len
            s.radius_top_end = _corner4(v, 1).len
            s.radius_bottom_end = _corner4(v, 2).len
            s.radius_bottom_start = _corner4(v, 3).len
            ret
        end
        P_RADIUS_TOP_START: s.radius_top_start = a.len ret end
        P_RADIUS_TOP_END: s.radius_top_end = a.len ret end
        P_RADIUS_BOTTOM_END: s.radius_bottom_end = a.len ret end
        P_RADIUS_BOTTOM_START: s.radius_bottom_start = a.len ret end
        P_OUTLINE:
            s.outline_width = a.len
            s.outline_style = _it(v, 1).word
            s.outline_color = _it(v, 2).color
            ret
        end
        P_OUTLINE_OFFSET: s.outline_offset = a.len ret end
        P_SHADOW: s.shadow = _shadows(v, false) ret end
        P_OPACITY: s.opacity = a.num ret end
        P_BLEND: s.blend = a.word ret end
        P_TRANSLATE:
            s.translate_x = a.len
            s.translate_y = n > 1 ? _it(v, 1).len : Len {}
            ret
        end
        P_ROTATE: s.rotate = a.num ret end
        P_SCALE:
            s.scale_x = a.num
            s.scale_y = n > 1 ? _it(v, 1).num : a.num
            ret
        end
        P_SKEW:
            s.skew_x = a.num
            s.skew_y = n > 1 ? _it(v, 1).num : 0.0
            ret
        end
        P_ORIGIN:
            if n == 1 and a.kind == ITEM_WORD and (a.word == KW_TOP or a.word == KW_BOTTOM):
                s.origin_x = Dim { word = KW_CENTER }
                s.origin_y = Dim { word = a.word }
                ret
            end
            s.origin_x = _dim_of(a)
            s.origin_y = n > 1 ? _dim_of(_it(v, 1)) : Dim { word = KW_CENTER }
            ret
        end
        P_CURSOR: s.cursor = a.word ret end
        P_INTERACTIVE: s.interactive = a.num != 0.0 ret end
        P_SELECTABLE: s.selectable = a.num != 0.0 ret end
        P_IMAGE_FIT: s.image_fit = a.word ret end
        P_ACCENT: s.accent = a.color ret end
        P_CARET: s.caret = a.color ret end
        P_SCROLLBAR: s.scrollbar = a.word ret end
        P_SCROLLBAR_COLOR:
            s.scrollbar_thumb = a.color
            s.scrollbar_track = n > 1 ? _it(v, 1).color : color.Color { a = 0.0 }
            ret
        end
        P_COLOR: s.color = a.color ret end
        P_FONT:
            mut list := Vector {} as Vector<str>
            each it in v.items:
                list.Push(it.kind == ITEM_WORD ? _kw_en(it.word) : it.text)
            end
            s.font = list
            ret
        end
        P_FONT_SIZE: s.font_size = a.len ret end
        P_FONT_WEIGHT: s.font_weight = _weight(a) ret end
        P_ITALIC: s.italic = a.num != 0.0 ret end
        P_LINE_HEIGHT:
            if a.kind == ITEM_NUM:
                s.line_height = a.num
                s.line_height_len = Len {}
            else:
                s.line_height = 0.0
                s.line_height_len = a.len
            end
            ret
        end
        P_LETTER_SPACING: s.letter_spacing = a.len ret end
        P_WORD_SPACING: s.word_spacing = a.len ret end
        P_TEXT_ALIGN: s.text_align = a.word ret end
        P_DECORATION: s.decoration = a.word ret end
        P_DECORATION_COLOR: s.decoration_color = a.color ret end
        P_DECORATION_STYLE: s.decoration_style = a.word ret end
        P_DECORATION_THICKNESS: s.decoration_thickness = _dim_of(a) ret end
        P_TRANSFORM_TEXT: s.transform_text = a.word ret end
        P_WRAP_TEXT: s.wrap_text = a.num != 0.0 ret end
        P_MAX_LINES: s.max_lines = a.kind == ITEM_WORD ? 0 : a.num as int ret end
        P_ELLIPSIS: s.ellipsis = a.num != 0.0 ret end
        P_DIRECTION: s.direction = a.word ret end
        P_WHITE_SPACE: s.white_space = a.word ret end
        P_TEXT_SHADOW: s.text_shadow = _shadows(v, true) ret end
        P_FONT_FEATURES:
            mut list := Vector {} as Vector<str>
            if a.kind != ITEM_WORD:
                each it in v.items:
                    list.Push(it.text)
                end
            end
            s.font_features = list
            ret
        end
        P_TRANSITION:
            mut list := Vector {} as Vector<Transition>
            if a.kind != ITEM_WORD:
                each g in v.starts:
                    list.Push(Transition { duration = _it(v, g).num, easing = _it(v, g + 1).ease, delay = _it(v, g + 2).num })
                end
            end
            s.transition = list
            ret
        end
        P_TRANSITION_PROPERTIES:
            mut list := Vector {} as Vector<int>
            if a.kind != ITEM_WORD:
                each it in v.items:
                    list.Push(it.word)
                end
            end
            s.transition_props = list
            ret
        end
    end
    if prop >= P_BLUR and prop <= P_BACKDROP_HUE_ROTATE:
        _set_filter(s, prop, a)
    end
end

@en "Inherit"
@fa "ارث بری"
pub func Inherit(parent: Style, child &: Style):
    base := Style {}
    repeat PROP_COUNT in p:
        if not _prop_info(p).inherited:
            continue
        end
        if Format(p, Get(child, p)) == Format(p, Get(base, p)):
            Set(child, p, Get(parent, p))
        end
    end
end

@en "Default"
@fa "پیش فرض"
pub func Default(element: str): Style:
    mut s := Style {}
    key := _element_key(element)
    switch key:
        "page":
            s.min_height = Dim { len = Vh(100.0) }
            s.background.Push(Paint { kind = PAINT_COLOR, color = color.Color { r = 1.0, g = 1.0, b = 1.0 } })
            break
        end
        "h1": _heading(s, 2.0) break end
        "h2": _heading(s, 1.5) break end
        "h3": _heading(s, 1.25) break end
        "h4": _heading(s, 1.0) break end
        "h5": _heading(s, 0.875) break end
        "h6": _heading(s, 0.75) break end
        "paragraph", "caption", "summary": _block_text(s) break end
        "span", "label", "option": _text_flow(s) break end
        "bold":
            _text_flow(s)
            s.font_weight = 700
            break
        end
        "italic":
            _text_flow(s)
            s.italic = true
            break
        end
        "code":
            _text_flow(s)
            s.font.Push("mono")
            s.font_size = Em(0.875)
            break
        end
        "preformatted":
            _block_text(s)
            s.font.Push("mono")
            s.font_size = Em(0.875)
            s.white_space = KW_KEEP
            s.wrap_text = false
            break
        end
        "link":
            _text_flow(s)
            s.color = color.Color { r = 0.10196078431372549, g = 0.45098039215686275, b = 0.9098039215686274 }
            s.decoration = KW_UNDERLINE
            s.cursor = KW_POINTER
            break
        end
        "small":
            _text_flow(s)
            s.font_size = Em(0.833)
            break
        end
        "subscript":
            _text_flow(s)
            s.font_size = Em(0.75)
            break
        end
        "mark":
            _text_flow(s)
            s.background.Push(Paint { kind = PAINT_COLOR, color = color.Color { r = 1.0, g = 1.0 } })
            s.color = color.Color {}
            break
        end
        "deleted":
            _text_flow(s)
            s.decoration = KW_STRIKE
            break
        end
        "inserted":
            _text_flow(s)
            s.decoration = KW_UNDERLINE
            break
        end
        "abbreviation":
            _text_flow(s)
            s.decoration = KW_UNDERLINE
            s.decoration_style = KW_DOTTED
            break
        end
        "button":
            s.layout_kind = KW_ROW
            s.align = KW_CENTER
            s.justify = KW_CENTER
            s.padding_top = Px(4.0)
            s.padding_bottom = Px(4.0)
            s.padding_start = Px(12.0)
            s.padding_end = Px(12.0)
            _gray_border(s)
            s.radius_top_start = Px(4.0)
            s.radius_top_end = Px(4.0)
            s.radius_bottom_end = Px(4.0)
            s.radius_bottom_start = Px(4.0)
            s.background.Push(Paint { kind = PAINT_COLOR, color = color.Color { r = 0.9411764705882353, g = 0.9411764705882353, b = 0.9411764705882353 } })
            s.cursor = KW_POINTER
            s.selectable = false
            break
        end
        "input", "select":
            _field(s)
            s.width = key == "input" ? Dim { len = Em(12.0) } : Dim { word = KW_AUTO }
            s.cursor = key == "input" ? KW_TEXT : KW_POINTER
            break
        end
        "textarea":
            _field(s)
            s.width = Dim { len = Em(20.0) }
            s.height = Dim { len = Em(5.0) }
            s.cursor = KW_TEXT
            s.white_space = KW_KEEP
            break
        end
        "checkbox", "radio":
            s.width = Dim { len = Px(16.0) }
            s.height = Dim { len = Px(16.0) }
            s.cursor = KW_POINTER
            break
        end
        "image", "video":
            s.layout_kind = KW_FLOW
            break
        end
        "list", "ordered list":
            s.padding_start = Em(2.0)
            s.margin_top = Dim { len = Em(0.5) }
            s.margin_bottom = Dim { len = Em(0.5) }
            break
        end
        "item", "description":
            _text_flow(s)
            if key == "description":
                s.margin_start = Dim { len = Em(2.0) }
            end
            break
        end
        "table row":
            s.layout_kind = KW_ROW
            break
        end
        "cell", "header cell":
            _text_flow(s)
            s.grow = 1.0
            s.basis = Dim {}
            s.padding_top = Px(2.0)
            s.padding_bottom = Px(2.0)
            s.padding_start = Px(4.0)
            s.padding_end = Px(4.0)
            if key == "header cell":
                s.font_weight = 700
                s.text_align = KW_CENTER
            end
            break
        end
        "line":
            s.border_top_width = Px(1.0)
            s.border_top_color = color.Color { r = 0.5607843137254902, g = 0.5607843137254902, b = 0.615686274509804 }
            s.margin_top = Dim { len = Em(0.5) }
            s.margin_bottom = Dim { len = Em(0.5) }
            break
        end
        "block quote":
            s.margin_top = Dim { len = Em(0.5) }
            s.margin_bottom = Dim { len = Em(0.5) }
            s.margin_start = Dim { len = Em(2.0) }
            s.margin_end = Dim { len = Em(2.0) }
            break
        end
        "field set":
            _gray_border(s)
            s.padding_top = Px(8.0)
            s.padding_bottom = Px(8.0)
            s.padding_start = Px(12.0)
            s.padding_end = Px(12.0)
            break
        end
        "progress":
            s.width = Dim { len = Em(10.0) }
            s.height = Dim { len = Em(1.0) }
            break
        end
    end
    if key == "summary":
        s.cursor = KW_POINTER
    end
    if key == "caption":
        s.text_align = KW_CENTER
    end
    ret s
end
