package style

import str
import gui.color

func _ccolor(c: color.Color): str:
    if c.current:
        ret "currentColor"
    end
    ret color.Css(c)
end

func _cword(w: int): str:
    switch w:
        KW_BETWEEN: ret "space-between" end
        KW_AROUND: ret "space-around" end
        KW_EVENLY: ret "space-evenly" end
        KW_MIN_CONTENT: ret "min-content" end
        KW_MAX_CONTENT: ret "max-content" end
        KW_FIT: ret "fit-content" end
        KW_FILL: ret "100%" end
        KW_NOT_ALLOWED: ret "not-allowed" end
        KW_RESIZE: ret "nwse-resize" end
        KW_RESIZE_X: ret "ew-resize" end
        KW_RESIZE_Y: ret "ns-resize" end
        KW_ZOOM_IN: ret "zoom-in" end
        KW_ZOOM_OUT: ret "zoom-out" end
        KW_SCALE_DOWN: ret "scale-down" end
        KW_STRIKE: ret "line-through" end
        KW_UPPER: ret "uppercase" end
        KW_LOWER: ret "lowercase" end
        KW_SANS: ret "sans-serif" end
        KW_MONO: ret "monospace" end
        KW_SYSTEM: ret "system-ui" end
        KW_START: ret "var(--salam-start,left)" end
        KW_END: ret "var(--salam-end,right)" end
        KW_ROW_DENSE: ret "row dense" end
        KW_COLUMN_DENSE: ret "column dense" end
    end
    if w >= KW_COLOR_DODGE and w <= KW_SOFT_LIGHT:
        ret str.Replace(_kw_en(w), " ", "-")
    end
    ret _kw_en(w)
end

func _flex_word(w: int): str:
    if w == KW_START:
        ret "flex-start"
    end
    if w == KW_END:
        ret "flex-end"
    end
    ret _cword(w)
end

func _citem(it: Item): str:
    switch it.kind:
        ITEM_LEN: ret _len_css(it.len) end
        ITEM_NUM: ret _fmt(it.num) end
        ITEM_INT: ret str.FromInt(it.num as i64) end
        ITEM_TIME: ret _fmt(it.num) + "ms" end
        ITEM_ANGLE: ret _fmt(it.num) + "deg" end
        ITEM_COLOR: ret _ccolor(it.color) end
        ITEM_WORD: ret _cword(it.word) end
        ITEM_STR: ret _src_str(it.text) end
    end
    ret ""
end

func _clist(v: Value, sep: str): str:
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    each it in v.items:
        parts.push(_citem(it))
    end
    ret str.Join(parts, sep)
end

func _logical(v: Value, prefix: str, suffix: str): str:
    n := v.items.len()
    if n == 1:
        ret prefix + suffix + ":" + _citem(_it(v, 0))
    end
    if n == 2:
        ret prefix + "-block" + suffix + ":" + _citem(_it(v, 0)) + ";" + prefix + "-inline" + suffix + ":" + _citem(_it(v, 1))
    end
    mut t := prefix + "-top" + suffix + ":" + _citem(_it(v, 0)) + ";" + prefix + "-inline" + suffix + ":" + _citem(_it(v, 1)) + ";" + prefix + "-bottom" + suffix + ":" + _citem(_it(v, 2))
    if n == 4:
        t = prefix + "-top" + suffix + ":" + _citem(_it(v, 0)) + ";" + prefix + "-inline-end" + suffix + ":" + _citem(_it(v, 1)) + ";" + prefix + "-bottom" + suffix + ":" + _citem(_it(v, 2)) + ";" + prefix + "-inline-start" + suffix + ":" + _citem(_it(v, 3))
    end
    ret t
end

func _cinset(v: Value): str:
    if v.items.len() == 1:
        ret "inset:" + _citem(_it(v, 0))
    end
    ret "top:" + _citem(_side4(v, 0)) + ";inset-inline-end:" + _citem(_side4(v, 1)) + ";bottom:" + _citem(_side4(v, 2)) + ";inset-inline-start:" + _citem(_side4(v, 3))
end

func _cradius(v: Value): str:
    if v.items.len() == 1:
        ret "border-radius:" + _citem(_it(v, 0))
    end
    ret "border-start-start-radius:" + _citem(_corner4(v, 0)) + ";border-start-end-radius:" + _citem(_corner4(v, 1)) + ";border-end-end-radius:" + _citem(_corner4(v, 2)) + ";border-end-start-radius:" + _citem(_corner4(v, 3))
end

func _cborder(v: Value): str:
    ret _citem(_it(v, 0)) + " " + _citem(_it(v, 1)) + " " + _citem(_it(v, 2))
end

func _cshadow(v: Value, text: bool): str:
    if _it(v, 0).kind == ITEM_WORD:
        ret "none"
    end
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    each g in v.starts:
        if text:
            parts.push(_citem(_it(v, g)) + " " + _citem(_it(v, g + 1)) + " " + _citem(_it(v, g + 2)) + " " + _citem(_it(v, g + 3)))
        else:
            mut t := _citem(_it(v, g)) + " " + _citem(_it(v, g + 1)) + " " + _citem(_it(v, g + 2)) + " " + _citem(_it(v, g + 3)) + " " + _citem(_it(v, g + 4))
            if _it(v, g + 5).num != 0.0:
                t = "inset " + t
            end
            parts.push(t)
        end
    end
    ret str.Join(parts, ",")
end

func _cside(word: int, l: Len): str:
    ret word != 0 ? _cword(word) : _len_css(l)
end

func _ctracks(v: Value): str:
    if _it(v, 0).kind == ITEM_WORD:
        ret _cword(_it(v, 0).word)
    end
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    mut i := 0
    until i < v.items.len():
        tr := _it(v, i).track
        switch tr.kind:
            TRACK_MINMAX:
                parts.push("minmax(" + _cside(tr.word, tr.len) + "," + _cside(tr.max_word, tr.max) + ")")
                break
            end
            TRACK_FIT:
                parts.push("fit-content(" + _len_css(tr.len) + ")")
                break
            end
            TRACK_REPEAT:
                mut inner := Vector {} as Vector<str>
                repeat tr.span in k:
                    one := Value {}.And(_it(v, i + 1 + k))
                    inner.push(_ctracks(one))
                end
                count := tr.word == KW_FILL ? "auto-fill" : (tr.word == KW_FIT ? "auto-fit" : str.FromInt(tr.count as i64))
                parts.push("repeat(" + count + "," + str.Join(inner, " ") + ")")
                inner.free()
                i += tr.span
                break
            end
            else:
                parts.push(_cside(tr.word, tr.len))
            end
        end
        i++
    end
    ret str.Join(parts, " ")
end

func _cstops(p: Paint): str:
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    each s in p.stops:
        parts.push(s.has_at ? _ccolor(s.color) + " " + _len_css(s.at) : _ccolor(s.color))
    end
    ret str.Join(parts, ",")
end

func _cpaint(p: Paint): str:
    switch p.kind:
        PAINT_COLOR: ret "linear-gradient(" + _ccolor(p.color) + "," + _ccolor(p.color) + ")" end
        PAINT_IMAGE: ret "url(" + _src_str(p.path) + ")" end
        PAINT_LINEAR:
            head := p.side != 0 ? _kw_en(p.side) : _fmt(p.angle) + "deg"
            ret "linear-gradient(" + head + "," + _cstops(p) + ")"
        end
        PAINT_RADIAL:
            mut head := p.circle ? "circle" : "ellipse"
            if p.has_at:
                head += " at " + _len_css(p.at_x) + " " + _len_css(p.at_y)
            end
            ret "radial-gradient(" + head + "," + _cstops(p) + ")"
        end
        PAINT_CONIC:
            mut head := "from " + _fmt(p.angle) + "deg"
            if p.has_at:
                head += " at " + _len_css(p.at_x) + " " + _len_css(p.at_y)
            end
            ret "conic-gradient(" + head + "," + _cstops(p) + ")"
        end
    end
    ret "none"
end

func _cbackground(v: Value): str:
    first := _it(v, 0)
    if first.kind == ITEM_WORD:
        ret "background-color:transparent;background-image:none"
    end
    n := v.items.len()
    last := _it(v, n - 1)
    mut layers := Vector {} as Vector<str>
    defer layers.free()
    mut base := "transparent"
    repeat n in i:
        it := _it(v, i)
        if i == n - 1 and last.kind == ITEM_COLOR:
            base = _ccolor(last.color)
            continue
        end
        layers.push(it.kind == ITEM_COLOR ? _cpaint(Paint { kind = PAINT_COLOR, color = it.color }) : _cpaint(it.paint))
    end
    image := layers.len() == 0 ? "none" : str.Join(layers, ",")
    ret "background-color:" + base + ";background-image:" + image
end

func _cease(e: Easing): str:
    switch e.kind:
        EASE_LINEAR: ret "linear" end
        EASE_EASE: ret "ease" end
        EASE_IN: ret "ease-in" end
        EASE_OUT: ret "ease-out" end
        EASE_IN_OUT: ret "ease-in-out" end
        EASE_CUBIC: ret "cubic-bezier(" + _fmt(e.x1) + "," + _fmt(e.y1) + "," + _fmt(e.x2) + "," + _fmt(e.y2) + ")" end
        EASE_STEPS: ret "steps(" + str.FromInt(e.steps as i64) + ")" end
        EASE_SPRING:
            mut parts := Vector {} as Vector<str>
            defer parts.free()
            repeat 41 in i:
                parts.push(_fmt(EaseAt(e, (i as f64) / 40.0)))
            end
            ret "linear(" + str.Join(parts, ",") + ")"
        end
    end
    ret "ease"
end

func _css_names(prop: int): str:
    switch prop:
        P_GAP: ret "gap" end
        P_GROW: ret "flex-grow" end
        P_SHRINK: ret "flex-shrink" end
        P_BASIS: ret "flex-basis" end
        P_TOP: ret "top" end
        P_BOTTOM: ret "bottom" end
        P_LEFT: ret "left" end
        P_RIGHT: ret "right" end
        P_START: ret "inset-inline-start" end
        P_END: ret "inset-inline-end" end
        P_INSET: ret "inset" end
        P_WIDTH: ret "width" end
        P_HEIGHT: ret "height" end
        P_MIN_WIDTH: ret "min-width" end
        P_MIN_HEIGHT: ret "min-height" end
        P_MAX_WIDTH: ret "max-width" end
        P_MAX_HEIGHT: ret "max-height" end
        P_ASPECT_RATIO: ret "aspect-ratio" end
        P_PADDING, P_PADDING_TOP, P_PADDING_BOTTOM, P_PADDING_START, P_PADDING_END, P_PADDING_LEFT, P_PADDING_RIGHT, P_PADDING_X, P_PADDING_Y: ret "padding" end
        P_MARGIN, P_MARGIN_TOP, P_MARGIN_BOTTOM, P_MARGIN_START, P_MARGIN_END, P_MARGIN_LEFT, P_MARGIN_RIGHT, P_MARGIN_X, P_MARGIN_Y: ret "margin" end
        P_BACKGROUND: ret "background-color,background-image" end
        P_BACKGROUND_SIZE: ret "background-size" end
        P_BACKGROUND_POSITION: ret "background-position" end
        P_BORDER, P_BORDER_TOP, P_BORDER_BOTTOM, P_BORDER_START, P_BORDER_END, P_BORDER_LEFT, P_BORDER_RIGHT: ret "border-width,border-color" end
        P_BORDER_WIDTH: ret "border-width" end
        P_BORDER_COLOR: ret "border-color" end
        P_RADIUS, P_RADIUS_TOP_START, P_RADIUS_TOP_END, P_RADIUS_BOTTOM_END, P_RADIUS_BOTTOM_START: ret "border-radius" end
        P_OUTLINE: ret "outline-width,outline-color" end
        P_OUTLINE_OFFSET: ret "outline-offset" end
        P_SHADOW: ret "box-shadow" end
        P_OPACITY: ret "opacity" end
        P_TRANSLATE: ret "translate" end
        P_ROTATE: ret "rotate" end
        P_SCALE: ret "scale" end
        P_SKEW: ret "transform" end
        P_ORIGIN: ret "transform-origin" end
        P_ACCENT: ret "accent-color" end
        P_CARET: ret "caret-color" end
        P_SCROLLBAR_COLOR: ret "scrollbar-color" end
        P_COLOR: ret "color" end
        P_FONT_SIZE: ret "font-size" end
        P_FONT_WEIGHT: ret "font-weight" end
        P_LINE_HEIGHT: ret "line-height" end
        P_LETTER_SPACING: ret "letter-spacing" end
        P_WORD_SPACING: ret "word-spacing" end
        P_DECORATION_COLOR: ret "text-decoration-color" end
        P_DECORATION_THICKNESS: ret "text-decoration-thickness" end
        P_TEXT_SHADOW: ret "text-shadow" end
    end
    if prop >= P_BLUR and prop <= P_HUE_ROTATE:
        ret "filter"
    end
    if prop >= P_BACKDROP_BLUR and prop <= P_BACKDROP_HUE_ROTATE:
        ret "backdrop-filter"
    end
    ret ""
end

func _all_transition_names(): str:
    mut seen := Vector {} as Vector<str>
    defer seen.free()
    repeat PROP_COUNT in p:
        if not _prop_info(p).animatable:
            continue
        end
        parts := str.Split(_css_names(p), ",")
        each x in parts:
            mut dup := false
            each y in seen:
                if x == y:
                    dup = true
                end
            end
            if not dup and x != "":
                seen.push(x)
            end
        end
        parts.free()
    end
    ret str.Join(seen, ",")
end

func _filter_fn(k: int): str:
    switch k:
        0: ret "blur" end
        1: ret "brightness" end
        2: ret "contrast" end
        3: ret "grayscale" end
        4: ret "saturate" end
        5: ret "sepia" end
        6: ret "invert" end
    end
    ret "hue-rotate"
end

func _filter_chain(backdrop: bool): str:
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    pre := backdrop ? "--salam-b-" : "--salam-f-"
    repeat 8 in k:
        parts.push("var(" + pre + _filter_fn(k) + ",)")
    end
    ret str.Join(parts, " ")
end

func _cfilter(prop: int, it: Item): str:
    backdrop := prop >= P_BACKDROP_BLUR
    k := backdrop ? prop - P_BACKDROP_BLUR : prop - P_BLUR
    name := _filter_fn(k)
    pre := backdrop ? "--salam-b-" : "--salam-f-"
    mut identity := false
    switch k:
        0: identity = _len_css(it.len) == "0" break end
        1, 2, 4: identity = it.num == 1.0 break end
        else: identity = it.num == 0.0 end
    end
    mut decl := pre + name + ":" + (identity ? "initial" : name + "(" + (k == 0 ? _len_css(it.len) : _citem(it)) + ")")
    if not identity:
        if backdrop:
            chain := _filter_chain(true)
            decl += ";-webkit-backdrop-filter:" + chain + ";backdrop-filter:" + chain
        else:
            decl += ";filter:" + _filter_chain(false)
        end
    end
    ret decl
end

func _clayout(w: int): str:
    switch w:
        KW_ROW: ret "display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,row);--salam-rev:row-reverse" end
        KW_GRID: ret "display:var(--salam-o,block) grid" end
        KW_STACK: ret "display:var(--salam-o,block) grid;grid-template:minmax(0,1fr)/minmax(0,1fr);justify-items:var(--salam-j,stretch);&>*{grid-area:1/1}" end
        KW_FLOW: ret "display:var(--salam-o,block) flow;&>*{--salam-o:inline}" end
    end
    ret "display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,column);--salam-rev:column-reverse"
end

func _cdirection(w: int): str:
    switch w:
        KW_RTL: ret "direction:rtl;--salam-bidi:isolate;--salam-start:right;--salam-end:left" end
        KW_LTR: ret "direction:ltr;--salam-bidi:isolate;--salam-start:left;--salam-end:right" end
    end
    ret "--salam-bidi:plaintext"
end

func _ccss(prop: int, v: Value): str:
    a := _it(v, 0)
    n := v.items.len()
    switch prop:
        P_LAYOUT: ret _clayout(a.word) end
        P_GAP: ret "gap:" + _clist(v, " ") end
        P_ALIGN: ret "align-items:" + _flex_word(a.word) end
        P_JUSTIFY:
            j := a.word == KW_START or a.word == KW_CENTER or a.word == KW_END ? _kw_en(a.word) : "start"
            ret "justify-content:" + _flex_word(a.word) + ";--salam-j:" + j
        end
        P_ALIGN_CONTENT: ret "align-content:" + _flex_word(a.word) end
        P_WRAP: ret "flex-wrap:" + (a.num != 0.0 ? "wrap" : "nowrap") end
        P_REVERSE: ret "--salam-dir:" + (a.num != 0.0 ? "var(--salam-rev)" : "initial") end
        P_COLUMNS: ret "grid-template-columns:" + _ctracks(v) end
        P_ROWS: ret "grid-template-rows:" + _ctracks(v) end
        P_AUTO_COLUMNS: ret "grid-auto-columns:" + _ctracks(v) end
        P_AUTO_ROWS: ret "grid-auto-rows:" + _ctracks(v) end
        P_AUTO_FLOW: ret "grid-auto-flow:" + _cword(a.word) end
        P_GROW: ret "flex-grow:" + _citem(a) end
        P_SHRINK: ret "flex-shrink:" + _citem(a) end
        P_BASIS: ret "flex-basis:" + _citem(a) end
        P_ALIGN_SELF: ret "align-self:" + _flex_word(a.word) end
        P_JUSTIFY_SELF: ret "justify-self:" + _kw_en(a.word) end
        P_COLUMN: ret "grid-column-start:" + _citem(a) end
        P_ROW: ret "grid-row-start:" + _citem(a) end
        P_COLUMN_SPAN: ret "grid-column-end:span " + _citem(a) end
        P_ROW_SPAN: ret "grid-row-end:span " + _citem(a) end
        P_ORDER: ret "order:" + _citem(a) end
        P_POSITION: ret "position:" + (a.word == KW_NORMAL ? "relative" : _kw_en(a.word)) end
        P_TOP: ret "top:" + _citem(a) end
        P_BOTTOM: ret "bottom:" + _citem(a) end
        P_START: ret "inset-inline-start:" + _citem(a) end
        P_END: ret "inset-inline-end:" + _citem(a) end
        P_LEFT: ret "left:" + _citem(a) end
        P_RIGHT: ret "right:" + _citem(a) end
        P_INSET: ret _cinset(v) end
        P_LAYER: ret "z-index:" + (a.num == 0.0 ? "auto" : _citem(a)) end
        P_WIDTH: ret "width:" + _citem(a) end
        P_HEIGHT: ret "height:" + _citem(a) end
        P_MIN_WIDTH: ret "min-width:" + _citem(a) end
        P_MIN_HEIGHT: ret "min-height:" + _citem(a) end
        P_MAX_WIDTH: ret "max-width:" + _citem(a) end
        P_MAX_HEIGHT: ret "max-height:" + _citem(a) end
        P_ASPECT_RATIO: ret "aspect-ratio:" + (a.kind == ITEM_WORD ? "auto" : _citem(a)) end
        P_PADDING: ret _logical(v, "padding", "") end
        P_PADDING_TOP: ret "padding-top:" + _citem(a) end
        P_PADDING_BOTTOM: ret "padding-bottom:" + _citem(a) end
        P_PADDING_START: ret "padding-inline-start:" + _citem(a) end
        P_PADDING_END: ret "padding-inline-end:" + _citem(a) end
        P_PADDING_LEFT: ret "padding-left:" + _citem(a) end
        P_PADDING_RIGHT: ret "padding-right:" + _citem(a) end
        P_PADDING_X: ret "padding-inline:" + _citem(a) end
        P_PADDING_Y: ret "padding-block:" + _citem(a) end
        P_MARGIN: ret _logical(v, "margin", "") end
        P_MARGIN_TOP: ret "margin-top:" + _citem(a) end
        P_MARGIN_BOTTOM: ret "margin-bottom:" + _citem(a) end
        P_MARGIN_START: ret "margin-inline-start:" + _citem(a) end
        P_MARGIN_END: ret "margin-inline-end:" + _citem(a) end
        P_MARGIN_LEFT: ret "margin-left:" + _citem(a) end
        P_MARGIN_RIGHT: ret "margin-right:" + _citem(a) end
        P_MARGIN_X: ret "margin-inline:" + _citem(a) end
        P_MARGIN_Y: ret "margin-block:" + _citem(a) end
        P_OVERFLOW: ret "overflow:" + _clist(v, " ") end
        P_OVERFLOW_X: ret "overflow-x:" + _citem(a) end
        P_OVERFLOW_Y: ret "overflow-y:" + _citem(a) end
        P_VISIBLE: ret a.num != 0.0 ? "" : "display:none!important" end
        P_CLIP: ret a.num != 0.0 ? "overflow:clip" : "" end
        P_BACKGROUND: ret _cbackground(v) end
        P_BACKGROUND_SIZE: ret "background-size:" + _clist(v, " ") end
        P_BACKGROUND_POSITION: ret "background-position:" + _clist(v, " ") end
        P_BACKGROUND_REPEAT:
            r := a.word == KW_TRUE ? "repeat" : (a.word == KW_X ? "repeat-x" : (a.word == KW_Y ? "repeat-y" : "no-repeat"))
            ret "background-repeat:" + r
        end
        P_BORDER: ret "border:" + _cborder(v) end
        P_BORDER_TOP: ret "border-top:" + _cborder(v) end
        P_BORDER_BOTTOM: ret "border-bottom:" + _cborder(v) end
        P_BORDER_START: ret "border-inline-start:" + _cborder(v) end
        P_BORDER_END: ret "border-inline-end:" + _cborder(v) end
        P_BORDER_LEFT: ret "border-left:" + _cborder(v) end
        P_BORDER_RIGHT: ret "border-right:" + _cborder(v) end
        P_BORDER_WIDTH: ret _logical(v, "border", "-width") end
        P_BORDER_STYLE: ret "border-style:" + _citem(a) end
        P_BORDER_COLOR: ret _logical(v, "border", "-color") end
        P_RADIUS: ret _cradius(v) end
        P_RADIUS_TOP_START: ret "border-start-start-radius:" + _citem(a) end
        P_RADIUS_TOP_END: ret "border-start-end-radius:" + _citem(a) end
        P_RADIUS_BOTTOM_END: ret "border-end-end-radius:" + _citem(a) end
        P_RADIUS_BOTTOM_START: ret "border-end-start-radius:" + _citem(a) end
        P_OUTLINE: ret "outline:" + _cborder(v) end
        P_OUTLINE_OFFSET: ret "outline-offset:" + _citem(a) end
        P_SHADOW: ret "box-shadow:" + _cshadow(v, false) end
        P_OPACITY: ret "opacity:" + _citem(a) end
        P_BLEND: ret "mix-blend-mode:" + _cword(a.word) end
        P_TRANSLATE:
            if n == 1 and _len_css(a.len) == "0":
                ret "translate:none"
            end
            if n == 2 and _len_css(a.len) == "0" and _len_css(_it(v, 1).len) == "0":
                ret "translate:none"
            end
            ret "translate:" + _clist(v, " ")
        end
        P_ROTATE: ret "rotate:" + (a.num == 0.0 ? "none" : _citem(a)) end
        P_SCALE:
            if a.num == 1.0 and (n == 1 or _it(v, 1).num == 1.0):
                ret "scale:none"
            end
            ret "scale:" + _clist(v, " ")
        end
        P_SKEW:
            if a.num == 0.0 and (n == 1 or _it(v, 1).num == 0.0):
                ret "transform:none"
            end
            ret "transform:skew(" + _clist(v, ",") + ")"
        end
        P_ORIGIN: ret "transform-origin:" + _clist(v, " ") end
        P_CURSOR: ret "cursor:" + _cword(a.word) end
        P_INTERACTIVE: ret "pointer-events:" + (a.num != 0.0 ? "auto" : "none") end
        P_SELECTABLE:
            u := a.num != 0.0 ? "text" : "none"
            ret "-webkit-user-select:" + u + ";user-select:" + u
        end
        P_IMAGE_FIT: ret "object-fit:" + (a.word == KW_SCALE_DOWN ? "scale-down" : _kw_en(a.word)) end
        P_ACCENT: ret "accent-color:" + _citem(a) + ";--salam-accent:" + _citem(a) end
        P_CARET: ret "caret-color:" + _citem(a) end
        P_SCROLLBAR: ret "scrollbar-width:" + _cword(a.word) end
        P_SCROLLBAR_COLOR: ret "scrollbar-color:" + _citem(a) + " " + (n > 1 ? _citem(_it(v, 1)) : "transparent") end
        P_COLOR: ret "color:" + _citem(a) end
        P_FONT: ret "font-family:" + _clist(v, ",") end
        P_FONT_SIZE: ret "font-size:" + _citem(a) end
        P_FONT_WEIGHT: ret "font-weight:" + str.FromInt(_weight(a) as i64) end
        P_ITALIC: ret "font-style:" + (a.num != 0.0 ? "italic" : "normal") end
        P_LINE_HEIGHT: ret "line-height:" + _citem(a) end
        P_LETTER_SPACING: ret "letter-spacing:" + _citem(a) end
        P_WORD_SPACING: ret "word-spacing:" + _citem(a) end
        P_TEXT_ALIGN: ret "text-align:" + _kw_en(a.word) end
        P_DECORATION: ret "text-decoration-line:" + _cword(a.word) end
        P_DECORATION_COLOR: ret "text-decoration-color:" + _citem(a) end
        P_DECORATION_STYLE: ret "text-decoration-style:" + _cword(a.word) end
        P_DECORATION_THICKNESS: ret "text-decoration-thickness:" + _citem(a) end
        P_TRANSFORM_TEXT: ret "text-transform:" + _cword(a.word) end
        P_WRAP_TEXT: ret "text-wrap-mode:" + (a.num != 0.0 ? "wrap" : "nowrap") end
        P_MAX_LINES:
            if a.kind == ITEM_WORD:
                ret "-webkit-line-clamp:none;line-clamp:none"
            end
            k := _citem(a)
            ret "display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:" + k + ";line-clamp:" + k + ";overflow:hidden"
        end
        P_ELLIPSIS: ret a.num != 0.0 ? "text-overflow:ellipsis;overflow:hidden;text-wrap-mode:nowrap" : "text-overflow:clip" end
        P_DIRECTION: ret _cdirection(a.word) end
        P_WHITE_SPACE: ret "white-space-collapse:" + (a.word == KW_KEEP ? "preserve" : "collapse") end
        P_TEXT_SHADOW: ret "text-shadow:" + _cshadow(v, true) end
        P_FONT_FEATURES: ret "font-feature-settings:" + (a.kind == ITEM_WORD ? "normal" : _clist(v, ",")) end
        P_TRANSITION:
            if a.kind == ITEM_WORD:
                ret "transition-duration:0s;transition-delay:0s"
            end
            mut d := Vector {} as Vector<str>
            mut e := Vector {} as Vector<str>
            mut l := Vector {} as Vector<str>
            defer d.free()
            defer e.free()
            defer l.free()
            each g in v.starts:
                d.push(_citem(_it(v, g)))
                e.push(_cease(_it(v, g + 1).ease))
                l.push(_citem(_it(v, g + 2)))
            end
            ret "transition-duration:" + str.Join(d, ",") + ";transition-timing-function:" + str.Join(e, ",") + ";transition-delay:" + str.Join(l, ",")
        end
        P_TRANSITION_PROPERTIES:
            if a.kind == ITEM_WORD:
                ret "transition-property:" + _all_transition_names()
            end
            mut names := Vector {} as Vector<str>
            defer names.free()
            each it in v.items:
                names.push(_css_names(it.word))
            end
            ret "transition-property:" + str.Join(names, ",")
        end
    end
    if prop >= P_BLUR and prop <= P_BACKDROP_HUE_ROTATE:
        ret _cfilter(prop, a)
    end
    ret ""
end

func _universal_selector(): str:
    ret ":where(:not(head,head *,script,style,template,br,wbr,option,optgroup,datalist,area,source,track,param,noscript,svg *,math *))"
end

func _element_selector(key: str): str:
    switch key:
        "page": ret "html,body" end
        "h1": ret "h1" end
        "h2": ret "h2" end
        "h3": ret "h3" end
        "h4": ret "h4" end
        "h5": ret "h5" end
        "h6": ret "h6" end
        "paragraph": ret "p,dl,dt" end
        "span": ret "span,bdi,bdo,data,time,output,q" end
        "bold": ret "b,strong" end
        "italic": ret "i,em,cite,var,dfn" end
        "code": ret "code,kbd,samp" end
        "preformatted": ret "pre" end
        "link": ret "a" end
        "small": ret "small" end
        "subscript": ret "sub,sup" end
        "mark": ret "mark" end
        "deleted": ret "del,s" end
        "inserted": ret "ins,u" end
        "abbreviation": ret "abbr" end
        "button": ret "button" end
        "input": ret "input:not([type=checkbox],[type=radio],[type=range],[type=color],[type=file],[type=hidden],[type=image])" end
        "textarea": ret "textarea" end
        "select": ret "select" end
        "checkbox": ret "input[type=checkbox]" end
        "radio": ret "input[type=radio]" end
        "image": ret "img,picture" end
        "video": ret "video,canvas,iframe,svg,embed,object,audio" end
        "list": ret "ul,menu" end
        "ordered list": ret "ol" end
        "item": ret "li" end
        "description": ret "dd" end
        "table": ret "table" end
        "table section": ret "thead,tbody,tfoot" end
        "table row": ret "tr" end
        "cell": ret "td" end
        "header cell": ret "th" end
        "caption": ret "caption,figcaption,legend" end
        "line": ret "hr" end
        "label": ret "label" end
        "summary": ret "summary" end
        "block quote": ret "blockquote,figure" end
        "field set": ret "fieldset" end
        "progress": ret "progress,meter" end
    end
    ret ""
end

func _element_keys(): Vector<str>:
    mut out := Vector {} as Vector<str>
    each k in ["h1", "h2", "h3", "h4", "h5", "h6", "paragraph", "span", "bold", "italic", "code", "preformatted", "link", "small", "subscript", "mark", "deleted", "inserted", "abbreviation", "button", "input", "textarea", "select", "checkbox", "radio", "image", "video", "list", "ordered list", "item", "description", "table", "table section", "table row", "cell", "header cell", "caption", "line", "label", "summary", "block quote", "field set", "progress"]:
        out.push(k)
    end
    ret out
end

func _skip_base(p: int): bool:
    ret (p >= P_BLUR and p <= P_BACKDROP_HUE_ROTATE) or p == P_VISIBLE or p == P_CLIP or p == P_OUTLINE or p == P_TRANSITION_PROPERTIES or p == P_MAX_LINES or p == P_ELLIPSIS
end

func _shorthand(p: int): bool:
    switch p:
        P_PADDING_TOP, P_PADDING_BOTTOM, P_PADDING_START, P_PADDING_END, P_PADDING_LEFT, P_PADDING_RIGHT, P_PADDING_X, P_PADDING_Y: ret true end
        P_MARGIN_TOP, P_MARGIN_BOTTOM, P_MARGIN_START, P_MARGIN_END, P_MARGIN_LEFT, P_MARGIN_RIGHT, P_MARGIN_X, P_MARGIN_Y: ret true end
        P_BORDER, P_BORDER_TOP, P_BORDER_BOTTOM, P_BORDER_START, P_BORDER_END, P_BORDER_LEFT, P_BORDER_RIGHT, P_BORDER_STYLE: ret true end
        P_RADIUS_TOP_START, P_RADIUS_TOP_END, P_RADIUS_BOTTOM_END, P_RADIUS_BOTTOM_START: ret true end
        P_TOP, P_BOTTOM, P_START, P_END, P_LEFT, P_RIGHT, P_OVERFLOW_X, P_OVERFLOW_Y: ret true end
    end
    ret false
end

func _decls(s: Style, base: Style, inherited: bool, all: bool, nested &: Vector<str>): str:
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    repeat PROP_COUNT in p:
        if _skip_base(p) or _shorthand(p) or _prop_info(p).inherited != inherited:
            continue
        end
        v := Get(s, p)
        if not all and Format(p, v) == Format(p, Get(base, p)):
            continue
        end
        c := _ccss(p, v)
        at := str.IndexOf(c, ";&")
        if at >= 0:
            parts.push(c.substr(0, at))
            nested.push(c.substr(at + 1, c.len() - at - 1))
        else c != "":
            parts.push(c)
        end
    end
    if not inherited and (s.border_top_style != base.border_top_style or s.border_end_style != base.border_end_style or s.border_bottom_style != base.border_bottom_style or s.border_start_style != base.border_start_style or all):
        parts.push("border-style:" + _cword(s.border_top_style) + " " + _cword(s.border_end_style) + " " + _cword(s.border_bottom_style) + " " + _cword(s.border_start_style))
    end
    ret str.Join(parts, ";")
end

@en "Css"
@fa "سی اس اس"
pub func Css(prop: int, v: Value): str:
    if prop < 0 or prop >= PROP_COUNT or v.items.len() == 0:
        ret ""
    end
    ret _ccss(prop, v)
end

@en "BaseCss"
@fa "سی اس اس پایه"
pub func BaseCss(): str:
    box := Style {}
    page := Default("page")
    mut b := "*,::before,::after{box-sizing:border-box;margin:0;padding:0;border:0 solid currentColor;min-width:0;min-height:0}\n"
    b += "[hidden]{display:none!important}\n"
    b += ":where(input,button,textarea,select){font:inherit;color:inherit;letter-spacing:inherit;word-spacing:inherit;line-height:inherit;text-align:inherit;text-transform:inherit}\n"
    b += ":where(q)::before,:where(q)::after{content:none}\n"
    b += ":where(table){border-collapse:collapse;border-spacing:0}\n"
    b += ":where(:focus-visible){outline:2px solid var(--salam-accent,#1a73e8);outline-offset:2px}"
    mut resets := "--salam-o:block;--salam-dir:initial;--salam-rev:column-reverse;--salam-j:initial;unicode-bidi:var(--salam-bidi,plaintext)"
    repeat 8 in k:
        resets += ";--salam-f-" + _filter_fn(k) + ":initial;--salam-b-" + _filter_fn(k) + ":initial"
    end
    mut nested := Vector {} as Vector<str>
    defer nested.free()
    b += "\n" + _universal_selector() + "{" + resets + ";" + _decls(box, box, false, true, nested) + ";transition-property:" + _all_transition_names() + "}\n"
    b += ":where(html){--salam-start:left;--salam-end:right;" + _decls(page, page, true, true, nested) + "}\n"
    b += ":where(" + _element_selector("page") + "){" + _decls(page, box, false, false, nested) + "}\n"
    keys := _element_keys()
    defer keys.free()
    each key in keys:
        s := Default(key)
        nested.clear()
        mut d := _decls(s, box, false, false, nested)
        di := _decls(s, page, true, false, nested)
        if di != "":
            d = d == "" ? di : d + ";" + di
        end
        if key == "item":
            d += ";display:list-item"
        end
        each x in nested:
            d += ";" + x
        end
        if d != "":
            b += ":where(" + _element_selector(key) + "){" + d + "}\n"
        end
    end
    ret b
end
