package style

import str
import gui.color

func _fmt(x: f64): str:
    neg := x < 0.0
    mut m := neg ? 0.0 - x : x
    if m < 1000000000.0:
        m = ((m * 10000.0 + 0.5) as i64 as f64) / 10000.0
    end
    if m == 0.0:
        ret "0"
    end
    t := str.FromFloat(m)
    ret neg ? "-" + t : t
end

func _src_f(x: f64): str:
    if x == 0.0:
        ret "0.0"
    end
    t := str.FromFloat(x)
    if str.IndexOf(t, ".") >= 0 or str.IndexOf(t, "e") >= 0 or str.IndexOf(t, "n") >= 0:
        ret t
    end
    ret t + ".0"
end

func _src_str(s: str): str:
    ret "\"" + str.Replace(str.Replace(s, "\\", "\\\\"), "\"", "\\\"") + "\""
end

func _hex2(n: int): str:
    d := "0123456789abcdef"
    ret d.substr(n / 16, 1) + d.substr(n % 16, 1)
end

func _byte(x: f64): int:
    mut v := x
    if v < 0.0:
        v = 0.0
    end
    if v > 1.0:
        v = 1.0
    end
    ret (v * 255.0 + 0.5) as int
end

func _color_text1(c: color.Color): str:
    if c.current:
        ret "current"
    end
    mut t := "#" + _hex2(_byte(c.r)) + _hex2(_byte(c.g)) + _hex2(_byte(c.b))
    if c.a < 1.0:
        t += _hex2(_byte(c.a))
    end
    ret t
end

func _color_text(c: color.Color): str:
    if color.HasDark(c):
        ret "light dark(" + _color_text1(color.Light(c)) + ", " + _color_text1(color.Dark(c)) + ")"
    end
    ret _color_text1(c)
end

func _len_terms(l: Len, css: bool): Vector<str>:
    mut out := Vector {} as Vector<str>
    vals := [l.pct, l.em, l.rem, l.vw, l.vh, l.vmin, l.vmax, l.fr, l.px]
    units := ["%", "em", "rem", "vw", "vh", "vmin", "vmax", "fr", css ? "px" : ""]
    repeat 9 in i:
        if vals[i] != 0.0:
            out.push(_fmt(vals[i]) + units[i])
        end
    end
    ret out
end

func _len_join(terms: Vector<str>): str:
    mut t := ""
    each i, x in terms:
        if i == 0:
            t = x
        else x[0] == '-':
            t += " - " + x.substr(1, x.Len() - 1)
        else:
            t += " + " + x
        end
    end
    ret t
end

func _len_text(l: Len): str:
    terms := _len_terms(l, false)
    defer terms.free()
    if terms.Len() == 0:
        ret "0"
    end
    ret _len_join(terms)
end

func _len_css(l: Len): str:
    terms := _len_terms(l, true)
    defer terms.free()
    if terms.Len() == 0:
        ret "0"
    end
    if terms.Len() == 1:
        ret terms.get(0)
    end
    ret "calc(" + _len_join(terms) + ")"
end

func _len_src(l: Len): str:
    names := ["pct", "em", "rem", "vw", "vh", "vmin", "vmax", "fr", "px"]
    calls := ["Pct", "Em", "Rem", "Vw", "Vh", "Vmin", "Vmax", "Fr", "Px"]
    vals := [l.pct, l.em, l.rem, l.vw, l.vh, l.vmin, l.vmax, l.fr, l.px]
    mut n := 0
    mut last := 0
    repeat 9 in i:
        if vals[i] != 0.0:
            n++
            last = i
        end
    end
    if n == 0:
        ret "style.Len {}"
    end
    if n == 1:
        ret "style." + calls[last] + "(" + _src_f(vals[last]) + ")"
    end
    mut t := "style.Len {"
    mut first := true
    repeat 9 in i:
        if vals[i] != 0.0:
            t += (first ? " " : ", ") + names[i] + " = " + _src_f(vals[i])
            first = false
        end
    end
    ret t + " }"
end

func _color_src1(c: color.Color): str:
    if c.current:
        ret "style.CurrentColor()"
    end
    ret "style.ColorOf(" + _src_f(c.r) + ", " + _src_f(c.g) + ", " + _src_f(c.b) + ", " + _src_f(c.a) + ")"
end

func _color_src(c: color.Color): str:
    if color.HasDark(c):
        ret "style.LightDark(" + _color_src1(color.Light(c)) + ", " + _color_src1(color.Dark(c)) + ")"
    end
    ret _color_src1(c)
end

func _const_name(en: str): str:
    ret str.Replace(str.Upper(en), " ", "_")
end

func _ease_text(e: Easing): str:
    switch e.kind:
        EASE_LINEAR: ret "linear" end
        EASE_EASE: ret "ease" end
        EASE_IN: ret "ease in" end
        EASE_OUT: ret "ease out" end
        EASE_IN_OUT: ret "ease in out" end
        EASE_CUBIC: ret "ease(" + _fmt(e.x1) + ", " + _fmt(e.y1) + ", " + _fmt(e.x2) + ", " + _fmt(e.y2) + ")" end
        EASE_STEPS: ret "steps(" + str.FromInt(e.steps as i64) + ")" end
        EASE_SPRING: ret "spring(" + _fmt(e.stiffness) + ", " + _fmt(e.damping) + ")" end
    end
    ret "ease"
end

func _paint_text(p: Paint): str:
    if p.kind == PAINT_IMAGE:
        ret "image(" + _src_str(p.path) + ")"
    end
    if p.kind == PAINT_COLOR:
        ret _color_text(p.color)
    end
    mut t := p.kind == PAINT_LINEAR ? "linear(" : (p.kind == PAINT_RADIAL ? "radial(" : "conic(")
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    if p.kind == PAINT_LINEAR:
        parts.push(p.side != 0 ? _kw_en(p.side) : _fmt(p.angle))
    end
    if p.kind == PAINT_RADIAL and p.circle:
        parts.push("circle")
    end
    if p.kind == PAINT_CONIC and p.angle != 0.0:
        parts.push(_fmt(p.angle))
    end
    if p.has_at:
        parts.push("[" + _len_text(p.at_x) + ", " + _len_text(p.at_y) + "]")
    end
    each s in p.stops:
        parts.push(s.has_at ? _color_text(s.color) + " " + _len_text(s.at) : _color_text(s.color))
    end
    t += str.Join(parts, ", ")
    ret t + ")"
end

func _track_side_text(word: int, l: Len): str:
    ret word != 0 ? _kw_en(word) : _len_text(l)
end

func _track_text(tr: Track): str:
    switch tr.kind:
        TRACK_MINMAX: ret "minmax(" + _track_side_text(tr.word, tr.len) + ", " + _track_side_text(tr.max_word, tr.max) + ")" end
        TRACK_FIT: ret "fit(" + _len_text(tr.len) + ")" end
    end
    ret _track_side_text(tr.word, tr.len)
end

func _item_text(it: Item, px: bool): str:
    switch it.kind:
        ITEM_LEN:
            t := _len_text(it.len)
            if px and _len_terms(it.len, false).Len() == 1 and it.len.px != 0.0:
                ret t + "px"
            end
            ret t
        end
        ITEM_NUM: ret _fmt(it.num) end
        ITEM_INT: ret str.FromInt(it.num as i64) end
        ITEM_BOOL: ret it.num != 0.0 ? "true" : "false" end
        ITEM_TIME: ret _fmt(it.num) + "ms" end
        ITEM_ANGLE: ret _fmt(it.num) + "deg" end
        ITEM_COLOR: ret _color_text(it.color) end
        ITEM_WORD: ret _kw_en(it.word) end
        ITEM_STR: ret _src_str(it.text) end
        ITEM_PAINT: ret _paint_text(it.paint) end
        ITEM_EASE: ret _ease_text(it.ease) end
        ITEM_TRACK: ret _track_text(it.track) end
        ITEM_PROP: ret _prop_info(it.word).name end
    end
    ret ""
end

func _group_end(v: Value, g: int): int:
    if g + 1 < v.starts.Len():
        ret v.starts.get(g + 1)
    end
    ret v.items.Len()
end

func _items_text(v: Value, from: int, upto: int, px: bool): str:
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    mut i := from
    until i < upto:
        it := v.items.get(i)
        if it.kind == ITEM_TRACK and it.track.kind == TRACK_REPEAT:
            mut inner := Vector {} as Vector<str>
            inner.push(it.track.word != 0 ? _kw_en(it.track.word) : str.FromInt(it.track.count as i64))
            repeat it.track.span in k:
                inner.push(_item_text(_it(v, i + 1 + k), px))
            end
            parts.push("repeat(" + str.Join(inner, ", ") + ")")
            inner.free()
            i += 1 + it.track.span
            continue
        end
        parts.push(_item_text(it, px))
        i++
    end
    ret str.Join(parts, ", ")
end

func _zero_len(it: Item): bool:
    ret _len_terms(it.len, false).Len() == 0
end

func _short_text(kind: int, v: Value, g: int): str:
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    a := _it(v, g)
    switch kind:
        KIND_BORDER:
            st := _it(v, g + 1).word
            if not (st == KW_NONE and _zero_len(a)):
                parts.push(_len_text(a.len))
            end
            if st != KW_SOLID:
                parts.push(_kw_en(st))
            end
            c := _it(v, g + 2).color
            if not c.current or color.HasDark(c):
                parts.push(_color_text(c))
            end
            break
        end
        KIND_SHADOW, KIND_TEXT_SHADOW:
            text := kind == KIND_TEXT_SHADOW
            nlen := text ? 3 : 4
            mut keep := 2
            repeat nlen - 2 in k:
                if not _zero_len(_it(v, g + 2 + k)):
                    keep = 3 + k
                end
            end
            repeat keep in k:
                parts.push(_len_text(_it(v, g + k).len))
            end
            c := _it(v, g + nlen).color
            if not c.current or color.HasDark(c):
                parts.push(_color_text(c))
            end
            if not text and _it(v, g + 5).num != 0.0:
                parts.push("inset")
            end
            break
        end
        KIND_TRANSITION:
            parts.push(_fmt(a.num) + "ms")
            e := _it(v, g + 1).ease
            d := _it(v, g + 2).num
            if e.kind != EASE_EASE:
                parts.push(_ease_text(e))
            end
            if d != 0.0:
                parts.push(_fmt(d) + "ms")
            end
        end
    end
    ret str.Join(parts, ", ")
end

func _paint_src(p: Paint): str:
    if p.kind == PAINT_IMAGE:
        ret "style.Image(" + _src_str(p.path) + ")"
    end
    kinds := ["", "PAINT_COLOR", "PAINT_LINEAR", "PAINT_RADIAL", "PAINT_CONIC", "PAINT_IMAGE"]
    mut t := "style.Gradient(style." + kinds[p.kind] + ", " + _src_f(p.angle) + ", " + (p.side != 0 ? "style.KW_" + _const_name(_kw_en(p.side)) : "0") + ", " + (p.circle ? "true" : "false") + ", " + _len_src(p.at_x) + ", " + _len_src(p.at_y) + ", " + (p.has_at ? "true" : "false") + ")"
    each s in p.stops:
        t += ".AddStop(" + _color_src(s.color) + ", " + _len_src(s.at) + ", " + (s.has_at ? "true" : "false") + ")"
    end
    ret t
end

func _item_src(it: Item): str:
    switch it.kind:
        ITEM_LEN: ret "style.OfLen(" + _len_src(it.len) + ")" end
        ITEM_NUM: ret "style.OfNum(" + _src_f(it.num) + ")" end
        ITEM_INT: ret "style.OfInt(" + str.FromInt(it.num as i64) + ")" end
        ITEM_BOOL: ret "style.OfBool(" + (it.num != 0.0 ? "true" : "false") + ")" end
        ITEM_TIME: ret "style.OfTime(" + _src_f(it.num) + ")" end
        ITEM_ANGLE: ret "style.OfAngle(" + _src_f(it.num) + ")" end
        ITEM_COLOR: ret "style.OfColor(" + _color_src(it.color) + ")" end
        ITEM_WORD: ret "style.OfWord(style.KW_" + _const_name(_kw_en(it.word)) + ")" end
        ITEM_STR: ret "style.OfStr(" + _src_str(it.text) + ")" end
        ITEM_PAINT: ret "style.OfPaint(" + _paint_src(it.paint) + ")" end
        ITEM_PROP: ret "style.OfProp(style.P_" + _const_name(_prop_info(it.word).name) + ")" end
        ITEM_EASE:
            e := it.ease
            ret "style.OfEase(style.Easing { kind = " + str.FromInt(e.kind as i64) + ", x1 = " + _src_f(e.x1) + ", y1 = " + _src_f(e.y1) + ", x2 = " + _src_f(e.x2) + ", y2 = " + _src_f(e.y2) + ", steps = " + str.FromInt(e.steps as i64) + ", stiffness = " + _src_f(e.stiffness) + ", damping = " + _src_f(e.damping) + " })"
        end
        ITEM_TRACK:
            tr := it.track
            ret "style.OfTrack(style.Track { kind = " + str.FromInt(tr.kind as i64) + ", word = " + str.FromInt(tr.word as i64) + ", len = " + _len_src(tr.len) + ", max_word = " + str.FromInt(tr.max_word as i64) + ", max = " + _len_src(tr.max) + ", count = " + str.FromInt(tr.count as i64) + ", span = " + str.FromInt(tr.span as i64) + " })"
        end
    end
    ret "style.Item {}"
end

@en "Px"
@fa "پیکسل"
pub func Px(n: f64): Len:
    ret Len { px = n }
end

@en "Pct"
@fa "درصد"
pub func Pct(n: f64): Len:
    ret Len { pct = n }
end

@en "Em"
@fa "ام"
pub func Em(n: f64): Len:
    ret Len { em = n }
end

@en "Rem"
@fa "رم"
pub func Rem(n: f64): Len:
    ret Len { rem = n }
end

@en "Vw"
@fa "عرض دید"
pub func Vw(n: f64): Len:
    ret Len { vw = n }
end

@en "Vh"
@fa "ارتفاع دید"
pub func Vh(n: f64): Len:
    ret Len { vh = n }
end

@en "Vmin"
@fa "کمینه دید"
pub func Vmin(n: f64): Len:
    ret Len { vmin = n }
end

@en "Vmax"
@fa "بیشینه دید"
pub func Vmax(n: f64): Len:
    ret Len { vmax = n }
end

@en "Fr"
@fa "سهم"
pub func Fr(n: f64): Len:
    ret Len { fr = n }
end

@en "ColorOf"
@fa "رنگ از"
pub func ColorOf(r: f64, g: f64, b: f64, a: f64): color.Color:
    ret color.Color { r = r, g = g, b = b, a = a }
end

@en "CurrentColor"
@fa "رنگ جاری"
pub func CurrentColor(): color.Color:
    ret color.Color { current = true }
end

@en "LightDark"
@fa "روشن تیره"
pub func LightDark(light: color.Color, dark: color.Color): color.Color:
    ret color.LightDark(light, dark)
end

@en "Gradient"
@fa "گرادیان"
pub func Gradient(kind: int, angle: f64, side: int, circle: bool, at_x: Len, at_y: Len, has_at: bool): Paint:
    ret Paint { kind = kind, angle = angle, side = side, circle = circle, at_x = at_x, at_y = at_y, has_at = has_at }
end

@en "Image"
@fa "تصویر"
pub func Image(path: str): Paint:
    ret Paint { kind = PAINT_IMAGE, path = path }
end

@en "OfLen"
@fa "از طول"
pub func OfLen(l: Len): Item:
    ret Item { kind = ITEM_LEN, len = l }
end

@en "OfNum"
@fa "از عدد"
pub func OfNum(n: f64): Item:
    ret Item { kind = ITEM_NUM, num = n }
end

@en "OfInt"
@fa "از صحیح"
pub func OfInt(n: int): Item:
    ret Item { kind = ITEM_INT, num = n as f64 }
end

@en "OfBool"
@fa "از منطقی"
pub func OfBool(b: bool): Item:
    ret Item { kind = ITEM_BOOL, num = b ? 1.0 : 0.0 }
end

@en "OfTime"
@fa "از زمان"
pub func OfTime(ms: f64): Item:
    ret Item { kind = ITEM_TIME, num = ms }
end

@en "OfAngle"
@fa "از زاویه"
pub func OfAngle(deg: f64): Item:
    ret Item { kind = ITEM_ANGLE, num = deg }
end

@en "OfColor"
@fa "از رنگ"
pub func OfColor(c: color.Color): Item:
    ret Item { kind = ITEM_COLOR, color = c }
end

@en "OfWord"
@fa "از واژه"
pub func OfWord(kw: int): Item:
    ret Item { kind = ITEM_WORD, word = kw }
end

@en "OfStr"
@fa "از رشته"
pub func OfStr(s: str): Item:
    ret Item { kind = ITEM_STR, text = s }
end

@en "OfPaint"
@fa "از رنگ‌آمیزی"
pub func OfPaint(p: Paint): Item:
    ret Item { kind = ITEM_PAINT, paint = p }
end

@en "OfEase"
@fa "از نرمش"
pub func OfEase(e: Easing): Item:
    ret Item { kind = ITEM_EASE, ease = e }
end

@en "OfTrack"
@fa "از شیار"
pub func OfTrack(t: Track): Item:
    ret Item { kind = ITEM_TRACK, track = t }
end

@en "OfProp"
@fa "از ویژگی"
pub func OfProp(prop: int): Item:
    ret Item { kind = ITEM_PROP, word = prop }
end

@en "One"
@fa "یک"
pub func One(it: Item): Value:
    mut v := Value {}
    v.starts.push(0)
    v.items.push(it)
    ret v
end

@en "Format"
@fa "قالب"
pub func Format(prop: int, v: Value): str:
    if prop < 0 or prop >= PROP_COUNT or v.items.Len() == 0:
        ret ""
    end
    groups := v.starts.Len()
    kind := _prop_info(prop).kind
    px := (_prop_info(prop).items & (1 << ITEM_NUM)) != 0
    short := (kind == KIND_BORDER or kind == KIND_SHADOW or kind == KIND_TEXT_SHADOW or kind == KIND_TRANSITION) and v.items.get(0).kind != ITEM_WORD
    if groups <= 1:
        if short:
            ret _short_text(kind, v, 0)
        end
        ret _items_text(v, 0, v.items.Len(), px)
    end
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    repeat groups in g:
        if short:
            parts.push("[" + _short_text(kind, v, v.starts.get(g)) + "]")
        else:
            parts.push("[" + _items_text(v, v.starts.get(g), _group_end(v, g), px) + "]")
        end
    end
    ret str.Join(parts, ", ")
end

@en "Source"
@fa "منبع"
pub func Source(prop: int, v: Value): str:
    if prop < 0 or prop >= PROP_COUNT or v.items.Len() == 0:
        ret "style.Value {}"
    end
    mut t := "style.One(" + _item_src(v.items.get(0)) + ")"
    mut g := 1
    repeat v.items.Len() - 1 in k:
        i := k + 1
        if g < v.starts.Len() and v.starts.get(g) == i:
            t += ".Then(" + _item_src(v.items.get(i)) + ")"
            g++
        else:
            t += ".And(" + _item_src(v.items.get(i)) + ")"
        end
    end
    ret t
end
