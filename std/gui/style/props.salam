package style

import str

func _ascii_lower(s: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    n := s.Len()
    mut space := false
    mut started := false
    repeat n in i:
        c := s[i] as int
        if c == 32 or c == 9 or c == 10 or c == 13:
            space = started
            continue
        end
        if space:
            str.BufAppendChar(b, 32)
            space = false
        end
        started = true
        if c >= 65 and c <= 90:
            str.BufAppendChar(b, c + 32)
        else:
            str.BufAppendChar(b, c)
        end
    end
    ret str.BufStr(b)
end

func _zwnj_to_space(s: str): str:
    ret str.Replace(s, "‌", " ")
end

func _name_key(s: str): str:
    ret _ascii_lower(_zwnj_to_space(s))
end

func _word_in(words: str, en: str): bool:
    if words == "":
        ret false
    end
    mut at := 0
    n := words.Len()
    until at <= n:
        mut e := str.IndexFrom(words, "|", at)
        if e < 0:
            e = n
        end
        if words.substr(at, e - at) == en:
            ret true
        end
        at = e + 1
    end
    ret false
end

func _kw_lookup(name: str): int:
    k := _name_key(name)
    repeat KEYWORD_COUNT - 1 in i:
        if _kw_en(i + 1) == k or _name_key(_kw_fa(i + 1)) == k:
            ret i + 1
        end
    end
    ret 0
end

@en "Info"
@fa "اطلاعات"
pub func Info(id: int): PropInfo:
    ret _prop_info(id)
end

@en "PropByName"
@fa "ویژگی با نام"
pub func PropByName(name: str): int:
    k := _name_key(name)
    repeat PROP_COUNT in i:
        p := _prop_info(i)
        if p.name == k or _name_key(p.fa) == k:
            ret i
        end
    end
    ret -1
end

@en "PropName"
@fa "نام ویژگی"
pub func PropName(id: int): str:
    ret _prop_info(id).name
end

@en "PropFaName"
@fa "نام فارسی ویژگی"
pub func PropFaName(id: int): str:
    ret _prop_info(id).fa
end

@en "Inherited"
@fa "ارثی است"
pub func Inherited(id: int): bool:
    ret _prop_info(id).inherited
end

@en "Animatable"
@fa "پویانما است"
pub func Animatable(id: int): bool:
    ret _prop_info(id).animatable
end

@en "KeywordName"
@fa "نام واژه"
pub func KeywordName(id: int): str:
    ret _kw_en(id)
end

@en "KeywordFaName"
@fa "نام فارسی واژه"
pub func KeywordFaName(id: int): str:
    ret _kw_fa(id)
end

@en "KeywordByName"
@fa "واژه با نام"
pub func KeywordByName(name: str): int:
    ret _kw_lookup(name)
end

@en "PropKeywords"
@fa "واژه‌های ویژگی"
pub func PropKeywords(id: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    words := _prop_info(id).words
    if words == "":
        ret out
    end
    parts := str.Split(words, "|")
    defer parts.free()
    each w in parts:
        out.push(_kw_lookup(w))
    end
    ret out
end
