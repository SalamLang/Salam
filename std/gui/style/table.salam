func _prop_info(id: int): PropInfo:
    switch id:
        P_LAYOUT: ret PropInfo { id = 0, name = "layout", fa = "چیدمان", kind = KIND_WORD, items = 256, min = 1, max = 1, low = 0.0, high = 0.0, words = "column|row|grid|stack|flow", initial = "column", inherited = false, animatable = false, negative = false, percent = false, example = "row" } end
        P_GAP: ret PropInfo { id = 1, name = "gap", fa = "شکاف", kind = KIND_LENGTH, items = 2, min = 1, max = 2, low = 0.0, high = 0.0, words = "", initial = "0", inherited = false, animatable = true, negative = false, percent = true, example = "8, 16" } end
        P_ALIGN: ret PropInfo { id = 2, name = "align", fa = "تراز", kind = KIND_WORD, items = 256, min = 1, max = 1, low = 0.0, high = 0.0, words = "start|center|end|stretch|baseline", initial = "stretch", inherited = false, animatable = false, negative = false, percent = false, example = "center" } end
        P_JUSTIFY: ret PropInfo { id = 3, name = "justify", fa = "چینش", kind = KIND_WORD, items = 256, min = 1, max = 1, low = 0.0, high = 0.0, words = "start|center|end|between|around|evenly", initial = "start", inherited = false, animatable = false, negative = false, percent = false, example = "between" } end
        P_ALIGN_CONTENT: ret PropInfo { id = 4, name = "align content", fa = "محتوا تراز", kind = KIND_WORD, items = 256, min = 1, max = 1, low = 0.0, high = 0.0, words = "start|center|end|stretch|between|around|evenly", initial = "start", inherited = false, animatable = false, negative = false, percent = false, example = "center" } end
        P_WRAP: ret PropInfo { id = 5, name = "wrap", fa = "پیچش", kind = KIND_BOOL, items = 16, min = 1, max = 1, low = 0.0, high = 0.0, words = "", initial = "false", inherited = false, animatable = false, negative = false, percent = false, example = "true" } end
        P_REVERSE: ret PropInfo { id = 6, name = "reverse", fa = "معکوس", kind = KIND_BOOL, items = 16, min = 1, max = 1, low = 0.0, high = 0.0, words = "", initial = "false", inherited = false, animatable = false, negative = false, percent = false, example = "true" } end
        P_COLUMNS: ret PropInfo { id = 7, name = "columns", fa = "ستون‌ها", kind = KIND_TRACKS, items = 4354, min = 1, max = 64, low = 0.0, high = 0.0, words = "none|auto|min content|max content", initial = "none", inherited = false, animatable = false, negative = false, percent = true, example = "200, 1fr" } end
        P_ROWS: ret PropInfo { id = 8, name = "rows", fa = "ردیف‌ها", kind = KIND_TRACKS, items = 4354, min = 1, max = 64, low = 0.0, high = 0.0, words = "none|auto|min content|max content", initial = "none", inherited = false, animatable = false, negative = false, percent = true, example = "auto, 1fr" } end
        P_AUTO_COLUMNS: ret PropInfo { id = 9, name = "auto columns", fa = "ستون‌های خودکار", kind = KIND_TRACKS, items = 4354, min = 1, max = 64, low = 0.0, high = 0.0, words = "auto|min content|max content", initial = "auto", inherited = false, animatable = false, negative = false, percent = true, example = "1fr" } end
        P_AUTO_ROWS: ret PropInfo { id = 10, name = "auto rows", fa = "ردیف‌های خودکار", kind = KIND_TRACKS, items = 4354, min = 1, max = 64, low = 0.0, high = 0.0, words = "auto|min content|max content", initial = "auto", inherited = false, animatable = false, negative = false, percent = true, example = "100" } end
        P_AUTO_FLOW: ret PropInfo { id = 11, name = "auto flow", fa = "جریان خودکار", kind = KIND_WORD, items = 256, min = 1, max = 1, low = 0.0, high = 0.0, words = "row|column|dense|row dense|column dense", initial = "row", inherited = false, animatable = false, negative = false, percent = false, example = "column" } end
        P_GROW: ret PropInfo { id = 12, name = "grow", fa = "رشد", kind = KIND_NUMBER, items = 4, min = 1, max = 1, low = 0.0, high = 1000000000.0, words = "", initial = "0", inherited = false, animatable = true, negative = false, percent = false, example = "1" } end
        P_SHRINK: ret PropInfo { id = 13, name = "shrink", fa = "جمع‌شدن", kind = KIND_NUMBER, items = 4, min = 1, max = 1, low = 0.0, high = 1000000000.0, words = "", initial = "1", inherited = false, animatable = true, negative = false, percent = false, example = "0" } end
        P_BASIS: ret PropInfo { id = 14, name = "basis", fa = "پایه", kind = KIND_LENGTH, items = 258, min = 1, max = 1, low = 0.0, high = 0.0, words = "auto", initial = "auto", inherited = false, animatable = true, negative = false, percent = true, example = "200" } end
        P_ALIGN_SELF: ret PropInfo { id = 15, name = "align self", fa = "خود تراز", kind = KIND_WORD, items = 256, min = 1, max = 1, low = 0.0, high = 0.0, words = "auto|start|center|end|stretch|baseline", initial = "auto", inherited = false, animatable = false, negative = false, percent = false, example = "end" } end
        P_JUSTIFY_SELF: ret PropInfo { id = 16, name = "justify self", fa = "خود چینش", kind = KIND_WORD, items = 256, min = 1, max = 1, low = 0.0, high = 0.0, words = "auto|start|center|end|stretch", initial = "auto", inherited = false, animatable = false, negative = false, percent = false, example = "center" } end
        P_COLUMN: ret PropInfo { id = 17, name = "column", fa = "ستون", kind = KIND_INT, items = 264, min = 1, max = 1, low = -1000.0, high = 1000.0, words = "auto", initial = "auto", inherited = false, animatable = false, negative = true, percent = false, example = "2" } end
        P_ROW: ret PropInfo { id = 18, name = "row", fa = "ردیف", kind = KIND_INT, items = 264, min = 1, max = 1, low = -1000.0, high = 1000.0, words = "auto", initial = "auto", inherited = false, animatable = false, negative = true, percent = false, example = "1" } end
        P_COLUMN_SPAN: ret PropInfo { id = 19, name = "column span", fa = "گستره ستون", kind = KIND_INT, items = 8, min = 1, max = 1, low = 1.0, high = 1000.0, words = "", initial = "1", inherited = false, animatable = false, negative = false, percent = false, example = "2" } end
        P_ROW_SPAN: ret PropInfo { id = 20, name = "row span", fa = "گستره ردیف", kind = KIND_INT, items = 8, min = 1, max = 1, low = 1.0, high = 1000.0, words = "", initial = "1", inherited = false, animatable = false, negative = false, percent = false, example = "3" } end
        P_ORDER: ret PropInfo { id = 21, name = "order", fa = "ترتیب نمایش", kind = KIND_INT, items = 8, min = 1, max = 1, low = -1000000.0, high = 1000000.0, words = "", initial = "0", inherited = false, animatable = false, negative = true, percent = false, example = "-1" } end
        P_POSITION: ret PropInfo { id = 22, name = "position", fa = "موقعیت", kind = KIND_WORD, items = 256, min = 1, max = 1, low = 0.0, high = 0.0, words = "normal|absolute|fixed|sticky", initial = "normal", inherited = false, animatable = false, negative = false, percent = false, example = "absolute" } end
        P_TOP: ret PropInfo { id = 23, name = "top", fa = "بالا", kind = KIND_LENGTH, items = 258, min = 1, max = 1, low = 0.0, high = 0.0, words = "auto", initial = "auto", inherited = false, animatable = true, negative = true, percent = true, example = "10" } end
