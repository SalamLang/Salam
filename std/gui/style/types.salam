package style

import gui.color

@en "Len"
@fa "طول"
pub struct Len:
    @en "px"
    @fa "پیکسل"
    pub px: f64 = 0.0
    @en "pct"
    @fa "درصد"
    pub pct: f64 = 0.0
    @en "em"
    @fa "ام"
    pub em: f64 = 0.0
    @en "rem"
    @fa "رم"
    pub rem: f64 = 0.0
    @en "vw"
    @fa "عرض دید"
    pub vw: f64 = 0.0
    @en "vh"
    @fa "ارتفاع دید"
    pub vh: f64 = 0.0
    @en "vmin"
    @fa "کمینه دید"
    pub vmin: f64 = 0.0
    @en "vmax"
    @fa "بیشینه دید"
    pub vmax: f64 = 0.0
    @en "fr"
    @fa "سهم"
    pub fr: f64 = 0.0
end

@en "Dim"
@fa "بعد"
pub struct Dim:
    @en "word"
    @fa "واژه"
    pub word: int = 0
    @en "len"
    @fa "طول"
    pub len: Len = Len {}
end

@en "Stop"
@fa "ایستگاه‌رنگ"
pub struct Stop:
    @en "color"
    @fa "رنگ"
    pub color: color.Color = color.Color {}
    @en "at"
    @fa "جا"
    pub at: Len = Len {}
    @en "has_at"
    @fa "جا دارد"
    pub has_at: bool = false
end

@en "Paint"
@fa "رنگ‌آمیزی"
pub struct Paint:
    @en "kind"
    @fa "گونه"
    pub kind: int = 1
    @en "color"
    @fa "رنگ"
    pub color: color.Color = color.Color {}
    @en "angle"
    @fa "زاویه"
    pub angle: f64 = 180.0
    @en "side"
    @fa "سمت"
    pub side: int = 0
    @en "circle"
    @fa "دایره‌ای"
    pub circle: bool = false
    @en "at_x"
    @fa "جای افقی"
    pub at_x: Len = Len { pct = 50.0 }
    @en "at_y"
    @fa "جای عمودی"
    pub at_y: Len = Len { pct = 50.0 }
    @en "has_at"
    @fa "جا دارد"
    pub has_at: bool = false
    @en "stops"
    @fa "ایستگاه‌ها"
    pub stops: Vector<Stop> = Vector {} as Vector<Stop>
    @en "path"
    @fa "مسیر"
    pub path: str = ""

    @en "AddStop"
    @fa "افزودن ایستگاه"
    pub func AddStop(c: color.Color, at: Len, has_at: bool): Paint:
        mut r := Paint { kind = this.kind, color = this.color, angle = this.angle, side = this.side, circle = this.circle, at_x = this.at_x, at_y = this.at_y, has_at = this.has_at, path = this.path }
        each s in this.stops:
            r.stops.push(s)
        end
        r.stops.push(Stop { color = c, at = at, has_at = has_at })
        ret r
    end
end

@en "Easing"
@fa "نرمش"
pub struct Easing:
    @en "kind"
    @fa "گونه"
    pub kind: int = 2
    @en "x1"
    @fa "ایکس اول"
    pub x1: f64 = 0.0
    @en "y1"
    @fa "ایگرگ اول"
    pub y1: f64 = 0.0
    @en "x2"
    @fa "ایکس دوم"
    pub x2: f64 = 0.0
    @en "y2"
    @fa "ایگرگ دوم"
    pub y2: f64 = 0.0
    @en "steps"
    @fa "گام‌ها"
    pub steps: int = 1
    @en "stiffness"
    @fa "سختی"
    pub stiffness: f64 = 0.0
    @en "damping"
    @fa "میرایی"
    pub damping: f64 = 0.0
end

@en "Track"
@fa "شیار"
pub struct Track:
    @en "kind"
    @fa "گونه"
    pub kind: int = 1
    @en "word"
    @fa "واژه"
    pub word: int = 0
    @en "len"
    @fa "طول"
    pub len: Len = Len {}
    @en "max_word"
    @fa "واژه بیشینه"
    pub max_word: int = 0
    @en "max"
    @fa "بیشینه"
    pub max: Len = Len {}
    @en "count"
    @fa "شمار"
    pub count: int = 0
    @en "span"
    @fa "گستره"
    pub span: int = 0
end

@en "Item"
@fa "جزء"
pub struct Item:
    @en "kind"
    @fa "گونه"
    pub kind: int = 0
    @en "len"
    @fa "طول"
    pub len: Len = Len {}
    @en "num"
    @fa "عدد"
    pub num: f64 = 0.0
    @en "color"
    @fa "رنگ"
    pub color: color.Color = color.Color {}
    @en "word"
    @fa "واژه"
    pub word: int = 0
    @en "text"
    @fa "متن"
    pub text: str = ""
    @en "paint"
    @fa "رنگ‌آمیزی"
    pub paint: Paint = Paint {}
    @en "ease"
    @fa "نرمش"
    pub ease: Easing = Easing {}
    @en "track"
    @fa "شیار"
    pub track: Track = Track {}
end

@en "Value"
@fa "مقدار"
pub struct Value:
    @en "items"
    @fa "اجزا"
    pub items: Vector<Item> = Vector {} as Vector<Item>
    @en "starts"
    @fa "آغازها"
    pub starts: Vector<int> = Vector {} as Vector<int>

    @en "And"
    @fa "با"
    pub func And(it: Item): Value:
        mut r := Value {}
        each x in this.items:
            r.items.push(x)
        end
        each s in this.starts:
            r.starts.push(s)
        end
        if r.starts.len() == 0:
            r.starts.push(0)
        end
        r.items.push(it)
        ret r
    end

    @en "Then"
    @fa "سپس"
    pub func Then(it: Item): Value:
        mut r := Value {}
        each x in this.items:
            r.items.push(x)
        end
        each s in this.starts:
            r.starts.push(s)
        end
        r.starts.push(r.items.len())
        r.items.push(it)
        ret r
    end
end

