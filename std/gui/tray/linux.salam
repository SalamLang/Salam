package tray

import os
import filepath
import thread

if SALAM_OS_LINUX and not SALAM_OS_ANDROID:
    link dynamic "gio-2.0"
    link dynamic "gobject-2.0"
    link dynamic "glib-2.0"

    extern:
        func g_bus_get_sync(kind: int, cancellable: void*, error: void*): void*
        func g_dbus_connection_call_sync(
            connection: void*,
            destination: str,
            path: str,
            iface: str,
            method: str,
            params: void*,
            reply: void*,
            flags: int,
            timeout: int,
            cancellable: void*,
            error: void*
        ): void*
        func g_dbus_connection_call(
            connection: void*,
            destination: str,
            path: str,
            iface: str,
            method: str,
            params: void*,
            reply: void*,
            flags: int,
            timeout: int,
            cancellable: void*,
            callback: void*,
            data: void*
        )
        func g_dbus_node_info_new_for_xml(xml: str, error: void*): void*
        func g_dbus_node_info_lookup_interface(info: void*, name: str): void*
        func g_dbus_connection_register_object(
            connection: void*,
            path: str,
            iface: void*,
            vtable: void*,
            data: void*,
            free_data: void*,
            error: void*
        ): u32
        func g_dbus_connection_unregister_object(connection: void*, id: u32): int
        func g_dbus_connection_emit_signal(
            connection: void*,
            destination: void*,
            path: str,
            iface: str,
            name: str,
            params: void*,
            error: void*
        ): int
        func g_dbus_connection_flush_sync(connection: void*, cancellable: void*, error: void*): int
        func g_dbus_method_invocation_return_value(invocation: void*, value: void*)
        func g_dbus_method_invocation_return_dbus_error(invocation: void*, name: str, message: str)
        func g_bus_watch_name_on_connection(
            connection: void*,
            name: str,
            flags: int,
            appeared: void*,
            vanished: void*,
            data: void*,
            free_data: void*
        ): u32
        func g_main_context_new(): void*
        func g_main_context_push_thread_default(context: void*)
        func g_main_context_invoke(context: void*, handler: void*, data: void*)
        func g_main_loop_new(context: void*, running: int): void*
        func g_main_loop_run(loop: void*)
        func g_variant_new(format: str, ...): void*
        func g_variant_new_string(text: str): void*
        func g_variant_new_boolean(value: int): void*
        func g_variant_new_int32(value: i32): void*
        func g_variant_new_uint32(value: u32): void*
        func g_variant_new_object_path(path: str): void*
        func g_variant_new_fixed_array(kind: void*, elements: void*, count: usize, size: usize): void*
        func g_variant_type_new(text: str): void*
        func g_variant_builder_new(kind: void*): void*
        func g_variant_builder_add(builder: void*, format: str, ...)
        func g_variant_builder_end(builder: void*): void*
        func g_variant_builder_unref(builder: void*)
        func g_variant_get(reply: void*, format: str, ...)
        func g_variant_get_child(value: void*, index: usize, format: str, ...)
        func g_variant_get_child_value(value: void*, index: usize): void*
        func g_variant_n_children(value: void*): usize
        func g_variant_lookup_value(dict: void*, key: str, kind: void*): void*
        func g_variant_ref_sink(value: void*): void*
        func g_variant_unref(value: void*)
    end

    const _LX_SNI := "org.kde.StatusNotifierItem"
    const _LX_MENU := "com.canonical.dbusmenu"
    const _LX_WATCHER := "org.kde.StatusNotifierWatcher"
    const _LX_ITEM_PATH := "/StatusNotifierItem"
    const _LX_MENU_PATH := "/MenuBar"
    const _LX_XML := "<node><interface name='org.kde.StatusNotifierItem'><property name='Category' type='s' access='read'/><property name='Id' type='s' access='read'/><property name='Title' type='s' access='read'/><property name='Status' type='s' access='read'/><property name='WindowId' type='i' access='read'/><property name='IconThemePath' type='s' access='read'/><property name='IconName' type='s' access='read'/><property name='IconPixmap' type='a(iiay)' access='read'/><property name='OverlayIconName' type='s' access='read'/><property name='OverlayIconPixmap' type='a(iiay)' access='read'/><property name='AttentionIconName' type='s' access='read'/><property name='AttentionIconPixmap' type='a(iiay)' access='read'/><property name='AttentionMovieName' type='s' access='read'/><property name='ToolTip' type='(sa(iiay)ss)' access='read'/><property name='ItemIsMenu' type='b' access='read'/><property name='Menu' type='o' access='read'/><method name='ContextMenu'><arg name='x' type='i' direction='in'/><arg name='y' type='i' direction='in'/></method><method name='Activate'><arg name='x' type='i' direction='in'/><arg name='y' type='i' direction='in'/></method><method name='SecondaryActivate'><arg name='x' type='i' direction='in'/><arg name='y' type='i' direction='in'/></method><method name='Scroll'><arg name='delta' type='i' direction='in'/><arg name='orientation' type='s' direction='in'/></method><signal name='NewTitle'/><signal name='NewIcon'/><signal name='NewAttentionIcon'/><signal name='NewOverlayIcon'/><signal name='NewToolTip'/><signal name='NewStatus'><arg name='status' type='s'/></signal></interface><interface name='com.canonical.dbusmenu'><property name='Version' type='u' access='read'/><property name='TextDirection' type='s' access='read'/><property name='Status' type='s' access='read'/><property name='IconThemePath' type='as' access='read'/><method name='GetLayout'><arg type='i' name='parentId' direction='in'/><arg type='i' name='recursionDepth' direction='in'/><arg type='as' name='propertyNames' direction='in'/><arg type='u' name='revision' direction='out'/><arg type='(ia{sv}av)' name='layout' direction='out'/></method><method name='GetGroupProperties'><arg type='ai' name='ids' direction='in'/><arg type='as' name='propertyNames' direction='in'/><arg type='a(ia{sv})' name='properties' direction='out'/></method><method name='GetProperty'><arg type='i' name='id' direction='in'/><arg type='s' name='name' direction='in'/><arg type='v' name='value' direction='out'/></method><method name='Event'><arg type='i' name='id' direction='in'/><arg type='s' name='eventId' direction='in'/><arg type='v' name='data' direction='in'/><arg type='u' name='timestamp' direction='in'/></method><method name='EventGroup'><arg type='a(isvu)' name='events' direction='in'/><arg type='ai' name='idErrors' direction='out'/></method><method name='AboutToShow'><arg type='i' name='id' direction='in'/><arg type='b' name='needUpdate' direction='out'/></method><method name='AboutToShowGroup'><arg type='ai' name='ids' direction='in'/><arg type='ai' name='updatesNeeded' direction='out'/><arg type='ai' name='idErrors' direction='out'/></method><signal name='ItemsPropertiesUpdated'><arg type='a(ia{sv})' name='updatedProps'/><arg type='a(ias)' name='removedProps'/></signal><signal name='LayoutUpdated'><arg type='u' name='revision'/><arg type='i' name='parent'/></signal><signal name='ItemActivationRequested'><arg type='i' name='id'/><arg type='u' name='timestamp'/></signal></interface></node>"

    mut _lx_bus := null as void*
    mut _lx_ctx := null as void*
    mut _lx_started := false
    mut _lx_registered := false
    mut _lx_watching := false
    mut _lx_node := null as void*
    mut _lx_vtable := null as void*
    mut _lx_item_reg := 0 as u32
    mut _lx_menu_reg := 0 as u32
    mut _lx_name := ""
    mut _lx_types := false
    mut _lx_t_asv := null as void*
    mut _lx_t_av := null as void*
    mut _lx_t_ai := null as void*
    mut _lx_t_as := null as void*
    mut _lx_t_pix := null as void*
    mut _lx_t_group := null as void*
    mut _lx_t_byte := null as void*

    struct _LxSlot:
        pub v: void* = null
    end

    export:
        func salam_tray_lx_method(
            _connection: void*,
            _sender: str,
            _path: str,
            iface: str,
            method: str,
            params: void*,
            invocation: void*,
            _data: void*
        ):
            if iface == _LX_SNI:
                if method == "Activate":
                    _push_kind(EventKind.Click)
                else method == "SecondaryActivate":
                    _push_kind(EventKind.DoubleClick)
                end
                g_dbus_method_invocation_return_value(invocation, null)
                ret
            end
            if iface == _LX_MENU:
                _lx_menu_call(method, params, invocation)
                ret
            end
            g_dbus_method_invocation_return_dbus_error(
                invocation, "org.freedesktop.DBus.Error.UnknownInterface", "unknown interface"
            )
        end

        func salam_tray_lx_property(
            _connection: void*,
            _sender: str,
            _path: str,
            iface: str,
            name: str,
            _error: void*,
            _data: void*
        ): void*:
            if iface == _LX_MENU:
                ret _lx_menu_property(name)
            end
            ret _lx_item_property(name)
        end

        func salam_tray_lx_apply(_data: void*): int:
            _lx_apply_now()
            ret 0
        end

        func salam_tray_lx_appeared(_connection: void*, _name: str, _owner: str, _data: void*):
            if _lx_registered:
                _lx_announce()
            end
        end
    end

    func _lx_get_bus(): void*:
        if _lx_bus == null:
            _lx_bus = g_bus_get_sync(2, null, null)
        end
        ret _lx_bus
    end

    func _lx_ensure_types():
        if _lx_types:
            ret
        end
        _lx_t_asv = g_variant_type_new("a{sv}")
        _lx_t_av = g_variant_type_new("av")
        _lx_t_ai = g_variant_type_new("ai")
        _lx_t_as = g_variant_type_new("as")
        _lx_t_pix = g_variant_type_new("a(iiay)")
        _lx_t_group = g_variant_type_new("a(ia{sv})")
        _lx_t_byte = g_variant_type_new("y")
        _lx_types = true
    end

    func _lx_empty(kind: void*): void*:
        b := g_variant_builder_new(kind)
        out := g_variant_builder_end(b)
        g_variant_builder_unref(b)
        ret out
    end

    func _lx_pixmap(): void*:
        b := g_variant_builder_new(_lx_t_pix)
        if _icon.pixels != null and _icon.width > 0 and _icon.height > 0:
            n := _icon.width * _icon.height
            buf := mem.Allocate((n * 4) as u64)
            src := _icon.pixels as u8*
            dst := buf as u8*
            repeat n in i:
                k := i * 4
                dst[k] = src[k + 3]
                dst[k + 1] = src[k]
                dst[k + 2] = src[k + 1]
                dst[k + 3] = src[k + 2]
            end
            bytes := g_variant_new_fixed_array(_lx_t_byte, buf, (n * 4) as usize, 1 as usize)
            mem.Free(buf)
            g_variant_builder_add(b, "(ii@ay)", _icon.width, _icon.height, bytes)
        end
        out := g_variant_builder_end(b)
        g_variant_builder_unref(b)
        ret out
    end

    func _lx_app_id(): str:
        args := os.Args()
        if args.Len() > 0:
            base := filepath.Base(args[0])
            if base.Len() > 0:
                ret base
            end
        end
        ret str.Clone("salam")
    end

    func _lx_item_property(name: str): void*:
        _lx_ensure_types()
        _lock()
        defer _unlock()
        has_pixels := _icon.pixels != null
        if name == "Category":
            ret g_variant_new_string("ApplicationStatus")
        end
        if name == "Id":
            id := _lx_app_id()
            v := g_variant_new_string(id)
            mem.Free(id as void*)
            ret v
        end
        if name == "Title":
            ret g_variant_new_string(_tooltip)
        end
        if name == "Status":
            ret g_variant_new_string("Active")
        end
        if name == "WindowId":
            ret g_variant_new_int32(0)
        end
        if name == "IconThemePath":
            if has_pixels or _icon_path.Len() == 0:
                ret g_variant_new_string("")
            end
            dir := filepath.Dir(_icon_path)
            v := g_variant_new_string(dir)
            mem.Free(dir as void*)
            ret v
        end
        if name == "IconName":
            if has_pixels or _icon_path.Len() == 0:
                ret g_variant_new_string("")
            end
            stem := filepath.Stem(_icon_path)
            v := g_variant_new_string(stem)
            mem.Free(stem as void*)
            ret v
        end
        if name == "IconPixmap":
            ret _lx_pixmap()
        end
        if name == "OverlayIconPixmap" or name == "AttentionIconPixmap":
            ret _lx_empty(_lx_t_pix)
        end
        if name == "OverlayIconName" or name == "AttentionIconName" or name == "AttentionMovieName":
            ret g_variant_new_string("")
        end
        if name == "ToolTip":
            ret g_variant_new("(s@a(iiay)ss)", "", _lx_empty(_lx_t_pix), _tooltip, "")
        end
        if name == "ItemIsMenu":
            ret g_variant_new_boolean(0)
        end
        if name == "Menu":
            ret g_variant_new_object_path(_LX_MENU_PATH)
        end
        ret null
    end

    func _lx_menu_property(name: str): void*:
        _lx_ensure_types()
        if name == "Version":
            ret g_variant_new_uint32(3 as u32)
        end
        if name == "TextDirection":
            ret g_variant_new_string("ltr")
        end
        if name == "Status":
            ret g_variant_new_string("normal")
        end
        if name == "IconThemePath":
            ret _lx_empty(_lx_t_as)
        end
        ret null
    end

    func _lx_props(index: int): void*:
        b := g_variant_builder_new(_lx_t_asv)
        if index < 0:
            g_variant_builder_add(b, "{sv}", "children-display", g_variant_new_string("submenu"))
        else index < _items.Len():
            it := _items[index]
            if it.separator:
                g_variant_builder_add(b, "{sv}", "type", g_variant_new_string("separator"))
            else:
                g_variant_builder_add(b, "{sv}", "label", g_variant_new_string(it.label))
                g_variant_builder_add(
                    b, "{sv}", "enabled", g_variant_new_boolean(it.enabled ? 1 : 0)
                )
                if it.checked:
                    g_variant_builder_add(
                        b, "{sv}", "toggle-type", g_variant_new_string("checkmark")
                    )
                    g_variant_builder_add(b, "{sv}", "toggle-state", g_variant_new_int32(1))
                end
            end
            g_variant_builder_add(b, "{sv}", "visible", g_variant_new_boolean(1))
        end
        out := g_variant_builder_end(b)
        g_variant_builder_unref(b)
        ret out
    end

    func _lx_layout_node(index: int): void*:
        kids := g_variant_builder_new(_lx_t_av)
        if index < 0:
            repeat _items.Len() in i:
                g_variant_builder_add(kids, "v", _lx_layout_node(i))
            end
        end
        children := g_variant_builder_end(kids)
        g_variant_builder_unref(kids)
        ret g_variant_new("(i@a{sv}@av)", index + 1, _lx_props(index), children)
    end

    func _lx_child_int(value: void*, index: int): int:
        cell := mem.AllocateZeroed(8 as u64)
        g_variant_get_child(value, index as usize, "i", cell)
        out := (cell as i32*)[0]
        mem.Free(cell)
        ret out
    end

    func _lx_child_str(value: void*, index: int): str:
        cell := mem.AllocateZeroed(8 as u64)
        g_variant_get_child(value, index as usize, "&s", cell)
        out := (cell as _LxSlot*)[0].v as str
        mem.Free(cell)
        ret out
    end

    func _lx_clicked(id: int, event: str):
        if event == "clicked" and id >= 1:
            _push_menu(id - 1)
        end
    end

    func _lx_menu_call(method: str, params: void*, invocation: void*):
        _lx_ensure_types()
        if method == "GetLayout":
            parent := _lx_child_int(params, 0)
            _lock()
            mut index := parent - 1
            if index >= _items.Len():
                index = -1
            end
            node := _lx_layout_node(index)
            rev := _menu_rev
            _unlock()
            g_dbus_method_invocation_return_value(
                invocation, g_variant_new("(u@(ia{sv}av))", rev as u32, node)
            )
            ret
        end
        if method == "GetGroupProperties":
            ids := g_variant_get_child_value(params, 0 as usize)
            n := g_variant_n_children(ids) as int
            b := g_variant_builder_new(_lx_t_group)
            _lock()
            if n == 0:
                repeat _items.Len() in i:
                    g_variant_builder_add(b, "(i@a{sv})", i + 1, _lx_props(i))
                end
            else:
                repeat n in i:
                    id := _lx_child_int(ids, i)
                    k := id - 1
                    if k >= -1 and k < _items.Len():
                        g_variant_builder_add(b, "(i@a{sv})", id, _lx_props(k))
                    end
                end
            end
            _unlock()
            g_variant_unref(ids)
            group := g_variant_builder_end(b)
            g_variant_builder_unref(b)
            g_dbus_method_invocation_return_value(invocation, g_variant_new("(@a(ia{sv}))", group))
            ret
        end
        if method == "GetProperty":
            id := _lx_child_int(params, 0)
            name := _lx_child_str(params, 1)
            _lock()
            props := g_variant_ref_sink(_lx_props(id - 1))
            _unlock()
            value := g_variant_lookup_value(props, name, null)
            g_variant_unref(props)
            if value == null:
                g_dbus_method_invocation_return_dbus_error(
                    invocation, "org.freedesktop.DBus.Error.InvalidArgs", "unknown property"
                )
                ret
            end
            g_dbus_method_invocation_return_value(invocation, g_variant_new("(v)", value))
            g_variant_unref(value)
            ret
        end
        if method == "Event":
            id := _lx_child_int(params, 0)
            event := _lx_child_str(params, 1)
            g_dbus_method_invocation_return_value(invocation, null)
            _lx_clicked(id, event)
            ret
        end
        if method == "EventGroup":
            events := g_variant_get_child_value(params, 0 as usize)
            n := g_variant_n_children(events) as int
            repeat n in i:
                entry := g_variant_get_child_value(events, i as usize)
                _lx_clicked(_lx_child_int(entry, 0), _lx_child_str(entry, 1))
                g_variant_unref(entry)
            end
            g_variant_unref(events)
            g_dbus_method_invocation_return_value(
                invocation, g_variant_new("(@ai)", _lx_empty(_lx_t_ai))
            )
            ret
        end
        if method == "AboutToShow":
            g_dbus_method_invocation_return_value(invocation, g_variant_new("(b)", 0))
            ret
        end
        if method == "AboutToShowGroup":
            g_dbus_method_invocation_return_value(
                invocation, g_variant_new("(@ai@ai)", _lx_empty(_lx_t_ai), _lx_empty(_lx_t_ai))
            )
            ret
        end
        g_dbus_method_invocation_return_dbus_error(
            invocation, "org.freedesktop.DBus.Error.UnknownMethod", "unknown method"
        )
    end

    func _lx_bus_call(method: str, params: void*): void*:
        ret g_dbus_connection_call_sync(
            _lx_bus,
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            method,
            params,
            null,
            0,
            3000,
            null,
            null
        )
    end

    func _lx_announce():
        g_dbus_connection_call(
            _lx_bus,
            _LX_WATCHER,
            "/StatusNotifierWatcher",
            _LX_WATCHER,
            "RegisterStatusNotifierItem",
            g_variant_new("(s)", _lx_name),
            null,
            0,
            -1,
            null,
            null,
            null
        )
    end

    func _lx_register(): bool:
        if _lx_get_bus() == null:
            _set_error("no D-Bus session bus")
            ret false
        end
        if _lx_node == null:
            _lx_node = g_dbus_node_info_new_for_xml(_LX_XML, null)
            _lx_vtable = mem.AllocateZeroed(96 as u64)
            slots := _lx_vtable as _LxSlot*
            slots[0].v = &salam_tray_lx_method
            slots[1].v = &salam_tray_lx_property
        end
        if _lx_node == null:
            _set_error("cannot parse the tray D-Bus interfaces")
            ret false
        end
        item_iface := g_dbus_node_info_lookup_interface(_lx_node, _LX_SNI)
        menu_iface := g_dbus_node_info_lookup_interface(_lx_node, _LX_MENU)
        _lx_item_reg = g_dbus_connection_register_object(
            _lx_bus, _LX_ITEM_PATH, item_iface, _lx_vtable, null, null, null
        )
        _lx_menu_reg = g_dbus_connection_register_object(
            _lx_bus, _LX_MENU_PATH, menu_iface, _lx_vtable, null, null, null
        )
        if _lx_item_reg == (0 as u32) or _lx_menu_reg == (0 as u32):
            _set_error("cannot export the tray item on D-Bus")
            ret false
        end
        if _lx_name.Len() == 0:
            _lx_name = "org.kde.StatusNotifierItem-" + str.FromInt(os.Pid() as i64) + "-1"
        end
        reply := _lx_bus_call("RequestName", g_variant_new("(su)", _lx_name, 4 as u32))
        if reply != null:
            g_variant_unref(reply)
        end
        if not _lx_watching:
            _lx_watching = true
            _w := g_bus_watch_name_on_connection(
                _lx_bus, _LX_WATCHER, 0, &salam_tray_lx_appeared, null, null, null
            )
        end
        _lx_registered = true
        _lx_announce()
        ret true
    end

    func _lx_unregister():
        if _lx_item_reg != (0 as u32):
            _a := g_dbus_connection_unregister_object(_lx_bus, _lx_item_reg)
            _lx_item_reg = 0 as u32
        end
        if _lx_menu_reg != (0 as u32):
            _b := g_dbus_connection_unregister_object(_lx_bus, _lx_menu_reg)
            _lx_menu_reg = 0 as u32
        end
        reply := _lx_bus_call("ReleaseName", g_variant_new("(s)", _lx_name))
        if reply != null:
            g_variant_unref(reply)
        end
        _lx_registered = false
    end

    func _lx_emit(path: str, iface: str, name: str, params: void*):
        _e := g_dbus_connection_emit_signal(_lx_bus, null, path, iface, name, params, null)
    end

    func _lx_apply_now():
        _lx_ensure_types()
        _lock()
        want := _want
        icon := _dirty_icon
        tip := _dirty_tip
        menu := _dirty_menu
        rev := _menu_rev
        _dirty_icon = false
        _dirty_tip = false
        _dirty_menu = false
        _unlock()
        if want and not _lx_registered:
            _r := _lx_register()
        else want:
            if icon:
                _lx_emit(_LX_ITEM_PATH, _LX_SNI, "NewIcon", null)
            end
            if tip:
                _lx_emit(_LX_ITEM_PATH, _LX_SNI, "NewToolTip", null)
                _lx_emit(_LX_ITEM_PATH, _LX_SNI, "NewTitle", null)
            end
            if menu:
                _lx_emit(
                    _LX_MENU_PATH, _LX_MENU, "LayoutUpdated", g_variant_new("(ui)", rev as u32, 0)
                )
            end
        else _lx_registered:
            _lx_unregister()
        end
        _f := g_dbus_connection_flush_sync(_lx_bus, null, null)
    end

    func _lx_thread(_arg: void*):
        g_main_context_push_thread_default(_lx_ctx)
        loop := g_main_loop_new(_lx_ctx, 0)
        g_main_loop_run(loop)
    end

    func _os_backend(): str:
        ret "sni"
    end

    func _os_supported(): bool:
        if _lx_get_bus() == null:
            _set_error("no D-Bus session bus")
            ret false
        end
        reply := _lx_bus_call("NameHasOwner", g_variant_new("(s)", _LX_WATCHER))
        if reply == null:
            _set_error("the D-Bus session bus did not answer")
            ret false
        end
        cell := mem.AllocateZeroed(8 as u64)
        g_variant_get(reply, "(b)", cell)
        has := (cell as i32*)[0]
        mem.Free(cell)
        g_variant_unref(reply)
        if has == 0:
            _set_error(
                "no tray host: nothing owns org.kde.StatusNotifierWatcher on the session bus"
            )
            ret false
        end
        ret true
    end

    func _os_apply(): bool:
        if _lx_get_bus() == null:
            _set_error("no D-Bus session bus")
            ret false
        end
        if not _lx_started:
            _lx_ctx = g_main_context_new()
            t := thread.SpawnStack(_lx_thread, null, 0 as u64)
            if not thread.Valid(t):
                _set_error("cannot start the tray thread")
                ret false
            end
            _lx_started = true
        end
        g_main_context_invoke(_lx_ctx, &salam_tray_lx_apply, null)
        ret true
    end
end
