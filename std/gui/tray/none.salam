package tray

if not SALAM_OS_WINDOWS and not SALAM_OS_MAC and not (SALAM_OS_LINUX and not SALAM_OS_ANDROID):
    func _os_supported(): bool:
        _set_error("the system tray is not supported on this system")
        ret false
    end

    func _os_backend(): str:
        ret "none"
    end

    func _os_apply(): bool:
        _set_error("the system tray is not supported on this system")
        ret false
    end
end
