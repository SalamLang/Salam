package typeset

func _shape_prev_index(cps &: Vector<int>, i: int): int:
    mut k := i - 1
    until k >= 0:
        if not _arabic_transparent(cps.get(k)):
            ret k
        end
        k--
    end
    ret -1
end

func _shape_next_index(cps &: Vector<int>, i: int): int:
    mut k := i + 1
    until k < cps.Len():
        if not _arabic_transparent(cps.get(k)):
            ret k
        end
        k++
    end
    ret -1
end

func _shape_merge_ligatures(src &: Vector<int>, out &: Vector<int>):
    n := src.Len()
    mut i := 0
    until i < n:
        cp := src.get(i)
        mut merged := false
        if cp == 0x0644:
            j := _shape_next_index(src, i)
            if j >= 0:
                lig := _arabic_lam_alef(cp, src.get(j))
                if lig != 0:
                    out.push(lig)
                    mut k := i + 1
                    until k < j:
                        out.push(src.get(k))
                        k++
                    end
                    i = j + 1
                    merged = true
                end
            end
        end
        if not merged:
            out.push(cp)
            i++
        end
    end
end

func _shape_form_at(cps &: Vector<int>, i: int): int:
    cp := cps.get(i)
    if _arabic_join_count(cp) == 0:
        ret _AR_ISOLATED
    end
    p := _shape_prev_index(cps, i)
    n := _shape_next_index(cps, i)
    joined_prev := p >= 0 and _arabic_join_count(cps.get(p)) == 2
    joined_next := n >= 0 and _arabic_join_count(cp) == 2 and _arabic_join_count(cps.get(n)) >= 1
    if joined_prev and joined_next: ret _AR_MEDIAL end
    if joined_next: ret _AR_INITIAL end
    if joined_prev: ret _AR_FINAL end
    ret _AR_ISOLATED
end

func _shape_arabic(src &: Vector<int>, out &: Vector<int>):
    mut merged := Vector {} as Vector<int>
    _shape_merge_ligatures(src, merged)
    mut i := 0
    until i < merged.Len():
        out.push(_arabic_shaped(merged.get(i), _shape_form_at(merged, i)))
        i++
    end
    merged.Free()
end

@en "ShapeArabic"
@fa "شکل‌دهی عربی"
pub func ShapeArabic(text: str): str:
    mut src := Vector {} as Vector<int>
    mut out := Vector {} as Vector<int>
    _utf8_decode_all(text, src)
    _shape_arabic(src, out)
    s := _utf8_encode_all(out)
    src.Free()
    out.Free()
    ret s
end
