package typeset

import math

const _TTF_SUBSAMPLES := 4

struct _Edge:
    pub x0: f64 = 0.0
    pub y0: f64 = 0.0
    pub x1: f64 = 0.0
    pub y1: f64 = 0.0
    pub dir: int = 0
end

struct _Cross:
    pub x: f64 = 0.0
    pub dir: int = 0
end

@en "CoverageRows"
@fa "سطرهای پوشش"
pub struct CoverageRows:
    @en "x"
    @fa "ایکس"
    pub x: int = 0
    @en "y"
    @fa "ایگرگ"
    pub y: int = 0
    @en "width"
    @fa "پهنا"
    pub width: int = 0
    @en "height"
    @fa "بلندی"
    pub height: int = 0
    @en "values"
    @fa "مقدارها"
    pub values: Vector<f64> = Vector {}
end

func _ttf_clampi(v: int, lo: int, hi: int): int:
    if v < lo: ret lo end
    if v > hi: ret hi end
    ret v
end

func _edge_push(edges &: Vector<_Edge>, x0: f64, y0: f64, x1: f64, y1: f64):
    if y0 == y1:
        ret
    end
    mut e := _Edge {}
    if y0 < y1:
        e.x0 = x0
        e.y0 = y0
        e.x1 = x1
        e.y1 = y1
        e.dir = 1
    else:
        e.x0 = x1
        e.y0 = y1
        e.x1 = x0
        e.y1 = y0
        e.dir = 0 - 1
    end
    edges.push(e)
end

func _quad_to(edges &: Vector<_Edge>, x0: f64, y0: f64, cx: f64, cy: f64, x1: f64, y1: f64):
    d := math.Abs(cx - x0) + math.Abs(cy - y0) + math.Abs(x1 - cx) + math.Abs(y1 - cy)
    mut n := 2 + (d / 3.0) as int
    if n > 32:
        n = 32
    end
    mut px := x0
    mut py := y0
    mut i := 1
    until i <= n:
        t := (i as f64) / (n as f64)
        mt := 1.0 - t
        qx := mt * mt * x0 + 2.0 * mt * t * cx + t * t * x1
        qy := mt * mt * y0 + 2.0 * mt * t * cy + t * t * y1
        _edge_push(edges, px, py, qx, qy)
        px = qx
        py = qy
        i++
    end
end

func _contour_edges(pts &: Vector<OutlinePoint>, s: int, e: int, edges &: Vector<_Edge>):
    if e - s < 2:
        ret
    end
    p0 := pts.get(s)
    plast := pts.get(e - 1)
    mut startx := 0.0
    mut starty := 0.0
    mut lo := s
    mut hi := e - 1
    if p0.on:
        startx = p0.x
        starty = p0.y
        lo = s + 1
    else if plast.on:
        startx = plast.x
        starty = plast.y
        hi = e - 2
    else:
        startx = (p0.x + plast.x) * 0.5
        starty = (p0.y + plast.y) * 0.5
    end
    mut cx := startx
    mut cy := starty
    mut ctrlx := 0.0
    mut ctrly := 0.0
    mut have_ctrl := false
    mut i := lo
    until i <= hi:
        p := pts.get(i)
        if p.on:
            if have_ctrl:
                _quad_to(edges, cx, cy, ctrlx, ctrly, p.x, p.y)
                have_ctrl = false
            else:
                _edge_push(edges, cx, cy, p.x, p.y)
            end
            cx = p.x
            cy = p.y
        else:
            if have_ctrl:
                mx := (ctrlx + p.x) * 0.5
                my := (ctrly + p.y) * 0.5
                _quad_to(edges, cx, cy, ctrlx, ctrly, mx, my)
                cx = mx
                cy = my
            end
            ctrlx = p.x
            ctrly = p.y
            have_ctrl = true
        end
        i++
    end
    if have_ctrl:
        _quad_to(edges, cx, cy, ctrlx, ctrly, startx, starty)
    else:
        _edge_push(edges, cx, cy, startx, starty)
    end
end

func _build_edges(pts &: Vector<OutlinePoint>, ends &: Vector<int>, edges &: Vector<_Edge>):
    mut s := 0
    mut k := 0
    until k < ends.Len():
        e := ends.get(k)
        if e > s and e <= pts.Len():
            _contour_edges(pts, s, e, edges)
        end
        s = e
        k++
    end
end

func _add_span(acc &: Vector<f64>, xoff: int, w: int, xa: f64, xb: f64, weight: f64):
    mut a := xa - (xoff as f64)
    mut b := xb - (xoff as f64)
    if a < 0.0:
        a = 0.0
    end
    if b > (w as f64):
        b = w as f64
    end
    if b <= a:
        ret
    end
    ia := a as int
    mut ib := b as int
    if ib >= w:
        ib = w - 1
    end
    if ia >= w or ib < ia:
        ret
    end
    if ia == ib:
        acc.set(ia, acc.get(ia) + (b - a) * weight)
        ret
    end
    acc.set(ia, acc.get(ia) + (((ia + 1) as f64) - a) * weight)
    mut i := ia + 1
    until i < ib:
        acc.set(i, acc.get(i) + weight)
        i++
    end
    acc.set(ib, acc.get(ib) + (b - (ib as f64)) * weight)
end

func _accumulate_spans(xs &: Vector<_Cross>, acc &: Vector<f64>, xoff: int, w: int, weight: f64):
    mut wind := 0
    mut spanx := 0.0
    mut i := 0
    until i < xs.Len():
        cr := xs.get(i)
        prev := wind
        wind += cr.dir
        if prev == 0 and wind != 0:
            spanx = cr.x
        else if prev != 0 and wind == 0:
            _add_span(acc, xoff, w, spanx, cr.x, weight)
        end
        i++
    end
end

func _gr_msort(idx &: Vector<int>, keys &: Vector<f64>, tmp &: Vector<int>, lo: int, hi: int):
    if hi - lo < 2:
        ret
    end
    mid := (lo + hi) / 2
    _gr_msort(idx, keys, tmp, lo, mid)
    _gr_msort(idx, keys, tmp, mid, hi)
    mut i := lo
    mut j := mid
    mut k := lo
    until k < hi:
        if j >= hi or (i < mid and keys.get(idx.get(i)) <= keys.get(idx.get(j))):
            tmp.set(k, idx.get(i))
            i++
        else:
            tmp.set(k, idx.get(j))
            j++
        end
        k++
    end
    k = lo
    until k < hi:
        idx.set(k, tmp.get(k))
        k++
    end
end

func _gr_sort(idx &: Vector<int>, keys &: Vector<f64>, tmp &: Vector<int>):
    until tmp.Len() < idx.Len():
        tmp.push(0)
    end
    _gr_msort(idx, keys, tmp, 0, idx.Len())
end

func _fill_edges(out &: CoverageRows, clip_w: int, clip_h: int, edges &: Vector<_Edge>):
    n := edges.Len()
    if n == 0 or clip_w <= 0 or clip_h <= 0:
        ret
    end
    mut minx := 1.0e30
    mut maxx := 0.0 - 1.0e30
    mut miny := 1.0e30
    mut maxy := 0.0 - 1.0e30
    mut ykeys := Vector {} as Vector<f64>
    mut order := Vector {} as Vector<int>
    mut i := 0
    until i < n:
        e := edges.get(i)
        if e.x0 < minx: minx = e.x0 end
        if e.x1 < minx: minx = e.x1 end
        if e.x0 > maxx: maxx = e.x0 end
        if e.x1 > maxx: maxx = e.x1 end
        if e.y0 < miny: miny = e.y0 end
        if e.y1 > maxy: maxy = e.y1 end
        ykeys.push(e.y0)
        order.push(i)
        i++
    end
    x0 := _ttf_clampi(math.Floor(minx) as int, 0, clip_w)
    x1 := _ttf_clampi((math.Floor(maxx) as int) + 1, 0, clip_w)
    y0 := _ttf_clampi(math.Floor(miny) as int, 0, clip_h)
    y1 := _ttf_clampi((math.Floor(maxy) as int) + 1, 0, clip_h)
    if x1 <= x0 or y1 <= y0:
        ykeys.free()
        order.free()
        ret
    end
    mut tmp := Vector {} as Vector<int>
    _gr_sort(order, ykeys, tmp)
    w := x1 - x0
    out.x = x0
    out.y = y0
    out.width = w
    out.height = y1 - y0
    out.values.zeros(w * (y1 - y0))
    step := 1.0 / (_TTF_SUBSAMPLES as f64)
    mut acc := Vector {} as Vector<f64>
    acc.zeros(w)
    mut xs := Vector {} as Vector<_Cross>
    mut active := Vector {} as Vector<int>
    mut xkeys := Vector {} as Vector<f64>
    mut xorder := Vector {} as Vector<int>
    mut sorted := Vector {} as Vector<_Cross>
    mut next := 0
    mut py := y0
    until py < y1:
        mut k := 0
        until k < w:
            acc.set(k, 0.0)
            k++
        end
        mut s := 0
        until s < _TTF_SUBSAMPLES:
            sy := (py as f64) + ((s as f64) + 0.5) * step
            until next < n and edges.get(order.get(next)).y0 <= sy:
                active.push(order.get(next))
                next++
            end
            xs.clear()
            xkeys.clear()
            xorder.clear()
            mut keep := 0
            mut a := 0
            until a < active.Len():
                ei := active.get(a)
                e := edges.get(ei)
                if e.y1 > sy:
                    active.set(keep, ei)
                    keep++
                    if sy >= e.y0:
                        mut cr := _Cross {}
                        cr.x = e.x0 + (sy - e.y0) * (e.x1 - e.x0) / (e.y1 - e.y0)
                        cr.dir = e.dir
                        xorder.push(xs.Len())
                        xkeys.push(cr.x)
                        xs.push(cr)
                    end
                end
                a++
            end
            until active.Len() > keep:
                active.pop()
            end
            _gr_sort(xorder, xkeys, tmp)
            sorted.clear()
            mut q := 0
            until q < xorder.Len():
                sorted.push(xs.get(xorder.get(q)))
                q++
            end
            _accumulate_spans(sorted, acc, x0, w, step)
            s++
        end
        row := (py - y0) * w
        mut q2 := 0
        until q2 < w:
            out.values.set(row + q2, acc.get(q2))
            q2++
        end
        py++
    end
    acc.free()
    xs.free()
    active.free()
    xkeys.free()
    xorder.free()
    sorted.free()
    tmp.free()
    ykeys.free()
    order.free()
end

@en "OutlineCoverage"
@fa "پوشش طرح"
pub func OutlineCoverage(o: GlyphOutline, clip_width: int, clip_height: int): CoverageRows:
    mut out := CoverageRows {}
    mut edges := Vector {} as Vector<_Edge>
    mut pts := o.points
    mut ends := o.ends
    _build_edges(pts, ends, edges)
    if edges.Len() <= 65536:
        _fill_edges(out, clip_width, clip_height, edges)
    end
    edges.free()
    ret out
end

@en "FreeCoverageRows"
@fa "آزادسازی سطرهای پوشش"
pub func FreeCoverageRows(c &: CoverageRows):
    c.values.free()
    c.values = Vector {} as Vector<f64>
    c.width = 0
    c.height = 0
end
