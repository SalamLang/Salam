package typeset

import str

@en "PlacedGlyph"
@fa "گلیف جایگذاری‌شده"
pub struct PlacedGlyph:
    @en "id"
    @fa "شناسه"
    pub id: int = 0
    @en "x"
    @fa "ایکس"
    pub x: f64 = 0.0
    @en "y"
    @fa "ایگرگ"
    pub y: f64 = 0.0
    @en "cluster"
    @fa "خوشه"
    pub cluster: int = 0
    @en "advance"
    @fa "پیشروی"
    pub advance: f64 = 0.0
end

@en "GlyphRun"
@fa "دنباله گلیف"
pub struct GlyphRun:
    @en "face"
    @fa "چهره"
    pub face: int = -1
    @en "size"
    @fa "اندازه"
    pub size: f64 = 0.0
    @en "x"
    @fa "ایکس"
    pub x: f64 = 0.0
    @en "width"
    @fa "پهنا"
    pub width: f64 = 0.0
    @en "start"
    @fa "آغاز"
    pub start: int = 0
    @en "end"
    @fa "انتهای بایت"
    pub end: int = 0
    @en "cp_start"
    @fa "آغاز نویسه"
    pub cp_start: int = 0
    @en "cp_end"
    @fa "انتهای نویسه"
    pub cp_end: int = 0
    @en "rtl"
    @fa "راست به چپ"
    pub rtl: bool = false
    @en "level"
    @fa "تراز"
    pub level: int = 0
    @en "tag"
    @fa "برچسب"
    pub tag: int = 0
    @en "span"
    @fa "تکه"
    pub span: int = 0
    @en "glyph_start"
    @fa "آغاز گلیف"
    pub glyph_start: int = 0
    @en "glyph_count"
    @fa "شمار گلیف"
    pub glyph_count: int = 0
    @en "ellipsis"
    @fa "سه نقطه"
    pub ellipsis: bool = false
end

@en "LineBox"
@fa "جعبه خط"
pub struct LineBox:
    @en "start"
    @fa "آغاز"
    pub start: int = 0
    @en "end"
    @fa "انتهای بایت"
    pub end: int = 0
    @en "cp_start"
    @fa "آغاز نویسه"
    pub cp_start: int = 0
    @en "cp_end"
    @fa "انتهای نویسه"
    pub cp_end: int = 0
    @en "trailing_cp"
    @fa "آغاز فاصله پایانی"
    pub trailing_cp: int = 0
    @en "top"
    @fa "بالا"
    pub top: f64 = 0.0
    @en "baseline"
    @fa "خط پایه"
    pub baseline: f64 = 0.0
    @en "height"
    @fa "بلندی"
    pub height: f64 = 0.0
    @en "ascent"
    @fa "صعود"
    pub ascent: f64 = 0.0
    @en "descent"
    @fa "نزول"
    pub descent: f64 = 0.0
    @en "x"
    @fa "ایکس"
    pub x: f64 = 0.0
    @en "width"
    @fa "پهنا"
    pub width: f64 = 0.0
    @en "run_start"
    @fa "آغاز دنباله"
    pub run_start: int = 0
    @en "run_count"
    @fa "شمار دنباله"
    pub run_count: int = 0
    @en "hard_break"
    @fa "شکست سخت"
    pub hard_break: bool = false
    @en "rtl"
    @fa "راست به چپ"
    pub rtl: bool = false
    @en "space_extra"
    @fa "فاصله افزوده"
    pub space_extra: int = 0
end

@en "TextLayout"
@fa "چیدمان متن"
pub struct TextLayout:
    @en "lines"
    @fa "خط‌ها"
    pub lines: Vector<LineBox> = Vector {}
    @en "runs"
    @fa "دنباله‌ها"
    pub runs: Vector<GlyphRun> = Vector {}
    @en "glyphs"
    @fa "گلیف‌ها"
    pub glyphs: Vector<PlacedGlyph> = Vector {}
    @en "width"
    @fa "پهنا"
    pub width: f64 = 0.0
    @en "height"
    @fa "بلندی"
    pub height: f64 = 0.0
    @en "max_width"
    @fa "بیشینه پهنا"
    pub max_width: f64 = 0.0
    @en "truncated"
    @fa "بریده‌شده"
    pub truncated: bool = false
end

struct _Seg:
    pub cs: int = 0
    pub ce: int = 0
    pub level: int = 0
    pub run: int = -1
end

struct _LLine:
    pub s: int = 0
    pub e: int = 0
    pub hard: bool = false
end

func _next_gstart(p: Paragraph, k: int, limit: int): int:
    mut j := k + 1
    until j < limit and not _cf(p, j, _CF_GSTART):
        j++
    end
    ret j
end

func _push_line(lines &: Vector<_LLine>, s: int, e: int, hard: bool):
    mut l := _LLine {}
    l.s = s
    l.e = e
    l.hard = hard
    lines.Push(l)
end

func _break_lines(p: Paragraph, max26: int, lines &: Vector<_LLine>):
    n := p.chars.Len()
    if n == 0:
        _push_line(lines, 0, 0, false)
        ret
    end
    wrap := max26 > 0 and _ws_wraps(p.style.white_space)
    split := p.style.overflow_wrap != OverflowWrap.Normal
    mut line_s := 0
    mut cur := 0
    mut has := false
    mut piece_s := 0
    mut i := 1
    until i <= n:
        b := i == n ? _BRK_MUST : p.chars.Get(i).brk
        if b == _BRK_NONE:
            i++
            continue
        end
        ce := _content_end(p, piece_s, i)
        cw := _width(p, piece_s, ce)
        if wrap and has and cur + cw > max26:
            _push_line(lines, line_s, piece_s, false)
            line_s = piece_s
            cur = 0
            has = false
        end
        if wrap and not has and cw > max26 and split:
            mut gs := piece_s
            mut acc := 0
            mut k := piece_s
            until k < ce:
                ke := _next_gstart(p, k, ce)
                gw := _width(p, k, ke)
                if acc + gw > max26 and k > gs:
                    _push_line(lines, gs, k, false)
                    gs = k
                    acc = 0
                end
                acc += gw
                k = ke
            end
            line_s = gs
            cur = acc + _width(p, ce, i)
            has = true
        else:
            cur += _width(p, piece_s, i)
            has = true
        end
        if b == _BRK_MUST:
            _push_line(lines, line_s, i, _cf(p, i - 1, _CF_HARD))
            line_s = i
            cur = 0
            has = false
        end
        piece_s = i
        i++
    end
    if _cf(p, n - 1, _CF_HARD):
        _push_line(lines, n, n, false)
    end
end

func _face_vmetrics(fc &: FontCollection, face: int, sp: TextSpan, top &: int, bottom &: int):
    size64 := _to26(sp.size)
    f := FaceFont(fc, face)
    mut a := (size64 * 4) / 5
    mut d := size64 - a
    mut g := 0
    if FontValid(f):
        m := Metrics(f)
        a = _scale26(m.ascent, size64, m.units_per_em)
        d = _scale26(m.descent, size64, m.units_per_em)
        g = _scale26(m.line_gap, size64, m.units_per_em)
    end
    mut lh := a + d + g
    if sp.line_height > 0.0:
        lh = _to26(sp.line_height)
    else sp.line_height_scale > 0.0:
        lh = _to26(sp.size * sp.line_height_scale)
    end
    lead := lh - (a + d)
    top = a + lead / 2
    bottom = lh - top
end

func _reorder(segs &: Vector<_Seg>):
    n := segs.Len()
    if n < 2:
        ret
    end
    mut hi := 0
    mut lo_odd := 1000
    each s in segs:
        if s.level > hi: hi = s.level end
        if s.level % 2 == 1 and s.level < lo_odd: lo_odd = s.level end
    end
    mut lv := hi
    until lv >= lo_odd and lv > 0:
        mut i := 0
        until i < n:
            if segs.Get(i).level < lv:
                i++
                continue
            end
            mut e := i
            until e < n and segs.Get(e).level >= lv:
                e++
            end
            mut a := i
            mut b := e - 1
            until a < b:
                t := segs.Get(a)
                segs.Set(a, segs.Get(b))
                segs.Set(b, t)
                a++
                b--
            end
            i = e
        end
        lv--
    end
end

func _ellipsis_glyphs(p: Paragraph, fc &: FontCollection, face: int, span: int, out &: Vector<ParagraphGlyph>): int:
    f := FaceFont(fc, face)
    if not FontValid(f):
        ret 0
    end
    sp := p.spans.Get(span)
    size64 := _to26(sp.size)
    mut cps := Vector {} as Vector<int>
    defer cps.Free()
    if GlyphIndex(f, 0x2026) != 0:
        cps.Push(0x2026)
    else:
        cps.Push(0x2E)
        cps.Push(0x2E)
        cps.Push(0x2E)
    end
    mut forms := Vector {} as Vector<int>
    mut skip := Vector {} as Vector<bool>
    defer forms.Free()
    defer skip.Free()
    forms.zeros(cps.Len())
    repeat cps.Len():
        skip.Push(false)
    end
    mut b := _Buf {}
    _shape_buf(f, cps, forms, skip, 0, cps.Len(), false, _tag("DFLT"), 0, 0, b)
    mut w := 0
    mut q := 0
    until q < b.g.Len():
        mut g := ParagraphGlyph {}
        g.id = b.g.Get(q)
        g.cp = -1
        g.advance = _scale26(b.xa.Get(q), size64, f.units_per_em)
        g.x_offset = _scale26(b.xo.Get(q), size64, f.units_per_em)
        g.y_offset = _scale26(b.yo.Get(q), size64, f.units_per_em)
        w += g.advance
        out.Push(g)
        q++
    end
    _buf_free(b)
    ret w
end

func _prev_visible_gstart(p: Paragraph, s: int, k: int): int:
    mut j := k - 1
    until j > s and not _cf(p, j, _CF_GSTART):
        j--
    end
    ret j
end

func _place_line(p: Paragraph, fc &: FontCollection, l &: TextLayout, ll: _LLine, max26: int, last: bool, ellipsize: bool, top26 &: int):
    n := p.chars.Len()
    mut base := (p.style.direction == TextDirRTL) ? 1 : 0
    if ll.s < n:
        base = p.chars.Get(ll.s).base
    else n > 0:
        base = p.chars.Get(n - 1).base
    end
    collapse := not _ws_mode_pre(p.style.white_space)
    mut e := ll.e
    mut ce := _content_end(p, ll.s, e)
    mut ell := Vector {} as Vector<ParagraphGlyph>
    defer ell.Free()
    mut ell_w := 0
    mut ell_face := -1
    mut ell_span := 0
    if ellipsize and max26 > 0:
        mut k := ce
        if k > ll.s:
            ell_face = p.chars.Get(k - 1).face
            ell_span = p.chars.Get(k - 1).span
        else n > 0:
            ell_face = p.chars.Get(0).face
        end
        ell_w = _ellipsis_glyphs(p, fc, ell_face, ell_span, ell)
        until k > ll.s and _width(p, ll.s, k) + ell_w > max26:
            k = _prev_visible_gstart(p, ll.s, k)
        end
        ce = _content_end(p, ll.s, k)
        e = ce
    end
    content_w := _width(p, ll.s, ce) + ell_w
    mut extra := 0
    if p.style.align == TextAlign.Justify and not last and not ll.hard and max26 > content_w:
        mut spaces := 0
        mut k := ll.s
        until k < ce:
            if _cf(p, k, _CF_SPACE) and not _cf(p, k, _CF_HIDDEN):
                spaces++
            end
            k++
        end
        if spaces > 0:
            extra = (max26 - content_w) / spaces
        end
    end
    mut segs := Vector {} as Vector<_Seg>
    defer segs.Free()
    mut ri := 0
    until ri < p.runs.Len():
        r := p.runs.Get(ri)
        a := r.cp_start > ll.s ? r.cp_start : ll.s
        b := r.cp_end < ce ? r.cp_end : ce
        if a < b:
            mut sg := _Seg {}
            sg.cs = a
            sg.ce = b
            sg.level = r.level
            sg.run = ri
            segs.Push(sg)
        end
        ri++
    end
    if ellipsize and ell.Len() > 0:
        mut sg := _Seg {}
        sg.cs = ce
        sg.ce = ce
        sg.level = base
        sg.run = -2
        segs.Push(sg)
    end
    ri = 0
    until ri < p.runs.Len():
        r := p.runs.Get(ri)
        a := r.cp_start > ce ? r.cp_start : ce
        b := r.cp_end < e ? r.cp_end : e
        if a < b:
            mut sg := _Seg {}
            sg.cs = a
            sg.ce = b
            sg.level = base
            sg.run = ri
            segs.Push(sg)
        end
        ri++
    end
    _reorder(segs)
    mut lb := LineBox {}
    lb.cp_start = ll.s
    lb.cp_end = e
    lb.trailing_cp = ce
    lb.start = ll.s < n ? p.chars.Get(ll.s).offset : _str_len_of(p)
    lb.end = e < n ? p.chars.Get(e).offset : _str_len_of(p)
    lb.hard_break = ll.hard
    lb.rtl = base == 1
    lb.space_extra = extra
    lb.run_start = l.runs.Len()
    mut trailing_w := 0
    mut pen := 0
    mut asc := 0
    mut desc := 0
    _face_vmetrics(fc, p.spans.Len() > 0 ? _first_face(p) : -1, p.spans.Get(0), asc, desc)
    mut si := 0
    until si < segs.Len():
        sg := segs.Get(si)
        si++
        mut gr := GlyphRun {}
        gr.x = _from26(pen)
        gr.cp_start = sg.cs
        gr.cp_end = sg.ce
        gr.start = sg.cs < n ? p.chars.Get(sg.cs).offset : _str_len_of(p)
        gr.end = sg.ce < n ? p.chars.Get(sg.ce).offset : _str_len_of(p)
        gr.level = sg.level
        gr.rtl = (sg.level % 2) == 1
        gr.glyph_start = l.glyphs.Len()
        seg_pen := pen
        if sg.run == -2:
            gr.ellipsis = true
            gr.face = ell_face
            gr.span = ell_span
            gr.size = p.spans.Get(ell_span).size
            gr.tag = p.spans.Get(ell_span).tag
            each g in ell:
                mut pg := PlacedGlyph {}
                pg.id = g.id
                pg.x = _from26(pen + g.x_offset)
                pg.y = _from26(0 - g.y_offset)
                pg.cluster = lb.end
                pg.advance = _from26(g.advance)
                l.glyphs.Push(pg)
                pen += g.advance
            end
        else:
            r := p.runs.Get(sg.run)
            sp := p.spans.Get(r.span)
            gr.face = r.face
            gr.span = r.span
            gr.size = sp.size
            gr.tag = sp.tag
            mut top := 0
            mut bot := 0
            _face_vmetrics(fc, r.face, sp, top, bot)
            if top > asc: asc = top end
            if bot > desc: desc = bot end
            trailing := sg.cs >= ce
            count := r.glyph_end - r.glyph_start
            mut q := 0
            until q < count:
                gi := gr.rtl ? r.glyph_end - 1 - q : r.glyph_start + q
                g := p.glyphs.Get(gi)
                q++
                if g.cp < sg.cs or g.cp >= sg.ce:
                    continue
                end
                mut adv := g.advance
                if trailing and collapse:
                    adv = 0
                else extra != 0 and _cf(p, g.cp, _CF_SPACE):
                    adv += extra
                end
                if not (trailing and collapse):
                    mut pg := PlacedGlyph {}
                    pg.id = g.id
                    pg.x = _from26(pen + g.x_offset)
                    pg.y = _from26(0 - g.y_offset)
                    pg.cluster = p.chars.Get(g.cp).offset
                    pg.advance = _from26(adv)
                    l.glyphs.Push(pg)
                end
                pen += adv
            end
            if trailing:
                trailing_w += pen - seg_pen
            end
        end
        gr.glyph_count = l.glyphs.Len() - gr.glyph_start
        gr.width = _from26(pen - seg_pen)
        l.runs.Push(gr)
    end
    lb.run_count = l.runs.Len() - lb.run_start
    total := pen
    cw := total - trailing_w
    mut container := max26
    if container <= 0:
        container = cw
    end
    mut al := p.style.align
    if al == TextAlign.Justify:
        al = TextAlign.Start
    end
    if al == TextAlign.Start:
        al = base == 1 ? TextAlign.Right : TextAlign.Left
    else al == TextAlign.End:
        al = base == 1 ? TextAlign.Left : TextAlign.Right
    end
    mut off := 0
    if al == TextAlign.Right:
        off = container - cw
    else al == TextAlign.Center:
        off = (container - cw) / 2
    end
    if base == 1:
        off -= trailing_w
    end
    lb.x = _from26(off)
    lb.width = _from26(cw)
    lb.top = _from26(top26)
    lb.ascent = _from26(asc)
    lb.descent = _from26(desc)
    lb.height = _from26(asc + desc)
    lb.baseline = _from26(top26 + asc)
    mut k := lb.run_start
    until k < l.runs.Len():
        mut gr := l.runs.Get(k)
        gr.x += lb.x
        l.runs.Set(k, gr)
        mut q := gr.glyph_start
        until q < gr.glyph_start + gr.glyph_count:
            mut pg := l.glyphs.Get(q)
            pg.x += lb.x
            pg.y += lb.baseline
            l.glyphs.Set(q, pg)
            q++
        end
        k++
    end
    top26 += asc + desc
    l.lines.Push(lb)
end

func _str_len_of(p: Paragraph): int:
    ret str.Len(p.text)
end

func _first_face(p: Paragraph): int:
    each c in p.chars:
        if c.face >= 0:
            ret c.face
        end
    end
    ret -1
end

@en "LayoutParagraph"
@fa "چیدن بند"
pub func LayoutParagraph(p &: Paragraph, fc &: FontCollection, max_width: f64): TextLayout:
    mut l := TextLayout {}
    l.max_width = max_width
    mut max26 := 0
    if max_width > 0.0:
        max26 = _to26(max_width)
    end
    mut lines := Vector {} as Vector<_LLine>
    defer lines.Free()
    _break_lines(p, max26, lines)
    mut count := lines.Len()
    if p.style.max_lines > 0 and count > p.style.max_lines:
        count = p.style.max_lines
        l.truncated = true
    end
    nowrap := not _ws_wraps(p.style.white_space)
    mut top := 0
    mut i := 0
    until i < count:
        ll := lines.Get(i)
        last := i == lines.Len() - 1
        mut ell := false
        if p.style.ellipsis and max26 > 0:
            if l.truncated and i == count - 1:
                ell = true
            else nowrap and _width(p, ll.s, _content_end(p, ll.s, ll.e)) > max26:
                ell = true
                l.truncated = true
            end
        end
        _place_line(p, fc, l, ll, max26, last, ell, top)
        i++
    end
    mut w := 0.0
    each lb in l.lines:
        if lb.width > w:
            w = lb.width
        end
    end
    if max_width > 0.0:
        l.width = max_width
    else:
        l.width = w
    end
    l.height = _from26(top)
    ret l
end

@en "FreeLayout"
@fa "آزادسازی چیدمان"
pub func FreeLayout(l &: TextLayout):
    l.lines.Free()
    l.runs.Free()
    l.glyphs.Free()
    l.lines = Vector {} as Vector<LineBox>
    l.runs = Vector {} as Vector<GlyphRun>
    l.glyphs = Vector {} as Vector<PlacedGlyph>
end
