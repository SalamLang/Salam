package typeset

import unicode

const _LB_AL := 0
const _LB_BK := 1
const _LB_CR := 2
const _LB_LF := 3
const _LB_NL := 4
const _LB_SP := 5
const _LB_ZW := 6
const _LB_WJ := 7
const _LB_GL := 8
const _LB_ZWJ := 9
const _LB_CM := 10
const _LB_BA := 11
const _LB_HY := 12
const _LB_B2 := 13
const _LB_BB := 14
const _LB_OP := 15
const _LB_CL := 16
const _LB_CP := 17
const _LB_QU := 18
const _LB_EX := 19
const _LB_IS := 20
const _LB_SY := 21
const _LB_NU := 22
const _LB_PR := 23
const _LB_PO := 24
const _LB_ID := 25
const _LB_NS := 26
const _LB_IN := 27

const _BRK_NONE := 0
const _BRK_ALLOW := 1
const _BRK_MUST := 2

func _lb_cjk(cp: int): int:
    switch cp:
        0x3000: ret _LB_BA end
        0x3001, 0x3002, 0xFF0C, 0xFF0E, 0xFF09, 0xFF3D, 0xFF5D: ret _LB_CL end
        0x3005, 0x30FC, 0x309D, 0x309E, 0x30FD, 0x30FE, 0xFF1A, 0xFF1B: ret _LB_NS end
        0x3008, 0x300A, 0x300C, 0x300E, 0x3010, 0x3014, 0x3016, 0x3018, 0x301A, 0xFF08, 0xFF3B, 0xFF5B: ret _LB_OP end
        0x3009, 0x300B, 0x300D, 0x300F, 0x3011, 0x3015, 0x3017, 0x3019, 0x301B: ret _LB_CL end
        0xFF01, 0xFF1F: ret _LB_EX end
        else: ret _LB_ID end
    end
    ret _LB_ID
end

func _lb_special(cp: int): int:
    switch cp:
        0x85: ret _LB_NL end
        0xA0, 0x202F, 0x2007, 0x2011, 0x0F0C: ret _LB_GL end
        0xAD, 0x2010, 0x2012, 0x2013, 0x058A, 0x2027, 0x1680, 0x2000, 0x2001, 0x2002, 0x2003, 0x2004, 0x2005, 0x2006, 0x2008, 0x2009, 0x200A: ret _LB_BA end
        0x2014: ret _LB_B2 end
        0x200B: ret _LB_ZW end
        0x2060, 0xFEFF: ret _LB_WJ end
        0x200D: ret _LB_ZWJ end
        0x2028, 0x2029: ret _LB_BK end
        0xAB, 0xBB, 0x2018, 0x2019, 0x201A, 0x201B, 0x201C, 0x201D, 0x201E, 0x201F, 0x2039, 0x203A: ret _LB_QU end
        0x060C, 0x060D, 0x066B, 0x066C: ret _LB_IS end
        0x061B, 0x061F, 0x06D4, 0x203C, 0x2049: ret _LB_EX end
        0x066A, 0x2030, 0x2031, 0x2032, 0x2033, 0x00B0, 0x2103: ret _LB_PO end
        0x00A3, 0x00A5, 0x20AC, 0x20B9, 0xFDFC, 0x00B1, 0x2116: ret _LB_PR end
        0x2024, 0x2025, 0x2026: ret _LB_IN end
        0x00B4, 0x02C8, 0x02CC: ret _LB_BB end
        else: ret 0 - 1 end
    end
    ret 0 - 1
end

func _lb_class(cp: int): int:
    if cp < 0x80:
        switch cp:
            0x0A: ret _LB_LF end
            0x0D: ret _LB_CR end
            0x0B, 0x0C: ret _LB_BK end
            0x20: ret _LB_SP end
            0x09: ret _LB_BA end
            0x2D: ret _LB_HY end
            0x28, 0x5B, 0x7B: ret _LB_OP end
            0x29, 0x5D: ret _LB_CP end
            0x7D: ret _LB_CL end
            0x22, 0x27: ret _LB_QU end
            0x21, 0x3F: ret _LB_EX end
            0x2C, 0x2E, 0x3A, 0x3B: ret _LB_IS end
            0x2F: ret _LB_SY end
            0x25: ret _LB_PO end
            0x24, 0x2B, 0x5C: ret _LB_PR end
            0x7C: ret _LB_BA end
            else:
                if cp >= 0x30 and cp <= 0x39: ret _LB_NU end
                if cp < 0x20: ret _LB_CM end
                ret _LB_AL
            end
        end
    end
    sp := _lb_special(cp)
    if sp >= 0:
        ret sp
    end
    if (cp >= 0x0660 and cp <= 0x0669) or (cp >= 0x06F0 and cp <= 0x06F9):
        ret _LB_NU
    end
    if cp >= 0x2E80 and cp <= 0x2FFF: ret _LB_ID end
    if cp >= 0x3000 and cp <= 0x30FF: ret _lb_cjk(cp) end
    if cp >= 0x3400 and cp <= 0x4DBF: ret _LB_ID end
    if cp >= 0x4E00 and cp <= 0x9FFF: ret _LB_ID end
    if cp >= 0xAC00 and cp <= 0xD7A3: ret _LB_ID end
    if cp >= 0xF900 and cp <= 0xFAFF: ret _LB_ID end
    if cp >= 0xFF01 and cp <= 0xFF60: ret _lb_cjk(cp) end
    if cp >= 0x1F300 and cp <= 0x1FAFF: ret _LB_ID end
    if cp >= 0x20000 and cp <= 0x3FFFD: ret _LB_ID end
    if cp == 0x200C or unicode.IsMark(cp) or unicode.IsFormat(cp): ret _LB_CM end
    if unicode.IsDigit(cp): ret _LB_NU end
    ret _LB_AL
end

func _lb_no_break(a: int, b: int): bool:
    if b == _LB_CL or b == _LB_CP or b == _LB_EX or b == _LB_IS or b == _LB_SY: ret true end
    if a == _LB_QU or b == _LB_QU: ret true end
    if b == _LB_BA or b == _LB_HY or b == _LB_NS or b == _LB_IN: ret true end
    if a == _LB_BB: ret true end
    if a == _LB_GL: ret true end
    if b == _LB_GL and a != _LB_BA and a != _LB_HY: ret true end
    if a == _LB_AL and (b == _LB_NU or b == _LB_AL or b == _LB_PR or b == _LB_PO or b == _LB_OP): ret true end
    if a == _LB_NU and (b == _LB_AL or b == _LB_NU or b == _LB_PO or b == _LB_PR or b == _LB_OP): ret true end
    if (a == _LB_PR or a == _LB_PO) and (b == _LB_NU or b == _LB_AL or b == _LB_OP): ret true end
    if (a == _LB_OP or a == _LB_HY or a == _LB_IS or a == _LB_SY) and b == _LB_NU: ret true end
    if a == _LB_PR and b == _LB_ID: ret true end
    if a == _LB_ID and b == _LB_PO: ret true end
    if a == _LB_IS and b == _LB_AL: ret true end
    if a == _LB_CP and (b == _LB_AL or b == _LB_NU): ret true end
    ret false
end

func _line_breaks(cps &: Vector<int>, out &: Vector<int>):
    n := cps.len()
    out.clear()
    out.zeros(n + 1)
    if n == 0:
        ret
    end
    mut prev := _lb_class(cps.get(0))
    if prev == _LB_CM or prev == _LB_ZWJ:
        prev = _LB_AL
    end
    mut before_sp := prev
    mut zw_seen := prev == _LB_ZW
    mut i := 1
    until i < n:
        cur := _lb_class(cps.get(i))
        mut brk := _BRK_NONE
        mut attach := false
        if prev == _LB_BK or prev == _LB_LF or prev == _LB_NL or (prev == _LB_CR and cur != _LB_LF):
            brk = _BRK_MUST
        else cur == _LB_BK or cur == _LB_CR or cur == _LB_LF or cur == _LB_NL or cur == _LB_SP or cur == _LB_ZW:
            brk = _BRK_NONE
        else zw_seen:
            brk = _BRK_ALLOW
        else prev == _LB_ZWJ:
            brk = _BRK_NONE
        else (cur == _LB_CM or cur == _LB_ZWJ) and prev != _LB_SP:
            brk = _BRK_NONE
            attach = true
        else cur == _LB_WJ or prev == _LB_WJ:
            brk = _BRK_NONE
        else prev == _LB_SP:
            if before_sp == _LB_OP:
                brk = _BRK_NONE
            else before_sp == _LB_QU and cur == _LB_OP:
                brk = _BRK_NONE
            else (before_sp == _LB_CL or before_sp == _LB_CP) and cur == _LB_NS:
                brk = _BRK_NONE
            else before_sp == _LB_B2 and cur == _LB_B2:
                brk = _BRK_NONE
            else cur == _LB_CL or cur == _LB_CP or cur == _LB_EX or cur == _LB_IS or cur == _LB_SY or cur == _LB_GL:
                brk = _BRK_NONE
            else:
                brk = _BRK_ALLOW
            end
        else prev == _LB_OP:
            brk = _BRK_NONE
        else _lb_no_break(prev, cur):
            brk = _BRK_NONE
        else:
            brk = _BRK_ALLOW
        end
        out.set(i, brk)
        if not attach:
            mut c := cur
            if (c == _LB_CM or c == _LB_ZWJ) and prev == _LB_SP:
                c = _LB_AL
            end
            if c == _LB_ZW:
                zw_seen = true
            else c != _LB_SP:
                zw_seen = false
            end
            if c != _LB_SP:
                before_sp = c
            end
            prev = c
        end
        i++
    end
    out.set(n, _BRK_MUST)
end
