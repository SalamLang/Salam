    @en "span_starts"
    @fa "آغاز تکه‌ها"
    pub span_starts: Vector<int> = Vector {}
    @en "chars"
    @fa "نویسه‌ها"
    pub chars: Vector<CharInfo> = Vector {}
    @en "runs"
    @fa "دنباله‌ها"
    pub runs: Vector<ShapedRun> = Vector {}
    @en "glyphs"
    @fa "گلیف‌ها"
    pub glyphs: Vector<ParagraphGlyph> = Vector {}
    @en "min_content"
    @fa "کمینه محتوا"
    pub min_content: int = 0
    @en "max_content"
    @fa "بیشینه محتوا"
    pub max_content: int = 0
end

func _to26(v: f64): int:
    ret math.Round(v * 64.0) as int
end

func _from26(v: int): f64:
    ret (v as f64) / 64.0
end

func _div_round(a: i64, b: i64): int:
    if b <= (0 as i64):
        ret 0
    end
    if a >= (0 as i64):
        ret ((a + b / (2 as i64)) / b) as int
    end
    ret (0 - (((0 as i64) - a + b / (2 as i64)) / b)) as int
end

func _scale26(fu: int, size64: int, upem: int): int:
    ret _div_round((fu as i64) * (size64 as i64), upem as i64)
end

func _gcb_is_break(prev: int, curr: int, ri_run: int, pict_zwj: bool, conjunct: bool): bool:
    pc := unicode.GraphemeBreak(prev)
    cc := unicode.GraphemeBreak(curr)
    if pc == unicode.GcbCR and cc == unicode.GcbLF: ret false end
    if pc == unicode.GcbControl or pc == unicode.GcbCR or pc == unicode.GcbLF: ret true end
    if cc == unicode.GcbControl or cc == unicode.GcbCR or cc == unicode.GcbLF: ret true end
    if pc == unicode.GcbL:
        if cc == unicode.GcbL or cc == unicode.GcbV or cc == unicode.GcbLV or cc == unicode.GcbLVT: ret false end
    end
    if pc == unicode.GcbLV or pc == unicode.GcbV:
        if cc == unicode.GcbV or cc == unicode.GcbT: ret false end
    end
    if pc == unicode.GcbLVT or pc == unicode.GcbT:
        if cc == unicode.GcbT: ret false end
    end
    if cc == unicode.GcbExtend or cc == unicode.GcbZWJ or cc == unicode.GcbSpacingMark: ret false end
    if pc == unicode.GcbPrepend: ret false end
    if conjunct and unicode.ConjunctBreak(curr) == unicode.IncbConsonant: ret false end
    if pc == unicode.GcbZWJ and cc == unicode.GcbExtendedPictographic and pict_zwj: ret false end
    if pc == unicode.GcbRegionalIndicator and cc == unicode.GcbRegionalIndicator and ri_run % 2 == 1: ret false end
    ret true
end

func _gcb_pict(state: int, cp: int): int:
    k := unicode.GraphemeBreak(cp)
    if k == unicode.GcbExtendedPictographic: ret 1 end
    if state == 1 and k == unicode.GcbExtend: ret 1 end
    if state == 1 and k == unicode.GcbZWJ: ret 2 end
    ret 0
end

func _gcb_conj(state: int, cp: int): int:
    k := unicode.ConjunctBreak(cp)
    if k == unicode.IncbConsonant: ret 1 end
    if state > 0 and k == unicode.IncbLinker: ret 2 end
    if state > 0 and k == unicode.IncbExtend: ret state end
    ret 0
end

func _grapheme_starts(cps &: Vector<int>, out &: Vector<bool>):
    out.clear()
    n := cps.Len()
    if n == 0:
        ret
    end
    out.push(true)
    mut prev := cps.get(0)
    mut ri := 0
    if unicode.GraphemeBreak(prev) == unicode.GcbRegionalIndicator: ri = 1 end
    mut pict := _gcb_pict(0, prev)
    mut conj := _gcb_conj(0, prev)
    mut i := 1
    until i < n:
        cur := cps.get(i)
        brk := _gcb_is_break(prev, cur, ri, pict == 2, conj == 2)
        out.push(brk)
        if brk:
            ri = 0
        end
        if unicode.GraphemeBreak(cur) == unicode.GcbRegionalIndicator:
            ri++
        else:
            ri = 0
        end
        pict = _gcb_pict(pict, cur)
        conj = _gcb_conj(conj, cur)
        prev = cur
        i++
    end
end

func _is_word_cp(cp: int): bool:
    if cp == 0x200C or cp == 0x200D or cp == 0x5F:
        ret true
    end
    ret unicode.IsLetter(cp) or unicode.IsNumber(cp) or unicode.IsMark(cp)
end

func _cf(p: Paragraph, i: int, flag: int): bool:
    ret (p.chars.get(i).flags & flag) != 0
end

func _span_family_face(fc &: FontCollection, sp: TextSpan): int:
    key := _fc_memo_key(sp.families, sp.weight, sp.italic, -2)
    if fc.memo.has(key):
        r := fc.memo.get(key)
        mem.Free(key as void*)
        ret r
    end
    r := _span_family_face_scan(fc, sp)
    fc.memo.put(key, r)
    ret r
end

func _span_family_face_scan(fc &: FontCollection, sp: TextSpan): int:
    mut names := Vector {} as Vector<str>
    defer names.Free()
    _fc_family_list(sp.families, names)
    mut exp := Vector {} as Vector<str>
    defer exp.Free()
    each n in names:
        if not _fc_generic(n, exp):
            exp.push(n)
        end
    end
    each n in exp:
        r := _fc_match(fc, n, sp.weight, sp.italic, -1)
        if r >= 0:
            ret r
        end
    end
    ret -1
end

func _pick_face(fc &: FontCollection, sp: TextSpan, cps &: Vector<int>, s: int, e: int, prev_face: int): int:
    mut base := -1
    mut k := s
    until k < e and base < 0:
        c := cps.get(k)
        if not _is_default_ignorable(c) and not unicode.IsMark(c):
            base = c
        end
        k++
    end
    if base < 0:
        ret prev_face
    end
    sc := unicode.Script(base)
    if prev_face >= 0 and (sc == unicode.ScriptCommon or sc == unicode.ScriptInherited) and _fc_covers(fc, prev_face, base):
        ret prev_face
    end
    ret FaceForCodepoint(fc, sp.families, sp.weight, sp.italic, base)
end

func _resolve_scripts(cps &: Vector<int>, out &: Vector<int>):
    n := cps.Len()
    out.clear()
    mut last := -1
    mut i := 0
    until i < n:
        sc := unicode.Script(cps.get(i))
        if sc == unicode.ScriptCommon or sc == unicode.ScriptInherited or sc == unicode.ScriptUnknown:
            out.push(last)
        else:
            out.push(sc)
            last = sc
        end
        i++
    end
    mut next := unicode.ScriptLatin
    mut j := n - 1
    until j >= 0:
        if out.get(j) < 0:
            out.set(j, next)
        else:
            next = out.get(j)
        end
        j--
    end
end

func _ws_mode_pre(ws: WhiteSpace): bool:
    ret ws == WhiteSpace.Pre or ws == WhiteSpace.PreWrap
end

func _ws_wraps(ws: WhiteSpace): bool:
    ret ws == WhiteSpace.Normal or ws == WhiteSpace.PreWrap
end

func _para_levels(p &: Paragraph, shape_cps &: Vector<int>):
    n := p.chars.Len()
    mut s := 0
    until s < n:
        mut e := s
        until e < n and not _cf(p, e, _CF_HARD):
            e++
        end
        mut sub := Vector {} as Vector<int>
        mut k := s
        until k < e:
            sub.push(shape_cps.get(k))
            k++
        end
        txt := _utf8_encode_all(sub)
        base := bidi.ParagraphLevel(txt, p.style.direction)
        levels := bidi.Levels(txt, p.style.direction)
        mut lastlv := base
        k = s
        until k < e:
            mut c := p.chars.get(k)
            mut lv := levels.get(k - s)
            if lv < 0:
                lv = lastlv
            end
            lastlv = lv
            c.level = lv
            c.base = base
            p.chars.set(k, c)
            k++
        end
        if e < n:
            mut c := p.chars.get(e)
            c.level = base
            c.base = base
            p.chars.set(e, c)
        end
        levels.Free()
        sub.Free()
        mem.Free(txt as void*)
        s = e + 1
    end
end

func _decode_spans(p &: Paragraph):
    mut sb := str.NewBuilder()
    mut si := 0
    until si < p.spans.Len():
        sp := p.spans.get(si)
        base := str.BufLen(sb) as int
        p.span_starts.push(base)
        str.BufAppend(sb, sp.text)
        n := str.Len(sp.text)
        bp := sp.text as u8*
        mut i := 0
        until i < n:
            mut ci := CharInfo {}
            ci.offset = base + i
            ci.span = si
            mut cp := 0
            i = _utf8_next(bp, n, i, cp)
            ci.cp = cp
            p.chars.push(ci)
        end
        si++
    end
    p.text = str.BufStr(sb)
    str.BufFree(sb)
end

func _white_space(p &: Paragraph, shape_cps &: Vector<int>):
    pre := _ws_mode_pre(p.style.white_space)
    n := p.chars.Len()
    mut prev_space := true
    mut i := 0
    until i < n:
        mut c := p.chars.get(i)
        cp := c.cp
        mut scp := cp
        if cp == 0x2028 or cp == 0x2029:
            c.flags |= _CF_HARD | _CF_HIDDEN
            scp = 0x0A
            prev_space = true
        else pre:
            if cp == 0x0A:
                c.flags |= _CF_HARD | _CF_HIDDEN
            else cp == 0x0D:
                c.flags |= _CF_HIDDEN
                if i + 1 >= n or p.chars.get(i + 1).cp != 0x0A:
                    c.flags |= _CF_HARD
                    scp = 0x0A
                end
            else cp == 0x20 or cp == 0x09:
                c.flags |= _CF_SPACE
            end
        else cp == 0x20 or cp == 0x09 or cp == 0x0A or cp == 0x0D or cp == 0x0C:
            scp = 0x20
            c.flags |= _CF_SPACE
            if prev_space:
                c.flags |= _CF_HIDDEN
            end
            prev_space = true
        else:
            prev_space = false
        end
        if _is_word_cp(cp):
            c.flags |= _CF_WORD
        end
        p.chars.set(i, c)
        shape_cps.push(scp)
        i++
    end
    if not pre:
        mut j := n - 1
        until j >= 0 and _cf(p, j, _CF_SPACE):
            mut c := p.chars.get(j)
            c.flags |= _CF_HIDDEN
            p.chars.set(j, c)
            j--
        end
    end
end

func _make_runs(p &: Paragraph, fc &: FontCollection, shape_cps &: Vector<int>, scripts &: Vector<int>):
    n := p.chars.Len()
    mut gs := Vector {} as Vector<bool>
    defer gs.Free()
    _grapheme_starts(shape_cps, gs)
    mut face := -1
    mut i := 0
    until i < n:
        mut e := i + 1
        until e < n and not gs.get(e):
            e++
        end
        sp := p.spans.get(p.chars.get(i).span)
        if not _cf(p, i, _CF_HIDDEN) or face < 0:
            f2 := _pick_face(fc, sp, shape_cps, i, e, face)
            if f2 >= 0:
                face = f2
            end
        end
        mut k := i
        until k < e:
            mut c := p.chars.get(k)
            c.face = face
            if k == i:
                c.flags |= _CF_GSTART
            end
            p.chars.set(k, c)
            k++
        end
        i = e
    end
    mut j := 0
    mut first_face := -1
    until j < n and first_face < 0:
        first_face = p.chars.get(j).face
        j++
    end
    i = 0
    until i < n:
        mut c := p.chars.get(i)
        if c.face < 0:
            c.face = first_face
            p.chars.set(i, c)
        end
        i++
    end
    mut s := 0
    until s < n:
        c0 := p.chars.get(s)
        mut e := s + 1
        until e < n:
            ce := p.chars.get(e)
            if _cf(p, e - 1, _CF_HARD):
                break
            end
            if ce.span != c0.span or ce.level != c0.level or (ce.face != c0.face and (ce.flags & _CF_HIDDEN) == 0) or scripts.get(e) != scripts.get(s):
                break
            end
            e++
        end
        mut r := ShapedRun {}
        r.cp_start = s
        r.cp_end = e
        r.level = c0.level
        r.face = c0.face
        r.span = c0.span
        r.size64 = _to26(p.spans.get(c0.span).size)
        p.runs.push(r)
        s = e
    end
end

func _shape_runs(p &: Paragraph, fc &: FontCollection, shape_cps &: Vector<int>, scripts &: Vector<int>):
    n := p.chars.Len()
    mut forms := Vector {} as Vector<int>
    defer forms.Free()
    forms.zeros(n)
    _joining_forms(shape_cps, 0, n, forms)
    mut skip := Vector {} as Vector<bool>
    defer skip.Free()
    mut i := 0
    until i < n:
        skip.push(_cf(p, i, _CF_HIDDEN))
        i++
    end
    mut ri := 0
    until ri < p.runs.Len():
        mut r := p.runs.get(ri)
        r.glyph_start = p.glyphs.Len()
        sp := p.spans.get(r.span)
        f := FaceFont(fc, r.face)
        if FontValid(f):
            mut lang := sp.lang
            if str.Len(lang) == 0:
                lang = p.style.lang
            end
            mut off := 0
            ls := _to26(sp.letter_spacing)
            ws := _to26(sp.word_spacing)
            if ls != 0:
                off = (1 << _FB_LIGA) | (1 << _FB_CLIG) | (1 << _FB_CALT)
            end
            mut b := _Buf {}
            _shape_buf(f, shape_cps, forms, skip, r.cp_start, r.cp_end, (r.level % 2) == 1, _opentype_script_tag(scripts.get(r.cp_start)), _lang_tag(lang), off, b)
            mut last_cp := -1
            mut q := 0
            until q < b.g.Len():
                if b.att.get(q) != -2:
                    mut g := ParagraphGlyph {}
                    g.id = b.g.get(q)
                    g.cp = b.cl.get(q)
                    g.advance = _scale26(b.xa.get(q), r.size64, f.units_per_em)
                    g.x_offset = _scale26(b.xo.get(q), r.size64, f.units_per_em)
                    g.y_offset = _scale26(b.yo.get(q), r.size64, f.units_per_em)
                    if g.cp != last_cp:
                        if ls != 0 and _cf(p, g.cp, _CF_GSTART):
                            g.advance += ls
                        end
                        if ws != 0 and _cf(p, g.cp, _CF_SPACE):
                            g.advance += ws
                        end
                        last_cp = g.cp
                    end
                    p.glyphs.push(g)
                end
                q++
            end
            _buf_free(b)
        end
        r.glyph_end = p.glyphs.Len()
        p.runs.set(ri, r)
        ri++
    end
    mut has_glyph := Vector {} as Vector<bool>
    defer has_glyph.Free()
    i = 0
    until i < n:
        has_glyph.push(false)
        i++
    end
    each g in p.glyphs:
        mut c := p.chars.get(g.cp)
        c.advance += g.advance
        p.chars.set(g.cp, c)
        has_glyph.set(g.cp, true)
    end
    each r in p.runs:
        mut k := r.cp_start
        until k < r.cp_end:
            if not has_glyph.get(k):
                k++
                continue
            end
            mut e := k + 1
            until e < r.cp_end and not has_glyph.get(e):
                e++
            end
            mut count := 0
            mut q := k
            until q < e:
                if _cf(p, q, _CF_GSTART) and not _cf(p, q, _CF_HIDDEN):
                    count++
                end
                q++
            end
            if count > 1:
                total := p.chars.get(k).advance
                each_part := total / count
                mut left := total
                mut seen := 0
                q = k
                until q < e:
                    if _cf(p, q, _CF_GSTART) and not _cf(p, q, _CF_HIDDEN):
                        seen++
                        mut c := p.chars.get(q)
                        if seen == count:
                            c.advance = left
                        else:
                            c.advance = each_part
                            left -= each_part
                        end
                        p.chars.set(q, c)
                    end
                    q++
                end
            end
            k = e
        end
    end
end

func _breaks(p &: Paragraph, shape_cps &: Vector<int>):
    mut brk := Vector {} as Vector<int>
    defer brk.Free()
    _line_breaks(shape_cps, brk)
    wraps := _ws_wraps(p.style.white_space)
    n := p.chars.Len()
    mut i := 0
    until i < n:
        mut c := p.chars.get(i)
        mut b := brk.get(i)
        if i > 0 and _cf(p, i - 1, _CF_HARD):
            b = _BRK_MUST
        else b == _BRK_MUST:
            b = _BRK_ALLOW
        end
        if b == _BRK_ALLOW and (not wraps or (c.flags & _CF_GSTART) == 0):
            b = _BRK_NONE
        end
        c.brk = b
        p.chars.set(i, c)
        i++
    end
end

func _content_end(p: Paragraph, s: int, e: int): int:
    mut k := e
    until k > s and (_cf(p, k - 1, _CF_SPACE) or _cf(p, k - 1, _CF_HIDDEN)):
        k--
    end
    ret k
end

func _width(p: Paragraph, s: int, e: int): int:
    mut w := 0
    mut k := s
    until k < e:
        w += p.chars.get(k).advance
        k++
    end
    ret w
end

func _intrinsic(p &: Paragraph):
    n := p.chars.Len()
    anywhere := p.style.overflow_wrap == OverflowWrap.Anywhere
    mut maxw := 0
    mut minw := 0
    mut line_s := 0
    mut piece_s := 0
    mut i := 1
    until i <= n:
        b := i == n ? _BRK_MUST : p.chars.get(i).brk
        if b != _BRK_NONE:
            cw := _width(p, piece_s, _content_end(p, piece_s, i))
            if cw > minw and not anywhere:
                minw = cw
            end
            piece_s = i
        end
        if b == _BRK_MUST:
            lw := _width(p, line_s, _content_end(p, line_s, i))
            if lw > maxw:
                maxw = lw
            end
            line_s = i
        end
        i++
    end
    if anywhere:
        mut g := 0
        mut k := 0
        until k < n:
            if _cf(p, k, _CF_GSTART) and not _cf(p, k, _CF_SPACE):
                g = 0
            end
            g += _cf(p, k, _CF_SPACE) ? 0 : p.chars.get(k).advance
            if g > minw:
                minw = g
            end
            k++
        end
    end
    if minw > maxw:
        minw = maxw
    end
    p.min_content = minw
    p.max_content = maxw
end

@en "NewParagraph"
@fa "بند تازه"
pub func NewParagraph(fc &: FontCollection, spans: Vector<TextSpan>, style: ParagraphStyle): Paragraph:
    mut p := Paragraph {}
    p.style = style
    each sp in spans:
        p.spans.push(sp)
    end
    if p.spans.Len() == 0:
        p.spans.push(TextSpan {})
    end
    _decode_spans(p)
    mut shape_cps := Vector {} as Vector<int>
    defer shape_cps.Free()
    _white_space(p, shape_cps)
    _para_levels(p, shape_cps)
    mut scripts := Vector {} as Vector<int>
    defer scripts.Free()
    _resolve_scripts(shape_cps, scripts)
    _make_runs(p, fc, shape_cps, scripts)
    _shape_runs(p, fc, shape_cps, scripts)
    _breaks(p, shape_cps)
    _intrinsic(p)
    ret p
end

@en "MinContentWidth"
@fa "پهنای کمینه محتوا"
pub func MinContentWidth(p: Paragraph): f64:
    ret _from26(p.min_content)
end

@en "MaxContentWidth"
@fa "پهنای بیشینه محتوا"
pub func MaxContentWidth(p: Paragraph): f64:
    ret _from26(p.max_content)
end

@en "SpanAt"
@fa "تکه جای"
pub func SpanAt(p: Paragraph, offset: int): int:
    mut i := p.span_starts.Len() - 1
    until i > 0 and p.span_starts.get(i) > offset:
        i--
    end
    ret i
end

@en "FreeParagraph"
@fa "آزادسازی بند"
pub func FreeParagraph(p &: Paragraph):
    p.spans.Free()
    p.span_starts.Free()
    p.chars.Free()
    p.runs.Free()
    p.glyphs.Free()
    mem.Free(p.text as void*)
    p.text = ""
    p.spans = Vector {} as Vector<TextSpan>
    p.span_starts = Vector {} as Vector<int>
    p.chars = Vector {} as Vector<CharInfo>
    p.runs = Vector {} as Vector<ShapedRun>
    p.glyphs = Vector {} as Vector<ParagraphGlyph>
end
