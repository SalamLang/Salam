    @en "families"
    @fa "خانواده‌های قلم"
    pub families: str = "sans-serif"
    @en "size"
    @fa "اندازه"
    pub size: f64 = 16.0
    @en "weight"
    @fa "وزن"
    pub weight: int = 400
    @en "italic"
    @fa "مورب"
    pub italic: bool = false
    @en "letter_spacing"
    @fa "فاصله حرف‌ها"
    pub letter_spacing: f64 = 0.0
    @en "word_spacing"
    @fa "فاصله واژه‌ها"
    pub word_spacing: f64 = 0.0
    @en "line_height"
    @fa "بلندی خط"
