package typeset

import str
import math
import mem
import bidi
import unicode

const _CF_HIDDEN := 1
const _CF_HARD := 2
const _CF_GSTART := 4
const _CF_SPACE := 8
const _CF_WORD := 16

@en "TextAlign"
@fa "چینش متن"
pub enum TextAlign:
    @en "Start"
    @fa "آغاز"
    Start
    @en "End"
    @fa "انتها"
    End
    @en "Left"
    @fa "چپ"
    Left
    @en "Right"
    @fa "راست"
    Right
    @en "Center"
    @fa "وسط"
    Center
    @en "Justify"
    @fa "تمام‌چین"
    Justify
end

@en "WhiteSpace"
@fa "فاصله سفید"
pub enum WhiteSpace:
    @en "Normal"
    @fa "معمولی"
    Normal
    @en "NoWrap"
    @fa "بی شکستن"
    NoWrap
    @en "Pre"
    @fa "پیش‌قالب"
    Pre
    @en "PreWrap"
    @fa "پیش‌قالب با شکستن"
    PreWrap
end

@en "OverflowWrap"
@fa "شکستن سرریز"
pub enum OverflowWrap:
    @en "Normal"
    @fa "عادی"
    Normal
    @en "Anywhere"
    @fa "هرجا"
    Anywhere
    @en "BreakWord"
    @fa "شکستن واژه"
    BreakWord
end

