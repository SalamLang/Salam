package typeset

import str
import unicode

const _JT_U := 0
const _JT_R := 1
const _JT_D := 2
const _JT_C := 3
const _JT_T := 4

const _FORM_NONE := 0
const _FORM_ISOL := 1
const _FORM_FINA := 2
const _FORM_MEDI := 3
const _FORM_INIT := 4

const _FB_CCMP := 0
const _FB_LOCL := 1
const _FB_ISOL := 2
const _FB_FINA := 3
const _FB_MEDI := 4
const _FB_INIT := 5
const _FB_RLIG := 6
const _FB_CALT := 7
const _FB_LIGA := 8
const _FB_CLIG := 9
const _FB_RCLT := 10
const _FB_KERN := 11
const _FB_MARK := 12
const _FB_MKMK := 13
const _FB_ABVM := 14
const _FB_BLWM := 15
const _FB_DIST := 16
const _FB_RTLA := 17
const _FB_COUNT := 18

@en "ShapedGlyph"
@fa "گلیف شکل‌یافته"
pub struct ShapedGlyph:
    @en "id"
    @fa "شناسه"
    pub id: int = 0
    @en "cluster"
    @fa "خوشه"
    pub cluster: int = 0
    @en "x_advance"
    @fa "پیشروی افقی"
    pub x_advance: int = 0
    @en "x_offset"
    @fa "جابجایی افقی"
    pub x_offset: int = 0
    @en "y_offset"
    @fa "جابجایی عمودی"
    pub y_offset: int = 0
end

func _feat_tag(bit: int): int:
    switch bit:
        _FB_CCMP: ret _tag("ccmp") end
        _FB_LOCL: ret _tag("locl") end
        _FB_ISOL: ret _tag("isol") end
        _FB_FINA: ret _tag("fina") end
        _FB_MEDI: ret _tag("medi") end
        _FB_INIT: ret _tag("init") end
        _FB_RLIG: ret _tag("rlig") end
        _FB_CALT: ret _tag("calt") end
        _FB_LIGA: ret _tag("liga") end
        _FB_CLIG: ret _tag("clig") end
        _FB_RCLT: ret _tag("rclt") end
        _FB_KERN: ret _tag("kern") end
        _FB_MARK: ret _tag("mark") end
        _FB_MKMK: ret _tag("mkmk") end
        _FB_ABVM: ret _tag("abvm") end
        _FB_BLWM: ret _tag("blwm") end
        _FB_DIST: ret _tag("dist") end
        _FB_RTLA: ret _tag("rtla") end
        else: ret 0 end
    end
    ret 0
end

func _jt_range(cp: int, lo: int, hi: int): bool:
    ret cp >= lo and cp <= hi
end

func _joining_type(cp: int): int:
    if cp == 0x200D or cp == 0x0640 or cp == 0x07FA: ret _JT_C end
    if cp == 0x200C: ret _JT_U end
    if cp >= 0x0600 and cp <= 0x06FF:
        if _jt_range(cp, 0x0610, 0x061A) or _jt_range(cp, 0x064B, 0x065F) or cp == 0x0670: ret _JT_T end
        if _jt_range(cp, 0x06D6, 0x06DC) or _jt_range(cp, 0x06DF, 0x06E4) or _jt_range(cp, 0x06E7, 0x06E8) or _jt_range(cp, 0x06EA, 0x06ED): ret _JT_T end
        if cp == 0x0620 or cp == 0x0626 or cp == 0x0628 or _jt_range(cp, 0x062A, 0x062E): ret _JT_D end
        if _jt_range(cp, 0x0622, 0x0625) or cp == 0x0627 or cp == 0x0629 or _jt_range(cp, 0x062F, 0x0632): ret _JT_R end
        if _jt_range(cp, 0x0633, 0x063F) or _jt_range(cp, 0x0641, 0x0647) or _jt_range(cp, 0x0649, 0x064A): ret _JT_D end
        if cp == 0x0648: ret _JT_R end
        if _jt_range(cp, 0x066E, 0x066F) or _jt_range(cp, 0x0678, 0x0687) or _jt_range(cp, 0x069A, 0x06BF): ret _JT_D end
        if _jt_range(cp, 0x0671, 0x0673) or _jt_range(cp, 0x0675, 0x0677) or _jt_range(cp, 0x0688, 0x0699) or cp == 0x06C0: ret _JT_R end
        if _jt_range(cp, 0x06C1, 0x06C2) or cp == 0x06CC or cp == 0x06CE or _jt_range(cp, 0x06D0, 0x06D1): ret _JT_D end
        if _jt_range(cp, 0x06C3, 0x06CB) or cp == 0x06CD or cp == 0x06CF or _jt_range(cp, 0x06D2, 0x06D3) or cp == 0x06D5: ret _JT_R end
        if _jt_range(cp, 0x06EE, 0x06EF): ret _JT_R end
        if _jt_range(cp, 0x06FA, 0x06FC) or cp == 0x06FF: ret _JT_D end
        ret _JT_U
    end
    if cp >= 0x0750 and cp <= 0x077F:
        if _jt_range(cp, 0x0759, 0x075B) or _jt_range(cp, 0x076B, 0x076C) or cp == 0x0771 or _jt_range(cp, 0x0773, 0x0774) or _jt_range(cp, 0x0778, 0x0779): ret _JT_R end
        ret _JT_D
    end
    if cp >= 0x08A0 and cp <= 0x08C9:
        if _jt_range(cp, 0x08AA, 0x08AC) or cp == 0x08AE or _jt_range(cp, 0x08B1, 0x08B2) or cp == 0x08B9: ret _JT_R end
        if cp == 0x08AD: ret _JT_U end
        ret _JT_D
    end
    if cp >= 0x08CA and cp <= 0x08FF: ret _JT_T end
    if cp < 0x0300:
        ret _JT_U
    end
    cat := unicode.Category(cp)
    if unicode.IsMark(cp) or (unicode.IsFormat(cp) and cat >= 0):
        ret _JT_T
    end
    ret _JT_U
end

func _joining_forms(cps &: Vector<int>, s: int, e: int, forms &: Vector<int>):
    mut prev := -1
    mut prev_t := _JT_U
    mut i := s
    until i < e:
        t := _joining_type(cps.get(i))
        if t == _JT_T:
            forms.set(i, _FORM_NONE)
            i++
            continue
        end
        if prev >= 0 and (prev_t == _JT_D or prev_t == _JT_C) and (t == _JT_D or t == _JT_R or t == _JT_C):
            pf := forms.get(prev)
            if pf == _FORM_ISOL:
                forms.set(prev, _FORM_INIT)
            else pf == _FORM_FINA:
                forms.set(prev, _FORM_MEDI)
            end
            forms.set(i, (t == _JT_U) ? _FORM_NONE : _FORM_FINA)
        else:
            forms.set(i, (t == _JT_U) ? _FORM_NONE : _FORM_ISOL)
        end
        if t == _JT_C and forms.get(i) == _FORM_FINA:
            forms.set(i, _FORM_FINA)
        end
        prev = i
        prev_t = t
        i++
    end
end

func _is_default_ignorable(cp: int): bool:
    if cp == 0x00AD or cp == 0x034F or cp == 0x061C or cp == 0x3164 or cp == 0xFEFF or cp == 0xFFA0: ret true end
    if cp >= 0x200B and cp <= 0x200F: ret true end
    if cp >= 0x202A and cp <= 0x202E: ret true end
    if cp >= 0x2060 and cp <= 0x206F: ret true end
    if cp >= 0xFE00 and cp <= 0xFE0F: ret true end
    if cp >= 0x180B and cp <= 0x180F: ret true end
    if cp >= 0xFFF0 and cp <= 0xFFF8: ret true end
    if cp >= 0xE0000 and cp <= 0xE0FFF: ret true end
    if cp == 0x115F or cp == 0x1160 or cp == 0x17B4 or cp == 0x17B5: ret true end
    ret false
end

func _ot_script_tag(sc: int): int:
    if sc == unicode.ScriptArabic: ret _tag("arab") end
    if sc == unicode.ScriptLatin: ret _tag("latn") end
    if sc == unicode.ScriptCyrillic: ret _tag("cyrl") end
    if sc == unicode.ScriptGreek: ret _tag("grek") end
    if sc == unicode.ScriptHebrew: ret _tag("hebr") end
    if sc == unicode.ScriptHan: ret _tag("hani") end
    if sc == unicode.ScriptHiragana or sc == unicode.ScriptKatakana: ret _tag("kana") end
    if sc == unicode.ScriptHangul: ret _tag("hang") end
    if sc == unicode.ScriptThai: ret _tag("thai") end
    if sc == unicode.ScriptArmenian: ret _tag("armn") end
    if sc == unicode.ScriptGeorgian: ret _tag("geor") end
    if sc == unicode.ScriptSyriac: ret _tag("syrc") end
    if sc == unicode.ScriptThaana: ret _tag("thaa") end
    ret _tag("DFLT")
end

func _lang_tag(lang: str): int:
    if str.Len(lang) < 2:
        ret 0
    end
    bp := lang as u8*
    c0 := (bp[0] as int) | 0x20
    c1 := (bp[1] as int) | 0x20
    code := (c0 << 8) | c1
    switch code:
        0x6661: ret _tag("FAR ") end
        0x6172: ret _tag("ARA ") end
        0x7572: ret _tag("URD ") end
        0x6B75: ret _tag("KUR ") end
        0x7073: ret _tag("PAS ") end
        0x7364: ret _tag("SND ") end
        0x7567: ret _tag("UYG ") end
        0x656E: ret _tag("ENG ") end
        0x6465: ret _tag("DEU ") end
        0x6672: ret _tag("FRA ") end
        0x7472: ret _tag("TRK ") end
        0x7275: ret _tag("RUS ") end
        else: ret 0 end
    end
    ret 0
end

func _stage_lookups(f: Font, table: int, langsys: int, bits: Vector<int>, idx &: Vector<int>, masks &: Vector<int>): bool:
    idx.clear()
    masks.clear()
    mut found := false
    mut tmp := Vector {} as Vector<int>
    defer tmp.free()
    each bit in bits:
        tmp.clear()
        if _feature_lookups(f, table, langsys, _feat_tag(bit), tmp):
            found = true
        end
        each li in tmp:
            mut k := 0
            mut merged := false
            until k < idx.len():
                if idx.get(k) == li:
                    masks.set(k, masks.get(k) | (1 << bit))
                    merged = true
                    break
                end
                k++
            end
            if not merged:
                mut at := idx.len()
                until at > 0 and idx.get(at - 1) > li:
                    at--
                end
                idx.insert(at, li)
                masks.insert(at, 1 << bit)
            end
        end
    end
    ret found
end

func _run_stage(f: Font, table: int, gsub: bool, langsys: int, bits: Vector<int>, b &: _Buf): bool:
    mut idx := Vector {} as Vector<int>
    mut masks := Vector {} as Vector<int>
    defer idx.free()
    defer masks.free()
    found := _stage_lookups(f, table, langsys, bits, idx, masks)
    mut k := 0
    until k < idx.len():
        _apply_lookup_pass(f, table, gsub, idx.get(k), masks.get(k), b)
        k++
    end
    ret found
end

func _has_feature(f: Font, table: int, langsys: int, bit: int): bool:
    mut tmp := Vector {} as Vector<int>
    defer tmp.free()
    ret _feature_lookups(f, table, langsys, _feat_tag(bit), tmp)
end

func _form_code(form: int): int:
    if form == _FORM_FINA: ret _AR_FINAL end
    if form == _FORM_INIT: ret _AR_INITIAL end
    if form == _FORM_MEDI: ret _AR_MEDIAL end
    ret _AR_ISOLATED
end

func _arabic_fallback(f: Font, b &: _Buf, forms &: Vector<int>):
    mut i := 0
    until i < b.g.len():
        cp := b.cp.get(i)
        form := forms.get(b.cl.get(i))
        if cp == 0x0644 and (form == _FORM_INIT or form == _FORM_MEDI):
            mut j := i + 1
            until j < b.g.len() and b.cls.get(j) == 3:
                j++
            end
            if j < b.g.len():
                lig := _arabic_lam_alef(cp, b.cp.get(j))
                if lig != 0:
                    mut lcp := lig
                    if form == _FORM_MEDI:
                        lcp = lig + 1
                    end
                    lg := GlyphIndex(f, lcp)
                    if lg != 0:
                        b.g.set(i, lg)
                        _buf_remove(b, j)
                        i++
                        continue
                    end
                end
            end
        end
        if form != _FORM_NONE:
            pf := _arabic_shaped(cp, _form_code(form))
            if pf != cp:
                pg := GlyphIndex(f, pf)
                if pg != 0:
                    b.g.set(i, pg)
                end
            end
        end
        i++
    end
end

func _bits(a: int, b: int, c: int, d: int): Vector<int>:
    mut v := Vector {} as Vector<int>
    if a >= 0: v.push(a) end
    if b >= 0: v.push(b) end
    if c >= 0: v.push(c) end
    if d >= 0: v.push(d) end
    ret v
end

func _gsub_all(f: Font, b &: _Buf, arabic: bool, langsys: int, forms &: Vector<int>):
    if arabic:
        mut st := _bits(_FB_CCMP, _FB_LOCL, -1, -1)
        _run_stage(f, f.gsub, true, langsys, st, b)
        st.free()
        joining := _has_feature(f, f.gsub, langsys, _FB_ISOL) or _has_feature(f, f.gsub, langsys, _FB_FINA) or _has_feature(f, f.gsub, langsys, _FB_INIT) or _has_feature(f, f.gsub, langsys, _FB_MEDI)
        if joining:
            each bit in [_FB_ISOL, _FB_FINA, _FB_MEDI, _FB_INIT]:
                mut one := _bits(bit, -1, -1, -1)
                _run_stage(f, f.gsub, true, langsys, one, b)
                one.free()
            end
        end
        mut rl := _bits(_FB_RLIG, -1, -1, -1)
        _run_stage(f, f.gsub, true, langsys, rl, b)
        rl.free()
        if not joining:
            _arabic_fallback(f, b, forms)
        end
        mut ca := _bits(_FB_RCLT, _FB_CALT, -1, -1)
        _run_stage(f, f.gsub, true, langsys, ca, b)
        ca.free()
        mut li := _bits(_FB_LIGA, _FB_CLIG, _FB_RTLA, -1)
        _run_stage(f, f.gsub, true, langsys, li, b)
        li.free()
        ret
    end
    mut all := _bits(_FB_CCMP, _FB_LOCL, _FB_RLIG, _FB_RTLA)
    all.push(_FB_CALT)
    all.push(_FB_LIGA)
    all.push(_FB_CLIG)
    all.push(_FB_RCLT)
    _run_stage(f, f.gsub, true, langsys, all, b)
    all.free()
end

func _legacy_kern(f: Font, b &: _Buf):
    mut i := 0
    until i < b.g.len():
        if b.cls.get(i) != 3:
            mut j := i + 1
            until j < b.g.len() and b.cls.get(j) == 3:
                j++
            end
            if j < b.g.len():
                b.xa.set(i, b.xa.get(i) + KernAdvance(f, b.g.get(i), b.g.get(j)))
            end
        end
        i++
    end
end

func _shape_buf(f: Font, cps &: Vector<int>, forms &: Vector<int>, skip &: Vector<bool>, s: int, e: int, rtl: bool, script_tag: int, lang_tag: int, off_mask: int, b &: _Buf):
    mut global := 0
    mut k := 0
    until k < _FB_COUNT:
        if k != _FB_ISOL and k != _FB_FINA and k != _FB_MEDI and k != _FB_INIT and (k != _FB_RTLA or rtl):
            global |= 1 << k
        end
        k++
    end
    global &= ~off_mask
    arabic := script_tag == _tag("arab")
    mut i := s
    until i < e:
        if skip.get(i):
            i++
            continue
        end
        cp := cps.get(i)
        mut use := cp
        if rtl:
            use = _bidi_mirror(cp)
        end
        mut g := GlyphIndex(f, use)
        if g == 0 and use != cp:
            g = GlyphIndex(f, cp)
        end
        mut mask := global
        fm := forms.get(i)
        if fm == _FORM_ISOL: mask |= 1 << _FB_ISOL end
        if fm == _FORM_FINA: mask |= 1 << _FB_FINA end
        if fm == _FORM_MEDI: mask |= 1 << _FB_MEDI end
        if fm == _FORM_INIT: mask |= 1 << _FB_INIT end
        _buf_push(b, g, i, cp, mask, _glyph_class(f, g, cp))
        i++
    end
    _normalize_run(f, b)
    if f.gsub != 0:
        _gsub_all(f, b, arabic, _langsys_off(f, f.gsub, script_tag, lang_tag), forms)
    else arabic:
        _arabic_fallback(f, b, forms)
    end
    mut q := 0
    until q < b.g.len():
        b.xa.set(q, GlyphAdvance(f, b.g.get(q)))
        q++
    end
    mut kerned := false
    if f.gpos != 0:
        gl := _langsys_off(f, f.gpos, script_tag, lang_tag)
        kerned = _has_feature(f, f.gpos, gl, _FB_KERN)
        mut pb := _bits(_FB_KERN, _FB_MARK, _FB_MKMK, _FB_DIST)
        pb.push(_FB_ABVM)
        pb.push(_FB_BLWM)
        _run_stage(f, f.gpos, false, gl, pb, b)
        pb.free()
    end
    if not kerned and f.kern != 0 and (off_mask & (1 << _FB_KERN)) == 0:
        _legacy_kern(f, b)
    end
    q = 0
    until q < b.g.len():
        if b.cls.get(q) == 3:
            b.xa.set(q, 0)
        end
        q++
    end
    q = 0
    until q < b.g.len():
        j := b.att.get(q)
        if j >= 0 and j < q:
            mut xo := b.xo.get(q) + b.xo.get(j)
            b.yo.set(q, b.yo.get(q) + b.yo.get(j))
            if not rtl:
                mut m := j
                until m < q:
                    xo -= b.xa.get(m)
                    m++
                end
            else:
                mut m := j + 1
                until m <= q:
                    xo += b.xa.get(m)
                    m++
                end
            end
            b.xo.set(q, xo)
        end
        q++
    end
    space := GlyphIndex(f, 32)
    q = 0
    until q < b.g.len():
        if _is_default_ignorable(b.cp.get(q)):
            b.g.set(q, space)
            b.xa.set(q, 0)
            b.xo.set(q, 0)
            b.yo.set(q, 0)
            b.att.set(q, -2)
        end
        q++
    end
end

func _modified_ccc(cp: int): int:
    if cp >= 0x064B and cp <= 0x0650:
        ret unicode.CombiningClass(cp) + 1
    end
    if cp == 0x0651:
        ret 27
    end
    ret unicode.CombiningClass(cp)
end

func _normalize_run(f: Font, b &: _Buf):
    mut i := 1
    until i < b.g.len():
        c := _modified_ccc(b.cp.get(i))
        if c != 0:
            mut j := i
            until j > 0 and _modified_ccc(b.cp.get(j - 1)) > c:
                j--
            end
            if j < i:
                cp := b.cp.get(i)
                cl := b.cl.get(i)
                m := b.mask.get(i)
                k := b.cls.get(i)
                gg := b.g.get(i)
                mut low := cl
                mut q := j
                until q < i:
                    if b.cl.get(q) < low:
                        low = b.cl.get(q)
                    end
                    q++
                end
                _buf_remove(b, i)
                _buf_insert_at(b, j, gg, cl, cp, m, k)
                q = j
                until q <= i:
                    b.cl.set(q, low)
                    q++
                end
            end
        end
        i++
    end
    i = 1
    until i < b.g.len():
        if _modified_ccc(b.cp.get(i)) != 0 and _modified_ccc(b.cp.get(i - 1)) == 0:
            comp := unicode.Compose(b.cp.get(i - 1), b.cp.get(i))
            if comp > 0:
                cg := GlyphIndex(f, comp)
                if cg != 0:
                    b.cp.set(i - 1, comp)
                    b.g.set(i - 1, cg)
                    b.cls.set(i - 1, _glyph_class(f, cg, comp))
                    _buf_remove(b, i)
                    continue
                end
            end
        end
        i++
    end
end

func _auto_script(cps &: Vector<int>): int:
    each cp in cps:
        sc := unicode.Script(cp)
        if sc != unicode.ScriptCommon and sc != unicode.ScriptInherited and sc != unicode.ScriptUnknown:
            ret sc
        end
    end
    ret unicode.ScriptLatin
end

@en "ShapeText"
@fa "شکل‌دهی متن"
pub func ShapeText(f: Font, text: str, rtl: bool, script: str, lang: str): Vector<ShapedGlyph>:
    mut out := Vector {} as Vector<ShapedGlyph>
    if not FontValid(f):
        ret out
    end
    mut cps := Vector {} as Vector<int>
    mut offs := Vector {} as Vector<int>
    defer cps.free()
    defer offs.free()
    n := str.Len(text)
    bp := text as u8*
    mut i := 0
    until i < n:
        offs.push(i)
        mut cp := 0
        i = _utf8_next(bp, n, i, cp)
        cps.push(cp)
    end
    mut forms := Vector {} as Vector<int>
    mut skip := Vector {} as Vector<bool>
    defer forms.free()
    defer skip.free()
    forms.zeros(cps.len())
    repeat cps.len():
        skip.push(false)
    end
    _joining_forms(cps, 0, cps.len(), forms)
    mut stag := 0
    if str.Len(script) == 0:
        stag = _ot_script_tag(_auto_script(cps))
    else:
        stag = _tag(script)
    end
    mut b := _Buf {}
    _shape_buf(f, cps, forms, skip, 0, cps.len(), rtl, stag, _lang_tag(lang), 0, b)
    mut q := 0
    until q < b.g.len():
        mut sg := ShapedGlyph {}
        sg.id = b.g.get(q)
        sg.cluster = offs.get(b.cl.get(q))
        sg.x_advance = b.xa.get(q)
        sg.x_offset = b.xo.get(q)
        sg.y_offset = b.yo.get(q)
        if rtl:
            out.insert(0, sg)
        else:
            out.push(sg)
        end
        q++
    end
    _buf_free(b)
    ret out
end
