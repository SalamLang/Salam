package typeset

const _BIDI_MAX_PAIRS := 63

func _bidi_bracket_close(cp: int): int:
    if cp == 0x28: ret 0x29 end
    if cp == 0x5B: ret 0x5D end
    if cp == 0x7B: ret 0x7D end
    if cp == 0x2045: ret 0x2046 end
    if cp == 0x2308: ret 0x2309 end
    if cp == 0x230A: ret 0x230B end
    if cp == 0x3008: ret 0x3009 end
    if cp == 0x300A: ret 0x300B end
    if cp == 0x300C: ret 0x300D end
    if cp == 0x300E: ret 0x300F end
    if cp == 0x3010: ret 0x3011 end
    if cp == 0x3014: ret 0x3015 end
    if cp == 0x3016: ret 0x3017 end
    if cp == 0x3018: ret 0x3019 end
    if cp == 0x301A: ret 0x301B end
    if cp == 0xFF08: ret 0xFF09 end
    if cp == 0xFF3B: ret 0xFF3D end
    if cp == 0xFF5B: ret 0xFF5D end
    ret 0
end

func _bidi_strong_of(c: int): int:
    if c == _BC_L: ret _BC_L end
    if c == _BC_R or c == _BC_EN or c == _BC_AN: ret _BC_R end
    ret 0 - 1
end

func _bidi_find_pairs(cps &: Vector<int>, classes &: Vector<int>, opens &: Vector<int>, closes &: Vector<int>):
    mut stack_close := Vector {} as Vector<int>
    mut stack_pos := Vector {} as Vector<int>
    mut i := 0
    until i < cps.Len():
        if classes.Get(i) == _BC_ON:
            cp := cps.Get(i)
            closer := _bidi_bracket_close(cp)
            if closer != 0:
                if stack_close.Len() >= _BIDI_MAX_PAIRS:
                    break
                end
                stack_close.Push(closer)
                stack_pos.Push(i)
            else:
                mut k := stack_close.Len() - 1
                until k >= 0:
                    if stack_close.Get(k) == cp:
                        opens.Push(stack_pos.Get(k))
                        closes.Push(i)
                        until stack_close.Len() <= k:
                            stack_close.Pop()
                            stack_pos.Pop()
                        end
                        break
                    end
                    k--
                end
            end
        end
        i++
    end
    stack_close.Free()
    stack_pos.Free()
    mut a := 1
    until a < opens.Len():
        o := opens.Get(a)
        c := closes.Get(a)
        mut b := a - 1
        until b >= 0 and opens.Get(b) > o:
            opens.Set(b + 1, opens.Get(b))
            closes.Set(b + 1, closes.Get(b))
            b--
        end
        opens.Set(b + 1, o)
        closes.Set(b + 1, c)
        a++
    end
end

func _bidi_inside_strong(classes &: Vector<int>, open: int, close: int, e: int): int:
    mut found_opposite := false
    mut i := open + 1
    until i < close:
        s := _bidi_strong_of(classes.Get(i))
        if s == e:
            ret e
        end
        if s >= 0:
            found_opposite = true
        end
        i++
    end
    if found_opposite:
        if e == _BC_L: ret _BC_R end
        ret _BC_L
    end
    ret 0 - 1
end

func _bidi_before_strong(classes &: Vector<int>, open: int, base: int): int:
    mut i := open - 1
    until i >= 0:
        s := _bidi_strong_of(classes.Get(i))
        if s >= 0:
            ret s
        end
        i--
    end
    if base == 1:
        ret _BC_R
    end
    ret _BC_L
end

func _bidi_resolve_pairs(cps &: Vector<int>, classes &: Vector<int>, base: int):
    mut e := _BC_L
    if base == 1:
        e = _BC_R
    end
    mut opens := Vector {} as Vector<int>
    mut closes := Vector {} as Vector<int>
    _bidi_find_pairs(cps, classes, opens, closes)
    mut i := 0
    until i < opens.Len():
        open := opens.Get(i)
        close := closes.Get(i)
        inside := _bidi_inside_strong(classes, open, close, e)
        if inside == e:
            classes.Set(open, e)
            classes.Set(close, e)
        else if inside >= 0:
            if _bidi_before_strong(classes, open, base) == inside:
                classes.Set(open, inside)
                classes.Set(close, inside)
            else:
                classes.Set(open, e)
                classes.Set(close, e)
            end
        end
        i++
    end
    opens.Free()
    closes.Free()
end
