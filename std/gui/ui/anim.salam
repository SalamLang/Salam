package ui

import gui.reactive
import gui.style

func _transition_for(s: style.Style, prop: int, out &: style.Transition): bool:
    if s.transition.len() == 0:
        ret false
    end
    if s.transition_props.len() == 0:
        out = s.transition[0]
        ret true
    end
    repeat s.transition_props.len() in i:
        if s.transition_props[i] == prop and i < s.transition.len():
            out = s.transition[i]
            ret true
        end
    end
    ret false
end

func _now(): i64:
    ret reactive.Now()
end

func _anim_index(node: int, prop: int): int:
    repeat _e.anims.len() in i:
        a := _e.anims[i]
        if a.node == node and a.prop == prop and not a.done:
            ret i
        end
    end
    ret -1
end

func _anim_progress(a: _Anim): f64:
    el := (_now() - a.start) as f64 - a.delay
    if el <= 0.0:
        ret 0.0
    end
    if a.duration <= 0.0 or el >= a.duration:
        ret 1.0
    end
    ret style.EaseAt(a.ease, el / a.duration)
end

func _anim_start(node: int, old: style.Style, target: style.Style):
    repeat style.PROP_COUNT in prop:
        if not style.Animatable(prop):
            continue
        end
        mut tr := style.Transition {}
        if not _transition_for(target, prop, tr) or tr.duration <= 0.0:
            continue
        end
        ov := style.Get(old, prop)
        nv := style.Get(target, prop)
        if style.Format(prop, ov) == style.Format(prop, nv):
            continue
        end
        k := _anim_index(node, prop)
        mut from := ov
        if k >= 0:
            a := _e.anims[k]
            t := _anim_progress(a)
            from = style.Lerp(prop, a.from, a.to, t)
            mut old_a := _e.anims.ref(k)
            old_a.done = true
        end
        _e.anims.push(_Anim { node = node, uid = _e.ctl[node].uid, prop = prop, start = _now(), duration = tr.duration, delay = tr.delay, ease = tr.easing, from = from, to = nv })
    end
end

func _anim_apply(node: int, s &: style.Style):
    if _e.anims.len() == 0:
        ret
    end
    repeat _e.anims.len() in i:
        a := _e.anims[i]
        if a.node != node or a.done:
            continue
        end
        t := _anim_progress(a)
        if t >= 1.0:
            continue
        end
        v := style.Lerp(a.prop, a.from, a.to, t)
        style.Set(s, a.prop, v)
    end
end

func _anims_running(): bool:
    mut any := false
    repeat _e.anims.len() in i:
        a := _e.anims[i]
        if not a.done:
            if (_now() - a.start) as f64 >= a.delay + a.duration:
                mut ak := _e.anims.ref(i)
                ak.done = true
                _damage_node(a.node)
            else:
                any = true
                _damage_node(a.node)
            end
        end
    end
    if not any and _e.anims.len() > 0:
        _e.anims.clear()
    end
    ret any
end
