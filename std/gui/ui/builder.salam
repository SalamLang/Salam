package ui

import str
import gui.paint
import gui.style
import gui.window

@en "Patch"
@fa "وصله‌سبک"
pub struct Patch:
    @en "props"
    @fa "ویژگی‌ها"
    pub props: Vector<int> = Vector {} as Vector<int>
    @en "values"
    @fa "مقدارها"
    pub values: Vector<style.Value> = Vector {} as Vector<style.Value>

    @en "Add"
    @fa "بیفزا"
    pub func Add(prop: int, v: style.Value):
        this.props.Push(prop)
        this.values.Push(v)
    end

    @en "Len"
    @fa "طول"
    pub func Len(): int:
        ret this.props.Len()
    end
end

@en "Builder"
@fa "سازنده‌صفحه"
pub struct Builder:
    n: int = 0

    @en "Title"
    @fa "عنوان صفحه"
    pub func Title(s: str):
        _sfree(_bd.title)
        _bd.title = str.Clone(s)
    end

    @en "Lang"
    @fa "زبان صفحه"
    pub func Lang(s: str):
        _sfree(_bd.lang)
        _bd.lang = str.Clone(s)
    end

    @en "Dir"
    @fa "جهت صفحه"
    pub func Dir(s: str):
        _sfree(_bd.dir)
        _bd.dir = str.Clone(s)
    end

    @en "Open"
    @fa "گشودن عنصر"
    pub func Open(kind: str):
        n := _new_node(_bd, kind, _b_top())
        _bstack.Push(n)
    end

    @en "Patch"
    @fa "وصله عنصر"
    pub func Patch(state: int, id: int):
        if id < 0 or id >= _patches.Len() or state < 0 or state >= _STATES:
            ret
        end
        mut nd := _bd.nodes.Ref(_b_top())
        nd.pst.Push(state)
        nd.pid.Push(id)
        nd.smask |= 1 << state
    end

    @en "Set"
    @fa "تنظیم سبک"
    pub func Set(state: int, prop: int, v: style.Value):
        if prop < 0 or prop >= style.PROP_COUNT or state < 0 or state >= _STATES:
            ret
        end
        mut nd := _bd.nodes.Ref(_b_top())
        nd.dst.Push(state)
        nd.dprop.Push(prop)
        nd.dval.Push(v)
        nd.smask |= 1 << state
    end

    @en "SetText"
    @fa "تنظیم سبک متنی"
    pub func SetText(state: int, prop: int, text: str):
        if prop < 0 or prop >= style.PROP_COUNT:
            ret
        end
        mut v := style.Value {}
        if style.Parse(prop, text, v):
            this.Set(state, prop, v)
        else:
            println "ui: " + style.PropName(prop) + " = \"" + text + "\": " + style.Error(prop, text)
        end
    end

    @en "Id"
    @fa "شناسه عنصر"
    pub func Id(s: str):
        _set_attr(_bd, _b_top(), "id", s)
    end

    @en "Key"
    @fa "کلید عنصر"
    pub func Key(s: str):
        _set_attr(_bd, _b_top(), "key", s)
    end

    @en "Attr"
    @fa "ویژگی عنصر"
    pub func Attr(name: str, value: str):
        _set_attr(_bd, _b_top(), name, value)
    end

    @en "BoolAttr"
    @fa "ویژگی دودویی عنصر"
    pub func BoolAttr(name: str, value: bool):
        if value:
            _set_attr(_bd, _b_top(), name, "")
        end
    end

    @en "Text"
    @fa "متن فرزند"
    pub func Text(s: str):
        _add_text(_bd, _b_top(), s)
    end

    @en "On"
    @fa "رسیدگی رخداد"
    pub func On(event: str, fn: func ()):
        _bd.ev_node.Push(_b_top())
        _bd.ev_kind.Push(str.Clone(event))
        _bd.ev_fn.Push(fn)
    end

    @en "Close"
    @fa "بستن عنصر"
    pub func Close():
        if _bstack.Len() > 1:
            _x := _bstack.Pop()
        end
    end

    @en "Scope"
    @fa "دامنه واکنشی"
    pub func Scope(site: int, fn: func (Builder)):
        _sc_open(site, "", fn)
    end

    @en "KeyedScope"
    @fa "دامنه کلیددار"
    pub func KeyedScope(site: int, key: str, fn: func (Builder)):
        _sc_open(site, key, fn)
    end

    @en "Reactive"
    @fa "راه اندازی واکنش"
    pub func Reactive(words: int, take: func (int) i64, sites: func ()):
        _sc_register(words, take, sites)
    end

    @en "Instance"
    @fa "نمونه بخش"
    pub func Instance(comp: int): int:
        ret _sc_instance(comp)
    end

    @en "Fresh"
    @fa "نمونه تازه"
    pub func Fresh(): bool:
        ret _sc_is_fresh()
    end
end

func _b_top(): int:
    if _bstack.Len() == 0:
        ret 0
    end
    ret _bstack[_bstack.Len() - 1]
end

func _b_begin():
    _bd = _Dom {}
    _bd.nodes = Vector {} as Vector<_Node>
    _bd.ev_node = Vector {} as Vector<int>
    _bd.ev_kind = Vector {} as Vector<str>
    _bd.ev_fn = Vector {} as Vector<func ()>
    root := _new_node(_bd, "page", -1)
    _bstack.Clear()
    _bstack.Push(root)
end

func _build_view(): _Dom:
    _b_begin()
    _sc_build_root(_e.view)
    nd := _bd
    _bd = _Dom {}
    _bstack.Clear()
    ret nd
end

func _page_setup(patches: func () Vector<Patch>, view: func (Builder)):
    _patches = patches()
    _sc_reset()
    _e.view = view
    _e.view_set = true
end

@en "NewPatch"
@fa "وصله تازه"
pub func NewPatch(): Patch:
    mut p := Patch {}
    p.props = Vector {} as Vector<int>
    p.values = Vector {} as Vector<style.Value>
    ret p
end

@en "NoPatches"
@fa "بی وصله"
pub func NoPatches(): Vector<Patch>:
    ret Vector {}
end

@en "RunPageWith"
@fa "اجرای صفحه با"
pub func RunPageWith(patches: func () Vector<Patch>, view: func (Builder), options: Options):
    if _e.ready:
        _free_engine()
        _e = _Engine {}
    end
    _page_setup(patches, view)
    nd := _build_view()
    if not _start_dom(nd, options):
        println "ui: cannot open a window:", window.LastError()
        ret
    end
    _run_loop()
end

@en "RunPage"
@fa "اجرای صفحه"
pub func RunPage(patches: func () Vector<Patch>, view: func (Builder)):
    RunPageWith(patches, view, Options {})
end

@en "RenderPage"
@fa "نگاره صفحه"
pub func RenderPage(patches: func () Vector<Patch>, view: func (Builder), width: int, height: int): paint.Canvas:
    ret RenderPageScaled(patches, view, width, height, 1.0)
end

@en "RenderPageScaled"
@fa "نگاره صفحه با مقیاس"
pub func RenderPageScaled(patches: func () Vector<Patch>, view: func (Builder), width: int, height: int, scale: f64): paint.Canvas:
    saved := _e
    _e = _Engine {}
    _page_setup(patches, view)
    nd := _build_view()
    _render_dom(nd, width, height, scale)
    out := _e.canvas
    _e.has_canvas = false
    _free_engine()
    _e = saved
    ret out
end

@en "DumpPage"
@fa "گزارش صفحه"
pub func DumpPage(patches: func () Vector<Patch>, view: func (Builder), width: int, height: int): str:
    saved := _e
    _e = _Engine {}
    _page_setup(patches, view)
    nd := _build_view()
    _render_dom(nd, width, height, 1.0)
    r := Dump()
    if _e.has_canvas:
        _e.canvas.Free()
        _e.has_canvas = false
    end
    _free_engine()
    _e = saved
    ret r
end
