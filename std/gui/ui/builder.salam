package ui

import str
import gui.css
import gui.paint
import gui.window

@en "Builder"
@fa "سازنده‌صفحه"
pub struct Builder:
    n: int = 0

    @en "Title"
    @fa "عنوان صفحه"
    pub func Title(s: str):
        _sfree(_bd.title)
        _bd.title = str.Clone(s)
    end

    @en "Lang"
    @fa "زبان صفحه"
    pub func Lang(s: str):
        _set_attr(_bd, _bd.html, "lang", s)
        _bd.lang = _attr(_bd, _bd.html, "lang")
    end

    @en "Dir"
    @fa "جهت صفحه"
    pub func Dir(s: str):
        _set_attr(_bd, _bd.html, "dir", s)
        _bd.dir = _attr(_bd, _bd.html, "dir")
    end

    @en "Open"
    @fa "گشودن عنصر"
    pub func Open(tag: str):
        mut parent := _b_top()
        if tag == "tr" and _bd.nodes[parent].tag == "table":
            pk := _bd.nodes[parent].kids
            if pk.len() > 0 and _bd.nodes[pk[pk.len() - 1]].tag == "tbody":
                parent = pk[pk.len() - 1]
            else:
                parent = _new_node(_bd, "tbody", parent)
            end
        end
        n := _new_node(_bd, tag, parent)
        _bstack.push(n)
    end

    @en "Decls"
    @fa "اعلان های عنصر"
    pub func Decls(base: int, hover: int, focus: int, active: int):
        mut nd := _bd.nodes.ref(_b_top())
        nd.d_base = base
        nd.d_hover = hover
        nd.d_focus = focus
        nd.d_active = active
    end

    @en "Dyn"
    @fa "سبک زمان اجرا"
    pub func Dyn(prop: str, value: str):
        id := css.DynDecl(_e.prog, prop, value)
        if id >= 0:
            mut nd := _bd.nodes.ref(_b_top())
            nd.dyn.push(id)
        end
    end

    @en "Id"
    @fa "شناسه عنصر"
    pub func Id(s: str):
        _set_attr(_bd, _b_top(), "id", s)
    end

    @en "Class"
    @fa "کلاس عنصر"
    pub func Class(s: str):
        top := _b_top()
        old := _attr(_bd, top, "class")
        if old.len() > 0:
            _set_attr(_bd, top, "class", old + " " + s)
        else:
            _set_attr(_bd, top, "class", s)
        end
    end

    @en "Key"
    @fa "کلید عنصر"
    pub func Key(s: str):
        _set_attr(_bd, _b_top(), "key", s)
    end

    @en "Attr"
    @fa "ویژگی عنصر"
    pub func Attr(name: str, value: str):
        _set_attr(_bd, _b_top(), name, value)
    end

    @en "BoolAttr"
    @fa "ویژگی دودویی عنصر"
    pub func BoolAttr(name: str, value: bool):
        if value:
            _set_attr(_bd, _b_top(), name, "")
        end
    end

    @en "Text"
    @fa "متن فرزند"
    pub func Text(s: str):
        _add_text(_bd, _b_top(), s)
    end

    @en "On"
    @fa "رسیدگی رخداد"
    pub func On(event: str, fn: func ()):
        _bd.ev_node.push(_b_top())
        _bd.ev_kind.push(str.Clone(event))
        _bd.ev_fn.push(fn)
    end

    @en "Close"
    @fa "بستن عنصر"
    pub func Close():
        if _bstack.len() > 1:
            _x := _bstack.pop()
        end
    end

    @en "Scope"
    @fa "دامنه واکنشی"
    pub func Scope(site: int, fn: func (Builder)):
        _sc_open(site, "", fn)
    end

    @en "KeyedScope"
    @fa "دامنه کلیددار"
    pub func KeyedScope(site: int, key: str, fn: func (Builder)):
        _sc_open(site, key, fn)
    end

    @en "Reactive"
    @fa "راه اندازی واکنش"
    pub func Reactive(words: int, take: func (int) i64, sites: func ()):
        _sc_register(words, take, sites)
    end

    @en "Instance"
    @fa "نمونه بخش"
    pub func Instance(comp: int): int:
        ret _sc_instance(comp)
    end

    @en "Fresh"
    @fa "نمونه تازه"
    pub func Fresh(): bool:
        ret _sc_is_fresh()
    end
end

func _b_top(): int:
    if _bstack.len() == 0:
        ret 0
    end
    ret _bstack[_bstack.len() - 1]
end

func _b_begin():
    _bd = _Dom {}
    _bd.nodes = Vector {} as Vector<_Node>
    root := _new_node(_bd, "#document", -1)
    html := _new_node(_bd, "html", root)
    head := _new_node(_bd, "head", html)
    body := _new_node(_bd, "body", html)
    _bd.html = html
    _bd.head = head
    _bd.body = body
    _bstack.clear()
    _bstack.push(body)
end

func _build_view(): _Dom:
    _b_begin()
    _sc_build_root(_e.cview)
    nd := _bd
    _bd = _Dom {}
    _bstack.clear()
    ret nd
end

func _compiled_setup(program: func () css.Program, view: func (Builder)):
    _e.prog = program()
    _sc_reset()
    _e.compiled = true
    _e.cview = view
    _e.view_set = true
end

@en "RunCompiledWith"
@fa "اجرای ترجمه شده با"
pub func RunCompiledWith(program: func () css.Program, view: func (Builder), options: Options):
    if _e.ready:
        _free_engine()
        _e = _Engine {}
    end
    _compiled_setup(program, view)
    nd := _build_view()
    if not _start_dom(nd, options):
        println "ui: cannot open a window:", window.LastError()
        ret
    end
    _run_loop()
end

@en "RunCompiled"
@fa "اجرای ترجمه شده"
pub func RunCompiled(program: func () css.Program, view: func (Builder)):
    RunCompiledWith(program, view, Options {})
end

@en "RenderCompiled"
@fa "نگاره ترجمه شده"
pub func RenderCompiled(program: func () css.Program, view: func (Builder), width: int, height: int): paint.Canvas:
    saved := _e
    _e = _Engine {}
    _compiled_setup(program, view)
    nd := _build_view()
    _render_dom(nd, width, height, 1.0)
    out := _e.canvas
    _e.has_canvas = false
    _free_engine()
    _e = saved
    ret out
end
