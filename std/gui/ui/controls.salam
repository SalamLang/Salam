package ui

import str
import math
import ai.image
import gui.css
import gui.paint
import gui.typeset

func _load_image(src: str, ok &: bool): paint.Canvas:
    mut path := src
    if path.starts_with("file://"):
        path = path.substr(7, path.len() - 7)
    end
    if path.starts_with("http:") or path.starts_with("https:") or path.starts_with("data:"):
        ok = false
        ret paint.Canvas {}
    end
    mut iok := false
    mut img := image.Open(path, iok)
    if not iok:
        image.Free(img)
        ok = false
        ret paint.Canvas {}
    end
    cv := paint.FromImage(img)
    image.Free(img)
    ok = true
    ret cv
end

func _option_nodes(node: int, out &: Vector<int>):
    each k in _e.dom.nodes[node].kids:
        t := _e.dom.nodes[k].tag
        if t == "option":
            out.push(k)
        else t == "optgroup":
            _option_nodes(k, out)
        end
    end
end

func _select_index(node: int): int:
    c := _e.ctl[node]
    if c.selected >= 0:
        ret c.selected
    end
    mut opts := Vector {} as Vector<int>
    defer opts.free()
    _option_nodes(node, opts)
    repeat opts.len() in i:
        if _has_attr(_e.dom, opts[i], "selected"):
            ret i
        end
    end
    ret opts.len() > 0 ? 0 : -1
end

func _option_value(opt: int): str:
    if _has_attr(_e.dom, opt, "value"):
        ret str.Clone(_attr(_e.dom, opt, "value"))
    end
    t := _text_of(_e.dom, opt)
    r := str.Trim(t)
    _sfree(t)
    ret r
end

func _control_value(node: int): str:
    c := _e.ctl[node]
    if c.has_value:
        ret c.value
    end
    tag := _e.dom.nodes[node].tag
    if tag == "textarea":
        ret _text_of(_e.dom, node)
    end
    if tag == "select":
        mut opts := Vector {} as Vector<int>
        defer opts.free()
        _option_nodes(node, opts)
        i := _select_index(node)
        if i >= 0 and i < opts.len():
            ret _option_value(opts[i])
        end
        ret ""
    end
    ret _attr(_e.dom, node, "value")
end

func _is_checked(node: int): bool:
    c := _e.ctl[node]
    if c.has_checked:
        ret c.checked
    end
    ret _has_attr(_e.dom, node, "checked")
end

func _control_shows_placeholder(node: int): bool:
    if not _is_text_input(node):
        ret false
    end
    v := _control_value(node)
    ret v.len() == 0 and _attr(_e.dom, node, "placeholder").len() > 0
end

func _bullets(v: str): str:
    mut b := str.NewBuilder()
    n := str.CharCount(v)
    repeat n:
        str.BufAppend(b, "•")
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func _control_text(node: int): str:
    tag := _e.dom.nodes[node].tag
    if tag == "select":
        mut opts := Vector {} as Vector<int>
        defer opts.free()
        _option_nodes(node, opts)
        i := _select_index(node)
        if i >= 0 and i < opts.len():
            t := _text_of(_e.dom, opts[i])
            r := str.Trim(t)
            _sfree(t)
            ret r
        end
        ret str.Clone("")
    end
    if _is_button_input(node):
        if _has_attr(_e.dom, node, "value"):
            ret str.Clone(_attr(_e.dom, node, "value"))
        end
        t := _input_type(node)
        ret str.Clone(t == "reset" ? "Reset" : (t == "submit" ? "Submit" : ""))
    end
    v := _control_value(node)
    if v.len() == 0:
        ret str.Clone(_attr(_e.dom, node, "placeholder"))
    end
    if tag == "input" and _input_type(node) == "password":
        ret _bullets(v)
    end
    ret str.Clone(v)
end

func _display_offset(node: int, off: int): int:
    if _e.dom.nodes[node].tag == "input" and _input_type(node) == "password":
        v := _control_value(node)
        n := str.CharCount(v.substr(0, off))
        ret n * 3
    end
    ret off
end

func _value_offset(node: int, doff: int): int:
    if _e.dom.nodes[node].tag == "input" and _input_type(node) == "password":
        v := _control_value(node)
        cps := doff / 3
        mut i := 0
        mut k := 0
        p := (v as void*) as u8*
        until i < v.len() and k < cps:
            i++
            until i < v.len() and (_hb(p, i) & 0xC0) == 0x80:
                i++
            end
            k++
        end
        ret i
    end
    ret doff
end

func _refresh_control(node: int):
    fi := _e.node_ifc[node]
    if fi < 0:
        ret
    end
    mut f := _e.ifcs.ref(fi)
    if f.spans.len() == 0:
        ret
    end
    mut sp := f.spans[0]
    if sp.text.len() > 0:
        _sfree(sp.text)
    end
    sp.text = _control_text(node)
    f.spans[0] = sp
    if f.has_para:
        typeset.FreeParagraph(f.para)
        f.has_para = false
    end
    if f.has_lay:
        typeset.FreeLayout(f.lay)
        f.has_lay = false
    end
    _ifc_layout(fi, _control_wrap_width(fi))
    _scroll_caret(node)
    _damage_node(node)
end

func _control_wrap_width(fi: int): f64:
    f := _e.ifcs[fi]
    if _e.dom.nodes[f.owner].tag == "textarea":
        ret f.w
    end
    ret 0.0
end

func _scroll_caret(node: int):
    if node < 0 or node >= _e.node_ifc.len() or node >= _e.ctl.len():
        ret
    end
    fi := _e.node_ifc[node]
    if fi < 0 or not _e.ifcs[fi].has_lay:
        ret
    end
    f := _e.ifcs[fi]
    if _e.dom.nodes[node].tag == "textarea":
        ret
    end
    c := _e.ctl[node]
    mut x := 0.0
    if not _control_shows_placeholder(node):
        r := typeset.CaretRect(f.para, f.lay, typeset.TextPosition { offset = _display_offset(node, c.caret) })
        x = r.x
    end
    mut sc := c.text_scroll
    if x - sc > f.w - 1.0:
        sc = x - f.w + 1.0
    end
    if x - sc < 0.0:
        sc = x
    end
    maxs := math.Max(0.0, f.lay.width - f.w + 1.0)
    if sc > maxs:
        sc = maxs
    end
    if sc < 0.0:
        sc = 0.0
    end
    mut cc := _e.ctl.ref(node)
    cc.text_scroll = sc
end

func _paint_selection(cv &: paint.Canvas, fi: int, tx: f64, ty: f64, alpha: f64):
    f := _e.ifcs[fi]
    c := _e.ctl[f.owner]
    if not c.focused or c.caret == c.anchor or _control_shows_placeholder(f.owner) or not _is_text_input(f.owner):
        ret
    end
    a := _display_offset(f.owner, math.MinI(c.caret, c.anchor))
    b := _display_offset(f.owner, math.MaxI(c.caret, c.anchor))
    mut rs := typeset.SelectionRects(f.para, f.lay, a, b)
    each r in rs:
        cv.FillRect(_rect(tx + r.x, ty + r.y, r.width, r.height), paint.Color { r = 0, g = 117, b = 255, a = (math.Round(77.0 * alpha) as int) })
    end
    rs.free()
end

func _paint_caret(cv &: paint.Canvas, fi: int, tx: f64, ty: f64, alpha: f64):
    f := _e.ifcs[fi]
    c := _e.ctl[f.owner]
    if not c.focused or not _is_text_input(f.owner):
        ret
    end
    mut off := 0
    if not _control_shows_placeholder(f.owner):
        off = _display_offset(f.owner, c.caret)
    end
    r := typeset.CaretRect(f.para, f.lay, typeset.TextPosition { offset = off })
    cs := _style_of(f.owner)
    col := cs.caret_color.a > 0 ? cs.caret_color : cs.color
    if c.preedit.len() > 0:
        cv.FillRect(_rect(tx + r.x, ty + r.y + r.height - 1.0, 2.0, 1.0), _pca(col, alpha))
    end
    cv.FillRect(_rect(tx + r.x, ty + r.y, 1.0, r.height), _pca(col, alpha))
end

func _popup_geometry(x &: f64, y &: f64, w &: f64, ih &: f64, n &: int):
    node := _e.popup
    b := _e.boxes[node]
    cs := _style_of(node)
    ih = math.Round(cs.font_size * 1.3)
    mut opts := Vector {} as Vector<int>
    _option_nodes(node, opts)
    n = opts.len()
    opts.free()
    x = b.x
    y = b.y + b.h
    w = b.w
    if y + ih * (n as f64) > _e.height and b.y - ih * (n as f64) >= 0.0:
        y = b.y - ih * (n as f64)
    end
end

func _paint_popup(cv &: paint.Canvas):
    if _e.popup < 0 or _e.popup >= _e.boxes.len():
        ret
    end
    node := _e.popup
    mut x := 0.0
    mut y := 0.0
    mut w := 0.0
    mut ih := 0.0
    mut n := 0
    _popup_geometry(x, y, w, ih, n)
    s := _e.scale
    cv.DrawShadow(_rect(x, y, w, ih * (n as f64)), paint.Radii {}, paint.Shadow { offset_y = 2.0 * s, blur = 6.0 * s, color = paint.Color { a = 70 } })
    cv.FillRect(_rect(x, y, w, ih * (n as f64)), paint.Color { r = 255, g = 255, b = 255, a = 255 })
    cv.DrawBorder(_rect(x, y, w, ih * (n as f64)), paint.Radii {}, paint.SolidBorder(s, paint.Color { r = 118, g = 118, b = 118, a = 255 }))
    mut opts := Vector {} as Vector<int>
    defer opts.free()
    _option_nodes(node, opts)
    cs := _style_of(node)
    sel := _select_index(node)
    c := _e.ctl[node]
    repeat opts.len() in i:
        oy := y + ih * (i as f64)
        hl := c.anchor == i
        if hl or (c.anchor < 0 and i == sel):
            cv.FillRect(_rect(x + 1.0, oy, w - 2.0, ih), paint.Color { r = 30, g = 144, b = 255, a = 255 })
        end
        t := _text_of(_e.dom, opts[i])
        mut spans := Vector {} as Vector<typeset.TextSpan>
        spans.push(_span_of(cs, t, node))
        mut p := typeset.NewParagraph(_fc, spans, typeset.ParagraphStyle {})
        mut l := typeset.LayoutParagraph(p, _fc, 0.0)
        tc := hl ? paint.Color { r = 255, g = 255, b = 255, a = 255 } : _pc(cs.color)
        _draw_layout(cv, l, x + 4.0, oy + (ih - l.height) / 2.0, tc)
        typeset.FreeLayout(l)
        typeset.FreeParagraph(p)
        spans.free()
        _sfree(t)
    end
end

func _set_value(node: int, v: str):
    mut c := _e.ctl.ref(node)
    old := c.value
    c.value = str.Clone(v)
    c.has_value = true
    if old.len() > 0:
        _sfree(old)
    end
end

func _push_undo(node: int):
    v := _control_value(node)
    mut c := _e.ctl.ref(node)
    if c.undo.len() > 100:
        _sfree(c.undo[0])
        c.undo.remove_at(0)
    end
    c.undo.push(str.Clone(v))
end

func _next_cp(s: str, i: int): int:
    p := (s as void*) as u8*
    mut k := i + 1
    until k < s.len() and (_hb(p, k) & 0xC0) == 0x80:
        k++
    end
    ret math.MinI(k, s.len())
end

func _prev_cp(s: str, i: int): int:
    p := (s as void*) as u8*
    mut k := i - 1
    until k > 0 and (_hb(p, k) & 0xC0) == 0x80:
        k--
    end
    ret math.MaxI(k, 0)
end

func _grapheme_step(node: int, off: int, forward: bool, word: bool): int:
    v := _control_value(node)
    fi := _e.node_ifc[node]
    plain := not (_e.dom.nodes[node].tag == "input" and _input_type(node) == "password") and v.len() > 0
    if fi >= 0 and plain and _e.ifcs[fi].has_para and _e.ifcs[fi].para.text == v:
        p := _e.ifcs[fi].para
        if word:
            ret forward ? typeset.NextWordEnd(p, off) : typeset.PrevWordStart(p, off)
        end
        ret forward ? typeset.NextGrapheme(p, off) : typeset.PrevGrapheme(p, off)
    end
    if forward:
        ret off >= v.len() ? v.len() : _next_cp(v, off)
    end
    ret off <= 0 ? 0 : _prev_cp(v, off)
end

func _replace_selection(node: int, text: str):
    v := _control_value(node)
    c := _e.ctl[node]
    a := math.MaxI(0, math.MinI(math.MinI(c.caret, c.anchor), v.len()))
    b := math.MinI(v.len(), math.MaxI(c.caret, c.anchor))
    mut ins := text
    if _e.dom.nodes[node].tag == "input":
        ins = str.Replace(text, "\n", "")
    end
    nv := v.substr(0, a) + ins + v.substr(b, v.len() - b)
    _set_value(node, nv)
    mut cc := _e.ctl.ref(node)
    cc.caret = a + ins.len()
    cc.anchor = cc.caret
end

func _selected_text(node: int): str:
    v := _control_value(node)
    c := _e.ctl[node]
    a := math.MaxI(0, math.MinI(c.caret, c.anchor))
    b := math.MinI(v.len(), math.MaxI(c.caret, c.anchor))
    if b <= a:
        ret ""
    end
    ret v.substr(a, b - a)
end

func _caret_from_point(node: int, x: f64, y: f64): int:
    fi := _e.node_ifc[node]
    if fi < 0 or not _e.ifcs[fi].has_lay or _control_shows_placeholder(node):
        ret 0
    end
    f := _e.ifcs[fi]
    pos := typeset.HitTest(f.para, f.lay, x - f.x + _e.ctl[node].text_scroll, y - f.y)
    ret _value_offset(node, pos.offset)
end
