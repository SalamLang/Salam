package ui

import str
import math
import ai.image
import gui.paint
import gui.typeset

func _load_image(src: str, ok &: bool): paint.Canvas:
    mut path := src
    if path.starts_with("file://"):
        path = path.substr(7, path.len() - 7)
    end
    if path.starts_with("http:") or path.starts_with("https:") or path.starts_with("data:"):
        ok = false
        ret paint.Canvas {}
    end
    mut iok := false
    mut img := image.Open(path, iok)
    if not iok:
        image.Free(img)
        ok = false
        ret paint.Canvas {}
    end
    cv := paint.FromImage(img)
    image.Free(img)
    ok = true
    ret cv
end

func _option_nodes(node: int, out &: Vector<int>):
    each k in _e.dom.nodes[node].kids:
        t := _e.dom.nodes[k].k
        if t == _K_OPTION:
            out.push(k)
        else t == _K_OPTGROUP:
            _option_nodes(k, out)
        end
    end
end

func _select_index(node: int): int:
    c := _e.ctl[node]
    if c.selected >= 0:
        ret c.selected
    end
    mut opts := Vector {} as Vector<int>
    defer opts.free()
    _option_nodes(node, opts)
    repeat opts.len() in i:
        if _has_attr(_e.dom, opts[i], "selected"):
            ret i
        end
    end
    v := _attr(_e.dom, node, "value")
    if v.len() > 0:
        repeat opts.len() in j:
            ov := _option_value(opts[j])
            same := ov == v
            _sfree(ov)
            if same:
                ret j
            end
        end
    end
    ret opts.len() > 0 ? 0 : -1
end

func _option_value(opt: int): str:
    if _has_attr(_e.dom, opt, "value"):
        ret str.Clone(_attr(_e.dom, opt, "value"))
    end
    t := _text_of(_e.dom, opt)
    r := str.Trim(t)
    _sfree(t)
    ret r
end

func _control_value(node: int): str:
    c := _e.ctl[node]
    if c.has_value:
        ret c.value
    end
    k := _e.dom.nodes[node].k
    if k == _K_TEXTAREA:
        if _has_attr(_e.dom, node, "value"):
            ret _attr(_e.dom, node, "value")
        end
        ret _text_of(_e.dom, node)
    end
    if k == _K_SELECT:
        mut opts := Vector {} as Vector<int>
        defer opts.free()
        _option_nodes(node, opts)
        i := _select_index(node)
        if i >= 0 and i < opts.len():
            ret _option_value(opts[i])
        end
        ret ""
    end
    ret _attr(_e.dom, node, "value")
end

func _is_checked(node: int): bool:
    if node < 0 or node >= _e.ctl.len():
        ret false
    end
    nd := _e.dom.nodes[node]
    if nd.k == _K_OPTION:
        sel := _ancestor_k(nd.parent, _K_SELECT)
        if sel >= 0:
            mut opts := Vector {} as Vector<int>
            _option_nodes(sel, opts)
            i := _select_index(sel)
            hit := i >= 0 and i < opts.len() and opts[i] == node
            opts.free()
            ret hit
        end
        ret _has_attr(_e.dom, node, "selected")
    end
    if nd.k != _K_INPUT:
        ret false
    end
    c := _e.ctl[node]
    if c.has_checked:
        ret c.checked
    end
    ret _has_attr(_e.dom, node, "checked")
end

func _control_shows_placeholder(node: int): bool:
    if not _is_text_input(node):
        ret false
    end
    v := _control_value(node)
    ret v.len() == 0 and _e.ctl[node].preedit.len() == 0 and _attr(_e.dom, node, "placeholder").len() > 0
end

func _bullets(v: str): str:
    mut b := str.NewBuilder()
    n := str.CharCount(v)
    repeat n:
        str.BufAppend(b, "•")
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func _control_text(node: int): str:
    k := _e.dom.nodes[node].k
    if k == _K_SELECT:
        mut opts := Vector {} as Vector<int>
        defer opts.free()
        _option_nodes(node, opts)
        i := _select_index(node)
        if i >= 0 and i < opts.len():
            t := _text_of(_e.dom, opts[i])
            r := str.Trim(t)
            _sfree(t)
            ret r
        end
        ret str.Clone("")
    end
    if _is_button_input(node):
        if _has_attr(_e.dom, node, "value"):
            ret str.Clone(_attr(_e.dom, node, "value"))
        end
        t := _input_type(node)
        ret str.Clone(t == "reset" ? "Reset" : (t == "submit" ? "Submit" : ""))
    end
    v := _control_value(node)
    pre := _e.ctl[node].preedit
    pw := _input_type(node) == "password"
    if pre.len() > 0 and _e.ctl[node].focused and not pw:
        cp := math.MaxI(0, math.MinI(_e.ctl[node].caret, v.len()))
        ret v.substr(0, cp) + pre + v.substr(cp, v.len() - cp)
    end
    if v.len() == 0:
        ret str.Clone(_attr(_e.dom, node, "placeholder"))
    end
    if pw:
        ret _bullets(v)
    end
    ret str.Clone(v)
end

func _preedit_len(node: int): int:
    c := _e.ctl[node]
    if c.preedit.len() == 0 or not c.focused or _input_type(node) == "password":
        ret 0
    end
    ret c.preedit.len()
end

func _is_textarea(node: int): bool:
    ret _e.dom.nodes[node].k == _K_TEXTAREA
end

func _wraps(node: int): bool:
    ret _is_textarea(node) and _attr(_e.dom, node, "wrap") != "off"
end

func _display_offset(node: int, off: int): int:
    pl := _preedit_len(node)
    if pl > 0:
        ret off >= _e.ctl[node].caret ? off + pl : off
    end
    if _input_type(node) == "password":
        v := _control_value(node)
        n := str.CharCount(v.substr(0, off))
        ret n * 3
    end
    ret off
end

func _value_offset(node: int, doff: int): int:
    pl := _preedit_len(node)
    if pl > 0:
        c := _e.ctl[node].caret
        if doff < c:
            ret doff
        end
        ret doff < c + pl ? c : doff - pl
    end
    if _input_type(node) == "password":
        v := _control_value(node)
        cps := doff / 3
        mut i := 0
        mut k := 0
        p := (v as void*) as u8*
        until i < v.len() and k < cps:
            i++
            until i < v.len() and (_hb(p, i) & 0xC0) == 0x80:
                i++
            end
            k++
        end
        ret i
    end
    ret doff
end

func _ctl_run(node: int): int:
    if node < 0 or node >= _e.node_run.len():
        ret -1
    end
    ri := _e.node_run[node]
    if ri >= 0 and _e.runs[ri].control:
        ret ri
    end
    ret -1
end

func _refresh_control(node: int):
    ri := _ctl_run(node)
    if ri < 0:
        _damage_node(node)
        ret
    end
    _retext_run(ri)
    _e.dirty_layout = true
    _e.dirty_place = true
    if _e.dom.nodes[node].k == _K_TEXTAREA or _e.dom.nodes[node].k == _K_INPUT:
        _layout()
    end
    _scroll_caret(node)
    _damage_node(node)
    _e.restyled.push(node)
end

func _scroll_caret(node: int):
    ri := _ctl_run(node)
    if ri < 0 or not _e.runs[ri].has_lay:
        ret
    end
    f := _e.runs[ri]
    c := _e.ctl[node]
    mut x := 0.0
    mut y := 0.0
    mut h := 0.0
    if not _control_shows_placeholder(node):
        r := typeset.CaretRect(f.para, f.lay, typeset.TextPosition { offset = _display_offset(node, c.caret) })
        x = r.x
        y = r.y
        h = r.height
    end
    mut sc := c.text_scroll
    mut sy := c.text_scroll_y
    if not _wraps(node):
        if x - sc > f.w - 1.0:
            sc = x - f.w + 1.0
        end
        if x - sc < 0.0:
            sc = x
        end
        maxs := math.Max(0.0, f.lay.width - f.w + 1.0)
        sc = math.Max(0.0, math.Min(sc, maxs))
    else:
        sc = 0.0
    end
    if _is_textarea(node):
        if y + h - sy > f.h:
            sy = y + h - f.h
        end
        if y - sy < 0.0:
            sy = y
        end
        maxy := math.Max(0.0, f.lay.height - f.h)
        sy = math.Max(0.0, math.Min(sy, maxy))
    else:
        sy = 0.0
    end
    mut cc := _e.ctl.ref(node)
    cc.text_scroll = sc
    cc.text_scroll_y = sy
end

func _scroll_text(node: int, dx: f64, dy: f64): bool:
    ri := _ctl_run(node)
    if ri < 0 or not _e.runs[ri].has_lay:
        ret false
    end
    f := _e.runs[ri]
    c := _e.ctl[node]
    maxx := _wraps(node) ? 0.0 : math.Max(0.0, f.lay.width - f.w + 1.0)
    maxy := math.Max(0.0, f.lay.height - f.h)
    nx := math.Max(0.0, math.Min(maxx, c.text_scroll + dx))
    ny := math.Max(0.0, math.Min(maxy, c.text_scroll_y + dy))
    if nx == c.text_scroll and ny == c.text_scroll_y:
        ret false
    end
    mut cc := _e.ctl.ref(node)
    cc.text_scroll = nx
    cc.text_scroll_y = ny
    _damage_node(node)
    ret true
end

func _word_bounds(node: int, off: int, a &: int, b &: int):
    b = _grapheme_step(node, off, true, true)
    a = _grapheme_step(node, b, false, true)
    if a > off:
        a = _grapheme_step(node, off, false, true)
        b = _grapheme_step(node, a, true, true)
    end
end

func _line_bounds(node: int, off: int, a &: int, b &: int):
    v := _control_value(node)
    if not _is_textarea(node):
        a = 0
        b = v.len()
        ret
    end
    p := (v as void*) as u8*
    mut i := math.MinI(off, v.len())
    until i > 0 and _hb(p, i - 1) != 10:
        i--
    end
    mut j := math.MinI(off, v.len())
    until j < v.len() and _hb(p, j) != 10:
        j++
    end
    a = i
    b = j < v.len() ? j + 1 : j
end

func _line_move(node: int, off: int, dir: int, edge: bool): int:
    ri := _ctl_run(node)
    if ri < 0 or not _e.runs[ri].has_lay:
        ret off
    end
    f := _e.runs[ri]
    pos := typeset.TextPosition { offset = _display_offset(node, off) }
    r := typeset.CaretRect(f.para, f.lay, pos)
    if edge:
        nl := f.lay.lines.len()
        if nl == 0:
            ret off
        end
        mut li := 0
        repeat nl in i:
            ln := f.lay.lines[i]
            if r.y >= ln.top and r.y < ln.top + ln.height:
                li = i
            end
        end
        ln := f.lay.lines[li]
        mut x := 0.0
        if (dir > 0) != ln.rtl:
            x = ln.x + ln.width + 1000.0
        else:
            x = ln.x - 1000.0
        end
        hp := typeset.HitTest(f.para, f.lay, x, ln.top + ln.height / 2.0)
        ret _value_offset(node, hp.offset)
    end
    ny := dir > 0 ? r.y + r.height + 1.0 : r.y - 1.0
    if ny < 0.0:
        ret 0
    end
    if ny >= f.lay.height:
        ret _control_value(node).len()
    end
    hp := typeset.HitTest(f.para, f.lay, r.x, ny)
    ret _value_offset(node, hp.offset)
end

func _set_value(node: int, v: str):
    mut c := _e.ctl.ref(node)
    old := c.value
    c.value = str.Clone(v)
    c.has_value = true
    _sfree(old)
end

func _push_undo(node: int):
    v := _control_value(node)
    mut c := _e.ctl.ref(node)
    if c.undo.len() > 100:
        _sfree(c.undo[0])
        c.undo.remove_at(0)
    end
    c.undo.push(str.Clone(v))
end

func _next_cp(s: str, i: int): int:
    p := (s as void*) as u8*
    mut k := i + 1
    until k < s.len() and (_hb(p, k) & 0xC0) == 0x80:
        k++
    end
    ret math.MinI(k, s.len())
end

func _prev_cp(s: str, i: int): int:
    p := (s as void*) as u8*
    mut k := i - 1
    until k > 0 and (_hb(p, k) & 0xC0) == 0x80:
        k--
    end
    ret math.MaxI(k, 0)
end

func _grapheme_step(node: int, off: int, forward: bool, word: bool): int:
    v := _control_value(node)
    ri := _ctl_run(node)
    plain := _input_type(node) != "password" and v.len() > 0
    if ri >= 0 and plain and _e.runs[ri].has_para and _e.runs[ri].para.text == v:
        p := _e.runs[ri].para
        if word:
            ret forward ? typeset.NextWordEnd(p, off) : typeset.PrevWordStart(p, off)
        end
        ret forward ? typeset.NextGrapheme(p, off) : typeset.PrevGrapheme(p, off)
    end
    if forward:
        ret off >= v.len() ? v.len() : _next_cp(v, off)
    end
    ret off <= 0 ? 0 : _prev_cp(v, off)
end

func _replace_selection(node: int, text: str):
    v := _control_value(node)
    c := _e.ctl[node]
    a := math.MaxI(0, math.MinI(math.MinI(c.caret, c.anchor), v.len()))
    b := math.MinI(v.len(), math.MaxI(c.caret, c.anchor))
    mut ins := text
    if _e.dom.nodes[node].k == _K_INPUT:
        ins = str.Replace(text, "\n", "")
    end
    nv := v.substr(0, a) + ins + v.substr(b, v.len() - b)
    _set_value(node, nv)
    mut cc := _e.ctl.ref(node)
    cc.caret = a + ins.len()
    cc.anchor = cc.caret
end

func _selected_text(node: int): str:
    v := _control_value(node)
    c := _e.ctl[node]
    a := math.MaxI(0, math.MinI(c.caret, c.anchor))
    b := math.MinI(v.len(), math.MaxI(c.caret, c.anchor))
    if b <= a:
        ret ""
    end
    ret v.substr(a, b - a)
end

func _caret_from_point(node: int, x: f64, y: f64): int:
    ri := _ctl_run(node)
    if ri < 0 or not _e.runs[ri].has_lay or _control_shows_placeholder(node):
        ret 0
    end
    f := _e.runs[ri]
    mut lx := x
    mut ly := y
    _to_local(node, x, y, lx, ly)
    pos := typeset.HitTest(f.para, f.lay, lx - f.x + _e.ctl[node].text_scroll, ly - f.y + _e.ctl[node].text_scroll_y)
    ret _value_offset(node, pos.offset)
end

func _range_frac(node: int): f64:
    mut mn := 0.0
    mut mx := 100.0
    if _has_attr(_e.dom, node, "min"):
        mn = _attr(_e.dom, node, "min").to_float()
    end
    if _has_attr(_e.dom, node, "max"):
        mx = _attr(_e.dom, node, "max").to_float()
    end
    v := _control_value(node)
    mut x := (mn + mx) / 2.0
    if v.len() > 0:
        x = v.to_float()
    end
    if mx <= mn:
        ret 0.0
    end
    ret math.Max(0.0, math.Min(1.0, (x - mn) / (mx - mn)))
end
