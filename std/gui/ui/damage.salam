package ui

import math
import str
import gui.paint
import gui.style

func _filter_extent(s: style.Style, font: f64): f64:
    b := _vp_len(s.blur, font)
    if b > 0.0:
        ret b * 3.0
    end
    ret 0.0
end

func _up_ext(node: int): f64:
    mut e := 0.0
    mut p := _e.dom.nodes[node].parent
    until p >= 0:
        e += _filter_extent(_e.cs[p], _e.us[p].font)
        p = _e.dom.nodes[p].parent
    end
    ret e
end

func _ink(node: int, x0 &: int, y0 &: int, x1 &: int, y1 &: int): bool:
    mut r := [0.0, 0.0, 0.0, 0.0]
    if not _ink_page(node, r):
        ret false
    end
    b := _e.boxes[node]
    mut l := r[0]
    mut t := r[1]
    mut rr := r[2]
    mut bt := r[3]
    ae := _up_ext(node)
    l -= ae
    t -= ae
    rr += ae
    bt += ae
    if _e.xf_any:
        _screen_bbox(node, l, t, rr, bt)
        l--
        t--
        rr++
        bt++
    else:
        l = math.Max(l, b.clip_x0 - ae - 1.0)
        t = math.Max(t, b.clip_y0 - ae - 1.0)
        rr = math.Min(rr, b.clip_x1 + ae + 1.0)
        bt = math.Min(bt, b.clip_y1 + ae + 1.0)
    end
    s := _e.scale
    x0 = math.Floor(l * s) as int
    y0 = math.Floor(t * s) as int
    x1 = math.Ceil(rr * s) as int
    y1 = math.Ceil(bt * s) as int
    ret x1 > x0 and y1 > y0
end

func _node_key(node: int, ups: i64): i64:
    mut h := 1469598103934665603 as i64
    b := _e.boxes[node]
    h = _hf(_hf(_hf(_hf(h, b.x), b.y), b.w), b.h)
    h = _hf(_hf(_hf(_hf(h, b.clip_x0), b.clip_y0), b.clip_x1), b.clip_y1)
    h = _hmix(h, _e.us[node].ihash)
    h = _hmix(h, _e.us[node].phash)
    h = _hmix(h, ups)
    c := _e.ctl[node]
    h = _hmix(
        h,
        (c.hovered ? 1 : 0) + (c.focused ? 2 : 0) + (c.pressed ? 4 : 0) + (c.focus_visible ? 8 : 0) +
            (_is_open(node) ? 16 : 0) + (_is_checked(node) ? 32 : 0)
    )
    h = _hf(_hf(h, c.scroll_x), c.scroll_y)
    h = _hmix(_hmix(_hmix(h, c.caret as i64), c.anchor as i64), c.selected as i64)
    h = _hf(_hf(h, c.text_scroll), c.text_scroll_y)
    if c.has_value:
        h = _hstr(h, c.value)
    end
    h = _hstr(h, c.preedit)
    nd := _e.dom.nodes[node]
    repeat nd.names.Len() in k:
        h = _hstr(_hstr(h, nd.names[k]), nd.values[k])
    end
    ri := node < _e.node_run.Len() ? _e.node_run[node] : -1
    if ri >= 0:
        f := _e.runs[ri]
        h = _hf(_hf(h, f.x), f.y)
        repeat f.spans.Len() in k:
            h = _hstr(h, f.spans[k].text)
            el := f.span_el[k]
            if el >= 0 and el < _e.ctl.Len():
                h = _hmix(h, _e.ctl[el].hovered ? 3 : 5)
            end
        end
    end
    if node == _e.popup:
        h = _hmix(h, 77)
    end
    ret _xf_hash(node, h)
end

func _damage_rect(x0: int, y0: int, x1: int, y1: int):
    cw := math.Ceil(_e.width * _e.scale) as int
    ch := math.Ceil(_e.height * _e.scale) as int
    ax := math.MaxI(0, x0)
    ay := math.MaxI(0, y0)
    bx := math.MinI(cw, x1)
    by1 := math.MinI(ch, y1)
    if bx > ax and by1 > ay:
        _e.damage.Add(paint.IntRect {
            x = ax,
            y = ay,
            width = bx - ax,
            height = by1 - ay
        })
    end
end

func _damage_hits(x0: int, y0: int, x1: int, y1: int): bool:
    repeat _e.damage.Count() in i:
        r := _e.damage.At(i)
        if r.x < x1 and r.x + r.width > x0 and r.y < y1 and r.y + r.height > y0:
            ret true
        end
    end
    ret false
end

func _diff_records():
    mut old := HashMap {} as HashMap<int, int>
    defer old.Free()
    repeat _e.recs.Len() in i:
        old.Put(_e.recs[i].uid, i)
    end
    mut seen := Vector {} as Vector<bool>
    defer seen.Free()
    repeat _e.recs.Len():
        seen.Push(false)
    end
    mut nrecs := Vector {} as Vector<_Rec>
    _e.sink.Clear()
    repeat _e.dom.nodes.Len():
        _e.sink.Push(1 << 30)
        _e.sink.Push(1 << 30)
        _e.sink.Push(0 - (1 << 30))
        _e.sink.Push(0 - (1 << 30))
    end
    cw := math.Ceil(_e.width * _e.scale) as int
    ch := math.Ceil(_e.height * _e.scale) as int
    mut ups := Vector {} as Vector<i64>
    defer ups.Free()
    repeat _e.dom.nodes.Len() in node:
        pa := _e.dom.nodes[node].parent
        mut ah := 0 as i64
        if pa >= 0:
            ah = _hmix(_hmix(ups[pa], _e.us[pa].fhash), _xf_hash(pa, 0 as i64))
        end
        ups.Push(ah)
        mut x0 := 0
        mut y0 := 0
        mut x1 := 0
        mut y1 := 0
        if not _ink(node, x0, y0, x1, y1):
            continue
        end
        _e.sink[node * 4] = x0
        _e.sink[node * 4 + 1] = y0
        _e.sink[node * 4 + 2] = x1
        _e.sink[node * 4 + 3] = y1
        uid := _e.ctl[node].uid
        if x1 <= 0 or y1 <= 0 or x0 >= cw or y0 >= ch:
            mut was_off := true
            if old.Has(uid):
                oi := old.Get(uid)
                o := _e.recs[oi]
                was_off = o.x1 <= 0 or o.y1 <= 0 or o.x0 >= cw or o.y0 >= ch
                if was_off:
                    seen[oi] = true
                end
            end
            if was_off:
                nrecs.Push(_Rec {
                    uid = uid,
                    hash = 0,
                    x0 = x0,
                    y0 = y0,
                    x1 = x1,
                    y1 = y1
                })
                continue
            end
        end
        key := _node_key(node, ah)
        nrecs.Push(_Rec {
            uid = uid,
            hash = key,
            x0 = x0,
            y0 = y0,
            x1 = x1,
            y1 = y1
        })
        if old.Has(uid):
            oi := old.Get(uid)
            seen[oi] = true
            o := _e.recs[oi]
            if o.hash != key or o.x0 != x0 or o.y0 != y0 or o.x1 != x1 or o.y1 != y1:
                _damage_rect(o.x0, o.y0, o.x1, o.y1)
                _damage_rect(x0, y0, x1, y1)
            end
        else:
            _damage_rect(x0, y0, x1, y1)
        end
    end
    repeat _e.recs.Len() in i:
        if not seen[i]:
            o := _e.recs[i]
            _damage_rect(o.x0, o.y0, o.x1, o.y1)
        end
    end
    _e.recs.Free()
    _e.recs = nrecs
    if _e.dom.nodes.Len() > 0:
        _sink_up(0)
    end
    _e.sink_ok = true
    _damage_backdrops()
end

func _sink_up(node: int):
    nd := _e.dom.nodes[node]
    if nd.k == _K_DIALOG or node == _e.popup:
        _e.sink[node * 4] = 0 - (1 << 30)
        _e.sink[node * 4 + 1] = 0 - (1 << 30)
        _e.sink[node * 4 + 2] = 1 << 30
        _e.sink[node * 4 + 3] = 1 << 30
    end
    b := node * 4
    each k in nd.kids:
        _sink_up(k)
        c := k * 4
        if _e.sink[c] < _e.sink[c + 2]:
            _e.sink[b] = math.MinI(_e.sink[b], _e.sink[c])
            _e.sink[b + 1] = math.MinI(_e.sink[b + 1], _e.sink[c + 1])
            _e.sink[b + 2] = math.MaxI(_e.sink[b + 2], _e.sink[c + 2])
            _e.sink[b + 3] = math.MaxI(_e.sink[b + 3], _e.sink[c + 3])
        end
    end
end

func _sink_skip(node: int): bool:
    if not _e.sink_ok or node * 4 + 3 >= _e.sink.Len():
        ret false
    end
    b := node * 4
    x0 := _e.sink[b] - 2
    y0 := _e.sink[b + 1] - 2
    x1 := _e.sink[b + 2] + 2
    y1 := _e.sink[b + 3] + 2
    if x1 <= x0 or y1 <= y0:
        ret true
    end
    if _e.full:
        cw := math.Ceil(_e.width * _e.scale) as int
        ch := math.Ceil(_e.height * _e.scale) as int
        ret x1 <= 0 or y1 <= 0 or x0 >= cw or y0 >= ch
    end
    ret not _damage_hits(x0, y0, x1, y1)
end

func _damage_area(): i64:
    mut a := 0 as i64
    repeat _e.damage.Count() in i:
        r := _e.damage.At(i)
        a += (r.width as i64) * (r.height as i64)
    end
    ret a
end

func _damage_backdrops():
    if _e.full:
        ret
    end
    mut pass := 0
    mut grew := true
    until grew and pass < 4:
        grew = false
        pass++
        repeat _e.dom.nodes.Len() in node:
            if not _e.boxes[node].shown:
                continue
            end
            s := _e.cs[node]
            if _vp_len(
                s.backdrop_blur, _e.us[node].font
            ) == 0.0 and s.backdrop_brightness == 1.0 and s.backdrop_contrast == 1.0 and
                s.backdrop_grayscale == 0.0 and s.backdrop_saturate == 1.0 and
                s.backdrop_sepia == 0.0 and s.backdrop_invert == 0.0 and
                s.backdrop_hue_rotate == 0.0:
                continue
            end
            mut x0 := 0
            mut y0 := 0
            mut x1 := 0
            mut y1 := 0
            if not _ink(node, x0, y0, x1, y1):
                continue
            end
            if _damage_hits(x0, y0, x1, y1):
                before := _damage_area()
                _damage_rect(x0, y0, x1, y1)
                if _damage_area() > before:
                    grew = true
                end
            end
        end
    end
end

func _damage_node(node: int):
    mut x0 := 0
    mut y0 := 0
    mut x1 := 0
    mut y1 := 0
    if _ink(node, x0, y0, x1, y1):
        _damage_rect(x0, y0, x1, y1)
    end
end

func _union_ink(r: f64[], l: f64, t: f64, rr: f64, bt: f64):
    r[0] = math.Min(r[0], l)
    r[1] = math.Min(r[1], t)
    r[2] = math.Max(r[2], rr)
    r[3] = math.Max(r[3], bt)
end

func _run_shadow_ext(f: _Run): f64:
    mut ts := 0.0
    each el in f.span_el:
        each sh in _e.cs[el].text_shadow:
            fo := _e.us[el].font
            ts = math.Max(
                ts,
                math.Max(
                    math.Abs(_vp_len(sh.x, fo)), math.Abs(_vp_len(sh.y, fo))
                ) + _vp_len(sh.blur, fo) * 1.5 + 2.0
            )
        end
    end
    ret ts
end

func _ink_page(node: int, r: f64[]): bool:
    b := _e.boxes[node]
    if not b.shown:
        ret false
    end
    s := _e.cs[node]
    u := _e.us[node]
    nd := _e.dom.nodes[node]
    fo := u.font
    r[0] = b.x
    r[1] = b.y
    r[2] = b.x + b.w
    r[3] = b.y + b.h
    each sh in s.shadow:
        if not sh.inset:
            e := math.Max(0.0, _vp_len(sh.blur, fo)) * 2.0 + math.Abs(_vp_len(sh.spread, fo)) + 2.0
            dx := _vp_len(sh.x, fo)
            dy := _vp_len(sh.y, fo)
            _union_ink(r, b.x + dx - e, b.y + dy - e, b.x + b.w + dx + e, b.y + b.h + dy + e)
        end
    end
    mut oe := 0.0
    if s.outline_style != style.KW_NONE:
        ow := _vp_len(s.outline_width, fo)
        if ow > 0.0:
            oe = math.Max(0.0, _vp_len(s.outline_offset, fo)) + ow + 1.0
        end
    end
    if _focus_ring(node, u):
        oe = math.Max(oe, 5.0)
    end
    if oe > 0.0:
        _union_ink(r, b.x - oe, b.y - oe, b.x + b.w + oe, b.y + b.h + oe)
    end
    fe := _filter_extent(s, fo)
    if fe > 0.0:
        _union_ink(r, r[0] - fe, r[1] - fe, r[2] + fe, r[3] + fe)
    end
    if nd.k == _K_ITEM:
        m := fo * 2.0
        _union_ink(r, b.x - m, b.y, b.x + b.w + m, b.y + b.h)
    end
    each k in nd.kids:
        ri := _e.node_run[k]
        if ri >= 0 and not _e.runs[ri].control and _e.runs[ri].has_lay:
            f := _e.runs[ri]
            ts := _run_shadow_ext(f) + 2.0
            _union_ink(
                r,
                f.x - ts,
                f.y - ts,
                f.x + math.Max(f.w, f.lay.width) + ts,
                f.y + math.Max(f.h, f.lay.height) + ts
            )
        end
    end
    if node == _e.popup and _e.popup >= 0:
        mut px := 0.0
        mut py := 0.0
        mut pw := 0.0
        mut ih := 0.0
        mut pn := 0
        _pp_geo(px, py, pw, ih, pn)
        _union_ink(r, px - 8.0, py - 8.0, px + pw + 8.0, py + ih * (pn as f64) + 12.0)
    end
    ret true
end

func _sub_ink(node: int, r: f64[]): bool:
    if not _ink_page(node, r):
        ret false
    end
    each k in _e.dom.nodes[node].kids:
        if _e.fid[k] < 0 or not _e.boxes[k].shown:
            continue
        end
        mut kr := [0.0, 0.0, 0.0, 0.0]
        if not _sub_ink(k, kr):
            continue
        end
        if _xf_has(k):
            m := _e.xf[k].MapRect(paint.RectOf(kr[0], kr[1], kr[2] - kr[0], kr[3] - kr[1]))
            kr[0] = m.x
            kr[1] = m.y
            kr[2] = m.x + m.width
            kr[3] = m.y + m.height
        end
        _union_ink(r, kr[0], kr[1], kr[2], kr[3])
    end
    ret true
end
