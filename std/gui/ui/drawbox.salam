package ui

import math
import gui.paint
import gui.style

struct _Geo:
    pub t: f64 = 0.0
    pub r: f64 = 0.0
    pub b: f64 = 0.0
    pub l: f64 = 0.0
    pub tl_x: f64 = 0.0
    pub tl_y: f64 = 0.0
    pub tr_x: f64 = 0.0
    pub tr_y: f64 = 0.0
    pub br_x: f64 = 0.0
    pub br_y: f64 = 0.0
    pub bl_x: f64 = 0.0
    pub bl_y: f64 = 0.0
end

func _is_rtl(s: style.Style): bool:
    ret s.direction == style.KW_RTL
end

func _side_w(w: style.Len, st: int, font: f64): f64:
    if st == style.KW_NONE:
        ret 0.0
    end
    ret math.Max(0.0, _vp_len(w, font))
end

func _geo(s: style.Style, font: f64, w: f64, h: f64): _Geo:
    rtl := _is_rtl(s)
    mut g := _Geo {}
    g.t = _side_w(s.border_top_width, s.border_top_style, font)
    g.b = _side_w(s.border_bottom_width, s.border_bottom_style, font)
    bs := _side_w(s.border_start_width, s.border_start_style, font)
    be := _side_w(s.border_end_width, s.border_end_style, font)
    g.l = rtl ? be : bs
    g.r = rtl ? bs : be
    tl := rtl ? s.radius_top_end : s.radius_top_start
    tr := rtl ? s.radius_top_start : s.radius_top_end
    br := rtl ? s.radius_bottom_start : s.radius_bottom_end
    bl := rtl ? s.radius_bottom_end : s.radius_bottom_start
    g.tl_x = math.Max(0.0, _abs_len(tl, font, w))
    g.tl_y = math.Max(0.0, _abs_len(tl, font, h))
    g.tr_x = math.Max(0.0, _abs_len(tr, font, w))
    g.tr_y = math.Max(0.0, _abs_len(tr, font, h))
    g.br_x = math.Max(0.0, _abs_len(br, font, w))
    g.br_y = math.Max(0.0, _abs_len(br, font, h))
    g.bl_x = math.Max(0.0, _abs_len(bl, font, w))
    g.bl_y = math.Max(0.0, _abs_len(bl, font, h))
    ret g
end

func _rect(x: f64, y: f64, w: f64, h: f64): paint.Rect:
    sc := _e.scale
    ret paint.Rect { x = x * sc, y = y * sc, width = math.Max(0.0, w) * sc, height = math.Max(0.0, h) * sc }
end

func _radii_of(g: _Geo, b: _Box): paint.Radii:
    sc := _e.scale
    r := paint.Radii { top_left_x = g.tl_x * sc, top_left_y = g.tl_y * sc, top_right_x = g.tr_x * sc, top_right_y = g.tr_y * sc, bottom_right_x = g.br_x * sc, bottom_right_y = g.br_y * sc, bottom_left_x = g.bl_x * sc, bottom_left_y = g.bl_y * sc }
    ret paint.FitRadii(_rect(b.x, b.y, b.w, b.h), r)
end

func _inner_radii(r: paint.Radii, t: f64, rr: f64, b: f64, l: f64): paint.Radii:
    ret paint.Radii { top_left_x = math.Max(0.0, r.top_left_x - l), top_left_y = math.Max(0.0, r.top_left_y - t), top_right_x = math.Max(0.0, r.top_right_x - rr), top_right_y = math.Max(0.0, r.top_right_y - t), bottom_right_x = math.Max(0.0, r.bottom_right_x - rr), bottom_right_y = math.Max(0.0, r.bottom_right_y - b), bottom_left_x = math.Max(0.0, r.bottom_left_x - l), bottom_left_y = math.Max(0.0, r.bottom_left_y - b) }
end

func _pad_radii(g: _Geo, b: _Box): paint.Radii:
    sc := _e.scale
    ret _inner_radii(_radii_of(g, b), g.t * sc, g.r * sc, g.b * sc, g.l * sc)
end

func _pad_box(g: _Geo, b: _Box): _Box:
    ret _Box { x = b.x + g.l, y = b.y + g.t, w = math.Max(0.0, b.w - g.l - g.r), h = math.Max(0.0, b.h - g.t - g.b), shown = true }
end

func _has_radius(r: paint.Radii): bool:
    ret r.top_left_x > 0.0 or r.top_left_y > 0.0 or r.top_right_x > 0.0 or r.top_right_y > 0.0 or r.bottom_right_x > 0.0 or r.bottom_right_y > 0.0 or r.bottom_left_x > 0.0 or r.bottom_left_y > 0.0
end

func _bstyle(w: int): paint.BorderStyle:
    switch w:
        style.KW_NONE: ret paint.BorderStyle.None end
        style.KW_DASHED: ret paint.BorderStyle.Dashed end
        style.KW_DOTTED: ret paint.BorderStyle.Dotted end
    end
    ret paint.BorderStyle.Solid
end

func _shadow_of(sh: style.Shadow, u: _Used, font: f64): paint.Shadow:
    sc := _e.scale
    ret paint.Shadow { offset_x = _vp_len(sh.x, font) * sc, offset_y = _vp_len(sh.y, font) * sc, blur = math.Max(0.0, _vp_len(sh.blur, font)) * sc, spread = _vp_len(sh.spread, font) * sc, color = _ucol(sh.color, u.color), inset = sh.inset }
end

func _paint_outer_shadows(cv &: paint.Canvas, b: _Box, s: style.Style, u: _Used, radii: paint.Radii):
    mut i := s.shadow.Len() - 1
    until i >= 0:
        sh := s.shadow[i]
        if not sh.inset:
            cv.DrawShadow(_rect(b.x, b.y, b.w, b.h), radii, _shadow_of(sh, u, u.font))
        end
        i--
    end
end

func _paint_inset_shadows(cv &: paint.Canvas, b: _Box, g: _Geo, s: style.Style, u: _Used):
    mut any := false
    each sh in s.shadow:
        if sh.inset:
            any = true
        end
    end
    if not any:
        ret
    end
    pb := _pad_box(g, b)
    pr := _pad_radii(g, b)
    mut i := s.shadow.Len() - 1
    until i >= 0:
        sh := s.shadow[i]
        if sh.inset:
            cv.DrawShadow(_rect(pb.x, pb.y, pb.w, pb.h), pr, _shadow_of(sh, u, u.font))
        end
        i--
    end
end

func _dbl_third(w: f64, st: int): f64:
    sc := _e.scale
    if st != style.KW_DOUBLE or w < 3.0 * sc:
        ret -1.0
    end
    ret math.Floor((w + sc) / (3.0 * sc)) * sc
end

func _split_side(w: f64, st: int, ow &: f64, off &: f64, iw &: f64): bool:
    t := _dbl_third(w, st)
    if t >= 0.0:
        ow = t
        iw = t
        off = w - t
        ret true
    end
    ow = w
    iw = 0.0
    off = 0.0
    ret false
end

func _paint_border(cv &: paint.Canvas, b: _Box, g: _Geo, s: style.Style, u: _Used, radii: paint.Radii):
    if g.t == 0.0 and g.r == 0.0 and g.b == 0.0 and g.l == 0.0:
        ret
    end
    rtl := _is_rtl(s)
    sc := _e.scale
    st_t := s.border_top_style
    st_b := s.border_bottom_style
    st_l := rtl ? s.border_end_style : s.border_start_style
    st_r := rtl ? s.border_start_style : s.border_end_style
    col_t := _ucol(s.border_top_color, u.color)
    col_b := _ucol(s.border_bottom_color, u.color)
    col_l := _ucol(rtl ? s.border_end_color : s.border_start_color, u.color)
    col_r := _ucol(rtl ? s.border_start_color : s.border_end_color, u.color)
    bd := paint.Border {
        top_width = g.t * sc, top_color = col_t, top_style = _bstyle(st_t),
        right_width = g.r * sc, right_color = col_r, right_style = _bstyle(st_r),
        bottom_width = g.b * sc, bottom_color = col_b, bottom_style = _bstyle(st_b),
        left_width = g.l * sc, left_color = col_l, left_style = _bstyle(st_l)
    }
    r := _rect(b.x, b.y, b.w, b.h)
    mut outer := bd
    mut inner := bd
    mut ow := 0.0
    mut iw := 0.0
    mut it := 0.0
    mut ir := 0.0
    mut ib := 0.0
    mut il := 0.0
    mut two := false
    if _split_side(bd.top_width, st_t, ow, it, iw):
        two = true
    end
    outer.top_width = ow
    inner.top_width = iw
    if _split_side(bd.right_width, st_r, ow, ir, iw):
        two = true
    end
    outer.right_width = ow
    inner.right_width = iw
    if _split_side(bd.bottom_width, st_b, ow, ib, iw):
        two = true
    end
    outer.bottom_width = ow
    inner.bottom_width = iw
    if _split_side(bd.left_width, st_l, ow, il, iw):
        two = true
    end
    outer.left_width = ow
    inner.left_width = iw
    if not two:
        cv.DrawBorder(r, radii, bd)
        ret
    end
    cv.DrawBorder(r, radii, outer)
    ir2 := paint.Rect { x = r.x + il, y = r.y + it, width = r.width - il - ir, height = r.height - it - ib }
    if ir2.width > 0.0 and ir2.height > 0.0:
        cv.DrawBorder(ir2, _inner_radii(radii, it, ir, ib, il), inner)
    end
end

func _outline_draw(cv &: paint.Canvas, b: _Box, radii: paint.Radii, w: f64, off: f64, c: paint.Color, st: int):
    sc := _e.scale
    dw := w * sc
    doff := off * sc
    r := _rect(b.x, b.y, b.w, b.h)
    t := _dbl_third(dw, st)
    if t >= 0.0:
        cv.DrawOutlineStyled(r, radii, t, doff + (dw - t), c, paint.BorderStyle.Solid)
        cv.DrawOutlineStyled(r, radii, t, doff, c, paint.BorderStyle.Solid)
        ret
    end
    cv.DrawOutlineStyled(r, radii, dw, doff, c, _bstyle(st))
end

func _focus_ring(node: int, u: _Used): bool:
    c := _e.ctl[node]
    ret c.focused and c.focus_visible and not u.outline_set and not _is_text_input(node)
end

func _paint_outline(cv &: paint.Canvas, node: int, b: _Box, g: _Geo, s: style.Style, u: _Used):
    radii := _radii_of(g, b)
    if s.outline_style != style.KW_NONE:
        w := _vp_len(s.outline_width, u.font)
        if w > 0.0:
            _outline_draw(cv, b, radii, w, _vp_len(s.outline_offset, u.font), _ucol(s.outline_color, u.color), s.outline_style)
        end
    end
    if _focus_ring(node, u):
        _outline_draw(cv, b, radii, 2.0, 2.0, _ucol(s.accent, u.color), style.KW_SOLID)
    end
end
