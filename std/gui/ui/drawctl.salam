package ui

import math
import str
import gui.paint
import gui.style
import gui.typeset

const _SB_AUTO := 10.0
const _SB_THIN := 6.0

func _sb_thickness(s &: style.Style): f64:
    if s.scrollbar == style.KW_NONE:
        ret 0.0
    end
    ret s.scrollbar == style.KW_THIN ? _SB_THIN : _SB_AUTO
end

func _is_disabled_state(node: int): bool:
    ret (_e.ctl[node].states & (1 << STATE_DISABLED)) != 0
end

func _grey(v: int): paint.Color:
    ret paint.Color {
        r = v,
        g = v,
        b = v,
        a = 255
    }
end

func _ctl_accent(node: int, s &: style.Style, u: _Used): paint.Color:
    if _is_disabled_state(node):
        ret _grey(170)
    end
    ret _ucol(s.accent, u.color)
end

func _fill_round(cv &: paint.Canvas, x: f64, y: f64, w: f64, h: f64, r: f64, c: paint.Color):
    sc := _e.scale
    cv.FillRoundedRect(_rect(x, y, w, h), paint.Uniform(r * sc), c)
end

func _stroke_round(cv &: paint.Canvas, x: f64, y: f64, w: f64, h: f64, r: f64, c: paint.Color):
    sc := _e.scale
    cv.DrawBorder(_rect(x, y, w, h), paint.Uniform(r * sc), paint.SolidBorder(math.Max(1.0, sc), c))
end

func _attr_f(node: int, name: str, dflt: f64): f64:
    if not _has_attr(_e.dom, node, name):
        ret dflt
    end
    v := _attr(_e.dom, node, name)
    if v.Len() == 0:
        ret dflt
    end
    ret v.ToFloat()
end

func _paint_checkbox(cv &: paint.Canvas, node: int, c: _Box, s &: style.Style, u: _Used):
    checked := _is_checked(node)
    acc := _ctl_accent(node, s, u)
    white := _grey(255)
    edge := _e.ctl[node].hovered ? _grey(79) : _grey(118)
    if checked:
        _fill_round(cv, c.x, c.y, c.w, c.h, 2.0, acc)
        sc := _e.scale
        mut p := paint.NewPath()
        p.MoveTo((c.x + c.w * 0.22) * sc, (c.y + c.h * 0.52) * sc)
        p.LineTo((c.x + c.w * 0.42) * sc, (c.y + c.h * 0.72) * sc)
        p.LineTo((c.x + c.w * 0.78) * sc, (c.y + c.h * 0.30) * sc)
        cv.StrokePath(
            p,
            paint.Stroke {
                width = 1.8 * sc, cap = paint.LineCap.Round, join = paint.LineJoin.Round
            },
            white
        )
        p.Free()
    else:
        _fill_round(cv, c.x, c.y, c.w, c.h, 2.0, white)
        _stroke_round(cv, c.x, c.y, c.w, c.h, 2.0, edge)
    end
end

func _paint_radio(cv &: paint.Canvas, node: int, c: _Box, s &: style.Style, u: _Used):
    checked := _is_checked(node)
    acc := _ctl_accent(node, s, u)
    white := _grey(255)
    edge := _e.ctl[node].hovered ? _grey(79) : _grey(118)
    r := c.w / 2.0
    if checked:
        _fill_round(cv, c.x, c.y, c.w, c.h, r, acc)
        _fill_round(cv, c.x + 2.0, c.y + 2.0, c.w - 4.0, c.h - 4.0, r - 2.0, white)
        _fill_round(cv, c.x + 3.5, c.y + 3.5, c.w - 7.0, c.h - 7.0, r - 3.5, acc)
    else:
        _fill_round(cv, c.x, c.y, c.w, c.h, r, white)
        _stroke_round(cv, c.x, c.y, c.w, c.h, r, edge)
    end
end

func _paint_range(cv &: paint.Canvas, node: int, c: _Box, s &: style.Style, u: _Used):
    frac := _range_frac(node)
    acc := _ctl_accent(node, s, u)
    rtl := _is_rtl(s)
    f := rtl ? 1.0 - frac : frac
    th := 4.0
    ty := c.y + c.h / 2.0 - th / 2.0
    _fill_round(cv, c.x, ty, c.w, th, th / 2.0, _grey(224))
    if rtl:
        _fill_round(cv, c.x + c.w * (1.0 - frac), ty, c.w * frac, th, th / 2.0, acc)
    else:
        _fill_round(cv, c.x, ty, c.w * frac, th, th / 2.0, acc)
    end
    d := math.Min(16.0, c.h)
    tx := c.x + (c.w - d) * f
    _fill_round(cv, tx, c.y + (c.h - d) / 2.0, d, d, d / 2.0, acc)
    _fill_round(
        cv, tx + 3.0, c.y + (c.h - d) / 2.0 + 3.0, d - 6.0, d - 6.0, (d - 6.0) / 2.0, _grey(255)
    )
end

func _paint_progress(cv &: paint.Canvas, node: int, c: _Box, s &: style.Style, u: _Used):
    rtl := _is_rtl(s)
    r := math.Min(c.h, 8.0) / 2.0
    ty := c.y + (c.h - r * 2.0) / 2.0
    _fill_round(cv, c.x, ty, c.w, r * 2.0, r, _grey(230))
    acc := _ctl_accent(node, s, u)
    mx := _attr_f(node, "max", 1.0)
    if not _has_attr(_e.dom, node, "value"):
        w := c.w * 0.3
        _fill_round(cv, rtl ? c.x + c.w - w : c.x, ty, w, r * 2.0, r, acc)
        ret
    end
    v := _attr_f(node, "value", 0.0)
    frac := mx > 0.0 ? math.Max(0.0, math.Min(1.0, v / mx)) : 0.0
    if frac > 0.0:
        w := c.w * frac
        _fill_round(cv, rtl ? c.x + c.w - w : c.x, ty, w, r * 2.0, r, acc)
    end
end

func _paint_meter(cv &: paint.Canvas, node: int, c: _Box, s &: style.Style):
    rtl := _is_rtl(s)
    r := math.Min(c.h, 8.0) / 2.0
    ty := c.y + (c.h - r * 2.0) / 2.0
    _fill_round(cv, c.x, ty, c.w, r * 2.0, r, _grey(230))
    mn := _attr_f(node, "min", 0.0)
    mx := _attr_f(node, "max", 1.0)
    v := _attr_f(node, "value", 0.0)
    lo := _attr_f(node, "low", mn)
    hi := _attr_f(node, "high", mx)
    frac := mx > mn ? math.Max(0.0, math.Min(1.0, (v - mn) / (mx - mn))) : 0.0
    mut col := paint.Color {
        r = 16,
        g = 160,
        b = 80,
        a = 255
    }
    if v < lo or v > hi:
        col = paint.Color {
            r = 245,
            g = 166,
            b = 35,
            a = 255
        }
    end
    if frac > 0.0:
        w := c.w * frac
        _fill_round(cv, rtl ? c.x + c.w - w : c.x, ty, w, r * 2.0, r, col)
    end
end

func _paint_select_arrow(cv &: paint.Canvas, c: _Box, s &: style.Style, u: _Used):
    sc := _e.scale
    ax := _is_rtl(s) ? c.x + 4.0 : c.x + c.w - 12.0
    ay := c.y + c.h / 2.0 - 2.0
    mut p := paint.NewPath()
    p.MoveTo(ax * sc, ay * sc)
    p.LineTo((ax + 8.0) * sc, ay * sc)
    p.LineTo((ax + 4.0) * sc, (ay + 4.0) * sc)
    p.Close()
    cv.FillPath(p, paint.FillRule.NonZero, u.color)
    p.Free()
end

func _paint_color_input(cv &: paint.Canvas, node: int, c: _Box, u: _Used):
    v := _control_value(node)
    mut col := paint.Color { a = 255 }
    if v.Len() > 0:
        mut val := style.Value {}
        if style.Parse(style.P_COLOR, v, val) and val.items.Len() > 0:
            col = _ucol(val.items[0].color, u.color)
        end
        val.items.Free()
        val.starts.Free()
    end
    cv.FillRect(_rect(c.x, c.y, c.w, c.h), col)
end

func _fit_of(w: int): paint.ObjectFit:
    switch w:
        style.KW_CONTAIN: ret paint.ObjectFit.Contain end
        style.KW_COVER: ret paint.ObjectFit.Cover end
        style.KW_NONE: ret paint.ObjectFit.None end
        style.KW_SCALE_DOWN: ret paint.ObjectFit.ScaleDown end
    end
    ret paint.ObjectFit.Fill
end

func _paint_image(cv &: paint.Canvas, node: int, b: _Box, g: _Geo, s &: style.Style):
    src := _attr(_e.dom, node, "src")
    if src.Len() == 0:
        ret
    end
    k := _image_index(src)
    if k < 0:
        ret
    end
    if not _img_ok[k]:
        pc := _content_box(node)
        if pc.w > 0.0 and pc.h > 0.0:
            cv.FillRect(_rect(pc.x, pc.y, pc.w, pc.h), _grey(235))
            cv.DrawBorder(
                _rect(pc.x, pc.y, pc.w, pc.h), paint.Radii {}, paint.SolidBorder(1.0, _grey(170))
            )
        end
        ret
    end
    img := _img_canvas[k]
    c := _content_box(node)
    if c.w <= 0.0 or c.h <= 0.0:
        ret
    end
    fit := _fit_of(s.image_fit)
    dst := _rect(c.x, c.y, c.w, c.h)
    rad := _pad_radii(g, b)
    round := _has_radius(rad)
    if fit == paint.ObjectFit.Fill and not round:
        cv.DrawImage(img, dst, 1.0)
        ret
    end
    if round:
        cv.PushRoundedClip(dst, rad)
    else:
        cv.PushClip(dst)
    end
    r := paint.FitImage(fit, img.width, img.height, dst, 0.5, 0.5)
    cv.DrawImage(img, r, 1.0)
    cv.PopClip()
end

func _paint_chrome(cv &: paint.Canvas, node: int, b: _Box, g: _Geo, s &: style.Style, u: _Used):
    nd := _e.dom.nodes[node]
    c := _content_box(node)
    switch nd.k:
        _K_IMAGE:
            _paint_image(cv, node, b, g, s)
            break
        end
        _K_PROGRESS:
            _paint_progress(cv, node, c, s, u)
            break
        end
        _K_METER:
            _paint_meter(cv, node, c, s)
            break
        end
        _K_SELECT:
            _paint_select_arrow(cv, c, s, u)
            break
        end
        _K_INPUT:
            switch _input_type(node):
                "checkbox": _paint_checkbox(cv, node, c, s, u) break end
                "radio": _paint_radio(cv, node, c, s, u) break end
                "range": _paint_range(cv, node, c, s, u) break end
                "color": _paint_color_input(cv, node, c, u) break end
                else: break end
            end
            break
        end
        else:
            break
        end
    end
end

func _paint_state_overlay(cv &: paint.Canvas, node: int, b: _Box, radii: paint.Radii):
    nd := _e.dom.nodes[node]
    if not (nd.k == _K_BUTTON or _is_button_input(node)):
        ret
    end
    c := _e.ctl[node]
    styled := (nd.smask & ((1 << STATE_HOVER) | (1 << STATE_ACTIVE))) != 0
    if styled or _is_disabled_state(node):
        ret
    end
    mut a := 0
    if c.pressed:
        a = 36
    else c.hovered:
        a = 16
    end
    if a > 0:
        cv.FillRoundedRect(_rect(b.x, b.y, b.w, b.h), radii, paint.Color {
            r = 0,
            g = 0,
            b = 0,
            a = a
        })
    end
end

func _scroll_axis_on(ov: int, extent: f64): bool:
    if ov == style.KW_SCROLL:
        ret true
    end
    ret ov == style.KW_AUTO and extent > 0.5
end

func _paint_scrollbars(cv &: paint.Canvas, node: int, b: _Box, g: _Geo, s &: style.Style, u: _Used):
    th := _sb_thickness(s)
    if th <= 0.0 or not _is_scroller(node):
        ret
    end
    mut mx := 0.0
    mut my := 0.0
    _scroll_max(node, mx, my)
    pb := _pad_box(g, b)
    ax := node == 0 ? true : _scroll_axis_on(s.overflow_x, mx)
    ay := node == 0 ? true : _scroll_axis_on(s.overflow_y, my)
    sx := ax and (node != 0 or mx > 0.5) and
        (s.overflow_x == style.KW_AUTO or s.overflow_x == style.KW_SCROLL)
    sy := ay and (node != 0 or my > 0.5) and
        (s.overflow_y == style.KW_AUTO or s.overflow_y == style.KW_SCROLL)
    if not sx and not sy:
        ret
    end
    c := _e.ctl[node]
    rtl := _is_rtl(s)
    track := _ucol(s.scrollbar_track, u.color)
    thumb := _ucol(s.scrollbar_thumb, u.color)
    r := th / 2.0
    if sy:
        h := pb.h - (sx ? th : 0.0)
        x := rtl ? pb.x : pb.x + pb.w - th
        if track.a > 0:
            _fill_round(cv, x, pb.y, th, h, 0.0, track)
        end
        total := my + pb.h
        tl := math.Max(16.0, h * pb.h / math.Max(1.0, total))
        ty := my > 0.0 ? (h - tl) * math.Min(1.0, c.scroll_y / my) : 0.0
        _fill_round(cv, x + 1.0, pb.y + ty + 1.0, th - 2.0, math.Max(0.0, tl - 2.0), r - 1.0, thumb)
    end
    if sx:
        w := pb.w - (sy ? th : 0.0)
        x0 := rtl and sy ? pb.x + th : pb.x
        y := pb.y + pb.h - th
        if track.a > 0:
            _fill_round(cv, x0, y, w, th, 0.0, track)
        end
        total := mx + pb.w
        tl := math.Max(16.0, w * pb.w / math.Max(1.0, total))
        tx := mx > 0.0 ? (w - tl) * math.Min(1.0, c.scroll_x / mx) : 0.0
        _fill_round(cv, x0 + tx + 1.0, y + 1.0, math.Max(0.0, tl - 2.0), th - 2.0, r - 1.0, thumb)
    end
end

func _pp_geo(x &: f64, y &: f64, w &: f64, ih &: f64, n &: int):
    _popup_geometry(x, y, w, ih, n)
end

func _draw_layout(cv &: paint.Canvas, l: typeset.TextLayout, x: f64, y: f64, col: paint.Color):
    each gr in l.runs:
        _draw_grun(cv, l, gr, x, y, col)
    end
end

func _paint_popup(cv &: paint.Canvas):
    if _e.popup < 0 or _e.popup >= _e.boxes.Len() or not _e.boxes[_e.popup].shown:
        ret
    end
    node := _e.popup
    mut x := 0.0
    mut y := 0.0
    mut w := 0.0
    mut ih := 0.0
    mut n := 0
    _pp_geo(x, y, w, ih, n)
    sc := _e.scale
    hgt := ih * (n as f64)
    cv.DrawShadow(
        _rect(x, y, w, hgt),
        paint.Radii {},
        paint.Shadow { offset_y = 2.0 * sc, blur = 6.0 * sc, color = paint.Color { a = 70 } }
    )
    cv.FillRect(_rect(x, y, w, hgt), _grey(255))
    cv.DrawBorder(
        _rect(x, y, w, hgt), paint.Radii {}, paint.SolidBorder(math.Max(1.0, sc), _grey(118))
    )
    mut opts := Vector {} as Vector<int>
    _option_nodes(node, opts)
    sel := _select_index(node)
    c := _e.ctl[node]
    u := _e.us[node]
    rtl := _is_rtl(_e.cs[node])
    top := _popup_top()
    repeat math.MinI(n, opts.Len() - top) in r:
        i := top + r
        oy := y + ih * (r as f64)
        hl := c.anchor == i
        lit := hl or (c.anchor < 0 and i == sel)
        if lit:
            cv.FillRect(_rect(x + 1.0, oy, w - 2.0, ih), paint.Color {
                r = 30,
                g = 144,
                b = 255,
                a = 255
            })
        end
        t := _text_of(_e.dom, opts[i])
        mut spans := Vector {} as Vector<typeset.TextSpan>
        spans.Push(_span_for(node, t))
        mut p := typeset.NewParagraph(_fc, spans, typeset.ParagraphStyle {})
        mut l := typeset.LayoutParagraph(p, _fc, 0.0)
        tx := rtl ? x + w - 4.0 - l.width : x + 4.0
        _draw_layout(cv, l, tx, oy + (ih - l.height) / 2.0, lit ? _grey(255) : u.color)
        typeset.FreeLayout(l)
        typeset.FreeParagraph(p)
        spans.Free()
        _sfree(t)
    end
    opts.Free()
end

func _paint_marker(cv &: paint.Canvas, node: int, b: _Box, s &: style.Style, u: _Used):
    nd := _e.dom.nodes[node]
    if nd.k != _K_ITEM or nd.parent < 0:
        ret
    end
    pk := _e.dom.nodes[nd.parent].k
    if pk != _K_LIST and pk != _K_OLIST:
        ret
    end
    mut base := b.y + u.font
    each k in nd.kids:
        ri := _e.node_run[k]
        if ri >= 0 and _e.runs[ri].has_lay and _e.runs[ri].lay.lines.Len() > 0:
            base = _e.runs[ri].y + _e.runs[ri].lay.lines[0].baseline
            break
        end
    end
    rtl := _is_rtl(s)
    if pk == _K_LIST:
        d := u.font * 0.3
        x := rtl ? b.x + b.w + u.font * 0.6 : b.x - u.font * 0.6 - d
        _fill_round(cv, x, base - u.font * 0.35 - d / 2.0, d, d, d / 2.0, u.color)
        ret
    end
    mut idx := 1
    each sib in _e.dom.nodes[nd.parent].kids:
        if sib == node:
            break
        end
        if _e.dom.nodes[sib].k == _K_ITEM:
            idx++
        end
    end
    mut spans := Vector {} as Vector<typeset.TextSpan>
    label := str.FromInt(idx as i64) + "."
    spans.Push(_span_for(node, label))
    ps := typeset.ParagraphStyle {}
    mut p := typeset.NewParagraph(_fc, spans, ps)
    mut l := typeset.LayoutParagraph(p, _fc, 0.0)
    x := rtl ? b.x + b.w + u.font * 0.4 : b.x - u.font * 0.4 - l.width
    bl := l.lines.Len() > 0 ? l.lines[0].baseline : 0.0
    _draw_layout(cv, l, x, base - bl, u.color)
    typeset.FreeLayout(l)
    typeset.FreeParagraph(p)
    spans.Free()
    _sfree(label)
end
