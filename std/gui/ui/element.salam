package ui

import str
import gui.paint
import gui.style

@en "Element"
@fa "عنصر"
pub struct Element:
    @en "id"
    @fa "شناسه"
    pub id: str = ""
    @en "key"
    @fa "کلید"
    pub key: str = ""

    @en "Exists"
    @fa "وجود دارد"
    pub func Exists(): bool:
        if _web_live():
            ret _web_exists(this.id, this.key)
        end
        ret _el_node(this.id, this.key) >= 0
    end

    @en "Tag"
    @fa "برچسب"
    pub func Tag(): str:
        if _web_live():
            ret _web_tag(this.id, this.key)
        end
        n := _el_node(this.id, this.key)
        if n < 0:
            ret ""
        end
        ret _e.dom.nodes[n].kind
    end

    @en "Text"
    @fa "متن عنصر"
    pub func Text(): str:
        if _web_live():
            ret _web_text(this.id, this.key)
        end
        n := _el_node(this.id, this.key)
        if n < 0:
            ret str.Clone("")
        end
        ret _text_of(_e.dom, n)
    end

    @en "SetText"
    @fa "تنظیم متن"
    pub func SetText(text: str):
        if _web_live():
            _web_set_text(this.id, this.key, text)
            ret
        end
        n := _el_node(this.id, this.key)
        if n >= 0:
            _el_set_text(n, text)
        end
    end

    @en "Value"
    @fa "مقدار عنصر"
    pub func Value(): str:
        if _web_live():
            ret _web_value(this.id, this.key)
        end
        n := _el_node(this.id, this.key)
        if n < 0 or not _is_control(n):
            ret ""
        end
        ret _control_value(n)
    end

    @en "SetValue"
    @fa "تنظیم مقدار"
    pub func SetValue(value: str):
        if _web_live():
            _web_set_value(this.id, this.key, value)
            ret
        end
        n := _el_node(this.id, this.key)
        if n >= 0 and _is_control(n):
            keep := str.Clone(value)
            _set_value(n, keep)
            mut c := _e.ctl.Ref(n)
            c.caret = keep.Len()
            c.anchor = c.caret
            if _e.dom.nodes[n].k == _K_SELECT:
                c.selected = _option_index_of(n, keep)
            end
            _refresh_control(n)
            _e.states_dirty = true
        end
    end

    @en "Checked"
    @fa "تیک خورده است"
    pub func Checked(): bool:
        if _web_live():
            ret _web_checked(this.id, this.key)
        end
        n := _el_node(this.id, this.key)
        ret n >= 0 and _is_checked(n)
    end

    @en "SetChecked"
    @fa "تنظیم تیک"
    pub func SetChecked(is_on: bool):
        if _web_live():
            _web_set_checked(this.id, this.key, is_on)
            ret
        end
        n := _el_node(this.id, this.key)
        if n >= 0 and _is_checked(n) != is_on:
            if is_on and _input_type(n) == "radio":
                _toggle_check(n)
            else:
                mut c := _e.ctl.Ref(n)
                c.has_checked = true
                c.checked = is_on
                _e.states_dirty = true
            end
        end
    end

    @en "Focus"
    @fa "تمرکز"
    pub func Focus():
        if _web_live():
            _web_focus(this.id, this.key)
            ret
        end
        n := _el_node(this.id, this.key)
        if n >= 0:
            _set_focus(n, true)
            _reveal(n)
        end
    end

    @en "ScrollIntoView"
    @fa "نمایان کردن"
    pub func ScrollIntoView():
        if _web_live():
            _web_scroll_to(this.id, this.key)
            ret
        end
        n := _el_node(this.id, this.key)
        if n >= 0:
            _reveal(n)
        end
    end

    @en "Click"
    @fa "کلیک"
    pub func Click():
        if _web_live():
            _web_do(this.id, this.key, "click")
            ret
        end
        n := _el_node(this.id, this.key)
        if n >= 0:
            _click(n, 0, 1)
        end
    end

    @en "Attr"
    @fa "ویژگی"
    pub func Attr(name: str): str:
        if _web_live():
            ret _web_attr(this.id, this.key, name)
        end
        n := _el_node(this.id, this.key)
        if n < 0:
            ret ""
        end
        ret _attr(_e.dom, n, name)
    end

    @en "SetAttr"
    @fa "تنظیم ویژگی"
    pub func SetAttr(name: str, value: str):
        if _web_live():
            _web_set_attr(this.id, this.key, name, value)
            ret
        end
        n := _el_node(this.id, this.key)
        if n >= 0:
            _set_attr(_e.dom, n, name, value)
            _rebuild_now()
            _e.states_dirty = true
        end
    end

    @en "Style"
    @fa "سبک محاسبه شده"
    pub func Style(): style.Style:
        n := _el_node(this.id, this.key)
        if n < 0:
            ret style.Style {}
        end
        ret _style_of(n)
    end

    @en "Rect"
    @fa "مستطیل"
    pub func Rect(): paint.Rect:
        if _web_live():
            ret _web_rect(this.id, this.key)
        end
        n := _el_node(this.id, this.key)
        if n < 0 or n >= _e.boxes.Len():
            ret paint.Rect {}
        end
        b := _e.boxes[n]
        ret paint.Rect {
            x = b.x,
            y = b.y,
            width = b.w,
            height = b.h
        }
    end
end

func _el_node(id: str, key: str): int:
    if not _e.ready:
        ret -1
    end
    if id.Len() > 0:
        ret _find_id(id)
    end
    ret _find_key(key)
end

func _option_index_of(node: int, value: str): int:
    mut opts := Vector {} as Vector<int>
    defer opts.Free()
    _option_nodes(node, opts)
    repeat opts.Len() in i:
        v := _option_value(opts[i])
        same := v == value
        _sfree(v)
        if same:
            ret i
        end
    end
    ret -1
end

func _el_set_text(n: int, text: str):
    if _e.focus >= 0 and _is_ancestor(n, _e.focus) and _e.focus != n:
        _e.focus = -1
    end
    mut nd := _e.dom.nodes.Ref(n)
    if nd.kids.Len() == 1 and _e.dom.nodes[nd.kids[0]].k == _K_TEXT:
        mut tn0 := _e.dom.nodes.Ref(nd.kids[0])
        keep := str.Clone(text)
        _sfree(tn0.text)
        tn0.text = keep
        _rebuild_now()
        ret
    end
    nd.kids.Clear()
    id := _new_node(_e.dom, "#text", n)
    mut tn := _e.dom.nodes.Ref(id)
    tn.text = str.Clone(text)
    _e.ctl.Push(_new_ctl())
    _rebuild_now()
end

func _rebuild_now():
    _e.dirty_dom = false
    _style_all()
    _relayout_all()
    _e.full = true
end

@en "ById"
@fa "با شناسه"
pub func ById(id: str): Element:
    ret Element { id = id }
end

@en "ByKey"
@fa "با کلید"
pub func ByKey(key: str): Element:
    ret Element { key = key }
end

@en "CurrentEvent"
@fa "رخداد کنونی"
pub func CurrentEvent(): Event:
    if _web_live():
        ret _web_event()
    end
    ret _event
end

@en "Stop"
@fa "توقف"
pub func Stop():
    _e.quit = true
end

@en "OnCloseRequest"
@fa "هنگام درخواست بستن"
pub func OnCloseRequest(handler: func () bool):
    _close_hook = handler
    _close_set = true
end

@en "KeyboardDismiss"
@fa "بستن صفحه کلید"
pub func KeyboardDismiss(on_tap: bool, on_drag: bool):
    _kb_tap = on_tap
    _kb_drag = on_drag
end

@en "OnPause"
@fa "هنگام توقف"
pub func OnPause(handler: func ()):
    _pause_hook = handler
end

@en "OnResume"
@fa "هنگام ادامه"
pub func OnResume(handler: func ()):
    _resume_hook = handler
end

@en "OnLowMemory"
@fa "هنگام کمبود حافظه"
pub func OnLowMemory(handler: func ()):
    _memory_hook = handler
end

@en "OnSaveState"
@fa "هنگام ذخیره وضعیت"
pub func OnSaveState(handler: func () str):
    _save_hook = handler
end

@en "HideWindow"
@fa "پنهان کردن پنجره"
pub func HideWindow():
    if _e.has_win:
        _e.win.Hide()
    end
end

@en "ShowWindow"
@fa "نمایش پنجره"
pub func ShowWindow():
    if _e.has_win:
        _e.win.Show()
        _e.win.Focus()
        _e.full = true
    end
end

@en "WindowVisible"
@fa "پنجره نمایان است"
pub func WindowVisible(): bool:
    ret _e.has_win and _e.win.IsVisible()
end

@en "SetUrlOpener"
@fa "تنظیم بازکننده نشانی"
pub func SetUrlOpener(opener: func (str) bool):
    _opener = opener
    _opener_set = true
end

@en "SetNavigator"
@fa "تنظیم راهبر"
pub func SetNavigator(navigator: func (str) bool):
    _navigator = navigator
    _navigator_set = true
end

@en "SetBack"
@fa "تنظیم عقب"
pub func SetBack(handler: func () bool):
    _back = handler
    _back_set = true
end

@en "SetForward"
@fa "تنظیم جلو"
pub func SetForward(handler: func () bool):
    _forward = handler
    _forward_set = true
end

@en "SetAfterUpdate"
@fa "تنظیم پس از به روز رسانی"
pub func SetAfterUpdate(handler: func () bool):
    _after_update = handler
    _after_update_set = true
end

@en "OpenedUrls"
@fa "نشانی های باز شده"
pub func OpenedUrls(): Vector<str>:
    ret _opened_urls
end

@en "OpenUrl"
@fa "باز کردن نشانی"
pub func OpenUrl(url: str): bool:
    if _web_live():
        _web_open(url)
        ret true
    end
    _navigate(url)
    ret true
end
