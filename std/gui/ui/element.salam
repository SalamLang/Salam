package ui

import str
import gui.paint

@en "Element"
@fa "عنصر"
pub struct Element:
    @en "id"
    @fa "شناسه"
    pub id: str = ""

    @en "Exists"
    @fa "وجود دارد"
    pub func Exists(): bool:
        ret _find_id(this.id) >= 0
    end

    @en "Tag"
    @fa "برچسب"
    pub func Tag(): str:
        n := _find_id(this.id)
        if n < 0:
            ret ""
        end
        ret _e.dom.nodes[n].tag
    end

    @en "Text"
    @fa "متن عنصر"
    pub func Text(): str:
        n := _find_id(this.id)
        if n < 0:
            ret str.Clone("")
        end
        ret _text_of(_e.dom, n)
    end

    @en "SetText"
    @fa "تنظیم متن"
    pub func SetText(text: str):
        n := _find_id(this.id)
        if n >= 0:
            _el_set_text(n, text)
        end
    end

    @en "Value"
    @fa "مقدار عنصر"
    pub func Value(): str:
        n := _find_id(this.id)
        if n < 0:
            ret ""
        end
        ret _control_value(n)
    end

    @en "SetValue"
    @fa "تنظیم مقدار"
    pub func SetValue(value: str):
        n := _find_id(this.id)
        if n >= 0:
            _set_value(n, value)
            mut c := _e.ctl.ref(n)
            c.caret = value.len()
            c.anchor = c.caret
            if _e.dom.nodes[n].tag == "select":
                c.selected = _option_index_of(n, value)
            end
            _refresh_control(n)
        end
    end

    @en "Checked"
    @fa "تیک خورده است"
    pub func Checked(): bool:
        n := _find_id(this.id)
        ret n >= 0 and _is_checked(n)
    end

    @en "SetChecked"
    @fa "تنظیم تیک"
    pub func SetChecked(is_on: bool):
        n := _find_id(this.id)
        if n >= 0 and _is_checked(n) != is_on:
            if is_on and _input_type(n) == "radio":
                _toggle_check(n)
            else:
                mut c := _e.ctl.ref(n)
                c.has_checked = true
                c.checked = is_on
                _restyle_attr(n)
            end
        end
    end

    @en "Focus"
    @fa "تمرکز"
    pub func Focus():
        n := _find_id(this.id)
        if n >= 0:
            _set_focus(n, true)
        end
    end

    @en "Click"
    @fa "کلیک"
    pub func Click():
        n := _find_id(this.id)
        if n >= 0:
            _click(n, 0, 1)
        end
    end

    @en "HasClass"
    @fa "دارای کلاس"
    pub func HasClass(name: str): bool:
        n := _find_id(this.id)
        if n < 0:
            ret false
        end
        mut parts := str.Fields(_attr(_e.dom, n, "class"))
        defer parts.free()
        each p in parts:
            if p == name:
                ret true
            end
        end
        ret false
    end

    @en "AddClass"
    @fa "افزودن کلاس"
    pub func AddClass(name: str):
        n := _find_id(this.id)
        if n >= 0 and not this.HasClass(name):
            old := _attr(_e.dom, n, "class")
            nv := old.len() > 0 ? old + " " + name : name
            _set_attr(_e.dom, n, "class", nv)
            _e.dirty_dom = true
        end
    end

    @en "RemoveClass"
    @fa "حذف کلاس"
    pub func RemoveClass(name: str):
        n := _find_id(this.id)
        if n < 0:
            ret
        end
        mut parts := str.Fields(_attr(_e.dom, n, "class"))
        defer parts.free()
        mut b := str.NewBuilder()
        mut changed := false
        each p in parts:
            if p == name:
                changed = true
                continue
            end
            if str.BufLen(b) > 0:
                str.BufAppend(b, " ")
            end
            str.BufAppend(b, p)
        end
        nv := str.BufStr(b)
        str.BufFree(b)
        if changed:
            _set_attr(_e.dom, n, "class", nv)
            _e.dirty_dom = true
        end
    end

    @en "Attr"
    @fa "ویژگی"
    pub func Attr(name: str): str:
        n := _find_id(this.id)
        if n < 0:
            ret ""
        end
        ret _attr(_e.dom, n, name)
    end

    @en "SetAttr"
    @fa "تنظیم ویژگی"
    pub func SetAttr(name: str, value: str):
        n := _find_id(this.id)
        if n >= 0:
            _set_attr(_e.dom, n, name, value)
            _e.dirty_dom = true
        end
    end

    @en "Rect"
    @fa "مستطیل"
    pub func Rect(): paint.Rect:
        n := _find_id(this.id)
        if n < 0 or n >= _e.boxes.len():
            ret paint.Rect {}
        end
        b := _e.boxes[n]
        ret paint.Rect { x = b.x, y = b.y, width = b.w, height = b.h }
    end
end

func _option_index_of(node: int, value: str): int:
    mut opts := Vector {} as Vector<int>
    defer opts.free()
    _option_nodes(node, opts)
    repeat opts.len() in i:
        v := _option_value(opts[i])
        same := v == value
        _sfree(v)
        if same:
            ret i
        end
    end
    ret -1
end

func _el_set_text(n: int, text: str):
    mut nd := _e.dom.nodes.ref(n)
    nd.kids.clear()
    id := _new_node(_e.dom, "#text", n)
    mut tn := _e.dom.nodes.ref(id)
    tn.text = str.Clone(text)
    _e.ctl.push(_new_ctl())
    _e.dirty_dom = true
end

@en "ById"
@fa "با شناسه"
pub func ById(id: str): Element:
    ret Element { id = id }
end
