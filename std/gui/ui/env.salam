package ui

import math

mut _env_on := false
mut _env_calls := 0
mut _env_fn := (_w: int, _h: int, _d: bool, _t: bool, _r: bool, _c: bool, _l: bool): _env_calls++ end

func _env_push():
    if not _env_on:
        ret
    end
    w := math.Round(_e.width) as int
    h := math.Round(_e.height) as int
    fn := _env_fn
    _env_calls++
    dir := _bd.dir.Len() > 0 ? _bd.dir : _e.dom.dir
    fn(w, h, _e.dark, false, false, false, dir == "rtl")
    if _sc_cur < 0:
        _e.dirty_view = true
    end
end
