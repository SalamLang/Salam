package ui

import str
import math
import gui.style
import gui.typeset
import gui.window

func _make_event(kind: str, node: int): Event:
    mut ev := Event { kind = kind }
    if node >= 0 and node < _e.dom.nodes.Len():
        ev.target = _attr(_e.dom, node, "id")
        if _is_control(node):
            ev.value = _control_value(node)
            ev.checked = _is_checked(node)
        end
    end
    ev.x = _e.mx
    ev.y = _e.my
    ret ev
end

func _fire_ev(node: int, ev: Event, bubbles: bool): bool:
    mut n := node
    mut any := false
    until n >= 0:
        if n < _e.dom.nodes.Len() and _e.dom.nodes[n].k != _K_TEXT:
            repeat _e.dom.ev_node.Len() in k:
                if _e.dom.ev_node[k] == n and _e.dom.ev_kind[k] == ev.kind:
                    f := _e.dom.ev_fn[k]
                    _event = ev
                    f()
                    _e.handlers_run++
                    any = true
                    _e.dirty_view = true
                end
            end
        end
        if not bubbles:
            break
        end
        n = n < _e.dom.nodes.Len() ? _e.dom.nodes[n].parent : -1
    end
    ret any
end

func _fire(node: int, kind: str, bubbles: bool): bool:
    ret _fire_ev(node, _make_event(kind, node), bubbles)
end

func _has_handler(node: int, kind: str): bool:
    repeat _e.dom.ev_node.Len() in k:
        if _e.dom.ev_node[k] == node and _e.dom.ev_kind[k] == kind:
            ret true
        end
    end
    ret false
end

func _depth(node: int): int:
    mut d := 0
    mut n := _e.dom.nodes[node].parent
    until n >= 0:
        d++
        n = _e.dom.nodes[n].parent
    end
    ret d
end

func _kid_pos(parent: int, kid: int): int:
    if parent < 0:
        ret 0
    end
    ks := _e.dom.nodes[parent].kids
    repeat ks.Len() in i:
        if ks[i] == kid:
            ret i
        end
    end
    ret -1
end

func _live(node: int): bool:
    mut n := node
    until n > 0:
        p := _e.dom.nodes[n].parent
        if p < 0 or _kid_pos(p, n) < 0:
            ret false
        end
        n = p
    end
    ret n == 0
end

func _paint_before(a: int, b: int): bool:
    if a == b:
        ret false
    end
    mut x := a
    mut y := b
    mut da := _depth(a)
    mut db := _depth(b)
    until da > db:
        x = _e.dom.nodes[x].parent
        da--
    end
    if x == b:
        ret false
    end
    until db > da:
        y = _e.dom.nodes[y].parent
        db--
    end
    if y == a:
        ret true
    end
    until _e.dom.nodes[x].parent != _e.dom.nodes[y].parent and _e.dom.nodes[x].parent >= 0 and
        _e.dom.nodes[y].parent >= 0:
        x = _e.dom.nodes[x].parent
        y = _e.dom.nodes[y].parent
    end
    la := _e.cs[x].layer
    lb := _e.cs[y].layer
    if la != lb:
        ret la < lb
    end
    p := _e.dom.nodes[x].parent
    ret _kid_pos(p, x) < _kid_pos(p, y)
end

func _inside(b: _Box, x: f64, y: f64): bool:
    ret b.shown and x >= b.x and x < b.x + b.w and y >= b.y and y < b.y + b.h and x >= b.clip_x0 and
        x < b.clip_x1 and y >= b.clip_y0 and y < b.clip_y1
end

func _hit(x0: f64, y0: f64): int:
    mut best := -1
    repeat _e.dom.nodes.Len() in n:
        if n >= _e.boxes.Len() or n >= _e.cs.Len():
            break
        end
        b := _e.boxes[n]
        if not b.shown or _e.dom.nodes[n].k == _K_TEXT:
            continue
        end
        s := _e.cs[n]
        if not s.interactive or not s.visible:
            continue
        end
        mut lx := x0
        mut ly := y0
        if _e.xf_any:
            _to_local(n, x0, y0, lx, ly)
        end
        if not _inside(b, lx, ly):
            continue
        end
        if best >= 0 and not _paint_before(best, n):
            continue
        end
        best = n
    end
    if best < 0:
        ret 0
    end
    ret best
end

func _focusable(node: int): bool:
    if node < 0 or node >= _e.dom.nodes.Len() or node >= _e.boxes.Len() or node >= _e.cs.Len():
        ret false
    end
    if not _e.boxes[node].shown or _is_disabled(node) or not _e.cs[node].interactive:
        ret false
    end
    nd := _e.dom.nodes[node]
    if nd.k == _K_TEXT or nd.k == _K_PAGE:
        ret false
    end
    if _has_attr(_e.dom, node, "tabindex"):
        ret true
    end
    switch nd.k:
        _K_BUTTON, _K_SELECT, _K_TEXTAREA, _K_SUMMARY:
            ret true
        end
        _K_INPUT:
            ret _input_type(node) != "hidden"
        end
        _K_LINK:
            ret _has_attr(_e.dom, node, "href")
        end
        else:
            ret false
        end
    end
    ret false
end

func _focus_target(node: int): int:
    mut n := node
    until n > 0:
        if _focusable(n):
            ret n
        end
        n = _e.dom.nodes[n].parent
    end
    ret -1
end

func _set_hover(target: int):
    if _e.hover >= 0 and _e.hover < _e.ctl.Len():
        mut n := _e.hover
        until n >= 0:
            mut c := _e.ctl.Ref(n)
            c.hovered = false
            n = _e.dom.nodes[n].parent
        end
    end
    _e.hover = target
    mut m := target
    until m >= 0:
        mut c2 := _e.ctl.Ref(m)
        c2.hovered = true
        m = _e.dom.nodes[m].parent
    end
    _e.states_dirty = true
end

func _set_active(target: int):
    if _e.active >= 0 and _e.active < _e.ctl.Len():
        mut n := _e.active
        until n >= 0:
            mut c := _e.ctl.Ref(n)
            c.pressed = false
            n = _e.dom.nodes[n].parent
        end
    end
    _e.active = target
    mut m := target
    until m >= 0:
        mut c2 := _e.ctl.Ref(m)
        c2.pressed = true
        m = _e.dom.nodes[m].parent
    end
    _e.states_dirty = true
end

func _remember_committed(node: int):
    v := _control_value(node)
    mut c := _e.ctl.Ref(node)
    c.preedit = ""
    c.value_attr = str.Clone(v)
end

func _maybe_change(node: int):
    if not _is_text_input(node):
        ret
    end
    v := _control_value(node)
    if v != _e.ctl[node].value_attr:
        _fire(node, "change", true)
    end
end

func _set_focus(node: int, visible: bool):
    old := _e.focus
    if old == node:
        if node >= 0:
            mut c := _e.ctl.Ref(node)
            if c.focus_visible != visible:
                c.focus_visible = visible
                _e.states_dirty = true
            end
        end
        ret
    end
    _e.focus = node
    if old >= 0 and old < _e.ctl.Len():
        mut c := _e.ctl.Ref(old)
        c.focused = false
        c.focus_visible = false
        c.anchor = c.caret
        _fire(old, "blur", false)
        _fire(old, "focusout", true)
        if _e.dom.nodes[old].k != _K_SELECT or _e.popup != old:
            _close_popup()
        end
        _maybe_change(old)
    end
    if node >= 0:
        mut c := _e.ctl.Ref(node)
        c.focused = true
        c.focus_visible = visible or _is_text_input(node)
        if _is_text_input(node):
            v := _control_value(node)
            mut c2 := _e.ctl.Ref(node)
            if visible:
                c2.anchor = 0
                c2.caret = v.Len()
            end
            _remember_committed(node)
        end
        _fire(node, "focus", false)
        _fire(node, "focusin", true)
    end
    _e.states_dirty = true
end

func _tab_order(): Vector<int>:
    mut pos := Vector {} as Vector<int>
    mut zero := Vector {} as Vector<int>
    repeat _e.dom.nodes.Len() in n:
        if _focusable(n) and _live(n):
            ti := _attr(_e.dom, n, "tabindex")
            v := ti.Len() > 0 ? ti.ToInt() : 0
            if v > 0:
                pos.Push(n)
            else v == 0:
                zero.Push(n)
            end
        end
    end
    repeat pos.Len() in i:
        mut j := i
        until j > 0 and _attr(
            _e.dom, pos[j - 1], "tabindex"
        ).ToInt() > _attr(_e.dom, pos[j], "tabindex").ToInt():
            t := pos[j - 1]
            pos[j - 1] = pos[j]
            pos[j] = t
            j--
        end
    end
    each z in zero:
        pos.Push(z)
    end
    zero.Free()
    ret pos
end

func _tab(back: bool):
    mut order := _tab_order()
    defer order.Free()
    if order.Len() == 0:
        ret
    end
    mut idx := -1
    repeat order.Len() in i:
        if order[i] == _e.focus:
            idx = i
        end
    end
    mut next := 0
    if back:
        next = idx <= 0 ? order.Len() - 1 : idx - 1
    else:
        next = idx < 0 or idx >= order.Len() - 1 ? 0 : idx + 1
    end
    _set_focus(order[next], true)
    _reveal(order[next])
end

func _reveal(node: int):
    if node < 0 or node >= _e.boxes.Len() or not _e.boxes[node].shown:
        ret
    end
    mut a := _e.dom.nodes[node].parent
    until a >= 0:
        if _is_scroller(a):
            b := _e.boxes[node]
            pb := _padding_box(a)
            c := _e.ctl[a]
            mut nx := c.scroll_x
            mut ny := c.scroll_y
            if b.y < pb.y:
                ny = c.scroll_y - (pb.y - b.y)
            else b.y + b.h > pb.y + pb.h:
                ny = c.scroll_y + math.Min(b.y - pb.y, b.y + b.h - pb.y - pb.h)
            end
            if b.x < pb.x:
                nx = c.scroll_x - (pb.x - b.x)
            else b.x + b.w > pb.x + pb.w:
                nx = c.scroll_x + math.Min(b.x - pb.x, b.x + b.w - pb.x - pb.w)
            end
            if _set_scroll(a, nx, ny):
                _place_all()
                _fire(a, "scroll", false)
            end
        end
        a = _e.dom.nodes[a].parent
    end
end

func _find_id(id: str): int:
    if id.Len() == 0:
        ret -1
    end
    repeat _e.dom.nodes.Len() in n:
        if _e.dom.nodes[n].k != _K_TEXT and _attr(_e.dom, n, "id") == id and _live(n):
            ret n
        end
    end
    ret -1
end

func _find_key(key: str): int:
    if key.Len() == 0:
        ret -1
    end
    repeat _e.dom.nodes.Len() in n:
        if _e.dom.nodes[n].k != _K_TEXT and _attr(_e.dom, n, "key") == key and _live(n):
            ret n
        end
    end
    ret -1
end

func _first_control(node: int): int:
    each k in _e.dom.nodes[node].kids:
        if _is_control(k) or _e.dom.nodes[k].k == _K_BUTTON:
            ret k
        end
        r := _first_control(k)
        if r >= 0:
            ret r
        end
    end
    ret -1
end

func _toggle_check(node: int):
    t := _input_type(node)
    is_on := _is_checked(node)
    if t == "radio":
        if is_on:
            ret
        end
        name := _attr(_e.dom, node, "name")
        if name.Len() > 0:
            form := _ancestor_k(node, _K_FORM)
            repeat _e.dom.nodes.Len() in n:
                if n != node and _e.dom.nodes[n].k == _K_INPUT and _input_type(n) == "radio" and
                    _attr(
                        _e.dom, n, "name"
                    ) == name and _ancestor_k(n, _K_FORM) == form:
                    mut c := _e.ctl.Ref(n)
                    c.has_checked = true
                    c.checked = false
                end
            end
        end
    end
    mut c := _e.ctl.Ref(node)
    c.has_checked = true
    c.checked = t == "radio" ? true : not is_on
    _e.states_dirty = true
    _fire(node, "input", true)
    _fire(node, "change", true)
end

func _submit(form: int):
    if form < 0:
        ret
    end
    _fire(form, "submit", true)
end

func _reset_form(form: int):
    if form < 0:
        ret
    end
    repeat _e.dom.nodes.Len() in n:
        if n != form and _ancestor_k(n, _K_FORM) == form and _is_live_ctl(n):
            mut c := _e.ctl.Ref(n)
            c.has_value = false
            c.has_checked = false
            c.selected = -1
            c.caret = 0
            c.anchor = 0
            _e.dirty_dom = true
        end
    end
    _e.states_dirty = true
    _fire(form, "reset", true)
end

func _is_live_ctl(n: int): bool:
    ret n < _e.ctl.Len() and _e.dom.nodes[n].k != _K_TEXT
end

func _history(dir: int): bool:
    if dir < 0 and _back_set:
        ret _back()
    end
    if dir > 0 and _forward_set:
        ret _forward()
    end
    ret false
end

func _navigate(url: str):
    _opened_urls.Push(str.Clone(url))
    if url.StartsWith("http://") or url.StartsWith("https://") or url.StartsWith("mailto:"):
        if _opener_set:
            _opener(url)
        else:
            _open_url_default(url)
        end
        ret
    end
    if url.StartsWith("#"):
        target := _find_id(url.Substr(1, url.Len() - 1))
        if target >= 0:
            _reveal(target)
        end
        ret
    end
    if _navigator_set:
        _navigator(url)
    end
end

func _activate(node: int):
    k := _e.dom.nodes[node].k
    a := _ancestor_k(node, _K_LINK)
    if a >= 0 and _has_attr(_e.dom, a, "href"):
        _navigate(_attr(_e.dom, a, "href"))
        ret
    end
    lab := _ancestor_k(node, _K_LABEL)
    if lab >= 0 and not _is_control(node) and k != _K_BUTTON:
        mut target := _find_id(_attr(_e.dom, lab, "for"))
        if target < 0:
            target = _first_control(lab)
        end
        if target >= 0 and not _is_disabled(target):
            if _e.dom.nodes[target].k == _K_INPUT and
                (_input_type(target) == "checkbox" or _input_type(target) == "radio"):
                _toggle_check(target)
                _fire(target, "click", true)
            else:
                _set_focus(target, false)
            end
        end
        ret
    end
    if _is_disabled(node):
        ret
    end
    if k == _K_INPUT:
        it := _input_type(node)
        if it == "checkbox" or it == "radio":
            ret
        end
        if it == "submit":
            _submit(_ancestor_k(node, _K_FORM))
        else it == "reset":
            _reset_form(_ancestor_k(node, _K_FORM))
        end
        ret
    end
    btn := _ancestor_k(node, _K_BUTTON)
    if btn >= 0 and not _is_disabled(btn):
        bt := _attr(_e.dom, btn, "type")
        form := _ancestor_k(btn, _K_FORM)
        if form >= 0 and (bt.Len() == 0 or bt == "submit"):
            _submit(form)
        else form >= 0 and bt == "reset":
            _reset_form(form)
        end
        ret
    end
    sum := _ancestor_k(node, _K_SUMMARY)
    if sum >= 0:
        det := _e.dom.nodes[sum].parent
        if det >= 0 and _e.dom.nodes[det].k == _K_DETAILS:
            mut c := _e.ctl.Ref(det)
            c.open = not c.open
            _e.states_dirty = true
            _e.dirty_dom = true
            _fire(det, "toggle", false)
        end
        ret
    end
    if k == _K_SELECT:
        if _e.popup == node:
            _close_popup()
        else:
            _open_popup(node)
        end
    end
end

func _popup_geometry(px &: f64, py &: f64, w &: f64, ih &: f64, n &: int):
    node := _e.popup
    b := _e.boxes[node]
    mut opts := Vector {} as Vector<int>
    _option_nodes(node, opts)
    n = opts.Len()
    opts.Free()
    ih = math.Max(20.0, _e.us[node].line + 6.0)
    px = b.x
    py = b.y + b.h
    w = b.w
end

func _damage_popup():
    _e.full = true
end

func _open_popup(node: int):
    _close_popup()
    _e.popup = node
    mut c := _e.ctl.Ref(node)
    c.anchor = _select_index(node)
    _damage_popup()
end

func _close_popup():
    if _e.popup >= 0:
        _damage_popup()
    end
    _e.popup = -1
end

func _popup_hit(x: f64, y: f64): int:
    if _e.popup < 0:
        ret -2
    end
    mut px := 0.0
    mut py := 0.0
    mut w := 0.0
    mut ih := 0.0
    mut n := 0
    _popup_geometry(px, py, w, ih, n)
    if x >= px and x < px + w and y >= py and y < py + ih * (n as f64):
        ret ((y - py) / ih) as int
    end
    ret -1
end

func _choose_option(node: int, i: int):
    old := _select_index(node)
    mut c := _e.ctl.Ref(node)
    c.selected = i
    mut opts := Vector {} as Vector<int>
    _option_nodes(node, opts)
    if i >= 0 and i < opts.Len():
        _set_value(node, _option_value(opts[i]))
    end
    opts.Free()
    _refresh_control(node)
    _e.states_dirty = true
    if old != i:
        _fire(node, "input", true)
        _fire(node, "change", true)
    end
end

func _cursor_for(node: int): window.Cursor:
    if node < 0 or node >= _e.cs.Len():
        ret window.Cursor.Default
    end
    switch _e.cs[node].cursor:
        style.KW_POINTER: ret window.Cursor.Pointer end
        style.KW_TEXT: ret window.Cursor.Text end
        style.KW_WAIT, style.KW_PROGRESS: ret window.Cursor.Wait end
        style.KW_CROSSHAIR: ret window.Cursor.Crosshair end
        style.KW_MOVE, style.KW_GRAB, style.KW_GRABBING: ret window.Cursor.Move end
        style.KW_NOT_ALLOWED: ret window.Cursor.NotAllowed end
        style.KW_RESIZE_X: ret window.Cursor.ResizeHorizontal end
        style.KW_RESIZE_Y: ret window.Cursor.ResizeVertical end
        style.KW_NONE: ret window.Cursor.Hidden end
        else: break end
    end
    ret window.Cursor.Default
end

func _pointer_move(x: f64, y: f64):
    _e.mx = x
    _e.my = y
    if _e.capture >= 0 and _e.drag_sel and _is_text_input(_e.capture):
        mut c := _e.ctl.Ref(_e.capture)
        c.caret = _caret_from_point(_e.capture, x, y)
        _scroll_caret(_e.capture)
        _damage_node(_e.capture)
        ret
    end
    if _e.capture >= 0 and _e.dom.nodes[_e.capture].k == _K_INPUT and
        _input_type(_e.capture) == "range":
        _range_set(_e.capture, x)
        ret
    end
    if _e.popup >= 0:
        i := _popup_hit(x, y)
        if i >= 0 and _e.ctl[_e.popup].anchor != i:
            mut c := _e.ctl.Ref(_e.popup)
            c.anchor = i
            _damage_popup()
        end
    end
    t := _hit(x, y)
    if t != _e.hover:
        old := _e.hover
        if old >= 0:
            _fire(old, "mouseout", true)
            _fire(old, "pointerout", true)
            _fire(old, "mouseleave", false)
            _fire(old, "pointerleave", false)
        end
        _set_hover(t)
        _fire(t, "mouseover", true)
        _fire(t, "pointerover", true)
        _fire(t, "mouseenter", false)
        _fire(t, "pointerenter", false)
    end
    _fire(t, "mousemove", true)
    _fire(t, "pointermove", true)
    if _e.has_win:
        mut cur := _cursor_for(t)
        if cur == window.Cursor.Default and _is_text_input(t):
            cur = window.Cursor.Text
        end
        _e.win.SetCursor(cur)
    end
end

func _range_bounds(node: int, mn &: f64, mx &: f64, step &: f64):
    mn = 0.0
    mx = 100.0
    step = 1.0
    if _has_attr(_e.dom, node, "min"):
        mn = _attr(_e.dom, node, "min").ToFloat()
    end
    if _has_attr(_e.dom, node, "max"):
        mx = _attr(_e.dom, node, "max").ToFloat()
    end
    if _has_attr(_e.dom, node, "step"):
        step = _attr(_e.dom, node, "step").ToFloat()
    end
end

func _range_set(node: int, x0: f64):
    mut x := x0
    mut _y := 0.0
    _to_local(node, x0, 0.0, x, _y)
    c := _content_box(node)
    mut frac := (x - c.x - 8.0) / math.Max(1.0, c.w - 16.0)
    frac = math.Max(0.0, math.Min(1.0, frac))
    mut mn := 0.0
    mut mx := 100.0
    mut step := 1.0
    _range_bounds(node, mn, mx, step)
    mut v := mn + (mx - mn) * frac
    if step > 0.0:
        v = mn + math.Round((v - mn) / step) * step
    end
    nv := str.FromFloat(v)
    if nv != _control_value(node):
        _set_value(node, nv)
        _damage_node(node)
        _fire(node, "input", true)
        _fire(node, "change", true)
    end
    _sfree(nv)
end

func _pointer_down(x: f64, y: f64, button: int, clicks: int, mods: int):
    if button == 3 or button == 4:
        if _history(button == 3 ? 0 - 1 : 1):
            ret
        end
    end
    _e.mx = x
    _e.my = y
    if _e.popup >= 0:
        pi := _popup_hit(x, y)
        if pi >= 0:
            sel := _e.popup
            _close_popup()
            _choose_option(sel, pi)
            _e.capture = -2
            ret
        end
        b := _e.boxes[_e.popup]
        if not _inside(b, x, y):
            _close_popup()
        end
    end
    t := _hit(x, y)
    _e.capture = t
    _e.last_click = t
    _set_active(t)
    mut ev := _make_event("mousedown", t)
    ev.button = button
    ev.modifiers = mods
    _fire_ev(t, ev, true)
    ev.kind = "pointerdown"
    _fire_ev(t, ev, true)
    if button != 0:
        ret
    end
    ft := _focus_target(t)
    _set_focus(ft, false)
    if ft >= 0 and _is_text_input(ft):
        off := _caret_from_point(ft, x, y)
        mut c := _e.ctl.Ref(ft)
        c.caret = off
        if (mods & window.mod_shift) == 0:
            c.anchor = off
        end
        if clicks == 2:
            mut wa := 0
            mut wb := 0
            _word_bounds(ft, off, wa, wb)
            mut c2 := _e.ctl.Ref(ft)
            c2.anchor = wa
            c2.caret = wb
        else clicks >= 3:
            mut la := 0
            mut lb := 0
            _line_bounds(ft, off, la, lb)
            mut c3 := _e.ctl.Ref(ft)
            c3.anchor = la
            c3.caret = lb
        end
        _e.capture = ft
        _e.drag_sel = true
        _scroll_caret(ft)
        _damage_node(ft)
    end
    if ft >= 0 and _e.dom.nodes[ft].k == _K_INPUT and _input_type(ft) == "range":
        _e.capture = ft
        _range_set(ft, x)
    end
end

func _pointer_up(x: f64, y: f64, button: int, clicks: int, mods: int):
    _e.mx = x
    _e.my = y
    down := _e.capture
    _e.capture = -1
    _e.drag_sel = false
    _set_active(-1)
    if down == -2:
        ret
    end
    t := _hit(x, y)
    mut ev := _make_event("mouseup", t)
    ev.button = button
    ev.modifiers = mods
    _fire_ev(t, ev, true)
    ev.kind = "pointerup"
    _fire_ev(t, ev, true)
    mut same := down == t
    if not same and down >= 0:
        mut n := t
        until n >= 0:
            if n == down:
                same = true
                break
            end
            n = _e.dom.nodes[n].parent
        end
    end
    if not same or button != 0:
        if button == 2:
            ev.kind = "contextmenu"
            _fire_ev(t, ev, true)
        else button == 1:
            ev.kind = "auxclick"
            _fire_ev(t, ev, true)
        end
        ret
    end
    _click(t, mods, clicks)
end

func _click(t: int, mods: int, clicks: int):
    if _is_disabled(t):
        ret
    end
    if _e.dom.nodes[t].k == _K_INPUT and
        (_input_type(t) == "checkbox" or _input_type(t) == "radio") and not _is_disabled(t):
        _toggle_check(t)
    end
    mut ev := _make_event("click", t)
    ev.modifiers = mods
    _fire_ev(t, ev, true)
    if clicks == 2:
        ev.kind = "dblclick"
        _fire_ev(t, ev, true)
    end
    _activate(t)
end

func _wheel(dx0: f64, dy0: f64, line: bool):
    mut dx := dx0
    mut dy := dy0
    if line:
        dx *= 40.0
        dy *= 40.0
    end
    t := _hit(_e.mx, _e.my)
    _fire_ev(t, _make_event("wheel", t), true)
    mut n := t
    until n >= 0:
        if _is_textarea(n) and _scroll_text(n, dx, dy):
            ret
        end
        if _is_scroller(n):
            c := _e.ctl[n]
            if _set_scroll(n, c.scroll_x + dx, c.scroll_y + dy):
                _fire(n, "scroll", false)
                ret
            end
        end
        n = _e.dom.nodes[n].parent
    end
end

func _key_name(k: window.Key, text: str): str:
    switch k:
        window.Key.Enter, window.Key.NumpadEnter: ret "Enter" end
        window.Key.Tab: ret "Tab" end
        window.Key.Escape: ret "Escape" end
        window.Key.Backspace: ret "Backspace" end
        window.Key.Delete: ret "Delete" end
        window.Key.Space: ret " " end
        window.Key.Left: ret "ArrowLeft" end
        window.Key.Right: ret "ArrowRight" end
        window.Key.Up: ret "ArrowUp" end
        window.Key.Down: ret "ArrowDown" end
        window.Key.Home: ret "Home" end
        window.Key.End: ret "End" end
        window.Key.PageUp: ret "PageUp" end
        window.Key.PageDown: ret "PageDown" end
        window.Key.Insert: ret "Insert" end
        window.Key.ShiftLeft, window.Key.ShiftRight: ret "Shift" end
        window.Key.ControlLeft, window.Key.ControlRight: ret "Control" end
        window.Key.AltLeft, window.Key.AltRight: ret "Alt" end
        window.Key.SuperLeft, window.Key.SuperRight: ret "Meta" end
        window.Key.F1: ret "F1" end
        window.Key.F2: ret "F2" end
        window.Key.F5: ret "F5" end
        window.Key.F12: ret "F12" end
        else: break end
    end
    if text.Len() > 0:
        ret text
    end
    v := k as int
    a := window.Key.A as int
    z := window.Key.Z as int
    if v >= a and v <= z:
        s := str.Clone("a")
        p := (s as void*) as u8*
        p[0] = (97 + v - a) as u8
        ret s
    end
    d0 := window.Key.Digit0 as int
    d9 := window.Key.Digit9 as int
    if v >= d0 and v <= d9:
        ret str.FromInt((v - d0) as i64)
    end
    ret "Unidentified"
end

func _page_scroll(dy: f64):
    _wheel_at_root(dy)
end

func _wheel_at_root(dy: f64):
    c := _e.ctl[0]
    if _set_scroll(0, c.scroll_x, c.scroll_y + dy):
        _fire(0, "scroll", false)
    end
end

func _key_down(k: window.Key, mods: int, text: str):
    target := _e.focus >= 0 ? _e.focus : 0
    name := _key_name(k, text)
    mut ev := _make_event("keydown", target)
    ev.key = name
    ev.modifiers = mods
    _fire_ev(target, ev, true)
    ctrl := (mods & window.mod_control) != 0 or (mods & window.mod_super) != 0
    shift := (mods & window.mod_shift) != 0
    editing := _e.focus >= 0 and (_is_text_input(_e.focus) or _is_textarea(_e.focus))
    alt := (mods & window.mod_alt) != 0
    if (alt and not editing and k == window.Key.Left) or (ctrl and k == window.Key.BracketLeft):
        if _history(0 - 1):
            ret
        end
    end
    if (alt and not editing and k == window.Key.Right) or (ctrl and k == window.Key.BracketRight):
        if _history(1):
            ret
        end
    end
    if _e.popup >= 0:
        p := _e.popup
        mut opts := Vector {} as Vector<int>
        _option_nodes(p, opts)
        n := opts.Len()
        opts.Free()
        c := _e.ctl[p]
        if k == window.Key.Down:
            mut cc := _e.ctl.Ref(p)
            cc.anchor = math.MinI(n - 1, c.anchor + 1)
            _damage_popup()
            ret
        else k == window.Key.Up:
            mut cc := _e.ctl.Ref(p)
            cc.anchor = math.MaxI(0, c.anchor - 1)
            _damage_popup()
            ret
        else k == window.Key.Enter or k == window.Key.Space:
            _close_popup()
            _choose_option(p, c.anchor)
            ret
        else k == window.Key.Escape:
            _close_popup()
            ret
        end
    end
    if k == window.Key.Tab:
        _tab(shift)
        ret
    end
    if _e.focus < 0:
        if k == window.Key.Down or k == window.Key.PageDown or k == window.Key.Space:
            _page_scroll(k == window.Key.Down ? 40.0 : _e.height * 0.9)
        else k == window.Key.Up or k == window.Key.PageUp:
            _page_scroll(k == window.Key.Up ? -40.0 : 0.0 - _e.height * 0.9)
        else k == window.Key.Home:
            _page_scroll(-1.0e9)
        else k == window.Key.End:
            _page_scroll(1.0e9)
        end
        ret
    end
    f := _e.focus
    fk := _e.dom.nodes[f].k
    if _is_text_input(f):
        _edit_key(f, k, ctrl, shift)
        ret
    end
    if fk == _K_SELECT:
        if k == window.Key.Space or k == window.Key.Enter or
            (k == window.Key.Down and (mods & window.mod_alt) != 0):
            _open_popup(f)
        else k == window.Key.Down or k == window.Key.Up:
            mut opts := Vector {} as Vector<int>
            _option_nodes(f, opts)
            n := opts.Len()
            opts.Free()
            cur := _select_index(f)
            ni := k == window.Key.Down ? math.MinI(n - 1, cur + 1) : math.MaxI(0, cur - 1)
            _choose_option(f, ni)
        end
        ret
    end
    if fk == _K_INPUT and _input_type(f) == "range":
        if k == window.Key.Left or k == window.Key.Right or k == window.Key.Up or
            k == window.Key.Down:
            c := _content_box(f)
            mut mn := 0.0
            mut mx := 100.0
            mut step := 1.0
            _range_bounds(f, mn, mx, step)
            up := k == window.Key.Right or k == window.Key.Up
            v := mn + _range_frac(f) * (mx - mn) + (up ? step : 0.0 - step)
            frac := (math.Max(mn, math.Min(mx, v)) - mn) / math.Max(0.000001, mx - mn)
            _range_set(f, c.x + 8.0 + frac * (c.w - 16.0))
        end
        ret
    end
    if k == window.Key.Enter:
        if fk == _K_BUTTON or fk == _K_LINK or fk == _K_SUMMARY or _is_button_input(f):
            _click(f, mods, 1)
        end
        ret
    end
    if k == window.Key.Space:
        if fk == _K_BUTTON or fk == _K_SUMMARY or (fk == _K_INPUT and _input_type(f) != "hidden"):
            _click(f, mods, 1)
        end
    end
end

func _key_up(k: window.Key, mods: int):
    target := _e.focus >= 0 ? _e.focus : 0
    mut ev := _make_event("keyup", target)
    ev.key = _key_name(k, "")
    ev.modifiers = mods
    _fire_ev(target, ev, true)
end

func _text_input(text: str):
    f := _e.focus
    if f < 0 or not _is_text_input(f) or _has_attr(_e.dom, f, "readonly") or _is_disabled(f):
        ret
    end
    mut clean := text
    if clean.Len() == 0:
        ret
    end
    p := (clean as void*) as u8*
    if clean.Len() == 1 and (_hb(p, 0) < 32 or _hb(p, 0) == 127):
        ret
    end
    if _e.dom.nodes[f].k == _K_INPUT and _input_type(f) == "number":
        mut nb := str.NewBuilder()
        repeat clean.Len() in i:
            c := _hb(p, i)
            if (c >= 48 and c <= 57) or c == 45 or c == 46 or c == 43 or c == 101 or c == 69:
                str.BufAppendChar(nb, c)
            end
        end
        clean = str.BufStr(nb)
        str.BufFree(nb)
        if clean.Len() == 0:
            ret
        end
    end
    _push_undo(f)
    mut c := _e.ctl.Ref(f)
    old_pre := c.preedit
    c.preedit = ""
    _sfree(old_pre)
    _replace_selection(f, clean)
    _refresh_control(f)
    _e.states_dirty = true
    mut ev := _make_event("input", f)
    ev.text = clean
    _fire_ev(f, ev, true)
end

func _edit_key(f: int, k: window.Key, ctrl: bool, shift: bool):
    v := _control_value(f)
    c := _e.ctl[f]
    readonly := _has_attr(_e.dom, f, "readonly") or _is_disabled(f)
    mut caret := c.caret
    mut anchor := c.anchor
    mut changed := false
    mut moved := false
    switch k:
        window.Key.Left, window.Key.Right:
            fwd := k == window.Key.Right
            rtl := _style_of(f).direction == style.KW_RTL
            logical := rtl ? not fwd : fwd
            if not shift and caret != anchor:
                caret = logical ? math.MaxI(caret, anchor) : math.MinI(caret, anchor)
            else ctrl:
                caret = _grapheme_step(f, caret, logical, true)
            else:
                caret = _visual_step(f, caret, fwd, logical)
            end
            moved = true
            break
        end
        window.Key.Home, window.Key.End:
            if ctrl or not _is_textarea(f):
                caret = k == window.Key.Home ? 0 : v.Len()
            else:
                caret = _line_move(f, caret, k == window.Key.Home ? -1 : 1, true)
            end
            moved = true
            break
        end
        window.Key.Up, window.Key.Down:
            if _is_textarea(f):
                caret = _line_move(f, caret, k == window.Key.Up ? -1 : 1, false)
            else:
                caret = k == window.Key.Up ? 0 : v.Len()
            end
            moved = true
            break
        end
        window.Key.Backspace, window.Key.Delete:
            if readonly:
                break
            end
            _push_undo(f)
            if caret == anchor:
                if k == window.Key.Backspace:
                    anchor = _grapheme_step(f, caret, false, ctrl)
                else:
                    anchor = _grapheme_step(f, caret, true, ctrl)
                end
                mut cc := _e.ctl.Ref(f)
                cc.caret = caret
                cc.anchor = anchor
            end
            _replace_selection(f, "")
            changed = true
            break
        end
        window.Key.A:
            if ctrl:
                mut cc := _e.ctl.Ref(f)
                cc.anchor = 0
                cc.caret = v.Len()
                _damage_node(f)
                ret
            end
            break
        end
        window.Key.C, window.Key.X:
            if ctrl:
                sel := _selected_text(f)
                if sel.Len() > 0:
                    _set_clipboard(sel)
                    if k == window.Key.X and not readonly:
                        _push_undo(f)
                        _replace_selection(f, "")
                        changed = true
                    end
                end
            end
            break
        end
        window.Key.V:
            if ctrl and not readonly:
                t := _get_clipboard()
                if t.Len() > 0:
                    _push_undo(f)
                    _replace_selection(f, t)
                    changed = true
                end
            end
            break
        end
        window.Key.Z:
            if ctrl and not readonly and c.undo.Len() > 0:
                mut cc := _e.ctl.Ref(f)
                last := cc.undo.Pop()
                _set_value(f, last)
                mut c2 := _e.ctl.Ref(f)
                c2.caret = last.Len()
                c2.anchor = c2.caret
                changed = true
            end
            break
        end
        window.Key.Enter:
            if _e.dom.nodes[f].k == _K_TEXTAREA:
                if not readonly:
                    _push_undo(f)
                    _replace_selection(f, "\n")
                    changed = true
                end
            else:
                _maybe_change(f)
                _remember_committed(f)
                _submit(_ancestor_k(f, _K_FORM))
            end
            break
        end
        else:
            break
        end
    end
    if moved:
        mut cc := _e.ctl.Ref(f)
        cc.caret = caret
        if not shift:
            cc.anchor = caret
        end
        _scroll_caret(f)
        _damage_node(f)
    end
    if changed:
        _refresh_control(f)
        _e.states_dirty = true
        ev := _make_event("input", f)
        _fire_ev(f, ev, true)
    end
end

func _visual_step(f: int, caret: int, right: bool, logical: bool): int:
    ri := _ctl_run(f)
    v := _control_value(f)
    plain := _input_type(f) != "password" and v.Len() > 0
    if ri < 0 or not plain or not _e.runs[ri].has_lay or _e.runs[ri].para.text != v:
        ret _grapheme_step(f, caret, logical, false)
    end
    fc := _e.runs[ri]
    np := typeset.MoveVisual(fc.para, fc.lay, typeset.TextPosition { offset = caret }, right)
    if np.offset == caret:
        ret _grapheme_step(f, caret, logical, false)
    end
    ret np.offset
end

func _set_clipboard(t: str):
    if _clip_owned:
        _sfree(_clip_text)
    end
    _clip_text = str.Clone(t)
    _clip_owned = true
    _ok := window.SetClipboardText(t)
end

func _get_clipboard(): str:
    t := window.ClipboardText()
    if t.Len() > 0:
        ret t
    end
    ret _clip_text
end

func _ime(text: str, commit: bool):
    f := _e.focus
    if f < 0 or not _is_text_input(f):
        ret
    end
    if commit:
        _text_input(text)
        ret
    end
    mut c := _e.ctl.Ref(f)
    old := c.preedit
    c.preedit = str.Clone(text)
    _sfree(old)
    _refresh_control(f)
end

func _update_ime():
    if not _e.has_win:
        ret
    end
    if _e.focus < 0 or _e.focus >= _e.ctl.Len() or not _is_text_input(_e.focus):
        if _e.ime_on:
            _e.ime_on = false
            _e.win.SetImeRect(0.0, 0.0, 0.0, 0.0)
        end
        ret
    end
    _e.ime_on = true
    ri := _ctl_run(_e.focus)
    if ri < 0 or not _e.runs[ri].has_lay:
        ret
    end
    f := _e.runs[ri]
    c := _e.ctl[_e.focus]
    r := typeset.CaretRect(
        f.para, f.lay, typeset.TextPosition { offset = _display_offset(_e.focus, c.caret) }
    )
    _e.win.SetImeRect(f.x + r.x - c.text_scroll, f.y + r.y - c.text_scroll_y, 1.0, r.height)
end
