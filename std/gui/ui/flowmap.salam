package ui

import gui.flow
import gui.style

func _fl(l: style.Len, font: f64): flow.Len:
    ret flow.Len { px = _vp_len(l, font), pct = l.pct / 100.0, kind = flow.LEN_FIXED }
end

func _fdim(d: style.Dim, font: f64): flow.Len:
    switch d.word:
        0: ret _fl(d.len, font) end
        style.KW_AUTO: ret flow.Auto() end
        style.KW_FILL: ret flow.Fill() end
        style.KW_FIT: ret flow.Fit() end
        style.KW_MIN_CONTENT: ret flow.MinContent() end
        style.KW_MAX_CONTENT: ret flow.MaxContent() end
        style.KW_NONE: ret flow.NoLimit() end
    end
    ret flow.Auto()
end

func _finset(d: style.Dim, font: f64): flow.Len:
    if d.word == style.KW_AUTO:
        ret flow.NoLimit()
    end
    ret _fdim(d, font)
end

func _falign(w: int): int:
    switch w:
        style.KW_AUTO: ret flow.ALIGN_AUTO end
        style.KW_START: ret flow.ALIGN_START end
        style.KW_CENTER: ret flow.ALIGN_CENTER end
        style.KW_END: ret flow.ALIGN_END end
        style.KW_STRETCH: ret flow.ALIGN_STRETCH end
        style.KW_BASELINE: ret flow.ALIGN_BASELINE end
        style.KW_BETWEEN: ret flow.ALIGN_BETWEEN end
        style.KW_AROUND: ret flow.ALIGN_AROUND end
        style.KW_EVENLY: ret flow.ALIGN_EVENLY end
    end
    ret flow.ALIGN_AUTO
end

func _fover(w: int): int:
    switch w:
        style.KW_HIDDEN: ret flow.OVERFLOW_HIDDEN end
        style.KW_SCROLL: ret flow.OVERFLOW_SCROLL end
        style.KW_AUTO: ret flow.OVERFLOW_AUTO end
    end
    ret flow.OVERFLOW_VISIBLE
end

func _track_side(word: int, l: style.Len, font: f64): flow.Len:
    switch word:
        0: ret _fl(l, font) end
        style.KW_AUTO: ret flow.Auto() end
        style.KW_MIN_CONTENT: ret flow.MinContent() end
        style.KW_MAX_CONTENT: ret flow.MaxContent() end
    end
    ret flow.Auto()
end

func _one_track(tr: style.Track, font: f64): flow.Track:
    if tr.kind == style.TRACK_MINMAX:
        mut lo := flow.TrackLen(_track_side(tr.word, tr.len, font))
        if tr.word == 0 and tr.len.fr > 0.0:
            lo = flow.TrackAuto()
        end
        mut hi := flow.TrackLen(_track_side(tr.max_word, tr.max, font))
        if tr.max_word == 0 and tr.max.fr > 0.0:
            hi = flow.TrackFr(tr.max.fr)
        end
        ret flow.TrackMinMax(lo, hi)
    end
    if tr.kind == style.TRACK_FIT:
        ret flow.TrackFit(_fl(tr.len, font))
    end
    if tr.word == 0 and tr.len.fr > 0.0:
        ret flow.TrackFr(tr.len.fr)
    end
    if tr.word == style.KW_AUTO or tr.word == style.KW_NONE:
        ret flow.TrackAuto()
    end
    ret flow.TrackLen(_track_side(tr.word, tr.len, font))
end

func _ftracks(v: Vector<style.Track>, font: f64): Vector<flow.Track>:
    mut out := Vector {} as Vector<flow.Track>
    mut i := 0
    until i < v.Len():
        tr := v[i]
        if tr.kind == style.TRACK_REPEAT:
            mut inner := Vector {} as Vector<flow.Track>
            repeat tr.span in k:
                if i + 1 + k < v.Len():
                    inner.push(_one_track(v[i + 1 + k], font))
                end
            end
            mut cnt := tr.count
            if tr.word == style.KW_FILL:
                cnt = flow.REPEAT_FILL
            else tr.word == style.KW_FIT:
                cnt = flow.REPEAT_FIT
            end
            out.push(flow.Repeat(cnt, inner))
            i += 1 + tr.span
            continue
        end
        if not (tr.kind == style.TRACK_SIZE and tr.word == style.KW_NONE):
            out.push(_one_track(tr, font))
        end
        i++
    end
    ret out
end

func _flow_style(node: int): flow.FlowStyle:
    s := _e.cs[node]
    font := _e.us[node].font
    mut f := flow.FlowStyle {}
    switch s.layout_kind:
        style.KW_ROW: f.layout = flow.LAYOUT_ROW break end
        style.KW_GRID: f.layout = flow.LAYOUT_GRID break end
        style.KW_STACK: f.layout = flow.LAYOUT_STACK break end
        style.KW_FLOW: f.layout = flow.LAYOUT_FLOW break end
        else: f.layout = flow.LAYOUT_COLUMN break end
    end
    f.row_gap = _fl(s.gap_row, font)
    f.column_gap = _fl(s.gap_column, font)
    f.align = _falign(s.align)
    f.justify = _falign(s.justify)
    f.align_content = _falign(s.align_content)
    f.wrap = s.wrap
    f.reverse = s.reverse
    if f.layout == flow.LAYOUT_GRID:
        f.columns = _ftracks(s.columns, font)
        f.rows = _ftracks(s.rows, font)
        mut ac := _ftracks(s.auto_columns, font)
        if ac.Len() > 0:
            f.auto_columns = ac[0]
        end
        ac.Free()
        mut ar := _ftracks(s.auto_rows, font)
        if ar.Len() > 0:
            f.auto_rows = ar[0]
        end
        ar.Free()
    end
    switch s.auto_flow:
        style.KW_COLUMN: f.auto_flow = flow.AUTO_FLOW_COLUMN break end
        style.KW_DENSE, style.KW_ROW_DENSE: f.auto_flow = flow.AUTO_FLOW_ROW_DENSE break end
        style.KW_COLUMN_DENSE: f.auto_flow = flow.AUTO_FLOW_COLUMN_DENSE break end
        else: f.auto_flow = flow.AUTO_FLOW_ROW break end
    end
    f.grow = s.grow
    f.shrink = s.shrink
    f.basis = _fdim(s.basis, font)
    f.align_self = _falign(s.align_self)
    f.justify_self = _falign(s.justify_self)
    f.column = s.column
    f.row = s.row
    f.column_span = s.column_span
    f.row_span = s.row_span
    f.order = s.order
    switch s.position:
        style.KW_ABSOLUTE: f.position = flow.POS_ABSOLUTE break end
        style.KW_FIXED: f.position = flow.POS_FIXED break end
        style.KW_STICKY: f.position = flow.POS_STICKY break end
        else: f.position = flow.POS_NORMAL break end
    end
    f.inset = flow.Edges { top = _finset(s.inset_top, font), end = _finset(s.inset_end, font), bottom = _finset(s.inset_bottom, font), start = _finset(s.inset_start, font) }
    f.layer = s.layer
    f.width = _fdim(s.width, font)
    f.height = _fdim(s.height, font)
    f.min_width = _fdim(s.min_width, font)
    f.min_height = _fdim(s.min_height, font)
    f.max_width = _fdim(s.max_width, font)
    f.max_height = _fdim(s.max_height, font)
    f.aspect_ratio = s.aspect_ratio
    f.padding = flow.Sides(_fl(s.padding_top, font), _fl(s.padding_end, font), _fl(s.padding_bottom, font), _fl(s.padding_start, font))
    f.margin = flow.Sides(_fdim(s.margin_top, font), _fdim(s.margin_end, font), _fdim(s.margin_bottom, font), _fdim(s.margin_start, font))
    f.border = flow.Sides(_bw(s.border_top_width, s.border_top_style, font), _bw(s.border_end_width, s.border_end_style, font), _bw(s.border_bottom_width, s.border_bottom_style, font), _bw(s.border_start_width, s.border_start_style, font))
    f.overflow_x = _fover(s.overflow_x)
    f.overflow_y = _fover(s.overflow_y)
    f.visible = s.visible
    if not _shown_by_parent(node):
        f.visible = false
    end
    switch s.direction:
        style.KW_RTL: f.direction = flow.DIR_RTL break end
        style.KW_LTR: f.direction = flow.DIR_LTR break end
        else: f.direction = flow.DIR_INHERIT break end
    end
    switch s.text_align:
        style.KW_CENTER: f.text_align = flow.TEXT_CENTER break end
        style.KW_END: f.text_align = flow.TEXT_END break end
        style.KW_JUSTIFY: f.text_align = flow.TEXT_JUSTIFY break end
        style.KW_LEFT: f.text_align = flow.TEXT_LEFT break end
        style.KW_RIGHT: f.text_align = flow.TEXT_RIGHT break end
        else: f.text_align = flow.TEXT_START break end
    end
    if _e.dom.nodes[node].parent < 0:
        f.width = flow.Px(_e.width)
        f.height = flow.Px(_e.height)
        f.min_height = flow.Auto()
        if f.overflow_y == flow.OVERFLOW_VISIBLE:
            f.overflow_y = flow.OVERFLOW_AUTO
        end
        if f.overflow_x == flow.OVERFLOW_VISIBLE:
            f.overflow_x = flow.OVERFLOW_AUTO
        end
    end
    ret f
end

func _bw(w: style.Len, st: int, font: f64): flow.Len:
    if st == style.KW_NONE:
        ret flow.Px(0.0)
    end
    ret flow.Px(_vp_len(w, font))
end

func _flen_same(a: flow.Len, b: flow.Len): bool:
    ret a.px == b.px and a.pct == b.pct and a.kind == b.kind
end

func _fedges_same(a: flow.Edges, b: flow.Edges): bool:
    ret _flen_same(a.top, b.top) and _flen_same(a.end, b.end) and _flen_same(a.bottom, b.bottom) and _flen_same(a.start, b.start) and _flen_same(a.left, b.left) and _flen_same(a.right, b.right)
end

func _ftrack_same(a: flow.Track, b: flow.Track): bool:
    if not (_flen_same(a.min, b.min) and _flen_same(a.max, b.max) and a.fr == b.fr and a.fit == b.fit and a.count == b.count and a.tracks.Len() == b.tracks.Len()):
        ret false
    end
    repeat a.tracks.Len() in i:
        if not _ftrack_same(a.tracks[i], b.tracks[i]):
            ret false
        end
    end
    ret true
end

func _ftracks_same(a: Vector<flow.Track>, b: Vector<flow.Track>): bool:
    if a.Len() != b.Len():
        ret false
    end
    repeat a.Len() in i:
        if not _ftrack_same(a[i], b[i]):
            ret false
        end
    end
    ret true
end

func _flow_same(a: flow.FlowStyle, b: flow.FlowStyle): bool:
    if a.layout != b.layout or a.align != b.align or a.justify != b.justify or a.align_content != b.align_content or a.wrap != b.wrap or a.reverse != b.reverse:
        ret false
    end
    if a.auto_flow != b.auto_flow or a.grow != b.grow or a.shrink != b.shrink or a.align_self != b.align_self or a.justify_self != b.justify_self:
        ret false
    end
    if a.column != b.column or a.row != b.row or a.column_span != b.column_span or a.row_span != b.row_span or a.order != b.order or a.position != b.position or a.layer != b.layer:
        ret false
    end
    if a.aspect_ratio != b.aspect_ratio or a.overflow_x != b.overflow_x or a.overflow_y != b.overflow_y or a.visible != b.visible or a.direction != b.direction or a.text_align != b.text_align:
        ret false
    end
    if not (_flen_same(a.row_gap, b.row_gap) and _flen_same(a.column_gap, b.column_gap) and _flen_same(a.basis, b.basis)):
        ret false
    end
    if not (_flen_same(a.width, b.width) and _flen_same(a.height, b.height) and _flen_same(a.min_width, b.min_width) and _flen_same(a.min_height, b.min_height) and _flen_same(a.max_width, b.max_width) and _flen_same(a.max_height, b.max_height)):
        ret false
    end
    if not (_fedges_same(a.inset, b.inset) and _fedges_same(a.padding, b.padding) and _fedges_same(a.margin, b.margin) and _fedges_same(a.border, b.border)):
        ret false
    end
    ret _ftracks_same(a.columns, b.columns) and _ftracks_same(a.rows, b.rows) and _ftrack_same(a.auto_columns, b.auto_columns) and _ftrack_same(a.auto_rows, b.auto_rows)
end
