package ui

import math
import gui.typeset

mut _kb_tap := true
mut _kb_drag := true
mut _kb_h := 0.0
mut _rv_pending := false

func _kb_editing(): bool:
    ret _e.focus >= 0 and _e.focus < _e.ctl.Len() and _is_text_input(_e.focus)
end

func _reveal_caret(f: int):
    if f < 0 or f >= _e.boxes.Len() or not _e.boxes[f].shown:
        ret
    end
    mut b := _e.boxes[f]
    ri := _ctl_run(f)
    if _is_textarea(f) and ri >= 0 and _e.runs[ri].has_lay and not _control_shows_placeholder(f):
        r := _e.runs[ri]
        c := _e.ctl[f]
        cr := typeset.CaretRect(
            r.para, r.lay, typeset.TextPosition { offset = _display_offset(f, c.caret) }
        )
        b.x = r.x + cr.x - c.text_scroll
        b.y = r.y + cr.y - c.text_scroll_y - 6.0
        b.w = 1.0
        b.h = cr.height + 12.0
    end
    _reveal_box(f, b)
end

func _kb_frame():
    if not _rv_pending:
        ret
    end
    _rv_pending = false
    if _kb_editing():
        _reveal_caret(_e.focus)
    end
end

func _kb_changed(kb: f64):
    prev := _kb_h
    _kb_h = kb
    if kb > 0.0 and kb != prev:
        _rv_pending = true
    end
    if kb <= 0.0 and prev > 0.0 and _e.ime_on and _kb_editing():
        _set_focus(-1, false)
    end
end

func _kb_back(): bool:
    if _kb_h > 0.0 and _kb_editing():
        _set_focus(-1, false)
        ret true
    end
    ret false
end

func _kb_drag_start():
    if _kb_drag and _kb_editing() and _hit(_tx0, _ty0) != _e.focus:
        _set_focus(-1, false)
    end
end
