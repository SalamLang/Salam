package ui

import str
import math
import time
import gui.flow
import gui.paint
import gui.style
import gui.typeset

func _ensure_fonts():
    if _fonts_ready:
        ret
    end
    _fonts_ready = true
    if _fonts_added == 0:
        _n := typeset.AddSystemFonts(_fc)
    end
end

func _ensure_gcache():
    if not _gcache_ready:
        _gcache = typeset.NewGlyphCache(4 * 1024 * 1024)
        _gcache_ready = true
    end
end

func _details_open(node: int): bool:
    ret _e.ctl[node].open
end

func _shown_by_parent(node: int): bool:
    nd := _e.dom.nodes[node]
    if _has_attr(_e.dom, node, "hidden"):
        ret false
    end
    if nd.k == _K_INPUT and _input_type(node) == "hidden":
        ret false
    end
    if nd.k == _K_DIALOG and not _e.ctl[node].open:
        ret false
    end
    p := nd.parent
    if p >= 0 and _e.dom.nodes[p].k == _K_DETAILS and nd.k != _K_SUMMARY and not _details_open(p):
        ret false
    end
    ret true
end

func _is_leaf_kind(node: int): bool:
    k := _e.dom.nodes[node].k
    ret k == _K_INPUT or k == _K_TEXTAREA or k == _K_SELECT or k == _K_IMAGE or k == _K_MEDIA or k == _K_PROGRESS or k == _K_METER
end

func _inline_content(node: int): bool:
    nd := _e.dom.nodes[node]
    if nd.k == _K_TEXT:
        ret true
    end
    if not nd.inl:
        ret false
    end
    s := _e.cs[node]
    if nd.k == _K_BR:
        ret true
    end
    if s.layout_kind != style.KW_FLOW or s.position != style.KW_NORMAL or not s.visible:
        ret false
    end
    if s.translate_x.px != 0.0 or s.rotate != 0.0 or s.scale_x != 1.0 or s.scale_y != 1.0 or s.opacity < 1.0:
        ret false
    end
    each k in nd.kids:
        if not _inline_content(k):
            ret false
        end
    end
    ret true
end

func _transform_text(s: style.Style, t: str): str:
    switch s.transform_text:
        style.KW_UPPER: ret str.Upper(t) end
        style.KW_LOWER: ret str.Lower(t) end
        style.KW_CAPITALIZE: ret str.Title(t) end
    end
    ret str.Clone(t)
end

func _span_for(el: int, text: str): typeset.TextSpan:
    s := _e.cs[el]
    u := _e.us[el]
    mut sp := typeset.TextSpan {}
    sp.text = text
    sp.families = u.family
    sp.size = u.font
    sp.weight = s.font_weight
    sp.italic = s.italic
    sp.letter_spacing = s.letter_spacing.px
    sp.word_spacing = s.word_spacing.px
    sp.line_height = u.line
    sp.lang = _e.dom.lang
    sp.tag = el
    ret sp
end

func _pstyle_of(owner: int): typeset.ParagraphStyle:
    s := _e.cs[owner]
    mut ps := typeset.ParagraphStyle {}
    rtl := s.direction == style.KW_RTL
    switch s.text_align:
        style.KW_END: ps.align = typeset.TextAlign.End break end
        style.KW_LEFT: ps.align = typeset.TextAlign.Left break end
        style.KW_RIGHT: ps.align = typeset.TextAlign.Right break end
        style.KW_CENTER: ps.align = typeset.TextAlign.Center break end
        style.KW_JUSTIFY: ps.align = typeset.TextAlign.Justify break end
        else: ps.align = typeset.TextAlign.Start break end
    end
    ps.direction = rtl ? typeset.TextDirRTL : (s.direction == style.KW_LTR ? typeset.TextDirLTR : typeset.TextDirAuto)
    if s.direction == style.KW_AUTO:
        ps.direction = typeset.TextDirLTR
    end
    keep := s.white_space == style.KW_KEEP
    if keep:
        ps.white_space = s.wrap_text ? typeset.WhiteSpace.PreWrap : typeset.WhiteSpace.Pre
    else:
        ps.white_space = s.wrap_text ? typeset.WhiteSpace.Normal : typeset.WhiteSpace.NoWrap
    end
    ps.overflow_wrap = typeset.OverflowWrap.BreakWord
    if s.max_lines > 0:
        ps.max_lines = s.max_lines
        ps.ellipsis = true
    else s.ellipsis:
        ps.max_lines = 1
        ps.ellipsis = true
        ps.white_space = keep ? typeset.WhiteSpace.Pre : typeset.WhiteSpace.NoWrap
    end
    ps.lang = _e.dom.lang
    ret ps
end

func _run_add(r &: _Run, node: int, owner: int):
    nd := _e.dom.nodes[node]
    if nd.k == _K_TEXT:
        p := nd.parent
        t := _transform_text(_e.cs[p], nd.text)
        r.spans.push(_span_for(p, t))
        r.span_el.push(p)
        _e.in_run[node] = _e.runs.Len()
        ret
    end
    _e.in_run[node] = _e.runs.Len()
    if nd.k == _K_BR:
        r.spans.push(_span_for(node, str.Clone(" ")))
        r.span_el.push(node)
        ret
    end
    each k in nd.kids:
        _run_add(r, k, owner)
    end
end

func _ws_only(nodes: Vector<int>): bool:
    each n in nodes:
        nd := _e.dom.nodes[n]
        if nd.k != _K_TEXT:
            ret false
        end
        p := (nd.text as void*) as u8*
        repeat nd.text.Len() in i:
            if not _is_ws(_hb(p, i)):
                ret false
            end
        end
    end
    ret true
end

func _flush_run(owner: int, pfid: int, nodes &: Vector<int>):
    if nodes.Len() == 0:
        ret
    end
    if _ws_only(nodes) and _e.cs[owner].white_space != style.KW_KEEP:
        nodes.clear()
        ret
    end
    mut r := _Run { owner = owner, first = nodes[0] }
    r.nodes = Vector {} as Vector<int>
    r.spans = Vector {} as Vector<typeset.TextSpan>
    r.span_el = Vector {} as Vector<int>
    r.alt_lay = Vector {} as Vector<typeset.TextLayout>
    r.alt_w = Vector {} as Vector<f64>
    each n in nodes:
        r.nodes.push(n)
        _run_add(r, n, owner)
    end
    r.pstyle = _pstyle_of(owner)
    mut fs := flow.FlowStyle {}
    fs.text_align = flow.TEXT_START
    id := _e.tree.Add(pfid, fs)
    r.fid = id
    _e.runs.push(r)
    ri := _e.runs.Len() - 1
    _grow_ids(id)
    _e.flow_run[id] = ri
    _e.flow_node[id] = -1
    _e.node_run[nodes[0]] = ri
    _e.tree.SetMeasure(id, (fid: int, w: f64, h: f64): ret _measure_flow(fid, w, h) end)
    nodes.clear()
end

func _grow_ids(id: int):
    until _e.flow_run.Len() <= id:
        _e.flow_run.push(-1)
        _e.flow_node.push(-1)
    end
end

func _control_run(node: int):
    mut r := _Run { owner = node, first = node, control = true }
    r.nodes = Vector {} as Vector<int>
    r.spans = Vector {} as Vector<typeset.TextSpan>
    r.span_el = Vector {} as Vector<int>
    r.alt_lay = Vector {} as Vector<typeset.TextLayout>
    r.alt_w = Vector {} as Vector<f64>
    r.spans.push(_span_for(node, _control_text(node)))
    r.span_el.push(node)
    mut ps := _pstyle_of(node)
    if _e.dom.nodes[node].k == _K_TEXTAREA:
        ps.white_space = typeset.WhiteSpace.PreWrap
    else:
        ps.white_space = typeset.WhiteSpace.Pre
        ps.max_lines = 0
        ps.ellipsis = false
    end
    if _is_button_input(node):
        ps.align = typeset.TextAlign.Center
    end
    r.pstyle = ps
    _e.runs.push(r)
    _e.node_run[node] = _e.runs.Len() - 1
end

func _build_node(node: int, pfid: int):
    nd := _e.dom.nodes[node]
    fs := _flow_style(node)
    id := _e.tree.Add(pfid, fs)
    _e.fid[node] = id
    _grow_ids(id)
    _e.flow_node[id] = node
    if _is_leaf_kind(node):
        if _is_text_input(node) or nd.k == _K_SELECT or _is_button_input(node):
            _control_run(node)
        end
        _e.tree.SetMeasure(id, (fid: int, w: f64, h: f64): ret _measure_flow(fid, w, h) end)
        ret
    end
    is_flow := fs.layout == flow.LAYOUT_FLOW
    mut run := Vector {} as Vector<int>
    defer run.Free()
    each k in nd.kids:
        kn := _e.dom.nodes[k]
        if kn.k == _K_TEXT or (is_flow and _inline_content(k)) or (kn.k == _K_BR):
            run.push(k)
            continue
        end
        _flush_run(node, id, run)
        if kn.k == _K_OPTION or kn.k == _K_OPTGROUP:
            if nd.k == _K_SELECT:
                continue
            end
        end
        _build_node(k, id)
    end
    _flush_run(node, id, run)
end

func _free_run(r &: _Run):
    each sp in r.spans:
        _sfree(sp.text)
    end
    r.spans.Free()
    r.span_el.Free()
    r.nodes.Free()
    if r.has_para:
        typeset.FreeParagraph(r.para)
        r.has_para = false
    end
    if r.has_lay:
        typeset.FreeLayout(r.lay)
        r.has_lay = false
    end
    repeat r.alt_lay.Len() in i:
        mut l := r.alt_lay[i]
        typeset.FreeLayout(l)
    end
    r.alt_lay.Free()
    r.alt_w.Free()
end

func _reset_layout():
    repeat _e.runs.Len() in i:
        mut r := _e.runs.ref(i)
        _free_run(r)
    end
    _e.runs.clear()
    if _e.has_tree:
        _e.tree.Free()
        _e.has_tree = false
    end
    _e.fid.clear()
    _e.flow_node.clear()
    _e.flow_run.clear()
    _e.node_run.clear()
    _e.in_run.clear()
end

func _build_tree():
    _ensure_fonts()
    _reset_layout()
    _e.tree = flow.NewTree()
    _e.has_tree = true
    n := _e.dom.nodes.Len()
    repeat n:
        _e.fid.push(-1)
        _e.node_run.push(-1)
        _e.in_run.push(-1)
    end
    if n > 0:
        _build_node(0, -1)
    end
end

func _run_para(ri: int):
    if _e.runs[ri].has_para:
        ret
    end
    mut r := _e.runs.ref(ri)
    if r.control and r.spans.Len() > 0 and r.spans[0].text.Len() == 0:
        mut sp := r.spans[0]
        sp.text = str.Clone(" ")
        r.spans[0] = sp
    end
    r.para = typeset.NewParagraph(_fc, r.spans, r.pstyle)
    r.has_para = true
end

func _run_layout(ri: int, width: f64):
    _run_para(ri)
    r0 := _e.runs[ri]
    if r0.has_lay and r0.lay_w == width:
        ret
    end
    mut r := _e.runs.ref(ri)
    repeat r.alt_w.Len() in i:
        if r.alt_w[i] == width:
            got := r.alt_lay[i]
            r.alt_lay.remove_at(i)
            r.alt_w.remove_at(i)
            if r.has_lay:
                r.alt_lay.push(r.lay)
                r.alt_w.push(r.lay_w)
            end
            r.lay = got
            r.lay_w = width
            r.has_lay = true
            ret
        end
    end
    if r.has_lay:
        if r.alt_lay.Len() >= 3:
            mut old := r.alt_lay[0]
            typeset.FreeLayout(old)
            r.alt_lay.remove_at(0)
            r.alt_w.remove_at(0)
        end
        r.alt_lay.push(r.lay)
        r.alt_w.push(r.lay_w)
    end
    r.lay = typeset.LayoutParagraph(r.para, _fc, width)
    r.lay_w = width
    r.has_lay = true
end

func _run_drop_cache(ri: int):
    mut r := _e.runs.ref(ri)
    if r.has_para:
        typeset.FreeParagraph(r.para)
        r.has_para = false
    end
    if r.has_lay:
        typeset.FreeLayout(r.lay)
        r.has_lay = false
    end
    repeat r.alt_lay.Len() in i:
        mut l := r.alt_lay[i]
        typeset.FreeLayout(l)
    end
    r.alt_lay.clear()
    r.alt_w.clear()
    r.lay_w = -9.0
    r.ver++
end

func _wrap_width(ri: int, cw: f64): f64:
    r := _e.runs[ri]
    ws := r.pstyle.white_space
    if ws == typeset.WhiteSpace.Pre or ws == typeset.WhiteSpace.NoWrap:
        ret 0.0
    end
    if cw < 0.0:
        ret 0.0
    end
    if cw == 0.0:
        ret math.Max(0.01, typeset.MinContentWidth(r.para))
    end
    ret cw + 0.01
end

func _measure_run(ri: int, cw: f64): flow.Size:
    _run_para(ri)
    ww := _wrap_width(ri, cw)
    _run_layout(ri, ww)
    r := _e.runs[ri]
    l := r.lay
    mut w := l.width
    if l.lines.Len() > 1 and cw > 0.0 and ww > 0.0:
        w = math.Max(w, cw)
    end
    if cw > 0.0 and ww > 0.0:
        w = math.Min(w, cw)
    end
    mut b := -1.0
    mut lb := -1.0
    if l.lines.Len() > 0:
        b = l.lines[0].baseline
        lb = l.lines[l.lines.Len() - 1].baseline
    end
    ret flow.Size { w = w, h = l.height, baseline = b, last_baseline = lb }
end

func _image_index(src: str): int:
    repeat _img_keys.Len() in i:
        if _img_keys[i] == src:
            ret i
        end
    end
    mut ok := false
    cv := _load_image(src, ok)
    _img_keys.push(str.Clone(src))
    _img_canvas.push(cv)
    _img_ok.push(ok)
    ret _img_keys.Len() - 1
end

func _natural(node: int, w &: f64, h &: f64): bool:
    nd := _e.dom.nodes[node]
    if nd.k == _K_IMAGE:
        src := _attr(_e.dom, node, "src")
        if src.Len() > 0:
            k := _image_index(src)
            if _img_ok[k]:
                w = _img_canvas[k].width as f64
                h = _img_canvas[k].height as f64
                ret true
            end
        end
        w = 0.0
        h = 0.0
        ret false
    end
    w = 300.0
    h = 150.0
    ret true
end

func _measure_control(node: int, cw: f64, ch: f64): flow.Size:
    nd := _e.dom.nodes[node]
    s := _e.cs[node]
    u := _e.us[node]
    if nd.k == _K_IMAGE or nd.k == _K_MEDIA:
        mut nw := 0.0
        mut nh := 0.0
        _natural(node, nw, nh)
        wauto := s.width.word == style.KW_AUTO
        hauto := s.height.word == style.KW_AUTO
        if not wauto and cw >= 0.0 and nw > 0.0:
            ret flow.Size { w = cw, h = cw * nh / nw }
        end
        if wauto and not hauto and ch >= 0.0 and nh > 0.0:
            ret flow.Size { w = ch * nw / nh, h = ch }
        end
        ret flow.Size { w = nw, h = nh }
    end
    ri := _e.node_run[node]
    if ri >= 0:
        _run_para(ri)
        mut lw := 0.0
        if nd.k == _K_TEXTAREA and cw > 0.0:
            lw = cw + 0.01
        end
        _run_layout(ri, lw)
        r := _e.runs[ri]
        mut w := r.lay.width
        if nd.k == _K_SELECT:
            mut longest := 0.0
            mut opts := Vector {} as Vector<int>
            _option_nodes(node, opts)
            each o in opts:
                t := _text_of(_e.dom, o)
                tw := _text_width(node, t)
                if tw > longest:
                    longest = tw
                end
                _sfree(t)
            end
            opts.Free()
            w = longest + 20.0
        else nd.k == _K_INPUT and not _is_button_input(node):
            w = 0.0
        end
        mut h := math.Max(r.lay.height, u.line)
        if nd.k == _K_TEXTAREA:
            h = u.line * 2.0
        end
        mut b := u.line * 0.75
        if r.lay.lines.Len() > 0:
            b = r.lay.lines[0].baseline
        end
        ret flow.Size { w = w, h = h, baseline = b, last_baseline = b }
    end
    if nd.k == _K_INPUT:
        ret flow.Size { w = 0.0, h = 0.0, baseline = 13.0 }
    end
    ret flow.Size { w = 0.0, h = 0.0 }
end

func _text_width(node: int, t: str): f64:
    mut spans := Vector {} as Vector<typeset.TextSpan>
    spans.push(_span_for(node, t))
    mut p := typeset.NewParagraph(_fc, spans, typeset.ParagraphStyle {})
    w := typeset.MaxContentWidth(p)
    typeset.FreeParagraph(p)
    spans.Free()
    ret w
end

func _measure_flow(fid: int, cw: f64, ch: f64): flow.Size:
    if fid < 0 or fid >= _e.flow_run.Len():
        ret flow.Size {}
    end
    ri := _e.flow_run[fid]
    if ri >= 0:
        ret _measure_run(ri, cw)
    end
    node := _e.flow_node[fid]
    if node >= 0:
        ret _measure_control(node, cw, ch)
    end
    ret flow.Size {}
end

func _layout():
    t0 := time.MonoNanos()
    if not _e.has_tree:
        _build_tree()
    end
    _e.tree.ResetCounters()
    _e.tree.Layout(_e.width, _e.height)
    _e.last_layout_calls = _e.tree.LayoutCalls()
    _place_all()
    _e.last_layout_ms = ((time.MonoNanos() - t0) as f64) / 1000000.0
end

func _relayout_all():
    _reset_layout()
    _layout()
end

func _sync_flow(node: int):
    if node < 0 or node >= _e.fid.Len():
        ret
    end
    id := _e.fid[node]
    if id < 0:
        ri := _e.in_run[node]
        if ri >= 0:
            _retext_run(ri)
        end
        ret
    end
    fs := _flow_style(node)
    old := _e.tree.Style(id)
    if not _flow_same(fs, old):
        if fs.layout != old.layout and (fs.layout == flow.LAYOUT_FLOW or old.layout == flow.LAYOUT_FLOW):
            _e.dirty_dom = true
            ret
        end
        _e.tree.SetStyle(id, fs)
        _e.dirty_layout = true
    end
    each k in _e.dom.nodes[node].kids:
        ri := _e.node_run[k]
        if ri >= 0 and _e.runs[ri].owner == node:
            _retext_run(ri)
        end
    end
    cr := _e.node_run[node]
    if cr >= 0 and _e.runs[cr].control:
        _retext_run(cr)
    end
end

func _retext_run(ri: int):
    mut r := _e.runs.ref(ri)
    if r.control:
        ctl := r.owner
        each sp in r.spans:
            _sfree(sp.text)
        end
        r.spans.clear()
        r.span_el.clear()
        r.spans.push(_span_for(ctl, _control_text(ctl)))
        r.span_el.push(ctl)
        _run_drop_cache(ri)
        _e.dirty_layout = true
        if r.fid >= 0:
            _e.tree.MarkDirty(r.fid)
        else _e.fid[ctl] >= 0:
            _e.tree.MarkDirty(_e.fid[ctl])
        end
        ret
    end
    each sp in r.spans:
        _sfree(sp.text)
    end
    r.spans.clear()
    r.span_el.clear()
    owner := r.owner
    nodes := r.nodes
    each n in nodes:
        _run_add(r, n, owner)
    end
    r.pstyle = _pstyle_of(owner)
    _run_drop_cache(ri)
    if r.fid >= 0:
        _e.tree.MarkDirty(r.fid)
    end
    _e.dirty_layout = true
end

func _place_all():
    n := _e.dom.nodes.Len()
    _e.boxes.clear()
    repeat n:
        _e.boxes.push(_Box {})
    end
    repeat _e.runs.Len() in i:
        mut r := _e.runs.ref(i)
        r.w = 0.0
    end
    if n == 0 or _e.fid[0] < 0:
        ret
    end
    _place(0, 0.0, 0.0, _Box {})
end

func _place(node: int, px: f64, py: f64, clip: _Box):
    id := _e.fid[node]
    s := _e.cs[node]
    st := _e.tree.Style(id)
    if not st.visible:
        ret
    end
    x := px + _e.tree.X(id)
    y := py + _e.tree.Y(id)
    w := _e.tree.W(id)
    h := _e.tree.H(id)
    _e.boxes[node] = _Box { x = x, y = y, w = w, h = h, shown = true, clip_x0 = clip.clip_x0, clip_y0 = clip.clip_y0, clip_x1 = clip.clip_x1, clip_y1 = clip.clip_y1 }
    mut kc := clip
    if s.overflow_x != style.KW_VISIBLE or s.overflow_y != style.KW_VISIBLE or s.clip or _is_leaf_kind(node) or node == 0:
        font := _e.us[node].font
        bl := s.border_start_style == style.KW_NONE ? 0.0 : _vp_len(s.border_start_width, font)
        br := s.border_end_style == style.KW_NONE ? 0.0 : _vp_len(s.border_end_width, font)
        bt := s.border_top_style == style.KW_NONE ? 0.0 : _vp_len(s.border_top_width, font)
        bb := s.border_bottom_style == style.KW_NONE ? 0.0 : _vp_len(s.border_bottom_width, font)
        rtl := s.direction == style.KW_RTL
        lx := rtl ? br : bl
        rx := rtl ? bl : br
        cx0 := s.clip ? x : x + lx
        cy0 := s.clip ? y : y + bt
        cx1 := s.clip ? x + w : x + w - rx
        cy1 := s.clip ? y + h : y + h - bb
        kc.clip_x0 = math.Max(kc.clip_x0, cx0)
        kc.clip_y0 = math.Max(kc.clip_y0, cy0)
        kc.clip_x1 = math.Min(kc.clip_x1, cx1)
        kc.clip_y1 = math.Min(kc.clip_y1, cy1)
    end
    cri := _e.node_run[node]
    if cri >= 0 and _e.runs[cri].control:
        _place_control_run(node, cri)
    end
    each k in _e.dom.nodes[node].kids:
        ri := _e.node_run[k]
        if ri >= 0 and not _e.runs[ri].control:
            _place_run(ri, x, y, kc)
        end
        if _e.fid[k] >= 0:
            _place(k, x, y, kc)
        end
    end
end

func _place_run(ri: int, px: f64, py: f64, clip: _Box):
    fid := _e.runs[ri].fid
    if fid < 0:
        ret
    end
    x := px + _e.tree.X(fid)
    y := py + _e.tree.Y(fid)
    w := _e.tree.W(fid)
    h := _e.tree.H(fid)
    ww := _wrap_width(ri, w)
    _run_layout(ri, ww)
    mut r := _e.runs.ref(ri)
    r.x = x
    r.y = y
    r.w = w
    r.h = h
    l := r.lay
    each n in r.nodes:
        if _e.dom.nodes[n].k != _K_TEXT:
            _e.boxes[n] = _Box { x = x, y = y, w = 0.0, h = 0.0, shown = false, clip_x0 = clip.clip_x0, clip_y0 = clip.clip_y0, clip_x1 = clip.clip_x1, clip_y1 = clip.clip_y1 }
        end
    end
    repeat l.lines.Len() in li:
        line := l.lines[li]
        mut k := line.run_start
        until k < line.run_start + line.run_count:
            gr := l.runs[k]
            if gr.span >= 0 and gr.span < r.span_el.Len():
                mut el := r.span_el[gr.span]
                until el >= 0 and el != r.owner:
                    _grow_box(el, x + gr.x, y + line.top, gr.width, line.height, clip)
                    el = _e.dom.nodes[el].parent
                end
            end
            k++
        end
    end
end

func _grow_box(el: int, x: f64, y: f64, w: f64, h: f64, clip: _Box):
    b := _e.boxes[el]
    if not b.shown:
        _e.boxes[el] = _Box { x = x, y = y, w = w, h = h, shown = true, clip_x0 = clip.clip_x0, clip_y0 = clip.clip_y0, clip_x1 = clip.clip_x1, clip_y1 = clip.clip_y1 }
        ret
    end
    x0 := math.Min(b.x, x)
    y0 := math.Min(b.y, y)
    x1 := math.Max(b.x + b.w, x + w)
    y1 := math.Max(b.y + b.h, y + h)
    _e.boxes[el] = _Box { x = x0, y = y0, w = x1 - x0, h = y1 - y0, shown = true, clip_x0 = b.clip_x0, clip_y0 = b.clip_y0, clip_x1 = b.clip_x1, clip_y1 = b.clip_y1 }
end

func _content_box(node: int): _Box:
    b := _e.boxes[node]
    s := _e.cs[node]
    font := _e.us[node].font
    bt := s.border_top_style == style.KW_NONE ? 0.0 : _vp_len(s.border_top_width, font)
    bb := s.border_bottom_style == style.KW_NONE ? 0.0 : _vp_len(s.border_bottom_width, font)
    bs := s.border_start_style == style.KW_NONE ? 0.0 : _vp_len(s.border_start_width, font)
    be := s.border_end_style == style.KW_NONE ? 0.0 : _vp_len(s.border_end_width, font)
    pt := _abs_len(s.padding_top, font, b.w)
    pb := _abs_len(s.padding_bottom, font, b.w)
    ps := _abs_len(s.padding_start, font, b.w)
    pe := _abs_len(s.padding_end, font, b.w)
    rtl := s.direction == style.KW_RTL
    l := rtl ? be + pe : bs + ps
    r := rtl ? bs + ps : be + pe
    ret _Box { x = b.x + l, y = b.y + bt + pt, w = math.Max(0.0, b.w - l - r), h = math.Max(0.0, b.h - bt - bb - pt - pb), shown = b.shown }
end

func _padding_box(node: int): _Box:
    b := _e.boxes[node]
    s := _e.cs[node]
    font := _e.us[node].font
    bt := s.border_top_style == style.KW_NONE ? 0.0 : _vp_len(s.border_top_width, font)
    bb := s.border_bottom_style == style.KW_NONE ? 0.0 : _vp_len(s.border_bottom_width, font)
    bs := s.border_start_style == style.KW_NONE ? 0.0 : _vp_len(s.border_start_width, font)
    be := s.border_end_style == style.KW_NONE ? 0.0 : _vp_len(s.border_end_width, font)
    rtl := s.direction == style.KW_RTL
    l := rtl ? be : bs
    r := rtl ? bs : be
    ret _Box { x = b.x + l, y = b.y + bt, w = math.Max(0.0, b.w - l - r), h = math.Max(0.0, b.h - bt - bb), shown = b.shown }
end

func _place_control_run(node: int, ri: int):
    c := _content_box(node)
    nd := _e.dom.nodes[node]
    mut lw := 0.0
    if nd.k == _K_TEXTAREA:
        lw = c.w + 0.01
    else _is_button_input(node):
        lw = c.w + 0.01
    end
    _run_layout(ri, lw)
    mut r := _e.runs.ref(ri)
    r.x = c.x
    r.w = c.w
    r.h = c.h
    if nd.k == _K_TEXTAREA:
        r.y = c.y
    else:
        r.y = c.y + (c.h - r.lay.height) / 2.0
    end
    if nd.k == _K_SELECT:
        r.w = math.Max(0.0, c.w - 16.0)
    end
end

func _scroll_max(node: int, mx &: f64, my &: f64):
    id := _e.fid[node]
    pb := _padding_box(node)
    mx = math.Max(0.0, _e.tree.ContentW(id) - pb.w)
    my = math.Max(0.0, _e.tree.ContentH(id) - pb.h)
end

func _is_scroller(node: int): bool:
    s := _e.cs[node]
    ret (s.overflow_x == style.KW_AUTO or s.overflow_x == style.KW_SCROLL or s.overflow_y == style.KW_AUTO or s.overflow_y == style.KW_SCROLL or node == 0) and _e.fid[node] >= 0
end

func _set_scroll(node: int, x: f64, y: f64): bool:
    mut mx := 0.0
    mut my := 0.0
    _scroll_max(node, mx, my)
    nx := math.Max(0.0, math.Min(mx, x))
    ny := math.Max(0.0, math.Min(my, y))
    c := _e.ctl[node]
    if nx == c.scroll_x and ny == c.scroll_y:
        ret false
    end
    mut cc := _e.ctl.ref(node)
    cc.scroll_x = nx
    cc.scroll_y = ny
    _e.tree.SetScroll(_e.fid[node], nx, ny)
    _e.dirty_place = true
    ret true
end

func _paint_rect(b: _Box): paint.Rect:
    ret paint.RectOf(b.x, b.y, b.w, b.h)
end
