package ui

import str
import mem
import gui.style

func _sfree(s: str):
    if s.Len() > 0:
        mem.Free(s as void*)
    end
end

func _hb(p: u8*, i: int): int:
    ret p[i] as int
end

func _is_ws(c: int): bool:
    ret c == 32 or c == 9 or c == 10 or c == 13 or c == 12
end

func _canon(name: str): str:
    trimmed := str.Trim(name)
    mut n := str.Lower(trimmed)
    mem.Free(trimmed as void*)
    if n.Find("_") >= 0:
        old := n
        n = str.Replace(old, "_", " ")
        _sfree(old)
    end
    if n.Find("‌") >= 0:
        old2 := n
        n = str.Replace(old2, "‌", " ")
        _sfree(old2)
    end
    ret n
end

