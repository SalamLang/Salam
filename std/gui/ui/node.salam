        "td": ret "column (ستون)" end
        "th": ret "header column" end
        "thead": ret "table header" end
        "tbody": ret "table body" end
        "tfoot": ret "table footer" end
        "col": ret "column definition (تعریف ستون)" end
        "colgroup": ret "column group (گروه ستون)" end
        "rt": ret "ruby text (متن آوانما)" end
        "rp": ret "ruby parenthesis (پرانتز آوانما)" end
    end
    ret ""
end

func _kind_report(n: str):
    each seen in _bad_kinds:
        if seen == n:
            ret
        end
    end
    _bad_kinds.Push(str.Clone(n))
    hint := _kind_hint(n)
    if hint.Len() > 0:
        println "ui: unknown element '" + n + "', use " + hint
    else:
        println "ui: unknown element '" + n + "'"
    end
end

func _kind_class(n: str, inl &: bool): int:
    inl = false
    switch n:
        "#text": ret _K_TEXT end
        "page": ret _K_PAGE end
        "span", "bold", "strong", "italic", "emphasis", "cite", "variable", "definition", "code", "keyboard", "sample", "small", "subscript", "superscript", "mark", "deleted", "strikethrough", "inserted", "underline", "abbreviation", "isolate", "direction override", "data", "time", "output", "quote":
            inl = true
            ret _K_INLINE
        end
        "link":
            inl = true
            ret _K_LINK
        end
        "label":
            inl = true
            ret _K_LABEL
        end
        "break", "word break":
            inl = true
            ret _K_BR
        end
        "button": ret _K_BUTTON end
        "input", "checkbox", "radio": ret _K_INPUT end
        "text area", "textarea input": ret _K_TEXTAREA end
        "select": ret _K_SELECT end
        "option": ret _K_OPTION end
        "option group": ret _K_OPTGROUP end
        "image", "picture": ret _K_IMAGE end
        "summary": ret _K_SUMMARY end
        "details": ret _K_DETAILS end
        "dialog": ret _K_DIALOG end
        "form": ret _K_FORM end
        "item": ret _K_ITEM end
        "list", "menu": ret _K_LIST end
        "ordered list": ret _K_OLIST end
        "progress": ret _K_PROGRESS end
        "meter": ret _K_METER end
        "video", "canvas", "audio": ret _K_MEDIA end
        "field set": ret _K_FIELDSET end
        "row": ret _K_TABLE_ROW end
    end
    ret _K_BOX
end

func _new_node(d &: _Dom, kind: str, parent: int): int:
    mut nd := _Node { parent = parent }
    if kind == "#text":
        nd.kind = "#text"
        nd.k = _K_TEXT
    else:
        c := _canon(kind)
        key := _kind_key(c)
        if key.Len() == 0:
            _kind_report(c)
            nd.kind = c
            nd.k = _K_UNKNOWN
        else:
            _sfree(c)
            nd.kind = key
            mut il := false
            nd.k = _kind_class(key, il)
            nd.inl = il
        end
    end
    nd.kids = Vector {} as Vector<int>
    nd.names = Vector {} as Vector<str>
    nd.values = Vector {} as Vector<str>
    nd.pst = Vector {} as Vector<int>
    nd.pid = Vector {} as Vector<int>
    nd.dst = Vector {} as Vector<int>
    nd.dprop = Vector {} as Vector<int>
    nd.dval = Vector {} as Vector<style.Value>
    d.nodes.Push(
        nd
    )
    id := d.nodes.Len() - 1
    if parent >= 0:
        mut p := d.nodes.Ref(parent)
        p.kids.Push(id)
    end
    ret id
end

func _add_text(d &: _Dom, parent: int, text: str):
    if text.Len() == 0:
        ret
    end
    pk := d.nodes[parent].kids
    if pk.Len() > 0 and d.nodes[pk[pk.Len() - 1]].k == _K_TEXT:
        mut t := d.nodes.Ref(pk[pk.Len() - 1])
        old := t.text
        t.text = old + text
        _sfree(old)
        ret
    end
    id := _new_node(d, "#text", parent)
    mut tn := d.nodes.Ref(id)
    tn.text = str.Clone(text)
end

func _attr(d: _Dom, node: int, name: str): str:
    if node < 0 or node >= d.nodes.Len():
        ret ""
    end
    nd := d.nodes[node]
    repeat nd.names.Len() in i:
        if nd.names[i] == name:
            ret nd.values[i]
        end
    end
    ret ""
end

func _has_attr(d: _Dom, node: int, name: str): bool:
    if node < 0 or node >= d.nodes.Len():
        ret false
    end
    nd := d.nodes[node]
    repeat nd.names.Len() in i:
        if nd.names[i] == name:
            ret true
        end
    end
    ret false
end

func _set_attr(d &: _Dom, node: int, name: str, value: str):
    mut nd := d.nodes.Ref(node)
    repeat nd.names.Len() in i:
        if nd.names[i] == name:
            _sfree(nd.values[i])
            nd.values[i] = str.Clone(value)
            ret
        end
    end
    nd.names.Push(str.Clone(name))
    nd.values.Push(str.Clone(value))
end

func _remove_attr(d &: _Dom, node: int, name: str):
    mut nd := d.nodes.Ref(node)
    repeat nd.names.Len() in i:
        if nd.names[i] == name:
            _sfree(nd.names[i])
            _sfree(nd.values[i])
            nd.names.RemoveAt(i)
            nd.values.RemoveAt(i)
            ret
        end
    end
end

func _collect_text(d: _Dom, node: int, b &: str.StringBuilder):
    nd := d.nodes[node]
    if nd.k == _K_TEXT:
        str.BufAppend(b, nd.text)
        ret
    end
    if nd.k == _K_BR:
        str.BufAppend(b, "\n")
        ret
    end
    each k in nd.kids:
        _collect_text(d, k, b)
    end
end

func _text_of(d: _Dom, node: int): str:
    mut b := str.NewBuilder()
    _collect_text(d, node, b)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func _dom_free(d &: _Dom):
    repeat d.nodes.Len() in i:
        _free_node_data(d, i)
    end
    d.nodes.Free()
    each k in d.ev_kind:
        _sfree(k)
    end
    d.ev_node.Free()
    d.ev_kind.Free()
    d.ev_fn.Free()
end

func _free_node_data(d &: _Dom, i: int):
    mut nd := d.nodes.Ref(i)
    _sfree(nd.text)
    nd.text = ""
    each s in nd.names:
        _sfree(s)
    end
    each s in nd.values:
        _sfree(s)
    end
    nd.names.Free()
    nd.values.Free()
    nd.kids.Free()
    nd.pst.Free()
    nd.pid.Free()
    nd.dst.Free()
    nd.dprop.Free()
    nd.dval.Free()
end

func _is_ancestor(a: int, n: int): bool:
    mut c := n
    until c >= 0:
        if c == a:
            ret true
        end
        c = _e.dom.nodes[c].parent
    end
    ret false
end

func _ancestor_k(node: int, k: int): int:
    mut n := node
    until n >= 0:
        if _e.dom.nodes[n].k == k:
            ret n
        end
        n = _e.dom.nodes[n].parent
    end
    ret -1
end

func _input_type(node: int): str:
    nd := _e.dom.nodes[node]
    if nd.k != _K_INPUT:
        ret ""
    end
    if nd.kind == "checkbox" or nd.kind == "radio":
        ret nd.kind
    end
    t := _attr(_e.dom, node, "type")
    if t.Len() == 0:
        ret "text"
    end
    ret t
end

func _is_text_input(node: int): bool:
    if node < 0 or node >= _e.dom.nodes.Len():
        ret false
    end
    k := _e.dom.nodes[node].k
    if k == _K_TEXTAREA:
        ret true
    end
    if k != _K_INPUT:
        ret false
    end
    switch _input_type(node):
        "checkbox", "radio", "range", "color", "submit", "reset", "button", "hidden", "image", "file":
            ret false
        end
        else:
            ret true
        end
    end
    ret true
end

func _is_button_input(node: int): bool:
    t := _input_type(node)
    ret t == "submit" or t == "reset" or t == "button"
end

func _is_control(node: int): bool:
    k := _e.dom.nodes[node].k
    ret k == _K_INPUT or k == _K_TEXTAREA or k == _K_SELECT
end

func _style_key(node: int): str:
    nd := _e.dom.nodes[node]
    if nd.k == _K_INPUT:
        t := _input_type(node)
        if t == "checkbox" or t == "radio" or t == "range":
            ret t
        end
        if _is_button_input(node):
            ret "button"
        end
        ret "input"
    end
    if nd.k == _K_PAGE:
        ret "page"
    end
    if nd.kind == "heading":
        switch _attr(_e.dom, node, "level"):
            "2": ret "heading 2" end
            "3": ret "heading 3" end
            "4": ret "heading 4" end
            "5": ret "heading 5" end
            "6": ret "heading 6" end
        end
    end
    ret nd.kind
end
