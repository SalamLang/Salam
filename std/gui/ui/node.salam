        "div": ret "box (جعبه)" end
        "h1": ret "heading (سرتیتر)" end
        "h2": ret "heading (سرتیتر) with level 2" end
        "h3": ret "heading (سرتیتر) with level 3" end
        "h4": ret "heading (سرتیتر) with level 4" end
        "h5": ret "heading (سرتیتر) with level 5" end
        "h6": ret "heading (سرتیتر) with level 6" end
        "p": ret "paragraph (پاراگراف)" end
        "body", "html": ret "page (صفحه)" end
        "a": ret "link (پیوند)" end
        "b": ret "bold (پررنگ)" end
        "i": ret "italic (کج)" end
        "em": ret "emphasis (تاکید)" end
        "u": ret "underline (زیرخط)" end
        "s": ret "strikethrough (خط خورده)" end
        "q": ret "quote (نقل قول)" end
        "abbr": ret "abbreviation (کوته‌نوشت)" end
        "bdi": ret "isolate (جداساز جهت)" end
        "bdo": ret "direction override (جهت اجباری)" end
        "del": ret "deleted (حذف شده)" end
        "ins": ret "inserted (افزوده)" end
        "dfn": ret "definition (تعریف)" end
        "var": ret "variable (متغیر)" end
        "kbd": ret "keyboard (صفحه کلید)" end
        "samp": ret "sample (نمونه خروجی)" end
        "sub": ret "subscript (زیرنویس)" end
        "sup": ret "superscript (بالانویس)" end
        "br": ret "break (شکست)" end
        "wbr": ret "word break (شکست واژه)" end
        "hr": ret "line (خط)" end
        "img": ret "image (تصویر)" end
        "map": ret "image map (نقشه تصویر)" end
        "ul": ret "list (فهرست)" end
        "ol": ret "ordered list (فهرست شماره‌دار)" end
        "li": ret "item (مورد)" end
        "dl": ret "description list (فهرست تعریف)" end
        "dt": ret "term (واژه)" end
        "dd": ret "description (شرح)" end
        "pre": ret "preformatted (پیش‌قالب)" end
        "blockquote": ret "block quote (نقل قول بلند)" end
        "figcaption": ret "figure caption (زیرنویس شکل)" end
        "hgroup": ret "heading group (گروه سرتیتر)" end
        "fieldset": ret "field set (گروه فیلد)" end
        "optgroup": ret "option group (گروه گزینه)" end
        "datalist": ret "data list (فهرست پیشنهاد)" end
