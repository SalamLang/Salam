package ui

import gui.paint
import gui.typeset

mut _off_saved := _Engine {}
mut _off_open := false
mut _off_patches := Vector {} as Vector<Patch>

@en "AddFontFile"
@fa "افزودن پرونده قلم"
pub func AddFontFile(path: str): int:
    n := typeset.AddFontFile(_fc, path)
    _fonts_added += n
    ret n
end

@en "AddFontDir"
@fa "افزودن پوشه قلم"
pub func AddFontDir(dir: str): int:
    n := typeset.AddFontDir(_fc, dir)
    _fonts_added += n
    ret n
end

@en "OffscreenOpen"
@fa "گشودن بوم بی پنجره"
pub func OffscreenOpen(
    patches: func () Vector<Patch>, view: func (Builder), width: int, height: int, scale: f64
): bool:
    if _off_open or (_e.ready and _sc_on):
        ret false
    end
    _off_saved = _e
    _off_patches = _patches
    _e = _Engine {}
    _page_setup(patches, view)
    nd := _build_view()
    _render_dom(nd, width, height, scale)
    _e.damage.Clear()
    _e.full = false
    _off_open = true
    ret true
end

@en "OffscreenUpdate"
@fa "به روز رسانی بوم بی پنجره"
pub func OffscreenUpdate(poison: bool): int:
    if not _off_open:
        ret 0
    end
    _e.dirty_view = true
    _frame_update()
    area := _damage_area()
    _poison = poison
    _paint_all(_e.canvas)
    _poison = false
    _e.damage.Clear()
    ret area as int
end

@en "OffscreenRepaintAll"
@fa "نقاشی دوباره همه بوم بی پنجره"
pub func OffscreenRepaintAll():
    if not _off_open:
        ret
    end
    _e.full = true
    _paint_all(_e.canvas)
    _e.full = false
    _e.damage.Clear()
end

@en "OffscreenCanvas"
@fa "بوم بی پنجره"
pub func OffscreenCanvas(): paint.Canvas:
    if not _off_open:
        ret paint.Canvas {}
    end
    ret _e.canvas
end

@en "OffscreenClose"
@fa "بستن بوم بی پنجره"
pub func OffscreenClose():
    if not _off_open:
        ret
    end
    _off_open = false
    _free_engine()
    _e = _off_saved
    _patches = _off_patches
end
