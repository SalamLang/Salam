package ui

import mem
import os
import str

if SALAM_OS_WINDOWS:
    extern:
        func LoadLibraryW(name: void*): void*
        func GetProcAddress(module: void*, name: str): void*
        func MultiByteToWideChar(code_page: u32, flags: u32, text: str, length: i32, wide: void*, wide_len: i32): i32
    end

    func _ui_wide(s: str): void*:
        needed := MultiByteToWideChar(65001 as u32, 0 as u32, s, -1 as i32, null, 0 as i32)
        buf := mem.AllocateZeroed(((needed + 1) as u64) * (2 as u64))
        MultiByteToWideChar(65001 as u32, 0 as u32, s, -1 as i32, buf, (needed + 1) as i32)
        ret buf
    end

    func _shell_open(url: str): bool:
        lib := _ui_wide("shell32.dll")
        module := LoadLibraryW(lib)
        mem.Free(lib)
        if module == null:
            ret false
        end
        fp := GetProcAddress(module, "ShellExecuteW")
        if fp == null:
            ret false
        end
        verb := _ui_wide("open")
        target := _ui_wide(url)
        f := fp as extern stdcall func (void*, void*, void*, void*, void*, int) void*
        result := f(null, verb, target, null, null, 1)
        mem.Free(verb)
        mem.Free(target)
        ret (result as size) > 32
    end
else SALAM_OS_MAC:
    func _shell_open(url: str): bool:
        if url.includes("'"):
            ret false
        end
        ret os.Run("open '" + url + "' >/dev/null 2>&1") == 0
    end
else:
    func _shell_open(url: str): bool:
        if url.includes("'"):
            ret false
        end
        ret os.Run("xdg-open '" + url + "' >/dev/null 2>&1 &") == 0
    end
end

func _open_url_default(url: str): bool:
    off := os.Env("SALAM_UI_NO_BROWSER")
    blocked := off.len() > 0
    mem.Free(off as void*)
    if blocked or str.Len(url) == 0:
        ret false
    end
    ret _shell_open(url)
end
