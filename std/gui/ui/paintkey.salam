package ui

import gui.color
import gui.style

func _hdim(h: i64, d: style.Dim): i64:
    ret _hlen(_hmix(h, d.word as i64), d.len)
end

func _hpaints(h: i64, v: Vector<style.Paint>): i64:
    mut r := _hmix(h, v.Len() as i64)
    each p in v:
        r = _hmix(r, p.kind as i64)
        r = _hcol(r, p.color)
        r = _hf(r, p.angle)
        r = _hmix(r, p.side as i64)
        r = _hmix(r, p.circle ? 1 : 0)
        r = _hlen(r, p.at_x)
        r = _hlen(r, p.at_y)
        r = _hmix(r, p.has_at ? 1 : 0)
        r = _hstr(r, p.path)
        each st in p.stops:
            r = _hcol(r, st.color)
            r = _hlen(r, st.at)
            r = _hmix(r, st.has_at ? 1 : 0)
        end
    end
    ret r
end

func _hside(h: i64, w: style.Len, st: int, c: color.Color): i64:
    ret _hcol(_hmix(_hlen(h, w), st as i64), c)
end

func _group_hash(s: style.Style): i64:
    mut h := 1469598103934665603 as i64
    h = _hf(h, s.opacity)
    h = _hlen(h, s.blur)
    h = _hf(h, s.brightness)
    h = _hf(h, s.contrast)
    h = _hf(h, s.grayscale)
    h = _hf(h, s.saturate)
    h = _hf(h, s.sepia)
    h = _hf(h, s.invert)
    h = _hf(h, s.hue_rotate)
    h = _hlen(h, s.backdrop_blur)
    h = _hf(h, s.backdrop_brightness)
    h = _hf(h, s.backdrop_contrast)
    h = _hf(h, s.backdrop_grayscale)
    h = _hf(h, s.backdrop_saturate)
    h = _hf(h, s.backdrop_sepia)
    h = _hf(h, s.backdrop_invert)
    h = _hf(h, s.backdrop_hue_rotate)
    h = _hmix(h, s.blend as i64)
    h = _hmix(h, s.clip ? 1 : 0)
    h = _hmix(h, s.overflow_x as i64)
    h = _hmix(h, s.overflow_y as i64)
    h = _hlen(h, s.radius_top_start)
    h = _hlen(h, s.radius_top_end)
    h = _hlen(h, s.radius_bottom_end)
    h = _hlen(h, s.radius_bottom_start)
    h = _hmix(h, s.visible ? 1 : 0)
    ret h
end

func _paint_hash(s: style.Style): i64:
    mut h := _group_hash(s)
    h = _hpaints(h, s.background)
    h = _hdim(h, s.background_size_x)
    h = _hdim(h, s.background_size_y)
    h = _hdim(h, s.background_x)
    h = _hdim(h, s.background_y)
    h = _hmix(h, s.background_repeat as i64)
    h = _hside(h, s.border_top_width, s.border_top_style, s.border_top_color)
    h = _hside(h, s.border_end_width, s.border_end_style, s.border_end_color)
    h = _hside(h, s.border_bottom_width, s.border_bottom_style, s.border_bottom_color)
    h = _hside(h, s.border_start_width, s.border_start_style, s.border_start_color)
    h = _hside(h, s.outline_width, s.outline_style, s.outline_color)
    h = _hlen(h, s.outline_offset)
    h = _hshadows(h, s.shadow)
    h = _hmix(h, s.image_fit as i64)
    h = _hmix(h, s.scrollbar as i64)
    h = _hmix(h, s.decoration as i64)
    h = _hcol(h, s.decoration_color)
    h = _hmix(h, s.decoration_style as i64)
    h = _hdim(h, s.decoration_thickness)
    h = _hmix(h, s.layer as i64)
    h = _hmix(h, s.order as i64)
    ret h
end
