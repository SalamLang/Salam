package ui

import math
import gui.cssbox

const _REVEAL_FOCUS := 0
const _REVEAL_START := 1
const _REVEAL_END := 2
const _REVEAL_NEAREST := 3
const _REVEAL_CENTER := 4

func _virt_estimate(node: int, b: _Box, l: cssbox.BoxLayout):
    c := _e.ctl[node]
    x := b.x + l.border.left + l.padding.left
    y0 := b.y + l.border.top + l.padding.top - c.scroll_y
    each k in _e.dom.nodes[node].kids:
        if k < _e.vskip.len() and _e.vskip[k] == node:
            _e.boxes[k] = _Box { x = x, y = y0 + _e.vtop[k], w = l.content_width, h = _e.vh[k], shown = false, clip_x0 = b.clip_x0, clip_y0 = b.clip_y0, clip_x1 = b.clip_x1, clip_y1 = b.clip_y1 }
        end
    end
end

func _rect_box(n: int): _Box:
    b := _e.boxes[n]
    if b.shown:
        ret b
    end
    vr := _virt_row_of(n)
    if vr >= 0:
        ret _e.boxes[vr]
    end
    ret b
end

func _reveal_pos(cur: f64, top: f64, h: f64, view: f64, mode: int): f64:
    switch mode:
        _REVEAL_START:
            ret top
        end
        _REVEAL_END:
            ret top + h - view
        end
        _REVEAL_CENTER:
            ret top - (view - h) / 2.0
        end
        else:
            break
        end
    end
    if top >= cur and top + h <= cur + view:
        ret cur
    end
    if mode == _REVEAL_NEAREST or (top < cur + view and top + h > cur):
        if top < cur or h > view:
            ret top
        end
        ret top + h - view
    end
    ret top - (view - h) / 2.0
end

func _scroller_of(node: int): int:
    mut p := _e.dom.nodes[node].parent
    until p >= 0 and p != _e.dom.body and p != _e.dom.html:
        if _e.node_cb[p] >= 0 and _e.node_el[p] >= 0 and _is_scroller(_style_of(p)):
            ret p
        end
        p = _e.dom.nodes[p].parent
    end
    ret -1
end

func _reveal(node: int, mode: int):
    if node < 0 or node >= _e.boxes.len():
        ret
    end
    vr := _virt_row_of(node)
    if vr >= 0:
        cont := _e.vskip[vr]
        l := _e.tree.Layout(_e.node_cb[cont])
        view := l.height - l.border.top - l.border.bottom - l.scrollbar_height
        c := _e.ctl[cont]
        top := l.padding.top + _e.vtop[vr]
        mut ny := math.Round(_reveal_pos(c.scroll_y, top, _e.vh[vr], view, mode))
        cu := _row_uid(cont)
        if _e.vmax.has(cu):
            ny = math.Min(ny, _e.vmax.get(cu))
        end
        ny = math.Max(0.0, ny)
        if ny != c.scroll_y:
            mut cc := _e.ctl.ref(cont)
            cc.scroll_y = ny
            _e.dirty_layout = true
        end
        ret
    end
    b := _e.boxes[node]
    if not b.shown:
        ret
    end
    mut ey := b.y
    sc := _scroller_of(node)
    if sc >= 0:
        l := _e.tree.Layout(_e.node_cb[sc])
        pb := _e.boxes[sc]
        port := pb.y + l.border.top
        view := l.height - l.border.top - l.border.bottom - l.scrollbar_height
        c := _e.ctl[sc]
        top := ey - port + c.scroll_y
        maxy := math.Max(0.0, l.scroll_height - view)
        ny := math.Max(0.0, math.Min(maxy, math.Round(_reveal_pos(c.scroll_y, top, b.h, view, mode))))
        if ny != c.scroll_y:
            ey -= ny - c.scroll_y
            mut cc := _e.ctl.ref(sc)
            cc.scroll_y = ny
            if _virt_has(sc):
                _e.dirty_layout = true
            else:
                _e.dirty_place = true
            end
        end
    end
    top := ey + _e.vscroll
    maxs := math.Max(0.0, _e.doc_h - _e.height)
    nv := math.Max(0.0, math.Min(maxs, math.Round(_reveal_pos(_e.vscroll, top, b.h, _e.height, mode))))
    if nv != _e.vscroll:
        _e.vscroll = nv
        _e.dirty_place = true
    end
end
