package ui

import str

mut _sc := Vector {} as Vector<_Scope>
mut _sc_free := Vector {} as Vector<int>
mut _sc_cur := -1
mut _sc_root := -1
mut _sc_on := false
mut _sc_words := 0
mut _sc_take := (_w: int): ret 0 as i64 end
mut _sc_site_mask := Vector {} as Vector<i64>
mut _sc_site_comp := Vector {} as Vector<int>
mut _sc_runs := 0
mut _sc_invalid := false
mut _sc_match := Vector {} as Vector<int>
mut _sc_touch_comp := Vector {} as Vector<int>
mut _sc_touch_slot := Vector {} as Vector<int>
mut _sc_slot_next := Vector {} as Vector<int>
mut _sc_slot_free_c := Vector {} as Vector<int>
mut _sc_slot_free_s := Vector {} as Vector<int>
mut _sc_dead := 0
mut _sc_touched := Vector {} as Vector<i64>
mut _sc_text_nodes := Vector {} as Vector<int>
mut _sc_el_changed := Vector {} as Vector<int>

struct _Scope:
    pub site: int = -1
    pub key: str = ""
    pub parent: int = -1
    pub kids: Vector<int> = Vector {}
    pub fn: func (Builder) = (_b: Builder): _sc_touched.clear() end
    pub dnode: int = -1
    pub pre: int = 0
    pub count: int = 0
    pub bstart: int = 0
    pub comp: int = -1
    pub slot: int = -1
    pub fresh: bool = false
    pub taken: bool = false
    pub alive: bool = false
    pub dirty: bool = false
end

func _sc_new(): int:
    if _sc_free.len() > 0:
        id := _sc_free.pop()
        mut s := _sc.ref(id)
        s.kids = Vector {} as Vector<int>
        s.alive = true
        s.dirty = false
        s.taken = false
        s.fresh = false
        s.comp = -1
        s.slot = -1
        s.count = 0
        s.pre = 0
        s.key = ""
        ret id
    end
    mut s := _Scope { alive = true }
    s.kids = Vector {} as Vector<int>
    _sc.push(s)
    ret _sc.len() - 1
end

func _sc_slot_alloc(comp: int): int:
    repeat _sc_slot_free_c.len() in i:
        if _sc_slot_free_c[i] == comp:
            s := _sc_slot_free_s[i]
            _sc_slot_free_c.remove_at(i)
            _sc_slot_free_s.remove_at(i)
            ret s
        end
    end
    until _sc_slot_next.len() <= comp:
        _sc_slot_next.push(0)
    end
    s := _sc_slot_next[comp]
    _sc_slot_next[comp] = s + 1
    ret s
end

func _sc_release(id: int):
    if id < 0 or id >= _sc.len() or not _sc[id].alive:
        ret
    end
    kids := _sc[id].kids
    each k in kids:
        _sc_release(k)
    end
    mut s := _sc.ref(id)
    if s.slot >= 0 and s.comp >= 0:
        _sc_slot_free_c.push(s.comp)
        _sc_slot_free_s.push(s.slot)
    end
    s.slot = -1
    s.alive = false
    if s.key.len() > 0:
        _sfree(s.key)
        s.key = ""
    end
    s.kids.free()
    s.kids = Vector {} as Vector<int>
    _sc_free.push(id)
end

func _sc_release_all():
    repeat _sc.len() in i:
        if _sc[i].alive:
            mut s := _sc.ref(i)
            s.alive = false
            if s.key.len() > 0:
                _sfree(s.key)
                s.key = ""
            end
            s.kids.free()
            s.kids = Vector {} as Vector<int>
        end
    end
    _sc.clear()
    _sc_free.clear()
    _sc_root = -1
end

func _sc_reset():
    _sc_release_all()
    _sc_on = false
    _sc_words = 0
    _sc_site_mask.clear()
    _sc_site_comp.clear()
    _sc_runs = 0
    _sc_invalid = false
    _sc_touch_comp.clear()
    _sc_touch_slot.clear()
    _sc_slot_next.clear()
    _sc_slot_free_c.clear()
    _sc_slot_free_s.clear()
    _sc_dead = 0
    _sc_cur = -1
end

func _sc_pos(id: int): int:
    s := _sc[id]
    p := s.parent
    if p < 0:
        ret s.pre
    end
    mut base := 0
    if _sc[p].dnode == s.dnode:
        base = _sc_pos(p)
    end
    base += s.pre
    each k in _sc[p].kids:
        if k == id:
            break
        end
        if _sc[k].dnode == s.dnode:
            base += _sc[k].count
        end
    end
    ret base
end

func _sc_open(site: int, key: str, fn: func (Builder)):
    d := _b_top()
    parent := _sc_cur
    id := _sc_new()
    start := _bd.nodes[d].kids.len()
    mut base := 0
    mut nth := 0
    if parent >= 0:
        if _sc[parent].dnode == d:
            base = _sc[parent].bstart
        end
        each k in _sc[parent].kids:
            if _sc[k].dnode == d:
                base += _sc[k].count
            end
            if _sc[k].site == site and _sc[k].key == key:
                nth++
            end
        end
    end
    mut old := -1
    mut seen := 0
    each m in _sc_match:
        if _sc[m].site == site and _sc[m].key == key:
            if seen == nth:
                if not _sc[m].taken:
                    old = m
                end
                break
            end
            seen++
        end
    end
    mut sc := _sc.ref(id)
    sc.site = site
    if key.len() > 0:
        sc.key = str.Clone(key)
    end
    sc.parent = parent
    sc.fn = fn
    sc.dnode = d
    sc.bstart = start
    sc.pre = start - base
    if old >= 0:
        mut o := _sc.ref(old)
        o.taken = true
        sc.comp = o.comp
        sc.slot = o.slot
        o.slot = -1
    end
    if parent >= 0:
        mut ps := _sc.ref(parent)
        ps.kids.push(id)
    else:
        _sc_root = id
    end
    saved := _sc_match
    if old >= 0:
        _sc_match = _sc[old].kids
    else:
        _sc_match = Vector {} as Vector<int>
    end
    _sc_cur = id
    fn(Builder {})
    _sc_cur = parent
    if old < 0:
        _sc_match.free()
    end
    _sc_match = saved
    mut sc2 := _sc.ref(id)
    sc2.count = _bd.nodes[d].kids.len() - start
end

func _sc_instance(comp: int): int:
    if _sc_cur < 0:
        ret 0
    end
    mut s := _sc.ref(_sc_cur)
    if s.slot < 0:
        s.comp = comp
        s.slot = _sc_slot_alloc(comp)
        s.fresh = true
    else:
        s.fresh = false
    end
    ret s.slot
end

func _sc_is_fresh(): bool:
    if _sc_cur < 0:
        ret true
    end
    ret _sc[_sc_cur].fresh
end

func _sc_register(words: int, take: func (int) i64, sites: func ()):
    if _sc_on:
        ret
    end
    _sc_on = true
    _sc_words = words
    _sc_take = take
    sites()
end

func _sc_set_site(site: int, comp: int, word: int, mask: i64):
    if site < 0 or word < 0 or word >= _sc_words:
        ret
    end
    until _sc_site_comp.len() <= site:
        _sc_site_comp.push(-1)
        repeat _sc_words:
            _sc_site_mask.push(0 as i64)
        end
    end
    _sc_site_comp[site] = comp
    i := site * _sc_words + word
    _sc_site_mask[i] |= mask
end

func _sc_build_root(view: func (Builder)):
    old_root := _sc_root
    _sc_match.free()
    _sc_match = Vector {} as Vector<int>
    if old_root >= 0:
        _sc_match.push(old_root)
    end
    _sc_root = -1
    _sc_cur = -1
    _sc_open(0, "", view)
    _sc_match.free()
    _sc_match = Vector {} as Vector<int>
    if old_root >= 0:
        _sc_release(old_root)
    end
    _sc_dead = 0
end

func _sc_in_subtree(node: int, d: int, tops: Vector<int>): bool:
    mut n := node
    mut guard := 0
    until n >= 0 and guard < 100000:
        guard++
        p := _e.dom.nodes[n].parent
        if p == d:
            each t in tops:
                if t == n:
                    ret true
                end
            end
            ret false
        end
        n = p
    end
    ret false
end

func _sc_same_list(a: Vector<str>, b: Vector<str>): bool:
    if a.len() != b.len():
        ret false
    end
    repeat a.len() in i:
        if a[i] != b[i]:
            ret false
        end
    end
    ret true
end

func _sc_same_ints(a: Vector<int>, b: Vector<int>): bool:
    if a.len() != b.len():
        ret false
    end
    repeat a.len() in i:
        if a[i] != b[i]:
            ret false
        end
    end
    ret true
end

func _sc_same_shape(o: int, n: int): bool:
    old_nd := _e.dom.nodes[o]
    new_nd := _e.dom.nodes[n]
    if old_nd.kind != new_nd.kind or old_nd.kids.len() != new_nd.kids.len():
        ret false
    end
    if _attr(_e.dom, o, "key") != _attr(_e.dom, n, "key"):
        ret false
    end
    repeat old_nd.kids.len() in i:
        if not _sc_same_shape(old_nd.kids[i], new_nd.kids[i]):
            ret false
        end
    end
    ret true
end

func _sc_patch(o: int, n: int, map &: Vector<int>, nbefore: int):
    map[n - nbefore] = o
    old_nd := _e.dom.nodes[o]
    new_nd := _e.dom.nodes[n]
    if old_nd.text != new_nd.text:
        mut a := _e.dom.nodes.ref(o)
        mut b := _e.dom.nodes.ref(n)
        t := a.text
        a.text = b.text
        b.text = t
        _sc_text_nodes.push(o)
    end
    same := _sc_same_list(old_nd.names, new_nd.names) and _sc_same_list(old_nd.values, new_nd.values) and old_nd.smask == new_nd.smask and _sc_same_ints(old_nd.pst, new_nd.pst) and _sc_same_ints(old_nd.pid, new_nd.pid) and _sc_same_ints(old_nd.dst, new_nd.dst) and _sc_same_ints(old_nd.dprop, new_nd.dprop)
    if not same:
        mut a2 := _e.dom.nodes.ref(o)
        mut b2 := _e.dom.nodes.ref(n)
        tn := a2.names
        a2.names = b2.names
        b2.names = tn
        tv := a2.values
        a2.values = b2.values
        b2.values = tv
        tp := a2.pst
        a2.pst = b2.pst
        b2.pst = tp
        tpi := a2.pid
        a2.pid = b2.pid
        b2.pid = tpi
        td := a2.dst
        a2.dst = b2.dst
        b2.dst = td
        tdp := a2.dprop
        a2.dprop = b2.dprop
        b2.dprop = tdp
        tdv := a2.dval
        a2.dval = b2.dval
        b2.dval = tdv
        a2.smask = b2.smask
        _sc_el_changed.push(o)
    end
    repeat old_nd.kids.len() in i:
        _sc_patch(old_nd.kids[i], new_nd.kids[i], map, nbefore)
    end
end

func _sc_free_node(i: int):
    mut nd := _e.dom.nodes.ref(i)
    _sfree(nd.text)
    each s in nd.names:
        _sfree(s)
    end
    each s in nd.values:
        _sfree(s)
    end
    nd.names.free()
    nd.values.free()
    nd.kids.free()
    nd.pst.free()
    nd.pid.free()
    nd.dst.free()
    nd.dprop.free()
    nd.dval.free()
end


func _sc_drop_events(before: int, d: int, tops: Vector<int>):
    mut nn := Vector {} as Vector<int>
    mut nk := Vector {} as Vector<str>
    mut nf := Vector {} as Vector<func ()>
    repeat _e.dom.ev_node.len() in i:
        node := _e.dom.ev_node[i]
        if i < before and _sc_in_subtree(node, d, tops):
            _sfree(_e.dom.ev_kind[i])
            continue
        end
        nn.push(node)
        nk.push(_e.dom.ev_kind[i])
        nf.push(_e.dom.ev_fn[i])
    end
    _e.dom.ev_node.free()
    _e.dom.ev_kind.free()
    _e.dom.ev_fn.free()
    _e.dom.ev_node = nn
    _e.dom.ev_kind = nk
    _e.dom.ev_fn = nf
end

func _sc_subtree_size(n: int): int:
    mut c := 1
    each k in _e.dom.nodes[n].kids:
        c += _sc_subtree_size(k)
    end
    ret c
end

func _sc_remap_uid(node: int, d: int, tops: Vector<int>, from: int): int:
    if node < 0 or node >= from or not _sc_in_subtree(node, d, tops):
        ret node
    end
    uid := _e.ctl[node].uid
    repeat _e.ctl.len() - from in i:
        if _e.ctl[from + i].uid == uid:
            ret from + i
        end
    end
    ret -1
end

func _sc_match_tops(olds: Vector<int>, news: Vector<int>):
    mut used := Vector {} as Vector<bool>
    defer used.free()
    repeat olds.len():
        used.push(false)
    end
    mut kinds := Vector {} as Vector<str>
    defer kinds.free()
    mut counts := Vector {} as Vector<int>
    defer counts.free()
    each k in news:
        t := _e.dom.nodes[k].kind
        if t == "#text":
            continue
        end
        mut nth := 0
        mut slot := -1
        repeat kinds.len() in q:
            if kinds[q] == t:
                slot = q
            end
        end
        if _attr(_e.dom, k, "id").len() == 0 and _attr(_e.dom, k, "key").len() == 0:
            if slot < 0:
                kinds.push(t)
                counts.push(1)
            else:
                nth = counts[slot]
                counts[slot] = nth + 1
            end
        end
        j := _match_kid(_e.dom, olds, used, _e.dom, k, nth)
        if j >= 0:
            used[j] = true
            mut nc := _e.ctl
            _rec_match(_e.dom, _e.ctl, olds[j], _e.dom, nc, k)
            _e.ctl = nc
        end
    end
end


func _sc_rerun(id: int):
    d := _sc[id].dnode
    pos := _sc_pos(id)
    oldcount := _sc[id].count
    mut olds := Vector {} as Vector<int>
    defer olds.free()
    dk := _e.dom.nodes[d].kids
    repeat oldcount in i:
        if pos + i < dk.len():
            olds.push(dk[pos + i])
        end
    end
    oldkids := _sc[id].kids
    mut s0 := _sc.ref(id)
    s0.kids = Vector {} as Vector<int>
    s0.dirty = false
    nbefore := _e.dom.nodes.len()
    evbefore := _e.dom.ev_node.len()
    _bd = _e.dom
    _bstack.clear()
    _bstack.push(d)
    start := _bd.nodes[d].kids.len()
    mut s1 := _sc.ref(id)
    s1.bstart = start
    _sc_match = oldkids
    _sc_cur = id
    fn := _sc[id].fn
    fn(Builder {})
    _sc_cur = -1
    _sc_match = Vector {} as Vector<int>
    _e.dom = _bd
    _bd = _Dom {}
    _bstack.clear()
    newcount := _e.dom.nodes[d].kids.len() - start
    mut news := Vector {} as Vector<int>
    defer news.free()
    repeat newcount in i:
        news.push(_e.dom.nodes[d].kids[start + i])
    end
    mut same := newcount == olds.len()
    if same:
        repeat newcount in i:
            if same and not _sc_same_shape(olds[i], news[i]):
                same = false
            end
        end
    end
    if same:
        mut map := Vector {} as Vector<int>
        defer map.free()
        repeat _e.dom.nodes.len() - nbefore:
            map.push(-1)
        end
        repeat newcount in i:
            _sc_patch(olds[i], news[i], map, nbefore)
        end
        _sc_drop_events(evbefore, d, olds)
        repeat _e.dom.ev_node.len() in k:
            en := _e.dom.ev_node[k]
            if en >= nbefore and map[en - nbefore] >= 0:
                _e.dom.ev_node[k] = map[en - nbefore]
            end
        end
        repeat _sc.len() in q:
            if _sc[q].alive and _sc[q].dnode >= nbefore:
                mut sq := _sc.ref(q)
                sq.dnode = map[sq.dnode - nbefore]
            end
        end
        mut dn := _e.dom.nodes.ref(d)
        repeat newcount:
            _x := dn.kids.pop()
        end
        repeat _e.dom.nodes.len() - nbefore in r:
            _sc_free_node(nbefore + r)
        end
        until _e.dom.nodes.len() > nbefore:
            _y := _e.dom.nodes.pop()
        end
    else:
        mut dn2 := _e.dom.nodes.ref(d)
        repeat newcount:
            _x2 := dn2.kids.pop()
        end
        repeat olds.len():
            dn2.kids.remove_at(pos)
        end
        repeat newcount in i:
            dn2.kids.insert(pos + i, news[i])
        end
        delta := newcount - oldcount
        mut sc := _sc.ref(id)
        sc.count = newcount
        mut a := _sc[id].parent
        until a >= 0 and _sc[a].dnode == d:
            mut sa := _sc.ref(a)
            sa.count += delta
            a = sa.parent
        end
        repeat _e.dom.nodes.len() - _e.ctl.len():
            _e.ctl.push(_new_ctl())
        end
        _sc_match_tops(olds, news)
        repeat _e.ctl.len() - nbefore in i:
            if _e.ctl[nbefore + i].uid == 0:
                _e.ctl[nbefore + i] = _new_ctl()
            end
        end
        _e.focus = _sc_remap_uid(_e.focus, d, olds, nbefore)
        _e.hover = _sc_remap_uid(_e.hover, d, olds, nbefore)
        _e.popup = _sc_remap_uid(_e.popup, d, olds, nbefore)
        _e.capture = _sc_remap_uid(_e.capture, d, olds, nbefore)
        _e.active = _sc_remap_uid(_e.active, d, olds, nbefore)
        _e.last_click = _sc_remap_uid(_e.last_click, d, olds, nbefore)
        _sc_drop_events(evbefore, d, olds)
        each o in olds:
            _sc_dead += _sc_subtree_size(o)
        end
        _e.dirty_dom = true
    end
    each k in oldkids:
        _sc_release(k)
    end
    mut ok := oldkids
    ok.free()
    _sc_runs++
end

func _sc_depth(id: int): int:
    mut n := 0
    mut p := _sc[id].parent
    until p >= 0:
        n++
        p = _sc[p].parent
    end
    ret n
end


func _sc_fast_text(): bool:
    ret false
end

func _sc_full():
    _sc_invalid = false
    _sc_runs++
    _load_dom(_build_view())
end

func _sc_update():
    mut any := false
    _sc_touched.clear()
    repeat _sc_words in w:
        t := _sc_take(w)
        _sc_touched.push(t)
        if t != 0:
            any = true
        end
    end
    if _sc_invalid:
        _sc_full()
        ret
    end
    if not any and _sc_touch_comp.len() == 0:
        ret
    end
    mut dirty := Vector {} as Vector<int>
    defer dirty.free()
    repeat _sc.len() in i:
        s := _sc[i]
        if not s.alive:
            continue
        end
        mut hit := false
        if s.site >= 0 and s.site < _sc_site_comp.len() and any:
            repeat _sc_words in w:
                if (_sc_site_mask[s.site * _sc_words + w] & _sc_touched[w]) != 0:
                    hit = true
                end
            end
        end
        if not hit and s.slot >= 0:
            repeat _sc_touch_comp.len() in k:
                if _sc_touch_comp[k] == s.comp and _sc_touch_slot[k] == s.slot:
                    hit = true
                end
            end
        end
        if hit:
            dirty.push(i)
            mut sd := _sc.ref(i)
            sd.dirty = true
        end
    end
    _sc_touch_comp.clear()
    _sc_touch_slot.clear()
    if dirty.len() == 0:
        ret
    end
    mut depth := Vector {} as Vector<int>
    defer depth.free()
    mut maxd := 0
    each di in dirty:
        dv := _sc_depth(di)
        depth.push(dv)
        if dv > maxd:
            maxd = dv
        end
    end
    _sc_text_nodes.clear()
    _sc_el_changed.clear()
    repeat maxd + 1 in level:
        repeat dirty.len() in j:
            if depth[j] == level and _sc[dirty[j]].alive and _sc[dirty[j]].dirty:
                _sc_rerun(dirty[j])
            end
        end
    end
    if _e.dirty_dom:
        if _sc_dead > 2 * (_e.dom.nodes.len() - _sc_dead) + 512:
            _e.dirty_dom = false
            _sc_full()
        end
        ret
    end
    each node in _sc_el_changed:
        _restyle(node)
        _e.dirty_layout = true
    end
    if _sc_text_nodes.len() > 0:
        _e.dirty_layout = true
    end
end

func _sc_active(): bool:
    ret _sc_on
end

@en "ScopeSite"
@fa "جایگاه دامنه"
pub func ScopeSite(site: int, comp: int, word: int, mask: i64):
    _sc_set_site(site, comp, word, mask)
end

@en "TouchInstance"
@fa "لمس نمونه"
pub func TouchInstance(comp: int, slot: int):
    if _sc_cur >= 0:
        ret
    end
    _sc_touch_comp.push(comp)
    _sc_touch_slot.push(slot)
    _e.dirty_view = true
end

@en "Invalidate"
@fa "بی اعتبار سازی"
pub func Invalidate():
    _sc_invalid = true
    _e.dirty_view = true
end

@en "ScopeRuns"
@fa "شمار اجرای دامنه"
pub func ScopeRuns(): int:
    ret _sc_runs
end

