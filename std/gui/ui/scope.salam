package ui

import os
import str
import gui.style
import gui.window

mut _sc := Vector {} as Vector<_Scope>
mut _sc_free := Vector {} as Vector<int>
mut _sc_cur := -1
mut _lv := _Level {}
mut _pos_gen := 1
mut _sc_root := -1
mut _sc_on := false
mut _sc_words := 0
mut _sc_take := (_w: int): ret 0 as i64 end
mut _sc_site_mask := Vector {} as Vector<i64>
mut _sc_site_comp := Vector {} as Vector<int>
mut _sc_runs := 0
mut _sc_trace_state := 0
mut _sc_built := 0
mut _sc_invalid := false
mut _sc_match := Vector {} as Vector<int>
mut _sc_touch_comp := Vector {} as Vector<int>
mut _sc_touch_slot := Vector {} as Vector<int>
mut _sc_touch_mask := Vector {} as Vector<int>
mut _sc_vs_site := Vector {} as Vector<int>
mut _sc_vs_comp := Vector {} as Vector<int>
mut _sc_vs_mask := Vector {} as Vector<int>
mut _sc_dv_comp := Vector {} as Vector<int>
mut _sc_dv_fn := Vector {} as Vector<func (int, int) int>
mut _sc_slot_next := Vector {} as Vector<int>
mut _sc_slot_free_c := Vector {} as Vector<int>
mut _sc_slot_free_s := Vector {} as Vector<int>
mut _sc_dead := 0
mut _sc_touched := Vector {} as Vector<i64>
mut _sc_text_nodes := Vector {} as Vector<int>
mut _sc_el_changed := Vector {} as Vector<int>
mut _sc_ev_head := Vector {} as Vector<int>
mut _sc_ev_next := Vector {} as Vector<int>
mut _sc_ev_built := false
mut _sc_ev_dead := 0
mut _sc_made := Vector {} as Vector<int>
mut _sc_tracking := false
mut _sc_rerun_id := -1
mut _sc_skipped := false
mut _sc_skips := 0

struct _Scope:
    pub site: int = -1
    pub key: str = ""
    pub parent: int = -1
    pub kids: Vector<int> = Vector {}
    pub fn: func (Builder) = (_b: Builder): _sc_touched.Clear() end
    pub dnode: int = -1
    pub pre: int = 0
    pub count: int = 0
    pub bstart: int = 0
    pub comp: int = -1
    pub slot: int = -1
    pub fresh: bool = false
    pub taken: bool = false
    pub alive: bool = false
    pub dirty: bool = false
    pub pos_gen: int = 0
    pub pos: int = 0
    pub memo: str = ""
    pub memo_set: bool = false
end

struct _Level:
    pub d: int = -1
    pub acc: int = 0
    pub nk: int = 0
    pub built: bool = false
    pub counts: HashMap<i64, int> = HashMap {}
    pub match_at: HashMap<i64, int> = HashMap {}
end

func _lv_key(site: int, key: str): i64:
    ret _hmix(_hstr(1469598103934665603 as i64, key), site as i64)
end

func _lv_fresh(): _Level:
    mut v := _Level {}
    v.counts = HashMap {} as HashMap<i64, int>
    v.match_at = HashMap {} as HashMap<i64, int>
    ret v
end

func _lv_free():
    _lv.counts.Free()
    _lv.match_at.Free()
end

func _lv_sync(parent: int, d: int):
    if _lv.d != d:
        _lv.d = d
        _lv.acc = 0
        repeat _lv.nk in i:
            k := _sc[parent].kids[i]
            if _sc[k].dnode == d:
                _lv.acc += _sc[k].count
            end
        end
    end
    until _lv.nk < _sc[parent].kids.Len():
        k := _sc[parent].kids[_lv.nk]
        h := _lv_key(_sc[k].site, _sc[k].key)
        _lv.counts.Put(h, _lv.counts.Has(h) ? _lv.counts.Get(h) + 1 : 1)
        if _sc[k].dnode == d:
            _lv.acc += _sc[k].count
        end
        _lv.nk++
    end
end

func _lv_match_old(site: int, key: str, nth: int): int:
    if not _lv.built:
        _lv.built = true
        mut seen := HashMap {} as HashMap<i64, int>
        each m in _sc_match:
            h := _lv_key(_sc[m].site, _sc[m].key)
            n := seen.Has(h) ? seen.Get(h) : 0
            _lv.match_at.Put(_hmix(h, n as i64), m)
            seen.Put(h, n + 1)
        end
        seen.Free()
    end
    at := _hmix(_lv_key(site, key), nth as i64)
    if not _lv.match_at.Has(at):
        ret -1
    end
    m := _lv.match_at.Get(at)
    if _sc[m].site != site or _sc[m].key != key or _sc[m].taken:
        ret -1
    end
    ret m
end

func _sc_new(): int:
    if _sc_free.Len() > 0:
        id := _sc_free.Pop()
        mut s := _sc.Ref(id)
        s.kids = Vector {} as Vector<int>
        s.alive = true
        s.dirty = false
        s.taken = false
        s.fresh = false
        s.comp = -1
        s.slot = -1
        s.count = 0
        s.pre = 0
        s.pos_gen = 0
        s.key = ""
        if _sc_tracking:
            _sc_made.Push(id)
        end
        ret id
    end
    mut s := _Scope { alive = true }
    s.kids = Vector {} as Vector<int>
    _sc.Push(s)
    if _sc_tracking:
        _sc_made.Push(_sc.Len() - 1)
    end
    ret _sc.Len() - 1
end

func _sc_slot_alloc(comp: int): int:
    repeat _sc_slot_free_c.Len() in i:
        if _sc_slot_free_c[i] == comp:
            s := _sc_slot_free_s[i]
            _sc_slot_free_c.RemoveAt(i)
            _sc_slot_free_s.RemoveAt(i)
            ret s
        end
    end
    until _sc_slot_next.Len() <= comp:
        _sc_slot_next.Push(0)
    end
    s := _sc_slot_next[comp]
    _sc_slot_next[comp] = s + 1
    ret s
end

func _sc_release(id: int):
    if id < 0 or id >= _sc.Len() or not _sc[id].alive:
        ret
    end
    kids := _sc[id].kids
    each k in kids:
        _sc_release(k)
    end
    mut s := _sc.Ref(id)
    if s.slot >= 0 and s.comp >= 0:
        _sc_slot_free_c.Push(s.comp)
        _sc_slot_free_s.Push(s.slot)
    end
    s.slot = -1
    s.alive = false
    if s.key.Len() > 0:
        _sfree(s.key)
        s.key = ""
    end
    if s.memo_set:
        _sfree(s.memo)
        s.memo = ""
        s.memo_set = false
    end
    s.kids.Free()
    s.kids = Vector {} as Vector<int>
    _sc_free.Push(id)
end

func _sc_release_all():
    repeat _sc.Len() in i:
        if _sc[i].alive:
            mut s := _sc.Ref(i)
            s.alive = false
            if s.key.Len() > 0:
                _sfree(s.key)
                s.key = ""
            end
            if s.memo_set:
                _sfree(s.memo)
                s.memo = ""
                s.memo_set = false
            end
            s.kids.Free()
            s.kids = Vector {} as Vector<int>
        end
    end
    _sc.Clear()
    _sc_free.Clear()
    _sc_root = -1
end

func _sc_reset():
    _sc_release_all()
    _sc_on = false
    _sc_words = 0
    _sc_site_mask.Clear()
    _sc_site_comp.Clear()
    _sc_vs_site.Clear()
    _sc_vs_comp.Clear()
    _sc_vs_mask.Clear()
    _sc_dv_comp.Clear()
    _sc_dv_fn.Clear()
    _sc_runs = 0
    _sc_invalid = false
    _sc_touch_comp.Clear()
    _sc_touch_slot.Clear()
    _sc_touch_mask.Clear()
    _sc_slot_next.Clear()
    _sc_slot_free_c.Clear()
    _sc_slot_free_s.Clear()
    _sc_dead = 0
    _sc_cur = -1
end

func _sc_pos(id: int): int:
    if _sc[id].pos_gen == _pos_gen:
        ret _sc[id].pos
    end
    p := _sc[id].parent
    if p < 0:
        ret _sc[id].pre
    end
    pd := _sc[p].dnode
    pbase := _sc_pos(p)
    mut last := -1
    mut sum := 0
    mut seen := HashMap {} as HashMap<int, int>
    each k in _sc[p].kids:
        kd := _sc[k].dnode
        if kd != last:
            if last >= 0:
                seen.Put(last, sum)
            end
            sum = seen.Has(kd) ? seen.Get(kd) : 0
            last = kd
        end
        mut kk := _sc.Ref(k)
        kk.pos = (kd == pd ? pbase : 0) + kk.pre + sum
        kk.pos_gen = _pos_gen
        sum += kk.count
    end
    seen.Free()
    ret _sc[id].pos
end

func _sc_open(site: int, key: str, fn: func (Builder)):
    d := _b_top()
    parent := _sc_cur
    id := _sc_new()
    start := _bd.nodes[d].kids.Len()
    mut base := 0
    mut nth := 0
    if parent >= 0:
        _lv_sync(parent, d)
        if _sc[parent].dnode == d:
            base = _sc[parent].bstart
        end
        base += _lv.acc
        h := _lv_key(site, key)
        if _lv.counts.Has(h):
            nth = _lv.counts.Get(h)
        end
    end
    old := _lv_match_old(site, key, nth)
    mut sc := _sc.Ref(id)
    sc.site = site
    if key.Len() > 0:
        sc.key = str.Clone(key)
    end
    sc.parent = parent
    sc.fn = fn
    sc.dnode = d
    sc.bstart = start
    sc.pre = start - base
    if old >= 0:
        mut o := _sc.Ref(old)
        o.taken = true
        sc.comp = o.comp
        sc.slot = o.slot
        o.slot = -1
    end
    if parent >= 0:
        mut ps := _sc.Ref(parent)
        ps.kids.Push(id)
    else:
        _sc_root = id
    end
    saved := _sc_match
    if old >= 0:
        _sc_match = _sc[old].kids
    else:
        _sc_match = Vector {} as Vector<int>
    end
    _sc_cur = id
    saved_lv := _lv
    _lv = _lv_fresh()
    fn(Builder {})
    _lv_free()
    _lv = saved_lv
    _sc_cur = parent
    if old < 0:
        _sc_match.Free()
    end
    _sc_match = saved
    mut sc2 := _sc.Ref(id)
    sc2.count = _bd.nodes[d].kids.Len() - start
end

func _sc_memo(key: str): bool:
    if _sc_cur < 0:
        ret false
    end
    mut s := _sc.Ref(_sc_cur)
    if s.memo_set and _sc_cur == _sc_rerun_id and str.Equals(s.memo, key):
        _sc_skipped = true
        _sc_skips++
        ret true
    end
    if s.memo_set:
        _sfree(s.memo)
    end
    s.memo = str.Clone(key)
    s.memo_set = true
    ret false
end

func _sc_instance(comp: int): int:
    if _sc_cur < 0:
        ret 0
    end
    mut s := _sc.Ref(_sc_cur)
    if s.slot < 0:
        s.comp = comp
        s.slot = _sc_slot_alloc(comp)
        s.fresh = true
    else:
        s.fresh = false
    end
    ret s.slot
end

func _sc_is_fresh(): bool:
    if _sc_cur < 0:
        ret true
    end
    ret _sc[_sc_cur].fresh
end

func _sc_register(words: int, take: func (int) i64, sites: func ()):
    if _sc_on:
        ret
    end
    _sc_on = true
    _sc_words = words
    _sc_take = take
    sites()
end

func _sc_set_site(site: int, comp: int, word: int, mask: i64):
    if site < 0 or word < 0 or word >= _sc_words:
        ret
    end
    until _sc_site_comp.Len() <= site:
        _sc_site_comp.Push(-1)
        repeat _sc_words:
            _sc_site_mask.Push(0 as i64)
        end
    end
    _sc_site_comp[site] = comp
    i := site * _sc_words + word
    _sc_site_mask[i] |= mask
end

func _sc_build_root(view: func (Builder)):
    old_root := _sc_root
    _sc_match.Free()
    _sc_match = Vector {} as Vector<int>
    if old_root >= 0:
        _sc_match.Push(old_root)
    end
    _sc_root = -1
    _sc_cur = -1
    _lv_free()
    _lv = _lv_fresh()
    _sc_open(0, "", view)
    if _sc_on:
        repeat _sc_words in w:
            _x := _sc_take(w)
        end
    end
    _sc_match.Free()
    _sc_match = Vector {} as Vector<int>
    if old_root >= 0:
        _sc_release(old_root)
    end
    _sc_dead = 0
end

func _sc_in_subtree(node: int, d: int, tops: Vector<int>): bool:
    mut n := node
    mut guard := 0
    until n >= 0 and guard < 100000:
        guard++
        p := _e.dom.nodes[n].parent
        if p == d:
            each t in tops:
                if t == n:
                    ret true
                end
            end
            ret false
        end
        n = p
    end
    ret false
end

func _sc_same_list(a: Vector<str>, b: Vector<str>): bool:
    if a.Len() != b.Len():
        ret false
    end
    repeat a.Len() in i:
        if a[i] != b[i]:
            ret false
        end
    end
    ret true
end

func _sc_same_ints(a: Vector<int>, b: Vector<int>): bool:
    if a.Len() != b.Len():
        ret false
    end
    repeat a.Len() in i:
        if a[i] != b[i]:
            ret false
        end
    end
    ret true
end

func _sc_same_shape(o: int, n: int): bool:
    old_nd := _e.dom.nodes[o]
    new_nd := _e.dom.nodes[n]
    if old_nd.kind != new_nd.kind or old_nd.kids.Len() != new_nd.kids.Len():
        ret false
    end
    if _attr(_e.dom, o, "key") != _attr(_e.dom, n, "key"):
        ret false
    end
    repeat old_nd.kids.Len() in i:
        if not _sc_same_shape(old_nd.kids[i], new_nd.kids[i]):
            ret false
        end
    end
    ret true
end

func _sc_same_dvals(a: _Node, b: _Node): bool:
    if a.dval.Len() != b.dval.Len() or a.dprop.Len() != a.dval.Len() or
        b.dprop.Len() != b.dval.Len() or a.dst.Len() != a.dval.Len() or b.dst.Len() != b.dval.Len():
        ret false
    end
    repeat a.dval.Len() in i:
        if a.dprop.Len() <= i or b.dprop.Len() <= i:
            ret false
        end
        if a.dprop[i] != b.dprop[i] or a.dst[i] != b.dst[i]:
            ret false
        end
        fa := style.Format(a.dprop[i], a.dval[i])
        fb := style.Format(b.dprop[i], b.dval[i])
        if str.Len(fa) == 0 or str.Len(fb) == 0 or fa != fb:
            ret false
        end
    end
    ret true
end

func _sc_drop_typed_value(o: int, n: int):
    k := _e.dom.nodes[o].k
    if (k == _K_DETAILS or k == _K_DIALOG) and _has_attr(
        _e.dom, o, "open"
    ) != _has_attr(_e.dom, n, "open"):
        mut dc := _e.ctl.Ref(o)
        dc.has_open = false
        _e.dirty_dom = true
    end
    if k != _K_INPUT and k != _K_TEXTAREA:
        ret
    end
    ov := k == _K_TEXTAREA ? _text_of(_e.dom, o) : str.Clone(_attr(_e.dom, o, "value"))
    nv := k == _K_TEXTAREA ? _text_of(_e.dom, n) : str.Clone(_attr(_e.dom, n, "value"))
    mut c := _e.ctl.Ref(o)
    echo := c.has_value and c.value == nv
    if ov != nv and not echo:
        c.has_value = false
        c.caret = nv.Len()
        c.anchor = c.caret
        c.text_scroll = 0.0
    end
    if k == _K_INPUT and _has_attr(_e.dom, o, "checked") != _has_attr(_e.dom, n, "checked"):
        c.has_checked = false
    end
    _sfree(ov)
    _sfree(nv)
end

func _sc_patch(o: int, n: int, map &: Vector<int>, nbefore: int):
    map[n - nbefore] = o
    _sc_drop_typed_value(o, n)
    old_nd := _e.dom.nodes[o]
    new_nd := _e.dom.nodes[n]
    if old_nd.text != new_nd.text:
        mut a := _e.dom.nodes.Ref(o)
        mut b := _e.dom.nodes.Ref(n)
        t := a.text
        a.text = b.text
        b.text = t
        _sc_text_nodes.Push(o)
    end
    same := _sc_same_list(old_nd.names, new_nd.names) and _sc_same_list(
        old_nd.values, new_nd.values
    ) and old_nd.smask == new_nd.smask and _sc_same_ints(
        old_nd.pst, new_nd.pst
    ) and _sc_same_ints(
        old_nd.pid, new_nd.pid
    ) and _sc_same_ints(old_nd.dst, new_nd.dst) and _sc_same_ints(
        old_nd.dprop, new_nd.dprop
    ) and _sc_same_dvals(old_nd, new_nd)
    if not same:
        mut a2 := _e.dom.nodes.Ref(o)
        mut b2 := _e.dom.nodes.Ref(n)
        tn := a2.names
        a2.names = b2.names
        b2.names = tn
        tv := a2.values
        a2.values = b2.values
        b2.values = tv
        tp := a2.pst
        a2.pst = b2.pst
        b2.pst = tp
        tpi := a2.pid
        a2.pid = b2.pid
        b2.pid = tpi
        td := a2.dst
        a2.dst = b2.dst
        b2.dst = td
        tdp := a2.dprop
        a2.dprop = b2.dprop
        b2.dprop = tdp
        tdv := a2.dval
        a2.dval = b2.dval
        b2.dval = tdv
        a2.smask = b2.smask
        _sc_el_changed.Push(o)
    end
    repeat old_nd.kids.Len() in i:
        _sc_patch(old_nd.kids[i], new_nd.kids[i], map, nbefore)
    end
end

func _sc_free_node(i: int):
    mut nd := _e.dom.nodes.Ref(i)
    _sfree(nd.text)
    each s in nd.names:
        _sfree(s)
    end
    each s in nd.values:
        _sfree(s)
    end
    nd.names.Free()
    nd.values.Free()
    nd.kids.Free()
    nd.pst.Free()
    nd.pid.Free()
    nd.dst.Free()
    nd.dprop.Free()
    nd.dval.Free()
end

func _sc_top_marks(tops: Vector<int>): Vector<bool>:
    mut marks := Vector {} as Vector<bool>
    mut mx := -1
    each t0 in tops:
        if t0 > mx:
            mx = t0
        end
    end
    repeat mx + 1:
        marks.Push(false)
    end
    each t in tops:
        if t >= 0 and t < marks.Len():
            marks[t] = true
        end
    end
    ret marks
end

func _sc_in_marked(node: int, d: int, marks: Vector<bool>): bool:
    mut n := node
    mut guard := 0
    until n >= 0 and guard < 100000:
        guard++
        p := _e.dom.nodes[n].parent
        if p == d:
            ret n < marks.Len() and marks[n]
        end
        n = p
    end
    ret false
end

func _sc_ev_link(k: int):
    node := _e.dom.ev_node[k]
    if node < 0:
        ret
    end
    until _sc_ev_head.Len() <= node:
        _sc_ev_head.Push(-1)
    end
    until _sc_ev_next.Len() <= k:
        _sc_ev_next.Push(-1)
    end
    _sc_ev_next[k] = _sc_ev_head[node]
    _sc_ev_head[node] = k
end

func _sc_ev_build():
    _sc_ev_head.Clear()
    _sc_ev_next.Clear()
    repeat _e.dom.nodes.Len():
        _sc_ev_head.Push(-1)
    end
    repeat _e.dom.ev_node.Len():
        _sc_ev_next.Push(-1)
    end
    repeat _e.dom.ev_node.Len() in k:
        _sc_ev_link(k)
    end
    _sc_ev_built = true
end

func _sc_ev_kill_tree(n: int, before: int):
    if n >= 0 and n < _sc_ev_head.Len():
        mut k := _sc_ev_head[n]
        until k >= 0:
            if k < before and _e.dom.ev_node[k] == n:
                _e.dom.ev_node[k] = -2
                _sc_ev_dead++
            end
            k = _sc_ev_next[k]
        end
    end
    each c in _e.dom.nodes[n].kids:
        _sc_ev_kill_tree(c, before)
    end
end

func _sc_ev_compact():
    if _sc_ev_dead > 0:
        mut w := 0
        n := _e.dom.ev_node.Len()
        repeat n in i:
            node := _e.dom.ev_node[i]
            if node == -2:
                _sfree(_e.dom.ev_kind[i])
                continue
            end
            if w != i:
                _e.dom.ev_node[w] = node
                _e.dom.ev_kind[w] = _e.dom.ev_kind[i]
                _e.dom.ev_fn[w] = _e.dom.ev_fn[i]
            end
            w++
        end
        repeat n - w:
            _a := _e.dom.ev_node.Pop()
            _b := _e.dom.ev_kind.Pop()
            _c := _e.dom.ev_fn.Pop()
        end
        _sc_ev_dead = 0
    end
    _sc_ev_built = false
end

func _sc_drop_events(before: int, _d: int, tops: Vector<int>):
    if not _sc_ev_built:
        _sc_ev_build()
    end
    each t in tops:
        _sc_ev_kill_tree(t, before)
    end
end

func _sc_ev_index_new(from: int):
    if not _sc_ev_built:
        ret
    end
    repeat _e.dom.ev_node.Len() - from in i:
        _sc_ev_link(from + i)
    end
end

func _sc_subtree_size(n: int): int:
    mut c := 1
    each k in _e.dom.nodes[n].kids:
        c += _sc_subtree_size(k)
    end
    ret c
end

func _sc_remap_uid(node: int, d: int, tops: Vector<int>, from: int): int:
    if node < 0 or node >= from or not _sc_in_subtree(node, d, tops):
        ret node
    end
    uid := _e.ctl[node].uid
    repeat _e.ctl.Len() - from in i:
        if _e.ctl[from + i].uid == uid:
            ret from + i
        end
    end
    ret -1
end

func _sc_match_tops(olds: Vector<int>, news: Vector<int>):
    mut used := Vector {} as Vector<bool>
    defer used.Free()
    mut by_key := HashMap {} as HashMap<str, int>
    defer by_key.Free()
    mut seen_kind := HashMap {} as HashMap<str, int>
    defer seen_kind.Free()
    repeat olds.Len() in j:
        used.Push(false)
        o := olds[j]
        t := _e.dom.nodes[o].kind
        oid := _attr(_e.dom, o, "id")
        okey := _attr(_e.dom, o, "key")
        if oid.Len() > 0 or okey.Len() > 0:
            if oid.Len() > 0 and not by_key.Has(t + "|i" + oid):
                by_key.Put(t + "|i" + oid, j)
            end
            if okey.Len() > 0 and not by_key.Has(t + "|k" + okey):
                by_key.Put(t + "|k" + okey, j)
            end
        else:
            nth := seen_kind.Has(t) ? seen_kind.Get(t) : 0
            seen_kind.Put(t, nth + 1)
            by_key.Put(t + "|n" + nth, j)
        end
    end
    mut counts := HashMap {} as HashMap<str, int>
    defer counts.Free()
    each k in news:
        t := _e.dom.nodes[k].kind
        if t == "#text":
            continue
        end
        id := _attr(_e.dom, k, "id")
        key := _attr(_e.dom, k, "key")
        mut j := -1
        if id.Len() > 0 or key.Len() > 0:
            mut ji := -1
            mut jk := -1
            if id.Len() > 0 and by_key.Has(t + "|i" + id):
                ji = by_key.Get(t + "|i" + id)
            end
            if key.Len() > 0 and by_key.Has(t + "|k" + key):
                jk = by_key.Get(t + "|k" + key)
            end
            if ji >= 0 and used[ji]:
                ji = -2
            end
            if jk >= 0 and used[jk]:
                jk = -2
            end
            if ji == -2 or jk == -2:
                j = _match_kid(_e.dom, olds, used, _e.dom, k, 0)
            else ji >= 0 and (jk < 0 or ji < jk):
                j = ji
            else:
                j = jk
            end
        else:
            nth := counts.Has(t) ? counts.Get(t) : 0
            counts.Put(t, nth + 1)
            if by_key.Has(t + "|n" + nth):
                j = by_key.Get(t + "|n" + nth)
                if used[j]:
                    j = -1
                end
            end
        end
        if j >= 0:
            used[j] = true
            mut nc := _e.ctl
            _rec_match(_e.dom, _e.ctl, olds[j], _e.dom, nc, k)
            _e.ctl = nc
        end
    end
end

func _sc_top_key(n: int): str:
    k := _attr(_e.dom, n, "key")
    if k.Len() > 0:
        ret _e.dom.nodes[n].kind + "|k" + k
    end
    i := _attr(_e.dom, n, "id")
    if i.Len() > 0:
        ret _e.dom.nodes[n].kind + "|i" + i
    end
    ret ""
end

func _sc_style_new(n: int):
    _compute(n)
    each k in _e.dom.nodes[n].kids:
        _sc_style_new(k)
    end
end

func _sc_try_keyed(
    id: int, d: int, pos: int, olds: Vector<int>, news: Vector<int>, nbefore: int, evbefore: int
): bool:
    if not _e.has_tree or d >= _e.fid.Len() or news.Len() == 0:
        ret false
    end
    if _sc_dead > 2 * (_e.dom.nodes.Len() - _sc_dead) + 512:
        ret false
    end
    dfid := _e.fid[d]
    if dfid < 0:
        ret false
    end
    dk := _e.dom.nodes[d].kids
    repeat dk.Len() - news.Len() in pk:
        kn := dk[pk]
        if kn >= _e.fid.Len() or _e.fid[kn] < 0 or _e.tree.Parent(_e.fid[kn]) != dfid:
            ret false
        end
    end
    mut keys := HashMap {} as HashMap<str, int>
    defer keys.Free()
    repeat olds.Len() in j:
        o := olds[j]
        if o >= _e.fid.Len() or _e.fid[o] < 0 or _e.tree.Parent(_e.fid[o]) != dfid:
            ret false
        end
        k := _sc_top_key(o)
        if k.Len() == 0 or keys.Has(k):
            ret false
        end
        keys.Put(k, j)
    end
    mut pair := Vector {} as Vector<int>
    defer pair.Free()
    mut used := Vector {} as Vector<bool>
    defer used.Free()
    repeat olds.Len():
        used.Push(false)
    end
    mut seen := HashMap {} as HashMap<str, int>
    defer seen.Free()
    mut kinds := HashMap {} as HashMap<str, int>
    defer kinds.Free()
    each ko in olds:
        kinds.Put(_e.dom.nodes[ko].kind, 1)
    end
    mut fresh := 0
    each nw in news:
        if _e.dom.nodes[nw].k == _K_TEXT or _e.dom.nodes[nw].k == _K_BR:
            ret false
        end
        k := _sc_top_key(nw)
        if k.Len() == 0 or seen.Has(k):
            ret false
        end
        seen.Put(k, 1)
        mut j := -1
        if keys.Has(k):
            j = keys.Get(k)
            if used[j] or not _sc_same_shape(olds[j], nw):
                ret false
            end
        end
        if j >= 0:
            used[j] = true
        else:
            if not kinds.Has(_e.dom.nodes[nw].kind):
                ret false
            end
            fresh++
        end
        pair.Push(j)
    end
    newcount := news.Len()
    oldcount := olds.Len()
    mut map := Vector {} as Vector<int>
    defer map.Free()
    repeat _e.dom.nodes.Len() - nbefore:
        map.Push(-1)
    end
    repeat newcount in i:
        if pair[i] >= 0:
            _sc_patch(olds[pair[i]], news[i], map, nbefore)
        end
    end
    _sc_drop_events(evbefore, d, olds)
    repeat _e.dom.ev_node.Len() - evbefore in k2:
        en := _e.dom.ev_node[evbefore + k2]
        if en >= nbefore and map[en - nbefore] >= 0:
            _e.dom.ev_node[evbefore + k2] = map[en - nbefore]
        end
    end
    _sc_ev_index_new(evbefore)
    each q in _sc_made:
        if _sc[q].alive and _sc[q].dnode >= nbefore and map[_sc[q].dnode - nbefore] >= 0:
            mut sq := _sc.Ref(q)
            sq.dnode = map[sq.dnode - nbefore]
        end
    end
    mut gone := Vector {} as Vector<int>
    defer gone.Free()
    repeat oldcount in j2:
        if not used[j2]:
            gone.Push(olds[j2])
        end
    end
    if gone.Len() > 0:
        mut gm := _sc_top_marks(gone)
        defer gm.Free()
        _e.focus = _sc_in_marked(_e.focus, d, gm) ? -1 : _e.focus
        _e.hover = _sc_in_marked(_e.hover, d, gm) ? -1 : _e.hover
        _e.popup = _sc_in_marked(_e.popup, d, gm) ? -1 : _e.popup
        _e.capture = _sc_in_marked(_e.capture, d, gm) ? -1 : _e.capture
        _e.active = _sc_in_marked(_e.active, d, gm) ? -1 : _e.active
        _e.last_click = _sc_in_marked(_e.last_click, d, gm) ? -1 : _e.last_click
    end
    mut order := Vector {} as Vector<int>
    defer order.Free()
    repeat newcount in i5:
        order.Push(pair[i5] >= 0 ? olds[pair[i5]] : news[i5])
    end
    mut dn := _e.dom.nodes.Ref(d)
    repeat newcount:
        _x := dn.kids.Pop()
    end
    mut nk := Vector {} as Vector<int>
    repeat pos in i2:
        nk.Push(dn.kids[i2])
    end
    each ordn in order:
        nk.Push(ordn)
    end
    repeat dn.kids.Len() - pos - oldcount in i3:
        nk.Push(dn.kids[pos + oldcount + i3])
    end
    dn.kids.Free()
    dn.kids = nk
    if fresh == 0:
        repeat _e.dom.nodes.Len() - nbefore in r:
            _sc_free_node(nbefore + r)
        end
        until _e.dom.nodes.Len() > nbefore:
            _y := _e.dom.nodes.Pop()
        end
    else:
        repeat _e.dom.nodes.Len() - nbefore in r2:
            if map[r2] >= 0:
                _sc_dead++
            end
        end
        repeat _e.dom.nodes.Len() - _e.ctl.Len():
            _e.ctl.Push(_new_ctl())
        end
        repeat _e.dom.nodes.Len() - _e.cs.Len():
            _e.cs.Push(style.Style {})
            _e.us.Push(_Used {})
        end
        repeat _e.dom.nodes.Len() - _e.fid.Len():
            _e.fid.Push(-1)
            _e.node_run.Push(-1)
            _e.in_run.Push(-1)
        end
        repeat newcount in i6:
            if pair[i6] < 0:
                _sc_style_new(news[i6])
                _build_node(news[i6], dfid)
            end
        end
    end
    each g in gone:
        _sc_dead += _sc_subtree_size(g)
        _e.tree.Remove(_e.fid[g])
        _e.fid[g] = -1
    end
    repeat newcount in i4:
        want := _e.fid[order[i4]]
        if _e.tree.Child(dfid, pos + i4) != want:
            _e.tree.Move(want, dfid, pos + i4)
        end
    end
    delta := newcount - oldcount
    if delta != 0 or _sc_made.Len() > 0:
        _pos_gen++
    end
    mut sc := _sc.Ref(id)
    sc.count = newcount
    mut a := _sc[id].parent
    until a >= 0 and _sc[a].dnode == d:
        mut sa := _sc.Ref(a)
        sa.count += delta
        a = sa.parent
    end
    _e.dirty_layout = true
    _e.full = true
    ret true
end

func _sc_rerun(id: int):
    d := _sc[id].dnode
    pos := _sc_pos(id)
    oldcount := _sc[id].count
    mut olds := Vector {} as Vector<int>
    defer olds.Free()
    dk := _e.dom.nodes[d].kids
    repeat oldcount in i:
        if pos + i < dk.Len():
            olds.Push(dk[pos + i])
        end
    end
    oldkids := _sc[id].kids
    oldbstart := _sc[id].bstart
    mut s0 := _sc.Ref(id)
    s0.kids = Vector {} as Vector<int>
    s0.dirty = false
    nbefore := _e.dom.nodes.Len()
    evbefore := _e.dom.ev_node.Len()
    _bd = _e.dom
    _bstack.Clear()
    _bstack.Push(d)
    start := _bd.nodes[d].kids.Len()
    mut s1 := _sc.Ref(id)
    s1.bstart = start
    _sc_match = oldkids
    _sc_cur = id
    fn := _sc[id].fn
    _sc_made.Clear()
    _sc_tracking = true
    saved_lv := _lv
    _lv = _lv_fresh()
    _sc_rerun_id = id
    _sc_skipped = false
    fn(Builder {})
    _sc_rerun_id = -1
    _lv_free()
    _lv = saved_lv
    _sc_tracking = false
    _sc_cur = -1
    _sc_built += _bd.nodes.Len() - nbefore
    _sc_match = Vector {} as Vector<int>
    _e.dom = _bd
    _bd = _Dom {}
    _bstack.Clear()
    if _sc_skipped and _e.dom.nodes.Len() == nbefore and _e.dom.nodes[d].kids.Len() == start:
        _sc_skipped = false
        mut sk := _sc.Ref(id)
        sk.kids.Free()
        sk.kids = oldkids
        sk.bstart = oldbstart
        ret
    end
    _sc_skipped = false
    newcount := _e.dom.nodes[d].kids.Len() - start
    mut news := Vector {} as Vector<int>
    defer news.Free()
    repeat newcount in i:
        news.Push(_e.dom.nodes[d].kids[start + i])
    end
    mut same := newcount == olds.Len()
    if same:
        repeat newcount in i:
            if same and not _sc_same_shape(olds[i], news[i]):
                same = false
            end
        end
    end
    if same:
        mut map := Vector {} as Vector<int>
        defer map.Free()
        repeat _e.dom.nodes.Len() - nbefore:
            map.Push(-1)
        end
        repeat newcount in i:
            _sc_patch(olds[i], news[i], map, nbefore)
        end
        _sc_drop_events(evbefore, d, olds)
        repeat _e.dom.ev_node.Len() - evbefore in k:
            en := _e.dom.ev_node[evbefore + k]
            if en >= nbefore and map[en - nbefore] >= 0:
                _e.dom.ev_node[evbefore + k] = map[en - nbefore]
            end
        end
        _sc_ev_index_new(evbefore)
        each q in _sc_made:
            if _sc[q].alive and _sc[q].dnode >= nbefore:
                mut sq := _sc.Ref(q)
                sq.dnode = map[sq.dnode - nbefore]
            end
        end
        mut dn := _e.dom.nodes.Ref(d)
        repeat newcount:
            _x := dn.kids.Pop()
        end
        repeat _e.dom.nodes.Len() - nbefore in r:
            _sc_free_node(nbefore + r)
        end
        until _e.dom.nodes.Len() > nbefore:
            _y := _e.dom.nodes.Pop()
        end
    else not _sc_try_keyed(id, d, pos, olds, news, nbefore, evbefore):
        mut dn2 := _e.dom.nodes.Ref(d)
        repeat newcount:
            _x2 := dn2.kids.Pop()
        end
        mut nk := Vector {} as Vector<int>
        repeat pos in i:
            nk.Push(dn2.kids[i])
        end
        each nw in news:
            nk.Push(nw)
        end
        repeat dn2.kids.Len() - pos - olds.Len() in i:
            nk.Push(dn2.kids[pos + olds.Len() + i])
        end
        dn2.kids.Free()
        dn2.kids = nk
        delta := newcount - oldcount
        if delta != 0 or _sc_made.Len() > 0:
            _pos_gen++
        end
        mut sc := _sc.Ref(id)
        sc.count = newcount
        mut a := _sc[id].parent
        until a >= 0 and _sc[a].dnode == d:
            mut sa := _sc.Ref(a)
            sa.count += delta
            a = sa.parent
        end
        repeat _e.dom.nodes.Len() - _e.ctl.Len():
            _e.ctl.Push(_new_ctl())
        end
        _sc_match_tops(olds, news)
        repeat _e.ctl.Len() - nbefore in i:
            if _e.ctl[nbefore + i].uid == 0:
                _e.ctl[nbefore + i] = _new_ctl()
            end
        end
        _e.focus = _sc_remap_uid(_e.focus, d, olds, nbefore)
        _e.hover = _sc_remap_uid(_e.hover, d, olds, nbefore)
        _e.popup = _sc_remap_uid(_e.popup, d, olds, nbefore)
        _e.capture = _sc_remap_uid(_e.capture, d, olds, nbefore)
        _e.active = _sc_remap_uid(_e.active, d, olds, nbefore)
        _e.last_click = _sc_remap_uid(_e.last_click, d, olds, nbefore)
        _sc_drop_events(evbefore, d, olds)
        _sc_ev_index_new(evbefore)
        each o in olds:
            _sc_dead += _sc_subtree_size(o)
        end
        _e.dirty_dom = true
    end
    each k in oldkids:
        _sc_release(k)
    end
    mut ok := oldkids
    ok.Free()
    _sc_runs++
end

func _sc_owner_slot(id: int, comp: int): int:
    mut p := id
    mut guard := 0
    until p >= 0 and guard < 100000:
        guard++
        if _sc[p].comp == comp and _sc[p].slot >= 0:
            ret _sc[p].slot
        end
        p = _sc[p].parent
    end
    ret -1
end

func _sc_depth(id: int): int:
    mut n := 0
    mut p := _sc[id].parent
    until p >= 0:
        n++
        p = _sc[p].parent
    end
    ret n
end

func _sc_fast_text(): bool:
    ret false
end

func _sc_trace(): bool:
    if _sc_trace_state == 0:
        _sc_trace_state = 1
        if os.Env("SALAM_UI_TRACE").Len() > 0:
            _sc_trace_state = 2
        end
    end
    ret _sc_trace_state == 2
end

func _sc_full():
    _sc_ev_compact()
    if _sc_trace():
        printerrln "ui trace: full re-run"
    end
    _sc_invalid = false
    _sc_runs++
    _load_dom(_build_view())
end

func _sc_update():
    _pos_gen++
    mut any := false
    _sc_touched.Clear()
    repeat _sc_words in w:
        t := _sc_take(w)
        _sc_touched.Push(t)
        if t != 0:
            any = true
        end
    end
    if _sc_invalid:
        _sc_full()
        ret
    end
    if not any and _sc_touch_comp.Len() == 0:
        ret
    end
    repeat _sc_touch_comp.Len() in dk:
        repeat _sc_dv_comp.Len() in dj:
            if _sc_dv_comp[dj] == _sc_touch_comp[dk]:
                dfn := _sc_dv_fn[dj]
                _sc_touch_mask[dk] = dfn(_sc_touch_slot[dk], _sc_touch_mask[dk])
            end
        end
    end
    mut dirty := Vector {} as Vector<int>
    defer dirty.Free()
    mut why := Vector {} as Vector<str>
    defer why.Free()
    repeat _sc.Len() in i:
        s := _sc[i]
        if not s.alive:
            continue
        end
        mut hit := false
        mut reason := ""
        if s.site >= 0 and s.site < _sc_site_comp.Len() and any:
            repeat _sc_words in w:
                m := _sc_site_mask[s.site * _sc_words + w] & _sc_touched[w]
                if m != 0:
                    hit = true
                    reason = "global word " + w + " bits " + (m as int)
                end
            end
        end
        if not hit and s.slot >= 0:
            repeat _sc_touch_comp.Len() in k:
                if _sc_touch_mask[k] == -1 and _sc_touch_comp[k] == s.comp and
                    _sc_touch_slot[k] == s.slot:
                    hit = true
                    reason = "instance state"
                end
            end
        end
        if not hit and s.site >= 0 and _sc_touch_comp.Len() > 0:
            repeat _sc_vs_site.Len() in v:
                if hit or _sc_vs_site[v] != s.site:
                    continue
                end
                oslot := _sc_owner_slot(i, _sc_vs_comp[v])
                if oslot < 0:
                    continue
                end
                repeat _sc_touch_comp.Len() in k:
                    if _sc_touch_comp[k] == _sc_vs_comp[v] and _sc_touch_slot[k] == oslot and
                        (_sc_touch_mask[k] & _sc_vs_mask[v]) != 0:
                        hit = true
                        reason = "instance variable"
                    end
                end
            end
        end
        if hit:
            dirty.Push(i)
            why.Push(reason)
            mut sd := _sc.Ref(i)
            sd.dirty = true
        end
    end
    _sc_touch_comp.Clear()
    _sc_touch_slot.Clear()
    _sc_touch_mask.Clear()
    if dirty.Len() == 0:
        ret
    end
    mut depth := Vector {} as Vector<int>
    defer depth.Free()
    mut maxd := 0
    each di in dirty:
        dv := _sc_depth(di)
        depth.Push(dv)
        if dv > maxd:
            maxd = dv
        end
    end
    _sc_text_nodes.Clear()
    _sc_el_changed.Clear()
    repeat maxd + 1 in level:
        repeat dirty.Len() in j:
            if depth[j] == level and _sc[dirty[j]].alive and _sc[dirty[j]].dirty:
                if _sc_trace():
                    printerrln "ui trace: run scope " + dirty[j] + " site " + _sc[dirty[j]].site +
                        " comp " + _sc[dirty[j]].comp + " slot " + _sc[dirty[j]].slot +
                        " because " + why[j]
                end
                _sc_rerun(dirty[j])
            end
        end
    end
    _sc_ev_compact()
    if _e.dirty_dom:
        if _sc_dead > 2 * (_e.dom.nodes.Len() - _sc_dead) + 512:
            _e.dirty_dom = false
            _sc_full()
        end
        ret
    end
    each node in _sc_el_changed:
        _restyle(node)
        _e.dirty_layout = true
    end
    if _sc_text_nodes.Len() > 0:
        each node in _sc_text_nodes:
            _sync_flow(node)
            p := _e.dom.nodes[node].parent
            _damage_node(p >= 0 ? p : node)
        end
        _e.dirty_layout = true
    end
end

func _sc_active(): bool:
    ret _sc_on
end

@en "ScopeSite"
@fa "جایگاه دامنه"
pub func ScopeSite(site: int, comp: int, word: int, mask: i64):
    _sc_set_site(site, comp, word, mask)
end

@en "TouchInstance"
@fa "لمس نمونه"
pub func TouchInstance(comp: int, slot: int):
    if _sc_cur >= 0:
        ret
    end
    _sc_touch_comp.Push(comp)
    _sc_touch_slot.Push(slot)
    _sc_touch_mask.Push(-1)
    _e.dirty_view = true
    window.Wake()
end

@en "TouchInstanceVars"
@fa "لمس متغیرهای نمونه"
pub func TouchInstanceVars(comp: int, slot: int, mask: int):
    if _sc_trace():
        printerrln "ui trace: touch comp " + comp + " slot " + slot + " mask " + mask +
            (_sc_cur >= 0 ? " ignored while rendering" : "")
    end
    if _sc_cur >= 0:
        ret
    end
    _sc_touch_comp.Push(comp)
    _sc_touch_slot.Push(slot)
    _sc_touch_mask.Push(mask)
    _e.dirty_view = true
    window.Wake()
end

@en "ScopeDerive"
@fa "اشتقاق دامنه"
pub func ScopeDerive(comp: int, derive: func (int, int) int):
    _sc_dv_comp.Push(comp)
    _sc_dv_fn.Push(derive)
end

@en "ScopeVars"
@fa "متغیرهای دامنه"
pub func ScopeVars(site: int, comp: int, mask: int):
    _sc_vs_site.Push(site)
    _sc_vs_comp.Push(comp)
    _sc_vs_mask.Push(mask)
end

@en "Invalidate"
@fa "بی اعتبار سازی"
pub func Invalidate():
    if _web_live():
        _web_invalidate()
        ret
    end
    _sc_invalid = true
    _e.dirty_view = true
    window.Wake()
end

@en "ScopeNodes"
@fa "شمار گره های دامنه"
pub func ScopeNodes(): int:
    if _web_native_only("ScopeNodes"):
        ret 0
    end
    ret _sc_built
end

@en "ScopeRuns"
@fa "شمار اجرای دامنه"
pub func ScopeRuns(): int:
    if _web_live():
        ret _web_runs()
    end
    ret _sc_runs
end

@en "ScopeSkips"
@fa "دامنه های ردشده"
pub func ScopeSkips(): int:
    if _web_native_only("ScopeSkips"):
        ret 0
    end
    ret _sc_skips
end
