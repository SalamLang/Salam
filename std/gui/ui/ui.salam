@en "ui"
@fa "رابط کاربری"
package ui

import str
import gui.css
import gui.cssbox
import gui.paint
import gui.typeset
import gui.window

mut _e := _Engine {}
mut _handler_names := Vector {} as Vector<str>
mut _handler_fns := Vector {} as Vector<func ()>
mut _page_paths := Vector {} as Vector<str>
mut _page_views := Vector {} as Vector<func () str>
mut _event := Event {}
mut _fc := typeset.FontCollection {}
mut _fonts_ready := false
mut _fonts_added := 0
mut _gcache := typeset.GlyphCache {}
mut _gcache_ready := false
mut _img_keys := Vector {} as Vector<str>
mut _img_canvas := Vector {} as Vector<paint.Canvas>
mut _img_ok := Vector {} as Vector<bool>
mut _uid_next := 1
mut _opener_set := false
mut _opener := (_url: str): ret false end
mut _navigator_set := false
mut _navigator := (_url: str): ret false end
mut _opened_urls := Vector {} as Vector<str>
mut _clip_text := ""
mut _clip_owned := false
mut _bd := _Dom {}
mut _pc_map := HashMap {} as HashMap<str, int>
mut _pc_keys := Vector {} as Vector<str>
mut _pc_para := Vector {} as Vector<typeset.Paragraph>
mut _pc_lay := Vector {} as Vector<typeset.TextLayout>
mut _pc_layw := Vector {} as Vector<f64>
mut _pc_has_lay := Vector {} as Vector<bool>
mut _pc_taken := Vector {} as Vector<bool>
mut _bstack := Vector {} as Vector<int>

@en "Options"
@fa "گزینه‌ها"
pub struct Options:
    @en "width"
    @fa "پهنا"
    pub width: f64 = 1024.0
    @en "height"
    @fa "بلندی"
    pub height: f64 = 768.0
    @en "title"
    @fa "عنوان"
    pub title: str = ""
    @en "resizable"
    @fa "تغییر اندازه پذیر"
    pub resizable: bool = true
    @en "background"
    @fa "پس زمینه"
    pub background: str = ""
    @en "headless"
    @fa "بی سر"
    pub headless: bool = false
    @en "scale"
    @fa "مقیاس"
    pub scale: f64 = 0.0
    @en "script"
    @fa "گام های آزمایشی"
    pub script: str = ""
end

@en "Event"
@fa "رخداد"
pub struct Event:
    @en "kind"
    @fa "گونه رخداد"
    pub kind: str = ""
    @en "target"
    @fa "هدف"
    pub target: str = ""
    @en "x"
    @fa "ایکس"
    pub x: f64 = 0.0
    @en "y"
    @fa "ایگرگ"
    pub y: f64 = 0.0
    @en "button"
    @fa "دکمه موشی"
    pub button: int = 0
    @en "key"
    @fa "کلید"
    pub key: str = ""
    @en "text"
    @fa "متن"
    pub text: str = ""
    @en "value"
    @fa "مقدار"
    pub value: str = ""
    @en "checked"
    @fa "تیک خورده"
    pub checked: bool = false
    @en "modifiers"
    @fa "کلیدهای کمکی"
    pub modifiers: int = 0
    @en "delta_x"
    @fa "جابجایی افقی"
    pub delta_x: f64 = 0.0
    @en "delta_y"
    @fa "جابجایی عمودی"
    pub delta_y: f64 = 0.0
end

@en "Profile"
@fa "نمایه زمانی"
pub struct Profile:
    @en "parse_ms"
    @fa "زمان تجزیه"
    pub parse_ms: f64 = 0.0
    @en "style_ms"
    @fa "زمان سبک"
    pub style_ms: f64 = 0.0
    @en "layout_ms"
    @fa "زمان چیدمان"
    pub layout_ms: f64 = 0.0
    @en "paint_ms"
    @fa "زمان نقاشی"
    pub paint_ms: f64 = 0.0
    @en "elements"
    @fa "شمار عنصرها"
    pub elements: int = 0
end

struct _Ctl:
    pub uid: int = 0
    pub hovered: bool = false
    pub focused: bool = false
    pub focus_visible: bool = false
    pub pressed: bool = false
    pub scroll_x: f64 = 0.0
    pub scroll_y: f64 = 0.0
    pub has_value: bool = false
    pub value: str = ""
    pub value_attr: str = ""
    pub has_checked: bool = false
    pub checked: bool = false
    pub checked_attr: bool = false
    pub caret: int = 0
    pub anchor: int = 0
    pub preedit: str = ""
    pub open: bool = false
    pub open_init: bool = false
    pub selected: int = -1
    pub undo: Vector<str> = Vector {}
    pub text_scroll: f64 = 0.0
end

struct _Box:
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub shown: bool = false
    pub clip_x0: f64 = -1.0e9
    pub clip_y0: f64 = -1.0e9
    pub clip_x1: f64 = 1.0e9
    pub clip_y1: f64 = 1.0e9
end

struct _Ifc:
    pub owner: int = -1
    pub cb: int = -1
    pub control: bool = false
    pub fixed_w: f64 = 0.0
    pub fixed_h: f64 = 0.0
    pub next: int = -1
    pub pbw: f64 = 0.0
    pub spans: Vector<typeset.TextSpan> = Vector {}
    pub span_el: Vector<int> = Vector {}
    pub span_atom: Vector<int> = Vector {}
    pub atoms: Vector<int> = Vector {}
    pub para: typeset.Paragraph = typeset.Paragraph {}
    pub has_para: bool = false
    pub lay: typeset.TextLayout = typeset.TextLayout {}
    pub lay_w: f64 = -1.0
    pub has_lay: bool = false
    pub pstyle: typeset.ParagraphStyle = typeset.ParagraphStyle {}
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub marker: str = ""
    pub marker_el: int = -1
    pub ckey: str = ""
end

struct _Atom:
    pub node: int = -1
    pub ifc: int = -1
    pub span: int = -1
    pub mw: f64 = 0.0
    pub mh: f64 = 0.0
    pub baseline: f64 = 0.0
    pub ox: f64 = 0.0
    pub oy: f64 = 0.0
end

struct _Rec:
    pub uid: int = 0
    pub hash: i64 = 0
    pub x0: int = 0
    pub y0: int = 0
    pub x1: int = 0
    pub y1: int = 0
end

struct _Anim:
    pub node: int = -1
    pub uid: int = 0
    pub prop: int = 0
    pub start: i64 = 0
    pub duration: f64 = 0.0
    pub delay: f64 = 0.0
    pub timing: css.Timing = css.Timing {}
    pub from: css.Color = css.Color {}
    pub to: css.Color = css.Color {}
    pub from_f: f64 = 0.0
    pub to_f: f64 = 0.0
    pub done: bool = false
end

struct _Engine:
    pub ready: bool = false
    pub dom: _Dom = _Dom {}
    pub sheet: css.Sheet = css.Sheet {}
    pub has_sheet: bool = false
    pub els: Vector<css.Element> = Vector {}
    pub el_node: Vector<int> = Vector {}
    pub node_el: Vector<int> = Vector {}
    pub st: Vector<css.ComputedStyle> = Vector {}
    pub sid: Vector<int> = Vector {}
    pub env: css.Env = css.Env {}
    pub width: f64 = 1024.0
    pub height: f64 = 768.0
    pub scale: f64 = 1.0
    pub tree: cssbox.Tree = cssbox.Tree {}
    pub has_tree: bool = false
    pub node_cb: Vector<int> = Vector {}
    pub cb_node: Vector<int> = Vector {}
    pub cb_ifc: Vector<int> = Vector {}
    pub cb_rep: Vector<int> = Vector {}
    pub rep_w: Vector<f64> = Vector {}
    pub rep_h: Vector<f64> = Vector {}
    pub root_cb: int = -1
    pub ifcs: Vector<_Ifc> = Vector {}
    pub atoms: Vector<_Atom> = Vector {}
    pub node_atom: Vector<int> = Vector {}
    pub node_ifc: Vector<int> = Vector {}
    pub boxes: Vector<_Box> = Vector {}
    pub ctl: Vector<_Ctl> = Vector {}
    pub doc_h: f64 = 0.0
    pub doc_w: f64 = 0.0
    pub vscroll: f64 = 0.0
    pub canvas_bg: css.Color = css.Color { r = 255, g = 255, b = 255, a = 255 }
    pub bg_override: str = ""
    pub recs: Vector<_Rec> = Vector {}
    pub damage: paint.Region = paint.Region {}
    pub full: bool = true
    pub hover: int = -1
    pub focus: int = -1
    pub active: int = -1
    pub capture: int = -1
    pub popup: int = -1
    pub last_click: int = -1
    pub anims: Vector<_Anim> = Vector {}
    pub view_set: bool = false
    pub view: func () str = (): ret "" end
    pub compiled: bool = false
    pub cview: func (Builder) = (_b: Builder): _bd.nodes.clear() end
    pub prog: css.Program = css.Program {}
    pub win: window.Window = window.Window {}
    pub has_win: bool = false
    pub canvas: paint.Canvas = paint.Canvas {}
    pub has_canvas: bool = false
    pub frames: int = 0
    pub handlers_run: int = 0
    pub dirty_view: bool = false
    pub dirty_layout: bool = false
    pub dirty_style: bool = false
    pub mx: f64 = 0.0
    pub my: f64 = 0.0
    pub drag_sel: bool = false
    pub order: Vector<int> = Vector {}
    pub order_next: int = 0
    pub script_mode: bool = false
    pub quit: bool = false
    pub dirty_dom: bool = false
    pub last_damage_n: int = 0
    pub last_damage_area: int = 0
    pub timer_id: int = -1
    pub script: str = ""
end
