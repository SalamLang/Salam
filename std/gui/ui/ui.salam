@en "ui"
@fa "رابط کاربری"
package ui

import gui.flow
import gui.paint
import gui.style
import gui.typeset
import gui.window

@en "STATE_BASE"
@fa "حالت پایه"
pub const STATE_BASE := 0

@en "STATE_HOVER"
@fa "حالت شناور"
pub const STATE_HOVER := 1

@en "STATE_FOCUS"
@fa "حالت تمرکز"
pub const STATE_FOCUS := 2

@en "STATE_FOCUS_WITHIN"
@fa "حالت تمرکز درون"
pub const STATE_FOCUS_WITHIN := 3

@en "STATE_ACTIVE"
@fa "حالت فعال"
pub const STATE_ACTIVE := 4

@en "STATE_DISABLED"
@fa "حالت غیرفعال"
pub const STATE_DISABLED := 5

@en "STATE_CHECKED"
@fa "حالت تیک خورده"
pub const STATE_CHECKED := 6

@en "STATE_INVALID"
@fa "حالت نامعتبر"
pub const STATE_INVALID := 7

@en "STATE_PLACEHOLDER"
@fa "حالت جای نوشته"
pub const STATE_PLACEHOLDER := 8

@en "STATE_SELECTION"
@fa "حالت گزینش"
pub const STATE_SELECTION := 9

const _STATES := 10

const _K_TEXT := 0
const _K_BOX := 1
const _K_INLINE := 2
const _K_BR := 3
const _K_BUTTON := 4
const _K_INPUT := 5
const _K_TEXTAREA := 6
const _K_SELECT := 7
const _K_OPTION := 8
const _K_OPTGROUP := 9
const _K_LINK := 10
const _K_IMAGE := 11
const _K_LABEL := 12
const _K_SUMMARY := 13
const _K_DETAILS := 14
const _K_DIALOG := 15
const _K_FORM := 16
const _K_ITEM := 17
const _K_LIST := 18
const _K_OLIST := 19
const _K_PROGRESS := 20
const _K_METER := 21
const _K_PAGE := 22
const _K_MEDIA := 23
const _K_FIELDSET := 24
const _K_TABLE_ROW := 25

mut _e := _Engine {}
mut _bd := _Dom {}
mut _bstack := Vector {} as Vector<int>
mut _patches := Vector {} as Vector<Patch>
mut _event := Event {}
mut _fc := typeset.FontCollection {}
mut _fonts_ready := false
mut _fonts_added := 0
mut _gcache := typeset.GlyphCache {}
mut _gcache_ready := false
mut _img_keys := Vector {} as Vector<str>
mut _img_canvas := Vector {} as Vector<paint.Canvas>
mut _img_ok := Vector {} as Vector<bool>
mut _uid_next := 1
mut _opener_set := false
mut _opener := (_url: str): ret false end
mut _navigator_set := false
mut _navigator := (_url: str): ret false end
mut _opened_urls := Vector {} as Vector<str>
mut _clip_text := ""
mut _def_keys := HashMap {} as HashMap<str, int>
mut _def_styles := Vector {} as Vector<style.Style>

@en "Options"
@fa "گزینه‌ها"
pub struct Options:
    @en "width"
    @fa "پهنا"
    pub width: f64 = 1024.0
    @en "height"
    @fa "بلندی"
    pub height: f64 = 768.0
    @en "title"
    @fa "عنوان"
    pub title: str = ""
    @en "resizable"
    @fa "تغییر اندازه پذیر"
    pub resizable: bool = true
    @en "headless"
    @fa "بی سر"
    pub headless: bool = false
    @en "scale"
    @fa "مقیاس"
    pub scale: f64 = 0.0
    @en "script"
    @fa "گام های آزمایشی"
    pub script: str = ""
end

@en "Event"
@fa "رخداد"
pub struct Event:
    @en "kind"
    @fa "گونه رخداد"
    pub kind: str = ""
    @en "target"
    @fa "هدف"
    pub target: str = ""
    @en "x"
    @fa "ایکس"
    pub x: f64 = 0.0
    @en "y"
    @fa "ایگرگ"
    pub y: f64 = 0.0
    @en "button"
    @fa "دکمه موشی"
    pub button: int = 0
    @en "key"
    @fa "کلید"
    pub key: str = ""
    @en "text"
    @fa "متن"
    pub text: str = ""
    @en "value"
    @fa "مقدار"
    pub value: str = ""
    @en "checked"
    @fa "تیک خورده"
    pub checked: bool = false
    @en "modifiers"
    @fa "کلیدهای کمکی"
    pub modifiers: int = 0
    @en "delta_x"
    @fa "جابجایی افقی"
    pub delta_x: f64 = 0.0
    @en "delta_y"
    @fa "جابجایی عمودی"
    pub delta_y: f64 = 0.0
end

@en "Profile"
@fa "نمایه زمانی"
pub struct Profile:
    @en "build_ms"
    @fa "زمان ساخت"
    pub build_ms: f64 = 0.0
    @en "style_ms"
    @fa "زمان سبک"
    pub style_ms: f64 = 0.0
    @en "layout_ms"
    @fa "زمان چیدمان"
    pub layout_ms: f64 = 0.0
    @en "paint_ms"
    @fa "زمان نقاشی"
    pub paint_ms: f64 = 0.0
    @en "elements"
    @fa "شمار عنصرها"
    pub elements: int = 0
end

struct _Node:
    pub kind: str = ""
    pub k: int = 1
    pub inl: bool = false
    pub parent: int = -1
    pub kids: Vector<int> = Vector {}
    pub names: Vector<str> = Vector {}
    pub values: Vector<str> = Vector {}
    pub text: str = ""
    pub pst: Vector<int> = Vector {}
    pub pid: Vector<int> = Vector {}
    pub dst: Vector<int> = Vector {}
    pub dprop: Vector<int> = Vector {}
    pub dval: Vector<style.Value> = Vector {}
    pub smask: int = 0
end

struct _Dom:
    pub nodes: Vector<_Node> = Vector {}
    pub title: str = ""
    pub lang: str = ""
    pub dir: str = ""
    pub ev_node: Vector<int> = Vector {}
    pub ev_kind: Vector<str> = Vector {}
    pub ev_fn: Vector<func ()> = Vector {}
end

struct _Ctl:
    pub uid: int = 0
    pub hovered: bool = false
    pub focused: bool = false
    pub focus_visible: bool = false
    pub pressed: bool = false
    pub scroll_x: f64 = 0.0
    pub scroll_y: f64 = 0.0
    pub has_value: bool = false
    pub value: str = ""
    pub value_attr: str = ""
    pub has_checked: bool = false
    pub checked: bool = false
    pub caret: int = 0
    pub anchor: int = 0
    pub preedit: str = ""
    pub open: bool = false
    pub selected: int = -1
    pub undo: Vector<str> = Vector {}
    pub text_scroll: f64 = 0.0
    pub text_scroll_y: f64 = 0.0
    pub states: int = 0
end

struct _Box:
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub shown: bool = false
    pub clip_x0: f64 = -1.0e9
    pub clip_y0: f64 = -1.0e9
    pub clip_x1: f64 = 1.0e9
    pub clip_y1: f64 = 1.0e9
end

struct _Used:
    pub font: f64 = 16.0
    pub line: f64 = 24.0
    pub color: paint.Color = paint.Color {}
    pub outline_set: bool = false
    pub family: str = "sans-serif"
    pub ver: int = 0
    pub ihash: i64 = 0
    pub fhash: i64 = 0
    pub phash: i64 = 0
end

struct _Run:
    pub owner: int = -1
    pub first: int = -1
    pub fid: int = -1
    pub nodes: Vector<int> = Vector {}
    pub spans: Vector<typeset.TextSpan> = Vector {}
    pub span_el: Vector<int> = Vector {}
    pub pstyle: typeset.ParagraphStyle = typeset.ParagraphStyle {}
    pub para: typeset.Paragraph = typeset.Paragraph {}
    pub has_para: bool = false
    pub lay: typeset.TextLayout = typeset.TextLayout {}
    pub lay_w: f64 = -9.0
    pub has_lay: bool = false
    pub alt_lay: Vector<typeset.TextLayout> = Vector {}
    pub alt_w: Vector<f64> = Vector {}
    pub control: bool = false
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub ver: int = 0
    pub alive: bool = true
end

struct _Rec:
    pub uid: int = 0
    pub hash: i64 = 0
    pub x0: int = 0
    pub y0: int = 0
    pub x1: int = 0
    pub y1: int = 0
end

struct _Anim:
    pub node: int = -1
    pub uid: int = 0
    pub prop: int = 0
    pub start: i64 = 0
    pub duration: f64 = 0.0
    pub delay: f64 = 0.0
    pub ease: style.Easing = style.Easing {}
    pub from: style.Value = style.Value {}
    pub to: style.Value = style.Value {}
    pub done: bool = false
end

struct _Engine:
    pub ready: bool = false
    pub dom: _Dom = _Dom {}
    pub ctl: Vector<_Ctl> = Vector {}
    pub cs: Vector<style.Style> = Vector {}
    pub us: Vector<_Used> = Vector {}
    pub fid: Vector<int> = Vector {}
    pub flow_node: Vector<int> = Vector {}
    pub flow_run: Vector<int> = Vector {}
    pub node_run: Vector<int> = Vector {}
    pub in_run: Vector<int> = Vector {}
    pub runs: Vector<_Run> = Vector {}
    pub boxes: Vector<_Box> = Vector {}
    pub xf: Vector<paint.Transform> = Vector {}
    pub xf_on: Vector<bool> = Vector {}
    pub xf_any: bool = false
    pub tree: flow.Tree = flow.Tree {}
    pub has_tree: bool = false
    pub width: f64 = 1024.0
    pub height: f64 = 768.0
    pub scale: f64 = 1.0
    pub dark: bool = false
    pub root_font: f64 = 16.0
    pub recs: Vector<_Rec> = Vector {}
    pub damage: paint.Region = paint.Region {}
    pub full: bool = true
    pub hover: int = -1
    pub focus: int = -1
    pub active: int = -1
    pub capture: int = -1
    pub popup: int = -1
    pub last_click: int = -1
    pub anims: Vector<_Anim> = Vector {}
    pub view_set: bool = false
    pub view: func (Builder) = (_b: Builder): _bstack.Clear() end
    pub win: window.Window = window.Window {}
    pub has_win: bool = false
    pub canvas: paint.Canvas = paint.Canvas {}
    pub has_canvas: bool = false
    pub frames: int = 0
    pub handlers_run: int = 0
    pub dirty_view: bool = false
    pub dirty_layout: bool = false
    pub dirty_style: bool = false
    pub dirty_place: bool = false
    pub dirty_dom: bool = false
    pub mx: f64 = 0.0
    pub my: f64 = 0.0
    pub drag_sel: bool = false
    pub order: Vector<int> = Vector {}
    pub quit: bool = false
    pub last_damage_n: int = 0
    pub last_damage_area: int = 0
    pub last_layout_calls: int = 0
    pub last_layout_ms: f64 = 0.0
    pub last_paint_ms: f64 = 0.0
    pub last_style_ms: f64 = 0.0
    pub timer_id: int = -1
    pub script: str = ""
    pub restyled: Vector<int> = Vector {}
end
