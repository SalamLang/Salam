package ui

import math
import gui.css
import gui.typeset

const _VA_NONE := 0
const _VA_TOP := 1
const _VA_BOTTOM := 2

struct _FontV:
    pub asc: f64 = 0.0
    pub desc: f64 = 0.0
    pub gap: f64 = 0.0
    pub xh: f64 = 0.0
end

func _font_v(cs: css.ComputedStyle): _FontV:
    mut v := _FontV {}
    fs := cs.font_size
    v.asc = fs * 0.8
    v.desc = fs * 0.2
    v.xh = fs * 0.5
    face := typeset.FaceForCodepoint(_fc, cs.font_family, cs.font_weight, cs.font_style != css.FontStyle.Normal, 0x78)
    if face < 0:
        ret v
    end
    m := typeset.Metrics(typeset.FaceFont(_fc, face))
    if m.units_per_em <= 0:
        ret v
    end
    u := m.units_per_em as f64
    v.asc = (m.ascent as f64) * fs / u
    v.desc = math.Abs(m.descent as f64) * fs / u
    v.gap = (m.line_gap as f64) * fs / u
    v.xh = m.x_height > 0 ? (m.x_height as f64) * fs / u : v.asc * 0.56
    ret v
end

func _va_kind(node: int): int:
    cs := _style_of(node)
    switch cs.vertical_align:
        css.VerticalAlign.Top: ret _VA_TOP end
        css.VerticalAlign.Bottom: ret _VA_BOTTOM end
        else: ret _VA_NONE end
    end
    ret _VA_NONE
end

func _va_base(node: int, base: f64, h: f64): f64:
    cs := _style_of(node)
    pn := _el_of(_e.dom.nodes[node].parent)
    switch cs.vertical_align:
        css.VerticalAlign.Sub:
            ps := _style_of(pn)
            ret base - (ps.font_size / 5.0 + 1.0)
        end
        css.VerticalAlign.Super:
            ps := _style_of(pn)
            ret base + (ps.font_size / 3.0 + 1.0)
        end
        css.VerticalAlign.TextTop:
            ret _font_v(_style_of(pn)).asc
        end
        css.VerticalAlign.TextBottom:
            ret h - _font_v(_style_of(pn)).desc
        end
        css.VerticalAlign.Middle:
            ret h / 2.0 + _font_v(_style_of(pn)).xh / 2.0
        end
        css.VerticalAlign.Length:
            l := cs.vertical_align_len
            if l.has_pct:
                mut lh := cs.line_height
                if cs.line_height_normal:
                    fv := _font_v(cs)
                    lh = fv.asc + fv.desc + fv.gap
                end
                ret base + l.px + l.pct * lh / 100.0
            end
            ret base + l.px
        end
        else:
            ret base
        end
    end
    ret base
end

func _va_tb_count(f: _Ifc): int:
    mut n := 0
    each ai in f.atoms:
        if _e.atoms[ai].va != _VA_NONE:
            n++
        end
    end
    ret n
end

func _va_line_of(f: _Ifc, a: _Atom, li &: int): bool:
    if a.span < 0 or a.span >= f.para.span_starts.len():
        ret false
    end
    sp_start := f.para.span_starts[a.span]
    repeat f.lay.lines.len() in k:
        line := f.lay.lines[k]
        mut r := line.run_start
        until r < line.run_start + line.run_count:
            run := f.lay.runs[r]
            repeat run.glyph_count in q:
                if f.lay.glyphs[run.glyph_start + q].cluster == sp_start:
                    li = k
                    ret true
                end
            end
            r++
        end
    end
    ret false
end

func _va_relayout(fi: int, width: f64):
    mut f := _e.ifcs.ref(fi)
    _patch_atoms(f)
    if f.has_lay:
        typeset.FreeLayout(f.lay)
        f.has_lay = false
    end
    if f.has_para:
        typeset.FreeParagraph(f.para)
    end
    f.para = typeset.NewParagraph(_fc, f.spans, f.pstyle)
    f.has_para = true
    f.lay = typeset.LayoutParagraph(f.para, _fc, width)
    f.lay_w = width
    f.has_lay = true
end

func _va_fix(fi: int, width: f64):
    f0 := _e.ifcs[fi]
    if _va_tb_count(f0) == 0:
        ret
    end
    mut stale := false
    each ai in f0.atoms:
        if _e.atoms[ai].va_set:
            mut a := _e.atoms.ref(ai)
            a.va_set = false
            stale = true
        end
    end
    if stale:
        _va_relayout(fi, width)
    end
    repeat 3:
        f := _e.ifcs[fi]
        mut changed := false
        each ai in f.atoms:
            a := _e.atoms[ai]
            if a.va == _VA_NONE:
                continue
            end
            mut li := -1
            if not _va_line_of(f, a, li):
                continue
            end
            line := f.lay.lines[li]
            mut want := line.baseline - line.top
            if a.va == _VA_BOTTOM:
                want = a.mh - (line.top + line.height - line.baseline)
            end
            if not a.va_set or math.Abs(want - a.baseline) > 0.001:
                mut am := _e.atoms.ref(ai)
                am.baseline = want
                am.va_set = true
                changed = true
            end
        end
        if not changed:
            break
        end
        _va_relayout(fi, width)
    end
end
