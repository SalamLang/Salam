package ui

if SALAM_JS:
    import str
    import gui.paint
    import gui.window

    extern:
        func salam_js_by_id(id: str): i64
        func salam_js_query_all(sel: str): i64
        func salam_js_window(): i64
        func salam_js_global(name: str): i64
        func salam_js_obj0(): i64
        func salam_js_is_nullish(value: i64): bool
        func salam_js_set_text(el: i64, text: str)
        func salam_js_set_attr(el: i64, name: str, value: str)
        func salam_js_get_attr(el: i64, name: str): str
        func salam_js_get_prop(obj: i64, name: str): i64
        func salam_js_get_num(obj: i64, name: str): f64
        func salam_js_get_str(obj: i64, name: str): str
        func salam_js_get_bool(obj: i64, name: str): bool
        func salam_js_set_prop(obj: i64, name: str, ...)
        func salam_js_call(obj: i64, method: str, ...): i64
        func salam_js_item_at(listobj: i64, idx: i64): i64
        func salam_js_count_of(listobj: i64): i64
    end

    func _web_live(): bool:
        if _e.ready:
            ret false
        end
        ret not salam_js_is_nullish(salam_js_global("document"))
    end

    func _web_el(id: str, key: str): i64:
        if id.Len() > 0:
            ret salam_js_by_id(id)
        end
        if key.Len() == 0:
            ret salam_js_global("")
        end
        all := salam_js_query_all("[data-key], [key]")
        repeat salam_js_count_of(all) as int in i:
            el := salam_js_item_at(all, i as i64)
            if salam_js_get_attr(el, "data-key") == key or salam_js_get_attr(el, "key") == key:
                ret el
            end
        end
        ret salam_js_global("")
    end

    func _web_exists(id: str, key: str): bool:
        ret not salam_js_is_nullish(_web_el(id, key))
    end

    func _web_name(el: i64): str:
        ret str.Lower(salam_js_get_str(el, "tagName"))
    end

    func _web_kind(tag: str): str:
        switch tag:
            "body": ret "page" end
            "div": ret "box" end
            "h1", "h2", "h3", "h4", "h5", "h6": ret "heading" end
            "p": ret "paragraph" end
            "a": ret "link" end
            "b": ret "bold" end
            "i": ret "italic" end
            "em": ret "emphasis" end
            "var": ret "variable" end
            "dfn": ret "definition" end
            "kbd": ret "keyboard" end
            "samp": ret "sample" end
            "sub": ret "subscript" end
            "sup": ret "superscript" end
            "del": ret "deleted" end
            "s": ret "strikethrough" end
            "ins": ret "inserted" end
            "u": ret "underline" end
            "abbr": ret "abbreviation" end
            "bdi": ret "isolate" end
            "bdo": ret "direction override" end
            "q": ret "quote" end
            "br": ret "break" end
            "wbr": ret "word break" end
            "textarea": ret "input" end
            "optgroup": ret "option group" end
            "datalist": ret "data list" end
            "img": ret "image" end
            "map": ret "image map" end
            "fieldset": ret "field set" end
            "li": ret "item" end
            "ul": ret "list" end
            "ol": ret "ordered list" end
            "dl": ret "description list" end
            "dt": ret "term" end
            "dd": ret "description" end
            "thead": ret "table header" end
            "tbody": ret "table body" end
            "tfoot": ret "table footer" end
            "tr": ret "row" end
            "td": ret "column" end
            "th": ret "header column" end
            "colgroup": ret "column group" end
            "col": ret "column definition" end
            "hgroup": ret "heading group" end
            "blockquote": ret "block quote" end
            "pre": ret "preformatted" end
            "figcaption": ret "figure caption" end
            "hr": ret "line" end
            "rt": ret "ruby text" end
            "rp": ret "ruby parenthesis" end
        end
        ret tag
    end

    func _web_tag(id: str, key: str): str:
        el := _web_el(id, key)
        if salam_js_is_nullish(el):
            ret ""
        end
        ret _web_kind(_web_name(el))
    end

    func _web_collect(node: i64, b &: str.StringBuilder):
        kind := salam_js_get_num(node, "nodeType") as int
        if kind == 3:
            str.BufAppend(b, salam_js_get_str(node, "data"))
            ret
        end
        if kind != 1:
            ret
        end
        if salam_js_get_str(node, "tagName") == "BR":
            str.BufAppend(b, "\n")
            ret
        end
        kids := salam_js_get_prop(node, "childNodes")
        repeat salam_js_count_of(kids) as int in i:
            _web_collect(salam_js_item_at(kids, i as i64), b)
        end
    end

    func _web_text(id: str, key: str): str:
        el := _web_el(id, key)
        if salam_js_is_nullish(el):
            ret ""
        end
        mut b := str.NewBuilder()
        _web_collect(el, b)
        r := str.BufStr(b)
        str.BufFree(b)
        ret r
    end

    func _web_set_text(id: str, key: str, text: str):
        el := _web_el(id, key)
        if not salam_js_is_nullish(el):
            salam_js_set_text(el, text)
        end
    end

    func _web_is_control(el: i64): bool:
        tag := _web_name(el)
        ret tag == "input" or tag == "textarea" or tag == "select"
    end

    func _web_is_toggle(el: i64): bool:
        t := salam_js_get_str(el, "type")
        ret t == "checkbox" or t == "radio"
    end

    func _web_value(id: str, key: str): str:
        el := _web_el(id, key)
        if salam_js_is_nullish(el) or not _web_is_control(el):
            ret ""
        end
        if _web_is_toggle(el):
            ret salam_js_get_attr(el, "value")
        end
        ret salam_js_get_str(el, "value")
    end

    func _web_set_value(id: str, key: str, value: str):
        el := _web_el(id, key)
        if salam_js_is_nullish(el) or not _web_is_control(el):
            ret
        end
        if _web_is_toggle(el):
            salam_js_set_attr(el, "value", value)
            ret
        end
        salam_js_set_prop(el, "value", value)
        if _web_name(el) == "select":
            salam_js_set_prop(el, "__salam_held", true)
        end
    end

    func _web_check_prop(el: i64): str:
        ret _web_name(el) == "option" ? "selected" : "checked"
    end

    func _web_checked(id: str, key: str): bool:
        el := _web_el(id, key)
        if salam_js_is_nullish(el):
            ret false
        end
        ret salam_js_get_bool(el, _web_check_prop(el))
    end

    func _web_set_checked(id: str, key: str, is_on: bool):
        el := _web_el(id, key)
        if not salam_js_is_nullish(el):
            salam_js_set_prop(el, _web_check_prop(el), is_on)
        end
    end

    func _web_do(id: str, key: str, method: str):
        el := _web_el(id, key)
        if not salam_js_is_nullish(el):
            salam_js_call(el, method)
        end
    end

    func _web_reveal(el: i64):
        how := salam_js_obj0()
        salam_js_set_prop(how, "block", "nearest")
        salam_js_set_prop(how, "inline", "nearest")
        salam_js_call(el, "scrollIntoView", how)
    end

    func _web_focus(id: str, key: str):
        el := _web_el(id, key)
        if salam_js_is_nullish(el):
            ret
        end
        salam_js_call(el, "focus")
        tag := _web_name(el)
        if tag == "input" or tag == "textarea":
            salam_js_call(el, "select")
        end
    end

    func _web_scroll_to(id: str, key: str):
        el := _web_el(id, key)
        if not salam_js_is_nullish(el):
            _web_reveal(el)
        end
    end

    func _web_attr(id: str, key: str, name: str): str:
        el := _web_el(id, key)
        if salam_js_is_nullish(el):
            ret ""
        end
        if name == "type" and _web_name(el) == "textarea":
            ret "textarea"
        end
        ret salam_js_get_attr(el, name)
    end

    func _web_set_attr(id: str, key: str, name: str, value: str):
        el := _web_el(id, key)
        if not salam_js_is_nullish(el):
            salam_js_set_attr(el, name, value)
        end
    end

    func _web_rect(id: str, key: str): paint.Rect:
        el := _web_el(id, key)
        if salam_js_is_nullish(el):
            ret paint.Rect {}
        end
        r := salam_js_call(el, "getBoundingClientRect")
        win := salam_js_window()
        ret paint.Rect {
            x = salam_js_get_num(r, "x") + salam_js_get_num(win, "scrollX"),
            y = salam_js_get_num(r, "y") + salam_js_get_num(win, "scrollY"),
            width = salam_js_get_num(r, "width"),
            height = salam_js_get_num(r, "height")
        }
    end

    func _web_runs(): int:
        win := salam_js_window()
        if salam_js_is_nullish(salam_js_get_prop(win, "__salam_base")):
            ret 0
        end
        ret (salam_js_get_num(win, "__salam_runs") - salam_js_get_num(win, "__salam_base")) as int
    end

    func _web_event(): Event:
        e := salam_js_global("event")
        if salam_js_is_nullish(e):
            ret Event {}
        end
        mut ev := Event { kind = salam_js_get_str(e, "type") }
        mut el := salam_js_get_prop(e, "currentTarget")
        if salam_js_is_nullish(el) or salam_js_get_str(el, "id") == "":
            el = salam_js_get_prop(e, "target")
        end
        if not salam_js_is_nullish(el):
            ev.target = salam_js_get_str(el, "id")
            ev.value = salam_js_get_str(el, "value")
            ev.checked = salam_js_get_bool(el, "checked")
        end
        ev.x = salam_js_get_num(e, "clientX")
        ev.y = salam_js_get_num(e, "clientY")
        ev.button = salam_js_get_num(e, "button") as int
        ev.key = salam_js_get_str(e, "key")
        ev.text = salam_js_get_str(e, "data")
        mut mods := 0
        if salam_js_get_bool(e, "shiftKey"):
            mods |= window.mod_shift
        end
        if salam_js_get_bool(e, "ctrlKey"):
            mods |= window.mod_control
        end
        if salam_js_get_bool(e, "altKey"):
            mods |= window.mod_alt
        end
        if salam_js_get_bool(e, "metaKey"):
            mods |= window.mod_super
        end
        ev.modifiers = mods
        ret ev
    end

    func _web_open(url: str):
        _opened_urls.Push(str.Clone(url))
        if url.StartsWith("#"):
            _web_scroll_to(url.Substr(1, url.Len() - 1), "")
            ret
        end
        if url.StartsWith("http://") or url.StartsWith("https://") or url.StartsWith("mailto:"):
            if _opener_set:
                _opener(url)
            else:
                salam_js_call(salam_js_window(), "open", url, "_blank", "noopener")
            end
            ret
        end
        if _navigator_set:
            _navigator(url)
        else:
            salam_js_call(salam_js_get_prop(salam_js_window(), "location"), "assign", url)
        end
    end
else:
    import gui.paint

    func _web_live(): bool:
        ret false
    end

    func _web_exists(_id: str, _key: str): bool:
        ret false
    end

    func _web_tag(_id: str, _key: str): str:
        ret ""
    end

    func _web_text(_id: str, _key: str): str:
        ret ""
    end

    func _web_set_text(_id: str, _key: str, _text: str):
        _n := _id.Len()
    end

    func _web_value(_id: str, _key: str): str:
        ret ""
    end

    func _web_set_value(_id: str, _key: str, _value: str):
        _n := _id.Len()
    end

    func _web_checked(_id: str, _key: str): bool:
        ret false
    end

    func _web_set_checked(_id: str, _key: str, _is_on: bool):
        _n := _id.Len()
    end

    func _web_do(_id: str, _key: str, _method: str):
        _n := _id.Len()
    end

    func _web_focus(_id: str, _key: str):
        _n := _id.Len()
    end

    func _web_scroll_to(_id: str, _key: str):
        _n := _id.Len()
    end

    func _web_attr(_id: str, _key: str, _name: str): str:
        ret ""
    end

    func _web_set_attr(_id: str, _key: str, _name: str, _value: str):
        _n := _id.Len()
    end

    func _web_rect(_id: str, _key: str): paint.Rect:
        ret paint.Rect {}
    end

    func _web_runs(): int:
        ret 0
    end

    func _web_event(): Event:
        ret Event {}
    end

    func _web_open(_url: str):
        _n := _url.Len()
    end
end
