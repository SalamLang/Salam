mut _cfg := Config {}
mut _inited := false
mut _token := ""
mut _wins := Vector {} as Vector<_Win>
mut _commands := Vector {} as Vector<_Command>
mut _rules := Vector {} as Vector<_Rule>
mut _listeners := Vector {} as Vector<_Listener>
mut _pending := HashMap {} as HashMap<i64, _Owned>
mut _pending_lock := sync.NewMutex()
mut _call_serial := 0 as i64
mut _local_origin_text := ""

// App lifecycle / activation hooks (best-effort).
mut _on_app_ready := (): ret end
mut _on_app_activate := (): ret end
mut _on_before_quit := (): ret true end
mut _on_quit := (): ret end
mut _on_window_all_closed := (): ret end
mut _on_deep_link := (_url: str): ret end
mut _on_single_instance := (_args: Vector<str>): ret end
mut _app_ready_fired := false
mut _quitting := false

struct _Win:
    pub label: str = ""
    pub view: WebView = WebView {}
    pub start_origin: str = ""
    pub inline_html: bool = false
    pub allow_navigation: Vector<str> = Vector {}
    pub fullscreen_requested: bool = false
    pub always_on_top_requested: bool = false
    pub always_on_top_applied: bool = false
end

struct _Owned:
    pub command: str = ""
    pub args: str = ""
    pub origin: str = ""
    pub id: str = ""
end

struct _Command:
    pub name: str = ""
    pub handler: func (Call)
    pub threaded: bool = false
end

struct _Rule:
    pub origin: str = ""
    pub patterns: Vector<str> = Vector {}
end

struct _Listener:
    pub name: str = ""
    pub handler: func (str)
end

