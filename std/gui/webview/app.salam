end

func _js_string(s: str): str:
    ret json.Str(s)
end

func _reply(window: int, origin: str, id: str, ok: bool, raw_json: str):
    if window < 0:
        ret
    end
    mut b := str.NewBuilder()
    str.BufAppend(b, "if(location.origin===")
    quoted := _js_string(origin)
    str.BufAppend(b, quoted)
    mem.Free(quoted as void*)
    str.BufAppend(b, "&&window.__salamBridge)window.__salamBridge.reply(")
    str.BufAppend(b, id)
    str.BufAppend(b, ok ? ",true," : ",false,")
    str.BufAppend(b, raw_json)
    str.BufAppend(b, ")")
    code := str.BufStr(b)
    _app_view(window).EvalLater(code)
    mem.Free(code as void*)
    str.BufFree(b)
end

func _emit_to(index: int, event: str, raw_json: str):
    if index < 0:
        ret
    end
    mut b := str.NewBuilder()
    str.BufAppend(b, "if(")
    origins := _origins_json(index)
    str.BufAppend(b, origins)
    mem.Free(origins as void*)
    str.BufAppend(b, ".includes(location.origin)&&window.__salamBridge)window.__salamBridge.event(")
    name := _js_string(event)
    str.BufAppend(b, name)
    mem.Free(name as void*)
    str.BufAppend(b, ",")
    str.BufAppend(b, raw_json)
    str.BufAppend(b, ")")
    code := str.BufStr(b)
    _app_view(index).EvalLater(code)
    mem.Free(code as void*)
    str.BufFree(b)
end

func _app_view(index: int): WebView:
    sync.Lock(_pending_lock)
    mut view := WebView {}
    if index >= 0 and index < _wins.len():
        view = _wins[index].view
    end
    sync.Unlock(_pending_lock)
    ret view
end

func _local_origin(): str:
    if _local_origin_text.len() == 0:
        _local_origin_text = SchemeOrigin(_cfg.scheme)
    end
    ret _local_origin_text
end

func _origins_json(index: int): str:
    mut items := Vector {} as Vector<str>
    defer items.free()
    items.push(_js_string(_local_origin()))
    each rule in _rules:
        items.push(_js_string(rule.origin))
    end
    sync.Lock(_pending_lock)
    has_inline := index >= 0 and index < _wins.len() and _wins[index].inline_html
    sync.Unlock(_pending_lock)
    if has_inline:
        items.push(_js_string("null"))
    end
    ret json.Array(items)
end

func _matches(pattern: str, name: str): bool:
    if pattern == "*" or pattern == name:
        ret true
    end
    if str.EndsWith(pattern, "*"):
        prefix := str.Substr(pattern, 0, str.Len(pattern) - 1)
        defer mem.Free(prefix as void*)
        ret str.StartsWith(name, prefix)
    end
    ret false
end

func _bridge_script(index: int): str:
    origins := _origins_json(index)
    post := PostScript()
    token := _js_string(_token)
    code := str.Replace(
        str.Replace(str.Replace(_BRIDGE_JS, "%ORIGINS%", origins), "%POST%", post), "%TOKEN%",
        token
    )
    mem.Free(origins as void*)
    mem.Free(post as void*)
    mem.Free(token as void*)
    ret code
end

func _find_command(name: str): int:
    repeat _commands.len() in i:
        if _commands[i].name == name:
            ret i
        end
    end
    ret -1
end

func _field(text: str, key: str): str:
    value := json.Get(text, key)
    ret value.len() > 0 ? value : str.Clone("")
end

func _on_message(index: int, text: str):
    if not json.Valid(text):
        ret
    end
    sent := _field(text, "t")
    defer mem.Free(sent as void*)
    if not crypto.SecretEquals(sent, _token):
        Trace("message dropped: wrong token")
        ret
    end
    url := _wins[index].view.URL()
    defer mem.Free(url as void*)
    origin := OriginOf(url)
    kind := _field(text, "k")
    defer mem.Free(kind as void*)
    if kind == "emit":
        _on_emit(index, text, origin)
        mem.Free(origin as void*)
        ret
    end
    if kind != "call":
        mem.Free(origin as void*)
        ret
    end
    id := _field(text, "id")
    command := _field(text, "cmd")
    args := _field(text, "args")
    sync.Lock(_pending_lock)
    _call_serial += 1
    serial := _call_serial
    _pending.put(serial, _Owned { command = command, args = args, origin = origin, id = id })
    sync.Unlock(_pending_lock)
    mut c := Call { command = command, args = args, origin = origin, window = index, id = id, serial = serial }
    inline_ok := origin == "null" and _wins[index].inline_html
    if not inline_ok and not Allowed(origin, command):
        Trace("command refused for " + origin)
        c.Reject("not allowed: " + command)
        ret
    end
    found := _find_command(command)
    if found < 0:
        c.Reject("unknown command: " + command)
        ret
    end
    entry := _commands[found]
    if entry.threaded:
        pool.Go((): entry.handler(c) end)
    else:
        entry.handler(c)
    end
end

func _on_emit(index: int, text: str, origin: str):
    inline_ok := origin == "null" and _wins[index].inline_html
    name := _field(text, "name")
    defer mem.Free(name as void*)
    pattern := "event:".concat(name)
    defer mem.Free(pattern as void*)
    if not inline_ok and not Allowed(origin, pattern):
        ret
    end
    data := _field(text, "data")
    defer mem.Free(data as void*)
    each l in _listeners:
        if l.name == name:
            l.handler(data)
        end
    end
end

func _nav_allowed(index: int, url: str): bool:
    if url == "about:blank" or url == "about:srcdoc":
        ret true
    end
    if str.StartsWith(url, "data:") or str.StartsWith(url, "about:"):
        ret _wins[index].inline_html
    end
    origin := OriginOf(str.StartsWith(url, "blob:") ? str.Substr(url, 5, str.Len(url) - 5) : url)
    defer mem.Free(origin as void*)
    if origin == _local_origin() or origin == _wins[index].start_origin:
        ret true
    end
    each rule in _rules:
        if rule.origin == origin:
            ret true
        end
    end
    each allowed in _wins[index].allow_navigation:
        if allowed == origin:
            ret true
        end
    end
    ret false
end

func _on_navigate(index: int, url: str): bool:
    if _nav_allowed(index, url):
        ret true
    end
    if _cfg.external_links and NavigationIsMainFrame():
        OpenURL(url)
    end
    ret false
end

func _on_new_window(url: str):
    if _cfg.external_links:
        OpenURL(url)
    end
end

func _startup():
    if _inited:
        ret
    end
    _inited = true
    if _cfg.id.len() == 0:
        _cfg.id = "ir.salamlang.app"
    end
    if _cfg.name.len() == 0:
        _cfg.name = _cfg.id
    end
    _token = crypto.RandomHex(16)
    SetApp(_cfg.id, _cfg.name)
    dir := DataDir()
    _mk := os.MkdirAll(dir)
    SetDataDir(dir)
    mem.Free(dir as void*)
    RegisterScheme(_cfg.scheme, (req: Request): ret _serve_asset(req) end)
    if _cfg.pack_path.len() > 0:
        _opened := pack.Open(_cfg.pack_path, _cfg.id, _the_pack)
    else:
        _open_default_pack()
    end
end

func _open_default_pack():
    exe := _exe_path()
    defer mem.Free(exe as void*)
    if exe.len() == 0:
        ret
    end
    if pack.Open(exe, _cfg.id, _the_pack):
        ret
    end
    sibling := exe.concat(".pack")
    defer mem.Free(sibling as void*)
    if os.Exists(sibling) and pack.Open(sibling, _cfg.id, _the_pack):
        ret
    end
    if SALAM_OS_MAC:
        dir := filepath.Dir(exe)
        defer mem.Free(dir as void*)
        resources := dir.concat("/../Resources/app.pack")
        defer mem.Free(resources as void*)
        if os.Exists(resources):
            _opened := pack.Open(resources, _cfg.id, _the_pack)
        end
    end
end

@en "OriginOf"
@fa "مبدا نشانی"
pub func OriginOf(url: str): str:
    start := str.IndexOf(url, "://")
    if start <= 0:
        ret str.Clone("null")
    end
    scheme := str.Substr(url, 0, start)
    defer mem.Free(scheme as void*)
    if str.EqualFold(scheme, "file"):
        ret str.Clone("file://")
    end
    rest := start + 3
    mut stop := str.Len(url)
    each sep in ["/", "?", "#"]:
        at := str.IndexFrom(url, sep, rest)
        if at >= 0 and at < stop:
            stop = at
        end
    end
    authority := str.Substr(url, rest, stop - rest)
    defer mem.Free(authority as void*)
    at_sign := str.LastIndex(authority, "@")
    host := at_sign >= 0 ? str.Substr(authority, at_sign + 1, str.Len(authority) - at_sign - 1) : str.Clone(authority)
    defer mem.Free(host as void*)
    lower_scheme := str.Lower(scheme)
    defer mem.Free(lower_scheme as void*)
    lower_host := str.Lower(host)
    defer mem.Free(lower_host as void*)
    mut host_only := str.Clone(lower_host)
    if lower_scheme == "https" and str.EndsWith(lower_host, ":443"):
        mem.Free(host_only as void*)
        host_only = str.Substr(lower_host, 0, str.Len(lower_host) - 4)
    else lower_scheme == "http" and str.EndsWith(lower_host, ":80"):
        mem.Free(host_only as void*)
        host_only = str.Substr(lower_host, 0, str.Len(lower_host) - 3)
    end
    mut b := str.NewBuilder()
    str.BufAppend(b, lower_scheme)
    str.BufAppend(b, "://")
    str.BufAppend(b, host_only)
    out := str.BufStr(b)
    str.BufFree(b)
    mem.Free(host_only as void*)
    ret out
end

@en "Allowed"
@fa "مجاز است"
pub func Allowed(origin: str, command: str): bool:
    if origin == _local_origin():
        ret true
    end
    each rule in _rules:
        if rule.origin == origin:
            each pattern in rule.patterns:
                if _matches(pattern, command):
                    ret true
                end
            end
        end
    end
    ret false
end

@en "PackDir"
@fa "فشرده کردن پوشه"
pub func PackDir(dir: str, out_path: str, key: str): int:
    ret pack.PackDir(dir, out_path, key)
end

@en "Init"
@fa "آغاز"
pub func Init(config: Config):
    _cfg = config
    _inited = false
end

@en "CurrentConfig"
@fa "پیکربندی فعلی"
pub func CurrentConfig(): Config:
    ret _cfg
end

@en "DataDir"
@fa "پوشه داده"
pub func DataDir(): str:
    id := _cfg.id.len() > 0 ? _cfg.id : "ir.salamlang.app"
    if SALAM_OS_WINDOWS:
        ret filepath.Join(user.CacheDir(), id)
    else SALAM_OS_MAC:
        ret filepath.Join(user.HomeDir(), "Library/Application Support/".concat(id))
    else:
        xdg := os.Env("XDG_DATA_HOME")
        if xdg.len() > 0:
            ret filepath.Join(xdg, id)
        end
        ret filepath.Join(user.HomeDir(), ".local/share/".concat(id))
    end
end

@en "Allow"
@fa "اجازه دادن"
pub func Allow(origin: str, commands: Vector<str>):
    normalized := OriginOf(origin)
    _rules.push(_Rule { origin = normalized, patterns = commands })
end

@en "Command"
@fa "فرمان"
pub func Command(name: str, handler: func (Call)):
    _commands.push(_Command { name = str.Clone(name), handler = handler })
end

@en "CommandAsync"
@fa "فرمان ناهمگام"
pub func CommandAsync(name: str, handler: func (Call)):
    _commands.push(_Command { name = str.Clone(name), handler = handler, threaded = true })
end

@en "On"
@fa "هنگام رویداد"
pub func On(event: str, handler: func (str)):
    _listeners.push(_Listener { name = str.Clone(event), handler = handler })
end

@en "Emit"
@fa "رویداد فرستادن"
pub func Emit(event: str, raw_json: str = "null"):
    sync.Lock(_pending_lock)
    count := _wins.len()
    sync.Unlock(_pending_lock)
    repeat count in i:
        _emit_to(i, event, raw_json)
    end
end

@en "AssetURL"
@fa "نشانی دارایی"
pub func AssetURL(path: str): str:
    ret SchemeURL(_cfg.scheme, path)
end

@en "Open"
@fa "باز کردن"
pub func Open(options: WindowOptions): Window:
    _startup()
    view := Create(_cfg.debug, false)
    if view.IsClosed():
        ret Window {}
    end
    index := _wins.len()
    mut start := options.url
    if start.len() == 0 and options.html.len() == 0:
        start = AssetURL("/index.html")
    end
    sync.Lock(_pending_lock)
    _wins.push(
        _Win {
            label = str.Clone(options.label), view = view, start_origin = start.len() > 0 ? OriginOf(start) : str.Clone("null"),
            inline_html = options.html.len() > 0, allow_navigation = options.allow_navigation
        }
    )
    sync.Unlock(_pending_lock)
    if options.title.len() > 0:
        view.SetTitle(options.title)
    end
    view.SetSize(options.width, options.height, options.resizable ? HINT_NONE : HINT_FIXED)
    if options.min_width > 0 or options.min_height > 0:
        view.SetMinSize(options.min_width, options.min_height)
    end
    if options.icon.len() > 0:
        view.SetIcon(options.icon)
    end
    if not options.context_menu:
        view.SetContextMenu(false)
    end
    bridge := _bridge_script(index)
    view.Init(bridge)
    mem.Free(bridge as void*)
    each script in options.scripts:
        view.Init(script, true)
    end
    view.OnMessage((text: str): _on_message(index, text) end)
    view.OnNavigate((url: str): ret _on_navigate(index, url) end)
    view.OnNewWindow((url: str): _on_new_window(url) end)
    if options.center:
        view.Center()
    end
    if options.html.len() > 0:
        view.SetHTML(options.html)
    else:
        view.Navigate(start)
    end
    if options.visible:
        view.Show()
    end
    ret Window { index = index }
end

@en "GetWindow"
@fa "گرفتن پنجره"
pub func GetWindow(label: str): Window:
    repeat _wins.len() in i:
        if _wins[i].label == label:
            ret Window { index = i }
        end
    end
    ret Window {}
end

@en "Run"
@fa "اجرا"
pub func Run():
    RunAll()
end
