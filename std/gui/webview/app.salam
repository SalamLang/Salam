    pub min_width: int = 0
    @en "min_height"
    @fa "کمترین بلندی"
    pub min_height: int = 0
    @en "url"
    @fa "نشانی"
    pub url: str = ""
    @en "html"
    @fa "اچ تی ام ال"
    pub html: str = ""
    @en "icon"
    @fa "نماد"
    pub icon: str = ""
    @en "resizable"
    @fa "تغییرپذیر"
    pub resizable: bool = true
