@en "Call"
@fa "فراخوان"
pub struct Call:
    @en "command"
    @fa "فرمان"
    pub command: str = ""
    @en "args"
    @fa "آرگومان ها"
    pub args: str = "{}"
    @en "origin"
    @fa "مبدا"
    pub origin: str = ""
    @en "window"
    @fa "پنجره"
    pub window: int = -1
    id: str = ""
    serial: i64 = 0

    func finish(ok: bool, raw_json: str):
        sync.Lock(_pending_lock)
        known := _pending.Has(this.serial)
        mut owned := _Owned {}
        if known:
            owned = _pending.Get(this.serial)
            _gone := _pending.Remove(this.serial)
        end
        sync.Unlock(_pending_lock)
        if not known:
            ret
        end
        _reply(this.window, owned.origin, owned.id, ok, raw_json)
        this.command = ""
        this.args = "{}"
        this.origin = ""
        mem.Free(owned.command as void*)
        mem.Free(owned.args as void*)
        mem.Free(owned.origin as void*)
        mem.Free(owned.id as void*)
    end

    @en "Str"
    @fa "متن"
    pub func Str(key: str): str:
        ret _field(this.args, key)
    end

    @en "Int"
    @fa "عدد"
    pub func Int(key: str): int:
        ret json.GetInt(this.args, key)
    end

    @en "Bool"
    @fa "درستی"
    pub func Bool(key: str): bool:
        raw := _field(this.args, key)
        defer mem.Free(raw as void*)
        ret raw == "true"
    end

    @en "Has"
    @fa "دارد"
    pub func Has(key: str): bool:
        ret json.Has(this.args, key)
    end

    @en "Resolve"
    @fa "پاسخ"
    pub func Resolve(raw_json: str):
        this.finish(true, raw_json)
    end

    @en "ResolveStr"
    @fa "پاسخ متنی"
    pub func ResolveStr(value: str):
        encoded := json.Str(value)
        this.finish(true, encoded)
        mem.Free(encoded as void*)
    end

    @en "ResolveInt"
    @fa "پاسخ عددی"
    pub func ResolveInt(value: i64):
        encoded := str.FromInt(value)
        this.finish(true, encoded)
        mem.Free(encoded as void*)
    end

    @en "ResolveBool"
    @fa "پاسخ درستی"
    pub func ResolveBool(value: bool):
        this.finish(true, value ? "true" : "false")
    end

    @en "ResolveNull"
    @fa "پاسخ خالی"
    pub func ResolveNull():
        this.finish(true, "null")
    end

    @en "Reject"
    @fa "رد"
    pub func Reject(message: str):
        encoded := json.Str(message)
        this.finish(false, encoded)
        mem.Free(encoded as void*)
    end
end

@en "Window"
@fa "پنجره"
pub struct Window:
    @en "index"
    @fa "شماره"
    pub index: int = -1

    func view(): WebView:
        ret _app_view(this.index)
    end

    @en "Navigate"
    @fa "پیمایش"
    pub func Navigate(url: str):
        this.view().Navigate(url)
    end

    @en "SetHTML"
    @fa "تنظیم اچ تی ام ال"
    pub func SetHTML(html: str):
        this.view().SetHTML(html)
    end

    @en "Eval"
    @fa "ارزیابی"
    pub func Eval(js: str):
        this.view().EvalLater(js)
    end

    @en "Emit"
    @fa "رویداد فرستادن"
    pub func Emit(event: str, raw_json: str = "null"):
        _emit_to(this.index, event, raw_json)
    end

    @en "SetTitle"
    @fa "تنظیم عنوان"
    pub func SetTitle(title: str):
        this.view().SetTitle(title)
    end

    @en "SetSize"
    @fa "تنظیم اندازه"
    pub func SetSize(width: int, height: int):
        this.view().SetSize(width, height)
    end

    @en "Show"
    @fa "نمایش"
    pub func Show():
        this.view().Show()
        _emit_app_event("window-shown", this.index)
    end

    @en "Hide"
    @fa "پنهان کردن"
    pub func Hide():
        this.view().Hide()
        _emit_app_event("window-hidden", this.index)
    end

    @en "Focus"
    @fa "تمرکز"
    pub func Focus():
        this.view().Focus()
        _emit_app_event("window-focus", this.index)
    end

    @en "Minimize"
    @fa "کمینه کردن"
    pub func Minimize():
        this.view().Minimize()
    end

    @en "Maximize"
    @fa "بیشینه کردن"
    pub func Maximize():
        this.view().Maximize()
    end

    @en "Restore"
    @fa "بازیابی"
    pub func Restore():
        // Best-effort: native restore/unmaximize hooks are backend-specific.
        // Show + focus is a safe portable fallback.
        this.Show()
        this.Focus()
    end

    @en "SetFullscreen"
    @fa "تنظیم تمام صفحه"
    pub func SetFullscreen(enabled: bool):
        // Best-effort placeholder: backend fullscreen API not uniformly exposed.
        sync.Lock(_pending_lock)
        if this.index >= 0 and this.index < _wins.Len():
            mut w := _wins[this.index]
            w.fullscreen_requested = enabled
            _wins[this.index] = w
        end
        sync.Unlock(_pending_lock)
        if enabled:
            this.Maximize()
        else:
            this.Restore()
        end
    end

    @en "IsFullscreenRequested"
    @fa "تمام صفحه درخواست شده"
    pub func IsFullscreenRequested(): bool:
        sync.Lock(_pending_lock)
        mut v := false
        if this.index >= 0 and this.index < _wins.Len():
            v = _wins[this.index].fullscreen_requested
        end
        sync.Unlock(_pending_lock)
        ret v
    end

    @en "SetAlwaysOnTop"
    @fa "تنظیم همیشه در بالا"
    pub func SetAlwaysOnTop(enabled: bool):
        // Best-effort: backend always-on-top is not uniformly available.
        sync.Lock(_pending_lock)
        if this.index >= 0 and this.index < _wins.Len():
            mut w := _wins[this.index]
            w.always_on_top_requested = enabled
            w.always_on_top_applied = false
            _wins[this.index] = w
        end
        sync.Unlock(_pending_lock)
        if enabled:
            Trace("SetAlwaysOnTop requested but not applied: backend support unavailable")
        end
    end

    @en "AlwaysOnTopSupported"
    @fa "همیشه در بالا پشتیبانی می‌شود"
    pub func AlwaysOnTopSupported(): bool:
        ret false
    end

    @en "IsAlwaysOnTopRequested"
    @fa "همیشه در بالا درخواست شده"
    pub func IsAlwaysOnTopRequested(): bool:
        sync.Lock(_pending_lock)
        mut v := false
        if this.index >= 0 and this.index < _wins.Len():
            v = _wins[this.index].always_on_top_requested
        end
        sync.Unlock(_pending_lock)
        ret v
    end

    @en "IsAlwaysOnTop"
    @fa "همیشه در بالا است"
    pub func IsAlwaysOnTop(): bool:
        sync.Lock(_pending_lock)
        mut v := false
        if this.index >= 0 and this.index < _wins.Len():
            v = _wins[this.index].always_on_top_applied
        end
        sync.Unlock(_pending_lock)
        ret v
    end

    @en "SetMinSize"
    @fa "تنظیم کمترین اندازه"
    pub func SetMinSize(width: int, height: int):
        this.view().SetMinSize(width, height)
    end

    @en "SetIcon"
    @fa "تنظیم نماد"
    pub func SetIcon(path: str):
        this.view().SetIcon(path)
    end

    @en "Center"
    @fa "وسط چین کردن"
    pub func Center():
        this.view().Center()
    end

    @en "SetVisible"
    @fa "تنظیم نمایانی"
    pub func SetVisible(visible: bool):
        if visible:
            this.Show()
        else:
            this.Hide()
        end
    end

    @en "ToggleVisible"
    @fa "جابجایی نمایانی"
    pub func ToggleVisible():
        this.SetVisible(not this.IsVisible())
    end

    @en "IsVisible"
    @fa "نمایان است"
    pub func IsVisible(): bool:
        // Best-effort: backends do not uniformly expose visibility state.
        // Treat closed/invalid windows as not visible.
        ret not this.IsClosed()
    end

    @en "IsFocused"
    @fa "تمرکز دارد"
    pub func IsFocused(): bool:
        ret this.IsActive()
    end

    @en "WindowState"
    @fa "وضعیت پنجره"
    pub func WindowState(): str:
        if this.IsClosed():
            ret "closed"
        end
        if this.IsFocused():
            ret "focused"
        end
        ret "open"
    end

    @en "ToggleFullscreen"
    @fa "جابجایی تمام صفحه"
    pub func ToggleFullscreen():
        // Best-effort: no portable state query; maximize/restore fallback.
        this.Maximize()
    end

    @en "SetContextMenuEnabled"
    @fa "تنظیم فعال بودن منوی زمینه"
    pub func SetContextMenuEnabled(enabled: bool):
        this.SetContextMenu(enabled)
    end

    @en "Reload"
    @fa "بازبارگذاری"
    pub func Reload():
        url := this.URL()
        defer mem.Free(url as void*)
        if url.Len() > 0:
            this.Navigate(url)
        end
    end

    @en "BringToFront"
    @fa "آوردن به جلو"
    pub func BringToFront():
        this.Show()
        this.Focus()
    end

    @en "Activate"
    @fa "فعال کردن"
    pub func Activate():
        this.BringToFront()
    end

    @en "Close"
    @fa "بستن"
    pub func Close():
        this.view().Destroy()
    end

    @en "URL"
    @fa "نشانی فعلی"
    pub func URL(): str:
        ret this.view().URL()
    end

    @en "IsActive"
    @fa "فعال است"
    pub func IsActive(): bool:
        ret this.view().IsActive()
    end

    @en "IsClosed"
    @fa "بسته شده است"
    pub func IsClosed(): bool:
        ret this.view().IsClosed()
    end

    @en "OpenDevTools"
    @fa "باز کردن ابزار توسعه"
    pub func OpenDevTools():
        this.view().OpenDevTools()
    end

    @en "SetDevToolsEnabled"
    @fa "تنظیم ابزار توسعه"
    pub func SetDevToolsEnabled(enabled: bool):
        this.view().SetDevToolsEnabled(enabled)
    end

    @en "IsDevToolsEnabled"
    @fa "ابزار توسعه فعال است"
    pub func IsDevToolsEnabled(): bool:
        ret this.view().IsDevToolsEnabled()
    end

    @en "SetContextMenu"
    @fa "تنظیم منوی زمینه"
    pub func SetContextMenu(enabled: bool):
        this.view().SetContextMenu(enabled)
    end

    @en "SetTranslateEnabled"
    @fa "تنظیم ترجمه"
    pub func SetTranslateEnabled(enabled: bool):
        this.view().SetTranslateEnabled(enabled)
    end

    @en "IsTranslateEnabled"
    @fa "ترجمه فعال است"
    pub func IsTranslateEnabled(): bool:
        ret this.view().IsTranslateEnabled()
    end

    @en "OnClose"
    @fa "هنگام بستن"
    pub func OnClose(handler: func () bool):
        this.view().OnClose(handler)
    end

    @en "OnLoad"
    @fa "هنگام بارگذاری"
    pub func OnLoad(handler: func (str, bool)):
