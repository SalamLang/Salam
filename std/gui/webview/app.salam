    @en "allow_navigation"
    @fa "پیمایش مجاز"
    pub allow_navigation: Vector<str> = Vector {}
end

@en "Call"
@fa "فراخوان"
pub struct Call:
    @en "command"
    @fa "فرمان"
    pub command: str = ""
    @en "args"
    @fa "آرگومان ها"
    pub args: str = "{}"
    @en "origin"
    @fa "مبدا"
    pub origin: str = ""
    @en "window"
    @fa "پنجره"
    pub window: int = -1
    id: str = ""
    serial: i64 = 0

    func finish(ok: bool, raw_json: str):
        sync.Lock(_pending_lock)
        known := _pending.has(this.serial)
        mut owned := _Owned {}
        if known:
            owned = _pending.get(this.serial)
            _gone := _pending.remove(this.serial)
        end
        sync.Unlock(_pending_lock)
        if not known:
            ret
        end
        _reply(this.window, owned.origin, owned.id, ok, raw_json)
        this.command = ""
        this.args = "{}"
        this.origin = ""
        mem.Free(owned.command as void*)
        mem.Free(owned.args as void*)
        mem.Free(owned.origin as void*)
        mem.Free(owned.id as void*)
    end

    @en "Str"
    @fa "متن"
    pub func Str(key: str): str:
        ret _field(this.args, key)
    end

    @en "Int"
    @fa "عدد"
    pub func Int(key: str): int:
        ret json.GetInt(this.args, key)
    end

    @en "Bool"
    @fa "درستی"
    pub func Bool(key: str): bool:
        raw := _field(this.args, key)
        defer mem.Free(raw as void*)
        ret raw == "true"
    end

    @en "Has"
    @fa "دارد"
    pub func Has(key: str): bool:
        ret json.Has(this.args, key)
    end

    @en "Resolve"
    @fa "پاسخ"
    pub func Resolve(raw_json: str):
        this.finish(true, raw_json)
    end

    @en "ResolveStr"
    @fa "پاسخ متنی"
    pub func ResolveStr(value: str):
        encoded := json.Str(value)
        this.finish(true, encoded)
        mem.Free(encoded as void*)
    end

    @en "ResolveInt"
    @fa "پاسخ عددی"
    pub func ResolveInt(value: i64):
        encoded := str.FromInt(value)
        this.finish(true, encoded)
        mem.Free(encoded as void*)
    end

    @en "ResolveBool"
    @fa "پاسخ درستی"
    pub func ResolveBool(value: bool):
        this.finish(true, value ? "true" : "false")
    end

    @en "ResolveNull"
    @fa "پاسخ خالی"
    pub func ResolveNull():
        this.finish(true, "null")
    end

    @en "Reject"
    @fa "رد"
    pub func Reject(message: str):
        encoded := json.Str(message)
        this.finish(false, encoded)
        mem.Free(encoded as void*)
    end
end

@en "Window"
@fa "پنجره"
pub struct Window:
    @en "index"
    @fa "شماره"
    pub index: int = -1

    func view(): WebView:
