    end

    @en "OnResize"
    @fa "هنگام تغییر اندازه"
    pub func OnResize(handler: func (int, int)):
        this.view().OnResize(handler)
    end

    @en "OnNavigate"
    @fa "هنگام پیمایش"
    pub func OnNavigate(handler: func (str) bool):
        this.view().OnNavigate(handler)
    end

    @en "OnNewWindow"
    @fa "هنگام پنجره تازه"
    pub func OnNewWindow(handler: func (str)):
        this.view().OnNewWindow(handler)
    end

    @en "OnMessage"
    @fa "هنگام پیام"
    pub func OnMessage(handler: func (str)):
        this.view().OnMessage(handler)
    end

    @en "Native"
    @fa "دسته بومی"
    pub func Native(): void*:
        ret this.view().Native()
    end

    @en "EnableDrop"
    @fa "فعال کردن رها کردن"
    pub func EnableDrop(): bool:
        native := this.Native()
        if native == null:
            ret false
        end
        ret drop.Enable(native)
    end

    @en "DisableDrop"
    @fa "غیرفعال کردن رها کردن"
    pub func DisableDrop():
        native := this.Native()
        if native != null:
            drop.Disable(native)
        end
    end

    @en "OnDrop"
    @fa "هنگام رها کردن"
    pub func OnDrop(handler: func (drop.DropEvent)):
        native := this.Native()
        if native != null:
            drop.OnDrop(native, handler)
        end
    end

    @en "OnDragEnter"
    @fa "هنگام ورود کشیدن"
    pub func OnDragEnter(handler: func (drop.DropEvent) drop.DropEvent):
        native := this.Native()
        if native != null:
            drop.OnDragEnter(native, handler)
        end
    end

    @en "OnDragOver"
    @fa "هنگام عبور کشیدن"
    pub func OnDragOver(handler: func (drop.DropEvent) drop.DropEvent):
        native := this.Native()
        if native != null:
            drop.OnDragOver(native, handler)
        end
    end

    @en "OnDragLeave"
    @fa "هنگام خروج کشیدن"
    pub func OnDragLeave(handler: func ()):
        native := this.Native()
        if native != null:
            drop.OnDragLeave(native, handler)
        end
    end

    @en "SetDropHandlers"
    @fa "تنظیم گرداننده های رها کردن"
    pub func SetDropHandlers(handlers: drop.DropHandlers):
        native := this.Native()
        if native != null:
            drop.SetHandlers(native, handlers)
        end
    end

    @en "AttachDrop"
    @fa "اتصال رها کردن"
    pub func AttachDrop(handlers: drop.DropHandlers): bool:
        native := this.Native()
        if native == null:
            ret false
        end
        ret drop.Attach(native, handlers)
    end

    @en "DetachDrop"
    @fa "جدا کردن رها کردن"
    pub func DetachDrop():
        native := this.Native()
        if native != null:
            drop.Detach(native)
        end
    end

    @en "IsDropEnabled"
    @fa "رها کردن فعال است"
    pub func IsDropEnabled(): bool:
        native := this.Native()
        if native == null:
            ret false
        end
        ret drop.IsEnabled(native)
    end

    @en "DropSupported"
    @fa "رها کردن پشتیبانی می‌شود"
    pub func DropSupported(): bool:
        ret drop.Supported()
    end

    @en "RequestAttention"
    @fa "درخواست توجه"
    pub func RequestAttention():
        RequestAttention(this)
    end
end

func _js_string(s: str): str:
    ret json.Str(s)
end

func _reply(window: int, origin: str, id: str, ok: bool, raw_json: str):
    if window < 0:
        ret
    end
    mut b := str.NewBuilder()
    str.BufAppend(b, "if(location.origin===")
    quoted := _js_string(origin)
    str.BufAppend(b, quoted)
    mem.Free(quoted as void*)
    str.BufAppend(b, "&&window.__salamBridge)window.__salamBridge.reply(")
    str.BufAppend(b, id)
    str.BufAppend(b, ok ? ",true," : ",false,")
    str.BufAppend(b, raw_json)
    str.BufAppend(b, ")")
    code := str.BufStr(b)
    _app_view(window).EvalLater(code)
    mem.Free(code as void*)
    str.BufFree(b)
end

func _emit_to(index: int, event: str, raw_json: str):
    if index < 0:
        ret
    end
    mut b := str.NewBuilder()
    str.BufAppend(b, "if(")
    origins := _origins_json(index)
    str.BufAppend(b, origins)
    mem.Free(origins as void*)
    str.BufAppend(b, ".includes(location.origin)&&window.__salamBridge)window.__salamBridge.event(")
    name := _js_string(event)
    str.BufAppend(b, name)
    mem.Free(name as void*)
    str.BufAppend(b, ",")
    str.BufAppend(b, raw_json)
    str.BufAppend(b, ")")
    code := str.BufStr(b)
    _app_view(index).EvalLater(code)
    mem.Free(code as void*)
    str.BufFree(b)
end

func _app_view(index: int): WebView:
    sync.Lock(_pending_lock)
    mut view := WebView {}
    if index >= 0 and index < _wins.Len():
        view = _wins[index].view
    end
    sync.Unlock(_pending_lock)
    ret view
end

func _local_origin(): str:
    if _local_origin_text.Len() == 0:
        _local_origin_text = SchemeOrigin(_cfg.scheme)
    end
    ret _local_origin_text
end

func _origins_json(index: int): str:
    mut items := Vector {} as Vector<str>
    defer items.Free()
    items.Push(_js_string(_local_origin()))
    each rule in _rules:
        items.Push(_js_string(rule.origin))
    end
    sync.Lock(_pending_lock)
    has_inline := index >= 0 and index < _wins.Len() and _wins[index].inline_html
    sync.Unlock(_pending_lock)
    if has_inline:
        items.Push(_js_string("null"))
    end
    ret json.Array(items)
end

func _matches(pattern: str, name: str): bool:
    if pattern == "*" or pattern == name:
        ret true
    end
    if str.EndsWith(pattern, "*"):
        prefix := str.Substr(pattern, 0, str.Len(pattern) - 1)
        defer mem.Free(prefix as void*)
        ret str.StartsWith(name, prefix)
    end
    ret false
end

func _bridge_script(index: int): str:
    origins := _origins_json(index)
    post := PostScript()
    token := _js_string(_token)
    code := str.Replace(
        str.Replace(str.Replace(_BRIDGE_JS, "%ORIGINS%", origins), "%POST%", post), "%TOKEN%",
        token
    )
    mem.Free(origins as void*)
    mem.Free(post as void*)
    mem.Free(token as void*)
    ret code
end

func _find_command(name: str): int:
    repeat _commands.Len() in i:
        if _commands[i].name == name:
            ret i
        end
    end
    ret -1
end

func _field(text: str, key: str): str:
    value := json.Get(text, key)
    ret value.Len() > 0 ? value : str.Clone("")
end

func _on_message(index: int, text: str):
    if not json.Valid(text):
        ret
    end
    sent := _field(text, "t")
    defer mem.Free(sent as void*)
    if not crypto.SecretEquals(sent, _token):
        Trace("message dropped: wrong token")
        ret
    end
    url := _wins[index].view.URL()
    defer mem.Free(url as void*)
    origin := OriginOf(url)
    kind := _field(text, "k")
    defer mem.Free(kind as void*)
    if kind == "emit":
        _on_emit(index, text, origin)
        mem.Free(origin as void*)
        ret
    end
    if kind != "call":
        mem.Free(origin as void*)
        ret
    end
    id := _field(text, "id")
    command := _field(text, "cmd")
    args := _field(text, "args")
    sync.Lock(_pending_lock)
    _call_serial++
    serial := _call_serial
    _pending.Put(serial, _Owned { command = command, args = args, origin = origin, id = id })
    sync.Unlock(_pending_lock)
    mut c := Call { command = command, args = args, origin = origin, window = index, id = id, serial = serial }
    inline_ok := origin == "null" and _wins[index].inline_html
    if not inline_ok and not Allowed(origin, command):
        Trace("command refused for " + origin)
        c.Reject("not allowed: " + command)
        ret
    end
    found := _find_command(command)
    if found < 0:
        c.Reject("unknown command: " + command)
        ret
    end
    entry := _commands[found]
    if entry.threaded:
        pool.Go((): entry.handler(c) end)
    else:
        entry.handler(c)
    end
end

func _on_emit(index: int, text: str, origin: str):
    inline_ok := origin == "null" and _wins[index].inline_html
    name := _field(text, "name")
    defer mem.Free(name as void*)
    pattern := "event:".Concat(name)
    defer mem.Free(pattern as void*)
    if not inline_ok and not Allowed(origin, pattern):
        ret
    end
    data := _field(text, "data")
    defer mem.Free(data as void*)
    each l in _listeners:
        if l.name == name:
            l.handler(data)
        end
    end
end

func _nav_allowed(index: int, url: str): bool:
    if url == "about:blank" or url == "about:srcdoc":
        ret true
    end
    if str.StartsWith(url, "data:") or str.StartsWith(url, "about:"):
        ret _wins[index].inline_html
    end
    origin := OriginOf(str.StartsWith(url, "blob:") ? str.Substr(url, 5, str.Len(url) - 5) : url)
    defer mem.Free(origin as void*)
    if origin == _local_origin() or origin == _wins[index].start_origin:
        ret true
    end
    each rule in _rules:
        if rule.origin == origin:
            ret true
        end
    end
    each allowed in _wins[index].allow_navigation:
        if allowed == origin:
            ret true
        end
    end
    ret false
end

func _on_navigate(index: int, url: str): bool:
    if _nav_allowed(index, url):
        ret true
    end
    // Best-effort deep-link/custom-protocol hook for non-asset navigations.
    if IsCustomProtocolURL(url):
        HandleDeepLink(url)
    end
    if _cfg.external_links and NavigationIsMainFrame():
        OpenURL(url)
    end
    ret false
end

func _on_new_window(url: str):
    // Best-effort: treat custom protocol URLs as app activation/deep links.
    if IsCustomProtocolURL(url):
        HandleDeepLink(url)
        ret
    end
    if _cfg.external_links:
        OpenURL(url)
    end
end

func _startup():
    if _inited:
        ret
    end
    _inited = true
    if _cfg.id.Len() == 0:
        _cfg.id = "ir.salamlang.app"
    end
    if _cfg.name.Len() == 0:
        _cfg.name = _cfg.id
    end
    if _cfg.scheme.Len() == 0:
        _cfg.scheme = "app"
    end
    _token = crypto.RandomHex(16)
    SetApp(_cfg.id, _cfg.name)
    dir := DataDir()
    _mk := os.MkdirAll(dir)
    SetDataDir(dir)
    mem.Free(dir as void*)
    RegisterScheme(_cfg.scheme, (req: Request): ret _serve_asset(req) end)
    if _cfg.pack_path.Len() > 0:
        _opened := pack.Open(_cfg.pack_path, _cfg.id, _the_pack)
    else:
        _open_default_pack()
    end
end

func _open_default_pack():
    exe := _exe_path()
    defer mem.Free(exe as void*)
    if exe.Len() == 0:
        ret
    end
    if pack.Open(exe, _cfg.id, _the_pack):
        ret
    end
    sibling := exe.Concat(".pack")
    defer mem.Free(sibling as void*)
    if os.Exists(sibling) and pack.Open(sibling, _cfg.id, _the_pack):
        ret
    end
    if SALAM_OS_MAC:
        dir := filepath.Dir(exe)
        defer mem.Free(dir as void*)
        resources := dir.Concat("/../Resources/app.pack")
        defer mem.Free(resources as void*)
        if os.Exists(resources):
            _opened := pack.Open(resources, _cfg.id, _the_pack)
        end
    end
end

@en "OriginOf"
@fa "مبدا نشانی"
pub func OriginOf(url: str): str:
    start := str.IndexOf(url, "://")
    if start <= 0:
        ret str.Clone("null")
    end
    scheme := str.Substr(url, 0, start)
    defer mem.Free(scheme as void*)
    if str.EqualFold(scheme, "file"):
        ret str.Clone("file://")
    end
    rest := start + 3
    mut stop := str.Len(url)
    each sep in ["/", "?", "#"]:
        at := str.IndexFrom(url, sep, rest)
        if at >= 0 and at < stop:
            stop = at
        end
    end
    authority := str.Substr(url, rest, stop - rest)
    defer mem.Free(authority as void*)
    at_sign := str.LastIndex(authority, "@")
    host := at_sign >= 0 ? str.Substr(authority, at_sign + 1, str.Len(authority) - at_sign - 1) : str.Clone(authority)
    defer mem.Free(host as void*)
    lower_scheme := str.Lower(scheme)
    defer mem.Free(lower_scheme as void*)
    lower_host := str.Lower(host)
    defer mem.Free(lower_host as void*)
    mut host_only := str.Clone(lower_host)
    if lower_scheme == "https" and str.EndsWith(lower_host, ":443"):
        mem.Free(host_only as void*)
        host_only = str.Substr(lower_host, 0, str.Len(lower_host) - 4)
    else lower_scheme == "http" and str.EndsWith(lower_host, ":80"):
        mem.Free(host_only as void*)
        host_only = str.Substr(lower_host, 0, str.Len(lower_host) - 3)
    end
    mut b := str.NewBuilder()
    str.BufAppend(b, lower_scheme)
    str.BufAppend(b, "://")
    str.BufAppend(b, host_only)
    out := str.BufStr(b)
    str.BufFree(b)
    mem.Free(host_only as void*)
    ret out
end

@en "Allowed"
@fa "مجاز است"
pub func Allowed(origin: str, command: str): bool:
    if origin == _local_origin():
        ret true
    end
    each rule in _rules:
        if rule.origin == origin:
            each pattern in rule.patterns:
                if _matches(pattern, command):
                    ret true
                end
            end
        end
    end
    ret false
end

@en "PackDir"
@fa "فشرده کردن پوشه"
pub func PackDir(dir: str, out_path: str, key: str): int:
    ret pack.PackDir(dir, out_path, key)
end

@en "Init"
@fa "آغاز"
pub func Init(config: Config):
    _cfg = config
    _inited = false
    if _local_origin_text.Len() > 0:
        mem.Free(_local_origin_text as void*)
    end
    _local_origin_text = ""
end

@en "CurrentConfig"
@fa "پیکربندی فعلی"
pub func CurrentConfig(): Config:
    ret _cfg
end

@en "DataDir"
@fa "پوشه داده"
pub func DataDir(): str:
    id := _cfg.id.Len() > 0 ? _cfg.id : "ir.salamlang.app"
    if SALAM_OS_WINDOWS:
        ret filepath.Join(user.CacheDir(), id)
    else SALAM_OS_MAC:
        ret filepath.Join(user.HomeDir(), "Library/Application Support/".Concat(id))
    else:
        xdg := os.Env("XDG_DATA_HOME")
        if str.Len(xdg) > 0:
            base := filepath.Join(xdg, id)
            mem.Free(xdg as void*)
            ret base
        end
        mem.Free(xdg as void*)
        ret filepath.Join(user.HomeDir(), ".local/share/".Concat(id))
    end
end

@en "Allow"
@fa "اجازه دادن"
pub func Allow(origin: str, commands: Vector<str>):
    normalized := OriginOf(origin)
    _rules.Push(_Rule { origin = normalized, patterns = commands })
end

@en "Command"
@fa "فرمان"
pub func Command(name: str, handler: func (Call)):
    if name.Len() == 0:
        ret
    end
    _commands.Push(_Command { name = str.Clone(name), handler = handler })
end

@en "CommandAsync"
@fa "فرمان ناهمگام"
pub func CommandAsync(name: str, handler: func (Call)):
    if name.Len() == 0:
        ret
    end
    _commands.Push(_Command { name = str.Clone(name), handler = handler, threaded = true })
end

@en "On"
@fa "هنگام رویداد"
pub func On(event: str, handler: func (str)):
    _listeners.Push(_Listener { name = str.Clone(event), handler = handler })
end

@en "Emit"
@fa "رویداد فرستادن"
pub func Emit(event: str, raw_json: str = "null"):
    sync.Lock(_pending_lock)
    count := _wins.Len()
    sync.Unlock(_pending_lock)
    repeat count in i:
        _emit_to(i, event, raw_json)
    end
end

@en "AssetURL"
@fa "نشانی دارایی"
pub func AssetURL(path: str): str:
    ret SchemeURL(_cfg.scheme, path)
end

@en "Open"
@fa "باز کردن"
pub func Open(options: WindowOptions): Window:
    _startup()
    view := Create(_cfg.debug, false)
    if view.IsClosed():
        ret Window {}
    end
    index := _wins.Len()
    mut start := options.url
    if start.Len() == 0 and options.html.Len() == 0:
        start = AssetURL("/index.html")
    end
    sync.Lock(_pending_lock)
    _wins.Push(
        _Win {
            label = str.Clone(options.label), view = view, start_origin = start.Len() > 0 ? OriginOf(start) : str.Clone("null"),
            inline_html = options.html.Len() > 0, allow_navigation = options.allow_navigation
        }
    )
    sync.Unlock(_pending_lock)
    if options.title.Len() > 0:
        view.SetTitle(options.title)
    end
    view.SetSize(options.width, options.height, options.resizable ? HINT_NONE : HINT_FIXED)
    if options.min_width > 0 or options.min_height > 0:
        view.SetMinSize(options.min_width, options.min_height)
    end
    if options.icon.Len() > 0:
        view.SetIcon(options.icon)
    end
    if not options.context_menu:
        view.SetContextMenu(false)
    end
    if not options.devtools_enabled:
        view.SetDevToolsEnabled(false)
    end
    if not options.translate_enabled:
        view.SetTranslateEnabled(false)
    end
    bridge := _bridge_script(index)
    view.Init(bridge)
    mem.Free(bridge as void*)
    each script in options.scripts:
        view.Init(script, true)
    end
    view.OnMessage((text: str): _on_message(index, text) end)
    view.OnNavigate((url: str): ret _on_navigate(index, url) end)
    view.OnNewWindow((url: str): _on_new_window(url) end)
    if options.center:
        view.Center()
    end
    if options.html.Len() > 0:
        view.SetHTML(options.html)
    else:
        view.Navigate(start)
    end
    if options.always_on_top:
        // Best-effort: record request; backend hook is not uniformly available.
        sync.Lock(_pending_lock)
        if index >= 0 and index < _wins.Len():
            mut w := _wins[index]
            w.always_on_top_requested = true
            w.always_on_top_applied = false
            _wins[index] = w
        end
        sync.Unlock(_pending_lock)
        Trace("WindowOptions.always_on_top requested but not applied: backend support unavailable")
    end
    if options.fullscreen:
        sync.Lock(_pending_lock)
        if index >= 0 and index < _wins.Len():
            mut w := _wins[index]
            w.fullscreen_requested = true
            _wins[index] = w
        end
        sync.Unlock(_pending_lock)
        view.Maximize()
    end
    if options.visible:
        view.Show()
    end
    ret Window { index = index }
end

@en "GetWindow"
@fa "گرفتن پنجره"
pub func GetWindow(label: str): Window:
    repeat _wins.Len() in i:
        if _wins[i].label == label:
            ret Window { index = i }
        end
    end
    ret Window {}
end

@en "WindowByLabel"
@fa "پنجره با برچسب"
pub func WindowByLabel(label: str): Window:
    ret GetWindow(label)
end

@en "WindowCount"
@fa "شمار پنجره ها"
pub func WindowCount(): int:
    sync.Lock(_pending_lock)
    n := _wins.Len()
    sync.Unlock(_pending_lock)
    ret n
end

@en "FirstWindow"
@fa "نخستین پنجره"
pub func FirstWindow(): Window:
    sync.Lock(_pending_lock)
    empty := _wins.Len() == 0
    sync.Unlock(_pending_lock)
    if empty:
        ret Window {}
    end
    ret Window { index = 0 }
end

func _emit_app_event(name: str, window: int = -1, payload: str = "null"):
    // In-process lightweight hook dispatch and web bridge broadcast.
    if name == "ready":
        if not _app_ready_fired:
            _app_ready_fired = true
            _on_app_ready()
        end
    else name == "activate":
        _on_app_activate()
    else name == "before-quit":
        // Caller decides whether to proceed based on return value helper.
        ret
    else name == "quit":
        _on_quit()
    else name == "window-all-closed":
        _on_window_all_closed()
    end
    Emit("__app:".Concat(name), payload)
    _keep_window := window
end

func _fire_ready_once():
    if _app_ready_fired:
        ret
    end
    _emit_app_event("ready")
end

func _check_window_all_closed():
    if _quitting:
        ret
    end
    if WindowCount() == 0:
        _emit_app_event("window-all-closed")
    end
end

@en "OnReady"
@fa "هنگام آماده شدن"
pub func OnReady(handler: func ()):
    _on_app_ready = handler
    if _app_ready_fired:
        handler()
    end
end

@en "OnActivate"
@fa "هنگام فعال شدن"
pub func OnActivate(handler: func ()):
    _on_app_activate = handler
end

@en "OnBeforeQuit"
@fa "پیش از خروج"
pub func OnBeforeQuit(handler: func () bool):
    _on_before_quit = handler
end

@en "OnQuit"
@fa "هنگام خروج"
pub func OnQuit(handler: func ()):
    _on_quit = handler
end

@en "OnWindowAllClosed"
@fa "هنگام بسته شدن همه پنجره ها"
pub func OnWindowAllClosed(handler: func ()):
    _on_window_all_closed = handler
end

@en "OnDeepLink"
@fa "هنگام پیوند عمیق"
pub func OnDeepLink(handler: func (str)):
    _on_deep_link = handler
end

@en "OnSecondInstance"
@fa "هنگام نمونه دوم"
pub func OnSecondInstance(handler: func (Vector<str>)):
    _on_single_instance = handler
end

@en "HandleDeepLink"
@fa "پردازش پیوند عمیق"
pub func HandleDeepLink(url: str):
    if url.Len() == 0:
        ret
    end
    _on_deep_link(url)
    encoded := json.Str(url)
    Emit("__app:deep-link", encoded)
    mem.Free(encoded as void*)
end

@en "HandleSecondInstanceArgs"
@fa "پردازش آرگومان های نمونه دوم"
pub func HandleSecondInstanceArgs(args: Vector<str>):
    _on_single_instance(args)
    url := FirstURLArg(args)
    if url.Len() > 0:
        HandleDeepLink(url)
        mem.Free(url as void*)
    end
    _emit_app_event("activate")
end

@en "RegisterProtocol"
@fa "ثبت پروتکل"
pub func RegisterProtocol(name: str, handler: func (Request) Response): ProtocolRegistration:
    ret RegisterAppProtocol(name, handler)
end

@en "RegisterDeepLinkProtocol"
@fa "ثبت پروتکل پیوند عمیق"
pub func RegisterDeepLinkProtocol(name: str, handler: func (str)):
    _on_deep_link = handler
    // Best-effort: register a scheme so custom URL navigations can be observed/routed.
    _ignored := RegisterProtocol(
        name, (req: Request): Response
        HandleDeepLink(req.url) ret Response { status = 204, mime = "text/plain" } end
    )
end

@en "RegisterProtocolHandler"
@fa "ثبت گرداننده پروتکل"
pub func RegisterProtocolHandler(name: str, handler: func (Request) Response): ProtocolRegistration:
    // Alias for protocol registration with explicit handler intent.
    ret RegisterProtocol(name, handler)
end

@en "HandleDeepLinkURL"
@fa "پردازش نشانی پیوند عمیق"
pub func HandleDeepLinkURL(url: str):
    HandleDeepLink(url)
end

@en "SetActivationHandlers"
@fa "تنظیم گرداننده های فعال سازی"
pub func SetActivationHandlers(on_deep_link: func (str), on_second_instance: func (Vector<str>)):
    OnDeepLink(on_deep_link)
    OnSecondInstance(on_second_instance)
end

@en "LifecycleState"
@fa "وضعیت چرخه حیات"
pub struct LifecycleState:
    @en "ready"
    @fa "آماده"
    pub ready: bool = false
    @en "quitting"
    @fa "در حال خروج"
    pub quitting: bool = false
    @en "window_count"
    @fa "شمار پنجره ها"
    pub window_count: int = 0
end

@en "AppLifecycleState"
@fa "وضعیت چرخه حیات برنامه"
pub func AppLifecycleState(): LifecycleState:
    ret LifecycleState { ready = _app_ready_fired, quitting = _quitting, window_count = WindowCount() }
end

@en "IsAppReady"
@fa "برنامه آماده است"
pub func IsAppReady(): bool:
    ret _app_ready_fired
end

@en "IsAppQuitting"
@fa "برنامه در حال خروج است"
pub func IsAppQuitting(): bool:
    ret _quitting
end

@en "EmitLifecycleEvent"
@fa "فرستادن رویداد چرخه حیات"
pub func EmitLifecycleEvent(name: str, payload: str = "null"):
    Emit("__app:".Concat(name), payload)
end

@en "ActivateApp"
@fa "فعال کردن برنامه"
pub func ActivateApp():
    w := FirstWindow()
    if not w.IsClosed():
        w.Activate()
    end
    _emit_app_event("activate")
end

@en "QuitApp"
@fa "خروج از برنامه"
pub func QuitApp(): bool:
    if _quitting:
        ret true
    end
    if not _on_before_quit():
        ret false
    end
    _quitting = true
    Quit()
    _emit_app_event("quit")
    ret true
end

@en "Run"
@fa "اجرا"
pub func Run():
    _fire_ready_once()
    // Process any deep-link-like argv in the primary instance as a best-effort
    // activation hook (platform protocol registration is host/installer specific).
    args := os.Args()
    HandleSecondInstanceArgs(args)
    args.Free()
    RunAll()
    _check_window_all_closed()
    if not _quitting:
        _quitting = true
        _emit_app_event("quit")
    end
end
