package webview

import str
import mem
import os
import filepath
import crypto
import sync
import pool
import gui.webview.pack
import encoding.json
import net.mime
import os.user
import os.shell
import fs
import fs.file
import io

mut _cfg := Config {}
mut _inited := false
mut _token := ""
mut _wins := Vector {} as Vector<_Win>
mut _commands := Vector {} as Vector<_Command>
mut _rules := Vector {} as Vector<_Rule>
mut _listeners := Vector {} as Vector<_Listener>
mut _pending := HashMap {} as HashMap<i64, _Owned>
mut _pending_lock := sync.NewMutex()
mut _call_serial := 0 as i64
mut _local_origin_text := ""

struct _Win:
    pub label: str = ""
    pub view: WebView = WebView {}
    pub start_origin: str = ""
    pub inline_html: bool = false
    pub allow_navigation: Vector<str> = Vector {}
end

struct _Owned:
    pub command: str = ""
    pub args: str = ""
    pub origin: str = ""
    pub id: str = ""
end

struct _Command:
    pub name: str = ""
    pub handler: func (Call)
    pub threaded: bool = false
end

struct _Rule:
    pub origin: str = ""
    pub patterns: Vector<str> = Vector {}
end

struct _Listener:
    pub name: str = ""
    pub handler: func (str)
end

@en "Config"
@fa "پیکربندی"
pub struct Config:
    @en "id"
    @fa "شناسه"
    pub id: str = ""
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "version"
    @fa "نگارش"
    pub version: str = ""
    @en "icon"
    @fa "نماد"
    pub icon: str = ""
    @en "scheme"
    @fa "طرح"
    pub scheme: str = "app"
    @en "assets_dir"
    @fa "پوشه دارایی ها"
    pub assets_dir: str = ""
    @en "pack_path"
    @fa "مسیر فشرده"
    pub pack_path: str = ""
    @en "csp"
    @fa "سیاست محتوا"
    pub csp: str = ""
    @en "spa"
    @fa "تک صفحه ای"
    pub spa: bool = false
    @en "debug"
    @fa "اشکال زدایی"
    pub debug: bool = false
    @en "external_links"
    @fa "پیوندهای بیرونی"
    pub external_links: bool = true
end

