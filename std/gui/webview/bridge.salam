package webview

const _BRIDGE_JS := `(function(){
var A=%ORIGINS%;
if(window.top!==window||A.indexOf(location.origin)<0)return;
if(window.__salamBridge)return;
var T=%TOKEN%,post=%POST%,seq=0,pend=new Map(),subs=new Map();
function send(kind,body){body.t=T;body.k=kind;post(JSON.stringify(body));}
var api=Object.freeze({
invoke:function(cmd,args){return new Promise(function(res,rej){var id=++seq;pend.set(id,[res,rej]);send("call",{id:id,cmd:String(cmd),args:args===undefined?{}:args});});},
listen:function(name,fn){var s=subs.get(name);if(!s){s=new Set();subs.set(name,s);}s.add(fn);return function(){s.delete(fn);};},
emit:function(name,data){send("emit",{name:String(name),data:data===undefined?null:data});}
});
Object.defineProperty(window,"salam",{value:api,enumerable:true});
Object.defineProperty(window,"__salamBridge",{value:Object.freeze({
reply:function(id,ok,value){var p=pend.get(id);if(!p)return;pend.delete(id);if(ok)p[0](value);else p[1](new Error(value));},
event:function(name,data){var s=subs.get(name);if(s)s.forEach(function(fn){try{fn(data);}catch(e){console.error(e);}});}
})});
})();`
