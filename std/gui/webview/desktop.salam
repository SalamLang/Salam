@en "desktop"
@fa "رومیزی"
package webview

import gui.notify as notify
import gui.drop as drop
import gui.clipboard as clipboard
import gui.shortcut as shortcut
import sync

func _window_ok(window: Window): bool:
    ret window.index >= 0 and window.index < _wins.Len()
end

// -------- Notification bridge (richer API on top of system notify) --------

@en "NotifySimple"
@fa "اعلان ساده"
pub func NotifySimple(title: str, body: str): str:
    ret notify.Send(title, body)
end

@en "NotifyRich"
@fa "اعلان کامل"
pub func NotifyRich(note: notify.Notification): str:
    ret notify.Show(note)
end

@en "NotifyInfo"
@fa "اعلان اطلاع"
pub func NotifyInfo(title: str, body: str): str:
    ret notify.Show(notify.Info(title, body))
end

@en "NotifyWarning"
@fa "اعلان هشدار"
pub func NotifyWarning(title: str, body: str): str:
    ret notify.Show(notify.Warning(title, body))
end

@en "NotifyError"
@fa "اعلان خطا"
pub func NotifyError(title: str, body: str): str:
    ret notify.Show(notify.Error(title, body))
end

@en "NotifyUpdate"
@fa "به‌روزرسانی اعلان"
pub func NotifyUpdate(note: notify.Notification): bool:
    ret notify.Update(note)
end

@en "NotifyClose"
@fa "بستن اعلان"
pub func NotifyClose(id: str): bool:
    ret notify.Close(id)
end

@en "NotifyCloseAll"
@fa "بستن همه اعلان ها"
pub func NotifyCloseAll():
    notify.CloseAll()
end

@en "NotifyOnClick"
@fa "هنگام کلیک اعلان"
pub func NotifyOnClick(handler: func (str)):
    notify.OnClick(handler)
end

@en "NotifyOnAction"
@fa "هنگام کنش اعلان"
pub func NotifyOnAction(handler: func (str, str)):
    notify.OnAction(handler)
end

@en "NotifyPermission"
@fa "اجازه اعلان"
pub func NotifyPermission(): notify.Permission:
    ret notify.PermissionStatus()
end

@en "NotifyRequestPermission"
@fa "درخواست اجازه اعلان"
pub func NotifyRequestPermission(): notify.Permission:
    ret notify.RequestPermission()
end

// -------- Clipboard convenience bridge --------

@en "ClipboardText"
@fa "متن بریده دان"
pub func ClipboardText(): str:
    ret clipboard.GetText()
end

@en "SetClipboardText"
@fa "تنظیم متن بریده دان"
pub func SetClipboardText(text: str): bool:
    ret clipboard.SetText(text)
end

@en "ClipboardHasText"
@fa "بریده دان متن دارد"
pub func ClipboardHasText(): bool:
    ret clipboard.HasText()
end

@en "ClearClipboard"
@fa "پاک کردن بریده دان"
pub func ClearClipboard(): bool:
    ret clipboard.Clear()
end

// -------- Shortcut convenience bridge --------

@en "NormalizeShortcut"
@fa "نرمال سازی میانبر"
pub func NormalizeShortcut(accelerator: str): str:
    ret shortcut.Normalize(accelerator)
end

@en "ParseShortcut"
@fa "تجزیه میانبر"
pub func ParseShortcut(accelerator: str): shortcut.Accelerator:
    ret shortcut.Parse(accelerator)
end

@en "RegisterShortcut"
@fa "ثبت میانبر"
pub func RegisterShortcut(accelerator: str): shortcut.Registration:
    ret shortcut.Register(accelerator)
end

@en "UnregisterShortcut"
@fa "لغو ثبت میانبر"
pub func UnregisterShortcut(id: int): bool:
    ret shortcut.Unregister(id)
end

// -------- Window convenience helpers --------

@en "WindowSetTitle"
@fa "تنظیم عنوان پنجره"
pub func WindowSetTitle(window: Window, title: str):
    if _window_ok(window):
        window.SetTitle(title)
    end
end

@en "WindowSetIcon"
@fa "تنظیم نماد پنجره"
pub func WindowSetIcon(window: Window, path: str):
    if _window_ok(window):
        window.SetIcon(path)
    end
end

@en "WindowBringToFront"
@fa "آوردن پنجره به جلو"
pub func WindowBringToFront(window: Window):
    if _window_ok(window):
        window.BringToFront()
    end
end

@en "WindowRequestAttention"
@fa "درخواست توجه پنجره"
pub func WindowRequestAttention(window: Window):
    if _window_ok(window):
        RequestAttention(window)
    end
end

@en "WindowFocus"
@fa "تمرکز پنجره"
pub func WindowFocus(window: Window):
    if _window_ok(window):
        window.Focus()
    end
end

@en "WindowShow"
@fa "نمایش پنجره"
pub func WindowShow(window: Window):
    if _window_ok(window):
        window.Show()
    end
end

@en "WindowHide"
@fa "پنهان کردن پنجره"
pub func WindowHide(window: Window):
    if _window_ok(window):
        window.Hide()
    end
end

@en "WindowToggleVisible"
@fa "جابجایی نمایانی پنجره"
pub func WindowToggleVisible(window: Window):
    if _window_ok(window):
        window.ToggleVisible()
    end
end

@en "WindowActivate"
@fa "فعال کردن پنجره"
pub func WindowActivate(window: Window):
    if _window_ok(window):
        window.Activate()
    end
end

// -------- Tray/menu and app lifecycle bridges --------

@en "MenuItemAction"
@fa "مورد کنش منو"
pub func MenuItemAction(id: str, label: str): MenuItem:
    ret Item(id, label)
end

@en "TrayUpdate"
@fa "به‌روزرسانی سینی"
pub func TrayUpdate(icon: str, tooltip: str, items: Vector<MenuItem>): bool:
    ret UpdateTray(icon, tooltip, items)
end

@en "OnTrayMenuAction"
@fa "هنگام کنش منوی سینی"
pub func OnTrayMenuAction(handler: func (str)):
    OnTrayMenu(handler)
end

@en "OnTrayActivated"
@fa "هنگام فعال شدن سینی"
pub func OnTrayActivated(handler: func ()):
    OnTrayClick(handler)
end

@en "OnAppReady"
@fa "هنگام آماده شدن برنامه"
pub func OnAppReady(handler: func ()):
    OnReady(handler)
end

@en "OnAppActivate"
@fa "هنگام فعال شدن برنامه"
pub func OnAppActivate(handler: func ()):
    OnActivate(handler)
end

@en "OnAppDeepLink"
@fa "هنگام پیوند عمیق برنامه"
pub func OnAppDeepLink(handler: func (str)):
    OnDeepLink(handler)
end

@en "OnAppSecondInstance"
@fa "هنگام نمونه دوم برنامه"
pub func OnAppSecondInstance(handler: func (Vector<str>)):
    OnSecondInstance(handler)
end

@en "BeforeQuit"
@fa "پیش از خروج"
pub func BeforeQuit(handler: func () bool):
    OnBeforeQuit(handler)
end

@en "OnAppQuit"
@fa "هنگام خروج برنامه"
pub func OnAppQuit(handler: func ()):
    OnQuit(handler)
end

@en "OnAllWindowsClosed"
@fa "هنگام بسته شدن همه پنجره ها"
pub func OnAllWindowsClosed(handler: func ()):
    OnWindowAllClosed(handler)
end

@en "EnsureSingleInstance"
@fa "اطمینان از نمونه یکتا"
pub func EnsureSingleInstance(on_second: func (Vector<str>) = (_args: Vector<str>): ret end): bool:
    ret SingleInstanceActivate(on_second)
end

// -------- Drag & drop bridge for Window/WebView handles --------

@en "EnableDrop"
@fa "فعال کردن رها کردن"
pub func EnableDrop(window: Window): bool:
    if window.index < 0 or window.index >= _wins.Len():
        ret false
    end
    native := _wins[window.index].view.Native()
    ret drop.Enable(native)
end

@en "DisableDrop"
@fa "غیرفعال کردن رها کردن"
pub func DisableDrop(window: Window):
    if window.index < 0 or window.index >= _wins.Len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.Disable(native)
end

@en "SetDropHandlers"
@fa "تنظیم گرداننده های رها کردن"
pub func SetDropHandlers(window: Window, handlers: drop.DropHandlers):
    if window.index < 0 or window.index >= _wins.Len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.SetHandlers(native, handlers)
end

@en "OnWindowDrop"
@fa "هنگام رها کردن پنجره"
pub func OnWindowDrop(window: Window, handler: func (drop.DropEvent)):
    if window.index < 0 or window.index >= _wins.Len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.OnDrop(native, handler)
end

@en "OnWindowDragEnter"
@fa "هنگام ورود کشیدن پنجره"
pub func OnWindowDragEnter(window: Window, handler: func (drop.DropEvent) drop.DropEvent):
    if window.index < 0 or window.index >= _wins.Len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.OnDragEnter(native, handler)
end

@en "OnWindowDragOver"
@fa "هنگام عبور کشیدن پنجره"
pub func OnWindowDragOver(window: Window, handler: func (drop.DropEvent) drop.DropEvent):
    if window.index < 0 or window.index >= _wins.Len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.OnDragOver(native, handler)
end

@en "OnWindowDragLeave"
@fa "هنگام خروج کشیدن پنجره"
pub func OnWindowDragLeave(window: Window, handler: func ()):
    if window.index < 0 or window.index >= _wins.Len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.OnDragLeave(native, handler)
end

@en "AttachDrop"
@fa "اتصال رها کردن"
pub func AttachDrop(window: Window, handlers: drop.DropHandlers): bool:
    if window.index < 0 or window.index >= _wins.Len():
        ret false
    end
    native := _wins[window.index].view.Native()
    ret drop.Attach(native, handlers)
end

@en "DetachDrop"
@fa "جدا کردن رها کردن"
pub func DetachDrop(window: Window):
    if window.index < 0 or window.index >= _wins.Len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.Detach(native)
end

@en "IsDropEnabled"
@fa "رها کردن فعال است"
pub func IsDropEnabled(window: Window): bool:
    if window.index < 0 or window.index >= _wins.Len():
        ret false
    end
    native := _wins[window.index].view.Native()
    ret drop.IsEnabled(native)
end

@en "DropSupported"
@fa "رها کردن پشتیبانی می‌شود"
pub func DropSupported(): bool:
    ret drop.Supported()
end

@en "NotifySupported"
@fa "اعلان پشتیبانی می‌شود"
pub func NotifySupported(): bool:
    ret notify.IsSupported()
end

@en "ClipboardSupported"
@fa "بریده‌دان پشتیبانی می‌شود"
pub func ClipboardSupported(): bool:
    ret clipboard.IsSupported()
end

@en "ShortcutSupported"
@fa "میانبر پشتیبانی می‌شود"
pub func ShortcutSupported(): bool:
    ret shortcut.IsSupported()
end
