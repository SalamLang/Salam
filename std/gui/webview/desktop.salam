@en "desktop"
@fa "رومیزی"
package webview

import gui.notify as notify
import gui.drop as drop

// -------- Notification bridge (richer API on top of system notify) --------

@en "NotifySimple"
@fa "اعلان ساده"
pub func NotifySimple(title: str, body: str): str:
    ret notify.Send(title, body)
end

@en "NotifyRich"
@fa "اعلان کامل"
pub func NotifyRich(note: notify.Notification): str:
    ret notify.Show(note)
end

@en "NotifyInfo"
@fa "اعلان اطلاع"
pub func NotifyInfo(title: str, body: str): str:
    ret notify.Show(notify.Info(title, body))
end

@en "NotifyWarning"
@fa "اعلان هشدار"
pub func NotifyWarning(title: str, body: str): str:
    ret notify.Show(notify.Warning(title, body))
end

@en "NotifyError"
@fa "اعلان خطا"
pub func NotifyError(title: str, body: str): str:
    ret notify.Show(notify.Error(title, body))
end

@en "NotifyUpdate"
@fa "به‌روزرسانی اعلان"
pub func NotifyUpdate(note: notify.Notification): bool:
    ret notify.Update(note)
end

@en "NotifyClose"
@fa "بستن اعلان"
pub func NotifyClose(id: str): bool:
    ret notify.Close(id)
end

@en "NotifyCloseAll"
@fa "بستن همه اعلان ها"
pub func NotifyCloseAll():
    notify.CloseAll()
end

@en "NotifyOnClick"
@fa "هنگام کلیک اعلان"
pub func NotifyOnClick(handler: func (str)):
    notify.OnClick(handler)
end

@en "NotifyOnAction"
@fa "هنگام کنش اعلان"
pub func NotifyOnAction(handler: func (str, str)):
    notify.OnAction(handler)
end

@en "NotifyPermission"
@fa "اجازه اعلان"
pub func NotifyPermission(): notify.Permission:
    ret notify.PermissionStatus()
end

@en "NotifyRequestPermission"
@fa "درخواست اجازه اعلان"
pub func NotifyRequestPermission(): notify.Permission:
    ret notify.RequestPermission()
end

// -------- Drag & drop bridge for Window/WebView handles --------

@en "EnableDrop"
@fa "فعال کردن رها کردن"
pub func EnableDrop(window: Window): bool:
    if window.index < 0 or window.index >= _wins.len():
        ret false
    end
    native := _wins[window.index].view.Native()
    ret drop.Enable(native)
end

@en "DisableDrop"
@fa "غیرفعال کردن رها کردن"
pub func DisableDrop(window: Window):
    if window.index < 0 or window.index >= _wins.len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.Disable(native)
end

@en "SetDropHandlers"
@fa "تنظیم گرداننده های رها کردن"
pub func SetDropHandlers(window: Window, handlers: drop.DropHandlers):
    if window.index < 0 or window.index >= _wins.len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.SetHandlers(native, handlers)
end

@en "OnWindowDrop"
@fa "هنگام رها کردن پنجره"
pub func OnWindowDrop(window: Window, handler: func (drop.DropEvent)):
    if window.index < 0 or window.index >= _wins.len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.OnDrop(native, handler)
end

@en "OnWindowDragEnter"
@fa "هنگام ورود کشیدن پنجره"
pub func OnWindowDragEnter(window: Window, handler: func (drop.DropEvent) drop.DropEvent):
    if window.index < 0 or window.index >= _wins.len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.OnDragEnter(native, handler)
end

@en "OnWindowDragOver"
@fa "هنگام عبور کشیدن پنجره"
pub func OnWindowDragOver(window: Window, handler: func (drop.DropEvent) drop.DropEvent):
    if window.index < 0 or window.index >= _wins.len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.OnDragOver(native, handler)
end

@en "OnWindowDragLeave"
@fa "هنگام خروج کشیدن پنجره"
pub func OnWindowDragLeave(window: Window, handler: func ()):
    if window.index < 0 or window.index >= _wins.len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.OnDragLeave(native, handler)
end

@en "AttachDrop"
@fa "اتصال رها کردن"
pub func AttachDrop(window: Window, handlers: drop.DropHandlers): bool:
    if window.index < 0 or window.index >= _wins.len():
        ret false
    end
    native := _wins[window.index].view.Native()
    ret drop.Attach(native, handlers)
end

@en "DetachDrop"
@fa "جدا کردن رها کردن"
pub func DetachDrop(window: Window):
    if window.index < 0 or window.index >= _wins.len():
        ret
    end
    native := _wins[window.index].view.Native()
    drop.Detach(native)
end
