@en "dialog"
@fa "گفتگو"
package webview

import str
import mem

// Message kinds for dialogs (best-effort mapped per platform).
pub const MESSAGE_INFO := 0
pub const MESSAGE_WARNING := 1
pub const MESSAGE_ERROR := 2
pub const MESSAGE_QUESTION := 3

@en "FileFilter"
@fa "صافی پرونده"
pub struct FileFilter:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "patterns"
    @fa "الگوها"
    pub patterns: str = ""
end

@en "OpenDialogOptions"
@fa "گزینه های گفتگوی باز کردن"
pub struct OpenDialogOptions:
    @en "title"
    @fa "عنوان"
    pub title: str = "Open"
    @en "default_path"
    @fa "مسیر پیش فرض"
    pub default_path: str = ""
    @en "filter_name"
    @fa "نام صافی"
    pub filter_name: str = ""
    @en "patterns"
    @fa "الگوها"
    pub patterns: str = ""
    @en "filters"
    @fa "صافی ها"
    pub filters: Vector<FileFilter> = Vector {}
    @en "multiple"
    @fa "چندگانه"
    pub multiple: bool = false
    @en "directory"
    @fa "پوشه"
    pub directory: bool = false
end

@en "SaveDialogOptions"
@fa "گزینه های گفتگوی ذخیره"
pub struct SaveDialogOptions:
    @en "title"
    @fa "عنوان"
    pub title: str = "Save"
    @en "default_name"
    @fa "نام پیش فرض"
    pub default_name: str = ""
    @en "default_path"
    @fa "مسیر پیش فرض"
    pub default_path: str = ""
    @en "filter_name"
    @fa "نام صافی"
    pub filter_name: str = ""
    @en "patterns"
    @fa "الگوها"
    pub patterns: str = ""
    @en "filters"
    @fa "صافی ها"
    pub filters: Vector<FileFilter> = Vector {}
end

@en "MessageDialogOptions"
@fa "گزینه های گفتگوی پیام"
pub struct MessageDialogOptions:
    @en "title"
    @fa "عنوان"
    pub title: str = ""
    @en "text"
    @fa "متن"
    pub text: str = ""
    @en "kind"
    @fa "گونه"
    pub kind: int = MESSAGE_INFO
    @en "ok_label"
    @fa "برچسب تایید"
    pub ok_label: str = "OK"
    @en "cancel_label"
    @fa "برچسب انصراف"
    pub cancel_label: str = "Cancel"
end

func _first_filter(options: OpenDialogOptions): FileFilter:
    if options.filters.Len() > 0:
        ret options.filters[0]
    end
    ret FileFilter { name = options.filter_name, patterns = options.patterns }
end

func _first_save_filter(options: SaveDialogOptions): FileFilter:
    if options.filters.Len() > 0:
        ret options.filters[0]
    end
    ret FileFilter { name = options.filter_name, patterns = options.patterns }
end

@en "Filter"
@fa "صافی"
pub func Filter(name: str, patterns: str): FileFilter:
    ret FileFilter { name = str.Clone(name), patterns = str.Clone(patterns) }
end

@en "OpenFileDialog"
@fa "گفتگوی باز کردن پرونده"
pub func OpenFileDialog(options: OpenDialogOptions): str:
    if options.directory:
        ret PickFolder(options.title.Len() > 0 ? options.title : "Select a folder")
    end
    f := _first_filter(options)
    ret PickFile(options.title, f.name, f.patterns)
end

@en "OpenFilesDialog"
@fa "گفتگوی باز کردن پرونده ها"
pub func OpenFilesDialog(options: OpenDialogOptions): Vector<str>:
    mut out := Vector {} as Vector<str>
    // Best-effort: native backends currently expose single-file pickers in many
    // builds. Return a vector with the selected path when available.
    one := OpenFileDialog(options)
    if one.Len() > 0:
        out.Push(one)
    else:
        mem.Free(one as void*)
    end
    ret out
end

@en "SelectFolderDialog"
@fa "گفتگوی انتخاب پوشه"
pub func SelectFolderDialog(title: str = "Select a folder"): str:
    ret PickFolder(title)
end

@en "SelectDirectoryDialog"
@fa "گفتگوی انتخاب شاخه"
pub func SelectDirectoryDialog(title: str = "Select a folder"): str:
    ret PickFolder(title)
end

@en "SaveFileDialog"
@fa "گفتگوی ذخیره پرونده"
pub func SaveFileDialog(options: SaveDialogOptions): str:
    f := _first_save_filter(options)
    _keep_name := f.name
    _keep_patterns := f.patterns
    // Underlying save picker may ignore filters/default path on some platforms.
    ret SaveFile(options.title, options.default_name)
end

@en "MessageDialog"
@fa "گفتگوی پیام"
pub func MessageDialog(options: MessageDialogOptions):
    mut title := options.title
    if title.Len() == 0:
        if options.kind == MESSAGE_WARNING:
            title = "Warning"
        else options.kind == MESSAGE_ERROR:
            title = "Error"
        else options.kind == MESSAGE_QUESTION:
            title = "Confirm"
        else:
            title = "Message"
        end
    end
    if options.kind == MESSAGE_QUESTION:
        _ok := Confirm(title, options.text)
    else:
        Message(title, options.text)
    end
end

@en "Alert"
@fa "هشدار"
pub func Alert(title: str, text: str):
    Message(title, text)
end

@en "Info"
@fa "اطلاع"
pub func Info(title: str, text: str):
    Message(title.Len() > 0 ? title : "Info", text)
end

@en "Warning"
@fa "هشدار پیام"
pub func Warning(title: str, text: str):
    Message(title.Len() > 0 ? title : "Warning", text)
end

@en "Error"
@fa "خطا"
pub func Error(title: str, text: str):
    Message(title.Len() > 0 ? title : "Error", text)
end

@en "Ask"
@fa "پرسش"
pub func Ask(title: str, text: str): bool:
    ret Confirm(title.Len() > 0 ? title : "Confirm", text)
end
