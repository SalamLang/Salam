        script := make(
            alloc, sel_registerName("initWithSource:injectionTime:forMainFrameOnly:"), ns_string(js),
            0 as i64, all_frames ? 0 as i8 : 1 as i8
        )
        controller := _mac_call0(_mac_view(id).config, "userContentController")
        _mac_call1(controller, "addUserScript:", script)
    end

    func _wv_bk_url(id: int): str:
        url := _mac_call0(_mac_view(id).webview, "URL")
