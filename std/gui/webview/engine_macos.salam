    end

    func _wv_bk_hide(id: int):
        _mac_call1(_mac_view(id).window, "orderOut:", null)
    end

    func _wv_bk_focus(id: int):
        _mac_call_b(_mac_app, "activateIgnoringOtherApps:", true)
        _mac_call1(_mac_view(id).window, "makeKeyAndOrderFront:", null)
    end

    func _wv_bk_minimize(id: int):
        _mac_call1(_mac_view(id).window, "miniaturize:", null)
    end

    func _wv_bk_maximize(id: int):
        _mac_call1(_mac_view(id).window, "zoom:", null)
    end

    func _wv_bk_center(id: int):
        _mac_call0(_mac_view(id).window, "center")
    end

    func _wv_bk_is_active(id: int): bool:
        ret _mac_bool0(_mac_view(id).window, "isKeyWindow")
    end

    func _wv_bk_native(id: int): void*:
        ret _mac_view(id).window
    end

    func _wv_bk_devtools(id: int):
        webview := _mac_view(id).webview
        if _mac_bool_sel(webview, "setInspectable:"):
            _mac_call_b(webview, "setInspectable:", true)
        end
    end

    func _mac_bool_sel(recv: void*, name: str): bool:
        fn := (&objc_msgSend) as extern func (void*, void*, void*) i8
        ret fn(recv, sel_registerName("respondsToSelector:"), sel_registerName(name)) != (0 as i8)
    end

    func _wv_bk_context_menu(id: int, enabled: bool):
        mut v := _mac_views[id]
        v.context_menu = enabled
        _mac_views[id] = v
    end

    func _wv_bk_set_devtools_enabled(id: int, enabled: bool):
        webview := _mac_view(id).webview
        if _mac_bool_sel(webview, "setInspectable:"):
            _mac_call_b(webview, "setInspectable:", enabled)
        end
    end

    func _wv_bk_set_translate_enabled(_id: int, _enabled: bool):
        _wv_touch()
    end

    func _wv_bk_register_scheme(_name: str):
        _wv_touch()
    end

    func _wv_bk_content(id: int): void*:
        ret _mac_view(id).window
    end

    func _wv_bk_menu_host(): void*:
        _mac_startup()
        ret _mac_app_delegate
    end

    func _wv_bk_name_message_window(_title: str):
        _wv_touch()
    end

    func _wv_bk_scheme_origin(name: str): str:
        ret name.Concat("://localhost")
    end

    func _wv_bk_post_script(): str:
        ret str.Clone("(s)=>window.webkit.messageHandlers.salam.postMessage(s)")
    end
end
