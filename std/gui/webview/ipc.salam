/*
 * Salam Programming Language (2024-2026)
 */

@en "ipc"
@fa "ارتباط بین پردازه ای"
package webview

import str
import mem
import encoding.json

@en "ActivationPayload"
@fa "بار فعال سازی"
pub struct ActivationPayload:
    @en "source"
    @fa "منبع"
    pub source: str = "unknown"
    @en "args"
    @fa "آرگومان ها"
    pub args: Vector<str> = Vector {}
    @en "url"
    @fa "نشانی"
    pub url: str = ""
    @en "raw"
    @fa "خام"
    pub raw: str = ""
end

@en "AppEvent"
@fa "رویداد برنامه"
pub struct AppEvent:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "window"
    @fa "پنجره"
    pub window: int = -1
    @en "payload"
    @fa "بار"
    pub payload: str = "null"
end

@en "FirstURLArg"
@fa "نخستین آرگومان نشانی"
pub func FirstURLArg(args: Vector<str>): str:
    each arg in args:
        if str.Contains(arg, "://"):
            ret str.Clone(arg)
        end
    end
    ret str.Clone("")
end

@en "ActivationFromArgs"
@fa "فعال سازی از آرگومان ها"
pub func ActivationFromArgs(args: Vector<str>, source: str = "second-instance"): ActivationPayload:
    mut payload := ActivationPayload { source = str.Clone(source), args = args }
    payload.url = FirstURLArg(args)
    if payload.url.Len() > 0:
        payload.raw = json.Str(payload.url)
    else:
        payload.raw = str.Clone("null")
    end
    ret payload
end

@en "ActivationFromURL"
@fa "فعال سازی از نشانی"
pub func ActivationFromURL(url: str, source: str = "deep-link"): ActivationPayload:
    mut args := Vector {} as Vector<str>
    if url.Len() > 0:
        args.Push(str.Clone(url))
    end
    mut payload := ActivationPayload { source = str.Clone(source), args = args, url = str.Clone(url) }
    payload.raw = url.Len() > 0 ? json.Str(url) : str.Clone("null")
    ret payload
end

@en "NewAppEvent"
@fa "رویداد برنامه تازه"
pub func NewAppEvent(name: str, window: int = -1, payload: str = "null"): AppEvent:
    ret AppEvent { name = str.Clone(name), window = window, payload = str.Clone(payload) }
end

@en "EventPayloadString"
@fa "بار متنی رویداد"
pub func EventPayloadString(value: str): str:
    encoded := json.Str(value)
    ret encoded
end

@en "EventPayloadBool"
@fa "بار درستی رویداد"
pub func EventPayloadBool(value: bool): str:
    ret value ? "true" : "false"
end

@en "EventPayloadInt"
@fa "بار عددی رویداد"
pub func EventPayloadInt(value: i64): str:
    ret str.FromInt(value)
end

@en "ActivationPayloadJSON"
@fa "بار فعال سازی به جیسون"
pub func ActivationPayloadJSON(payload: ActivationPayload): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `{"source":`)
    src := json.Str(payload.source)
    str.BufAppend(b, src)
    mem.Free(src as void*)
    str.BufAppend(b, `,"url":`)
    url := json.Str(payload.url)
    str.BufAppend(b, url)
    mem.Free(url as void*)
    str.BufAppend(b, `,"argc":`)
    str.BufAppend(b, str.FromInt(payload.args.Len() as i64))
    str.BufAppend(b, "}")
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

@en "IsDeepLinkActivation"
@fa "فعال سازی پیوند عمیق است"
pub func IsDeepLinkActivation(payload: ActivationPayload): bool:
    ret payload.source == "deep-link" or payload.url.Len() > 0
end

@en "IsSecondInstanceActivation"
@fa "فعال سازی نمونه دوم است"
pub func IsSecondInstanceActivation(payload: ActivationPayload): bool:
    ret payload.source == "second-instance"
end

@en "IsURLActivation"
@fa "فعال سازی دارای نشانی است"
pub func IsURLActivation(payload: ActivationPayload): bool:
    ret payload.url.Len() > 0
end

@en "ActivationArgsJSON"
@fa "آرگومان های فعال سازی به جیسون"
pub func ActivationArgsJSON(payload: ActivationPayload): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, "[")
    n := payload.args.Len()
    mut i := 0
    until i < n:
        if i > 0:
            str.BufAppend(b, ",")
        end
        v := json.Str(payload.args.Get(i))
        str.BufAppend(b, v)
        mem.Free(v as void*)
        i = i + 1
    end
    str.BufAppend(b, "]")
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end
