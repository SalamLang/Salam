/*
 * Salam Programming Language (2024-2026)
 */

@en "ipc"
@fa "ارتباط بین پردازه ای"
package webview

import str
import mem
import encoding.json

@en "ActivationPayload"
@fa "بار فعال سازی"
pub struct ActivationPayload:
    @en "source"
    @fa "منبع"
    pub source: str = "unknown"
    @en "args"
    @fa "آرگومان ها"
    pub args: Vector<str> = Vector {}
    @en "url"
    @fa "نشانی"
    pub url: str = ""
    @en "raw"
    @fa "خام"
    pub raw: str = ""
end

@en "AppEvent"
@fa "رویداد برنامه"
pub struct AppEvent:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "window"
    @fa "پنجره"
    pub window: int = -1
    @en "payload"
    @fa "بار"
    pub payload: str = "null"
end

@en "FirstURLArg"
@fa "نخستین آرگومان نشانی"
pub func FirstURLArg(args: Vector<str>): str:
    each arg in args:
        if str.Contains(arg, "://"):
            ret str.Clone(arg)
        end
    end
    ret str.Clone("")
end

@en "ActivationFromArgs"
@fa "فعال سازی از آرگومان ها"
pub func ActivationFromArgs(args: Vector<str>, source: str = "second-instance"): ActivationPayload:
    mut payload := ActivationPayload { source = str.Clone(source), args = args }
    payload.url = FirstURLArg(args)
    if payload.url.Len() > 0:
        payload.raw = json.Str(payload.url)
    else:
        payload.raw = str.Clone("null")
    end
    ret payload
end

@en "ActivationFromURL"
@fa "فعال سازی از نشانی"
pub func ActivationFromURL(url: str, source: str = "deep-link"): ActivationPayload:
    mut args := Vector {} as Vector<str>
    if url.Len() > 0:
        args.Push(str.Clone(url))
    end
    mut payload := ActivationPayload { source = str.Clone(source), args = args, url = str.Clone(url) }
    payload.raw = url.Len() > 0 ? json.Str(url) : str.Clone("null")
    ret payload
end
