@en "menu"
@fa "منو"
package webview

import str
import mem

// Menu and edit-action helpers for desktop webview apps (best-effort, additive).
// Native menu rendering/action routing depends on platform backends in system.salam.
// This module lives in package webview and uses Menu/MenuItem/Window types from it.

// Standard edit action IDs (conventional).
pub const ACTION_CUT := "edit.cut"
pub const ACTION_COPY := "edit.copy"
pub const ACTION_PASTE := "edit.paste"
pub const ACTION_SELECT_ALL := "edit.select_all"
pub const ACTION_UNDO := "edit.undo"
pub const ACTION_REDO := "edit.redo"
pub const ACTION_QUIT := "app.quit"
pub const ACTION_RELOAD := "view.reload"
pub const ACTION_TOGGLE_DEVTOOLS := "view.devtools"
pub const ACTION_MINIMIZE := "window.minimize"
pub const ACTION_ZOOM := "window.zoom"
pub const ACTION_CLOSE := "window.close"

@en "MenuAction"
@fa "کنش منو"
pub struct MenuAction:
    @en "id"
    @fa "شناسه"
    pub id: str = ""
    @en "label"
    @fa "برچسب"
    pub label: str = ""
    @en "accelerator"
    @fa "میانبر"
    pub accelerator: str = ""
    @en "enabled"
    @fa "فعال"
    pub enabled: bool = true
    @en "checked"
    @fa "علامت‌خورده"
    pub checked: bool = false
end

@en "Separator"
@fa "جداکننده"
pub func Separator(): MenuItem:
    ret MenuItem { separator = true }
end

@en "ActionItem"
@fa "مورد کنش"
pub func ActionItem(id: str, label: str, accelerator: str = ""): MenuItem:
    mut label_text := str.Clone(label)
    if str.Len(accelerator) > 0:
        // Best-effort label hint; native accelerator binding is backend-dependent.
        suffix := str.Concat("	", accelerator)
        tmp := str.Concat(label_text, suffix)
        mem.Free(label_text as void*)
        mem.Free(suffix as void*)
        label_text = tmp
    end
    ret MenuItem { id = str.Clone(id), label = label_text }
end

@en "Submenu"
@fa "زیرمنو"
pub func Submenu(label: str, children: Vector<MenuItem>): MenuItem:
    ret MenuItem { label = str.Clone(label), children = children }
end

@en "EditMenu"
@fa "منوی ویرایش"
pub func EditMenu(): MenuItem:
    mut items := Vector {} as Vector<MenuItem>
    items.Push(ActionItem(ACTION_UNDO, "Undo", "Ctrl+Z"))
    items.Push(ActionItem(ACTION_REDO, "Redo", "Ctrl+Shift+Z"))
    items.Push(Separator())
    items.Push(ActionItem(ACTION_CUT, "Cut", "Ctrl+X"))
    items.Push(ActionItem(ACTION_COPY, "Copy", "Ctrl+C"))
    items.Push(ActionItem(ACTION_PASTE, "Paste", "Ctrl+V"))
    items.Push(ActionItem(ACTION_SELECT_ALL, "Select All", "Ctrl+A"))
    ret Submenu("Edit", items)
end

@en "AppMenu"
@fa "منوی برنامه"
pub func AppMenu(app_name: str = "App"): MenuItem:
    mut items := Vector {} as Vector<MenuItem>
    quit_label := str.Concat("Quit ", app_name)
    items.Push(ActionItem(ACTION_QUIT, quit_label, "Ctrl+Q"))
    mem.Free(quit_label as void*)
    ret Submenu(app_name, items)
end

@en "WindowMenu"
@fa "منوی پنجره"
pub func WindowMenu(): MenuItem:
    mut items := Vector {} as Vector<MenuItem>
    items.Push(ActionItem(ACTION_MINIMIZE, "Minimize", "Ctrl+M"))
    items.Push(ActionItem(ACTION_ZOOM, "Zoom", ""))
    items.Push(ActionItem(ACTION_CLOSE, "Close", "Ctrl+W"))
    ret Submenu("Window", items)
end

@en "ViewMenu"
@fa "منوی نما"
pub func ViewMenu(): MenuItem:
    mut items := Vector {} as Vector<MenuItem>
    items.Push(ActionItem(ACTION_RELOAD, "Reload", "Ctrl+R"))
    items.Push(ActionItem(ACTION_TOGGLE_DEVTOOLS, "Toggle Developer Tools", "Ctrl+Shift+I"))
    ret Submenu("View", items)
end

@en "DefaultMenu"
@fa "منوی پیش‌فرض"
pub func DefaultMenu(app_name: str = "Salam"): Menu:
    mut m := Menu {}
    m.Add(AppMenu(app_name))
    m.Add(EditMenu())
    m.Add(ViewMenu())
    m.Add(WindowMenu())
    ret m
end

@en "EditActionJS"
@fa "جاوااسکریپت کنش ویرایش"
pub func EditActionJS(action_id: str): str:
    // Best-effort DOM/editing commands for webview content.
    if action_id == ACTION_CUT:
        ret str.Clone("document.execCommand('cut')")
    else action_id == ACTION_COPY:
        ret str.Clone("document.execCommand('copy')")
    else action_id == ACTION_PASTE:
        ret str.Clone("document.execCommand('paste')")
    else action_id == ACTION_SELECT_ALL:
        ret str.Clone("document.execCommand('selectAll')")
    else action_id == ACTION_UNDO:
        ret str.Clone("document.execCommand('undo')")
    else action_id == ACTION_REDO:
        ret str.Clone("document.execCommand('redo')")
    end
    ret str.Clone("")
end

@en "IsEditAction"
@fa "کنش ویرایش است"
pub func IsEditAction(action_id: str): bool:
    ret action_id == ACTION_CUT or action_id == ACTION_COPY or action_id == ACTION_PASTE or action_id == ACTION_SELECT_ALL or action_id == ACTION_UNDO or action_id == ACTION_REDO
end

@en "ApplyEditAction"
@fa "اعمال کنش ویرایش"
pub func ApplyEditAction(window: Window, action_id: str): bool:
    js := EditActionJS(action_id)
    if str.Len(js) == 0:
        mem.Free(js as void*)
        ret false
    end
    ok := window.Eval(js)
    mem.Free(js as void*)
    ret ok
end
