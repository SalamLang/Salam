package webview

if SALAM_OS_LINUX and not SALAM_WEBVIEW_CEF:
    link dynamic "dl"

    extern:
        func readlink(path: str, buf: void*, sz: u64): int
        func dlopen(path: str, flags: int): void*
        func dlsym(handle: void*, name: str): void*
        func g_error_free(error: void*)
        func g_variant_new(format: str, ...): void*
        func g_variant_new_string(text: str): void*
        func g_variant_new_boolean(value: int): void*
        func g_variant_type_new(text: str): void*
        func g_variant_builder_new(kind: void*): void*
        func g_variant_builder_add(builder: void*, format: str, ...)
        func g_variant_builder_unref(builder: void*)
        func g_dbus_connection_signal_subscribe(
            connection: void*, sender: void*, iface: str, member: str, path: str, arg0: void*,
            flags: int, callback: void*, data: void*, free_data: void*
        ): u32
        func g_variant_unref(value: void*)
        func g_variant_print(value: void*, annotate: int): void*
        func g_bus_get_sync(kind: int, cancellable: void*, error: void*): void*
        func g_dbus_connection_call_sync(
            connection: void*, destination: str, path: str, iface: str, method: str, params: void*,
            reply: void*, flags: int, timeout: int, cancellable: void*, error: void*
        ): void*
        func g_app_info_launch_default_for_uri(uri: str, context: void*, error: void*): int
        func gtk_file_chooser_dialog_new(title: str, parent: void*, action: int, first: str, ...): void*
        func gtk_file_chooser_get_filename(chooser: void*): void*
        func gtk_file_chooser_set_current_name(chooser: void*, name: str)
        func gtk_file_chooser_set_do_overwrite_confirmation(chooser: void*, enabled: int)
        func gtk_file_chooser_add_filter(chooser: void*, filter: void*)
        func gtk_file_filter_new(): void*
        func gtk_file_filter_set_name(filter: void*, name: str)
        func gtk_file_filter_add_pattern(filter: void*, pattern: str)
        func gtk_dialog_run(dialog: void*): int
        func gtk_dialog_set_default_response(dialog: void*, response: int)
        func gtk_window_set_urgency_hint(window: void*, urgent: int)
        func gtk_message_dialog_new(parent: void*, flags: int, kind: int, buttons: int, format: str, ...): void*
        func gtk_menu_bar_new(): void*
        func gtk_menu_new(): void*
        func gtk_menu_item_new_with_label(label: str): void*
        func gtk_separator_menu_item_new(): void*
        func gtk_menu_item_set_submenu(item: void*, menu: void*)
        func gtk_menu_shell_append(shell: void*, child: void*)
        func gtk_box_pack_start(box: void*, child: void*, expand: int, fill: int, padding: u32)
        func gtk_menu_popup_at_pointer(menu: void*, event: void*)
        func gtk_status_icon_new_from_file(path: str): void*
        func gtk_status_icon_set_tooltip_text(icon: void*, text: str)
        func gtk_status_icon_set_visible(icon: void*, visible: int)
        func socket(domain: int, kind: int, protocol: int): int
        func bind(fd: int, addr: void*, size: int): int
        func listen(fd: int, backlog: int): int
        func accept(fd: int, addr: void*, size: void*): int
        func connect(fd: int, addr: void*, size: int): int
        func close(fd: int): int
        func unlink(path: str): int
        func flock(fd: int, operation: int): int
        func open(path: str, flags: int, ...): int
    end

    if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
        extern:
            func read(fd: int, buf: void*, size: u32): int
            func write(fd: int, buf: void*, size: u32): int
        end
    else:
        extern:
            func read(fd: int, buf: void*, size: u64): i64
            func write(fd: int, buf: void*, size: u64): i64
        end
    end

    mut _lx_tray_menu := null as void*
    mut _lx_tray_status := null as void*
    mut _lx_tray_indicator := null as void*
    mut _lx_tray_lib := null as void*
    mut _lx_instance_fd := -1
    mut _lx_click_listening := false
    mut _lx_server_sounds := -1

    export:
        func salam_desktop_lx_menu(_item: void*, data: void*):
            _fire_menu((data as i64) as int)
        end

        func salam_desktop_lx_notify_action(_connection: void*, _sender: str, _path: str, _iface: str, _signal: str, _params: void*, _data: void*):
            _on_notify_click()
        end

        func salam_desktop_lx_tray_activate(_icon: void*, _data: void*):
            _on_tray_click()
        end

        func salam_desktop_lx_tray_popup(_icon: void*, _button: u32, _time: u32, _data: void*):
            if _lx_tray_menu != null:
                gtk_menu_popup_at_pointer(_lx_tray_menu, null)
            end
        end
    end

    if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
        func _lx_read(fd: int, buf: void*, n: i64): i64: ret read(fd, buf, n as u32) end

        func _lx_write(fd: int, buf: void*, n: int): i64: ret write(fd, buf, n as u32) end
    else:
        func _lx_read(fd: int, buf: void*, n: i64): i64: ret read(fd, buf, n as u64) end

        func _lx_write(fd: int, buf: void*, n: int): i64: ret write(fd, buf, n as u64) end
    end

    func _lx_fill_menu(shell: void*, items: Vector<MenuItem>):
        each item in items:
            if item.separator:
                gtk_menu_shell_append(shell, gtk_separator_menu_item_new())
                continue
            end
            widget := gtk_menu_item_new_with_label(item.label)
            if item.children.len() > 0:
                sub := gtk_menu_new()
                _lx_fill_menu(sub, item.children)
                gtk_menu_item_set_submenu(widget, sub)
            else:
                native := _menu_id(item.id)
                g_signal_connect_data(widget, "activate", &salam_desktop_lx_menu, native as i64 as void*, null, 0)
            end
            gtk_menu_shell_append(shell, widget)
        end
    end

    func _lx_instance_thread(arg: void*):
        fd := (arg as i64) as int
        until true:
            client := accept(fd, null, null)
            if client < 0:
                break
            end
            buf := mem.AllocateZeroed(65537 as u64)
            mut total := 0 as i64
            until total < (65536 as i64):
                got := _lx_read(client, ((buf as i64) + total) as void*, 65536 as i64 - total)
                if got <= 0:
                    break
                end
                total += got
            end
            close(client)
            args := _split_args(buf, total as int)
            mem.Free(buf)
            Dispatch((): _on_second(args) end)
        end
    end

    func _lx_sockaddr(path: str): void*:
        addr := mem.AllocateZeroed(112 as u64)
        (addr as u16*)[0] = 1 as u16
        mem.Copy(((addr as i64) + 2) as void*, path as void*, (str.Len(path) + 1) as u64)
        ret addr
    end

    func _exe_path(): str:
        buf := mem.AllocateZeroed(4097 as u64)
        n := readlink("/proc/self/exe", buf, 4096 as u64)
        if n <= 0:
            mem.Free(buf)
            ret str.Clone("")
        end
        ret buf as str
    end

    func _open_external(url: str): bool:
        ret g_app_info_launch_default_for_uri(url, null, null) != 0
    end

    func _os_pick(title: str, mode: int, default_name: str, filter_name: str, patterns: str): str:
        action := mode == 1 ? 2 : (mode == 2 ? 1 : 0)
        accept_label := mode == 2 ? "_Save" : (mode == 1 ? "_Select" : "_Open")
        dialog := gtk_file_chooser_dialog_new(title, _parent_native(), action, "_Cancel", -6, accept_label, -3, null)
        if mode == 2:
            gtk_file_chooser_set_do_overwrite_confirmation(dialog, 1)
            if default_name.len() > 0:
                gtk_file_chooser_set_current_name(dialog, default_name)
            end
        end
        if patterns.len() > 0:
            filter := gtk_file_filter_new()
            gtk_file_filter_set_name(filter, filter_name.len() > 0 ? filter_name : patterns)
            parts := str.Split(patterns, ";")
            each part in parts:
                gtk_file_filter_add_pattern(filter, part)
            end
            parts.free()
            gtk_file_chooser_add_filter(dialog, filter)
        end
        mut out := str.Clone("")
        if gtk_dialog_run(dialog) == -3:
            raw := gtk_file_chooser_get_filename(dialog)
            if raw != null:
                mem.Free(out as void*)
                out = str.Clone(raw as str)
                g_free(raw)
            end
        end
        gtk_widget_destroy(dialog)
        ret out
    end

    func _os_message(title: str, text: str, question: bool): bool:
        dialog := gtk_message_dialog_new(_parent_native(), 1, question ? 2 : 0, question ? 4 : 1, "%s", text)
        gtk_window_set_title(dialog, title)
        gtk_dialog_set_default_response(dialog, question ? -8 : -5)
        answer := gtk_dialog_run(dialog)
        gtk_widget_destroy(dialog)
        ret answer == -8 or answer == -5
    end

    func _lx_server_plays_sound(bus: void*): bool:
        if _lx_server_sounds >= 0:
            ret _lx_server_sounds == 1
        end
        reply := g_dbus_connection_call_sync(
            bus, "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
            "org.freedesktop.Notifications", "GetCapabilities", null, null, 0, 2000, null, null
        )
        if reply == null:
            ret false
        end
        raw := g_variant_print(reply, 0)
        g_variant_unref(reply)
        mut found := false
        if raw != null:
            found = str.Contains(raw as str, "'sound'")
            g_free(raw)
        end
        _lx_server_sounds = found ? 1 : 0
        ret found
    end

    func _lx_play_sound(sound: str):
        name := sound == "alert" ? "dialog-warning" : "message-new-instant"
        script := "( if command -v canberra-gtk-play >/dev/null 2>&1; then canberra-gtk-play -i " + name + " -d salam; elif command -v paplay >/dev/null 2>&1 && [ -r /usr/share/sounds/freedesktop/stereo/" + name + ".oga ]; then paplay /usr/share/sounds/freedesktop/stereo/" + name + ".oga; elif command -v pw-play >/dev/null 2>&1 && [ -r /usr/share/sounds/freedesktop/stereo/" + name + ".oga ]; then pw-play /usr/share/sounds/freedesktop/stereo/" + name + ".oga; fi ) >/dev/null 2>&1 &"
        mut args := Vector {} as Vector<str>
        defer args.free()
        args.push("-c")
        args.push(script)
        _result := shell.Run("/bin/sh", args)
    end

    func _os_notify(title: str, body: str, sound: str): bool:
        bus := g_bus_get_sync(2, null, null)
        if bus == null:
            ret false
        end
        if not _lx_click_listening:
            _lx_click_listening = true
            _id := g_dbus_connection_signal_subscribe(
                bus, null, "org.freedesktop.Notifications", "ActionInvoked",
                "/org/freedesktop/Notifications", null, 0, &salam_desktop_lx_notify_action, null,
                null
            )
        end
        actions := g_variant_builder_new(g_variant_type_new("as"))
        g_variant_builder_add(actions, "s", "default")
        g_variant_builder_add(actions, "s", "Open")
        hints := g_variant_builder_new(g_variant_type_new("a{sv}"))
        if sound.len() == 0:
            g_variant_builder_add(hints, "{sv}", "suppress-sound", g_variant_new_boolean(1))
        else:
            name := sound == "alert" ? "dialog-warning" : "message-new-instant"
            g_variant_builder_add(hints, "{sv}", "sound-name", g_variant_new_string(name))
        end
        app_name := _cfg.name.len() > 0 ? _cfg.name : _secret_id()
        params := g_variant_new("(susssasa{sv}i)", app_name, 0 as u32, _cfg.icon, title, body, actions, hints, -1)
        g_variant_builder_unref(actions)
        g_variant_builder_unref(hints)
        reply := g_dbus_connection_call_sync(
            bus, "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
            "org.freedesktop.Notifications", "Notify", params, null, 0, 5000, null, null
        )
        if reply == null:
            ret false
        end
        g_variant_unref(reply)
        if sound.len() > 0 and not _lx_server_plays_sound(bus):
            _lx_play_sound(sound)
        end
        ret true
    end

    func _os_attention(window: void*):
        if window != null:
            gtk_window_set_urgency_hint(window, 1)
        end
    end

    func _secret_lib(): void*:
        ret dlopen("libsecret-1.so.0", 2)
    end

    func _secret_schema(service: str): void*:
        schema := mem.AllocateZeroed(1024 as u64)
        fields := schema as i64*
        fields[0] = (service as void*) as i64
        fields[2] = ("key" as void*) as i64
        ret schema
    end

    func _os_secret_set(service: str, key: str, value: str): bool:
        lib := _secret_lib()
        if lib == null:
            ret false
        end
        store := dlsym(lib, "secret_password_store_sync")
        if store == null:
            ret false
        end
        f := store as extern func (void*, void*, str, str, void*, void*, str, str, void*) int
        schema := _secret_schema(service)
        defer mem.Free(schema)
        ret f(schema, null, service, value, null, null, "key", key, null) != 0
    end

    func _os_secret_get(service: str, key: str): str:
        lib := _secret_lib()
        if lib == null:
            ret str.Clone("")
        end
        lookup := dlsym(lib, "secret_password_lookup_sync")
        if lookup == null:
            ret str.Clone("")
        end
        f := lookup as extern func (void*, void*, void*, str, str, void*) void*
        schema := _secret_schema(service)
        defer mem.Free(schema)
        raw := f(schema, null, null, "key", key, null)
        if raw == null:
            ret str.Clone("")
        end
        out := str.Clone(raw as str)
        release := dlsym(lib, "secret_password_free")
        if release != null:
            g := release as extern func (void*)
            g(raw)
        end
        ret out
    end

    func _os_secret_delete(service: str, key: str): bool:
        lib := _secret_lib()
        if lib == null:
            ret false
        end
        clear := dlsym(lib, "secret_password_clear_sync")
        if clear == null:
            ret false
        end
        f := clear as extern func (void*, void*, void*, str, str, void*) int
        schema := _secret_schema(service)
        defer mem.Free(schema)
        ret f(schema, null, null, "key", key, null) != 0
    end

    func _os_set_menu(view: WebView, items: Vector<MenuItem>):
        box := view.Content()
        if box == null:
            ret
        end
        bar := gtk_menu_bar_new()
        _lx_fill_menu(bar, items)
        gtk_box_pack_start(box, bar, 0, 0, 0 as u32)
        gtk_widget_show_all(bar)
    end

    func _os_set_tray(icon: str, tooltip: str, items: Vector<MenuItem>): bool:
        _lx_tray_menu = gtk_menu_new()
        _lx_fill_menu(_lx_tray_menu, items)
        gtk_widget_show_all(_lx_tray_menu)
        mut lib := dlopen("libayatana-appindicator3.so.1", 2)
        if lib == null:
            lib = dlopen("libappindicator3.so.1", 2)
        end
        if lib != null:
            make := dlsym(lib, "app_indicator_new") as extern func (str, str, int) void*
            status := dlsym(lib, "app_indicator_set_status") as extern func (void*, int)
            menu := dlsym(lib, "app_indicator_set_menu") as extern func (void*, void*)
            _lx_tray_lib = lib
            _lx_tray_indicator = make(_secret_id(), icon, 0)
            status(_lx_tray_indicator, 1)
            menu(_lx_tray_indicator, _lx_tray_menu)
            ret true
        end
        _lx_tray_status = gtk_status_icon_new_from_file(icon)
        if _lx_tray_status == null:
            ret false
        end
        gtk_status_icon_set_tooltip_text(_lx_tray_status, tooltip)
        g_signal_connect_data(_lx_tray_status, "activate", &salam_desktop_lx_tray_activate, null, null, 0)
        g_signal_connect_data(_lx_tray_status, "popup-menu", &salam_desktop_lx_tray_popup, null, null, 0)
        ret true
    end

    func _os_remove_tray():
        if _lx_tray_status != null:
            gtk_status_icon_set_visible(_lx_tray_status, 0)
        end
        if _lx_tray_indicator != null and _lx_tray_lib != null:
            status := dlsym(_lx_tray_lib, "app_indicator_set_status") as extern func (void*, int)
            status(_lx_tray_indicator, 0)
        end
    end

    func _os_single_instance(): bool:
        dir := DataDir()
        defer mem.Free(dir as void*)
        _mk := os.MkdirAll(dir)
        lock_path := filepath.Join(dir, "instance.lock")
        defer mem.Free(lock_path as void*)
        sock_name := crypto.Sha256Hex(dir)
        defer mem.Free(sock_name as void*)
        short := str.Substr(sock_name, 0, 24)
        defer mem.Free(short as void*)
        runtime := os.Env("XDG_RUNTIME_DIR")
        sock_path := (runtime.len() > 0 ? runtime : "/tmp").concat("/salam-").concat(short).concat(".sock")
        defer mem.Free(sock_path as void*)
        fd := open(lock_path, 0o100 | 2 | 0o2000000, 0o600)
        if fd < 0:
            ret true
        end
        addr := _lx_sockaddr(sock_path)
        defer mem.Free(addr)
        if flock(fd, 2 | 4) != 0:
            close(fd)
            client := socket(1, 1, 0)
            if client >= 0 and connect(client, addr, 110) == 0:
                mut size := 0
                data := _join_args(size)
                _sent := _lx_write(client, data, size)
                mem.Free(data)
                close(client)
            end
            ret false
        end
        _lx_instance_fd = fd
        _gone := unlink(sock_path)
        server := socket(1, 1, 0)
        if server >= 0 and bind(server, addr, 110) == 0 and listen(server, 8) == 0:
            _t := spawn(_lx_instance_thread, (server as i64) as void*)
        end
        ret true
    end
end

if SALAM_WEBVIEW_CEF:
    func _exe_path(): str:
        ret str.Clone("")
    end

    func _open_external(_url: str): bool:
        ret false
    end

    func _os_pick(_title: str, _mode: int, _default_name: str, _filter_name: str, _patterns: str): str:
        ret str.Clone("")
    end

    func _os_message(_title: str, _text: str, _question: bool): bool:
        ret false
    end

    func _os_notify(_title: str, _body: str, _sound: str): bool:
        ret false
    end

    func _os_attention(_window: void*):
        _touch_stub()
    end

    func _os_secret_set(_service: str, _key: str, _value: str): bool:
        ret false
    end

    func _os_secret_get(_service: str, _key: str): str:
        ret str.Clone("")
    end

    func _os_secret_delete(_service: str, _key: str): bool:
        ret false
    end

    func _os_set_menu(_view: WebView, _items: Vector<MenuItem>):
        _touch_stub()
    end

    func _os_set_tray(_icon: str, _tooltip: str, _items: Vector<MenuItem>): bool:
        ret false
    end

    func _os_remove_tray():
        _touch_stub()
    end

    func _os_single_instance(): bool:
        ret true
    end

    func _touch_stub():
        _inited = _inited
    end
end
