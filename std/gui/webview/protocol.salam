/*
 * Salam Programming Language (2024-2026)
 */

@en "protocol"
@fa "پروتکل"
package webview

import str
import mem

@en "ProtocolRegistration"
@fa "ثبت پروتکل"
pub struct ProtocolRegistration:
    @en "scheme"
    @fa "طرح"
    pub scheme: str = ""
    @en "origin"
    @fa "مبدا"
    pub origin: str = ""
    @en "registered"
    @fa "ثبت شده"
    pub registered: bool = false
end

@en "DeepLink"
@fa "پیوند عمیق"
pub struct DeepLink:
    @en "url"
    @fa "نشانی"
    pub url: str = ""
    @en "scheme"
    @fa "طرح"
    pub scheme: str = ""
    @en "origin"
    @fa "مبدا"
    pub origin: str = ""
    @en "path"
    @fa "مسیر"
    pub path: str = "/"
    @en "query"
    @fa "پرسش"
    pub query: str = ""
end

@en "ParseDeepLink"
@fa "تجزیه پیوند عمیق"
pub func ParseDeepLink(url: str): DeepLink:
    mut out := DeepLink { url = str.Clone(url), origin = OriginOf(url) }
    start := str.IndexOf(url, "://")
    if start > 0:
        out.scheme = str.Substr(url, 0, start)
    else:
        out.scheme = str.Clone("")
    end
    req := _wv_split_url(url, out.scheme, "GET")
    // Move owned path/query into DeepLink; avoid freeing them.
    out.path = req.path
    out.query = req.query
    ret out
end

@en "IsCustomProtocolURL"
@fa "نشانی پروتکل سفارشی است"
pub func IsCustomProtocolURL(url: str): bool:
    scheme := SchemeOfURL(url)
    defer mem.Free(scheme as void*)
    if scheme.Len() == 0:
        ret false
    end
    lower := str.Lower(scheme)
    defer mem.Free(lower as void*)
    ret lower != "http" and lower != "https" and lower != "file" and lower != "data" and lower != "about"
end

@en "SchemeOfURL"
@fa "طرح نشانی"
pub func SchemeOfURL(url: str): str:
    start := str.IndexOf(url, "://")
    if start <= 0:
        ret str.Clone("")
    end
    ret str.Substr(url, 0, start)
end

@en "RegisterAppProtocol"
@fa "ثبت پروتکل برنامه"
pub func RegisterAppProtocol(name: str, handler: func (Request) Response): ProtocolRegistration:
    RegisterScheme(name, handler)
    ret ProtocolRegistration {
        scheme = str.Clone(name), origin = SchemeOrigin(name), registered = true
    }
end

@en "DefaultProtocolRegistration"
@fa "ثبت پروتکل پیش فرض"
pub func DefaultProtocolRegistration(): ProtocolRegistration:
    cfg := CurrentConfig()
    ret ProtocolRegistration {
        scheme = str.Clone(cfg.scheme), origin = SchemeOrigin(cfg.scheme), registered = cfg.scheme.Len() > 0
    }
end

@en "NormalizeProtocolName"
@fa "نرمال‌سازی نام پروتکل"
pub func NormalizeProtocolName(name: str): str:
    lower := str.Lower(name)
    ret lower
end

@en "DeepLinkFromRequest"
@fa "پیوند عمیق از درخواست"
pub func DeepLinkFromRequest(req: Request): DeepLink:
    ret ParseDeepLink(req.url)
end

@en "RegisterProtocolIfCustom"
@fa "ثبت پروتکل در صورت سفارشی بودن"
pub func RegisterProtocolIfCustom(name: str, handler: func (Request) Response): ProtocolRegistration:
    if name.Len() == 0:
        ret ProtocolRegistration {}
    end
    ret RegisterAppProtocol(name, handler)
end

@en "IsWebProtocolURL"
@fa "نشانی پروتکل وب است"
pub func IsWebProtocolURL(url: str): bool:
    scheme := SchemeOfURL(url)
    defer mem.Free(scheme as void*)
    lower := str.Lower(scheme)
    defer mem.Free(lower as void*)
    ret lower == "http" or lower == "https"
end
