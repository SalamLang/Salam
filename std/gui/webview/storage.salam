@en "storage"
@fa "ذخیره‌سازی"
package webview

import str
import mem
import os.settings
import gui.webview.system

// App storage helpers for webview/desktop apps (best-effort).
// - Public/config data: portable key-value settings store (os.settings).
// - Secrets/sensitive values: platform secret store fallback APIs in system.salam.
//
// This module provides a convenience abstraction; it does not add transparent
// encryption-at-rest beyond what the underlying platform/secret APIs provide.

@en "AppStorage"
@fa "ذخیره‌سازی برنامه"
pub struct AppStorage:
    @en "app_id"
    @fa "شناسه برنامه"
    pub app_id: str = ""
    @en "store"
    @fa "ذخیره"
    pub store: settings.Store = settings.Store {}
end

@en "Open"
@fa "باز کردن"
pub func Open(app_id: str): AppStorage:
    ret AppStorage { app_id = str.Clone(app_id), store = settings.Init(app_id) }
end

@en "OpenWithPath"
@fa "باز کردن با مسیر"
pub func OpenWithPath(app_id: str, path: str): AppStorage:
    ret AppStorage { app_id = str.Clone(app_id), store = settings.InitWithPath(app_id, path) }
end

@en "Save"
@fa "ذخیره"
pub func Save(s &: AppStorage): bool:
    ret settings.Save(s.store)
end

@en "Close"
@fa "بستن"
pub func Close(s &: AppStorage):
    settings.Save(s.store)
    settings.Free(s.store)
    if str.Len(s.app_id) > 0:
        mem.Free(s.app_id as void*)
        s.app_id = ""
    end
end

@en "Set"
@fa "تنظیم"
pub func Set(s &: AppStorage, key: str, value: str):
    settings.Set(s.store, key, value)
end

@en "Get"
@fa "دریافت"
pub func Get(s &: AppStorage, key: str, def: str = ""): str:
    ret settings.Get(s.store, key, def)
end

@en "GetInt"
@fa "دریافت عدد"
pub func GetInt(s &: AppStorage, key: str, def: int = 0): int:
    ret settings.GetInt(s.store, key, def)
end

@en "GetBool"
@fa "دریافت درستی"
pub func GetBool(s &: AppStorage, key: str, def: bool = false): bool:
    ret settings.GetBool(s.store, key, def)
end

@en "Remove"
@fa "حذف"
pub func Remove(s &: AppStorage, key: str): bool:
    ret settings.Remove(s.store, key)
end

@en "Has"
@fa "دارد"
pub func Has(s &: AppStorage, key: str): bool:
    ret settings.Has(s.store, key)
end

@en "SetSecret"
@fa "تنظیم راز"
pub func SetSecret(key: str, value: str): bool:
    ret system.SecretSet(key, value)
end

@en "GetSecret"
@fa "دریافت راز"
pub func GetSecret(key: str): str:
    ret system.SecretGet(key)
end

@en "DeleteSecret"
@fa "حذف راز"
pub func DeleteSecret(key: str):
    system.SecretDelete(key)
end
