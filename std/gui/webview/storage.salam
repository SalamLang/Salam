@en "storage"
@fa "ذخیره‌سازی"
package webview

import str
import mem
import os.settings

// App storage helpers for webview/desktop apps (best-effort).
// - Public/config data: portable key-value settings store (os.settings).
// - Secrets/sensitive values: platform secret store fallback APIs in system.salam.
//
// This module provides a convenience abstraction; it does not add transparent
// encryption-at-rest beyond what the underlying platform/secret APIs provide.

@en "AppStorage"
@fa "ذخیره‌سازی برنامه"
pub struct AppStorage:
    @en "app_id"
    @fa "شناسه برنامه"
    pub app_id: str = ""
    @en "store"
    @fa "ذخیره"
    pub store: settings.Store = settings.Store {}
end

@en "OpenStorage"
@fa "باز کردن ذخیره‌سازی"
pub func OpenStorage(app_id: str): AppStorage:
    ret AppStorage { app_id = str.Clone(app_id), store = settings.Init(app_id) }
end

@en "OpenStorageWithPath"
@fa "باز کردن ذخیره‌سازی با مسیر"
pub func OpenStorageWithPath(app_id: str, path: str): AppStorage:
    ret AppStorage { app_id = str.Clone(app_id), store = settings.InitWithPath(app_id, path) }
end

@en "SaveStorage"
@fa "ذخیره ذخیره‌سازی"
pub func SaveStorage(s &: AppStorage): bool:
    ret settings.Save(s.store)
end

@en "CloseStorage"
@fa "بستن ذخیره‌سازی"
pub func CloseStorage(s &: AppStorage):
    settings.Save(s.store)
    settings.Free(s.store)
    if str.Len(s.app_id) > 0:
        mem.Free(s.app_id as void*)
        s.app_id = ""
    end
end

@en "StorageSet"
@fa "تنظیم ذخیره‌سازی"
pub func StorageSet(s &: AppStorage, key: str, value: str):
    settings.Set(s.store, key, value)
end

@en "StorageGet"
@fa "دریافت ذخیره‌سازی"
pub func StorageGet(s &: AppStorage, key: str, def: str = ""): str:
    ret settings.Get(s.store, key, def)
end

@en "StorageGetInt"
@fa "دریافت عدد ذخیره‌سازی"
pub func StorageGetInt(s &: AppStorage, key: str, def: int = 0): int:
    ret settings.GetInt(s.store, key, def)
end

@en "StorageGetBool"
@fa "دریافت درستی ذخیره‌سازی"
pub func StorageGetBool(s &: AppStorage, key: str, def: bool = false): bool:
    ret settings.GetBool(s.store, key, def)
end

@en "StorageRemove"
@fa "حذف از ذخیره‌سازی"
pub func StorageRemove(s &: AppStorage, key: str): bool:
    ret settings.Remove(s.store, key)
end

@en "StorageHas"
@fa "دارد در ذخیره‌سازی"
pub func StorageHas(s &: AppStorage, key: str): bool:
    ret settings.Has(s.store, key)
end

@en "SetSecret"
@fa "تنظیم راز"
pub func SetSecret(key: str, value: str): bool:
    ret system.SecretSet(key, value)
end

@en "GetSecret"
@fa "دریافت راز"
pub func GetSecret(key: str): str:
    ret system.SecretGet(key)
end

@en "DeleteSecret"
@fa "حذف راز"
pub func DeleteSecret(key: str):
    system.SecretDelete(key)
end

@en "HasSecret"
@fa "راز دارد"
pub func HasSecret(key: str): bool:
    v := system.SecretGet(key)
    ok := v.Len() > 0
    mem.Free(v as void*)
    ret ok
end

@en "GetOrDefault"
@fa "دریافت پیش‌فرض"
pub func GetOrDefault(s &: AppStorage, key: str, def: str = ""): str:
    if StorageHas(s, key):
        ret StorageGet(s, key, def)
    end
    ret str.Clone(def)
end

@en "SetIfMissing"
@fa "تنظیم در صورت نبود"
pub func SetIfMissing(s &: AppStorage, key: str, value: str): bool:
    if StorageHas(s, key):
        ret false
    end
    StorageSet(s, key, value)
    ret true
end

@en "ScopedKey"
@fa "کلید حوزه‌بندی‌شده"
pub func ScopedKey(prefix: str, key: str): str:
    if prefix.Len() == 0:
        ret str.Clone(key)
    end
    ret prefix.Concat(".").Concat(key)
end

@en "SecretSetScoped"
@fa "تنظیم راز حوزه‌بندی‌شده"
pub func SecretSetScoped(scope: str, key: str, value: str): bool:
    k := ScopedKey(scope, key)
    ok := SetSecret(k, value)
    mem.Free(k as void*)
    ret ok
end

@en "SecretGetScoped"
@fa "دریافت راز حوزه‌بندی‌شده"
pub func SecretGetScoped(scope: str, key: str): str:
    k := ScopedKey(scope, key)
    v := GetSecret(k)
    mem.Free(k as void*)
    ret v
end

@en "SecretDeleteScoped"
@fa "حذف راز حوزه‌بندی‌شده"
pub func SecretDeleteScoped(scope: str, key: str):
    k := ScopedKey(scope, key)
    DeleteSecret(k)
    mem.Free(k as void*)
end

@en "StorageCapabilitiesNote"
@fa "یادداشت قابلیت‌های ذخیره‌سازی"
pub func StorageCapabilitiesNote(): str:
    ret str.Clone("Public settings use os.settings; secrets use platform secret APIs with file fallback. Encryption-at-rest is backend/platform dependent.")
end
