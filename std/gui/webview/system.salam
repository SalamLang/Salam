package webview

import str
import mem
import os
import filepath
import crypto
import fs
import io
import os.user
import os.shell
import encoding.json
import sync

mut _menu_ids := Vector {} as Vector<str>
mut _on_menu := (_id: str): ret end
mut _on_tray_click := (): ret end
mut _on_tray_double_click := (): ret end
mut _on_tray_menu := (_id: str): ret end
mut _on_second := (_args: Vector<str>): ret end
mut _on_notify_click := (): ret end

@en "MenuItem"
@fa "مورد‌منو"
pub struct MenuItem:
    @en "id"
    @fa "شناسه"
    pub id: str = ""
    @en "label"
    @fa "برچسب"
    pub label: str = ""
    @en "separator"
    @fa "جداکننده"
    pub separator: bool = false
    @en "children"
    @fa "زیرمنو"
    pub children: Vector<MenuItem> = Vector {}
end

func _menu_id(id: str): int:
    _menu_ids.Push(str.Clone(id))
    ret _menu_ids.Len() + 999
end

func _fire_menu(native: int):
    at := native - 1000
    if at >= 0 and at < _menu_ids.Len():
        id := _menu_ids[at]
        _on_menu(id)
        _on_tray_menu(id)
        // Best-effort app-level event broadcast for menu actions.
        encoded := json.Str(id)
        Emit("__app:menu", encoded)
        mem.Free(encoded as void*)
    end
end

func _parent_native(): void*:
    mut last := null as void*
    each w in _wins:
        if not w.view.IsClosed():
            if w.view.IsActive():
                ret w.view.Native()
            end
            last = w.view.Native()
        end
    end
    ret last
end

func _secret_file(key: str): str:
    dir := DataDir()
    defer mem.Free(dir as void*)
    folder := filepath.Join(dir, "secrets")
    _mk := os.MkdirAll(folder)
    _private := fs.Chmod(folder, 0o700)
    name := crypto.Sha256Hex(key)
    defer mem.Free(name as void*)
    out := filepath.Join(folder, name)
    mem.Free(folder as void*)
    ret out
end

func _secret_id(): str:
    ret _cfg.id.Len() > 0 ? _cfg.id : "ir.salamlang.app"
end

func _split_args(data: void*, size: int): Vector<str>:
    mut out := Vector {} as Vector<str>
    bytes := data as u8*
    mut start := 0
    repeat size in i:
        if bytes[i] == (0 as u8):
            piece := mem.Allocate((i - start + 1) as u64)
            mem.Copy(piece, ((data as i64) + (start as i64)) as void*, (i - start) as u64)
            (piece as u8*)[i - start] = 0 as u8
            out.Push(piece as str)
            start = i + 1
        end
    end
    ret out
end

func _join_args(size_out &: int): void*:
    args := os.Args()
    mut total := 0
    each a in args:
        total += str.Len(a) + 1
    end
    buf := mem.AllocateZeroed((total + 1) as u64)
    mut at := 0
    each a in args:
        n := str.Len(a)
        mem.Copy(((buf as i64) + (at as i64)) as void*, a as void*, n as u64)
        at += n + 1
    end
    size_out = total
    ret buf
end

@en "OpenURL"
@fa "باز کردن نشانی"
pub func OpenURL(url: str): bool:
    if str.StartsWith(url, "http://") or str.StartsWith(url, "https://") or str.StartsWith(url, "mailto:") or str.StartsWith(url, "tel:"):
        ret _open_external(url)
    end
    ret false
end

@en "PickFolder"
@fa "انتخاب پوشه"
pub func PickFolder(title: str = "Select a folder"): str:
    ret _os_pick(title, 1, "", "", "")
end

@en "SelectFolder"
@fa "انتخاب پوشه"
pub func SelectFolder(title: str = "Select a folder"): str:
    ret PickFolder(title)
end

@en "SelectDirectory"
@fa "انتخاب شاخه"
pub func SelectDirectory(title: str = "Select a folder"): str:
    ret PickFolder(title)
end

@en "PickFile"
@fa "انتخاب پرونده"
pub func PickFile(title: str = "Open", filter_name: str = "", patterns: str = ""): str:
    ret _os_pick(title, 0, "", filter_name, patterns)
end

@en "OpenFile"
@fa "باز کردن پرونده"
pub func OpenFile(title: str = "Open", filter_name: str = "", patterns: str = ""): str:
    ret PickFile(title, filter_name, patterns)
end

@en "PickFiles"
@fa "انتخاب پرونده ها"
pub func PickFiles(title: str = "Open", filter_name: str = "", patterns: str = ""): Vector<str>:
    mut out := Vector {} as Vector<str>
    // Best-effort: native picker backends currently expose single-selection in many
    // builds. A successful pick returns a vector containing one path.
    // Backends that support multi-select can wire a richer _os_pick_files later.
    one := PickFile(title, filter_name, patterns)
    if one.Len() > 0:
        out.Push(one)
    else:
        mem.Free(one as void*)
    end
    ret out
end

@en "OpenFiles"
@fa "باز کردن پرونده ها"
pub func OpenFiles(title: str = "Open", filter_name: str = "", patterns: str = ""): Vector<str>:
    ret PickFiles(title, filter_name, patterns)
end

@en "PickDirectories"
@fa "انتخاب پوشه ها"
pub func PickDirectories(title: str = "Select folders"): Vector<str>:
    mut out := Vector {} as Vector<str>
    // Best-effort fallback: directory picker is typically single-selection.
    one := PickFolder(title)
    if one.Len() > 0:
        out.Push(one)
    else:
        mem.Free(one as void*)
    end
    ret out
end

@en "SelectDirectories"
@fa "انتخاب شاخه ها"
pub func SelectDirectories(title: str = "Select folders"): Vector<str>:
    ret PickDirectories(title)
end

@en "SaveFile"
@fa "ذخیره پرونده"
pub func SaveFile(title: str = "Save", default_name: str = ""): str:
    ret _os_pick(title, 2, default_name, "", "")
end

@en "SaveFileAs"
@fa "ذخیره پرونده به نام"
pub func SaveFileAs(title: str = "Save As", default_name: str = "", filter_name: str = "", patterns: str = ""): str:
    // Best-effort: default path/filter support depends on platform picker backend.
    _keep_filter_name := filter_name
    _keep_patterns := patterns
    ret _os_pick(title, 2, default_name, filter_name, patterns)
end

@en "Message"
@fa "پیام"
pub func Message(title: str, text: str):
    _ignored := _os_message(title, text, false)
end

@en "Confirm"
@fa "تایید"
pub func Confirm(title: str, text: str): bool:
    ret _os_message(title, text, true)
end

@en "InfoMessage"
@fa "پیام اطلاع"
pub func InfoMessage(title: str, text: str):
    Message(title.Len() > 0 ? title : "Info", text)
end

@en "WarningMessage"
@fa "پیام هشدار"
pub func WarningMessage(title: str, text: str):
    Message(title.Len() > 0 ? title : "Warning", text)
end

@en "ErrorMessage"
@fa "پیام خطا"
pub func ErrorMessage(title: str, text: str):
