end

@en "OnTrayMenu"
@fa "هنگام منوی سینی"
pub func OnTrayMenu(handler: func (str)):
    _on_tray_menu = handler
end

@en "SingleInstance"
@fa "نمونه یکتا"
pub func SingleInstance(on_second: func (Vector<str>)): bool:
    _on_second = (args: Vector<str>):
        on_second(args)
        // App-level activation/deep-link forwarding hook.
        HandleSecondInstanceArgs(args)
    end
    ok := _os_single_instance()
    if ok:
        // Primary instance: best-effort forwarding of current argv as activation.
        args := os.Args()
        HandleSecondInstanceArgs(args)
        args.Free()
    end
    ret ok
end

@en "SingleInstanceActivate"
@fa "فعال سازی نمونه یکتا"
pub func SingleInstanceActivate(on_second: func (Vector<str>) = (_args: Vector<str>): ret end): bool:
    ret SingleInstance(
        (args: Vector<str>): on_second(args)
        ActivateApp() end
    )
end
