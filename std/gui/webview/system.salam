@en "RequestAttention"
@fa "درخواست توجه"
pub func RequestAttention(window: Window):
    _os_attention(window.Native())
end

@en "SecretSet"
@fa "ذخیره راز"
pub func SecretSet(key: str, value: str): bool:
    path := _secret_file(key)
    defer mem.Free(path as void*)
    if _os_secret_set(_secret_id(), key, value):
        if os.Exists(path):
            _removed := os.Remove(path)
        end
        ret true
    end
    if fs.WriteBytes(path, value) < 0:
        ret false
    end
    _private := fs.Chmod(path, 0o600)
    ret true
end

@en "SecretGet"
@fa "خواندن راز"
pub func SecretGet(key: str): str:
    stored := _os_secret_get(_secret_id(), key)
    if stored.Len() > 0:
        ret stored
    end
    path := _secret_file(key)
    defer mem.Free(path as void*)
    if os.Exists(path):
        mem.Free(stored as void*)
        ret io.ReadFile(path)
    end
    ret stored
end

@en "SecretDelete"
@fa "حذف راز"
pub func SecretDelete(key: str):
    _gone := _os_secret_delete(_secret_id(), key)
    path := _secret_file(key)
    defer mem.Free(path as void*)
    if os.Exists(path):
        _removed := os.Remove(path)
    end
end

@en "Item"
@fa "مورد"
pub func Item(id: str, label: str): MenuItem:
    ret MenuItem { id = id, label = label }
end

@en "Separator"
@fa "خط جداکننده"
pub func Separator(): MenuItem:
    ret MenuItem { separator = true }
end

@en "Submenu"
@fa "زیرمنوی تازه"
pub func Submenu(label: str, items: Vector<MenuItem>): MenuItem:
    ret MenuItem { label = label, children = items }
end

@en "OnMenu"
@fa "هنگام منو"
pub func OnMenu(handler: func (str)):
    _on_menu = handler
    OnCommand((native: int): _fire_menu(native) end)
end

@en "SetMenu"
@fa "تنظیم منو"
pub func SetMenu(window: Window, items: Vector<MenuItem>):
    if window.index >= 0 and window.index < _wins.Len():
        _os_set_menu(_wins[window.index].view, items)
    end
end

@en "SetTray"
@fa "تنظیم سینی"
pub func SetTray(icon: str, tooltip: str, items: Vector<MenuItem>): bool:
    _startup()
    ret _os_set_tray(icon, tooltip, items)
end

@en "UpdateTray"
@fa "به‌روزرسانی سینی"
pub func UpdateTray(icon: str, tooltip: str, items: Vector<MenuItem>): bool:
    // Best-effort portable update: remove + recreate.
    _os_remove_tray()
    ret _os_set_tray(icon, tooltip, items)
end

@en "RemoveTray"
@fa "حذف سینی"
pub func RemoveTray():
    _os_remove_tray()
end

@en "OnTrayClick"
@fa "هنگام کلیک سینی"
pub func OnTrayClick(handler: func ()):
    _on_tray_click = handler
end

@en "OnTrayDoubleClick"
@fa "هنگام دوبار کلیک سینی"
pub func OnTrayDoubleClick(handler: func ()):
