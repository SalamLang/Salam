package window

if not SALAM_OS_WINDOWS and not SALAM_OS_MAC and not (SALAM_OS_LINUX and not SALAM_OS_ANDROID):
    func _nat_init(): bool:
        _set_error("native windows are not supported on this system in this build; use a headless window")
        ret false
    end

    func _nat_open(_id: int, _o: Options): bool:
        ret false
    end

    func _nat_close(_id: int):
        _set_error("")
    end

    func _nat_title(_id: int, _title: str):
        _set_error("")
    end

    func _nat_resize(_id: int, _pw: int, _ph: int):
        _set_error("")
    end

    func _nat_limits(_id: int):
        _set_error("")
    end

    func _nat_state(_id: int, _what: int):
        _set_error("")
    end

    func _nat_cursor(_id: int, _cursor: Cursor):
        _set_error("")
    end

    func _nat_ime(_id: int, _x: int, _y: int, _w: int, _h: int):
        _set_error("")
    end

    func _nat_icon(_id: int, _pixels: void*, _w: int, _h: int, _stride: int): bool:
        ret false
    end

    func _nat_alloc(_id: int, _w: int, _h: int): void*:
        ret null
    end

    func _nat_blit(_id: int, _rects: Vector<Rect>):
        _set_error("")
    end

    func _nat_pump(_timeout: int):
        _set_error("")
    end

    func _nat_wake():
        _set_error("")
    end

    func _nat_clip_get(): str:
        ret str.Clone("")
    end

    func _nat_clip_set(_text: str): bool:
        ret false
    end

    func _nat_scheme(): ColorScheme:
        ret ColorScheme.Light
    end

    func _nat_shown(_id: int, _x: int, _y: int): u32:
        ret 0
    end

    func _nat_handle(_id: int): void*:
        ret null
    end
end
