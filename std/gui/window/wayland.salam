package window

// Best-effort Wayland backend scaffold.
//
// This file provides the same `_nat_*` API surface as the other platform
// backends so source-level integration work can proceed without breaking the
// package layout. It is only selected for Linux/non-Android builds that opt in
// with `SALAM_BACKEND_WAYLAND` at compile time. Runtime Wayland integration
// (wl_display/wl_registry/xdg-shell, buffer sharing, input, clipboard, etc.)
// is not implemented in this build yet.
if SALAM_OS_LINUX and not SALAM_OS_ANDROID and SALAM_BACKEND_WAYLAND:
    func _nat_init(): bool:
        way := os.Env("WAYLAND_DISPLAY")
        xdg := os.Env("XDG_SESSION_TYPE")
        has_way := str.Len(way) > 0
        has_xdg_way := str.EqualFold(xdg, "wayland")
        if has_way or has_xdg_way:
            _set_error("Wayland window backend scaffold is available at source level, but runtime Wayland integration is not implemented in this build")
        else:
            _set_error("Wayland window backend scaffold selected, but no Wayland session was detected (set WAYLAND_DISPLAY or use XDG_SESSION_TYPE=wayland)")
        end
        mem.Free(way as void*)
        mem.Free(xdg as void*)
        ret false
    end

    func _nat_open(_id: int, _o: Options): bool:
        if _error.Len() == 0:
            _set_error("Wayland window backend scaffold cannot open native windows yet; use a headless window or an available X11/XWayland session")
        end
        ret false
    end

    func _nat_close(_id: int):
        _set_error("")
    end

    func _nat_title(_id: int, _title: str):
        _set_error("")
    end

    func _nat_resize(_id: int, _pw: int, _ph: int):
        _set_error("")
    end

    func _nat_limits(_id: int):
        _set_error("")
    end

    func _nat_state(_id: int, _what: int):
        _set_error("")
    end

    func _nat_cursor(_id: int, _cursor: Cursor):
        _set_error("")
    end

    func _nat_ime(_id: int, _x: int, _y: int, _w: int, _h: int):
        _set_error("")
    end

    func _nat_icon(_id: int, _pixels: void*, _w: int, _h: int, _stride: int): bool:
        if _error.Len() == 0:
            _set_error("Wayland window backend scaffold does not support window icons yet")
        end
        ret false
    end

    func _nat_alloc(_id: int, _w: int, _h: int): void*:
        if _error.Len() == 0:
            _set_error("Wayland window backend scaffold does not provide a native pixel buffer yet")
        end
        ret null
    end

    func _nat_blit(_id: int, _rects: Vector<Rect>):
        _set_error("")
    end

    func _nat_pump(_timeout: int):
        _set_error("")
    end

    func _nat_wake():
        _set_error("")
    end

    func _nat_clip_get(): str:
        ret str.Clone("")
    end

    func _nat_clip_set(_text: str): bool:
        ret false
    end

    func _nat_scheme(): ColorScheme:
        ret ColorScheme.Light
    end

    func _nat_shown(_id: int, _x: int, _y: int): u32:
        ret 0
    end

    func _nat_handle(_id: int): void*:
        ret null
    end
end
