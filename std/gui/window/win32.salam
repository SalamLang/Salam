package window

if SALAM_OS_WINDOWS:
    link dynamic "user32"
    link dynamic "kernel32"
    link dynamic "gdi32"
    link dynamic "imm32"

    extern:
        func GetModuleHandleW(name: void*): void*
        func LoadLibraryW(name: void*): void*
        func GetProcAddress(module: void*, name: str): void*
        func RegisterClassExW(cls: void*): u16
        func CreateWindowExW(
            ex_style: u32, class_name: void*, window_name: void*, style: u32, x: int, y: int, width: int,
            height: int, parent: void*, menu: void*, instance: void*, param: void*
        ): void*
        func DefWindowProcW(hwnd: void*, msg: u32, wparam: usize, lparam: size): size
        func DestroyWindow(hwnd: void*): int
        func ShowWindow(hwnd: void*, cmd: int): int
        func SetForegroundWindow(hwnd: void*): int
        func SetFocus(hwnd: void*): void*
        func PeekMessageW(msg: void*, hwnd: void*, filter_min: u32, filter_max: u32, remove: u32): int
        func PostMessageW(hwnd: void*, msg: u32, wparam: usize, lparam: size): int
        func SendMessageW(hwnd: void*, msg: u32, wparam: usize, lparam: size): size
        func MsgWaitForMultipleObjects(count: u32, handles: void*, wait_all: int, ms: u32, mask: u32): u32
        func TranslateMessage(msg: void*): int
        func DispatchMessageW(msg: void*): size
        func SetWindowTextW(hwnd: void*, text: void*): int
        func SetWindowPos(hwnd: void*, after: void*, x: int, y: int, width: int, height: int, flags: u32): int
        func GetClientRect(hwnd: void*, rect: void*): int
        func GetWindowRect(hwnd: void*, rect: void*): int
        func AdjustWindowRectEx(rect: void*, style: u32, menu: int, ex_style: u32): int
        func GetWindowLongW(hwnd: void*, index: int): i32
        func SetWindowLongW(hwnd: void*, index: int, value: i32): i32
        func GetSystemMetrics(index: int): int
        func LoadCursorW(instance: void*, name: void*): void*
        func SetCursor(cursor: void*): void*
        func GetDC(hwnd: void*): void*
        func ReleaseDC(hwnd: void*, hdc: void*): int
        func BeginPaint(hwnd: void*, paint: void*): void*
        func EndPaint(hwnd: void*, paint: void*): int
        func FillRect(hdc: void*, rect: void*, brush: void*): int
        func TrackMouseEvent(track: void*): int
        func SetCapture(hwnd: void*): void*
        func ReleaseCapture(): int
        func ScreenToClient(hwnd: void*, point: void*): int
        func GetKeyState(key: int): i16
        func MonitorFromWindow(hwnd: void*, flags: u32): void*
        func GetMonitorInfoW(monitor: void*, info: void*): int
        func CreateIconIndirect(info: void*): void*
        func OpenClipboard(hwnd: void*): int
        func CloseClipboard(): int
        func EmptyClipboard(): int
        func GetClipboardData(format: u32): void*
        func SetClipboardData(format: u32, data: void*): void*
        func GlobalAlloc(flags: u32, bytes: usize): void*
        func GlobalLock(mem_handle: void*): void*
        func GlobalUnlock(mem_handle: void*): int
        func GlobalFree(mem_handle: void*): void*
        func CreateDIBSection(hdc: void*, info: void*, usage: u32, bits: void*, section: void*, offset: u32): void*
        func CreateCompatibleDC(hdc: void*): void*
        func SelectObject(hdc: void*, object: void*): void*
        func DeleteObject(object: void*): int
        func DeleteDC(hdc: void*): int
        func BitBlt(
            hdc: void*, x: int, y: int, width: int, height: int, src: void*, src_x: int, src_y: int, rop: u32
        ): int
        func GetPixel(hdc: void*, x: int, y: int): u32
        func CreateBitmap(width: int, height: int, planes: u32, bits: u32, data: void*): void*
        func CreateSolidBrush(color: u32): void*
        func GdiFlush(): int
        func ImmGetContext(hwnd: void*): void*
        func ImmReleaseContext(hwnd: void*, imc: void*): int
        func ImmGetCompositionStringW(imc: void*, index: u32, buf: void*, size: u32): i32
        func ImmSetCompositionWindow(imc: void*, form: void*): int
        func ImmSetCandidateWindow(imc: void*, form: void*): int
        func MultiByteToWideChar(code_page: u32, flags: u32, text: str, length: i32, wide: void*, wide_len: i32): i32
        func WideCharToMultiByte(
            code_page: u32, flags: u32, wide: void*, wide_len: i32, out: void*, out_len: i32, def: void*,
            used: void*
        ): i32
    end
    if SALAM_ARCH_X86:
        extern:
            func VirtualAlloc(addr: void*, size: void*, kind: u32, protect: u32): void*
            func VirtualProtect(addr: void*, size: void*, protect: u32, old: void*): int
        end
    end

    mut _ws := Vector {} as Vector<_WWin>
    mut _w32_class := null as void*
    mut _w32_msgwnd := null as void*
    mut _w32_msg := null as void*
    mut _w32_proc := null as void*
    mut _w32_dpi_for_window := null as void*
    mut _w32_dark := false
    mut _w32_cursors := Vector {} as Vector<void*>

    struct _WClass:
        pub size: u32 = 0 as u32
        pub style: u32 = 0 as u32
        pub proc: void* = null
        pub class_extra: i32 = 0
        pub window_extra: i32 = 0
        pub instance: void* = null
        pub icon: void* = null
        pub cursor: void* = null
        pub background: void* = null
        pub menu_name: void* = null
        pub class_name: void* = null
        pub icon_small: void* = null
    end

    struct _WWin:
        pub hwnd: void* = null
        pub dc: void* = null
        pub dib: void* = null
        pub old: void* = null
        pub bits: void* = null
        pub brush: void* = null
        pub style: u32 = 0 as u32
        pub tracking: bool = false
        pub high: int = 0
        pub composing: bool = false
        pub saved_style: i32 = 0
        pub saved_x: int = 0
        pub saved_y: int = 0
        pub saved_w: int = 0
        pub saved_h: int = 0
        pub buttons: int = 0
        pub open: bool = false
    end

    export:
        func salam_window_w32_proc(hwnd: void*, msg: u32, wparam: usize, lparam: size): size:
            ret _w32_on_message(hwnd, msg, wparam, lparam)
        end
    end

    if SALAM_ARCH_X86:
        func _w32_thunk(fn: void*, words: int): void*:
            page := VirtualAlloc(null, (4096 as i64) as void*, 0x3000 as u32, 4 as u32)
            if page == null:
                ret fn
            end
            code := page as u8*
            size_bytes := words * 4
            mut at := 0
            repeat words:
                code[at] = 0xFF as u8
                code[at + 1] = 0x74 as u8
                code[at + 2] = 0x24 as u8
                code[at + 3] = size_bytes as u8
                at += 4
            end
            addr := fn as i64
            code[at] = 0xB8 as u8
            repeat 4 in i:
                code[at + 1 + i] = ((addr >> (i * 8)) & (0xFF as i64)) as u8
            end
            code[at + 5] = 0xFF as u8
            code[at + 6] = 0xD0 as u8
            code[at + 7] = 0x83 as u8
            code[at + 8] = 0xC4 as u8
            code[at + 9] = size_bytes as u8
            code[at + 10] = 0xC2 as u8
            code[at + 11] = size_bytes as u8
            code[at + 12] = 0 as u8
            old := mem.Allocate(8 as u64)
            _done := VirtualProtect(page, (4096 as i64) as void*, 0x20 as u32, old)
            mem.Free(old)
            ret page
        end
    else:
        func _w32_thunk(fn: void*, _words: int): void*:
            ret fn
        end
    end

    func _w32_wide(s: str): void*:
        needed := MultiByteToWideChar(65001 as u32, 0 as u32, s, -1, null, 0)
        buf := mem.AllocateZeroed(((needed + 1) as u64) * (2 as u64))
        MultiByteToWideChar(65001 as u32, 0 as u32, s, -1, buf, needed + 1)
        ret buf
    end

    func _w32_utf8(wide: void*, units: int): str:
        if wide == null or units == 0:
            ret str.Clone("")
        end
        needed := WideCharToMultiByte(65001 as u32, 0 as u32, wide, units, null, 0, null, null)
        if needed <= 0:
            ret str.Clone("")
        end
        buf := mem.AllocateZeroed((needed + 1) as u64)
        WideCharToMultiByte(65001 as u32, 0 as u32, wide, units, buf, needed + 1, null, null)
        (buf as u8*)[needed] = 0 as u8
        ret buf as str
    end

    func _w32_symbol(library: str, name: str): void*:
        wide := _w32_wide(library)
        module := LoadLibraryW(wide)
        mem.Free(wide)
        if module == null:
            ret null
        end
        ret GetProcAddress(module, name)
    end

    func _w32_find(hwnd: void*): int:
        repeat _ws.len() in i:
            if _ws[i].open and _ws[i].hwnd == hwnd:
                ret i
            end
        end
        ret -1
    end

    func _w32_lo(v: i64): int:
        x := (v & (0xFFFF as i64)) as int
        ret x >= 32768 ? x - 65536 : x
    end

    func _w32_hi(v: i64): int:
        x := ((v >> 16) & (0xFFFF as i64)) as int
        ret x >= 32768 ? x - 65536 : x
    end

    func _w32_mods(): int:
        mut m := 0
        if GetKeyState(0x10) < (0 as i16):
            m |= ModShift
        end
        if GetKeyState(0x11) < (0 as i16):
            m |= ModControl
        end
        if GetKeyState(0x12) < (0 as i16):
            m |= ModAlt
        end
        if GetKeyState(0x5B) < (0 as i16) or GetKeyState(0x5C) < (0 as i16):
            m |= ModSuper
        end
        ret m
    end

    func _w32_scan_key(scan: int, extended: bool): Key:
        if extended:
            ret match scan:
                0x1C: Key.NumpadEnter end
                0x1D: Key.ControlRight end
                0x35: Key.NumpadDivide end
                0x37: Key.PrintScreen end
                0x38: Key.AltRight end
                0x45: Key.NumLock end
                0x47: Key.Home end
                0x48: Key.Up end
                0x49: Key.PageUp end
                0x4B: Key.Left end
                0x4D: Key.Right end
                0x4F: Key.End end
                0x50: Key.Down end
                0x51: Key.PageDown end
                0x52: Key.Insert end
                0x53: Key.Delete end
                0x5B: Key.SuperLeft end
                0x5C: Key.SuperRight end
                0x5D: Key.ContextMenu end
                else: Key.Unknown end
            end
        end
        ret match scan:
            0x01: Key.Escape end
            0x02: Key.Digit1 end
            0x03: Key.Digit2 end
            0x04: Key.Digit3 end
            0x05: Key.Digit4 end
            0x06: Key.Digit5 end
            0x07: Key.Digit6 end
            0x08: Key.Digit7 end
            0x09: Key.Digit8 end
            0x0A: Key.Digit9 end
            0x0B: Key.Digit0 end
            0x0C: Key.Minus end
            0x0D: Key.Equal end
            0x0E: Key.Backspace end
            0x0F: Key.Tab end
            0x10: Key.Q end
            0x11: Key.W end
            0x12: Key.E end
            0x13: Key.R end
            0x14: Key.T end
            0x15: Key.Y end
            0x16: Key.U end
            0x17: Key.I end
            0x18: Key.O end
            0x19: Key.P end
            0x1A: Key.BracketLeft end
            0x1B: Key.BracketRight end
            0x1C: Key.Enter end
            0x1D: Key.ControlLeft end
            0x1E: Key.A end
            0x1F: Key.S end
            0x20: Key.D end
            0x21: Key.F end
            0x22: Key.G end
            0x23: Key.H end
            0x24: Key.J end
            0x25: Key.K end
            0x26: Key.L end
            0x27: Key.Semicolon end
            0x28: Key.Quote end
            0x29: Key.Backquote end
            0x2A: Key.ShiftLeft end
            0x2B: Key.Backslash end
            0x2C: Key.Z end
            0x2D: Key.X end
            0x2E: Key.C end
            0x2F: Key.V end
            0x30: Key.B end
            0x31: Key.N end
            0x32: Key.M end
            0x33: Key.Comma end
            0x34: Key.Period end
            0x35: Key.Slash end
            0x36: Key.ShiftRight end
            0x37: Key.NumpadMultiply end
            0x38: Key.AltLeft end
            0x39: Key.Space end
            0x3A: Key.CapsLock end
            0x3B: Key.F1 end
            0x3C: Key.F2 end
            0x3D: Key.F3 end
            0x3E: Key.F4 end
            0x3F: Key.F5 end
            0x40: Key.F6 end
            0x41: Key.F7 end
            0x42: Key.F8 end
            0x43: Key.F9 end
            0x44: Key.F10 end
            0x45: Key.Pause end
            0x46: Key.ScrollLock end
            0x47: Key.Numpad7 end
            0x48: Key.Numpad8 end
            0x49: Key.Numpad9 end
            0x4A: Key.NumpadSubtract end
            0x4B: Key.Numpad4 end
            0x4C: Key.Numpad5 end
            0x4D: Key.Numpad6 end
            0x4E: Key.NumpadAdd end
            0x4F: Key.Numpad1 end
            0x50: Key.Numpad2 end
            0x51: Key.Numpad3 end
            0x52: Key.Numpad0 end
            0x53: Key.NumpadDecimal end
            0x56: Key.IntlBackslash end
            0x57: Key.F11 end
            0x58: Key.F12 end
            else: Key.Unknown end
        end
    end

    func _w32_registry_dark(): bool:
        get := _w32_symbol("advapi32.dll", "RegGetValueW")
        if get == null:
            ret false
        end
        f := get as extern stdcall func (void*, void*, void*, u32, void*, void*, void*) i32
        key := _w32_wide("Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize")
        name := _w32_wide("AppsUseLightTheme")
        data := mem.AllocateZeroed(16 as u64) as u32*
        data[2] = 4 as u32
        root := ((0x80000001 as i64) as size) as void*
        status := f(root, key, name, 0x10 as u32, null, data as void*, ((data as i64) + (8 as i64)) as void*)
        light := data[0]
        mem.Free(key)
        mem.Free(name)
        mem.Free(data as void*)
        ret status == 0 and light == (0 as u32)
    end

    func _w32_dpi_aware():
        context := _w32_symbol("user32.dll", "SetProcessDpiAwarenessContext")
        if context != null:
            f := context as extern stdcall func (void*) i32
            if f(((0 - 4) as size) as void*) != 0:
                ret
            end
            if f(((0 - 3) as size) as void*) != 0:
                ret
            end
        end
        awareness := _w32_symbol("shcore.dll", "SetProcessDpiAwareness")
        if awareness != null:
            g := awareness as extern stdcall func (i32) i32
            if g(2) == 0:
                ret
            end
        end
        legacy := _w32_symbol("user32.dll", "SetProcessDPIAware")
        if legacy != null:
            h := legacy as extern stdcall func () i32
            _r := h()
        end
    end

    func _w32_system_dpi(): int:
        sym := _w32_symbol("user32.dll", "GetDpiForSystem")
        if sym != null:
            f := sym as extern stdcall func () u32
            d := f() as int
            if d > 0:
                ret d
            end
        end
        ret 96
    end

    func _w32_window_dpi(hwnd: void*): int:
        if _w32_dpi_for_window != null:
            f := _w32_dpi_for_window as extern stdcall func (void*) u32
            d := f(hwnd) as int
            if d > 0:
                ret d
            end
        end
        ret _w32_system_dpi()
    end

    func _nat_init(): bool:
        _w32_dpi_aware()
        _w32_dpi_for_window = _w32_symbol("user32.dll", "GetDpiForWindow")
        _w32_proc = _w32_thunk(&salam_window_w32_proc, 4)
        _w32_msg = mem.AllocateZeroed(64 as u64)
        cls := mem.AllocateZeroed(sizeof(_WClass) as u64) as _WClass*
        _w32_class = _w32_wide("SalamPixelWindow")
        cls[0].size = sizeof(_WClass) as u32
        cls[0].proc = _w32_proc
        cls[0].instance = GetModuleHandleW(null)
        cls[0].cursor = LoadCursorW(null, ((32512 as size) as void*))
        cls[0].class_name = _w32_class
        atom := RegisterClassExW(cls as void*)
        mem.Free(cls as void*)
        if atom == (0 as u16):
            _set_error("Windows refused to register the window class")
            ret false
        end
        _w32_msgwnd = CreateWindowExW(
            0 as u32, _w32_class, null, 0 as u32, 0, 0, 0, 0, ((0 - 3) as size) as void*, null,
            GetModuleHandleW(null), null
        )
        repeat 12:
            _w32_cursors.push(null)
        end
        _w32_dark = _w32_registry_dark()
        ret true
    end

    func _w32_style(o: Options): u32:
        if not o.decorated:
            ret 0x80000000
        end
        if not o.resizable:
            ret 0x00CA0000
        end
        ret 0x00CF0000
    end

    func _w32_outer(style: u32, pw: int, ph: int): Rect:
        r := mem.AllocateZeroed(16 as u64) as i32*
        r[2] = pw
        r[3] = ph
        AdjustWindowRectEx(r as void*, style, 0, 0 as u32)
        out := Rect { x = r[0], y = r[1], width = r[2] - r[0], height = r[3] - r[1] }
        mem.Free(r as void*)
        ret out
    end

    func _w32_dark_title(hwnd: void*):
        set := _w32_symbol("dwmapi.dll", "DwmSetWindowAttribute")
        if set == null:
            ret
        end
        f := set as extern stdcall func (void*, u32, void*, u32) i32
        value := mem.AllocateZeroed(8 as u64) as i32*
        value[0] = _w32_dark ? 1 : 0
        _r := f(hwnd, 20 as u32, value as void*, 4 as u32)
        mem.Free(value as void*)
    end

    func _nat_open(id: int, o: Options): bool:
        until _ws.len() <= id:
            _ws.push(_WWin {})
        end
        mut scale := o.scale
        if scale <= 0.0:
            scale = _env_scale()
        end
        if scale <= 0.0:
            scale = (_w32_system_dpi() as f64) / 96.0
        end
        pw := _phys(o.width, scale)
        ph := _phys(o.height, scale)
        _set_geometry(id, pw, ph, scale)
        style := _w32_style(o)
        outer := _w32_outer(style, pw, ph)
        mut x := (o.x * scale) as int + outer.x
        mut y := (o.y * scale) as int + outer.y
        if o.centered:
            x = (GetSystemMetrics(0) - outer.width) / 2
            y = (GetSystemMetrics(1) - outer.height) / 2
        end
        title := _w32_wide(o.title)
        hwnd := CreateWindowExW(
            0 as u32, _w32_class, title, style, x, y, outer.width, outer.height, null, null,
            GetModuleHandleW(null), null
        )
        mem.Free(title)
        if hwnd == null:
            _set_error("Windows could not create the window")
            ret false
        end
        bg := o.background
        color := ((bg >> 24) & (255 as u32)) | (((bg >> 16) & (255 as u32)) << 8) | (((bg >> 8) & (255 as u32)) << 16)
        _ws[id] = _WWin { hwnd = hwnd, style = style, brush = CreateSolidBrush(color), open = true }
        if o.scale <= 0.0 and _env_scale() <= 0.0:
            dpi := _w32_window_dpi(hwnd)
            real := (dpi as f64) / 96.0
            if real != scale:
                _set_geometry(id, _phys(o.width, real), _phys(o.height, real), real)
                moved := _w32_outer(style, _wins[id].pw, _wins[id].ph)
                SetWindowPos(hwnd, null, 0, 0, moved.width, moved.height, 0x16 as u32)
            end
        end
        _w32_dark_title(hwnd)
        if o.visible:
            ShowWindow(hwnd, 5)
            SetForegroundWindow(hwnd)
        end
        ret true
    end

    func _w32_free_dib(id: int):
        mut v := _ws[id]
        if v.dc != null:
            _o := SelectObject(v.dc, v.old)
            DeleteDC(v.dc)
            v.dc = null
        end
        if v.dib != null:
            DeleteObject(v.dib)
            v.dib = null
        end
        v.bits = null
        _ws[id] = v
    end

    func _nat_close(id: int):
        _w32_free_dib(id)
        mut v := _ws[id]
        hwnd := v.hwnd
        v.open = false
        if v.brush != null:
            DeleteObject(v.brush)
            v.brush = null
        end
        _ws[id] = v
        DestroyWindow(hwnd)
    end

    func _nat_title(id: int, title: str):
        wide := _w32_wide(title)
        SetWindowTextW(_ws[id].hwnd, wide)
        mem.Free(wide)
    end

    func _nat_resize(id: int, pw: int, ph: int):
        v := _ws[id]
        outer := _w32_outer(GetWindowLongW(v.hwnd, -16) as u32, pw, ph)
        SetWindowPos(v.hwnd, null, 0, 0, outer.width, outer.height, 0x16 as u32)
    end

    func _nat_limits(id: int):
        v := _ws[id]
        r := mem.AllocateZeroed(16 as u64)
        GetWindowRect(v.hwnd, r)
        rr := r as i32*
        SetWindowPos(v.hwnd, null, 0, 0, rr[2] - rr[0], rr[3] - rr[1], 0x16 as u32)
        mem.Free(r)
    end

    func _w32_fullscreen(id: int, enabled: bool):
        mut v := _ws[id]
        hwnd := v.hwnd
        if enabled:
            r := mem.AllocateZeroed(16 as u64) as i32*
            GetWindowRect(hwnd, r as void*)
            v.saved_x = r[0]
            v.saved_y = r[1]
            v.saved_w = r[2] - r[0]
            v.saved_h = r[3] - r[1]
            v.saved_style = GetWindowLongW(hwnd, -16)
            mem.Free(r as void*)
            _ws[id] = v
            info := mem.AllocateZeroed(64 as u64) as i32*
            info[0] = 40
            monitor := MonitorFromWindow(hwnd, 2 as u32)
            GetMonitorInfoW(monitor, info as void*)
            SetWindowLongW(hwnd, -16, (0x90000000 as u32) as i32)
            SetWindowPos(hwnd, null, info[1], info[2], info[3] - info[1], info[4] - info[2], 0x20 as u32)
            mem.Free(info as void*)
        else v.saved_style != 0:
            SetWindowLongW(hwnd, -16, v.saved_style)
            SetWindowPos(hwnd, null, v.saved_x, v.saved_y, v.saved_w, v.saved_h, 0x20 as u32)
            v.saved_style = 0
            _ws[id] = v
        end
    end

    func _nat_state(id: int, what: int):
        hwnd := _ws[id].hwnd
        switch what:
            0:
                ShowWindow(hwnd, 6)
                break
            end
            1:
                ShowWindow(hwnd, 3)
                break
            end
            2:
                ShowWindow(hwnd, 9)
                break
            end
            3, 4:
                _w32_fullscreen(id, what == 3)
                break
            end
            else:
                ShowWindow(hwnd, 5)
                SetForegroundWindow(hwnd)
                _f := SetFocus(hwnd)
                break
            end
        end
    end

    func _w32_cursor_id(cursor: Cursor): int:
        ret match cursor:
            Cursor.Default: 32512 end
            Cursor.Pointer: 32649 end
            Cursor.Text: 32513 end
            Cursor.Wait: 32514 end
            Cursor.Crosshair: 32515 end
            Cursor.Move: 32646 end
            Cursor.ResizeHorizontal: 32644 end
            Cursor.ResizeVertical: 32645 end
            Cursor.ResizeDiagonalUp: 32643 end
            Cursor.ResizeDiagonalDown: 32642 end
            Cursor.NotAllowed: 32648 end
            Cursor.Hidden: 0 end
        end
    end

    func _w32_apply_cursor(id: int):
        c := _wins[id].cursor
        if c == Cursor.Hidden:
            _old := SetCursor(null)
            ret
        end
        slot := c as int
        if _w32_cursors[slot] == null:
            _w32_cursors[slot] = LoadCursorW(null, ((_w32_cursor_id(c) as size) as void*))
        end
        _old := SetCursor(_w32_cursors[slot])
    end

    func _nat_cursor(id: int, _cursor: Cursor):
        if _wins[id].inside:
            _w32_apply_cursor(id)
        end
    end

    func _nat_ime(id: int, x: int, y: int, w: int, h: int):
        hwnd := _ws[id].hwnd
        imc := ImmGetContext(hwnd)
        if imc == null:
            ret
        end
        form := mem.AllocateZeroed(32 as u64) as i32*
        form[0] = 2
        form[1] = x
        form[2] = y
        ImmSetCompositionWindow(imc, form as void*)
        mem.Set(form as void*, 0, 32 as u64)
        form[1] = 0x80
        form[2] = x
        form[3] = y + h
        form[4] = x
        form[5] = y
        form[6] = x + w
        form[7] = y + h
        ImmSetCandidateWindow(imc, form as void*)
        mem.Free(form as void*)
        ImmReleaseContext(hwnd, imc)
    end

    func _w32_dib(width: int, height: int, bits: void**): void*:
        info := mem.AllocateZeroed(64 as u64) as i32*
        info[0] = 40
        info[1] = width
        info[2] = 0 - height
        (info as u16*)[6] = 1 as u16
        (info as u16*)[7] = 32 as u16
        dib := CreateDIBSection(null, info as void*, 0 as u32, bits as void*, null, 0 as u32)
        mem.Free(info as void*)
        ret dib
    end

    func _nat_icon(id: int, pixels: void*, width: int, height: int, stride: int): bool:
        holder := mem.AllocateZeroed(16 as u64) as void**
        color := _w32_dib(width, height, holder)
        bits := holder[0]
        mem.Free(holder as void*)
        if color == null or bits == null:
            ret false
        end
        repeat height in y:
            row := ((pixels as i64) + (y as i64) * (stride as i64)) as u32*
            out := ((bits as i64) + ((y * width * 4) as i64)) as u32*
            repeat width in x:
                p := row[x]
                a := (p >> 24) & (255 as u32)
                mut r := (p >> 16) & (255 as u32)
                mut g := (p >> 8) & (255 as u32)
                mut b := p & (255 as u32)
                if a > (0 as u32) and a < (255 as u32):
                    r = (r * (255 as u32) + a / (2 as u32)) / a
                    g = (g * (255 as u32) + a / (2 as u32)) / a
                    b = (b * (255 as u32) + a / (2 as u32)) / a
                end
                out[x] = (a << 24) | (r << 16) | (g << 8) | b
            end
        end
        mask := CreateBitmap(width, height, 1 as u32, 1 as u32, null)
        word := sizeof(usize) as int
        info := mem.AllocateZeroed(64 as u64)
        (info as i32*)[0] = 1
        at := word == 8 ? 16 : 12
        (((info as i64) + (at as i64)) as void**)[0] = mask
        (((info as i64) + ((at + word) as i64)) as void**)[0] = color
        icon := CreateIconIndirect(info)
        mem.Free(info)
        DeleteObject(mask)
        DeleteObject(color)
        if icon == null:
            ret false
        end
        hwnd := _ws[id].hwnd
        SendMessageW(hwnd, 0x80 as u32, 0 as usize, (icon as size))
        SendMessageW(hwnd, 0x80 as u32, 1 as usize, (icon as size))
        ret true
    end

    func _nat_alloc(id: int, width: int, height: int): void*:
        _w32_free_dib(id)
        holder := mem.AllocateZeroed(16 as u64) as void**
        dib := _w32_dib(width, height, holder)
        bits := holder[0]
        mem.Free(holder as void*)
        if dib == null or bits == null:
            ret null
        end
        dc := CreateCompatibleDC(null)
        mut v := _ws[id]
        v.dib = dib
        v.dc = dc
        v.old = SelectObject(dc, dib)
        v.bits = bits
        _ws[id] = v
        ret bits
    end

    func _w32_copy(id: int, hdc: void*, rx: int, ry: int, rw: int, rh: int):
        v := _ws[id]
        w := _wins[id]
        if v.dc == null:
            ret
        end
        r := _clip_rect(Rect { x = rx, y = ry, width = rw, height = rh }, w.buf_w, w.buf_h)
        if r.width > 0:
            BitBlt(hdc, r.x, r.y, r.width, r.height, v.dc, r.x, r.y, 0xCC0020 as u32)
        end
    end

    func _nat_blit(id: int, rects: Vector<Rect>):
        _f := GdiFlush()
        hwnd := _ws[id].hwnd
        hdc := GetDC(hwnd)
        each r in rects:
            _w32_copy(id, hdc, r.x, r.y, r.width, r.height)
        end
        ReleaseDC(hwnd, hdc)
    end

    func _w32_paint(id: int, hwnd: void*):
        paint := mem.AllocateZeroed(128 as u64)
        hdc := BeginPaint(hwnd, paint)
        word := sizeof(usize) as int
        r := ((paint as i64) + ((word + 4) as i64)) as i32*
        v := _ws[id]
        if v.dc != null:
            _w32_copy(id, hdc, r[0], r[1], r[2] - r[0], r[3] - r[1])
        else:
            FillRect(hdc, r as void*, v.brush)
            _request_redraw(id)
        end
        EndPaint(hwnd, paint)
        mem.Free(paint)
    end

    func _w32_point(id: int, kind: EventKind, lparam: size, button: MouseButton):
        s := _wins[id].scale
        l := lparam as i64
        _push(Event {
            kind = kind, window = id, x = _logical(_w32_lo(l), s), y = _logical(_w32_hi(l), s),
            button = button, modifiers = _w32_mods()
        })
    end

    func _w32_button(id: int, hwnd: void*, lparam: size, button: MouseButton, down: bool):
        mut v := _ws[id]
        if down:
            if v.buttons == 0:
                _c := SetCapture(hwnd)
            end
            v.buttons++
        else:
            v.buttons = v.buttons > 0 ? v.buttons - 1 : 0
            if v.buttons == 0:
                _r := ReleaseCapture()
            end
        end
        _ws[id] = v
        _w32_point(id, down ? EventKind.PointerDown : EventKind.PointerUp, lparam, button)
    end

    func _w32_wheel(id: int, hwnd: void*, wparam: usize, lparam: size, horizontal: bool):
        point := mem.AllocateZeroed(16 as u64) as i32*
        l := lparam as i64
        point[0] = _w32_lo(l)
        point[1] = _w32_hi(l)
        ScreenToClient(hwnd, point as void*)
        s := _wins[id].scale
        delta := (_w32_hi(wparam as i64) as f64) / 120.0
        _push(Event {
            kind = EventKind.Wheel, window = id, x = _logical(point[0], s), y = _logical(point[1], s),
            delta_x = horizontal ? delta : 0.0, delta_y = horizontal ? 0.0 : 0.0 - delta,
            delta_mode = WheelMode.Line, modifiers = _w32_mods()
        })
        mem.Free(point as void*)
    end

    func _w32_key(id: int, wparam: usize, lparam: size, down: bool):
        l := lparam as i64
        scan := ((l >> 16) & (0xFF as i64)) as int
        extended := ((l >> 24) & (1 as i64)) == (1 as i64)
        repeated := down and ((l >> 30) & (1 as i64)) == (1 as i64)
        mut key := _w32_scan_key(scan, extended)
        vk := wparam as int
        if vk == 0x13:
            key = Key.Pause
        end
        _push(Event {
            kind = down ? EventKind.KeyDown : EventKind.KeyUp, window = id, key = key,
            code = scan | (extended ? 0xE000 : 0), modifiers = _w32_mods(), repeated = repeated
        })
    end

    func _w32_text(id: int, cp: int):
        if cp < 32 or cp == 127:
            ret
        end
        mods := _w32_mods()
        if (mods & ModControl) != 0 and (mods & ModAlt) == 0:
            ret
        end
        mut b := str.NewBuilder()
        str.BufAppendCp(b, cp)
        text := str.BufStr(b)
        _push(Event { kind = EventKind.TextInput, window = id, text = text, modifiers = mods })
        mem.Free(text as void*)
    end

    func _w32_char(id: int, unit: int):
        mut v := _ws[id]
        if unit >= 0xD800 and unit <= 0xDBFF:
            v.high = unit
            _ws[id] = v
            ret
        end
        if unit >= 0xDC00 and unit <= 0xDFFF:
            if v.high != 0:
                cp := 0x10000 + ((v.high - 0xD800) << 10) + (unit - 0xDC00)
                v.high = 0
                _ws[id] = v
                _w32_text(id, cp)
            end
            ret
        end
        v.high = 0
        _ws[id] = v
        _w32_text(id, unit)
    end

    func _w32_ime_text(imc: void*, index: u32): str:
        bytes := ImmGetCompositionStringW(imc, index, null, 0 as u32)
        if bytes <= 0:
            ret str.Clone("")
        end
        buf := mem.AllocateZeroed((bytes + 4) as u64)
        ImmGetCompositionStringW(imc, index, buf, bytes as u32)
        text := _w32_utf8(buf, bytes / 2)
        mem.Free(buf)
        ret text
    end

    func _w32_composition(id: int, hwnd: void*, flags: i64):
        imc := ImmGetContext(hwnd)
        if imc == null:
            ret
        end
        if (flags & (0x800 as i64)) != 0:
            text := _w32_ime_text(imc, 0x800 as u32)
            if text.len() > 0:
                _push(Event { kind = EventKind.ImeCommit, window = id, text = text })
            end
            mem.Free(text as void*)
        end
        if (flags & (0x8 as i64)) != 0:
            text := _w32_ime_text(imc, 0x8 as u32)
            mut cursor := text.len()
            if (flags & (0x80 as i64)) != 0:
                units := ImmGetCompositionStringW(imc, 0x80 as u32, null, 0 as u32)
                bytes := ImmGetCompositionStringW(imc, 0x8 as u32, null, 0 as u32)
                if units >= 0 and bytes > 0:
                    buf := mem.AllocateZeroed((bytes + 4) as u64)
                    ImmGetCompositionStringW(imc, 0x8 as u32, buf, bytes as u32)
                    head := _w32_utf8(buf, units)
                    cursor = head.len()
                    mem.Free(head as void*)
                    mem.Free(buf)
                end
            end
            _push(Event { kind = EventKind.ImePreedit, window = id, text = text, cursor = cursor })
            mem.Free(text as void*)
        end
        ImmReleaseContext(hwnd, imc)
    end

    func _w32_minmax(id: int, lparam: size):
        w := _wins[id]
        style := GetWindowLongW(_ws[id].hwnd, -16) as u32
        info := (lparam as i64) as i32*
        if not w.resizable:
            outer := _w32_outer(style, w.pw, w.ph)
            info[6] = outer.width
            info[7] = outer.height
            info[8] = outer.width
            info[9] = outer.height
            ret
        end
        if w.min_w > 0.0 or w.min_h > 0.0:
            outer := _w32_outer(style, _phys(w.min_w, w.scale), _phys(w.min_h, w.scale))
            info[6] = outer.width
            info[7] = outer.height
        end
        if w.max_w > 0.0 or w.max_h > 0.0:
            outer := _w32_outer(style, w.max_w > 0.0 ? _phys(w.max_w, w.scale) : 32767, w.max_h > 0.0 ? _phys(w.max_h, w.scale) : 32767)
            info[8] = outer.width
            info[9] = outer.height
        end
    end

    func _w32_on_message(hwnd: void*, msg: u32, wparam: usize, lparam: size): size:
        if hwnd == _w32_msgwnd and _w32_msgwnd != null:
            ret DefWindowProcW(hwnd, msg, wparam, lparam)
        end
        id := _w32_find(hwnd)
        if id < 0 or not _alive(id):
            ret DefWindowProcW(hwnd, msg, wparam, lparam)
        end
        m := msg as int
        switch m:
            0x10:
                _push(Event { kind = EventKind.CloseRequested, window = id })
                ret 0
            end
            0x05:
                if wparam != (1 as usize):
                    l := lparam as i64
                    pw := (l & (0xFFFF as i64)) as int
                    ph := ((l >> 16) & (0xFFFF as i64)) as int
                    if pw != _wins[id].pw or ph != _wins[id].ph:
                        _push(Event { kind = EventKind.Resized, window = id, physical_width = pw, physical_height = ph })
                    end
                end
                ret 0
            end
            0x0F:
                _w32_paint(id, hwnd)
                ret 0
            end
            0x14:
                ret 1
            end
            0x07, 0x08:
                gained := m == 0x07
                if gained != _wins[id].focused:
                    _push(Event { kind = gained ? EventKind.FocusIn : EventKind.FocusOut, window = id })
                end
                ret 0
            end
            0x200:
                mut v := _ws[id]
                if not v.tracking:
                    track := mem.AllocateZeroed(32 as u64)
                    word := sizeof(usize) as int
                    (track as u32*)[0] = (word == 8 ? 24 : 16) as u32
                    (track as u32*)[1] = 2 as u32
                    (((track as i64) + (8 as i64)) as void**)[0] = hwnd
                    TrackMouseEvent(track)
                    mem.Free(track)
                    v.tracking = true
                    _ws[id] = v
                    _w32_point(id, EventKind.PointerEnter, lparam, MouseButton.None)
                end
                _w32_point(id, EventKind.PointerMove, lparam, MouseButton.None)
                ret 0
            end
            0x2A3:
                mut v := _ws[id]
                v.tracking = false
                _ws[id] = v
                _push(Event { kind = EventKind.PointerLeave, window = id, x = _wins[id].last_x, y = _wins[id].last_y })
                ret 0
            end
            0x201, 0x202:
                _w32_button(id, hwnd, lparam, MouseButton.Left, m == 0x201)
                ret 0
            end
            0x204, 0x205:
                _w32_button(id, hwnd, lparam, MouseButton.Right, m == 0x204)
                ret 0
            end
            0x207, 0x208:
                _w32_button(id, hwnd, lparam, MouseButton.Middle, m == 0x207)
                ret 0
            end
            0x20B, 0x20C:
                which := ((wparam as i64) >> 16) & (0xFFFF as i64)
                _w32_button(id, hwnd, lparam, which == (1 as i64) ? MouseButton.Back : MouseButton.Forward, m == 0x20B)
                ret 1
            end
            0x20A, 0x20E:
                _w32_wheel(id, hwnd, wparam, lparam, m == 0x20E)
                ret 0
            end
            0x100, 0x101:
                _w32_key(id, wparam, lparam, m == 0x100)
                ret 0
            end
            0x104, 0x105:
                _w32_key(id, wparam, lparam, m == 0x104)
                ret DefWindowProcW(hwnd, msg, wparam, lparam)
            end
            0x102:
                _w32_char(id, (wparam as i64 & (0xFFFF as i64)) as int)
                ret 0
            end
            0x109:
                if wparam == (0xFFFF as usize):
                    ret 1
                end
                _w32_text(id, wparam as int)
                ret 0
            end
            0x10D:
                mut v := _ws[id]
                v.composing = true
                _ws[id] = v
                w := _wins[id]
                s := w.scale
                _nat_ime(id, (w.ime_x * s) as int, (w.ime_y * s) as int, _phys(w.ime_w, s), _phys(w.ime_h, s))
                ret 0
            end
            0x10F:
                _w32_composition(id, hwnd, lparam as i64)
                ret 0
            end
            0x10E:
                mut v := _ws[id]
                v.composing = false
                _ws[id] = v
                _push(Event { kind = EventKind.ImePreedit, window = id })
                ret 0
            end
            0x281:
                cleared := ((lparam as i64) & (0x7FFFFFFF as i64)) as size
                ret DefWindowProcW(hwnd, msg, wparam, cleared)
            end
            0x20:
                if ((lparam as i64) & (0xFFFF as i64)) == (1 as i64):
                    _w32_apply_cursor(id)
                    ret 1
                end
                ret DefWindowProcW(hwnd, msg, wparam, lparam)
            end
            0x24:
                _w32_minmax(id, lparam)
                ret 0
            end
            0x2E0:
                dpi := ((wparam as i64) & (0xFFFF as i64)) as int
                if dpi > 0:
                    _push(Event { kind = EventKind.ScaleChanged, window = id, scale = (dpi as f64) / 96.0 })
                end
                r := (lparam as i64) as i32*
                SetWindowPos(hwnd, null, r[0], r[1], r[2] - r[0], r[3] - r[1], 0x14 as u32)
                ret 0
            end
            0x1A:
                dark := _w32_registry_dark()
                if dark != _w32_dark:
                    _w32_dark = dark
                    _w32_dark_title(hwnd)
                    _push(Event { kind = EventKind.ColorSchemeChanged, window = id, scheme = dark ? ColorScheme.Dark : ColorScheme.Light })
                end
                ret DefWindowProcW(hwnd, msg, wparam, lparam)
            end
            else:
                ret DefWindowProcW(hwnd, msg, wparam, lparam)
            end
        end
        ret DefWindowProcW(hwnd, msg, wparam, lparam)
    end

    func _nat_pump(timeout: int):
        if timeout != 0 and PeekMessageW(_w32_msg, null, 0 as u32, 0 as u32, 0 as u32) == 0:
            wait := timeout < 0 ? 0xFFFFFFFF as u32 : timeout as u32
            _r := MsgWaitForMultipleObjects(0 as u32, null, 0, wait, 0x4FF as u32)
        end
        until PeekMessageW(_w32_msg, null, 0 as u32, 0 as u32, 1 as u32) != 0:
            TranslateMessage(_w32_msg)
            DispatchMessageW(_w32_msg)
        end
    end

    func _nat_wake():
        if _w32_msgwnd != null:
            PostMessageW(_w32_msgwnd, 0x8001 as u32, 0 as usize, 0 as size)
        end
    end

    func _nat_clip_get(): str:
        if OpenClipboard(_w32_msgwnd) == 0:
            ret str.Clone("")
        end
        handle := GetClipboardData(13 as u32)
        mut text := ""
        if handle != null:
            data := GlobalLock(handle)
            if data != null:
                mut units := 0
                until (data as u16*)[units] != (0 as u16):
                    units++
                end
                text = _w32_utf8(data, units)
                GlobalUnlock(handle)
            end
        end
        CloseClipboard()
        if text.len() == 0:
            ret str.Clone("")
        end
        ret text
    end

    func _nat_clip_set(text: str): bool:
        if OpenClipboard(_w32_msgwnd) == 0:
            ret false
        end
        EmptyClipboard()
        wide := _w32_wide(text)
        mut units := 0
        until (wide as u16*)[units] != (0 as u16):
            units++
        end
        bytes := ((units + 1) * 2) as usize
        handle := GlobalAlloc(2 as u32, bytes)
        mut done := false
        if handle != null:
            data := GlobalLock(handle)
            mem.Copy(data, wide, bytes as u64)
            GlobalUnlock(handle)
            done = SetClipboardData(13 as u32, handle) != null
            if not done:
                _f := GlobalFree(handle)
            end
        end
        mem.Free(wide)
        CloseClipboard()
        ret done
    end

    func _nat_scheme(): ColorScheme:
        ret _w32_registry_dark() ? ColorScheme.Dark : ColorScheme.Light
    end

    func _nat_shown(id: int, x: int, y: int): u32:
        hwnd := _ws[id].hwnd
        hdc := GetDC(hwnd)
        value := GetPixel(hdc, x, y)
        ReleaseDC(hwnd, hdc)
        if value == (0xFFFFFFFF as u32):
            ret 0
        end
        r := value & (255 as u32)
        g := (value >> 8) & (255 as u32)
        b := (value >> 16) & (255 as u32)
        ret (0xFF000000 as u32) | (r << 16) | (g << 8) | b
    end

    func _nat_handle(id: int): void*:
        ret _ws[id].hwnd
    end
end
