struct _Timer:
    pub id: int = 0
    pub due: i64 = 0
    pub every: i64 = 0
    pub again: bool = false
    pub live: bool = false
end

@en "Window"
@fa "پنجره"
pub struct Window:
    @en "id"
    @fa "شناسه"
    pub id: int = -1

    @en "IsOpen"
    @fa "باز است"
    pub func IsOpen(): bool:
        ret _alive(this.id)
    end

    @en "IsHeadless"
    @fa "بی سر است"
    pub func IsHeadless(): bool:
        ret _alive(this.id) and _wins[this.id].headless
    end

    @en "IsFocused"
    @fa "متمرکز است"
    pub func IsFocused(): bool:
        ret _alive(this.id) and _wins[this.id].focused
    end

    @en "SetTitle"
    @fa "تنظیم عنوان"
    pub func SetTitle(title: str):
        _w_title(this.id, title)
    end

    @en "Title"
    @fa "عنوان پنجره"
    pub func Title(): str:
        if not _alive(this.id):
            ret ""
        end
        ret _wins[this.id].title
    end

    @en "SetSize"
    @fa "تنظیم اندازه"
    pub func SetSize(width: f64, height: f64):
        _w_size(this.id, width, height)
    end

    @en "Size"
    @fa "اندازه"
    pub func Size(): WindowSize:
        ret _w_get_size(this.id)
    end

    @en "ScaleFactor"
    @fa "ضریب مقیاس"
    pub func ScaleFactor(): f64:
        if not _alive(this.id):
            ret 1.0
        end
        ret _wins[this.id].scale
    end

    @en "Present"
    @fa "ارائه"
    pub func Present(pixels: void*, width: int, height: int, stride: int, damage: Vector<Rect>): bool:
        ret _w_present(this.id, pixels, width, height, stride, damage)
    end

    @en "PresentAll"
    @fa "ارائه کامل"
    pub func PresentAll(pixels: void*, width: int, height: int, stride: int): bool:
        mut none := Vector {} as Vector<Rect>
        defer none.free()
        done := _w_present(this.id, pixels, width, height, stride, none)
        ret done
    end

    @en "RequestRedraw"
    @fa "درخواست بازکشی دوباره"
    pub func RequestRedraw():
        _request_redraw(this.id)
    end

    @en "SetCursor"
    @fa "تنظیم نشانگر"
    pub func SetCursor(cursor: Cursor):
        _w_cursor(this.id, cursor)
    end

    @en "SetImeRect"
    @fa "تنظیم جای نویسه ساز"
    pub func SetImeRect(x: f64, y: f64, width: f64, height: f64):
        _w_ime(this.id, x, y, width, height)
    end

    @en "SetMinSize"
    @fa "تنظیم کمترین اندازه"
    pub func SetMinSize(width: f64, height: f64):
        _w_limits(this.id, width, height, true)
    end

    @en "SetMaxSize"
    @fa "تنظیم بیشترین اندازه"
    pub func SetMaxSize(width: f64, height: f64):
        _w_limits(this.id, width, height, false)
    end

    @en "Minimize"
    @fa "کمینه کردن"
    pub func Minimize():
        _w_state(this.id, 0)
    end

    @en "Maximize"
    @fa "بیشینه کردن"
    pub func Maximize():
        _w_state(this.id, 1)
    end

    @en "Restore"
    @fa "بازگرداندن"
    pub func Restore():
        _w_state(this.id, 2)
    end

    @en "SetFullscreen"
    @fa "تنظیم تمام صفحه"
    pub func SetFullscreen(enabled: bool):
        _w_state(this.id, enabled ? 3 : 4)
    end

    @en "IsFullscreen"
    @fa "تمام صفحه است"
    pub func IsFullscreen(): bool:
        ret _alive(this.id) and _wins[this.id].fullscreen
    end

    @en "Focus"
    @fa "متمرکز کردن"
    pub func Focus():
        _w_state(this.id, 5)
    end

    @en "Close"
    @fa "بستن"
    pub func Close():
        _w_close(this.id)
    end

    @en "SetIcon"
    @fa "تنظیم نماد"
    pub func SetIcon(pixels: void*, width: int, height: int, stride: int): bool:
        ret _w_icon(this.id, pixels, width, height, stride)
    end

    @en "PixelAt"
    @fa "نقطه در"
    pub func PixelAt(x: int, y: int): u32:
        ret _w_pixel(this.id, x, y)
    end

    @en "ShownPixel"
    @fa "نقطه نمایش داده شده"
    pub func ShownPixel(x: int, y: int): u32:
        ret _w_shown(this.id, x, y)
    end

    @en "PresentCount"
    @fa "شمار ارائه"
    pub func PresentCount(): int:
        if this.id < 0 or this.id >= _wins.len():
            ret 0
        end
        ret _wins[this.id].presents
    end

    @en "LastDamage"
    @fa "آخرین ناحیه تغییر"
    pub func LastDamage(): Rect:
        if this.id < 0 or this.id >= _wins.len():
            ret Rect {}
        end
        w := _wins[this.id]
        ret Rect { x = w.dmg_x, y = w.dmg_y, width = w.dmg_w, height = w.dmg_h }
    end

    @en "LastDamageCount"
    @fa "شمار آخرین ناحیه ها"
    pub func LastDamageCount(): int:
        if this.id < 0 or this.id >= _wins.len():
            ret 0
        end
        ret _wins[this.id].dmg_n
    end

    @en "CurrentCursor"
    @fa "نشانگر کنونی"
    pub func CurrentCursor(): Cursor:
        if not _alive(this.id):
            ret Cursor.Default
        end
        ret _wins[this.id].cursor
    end

    @en "ImeRect"
    @fa "جای نویسه ساز"
    pub func ImeRect(): Rect:
        if not _alive(this.id):
            ret Rect {}
        end
        w := _wins[this.id]
        ret Rect { x = w.ime_x as int, y = w.ime_y as int, width = w.ime_w as int, height = w.ime_h as int }
    end

    @en "Handle"
    @fa "دستگیره"
    pub func Handle(): void*:
        if not _alive(this.id) or _wins[this.id].headless:
            ret null
        end
        ret _nat_handle(this.id)
    end
end

func _alive(id: int): bool:
    ret id >= 0 and id < _wins.len() and _wins[id].open
end

func _now(): i64:
    if _manual:
        ret _manual_now
    end
    ret time.MonoMillis()
end

func _setup():
    if _wake_cell == null:
        _wake_cell = mem.AllocateZeroed(8 as u64) as i64*
    end
    if _forced == 0:
        mode := os.Env("SALAM_WINDOW_BACKEND")
        _forced = mode == "headless" ? 2 : 1
        mem.Free(mode as void*)
    end
end

func _env_scale(): f64:
    text := os.Env("SALAM_SCALE_FACTOR")
    mut v := 0.0
    if text.len() > 0:
        v = str.ToFloat(text)
    end
    mem.Free(text as void*)
    if v < 0.25 or v > 8.0:
        ret 0.0
    end
    ret v
end

func _phys(v: f64, scale: f64): int:
    p := v * scale + 0.5
    if p < 1.0:
        ret 1
    end
    ret p as int
end

func _logical(v: int, scale: f64): f64:
    if scale <= 0.0:
        ret v as f64
    end
    ret (v as f64) / scale
end

func _ensure_native(): bool:
    if _native_ready:
        ret true
    end
    if _native_failed:
        ret false
    end
    if not _nat_init():
        _native_failed = true
        ret false
    end
    _native_ready = true
    ret true
end

func _set_error(text: str):
    _error = text
end

func _set_geometry(id: int, pw: int, ph: int, scale: f64):
    if id < 0 or id >= _wins.len():
        ret
    end
    mut w := _wins[id]
    w.pw = pw
    w.ph = ph
    if scale > 0.0:
        w.scale = scale
    end
    w.lw = _logical(pw, w.scale)
    w.lh = _logical(ph, w.scale)
    _wins[id] = w
end

func _queue_len(): int:
    ret _queue.len() - _queue_head
end

func _pop(): Event:
    e := _queue[_queue_head]
    _queue_head++
    if _queue_head >= _queue.len():
        _queue.clear()
        _queue_head = 0
    end
    if e.text.len() > 0:
        _last_text = e.text
        _last_owned = true
    end
    ret e
end

func _drop_last():
    if _last_owned:
        mem.Free(_last_text as void*)
        _last_text = ""
        _last_owned = false
    end
end

func _click_count(id: int, e &: Event):
    mut w := _wins[id]
    if e.kind == EventKind.PointerDown:
        if e.clicks <= 0:
            now := _now()
            dx := e.x - w.last_x
            dy := e.y - w.last_y
            near := dx <= _CLICK_SLOP and dx >= 0.0 - _CLICK_SLOP and dy <= _CLICK_SLOP and dy >= 0.0 - _CLICK_SLOP
            if e.button == w.last_button and now - w.last_down <= (_CLICK_MS as i64) and near:
                e.clicks = w.clicks + 1
            else:
                e.clicks = 1
            end
            w.last_down = now
        end
        w.last_x = e.x
        w.last_y = e.y
        w.last_button = e.button
        w.clicks = e.clicks
    else e.clicks <= 0:
        e.clicks = e.button == w.last_button ? w.clicks : 1
    end
    _wins[id] = w
end

func _apply(e &: Event):
    id := e.window
    if e.kind == EventKind.ColorSchemeChanged:
        _scheme_dark = e.scheme == ColorScheme.Dark
        ret
    end
    if id < 0 or id >= _wins.len():
        ret
    end
    mut w := _wins[id]
    switch e.kind:
        EventKind.Resized:
            if e.physical_width <= 0:
                e.physical_width = _phys(e.width, w.scale)
                e.physical_height = _phys(e.height, w.scale)
            end
            w.pw = e.physical_width
            w.ph = e.physical_height
            w.lw = _logical(w.pw, w.scale)
            w.lh = _logical(w.ph, w.scale)
            e.width = w.lw
            e.height = w.lh
            e.scale = w.scale
            w.redraw = true
            break
        end
        EventKind.ScaleChanged:
            if e.scale > 0.0:
                w.scale = e.scale
            end
            w.lw = _logical(w.pw, w.scale)
            w.lh = _logical(w.ph, w.scale)
            e.scale = w.scale
            e.width = w.lw
            e.height = w.lh
            e.physical_width = w.pw
            e.physical_height = w.ph
            w.redraw = true
            break
        end
        EventKind.FocusIn:
            w.focused = true
            break
        end
        EventKind.FocusOut:
            w.focused = false
            break
        end
        EventKind.PointerEnter:
            w.inside = true
            break
        end
        EventKind.PointerLeave:
            w.inside = false
            break
        end
        EventKind.RedrawRequested:
            w.redraw = true
            break
        end
        else:
            break
        end
    end
    _wins[id] = w
    if e.kind == EventKind.PointerDown or e.kind == EventKind.PointerUp:
        _click_count(id, e)
    end
end

func _push(src: Event):
    mut e := src
    _apply(e)
    if e.kind == EventKind.RedrawRequested:
        ret
    end
    if e.kind == EventKind.Resized and _queue_len() > 0:
        last := _queue[_queue.len() - 1]
        if last.kind == EventKind.Resized and last.window == e.window:
            _queue[_queue.len() - 1] = e
            ret
        end
    end
    if e.text.len() > 0:
        e.text = str.Clone(e.text)
    end
    _queue.push(e)
end

func _request_redraw(id: int):
    if _alive(id):
        mut w := _wins[id]
        w.redraw = true
        _wins[id] = w
    end
end

func _take_redraw(): int:
    repeat _wins.len() in i:
        if _wins[i].open and _wins[i].redraw:
            mut w := _wins[i]
            w.redraw = false
            _wins[i] = w
            ret i
        end
    end
    ret -1
end

func _take_wake(): bool:
    if _wake_cell == null:
        ret false
    end
    ret atomic_swap(_wake_cell, 0 as i64) != (0 as i64)
end

func _fire_timers():
    now := _now()
    repeat _timers.len() in i:
        mut t := _timers[i]
        if t.live and t.due <= now:
            _push(Event { kind = EventKind.Timer, timer = t.id })
            if t.again:
                t.due += t.every
                if t.due <= now:
                    t.due = now + t.every
                end
            else:
                t.live = false
            end
            _timers[i] = t
        end
    end
end

func _next_due(): i64:
    mut best := -1 as i64
    each t in _timers:
        if t.live and (best < 0 or t.due < best):
            best = t.due
        end
    end
    ret best
end

func _any_native(): bool:
    each w in _wins:
        if w.open and not w.headless:
            ret true
        end
    end
    ret false
end

func _idle(wait: i64):
    if _native_ready:
        _nat_pump(wait > (2000000000 as i64) ? 2000000000 : wait as int)
        ret
    end
    mut left := wait
    if left < 0:
        left = 1000 as i64
    end
    mut slice := left > (10 as i64) ? 10 : left as int
    if slice < 1:
        slice = 1
    end
    time.Sleep(slice)
end

func _w_title(id: int, title: str):
    if not _alive(id):
        ret
    end
    mut w := _wins[id]
    old := w.title
    w.title = str.Clone(title)
    _wins[id] = w
    mem.Free(old as void*)
    if not w.headless:
        _nat_title(id, title)
    end
end

func _w_size(id: int, width: f64, height: f64):
    if not _alive(id):
        ret
    end
    w := _wins[id]
    mut lw := width
    mut lh := height
    if w.min_w > 0.0 and lw < w.min_w:
        lw = w.min_w
    end
    if w.min_h > 0.0 and lh < w.min_h:
        lh = w.min_h
    end
    if w.max_w > 0.0 and lw > w.max_w:
        lw = w.max_w
    end
    if w.max_h > 0.0 and lh > w.max_h:
        lh = w.max_h
    end
    pw := _phys(lw, w.scale)
    ph := _phys(lh, w.scale)
    if w.headless:
        if pw != w.pw or ph != w.ph:
            _push(Event { kind = EventKind.Resized, window = id, physical_width = pw, physical_height = ph })
        end
        ret
    end
    _nat_resize(id, pw, ph)
end

func _w_get_size(id: int): WindowSize:
    if not _alive(id):
        ret WindowSize {}
    end
    w := _wins[id]
    ret WindowSize { width = w.lw, height = w.lh, physical_width = w.pw, physical_height = w.ph }
end

func _w_limits(id: int, width: f64, height: f64, minimum: bool):
    if not _alive(id):
        ret
    end
    mut w := _wins[id]
    if minimum:
        w.min_w = width
        w.min_h = height
    else:
        w.max_w = width
        w.max_h = height
    end
    _wins[id] = w
    if not w.headless:
        _nat_limits(id)
    end
    mut lw := w.lw
    mut lh := w.lh
    if w.min_w > 0.0 and lw < w.min_w:
        lw = w.min_w
    end
    if w.min_h > 0.0 and lh < w.min_h:
        lh = w.min_h
    end
    if w.max_w > 0.0 and lw > w.max_w:
        lw = w.max_w
    end
    if w.max_h > 0.0 and lh > w.max_h:
        lh = w.max_h
    end
    if lw != w.lw or lh != w.lh:
        _w_size(id, lw, lh)
    end
end

func _w_state(id: int, what: int):
    if not _alive(id):
        ret
    end
    mut w := _wins[id]
    switch what:
        0:
            w.minimized = true
            break
        end
        1:
            w.maximized = true
            w.minimized = false
            break
        end
        2:
            w.maximized = false
            w.minimized = false
            break
        end
        3:
            w.fullscreen = true
            break
        end
        4:
            w.fullscreen = false
            break
        end
        else:
            break
        end
    end
    _wins[id] = w
    if w.headless:
        if what == 5 and not w.focused:
            _push(Event { kind = EventKind.FocusIn, window = id })
        end
        ret
    end
    _nat_state(id, what)
end

func _w_cursor(id: int, cursor: Cursor):
    if not _alive(id):
        ret
    end
    mut w := _wins[id]
    w.cursor = cursor
    _wins[id] = w
    if not w.headless:
        _nat_cursor(id, cursor)
    end
end

func _w_ime(id: int, x: f64, y: f64, width: f64, height: f64):
    if not _alive(id):
        ret
    end
    mut w := _wins[id]
    w.ime_x = x
    w.ime_y = y
    w.ime_w = width
    w.ime_h = height
    _wins[id] = w
    if not w.headless:
        s := w.scale
        _nat_ime(id, (x * s) as int, (y * s) as int, _phys(width, s), _phys(height, s))
    end
end

func _w_icon(id: int, pixels: void*, width: int, height: int, stride: int): bool:
    if not _alive(id) or pixels == null or width <= 0 or height <= 0 or stride < width * 4:
        ret false
    end
    mut w := _wins[id]
    w.icon_w = width
    w.icon_h = height
    _wins[id] = w
    if w.headless:
        ret true
    end
    ret _nat_icon(id, pixels, width, height, stride)
end

func _clip_rect(r: Rect, width: int, height: int): Rect:
    mut x0 := r.x
    mut y0 := r.y
    mut x1 := r.x + r.width
    mut y1 := r.y + r.height
    if x0 < 0:
        x0 = 0
    end
    if y0 < 0:
        y0 = 0
    end
    if x1 > width:
        x1 = width
    end
    if y1 > height:
        y1 = height
    end
    if x1 <= x0 or y1 <= y0:
        ret Rect {}
    end
    ret Rect { x = x0, y = y0, width = x1 - x0, height = y1 - y0 }
end

func _w_present(id: int, pixels: void*, width: int, height: int, stride: int, damage: Vector<Rect>): bool:
    if not _alive(id) or pixels == null or width <= 0 or height <= 0 or stride < width * 4:
        ret false
    end
    mut w := _wins[id]
    mut full := false
    if w.buf == null or w.buf_w != width or w.buf_h != height:
        if w.headless:
            if w.buf != null:
                mem.Free(w.buf)
            end
            w.buf = mem.AllocateZeroed(((width as u64) * (height as u64)) * (4 as u64))
        else:
            w.buf = _nat_alloc(id, width, height)
        end
        if w.buf == null:
            w.buf_w = 0
            w.buf_h = 0
            _wins[id] = w
            ret false
        end
        w.buf_w = width
        w.buf_h = height
        full = true
    end
    mut rects := Vector {} as Vector<Rect>
    defer rects.free()
    if full or damage.len() == 0:
        rects.push(Rect { x = 0, y = 0, width = width, height = height })
    else:
        each d in damage:
            c := _clip_rect(d, width, height)
            if c.width > 0:
                rects.push(c)
            end
        end
    end
    mut bx0 := width
    mut by0 := height
    mut bx1 := 0
    mut by1 := 0
    each r in rects:
        repeat r.height in i:
            row := (r.y + i) as i64
            dst := (w.buf as i64) + (row * (width as i64) + (r.x as i64)) * (4 as i64)
            src := (pixels as i64) + row * (stride as i64) + (r.x as i64) * (4 as i64)
            mem.Copy(dst as void*, src as void*, (r.width * 4) as u64)
        end
        bx0 = r.x < bx0 ? r.x : bx0
        by0 = r.y < by0 ? r.y : by0
        bx1 = r.x + r.width > bx1 ? r.x + r.width : bx1
        by1 = r.y + r.height > by1 ? r.y + r.height : by1
    end
    w.presents++
    w.dmg_n = rects.len()
    if rects.len() > 0:
        w.dmg_x = bx0
        w.dmg_y = by0
        w.dmg_w = bx1 - bx0
        w.dmg_h = by1 - by0
    else:
        w.dmg_x = 0
        w.dmg_y = 0
        w.dmg_w = 0
        w.dmg_h = 0
    end
    _wins[id] = w
    if not w.headless and rects.len() > 0:
        _nat_blit(id, rects)
    end
    ret true
end

func _w_pixel(id: int, x: int, y: int): u32:
    if id < 0 or id >= _wins.len():
        ret 0
    end
    w := _wins[id]
    if w.buf == null or x < 0 or y < 0 or x >= w.buf_w or y >= w.buf_h:
        ret 0
    end
    ret (w.buf as u32*)[y * w.buf_w + x]
end

func _w_shown(id: int, x: int, y: int): u32:
    if not _alive(id):
        ret 0
    end
    if _wins[id].headless:
        ret _w_pixel(id, x, y)
    end
    ret _nat_shown(id, x, y)
end

func _w_close(id: int):
    if not _alive(id):
        ret
    end
    mut w := _wins[id]
    if not w.headless:
        _nat_close(id)
    else w.buf != null:
        mem.Free(w.buf)
    end
    w.buf = null
    w.buf_w = 0
    w.buf_h = 0
    w.open = false
    w.redraw = false
    if w.title.len() > 0:
        mem.Free(w.title as void*)
    end
    w.title = ""
    _wins[id] = w
end

@en "Open"
@fa "باز کردن"
pub func Open(options: Options): Window:
    _setup()
    id := _wins.len()
    headless := options.headless or _forced == 2
    mut scale := options.scale
    if scale <= 0.0:
        scale = _env_scale()
    end
    if scale <= 0.0:
        scale = 1.0
    end
    mut w := _Win {
        open = true, headless = headless, scale = scale, min_w = options.min_width,
        min_h = options.min_height, max_w = options.max_width, max_h = options.max_height,
        resizable = options.resizable, redraw = true, title = str.Clone(options.title)
    }
    w.lw = options.width
    w.lh = options.height
    w.pw = _phys(options.width, scale)
    w.ph = _phys(options.height, scale)
    _wins.push(w)
    if headless:
        if options.visible:
            _push(Event { kind = EventKind.FocusIn, window = id })
        end
        ret Window { id = id }
    end
    if not _ensure_native() or not _nat_open(id, options):
        mut dead := _wins[id]
        dead.open = false
        _wins[id] = dead
        if _error.len() == 0:
            _error = "no native window system is available"
        end
    end
    ret Window { id = id }
end

@en "LastError"
@fa "آخرین خطا"
pub func LastError(): str:
    ret _error
end

@en "Wait"
@fa "انتظار رویداد"
pub func Wait(timeout_ms: int): Event:
    _setup()
    _drop_last()
    start := _now()
    deadline := timeout_ms < 0 ? -1 as i64 : start + (timeout_ms as i64)
    until true:
        if _native_ready:
            _nat_pump(0)
        end
        _fire_timers()
        if _queue_len() > 0:
            ret _pop()
        end
        if _take_wake():
            ret Event { kind = EventKind.Wake }
        end
        r := _take_redraw()
        if r >= 0:
            w := _wins[r]
            ret Event {
                kind = EventKind.RedrawRequested, window = r, width = w.lw, height = w.lh,
                physical_width = w.pw, physical_height = w.ph, scale = w.scale
            }
        end
        now := _now()
        mut wait := -1 as i64
        if deadline >= 0:
            wait = deadline - now
            if wait <= 0:
                ret Event {}
            end
        end
        due := _next_due()
        if due >= 0:
            mut d := due - now
            if d < 0:
                d = 0
            end
            if wait < 0 or d < wait:
                wait = d
            end
        end
        if _manual:
            if wait < 0:
                ret Event {}
            end
            _manual_now += wait
        else wait != 0:
            _idle(wait)
        end
    end
end

@en "Poll"
@fa "سرکشی رویداد"
pub func Poll(): Event:
    ret Wait(0)
end

@en "Inject"
@fa "تزریق رویداد"
pub func Inject(event: Event):
    _setup()
    _push(event)
end

@en "SetTimer"
@fa "تنظیم زمان سنج"
pub func SetTimer(ms: int, repeating: bool): int:
    _setup()
    every := ms < 1 ? 1 as i64 : ms as i64
    id := _timer_next
    _timer_next++
    _timers.push(_Timer { id = id, due = _now() + every, every = every, again = repeating, live = true })
    ret id
end

@en "ClearTimer"
@fa "پاک کردن زمان سنج"
pub func ClearTimer(id: int):
    repeat _timers.len() in i:
        if _timers[i].id == id:
            mut t := _timers[i]
            t.live = false
            _timers[i] = t
        end
    end
end

@en "Wake"
@fa "بیدار کردن"
pub func Wake():
    if _wake_cell == null:
        ret
    end
    atomic_store(_wake_cell, 1 as i64)
    if _native_ready:
        _nat_wake()
    end
end

@en "SetManualClock"
@fa "تنظیم ساعت دستی"
pub func SetManualClock(enabled: bool):
    if enabled and not _manual:
        _manual_now = 0 as i64
    end
    _manual = enabled
end

@en "Clock"
@fa "ساعت"
pub func Clock(): i64:
    ret _now()
end

@en "Advance"
@fa "جلو بردن ساعت"
pub func Advance(ms: int):
    if _manual and ms > 0:
        _manual_now += ms as i64
    end
end

@en "ClipboardText"
@fa "متن کلیپ بورد"
pub func ClipboardText(): str:
    if _native_ready:
        ret _nat_clip_get()
    end
    ret str.Clone(_clip)
end

@en "SetClipboardText"
@fa "تنظیم متن کلیپ بورد"
pub func SetClipboardText(text: str): bool:
    if _native_ready:
        ret _nat_clip_set(text)
    end
    if _clip_owned:
        mem.Free(_clip as void*)
    end
    _clip = str.Clone(text)
    _clip_owned = true
    ret true
end

@en "CurrentColorScheme"
@fa "طرح رنگ کنونی"
pub func CurrentColorScheme(): ColorScheme:
    if _native_ready:
        ret _nat_scheme()
    end
    ret _scheme_dark ? ColorScheme.Dark : ColorScheme.Light
end

@en "OpenWindows"
@fa "شمار پنجره های باز"
pub func OpenWindows(): int:
    mut n := 0
    each w in _wins:
        if w.open:
            n++
        end
    end
    ret n
end
