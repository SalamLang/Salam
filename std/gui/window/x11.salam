        r := _clip_rect(Rect { x = rx, y = ry, width = rw, height = rh }, w.buf_w, w.buf_h)
        if r.width > 0:
            XPutImage(_xd, x.win, x.gc, x.image, r.x, r.y, r.x, r.y, r.width as u32, r.height as u32)
        end
    end

    func _nat_blit(id: int, rects: Vector<Rect>):
        each r in rects:
