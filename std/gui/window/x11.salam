            _f := XFree(text)
        end
    end

    func _x_handle(ev: void*):
        if XFilterEvent(ev, 0 as usize) != 0:
            ret
        end
        kind := _x_int(ev, 0)
        if kind == 30:
            _x_serve(ev)
            ret
        end
        if kind == 31:
            _x_receive(ev)
            ret
        end
        if kind == 34:
            _r := XRefreshKeyboardMapping(ev)
            ret
        end
        id := _x_find(_x_long(ev, 4))
        if id < 0 or not _alive(id):
            ret
        end
        base := _x_word() * 8
        switch kind:
            2, 3:
                _x_keyboard(id, ev, kind == 2)
                break
            end
            4:
                b := _x_int(ev, base + 20)
                if b >= 4 and b <= 7:
                    _x_wheel(id, ev, b)
                else:
                    _x_pointer(id, EventKind.PointerDown, ev, _x_button(b))
                end
                break
            end
            5:
                b := _x_int(ev, base + 20)
                if b < 4 or b > 7:
                    _x_pointer(id, EventKind.PointerUp, ev, _x_button(b))
                end
                break
            end
            6:
                _x_pointer(id, EventKind.PointerMove, ev, MouseButton.None)
                break
            end
            7, 8:
                mode := _x_int(ev, base + 16)
                if mode == 0:
                    _x_pointer(id, kind == 7 ? EventKind.PointerEnter : EventKind.PointerLeave, ev, MouseButton.None)
                end
                break
            end
            9, 10:
                detail := _x_int(ev, _x_word() * 5 + 4)
                gained := kind == 9
                if detail != 5 and gained != _wins[id].focused:
                    ic := _x_wins[id].ic
                    if ic != null:
                        if gained:
                            XSetICFocus(ic)
                        else:
                            XUnsetICFocus(ic)
                        end
                    end
                    if gained:
                        _x_focus_id = id
                    end
                    _push(Event { kind = gained ? EventKind.FocusIn : EventKind.FocusOut, window = id })
                end
                break
            end
            12:
                b5 := _x_word() * 5
                _x_put(id, _x_int(ev, b5), _x_int(ev, b5 + 4), _x_int(ev, b5 + 8), _x_int(ev, b5 + 12))
                break
            end
            22:
                b6 := _x_word() * 6
                pw := _x_int(ev, b6 + 8)
                ph := _x_int(ev, b6 + 12)
                if pw != _wins[id].pw or ph != _wins[id].ph:
                    _push(Event { kind = EventKind.Resized, window = id, physical_width = pw, physical_height = ph })
                end
                break
            end
            33:
                if _x_long(ev, 5) == _x_atoms[0] and _x_long(ev, 7) == _x_atoms[1]:
                    _push(Event { kind = EventKind.CloseRequested, window = id })
                end
                break
            end
            else:
                break
            end
        end
    end

    func _x_drain_wake():
        buf := mem.Allocate(64 as u64)
        until read(_x_wake_r, buf, 64 as u64) > (0 as i64):
            _x_error_code = 0
        end
        mem.Free(buf)
    end

    func _nat_pump(timeout: int):
        XFlush(_xd)
        if XPending(_xd) == 0 and timeout != 0:
            fds := mem.AllocateZeroed(16 as u64) as i32*
            fds[0] = _x_fd
            fds[1] = 1
            fds[2] = _x_wake_r
            fds[3] = 1
            _n := poll(fds as void*, (_x_wake_r >= 0 ? 2 : 1) as usize, timeout)
            mem.Free(fds as void*)
        end
        if _x_wake_r >= 0:
            _x_drain_wake()
        end
        until XPending(_xd) > 0:
            XNextEvent(_xd, _x_ev)
            _x_handle(_x_ev)
        end
    end

    func _nat_wake():
        if _x_wake_w >= 0:
            one := mem.AllocateZeroed(8 as u64)
            _n := write(_x_wake_w, one, 1 as u64)
            mem.Free(one)
        end
    end

    func _nat_clip_get(): str:
        if _x_sel_text.len() > 0:
            mem.Free(_x_sel_text as void*)
        end
        _x_sel_text = ""
        _x_sel_done = false
        XConvertSelection(_xd, _x_atoms[11], _x_atoms[3], _x_atoms[13], _x_helper, 0 as usize)
        XFlush(_xd)
        start := time.MonoMillis()
        until not _x_sel_done and time.MonoMillis() - start < (1000 as i64):
            _nat_pump(20)
        end
        if _x_sel_text.len() == 0:
            ret str.Clone("")
        end
        text := _x_sel_text
        _x_sel_text = ""
        ret text
    end

    func _nat_clip_set(text: str): bool:
        if _x_clip_owned:
