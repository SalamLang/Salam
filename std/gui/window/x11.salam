    func _x_open_im():
        if XSupportsLocale() == 0:
            ret
        end
        _mods := XSetLocaleModifiers("")
        _x_im = XOpenIM(_xd, null, null, null)
        if _x_im == null:
            _mods2 := XSetLocaleModifiers("@im=none")
            _x_im = XOpenIM(_xd, null, null, null)
        end
        if _x_im == null:
            ret
        end
        holder := mem.AllocateZeroed(16 as u64) as void**
        failed := XGetIMValues(_x_im, "queryInputStyle", holder as void*, null)
        styles := holder[0]
        mem.Free(holder as void*)
        mut found := 0 as usize
        if failed == null and styles != null:
            count := (styles as u16*)[0] as int
            list := (((styles as i64) + (_x_word() as i64)) as void**)[0] as usize*
            each want in [0x0402, 0x0404, 0x0408, 0x0810]:
                if found == (0 as usize):
                    repeat count in i:
                        if list[i] == (want as usize):
                            found = want as usize
                        end
                    end
                end
            end
            _freed := XFree(styles)
        end
        _x_style = found
    end

    func _x_callback(fn: void*): void*:
        cb := mem.AllocateZeroed((_x_word() * 2) as u64) as void**
        cb[1] = fn
        ret cb as void*
    end

    func _x_make_ic(win: usize): void*:
        if _x_im == null or _x_style == (0 as usize):
            ret null
        end
        if _x_style == (0x0402 as usize):
            if _x_cb_start == null:
                _x_cb_start = _x_callback(&salam_window_x11_preedit_start)
                _x_cb_done = _x_callback(&salam_window_x11_preedit_done)
                _x_cb_draw = _x_callback(&salam_window_x11_preedit_draw)
                _x_cb_caret = _x_callback(&salam_window_x11_preedit_caret)
            end
            attrs := XVaCreateNestedList(
                0, "preeditStartCallback", _x_cb_start, "preeditDoneCallback", _x_cb_done,
                "preeditDrawCallback", _x_cb_draw, "preeditCaretCallback", _x_cb_caret, null
            )
            ic := XCreateIC(
                _x_im, "inputStyle", _x_style, "clientWindow", win, "focusWindow", win,
                "preeditAttributes", attrs, null
            )
            _f := XFree(attrs)
            ret ic
        end
        ret XCreateIC(_x_im, "inputStyle", _x_style, "clientWindow", win, "focusWindow", win, null)
    end

    func _x_wake_pipe():
        fds := mem.AllocateZeroed(8 as u64) as i32*
        if pipe(fds as void*) == 0:
            _x_wake_r = fds[0]
            _x_wake_w = fds[1]
            _r := fcntl(_x_wake_r, 4, 2048)
            _w := fcntl(_x_wake_w, 4, 2048)
        end
        mem.Free(fds as void*)
    end

    func _nat_init(): bool:
        _locale := setlocale(0, "")
        _xd = XOpenDisplay(null)
        if _xd == null:
            _set_error("could not connect to the X server; is DISPLAY set?")
            ret false
        end
        _old := XSetErrorHandler(&salam_window_x11_error)
        _x_screen = XDefaultScreen(_xd)
        _x_root = XRootWindow(_xd, _x_screen)
        _x_visual = XDefaultVisual(_xd, _x_screen)
        _x_depth = XDefaultDepth(_xd, _x_screen)
        _x_fd = XConnectionNumber(_xd)
        _x_ev = mem.AllocateZeroed(256 as u64)
        _x_tmp = mem.AllocateZeroed(256 as u64)
        _x_helper = XCreateSimpleWindow(_xd, _x_root, 0, 0, 1 as u32, 1 as u32, 0 as u32, 0 as usize, 0 as usize)
        XSelectInput(_xd, _x_helper, (1 << 22) as size)
        _auto := XkbSetDetectableAutoRepeat(_xd, 1, null)
        each name in [
            "WM_PROTOCOLS", "WM_DELETE_WINDOW", "_NET_WM_NAME", "UTF8_STRING", "_MOTIF_WM_HINTS",
            "_NET_WM_STATE", "_NET_WM_STATE_FULLSCREEN", "_NET_WM_STATE_MAXIMIZED_VERT",
            "_NET_WM_STATE_MAXIMIZED_HORZ", "_NET_ACTIVE_WINDOW", "_NET_WM_ICON", "CLIPBOARD", "TARGETS",
            "SALAM_SELECTION", "TEXT"
        ]:
            _x_atoms.push(_x_atom(name))
        end
        repeat 256:
            _x_down.push(false)
        end
        repeat 12:
            _x_cursors.push(0 as usize)
        end
        _x_wake_pipe()
        _x_open_im()
        ret true
    end

    func _x_hints(id: int):
        x := _x_wins[id]
        w := _wins[id]
        hints := mem.AllocateZeroed(160 as u64)
        defer mem.Free(hints)
        base := _x_word()
        mut flags := 0
        if not w.resizable:
            flags = 48
            _x_set_int(hints, base + 16, w.pw)
            _x_set_int(hints, base + 20, w.ph)
            _x_set_int(hints, base + 24, w.pw)
            _x_set_int(hints, base + 28, w.ph)
        else:
            if w.min_w > 0.0 or w.min_h > 0.0:
                flags |= 16
                _x_set_int(hints, base + 16, _phys(w.min_w, w.scale))
                _x_set_int(hints, base + 20, _phys(w.min_h, w.scale))
            end
            if w.max_w > 0.0 or w.max_h > 0.0:
                flags |= 32
                _x_set_int(hints, base + 24, w.max_w > 0.0 ? _phys(w.max_w, w.scale) : 32767)
                _x_set_int(hints, base + 28, w.max_h > 0.0 ? _phys(w.max_h, w.scale) : 32767)
            end
        end
        _x_set_long(hints, 0, flags as usize)
        XSetWMNormalHints(_xd, x.win, hints)
    end

    func _x_utf8_property(win: usize, atom: usize, text: str):
        XChangeProperty(_xd, win, atom, _x_atoms[3], 8, 0, text as void*, text.len())
    end

    func _nat_open(id: int, o: Options): bool:
        until _x_wins.len() <= id:
            _x_wins.push(_XWin {})
        end
        mut scale := o.scale
        if scale <= 0.0:
            scale = _env_scale()
        end
        if scale <= 0.0:
            scale = _x_dpi_scale()
        end
        pw := _phys(o.width, scale)
        ph := _phys(o.height, scale)
        _set_geometry(id, pw, ph, scale)
        mut px := (o.x * scale) as int
        mut py := (o.y * scale) as int
        if o.centered:
            px = (XDisplayWidth(_xd, _x_screen) - pw) / 2
            py = (XDisplayHeight(_xd, _x_screen) - ph) / 2
        end
        bg := (o.background >> 8) & (0xFFFFFF as u32)
        win := XCreateSimpleWindow(
            _xd, _x_root, px, py, pw as u32, ph as u32, 0 as u32, 0 as usize, bg as usize
        )
        if win == (0 as usize):
            _set_error("the X server refused to create a window")
            ret false
        end
        mask := 1 | 2 | 4 | 8 | 16 | 32 | 64 | (1 << 15) | (1 << 17) | (1 << 21) | (1 << 22)
        XSelectInput(_xd, win, mask as size)
        protocols := mem.AllocateZeroed(8 as u64) as usize*
        protocols[0] = _x_atoms[1]
        XSetWMProtocols(_xd, win, protocols as void*, 1)
        mem.Free(protocols as void*)
        _x_wins[id] = _XWin { win = win, gc = XCreateGC(_xd, win, 0 as usize, null), open = true }
        _nat_title(id, o.title)
        _x_hints(id)
        if not o.decorated:
            motif := mem.AllocateZeroed((_x_word() * 5) as u64) as usize*
            motif[0] = 2 as usize
            XChangeProperty(_xd, win, _x_atoms[4], _x_atoms[4], 32, 0, motif as void*, 5)
            mem.Free(motif as void*)
        end
        mut x := _x_wins[id]
