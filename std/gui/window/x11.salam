        reply := _x_tmp
        mem.Set(reply, 0, 256 as u64)
        _x_set_int(reply, 0, 31)
        _x_set_int(reply, _x_word() * 2, 1)
        _x_set_long(reply, 4, requestor)
        _x_set_long(reply, 5, selection)
        _x_set_long(reply, 6, target)
        _x_set_long(reply, 7, property)
        _x_set_long(reply, 8, stamp)
