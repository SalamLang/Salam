        _x_set_int(image, 16 + _x_word(), 0)
        mut x := _x_wins[id]
        x.image = image
        x.buf = buf
        _x_wins[id] = x
        ret buf
    end

    func _x_put(id: int, rx: int, ry: int, rw: int, rh: int):
        x := _x_wins[id]
        w := _wins[id]
        if x.image == null:
