    func _x_cursor_shape(cursor: Cursor): int:
        ret match cursor:
            Cursor.Default: 68 end
            Cursor.Pointer: 60 end
            Cursor.Text: 152 end
            Cursor.Wait: 150 end
            Cursor.Crosshair: 34 end
            Cursor.Move: 52 end
            Cursor.ResizeHorizontal: 108 end
            Cursor.ResizeVertical: 116 end
            Cursor.ResizeDiagonalUp: 12 end
            Cursor.ResizeDiagonalDown: 14 end
            Cursor.NotAllowed: 0 end
            Cursor.Hidden: -1 end
