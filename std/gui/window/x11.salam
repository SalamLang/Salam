                _x_set_long(ev, 5, _x_atoms[9])
                _x_set_int(ev, _x_word() * 6, 32)
                _x_set_long(ev, 7, 1 as usize)
                XSendEvent(_xd, _x_root, 0, ((1 << 20) | (1 << 19)) as size, ev)
