        if target == _x_atoms[12]:
            list := mem.AllocateZeroed((_x_word() * 4) as u64) as usize*
            list[0] = _x_atoms[12]
            list[1] = _x_atoms[3]
            list[2] = 31 as usize
            list[3] = _x_atoms[14]
            XChangeProperty(_xd, requestor, property, 4 as usize, 32, 0, list as void*, 4)
            mem.Free(list as void*)
        else target == _x_atoms[3] or target == (31 as usize) or target == _x_atoms[14]:
            XChangeProperty(_xd, requestor, property, target, 8, 0, _x_clip as void*, _x_clip.len())
        else:
            property = 0 as usize
