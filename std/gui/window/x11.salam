    func _nat_icon(id: int, pixels: void*, width: int, height: int, stride: int): bool:
        count := 2 + width * height
        data := mem.AllocateZeroed((count * _x_word()) as u64) as usize*
        data[0] = width as usize
        data[1] = height as usize
        repeat height in y:
            row := ((pixels as i64) + (y as i64) * (stride as i64)) as u32*
            repeat width in x:
                p := row[x]
                a := (p >> 24) & (255 as u32)
                mut r := (p >> 16) & (255 as u32)
                mut g := (p >> 8) & (255 as u32)
                mut b := p & (255 as u32)
                if a > (0 as u32) and a < (255 as u32):
                    r = (r * (255 as u32) + a / (2 as u32)) / a
                    g = (g * (255 as u32) + a / (2 as u32)) / a
                    b = (b * (255 as u32) + a / (2 as u32)) / a
                end
                data[2 + y * width + x] = ((a << 24) | (r << 16) | (g << 8) | b) as usize
            end
        end
        XChangeProperty(_xd, _x_wins[id].win, _x_atoms[10], 6 as usize, 32, 0, data as void*, count)
        mem.Free(data as void*)
        XFlush(_xd)
        ret true
    end

    func _nat_alloc(id: int, width: int, height: int): void*:
        _x_free_image(id)
        buf := mem.AllocateZeroed(((width as u64) * (height as u64)) * (4 as u64))
        image := XCreateImage(
            _xd, _x_visual, _x_depth as u32, 2, 0, buf, width as u32, height as u32, 32, width * 4
        )
