        end
        XFlush(_xd)
    end

    func _x_pointer(id: int, kind: EventKind, ev: void*, button: MouseButton):
        base := _x_word() * 8
        s := _wins[id].scale
        crossing := kind == EventKind.PointerEnter or kind == EventKind.PointerLeave
        state := _x_int(ev, base + (crossing ? 32 : 16))
        _push(Event {
            kind = kind, window = id, x = _logical(_x_int(ev, base), s), y = _logical(_x_int(ev, base + 4), s),
            button = button, modifiers = _x_mods(state)
        })
    end

    func _x_button(code: int): MouseButton:
        ret match code:
            1: MouseButton.Left end
            2: MouseButton.Middle end
            3: MouseButton.Right end
            8: MouseButton.Back end
            9: MouseButton.Forward end
            else: MouseButton.None end
        end
    end

    func _x_wheel(id: int, ev: void*, code: int):
        base := _x_word() * 8
        s := _wins[id].scale
        mut dx := 0.0
        mut dy := 0.0
        switch code:
            4:
                dy = -1.0
                break
            end
            5:
                dy = 1.0
                break
            end
            6:
                dx = -1.0
                break
            end
            else:
                dx = 1.0
                break
            end
        end
        _push(Event {
            kind = EventKind.Wheel, window = id, x = _logical(_x_int(ev, base), s),
            y = _logical(_x_int(ev, base + 4), s), delta_x = dx, delta_y = dy, delta_mode = WheelMode.Line,
            modifiers = _x_mods(_x_int(ev, base + 16))
        })
    end

    func _x_latin1(bytes: u8*, n: int): str:
        mut b := str.NewBuilder()
        repeat n in i:
            str.BufAppendCp(b, bytes[i] as int)
        end
        ret str.BufStr(b)
    end

    func _x_keyboard(id: int, ev: void*, press: bool):
        base := _x_word() * 8
        code := _x_int(ev, base + 20)
        state := _x_int(ev, base + 16)
        mods := _x_mods(state)
        slot := code & 255
        repeated := press and _x_down[slot]
        _x_down[slot] = press
        kind := press ? EventKind.KeyDown : EventKind.KeyUp
        _push(Event { kind = kind, window = id, key = _x_key(code - 8), code = code, modifiers = mods, repeated = repeated })
        if not press:
            ret
        end
        buf := mem.AllocateZeroed(256 as u64) as u8*
        defer mem.Free(buf as void*)
        keysym := mem.AllocateZeroed(16 as u64)
        defer mem.Free(keysym)
        status := mem.AllocateZeroed(16 as u64) as i32*
        defer mem.Free(status as void*)
        ic := _x_wins[id].ic
        mut text := ""
