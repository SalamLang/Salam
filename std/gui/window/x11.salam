package window

if SALAM_OS_LINUX and not SALAM_OS_ANDROID:
    link dynamic "X11"

    extern:
        func XOpenDisplay(name: void*): void*
        func XDefaultScreen(display: void*): int
        func XRootWindow(display: void*, screen: int): usize
        func XDefaultVisual(display: void*, screen: int): void*
        func XDefaultDepth(display: void*, screen: int): int
        func XDisplayWidth(display: void*, screen: int): int
        func XDisplayHeight(display: void*, screen: int): int
        func XConnectionNumber(display: void*): int
        func XCreateSimpleWindow(
            display: void*, parent: usize, x: int, y: int, width: u32, height: u32, border_width: u32,
            border: usize, background: usize
        ): usize
        func XSelectInput(display: void*, w: usize, mask: size): int
        func XStoreName(display: void*, w: usize, name: str): int
        func XInternAtom(display: void*, name: str, only_if_exists: int): usize
        func XSetWMProtocols(display: void*, w: usize, protocols: void*, count: int): int
        func XMapWindow(display: void*, w: usize): int
        func XMapRaised(display: void*, w: usize): int
        func XDestroyWindow(display: void*, w: usize): int
        func XCreateGC(display: void*, drawable: usize, mask: usize, values: void*): void*
        func XFreeGC(display: void*, gc: void*): int
        func XCreateImage(
            display: void*, visual: void*, depth: u32, format: int, offset: int, data: void*, width: u32,
            height: u32, pad: int, bytes_per_line: int
        ): void*
        func XDestroyImage(image: void*): int
        func XPutImage(
            display: void*, drawable: usize, gc: void*, image: void*, src_x: int, src_y: int, dst_x: int,
            dst_y: int, width: u32, height: u32
        ): int
        func XGetImage(
            display: void*, drawable: usize, x: int, y: int, width: u32, height: u32, planes: usize, format: int
        ): void*
        func XFree(data: void*): int
        func XFlush(display: void*): int
        func XSync(display: void*, discard: int): int
        func XPending(display: void*): int
        func XNextEvent(display: void*, event: void*): int
        func XFilterEvent(event: void*, w: usize): int
        func XLookupString(event: void*, buf: void*, size: int, keysym: void*, status: void*): int
        func Xutf8LookupString(ic: void*, event: void*, buf: void*, size: int, keysym: void*, status: void*): int
        func XRefreshKeyboardMapping(event: void*): int
        func XSetLocaleModifiers(modifiers: str): void*
        func XSupportsLocale(): int
        func XOpenIM(display: void*, db: void*, name: void*, class_name: void*): void*
        func XGetIMValues(im: void*, ...): void*
        func XCreateIC(im: void*, ...): void*
        func XSetICValues(ic: void*, ...): void*
        func XVaCreateNestedList(unused: int, ...): void*
        func XSetICFocus(ic: void*)
        func XUnsetICFocus(ic: void*)
        func XDestroyIC(ic: void*)
        func XResourceManagerString(display: void*): void*
        func XkbSetDetectableAutoRepeat(display: void*, detectable: int, supported: void*): int
        func XSetErrorHandler(handler: void*): void*
        func XChangeProperty(
            display: void*, w: usize, property: usize, kind: usize, format: int, mode: int, data: void*,
            count: int
        ): int
        func XDeleteProperty(display: void*, w: usize, property: usize): int
        func XGetWindowProperty(
            display: void*, w: usize, property: usize, offset: size, length: size, delete: int,
            wanted: usize, actual_type: void*, actual_format: void*, count: void*, after: void*, data: void*
        ): int
        func XSetSelectionOwner(display: void*, selection: usize, owner: usize, time: usize): int
        func XGetSelectionOwner(display: void*, selection: usize): usize
        func XConvertSelection(
            display: void*, selection: usize, target: usize, property: usize, requestor: usize, time: usize
        ): int
        func XSendEvent(display: void*, w: usize, propagate: int, mask: size, event: void*): int
        func XResizeWindow(display: void*, w: usize, width: u32, height: u32): int
        func XSetWMNormalHints(display: void*, w: usize, hints: void*)
        func XIconifyWindow(display: void*, w: usize, screen: int): int
        func XRaiseWindow(display: void*, w: usize): int
        func XSetInputFocus(display: void*, w: usize, revert: int, time: usize): int
        func XCreateFontCursor(display: void*, shape: u32): usize
        func XDefineCursor(display: void*, w: usize, cursor: usize): int
        func XCreateBitmapFromData(display: void*, drawable: usize, data: void*, width: u32, height: u32): usize
        func XCreatePixmapCursor(
            display: void*, source: usize, mask: usize, fg: void*, bg: void*, x: u32, y: u32
        ): usize
        func XFreePixmap(display: void*, pixmap: usize): int
        func setlocale(category: int, locale: str): void*
        func pipe(fds: void*): int
        func poll(fds: void*, nfds: usize, timeout: int): int
        func read(fd: int, buf: void*, n: u64): i64
        func write(fd: int, buf: void*, n: u64): i64
        func fcntl(fd: int, cmd: int, ...): int
    end

    mut _xd := null as void*
    mut _x_screen := 0
    mut _x_root := 0 as usize
    mut _x_helper := 0 as usize
    mut _x_visual := null as void*
    mut _x_depth := 24
    mut _x_fd := -1
    mut _x_wake_r := -1
    mut _x_wake_w := -1
    mut _x_ev := null as void*
    mut _x_tmp := null as void*
    mut _x_im := null as void*
    mut _x_style := 0 as usize
    mut _x_wins := Vector {} as Vector<_XWin>
    mut _x_down := Vector {} as Vector<bool>
    mut _x_cursors := Vector {} as Vector<usize>
    mut _x_atoms := Vector {} as Vector<usize>
    mut _x_clip := ""
    mut _x_clip_owned := false
    mut _x_sel_done := false
    mut _x_sel_text := ""
    mut _x_preedit := Vector {} as Vector<int>
    mut _x_caret := 0
    mut _x_composing := false
    mut _x_focus_id := -1
    mut _x_cb_start := null as void*
    mut _x_cb_done := null as void*
    mut _x_cb_draw := null as void*
    mut _x_cb_caret := null as void*
    mut _x_error_code := 0

    struct _XWin:
        pub win: usize = 0 as usize
        pub gc: void* = null
        pub image: void* = null
        pub buf: void* = null
        pub ic: void* = null
        pub open: bool = false
    end

    export:
        func salam_window_x11_error(_display: void*, event: void*): int:
            _x_error_code = (event as u8*)[(sizeof(usize) as int) * 4] as int
            ret 0
        end

        func salam_window_x11_preedit_start(_ic: void*, _client: void*, _data: void*): int:
            _x_preedit.clear()
            _x_caret = 0
            _x_composing = true
            ret -1
        end

        func salam_window_x11_preedit_done(_ic: void*, _client: void*, _data: void*):
            _x_preedit.clear()
            _x_caret = 0
            _x_send_preedit()
            _x_composing = false
        end

        func salam_window_x11_preedit_draw(_ic: void*, _client: void*, data: void*):
            if data == null:
                ret
            end
            fields := data as i32*
            caret := fields[0]
            first := fields[1]
            count := fields[2]
            at := _x_word() == 4 ? 12 : 16
            text := ((data as i64) + (at as i64)) as void**
            mut inserted := Vector {} as Vector<int>
            defer inserted.free()
            _x_text_points(text[0], inserted)
            mut next := Vector {} as Vector<int>
            repeat _x_preedit.len() in i:
                if i == first:
                    each c in inserted:
                        next.push(c)
                    end
                end
                if i < first or i >= first + count:
                    next.push(_x_preedit[i])
                end
            end
            if first >= _x_preedit.len():
                each c in inserted:
                    next.push(c)
                end
            end
            _x_preedit.free()
            _x_preedit = next
            _x_caret = caret
            _x_composing = true
            _x_send_preedit()
        end

        func salam_window_x11_preedit_caret(_ic: void*, _client: void*, data: void*):
            if data != null:
                _x_caret = (data as i32*)[0]
                _x_send_preedit()
            end
        end
    end

    func _x_word(): int:
        ret sizeof(usize) as int
    end

    func _x_long(ev: void*, index: int): usize:
        ret (((ev as i64) + ((index * _x_word()) as i64)) as usize*)[0]
    end

    func _x_set_long(ev: void*, index: int, value: usize):
        (((ev as i64) + ((index * _x_word()) as i64)) as usize*)[0] = value
    end

    func _x_int(ev: void*, offset: int): int:
        ret (((ev as i64) + (offset as i64)) as i32*)[0]
    end

    func _x_set_int(ev: void*, offset: int, value: int):
        (((ev as i64) + (offset as i64)) as i32*)[0] = value
    end

    func _x_atom(name: str): usize:
        ret XInternAtom(_xd, name, 0)
    end

    func _x_text_points(text: void*, out &: Vector<int>):
        if text == null:
            ret
        end
        length := (text as u16*)[0] as int
        wide := _x_int(text, _x_word() * 2) != 0
        raw := ((text as i64) + ((_x_word() * 3) as i64)) as void**
        chars := raw[0]
        if chars == null:
            ret
        end
        if wide:
            repeat length in i:
                out.push((chars as i32*)[i])
            end
            ret
        end
        bytes := chars as u8*
        mut at := 0
        until out.len() < length and bytes[at] != (0 as u8):
            b := bytes[at] as int
            mut cp := b
            mut extra := 0
            if b >= 0xF0:
                cp = b & 0x07
                extra = 3
            else b >= 0xE0:
                cp = b & 0x0F
                extra = 2
            else b >= 0xC0:
                cp = b & 0x1F
                extra = 1
            end
            at++
            repeat extra:
                if bytes[at] != (0 as u8):
                    cp = (cp << 6) | ((bytes[at] as int) & 0x3F)
                    at++
                end
            end
            out.push(cp)
        end
    end

    func _x_utf8(points: Vector<int>, stop: int): str:
        mut b := str.NewBuilder()
        repeat points.len() in i:
            if i >= stop:
                break
            end
            str.BufAppendCp(b, points[i])
        end
        ret str.BufStr(b)
    end

    func _x_send_preedit():
        if _x_focus_id < 0:
            ret
        end
        text := _x_utf8(_x_preedit, _x_preedit.len())
        head := _x_utf8(_x_preedit, _x_caret)
        _push(Event { kind = EventKind.ImePreedit, window = _x_focus_id, text = text, cursor = head.len() })
        mem.Free(text as void*)
        mem.Free(head as void*)
    end

    func _x_find(w: usize): int:
        repeat _x_wins.len() in i:
            if _x_wins[i].open and _x_wins[i].win == w:
                ret i
            end
        end
        ret -1
    end

    func _x_dpi_scale(): f64:
        res := XResourceManagerString(_xd)
        if res == null:
            ret 1.0
        end
        text := res as str
        at := str.IndexOf(text, "Xft.dpi:")
        if at < 0:
            ret 1.0
        end
        mut i := at + 8
        until i < text.len() and (text[i] == ' ' or text[i] == '\t'):
            i++
        end
        mut j := i
        until j < text.len() and ((text[j] >= '0' and text[j] <= '9') or text[j] == '.'):
            j++
        end
        if j == i:
            ret 1.0
        end
        part := text.substr(i, j - i)
        dpi := str.ToFloat(part)
        mem.Free(part as void*)
        if dpi < 24.0:
            ret 1.0
        end
        ret dpi / 96.0
    end

    func _x_mods(state: int): int:
        mut m := 0
        if (state & 1) != 0:
            m |= ModShift
        end
        if (state & 4) != 0:
            m |= ModControl
        end
        if (state & 8) != 0:
            m |= ModAlt
        end
        if (state & 64) != 0:
            m |= ModSuper
        end
        ret m
    end

