        else:
            n := XLookupString(ev, buf as void*, 255, keysym, null)
            if n > 0:
                text = _x_latin1(buf, n)
            end
        end
        if text.len() == 0:
            ret
        end
        defer mem.Free(text as void*)
        first := (text as u8*)[0] as int
        if first < 32 or first == 127 or (mods & (ModControl | ModSuper)) != 0:
            ret
        end
        _push(Event { kind = _x_composing ? EventKind.ImeCommit : EventKind.TextInput, window = id, text = text, modifiers = mods })
    end

    func _x_serve(ev: void*):
        requestor := _x_long(ev, 5)
        selection := _x_long(ev, 6)
        target := _x_long(ev, 7)
        mut property := _x_long(ev, 8)
        stamp := _x_long(ev, 9)
        if property == (0 as usize):
