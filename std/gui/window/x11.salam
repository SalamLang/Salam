    end

    func _x_receive(ev: void*):
        if _x_long(ev, 4) != _x_helper:
            ret
        end
        _x_sel_done = true
        property := _x_long(ev, 7)
        if property == (0 as usize):
            ret
        end
        holder := mem.AllocateZeroed(64 as u64)
        defer mem.Free(holder)
        kind := holder
        format := ((holder as i64) + (8 as i64)) as void*
        count := ((holder as i64) + (16 as i64)) as void*
        after := ((holder as i64) + (24 as i64)) as void*
        data := ((holder as i64) + (32 as i64)) as void*
        if XGetWindowProperty(_xd, _x_helper, property, 0 as size, 4194304 as size, 1, 0 as usize, kind, format, count, after, data) != 0:
            ret
