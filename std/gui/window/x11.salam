        end
        _x_clip = str.Clone(text)
        _x_clip_owned = true
        XSetSelectionOwner(_xd, _x_atoms[11], _x_helper, 0 as usize)
        XFlush(_xd)
        ret XGetSelectionOwner(_xd, _x_atoms[11]) == _x_helper
    end

    func _nat_scheme(): ColorScheme:
