@en "i18n"
@fa "بین‌المللی‌سازی"
package i18n

import str
import env
import config

@en "Catalog"
@fa "فهرست ترجمه"
pub struct Catalog:
    @en "keys"
    @fa "کلیدها"
    pub keys: Vector<str> = Vector {}
    @en "vals"
    @fa "ترجمه‌ها"
    pub vals: Vector<str> = Vector {}
    @en "fallback"
    @fa "زبان پشتیبان"
    pub fallback: str = "en"
end

func _combine(locale: str, key: str): str: ret locale.Concat(":").Concat(key) end

func _find(c &: Catalog, locale: str, key: str): int:
    combined := _combine(locale, key)
    repeat c.keys.Len() in i:
        if c.keys.Get(i) == combined: ret i end
    end
    ret 0 - 1
end

func _normalize_locale(v: str): str:
    mut s := str.Trim(v)
    dot := s.Find(".")
    if dot >= 0: s = s.Substr(0, dot) end
    us := s.Find("_")
    if us >= 0: s = s.Substr(0, us) end
    dash := s.Find("-")
    if dash >= 0: s = s.Substr(0, dash) end
    ret str.Lower(s)
end

@en "New"
@fa "جدید"
pub func New(default_locale: str): Catalog: ret Catalog { fallback = default_locale } end

@en "Set"
@fa "تنظیم"
pub func Set(c &: Catalog, locale: str, key: str, val: str):
    idx := _find(c, locale, key)
    if idx >= 0:
        c.vals.Set(idx, val)
    else:
        c.keys.Push(_combine(locale, key))
        c.vals.Push(val)
    end
end

@en "Has"
@fa "دارد"
pub func Has(c &: Catalog, locale: str, key: str): bool: ret _find(c, locale, key) >= 0 end

@en "RawGet"
@fa "دریافت خام"
pub func RawGet(c &: Catalog, locale: str, key: str): str:
    idx := _find(c, locale, key)
    if idx < 0: ret "" end
    ret c.vals.Get(idx)
end

@en "T"
@fa "ترجمه"
pub func T(c &: Catalog, locale: str, key: str): str:
    v := RawGet(c, locale, key)
    if v.Len() > 0: ret v end
    if locale != c.fallback:
        fv := RawGet(c, c.fallback, key)
        if fv.Len() > 0: ret fv end
    end
    ret key
end

@en "Interpolate"
@fa "جایگذاری"
pub func Interpolate(msg: str, param_names: Vector<str>, param_vals: Vector<str>): str:
    mut out := msg
    repeat param_names.Len() in i:
        placeholder := "{".Concat(param_names.Get(i)).Concat("}")
        out = str.Replace(out, placeholder, param_vals.Get(i))
    end
    ret out
end

@en "Tf"
@fa "ترجمه قالبی"
pub func Tf(c &: Catalog, locale: str, key: str, param_names: Vector<str>, param_vals: Vector<str>): str:
    ret Interpolate(T(c, locale, key), param_names, param_vals)
end

@en "Plural"
@fa "جمع"
pub func Plural(c &: Catalog, locale: str, key: str, n: i64): str:
    mut suffix := ".other"
    if n == (1 as i64): suffix = ".one" end
    combined_key := key.Concat(suffix)
    if Has(c, locale, combined_key) or Has(c, c.fallback, combined_key):
        ret T(c, locale, combined_key)
    end
    ret T(c, locale, key)
end

@en "LoadLocale"
@fa "بارگذاری زبان"
pub func LoadLocale(c &: Catalog, locale: str, path: str): int:
    mut cfg := config.LoadEnv(path)
    keys := config.Keys(cfg)
    defer keys.Free()
    repeat keys.Len() in i:
        k := keys.Get(i)
        Set(c, locale, k, config.Get(cfg, k))
    end
    ret keys.Len()
end

@en "DetectLocale"
@fa "تشخیص زبان"
pub func DetectLocale(): str:
    mut v := env.Get("SALAM_LOCALE")
    if v.Len() > 0: ret _normalize_locale(v) end
    v = env.Get("LANG")
    if v.Len() > 0: ret _normalize_locale(v) end
    v = env.Get("LC_ALL")
    if v.Len() > 0: ret _normalize_locale(v) end
    ret "en"
end

@en "Free"
@fa "آزادسازی"
pub func Free(c &: Catalog):
    c.keys.Free()
    c.vals.Free()
end
