package image

const _AR_ISOLATED := 0
const _AR_FINAL := 1
const _AR_INITIAL := 2
const _AR_MEDIAL := 3

func _arabic_form_base(cp: int, count &: int): int:
    count = 0
    if cp == 0xFEF5 || cp == 0xFEF7 || cp == 0xFEF9 || cp == 0xFEFB:
        count = 2
        ret cp
    end
    if cp < 0x0621 || cp > 0x06D3:
        ret 0
    end
    if cp == 0x0621: count = 1 ret 0xFE80 end
    if cp == 0x0622: count = 2 ret 0xFE81 end
    if cp == 0x0623: count = 2 ret 0xFE83 end
    if cp == 0x0624: count = 2 ret 0xFE85 end
    if cp == 0x0625: count = 2 ret 0xFE87 end
    if cp == 0x0626: count = 4 ret 0xFE89 end
    if cp == 0x0627: count = 2 ret 0xFE8D end
    if cp == 0x0628: count = 4 ret 0xFE8F end
    if cp == 0x0629: count = 2 ret 0xFE93 end
    if cp == 0x062A: count = 4 ret 0xFE95 end
    if cp == 0x062B: count = 4 ret 0xFE99 end
    if cp == 0x062C: count = 4 ret 0xFE9D end
    if cp == 0x062D: count = 4 ret 0xFEA1 end
    if cp == 0x062E: count = 4 ret 0xFEA5 end
    if cp == 0x062F: count = 2 ret 0xFEA9 end
    if cp == 0x0630: count = 2 ret 0xFEAB end
    if cp == 0x0631: count = 2 ret 0xFEAD end
    if cp == 0x0632: count = 2 ret 0xFEAF end
    if cp == 0x0633: count = 4 ret 0xFEB1 end
    if cp == 0x0634: count = 4 ret 0xFEB5 end
    if cp == 0x0635: count = 4 ret 0xFEB9 end
    if cp == 0x0636: count = 4 ret 0xFEBD end
    if cp == 0x0637: count = 4 ret 0xFEC1 end
    if cp == 0x0638: count = 4 ret 0xFEC5 end
    if cp == 0x0639: count = 4 ret 0xFEC9 end
    if cp == 0x063A: count = 4 ret 0xFECD end
    if cp == 0x0641: count = 4 ret 0xFED1 end
    if cp == 0x0642: count = 4 ret 0xFED5 end
    if cp == 0x0643: count = 4 ret 0xFED9 end
    if cp == 0x0644: count = 4 ret 0xFEDD end
    if cp == 0x0645: count = 4 ret 0xFEE1 end
    if cp == 0x0646: count = 4 ret 0xFEE5 end
    if cp == 0x0647: count = 4 ret 0xFEE9 end
    if cp == 0x0648: count = 2 ret 0xFEED end
    if cp == 0x064A: count = 4 ret 0xFEF1 end
    if cp == 0x0671: count = 2 ret 0xFB50 end
    if cp == 0x0677: count = 1 ret 0xFBDD end
    if cp == 0x0679: count = 4 ret 0xFB66 end
    if cp == 0x067A: count = 4 ret 0xFB5E end
    if cp == 0x067B: count = 4 ret 0xFB52 end
    if cp == 0x067E: count = 4 ret 0xFB56 end
    if cp == 0x067F: count = 4 ret 0xFB62 end
    if cp == 0x0680: count = 4 ret 0xFB5A end
    if cp == 0x0683: count = 4 ret 0xFB76 end
    if cp == 0x0684: count = 4 ret 0xFB72 end
    if cp == 0x0686: count = 4 ret 0xFB7A end
    if cp == 0x0687: count = 4 ret 0xFB7E end
    if cp == 0x0688: count = 2 ret 0xFB88 end
    if cp == 0x068C: count = 2 ret 0xFB84 end
    if cp == 0x068D: count = 2 ret 0xFB82 end
    if cp == 0x068E: count = 2 ret 0xFB86 end
    if cp == 0x0691: count = 2 ret 0xFB8C end
    if cp == 0x0698: count = 2 ret 0xFB8A end
    if cp == 0x06A4: count = 4 ret 0xFB6A end
    if cp == 0x06A6: count = 4 ret 0xFB6E end
    if cp == 0x06A9: count = 4 ret 0xFB8E end
    if cp == 0x06AD: count = 4 ret 0xFBD3 end
    if cp == 0x06AF: count = 4 ret 0xFB92 end
    if cp == 0x06B1: count = 4 ret 0xFB9A end
    if cp == 0x06B3: count = 4 ret 0xFB96 end
    if cp == 0x06BA: count = 2 ret 0xFB9E end
    if cp == 0x06BB: count = 4 ret 0xFBA0 end
    if cp == 0x06BE: count = 4 ret 0xFBAA end
    if cp == 0x06C0: count = 2 ret 0xFBA4 end
    if cp == 0x06C1: count = 4 ret 0xFBA6 end
    if cp == 0x06C5: count = 2 ret 0xFBE0 end
    if cp == 0x06C6: count = 2 ret 0xFBD9 end
    if cp == 0x06C7: count = 2 ret 0xFBD7 end
    if cp == 0x06C8: count = 2 ret 0xFBDB end
    if cp == 0x06C9: count = 2 ret 0xFBE2 end
    if cp == 0x06CB: count = 2 ret 0xFBDE end
    if cp == 0x06CC: count = 4 ret 0xFBFC end
    if cp == 0x06D0: count = 4 ret 0xFBE4 end
    if cp == 0x06D2: count = 2 ret 0xFBAE end
    if cp == 0x06D3: count = 2 ret 0xFBB0 end
    ret 0
end

func _arabic_join_count(cp: int): int:
    if cp == 0x0640:
        ret 2
    end
    mut count := 0
    _arabic_form_base(cp, count)
    if count == 4: ret 2 end
    if count == 2: ret 1 end
    ret 0
end

func _arabic_transparent(cp: int): bool:
    if cp >= 0x0610 && cp <= 0x061A: ret true end
    if cp >= 0x064B && cp <= 0x065F: ret true end
    if cp == 0x0670: ret true end
    if cp >= 0x06D6 && cp <= 0x06DC: ret true end
    if cp >= 0x06DF && cp <= 0x06E4: ret true end
    if cp >= 0x06E7 && cp <= 0x06E8: ret true end
    if cp >= 0x06EA && cp <= 0x06ED: ret true end
    if cp >= 0x0300 && cp <= 0x036F: ret true end
    if cp >= 0x0591 && cp <= 0x05BD: ret true end
    if cp == 0x05BF || cp == 0x05C1 || cp == 0x05C2: ret true end
    if cp == 0x05C4 || cp == 0x05C5 || cp == 0x05C7: ret true end
    if cp == 0x200D: ret true end
    ret false
end

func _arabic_shaped(cp: int, form: int): int:
    if cp == 0x0649:
        if form == _AR_INITIAL: ret 0xFBE8 end
        if form == _AR_MEDIAL: ret 0xFBE9 end
        if form == _AR_FINAL: ret 0xFEF0 end
        ret 0xFEEF
    end
    mut count := 0
    base := _arabic_form_base(cp, count)
    if base == 0 || count == 0:
        ret cp
    end
    mut want := form
    if want >= count:
        if want == _AR_MEDIAL: want = _AR_FINAL end
        if want == _AR_INITIAL: want = _AR_ISOLATED end
    end
    if want >= count:
        want = _AR_ISOLATED
    end
    ret base + want
end

func _arabic_lam_alef(lam: int, alef: int): int:
    if lam != 0x0644:
        ret 0
    end
    if alef == 0x0622: ret 0xFEF5 end
    if alef == 0x0623: ret 0xFEF7 end
    if alef == 0x0625: ret 0xFEF9 end
    if alef == 0x0627: ret 0xFEFB end
    ret 0
end
