package image

import str

@en "FontWidth"
@fa "عرض قلم"
pub const FontWidth := 5

@en "FontHeight"
@fa "ارتفاع قلم"
pub const FontHeight := 7

func _glyph(ch: int): str:
    if ch == 48: ret ".###." + "#...#" + "#..##" + "#.#.#" + "##..#" + "#...#" + ".###." end
    if ch == 49: ret "..#.." + ".##.." + "..#.." + "..#.." + "..#.." + "..#.." + ".###." end
    if ch == 50: ret ".###." + "#...#" + "....#" + "...#." + "..#.." + ".#..." + "#####" end
    if ch == 51: ret ".###." + "#...#" + "....#" + "..##." + "....#" + "#...#" + ".###." end
    if ch == 52: ret "...#." + "..##." + ".#.#." + "#..#." + "#####" + "...#." + "...#." end
    if ch == 53: ret "#####" + "#...." + "####." + "....#" + "....#" + "#...#" + ".###." end
    if ch == 54: ret ".###." + "#...." + "#...." + "####." + "#...#" + "#...#" + ".###." end
    if ch == 55: ret "#####" + "....#" + "...#." + "..#.." + "..#.." + "..#.." + "..#.." end
    if ch == 56: ret ".###." + "#...#" + "#...#" + ".###." + "#...#" + "#...#" + ".###." end
    if ch == 57: ret ".###." + "#...#" + "#...#" + ".####" + "....#" + "....#" + ".###." end

    if ch == 65: ret "..#.." + ".#.#." + "#...#" + "#####" + "#...#" + "#...#" + "#...#" end
    if ch == 66: ret "####." + "#...#" + "#...#" + "####." + "#...#" + "#...#" + "####." end
    if ch == 67: ret ".###." + "#...#" + "#...." + "#...." + "#...." + "#...#" + ".###." end
    if ch == 68: ret "####." + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + "####." end
    if ch == 69: ret "#####" + "#...." + "#...." + "####." + "#...." + "#...." + "#####" end
    if ch == 70: ret "#####" + "#...." + "#...." + "####." + "#...." + "#...." + "#...." end
    if ch == 71: ret ".###." + "#...#" + "#...." + "#.###" + "#...#" + "#...#" + ".####" end
    if ch == 72: ret "#...#" + "#...#" + "#...#" + "#####" + "#...#" + "#...#" + "#...#" end
    if ch == 73: ret ".###." + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + ".###." end
    if ch == 74: ret "..###" + "...#." + "...#." + "...#." + "...#." + "#..#." + ".##.." end
    if ch == 75: ret "#...#" + "#..#." + "#.#.." + "##..." + "#.#.." + "#..#." + "#...#" end
    if ch == 76: ret "#...." + "#...." + "#...." + "#...." + "#...." + "#...." + "#####" end
    if ch == 77: ret "#...#" + "##.##" + "#.#.#" + "#...#" + "#...#" + "#...#" + "#...#" end
    if ch == 78: ret "#...#" + "##..#" + "#.#.#" + "#..##" + "#...#" + "#...#" + "#...#" end
    if ch == 79: ret ".###." + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".###." end
    if ch == 80: ret "####." + "#...#" + "#...#" + "####." + "#...." + "#...." + "#...." end
    if ch == 81: ret ".###." + "#...#" + "#...#" + "#...#" + "#.#.#" + "#..#." + ".##.#" end
    if ch == 82: ret "####." + "#...#" + "#...#" + "####." + "#.#.." + "#..#." + "#...#" end
    if ch == 83: ret ".####" + "#...." + "#...." + ".###." + "....#" + "....#" + "####." end
    if ch == 84: ret "#####" + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." end
    if ch == 85: ret "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".###." end
    if ch == 86: ret "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".#.#." + "..#.." end
    if ch == 87: ret "#...#" + "#...#" + "#...#" + "#.#.#" + "#.#.#" + "##.##" + "#...#" end
    if ch == 88: ret "#...#" + "#...#" + ".#.#." + "..#.." + ".#.#." + "#...#" + "#...#" end
    if ch == 89: ret "#...#" + "#...#" + ".#.#." + "..#.." + "..#.." + "..#.." + "..#.." end
    if ch == 90: ret "#####" + "....#" + "...#." + "..#.." + ".#..." + "#...." + "#####" end

    if ch == 46: ret "....." + "....." + "....." + "....." + "....." + "..#.." + "..#.." end
    if ch == 44: ret "....." + "....." + "....." + "....." + "....." + "..#.." + ".#..." end
    if ch == 45: ret "....." + "....." + "....." + "#####" + "....." + "....." + "....." end
    if ch == 58: ret "....." + "..#.." + "....." + "....." + "..#.." + "....." + "....." end
    if ch == 33: ret "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + "....." + "..#.." end
    if ch == 63: ret ".###." + "#...#" + "....#" + "..##." + "..#.." + "....." + "..#.." end

    ret "....." + "....." + "....." + "....." + "....." + "....." + "....."
end

func _text_glyph_byte(s: str, i: int): int:
    bp := s as u8*
    ret bp[i] as int
end

@en "DrawText"
@fa "نوشتن متن"
pub func DrawText(img &: Image, x: int, y: int, text: str, c: Color, scale: int):
    s := scale < 1 ? 1 : scale
    n := str.Len(text)
    bp := text as u8*
    mut pen_x := x
    mut i := 0
    until i < n:
        ch := bp[i] as int
        glyph := _glyph(ch)
        mut row := 0
        until row < FontHeight:
            mut col := 0
            until col < FontWidth:
                gp := _text_glyph_byte(glyph, row * FontWidth + col)
                if gp == 35:
                    DrawRectFilled(img, pen_x + col * s, y + row * s, s, s, c)
                end
                col += 1
            end
            row += 1
        end
        pen_x += (FontWidth + 1) * s
        i += 1
    end
end

@en "TextWidth"
@fa "عرض متن"
pub func TextWidth(text: str, scale: int): int:
    s := scale < 1 ? 1 : scale
    ret str.Len(text) * (FontWidth + 1) * s
end
