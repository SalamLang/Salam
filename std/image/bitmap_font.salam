package image

import str

// A tiny embedded 5x7 dot-matrix bitmap font (digits, uppercase A-Z, space,
// and a handful of punctuation) - self-contained, no font file/FreeType/
// external dependency, exactly enough for text watermarks and simple
// labels. Each glyph is 7 literal 5-character rows ('#' = ink, '.' =
// blank) concatenated into one 35-char string, laid out in the source so
// the shape is readable directly from the code. Unsupported characters
// (lowercase, accents, CJK, ...) draw as blank space rather than erroring.

@en "FontWidth"
@fa "عرض قلم"
@ar "عرض الخط"
pub const FontWidth := 5

@en "FontHeight"
@fa "ارتفاع قلم"
@ar "ارتفاع الخط"
pub const FontHeight := 7

func _glyph(ch: int): str:
    // digits
    if ch == 48: ret ".###." + "#...#" + "#..##" + "#.#.#" + "##..#" + "#...#" + ".###." end // 0
    if ch == 49: ret "..#.." + ".##.." + "..#.." + "..#.." + "..#.." + "..#.." + ".###." end // 1
    if ch == 50: ret ".###." + "#...#" + "....#" + "...#." + "..#.." + ".#..." + "#####" end // 2
    if ch == 51: ret ".###." + "#...#" + "....#" + "..##." + "....#" + "#...#" + ".###." end // 3
    if ch == 52: ret "...#." + "..##." + ".#.#." + "#..#." + "#####" + "...#." + "...#." end // 4
    if ch == 53: ret "#####" + "#...." + "####." + "....#" + "....#" + "#...#" + ".###." end // 5
    if ch == 54: ret ".###." + "#...." + "#...." + "####." + "#...#" + "#...#" + ".###." end // 6
    if ch == 55: ret "#####" + "....#" + "...#." + "..#.." + "..#.." + "..#.." + "..#.." end // 7
    if ch == 56: ret ".###." + "#...#" + "#...#" + ".###." + "#...#" + "#...#" + ".###." end // 8
    if ch == 57: ret ".###." + "#...#" + "#...#" + ".####" + "....#" + "....#" + ".###." end // 9

    // uppercase letters
    if ch == 65: ret "..#.." + ".#.#." + "#...#" + "#####" + "#...#" + "#...#" + "#...#" end // A
    if ch == 66: ret "####." + "#...#" + "#...#" + "####." + "#...#" + "#...#" + "####." end // B
    if ch == 67: ret ".###." + "#...#" + "#...." + "#...." + "#...." + "#...#" + ".###." end // C
    if ch == 68: ret "####." + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + "####." end // D
    if ch == 69: ret "#####" + "#...." + "#...." + "####." + "#...." + "#...." + "#####" end // E
    if ch == 70: ret "#####" + "#...." + "#...." + "####." + "#...." + "#...." + "#...." end // F
    if ch == 71: ret ".###." + "#...#" + "#...." + "#.###" + "#...#" + "#...#" + ".####" end // G
    if ch == 72: ret "#...#" + "#...#" + "#...#" + "#####" + "#...#" + "#...#" + "#...#" end // H
    if ch == 73: ret ".###." + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + ".###." end // I
    if ch == 74: ret "..###" + "...#." + "...#." + "...#." + "...#." + "#..#." + ".##.." end // J
    if ch == 75: ret "#...#" + "#..#." + "#.#.." + "##..." + "#.#.." + "#..#." + "#...#" end // K
    if ch == 76: ret "#...." + "#...." + "#...." + "#...." + "#...." + "#...." + "#####" end // L
    if ch == 77: ret "#...#" + "##.##" + "#.#.#" + "#...#" + "#...#" + "#...#" + "#...#" end // M
    if ch == 78: ret "#...#" + "##..#" + "#.#.#" + "#..##" + "#...#" + "#...#" + "#...#" end // N
    if ch == 79: ret ".###." + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".###." end // O
    if ch == 80: ret "####." + "#...#" + "#...#" + "####." + "#...." + "#...." + "#...." end // P
    if ch == 81: ret ".###." + "#...#" + "#...#" + "#...#" + "#.#.#" + "#..#." + ".##.#" end // Q
    if ch == 82: ret "####." + "#...#" + "#...#" + "####." + "#.#.." + "#..#." + "#...#" end // R
    if ch == 83: ret ".####" + "#...." + "#...." + ".###." + "....#" + "....#" + "####." end // S
    if ch == 84: ret "#####" + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." end // T
    if ch == 85: ret "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".###." end // U
    if ch == 86: ret "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".#.#." + "..#.." end // V
    if ch == 87: ret "#...#" + "#...#" + "#...#" + "#.#.#" + "#.#.#" + "##.##" + "#...#" end // W
    if ch == 88: ret "#...#" + "#...#" + ".#.#." + "..#.." + ".#.#." + "#...#" + "#...#" end // X
    if ch == 89: ret "#...#" + "#...#" + ".#.#." + "..#.." + "..#.." + "..#.." + "..#.." end // Y
    if ch == 90: ret "#####" + "....#" + "...#." + "..#.." + ".#..." + "#...." + "#####" end // Z

    // punctuation
    if ch == 46: ret "....." + "....." + "....." + "....." + "....." + "..#.." + "..#.." end // .
    if ch == 44: ret "....." + "....." + "....." + "....." + "....." + "..#.." + ".#..." end // ,
    if ch == 45: ret "....." + "....." + "....." + "#####" + "....." + "....." + "....." end // -
    if ch == 58: ret "....." + "..#.." + "....." + "....." + "..#.." + "....." + "....." end // :
    if ch == 33: ret "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + "....." + "..#.." end // !
    if ch == 63: ret ".###." + "#...#" + "....#" + "..##." + "..#.." + "....." + "..#.." end // ?

    ret "....." + "....." + "....." + "....." + "....." + "....." + "....."
end

func _text_glyph_byte(s: str, i: int): int:
    bp := s as u8*
    ret bp[i] as int
end

// Draws `text` with its top-left corner at (x, y): each glyph is FontWidth
// x FontHeight, magnified `scale`x, with 1*scale columns of spacing
// between characters. Only ASCII bytes are looked up (see _glyph); UTF-8
// continuation bytes of a multi-byte codepoint draw as blank cells rather
// than erroring or misrendering.
@en "DrawText"
@fa "نوشتن متن"
@ar "ارسم نصا"
pub func DrawText(img &: Image, x: int, y: int, text: str, c: Color, scale: int):
    s := scale < 1 ? 1 : scale
    n := str.Len(text)
    bp := text as u8*
    mut pen_x := x
    mut i := 0
    until i < n:
        ch := bp[i] as int
        glyph := _glyph(ch)
        mut row := 0
        until row < FontHeight:
            mut col := 0
            until col < FontWidth:
                gp := _text_glyph_byte(glyph, row * FontWidth + col)
                if gp == 35:
                    DrawRectFilled(img, pen_x + col * s, y + row * s, s, s, c)
                end
                col += 1
            end
            row += 1
        end
        pen_x += (FontWidth + 1) * s
        i += 1
    end
end

// Width in pixels DrawText(..., text, ..., scale) would occupy - useful
// for right-aligning or centering a watermark.
@en "TextWidth"
@fa "عرض متن"
@ar "عرض النص"
pub func TextWidth(text: str, scale: int): int:
    s := scale < 1 ? 1 : scale
    ret str.Len(text) * (FontWidth + 1) * s
end
