package image

import math

// Drawing primitives: lines, rectangles (border + filled), circles
// (border + filled). Every function draws through BlendPixel, so a
// semi-transparent color composites over what's already there instead of
// stomping it - opaque colors (the common case) behave exactly like a
// plain overwrite.

func _iabs(v: int): int:
    if v < 0: ret -v end
    ret v
end

func _imin(a: int, b: int): int:
    if a < b: ret a end
    ret b
end

func _imax(a: int, b: int): int:
    if a > b: ret a end
    ret b
end

// Bresenham's line algorithm - straight lines at any angle, endpoints
// inclusive.
@en "DrawLine"
@fa "رسم خط"
@ar "ارسم خطا"
pub func DrawLine(img &: Image, x0: int, y0: int, x1: int, y1: int, c: Color):
    dx := _iabs(x1 - x0)
    dy := -_iabs(y1 - y0)
    mut sx := 1
    if x0 >= x1: sx = -1 end
    mut sy := 1
    if y0 >= y1: sy = -1 end
    mut err := dx + dy
    mut x := x0
    mut y := y0
    until true:
        BlendPixel(img, x, y, c)
        if x == x1 && y == y1: break end
        e2 := 2 * err
        if e2 >= dy:
            err += dy
            x += sx
        end
        if e2 <= dx:
            err += dx
            y += sy
        end
    end
end

// A 1px-thick rectangle outline, corners at (x,y) and (x+w-1,y+h-1).
@en "DrawRect"
@fa "رسم مستطیل"
@ar "ارسم مستطيلا"
pub func DrawRect(img &: Image, x: int, y: int, w: int, h: int, c: Color):
    if w <= 0 || h <= 0: ret end
    x1 := x + w - 1
    y1 := y + h - 1
    DrawLine(img, x, y, x1, y, c)
    DrawLine(img, x, y1, x1, y1, c)
    DrawLine(img, x, y, x, y1, c)
    DrawLine(img, x1, y, x1, y1, c)
end

@en "DrawRectFilled"
@fa "رسم مستطیل پر"
@ar "ارسم مستطيلا ممتلئا"
pub func DrawRectFilled(img &: Image, x: int, y: int, w: int, h: int, c: Color):
    if w <= 0 || h <= 0: ret end
    x0 := _imax(x, 0)
    y0 := _imax(y, 0)
    x1 := _imin(x + w, img.width)
    y1 := _imin(y + h, img.height)
    mut yy := y0
    until yy < y1:
        mut xx := x0
        until xx < x1:
            BlendPixel(img, xx, yy, c)
            xx += 1
        end
        yy += 1
    end
end

// Midpoint circle algorithm (a.k.a. Bresenham's circle) - an 8-way
// symmetric outline of the given radius centered at (cx, cy).
@en "DrawCircle"
@fa "رسم دایره"
@ar "ارسم دائرة"
pub func DrawCircle(img &: Image, cx: int, cy: int, radius: int, c: Color):
    if radius <= 0:
        BlendPixel(img, cx, cy, c)
        ret
    end
    mut x := radius
    mut y := 0
    mut err := 0
    until y <= x:
        BlendPixel(img, cx + x, cy + y, c)
        BlendPixel(img, cx + y, cy + x, c)
        BlendPixel(img, cx - y, cy + x, c)
        BlendPixel(img, cx - x, cy + y, c)
        BlendPixel(img, cx - x, cy - y, c)
        BlendPixel(img, cx - y, cy - x, c)
        BlendPixel(img, cx + y, cy - x, c)
        BlendPixel(img, cx + x, cy - y, c)
        y += 1
        if err <= 0:
            err += 2 * y + 1
        end
        if err > 0:
            x -= 1
            err -= 2 * x + 1
        end
    end
end

// Filled disc: scans each row of the bounding box and keeps points inside
// the radius, so it also works as "circle with thick border" when called
// before DrawCircle draws a contrasting outline on top.
@en "DrawCircleFilled"
@fa "رسم دایره پر"
@ar "ارسم دائرة ممتلئة"
pub func DrawCircleFilled(img &: Image, cx: int, cy: int, radius: int, c: Color):
    if radius <= 0:
        BlendPixel(img, cx, cy, c)
        ret
    end
    r2 := radius * radius
    mut dy := -radius
    until dy <= radius:
        dx_max := math.Sqrt((r2 - dy * dy) as f64) as int
        mut dx := -dx_max
        until dx <= dx_max:
            BlendPixel(img, cx + dx, cy + dy, c)
            dx += 1
        end
        dy += 1
    end
end
