package image

import compress
import archive
import mem
import math

// Baseline sequential JPEG (ITU-T T.81), from scratch: RGB->YCbCr, 8x8
// forward/inverse DCT, the standard (Annex K) quantization and Huffman
// tables, and MSB-first entropy coding with byte-stuffing. No progressive
// scans, no arithmetic coding, no restart markers - the same "baseline,
// single scan" subset every encoder/decoder in existence supports.
//
// EncodeJPEG always writes 4:4:4 (no chroma subsampling: every component
// at full resolution) - simpler to encode correctly than interleaved
// subsampled MCUs, at the cost of a bit less compression than a
// subsampling encoder would get at the same quality. DecodeJPEG reads
// real-world files as produced by libjpeg/Pillow/etc: any of 4:4:4/4:2:2/
// 4:2:0 sampling, and Huffman/quantization tables with id 0 or 1 per
// class (universally what real encoders emit) - not the full spec's id
// 0-3 range, and not progressive/arithmetic scans (ok = false for those,
// same "report, don't misread" rule as every other decoder here).
//
// This is float-math-heavy code (the DCT); verify with the compiled
// backend, not `salam exec` (see this package's/std/compress's notes on
// the interpreter being a poor fit for numerically heavy stdlib code).

const _PI := 3.14159265358979323846

// MSB-first bit accumulator for entropy-coded output, with JPEG's
// 0xFF -> 0xFF 0x00 byte-stuffing applied as each full byte is flushed.
// `buf`'s default is left to ByteBuf's own field defaults (see
// std/compress/bits.salam's identical BitWriter for why: tcc cannot parse
// a nested multi-field struct literal passed in as a plain variable).
struct _BitWriter:
    pub buf: compress.ByteBuf = compress.ByteBuf { data = null, len = 0, cap = 0 }
    pub acc: int = 0
    pub nbits: int = 0
end

// MSB-first bit cursor over entropy-coded input, undoing byte-stuffing as
// it goes; `hit_marker` latches true once a real marker (FF followed by a
// non-zero, non-RST byte) is seen, after which reads return 0 bits
// instead of consuming the marker.
struct _BitReader:
    pub data: void* = null
    pub len: int = 0
    pub pos: int = 0
    pub acc: int = 0
    pub nbits: int = 0
    pub hit_marker: bool = false
end

func _zigzag(i: int): int:
    if i == 0: ret 0 end
    if i == 1: ret 1 end
    if i == 2: ret 8 end
    if i == 3: ret 16 end
    if i == 4: ret 9 end
    if i == 5: ret 2 end
    if i == 6: ret 3 end
    if i == 7: ret 10 end
    if i == 8: ret 17 end
    if i == 9: ret 24 end
    if i == 10: ret 32 end
    if i == 11: ret 25 end
    if i == 12: ret 18 end
    if i == 13: ret 11 end
    if i == 14: ret 4 end
    if i == 15: ret 5 end
    if i == 16: ret 12 end
    if i == 17: ret 19 end
    if i == 18: ret 26 end
    if i == 19: ret 33 end
    if i == 20: ret 40 end
    if i == 21: ret 48 end
    if i == 22: ret 41 end
    if i == 23: ret 34 end
    if i == 24: ret 27 end
    if i == 25: ret 20 end
    if i == 26: ret 13 end
    if i == 27: ret 6 end
    if i == 28: ret 7 end
    if i == 29: ret 14 end
    if i == 30: ret 21 end
    if i == 31: ret 28 end
    if i == 32: ret 35 end
    if i == 33: ret 42 end
    if i == 34: ret 49 end
    if i == 35: ret 56 end
    if i == 36: ret 57 end
    if i == 37: ret 50 end
    if i == 38: ret 43 end
    if i == 39: ret 36 end
    if i == 40: ret 29 end
    if i == 41: ret 22 end
    if i == 42: ret 15 end
    if i == 43: ret 23 end
    if i == 44: ret 30 end
    if i == 45: ret 37 end
    if i == 46: ret 44 end
    if i == 47: ret 51 end
    if i == 48: ret 58 end
    if i == 49: ret 59 end
    if i == 50: ret 52 end
    if i == 51: ret 45 end
    if i == 52: ret 38 end
    if i == 53: ret 31 end
    if i == 54: ret 39 end
    if i == 55: ret 46 end
    if i == 56: ret 53 end
    if i == 57: ret 60 end
    if i == 58: ret 61 end
    if i == 59: ret 54 end
    if i == 60: ret 47 end
    if i == 61: ret 55 end
    if i == 62: ret 62 end
    ret 63
end

