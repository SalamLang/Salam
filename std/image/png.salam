package image

import compress
import archive
import mem

const _CT_IHDR := (73 << 24) | (72 << 16) | (68 << 8) | 82
const _CT_PLTE := (80 << 24) | (76 << 16) | (84 << 8) | 69
const _CT_TRNS := (116 << 24) | (82 << 16) | (78 << 8) | 83
const _CT_IDAT := (73 << 24) | (68 << 16) | (65 << 8) | 84
const _CT_IEND := (73 << 24) | (69 << 16) | (78 << 8) | 68

const _ADAM7 := [0, 0, 8, 8, 4, 0, 8, 8, 0, 4, 4, 8, 2, 0, 4, 4, 0, 2, 2, 4, 1, 0, 2, 2, 0, 1, 1, 2]

func _be_get32(p: void*, off: int): int:
    bp := p as u8*
    ret ((bp[off] as int) << 24) | ((bp[off + 1] as int) << 16) | ((bp[off + 2] as int) << 8) | (bp[off + 3] as int)
end

func _paeth(a: int, b: int, c: int): int:
    p := a + b - c
    mut pa := p - a
    if pa < 0: pa = -pa end
    mut pb := p - b
    if pb < 0: pb = -pb end
    mut pc := p - c
    if pc < 0: pc = -pc end
    if pa <= pb and pa <= pc: ret a end
    if pb <= pc: ret b end
    ret c
end

func _abs_signed_byte(v: int): int:
    b := v & 255
    if b >= 128: ret 256 - b end
    ret b
end

func _write_chunk(out &: compress.ByteBuf, type_tag: int, data: void*, data_len: int):
    compress.BufPushU32(out, data_len)
    start := out.len
    compress.BufPush(out, (type_tag >> 24) & 255)
    compress.BufPush(out, (type_tag >> 16) & 255)
    compress.BufPush(out, (type_tag >> 8) & 255)
    compress.BufPush(out, type_tag & 255)
    if data_len > 0:
        compress.BufPushBytes(out, data, data_len)
    end
    body := ((out.data as i64) + (start as i64)) as void*
    crc := compress.CRC32(body, 4 + data_len)
    compress.BufPushU32(out, crc as int)
end

func _zlib_wrap(raw: void*, raw_len: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    compress.BufPush(out, 0x78)
    compress.BufPush(out, 0x9C)
    deflated := compress.RawDeflate(raw, raw_len)
    compress.BufPushBuf(out, deflated)
    compress.BufFree(deflated)
    adler := compress.Adler32(raw, raw_len)
    compress.BufPushU32(out, adler as int)
    ret out
end

func _zlib_unwrap(p: void*, n: int, expected_size: int, ok &: bool): compress.ByteBuf:
    ok = false
    if n < 6:
        ret compress.NewByteBuf()
    end
    bp := p as u8*
    cmf := bp[0] as int
    if (cmf & 15) != 8:
        ret compress.NewByteBuf()
    end
    body := ((p as i64) + 2) as void*
    body_len := n - 6
    mut inflate_ok := false
    out := compress.RawInflate(body, body_len, expected_size, inflate_ok)
    if not inflate_ok:
        ret out
    end
    ok = true
    ret out
end

func _channels_for(color_type: int): int:
    if color_type == 0: ret 1 end
    if color_type == 2: ret 3 end
    if color_type == 3: ret 1 end
    if color_type == 4: ret 2 end
    if color_type == 6: ret 4 end
    ret 0
end

func _png_depth_ok(ct: int, d: int): bool:
    if ct == 0:
        ret d == 1 or d == 2 or d == 4 or d == 8 or d == 16
    end
    if ct == 3:
        ret d == 1 or d == 2 or d == 4 or d == 8
    end
    ret d == 8 or d == 16
end

func _png_pass_size(n: int, interlace: int, pass: int, horizontal: bool): int:
    if interlace == 0:
        ret n
    end
    start := horizontal ? _ADAM7[pass * 4] : _ADAM7[pass * 4 + 1]
    step := horizontal ? _ADAM7[pass * 4 + 2] : _ADAM7[pass * 4 + 3]
    if n <= start:
        ret 0
    end
    ret (n - start + step - 1) / step
end

func _png_sample(rp: u8*, row: int, i: int, depth: int): int:
    if depth == 8:
        ret rp[row + i] as int
    end
    if depth == 16:
        ret ((rp[row + i * 2] as int) << 8) | (rp[row + i * 2 + 1] as int)
    end
    bit := i * depth
    byte := rp[row + bit / 8] as int
    ret (byte >> (8 - depth - bit % 8)) & ((1 << depth) - 1)
end

func _png_scale(v: int, depth: int, maxv: int): int:
    if depth == 8:
        ret v
    end
    if depth == 16:
        ret (v + 128) / 257
    end
    ret v * 255 / maxv
end

func _png_unfilter(rp: u8*, at: int, stride: int, rows: int, bpp: int):
    repeat rows in y:
        row := at + y * (1 + stride)
        ftype := rp[row] as int
        cur := row + 1
        prev := row - stride
        repeat stride in i:
            x := rp[cur + i] as int
            a := i >= bpp ? rp[cur + i - bpp] as int : 0
            b := y > 0 ? rp[prev + i] as int : 0
            c := y > 0 and i >= bpp ? rp[prev + i - bpp] as int : 0
            mut recon := x
            if ftype == 1:
                recon = x + a
            else ftype == 2:
                recon = x + b
            else ftype == 3:
                recon = x + (a + b) / 2
            else ftype == 4:
                recon = x + _paeth(a, b, c)
            end
            rp[cur + i] = (recon & 255) as u8
        end
    end
end

@en "EncodePNG"
@fa "کدگذاری پی‌ان‌جی"
pub func EncodePNG(img: Image): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    compress.BufPush(out, 137)
    compress.BufPush(out, 80)
    compress.BufPush(out, 78)
    compress.BufPush(out, 71)
    compress.BufPush(out, 13)
    compress.BufPush(out, 10)
    compress.BufPush(out, 26)
    compress.BufPush(out, 10)

    w := img.width
    h := img.height

    mut ihdr := compress.NewByteBuf()
    compress.BufPushU32(ihdr, w)
    compress.BufPushU32(ihdr, h)
    compress.BufPush(ihdr, 8)
    compress.BufPush(ihdr, 6)
    compress.BufPush(ihdr, 0)
    compress.BufPush(ihdr, 0)
    compress.BufPush(ihdr, 0)
    _write_chunk(out, _CT_IHDR, ihdr.data, ihdr.len)
    compress.BufFree(ihdr)

    stride := w * 4
    raw_len := (h * (1 + stride)) as u64
    raw := mem.AllocateZeroed(raw_len)
    rp := raw as u8*

    mut cur := mem.AllocateZeroed(stride as u64)
    mut prev := mem.AllocateZeroed(stride as u64)
    mut cp := cur as u8*
    mut pp := prev as u8*
    cand := mem.AllocateZeroed(stride as u64)
    candp := cand as u8*

    mut y := 0
    until y < h:
        mut x := 0
        until x < w:
            c := GetPixel(img, x, y)
            off := x * 4
            cp[off] = c.r
            cp[off + 1] = c.g
            cp[off + 2] = c.b
            cp[off + 3] = c.a
            x += 1
        end

        mut best_type := 0
        mut best_score := -1
        mut ftype := 0
        until ftype <= 4:
            mut score := 0
            mut i := 0
            until i < stride:
                xv := cp[i] as int
                mut a := 0
                if i >= 4: a = cp[i - 4] as int end
                b := pp[i] as int
                mut c2 := 0
                if i >= 4: c2 = pp[i - 4] as int end
                mut fv := xv
                if ftype == 1: fv = xv - a end
                if ftype == 2: fv = xv - b end
                if ftype == 3: fv = xv - (a + b) / 2 end
                if ftype == 4: fv = xv - _paeth(a, b, c2) end
                score += _abs_signed_byte(fv)
                i += 1
            end
            if best_score < 0 or score < best_score:
                best_score = score
                best_type = ftype
            end
            ftype += 1
        end

        mut i := 0
        until i < stride:
            xv := cp[i] as int
            mut a := 0
            if i >= 4: a = cp[i - 4] as int end
            b := pp[i] as int
            mut c2 := 0
            if i >= 4: c2 = pp[i - 4] as int end
            mut fv := xv
            if best_type == 1: fv = xv - a end
            if best_type == 2: fv = xv - b end
            if best_type == 3: fv = xv - (a + b) / 2 end
            if best_type == 4: fv = xv - _paeth(a, b, c2) end
            candp[i] = (fv & 255) as u8
            i += 1
        end

        row_start := y * (1 + stride)
        rp[row_start] = (best_type & 255) as u8
        mem.Copy(((raw as i64) + ((row_start + 1) as i64)) as void*, cand, stride as u64)

        tmp := prev
        prev = cur
        cur = tmp
        pp = prev as u8*
        cp = cur as u8*
        y += 1
    end
    mem.Free(cur)
    mem.Free(prev)
    mem.Free(cand)

    zdata := _zlib_wrap(raw, raw_len as int)
    mem.Free(raw)
    _write_chunk(out, _CT_IDAT, zdata.data, zdata.len)
    compress.BufFree(zdata)

    _write_chunk(out, _CT_IEND, null, 0)
    ret out
end

@en "SavePNG"
@fa "ذخیره پی‌ان‌جی"
pub func SavePNG(img: Image, path: str): bool:
    buf := EncodePNG(img)
    ok := archive.WriteBinaryFileBuf(path, buf)
    compress.BufFree(buf)
    ret ok
end

@en "DecodePNG"
@fa "کدگشایی پی‌ان‌جی"
pub func DecodePNG(p: void*, n: int, ok &: bool): Image:
    ok = false
    if n < 8:
        ret New(0, 0)
    end
    bp := p as u8*
    if (bp[0] as int) != 137 or (bp[1] as int) != 80 or (bp[2] as int) != 78 or (bp[3] as int) != 71 or (bp[4] as int) != 13 or (bp[5] as int) != 10 or (bp[6] as int) != 26 or (bp[7] as int) != 10:
        ret New(0, 0)
    end

    mut width := 0
    mut height := 0
    mut bit_depth := 0
    mut color_type := -1
    mut have_ihdr := false
    mut png_interlace := 0
    mut idat := compress.NewByteBuf()
    mut palette := compress.NewByteBuf()
    mut trns := compress.NewByteBuf()

    mut pos := 8
    mut fatal := false
    until pos + 12 <= n and not fatal:
        chunk_len := _be_get32(p, pos)
        if chunk_len < 0 or pos + 12 + chunk_len > n:
            fatal = true
            break
        end
        chunk_type := _be_get32(p, pos + 4)
        data_off := pos + 8
        chunk_body := ((p as i64) + ((data_off - 4) as i64)) as void*
        expected_crc := _be_get32(p, data_off + chunk_len) as u32
        actual_crc := compress.CRC32(chunk_body, 4 + chunk_len)
        if actual_crc != expected_crc:
            fatal = true
            break
        end

        if chunk_type == _CT_IHDR:
            if chunk_len < 13:
                fatal = true
                break
            end
            width = _be_get32(p, data_off)
            height = _be_get32(p, data_off + 4)
            bit_depth = bp[data_off + 8] as int
            color_type = bp[data_off + 9] as int
            interlace := bp[data_off + 12] as int
            png_interlace = interlace
            if width <= 0 or height <= 0 or interlace > 1 or (width as i64) * (height as i64) > (268435456 as i64):
                fatal = true
                break
            end
            if _channels_for(color_type) == 0 or not _png_depth_ok(color_type, bit_depth):
                fatal = true
                break
            end
            have_ihdr = true
        end
        if chunk_type == _CT_PLTE:
            src := ((p as i64) + (data_off as i64)) as void*
            compress.BufPushBytes(palette, src, chunk_len)
        end
        if chunk_type == _CT_TRNS:
            src := ((p as i64) + (data_off as i64)) as void*
            compress.BufPushBytes(trns, src, chunk_len)
        end
        if chunk_type == _CT_IDAT:
            src := ((p as i64) + (data_off as i64)) as void*
            compress.BufPushBytes(idat, src, chunk_len)
        end
        if chunk_type == _CT_IEND:
            pos = n
            break
        end
        pos = data_off + chunk_len + 4
    end

    if not have_ihdr or fatal:
        compress.BufFree(idat)
        compress.BufFree(palette)
        compress.BufFree(trns)
        ret New(0, 0)
    end

    channels := _channels_for(color_type)
    mut expected_raw := 0
    repeat png_interlace == 1 ? 7 : 1 in pass:
        pw := _png_pass_size(width, png_interlace, pass, true)
        ph := _png_pass_size(height, png_interlace, pass, false)
        if pw > 0 and ph > 0:
            expected_raw += ph * (1 + (pw * channels * bit_depth + 7) / 8)
        end
    end

    mut inflate_ok := false
    inflated := _zlib_unwrap(idat.data, idat.len, expected_raw, inflate_ok)
    compress.BufFree(idat)
    if not inflate_ok or inflated.len < expected_raw:
        compress.BufFree(inflated)
        compress.BufFree(palette)
        compress.BufFree(trns)
        ret New(0, 0)
    end

    mut key := [0 - 1, 0 - 1, 0 - 1]
    if color_type == 0 and trns.len >= 2:
        key[0] = (compress.BufGet(trns, 0) << 8) | compress.BufGet(trns, 1)
    end
    if color_type == 2 and trns.len >= 6:
        repeat 3 in k:
            key[k] = (compress.BufGet(trns, k * 2) << 8) | compress.BufGet(trns, k * 2 + 1)
        end
    end
    maxv := (1 << bit_depth) - 1
    out := New(width, height)
    dst := out.pixels as u8*
    rp := inflated.data as u8*
    mut at := 0
    repeat png_interlace == 1 ? 7 : 1 in pass:
        pw := _png_pass_size(width, png_interlace, pass, true)
        ph := _png_pass_size(height, png_interlace, pass, false)
        if pw > 0 and ph > 0:
            stride := (pw * channels * bit_depth + 7) / 8
            fbpp := (channels * bit_depth + 7) / 8
            _png_unfilter(rp, at, stride, ph, fbpp)
            x0 := png_interlace == 1 ? _ADAM7[pass * 4] : 0
            y0 := png_interlace == 1 ? _ADAM7[pass * 4 + 1] : 0
            dx := png_interlace == 1 ? _ADAM7[pass * 4 + 2] : 1
            dy := png_interlace == 1 ? _ADAM7[pass * 4 + 3] : 1
            repeat ph in py:
                row := at + py * (1 + stride) + 1
                repeat pw in px:
                    mut vals := [0, 0, 0, 0]
                    repeat channels in ch:
                        vals[ch] = _png_sample(rp, row, px * channels + ch, bit_depth)
                    end
                    mut r := 0
                    mut g := 0
                    mut b := 0
                    mut a := 255
                    if color_type == 3:
                        idx := vals[0]
                        if idx * 3 + 2 < palette.len:
                            r = compress.BufGet(palette, idx * 3)
                            g = compress.BufGet(palette, idx * 3 + 1)
                            b = compress.BufGet(palette, idx * 3 + 2)
                        end
                        if idx < trns.len:
                            a = compress.BufGet(trns, idx)
                        end
                    else color_type == 0 or color_type == 4:
                        v := _png_scale(vals[0], bit_depth, maxv)
                        r = v
                        g = v
                        b = v
                        if color_type == 4:
                            a = _png_scale(vals[1], bit_depth, maxv)
                        else vals[0] == key[0]:
                            a = 0
                        end
                    else:
                        r = _png_scale(vals[0], bit_depth, maxv)
                        g = _png_scale(vals[1], bit_depth, maxv)
                        b = _png_scale(vals[2], bit_depth, maxv)
                        if color_type == 6:
                            a = _png_scale(vals[3], bit_depth, maxv)
                        else vals[0] == key[0] and vals[1] == key[1] and vals[2] == key[2]:
                            a = 0
                        end
                    end
                    o := ((y0 + py * dy) * width + x0 + px * dx) * 4
                    dst[o] = r as u8
                    dst[o + 1] = g as u8
                    dst[o + 2] = b as u8
                    dst[o + 3] = a as u8
                end
            end
            at += ph * (1 + stride)
        end
    end
    compress.BufFree(inflated)
    compress.BufFree(palette)
    compress.BufFree(trns)
    ok = true
    ret out
end

@en "OpenPNG"
@fa "بازکردن پی‌ان‌جی"
pub func OpenPNG(path: str, ok &: bool): Image:
    mut read_ok := false
    buf := archive.ReadBinaryFile(path, read_ok)
    if not read_ok:
        ok = false
        ret New(0, 0)
    end
    out := DecodePNG(buf.data, buf.len, ok)
    compress.BufFree(buf)
    ret out
end
