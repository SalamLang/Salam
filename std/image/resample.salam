package image

// Area-average resampling, computed exactly like libgd's gdImageCopyResampled
// (PHP's imagecopyresampled): every destination pixel is the coverage-weighted
// mean of the source pixels under it, in 32-bit floats, alpha-weighted, with
// the same rounding. The source can be fed one row at a time, so a picture
// far bigger than memory can be shrunk while it is being made.

import mem
import math

@en "AreaResampler"
@fa "نمونه‌بردار ناحیه‌ای"
pub struct AreaResampler:
    @en "src_w"
    @fa "عرض مبدأ"
    pub src_w: int = 0
    @en "src_h"
    @fa "ارتفاع مبدأ"
    pub src_h: int = 0
    @en "dst_w"
    @fa "عرض خروجی"
    pub dst_w: int = 0
    @en "dst_h"
    @fa "ارتفاع خروجی"
    pub dst_h: int = 0
    @en "out"
    @fa "تصویر خروجی"
    pub out: Image = Image {}
    @en "ok"
    @fa "آماده"
    pub ok: bool = false
    @en "next_row"
    @fa "سطر بعدی"
    pub next_row: int = 0
    @en "x_start"
    @fa "آغاز بازه ستون"
    pub x_start: void* = null
    @en "x_count"
    @fa "شمار ستون بازه"
    pub x_count: void* = null
    @en "x_src"
    @fa "ستون مبدأ بازه"
    pub x_src: void* = null
    @en "x_part"
    @fa "سهم ستون بازه"
    pub x_part: void* = null
    @en "y_first"
    @fa "نخستین سطر مبدأ"
    pub y_first: void* = null
    @en "y_last"
    @fa "آخرین سطر مبدأ"
    pub y_last: void* = null
    @en "ring"
    @fa "حلقه"
    pub ring: int = 0
    @en "acc"
    @fa "جمع‌های جاری"
    pub acc: void* = null
end

func _rs_floor(v: f32): f32:
    ret math.Floor(v as f64) as f32
end

// The source spans of one destination coordinate (gdImageCopyResampled's
// inner do/while), as (index, portion) pairs; returns how many.
func _rs_spans(d: int, src_n: int, dst_n: int, idx: i32*, part: f32*, at: int): int:
    s1 := ((d as f32) * (src_n as f32)) / (dst_n as f32)
    s2 := (((d + 1) as f32) * (src_n as f32)) / (dst_n as f32)
    mut s := s1
    mut n := 0
    until true:
        mut portion := 1.0 as f32
        if _rs_floor(s) == _rs_floor(s1):
            portion = (1.0 - ((s - _rs_floor(s)) as f64)) as f32
            if portion > s2 - s1:
                portion = s2 - s1
            end
            s = _rs_floor(s)
        else s == _rs_floor(s2):
            portion = s2 - _rs_floor(s2)
        end
        if idx != null:
            idx[at + n] = s as int
            part[at + n] = portion
        end
        n += 1
        s = s + (1.0 as f32)
        if not (s < s2):
            break
        end
    end
    ret n
end

func _rs_finish_row(r &: AreaResampler, y: int):
    slot := y % r.ring
    a := ((r.acc as i64) + (slot as i64) * (r.dst_w as i64) * 28) as f32*
    op := r.out.pixels as u8*
    repeat r.dst_w in x:
        k := x * 7
        mut red := a[k]
        mut green := a[k + 1]
        mut blue := a[k + 2]
        mut alpha := a[k + 3]
        spixels := a[k + 4]
        mut alpha_sum := a[k + 5]
        contrib_sum := a[k + 6]
        if spixels != (0.0 as f32):
            red = red / spixels
            green = green / spixels
            blue = blue / spixels
            alpha = alpha / spixels
        end
        if alpha_sum != (0.0 as f32):
            if contrib_sum != (0.0 as f32):
                alpha_sum = alpha_sum / contrib_sum
            end
            red = red / alpha_sum
            green = green / alpha_sum
            blue = blue / alpha_sum
        end
        red = (red as f64) >= 255.5 ? (255.0 as f32) : (((red as f64) + 0.5) as f32)
        green = (green as f64) >= 255.5 ? (255.0 as f32) : (((green as f64) + 0.5) as f32)
        blue = (blue as f64) >= 255.5 ? (255.0 as f32) : (((blue as f64) + 0.5) as f32)
        alpha = (alpha as f64) >= 127.5 ? (127.0 as f32) : (((alpha as f64) + 0.5) as f32)
        o := ((y as i64) * (r.dst_w as i64) + (x as i64)) * 4
        op[o] = (red as int) as u8
        op[o + 1] = (green as int) as u8
        op[o + 2] = (blue as int) as u8
        a7 := alpha as int
        op[o + 3] = (a7 == 0 ? 255 : ((127 - a7) * 255 + 63) / 127) as u8
        repeat 7 in j:
            a[k + j] = 0.0 as f32
        end
    end
end

@en "NewAreaResampler"
@fa "نمونه‌بردار ناحیه‌ای جدید"
pub func NewAreaResampler(src_w: int, src_h: int, dst_w: int, dst_h: int): AreaResampler:
    mut r := AreaResampler { src_w = src_w, src_h = src_h, dst_w = dst_w, dst_h = dst_h }
    if src_w <= 0 or src_h <= 0 or dst_w <= 0 or dst_h <= 0:
        ret r
    end
    r.out = New(dst_w, dst_h)
    if IsEmpty(r.out):
        ret r
    end
    // columns
    mut total := 0
    repeat dst_w in x:
        total += _rs_spans(x, src_w, dst_w, null, null, 0)
    end
    r.x_start = mem.Allocate((dst_w * 4) as u64)
    r.x_count = mem.Allocate((dst_w * 4) as u64)
    r.x_src = mem.Allocate((total * 4 + 4) as u64)
    r.x_part = mem.Allocate((total * 4 + 4) as u64)
    xs := r.x_start as i32*
    xc := r.x_count as i32*
    mut at := 0
    repeat dst_w in x:
        n := _rs_spans(x, src_w, dst_w, r.x_src as i32*, r.x_part as f32*, at)
        xs[x] = at
        xc[x] = n
        at += n
    end
    // rows: first and last source row of each destination row
    r.y_first = mem.Allocate(((dst_h as i64) * 4) as u64)
    r.y_last = mem.Allocate(((dst_h as i64) * 4) as u64)
    yf := r.y_first as i32*
    yl := r.y_last as i32*
    idx := mem.Allocate(((src_h + 4) * 4) as u64)
    part := mem.Allocate(((src_h + 4) * 4) as u64)
    repeat dst_h in y:
        n := _rs_spans(y, src_h, dst_h, idx as i32*, part as f32*, 0)
        ip := idx as i32*
        yf[y] = ip[0]
        yl[y] = ip[n - 1]
    end
    mem.Free(idx)
    mem.Free(part)
    // the most destination rows one source row can touch at once
    mut most := 1
    mut lo := 0
    repeat dst_h in y:
        until lo < y and yl[lo] < yf[y]:
            lo += 1
        end
        if y - lo + 1 > most:
            most = y - lo + 1
        end
    end
    r.ring = most + 1
    r.acc = mem.AllocateZeroed(((r.ring as i64) * (dst_w as i64) * 28) as u64)
    r.ok = true
    ret r
end

// Feeds the next source row: src_w pixels, r g b a at p[0..3], step bytes apart
// (4 for RGBA, 3 for RGB which counts as opaque).
@en "AreaResamplerPushRow"
@fa "افزودن سطر به نمونه‌بردار"
pub func AreaResamplerPushRow(r &: AreaResampler, p: u8*, step: int):
    if not r.ok or r.next_row >= r.src_h:
        ret
    end
    s := r.next_row
    yf := r.y_first as i32*
    yl := r.y_last as i32*
    xs := r.x_start as i32*
    xc := r.x_count as i32*
    xsrc := r.x_src as i32*
    xpart := r.x_part as f32*
    // the destination rows this source row is part of
    mut y := 0
    // binary search for the first destination row whose last source row >= s
    mut lo := 0
    mut hi := r.dst_h
    until lo < hi:
        mid := (lo + hi) / 2
        if yl[mid] < s:
            lo = mid + 1
        else:
            hi = mid
        end
    end
    y = lo
    until y < r.dst_h and yf[y] <= s:
        // this row's portion: replay the y spans of y to find s
        s1 := ((y as f32) * (r.src_h as f32)) / (r.dst_h as f32)
        s2 := (((y + 1) as f32) * (r.src_h as f32)) / (r.dst_h as f32)
        mut sy := s1
        mut yportion := 0.0 as f32
        mut found := false
        until true:
            mut portion := 1.0 as f32
            if _rs_floor(sy) == _rs_floor(s1):
                portion = (1.0 - ((sy - _rs_floor(sy)) as f64)) as f32
                if portion > s2 - s1:
                    portion = s2 - s1
                end
                sy = _rs_floor(sy)
            else sy == _rs_floor(s2):
                portion = s2 - _rs_floor(s2)
            end
            if (sy as int) == s:
                yportion = portion
                found = true
                break
            end
            sy = sy + (1.0 as f32)
            if not (sy < s2):
                break
            end
        end
        if found:
            slot := y % r.ring
            a := ((r.acc as i64) + (slot as i64) * (r.dst_w as i64) * 28) as f32*
            repeat r.dst_w in x:
                k := x * 7
                mut red := a[k]
                mut green := a[k + 1]
                mut blue := a[k + 2]
                mut alpha := a[k + 3]
                mut spixels := a[k + 4]
                mut alpha_sum := a[k + 5]
                mut contrib_sum := a[k + 6]
                start := xs[x]
                count := xc[x]
                repeat count in j:
                    sx := xsrc[start + j]
                    xportion := xpart[start + j]
                    pcontribution := xportion * yportion
                    o := (sx * step) as i64
                    mut a7 := 0
                    if step >= 4:
                        a7 = 127 - ((p[o + 3] as int) >> 1)
                    end
                    alpha_factor := ((127 - a7) as f32) * pcontribution
                    red = red + ((p[o] as int) as f32) * alpha_factor
                    green = green + ((p[o + 1] as int) as f32) * alpha_factor
                    blue = blue + ((p[o + 2] as int) as f32) * alpha_factor
                    alpha = alpha + (a7 as f32) * pcontribution
                    alpha_sum = alpha_sum + alpha_factor
                    contrib_sum = contrib_sum + pcontribution
                    spixels = spixels + xportion * yportion
                end
                a[k] = red
                a[k + 1] = green
                a[k + 2] = blue
                a[k + 3] = alpha
                a[k + 4] = spixels
                a[k + 5] = alpha_sum
                a[k + 6] = contrib_sum
            end
        end
        if yl[y] == s:
            _rs_finish_row(r, y)
        end
        y += 1
    end
    r.next_row += 1
end

// Frees the work tables; r.out stays (free it with Free).
@en "AreaResamplerFree"
@fa "آزادسازی نمونه‌بردار"
pub func AreaResamplerFree(r &: AreaResampler):
    if r.x_start != null: mem.Free(r.x_start) end
    if r.x_count != null: mem.Free(r.x_count) end
    if r.x_src != null: mem.Free(r.x_src) end
    if r.x_part != null: mem.Free(r.x_part) end
    if r.y_first != null: mem.Free(r.y_first) end
    if r.y_last != null: mem.Free(r.y_last) end
    if r.acc != null: mem.Free(r.acc) end
    r.x_start = null
    r.x_count = null
    r.x_src = null
    r.x_part = null
    r.y_first = null
    r.y_last = null
    r.acc = null
    r.ok = false
end

// imagecopyresampled of the whole picture to new_width x new_height.
@en "ResizeArea"
@fa "تغییر اندازه ناحیه‌ای"
pub func ResizeArea(img: Image, new_width: int, new_height: int): Image:
    mut r := NewAreaResampler(img.width, img.height, new_width, new_height)
    if not r.ok or IsEmpty(img):
        AreaResamplerFree(r)
        ret r.out
    end
    bp := img.pixels as u8*
    repeat img.height in y:
        AreaResamplerPushRow(r, ((bp as i64) + (y as i64) * (img.width as i64) * 4) as u8*, 4)
    end
    AreaResamplerFree(r)
    ret r.out
end
