package image

import str

// UTF-8 <-> codepoints, for the text pipeline.
//
// Everything above this file works on codepoints, not bytes: a shaper
// has to look at the letter before and after, and a bidi reorder moves
// whole characters around, neither of which a byte string supports.
// A `str` is NUL-terminated UTF-8, so these four functions are the only
// place the byte encoding is dealt with.
//
// Decoding never fails: a truncated sequence or a stray continuation
// byte becomes U+FFFD and advances one byte, so a malformed string
// still terminates and still draws something.

func _utf8_next(bp: u8*, n: int, i: int, cp &: int): int:
    b0 := bp[i] as int
    if b0 < 0x80:
        cp = b0
        ret i + 1
    end
    if (b0 & 0xE0) == 0xC0 && i + 1 < n:
        cp = ((b0 & 0x1F) << 6) | ((bp[i + 1] as int) & 0x3F)
        ret i + 2
    end
    if (b0 & 0xF0) == 0xE0 && i + 2 < n:
        cp = ((b0 & 0x0F) << 12) | (((bp[i + 1] as int) & 0x3F) << 6) | ((bp[i + 2] as int) & 0x3F)
        ret i + 3
    end
    if (b0 & 0xF8) == 0xF0 && i + 3 < n:
        cp = ((b0 & 0x07) << 18) | (((bp[i + 1] as int) & 0x3F) << 12) | (((bp[i + 2] as int) & 0x3F) << 6) | ((bp[i + 3] as int) & 0x3F)
        ret i + 4
    end
    cp = 0xFFFD
    ret i + 1
end

func _utf8_decode_all(text: str, out &: Vector<int>):
    n := str.Len(text)
    bp := text as u8*
    mut i := 0
    until i < n:
        mut cp := 0
        i = _utf8_next(bp, n, i, cp)
        out.push(cp)
    end
end

func _utf8_append(b &: str.StringBuilder, cp: int):
    if cp < 0x80:
        str.BufAppendChar(b, cp)
        ret
    end
    if cp < 0x800:
        str.BufAppendChar(b, 0xC0 | (cp >> 6))
        str.BufAppendChar(b, 0x80 | (cp & 0x3F))
        ret
    end
    if cp < 0x10000:
        str.BufAppendChar(b, 0xE0 | (cp >> 12))
        str.BufAppendChar(b, 0x80 | ((cp >> 6) & 0x3F))
        str.BufAppendChar(b, 0x80 | (cp & 0x3F))
        ret
    end
    str.BufAppendChar(b, 0xF0 | (cp >> 18))
    str.BufAppendChar(b, 0x80 | ((cp >> 12) & 0x3F))
    str.BufAppendChar(b, 0x80 | ((cp >> 6) & 0x3F))
    str.BufAppendChar(b, 0x80 | (cp & 0x3F))
end

func _utf8_encode_all(cps &: Vector<int>): str:
    mut b := str.NewBuilder()
    mut i := 0
    until i < cps.len():
        _utf8_append(b, cps.get(i))
        i += 1
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end
