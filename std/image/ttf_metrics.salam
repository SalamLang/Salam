package image

@en "ScaleFactor"
@fa "ضریب مقیاس"
@ar "معامل القياس"
pub func ScaleFactor(f: Font, size: f64): f64:
    if f.units_per_em <= 0:
        ret 0.0
    end
    ret size / (f.units_per_em as f64)
end

@en "AscentPixels"
@fa "صعود پیکسلی"
@ar "الصعود بالبكسل"
pub func AscentPixels(f: Font, size: f64): f64:
    ret (f.ascent as f64) * ScaleFactor(f, size)
end

@en "DescentPixels"
@fa "نزول پیکسلی"
@ar "النزول بالبكسل"
pub func DescentPixels(f: Font, size: f64): f64:
    ret (f.descent as f64) * ScaleFactor(f, size)
end

@en "LineHeightPixels"
@fa "ارتفاع خط پیکسلی"
@ar "ارتفاع السطر بالبكسل"
pub func LineHeightPixels(f: Font, size: f64): f64:
    ret ((f.ascent - f.descent + f.line_gap) as f64) * ScaleFactor(f, size)
end

@en "GlyphAdvance"
@fa "پیشروی نویسه"
@ar "تقدم الرسم"
pub func GlyphAdvance(f: Font, glyph: int): int:
    if f.hmtx == 0 || f.num_hmetrics <= 0 || glyph < 0:
        ret 0
    end
    mut i := glyph
    if i >= f.num_hmetrics:
        i = f.num_hmetrics - 1
    end
    ret _ttf_u16(f.data, f.size, f.hmtx + i * 4)
end

@en "KernAdvance"
@fa "کرنینگ"
@ar "التقنين"
pub func KernAdvance(f: Font, glyph1: int, glyph2: int): int:
    if f.kern == 0 || glyph1 <= 0 || glyph2 <= 0:
        ret 0
    end
    if _ttf_u16(f.data, f.size, f.kern + 2) < 1:
        ret 0
    end
    coverage := _ttf_u16(f.data, f.size, f.kern + 8)
    if (coverage & 0xFF00) != 0 || (coverage & 1) == 0:
        ret 0
    end
    npairs := _ttf_u16(f.data, f.size, f.kern + 10)
    key := (glyph1 << 16) | glyph2
    base := f.kern + 18
    mut lo := 0
    mut hi := npairs
    until lo < hi:
        mid := (lo + hi) / 2
        rec := base + mid * 6
        k := (_ttf_u16(f.data, f.size, rec) << 16) | _ttf_u16(f.data, f.size, rec + 2)
        if key < k:
            hi = mid
        else:
            if key > k:
                lo = mid + 1
            else:
                ret _ttf_i16(f.data, f.size, rec + 4)
            end
        end
    end
    ret 0
end
