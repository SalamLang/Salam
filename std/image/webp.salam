package image

import compress
import archive

@en "IsWebP"
@fa "آیا وب‌پی است"
pub func IsWebP(p: void*, n: int): bool:
    if n < 12:
        ret false
    end
    bp := p as u8*
    ret (bp[0] as int) == 82 and (bp[1] as int) == 73 and (bp[2] as int) == 70 and (bp[3] as int) == 70 and (bp[8] as int) == 87 and (bp[9] as int) == 69 and (bp[10] as int) == 66 and (bp[11] as int) == 80
end

@en "EncodeWebP"
@fa "کدگذاری وب‌پی"
pub func EncodeWebP(_img: Image): compress.ByteBuf:
    ret compress.NewByteBuf()
end

@en "SaveWebP"
@fa "ذخیره وب‌پی"
pub func SaveWebP(_img: Image, _path: str): bool:
    ret false
end

@en "DecodeWebP"
@fa "کدگشایی وب‌پی"
pub func DecodeWebP(p: void*, n: int, ok &: bool): Image:
    ok = false
    _is_webp := IsWebP(p, n)
    ret New(0, 0)
end

@en "OpenWebP"
@fa "بازکردن وب‌پی"
pub func OpenWebP(path: str, ok &: bool): Image:
    mut read_ok := false
    buf := archive.ReadBinaryFile(path, read_ok)
    ok = false
    if read_ok:
        compress.BufFree(buf)
    end
    ret New(0, 0)
end
