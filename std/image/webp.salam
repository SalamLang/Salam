package image

import compress
import archive

@en "IsWebP"
@fa "وب‌پی است"
pub func IsWebP(p: void*, n: int): bool:
    if n < 12:
        ret false
    end
    bp := p as u8*
    ret (bp[0] as int) == 82 and (bp[1] as int) == 73 and (bp[2] as int) == 70 and (bp[3] as int) == 70 and (bp[8] as int) == 87 and (bp[9] as int) == 69 and (bp[10] as int) == 66 and (bp[11] as int) == 80
end

@en "SaveWebP"
@fa "ذخیره وب‌پی"
pub func SaveWebP(img: Image, path: str): bool:
    mut buf := EncodeWebP(img)
    if compress.BufLen(buf) == 0:
        compress.BufFree(buf)
        ret false
    end
    ok := archive.WriteBinaryFileBuf(path, buf)
    compress.BufFree(buf)
    ret ok
end

@en "OpenWebP"
@fa "بازکردن وب‌پی"
pub func OpenWebP(path: str, ok &: bool): Image:
    mut read_ok := false
    mut buf := archive.ReadBinaryFile(path, read_ok)
    ok = false
    if not read_ok:
        ret New(0, 0)
    end
    img := DecodeWebP(buf.data, compress.BufLen(buf), ok)
    compress.BufFree(buf)
    ret img
end
