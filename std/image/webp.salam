package image

import compress
import archive

// WebP: detection only for now - EncodeWebP/DecodeWebP are a deliberate,
// documented extension point rather than a real codec.
//
// Both WebP's lossy path (a still-frame VP8 intra-only bitstream: 4x4/
// 16x16 intra prediction modes, an arithmetic coder, a full DCT/WHT
// transform set and an in-loop deblocking filter) and its lossless path
// (VP8L: a from-scratch entropy format with its own two-level canonical
// Huffman code-length encoding, 4 predictor/color/subtract-green
// transforms and an LZ77-style backward-reference scheme, all bit-packed
// LSB-first) are each roughly as large as this package's entire JPEG
// codec (jpeg.salam) on their own, and - unlike JPEG's Annex K tables or
// PNG's zlib framing - neither has a small, independently-verifiable
// "standard tables" core to build the rest around; getting the bitstream
// framing bit-exact is most of the work either way. Shipping a
// hand-rolled attempt without the ability to cross-check every field
// against a second implementation risks silently-wrong output, which is
// worse than not supporting the format - the same reasoning std/archive
// documents for why RAR has no writer (see that package's header
// comment). SaveWebP/DecodeWebP are kept here, with the right
// signatures and wired into io.salam's Save/Open/Convert dispatch, so a
// real implementation is a self-contained drop-in later; today they
// report `ok = false` / write nothing rather than emit or accept a
// malformed file.
//
// IsWebP still works standalone (RIFF/WEBP magic-byte sniffing needs no
// codec), so format detection and clear error reporting both work today.

@en "IsWebP"
@fa "آیا وب‌پی است"
@ar "هل هو ويب بي"
pub func IsWebP(p: void*, n: int): bool:
    if n < 12:
        ret false
    end
    bp := p as u8*
    ret (bp[0] as int) == 82 && (bp[1] as int) == 73 && (bp[2] as int) == 70 && (bp[3] as int) == 70 && (bp[8] as int) == 87 && (bp[9] as int) == 69 && (bp[10] as int) == 66 && (bp[11] as int) == 80
end

@en "EncodeWebP"
@fa "کدگذاری وب‌پی"
@ar "ترميز ويب بي"
pub func EncodeWebP(_img: Image): compress.ByteBuf:
    ret compress.NewByteBuf()
end

@en "SaveWebP"
@fa "ذخیره وب‌پی"
@ar "حفظ ويب بي"
pub func SaveWebP(_img: Image, _path: str): bool:
    ret false
end

@en "DecodeWebP"
@fa "کدگشایی وب‌پی"
@ar "فك ترميز ويب بي"
pub func DecodeWebP(p: void*, n: int, ok &: bool): Image:
    ok = false
    _is_webp := IsWebP(p, n)
    ret New(0, 0)
end

@en "OpenWebP"
@fa "بازکردن وب‌پی"
@ar "افتح ويب بي"
pub func OpenWebP(path: str, ok &: bool): Image:
    mut read_ok := false
    buf := archive.ReadBinaryFile(path, read_ok)
    ok = false
    if read_ok:
        compress.BufFree(buf)
    end
    ret New(0, 0)
end
