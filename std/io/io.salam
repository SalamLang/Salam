@en "io"
@fa "ورودی خروجی"
@ar "إدخال إخراج"
package io

import str
import mem

extern:
    func salam_open(path: str, mode: str): File*
    // C89's "flush every open output stream". <stdio.h> already declares it
    // in every generated module, so this declaration emits no C of its own.
    func fflush(stream: void*): int
    func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
    func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
end

// How much Copy moves per fread/fwrite pair.
const COPY_CHUNK := 65536

@en "Input"
@fa "بخوان"
@ar "إدخال"
pub func Input(): str: ret input () end

@en "Read"
@fa "خواندن"
@ar "قراءة"
pub func Read(f: File*, size: u64): str: ret f.read(size) end

@en "Readline"
@fa "خواندن خط"
@ar "قراءة سطر"
pub func Readline(f: File*): str: ret f.readline() end

@en "Write"
@fa "نوشتن"
@ar "کتابة"
pub func Write(f: File*, data: str): int: ret f.write(data) end

@en "Seek"
@fa "جابجایی مکان نما"
@ar "نقل المؤشر"
pub func Seek(f: File*, offset: i64, whence: int): int: ret f.seek(offset, whence) end

@en "Close"
@fa "بستن"
@ar "إغلاق"
pub func Close(f: File*): f.close() end

@en "ReadFile"
@fa "خواندن پرونده"
@ar "قراءة ملف"
pub func ReadFile(path: str): str:
    f := salam_open(path, "rb")
    if f == null:
        ret ""
    end
    out := ReadAll(f)
    f.close()
    ret out
end

@en "WriteFile"
@fa "نوشتن پرونده"
@ar "کتابة ملف"
pub func WriteFile(path: str, data: str): int:
    // "wb", not "w": source files are always read in binary mode
    // (source.c opens with "rb", never translating line endings), so a
    // text-mode write here is the one side of the read/write pair that
    // would apply Windows CRT's implicit \n -> \r\n translation. That
    // silent, one-sided translation is exactly what made `salam format
    // --tabs` non-idempotent: pass 1 (LF input) writes text-mode and comes
    // out CRLF; pass 2 reads those real \r\n bytes back verbatim (binary
    // read), and anything carried through unchanged (e.g. a block
    // comment's raw slice) still contains its original \r before hitting
    // the SAME text-mode \n -> \r\n translation on the way back out,
    // compounding into \r\r\n. Binary mode makes this function byte-exact
    // on every platform instead of relying on an implicit OS translation.
    f := salam_open(path, "wb")
    if f == null:
        ret 0 - 1
    end
    n := f.write(data)
    f.close()
    ret n
end

@en "AppendFile"
@fa "افزودن به پرونده"
@ar "إلحاق ملف"
pub func AppendFile(path: str, data: str): int:
    f := salam_open(path, "ab") // see WriteFile's comment on "wb" vs "w"
    if f == null:
        ret 0 - 1
    end
    n := f.write(data)
    f.close()
    ret n
end

@en "Lines"
@fa "خط ها"
@ar "سطور"
pub func Lines(path: str): Vector<str>:
    text := ReadFile(path)
    ret text.trim().split("\n")
end

@en "EPrint"
@fa "نوشتن خطا"
@ar "طباعة خطأ"
pub func EPrint(s: str): printerr s end

@en "EPrintln"
@fa "نوشتن خطا با خط جدید"
@ar "طباعة خطأ بسطر جدید"
pub func EPrintln(s: str): printerrln s end

// Push every buffered output stream out to the operating system.
//
// A `println` already gets its own line out, redirected or not, so a program
// that only prints does not need this. It is here for what the compiler
// cannot see: output written by C code the program links against, which keeps
// its own `FILE*` buffer and is fully buffered whenever it is not writing to
// a terminal. Calling it is never wrong - flushing with nothing pending costs
// a branch - and it is the right thing to do before a daemon blocks on
// accept(), or before handing the terminal to a subprocess.
@en "Flush"
@fa "تخلیه"
@ar "تفریغ"
pub func Flush():
    _r := fflush(null as void*)
end

@en "ReadAll"
@fa "خواندن همه"
@ar "قراءة الکل"
pub func ReadAll(f: File*): str:
    // Guarded here so the mem.Free calls below can be unconditional:
    // f.read on a null handle is the one case that answers with the empty
    // string LITERAL rather than a heap block, and freeing static storage
    // is not something to leave to chance.
    if f == null:
        ret ""
    end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut chunk := f.read(4096)
    // Each f.read is a fresh mem.AllocateZeroed(size + 1) (see
    // salam_file_read in std/fs/fs.salam), and its contents are copied into
    // the builder - so the block is dead the moment BufAppend returns.
    // Without these frees, reading a file cost 4 KB of leaked buffer per
    // 4 KB read: the compiler alone dropped ~2 MB just indexing std/.
    until chunk.len() > 0:
        str.BufAppend(sb, chunk)
        mem.Free(chunk as void*)
        chunk = f.read(4096)
    end
    // The loop always exits holding one more allocation: EOF is signalled by
    // a zero-length read, not by a null return, and that read allocated too.
    mem.Free(chunk as void*)
    out := str.BufStr(sb)
    ret out
end

@en "Copy"
@fa "کپی"
@ar "نسخ"
// Copies the rest of `src` into `dst`, returning the number of bytes moved.
//
// fread/fwrite, not File.read/File.write. Those two carry a str, and
// salam_file_read NUL-terminates what it read, so the first zero byte in a
// chunk ended it and the rest of that chunk was dropped - silently, and with a
// byte count that agreed with the truncation. On text there is nothing to see;
// on a binary stream it is data loss reported as success, and it is how copying
// a WebP produced a five-byte file. Reading straight through the FILE* keeps
// the bytes bytes.
pub func Copy(dst: File*, src: File*): i64:
    if src == null || dst == null:
        ret 0
    end
    buf := mem.Allocate(COPY_CHUNK as u64)
    if buf == null:
        ret 0
    end
    sp := src as void*
    dp := dst as void*
    mut total := 0 as i64
    mut going := true
    while going:
        got := fread(buf, 1 as u64, COPY_CHUNK as u64, sp)
        if got == 0 as u64:
            going = false
        else:
            put := fwrite(buf, 1 as u64, got, dp)
            total += put as i64
            // A short write is the disk saying no; carrying on would only lose
            // more of the file and still call the result a copy.
            if put != got: going = false end
        end
    end
    mem.Free(buf)
    ret total
end

@en "WriteLines"
@fa "نوشتن خط ها"
@ar "کتابة سطور"
pub func WriteLines(path: str, lines: Vector<str>): int:
    f := salam_open(path, "wb") // see WriteFile's comment on "wb" vs "w"
    if f == null:
        ret 0 - 1
    end
    mut total := 0
    repeat lines.len() with i:
        total += f.write(lines.get(i))
        total += f.write("\n")
    end
    f.close()
    ret total
end
