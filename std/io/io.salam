@en "io"
@fa "ورودی خروجی"
@ar "إدخال إخراج"
package io

import str
import mem

extern:
    func salam_open(path: str, mode: str): File*
    // The File* methods below (f.read, f.write, f.close, ...) lower to these
    // runtime functions, which std/fs defines. Declared here because a call
    // needs a prototype in its own translation unit: this module does not
    // import std/fs, so without these the generated C calls them implicitly,
    // which a pre-C99 compiler accepted silently and a current one rejects.
    // It only ever showed up on a freestanding target, where no other header
    // happens to drag the declarations in.
    func salam_file_read(f: File*, size: u64): str
    func salam_file_readline(f: File*): str
    func salam_file_write(f: File*, data: str): int
    func salam_file_close(f: File*)
    func salam_file_seek(f: File*, off: i64, whence: int): int
    // C89's "flush every open output stream". <stdio.h> already declares it
    // in every generated module, so this declaration emits no C of its own.
    func fflush(stream: void*): int
    func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
    func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
end

// How much Copy moves per fread/fwrite pair.
const COPY_CHUNK := 65536

@en "Input"
@fa "بخوان"
@ar "إدخال"
pub func Input(): str: ret input () end

@en "Read"
@fa "خواندن"
@ar "قراءة"
pub func Read(f: File*, size: u64): str: ret f.read(size) end

@en "Readline"
@fa "خواندن خط"
@ar "قراءة سطر"
pub func Readline(f: File*): str: ret f.readline() end

@en "Write"
@fa "نوشتن"
@ar "کتابة"
pub func Write(f: File*, data: str): int: ret f.write(data) end

@en "Seek"
@fa "جابجایی مکان نما"
@ar "نقل المؤشر"
pub func Seek(f: File*, offset: i64, whence: int): int: ret f.seek(offset, whence) end

@en "Close"
@fa "بستن"
@ar "إغلاق"
pub func Close(f: File*): f.close() end

@en "ReadFile"
@fa "خواندن پرونده"
@ar "قراءة ملف"
pub func ReadFile(path: str): str:
    f := salam_open(path, "rb")
    if f == null:
        ret ""
    end
    out := ReadAll(f)
    f.close()
    ret out
end

@en "WriteFile"
@fa "نوشتن پرونده"
@ar "کتابة ملف"
pub func WriteFile(path: str, data: str): int:
    f := salam_open(path, "wb")
    if f == null:
        ret 0 - 1
    end
    n := f.write(data)
    f.close()
    ret n
end

@en "AppendFile"
@fa "افزودن به پرونده"
@ar "إلحاق ملف"
pub func AppendFile(path: str, data: str): int:
    f := salam_open(path, "ab")
    if f == null:
        ret 0 - 1
    end
    n := f.write(data)
    f.close()
    ret n
end

@en "Lines"
@fa "خط ها"
@ar "سطور"
pub func Lines(path: str): Vector<str>:
    text := ReadFile(path)
    ret text.trim().split("\n")
end

@en "EPrint"
@fa "نوشتن خطا"
@ar "طباعة خطأ"
pub func EPrint(s: str): printerr s end

@en "EPrintln"
@fa "نوشتن خطا با خط جدید"
@ar "طباعة خطأ بسطر جدید"
pub func EPrintln(s: str): printerrln s end

// Push every buffered output stream out to the operating system.
//
// A `println` already gets its own line out, redirected or not, so a program
// that only prints does not need this. It is here for what the compiler
// cannot see: output written by C code the program links against, which keeps
// its own `FILE*` buffer and is fully buffered whenever it is not writing to
// a terminal. Calling it is never wrong - flushing with nothing pending costs
// a branch - and it is the right thing to do before a daemon blocks on
// accept(), or before handing the terminal to a subprocess.
@en "Flush"
@fa "تخلیه"
@ar "تفریغ"
pub func Flush():
    _r := fflush(null as void*)
end

@en "ReadAll"
@fa "خواندن همه"
@ar "قراءة الکل"
pub func ReadAll(f: File*): str:
    if f == null:
        ret ""
    end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut chunk := f.read(4096)
    until chunk.len() > 0:
        str.BufAppend(sb, chunk)
        mem.Free(chunk as void*)
        chunk = f.read(4096)
    end
    mem.Free(chunk as void*)
    out := str.BufStr(sb)
    ret out
end

@en "Copy"
@fa "کپی"
@ar "نسخ"
// Copies the rest of `src` into `dst`, returning the number of bytes moved.
//
// fread/fwrite, not File.read/File.write. Those two carry a str, and
// salam_file_read NUL-terminates what it read, so the first zero byte in a
// chunk ended it and the rest of that chunk was dropped - silently, and with a
// byte count that agreed with the truncation. On text there is nothing to see;
// on a binary stream it is data loss reported as success, and it is how copying
// a WebP produced a five-byte file. Reading straight through the FILE* keeps
// the bytes bytes.
pub func Copy(dst: File*, src: File*): i64:
    if src == null || dst == null:
        ret 0
    end
    buf := mem.Allocate(COPY_CHUNK as u64)
    if buf == null:
        ret 0
    end
    sp := src as void*
    dp := dst as void*
    mut total := 0 as i64
    mut going := true
    while going:
        got := fread(buf, 1 as u64, COPY_CHUNK as u64, sp)
        if got == 0 as u64:
            going = false
        else:
            put := fwrite(buf, 1 as u64, got, dp)
            total += put as i64
            if put != got: going = false end
        end
    end
    mem.Free(buf)
    ret total
end

@en "WriteLines"
@fa "نوشتن خط ها"
@ar "کتابة سطور"
pub func WriteLines(path: str, lines: Vector<str>): int:
    f := salam_open(path, "wb")
    if f == null:
        ret 0 - 1
    end
    mut total := 0
    repeat lines.len() with i:
        total += f.write(lines.get(i))
        total += f.write("\n")
    end
    f.close()
    ret total
end
