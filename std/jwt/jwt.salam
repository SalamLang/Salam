@en "jwt"
@fa "جی دبلیو تی"
@ar "جیه دبلیو تي"
package jwt

import str
import mem
import conv
import time
import crypto
import encoding

pub const JWT_HS256 := "HS256"
pub const JWT_HS384 := "HS384"
pub const JWT_HS512 := "HS512"

pub const JWT_OK := 0
pub const JWT_ERR_MALFORMED := 1
pub const JWT_ERR_BAD_BASE64 := 2
pub const JWT_ERR_BAD_JSON := 3
pub const JWT_ERR_ALG_UNSUPPORTED := 4
pub const JWT_ERR_ALG_MISMATCH := 5
pub const JWT_ERR_SIGNATURE := 6
pub const JWT_ERR_EXPIRED := 7
pub const JWT_ERR_NOT_YET_VALID := 8
pub const JWT_ERR_ISSUED_IN_FUTURE := 9
pub const JWT_ERR_ISSUER := 10
pub const JWT_ERR_AUDIENCE := 11
pub const JWT_ERR_SUBJECT := 12
pub const JWT_ERR_MISSING_CLAIM := 13
pub const JWT_ERR_EMPTY_SECRET := 14
pub const JWT_ERR_TYPE := 15

@en "IsSupportedAlg"
@fa "الگوریتم پشتیبانی می شود"
@ar "الخوارزمیة مدعومة"
pub pure func IsSupportedAlg(alg: str): bool:
    ret alg == JWT_HS256 || alg == JWT_HS384 || alg == JWT_HS512
end

@en "DigestSize"
@fa "اندازه چکیده"
@ar "حجم الملخص"
pub pure func DigestSize(alg: str): int:
    if alg == JWT_HS256: ret 32 end
    if alg == JWT_HS384: ret 48 end
    if alg == JWT_HS512: ret 64 end
    ret 0
end

@en "ErrorText"
@fa "متن خطا"
@ar "نص الخطأ"
pub pure func ErrorText(code: int): str:
    if code == JWT_OK: ret "ok" end
    if code == JWT_ERR_MALFORMED: ret "malformed token" end
    if code == JWT_ERR_BAD_BASE64: ret "invalid base64url segment" end
    if code == JWT_ERR_BAD_JSON: ret "invalid JSON in header or payload" end
    if code == JWT_ERR_ALG_UNSUPPORTED: ret "unsupported algorithm" end
    if code == JWT_ERR_ALG_MISMATCH: ret "algorithm mismatch" end
    if code == JWT_ERR_SIGNATURE: ret "signature does not match" end
    if code == JWT_ERR_EXPIRED: ret "token expired" end
    if code == JWT_ERR_NOT_YET_VALID: ret "token not yet valid" end
    if code == JWT_ERR_ISSUED_IN_FUTURE: ret "token issued in the future" end
    if code == JWT_ERR_ISSUER: ret "issuer mismatch" end
    if code == JWT_ERR_AUDIENCE: ret "audience mismatch" end
    if code == JWT_ERR_SUBJECT: ret "subject mismatch" end
    if code == JWT_ERR_MISSING_CLAIM: ret "required claim missing" end
    if code == JWT_ERR_EMPTY_SECRET: ret "empty secret" end
    if code == JWT_ERR_TYPE: ret "unexpected typ header" end
    ret "unknown error"
end
