@en "jwt"
@fa "جی دبلیو تی"
@ar "جیه دبلیو تي"
package jwt

import str
import mem
import conv
import time
import crypto
import encoding

// JSON Web Tokens: RFC 7519 claims over RFC 7515 compact-serialized JWS,
// signed with the HMAC-SHA2 family (RFC 7518 §3.2).
//
//     mut c := jwt.NewClaims()
//     c.sub = "user-42"
//     c.iss = "api.example.com"
//     jwt.ExpiresIn(c, 3600)
//     jwt.SetStr(c, "role", "admin")
//     mut err := 0
//     token := jwt.SignHS256(c, secret, err)
//
//     mut verr := 0
//     opts := jwt.DefaultOptions()
//     t := jwt.Verify(token, secret, opts, verr)
//     if verr != JWT_OK: /* reject: jwt.ErrorText(verr) */ end
//     println t.claims.sub, jwt.Str(t, "role")
//
// WHAT IS DELIBERATELY NOT HERE
//
// RS*/PS*/ES* (RSA and ECDSA) are not implemented. Salam has RSA and P-256
// inside std/tls, but it is not exported, and importing tls would link the
// whole TLS stack into every program that only wants to stamp a session
// token. A partial asymmetric implementation is worse than none, so an
// unrecognised alg is rejected rather than half-verified.
//
// "alg": "none" is rejected unconditionally. It is the classic JWT forgery:
// a token whose header claims no signature is not an unsigned token, it is an
// attacker-supplied one. There is no option to enable it.
//
// THE TWO RULES THAT MAKE THIS SAFE
//
// 1. The algorithm comes from the verifier, not from the token. Options.alg
//    is what the signature is checked with; a header advertising anything
//    else is JWT_ERR_ALG_MISMATCH, never a reason to switch algorithms.
// 2. Decode() does not verify anything. It is for reading a token you have
//    already verified, or for inspecting one in a tool. Never branch on a
//    claim that came out of Decode.

// Supported "alg" header values.
pub const JWT_HS256 := "HS256"
pub const JWT_HS384 := "HS384"
pub const JWT_HS512 := "HS512"

// Error codes. Salam has no exceptions, so every entry point takes an
// `err &: int` out-parameter and sets it to one of these.
pub const JWT_OK := 0
pub const JWT_ERR_MALFORMED := 1
pub const JWT_ERR_BAD_BASE64 := 2
pub const JWT_ERR_BAD_JSON := 3
pub const JWT_ERR_ALG_UNSUPPORTED := 4
pub const JWT_ERR_ALG_MISMATCH := 5
pub const JWT_ERR_SIGNATURE := 6
pub const JWT_ERR_EXPIRED := 7
pub const JWT_ERR_NOT_YET_VALID := 8
pub const JWT_ERR_ISSUED_IN_FUTURE := 9
pub const JWT_ERR_ISSUER := 10
pub const JWT_ERR_AUDIENCE := 11
pub const JWT_ERR_SUBJECT := 12
pub const JWT_ERR_MISSING_CLAIM := 13
pub const JWT_ERR_EMPTY_SECRET := 14
pub const JWT_ERR_TYPE := 15

@en "IsSupportedAlg"
@fa "الگوریتم پشتیبانی می شود"
@ar "الخوارزمیة مدعومة"
pub pure func IsSupportedAlg(alg: str): bool:
    ret alg == JWT_HS256 || alg == JWT_HS384 || alg == JWT_HS512
end

@en "DigestSize"
@fa "اندازه چکیده"
@ar "حجم الملخص"
pub pure func DigestSize(alg: str): int:
    if alg == JWT_HS256: ret 32 end
    if alg == JWT_HS384: ret 48 end
    if alg == JWT_HS512: ret 64 end
    ret 0
end

@en "ErrorText"
@fa "متن خطا"
@ar "نص الخطأ"
pub pure func ErrorText(code: int): str:
    if code == JWT_OK: ret "ok" end
    if code == JWT_ERR_MALFORMED: ret "malformed token" end
    if code == JWT_ERR_BAD_BASE64: ret "invalid base64url segment" end
    if code == JWT_ERR_BAD_JSON: ret "invalid JSON in header or payload" end
    if code == JWT_ERR_ALG_UNSUPPORTED: ret "unsupported algorithm" end
    if code == JWT_ERR_ALG_MISMATCH: ret "algorithm mismatch" end
    if code == JWT_ERR_SIGNATURE: ret "signature does not match" end
    if code == JWT_ERR_EXPIRED: ret "token expired" end
    if code == JWT_ERR_NOT_YET_VALID: ret "token not yet valid" end
    if code == JWT_ERR_ISSUED_IN_FUTURE: ret "token issued in the future" end
    if code == JWT_ERR_ISSUER: ret "issuer mismatch" end
    if code == JWT_ERR_AUDIENCE: ret "audience mismatch" end
    if code == JWT_ERR_SUBJECT: ret "subject mismatch" end
    if code == JWT_ERR_MISSING_CLAIM: ret "required claim missing" end
    if code == JWT_ERR_EMPTY_SECRET: ret "empty secret" end
    if code == JWT_ERR_TYPE: ret "unexpected typ header" end
    ret "unknown error"
end
