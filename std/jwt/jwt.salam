@en "jwt"
@fa "جی دبلیو تی"
package jwt

import str
import mem
import conv
import time
import crypto
import encoding

@en "JWT_HS256"
@fa "الگوریتم اچ اس۲۵۶"
pub const JWT_HS256 := "HS256"
@en "JWT_HS384"
@fa "الگوریتم اچ اس۳۸۴"
pub const JWT_HS384 := "HS384"
@en "JWT_HS512"
@fa "الگوریتم اچ اس۵۱۲"
pub const JWT_HS512 := "HS512"

func _jwt_err(kind: ErrorKind, code: str, message: str): Error:
    ret Error.New(kind, message).with_code("jwt." + code).wrap("jwt")
end

@en "IsSupportedAlg"
@fa "الگوریتم پشتیبانی می شود"
pub pure func IsSupportedAlg(alg: str): bool:
    ret alg == JWT_HS256 or alg == JWT_HS384 or alg == JWT_HS512
end

@en "DigestSize"
@fa "اندازه چکیده"
pub pure func DigestSize(alg: str): int:
    if alg == JWT_HS256: ret 32 end
    if alg == JWT_HS384: ret 48 end
    if alg == JWT_HS512: ret 64 end
    ret 0
end
