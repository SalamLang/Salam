package jwt

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

pure func _b64url_ok(code: int): bool:
    if code >= 65 and code <= 90: ret true end
    if code >= 97 and code <= 122: ret true end
    if code >= 48 and code <= 57: ret true end
    ret code == 45 or code == 95
end

func _to_url_alphabet(s: str): str:
    n := s.Len()
    bp := _bp(s)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n in i:
        code := _ub(bp, i)
        if code == 43:
            str.BufAppendChar(sb, 45)
        else code == 47:
            str.BufAppendChar(sb, 95)
        else code != 61:
            str.BufAppendChar(sb, code)
        end
    end
    out := str.BufStr(sb)
    ret out
end

func _byte_text(code: int): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    if code == 32:
        str.BufAppend(sb, "space")
    else code > 32 and code < 127:
        str.BufAppend(sb, "character ")
        str.BufAppendChar(sb, 39)
        str.BufAppendChar(sb, code)
        str.BufAppendChar(sb, 39)
    else:
        digits := "0123456789ABCDEF"
        hp := _bp(digits)
        str.BufAppend(sb, "byte 0x")
        str.BufAppendChar(sb, _ub(hp, code / 16))
        str.BufAppendChar(sb, _ub(hp, code % 16))
    end
    out := str.BufStr(sb)
    ret out
end

func _b64url_err(kind: ErrorKind, message: str, offset: int): Error:
    ret Error.At(kind, message, offset).with_code("jwt.bad_base64").wrap("base64url")
end

@en "B64UrlEncodeBytes"
@fa "کدگذاری پایه۶۴ نشانی بایت"
pub func B64UrlEncodeBytes(p: void*, n: int): str:
    std64 := encoding.Base64EncodeBytes(p, n)
    ret _to_url_alphabet(std64)
end

@en "B64UrlEncode"
@fa "کدگذاری پایه۶۴ نشانی"
pub func B64UrlEncode(s: str): str:
    ret B64UrlEncodeBytes(s as void*, s.Len())
end

@en "B64UrlDecode"
@fa "کدگشایی پایه۶۴ نشانی"
pub func B64UrlDecode(s: str): str throws:
    n := s.Len()
    bp := _bp(s)
    repeat n in i:
        code := _ub(bp, i)
        if not _b64url_ok(code):
            throw _b64url_err(ErrorKind.Syntax, "invalid " + _byte_text(code), i)
        end
    end
    if n % 4 == 1:
        throw _b64url_err(ErrorKind.UnexpectedEnd, "input ends one character into a group of four", n)
    end
    ret try encoding.Base64Decode(s)
end
