package jwt

import net.http

@en "Guard"
@fa "نگهبان"
pub struct Guard:
    @en "secret"
    @fa "کلید امضا"
    pub secret: str = ""
    @en "opts"
    @fa "گزینه‌ها"
    pub opts: Options = Options {}
    @en "cookie"
    @fa "کوکی"
    pub cookie: str = ""
    @en "realm"
    @fa "قلمرو"
    pub realm: str = "api"
end

pure func _lower_ascii(c: int): int:
    if c >= 65 and c <= 90: ret c + 32 end
    ret c
end

func _strip_bearer(value: str): str:
    n := value.Len()
    if n < 7: ret "" end
    want := "bearer"
    p := (value as void*) as i8*
    w := (want as void*) as i8*
    repeat 6 in i:
        mut a := p[i] as int
        if a < 0: a += 256 end
        mut b := w[i] as int
        if b < 0: b += 256 end
        if _lower_ascii(a) != b: ret "" end
    end
    if value.Substr(6, 1) != " ": ret "" end
    mut start := 6
    until start < n and value.Substr(start, 1) == " ":
        start++
    end
    if start >= n: ret "" end
    ret value.Substr(start, n - start)
end

func _json_error(code: str, reason: str): str:
    ret `{"error":"`.Concat(code).Concat(`","reason":"`).Concat(reason).Concat(`"}`)
end

func _challenge(ctx: i64, g: Guard, token_was_offered: bool):
    http.SetStatus(ctx, 401)
    mut value := `Bearer realm="`.Concat(g.realm).Concat(`"`)
    if token_was_offered:
        value = value.Concat(`, error="invalid_token"`)
    end
    http.SetHeader(ctx, "WWW-Authenticate", value)
end

@en "NewGuard"
@fa "نگهبان جدید"
pub func NewGuard(secret: str): Guard:
    ret Guard { secret = secret, opts = DefaultOptions() }
end

@en "ParseBearer"
@fa "تجزیه حامل"
pub func ParseBearer(header_value: str): str:
    ret _strip_bearer(header_value)
end

@en "BearerToken"
@fa "توکن حامل"
pub func BearerToken(ctx: i64): str:
    ret _strip_bearer(http.Header(ctx, "Authorization"))
end

@en "TokenFrom"
@fa "توکن از"
pub func TokenFrom(ctx: i64, g: Guard): str:
    bearer := BearerToken(ctx)
    if bearer.Len() > 0: ret bearer end
    if g.cookie.Len() > 0: ret http.CookieValue(ctx, g.cookie) end
    ret ""
end

@en "Check"
@fa "بررسی"
pub func Check(ctx: i64, g: Guard): Token throws:
    raw := TokenFrom(ctx, g)
    if raw.Len() == 0:
        throw _jwt_err(ErrorKind.NotFound, "missing_token", "missing bearer token")
    end
    ret try Verify(raw, g.secret, g.opts)
end

@en "Unauthorized"
@fa "غیرمجاز"
pub func Unauthorized(ctx: i64, g: Guard, reason: str):
    _challenge(ctx, g, true)
    http.Json(ctx, _json_error("unauthorized", reason))
end

@en "MissingCredential"
@fa "بدون گواهی"
pub func MissingCredential(ctx: i64, g: Guard):
    _challenge(ctx, g, false)
    http.Json(ctx, _json_error("unauthorized", "missing bearer token"))
end

@en "Forbidden"
@fa "ممنوع"
pub func Forbidden(ctx: i64, reason: str):
    http.SetStatus(ctx, 403)
    http.Json(ctx, _json_error("forbidden", reason))
end

@en "Require"
@fa "نیاز"
pub func Require(ctx: i64, g: Guard, t &: Token): bool:
    raw := TokenFrom(ctx, g)
    if raw.Len() == 0:
        MissingCredential(ctx, g)
        ret false
    end
    try:
        t = Verify(raw, g.secret, g.opts)
    catch e:
        Unauthorized(ctx, g, e.message)
        ret false
    end
    ret true
end

@en "RequireScope"
@fa "نیاز به دامنه"
pub func RequireScope(ctx: i64, g: Guard, scope: str, t &: Token): bool:
    if not Require(ctx, g, t): ret false end
    if not HasScope(t, scope):
        Forbidden(ctx, "missing scope: ".Concat(scope))
        ret false
    end
    ret true
end

@en "RequireClaim"
@fa "نیاز به ادعا"
pub func RequireClaim(ctx: i64, g: Guard, key: str, value: str, t &: Token): bool:
    if not Require(ctx, g, t): ret false end
    if not ListHas(t, key, value):
        Forbidden(ctx, "missing ".Concat(key).Concat(": ").Concat(value))
        ret false
    end
    ret true
end

@en "RequireSubject"
@fa "نیاز به موضوع"
pub func RequireSubject(ctx: i64, g: Guard, subject: str, t &: Token): bool:
    if not Require(ctx, g, t): ret false end
    if t.claims.sub != subject:
        Forbidden(ctx, "not your resource")
        ret false
    end
    ret true
end
