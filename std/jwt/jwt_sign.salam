package jwt

func _header_json(alg: str, kid: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, `{"alg":`)
    str.BufAppend(sb, _quoted(alg))
    str.BufAppend(sb, `,"typ":"JWT"`)
    if kid.Len() > 0:
        str.BufAppend(sb, `,"kid":`)
        str.BufAppend(sb, _quoted(kid))
    end
    str.BufAppendChar(sb, 125)
    out := str.BufStr(sb)
    ret out
end

func _signature(alg: str, secret: str, signing_input: str): str:
    n := DigestSize(alg)
    if n == 0: ret "" end
    out := mem.Allocate(n as u64)
    defer mem.Free(out)
    if alg == JWT_HS256:
        crypto.HmacSha256Bytes(secret, signing_input, out)
    else alg == JWT_HS384:
        crypto.HmacSha384Bytes(secret, signing_input, out)
    else:
        crypto.HmacSha512Bytes(secret, signing_input, out)
    end
    sig := B64UrlEncodeBytes(out, n)
    ret sig
end

@en "SignJSON"
@fa "امضای جیسون"
pub func SignJSON(payload_json: str, alg: str, kid: str, secret: str): str throws:
    if not IsSupportedAlg(alg):
        throw _jwt_err(ErrorKind.Unsupported, "bad_alg", "unsupported algorithm")
    end
    if secret.Len() == 0:
        throw _jwt_err(ErrorKind.InvalidArgument, "empty_secret", "empty secret")
    end
    signing_input := B64UrlEncode(_header_json(alg, kid)).concat(".").concat(B64UrlEncode(payload_json))
    ret signing_input.concat(".").concat(_signature(alg, secret, signing_input))
end

@en "SignatureOf"
@fa "امضای ورودی"
pub func SignatureOf(signing_input: str, alg: str, secret: str): str:
    if secret.Len() == 0: ret "" end
    ret _signature(alg, secret, signing_input)
end

@en "SignWithKid"
@fa "امضا با شناسه کلید"
pub func SignWithKid(c: Claims, alg: str, kid: str, secret: str): str throws:
    ret try SignJSON(ClaimsJSON(c), alg, kid, secret)
end

@en "Sign"
@fa "امضا"
pub func Sign(c: Claims, alg: str, secret: str): str throws:
    ret try SignJSON(ClaimsJSON(c), alg, "", secret)
end

@en "SignHS256"
@fa "امضای اچ اس۲۵۶"
pub func SignHS256(c: Claims, secret: str): str throws:
    ret try SignJSON(ClaimsJSON(c), JWT_HS256, "", secret)
end

@en "SignHS384"
@fa "امضای اچ اس۳۸۴"
pub func SignHS384(c: Claims, secret: str): str throws:
    ret try SignJSON(ClaimsJSON(c), JWT_HS384, "", secret)
end

@en "SignHS512"
@fa "امضای اچ اس۵۱۲"
pub func SignHS512(c: Claims, secret: str): str throws:
    ret try SignJSON(ClaimsJSON(c), JWT_HS512, "", secret)
end
