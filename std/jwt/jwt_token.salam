package jwt

@en "Token"
@fa "توکن"
pub struct Token:
    @en "alg"
    @fa "الگوریتم"
    pub alg: str = ""
    @en "typ"
    @fa "نوع"
    pub typ: str = ""
    @en "kid"
    @fa "شناسه کلید"
    pub kid: str = ""
    @en "claims"
    @fa "ادعاها"
    pub claims: Claims = Claims {}
    @en "header_json"
    @fa "سرآیند جیسون"
    pub header_json: str = ""
    @en "payload_json"
    @fa "بدنه جیسون"
    pub payload_json: str = ""
    @en "signing_input"
    @fa "ورودی امضا"
    pub signing_input: str = ""
    @en "signature"
    @fa "امضا"
    pub signature: str = ""
    @en "valid"
    @fa "معتبر"
    pub valid: bool = false
end

func _claim_raw(t: Token, key: str, found &: bool): str:
    ret _member_raw(t.payload_json, key, found)
end

@en "Has"
@fa "دارد"
pub func Has(t: Token, key: str): bool:
    mut found := false
    _unused := _claim_raw(t, key, found)
    ret found
end

@en "Raw"
@fa "خام"
pub func Raw(t: Token, key: str): str:
    mut found := false
    raw := _claim_raw(t, key, found)
    if not found: ret "" end
    ret raw
end

@en "Str"
@fa "رشته"
pub func Str(t: Token, key: str): str:
    mut found := false
    raw := _claim_raw(t, key, found)
    if not found: ret "" end
    ret _raw_to_str(raw)
end

@en "Int"
@fa "عدد"
pub func Int(t: Token, key: str): i64:
    mut found := false
    raw := _claim_raw(t, key, found)
    if not found: ret 0 end
    ret _raw_to_i64(raw)
end

@en "Bool"
@fa "منطقی"
pub func Bool(t: Token, key: str): bool:
    mut found := false
    raw := _claim_raw(t, key, found)
    if not found: ret false end
    ret raw == "true"
end

@en "HasAudience"
@fa "مخاطب دارد"
pub func HasAudience(t: Token, want: str): bool:
    mut found := false
    raw := _claim_raw(t, "aud", found)
    if not found: ret false end
    ret _raw_has_string(raw, want)
end

@en "ListHas"
@fa "فهرست دارد"
pub func ListHas(t: Token, key: str, want: str): bool:
    mut found := false
    raw := _claim_raw(t, key, found)
    if not found: ret false end
    ret _raw_has_string(raw, want)
end

@en "HasScope"
@fa "دامنه دارد"
pub func HasScope(t: Token, want: str): bool:
    scopes := Str(t, "scope")
    if scopes.len() == 0 or want.len() == 0: ret false end
    n := scopes.len()
    w := want.len()
    mut i := 0
    until i < n:
        mut e := i
        until e < n and scopes.substr(e, 1) != " ":
            e += 1
        end
        if e - i == w and scopes.substr(i, w) == want: ret true end
        i = e + 1
    end
    ret false
end

@en "SecondsRemaining"
@fa "ثانیه های باقی مانده"
pub func SecondsRemaining(t: Token): i64:
    if t.claims.exp == 0 as i64: ret 0 end
    ret t.claims.exp - time.Now()
end
