package layout

@en "opens"
@fa "باز می کند"
pub const ds_opens_attr := LayoutAttribute {
    generated_name = "data-opens"
    value_type = "token"
    elements = ["button", "dialog trigger"]
}

@en "closes"
@fa "می بندد"
pub const ds_closes_attr := LayoutAttribute {
    generated_name = "data-dialog-close"
    value_type = "bool"
    elements = ["button"]
}

