package layout

@en "design"
@fa "طراحی"
pub const design_attr := LayoutAttribute {
    generated_name = "data-design"
    value_type = "enum"
    allowed = "design_name"
    elements = ["page"]
}

@en "theme"
@fa "پوسته"
