package layout

@en "name"
@fa "نام"
pub const font_name_attr := LayoutAttribute {
    destination = "meta"
    elements = ["font"]
}

@en "url" "source" "src"
@fa "نشانی" "منبع"
pub const font_url_attr := LayoutAttribute {
    destination = "meta"
    value_type = "url"
    multiple = true
    elements = ["font"]
}

@en "type" "format"
@fa "نوع" "قالب"
pub const font_type_attr := LayoutAttribute {
    destination = "meta"
    value_type = "enum"
    allowed = "font_format"
    elements = ["font"]
}

@en "weight"
@fa "وزن"
pub const font_weight_attr := LayoutAttribute {
    destination = "meta"
    elements = ["font"]
}

@en "style"
@fa "سبک" "حالت"
pub const font_style_attr := LayoutAttribute {
    destination = "meta"
    value_type = "enum"
    allowed = "font_style"
    elements = ["font"]
}

@en "display"
@fa "نمایش"
pub const font_display_attr := LayoutAttribute {
    destination = "meta"
    value_type = "enum"
    allowed = "font_display"
    elements = ["font"]
}

@en "range" "unicode range"
@fa "بازه" "بازه یونیکد"
pub const font_range_attr := LayoutAttribute {
    destination = "meta"
    elements = ["font"]
}
