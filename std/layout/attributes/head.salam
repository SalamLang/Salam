package layout

@en "content"
@fa "محتوا"
pub const meta_content := LayoutAttribute {
    generated_name = "content"
    elements = ["meta"]
}

@en "property"
@fa "خاصیت"
pub const property := LayoutAttribute {
    generated_name = "property"
    elements = ["meta"]
}

@en "charset"
@fa "نویسه‌گان"
pub const charset := LayoutAttribute {
    generated_name = "charset"
    value_type = "charset"
    elements = ["meta"]
}

@en "http_equiv" "http equiv"
@fa "معادل اچ‌تی‌تی‌پی"
pub const http_equiv := LayoutAttribute {
    generated_name = "http-equiv"
    elements = ["meta"]
}

@en "rel"
@fa "رابطه"
pub const rel := LayoutAttribute {
    generated_name = "rel"
    value_type = "token"
    elements = ["head link"]
    multiple = true
}

@en "type"
@fa "نوع"
pub const link_type := LayoutAttribute {
    generated_name = "type"
    value_type = "mime"
    elements = ["head link"]
}

@en "crossorigin" "cross origin"
@fa "میان‌مبدا"
pub const crossorigin := LayoutAttribute {
    generated_name = "crossorigin"
    value_type = "enum"
    allowed = "crossorigin"
    elements = ["head link"]
}

@en "sizes"
@fa "اندازه‌ها"
pub const sizes := LayoutAttribute {
    generated_name = "sizes"
    elements = ["head link"]
}

@en "as"
@fa "به عنوان"
pub const as_attr := LayoutAttribute {
    generated_name = "as"
    value_type = "token"
    elements = ["head link"]
}

@en "media"
@fa "رسانه"
pub const media_attr := LayoutAttribute {
    generated_name = "media"
    value_type = "media_query"
    elements = ["head link"]
}

@en "favicon"
@fa "نماد"
pub const favicon := LayoutAttribute {
    destination = "meta"
    value_type = "url"
    elements = ["layout"]
}
