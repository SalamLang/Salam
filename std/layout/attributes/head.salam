}

@en "rel"
@fa "رابطه"
pub const rel := LayoutAttribute {
    generated_name = "rel"
    value_type = "token"
    elements = ["head link"]
    multiple = true
}

@en "type"
@fa "نوع"
pub const link_type := LayoutAttribute {
