package layout

@en "url" "source" "href" "src"
@fa "نشانی" "منبع" "منبع رسانه"
pub const url := LayoutAttribute {
    generated_name = "href"
    value_type = "url"
    elements = ["link", "head link"]
}

@en "url" "source" "href" "src"
@fa "نشانی" "منبع" "منبع رسانه"
pub const url_2 := LayoutAttribute {
    generated_name = "src"
    value_type = "url"
    elements = ["image", "iframe", "script"]
}

@en "alt"
@fa "جایگزین"
pub const alt := LayoutAttribute {
    generated_name = "alt"
    elements = ["image"]
    default = ""
}

@en "content"
@fa "محتوا"
pub const image_text := LayoutAttribute {
    generated_name = "alt"
    elements = ["image"]
}

@en "content"
@fa "محتوا"
pub const input_text := LayoutAttribute {
    generated_name = "value"
    elements = ["input"]
}

@en "target"
@fa "هدف"
pub const target := LayoutAttribute {
    generated_name = "target"
    value_type = "enum"
    allowed = "target"
    elements = ["link"]
}
