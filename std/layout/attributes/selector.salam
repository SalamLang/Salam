package layout

@en "selector"
@fa "گزینشگر"
pub const selector := LayoutAttribute {
    destination = "meta"
    elements = ["global"]
}

@en "condition"
@fa "شرط"
pub const condition := LayoutAttribute {
    destination = "meta"
    elements = ["media"]
}

@en "size"
@fa "اندازه"
pub const size := LayoutAttribute {
    destination = "meta"
    value_type = "int"
    elements = ["heading"]
}

@en "heading"
@fa "سرستون"
pub const heading_flag := LayoutAttribute {
    destination = "meta"
    value_type = "bool"
    elements = ["heading cell"]
}
