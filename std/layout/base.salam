package layout

@en "ElementType"
@fa "نوع عنصر"
pub enum ElementType:
    Normal
    Void
    RawText
    Virtual
    Single
    Mother
    Mother2Single
    Single2Mother
end

@en "LayoutCategory"
@fa "دسته صفحه"
pub struct LayoutCategory:
    pub name: str = ""
end

@en "LayoutAttribute"
@fa "ویژگی صفحه"
pub struct LayoutAttribute:
    pub name: str = ""
    pub generated_name: str = ""
    pub destination: str = "html"
    pub value_type: str = "string"
    pub allowed: str = ""
    pub elements: str = ""
    pub multiple: bool = false
    pub default: str = ""
end

@en "LayoutValue"
@fa "مقدار صفحه"
pub struct LayoutValue:
    pub generated_value: str = ""
    pub group: str = ""
    pub generator: str = ""
end

@en "LayoutElement"
@fa "عنصر صفحه"
pub struct LayoutElement:
    pub name: str = ""
    pub generated_name: str = ""
    pub kind: ElementType = ElementType.Normal
    pub categories: str = ""
    pub parents: str = ""
    pub path: str = ""
    pub ancestors: str = ""
    pub children: str = ""
    pub forbidden: str = ""
    pub forbidden_descendants: str = ""
    pub required: str = ""
    pub when: str = ""
    pub unique: str = ""
    pub generator: str = ""
    pub placement: str = "body"
    pub position: str = ""
    pub styled: bool = true
end
