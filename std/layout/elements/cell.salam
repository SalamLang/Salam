package layout

@en "column" "cell"
@fa "ستون" "سلول"
pub const cell := LayoutElement {
    generated_name = "td"
    parents = ["row"]
    children = ["#flow"]
}

@en "column" "cell"
@fa "ستون" "سلول"
pub const header_cell := LayoutElement {
    name = "header column"
    generated_name = "th"
    path = ["row", "table header"]
    children = ["#flow"]
    forbidden_descendants = ["header", "footer", "#sectioning", "#heading"]
}

@en "column" "cell"
@fa "ستون" "سلول"
pub const heading_cell := LayoutElement {
    name = "heading column"
    generated_name = "th"
    parents = ["row"]
    children = ["#flow"]
    forbidden_descendants = ["header", "footer", "#sectioning", "#heading"]
    when = "heading"
}
