package layout

@en "definition" "dfn"
@fa "تعریف"
pub const definition := LayoutElement {
    generated_name = "dfn"
    categories = [
        "flow", "phrasing", "palpable"
    ]
    children = ["#phrasing"]
    forbidden_descendants = ["definition"]
}
