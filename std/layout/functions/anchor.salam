package layout

@en "anchor"
@fa "لنگر"
pub const css_fn_anchor := LayoutFunction {
    generated_name = "anchor" args = "seq:dashed?|@css_g_anchorside+percentage; ?length percentage"
}

@en "anchor-size"
@fa "اندازه‌لنگر"
pub const css_fn_anchor_size := LayoutFunction {
    generated_name = "anchor-size" args = "?seq:dashed?|@css_g_anchorsize?; ?length percentage"
}
