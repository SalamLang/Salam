package layout

@en "counter"
@fa "شمارنده"
pub const css_fn_counter := LayoutFunction { generated_name = "counter" args = "ident; ?ident @css_g_lstype" }

@en "counters"
@fa "شمارنده‌ها"
pub const css_fn_counters := LayoutFunction { generated_name = "counters" args = "ident; string; ?ident @css_g_lstype" }
