package layout

@en "cubic-bezier"
@fa "بزیه‌مکعبی"
pub const css_fn_cubic_bezier := LayoutFunction { generated_name = "cubic-bezier" args = "number; number; number; number" }

@en "steps"
@fa "گام‌ها"
pub const css_fn_steps := LayoutFunction { generated_name = "steps" args = "integer; ?@css_g_steppos" }

@en "linear"
@fa "خطی"
pub const css_fn_linear := LayoutFunction { generated_name = "linear" args = "+seq:number|percentage*0-2" }
