package layout

@en "repeat"
@fa "تکرار"
pub const css_fn_repeat := LayoutFunction { generated_name = "repeat" args = "integer @css_g_repeatkw; length percentage flex names fn=minmax,fit-content @css_g_gridkw max99" }

@en "minmax"
@fa "کمینه‌بیشینه"
pub const css_fn_minmax := LayoutFunction { generated_name = "minmax" args = "length percentage flex @css_g_gridkw; length percentage flex @css_g_gridkw" }

@en "fit-content"
@fa "اندازه‌محتوا"
pub const css_fn_fit_content := LayoutFunction { generated_name = "fit-content" args = "length percentage" }
