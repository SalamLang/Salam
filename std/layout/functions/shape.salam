package layout

@en "inset"
@fa "فرورفته"
pub const css_fn_inset := LayoutFunction { generated_name = "inset" args = "seq:length+percentage*1-4|@css_g_round?|length+percentage*0-4|/length+percentage*1-4" }

@en "circle"
@fa "دایره"
pub const css_fn_circle := LayoutFunction { generated_name = "circle" args = "?seq:length+percentage+@css_g_extent?|@css_g_at?|@css_g_pos+length+percentage*0-2" }

@en "ellipse"
@fa "بیضی"
pub const css_fn_ellipse := LayoutFunction { generated_name = "ellipse" args = "?seq:length+percentage+@css_g_extent*0-2|@css_g_at?|@css_g_pos+length+percentage*0-2" }

@en "polygon"
@fa "چند‌ضلعی"
pub const css_fn_polygon := LayoutFunction { generated_name = "polygon" args = "?@css_g_fillrule; +length percentage max2" }

@en "path"
@fa "مسیر"
pub const css_fn_path := LayoutFunction { generated_name = "path" args = "?@css_g_fillrule; string" }

@en "rect"
@fa "مستطیل"
pub const css_fn_rect := LayoutFunction { generated_name = "rect" args = "seq:length+percentage+@css_g_auto*4|@css_g_round?|length+percentage*0-4|/length+percentage*1-4" }

@en "xywh"
pub const css_fn_xywh := LayoutFunction { generated_name = "xywh" args = "seq:length+percentage*4|@css_g_round?|length+percentage*0-4|/length+percentage*1-4" }

@en "ray"
@fa "پرتو"
pub const css_fn_ray := LayoutFunction { generated_name = "ray" args = "seq:angle|@css_g_raysize?|@css_g_contain?|@css_g_at?|@css_g_pos+length+percentage*0-2" }

@en "shape"
@fa "شکل"
pub const css_fn_shape := LayoutFunction { generated_name = "shape" args = "seq:@css_g_fillrule?|@css_g_from|@css_g_pos+length+percentage*1-2; +seq:@css_g_shapecmd|@css_g_shapeword+@css_g_pos+length+percentage+angle*0-12" }
