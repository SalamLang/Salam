package layout

@en "scroll"
@fa "پیمایش"
pub const css_fn_scroll := LayoutFunction { generated_name = "scroll" args = "?seq:@css_g_scroller?|@css_g_tlaxis?" }

@en "view"
@fa "دید"
pub const css_fn_view := LayoutFunction { generated_name = "view" args = "?seq:@css_g_tlaxis?|length+percentage+@css_g_auto*0-2" }
