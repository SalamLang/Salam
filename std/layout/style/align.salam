package layout

@en "align content"
@fa "محتوا تراز"
pub const css_align_content := LayoutAttribute { destination = "css" value_type = "css" generated_name = "align-content" allowed = "@css_align_content" }

@en "align items"
@fa "ترازعمودی" "موارد تراز"
pub const css_align_items := LayoutAttribute { destination = "css" value_type = "css" generated_name = "align-items" allowed = "@css_align_items" }

@en "align self"
@fa "خود تراز"
pub const css_align_self := LayoutAttribute { destination = "css" value_type = "css" generated_name = "align-self" allowed = "@css_align_self" }
