package layout

@en "anchor name"
@fa "نام لنگر"
pub const css_anchor_name := LayoutAttribute { destination = "css" value_type = "css" generated_name = "anchor-name" allowed = "list dashed @css_g_dashed_none" }

@en "anchor scope"
@fa "دامنه لنگر"
pub const css_anchor_scope := LayoutAttribute { destination = "css" value_type = "css" generated_name = "anchor-scope" allowed = "list dashed @css_g_anchorscope" }
