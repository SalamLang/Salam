package layout

@en "animation"
@fa "پویانمایی"
pub const css_animation := LayoutAttribute { destination = "css" value_type = "string" generated_name = "animation" }

@en "animation composition"
@fa "ترکیب‌بندی پویانمایی"
pub const css_animation_composition := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-composition" allowed = "list @css_animation_composition" }

@en "animation delay"
@fa "تاخیر پویانمایی"
pub const css_animation_delay := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-delay" allowed = "list time" }

@en "animation direction"
@fa "جهت پویانمایی"
pub const css_animation_direction := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-direction" allowed = "list @css_animation_direction" }

@en "animation duration"
@fa "مدت پویانمایی"
pub const css_animation_duration := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-duration" allowed = "list time @css_animation_duration" }

@en "animation fill mode"
@fa "حالت پرکردن پویانمایی"
pub const css_animation_fill_mode := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-fill-mode" allowed = "list @css_animation_fill_mode" }

@en "animation iteration count"
@fa "تعداد تکرار پویانمایی"
pub const css_animation_iteration_count := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-iteration-count" allowed = "list number @css_animation_iteration_count" }

@en "animation name"
@fa "نام پویانمایی"
pub const css_animation_name := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-name" allowed = "list ident @css_animation_name" }

@en "animation play state"
@fa "وضعیت پخش پویانمایی"
pub const css_animation_play_state := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-play-state" allowed = "list @css_animation_play_state" }

@en "animation timing function"
@fa "تابع زمان‌بندی پویانمایی"
pub const css_animation_timing_function := LayoutAttribute { destination = "css" value_type = "css" generated_name = "animation-timing-function" allowed = "list easing @css_animation_timing_function" }
