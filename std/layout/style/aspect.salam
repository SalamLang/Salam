package layout

@en "aspect ratio"
@fa "نسبت ابعاد"
pub const css_aspect_ratio := LayoutAttribute { destination = "css" value_type = "css" generated_name = "aspect-ratio" allowed = "ratio @css_aspect_ratio" }
