package layout

@en "backdrop filter"
pub const css_backdrop_filter := LayoutAttribute { destination = "css" value_type = "css" generated_name = "backdrop-filter" allowed = "fn=blur,brightness,contrast,drop-shadow,grayscale,hue-rotate,invert,opacity,saturate,sepia,url @css_g_none max99" }
