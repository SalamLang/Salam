package layout

@en "background"
@fa "پس زمینه" "پس‌زمینه"
pub const css_background := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background" allowed = "list set:image+@css_g_none|length+percentage+@css_g_pos*0-4|/length+percentage+@css_g_bgsize*1-2|@css_g_bgrep*0-2|@css_g_bgatt|@css_g_bgbox*0-2|color" }

@en "background attachment"
@fa "پیوست پس‌زمینه"
pub const css_background_attachment := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-attachment" allowed = "@css_background_attachment" }

@en "background blend mode"
@fa "حالت آمیختگی پس‌زمینه"
pub const css_background_blend_mode := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-blend-mode" allowed = "@css_background_blend_mode" }

@en "background clip"
@fa "برش پس‌زمینه"
pub const css_background_clip := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-clip" allowed = "@css_background_clip" }

@en "background color"
@fa "رنگ پس‌زمینه"
pub const css_background_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-color" allowed = "color" }

@en "background image"
@fa "تصویر پس‌زمینه"
pub const css_background_image := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-image" allowed = "image @css_background_image" }

@en "background origin"
@fa "مبدا پس‌زمینه"
pub const css_background_origin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-origin" allowed = "@css_background_origin" }

@en "background position"
@fa "موقعیت پس‌زمینه"
pub const css_background_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-position" allowed = "list length percentage @css_g_pos max4" }

@en "background position x"
@fa "موقعیت افقی پس‌زمینه"
pub const css_background_position_x := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-position-x" allowed = "length percentage @css_background_position_x" }

@en "background position y"
@fa "موقعیت عمودی پس‌زمینه"
pub const css_background_position_y := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-position-y" allowed = "length percentage @css_background_position_y" }

@en "background repeat"
@fa "تکرار پس‌زمینه"
pub const css_background_repeat := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-repeat" allowed = "max2 @css_background_repeat" }

@en "background size"
@fa "اندازه پس‌زمینه"
pub const css_background_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "background-size" allowed = "length percentage max2 @css_background_size" }
