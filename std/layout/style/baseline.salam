package layout

@en "baseline shift"
@fa "جابه‌جایی خط پایه"
pub const css_baseline_shift := LayoutAttribute { destination = "css" value_type = "css" generated_name = "baseline-shift" allowed = "length percentage @css_baseline_shift" }

@en "baseline source"
@fa "منبع خط پایه"
pub const css_baseline_source := LayoutAttribute { destination = "css" value_type = "css" generated_name = "baseline-source" allowed = "@css_baseline_source" }
