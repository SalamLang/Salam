package layout

@en "box decoration break"
@fa "شکستن تزیین جعبه"
pub const css_box_decoration_break := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "box-decoration-break" allowed = "@css_box_decoration_break"
}

@en "box shadow"
@fa "سایه کادر"
pub const css_box_shadow := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "box-shadow" allowed = "list set:@css_g_shadowkw|length*0-4|color"
}

@en "box sizing"
@fa "اندازه جعبه" "اندازه‌گیری جعبه"
pub const css_box_sizing := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "box-sizing" allowed = "@css_box_sizing"
}
