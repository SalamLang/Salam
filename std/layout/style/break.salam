package layout

@en "break after"
@fa "شکستن پس از"
pub const css_break_after := LayoutAttribute { destination = "css" value_type = "css" generated_name = "break-after" allowed = "@css_break_after" }

@en "break before"
@fa "شکستن پیش از"
pub const css_break_before := LayoutAttribute { destination = "css" value_type = "css" generated_name = "break-before" allowed = "@css_break_before" }

@en "break inside"
@fa "شکستن درون"
pub const css_break_inside := LayoutAttribute { destination = "css" value_type = "css" generated_name = "break-inside" allowed = "@css_break_inside" }
