package layout

@en "caret color"
@fa "رنگ نشانگر متن"
pub const css_caret_color := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "caret-color" allowed = "color @css_caret_color"
}

@en "caret animation"
@fa "پویانمایی نشانگر"
pub const css_caret_animation := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "caret-animation" allowed = "@css_caret_animation"
}
