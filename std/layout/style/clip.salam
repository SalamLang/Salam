package layout

@en "clip path"
@fa "مسیر برش"
pub const css_clip_path := LayoutAttribute { destination = "css" value_type = "css" generated_name = "clip-path" allowed = "set:fn=inset,circle,ellipse,polygon,path,rect,xywh,shape,url+@css_g_none|@css_g_shapebox" }

@en "clip rule"
@fa "قاعده برش"
pub const css_clip_rule := LayoutAttribute { destination = "css" value_type = "css" generated_name = "clip-rule" allowed = "@css_clip_rule" }
