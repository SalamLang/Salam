package layout

@en "color"
@fa "رنگ"
pub const css_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "color" allowed = "color" }

@en "color scheme"
@fa "طرح رنگ"
pub const css_color_scheme := LayoutAttribute { destination = "css" value_type = "css" generated_name = "color-scheme" allowed = "max3 @css_color_scheme" }
