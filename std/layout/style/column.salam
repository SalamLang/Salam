package layout

@en "column count"
@fa "تعداد ستون"
pub const css_column_count := LayoutAttribute { destination = "css" value_type = "css" generated_name = "column-count" allowed = "integer @css_column_count" }

@en "column fill"
@fa "پرکردن ستون"
pub const css_column_fill := LayoutAttribute { destination = "css" value_type = "css" generated_name = "column-fill" allowed = "@css_column_fill" }

@en "column gap"
@fa "شکاف ستون"
pub const css_column_gap := LayoutAttribute { destination = "css" value_type = "css" generated_name = "column-gap" allowed = "length percentage @css_column_gap" }

@en "column rule"
@fa "خط جداکننده ستون"
pub const css_column_rule := LayoutAttribute { destination = "css" value_type = "string" generated_name = "column-rule" }

@en "column rule color"
@fa "رنگ خط ستون"
pub const css_column_rule_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "column-rule-color" allowed = "color" }

@en "column rule style"
@fa "سبک خط ستون"
pub const css_column_rule_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "column-rule-style" allowed = "@css_column_rule_style" }

@en "column rule width"
@fa "ضخامت خط ستون"
pub const css_column_rule_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "column-rule-width" allowed = "length @css_column_rule_width" }

@en "column span"
@fa "گستره ستون"
pub const css_column_span := LayoutAttribute { destination = "css" value_type = "css" generated_name = "column-span" allowed = "@css_column_span" }

@en "column width"
@fa "عرض ستون"
pub const css_column_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "column-width" allowed = "length @css_column_width" }
