package layout

@en "contain"
@fa "محدودسازی"
pub const css_contain := LayoutAttribute { destination = "css" value_type = "css" generated_name = "contain" allowed = "max4 @css_contain" }

@en "contain intrinsic block size"
@fa "اندازه ذاتی محدودسازی بلوکی"
pub const css_contain_intrinsic_block_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "contain-intrinsic-block-size" allowed = "length @css_g_cii max2" }

