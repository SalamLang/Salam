@fa "ارتفاع ذاتی محدودسازی"
pub const css_contain_intrinsic_height := LayoutAttribute { destination = "css" value_type = "css" generated_name = "contain-intrinsic-height" allowed = "length @css_g_cii max2" }

@en "contain intrinsic inline size"
@fa "اندازه ذاتی محدودسازی خطی"
pub const css_contain_intrinsic_inline_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "contain-intrinsic-inline-size" allowed = "length @css_g_cii max2" }

@en "contain intrinsic size"
@fa "اندازه ذاتی محدود"
pub const css_contain_intrinsic_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "contain-intrinsic-size" allowed = "length @css_g_cii max4" }

@en "contain intrinsic width"
@fa "عرض ذاتی محدودسازی"
