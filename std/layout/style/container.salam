package layout

@en "container"
@fa "نگهدارنده"
pub const css_container := LayoutAttribute { destination = "css" value_type = "css" generated_name = "container" allowed = "ident @css_g_conttype @css_g_none max4 slash2" }

@en "container name"
@fa "نام نگهدارنده"
pub const css_container_name := LayoutAttribute { destination = "css" value_type = "css" generated_name = "container-name" allowed = "ident max4 @css_container_name" }

@en "container type"
@fa "نوع نگهدارنده"
pub const css_container_type := LayoutAttribute { destination = "css" value_type = "css" generated_name = "container-type" allowed = "@css_container_type" }
