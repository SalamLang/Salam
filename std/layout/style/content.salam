package layout

@en "content visibility"
@fa "دیدپذیری محتوا"
pub const css_content_visibility := LayoutAttribute { destination = "css" value_type = "css" generated_name = "content-visibility" allowed = "@css_content_visibility" }

@en "generated content"
@fa "محتوای تولیدی"
pub const css_content := LayoutAttribute { destination = "css" value_type = "css" generated_name = "content" allowed = "@css_g_contentkw set:string+image+fn=counter,counters,attr+@css_g_quotekw*1-99|/string+fn=counter,counters,attr*1-9" }
