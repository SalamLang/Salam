package layout

@en "fill"
@fa "پرکردن"
pub const css_fill := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "fill" allowed = "color @css_fill"
}

@en "fill opacity"
@fa "شفافیت پرکردن"
pub const css_fill_opacity := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "fill-opacity" allowed = "number percentage"
}

@en "fill rule"
@fa "قاعده پرکردن"
pub const css_fill_rule := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "fill-rule" allowed = "@css_fill_rule"
}
