package layout

@en "filter"
@fa "پالایه"
pub const css_filter := LayoutAttribute { destination = "css" value_type = "css" generated_name = "filter" allowed = "fn=blur,brightness,contrast,drop-shadow,grayscale,hue-rotate,invert,opacity,saturate,sepia,url @css_g_none max99" }
