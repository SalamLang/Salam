package layout

@en "flex"
@fa "فلکس"
pub const css_flex := LayoutAttribute { destination = "css" value_type = "string" generated_name = "flex" }

@en "flex basis"
@fa "پایه فلکس"
pub const css_flex_basis := LayoutAttribute { destination = "css" value_type = "css" generated_name = "flex-basis" allowed = "length percentage @css_flex_basis" }

@en "flex direction"
@fa "جهت فلکس"
pub const css_flex_direction := LayoutAttribute { destination = "css" value_type = "css" generated_name = "flex-direction" allowed = "@css_flex_direction" }

@en "flex flow"
@fa "جریان فلکس"
pub const css_flex_flow := LayoutAttribute { destination = "css" value_type = "string" generated_name = "flex-flow" }

@en "flex grow"
@fa "رشد فلکس"
pub const css_flex_grow := LayoutAttribute { destination = "css" value_type = "css" generated_name = "flex-grow" allowed = "number" }

@en "flex shrink"
@fa "جمع‌شدن فلکس"
pub const css_flex_shrink := LayoutAttribute { destination = "css" value_type = "css" generated_name = "flex-shrink" allowed = "number" }

@en "flex wrap"
@fa "پیچش آرایش" "پیچش فلکس"
pub const css_flex_wrap := LayoutAttribute { destination = "css" value_type = "css" generated_name = "flex-wrap" allowed = "@css_flex_wrap" }
