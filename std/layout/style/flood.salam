package layout

@en "flood color"
@fa "رنگ سیل"
pub const css_flood_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "flood-color" allowed = "color" }

@en "flood opacity"
@fa "شفافیت سیل"
pub const css_flood_opacity := LayoutAttribute { destination = "css" value_type = "css" generated_name = "flood-opacity" allowed = "number percentage" }
