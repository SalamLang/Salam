package layout

@en "font"
@fa "قلم"
pub const css_font := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font" }

@en "font family"
@fa "خانواده قلم"
pub const css_font_family := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font-family" }

@en "font feature settings"
@fa "تنظیمات ویژگی قلم"
pub const css_font_feature_settings := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font-feature-settings" }

@en "font kerning"
@fa "فاصله‌گذاری قلم"
pub const css_font_kerning := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-kerning" allowed = "@css_font_kerning" }

@en "font optical sizing"
@fa "اندازه بصری قلم"
pub const css_font_optical_sizing := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-optical-sizing" allowed = "@css_font_optical_sizing" }

@en "font size"
@fa "اندازه قلم"
pub const css_font_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-size" allowed = "length percentage @css_font_size" }

@en "font size adjust"
@fa "تنظیم اندازه قلم"
pub const css_font_size_adjust := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-size-adjust" allowed = "number @css_font_size_adjust" }

@en "font stretch"
@fa "کشیدگی قلم"
pub const css_font_stretch := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-stretch" allowed = "percentage @css_font_stretch" }

@en "font style"
@fa "سبک قلم"
pub const css_font_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-style" allowed = "@css_font_style" }

@en "font synthesis"
@fa "ساخت قلم"
pub const css_font_synthesis := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font-synthesis" }

@en "font variant"
@fa "نسخه قلم"
pub const css_font_variant := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font-variant" }

@en "font variant caps"
@fa "حروف بزرگ قلم"
pub const css_font_variant_caps := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant-caps" allowed = "@css_font_variant_caps" }

@en "font variant east asian"
@fa "آسیایی شرق نسخه قلم"
pub const css_font_variant_east_asian := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font-variant-east-asian" }

@en "font variant ligatures"
@fa "پیوندها نسخه قلم"
pub const css_font_variant_ligatures := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font-variant-ligatures" }

@en "font variant numeric"
@fa "عددی نسخه قلم"
pub const css_font_variant_numeric := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font-variant-numeric" }

@en "font variation settings"
@fa "تنظیمات تغییر قلم"
pub const css_font_variation_settings := LayoutAttribute { destination = "css" value_type = "string" generated_name = "font-variation-settings" }

@en "font weight"
@fa "وزن قلم"
pub const css_font_weight := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-weight" allowed = "number @css_font_weight" }
