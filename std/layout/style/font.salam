package layout

@en "font"
@fa "قلم"
pub const css_font := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font" allowed = "font" }

@en "font family"
@fa "خانواده قلم"
pub const css_font_family := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-family" allowed = "list set:string|ident+integer+@css_g_genfamily*0-9" }

@en "font feature settings"
@fa "تنظیمات ویژگی قلم"
pub const css_font_feature_settings := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-feature-settings" allowed = "list set:string|integer+@css_g_onoff|@css_g_normal" }

@en "font kerning"
@fa "فاصله‌گذاری قلم"
pub const css_font_kerning := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-kerning" allowed = "@css_font_kerning" }

@en "font optical sizing"
@fa "اندازه بصری قلم"
pub const css_font_optical_sizing := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-optical-sizing" allowed = "@css_font_optical_sizing" }

@en "font size"
@fa "اندازه قلم"
pub const css_font_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-size" allowed = "length percentage @css_font_size" }

@en "font size adjust"
@fa "تنظیم اندازه قلم"
pub const css_font_size_adjust := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-size-adjust" allowed = "number @css_font_size_adjust" }

@en "font stretch"
@fa "کشیدگی قلم"
pub const css_font_stretch := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-stretch" allowed = "percentage @css_font_stretch" }

@en "font style"
@fa "سبک قلم"
pub const css_font_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-style" allowed = "@css_font_style" }

@en "font synthesis"
@fa "ساخت قلم"
pub const css_font_synthesis := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-synthesis" allowed = "@css_g_fontsynth max4" }

@en "font variant"
@fa "نسخه قلم"
pub const css_font_variant := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant" allowed = "@css_g_fontvariant max99" }

@en "font variant caps"
@fa "حروف بزرگ قلم"
pub const css_font_variant_caps := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant-caps" allowed = "@css_font_variant_caps" }

@en "font variant east asian"
@fa "آسیایی شرق نسخه قلم"
pub const css_font_variant_east_asian := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant-east-asian" allowed = "@css_g_eastasian max3" }

@en "font variant ligatures"
@fa "پیوندها نسخه قلم"
pub const css_font_variant_ligatures := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant-ligatures" allowed = "@css_g_ligatures max4" }

@en "font variant numeric"
@fa "عددی نسخه قلم"
pub const css_font_variant_numeric := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant-numeric" allowed = "@css_g_numeric max5" }

@en "font variation settings"
@fa "تنظیمات تغییر قلم"
pub const css_font_variation_settings := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variation-settings" allowed = "list set:string|number|@css_g_normal" }

@en "font weight"
@fa "وزن قلم"
pub const css_font_weight := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-weight" allowed = "number @css_font_weight" }

@en "font palette"
@fa "پالت قلم"
pub const css_font_palette := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-palette" allowed = "@css_font_palette ident fn=palette-mix" }

@en "font variant alternates"
@fa "جایگزین های نسخه قلم"
pub const css_font_variant_alternates := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant-alternates" allowed = "max9 @css_g_fvalt fn=stylistic,styleset,character-variant,swash,ornaments,annotation" }

@en "font variant position"
@fa "جایگاه نسخه قلم"
pub const css_font_variant_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant-position" allowed = "@css_font_variant_position" }

@en "font variant emoji"
@fa "گونه شکلک قلم"
pub const css_font_variant_emoji := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-variant-emoji" allowed = "@css_font_variant_emoji" }

@en "font synthesis weight"
@fa "ساخت وزن قلم"
pub const css_font_synthesis_weight := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-synthesis-weight" allowed = "@css_font_synthesis_weight" }

@en "font synthesis style"
@fa "ساخت سبک قلم"
pub const css_font_synthesis_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-synthesis-style" allowed = "@css_font_synthesis_style" }

@en "font synthesis small caps"
@fa "ساخت حروف کوچک قلم"
pub const css_font_synthesis_small_caps := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-synthesis-small-caps" allowed = "@css_font_synthesis_small_caps" }

@en "font synthesis position"
@fa "ساخت جایگاه قلم"
pub const css_font_synthesis_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-synthesis-position" allowed = "@css_font_synthesis_position" }

@en "font language override"
@fa "جایگزینی زبان قلم"
pub const css_font_language_override := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-language-override" allowed = "string @css_g_normal" }

@en "font width"
@fa "پهنای قلم"
pub const css_font_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "font-width" allowed = "percentage @css_g_fontstretch" }
