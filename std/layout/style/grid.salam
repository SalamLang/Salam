package layout

@en "grid"
@fa "شبکه"
pub const css_grid := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid" }

@en "grid area"
@fa "ناحیه شبکه"
pub const css_grid_area := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid-area" }

@en "grid auto columns"
@fa "ستون‌های خودکار شبکه"
pub const css_grid_auto_columns := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid-auto-columns" }

@en "grid auto flow"
@fa "جریان خودکار شبکه"
pub const css_grid_auto_flow := LayoutAttribute { destination = "css" value_type = "css" generated_name = "grid-auto-flow" allowed = "max2 @css_grid_auto_flow" }

@en "grid auto rows"
@fa "ردیف‌های خودکار شبکه"
pub const css_grid_auto_rows := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid-auto-rows" }

@en "grid column"
@fa "ستون شبکه"
pub const css_grid_column := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid-column" }

@en "grid column end"
@fa "انتهای ستون شبکه"
pub const css_grid_column_end := LayoutAttribute { destination = "css" value_type = "css" generated_name = "grid-column-end" allowed = "integer ident max2 @css_grid_column_end" }

@en "grid column start"
@fa "آغاز ستون شبکه"
pub const css_grid_column_start := LayoutAttribute { destination = "css" value_type = "css" generated_name = "grid-column-start" allowed = "integer ident max2 @css_grid_column_start" }

@en "grid row"
@fa "ردیف شبکه"
pub const css_grid_row := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid-row" }

@en "grid row end"
@fa "انتهای ردیف شبکه"
pub const css_grid_row_end := LayoutAttribute { destination = "css" value_type = "css" generated_name = "grid-row-end" allowed = "integer ident max2 @css_grid_row_end" }

@en "grid row start"
@fa "آغاز ردیف شبکه"
pub const css_grid_row_start := LayoutAttribute { destination = "css" value_type = "css" generated_name = "grid-row-start" allowed = "integer ident max2 @css_grid_row_start" }

@en "grid template"
@fa "الگو شبکه"
pub const css_grid_template := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid-template" }

@en "grid template areas"
@fa "نواحی الگو شبکه"
pub const css_grid_template_areas := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid-template-areas" }

@en "grid template columns"
@fa "ستون های شبکه" "ستون‌ها الگو شبکه"
pub const css_grid_template_columns := LayoutAttribute { destination = "css" value_type = "string" generated_name = "grid-template-columns" }

@en "grid template rows"
