package layout

@en "hyphenate character"
@fa "نویسه خط تیره"
pub const css_hyphenate_character := LayoutAttribute { destination = "css" value_type = "css" generated_name = "hyphenate-character" allowed = "string @css_hyphenate_character" }

@en "hyphenate limit chars"
@fa "حد نویسه خط تیره"
pub const css_hyphenate_limit_chars := LayoutAttribute { destination = "css" value_type = "css" generated_name = "hyphenate-limit-chars" allowed = "integer @css_g_auto max3" }
