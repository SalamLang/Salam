package layout

@en "image orientation"
@fa "جهت‌گیری تصویر"
pub const css_image_orientation := LayoutAttribute { destination = "css" value_type = "css" generated_name = "image-orientation" allowed = "@css_image_orientation" }

@en "image rendering"
@fa "نمایش تصویر"
pub const css_image_rendering := LayoutAttribute { destination = "css" value_type = "css" generated_name = "image-rendering" allowed = "@css_image_rendering" }
