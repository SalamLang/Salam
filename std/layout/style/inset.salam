package layout

@en "inset"
@fa "فاصله از لبه"
pub const css_inset := LayoutAttribute { destination = "css" value_type = "css" generated_name = "inset" allowed = "length percentage max4 @css_inset" }

@en "inset block"
@fa "فاصله از لبه بلوکی"
pub const css_inset_block := LayoutAttribute { destination = "css" value_type = "css" generated_name = "inset-block" allowed = "length percentage max2 @css_inset_block" }

@en "inset block end"
@fa "فاصله از لبه بلوکی انتها"
pub const css_inset_block_end := LayoutAttribute { destination = "css" value_type = "css" generated_name = "inset-block-end" allowed = "length percentage @css_inset_block_end" }

@en "inset block start"
@fa "فاصله از لبه بلوکی آغاز"
pub const css_inset_block_start := LayoutAttribute { destination = "css" value_type = "css" generated_name = "inset-block-start" allowed = "length percentage @css_inset_block_start" }

@en "inset inline"
@fa "فاصله از لبه خطی"
pub const css_inset_inline := LayoutAttribute { destination = "css" value_type = "css" generated_name = "inset-inline" allowed = "length percentage max2 @css_inset_inline" }

@en "inset inline end"
@fa "فاصله از لبه خطی انتها"
pub const css_inset_inline_end := LayoutAttribute { destination = "css" value_type = "css" generated_name = "inset-inline-end" allowed = "length percentage @css_inset_inline_end" }

@en "inset inline start"
@fa "فاصله از لبه خطی آغاز"
pub const css_inset_inline_start := LayoutAttribute { destination = "css" value_type = "css" generated_name = "inset-inline-start" allowed = "length percentage @css_inset_inline_start" }
