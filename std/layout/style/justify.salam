package layout

@en "justify content"
@fa "محتوا چینش"
pub const css_justify_content := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "justify-content" allowed = "@css_justify_content"
}

@en "justify items"
@fa "موارد چینش"
pub const css_justify_items := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "justify-items" allowed = "@css_justify_items"
}

@en "justify self"
@fa "خود چینش"
pub const css_justify_self := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "justify-self" allowed = "@css_justify_self"
}
