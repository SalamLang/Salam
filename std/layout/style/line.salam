package layout

@en "line break"
@fa "قاعده شکستن خط"
pub const css_line_break := LayoutAttribute { destination = "css" value_type = "css" generated_name = "line-break" allowed = "@css_line_break" }

@en "line clamp"
@fa "محدود کردن سطرها"
pub const css_line_clamp := LayoutAttribute { destination = "css" value_type = "css" generated_name = "line-clamp" allowed = "integer @css_line_clamp" }

@en "line height"
@fa "ارتفاع خط"
pub const css_line_height := LayoutAttribute { destination = "css" value_type = "css" generated_name = "line-height" allowed = "number length percentage @css_line_height" }
