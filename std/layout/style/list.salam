package layout

@en "list style"
@fa "سبک فهرست"
pub const css_list_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "list-style" allowed = "set:string+@css_g_lstype|@css_g_lspos|image+@css_g_none" }

@en "list style image"
@fa "تصویر نشانه فهرست"
pub const css_list_style_image := LayoutAttribute { destination = "css" value_type = "css" generated_name = "list-style-image" allowed = "image @css_list_style_image" }

@en "list style position"
@fa "جای نشانه فهرست"
pub const css_list_style_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "list-style-position" allowed = "@css_list_style_position" }

@en "list style type"
@fa "نوع نشانه فهرست"
pub const css_list_style_type := LayoutAttribute { destination = "css" value_type = "css" generated_name = "list-style-type" allowed = "string @css_list_style_type" }
