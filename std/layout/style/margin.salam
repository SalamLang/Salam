package layout

@en "margin"
@fa "حاشیه"
pub const css_margin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "margin" allowed = "length percentage max4 @css_margin" }

@en "margin block"
@fa "حاشیه بلوکی"
pub const css_margin_block := LayoutAttribute { destination = "css" value_type = "css" generated_name = "margin-block" allowed = "length percentage max2 @css_margin_block" }

