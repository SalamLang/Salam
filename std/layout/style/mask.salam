package layout

@en "mask"
@fa "ماسک"
pub const css_mask := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask" allowed = "list set:image+@css_g_none|length+percentage+@css_g_pos*0-4|/length+percentage+@css_g_bgsize*1-2|@css_g_bgrep*0-2|@css_g_maskbox*0-2|@css_g_maskcomp|@css_g_maskmode" }

@en "mask clip"
@fa "برش ماسک"
pub const css_mask_clip := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-clip" allowed = "list @css_mask_clip" }

@en "mask composite"
@fa "ترکیب ماسک"
pub const css_mask_composite := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-composite" allowed = "list @css_mask_composite" }

@en "mask image"
@fa "تصویر ماسک"
pub const css_mask_image := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-image" allowed = "list image @css_mask_image" }

@en "mask mode"
@fa "حالت ماسک"
pub const css_mask_mode := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-mode" allowed = "list @css_mask_mode" }

@en "mask origin"
@fa "مبدا ماسک"
pub const css_mask_origin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-origin" allowed = "list @css_mask_origin" }

@en "mask position"
@fa "موقعیت ماسک"
pub const css_mask_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-position" allowed = "list length percentage @css_g_pos max4" }

@en "mask repeat"
@fa "تکرار ماسک"
pub const css_mask_repeat := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-repeat" allowed = "list max2 @css_mask_repeat" }

@en "mask size"
@fa "اندازه ماسک"
pub const css_mask_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-size" allowed = "list length percentage max2 @css_mask_size" }

@en "mask type"
@fa "نوع ماسک"
pub const css_mask_type := LayoutAttribute { destination = "css" value_type = "css" generated_name = "mask-type" allowed = "@css_mask_type" }
