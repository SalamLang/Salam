package layout

@en "math depth"
@fa "عمق ریاضی"
pub const css_math_depth := LayoutAttribute { destination = "css" value_type = "css" generated_name = "math-depth" allowed = "integer @css_math_depth" }

@en "math style"
@fa "سبک ریاضی"
pub const css_math_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "math-style" allowed = "@css_math_style" }
