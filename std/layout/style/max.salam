package layout

@en "max block size"
@fa "بیشینه اندازه بلوکی"
pub const css_max_block_size := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "max-block-size" allowed = "length percentage @css_max_block_size"
}

@en "max height"
@fa "بیشینه ارتفاع"
pub const css_max_height := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "max-height" allowed = "length percentage @css_max_height"
}

