package layout

@en "max block size"
@fa "بیشینه اندازه بلوکی"
pub const css_max_block_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "max-block-size" allowed = "length percentage @css_max_block_size" }

@en "max height"
@fa "بیشینه ارتفاع"
pub const css_max_height := LayoutAttribute { destination = "css" value_type = "css" generated_name = "max-height" allowed = "length percentage @css_max_height" }

@en "max inline size"
@fa "بیشینه اندازه خطی"
pub const css_max_inline_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "max-inline-size" allowed = "length percentage @css_max_inline_size" }

@en "max width"
@fa "بیشینه عرض"
pub const css_max_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "max-width" allowed = "length percentage @css_max_width" }
