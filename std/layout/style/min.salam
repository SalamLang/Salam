package layout

@en "min block size"
@fa "کمینه اندازه بلوکی"
pub const css_min_block_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "min-block-size" allowed = "length percentage @css_min_block_size" }

@en "min height"
@fa "کمینه ارتفاع"
pub const css_min_height := LayoutAttribute { destination = "css" value_type = "css" generated_name = "min-height" allowed = "length percentage @css_min_height" }

@en "min inline size"
@fa "کمینه اندازه خطی"
pub const css_min_inline_size := LayoutAttribute { destination = "css" value_type = "css" generated_name = "min-inline-size" allowed = "length percentage @css_min_inline_size" }

@en "min width"
@fa "کمینه عرض"
pub const css_min_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "min-width" allowed = "length percentage @css_min_width" }
