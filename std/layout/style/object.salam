package layout

@en "object fit"
@fa "جاگیری شیء"
pub const css_object_fit := LayoutAttribute { destination = "css" value_type = "css" generated_name = "object-fit" allowed = "@css_object_fit" }

@en "object position"
@fa "موقعیت شیء"
pub const css_object_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "object-position" allowed = "length percentage @css_g_pos max4" }

@en "object view box"
@fa "جعبه دید شیء"
pub const css_object_view_box := LayoutAttribute { destination = "css" value_type = "css" generated_name = "object-view-box" allowed = "fn=inset,xywh,rect @css_g_none" }
