package layout

@en "offset"
@fa "فاصله"
pub const css_offset := LayoutAttribute { destination = "css" value_type = "string" generated_name = "offset" }

@en "offset anchor"
@fa "لنگر فاصله"
pub const css_offset_anchor := LayoutAttribute { destination = "css" value_type = "string" generated_name = "offset-anchor" }

@en "offset distance"
@fa "فاصله مسیر"
pub const css_offset_distance := LayoutAttribute { destination = "css" value_type = "css" generated_name = "offset-distance" allowed = "length percentage" }

@en "offset path"
@fa "مسیر فاصله"
pub const css_offset_path := LayoutAttribute { destination = "css" value_type = "string" generated_name = "offset-path" }

@en "offset position"
@fa "موقعیت فاصله"
pub const css_offset_position := LayoutAttribute { destination = "css" value_type = "string" generated_name = "offset-position" }

@en "offset rotate"
@fa "چرخش مسیر"
pub const css_offset_rotate := LayoutAttribute { destination = "css" value_type = "string" generated_name = "offset-rotate" }
