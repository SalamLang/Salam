package layout

@en "offset"
@fa "فاصله"
pub const css_offset := LayoutAttribute { destination = "css" value_type = "css" generated_name = "offset" allowed = "slash2 length percentage angle fn=inset,circle,ellipse,polygon,path,rect,xywh,shape,ray,url @css_g_shapebox @css_g_pos @css_g_offrot @css_g_autonone max9" }

@en "offset anchor"
@fa "لنگر فاصله"
pub const css_offset_anchor := LayoutAttribute { destination = "css" value_type = "css" generated_name = "offset-anchor" allowed = "length percentage @css_g_pos @css_g_auto max4" }

@en "offset distance"
@fa "فاصله مسیر"
pub const css_offset_distance := LayoutAttribute { destination = "css" value_type = "css" generated_name = "offset-distance" allowed = "length percentage" }

@en "offset path"
@fa "مسیر فاصله"
pub const css_offset_path := LayoutAttribute { destination = "css" value_type = "css" generated_name = "offset-path" allowed = "fn=inset,circle,ellipse,polygon,path,rect,xywh,shape,ray,url @css_g_shapebox @css_g_none max2" }

@en "offset position"
@fa "موقعیت فاصله"
pub const css_offset_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "offset-position" allowed = "length percentage @css_g_pos @css_g_autonone max4" }

@en "offset rotate"
@fa "چرخش مسیر"
pub const css_offset_rotate := LayoutAttribute { destination = "css" value_type = "css" generated_name = "offset-rotate" allowed = "angle @css_g_offrot max2" }
