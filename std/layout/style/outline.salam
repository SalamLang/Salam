package layout

@en "outline"
@fa "دورخط"
pub const css_outline := LayoutAttribute { destination = "css" value_type = "string" generated_name = "outline" }

@en "outline color"
@fa "رنگ دورخط"
pub const css_outline_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "outline-color" allowed = "color" }

@en "outline offset"
@fa "فاصله دورخط"
pub const css_outline_offset := LayoutAttribute { destination = "css" value_type = "css" generated_name = "outline-offset" allowed = "length" }

@en "outline style"
@fa "سبک دورخط"
pub const css_outline_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "outline-style" allowed = "@css_outline_style" }

@en "outline width"
@fa "ضخامت دورخط"
pub const css_outline_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "outline-width" allowed = "length @css_outline_width" }
