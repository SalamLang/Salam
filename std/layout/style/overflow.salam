package layout

@en "overflow"
@fa "سرریز"
pub const css_overflow := LayoutAttribute { destination = "css" value_type = "css" generated_name = "overflow" allowed = "max2 @css_overflow" }

@en "overflow anchor"
@fa "لنگر سرریز"
pub const css_overflow_anchor := LayoutAttribute { destination = "css" value_type = "css" generated_name = "overflow-anchor" allowed = "@css_g_autonone" }

@en "overflow block"
@fa "سرریز بلوکی"
pub const css_overflow_block := LayoutAttribute { destination = "css" value_type = "css" generated_name = "overflow-block" allowed = "@css_overflow_block" }

@en "overflow clip margin"
@fa "حاشیه برش سرریز"
pub const css_overflow_clip_margin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "overflow-clip-margin" allowed = "set:@css_g_ocm|length" }

@en "overflow inline"
@fa "سرریز خطی"
pub const css_overflow_inline := LayoutAttribute { destination = "css" value_type = "css" generated_name = "overflow-inline" allowed = "@css_overflow_inline" }

@en "overflow wrap"
@fa "شکستن سرریز"
pub const css_overflow_wrap := LayoutAttribute { destination = "css" value_type = "css" generated_name = "overflow-wrap" allowed = "@css_overflow_wrap" }

@en "overflow x"
@fa "سرریز افقی"
pub const css_overflow_x := LayoutAttribute { destination = "css" value_type = "css" generated_name = "overflow-x" allowed = "@css_overflow_x" }

@en "overflow y"
@fa "سرریز عمودی"
pub const css_overflow_y := LayoutAttribute { destination = "css" value_type = "css" generated_name = "overflow-y" allowed = "@css_overflow_y" }
