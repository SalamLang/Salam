package layout

@en "page break after"
@fa "شکستن صفحه پس از"
pub const css_page_break_after := LayoutAttribute { destination = "css" value_type = "css" generated_name = "page-break-after" allowed = "@css_page_break_after" }

@en "page break before"
@fa "شکستن صفحه پیش از"
pub const css_page_break_before := LayoutAttribute { destination = "css" value_type = "css" generated_name = "page-break-before" allowed = "@css_page_break_before" }

@en "page break inside"
@fa "شکستن صفحه درون"
pub const css_page_break_inside := LayoutAttribute { destination = "css" value_type = "css" generated_name = "page-break-inside" allowed = "@css_page_break_inside" }

@en "page"
@fa "برگه"
pub const css_page := LayoutAttribute { destination = "css" value_type = "css" generated_name = "page" allowed = "ident @css_g_auto" }
