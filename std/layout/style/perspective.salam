package layout

@en "perspective"
@fa "پرسپکتیو"
pub const css_perspective := LayoutAttribute { destination = "css" value_type = "css" generated_name = "perspective" allowed = "length @css_perspective" }

@en "perspective origin"
@fa "مبدا پرسپکتیو"
pub const css_perspective_origin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "perspective-origin" allowed = "length percentage @css_g_pos max4" }
