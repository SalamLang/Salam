package layout

@en "place content"
@fa "محتوا جای‌گذاری"
pub const css_place_content := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "place-content" allowed = "max2 @css_place_content"
}

@en "place items"
@fa "موارد جای‌گذاری"
pub const css_place_items := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "place-items" allowed = "max2 @css_place_items"
}

@en "place self"
@fa "خود جای‌گذاری"
pub const css_place_self := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "place-self" allowed = "max2 @css_place_self"
}
