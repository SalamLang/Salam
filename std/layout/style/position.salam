package layout

@en "position"
@fa "موقعیت"
pub const css_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "position" allowed = "@css_position" }

@en "position anchor"
@fa "لنگر جایگاه"
pub const css_position_anchor := LayoutAttribute { destination = "css" value_type = "css" generated_name = "position-anchor" allowed = "dashed @css_g_auto" }

@en "position area"
@fa "ناحیه جایگاه"
pub const css_position_area := LayoutAttribute { destination = "css" value_type = "css" generated_name = "position-area" allowed = "max2 @css_g_posarea" }

@en "position try fallbacks"
@fa "جایگزین های جایگاه"
pub const css_position_try_fallbacks := LayoutAttribute { destination = "css" value_type = "css" generated_name = "position-try-fallbacks" allowed = "list set:dashed|@css_g_trytactic*0-3|@css_g_posarea*0-2" }

@en "position try order"
@fa "ترتیب تلاش جایگاه"
pub const css_position_try_order := LayoutAttribute { destination = "css" value_type = "css" generated_name = "position-try-order" allowed = "@css_g_tryorder" }

@en "position try"
@fa "تلاش جایگاه"
pub const css_position_try := LayoutAttribute { destination = "css" value_type = "css" generated_name = "position-try" allowed = "list set:@css_g_tryorder|dashed|@css_g_trytactic*0-3|@css_g_posarea*0-2" }

@en "position visibility"
@fa "پیدایی جایگاه"
pub const css_position_visibility := LayoutAttribute { destination = "css" value_type = "css" generated_name = "position-visibility" allowed = "max2 @css_g_posvis" }
