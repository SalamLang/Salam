package layout

@en "reading flow"
@fa "جریان خواندن"
pub const css_reading_flow := LayoutAttribute { destination = "css" value_type = "css" generated_name = "reading-flow" allowed = "@css_reading_flow" }

@en "reading order"
@fa "ترتیب خواندن"
pub const css_reading_order := LayoutAttribute { destination = "css" value_type = "css" generated_name = "reading-order" allowed = "integer" }
