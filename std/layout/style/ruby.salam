package layout

@en "ruby align"
@fa "تراز روبی"
pub const css_ruby_align := LayoutAttribute { destination = "css" value_type = "css" generated_name = "ruby-align" allowed = "@css_ruby_align" }

@en "ruby position"
@fa "جای روبی"
pub const css_ruby_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "ruby-position" allowed = "max2 @css_ruby_position" }
