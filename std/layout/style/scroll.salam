package layout

@en "scroll behavior"
@fa "رفتار پیمایش"
pub const css_scroll_behavior := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-behavior" allowed = "@css_scroll_behavior" }

@en "scroll margin"
@fa "حاشیه پیمایش"
pub const css_scroll_margin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin" allowed = "length max4" }

@en "scroll margin block"
@fa "حاشیه پیمایش بلوکی"
pub const css_scroll_margin_block := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-block" allowed = "length max2" }

@en "scroll margin block end"
@fa "حاشیه پیمایش بلوکی انتها"
pub const css_scroll_margin_block_end := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-block-end" allowed = "length" }

@en "scroll margin block start"
@fa "حاشیه پیمایش بلوکی آغاز"
pub const css_scroll_margin_block_start := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-block-start" allowed = "length" }

@en "scroll margin bottom"
@fa "حاشیه پیمایش پایین"
pub const css_scroll_margin_bottom := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-bottom" allowed = "length" }

@en "scroll margin inline"
@fa "حاشیه پیمایش خطی"
pub const css_scroll_margin_inline := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-inline" allowed = "length max2" }

@en "scroll margin inline end"
@fa "حاشیه پیمایش خطی انتها"
pub const css_scroll_margin_inline_end := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-inline-end" allowed = "length" }

@en "scroll margin inline start"
@fa "حاشیه پیمایش خطی آغاز"
pub const css_scroll_margin_inline_start := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-inline-start" allowed = "length" }

@en "scroll margin left"
@fa "حاشیه پیمایش چپ"
pub const css_scroll_margin_left := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-left" allowed = "length" }

@en "scroll margin right"
@fa "حاشیه پیمایش راست"
pub const css_scroll_margin_right := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-right" allowed = "length" }

@en "scroll margin top"
@fa "حاشیه پیمایش بالا"
pub const css_scroll_margin_top := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-margin-top" allowed = "length" }

@en "scroll padding"
@fa "فاصله داخلی پیمایش"
pub const css_scroll_padding := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding" allowed = "length percentage max4 @css_scroll_padding" }

@en "scroll padding block"
@fa "فاصله داخلی پیمایش بلوکی"
pub const css_scroll_padding_block := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-block" allowed = "length percentage max2 @css_scroll_padding_block" }

@en "scroll padding block end"
@fa "فاصله داخلی پیمایش بلوکی انتها"
pub const css_scroll_padding_block_end := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-block-end" allowed = "length percentage @css_scroll_padding_block_end" }

@en "scroll padding block start"
@fa "فاصله داخلی پیمایش بلوکی آغاز"
pub const css_scroll_padding_block_start := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-block-start" allowed = "length percentage @css_scroll_padding_block_start" }

@en "scroll padding bottom"
@fa "فاصله داخلی پیمایش پایین"
pub const css_scroll_padding_bottom := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-bottom" allowed = "length percentage @css_scroll_padding_bottom" }

@en "scroll padding inline"
@fa "فاصله داخلی پیمایش خطی"
pub const css_scroll_padding_inline := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-inline" allowed = "length percentage max2 @css_scroll_padding_inline" }

@en "scroll padding inline end"
@fa "فاصله داخلی پیمایش خطی انتها"
pub const css_scroll_padding_inline_end := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-inline-end" allowed = "length percentage @css_scroll_padding_inline_end" }

@en "scroll padding inline start"
@fa "فاصله داخلی پیمایش خطی آغاز"
pub const css_scroll_padding_inline_start := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-inline-start" allowed = "length percentage @css_scroll_padding_inline_start" }

@en "scroll padding left"
@fa "فاصله داخلی پیمایش چپ"
pub const css_scroll_padding_left := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-left" allowed = "length percentage @css_scroll_padding_left" }

@en "scroll padding right"
@fa "فاصله داخلی پیمایش راست"
pub const css_scroll_padding_right := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-right" allowed = "length percentage @css_scroll_padding_right" }

@en "scroll padding top"
@fa "فاصله داخلی پیمایش بالا"
pub const css_scroll_padding_top := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-padding-top" allowed = "length percentage @css_scroll_padding_top" }

@en "scroll snap align"
@fa "تراز چسبیدن پیمایش"
pub const css_scroll_snap_align := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-snap-align" allowed = "max2 @css_scroll_snap_align" }

@en "scroll snap stop"
@fa "توقف چسبیدن پیمایش"
pub const css_scroll_snap_stop := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-snap-stop" allowed = "@css_scroll_snap_stop" }

@en "scroll snap type"
@fa "نوع چسبیدن پیمایش"
pub const css_scroll_snap_type := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-snap-type" allowed = "set:@css_g_snapaxis|@css_g_snapstrict" }

@en "scroll timeline"
@fa "خط زمان پیمایش"
pub const css_scroll_timeline := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-timeline" allowed = "list set:dashed*1|@css_g_tlaxis" }

@en "scroll timeline name"
@fa "نام خط زمان پیمایش"
pub const css_scroll_timeline_name := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-timeline-name" allowed = "list dashed @css_g_none" }

@en "scroll timeline axis"
@fa "محور خط زمان پیمایش"
pub const css_scroll_timeline_axis := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-timeline-axis" allowed = "list @css_g_tlaxis" }

@en "scroll marker group"
@fa "گروه نشانگر پیمایش"
pub const css_scroll_marker_group := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-marker-group" allowed = "@css_scroll_marker_group" }

@en "scroll target group"
@fa "گروه هدف پیمایش"
pub const css_scroll_target_group := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scroll-target-group" allowed = "@css_g_autonone" }
