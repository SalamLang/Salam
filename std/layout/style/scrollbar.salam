package layout

@en "scrollbar color"
@fa "رنگ نوار پیمایش"
pub const css_scrollbar_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scrollbar-color" allowed = "color max2 @css_scrollbar_color" }

@en "scrollbar gutter"
@fa "حاشیه نوار پیمایش"
pub const css_scrollbar_gutter := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scrollbar-gutter" allowed = "max2 @css_scrollbar_gutter" }

@en "scrollbar width"
@fa "عرض نوار پیمایش"
pub const css_scrollbar_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "scrollbar-width" allowed = "@css_scrollbar_width" }
