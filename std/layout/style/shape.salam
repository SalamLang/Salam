package layout

@en "shape image threshold"
@fa "آستانه تصویر شکل"
pub const css_shape_image_threshold := LayoutAttribute { destination = "css" value_type = "css" generated_name = "shape-image-threshold" allowed = "number percentage" }

@en "shape margin"
@fa "حاشیه شکل"
pub const css_shape_margin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "shape-margin" allowed = "length percentage" }

@en "shape outside"
@fa "بیرونی شکل"
pub const css_shape_outside := LayoutAttribute { destination = "css" value_type = "string" generated_name = "shape-outside" }
