package layout

@en "shape image threshold"
@fa "آستانه تصویر شکل"
pub const css_shape_image_threshold := LayoutAttribute { destination = "css" value_type = "css" generated_name = "shape-image-threshold" allowed = "number percentage" }

@en "shape margin"
@fa "فضا شکل" "حاشیه شکل"
pub const css_shape_margin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "shape-margin" allowed = "length percentage" }

@en "shape outside"
@fa "بیرونی شکل"
pub const css_shape_outside := LayoutAttribute { destination = "css" value_type = "css" generated_name = "shape-outside" allowed = "set:fn=inset,circle,ellipse,polygon,path,rect,xywh,shape+image+@css_g_none|@css_g_shapebox" }

@en "shape rendering"
@fa "پرداخت شکل"
pub const css_shape_rendering := LayoutAttribute { destination = "css" value_type = "css" generated_name = "shape-rendering" allowed = "@css_shape_rendering" }
