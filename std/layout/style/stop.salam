package layout

@en "stop color"
@fa "رنگ ایست"
pub const css_stop_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stop-color" allowed = "color" }

@en "stop opacity"
@fa "شفافیت ایست"
pub const css_stop_opacity := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stop-opacity" allowed = "number percentage" }
