package layout

@en "stroke"
@fa "خط دور"
pub const css_stroke := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stroke" allowed = "color @css_stroke" }

@en "stroke dasharray"
@fa "الگوی خط‌چین خط دور"
pub const css_stroke_dasharray := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stroke-dasharray" allowed = "list length percentage number @css_g_none max99" }

@en "stroke dashoffset"
@fa "فاصله خط‌چین"
pub const css_stroke_dashoffset := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stroke-dashoffset" allowed = "length percentage" }

@en "stroke linecap"
@fa "سر خط دور"
pub const css_stroke_linecap := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stroke-linecap" allowed = "@css_stroke_linecap" }

@en "stroke linejoin"
@fa "اتصال خط دور"
pub const css_stroke_linejoin := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stroke-linejoin" allowed = "@css_stroke_linejoin" }

@en "stroke miterlimit"
@fa "حد گوشه خط دور"
pub const css_stroke_miterlimit := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stroke-miterlimit" allowed = "number" }

@en "stroke opacity"
@fa "شفافیت خط دور"
pub const css_stroke_opacity := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stroke-opacity" allowed = "number percentage" }

@en "stroke width"
@fa "ضخامت خط دور"
pub const css_stroke_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "stroke-width" allowed = "length percentage" }
