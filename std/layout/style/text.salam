pub const css_text_emphasis_position := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-emphasis-position" allowed = "@css_g_empos max2" }

@en "text emphasis style"
@fa "سبک تاکید متن"
pub const css_text_emphasis_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-emphasis-style" allowed = "string @css_g_emstyle max2" }

@en "text indent"
@fa "تورفتگی متن"
pub const css_text_indent := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-indent" allowed = "length percentage" }

