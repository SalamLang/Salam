package layout

@en "text align"
@fa "ترازمتن" "تراز متن"
pub const css_text_align := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-align" allowed = "@css_text_align" }

@en "text align last"
@fa "تراز خط آخر"
pub const css_text_align_last := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-align-last" allowed = "@css_text_align_last" }

@en "text combine upright"
@fa "ترکیب ایستاده متن"
pub const css_text_combine_upright := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-combine-upright" allowed = "@css_text_combine_upright" }

@en "text decoration"
@fa "تزیین متن"
pub const css_text_decoration := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-decoration" allowed = "set:@css_g_tdline*0-3|@css_g_tdstyle|color|length+percentage+@css_g_tdthick" }

@en "text decoration color"
@fa "رنگ تزیین متن"
pub const css_text_decoration_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-decoration-color" allowed = "color" }

@en "text decoration line"
@fa "خط تزیین متن"
pub const css_text_decoration_line := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-decoration-line" allowed = "max3 @css_text_decoration_line" }

@en "text decoration skip ink"
@fa "پرش جوهر تزیین"
pub const css_text_decoration_skip_ink := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-decoration-skip-ink" allowed = "@css_text_decoration_skip_ink" }

@en "text decoration style"
@fa "سبک تزیین متن"
pub const css_text_decoration_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-decoration-style" allowed = "@css_text_decoration_style" }

@en "text decoration thickness"
@fa "ضخامت تزیین متن"
pub const css_text_decoration_thickness := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-decoration-thickness" allowed = "length percentage @css_text_decoration_thickness" }

@en "text emphasis"
@fa "تاکید متن"
pub const css_text_emphasis := LayoutAttribute { destination = "css" value_type = "css" generated_name = "text-emphasis" allowed = "set:string+@css_g_emstyle*0-2|color" }

