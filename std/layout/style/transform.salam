package layout

@en "transform"
@fa "دگرگونی"
pub const css_transform := LayoutAttribute { destination = "css" value_type = "string" generated_name = "transform" }

@en "transform box"
@fa "جعبه دگرگونی"
pub const css_transform_box := LayoutAttribute { destination = "css" value_type = "css" generated_name = "transform-box" allowed = "@css_transform_box" }

@en "transform origin"
@fa "مبدا دگرگونی"
pub const css_transform_origin := LayoutAttribute { destination = "css" value_type = "string" generated_name = "transform-origin" }

@en "transform style"
@fa "سبک دگرگونی"
pub const css_transform_style := LayoutAttribute { destination = "css" value_type = "css" generated_name = "transform-style" allowed = "@css_transform_style" }
