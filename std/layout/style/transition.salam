package layout

@en "transition"
@fa "گذار"
pub const css_transition := LayoutAttribute { destination = "css" value_type = "css" generated_name = "transition" allowed = "list set:time*0-2|easing+@css_g_easing|@css_g_transbeh|@css_g_transall+ident" }

@en "transition behavior"
@fa "رفتار گذار"
pub const css_transition_behavior := LayoutAttribute { destination = "css" value_type = "css" generated_name = "transition-behavior" allowed = "list @css_transition_behavior" }

@en "transition delay"
@fa "تاخیر گذار"
pub const css_transition_delay := LayoutAttribute { destination = "css" value_type = "css" generated_name = "transition-delay" allowed = "list time" }

@en "transition duration"
@fa "مدت گذار"
pub const css_transition_duration := LayoutAttribute { destination = "css" value_type = "css" generated_name = "transition-duration" allowed = "list time" }

@en "transition property"
@fa "ویژگی گذار"
pub const css_transition_property := LayoutAttribute { destination = "css" value_type = "css" generated_name = "transition-property" allowed = "list ident @css_transition_property" }

@en "transition timing function"
@fa "تابع زمان‌بندی گذار"
pub const css_transition_timing_function := LayoutAttribute { destination = "css" value_type = "css" generated_name = "transition-timing-function" allowed = "list easing @css_transition_timing_function" }
