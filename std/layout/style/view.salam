package layout

@en "view transition name"
@fa "نام گذار نما"
pub const css_view_transition_name := LayoutAttribute { destination = "css" value_type = "css" generated_name = "view-transition-name" allowed = "ident @css_view_transition_name" }

@en "view timeline"
@fa "خط زمان دید"
pub const css_view_timeline := LayoutAttribute { destination = "css" value_type = "css" generated_name = "view-timeline" allowed = "list set:dashed*1|@css_g_tlaxis|length+percentage+@css_g_auto*0-2" }

@en "view timeline name"
@fa "نام خط زمان دید"
pub const css_view_timeline_name := LayoutAttribute { destination = "css" value_type = "css" generated_name = "view-timeline-name" allowed = "list dashed @css_g_none" }

@en "view timeline axis"
@fa "محور خط زمان دید"
pub const css_view_timeline_axis := LayoutAttribute { destination = "css" value_type = "css" generated_name = "view-timeline-axis" allowed = "list @css_g_tlaxis" }

@en "view timeline inset"
@fa "فرورفتگی خط زمان دید"
pub const css_view_timeline_inset := LayoutAttribute { destination = "css" value_type = "css" generated_name = "view-timeline-inset" allowed = "list length percentage @css_g_auto max2" }

@en "view transition class"
@fa "کلاس گذار دید"
pub const css_view_transition_class := LayoutAttribute { destination = "css" value_type = "css" generated_name = "view-transition-class" allowed = "ident @css_g_none max99" }
