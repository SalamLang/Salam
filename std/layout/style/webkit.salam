package layout

@en "tap highlight color"
@fa "رنگ برجسته لمس"
pub const css_webkit_tap_highlight_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "-webkit-tap-highlight-color" allowed = "color" }

@en "webkit text stroke"
@fa "خط دور متن"
pub const css_webkit_text_stroke := LayoutAttribute { destination = "css" value_type = "css" generated_name = "-webkit-text-stroke" allowed = "set:length|color" }

@en "webkit text stroke width"
@fa "ضخامت خط دور متن"
pub const css_webkit_text_stroke_width := LayoutAttribute { destination = "css" value_type = "css" generated_name = "-webkit-text-stroke-width" allowed = "length @css_g_bw" }

@en "webkit text stroke color"
@fa "رنگ خط دور متن"
pub const css_webkit_text_stroke_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "-webkit-text-stroke-color" allowed = "color" }

@en "webkit text fill color"
@fa "رنگ پر متن"
pub const css_webkit_text_fill_color := LayoutAttribute { destination = "css" value_type = "css" generated_name = "-webkit-text-fill-color" allowed = "color" }
