package layout

@en "white space"
@fa "فضای سفید"
pub const css_white_space := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "white-space" allowed = "@css_white_space"
}

@en "white space collapse"
@fa "ادغام فضای سفید"
pub const css_white_space_collapse := LayoutAttribute {
    destination = "css" value_type = "css" generated_name = "white-space-collapse" allowed = "@css_white_space_collapse"
}
