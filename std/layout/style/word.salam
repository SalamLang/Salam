package layout

@en "word break"
@fa "شکستن واژه"
pub const css_word_break := LayoutAttribute { destination = "css" value_type = "css" generated_name = "word-break" allowed = "@css_word_break" }

@en "word spacing"
@fa "فاصله واژه‌ها"
pub const css_word_spacing := LayoutAttribute { destination = "css" value_type = "css" generated_name = "word-spacing" allowed = "length percentage @css_word_spacing" }
