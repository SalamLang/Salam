package layout

@en "en" "english"
@fa "انگلیسی"
@ar "إنجلیزیة"
pub const en := LayoutValue { group = "lang" generated_value = "en" }

@en "fa" "persian" "farsi"
@fa "فارسی"
@ar "فارسیة"
pub const fa := LayoutValue { group = "lang" generated_value = "fa" }

@en "ar" "arabic"
@fa "عربی"
@ar "عربیة"
pub const ar := LayoutValue { group = "lang" generated_value = "ar" }
