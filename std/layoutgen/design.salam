package layoutgen

import str

pub const DS_FONT_SANS := `ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans","Vazirmatn",sans-serif`

pub const DS_FONT_MONO := `ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace`

pub const DS_EXTRAS := `ds-outline-bg|var(--background)|color-mix(in oklab,var(--input) 30%,transparent)
ds-outline-hover|var(--accent)|color-mix(in oklab,var(--input) 50%,transparent)
ds-ghost-hover|var(--accent)|color-mix(in oklab,var(--accent) 50%,transparent)
ds-destructive-bg|var(--destructive)|color-mix(in oklab,var(--destructive) 60%,transparent)
ds-input-bg|transparent|color-mix(in oklab,var(--input) 30%,transparent)
ds-ring-invalid|color-mix(in oklab,var(--destructive) 20%,transparent)|color-mix(in oklab,var(--destructive) 40%,transparent)
ds-switch-off|var(--input)|color-mix(in oklab,var(--input) 80%,transparent)
ds-switch-thumb-off|var(--background)|var(--foreground)
ds-switch-thumb-on|var(--background)|var(--primary-foreground)`

pub const DS_BASE_CSS := `:root{color-scheme:light dark}
[data-theme="light"]{color-scheme:light}
[data-theme="dark"],.dark{color-scheme:dark}
:where(:not(html,body)[data-theme="light"],:not(html,body)[data-theme="dark"],:not(html,body).dark){background:var(--background);color:var(--foreground)}
:where(*,::before,::after){border-color:var(--border);outline-color:color-mix(in oklab,var(--ring) 50%,transparent)}
body{background:var(--background);color:var(--foreground);font-family:var(--ds-font-sans);-webkit-font-smoothing:antialiased}
:where(code,kbd,samp,pre){font-family:var(--ds-font-mono)}
`

mut g_ds_name := "shadcn"

mut g_ds_warn := ""

func ds_extra_common(): str:
    ret `--ds-ring-soft:color-mix(in oklab,var(--ring) 50%,transparent);--ds-shadow-xs:0 1px 2px 0 rgb(0 0 0/.05);--ds-shadow-sm:0 1px 3px 0 rgb(0 0 0/.1),0 1px 2px -1px rgb(0 0 0/.1);--ds-shadow-md:0 4px 6px -1px rgb(0 0 0/.1),0 2px 4px -2px rgb(0 0 0/.1);--ds-shadow-lg:0 10px 15px -3px rgb(0 0 0/.1),0 4px 6px -4px rgb(0 0 0/.1);--ds-font-sans:` +
        DS_FONT_SANS + `;--ds-font-mono:` + DS_FONT_MONO + `;--radius-sm:calc(var(--radius) - 4px);--radius-md:calc(var(--radius) - 2px);--radius-lg:var(--radius);--radius-xl:calc(var(--radius) + 4px)`
end

func ds_palette_text(name: str): str:
    if name == "zinc" or name == "روی":
        ret DS_PALETTE_ZINC
    end
    if name == "stone" or name == "سنگ":
        ret DS_PALETTE_STONE
    end
    if name == "slate" or name == "تخته سنگ":
        ret DS_PALETTE_SLATE
    end
    if name == "gray" or name == "خاکستری":
        ret DS_PALETTE_GRAY
    end
    if name == "mauve" or name == "یاسی":
        ret DS_PALETTE_MAUVE
    end
    if name == "olive" or name == "زیتونی":
        ret DS_PALETTE_OLIVE
    end
    if name == "mist" or name == "مه":
        ret DS_PALETTE_MIST
    end
    if name == "taupe" or name == "قهوه ای خاکستری":
        ret DS_PALETTE_TAUPE
    end
    ret DS_PALETTE_NEUTRAL
end

func ds_warn(msg: str):
    g_ds_warn += "<meta name=\"salam-design-warning\" content=\"" + Escape(msg) +
        "\"><script>console.error(\"design: \"+" + ds_js_str(msg) + ")</script>"
end

func ds_js_str(s: str): str:
    ret "\"" + str.Replace(
        str.Replace(str.Replace(s, "\\", "\\\\"), "\"", "\\\""), "<", "\\u003c"
    ) + "\""
end

func ds_palette_known(name: str): bool:
    ret ds_palette_text(name) != DS_PALETTE_NEUTRAL or name == "neutral" or name == "خنثی"
end

func ds_trim(s: str): str:
    ret str.Trim(s)
end

func DsOn(): bool:
    ret g_ds_name != "none" and g_ds_name != ""
end

func ds_norm(tokens: str): str:
    mut out := ""
    mut more := tokens
    until more != "":
        item := DsBefore(more, ";")
        more = DsAfter(more, ";")
        key := ds_trim(DsBefore(item, ":"))
        value := ds_trim(DsAfter(item, ":"))
        if key != "" and value != "":
            out += ";" + key + ":" + value
        end
    end
    ret out
end

func ds_tok(norm: str, name: str): str:
    key := ";" + name + ":"
    i := norm.Find(key)
    if i < 0:
        ret ""
    end
    start := i + key.Len()
    ret DsBefore(norm.Substr(start, norm.Len() - start), ";")
end

func ds_pick(norm: str, side: str, key: str, fallback: str): str:
    mut v := ds_tok(norm, side + " " + key)
    if v == "":
        v = ds_tok(norm, key)
    end
    if v == "":
        ret fallback
    end
    ret v
end

func ds_token_lines(text: str, norm: str): str:
    mut css := ""
    mut rest := text
    until rest != "":
        line := DsBefore(rest, "\n")
        rest = DsAfter(rest, "\n")
        tail := DsAfter(line, "|")
        key := DsBefore(line, "|")
        lo := ds_pick(norm, "light", key, DsBefore(tail, "|"))
        dk := ds_pick(norm, "dark", key, DsAfter(tail, "|"))
        if lo == dk:
            css += "--" + key + ":" + lo + ";"
        else:
            css += "--" + key + ":light-dark(" + lo + "," + dk + ");"
        end
    end
    ret css
end

func ds_font_format(url: str): str:
    low := str.Lower(url)
    if str.EndsWith(low, ".woff2"):
        ret "woff2"
    end
    if str.EndsWith(low, ".woff"):
        ret "woff"
    end
    if str.EndsWith(low, ".otf"):
        ret "opentype"
    end
    ret "truetype"
end

func ds_font_faces(list: str): str:
    mut css := ""
    mut more := list
    until more != "":
        item := ds_trim(DsBefore(more, ","))
        more = DsAfter(more, ",")
        if item == "":
            continue
        end
        family := str.Replace(DsBefore(item, " "), "+", " ")
        rest := ds_trim(DsAfter(item, " "))
        url := str.Replace(DsBefore(rest, " "), "\"", "")
        mut extra := ds_trim(DsAfter(rest, " "))
        mut style := "normal"
        if extra.Find("italic") >= 0:
            style = "italic"
            extra = ds_trim(str.Replace(extra, "italic", ""))
        end
        if extra == "":
            extra = "400"
        end
        css += "@font-face{font-family:\"" + str.Replace(
            family, "\"", ""
        ) + "\";src:url(\"" + url + "\") format(\"" + ds_font_format(url) + "\");font-weight:" +
            extra + ";font-style:" + style + ";font-display:swap}\n"
    end
    ret css
end

func ds_font_links(list: str): str:
    mut html := ""
    mut more := str.Replace(list, ",", " ")
    mut first := true
    until more != "":
        url := DsBefore(ds_trim(more), " ")
        more = DsAfter(ds_trim(more), " ")
        if url == "":
            continue
        end
        if first and url.Find("fonts.googleapis.com") >= 0:
            html += "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">" +
                "<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>"
        end
        first = false
        html += "<link rel=\"stylesheet\" href=\"" + Escape(str.Replace(url, "%26", "&")) + "\">"
    end
    ret html
end

func ds_cfg_tokens(main: str): str:
    mut out := ""
    if dc_val(main, "font-sans") != "":
        out += ";font-sans:" + dc_val(main, "font-sans")
    end
    if dc_val(main, "font-mono") != "":
        out += ";font-mono:" + dc_val(main, "font-mono")
    end
    ret out
end

func ds_first(a: str, b: str, fallback: str): str:
    if a != "":
        ret a
    end
    if b != "":
        ret b
    end
    ret fallback
end

@en "DsName"
@fa "نام طراحی"
pub func DsName(): str:
    ret g_ds_name
end

@en "DsPick"
@fa "انتخاب طراحی"
pub func DsPick(design: str, shadcn_css: str, design_css: str): str:
    if g_ds_name == design and design_css != "":
        ret design_css
    end
    ret shadcn_css
end

@en "DsAttr"
@fa "ویژگی طراحی"
pub func DsAttr(attrs: str, name: str): str:
    key := " " + name + "=\""
    padded := " " + attrs
    i := padded.Find(key)
    if i < 0:
        ret ""
    end
    start := i + key.Len()
    rest := padded.Substr(start, padded.Len() - start)
    j := rest.Find("\"")
    if j < 0:
        ret rest
    end
    ret rest.Substr(0, j)
end

@en "DsBefore"
@fa "پیش از"
pub func DsBefore(s: str, sep: str): str:
    i := s.Find(sep)
    if i < 0:
        ret s
    end
    ret s.Substr(0, i)
end

@en "DsAfter"
@fa "پس از"
pub func DsAfter(s: str, sep: str): str:
    i := s.Find(sep)
    if i < 0:
        ret ""
    end
    ret s.Substr(i + sep.Len(), s.Len() - i - sep.Len())
end

@en "DsTokensCss"
@fa "سی اس اس توکن ها"
pub func DsTokensCss(palette: str, tokens: str): str:
    norm := ds_norm(tokens)
    known := "\n" + ds_palette_text(palette) + "\n" + DS_EXTRAS
    mut css := ":root{color-scheme:light dark;" + ds_token_lines(
        ds_palette_text(palette), norm
    ) + ds_token_lines(DS_EXTRAS, norm) + ds_extra_common() + ";"
    mut more := norm
    mut seen := ";"
    until more != "":
        rest := DsAfter(more, ";")
        item := DsBefore(rest, ";")
        more = DsAfter(rest, ";")
        if more != "":
            more = ";" + more
        end
        mut key := DsBefore(item, ":")
        if str.StartsWith(key, "dark "):
            key = key.Substr(5, key.Len() - 5)
        else str.StartsWith(key, "light "):
            key = key.Substr(6, key.Len() - 6)
        end
        if known.Find("\n" + key + "|") < 0 and key != "" and seen.Find(";" + key + ";") < 0:
            seen += key + ";"
            if key == "font-sans" or key == "font-mono":
                css += "--ds-" + key + ":" + DsAfter(item, ":") + ";"
            else key == "font-url" or key == "font-face":
                css += ""
            else str.StartsWith(key, "--"):
                css += key + ":" + DsAfter(item, ":") + ";"
            else str.StartsWith(key, "ds-"):
                css += "--" + key + ":" + DsAfter(item, ":") + ";"
            else:
                ds_warn(
                    "unknown design token '" + key +
                        "'. Use a name from the token list in docs/design/DESIGN_SYSTEMS.md, or start with -- for a custom property."
                )
            end
        end
    end
    css += "}\n"
    ret css
end

@en "design_page"
@fa "طراحی صفحه"
pub func design_page(n: Node): Output:
    mut o := Output {}
    cfg := DsConfigFor(Get(n, "file"))
    main := DsConfigBlock(cfg, "design")
    name := ds_first(DsAttr(n.attrs, "data-design"), DsConfigValue(main, "design"), "shadcn")
    g_ds_name = name
    page_tokens := DsAttr(n.attrs, "data-tokens")
    page_norm := ds_norm(page_tokens)
    font_url := ds_first(ds_tok(page_norm, "font-url"), DsConfigValue(main, "font-url"), "")
    font_face := ds_first(ds_tok(page_norm, "font-face"), DsConfigValue(main, "font-face"), "")
    g_ds_warn = ""
    o.head = ds_font_links(font_url)
    o.shared_css = ds_font_faces(font_face)
    if not DsOn():
        ret o
    end
    mut palette := ds_first(
        DsAttr(n.attrs, "data-palette"), DsConfigValue(main, "palette"), "neutral"
    )
    mut tokens := page_tokens + ";" + DsConfigValue(
        main, "tokens"
    ) + ds_cfg_tokens(main) + DsConfigTokens(
        DsConfigBlock(cfg, "design.tokens")
    )
    custom := DsConfigBlock(cfg, "design.palette." + palette)
    if custom != "":
        tokens += DsConfigTokens(custom)
        palette = ds_first(DsConfigValue(custom, "base"), "", "neutral")
    end
    if custom == "" and not ds_palette_known(palette):
        ds_warn(
            "unknown palette '" + palette +
                "'. Built in: neutral zinc stone slate gray mauve olive mist taupe. Define your own in design.toml or salam.toml under [design.palette." +
                palette + "]."
        )
    end
    o.shared_css += DsTokensCss(palette, tokens) + DS_BASE_CSS
    o.head += g_ds_warn
    mode := DsConfigValue(main, "theme")
    if DsAttr(n.attrs, "data-theme") == "" and (mode == "light" or mode == "dark"):
        o.shared_css += ":root:not([data-theme]){color-scheme:" + mode + "}\n"
    end
    ret o
end
