package layoutgen

import str

pub const DS_FONT_SANS := `ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans","Vazirmatn",sans-serif`

pub const DS_FONT_MONO := `ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace`

pub const DS_EXTRA_LIGHT := `--ds-outline-bg:var(--background);--ds-outline-hover:var(--accent);--ds-ghost-hover:var(--accent);--ds-destructive-bg:var(--destructive);--ds-input-bg:transparent;--ds-ring-invalid:color-mix(in oklab,var(--destructive) 20%,transparent);--ds-switch-off:var(--input);--ds-switch-thumb-off:var(--background);--ds-switch-thumb-on:var(--background)`

pub const DS_EXTRA_DARK := `--ds-outline-bg:color-mix(in oklab,var(--input) 30%,transparent);--ds-outline-hover:color-mix(in oklab,var(--input) 50%,transparent);--ds-ghost-hover:color-mix(in oklab,var(--accent) 50%,transparent);--ds-destructive-bg:color-mix(in oklab,var(--destructive) 60%,transparent);--ds-input-bg:color-mix(in oklab,var(--input) 30%,transparent);--ds-ring-invalid:color-mix(in oklab,var(--destructive) 40%,transparent);--ds-switch-off:color-mix(in oklab,var(--input) 80%,transparent);--ds-switch-thumb-off:var(--foreground);--ds-switch-thumb-on:var(--primary-foreground)`

pub const DS_BASE_CSS := `:root{color-scheme:light dark}
[data-theme="light"]{color-scheme:light}
[data-theme="dark"],.dark{color-scheme:dark}
:where(*,::before,::after){border-color:var(--border);outline-color:color-mix(in oklab,var(--ring) 50%,transparent)}
body{background:var(--background);color:var(--foreground);font-family:var(--ds-font-sans);-webkit-font-smoothing:antialiased}
:where(code,kbd,samp,pre){font-family:var(--ds-font-mono)}
`

mut g_ds_name := "shadcn"

func ds_extra_common(): str:
    ret `--ds-ring-soft:color-mix(in oklab,var(--ring) 50%,transparent);--ds-shadow-xs:0 1px 2px 0 rgb(0 0 0/.05);--ds-shadow-sm:0 1px 3px 0 rgb(0 0 0/.1),0 1px 2px -1px rgb(0 0 0/.1);--ds-shadow-md:0 4px 6px -1px rgb(0 0 0/.1),0 2px 4px -2px rgb(0 0 0/.1);--ds-shadow-lg:0 10px 15px -3px rgb(0 0 0/.1),0 4px 6px -4px rgb(0 0 0/.1);--ds-font-sans:` + DS_FONT_SANS + `;--ds-font-mono:` + DS_FONT_MONO + `;--radius-sm:calc(var(--radius) - 4px);--radius-md:calc(var(--radius) - 2px);--radius-lg:var(--radius);--radius-xl:calc(var(--radius) + 4px)`
end

func ds_palette_text(name: str): str:
    if name == "zinc":
        ret DS_PALETTE_ZINC
    end
    if name == "stone":
        ret DS_PALETTE_STONE
    end
    if name == "slate":
        ret DS_PALETTE_SLATE
    end
    if name == "gray":
        ret DS_PALETTE_GRAY
    end
    ret DS_PALETTE_NEUTRAL
end

func ds_trim(s: str): str:
    ret str.Trim(s)
end

func ds_token_decl(key: str, value: str): str:
    if key == "font-sans" or key == "font-mono":
        ret "--ds-" + key + ":" + value + ";"
    end
    ret "--" + key + ":" + value + ";"
end

@en "DsOn"
@fa "طراحی روشن است"
pub func DsOn(): bool:
    ret g_ds_name != "none" and g_ds_name != ""
end

@en "DsName"
@fa "نام طراحی"
pub func DsName(): str:
    ret g_ds_name
end

@en "DsAttr"
@fa "ویژگی طراحی"
pub func DsAttr(attrs: str, name: str): str:
    key := " " + name + "=\""
    padded := " " + attrs
    i := padded.Find(key)
    if i < 0:
        ret ""
    end
    start := i + key.Len()
    rest := padded.Substr(start, padded.Len() - start)
    j := rest.Find("\"")
    if j < 0:
        ret rest
    end
    ret rest.Substr(0, j)
end

@en "DsBefore"
@fa "پیش از"
pub func DsBefore(s: str, sep: str): str:
    i := s.Find(sep)
    if i < 0:
        ret s
    end
    ret s.Substr(0, i)
end

@en "DsAfter"
@fa "پس از"
pub func DsAfter(s: str, sep: str): str:
    i := s.Find(sep)
    if i < 0:
        ret ""
    end
    ret s.Substr(i + sep.Len(), s.Len() - i - sep.Len())
end

@en "DsTokensCss"
@fa "سی اس اس توکن ها"
pub func DsTokensCss(palette: str, tokens: str): str:
    mut light := ""
    mut dark := ""
    mut rest := ds_palette_text(palette)
    until rest != "":
        line := DsBefore(rest, "\n")
        rest = DsAfter(rest, "\n")
        tail := DsAfter(line, "|")
        light += "--" + DsBefore(line, "|") + ":" + DsBefore(tail, "|") + ";"
        dark += "--" + DsBefore(line, "|") + ":" + DsAfter(tail, "|") + ";"
    end
    mut both := ""
    mut lo := ""
    mut dk := ""
    mut more := tokens
    until more != "":
        item := DsBefore(more, ";")
        more = DsAfter(more, ";")
        key := ds_trim(DsBefore(item, ":"))
        value := ds_trim(DsAfter(item, ":"))
        if key != "" and value != "":
            if str.StartsWith(key, "dark "):
                dk += ds_token_decl(ds_trim(key.Substr(5, key.Len() - 5)), value)
            else str.StartsWith(key, "light "):
                lo += ds_token_decl(ds_trim(key.Substr(6, key.Len() - 6)), value)
            else:
                both += ds_token_decl(key, value)
            end
        end
    end
    mut css := ":root,[data-theme=\"light\"]{" + light + DS_EXTRA_LIGHT + ";" + ds_extra_common() + ";" + both + lo + "}\n"
    css += "[data-theme=\"dark\"],.dark{" + dark + DS_EXTRA_DARK + ";" + both + dk + "}\n"
    css += "@media (prefers-color-scheme:dark){body:not([data-theme=\"light\"]):not([data-theme=\"dark\"]){" + dark + DS_EXTRA_DARK + ";" + both + dk + "}}\n"
    ret css
end

@en "design_page"
@fa "طراحی صفحه"
pub func design_page(n: Node): Output:
    mut o := Output {}
    name := DsAttr(n.attrs, "data-design")
    if name == "":
        g_ds_name = "shadcn"
    else:
        g_ds_name = name
    end
    if not DsOn():
        ret o
    end
    mut palette := DsAttr(n.attrs, "data-palette")
    if palette == "":
        palette = "neutral"
    end
    o.shared_css = DsTokensCss(palette, DsAttr(n.attrs, "data-tokens")) + DS_BASE_CSS
    ret o
end
