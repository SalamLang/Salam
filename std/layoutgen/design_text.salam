package layoutgen

import str

pub const DS_TEXT_KEYS := "Previous|Next|More|More pages|breadcrumb|pagination|Close|Notifications|Clear|Toggle theme|Toggle sidebar|Command palette|Pick a date|Select...|Search...|No results found.|Loading|Chart|Series|Previous slide|Next slide|Go to slide|Previous month|Next month|of"

mut g_ds_fa := false

func ds_text_fa(en: str): str:
    if en == "Previous":
        ret "قبلی"
    end
    if en == "Next":
        ret "بعدی"
    end
    if en == "More":
        ret "بیشتر"
    end
    if en == "More pages":
        ret "صفحه‌های بیشتر"
    end
    if en == "breadcrumb":
        ret "مسیر صفحه"
    end
    if en == "pagination":
        ret "صفحه‌بندی"
    end
    if en == "Close":
        ret "بستن"
    end
    if en == "Notifications":
        ret "اعلان‌ها"
    end
    if en == "Clear":
        ret "پاک کردن"
    end
    if en == "Toggle theme":
        ret "تغییر پوسته‌ی روشن و تیره"
    end
    if en == "Toggle sidebar":
        ret "باز و بسته کردن نوار کناری"
    end
    if en == "Command palette":
        ret "پالت فرمان"
    end
    if en == "Pick a date":
        ret "انتخاب تاریخ"
    end
    if en == "Select...":
        ret "انتخاب کنید..."
    end
    if en == "Search...":
        ret "جستجو..."
    end
    if en == "No results found.":
        ret "نتیجه‌ای پیدا نشد."
    end
    if en == "Loading":
        ret "در حال بارگذاری"
    end
    if en == "Chart":
        ret "نمودار"
    end
    if en == "Series":
        ret "سری"
    end
    if en == "Previous slide":
        ret "اسلاید قبلی"
    end
    if en == "Next slide":
        ret "اسلاید بعدی"
    end
    if en == "Go to slide":
        ret "رفتن به اسلاید"
    end
    if en == "Previous month":
        ret "ماه قبل"
    end
    if en == "Next month":
        ret "ماه بعد"
    end
    if en == "of":
        ret "از"
    end
    ret en
end

@en "DsSetLang"
@fa "تنظیم زبان طراحی"
pub func DsSetLang(lang: str):
    g_ds_fa = str.StartsWith(str.Lower(lang), "fa")
end

@en "DsT"
@fa "متن طراحی"
pub func DsT(en: str): str:
    if g_ds_fa:
        ret ds_text_fa(en)
    end
    ret en
end

@en "DsJs"
@fa "اسکریپت طراحی"
pub func DsJs(js: str): str:
    mut s := js
    keys := str.Split(DS_TEXT_KEYS, "|")
    repeat keys.Len() in i:
        k := keys[i]
        s = str.Replace(s, "@@" + k + "@@", DsT(k))
    end
    ret s
end
