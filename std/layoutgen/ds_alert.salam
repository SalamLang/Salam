package layoutgen

pub const DS_ALERT_CSS := `
:where([data-slot="alert"]){position:relative;display:grid;width:100%;grid-template-columns:0 1fr;align-items:start;row-gap:2px;border-radius:var(--radius-lg);border:1px solid var(--border);background:var(--card);padding:12px 16px;color:var(--card-foreground);font-size:14px;line-height:20px}
:where([data-slot="alert"]:has(>svg)){grid-template-columns:16px 1fr;column-gap:12px}
:where([data-slot="alert"]>svg){width:16px;height:16px;transform:translateY(2px);color:currentColor}
:where([data-slot="alert"][data-variant="destructive"]){color:var(--destructive)}
:where([data-slot="alert"][data-variant="destructive"]>[data-slot="alert-description"]){color:color-mix(in oklab,var(--destructive) 90%,transparent)}
:where([data-slot="alert-title"]){grid-column-start:2;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;min-height:16px;font-weight:500;letter-spacing:-.025em}
:where([data-slot="alert-description"]){grid-column-start:2;display:grid;justify-items:start;gap:4px;color:var(--muted-foreground);font-size:14px}
:where([data-slot="alert-description"] p){line-height:1.625}
`

@en "gen_alert"
@fa "ساخت هشدار"
pub func gen_alert(n: Node): Output:
    mut o := Output {}
    o.html = "<div data-slot=\"alert\" role=\"alert\"" + n.attrs + ClassAttr(n, "") + ">" +
        Escape(n.content) + n.inner + "</div>"
    if DsOn():
        o.shared_css = DS_ALERT_CSS
    end
    ret o
end

@en "gen_alert_title"
@fa "ساخت عنوان هشدار"
pub func gen_alert_title(n: Node): Output:
    ret ds_part_output(n, "alert-title", DS_ALERT_CSS)
end

@en "gen_alert_description"
@fa "ساخت توضیح هشدار"
pub func gen_alert_description(n: Node): Output:
    ret ds_part_output(n, "alert-description", DS_ALERT_CSS)
end
