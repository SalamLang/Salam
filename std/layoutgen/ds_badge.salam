package layoutgen

pub const DS_BADGE_CSS := `
:where([data-slot="badge"]){display:inline-flex;flex-direction:row;width:fit-content;flex-shrink:0;align-items:center;justify-content:center;gap:4px;overflow:hidden;border-radius:9999px;border:1px solid transparent;padding:2px 8px;background:var(--primary);color:var(--primary-foreground);font-size:12px;line-height:16px;font-weight:500;white-space:nowrap;text-decoration:none;transition:color .15s,box-shadow .15s}
:where([data-slot="badge"]:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft);outline:none}
:where([data-slot="badge"][aria-invalid="true"]){border-color:var(--destructive);box-shadow:0 0 0 3px var(--ds-ring-invalid)}
:where([data-slot="badge"]>svg){pointer-events:none;width:12px;height:12px}
:where(a[data-slot="badge"]:hover){background:color-mix(in oklab,var(--primary) 90%,transparent)}
:where([data-slot="badge"][data-variant="secondary"]){background:var(--secondary);color:var(--secondary-foreground)}
:where([data-slot="badge"][data-variant="destructive"]){background:var(--ds-destructive-bg);color:#fff}
:where([data-slot="badge"][data-variant="destructive"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-invalid)}
:where([data-slot="badge"][data-variant="outline"]){border-color:var(--border);background:transparent;color:var(--foreground)}
:where([data-slot="badge"][data-variant="ghost"]){background:transparent;color:inherit}
:where([data-slot="badge"][data-variant="link"]){background:transparent;color:var(--primary);text-underline-offset:4px}
:where(a[data-slot="badge"][data-variant="secondary"]:hover){background:color-mix(in oklab,var(--secondary) 90%,transparent)}
:where(a[data-slot="badge"][data-variant="destructive"]:hover){background:color-mix(in oklab,var(--destructive) 90%,transparent)}
:where(a[data-slot="badge"][data-variant="outline"]:hover),:where(a[data-slot="badge"][data-variant="ghost"]:hover){background:var(--accent);color:var(--accent-foreground)}
:where(a[data-slot="badge"][data-variant="link"]:hover){background:transparent;text-decoration:underline}
`

@en "gen_badge"
@fa "ساخت نشان"
pub func gen_badge(n: Node): Output:
    mut o := Output {}
    mut tag := "span"
    if DsAttr(n.attrs, "href") != "":
        tag = "a"
    end
    o.html = "<" + tag + " data-slot=\"badge\"" + n.attrs + ClassAttr(n, "") + ">" +
        Escape(n.content) + n.inner + "</" + tag + ">"
    if DsOn():
        o.shared_css = DS_BADGE_CSS
    end
    ret o
end
