package layoutgen

pub const DS_BUTTON_CSS := `
:where(button){display:inline-flex;border:0 solid var(--border);flex-shrink:0;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:var(--radius-md);background:var(--primary);color:var(--primary-foreground);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;cursor:pointer;outline:none;transition:all .15s}
:where(button:hover){background:color-mix(in oklab,var(--primary) 90%,transparent)}
:where(button:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}
:where(button:disabled){pointer-events:none;opacity:.5}
:where(button[aria-invalid="true"]){border-color:var(--destructive);box-shadow:0 0 0 3px var(--ds-ring-invalid)}
:where(button svg){pointer-events:none;flex-shrink:0;width:16px;height:16px}
:where(button[data-variant="destructive"]){background:var(--ds-destructive-bg);color:#fff}
:where(button[data-variant="destructive"]:hover){background:color-mix(in oklab,var(--destructive) 90%,transparent)}
:where(button[data-variant="destructive"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-invalid)}
:where(button[data-variant="outline"]){border-width:1px;border-color:var(--border);background:var(--ds-outline-bg);box-shadow:var(--ds-shadow-xs);color:inherit}
:where(button[data-variant="outline"]:hover){background:var(--ds-outline-hover);color:var(--accent-foreground)}
:where(button[data-variant="outline"]:focus-visible){border-color:var(--ring)}
:where(button[data-variant="secondary"]){background:var(--secondary);color:var(--secondary-foreground)}
:where(button[data-variant="secondary"]:hover){background:color-mix(in oklab,var(--secondary) 80%,transparent)}
:where(button[data-variant="ghost"]){background:transparent;color:inherit}
:where(button[data-variant="ghost"]:hover){background:var(--ds-ghost-hover);color:var(--accent-foreground)}
:where(button[data-variant="link"]){background:transparent;color:var(--primary);text-underline-offset:4px}
:where(button[data-variant="link"]:hover){background:transparent;text-decoration:underline}
:where(button[data-size="xs"]){height:24px;gap:4px;padding:0 8px;font-size:12px}
:where(button[data-size="xs"] svg){width:12px;height:12px}
:where(button[data-size="sm"]){height:32px;gap:6px;padding:0 12px}
:where(button[data-size="lg"]){height:40px;padding:0 24px}
:where(button[data-size="icon"]){width:36px;padding:0}
:where(button[data-size="icon-xs"]){width:24px;height:24px;padding:0}
:where(button[data-size="icon-xs"] svg){width:12px;height:12px}
:where(button[data-size="icon-sm"]){width:32px;height:32px;padding:0}
:where(button[data-size="icon-lg"]){width:40px;height:40px;padding:0}
`

@en "gen_button"
@fa "ساخت دکمه"
pub func gen_button(n: Node): Output:
    mut o := Output {}
    o.html = "<button" + n.attrs + ClassAttr(n, "") + ">" + Escape(n.content) + n.inner + "</button>"
    if DsOn():
        o.shared_css = DS_BUTTON_CSS
    end
    ret o
end
