package layoutgen

pub const DS_CALENDAR_MIN_CSS := `
:where([data-slot="calendar-grid"]){display:flex;flex-direction:column}
:where([data-slot="calendar-weekdays"],[data-slot="calendar-week"]){display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}
:where([data-slot="date-picker"]){position:relative;display:inline-block}
:where([data-slot="date-picker-content"]){position:fixed;inset:auto;margin:0;padding:0;overflow:visible;z-index:50}
:where([data-slot="date-picker-content"][hidden]){display:none}
`

pub const DS_CALENDAR_CSS := `
:where([data-slot="calendar"]){display:block;width:fit-content;padding:12px;background:var(--background);color:var(--foreground);font-size:14px;line-height:20px;user-select:none}
:where([data-slot="calendar-head"]){display:flex;flex-direction:row;align-items:center;justify-content:space-between;height:32px;margin-bottom:8px}
:where([data-slot="calendar-label"]){font-size:14px;font-weight:500}
button:where([data-slot="calendar-nav"]){all:unset;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:var(--radius-md);cursor:pointer;transition:background .15s}
button:where([data-slot="calendar-nav"]:hover){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="calendar-nav"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-soft)}
button:where([data-slot="calendar-nav"]) svg{width:16px;height:16px;pointer-events:none}
:where(:dir(rtl)) button:where([data-slot="calendar-nav"]) svg{transform:scaleX(-1)}
:where([data-slot="calendar-weekday"]){width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:12.8px;font-weight:400;color:var(--muted-foreground)}
:where([data-slot="calendar-cell"]){width:32px;height:32px;padding:0;text-align:center}
button:where([data-slot="calendar-day"]){all:unset;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:var(--radius-md);font-size:14px;font-weight:400;cursor:pointer;transition:background .15s,color .15s}
button:where([data-slot="calendar-day"]:hover){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="calendar-day"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-soft);outline:1px solid var(--ring)}
button:where([data-slot="calendar-day"][data-today]){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="calendar-day"][data-outside]){color:var(--muted-foreground)}
button:where([data-slot="calendar-day"][data-selected]),button:where([data-slot="calendar-day"][data-selected]:hover){background:var(--primary);color:var(--primary-foreground)}
button:where([data-slot="calendar-day"][data-range-middle]){background:var(--accent);color:var(--accent-foreground);border-radius:0}
button:where([data-slot="calendar-day"][data-range-start]:not([data-range-single])){border-start-end-radius:0;border-end-end-radius:0}
button:where([data-slot="calendar-day"][data-range-end]:not([data-range-single])){border-start-start-radius:0;border-end-start-radius:0}
button:where([data-slot="calendar-day"][data-disabled]){pointer-events:none;opacity:.5;color:var(--muted-foreground);background:transparent}
button:where([data-slot="date-picker-trigger"]){all:unset;box-sizing:border-box;display:flex;flex-direction:row;align-items:center;justify-content:flex-start;gap:8px;width:100%;min-width:240px;height:36px;padding:8px 16px;border:1px solid var(--input);border-radius:var(--radius-md);background:var(--ds-outline-bg);box-shadow:var(--ds-shadow-xs);font-size:14px;line-height:20px;white-space:nowrap;color:inherit;cursor:pointer;transition:color .15s,box-shadow .15s}
button:where([data-slot="date-picker-trigger"]:hover){background:var(--ds-outline-hover)}
button:where([data-slot="date-picker-trigger"]):focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}
button:where([data-slot="date-picker-trigger"]):disabled{pointer-events:none;opacity:.5}
button:where([data-slot="date-picker-trigger"])[data-placeholder]{color:var(--muted-foreground)}
button:where([data-slot="date-picker-trigger"]) svg{pointer-events:none;flex-shrink:0;width:16px;height:16px}
:where([data-slot="date-picker-content"]){border:1px solid var(--border);border-radius:var(--radius-md);background:var(--popover);color:var(--popover-foreground);box-shadow:var(--ds-shadow-md);outline:none;animation:salam-cal-in .15s ease}
:where([data-slot="date-picker-content"] [data-slot="calendar"]){background:transparent;border-radius:var(--radius-md)}
@keyframes salam-cal-in{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){:where([data-slot="date-picker-content"]){animation:none}}
`

pub const DS_CAL_ICON := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>`

pub const DS_CAL_JS := `
var DAY=864e5,JF=null,JC={};
function pad(n){return n<10?'0'+n:''+n}
function iso(d){return d.getUTCFullYear()+'-'+pad(d.getUTCMonth()+1)+'-'+pad(d.getUTCDate())}
function parse(s){var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s||'');return m?new Date(Date.UTC(+m[1],+m[2]-1,+m[3])):null}
function add(d,n){return new Date(d.getTime()+n*DAY)}
function today(){var n=new Date();return new Date(Date.UTC(n.getFullYear(),n.getMonth(),n.getDate()))}
function jp(d){
var k=d.getTime();
if(JC[k])return JC[k];
if(!JF)JF=new Intl.DateTimeFormat('en-u-ca-persian-nu-latn',{timeZone:'UTC',year:'numeric',month:'numeric',day:'numeric'});
var o={},ps=JF.formatToParts(d);
for(var i=0;i<ps.length;i++)if(ps[i].type==='year'||ps[i].type==='month'||ps[i].type==='day')o[ps[i].type]=parseInt(ps[i].value,10);
o.k=o.year*10000+o.month*100+o.day;
JC[k]=o;
return o
}
function jg(y,m,d){
var t=y*10000+m*100+d,g=new Date(Math.round((Date.UTC(y+621,2,21)+((m-1)*30.5+(d-1))*DAY)/DAY)*DAY);
for(var i=0;i<12;i++){var k=jp(g).k;if(k===t)return g;if(k<t)g=add(g,1);else g=add(g,-1)}
return g
}
function isfa(){return /^fa/i.test(document.documentElement.lang||'')}
function lang(root){
if(root.getAttribute('data-calendar')==='jalali')return isfa()?'fa-IR-u-ca-persian':'en-u-ca-persian-nu-latn';
return document.documentElement.lang||'en-US'
}
function attrs(root){
var jal=root.getAttribute('data-calendar')==='jalali',ws=root.getAttribute('data-week-start');
return{
jal:jal,
ws:ws===null||ws===''?(jal?6:0):(parseInt(ws,10)%7+7)%7,
mode:root.getAttribute('data-mode')==='range'?'range':'single',
min:parse(root.getAttribute('data-min')),
max:parse(root.getAttribute('data-max')),
wd:(root.getAttribute('data-disabled-days')||'').split(','),
dd:(root.getAttribute('data-disabled-dates')||'').split(',')
}
}
function off(a,d){
if(a.min&&d<a.min)return true;
if(a.max&&d>a.max)return true;
if(a.wd.indexOf(String(d.getUTCDay()))>=0)return true;
return a.dd.indexOf(iso(d))>=0
}
function view(root,a){
var v=root.__view;
if(a.jal){
var f=jg(v.y,v.m,1),n=v.m===12?jg(v.y+1,1,1):jg(v.y,v.m+1,1);
return{first:f,len:Math.round((n-f)/DAY)}
}
var f2=new Date(Date.UTC(v.y,v.m-1,1)),n2=new Date(Date.UTC(v.y,v.m,1));
return{first:f2,len:Math.round((n2-f2)/DAY)}
}
function viewOf(d,a){
if(a.jal){var p=jp(d);return{y:p.year,m:p.month}}
return{y:d.getUTCFullYear(),m:d.getUTCMonth()+1}
}
function num(a,n){return a.jal&&isfa()?new Intl.NumberFormat('fa-IR',{useGrouping:false}).format(n):String(n)}
var ICL='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>';
var ICR='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
function render(root,refocus){
var a=attrs(root),loc=lang(root),v=view(root,a),sel=root.__sel||[],tdy=today();
var from=sel[0]?sel[0]:null,to=sel[1]?sel[1]:null;
var mid=add(v.first,14);
var label=new Intl.DateTimeFormat(loc,{month:'long',year:'numeric',timeZone:'UTC'}).format(mid);
var wf=new Intl.DateTimeFormat(loc,{weekday:a.jal&&isfa()?'narrow':'short',timeZone:'UTC'});
var h='<div data-slot="calendar-head"><button type="button" data-slot="calendar-nav" data-dir="-1" aria-label="Previous month">'+ICL+'</button><div data-slot="calendar-label" aria-live="polite">'+label+'</div><button type="button" data-slot="calendar-nav" data-dir="1" aria-label="Next month">'+ICR+'</button></div>';
h+='<div data-slot="calendar-grid" role="grid" aria-label="'+label+'"><div data-slot="calendar-weekdays" role="row">';
for(var i=0;i<7;i++){var wi=(a.ws+i)%7,wn=wf.format(new Date(Date.UTC(2023,0,1+wi)));h+='<div data-slot="calendar-weekday" role="columnheader">'+(a.jal?wn:wn.slice(0,2))+'</div>'}
h+='</div>';
var lead=(v.first.getUTCDay()-a.ws+7)%7,rows=Math.ceil((lead+v.len)/7),fk=root.__focus||iso(from||tdy);
var fd=parse(fk);
if(!fd||fd<v.first||fd>=add(v.first,v.len))fk=iso(v.first);
root.__focus=fk;
for(var r=0;r<rows;r++){
h+='<div data-slot="calendar-week" role="row">';
for(var c=0;c<7;c++){
var d=add(v.first,r*7+c-lead),k=iso(d),inm=d>=v.first&&d<add(v.first,v.len),dis=off(a,d);
var at=' data-date="'+k+'"';
if(!inm)at+=' data-outside';
if(k===iso(tdy))at+=' data-today';
var on=false;
if(a.mode==='range'){
if(from&&iso(from)===k)at+=' data-range-start data-selected',on=true;
if(to&&iso(to)===k)at+=' data-range-end data-selected',on=true;
if(from&&to&&d>from&&d<to)at+=' data-range-middle',on=true;
if(from&&to&&iso(from)===iso(to))at+=' data-range-single'
}else if(from&&iso(from)===k){at+=' data-selected';on=true}
if(dis)at+=' disabled data-disabled';
h+='<div role="gridcell" data-slot="calendar-cell"><button type="button" data-slot="calendar-day"'+at+' tabindex="'+(k===fk&&!dis?'0':'-1')+'" aria-selected="'+(on?'true':'false')+'">'+num(a,a.jal?jp(d).day:d.getUTCDate())+'</button></div>'
}
h+='</div>'
}
h+='</div>';
var had=root.contains(document.activeElement);
root.innerHTML=h;
if(refocus||had){var b=root.querySelector('[data-slot="calendar-day"][data-date="'+fk+'"]');if(b)b.focus()}
}
function sync(root){
var s=root.__sel||[],val=s.length?(root.getAttribute('data-mode')==='range'?iso(s[0])+'/'+(s[1]?iso(s[1]):''):iso(s[0])):'';
root.setAttribute('data-value',val);
var h=root.querySelector('input[type="hidden"]');
}
function init(root){
if(root.__ready)return;
root.__ready=true;
var a=attrs(root),v=root.getAttribute('data-value')||'',p=v.split('/'),s=[];
if(parse(p[0]))s.push(parse(p[0]));
if(a.mode==='range'&&parse(p[1]))s.push(parse(p[1]));
root.__sel=s;
if(a.jal&&isfa()&&!root.hasAttribute('dir'))root.setAttribute('dir','rtl');
root.__view=viewOf(s[0]||today(),a);
render(root,false)
}
function emit(root){
var s=root.__sel||[],val=s.length?(root.getAttribute('data-mode')==='range'?iso(s[0])+'/'+(s[1]?iso(s[1]):''):iso(s[0])):'';
root.setAttribute('data-value',val);
root.dispatchEvent(new CustomEvent('ds-change',{bubbles:true,detail:{value:val,from:s[0]?iso(s[0]):'',to:s[1]?iso(s[1]):''}}))
}
function pick(root,d){
var a=attrs(root),s=root.__sel||[];
if(off(a,d))return;
if(a.mode==='range'){
if(s.length===1){s=d<s[0]?[d,s[0]]:[s[0],d]}else s=[d]
}else s=[d];
root.__sel=s;
root.__focus=iso(d);
var vo=viewOf(d,a);
if(vo.y!==root.__view.y||vo.m!==root.__view.m)root.__view=vo;
render(root,true);
emit(root)
}
function shift(root,n){
var a=attrs(root),v=root.__view,m=v.m+n,y=v.y;
while(m>12){m-=12;y++}
while(m<1){m+=12;y--}
root.__view={y:y,m:m};
root.__focus=null;
render(root,false)
}
function moveFocus(root,d){
var a=attrs(root);
root.__focus=iso(d);
var vo=viewOf(d,a);
root.__view=vo;
render(root,true)
}
function setValue(root,val){
init(root);
root.setAttribute('data-value',val||'');
root.__ready=false;
init(root)
}
function initAll(){var l=document.querySelectorAll('[data-slot="calendar"]');for(var i=0;i<l.length;i++)init(l[i])}
window.salamDsCalendar={init:initAll,set:setValue};
document.addEventListener('click',function(e){
var t=e.target,nav=t.closest&&t.closest('[data-slot="calendar-nav"]');
if(nav){var r=nav.closest('[data-slot="calendar"]');init(r);shift(r,parseInt(nav.getAttribute('data-dir'),10));return}
var day=t.closest&&t.closest('[data-slot="calendar-day"]');
if(day&&!day.disabled){var r2=day.closest('[data-slot="calendar"]');init(r2);pick(r2,parse(day.getAttribute('data-date')))}
});
document.addEventListener('keydown',function(e){
var day=e.target.closest&&e.target.closest('[data-slot="calendar-day"]');
if(!day)return;
var root=day.closest('[data-slot="calendar"]');init(root);
var d=parse(day.getAttribute('data-date')),a=attrs(root),rtl=getComputedStyle(root).direction==='rtl',k=e.key,n=null;
var l=rtl?-1:1;
if(k==='ArrowRight')n=add(d,l);
else if(k==='ArrowLeft')n=add(d,-l);
else if(k==='ArrowDown')n=add(d,7);
else if(k==='ArrowUp')n=add(d,-7);
else if(k==='Home')n=add(d,-((d.getUTCDay()-a.ws+7)%7));
else if(k==='End')n=add(d,6-((d.getUTCDay()-a.ws+7)%7));
else if(k==='PageDown'||k==='PageUp'){
var up=k==='PageUp'?-1:1,cur=viewOf(d,a),m=cur.m+up*(e.shiftKey?12:1),y=cur.y;
while(m>12){m-=12;y++}
while(m<1){m+=12;y--}
var dd=a.jal?jp(d).day:d.getUTCDate();
n=a.jal?jg(y,m,Math.min(dd,m<=6?31:m<=11?30:29)):new Date(Date.UTC(y,m-1,Math.min(dd,new Date(Date.UTC(y,m,0)).getUTCDate())))
}
if(n){e.preventDefault();moveFocus(root,n)}
});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
`

pub const DS_PICKER_JS := `
var openP=null;
function q(r,s){return r.querySelector(s)}
function pad(n){return n<10?'0'+n:''+n}
function parse(s){var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s||'');return m?new Date(Date.UTC(+m[1],+m[2]-1,+m[3])):null}
function loc(r){return r.getAttribute('data-calendar')==='jalali'?(/^fa/i.test(document.documentElement.lang||'')?'fa-IR-u-ca-persian':'en-u-ca-persian-nu-latn'):(document.documentElement.lang||'en-US')}
function fmt(r,v){
var p=(v||'').split('/'),a=parse(p[0]),b=parse(p[1]);
if(!a)return '';
var f=new Intl.DateTimeFormat(loc(r),{dateStyle:'long',timeZone:'UTC'});
return b?f.format(a)+' - '+f.format(b):f.format(a)
}
function place(r){var p=q(r,'[popover]'),t=q(r,'[data-slot="date-picker-trigger"]');dsPlace(p,t,'bottom','start',4)}
function show(r){
if(r.getAttribute('data-state')==='open'||r.hasAttribute('data-disabled'))return;
if(openP&&openP!==r)hide(openP,false);
var p=q(r,'[popover]');
p.hidden=false;
if(p.showPopover)p.showPopover();
r.setAttribute('data-state','open');
q(r,'[data-slot="date-picker-trigger"]').setAttribute('aria-expanded','true');
openP=r;
place(r);
var b=q(p,'[data-slot="calendar-day"][tabindex="0"]');
if(b)b.focus()
}
function hide(r,back){
if(r.getAttribute('data-state')!=='open')return;
var p=q(r,'[popover]');
if(p.hidePopover){try{p.hidePopover()}catch(x){}}
p.hidden=true;
r.setAttribute('data-state','closed');
var t=q(r,'[data-slot="date-picker-trigger"]');
t.setAttribute('aria-expanded','false');
if(openP===r)openP=null;
if(back)t.focus()
}
function setText(r,v){
var t=q(r,'[data-slot="date-picker-value"]'),s=fmt(r,v);
t.textContent=s||r.__ph;
var b=q(r,'[data-slot="date-picker-trigger"]');
if(s)b.removeAttribute('data-placeholder');else b.setAttribute('data-placeholder','');
var h=q(r,'input[type="hidden"]');
if(h)h.value=(v||'').replace(/\/$/,'')
}
function init(r){
if(r.__ready)return;
r.__ready=true;
var t=q(r,'[data-slot="date-picker-trigger"]'),p=q(r,'[popover]');
r.__ph=q(r,'[data-slot="date-picker-value"]').textContent;
p.hidden=true;
t.setAttribute('aria-haspopup','dialog');
t.setAttribute('aria-expanded','false');
if(r.hasAttribute('data-disabled'))t.disabled=true;
setText(r,r.getAttribute('data-value')||'')
}
function initAll(){var l=document.querySelectorAll('[data-slot="date-picker"]');for(var i=0;i<l.length;i++)init(l[i])}
window.salamDsDatePicker=initAll;
document.addEventListener('click',function(e){
var t=e.target.closest&&e.target.closest('[data-slot="date-picker-trigger"]');
if(!t)return;
var r=t.closest('[data-slot="date-picker"]');
init(r);
if(r.getAttribute('data-state')==='open')hide(r,true);else show(r)
});
document.addEventListener('ds-change',function(e){
var r=e.target.closest&&e.target.closest('[data-slot="date-picker"]');
if(!r)return;
var v=e.detail.value;
r.setAttribute('data-value',v);
setText(r,v);
var h=q(r,'input[type="hidden"]');if(h)h.dispatchEvent(new Event('change',{bubbles:true}));
var done=r.getAttribute('data-mode')!=='range'||e.detail.to;
if(done)hide(r,true)
});
document.addEventListener('keydown',function(e){
if(e.key==='Escape'&&openP){e.stopPropagation();hide(openP,true)}
},true);
document.addEventListener('pointerdown',function(e){if(openP&&!openP.contains(e.target))hide(openP,false)});
window.addEventListener('resize',function(){if(openP)place(openP)});
window.addEventListener('scroll',function(e){if(openP&&!q(openP,'[popover]').contains(e.target))place(openP)},true);
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
`

func ds_cal_script(): str:
    ret "(function(){if(window.salamDsCalendar)return;" + DS_CAL_JS + "})();"
end

func ds_picker_script(): str:
    ret "(function(){if(window.salamDsDatePicker)return;" + DS_PLACE_JS + DS_PICKER_JS + "})();"
end

func ds_cal_css(): str:
    if DsOn():
        ret DS_CALENDAR_MIN_CSS + DS_CALENDAR_CSS
    end
    ret DS_CALENDAR_MIN_CSS
end

func ds_cal_key(n: Node, k: str): str:
    v := DsAttr(n.attrs, k)
    if v == "":
        ret ""
    end
    ret " " + k + "=\"" + v + "\""
end

func ds_cal_keys(n: Node): str:
    ret ds_cal_key(n, "data-calendar") + ds_cal_key(n, "data-mode") + ds_cal_key(
        n, "data-week-start"
    ) + ds_cal_key(n, "data-min") + ds_cal_key(n, "data-max") + ds_cal_key(
        n, "data-disabled-days"
    ) + ds_cal_key(
        n, "data-disabled-dates"
    ) + ds_cal_key(n, "data-value")
end

@en "gen_calendar"
@fa "ساخت تقویم"
pub func gen_calendar(n: Node): Output:
    mut o := Output {}
    o.html = DsOpen(n, "div", "calendar", "") + "</div>"
    o.shared_js = ds_cal_script()
    o.shared_css = ds_cal_css()
    ret o
end

@en "gen_date_picker"
@fa "ساخت انتخابگر تاریخ"
pub func gen_date_picker(n: Node): Output:
    mut o := Output {}
    mut ph := Escape(DsAttr(n.attrs, "data-placeholder"))
    if ph == "":
        ph = "Pick a date"
    end
    mut hidden := ""
    name := DsAttr(n.attrs, "data-name")
    if name != "":
        hidden = "<input type=\"hidden\" data-slot=\"date-picker-input\" name=\"" + name + "\">"
    end
    o.html = DsOpen(
        n, "div", "date-picker", " data-state=\"closed\""
    ) + hidden + "<button type=\"button\" data-slot=\"date-picker-trigger\" data-placeholder>" +
        DS_CAL_ICON + "<span data-slot=\"date-picker-value\">" + ph + "</span></button>" +
        "<div data-slot=\"date-picker-content\" popover=\"manual\" hidden tabindex=\"-1\"><div data-slot=\"calendar\"" +
        ds_cal_keys(n) + "></div></div></div>"
    o.shared_js = ds_cal_script() + ds_picker_script()
    o.shared_css = ds_cal_css()
    ret o
end
