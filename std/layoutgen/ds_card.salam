package layoutgen

pub const DS_CARD_CSS := `
:where([data-slot="card"]){display:flex;flex-direction:column;gap:24px;border-radius:var(--radius-xl);border:1px solid var(--border);background:var(--card);padding:24px 0;color:var(--card-foreground);box-shadow:var(--ds-shadow-sm)}
:where([data-slot="card-header"]){display:grid;grid-auto-rows:min-content;grid-template-rows:auto auto;align-items:start;gap:8px;padding:0 24px}
:where([data-slot="card-header"]:has([data-slot="card-action"])){grid-template-columns:1fr auto}
:where([data-slot="card-header"].border-b){padding-bottom:24px;border-bottom:1px solid var(--border)}
:where([data-slot="card-title"]){font-weight:600;line-height:1}
:where([data-slot="card-description"]){font-size:14px;line-height:20px;color:var(--muted-foreground)}
:where([data-slot="card-action"]){grid-column-start:2;grid-row:1/span 2;align-self:start;justify-self:end}
:where([data-slot="card-content"]){padding:0 24px}
:where([data-slot="card-footer"]){display:flex;flex-direction:row;align-items:center;padding:0 24px}
:where([data-slot="card-footer"].border-t){padding-top:24px;border-top:1px solid var(--border)}
`

pub func ds_part(n: Node, slot: str): str:
    ret "<div data-slot=\"" + slot + "\"" + n.attrs + ClassAttr(n, "") + ">" + Escape(n.content) +
        n.inner + "</div>"
end

pub func ds_part_output(n: Node, slot: str, css: str): Output:
    mut o := Output {}
    o.html = ds_part(n, slot)
    if DsOn():
        o.shared_css = css
    end
    ret o
end

@en "gen_card"
@fa "ساخت کارت"
pub func gen_card(n: Node): Output:
    ret ds_part_output(n, "card", DS_CARD_CSS)
end

@en "gen_card_header"
@fa "ساخت سربرگ کارت"
pub func gen_card_header(n: Node): Output:
    ret ds_part_output(n, "card-header", DS_CARD_CSS)
end

@en "gen_card_title"
@fa "ساخت عنوان کارت"
pub func gen_card_title(n: Node): Output:
    ret ds_part_output(n, "card-title", DS_CARD_CSS)
end

@en "gen_card_description"
@fa "ساخت توضیح کارت"
pub func gen_card_description(n: Node): Output:
    ret ds_part_output(n, "card-description", DS_CARD_CSS)
end

@en "gen_card_action"
@fa "ساخت کنش کارت"
pub func gen_card_action(n: Node): Output:
    ret ds_part_output(n, "card-action", DS_CARD_CSS)
