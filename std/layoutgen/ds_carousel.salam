package layoutgen

pub const DS_CAROUSEL_MIN_CSS := `
:where([data-slot="carousel"]){position:relative}
:where([data-slot="carousel-content"]){display:flex;flex-direction:row;gap:16px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior:contain}
:where([data-slot="carousel-content"])::-webkit-scrollbar{display:none}
:where([data-slot="carousel"][data-orientation="vertical"]>[data-slot="carousel-content"]){flex-direction:column;overflow-x:hidden;overflow-y:auto;scroll-snap-type:y mandatory;height:100%}
:where([data-slot="carousel-content"][data-dragging]){scroll-snap-type:none;cursor:grabbing;user-select:none}
:where([data-slot="carousel-item"]){min-width:0;flex:0 0 100%;scroll-snap-align:start}
:where([data-slot="carousel-dots"]){display:flex;flex-direction:row;justify-content:center;gap:8px;margin-top:12px}
@media (prefers-reduced-motion:no-preference){:where([data-slot="carousel-content"]){scroll-behavior:smooth}}
`

pub const DS_CAROUSEL_CSS := `
:where([data-slot="carousel-content"]){cursor:grab}
button:where([data-slot="carousel-previous"],[data-slot="carousel-next"]){all:unset;box-sizing:border-box;position:absolute;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border:1px solid var(--border);border-radius:9999px;background:var(--ds-outline-bg);box-shadow:var(--ds-shadow-xs);color:inherit;cursor:pointer;transition:background .15s}
button:where([data-slot="carousel-previous"]:hover,[data-slot="carousel-next"]:hover){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="carousel-previous"]:focus-visible,[data-slot="carousel-next"]:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}
button:where([data-slot="carousel-previous"]:disabled,[data-slot="carousel-next"]:disabled){pointer-events:none;opacity:.5}
button:where([data-slot="carousel-previous"],[data-slot="carousel-next"]) svg{width:16px;height:16px;pointer-events:none}
:where(:dir(rtl)) button:where([data-slot="carousel-previous"],[data-slot="carousel-next"]) svg{transform:scaleX(-1)}
:where([data-slot="carousel"][data-orientation="horizontal"]) button:where([data-slot="carousel-previous"]){top:50%;inset-inline-start:-48px;margin-top:-16px}
:where([data-slot="carousel"][data-orientation="horizontal"]) button:where([data-slot="carousel-next"]){top:50%;inset-inline-end:-48px;margin-top:-16px}
:where([data-slot="carousel"][data-orientation="vertical"]) button:where([data-slot="carousel-previous"]){top:-48px;left:50%;margin-left:-16px;transform:rotate(90deg)}
:where([data-slot="carousel"][data-orientation="vertical"]) button:where([data-slot="carousel-next"]){bottom:-48px;left:50%;margin-left:-16px;transform:rotate(90deg)}
button:where([data-slot="carousel-dot"]){all:unset;box-sizing:border-box;width:8px;height:8px;border-radius:9999px;background:var(--border);cursor:pointer;transition:background .15s,width .15s}
button:where([data-slot="carousel-dot"][data-active]){background:var(--primary);width:20px}
button:where([data-slot="carousel-dot"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-soft)}
`

pub const DS_CAROUSEL_JS := `
var timers=[];
function each(l,f){for(var i=0;i<l.length;i++)f(l[i],i)}
function q(r,s){return r.querySelector(s)}
function items(root){return Array.prototype.slice.call(q(root,'[data-slot="carousel-content"]').children)}
function vert(root){return root.getAttribute('data-orientation')==='vertical'}
function delta(root,it){
var c=q(root,'[data-slot="carousel-content"]'),cr=c.getBoundingClientRect(),ir=it.getBoundingClientRect();
if(vert(root))return ir.top-cr.top;
return getComputedStyle(c).direction==='rtl'?ir.right-cr.right:ir.left-cr.left
}
function current(root){
var l=items(root),best=0,min=1e9;
each(l,function(it,i){var d=Math.abs(delta(root,it));if(d<min){min=d;best=i}});
return best
}
function go(root,i,instant){
var l=items(root),c=q(root,'[data-slot="carousel-content"]');
if(!l.length)return;
if(i<0)i=root.hasAttribute('data-loop')?l.length-1:0;
if(i>=l.length)i=root.hasAttribute('data-loop')?0:l.length-1;
var d=delta(root,l[i]),o={behavior:instant?'instant':'auto'};
if(vert(root))o.top=d;else o.left=d;
c.scrollBy(o)
}
function update(root){
var l=items(root),i=current(root),loop=root.hasAttribute('data-loop');
root.__idx=i;
each(root.querySelectorAll('[data-slot="carousel-dot"]'),function(b,k){var on=k===i;b.setAttribute('aria-selected',on?'true':'false');if(on)b.setAttribute('data-active','');else b.removeAttribute('data-active')});
var p=q(root,'[data-slot="carousel-previous"]'),n=q(root,'[data-slot="carousel-next"]');
if(p)p.disabled=!loop&&i<=0;
if(n)n.disabled=!loop&&i>=l.length-1;
each(l,function(it,k){it.setAttribute('aria-label',(k+1)+' of '+l.length)})
}
function init(root){
if(root.__ready)return;
root.__ready=true;
var c=q(root,'[data-slot="carousel-content"]');
if(!c)return;
if(!root.hasAttribute('data-orientation'))root.setAttribute('data-orientation','horizontal');
var dots=q(root,'[data-slot="carousel-dots"]');
if(dots){
dots.setAttribute('role','tablist');
each(items(root),function(it,i){var b=document.createElement('button');b.type='button';b.setAttribute('data-slot','carousel-dot');b.setAttribute('role','tab');b.setAttribute('aria-label','Go to slide '+(i+1));dots.appendChild(b)})
}
var raf=0;
c.addEventListener('scroll',function(){if(raf)return;raf=requestAnimationFrame(function(){raf=0;update(root)})});
var ap=parseInt(root.getAttribute('data-autoplay')||'0',10);
if(ap>0){
var hold=false,t=setInterval(function(){if(!hold&&!document.hidden){var l=items(root);if(root.hasAttribute('data-loop')||root.__idx<l.length-1)go(root,root.__idx+1);else go(root,0)}},ap);
timers.push(t);
root.addEventListener('pointerenter',function(){hold=true});
root.addEventListener('pointerleave',function(){hold=false});
root.addEventListener('focusin',function(){hold=true});
root.addEventListener('focusout',function(){hold=false})
}
var sx=0,sy=0,start=0,drag=false,moved=false;
c.addEventListener('pointerdown',function(e){
if(e.pointerType==='touch'||e.button!==0)return;
drag=true;moved=false;sx=e.clientX;sy=e.clientY;start=vert(root)?c.scrollTop:c.scrollLeft
});
c.addEventListener('pointermove',function(e){
if(!drag)return;
var d=vert(root)?e.clientY-sy:e.clientX-sx;
if(Math.abs(d)>4&&!moved){moved=true;c.setAttribute('data-dragging','');try{c.setPointerCapture(e.pointerId)}catch(x){}}
if(moved){if(vert(root))c.scrollTop=start-d;else c.scrollLeft=start-d}
});
function end(){
if(!drag)return;
drag=false;
if(moved){c.removeAttribute('data-dragging');go(root,current(root))}
}
c.addEventListener('pointerup',end);
c.addEventListener('pointercancel',end);
c.addEventListener('click',function(e){if(moved){e.preventDefault();e.stopPropagation();moved=false}},true);
c.addEventListener('dragstart',function(e){e.preventDefault()});
update(root)
}
function initAll(){each(document.querySelectorAll('[data-slot="carousel"]'),init)}
window.salamDsCarousel={init:initAll,go:function(r,i,n){init(r);go(r,i,n)}};
document.addEventListener('click',function(e){
var b=e.target.closest&&e.target.closest('[data-slot="carousel-previous"],[data-slot="carousel-next"],[data-slot="carousel-dot"]');
if(!b)return;
var r=b.closest('[data-slot="carousel"]');
init(r);
var s=b.getAttribute('data-slot');
if(s==='carousel-previous')go(r,current(r)-1);
else if(s==='carousel-next')go(r,current(r)+1);
else go(r,Array.prototype.indexOf.call(b.parentNode.children,b))
});
document.addEventListener('keydown',function(e){
var r=e.target.closest&&e.target.closest('[data-slot="carousel"]');
if(!r||e.target.closest('input,textarea,select'))return;
init(r);
var rtl=getComputedStyle(r).direction==='rtl',v=vert(r),k=e.key,d=0;
if(v){if(k==='ArrowUp')d=-1;else if(k==='ArrowDown')d=1}
else if(k==='ArrowLeft')d=rtl?1:-1;
else if(k==='ArrowRight')d=rtl?-1:1;
if(k==='Home'){e.preventDefault();go(r,0);return}
if(k==='End'){e.preventDefault();go(r,items(r).length-1);return}
if(d){e.preventDefault();go(r,current(r)+d)}
});
window.addEventListener('resize',function(){each(document.querySelectorAll('[data-slot="carousel"]'),function(r){if(r.__ready)go(r,r.__idx||0,true)})});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
`

pub const DS_CAR_PREV := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>`

pub const DS_CAR_NEXT := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`

func ds_carousel_css(): str:
    if DsOn():
        ret DS_CAROUSEL_MIN_CSS + DS_CAROUSEL_CSS
    end
    ret DS_CAROUSEL_MIN_CSS
end

func ds_carousel_out(n: Node, tag: str, slot: str, extra: str, lead: str, tail: str): Output:
    mut o := Output {}
    o.html = DsOpen(
        n, tag, slot, extra
    ) + lead + Escape(n.content) + n.inner + tail + "</" + tag + ">"
    o.shared_js = "(function(){if(window.salamDsCarousel)return;" + DS_CAROUSEL_JS + "})();"
    o.shared_css = ds_carousel_css()
    ret o
end

@en "gen_carousel"
@fa "ساخت چرخ و فلک"
pub func gen_carousel(n: Node): Output:
    mut extra := " role=\"region\" aria-roledescription=\"carousel\" tabindex=\"0\""
    if DsAttr(n.attrs, "data-orientation") == "":
        extra += " data-orientation=\"horizontal\""
    end
    mut tail := ""
    if DsHas(n.attrs, "data-dots"):
        tail = "<div data-slot=\"carousel-dots\"></div>"
    end
    ret ds_carousel_out(n, "div", "carousel", extra, "", tail)
end

@en "gen_carousel_content"
@fa "ساخت محتوای چرخ و فلک"
pub func gen_carousel_content(n: Node): Output:
    ret ds_carousel_out(n, "div", "carousel-content", "", "", "")
end

@en "gen_carousel_item"
@fa "ساخت اسلاید"
pub func gen_carousel_item(n: Node): Output:
    ret ds_carousel_out(
        n, "div", "carousel-item", " role=\"group\" aria-roledescription=\"slide\"", "", ""
    )
end

@en "gen_carousel_previous"
@fa "ساخت دکمه قبلی"
pub func gen_carousel_previous(n: Node): Output:
    ret ds_carousel_out(
        n,
        "button",
        "carousel-previous",
        " type=\"button\" aria-label=\"Previous slide\"",
        DS_CAR_PREV,
        ""
    )
end

@en "gen_carousel_next"
@fa "ساخت دکمه بعدی"
pub func gen_carousel_next(n: Node): Output:
    ret ds_carousel_out(
        n, "button", "carousel-next", " type=\"button\" aria-label=\"Next slide\"", DS_CAR_NEXT, ""
    )
end
