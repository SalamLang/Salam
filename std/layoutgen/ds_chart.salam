package layoutgen

pub const DS_CHART_MIN_CSS := `
:where([data-slot="chart-data"]){display:none}
:where([data-slot="chart"]){display:flex;flex-direction:column;width:100%;min-width:0}
:where([data-slot="chart-plot"]){position:relative;width:100%}
:where([data-slot="chart-plot"]) svg{display:block;max-width:100%;overflow:visible}
:where([data-slot="chart-tooltip"]){position:absolute;z-index:10;pointer-events:none}
:where([data-slot="chart-tooltip"][hidden]){display:none}
`

pub const DS_CHART_CSS := `
:where([data-slot="chart"]){font-size:12px;line-height:16px;color:var(--foreground)}
:where([data-slot="chart-slice"]){transition:transform .15s ease}
:where([data-slot="chart-dot"]){transition:r .15s}
:where([data-slot="chart-tooltip"]){display:grid;gap:6px;min-width:128px;padding:6px 10px;border:1px solid color-mix(in oklab,var(--border) 50%,transparent);border-radius:var(--radius-lg);background:var(--background);color:var(--foreground);box-shadow:var(--ds-shadow-lg);font-size:12px;line-height:16px}
:where([data-slot="chart-tip-label"]){font-weight:500}
:where([data-slot="chart-tip-row"]){display:flex;flex-direction:row;align-items:center;gap:8px}
:where([data-slot="chart-tip-dot"]){display:inline-block;flex-shrink:0;width:8px;height:8px;border-radius:2px}
:where([data-slot="chart-tip-name"]){flex:1;color:var(--muted-foreground)}
:where([data-slot="chart-tip-value"]){margin-inline-start:auto;font-weight:500;font-variant-numeric:tabular-nums}
:where([data-slot="chart-tip-pct"]){color:var(--muted-foreground)}
:where([data-slot="chart-legend"]){display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:center;gap:16px;padding-top:12px}
:where([data-slot="chart-legend-item"]){display:flex;flex-direction:row;align-items:center;gap:6px}
`

pub const DS_CHART_JS := `
var NS='http://www.w3.org/2000/svg',T=0;
function each(l,f){for(var i=0;i<l.length;i++)f(l[i],i)}
function q(r,s){return r.querySelector(s)}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function fmt(n){return Number(n).toLocaleString()}
function color(s,i){return s?esc(s):'var(--chart-'+(i%5+1)+')'}
function read(root){
var out=[];
each(root.querySelectorAll('[data-slot="chart-series"]'),function(s,si){
var pts=[];
each(s.querySelectorAll('[data-slot="chart-point"]'),function(p,pi){pts.push({label:p.getAttribute('data-label')||'',value:parseFloat(p.getAttribute('data-value'))||0,color:p.getAttribute('data-color')||''})});
out.push({label:s.getAttribute('data-label')||'@@Series@@ '+(si+1),color:color(s.getAttribute('data-color'),si),points:pts})
});
return out
}
function nice(x){
if(x<=0)return 1;
var e=Math.pow(10,Math.floor(Math.log(x)/Math.LN10)),f=x/e;
return(f<=1?1:f<=2?2:f<=2.5?2.5:f<=5?5:10)*e
}
function curve(p){
if(p.length<2)return'';
var d='M'+p[0][0]+' '+p[0][1];
for(var i=0;i<p.length-1;i++){
var a=p[i-1]||p[i],b=p[i],c=p[i+1],e=p[i+2]||c;
d+=' C'+(b[0]+(c[0]-a[0])/6)+' '+(b[1]+(c[1]-a[1])/6)+' '+(c[0]-(e[0]-b[0])/6)+' '+(c[1]-(e[1]-b[1])/6)+' '+c[0]+' '+c[1]
}
return d
}
function arc(cx,cy,r0,r1,a0,a1){
var big=a1-a0>Math.PI?1:0,c=Math.cos,s=Math.sin;
var d='M'+(cx+r1*c(a0))+' '+(cy+r1*s(a0))+' A'+r1+' '+r1+' 0 '+big+' 1 '+(cx+r1*c(a1))+' '+(cy+r1*s(a1));
if(r0>0)d+=' L'+(cx+r0*c(a1))+' '+(cy+r0*s(a1))+' A'+r0+' '+r0+' 0 '+big+' 0 '+(cx+r0*c(a0))+' '+(cy+r0*s(a0))+' Z';
else d+=' L'+cx+' '+cy+' Z';
return d
}
function tip(root,html,x,y){
var t=q(root,'[data-slot="chart-tooltip"]'),pl=q(root,'[data-slot="chart-plot"]');
if(!t)return;
if(html===null){t.hidden=true;return}
t.innerHTML=html;t.hidden=false;
var w=t.offsetWidth,h=t.offsetHeight,pw=pl.clientWidth;
var left=x+14;if(left+w>pw)left=x-w-14;if(left<0)left=0;
var top=y-h-8;if(top<0)top=y+14;
t.style.left=left+'px';t.style.top=top+'px'
}
function row(c,name,val){return '<div data-slot="chart-tip-row"><span data-slot="chart-tip-dot" style="background:'+c+'"></span><span data-slot="chart-tip-name">'+esc(name)+'</span><span data-slot="chart-tip-value">'+fmt(val)+'</span></div>'}
function cartesian(root,data,type,W,H,svgParts){
var m={t:12,r:12,b:30,l:12},iw=W-m.l-m.r,ih=H-m.t-m.b,n=0,stacked=root.hasAttribute('data-stacked'),S=data.length;
each(data,function(s){if(s.points.length>n)n=s.points.length});
if(!n)return null;
var cats=[],vals=[];
for(var c=0;c<n;c++){var l='';each(data,function(s){if(!l&&s.points[c])l=s.points[c].label});cats.push(l)}
var max=0;
for(var c2=0;c2<n;c2++){var sum=0;each(data,function(s){var v=s.points[c2]?s.points[c2].value:0;if(stacked)sum+=v;else if(v>max)max=v});if(stacked&&sum>max)max=sum}
var ymax=nice(max),band=iw/n;
function y(v){return m.t+ih-(v/ymax)*ih}
function cx(c){return m.l+band*(c+.5)}
var grid=root.getAttribute('data-grid')!=='false';
if(grid)for(var g=0;g<=4;g++){var gy=y(ymax*g/4);svgParts.push('<line x1="'+m.l+'" x2="'+(W-m.r)+'" y1="'+gy+'" y2="'+gy+'" stroke="var(--border)" stroke-width="1"'+(g>0?' stroke-dasharray="3 3"':'')+' opacity="'+(g>0?'.8':'1')+'"/>')}
svgParts.push('<rect data-slot="chart-cursor" x="0" y="'+m.t+'" width="0" height="'+ih+'" fill="var(--muted)" opacity=".5" rx="4" hidden/>');
var base=[];for(var z=0;z<n;z++)base.push(0);
each(data,function(s,si){
var col=s.color;
if(type==='bar'){
var gw=stacked?Math.min(48,band*.6):Math.min(36*S,band*.8),bw=stacked?gw:(gw-(S-1)*4)/S;
each(s.points,function(p,c){
var x=stacked?cx(c)-bw/2:cx(c)-gw/2+si*(bw+4),h=p.value/ymax*ih,yy=stacked?y(base[c]+p.value):y(p.value);
svgParts.push('<rect data-slot="chart-bar" x="'+x+'" y="'+yy+'" width="'+Math.max(0,bw)+'" height="'+Math.max(0,h)+'" rx="4" fill="'+color(p.color,si)+'"/>');
if(stacked)base[c]+=p.value
})
}else{
var pts=[],top=[],bot=[];
each(s.points,function(p,c){var lo=stacked?base[c]:0;top.push([cx(c),y(lo+p.value)]);bot.push([cx(c),y(lo)]);if(stacked)base[c]+=p.value});
var d=curve(top);
if(type==='area'){
var id='salam-ch-'+(++T);
svgParts.push('<defs><linearGradient id="'+id+'" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stop-color="'+col+'" stop-opacity=".8"/><stop offset="95%" stop-color="'+col+'" stop-opacity=".1"/></linearGradient></defs>');
var back=bot.slice().reverse(),dd;
if(stacked){dd=d+' L'+back[0][0]+' '+back[0][1]+' '+curve(back).replace(/^M[^C]*/,'')}else{dd=d+' L'+top[top.length-1][0]+' '+y(0)+' L'+top[0][0]+' '+y(0)+' Z'}
svgParts.push('<path data-slot="chart-area" d="'+dd+' Z" fill="url(#'+id+')" stroke="none"/>')
}
svgParts.push('<path data-slot="chart-line" d="'+d+'" fill="none" stroke="'+col+'" stroke-width="2" stroke-linecap="round"/>');
if(type==='line')each(top,function(p){svgParts.push('<circle data-slot="chart-dot" cx="'+p[0]+'" cy="'+p[1]+'" r="4" fill="'+col+'"/>')})
}
});
var skip=Math.ceil(44/band);
each(cats,function(l,c){if(c%skip===0)svgParts.push('<text x="'+cx(c)+'" y="'+(H-9)+'" text-anchor="middle" fill="var(--muted-foreground)" font-size="12">'+esc(l)+'</text>')});
return{n:n,band:band,m:m,cats:cats,cx:cx,ih:ih,stacked:stacked}
}
function render(root){
var data=read(root),type=root.getAttribute('data-type')||'bar',pl=q(root,'[data-slot="chart-plot"]');
if(!pl){pl=document.createElement('div');pl.setAttribute('data-slot','chart-plot');root.appendChild(pl)}
var W=Math.max(120,pl.clientWidth||root.clientWidth||400),H=parseInt(root.getAttribute('data-height')||'250',10),parts=[],info=null,slices=null;
var pie=type==='pie'||type==='donut';
if(pie){
var pts=data.length?data[0].points:[],tot=0;
each(pts,function(p){tot+=Math.max(0,p.value)});
var r=Math.min(W,H)/2-8,cxx=W/2,cyy=H/2,a=-Math.PI/2,r0=type==='donut'?r*.6:0;
slices=[];
each(pts,function(p,i){
var v=Math.max(0,p.value),a1=a+(tot?v/tot:0)*Math.PI*2;
if(a1-a>=Math.PI*2)a1=a+Math.PI*2-.0001;
if(v>0)parts.push('<path data-slot="chart-slice" data-i="'+i+'" d="'+arc(cxx,cyy,r0,r,a,a1)+'" fill="'+color(p.color,i)+'" stroke="var(--background)" stroke-width="2"/>');
var mid=(a+a1)/2;slices.push({p:p,i:i,mx:Math.cos(mid),my:Math.sin(mid)});
a=a1
});
if(type==='donut'){
var cl=root.getAttribute('data-center')||'';
parts.push('<text x="'+cxx+'" y="'+(cl?cyy-2:cyy+10)+'" text-anchor="middle" fill="var(--foreground)" font-size="28" font-weight="700">'+fmt(tot)+'</text>');
if(cl)parts.push('<text x="'+cxx+'" y="'+(cyy+20)+'" text-anchor="middle" fill="var(--muted-foreground)" font-size="12">'+esc(cl)+'</text>')
}
root.__tot=tot
}else info=cartesian(root,data,type,W,H,parts);
pl.innerHTML='<svg role="img" aria-label="'+esc(root.getAttribute('data-label')||'@@Chart@@')+'" width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'">'+parts.join('')+'</svg><div data-slot="chart-tooltip" hidden></div>';
if(root.hasAttribute('data-legend')){
var lg=q(root,'[data-slot="chart-legend"]');
if(!lg){lg=document.createElement('div');lg.setAttribute('data-slot','chart-legend');root.appendChild(lg)}
var h='';
if(pie)each(slices||[],function(s){h+='<span data-slot="chart-legend-item"><span data-slot="chart-tip-dot" style="background:'+color(s.p.color,s.i)+'"></span>'+esc(s.p.label)+'</span>'});
else each(data,function(s){h+='<span data-slot="chart-legend-item"><span data-slot="chart-tip-dot" style="background:'+s.color+'"></span>'+esc(s.label)+'</span>'});
lg.innerHTML=h
}
var svg=q(pl,'svg'),cur=q(pl,'[data-slot="chart-cursor"]');
svg.addEventListener('pointermove',function(e){
var b=svg.getBoundingClientRect(),px=e.clientX-b.left,py=e.clientY-b.top;
if(pie){
var s=e.target.closest&&e.target.closest('[data-slot="chart-slice"]');
each(svg.querySelectorAll('[data-slot="chart-slice"]'),function(x){x.removeAttribute('data-active');x.style.transform=''});
if(!s){tip(root,null);return}
var sl=slices[parseInt(s.getAttribute('data-i'),10)];
s.setAttribute('data-active','');s.style.transform='translate('+sl.mx*4+'px,'+sl.my*4+'px)';
var pc=root.__tot?Math.round(sl.p.value/root.__tot*1000)/10:0;
tip(root,row(color(sl.p.color,sl.i),sl.p.label,sl.p.value)+'<div data-slot="chart-tip-pct">'+pc+'%</div>',px,py);
return
}
if(!info)return;
var c=Math.floor((px-info.m.l)/info.band);
if(c<0||c>=info.n){tip(root,null);if(cur)cur.setAttribute('hidden','');return}
if(cur){
if(type==='bar'){cur.setAttribute('x',info.cx(c)-info.band/2);cur.setAttribute('width',info.band);cur.removeAttribute('hidden')}else cur.setAttribute('hidden','')
}
var html='<div data-slot="chart-tip-label">'+esc(info.cats[c])+'</div>';
each(data,function(s,si){var p=s.points[c];if(p)html+=row(s.color,s.label,p.value)});
tip(root,html,px,py)
});
svg.addEventListener('pointerleave',function(){tip(root,null);if(cur)cur.setAttribute('hidden','');each(svg.querySelectorAll('[data-slot="chart-slice"]'),function(x){x.style.transform=''})})
}
function init(root){
if(root.__ready)return;
root.__ready=true;
render(root);
var w=root.clientWidth;
if(window.ResizeObserver){var raf=0;new ResizeObserver(function(){if(root.clientWidth===w)return;w=root.clientWidth;if(raf)cancelAnimationFrame(raf);raf=requestAnimationFrame(function(){render(root)})}).observe(root)}
}
function initAll(){each(document.querySelectorAll('[data-slot="chart"]'),init)}
window.salamDsChart={init:initAll,render:function(r){init(r);render(r)}};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
`

func ds_chart_css(): str:
    if DsOn():
        ret DS_CHART_MIN_CSS + DS_CHART_CSS
    end
    ret DS_CHART_MIN_CSS
end

func ds_chart_out(html: str): Output:
    mut o := Output {}
    o.html = html
    o.shared_js = DsJs("(function(){if(window.salamDsChart)return;" + DS_CHART_JS + "})();")
    o.shared_css = ds_chart_css()
    ret o
end

@en "gen_chart"
@fa "ساخت نمودار"
pub func gen_chart(n: Node): Output:
    mut extra := ""
    if DsAttr(n.attrs, "data-type") == "":
        extra = " data-type=\"bar\""
    end
    ret ds_chart_out(
        DsOpen(
            n, "div", "chart", extra
        ) + "<div data-slot=\"chart-data\">" + n.inner + "</div></div>"
    )
end

@en "gen_chart_series"
@fa "ساخت سری نمودار"
pub func gen_chart_series(n: Node): Output:
    ret ds_chart_out(DsOpen(n, "div", "chart-series", "") + n.inner + "</div>")
end

@en "gen_chart_point"
@fa "ساخت نقطه نمودار"
pub func gen_chart_point(n: Node): Output:
    ret ds_chart_out(DsOpen(n, "span", "chart-point", "") + "</span>")
end
