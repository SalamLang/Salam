package layoutgen

pub const DS_DIALOG_MIN_CSS := `
dialog:where([data-overlay]:not([open])){display:none}
dialog:where([data-overlay]){position:fixed;inset:0;margin:auto;width:fit-content;height:fit-content;max-height:calc(100dvh - 2rem);max-width:calc(100% - 2rem);overflow:auto;opacity:1;transition:opacity .2s ease,transform .2s ease}
dialog:where([data-overlay][data-state="closed"]){opacity:0}
dialog:where([data-overlay])::backdrop{background:rgb(0 0 0/.5);transition:opacity .2s ease}
dialog:where([data-overlay][data-state="closed"])::backdrop{opacity:0}
:where(body:has(dialog[data-overlay][open])){overflow:hidden}
dialog:where([data-slot="sheet"],[data-slot="drawer"]){max-width:none;max-height:none;margin:0;opacity:1;transition:transform .3s ease-in-out}
dialog:where([data-slot="sheet"][data-state="open"],[data-slot="drawer"][data-state="open"]){transition-duration:.5s}
dialog:where([data-slot="sheet"][data-state="closed"],[data-slot="drawer"][data-state="closed"]){opacity:1}
dialog:where([data-side="right"]){inset:0 0 0 auto;height:100%;width:min(75%,24rem)}
dialog:where([data-side="left"]){inset:0 auto 0 0;height:100%;width:min(75%,24rem)}
dialog:where([data-side="top"]){inset:0 0 auto 0;width:100%;height:auto}
dialog:where([data-side="bottom"]){inset:auto 0 0 0;width:100%;height:auto;max-height:80vh}
dialog:where([data-side="top"][data-slot="drawer"]){max-height:80vh}
dialog:where([data-slot="sheet"][data-side="right"][data-state="closed"],[data-slot="drawer"][data-side="right"][data-state="closed"]){transform:translateX(100%)}
dialog:where([data-slot="sheet"][data-side="left"][data-state="closed"],[data-slot="drawer"][data-side="left"][data-state="closed"]){transform:translateX(-100%)}
dialog:where([data-slot="sheet"][data-side="top"][data-state="closed"],[data-slot="drawer"][data-side="top"][data-state="closed"]){transform:translateY(-100%)}
dialog:where([data-slot="sheet"][data-side="bottom"][data-state="closed"],[data-slot="drawer"][data-side="bottom"][data-state="closed"]){transform:translateY(100%)}
@media (prefers-reduced-motion:reduce){dialog:where([data-overlay]),dialog:where([data-overlay])::backdrop{transition:none!important}}
`

pub const DS_DIALOG_CSS := `
dialog:where([data-slot="dialog"],[data-slot="alert-dialog"]){grid-template-columns:minmax(0,1fr);justify-content:stretch;align-content:start;width:min(32rem,calc(100% - 2rem));padding:24px;gap:16px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--background);color:var(--foreground);box-shadow:var(--ds-shadow-lg);outline:none}
dialog:where([data-slot="dialog"][open],[data-slot="alert-dialog"][open]){display:grid}
dialog:where([data-slot="dialog"][data-state="closed"],[data-slot="alert-dialog"][data-state="closed"]){transform:scale(.95)}
dialog:where([data-slot="alert-dialog"][data-size="sm"]){width:min(20rem,calc(100% - 2rem))}
:where([data-slot="dialog-header"]){display:flex;flex-direction:column;gap:8px;text-align:center}
:where([data-slot="dialog-footer"]){display:flex;flex-direction:column-reverse;gap:8px}
:where([data-slot="dialog-title"],[data-slot="alert-dialog-title"]){margin:0;font-size:18px;line-height:1;font-weight:600}
:where([data-slot="dialog-description"],[data-slot="alert-dialog-description"],[data-slot="sheet-description"],[data-slot="drawer-description"]){margin:0;font-size:14px;line-height:20px;color:var(--muted-foreground)}
:where([data-slot="alert-dialog-header"]){display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto 1fr;place-items:center;gap:6px;text-align:center}
:where([data-slot="alert-dialog-footer"]){display:flex;flex-direction:column-reverse;gap:8px}
:where(dialog[data-size="sm"] [data-slot="alert-dialog-footer"]){display:grid;grid-template-columns:1fr 1fr}
:where([data-slot="alert-dialog-media"]){display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;margin-bottom:8px;border-radius:var(--radius-md);background:var(--muted)}
:where([data-slot="alert-dialog-media"] svg){width:32px;height:32px}
@media (min-width:640px){
:where([data-slot="dialog-header"]){text-align:start}
:where([data-slot="dialog-footer"]){flex-direction:row;justify-content:flex-end}
:where(dialog[data-size="default"] [data-slot="alert-dialog-header"]){place-items:start;text-align:start}
:where(dialog[data-size="default"] [data-slot="alert-dialog-header"]:has([data-slot="alert-dialog-media"])){grid-template-rows:auto 1fr;grid-template-columns:auto 1fr;column-gap:24px}
:where(dialog[data-size="default"] [data-slot="alert-dialog-header"]>[data-slot="alert-dialog-media"]){grid-row:span 2}
:where(dialog[data-size="default"] [data-slot="alert-dialog-header"]:has([data-slot="alert-dialog-media"])>[data-slot="alert-dialog-title"]){grid-column-start:2}
:where(dialog[data-size="default"] [data-slot="alert-dialog-footer"]){flex-direction:row;justify-content:flex-end}
}
button:where([data-slot="dialog-x"]){all:unset;box-sizing:border-box;position:absolute;top:16px;inset-inline-end:16px;display:inline-flex;border-radius:2px;opacity:.7;cursor:pointer;transition:opacity .15s}
button:where([data-slot="dialog-x"]:hover){opacity:1}
button:where([data-slot="dialog-x"]:focus-visible){opacity:1;box-shadow:0 0 0 2px var(--background),0 0 0 4px var(--ring)}
button:where([data-slot="dialog-x"] svg){pointer-events:none;flex-shrink:0;width:16px;height:16px}
`

pub const DS_SHEET_CSS := `
dialog:where([data-slot="sheet"],[data-slot="drawer"]){padding:0;gap:16px;background:var(--background);color:var(--foreground);box-shadow:var(--ds-shadow-lg);outline:none;border:0 solid var(--border)}
dialog:where([data-slot="sheet"][open],[data-slot="drawer"][open]){display:flex;flex-direction:column}
dialog:where([data-side="right"]){border-left-width:1px}
dialog:where([data-side="left"]){border-right-width:1px}
dialog:where([data-side="top"]){border-bottom-width:1px}
dialog:where([data-side="bottom"]){border-top-width:1px}
dialog:where([data-slot="drawer"][data-side="top"]){border-radius:0 0 var(--radius-lg) var(--radius-lg)}
dialog:where([data-slot="drawer"][data-side="bottom"]){border-radius:var(--radius-lg) var(--radius-lg) 0 0}
:where([data-slot="sheet-header"],[data-slot="drawer-header"]){display:flex;flex-direction:column;gap:6px;padding:16px}
:where([data-slot="sheet-footer"],[data-slot="drawer-footer"]){display:flex;flex-direction:column;gap:8px;margin-top:auto;padding:16px}
:where([data-slot="sheet-title"],[data-slot="drawer-title"]){margin:0;font-size:16px;line-height:24px;font-weight:600;color:var(--foreground)}
:where(dialog[data-slot="drawer"]:is([data-side="top"],[data-side="bottom"]) [data-slot="drawer-header"]){text-align:center}
@media (min-width:768px){:where([data-slot="drawer-header"]){gap:6px;text-align:start}}
:where([data-slot="drawer-handle"]){display:none;flex-shrink:0;width:100px;height:8px;margin:16px auto 0;border-radius:9999px;background:var(--muted)}
:where(dialog[data-side="bottom"] [data-slot="drawer-handle"]){display:block}
`

pub const DS_DIALOG_JS := `
(function(){
if(window.salamDsDialog)return;
var seq=0;
function reduced(){return window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches}
function ownerDialog(el){var d=el&&el.closest?el.closest('dialog[data-overlay]'):null;return d}
function label(d){
var t=d.querySelector('[data-slot$="-title"]'),s=d.querySelector('[data-slot$="-description"]');
if(t&&!d.hasAttribute('aria-labelledby')){if(!t.id)t.id='salam-dlg-t'+(++seq);d.setAttribute('aria-labelledby',t.id)}
if(s&&!d.hasAttribute('aria-describedby')){if(!s.id)s.id='salam-dlg-d'+(++seq);d.setAttribute('aria-describedby',s.id)}
}
function open(d,opener){
if(!d||d.tagName!=='DIALOG'||d.open)return;
d.__ret=opener||document.activeElement;
label(d);
d.setAttribute('data-state','closed');
d.showModal();
void d.offsetWidth;
d.setAttribute('data-state','open');
var c=d.querySelector('[data-slot="alert-dialog-cancel"]');
if(c)c.focus();
d.dispatchEvent(new CustomEvent('ds-open',{bubbles:true}))
}
function restore(d){var r=d.__ret;d.__ret=null;if(r&&r.focus&&document.contains(r))r.focus()}
function close(d,reason){
if(!d||!d.open||d.__closing)return;
d.__closing=true;
d.style.transform='';
d.setAttribute('data-state','closed');
var done=function(){d.__closing=false;if(d.open)d.close(reason||'');restore(d)};
if(reduced())done();else setTimeout(done,d.getAttribute('data-slot')==='sheet'||d.getAttribute('data-slot')==='drawer'?300:200)
}
window.salamDsDialog={open:open,close:close};
document.addEventListener('click',function(e){
var t=e.target,o=t.closest&&t.closest('[data-opens]');
if(o){var d=document.getElementById(o.getAttribute('data-opens'));if(d){e.preventDefault();open(d,o)}return}
var x=t.closest&&t.closest('[data-dialog-close]');
if(x){var od=ownerDialog(x);if(od){close(od,'close')}return}
if(t.tagName==='DIALOG'&&t.hasAttribute('data-overlay')&&t.getAttribute('data-slot')!=='alert-dialog'){
var r=t.getBoundingClientRect();
if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)close(t,'overlay')
}
});
document.addEventListener('cancel',function(e){
var d=e.target;
if(d&&d.tagName==='DIALOG'&&d.hasAttribute('data-overlay')){e.preventDefault();close(d,'escape')}
},true);
document.addEventListener('close',function(e){
var d=e.target;
if(d&&d.tagName==='DIALOG'&&d.hasAttribute('data-overlay')){
d.setAttribute('data-state','closed');
restore(d);
d.dispatchEvent(new CustomEvent('ds-close',{bubbles:true,detail:{reason:d.returnValue}}))
}
},true);
var drag=null;
document.addEventListener('pointerdown',function(e){
var d=ownerDialog(e.target);
if(!d||d.getAttribute('data-slot')!=='drawer')return;
if(e.target.closest('button,a,input,select,textarea,[contenteditable]'))return;
var side=d.getAttribute('data-side');
if((side==='bottom'||side==='top')&&d.scrollTop>0)return;
drag={d:d,x:e.clientX,y:e.clientY,side:side,n:0};
});
document.addEventListener('pointermove',function(e){
if(!drag)return;
var dx=e.clientX-drag.x,dy=e.clientY-drag.y,s=drag.side,n=s==='bottom'?dy:s==='top'?-dy:s==='right'?dx:-dx;
if(n<=0){drag.n=0;drag.d.style.transform='';return}
drag.n=n;
drag.d.style.transition='none';
drag.d.style.transform=(s==='bottom'||s==='top'?'translateY(':'translateX(')+((s==='bottom'||s==='right')?n:-n)+'px)'
});
function endDrag(){
if(!drag)return;
var d=drag.d,n=drag.n;drag=null;
d.style.transition='';
if(n>80)close(d,'drag');else d.style.transform=''
}
document.addEventListener('pointerup',endDrag);
document.addEventListener('pointercancel',endDrag);
function init(){var l=document.querySelectorAll('dialog[data-overlay][open]');for(var i=0;i<l.length;i++)l[i].setAttribute('data-state','open')}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init()
})();
`

func ds_dialog_css(): str:
    if DsOn():
        ret DS_DIALOG_MIN_CSS + DS_DIALOG_CSS + DS_SHEET_CSS + DS_BUTTON_CSS
    end
    ret DS_DIALOG_MIN_CSS
end

func ds_close_x(): str:
    ret "<button type=\"button\" data-slot=\"dialog-x\" data-dialog-close aria-label=\"Close\">" +
        DS_ICON_X + "</button>"
end

func ds_part(n: Node, tag: str, slot: str): Output:
    mut o := Output {}
    o.html = DsOpen(n, tag, slot, "") + Escape(n.content) + n.inner + "</" + tag + ">"
    o.shared_js = DS_DIALOG_JS
    o.shared_css = ds_dialog_css()
    ret o
end

func ds_overlay_root(n: Node, slot: str, extra: str, close: bool, side: str, lead: str): Output:
    mut o := Output {}
    mut attrs := " data-overlay data-state=\"closed\"" + extra
    if side != "" and DsAttr(n.attrs, "data-side") == "":
        attrs += " data-side=\"" + side + "\""
    end
    mut tail := ""
    if close and DsAttr(n.attrs, "data-show-close") != "false":
        tail = ds_close_x()
    end
    o.html = DsOpen(
        n, "dialog", slot, attrs
    ) + lead + Escape(n.content) + n.inner + tail + "</dialog>"
    o.shared_js = DS_DIALOG_JS
    o.shared_css = ds_dialog_css()
    ret o
end

func ds_overlay_button(n: Node, slot: str, fallback: str): Output:
    mut o := Output {}
    mut extra := " type=\"button\" data-dialog-close"
    if DsAttr(n.attrs, "data-variant") == "" and fallback != "":
        extra += " data-variant=\"" + fallback + "\""
    end
    o.html = DsOpen(n, "button", slot, extra) + Escape(n.content) + n.inner + "</button>"
    o.shared_js = DS_DIALOG_JS
    o.shared_css = ds_dialog_css()
    ret o
end

@en "gen_dialog"
@fa "ساخت پنجره گفتگو"
pub func gen_dialog(n: Node): Output:
    ret ds_overlay_root(n, "dialog", "", true, "", "")
end

@en "gen_dialog_trigger"
@fa "ساخت دکمه پنجره"
pub func gen_dialog_trigger(n: Node): Output:
    mut o := Output {}
    o.html = DsOpen(
        n, "span", "dialog-trigger", " style=\"display:contents\""
    ) + Escape(n.content) + n.inner + "</span>"
    o.shared_js = DS_DIALOG_JS
    ret o
end

@en "gen_dialog_header"
@fa "ساخت سرایند پنجره"
pub func gen_dialog_header(n: Node): Output:
    ret ds_part(n, "div", "dialog-header")
end

@en "gen_dialog_title"
@fa "ساخت عنوان پنجره"
pub func gen_dialog_title(n: Node): Output:
    ret ds_part(n, "h2", "dialog-title")
end

@en "gen_dialog_description"
@fa "ساخت توضیح پنجره"
pub func gen_dialog_description(n: Node): Output:
    ret ds_part(n, "p", "dialog-description")
end

