@en "gen_dialog_close"
@fa "ساخت دکمه بستن پنجره"
pub func gen_dialog_close(n: Node): Output:
    ret ds_overlay_button(n, "dialog-close", "outline")
end

@en "gen_alert_dialog"
@fa "ساخت پنجره هشدار"
pub func gen_alert_dialog(n: Node): Output:
    mut size := ""
    if DsAttr(n.attrs, "data-size") == "":
        size = " data-size=\"default\""
    end
    ret ds_overlay_root(n, "alert-dialog", " role=\"alertdialog\"" + size, false, "", "")
end

