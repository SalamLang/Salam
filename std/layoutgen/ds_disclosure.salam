package layoutgen

pub const DS_DISCLOSURE_MIN_CSS := `
:where([data-slot="accordion-content"],[data-slot="collapsible-content"]){display:grid;grid-template-rows:1fr;transition:grid-template-rows .2s ease,visibility .2s}
:where([data-slot="accordion-item"][data-state="closed"]>[data-slot="accordion-content"],[data-slot="collapsible"][data-state="closed"]>[data-slot="collapsible-content"],[data-slot="collapsible-content"][data-state="closed"]){grid-template-rows:0fr;visibility:hidden}
:where([data-slot="accordion-content"]>div,[data-slot="collapsible-content"]>div){min-height:0;overflow:hidden}
:where([data-slot="accordion-trigger"] svg){transition:transform .2s}
:where([data-slot="accordion-trigger"][data-state="open"]>svg){transform:rotate(180deg)}
@media (prefers-reduced-motion:reduce){:where([data-slot="accordion-content"],[data-slot="collapsible-content"],[data-slot="accordion-trigger"] svg){transition:none}}
`

pub const DS_TABS_CSS := `
:where([data-slot="tabs"]){display:flex;flex-direction:row;gap:8px}
:where([data-slot="tabs"][data-orientation="horizontal"]){flex-direction:column}
:where([data-slot="tabs-list"]){display:inline-flex;flex-direction:row;width:fit-content;align-items:center;justify-content:center;border-radius:var(--radius-lg);padding:3px;color:var(--muted-foreground);background:var(--muted)}
:where([data-slot="tabs"][data-orientation="horizontal"] [data-slot="tabs-list"]){height:36px}
:where([data-slot="tabs"][data-orientation="vertical"] [data-slot="tabs-list"]){height:fit-content;flex-direction:column}
:where([data-slot="tabs-list"][data-variant="line"]){gap:4px;background:transparent;border-radius:0}
button:where([data-slot="tabs-trigger"]){all:unset;box-sizing:border-box;position:relative;display:inline-flex;height:calc(100% - 1px);flex:1;align-items:center;justify-content:center;gap:6px;border-radius:var(--radius-md);border:1px solid transparent;padding:4px 8px;font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;cursor:pointer;color:var(--ds-tab-fg);transition:all .15s}
button:where([data-slot="tabs-trigger"]:hover){color:var(--foreground)}
button:where([data-slot="tabs-trigger"]:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft);outline:1px solid var(--ring)}
button:where([data-slot="tabs-trigger"]:disabled){pointer-events:none;opacity:.5}
button:where([data-slot="tabs-trigger"] svg){pointer-events:none;flex-shrink:0;width:16px;height:16px}
button:where([data-slot="tabs-trigger"][data-state="active"]){background:var(--ds-tab-active-bg);color:var(--foreground);border-color:var(--ds-tab-active-border)}
:where([data-slot="tabs-list"][data-variant="default"]) button:where([data-slot="tabs-trigger"][data-state="active"]){box-shadow:var(--ds-shadow-sm)}
:where([data-slot="tabs-list"][data-variant="line"]) button:where([data-slot="tabs-trigger"]),:where([data-slot="tabs-list"][data-variant="line"]) button:where([data-slot="tabs-trigger"][data-state="active"]){background:transparent;box-shadow:none;border-color:transparent}
button:where([data-slot="tabs-trigger"])::after{content:"";position:absolute;background:var(--foreground);opacity:0;transition:opacity .15s}
:where([data-slot="tabs"][data-orientation="horizontal"]) button:where([data-slot="tabs-trigger"])::after{inset-inline:0;bottom:-5px;height:2px}
:where([data-slot="tabs"][data-orientation="vertical"]) button:where([data-slot="tabs-trigger"])::after{inset-block:0;inset-inline-end:-4px;width:2px}
:where([data-slot="tabs"][data-orientation="vertical"]) button:where([data-slot="tabs-trigger"]){width:100%;justify-content:flex-start}
:where([data-slot="tabs-list"][data-variant="line"]) button:where([data-slot="tabs-trigger"][data-state="active"])::after{opacity:1}
:where([data-slot="tabs-content"]){flex:1;outline:none}
`

pub const DS_ACCORDION_CSS := `
:where([data-slot="accordion-item"]){border-bottom:1px solid var(--border)}
:where([data-slot="accordion-item"]:last-child){border-bottom:0}
:where([data-slot="accordion-header"]){display:flex;flex-direction:row;margin:0;font:inherit}
button:where([data-slot="accordion-trigger"]){all:unset;box-sizing:border-box;display:flex;flex:1;align-items:flex-start;justify-content:space-between;gap:16px;border-radius:var(--radius-md);padding:16px 0;text-align:start;font-size:14px;line-height:20px;font-weight:500;cursor:pointer;transition:all .15s;border:1px solid transparent}
button:where([data-slot="accordion-trigger"]:hover){text-decoration:underline}
button:where([data-slot="accordion-trigger"]:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}
button:where([data-slot="accordion-trigger"]:disabled){pointer-events:none;opacity:.5}
svg:where([data-slot="accordion-trigger"]>svg){pointer-events:none;flex-shrink:0;width:16px;height:16px;transform:translateY(2px);color:var(--muted-foreground);transition:transform .2s}
svg:where([data-slot="accordion-trigger"][data-state="open"]>svg){transform:translateY(2px) rotate(180deg)}
:where([data-slot="accordion-content"]){font-size:14px;line-height:20px}
:where([data-slot="accordion-content"]>div>div){padding:0 0 16px}
`

pub const DS_TABS_JS := `
(function(){
if(window.salamDsTabs)return;
var seq=0;
function each(l,f){for(var i=0;i<l.length;i++)f(l[i],i)}
function mine(root,sel){var out=[];each(root.querySelectorAll(sel),function(e){if(e.closest('[data-slot="tabs"]')===root)out.push(e)});return out}
function triggers(root){return mine(root,'[data-slot="tabs-trigger"]')}
function enabled(root){return triggers(root).filter(function(t){return !t.disabled&&t.getAttribute('aria-disabled')!=='true'})}
function select(root,val,silent){
var ps=mine(root,'[data-slot="tabs-content"]'),ts=triggers(root),found=false;
each(ts,function(t){if(t.getAttribute('data-value')===val&&!t.disabled)found=true});
if(!found)return;
each(ts,function(t){var on=t.getAttribute('data-value')===val;t.setAttribute('aria-selected',on?'true':'false');t.setAttribute('data-state',on?'active':'inactive');t.setAttribute('tabindex',on?'0':'-1')});
each(ps,function(p){var on=p.getAttribute('data-value')===val;p.setAttribute('data-state',on?'active':'inactive');if(on){p.removeAttribute('hidden');p.setAttribute('tabindex','0')}else{p.setAttribute('hidden','');p.removeAttribute('tabindex')}});
root.setAttribute('data-active',val);
if(!silent)root.dispatchEvent(new CustomEvent('ds-change',{bubbles:true,detail:{value:val}}))
}
function init(root){
if(root.getAttribute('data-ready'))return;
root.setAttribute('data-ready','1');
if(!root.getAttribute('data-orientation'))root.setAttribute('data-orientation','horizontal');
var ts=triggers(root),ps=mine(root,'[data-slot="tabs-content"]');
each(mine(root,'[data-slot="tabs-list"]'),function(l){l.setAttribute('aria-orientation',root.getAttribute('data-orientation'))});
each(ts,function(t){if(!t.id)t.id='salam-tab-'+(++seq);t.setAttribute('role','tab');t.setAttribute('type','button')});
each(ps,function(p){if(!p.id)p.id='salam-tabpanel-'+(++seq);p.setAttribute('role','tabpanel')});
each(ts,function(t){each(ps,function(p){if(p.getAttribute('data-value')===t.getAttribute('data-value')){t.setAttribute('aria-controls',p.id);p.setAttribute('aria-labelledby',t.id)}})});
var first=enabled(root)[0],v=root.getAttribute('data-default-value');
if(!v&&first)v=first.getAttribute('data-value');
select(root,v,true);
if(!root.getAttribute('data-active')&&first)select(root,first.getAttribute('data-value'),true)
}
function initAll(){each(document.querySelectorAll('[data-slot="tabs"]'),init)}
window.salamDsTabs=initAll;
document.addEventListener('click',function(e){
var t=e.target.closest&&e.target.closest('[data-slot="tabs-trigger"]');
if(!t||t.disabled)return;
var root=t.closest('[data-slot="tabs"]');
if(!root)return;
init(root);
select(root,t.getAttribute('data-value'))
});
document.addEventListener('keydown',function(e){
var t=e.target.closest&&e.target.closest('[data-slot="tabs-trigger"]');
if(!t)return;
var root=t.closest('[data-slot="tabs"]');
if(!root)return;
init(root);
var vert=root.getAttribute('data-orientation')==='vertical';
var rtl=getComputedStyle(root).direction==='rtl';
var next=vert?'ArrowDown':(rtl?'ArrowLeft':'ArrowRight');
var prev=vert?'ArrowUp':(rtl?'ArrowRight':'ArrowLeft');
var list=enabled(root),i=list.indexOf(t),to=-1;
if(e.key===next)to=(i+1)%list.length;
else if(e.key===prev)to=(i-1+list.length)%list.length;
else if(e.key==='Home')to=0;
else if(e.key==='End')to=list.length-1;
if(to<0||!list.length)return;
e.preventDefault();
list[to].focus();
select(root,list[to].getAttribute('data-value'))
});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
})();
`

pub const DS_ACCORDION_JS := `
(function(){
if(window.salamDsAccordion)return;
var seq=0;
function each(l,f){for(var i=0;i<l.length;i++)f(l[i],i)}
function own(root,sel){var out=[];each(root.querySelectorAll(sel),function(e){if(e.closest('[data-slot="accordion"]')===root)out.push(e)});return out}
function part(item,sel){var r=null;each(item.querySelectorAll(sel),function(e){if(!r&&e.closest('[data-slot="accordion-item"]')===item)r=e});return r}
function set(item,open){
item.setAttribute('data-state',open?'open':'closed');
var t=part(item,'[data-slot="accordion-trigger"]'),c=part(item,'[data-slot="accordion-content"]');
if(t){t.setAttribute('aria-expanded',open?'true':'false');t.setAttribute('data-state',open?'open':'closed')}
if(c){c.setAttribute('data-state',open?'open':'closed');c.inert=!open}
}
function init(root){
if(root.getAttribute('data-ready'))return;
root.setAttribute('data-ready','1');
var items=own(root,'[data-slot="accordion-item"]'),single=root.getAttribute('data-type')!=='multiple',dv=root.getAttribute('data-default-value'),opened=false;
each(items,function(it){
var t=part(it,'[data-slot="accordion-trigger"]'),c=part(it,'[data-slot="accordion-content"]');
if(t&&c){if(!t.id)t.id='salam-acc-t'+(++seq);if(!c.id)c.id='salam-acc-c'+(++seq);t.setAttribute('aria-controls',c.id);c.setAttribute('aria-labelledby',t.id);c.setAttribute('role','region');t.setAttribute('type','button')}
var open=it.hasAttribute('data-open')||(dv!==null&&dv===it.getAttribute('data-value'));
if(single&&open){if(opened)open=false;opened=true}
set(it,open)
})
}
function initAll(){each(document.querySelectorAll('[data-slot="accordion"]'),init)}
window.salamDsAccordion=initAll;
document.addEventListener('click',function(e){
var t=e.target.closest&&e.target.closest('[data-slot="accordion-trigger"]');
if(!t||t.disabled)return;
var item=t.closest('[data-slot="accordion-item"]'),root=t.closest('[data-slot="accordion"]');
if(!item||!root)return;
init(root);
var open=item.getAttribute('data-state')==='open';
if(root.getAttribute('data-type')==='multiple'){set(item,!open)}
else if(open){if(root.hasAttribute('data-collapsible'))set(item,false)}
else{each(own(root,'[data-slot="accordion-item"]'),function(o){if(o!==item)set(o,false)});set(item,true)}
root.dispatchEvent(new CustomEvent('ds-change',{bubbles:true,detail:{value:item.getAttribute('data-value'),open:item.getAttribute('data-state')==='open'}}))
});
document.addEventListener('keydown',function(e){
var t=e.target.closest&&e.target.closest('[data-slot="accordion-trigger"]');
if(!t)return;
var root=t.closest('[data-slot="accordion"]');
if(!root)return;
var list=[];
each(own(root,'[data-slot="accordion-trigger"]'),function(x){if(!x.disabled)list.push(x)});
var i=list.indexOf(t),to=-1;
if(e.key==='ArrowDown')to=(i+1)%list.length;
else if(e.key==='ArrowUp')to=(i-1+list.length)%list.length;
else if(e.key==='Home')to=0;
else if(e.key==='End')to=list.length-1;
if(to<0)return;
e.preventDefault();
list[to].focus()
});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
})();
`

pub const DS_COLLAPSIBLE_JS := `
(function(){
if(window.salamDsCollapsible)return;
var seq=0;
function each(l,f){for(var i=0;i<l.length;i++)f(l[i],i)}
function own(root,sel){var out=[];each(root.querySelectorAll(sel),function(e){if(e.closest('[data-slot="collapsible"]')===root)out.push(e)});return out}
function set(root,open){
root.setAttribute('data-state',open?'open':'closed');
each(own(root,'[data-slot="collapsible-trigger"]'),function(t){t.setAttribute('aria-expanded',open?'true':'false');t.setAttribute('data-state',open?'open':'closed')});
each(own(root,'[data-slot="collapsible-content"]'),function(c){c.setAttribute('data-state',open?'open':'closed');c.inert=!open})
}
function init(root){
if(root.getAttribute('data-ready'))return;
root.setAttribute('data-ready','1');
var cs=own(root,'[data-slot="collapsible-content"]');
each(own(root,'[data-slot="collapsible-trigger"]'),function(t){if(cs[0]){if(!cs[0].id)cs[0].id='salam-col-'+(++seq);t.setAttribute('aria-controls',cs[0].id)}t.setAttribute('type','button')});
set(root,root.hasAttribute('data-open'))
}
function initAll(){each(document.querySelectorAll('[data-slot="collapsible"]'),init)}
window.salamDsCollapsible=initAll;
document.addEventListener('click',function(e){
var t=e.target.closest&&e.target.closest('[data-slot="collapsible-trigger"]');
if(!t||t.disabled)return;
var root=t.closest('[data-slot="collapsible"]');
if(!root)return;
init(root);
var open=root.getAttribute('data-state')!=='open';
set(root,open);
root.dispatchEvent(new CustomEvent('ds-change',{bubbles:true,detail:{open:open}}))
});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
})();
`

func ds_tabs_tokens(): str:
    ret DsThemeTokens(
        "--ds-tab-fg:color-mix(in oklab,var(--foreground) 60%,transparent);--ds-tab-active-bg:var(--background);--ds-tab-active-border:transparent",
        "--ds-tab-fg:var(--muted-foreground);--ds-tab-active-bg:color-mix(in oklab,var(--input) 30%,transparent);--ds-tab-active-border:var(--input)"
    )
end

func ds_disclosure_css(extra: str): str:
    if DsOn():
        ret DS_DISCLOSURE_MIN_CSS + extra
    end
    ret DS_DISCLOSURE_MIN_CSS
end

@en "gen_tabs"
@fa "ساخت زبانه ها"
pub func gen_tabs(n: Node): Output:
    mut o := Output {}
    mut extra := ""
    if DsAttr(n.attrs, "data-orientation") == "":
        extra = " data-orientation=\"horizontal\""
    end
    o.html = DsOpen(n, "div", "tabs", extra) + Escape(n.content) + n.inner + "</div>"
    o.shared_js = DS_TABS_JS
    if DsOn():
        o.shared_css = ds_tabs_tokens() + DS_TABS_CSS
    end
    ret o
end

@en "gen_tab_list"
@fa "ساخت فهرست زبانه"
pub func gen_tab_list(n: Node): Output:
    mut o := Output {}
    mut extra := " role=\"tablist\""
    if DsAttr(n.attrs, "data-variant") == "":
        extra += " data-variant=\"default\""
    end
    o.html = DsOpen(n, "div", "tabs-list", extra) + n.inner + "</div>"
    ret o
end

@en "gen_tab_trigger"
@fa "ساخت دکمه زبانه"
pub func gen_tab_trigger(n: Node): Output:
    mut o := Output {}
    o.html = DsOpen(
        n, "button", "tabs-trigger", " type=\"button\" role=\"tab\" aria-selected=\"false\""
    ) + Escape(n.content) + n.inner + "</button>"
    ret o
end

@en "gen_tab_content"
@fa "ساخت محتوای زبانه"
pub func gen_tab_content(n: Node): Output:
    mut o := Output {}
    o.html = DsOpen(
        n, "div", "tabs-content", " role=\"tabpanel\""
    ) + Escape(n.content) + n.inner + "</div>"
    ret o
end

@en "gen_accordion"
@fa "ساخت آکاردئون"
pub func gen_accordion(n: Node): Output:
    mut o := Output {}
    o.html = DsOpen(n, "div", "accordion", "") + n.inner + "</div>"
    o.shared_js = DS_ACCORDION_JS
    o.shared_css = ds_disclosure_css(DS_ACCORDION_CSS)
    ret o
end

@en "gen_accordion_item"
@fa "ساخت بخش آکاردئون"
pub func gen_accordion_item(n: Node): Output:
    mut o := Output {}
    mut state := "closed"
    if DsHas(n.attrs, "data-open"):
        state = "open"
    end
    o.html = DsOpen(
        n, "div", "accordion-item", " data-state=\"" + state + "\""
    ) + n.inner + "</div>"
    ret o
end

@en "gen_accordion_trigger"
@fa "ساخت دکمه آکاردئون"
pub func gen_accordion_trigger(n: Node): Output:
    mut o := Output {}
    o.html = "<h3 data-slot=\"accordion-header\">" + DsOpen(
        n, "button", "accordion-trigger", " type=\"button\" aria-expanded=\"false\""
    ) + Escape(n.content) + n.inner + DS_ICON_CHEVRON_DOWN + "</button></h3>"
    ret o
end

@en "gen_accordion_content"
@fa "ساخت محتوای آکاردئون"
pub func gen_accordion_content(n: Node): Output:
    mut o := Output {}
    o.html = DsOpen(
        n, "div", "accordion-content", " role=\"region\""
    ) + "<div><div>" + Escape(n.content) + n.inner + "</div></div></div>"
    ret o
end

@en "gen_collapsible"
@fa "ساخت جمع شونده"
pub func gen_collapsible(n: Node): Output:
    mut o := Output {}
    mut state := "closed"
    if DsHas(n.attrs, "data-open"):
        state = "open"
    end
    o.html = DsOpen(n, "div", "collapsible", " data-state=\"" + state + "\"") + n.inner + "</div>"
    o.shared_js = DS_COLLAPSIBLE_JS
    o.shared_css = DS_DISCLOSURE_MIN_CSS
    ret o
end

@en "gen_collapsible_trigger"
@fa "ساخت دکمه جمع شونده"
pub func gen_collapsible_trigger(n: Node): Output:
    mut o := Output {}
    o.html = DsOpen(
        n, "button", "collapsible-trigger", " type=\"button\" aria-expanded=\"false\""
    ) + Escape(n.content) + n.inner + "</button>"
    ret o
end

@en "gen_collapsible_content"
@fa "ساخت محتوای جمع شونده"
pub func gen_collapsible_content(n: Node): Output:
    mut o := Output {}
    o.html = DsOpen(
        n, "div", "collapsible-content", ""
    ) + "<div>" + Escape(n.content) + n.inner + "</div></div>"
    ret o
end
