package layoutgen

pub const DS_SEPARATOR_CSS := `
:where([data-slot="separator"]){flex-shrink:0;border:0;background:var(--border)}
:where([data-slot="separator"][data-orientation="horizontal"]){height:1px;width:100%}
:where([data-slot="separator"][data-orientation="vertical"]){height:100%;width:1px;align-self:stretch}
`

pub const DS_PROGRESS_CSS := `
@keyframes ds-progress-slide{from{background-position:-50% 0}to{background-position:150% 0}}
:where(progress[data-slot="progress"]){appearance:none;-webkit-appearance:none;display:block;position:relative;height:8px;width:100%;overflow:hidden;border:0;border-radius:9999px;background:color-mix(in oklab,var(--primary) 20%,transparent);color:var(--primary)}
:where(progress[data-slot="progress"])::-webkit-progress-bar{background:transparent;border-radius:9999px}
:where(progress[data-slot="progress"])::-webkit-progress-value{background:var(--primary);border-radius:9999px;transition:width .2s}
:where(progress[data-slot="progress"])::-moz-progress-bar{background:var(--primary);border-radius:9999px}
:where(progress[data-slot="progress"]:indeterminate){background:linear-gradient(90deg,transparent 0,var(--primary) 50%,transparent 100%) -50% 0/50% 100% no-repeat,color-mix(in oklab,var(--primary) 20%,transparent);animation:ds-progress-slide 1.4s ease-in-out infinite}
@media (prefers-reduced-motion:reduce){:where(progress[data-slot="progress"]:indeterminate){animation:none;background-position:50% 0}}
:where(meter[data-slot="meter"]){appearance:none;-webkit-appearance:none;display:block;height:8px;width:100%;overflow:hidden;border:0;border-radius:9999px;background:color-mix(in oklab,var(--primary) 20%,transparent)}
:where(meter[data-slot="meter"])::-webkit-meter-bar{background:transparent;border:0;height:8px;border-radius:9999px}
:where(meter[data-slot="meter"])::-webkit-meter-optimum-value{background:var(--primary);border-radius:9999px;transition:width .2s}
:where(meter[data-slot="meter"])::-webkit-meter-suboptimum-value{background:color-mix(in oklab,var(--destructive) 50%,var(--primary));border-radius:9999px}
:where(meter[data-slot="meter"])::-webkit-meter-even-less-good-value{background:var(--destructive);border-radius:9999px}
:where(meter[data-slot="meter"])::-moz-meter-bar{background:var(--primary);border-radius:9999px}
:where(meter[data-slot="meter"]:-moz-meter-sub-optimum)::-moz-meter-bar{background:color-mix(in oklab,var(--destructive) 50%,var(--primary))}
:where(meter[data-slot="meter"]:-moz-meter-sub-sub-optimum)::-moz-meter-bar{background:var(--destructive)}
`

pub const DS_SKELETON_CSS := `
@keyframes ds-pulse{50%{opacity:.5}}
:where([data-slot="skeleton"]){border-radius:var(--radius-md);background:var(--accent);animation:ds-pulse 2s cubic-bezier(.4,0,.6,1) infinite}
@media (prefers-reduced-motion:reduce){:where([data-slot="skeleton"]){animation:none}}
`

pub const DS_SPINNER_CSS := `
@keyframes ds-spin{to{transform:rotate(360deg)}}
:where(svg[data-slot="spinner"]){flex-shrink:0;animation:ds-spin 1s linear infinite}
@media (prefers-reduced-motion:reduce){:where(svg[data-slot="spinner"]){animation-duration:3s}}
`

pub const DS_AVATAR_CSS := `
:where([data-slot="avatar"]){position:relative;display:flex;width:32px;height:32px;flex-shrink:0;overflow:hidden;border-radius:9999px;user-select:none}
:where([data-slot="avatar"][data-size="sm"]){width:24px;height:24px}
:where([data-slot="avatar"][data-size="lg"]){width:40px;height:40px}
:where([data-slot="avatar-image"]){position:absolute;inset:0;aspect-ratio:1/1;width:100%;height:100%;object-fit:cover}
:where([data-slot="avatar-fallback"]){display:flex;width:100%;height:100%;align-items:center;justify-content:center;border-radius:9999px;background:var(--muted);color:var(--muted-foreground);font-size:14px;line-height:20px}
:where([data-slot="avatar"][data-size="sm"] [data-slot="avatar-fallback"]){font-size:12px;line-height:16px}
:where([data-slot="avatar-badge"]){position:absolute;inset-inline-end:0;bottom:0;z-index:10;display:inline-flex;align-items:center;justify-content:center;width:10px;height:10px;border-radius:9999px;background:var(--primary);color:var(--primary-foreground);box-shadow:0 0 0 2px var(--background);user-select:none}
:where([data-slot="avatar-badge"]>svg){width:8px;height:8px}
:where([data-slot="avatar"][data-size="sm"] [data-slot="avatar-badge"]){width:8px;height:8px}
:where([data-slot="avatar"][data-size="sm"] [data-slot="avatar-badge"]>svg){display:none}
:where([data-slot="avatar"][data-size="lg"] [data-slot="avatar-badge"]){width:12px;height:12px}
:where([data-slot="avatar-group"]){display:flex;flex-direction:row}
:where([data-slot="avatar-group"]>*+*){margin-inline-start:-8px}
:where([data-slot="avatar-group"]>[data-slot="avatar"]){box-shadow:0 0 0 2px var(--background)}
:where([data-slot="avatar-group-count"]){position:relative;display:flex;width:32px;height:32px;flex-shrink:0;align-items:center;justify-content:center;border-radius:9999px;background:var(--muted);color:var(--muted-foreground);font-size:14px;line-height:20px;box-shadow:0 0 0 2px var(--background)}
:where([data-slot="avatar-group-count"]>svg){width:16px;height:16px}
:where([data-slot="avatar-group"]:has([data-size="lg"]) [data-slot="avatar-group-count"]){width:40px;height:40px}
:where([data-slot="avatar-group"]:has([data-size="lg"]) [data-slot="avatar-group-count"]>svg){width:20px;height:20px}
:where([data-slot="avatar-group"]:has([data-size="sm"]) [data-slot="avatar-group-count"]){width:24px;height:24px}
:where([data-slot="avatar-group"]:has([data-size="sm"]) [data-slot="avatar-group-count"]>svg){width:12px;height:12px}
`

pub const DS_ASPECT_CSS := `
:where([data-slot="aspect-ratio"]){position:relative;width:100%}
:where([data-slot="aspect-ratio"]>img,[data-slot="aspect-ratio"]>video){width:100%;height:100%;object-fit:cover}
`

pub const DS_AVATAR_JS := `(function(){
if(window.salamDsAvatar){return}
function lose(i){i.style.display="none"}
function win(i){var p=i.parentNode,f=p&&p.querySelector('[data-slot="avatar-fallback"]');if(f){f.style.display="none"}}
function scan(){var a=document.querySelectorAll('img[data-slot="avatar-image"]'),i;for(i=0;i<a.length;i++){if(a[i].complete){if(a[i].naturalWidth===0){lose(a[i])}else{win(a[i])}}}}
window.salamDsAvatar=scan;
document.addEventListener("error",function(e){var t=e.target;if(t&&t.getAttribute&&t.getAttribute("data-slot")==="avatar-image"){lose(t)}},true);
document.addEventListener("load",function(e){var t=e.target;if(t&&t.getAttribute&&t.getAttribute("data-slot")==="avatar-image"){win(t)}},true);
if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",scan)}else{scan()}
})();`

func ds_orient_attr(n: Node): str:
    if DsAttr(n.attrs, "data-orientation") == "":
        ret " data-orientation=\"horizontal\""
    end
    ret ""
end

func ds_ratio_value(n: Node): str:
    r := DsAttr(n.attrs, "data-ratio")
    mut ok := r != ""
    repeat r.Len() in i:
        c := r.Substr(i, 1)
        if c != "/" and c != "." and (c < "0" or c > "9"):
            ok = false
        end
    end
    if not ok:
        ret "1"
    end
    ret r
end

@en "gen_separator"
@fa "ساخت جداکننده"
pub func gen_separator(n: Node): Output:
    mut o := Output {}
    mut role := " role=\"none\""
    if DsAttr(n.attrs, "data-orientation") == "vertical":
        role = " role=\"none\" aria-orientation=\"vertical\""
    end
    o.html = "<div data-slot=\"separator\"" + role + ds_orient_attr(n) + n.attrs +
        ClassAttr(n, "") + "></div>"
    if DsOn():
        o.shared_css = DS_SEPARATOR_CSS
    end
    ret o
end

@en "gen_line"
@fa "ساخت خط"
pub func gen_line(n: Node): Output:
    mut o := Output {}
    o.html = "<hr data-slot=\"separator\"" + ds_orient_attr(n) + n.attrs + ClassAttr(n, "") + ">"
    if DsOn():
        o.shared_css = DS_SEPARATOR_CSS
    end
    ret o
end

@en "gen_progress"
@fa "ساخت پیشرفت"
pub func gen_progress(n: Node): Output:
    mut o := Output {}
    o.html = "<progress data-slot=\"progress\"" + n.attrs + ClassAttr(n, "") + ">" +
        Escape(n.content) + n.inner + "</progress>"
    if DsOn():
        o.shared_css = DS_PROGRESS_CSS
    end
    ret o
end

@en "gen_meter"
@fa "ساخت سنجه"
pub func gen_meter(n: Node): Output:
    mut o := Output {}
    o.html = "<meter data-slot=\"meter\"" + n.attrs + ClassAttr(n, "") + ">" + Escape(n.content) +
        n.inner + "</meter>"
    if DsOn():
        o.shared_css = DS_PROGRESS_CSS
    end
    ret o
end

@en "gen_skeleton"
@fa "ساخت اسکلت"
pub func gen_skeleton(n: Node): Output:
    ret ds_part_output(n, "skeleton", DS_SKELETON_CSS)
end

@en "gen_spinner"
@fa "ساخت چرخنده"
pub func gen_spinner(n: Node): Output:
    mut o := Output {}
    mut label := DsT("Loading")
    if n.content != "":
        label = Escape(n.content)
    end
    o.html = "<svg data-slot=\"spinner\" role=\"status\" aria-label=\"" + label +
        "\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:16px;height:16px\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"" +
        n.attrs + ClassAttr(n, "") + "><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"/></svg>"
    if DsOn():
        o.shared_css = DS_SPINNER_CSS
    end
    ret o
end

@en "gen_avatar"
@fa "ساخت آواتار"
pub func gen_avatar(n: Node): Output:
    mut o := Output {}
    o.html = "<span data-slot=\"avatar\"" + n.attrs + ClassAttr(n, "") + ">" + Escape(n.content) +
        n.inner + "</span>"
    o.shared_js = DS_AVATAR_JS
    if DsOn():
        o.shared_css = DS_AVATAR_CSS
    end
    ret o
end

@en "gen_avatar_image"
@fa "ساخت تصویر آواتار"
pub func gen_avatar_image(n: Node): Output:
    mut o := Output {}
    o.html = "<img data-slot=\"avatar-image\"" + n.attrs + ClassAttr(n, "") + ">"
    o.shared_js = DS_AVATAR_JS
    if DsOn():
        o.shared_css = DS_AVATAR_CSS
    end
    ret o
end

