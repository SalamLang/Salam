@en "gen_avatar_group"
@fa "ساخت گروه آواتار"
pub func gen_avatar_group(n: Node): Output:
    ret ds_part_output(n, "avatar-group", DS_AVATAR_CSS)
end

@en "gen_avatar_group_count"
@fa "ساخت شمار گروه آواتار"
pub func gen_avatar_group_count(n: Node): Output:
    ret ds_part_output(n, "avatar-group-count", DS_AVATAR_CSS)
end

@en "gen_aspect_ratio"
@fa "ساخت نسبت تصویر"
pub func gen_aspect_ratio(n: Node): Output:
    mut o := Output {}
    o.html = "<div data-slot=\"aspect-ratio\" style=\"aspect-ratio:" + ds_ratio_value(n) + "\"" +
        n.attrs + ClassAttr(n, "") + ">" + Escape(n.content) + n.inner + "</div>"
    if DsOn():
        o.shared_css = DS_ASPECT_CSS
    end
    ret o
end
