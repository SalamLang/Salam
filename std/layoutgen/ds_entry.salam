@en "gen_entry_description"
@fa "ساخت توضیح مدخل"
pub func gen_entry_description(n: Node): Output:
    mut o := Output {}
    o.html = "<p data-slot=\"item-description\"" + n.attrs + ClassAttr(n, "") + ">" +
        Escape(n.content) + n.inner + "</p>"
    if DsOn():
        o.shared_css = DS_ITEM_CSS
    end
    ret o
end

@en "gen_entry_actions"
@fa "ساخت کنش های مدخل"
pub func gen_entry_actions(n: Node): Output:
    ret ds_part_output(n, "item-actions", DS_ITEM_CSS)
end

@en "gen_entry_header"
@fa "ساخت سربرگ مدخل"
pub func gen_entry_header(n: Node): Output:
