@en "gen_empty_content"
@fa "ساخت محتوای خالی"
pub func gen_empty_content(n: Node): Output:
    ret ds_part_output(n, "empty-content", DS_EMPTY_CSS)
end

@en "gen_entry"
@fa "ساخت مدخل"
pub func gen_entry(n: Node): Output:
    mut o := Output {}
    mut tag := "div"
    if DsAttr(n.attrs, "href") != "":
        tag = "a"
    end
    o.html = "<" + tag + " data-slot=\"item\"" + n.attrs + ClassAttr(n, "") + ">" +
        Escape(n.content) + n.inner + "</" + tag + ">"
    if DsOn():
        o.shared_css = DS_ITEM_CSS
    end
    ret o
end

@en "gen_entry_group"
@fa "ساخت گروه مدخل"
pub func gen_entry_group(n: Node): Output:
    mut o := Output {}
    o.html = "<div role=\"list\" data-slot=\"item-group\"" + n.attrs + ClassAttr(n, "") + ">" +
        Escape(n.content) + n.inner + "</div>"
    if DsOn():
        o.shared_css = DS_ITEM_CSS
    end
    ret o
end

@en "gen_entry_separator"
@fa "ساخت جداکننده مدخل"
pub func gen_entry_separator(n: Node): Output:
    mut o := Output {}
    o.html = "<div role=\"none\" data-orientation=\"horizontal\" data-slot=\"item-separator\"" +
        n.attrs + ClassAttr(n, "") + "></div>"
    if DsOn():
        o.shared_css = DS_ITEM_CSS
    end
    ret o
end

@en "gen_entry_media"
@fa "ساخت رسانه مدخل"
pub func gen_entry_media(n: Node): Output:
    ret ds_part_output(n, "item-media", DS_ITEM_CSS)
end

