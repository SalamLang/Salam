package layoutgen

pub const DS_EMPTY_CSS := `
:where([data-slot="empty"]){display:flex;min-width:0;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:24px;border-radius:var(--radius-lg);padding:24px;text-align:center;text-wrap:balance}
@media (min-width:768px){:where([data-slot="empty"]){padding:48px}}
:where([data-slot="empty-header"]){display:flex;max-width:384px;flex-direction:column;align-items:center;gap:8px;text-align:center}
:where([data-slot="empty-icon"]){display:flex;flex-shrink:0;align-items:center;justify-content:center;margin-bottom:8px;background:transparent}
:where([data-slot="empty-icon"] svg){pointer-events:none;flex-shrink:0}
:where([data-slot="empty-icon"][data-variant="icon"]){width:40px;height:40px;border-radius:var(--radius-lg);background:var(--muted);color:var(--foreground)}
:where([data-slot="empty-icon"][data-variant="icon"] svg){width:24px;height:24px}
:where([data-slot="empty-title"]){font-size:18px;line-height:28px;font-weight:500;letter-spacing:-.025em}
:where([data-slot="empty-description"]){font-size:14px;line-height:1.625;color:var(--muted-foreground)}
:where([data-slot="empty-description"]>a){text-decoration:underline;text-underline-offset:4px}
:where([data-slot="empty-description"]>a:hover){color:var(--primary)}
:where([data-slot="empty-content"]){display:flex;width:100%;max-width:384px;min-width:0;flex-direction:column;align-items:center;gap:16px;font-size:14px;line-height:20px;text-wrap:balance}
`

pub const DS_ITEM_CSS := `
:where([data-slot="item"]){display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:16px;padding:16px;border:1px solid transparent;border-radius:var(--radius-md);background:transparent;color:inherit;font-size:14px;line-height:20px;text-decoration:none;outline:none;transition:color .1s,background-color .1s,border-color .1s,box-shadow .1s}
:where([data-slot="item"]:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}
:where(a[data-slot="item"]:hover){background:color-mix(in oklab,var(--accent) 50%,transparent)}
:where([data-slot="item"][data-variant="outline"]){border-color:var(--border)}
:where([data-slot="item"][data-variant="muted"]){background:color-mix(in oklab,var(--muted) 50%,transparent)}
:where([data-slot="item"][data-size="sm"]){gap:10px;padding:12px 16px}
:where([data-slot="item-group"]){display:flex;flex-direction:column}
:where([data-slot="item-separator"]){flex-shrink:0;width:100%;height:1px;margin:0;background:var(--border)}
:where([data-slot="item-media"]){display:flex;flex-shrink:0;align-items:center;justify-content:center;gap:8px;background:transparent}
:where([data-slot="item-media"] svg){pointer-events:none}
:where([data-slot="item"]:has([data-slot="item-description"]) [data-slot="item-media"]){align-self:flex-start;transform:translateY(2px)}
:where([data-slot="item-media"][data-variant="icon"]){width:32px;height:32px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--muted)}
:where([data-slot="item-media"][data-variant="icon"] svg){width:16px;height:16px}
:where([data-slot="item-media"][data-variant="image"]){width:40px;height:40px;overflow:hidden;border-radius:var(--radius-sm)}
:where([data-slot="item-media"][data-variant="image"] img){width:100%;height:100%;object-fit:cover}
:where([data-slot="item-content"]){display:flex;flex:1;flex-direction:column;gap:4px}
:where([data-slot="item-content"]+[data-slot="item-content"]){flex:none}
:where([data-slot="item-title"]){display:flex;flex-direction:row;width:fit-content;align-items:center;gap:8px;font-size:14px;line-height:1.375;font-weight:500}
:where([data-slot="item-description"]){display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:14px;line-height:1.5;font-weight:400;text-wrap:balance;color:var(--muted-foreground)}
:where([data-slot="item-description"]>a){text-decoration:underline;text-underline-offset:4px}
:where([data-slot="item-description"]>a:hover){color:var(--primary)}
:where([data-slot="item-actions"]){display:flex;flex-direction:row;align-items:center;gap:8px}
:where([data-slot="item-header"]),:where([data-slot="item-footer"]){display:flex;flex-direction:row;flex-basis:100%;align-items:center;justify-content:space-between;gap:8px}
`

@en "gen_empty"
@fa "ساخت خالی"
pub func gen_empty(n: Node): Output:
    ret ds_part_output(n, "empty", DS_EMPTY_CSS)
end

@en "gen_empty_header"
@fa "ساخت سربرگ خالی"
pub func gen_empty_header(n: Node): Output:
    ret ds_part_output(n, "empty-header", DS_EMPTY_CSS)
end

@en "gen_empty_media"
@fa "ساخت رسانه خالی"
pub func gen_empty_media(n: Node): Output:
    ret ds_part_output(n, "empty-icon", DS_EMPTY_CSS)
end

@en "gen_empty_title"
@fa "ساخت عنوان خالی"
pub func gen_empty_title(n: Node): Output:
    ret ds_part_output(n, "empty-title", DS_EMPTY_CSS)
end

@en "gen_empty_description"
@fa "ساخت توضیح خالی"
pub func gen_empty_description(n: Node): Output:
    ret ds_part_output(n, "empty-description", DS_EMPTY_CSS)
