package layoutgen

pub const DS_FLOAT_MIN_CSS := `
:where([data-froot]:not([data-froot="nav"])){display:contents}
:where([data-float]){position:fixed;z-index:50;background:Canvas;color:CanvasText;border:1px solid GrayText;opacity:1;transition:opacity .15s ease,transform .15s ease}
:where([data-float][data-side="top"]){transform-origin:bottom center}
:where([data-float][data-side="bottom"]){transform-origin:top center}
:where([data-float][data-side="left"]){transform-origin:right center}
:where([data-float][data-side="right"]){transform-origin:left center}
:where([data-float][data-state="closed"]){opacity:0;transform:scale(.95)}
:where([data-float][data-side="bottom"][data-state="closed"]){transform:scale(.95) translateY(-8px)}
:where([data-float][data-side="top"][data-state="closed"]){transform:scale(.95) translateY(8px)}
:where([data-float][data-side="right"][data-state="closed"]){transform:scale(.95) translateX(-8px)}
:where([data-float][data-side="left"][data-state="closed"]){transform:scale(.95) translateX(8px)}
:where([data-float][hidden]){display:none}
:where([data-float][data-csspos]){position:absolute}
:where([data-menu-item]:focus){background:Highlight;color:HighlightText;outline:none}
@media (prefers-reduced-motion:reduce){:where([data-float]){transition:none}}
`

pub const DS_FLOAT_CSS := `
:where([data-slot="popover-content"]){width:288px;padding:16px;border-radius:var(--radius-md);border:1px solid var(--border);background:var(--popover);color:var(--popover-foreground);box-shadow:var(--ds-shadow-md);outline:none}
:where([data-slot="popover-header"]){display:flex;flex-direction:column;gap:4px;font-size:14px;line-height:20px}
:where([data-slot="popover-title"]){margin:0;font-weight:500}
:where([data-slot="popover-description"]){margin:0;color:var(--muted-foreground)}
:where([data-slot="tooltip-content"]){width:fit-content;padding:6px 12px;border:0;border-radius:var(--radius-md);background:var(--foreground);color:var(--background);font-size:12px;line-height:16px;text-wrap:balance}
:where([data-slot="tooltip-arrow"]){position:absolute;z-index:50;width:10px;height:10px;border-radius:2px;background:var(--foreground);transform:rotate(45deg)}
:where([data-side="top"]>[data-slot="tooltip-arrow"]){bottom:-3px;inset-inline-start:calc(50% - 5px)}
:where([data-side="bottom"]>[data-slot="tooltip-arrow"]){top:-3px;inset-inline-start:calc(50% - 5px)}
:where([data-side="left"]>[data-slot="tooltip-arrow"]){right:-3px;top:calc(50% - 5px)}
:where([data-side="right"]>[data-slot="tooltip-arrow"]){left:-3px;top:calc(50% - 5px)}
:where([data-slot="hover-card-content"]){width:256px;padding:16px;border-radius:var(--radius-md);border:1px solid var(--border);background:var(--popover);color:var(--popover-foreground);box-shadow:var(--ds-shadow-md);outline:none}
:where([data-slot="menu-content"]){display:flex;flex-direction:column;min-width:128px;max-height:calc(100dvh - 16px);padding:4px;border-radius:var(--radius-md);border:1px solid var(--border);background:var(--popover);color:var(--popover-foreground);box-shadow:var(--ds-shadow-md);overflow-x:hidden;overflow-y:auto;outline:none}
:where([data-froot="sub"]>[data-slot="menu-content"]){min-width:128px;box-shadow:var(--ds-shadow-lg);overflow:hidden}
:where([data-slot="menubar"] [data-slot="menu-content"]){min-width:192px}
:where([data-menu-item]){position:relative;display:flex;flex-direction:row;align-items:center;gap:8px;padding:6px 8px;border-radius:var(--radius-sm);background:transparent;color:inherit;font-size:14px;line-height:20px;cursor:default;user-select:none;outline:none}
:where([data-menu-item]:focus){background:var(--accent);color:var(--accent-foreground)}
:where([data-menu-item][data-disabled]){pointer-events:none;opacity:.5}
:where([data-menu-item][data-inset]){padding-inline-start:32px}
:where([data-menu-item] svg){pointer-events:none;flex-shrink:0;width:16px;height:16px;color:var(--muted-foreground)}
:where([data-menu-item][data-variant="destructive"]){color:var(--destructive)}
:where([data-menu-item][data-variant="destructive"]:focus){background:var(--ds-menu-destructive-focus);color:var(--destructive)}
:where([data-menu-item][data-variant="destructive"] svg){color:var(--destructive)}
:where([role="menuitemcheckbox"],[role="menuitemradio"]){padding:6px 8px;padding-inline-start:32px}
:where([data-menu-indicator]){position:absolute;inset-inline-start:8px;display:none;align-items:center;justify-content:center;width:14px;height:14px}
:where([data-checked]>[data-menu-indicator]){display:flex}
:where([data-menu-indicator] svg){width:16px;height:16px;color:inherit}
:where([role="menuitemradio"]>[data-menu-indicator] svg){width:8px;height:8px}
:where([data-slot="menu-label"]){padding:6px 8px;font-size:14px;line-height:20px;font-weight:500}
:where([data-slot="menu-label"][data-inset]){padding-inline-start:32px}
:where([data-slot="menu-separator"]){height:1px;margin:4px -4px;background:var(--border)}
:where([data-slot="menu-shortcut"]){margin-inline-start:auto;font-size:12px;letter-spacing:.1em;color:var(--muted-foreground)}
:where([data-slot="menu-sub-trigger"][data-state="open"]){background:var(--accent);color:var(--accent-foreground)}
:where([data-slot="menu-sub-trigger"]>svg:last-child){margin-inline-start:auto;width:16px;height:16px}
:where([data-slot="menu-sub-trigger"]:dir(rtl)>svg:last-child){transform:scaleX(-1)}
:where([data-slot="menubar"]){display:flex;flex-direction:row;height:36px;align-items:center;gap:4px;padding:4px;border-radius:var(--radius-md);border:1px solid var(--border);background:var(--background);box-shadow:var(--ds-shadow-xs)}
button:where([data-slot="menubar-trigger"]){all:unset;box-sizing:border-box;display:flex;align-items:center;padding:4px 8px;border-radius:var(--radius-sm);font-size:14px;line-height:20px;font-weight:500;cursor:default;user-select:none}
button:where([data-slot="menubar-trigger"]:focus,[data-slot="menubar-trigger"][data-state="open"]){background:var(--accent);color:var(--accent-foreground)}
:where([data-slot="navigation-menu"]){position:relative;display:flex;flex:1;max-width:max-content;align-items:center;justify-content:center}
:where([data-slot="navigation-menu-list"]){display:flex;flex-direction:row;flex:1;align-items:center;justify-content:center;gap:4px;margin:0;padding:0;list-style:none}
:where([data-slot="navigation-menu-item"]){position:relative}
button:where([data-slot="navigation-menu-trigger"]),:where([data-slot="navigation-menu-item"]>a[data-slot="navigation-menu-link"]){all:unset;box-sizing:border-box;display:inline-flex;flex-direction:row;height:36px;width:max-content;align-items:center;justify-content:center;gap:4px;padding:8px 16px;border-radius:var(--radius-md);background:var(--background);color:inherit;font-size:14px;line-height:20px;font-weight:500;cursor:pointer;transition:color .15s,box-shadow .15s}
button:where([data-slot="navigation-menu-trigger"]:hover,[data-slot="navigation-menu-trigger"]:focus),:where([data-slot="navigation-menu-item"]>a[data-slot="navigation-menu-link"]:hover,[data-slot="navigation-menu-item"]>a[data-slot="navigation-menu-link"]:focus){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="navigation-menu-trigger"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-soft);outline:1px solid var(--ring)}
button:where([data-slot="navigation-menu-trigger"][data-state="open"]){background:color-mix(in oklab,var(--accent) 50%,transparent);color:var(--accent-foreground)}
button:where([data-slot="navigation-menu-trigger"] svg){width:12px;height:12px;margin-top:1px;margin-inline-start:4px;transition:transform .3s}
button:where([data-slot="navigation-menu-trigger"][data-state="open"] svg){transform:rotate(180deg)}
:where([data-slot="navigation-menu-content"]){top:100%;inset-inline-start:0;margin-top:6px;min-width:12rem;padding:8px;border-radius:var(--radius-md);border:1px solid var(--border);background:var(--popover);color:var(--popover-foreground);box-shadow:var(--ds-shadow-sm)}
:where([data-slot="navigation-menu-content"] [data-slot="navigation-menu-link"]){display:flex;flex-direction:column;gap:4px;padding:8px;border-radius:var(--radius-sm);color:inherit;font-size:14px;line-height:20px;text-decoration:none;outline:none;transition:all .15s}
:where([data-slot="navigation-menu-content"] [data-slot="navigation-menu-link"]:hover,[data-slot="navigation-menu-content"] [data-slot="navigation-menu-link"]:focus){background:var(--accent);color:var(--accent-foreground)}
:where([data-slot="navigation-menu-link"][data-active]){background:color-mix(in oklab,var(--accent) 50%,transparent);color:var(--accent-foreground)}
`

pub const DS_FLOAT_JS := `
var seq=0,stack=[],timers=new WeakMap();
function each(l,f){for(var i=0;i<l.length;i++)f(l[i],i)}
function reduced(){return window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches}
function rootOf(el){return el&&el.closest?el.closest('[data-froot]'):null}
function trig(root){var l=root.querySelectorAll('[data-ftrigger]');for(var i=0;i<l.length;i++)if(rootOf(l[i])===root)return l[i];return null}
function cont(root){var l=root.querySelectorAll('[data-float]');for(var i=0;i<l.length;i++)if(rootOf(l[i])===root)return l[i];return null}
function anchorOf(t){return t&&t.hasAttribute('data-wrap')?(t.firstElementChild||t):t}
function kind(root){return root.getAttribute('data-froot')}
function isOpen(root){var c=cont(root);return!!c&&c.getAttribute('data-state')==='open'}
function num(v,d){var n=parseInt(v,10);return isNaN(n)?d:n}
function later(root,key,ms,fn){clear(root,key);var m=timers.get(root)||{};m[key]=setTimeout(fn,ms);timers.set(root,m)}
function clear(root,key){var m=timers.get(root);if(m&&m[key]){clearTimeout(m[key]);m[key]=0}}
function sideFor(c,root){
var s=c.__side||(c.__side=c.getAttribute('data-side')||'bottom');
if(kind(root)==='sub'&&getComputedStyle(c).direction==='rtl')s=OPP[s];
return s
}
function place(root){
var c=cont(root),t=trig(root);
if(!c||c.hasAttribute('data-csspos'))return;
if(!c.__al){c.__al=c.getAttribute('data-align')||'center';c.__off=num(c.getAttribute('data-offset'),4)}
dsPlace(c,anchorOf(t),sideFor(c,root),c.__al,c.__off,root.__pt)
}
function ids(root){
var t=trig(root),c=cont(root);
if(!c.id)c.id='salam-float-'+(++seq);
var a=anchorOf(t),k=kind(root);
if(a){
if(k==='tooltip')a.setAttribute('aria-describedby',c.id);
else{a.setAttribute('aria-controls',c.id);a.setAttribute('aria-haspopup',k==='popover'||k==='hover'?'dialog':'menu')}
}
}
function open(root,opts){
var c=cont(root);
if(!c||isOpen(root))return;
opts=opts||{};
var k=kind(root),t=trig(root);
ids(root);
if(c.hasAttribute('data-menu'))menuInit(c);
root.__pt=opts.pt||null;
c.removeAttribute('hidden');
c.setAttribute('data-state','closed');
place(root);
void c.offsetWidth;
c.setAttribute('data-state','open');
var a=anchorOf(t);
if(a&&k!=='tooltip')a.setAttribute('aria-expanded','true');
if(t)t.setAttribute('data-state','open');
stack.push(root);
if(k==='menu'||k==='sub'||k==='context'){
c.setAttribute('tabindex','-1');
var items=menuItems(c);
if(opts.first&&items.length)items[0].focus();else c.focus({preventScroll:true})
}else if(k==='popover'){
c.setAttribute('tabindex','-1');c.focus({preventScroll:true})
}
root.dispatchEvent(new CustomEvent('ds-open',{bubbles:true}))
}
function close(root,ret,now){
var c=cont(root);
if(!c||!isOpen(root))return;
var kids=root.querySelectorAll('[data-froot]');
each(kids,function(r){if(r!==root&&rootOf(r)!==null)close(r,false,now)});
var t=trig(root),a=anchorOf(t);
c.setAttribute('data-state','closed');
if(a&&kind(root)!=='tooltip')a.setAttribute('aria-expanded','false');
if(t)t.setAttribute('data-state','closed');
var i=stack.indexOf(root);if(i>=0)stack.splice(i,1);
var fin=function(){if(c.getAttribute('data-state')==='closed')c.setAttribute('hidden','')};
if(now||reduced())fin();else setTimeout(fin,160);
if(ret&&a&&a.focus)a.focus();
root.dispatchEvent(new CustomEvent('ds-close',{bubbles:true}))
}
function closeAll(ret){var l=stack.slice();for(var i=l.length-1;i>=0;i--)close(l[i],ret&&i===0)}
function topRoot(root){var r=root;while(r){var p=rootOf(r.parentNode);if(!p)break;if(kind(p)==='sub'||kind(p)==='menu'||kind(p)==='context'||kind(p)==='nav')r=p;else break}return r}
function menuItems(c){
var out=[],l=c.querySelectorAll('[data-menu-item]');
for(var i=0;i<l.length;i++){var e=l[i];if(e.closest('[data-float]')===c&&!e.hasAttribute('data-disabled'))out.push(e)}
return out
}
function menuInit(c){
if(c.__mi)return;c.__mi=1;
each(c.querySelectorAll('[data-menu-item]'),function(e){if(e.closest('[data-float]')===c&&!e.hasAttribute('tabindex'))e.setAttribute('tabindex','-1')});
each(c.querySelectorAll('[data-radio-group]'),function(g){
var v=g.getAttribute('data-value');
each(g.querySelectorAll('[role="menuitemradio"]'),function(r){
var on=r.hasAttribute('data-checked')||(v!==null&&r.getAttribute('data-value')===v);
r.setAttribute('aria-checked',on?'true':'false');
if(on)r.setAttribute('data-checked','');else r.removeAttribute('data-checked')
})
});
each(c.querySelectorAll('[role="menuitemcheckbox"]'),function(r){r.setAttribute('aria-checked',r.hasAttribute('data-checked')?'true':'false')})
}
function selectItem(it,e){
var role=it.getAttribute('role');
if(role==='menuitemcheckbox'){
var on=!it.hasAttribute('data-checked');
if(on)it.setAttribute('data-checked','');else it.removeAttribute('data-checked');
it.setAttribute('aria-checked',on?'true':'false')
}else if(role==='menuitemradio'){
var g=it.closest('[data-radio-group]');
if(g)each(g.querySelectorAll('[role="menuitemradio"]'),function(r){r.removeAttribute('data-checked');r.setAttribute('aria-checked','false')});
it.setAttribute('data-checked','');it.setAttribute('aria-checked','true');
if(g)g.setAttribute('data-value',it.getAttribute('data-value')||'')
}
it.dispatchEvent(new CustomEvent('ds-select',{bubbles:true,detail:{value:it.getAttribute('data-value'),checked:it.hasAttribute('data-checked')}}))
}
function activate(it){
if(it.hasAttribute('data-disabled'))return;
var root=rootOf(it);
if(it.hasAttribute('data-ftrigger')&&kind(rootOf(it))==='sub'){open(rootOf(it),{first:true});return}
selectItem(it);
var r=topRoot(root);
close(r,true)
}
function adj(el,d){
var bar=el.closest('[data-slot="menubar"]');if(!bar)return null;
var ts=[];each(bar.querySelectorAll('[data-ftrigger]'),function(t){var r=rootOf(t);if(kind(r)==='menu')ts.push(t)});
var i=ts.indexOf(el.closest('[data-ftrigger]')||trig(rootOf(el)));
if(i<0)return null;
return ts[(i+d+ts.length)%ts.length]
}
var buf='',bufT=0;
document.addEventListener('click',function(e){
var t=e.target,tr=t.closest?t.closest('[data-ftrigger]'):null;
if(tr&&!tr.hasAttribute('data-disabled')){
var root=rootOf(tr),k=kind(root);
if(k==='popover'||k==='menu'||k==='nav'){
if(isOpen(root))close(root,false);else{if(k==='nav'||k==='menu'||k==='popover')closeOthers(root);open(root,{})}
return
}
if(k==='sub'){activate(tr);return}
if(k==='hover'||k==='tooltip'){return}
}
var it=t.closest?t.closest('[data-menu-item]'):null;
if(it&&!it.hasAttribute('data-ftrigger')){activate(it)}
});
function closeOthers(root){
for(var i=stack.length-1;i>=0;i--){
var s=stack[i];
if(s===root||root.contains(s)||s.contains(root))continue;
var k=kind(s);
if(k==='popover'||k==='menu'||k==='nav'||k==='context')close(s,false)
}
}
document.addEventListener('pointerdown',function(e){
var t=e.target;
for(var i=stack.length-1;i>=0;i--){
var r=stack[i],c=cont(r),tr=trig(r);
if(c&&(c.contains(t)||(tr&&tr.contains(t))))continue;
if(kind(r)==='tooltip'||kind(r)==='hover'){if(tr&&tr.contains(t))close(r,false,true);else if(kind(r)==='tooltip')close(r,false);continue}
var inside=false;
each(c.querySelectorAll('[data-froot]'),function(x){var xc=cont(x);if(xc&&xc.contains(t))inside=true});
if(inside)continue;
close(r,false)
}
},true);
document.addEventListener('contextmenu',function(e){
var tr=e.target.closest?e.target.closest('[data-ftrigger]'):null;
if(!tr)return;
var root=rootOf(tr);
if(!root||kind(root)!=='context')return;
e.preventDefault();
closeAll(false);
if(isOpen(root))close(root,false,true);
open(root,{pt:{x:e.clientX,y:e.clientY}})
});
document.addEventListener('mouseover',function(e){
var t=e.target;if(!t.closest)return;
var it=t.closest('[data-menu-item]');
if(it&&!it.hasAttribute('data-disabled')){
var c=it.closest('[data-float]');
if(c&&c.getAttribute('data-state')==='open'){
it.focus({preventScroll:true});
each(menuSubs(c),function(s){if(!s.contains(it))later(s,'sub',150,function(){close(s,false)})});
if(it.hasAttribute('data-ftrigger')){var sr=rootOf(it);clear(sr,'sub');later(sr,'open',100,function(){open(sr,{})})}
}
}
var tr=t.closest('[data-ftrigger]');
if(!tr||tr.contains(e.relatedTarget))return;
var root=rootOf(tr),k=root&&kind(root);
if(k==='tooltip'){var d=num(root.getAttribute('data-delay'),0);later(root,'open',d,function(){open(root,{})})}
else if(k==='hover'){clear(root,'close');later(root,'open',num(root.getAttribute('data-delay'),700),function(){open(root,{})})}
else if(k==='nav'){clear(root,'close');later(root,'open',100,function(){closeOthers(root);open(root,{})})}
else if(k==='menu'&&root.getAttribute('data-kind')==='menubar'){
var bar=root.closest('[data-slot="menubar"]');
var anyOpen=false;each(bar.querySelectorAll('[data-froot]'),function(r){if(r!==root&&isOpen(r))anyOpen=true});
if(anyOpen){closeOthers(root);open(root,{})}
}
});
function menuSubs(c){var out=[];each(c.querySelectorAll('[data-froot="sub"]'),function(s){if(s.parentNode.closest('[data-float]')===c)out.push(s)});return out}
document.addEventListener('mouseout',function(e){
var t=e.target;if(!t.closest)return;
var tr=t.closest('[data-ftrigger]'),c=t.closest('[data-float]'),el=tr||c;
if(!el)return;
var root=rootOf(el),k=root&&kind(root);
if(!root||(el.contains(e.relatedTarget)))return;
var other=el===tr?cont(root):trig(root);
if(other&&other.contains&&e.relatedTarget&&other.contains(e.relatedTarget))return;
if(k==='tooltip'){clear(root,'open');later(root,'close',0,function(){close(root,false)})}
else if(k==='hover'){clear(root,'open');later(root,'close',300,function(){close(root,false)})}
else if(k==='nav'){clear(root,'open');later(root,'close',150,function(){close(root,false)})}
});
document.addEventListener('mouseover',function(e){
var t=e.target;if(!t.closest)return;
var c=t.closest('[data-float]');
if(!c)return;
var root=rootOf(c),k=root&&kind(root);
if(k==='hover'||k==='nav'||k==='tooltip'){clear(root,'close')}
});
document.addEventListener('focusin',function(e){
var tr=e.target.closest?e.target.closest('[data-ftrigger]'):null;
if(!tr)return;
var root=rootOf(tr);
if(root&&kind(root)==='tooltip'&&e.target.matches&&e.target.matches(':focus-visible'))open(root,{});
else if(root&&kind(root)==='hover'&&e.target.matches&&e.target.matches(':focus-visible'))open(root,{})
});
document.addEventListener('focusout',function(e){
var tr=e.target.closest?e.target.closest('[data-ftrigger]'):null;
if(!tr)return;
var root=rootOf(tr);
if(root&&(kind(root)==='tooltip'||kind(root)==='hover'))close(root,false)
});
document.addEventListener('keydown',function(e){
var k=e.key,t=e.target;
if(k==='Escape'&&stack.length){
var r=stack[stack.length-1],c=cont(r);
var back=kind(r)!=='tooltip'&&kind(r)!=='hover';
e.preventDefault();e.stopPropagation();
close(r,back);
return
}
var tr=t.closest?t.closest('[data-ftrigger]'):null;
if(tr){
var root=rootOf(tr),kd=kind(root),rtl=getComputedStyle(tr).direction==='rtl';
if(kd==='menu'||kd==='nav'||kd==='popover'){
if(k==='ArrowDown'||(kd==='menu'&&(k==='Enter'||k===' '))){
if(kd==='popover'&&k==='ArrowDown')return;
e.preventDefault();closeOthers(root);if(!isOpen(root))open(root,{first:kd==='menu'});else if(kd==='menu'){var it=menuItems(cont(root))[0];if(it)it.focus()}
return
}
if(root.getAttribute('data-kind')==='menubar'&&(k==='ArrowLeft'||k==='ArrowRight')){
var nx=adj(tr,(k==='ArrowRight')!==rtl?1:-1);
if(nx){e.preventDefault();var wasOpen=isOpen(root);nx.focus();if(wasOpen){closeAll(false);open(rootOf(nx),{first:true})}}
return
}
if(kd==='nav'&&(k==='ArrowLeft'||k==='ArrowRight')){
var nav=tr.closest('[data-slot="navigation-menu"]');
var ts=[];each(nav.querySelectorAll('[data-slot="navigation-menu-trigger"],[data-slot="navigation-menu-link"]'),function(x){ts.push(x)});
var j=ts.indexOf(tr);
if(j>=0){e.preventDefault();ts[(j+((k==='ArrowRight')!==rtl?1:-1)+ts.length)%ts.length].focus()}
return
}
}
if(kd==='sub'&&(k==='ArrowRight'&&!rtl||k==='ArrowLeft'&&rtl)){e.preventDefault();open(root,{first:true});return}
}
var c=t.closest?t.closest('[data-float]'):null;
if(!c)return;
var root=rootOf(c),kd=kind(root);
if(kd!=='menu'&&kd!=='sub'&&kd!=='context')return;
menuInit(c);
var items=menuItems(c),i=items.indexOf(document.activeElement),to=-1,rtl=getComputedStyle(c).direction==='rtl';
if(k==='ArrowDown')to=(i+1)%items.length;
else if(k==='ArrowUp')to=i<0?items.length-1:(i-1+items.length)%items.length;
else if(k==='Home')to=0;
else if(k==='End')to=items.length-1;
else if(k==='Enter'||k===' '){if(i>=0){e.preventDefault();activate(items[i])}return}
else if(k==='Tab'){e.preventDefault();close(topRoot(root),true);return}
else if(k==='ArrowRight'&&!rtl||k==='ArrowLeft'&&rtl){
if(i>=0&&items[i].hasAttribute('data-ftrigger')){e.preventDefault();open(rootOf(items[i]),{first:true});return}
if(root.getAttribute('data-kind')==='menubar'){var n1=adj(c,1);if(n1){e.preventDefault();closeAll(false);open(rootOf(n1),{first:true})}}
return
}
else if(k==='ArrowLeft'&&!rtl||k==='ArrowRight'&&rtl){
if(kd==='sub'){e.preventDefault();close(root,true);return}
if(root.getAttribute('data-kind')==='menubar'){var n2=adj(c,-1);if(n2){e.preventDefault();closeAll(false);open(rootOf(n2),{first:true})}}
return
}
else if(k.length===1&&!e.ctrlKey&&!e.metaKey&&!e.altKey){
buf+=k.toLowerCase();clearTimeout(bufT);bufT=setTimeout(function(){buf=''},600);
var from=(buf.length===1?i+1:i),n=items.length;
for(var q=0;q<n;q++){var cand=items[(from+q+n)%n];if(cand.textContent.trim().toLowerCase().indexOf(buf)===0){to=(from+q+n)%n;break}}
if(to<0)return;
e.preventDefault()
}
if(to>=0&&items.length){e.preventDefault();items[to].focus()}
});
function reposition(){each(stack,function(r){if(kind(r)!=='context')place(r)})}
window.addEventListener('resize',reposition);
window.addEventListener('scroll',reposition,true);
window.salamDsFloat={open:open,close:close,closeAll:closeAll};
each(document.querySelectorAll('[data-float]'),function(c){menuInit(c)});
`

func ds_float_js(): str:
    ret "(function(){if(window.salamDsFloat)return;" + DS_PLACE_JS + DS_FLOAT_JS + "})();"
end

func ds_float_css(): str:
    mut css := DS_FLOAT_MIN_CSS
    if DsOn():
        css += DsThemeTokens(
            "--ds-menu-destructive-focus:color-mix(in oklab,var(--destructive) 10%,transparent)",
            "--ds-menu-destructive-focus:color-mix(in oklab,var(--destructive) 20%,transparent)"
        ) + DS_FLOAT_CSS + DS_BUTTON_CSS
    end
    ret css
end

func ds_float_base(): Output:
    mut o := Output {}
    o.shared_js = ds_float_js()
    o.shared_css = ds_float_css()
    ret o
end

func ds_float_defaults(n: Node, side: str, align: str, offset: str): str:
    mut s := ""
    if DsAttr(n.attrs, "data-side") == "":
        s += " data-side=\"" + side + "\""
    end
    if DsAttr(n.attrs, "data-align") == "":
        s += " data-align=\"" + align + "\""
    end
    if DsAttr(n.attrs, "data-offset") == "":
        s += " data-offset=\"" + offset + "\""
    end
    ret s
end

func ds_float_root(n: Node, slot: str, froot: str, extra: str): Output:
    mut o := ds_float_base()
    o.html = DsOpen(n, "div", slot, " data-froot=\"" + froot + "\"" + extra) + n.inner + "</div>"
    ret o
end

func ds_float_trigger(n: Node, slot: str, variant: str): Output:
    mut o := ds_float_base()
    if n.inner == "":
        mut v := ""
        if DsAttr(n.attrs, "data-variant") == "":
            v = " data-variant=\"" + variant + "\""
        end
        o.html = DsOpen(
            n, "button", slot, " type=\"button\" data-ftrigger" + v
        ) + Escape(n.content) + "</button>"
    else:
        o.html = DsOpen(
            n, "span", slot, " data-ftrigger data-wrap style=\"display:contents\""
        ) + Escape(n.content) + n.inner + "</span>"
    end
    ret o
end

func ds_float_content(
    n: Node, slot: str, role: str, side: str, align: str, offset: str, extra: str, tail: str
): Output:
    mut o := ds_float_base()
    mut r := ""
    if role != "":
        r = " role=\"" + role + "\""
    end
    o.html = DsOpen(
        n,
        "div",
        slot,
        " data-float hidden data-state=\"closed\"" + r + extra + ds_float_defaults(
            n, side, align, offset
        )
    ) + Escape(n.content) + n.inner + tail + "</div>"
    ret o
end

func ds_float_plain(n: Node, tag: str, slot: str, extra: str): Output:
    mut o := ds_float_base()
    o.html = DsOpen(n, tag, slot, extra) + Escape(n.content) + n.inner + "</" + tag + ">"
    ret o
end

func ds_menu_item(n: Node, slot: str, role: str, extra: str, lead: str): Output:
    mut o := ds_float_base()
    o.html = DsOpen(
        n, "div", slot, " data-menu-item role=\"" + role + "\" tabindex=\"-1\"" + extra
    ) + lead + Escape(n.content) + n.inner + "</div>"
    ret o
end

@en "gen_popover"
@fa "ساخت پاپ آور"
pub func gen_popover(n: Node): Output:
    ret ds_float_root(n, "popover", "popover", "")
end

