@en "gen_menu_content"
@fa "ساخت محتوای منو"
pub func gen_menu_content(n: Node): Output:
    side := "bottom"
    mut align := "center"
    mut off := "4"
    if n.parents.Find("menubar") >= 0:
        align = "start"
        off = "8"
    end
    ret ds_float_content(
        n, "menu-content", "menu", side, align, off, " data-menu aria-orientation=\"vertical\"", ""
    )
end

