package layoutgen

const DS_INPUT_SEL := `input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=submit]):not([type=button]):not([type=reset]):not([type=hidden]):not([type=image]):not([type=color])`

const DS_INPUT_BODY := `{height:36px;width:100%;min-width:0;border-radius:var(--radius-md);border:1px solid var(--input);background:var(--ds-input-bg);padding:4px 12px;font-family:inherit;font-size:16px;line-height:inherit;color:inherit;box-shadow:var(--ds-shadow-xs);outline:none;transition:color .15s,box-shadow .15s}`

const DS_TEXTAREA_BODY := `{display:flex;field-sizing:content;min-height:64px;width:100%;border-radius:var(--radius-md);border:1px solid var(--input);background:var(--ds-input-bg);padding:8px 12px;font-family:inherit;font-size:16px;color:inherit;box-shadow:var(--ds-shadow-xs);outline:none;transition:color .15s,box-shadow .15s}`

pub const DS_LABEL_CSS := `
:where(label){display:flex;align-items:center;gap:8px;font-size:14px;line-height:1;font-weight:500;user-select:none}
:where(:is(input,textarea,select,button):disabled ~ label){cursor:not-allowed;opacity:.5}
:where(label:has(:disabled)){cursor:not-allowed;opacity:.5}
:where([data-disabled="true"] label){pointer-events:none;opacity:.5}
`

func ds_input_css(): str:
    s := DS_INPUT_SEL
    mut c := "\n:where(" + s + ")" + DS_INPUT_BODY + "\n"
    c += ":where(" + s + ")::selection{background:var(--primary);color:var(--primary-foreground)}\n"
    c += ":where(" + s + ")::file-selector-button{display:inline-flex;height:28px;border:0;background:transparent;font-family:inherit;font-size:14px;font-weight:500;color:var(--foreground)}\n"
    c += ":where(" + s + ")::placeholder{color:var(--muted-foreground)}\n"
    c += ":where(" + s + ":disabled){pointer-events:none;cursor:not-allowed;opacity:.5}\n"
    c += ":where(" + s + ":focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}\n"
    c += ":where(" + s + "[aria-invalid=\"true\"]){border-color:var(--destructive);box-shadow:0 0 0 3px var(--ds-ring-invalid)}\n"
    c += "@media (min-width:768px){:where(" + s + "){font-size:14px}}\n"
    ret c
end

func ds_textarea_css(): str:
    mut c := "\n:where(textarea)" + DS_TEXTAREA_BODY + "\n"
    c += ":where(textarea)::selection{background:var(--primary);color:var(--primary-foreground)}\n"
    c += ":where(textarea)::placeholder{color:var(--muted-foreground)}\n"
    c += ":where(textarea:disabled){cursor:not-allowed;opacity:.5}\n"
    c += ":where(textarea:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}\n"
    c += ":where(textarea[aria-invalid=\"true\"]){border-color:var(--destructive);box-shadow:0 0 0 3px var(--ds-ring-invalid)}\n"
    c += "@media (min-width:768px){:where(textarea){font-size:14px}}\n"
    ret c
end

@en "gen_input"
@fa "ساخت ورودی"
pub func gen_input(n: Node): Output:
    mut o := Output {}
    o.html = "<input" + n.attrs + ClassAttr(n, "") + ">"
    if DsOn():
        o.shared_css = ds_input_css()
    end
    ret o
end

@en "gen_textarea"
@fa "ساخت متن بلند"
pub func gen_textarea(n: Node): Output:
    mut o := Output {}
    o.html = "<textarea" + n.attrs + ClassAttr(n, "") + ">" + Escape(n.content) + "</textarea>"
    if DsOn():
        o.shared_css = ds_textarea_css()
    end
    ret o
end

@en "gen_label"
@fa "ساخت برچسب"
pub func gen_label(n: Node): Output:
    mut o := Output {}
    o.html = "<label" + n.attrs + ClassAttr(n, "") + ">" + Escape(n.content) + n.inner + "</label>"
    if DsOn():
        o.shared_css = DS_LABEL_CSS
    end
    ret o
end
