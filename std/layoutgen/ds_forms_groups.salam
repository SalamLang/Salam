@en "gen_input_otp"
@fa "ساخت کد یکبار مصرف"
pub func gen_input_otp(n: Node): Output:
    mut o := Output {}
    total := ds_int(DsAttr(n.attrs, "data-length"), 6)
    group := ds_int(DsAttr(n.attrs, "data-group"), 0)
    name := DsAttr(n.attrs, "data-name")
    off := ds_has_flag(n.attrs, "data-disabled")
    mut h := "<div data-slot=\"input-otp\" role=\"group\"" + n.attrs + ClassAttr(n, "") + ">"
    mut opened := false
    repeat total in i:
        if group > 0 and i > 0 and i % group == 0:
            h += "</div><div data-slot=\"input-otp-separator\" role=\"separator\">" + DS_DASH_SVG + "</div>"
            opened = false
        end
        if not opened:
            h += "<div data-slot=\"input-otp-group\">"
            opened = true
        end
        mut ac := "off"
        if i == 0:
            ac = "one-time-code"
        end
        h += "<input data-slot=\"input-otp-slot\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]\" maxlength=\"1\" autocomplete=\"" + ac + "\" aria-label=\"" + str.FromInt(i + 1) + "\""
        if off:
            h += " disabled"
        end
        h += ">"
    end
    h += "</div>"
    if name != "":
        h += "<input type=\"hidden\" data-slot=\"input-otp-value\" name=\"" + name + "\">"
    end
    o.html = h + "</div>"
    o.shared_js = DS_OTP_JS
    if DsOn():
        o.shared_css = DS_OTP_CSS
    end
    ret o
end
