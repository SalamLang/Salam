@fa "ساخت گروه تغییر وضعیت"
pub func gen_toggle_group(n: Node): Output:
    ret dsf_part(
        n, "div", "toggle-group", " role=\"group\"" + ds_default(n.attrs, "data-type", "single") + ds_default(n.attrs, "data-spacing", "0"), DS_TOGGLE_CSS, DS_TOGGLE_JS
    )
end

