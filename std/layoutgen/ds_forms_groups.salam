@en "gen_field_separator"
@fa "ساخت جداکننده فیلد"
pub func gen_field_separator(n: Node): Output:
    mut o := Output {}
    mut h := "<div data-slot=\"field-separator\"" + n.attrs + ClassAttr(n, "") + ">"
    if n.content != "":
        h += "<span data-slot=\"field-separator-content\">" + Escape(n.content) + "</span>"
    end
    o.html = h + n.inner + "</div>"
    if DsOn():
        o.shared_css = DS_FIELD_CSS
    end
    ret o
end

