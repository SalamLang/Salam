button:where([data-slot="toggle"]){display:inline-flex;flex-direction:row;align-items:center;justify-content:center;gap:8px;height:36px;min-width:36px;padding:0 8px;border:0 solid transparent;border-radius:var(--radius-md);background:transparent;color:inherit;font-size:14px;font-weight:500;white-space:nowrap;cursor:pointer;outline:none;transition:color .15s,box-shadow .15s}
button:where([data-slot="toggle"]:hover){background:var(--muted);color:var(--muted-foreground)}
button:where([data-slot="toggle"][data-state="on"]){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="toggle"]:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}
button:where([data-slot="toggle"]:disabled){pointer-events:none;opacity:.5}
button:where([data-slot="toggle"][aria-invalid="true"]){border-color:var(--destructive);box-shadow:0 0 0 3px var(--ds-ring-invalid)}
:where([data-slot="toggle"] svg){pointer-events:none;flex-shrink:0;width:16px;height:16px}
:where([data-slot="toggle-group"]){display:flex;flex-direction:row;width:fit-content;align-items:center;border-radius:var(--radius-md)}
:where([data-slot="toggle-group"][data-spacing="1"]){gap:4px}
:where([data-slot="toggle-group"][data-spacing="2"]){gap:8px}
:where([data-slot="toggle-group"][data-spacing="3"]){gap:12px}
:where([data-slot="toggle-group"][data-spacing="4"]){gap:16px}
button:where([data-slot="toggle-group"] [data-slot="toggle"]){width:auto;min-width:0;flex-shrink:0;padding:0 12px}
button:where([data-slot="toggle-group"] [data-slot="toggle"]:focus,[data-slot="toggle-group"] [data-slot="toggle"]:focus-visible){z-index:10}
button:where([data-slot="toggle-group"][data-spacing="0"] [data-slot="toggle"]){border-radius:0;box-shadow:none}
button:where([data-slot="toggle-group"][data-spacing="0"] [data-slot="toggle"]:first-child){border-start-start-radius:var(--radius-md);border-end-start-radius:var(--radius-md)}
button:where([data-slot="toggle-group"][data-spacing="0"] [data-slot="toggle"]:last-child){border-start-end-radius:var(--radius-md);border-end-end-radius:var(--radius-md)}
button:where([data-slot="toggle"][data-variant="outline"]){border-width:1px;border-color:var(--input);background:transparent;box-shadow:var(--ds-shadow-xs)}
button:where([data-slot="toggle"][data-variant="outline"]:hover){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="toggle"][data-variant="outline"][data-state="on"]){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="toggle"][data-size="sm"]){height:32px;min-width:32px;padding:0 6px}
button:where([data-slot="toggle"][data-size="lg"]){height:40px;min-width:40px;padding:0 10px}
button:where([data-slot="toggle-group"][data-variant="outline"] [data-slot="toggle"]){border-width:1px;border-color:var(--input);background:transparent;box-shadow:var(--ds-shadow-xs)}
button:where([data-slot="toggle-group"][data-variant="outline"] [data-slot="toggle"]:hover){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="toggle-group"][data-variant="outline"] [data-slot="toggle"][data-state="on"]){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="toggle-group"][data-variant="outline"][data-spacing="0"] [data-slot="toggle"]:not(:first-child)){border-inline-start-width:0}
:where([data-slot="toggle-group"][data-variant="outline"][data-spacing="0"]){box-shadow:var(--ds-shadow-xs)}
button:where([data-slot="toggle-group"][data-size="sm"] [data-slot="toggle"]){height:32px;min-width:32px}
button:where([data-slot="toggle-group"][data-size="lg"] [data-slot="toggle"]){height:40px;min-width:40px}
`

pub const DS_TOGGLE_JS := `function salamDsToggle(b, on) {
  b.setAttribute("aria-pressed", on ? "true" : "false");
  b.setAttribute("data-state", on ? "on" : "off");
  b.dispatchEvent(new Event("change", { bubbles: true }));
}
document.addEventListener("click", function (e) {
  var b = e.target.closest ? e.target.closest('[data-slot="toggle"]') : null;
  if (!b || b.disabled) return;
  var on = b.getAttribute("aria-pressed") !== "true";
  var g = b.closest('[data-slot="toggle-group"]');
  if (g && g.getAttribute("data-type") !== "multiple" && on) {
    var all = g.querySelectorAll('[data-slot="toggle"]');
    for (var i = 0; i < all.length; i++) {
      if (all[i] !== b && all[i].getAttribute("aria-pressed") === "true") salamDsToggle(all[i], false);
    }
  }
  salamDsToggle(b, on);
});
document.addEventListener("keydown", function (e) {
  var b = e.target.closest ? e.target.closest('[data-slot="toggle"]') : null;
  var g = b ? b.closest('[data-slot="toggle-group"]') : null;
  if (!g) return;
  var rtl = getComputedStyle(g).direction === "rtl";
  var k = e.key, d = 0;
  if (k === "ArrowRight") d = rtl ? -1 : 1;
  else if (k === "ArrowLeft") d = rtl ? 1 : -1;
  else if (k === "ArrowDown") d = 1;
  else if (k === "ArrowUp") d = -1;
  else if (k !== "Home" && k !== "End") return;
  var all = [].slice.call(g.querySelectorAll('[data-slot="toggle"]:not(:disabled)'));
  var i = all.indexOf(b);
  if (k === "Home") i = 0;
  else if (k === "End") i = all.length - 1;
  else i = (i + d + all.length) % all.length;
  e.preventDefault();
  all[i].focus();
});
`

pub const DS_INPUT_GROUP_JS := `document.addEventListener("click", function (e) {
  var a = e.target.closest ? e.target.closest('[data-slot="input-group-addon"]') : null;
  if (!a || e.target.closest("button")) return;
  var c = a.parentElement.querySelector("input,textarea,select");
  if (c) c.focus();
});
`

pub const DS_OTP_JS := `function salamDsOtp(root) {
  var slots = root.querySelectorAll('[data-slot="input-otp-slot"]');
  var out = root.querySelector('[data-slot="input-otp-value"]');
  function digits(s) { return s.replace(/[^0-9]/g, ""); }
  function sync() {
    var v = "";
    for (var i = 0; i < slots.length; i++) v += slots[i].value;
    if (out) out.value = v;
    root.setAttribute("data-value", v);
    root.dispatchEvent(new Event("change", { bubbles: true }));
    if (v.length === slots.length) root.dispatchEvent(new Event("complete", { bubbles: true }));
  }
  function fill(from, text) {
    var d = digits(text), i = from;
    for (var k = 0; k < d.length && i < slots.length; k++, i++) slots[i].value = d.charAt(k);
    slots[Math.min(i, slots.length - 1)].focus();
    sync();
  }
  for (var n = 0; n < slots.length; n++) {
    (function (i) {
      var el = slots[i];
      el.addEventListener("input", function () {
        var d = digits(el.value);
        if (d.length > 1) { el.value = ""; fill(i, d); return; }
        el.value = d;
        if (d && i + 1 < slots.length) slots[i + 1].focus();
        sync();
      });
      el.addEventListener("keydown", function (e) {
        if (e.key === "Backspace" && !el.value && i > 0) { slots[i - 1].value = ""; slots[i - 1].focus(); sync(); e.preventDefault(); }
        else if (e.key === "ArrowLeft" && i > 0) { slots[i - 1].focus(); e.preventDefault(); }
        else if (e.key === "ArrowRight" && i + 1 < slots.length) { slots[i + 1].focus(); e.preventDefault(); }
      });
      el.addEventListener("focus", function () { el.select(); });
      el.addEventListener("paste", function (e) {
        var t = (e.clipboardData || window.clipboardData).getData("text");
        e.preventDefault();
        fill(i, t);
      });
    })(n);
  }
}
(function () {
  function init() {
    var all = document.querySelectorAll('[data-slot="input-otp"]');
    for (var i = 0; i < all.length; i++) salamDsOtp(all[i]);
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
})();
`

const DS_DASH_SVG := `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14'/></svg>`

func ds_has_flag(attrs: str, name: str): bool:
    ret (" " + attrs).Find(" " + name) >= 0
end

func ds_default(attrs: str, name: str, value: str): str:
    if DsAttr(attrs, name) != "":
        ret ""
    end
    ret " " + name + "=\"" + value + "\""
end

func ds_int(s: str, fallback: int): int:
    if s == "":
        ret fallback
    end
    digits := "0123456789"
    mut v := 0
    repeat s.Len() in i:
        d := digits.Find(s.Substr(i, 1))
        if d < 0:
            ret fallback
        end
        v = v * 10 + d
    end
    ret v
end

func dsf_part(n: Node, tag: str, slot: str, extra: str, css: str, js: str): Output:
    mut o := Output {}
    o.html = "<" + tag + " data-slot=\"" + slot + "\"" + extra + n.attrs + ClassAttr(n, "") + ">" + Escape(n.content) + n.inner + "</" + tag + ">"
    o.shared_js = js
    if DsOn():
        o.shared_css = css
    end
    ret o
end

@en "gen_select"
@fa "ساخت انتخاب"
pub func gen_select(n: Node): Output:
    mut o := Output {}
    o.html = "<select" + n.attrs + ClassAttr(n, "") + ">" + n.inner + "</select>"
    if DsOn():
        o.shared_css = DS_SELECT_CSS
    end
    ret o
end

@en "gen_field_set"
@fa "ساخت گروه فیلد"
