@en "gen_toggle"
@fa "ساخت تغییر وضعیت"
pub func gen_toggle(n: Node): Output:
    mut state := "off"
    mut pressed := "false"
    if ds_has_flag(n.attrs, "data-pressed"):
        state = "on"
        pressed = "true"
    end
    ret dsf_part(n, "button", "toggle", " type=\"button\" aria-pressed=\"" + pressed + "\" data-state=\"" + state + "\"", DS_TOGGLE_CSS, DS_TOGGLE_JS)
end

