package layoutgen

import str

pub const DS_NAV_SR := "position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0"

pub const DS_NAV_SVG := "<svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\""

pub const DS_NAV_RIGHT := "<path d=\"m9 18 6-6-6-6\"/></svg>"

pub const DS_NAV_LEFT := "<path d=\"m15 18-6-6 6-6\"/></svg>"

pub const DS_NAV_DOTS := "<circle cx=\"12\" cy=\"12\" r=\"1\"/><circle cx=\"19\" cy=\"12\" r=\"1\"/><circle cx=\"5\" cy=\"12\" r=\"1\"/></svg>"

pub const DS_BREADCRUMB_CSS := `
:where([data-slot="breadcrumb-list"]){display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px;margin:0;padding:0;list-style:none;overflow-wrap:break-word;font-size:14px;line-height:20px;color:var(--muted-foreground)}
@media (min-width:640px){:where([data-slot="breadcrumb-list"]){gap:10px}}
:where([data-slot="breadcrumb-item"]){display:inline-flex;flex-direction:row;align-items:center;gap:6px}
:where([data-slot="breadcrumb-item"]>a){color:inherit;text-decoration:none;transition:color .15s}
:where([data-slot="breadcrumb-item"]>a:hover){color:var(--foreground)}
:where([data-slot="breadcrumb-page"]){font-weight:400;color:var(--foreground)}
:where([data-slot="breadcrumb-separator"]){display:inline-flex;align-items:center}
:where([dir="rtl"] [data-slot="breadcrumb-separator"]>svg){transform:scaleX(-1)}
:where([data-slot="breadcrumb-ellipsis"]){display:flex;width:36px;height:36px;align-items:center;justify-content:center}
`

pub const DS_PAGINATION_CSS := `
:where([data-slot="pagination"]){display:flex;flex-direction:row;width:100%;justify-content:center;margin-inline:auto}
:where([data-slot="pagination-content"]){display:flex;flex-direction:row;align-items:center;gap:4px;margin:0;padding:0;list-style:none}
:where([data-slot="pagination-link"]){display:inline-flex;flex-direction:row;flex-shrink:0;align-items:center;justify-content:center;gap:8px;height:36px;min-width:36px;padding:0;border:1px solid transparent;border-radius:var(--radius-md);background:transparent;color:inherit;font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;text-decoration:none;cursor:pointer;outline:none;transition:all .15s}
:where([data-slot="pagination-link"]:hover){background:var(--ds-ghost-hover);color:var(--accent-foreground)}
:where([data-slot="pagination-link"]:focus-visible){border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}
:where([data-slot="pagination-link"][data-active]){border-color:var(--border);background:var(--ds-outline-bg);box-shadow:var(--ds-shadow-xs)}
:where([data-slot="pagination-link"][data-active]:hover){background:var(--ds-outline-hover)}
:where([data-slot="pagination-link"][aria-disabled="true"]){pointer-events:none;opacity:.5}
:where([data-slot="pagination-link"]:is([data-role="previous"],[data-role="next"])){gap:4px;padding:0 10px}
:where([data-slot="pagination-link"] svg){pointer-events:none;flex-shrink:0}
:where([dir="rtl"] [data-slot="pagination-link"] svg){transform:scaleX(-1)}
:where([data-slot="pagination-ellipsis"]){display:flex;width:36px;height:36px;align-items:center;justify-content:center}
@media (max-width:639px){:where([data-slot="pagination-link"] [data-slot="pagination-label"]){display:none}}
`

func ds_nav_icon(path: str, size: str): str:
    ret DS_NAV_SVG + "width:" + size + ";height:" + size + "\">" + path
end

func ds_nav_attr(n: Node, extra: str): str:
    ret n.attrs + ClassAttr(n, "") + extra
end

func ds_nav_label(n: Node, fallback: str): str:
    if n.content != "":
        ret Escape(n.content)
    end
    ret fallback
end

func ds_page_link(n: Node, role: str, inner: str): str:
    mut cur := ""
    if str.Contains(n.attrs, "data-active"):
        cur = " aria-current=\"page\""
    end
    mut r := ""
    if role != "":
        r = " data-role=\"" + role + "\""
    end
    ret "<li data-slot=\"pagination-item\"><a data-slot=\"pagination-link\"" + r + cur +
        ds_nav_attr(n, "") + ">" + inner + "</a></li>"
end

@en "gen_breadcrumb"
@fa "ساخت مسیر"
pub func gen_breadcrumb(n: Node): Output:
    mut o := Output {}
    o.html = "<nav aria-label=\"breadcrumb\" data-slot=\"breadcrumb\"" + ds_nav_attr(n, "") +
        "><ol data-slot=\"breadcrumb-list\">" + n.inner + "</ol></nav>"
    if DsOn():
        o.shared_css = DS_BREADCRUMB_CSS
    end
    ret o
end

@en "gen_breadcrumb_item"
@fa "ساخت مورد مسیر"
pub func gen_breadcrumb_item(n: Node): Output:
    mut o := Output {}
    o.html = "<li data-slot=\"breadcrumb-item\"" + ds_nav_attr(n, "") + ">" + Escape(n.content) +
        n.inner + "</li>"
    if DsOn():
        o.shared_css = DS_BREADCRUMB_CSS
    end
    ret o
end

@en "gen_breadcrumb_page"
@fa "ساخت صفحه مسیر"
pub func gen_breadcrumb_page(n: Node): Output:
    mut o := Output {}
    o.html = "<li data-slot=\"breadcrumb-item\"><span data-slot=\"breadcrumb-page\" role=\"link\" aria-disabled=\"true\" aria-current=\"page\"" +
        ds_nav_attr(n, "") + ">" + Escape(n.content) + n.inner + "</span></li>"
    if DsOn():
        o.shared_css = DS_BREADCRUMB_CSS
    end
    ret o
end

@en "gen_breadcrumb_separator"
@fa "ساخت جداکننده مسیر"
pub func gen_breadcrumb_separator(n: Node): Output:
    mut o := Output {}
    mut body := n.inner
    if n.content != "":
        body = Escape(n.content) + n.inner
    end
    if body == "":
        body = ds_nav_icon(DS_NAV_RIGHT, "14px")
    end
    o.html = "<li data-slot=\"breadcrumb-separator\" role=\"presentation\" aria-hidden=\"true\"" +
        ds_nav_attr(n, "") + ">" + body + "</li>"
    if DsOn():
        o.shared_css = DS_BREADCRUMB_CSS
    end
    ret o
end

@en "gen_breadcrumb_ellipsis"
@fa "ساخت سه نقطه مسیر"
pub func gen_breadcrumb_ellipsis(n: Node): Output:
    mut o := Output {}
    o.html = "<li data-slot=\"breadcrumb-ellipsis\" role=\"presentation\" aria-hidden=\"true\"" +
        ds_nav_attr(n, "") + ">" + ds_nav_icon(
            DS_NAV_DOTS, "16px"
        ) + "<span style=\"" + DS_NAV_SR + "\">" + ds_nav_label(n, "More") + "</span></li>"
    if DsOn():
        o.shared_css = DS_BREADCRUMB_CSS
    end
    ret o
end

@en "gen_pagination"
@fa "ساخت صفحه بندی"
pub func gen_pagination(n: Node): Output:
    mut o := Output {}
    o.html = "<nav role=\"navigation\" aria-label=\"pagination\" data-slot=\"pagination\"" +
        ds_nav_attr(n, "") + "><ul data-slot=\"pagination-content\">" + n.inner + "</ul></nav>"
    if DsOn():
        o.shared_css = DS_PAGINATION_CSS
    end
    ret o
end

@en "gen_pagination_link"
@fa "ساخت پیوند صفحه"
pub func gen_pagination_link(n: Node): Output:
    mut o := Output {}
    o.html = ds_page_link(n, "", Escape(n.content) + n.inner)
    if DsOn():
        o.shared_css = DS_PAGINATION_CSS
    end
    ret o
end

@en "gen_pagination_previous"
@fa "ساخت صفحه قبل"
pub func gen_pagination_previous(n: Node): Output:
    mut o := Output {}
    o.html = ds_page_link(
        n,
        "previous",
        ds_nav_icon(
            DS_NAV_LEFT, "16px"
        ) + "<span data-slot=\"pagination-label\">" + ds_nav_label(n, "Previous") + "</span>"
    )
    if DsOn():
        o.shared_css = DS_PAGINATION_CSS
    end
    ret o
end

@en "gen_pagination_next"
@fa "ساخت صفحه بعد"
pub func gen_pagination_next(n: Node): Output:
    mut o := Output {}
    o.html = ds_page_link(
        n,
        "next",
        "<span data-slot=\"pagination-label\">" + ds_nav_label(n, "Next") + "</span>" + ds_nav_icon(
            DS_NAV_RIGHT, "16px"
        )
    )
    if DsOn():
        o.shared_css = DS_PAGINATION_CSS
    end
    ret o
end

@en "gen_pagination_ellipsis"
@fa "ساخت سه نقطه صفحه"
pub func gen_pagination_ellipsis(n: Node): Output:
    mut o := Output {}
    o.html = "<li data-slot=\"pagination-item\"><span aria-hidden=\"true\" data-slot=\"pagination-ellipsis\"" +
        ds_nav_attr(n, "") + ">" + ds_nav_icon(
            DS_NAV_DOTS, "16px"
        ) + "<span style=\"" + DS_NAV_SR + "\">" + ds_nav_label(n, "More pages") + "</span></span></li>"
    if DsOn():
        o.shared_css = DS_PAGINATION_CSS
    end
    ret o
end
