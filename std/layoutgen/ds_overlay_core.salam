@en "DsHas"
@fa "طراحی دارد"
pub func DsHas(attrs: str, name: str): bool:
    v := DsAttr(attrs, name)
    if v == "false":
        ret false
    end
    if v != "":
        ret true
    end
    padded := " " + attrs + " "
    ret padded.Find(" " + name + " ") >= 0 or padded.Find(" " + name + "=\"\"") >= 0
end

@en "DsOpen"
@fa "برچسب باز"
pub func DsOpen(n: Node, tag: str, slot: str, extra: str): str:
    ret "<" + tag + " data-slot=\"" + slot + "\"" + extra + n.attrs + ClassAttr(n, "") + ">"
end

@en "DsThemeTokens"
@fa "توکن های پوسته"
pub func DsThemeTokens(light: str, dark: str): str:
    mut css := ":root,[data-theme=\"light\"]{" + light + "}\n"
    css += "[data-theme=\"dark\"],.dark{" + dark + "}\n"
    css += "@media (prefers-color-scheme:dark){body:not([data-theme=\"light\"]):not([data-theme=\"dark\"]){" +
        dark + "}}\n"
    ret css
end
