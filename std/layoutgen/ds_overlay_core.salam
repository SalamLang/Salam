import str

pub const DS_ICON_CHEVRON_DOWN := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>`

pub const DS_ICON_X := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>`

pub const DS_ICON_CHEVRON_RIGHT := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>`

pub const DS_ICON_CHECK := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`

pub const DS_ICON_CIRCLE := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>`

pub const DS_PLACE_JS := `
var OPP={top:'bottom',bottom:'top',left:'right',right:'left'};
function dsPlace(el,anchor,side,align,off,pt){
var vw=document.documentElement.clientWidth,vh=document.documentElement.clientHeight;
var a=pt?{left:pt.x,right:pt.x,top:pt.y,bottom:pt.y,width:0,height:0}:anchor.getBoundingClientRect();
el.style.left='0px';el.style.top='0px';
var w=el.offsetWidth,h=el.offsetHeight,rtl=getComputedStyle(el).direction==='rtl';
function calc(s){
var x,y;
if(s==='top'||s==='bottom'){
y=s==='top'?a.top-h-off:a.bottom+off;
x=align==='start'?(rtl?a.right-w:a.left):align==='end'?(rtl?a.left:a.right-w):a.left+a.width/2-w/2
}else{
x=s==='left'?a.left-w-off:a.right+off;
y=align==='start'?a.top:align==='end'?a.bottom-h:a.top+a.height/2-h/2
}
return{x:x,y:y}
}
function fits(p,s){return s==='top'?p.y>=0:s==='bottom'?p.y+h<=vh:s==='left'?p.x>=0:p.x+w<=vw}
var p=calc(side),used=side;
if(!fits(p,side)){var q=calc(OPP[side]);if(fits(q,OPP[side])){p=q;used=OPP[side]}}
p.x=Math.max(4,Math.min(p.x,vw-w-4));
p.y=Math.max(4,Math.min(p.y,vh-h-4));
el.style.left=p.x+'px';el.style.top=p.y+'px';
el.setAttribute('data-side',used);
el.setAttribute('data-align',align);
return used
}
`

@en "DsHas"
@fa "طراحی دارد"
pub func DsHas(attrs: str, name: str): bool:
    v := DsAttr(attrs, name)
    if v == "false":
        ret false
    end
    if v != "":
        ret true
    end
    padded := " " + attrs + " "
    ret padded.Find(" " + name + " ") >= 0 or padded.Find(" " + name + "=\"\"") >= 0
end

@en "DsOpen"
@fa "برچسب باز"
pub func DsOpen(n: Node, tag: str, slot: str, extra: str): str:
    ret "<" + tag + " data-slot=\"" + slot + "\"" + extra + n.attrs + ClassAttr(n, "") + ">"
end

@en "DsThemeTokens"
@fa "توکن های پوسته"
pub func DsThemeTokens(light: str, dark: str): str:
    mut css := ":root,[data-theme=\"light\"]{" + light + "}\n"
    css += "[data-theme=\"dark\"],.dark{" + dark + "}\n"
    css += "@media (prefers-color-scheme:dark){body:not([data-theme=\"light\"]):not([data-theme=\"dark\"]){" +
        dark + "}}\n"
    ret css
end
