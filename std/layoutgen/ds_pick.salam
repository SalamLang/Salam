package layoutgen

pub const DS_PICK_MIN_CSS := `
:where([data-slot="combobox"],[data-slot="select"]){position:relative;display:inline-block}
:where([data-slot="combobox-content"],[data-slot="select-content"]){position:fixed;inset:auto;margin:0;padding:0;overflow:visible;z-index:50}
:where([data-slot="combobox-content"][hidden],[data-slot="select-content"][hidden]){display:none}
:where([data-slot="combobox-list"],[data-slot="select-list"]){max-height:300px;overflow-y:auto}
:where([role="option"][hidden],[role="group"][hidden],[role="separator"][hidden],[data-slot$="-empty"][hidden]){display:none}
:where([data-slot="combobox-clear"][hidden]){display:none}
dialog:where([data-command-dialog]){padding:0;gap:0;overflow:hidden}
`

pub const DS_PICK_CSS := `
:where([data-slot="command"]){display:flex;flex-direction:column;width:100%;height:100%;overflow:hidden;border-radius:var(--radius-md);background:var(--popover);color:var(--popover-foreground)}
:where([data-slot="command-input-wrapper"],[data-slot="combobox-search"]){display:flex;flex-direction:row;align-items:center;gap:8px;height:36px;padding:0 12px;border-bottom:1px solid var(--border)}
:where([data-slot="command-input-wrapper"] svg,[data-slot="combobox-search"] svg){flex-shrink:0;width:16px;height:16px;opacity:.5}
input:where([data-slot="command-input"],[data-slot="combobox-input"]){all:unset;box-sizing:border-box;flex:1;height:40px;width:100%;border-radius:var(--radius-md);background:transparent;font-size:14px;line-height:20px;color:inherit}
input:where([data-slot="command-input"],[data-slot="combobox-input"])::placeholder{color:var(--muted-foreground)}
:where([data-slot="command-list"]){max-height:300px;overflow-x:hidden;overflow-y:auto;scroll-padding-block:4px}
:where([data-slot="command-empty"],[data-slot="combobox-empty"]){padding:24px 0;text-align:center;font-size:14px;line-height:20px}
:where([data-slot="command-group"]){padding:4px;overflow:hidden}
:where([data-slot="command-group-heading"],[data-slot="select-label"]){padding:6px 8px;font-size:12px;line-height:16px;font-weight:500;color:var(--muted-foreground)}
:where([data-slot="command-separator"],[data-slot="select-separator"]){height:1px;margin:0 -1px;background:var(--border)}
:where([data-slot="command-item"],[data-slot="combobox-item"],[data-slot="select-item"]){position:relative;display:flex;flex-direction:row;align-items:center;gap:8px;padding:6px 8px;border-radius:var(--radius-sm);font-size:14px;line-height:20px;cursor:default;user-select:none;outline:none}
:where([data-slot="command-item"][data-active],[data-slot="combobox-item"][data-active],[data-slot="select-item"][data-active]){background:var(--accent);color:var(--accent-foreground)}
:where([role="option"][data-disabled]){pointer-events:none;opacity:.5}
:where([data-slot="command-item"] svg,[data-slot="combobox-item"] svg,[data-slot="select-item"] svg){pointer-events:none;flex-shrink:0;width:16px;height:16px;color:var(--muted-foreground)}
:where([data-slot="command-shortcut"]){margin-inline-start:auto;font-size:12px;letter-spacing:.1em;color:var(--muted-foreground)}
:where([data-command-dialog] [data-slot="command"]){border-radius:var(--radius-lg)}
:where([data-command-dialog] [data-slot="command-input-wrapper"]){height:44px}
:where([data-command-dialog] [data-slot="command-group-heading"]){padding-block:8px}
button:where([data-slot="combobox-trigger"],[data-slot="select-trigger"]){all:unset;box-sizing:border-box;display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:8px;width:100%;min-width:180px;height:36px;padding:8px 12px;border:1px solid var(--input);border-radius:var(--radius-md);background:var(--ds-outline-bg);box-shadow:var(--ds-shadow-xs);font-size:14px;line-height:20px;white-space:nowrap;color:inherit;cursor:pointer;transition:color .15s,box-shadow .15s}
button:where([data-slot="combobox-trigger"]:hover){background:var(--ds-outline-hover)}
button:where([data-slot="combobox-trigger"],[data-slot="select-trigger"]):focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px var(--ds-ring-soft)}
button:where([data-slot="combobox-trigger"],[data-slot="select-trigger"]):disabled{cursor:not-allowed;opacity:.5}
button:where([data-slot="select-trigger"][data-size="sm"]){height:32px}
button:where([data-slot="combobox-trigger"],[data-slot="select-trigger"])[data-placeholder]{color:var(--muted-foreground)}
button:where([data-slot="combobox-trigger"],[data-slot="select-trigger"])[aria-invalid="true"]{border-color:var(--destructive);box-shadow:0 0 0 3px var(--ds-ring-invalid)}
:where([data-slot="combobox-value"],[data-slot="select-value"]){flex:1;overflow:hidden;text-overflow:ellipsis;text-align:start}
button:where([data-slot="combobox-trigger"],[data-slot="select-trigger"]) svg{pointer-events:none;flex-shrink:0;width:16px;height:16px;opacity:.5}
button:where([data-slot="combobox-clear"]){all:unset;box-sizing:border-box;position:absolute;top:50%;inset-inline-end:36px;display:flex;align-items:center;justify-content:center;width:20px;height:20px;margin-top:-10px;border-radius:var(--radius-sm);cursor:pointer;opacity:.5}
button:where([data-slot="combobox-clear"]:hover){opacity:1}
button:where([data-slot="combobox-clear"]) svg{width:14px;height:14px}
:where([data-slot="combobox-content"],[data-slot="select-content"]){border:1px solid var(--border);border-radius:var(--radius-md);background:var(--popover);color:var(--popover-foreground);box-shadow:var(--ds-shadow-md);outline:none;transform-origin:top center;animation:salam-pick-in .15s ease}
:where([data-slot="combobox-list"]){padding:4px}
:where([data-slot="select-list"]){padding:4px}
:where([data-slot="select-item"]){padding-inline-end:32px}
:where([data-slot="select-indicator"]){position:absolute;inset-inline-end:8px;display:none;align-items:center;justify-content:center;width:14px;height:14px}
:where([data-slot="select-item"][aria-selected="true"]>[data-slot="select-indicator"]){display:flex}
:where([data-slot="select-indicator"] svg){color:inherit}
:where([data-slot="combobox-item"] svg){margin-inline-start:auto;opacity:0}
:where([data-slot="combobox-item"][aria-selected="true"] svg){opacity:1}
@keyframes salam-pick-in{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){:where([data-slot="combobox-content"],[data-slot="select-content"]){animation:none}}
`

pub const DS_PICK_SEARCH := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>`

pub const DS_PICK_JS := `
var seq=0,openRoot=null,buf='',bufT=0;
function each(l,f){for(var i=0;i<l.length;i++)f(l[i],i)}
function q(r,s){return r.querySelector(s)}
function opts(root){return Array.prototype.slice.call(root.querySelectorAll('[role="option"]'))}
function live(root){return opts(root).filter(function(e){return !e.hidden&&!e.hasAttribute('data-disabled')})}
function text(it){return(it.getAttribute('data-label')||it.textContent||'').replace(/\s+/g,' ').trim()}
function uid(e,p){if(!e.id)e.id=p+(++seq);return e.id}
function active(root){return q(root,'[role="option"][data-active]')}
function mark(root,it,ctl){
each(root.querySelectorAll('[data-active]'),function(e){e.removeAttribute('data-active');if(root.hasAttribute('data-cmd'))e.setAttribute('aria-selected','false')});
if(!it){if(ctl)ctl.removeAttribute('aria-activedescendant');return}
it.setAttribute('data-active','');
if(root.hasAttribute('data-cmd'))it.setAttribute('aria-selected','true');
if(ctl)ctl.setAttribute('aria-activedescendant',uid(it,'salam-opt-'));
if(it.scrollIntoView)it.scrollIntoView({block:'nearest'})
}
function step(root,ctl,d){
var l=live(root);if(!l.length)return;
var cur=active(root),i=l.indexOf(cur);
if(d==='first')i=0;else if(d==='last')i=l.length-1;else i=i<0?(d>0?0:l.length-1):(i+d+l.length)%l.length;
mark(root,l[i],ctl)
}
function filter(root,ctl,qs){
qs=(qs||'').toLowerCase().replace(/^\s+|\s+$/g,'');
var toks=qs?qs.split(/\s+/):[];
each(opts(root),function(it){
var hay=(text(it)+' '+(it.getAttribute('data-value')||'')+' '+(it.getAttribute('data-keywords')||'')).toLowerCase(),ok=true;
for(var i=0;i<toks.length;i++)if(hay.indexOf(toks[i])<0)ok=false;
it.hidden=!ok
});
each(root.querySelectorAll('[role="group"]'),function(g){g.hidden=!q(g,'[role="option"]:not([hidden])')});
each(root.querySelectorAll('[role="separator"]'),function(s){s.hidden=!!qs});
var any=live(root).length>0||!!q(root,'[role="option"]:not([hidden])');
var em=q(root,'[data-slot$="-empty"]');
if(em)em.hidden=any;
var sel=q(root,'[role="option"][aria-selected="true"]:not([hidden])');
step(root,ctl,'first');
if(!root.hasAttribute('data-cmd')&&sel&&!qs)mark(root,sel,ctl)
}
function cmdInit(cmd){
if(cmd.__ready)return;
cmd.__ready=true;
cmd.setAttribute('data-cmd','');
var inp=q(cmd,'[data-slot="command-input"]'),list=q(cmd,'[data-slot="command-list"]');
if(list){uid(list,'salam-cmd-');if(inp){inp.setAttribute('role','combobox');inp.setAttribute('aria-expanded','true');inp.setAttribute('aria-controls',list.id);inp.setAttribute('aria-autocomplete','list')}}
each(cmd.querySelectorAll('[data-slot="command-group"]'),function(g){var h=q(g,'[data-slot="command-group-heading"]');if(h)g.setAttribute('aria-labelledby',uid(h,'salam-cmd-h'))});
filter(cmd,inp,inp?inp.value:'')
}
function cmdRun(cmd,it){
if(!it||it.hasAttribute('data-disabled'))return;
it.dispatchEvent(new CustomEvent('ds-select',{bubbles:true,detail:{value:it.getAttribute('data-value')||text(it)}}));
var h=it.getAttribute('data-href');
var d=cmd.closest('dialog[data-command-dialog]');
if(d&&window.salamDsDialog)window.salamDsDialog.close(d,'select');
if(h&&!/^(javascript|vbscript|data):/i.test(h.replace(/[\u0000- ]/g,'')))location.href=h
}
function pop(root){return q(root,'[popover]')}
function trig(root){return q(root,'[data-slot$="-trigger"]')}
function place(root){
var p=pop(root),t=trig(root);
p.style.minWidth=t.offsetWidth+'px';
dsPlace(p,t,'bottom','start',4)
}
function isOpen(root){return root.getAttribute('data-state')==='open'}
function pOpen(root){
if(isOpen(root)||root.hasAttribute('data-disabled'))return;
if(openRoot&&openRoot!==root)pClose(openRoot,false);
var p=pop(root),t=trig(root);
p.hidden=false;
if(p.showPopover)p.showPopover();
root.setAttribute('data-state','open');
t.setAttribute('aria-expanded','true');
openRoot=root;
place(root);
var inp=q(root,'[data-slot="combobox-input"]');
if(inp){inp.value='';filter(p,inp,'')}else{filter(p,p,'')}
var sel=q(p,'[role="option"][aria-selected="true"]');
if(sel&&!sel.hidden)mark(p,sel,inp||p);
if(inp)inp.focus();else p.focus()
}
function pClose(root,back){
if(!isOpen(root))return;
var p=pop(root),t=trig(root);
if(p.hidePopover){try{p.hidePopover()}catch(x){}}
p.hidden=true;
root.setAttribute('data-state','closed');
t.setAttribute('aria-expanded','false');
if(openRoot===root)openRoot=null;
if(back)t.focus()
}
function setValue(root,val,silent){
var p=pop(root),ph=root.__ph||'',lab=ph,hit=null;
each(opts(p),function(it){var on=val!==''&&(it.getAttribute('data-value')||text(it))===val;it.setAttribute('aria-selected',on?'true':'false');if(on){hit=it;lab=text(it)}});
if(!hit)val='';
root.__val=val;
var v=q(root,'[data-slot$="-value"]');if(v)v.textContent=lab;
var t=trig(root);if(t){if(val)t.removeAttribute('data-placeholder');else t.setAttribute('data-placeholder','')}
var h=q(root,'input[type="hidden"]');if(h){h.value=val;if(!silent)h.dispatchEvent(new Event('change',{bubbles:true}))}
var c=q(root,'[data-slot="combobox-clear"]');if(c)c.hidden=!val;
root.setAttribute('data-value',val);
if(!silent)root.dispatchEvent(new CustomEvent('ds-change',{bubbles:true,detail:{value:val,label:val?lab:''}}))
}
function pInit(root){
if(root.__ready)return;
root.__ready=true;
var p=pop(root),t=trig(root),l=q(p,'[role="listbox"]'),v=q(root,'[data-slot$="-value"]');
root.__ph=v?v.textContent:'';
if(!p.hasAttribute('popover'))p.setAttribute('popover','manual');
p.hidden=true;
uid(l,'salam-lb-');
t.setAttribute('role','combobox');t.setAttribute('aria-haspopup','listbox');t.setAttribute('aria-expanded','false');t.setAttribute('aria-controls',l.id);t.setAttribute('type','button');
if(root.hasAttribute('data-disabled'))t.disabled=true;
if(!root.hasAttribute('data-state'))root.setAttribute('data-state','closed');
setValue(root,root.getAttribute('data-value')||'',true)
}
function typeahead(root,key){
var now=Date.now();
if(now-bufT>700)buf='';
bufT=now;buf+=key.toLowerCase();
var p=pop(root),l=live(p),i=l.indexOf(active(p)),n=l.length,hit=null;
for(var k=1;k<=n&&!hit;k++){var c=l[(i+(buf.length===1?k:n+k))%n];if(c&&text(c).toLowerCase().indexOf(buf)===0)hit=c}
if(hit){if(isOpen(root))mark(p,hit,p);else setValue(root,hit.getAttribute('data-value')||text(hit))}
}
function pKey(root,e){
var p=pop(root),t=trig(root),inp=q(root,'[data-slot="combobox-input"]'),ctl=inp||p;
var k=e.key;
if(!isOpen(root)){
if(e.target===t&&(k==='ArrowDown'||k==='ArrowUp'||k==='Enter'||k===' ')){e.preventDefault();pOpen(root)}
else if(e.target===t&&root.hasAttribute('data-select')&&k.length===1&&!e.ctrlKey&&!e.metaKey){typeahead(root,k)}
return
}
if(k==='ArrowDown'){e.preventDefault();step(p,ctl,1)}
else if(k==='ArrowUp'){e.preventDefault();step(p,ctl,-1)}
else if(k==='Home'&&!inp){e.preventDefault();step(p,ctl,'first')}
else if(k==='End'&&!inp){e.preventDefault();step(p,ctl,'last')}
else if(k==='Enter'||(k===' '&&!inp)){e.preventDefault();var a=active(p);if(a)choose(root,a)}
else if(k==='Escape'){e.preventDefault();e.stopPropagation();pClose(root,true)}
else if(k==='Tab'){pClose(root,false)}
else if(!inp&&k.length===1&&!e.ctrlKey&&!e.metaKey){typeahead(root,k)}
}
function choose(root,it){
if(it.hasAttribute('data-disabled'))return;
var v=it.getAttribute('data-value')||text(it);
if(root.hasAttribute('data-combobox')&&root.__val===v)v='';
setValue(root,v);
pClose(root,true)
}
function rootOf(e){return e.closest&&e.closest('[data-slot="combobox"],[data-slot="select"]')}
function initAll(){
each(document.querySelectorAll('[data-slot="command"]'),cmdInit);
each(document.querySelectorAll('[data-slot="combobox"],[data-slot="select"]'),pInit)
}
window.salamDsPick=initAll;
document.addEventListener('input',function(e){
var t=e.target;
if(t.matches&&t.matches('[data-slot="command-input"]')){var c=t.closest('[data-slot="command"]');cmdInit(c);filter(c,t,t.value)}
else if(t.matches&&t.matches('[data-slot="combobox-input"]')){var r=rootOf(t);pInit(r);filter(pop(r),t,t.value)}
});
document.addEventListener('keydown',function(e){
var t=e.target;
if((e.metaKey||e.ctrlKey)&&e.key){
var ds=document.querySelectorAll('dialog[data-command-dialog][data-hotkey]');
for(var i=0;i<ds.length;i++)if(ds[i].getAttribute('data-hotkey').toLowerCase()===e.key.toLowerCase()&&window.salamDsDialog){e.preventDefault();if(ds[i].open)window.salamDsDialog.close(ds[i]);else window.salamDsDialog.open(ds[i]);return}
}
var c=t.closest&&t.closest('[data-slot="command"]');
if(c){
cmdInit(c);
var inp=q(c,'[data-slot="command-input"]'),k=e.key;
if(k==='ArrowDown'){e.preventDefault();step(c,inp,1)}
else if(k==='ArrowUp'){e.preventDefault();step(c,inp,-1)}
else if(k==='Home'&&t===inp){e.preventDefault();step(c,inp,'first')}
else if(k==='End'&&t===inp){e.preventDefault();step(c,inp,'last')}
else if(k==='Enter'){e.preventDefault();cmdRun(c,active(c))}
return
}
var r=rootOf(t);
if(r){pInit(r);pKey(r,e)}
});
document.addEventListener('click',function(e){
var t=e.target,it=t.closest&&t.closest('[role="option"]');
if(it){
var c=it.closest('[data-slot="command"]');
if(c){cmdInit(c);cmdRun(c,it);return}
var r=rootOf(it);
if(r){pInit(r);choose(r,it);return}
}
var cl=t.closest&&t.closest('[data-slot="combobox-clear"]');
if(cl){var r2=rootOf(cl);pInit(r2);setValue(r2,'');return}
var tr=t.closest&&t.closest('[data-slot="combobox-trigger"],[data-slot="select-trigger"]');
if(tr){var r3=rootOf(tr);pInit(r3);if(isOpen(r3))pClose(r3,true);else pOpen(r3)}
});
document.addEventListener('pointermove',function(e){
var it=e.target.closest&&e.target.closest('[role="option"]');
if(!it||it.hasAttribute('data-disabled')||it.hasAttribute('data-active'))return;
var c=it.closest('[data-slot="command"]');
if(c){mark(c,it,q(c,'[data-slot="command-input"]'));return}
var r=rootOf(it);
if(r)mark(pop(r),it,q(r,'[data-slot="combobox-input"]')||pop(r))
});
document.addEventListener('pointerdown',function(e){
if(openRoot&&!openRoot.contains(e.target))pClose(openRoot,false)
});
window.addEventListener('resize',function(){if(openRoot)place(openRoot)});
window.addEventListener('scroll',function(e){if(openRoot&&!pop(openRoot).contains(e.target))place(openRoot)},true);
document.addEventListener('ds-open',function(e){
var d=e.target;
if(d.matches&&d.matches('dialog[data-command-dialog]')){var c=q(d,'[data-slot="command"]');if(c){cmdInit(c);var i=q(c,'[data-slot="command-input"]');if(i){i.value='';filter(c,i,'');i.focus()}}}
});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
`

func ds_pick_js(): str:
    ret "(function(){if(window.salamDsPick)return;" + DS_PLACE_JS + DS_PICK_JS + "})();"
end

func ds_pick_css(): str:
    if DsOn():
        ret DS_PICK_MIN_CSS + DS_PICK_CSS
    end
    ret DS_PICK_MIN_CSS
end

func ds_pick_out(html: str, withdlg: bool): Output:
    mut o := Output {}
    o.html = html
    o.shared_js = ds_pick_js()
    o.shared_css = ds_pick_css()
    if withdlg:
        o.shared_js = DS_DIALOG_JS + o.shared_js
        o.shared_css = ds_dialog_css() + o.shared_css
    end
    ret o
end

func ds_pick_part(n: Node, tag: str, slot: str, extra: str): Output:
    ret ds_pick_out(
        DsOpen(n, tag, slot, extra) + Escape(n.content) + n.inner + "</" + tag + ">", false
    )
end

func ds_hidden_input(n: Node, slot: str): str:
    name := DsAttr(n.attrs, "data-name")
    if name == "":
        ret ""
    end
    ret "<input type=\"hidden\" data-slot=\"" + slot + "\" name=\"" + name + "\">"
end

@en "gen_command"
@fa "ساخت فرمان"
pub func gen_command(n: Node): Output:
    ret ds_pick_part(n, "div", "command", "")
end

@en "gen_command_input"
@fa "ساخت ورودی فرمان"
pub func gen_command_input(n: Node): Output:
    ph := Escape(DsAttr(n.attrs, "data-placeholder"))
    ret ds_pick_out(
        DsOpen(
            n, "div", "command-input-wrapper", ""
        ) + DS_PICK_SEARCH +
            "<input type=\"text\" data-slot=\"command-input\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" placeholder=\"" +
            ph + "\"></div>",
        false
    )
end

@en "gen_command_list"
@fa "ساخت فهرست فرمان"
pub func gen_command_list(n: Node): Output:
    ret ds_pick_part(n, "div", "command-list", " role=\"listbox\"")
end

@en "gen_command_group"
@fa "ساخت گروه فرمان"
pub func gen_command_group(n: Node): Output:
    mut head := ""
    h := DsAttr(n.attrs, "data-heading")
    if h != "":
        head = "<div data-slot=\"command-group-heading\" aria-hidden=\"true\">" + Escape(h) +
            "</div>"
    end
    ret ds_pick_out(
        DsOpen(
            n, "div", "command-group", " role=\"group\""
        ) + head + Escape(n.content) + n.inner + "</div>",
        false
    )
end

@en "gen_command_item"
@fa "ساخت گزینه فرمان"
pub func gen_command_item(n: Node): Output:
    ret ds_pick_part(n, "div", "command-item", " role=\"option\" aria-selected=\"false\"")
end

@en "gen_command_empty"
@fa "ساخت خالی فرمان"
pub func gen_command_empty(n: Node): Output:
    ret ds_pick_part(n, "div", "command-empty", " hidden")
end

@en "gen_command_shortcut"
@fa "ساخت میانبر فرمان"
pub func gen_command_shortcut(n: Node): Output:
    ret ds_pick_part(n, "span", "command-shortcut", "")
end

@en "gen_command_separator"
@fa "ساخت جداکننده فرمان"
pub func gen_command_separator(n: Node): Output:
    ret ds_pick_out(DsOpen(n, "div", "command-separator", " role=\"separator\"") + "</div>", false)
end

@en "gen_command_dialog"
@fa "ساخت پنجره فرمان"
pub func gen_command_dialog(n: Node): Output:
    ret ds_pick_out(
        DsOpen(
            n,
            "dialog",
            "dialog",
            " data-overlay data-command-dialog data-state=\"closed\" aria-label=\"" + DsT("Command palette") + "\""
        ) + "<div data-slot=\"command\">" + n.inner + "</div></dialog>",
        true
    )
end

@en "gen_combobox"
@fa "ساخت جعبه ترکیبی"
pub func gen_combobox(n: Node): Output:
    mut ph := Escape(DsAttr(n.attrs, "data-placeholder"))
    if ph == "":
        ph = DsT("Select...")
    end
    mut sp := Escape(DsAttr(n.attrs, "data-search-placeholder"))
    if sp == "":
        sp = DsT("Search...")
    end
    mut em := Escape(DsAttr(n.attrs, "data-empty"))
    if em == "":
        em = DsT("No results found.")
    end
    mut clear := ""
    if DsHas(n.attrs, "data-clearable"):
        clear = "<button type=\"button\" data-slot=\"combobox-clear\" aria-label=\"" + DsT("Clear") + "\" hidden>" +
            DS_ICON_X + "</button>"
    end
    html := DsOpen(
        n, "div", "combobox", " data-combobox data-state=\"closed\""
    ) + ds_hidden_input(
        n, "combobox-input-hidden"
    ) +
        "<button type=\"button\" data-slot=\"combobox-trigger\"><span data-slot=\"combobox-value\">" +
        ph + "</span>" + DS_ICON_CHEVRON_DOWN + "</button>" + clear + "<div data-slot=\"combobox-content\" popover=\"manual\" hidden tabindex=\"-1\"><div data-slot=\"combobox-search\">" + DS_PICK_SEARCH + "<input type=\"text\" data-slot=\"combobox-input\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"" + sp + "\"></div><div data-slot=\"combobox-list\" role=\"listbox\">" + n.inner + "</div><div data-slot=\"combobox-empty\" hidden>" + em + "</div></div></div>"
    ret ds_pick_out(html, false)
end

@en "gen_combobox_item"
@fa "ساخت گزینه جعبه ترکیبی"
pub func gen_combobox_item(n: Node): Output:
    ret ds_pick_out(
        DsOpen(
            n, "div", "combobox-item", " role=\"option\" aria-selected=\"false\""
        ) + Escape(n.content) + n.inner + DS_ICON_CHECK + "</div>",
        false
    )
end

@en "gen_select_box"
@fa "ساخت جعبه انتخاب"
pub func gen_select_box(n: Node): Output:
    ret ds_pick_out(
        DsOpen(
            n, "div", "select", " data-select data-state=\"closed\""
        ) + ds_hidden_input(n, "select-input") + n.inner + "</div>",
        false
    )
end

@en "gen_select_trigger"
@fa "ساخت دکمه جعبه انتخاب"
pub func gen_select_trigger(n: Node): Output:
    ret ds_pick_out(
        DsOpen(
            n, "button", "select-trigger", " type=\"button\""
        ) + "<span data-slot=\"select-value\">" + Escape(n.content) + "</span>" +
            DS_ICON_CHEVRON_DOWN + n.inner + "</button>",
        false
    )
end

@en "gen_select_content"
@fa "ساخت محتوای جعبه انتخاب"
pub func gen_select_content(n: Node): Output:
    ret ds_pick_out(
        DsOpen(
            n, "div", "select-content", " popover=\"manual\" hidden tabindex=\"-1\""
        ) + "<div data-slot=\"select-list\" role=\"listbox\">" + n.inner + "</div></div>",
        false
    )
end

@en "gen_select_item"
@fa "ساخت گزینه جعبه انتخاب"
pub func gen_select_item(n: Node): Output:
    ret ds_pick_out(
        DsOpen(
            n, "div", "select-item", " role=\"option\" aria-selected=\"false\""
        ) + "<span>" + Escape(n.content) + n.inner +
            "</span><span data-slot=\"select-indicator\">" + DS_ICON_CHECK + "</span></div>",
        false
    )
end

@en "gen_select_group"
@fa "ساخت گروه جعبه انتخاب"
pub func gen_select_group(n: Node): Output:
    mut head := ""
    h := DsAttr(n.attrs, "data-heading")
    if h != "":
        head = "<div data-slot=\"select-label\" aria-hidden=\"true\">" + Escape(h) + "</div>"
    end
    ret ds_pick_out(
        DsOpen(n, "div", "select-group", " role=\"group\"") + head + n.inner + "</div>", false
    )
end

@en "gen_select_separator"
@fa "ساخت جداکننده جعبه انتخاب"
pub func gen_select_separator(n: Node): Output:
    ret ds_pick_out(DsOpen(n, "div", "select-separator", " role=\"separator\"") + "</div>", false)
end
