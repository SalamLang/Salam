package layoutgen

pub const DS_SIDEBAR_MIN_CSS := `
:where([data-slot="sidebar-provider"]){--sidebar-width:16rem;--sidebar-icon:3rem;display:flex;flex-direction:row;width:100%;min-height:100svh}
:where([data-slot="sidebar"]){position:sticky;top:0;align-self:flex-start;display:flex;flex-direction:column;flex-shrink:0;width:var(--sidebar-width);height:100svh;overflow:hidden;transition:width .2s linear,margin .2s linear,visibility 0s}
:where([data-slot="sidebar"][data-side="right"]){order:2}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="offcanvas"]){margin-inline-start:calc(var(--sidebar-width) * -1);visibility:hidden;transition:width .2s linear,margin .2s linear,visibility 0s .2s}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="offcanvas"][data-side="right"]){margin-inline-start:0;margin-inline-end:calc(var(--sidebar-width) * -1)}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"]){width:var(--sidebar-icon)}
:where([data-slot="sidebar-content"]){display:flex;flex:1;flex-direction:column;min-height:0;overflow-x:hidden;overflow-y:auto}
:where([data-slot="sidebar-inset"]){position:relative;display:flex;flex:1;flex-direction:column;min-width:0}
:where([data-slot="sidebar-menu"]){display:flex;flex-direction:column;min-width:0;margin:0;padding:0;list-style:none}
:where([data-slot="sidebar-menu-sub"]){display:flex;flex-direction:column;min-width:0;margin:0;padding:0;list-style:none}
:where([data-slot="sidebar-menu-item"]:not([data-open])>[data-slot="sidebar-menu-sub"]){display:none}
:where([data-slot="sidebar-menu-sub-button"]){display:flex;min-width:0;align-items:center;overflow:hidden;text-decoration:none;color:inherit;cursor:pointer}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-sub"],[data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-chevron"]){display:none}
:where([data-slot="sidebar-menu-chevron"]){flex-shrink:0;margin-inline-start:auto;width:16px;height:16px;transition:transform .2s}
:where([data-slot="sidebar-menu-item"][data-open]>[data-slot="sidebar-menu-button"]>[data-slot="sidebar-menu-chevron"]){transform:rotate(90deg)}
:where(:dir(rtl)) :where([data-slot="sidebar-menu-chevron"]){transform:scaleX(-1)}
:where(:dir(rtl)) :where([data-slot="sidebar-menu-item"][data-open]>[data-slot="sidebar-menu-button"]>[data-slot="sidebar-menu-chevron"]){transform:rotate(90deg)}
:where([data-slot="sidebar-rail"]){all:unset;box-sizing:border-box;position:absolute;inset-block:0;inset-inline-end:0;z-index:20;display:none;width:12px;cursor:w-resize}
:where([data-slot="sidebar"][data-side="right"]>[data-slot="sidebar-rail"]){inset-inline-end:auto;inset-inline-start:0;cursor:e-resize}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"]>[data-slot="sidebar-rail"]){cursor:e-resize}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-side="right"]>[data-slot="sidebar-rail"]){cursor:w-resize}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="offcanvas"]){overflow:visible}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="offcanvas"]>[data-slot="sidebar-rail"]){visibility:visible;inset-inline-end:-12px}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="offcanvas"][data-side="right"]>[data-slot="sidebar-rail"]){inset-inline-end:auto;inset-inline-start:-12px}
:where([data-slot="sidebar-tooltip"]){position:fixed;z-index:60;display:none;width:max-content;max-width:16rem;pointer-events:none;padding:6px 12px;border-radius:4px;font-size:12px;line-height:16px;background:CanvasText;color:Canvas}
:where([data-slot="sidebar-tooltip"][data-open]){display:block}
@media (min-width:768px){:where([data-slot="sidebar"]:not([data-collapsible="none"])>[data-slot="sidebar-rail"]){display:block}}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-text"],[data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-badge"]){display:none}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-group-label"]){margin-top:-32px;opacity:0}
@media (max-width:767px){
:where([data-slot="sidebar"]){position:fixed;inset-block:0;inset-inline-start:0;z-index:50;width:18rem;height:100svh;margin:0;visibility:visible;transform:translateX(-100%);transition:transform .2s ease-in-out}
:where([data-slot="sidebar"][data-side="right"]){inset-inline-start:auto;inset-inline-end:0;transform:translateX(100%)}
:where(:dir(rtl)) :where([data-slot="sidebar"]){transform:translateX(100%)}
:where(:dir(rtl)) :where([data-slot="sidebar"][data-side="right"]){transform:translateX(-100%)}
:where([data-slot="sidebar-provider"][data-mobile-open]>[data-slot="sidebar"]){transform:none}
:where([data-slot="sidebar-provider"][data-mobile-open])::before{content:"";position:fixed;inset:0;z-index:40;background:rgb(0 0 0/.5)}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"]){width:18rem;margin:0;visibility:visible}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-text"]){display:inline}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-sub"]){display:flex}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-item"]:not([data-open])>[data-slot="sidebar-menu-sub"]){display:none}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-chevron"]){display:block}
}
@media (prefers-reduced-motion:reduce){:where([data-slot="sidebar"]){transition:none!important}}
`

pub const DS_SIDEBAR_CSS := `
:where([data-slot="sidebar"]){background:var(--sidebar);color:var(--sidebar-foreground);border:0 solid var(--sidebar-border);border-inline-end-width:1px;font-size:14px;line-height:20px}
:where([data-slot="sidebar"][data-side="right"]){border-inline-end-width:0;border-inline-start-width:1px}
:where([data-slot="sidebar"][data-variant="floating"]){height:calc(100svh - 16px);margin:8px;border-width:1px;border-radius:var(--radius-lg);box-shadow:var(--ds-shadow-sm)}
:where([data-slot="sidebar"][data-variant="inset"]){border-width:0}
:where([data-slot="sidebar-provider"]:has(>[data-slot="sidebar"][data-variant="inset"])){background:var(--sidebar)}
:where([data-slot="sidebar-provider"]:has(>[data-slot="sidebar"][data-variant="inset"])>[data-slot="sidebar-inset"]){min-height:calc(100svh - 16px);margin:8px;margin-inline-start:0;border-radius:var(--radius-xl);background:var(--background);color:var(--foreground);box-shadow:var(--ds-shadow-sm)}
:where([data-slot="sidebar-header"],[data-slot="sidebar-footer"]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:8px;overflow:hidden;white-space:nowrap}
:where([data-slot="sidebar-content"]){gap:8px}
:where([data-slot="sidebar-group"]){position:relative;display:flex;flex-direction:column;min-width:0;padding:8px}
:where([data-slot="sidebar-group-label"]){display:flex;flex-direction:row;flex-shrink:0;align-items:center;justify-content:flex-start;height:32px;padding:0 8px;border-radius:var(--radius-md);font-size:12px;line-height:16px;font-weight:500;color:color-mix(in oklab,var(--sidebar-foreground) 70%,transparent);transition:margin .2s linear,opacity .2s linear}
:where([data-slot="sidebar-group-content"]){width:100%;font-size:14px}
:where([data-slot="sidebar-menu"]){gap:4px;width:100%}
:where([data-slot="sidebar-menu-item"]){position:relative}
:where([data-slot="sidebar-menu-button"]){all:unset;box-sizing:border-box;display:flex;flex-direction:row;align-items:center;gap:8px;width:100%;height:32px;padding:8px;overflow:hidden;border-radius:var(--radius-md);font-size:14px;line-height:20px;text-align:start;cursor:pointer;color:inherit;transition:width .2s linear,height .2s linear,padding .2s linear}
:where([data-slot="sidebar-menu-button"]:hover){background:var(--sidebar-accent);color:var(--sidebar-accent-foreground)}
:where([data-slot="sidebar-menu-button"]:focus-visible){box-shadow:0 0 0 2px var(--sidebar-ring)}
:where([data-slot="sidebar-menu-button"][data-active]){background:var(--sidebar-accent);color:var(--sidebar-accent-foreground);font-weight:500}
:where([data-slot="sidebar-menu-button"]:disabled){pointer-events:none;opacity:.5}
:where([data-slot="sidebar-menu-button"] svg){flex-shrink:0;width:16px;height:16px}
:where([data-slot="sidebar-menu-text"]){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
:where([data-slot="sidebar-menu-button"][data-variant="outline"]){background:var(--background);box-shadow:0 0 0 1px var(--sidebar-border)}
:where([data-slot="sidebar-menu-button"][data-variant="outline"]:hover){background:var(--sidebar-accent);box-shadow:0 0 0 1px var(--sidebar-accent)}
:where([data-slot="sidebar-menu-button"][data-size="sm"]){height:28px;font-size:12px}
:where([data-slot="sidebar-menu-button"][data-size="lg"]){height:48px}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-button"]){width:32px;height:32px;padding:8px}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="icon"] [data-slot="sidebar-menu-button"][data-size="lg"]){height:32px}
:where([data-slot="sidebar-menu-sub"]){gap:4px;margin:0 14px;padding:2px 10px;border-inline-start:1px solid var(--sidebar-border)}
:where([data-slot="sidebar-menu-sub-item"]){position:relative}
:where([data-slot="sidebar-menu-sub-button"]){all:unset;box-sizing:border-box;display:flex;flex-direction:row;align-items:center;gap:8px;min-width:0;height:28px;padding:0 8px;overflow:hidden;border-radius:var(--radius-md);font-size:14px;line-height:20px;color:var(--sidebar-foreground);cursor:pointer;text-decoration:none}
:where([data-slot="sidebar-menu-sub-button"][data-size="sm"]){font-size:12px;line-height:16px}
:where([data-slot="sidebar-menu-sub-button"]:hover,[data-slot="sidebar-menu-sub-button"]:active){background:var(--sidebar-accent);color:var(--sidebar-accent-foreground)}
:where([data-slot="sidebar-menu-sub-button"]:focus-visible){box-shadow:0 0 0 2px var(--sidebar-ring)}
:where([data-slot="sidebar-menu-sub-button"][data-active]){background:var(--sidebar-accent);color:var(--sidebar-accent-foreground)}
:where([data-slot="sidebar-menu-sub-button"]:disabled,[data-slot="sidebar-menu-sub-button"][aria-disabled="true"]){pointer-events:none;opacity:.5}
:where([data-slot="sidebar-menu-sub-button"] svg){flex-shrink:0;width:16px;height:16px;color:var(--sidebar-accent-foreground)}
:where([data-slot="sidebar-rail"]){transition:all .2s linear}
:where([data-slot="sidebar-rail"])::after{content:"";position:absolute;inset-block:0;inset-inline-start:50%;width:2px;margin-inline-start:-1px}
:where([data-slot="sidebar-rail"]:hover)::after{background:var(--sidebar-border)}
:where([data-slot="sidebar-rail"]:focus-visible)::after{background:var(--sidebar-ring)}
:where([data-slot="sidebar-provider"][data-state="collapsed"]>[data-slot="sidebar"][data-collapsible="offcanvas"]>[data-slot="sidebar-rail"]:hover){background:var(--sidebar)}
:where([data-slot="sidebar-menu-badge"]){position:absolute;flex-direction:row;inset-inline-end:4px;top:50%;display:flex;align-items:center;justify-content:center;min-width:20px;height:20px;margin-top:-10px;padding:0 4px;border-radius:var(--radius-md);font-size:12px;font-weight:500;pointer-events:none;color:var(--sidebar-foreground)}
:where([data-slot="sidebar-separator"]){height:1px;margin:0 8px;background:var(--sidebar-border)}
button:where([data-slot="sidebar-trigger"]){all:unset;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;gap:8px;width:28px;height:28px;border-radius:var(--radius-md);cursor:pointer;transition:background .15s}
button:where([data-slot="sidebar-trigger"]:hover){background:var(--accent);color:var(--accent-foreground)}
button:where([data-slot="sidebar-trigger"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-soft)}
button:where([data-slot="sidebar-trigger"]) svg{width:16px;height:16px;pointer-events:none}
:where(:dir(rtl)) button:where([data-slot="sidebar-trigger"]) svg{transform:scaleX(-1)}
`

pub const DS_SIDEBAR_JS := `
function each(l,f){for(var i=0;i<l.length;i++)f(l[i],i)}
function prov(e){return e.closest&&e.closest('[data-slot="sidebar-provider"]')}
function mobile(){return window.matchMedia&&matchMedia('(max-width:767px)').matches}
function sync(p){
var open=mobile()?p.hasAttribute('data-mobile-open'):p.getAttribute('data-state')!=='collapsed';
each(p.querySelectorAll('[data-slot="sidebar-trigger"]'),function(t){t.setAttribute('aria-expanded',open?'true':'false')})
}
function setState(p,s){
p.setAttribute('data-state',s);
sync(p);
p.dispatchEvent(new CustomEvent('ds-change',{bubbles:true,detail:{open:s==='expanded'}}))
}
function toggle(p){
if(mobile()){
if(p.hasAttribute('data-mobile-open'))p.removeAttribute('data-mobile-open');else p.setAttribute('data-mobile-open','');
sync(p);
return
}
setState(p,p.getAttribute('data-state')==='collapsed'?'expanded':'collapsed')
}
var CHEV='<svg data-slot="sidebar-menu-chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
var tip=null,tipBtn=null;
function tipText(b){var t=b.getAttribute('data-tooltip');if(t)return t;var s=b.querySelector('[data-slot="sidebar-menu-text"]');return s?s.textContent.trim():''}
function tipHide(){if(tip)tip.removeAttribute('data-open');tipBtn=null}
function tipShow(b){
if(mobile())return;
var p=prov(b);
if(!p||p.getAttribute('data-state')!=='collapsed')return;
var a=b.closest('[data-slot="sidebar"]');
if(!a||a.getAttribute('data-collapsible')!=='icon')return;
var t=tipText(b);
if(!t)return;
if(!tip){tip=document.createElement('div');tip.setAttribute('data-slot','sidebar-tooltip');tip.setAttribute('role','tooltip');document.body.appendChild(tip)}
tip.textContent=t;
tip.setAttribute('data-open','');
tipBtn=b;
var r=b.getBoundingClientRect(),ar=a.getBoundingClientRect(),w=tip.offsetWidth,h=tip.offsetHeight;
var toRight=(ar.left+ar.right)/2<window.innerWidth/2;
tip.style.top=Math.max(4,r.top+(r.height-h)/2)+'px';
tip.style.left=(toRight?r.right+8:Math.max(4,r.left-8-w))+'px'
}
function subButton(it){
var b=null,u=false;
for(var c=it.firstElementChild;c;c=c.nextElementSibling){var k=c.getAttribute('data-slot');if(k==='sidebar-menu-button')b=c;else if(k==='sidebar-menu-sub')u=true}
return u?b:null
}
function init(p){
if(p.__ready)return;
p.__ready=true;
if(!p.hasAttribute('data-state'))p.setAttribute('data-state','expanded');
each(p.querySelectorAll('[data-slot="sidebar-menu-item"]'),function(it){
var b=subButton(it);
if(!b)return;
b.setAttribute('aria-expanded',it.hasAttribute('data-open')?'true':'false');
if(!b.querySelector('[data-slot="sidebar-menu-chevron"]'))b.insertAdjacentHTML('beforeend',CHEV)
});
sync(p)
}
function initAll(){each(document.querySelectorAll('[data-slot="sidebar-provider"]'),init)}
window.salamDsSidebar={init:initAll,toggle:function(p){init(p);toggle(p)}};
document.addEventListener('click',function(e){
tipHide();
var t=e.target.closest&&e.target.closest('[data-slot="sidebar-trigger"],[data-slot="sidebar-rail"]');
if(t){var p=prov(t);if(p){init(p);toggle(p)}return}
var p2=e.target.getAttribute&&e.target.getAttribute('data-slot')==='sidebar-provider'?e.target:null;
if(p2&&p2.hasAttribute('data-mobile-open')){p2.removeAttribute('data-mobile-open');sync(p2);return}
var l=e.target.closest&&e.target.closest('[data-slot="sidebar-menu-button"]');
if(l){
var it=l.parentNode;
if(it&&it.getAttribute&&it.getAttribute('data-slot')==='sidebar-menu-item'&&subButton(it)===l){
var op=!it.hasAttribute('data-open');
if(op)it.setAttribute('data-open','');else it.removeAttribute('data-open');
l.setAttribute('aria-expanded',op?'true':'false');
it.dispatchEvent(new CustomEvent('ds-change',{bubbles:true,detail:{open:op}}))
}
var p3=prov(l);if(p3&&p3.hasAttribute('data-mobile-open')&&l.tagName==='A'){p3.removeAttribute('data-mobile-open');sync(p3)}}
});
document.addEventListener('mouseover',function(e){var b=e.target.closest&&e.target.closest('[data-slot="sidebar-menu-button"]');if(b&&b!==tipBtn)tipShow(b)});
document.addEventListener('mouseout',function(e){var b=e.target.closest&&e.target.closest('[data-slot="sidebar-menu-button"]');if(b&&!(e.relatedTarget&&b.contains(e.relatedTarget)))tipHide()});
document.addEventListener('focusin',function(e){var b=e.target.closest&&e.target.closest('[data-slot="sidebar-menu-button"]');if(b&&e.target.matches&&e.target.matches(':focus-visible'))tipShow(b)});
document.addEventListener('focusout',tipHide);
document.addEventListener('scroll',tipHide,true);
document.addEventListener('keydown',function(e){
if(e.key==='Escape')tipHide();
if((e.ctrlKey||e.metaKey)&&e.key&&e.key.toLowerCase()==='b'){
var p=document.querySelector('[data-slot="sidebar-provider"]:not([data-hotkey="false"])');
if(p){e.preventDefault();init(p);toggle(p)}
return
}
if(e.key==='Escape'){
var o=document.querySelector('[data-slot="sidebar-provider"][data-mobile-open]');
if(o){o.removeAttribute('data-mobile-open');sync(o)}
}
});
if(window.matchMedia)matchMedia('(max-width:767px)').addEventListener('change',function(){each(document.querySelectorAll('[data-slot="sidebar-provider"]'),function(p){p.removeAttribute('data-mobile-open');sync(p)})});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAll);else initAll()
`

pub const DS_SIDEBAR_ICON := `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>`

func ds_sidebar_css(): str:
    if DsOn():
        ret DS_SIDEBAR_MIN_CSS + DS_SIDEBAR_CSS
    end
    ret DS_SIDEBAR_MIN_CSS
end

func ds_sidebar_out(n: Node, tag: str, slot: str, extra: str, lead: str): Output:
    mut o := Output {}
    o.html = DsOpen(n, tag, slot, extra) + lead + Escape(n.content) + n.inner + "</" + tag + ">"
    o.shared_js = "(function(){if(window.salamDsSidebar)return;" + DS_SIDEBAR_JS + "})();"
    o.shared_css = ds_sidebar_css()
    ret o
end

func ds_sidebar_default(n: Node, key: str, value: str): str:
    if DsAttr(n.attrs, key) == "":
        ret " " + key + "=\"" + value + "\""
    end
    ret ""
end

@en "gen_sidebar_provider"
@fa "ساخت فراهم کننده نوار کناری"
pub func gen_sidebar_provider(n: Node): Output:
    mut state := "expanded"
    if DsHas(n.attrs, "data-collapsed"):
        state = "collapsed"
    end
    ret ds_sidebar_out(n, "div", "sidebar-provider", " data-state=\"" + state + "\"", "")
end

@en "gen_sidebar_panel"
@fa "ساخت پنل نوار کناری"
pub func gen_sidebar_panel(n: Node): Output:
    extra := ds_sidebar_default(n, "data-side", "left") + ds_sidebar_default(
        n, "data-variant", "sidebar"
    ) + ds_sidebar_default(
        n, "data-collapsible", "offcanvas"
    )
    ret ds_sidebar_out(n, "aside", "sidebar", extra, "")
end

@en "gen_sidebar_header"
@fa "ساخت سرایند نوار کناری"
pub func gen_sidebar_header(n: Node): Output:
    ret ds_sidebar_out(n, "div", "sidebar-header", "", "")
end

@en "gen_sidebar_content"
@fa "ساخت محتوای نوار کناری"
pub func gen_sidebar_content(n: Node): Output:
    ret ds_sidebar_out(n, "div", "sidebar-content", "", "")
end

@en "gen_sidebar_footer"
@fa "ساخت پاورقی نوار کناری"
pub func gen_sidebar_footer(n: Node): Output:
    ret ds_sidebar_out(n, "div", "sidebar-footer", "", "")
end

@en "gen_sidebar_group"
@fa "ساخت گروه نوار کناری"
pub func gen_sidebar_group(n: Node): Output:
    ret ds_sidebar_out(n, "div", "sidebar-group", "", "")
end

@en "gen_sidebar_group_label"
@fa "ساخت برچسب گروه نوار کناری"
pub func gen_sidebar_group_label(n: Node): Output:
    ret ds_sidebar_out(n, "div", "sidebar-group-label", "", "")
end

@en "gen_sidebar_group_content"
@fa "ساخت محتوای گروه نوار کناری"
pub func gen_sidebar_group_content(n: Node): Output:
    ret ds_sidebar_out(n, "div", "sidebar-group-content", "", "")
end

@en "gen_sidebar_menu"
@fa "ساخت منوی نوار کناری"
pub func gen_sidebar_menu(n: Node): Output:
    ret ds_sidebar_out(n, "ul", "sidebar-menu", "", "")
end

@en "gen_sidebar_menu_item"
@fa "ساخت آیتم منوی نوار کناری"
pub func gen_sidebar_menu_item(n: Node): Output:
    ret ds_sidebar_out(n, "li", "sidebar-menu-item", "", "")
end

@en "gen_sidebar_menu_sub"
@fa "ساخت زیرمنوی نوار کناری"
pub func gen_sidebar_menu_sub(n: Node): Output:
    ret ds_sidebar_out(n, "ul", "sidebar-menu-sub", "", "")
end

@en "gen_sidebar_menu_sub_item"
@fa "ساخت آیتم زیرمنوی نوار کناری"
pub func gen_sidebar_menu_sub_item(n: Node): Output:
    ret ds_sidebar_out(n, "li", "sidebar-menu-sub-item", "", "")
end

@en "gen_sidebar_menu_sub_button"
@fa "ساخت دکمه زیرمنوی نوار کناری"
pub func gen_sidebar_menu_sub_button(n: Node): Output:
    mut tag := "button"
    mut extra := " type=\"button\""
    if DsAttr(n.attrs, "href") != "":
        tag = "a"
        extra = ""
    end
    ret ds_sidebar_out(
        n, tag, "sidebar-menu-sub-button", ds_sidebar_default(n, "data-size", "md") + extra, ""
    )
end

@en "gen_sidebar_rail"
@fa "ساخت لبه نوار کناری"
pub func gen_sidebar_rail(n: Node): Output:
    ret ds_sidebar_out(
        n,
        "button",
        "sidebar-rail",
        " type=\"button\" tabindex=\"-1\" aria-label=\"Toggle sidebar\" title=\"Toggle sidebar\"",
        ""
    )
end

@en "gen_sidebar_menu_button"
@fa "ساخت دکمه منوی نوار کناری"
pub func gen_sidebar_menu_button(n: Node): Output:
    mut o := Output {}
    mut tag := "button"
    mut extra := " type=\"button\""
    if DsAttr(n.attrs, "href") != "":
        tag = "a"
        extra = ""
    end
    o.html = DsOpen(
        n, tag, "sidebar-menu-button", extra
    ) + n.inner + "<span data-slot=\"sidebar-menu-text\">" + Escape(n.content) + "</span></" + tag +
        ">"
    o.shared_js = "(function(){if(window.salamDsSidebar)return;" + DS_SIDEBAR_JS + "})();"
    o.shared_css = ds_sidebar_css()
    ret o
end

