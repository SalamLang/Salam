package layoutgen

pub const DS_TABLE_CSS := `
:where([data-slot="table-container"]){position:relative;width:100%;overflow-x:auto}
:where([data-slot="table-container"]>table){display:table;width:100%;caption-side:bottom;border-collapse:collapse;font-size:14px;line-height:20px}
:where([data-slot="table-container"]>table thead){display:table-header-group}
:where([data-slot="table-container"]>table tbody){display:table-row-group}
:where([data-slot="table-container"]>table tfoot){display:table-footer-group;border-top:1px solid var(--border);background:color-mix(in oklab,var(--muted) 50%,transparent);font-weight:500}
:where([data-slot="table-container"]>table tr){display:table-row;border-bottom:1px solid var(--border);transition:background-color .15s}
:where([data-slot="table-container"]>table tbody tr:last-child),:where([data-slot="table-container"]>table tfoot tr:last-child){border-bottom:0}
:where([data-slot="table-container"]>table tr:hover){background:color-mix(in oklab,var(--muted) 50%,transparent)}
:where([data-slot="table-container"]>table tr[data-selected]),:where([data-slot="table-container"]>table tr[data-state="selected"]),:where([data-slot="table-container"]>table tr[aria-selected="true"]){background:var(--muted)}
:where([data-slot="table-container"]>table th){display:table-cell;height:40px;padding:0 8px;vertical-align:middle;text-align:start;font-weight:500;white-space:nowrap;color:var(--foreground)}
:where([data-slot="table-container"]>table td){display:table-cell;padding:8px;vertical-align:middle;text-align:start;white-space:nowrap}
:where([data-slot="table-container"]>table caption){display:table-caption;margin-top:16px;font-size:14px;line-height:20px;text-align:center;color:var(--muted-foreground)}
`

pub const DS_TYPOGRAPHY_CSS := `
:where([data-slot="typography"] h1){scroll-margin-top:80px;font-size:36px;line-height:40px;font-weight:800;letter-spacing:-.025em;text-wrap:balance}
:where([data-slot="typography"] h2){scroll-margin-top:80px;margin-top:40px;border-bottom:1px solid var(--border);padding-bottom:8px;font-size:30px;line-height:36px;font-weight:600;letter-spacing:-.025em}
:where([data-slot="typography"] h3){scroll-margin-top:80px;margin-top:32px;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-.025em}
:where([data-slot="typography"] h4){scroll-margin-top:80px;margin-top:32px;font-size:20px;line-height:28px;font-weight:600;letter-spacing:-.025em}
:where([data-slot="typography"] :is(h1,h2,h3,h4):first-child){margin-top:0}
:where([data-slot="typography"] p){margin:0;line-height:28px}
:where([data-slot="typography"] p:not(:first-child)){margin-top:24px}
:where([data-slot="typography"] blockquote){margin:24px 0 0;border-inline-start:2px solid var(--border);padding-inline-start:24px;font-style:italic}
:where([data-slot="typography"] :is(ul,ol)){margin:24px 0;margin-inline-start:24px;padding:0}
:where([data-slot="typography"] ul){list-style:disc}
:where([data-slot="typography"] ol){list-style:decimal}
:where([data-slot="typography"] li){display:list-item}
:where([data-slot="typography"] li+li){margin-top:8px}
:where([data-slot="typography"] :not(pre)>code){position:relative;border-radius:4px;background:var(--muted);padding:3.2px 4.8px;font-size:14px;font-weight:600}
:where([data-slot="typography"] .lead){font-size:20px;line-height:28px;color:var(--muted-foreground)}
:where([data-slot="typography"] .large){font-size:18px;line-height:28px;font-weight:600}
:where([data-slot="typography"] .small){font-size:14px;line-height:1;font-weight:500}
:where([data-slot="typography"] .muted){font-size:14px;line-height:20px;color:var(--muted-foreground)}
`

pub const DS_SCROLL_MIN_CSS := `
:where([data-slot="scroll-area"]){overflow:auto}
:where([data-slot="scroll-area"][data-orientation="vertical"]){overflow-x:hidden}
:where([data-slot="scroll-area"][data-orientation="horizontal"]){overflow-y:hidden}
`

pub const DS_SCROLL_CSS := `
:where([data-slot="scroll-area"]){position:relative;scrollbar-width:thin;scrollbar-color:var(--border) transparent;outline:none;transition:color .15s,box-shadow .15s}
:where([data-slot="scroll-area"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-soft);outline:1px solid var(--ring)}
:where([data-slot="scroll-area"])::-webkit-scrollbar{width:10px;height:10px}
:where([data-slot="scroll-area"])::-webkit-scrollbar-track{background:transparent}
:where([data-slot="scroll-area"])::-webkit-scrollbar-thumb{border:2px solid transparent;border-radius:9999px;background:var(--border);background-clip:padding-box}
:where([data-slot="scroll-area"])::-webkit-scrollbar-corner{background:transparent}
`

@en "gen_table"
@fa "ساخت جدول"
pub func gen_table(n: Node): Output:
    mut o := Output {}
    o.html = "<div data-slot=\"table-container\"><table" + n.attrs +
        ClassAttr(n, "") + ">" + Escape(n.content) + n.inner + "</table></div>"
    if DsOn():
        o.shared_css = DS_TABLE_CSS
    end
    ret o
end

@en "gen_typography"
@fa "ساخت نگارش"
pub func gen_typography(n: Node): Output:
    ret ds_part_output(n, "typography", DS_TYPOGRAPHY_CSS)
end

@en "gen_scroll_area"
@fa "ساخت ناحیه پیمایش"
pub func gen_scroll_area(n: Node): Output:
    mut o := Output {}
    o.html = "<div data-slot=\"scroll-area\"" + n.attrs + ClassAttr(n, "") + ">" +
        Escape(n.content) + n.inner + "</div>"
    o.shared_css = DS_SCROLL_MIN_CSS
    if DsOn():
        o.shared_css += DS_SCROLL_CSS
    end
    ret o
end
