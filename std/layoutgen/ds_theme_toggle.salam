package layoutgen

pub const DS_THEME_TOGGLE_JS := `(function(){
  var KEY = "salam-theme";
  function apply(v) { document.body.setAttribute("data-theme", v); document.documentElement.setAttribute("data-theme", v); }
  try { var saved = localStorage.getItem(KEY); if (saved === "light" || saved === "dark") { apply(saved); } } catch (e) {}
  document.addEventListener("click", function (e) {
    var t = e.target.closest && e.target.closest('[data-slot="theme-toggle"]');
    if (!t) { return; }
    var cur = document.body.getAttribute("data-theme") || document.documentElement.getAttribute("data-theme");
    if (cur !== "light" && cur !== "dark") {
      cur = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    var next = cur === "dark" ? "light" : "dark";
    apply(next);
    try { localStorage.setItem(KEY, next); } catch (e2) {}
    t.setAttribute("aria-pressed", next === "dark" ? "true" : "false");
  });
})();
`

pub const DS_THEME_BOOT := `<script>try{var t=localStorage.getItem("salam-theme");if(t==="light"||t==="dark"){document.documentElement.setAttribute("data-theme",t)}}catch(e){}</script>`

pub const DS_THEME_TOGGLE_CSS := `:where([data-slot="theme-toggle"]){position:relative;width:36px;padding:0}
:where([data-slot="theme-toggle"] svg){position:absolute;inset:0;margin:auto;width:16px;height:16px;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
:where([data-slot="theme-toggle"] .ds-sun){stroke:light-dark(currentColor,transparent)}
:where([data-slot="theme-toggle"] .ds-moon){stroke:light-dark(transparent,currentColor)}
`

pub const DS_THEME_TOGGLE_ICONS := `<svg class="ds-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg><svg class="ds-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>`

@en "gen_theme_toggle"
@fa "ساخت تغییر پوسته"
pub func gen_theme_toggle(n: Node): Output:
    mut o := Output {}
    mut label := ""
    if n.attrs.Find(" aria-label=") < 0:
        label = " aria-label=\"Toggle theme\""
    end
    o.html = "<button type=\"button\" data-slot=\"theme-toggle\"" + label + n.attrs +
        ClassAttr(n, "") + ">" + DS_THEME_TOGGLE_ICONS + "</button>"
    o.head = DS_THEME_BOOT
    o.shared_js = DS_THEME_TOGGLE_JS
    if DsOn():
        o.shared_css = DS_BUTTON_CSS + DS_THEME_TOGGLE_CSS
    end
    ret o
end
