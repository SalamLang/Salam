package layoutgen

pub const DS_TOAST_MIN_CSS := `
:where([data-slot="toaster"]){position:fixed;z-index:100;display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none;width:356px;max-width:calc(100vw - 32px);pointer-events:none}
:where([data-slot="toaster"][data-placement="top-left"]){top:16px;inset-inline-start:16px}
:where([data-slot="toaster"][data-placement="top-center"]){top:16px;inset-inline-start:50%;transform:translateX(-50%)}
:where([data-slot="toaster"][data-placement="top-right"]){top:16px;inset-inline-end:16px}
:where([data-slot="toaster"][data-placement="bottom-left"]){bottom:16px;inset-inline-start:16px;flex-direction:column-reverse}
:where([data-slot="toaster"][data-placement="bottom-center"]){bottom:16px;inset-inline-start:50%;transform:translateX(-50%);flex-direction:column-reverse}
:where([data-slot="toaster"][data-placement="bottom-right"]){bottom:16px;inset-inline-end:16px;flex-direction:column-reverse}
:where([data-slot="toast"]){pointer-events:auto;opacity:0;transform:translateY(8px);transition:opacity .2s ease,transform .2s ease;touch-action:pan-y}
:where([data-slot="toaster"][data-placement^="top"] [data-slot="toast"]){transform:translateY(-8px)}
:where([data-slot="toast"][data-state="open"]){opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){:where([data-slot="toast"]){transition:none}}
`

pub const DS_TOAST_CSS := `
:where([data-slot="toast"]){position:relative;display:flex;flex-direction:row;align-items:flex-start;gap:12px;padding:16px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--popover);color:var(--popover-foreground);box-shadow:var(--ds-shadow-lg);font-size:13px;line-height:20px}
:where([data-slot="toast-icon"]){display:flex;flex-shrink:0;margin-top:2px;width:16px;height:16px}
:where([data-slot="toast-icon"] svg){width:16px;height:16px}
:where([data-slot="toast"][data-variant="success"] [data-slot="toast-icon"]){color:oklch(0.627 0.194 149)}
:where([data-slot="toast"][data-variant="error"] [data-slot="toast-icon"]){color:var(--destructive)}
:where([data-slot="toast"][data-variant="warning"] [data-slot="toast-icon"]){color:oklch(0.769 0.188 70)}
:where([data-slot="toast"][data-variant="info"] [data-slot="toast-icon"]){color:oklch(0.623 0.214 259)}
:where([data-slot="toast-body"]){display:flex;flex:1;flex-direction:column;gap:2px;min-width:0}
:where([data-slot="toast-title"]){font-weight:500}
:where([data-slot="toast-description"]){color:var(--muted-foreground)}
button:where([data-slot="toast-action"]){all:unset;box-sizing:border-box;flex-shrink:0;align-self:center;height:24px;padding:0 8px;border-radius:var(--radius-md);background:var(--primary);color:var(--primary-foreground);font-size:12px;line-height:24px;font-weight:500;cursor:pointer}
button:where([data-slot="toast-action"]:focus-visible){box-shadow:0 0 0 3px var(--ds-ring-soft)}
button:where([data-slot="toast-close"]){all:unset;box-sizing:border-box;position:absolute;top:-6px;inset-inline-start:-6px;display:flex;align-items:center;justify-content:center;width:20px;height:20px;border:1px solid var(--border);border-radius:9999px;background:var(--popover);color:var(--popover-foreground);cursor:pointer;opacity:0;transition:opacity .15s}
:where([data-slot="toast"]:hover) button:where([data-slot="toast-close"]),button:where([data-slot="toast-close"]:focus-visible){opacity:1}
button:where([data-slot="toast-close"] svg){width:12px;height:12px}
`

pub const DS_TOAST_JS := `
(function(){
if(window.salamToast)return;
var seq=0;
var ICON={
success:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>',
error:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>',
warning:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>',
info:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>'};
var XI='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';
function reduced(){return window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches}
function host(){
var h=document.querySelector('[data-slot="toaster"]');
if(h)return h;
h=document.createElement('ol');
h.setAttribute('data-slot','toaster');
h.setAttribute('data-placement','bottom-right');
h.setAttribute('role','region');
h.setAttribute('aria-label','Notifications');
h.setAttribute('aria-live','polite');
document.body.appendChild(h);
return h
}
function el(tag,slot,text){var e=document.createElement(tag);e.setAttribute('data-slot',slot);if(text!=null)e.textContent=text;return e}
function dismiss(id){
var h=document.querySelector('[data-slot="toaster"]');
if(!h)return;
var l=h.querySelectorAll('[data-slot="toast"]');
for(var i=0;i<l.length;i++)if(id==null||l[i].getAttribute('data-id')===String(id))kill(l[i])
}
function kill(t){
if(t.__gone)return;
t.__gone=true;
clearTimeout(t.__timer);
t.setAttribute('data-state','closed');
var rm=function(){if(t.parentNode)t.parentNode.removeChild(t)};
if(reduced())rm();else setTimeout(rm,220)
}
function arm(t){
if(!t.__ms||t.__ms<=0)return;
t.__start=Date.now();
clearTimeout(t.__timer);
t.__timer=setTimeout(function(){kill(t)},t.__left)
}
function pause(t){
if(!t.__timer||t.__paused)return;
t.__paused=true;
clearTimeout(t.__timer);
t.__left-=Date.now()-t.__start
}
function resume(t){
if(!t.__paused)return;
t.__paused=false;
arm(t)
}
function show(title,o){
o=o||{};
var h=host(),v=o.variant||'default';
var lim=parseInt(h.getAttribute('data-limit')||'3',10);
var live=h.querySelectorAll('[data-slot="toast"]:not([data-state="closed"])');
for(var i=0;i<live.length-lim+1;i++)kill(live[i]);
var t=el('li','toast');
var id=o.id!=null?String(o.id):String(++seq);
var old=h.querySelector('[data-slot="toast"][data-id="'+id+'"]');
if(old&&old.parentNode)old.parentNode.removeChild(old);
t.setAttribute('data-id',id);
t.setAttribute('data-variant',v);
t.setAttribute('data-state','closed');
t.setAttribute('role',v==='error'?'alert':'status');
if(ICON[v]){var ic=el('span','toast-icon');ic.innerHTML=ICON[v];t.appendChild(ic)}
var b=el('div','toast-body');
b.appendChild(el('div','toast-title',title==null?'':String(title)));
if(o.description)b.appendChild(el('div','toast-description',String(o.description)));
t.appendChild(b);
if(o.action&&o.action.label){
var a=el('button','toast-action',o.action.label);a.type='button';
a.addEventListener('click',function(){if(o.action.onClick)o.action.onClick();kill(t)});
t.appendChild(a)
}
if(o.closeButton!==false&&(o.closeButton||h.hasAttribute('data-closable'))){
var c=el('button','toast-close');c.type='button';c.setAttribute('aria-label','Close');c.innerHTML=XI;
c.addEventListener('click',function(){kill(t)});
t.appendChild(c)
}
var ms=o.duration!=null?o.duration:parseInt(h.getAttribute('data-duration')||'4000',10);
t.__ms=ms;t.__left=ms;
t.addEventListener('pointerenter',function(){pause(t)});
t.addEventListener('pointerleave',function(){resume(t)});
t.addEventListener('focusin',function(){pause(t)});
t.addEventListener('focusout',function(){resume(t)});
var sx=null,dx=0;
t.addEventListener('pointerdown',function(e){if(e.target.closest('button'))return;sx=e.clientX;dx=0;try{t.setPointerCapture(e.pointerId)}catch(x){}});
t.addEventListener('pointermove',function(e){if(sx===null)return;dx=e.clientX-sx;t.style.transition='none';t.style.transform='translateX('+dx+'px)';t.style.opacity=String(Math.max(0,1-Math.abs(dx)/200))});
var up=function(){
if(sx===null)return;
sx=null;t.style.transition='';
if(Math.abs(dx)>60){t.style.transform='translateX('+(dx>0?'120%':'-120%')+')';t.style.opacity='0';kill(t)}
else{t.style.transform='';t.style.opacity=''}
};
t.addEventListener('pointerup',up);
t.addEventListener('pointercancel',up);
h.appendChild(t);
void t.offsetWidth;
t.setAttribute('data-state','open');
arm(t);
return id
}
function toast(title,o){return show(title,o)}
var kinds=['success','error','warning','info'];
for(var k=0;k<kinds.length;k++)(function(kind){toast[kind]=function(title,o){o=o||{};o.variant=kind;return show(title,o)}})(kinds[k]);
toast.dismiss=dismiss;
window.salamToast=toast;
document.addEventListener('click',function(e){
var b=e.target.closest&&e.target.closest('[data-toast]');
if(!b)return;
var v=b.getAttribute('data-toast-variant');
show(b.getAttribute('data-toast'),{description:b.getAttribute('data-toast-description')||'',variant:v||'default'})
})
})();
`

@en "gen_toaster"
@fa "ساخت اعلان ها"
pub func gen_toaster(n: Node): Output:
    mut o := Output {}
    mut extra := " role=\"region\" aria-label=\"Notifications\" aria-live=\"polite\""
    if DsAttr(n.attrs, "data-placement") == "":
        extra += " data-placement=\"bottom-right\""
    end
    o.html = DsOpen(n, "ol", "toaster", extra) + n.inner + "</ol>"
    o.shared_js = DS_TOAST_JS
    if DsOn():
        o.shared_css = DS_TOAST_MIN_CSS + DS_TOAST_CSS
    else:
        o.shared_css = DS_TOAST_MIN_CSS
    end
    ret o
end
