package layoutgen

JALALI_JS := `function salamJalaliDate(el) {
  var fa = "۰۱۲۳۴۵۶۷۸۹", ar = "٠١٢٣٤٥٦٧٨٩";
  function latin(s) {
    var o = "";
    for (var i = 0; i < s.length; i++) {
      var c = s.charAt(i), k = fa.indexOf(c);
      if (k < 0) k = ar.indexOf(c);
      o += k >= 0 ? String(k) : c;
    }
    return o;
  }
  function persian(s) { return s.replace(/[0-9]/g, function (d) { return fa.charAt(+d); }); }
  function clean(s) {
    s = latin(s).replace(/[-.\s]/g, "/").replace(/[^0-9\/]/g, "").replace(/\/+/g, "/");
    if (s.indexOf("/") < 0) {
      var p = [s.slice(0, 4), s.slice(4, 6), s.slice(6, 8)];
      s = p.filter(function (x) { return x.length > 0; }).join("/");
    }
    return s.slice(0, 10);
  }
  function leap(y) { return [1, 5, 9, 13, 17, 22, 26, 30].indexOf(((y % 33) + 33) % 33) >= 0; }
  function valid(s) {
    var m = /^(\d{4})\/(\d{1,2})\/(\d{1,2})$/.exec(s);
    if (!m) return false;
    var y = +m[1], mo = +m[2], d = +m[3];
    if (mo < 1 || mo > 12 || d < 1) return false;
    var max = mo <= 6 ? 31 : (mo <= 11 ? 30 : (leap(y) ? 30 : 29));
    return d <= max;
  }
  function sync() {
    var v = clean(el.value);
    el.value = persian(v);
    el.dataset.value = v;
    el.setCustomValidity(v === "" || valid(v) ? "" : (el.dataset.message || "تاریخ شمسی نامعتبر است"));
  }
  el.addEventListener("input", sync);
  el.addEventListener("change", function () { sync(); el.reportValidity(); });
  el.addEventListener("paste", function (e) {
    var t = (e.clipboardData || window.clipboardData).getData("text");
    e.preventDefault();
    el.value = t;
    sync();
  });
  el.addEventListener("copy", function (e) {
    if (!e.clipboardData) return;
    e.clipboardData.setData("text/plain", el.dataset.value || "");
    e.preventDefault();
  });
  sync();
}
`

@en "jalali_date"
@fa "تاریخ_شمسی"
pub func jalali_date(n: Node): Output:
    mut o := Output {}
    o.html = "<input type=\"text\" inputmode=\"numeric\" autocomplete=\"off\" dir=\"ltr\" maxlength=\"10\"" + n.attrs + ClassAttr(n, n.uid) + ">"
    if not n.compact:
        o.html += "\n"
    end
    o.css = "." + n.uid + ":invalid { outline: 2px solid #d33; }"
    o.shared_js = JALALI_JS
    o.js = "const " + n.uid + " = document.querySelector(\"." + n.uid + "\");\nsalamJalaliDate(" + n.uid + ");"
    ret o
end
