@en "layoutgen"
@fa "سازنده‌ها"
package layoutgen

import str

@en "Node"
@fa "گره"
pub struct Node:
    pub name: str = ""
    pub tag: str = ""
    pub uid: str = ""
    pub class_name: str = ""
    pub attrs: str = ""
    pub content: str = ""
    pub inner: str = ""
    pub parents: str = ""
    pub compact: bool = false
    pub keys: Vector<str> = Vector {}
    pub vals: Vector<str> = Vector {}
end

@en "Output"
@fa "خروجی"
pub struct Output:
    pub html: str = ""
    pub css: str = ""
    pub js: str = ""
    pub head: str = ""
    pub shared_css: str = ""
    pub shared_js: str = ""
end

@en "Set"
@fa "بگذار"
pub func Set(n &: Node, key: str, value: str):
    n.keys.Push(key)
    n.vals.Push(value)
end

@en "Get"
@fa "بگیر"
pub func Get(n: Node, key: str): str:
    repeat n.keys.Len() in i:
        if n.keys.Get(i) == key:
            ret n.vals.Get(i)
        end
    end
    ret ""
end

@en "Has"
@fa "دارد"
pub func Has(n: Node, key: str): bool:
    repeat n.keys.Len() in i:
        if n.keys.Get(i) == key:
            ret true
        end
    end
    ret false
end

@en "Parent"
@fa "والد"
pub func Parent(n: Node): str:
    comma := n.parents.Find(",")
    if comma < 0:
        ret n.parents
    end
    ret n.parents.Substr(0, comma)
end

@en "Escape"
@fa "گریز"
pub func Escape(s: str): str:
    ret str.Replace(str.Replace(str.Replace(str.Replace(str.Replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;"), "'", "&#39;")
end

@en "ClassAttr"
@fa "ویژگی کلاس"
pub func ClassAttr(n: Node, extra: str): str:
    mut cls := extra
    if n.class_name.Len() > 0:
        cls = cls.Len() > 0 ? cls + " " + n.class_name : n.class_name
    end
    if cls.Len() == 0:
        ret ""
    end
    ret " class=\"" + cls + "\""
end

@en "Emit"
@fa "بنویس"
pub func Emit(o: Output):
    print o.html + "\x1f" + o.css + "\x1f" + o.js + "\x1f" + o.head + "\x1f" + o.shared_css + "\x1f" + o.shared_js + "\x1e"
end
