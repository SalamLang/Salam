package llvm


extern:
    func LLVMModuleCreateWithNameInContext(id: str, ctx: void*): void*
    func LLVMPrintModuleToString(mod: void*): void*

    func LLVMInt1TypeInContext(ctx: void*): void*
    func LLVMInt8TypeInContext(ctx: void*): void*
    func LLVMInt16TypeInContext(ctx: void*): void*
    func LLVMInt32TypeInContext(ctx: void*): void*
    func LLVMInt64TypeInContext(ctx: void*): void*
    func LLVMVoidTypeInContext(ctx: void*): void*
    func LLVMFloatTypeInContext(ctx: void*): void*
    func LLVMDoubleTypeInContext(ctx: void*): void*
    func LLVMPointerTypeInContext(ctx: void*, space: int): void*
    func LLVMArrayType2(elem: void*, n: u64): void*
    func LLVMFunctionType(ret_ty: void*, params: void*, n: int, vararg: int): void*

    func LLVMAddFunction(mod: void*, name: str, fnty: void*): void*
    func LLVMGetNamedFunction(mod: void*, name: str): void*
    func LLVMGetParam(fn: void*, idx: int): void*
    func LLVMSetLinkage(v: void*, linkage: int)
    func LLVMSetValueName2(v: void*, name: str, n: u64)

    func LLVMAppendBasicBlockInContext(ctx: void*, fn: void*, name: str): void*
    func LLVMGetInsertBlock(b: void*): void*

    func LLVMCreateBuilderInContext(ctx: void*): void*
    func LLVMPositionBuilderAtEnd(b: void*, bb: void*)
    func LLVMDisposeBuilder(b: void*)

    func LLVMBuildRet(b: void*, v: void*): void*
    func LLVMBuildRetVoid(b: void*): void*
    func LLVMBuildAdd(b: void*, l: void*, r: void*, name: str): void*
    func LLVMBuildSub(b: void*, l: void*, r: void*, name: str): void*
    func LLVMBuildMul(b: void*, l: void*, r: void*, name: str): void*
    func LLVMBuildSDiv(b: void*, l: void*, r: void*, name: str): void*
    func LLVMBuildSRem(b: void*, l: void*, r: void*, name: str): void*
    func LLVMBuildICmp(b: void*, pred: int, l: void*, r: void*, name: str): void*
    func LLVMBuildBr(b: void*, dest: void*): void*
    func LLVMBuildCondBr(b: void*, cond: void*, t: void*, f: void*): void*
    func LLVMBuildPhi(b: void*, ty: void*, name: str): void*
    func LLVMAddIncoming(phi: void*, vals: void*, blocks: void*, n: int)
    func LLVMBuildCall2(b: void*, fnty: void*, fn: void*, args: void*, n: int, name: str): void*
    func LLVMBuildAlloca(b: void*, ty: void*, name: str): void*
    func LLVMBuildLoad2(b: void*, ty: void*, ptr: void*, name: str): void*
    func LLVMBuildStore(b: void*, val: void*, ptr: void*): void*
    func LLVMBuildGlobalStringPtr(b: void*, s: str, name: str): void*

    func LLVMConstInt(ty: void*, v: u64, signext: int): void*
    func LLVMConstReal(ty: void*, v: f64): void*
    func LLVMAddGlobal(mod: void*, ty: void*, name: str): void*
    func LLVMSetInitializer(g: void*, v: void*)
    func LLVMSetGlobalConstant(g: void*, flag: int)
end

pub const INT_EQ := 32
pub const INT_NE := 33
pub const INT_UGT := 34
pub const INT_UGE := 35
pub const INT_ULT := 36
pub const INT_ULE := 37
pub const INT_SGT := 38
pub const INT_SGE := 39
pub const INT_SLT := 40
pub const INT_SLE := 41

pub const LINKAGE_EXTERNAL := 0
pub const LINKAGE_INTERNAL := 8
pub const LINKAGE_PRIVATE := 9

@en "Type"
@fa "نوع"
@ar "نوع"
pub struct Type:
    pub handle: void* = null
end

@en "Value"
@fa "مقدار"
@ar "قیمة"
pub struct Value:
    pub handle: void* = null
end

@en "BasicBlock"
@fa "بلوک پایه"
@ar "کتلة أساسیة"
pub struct BasicBlock:
    pub handle: void* = null
end

@en "Builder"
@fa "سازنده"
@ar "بانی"
pub struct Builder:
    pub handle: void* = null
end

func _pack_types(v: Vector<Type>): void*:
    n := v.len()
    if n == 0:
        ret null
    end
    buf := mem.Allocate((n as u64) * 8)
    mut i := 0
    while i < n:
        slot := ((buf as u64) + (i as u64) * 8) as u64*
        slot[0] = v.get(i).handle as u64
        i += 1
    end
    ret buf
end

func _pack_values(v: Vector<Value>): void*:
    n := v.len()
    if n == 0:
        ret null
    end
    buf := mem.Allocate((n as u64) * 8)
    mut i := 0
    while i < n:
        slot := ((buf as u64) + (i as u64) * 8) as u64*
        slot[0] = v.get(i).handle as u64
        i += 1
    end
    ret buf
end

func _pack_blocks(v: Vector<BasicBlock>): void*:
    n := v.len()
    if n == 0:
        ret null
    end
    buf := mem.Allocate((n as u64) * 8)
    mut i := 0
    while i < n:
        slot := ((buf as u64) + (i as u64) * 8) as u64*
        slot[0] = v.get(i).handle as u64
        i += 1
    end
    ret buf
end

@en "NewModule"
@fa "ماژول جدید"
@ar "وحدة جدیدة"
pub func NewModule(ctx: Context, name: str): Module:
    ret Module { handle = LLVMModuleCreateWithNameInContext(name, ctx.handle) }
end

@en "ModuleToString"
@fa "ماژول به رشته"
@ar "الوحدة إلی نص"
pub func ModuleToString(mod: Module): str:
    p := LLVMPrintModuleToString(mod.handle)
    if p == null:
        ret ""
    end
    out := str.Clone(p as str)
    LLVMDisposeMessage(p)
    ret out
end

@en "Int1Type"
@fa "نوع یک بیتی"
@ar "نوع بت واحد"
pub func Int1Type(c: Context): Type: ret Type { handle = LLVMInt1TypeInContext(c.handle) } end

