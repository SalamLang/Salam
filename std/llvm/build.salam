end

@en "SetInitializer"
@fa "تنظیم مقدار اولیه"
@ar "تعیین القیمة الأولیة"
pub func SetInitializer(g: Value, v: Value): LLVMSetInitializer(g.handle, v.handle) end

@en "SetGlobalConstant"
@fa "تنظیم ثابت سراسری"
@ar "تعیین ثابت عام"
pub func SetGlobalConstant(g: Value, flag: bool): LLVMSetGlobalConstant(g.handle, flag ? 1 : 0) end
