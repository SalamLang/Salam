@en "Phi"
@fa "فای"
@ar "فاي"
pub func Phi(b: Builder, ty: Type, name: str): Value:
    ret Value { handle = LLVMBuildPhi(b.handle, ty.handle, name) }
end

@en "AddIncoming"
@fa "افزودن ورودی فای"
@ar "إضافة وارد"
pub func AddIncoming(phi: Value, vals: Vector<Value>, blocks: Vector<BasicBlock>):
    n := vals.len()
    if n == 0 || blocks.len() != n:
        ret
    end
    pv := _pack_values(vals)
    pb := _pack_blocks(blocks)
    LLVMAddIncoming(phi.handle, pv, pb, n)
    mem.Free(pv)
    mem.Free(pb)
end

@en "Call"
@fa "فراخوانی"
@ar "استدعاء"
pub func Call(b: Builder, fnty: Type, fn: Value, args: Vector<Value>, name: str): Value:
    p := _pack_values(args)
    v := LLVMBuildCall2(b.handle, fnty.handle, fn.handle, p, args.len(), name)
    if p != null: mem.Free(p) end
    ret Value { handle = v }
end

