@fa "پرش شرطی"
@ar "قفز شرطي"
pub func CondBr(b: Builder, cond: Value, t: BasicBlock, f: BasicBlock): Value:
    ret Value { handle = LLVMBuildCondBr(b.handle, cond.handle, t.handle, f.handle) }
