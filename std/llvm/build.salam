@fa "نوع سی و دو بیتی"
@ar "نوع اثنتان وثلاثون بتة"
pub func Int32Type(c: Context): Type: ret Type { handle = LLVMInt32TypeInContext(c.handle) } end

@en "Int64Type"
@fa "نوع شصت و چهار بیتی"
@ar "نوع أربع وستون بتة"
pub func Int64Type(c: Context): Type: ret Type { handle = LLVMInt64TypeInContext(c.handle) } end

@en "VoidType"
@fa "نوع تهی"
@ar "نوع فارغ"
pub func VoidType(c: Context): Type: ret Type { handle = LLVMVoidTypeInContext(c.handle) } end

@en "FloatType"
@fa "نوع اعشاری"
@ar "نوع عشري"
pub func FloatType(c: Context): Type: ret Type { handle = LLVMFloatTypeInContext(c.handle) } end

@en "DoubleType"
@fa "نوع اعشاری دقیق"
@ar "نوع عشري مضاعف"
pub func DoubleType(c: Context): Type: ret Type { handle = LLVMDoubleTypeInContext(c.handle) } end

@en "PointerType"
@fa "نوع اشاره گر"
@ar "نوع مؤشر"
pub func PointerType(c: Context): Type: ret Type { handle = LLVMPointerTypeInContext(c.handle, 0) } end

@en "ArrayType"
@fa "نوع آرایه"
@ar "نوع مصفوفة"
pub func ArrayType(elem: Type, n: i64): Type:
    ret Type { handle = LLVMArrayType2(elem.handle, n as u64) }
end

@en "FunctionType"
@fa "نوع تابع"
@ar "نوع دالة"
pub func FunctionType(ret_ty: Type, params: Vector<Type>, vararg: bool): Type:
    p := _pack_types(params)
    t := LLVMFunctionType(ret_ty.handle, p, params.len(), vararg ? 1 : 0)
    if p != null: mem.Free(p) end
    ret Type { handle = t }
end

@en "AddFunction"
@fa "افزودن تابع"
@ar "إضافة دالة"
pub func AddFunction(mod: Module, name: str, fnty: Type): Value:
    ret Value { handle = LLVMAddFunction(mod.handle, name, fnty.handle) }
end

@en "NamedFunction"
@fa "تابع نام دار"
@ar "دالة مسماة"
pub func NamedFunction(mod: Module, name: str): Value:
    ret Value { handle = LLVMGetNamedFunction(mod.handle, name) }
end

@en "Param"
@fa "پارامتر"
@ar "معامل"
pub func Param(fn: Value, idx: int): Value:
    ret Value { handle = LLVMGetParam(fn.handle, idx) }
end

@en "SetLinkage"
@fa "تنظیم پیوند"
@ar "تعیین الربط"
pub func SetLinkage(v: Value, linkage: int): LLVMSetLinkage(v.handle, linkage) end

@en "AppendBlock"
@fa "افزودن بلوک"
@ar "إلحاق کتلة"
pub func AppendBlock(c: Context, fn: Value, name: str): BasicBlock:
    ret BasicBlock { handle = LLVMAppendBasicBlockInContext(c.handle, fn.handle, name) }
end

