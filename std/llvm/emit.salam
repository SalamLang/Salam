// Object/asm/bitcode emission - llvm-c/TargetMachine.h, llvm-c/BitWriter.h.
// Covers the ASM/OBJ/BITCODE (and the object half of EXEC) output modes of
// salam_llvm_native()'s output-kind dispatch.
package llvm

import str

extern:
    func LLVMTargetMachineEmitToFile(tm: void*, mod: void*, path: str, file_type: int, out_err &: void*): int
    func LLVMWriteBitcodeToFile(mod: void*, path: str): int
end

@en "EmitResult"
@fa "نتیجه تولید"
@ar "نتیجة الإصدار"
pub struct EmitResult:
    pub ok: bool = false
    pub err: str = ""
end

// EmitAsm - LLVM_OUT_ASM: emit textual assembly for `tm`'s target to `path`.
@en "EmitAsm"
@fa "تولید اسمبلی"
@ar "إصدار التجمیع"
pub func EmitAsm(mod: Module, tm: TargetMachine, path: str): EmitResult:
    ret emit_to_file(mod, tm, path, CODEGEN_FILE_ASSEMBLY)
end

// EmitObject - LLVM_OUT_OBJ (and the first half of LLVM_OUT_EXEC): emit a
// native object file to `path`.
@en "EmitObject"
@fa "تولید شیء"
@ar "إصدار الکائن"
pub func EmitObject(mod: Module, tm: TargetMachine, path: str): EmitResult:
    ret emit_to_file(mod, tm, path, CODEGEN_FILE_OBJECT)
end

func emit_to_file(mod: Module, tm: TargetMachine, path: str, file_type: int): EmitResult:
    mut eerr := null as void*
    if LLVMTargetMachineEmitToFile(tm.handle, mod.handle, path, file_type, eerr) != 0:
        msg := eerr != null ? str.Clone(eerr as str) : "(unknown)"
        if eerr != null: LLVMDisposeMessage(eerr) end
        ret EmitResult { ok = false, err = "LLVM emit failed for '" + path + "': " + msg }
    end
    ret EmitResult { ok = true }
end

// EmitBitcode - LLVM_OUT_BITCODE. LLVMWriteBitcodeToFile returns 0 on
// success, nonzero on failure (no error-message out-param - unlike
// LLVMTargetMachineEmitToFile above).
@en "EmitBitcode"
@fa "تولید بایت‌کد"
@ar "إصدار الشیفرة الثنائیة"
pub func EmitBitcode(mod: Module, path: str): EmitResult:
    if LLVMWriteBitcodeToFile(mod.handle, path) != 0:
        ret EmitResult { ok = false, err = "LLVM bitcode write failed for '" + path + "'" }
    end
    ret EmitResult { ok = true }
end
