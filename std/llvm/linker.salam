// In-process cross-linking - ports native_link_elf/native_link_mingw/
// native_link_lld (llvm_native.c:546-796): builds an `ld.lld`-style argv
// and calls lld.salam's Link. The .incbin-embedded musl/mingw sysroot
// tarballs (SALAM_HAVE_EMBED_MUSL/_MINGW/_EXTRALIBS_*, llvm_native.c:41-
// 99,225-519) are NOT ported - they exist only to support the C build's
// asm-embedding trick, which self-host has no build step for yet (a
// deferred build-pipeline task). Sysroot resolution here still works for
// cross-compiling: explicit `opts.sysroot` -> $SALAM_SYSROOTS env var ->
// the OS-default system-package path (mingw-w64/musl-tools) - the same
// fallback chain the C uses once its embedded-tarball checks come up
// empty.
package llvm

@en "LinkResult"
@fa "نتیجه پیوند"
@ar "نتیجة الربط"
pub struct LinkResult:
    pub ok: bool = false
    pub err: str = ""
end

// ArgvOf - marshals a Vector<str> into a contiguous char*[] (as a `str*`,
// ABI-identical to lld_link.h's `const char *const *argv`) for
// salam_lld_link. Pointer width is assumed to be 8 bytes, same assumption
// std/mem/mem.salam's own HDR_SIZE already makes for this host - not
// portable to a 32-bit self-host build, same known limitation.
func argv_of(items: Vector<str>): void*:
    mut buf := mem.Allocate((items.len() * 8) as u64) as str*
    repeat items.len() with i:
        buf[i] = items.get(i)
    end
    ret buf as void*
end

// elf_arch_of/emul/rtarch - ports native_link_elf's `t` substring sniffing
// (llvm_native.c:558-574).
func elf_arch_of(t: str): str:
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"): ret "aarch64" end
    if str.Contains(t, "i686") || str.Contains(t, "i386") || str.Contains(t, "i586"): ret "i386" end
    if str.Contains(t, "arm"): ret "arm" end
    ret "x86_64"
end

func elf_emul_of(t: str): str:
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"): ret "aarch64linux" end
    if str.Contains(t, "i686") || str.Contains(t, "i386") || str.Contains(t, "i586"): ret "elf_i386" end
    if str.Contains(t, "arm"): ret "armelf_linux_eabi" end
    ret "elf_x86_64"
end

// mingw_arch/mingw_emul - llvm_native.c:329-341.
func mingw_arch(t: str): str:
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"): ret "aarch64" end
    if str.Contains(t, "i686") || str.Contains(t, "i386") || str.Contains(t, "i586"): ret "i686" end
    ret "x86_64"
end

func mingw_emul(t: str): str:
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"): ret "arm64pe" end
    if str.Contains(t, "i686") || str.Contains(t, "i386") || str.Contains(t, "i586"): ret "i386pe" end
    ret "i386pep"
end

// find_compiler_rt - ports find_compiler_rt() (llvm_native.c:376-409):
// scans a handful of clang install prefixes for
// <prefix>/<version>/lib/linux/libclang_rt.builtins-<rtarch>.a. "" = not
// found (mirrors the C's `have_rt = 0` fallthrough).
func find_compiler_rt(rtarch: str): str:
    mut bases := Vector {} as Vector<str>
    defer bases.free()
    bases.push("/usr/lib/llvm-22/lib/clang")
    bases.push("/usr/lib/llvm/lib/clang")
    bases.push("/usr/lib/clang")
    repeat bases.len() with bi:
        base := bases.get(bi)
        if !os.IsDir(base):
            continue
        end
        // Freed explicitly rather than with `defer`, which is how this loop
        // was written when every backend emitted defers at *function* exit
        // and a defer on a loop-local landed in the epilogue where that
        // binding is out of scope. Defers are block-scoped now (SKILL.md
        // always said scope exit), so `defer entries.free()` would work here
        // too; the explicit frees are kept because the `continue` paths below
        // already read cleanly with them.
        entries := os.ListDir(base)
        mut hit := ""
        repeat entries.len() with i:
            name := entries.get(i)
            candidate := filepath.Join(filepath.Join(filepath.Join(base, name), "lib"), "linux")
            path := filepath.Join(candidate, "libclang_rt.builtins-" + rtarch + ".a")
            if os.Exists(path) && str.Len(hit) == 0:
                hit = path
            end
        end
        entries.free()
        if str.Len(hit) > 0:
            ret hit
        end
    end
    ret ""
end

// find_mingw_gccdir - ports find_mingw_gccdir() (llvm_native.c:343-374):
// scans /usr/lib/gcc/<arch>-w64-mingw32/<version>/ for crtbegin.o, exactly
// as the C does (last hit wins unless a "win32" subdir variant is found,
// which wins immediately - same tie-break). "" = not found.
func find_mingw_gccdir(arch: str): str:
    base := "/usr/lib/gcc/" + arch + "-w64-mingw32"
    if !os.IsDir(base):
        ret ""
    end
    entries := os.ListDir(base)
    defer entries.free()
    mut found := ""
    repeat entries.len() with i:
        name := entries.get(i)
        if str.Len(name) > 0 && str.StartsWith(name, "."):
            continue
        end
        dir := filepath.Join(base, name)
        if os.Exists(filepath.Join(dir, "crtbegin.o")):
            found = dir
            if str.Contains(name, "win32"):
                ret found
            end
        end
    end
    ret found
end

// musl_sysroot - resolves the musl sysroot directory for `arch`: explicit
// opts.sysroot -> $SALAM_SYSROOTS/<arch>-linux-musl (only if it actually
// has a crt1.o) -> the plain system-package path. Ports the non-embedded
// tail of native_link_elf's sysroot resolution (llvm_native.c:576-594).
func musl_sysroot(explicit: str, arch: str): str:
    if str.Len(explicit) > 0:
        ret explicit
    end
    env := os.Env("SALAM_SYSROOTS")
    if str.Len(env) > 0:
        candidate := filepath.Join(env, arch + "-linux-musl")
        if os.Exists(filepath.Join(candidate, "crt1.o")):
            ret candidate
        end
    end
    ret "/usr/lib/" + arch + "-linux-musl"
end

// mingw_sysroot - same idea for mingw (llvm_native.c:692-707): explicit
// opts.sysroot -> $SALAM_SYSROOTS/<arch>-w64-mingw32 -> system package path.
func mingw_sysroot(explicit: str, arch: str): str:
    if str.Len(explicit) > 0:
        ret explicit
    end
    env := os.Env("SALAM_SYSROOTS")
    if str.Len(env) > 0:
        candidate := filepath.Join(env, arch + "-w64-mingw32")
        if os.Exists(filepath.Join(candidate, "lib/crt2.o")):
            ret candidate
        end
    end
    ret "/usr/" + arch + "-w64-mingw32"
end

// musl_folds_into_libc - libraries glibc splits out but musl keeps inside
// libc. A `link dynamic "pthread"` (std/thread, std/sync) is right for a
// glibc host and fatal against a musl sysroot, which ships no libpthread at
// all: ld.lld stops at "unable to find library -lpthread" and every program
// importing threads fails to link. The symbols are in -lc, already on the
// line. Mirrors musl_folds_into_libc() in c/src/llvm/llvm_native.c.
func musl_folds_into_libc(flag: str): bool:
    mut names := Vector {} as Vector<str>
    names.push("pthread")
    names.push("dl")
    names.push("rt")
    names.push("util")
    names.push("anl")
    names.push("resolv")
    names.push("crypt")
    names.push("m")
    defer names.free()
    repeat names.len() with i:
        n := names.get(i)
        if str.Equals(flag, "-l" + n) || str.Equals(flag, "-l:lib" + n + ".a"):
            ret true
        end
    end
    ret false
end

// user_libs_of - ports the C's opts->link_libs argv-building loop
// (native_link_elf/native_link_mingw, llvm_native.c), now also honoring
// per-lib `link_kinds` ("static" -> `-l:libX.a`, GNU ld/lld's exact-
// archive-name syntax - see the parity fix in c/src/llvm/llvm_native.c's
// native_link_mingw and c/src/driver/llvm_toolchain.c's emit_llvm_link).
// A raw flag or explicit path (leading "-", or containing "/"/"\"/".")
// passes through unchanged regardless of kind, matching the C.
func user_libs_of(opts: Options): Vector<str>:
    mut out := Vector {} as Vector<str>
    repeat opts.link_libs.len() with i:
        s := opts.link_libs.get(i)
        if str.Len(s) == 0:
            continue
        end
        if str.StartsWith(s, "-") || str.Contains(s, "/") || str.Contains(s, "\\") || str.Contains(s, "."):
            out.push(s)
            continue
        end
        mut kind := ""
        if i < opts.link_kinds.len():
            kind = opts.link_kinds.get(i)
        end
        if str.Equals(kind, "static"):
            out.push("-l:lib" + s + ".a")
        else:
            out.push("-l" + s)
        end
    end
    ret out
end

// resolve_linker - llvm_native.c:247-258. The C looks for a tool bundled
// next to the running salam first; std/llvm has no access to that lookup,
// so this is the platform default it falls back to.
//
// Two top-level condcomp arms rather than one function with an `if
// SALAM_OS_WINDOWS:` inside it: condcomp prunes the dead arm outright, so a
// `mut` only ever assigned in the pruned branch trips E069 ("declared 'mut'
// but never mutated") on the other platform.
if SALAM_OS_WINDOWS:
    func resolve_linker(): str:
        ret "gcc"
    end
else:
    func resolve_linker(): str:
        ret "cc"
    end
end

// CanLinkTriple - ports lld_can_link(): whether LinkAuto has an in-process
// linker for `t` at all (mingw+gnu windows, or musl linux). Anything else
// (e.g. wasm, glibc linux, macOS) falls back to the caller's external
// clang-shellout path.
//
// The LldAvailable() half is the port of lld_can_link's `#ifdef
// SALAM_HAVE_LLD ... #else return 0`, and it is not hypothetical: a build
// can have LLVM in-process and no LLD (macOS, where Homebrew's lld is
// shared-only - see lld.salam). Without it, such a build would hand a musl
// or mingw target to LinkAuto, reach the stubbed salam_lld_link, and report
// a link failure instead of falling back to the external linker.
@en "CanLinkTriple"
@fa "میتوان سه‌تایی را پیوند داد"
@ar "یمکن ربط الثلاثیة"
pub func CanLinkTriple(t: str): bool:
    if str.Len(t) == 0 || !LldAvailable():
        ret false
    end
    win := str.Contains(t, "windows") || str.Contains(t, "mingw") || str.Contains(t, "win32")
    gnu := str.Contains(t, "gnu") || str.Contains(t, "mingw")
    musl := str.Contains(t, "linux") && str.Contains(t, "musl")
    ret (win && gnu) || musl
end

// LinkExternal - ports link_executable() (llvm_native.c:260-317): hands the
// object EmitObject already produced to a system C compiler, which supplies
// the host CRT and libc that LinkElf's static-musl path cannot.
//
// This is the normal outcome of a plain native build, not an error path: on
// a glibc Linux or a macOS host there is no in-process linker at all, and
// the C reaches exactly here via `if (rc < 0) rc = link_executable(...)`.
// Only the object is linked - the IR is never recompiled - so it costs one
// `cc` invocation, not a second full compile.
@en "LinkExternal"
@fa "پیوند بیرونی"
@ar "ربط خارجی"
pub func LinkExternal(obj: str, out_path: str, opts: Options): LinkResult:
    linker := resolve_linker()
    mut cmd := `"` + linker + `" "` + obj + `" -o "` + out_path + `"`
    repeat opts.lib_paths.len() with i:
        cmd += ` -L"` + opts.lib_paths.get(i) + `"`
    end
    repeat opts.link_libs.len() with i:
        spec := opts.link_libs.get(i)
        if str.Len(spec) == 0:
            continue
        end
        // A raw flag or an explicit path passes through unchanged; a bare
        // name becomes -lname. Matches the C's strpbrk(spec, "/\\.") test.
        if str.StartsWith(spec, "-") || str.Contains(spec, "/") || str.Contains(spec, "\\") || str.Contains(spec, "."):
            cmd += ` "` + spec + `"`
        else:
            cmd += " -l" + spec
        end
    end
    // The C's is_tcc branch picks -lmsvcrt over -lm, but it can only reach
    // tcc through the bundled-tool lookup this port does not have, so the
    // linker here is never tcc and -lm is always the right choice.
    cmd += " -lm"
    if os.Run(cmd) == 0:
        ret LinkResult { ok = true }
    end
    ret LinkResult { ok = false, err = "external link failed: " + cmd }
end

// HostLinkTriple - ports native_host_link_triple() (llvm_native.c:878-901):
// the triple to hand LinkAuto when the caller asked for a plain native
// build and named no --target=. Empty means "there is no in-process linker
// for this host" - the caller then links externally, exactly like the C's
// `if (rc < 0) rc = link_executable(...)`.
//
// Windows: the host triple itself, unless it is an MSVC one (LinkMingw
// only knows the mingw CRT layout).
//
// Linux: the host's glibc CRT cannot be linked by LinkElf, which is a
// static-musl linker - so this reports a musl triple only when a musl
// sysroot has actually been provided, which is the direct analogue of the
// C's salam_try_embed_musl() gate. `explicit`/$SALAM_SYSROOTS only, never
// a distro's /usr/lib/<arch>-linux-musl: the C links the *embedded*
// sysroot it ships, and silently switching every native build on a
// musl-dev machine to a static musl binary would diverge from it.
@en "HostLinkTriple"
@fa "سه‌تایی پیوند میزبان"
@ar "ثلاثیة ربط المضیف"
pub func HostLinkTriple(): str:
    host := DefaultTriple()
    if str.Len(host) == 0:
        ret ""
    end
    if str.Contains(host, "windows") || str.Contains(host, "mingw") || str.Contains(host, "win32"):
        if str.Contains(host, "msvc"):
            ret ""
        end
        ret host
    end
    if !str.Contains(host, "linux"):
        ret ""
    end
    mut arch := "x86_64"
    if str.Contains(host, "aarch64") || str.Contains(host, "arm64"):
        arch = "aarch64"
    else str.Contains(host, "i686") || str.Contains(host, "i386") || str.Contains(host, "i586"):
        arch = "i386"
    else str.Contains(host, "arm"):
        arch = "arm"
    end
    env := os.Env("SALAM_SYSROOTS")
    if str.Len(env) == 0:
        ret ""
    end
    if !os.Exists(filepath.Join(filepath.Join(env, arch + "-linux-musl"), "crt1.o")):
        ret ""
    end
    ret (str.Equals(arch, "i386") ? "i686" : arch) + "-linux-musl"
end

// LinkElf - ports native_link_elf(): static-links a musl-libc ELF
// executable in-process via LLD. `obj` is a native object file already
// emitted (emit.salam's EmitObject); `opts.target_triple` selects the
// arch, `opts.sysroot`/$SALAM_SYSROOTS/system-package resolves the musl
// sysroot, `opts.debug_info` controls symbol stripping.
@en "LinkElf"
@fa "پیوند ای ال اف"
@ar "ربط إی إل إف"
pub func LinkElf(obj: str, out_path: str, opts: Options): LinkResult:
    t := opts.target_triple
    arch := elf_arch_of(t)
    emul := elf_emul_of(t)
    sr := musl_sysroot(opts.sysroot, arch)

    crt1 := filepath.Join(sr, "crt1.o")
    if !os.Exists(crt1):
        ret LinkResult {
            ok = false,
            err = "no musl sysroot for '" + t + "' (looked in " + sr + "): install musl-dev or bundle a sysroot ($SALAM_SYSROOTS)"
        }
    end
    crti := filepath.Join(sr, "crti.o")
    crtn := filepath.Join(sr, "crtn.o")

    mut rt := filepath.Join(sr, "libclang_rt.builtins-" + arch + ".a")
    if !os.Exists(rt):
        rt = find_compiler_rt(arch)
    end
    have_gcc := os.Exists(filepath.Join(sr, "libgcc.a"))

    mut argv := Vector {} as Vector<str>
    defer argv.free()
    argv.push("ld.lld")
    argv.push("-m")
    argv.push(emul)
    argv.push("-static")
    if !opts.debug_info:
        argv.push("-s")
    end
    argv.push("-o")
    argv.push(out_path)
    argv.push(crt1)
    argv.push(crti)
    argv.push("-L" + sr)
    // --libpath entries after the sysroot but before the object: an
    // explicitly named directory should still be searched, and archive
    // order only matters relative to the object and -l flags.
    repeat opts.lib_paths.len() with lpi:
        argv.push("-L" + opts.lib_paths.get(lpi))
    end
    argv.push(obj)
    libs := user_libs_of(opts)
    defer libs.free()
    repeat libs.len() with i:
        l := libs.get(i)
        if musl_folds_into_libc(l):
            continue
        end
        argv.push(l)
    end
    argv.push("--start-group")
    argv.push("-lc")
    if str.Len(rt) > 0:
        argv.push(rt)
    end
    if have_gcc:
        argv.push("-lgcc")
    end
    argv.push("--end-group")
    argv.push(crtn)

    if Link(LLD_ELF, argv_of(argv), argv.len()):
        ret LinkResult { ok = true }
    end
    ret LinkResult { ok = false, err = "in-process lld link failed" }
end

// LinkMingw - ports native_link_mingw(): dynamically-linked (against the
// mingw-w64 CRT DLLs) PE executable, in-process via LLD.
@en "LinkMingw"
@fa "پیوند مینگو"
@ar "ربط مینغو"
pub func LinkMingw(obj: str, out_path: str, opts: Options): LinkResult:
    t := opts.target_triple
    if !CanLinkTriple(t):
        ret LinkResult { ok = false, err = "'" + t + "' is not a mingw target" }
    end
    arch := mingw_arch(t)
    emul := mingw_emul(t)
    sr := mingw_sysroot(opts.sysroot, arch)

    crt2 := filepath.Join(sr, "lib/crt2.o")
    if !os.Exists(crt2):
        ret LinkResult {
            ok = false,
            err = "no mingw sysroot for '" + t + "' (looked in " + sr + "): install mingw-w64 or bundle a sysroot ($SALAM_SYSROOTS)"
        }
    end

    mut gccdir := filepath.Join(sr, "lib")
    mut have_gcc := os.Exists(filepath.Join(gccdir, "libgcc.a"))
    if !have_gcc:
        found := find_mingw_gccdir(arch)
        if str.Len(found) > 0:
            gccdir = found
            have_gcc = true
        end
    end

    mut argv := Vector {} as Vector<str>
    defer argv.free()
    argv.push("ld.lld")
    argv.push("-m")
    argv.push(emul)
    argv.push("-Bdynamic")
    if !opts.debug_info:
        argv.push("-s")
    end
    argv.push("-o")
    argv.push(out_path)
    argv.push(crt2)
    if have_gcc:
        argv.push(filepath.Join(gccdir, "crtbegin.o"))
        argv.push("-L" + gccdir)
    end
    argv.push("-L" + filepath.Join(sr, "lib"))
    argv.push("-L" + filepath.Join(sr, "mingw/lib"))
    repeat opts.lib_paths.len() with lpi:
        argv.push("-L" + opts.lib_paths.get(lpi))
    end
    argv.push(obj)
    libs := user_libs_of(opts)
    defer libs.free()
    repeat libs.len() with i:
        argv.push(libs.get(i))
    end
    argv.push("--start-group")
    argv.push("-lmingw32")
    argv.push("-lgcc")
    argv.push("-lgcc_eh")
    argv.push("-lmoldname")
    argv.push("-lmingwex")
    argv.push("-lmsvcrt")
    argv.push("-ladvapi32")
    argv.push("-lshell32")
    argv.push("-luser32")
    argv.push("-lkernel32")
    argv.push("--end-group")
    if have_gcc:
        argv.push(filepath.Join(gccdir, "crtend.o"))
    end

    if Link(LLD_MINGW, argv_of(argv), argv.len()):
        ret LinkResult { ok = true }
    end
    ret LinkResult { ok = false, err = "in-process lld link failed" }
end

// LinkAuto - ports native_link_lld(): picks LinkMingw or LinkElf by
// `opts.target_triple`, or reports "no in-process linker for this
// triple" (the C's -1 sentinel) so the caller can fall back to an
// external clang-shellout link.
@en "LinkAuto"
@fa "پیوند خودکار"
@ar "ربط تلقائي"
pub func LinkAuto(obj: str, out_path: str, opts: Options): LinkResult:
    t := opts.target_triple
    if str.Len(t) == 0:
        ret LinkResult { ok = false, err = "no target triple set" }
    end
    win := str.Contains(t, "windows") || str.Contains(t, "mingw") || str.Contains(t, "win32")
    gnu := str.Contains(t, "gnu") || str.Contains(t, "mingw")
    if win && gnu:
        ret LinkMingw(obj, out_path, opts)
    end
    if str.Contains(t, "linux") && str.Contains(t, "musl"):
        ret LinkElf(obj, out_path, opts)
    end
    ret LinkResult { ok = false, err = "no in-process linker for triple '" + t + "'" }
end
