package llvm

@en "LinkResult"
@fa "نتیجه پیوند"
pub struct LinkResult:
    pub ok: bool = false
    pub err: str = ""
end

func argv_of(items: Vector<str>): void*:
    mut buf := mem.Allocate((items.len() as u64) * (sizeof(str) as u64)) as str*
    repeat items.len() with i:
        buf[i] = items.get(i)
    end
    ret buf as void*
end

func elf_arch_of(t: str): str:
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"): ret "aarch64" end
    if str.Contains(t, "i686") || str.Contains(t, "i386") || str.Contains(t, "i586"): ret "i386" end
    if str.Contains(t, "arm"): ret "arm" end
    ret "x86_64"
end

func elf_emul_of(t: str): str:
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"): ret "aarch64linux" end
    if str.Contains(t, "i686") || str.Contains(t, "i386") || str.Contains(t, "i586"): ret "elf_i386" end
    if str.Contains(t, "arm"): ret "armelf_linux_eabi" end
    ret "elf_x86_64"
end

func mingw_arch(t: str): str:
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"): ret "aarch64" end
    if str.Contains(t, "i686") || str.Contains(t, "i386") || str.Contains(t, "i586"): ret "i686" end
    ret "x86_64"
end

func mingw_emul(t: str): str:
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"): ret "arm64pe" end
    if str.Contains(t, "i686") || str.Contains(t, "i386") || str.Contains(t, "i586"): ret "i386pe" end
    ret "i386pep"
end

func find_compiler_rt(rtarch: str): str:
    mut bases := Vector {} as Vector<str>
    defer bases.free()
    bases.push("/usr/lib/llvm-22/lib/clang")
    bases.push("/usr/lib/llvm/lib/clang")
    bases.push("/usr/lib/clang")
    repeat bases.len() with bi:
        base := bases.get(bi)
        if !os.IsDir(base):
            continue
        end
        entries := os.ListDir(base)
        mut hit := ""
        repeat entries.len() with i:
            name := entries.get(i)
            candidate := filepath.Join(filepath.Join(filepath.Join(base, name), "lib"), "linux")
            path := filepath.Join(candidate, "libclang_rt.builtins-" + rtarch + ".a")
            if os.Exists(path) && str.Len(hit) == 0:
                hit = path
            end
        end
        entries.free()
        if str.Len(hit) > 0:
            ret hit
        end
    end
    ret ""
end

func find_mingw_gccdir(arch: str): str:
    base := "/usr/lib/gcc/" + arch + "-w64-mingw32"
    if !os.IsDir(base):
        ret ""
    end
    entries := os.ListDir(base)
    defer entries.free()
    mut found := ""
    repeat entries.len() with i:
        name := entries.get(i)
        if str.Len(name) > 0 && str.StartsWith(name, "."):
            continue
        end
        dir := filepath.Join(base, name)
        if os.Exists(filepath.Join(dir, "crtbegin.o")):
            found = dir
            if str.Contains(name, "win32"):
                ret found
            end
        end
    end
    ret found
end

func musl_sysroot(explicit: str, arch: str): str:
    if str.Len(explicit) > 0:
        ret explicit
    end
    env := os.Env("SALAM_SYSROOTS")
    if str.Len(env) > 0:
        candidate := filepath.Join(env, arch + "-linux-musl")
        if os.Exists(filepath.Join(candidate, "crt1.o")):
            ret candidate
        end
    end
    ret "/usr/lib/" + arch + "-linux-musl"
end

func mingw_sysroot(explicit: str, arch: str): str:
    if str.Len(explicit) > 0:
        ret explicit
    end
    env := os.Env("SALAM_SYSROOTS")
    if str.Len(env) > 0:
        candidate := filepath.Join(env, arch + "-w64-mingw32")
        if os.Exists(filepath.Join(candidate, "lib/crt2.o")):
            ret candidate
        end
    end
    ret "/usr/" + arch + "-w64-mingw32"
end

func musl_folds_into_libc(flag: str): bool:
    mut names := Vector {} as Vector<str>
    names.push("pthread")
    names.push("dl")
    names.push("rt")
    names.push("util")
    names.push("anl")
    names.push("resolv")
    names.push("crypt")
    names.push("m")
    defer names.free()
    repeat names.len() with i:
        n := names.get(i)
        if str.Equals(flag, "-l" + n) || str.Equals(flag, "-l:lib" + n + ".a"):
            ret true
        end
    end
    ret false
end

func user_libs_of(opts: Options): Vector<str>:
    mut out := Vector {} as Vector<str>
    repeat opts.link_libs.len() with i:
        s := opts.link_libs.get(i)
        if str.Len(s) == 0:
            continue
        end
        if str.StartsWith(s, "-") || str.Contains(s, "/") || str.Contains(s, "\\") || str.Contains(s, "."):
            out.push(s)
            continue
        end
        mut kind := ""
        if i < opts.link_kinds.len():
            kind = opts.link_kinds.get(i)
        end
        if str.Equals(kind, "static"):
            out.push("-l:lib" + s + ".a")
        else:
            out.push("-l" + s)
        end
    end
    ret out
end

if SALAM_OS_WINDOWS:
    func resolve_linker(): str:
        ret "gcc"
    end
else:
    func resolve_linker(): str:
        ret "cc"
    end
end

func _target_is_darwin(opts: Options): bool:
    t := opts.target_triple
    if str.Len(t) == 0:
        if SALAM_OS_MAC:
            ret true
        else:
            ret false
        end
    end
    ret str.Contains(t, "darwin") || str.Contains(t, "apple") || str.Contains(t, "macos")
end

@en "CanLinkTriple"
@fa "میتوان سه‌تایی را پیوند داد"
pub func CanLinkTriple(t: str): bool:
    if str.Len(t) == 0 || !LldAvailable():
        ret false
    end
    win := str.Contains(t, "windows") || str.Contains(t, "mingw") || str.Contains(t, "win32")
    gnu := str.Contains(t, "gnu") || str.Contains(t, "mingw")
    musl := str.Contains(t, "linux") && str.Contains(t, "musl")
    ret (win && gnu) || musl
end

@en "LinkExternal"
@fa "پیوند بیرونی"
pub func LinkExternal(obj: str, out_path: str, opts: Options): LinkResult:
    linker := resolve_linker()
    mut cmd := `"` + linker + `" "` + obj + `" -o "` + out_path + `"`
    repeat opts.lib_paths.len() with i:
        cmd += ` -L"` + opts.lib_paths.get(i) + `"`
    end
    darwin := _target_is_darwin(opts)
    repeat opts.link_libs.len() with i:
        spec := opts.link_libs.get(i)
        if str.Len(spec) == 0:
            continue
        end
        if str.StartsWith(spec, "-") || str.Contains(spec, "/") || str.Contains(spec, "\\") || str.Contains(spec, "."):
            cmd += ` "` + spec + `"`
            continue
        end
        mut kind := ""
        if i < opts.link_kinds.len():
            kind = opts.link_kinds.get(i)
        end
        if str.Equals(kind, "framework"):
            if darwin:
                cmd += " -framework " + spec
            end
            continue
        end
        if str.Equals(kind, "static") && !darwin:
            cmd += " -Wl,-Bstatic -l" + spec + " -Wl,-Bdynamic"
            continue
        end
        cmd += " -l" + spec
    end
    cmd += " -lm"
    if os.Run(cmd) == 0:
        ret LinkResult { ok = true }
    end
    ret LinkResult { ok = false, err = "external link failed: " + cmd }
end

@en "HostLinkTriple"
@fa "سه‌تایی پیوند میزبان"
pub func HostLinkTriple(): str:
    host := DefaultTriple()
    if str.Len(host) == 0:
        ret ""
    end
    if str.Contains(host, "windows") || str.Contains(host, "mingw") || str.Contains(host, "win32"):
        if str.Contains(host, "msvc"):
            ret ""
        end
        ret host
    end
    if !str.Contains(host, "linux"):
        ret ""
    end
    mut arch := "x86_64"
    if str.Contains(host, "aarch64") || str.Contains(host, "arm64"):
        arch = "aarch64"
    else str.Contains(host, "i686") || str.Contains(host, "i386") || str.Contains(host, "i586"):
        arch = "i386"
    else str.Contains(host, "arm"):
        arch = "arm"
    end
    env := os.Env("SALAM_SYSROOTS")
    if str.Len(env) == 0:
        ret ""
    end
    if !os.Exists(filepath.Join(filepath.Join(env, arch + "-linux-musl"), "crt1.o")):
        ret ""
    end
    ret (str.Equals(arch, "i386") ? "i686" : arch) + "-linux-musl"
end

@en "LinkElf"
@fa "پیوند ای ال اف"
pub func LinkElf(obj: str, out_path: str, opts: Options): LinkResult:
    t := opts.target_triple
    arch := elf_arch_of(t)
    emul := elf_emul_of(t)
    sr := musl_sysroot(opts.sysroot, arch)

    crt1 := filepath.Join(sr, "crt1.o")
    if !os.Exists(crt1):
        ret LinkResult {
            ok = false,
            err = "no musl sysroot for '" + t + "' (looked in " + sr + "): install musl-dev or bundle a sysroot ($SALAM_SYSROOTS)"
        }
    end
    crti := filepath.Join(sr, "crti.o")
    crtn := filepath.Join(sr, "crtn.o")

    mut rt := filepath.Join(sr, "libclang_rt.builtins-" + arch + ".a")
    if !os.Exists(rt):
        rt = find_compiler_rt(arch)
    end
    have_gcc := os.Exists(filepath.Join(sr, "libgcc.a"))

    mut argv := Vector {} as Vector<str>
    defer argv.free()
    argv.push("ld.lld")
    argv.push("-m")
    argv.push(emul)
    argv.push("-static")
    if !opts.debug_info:
        argv.push("-s")
    end
    argv.push("-o")
    argv.push(out_path)
    argv.push(crt1)
    argv.push(crti)
    argv.push("-L" + sr)
    repeat opts.lib_paths.len() with lpi:
        argv.push("-L" + opts.lib_paths.get(lpi))
    end
    argv.push(obj)
    libs := user_libs_of(opts)
    defer libs.free()
    repeat libs.len() with i:
        l := libs.get(i)
        if musl_folds_into_libc(l):
            continue
        end
        argv.push(l)
    end
    argv.push("--start-group")
    argv.push("-lc")
    if str.Len(rt) > 0:
        argv.push(rt)
    end
    if have_gcc:
        argv.push("-lgcc")
    end
    argv.push("--end-group")
    argv.push(crtn)

    if Link(LLD_ELF, argv_of(argv), argv.len()):
        ret LinkResult { ok = true }
    end
    ret LinkResult { ok = false, err = "in-process lld link failed" }
end

@en "LinkMingw"
@fa "پیوند مینگو"
pub func LinkMingw(obj: str, out_path: str, opts: Options): LinkResult:
    t := opts.target_triple
    if !CanLinkTriple(t):
        ret LinkResult { ok = false, err = "'" + t + "' is not a mingw target" }
    end
    arch := mingw_arch(t)
    emul := mingw_emul(t)
    sr := mingw_sysroot(opts.sysroot, arch)

    crt2 := filepath.Join(sr, "lib/crt2.o")
    if !os.Exists(crt2):
        ret LinkResult {
            ok = false,
            err = "no mingw sysroot for '" + t + "' (looked in " + sr + "): install mingw-w64 or bundle a sysroot ($SALAM_SYSROOTS)"
        }
    end

    mut gccdir := filepath.Join(sr, "lib")
    mut have_gcc := os.Exists(filepath.Join(gccdir, "libgcc.a"))
    if !have_gcc:
        found := find_mingw_gccdir(arch)
        if str.Len(found) > 0:
            gccdir = found
            have_gcc = true
        end
    end

    mut argv := Vector {} as Vector<str>
    defer argv.free()
    argv.push("ld.lld")
    argv.push("-m")
    argv.push(emul)
    argv.push("-Bdynamic")
    if !opts.debug_info:
        argv.push("-s")
    end
    argv.push("-o")
    argv.push(out_path)
    argv.push(crt2)
    if have_gcc:
        argv.push(filepath.Join(gccdir, "crtbegin.o"))
        argv.push("-L" + gccdir)
    end
    argv.push("-L" + filepath.Join(sr, "lib"))
    argv.push("-L" + filepath.Join(sr, "mingw/lib"))
    repeat opts.lib_paths.len() with lpi:
        argv.push("-L" + opts.lib_paths.get(lpi))
    end
    argv.push(obj)
    libs := user_libs_of(opts)
    defer libs.free()
    repeat libs.len() with i:
        argv.push(libs.get(i))
    end
    argv.push("--start-group")
    argv.push("-lmingw32")
    argv.push("-lgcc")
    argv.push("-lgcc_eh")
    argv.push("-lmoldname")
    argv.push("-lmingwex")
    argv.push("-lmsvcrt")
    argv.push("-ladvapi32")
    argv.push("-lshell32")
    argv.push("-luser32")
    argv.push("-lkernel32")
    argv.push("--end-group")
    if have_gcc:
        argv.push(filepath.Join(gccdir, "crtend.o"))
    end

    if Link(LLD_MINGW, argv_of(argv), argv.len()):
        ret LinkResult { ok = true }
    end
    ret LinkResult { ok = false, err = "in-process lld link failed" }
end

@en "LinkAuto"
@fa "پیوند خودکار"
pub func LinkAuto(obj: str, out_path: str, opts: Options): LinkResult:
    t := opts.target_triple
    if str.Len(t) == 0:
        ret LinkResult { ok = false, err = "no target triple set" }
    end
    win := str.Contains(t, "windows") || str.Contains(t, "mingw") || str.Contains(t, "win32")
    gnu := str.Contains(t, "gnu") || str.Contains(t, "mingw")
    if win && gnu:
        ret LinkMingw(obj, out_path, opts)
    end
    if str.Contains(t, "linux") && str.Contains(t, "musl"):
        ret LinkElf(obj, out_path, opts)
    end
    ret LinkResult { ok = false, err = "no in-process linker for triple '" + t + "'" }
end
