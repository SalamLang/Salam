package llvm

extern:
    func salam_lld_available(): int
    func salam_lld_link(flavor: int, argc: int, argv: void*): int
end

pub const LLD_ELF := 0
pub const LLD_MINGW := 1
pub const LLD_COFF := 2
pub const LLD_MACHO := 3
pub const LLD_WASM := 4

@en "LldAvailable"
@fa "لد در دسترس"
pub func LldAvailable(): bool:
    ret salam_lld_available() != 0
end

@en "Link"
@fa "پیوند"
pub func Link(flavor: int, argv: void*, argc: int): bool:
    ret salam_lld_link(flavor, argc, argv) == 0
end
