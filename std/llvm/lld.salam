// In-process LLD - the C-ABI boundary from c/src/llvm/lld_link.h. That
// file (and its .cc body) is NOT re-implemented here: it is already the
// minimal shim over LLD's C++ template-heavy driver headers, which Salam's
// `extern:` (C-ABI only) cannot bind directly - same reasoning
// compiler/llvm.salam already applies to it. This file just declares the
// two functions lld_link.cc exports and links against the same static
// archives c/Makefile's LLD_LIBS does - `static` here is a real,
// end-to-end request (see llvm.salam's link-kind comment), not a
// placeholder: LLD's component libs are only ever distributed as static
// archives (liblldELF.a etc, matching LLD_LIBS in c/Makefile:81), so this
// is also the only kind that makes sense for them.
package llvm

link static "lldELF"
link static "lldCOFF"
link static "lldMinGW"
link static "lldMachO"
link static "lldWasm"
link static "lldCommon"

extern:
    func salam_lld_available(): int
    func salam_lld_link(flavor: int, argc: int, argv: void*): int
end

// salam_lld_flavor_t (lld_link.h:22-28) - values MUST match the C enum.
pub const LLD_ELF := 0
pub const LLD_MINGW := 1
pub const LLD_COFF := 2
pub const LLD_MACHO := 3
pub const LLD_WASM := 4

@en "LldAvailable"
@fa "لد در دسترس"
@ar "لد متوفر"
pub func LldAvailable(): bool:
    ret salam_lld_available() != 0
end

// Link - calls salam_lld_link(flavor, argv.len(), argv-as-char**). `argv`
// is marshalled to a contiguous char*[] first (see ArgvOf in linker.salam)
// since that's the ABI salam_lld_link expects (lld_link.h:32:
// `int salam_lld_link(int flavor, int argc, const char *const *argv)`).
// Returns 0 on success, matching lld_link.cc's dispatch (0/1/2 by flavor
// outcome, folded to a single ok/fail here since callers only act on
// success vs failure, same as native_link_elf/native_link_mingw do).
@en "Link"
@fa "پیوند"
@ar "ربط"
pub func Link(flavor: int, argv: void*, argc: int): bool:
    ret salam_lld_link(flavor, argc, argv) == 0
end
