// Self-hosted counterpart of c/src/llvm/llvm_native.c + lld_link.{h,cc}:
// static-linked LLVM-C codegen/JIT + in-process LLD, exposed as a reusable
// std package (not compiler-internal) so any Salam program can drive them,
// not just the self-hosted compiler. See compiler/llvm.salam's NativeRun
// for the caller side.
@en "llvm"
@fa "ال ال وی ام"
@ar "ال ال وی ام"
package llvm

// Salam's `link` directive requires an explicit static/dynamic/framework
// kind (`link static "X"` / `link dynamic "X"` / `link framework "X"` -
// see tests/en/general/linkkind.salam; parsed in c/src/parser/parser_ffi.c
// and mirrored compiler/parser.salam, threaded through to the actual
// linker flag in c/src/driver/llvm_toolchain.c's emit_llvm_link and
// c/src/llvm/llvm_native.c's native_link_mingw - both fixed to honor it on
// Windows too as part of this package landing, since neither previously
// did). So `static` below really does request a static link, all the way
// through - this is NOT a placeholder.
//
// RESOLVED (was TODO(build-pipeline)): naming "LLVM" alone assumed one
// monolithic static libLLVM.a on the link path. That is not guaranteed -
// LLVM ships a large, version-dependent component graph (LLVMCore.a,
// LLVMTarget.a, ...) that the C build resolves by shelling out to
// `llvm-config --libs $(COMPONENTS)` at build time, something a .salam
// source file cannot do.
//
// `make -C c libsalam-llvm` now merges that whole graph - every archive
// `llvm-config --libs all` resolves (207 of them on LLVM 22), the six lld
// component archives, salam's own llvm_native.o/lld_link.o shims, and on
// Windows win_lld_demangle_shim.o's __imp_ aliases - into a single
// libsalam_llvm.a. So one name suffices here, and lld.salam no longer
// names its six archives separately.
//
// The system libraries below are deliberately NOT merged: they belong to
// the host, not to LLVM, and `llvm-config --link-static --system-libs`
// reports them per platform. Keep this list in step with that output.
link static "salam_llvm"

// LLVM and LLD are C++; their archives reference the C++ runtime, so it has
// to be linked too - and *after* libsalam_llvm.a, since a static link only
// resolves a symbol from an archive it has not already scanned past. The
// declaration order here is the link order.
if SALAM_OS_WINDOWS:
    link dynamic "psapi"
    link dynamic "shell32"
    link dynamic "ole32"
    link dynamic "uuid"
    link dynamic "advapi32"
    link dynamic "ws2_32"
    link dynamic "ntdll"
    // xml2 before z, for the same reason the C++ runtime comes after
    // libsalam_llvm.a: libxml2.a calls gzread/gzclose/gzdopen, so libz.a has
    // to still be ahead of the linker when those references show up. With z
    // first the link ended in "undefined reference to `gzread'".
    link static "xml2"
    link static "iconv"
    link static "z"
    link static "zstd"
    link dynamic "bcrypt"
    link static "stdc++"
    link static "gcc_eh"
    // LLVM/LLD use std::mutex and friends, which mingw's libstdc++ threading
    // layer implements on top of winpthreads.
    link static "pthread"
else SALAM_OS_MAC:
    // macOS gets its own arm rather than sharing the Linux one below for two
    // reasons, both of which broke the stage 2 link of the self-hosted
    // compiler outright:
    //
    // - the C++ runtime is libc++, not libstdc++. lld_link.cc is compiled
    //   -stdlib=libc++ and Homebrew's LLVM/LLD archives are built against it,
    //   so `-lstdc++` is the wrong library here even where the SDK still
    //   carries a stub for it. The C build reached the same conclusion from
    //   the other direction: compiler-release.yml's macOS job passes
    //   LLVM_CXXLIB=-lc++ to override c/Makefile's -lstdc++ default.
    // - `link static "X"` on a bare name is not expressible for Apple's
    //   linker (the driver warns and links it normally anyway - see
    //   emit_link in c/src/driver/build.c), so these are spelled dynamic:
    //   the SDK ships .tbd stubs, never archives, for all of them.
    //
    // zstd is the one entry the SDK does not provide at all. It comes from
    // Homebrew, whose keg is not on the linker's default search path, so the
    // link needs a `--libpath` pointing at it - compiler/tools/bash/
    // bootstrap.sh works out that directory the same way c/Makefile does.
    link dynamic "pthread"
    link dynamic "dl"
    link dynamic "m"
    link dynamic "z"
    link dynamic "zstd"
    link dynamic "xml2"
    link dynamic "c++"
else:
    link dynamic "pthread"
    link dynamic "dl"
    link dynamic "m"
    link static "z"
    link static "zstd"
    // libLLVMWindowsManifest.a is part of `llvm-config --libs all` on EVERY
    // host, not just Windows, and the apt.llvm.org builds compile it with
    // LLVM_ENABLE_LIBXML2=ON - so WindowsManifestMerger.cpp.o inside
    // libsalam_llvm.a references xmlNewDoc/xmlFree/... on Linux too, and the
    // self-host bootstrap failed to link without this. `llvm-config
    // --link-static --system-libs` lists it (`-lz -lzstd -lxml2`) for exactly
    // this reason; the C build picks it up from there automatically, and this
    // is the same entry for the Salam side.
    //
    // dynamic, unlike the Windows branch's `link static "xml2"`: a static
    // libxml2.a drags in zlib and liblzma symbols that would have to be
    // resolved by archives listed AFTER it, and liblzma-dev is not something
    // to make a build dependency. libxml2.so.2 is present on every mainstream
    // Linux and carries its own DT_NEEDED, which is also how upstream LLVM's
    // own tools link it.
    link dynamic "xml2"
    // LLVM asks the terminal whether it supports colour through terminfo
    // (Process::FileDescriptorHasColors -> tigetnum/set_curterm/del_curterm),
    // which lives in libtinfo. Without it the link fails on those three
    // symbols alone. Dynamic for the same reason as xml2: libtinfo.so is on
    // every mainstream Linux, and a static one drags in more than it is
    // worth.
    link dynamic "tinfo"
    link static "stdc++"
end

// Imports are package-wide once declared in any one file of a merged
// package (see std/ssl/ssl.salam vs its sibling files) - declared here
// only, not repeated in ir.salam/target.salam/etc.
import str
import os
import mem
import filepath

// ===== llvm_opt_level_t (codegen_llvm.h) - values MUST match the C enum. =====
pub const OPT_O0 := 0
pub const OPT_O1 := 1
pub const OPT_O2 := 2
pub const OPT_O3 := 3
pub const OPT_OS := 4
pub const OPT_OZ := 5

// ===== llvm_output_mode_t =====
pub const OUT_IR := 0
pub const OUT_ASM := 1
pub const OUT_OBJ := 2
pub const OUT_BITCODE := 3
pub const OUT_EXEC := 4
pub const OUT_JIT := 5

// ===== LLVMCodeGenFileType (llvm-c/TargetMachine.h) =====
pub const CODEGEN_FILE_ASSEMBLY := 0
pub const CODEGEN_FILE_OBJECT := 1

// ===== LLVMCodeGenOptLevel (llvm-c/TargetMachine.h) =====
pub const CODEGEN_LEVEL_NONE := 0
pub const CODEGEN_LEVEL_LESS := 1
pub const CODEGEN_LEVEL_DEFAULT := 2
pub const CODEGEN_LEVEL_AGGRESSIVE := 3

// ===== LLVMRelocMode / LLVMCodeModel (llvm-c/TargetMachine.h) =====
pub const RELOC_DEFAULT := 0
pub const RELOC_PIC := 2
pub const CODE_MODEL_DEFAULT := 0

// codegen_llvm_options_t. Field-for-field mirror of
// compiler/llvm.salam's `Options` (same integer values for opt_level/
// output_mode) so a caller can translate one to the other with a plain
// field copy - see that file's NativeRun for the translation.
@en "Options"
@fa "تنظیمات"
@ar "خیارات"
pub struct Options:
    pub opt_level: int = 0
    pub debug_info: bool = false
    pub verify_module: bool = false
    pub native_cpu: bool = false
    pub output_mode: int = 0
    pub output_file: str = ""
    pub target_triple: str = ""
    pub link_libs: Vector<str> = Vector {}
    pub link_kinds: Vector<str> = Vector {}
    pub sysroot: str = ""
    // Extra `-L` directories, searched ahead of the sysroot's own. Lets a
    // caller link against an archive that is not installed yet - the C
    // driver's --libpath=DIR maps straight onto this.
    pub lib_paths: Vector<str> = Vector {}
end

// llvm_output_t.
@en "Output"
@fa "خروجی"
@ar "مخرجات"
pub struct Output:
    pub ok: bool = false
    pub error: str = ""
end

@en "OptionsDefault"
@fa "تنظیمات پیش‌فرض"
@ar "خیارات افتراضیة"
pub func OptionsDefault(): Options:
    ret Options {}
end
