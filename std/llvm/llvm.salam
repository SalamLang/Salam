@en "llvm"
@fa "ال ال وی ام"
package llvm

link static "salam_llvm"

if defined(SALAM_LLVM_MINGW_CLANG):
    link dynamic "psapi"
    link dynamic "shell32"
    link dynamic "ole32"
    link dynamic "uuid"
    link dynamic "advapi32"
    link dynamic "ws2_32"
    link dynamic "ntdll"
    link dynamic "bcrypt"
    link static "unwind"
    link static "c++"
    link static "c++abi"
    link static "pthread"
else SALAM_OS_WINDOWS:
    link dynamic "psapi"
    link dynamic "shell32"
    link dynamic "ole32"
    link dynamic "uuid"
    link dynamic "advapi32"
    link dynamic "ws2_32"
    link dynamic "ntdll"
    link static "xml2"
    link static "iconv"
    link static "z"
    link static "zstd"
    link dynamic "bcrypt"
    link static "stdc++"
    link static "gcc_eh"
    link static "pthread"
else SALAM_OS_MAC:
    link dynamic "pthread"
    link dynamic "dl"
    link dynamic "m"
    link dynamic "z"
    link dynamic "zstd"
    link dynamic "xml2"
    link dynamic "c++"
else:
    link dynamic "pthread"
    link dynamic "dl"
    link dynamic "m"
    link static "zstd"
    link static "xml2"
    link static "z"
    link dynamic "tinfo"
    link static "stdc++"
end

import str
import os
import mem
import filepath

pub const OPT_O0 := 0
pub const OPT_O1 := 1
pub const OPT_O2 := 2
pub const OPT_O3 := 3
pub const OPT_OS := 4
pub const OPT_OZ := 5

pub const OUT_IR := 0
pub const OUT_ASM := 1
pub const OUT_OBJ := 2
pub const OUT_BITCODE := 3
pub const OUT_EXEC := 4
pub const OUT_JIT := 5

pub const CODEGEN_FILE_ASSEMBLY := 0
pub const CODEGEN_FILE_OBJECT := 1

pub const CODEGEN_LEVEL_NONE := 0
pub const CODEGEN_LEVEL_LESS := 1
pub const CODEGEN_LEVEL_DEFAULT := 2
pub const CODEGEN_LEVEL_AGGRESSIVE := 3

pub const RELOC_DEFAULT := 0
pub const RELOC_PIC := 2
pub const CODE_MODEL_DEFAULT := 0

@en "Options"
@fa "تنظیمات"
pub struct Options:
    pub opt_level: int = 0
    pub debug_info: bool = false
    pub verify_module: bool = false
    pub native_cpu: bool = false
    pub output_mode: int = 0
    pub output_file: str = ""
    pub target_triple: str = ""
    pub link_libs: Vector<str> = Vector {}
    pub link_kinds: Vector<str> = Vector {}
    pub sysroot: str = ""
    pub lib_paths: Vector<str> = Vector {}
end

@en "Output"
@fa "خروجی"
pub struct Output:
    pub ok: bool = false
    pub error: str = ""
end

@en "OptionsDefault"
@fa "تنظیمات پیش‌فرض"
pub func OptionsDefault(): Options:
    ret Options {}
end
