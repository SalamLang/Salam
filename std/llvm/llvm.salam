@en "llvm"
@fa "ال ال وی ام"
package llvm

link static "salam_llvm"

if defined(SALAM_LLVM_MINGW_CLANG):
    link dynamic "psapi"
    link dynamic "shell32"
    link dynamic "ole32"
    link dynamic "uuid"
    link dynamic "advapi32"
    link dynamic "ws2_32"
    link dynamic "ntdll"
    link dynamic "bcrypt"
    link static "unwind"
    link static "c++"
    link static "c++abi"
    link static "pthread"
else SALAM_OS_WINDOWS:
    link dynamic "psapi"
    link dynamic "shell32"
    link dynamic "ole32"
    link dynamic "uuid"
    link dynamic "advapi32"
    link dynamic "ws2_32"
    link dynamic "ntdll"
    link static "xml2"
    link static "iconv"
    link static "z"
    link static "zstd"
    link dynamic "bcrypt"
    link static "stdc++"
    link static "gcc_eh"
    link static "pthread"
else SALAM_OS_MAC:
    link dynamic "pthread"
    link dynamic "dl"
    link dynamic "m"
    link dynamic "z"
    link dynamic "zstd"
    link dynamic "xml2"
    link dynamic "c++"
else:
    link dynamic "pthread"
    link dynamic "dl"
    link dynamic "m"
    link static "zstd"
    link static "xml2"
    link static "z"
    link dynamic "tinfo"
    link static "stdc++"
end

import str
import os
import mem
import filepath

@en "OPT_O0"
@fa "بهینه‌سازی صفر"
pub const OPT_O0 := 0
@en "OPT_O1"
@fa "بهینه‌سازی یک"
pub const OPT_O1 := 1
@en "OPT_O2"
@fa "بهینه‌سازی دو"
pub const OPT_O2 := 2
@en "OPT_O3"
@fa "بهینه‌سازی سه"
pub const OPT_O3 := 3
@en "OPT_OS"
@fa "بهینه‌سازی اندازه"
pub const OPT_OS := 4
@en "OPT_OZ"
@fa "بهینه‌سازی کمینه اندازه"
pub const OPT_OZ := 5

@en "OUT_IR"
@fa "خروجی آی آر"
pub const OUT_IR := 0
@en "OUT_ASM"
@fa "خروجی اسمبلی"
pub const OUT_ASM := 1
@en "OUT_OBJ"
@fa "خروجی شیء"
pub const OUT_OBJ := 2
@en "OUT_BITCODE"
@fa "خروجی بیت‌کد"
pub const OUT_BITCODE := 3
@en "OUT_EXEC"
@fa "خروجی اجرایی"
pub const OUT_EXEC := 4
@en "OUT_JIT"
@fa "خروجی جیت"
pub const OUT_JIT := 5

@en "CODEGEN_FILE_ASSEMBLY"
@fa "پرونده اسمبلی"
pub const CODEGEN_FILE_ASSEMBLY := 0
@en "CODEGEN_FILE_OBJECT"
@fa "پرونده شیء"
pub const CODEGEN_FILE_OBJECT := 1

@en "CODEGEN_LEVEL_NONE"
@fa "سطح تولید بدون بهینه‌سازی"
pub const CODEGEN_LEVEL_NONE := 0
@en "CODEGEN_LEVEL_LESS"
@fa "سطح تولید کم"
pub const CODEGEN_LEVEL_LESS := 1
@en "CODEGEN_LEVEL_DEFAULT"
@fa "سطح تولید پیش‌فرض"
pub const CODEGEN_LEVEL_DEFAULT := 2
@en "CODEGEN_LEVEL_AGGRESSIVE"
@fa "سطح تولید تهاجمی"
pub const CODEGEN_LEVEL_AGGRESSIVE := 3

@en "RELOC_DEFAULT"
@fa "جابجایی پیش‌فرض"
pub const RELOC_DEFAULT := 0
@en "RELOC_PIC"
@fa "جابجایی مستقل از مکان"
pub const RELOC_PIC := 2
@en "CODE_MODEL_DEFAULT"
@fa "مدل کد پیش‌فرض"
pub const CODE_MODEL_DEFAULT := 0

@en "Options"
@fa "تنظیمات"
pub struct Options:
    pub opt_level: int = 0
    pub debug_info: bool = false
    pub verify_module: bool = false
    pub native_cpu: bool = false
    pub output_mode: int = 0
    pub output_file: str = ""
    pub target_triple: str = ""
    pub link_libs: Vector<str> = Vector {}
    pub link_kinds: Vector<str> = Vector {}
    pub sysroot: str = ""
    pub lib_paths: Vector<str> = Vector {}
    pub extra_objects: Vector<str> = Vector {}
    pub run_args: Vector<str> = Vector {}
end

@en "Output"
@fa "خروجی"
pub struct Output:
    pub ok: bool = false
    pub error: str = ""
    pub rc: int = 0
end

@en "OptionsDefault"
@fa "تنظیمات پیش‌فرض"
pub func OptionsDefault(): Options:
    ret Options {}
end
