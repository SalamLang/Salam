// Self-hosted counterpart of c/src/llvm/llvm_native.c + lld_link.{h,cc}:
// static-linked LLVM-C codegen/JIT + in-process LLD, exposed as a reusable
// std package (not compiler-internal) so any Salam program can drive them,
// not just the self-hosted compiler. See compiler/llvm.salam's NativeRun
// for the caller side.
@en "llvm"
@fa "ال ال وی ام"
@ar "ال ال وی ام"
package llvm

// TODO(build-pipeline): LLVM's static archives are a large,
// version-dependent component graph. The C build resolves it by shelling
// out to `llvm-config --libs $(COMPONENTS)` at build time (c/Makefile:97-
// 135), not by naming every archive in source - a per-file `link "X"`
// pragma can't reproduce that. The line below is a placeholder for the
// common/dynamic-link case; genuine static linking needs a self-host build
// pipeline (not yet written - see the plan this package shipped under)
// that injects llvm-config's resolved static libs as LDLIBS, the same way
// c/Makefile does, plus (on Windows) c/src/llvm/win_lld_demangle_shim.S's
// __imp_ aliases for liblld*.a's dllimport-style demangler/libxml2 refs.
link "LLVM"

// (Package-wide imports live in core.salam, not here: this package's
// files merge in filename order for top-level-statement ordering
// purposes, and core.salam sorts first - see the comment there.)

// ===== llvm_opt_level_t (codegen_llvm.h) - values MUST match the C enum. =====
pub const OPT_O0 := 0
pub const OPT_O1 := 1
pub const OPT_O2 := 2
pub const OPT_O3 := 3
pub const OPT_OS := 4
pub const OPT_OZ := 5

// ===== llvm_output_mode_t =====
pub const OUT_IR := 0
pub const OUT_ASM := 1
pub const OUT_OBJ := 2
pub const OUT_BITCODE := 3
pub const OUT_EXEC := 4
pub const OUT_JIT := 5

// ===== LLVMCodeGenFileType (llvm-c/TargetMachine.h) =====
pub const CODEGEN_FILE_ASSEMBLY := 0
pub const CODEGEN_FILE_OBJECT := 1

// ===== LLVMCodeGenOptLevel (llvm-c/TargetMachine.h) =====
pub const CODEGEN_LEVEL_NONE := 0
pub const CODEGEN_LEVEL_LESS := 1
pub const CODEGEN_LEVEL_DEFAULT := 2
pub const CODEGEN_LEVEL_AGGRESSIVE := 3

// ===== LLVMRelocMode / LLVMCodeModel (llvm-c/TargetMachine.h) =====
pub const RELOC_DEFAULT := 0
pub const RELOC_PIC := 2
pub const CODE_MODEL_DEFAULT := 0

// codegen_llvm_options_t. Field-for-field mirror of
// compiler/llvm.salam's `Options` (same integer values for opt_level/
// output_mode) so a caller can translate one to the other with a plain
// field copy - see that file's NativeRun for the translation.
@en "Options"
@fa "تنظیمات"
@ar "خیارات"
pub struct Options:
    pub opt_level: int = 0
    pub debug_info: bool = false
    pub verify_module: bool = false
    pub native_cpu: bool = false
    pub output_mode: int = 0
    pub output_file: str = ""
    pub target_triple: str = ""
    pub link_libs: Vector<str> = Vector {}
    pub link_kinds: Vector<str> = Vector {}
    pub sysroot: str = ""
end

// llvm_output_t.
@en "Output"
@fa "خروجی"
@ar "مخرجات"
pub struct Output:
    pub ok: bool = false
    pub error: str = ""
end

@en "OptionsDefault"
@fa "تنظیمات پیش‌فرض"
@ar "خیارات افتراضیة"
pub func OptionsDefault(): Options:
    ret Options {}
end
