// New pass manager - llvm-c/Transforms/PassBuilder.h, llvm-c/Error.h.
// Ports run_opt() (llvm_native.c:207-222).
package llvm

extern:
    func LLVMCreatePassBuilderOptions(): void*
    func LLVMDisposePassBuilderOptions(pbo: void*)
    func LLVMRunPasses(mod: void*, pipeline: str, tm: void*, pbo: void*): void*
    func LLVMGetErrorMessage(err: void*): void*
    func LLVMDisposeErrorMessage(msg: void*)
end

@en "OptResult"
@fa "نتیجه بهینه‌سازی"
@ar "نتیجة التحسین"
pub struct OptResult:
    pub ok: bool = false
    pub err: str = ""
end

// RunOpt - ports run_opt(): runs the pipeline PassPipelineOf(opt_level)
// picks (a no-op success at O0, where that function returns ""). A
// failure here is a warning in the C (LOG_W, not fatal) - callers may
// choose to continue with the unoptimized module; `ok=false` just reports
// it happened.
@en "RunOpt"
@fa "اجرای بهینه‌سازی"
@ar "تنفیذ التحسین"
pub func RunOpt(mod: Module, tm: TargetMachine, opt_level: int): OptResult:
    pipeline := PassPipelineOf(opt_level)
    if str.Len(pipeline) == 0:
        ret OptResult { ok = true }
    end
    pbo := LLVMCreatePassBuilderOptions()
    err := LLVMRunPasses(mod.handle, pipeline, tm.handle, pbo)
    LLVMDisposePassBuilderOptions(pbo)
    if err != null:
        msg := LLVMGetErrorMessage(err)
        out := msg != null ? str.Clone(msg as str) : "(unknown)"
        if msg != null: LLVMDisposeErrorMessage(msg) end
        ret OptResult { ok = false, err = "LLVM optimization failed: " + out }
    end
    ret OptResult { ok = true }
end
