package llvm

func run_parallel(pr: ParseResult, tm: TargetMachine, opts: Options, parts: int): Output:
    mut out := Output { ok = true }
    if opts.verify_module:
        vr := Verify(pr.mod)
        if not vr.ok:
            out = Output { ok = false, error = vr.err }
        end
    end
    if out.ok:
        par := OptimizeEmitParallel(pr.mod, tm, opts.opt_level, parts, opts.output_file)
        if not par.ok:
            out = Output { ok = false, error = par.err }
        else:
            mut extra := Vector {} as Vector<str>
            repeat par.objects.len() - 1 in i:
                extra.push(par.objects.get(i + 1))
            end
            mut xopts := opts
            xopts.extra_objects = extra
            mut lopts := xopts
            if str.Len(lopts.target_triple) == 0:
                lopts.target_triple = HostLinkTriple()
            end
            first := par.objects.get(0)
            if CanLinkTriple(lopts.target_triple):
                lr := LinkAuto(first, opts.output_file, lopts)
                out = Output { ok = lr.ok, error = lr.err }
            else:
                lr := LinkExternal(first, opts.output_file, xopts)
                out = Output { ok = lr.ok, error = lr.err }
            end
            repeat par.objects.len() in j:
                _rm := os.Remove(par.objects.get(j))
            end
            extra.free()
        end
    end
    FreeTargetMachine(tm)
    FreeModule(pr.mod)
    FreeContext(pr.ctx)
    ret out
end

@en "Available"
@fa "در دسترس"
pub func Available(): bool:
    ret true
end

@en "Run"
@fa "اجرا"
pub func Run(ll_path: str, opts: Options): Output:
    if opts.output_mode == OUT_IR:
        ret Output { ok = true }
    end

    if opts.output_mode == OUT_JIT:
        jr := RunJITArgs(ll_path, opts.run_args)
        ret Output { ok = jr.ok, error = jr.err, rc = jr.rc }
    end

    pr := ParseIR(ll_path)
    if not pr.ok:
        ret Output { ok = false, error = pr.err }
    end
    mut trip := opts.target_triple
    if str.Len(trip) == 0:
        trip = TargetTripleOf(pr.mod)
    end
    SetTargetTriple(pr.mod, trip)

    tmr := NewTargetMachine(trip, opts.opt_level, opts.native_cpu)
    if not tmr.ok:
        FreeModule(pr.mod)
        FreeContext(pr.ctx)
        ret Output { ok = false, error = tmr.err }
    end
    ApplyDataLayout(pr.mod, tmr.tm)

    if opts.output_mode == OUT_EXEC and not opts.debug_info:
        parts := ParallelPartitions(pr.mod, ParallelJobs())
        if parts >= 2:
            ret run_parallel(pr, tmr.tm, opts, parts)
        end
    end

    _opt := RunOpt(pr.mod, tmr.tm, opts.opt_level)

    if opts.verify_module:
        vr := Verify(pr.mod)
        if not vr.ok:
            FreeTargetMachine(tmr.tm)
            FreeModule(pr.mod)
            FreeContext(pr.ctx)
            ret Output { ok = false, error = vr.err }
        end
    end

    mut out := Output { ok = false, error = "unknown output mode" }
    if opts.output_mode == OUT_ASM:
        er := EmitAsm(pr.mod, tmr.tm, opts.output_file)
        out = Output { ok = er.ok, error = er.err }
    else opts.output_mode == OUT_BITCODE:
        er := EmitBitcode(pr.mod, opts.output_file)
        out = Output { ok = er.ok, error = er.err }
    else opts.output_mode == OUT_OBJ:
        er := EmitObject(pr.mod, tmr.tm, opts.output_file)
        out = Output { ok = er.ok, error = er.err }
    else opts.output_mode == OUT_EXEC:
        obj_path := opts.output_file + ".o"
        er := EmitObject(pr.mod, tmr.tm, obj_path)
        if not er.ok:
            out = Output { ok = false, error = er.err }
        else:
            mut lopts := opts
            if str.Len(lopts.target_triple) == 0:
                lopts.target_triple = HostLinkTriple()
            end
            if CanLinkTriple(lopts.target_triple):
                lr := LinkAuto(obj_path, opts.output_file, lopts)
                out = Output { ok = lr.ok, error = lr.err }
            else:
                lr := LinkExternal(obj_path, opts.output_file, opts)
                out = Output { ok = lr.ok, error = lr.err }
            end
            _rm := os.Remove(obj_path)
        end
    end

    FreeTargetMachine(tmr.tm)
    FreeModule(pr.mod)
    FreeContext(pr.ctx)
    ret out
end
