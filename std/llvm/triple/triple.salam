package triple

import str


const k_w64 := [
    "x86_64", "amd64", "aarch64", "arm64", "riscv64", "wasm64", "powerpc64", "ppc64", "mips64", "sparc64",
    "s390x", "loongarch64"
]

const k_w16 := ["msp430", "avr"]

const k_w32 := [
    "i386", "i486", "i586", "i686", "wasm32", "armv6", "armv7", "armv5", "thumb", "mipsel", "mips", "riscv32",
    "powerpc", "ppc", "arm"
]

func host_bits(): int:
    if SALAM_ARCH_X64 || SALAM_ARCH_ARM64:
        ret 64
    else:
        ret 32
    end
end

@en "HostDatalayout"
@fa "آرایش داده میزبان"
pub func HostDatalayout(): str:
    if SALAM_ARCH_X64 && SALAM_OS_WINDOWS:
        ret "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    else SALAM_ARCH_X64 && SALAM_OS_MAC:
        ret "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    else SALAM_ARCH_X64:
        ret "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    else SALAM_ARCH_ARM64 && SALAM_OS_MAC:
        ret "e-m:o-i64:64-i128:128-n32:64-S128"
    else SALAM_ARCH_ARM64:
        ret "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
    else SALAM_ARCH_X86:
        ret "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128"
    else:
        ret ""
    end
end

@en "Datalayout"
@fa "آرایش داده"
pub func Datalayout(t: str): str:
    dl_x64_elf := "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    dl_x64_win := "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    dl_x64_mac := "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    dl_x86_elf := "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128"
    dl_a64_elf := "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
    dl_a64_mac := "e-m:o-i64:64-i128:128-n32:64-S128"
    dl_rv64 := "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
    dl_arm_le := "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
    dl_arm_be := "E-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
    if str.Len(t) == 0:
        ret HostDatalayout()
    end
    win := str.Contains(t, "windows")
    mac := str.Contains(t, "apple") || str.Contains(t, "darwin") || str.Contains(t, "macos")
    if str.Contains(t, "x86_64") || str.Contains(t, "amd64"):
        ret win ? dl_x64_win : (mac ? dl_x64_mac : dl_x64_elf)
    end
    if str.Contains(t, "aarch64") || str.Contains(t, "arm64"):
        ret mac ? dl_a64_mac : dl_a64_elf
    end
    if !win && !mac && (
        str.Contains(t, "i686") || str.Contains(t, "i586") || str.Contains(t, "i486") || str.Contains(t, "i386")
    ):
        ret dl_x86_elf
    end
    if str.Contains(t, "riscv64"):
        ret dl_rv64
    end
    if str.Contains(t, "thumb") || str.Contains(t, "arm"):
        ret (str.Contains(t, "thumbeb") || str.Contains(t, "armeb")) ? dl_arm_be : dl_arm_le
    end
    ret ""
end

@en "PointerBits"
@fa "بیت های اشاره گر"
pub func PointerBits(t: str): int:
    if str.Len(t) == 0:
        ret host_bits()
    end
    repeat 12 with i:
        if str.Contains(t, k_w64[i]):
            ret 64
        end
    end
    repeat 2 with k:
        if str.Contains(t, k_w16[k]):
            ret 16
        end
    end
    repeat 15 with j:
        if str.Contains(t, k_w32[j]):
            ret 32
        end
    end
    ret host_bits()
end

@en "IsWindows"
@fa "ویندوز است"
pub func IsWindows(t: str): bool:
    if str.Len(t) > 0:
        ret str.Contains(t, "windows") || str.Contains(t, "mingw") || str.Contains(t, "win32")
    end
    if SALAM_OS_WINDOWS:
        ret true
    else:
        ret false
    end
end

@en "IsGlibc"
@fa "گلیبسی است"
pub func IsGlibc(t: str): bool:
    if str.Len(t) == 0: ret false end
    if str.Contains(t, "musl"): ret false end
    if str.Contains(t, "darwin") || str.Contains(t, "apple"): ret false end
    if str.Contains(t, "windows") || str.Contains(t, "wasm"): ret false end
    ret str.Contains(t, "linux")
end
