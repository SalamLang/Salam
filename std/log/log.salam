@en "log"
@fa "گزارش"
package log

import str
import time
import fmt
import io
import os
import conv
import sync
import chan
import encoding.json

extern:
    noret func exit(code: int)
    func salam_open(path: str, mode: str): File*
end

@en "LevelDebug"
@fa "سطح اشکال زدایی"
pub const LevelDebug := 0

@en "LevelInfo"
@fa "سطح اطلاعات"
pub const LevelInfo := 1

@en "LevelWarn"
@fa "سطح هشدار"
pub const LevelWarn := 2

@en "LevelError"
@fa "سطح خطا"
pub const LevelError := 3

@en "FormatText"
@fa "قالب متن"
pub const FormatText := 0

@en "FormatJSON"
@fa "قالب جیسون"
pub const FormatJSON := 1

mut _level := 1
mut _prefix := ""
mut _show_time := true
mut _sink := 0
mut _file := null as File*
mut _format := 0
mut _file_path := ""
mut _rotate_max_bytes := 0 as i64
mut _rotate_max_backups := 5
mut _bytes_since_rotate := 0 as i64

mut _write_mu := sync.NewMutex()
mut _async_mu := sync.NewMutex()
mut _async_cv := sync.NewCondVar()
mut _async_on := false
mut _async_q := chan.Chan {} as chan.Chan<str>
mut _async_handle := 0 as i64
mut _async_pending := 0 as i64
mut _async_users := 0 as i64

func _level_name(l: int): str:
    if l <= 0: ret "DEBUG"
    else l == 1: ret "INFO"
    else l == 2: ret "WARN"
    else:
        ret "ERROR"
    end
end

func _rotate_if_needed():
    if _rotate_max_bytes <= (0 as i64) or _sink != 2 or _file_path == "": ret end
    if _bytes_since_rotate < _rotate_max_bytes: ret end
    if _file != null: _file.close() end

    mut i := _rotate_max_backups
    until i >= 2:
        src := _file_path.concat(".").concat(conv.FormatInt(i - 1 as i64))
        dst := _file_path.concat(".").concat(conv.FormatInt(i as i64))
        if os.Exists(src):
            os.Remove(dst)
            os.Move(src, dst)
        end
        i--
    end
    if os.Exists(_file_path):
        bak1 := _file_path.concat(".1")
        os.Remove(bak1)
        os.Move(_file_path, bak1)
    end
    _file = salam_open(_file_path, "ab")
    _bytes_since_rotate = 0 as i64
end

func _text_line(l: int, msg: str, keys: Vector<str>, vals: Vector<str>): str:
    mut line := ""
    if _show_time:
        line = line.concat(time.Format(time.Now())).concat(" ")
    end
    line = line.concat("[").concat(_level_name(l)).concat("]")
    if _prefix.len() > 0:
        line = line.concat(" ").concat(_prefix)
    end
    line = line.concat(" ").concat(msg)
    repeat keys.len() in i:
        line = line.concat(" ").concat(Field(keys.get(i), vals.get(i)))
    end
    ret line
end

func _json_line(l: int, msg: str, keys: Vector<str>, vals: Vector<str>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, "{")
    mut first := true
    if _show_time:
        str.BufAppend(b, json.Member("time", time.FormatISO(time.Now())))
        first = false
    end
    if first == false: str.BufAppend(b, ", ") end
    str.BufAppend(b, json.Member("level", _level_name(l)))
    if _prefix.len() > 0:
        str.BufAppend(b, ", ")
        str.BufAppend(b, json.Member("prefix", _prefix))
    end
    str.BufAppend(b, ", ")
    str.BufAppend(b, json.Member("msg", msg))
    repeat keys.len() in i:
        str.BufAppend(b, ", ")
        str.BufAppend(b, json.Member(keys.get(i), vals.get(i)))
    end
    str.BufAppend(b, "}")
    ret str.BufStr(b)
end

func _write_line(line: str):
    sync.Lock(_write_mu)
    if _sink == 2 and _file != null:
        _rotate_if_needed()
        _file.write(line.concat("\n"))
        _bytes_since_rotate += (line.len() as i64) + (1 as i64)
    else:
        if _sink == 1:
            println line
        else:
            io.EPrintln(line)
        end
    end
    sync.Unlock(_write_mu)
end

func _emit_kv(l: int, msg: str, keys: Vector<str>, vals: Vector<str>):
    if l < _level: ret end
    mut line := ""
    if _format == 1:
        line = _json_line(l, msg, keys, vals)
    else:
        line = _text_line(l, msg, keys, vals)
    end
    if _async_on:
        sync.Lock(_async_mu)
        if _async_on:
            _async_pending++
            _async_users++
            sync.Unlock(_async_mu)
            sent := _async_q.send(line)
            if not sent:
                _write_line(line)
            end
            sync.Lock(_async_mu)
            _async_users--
            if not sent:
                _async_pending--
                sync.Broadcast(_async_cv)
            end
            sync.Unlock(_async_mu)
            ret
        end
        sync.Unlock(_async_mu)
    end
    _write_line(line)
end

func _emit(l: int, msg: str):
    empty := Vector {} as Vector<str>
    _emit_kv(l, msg, empty, empty)
end

func _async_worker():
    mut ok := true
    until true:
        line := _async_q.recv(ok)
        if not ok:
            break
        end
        _write_line(line)
        sync.Lock(_async_mu)
        _async_pending--
        if _async_pending <= 0:
            sync.Broadcast(_async_cv)
        end
        sync.Unlock(_async_mu)
    end
end

func _flush():
    if not _async_on:
        ret
    end
    sync.Lock(_async_mu)
    until _async_pending > 0:
        _ := sync.WaitCondTimeout(_async_cv, _async_mu, 50 as i64)
    end
    sync.Unlock(_async_mu)
end

func _start_async(capacity: i64): bool:
    sync.Lock(_async_mu)
    if _async_on:
        sync.Unlock(_async_mu)
        ret false
    end
    _async_q = chan.Chan {} as chan.Chan<str>
    _async_q.init(capacity)
    _async_pending = 0
    _async_users = 0
    _async_on = true
    _async_handle = spawn(_async_worker)
    sync.Unlock(_async_mu)
    ret true
end

func _stop_async():
    sync.Lock(_async_mu)
    if not _async_on:
        sync.Unlock(_async_mu)
        ret
    end
    _async_on = false
    until _async_users > 0:
        _ := sync.WaitCondTimeout(_async_cv, _async_mu, 50 as i64)
    end
    _async_q.close()
    sync.Unlock(_async_mu)
    join(_async_handle)
    _async_handle = 0
    _async_q.free()
end

@en "LevelName"
@fa "نام سطح"
pub func LevelName(l: int): str: ret _level_name(l) end

@en "ParseLevel"
@fa "تجزیه سطح"
pub func ParseLevel(s: str): int:
    u := str.Upper(str.Trim(s))
    if u == "DEBUG": ret 0
    else u == "INFO": ret 1
    else u == "WARN": ret 2
    else u == "WARNING": ret 2
    else u == "ERROR": ret 3
    else:
        ret 1
    end
end

@en "SetLevel"
@fa "تنظیم سطح"
pub func SetLevel(l: int): _level = l end

@en "GetLevel"
@fa "دریافت سطح"
pub func GetLevel(): int: ret _level end

@en "SetPrefix"
@fa "تنظیم پیشوند"
pub func SetPrefix(p: str): _prefix = p end

@en "ShowTime"
@fa "نمایش زمان"
pub func ShowTime(b: bool): _show_time = b end

@en "SetFormat"
@fa "تنظیم قالب"
pub func SetFormat(f: int): _format = f end

@en "GetFormat"
@fa "دریافت قالب"
pub func GetFormat(): int: ret _format end

@en "SetRotation"
@fa "تنظیم چرخش"
pub func SetRotation(max_bytes: i64, max_backups: int):
    _rotate_max_bytes = max_bytes
    _rotate_max_backups = max_backups
end

@en "ToStderr"
@fa "به خطای استاندارد"
pub func ToStderr():
    _flush()
    sync.Lock(_write_mu)
    _sink = 0
    sync.Unlock(_write_mu)
end

@en "ToStdout"
@fa "به خروجی استاندارد"
pub func ToStdout():
    _flush()
    sync.Lock(_write_mu)
    _sink = 1
    sync.Unlock(_write_mu)
end

@en "ToFile"
@fa "به پرونده"
pub func ToFile(path: str): int:
    _flush()
    f := salam_open(path, "ab")
    if f == null: ret 0 - 1 end
    sync.Lock(_write_mu)
    if _sink == 2 and _file != null: _file.close() end
    _file = f
    _file_path = path
    _sink = 2
    existing := os.FileSize(path)
    if existing > (0 as i64):
        _bytes_since_rotate = existing
    else:
        _bytes_since_rotate = 0 as i64
    end
    sync.Unlock(_write_mu)
    ret 0
end

@en "CloseFile"
@fa "بستن پرونده"
pub func CloseFile():
    _flush()
    sync.Lock(_write_mu)
    if _sink == 2 and _file != null: _file.close() end
    _file = null
    _sink = 0
    sync.Unlock(_write_mu)
end

@en "StartAsync"
@fa "شروع ناهمگام"
pub func StartAsync(capacity: i64): bool:
    ret _start_async(capacity)
end

@en "StopAsync"
@fa "توقف ناهمگام"
pub func StopAsync():
    _stop_async()
end

@en "Flush"
@fa "تخلیه"
pub func Flush():
    _flush()
end

@en "IsAsync"
@fa "ناهمگام است"
pub func IsAsync(): bool:
    sync.Lock(_async_mu)
    v := _async_on
    sync.Unlock(_async_mu)
    ret v
end

@en "Log"
@fa "ثبت"
pub func Log(l: int, msg: str): _emit(l, msg) end

@en "Debug"
@fa "اشکال زدایی"
pub func Debug(msg: str): _emit(0, msg) end

@en "Info"
@fa "اطلاعات"
pub func Info(msg: str): _emit(1, msg) end

@en "Warn"
@fa "هشدار"
pub func Warn(msg: str): _emit(2, msg) end

@en "Error"
@fa "خطا"
pub func Error(msg: str): _emit(3, msg) end

@en "Debugf"
@fa "اشکال زدایی قالبی"
pub func Debugf(tmpl: str, args: Vector<str>): _emit(0, fmt.Sprintf(tmpl, args)) end

@en "Infof"
@fa "اطلاعات قالبی"
pub func Infof(tmpl: str, args: Vector<str>): _emit(1, fmt.Sprintf(tmpl, args)) end

@en "Warnf"
@fa "هشدار قالبی"
pub func Warnf(tmpl: str, args: Vector<str>): _emit(2, fmt.Sprintf(tmpl, args)) end

@en "Errorf"
@fa "خطا قالبی"
pub func Errorf(tmpl: str, args: Vector<str>): _emit(3, fmt.Sprintf(tmpl, args)) end

@en "Fatal"
@fa "مهلک"
pub noret func Fatal(msg: str):
    _emit(3, msg)
    _stop_async()
    sync.Lock(_write_mu)
    if _sink == 2 and _file != null: _file.close() end
    sync.Unlock(_write_mu)
    exit(1)
end

@en "Field"
@fa "فیلد"
pub func Field(key: str, val: str): str:
    if str.Contains(val, " ") or str.Contains(val, `"`):
        ret key.concat(`="`).concat(str.Replace(val, `"`, `\"`)).concat(`"`)
    end
    ret key.concat("=").concat(val)
end

@en "FieldInt"
@fa "فیلد عدد"
pub func FieldInt(key: str, val: i64): str:
    ret key.concat("=").concat(str.FromInt(val))
end

@en "FieldBool"
@fa "فیلد منطقی"
pub func FieldBool(key: str, val: bool): str:
    if val: ret key.concat("=true") end
    ret key.concat("=false")
end

@en "KV"
@fa "کلید مقدار"
pub func KV(msg: str, fields: Vector<str>): str:
    mut out := msg
    repeat fields.len() in i:
        out = out.concat(" ").concat(fields.get(i))
    end
    ret out
end

@en "DebugKV"
@fa "اشکال زدایی با فیلد"
pub func DebugKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(0, msg, keys, vals) end

@en "InfoKV"
@fa "اطلاعات با فیلد"
pub func InfoKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(1, msg, keys, vals) end

@en "WarnKV"
@fa "هشدار با فیلد"
pub func WarnKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(2, msg, keys, vals) end

@en "ErrorKV"
@fa "خطا با فیلد"
pub func ErrorKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(3, msg, keys, vals) end
