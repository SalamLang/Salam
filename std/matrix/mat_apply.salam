package matrix

import math

// The universal functions: a scalar function of one argument, applied to
// every entry. NumPy calls these ufuncs and so does everyone else.
//
// These all share one traversal (_map) selected by an opcode rather than
// getting a hand-written loop each. That trade is only worth making because
// of what these functions are: every one of them ends in a libm call, and a
// libm call costs one to two orders of magnitude more than the branch that
// chose it. The version with twenty copies of the same loop measures the
// same and is twenty times more places for a typo to hide.
//
// Note what is deliberately absent: a general Map that takes a callback.
// Without closures it would have to be a slot-dispatch table, which is this
// same opcode switch with a worse name and no type checking.

const _OP_ABS := 0
const _OP_SQRT := 1
const _OP_EXP := 2
const _OP_LOG := 3
const _OP_LOG10 := 4
const _OP_LOG2 := 5
const _OP_SIN := 6
const _OP_COS := 7
const _OP_TAN := 8
const _OP_ASIN := 9
const _OP_ACOS := 10
const _OP_ATAN := 11
const _OP_SINH := 12
const _OP_COSH := 13
const _OP_TANH := 14
const _OP_FLOOR := 15
const _OP_CEIL := 16
const _OP_ROUND := 17
const _OP_TRUNC := 18
const _OP_SIGN := 19
const _OP_SQUARE := 20
const _OP_RECIP := 21
const _OP_CBRT := 22

func _scalar_lo(v: f64, op: int): f64:
    if op == _OP_ABS: ret math.Abs(v) end
    if op == _OP_SQRT: ret math.Sqrt(v) end
    if op == _OP_EXP: ret math.Exp(v) end
    if op == _OP_LOG: ret math.Log(v) end
    if op == _OP_LOG10: ret math.Log10(v) end
    if op == _OP_LOG2: ret math.Log2(v) end
    if op == _OP_SIN: ret math.Sin(v) end
    if op == _OP_COS: ret math.Cos(v) end
    if op == _OP_TAN: ret math.Tan(v) end
    if op == _OP_ASIN: ret math.Asin(v) end
    if op == _OP_ACOS: ret math.Acos(v) end
    ret math.Atan(v)
end

func _scalar_hi(v: f64, op: int): f64:
    if op == _OP_SINH: ret math.Sinh(v) end
    if op == _OP_COSH: ret math.Cosh(v) end
    if op == _OP_TANH: ret math.Tanh(v) end
    if op == _OP_FLOOR: ret math.Floor(v) end
    if op == _OP_CEIL: ret math.Ceil(v) end
    if op == _OP_ROUND: ret math.Round(v) end
    if op == _OP_TRUNC: ret math.Trunc(v) end
    if op == _OP_SIGN: ret math.Sign(v) end
    if op == _OP_SQUARE: ret v * v end
    if op == _OP_RECIP:
        if v == 0.0: ret 0.0 end
        ret 1.0 / v
    end
    ret math.Cbrt(v)
end

// The two payload pointers are hoisted for the same reason every other kernel
// here hoists them: through a.get/a.set the Vector's `data` and `count` are
// re-read on every element, because a double store cannot be proven not to
// alias the Vector struct. The op dispatch stays inside the loop - unlike the
// entrywise operators there are twenty-odd cases here, and most of them are
// libm calls that would not vectorise anyway.
func _map(x &: Matrix, op: int): Matrix:
    r := Zeros(x.rows, x.cols)
    n := x.count()
    if n <= 0: ret r end
    px := x.a.data
    pr := r.a.data
    if op <= _OP_ATAN:
        repeat n with k: pr[k] = _scalar_lo(px[k], op) end
        ret r
    end
    repeat n with k: pr[k] = _scalar_hi(px[k], op) end
    ret r
end

// Binary exponentiation for a small non-negative integer power. Exact where
// pow() would round, and cheaper.
func _ipow(v: f64, n: int): f64:
    mut acc := 1.0
    mut b := v
    mut e := n
    until e > 0:
        if e % 2 == 1: acc = acc * b end
        b = b * b
        e = e / 2
    end
    ret acc
end

@en "Abs"
@fa "قدرمطلق"
@ar "قيمة مطلقة"
pub func Abs(x &: Matrix): Matrix: ret _map(x, _OP_ABS) end

@en "Sqrt"
@fa "جذر"
@ar "جذر"
pub func Sqrt(x &: Matrix): Matrix: ret _map(x, _OP_SQRT) end

@en "Exp"
@fa "نمایی"
@ar "أسي"
pub func Exp(x &: Matrix): Matrix: ret _map(x, _OP_EXP) end

@en "Log"
@fa "لگاریتم"
@ar "لوغاريتم"
pub func Log(x &: Matrix): Matrix: ret _map(x, _OP_LOG) end

@en "Log10"
@fa "لگاریتم ده"
@ar "لوغاريتم عشري"
pub func Log10(x &: Matrix): Matrix: ret _map(x, _OP_LOG10) end

@en "Log2"
@fa "لگاریتم دو"
@ar "لوغاريتم ثنائي"
pub func Log2(x &: Matrix): Matrix: ret _map(x, _OP_LOG2) end

@en "Sin"
@fa "سینوس"
@ar "جيب"
pub func Sin(x &: Matrix): Matrix: ret _map(x, _OP_SIN) end

@en "Cos"
@fa "کسینوس"
@ar "جيب تمام"
pub func Cos(x &: Matrix): Matrix: ret _map(x, _OP_COS) end

@en "Tan"
@fa "تانژانت"
@ar "ظل"
pub func Tan(x &: Matrix): Matrix: ret _map(x, _OP_TAN) end

@en "Asin"
@fa "وارون سینوس"
@ar "قوس جيب"
pub func Asin(x &: Matrix): Matrix: ret _map(x, _OP_ASIN) end

@en "Acos"
@fa "وارون کسینوس"
@ar "قوس جيب تمام"
pub func Acos(x &: Matrix): Matrix: ret _map(x, _OP_ACOS) end

@en "Atan"
@fa "وارون تانژانت"
@ar "قوس ظل"
pub func Atan(x &: Matrix): Matrix: ret _map(x, _OP_ATAN) end

@en "Sinh"
@fa "سینوس هذلولوی"
@ar "جيب زائدي"
pub func Sinh(x &: Matrix): Matrix: ret _map(x, _OP_SINH) end

@en "Cosh"
@fa "کسینوس هذلولوی"
@ar "جيب تمام زائدي"
pub func Cosh(x &: Matrix): Matrix: ret _map(x, _OP_COSH) end

@en "Tanh"
@fa "تانژانت هذلولوی"
@ar "ظل زائدي"
pub func Tanh(x &: Matrix): Matrix: ret _map(x, _OP_TANH) end

@en "Floor"
@fa "کف"
@ar "أرضية"
pub func Floor(x &: Matrix): Matrix: ret _map(x, _OP_FLOOR) end

@en "Ceil"
@fa "سقف"
@ar "سقف"
pub func Ceil(x &: Matrix): Matrix: ret _map(x, _OP_CEIL) end

@en "Round"
@fa "گرد"
@ar "تقريب"
pub func Round(x &: Matrix): Matrix: ret _map(x, _OP_ROUND) end

@en "Trunc"
@fa "برش"
@ar "بتر"
pub func Trunc(x &: Matrix): Matrix: ret _map(x, _OP_TRUNC) end

// -1, 0 or +1 per entry, which is the derivative of Abs everywhere it exists
// and the building block of the matrix sign iteration.
@en "Sign"
@fa "علامت"
@ar "إشارة"
pub func Sign(x &: Matrix): Matrix: ret _map(x, _OP_SIGN) end

@en "Square"
@fa "مربع"
@ar "تربيع"
pub func Square(x &: Matrix): Matrix: ret _map(x, _OP_SQUARE) end

// Entrywise 1/x, with 1/0 defined as 0 for the same reason DivElem does it:
// a single zero should not turn a whole later reduction into a NaN.
@en "Reciprocal"
@fa "وارون درایه‌ای"
@ar "مقلوب عنصري"
pub func Reciprocal(x &: Matrix): Matrix: ret _map(x, _OP_RECIP) end

@en "Cbrt"
@fa "ریشه سوم"
@ar "جذر تكعيبي"
pub func Cbrt(x &: Matrix): Matrix: ret _map(x, _OP_CBRT) end

// Entrywise x^p. Integer exponents go through repeated multiplication, which
// is both faster and exact for small powers, where pow() would round.
@en "PowElem"
@fa "توان درایه‌ای"
@ar "قوة عنصرية"
pub func PowElem(x &: Matrix, p: f64): Matrix:
    mut r := Zeros(x.rows, x.cols)
    ip := p as int
    exact := (ip as f64) == p && ip >= 0 && ip <= 64
    repeat x.count() with k:
        v := x.a.get(k)
        if exact:
            r.a.set(k, _ipow(v, ip))
        else:
            r.a.set(k, math.Pow(v, p))
        end
    end
    ret r
end

// Clamps every entry into [lo, hi], NumPy's clip.
@en "Clip"
@fa "برش بازه"
@ar "قص"
pub func Clip(x &: Matrix, lo: f64, hi: f64): Matrix:
    mut r := Zeros(x.rows, x.cols)
    repeat x.count() with k:
        mut v := x.a.get(k)
        if v < lo: v = lo end
        if v > hi: v = hi end
        r.a.set(k, v)
    end
    ret r
end

// Entrywise max against a scalar, the "clip from below" half of Clip.
@en "MaxScalar"
@fa "بیشینه با عدد"
@ar "أكبر مع عدد"
pub func MaxScalar(x &: Matrix, s: f64): Matrix: ret Clip(x, s, MAT_INF) end

@en "MinScalar"
@fa "کمینه با عدد"
@ar "أصغر مع عدد"
pub func MinScalar(x &: Matrix, s: f64): Matrix:
    ret Clip(x, 0.0 - MAT_INF, s)
end

// Entries whose magnitude falls below `tol` are snapped to exactly zero.
// The cosmetic pass that turns a computed triangular factor into one that
// prints as triangular, and the honest way to do it: the caller names the
// threshold instead of the printer hiding the dirt.
@en "Chop"
@fa "حذف ریزه"
@ar "تصفير الصغائر"
pub func Chop(x &: Matrix, tol: f64): Matrix:
    mut r := Clone(x)
    repeat r.count() with k:
        if math.Abs(r.a.get(k)) < tol: r.a.set(k, 0.0) end
    end
    ret r
end
