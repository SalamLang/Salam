package matrix

import math

@en "LDL"
@fa "تجزیه ال‌دی‌ال"
pub struct LDL:
    pub n: int = 0
    pub l: Matrix = Matrix {}
    pub d: Matrix = Matrix {}
    pub ok: bool = false

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.l.free()
        this.d.free()
    end
end

func _chol_dot(l &: Matrix, i: int, j: int, k: int): f64:
    mut s := 0.0
    repeat k with p: s += l.at(i, p) * l.at(j, p) end
    ret s
end

func _chol_col(l &: Matrix, a &: Matrix, j: int, n: int): bool:
    d := a.at(j, j) - _chol_dot(l, j, j, j)
    if d <= 0.0: ret false end
    p := math.Sqrt(d)
    l.set(j, j, p)
    mut i := j + 1
    until i < n:
        l.set(i, j, (a.at(i, j) - _chol_dot(l, i, j, j)) / p)
        i += 1
    end
    ret true
end

func _tri_forward(l &: Matrix, b &: Matrix, n: int):
    repeat b.cols with c:
        repeat n with i:
            mut s := b.at(i, c)
            repeat i with j: s -= l.at(i, j) * b.at(j, c) end
            b.set(i, c, s / l.at(i, i))
        end
    end
end

func _tri_backward_t(l &: Matrix, b &: Matrix, n: int):
    repeat b.cols with c:
        mut i := n - 1
        until i >= 0:
            mut s := b.at(i, c)
            mut j := i + 1
            until j < n:
                s -= l.at(j, i) * b.at(j, c)
                j += 1
            end
            b.set(i, c, s / l.at(i, i))
            i -= 1
        end
    end
end

func _unit_forward(l &: Matrix, b &: Matrix, n: int):
    repeat b.cols with c:
        repeat n with i:
            mut s := b.at(i, c)
            repeat i with j: s -= l.at(i, j) * b.at(j, c) end
            b.set(i, c, s)
        end
    end
end

func _unit_backward_t(l &: Matrix, b &: Matrix, n: int):
    repeat b.cols with c:
        mut i := n - 1
        until i >= 0:
            mut s := b.at(i, c)
            mut j := i + 1
            until j < n:
                s -= l.at(j, i) * b.at(j, c)
                j += 1
            end
            b.set(i, c, s)
            i -= 1
        end
    end
end

func _ldl_col(f &: LDL, a &: Matrix, j: int, n: int):
    mut d := a.at(j, j)
    repeat j with p: d -= f.l.at(j, p) * f.l.at(j, p) * f.d.at(0, p) end
    f.d.set(0, j, d)
    f.l.set(j, j, 1.0)
    if d == 0.0: ret end
    mut i := j + 1
    until i < n:
        mut s := a.at(i, j)
        repeat j with p: s -= f.l.at(i, p) * f.l.at(j, p) * f.d.at(0, p) end
        f.l.set(i, j, s / d)
        i += 1
    end
end

func _ldl_nonsingular(f &: LDL): bool:
    repeat f.n with i:
        if f.d.at(0, i) == 0.0: ret false end
    end
    ret true
end

func _ldl_scale(f &: LDL, b &: Matrix):
    repeat f.n with i:
        d := f.d.at(0, i)
        repeat b.cols with c: b.set(i, c, b.at(i, c) / d) end
    end
end

func _tally(r &: Matrix, d: f64):
    if d > 0.0:
        r.add_at(0, 0, 1.0)
        ret
    end
    if d < 0.0:
        r.add_at(0, 1, 1.0)
        ret
    end
    r.add_at(0, 2, 1.0)
end

@en "Cholesky"
@fa "چولسکی"
pub func Cholesky(x &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    n := x.rows
    mut l := Zeros(n, n)
    repeat n with j:
        if _chol_col(l, x, j, n) == false:
            l.free()
            ret Zeros(0, 0)
        end
    end
    ret l
end

@en "SolveSPD"
@fa "حل معین مثبت"
pub func SolveSPD(a &: Matrix, b &: Matrix): Matrix:
    mut l := Cholesky(a)
    if l.is_empty(): ret Zeros(0, 0) end
    r := CholeskySolve(l, b)
    defer l.free()
    ret r
end

@en "CholeskySolve"
@fa "حل چولسکی"
pub func CholeskySolve(l &: Matrix, b &: Matrix): Matrix:
    if l.rows != b.rows: ret Zeros(0, 0) end
    mut r := Clone(b)
    _tri_forward(l, r, l.rows)
    _tri_backward_t(l, r, l.rows)
    ret r
end

@en "InverseSPD"
@fa "وارون معین مثبت"
pub func InverseSPD(x &: Matrix): Matrix:
    mut id := Eye(x.rows)
    r := SolveSPD(x, id)
    defer id.free()
    ret r
end

@en "DetSPD"
@fa "دترمینان معین مثبت"
pub func DetSPD(x &: Matrix): f64:
    mut l := Cholesky(x)
    if l.is_empty(): ret 0.0 end
    mut p := 1.0
    repeat l.rows with i: p = p * l.at(i, i) end
    defer l.free()
    ret p * p
end

@en "LogDetSPD"
@fa "لگاریتم دترمینان معین مثبت"
pub func LogDetSPD(x &: Matrix): f64:
    mut l := Cholesky(x)
    if l.is_empty(): ret 0.0 - MAT_INF end
    mut s := 0.0
    repeat l.rows with i: s += math.Log(l.at(i, i)) end
    defer l.free()
    ret 2.0 * s
end

@en "LDLDecompose"
@fa "تجزیه ال‌دی‌ال"
pub func LDLDecompose(x &: Matrix): LDL:
    mut f := LDL {}
    if x.is_square() == false: ret f end
    n := x.rows
    f.n = n
    f.l = Zeros(n, n)
    f.d = Zeros(1, n)
    repeat n with j: _ldl_col(f, x, j, n) end
    f.ok = _ldl_nonsingular(f)
    ret f
end

@en "LDLSolve"
@fa "حل ال‌دی‌ال"
pub func LDLSolve(f &: LDL, b &: Matrix): Matrix:
    if f.ok == false || f.n != b.rows: ret Zeros(0, 0) end
    mut r := Clone(b)
    _unit_forward(f.l, r, f.n)
    _ldl_scale(f, r)
    _unit_backward_t(f.l, r, f.n)
    ret r
end

@en "Inertia"
@fa "لختی"
pub func Inertia(x &: Matrix): Matrix:
    mut f := LDLDecompose(x)
    mut r := Zeros(1, 3)
    repeat f.n with i: _tally(r, f.d.at(0, i)) end
    defer f.free()
    ret r
end
