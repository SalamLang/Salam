package matrix

// Elementwise arithmetic, in the two shapes every dense library ends up
// needing.
//
// The allocating form (Add, Sub, Scale, ...) returns a fresh matrix and is
// what reads well at a call site. The in-place form (AddInPlace, ScaleInPlace,
// AddScaled) writes into a matrix the caller already owns, and is what an
// iterative solver wants: a conjugate-gradient step running to convergence
// through the allocating forms spends more time in the allocator than in the
// arithmetic.
//
// Shape rules follow NumPy where NumPy is unambiguous and refuse to guess
// where it is not. Two matrices of the same shape combine elementwise. A
// matrix and a scalar combine elementwise. A matrix and a vector combine only
// through the explicitly named broadcast helpers (AddRowVector and friends),
// never implicitly, because implicit broadcasting silently turns a shape bug
// into a plausible wrong answer.
//
// A shape mismatch returns a 0x0 matrix rather than panicking. Callers that
// want the check up front have same_shape; callers that do not care can chain
// operations and test the final shape once, since 0x0 propagates.

func _elem_ok(x &: Matrix, y &: Matrix): bool:
    if x.rows != y.rows: ret false end
    if x.cols != y.cols: ret false end
    ret true
end

// Every same-shape binary op is this loop with a different operator, so the
// four of them share one dispatch rather than four near-identical bodies.
// op: 0 add, 1 subtract, 2 multiply, 3 divide.
func _zip(x &: Matrix, y &: Matrix, op: int): Matrix:
    if _elem_ok(x, y) == false: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, x.cols)
    repeat x.count() with k:
        r.a.set(k, _apply_op(x.a.get(k), y.a.get(k), op))
    end
    ret r
end

func _apply_op(u: f64, v: f64, op: int): f64:
    if op == 0: ret u + v end
    if op == 1: ret u - v end
    if op == 2: ret u * v end
    if v == 0.0: ret 0.0 end
    ret u / v
end

@en "Add"
@fa "جمع"
@ar "جمع"
pub func Add(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 0) end

@en "Sub"
@fa "تفریق"
@ar "طرح"
pub func Sub(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 1) end

// The Hadamard (entrywise) product, NumPy's `*`. Not matrix multiplication,
// which is MatMul.
@en "MulElem"
@fa "ضرب درایه‌ای"
@ar "ضرب عنصري"
pub func MulElem(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 2) end

// Entrywise division. Division by zero yields 0 rather than an infinity, so
// a single dead entry cannot poison a later reduction with a NaN.
@en "DivElem"
@fa "تقسیم درایه‌ای"
@ar "قسمة عنصرية"
pub func DivElem(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 3) end

@en "Neg"
@fa "قرینه"
@ar "سالب"
pub func Neg(x &: Matrix): Matrix: ret Scale(x, 0.0 - 1.0) end

@en "AddScalar"
@fa "جمع با عدد"
@ar "جمع عدد"
pub func AddScalar(x &: Matrix, s: f64): Matrix:
    mut r := Clone(x)
    AddScalarInPlace(r, s)
    ret r
end

@en "SubScalar"
@fa "تفریق عدد"
@ar "طرح عدد"
pub func SubScalar(x &: Matrix, s: f64): Matrix: ret AddScalar(x, 0.0 - s) end

@en "Scale"
@fa "مقیاس"
@ar "ضرب بعدد"
pub func Scale(x &: Matrix, s: f64): Matrix:
    mut r := Clone(x)
    ScaleInPlace(r, s)
    ret r
end

@en "DivScalar"
@fa "تقسیم بر عدد"
@ar "قسمة على عدد"
pub func DivScalar(x &: Matrix, s: f64): Matrix:
    if s == 0.0: ret Zeros(x.rows, x.cols) end
    ret Scale(x, 1.0 / s)
end

@en "AddInPlace"
@fa "جمع درجا"
@ar "جمع في المكان"
pub func AddInPlace(dst &: Matrix, src &: Matrix):
    if _elem_ok(dst, src) == false: ret end
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) + src.a.get(k)) end
end

@en "SubInPlace"
@fa "تفریق درجا"
@ar "طرح في المكان"
pub func SubInPlace(dst &: Matrix, src &: Matrix):
    if _elem_ok(dst, src) == false: ret end
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) - src.a.get(k)) end
end

@en "MulElemInPlace"
@fa "ضرب درایه‌ای درجا"
@ar "ضرب عنصري في المكان"
pub func MulElemInPlace(dst &: Matrix, src &: Matrix):
    if _elem_ok(dst, src) == false: ret end
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) * src.a.get(k)) end
end

@en "ScaleInPlace"
@fa "مقیاس درجا"
@ar "ضرب بعدد في المكان"
pub func ScaleInPlace(dst &: Matrix, s: f64):
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) * s) end
end

@en "AddScalarInPlace"
@fa "جمع عدد درجا"
@ar "جمع عدد في المكان"
pub func AddScalarInPlace(dst &: Matrix, s: f64):
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) + s) end
end

@en "NegInPlace"
@fa "قرینه درجا"
@ar "سالب في المكان"
pub func NegInPlace(dst &: Matrix): ScaleInPlace(dst, 0.0 - 1.0) end

// dst = dst + alpha * src, the BLAS axpy. The one kernel an iterative method
// runs more than any other, and the reason the in-place family exists: it
// updates a residual without allocating anything.
@en "AddScaled"
@fa "جمع مقیاس‌دار"
@ar "جمع موزون"
pub func AddScaled(dst &: Matrix, src &: Matrix, alpha: f64):
    if _elem_ok(dst, src) == false: ret end
    repeat dst.count() with k:
        dst.a.set(k, dst.a.get(k) + alpha * src.a.get(k))
    end
end

// The affine combination a*x + b*y, allocating. Covers the "subtract a scaled
// vector" step that shows up in every orthogonalization here.
@en "Combine"
@fa "ترکیب"
@ar "تركيب"
pub func Combine(x &: Matrix, a: f64, y &: Matrix, b: f64): Matrix:
    if _elem_ok(x, y) == false: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, x.cols)
    repeat x.count() with k:
        r.a.set(k, a * x.a.get(k) + b * y.a.get(k))
    end
    ret r
end

// Entrywise max of two matrices, NumPy's maximum. Pairwise, not a reduction:
// the reduction is Max in mat_reduce.
@en "MaxElem"
@fa "بیشینه درایه‌ای"
@ar "أكبر عنصري"
pub func MaxElem(x &: Matrix, y &: Matrix): Matrix:
    if _elem_ok(x, y) == false: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, x.cols)
    repeat x.count() with k:
        u := x.a.get(k)
        v := y.a.get(k)
        if u > v: r.a.set(k, u) else: r.a.set(k, v) end
    end
    ret r
end

@en "MinElem"
@fa "کمینه درایه‌ای"
@ar "أصغر عنصري"
pub func MinElem(x &: Matrix, y &: Matrix): Matrix:
    if _elem_ok(x, y) == false: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, x.cols)
    repeat x.count() with k:
        u := x.a.get(k)
        v := y.a.get(k)
        if u < v: r.a.set(k, u) else: r.a.set(k, v) end
    end
    ret r
end

// Broadcasting, spelled out. `row` must be 1xcols and is added to every row;
// `col` must be rowsx1 and is added to every column. Anything else is a shape
// error and returns 0x0.
@en "AddRowVector"
@fa "جمع بردار سطری"
@ar "جمع متجه صفي"
pub func AddRowVector(x &: Matrix, row &: Matrix): Matrix:
    if row.rows != 1 || row.cols != x.cols: ret Zeros(0, 0) end
    mut r := Clone(x)
    repeat x.rows with i:
        repeat x.cols with j: r.add_at(i, j, row.at(0, j)) end
    end
    ret r
end

@en "AddColVector"
@fa "جمع بردار ستونی"
@ar "جمع متجه عمودي"
pub func AddColVector(x &: Matrix, col &: Matrix): Matrix:
    if col.cols != 1 || col.rows != x.rows: ret Zeros(0, 0) end
    mut r := Clone(x)
    repeat x.rows with i:
        repeat x.cols with j: r.add_at(i, j, col.at(i, 0)) end
    end
    ret r
end

@en "MulRowVector"
@fa "ضرب بردار سطری"
@ar "ضرب متجه صفي"
pub func MulRowVector(x &: Matrix, row &: Matrix): Matrix:
    if row.rows != 1 || row.cols != x.cols: ret Zeros(0, 0) end
    mut r := Clone(x)
    repeat x.rows with i:
        repeat x.cols with j: r.mul_at(i, j, row.at(0, j)) end
    end
    ret r
end

@en "MulColVector"
@fa "ضرب بردار ستونی"
@ar "ضرب متجه عمودي"
pub func MulColVector(x &: Matrix, col &: Matrix): Matrix:
    if col.cols != 1 || col.rows != x.rows: ret Zeros(0, 0) end
    mut r := Clone(x)
    repeat x.rows with i:
        repeat x.cols with j: r.mul_at(i, j, col.at(i, 0)) end
    end
    ret r
end
