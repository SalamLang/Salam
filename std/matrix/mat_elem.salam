package matrix

func _elem_ok(x &: Matrix, y &: Matrix): bool:
    if x.rows != y.rows: ret false end
    if x.cols != y.cols: ret false end
    ret true
end

func _zip(x &: Matrix, y &: Matrix, op: int): Matrix:
    if _elem_ok(x, y) == false: ret Zeros(0, 0) end
    r := _raw(x.rows, x.cols)
    n := x.count()
    if n <= 0: ret r end
    px := x.a.data
    py := y.a.data
    pr := r.a.data
    if op == 0:
        repeat n with k: pr[k] = px[k] + py[k] end
    else op == 1:
        repeat n with k: pr[k] = px[k] - py[k] end
    else op == 2:
        repeat n with k: pr[k] = px[k] * py[k] end
    else:
        repeat n with k:
            v := py[k]
            if v == 0.0: pr[k] = 0.0
            else:
                pr[k] = px[k] / v
            end
        end
    end
    ret r
end

@en "Add"
@fa "جمع"
pub func Add(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 0) end

@en "Sub"
@fa "تفریق"
pub func Sub(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 1) end

@en "MulElem"
@fa "ضرب درایه‌ای"
pub func MulElem(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 2) end

@en "DivElem"
@fa "تقسیم درایه‌ای"
pub func DivElem(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 3) end

@en "Neg"
@fa "قرینه"
pub func Neg(x &: Matrix): Matrix: ret Scale(x, 0.0 - 1.0) end

@en "AddScalar"
@fa "جمع با عدد"
pub func AddScalar(x &: Matrix, s: f64): Matrix:
    mut r := Clone(x)
    AddScalarInPlace(r, s)
    ret r
end

@en "SubScalar"
@fa "تفریق عدد"
pub func SubScalar(x &: Matrix, s: f64): Matrix: ret AddScalar(x, 0.0 - s) end

@en "Scale"
@fa "مقیاس"
pub func Scale(x &: Matrix, s: f64): Matrix:
    mut r := Clone(x)
    ScaleInPlace(r, s)
    ret r
end

@en "DivScalar"
@fa "تقسیم بر عدد"
pub func DivScalar(x &: Matrix, s: f64): Matrix:
    if s == 0.0: ret Zeros(x.rows, x.cols) end
    ret Scale(x, 1.0 / s)
end

@en "AddInPlace"
@fa "جمع درجا"
pub func AddInPlace(dst &: Matrix, src &: Matrix):
    if _elem_ok(dst, src) == false: ret end
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) + src.a.get(k)) end
end

@en "SubInPlace"
@fa "تفریق درجا"
pub func SubInPlace(dst &: Matrix, src &: Matrix):
    if _elem_ok(dst, src) == false: ret end
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) - src.a.get(k)) end
end

@en "MulElemInPlace"
@fa "ضرب درایه‌ای درجا"
pub func MulElemInPlace(dst &: Matrix, src &: Matrix):
    if _elem_ok(dst, src) == false: ret end
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) * src.a.get(k)) end
end

@en "ScaleInPlace"
@fa "مقیاس درجا"
pub func ScaleInPlace(dst &: Matrix, s: f64):
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) * s) end
end

@en "AddScalarInPlace"
@fa "جمع عدد درجا"
pub func AddScalarInPlace(dst &: Matrix, s: f64):
    repeat dst.count() with k: dst.a.set(k, dst.a.get(k) + s) end
end

@en "NegInPlace"
@fa "قرینه درجا"
pub func NegInPlace(dst &: Matrix): ScaleInPlace(dst, 0.0 - 1.0) end

@en "AddScaled"
@fa "جمع مقیاس‌دار"
pub func AddScaled(dst &: Matrix, src &: Matrix, alpha: f64):
    if _elem_ok(dst, src) == false: ret end
    repeat dst.count() with k:
        dst.a.set(k, dst.a.get(k) + alpha * src.a.get(k))
    end
end

@en "Combine"
@fa "ترکیب"
pub func Combine(x &: Matrix, a: f64, y &: Matrix, b: f64): Matrix:
    if _elem_ok(x, y) == false: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, x.cols)
    repeat x.count() with k:
        r.a.set(k, a * x.a.get(k) + b * y.a.get(k))
    end
    ret r
end

@en "MaxElem"
@fa "بیشینه درایه‌ای"
pub func MaxElem(x &: Matrix, y &: Matrix): Matrix:
    if _elem_ok(x, y) == false: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, x.cols)
    repeat x.count() with k:
        u := x.a.get(k)
        v := y.a.get(k)
        if u > v:
            r.a.set(k, u)
        else:
            r.a.set(k, v)
        end
    end
    ret r
end

@en "MinElem"
@fa "کمینه درایه‌ای"
pub func MinElem(x &: Matrix, y &: Matrix): Matrix:
    if _elem_ok(x, y) == false: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, x.cols)
    repeat x.count() with k:
        u := x.a.get(k)
        v := y.a.get(k)
        if u < v:
            r.a.set(k, u)
        else:
            r.a.set(k, v)
        end
    end
    ret r
end

@en "AddRowVector"
@fa "جمع بردار سطری"
pub func AddRowVector(x &: Matrix, row &: Matrix): Matrix:
    if row.rows != 1 || row.cols != x.cols: ret Zeros(0, 0) end
    mut r := Clone(x)
    repeat x.rows with i:
        repeat x.cols with j: r.add_at(i, j, row.at(0, j)) end
    end
    ret r
end

@en "AddColVector"
@fa "جمع بردار ستونی"
pub func AddColVector(x &: Matrix, col &: Matrix): Matrix:
    if col.cols != 1 || col.rows != x.rows: ret Zeros(0, 0) end
    mut r := Clone(x)
    repeat x.rows with i:
        repeat x.cols with j: r.add_at(i, j, col.at(i, 0)) end
    end
    ret r
end

@en "MulRowVector"
@fa "ضرب بردار سطری"
pub func MulRowVector(x &: Matrix, row &: Matrix): Matrix:
    if row.rows != 1 || row.cols != x.cols: ret Zeros(0, 0) end
    mut r := Clone(x)
    repeat x.rows with i:
        repeat x.cols with j: r.mul_at(i, j, row.at(0, j)) end
    end
    ret r
end

@en "MulColVector"
@fa "ضرب بردار ستونی"
pub func MulColVector(x &: Matrix, col &: Matrix): Matrix:
    if col.cols != 1 || col.rows != x.rows: ret Zeros(0, 0) end
    mut r := Clone(x)
    repeat x.rows with i:
        repeat x.cols with j: r.mul_at(i, j, col.at(i, 0)) end
    end
    ret r
end
