package matrix

import conv
import math

// Turning a matrix into text.
//
// Columns are right-aligned to a common width computed from the widest
// rendered entry, because a matrix printed in ragged columns is unreadable
// and reading it is the only reason to print one.
//
// Negative zero is normalized to zero. It arises constantly (any 0.0 - x with
// x zero produces it, and elimination produces plenty), it compares equal to
// zero so no test catches it, and it prints as "-0.000", which makes a
// perfectly clean triangular factor look broken.

func _entry(v: f64, prec: int): str:
    mut x := v
    if x == 0.0: x = 0.0 end  // collapses -0.0, which prints as "-0.000"
    if math.IsNaN(x): ret "nan" end
    if math.IsInf(x): ret _inf_text(x) end
    ret conv.FormatFloatPrec(x, prec)
end

func _inf_text(x: f64): str:
    if x < 0.0: ret "-inf" end
    ret "inf"
end

func _width_of(x &: Matrix, prec: int): int:
    mut w := 1
    repeat x.count() with k:
        n := _entry(x.a.get(k), prec).len()
        if n > w: w = n end
    end
    ret w
end

func _pad(s: str, width: int): str:
    mut out := ""
    mut n := width - s.len()
    until n > 0:
        out = out + " "
        n -= 1
    end
    ret out + s
end

func _row_text(x &: Matrix, i: int, prec: int, width: int): str:
    mut line := ""
    repeat x.cols with j:
        if j > 0: line = line + " " end
        line = line + _pad(_entry(x.at(i, j), prec), width)
    end
    ret line
end

func _csv_row(x &: Matrix, i: int, prec: int): str:
    mut line := ""
    repeat x.cols with j:
        if j > 0: line = line + "," end
        line = line + _entry(x.at(i, j), prec)
    end
    ret line
end

// The matrix as a multi-line string, one line per row, with `prec` digits
// after the decimal point.
@en "ToStringPrec"
@fa "به رشته با دقت"
@ar "إلى نص بدقة"
pub func ToStringPrec(x &: Matrix, prec: int): str:
    if x.is_empty(): ret "[]" end
    w := _width_of(x, prec)
    mut out := ""
    repeat x.rows with i:
        if i > 0: out = out + "\n" end
        out = out + _row_text(x, i, prec, w)
    end
    ret out
end

// The matrix at four decimal places, which is enough to read and short enough
// to fit.
@en "ToString"
@fa "به رشته"
@ar "إلى نص"
pub func ToString(x &: Matrix): str: ret ToStringPrec(x, 4) end

// The shape as "rows x cols".
@en "ShapeString"
@fa "رشته شکل"
@ar "نص الشكل"
pub func ShapeString(x &: Matrix): str:
    ret conv.FormatInt(x.rows as i64) + "x" + conv.FormatInt(x.cols as i64)
end

// Prints the matrix, one row per line.
@en "Print"
@fa "چاپ"
@ar "طباعة"
pub func Print(x &: Matrix): println ToString(x) end

@en "PrintPrec"
@fa "چاپ با دقت"
@ar "طباعة بدقة"
pub func PrintPrec(x &: Matrix, prec: int): println ToStringPrec(x, prec) end

// Prints a labelled matrix with its shape, the form that makes a debugging
// session readable.
@en "PrintLabeled"
@fa "چاپ برچسب‌دار"
@ar "طباعة موسومة"
pub func PrintLabeled(label: str, x &: Matrix):
    println label + " (" + ShapeString(x) + ")"
    println ToString(x)
end

// Comma separated, one row per line: the format every spreadsheet and every
// other numerical tool will read.
@en "ToCSV"
@fa "به سی‌اس‌وی"
@ar "إلى سي إس في"
pub func ToCSV(x &: Matrix, prec: int): str:
    mut out := ""
    repeat x.rows with i:
        if i > 0: out = out + "\n" end
        out = out + _csv_row(x, i, prec)
    end
    ret out
end

// A single-line form, the way a matrix literal is written in source: rows in
// brackets, separated by semicolons.
@en "ToRepr"
@fa "به بازنمایی"
@ar "إلى تمثيل"
pub func ToRepr(x &: Matrix, prec: int): str:
    mut out := "["
    repeat x.rows with i:
        if i > 0: out = out + "; " end
        out = out + _csv_row(x, i, prec)
    end
    ret out + "]"
end
