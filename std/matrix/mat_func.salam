package matrix

import math

const _PADE_Q := 6
const _EXPM_MAX_SQUARINGS := 60
const _SQRTM_MAX_ITER := 60
const _SIGN_MAX_ITER := 100

func _pade_coeff(k: int, q: int): f64:
    mut c := 1.0
    mut i := 1
    until i <= k:
        c = c * ((q - i + 1) as f64) / (((2 * q - i + 1) * i) as f64)
        i += 1
    end
    ret c
end

func _expm_squarings(x &: Matrix): int:
    nrm := NormInf(x)
    mut s := 0
    mut v := nrm
    until v > 0.5 && s < _EXPM_MAX_SQUARINGS:
        v = v * 0.5
        s += 1
    end
    ret s
end

func _pade_accumulate(a &: Matrix, num &: Matrix, den &: Matrix, n: int):
    mut power := Eye(n)
    mut k := 1
    until k <= _PADE_Q:
        t := MatMul(power, a)
        power.free()
        power = t
        c := _pade_coeff(k, _PADE_Q)
        AddScaled(num, power, c)
        mut sign := c
        if k % 2 == 1: sign = 0.0 - c end
        AddScaled(den, power, sign)
        k += 1
    end
    defer power.free()
end

func _db_step(y &: Matrix, z &: Matrix):
    mut yi := Inverse(y)
    mut zi := Inverse(z)
    if yi.is_empty() || zi.is_empty():
        yi.free()
        zi.free()
        ret
    end
    mut ny := Combine(y, 0.5, zi, 0.5)
    mut nz := Combine(z, 0.5, yi, 0.5)
    CopyInto(y, ny)
    CopyInto(z, nz)
    defer yi.free()
    defer zi.free()
    defer ny.free()
    defer nz.free()
end

func _converged(a &: Matrix, b &: Matrix, tol: f64): bool:
    d := Distance(a, b)
    scale := NormFrobenius(b)
    if scale == 0.0: ret d <= tol end
    ret d <= tol * scale
end

func _pade_core(a &: Matrix, n: int): Matrix:
    mut num := Eye(n)
    mut den := Eye(n)
    _pade_accumulate(a, num, den, n)
    mut r := Solve(den, num)
    defer num.free()
    defer den.free()
    if r.is_empty(): ret Eye(n) end
    ret r
end

func _square_in_place(r &: Matrix):
    mut t := MatMul(r, r)
    CopyInto(r, t)
    defer t.free()
end

func _log_eigval(f &: EigenSym, k: int):
    v := f.values.a.get(k)
    if v <= 0.0:
        f.values.a.set(k, math.NaN())
        ret
    end
    f.values.a.set(k, math.Log(v))
end

@en "Expm"
@fa "نمایی ماتریسی"
pub func Expm(x &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    n := x.rows
    s := _expm_squarings(x)
    mut a := Scale(x, math.Pow(0.5, s as f64))
    mut r := _pade_core(a, n)
    defer a.free()
    repeat s: _square_in_place(r) end
    ret r
end

@en "Sqrtm"
@fa "جذر ماتریسی"
pub func Sqrtm(x &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    mut y := Clone(x)
    mut z := Eye(x.rows)
    mut prev := Clone(y)
    mut i := 0
    until i < _SQRTM_MAX_ITER:
        _db_step(y, z)
        if _converged(prev, y, MAT_TOL): break end
        CopyInto(prev, y)
        i += 1
    end
    defer z.free()
    defer prev.free()
    ret y
end

@en "MatrixSign"
@fa "علامت ماتریسی"
pub func MatrixSign(x &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    mut s := Clone(x)
    mut prev := Clone(x)
    mut i := 0
    until i < _SIGN_MAX_ITER:
        mut inv := Inverse(s)
        if inv.is_empty(): break end
        mut nx := Combine(s, 0.5, inv, 0.5)
        CopyInto(s, nx)
        inv.free()
        nx.free()
        if _converged(prev, s, MAT_TOL): break end
        CopyInto(prev, s)
        i += 1
    end
    defer prev.free()
    ret s
end

@en "PolyEval"
@fa "ارزیابی چندجمله‌ای"
pub func PolyEval(x &: Matrix, coeffs &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    n := coeffs.count()
    if n == 0: ret Zeros(x.rows, x.cols) end
    mut acc := Full(x.rows, x.cols, 0.0)
    ShiftDiagonal(acc, coeffs.a.get(n - 1))
    mut k := n - 2
    until k >= 0:
        mut t := MatMul(acc, x)
        ShiftDiagonal(t, coeffs.a.get(k))
        CopyInto(acc, t)
        t.free()
        k -= 1
    end
    ret acc
end

@en "CayleyHamilton"
@fa "کیلی همیلتون"
pub func CayleyHamilton(x &: Matrix): Matrix:
    mut p := CharPoly(x)
    r := PolyEval(x, p)
    defer p.free()
    ret r
end

@en "LogmSym"
@fa "لگاریتم متقارن"
pub func LogmSym(x &: Matrix): Matrix:
    if IsSymmetric(x, MAT_TOL) == false: ret Zeros(0, 0) end
    mut f := EigSym(x)
    mut ok := true
    repeat f.values.count() with k: _log_eigval(f, k) end
    repeat f.values.count() with k:
        if math.IsNaN(f.values.a.get(k)): ok = false end
    end
    mut r := EigReconstruct(f)
    defer f.free()
    if ok: ret r end
    defer r.free()
    ret Zeros(0, 0)
end
