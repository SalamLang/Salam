package matrix

import math

@en "LU"
@fa "تجزیه پایین بالا"
pub struct LU:
    pub n: int = 0
    pub lu: Matrix = Matrix {}
    pub piv: Vector<int> = Vector {}
    pub sign: int = 1
    pub singular: bool = false

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.lu.free()
        this.piv.free()
    end
end

func _lu_pivot(m &: Matrix, k: int, n: int): int:
    mut best := k
    mut bv := math.Abs(m.at(k, k))
    mut i := k + 1
    until i < n:
        v := math.Abs(m.at(i, k))
        if v > bv:
            bv = v
            best = i
        end
        i += 1
    end
    ret best
end

func _lu_swap(m &: Matrix, piv &: Vector<int>, i: int, j: int):
    repeat m.cols with c:
        t := m.at(i, c)
        m.set(i, c, m.at(j, c))
        m.set(j, c, t)
    end
    t := piv.get(i)
    piv.set(i, piv.get(j))
    piv.set(j, t)
end

func _lu_eliminate(m &: Matrix, k: int, n: int):
    pk := m.at(k, k)
    mut i := k + 1
    until i < n:
        f := m.at(i, k) / pk
        m.set(i, k, f)
        if f != 0.0:
            mut j := k + 1
            until j < n:
                m.set(i, j, m.at(i, j) - f * m.at(k, j))
                j += 1
            end
        end
        i += 1
    end
end

func _lu_forward(l &: Matrix, b &: Matrix, n: int):
    repeat b.cols with c:
        repeat n with i:
            mut s := b.at(i, c)
            repeat i with j: s -= l.at(i, j) * b.at(j, c) end
            b.set(i, c, s)
        end
    end
end

func _lu_backward(u &: Matrix, b &: Matrix, n: int):
    repeat b.cols with c:
        mut i := n - 1
        until i >= 0:
            mut s := b.at(i, c)
            mut j := i + 1
            until j < n:
                s -= u.at(i, j) * b.at(j, c)
                j += 1
            end
            b.set(i, c, s / u.at(i, i))
            i -= 1
        end
    end
end

func _lu_permute(f &: LU, b &: Matrix): Matrix:
    mut r := Zeros(b.rows, b.cols)
    repeat b.rows with i:
        src := f.piv.get(i)
        repeat b.cols with c: r.set(i, c, b.at(src, c)) end
    end
    ret r
end

func _lu_tiny(x &: Matrix): f64:
    mut mx := 0.0
    repeat x.count() with k:
        v := math.Abs(x.a.get(k))
        if v > mx: mx = v end
    end
    if mx == 0.0: ret MAT_EPS end
    ret mx * MAT_EPS * (x.rows as f64) * 8.0
end

func _det_small(x &: Matrix): f64:
    if x.rows == 1: ret x.at(0, 0) end
    if x.rows == 2: ret x.at(0, 0) * x.at(1, 1) - x.at(0, 1) * x.at(1, 0) end
    a := x.at(0, 0) * (x.at(1, 1) * x.at(2, 2) - x.at(1, 2) * x.at(2, 1))
    b := x.at(0, 1) * (x.at(1, 0) * x.at(2, 2) - x.at(1, 2) * x.at(2, 0))
    c := x.at(0, 2) * (x.at(1, 0) * x.at(2, 1) - x.at(1, 1) * x.at(2, 0))
    ret a - b + c
end

func _lu_step(f &: LU, k: int, n: int, tiny: f64):
    p := _lu_pivot(f.lu, k, n)
    if p != k:
        _lu_swap(f.lu, f.piv, k, p)
        f.sign = 0 - f.sign
    end
    if math.Abs(f.lu.at(k, k)) <= tiny:
        f.singular = true
        ret
    end
    _lu_eliminate(f.lu, k, n)
end

func _det_from(f &: LU): f64:
    mut d := f.sign as f64
    repeat f.n with i: d = d * f.lu.at(i, i) end
    ret d
end

func _cofactor(x &: Matrix, i: int, j: int): f64:
    mut sub := Minor(x, i, j)
    d := Det(sub)
    defer sub.free()
    if (i + j) % 2 == 1: ret 0.0 - d end
    ret d
end

@en "Decompose"
@fa "تجزیه"
pub func Decompose(x &: Matrix): LU:
    mut f := LU {}
    if x.is_square() == false: ret f end
    n := x.rows
    f.n = n
    f.lu = Clone(x)
    repeat n with i: f.piv.push(i) end
    tiny := _lu_tiny(x)
    repeat n with k: _lu_step(f, k, n, tiny) end
    ret f
end

@en "Det"
@fa "دترمینان"
pub func Det(x &: Matrix): f64:
    if x.is_square() == false: ret 0.0 end
    if x.rows == 0: ret 1.0 end
    if x.rows <= 3: ret _det_small(x) end
    mut f := Decompose(x)
    mut d := 0.0
    if f.singular == false: d = _det_from(f) end
    defer f.free()
    ret d
end

@en "LogAbsDet"
@fa "لگاریتم قدرمطلق دترمینان"
pub func LogAbsDet(x &: Matrix): f64:
    if x.is_square() == false: ret 0.0 end
    mut f := Decompose(x)
    mut s := 0.0
    if f.singular: s = 0.0 - MAT_INF end
    if f.singular == false:
        repeat f.n with i: s += math.Log(math.Abs(f.lu.at(i, i))) end
    end
    defer f.free()
    ret s
end

@en "Solve"
@fa "حل"
pub func Solve(a &: Matrix, b &: Matrix): Matrix:
    if a.is_square() == false || a.rows != b.rows: ret Zeros(0, 0) end
    mut f := Decompose(a)
    r := LUSolve(f, b)
    defer f.free()
    ret r
end

@en "LUSolve"
@fa "حل با تجزیه"
pub func LUSolve(f &: LU, b &: Matrix): Matrix:
    if f.singular || f.n != b.rows: ret Zeros(0, 0) end
    mut r := _lu_permute(f, b)
    _lu_forward(f.lu, r, f.n)
    _lu_backward(f.lu, r, f.n)
    ret r
end

@en "SolveVec"
@fa "حل برداری"
pub func SolveVec(a &: Matrix, b &: Matrix): Matrix:
    if b.cols != 1: ret Zeros(0, 0) end
    ret Solve(a, b)
end

@en "Inverse"
@fa "وارون"
pub func Inverse(x &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    mut id := Eye(x.rows)
    r := Solve(x, id)
    defer id.free()
    ret r
end

@en "Adjugate"
@fa "الحاقی"
pub func Adjugate(x &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    n := x.rows
    mut r := Zeros(n, n)
    repeat n with i:
        repeat n with j: r.set(j, i, _cofactor(x, i, j)) end
    end
    ret r
end
