package matrix

import math

// LU factorization with partial pivoting: PA = LU, with L unit lower
// triangular and U upper triangular. The workhorse behind Det, Inverse and
// Solve for a general square matrix.
//
// Partial pivoting is not optional. Without it, elimination divides by
// whatever happens to sit on the diagonal, and a matrix as harmless as
// [[0,1],[1,0]] breaks immediately while [[1e-20,1],[1,1]] returns an answer
// that is wrong in every digit. Choosing the largest available pivot in the
// column bounds the multipliers by 1, and that single property is what makes
// Gaussian elimination usable in floating point.
//
// L and U share one matrix, as they always do: L's diagonal is known to be
// all ones and is never stored, so the strict lower triangle holds L and the
// upper triangle including the diagonal holds U. The permutation is a vector
// of row indices, not a matrix, since applying it is a gather and multiplying
// by it would be O(n^3) for something that is O(n).
//
// Singularity is reported, not thrown. A factorization whose pivot collapses
// sets `singular` and keeps going, so Det can honestly return 0 and Solve can
// return an empty matrix rather than the library deciding to abort a caller's
// program over a legitimate input.

@en "LU"
@fa "تجزیه پایین بالا"
@ar "تحليل مثلثي"
pub struct LU:
    pub n: int = 0
    pub lu: Matrix = Matrix {}
    pub piv: Vector<int> = Vector {}
    pub sign: int = 1
    pub singular: bool = false

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        this.lu.free()
        this.piv.free()
    end
end

// The row in k..n-1 with the largest magnitude in column k. Largest, not
// merely nonzero: the size of the pivot is what bounds the growth of every
// multiplier formed against it.
func _lu_pivot(m &: Matrix, k: int, n: int): int:
    mut best := k
    mut bv := math.Abs(m.at(k, k))
    mut i := k + 1
    until i < n:
        v := math.Abs(m.at(i, k))
        if v > bv:
            bv = v
            best = i
        end
        i += 1
    end
    ret best
end

func _lu_swap(m &: Matrix, piv &: Vector<int>, i: int, j: int):
    repeat m.cols with c:
        t := m.at(i, c)
        m.set(i, c, m.at(j, c))
        m.set(j, c, t)
    end
    t := piv.get(i)
    piv.set(i, piv.get(j))
    piv.set(j, t)
end

// One elimination step: scale the sub-column below the pivot into L, then
// subtract its outer product with the pivot row from the trailing block. The
// inner loop runs along a row, which is the contiguous direction.
func _lu_eliminate(m &: Matrix, k: int, n: int):
    pk := m.at(k, k)
    mut i := k + 1
    until i < n:
        f := m.at(i, k) / pk
        m.set(i, k, f)
        if f != 0.0:
            mut j := k + 1
            until j < n:
                m.set(i, j, m.at(i, j) - f * m.at(k, j))
                j += 1
            end
        end
        i += 1
    end
end

// Forward substitution against unit lower triangular L, in place, one column
// of the right-hand side at a time.
func _lu_forward(l &: Matrix, b &: Matrix, n: int):
    repeat b.cols with c:
        repeat n with i:
            mut s := b.at(i, c)
            repeat i with j: s -= l.at(i, j) * b.at(j, c) end
            b.set(i, c, s)
        end
    end
end

// Back substitution against U, in place.
func _lu_backward(u &: Matrix, b &: Matrix, n: int):
    repeat b.cols with c:
        mut i := n - 1
        until i >= 0:
            mut s := b.at(i, c)
            mut j := i + 1
            until j < n:
                s -= u.at(i, j) * b.at(j, c)
                j += 1
            end
            b.set(i, c, s / u.at(i, i))
            i -= 1
        end
    end
end

// Gathers the rows of b in pivot order, producing P b.
func _lu_permute(f &: LU, b &: Matrix): Matrix:
    mut r := Zeros(b.rows, b.cols)
    repeat b.rows with i:
        src := f.piv.get(i)
        repeat b.cols with c: r.set(i, c, b.at(src, c)) end
    end
    ret r
end

// The scale a pivot has to beat to count as nonzero: relative to the largest
// entry of the original matrix, never absolute. An absolute threshold calls
// a perfectly good matrix scaled by 1e-30 singular, and a badly conditioned
// matrix scaled by 1e30 invertible.
func _lu_tiny(x &: Matrix): f64:
    mut mx := 0.0
    repeat x.count() with k:
        v := math.Abs(x.a.get(k))
        if v > mx: mx = v end
    end
    if mx == 0.0: ret MAT_EPS end
    ret mx * MAT_EPS * (x.rows as f64) * 8.0
end

// Exact determinants for the sizes where a closed form exists. Worth having:
// the 2x2 and 3x3 formulas are not just faster, they are exact on integer
// input, where elimination would divide and round.
func _det_small(x &: Matrix): f64:
    if x.rows == 1: ret x.at(0, 0) end
    if x.rows == 2: ret x.at(0, 0) * x.at(1, 1) - x.at(0, 1) * x.at(1, 0) end
    a := x.at(0, 0) * (x.at(1, 1) * x.at(2, 2) - x.at(1, 2) * x.at(2, 1))
    b := x.at(0, 1) * (x.at(1, 0) * x.at(2, 2) - x.at(1, 2) * x.at(2, 0))
    c := x.at(0, 2) * (x.at(1, 0) * x.at(2, 1) - x.at(1, 1) * x.at(2, 0))
    ret a - b + c
end

// One pivot-and-eliminate step of the outer factorization loop.
func _lu_step(f &: LU, k: int, n: int, tiny: f64):
    p := _lu_pivot(f.lu, k, n)
    if p != k:
        _lu_swap(f.lu, f.piv, k, p)
        f.sign = 0 - f.sign
    end
    if math.Abs(f.lu.at(k, k)) <= tiny:
        f.singular = true
        ret
    end
    _lu_eliminate(f.lu, k, n)
end

func _det_from(f &: LU): f64:
    mut d := f.sign as f64
    repeat f.n with i: d = d * f.lu.at(i, i) end
    ret d
end

// The (i,j) cofactor: the signed determinant of the matrix with row i and
// column j struck out.
func _cofactor(x &: Matrix, i: int, j: int): f64:
    mut sub := Minor(x, i, j)
    d := Det(sub)
    sub.free()
    if (i + j) % 2 == 1: ret 0.0 - d end
    ret d
end

@en "Decompose"
@fa "تجزیه"
@ar "تحليل"
pub func Decompose(x &: Matrix): LU:
    mut f := LU {}
    if x.is_square() == false: ret f end
    n := x.rows
    f.n = n
    f.lu = Clone(x)
    repeat n with i: f.piv.push(i) end
    tiny := _lu_tiny(x)
    repeat n with k: _lu_step(f, k, n, tiny) end
    ret f
end

// The determinant: the product of U's diagonal, signed by the number of row
// swaps. Sizes up to 3 take the closed form instead.
@en "Det"
@fa "دترمینان"
@ar "محدد"
pub func Det(x &: Matrix): f64:
    if x.is_square() == false: ret 0.0 end
    if x.rows == 0: ret 1.0 end
    if x.rows <= 3: ret _det_small(x) end
    mut f := Decompose(x)
    mut d := 0.0
    if f.singular == false: d = _det_from(f) end
    f.free()
    ret d
end

// log|det A|, which is the only form that survives a large matrix: the
// determinant of a 200x200 matrix with entries around 10 overflows f64 long
// before it means anything, while its logarithm is an ordinary number. The
// quantity statistics actually wants, in likelihoods and in entropies.
@en "LogAbsDet"
@fa "لگاریتم قدرمطلق دترمینان"
@ar "لوغاريتم المحدد"
pub func LogAbsDet(x &: Matrix): f64:
    if x.is_square() == false: ret 0.0 end
    mut f := Decompose(x)
    mut s := 0.0
    if f.singular: s = 0.0 - MAT_INF end
    if f.singular == false:
        repeat f.n with i: s += math.Log(math.Abs(f.lu.at(i, i))) end
    end
    f.free()
    ret s
end

// Solves A X = B for X, with B allowed to have any number of columns. An
// empty result means A was singular or the shapes disagreed.
@en "Solve"
@fa "حل"
@ar "حل"
pub func Solve(a &: Matrix, b &: Matrix): Matrix:
    if a.is_square() == false || a.rows != b.rows: ret Zeros(0, 0) end
    mut f := Decompose(a)
    r := LUSolve(f, b)
    f.free()
    ret r
end

// Reuses a factorization across many right-hand sides. Factoring costs
// O(n^3) and each solve costs O(n^2), so a caller with several b vectors
// should factor once and call this repeatedly rather than calling Solve in a
// loop.
@en "LUSolve"
@fa "حل با تجزیه"
@ar "حل بالتحليل"
pub func LUSolve(f &: LU, b &: Matrix): Matrix:
    if f.singular || f.n != b.rows: ret Zeros(0, 0) end
    mut r := _lu_permute(f, b)
    _lu_forward(f.lu, r, f.n)
    _lu_backward(f.lu, r, f.n)
    ret r
end

// Solves A x = b for a single column vector, the common case spelled out.
@en "SolveVec"
@fa "حل برداری"
@ar "حل متجهي"
pub func SolveVec(a &: Matrix, b &: Matrix): Matrix:
    if b.cols != 1: ret Zeros(0, 0) end
    ret Solve(a, b)
end

// A^-1, by solving A X = I.
//
// Worth saying plainly: if the goal is to solve A x = b, use Solve. Forming
// the inverse and multiplying costs three times as much and is less accurate,
// and the habit of writing inv(A)*b is the single most common way numerical
// code loses digits for no reason. The inverse is here because sometimes the
// inverse itself is the answer.
@en "Inverse"
@fa "وارون"
@ar "معكوس"
pub func Inverse(x &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    mut id := Eye(x.rows)
    r := Solve(x, id)
    id.free()
    ret r
end

// The adjugate (classical adjoint): the transpose of the cofactor matrix,
// which satisfies A adj(A) = det(A) I even when A is singular. Computed from
// the inverse where that is safe and from cofactors where it is not, so it
// stays correct on exactly the singular matrices that make it interesting.
@en "Adjugate"
@fa "الحاقی"
@ar "مصفوفة مرافقة"
pub func Adjugate(x &: Matrix): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    n := x.rows
    mut r := Zeros(n, n)
    repeat n with i:
        repeat n with j: r.set(j, i, _cofactor(x, i, j)) end
    end
    ret r
end
