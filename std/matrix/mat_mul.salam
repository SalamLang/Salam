package matrix

import mem

// Matrix products: the O(n^3) part of the library, and the only part where
// the memory layout shows up in the running time.
//
// The kernel is the ikj loop order, tiled. Two things follow from row-major
// storage, and both point the same way:
//
//   - In i-k-j order the inner loop reads a contiguous row of Y and writes a
//     contiguous row of R, with the scalar X(i,k) held in a register. Every
//     access is a sequential stream, so the hardware prefetcher gets it right
//     and there is no gather anywhere.
//   - The textbook i-j-k order instead walks a *column* of Y in the inner
//     loop, which strides by cols*8 bytes and touches a fresh cache line per
//     iteration. On anything that does not fit in L1 that costs several times
//     the ikj version, for identical arithmetic.
//
// Tiling on top of that bounds the working set: without it, the inner loop
// sweeps a full row of Y (cols*8 bytes) per k, so by the time k advances the
// front of that row has been evicted and every k re-reads it from memory.
// With a 64-wide tile the block of Y in play is 64*64*8 = 32KB, which is an
// L1 the size of what real hardware ships.
//
// The zero test in the middle loop is not a micro-optimization, it is what
// makes products involving triangular, banded, permutation and adjacency
// matrices cost what their sparsity says they should, and those are most of
// the matrices this library produces internally.

const _MAT_BLOCK := 64

// Square tile side for the transpose. 32x32 f64 is 8 KiB per tile, so the
// source tile and the destination tile together sit inside a 32 KiB L1.
const _T_BLOCK := 32

// Micro-kernel shape: 4 result rows by 4 result columns, so the 16 running
// sums are 4 AVX2 vectors and leave room for the operands. This is the number
// that decides whether the product runs at cache speed or at register speed:
// with the sums in memory the inner loop reloads and restores each one on
// every k, which is two memory operations per multiply-add.
const _MR := 4
const _NR := 4

// A pointer to element `off` of a payload, so an inner loop can subscript
// from 0 instead of carrying a row offset into every index expression.
inline func _row(p: f64*, off: int): f64*:
    ret (p as i64 + (off as i64) * (sizeof(f64) as i64)) as f64*
end

func _min2(a: int, b: int): int:
    if a < b: ret a end
    ret b
end

func _mm_end(start: int, limit: int): int:
    e := start + _MAT_BLOCK
    if e > limit: ret limit end
    ret e
end

// r(row ro, j0..j1) += v * y(row yo, j0..j1), addressed through the two
// payload pointers rather than through Matrix.at/add_at.
//
// The accessor form cost this loop far more than the one extra call it looks
// like. `r.add_at(i, j, ...)` re-reads r.cols and r.a.data on every
// iteration, and so does y.at(k, j), because a double store through one
// Matrix cannot be proven not to alias another Matrix's own fields - four
// loads and two integer multiplies per fused multiply-add, none of them
// removable. Passing the bases in as pointers makes the addresses
// loop-invariant, which is also what lets the vectoriser version the loop
// against a runtime overlap check instead of giving up.
// The subscript is a bare induction variable, and that detail is the whole
// point of the shape. Salam's `int` wraps modulo 2^32, so codegen emits every
// int add as `(int32_t)((uint32_t)a + (uint32_t)b)`; inside a subscript that
// is opaque to the vectoriser's dependence analysis, which needs the address
// to be an affine function of the induction variable. A `repeat` loop over a
// pointer already offset to the row start gives exactly that - the C backend
// emits it as `for (int64_t __rep = 0; ...)` and the loop vectorises. The
// same body written as `until j < j1` with `pr[ro + j]` does not.
func _mm_axpy(pr: f64*, v: f64, py: f64*, cnt: int):
    repeat cnt with t: pr[t] = pr[t] + v * py[t] end
end

func _mm_tile(r &: Matrix, x &: Matrix, y &: Matrix, ii: int, kk: int, jj: int):
    i1 := _mm_end(ii, r.rows)
    k1 := _mm_end(kk, x.cols)
    j1 := _mm_end(jj, r.cols)
    pr := r.a.data
    px := x.a.data
    py := y.a.data
    rc := r.cols
    xc := x.cols
    yc := y.cols
    cnt := j1 - jj
    mut i := ii
    until i < i1:
        xo := i * xc
        rrow := _row(pr, i * rc + jj)
        mut k := kk
        until k < k1:
            v := px[xo + k]
            // The zero test is what makes a sparse operand cost what its
            // sparsity says it should; it sits in the middle loop, not the
            // inner one, so it never blocks vectorisation.
            if v != 0.0: _mm_axpy(rrow, v, _row(py, k * yc + jj), cnt) end
            k += 1
        end
        i += 1
    end
end

// Copies y[k0..k1) x [j0..j0+_NR) into a contiguous k-major panel.
//
// Without this the micro-kernel would walk y down a column, one row stride per
// step, and touch a fresh cache line for every element it reads. Packed once
// per column block and then reused by every row block, the copy costs one pass
// over the panel and turns the kernel's y reads into sequential ones.
func _mm_pack_b(py: f64*, yc: int, k0: int, k1: int, j0: int, dst: f64*):
    mut k := k0
    mut o := 0
    until k < k1:
        src := _row(py, k * yc + j0)
        d := _row(dst, o)
        repeat _NR with t: d[t] = src[t] end
        o += _NR
        k += 1
    end
end

// The 4x4 micro-kernel. Sixteen running sums live in locals for the whole k
// loop and reach memory exactly once, at the end.
//
// The accumulation ORDER is unchanged from the row-at-a-time kernel this
// replaces: every c(i,j) still takes its k terms in increasing k, and the
// result matrix starts at zero, so adding the finished sum is the same
// sequence of additions the old loop performed one at a time. The products
// are therefore bit-for-bit what they were.
func _mm_micro(a0: f64*, a1: f64*, a2: f64*, a3: f64*, pb: f64*, kn: int, c0: f64*, c1: f64*, c2: f64*, c3: f64*):
    mut c00 := 0.0
    mut c01 := 0.0
    mut c02 := 0.0
    mut c03 := 0.0
    mut c10 := 0.0
    mut c11 := 0.0
    mut c12 := 0.0
    mut c13 := 0.0
    mut c20 := 0.0
    mut c21 := 0.0
    mut c22 := 0.0
    mut c23 := 0.0
    mut c30 := 0.0
    mut c31 := 0.0
    mut c32 := 0.0
    mut c33 := 0.0
    repeat kn with k:
        pbk := _row(pb, k * _NR)
        b0 := pbk[0]
        b1 := pbk[1]
        b2 := pbk[2]
        b3 := pbk[3]
        v0 := a0[k]
        c00 += v0 * b0
        c01 += v0 * b1
        c02 += v0 * b2
        c03 += v0 * b3
        v1 := a1[k]
        c10 += v1 * b0
        c11 += v1 * b1
        c12 += v1 * b2
        c13 += v1 * b3
        v2 := a2[k]
        c20 += v2 * b0
        c21 += v2 * b1
        c22 += v2 * b2
        c23 += v2 * b3
        v3 := a3[k]
        c30 += v3 * b0
        c31 += v3 * b1
        c32 += v3 * b2
        c33 += v3 * b3
    end
    c0[0] = c00
    c0[1] = c01
    c0[2] = c02
    c0[3] = c03
    c1[0] = c10
    c1[1] = c11
    c1[2] = c12
    c1[3] = c13
    c2[0] = c20
    c2[1] = c21
    c2[2] = c22
    c2[3] = c23
    c3[0] = c30
    c3[1] = c31
    c3[2] = c32
    c3[3] = c33
end

// The edge strip: any rows or columns the 4x4 kernel could not cover, done one
// dot product at a time. Correct for every shape, and only ever touches fewer
// than four rows or four columns, so its cost does not scale with n.
func _mm_edge(pr: f64*, rc: int, px: f64*, xc: int, py: f64*, yc: int, i0: int, i1: int, j0: int, j1: int, kn: int):
    mut i := i0
    until i < i1:
        xrow := _row(px, i * xc)
        crow := _row(pr, i * rc)
        mut j := j0
        until j < j1:
            mut acc := 0.0
            repeat kn with k: acc += xrow[k] * py[k * yc + j] end
            crow[j] = acc
            j += 1
        end
        i += 1
    end
end

func _mm_cols(r &: Matrix, x &: Matrix, y &: Matrix, ii: int, kk: int):
    mut jj := 0
    until jj < r.cols:
        _mm_tile(r, x, y, ii, kk, jj)
        jj += _MAT_BLOCK
    end
end

// Dot product of row xr of x with row yr of y, over the first n columns.
func _dot_rows(x &: Matrix, xr: int, y &: Matrix, yr: int, n: int): f64:
    mut s := 0.0
    repeat n with k: s += x.at(xr, k) * y.at(yr, k) end
    ret s
end

func _kron_block(r &: Matrix, s: f64, y &: Matrix, r0: int, c0: int):
    repeat y.rows with p:
        repeat y.cols with q: r.set(r0 + p, c0 + q, s * y.at(p, q)) end
    end
end

// A negative power is the positive power of the inverse, which is the only
// reading that keeps A^i A^j = A^(i+j) true for signed exponents.
func _matpow_neg(x &: Matrix, k: int): Matrix:
    mut inv := Inverse(x)
    if inv.is_empty(): ret Zeros(0, 0) end
    r := MatPow(inv, 0 - k)
    defer inv.free()
    ret r
end

// A transpose reads one array along rows and writes the other along columns,
// so one of the two sides always has a stride of a whole row. Done naively
// every store lands on a fresh cache line, and that line is evicted long
// before the other seven doubles in it are ever written - the array is
// streamed through the cache once per column rather than once in total.
// Walking in tiles keeps both the source and destination tiles resident, so
// each line is filled completely before it leaves.
@en "Transpose"
@fa "ترانهاده"
@ar "منقول"
pub func Transpose(x &: Matrix): Matrix:
    r := _raw(x.cols, x.rows)
    n := x.rows
    m := x.cols
    if n <= 0 || m <= 0: ret r end
    px := x.a.data
    pr := r.a.data
    mut i0 := 0
    until i0 < n:
        i1 := _min2(i0 + _T_BLOCK, n)
        mut j0 := 0
        until j0 < m:
            j1 := _min2(j0 + _T_BLOCK, m)
            mut i := i0
            until i < i1:
                xo := i * m
                mut j := j0
                until j < j1:
                    pr[j * n + i] = px[xo + j]
                    j += 1
                end
                i += 1
            end
            j0 += _T_BLOCK
        end
        i0 += _T_BLOCK
    end
    ret r
end

// The (n,k)x(k,m) product. Inner dimensions must agree; if they do not the
// result is 0x0, the same shape-error convention the elementwise ops use.
@en "MatMul"
@fa "ضرب ماتریسی"
@ar "ضرب المصفوفات"
pub func MatMul(x &: Matrix, y &: Matrix): Matrix:
    if x.cols != y.rows: ret Zeros(0, 0) end
    n := x.rows
    kn := x.cols
    m := y.cols
    r := Zeros(n, m)
    if n <= 0 || m <= 0 || kn <= 0: ret r end
    px := x.a.data
    py := y.a.data
    pr := r.a.data
    xc := x.cols
    yc := y.cols
    rc := m
    // One packing buffer, reused by every column block.
    panel := mem.Allocate(((kn * _NR) as u64) * (sizeof(f64) as u64)) as f64*
    defer mem.Free(panel as void*)
    nfull := (n / _MR) * _MR
    mfull := (m / _NR) * _NR
    mut j := 0
    until j < mfull:
        _mm_pack_b(py, yc, 0, kn, j, panel)
        mut i := 0
        until i < nfull:
            _mm_micro(
                _row(px, i * xc), _row(px, (i + 1) * xc), _row(px, (i + 2) * xc), _row(px, (i + 3) * xc),
                panel, kn,
                _row(pr, i * rc + j), _row(pr, (i + 1) * rc + j), _row(pr, (i + 2) * rc + j), _row(pr, (i + 3) * rc + j)
            )
            i += _MR
        end
        j += _NR
    end
    // Rows below the last full block of four, over the columns the kernel did
    // cover, and then every remaining column across all rows.
    _mm_edge(pr, rc, px, xc, py, yc, nfull, n, 0, mfull, kn)
    _mm_edge(pr, rc, px, xc, py, yc, 0, n, mfull, m, kn)
    ret r
end

// X^T Y without asking the caller to build the transpose. Normal equations,
// Gram matrices, covariance and the projection steps inside least squares all
// have this shape.
@en "TransposeMul"
@fa "ضرب ترانهاده"
@ar "ضرب المنقول"
pub func TransposeMul(x &: Matrix, y &: Matrix): Matrix:
    if x.rows != y.rows: ret Zeros(0, 0) end
    mut t := Transpose(x)
    r := MatMul(t, y)
    defer t.free()
    ret r
end

// X Y^T, the other one-sided transpose product. Here both operands are walked
// by row, so it needs no temporary at all.
@en "MulTranspose"
@fa "ضرب در ترانهاده"
@ar "ضرب في المنقول"
pub func MulTranspose(x &: Matrix, y &: Matrix): Matrix:
    if x.cols != y.cols: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, y.rows)
    repeat x.rows with i:
        repeat y.rows with j: r.set(i, j, _dot_rows(x, i, y, j, x.cols)) end
    end
    ret r
end

// X^T X, symmetric positive semidefinite by construction. Only the upper
// triangle is computed and then mirrored, which halves the work and, more
// usefully, makes the result exactly symmetric instead of symmetric to within
// rounding. Cholesky and the symmetric eigensolver both care.
@en "Gram"
@fa "گرام"
@ar "غرام"
pub func Gram(x &: Matrix): Matrix:
    mut t := Transpose(x)
    mut r := Zeros(x.cols, x.cols)
    repeat x.cols with i:
        mut j := i
        until j < x.cols:
            v := _dot_rows(t, i, t, j, x.rows)
            r.set(i, j, v)
            r.set(j, i, v)
            j += 1
        end
    end
    defer t.free()
    ret r
end

// A x for a column vector x (nx1), returned as a column vector.
@en "MatVec"
@fa "ضرب در بردار"
@ar "ضرب بمتجه"
pub func MatVec(a &: Matrix, x &: Matrix): Matrix:
    if x.cols != 1 || a.cols != x.rows: ret Zeros(0, 0) end
    mut r := Zeros(a.rows, 1)
    repeat a.rows with i:
        mut s := 0.0
        repeat a.cols with j: s += a.at(i, j) * x.at(j, 0) end
        r.set(i, 0, s)
    end
    ret r
end

// x A for a row vector x (1xn), returned as a row vector.
@en "VecMat"
@fa "ضرب بردار در ماتریس"
@ar "ضرب متجه في مصفوفة"
pub func VecMat(x &: Matrix, a &: Matrix): Matrix:
    if x.rows != 1 || x.cols != a.rows: ret Zeros(0, 0) end
    mut r := Zeros(1, a.cols)
    repeat a.rows with k:
        v := x.at(0, k)
        if v != 0.0:
            repeat a.cols with j: r.add_at(0, j, v * a.at(k, j)) end
        end
    end
    ret r
end

// The Frobenius inner product sum(X(i,j) Y(i,j)). For two vectors of the same
// length this is exactly the dot product, which is why there is no separate
// vector Dot: a vector here is a matrix.
@en "Dot"
@fa "ضرب داخلی"
@ar "ضرب داخلي"
pub func Dot(x &: Matrix, y &: Matrix): f64:
    if x.count() != y.count(): ret 0.0 end
    mut s := 0.0
    repeat x.count() with k: s += x.a.get(k) * y.a.get(k) end
    ret s
end

// u v^T, the rank-1 matrix. Both operands are read flat, so Outer(col, col)
// and Outer(row, row) both mean what the notation says.
@en "Outer"
@fa "ضرب خارجی"
@ar "ضرب خارجي"
pub func Outer(u &: Matrix, v &: Matrix): Matrix:
    m := u.count()
    n := v.count()
    mut r := Zeros(m, n)
    repeat m with i:
        ui := u.a.get(i)
        repeat n with j: r.set(i, j, ui * v.a.get(j)) end
    end
    ret r
end

// The Kronecker product: every entry of X replaced by that entry times the
// whole of Y, giving an (rx*ry) by (cx*cy) matrix. The operation that turns a
// matrix equation into a plain linear system, which is how Sylvester and
// Lyapunov equations get solved.
@en "Kron"
@fa "ضرب کرونکر"
@ar "ضرب كرونيكر"
pub func Kron(x &: Matrix, y &: Matrix): Matrix:
    mut r := Zeros(x.rows * y.rows, x.cols * y.cols)
    repeat x.rows with i:
        repeat x.cols with j:
            _kron_block(r, x.at(i, j), y, i * y.rows, j * y.cols)
        end
    end
    ret r
end

// A^k by repeated squaring, so the cost is log(k) products rather than k.
// A^0 is the identity for every square A, including the zero matrix, which is
// the convention that keeps the polynomial evaluators consistent.
@en "MatPow"
@fa "توان ماتریس"
@ar "قوة المصفوفة"
pub func MatPow(x &: Matrix, k: int): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    if k < 0: ret _matpow_neg(x, k) end
    mut acc := Eye(x.rows)
    mut base := Clone(x)
    mut e := k
    until e > 0:
        if e % 2 == 1:
            t := MatMul(acc, base)
            acc.free()
            acc = t
        end
        e = e / 2
        if e > 0:
            s := MatMul(base, base)
            base.free()
            base = s
        end
    end
    defer base.free()
    ret acc
end

@en "Trace"
@fa "رد"
@ar "أثر"
pub func Trace(x &: Matrix): f64:
    mut s := 0.0
    repeat x.min_dim() with i: s += x.at(i, i) end
    ret s
end

// The 3-vector cross product, for the geometry that reaches for a matrix
// library. Orientation is preserved: two columns give a column.
@en "Cross3"
@fa "ضرب برداری"
@ar "ضرب اتجاهي"
pub func Cross3(u &: Matrix, v &: Matrix): Matrix:
    if u.count() != 3 || v.count() != 3: ret Zeros(0, 0) end
    mut r := Zeros(u.rows, u.cols)
    r.a.set(0, u.a.get(1) * v.a.get(2) - u.a.get(2) * v.a.get(1))
    r.a.set(1, u.a.get(2) * v.a.get(0) - u.a.get(0) * v.a.get(2))
    r.a.set(2, u.a.get(0) * v.a.get(1) - u.a.get(1) * v.a.get(0))
    ret r
end
