package matrix

import mem

const _MAT_BLOCK := 64

const _T_BLOCK := 32

const _MR := 4
const _NR := 8

const _KC := 512

const _MC := 128

const _NC := 512

const _STRASSEN_MIN := 512

inline func _row(p: f64*, off: int): f64*:
    ret (p as i64 + (off as i64) * (sizeof(f64) as i64)) as f64*
end

inline func _row64(p: f64*, off: i64): f64*:
    ret (p as i64 + off * (sizeof(f64) as i64)) as f64*
end

func _min2(a: int, b: int): int:
    if a < b: ret a end
    ret b
end

func _mm_end(start: int, limit: int): int:
    e := start + _MAT_BLOCK
    if e > limit: ret limit end
    ret e
end

func _mm_axpy(pr: f64*, v: f64, py: f64*, cnt: int):
    repeat cnt with t: pr[t] = pr[t] + v * py[t] end
end

func _mm_tile(r &: Matrix, x &: Matrix, y &: Matrix, ii: int, kk: int, jj: int):
    i1 := _mm_end(ii, r.rows)
    k1 := _mm_end(kk, x.cols)
    j1 := _mm_end(jj, r.cols)
    pr := r.a.data
    px := x.a.data
    py := y.a.data
    rc := r.cols
    xc := x.cols
    yc := y.cols
    cnt := j1 - jj
    mut i := ii
    until i < i1:
        xo := i * xc
        rrow := _row(pr, i * rc + jj)
        mut k := kk
        until k < k1:
            v := px[xo + k]
            if v != 0.0: _mm_axpy(rrow, v, _row(py, k * yc + jj), cnt) end
            k += 1
        end
        i += 1
    end
end

func _mm_pack_a(px: f64*, xc: int, i0: int, k0: int, kc: int, dst: f64*):
    a0 := _row(px, i0 * xc + k0)
    a1 := _row(px, (i0 + 1) * xc + k0)
    a2 := _row(px, (i0 + 2) * xc + k0)
    a3 := _row(px, (i0 + 3) * xc + k0)
    repeat kc with k:
        d := _row(dst, k * _MR)
        d[0] = a0[k]
        d[1] = a1[k]
        d[2] = a2[k]
        d[3] = a3[k]
    end
end

func _mm_pack_b(py: f64*, yc: int, k0: int, k1: int, j0: int, dst: f64*):
    mut k := k0
    mut o := 0
    until k < k1:
        src := _row(py, k * yc + j0)
        d := _row(dst, o)
        repeat _NR with t: d[t] = src[t] end
        o += _NR
        k += 1
    end
end

func _mm_micro(pa: f64*, pb: f64*, kn: i64, c0: f64*, c1: f64*, c2: f64*, c3: f64*):
    mut c00 := c0[0]
    mut c01 := c0[1]
    mut c02 := c0[2]
    mut c03 := c0[3]
    mut c04 := c0[4]
    mut c05 := c0[5]
    mut c06 := c0[6]
    mut c07 := c0[7]
    mut c10 := c1[0]
    mut c11 := c1[1]
    mut c12 := c1[2]
    mut c13 := c1[3]
    mut c14 := c1[4]
    mut c15 := c1[5]
    mut c16 := c1[6]
    mut c17 := c1[7]
    mut c20 := c2[0]
    mut c21 := c2[1]
    mut c22 := c2[2]
    mut c23 := c2[3]
    mut c24 := c2[4]
    mut c25 := c2[5]
    mut c26 := c2[6]
    mut c27 := c2[7]
    mut c30 := c3[0]
    mut c31 := c3[1]
    mut c32 := c3[2]
    mut c33 := c3[3]
    mut c34 := c3[4]
    mut c35 := c3[5]
    mut c36 := c3[6]
    mut c37 := c3[7]
    repeat kn with k:
        pak := _row64(pa, k * (_MR as i64))
        pbk := _row64(pb, k * (_NR as i64))
        b0 := pbk[0]
        b1 := pbk[1]
        b2 := pbk[2]
        b3 := pbk[3]
        b4 := pbk[4]
        b5 := pbk[5]
        b6 := pbk[6]
        b7 := pbk[7]
        v0 := pak[0]
        c00 += v0 * b0
        c01 += v0 * b1
        c02 += v0 * b2
        c03 += v0 * b3
        c04 += v0 * b4
        c05 += v0 * b5
        c06 += v0 * b6
        c07 += v0 * b7
        v1 := pak[1]
        c10 += v1 * b0
        c11 += v1 * b1
        c12 += v1 * b2
        c13 += v1 * b3
        c14 += v1 * b4
        c15 += v1 * b5
        c16 += v1 * b6
        c17 += v1 * b7
        v2 := pak[2]
        c20 += v2 * b0
        c21 += v2 * b1
        c22 += v2 * b2
        c23 += v2 * b3
        c24 += v2 * b4
        c25 += v2 * b5
        c26 += v2 * b6
        c27 += v2 * b7
        v3 := pak[3]
        c30 += v3 * b0
        c31 += v3 * b1
        c32 += v3 * b2
        c33 += v3 * b3
        c34 += v3 * b4
        c35 += v3 * b5
        c36 += v3 * b6
        c37 += v3 * b7
    end
    c0[0] = c00
    c0[1] = c01
    c0[2] = c02
    c0[3] = c03
    c0[4] = c04
    c0[5] = c05
    c0[6] = c06
    c0[7] = c07
    c1[0] = c10
    c1[1] = c11
    c1[2] = c12
    c1[3] = c13
    c1[4] = c14
    c1[5] = c15
    c1[6] = c16
    c1[7] = c17
    c2[0] = c20
    c2[1] = c21
    c2[2] = c22
    c2[3] = c23
    c2[4] = c24
    c2[5] = c25
    c2[6] = c26
    c2[7] = c27
    c3[0] = c30
    c3[1] = c31
    c3[2] = c32
    c3[3] = c33
    c3[4] = c34
    c3[5] = c35
    c3[6] = c36
    c3[7] = c37
end

func _mm_edge(pr: f64*, rc: int, px: f64*, xc: int, py: f64*, yc: int, i0: int, i1: int, j0: int, j1: int, kn: int):
    mut i := i0
    until i < i1:
        xrow := _row(px, i * xc)
        crow := _row(pr, i * rc)
        mut j := j0
        until j < j1:
            mut acc := 0.0
            repeat kn with k: acc += xrow[k] * py[k * yc + j] end
            crow[j] = acc
            j += 1
        end
        i += 1
    end
end

func _mm_cols(r &: Matrix, x &: Matrix, y &: Matrix, ii: int, kk: int):
    mut jj := 0
    until jj < r.cols:
        _mm_tile(r, x, y, ii, kk, jj)
        jj += _MAT_BLOCK
    end
end

func _dot_rows(x &: Matrix, xr: int, y &: Matrix, yr: int, n: int): f64:
    mut s := 0.0
    repeat n with k: s += x.at(xr, k) * y.at(yr, k) end
    ret s
end

func _kron_block(r &: Matrix, s: f64, y &: Matrix, r0: int, c0: int):
    repeat y.rows with p:
        repeat y.cols with q: r.set(r0 + p, c0 + q, s * y.at(p, q)) end
    end
end

func _matpow_neg(x &: Matrix, k: int): Matrix:
    mut inv := Inverse(x)
    if inv.is_empty(): ret Zeros(0, 0) end
    r := MatPow(inv, 0 - k)
    defer inv.free()
    ret r
end

func _blk_op(x &: Matrix, r0: int, c0: int, y &: Matrix, r1: int, c1: int, sub: bool, dst &: Matrix):
    px := x.a.data
    py := y.a.data
    pd := dst.a.data
    w := dst.cols
    repeat dst.rows with i:
        a := _row(px, (r0 + i) * x.cols + c0)
        b := _row(py, (r1 + i) * y.cols + c1)
        d := _row(pd, i * w)
        if sub:
            repeat w with j: d[j] = a[j] - b[j] end
        else:
            repeat w with j: d[j] = a[j] + b[j] end
        end
    end
end

func _blk_copy(x &: Matrix, r0: int, c0: int, dst &: Matrix):
    px := x.a.data
    pd := dst.a.data
    w := dst.cols
    repeat dst.rows with i:
        a := _row(px, (r0 + i) * x.cols + c0)
        d := _row(pd, i * w)
        repeat w with j: d[j] = a[j] end
    end
end

func _blk_acc(r &: Matrix, r0: int, c0: int, src &: Matrix, neg: bool):
    pr := r.a.data
    ps := src.a.data
    w := src.cols
    repeat src.rows with i:
        d := _row(pr, (r0 + i) * r.cols + c0)
        t := _row(ps, i * w)
        if neg:
            repeat w with j: d[j] = d[j] - t[j] end
        else:
            repeat w with j: d[j] = d[j] + t[j] end
        end
    end
end

func _zero_into(m &: Matrix):
    p := m.a.data
    n := m.rows * m.cols
    repeat n with i: p[i] = 0.0 end
end

func _strassen(x &: Matrix, y &: Matrix, r &: Matrix):
    h := x.rows / 2
    k := x.cols / 2
    w := y.cols / 2
    mut ta := _raw(h, k)
    mut tb := _raw(k, w)
    mut m := Zeros(h, w)

    _blk_op(x, 0, 0, x, h, k, false, ta)
    _blk_op(y, 0, 0, y, k, w, false, tb)
    _matmul_pick(ta, tb, m)
    _blk_acc(r, 0, 0, m, false)
    _blk_acc(r, h, w, m, false)
    _zero_into(m)

    _blk_op(x, h, 0, x, h, k, false, ta)
    _blk_copy(y, 0, 0, tb)
    _matmul_pick(ta, tb, m)
    _blk_acc(r, h, 0, m, false)
    _blk_acc(r, h, w, m, true)
    _zero_into(m)

    _blk_copy(x, 0, 0, ta)
    _blk_op(y, 0, w, y, k, w, true, tb)
    _matmul_pick(ta, tb, m)
    _blk_acc(r, 0, w, m, false)
    _blk_acc(r, h, w, m, false)
    _zero_into(m)

    _blk_copy(x, h, k, ta)
    _blk_op(y, k, 0, y, 0, 0, true, tb)
    _matmul_pick(ta, tb, m)
    _blk_acc(r, 0, 0, m, false)
    _blk_acc(r, h, 0, m, false)
    _zero_into(m)

    _blk_op(x, 0, 0, x, 0, k, false, ta)
    _blk_copy(y, k, w, tb)
    _matmul_pick(ta, tb, m)
    _blk_acc(r, 0, 0, m, true)
    _blk_acc(r, 0, w, m, false)
    _zero_into(m)

    _blk_op(x, h, 0, x, 0, 0, true, ta)
    _blk_op(y, 0, 0, y, 0, w, false, tb)
    _matmul_pick(ta, tb, m)
    _blk_acc(r, h, w, m, false)
    _zero_into(m)

    _blk_op(x, 0, k, x, h, k, true, ta)
    _blk_op(y, k, 0, y, k, w, false, tb)
    _matmul_pick(ta, tb, m)
    _blk_acc(r, 0, 0, m, false)

    ta.free()
    tb.free()
    m.free()
end

func _matmul_pick(x &: Matrix, y &: Matrix, r &: Matrix):
    if x.rows >= _STRASSEN_MIN && x.cols >= _STRASSEN_MIN && y.cols >= _STRASSEN_MIN:
        if (x.rows % 2) == 0 && (x.cols % 2) == 0 && (y.cols % 2) == 0:
            _strassen(x, y, r)
            ret
        end
    end
    _matmul_into(x, y, r)
end

func _matmul_into(x &: Matrix, y &: Matrix, r &: Matrix):
    n := x.rows
    kn := x.cols
    m := y.cols
    if n <= 0 || m <= 0 || kn <= 0: ret end
    px := x.a.data
    py := y.a.data
    pr := r.a.data
    xc := x.cols
    yc := y.cols
    rc := m
    nfull := (n / _MR) * _MR
    mfull := (m / _NR) * _NR
    bpack := mem.Allocate(((_NC * _KC) as u64) * (sizeof(f64) as u64)) as f64*
    defer mem.Free(bpack as void*)
    apack := mem.Allocate(((_MC * _KC) as u64) * (sizeof(f64) as u64)) as f64*
    defer mem.Free(apack as void*)
    mut j0 := 0
    until j0 < mfull:
        nc := _min2(_NC, mfull - j0)
        ncblk := nc / _NR
        mut p0 := 0
        until p0 < kn:
            kc := _min2(_KC, kn - p0)
            repeat ncblk with jb:
                _mm_pack_b(py, yc, p0, p0 + kc, j0 + jb * _NR, _row(bpack, jb * kc * _NR))
            end
            mut i0 := 0
            until i0 < nfull:
                mcap := (_MC / _MR) * _MR
                ic := _min2(mcap, nfull - i0)
                mut ip := 0
                until ip < ic:
                    _mm_pack_a(px, xc, i0 + ip, p0, kc, _row(apack, ip * kc))
                    ip += _MR
                end
                repeat ncblk with jb:
                    j := j0 + jb * _NR
                    bp := _row(bpack, jb * kc * _NR)
                    mut ii := 0
                    until ii < ic:
                        i := i0 + ii
                        _mm_micro(
                            _row(apack, ii * kc), bp, kc as i64, _row(pr, i * rc + j), _row(pr, (i + 1) * rc + j), _row(pr, (i + 2) * rc + j), _row(pr, (i + 3) * rc + j)
                        )
                        ii += _MR
                    end
                end
                i0 += _MC
            end
            p0 += _KC
        end
        j0 += _NC
    end
    _mm_edge(pr, rc, px, xc, py, yc, nfull, n, 0, mfull, kn)
    _mm_edge(pr, rc, px, xc, py, yc, 0, n, mfull, m, kn)
end

func _transpose_into(x &: Matrix, r &: Matrix):
    n := x.rows
    m := x.cols
    if n <= 0 || m <= 0: ret end
    px := x.a.data
    pr := r.a.data
    mut i0 := 0
    until i0 < n:
        i1 := _min2(i0 + _T_BLOCK, n)
        mut j0 := 0
        until j0 < m:
            j1 := _min2(j0 + _T_BLOCK, m)
            mut i := i0
            until i < i1:
                xo := i * m
                mut j := j0
                until j < j1:
                    pr[j * n + i] = px[xo + j]
                    j += 1
                end
                i += 1
            end
            j0 += _T_BLOCK
        end
        i0 += _T_BLOCK
    end
end

@en "Transpose"
@fa "ترانهاده"
pub func Transpose(x &: Matrix): Matrix:
    r := _raw(x.cols, x.rows)
    _transpose_into(x, r)
    ret r
end

@en "MatMul"
@fa "ضرب ماتریسی"
pub func MatMul(x &: Matrix, y &: Matrix): Matrix:
    if x.cols != y.rows: ret Zeros(0, 0) end
    r := Zeros(x.rows, y.cols)
    _matmul_pick(x, y, r)
    ret r
end

@en "TransposeInto"
@fa "ترانهاده در"
pub func TransposeInto(x &: Matrix, out &: Matrix): bool:
    if out.rows != x.cols || out.cols != x.rows: ret false end
    _transpose_into(x, out)
    ret true
end

@en "MatMulInto"
@fa "ضرب ماتریسی در"
pub func MatMulInto(x &: Matrix, y &: Matrix, out &: Matrix): bool:
    if x.cols != y.rows: ret false end
    if out.rows != x.rows || out.cols != y.cols: ret false end
    pz := out.a.data
    repeat out.rows * out.cols with i:
        pz[i] = 0.0
    end
    _matmul_pick(x, y, out)
    ret true
end

@en "TransposeMul"
@fa "ضرب ترانهاده"
pub func TransposeMul(x &: Matrix, y &: Matrix): Matrix:
    if x.rows != y.rows: ret Zeros(0, 0) end
    mut t := Transpose(x)
    r := MatMul(t, y)
    defer t.free()
    ret r
end

@en "MulTranspose"
@fa "ضرب در ترانهاده"
pub func MulTranspose(x &: Matrix, y &: Matrix): Matrix:
    if x.cols != y.cols: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, y.rows)
    repeat x.rows with i:
        repeat y.rows with j: r.set(i, j, _dot_rows(x, i, y, j, x.cols)) end
    end
    ret r
end

@en "Gram"
@fa "گرام"
pub func Gram(x &: Matrix): Matrix:
    mut t := Transpose(x)
    mut r := Zeros(x.cols, x.cols)
    repeat x.cols with i:
        mut j := i
        until j < x.cols:
            v := _dot_rows(t, i, t, j, x.rows)
            r.set(i, j, v)
            r.set(j, i, v)
            j += 1
        end
    end
    defer t.free()
    ret r
end

@en "MatVec"
@fa "ضرب در بردار"
pub func MatVec(a &: Matrix, x &: Matrix): Matrix:
    if x.cols != 1 || a.cols != x.rows: ret Zeros(0, 0) end
    mut r := Zeros(a.rows, 1)
    repeat a.rows with i:
        mut s := 0.0
        repeat a.cols with j: s += a.at(i, j) * x.at(j, 0) end
        r.set(i, 0, s)
    end
    ret r
end

@en "VecMat"
@fa "ضرب بردار در ماتریس"
pub func VecMat(x &: Matrix, a &: Matrix): Matrix:
    if x.rows != 1 || x.cols != a.rows: ret Zeros(0, 0) end
    mut r := Zeros(1, a.cols)
    repeat a.rows with k:
        v := x.at(0, k)
        if v != 0.0:
            repeat a.cols with j: r.add_at(0, j, v * a.at(k, j)) end
        end
    end
    ret r
end

@en "Dot"
@fa "ضرب داخلی"
pub func Dot(x &: Matrix, y &: Matrix): f64:
    if x.count() != y.count(): ret 0.0 end
    mut s := 0.0
    repeat x.count() with k: s += x.a.get(k) * y.a.get(k) end
    ret s
end

@en "Outer"
@fa "ضرب خارجی"
pub func Outer(u &: Matrix, v &: Matrix): Matrix:
    m := u.count()
    n := v.count()
    mut r := Zeros(m, n)
    repeat m with i:
        ui := u.a.get(i)
        repeat n with j: r.set(i, j, ui * v.a.get(j)) end
    end
    ret r
end

@en "Kron"
@fa "ضرب کرونکر"
pub func Kron(x &: Matrix, y &: Matrix): Matrix:
    mut r := Zeros(x.rows * y.rows, x.cols * y.cols)
    repeat x.rows with i:
        repeat x.cols with j:
            _kron_block(r, x.at(i, j), y, i * y.rows, j * y.cols)
        end
    end
    ret r
end

@en "MatPow"
@fa "توان ماتریس"
pub func MatPow(x &: Matrix, k: int): Matrix:
    if x.is_square() == false: ret Zeros(0, 0) end
    if k < 0: ret _matpow_neg(x, k) end
    mut acc := Eye(x.rows)
    mut base := Clone(x)
    mut e := k
    until e > 0:
        if e % 2 == 1:
            t := MatMul(acc, base)
            acc.free()
            acc = t
        end
        e = e / 2
        if e > 0:
            s := MatMul(base, base)
            base.free()
            base = s
        end
    end
    defer base.free()
    ret acc
end

@en "Trace"
@fa "رد"
pub func Trace(x &: Matrix): f64:
    mut s := 0.0
    repeat x.min_dim() with i: s += x.at(i, i) end
    ret s
end

@en "Cross3"
@fa "ضرب برداری"
pub func Cross3(u &: Matrix, v &: Matrix): Matrix:
    if u.count() != 3 || v.count() != 3: ret Zeros(0, 0) end
    mut r := Zeros(u.rows, u.cols)
    r.a.set(0, u.a.get(1) * v.a.get(2) - u.a.get(2) * v.a.get(1))
    r.a.set(1, u.a.get(2) * v.a.get(0) - u.a.get(0) * v.a.get(2))
    r.a.set(2, u.a.get(0) * v.a.get(1) - u.a.get(1) * v.a.get(0))
    ret r
end
