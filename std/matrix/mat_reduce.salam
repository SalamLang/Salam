package matrix

import math
import sort

const _SUM_BLOCK := 256

func _sum_flat(p: f64*, lo: int, hi: int): f64:
    n := hi - lo
    if n <= 0: ret 0.0 end
    if n <= _SUM_BLOCK:
        base := _row(p, lo)
        mut s0 := 0.0
        mut s1 := 0.0
        mut s2 := 0.0
        mut s3 := 0.0
        mut s4 := 0.0
        mut s5 := 0.0
        mut s6 := 0.0
        mut s7 := 0.0
        nv := n / 8
        repeat nv with k:
            q := _row(base, k * 8)
            s0 += q[0]
            s1 += q[1]
            s2 += q[2]
            s3 += q[3]
            s4 += q[4]
            s5 += q[5]
            s6 += q[6]
            s7 += q[7]
        end
        mut s := ((s0 + s1) + (s2 + s3)) + ((s4 + s5) + (s6 + s7))
        mut i := nv * 8
        until i < n:
            s += base[i]
            i += 1
        end
        ret s
    end
    mid := lo + n / 2
    ret _sum_flat(p, lo, mid) + _sum_flat(p, mid, hi)
end

func _row_sum(x &: Matrix, i: int): f64:
    mut s := 0.0
    repeat x.cols with j: s += x.at(i, j) end
    ret s
end

func _col_sum(x &: Matrix, j: int): f64:
    mut s := 0.0
    repeat x.rows with i: s += x.at(i, j) end
    ret s
end

func _extreme(x &: Matrix, idx: int, by_row: bool, want_max: bool): f64:
    n := _extreme_len(x, by_row)
    if n <= 0: ret 0.0 end
    mut best := _extreme_at(x, idx, 0, by_row)
    mut k := 1
    until k < n:
        v := _extreme_at(x, idx, k, by_row)
        if want_max && v > best: best = v end
        if want_max == false && v < best: best = v end
        k += 1
    end
    ret best
end

func _extreme_len(x &: Matrix, by_row: bool): int:
    if by_row: ret x.cols end
    ret x.rows
end

func _extreme_at(x &: Matrix, idx: int, k: int, by_row: bool): f64:
    if by_row: ret x.at(idx, k) end
    ret x.at(k, idx)
end

func _sum_sq_dev(x &: Matrix): f64:
    mu := Mean(x)
    mut acc := 0.0
    repeat x.count() with k:
        d := x.a.get(k) - mu
        acc += d * d
    end
    ret acc
end

func _denominator(n: int, sample: bool): f64:
    if sample: ret (n - 1) as f64 end
    ret n as f64
end

@en "Sum"
@fa "مجموع"
pub func Sum(x &: Matrix): f64: ret _sum_flat(x.a.data, 0, x.count()) end

@en "Prod"
@fa "حاصل‌ضرب"
pub func Prod(x &: Matrix): f64:
    mut p := 1.0
    repeat x.count() with k: p = p * x.a.get(k) end
    ret p
end

@en "Mean"
@fa "میانگین"
pub func Mean(x &: Matrix): f64:
    if x.count() == 0: ret 0.0 end
    ret Sum(x) / (x.count() as f64)
end

@en "Min"
@fa "کمینه"
pub func Min(x &: Matrix): f64:
    if x.count() == 0: ret 0.0 end
    mut b := x.a.get(0)
    repeat x.count() with k:
        if x.a.get(k) < b: b = x.a.get(k) end
    end
    ret b
end

@en "Max"
@fa "بیشینه"
pub func Max(x &: Matrix): f64:
    if x.count() == 0: ret 0.0 end
    mut b := x.a.get(0)
    repeat x.count() with k:
        if x.a.get(k) > b: b = x.a.get(k) end
    end
    ret b
end

@en "Range"
@fa "دامنه"
pub func Range(x &: Matrix): f64: ret Max(x) - Min(x) end

@en "ArgMin"
@fa "اندیس کمینه"
pub func ArgMin(x &: Matrix): int:
    mut bi := 0
    repeat x.count() with k:
        if x.a.get(k) < x.a.get(bi): bi = k end
    end
    ret bi
end

@en "ArgMax"
@fa "اندیس بیشینه"
pub func ArgMax(x &: Matrix): int:
    mut bi := 0
    repeat x.count() with k:
        if x.a.get(k) > x.a.get(bi): bi = k end
    end
    ret bi
end

@en "IndexRow"
@fa "سطر اندیس"
pub func IndexRow(x &: Matrix, k: int): int:
    if x.cols <= 0: ret 0 end
    ret k / x.cols
end

@en "IndexCol"
@fa "ستون اندیس"
pub func IndexCol(x &: Matrix, k: int): int:
    if x.cols <= 0: ret 0 end
    ret k % x.cols
end

@en "MaxAbs"
@fa "بیشینه قدرمطلق"
pub func MaxAbs(x &: Matrix): f64:
    mut b := 0.0
    repeat x.count() with k:
        v := math.Abs(x.a.get(k))
        if v > b: b = v end
    end
    ret b
end

@en "Var"
@fa "واریانس"
pub func Var(x &: Matrix, sample: bool): f64:
    d := _denominator(x.count(), sample)
    if d <= 0.0: ret 0.0 end
    ret _sum_sq_dev(x) / d
end

@en "Std"
@fa "انحراف معیار"
pub func Std(x &: Matrix, sample: bool): f64: ret math.Sqrt(Var(x, sample)) end

@en "Median"
@fa "میانه"
pub func Median(x &: Matrix): f64:
    n := x.count()
    if n == 0: ret 0.0 end
    mut v := Vector {} as Vector<f64>
    repeat n with k: v.push(x.a.get(k)) end
    sort.Sort(v)
    mut m := v.get(n / 2)
    if n % 2 == 0: m = 0.5 * (v.get(n / 2 - 1) + v.get(n / 2)) end
    defer v.free()
    ret m
end

@en "RowSums"
@fa "مجموع سطرها"
pub func RowSums(x &: Matrix): Matrix:
    mut r := Zeros(x.rows, 1)
    repeat x.rows with i: r.set(i, 0, _row_sum(x, i)) end
    ret r
end

@en "ColSums"
@fa "مجموع ستون‌ها"
pub func ColSums(x &: Matrix): Matrix:
    mut r := Zeros(1, x.cols)
    repeat x.cols with j: r.set(0, j, _col_sum(x, j)) end
    ret r
end

@en "RowMeans"
@fa "میانگین سطرها"
pub func RowMeans(x &: Matrix): Matrix:
    mut r := RowSums(x)
    if x.cols > 0: ScaleInPlace(r, 1.0 / (x.cols as f64)) end
    ret r
end

@en "ColMeans"
@fa "میانگین ستون‌ها"
pub func ColMeans(x &: Matrix): Matrix:
    mut r := ColSums(x)
    if x.rows > 0: ScaleInPlace(r, 1.0 / (x.rows as f64)) end
    ret r
end

@en "RowMins"
@fa "کمینه سطرها"
pub func RowMins(x &: Matrix): Matrix:
    mut r := Zeros(x.rows, 1)
    repeat x.rows with i: r.set(i, 0, _extreme(x, i, true, false)) end
    ret r
end

@en "RowMaxs"
@fa "بیشینه سطرها"
pub func RowMaxs(x &: Matrix): Matrix:
    mut r := Zeros(x.rows, 1)
    repeat x.rows with i: r.set(i, 0, _extreme(x, i, true, true)) end
    ret r
end

@en "ColMins"
@fa "کمینه ستون‌ها"
pub func ColMins(x &: Matrix): Matrix:
    mut r := Zeros(1, x.cols)
    repeat x.cols with j: r.set(0, j, _extreme(x, j, false, false)) end
    ret r
end

@en "ColMaxs"
@fa "بیشینه ستون‌ها"
pub func ColMaxs(x &: Matrix): Matrix:
    mut r := Zeros(1, x.cols)
    repeat x.cols with j: r.set(0, j, _extreme(x, j, false, true)) end
    ret r
end

@en "CumSumRows"
@fa "مجموع تجمعی سطری"
pub func CumSumRows(x &: Matrix): Matrix:
    mut r := Zeros(x.rows, x.cols)
    repeat x.rows with i:
        mut s := 0.0
        repeat x.cols with j:
            s += x.at(i, j)
            r.set(i, j, s)
        end
    end
    ret r
end

@en "CumSumCols"
@fa "مجموع تجمعی ستونی"
pub func CumSumCols(x &: Matrix): Matrix:
    mut r := Zeros(x.rows, x.cols)
    repeat x.cols with j:
        mut s := 0.0
        repeat x.rows with i:
            s += x.at(i, j)
            r.set(i, j, s)
        end
    end
    ret r
end

@en "CumProdRows"
@fa "ضرب تجمعی سطری"
pub func CumProdRows(x &: Matrix): Matrix:
    mut r := Zeros(x.rows, x.cols)
    repeat x.rows with i:
        mut p := 1.0
        repeat x.cols with j:
            p = p * x.at(i, j)
            r.set(i, j, p)
        end
    end
    ret r
end

@en "CountNonZero"
@fa "شمار ناصفر"
pub func CountNonZero(x &: Matrix): int:
    mut n := 0
    repeat x.count() with k:
        if x.a.get(k) != 0.0: n += 1 end
    end
    ret n
end

@en "Any"
@fa "هر"
pub func Any(x &: Matrix): bool: ret CountNonZero(x) > 0 end

@en "All"
@fa "همه"
pub func All(x &: Matrix): bool: ret CountNonZero(x) == x.count() end

@en "AllFinite"
@fa "همه متناهی"
pub func AllFinite(x &: Matrix): bool:
    repeat x.count() with k:
        v := x.a.get(k)
        if math.IsNaN(v): ret false end
        if math.IsInf(v): ret false end
    end
    ret true
end
