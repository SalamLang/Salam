package matrix

import math

const _RREF_SCALE := 1.0e-12

func _matrix_scale(x &: Matrix): f64:
    mut m := 0.0
    repeat x.count() with k:
        v := math.Abs(x.a.get(k))
        if v > m: m = v end
    end
    if m == 0.0: ret 1.0 end
    ret m
end

func _best_pivot(x &: Matrix, from: int, col: int): int:
    mut best := from
    mut bv := math.Abs(x.at(from, col))
    mut i := from + 1
    until i < x.rows:
        v := math.Abs(x.at(i, col))
        if v > bv:
            bv = v
            best = i
        end
        i += 1
    end
    ret best
end

func _scale_row(x &: Matrix, i: int, f: f64):
    repeat x.cols with j: x.mul_at(i, j, f) end
end

func _axpy_row(x &: Matrix, target: int, source: int, f: f64):
    repeat x.cols with j:
        x.set(target, j, x.at(target, j) - f * x.at(source, j))
    end
end

func _clear_column(x &: Matrix, pivot_row: int, col: int, full: bool):
    pivot := x.at(pivot_row, col)
    if pivot == 0.0: ret end
    repeat x.rows with i:
        if i != pivot_row:
            if full || i > pivot_row:
                f := x.at(i, col) / pivot
                if f != 0.0: _axpy_row(x, i, pivot_row, f) end
            end
        end
    end
end

func _eliminate(x &: Matrix, pivots &: Vector<int>, reduced: bool):
    tol := _RREF_SCALE * _matrix_scale(x)
    mut row := 0
    repeat x.cols with col:
        if row < x.rows:
            _eliminate_col(x, pivots, row, col, tol, reduced)
            if pivots.len() > row: row += 1 end
        end
    end
end

func _eliminate_col(x &: Matrix, pivots &: Vector<int>, row: int, col: int, tol: f64, reduced: bool):
    p := _best_pivot(x, row, col)
    if math.Abs(x.at(p, col)) <= tol: ret end
    SwapRows(x, row, p)
    if reduced: _scale_row(x, row, 1.0 / x.at(row, col)) end
    _clear_column(x, row, col, reduced)
    pivots.push(col)
end

func _free_columns(ncols: int, piv &: Vector<int>): Vector<int>:
    mut free := Vector {} as Vector<int>
    repeat ncols with j:
        mut found := false
        repeat piv.len() with k:
            if piv.get(k) == j: found = true end
        end
        if found == false: free.push(j) end
    end
    ret free
end

func _null_column(r &: Matrix, piv &: Vector<int>, free &: Vector<int>, basis &: Matrix, k: int):
    fc := free.get(k)
    basis.set(fc, k, 1.0)
    repeat piv.len() with row:
        basis.set(piv.get(row), k, 0.0 - r.at(row, fc))
    end
end

func _copy_col(src &: Matrix, dst &: Matrix, src_col: int, dst_col: int):
    repeat src.rows with i: dst.set(i, dst_col, src.at(i, src_col)) end
end

func _read_solution(aug &: Matrix, piv &: Vector<int>, out &: Matrix, ncols: int): bool:
    repeat piv.len() with k:
        col := piv.get(k)
        if col >= ncols: ret false end
        out.set(col, 0, aug.at(k, ncols))
    end
    ret true
end

@en "RowEchelon"
@fa "پلکانی سطری"
pub func RowEchelon(x &: Matrix): Matrix:
    mut r := Clone(x)
    mut piv := Vector {} as Vector<int>
    _eliminate(r, piv, false)
    defer piv.free()
    ret r
end

@en "RREF"
@fa "پلکانی کاهش‌یافته"
pub func RREF(x &: Matrix): Matrix:
    mut r := Clone(x)
    mut piv := Vector {} as Vector<int>
    _eliminate(r, piv, true)
    defer piv.free()
    ret r
end

@en "PivotColumns"
@fa "ستون‌های محوری"
pub func PivotColumns(x &: Matrix): Matrix:
    mut work := Clone(x)
    mut piv := Vector {} as Vector<int>
    _eliminate(work, piv, true)
    mut r := Zeros(1, piv.len())
    repeat piv.len() with k: r.set(0, k, piv.get(k) as f64) end
    defer piv.free()
    defer work.free()
    ret r
end

@en "RankExact"
@fa "رتبه دقیق"
pub func RankExact(x &: Matrix): int:
    mut work := Clone(x)
    mut piv := Vector {} as Vector<int>
    _eliminate(work, piv, true)
    n := piv.len()
    defer piv.free()
    defer work.free()
    ret n
end

@en "Nullity"
@fa "پوچی"
pub func Nullity(x &: Matrix): int: ret x.cols - RankExact(x) end

@en "NullSpaceExact"
@fa "فضای پوچ دقیق"
pub func NullSpaceExact(x &: Matrix): Matrix:
    mut r := Clone(x)
    mut piv := Vector {} as Vector<int>
    _eliminate(r, piv, true)
    mut free := _free_columns(x.cols, piv)
    mut basis := Zeros(x.cols, free.len())
    repeat free.len() with k: _null_column(r, piv, free, basis, k) end
    defer piv.free()
    free.free()
    defer r.free()
    ret basis
end
@en "ColumnSpaceExact"
@fa "فضای ستونی دقیق"
pub func ColumnSpaceExact(x &: Matrix): Matrix:
    mut work := Clone(x)
    mut piv := Vector {} as Vector<int>
    _eliminate(work, piv, true)
    mut r := Zeros(x.rows, piv.len())
    repeat piv.len() with k: _copy_col(x, r, piv.get(k), k) end
    defer piv.free()
    defer work.free()
    ret r
end

@en "SolveGeneral"
@fa "حل عمومی"
pub func SolveGeneral(a &: Matrix, b &: Matrix): Matrix:
    if a.rows != b.rows || b.cols != 1: ret Zeros(0, 0) end
    mut aug := HStack(a, b)
    mut piv := Vector {} as Vector<int>
    _eliminate(aug, piv, true)
    mut r := Zeros(a.cols, 1)
    ok := _read_solution(aug, piv, r, a.cols)
    defer piv.free()
    defer aug.free()
    if ok: ret r end
    defer r.free()
    ret Zeros(0, 0)
end

@en "IsConsistent"
@fa "سازگار است"
pub func IsConsistent(a &: Matrix, b &: Matrix): bool:
    if a.rows != b.rows: ret false end
    mut aug := HStack(a, b)
    ra := RankExact(a)
    rb := RankExact(aug)
    defer aug.free()
    ret ra == rb
end
