package matrix

func _copy_block(dst &: Matrix, src &: Matrix, r0: int, c0: int, dr: int, dc: int):
    repeat dr with i:
        repeat dc with j: dst.set(i, j, src.at(r0 + i, c0 + j)) end
    end
end

func _copy_skip_row(dst &: Matrix, src &: Matrix, skip: int):
    mut w := 0
    repeat src.rows with i:
        if i != skip:
            repeat src.cols with j: dst.set(w, j, src.at(i, j)) end
            w += 1
        end
    end
end

func _copy_skip_col(dst &: Matrix, src &: Matrix, skip: int):
    repeat src.rows with i:
        mut w := 0
        repeat src.cols with j:
            if j != skip:
                dst.set(i, w, src.at(i, j))
                w += 1
            end
        end
    end
end

func _shift_rows_down(dst &: Matrix, src &: Matrix, from: int):
    mut i := from
    until i < src.rows:
        repeat src.cols with j: dst.set(i + 1, j, src.at(i, j)) end
        i += 1
    end
end

func _copy_row_split(dst &: Matrix, src &: Matrix, i: int, at: int, v: f64):
    repeat at with j: dst.set(i, j, src.at(i, j)) end
    dst.set(i, at, v)
    mut j := at
    until j < src.cols:
        dst.set(i, j + 1, src.at(i, j))
        j += 1
    end
end

func _clamp(v: int, lo: int, hi: int): int:
    if v < lo: ret lo end
    if v > hi: ret hi end
    ret v
end

@en "Reshape"
@fa "تغییر شکل"
pub func Reshape(x &: Matrix, rows: int, cols: int): Matrix:
    if rows * cols != x.count(): ret Zeros(0, 0) end
    mut r := Zeros(rows, cols)
    repeat x.count() with k: r.a.set(k, x.a.get(k)) end
    ret r
end

@en "Flatten"
@fa "تخت‌سازی"
pub func Flatten(x &: Matrix): Matrix: ret Reshape(x, 1, x.count()) end

@en "FlattenCol"
@fa "تخت‌سازی ستونی"
pub func FlattenCol(x &: Matrix): Matrix: ret Reshape(x, x.count(), 1) end

@en "Row"
@fa "سطر"
pub func Row(x &: Matrix, i: int): Matrix:
    if i < 0 || i >= x.rows: ret Zeros(0, 0) end
    mut r := Zeros(1, x.cols)
    repeat x.cols with j: r.set(0, j, x.at(i, j)) end
    ret r
end

@en "Col"
@fa "ستون"
pub func Col(x &: Matrix, j: int): Matrix:
    if j < 0 || j >= x.cols: ret Zeros(0, 0) end
    mut r := Zeros(x.rows, 1)
    repeat x.rows with i: r.set(i, 0, x.at(i, j)) end
    ret r
end

@en "SetRow"
@fa "تنظیم سطر"
pub func SetRow(x &: Matrix, i: int, v &: Matrix):
    if i < 0 || i >= x.rows || v.count() != x.cols: ret end
    repeat x.cols with j: x.set(i, j, v.a.get(j)) end
end

@en "SetCol"
@fa "تنظیم ستون"
pub func SetCol(x &: Matrix, j: int, v &: Matrix):
    if j < 0 || j >= x.cols || v.count() != x.rows: ret end
    repeat x.rows with i: x.set(i, j, v.a.get(i)) end
end

@en "SubMatrix"
@fa "زیرماتریس"
pub func SubMatrix(x &: Matrix, r0: int, c0: int, dr: int, dc: int): Matrix:
    sr := _clamp(r0, 0, x.rows)
    sc := _clamp(c0, 0, x.cols)
    nr := _clamp(dr, 0, x.rows - sr)
    nc := _clamp(dc, 0, x.cols - sc)
    mut r := Zeros(nr, nc)
    _copy_block(r, x, sr, sc, nr, nc)
    ret r
end

@en "Minor"
@fa "کهاد"
pub func Minor(x &: Matrix, i: int, j: int): Matrix:
    if x.rows <= 1 || x.cols <= 1: ret Zeros(0, 0) end
    mut cut := DeleteRow(x, i)
    r := DeleteCol(cut, j)
    defer cut.free()
    ret r
end

@en "DeleteRow"
@fa "حذف سطر"
pub func DeleteRow(x &: Matrix, i: int): Matrix:
    if i < 0 || i >= x.rows: ret Clone(x) end
    mut r := Zeros(x.rows - 1, x.cols)
    _copy_skip_row(r, x, i)
    ret r
end

@en "DeleteCol"
@fa "حذف ستون"
pub func DeleteCol(x &: Matrix, j: int): Matrix:
    if j < 0 || j >= x.cols: ret Clone(x) end
    mut r := Zeros(x.rows, x.cols - 1)
    _copy_skip_col(r, x, j)
    ret r
end

@en "InsertRow"
@fa "درج سطر"
pub func InsertRow(x &: Matrix, i: int, v &: Matrix): Matrix:
    if v.count() != x.cols || i < 0 || i > x.rows: ret Clone(x) end
    mut r := Zeros(x.rows + 1, x.cols)
    _copy_block(r, x, 0, 0, i, x.cols)
    repeat x.cols with j: r.set(i, j, v.a.get(j)) end
    _shift_rows_down(r, x, i)
    ret r
end

@en "InsertCol"
@fa "درج ستون"
pub func InsertCol(x &: Matrix, j: int, v &: Matrix): Matrix:
    if v.count() != x.rows || j < 0 || j > x.cols: ret Clone(x) end
    mut r := Zeros(x.rows, x.cols + 1)
    repeat x.rows with i:
        _copy_row_split(r, x, i, j, v.a.get(i))
    end
    ret r
end

@en "SwapRows"
@fa "تعویض سطر"
pub func SwapRows(x &: Matrix, i: int, j: int):
    if i == j || i < 0 || j < 0 || i >= x.rows || j >= x.rows: ret end
    repeat x.cols with c:
        t := x.at(i, c)
        x.set(i, c, x.at(j, c))
        x.set(j, c, t)
    end
end

@en "SwapCols"
@fa "تعویض ستون"
pub func SwapCols(x &: Matrix, i: int, j: int):
    if i == j || i < 0 || j < 0 || i >= x.cols || j >= x.cols: ret end
    repeat x.rows with r:
        t := x.at(r, i)
        x.set(r, i, x.at(r, j))
        x.set(r, j, t)
    end
end

@en "Diagonal"
@fa "قطر"
pub func Diagonal(x &: Matrix): Matrix:
    n := x.min_dim()
    mut r := Zeros(1, n)
    repeat n with i: r.set(0, i, x.at(i, i)) end
    ret r
end

@en "DiagonalOffset"
@fa "قطر جابه‌جا"
pub func DiagonalOffset(x &: Matrix, k: int): Matrix:
    mut data := Vector {} as Vector<f64>
    repeat x.rows with i:
        j := i + k
        if j >= 0 && j < x.cols: data.push(x.at(i, j)) end
    end
    r := RowVector(data)
    defer data.free()
    ret r
end

@en "SetDiagonal"
@fa "تنظیم قطر"
pub func SetDiagonal(x &: Matrix, v &: Matrix):
    mut n := x.min_dim()
    if v.count() < n: n = v.count() end
    repeat n with i: x.set(i, i, v.a.get(i)) end
end

@en "ShiftDiagonal"
@fa "افزودن به قطر"
pub func ShiftDiagonal(x &: Matrix, c: f64):
    repeat x.min_dim() with i: x.add_at(i, i, c) end
end
