package mem

// Arena is a bump-pointer allocator over one backing block: ArenaAlloc just
// advances a cursor (no per-allocation bookkeeping, no individual frees) and
// the whole region is released at once with ArenaFree, or rewound for reuse
// with ArenaReset. Use it for scoped/temporary allocations with a shared
// lifetime (e.g. all data built up during one request or one frame).
@en "Arena"
@fa "قلمرو"
@ar "ساحة"
pub struct Arena:
    pub buf: void* = null
    pub cap: u64 = 0 as u64
    pub used: u64 = 0 as u64
end

func _align8(size: u64): u64:
    rem := size % (8 as u64)
    if rem == (0 as u64): ret size end
    ret size + ((8 as u64) - rem)
end

@en "NewArena"
@fa "قلمرو جدید"
@ar "ساحة جدیدة"
pub func NewArena(capacity: u64): Arena:
    ret Arena { buf = Allocate(capacity), cap = capacity, used = 0 as u64 }
end

@en "ArenaAlloc"
@fa "تخصیص در قلمرو"
@ar "تخصیص في الساحة"
pub func ArenaAlloc(a &: Arena, size: u64): void*:
    if a.buf == null || size == (0 as u64): ret null end
    aligned := _align8(size)
    if a.used + aligned > a.cap: ret null end
    p := ((a.buf as u64) + a.used) as void*
    a.used += aligned
    ret p
end

@en "ArenaAllocZeroed"
@fa "تخصیص صفرشده در قلمرو"
@ar "تخصیص مصفر في الساحة"
pub func ArenaAllocZeroed(a &: Arena, size: u64): void*:
    p := ArenaAlloc(a, size)
    if p != null: Set(p, 0, size) end
    ret p
end

@en "ArenaReset"
@fa "بازنشانی قلمرو"
@ar "إعادة تعیین الساحة"
pub func ArenaReset(a &: Arena): a.used = 0 as u64 end

@en "ArenaFree"
@fa "آزادسازی قلمرو"
@ar "تحریر الساحة"
pub func ArenaFree(a &: Arena):
    Free(a.buf)
    a.buf = null
    a.cap = 0 as u64
    a.used = 0 as u64
end

@en "ArenaUsed"
@fa "استفاده شده قلمرو"
@ar "المستخدم من الساحة"
pub func ArenaUsed(a &: Arena): u64: ret a.used end

@en "ArenaCapacity"
@fa "ظرفیت قلمرو"
@ar "سعة الساحة"
pub func ArenaCapacity(a &: Arena): u64: ret a.cap end

@en "ArenaRemaining"
@fa "باقیمانده قلمرو"
@ar "المتبقي من الساحة"
pub func ArenaRemaining(a &: Arena): u64: ret a.cap - a.used end
