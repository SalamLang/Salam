package mem

// Pool is a fixed-block-size free-list allocator: PoolAlloc/PoolFree are
// O(1) with no fragmentation, at the cost of every block being sized for
// the largest thing you'll ever put in it. Good for many same-shaped,
// short-lived allocations (e.g. graph nodes, pooled connection objects).
@en "Pool"
@fa "استخر"
@ar "تجمع"
pub struct Pool:
    pub block_size: u64 = 0 as u64
    pub block_count: u64 = 0 as u64
    pub blocks: void* = null
    pub free_list: void* = null
end

func _pool_next(block: void*): void*:
    p := block as i64*
    ret p[0] as void*
end

func _pool_set_next(block: void*, next: void*):
    p := block as i64*
    p[0] = next as i64
end

@en "NewPool"
@fa "استخر جدید"
@ar "تجمع جدید"
pub func NewPool(block_size: u64, block_count: u64): Pool:
    mut bs := block_size
    if bs < (8 as u64): bs = 8 as u64 end
    rem := bs % (8 as u64)
    if rem != (0 as u64): bs = bs + ((8 as u64) - rem) end

    if block_count == (0 as u64):
        ret Pool { block_size = bs, block_count = 0 as u64 }
    end

    total := bs * block_count
    buf := Allocate(total)
    if buf == null:
        ret Pool { block_size = bs, block_count = 0 as u64 }
    end

    mut i := 0 as u64
    until i < block_count:
        addr := ((buf as u64) + i * bs) as void*
        mut next := null as void*
        if i + (1 as u64) < block_count:
            next = ((buf as u64) + (i + (1 as u64)) * bs) as void*
        end
        _pool_set_next(addr, next)
        i += 1 as u64
    end

    ret Pool { block_size = bs, block_count = block_count, blocks = buf, free_list = buf }
end

@en "PoolAlloc"
@fa "تخصیص از استخر"
@ar "تخصیص من التجمع"
pub func PoolAlloc(p &: Pool): void*:
    if p.free_list == null: ret null end
    head := p.free_list
    p.free_list = _pool_next(head)
    ret head
end

@en "PoolFree"
@fa "بازگشت به استخر"
@ar "إعادة إلى التجمع"
pub func PoolFree(p &: Pool, ptr: void*):
    if ptr == null: ret end
    _pool_set_next(ptr, p.free_list)
    p.free_list = ptr
end

@en "PoolBlockSize"
@fa "اندازه بلوک"
@ar "حجم الكتلة"
pub func PoolBlockSize(p &: Pool): u64: ret p.block_size end

@en "PoolCapacity"
@fa "ظرفیت استخر"
@ar "سعة التجمع"
pub func PoolCapacity(p &: Pool): u64: ret p.block_count end

@en "PoolDestroy"
@fa "نابودسازی استخر"
@ar "تدمیر التجمع"
pub func PoolDestroy(p &: Pool):
    Free(p.blocks)
    p.blocks = null
    p.free_list = null
    p.block_count = 0 as u64
end
