package metatrader

import net.http
import encoding.json

struct symbolRequest:
    symbol: str = ""
end

@en "MarketBookAdd"
@fa "افزودن دفتر سفارش"
pub func MarketBookAdd(symbol: str): bool:
    req := symbolRequest { symbol = symbol }
    r := _post_raw("/market_book_add", json.Marshal(req))
    ret _check(r)
end

@en "MarketBookGet"
@fa "دریافت دفتر سفارش"
pub func MarketBookGet(symbol: str): Vector<BookInfo>:
    mut out := Vector {} as Vector<BookInfo>
    mut params := HashMap {} as HashMap<str, str>
    params.put("symbol", symbol)
    r := _get_raw("/market_book_get", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "MarketBookRelease"
@fa "آزادسازی دفتر سفارش"
pub func MarketBookRelease(symbol: str): bool:
    req := symbolRequest { symbol = symbol }
    r := _post_raw("/market_book_release", json.Marshal(req))
    ret _check(r)
end
