package metatrader

import net.http
import conv

func _range_params(date_from: i64, date_to: i64): HashMap<str, str>:
    mut params := HashMap {} as HashMap<str, str>
    params.put("date_from", conv.FormatInt(date_from))
    params.put("date_to", conv.FormatInt(date_to))
    ret params
end

@en "HistoryOrdersTotal"
@fa "تعداد سفارش‌های تاریخچه"
pub func HistoryOrdersTotal(date_from: i64, date_to: i64): int:
    mut out := 0
    r := _get_raw("/history_orders_total", _range_params(date_from, date_to))
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "HistoryOrdersGet"
@fa "دریافت سفارش‌های تاریخچه"
pub func HistoryOrdersGet(date_from: i64, date_to: i64): Vector<TradeOrder>:
    mut out := Vector {} as Vector<TradeOrder>
    r := _get_raw("/history_orders_get", _range_params(date_from, date_to))
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

