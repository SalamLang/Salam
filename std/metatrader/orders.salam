package metatrader

import net.http
import conv
import encoding.json

struct marginRequest:
    action: int = 0
    symbol: str = ""
    volume: f64 = 0.0
    price: f64 = 0.0
end

struct profitRequest:
    action: int = 0
    symbol: str = ""
    volume: f64 = 0.0
    price_open: f64 = 0.0
    price_close: f64 = 0.0
end

@en "OrdersTotal"
@fa "تعداد سفارش‌های فعال"
pub func OrdersTotal(): int:
    mut out := 0
    r := _get_raw("/orders_total", http.NewHeaders())
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "OrdersGet"
@fa "دریافت سفارش‌های فعال"
pub func OrdersGet(): Vector<TradeOrder>:
    mut out := Vector {} as Vector<TradeOrder>
    r := _get_raw("/orders_get", http.NewHeaders())
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "OrdersGetSymbol"
@fa "دریافت سفارش‌های فعال با نماد"
pub func OrdersGetSymbol(symbol: str): Vector<TradeOrder>:
    mut out := Vector {} as Vector<TradeOrder>
    mut params := HashMap {} as HashMap<str, str>
    params.put("symbol", symbol)
    r := _get_raw("/orders_get", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "OrdersGetGroup"
@fa "دریافت سفارش‌های فعال با گروه"
pub func OrdersGetGroup(group: str): Vector<TradeOrder>:
    mut out := Vector {} as Vector<TradeOrder>
    mut params := HashMap {} as HashMap<str, str>
    params.put("group", group)
    r := _get_raw("/orders_get", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "OrdersGetTicket"
@fa "دریافت سفارش فعال با شماره"
pub func OrdersGetTicket(ticket: i64): Vector<TradeOrder>:
    mut out := Vector {} as Vector<TradeOrder>
    mut params := HashMap {} as HashMap<str, str>
    params.put("ticket", conv.FormatInt(ticket))
    r := _get_raw("/orders_get", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "OrderCalcMargin"
@fa "محاسبه حاشیه سفارش"
pub func OrderCalcMargin(action: int, symbol: str, volume: f64, price: f64): f64:
    mut out := 0.0
    req := marginRequest { action = action, symbol = symbol, volume = volume, price = price }
    r := _post_raw("/order_calc_margin", json.Marshal(req))
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "OrderCalcProfit"
@fa "محاسبه سود سفارش"
pub func OrderCalcProfit(action: int, symbol: str, volume: f64, price_open: f64, price_close: f64): f64:
    mut out := 0.0
    req := profitRequest { action = action, symbol = symbol, volume = volume, price_open = price_open, price_close = price_close }
    r := _post_raw("/order_calc_profit", json.Marshal(req))
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "OrderCheck"
@fa "بررسی سفارش"
pub func OrderCheck(request: TradeRequest): OrderCheckResult:
    mut out := OrderCheckResult {}
    r := _post_raw("/order_check", json.Marshal(request))
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "OrderSend"
@fa "ارسال سفارش"
pub func OrderSend(request: TradeRequest): OrderSendResult:
    mut out := OrderSendResult {}
    r := _post_raw("/order_send", json.Marshal(request))
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end
