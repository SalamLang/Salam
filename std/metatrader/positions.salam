package metatrader

import net.http
import conv

@en "PositionsTotal"
@fa "تعداد پوزیشن‌های باز"
pub func PositionsTotal(): int:
    mut out := 0
    r := _get_raw("/positions_total", http.NewHeaders())
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "PositionsGet"
@fa "دریافت پوزیشن‌های باز"
pub func PositionsGet(): Vector<TradePosition>:
    mut out := Vector {} as Vector<TradePosition>
    r := _get_raw("/positions_get", http.NewHeaders())
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "PositionsGetSymbol"
@fa "دریافت پوزیشن‌های باز با نماد"
pub func PositionsGetSymbol(symbol: str): Vector<TradePosition>:
    mut out := Vector {} as Vector<TradePosition>
    mut params := HashMap {} as HashMap<str, str>
    params.put("symbol", symbol)
    r := _get_raw("/positions_get", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "PositionsGetGroup"
@fa "دریافت پوزیشن‌های باز با گروه"
pub func PositionsGetGroup(group: str): Vector<TradePosition>:
    mut out := Vector {} as Vector<TradePosition>
    mut params := HashMap {} as HashMap<str, str>
    params.put("group", group)
    r := _get_raw("/positions_get", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "PositionsGetTicket"
@fa "دریافت پوزیشن باز با شماره"
pub func PositionsGetTicket(ticket: i64): Vector<TradePosition>:
    mut out := Vector {} as Vector<TradePosition>
    mut params := HashMap {} as HashMap<str, str>
    params.put("ticket", conv.FormatInt(ticket))
    r := _get_raw("/positions_get", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end
