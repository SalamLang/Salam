package metatrader

import net.http
import conv

func _rates_params(symbol: str, timeframe: int): HashMap<str, str>:
    mut params := HashMap {} as HashMap<str, str>
    params.put("symbol", symbol)
    params.put("timeframe", conv.FormatInt(timeframe as i64))
    ret params
end

@en "CopyRatesFrom"
@fa "کپی کندل‌ها از تاریخ"
pub func CopyRatesFrom(symbol: str, timeframe: int, date_from: i64, count: int): Vector<Rate>:
    mut out := Vector {} as Vector<Rate>
    mut params := _rates_params(symbol, timeframe)
    params.put("date_from", conv.FormatInt(date_from))
    params.put("count", conv.FormatInt(count as i64))
    r := _get_raw("/copy_rates_from", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "CopyRatesFromPos"
@fa "کپی کندل‌ها از موقعیت"
pub func CopyRatesFromPos(symbol: str, timeframe: int, start_pos: int, count: int): Vector<Rate>:
    mut out := Vector {} as Vector<Rate>
    mut params := _rates_params(symbol, timeframe)
    params.put("start_pos", conv.FormatInt(start_pos as i64))
    params.put("count", conv.FormatInt(count as i64))
    r := _get_raw("/copy_rates_from_pos", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "CopyRatesRange"
@fa "کپی‌کندل‌ها‌در‌بازه"
pub func CopyRatesRange(symbol: str, timeframe: int, date_from: i64, date_to: i64): Vector<Rate>:
    mut out := Vector {} as Vector<Rate>
    mut params := _rates_params(symbol, timeframe)
    params.put("date_from", conv.FormatInt(date_from))
    params.put("date_to", conv.FormatInt(date_to))
    r := _get_raw("/copy_rates_range", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end
