package metatrader

import net.http
import conv

@en "CopyTicksFrom"
@fa "کپی نوسانات از تاریخ"
pub func CopyTicksFrom(symbol: str, date_from: i64, count: int, flags: int): Vector<Tick>:
    mut out := Vector {} as Vector<Tick>
    mut params := HashMap {} as HashMap<str, str>
    params.put("symbol", symbol)
    params.put("date_from", conv.FormatInt(date_from))
    params.put("count", conv.FormatInt(count as i64))
    params.put("flags", conv.FormatInt(flags as i64))
    r := _get_raw("/copy_ticks_from", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "CopyTicksRange"
@fa "کپی‌نوسانات‌در‌بازه"
pub func CopyTicksRange(symbol: str, date_from: i64, date_to: i64, flags: int): Vector<Tick>:
    mut out := Vector {} as Vector<Tick>
    mut params := HashMap {} as HashMap<str, str>
    params.put("symbol", symbol)
    params.put("date_from", conv.FormatInt(date_from))
    params.put("date_to", conv.FormatInt(date_to))
    params.put("flags", conv.FormatInt(flags as i64))
    r := _get_raw("/copy_ticks_range", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end
