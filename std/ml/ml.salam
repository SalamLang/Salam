@en "ml"
@fa "یادگیری ماشین"
@ar "تعلم الآلة"
package ml

import matrix

@en "TREE_GINI"
@fa "معیار جینی"
@ar "معيار جيني"
pub const TREE_GINI := 0

@en "TREE_ENTROPY"
@fa "معیار آنتروپی"
@ar "معيار الانتروبيا"
pub const TREE_ENTROPY := 1

@en "TREE_MSE"
@fa "معیار میانگین مربعات"
@ar "معيار متوسط المربعات"
pub const TREE_MSE := 2

@en "IMPUTE_MEAN"
@fa "جایگذاری میانگین"
@ar "تعويض بالمتوسط"
pub const IMPUTE_MEAN := 0

@en "IMPUTE_MEDIAN"
@fa "جایگذاری میانه"
@ar "تعويض بالوسيط"
pub const IMPUTE_MEDIAN := 1

@en "IMPUTE_CONSTANT"
@fa "جایگذاری ثابت"
@ar "تعويض بثابت"
pub const IMPUTE_CONSTANT := 2

@en "ML_TOL"
@fa "رواداری یادگیری"
@ar "تسامح التعلم"
pub const ML_TOL := 1.0e-6

@en "LabelsToInts"
@fa "برچسب به عدد"
@ar "تسميات إلى أعداد"
pub func LabelsToInts(y &: matrix.Matrix): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat y.rows with i: out.push(y.at(i, 0) as int) end
    ret out
end

@en "CountClasses"
@fa "شمارش رده‌ها"
@ar "عد الفئات"
pub func CountClasses(y &: matrix.Matrix): int:
    mut best := 0 - 1
    repeat y.rows with i:
        v := y.at(i, 0) as int
        if v > best: best = v end
    end
    ret best + 1
end
