@en "ml"
@fa "یادگیری ماشین"
@ar "تعلم الآلة"
package ml

import matrix

// Classical machine learning over std/matrix: preprocessing, linear and
// logistic models, neighbors, naive Bayes, trees and forests, boosting,
// support vector machines, clustering, decomposition, metrics and model
// selection.
//
// Every estimator follows one convention, which stands in for the class
// hierarchy other libraries use:
//
//   - One struct per model. Hyperparameters are public fields with the
//     customary defaults, so a model is built with a struct literal:
//     `ml.KMeans { k = 3, seed = 7 }`. Learned state is public fields
//     too (`coef`, `centers`, `classes`), plus `ok`, which fit sets.
//   - Methods, in this order where they apply: fit (returns success and
//     sets ok), predict, predict_proba, transform, fit_predict or
//     fit_transform, score, free.
//   - Data shapes never vary. Features are an n x p Matrix; targets and
//     labels are an n x 1 Matrix, class labels as whole numbers 0, 1, 2
//     ... stored in f64. Predictions come back n x 1, probabilities n x k.
//     One family of shapes means every model, metric and splitter
//     composes without conversions.
//   - Errors are std/matrix's: fit returns false on a bad or degenerate
//     input; predict or transform on an unfitted model returns the 0x0
//     matrix (check is_empty()). Nothing panics.
//   - Ownership is std/matrix's too: fit borrows its arguments and copies
//     what it must keep; every returned matrix is the caller's to free;
//     model.free() releases the learned state and is safe on a model that
//     never fit.
//   - Every stochastic algorithm carries `seed: i64 = 42` and draws from
//     its own matrix.NewRng(seed), never from std/rand's global state.
//     Parallel work derives one stream per task (tensor.DeriveSeed's
//     constant), so results are identical at any worker count and a
//     demo's accuracy can live in a checked-in expected-output file.
//   - NaN is the missing-value marker (math.NaN, math.IsNaN). The CSV
//     loader in std/data emits it, SimpleImputer consumes it, and every
//     other estimator may assume it is gone.

// Split criteria for decision trees.
@en "TREE_GINI"
@fa "معیار جینی"
@ar "معيار جيني"
pub const TREE_GINI := 0

@en "TREE_ENTROPY"
@fa "معیار آنتروپی"
@ar "معيار الانتروبيا"
pub const TREE_ENTROPY := 1

@en "TREE_MSE"
@fa "معیار میانگین مربعات"
@ar "معيار متوسط المربعات"
pub const TREE_MSE := 2

// Fill strategies for SimpleImputer.
@en "IMPUTE_MEAN"
@fa "جایگذاری میانگین"
@ar "تعويض بالمتوسط"
pub const IMPUTE_MEAN := 0

@en "IMPUTE_MEDIAN"
@fa "جایگذاری میانه"
@ar "تعويض بالوسيط"
pub const IMPUTE_MEDIAN := 1

@en "IMPUTE_CONSTANT"
@fa "جایگذاری ثابت"
@ar "تعويض بثابت"
pub const IMPUTE_CONSTANT := 2

// The default convergence slack for iterative fitters.
@en "ML_TOL"
@fa "رواداری یادگیری"
@ar "تسامح التعلم"
pub const ML_TOL := 1.0e-6

// ---- public API ----

// Class labels of an n x 1 label matrix as a Vector<int>, the form the
// tensor-side losses take.
@en "LabelsToInts"
@fa "برچسب به عدد"
@ar "تسميات إلى أعداد"
pub func LabelsToInts(y &: matrix.Matrix): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat y.rows with i: out.push(y.at(i, 0) as int) end
    ret out
end

// How many distinct whole-number classes a label column holds: one past
// its largest label.
@en "CountClasses"
@fa "شمارش رده‌ها"
@ar "عد الفئات"
pub func CountClasses(y &: matrix.Matrix): int:
    mut best := 0 - 1
    repeat y.rows with i:
        v := y.at(i, 0) as int
        if v > best: best = v end
    end
    ret best + 1
end
