package ml

import math
import matrix

// Gaussian naive Bayes: each feature is modeled as an independent
// normal per class. fit() collects per-class means and variances plus
// log priors; prediction sums log-likelihoods and normalizes through a
// softmax. var_smoothing adds a fraction of the largest feature variance
// to every variance, the standard guard against a feature that is
// constant within a class.

@en "GaussianNB"
@fa "بیز ساده گاوسی"
@ar "بايز الساذج الغاوسي"
pub struct GaussianNB:
    pub var_smoothing: f64 = 0.000000001
    pub means: matrix.Matrix = matrix.Matrix {}
    pub vars: matrix.Matrix = matrix.Matrix {}
    pub log_priors: matrix.Matrix = matrix.Matrix {}
    pub n_classes: int = 0
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || y.rows != x.rows || y.cols != 1: ret false end
        k := CountClasses(y)
        if k < 1: ret false end
        p := x.cols
        n := x.rows
        matrix.Free(this.means)
        matrix.Free(this.vars)
        matrix.Free(this.log_priors)
        this.means = matrix.Zeros(k, p)
        this.vars = matrix.Zeros(k, p)
        this.log_priors = matrix.Zeros(k, 1)
        mut counts := Vector {} as Vector<int>
        counts.zeros(k)
        repeat n with i:
            c := y.at(i, 0) as int
            counts.set(c, counts.get(c) + 1)
            repeat p with j: this.means.add_at(c, j, x.at(i, j)) end
        end
        repeat k with c:
            if counts.get(c) > 0:
                repeat p with j: this.means.mul_at(c, j, 1.0 / (counts.get(c) as f64)) end
            end
        end
        repeat n with i:
            c := y.at(i, 0) as int
            repeat p with j:
                d := x.at(i, j) - this.means.at(c, j)
                this.vars.add_at(c, j, d * d)
            end
        end
        // The largest overall feature variance sets the smoothing floor.
        mut vmax := 0.0
        repeat p with j:
            m := _col_mean(x, j)
            v := _col_std(x, j, m)
            if v * v > vmax: vmax = v * v end
        end
        eps := this.var_smoothing * vmax
        repeat k with c:
            cnt := counts.get(c)
            if cnt > 0:
                repeat p with j: this.vars.set(c, j, this.vars.at(c, j) / (cnt as f64) + eps) end
                this.log_priors.set(c, 0, math.Log((cnt as f64) / (n as f64)))
            else:
                repeat p with j: this.vars.set(c, j, 1.0) end
                this.log_priors.set(c, 0, 0.0 - 700.0)
            end
        end
        counts.free()
        this.n_classes = k
        this.ok = true
        ret true
    end

    // Per-class posteriors, row-normalized.
    @en "predict_proba"
    @fa "پیش‌بینی احتمال"
    @ar "تنبؤ بالاحتمال"
    pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.means.cols: ret matrix.Matrix {} end
        k := this.n_classes
        p := x.cols
        mut out := matrix.Zeros(x.rows, k)
        half_log_2pi := 0.5 * math.Log(2.0 * math.PI)
        repeat x.rows with i:
            mut m := 0.0 - 1.0e300
            repeat k with c:
                mut ll := this.log_priors.at(c, 0)
                repeat p with j:
                    v := this.vars.at(c, j)
                    d := x.at(i, j) - this.means.at(c, j)
                    ll -= half_log_2pi + 0.5 * math.Log(v) + d * d / (2.0 * v)
                end
                out.set(i, c, ll)
                if ll > m: m = ll end
            end
            mut s := 0.0
            repeat k with c:
                e := math.Exp(out.at(i, c) - m)
                out.set(i, c, e)
                s += e
            end
            repeat k with c: out.set(i, c, out.at(i, c) / s) end
        end
        ret out
    end

    @en "predict"
    @fa "پیش‌بینی"
    @ar "تنبؤ"
    pub func predict(x &: matrix.Matrix): matrix.Matrix:
        mut probs := this.predict_proba(x)
        if probs.is_empty(): ret probs end
        mut out := matrix.Zeros(x.rows, 1)
        repeat x.rows with i:
            mut best := 0
            repeat this.n_classes with c:
                if probs.at(i, c) > probs.at(i, best): best = c end
            end
            out.set(i, 0, best as f64)
        end
        matrix.Free(probs)
        ret out
    end

    @en "score"
    @fa "امتیاز"
    @ar "درجة"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.predict(x)
        if p.is_empty(): ret 0.0 end
        r := Accuracy(y, p)
        matrix.Free(p)
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        matrix.Free(this.means)
        matrix.Free(this.vars)
        matrix.Free(this.log_priors)
    end
end

// Multinomial naive Bayes: features are counts (word frequencies, bag
// of words), and each class holds one categorical distribution over
// them, Laplace-smoothed by `alpha`. The decision is linear in the
// counts, which is why this is the classic text classifier.
//
// Negative entries are refused: this model is about counts.
@en "MultinomialNB"
@fa "بیز ساده چندجمله‌ای"
@ar "بايز الساذج متعدد الحدود"
pub struct MultinomialNB:
    pub alpha: f64 = 1.0
    pub fit_prior: bool = true
    pub log_prob: matrix.Matrix = matrix.Matrix {}
    pub log_priors: matrix.Matrix = matrix.Matrix {}
    pub n_classes: int = 0
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || y.rows != x.rows || y.cols != 1: ret false end
        repeat x.count() with t:
            if x.a.get(t) < 0.0: ret false end
        end
        k := CountClasses(y)
        if k < 1: ret false end
        n := x.rows
        p := x.cols
        matrix.Free(this.log_prob)
        matrix.Free(this.log_priors)
        this.log_prob = matrix.Zeros(k, p)
        this.log_priors = matrix.Zeros(k, 1)
        mut counts := Vector {} as Vector<int>
        counts.zeros(k)
        repeat n with i:
            c := y.at(i, 0) as int
            counts.set(c, counts.get(c) + 1)
            repeat p with j: this.log_prob.add_at(c, j, x.at(i, j)) end
        end
        repeat k with c:
            mut total := 0.0
            repeat p with j: total += this.log_prob.at(c, j) + this.alpha end
            repeat p with j:
                v := (this.log_prob.at(c, j) + this.alpha) / total
                this.log_prob.set(c, j, math.Log(v))
            end
            mut prior := 1.0 / (k as f64)
            if this.fit_prior && n > 0: prior = (counts.get(c) as f64) / (n as f64) end
            if prior <= 0.0: prior = 1.0 / ((n + k) as f64) end
            this.log_priors.set(c, 0, math.Log(prior))
        end
        counts.free()
        this.n_classes = k
        this.ok = true
        ret true
    end

    // Unnormalized log joint likelihood, n x k.
    @en "decision"
    @fa "تصمیم"
    @ar "قرار"
    pub func decision(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.log_prob.cols: ret matrix.Matrix {} end
        mut out := matrix.MulTranspose(x, this.log_prob)
        repeat out.rows with i:
            repeat this.n_classes with c: out.add_at(i, c, this.log_priors.at(c, 0)) end
        end
        ret out
    end

    @en "predict_proba"
    @fa "پیش‌بینی احتمال"
    @ar "تنبؤ بالاحتمال"
    pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
        mut out := this.decision(x)
        if out.is_empty(): ret out end
        repeat out.rows with i:
            mut mx := out.at(i, 0)
            repeat this.n_classes with c:
                if out.at(i, c) > mx: mx = out.at(i, c) end
            end
            mut s := 0.0
            repeat this.n_classes with c:
                e := math.Exp(out.at(i, c) - mx)
                out.set(i, c, e)
                s += e
            end
            repeat this.n_classes with c: out.set(i, c, out.at(i, c) / s) end
        end
        ret out
    end

    @en "predict"
    @fa "پیش‌بینی"
    @ar "تنبؤ"
    pub func predict(x &: matrix.Matrix): matrix.Matrix:
        mut d := this.decision(x)
        if d.is_empty(): ret d end
        mut out := matrix.Zeros(x.rows, 1)
        repeat x.rows with i:
            mut best := 0
            repeat this.n_classes with c:
                if d.at(i, c) > d.at(i, best): best = c end
            end
            out.set(i, 0, best as f64)
        end
        matrix.Free(d)
        ret out
    end

    @en "score"
    @fa "امتیاز"
    @ar "درجة"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.predict(x)
        if p.is_empty(): ret 0.0 end
        r := Accuracy(y, p)
        matrix.Free(p)
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        matrix.Free(this.log_prob)
        matrix.Free(this.log_priors)
    end
end
