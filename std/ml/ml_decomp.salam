package ml

import matrix

// Dimensionality reduction. PCA wraps std/matrix's PCAFit/PCATransform
// in the estimator convention, keeping the first n_components
// directions (all of them when n_components is 0); the explained
// variance ratio is exposed for the usual scree decision.

@en "PCA"
@fa "تحلیل مؤلفه اصلی"
@ar "تحليل المكونات الرئيسية"
pub struct PCA:
    pub n_components: int = 0
    pub components: matrix.Matrix = matrix.Matrix {}
    pub mean: matrix.Matrix = matrix.Matrix {}
    pub explained_variance: matrix.Matrix = matrix.Matrix {}
    pub explained_ratio: matrix.Matrix = matrix.Matrix {}
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || x.rows < 2: ret false end
        mut full := matrix.PCAFit(x)
        if full.components.is_empty():
            full.free()
            ret false
        end
        mut keep := this.n_components
        if keep <= 0 || keep > full.components.cols: keep = full.components.cols end
        matrix.Free(this.components)
        matrix.Free(this.mean)
        matrix.Free(this.explained_variance)
        matrix.Free(this.explained_ratio)
        // Components come back one per column; keep the leading ones.
        this.components = matrix.SubMatrix(full.components, 0, 0, full.components.rows, keep)
        this.mean = matrix.Clone(full.center)
        this.explained_variance = matrix.SubMatrix(full.variances, 0, 0, 1, keep)
        mut total := 0.0
        repeat full.variances.count() with t: total += full.variances.a.get(t) end
        this.explained_ratio = matrix.Zeros(1, keep)
        if total > 0.0:
            repeat keep with j: this.explained_ratio.set(0, j, this.explained_variance.at(0, j) / total) end
        end
        full.free()
        this.n_components = keep
        this.ok = true
        ret true
    end

    // Projects rows onto the kept components: (x - mean) W.
    @en "transform"
    @fa "تبدیل"
    @ar "تحويل"
    pub func transform(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.components.rows: ret matrix.Matrix {} end
        mut xc := matrix.Clone(x)
        repeat x.rows with i:
            repeat x.cols with j: xc.add_at(i, j, 0.0 - this.mean.at(0, j)) end
        end
        r := matrix.MatMul(xc, this.components)
        matrix.Free(xc)
        ret r
    end

    @en "fit_transform"
    @fa "برازش و تبدیل"
    @ar "ملاءمة وتحويل"
    pub func fit_transform(x &: matrix.Matrix): matrix.Matrix:
        if this.fit(x) == false: ret matrix.Matrix {} end
        ret this.transform(x)
    end

    // Back to the original space: z W' + mean.
    @en "inverse_transform"
    @fa "تبدیل معکوس"
    @ar "تحويل عكسي"
    pub func inverse_transform(z &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || z.cols != this.components.cols: ret matrix.Matrix {} end
        mut r := matrix.MulTranspose(z, this.components)
        repeat r.rows with i:
            repeat r.cols with j: r.add_at(i, j, this.mean.at(0, j)) end
        end
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        matrix.Free(this.components)
        matrix.Free(this.mean)
        matrix.Free(this.explained_variance)
        matrix.Free(this.explained_ratio)
    end
end

// Truncated SVD, the "LSA" decomposition: the top components of the
// data itself, with no centering, so a sparse-in-spirit term-document
// matrix keeps its zeros meaningful. PCA is this on centered data.
@en "TruncatedSVD"
@fa "تجزیه مقادیر تکین بریده"
@ar "تحليل القيم المفردة المبتور"
pub struct TruncatedSVD:
    pub n_components: int = 2
    pub components: matrix.Matrix = matrix.Matrix {}
    pub singular_values: matrix.Matrix = matrix.Matrix {}
    pub explained_variance: matrix.Matrix = matrix.Matrix {}
    pub explained_ratio: matrix.Matrix = matrix.Matrix {}
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty(): ret false end
        mut k := this.n_components
        mut most := x.cols
        if x.rows < most: most = x.rows end
        if k < 1 || k > most: k = most end
        mut f := matrix.SVDecompose(x)
        if f.ok == false:
            f.free()
            ret false
        end
        matrix.Free(this.components)
        matrix.Free(this.singular_values)
        matrix.Free(this.explained_variance)
        matrix.Free(this.explained_ratio)
        this.components = matrix.SubMatrix(f.v, 0, 0, x.cols, k)
        this.singular_values = matrix.Zeros(1, k)
        this.explained_variance = matrix.Zeros(1, k)
        this.explained_ratio = matrix.Zeros(1, k)
        nf := (x.rows - 1) as f64
        // The variance a component carries is s^2 / (n - 1); the ratio is
        // against the total squared magnitude of the uncentered data.
        mut total := 0.0
        repeat x.rows with i:
            repeat x.cols with j: total += x.at(i, j) * x.at(i, j) end
        end
        repeat k with c:
            s := f.s.at(0, c)
            this.singular_values.set(0, c, s)
            this.explained_variance.set(0, c, nf > 0.0 ? s * s / nf : 0.0)
            this.explained_ratio.set(0, c, total > 0.0 ? s * s / total : 0.0)
        end
        f.free()
        this.n_components = k
        this.ok = true
        ret true
    end

    @en "transform"
    @fa "تبدیل"
    @ar "تحويل"
    pub func transform(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.components.rows: ret matrix.Matrix {} end
        ret matrix.MatMul(x, this.components)
    end

    @en "fit_transform"
    @fa "برازش و تبدیل"
    @ar "ملاءمة وتحويل"
    pub func fit_transform(x &: matrix.Matrix): matrix.Matrix:
        if this.fit(x) == false: ret matrix.Matrix {} end
        ret this.transform(x)
    end

    @en "inverse_transform"
    @fa "تبدیل معکوس"
    @ar "تحويل عكسي"
    pub func inverse_transform(z &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || z.cols != this.components.cols: ret matrix.Matrix {} end
        ret matrix.MulTranspose(z, this.components)
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        matrix.Free(this.components)
        matrix.Free(this.singular_values)
        matrix.Free(this.explained_variance)
        matrix.Free(this.explained_ratio)
    end
end
