package ml

import math
import matrix

// Linear models.
//
//   LinearReg   ordinary least squares through std/matrix's QR solver
//   Ridge       (X'X + alpha I) w = X'y, one Cholesky solve
//   Lasso       coordinate descent on the elastic-net objective
//               1/(2n) |y - Xw|^2 + alpha l1 |w|_1 + alpha (1-l1)/2 |w|^2
//               (l1_ratio = 1 is the lasso, < 1 the elastic net)
//   LogisticRegression  multinomial softmax regression by accelerated
//               gradient descent with an L2 penalty. The step is set from
//               a Lipschitz bound of the loss (0.25 |X|_F^2 / n + alpha),
//               so it converges without a learning rate to tune; two
//               classes are the K = 2 case of the same code.
//
// The intercept is fitted by centering: with fit_intercept the columns
// of X and the target are shifted to zero mean, the coefficients are
// fitted on the centered data, and the intercept is recovered as
// y_mean - x_mean . w. That keeps every solver a plain linear problem
// and leaves the intercept unpenalized, which is what the textbooks
// and scikit-learn both do.

@en "LinearReg"
@fa "رگرسیون خطی"
@ar "انحدار خطي"
pub struct LinearReg:
    pub fit_intercept: bool = true
    pub coef: matrix.Matrix = matrix.Matrix {}
    pub intercept: f64 = 0.0
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || y.rows != x.rows || y.cols != 1: ret false end
        mut xm := matrix.Zeros(1, x.cols)
        mut ym := 0.0
        mut xc := _centered(x, this.fit_intercept, xm)
        mut yc := _centered_col(y, this.fit_intercept, ym)
        w := matrix.LeastSquares(xc, yc)
        matrix.Free(xc)
        matrix.Free(yc)
        if w.is_empty():
            matrix.Free(xm)
            ret false
        end
        matrix.Free(this.coef)
        this.coef = w
        this.intercept = _intercept_of(xm, ym, this.coef)
        matrix.Free(xm)
        this.ok = true
        ret true
    end

    @en "predict"
    @fa "پیش‌بینی"
    @ar "تنبؤ"
    pub func predict(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.coef.rows: ret matrix.Matrix {} end
        ret _linear_predict(x, this.coef, this.intercept)
    end

    @en "score"
    @fa "امتیاز"
    @ar "درجة"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.predict(x)
        if p.is_empty(): ret 0.0 end
        r := R2Score(y, p)
        matrix.Free(p)
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free(): matrix.Free(this.coef) end
end

@en "Ridge"
@fa "رگرسیون ستیغی"
@ar "انحدار ريدج"
pub struct Ridge:
    pub alpha: f64 = 1.0
    pub fit_intercept: bool = true
    pub coef: matrix.Matrix = matrix.Matrix {}
    pub intercept: f64 = 0.0
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || y.rows != x.rows || y.cols != 1: ret false end
        mut xm := matrix.Zeros(1, x.cols)
        mut ym := 0.0
        mut xc := _centered(x, this.fit_intercept, xm)
        mut yc := _centered_col(y, this.fit_intercept, ym)
        mut g := matrix.TransposeMul(xc, xc)
        repeat x.cols with j: g.add_at(j, j, this.alpha) end
        mut rhs := matrix.TransposeMul(xc, yc)
        w := matrix.SolveSPD(g, rhs)
        matrix.Free(xc)
        matrix.Free(yc)
        matrix.Free(g)
        matrix.Free(rhs)
        if w.is_empty():
            matrix.Free(xm)
            ret false
        end
        matrix.Free(this.coef)
        this.coef = w
        this.intercept = _intercept_of(xm, ym, this.coef)
        matrix.Free(xm)
        this.ok = true
        ret true
    end

    @en "predict"
    @fa "پیش‌بینی"
    @ar "تنبؤ"
    pub func predict(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.coef.rows: ret matrix.Matrix {} end
        ret _linear_predict(x, this.coef, this.intercept)
    end

    @en "score"
    @fa "امتیاز"
    @ar "درجة"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.predict(x)
        if p.is_empty(): ret 0.0 end
        r := R2Score(y, p)
        matrix.Free(p)
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free(): matrix.Free(this.coef) end
end

@en "Lasso"
@fa "لاسو"
@ar "لاسو"
pub struct Lasso:
    pub alpha: f64 = 1.0
    pub l1_ratio: f64 = 1.0
    pub fit_intercept: bool = true
    pub max_iter: int = 1000
    pub tol: f64 = 0.0001
    pub coef: matrix.Matrix = matrix.Matrix {}
    pub intercept: f64 = 0.0
    pub n_iter: int = 0
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || y.rows != x.rows || y.cols != 1: ret false end
        n := x.rows
        p := x.cols
        mut xm := matrix.Zeros(1, p)
        mut ym := 0.0
        mut xc := _centered(x, this.fit_intercept, xm)
        mut yc := _centered_col(y, this.fit_intercept, ym)
        mut w := matrix.Zeros(p, 1)
        // Residual r = y - X w, kept current as coordinates move.
        mut r := matrix.Clone(yc)
        nf := n as f64
        l1 := this.alpha * this.l1_ratio
        l2 := this.alpha * (1.0 - this.l1_ratio)
        // Column norms squared over n, the denominators of every update.
        mut colsq := Vector {} as Vector<f64>
        repeat p with j:
            mut s := 0.0
            repeat n with i: s += xc.at(i, j) * xc.at(i, j) end
            colsq.push(s / nf)
        end
        mut it := 0
        mut converged := false
        until it < this.max_iter && converged == false:
            mut max_delta := 0.0
            repeat p with j:
                wj := w.at(j, 0)
                // rho = x_j . (r + x_j wj) / n
                mut rho := 0.0
                repeat n with i: rho += xc.at(i, j) * (r.at(i, 0) + xc.at(i, j) * wj) end
                rho = rho / nf
                mut nw := 0.0
                denom := colsq.get(j) + l2
                if denom > 0.0:
                    mut soft := 0.0
                    if rho > l1: soft = rho - l1
                    else rho < 0.0 - l1: soft = rho + l1 end
                    nw = soft / denom
                end
                d := nw - wj
                if d != 0.0:
                    repeat n with i: r.set(i, 0, r.at(i, 0) - xc.at(i, j) * d) end
                    w.set(j, 0, nw)
                end
                mut ad := d
                if ad < 0.0: ad = 0.0 - ad end
                if ad > max_delta: max_delta = ad end
            end
            it += 1
            if max_delta < this.tol: converged = true end
        end
        this.n_iter = it
        colsq.free()
        matrix.Free(xc)
        matrix.Free(yc)
        matrix.Free(r)
        matrix.Free(this.coef)
        this.coef = w
        this.intercept = _intercept_of(xm, ym, this.coef)
        matrix.Free(xm)
        this.ok = true
        ret true
    end

    @en "predict"
    @fa "پیش‌بینی"
    @ar "تنبؤ"
    pub func predict(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.coef.rows: ret matrix.Matrix {} end
        ret _linear_predict(x, this.coef, this.intercept)
    end

    @en "score"
    @fa "امتیاز"
    @ar "درجة"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.predict(x)
        if p.is_empty(): ret 0.0 end
        r := R2Score(y, p)
        matrix.Free(p)
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free(): matrix.Free(this.coef) end
end

@en "LogisticRegression"
@fa "رگرسیون لجستیک"
@ar "انحدار لوجستي"
pub struct LogisticRegression:
    pub alpha: f64 = 0.0001
    pub fit_intercept: bool = true
    pub max_iter: int = 500
    pub tol: f64 = 0.000001
    pub coef: matrix.Matrix = matrix.Matrix {}
    pub intercept: matrix.Matrix = matrix.Matrix {}
    pub n_classes: int = 0
    pub n_iter: int = 0
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || y.rows != x.rows || y.cols != 1: ret false end
        n := x.rows
        p := x.cols
        k := CountClasses(y)
        if k < 2: ret false end
        nf := n as f64
        // Center the features; the intercept column then needs no
        // penalty and no special casing in the gradient.
        mut xm := matrix.Zeros(1, p)
        mut xc := _centered(x, this.fit_intercept, xm)
        mut w := matrix.Zeros(p, k)
        mut b := matrix.Zeros(1, k)
        // Lipschitz constant of the softmax loss gradient, an upper
        // bound: 0.25 * |X|_F^2 / n, plus the penalty's alpha.
        mut fro := 0.0
        repeat n * p with t: fro += xc.a.get(t) * xc.a.get(t) end
        step := 1.0 / (0.25 * fro / nf + this.alpha + 1.0e-12)
        // Nesterov momentum state.
        mut wv := matrix.Zeros(p, k)
        mut bv := matrix.Zeros(1, k)
        mut prev_w := matrix.Zeros(p, k)
        mut prev_b := matrix.Zeros(1, k)
        mut gw := matrix.Zeros(p, k)
        mut gb := matrix.Zeros(1, k)
        mut probs := matrix.Zeros(n, k)
        mut it := 0
        mut done := false
        until it < this.max_iter && done == false:
            // Gradient at the look-ahead point (wv, bv).
            _softmax_scores(xc, wv, bv, probs)
            matrix.SetAll(gw, 0.0)
            matrix.SetAll(gb, 0.0)
            repeat n with i:
                t := y.at(i, 0) as int
                repeat k with c:
                    mut d := probs.at(i, c)
                    if c == t: d = d - 1.0 end
                    d = d / nf
                    gb.add_at(0, c, d)
                    repeat p with j: gw.add_at(j, c, xc.at(i, j) * d) end
                end
            end
            repeat p * k with t: gw.a.set(t, gw.a.get(t) + this.alpha * wv.a.get(t)) end
            // Descent step from the look-ahead, then the momentum extrapolation.
            mom := (it as f64) / ((it + 3) as f64)
            mut max_delta := 0.0
            repeat p * k with t:
                nw := wv.a.get(t) - step * gw.a.get(t)
                d := nw - prev_w.a.get(t)
                mut ad := d
                if ad < 0.0: ad = 0.0 - ad end
                if ad > max_delta: max_delta = ad end
                wv.a.set(t, nw + mom * d)
                prev_w.a.set(t, nw)
                w.a.set(t, nw)
            end
            if this.fit_intercept:
                repeat k with c:
                    nb := bv.at(0, c) - step * gb.at(0, c)
                    d := nb - prev_b.at(0, c)
                    bv.set(0, c, nb + mom * d)
                    prev_b.set(0, c, nb)
                    b.set(0, c, nb)
                end
            end
            it += 1
            if max_delta < this.tol: done = true end
        end
        this.n_iter = it
        matrix.Free(this.coef)
        matrix.Free(this.intercept)
        this.coef = w
        // Undo the centering: b_c -= x_mean . w_c.
        repeat k with c:
            mut shift := 0.0
            repeat p with j: shift += xm.at(0, j) * w.at(j, c) end
            b.set(0, c, b.at(0, c) - shift)
        end
        this.intercept = b
        this.n_classes = k
        matrix.Free(xc)
        matrix.Free(xm)
        matrix.Free(wv)
        matrix.Free(bv)
        matrix.Free(prev_w)
        matrix.Free(prev_b)
        matrix.Free(gw)
        matrix.Free(gb)
        matrix.Free(probs)
        this.ok = true
        ret true
    end

    @en "predict_proba"
    @fa "پیش‌بینی احتمال"
    @ar "تنبؤ بالاحتمال"
    pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.coef.rows: ret matrix.Matrix {} end
        mut probs := matrix.Zeros(x.rows, this.n_classes)
        _softmax_scores(x, this.coef, this.intercept, probs)
        ret probs
    end

    @en "predict"
    @fa "پیش‌بینی"
    @ar "تنبؤ"
    pub func predict(x &: matrix.Matrix): matrix.Matrix:
        mut probs := this.predict_proba(x)
        if probs.is_empty(): ret probs end
        mut out := matrix.Zeros(x.rows, 1)
        repeat x.rows with i:
            mut best := 0
            repeat this.n_classes with c:
                if probs.at(i, c) > probs.at(i, best): best = c end
            end
            out.set(i, 0, best as f64)
        end
        matrix.Free(probs)
        ret out
    end

    @en "score"
    @fa "امتیاز"
    @ar "درجة"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.predict(x)
        if p.is_empty(): ret 0.0 end
        r := Accuracy(y, p)
        matrix.Free(p)
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        matrix.Free(this.coef)
        matrix.Free(this.intercept)
    end
end

// x with its column means removed (or a plain copy when centering is
// off); the means land in `mean_out` (1 x p, caller-owned).
func _centered(x &: matrix.Matrix, center: bool, mean_out &: matrix.Matrix): matrix.Matrix:
    mut r := matrix.Clone(x)
    if center == false: ret r end
    repeat x.cols with j:
        m := _col_mean(x, j)
        mean_out.set(0, j, m)
        repeat x.rows with i: r.set(i, j, x.at(i, j) - m) end
    end
    ret r
end

func _centered_col(y &: matrix.Matrix, center: bool, mean_out &: f64): matrix.Matrix:
    mut r := matrix.Clone(y)
    mean_out = 0.0
    if center == false: ret r end
    m := _col_mean(y, 0)
    mean_out = m
    repeat y.rows with i: r.set(i, 0, y.at(i, 0) - m) end
    ret r
end

func _intercept_of(xm &: matrix.Matrix, ym: f64, w &: matrix.Matrix): f64:
    mut s := ym
    repeat w.rows with j: s -= xm.at(0, j) * w.at(j, 0) end
    ret s
end

func _linear_predict(x &: matrix.Matrix, w &: matrix.Matrix, b: f64): matrix.Matrix:
    mut p := matrix.MatMul(x, w)
    repeat p.rows with i: p.add_at(i, 0, b) end
    ret p
end

// Row-wise softmax of x w + b into `out` (n x k, caller-owned).
func _softmax_scores(x &: matrix.Matrix, w &: matrix.Matrix, b &: matrix.Matrix, out &: matrix.Matrix):
    mut z := matrix.MatMul(x, w)
    k := w.cols
    repeat x.rows with i:
        mut m := z.at(i, 0) + b.at(0, 0)
        repeat k with c:
            v := z.at(i, c) + b.at(0, c)
            if v > m: m = v end
        end
        mut s := 0.0
        repeat k with c:
            e := math.Exp(z.at(i, c) + b.at(0, c) - m)
            out.set(i, c, e)
            s += e
        end
        repeat k with c: out.set(i, c, out.at(i, c) / s) end
    end
    matrix.Free(z)
end
