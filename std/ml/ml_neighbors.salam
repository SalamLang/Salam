package ml

import matrix
import sort

// k-nearest neighbors, brute force. fit() copies the training set;
// each query computes its squared Euclidean distance to every stored
// row and takes the k smallest. O(n) memory per model and O(n log n)
// per query, which is the right trade until n reaches the hundreds of
// thousands - a tree index is a later addition, not a different API.
//
// Classification votes (optionally by inverse distance) with ties going
// to the lower class index; regression averages the neighbors' targets.

@en "KNNClassifier"
@fa "دسته‌بند نزدیک‌ترین همسایه"
@ar "مصنف أقرب الجيران"
pub struct KNNClassifier:
    pub k: int = 5
    pub weighted: bool = false
    pub xtrain: matrix.Matrix = matrix.Matrix {}
    pub ytrain: matrix.Matrix = matrix.Matrix {}
    pub n_classes: int = 0
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || y.rows != x.rows || y.cols != 1 || this.k < 1: ret false end
        matrix.Free(this.xtrain)
        matrix.Free(this.ytrain)
        this.xtrain = matrix.Clone(x)
        this.ytrain = matrix.Clone(y)
        this.n_classes = CountClasses(y)
        this.ok = this.n_classes > 0
        ret this.ok
    end

    @en "predict_proba"
    @fa "پیش‌بینی احتمال"
    @ar "تنبؤ بالاحتمال"
    pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.xtrain.cols: ret matrix.Matrix {} end
        mut out := matrix.Zeros(x.rows, this.n_classes)
        mut dist := Vector {} as Vector<f64>
        repeat x.rows with qi:
            mut nb := _nearest(this.xtrain, x, qi, this.k, dist)
            mut total := 0.0
            repeat nb.len() with t:
                c := this.ytrain.at(nb.get(t), 0) as int
                mut wgt := 1.0
                if this.weighted: wgt = 1.0 / (dist.get(t) + 0.000000001) end
                out.add_at(qi, c, wgt)
                total += wgt
            end
            if total > 0.0:
                repeat this.n_classes with c: out.set(qi, c, out.at(qi, c) / total) end
            end
            nb.free()
        end
        dist.free()
        ret out
    end

    @en "predict"
    @fa "پیش‌بینی"
    @ar "تنبؤ"
    pub func predict(x &: matrix.Matrix): matrix.Matrix:
        mut probs := this.predict_proba(x)
        if probs.is_empty(): ret probs end
        mut out := matrix.Zeros(x.rows, 1)
        repeat x.rows with i:
            mut best := 0
            repeat this.n_classes with c:
                if probs.at(i, c) > probs.at(i, best): best = c end
            end
            out.set(i, 0, best as f64)
        end
        matrix.Free(probs)
        ret out
    end

    @en "score"
    @fa "امتیاز"
    @ar "درجة"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.predict(x)
        if p.is_empty(): ret 0.0 end
        r := Accuracy(y, p)
        matrix.Free(p)
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        matrix.Free(this.xtrain)
        matrix.Free(this.ytrain)
    end
end

@en "KNNRegressor"
@fa "رگرسور نزدیک‌ترین همسایه"
@ar "منحدر أقرب الجيران"
pub struct KNNRegressor:
    pub k: int = 5
    pub weighted: bool = false
    pub xtrain: matrix.Matrix = matrix.Matrix {}
    pub ytrain: matrix.Matrix = matrix.Matrix {}
    pub ok: bool = false

    @en "fit"
    @fa "برازش"
    @ar "ملاءمة"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.is_empty() || y.rows != x.rows || y.cols != 1 || this.k < 1: ret false end
        matrix.Free(this.xtrain)
        matrix.Free(this.ytrain)
        this.xtrain = matrix.Clone(x)
        this.ytrain = matrix.Clone(y)
        this.ok = true
        ret true
    end

    @en "predict"
    @fa "پیش‌بینی"
    @ar "تنبؤ"
    pub func predict(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false || x.cols != this.xtrain.cols: ret matrix.Matrix {} end
        mut out := matrix.Zeros(x.rows, 1)
        mut dist := Vector {} as Vector<f64>
        repeat x.rows with qi:
            mut nb := _nearest(this.xtrain, x, qi, this.k, dist)
            mut s := 0.0
            mut total := 0.0
            repeat nb.len() with t:
                mut wgt := 1.0
                if this.weighted: wgt = 1.0 / (dist.get(t) + 0.000000001) end
                s += wgt * this.ytrain.at(nb.get(t), 0)
                total += wgt
            end
            if total > 0.0: out.set(qi, 0, s / total) end
            nb.free()
        end
        dist.free()
        ret out
    end

    @en "score"
    @fa "امتیاز"
    @ar "درجة"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.predict(x)
        if p.is_empty(): ret 0.0 end
        r := R2Score(y, p)
        matrix.Free(p)
        ret r
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        matrix.Free(this.xtrain)
        matrix.Free(this.ytrain)
    end
end

// Indices of the k nearest training rows to query row `qi`.
func _nearest(xtrain &: matrix.Matrix, x &: matrix.Matrix, qi: int, k: int, dist_out &: Vector<f64>): Vector<int>:
    n := xtrain.rows
    p := xtrain.cols
    mut d := Vector {} as Vector<f64>
    repeat n with i:
        mut s := 0.0
        repeat p with j:
            t := x.at(qi, j) - xtrain.at(i, j)
            s += t * t
        end
        d.push(s)
    end
    mut idx := Vector {} as Vector<int>
    repeat n with i: idx.push(i) end
    sort.SortBy(idx, (a: int, b: int): ret d.get(a) < d.get(b) end)
    mut out := Vector {} as Vector<int>
    dist_out.clear()
    mut kk := k
    if kk > n: kk = n end
    repeat kk with i:
        out.push(idx.get(i))
        dist_out.push(d.get(idx.get(i)))
    end
    d.free()
    idx.free()
    ret out
end
