@en "nav"
@fa "ناوبری"
package nav

import str
import mem

@en "Route"
@fa "مسیر"
pub struct Route:
    @en "path"
    @fa "نشانی"
    pub path: str = "/"
    @en "query"
    @fa "پرسمان"
    pub query: str = ""
    @en "pattern"
    @fa "الگو"
    pub pattern: str = ""

    @en "Param"
    @fa "پارامتر"
    pub func Param(name: str): str:
        ret _route_param(this.pattern, this.path, name)
    end

    @en "Query"
    @fa "مقدار پرسمان"
    pub func Query(name: str): str:
        ret _route_query(this.query, name)
    end
end

@en "History"
@fa "تاریخچه"
pub struct History:
    @en "entries"
    @fa "مدخل ها"
    pub entries: Vector<str> = Vector {}
    @en "index"
    @fa "جایگاه"
    pub index: int = 0
end

if SALAM_JS:
    func _drop(s: str):
        _n := s.Len()
    end
else:
    func _drop(s: str):
        if s.Len() > 0:
            mem.Free(s as void*)
        end
    end
end

func _drop_all(v: Vector<str>):
    repeat v.Len() in i:
        _drop(v.Get(i))
    end
    v.Free()
end

func _route_param(pattern: str, path: str, name: str): str:
    ret Param(pattern, path, name)
end

func _route_query(query: str, name: str): str:
    ret Query(query, name)
end

func _ch(s: str, i: int): str:
    ret str.Substr(s, i, 1)
end

func _skip_slashes(s: str, from: int): int:
    mut i := from
    n := s.Len()
    until i < n and str.IndexFrom(s, "/", i) == i:
        i++
    end
    ret i
end

func _segments(s: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    n := s.Len()
    mut i := _skip_slashes(s, 0)
    until i < n:
        mut e := str.IndexFrom(s, "/", i)
        if e < 0:
            e = n
        end
        out.Push(str.Substr(s, i, e - i))
        i = _skip_slashes(s, e)
    end
    ret out
end

func _take(v: Vector<str>, n: int): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut i := 0
    until i < n and i < v.Len():
        out.Push(v.Get(i))
        i++
    end
    ret out
end

func _named(seg: str, name: str): bool:
    pn := _param_name(seg)
    hit := str.Equals(pn, name)
    _drop(pn)
    ret hit
end

func _is_splat(seg: str): bool:
    ret str.StartsWith(seg, "*")
end

func _is_param(seg: str): bool:
    ret str.StartsWith(seg, ":")
end

func _is_optional(seg: str): bool:
    ret _is_param(seg) and str.EndsWith(seg, "?")
end

func _param_name(seg: str): str:
    if _is_splat(seg):
        ret seg.Len() > 1 ? str.Substr(seg, 1, seg.Len() - 1) : str.Clone("*")
    end
    mut n := seg.Len() - 1
    if _is_optional(seg):
        n--
    end
    ret str.Substr(seg, 1, n)
end

func _hex(c: str): int:
    i := str.IndexFrom("0123456789abcdef0123456789ABCDEF", c, 0)
    if i < 0:
        ret 0 - 1
    end
    ret i % 16
end

func _escaped(code: int): str:
    if code == 47:
        ret "/"
    end
    if code == 37:
        ret "%"
    end
    if code == 38:
        ret "&"
    end
    if code == 61:
        ret "="
    end
    if code == 35:
        ret "#"
    end
    if code == 63:
        ret "?"
    end
    if code == 43:
        ret "+"
    end
    ret ""
end

func _join_rest(segs: Vector<str>, from: int): str:
    mut out := ""
    mut i := from
    until i < segs.Len():
        if i > from:
            out += "/"
        end
        out += segs.Get(i)
        i++
    end
    ret out
end

func _cap_step(
    ps: Vector<str>, xs: Vector<str>, i: int, j: int, name: str, value &: str, dead &: Vector<int>
): bool:
    if i >= ps.Len():
        ret j >= xs.Len()
    end
    p := ps.Get(i)
    if _is_splat(p):
        if _named(p, name):
            value = _join_rest(xs, j)
        end
        ret true
    end
    if _is_optional(p):
        if j < xs.Len():
            mut v := value
            if _cap(ps, xs, i + 1, j + 1, name, v, dead):
                value = _named(p, name) ? xs.Get(j) : v
                ret true
            end
        end
        ret _cap(ps, xs, i + 1, j, name, value, dead)
    end
    if j >= xs.Len():
        ret false
    end
    x := xs.Get(j)
    if _is_param(p):
        mut v := value
        if not _cap(ps, xs, i + 1, j + 1, name, v, dead):
            ret false
        end
        value = _named(p, name) ? x : v
        ret true
    end
    if not str.Equals(p, x):
        ret false
    end
    ret _cap(ps, xs, i + 1, j + 1, name, value, dead)
end

func _cap(
    ps: Vector<str>, xs: Vector<str>, i: int, j: int, name: str, value &: str, dead &: Vector<int>
): bool:
    if dead.Len() == 0:
        ret _cap_step(ps, xs, i, j, name, value, dead)
    end
    k := i * (xs.Len() + 1) + j
    if dead.Get(k) != 0:
        ret false
    end
    if _cap_step(ps, xs, i, j, name, value, dead):
        ret true
    end
    dead.Set(k, 1)
    ret false
end

func _capture(pattern: str, path: str, name: str, value &: str): bool:
    ps := _segments(pattern)
    xs := _segments(path)
    mut dead := Vector {} as Vector<int>
    defer dead.Free()
    mut branches := false
    each seg in ps:
        if _is_optional(seg):
            branches = true
        end
    end
    if branches:
        repeat (ps.Len() + 1) * (xs.Len() + 1):
            dead.Push(0)
        end
    end
    ok := _cap(ps, xs, 0, 0, name, value, dead)
    if value.Len() > 0:
        value = str.Clone(value)
    else:
        value = ""
    end
    _drop_all(ps)
    _drop_all(xs)
    ret ok
end

@en "Unescape"
@fa "بازگشایی"
pub func Unescape(s: str): str:
    if str.IndexFrom(s, "%", 0) < 0:
        ret s
    end
    mut out := ""
    n := s.Len()
    mut i := 0
    mut start := 0
    until i < n:
        if str.Equals(_ch(s, i), "%") and i + 2 < n:
            hi := _hex(_ch(s, i + 1))
            lo := _hex(_ch(s, i + 2))
            if hi >= 0 and lo >= 0:
                rep := _escaped(hi * 16 + lo)
                if rep.Len() > 0:
                    out += str.Substr(s, start, i - start)
                    out += rep
                    i += 3
                    start = i
                    continue
                end
            end
        end
        i++
    end
    out += str.Substr(s, start, n - start)
    ret out
end

@en "Normalize"
@fa "یکسان سازی"
pub func Normalize(path: str): str:
    segs := _segments(path)
    mut keep := Vector {} as Vector<str>
    each s in segs:
        if str.Equals(s, ".."):
            if keep.Len() > 0:
                _gone := keep.Pop()
            end
        else not str.Equals(s, "."):
            keep.Push(s)
        end
    end
    joined := _join_rest(keep, 0)
    out := "/" + joined
    _drop(joined)
    keep.Free()
    _drop_all(segs)
    ret out
end

@en "SplitUrl"
@fa "جداسازی نشانی"
pub func SplitUrl(url: str, path &: str, query &: str):
    mut u := url
    h := str.IndexFrom(u, "#", 0)
    mut cut := false
    if h >= 0:
        u = str.Substr(u, 0, h)
        cut = true
    end
    q := str.IndexFrom(u, "?", 0)
    if q >= 0:
        query = str.Substr(u, q + 1, u.Len() - q - 1)
        path = str.Substr(u, 0, q)
        if cut:
            _drop(u)
        end
    else:
        query = ""
        path = u
    end
end

@en "Resolve"
@fa "حل نشانی"
pub func Resolve(current: str, target: str): str:
    if target.Len() == 0:
        ret current
    end
    mut cpath := ""
    mut cquery := ""
    SplitUrl(current, cpath, cquery)
    if str.StartsWith(target, "?"):
        ret Normalize(cpath) + target
    end
    mut tpath := ""
    mut tquery := ""
    SplitUrl(target, tpath, tquery)
    mut full := tpath
    if not str.StartsWith(tpath, "/"):
        full = cpath + "/" + tpath
    end
    mut out := Normalize(full)
    if tquery.Len() > 0:
        out += "?" + tquery
    end
    ret out
end

@en "Match"
@fa "تطبیق"
pub func Match(pattern: str, path: str): bool:
    mut v := ""
    ok := _capture(pattern, path, "", v)
    _drop(v)
    ret ok
end

@en "Param"
@fa "پارامتر"
pub func Param(pattern: str, path: str, name: str): str:
    mut v := ""
    if not _capture(pattern, path, name, v):
        _drop(v)
        ret ""
    end
    if str.IndexFrom(v, "%", 0) < 0:
        ret v
    end
    out := Unescape(v)
    _drop(v)
    ret out
end

@en "ParamInt"
@fa "پارامتر عددی"
pub func ParamInt(pattern: str, path: str, name: str): int:
    v := Param(pattern, path, name)
    if not IsInt(v):
        _drop(v)
        ret 0
    end
    neg := str.StartsWith(v, "-")
    mut i := neg ? 1 : 0
    mut n := 0
    until i < v.Len():
        d := str.IndexFrom("0123456789", _ch(v, i), 0)
        n = n * 10 + (neg ? 0 - d : d)
        i++
    end
    _drop(v)
    ret n
end

@en "Query"
@fa "مقدار پرسمان"
pub func Query(query: str, name: str): str:
    n := query.Len()
    mut i := 0
    until i < n:
        mut e := str.IndexFrom(query, "&", i)
        if e < 0:
            e = n
        end
        pair := str.Substr(query, i, e - i)
        sep := str.IndexFrom(pair, "=", 0)
        key := sep < 0 ? pair : str.Substr(pair, 0, sep)
        if str.Equals(Unescape(str.Replace(key, "+", " ")), name):
            if sep < 0:
                ret ""
            end
            ret Unescape(str.Replace(str.Substr(pair, sep + 1, pair.Len() - sep - 1), "+", " "))
        end
        i = e + 1
    end
    ret ""
end

@en "Rank"
@fa "رتبه"
pub func Rank(pattern: str): int:
    segs := _segments(pattern)
    mut r := 0
    each s in segs:
        if _is_splat(s):
            r -= 1000000
        else _is_optional(s):
            r--
        else _is_param(s):
            r += 60
        else:
            r += 70
        end
    end
    ret r
end

@en "IsInt"
@fa "عدد صحیح است"
pub func IsInt(s: str): bool:
    n := s.Len()
    neg := str.StartsWith(s, "-")
    mut i := neg ? 1 : 0
    if i >= n:
        ret false
    end
    mut first := 0 - 1
    until i < n:
        c := _ch(s, i)
        if str.IndexFrom("0123456789", c, 0) < 0:
            ret false
        end
        if first < 0 and not str.Equals(c, "0"):
            first = i
        end
        i++
    end
    if first < 0 or n - first < 10:
        ret true
    end
    if n - first > 10:
        ret false
    end
    ret str.Compare(str.Substr(s, first, 10), neg ? "2147483648" : "2147483647") <= 0
end

@en "Href"
@fa "نشانی صفحه"
pub func Href(hash: bool, base: str, path: str): str:
    if hash:
        ret "#" + path
    end
    mut b := base
    if str.EndsWith(b, "/"):
        b = str.Substr(b, 0, b.Len() - 1)
    end
    ret b + path
end

@en "StripBase"
@fa "برداشتن پایه"
pub func StripBase(base: str, path: str): str:
    mut b := base
    if str.EndsWith(b, "/"):
        b = str.Substr(b, 0, b.Len() - 1)
    end
    if b.Len() == 0 or str.Equals(path, b):
        ret b.Len() == 0 ? Normalize(path) : "/"
    end
    if str.StartsWith(path, b + "/"):
        ret Normalize(str.Substr(path, b.Len(), path.Len() - b.Len()))
    end
    ret Normalize(path)
end

@en "NewHistory"
@fa "تاریخچه جدید"
pub func NewHistory(start: str): History:
    mut h := History {}
    h.entries.Push(start)
    h.index = 0
    ret h
end

@en "Current"
@fa "کنونی"
pub func Current(h: History): str:
    if h.index < 0 or h.index >= h.entries.Len():
        ret "/"
    end
    ret h.entries.Get(h.index)
end

@en "Push"
@fa "افزودن"
pub func Push(h &: History, path: str):
    h.entries = _take(h.entries, h.index + 1)
    h.entries.Push(path)
    h.index = h.entries.Len() - 1
end

@en "Replace"
@fa "جایگزینی"
pub func Replace(h &: History, path: str):
    if h.index < 0 or h.index >= h.entries.Len():
        Push(h, path)
        ret
    end
    h.entries.Set(h.index, path)
end

@en "CanBack"
@fa "عقب ممکن"
pub func CanBack(h: History): bool:
    ret h.index > 0
end

@en "CanForward"
@fa "جلو ممکن"
pub func CanForward(h: History): bool:
    ret h.index + 1 < h.entries.Len()
end

@en "Back"
@fa "عقب"
pub func Back(h &: History): bool:
    if h.index <= 0:
        ret false
    end
    h.index--
    ret true
end

@en "Forward"
@fa "جلو"
pub func Forward(h &: History): bool:
    if h.index + 1 >= h.entries.Len():
        ret false
    end
    h.index++
    ret true
end

@en "Reset"
@fa "بازنشانی"
pub func Reset(h &: History, path: str):
    h.entries.Clear()
    h.entries.Push(path)
    h.index = 0
end

@en "Depth"
@fa "ژرفا"
pub func Depth(h: History): int:
    ret h.index + 1
end
