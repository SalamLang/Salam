@en "net/devreload"
@fa "بازخوانی توسعه"
package devreload

import str
import io
import os
import time
import net.http
import fs
import conv

const k_pre := `<script data-salam-hmr>(function(){if(window.__salamRec){return;}var L=[],T=[];var aw=window.addEventListener,ad=document.addEventListener,si=window.setInterval,st=window.setTimeout;window.addEventListener=function(t,f,o){if(L.length<5000){L.push([window,t,f,o]);}return aw.call(window,t,f,o);};document.addEventListener=function(t,f,o){if(L.length<5000){L.push([document,t,f,o]);}return ad.call(document,t,f,o);};window.setInterval=function(){var id=si.apply(window,arguments);T.push([0,id]);return id;};window.setTimeout=function(){var id=st.apply(window,arguments);if(T.length<5000){T.push([1,id]);}return id;};window.__salamRec={teardown:function(){for(var i=0;i<L.length;i++){try{L[i][0].removeEventListener(L[i][1],L[i][2],L[i][3]);}catch(e){}}L.length=0;for(var j=0;j<T.length;j++){if(T[j][0]===0){clearInterval(T[j][1]);}else{clearTimeout(T[j][1]);}}T.length=0;}};})();</script>`
const k_client_a := `<script data-salam-hmr>(function(){if(window.__salamHmr){return;}window.__salamHmr=1;var K="salam-hmr-scroll";`
const k_client_b := `try{var y=sessionStorage.getItem(K);if(y!==null){sessionStorage.removeItem(K);addEventListener("load",function(){scrollTo(0,+y);});}}catch(e){}var box=null;`
const k_client_c := `function clear(){if(box){box.remove();box=null;}}function esc(t){return t.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}function link(t){return esc(t.replace(/\x1b\[[0-9;]*m/g,"")).replace(/(--&gt;\s+)(\/[^\s:]+|[A-Za-z]:[^\s:]+):(\d+):(\d+)/g,function(m,a,f,l,c){return a+'<a style="color:#8ab4ff" href="vscode://file'+(f.charAt(0)==="/"?"":"/")+f+":"+l+":"+c+'">'+f+":"+l+":"+c+"</a>";});}function show(t){clear();box=document.createElement("div");box.setAttribute("style","position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483647;background:rgba(20,20,24,.95);color:#f5f5f5;font:13px/1.5 ui-monospace,Menlo,Consolas,monospace;overflow:auto;padding:24px;box-sizing:border-box");`
const k_client_d := `var h=document.createElement("div");h.setAttribute("style","color:#ff6b6b;font-size:16px;margin-bottom:12px");h.textContent="Build failed. Fix the error and save, this page updates by itself.";var p=document.createElement("pre");p.setAttribute("style","margin:0;white-space:pre-wrap");p.innerHTML=link(t);box.appendChild(h);box.appendChild(p);box.onclick=function(e){if(e.target===box){clear();}};document.documentElement.appendChild(box);}`
const k_client_e := `function reload(){try{sessionStorage.setItem(K,String(window.scrollY));}catch(e){}location.reload();}function css(){var l=document.querySelectorAll('link[rel="stylesheet"]');for(var i=0;i<l.length;i++){var u=new URL(l[i].href);u.searchParams.set("_hmr",String(Date.now()));l[i].href=u.toString();}}`
const k_client_f := `function mine(n){return n.nodeType===1&&n.hasAttribute("data-salam-hmr");}function apps(d){return [].filter.call(d.body.querySelectorAll("script"),function(s){return !s.src&&!mine(s)&&s.id!=="__salam"&&(!s.type||s.type==="text/javascript"||s.type==="module");});}`
const k_client_g := `function syncAttrs(a,b){[].slice.call(a.attributes).forEach(function(x){if(!b.hasAttribute(x.name)){a.removeAttribute(x.name);}});[].slice.call(b.attributes).forEach(function(x){a.setAttribute(x.name,x.value);});}var gen=0;function swap(t){var cur=window.__salamDev,rec=window.__salamRec;if(!cur||!rec){return false;}var doc=new DOMParser().parseFromString(t,"text/html");var na=apps(doc),oa=apps(document);if(na.length!==1||oa.length!==1){return false;}var st;try{st=JSON.parse(JSON.stringify(cur.get()));}catch(e){return false;}rec.teardown();`
const k_client_h := `[].slice.call(document.head.querySelectorAll("style")).forEach(function(n){n.remove();});[].slice.call(doc.head.querySelectorAll("style")).forEach(function(n){document.head.appendChild(document.importNode(n,true));});if(doc.title){document.title=doc.title;}syncAttrs(document.documentElement,doc.documentElement);syncAttrs(document.body,doc.body);[].slice.call(document.body.childNodes).forEach(function(n){if(!mine(n)){n.remove();}});[].slice.call(doc.body.childNodes).forEach(function(n){if(n.nodeType===1&&(n.tagName==="SCRIPT"||n.id==="__salam")){return;}document.body.appendChild(document.importNode(n,true));});`
const k_client_i := `var bad=false,prev=window.onerror;window.onerror=function(){bad=true;return false;};window.__salamDevRestore=st;var s=document.createElement("script");s.textContent=na[0].textContent;document.body.appendChild(s);window.onerror=prev;return !bad;}window.__salamHotSwap=swap;`
const k_client_j := `var es=new EventSource("/__salam_hmr");es.onmessage=function(m){var d;try{d=JSON.parse(m.data);}catch(e){return;}if(d.kind==="error"){show(d.error);}else if(d.kind==="reload"){reload();}else if(d.kind==="css"){clear();css();}else if(d.kind==="swap"){clear();var my=++gen;fetch(location.href,{cache:"no-store",headers:{Accept:"text/html"}}).then(function(r){return r.text();}).then(function(t){if(my!==gen){return;}var ok=false;try{ok=swap(t);}catch(e){ok=false;}if(!ok){reload();}}).catch(function(){if(my===gen){reload();}});}else if(d.kind==="style"){clear();var my2=++gen;fetch(location.href,{cache:"no-store",headers:{Accept:"text/html"}}).then(function(r){return r.text();}).then(function(t){if(my2!==gen){return;}var doc=new DOMParser().parseFromString(t,"text/html");[].slice.call(document.head.querySelectorAll("style")).forEach(function(n){n.remove();});[].slice.call(doc.head.querySelectorAll("style")).forEach(function(n){document.head.appendChild(document.importNode(n,true));});}).catch(function(){if(my2===gen){reload();}});}else if(d.kind==="hello"){clear();}};})();</script>`

const k_hold_ms := 15000

mut g_epoch := ""
mut g_err_file := ""
mut g_seq := 0
mut g_kind := 0
mut g_watch_err := true

func _head_end(html: str): int:
    low := str.Lower(html)
    mut from := 0
    until from >= 0:
        a := str.IndexFrom(low, "<head", from)
        if a < 0:
            break
        end
        nxt := str.Substr(low, a + 5, 1)
        if str.Equals(nxt, ">") or str.Equals(nxt, " ") or str.Equals(nxt, "\t") or
            str.Equals(nxt, "\n"):
            close := str.IndexFrom(low, ">", a)
            if close >= 0:
                ret close + 1
            end
            break
        end
        from = a + 5
    end
    d := str.IndexOf(low, "<!doctype")
    if d == 0:
        close := str.IndexFrom(low, ">", 0)
        if close >= 0:
            ret close + 1
        end
    end
    ret 0 - 1
end

func _seq_of(id: str): int:
    a := str.IndexOf(id, ":")
    if a < 0:
        ret 0
    end
    rest := str.Substr(id, a + 1, str.Len(id) - a - 1)
    b := str.IndexOf(rest, ":")
    ret conv.AtoiOr(b > 0 ? str.Substr(rest, 0, b) : rest, 0)
end

func _escape(s: str): str:
    mut out := ""
    mut n := s.Len()
    if n > 20000:
        n = 20000
    end
    repeat n in i:
        c := str.Substr(s, i, 1)
        if str.Equals(c, "\\"):
            out += "\\\\"
        else str.Equals(c, "\""):
            out += "\\\""
        else str.Equals(c, "\n"):
            out += "\\n"
        else str.Equals(c, "\t"):
            out += "\\t"
        else str.Equals(c, "\r"):
            out += ""
        else:
            out += c
        end
    end
    ret out
end

func _err_len(): int:
    if str.Len(g_err_file) == 0 or not os.Exists(g_err_file):
        ret 0
    end
    ret os.FileSize(g_err_file) as int
end

func _err_stamp(): int:
    n := _err_len()
    if n == 0:
        ret 0
    end
    ret n * 31 + (fs.ModTime(g_err_file) % 1000003) as int
end

func _state_id(): str:
    mut n := 0
    if g_watch_err:
        n = _err_stamp()
    end
    ret g_epoch + ":" + str.FromInt(g_seq as i64) + ":" + str.FromInt(n as i64)
end

func _event(kind: str, text: str): str:
    ret "retry: 500\nid: " + _state_id() + "\ndata: {\"kind\":\"" + kind + "\",\"error\":\"" +
        _escape(text) + "\"}\n\n"
end

@en "Init"
@fa "آماده سازی"
pub func Init(epoch: str, err_file: str):
    g_epoch = str.Len(epoch) > 0 ? str.Replace(epoch, ":", "-") : "dev"
    g_err_file = err_file
    g_seq = 0
    g_kind = 0
    g_watch_err = true
end

@en "InitLocal"
@fa "آماده سازی درون برنامه"
pub func InitLocal(epoch: str, err_file: str):
    Init(epoch, err_file)
    g_watch_err = false
end

@en "InitFromEnv"
@fa "آماده سازی از محیط"
pub func InitFromEnv(): bool:
    flag := os.Env("SALAM_DEV_HMR")
    if str.Len(flag) == 0 or str.Equals(flag, "0"):
        ret false
    end
    Init(
        str.FromInt(os.Pid() as i64) + "x" + str.FromInt(time.NowNanos()),
        os.Env("SALAM_DEV_HMR_ERR")
    )
    ret true
end

@en "Enabled"
@fa "فعال است"
pub func Enabled(): bool:
    ret str.Len(g_epoch) > 0
end

@en "Bump"
@fa "اعلام تغییر"
pub func Bump(kind: int):
    g_kind = kind
    g_seq++
end

@en "Script"
@fa "اسکریپت"
pub func Script(): str:
    ret k_client_a + k_client_b + k_client_c + k_client_d + k_client_e + k_client_f + k_client_g +
        k_client_h + k_client_i + k_client_j
end

@en "Inject"
@fa "افزودن به صفحه"
pub func Inject(html: str): str:
    script := Script()
    at := _head_end(html)
    doc := at >= 0 ? str.Substr(html, 0, at) + k_pre + str.Substr(
        html, at, html.Len() - at
    ) : k_pre + html
    cut := str.LastIndex(doc, "</body>")
    if cut >= 0:
        ret str.Substr(doc, 0, cut) + script + str.Substr(doc, cut, doc.Len() - cut)
    end
    ret doc + script
end

@en "Handler"
@fa "رسیدگی به رویدادها"
pub func Handler(ctx: i64):
    http.SetHeader(ctx, "Content-Type", "text/event-stream")
    http.SetHeader(ctx, "Cache-Control", "no-store")
    http.SetHeader(ctx, "X-Accel-Buffering", "no")
    hdr := http.Header(ctx, "Last-Event-ID")
    last := str.Len(hdr) > 0 ? hdr : http.Query(ctx, "v")
    mut kind := "hello"
    if str.Len(last) == 0:
        if _err_len() > 0:
            kind = "error"
        end
    else:
        cut := str.IndexOf(last, ":")
        epoch := cut > 0 ? str.Substr(last, 0, cut) : ""
        if not str.Equals(epoch, g_epoch):
            kind = "reload"
        else:
            mut waited := 0
            until str.Equals(last, _state_id()) and waited < k_hold_ms:
                time.Sleep(5)
                waited += 5
            end
            if str.Equals(last, _state_id()):
                kind = "ping"
            else:
                kind = "reload"
                if _err_len() > 0:
                    kind = "error"
                else g_seq - _seq_of(last) > 1:
                    kind = "reload"
                else g_kind == 1:
                    kind = "css"
                else g_kind == 2:
                    kind = "swap"
                else g_kind == 3:
                    kind = "style"
                end
            end
        end
    end
    mut text := ""
    if str.Equals(kind, "error") and str.Len(g_err_file) > 0:
        text = io.ReadFile(g_err_file)
    end
    http.Text(ctx, http.Own(ctx, _event(kind, text)))
end
