package email

import str
import encoding

// XOAUTH2 SASL string builder, shared by SMTP AUTH XOAUTH2 and IMAP
// AUTHENTICATE XOAUTH2. This is deliberately NOT a full OAuth client -
// obtaining `access_token` requires a browser/redirect authorization-
// code flow that has no place in a stdlib networking package (there is
// no browser to redirect to from here). Callers get the token from
// wherever their application already does OAuth (a web framework, a
// desktop webview, a pre-issued service-account token, ...) and hand it
// to this function - net/email's job starts and ends at building the
// SASL string and sending it.
@en "BuildXOAuth2"
@fa "ساخت ایکس‌اواث۲"
@ar "بناء XOAUTH2"
pub func BuildXOAuth2(username: str, access_token: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "user=")
    str.BufAppend(sb, username)
    str.BufAppendChar(sb, 1)
    str.BufAppend(sb, "auth=Bearer ")
    str.BufAppend(sb, access_token)
    str.BufAppendChar(sb, 1)
    str.BufAppendChar(sb, 1)
    raw := str.BufStr(sb)
    ret encoding.Base64Encode(raw)
end
