package email

import str
import encoding

@en "BuildXOAuth2"
@fa "ساخت ایکس‌اواث۲"
pub func BuildXOAuth2(username: str, access_token: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "user=")
    str.BufAppend(sb, username)
    str.BufAppendChar(sb, 1)
    str.BufAppend(sb, "auth=Bearer ")
    str.BufAppend(sb, access_token)
    str.BufAppendChar(sb, 1)
    str.BufAppendChar(sb, 1)
    raw := str.BufStr(sb)
    ret encoding.Base64Encode(raw)
end
