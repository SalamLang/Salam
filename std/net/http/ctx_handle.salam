package http

@en "Method"
@fa "روش"
pub func Method(h: i64): str: ret salam_ctx_get(h, 0) end

@en "Path"
@fa "مسیر"
pub func Path(h: i64): str: ret salam_ctx_get(h, 1) end

@en "Body"
@fa "بدنه"
pub func Body(h: i64): str: ret salam_ctx_get(h, 3) end

@en "BodyLen"
@fa "طول بدنه"
pub func BodyLen(h: i64): int: ret _rc(h).body_len end

@en "BodyBytes"
@fa "بایت‌های بدنه"
pub func BodyBytes(h: i64): void *: ret salam_ctx_get(h, 3) as void * end

// Parses a multipart/form-data body; empty when the request is not multipart.
// The caller owns the result and releases it with mime.FreeMultipart.
@en "Multipart"
@fa "چندبخشی"
pub func Multipart(h: i64): mime.MultipartParts:
    ct := mime.ParseContentType(salam_ctx_kv_get(h, 0, "Content-Type"))
    if not str.EqualFold(ct.media_type, "multipart/form-data"):
        ret mime.MultipartParts {}
    end
    boundary := mime.ParamGet(ct, "boundary")
    if boundary.len() == 0:
        ret mime.MultipartParts {}
    end
    ret mime.ParseMultipart(BodyBytes(h), BodyLen(h), boundary)
end

@en "Query"
@fa "پرسمان"
pub func Query(h: i64, key: str): str:
    ret _ctx_own(h, _query_parse(salam_ctx_get(h, 2), key))
end

@en "RawQuery"
@fa "پرسمان خام"
pub func RawQuery(h: i64): str: ret salam_ctx_get(h, 2) end

@en "Header"
@fa "سرصفحه"
pub func Header(h: i64, name: str): str: ret salam_ctx_kv_get(h, 0, name) end

@en "Param"
@fa "پارامتر"
pub func Param(h: i64, name: str): str: ret salam_ctx_kv_get(h, 1, name) end

@en "Form"
@fa "فرم"
pub func Form(h: i64, field: str): str:
    ret _ctx_own(h, _query_parse(salam_ctx_get(h, 3), field))
end

@en "SetStatus"
@fa "تنظیم وضعیت"
pub func SetStatus(h: i64, code: int): salam_ctx_set_status(h, code) end

@en "SetHeader"
@fa "تنظیم سرصفحه"
pub func SetHeader(h: i64, k: str, v: str): salam_ctx_kv_add(h, 2, k, v) end

@en "AddHeader"
@fa "افزودن سرصفحه"
pub func AddHeader(h: i64, k: str, v: str): salam_ctx_kv_push(h, 2, k, v) end

@en "Html"
@fa "اچ تی ام ال"
pub func Html(h: i64, html: str):
    salam_ctx_set(h, 4, "text/html; charset=utf-8")
    salam_ctx_set(h, 5, html)
end

@en "Json"
@fa "جیسون"
pub func Json(h: i64, json: str):
    salam_ctx_set(h, 4, "application/json")
    salam_ctx_set(h, 5, json)
end

@en "Text"
@fa "متن"
pub func Text(h: i64, text: str):
    salam_ctx_set(h, 4, "text/plain; charset=utf-8")
    salam_ctx_set(h, 5, text)
end

// Sends n bytes at p as the body (binary safe: files, images, archives).
@en "Bytes"
@fa "بایت‌ها"
pub func Bytes(h: i64, content_type: str, p: void *, n: int):
    c := _rc(h)
    c.resp_ct = _ctx_own(h, str.Clone(content_type))
    c.resp_body = _ctx_own(h, _str_of(p, n))
    c.resp_len = n
end

@en "Own"
@fa "مالکیت"
pub func Own(h: i64, s: str): str: ret _ctx_own(h, s) end

@en "Redirect"
@fa "تغییرمسیر"
pub func Redirect(h: i64, loc: str):
    salam_ctx_set_status(h, 302)
    salam_ctx_kv_add(h, 2, "Location", loc)
    salam_ctx_set(h, 4, "")
    salam_ctx_set(h, 5, "")
end
