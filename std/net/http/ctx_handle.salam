package http

// Flat i64-handle counterpart to context.salam's Context struct API, for
// handlers/middleware that only ever see the raw ctx handle (used by
// net/http/middleware and net/http/validate).

@en "Ctx_method"
@fa "روش زمینه"
@ar "طریقة السیاق"
pub func Ctx_method(h: i64): str: ret salam_ctx_get(h, 0) end

@en "Ctx_path"
@fa "مسیر زمینه"
@ar "مسار السیاق"
pub func Ctx_path(h: i64): str: ret salam_ctx_get(h, 1) end

@en "Ctx_body"
@fa "بدنه زمینه"
@ar "متن السیاق"
pub func Ctx_body(h: i64): str: ret salam_ctx_get(h, 3) end

@en "Ctx_query"
@fa "پرسمان زمینه"
@ar "استعلام السیاق"
pub func Ctx_query(h: i64, key: str): str:
    // Percent-decoding has to produce a new string, so this one is heap and
    // somebody has to free it. Handing it to the request scope means the
    // handler gets a plain `str` it can read and forget, and it is released
    // with everything else when the response goes out - rather than leaking
    // once per call, which is what a handler reading two query parameters
    // used to cost.
    ret _ctx_own(h, _query_parse(salam_ctx_get(h, 2), key))
end

@en "Ctx_header"
@fa "سرصفحه زمینه"
@ar "ترویسة السیاق"
pub func Ctx_header(h: i64, name: str): str: ret salam_ctx_kv_get(h, 0, name) end

@en "Ctx_param"
@fa "پارامتر زمینه"
@ar "معامل السیاق"
pub func Ctx_param(h: i64, name: str): str: ret salam_ctx_kv_get(h, 1, name) end

@en "Ctx_form"
@fa "فرم زمینه"
@ar "استمارة السیاق"
pub func Ctx_form(h: i64, field: str): str:
    ret _ctx_own(h, _query_parse(salam_ctx_get(h, 3), field))
end

@en "Ctx_status"
@fa "وضعیت زمینه"
@ar "حالة السیاق"
pub func Ctx_status(h: i64, code: int): salam_ctx_set_status(h, code) end

@en "Ctx_set_header"
@fa "تنظیم سرصفحه زمینه"
@ar "تعیین ترویسة السیاق"
pub func Ctx_set_header(h: i64, k: str, v: str): salam_ctx_kv_add(h, 2, k, v) end

@en "Ctx_html"
@fa "اچ تی ام ال زمینه"
@ar "إتش تی إم إل السیاق"
pub func Ctx_html(h: i64, html: str):
    salam_ctx_set(h, 4, "text/html; charset=utf-8")
    salam_ctx_set(h, 5, html)
end

@en "Ctx_json"
@fa "جیسون زمینه"
@ar "جیسون السیاق"
pub func Ctx_json(h: i64, json: str):
    salam_ctx_set(h, 4, "application/json")
    salam_ctx_set(h, 5, json)
end

@en "Ctx_text"
@fa "متن زمینه"
@ar "نص السیاق"
pub func Ctx_text(h: i64, text: str):
    salam_ctx_set(h, 4, "text/plain; charset=utf-8")
    salam_ctx_set(h, 5, text)
end

// Hands a string the handler built to the request scope: it is freed when the
// response has been sent, and until then it can be used like any other `str`.
//
// This is the answer to "my handler assembled a body with a StringBuilder,
// who frees it?". Ctx_json and friends deliberately do NOT take ownership of
// what they are given, because most callers pass a literal and freeing one of
// those would corrupt the heap - so a handler with a heap-allocated body says
// so here:
//
//     http.Ctx_json(ctx, http.Ctx_own(ctx, str.BufStr(b)))
//
// Only ever pass a heap pointer. A literal, or a string already given to this
// function, will be freed twice.
@en "Ctx_own"
@fa "مالکیت زمینه"
@ar "تملک السیاق"
pub func Ctx_own(h: i64, s: str): str: ret _ctx_own(h, s) end

@en "Ctx_redirect"
@fa "تغییرمسیر زمینه"
@ar "إعادة توجیه السیاق"
pub func Ctx_redirect(h: i64, loc: str):
    salam_ctx_set_status(h, 302)
    salam_ctx_kv_add(h, 2, "Location", loc)
    salam_ctx_set(h, 4, "")
    salam_ctx_set(h, 5, "")
end
