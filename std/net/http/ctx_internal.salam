package http

import net.tcp
import net.mime
import net.router
import net.internal.rawsock
import tls
import mem
import str
import conv
import encoding
import filepath
import os

// The request-handling internals migrated from std/web/web.salam: the
// opaque request-context handle (an i64 pointing at a heap-allocated
// _ReqCtx - kept as a raw handle, not a Salam struct with foreign
// fields, for the same cross-package struct-embedding codegen reasons
// tcp.Conn/DialTLS document), HTTP/1.1 request parsing, response
// serialization, static file serving with directory-traversal
// protection, and the per-connection handler run on its own OS thread.
//
// Route matching itself is delegated to net/router.Dispatch (a pure
// function, no side effects on this context) - this file's job is
// purely translating between "the wire" and "a Router lookup", which is
// the same responsibility std/web's `_dispatch` had, just no longer
// entangled with the matching algorithm.

extern:
    func fopen(path: str, mode: str): void *
    func fread(ptr: void *, size: u64, nmemb: u64, stream: void *): u64
    func fseek(stream: void *, off: int, whence: int): int
    // int, not i64: std/os.salam's own `extern func ftell` declares the
    // same libc symbol as returning plain `int` (both get emitted into the
    // same generated C header once a program imports both packages), so
    // the two declarations must agree exactly or the C build fails with
    // "conflicting types for 'ftell'". Widened to i64 at every call site.
    func ftell(stream: void *): int
    func fclose(stream: void *): int
end

@en "SERVER_VERSION"
@fa "نسخه سرور"
@ar "إصدار الخادم"
// The toolchain's own version, so the Server: header a Salam service sends
// tracks the repo's VERSION file with nothing to bump here.
pub const SERVER_VERSION := SALAM_VERSION

// Bytes per socket read; one buffer per connection, reused per request.
const _RD_CHUNK := 65536

mut _reqctx_size := 0 as i64
mut _current_router := router.NewRouter()
mut _hide_tokens := false
mut _access_log := false
mut _current_tls_cfg := tls.NewServerConfig("", "")
mut _keepalive_idle_ms := 5000
mut _keepalive_max_reqs := 100000

@en "Context"
@fa "زمینه"
@ar "سیاق"
pub struct Context:
    pub h: i64
end

struct _KV:
    pub k: str = ""
    pub v: str = ""
end

struct _ReqCtx:
    pub fd: i64 = 0
    pub status: int = 200
    pub is_sent: bool = false
    pub method: str = ""
    pub path: str = ""
    pub query: str = ""
    pub body: str = ""
    pub resp_ct: str = ""
    pub resp_body: str = ""
    pub req_hdrs: Vector<_KV> = Vector {}
    pub path_params: Vector<_KV> = Vector {}
    pub resp_hdrs: Vector<_KV> = Vector {}
    // Whether this request permits the connection to be reused, decided by
    // _parse_http from the HTTP version and the Connection header. The
    // default is the HTTP/1.1 rule (reuse unless told otherwise); a request
    // line ending in HTTP/1.0, or an explicit "Connection: close", flips it.
    pub keep_alive: bool = true
end

@en "Server"
@fa "سرور"
@ar "خادم"
pub struct Server:
    pub port: int = 0
    pub host: str = "0.0.0.0"
    pub router: router.Router = router.Router {}
    pub hide_tokens: bool = false
    pub access_log: bool = false
end

// Path/query parsing and the static-file safety check (_safe_static_path)
// all go through str.split("/") indirectly via filepath.Clean/Join. On this
// toolchain, the very first str.split() call in a process that produces 3+
// pieces can return a Vector whose last slot was never actually written
// (reads back as the Windows "uninitialized heap" poison pattern
// 0xBAADF00D, confirmed under gdb) - some one-time lazy-init gap in the
// C runtime/allocator that a single earlier split() call papers over for
// the rest of the process's lifetime. Running one harmless split here,
// before the first real request can reach _safe_static_path, avoids
// hitting that gap on live traffic. Cheap and process-wide: this needs to
// run exactly once, not once per connection/thread.
func _warm_up_split():
    junk := "a/b".split("/")
    defer junk.free()
end

func _reqctx_sizeof(): i64:
    if _reqctx_size == 0:
        v := Vector {} as Vector<_ReqCtx> v.push(_ReqCtx {})
        v.push(_ReqCtx {})
        // the stride between two slots, so these have to be the addresses
        // ref hands back, not the elements get returns
        _reqctx_size = (v.ref(1) as i64) - (v.ref(0) as i64)
    end
    ret _reqctx_size
end

func _rc(h: i64): _ReqCtx *:
    ret h as _ReqCtx *
end

func salam_ctx_new(fd: i64): i64:
    p := mem.Allocate(_reqctx_sizeof() as u64)
    c := p as _ReqCtx * c[0] = _ReqCtx { fd = fd }
    ret p as i64
end

func salam_ctx_free(h: i64):
    mem.Free(h as void *)
end

func salam_ctx_fd(h: i64): i64:
    ret _rc(h).fd
end

func salam_ctx_get(h: i64, idx: int): str:
    c := _rc(h)
    if idx == 0: ret c.method
    else idx == 1: ret c.path
    else idx == 2: ret c.query
    else idx == 3: ret c.body
    else idx == 4: ret c.resp_ct
    else idx == 5: ret c.resp_body
    else:
        ret ""
    end
end

func salam_ctx_set(h: i64, idx: int, val: str):
    c := _rc(h)
    if idx == 0: c.method = val
    else idx == 1: c.path = val
    else idx == 2: c.query = val
    else idx == 3: c.body = val
    else idx == 4: c.resp_ct = val
    else idx == 5: c.resp_body = val end
end

func salam_ctx_get_status(h: i64): int:
    ret _rc(h).status
end

func salam_ctx_set_status(h: i64, status: int):
    c := _rc(h)
    c.status = status
end

func salam_ctx_is_sent(h: i64): int:
    if _rc(h).is_sent: ret 1 end
    ret 0
end

func _ctx_mark_sent(h: i64):
    c := _rc(h)
    c.is_sent = true
end

func _kvl_get(l &: Vector<_KV>, key: str): str:
    repeat l.len() with i:
        kv := l.get(i)
        if kv.k == key: ret kv.v end
    end
    ret ""
end

func _kvl_set(l &: Vector<_KV>, key: str, val: str):
    repeat l.len() with i:
        if l.get(i).k == key:
            l.set(i, _KV { k = key, v = val })
            ret
        end
    end
    l.push(_KV { k = key, v = val })
end

// Set-Cookie specifically dedupes by cookie NAME (the "n=" prefix of the
// serialized value), unlike every other response header. Setting the same
// cookie twice in one handler - e.g. session.Start followed immediately by
// session.Regenerate, both of which set the session-id cookie - should
// replace the earlier Set-Cookie line, not add a second one for a value
// that's about to be superseded. A real browser resolves two same-name
// Set-Cookie lines fine on its own (last one wins), but there's no reason
// to ship the dead first line over the wire.
func _kvl_set_cookie(l &: Vector<_KV>, cookie_name: str, val: str):
    prefix := cookie_name.concat("=")
    mut i := 0
    until i < l.len():
        kv := l.get(i)
        if kv.k == "Set-Cookie" && kv.v.len() >= prefix.len() && kv.v.substr(0, prefix.len()) == prefix:
            l.remove_at(i)
        else:
            i += 1
        end
    end
    l.push(_KV { k = "Set-Cookie", v = val })
end

func _kvl_clear(l &: Vector<_KV>):
    until l.len() > 0:
        l.pop()
    end
end

func salam_ctx_kv_get(h: i64, list: int, key: str): str:
    c := _rc(h)
    if list == 0: ret _kvl_get(c.req_hdrs, key)
    else list == 1: ret _kvl_get(c.path_params, key)
    else:
        ret _kvl_get(c.resp_hdrs, key)
    end
end

func salam_ctx_kv_add(h: i64, list: int, key: str, val: str):
    c := _rc(h)
    if list == 0: _kvl_set(c.req_hdrs, key, val)
else list == 1: _kvl_set(c.path_params, key, val)
else:
    _kvl_set(c.resp_hdrs, key, val)
end
end

func salam_ctx_kv_set_cookie(h: i64, cookie_name: str, val: str):
    c := _rc(h)
    _kvl_set_cookie(c.resp_hdrs, cookie_name, val)
end

func salam_ctx_kv_clear(h: i64, list: int):
    c := _rc(h)
    if list == 0: _kvl_clear(c.req_hdrs)
else list == 1: _kvl_clear(c.path_params)
else:
    _kvl_clear(c.resp_hdrs)
end
end

func salam_ctx_kv_n(h: i64, list: int): int:
    c := _rc(h)
    if list == 0: ret c.req_hdrs.len()
    else list == 1: ret c.path_params.len()
    else:
        ret c.resp_hdrs.len()
    end
end

func salam_ctx_kv_key(h: i64, list: int, idx: int): str:
    c := _rc(h)
    if list == 0: ret c.req_hdrs.get(idx).k
    else list == 1: ret c.path_params.get(idx).k
    else:
        ret c.resp_hdrs.get(idx).k
    end
end

func salam_ctx_kv_val(h: i64, list: int, idx: int): str:
    c := _rc(h)
    if list == 0: ret c.req_hdrs.get(idx).v
    else list == 1: ret c.path_params.get(idx).v
    else:
        ret c.resp_hdrs.get(idx).v
    end
end

func _query_parse(req: str, key: str): str:
    if req.len() == 0: ret "" end
    decoded := UrlDecode(req)
    mut rest := decoded
    until rest.len() > 0:
        amp := rest.find("&")
        mut pair := ""
        if amp >= 0:
            pair = rest.substr(0, amp)
            rest = rest.substr(amp + 1, rest.len() - amp - 1)
        else:
            pair = rest
            rest = ""
        end
        eq := pair.find("=")
        if eq >= 0:
            if pair.substr(0, eq) == key:
                ret pair.substr(eq + 1, pair.len() - eq - 1)
            end
        end
    end
    ret ""
end

// Three copies of the whole request used to be made before a single header
// was read: `after_method` (everything past the verb), then the header walk,
// then a fresh scan from offset 0 for the blank line that the header walk had
// already stepped over. This version copies out only the request target,
// remembers where the header walk stopped, and slices the body from there.
func _parse_http(ctx: i64, req: str):
    c := _rc(ctx)
    n := req.len()
    sp1 := req.find(" ")
    if sp1 < 0: ret end
    c.method = req.substr(0, sp1)
    sp2 := str.IndexFrom(req, " ", sp1 + 1)
    if sp2 < 0: ret end
    pathquery := req.substr(sp1 + 1, sp2 - sp1 - 1)
    qmark := pathquery.find("?")
    if qmark >= 0:
        c.path = pathquery.substr(0, qmark)
        c.query = pathquery.substr(qmark + 1, pathquery.len() - qmark - 1)
    else:
        c.path = pathquery
        c.query = ""
    end
    first_crlf := str.IndexFrom(req, "\r\n", sp2 + 1)
    if first_crlf < 0: ret end
    // "HTTP/1.0" defaults to closing the connection; 1.1 and later default to
    // keeping it. Either default can still be overridden by Connection below.
    if first_crlf - sp2 - 1 >= 8 && req.substr(sp2 + 1, 8) == "HTTP/1.0":
        c.keep_alive = false
    end
    mut pos := first_crlf + 2
    mut body_start := 0 - 1
    until pos < n:
        if pos + 1 < n && req.substr(pos, 2) == "\r\n":
            body_start = pos + 2
            break
        end
        line_end := str.IndexFrom(req, "\r\n", pos)
        if line_end < 0:
            break
        end
        colon := str.IndexFrom(req, ":", pos)
        if colon >= 0 && colon < line_end:
            hk := req.substr(pos, colon - pos)
            hv := str.TrimLeft(req.substr(colon + 1, line_end - colon - 1))
            salam_ctx_kv_add(ctx, 0, hk, hv)
            // "Connection" is ten characters; nothing else that matters here
            // is, so the length check keeps the lowercase copy off the hot
            // path for every other header on every request.
            if hk.len() == 10 && hk.lower() == "connection":
                lv := hv.lower()
                if lv == "close": c.keep_alive = false
                else lv == "keep-alive": c.keep_alive = true end
            end
        end
        pos = line_end + 2
    end
    if body_start >= 0 && body_start < n:
        c.body = req.substr(body_start, n - body_start)
    end
end

func _server_header(hide: bool): str:
    if hide: ret "Salam" end
    ret "Salam/".concat(SERVER_VERSION)
end

// "200 OK" without a heap allocation. The old path called conv.FormatInt to
// turn the number into digits and mime.StatusText to look up the reason
// phrase, then concatenated both, for every response. These four cover
// essentially all of the traffic a server actually emits; everything else
// falls through to the general path, which still works.
func _status_line(status: int): str:
    if status == 200: ret "200 OK" end
    if status == 404: ret "404 Not Found" end
    if status == 204: ret "204 No Content" end
    if status == 500: ret "500 Internal Server Error" end
    ret conv.FormatInt(status as i64).concat(" ").concat(mime.StatusText(status))
end

// Serializes the response into `b`, headers and body together.
//
// The old version built the same bytes with about a dozen `resp = resp.concat(...)`
// steps. Each one allocates a new string the size of everything written so
// far and copies it, so serializing an n-piece response costs O(n^2) bytes
// copied and n allocations, all of them thrown away. A builder doubles its
// buffer instead: one allocation per doubling, each byte written once.
//
// Body and headers land in the same buffer on purpose, so the whole response
// leaves in a single write. Two writes would mean two syscalls, and with
// TCP_NODELAY on, two packets for what fits in one.
func _fill_response(b &: str.StringBuilder, ctx: i64, hide: bool, keep: bool):
    status := salam_ctx_get_status(ctx)
    ct := salam_ctx_get(ctx, 4)
    body := salam_ctx_get(ctx, 5)
    str.BufAppend(b, "HTTP/1.1 ")
    str.BufAppend(b, _status_line(status))
    str.BufAppend(b, "\r\nContent-Length: ")
    str.BufAppendInt(b, body.len() as i64)
    if keep:
        str.BufAppend(b, "\r\nConnection: keep-alive")
    else:
        str.BufAppend(b, "\r\nConnection: close")
    end
    str.BufAppend(b, "\r\nServer: ")
    str.BufAppend(b, _server_header(hide))
    str.BufAppend(b, "\r\n")
    if ct.len() > 0:
        str.BufAppend(b, "Content-Type: ")
        str.BufAppend(b, ct)
        str.BufAppend(b, "\r\n")
    end
    nhdr := salam_ctx_kv_n(ctx, 2)
    repeat nhdr with i:
        str.BufAppend(b, salam_ctx_kv_key(ctx, 2, i))
        str.BufAppend(b, ": ")
        str.BufAppend(b, salam_ctx_kv_val(ctx, 2, i))
        str.BufAppend(b, "\r\n")
    end
    str.BufAppend(b, "\r\n")
    str.BufAppend(b, body)
end

// Kept because std/tls's handler and any caller outside this file still want
// a response as a string. The plain-HTTP path does not use it: it writes the
// builder's bytes straight to the socket, which skips the copy BufStr makes.
func _build_response(ctx: i64, hide: bool): str:
    mut b := str.NewBuilder()
    _fill_response(b, ctx, hide, false)
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

// Runs net/router.Dispatch and, on a match, copies the extracted path
// params into this request's ctx before invoking the handler - the only
// bridge between router's pure Match value and web's ctx-handle world.
func _dispatch(r: router.Router, ctx: i64): bool:
    method := salam_ctx_get(ctx, 0)
    path := salam_ctx_get(ctx, 1)
    m := router.Dispatch(r, method, path)
    if !m.matched: ret false end
    salam_ctx_kv_clear(ctx, 1)
    n := m.params.items.len()
    mut i := 0
    until i < n:
        kv := m.params.items.get(i)
        salam_ctx_kv_add(ctx, 1, kv.key, kv.value)
        i += 1
    end
    callhandler(m.fn, ctx)
    ret true
end

func _net_listen(host: str, port: int): i64:
    ret rawsock.ListenOn(host, port, rawsock.SOCK_STREAM).fd
end

func _net_accept(lfd: i64): i64:
    ret rawsock.Accept(rawsock.FromFd(lfd)).fd
end

// ------------------------------------------------------- keep-alive plumbing

// How long a connection may sit idle between requests before its thread is
// taken back, and how many requests one connection may serve before it is
// retired. Neither limit is about correctness: they are what stops a client
// that opens a connection and says nothing from holding a thread forever.

// Bytes per socket read. One buffer is allocated per connection and reused
// for every request on it, rather than allocated and zeroed per read.

// A str of exactly `n` bytes from `ptr`. rawsock.Recv cannot be used on this
// path: it allocates a fresh max-sized buffer per call and memsets all of it
// (64 KiB of zeroing to receive a 100-byte GET), then measures the result
// with strlen. This copies the bytes the kernel actually delivered, once.
func _str_of(ptr: void *, n: int): str:
    r := mem.Allocate((n + 1) as u64)
    mem.Copy(r, ptr, n as u64)
    p := r as i8 *
    p[n] = 0 as i8
    ret r as str
end

// Content-Length, or 0. Only the framing of a request that can carry a body
// depends on this, so the header block is scanned for it only when the method
// says a body is possible - which keeps it off the path GET traffic takes.
func _content_length(head: str, head_len: int): int:
    mut pos := 0
    until pos < head_len:
        line_end := str.IndexFrom(head, "\r\n", pos)
        if line_end < 0 || line_end >= head_len: break end
        colon := str.IndexFrom(head, ":", pos)
        if colon >= 0 && colon < line_end:
            hk := head.substr(pos, colon - pos)
            if hk.len() == 14 && hk.lower() == "content-length":
                v := str.TrimLeft(head.substr(colon + 1, line_end - colon - 1)).to_int()
                if v > 0: ret v end
                ret 0
            end
        end
        pos = line_end + 2
    end
    ret 0
end

func _has_body(method: str): bool:
    if method == "GET" || method == "HEAD" || method == "OPTIONS": ret false end
    ret true
end

// Reads exactly one complete request off `fd`, leaving anything that arrived
// with it in `pending` for the next call.
//
// The old server did one recv per connection and treated whatever came back
// as the whole request. That is right often enough to look right, and wrong
// in two ways that keep-alive makes routine: a request split across packets
// was truncated, and a second pipelined request in the same segment was
// thrown away. Framing it properly - headers to the blank line, then exactly
// Content-Length body bytes - is what makes connection reuse safe rather than
// merely fast.
func _read_request(fd: i64, scratch: void *, pending &: str): str:
    sock := rawsock.FromFd(fd)
    mut buf := pending
    pending = ""
    mut head_end := str.IndexFrom(buf, "\r\n\r\n", 0)
    until head_end < 0:
        got := rawsock.RecvBytes(sock, scratch, _RD_CHUNK)
        if got <= 0: ret "" end
        buf = buf.concat(_str_of(scratch, got))
        head_end = str.IndexFrom(buf, "\r\n\r\n", 0)
    end
    head_len := head_end + 4
    mut need := head_len
    sp := buf.find(" ")
    if sp > 0 && _has_body(buf.substr(0, sp)):
        need = head_len + _content_length(buf, head_len)
        until buf.len() < need:
            got := rawsock.RecvBytes(sock, scratch, _RD_CHUNK)
            if got <= 0: break end
            buf = buf.concat(_str_of(scratch, got))
        end
        if buf.len() < need: need = buf.len() end
    end
    if need == buf.len(): ret buf end
    pending = buf.substr(need, buf.len() - need)
    ret buf.substr(0, need)
end

func _net_send_all(fd: i64, data: str):
    tcp.Write(tcp.ConnFromFd(fd), data)
end

func _net_close(fd: i64):
    tcp.Close(tcp.ConnFromFd(fd))
end

// Streams the file in fixed-size chunks instead of loading it whole into
// memory, so serving large files (video, archives, ...) doesn't blow up
// process memory or hit an arbitrary size cap.
func _send_file(fd: i64, path: str, ct: str, server_hdr: str, keep: bool): int:
    f := fopen(path, "rb")
    if f == null:
        ret 0
    end
    defer fclose(f)
    fseek(f, 0, 2)
    sz := ftell(f) as i64
    fseek(f, 0, 0)
    if sz < 0:
        ret 0
    end
    mut hb := str.NewBuilder()
    str.BufAppend(hb, "HTTP/1.1 200 OK\r\nContent-Length: ")
    str.BufAppendInt(hb, sz)
    str.BufAppend(hb, "\r\nContent-Type: ")
    str.BufAppend(hb, ct)
    if keep:
        str.BufAppend(hb, "\r\nConnection: keep-alive\r\nServer: ")
    else:
        str.BufAppend(hb, "\r\nConnection: close\r\nServer: ")
    end
    str.BufAppend(hb, server_hdr)
    str.BufAppend(hb, "\r\n\r\n")
    hdr := str.BufStr(hb)
    str.BufFree(hb)
    _net_send_all(fd, hdr)
    chunk_cap := 65536 as u64
    buf := mem.Allocate(chunk_cap)
    defer mem.Free(buf)
    conn := tcp.ConnFromFd(fd)
    mut remaining := sz
    until remaining > 0:
        want := remaining < (chunk_cap as i64) ? (remaining as u64) : chunk_cap
        got := fread(buf, 1 as u64, want, f)
        if got == (0 as u64):
            break
        end
        // A client that hangs up part way through a download used to be read
        // from disk and written into a dead socket for the whole rest of the
        // file. Stop at the first refused write instead.
        if tcp.WriteBytes(conn, buf, got as int) <= 0:
            break
        end
        remaining -= got as i64
    end
    ret 1
end

// Escapes text for safe inclusion in an HTML document (directory listings,
// generated error pages, ...).
func _html_escape(s: str): str:
    n := s.len()
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    repeat n with i:
        c := s.substr(i, 1)
        if c == "&": str.BufAppend(b, "&amp;")
        else c == "<": str.BufAppend(b, "&lt;")
        else c == ">": str.BufAppend(b, "&gt;")
        else c == `"`: str.BufAppend(b, "&quot;")
        else c == "'": str.BufAppend(b, "&#39;")
        else:
            str.BufAppend(b, c)
        end
    end
    ret str.BufStr(b)
end

// Resolves an (already percent-decoded) request path against a static
// root directory and guarantees the result cannot escape that root, no
// matter how many "../", encoded traversal segments, or absolute-looking
// paths appear in `rel`. Returns "" when the request would escape.
//
// Uses filepath.Clean's segment-collapsing algorithm: joining then
// cleaning "root/../../../etc/passwd" yields "/etc/passwd" (or similar),
// which fails the containment check below and is rejected - the request
// is judged by where it ends up, not by pattern-matching "..".
//
// root == "." (the common `salam serve` case, serving the current
// directory) needs its own branch: filepath.Clean(".") returns the
// literal "." but filepath.Clean drops "." segments from every other
// path it cleans, so a contained request like "src" cleans to "src",
// never to "./src" - the croot-prefix check below would never match it
// and every subpath would 404. Under root ".", any cleaned path that
// isn't an escape ("..", "../...") or OS-absolute is contained.
func _safe_static_path(root: str, rel: str): str:
    croot := filepath.Clean(root)
    joined := filepath.Join(croot, rel)
    cleaned := filepath.Clean(joined)
    if croot == ".":
        if cleaned == ".": ret cleaned end
        if cleaned == "..": ret "" end
        if str.StartsWith(cleaned, "../"): ret "" end
        if filepath.IsAbs(cleaned): ret "" end
        ret cleaned
    end
    if cleaned == croot: ret cleaned end
    if str.StartsWith(cleaned, croot.concat("/")): ret cleaned end
    ret ""
end

// Renders a simple "Index of <path>" directory listing, like a plain dev
// HTTP file server. Entries are shown alphabetically, directories first,
// with a ".." link when not already at the served root.
func _dir_listing_html(url_path: str, disk_path: str): str:
    names := os.ListDir(disk_path)
    defer names.free()
    mut dirs := Vector {} as Vector<str>
    defer dirs.free()
    mut files := Vector {} as Vector<str>
    defer files.free()
    repeat names.len() with i:
        name := names.get(i)
        if os.IsDir(filepath.Join(disk_path, name)):
            dirs.push(name)
        else:
            files.push(name)
        end
    end
    _insertion_sort_strs(dirs)
    _insertion_sort_strs(files)
    mut rows := str.NewBuilder()
    defer str.BufFree(rows)
    if url_path != "/":
        str.BufAppend(rows, "<li><a href=\"../\">../</a></li>\n")
    end
    repeat dirs.len() with i:
        name := dirs.get(i)
        href := encoding.URLEncode(name)
        str.BufAppend(rows, `<li><a href="`)
        str.BufAppend(rows, href)
        str.BufAppend(rows, `/">`)
        str.BufAppend(rows, _html_escape(name))
        str.BufAppend(rows, "/</a></li>\n")
    end
    repeat files.len() with i:
        name := files.get(i)
        href := encoding.URLEncode(name)
        str.BufAppend(rows, `<li><a href="`)
        str.BufAppend(rows, href)
        str.BufAppend(rows, `">`)
        str.BufAppend(rows, _html_escape(name))
        str.BufAppend(rows, "</a></li>\n")
    end
    title := _html_escape(url_path)
    mut out := "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Index of "
    out = out.concat(title)
    out = out.concat("</title></head><body>\n<h1>Index of ")
    out = out.concat(title)
    out = out.concat("</h1>\n<ul>\n")
    out = out.concat(str.BufStr(rows))
    out = out.concat("</ul>\n</body></html>\n")
    ret out
end

// Tiny in-place insertion sort local to this package, to avoid pulling in
// a cross-package generic Vector<str> instantiation for a handful of
// directory entries.
func _insertion_sort_strs(v &: Vector<str>):
    n := v.len()
    repeat n with i:
        mut j := i
        // `until COND: ...` loops WHILE COND holds (see e.g. _parse_http's
        // "until pos < req.len()"), not "until COND becomes true" - the
        // condition here is deliberately the keep-shifting condition
        // (in-bounds AND out of order), not a stop condition.
        until j > 0 && v.get(j - 1) > v.get(j):
            a := v.get(j - 1)
            b := v.get(j)
            v.set(j - 1, b)
            v.set(j, a)
            j -= 1
        end
    end
end

func _log_access(method: str, path: str, status: int):
    if _access_log == false: ret end
    println method, path, "->", status
end

// Shared by both the plain and TLS handlers: parses the request, runs
// static-file/router dispatch, and returns the fully-serialized response
// (or "" when the static-file branch already streamed its own response
// straight to the transport and there is nothing left to send).
// Serves one request and writes its response. Sets `keep` to whether the
// connection may be reused afterwards; the caller owns the socket either way.
func _serve_request(fd: i64, req: str, keep &: bool): bool:
    if req.len() == 0:
        keep = false
        ret false
    end
    ctx := salam_ctx_new(fd)
    _parse_http(ctx, req)
    keep = _rc(ctx).keep_alive
    r := _current_router
    hide := _hide_tokens
    shdr := _server_header(hide)
    mut static_handled := false
    if r.has_static:
        prefix := r.static_prefix
        path := salam_ctx_get(ctx, 1)
        if path.len() >= prefix.len() && path.substr(0, prefix.len()) == prefix:
            rel := UrlDecode(path.substr(prefix.len(), path.len() - prefix.len()))
            target := _safe_static_path(r.static_dir, rel)
            if target.len() > 0:
                if os.IsDir(target):
                    idx := filepath.Join(target, "index.html")
                    if os.Exists(idx) && os.IsDir(idx) == false:
                        if _send_file(fd, idx, mime.MimeType(idx), shdr, keep) == 1:
                            _ctx_mark_sent(ctx)
                            static_handled = true
                        end
                    else r.static_listing:
                        salam_ctx_set_status(ctx, 200)
                        salam_ctx_set(ctx, 4, "text/html; charset=utf-8")
                        salam_ctx_set(ctx, 5, _dir_listing_html(path, target))
                        static_handled = true
                    end
                else os.Exists(target):
                    if _send_file(fd, target, mime.MimeType(target), shdr, keep) == 1:
                        _ctx_mark_sent(ctx)
                        static_handled = true
                    end
                end
            end
        end
    end
    if static_handled == false:
        dispatched := _dispatch(r, ctx)
        if dispatched == false:
            salam_ctx_set_status(ctx, 404)
            salam_ctx_set(ctx, 4, "text/plain; charset=utf-8")
            salam_ctx_set(ctx, 5, "404 Not Found")
        end
    end
    _log_access(salam_ctx_get(ctx, 0), salam_ctx_get(ctx, 1), salam_ctx_get_status(ctx))
    if salam_ctx_is_sent(ctx) == 0:
        mut b := str.NewBuilder()
        _fill_response(b, ctx, hide, keep)
        // Straight out of the builder: no BufStr copy, one write for headers
        // and body together.
        tcp.WriteBytes(tcp.ConnFromFd(fd), b.data, b.len as int)
        str.BufFree(b)
    end
    salam_ctx_free(ctx)
    ret true
end

// One thread per connection, and now one connection for many requests.
//
// This used to be one thread per *request*: the handler read once, answered,
// closed, and exited, so every single GET cost a TCP handshake, a thread
// creation, a thread teardown and a four-way close. That is most of the work
// in serving a small response, and none of it is serving.
//
// TCP_NODELAY matters more once the connection is reused. Without it, a
// small response can sit in the kernel waiting for more data to coalesce
// with, and on a reused connection there is nothing behind it to coalesce
// with until the client's next request - which the client will not send
// until it has this response. Nagle plus delayed ACK turns that standoff
// into tens of milliseconds of latency on an otherwise idle link.
func _web_conn_handler(fd: i64):
    sock := rawsock.FromFd(fd)
    rawsock.SetNoDelay(sock, true)
    rawsock.SetTimeout(sock, _keepalive_idle_ms)
    scratch := mem.Allocate((_RD_CHUNK + 1) as u64)
    mut pending := ""
    mut served := 0
    until 1 == 1:
        req := _read_request(fd, scratch, pending)
        if req.len() == 0: break end
        mut keep := true
        if _serve_request(fd, req, keep) == false: break end
        served += 1
        if keep == false || served >= _keepalive_max_reqs: break end
    end
    mem.Free(scratch)
    _net_close(fd)
end

// TLS variant of the connection handler: wraps the accepted fd in a
// server-side TLS 1.3 handshake (std/tls.WrapServer) before doing
// anything else, then reads/writes through the tls.Conn instead of the
// raw fd. Static files are read fully into memory and sent in one
// tls.Write rather than streamed in fixed chunks over the raw fd - TLS
// already segments its own records, so the streaming optimization
// _send_file relies on for plain connections doesn't carry the same
// value here, and doing it this way avoids a second chunked-file-over-
// TLS code path for what is, on the TLS listener, presumably a much
// smaller fraction of traffic than dynamic API responses.
//
// This duplicates _handle_request's static/dispatch decision tree
// rather than sharing it, because the static-file branch needs a
// different low-level write primitive (tls.Write vs the raw fd) at the
// exact point the decision is made - a real DRY gap, not an oversight;
// factoring it out cleanly needs the static-file decision separated
// from the static-file I/O, which is a slightly bigger refactor than
// this pass covers. Keep both branches in sync by hand until then.
func _web_tls_conn_handler(fd: i64):
    mut c := tls.WrapServer(fd, _current_tls_cfg)
    if !tls.ConnOk(c):
        tls.Close(c)
        ret
    end
    req := tls.Read(c, 32768)
    if req.len() == 0:
        tls.Close(c)
        ret
    end
    ctx := salam_ctx_new(fd)
    defer salam_ctx_free(ctx)
    _parse_http(ctx, req)
    r := _current_router
    hide := _hide_tokens
    shdr := _server_header(hide)
    mut static_handled := false
    if r.has_static:
        prefix := r.static_prefix
        path := salam_ctx_get(ctx, 1)
        if path.len() >= prefix.len() && path.substr(0, prefix.len()) == prefix:
            rel := UrlDecode(path.substr(prefix.len(), path.len() - prefix.len()))
            target := _safe_static_path(r.static_dir, rel)
            if target.len() > 0:
                if os.IsDir(target):
                    idx := filepath.Join(target, "index.html")
                    if os.Exists(idx) && os.IsDir(idx) == false:
                        _tls_send_file(c, idx, mime.MimeType(idx), shdr)
                        _ctx_mark_sent(ctx)
                        static_handled = true
                    else r.static_listing:
                        salam_ctx_set_status(ctx, 200)
                        salam_ctx_set(ctx, 4, "text/html; charset=utf-8")
                        salam_ctx_set(ctx, 5, _dir_listing_html(path, target))
                        static_handled = true
                    end
                else os.Exists(target):
                    _tls_send_file(c, target, mime.MimeType(target), shdr)
                    _ctx_mark_sent(ctx)
                    static_handled = true
                end
            end
        end
    end
    if static_handled == false:
        dispatched := _dispatch(r, ctx)
        if dispatched == false:
            salam_ctx_set_status(ctx, 404)
            salam_ctx_set(ctx, 4, "text/plain; charset=utf-8")
            salam_ctx_set(ctx, 5, "404 Not Found")
        end
    end
    _log_access(salam_ctx_get(ctx, 0), salam_ctx_get(ctx, 1), salam_ctx_get_status(ctx))
    if salam_ctx_is_sent(ctx) == 0:
        resp := _build_response(ctx, hide)
        tls.Write(c, resp)
    end
    tls.Close(c)
end

func _tls_send_file(c &: tls.Conn, path: str, ct: str, server_hdr: str):
    f := fopen(path, "rb")
    if f == null: ret end
    fseek(f, 0, 2)
    sz := ftell(f) as i64
    fseek(f, 0, 0)
    if sz < 0:
        fclose(f)
        ret
    end
    mut hdr := "HTTP/1.1 200 OK\r\nContent-Length: "
    hdr = hdr.concat(conv.FormatInt(sz))
    hdr = hdr.concat("\r\nContent-Type: ")
    hdr = hdr.concat(ct)
    hdr = hdr.concat("\r\nConnection: close\r\nServer: ")
    hdr = hdr.concat(server_hdr)
    hdr = hdr.concat("\r\n\r\n")
    tls.Write(c, hdr)
    buf := mem.Allocate((sz + 1) as u64)
    defer mem.Free(buf)
    got := fread(buf, 1 as u64, sz as u64, f)
    fclose(f)
    if got > (0 as u64):
        tls.WriteBytes(c, buf, got as int)
    end
end

@en "SetKeepAliveIdle"
@fa "تنظیم بیکاری زنده نگه داشتن"
@ar "تعیین خمول الاتصال"
pub func SetKeepAliveIdle(millis: int):
    _keepalive_idle_ms = millis
end

@en "SetKeepAliveMaxRequests"
@fa "بیشینه درخواست زنده نگه داشتن"
@ar "أقصی طلبات الاتصال"
pub func SetKeepAliveMaxRequests(n: int):
    _keepalive_max_reqs = n
end
