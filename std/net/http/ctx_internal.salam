package http

import net.tcp
import net.mime
import net.router
import net.internal.rawsock
import tls
import mem
import str
import conv
import encoding
import filepath
import os

// The request-handling internals migrated from std/web/web.salam: the
// opaque request-context handle (an i64 pointing at a heap-allocated
// _ReqCtx - kept as a raw handle, not a Salam struct with foreign
// fields, for the same cross-package struct-embedding codegen reasons
// tcp.Conn/DialTLS document), HTTP/1.1 request parsing, response
// serialization, static file serving with directory-traversal
// protection, and the per-connection handler run on its own OS thread.
//
// Route matching itself is delegated to net/router.Dispatch (a pure
// function, no side effects on this context) - this file's job is
// purely translating between "the wire" and "a Router lookup", which is
// the same responsibility std/web's `_dispatch` had, just no longer
// entangled with the matching algorithm.

extern:
    func fopen(path: str, mode: str): void *
    func fread(ptr: void *, size: u64, nmemb: u64, stream: void *): u64
    func fseek(stream: void *, off: int, whence: int): int
    // int, not i64: std/os.salam's own `extern func ftell` declares the
    // same libc symbol as returning plain `int` (both get emitted into the
    // same generated C header once a program imports both packages), so
    // the two declarations must agree exactly or the C build fails with
    // "conflicting types for 'ftell'". Widened to i64 at every call site.
    func ftell(stream: void *): int
    func fclose(stream: void *): int
end

@en "SERVER_VERSION"
@fa "نسخه سرور"
@ar "إصدار الخادم"
// The toolchain's own version, so the Server: header a Salam service sends
// tracks the repo's VERSION file with nothing to bump here.
pub const SERVER_VERSION := SALAM_VERSION

// Bytes per socket read; one buffer per connection, reused per request.
const _RD_CHUNK := 65536

// How many listeners one process may run, and the split point of the packed
// (slot, fd) pair their connection threads are started with: the slot index
// sits above bit 32, the file descriptor below it. See "the server table".
const _SRV_MAX := 8
const _SRV_SHIFT := 32 as i64
const _SRV_MASK := 4294967295 as i64

mut _reqctx_size := 0 as i64
mut _keepalive_idle_ms := 5000
mut _keepalive_max_reqs := 100000

// ------------------------------------------------------- the server table
//
// One process, several listeners. There used to be a single `_current_router`
// global that Run() wrote before its accept loop and every handler thread
// read; a second Run() in the same process overwrote it, and both listeners
// then dispatched through whichever router started last. That is not an
// exotic case - an API on 8080 with its OpenAPI docs on 8081 (see
// net/http/swagger) is two servers, and so is a health endpoint on a port a
// load balancer can reach but the internet cannot.
//
// So a server's settings live in a slot, and the slot index travels with the
// connection: Run packs it into the high half of the i64 it hands the
// connection thread, next to the accepted file descriptor. Nothing is looked
// up per request that was not already known when the listener started.
//
// The vectors are filled to _SRV_MAX once, on the first Run, and never grow
// again - Run only `set`s. That matters because handler threads read this
// table without a lock: a push that reallocated the backing buffer while a
// thread was reading through it would be a use-after-free, whereas a slot
// written before its own listener exists is read by nobody until then.
mut _srv_routers := Vector {} as Vector<router.Router>
mut _srv_hide := Vector {} as Vector<bool>
mut _srv_log := Vector {} as Vector<bool>
mut _srv_tls := Vector {} as Vector<tls.ServerConfig>
// The "Salam/x.y.z" the Server and X-Powered-By headers carry. It is the
// same bytes for the life of the process, so it is built once per listener
// here rather than concatenated fresh for every response.
mut _srv_shdr := Vector {} as Vector<str>
mut _srv_count := 0

@en "Context"
@fa "زمینه"
@ar "سیاق"
pub struct Context:
    pub h: i64
end

struct _KV:
    pub k: str = ""
    pub v: str = ""
end

struct _ReqCtx:
    pub fd: i64 = 0
    pub status: int = 200
    pub is_sent: bool = false
    pub method: str = ""
    pub path: str = ""
    pub query: str = ""
    pub body: str = ""
    pub resp_ct: str = ""
    pub resp_body: str = ""
    pub req_hdrs: Vector<_KV> = Vector {}
    pub path_params: Vector<_KV> = Vector {}
    pub resp_hdrs: Vector<_KV> = Vector {}
    // Whether this request permits the connection to be reused, decided by
    // _parse_http from the HTTP version and the Connection header. The
    // default is the HTTP/1.1 rule (reuse unless told otherwise); a request
    // line ending in HTTP/1.0, or an explicit "Connection: close", flips it.
    pub keep_alive: bool = true
    // Every heap string this server allocates while serving the request -
    // the method, the path, each header name and value, each captured path
    // parameter - is registered here and freed when the request ends.
    //
    // A `str` is a bare byte pointer with no ownership attached, so there is
    // no way to look at c.method and know whether it is a slice this server
    // malloc'd or a literal baked into the binary. Freeing the struct alone
    // (which is all salam_ctx_free used to do) therefore released about
    // thirty bytes and abandoned everything they pointed at: roughly 1.2 KB
    // per request, on every route, until the kernel killed the process.
    // Keeping the pointers is what makes releasing them safe.
    pub owned: Vector<i64> = Vector {}
    // The request bytes as they arrived, plus the half-open span of the
    // header block inside them.
    //
    // Headers used to be copied out eagerly: a name and a value allocated,
    // trimmed and stored for every header line of every request, whether or
    // not the handler ever asked for one. A plain GET carries three or four
    // of them and most handlers read none, so that was eight allocations and
    // eight frees per request spent on nothing. Ctx_header now slices the
    // value it was asked for straight out of these bytes.
    //
    // `raw` is borrowed, not owned - it points at the connection's receive
    // buffer or at the request string the handler loop is holding, both of
    // which outlive the request and neither of which this context frees.
    pub raw: str = ""
    pub hdr_pos: int = 0
    pub hdr_end: int = 0
end

@en "Server"
@fa "سرور"
@ar "خادم"
pub struct Server:
    pub port: int = 0
    pub host: str = "0.0.0.0"
    pub router: router.Router = router.Router {}
    pub hide_tokens: bool = false
    pub access_log: bool = false
end

// Path/query parsing and the static-file safety check (_safe_static_path)
// all go through str.split("/") indirectly via filepath.Clean/Join. On this
// toolchain, the very first str.split() call in a process that produces 3+
// pieces can return a Vector whose last slot was never actually written
// (reads back as the Windows "uninitialized heap" poison pattern
// 0xBAADF00D, confirmed under gdb) - some one-time lazy-init gap in the
// C runtime/allocator that a single earlier split() call papers over for
// the rest of the process's lifetime. Running one harmless split here,
// before the first real request can reach _safe_static_path, avoids
// hitting that gap on live traffic. Cheap and process-wide: this needs to
// run exactly once, not once per connection/thread.
func _srv_init():
    if _srv_routers.len() > 0:
        ret
    end
    repeat _SRV_MAX with _:
        _srv_routers.push(router.NewRouter())
        _srv_hide.push(false)
        _srv_log.push(false)
        _srv_tls.push(tls.NewServerConfig("", ""))
        _srv_shdr.push("Salam")
    end
end

// Claim a slot for a server about to start listening. Past _SRV_MAX the last
// slot is reused rather than the call failing: a ninth listener is already a
// misconfiguration, and sharing a slot degrades to the old single-router
// behaviour instead of dropping the server on the floor.
func _srv_claim(r: router.Router, hide: bool, log: bool): int:
    _srv_init()
    mut slot := _srv_count
    if slot >= _SRV_MAX:
        slot = _SRV_MAX - 1
    else:
        _srv_count += 1
    end
    _srv_routers.set(slot, r)
    _srv_hide.set(slot, hide)
    _srv_log.set(slot, log)
    _srv_shdr.set(slot, _server_header(hide))
    ret slot
end

func _srv_pack(slot: int, fd: i64): i64:
    ret (slot as i64 << _SRV_SHIFT) | fd
end

func _srv_slot_of(packed: i64): int:
    ret (packed >> _SRV_SHIFT) as int
end

func _srv_fd_of(packed: i64): i64:
    ret packed & _SRV_MASK
end

func _warm_up_split():
    junk := "a/b".split("/")
    // free() releases the vector's backing array; the pieces split allocated
    // are separate blocks and have to go individually.
    repeat junk.len() with i:
        mem.Free(junk.get(i) as void *)
    end
    junk.free()
end

func _reqctx_sizeof(): i64:
    if _reqctx_size == 0:
        mut v := Vector {} as Vector<_ReqCtx> v.push(_ReqCtx {})
        v.push(_ReqCtx {})
        // the stride between two slots, so these have to be the addresses
        // ref hands back, not the elements get returns
        _reqctx_size = (v.ref(1) as i64) - (v.ref(0) as i64)
        v.free()
    end
    ret _reqctx_size
end

func _rc(h: i64): _ReqCtx *:
    ret h as _ReqCtx *
end

// Whether `s` carries `lit`, in full, starting at `pos`.
//
// The obvious spelling is `s.substr(pos, lit.len()) == lit`, and it is what
// this file used everywhere. Every one of those comparisons heap-allocates a
// copy of the span, compares it, and abandons it - the header-block walk did
// it once per header line of every request, which was the single largest
// remaining source of the server's memory growth after the request context
// started freeing itself. Reading the bytes costs nothing and allocates
// nothing.
func _eq_at(s: str, pos: int, lit: str): bool:
    m := lit.len()
    if pos < 0 || pos + m > s.len(): ret false end
    sp := s as i8 *
    lp := lit as i8 *
    mut i := 0
    until i < m:
        if sp[pos + i] != lp[i]: ret false end
        i += 1
    end
    ret true
end

// True when byte `i` of `s` is a space or a tab - the optional whitespace
// HTTP allows between a header's colon and its value.
func _ows_at(s: str, i: int): bool:
    p := s as i8 *
    b := p[i] as int
    ret b == 32 || b == 9
end

// _eq_at, folding BOTH sides, for comparing a field name on the wire against
// one a caller spelled however they liked ("Content-Type", "content-type").
func _eq_at_ifold(s: str, pos: int, name: str): bool:
    m := name.len()
    if pos < 0 || pos + m > s.len(): ret false end
    sp := s as i8 *
    np := name as i8 *
    mut i := 0
    until i < m:
        mut a := sp[pos + i] as int
        mut b := np[i] as int
        if a >= 65 && a <= 90: a += 32 end
        if b >= 65 && b <= 90: b += 32 end
        if a != b: ret false end
        i += 1
    end
    ret true
end

// _eq_at with ASCII case folding, for the field names HTTP says are
// case-insensitive. `lit` must already be lowercase.
func _eq_at_fold(s: str, pos: int, lit: str): bool:
    m := lit.len()
    if pos < 0 || pos + m > s.len(): ret false end
    sp := s as i8 *
    lp := lit as i8 *
    mut i := 0
    until i < m:
        mut a := sp[pos + i] as int
        if a >= 65 && a <= 90: a += 32 end
        if a != (lp[i] as int): ret false end
        i += 1
    end
    ret true
end

func salam_ctx_new(fd: i64): i64:
    p := mem.Allocate(_reqctx_sizeof() as u64)
    c := p as _ReqCtx * c[0] = _ReqCtx { fd = fd }
    ret p as i64
end

// Hands a heap string to the request scope. Returns it unchanged so it can
// be used inline at the point it is produced, which is the only place the
// answer to "who frees this?" is still obvious.
//
// The pointer must be heap-allocated. Registering a literal here would hand
// free() a pointer into the binary's read-only data, so every producer whose
// result reaches this function returns heap unconditionally - see BufStr and
// _query_parse, both of which allocate even for the empty result rather than
// return "" and leave the caller unable to tell the two apart.
func _ctx_own(h: i64, s: str): str:
    c := _rc(h)
    c.owned.push((s as void *) as i64)
    ret s
end

// Releases everything this request allocated and returns the context to the
// state salam_ctx_new left it in, WITHOUT giving the vectors' buffers back.
//
// A keep-alive connection serves many requests, and allocating a context, an
// ownership list and three key/value vectors for each of them - then freeing
// all five again - is five malloc/free pairs per request that buy nothing:
// the next request on the same connection needs the same five things, at
// close to the same sizes. Popping to empty keeps the capacity, so the second
// and later requests on a connection allocate nothing for their own
// bookkeeping at all. This matters more now than it did before: releasing the
// request's strings is real work that leaking them did not cost, and reusing
// the buffers is what pays for it.
func salam_ctx_reset(h: i64):
    c := _rc(h)
    n := c.owned.len()
    mut i := 0
    until i < n:
        mem.Free(c.owned.get(i) as void *)
        i += 1
    end
    until c.owned.len() > 0:
        c.owned.pop()
    end
    _kvl_clear(c.req_hdrs)
    _kvl_clear(c.path_params)
    _kvl_clear(c.resp_hdrs)
    c.status = 200
    c.is_sent = false
    c.keep_alive = true
    c.raw = ""
    c.hdr_pos = 0
    c.hdr_end = 0
    c.method = ""
    c.path = ""
    c.query = ""
    c.body = ""
    c.resp_ct = ""
    c.resp_body = ""
end

func salam_ctx_free(h: i64):
    c := _rc(h)
    n := c.owned.len()
    mut i := 0
    until i < n:
        mem.Free(c.owned.get(i) as void *)
        i += 1
    end
    c.owned.free()
    // The key/value strings these hold were registered above as they were
    // produced, so only the vectors' own backing buffers are left.
    c.req_hdrs.free()
    c.path_params.free()
    c.resp_hdrs.free()
    mem.Free(h as void *)
end

func salam_ctx_fd(h: i64): i64:
    ret _rc(h).fd
end

func salam_ctx_get(h: i64, idx: int): str:
    c := _rc(h)
    if idx == 0: ret c.method
    else idx == 1: ret c.path
    else idx == 2: ret c.query
    else idx == 3: ret c.body
    else idx == 4: ret c.resp_ct
    else idx == 5: ret c.resp_body
    else:
        ret ""
    end
end

func salam_ctx_set(h: i64, idx: int, val: str):
    c := _rc(h)
    if idx == 0: c.method = val
    else idx == 1: c.path = val
    else idx == 2: c.query = val
    else idx == 3: c.body = val
    else idx == 4: c.resp_ct = val
    else idx == 5: c.resp_body = val end
end

func salam_ctx_get_status(h: i64): int:
    ret _rc(h).status
end

func salam_ctx_set_status(h: i64, status: int):
    c := _rc(h)
    c.status = status
end

func salam_ctx_is_sent(h: i64): int:
    if _rc(h).is_sent: ret 1 end
    ret 0
end

func _ctx_mark_sent(h: i64):
    c := _rc(h)
    c.is_sent = true
end

func _kvl_get(l &: Vector<_KV>, key: str): str:
    repeat l.len() with i:
        kv := l.get(i)
        if kv.k == key: ret kv.v end
    end
    ret ""
end

// The same lookup, for the two lists whose keys are HTTP FIELD NAMES.
//
// Field names are case-insensitive (RFC 9110 §5.1), and HTTP/2 goes further and
// requires them to be lowercase on the wire (RFC 9113 §8.2.1). So a request that
// reached this server through any HTTP/2 hop - which is every browser talking to
// a proxy - arrives carrying `authorization`, not `Authorization`. An exact
// comparison finds nothing, and a handler asking for "Authorization" is told the
// request had none: the caller is anonymous, CORS never fires, the conditional
// request always misses. It looks like an application bug and it is not one.
//
// Path parameters keep the exact comparison. Those are names the route author
// chose, not names a peer sends, and :id and :ID are two different parameters.
func _kvl_get_field(l &: Vector<_KV>, key: str): str:
    repeat l.len() with i:
        kv := l.get(i)
        if str.EqualFold(kv.k, key): ret kv.v end
    end
    ret ""
end

func _kvl_set(l &: Vector<_KV>, key: str, val: str):
    repeat l.len() with i:
        if l.get(i).k == key:
            l.set(i, _KV { k = key, v = val })
            ret
        end
    end
    l.push(_KV { k = key, v = val })
end

// Set-Cookie specifically dedupes by cookie NAME (the "n=" prefix of the
// serialized value), unlike every other response header. Setting the same
// cookie twice in one handler - e.g. session.Start followed immediately by
// session.Regenerate, both of which set the session-id cookie - should
// replace the earlier Set-Cookie line, not add a second one for a value
// that's about to be superseded. A real browser resolves two same-name
// Set-Cookie lines fine on its own (last one wins), but there's no reason
// to ship the dead first line over the wire.
func _kvl_set_cookie(l &: Vector<_KV>, cookie_name: str, val: str):
    prefix := cookie_name.concat("=")
    mut i := 0
    until i < l.len():
        kv := l.get(i)
        if kv.k == "Set-Cookie" && kv.v.len() >= prefix.len() && kv.v.substr(0, prefix.len()) == prefix:
            l.remove_at(i)
        else:
            i += 1
        end
    end
    l.push(_KV { k = "Set-Cookie", v = val })
end

func _kvl_clear(l &: Vector<_KV>):
    until l.len() > 0:
        l.pop()
    end
end

// Finds one header in the request bytes, without having copied any of them
// out first. Returns "" - a literal, borrowed - when the request did not
// carry the field, and otherwise a request-scoped copy of the value.
func _hdr_lookup(h: i64, name: str): str:
    c := _rc(h)
    raw := c.raw
    if raw.len() == 0: ret "" end
    e := c.hdr_end
    nlen := name.len()
    mut pos := c.hdr_pos
    until pos < e:
        line_end := str.IndexFrom(raw, "\r\n", pos)
        if line_end < 0 || line_end > e: break end
        colon := str.IndexFrom(raw, ":", pos)
        if colon >= 0 && colon < line_end && colon - pos == nlen && _eq_at_ifold(raw, pos, name):
            mut vs := colon + 1
            until vs < line_end && _ows_at(raw, vs):
                vs += 1
            end
            ret _ctx_own(h, raw.substr(vs, line_end - vs))
        end
        pos = line_end + 2
    end
    ret ""
end

func salam_ctx_kv_get(h: i64, list: int, key: str): str:
    c := _rc(h)
    if list == 0:
        // Anything a middleware injected wins over what arrived on the wire;
        // the list is empty on the ordinary path, so this costs a length
        // check.
        if c.req_hdrs.len() > 0:
            over := _kvl_get_field(c.req_hdrs, key)
            if over.len() > 0: ret over end
        end
        ret _hdr_lookup(h, key)
    else list == 1: ret _kvl_get(c.path_params, key)
    else:
        ret _kvl_get_field(c.resp_hdrs, key)
    end
end

func salam_ctx_kv_add(h: i64, list: int, key: str, val: str):
    c := _rc(h)
    if list == 0: _kvl_set(c.req_hdrs, key, val)
else list == 1: _kvl_set(c.path_params, key, val)
else:
    _kvl_set(c.resp_hdrs, key, val)
end
end

func salam_ctx_kv_set_cookie(h: i64, cookie_name: str, val: str):
    c := _rc(h)
    _kvl_set_cookie(c.resp_hdrs, cookie_name, val)
end

func salam_ctx_kv_clear(h: i64, list: int):
    c := _rc(h)
    if list == 0: _kvl_clear(c.req_hdrs)
else list == 1: _kvl_clear(c.path_params)
else:
    _kvl_clear(c.resp_hdrs)
end
end

func salam_ctx_kv_n(h: i64, list: int): int:
    c := _rc(h)
    if list == 0: ret c.req_hdrs.len()
    else list == 1: ret c.path_params.len()
    else:
        ret c.resp_hdrs.len()
    end
end

func salam_ctx_kv_key(h: i64, list: int, idx: int): str:
    c := _rc(h)
    if list == 0: ret c.req_hdrs.get(idx).k
    else list == 1: ret c.path_params.get(idx).k
    else:
        ret c.resp_hdrs.get(idx).k
    end
end

func salam_ctx_kv_val(h: i64, list: int, idx: int): str:
    c := _rc(h)
    if list == 0: ret c.req_hdrs.get(idx).v
    else list == 1: ret c.path_params.get(idx).v
    else:
        ret c.resp_hdrs.get(idx).v
    end
end

// The value of `key` in an "a=1&b=2" string, percent-decoded. Always returns
// a heap string the caller owns, "" included, so the result is unconditionally
// safe to free (see _ctx_own on why that matters).
//
// The old version decoded the WHOLE string first and then split it on "&" and
// "=". That is wrong as well as leaky: a value containing %26 decodes to a
// literal "&" before the split ever runs, so ?q=a%26b parsed as two fields and
// the caller got "a". Percent-decoding has to happen after the field
// boundaries are found, never before. Splitting is done by index here, so the
// scan itself allocates nothing.
func _query_parse(req: str, key: str): str:
    n := req.len()
    mut pos := 0
    until pos < n:
        amp := str.IndexFrom(req, "&", pos)
        mut fend := amp
        if fend < 0: fend = n end
        eq := str.IndexFrom(req, "=", pos)
        if eq >= 0 && eq < fend:
            kraw := req.substr(pos, eq - pos)
            kdec := UrlDecode(kraw)
            mem.Free(kraw as void *)
            hit := kdec == key
            mem.Free(kdec as void *)
            if hit:
                vraw := req.substr(eq + 1, fend - eq - 1)
                vdec := UrlDecode(vraw)
                mem.Free(vraw as void *)
                ret vdec
            end
        end
        if amp < 0: break end
        pos = amp + 1
    end
    ret str.Clone("")
end

// Three copies of the whole request used to be made before a single header
// was read: `after_method` (everything past the verb), then the header walk,
// then a fresh scan from offset 0 for the blank line that the header walk had
// already stepped over. This version copies out only the request target,
// remembers where the header walk stopped, and slices the body from there.
func _parse_http(ctx: i64, req: str):
    c := _rc(ctx)
    n := req.len()
    sp1 := req.find(" ")
    if sp1 < 0: ret end
    c.method = _ctx_own(ctx, req.substr(0, sp1))
    sp2 := str.IndexFrom(req, " ", sp1 + 1)
    if sp2 < 0: ret end
    pathquery := req.substr(sp1 + 1, sp2 - sp1 - 1)
    qmark := pathquery.find("?")
    if qmark >= 0:
        c.path = _ctx_own(ctx, pathquery.substr(0, qmark))
        c.query = _ctx_own(ctx, pathquery.substr(qmark + 1, pathquery.len() - qmark - 1))
        // Both halves were copied out; the request target itself is dead.
        mem.Free(pathquery as void *)
    else:
        c.path = _ctx_own(ctx, pathquery)
        c.query = ""
    end
    first_crlf := str.IndexFrom(req, "\r\n", sp2 + 1)
    if first_crlf < 0: ret end
    // "HTTP/1.0" defaults to closing the connection; 1.1 and later default to
    // keeping it. Either default can still be overridden by Connection below.
    if first_crlf - sp2 - 1 >= 8 && _eq_at(req, sp2 + 1, "HTTP/1.0"):
        c.keep_alive = false
    end
    // The header block stays where it landed. This walk only has to find
    // where the body starts and settle keep-alive; every field name and value
    // it used to copy out is read on demand by _hdr_lookup instead, and most
    // are never asked for at all.
    c.raw = req
    c.hdr_pos = first_crlf + 2
    mut pos := first_crlf + 2
    mut body_start := 0 - 1
    until pos < n:
        if pos + 1 < n && _eq_at(req, pos, "\r\n"):
            body_start = pos + 2
            break
        end
        line_end := str.IndexFrom(req, "\r\n", pos)
        if line_end < 0:
            break
        end
        colon := str.IndexFrom(req, ":", pos)
        // "Connection" is ten characters; nothing else decided here is, so
        // the length check keeps the comparison off the hot path for every
        // other header on every request.
        if colon >= 0 && colon < line_end && colon - pos == 10 && _eq_at_fold(req, pos, "connection"):
            mut vs := colon + 1
            until vs < line_end && _ows_at(req, vs):
                vs += 1
            end
            if _eq_at_fold(req, vs, "close"): c.keep_alive = false
            else _eq_at_fold(req, vs, "keep-alive"): c.keep_alive = true end
        end
        pos = line_end + 2
    end
    c.hdr_end = pos
    if body_start >= 0 && body_start < n:
        c.body = _ctx_own(ctx, req.substr(body_start, n - body_start))
    end
end

func _server_header(hide: bool): str:
    if hide: ret "Salam" end
    ret "Salam/".concat(SERVER_VERSION)
end

// Whether the handler already set a header of its own by this name. Header
// names are case-insensitive, so a handler that wrote "content-type" has to
// count as having written "Content-Type" - anything else sends the header
// twice, which is what a client of this server used to get on every JSON
// response that also named a charset.
func _has_header(ctx: i64, name: str): bool:
    n := salam_ctx_kv_n(ctx, 2)
    repeat n with i:
        if str.EqualFold(salam_ctx_kv_key(ctx, 2, i), name): ret true end
    end
    ret false
end

// "200 OK" without a heap allocation. The old path called conv.FormatInt to
// turn the number into digits and mime.StatusText to look up the reason
// phrase, then concatenated both, for every response. These four cover
// essentially all of the traffic a server actually emits; everything else
// falls through to the general path, which still works.
func _append_status(b &: str.StringBuilder, status: int):
    if status == 200: str.BufAppend(b, "200 OK") ret end
    if status == 404: str.BufAppend(b, "404 Not Found") ret end
    if status == 204: str.BufAppend(b, "204 No Content") ret end
    if status == 500: str.BufAppend(b, "500 Internal Server Error") ret end
    // The general path used to be FormatInt(...).concat(" ").concat(...),
    // which allocated twice and freed neither. StatusText returns a literal,
    // so writing both pieces into the builder allocates nothing at all.
    str.BufAppendInt(b, status as i64)
    str.BufAppend(b, " ")
    str.BufAppend(b, mime.StatusText(status))
end

// Serializes the response into `b`, headers and body together.
//
// The old version built the same bytes with about a dozen `resp = resp.concat(...)`
// steps. Each one allocates a new string the size of everything written so
// far and copies it, so serializing an n-piece response costs O(n^2) bytes
// copied and n allocations, all of them thrown away. A builder doubles its
// buffer instead: one allocation per doubling, each byte written once.
//
// Body and headers land in the same buffer on purpose, so the whole response
// leaves in a single write. Two writes would mean two syscalls, and with
// TCP_NODELAY on, two packets for what fits in one.
func _fill_response(b &: str.StringBuilder, ctx: i64, shdr: str, keep: bool):
    status := salam_ctx_get_status(ctx)
    ct := salam_ctx_get(ctx, 4)
    body := salam_ctx_get(ctx, 5)
    str.BufAppend(b, "HTTP/1.1 ")
    _append_status(b, status)
    str.BufAppend(b, "\r\nContent-Length: ")
    str.BufAppendInt(b, body.len() as i64)
    if keep:
        str.BufAppend(b, "\r\nConnection: keep-alive")
    else:
        str.BufAppend(b, "\r\nConnection: close")
    end
    str.BufAppend(b, "\r\nServer: ")
    str.BufAppend(b, shdr)
    // X-Powered-By is the header an operator reads to find out what answered.
    // A proxy in front of the service is free to rewrite Server, and most do;
    // almost none touch this one, so a Salam service says its own name twice.
    if _has_header(ctx, "X-Powered-By") == false:
        str.BufAppend(b, "\r\nX-Powered-By: ")
        str.BufAppend(b, shdr)
    end
    str.BufAppend(b, "\r\n")
    if ct.len() > 0 && _has_header(ctx, "Content-Type") == false:
        str.BufAppend(b, "Content-Type: ")
        str.BufAppend(b, ct)
        str.BufAppend(b, "\r\n")
    end
    nhdr := salam_ctx_kv_n(ctx, 2)
    repeat nhdr with i:
        str.BufAppend(b, salam_ctx_kv_key(ctx, 2, i))
        str.BufAppend(b, ": ")
        str.BufAppend(b, salam_ctx_kv_val(ctx, 2, i))
        str.BufAppend(b, "\r\n")
    end
    str.BufAppend(b, "\r\n")
    str.BufAppend(b, body)
end

// Kept because std/tls's handler and any caller outside this file still want
// a response as a string. The plain-HTTP path does not use it: it writes the
// builder's bytes straight to the socket, which skips the copy BufStr makes.
func _build_response(ctx: i64, shdr: str): str:
    mut b := str.NewBuilder()
    _fill_response(b, ctx, shdr, false)
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

// Runs net/router.Dispatch and, on a match, copies the extracted path
// params into this request's ctx before invoking the handler - the only
// bridge between router's pure Match value and web's ctx-handle world.
func _dispatch(r: router.Router, ctx: i64): bool:
    method := salam_ctx_get(ctx, 0)
    path := salam_ctx_get(ctx, 1)
    mut m := router.Dispatch(r, method, path)
    if !m.matched:
        router.FreeMatch(m)
        ret false
    end
    salam_ctx_kv_clear(ctx, 1)
    n := m.params.items.len()
    mut i := 0
    until i < n:
        kv := m.params.items.get(i)
        // The capture strings move into the request scope rather than being
        // copied: Dispatch allocated them, nothing else refers to them, and
        // the context outlives the Match.
        salam_ctx_kv_add(ctx, 1, _ctx_own(ctx, kv.key), _ctx_own(ctx, kv.value))
        i += 1
    end
    m.params.items.free()
    m.params = router.ParamList {}
    callhandler(m.fn, ctx)
    ret true
end

func _net_listen(host: str, port: int): i64:
    ret rawsock.ListenOn(host, port, rawsock.SOCK_STREAM).fd
end

func _net_accept(lfd: i64): i64:
    ret rawsock.Accept(rawsock.FromFd(lfd)).fd
end

// ------------------------------------------------------- keep-alive plumbing

// How long a connection may sit idle between requests before its thread is
// taken back, and how many requests one connection may serve before it is
// retired. Neither limit is about correctness: they are what stops a client
// that opens a connection and says nothing from holding a thread forever.

// Bytes per socket read. One buffer is allocated per connection and reused
// for every request on it, rather than allocated and zeroed per read.

// A str of exactly `n` bytes from `ptr`. rawsock.Recv cannot be used on this
// path: it allocates a fresh max-sized buffer per call and memsets all of it
// (64 KiB of zeroing to receive a 100-byte GET), then measures the result
// with strlen. This copies the bytes the kernel actually delivered, once.
func _str_of(ptr: void *, n: int): str:
    r := mem.Allocate((n + 1) as u64)
    mem.Copy(r, ptr, n as u64)
    p := r as i8 *
    p[n] = 0 as i8
    ret r as str
end

// Content-Length, or 0. Only the framing of a request that can carry a body
// depends on this, so the header block is scanned for it only when the method
// says a body is possible - which keeps it off the path GET traffic takes.
func _content_length(head: str, head_len: int): int:
    mut pos := 0
    until pos < head_len:
        line_end := str.IndexFrom(head, "\r\n", pos)
        if line_end < 0 || line_end >= head_len: break end
        colon := str.IndexFrom(head, ":", pos)
        if colon >= 0 && colon < line_end:
            if colon - pos == 14 && _eq_at_fold(head, pos, "content-length"):
                raw := head.substr(colon + 1, line_end - colon - 1)
                trimmed := str.TrimLeft(raw)
                v := trimmed.to_int()
                mem.Free(trimmed as void *)
                mem.Free(raw as void *)
                if v > 0: ret v end
                ret 0
            end
        end
        pos = line_end + 2
    end
    ret 0
end

// Reads exactly one complete request off `fd`, leaving anything that arrived
// with it in `pending` for the next call.
//
// The old server did one recv per connection and treated whatever came back
// as the whole request. That is right often enough to look right, and wrong
// in two ways that keep-alive makes routine: a request split across packets
// was truncated, and a second pipelined request in the same segment was
// thrown away. Framing it properly - headers to the blank line, then exactly
// Content-Length body bytes - is what makes connection reuse safe rather than
// merely fast.
// Whether the verb occupying s[0..vend) can carry a body.
func _has_body_at(s: str, vend: int): bool:
    if vend == 3 && _eq_at(s, 0, "GET"): ret false end
    if vend == 4 && _eq_at(s, 0, "HEAD"): ret false end
    if vend == 7 && _eq_at(s, 0, "OPTIONS"): ret false end
    ret true
end

// Reads exactly one request off `fd`, leaving anything that arrived behind it
// in `pending` for the next call. `owned` says whether the returned string is
// the caller's to free.
//
// The fast path - nothing pipelined from the previous request, and the whole
// request in one recv - hands back the receive buffer itself, NUL-terminated
// in place. That is the shape of essentially every request a keep-alive
// connection carries, and it used to cost two allocations and two full copies
// of the request bytes before a single byte was parsed: one in _str_of to
// turn the buffer into a string, and another in `buf.concat(chunk)` to append
// that string to an empty one. Now it costs neither.
//
// The buffer is reused by the next read on this connection, which is why the
// borrow is safe: the request is fully parsed, and every field the context
// keeps is copied out of it, before this function is called again.
func _read_request(fd: i64, scratch: void *, pending &: str, owned &: bool): str:
    sock := rawsock.FromFd(fd)
    owned = false
    if pending.len() == 0:
        got := rawsock.RecvBytes(sock, scratch, _RD_CHUNK)
        if got <= 0: ret "" end
        sp0 := scratch as i8 *
        sp0[got] = 0 as i8
        one := scratch as str
        head_end := str.IndexFrom(one, "\r\n\r\n", 0)
        if head_end >= 0:
            head_len := head_end + 4
            mut need := head_len
            vend := one.find(" ")
            if vend > 0 && _has_body_at(one, vend):
                need = head_len + _content_length(one, head_len)
            end
            if need == got: ret one end
            if need < got:
                pending = one.substr(need, got - need)
                owned = true
                ret one.substr(0, need)
            end
        end
        // Split across packets, or a body still arriving: copy what came in
        // and let the accumulating path below finish the job.
        pending = _str_of(scratch, got)
    end
    mut buf := pending
    pending = ""
    // Where to resume the terminator search. Scanning from 0 after every read
    // makes assembling a large request quadratic in its size; only the three
    // bytes straddling the join need re-examining.
    mut scan := 0
    mut head_end := str.IndexFrom(buf, "\r\n\r\n", scan)
    until head_end < 0:
        got := rawsock.RecvBytes(sock, scratch, _RD_CHUNK)
        if got <= 0:
            mem.Free(buf as void *)
            ret ""
        end
        chunk := _str_of(scratch, got)
        grown := buf.concat(chunk)
        mem.Free(chunk as void *)
        scan = buf.len() - 3
        if scan < 0: scan = 0 end
        mem.Free(buf as void *)
        buf = grown
        head_end = str.IndexFrom(buf, "\r\n\r\n", scan)
    end
    head_len := head_end + 4
    mut need := head_len
    vend := buf.find(" ")
    if vend > 0 && _has_body_at(buf, vend):
        need = head_len + _content_length(buf, head_len)
        until buf.len() < need:
            got := rawsock.RecvBytes(sock, scratch, _RD_CHUNK)
            if got <= 0: break end
            chunk := _str_of(scratch, got)
            grown := buf.concat(chunk)
            mem.Free(chunk as void *)
            mem.Free(buf as void *)
            buf = grown
        end
        if buf.len() < need: need = buf.len() end
    end
    owned = true
    if need == buf.len(): ret buf end
    pending = buf.substr(need, buf.len() - need)
    out := buf.substr(0, need)
    mem.Free(buf as void *)
    ret out
end

func _net_send_all(fd: i64, data: str):
    tcp.Write(tcp.ConnFromFd(fd), data)
end

func _net_close(fd: i64):
    tcp.Close(tcp.ConnFromFd(fd))
end

// Streams the file in fixed-size chunks instead of loading it whole into
// memory, so serving large files (video, archives, ...) doesn't blow up
// process memory or hit an arbitrary size cap.
func _send_file(fd: i64, path: str, ct: str, server_hdr: str, keep: bool): int:
    f := fopen(path, "rb")
    if f == null:
        ret 0
    end
    defer fclose(f)
    fseek(f, 0, 2)
    sz := ftell(f) as i64
    fseek(f, 0, 0)
    if sz < 0:
        ret 0
    end
    mut hb := str.NewBuilder()
    str.BufAppend(hb, "HTTP/1.1 200 OK\r\nContent-Length: ")
    str.BufAppendInt(hb, sz)
    str.BufAppend(hb, "\r\nContent-Type: ")
    str.BufAppend(hb, ct)
    if keep:
        str.BufAppend(hb, "\r\nConnection: keep-alive\r\nServer: ")
    else:
        str.BufAppend(hb, "\r\nConnection: close\r\nServer: ")
    end
    str.BufAppend(hb, server_hdr)
    str.BufAppend(hb, "\r\nX-Powered-By: ")
    str.BufAppend(hb, server_hdr)
    str.BufAppend(hb, "\r\n\r\n")
    hdr := str.BufStr(hb)
    str.BufFree(hb)
    _net_send_all(fd, hdr)
    mem.Free(hdr as void *)
    chunk_cap := 65536 as u64
    buf := mem.Allocate(chunk_cap)
    defer mem.Free(buf)
    conn := tcp.ConnFromFd(fd)
    mut remaining := sz
    until remaining > 0:
        want := remaining < (chunk_cap as i64) ? (remaining as u64) : chunk_cap
        got := fread(buf, 1 as u64, want, f)
        if got == (0 as u64):
            break
        end
        // A client that hangs up part way through a download used to be read
        // from disk and written into a dead socket for the whole rest of the
        // file. Stop at the first refused write instead.
        if tcp.WriteBytes(conn, buf, got as int) <= 0:
            break
        end
        remaining -= got as i64
    end
    ret 1
end

// Escapes text for safe inclusion in an HTML document (directory listings,
// generated error pages, ...).
func _html_escape(s: str): str:
    n := s.len()
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    repeat n with i:
        c := s.substr(i, 1)
        if c == "&": str.BufAppend(b, "&amp;")
        else c == "<": str.BufAppend(b, "&lt;")
        else c == ">": str.BufAppend(b, "&gt;")
        else c == `"`: str.BufAppend(b, "&quot;")
        else c == "'": str.BufAppend(b, "&#39;")
        else:
            str.BufAppend(b, c)
        end
    end
    ret str.BufStr(b)
end

// Resolves an (already percent-decoded) request path against a static
// root directory and guarantees the result cannot escape that root, no
// matter how many "../", encoded traversal segments, or absolute-looking
// paths appear in `rel`. Returns "" when the request would escape.
//
// Uses filepath.Clean's segment-collapsing algorithm: joining then
// cleaning "root/../../../etc/passwd" yields "/etc/passwd" (or similar),
// which fails the containment check below and is rejected - the request
// is judged by where it ends up, not by pattern-matching "..".
//
// root == "." (the common `salam serve` case, serving the current
// directory) needs its own branch: filepath.Clean(".") returns the
// literal "." but filepath.Clean drops "." segments from every other
// path it cleans, so a contained request like "src" cleans to "src",
// never to "./src" - the croot-prefix check below would never match it
// and every subpath would 404. Under root ".", any cleaned path that
// isn't an escape ("..", "../...") or OS-absolute is contained.
// The path under `root` that `rel` names, or "" if `rel` escapes it. Always
// returns a heap string the caller frees, "" included.
func _safe_static_path(root: str, rel: str): str:
    croot := filepath.Clean(root)
    joined := filepath.Join(croot, rel)
    cleaned := filepath.Clean(joined)
    mem.Free(joined as void *)
    mut ok := false
    if croot == ".":
        ok = true
        if cleaned == "..": ok = false end
        if str.StartsWith(cleaned, "../"): ok = false end
        if cleaned != "." && filepath.IsAbs(cleaned): ok = false end
    else cleaned == croot:
        ok = true
    else:
        // The trailing slash is what stops "/srv/wwwroot" passing as a path
        // under "/srv/www". It used to be checked with croot.concat("/"),
        // which allocated a string per request and dropped it.
        ok = _eq_at(cleaned, 0, croot) && _eq_at(cleaned, croot.len(), "/")
    end
    mem.Free(croot as void *)
    if ok: ret cleaned end
    mem.Free(cleaned as void *)
    ret str.Clone("")
end

// Renders a simple "Index of <path>" directory listing, like a plain dev
// HTTP file server. Entries are shown alphabetically, directories first,
// with a ".." link when not already at the served root.
func _dir_listing_html(url_path: str, disk_path: str): str:
    names := os.ListDir(disk_path)
    defer names.free()
    mut dirs := Vector {} as Vector<str>
    defer dirs.free()
    mut files := Vector {} as Vector<str>
    defer files.free()
    repeat names.len() with i:
        name := names.get(i)
        if os.IsDir(filepath.Join(disk_path, name)):
            dirs.push(name)
        else:
            files.push(name)
        end
    end
    _insertion_sort_strs(dirs)
    _insertion_sort_strs(files)
    mut rows := str.NewBuilder()
    defer str.BufFree(rows)
    if url_path != "/":
        str.BufAppend(rows, "<li><a href=\"../\">../</a></li>\n")
    end
    repeat dirs.len() with i:
        name := dirs.get(i)
        href := encoding.URLEncode(name)
        str.BufAppend(rows, `<li><a href="`)
        str.BufAppend(rows, href)
        str.BufAppend(rows, `/">`)
        str.BufAppend(rows, _html_escape(name))
        str.BufAppend(rows, "/</a></li>\n")
    end
    repeat files.len() with i:
        name := files.get(i)
        href := encoding.URLEncode(name)
        str.BufAppend(rows, `<li><a href="`)
        str.BufAppend(rows, href)
        str.BufAppend(rows, `">`)
        str.BufAppend(rows, _html_escape(name))
        str.BufAppend(rows, "</a></li>\n")
    end
    title := _html_escape(url_path)
    mut out := "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Index of "
    out = out.concat(title)
    out = out.concat("</title></head><body>\n<h1>Index of ")
    out = out.concat(title)
    out = out.concat("</h1>\n<ul>\n")
    out = out.concat(str.BufStr(rows))
    out = out.concat("</ul>\n</body></html>\n")
    ret out
end

// Tiny in-place insertion sort local to this package, to avoid pulling in
// a cross-package generic Vector<str> instantiation for a handful of
// directory entries.
func _insertion_sort_strs(v &: Vector<str>):
    n := v.len()
    repeat n with i:
        mut j := i
        // `until COND: ...` loops WHILE COND holds (see e.g. _parse_http's
        // "until pos < req.len()"), not "until COND becomes true" - the
        // condition here is deliberately the keep-shifting condition
        // (in-bounds AND out of order), not a stop condition.
        until j > 0 && v.get(j - 1) > v.get(j):
            a := v.get(j - 1)
            b := v.get(j)
            v.set(j - 1, b)
            v.set(j, a)
            j -= 1
        end
    end
end

func _log_access(slot: int, method: str, path: str, status: int):
    if _srv_log.get(slot) == false: ret end
    println method, path, "->", status
end

// Shared by both the plain and TLS handlers: parses the request, runs
// static-file/router dispatch, and returns the fully-serialized response
// (or "" when the static-file branch already streamed its own response
// straight to the transport and there is nothing left to send).
// Serves one request and writes its response. Sets `keep` to whether the
// connection may be reused afterwards; the caller owns the socket either way.
func _serve_request(slot: int, fd: i64, ctx: i64, req: str, keep &: bool): bool:
    if req.len() == 0:
        keep = false
        ret false
    end
    salam_ctx_reset(ctx)
    _parse_http(ctx, req)
    keep = _rc(ctx).keep_alive
    r := _srv_routers.get(slot)
    shdr := _srv_shdr.get(slot)
    mut static_handled := false
    if r.has_static:
        prefix := r.static_prefix
        path := salam_ctx_get(ctx, 1)
        if _eq_at(path, 0, prefix):
            relraw := path.substr(prefix.len(), path.len() - prefix.len())
            rel := UrlDecode(relraw)
            mem.Free(relraw as void *)
            target := _safe_static_path(r.static_dir, rel)
            mem.Free(rel as void *)
            if target.len() > 0:
                if os.IsDir(target):
                    idx := filepath.Join(target, "index.html")
                    if os.Exists(idx) && os.IsDir(idx) == false:
                        if _send_file(fd, idx, mime.MimeType(idx), shdr, keep) == 1:
                            _ctx_mark_sent(ctx)
                            static_handled = true
                        end
                    else r.static_listing:
                        salam_ctx_set_status(ctx, 200)
                        salam_ctx_set(ctx, 4, "text/html; charset=utf-8")
                        salam_ctx_set(ctx, 5, _ctx_own(ctx, _dir_listing_html(path, target)))
                        static_handled = true
                    end
                    mem.Free(idx as void *)
                else os.Exists(target):
                    if _send_file(fd, target, mime.MimeType(target), shdr, keep) == 1:
                        _ctx_mark_sent(ctx)
                        static_handled = true
                    end
                end
            end
            mem.Free(target as void *)
        end
    end
    if static_handled == false:
        dispatched := _dispatch(r, ctx)
        if dispatched == false:
            salam_ctx_set_status(ctx, 404)
            salam_ctx_set(ctx, 4, "text/plain; charset=utf-8")
            salam_ctx_set(ctx, 5, "404 Not Found")
        end
    end
    _log_access(slot, salam_ctx_get(ctx, 0), salam_ctx_get(ctx, 1), salam_ctx_get_status(ctx))
    if salam_ctx_is_sent(ctx) == 0:
        mut b := str.NewBuilder()
        _fill_response(b, ctx, shdr, keep)
        // Straight out of the builder: no BufStr copy, one write for headers
        // and body together.
        tcp.WriteBytes(tcp.ConnFromFd(fd), b.data, b.len as int)
        str.BufFree(b)
    end
    ret true
end

// One thread per connection, and now one connection for many requests.
//
// This used to be one thread per *request*: the handler read once, answered,
// closed, and exited, so every single GET cost a TCP handshake, a thread
// creation, a thread teardown and a four-way close. That is most of the work
// in serving a small response, and none of it is serving.
//
// TCP_NODELAY matters more once the connection is reused. Without it, a
// small response can sit in the kernel waiting for more data to coalesce
// with, and on a reused connection there is nothing behind it to coalesce
// with until the client's next request - which the client will not send
// until it has this response. Nagle plus delayed ACK turns that standoff
// into tens of milliseconds of latency on an otherwise idle link.
func _web_conn_handler(packed: i64):
    slot := _srv_slot_of(packed)
    fd := _srv_fd_of(packed)
    sock := rawsock.FromFd(fd)
    rawsock.SetNoDelay(sock, true)
    rawsock.SetTimeout(sock, _keepalive_idle_ms)
    scratch := mem.Allocate((_RD_CHUNK + 1) as u64)
    // One context for the whole connection; _serve_request resets it per
    // request rather than building a new one.
    ctx := salam_ctx_new(fd)
    mut pending := ""
    mut served := 0
    until 1 == 1:
        mut owned := false
        req := _read_request(fd, scratch, pending, owned)
        if req.len() == 0: break end
        mut keep := true
        ok := _serve_request(slot, fd, ctx, req, keep)
        if owned: mem.Free(req as void *) end
        if ok == false: break end
        served += 1
        if keep == false || served >= _keepalive_max_reqs: break end
    end
    // Whatever the peer pipelined behind the last request it will never get an
    // answer to, but the bytes are still this thread's to release.
    if pending.len() > 0: mem.Free(pending as void *) end
    salam_ctx_free(ctx)
    mem.Free(scratch)
    _net_close(fd)
end

// TLS variant of the connection handler: wraps the accepted fd in a
// server-side TLS 1.3 handshake (std/tls.WrapServer) before doing
// anything else, then reads/writes through the tls.Conn instead of the
// raw fd. Static files are read fully into memory and sent in one
// tls.Write rather than streamed in fixed chunks over the raw fd - TLS
// already segments its own records, so the streaming optimization
// _send_file relies on for plain connections doesn't carry the same
// value here, and doing it this way avoids a second chunked-file-over-
// TLS code path for what is, on the TLS listener, presumably a much
// smaller fraction of traffic than dynamic API responses.
//
// This duplicates _handle_request's static/dispatch decision tree
// rather than sharing it, because the static-file branch needs a
// different low-level write primitive (tls.Write vs the raw fd) at the
// exact point the decision is made - a real DRY gap, not an oversight;
// factoring it out cleanly needs the static-file decision separated
// from the static-file I/O, which is a slightly bigger refactor than
// this pass covers. Keep both branches in sync by hand until then.
func _web_tls_conn_handler(packed: i64):
    slot := _srv_slot_of(packed)
    fd := _srv_fd_of(packed)
    mut c := tls.WrapServer(fd, _srv_tls.get(slot))
    if !tls.ConnOk(c):
        tls.Close(c)
        ret
    end
    req := tls.Read(c, 32768)
    if req.len() == 0:
        mem.Free(req as void *)
        tls.Close(c)
        ret
    end
    ctx := salam_ctx_new(fd)
    defer salam_ctx_free(ctx)
    defer mem.Free(req as void *)
    _parse_http(ctx, req)
    r := _srv_routers.get(slot)
    shdr := _srv_shdr.get(slot)
    mut static_handled := false
    if r.has_static:
        prefix := r.static_prefix
        path := salam_ctx_get(ctx, 1)
        if _eq_at(path, 0, prefix):
            relraw := path.substr(prefix.len(), path.len() - prefix.len())
            rel := UrlDecode(relraw)
            mem.Free(relraw as void *)
            target := _safe_static_path(r.static_dir, rel)
            mem.Free(rel as void *)
            if target.len() > 0:
                if os.IsDir(target):
                    idx := filepath.Join(target, "index.html")
                    if os.Exists(idx) && os.IsDir(idx) == false:
                        _tls_send_file(c, idx, mime.MimeType(idx), shdr)
                        _ctx_mark_sent(ctx)
                        static_handled = true
                    else r.static_listing:
                        salam_ctx_set_status(ctx, 200)
                        salam_ctx_set(ctx, 4, "text/html; charset=utf-8")
                        salam_ctx_set(ctx, 5, _ctx_own(ctx, _dir_listing_html(path, target)))
                        static_handled = true
                    end
                    mem.Free(idx as void *)
                else os.Exists(target):
                    _tls_send_file(c, target, mime.MimeType(target), shdr)
                    _ctx_mark_sent(ctx)
                    static_handled = true
                end
            end
            mem.Free(target as void *)
        end
    end
    if static_handled == false:
        dispatched := _dispatch(r, ctx)
        if dispatched == false:
            salam_ctx_set_status(ctx, 404)
            salam_ctx_set(ctx, 4, "text/plain; charset=utf-8")
            salam_ctx_set(ctx, 5, "404 Not Found")
        end
    end
    _log_access(slot, salam_ctx_get(ctx, 0), salam_ctx_get(ctx, 1), salam_ctx_get_status(ctx))
    if salam_ctx_is_sent(ctx) == 0:
        resp := _build_response(ctx, shdr)
        tls.Write(c, resp)
        mem.Free(resp as void *)
    end
    tls.Close(c)
end

func _tls_send_file(c &: tls.Conn, path: str, ct: str, server_hdr: str):
    f := fopen(path, "rb")
    if f == null: ret end
    fseek(f, 0, 2)
    sz := ftell(f) as i64
    fseek(f, 0, 0)
    if sz < 0:
        fclose(f)
        ret
    end
    mut hdr := "HTTP/1.1 200 OK\r\nContent-Length: "
    hdr = hdr.concat(conv.FormatInt(sz))
    hdr = hdr.concat("\r\nContent-Type: ")
    hdr = hdr.concat(ct)
    hdr = hdr.concat("\r\nConnection: close\r\nServer: ")
    hdr = hdr.concat(server_hdr)
    hdr = hdr.concat("\r\nX-Powered-By: ")
    hdr = hdr.concat(server_hdr)
    hdr = hdr.concat("\r\n\r\n")
    tls.Write(c, hdr)
    buf := mem.Allocate((sz + 1) as u64)
    defer mem.Free(buf)
    got := fread(buf, 1 as u64, sz as u64, f)
    fclose(f)
    if got > (0 as u64):
        tls.WriteBytes(c, buf, got as int)
    end
end

@en "SetKeepAliveIdle"
@fa "تنظیم بیکاری زنده نگه داشتن"
@ar "تعیین خمول الاتصال"
pub func SetKeepAliveIdle(millis: int):
    _keepalive_idle_ms = millis
end

@en "SetKeepAliveMaxRequests"
@fa "بیشینه درخواست زنده نگه داشتن"
@ar "أقصی طلبات الاتصال"
pub func SetKeepAliveMaxRequests(n: int):
    _keepalive_max_reqs = n
end
