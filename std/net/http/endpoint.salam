package http

import mem
import str

@en "Endpoint"
@fa "نقطه پایانی"
pub struct Endpoint:
    @en "host"
    @fa "میزبان"
    pub host: str = ""
    @en "port"
    @fa "درگاه"
    pub port: int = 443
    @en "secure"
    @fa "امن"
    pub secure: bool = true
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
end

func _trim_value(head: str, start: int, stop: int): str:
    mut e := stop
    if e < 0 or e > head.Len(): e = head.Len() end
    if e <= start: ret "" end
    part := head.Substr(start, e - start)
    out := str.Trim(part)
    mem.Free(part as void*)
    ret out
end

@en "ParseEndpoint"
@fa "تجزیه نقطه پایانی"
pub func ParseEndpoint(endpoint: str): Endpoint:
    mut rest := endpoint
    mut secure := true
    mut port := 443
    if str.StartsWith(rest, "https://"): rest = rest.Substr(8, rest.Len() - 8)
    else str.StartsWith(rest, "http://"):
        rest = rest.Substr(7, rest.Len() - 7)
        secure = false
        port = 80
    else:
        ret Endpoint {}
    end
    slash := rest.Find("/")
    if slash >= 0: rest = rest.Substr(0, slash) end
    colon := rest.Find(":")
    if colon >= 0:
        port = rest.Substr(colon + 1, rest.Len() - colon - 1).ToInt()
        rest = rest.Substr(0, colon)
    end
    if rest.Len() == 0: ret Endpoint {} end
    ret Endpoint { host = rest, port = port, secure = secure, ok = true }
end

@en "HeaderValue"
@fa "مقدار سرصفحه"
pub func HeaderValue(head: str, name: str): str:
    lower := head.Lower()
    defer mem.Free(lower as void*)
    lower_name := name.Lower()
    defer mem.Free(lower_name as void*)
    needle := "\r\n" + lower_name + ":"
    defer mem.Free(needle as void*)
    at := lower.Find(needle)
    if at < 0: ret "" end
    start := at + needle.Len()
    ret _trim_value(head, start, str.IndexFrom(lower, "\r\n", start))
end

@en "Host"
@fa "میزبان"
pub func Host(e: Endpoint): str:
    ret e.host
end

@en "Port"
@fa "درگاه"
pub func Port(e: Endpoint): int:
    ret e.port
end

@en "Secure"
@fa "امن"
pub func Secure(e: Endpoint): bool:
    ret e.secure
end

@en "EndpointOk"
@fa "نقطه پایانی موفق"
pub func EndpointOk(e: Endpoint): bool:
    ret e.ok
end
