@en "net/http"
@fa "اچ تی تی پی"
package http

import mem
import str
import encoding
import compress
import net.internal.rawsock
import encoding.url
import tls
import sync

if SALAM_OS_WINDOWS and not SALAM_NATIVE_TLS:
    link dynamic "winhttp"
end

if SALAM_OS_WINDOWS and not SALAM_NATIVE_TLS:
    extern:
        func MultiByteToWideChar(codepage: u32, flags: u32, src: str, srclen: i32, dst: void*, dstlen: i32): i32
        func WideCharToMultiByte(codepage: u32, flags: u32, src: void*, srclen: i32, dst: void*, dstlen: i32, def: void*, used: void*): i32
        func WinHttpOpen(agent: void*, access_type: int, proxy: void*, bypass: void*, flags: int): void*
        func WinHttpConnect(session: void*, host: void*, port: int, flags: int): void*
        func WinHttpOpenRequest(conn: void*, verb: void*, path: void*, ver: void*, ref: void*, types: void*, flags: int): void*
        func WinHttpSendRequest(req: void*, headers: void*, hlen: int, body: str, blen: int, total: int, ctx: usize): int
        func WinHttpReceiveResponse(req: void*, reserved: void*): int
        func WinHttpQueryHeaders(req: void*, info: int, name: void*, buf: void*, buflen: void*, index: void*): int
        func WinHttpReadData(req: void*, buf: void*, toread: int, read: void*): int
        func WinHttpAddRequestHeaders(req: void*, headers: void*, hlen: int, modifiers: int): int
        func WinHttpCloseHandle(handle: void*): int
        func WinHttpSetOption(handle: void*, option: int, buf: void*, buflen: int): int
    end
end

const MAX_COOKIES := 256

struct _Reply:
    pub status: int = 0
    pub head: str = ""
    pub body: compress.ByteBuf = compress.ByteBuf {}
    pub err: str = ""
    pub url: str = ""
end

@en "Response"
@fa "پاسخ"
pub struct Response:
    pub status: int = 0
    pub body: str = ""
    pub head: str = ""
    pub err: str = ""
    pub url: str = ""
end

@en "BytesResponse"
@fa "پاسخ بایتی"
pub struct BytesResponse:
    pub status: int = 0
    pub head: str = ""
    pub body: compress.ByteBuf = compress.ByteBuf {}
    pub err: str = ""
    pub url: str = ""
end

@en "RequestOptions"
@fa "گزینه های درخواست"
pub struct RequestOptions:
    pub idle_ms: int = 30000
    pub timeout_ms: int = 0
    pub max_body: int = 268435456
    pub max_redirects: int = 0
end

@en "Client"
@fa "کارخواه"
pub struct Client:
    pub cookies: HashMap<str, str> = HashMap {} as HashMap<str, str>
    pub headers: HashMap<str, str> = HashMap {} as HashMap<str, str>
    pub cookie_hosts: HashMap<str, str> = HashMap {} as HashMap<str, str>
    pub options: RequestOptions = RequestOptions {}
    pub mu: sync.Mutex = sync.Mutex {}

    func _lock():
        if this.mu.handle != null: sync.Lock(this.mu) end
    end

    func _unlock():
        if this.mu.handle != null: sync.Unlock(this.mu) end
    end

    @en "SetHeader"
    @fa "تنظیم سرصفحه"
    pub func SetHeader(name: str, value: str):
        this._lock()
        this.headers.put(name, value)
        this._unlock()
    end

    @en "SetCookie"
    @fa "تنظیم کوکی"
    pub func SetCookie(name: str, value: str):
        this._lock()
        this.cookies.put(name, value)
        this.cookie_hosts.remove(name)
        this._unlock()
    end

    @en "ClearCookies"
    @fa "پاک کردن کوکی ها"
    pub func ClearCookies():
        this._lock()
        this.cookies = HashMap {} as HashMap<str, str>
        this.cookie_hosts = HashMap {} as HashMap<str, str>
        this._unlock()
    end

    @en "SetTimeout"
    @fa "تنظیم مهلت"
    pub func SetTimeout(total_ms: int):
        this._lock()
        this.options.timeout_ms = total_ms
        this._unlock()
    end

    @en "SetIdleTimeout"
    @fa "تنظیم مهلت بیکاری"
    pub func SetIdleTimeout(idle_ms: int):
        this._lock()
        this.options.idle_ms = idle_ms
        this._unlock()
    end

    @en "SetMaxRedirects"
    @fa "تنظیم سقف تغییر مسیر"
    pub func SetMaxRedirects(n: int):
        this._lock()
        this.options.max_redirects = n
        this._unlock()
    end

    @en "SetMaxBody"
    @fa "تنظیم سقف بدنه"
    pub func SetMaxBody(bytes: int):
        this._lock()
        if bytes > 0: this.options.max_body = bytes end
        this._unlock()
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        if this.mu.handle != null: sync.Destroy(this.mu) end
        this.mu = sync.Mutex {}
        this.cookies.free()
        this.headers.free()
        this.cookie_hosts.free()
    end

    func _opts(): RequestOptions:
        this._lock()
        o := this.options
        this._unlock()
        ret o
    end

    func _host_cookies(host: str, orig_host: str): str:
        if this.cookies.size() == 0: ret "" end
        mut out := ""
        it := this.cookies.iter()
        until it.has_next():
            name := it.key()
            value := it.value()
            mut owner := ""
            if this.cookie_hosts.has(name): owner = this.cookie_hosts.get(name) end
            mut allow := owner == host
            if owner.len() == 0: allow = host == orig_host end
            if allow and _token_ok(name) and not _has_control(value) and value.find(";") < 0:
                if out.len() > 0: out = out.concat("; ") end
                out = out.concat(name).concat("=").concat(value)
            end
            it.next()
        end
        ret out
    end

    func _jar_block(host: str, orig_host: str, user_block: str, bad &: str): str:
        cross := host != orig_host
        if this.mu.handle != null: sync.Lock(this.mu) end
        base := _block_of(this.headers, bad)
        ck := this._host_cookies(host, orig_host)
        if this.mu.handle != null: sync.Unlock(this.mu) end
        if bad.len() > 0: ret "" end
        mut out := base
        if cross: out = _strip_sensitive(out) end
        if ck.len() > 0:
            out = out.concat("Cookie: ").concat(ck).concat("\r\n")
        end
        if user_block.len() > 0:
            if cross:
                out = out.concat(_strip_sensitive(user_block))
            else:
                out = out.concat(user_block)
            end
        end
        ret out
    end

    func _jar_absorb(host: str, head: str):
        r := Response { head = head }
        lines := HeaderValues(r, "Set-Cookie")
        defer lines.free()
        if lines.len() > 0:
            if this.mu.handle != null: sync.Lock(this.mu) end
            each line in lines:
                semi := line.find(";")
                mut pair := line
                mut attrs := ""
                if semi >= 0:
                    pair = line.substr(0, semi)
                    attrs = str.Replace(str.Lower(line.substr(semi, line.len() - semi)), " ", "")
                end
                eqp := pair.find("=")
                if eqp > 0:
                    name := pair.substr(0, eqp).trim()
                    value := pair.substr(eqp + 1, pair.len() - eqp - 1).trim()
                    gone := str.Contains(attrs, ";max-age=0") or str.Contains(attrs, ";max-age=-")
                    if gone:
                        this.cookies.remove(name)
                        this.cookie_hosts.remove(name)
                    else _token_ok(name) and not _has_control(value):
                        if this.cookies.has(name) or this.cookies.size() < MAX_COOKIES:
                            this.cookies.put(name, value)
                            this.cookie_hosts.put(name, host)
                        end
                    end
                end
            end
            if this.mu.handle != null: sync.Unlock(this.mu) end
        end
    end

    func _run(method_in: str, url_str: str, block: str, body: str, o: RequestOptions): _Reply:
        method := str.Upper(method_in)
        e := _check_request(method, url_str, block)
        if e.len() > 0: ret _Reply { err = e, url = url_str } end
        mut deadline := 0 as i64
        if o.timeout_ms > 0: deadline = sync.NowMs() + (o.timeout_ms as i64) end
        mut cur_url := url_str
        mut cur_method := method
        mut cur_body := body
        mut cur_block := block
        first := url.Parse(url_str)
        orig_host := str.Lower(first.host)
        mut hops := 0
        until true:
            u := url.Parse(cur_url)
            se := _scheme_ok(u)
            if se.len() > 0: ret _Reply { err = se, url = cur_url } end
            mut total_ms := 0
            if deadline > 0:
                left := deadline - sync.NowMs()
                if left <= 0: ret _Reply { err = "the request timed out", url = cur_url } end
                total_ms = left as int
            end
            mut bad := ""
            mut hop_block := this._jar_block(str.Lower(u.host), orig_host, cur_block, bad)
            if bad.len() > 0: ret _Reply { err = bad, url = cur_url } end
            if cur_body.len() == 0 and (cur_method == "GET" or cur_method == "HEAD"):
                hop_block = _strip_body_headers(hop_block)
            else cur_body.len() > 0 and _header_at(hop_block, "Content-Type") < 0:
                hop_block = hop_block.concat("Content-Type: application/x-www-form-urlencoded\r\n")
            end
            mut rep := _hop(cur_method, u, hop_block, cur_body, total_ms, o)
            if rep.err.len() == 0: this._jar_absorb(str.Lower(u.host), rep.head) end
            loc := _redirect_target(rep)
            if rep.err.len() > 0 or loc.len() == 0 or o.max_redirects <= 0:
                ret _finish(rep, o, cur_url)
            end
            compress.BufFree(rep.body)
            if hops >= o.max_redirects:
                ret _Reply { status = rep.status, head = rep.head, err = "stopped after " + hops + " redirects", url = cur_url }
            end
            if _has_space_or_control(loc):
                ret _Reply { status = rep.status, head = rep.head, err = "the redirect target is not a valid URL", url = cur_url }
            end
            next := url.Join(u, loc)
            ne := _scheme_ok(next)
            if ne.len() > 0:
                ret _Reply { status = rep.status, head = rep.head, err = "redirect: " + ne, url = cur_url }
            end
            if str.Lower(u.scheme) == "https" and str.Lower(next.scheme) == "http":
                ret _Reply { status = rep.status, head = rep.head, err = "refusing to follow a redirect from https to http", url = cur_url }
            end
            if _origin_of(u) != _origin_of(next): cur_block = _strip_sensitive(cur_block) end
            s := rep.status
            if s == 303 or ((s == 301 or s == 302) and cur_method == "POST"):
                if cur_method != "HEAD": cur_method = "GET" end
                cur_body = ""
                cur_block = _strip_body_headers(cur_block)
            end
            cur_url = url.String(next)
            hops += 1
        end
    end

    @en "Request"
    @fa "درخواست"
    pub func Request(method: str, url: str, body: str): Response:
        ret _as_response(this._run(method, url, "", body, this._opts()))
    end

    @en "RequestRaw"
    @fa "درخواست خام"
    pub func RequestRaw(method: str, url: str, header_block: str, body: str): Response:
        ret _as_response(this._run(method, url, header_block, body, this._opts()))
    end

    @en "RequestBytes"
    @fa "درخواست بایتی"
    pub func RequestBytes(method: str, url: str, header_block: str, body: str): BytesResponse:
        rep := this._run(method, url, header_block, body, this._opts())
        ret BytesResponse { status = rep.status, head = rep.head, body = rep.body, err = rep.err, url = rep.url }
    end

    @en "RequestWith"
    @fa "درخواست با"
    pub func RequestWith(method: str, url: str, body: str, extra: HashMap<str, str>): Response:
        mut bad := ""
        block := _block_of(extra, bad)
        if bad.len() > 0: ret Response { err = bad, url = url } end
        ret _as_response(this._run(method, url, block, body, this._opts()))
    end

    @en "Get"
    @fa "دریافت"
    pub func Get(url: str): Response: ret this.Request("GET", url, "") end

    @en "Post"
    @fa "ارسال"
    pub func Post(url: str, body: str): Response: ret this.Request("POST", url, body) end

    @en "Put"
    @fa "قرار دادن"
    pub func Put(url: str, body: str): Response: ret this.Request("PUT", url, body) end

    @en "Delete"
    @fa "حذف"
    pub func Delete(url: str): Response: ret this.Request("DELETE", url, "") end

    @en "Patch"
    @fa "وصله"
    pub func Patch(url: str, body: str): Response: ret this.Request("PATCH", url, body) end

    @en "Options"
    @fa "گزینه ها"
    pub func Options(url: str): Response: ret this.Request("OPTIONS", url, "") end

    @en "Head"
    @fa "درخواست هد"
    pub func Head(url: str): Response: ret this.Request("HEAD", url, "") end
end

func _hdr_lower(s: str): str:
    ret str.Lower(s)
end

func _header_at(headers: str, name: str): int:
    if headers.len() == 0:
        ret 0 - 1
    end
    lower := str.Lower(headers)
    key := str.Lower(name).concat(":")
    if str.StartsWith(lower, key):
        ret 0
    end
    nl := str.Find(lower, "\r\n".concat(key))
    if nl < 0:
        ret 0 - 1
    end
    ret nl + 2
end

func _header_value(headers: str, name: str, fallback: str): str:
    at := _header_at(headers, name)
    if at < 0:
        ret fallback
    end
    start := at + name.len() + 1
    mut stop := str.IndexFrom(headers, "\r\n", start)
    if stop < 0:
        stop = headers.len()
    end
    value := str.Trim(headers.substr(start, stop - start))
    if value.len() == 0:
        ret fallback
    end
    ret value
end

func _has_control(s: str): bool:
    bp := s as u8*
    repeat s.len() in i:
        c := bp[i] as int
        if c < 32 or c == 127: ret true end
    end
    ret false
end

func _has_space_or_control(s: str): bool:
    bp := s as u8*
    repeat s.len() in i:
        c := bp[i] as int
        if c <= 32 or c == 127: ret true end
    end
    ret false
end

func _token_ok(s: str): bool:
    if s.len() == 0: ret false end
    bp := s as u8*
    repeat s.len() in i:
        c := bp[i] as int
        if c <= 32 or c >= 127: ret false end
        if c == 58 or c == 34 or c == 40 or c == 41 or c == 44 or c == 47 or c == 59 or c == 60 or c == 61 or c == 62 or c == 63 or c == 64 or c == 91 or c == 92 or c == 93 or c == 123 or c == 125:
            ret false
        end
    end
    ret true
end

func _check_block(block: str): str:
    if block.len() == 0: ret "" end
    lines := str.Split(block, "\r\n")
    defer lines.free()
    each line in lines:
        if line.len() > 0:
            if _has_control(line): ret "a header contains a control character" end
            colon := line.find(":")
            if colon <= 0: ret "a header line has no name: " + line end
            if not _token_ok(line.substr(0, colon)):
                ret "invalid header name: " + line.substr(0, colon)
            end
        end
    end
    ret ""
end

func _block_of(headers: HashMap<str, str>, bad &: str): str:
    mut out := ""
    it := headers.iter()
    until it.has_next():
        if not _token_ok(it.key()):
            bad = "invalid header name: " + it.key()
            ret ""
        end
        if _has_control(it.value()):
            bad = "the value of header " + it.key() + " contains a control character"
            ret ""
        end
        out = out.concat(it.key()).concat(": ").concat(it.value()).concat("\r\n")
        it.next()
    end
    ret out
end

func _drop_transport_headers(headers: str): str:
    if headers.len() == 0:
        ret ""
    end
    lines := str.Split(headers, "\r\n")
    defer lines.free()
    mut out := ""
    each line in lines:
        low := str.Lower(line)
        mut keep := line.len() > 0
        if str.StartsWith(low, "accept-encoding:") or str.StartsWith(low, "connection:") or str.StartsWith(low, "content-length:") or str.StartsWith(low, "transfer-encoding:") or str.StartsWith(low, "host:"):
            keep = false
        end
        if keep:
            out = out.concat(line).concat("\r\n")
        end
    end
    ret out
end

func _is_sensitive(low: str): bool:
    ret str.StartsWith(low, "authorization:") or str.StartsWith(low, "cookie:") or str.StartsWith(low, "proxy-authorization:") or str.StartsWith(low, "private-token:")
end

func _strip_sensitive(headers: str): str:
    if headers.len() == 0: ret "" end
    lines := str.Split(headers, "\r\n")
    defer lines.free()
    mut out := ""
    each line in lines:
        if line.len() > 0 and not _is_sensitive(str.Lower(line)):
            out = out.concat(line).concat("\r\n")
        end
    end
    ret out
end

func _strip_body_headers(headers: str): str:
    if headers.len() == 0: ret "" end
    lines := str.Split(headers, "\r\n")
    defer lines.free()
    mut out := ""
    each line in lines:
        low := str.Lower(line)
        if line.len() > 0 and not str.StartsWith(low, "content-type:") and not str.StartsWith(low, "content-length:"):
            out = out.concat(line).concat("\r\n")
        end
    end
    ret out
end

func _request_target(u: url.URL): str:
    mut path := u.path
    if path.len() == 0:
        path = "/"
    end
    if u.raw_query.len() > 0:
        ret path + "?" + u.raw_query
    end
    ret path
end

func _host_header(u: url.URL): str:
    mut h := u.host
    if h.find(":") >= 0:
        h = "[" + h + "]"
    end
    if u.port == 0:
        ret h
    end
    if u.port == 80 and str.Equals(str.Lower(u.scheme), "http"):
        ret h
    end
    if u.port == 443 and str.Equals(str.Lower(u.scheme), "https"):
        ret h
    end
    ret h.concat(":").concat(str.FromInt(u.port as i64))
end

func _build_head(method: str, u: url.URL, raw_headers: str, body_len: int): str:
    target := _request_target(u)
    headers := _drop_transport_headers(raw_headers)
    mut host := _header_value(raw_headers, "Host", "")
    if host.len() == 0:
        host = _host_header(u)
    end
    mut req := method.concat(" ").concat(target).concat(" HTTP/1.1\r\nHost: ")
    req = req.concat(host).concat("\r\n")
    if _header_at(headers, "User-Agent") < 0:
        req = req.concat("User-Agent: Salam/1.0\r\n")
    end
    if _header_at(headers, "Accept") < 0:
        req = req.concat("Accept: */*\r\n")
    end
    req = req.concat("Accept-Encoding: gzip\r\nConnection: close\r\n")
    if headers.len() > 0:
        req = req.concat(headers)
    end
    if body_len > 0 or method == "POST" or method == "PUT" or method == "PATCH":
        req = req.concat("Content-Length: ").concat(str.FromInt(body_len as i64)).concat("\r\n")
    end
    ret req.concat("\r\n")
end

func _port_of(u: url.URL): int:
    if u.port != 0: ret u.port end
    if str.Equals(str.Lower(u.scheme), "http"): ret 80 end
    ret 443
end

func _origin_of(u: url.URL): str:
    ret str.Lower(u.scheme) + "://" + str.Lower(u.host) + ":" + _port_of(u)
end

func _check_request(method: str, url_str: str, block: str): str:
    if not _token_ok(method): ret "invalid request method" end
    if url_str.len() == 0: ret "no URL" end
    if _has_space_or_control(url_str): ret "the URL contains a space or a control character" end
    ret _check_block(block)
end

func _scheme_ok(u: url.URL): str:
    low := str.Lower(u.scheme)
    if low != "http" and low != "https":
        if u.scheme.len() == 0: ret "the URL has no scheme" end
        ret "unsupported URL scheme '" + u.scheme + "'"
    end
    if u.host.len() == 0: ret "no host in URL" end
    ret ""
end

func _redirect_target(rep: _Reply): str:
    s := rep.status
    if s != 301 and s != 302 and s != 303 and s != 307 and s != 308: ret "" end
    ret HeaderValue(rep.head, "Location")
end

func _finish(rep: _Reply, o: RequestOptions, url_str: str): _Reply:
    mut out := rep
    out.url = url_str
    if out.err.len() > 0: ret out end
    enc := HeaderValue(out.head, "Content-Encoding").lower()
    if out.body.len > 0 and str.Contains(enc, "gzip"):
        mut ok := false
        plain := compress.GzipDecompressMax(out.body.data, out.body.len, o.max_body, ok)
        compress.BufFree(out.body)
        if not ok:
            mut dead := plain
            compress.BufFree(dead)
            out.err = "the gzip body could not be decoded or is larger than the " + o.max_body + "-byte limit"
            out.body = compress.NewByteBuf()
            ret out
        end
        out.body = plain
    end
    if out.body.len > o.max_body:
        compress.BufFree(out.body)
        out.body = compress.NewByteBuf()
        out.err = "the response body is larger than the " + o.max_body + "-byte limit"
    end
    ret out
end

func _as_response(rep: _Reply): Response:
    mut r := Response { status = rep.status, head = rep.head, err = rep.err, url = rep.url }
    mut buf := rep.body
    r.body = compress.BufToStrUnsafe(buf)
    compress.BufFree(buf)
    ret r
end

if SALAM_OS_WINDOWS and not SALAM_NATIVE_TLS:
    func _make_str(buf: void*, len: int): str:
        if buf == null or len <= 0:
            ret ""
        end
        dst := mem.Allocate((len + 1) as u64)
        mem.Set(dst, 0, (len + 1) as u64)
        mem.Copy(dst, buf, len as u64)
        ret dst as str
    end

    func _str_to_wide(s: str): void*:
        n := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
        if n <= 0:
            ret mem.Allocate(2 as u64)
        end
        w := mem.Allocate((n * 2) as u64)
        MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, w, n)
        ret w
    end

    func _wide_to_str(w: void*): str:
        if w == null: ret "" end
        n := WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, null, 0, null, null)
        if n <= 0: ret "" end
        buf := mem.Allocate(n as u64)
        WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, buf, n, null, null)
        ret _make_str(buf, n - 1)
    end

    func _hop(method: str, u: url.URL, raw_headers: str, body: str, total_ms: int, o: RequestOptions): _Reply:
        headers := _drop_transport_headers(raw_headers)
        secure := str.Lower(u.scheme) == "https"
        wagent := _str_to_wide(_header_value(headers, "User-Agent", "Salam/1.0"))
        sess := WinHttpOpen(wagent, 0, null, null, 0)
        mem.Free(wagent)
        if sess == null: ret _Reply { err = "could not open an HTTP session" } end
        defer WinHttpCloseHandle(sess)
        whost := _str_to_wide(u.host)
        conn := WinHttpConnect(sess, whost, _port_of(u), 0)
        mem.Free(whost)
        if conn == null:
            ret _Reply { err = "could not connect to " + u.host }
        end
        defer WinHttpCloseHandle(conn)
        mut req_flags := 0
        if secure: req_flags = 8388608 end
        wverb := _str_to_wide(method)
        wpath := _str_to_wide(_request_target(u))
        req := WinHttpOpenRequest(conn, wverb, wpath, null, null, null, req_flags)
        mem.Free(wverb)
        mem.Free(wpath)
        if req == null:
            ret _Reply { err = "could not open the request" }
        end
        defer WinHttpCloseHandle(req)
        off := mem.Allocate(4 as u64)
        o32 := off as int*
        o32[0] = 2
        WinHttpSetOption(req, 63, off, 4)
        mem.Free(off)
        if headers.len() > 0:
            wh := _str_to_wide(headers)
            WinHttpAddRequestHeaders(req, wh, 0 - 1, 805306368)
            mem.Free(wh)
        end
        blen := body.len()
        sent := WinHttpSendRequest(req, null, 0, body, blen, blen, 0 as usize)
        if sent == 0:
            ret _Reply { err = "could not send the request" }
        end
        recv_ok := WinHttpReceiveResponse(req, null)
        if recv_ok == 0:
            ret _Reply { err = "the server did not answer" }
        end
        mut hlen := mem.Allocate(8 as u64) as i64*
        defer mem.Free(hlen as void*)
        hlen[0] = 0
        WinHttpQueryHeaders(req, 22, null, null, hlen as void*, null)
        hsize := hlen[0] as int
        mut hdr_str := "HTTP/1.1 0 \r\n\r\n"
        if hsize > 0:
            wh := mem.Allocate((hsize + 4) as u64)
            q2 := WinHttpQueryHeaders(req, 22, null, wh, hlen as void*, null)
            if q2 != 0:
                hdr_str = _wide_to_str(wh)
            end
            mem.Free(wh)
        end
        hend := hdr_str.len() - 4
        if hend < 0 or hdr_str.substr(hend, 4) != "\r\n\r\n":
            hdr_str = hdr_str.concat("\r\n\r\n")
        end
        buf := mem.Allocate(2050 as u64)
        defer mem.Free(buf)
        mut got := mem.Allocate(8 as u64) as i64*
        defer mem.Free(got as void*)
        mut out := _Reply { status = _status_of(hdr_str), head = hdr_str, body = compress.NewByteBuf() }
        mut reading := true
        until reading:
            got[0] = 0
            rd_ok := WinHttpReadData(req, buf, 2048, got as void*)
            if rd_ok == 0 or got[0] == 0:
                reading = false
            else:
                compress.BufPushBytes(out.body, buf, got[0] as int)
                if out.body.len > o.max_body + 65536:
                    compress.BufFree(out.body)
                    out.err = "the response body is larger than the " + o.max_body + "-byte limit"
                    reading = false
                end
            end
        end
        ret out
    end
else:
    func _hop(method: str, u: url.URL, raw_headers: str, body: str, total_ms: int, o: RequestOptions): _Reply:
        ep := Endpoint { host = u.host, port = _port_of(u), secure = str.Lower(u.scheme) == "https", ok = u.host.len() > 0 }
        head := _build_head(method, u, raw_headers, body.len())
        mut r := RawResponse {}
        if body.len() == 0:
            r = _raw_send(ep, head, null, 0, o.idle_ms, total_ms, o.max_body + RAW_HEAD_LIMIT, tls.NewConfig(u.host))
        else:
            r = _raw_send(ep, head, body as void*, body.len(), o.idle_ms, total_ms, o.max_body + RAW_HEAD_LIMIT, tls.NewConfig(u.host))
        end
        if r.error.len() > 0: ret _Reply { err = r.error } end
        mut out := _Reply { status = r.status, head = r.head, body = compress.NewByteBuf() }
        compress.BufPushBytes(out.body, r.data, r.len)
        FreeRaw(r)
        ret out
    end
end

func _status_of(head: str): int:
    sp := head.find(" ")
    if sp < 0: ret 0 end
    ret head.substr(sp + 1, 3).to_int()
end

func _simple(method: str, url_str: str, block: str, body: str): Response:
    mut c := Client {}
    defer c.Free()
    ret c.RequestRaw(method, url_str, block, body)
end

func _simple_with(method: str, url_str: str, headers: HashMap<str, str>, body: str): Response:
    mut bad := ""
    block := _block_of(headers, bad)
    if bad.len() > 0: ret Response { err = bad, url = url_str } end
    ret _simple(method, url_str, block, body)
end

@en "NewHeaders"
@fa "سرصفحه جدید"
pub func NewHeaders(): HashMap<str, str>:
    m := HashMap {} as HashMap<str, str> ret m
end

@en "Get"
@fa "دریافت"
