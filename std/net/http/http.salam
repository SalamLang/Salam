end

@en "GetBytesWith"
@fa "دریافت بایت ها با"
pub func GetBytesWith(url: str, headers: HashMap<str, str>): BytesResponse:
    mut bad := ""
    block := _block_of(headers, bad)
    if bad.len() > 0: ret BytesResponse { err = bad, url = url } end
    mut c := Client {}
    defer c.Free()
    ret c.RequestBytes("GET", url, block, "")
end

@en "Do"
@fa "انجام درخواست"
pub func Do(method: str, url: str, headers: HashMap<str, str>, body: str, opts: RequestOptions): Response:
    mut bad := ""
    block := _block_of(headers, bad)
    if bad.len() > 0: ret Response { err = bad, url = url } end
    mut c := Client { options = opts }
    defer c.Free()
    ret c.RequestRaw(method, url, block, body)
end

@en "Ok"
@fa "موفق"
pub func Ok(r: Response): bool:
    ret r.status >= 200 and r.status < 300
end

@en "Status"
@fa "وضعیت"
pub func Status(r: Response): int:
    ret r.status
end

@en "Body"
@fa "بدنه"
pub func Body(r: Response): str:
    ret r.body
end

@en "Error"
@fa "خطا"
pub func Error(r: Response): str:
    ret r.err
end

@en "Headers"
@fa "سرصفحه ها"
pub func Headers(r: Response): HashMap<str, str>:
    m := HashMap {} as HashMap<str, str> lines := r.head.split("\r\n")
    defer lines.free()
    repeat lines.len() in i:
        line := lines.get(i)
        c := line.find(":")
        if c > 0:
            key := line.substr(0, c)
            val := line.substr(c + 1, line.len() - c - 1)
            m.put(key, val.trim())
        end
    end
    ret m
end

@en "GetHeader"
@fa "دریافت سرصفحه"
pub func GetHeader(r: Response, name: str): str:
    target := _hdr_lower(name)
    lines := r.head.split("\r\n")
    defer lines.free()
    mut result := ""
    mut found := false
    repeat lines.len() in i:
        if found == false:
            line := lines.get(i)
            c := line.find(":")
            if c > 0:
                if _hdr_lower(line.substr(0, c)) == target:
                    result = line.substr(c + 1, line.len() - c - 1).trim()
                    found = true
                end
            end
        end
    end
    ret result
end

@en "Raw"
@fa "خام"
pub func Raw(r: Response): str:
    ret r.head.concat(r.body)
end

@en "RawHeaders"
@fa "سرصفحه های خام"
pub func RawHeaders(r: Response): str:
    ret r.head
end

@en "HeaderValues"
@fa "مقادیر سرصفحه"
pub func HeaderValues(r: Response, name: str): Vector<str>:
    target := _hdr_lower(name)
    out := Vector {} as Vector<str>
    lines := r.head.split("\r\n")
    defer lines.free()
    repeat lines.len() in i:
        line := lines.get(i)
        c := line.find(":")
        if c > 0:
            if _hdr_lower(line.substr(0, c)) == target:
                out.push(line.substr(c + 1, line.len() - c - 1).trim())
            end
        end
    end
    ret out
end

