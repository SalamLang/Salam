@en "middleware"
@fa "میان افزار"
@ar "برمجیة وسیطة"
package middleware

import net.http
import conv

@en "Log"
@fa "ثبت رخداد"
@ar "سجل"
pub func Log(ctx: i64):
    println "[HTTP]", http.Ctx_method(ctx), http.Ctx_path(ctx)
end

@en "AllowAll"
@fa "اجازه به همه"
@ar "السماح للجمیع"
pub func AllowAll(ctx: i64):
    http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
    http.Ctx_set_header(ctx, "Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
    http.Ctx_set_header(ctx, "Access-Control-Allow-Headers", "Content-Type, Authorization")
end

@en "Secure"
@fa "امن"
@ar "آمن"
pub func Secure(ctx: i64):
    http.Ctx_set_header(ctx, "X-Content-Type-Options", "nosniff")
    http.Ctx_set_header(ctx, "X-Frame-Options", "DENY")
    http.Ctx_set_header(ctx, "X-XSS-Protection", "1; mode=block")
end

@en "NoCache"
@fa "بدون کش"
@ar "بدون تخزین مؤقت"
pub func NoCache(ctx: i64):
    http.Ctx_set_header(ctx, "Cache-Control", "no-store, no-cache, must-revalidate")
    http.Ctx_set_header(ctx, "Pragma", "no-cache")
end

@en "Cache"
@fa "کش"
@ar "تخزین مؤقت"
pub func Cache(ctx: i64, seconds: int):
    http.Ctx_set_header(ctx, "Cache-Control", "max-age=" + conv.FormatInt(seconds as i64))
end
