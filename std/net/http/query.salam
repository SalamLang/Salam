package http

func _ud_hex(code: int): int:
    if code >= 48 and code <= 57: ret code - 48 end
    if code >= 65 and code <= 70: ret code - 55 end
    if code >= 97 and code <= 102: ret code - 87 end
    ret 0 - 1
end

@en "UrlDecode"
@fa "رمزگشایی نشانی"
pub func UrlDecode(s: str): str:
    n := s.len()
    bp := (s as void*) as i8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        code := (bp[i] as int) & 255
        if code == 37 and i + 2 < n and _ud_hex((bp[i + 1] as int) & 255) >= 0 and _ud_hex((bp[i + 2] as int) & 255) >= 0:
            str.BufAppendChar(sb, _ud_hex((bp[i + 1] as int) & 255) * 16 + _ud_hex((bp[i + 2] as int) & 255))
            i += 3
        else code == 43:
            str.BufAppendChar(sb, 32)
            i++
        else:
            str.BufAppendChar(sb, code)
            i++
        end
    end
    out := str.BufStr(sb)
    ret out
end
