package swagger

import net.router
import str
import conv

func _op_label(o: Op): str:
    ret o.method.concat(" ").concat(o.pattern)
end

func _has_scheme(d: Doc, name: str): bool:
    repeat d.schemes.len() with i:
        if str.Equals(d.schemes.get(i).name, name):
            ret true
        end
    end
    ret false
end

func _param_named(o: Op, name: str, loc: str): bool:
    repeat o.params.len() with i:
        p := o.params.get(i)
        if str.Equals(p.name, name) && str.Equals(p.loc, loc):
            ret true
        end
    end
    ret false
end

func _op_id_of(o: Op): str:
    ret o.op_id.len() > 0 ? o.op_id : _default_op_id(o.method, o.pattern)
end

func _bodyless(method: str): bool:
    ret str.Equals(method, "GET") || str.Equals(method, "HEAD")
end

func _check_security(d: Doc, o: Op, out &: Vector<str>):
    repeat o.security.len() with i:
        name := o.security.get(i)
        if !_has_scheme(d, name):
            out.push(
                _op_label(o).concat(": needs security scheme '").concat(name).concat("', which no BearerAuth or ApiKeyAuth declared")
            )
        end
    end
end

func _check_path_params(o: Op, out &: Vector<str>):
    declared := _path_params(o.pattern)
    defer declared.free()
    repeat declared.len() with i:
        name := declared.get(i).name
        if !_param_named(o, name, "path"):
            out.push(
                _op_label(o).concat(": the path has '{").concat(name).concat("}' but the operation does not declare it")
            )
        end
    end
    repeat o.params.len() with j:
        p := o.params.get(j)
        if !str.Equals(p.loc, "path"):
            continue
        end
        mut found := false
        repeat declared.len() with k:
            if str.Equals(declared.get(k).name, p.name):
                found = true
            end
        end
        if !found:
            out.push(
                _op_label(o).concat(": declares path parameter '").concat(p.name).concat("', which the path does not contain")
            )
        end
        if !p.required:
            out.push(
                _op_label(o).concat(": path parameter '").concat(p.name).concat("' is optional, and a path parameter cannot be")
            )
        end
    end
end

func _check_replies(o: Op, out &: Vector<str>):
    repeat o.replies.len() with i:
        code := o.replies.get(i).code
        if code < 100 || code > 599:
            out.push(
                _op_label(o).concat(": ").concat(conv.FormatInt(code as i64)).concat(" is not an HTTP status code")
            )
        end
    end
end

@en "Problems"
@fa "مشکلات"
pub func Problems(d: Doc): Vector<str>:
    mut out := Vector {} as Vector<str>
    if d.title.len() == 0:
        out.push("the document has no title")
    end
    if d.version.len() == 0:
        out.push("the document has no version")
    end
    mut ids := Vector {} as Vector<str>
    defer ids.free()
    repeat d.ops.len() with i:
        o := d.ops.get(i)
        _check_security(d, o, out)
        _check_path_params(o, out)
        _check_replies(o, out)
        if o.body_schema.len() > 0 && _bodyless(o.method):
            out.push(
                _op_label(o).concat(
                    ": has a request body, and nothing between the client and the" + " handler will carry one on this method"
                )
            )
        end
        id := _op_id_of(o)
        repeat ids.len() with j:
            if str.Equals(ids.get(j), id):
                out.push(
                    _op_label(o).concat(": operationId '").concat(id).concat("' is already used by another operation")
                )
            end
        end
        ids.push(id)
    end
    ret out
end

@en "Undocumented"
@fa "توضیح داده نشده"
pub func Undocumented(d: Doc): Vector<str>:
    mut out := Vector {} as Vector<str>
    repeat d.ops.len() with i:
        o := d.ops.get(i)
        if o.summary.len() == 0 && o.description.len() == 0 && o.replies.len() == 0:
            out.push(_op_label(o))
        end
    end
    ret out
end

@en "Missing"
@fa "جا افتاده"
pub func Missing(d: Doc, r: router.Router): Vector<str>:
    mut out := Vector {} as Vector<str>
    repeat r.routes.len() with i:
        rt := r.routes.get(i)
        if _is_own_route(rt.fn):
            continue
        end
        mut found := false
        repeat d.ops.len() with j:
            o := d.ops.get(j)
            if str.Equals(o.method, rt.method) && str.Equals(o.pattern, rt.pattern):
                found = true
            end
        end
        if !found:
            out.push(rt.method.concat(" ").concat(rt.pattern))
        end
    end
    ret out
end

@en "Free"
@fa "آزاد سازی"
pub func Free(d &: Doc):
    repeat d.ops.len() with i:
        mut o := d.ops.get(i)
        o.tags.free()
        o.params.free()
        repeat o.replies.len() with j:
            mut rp := o.replies.get(j)
            rp.header_names.free()
            rp.header_notes.free()
        end
        o.replies.free()
        o.security.free()
    end
    d.ops.free()
    d.servers.free()
    d.server_notes.free()
    d.defs.free()
    d.schemes.free()
    d.cur = 0 - 1
end
