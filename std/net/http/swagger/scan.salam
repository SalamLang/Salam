package swagger

import net.router
import str

const _WILDCARD_NAME := "path"

func _path_params(pattern: str): Vector<Param>:
    mut out := Vector {} as Vector<Param>
    n := pattern.Len()
    mut i := 0
    until i < n:
        c := pattern.Substr(i, 1)
        if str.Equals(c, ":"):
            mut e := i + 1
            until e < n and not str.Equals(pattern.Substr(e, 1), "/"):
                e++
            end
            out.Push(
                Param {
                    name = pattern.Substr(i + 1, e - i - 1), loc = "path", required = true
                }
            )
            i = e
        else str.Equals(c, "*"):
            out.Push(
                Param {
                    name = _WILDCARD_NAME, loc = "path", required = true, description = "the rest of the path, slashes included"
                }
            )
            i++
        else:
            i++
        end
    end
    ret out
end

func _openapi_path(pattern: str): str:
    mut out := ""
    n := pattern.Len()
    mut i := 0
    until i < n:
        c := pattern.Substr(i, 1)
        if str.Equals(c, ":"):
            mut e := i + 1
            until e < n and not str.Equals(pattern.Substr(e, 1), "/"):
                e++
            end
            out = out.Concat("{").Concat(pattern.Substr(i + 1, e - i - 1)).Concat("}")
            i = e
        else str.Equals(c, "*"):
            out = out.Concat("{").Concat(_WILDCARD_NAME).Concat("}")
            i++
        else:
            out = out.Concat(c)
            i++
        end
    end
    ret out
end

func _is_own_route(fn: i64): bool:
    ret fn == _handle_ui or fn == _handle_spec
end

func _default_op_id(method: str, pattern: str): str:
    mut out := method.Lower()
    n := pattern.Len()
    mut last_us := false
    repeat n in i:
        c := pattern.Substr(i, 1)
        if str.Equals(c, "/") or str.Equals(c, ":") or str.Equals(c, "*") or str.Equals(c, "-"):
            if not last_us:
                out = out.Concat("_")
                last_us = true
            end
        else:
            out = out.Concat(c)
            last_us = false
        end
    end
    if last_us and out.Len() > 1:
        ret out.Substr(0, out.Len() - 1)
    end
    ret out
end

@en "Scan"
@fa "پویش"
pub func Scan(d &: Doc, r: router.Router):
    n := r.routes.Len()
    mut i := 0
    until i < n:
        rt := r.routes.Get(i)
        if not _is_own_route(rt.fn):
            _add := Route(d, rt.method, rt.pattern)
        end
        i++
    end
    d.cur = 0 - 1
end

@en "ScanPrefix"
@fa "پویش با پیشوند"
pub func ScanPrefix(d &: Doc, r: router.Router, prefix: str):
    n := r.routes.Len()
    mut i := 0
    until i < n:
        rt := r.routes.Get(i)
        if not _is_own_route(rt.fn) and rt.pattern.Len() >= prefix.Len() and str.Equals(
            rt.pattern.Substr(0, prefix.Len()), prefix
        ):
            _add := Route(d, rt.method, rt.pattern)
        end
        i++
    end
    d.cur = 0 - 1
end
