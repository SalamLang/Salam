package swagger

import net.router
import str

const _WILDCARD_NAME := "path"

func _path_params(pattern: str): Vector<Param>:
    mut out := Vector {} as Vector<Param>
    n := pattern.len()
    mut i := 0
    until i < n:
        c := pattern.substr(i, 1)
        if str.Equals(c, ":"):
            mut e := i + 1
            until e < n && !str.Equals(pattern.substr(e, 1), "/"):
                e += 1
            end
            out.push(Param {
                name = pattern.substr(i + 1, e - i - 1), loc = "path", required = true
            })
            i = e
        else str.Equals(c, "*"):
            out.push(Param {
                name = _WILDCARD_NAME, loc = "path", required = true,
                description = "the rest of the path, slashes included"
            })
            i += 1
        else:
            i += 1
        end
    end
    ret out
end

func _openapi_path(pattern: str): str:
    mut out := ""
    n := pattern.len()
    mut i := 0
    until i < n:
        c := pattern.substr(i, 1)
        if str.Equals(c, ":"):
            mut e := i + 1
            until e < n && !str.Equals(pattern.substr(e, 1), "/"):
                e += 1
            end
            out = out.concat("{").concat(pattern.substr(i + 1, e - i - 1)).concat("}")
            i = e
        else str.Equals(c, "*"):
            out = out.concat("{").concat(_WILDCARD_NAME).concat("}")
            i += 1
        else:
            out = out.concat(c)
            i += 1
        end
    end
    ret out
end

func _is_own_route(fn: i64): bool:
    ret fn == _handle_ui || fn == _handle_spec
end

func _default_op_id(method: str, pattern: str): str:
    mut out := method.lower()
    n := pattern.len()
    mut last_us := false
    repeat n with i:
        c := pattern.substr(i, 1)
        if str.Equals(c, "/") || str.Equals(c, ":") || str.Equals(c, "*") || str.Equals(c, "-"):
            if !last_us:
                out = out.concat("_")
                last_us = true
            end
        else:
            out = out.concat(c)
            last_us = false
        end
    end
    if last_us && out.len() > 1:
        ret out.substr(0, out.len() - 1)
    end
    ret out
end

@en "Scan"
@fa "پویش"
pub func Scan(d &: Doc, r: router.Router):
    n := r.routes.len()
    mut i := 0
    until i < n:
        rt := r.routes.get(i)
        if !_is_own_route(rt.fn):
            _add := Route(d, rt.method, rt.pattern)
        end
        i += 1
    end
    d.cur = 0 - 1
end

@en "ScanPrefix"
@fa "پویش با پیشوند"
pub func ScanPrefix(d &: Doc, r: router.Router, prefix: str):
    n := r.routes.len()
    mut i := 0
    until i < n:
        rt := r.routes.get(i)
        if !_is_own_route(rt.fn) && rt.pattern.len() >= prefix.len() && str.Equals(
            rt.pattern.substr(0, prefix.len()), prefix
        ):
            _add := Route(d, rt.method, rt.pattern)
        end
        i += 1
    end
    d.cur = 0 - 1
end
