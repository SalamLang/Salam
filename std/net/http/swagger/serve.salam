package swagger

import net.http
import net.router
import os
import str

mut _mounts := Vector {} as Vector<_Mount>

struct _Mount:
    pub prefix: str = ""
    pub prefix_slash: str = ""
    pub spec_path: str = ""
    pub title: str = ""
    pub spec: str = ""
    pub page: str = ""
    pub port: int = 0
end

func _host_port(host: str): int:
    colon := str.LastIndex(host, ":")
    if colon < 0 || colon == host.len() - 1:
        ret 0
    end
    tail := host.substr(colon + 1, host.len() - colon - 1)
    repeat tail.len() with i:
        c := tail.substr(i, 1)
        if c < "0" || c > "9":
            ret 0
        end
    end
    ret tail.to_int()
end

func _path_matches(m: _Mount, path: str, want_spec: bool): bool:
    if want_spec:
        ret str.Equals(m.spec_path, path)
    end
    ret str.Equals(m.prefix, path) || str.Equals(m.prefix_slash, path)
end

func _mount_for(path: str, host: str, want_spec: bool): int:
    port := _host_port(host)
    if port > 0:
        repeat _mounts.len() with i:
            m := _mounts.get(i)
            if m.port == port && _path_matches(m, path, want_spec):
                ret i
            end
        end
    end
    repeat _mounts.len() with j:
        m2 := _mounts.get(j)
        if m2.port == 0 && _path_matches(m2, path, want_spec):
            ret j
        end
    end
    repeat _mounts.len() with k:
        if _path_matches(_mounts.get(k), path, want_spec):
            ret k
        end
    end
    ret 0 - 1
end

func _clean_prefix(prefix: str): str:
    mut p := prefix
    if p.len() == 0:
        ret "/"
    end
    if !str.Equals(p.substr(0, 1), "/"):
        p = "/".concat(p)
    end
    until p.len() > 1 && str.Equals(p.substr(p.len() - 1, 1), "/"):
        p = p.substr(0, p.len() - 1)
    end
    ret p
end

func _spec_path_for(prefix: str): str:
    if str.Equals(prefix, "/"):
        ret "/openapi.json"
    end
    ret prefix.concat("/openapi.json")
end

func _register(prefix: str, port: int, title: str, spec: str): int:
    p := _clean_prefix(prefix)
    entry := _Mount {
        prefix = p, prefix_slash = p.concat("/"), spec_path = _spec_path_for(p),
        title = title, spec = spec, page = Page(title, ""), port = port
    }
    repeat _mounts.len() with i:
        m := _mounts.get(i)
        if str.Equals(m.prefix, p) && m.port == port:
            _mounts.set(i, entry)
            ret i
        end
    end
    _mounts.push(entry)
    ret _mounts.len() - 1
end

func _handle_ui(ctx: i64):
    i := _mount_for(http.Ctx_path(ctx), http.Ctx_header(ctx, "Host"), false)
    if i < 0:
        http.Ctx_status(ctx, 404)
        http.Ctx_text(ctx, "404 Not Found")
        ret
    end
    http.Ctx_set_header(ctx, "Cache-Control", "no-cache")
    http.Ctx_html(ctx, _mounts.get(i).page)
end

func _handle_spec(ctx: i64):
    i := _mount_for(http.Ctx_path(ctx), http.Ctx_header(ctx, "Host"), true)
    if i < 0:
        http.Ctx_status(ctx, 404)
        http.Ctx_json(ctx, "{\"error\":\"not found\"}")
        ret
    end
    http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
    http.Ctx_set_header(ctx, "Cache-Control", "no-cache")
    http.Ctx_json(ctx, _mounts.get(i).spec)
end

func _mount_routes(r &: router.Router, prefix: str):
    p := _clean_prefix(prefix)
    router.Get(r, p, _handle_ui)
    if !str.Equals(p, "/"):
        router.Get(r, p.concat("/"), _handle_ui)
    end
    router.Get(r, _spec_path_for(p), _handle_spec)
end

func _serve_on(prefix: str, port: int): bool:
    mut r := router.NewRouter()
    _mount_routes(r, prefix)
    mut s := http.NewServer(port)
    http.Use(s, r)
    ret http.RunBackground(s)
end

@en "Mount"
@fa "نصب"
@ar "تركیب"
pub func Mount(d: Doc, r &: router.Router, prefix: str):
    _reg := _register(prefix, 0, d.title, Spec(d))
    _mount_routes(r, prefix)
end

@en "MountSpec"
@fa "نصب مشخصات"
@ar "تركیب المواصفات"
pub func MountSpec(spec: str, title: str, r &: router.Router, prefix: str):
    _reg := _register(prefix, 0, title, spec)
    _mount_routes(r, prefix)
end

@en "Serve"
@fa "سرو"
@ar "خدمة"
pub func Serve(d: Doc, port: int): bool:
    _reg := _register("/", port, d.title, Spec(d))
    ret _serve_on("/", port)
end

@en "ServeSpec"
@fa "سرو مشخصات"
@ar "خدمة المواصفات"
pub func ServeSpec(spec: str, title: str, port: int): bool:
    _reg := _register("/", port, title, spec)
    ret _serve_on("/", port)
end

@en "SpecFromFile"
@fa "مشخصات از پرونده"
@ar "مواصفات من ملف"
pub func SpecFromFile(path: str): str:
    if !os.Exists(path):
        ret ""
    end
    ret os.ReadFile(path)
end

@en "WriteSpec"
@fa "نوشتن مشخصات"
@ar "كتابة المواصفات"
pub func WriteSpec(d: Doc, path: str): bool:
    ret os.WriteFile(path, SpecIndent(d)) > 0
end
