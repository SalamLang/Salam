@en "net/http/swagger"
@fa "سواگر"
@ar "سواغر"
package swagger

import net.router
import encoding.json
import str

const _DEFS_PREFIX := "#/$defs/"
const _COMP_PREFIX := "#/components/schemas/"

@en "JSON_TYPE"
@fa "نوع جیسون"
@ar "نوع جیسون"
pub const JSON_TYPE := "application/json"

@en "TEXT_TYPE"
@fa "نوع متن"
@ar "نوع نص"
pub const TEXT_TYPE := "text/plain; charset=utf-8"

@en "HTML_TYPE"
@fa "نوع اچ تی ام ال"
@ar "نوع إتش تی إم إل"
pub const HTML_TYPE := "text/html; charset=utf-8"

@en "FORM_TYPE"
@fa "نوع فرم"
@ar "نوع استمارة"
pub const FORM_TYPE := "application/x-www-form-urlencoded"

@en "TEXT_SCHEMA"
@fa "طرحواره متن"
@ar "مخطط نص"
pub const TEXT_SCHEMA := "{\"type\":\"string\"}"

@en "BINARY_SCHEMA"
@fa "طرحواره دودویی"
@ar "مخطط ثنائي"
pub const BINARY_SCHEMA := "{\"type\":\"string\",\"format\":\"binary\"}"

@en "Param"
@fa "پارامتر"
@ar "معامل"
pub struct Param:
    pub name: str = ""
    pub loc: str = "query"
    pub required: bool = false
    pub description: str = ""
    pub schema: str = "{\"type\":\"string\"}"
end

@en "Reply"
@fa "پاسخ"
@ar "رد"
pub struct Reply:
    pub code: int = 200
    pub description: str = ""
    pub schema: str = ""
    pub content_type: str = "application/json"
    pub header_names: Vector<str> = Vector {}
    pub header_notes: Vector<str> = Vector {}
end

@en "Scheme"
@fa "طرح احراز هویت"
@ar "مخطط المصادقة"
pub struct Scheme:
    pub name: str = ""
    pub kind: str = "http"
    pub scheme: str = "bearer"
    pub format: str = ""
    pub loc: str = "header"
    pub param: str = ""
    pub description: str = ""
end

@en "Op"
@fa "عملیات"
@ar "عملیة"
pub struct Op:
    pub method: str = ""
    pub pattern: str = ""
    pub op_id: str = ""
    pub summary: str = ""
    pub description: str = ""
    pub is_deprecated: bool = false
    pub tags: Vector<str> = Vector {}
    pub params: Vector<Param> = Vector {}
    pub replies: Vector<Reply> = Vector {}
    pub security: Vector<str> = Vector {}
    pub body_schema: str = ""
    pub body_description: str = ""
    pub body_required: bool = true
    pub body_content_type: str = "application/json"
end

@en "Definition"
@fa "تعریف"
@ar "تعریف"
pub struct Definition:
    pub name: str = ""
    pub body: str = ""
end

@en "Doc"
@fa "سند"
@ar "وثیقة"
pub struct Doc:
    pub title: str = "API"
    pub version: str = "1.0.0"
    pub description: str = ""
    pub servers: Vector<str> = Vector {}
    pub server_notes: Vector<str> = Vector {}
    pub ops: Vector<Op> = Vector {}
    pub defs: Vector<Definition> = Vector {}
    pub schemes: Vector<Scheme> = Vector {}
    pub contact_name: str = ""
    pub contact_url: str = ""
    pub contact_email: str = ""
    pub license_name: str = ""
    pub license_url: str = ""
    pub cur: int = 0 - 1
end

func _reref(schema: str): str:
    ret str.Replace(schema, _DEFS_PREFIX, _COMP_PREFIX)
end

func _op_index(d &: Doc, method: str, pattern: str): int:
    repeat d.ops.len() with i:
        o := d.ops.get(i)
        if str.Equals(o.method, method) && str.Equals(o.pattern, pattern):
            ret i
        end
    end
    ret 0 - 1
end

func _def_has(d &: Doc, name: str): bool:
    repeat d.defs.len() with i:
        if str.Equals(d.defs.get(i).name, name):
            ret true
        end
    end
    ret false
end

func _absorb(d &: Doc, envelope: str): str:
    defs := json.Get(envelope, "defs")
    if defs.len() > 2:
        names := json.Keys(defs)
        defer names.free()
        repeat names.len() with i:
            name := names.get(i)
            if !_def_has(d, name):
                d.defs.push(Definition { name = name, body = _reref(json.Get(defs, name)) })
            end
        end
    end
    ret _reref(json.Get(envelope, "schema"))
end

func _cur(d &: Doc): int:
    if d.cur < 0 || d.cur >= d.ops.len():
        ret 0 - 1
    end
    ret d.cur
end

func _put_param(d &: Doc, name: str, loc: str, description: str, required: bool, schema: str):
    _set_param(d, Param {
        name = name, loc = loc, required = required, description = description,
        schema = schema
    })
end

func _enum_schema(values: Vector<str>): str:
    if values.len() == 0:
        ret "{\"type\":\"string\"}"
    end
    mut out := "{\"type\":\"string\",\"enum\":["
    repeat values.len() with i:
        if i > 0:
            out = out.concat(",")
        end
        out = out.concat(json.Str(values.get(i)))
    end
    ret out.concat("]}")
end

func _put_body(d &: Doc, description: str, schema: str, content_type: str, required: bool):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    o.body_schema = schema
    o.body_description = description
    o.body_content_type = content_type
    o.body_required = required
    d.ops.set(i, o)
end

func _set_param(d &: Doc, p: Param):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    repeat o.params.len() with j:
        if str.Equals(o.params.get(j).name, p.name) && str.Equals(o.params.get(j).loc, p.loc):
            o.params.set(j, p)
            d.ops.set(i, o)
            ret
        end
    end
    o.params.push(p)
    d.ops.set(i, o)
end

func _add_reply(d &: Doc, code: int, description: str, schema: str, content_type: str):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    r := Reply {
        code = code, description = description, schema = schema,
        content_type = content_type
    }
    repeat o.replies.len() with j:
        if o.replies.get(j).code == code:
            o.replies.set(j, r)
            d.ops.set(i, o)
            ret
        end
    end
    o.replies.push(r)
    d.ops.set(i, o)
end

@en "New"
@fa "جدید"
@ar "جدید"
pub func New(title: str, version: str): Doc:
    ret Doc { title = title, version = version }
end

@en "Describe"
@fa "توضیح"
@ar "وصف"
pub func Describe(d &: Doc, text: str):
    d.description = text
end

@en "Server"
@fa "سرور"
@ar "خادم"
pub func Server(d &: Doc, url: str, note: str):
    d.servers.push(url)
    d.server_notes.push(note)
end

@en "Contact"
@fa "تماس"
@ar "اتصال"
pub func Contact(d &: Doc, name: str, url: str, email: str):
    d.contact_name = name
    d.contact_url = url
    d.contact_email = email
end

@en "License"
@fa "پروانه"
@ar "رخصة"
pub func License(d &: Doc, name: str, url: str):
    d.license_name = name
    d.license_url = url
end

@en "BearerAuth"
@fa "احراز هویت حامل"
@ar "مصادقة الحامل"
pub func BearerAuth(d &: Doc, name: str, format: str):
    d.schemes.push(Scheme { name = name, kind = "http", scheme = "bearer", format = format })
end

@en "ApiKeyAuth"
@fa "احراز هویت کلید"
@ar "مصادقة المفتاح"
pub func ApiKeyAuth(d &: Doc, name: str, loc: str, param: str):
    d.schemes.push(Scheme { name = name, kind = "apiKey", loc = loc, param = param })
end

@en "Route"
@fa "مسیر"
@ar "مسار"
pub func Route(d &: Doc, method: str, pattern: str): int:
    verb := str.Upper(method)
    hit := _op_index(d, verb, pattern)
    if hit >= 0:
        d.cur = hit
        ret hit
    end
    mut o := Op { method = verb, pattern = pattern }
    found := _path_params(pattern)
    defer found.free()
    repeat found.len() with i:
        o.params.push(found.get(i))
    end
    d.ops.push(o)
    d.cur = d.ops.len() - 1
    ret d.cur
end

@en "At"
@fa "در"
@ar "عند"
pub func At(d &: Doc, method: str, pattern: str): bool:
    hit := _op_index(d, str.Upper(method), pattern)
    d.cur = hit
    ret hit >= 0
end

@en "Summary"
@fa "خلاصه"
@ar "ملخص"
pub func Summary(d &: Doc, text: str):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    o.summary = text
    d.ops.set(i, o)
end

@en "Details"
@fa "جزئیات"
@ar "تفاصیل"
pub func Details(d &: Doc, text: str):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    o.description = text
    d.ops.set(i, o)
end

@en "Tag"
@fa "برچسب"
@ar "وسم"
pub func Tag(d &: Doc, name: str):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    o.tags.push(name)
    d.ops.set(i, o)
end

@en "OperationId"
@fa "شناسه عملیات"
@ar "معرف العملیة"
pub func OperationId(d &: Doc, id: str):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    o.op_id = id
    d.ops.set(i, o)
end

@en "Deprecated"
@fa "منسوخ"
@ar "مهمل"
pub func Deprecated(d &: Doc):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    o.is_deprecated = true
    d.ops.set(i, o)
end

@en "Secure"
@fa "امن"
@ar "مؤمن"
pub func Secure(d &: Doc, scheme: str):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    o.security.push(scheme)
    d.ops.set(i, o)
end

@en "Query"
@fa "پرسمان"
@ar "استعلام"
pub func Query(d &: Doc, name: str, description: str, required: bool):
    _put_param(d, name, "query", description, required, "{\"type\":\"string\"}")
end

@en "QueryTyped"
@fa "پرسمان نوع دار"
@ar "استعلام مصنف"
pub func QueryTyped<T>(d &: Doc, name: str, description: str, required: bool, sample: T):
    _put_param(d, name, "query", description, required, _absorb(d, json.SchemaEnvelope(sample)))
end

@en "QueryEnum"
@fa "پرسمان گزینه ای"
@ar "استعلام محدد"
pub func QueryEnum(
    d &: Doc, name: str, description: str, required: bool, values: Vector<str>
):
    _put_param(d, name, "query", description, required, _enum_schema(values))
end

@en "Header"
@fa "سرصفحه"
@ar "ترویسة"
pub func Header(d &: Doc, name: str, description: str, required: bool):
    _put_param(d, name, "header", description, required, "{\"type\":\"string\"}")
end

@en "Cookie"
@fa "کوکی"
@ar "كوكي"
pub func Cookie(d &: Doc, name: str, description: str, required: bool):
    _put_param(d, name, "cookie", description, required, "{\"type\":\"string\"}")
end

@en "PathParam"
@fa "پارامتر مسیر"
@ar "معامل المسار"
pub func PathParam(d &: Doc, name: str, description: str):
    _put_param(d, name, "path", description, true, "{\"type\":\"string\"}")
end

@en "Accepts"
@fa "می پذیرد"
@ar "یقبل"
pub func Accepts<T>(d &: Doc, description: str, sample: T):
    _put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE, true)
end

@en "AcceptsOptional"
@fa "می پذیرد اختیاری"
@ar "یقبل اختیاري"
pub func AcceptsOptional<T>(d &: Doc, description: str, sample: T):
    _put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE, false)
end

@en "AcceptsRaw"
@fa "می پذیرد خام"
@ar "یقبل خام"
pub func AcceptsRaw(d &: Doc, description: str, content_type: str, schema: str, required: bool):
    _put_body(d, description, schema, content_type, required)
end

@en "AcceptsForm"
@fa "می پذیرد فرم"
@ar "یقبل استمارة"
pub func AcceptsForm<T>(d &: Doc, description: str, sample: T):
    _put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), FORM_TYPE, true)
end

@en "Returns"
@fa "برمی گرداند"
@ar "یرجع"
pub func Returns<T>(d &: Doc, code: int, description: str, sample: T):
    _add_reply(d, code, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE)
end

@en "ReturnsRaw"
@fa "برمی گرداند خام"
@ar "یرجع خام"
pub func ReturnsRaw(d &: Doc, code: int, description: str, content_type: str, schema: str):
    _add_reply(d, code, description, schema, content_type)
end

@en "ReturnsText"
@fa "برمی گرداند متن"
@ar "یرجع نصا"
pub func ReturnsText(d &: Doc, code: int, description: str):
    _add_reply(d, code, description, TEXT_SCHEMA, TEXT_TYPE)
end

@en "ReturnsHtml"
@fa "برمی گرداند اچ تی ام ال"
@ar "یرجع إتش تی إم إل"
pub func ReturnsHtml(d &: Doc, code: int, description: str):
    _add_reply(d, code, description, TEXT_SCHEMA, HTML_TYPE)
end

@en "ReturnsFile"
@fa "برمی گرداند پرونده"
@ar "یرجع ملفا"
pub func ReturnsFile(d &: Doc, code: int, description: str, content_type: str):
    _add_reply(d, code, description, BINARY_SCHEMA, content_type)
end

@en "ReturnsHeader"
@fa "برمی گرداند سرصفحه"
@ar "یرجع ترویسة"
pub func ReturnsHeader(d &: Doc, code: int, name: str, description: str):
    i := _cur(d)
    if i < 0:
        ret
    end
    mut o := d.ops.get(i)
    mut at_slot := 0 - 1
    repeat o.replies.len() with j:
        if o.replies.get(j).code == code:
            at_slot = j
        end
    end
    if at_slot < 0:
        o.replies.push(Reply { code = code, description = "", schema = "", content_type = "" })
        at_slot = o.replies.len() - 1
    end
    mut rp := o.replies.get(at_slot)
    repeat rp.header_names.len() with k:
        if str.Equals(rp.header_names.get(k), name):
            rp.header_notes.set(k, description)
            o.replies.set(at_slot, rp)
            d.ops.set(i, o)
            ret
        end
    end
    rp.header_names.push(name)
    rp.header_notes.push(description)
    o.replies.set(at_slot, rp)
    d.ops.set(i, o)
end

@en "ReturnsNothing"
@fa "بدون بدنه برمی گرداند"
@ar "یرجع بلا متن"
pub func ReturnsNothing(d &: Doc, code: int, description: str):
    _add_reply(d, code, description, "", "")
end
