@en "net/http2"
@fa "اچ تی تی پی۲"
package http2

import compress
import tls

@en "H2_PREFACE"
@fa "پیش‌درآمد اچ‌تی‌تی‌پی۲"
pub const H2_PREFACE := "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

@en "H2_DATA"
@fa "قاب داده"
pub const H2_DATA := 0
@en "H2_HEADERS"
@fa "قاب سرصفحه‌ها"
pub const H2_HEADERS := 1
@en "H2_PRIORITY"
@fa "قاب اولویت"
pub const H2_PRIORITY := 2
@en "H2_RST_STREAM"
@fa "قاب بازنشانی جریان"
pub const H2_RST_STREAM := 3
@en "H2_SETTINGS"
@fa "قاب تنظیمات"
pub const H2_SETTINGS := 4
@en "H2_PUSH_PROMISE"
@fa "قاب وعده ارسال"
pub const H2_PUSH_PROMISE := 5
@en "H2_PING"
@fa "قاب پینگ"
pub const H2_PING := 6
@en "H2_GOAWAY"
@fa "قاب ترک اتصال"
pub const H2_GOAWAY := 7
@en "H2_WINDOW_UPDATE"
@fa "قاب به‌روزرسانی پنجره"
pub const H2_WINDOW_UPDATE := 8
@en "H2_CONTINUATION"
@fa "قاب ادامه"
pub const H2_CONTINUATION := 9

@en "H2_FLAG_END_STREAM"
@fa "پرچم اتمام جریان"
pub const H2_FLAG_END_STREAM := 1
@en "H2_FLAG_ACK"
@fa "پرچم تایید"
pub const H2_FLAG_ACK := 1
@en "H2_FLAG_END_HEADERS"
@fa "پرچم اتمام سرصفحه‌ها"
pub const H2_FLAG_END_HEADERS := 4
@en "H2_FLAG_PADDED"
@fa "پرچم لایه‌گذاری"
pub const H2_FLAG_PADDED := 8
@en "H2_FLAG_PRIORITY"
@fa "پرچم اولویت"
pub const H2_FLAG_PRIORITY := 32

@en "H2_SETTINGS_HEADER_TABLE_SIZE"
@fa "تنظیم اندازه جدول سرصفحه"
pub const H2_SETTINGS_HEADER_TABLE_SIZE := 1
@en "H2_SETTINGS_ENABLE_PUSH"
@fa "تنظیم فعال‌سازی ارسال"
pub const H2_SETTINGS_ENABLE_PUSH := 2
@en "H2_SETTINGS_MAX_CONCURRENT_STREAMS"
@fa "تنظیم بیشینه جریان‌های همزمان"
pub const H2_SETTINGS_MAX_CONCURRENT_STREAMS := 3
@en "H2_SETTINGS_INITIAL_WINDOW_SIZE"
@fa "تنظیم اندازه آغازین پنجره"
pub const H2_SETTINGS_INITIAL_WINDOW_SIZE := 4
@en "H2_SETTINGS_MAX_FRAME_SIZE"
@fa "تنظیم بیشینه اندازه قاب"
pub const H2_SETTINGS_MAX_FRAME_SIZE := 5
@en "H2_SETTINGS_MAX_HEADER_LIST_SIZE"
@fa "تنظیم بیشینه اندازه فهرست سرصفحه"
pub const H2_SETTINGS_MAX_HEADER_LIST_SIZE := 6

@en "H2_NO_ERROR"
@fa "کد بدون خطا"
pub const H2_NO_ERROR := 0
@en "H2_PROTOCOL_ERROR"
@fa "کد خطای پروتکل"
pub const H2_PROTOCOL_ERROR := 1
@en "H2_INTERNAL_ERROR"
@fa "کد خطای داخلی"
pub const H2_INTERNAL_ERROR := 2
@en "H2_FLOW_CONTROL_ERROR"
@fa "کد خطای کنترل جریان"
pub const H2_FLOW_CONTROL_ERROR := 3
@en "H2_SETTINGS_TIMEOUT"
@fa "کد مهلت تنظیمات"
pub const H2_SETTINGS_TIMEOUT := 4
@en "H2_STREAM_CLOSED"
@fa "کد جریان بسته‌شده"
pub const H2_STREAM_CLOSED := 5
@en "H2_FRAME_SIZE_ERROR"
@fa "کد خطای اندازه قاب"
pub const H2_FRAME_SIZE_ERROR := 6
@en "H2_REFUSED_STREAM"
@fa "کد جریان ردشده"
pub const H2_REFUSED_STREAM := 7
@en "H2_CANCEL"
@fa "کد لغو"
pub const H2_CANCEL := 8
@en "H2_COMPRESSION_ERROR"
@fa "کد خطای فشرده‌سازی"
pub const H2_COMPRESSION_ERROR := 9
@en "H2_CONNECT_ERROR"
@fa "کد خطای اتصال"
pub const H2_CONNECT_ERROR := 10
@en "H2_ENHANCE_YOUR_CALM"
@fa "کد درخواست آرامش"
pub const H2_ENHANCE_YOUR_CALM := 11
