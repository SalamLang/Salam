package httpd

import str
import conv
import os
import regex
import net.httpd.conf

const LOC_PREFIX := 0
const LOC_EXACT := 1
const LOC_NOREGEX := 2
const LOC_REGEX := 3
const LOC_REGEX_I := 4

struct Listen:
    pub host: str = "0.0.0.0"
    pub port: int = 80
    pub site: int = 0
end

struct HeaderRule:
    pub site: int = 0
    pub loc: int = -1
    pub name: str = ""
    pub value: str = ""
end

struct ErrorPage:
    pub site: int = 0
    pub loc: int = -1
    pub code: int = 0
    pub path: str = ""
end

struct Rule:
    pub root: str = ""
    pub alias: str = ""
    pub index: str = ""
    pub ret_code: int = 0
    pub ret_body: str = ""
    pub redirect: str = ""
    pub redirect_code: int = 0
    pub cache: i64 = -1
end

struct Location:
    pub site: int = 0
    pub kind: int = 0
    pub pattern: str = ""
    pub rule: Rule = Rule {}
end

struct Site:
    pub names: str = ""
    pub is_default: bool = false
    pub loc_first: int = 0
    pub loc_count: int = 0
    pub line: int = 0
    pub col: int = 0
    pub rule: Rule = Rule {}
end

struct Config:
    pub access_log: str = ""
    pub listens: Vector<Listen> = Vector {}
    pub sites: Vector<Site> = Vector {}
    pub locations: Vector<Location> = Vector {}
    pub headers: Vector<HeaderRule> = Vector {}
    pub pages: Vector<ErrorPage> = Vector {}
    pub problems: Vector<str> = Vector {}
end

func _problem(c &: Config, file: str, line: int, col: int, msg: str):
    c.problems.push(file + ":" + str.FromInt(line as i64) + ":" + str.FromInt(col as i64) + ": " + msg)
end

func _min3(a: int, b: int, c: int): int:
    mut m := a
    if b < m: m = b end
    if c < m: m = c end
    ret m
end

func _distance(a: str, b: str): int:
    na := a.len()
    nb := b.len()
    ap := a as u8 *
    bp := b as u8 *
    mut prev := Vector {} as Vector<int>
    mut cur := Vector {} as Vector<int>
    defer prev.free()
    defer cur.free()
    repeat nb + 1 in j:
        prev.push(j)
        cur.push(0)
    end
    repeat na in i:
        cur.set(0, i + 1)
        repeat nb in j:
            cost := ap[i] == bp[j] ? 0 : 1
            cur.set(j + 1, _min3(prev.get(j + 1) + 1, cur.get(j) + 1, prev.get(j) + cost))
        end
        repeat nb + 1 in j:
            prev.set(j, cur.get(j))
        end
    end
    ret prev.get(nb)
end

func _suggest(name: str, allowed: str): str:
    names := str.Split(allowed, "|")
    defer names.free()
    mut best := ""
    mut best_d := 1000
    repeat names.len() in i:
        n := names.get(i)
        dist := _distance(name, n)
        if dist < best_d:
            best_d = dist
            best = n
        end
    end
    limit := name.len() / 3 + 1
    if best_d <= limit and best_d < best.len():
        ret " (did you mean '" + best + "'?)"
    end
    ret ""
end

func _in_list(name: str, allowed: str): bool:
    names := str.Split(allowed, "|")
    defer names.free()
    repeat names.len() in i:
        if str.Equals(names.get(i), name): ret true end
    end
    ret false
end

func _parse_uint(s: str): i64:
    n := s.len()
    if n == 0 or n > 15: ret -1 end
    bp := s as u8 *
    repeat n in i:
        ch := bp[i] as int
        if ch < 48 or ch > 57: ret -1 end
    end
    ret conv.ParseInt(s)
end

func _joined(d: conf.Doc, node: int): str:
    n := d.nodes.get(node)
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    repeat n.values.len() in i:
        parts.push(n.values.get(i).text)
    end
    ret str.Join(parts, " ")
end

func _is_true(word: str): bool:
    ret str.Equals(word, "true") or str.Equals(word, "yes") or str.Equals(word, "on")
end

func _is_false(word: str): bool:
    ret str.Equals(word, "false") or str.Equals(word, "no") or str.Equals(word, "off")
end

func _parse_listen(c &: Config, file: str, d: conf.Doc, node: int, site: int):
    n := d.nodes.get(node)
    mut l := Listen { site = site }
    mut have_port := false
    repeat n.values.len() in i:
        v := n.values.get(i)
        if v.kind == conf.VAL_NUM:
            p := _parse_uint(v.text)
            if p < 1 or p > 65535:
                _problem(c, file, v.line, v.col, "port must be a number from 1 to 65535")
            else:
                l.port = p as int
                have_port = true
            end
        else v.kind == conf.VAL_STR:
            colon := v.text.indexOf(":")
            if colon < 0:
                l.host = v.text
            else:
                if colon > 0: l.host = v.text.substr(0, colon) end
                p := _parse_uint(v.text.substr(colon + 1, v.text.len() - colon - 1))
                if p < 1 or p > 65535:
                    _problem(c, file, v.line, v.col, "port must be a number from 1 to 65535")
                else:
                    l.port = p as int
                    have_port = true
                end
            end
        else str.Equals(v.text, "tls"):
            _problem(c, file, v.line, v.col, "tls is not available yet")
        else:
            _problem(c, file, v.line, v.col, "unknown listen option '" + v.text + "'")
        end
    end
    if not have_port: l.port = 80 end
    c.listens.push(l)
end

func _apply_common(c &: Config, file: str, d: conf.Doc, node: int, name: str, rule &: Rule, site: int, loc: int): bool:
    n := d.nodes.get(node)
    if str.Equals(name, "root"):
        rule.root = _joined(d, node)
    else str.Equals(name, "alias"):
        rule.alias = _joined(d, node)
    else str.Equals(name, "index"):
        rule.index = _joined(d, node)
    else str.Equals(name, "redirect"):
        rule.redirect = _joined(d, node)
    else str.Equals(name, "code"):
        p := _parse_uint(n.values.get(0).text)
        if p < 100 or p > 599:
            _problem(c, file, n.line, n.col, "code must be an HTTP status from 100 to 599")
        else:
            rule.redirect_code = p as int
        end
    else str.Equals(name, "return"):
        v0 := n.values.get(0)
        p := v0.kind == conf.VAL_NUM ? _parse_uint(v0.text) : -1
        if p < 100 or p > 599:
            _problem(c, file, v0.line, v0.col, "return needs an HTTP status from 100 to 599, then an optional text")
        else:
            rule.ret_code = p as int
            if n.values.len() > 1: rule.ret_body = n.values.get(1).text end
        end
    else str.Equals(name, "cache"):
        secs := ParseDuration(_joined(d, node))
        if secs < 0:
            _problem(c, file, n.line, n.col, "cache must be a duration such as 30s, 10m, 12h, 30d or 1y")
        else:
            rule.cache = secs
        end
    else str.Equals(name, "header"):
        if n.values.len() != 2 or n.values.get(0).kind != conf.VAL_STR or n.values.get(1).kind != conf.VAL_STR:
            _problem(c, file, n.line, n.col, "header needs two strings: the name and the value")
        else:
            c.headers.push(HeaderRule { site = site, loc = loc, name = n.values.get(0).text, value = n.values.get(1).text })
        end
    else str.Equals(name, "error page"):
        v0 := n.values.get(0)
        p := v0.kind == conf.VAL_NUM ? _parse_uint(v0.text) : -1
        if p < 400 or p > 599 or n.values.len() != 2:
            _problem(c, file, v0.line, v0.col, "error page needs a status from 400 to 599 and a file")
        else:
            c.pages.push(ErrorPage { site = site, loc = loc, code = p as int, path = n.values.get(1).text })
        end
    else:
        ret false
    end
    ret true
end

func _parse_location(c &: Config, file: str, d: conf.Doc, node: int, site: int):
    n := d.nodes.get(node)
    if n.labels.len() != 1:
        _problem(c, file, n.line, n.col, "location needs one pattern, for example location \"/api/\":")
        ret
    end
    label := n.labels.get(0)
    mut loc := Location { site = site }
    mut pat := label
    if str.StartsWith(label, "= "):
        loc.kind = LOC_EXACT
        pat = label.substr(2, label.len() - 2)
    else str.StartsWith(label, "^~ "):
        loc.kind = LOC_NOREGEX
        pat = label.substr(3, label.len() - 3)
    else str.StartsWith(label, "~* "):
        loc.kind = LOC_REGEX_I
        pat = label.substr(3, label.len() - 3)
    else str.StartsWith(label, "~ "):
        loc.kind = LOC_REGEX
        pat = label.substr(2, label.len() - 2)
    end
    pat = str.Trim(pat)
    if loc.kind == LOC_REGEX or loc.kind == LOC_REGEX_I:
        if not regex.IsValid(pat):
            _problem(c, file, n.line, n.col, "'" + pat + "' is not a valid regular expression")
        end
    else:
        if not str.StartsWith(pat, "/"):
            _problem(c, file, n.line, n.col, "a location path must start with '/'")
        end
    end
    loc.pattern = pat
    idx := c.locations.len()
    mut rule := Rule {}
    repeat n.children.len() in i:
        ch := n.children.get(i)
        cn := d.nodes.get(ch)
        name := conf.Name(d, ch)
        if cn.block:
            _problem(c, file, cn.line, cn.col, "'" + name + "' cannot be used inside a location")
        else:
            if not _apply_common(c, file, d, ch, name, rule, site, idx):
                _problem(c, file, cn.line, cn.col, "unknown setting '" + name + "' in a location" + _suggest(name, "root|alias|index|redirect|code|return|cache|header|error page"))
            end
        end
    end
    if rule.alias.len() > 0:
        if loc.kind != LOC_PREFIX and loc.kind != LOC_NOREGEX:
            _problem(c, file, n.line, n.col, "alias works only with a prefix location, use root for the others")
        else not os.IsDir(rule.alias):
            _problem(c, file, n.line, n.col, "alias '" + rule.alias + "' is not a directory")
        end
    end
    loc.rule = rule
    c.locations.push(loc)
end

func _parse_site(c &: Config, file: str, d: conf.Doc, node: int):
    n := d.nodes.get(node)
    site := c.sites.len()
    mut s := Site { loc_first = c.locations.len(), line = n.line, col = n.col }
    mut rule := Rule {}
    mut listen_count := 0
    repeat n.children.len() in i:
        ch := n.children.get(i)
        cn := d.nodes.get(ch)
        name := conf.Name(d, ch)
        if cn.block:
            if str.Equals(name, "location"):
                _parse_location(c, file, d, ch, site)
            else:
                _problem(c, file, cn.line, cn.col, "unknown block '" + name + "' in a site" + _suggest(name, "location"))
            end
        else str.Equals(name, "listen"):
            _parse_listen(c, file, d, ch, site)
            listen_count += 1
        else str.Equals(name, "names"):
            s.names = str.Lower(_joined(d, ch))
        else str.Equals(name, "default"):
            w := cn.values.get(0).text
            if _is_true(w):
                s.is_default = true
            else not _is_false(w):
                _problem(c, file, cn.line, cn.col, "default must be true or false")
            end
        else:
            if not _apply_common(c, file, d, ch, name, rule, site, -1):
                _problem(c, file, cn.line, cn.col, "unknown setting '" + name + "' in a site" + _suggest(name, "listen|names|default|root|index|redirect|code|return|cache|header|error page|location"))
            end
        end
    end
    if listen_count == 0:
        c.listens.push(Listen { site = site })
    end
    if rule.index.len() == 0: rule.index = "index.html" end
    if rule.root.len() > 0 and not os.IsDir(rule.root):
        _problem(c, file, n.line, n.col, "root '" + rule.root + "' is not a directory")
    end
    s.loc_count = c.locations.len() - s.loc_first
    s.rule = rule
    c.sites.push(s)
end

func _parse_log(c &: Config, file: str, d: conf.Doc, node: int):
    n := d.nodes.get(node)
    repeat n.children.len() in i:
        ch := n.children.get(i)
        cn := d.nodes.get(ch)
        name := conf.Name(d, ch)
        if not cn.block and str.Equals(name, "access"):
            c.access_log = _joined(d, ch)
        else:
            _problem(c, file, cn.line, cn.col, "unknown setting '" + name + "' in log" + _suggest(name, "access"))
        end
    end
end

func _parse_server(c &: Config, file: str, d: conf.Doc, node: int):
    n := d.nodes.get(node)
    repeat n.children.len() in i:
        ch := n.children.get(i)
        cn := d.nodes.get(ch)
        name := conf.Name(d, ch)
        if cn.block:
            if str.Equals(name, "site"):
                _parse_site(c, file, d, ch)
            else str.Equals(name, "log"):
                _parse_log(c, file, d, ch)
            else str.Equals(name, "server"):
                _parse_server(c, file, d, ch)
            else:
                _problem(c, file, cn.line, cn.col, "unknown block '" + name + "'" + _suggest(name, "site|log|server"))
            end
        else:
            _problem(c, file, cn.line, cn.col, "unknown setting '" + name + "'" + _suggest(name, "site|log"))
        end
    end
end

func _check_names(c &: Config, file: str):
    mut seen := HashMap {} as HashMap<str, int>
    defer seen.free()
    repeat c.sites.len() in si:
        s := c.sites.get(si)
        names := str.Fields(s.names)
        if names.len() == 0 and not s.is_default:
            _problem(c, file, s.line, s.col, "site number " + str.FromInt((si + 1) as i64) + " has no names and is not the default site")
        end
        repeat names.len() in ni:
            nm := names.get(ni)
            if str.StartsWith(nm, "*") and not str.StartsWith(nm, "*."):
                _problem(c, file, s.line, s.col, "wildcard name '" + nm + "' must look like *.example.com")
            end
            repeat c.listens.len() in li:
                l := c.listens.get(li)
                if l.site == si:
                    key := str.FromInt(l.port as i64) + "|" + nm
                    if seen.has(key):
                        _problem(c, file, s.line, s.col, "name '" + nm + "' is used by two sites on port " + str.FromInt(l.port as i64))
                    else:
                        seen.put(key, si)
                    end
                end
            end
        end
        names.free()
    end
end

@en "ParseDuration"
@fa "تجزیه مدت"
pub func ParseDuration(text: str): i64:
    n := text.len()
    if n == 0: ret -1 end
    bp := text as u8 *
    mut i := 0
    until i < n and bp[i] as int >= 48 and bp[i] as int <= 57:
        i += 1
    end
    if i == 0: ret -1 end
    num := _parse_uint(text.substr(0, i))
    if num < 0: ret -1 end
    unit := text.substr(i, n - i)
    if unit.len() == 0 or str.Equals(unit, "s"): ret num end
    if str.Equals(unit, "m"): ret num * 60 end
    if str.Equals(unit, "h"): ret num * 3600 end
    if str.Equals(unit, "d"): ret num * 86400 end
    if str.Equals(unit, "w"): ret num * 604800 end
    if str.Equals(unit, "y"): ret num * 31536000 end
    ret -1
end

@en "LoadText"
@fa "بارگذاری متن پیکربندی"
pub func LoadText(text: str, file: str): bool:
    mut cfg := Config {}
    mut d := conf.Parse(text)
    defer conf.Free(d)
    if not d.ok:
        cfg.problems.push(conf.ErrorText(d, file))
        _publish(cfg)
        ret false
    end
    _parse_server(cfg, file, d, conf.Root())
    if cfg.sites.len() == 0 and cfg.problems.len() == 0:
        _problem(cfg, file, 1, 1, "the config has no sites")
    end
    if cfg.problems.len() == 0:
        _check_names(cfg, file)
    end
    ok := cfg.problems.len() == 0
    _publish(cfg)
    ret ok
end
