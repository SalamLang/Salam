package httpd

import str
import os
import io
import time
import mem
import conv
import sync
import filepath
import net.http
import net.router
import net.mime

extern:
    func fopen(path: str, mode: str): void *
    func fclose(stream: void *): int
    func fputs(s: str, stream: void *): int
    func fflush(stream: void *): int
    func fdopen(fd: int, mode: str): void *
end

mut _log_fp := null as void *

mut _log_mu := sync.NewMutex()

func _open_log(path: str): bool:
    if path.len() == 0:
        _log_fp = null
        ret true
    end
    if str.Equals(path, "stdout"):
        _log_fp = fdopen(1, "w")
    else str.Equals(path, "stderr"):
        _log_fp = fdopen(2, "w")
    else:
        _log_fp = fopen(path, "ab")
    end
    ret _log_fp != null
end

func _log_line(host: str, method: str, path: str, status: int):
    if _log_fp == null: ret end
    mut sb := str.NewBuilder()
    stamp := time.FormatISOUTC(time.Now())
    code := str.FromInt(status as i64)
    str.BufAppend(sb, stamp)
    str.BufAppend(sb, " ")
    str.BufAppend(sb, host)
    str.BufAppend(sb, " ")
    str.BufAppend(sb, method)
    str.BufAppend(sb, " ")
    str.BufAppend(sb, path)
    str.BufAppend(sb, " ")
    str.BufAppend(sb, code)
    str.BufAppend(sb, "\n")
    line := str.BufStr(sb)
    sync.Lock(_log_mu)
    fputs(line, _log_fp)
    fflush(_log_fp)
    sync.Unlock(_log_mu)
    mem.Free(line as void *)
    mem.Free(stamp as void *)
    mem.Free(code as void *)
    str.BufFree(sb)
end

func _swap(cur: str, find: str, repl: str): str:
    next := str.Replace(cur, find, repl)
    mem.Free(cur as void *)
    ret next
end

func _expand(tmpl: str, host: str, path: str, query: str): str:
    mut out := str.Replace(tmpl, "$host", host)
    out = _swap(out, "$scheme", "http")
    if query.len() > 0:
        ru := _cat3(path, "?", query)
        out = _swap(out, "$request_uri", ru)
        mem.Free(ru as void *)
    else:
        out = _swap(out, "$request_uri", path)
    end
    out = _swap(out, "$uri", path)
    out = _swap(out, "$args", query)
    ret out
end

func _reply(ctx: i64, code: int, body: str):
    http.SetStatus(ctx, code)
    http.Text(ctx, body)
end

func _apply_headers(ctx: i64, site: int, loc: int):
    repeat _cfg.headers.len() in i:
        h := _cfg.headers.get(i)
        if h.site == site and (h.loc == -1 or h.loc == loc):
            http.SetHeader(ctx, h.name, h.value)
        end
    end
end

func _norm_path(path: str): str:
    n := path.len()
    bp := path as u8 *
    out := mem.Allocate((n + 2) as u64)
    ob := out as u8 *
    mut marks := Vector {} as Vector<int>
    defer marks.free()
    mut len := 0
    mut i := 0
    mut bad := false
    until i < n and not bad:
        until i < n and bp[i] as int == 47:
            i += 1
        end
        start := i
        until i < n and bp[i] as int != 47:
            i += 1
        end
        seg := i - start
        if seg == 0 or (seg == 1 and bp[start] as int == 46):
            continue
        end
        if seg == 2 and bp[start] as int == 46 and bp[start + 1] as int == 46:
            if marks.len() == 0:
                bad = true
            else:
                len = marks.pop()
            end
        else:
            marks.push(len)
            ob[len] = 47 as u8
            len += 1
            repeat seg in k:
                ob[len] = bp[start + k]
                len += 1
            end
        end
    end
    if bad:
        mem.Free(out)
        ret str.Clone("")
    end
    if len == 0:
        ob[0] = 47 as u8
        len = 1
    else n > 0 and bp[n - 1] as int == 47:
        ob[len] = 47 as u8
        len += 1
    end
    ob[len] = 0 as u8
    ret out as str
end

func _starts_at(s: str, at: int, lit: str): bool:
    ln := lit.len()
    if at + ln > s.len(): ret false end
    sp := s as u8 *
    lp := lit as u8 *
    repeat ln in k:
        if sp[at + k] != lp[k]: ret false end
    end
    ret true
end

func _blocked_segment(path: str): bool:
    n := path.len()
    bp := path as u8 *
    mut i := 0
    until i < n:
        ch := bp[i] as int
        if ch == 92: ret true end
        if ch == 46 and (i == 0 or bp[i - 1] as int == 47):
            ok := _starts_at(path, i, ".well-known") and (i + 11 == n or bp[i + 11] as int == 47)
            if not ok: ret true end
        end
        i += 1
    end
    ret false
end

func _cat3(a: str, b: str, c: str): str:
    mut sb := str.NewBuilder()
    str.BufAppend(sb, a)
    str.BufAppend(sb, b)
    str.BufAppend(sb, c)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _page_for(site: int, loc: int, code: int): str:
    mut found := ""
    repeat _cfg.pages.len() in i:
        p := _cfg.pages.get(i)
        if p.site == site and p.code == code:
            if p.loc == loc: ret p.path end
            if p.loc == -1: found = p.path end
        end
    end
    ret found
end

func _fail(ctx: i64, site: int, loc: int, root: str, code: int, text: str):
    page := _page_for(site, loc, code)
    if page.len() > 0 and root.len() > 0:
        rel := "/" + page
        clean := _norm_path(rel)
        mem.Free(rel as void *)
        target := root + clean
        mem.Free(clean as void *)
        if os.Exists(target) and not os.IsDir(target):
            if http.File(ctx, target, mime.MimeType(target)):
                http.SetStatus(ctx, code)
                mem.Free(target as void *)
                ret
            end
        end
        mem.Free(target as void *)
    end
    _reply(ctx, code, text)
end

func _effective_root(site: int, loc: int): str:
    if loc >= 0 and _cfg.locations.get(loc).rule.root.len() > 0:
        ret _cfg.locations.get(loc).rule.root
    end
    ret _cfg.sites.get(site).rule.root
end

func _effective_alias(loc: int): str:
    if loc < 0: ret "" end
    ret _cfg.locations.get(loc).rule.alias
end

func _effective_index(site: int, loc: int): str:
    if loc >= 0 and _cfg.locations.get(loc).rule.index.len() > 0:
        ret _cfg.locations.get(loc).rule.index
    end
    ret _cfg.sites.get(site).rule.index
end

func _effective_cache(site: int, loc: int): i64:
    if loc >= 0 and _cfg.locations.get(loc).rule.cache >= 0:
        ret _cfg.locations.get(loc).rule.cache
    end
    ret _cfg.sites.get(site).rule.cache
end

func _send_rule(ctx: i64, rule: Rule, host: str, path: str, query: str): bool:
    if rule.redirect.len() > 0:
        mut code := rule.redirect_code
        if code == 0: code = 301 end
        http.SetStatus(ctx, code)
        http.SetHeader(ctx, "Location", http.Own(ctx, _expand(rule.redirect, host, path, query)))
        http.Text(ctx, "")
        ret true
    end
    if rule.ret_code > 0:
        _reply(ctx, rule.ret_code, rule.ret_body)
        ret true
    end
    ret false
end

func _free_strs(v: Vector<str>):
    repeat v.len() in i:
        mem.Free(v.get(i) as void *)
    end
    v.free()
end

func _serve_file(ctx: i64, site: int, loc: int, root: str, rel: str, path: str, query: str): int:
    mut target := http.Own(ctx, root + rel)
    if os.IsDir(target):
        if not str.EndsWith(path, "/"):
            http.SetStatus(ctx, 301)
            base := _cat3(path, "/", "")
            mut dest := base
            if query.len() > 0:
                dest = _cat3(base, "?", query)
                mem.Free(base as void *)
            end
            http.SetHeader(ctx, "Location", http.Own(ctx, dest))
            http.Text(ctx, "")
            ret 301
        end
        names := str.Fields(_effective_index(site, loc))
        mut found := ""
        repeat names.len() in i:
            cand := filepath.Join(target, names.get(i))
            if found.len() == 0 and os.Exists(cand) and not os.IsDir(cand):
                found = http.Own(ctx, cand)
            else:
                mem.Free(cand as void *)
            end
        end
        _free_strs(names)
        if found.len() == 0: ret 404 end
        target = found
    else not os.Exists(target):
        ret 404
    end
    ret _send_target(ctx, site, loc, target)
end

func _etag_of(mt: i64, size: i64): str:
    a := conv.FormatHex(mt as u64)
    b := conv.FormatHex(size as u64)
    mut sb := str.NewBuilder()
    str.BufAppend(sb, "\"")
    str.BufAppend(sb, a)
    str.BufAppend(sb, "-")
    str.BufAppend(sb, b)
    str.BufAppend(sb, "\"")
    out := str.BufStr(sb)
    str.BufFree(sb)
    mem.Free(a as void *)
    mem.Free(b as void *)
    ret out
end

func _etag_listed(header: str, etag: str): bool:
    if str.Equals(str.Trim(header), "*"): ret true end
    parts := str.Split(header, ",")
    mut hit := false
    repeat parts.len() in i:
        mut p := str.Trim(parts.get(i))
        if str.StartsWith(p, "W/"): p = p.substr(2, p.len() - 2) end
        if str.Equals(p, etag): hit = true end
    end
    _free_strs(parts)
    ret hit
end

func _not_modified(ctx: i64, etag: str, mt: i64): bool:
    inm := http.Header(ctx, "If-None-Match")
    if inm.len() > 0:
        ret _etag_listed(inm, etag)
    end
    ims := http.Header(ctx, "If-Modified-Since")
    if ims.len() > 0 and mt > 0:
        r := time.ParseHTTPDate(ims)
        ret r.ok and mt <= r.epoch
    end
    ret false
end

func _range_bounds(spec: str, size: i64, start &: i64, last &: i64): int:
    dash := spec.indexOf("-")
    if dash < 0 or spec.indexOf(",") >= 0: ret 0 end
    a := str.Trim(spec.substr(0, dash))
    b := str.Trim(spec.substr(dash + 1, spec.len() - dash - 1))
    mut result := 1
    if a.len() == 0:
        n := _parse_uint(b)
        if n < 1:
            result = 2
        else:
            start = n < size ? size - n : 0
            last = size - 1
        end
    else:
        s0 := _parse_uint(a)
        if s0 < 0:
            result = 0
        else:
            start = s0
            last = size - 1
            if b.len() > 0:
                e0 := _parse_uint(b)
                if e0 < 0:
                    result = 0
                else:
                    if e0 < last: last = e0 end
                end
            end
            if result == 1 and (start >= size or last < start): result = 2 end
        end
    end
    mem.Free(a as void *)
    mem.Free(b as void *)
    ret result
end

func _content_range(start: i64, last: i64, size: i64): str:
    mut sb := str.NewBuilder()
    str.BufAppend(sb, "bytes ")
    if start < 0:
        str.BufAppend(sb, "*")
    else:
        str.BufAppendInt(sb, start)
        str.BufAppend(sb, "-")
        str.BufAppendInt(sb, last)
    end
    str.BufAppend(sb, "/")
    str.BufAppendInt(sb, size)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _send_target(ctx: i64, site: int, loc: int, target: str): int:
    ct := mime.MimeType(target)
    mut size := 0 as i64
    mut mt := 0 as i64
    if not http.FileStat(target, size, mt): ret 404 end
    etag := http.Own(ctx, _etag_of(mt, size))
    http.SetHeader(ctx, "ETag", etag)
    if mt > 0:
        http.SetHeader(ctx, "Last-Modified", http.Own(ctx, time.FormatHTTPDate(mt)))
    end
    http.SetHeader(ctx, "Accept-Ranges", "bytes")
    cache := _effective_cache(site, loc)
    if cache >= 0:
        secs := str.FromInt(cache)
        http.SetHeader(ctx, "Cache-Control", http.Own(ctx, _cat3("public, max-age=", secs, "")))
        mem.Free(secs as void *)
    end
    if _not_modified(ctx, etag, mt):
        http.SetStatus(ctx, 304)
        http.Text(ctx, "")
        ret 304
    end
    rh := http.Header(ctx, "Range")
    ir := http.Header(ctx, "If-Range")
    if rh.len() > 6 and str.StartsWith(rh, "bytes=") and (ir.len() == 0 or str.Equals(ir, etag)):
        spec := rh.substr(6, rh.len() - 6)
        mut start := 0 as i64
        mut last := 0 as i64
        kind := _range_bounds(spec, size, start, last)
        mem.Free(spec as void *)
        if kind == 2:
            http.SetStatus(ctx, 416)
            http.SetHeader(ctx, "Content-Range", http.Own(ctx, _content_range(-1, -1, size)))
            http.Text(ctx, "")
            ret 416
        end
        if kind == 1:
            if not http.FileRange(ctx, target, ct, start as int, (last - start + 1) as int): ret 404 end
            http.SetStatus(ctx, 206)
            http.SetHeader(ctx, "Content-Range", http.Own(ctx, _content_range(start, last, size)))
            ret 206
        end
    end
    if not http.File(ctx, target, ct): ret 404 end
    ret 200
end

func _handle(ctx: i64):
    host := http.Header(ctx, "Host")
    mut port := _only_port
    if _multi_port: port = http.LocalPort(ctx) end
    method := http.Method(ctx)
    raw := http.Path(ctx)
    query := http.RawQuery(ctx)
    site := SiteFor(host, port)
    if site < 0:
        _reply(ctx, 404, "no site is configured for this host")
        _log_line(host, method, raw, 404)
        ret
    end
    dec := http.UrlDecode(raw)
    path := http.Own(ctx, _norm_path(dec))
    mem.Free(dec as void *)
    mut status := 200
    mut loc := -1
    if path.len() == 0 or _blocked_segment(path):
        _fail(ctx, site, -1, _effective_root(site, -1), 404, "404 Not Found")
        _log_line(host, method, raw, 404)
        ret
    end
    _apply_headers(ctx, site, -1)
    if _send_rule(ctx, _cfg.sites.get(site).rule, host, path, query):
        _log_line(host, method, raw, http.Status(ctx))
        ret
    end
    loc = LocationFor(site, path)
    if loc >= 0:
        _apply_headers(ctx, site, loc)
        if _send_rule(ctx, _cfg.locations.get(loc).rule, host, path, query):
            _log_line(host, method, raw, http.Status(ctx))
            ret
        end
    end
    mut root := _effective_root(site, loc)
    mut rel := path
    alias := _effective_alias(loc)
    if alias.len() > 0:
        root = alias
        cut := _cfg.locations.get(loc).pattern.len()
        tail := path.substr(cut, path.len() - cut)
        rel = http.Own(ctx, _cat3("/", tail, ""))
        mem.Free(tail as void *)
    end
    if root.len() == 0:
        status = 404
    else not (str.Equals(method, "GET") or str.Equals(method, "HEAD")):
        http.SetHeader(ctx, "Allow", "GET, HEAD")
        status = 405
    else:
        status = _serve_file(ctx, site, loc, root, rel, path, query)
    end
    if status == 404:
        _fail(ctx, site, loc, root, 404, "404 Not Found")
    else status == 405:
        _fail(ctx, site, loc, root, 405, "405 Method Not Allowed")
    end
    _log_line(host, method, raw, http.Status(ctx))
end
