@en "net/internal/errors"
@fa "خطاهای داخلی شبکه"
package errors

@en "KindNone"
@fa "بدون خطا"
pub const KindNone := 0

@en "KindTimeout"
@fa "اتمام مهلت"
pub const KindTimeout := 1

@en "KindConnectionRefused"
@fa "اتصال رد شد"
pub const KindConnectionRefused := 2

@en "KindConnectionReset"
@fa "بازنشانی اتصال"
pub const KindConnectionReset := 3

@en "KindHostUnreachable"
@fa "میزبان غیرقابل دسترس"
pub const KindHostUnreachable := 4

@en "KindAddressInUse"
@fa "نشانی در حال استفاده"
pub const KindAddressInUse := 5

@en "KindProtocolError"
@fa "خطای پروتکل"
pub const KindProtocolError := 6

@en "KindDNSFailure"
@fa "خطای دی ان اس"
pub const KindDNSFailure := 7

@en "KindWouldBlock"
@fa "مسدود می‌شد"
pub const KindWouldBlock := 8

@en "KindClosed"
@fa "بسته شده"
pub const KindClosed := 9

@en "KindInvalidArgument"
@fa "آرگومان نامعتبر"
pub const KindInvalidArgument := 10

@en "NetError"
@fa "خطای شبکه"
pub struct NetError:
    pub kind: int = 0
    pub message: str = ""
    pub sys_errno: int = 0
end

@en "None"
@fa "بدون خطا"
pub func None(): NetError:
    ret NetError { kind = KindNone, message = "", sys_errno = 0 }
end

@en "New"
@fa "خطای جدید"
pub func New(kind: int, message: str): NetError:
    ret NetError { kind = kind, message = message, sys_errno = 0 }
end

@en "NewSys"
@fa "خطای سیستمی جدید"
pub func NewSys(kind: int, message: str, sys_errno: int): NetError:
    ret NetError { kind = kind, message = message, sys_errno = sys_errno }
end

@en "IsError"
@fa "خطا است"
pub func IsError(e: NetError): bool:
    ret e.kind != KindNone
end

@en "IsTimeout"
@fa "اتمام مهلت است"
pub func IsTimeout(e: NetError): bool:
    ret e.kind == KindTimeout
end

@en "IsRefused"
@fa "رد شده است"
pub func IsRefused(e: NetError): bool:
    ret e.kind == KindConnectionRefused
end

@en "IsClosed"
@fa "بسته شده است"
pub func IsClosed(e: NetError): bool:
    ret e.kind == KindClosed
end

@en "IsWouldBlock"
@fa "در حال مسدودشدن است"
pub func IsWouldBlock(e: NetError): bool:
    ret e.kind == KindWouldBlock
end

@en "KindName"
@fa "نام نوع خطا"
pub func KindName(kind: int): str:
    if kind == KindNone: ret "none" end
    if kind == KindTimeout: ret "timeout" end
    if kind == KindConnectionRefused: ret "connection_refused" end
    if kind == KindConnectionReset: ret "connection_reset" end
    if kind == KindHostUnreachable: ret "host_unreachable" end
    if kind == KindAddressInUse: ret "address_in_use" end
    if kind == KindProtocolError: ret "protocol_error" end
    if kind == KindDNSFailure: ret "dns_failure" end
    if kind == KindWouldBlock: ret "would_block" end
    if kind == KindClosed: ret "closed" end
    if kind == KindInvalidArgument: ret "invalid_argument" end
    ret "unknown"
end

@en "String"
@fa "متن"
pub func String(e: NetError): str:
    if e.kind == KindNone: ret "" end
    ret KindName(e.kind) + ": " + e.message
end
