@en "net/internal/errors"
@fa "خطاهای داخلی شبکه"
@ar "أخطاء الشبكة الداخلية"
package errors

// Structured error type shared across the whole net/ stack (net/tcp,
// net/udp, net/dns, net/http, ...). Kinds are plain int constants rather
// than a `pub enum` - pub enum values cannot cross a package boundary in
// this compiler (see std/excel/cell.salam for the same workaround), and
// every kind here must reach caller code outside this package.
//
// Two usage patterns, chosen per call site:
//   - Long-lived handles (a tcp.Conn, a udp.Socket) carry their own
//     `last_err: NetError` field, set on failure and read via a package-
//     local `Err(x): NetError` accessor - the same shape std/tls's Conn
//     already uses for its `err` field.
//   - Recursive parsers (DNS messages, MIME headers, HTTP framing) thread
//     an out-parameter `err &: NetError` through the call chain instead,
//     since a struct field would have to be threaded through every level
//     manually anyway - the same reasoning std/encoding/encerr documents
//     for its own out-param choice.

@en "KindNone"
@fa "بدون خطا"
@ar "لا خطأ"
pub const KindNone := 0

@en "KindTimeout"
@fa "اتمام مهلت"
@ar "انتهاء المهلة"
pub const KindTimeout := 1

@en "KindConnectionRefused"
@fa "اتصال رد شد"
@ar "رفض الاتصال"
pub const KindConnectionRefused := 2

@en "KindConnectionReset"
@fa "بازنشانی اتصال"
@ar "إعادة تعیین الاتصال"
pub const KindConnectionReset := 3

@en "KindHostUnreachable"
@fa "میزبان غیرقابل دسترس"
@ar "المضیف غیر قابل للوصول"
pub const KindHostUnreachable := 4

@en "KindAddressInUse"
@fa "نشانی در حال استفاده"
@ar "العنوان قید الاستخدام"
pub const KindAddressInUse := 5

@en "KindProtocolError"
@fa "خطای پروتکل"
@ar "خطأ فی البروتوکول"
pub const KindProtocolError := 6

@en "KindDNSFailure"
@fa "خطای دی ان اس"
@ar "خطأ فی نظام DNS"
pub const KindDNSFailure := 7

@en "KindWouldBlock"
@fa "مسدود می‌شد"
@ar "سیحجب العملیة"
pub const KindWouldBlock := 8

@en "KindClosed"
@fa "بسته شده"
@ar "مغلق"
pub const KindClosed := 9

@en "KindInvalidArgument"
@fa "آرگومان نامعتبر"
@ar "معامل غیر صالح"
pub const KindInvalidArgument := 10

@en "NetError"
@fa "خطای شبکه"
@ar "خطأ الشبکة"
pub struct NetError:
    pub kind: int = 0
    pub message: str = ""
    pub sys_errno: int = 0
end

@en "None"
@fa "بدون خطا"
@ar "بلا خطأ"
pub func None(): NetError:
    ret NetError { kind = KindNone, message = "", sys_errno = 0 }
end

@en "New"
@fa "خطای جدید"
@ar "خطأ جدید"
pub func New(kind: int, message: str): NetError:
    ret NetError { kind = kind, message = message, sys_errno = 0 }
end

@en "NewSys"
@fa "خطای سیستمی جدید"
@ar "خطأ نظام جدید"
pub func NewSys(kind: int, message: str, sys_errno: int): NetError:
    ret NetError { kind = kind, message = message, sys_errno = sys_errno }
end

@en "IsError"
@fa "خطا است"
@ar "هل هو خطأ"
pub func IsError(e: NetError): bool:
    ret e.kind != KindNone
end

@en "IsTimeout"
@fa "اتمام مهلت است"
@ar "هل هی مهلة"
pub func IsTimeout(e: NetError): bool:
    ret e.kind == KindTimeout
end

@en "IsRefused"
@fa "رد شده است"
@ar "هل مرفوض"
pub func IsRefused(e: NetError): bool:
    ret e.kind == KindConnectionRefused
end

@en "IsClosed"
@fa "بسته شده است"
@ar "هل مغلق"
pub func IsClosed(e: NetError): bool:
    ret e.kind == KindClosed
end

@en "IsWouldBlock"
@fa "در حال مسدودشدن است"
@ar "هل سیحجب"
pub func IsWouldBlock(e: NetError): bool:
    ret e.kind == KindWouldBlock
end

@en "KindName"
@fa "نام نوع خطا"
@ar "اسم نوع الخطأ"
pub func KindName(kind: int): str:
    if kind == KindNone: ret "none" end
    if kind == KindTimeout: ret "timeout" end
    if kind == KindConnectionRefused: ret "connection_refused" end
    if kind == KindConnectionReset: ret "connection_reset" end
    if kind == KindHostUnreachable: ret "host_unreachable" end
    if kind == KindAddressInUse: ret "address_in_use" end
    if kind == KindProtocolError: ret "protocol_error" end
    if kind == KindDNSFailure: ret "dns_failure" end
    if kind == KindWouldBlock: ret "would_block" end
    if kind == KindClosed: ret "closed" end
    if kind == KindInvalidArgument: ret "invalid_argument" end
    ret "unknown"
end

@en "String"
@fa "متن"
@ar "نص"
pub func String(e: NetError): str:
    if e.kind == KindNone: ret "" end
    ret KindName(e.kind) + ": " + e.message
end
