@en "internal"
@fa "داخلی"
@ar "داخلي"
package internal

// Same role as std/net/net.salam: a pure i18n anchor, not an
// implementation - see that file's header comment for why a directory
// with no package file of its own can't be reached by a localized (fa/
// ar) dotted import, only by English's direct path-based fallback.
// net/internal has no package file naming just "internal" (it is purely
// a grouping directory for rawsock/netbuf/nettls/poller/errors), so
// without this stub `net.internal.rawsock` - the raw-socket access
// several protocol-level tests need - has no fa/ar path at all.
