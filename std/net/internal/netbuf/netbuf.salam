@en "net/internal/netbuf"
@fa "بافر داخلی شبکه"
@ar "مخزن الشبکة الداخلی"
package netbuf

import mem
import compress

@en "Buffer"
@fa "بافر"
@ar "مخزن"
pub struct Buffer:
    pub data: compress.ByteBuf = compress.ByteBuf {}
    pub r: int = 0
end

@en "New"
@fa "بافر جدید"
@ar "مخزن جدید"
pub func New(): Buffer:
    mut b := Buffer {}
    b.data = compress.NewByteBuf()
    ret b
end

@en "NewCap"
@fa "بافر جدید با ظرفیت"
@ar "مخزن جدید بسعة"
pub func NewCap(capacity: int): Buffer:
    mut b := Buffer {}
    b.data = compress.NewByteBufCap(capacity)
    ret b
end

@en "Free"
@fa "آزادسازی بافر"
@ar "تحریر المخزن"
pub func Free(b &: Buffer):
    compress.BufFree(b.data)
    b.r = 0
end

@en "Reset"
@fa "بازنشانی بافر"
@ar "إعادة تعیین المخزن"
pub func Reset(b &: Buffer):
    compress.BufReset(b.data)
    b.r = 0
end

@en "WriteBytes"
@fa "نوشتن بایت‌ها"
@ar "کتابة البایتات"
pub func WriteBytes(b &: Buffer, p: void*, n: int):
    compress.BufPushBytes(b.data, p, n)
end

@en "WriteStr"
@fa "نوشتن رشته"
@ar "کتابة النص"
pub func WriteStr(b &: Buffer, s: str):
    compress.BufPushBytes(b.data, s as void*, s.len())
end

@en "WriteBuf"
@fa "نوشتن بافر"
@ar "کتابة المخزن"
pub func WriteBuf(b &: Buffer, src: compress.ByteBuf):
    compress.BufPushBuf(b.data, src)
end

@en "Unread"
@fa "بایت‌های خوانده‌نشده"
@ar "البایتات غیر المقروءة"
pub func Unread(b: Buffer): int:
    ret b.data.len - b.r
end

@en "Available"
@fa "ظرفیت باقی‌مانده"
@ar "السعة المتبقیة"
pub func Available(b: Buffer): int:
    ret b.data.cap - b.data.len
end

@en "Peek"
@fa "پیش‌نمایش بدون مصرف"
@ar "معاینة دون استهلاک"
pub func Peek(b: Buffer, n: int): compress.ByteBuf:
    mut take := n
    avail := Unread(b)
    if take > avail: take = avail end
    if take < 0: take = 0 end
    mut out := compress.NewByteBufCap(take)
    if take > 0:
        src := (b.data.data as i64 + b.r) as void*
        compress.BufPushBytes(out, src, take)
    end
    ret out
end

@en "ReadN"
@fa "خواندن بایت‌ها"
@ar "قراءة البایتات"
pub func ReadN(b &: Buffer, n: int): compress.ByteBuf:
    out := Peek(b, n)
    b.r += out.len
    ret out
end

@en "Consume"
@fa "مصرف بایت‌ها"
@ar "استهلاک البایتات"
pub func Consume(b &: Buffer, n: int):
    mut c := n
    avail := Unread(b)
    if c > avail: c = avail end
    if c < 0: c = 0 end
    b.r += c
end

@en "Compact"
@fa "فشرده‌سازی بافر"
@ar "ضغط المخزن"
pub func Compact(b &: Buffer):
    if b.r == 0: ret end
    remaining := b.data.len - b.r
    if remaining > 0:
        dst := b.data.data
        src := (b.data.data as i64 + b.r) as void*
        mem.MemMove(dst, src, remaining as u64)
    end
    b.data.len = remaining
    b.r = 0
end
