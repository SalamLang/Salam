@en "net/internal/nettls"
@fa "لایه تی ال اس شبکه"
@ar "طبقة TLS للشبکة"
package nettls

import tls

@en "NewConfig"
@fa "پیکربندی جدید"
@ar "إعداد جدید"
pub func NewConfig(server_name: str): tls.Config:
    ret tls.NewConfig(server_name)
end

@en "Dial"
@fa "شماره گیری امن"
@ar "اتصال آمن"
pub func Dial(host: str, port: int, cfg: tls.Config): tls.Conn:
    ret tls.Dial(host, port, cfg)
end

@en "WrapClient"
@fa "پوشش کارخواه"
@ar "تغليف العميل"
pub func WrapClient(fd: i64, cfg: tls.Config): tls.Conn:
    ret tls.WrapClient(fd, cfg)
end

@en "ConnOk"
@fa "اتصال معتبر"
@ar "الاتصال صالح"
pub func ConnOk(c: tls.Conn): bool:
    ret tls.ConnOk(c)
end

@en "ConnError"
@fa "خطای اتصال"
@ar "خطأ الاتصال"
pub func ConnError(c: tls.Conn): str:
    ret tls.ConnError(c)
end

@en "Write"
@fa "نوشتن"
@ar "کتابة"
pub func Write(c &: tls.Conn, data: str): int:
    ret tls.Write(c, data)
end

@en "WriteBytes"
@fa "نوشتن بایت"
@ar "کتابة بایتات"
pub func WriteBytes(c &: tls.Conn, ptr: void*, n: int): int:
    ret tls.WriteBytes(c, ptr, n)
end

@en "Read"
@fa "خواندن"
@ar "قراءة"
pub func Read(c &: tls.Conn, max: int): str:
    ret tls.Read(c, max)
end

@en "ReadBytes"
@fa "خواندن بایت"
@ar "قراءة بایتات"
pub func ReadBytes(c &: tls.Conn, buf: void*, max: int): int:
    ret tls.ReadBytes(c, buf, max)
end

@en "Close"
@fa "بستن"
@ar "إغلاق"
pub func Close(c &: tls.Conn):
    tls.Close(c)
end
