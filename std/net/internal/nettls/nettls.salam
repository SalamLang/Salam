@en "net/internal/nettls"
@fa "لایه تی ال اس شبکه"
@ar "طبقة TLS للشبکة"
package nettls

import tls

// Re-exports std/tls's client-dial API (Config/Conn/NewConfig/Dial, plus
// the Conn read/write/close operations) under the net/internal layer, so
// net/tcp, net/http, net/websocket and net/email all route their TLS
// upgrades through `net.internal.nettls` instead of reaching into
// std/tls directly - matching the spec's net/internal/tls layering.
//
// This is intentional reuse of std/tls's native, from-scratch TLS 1.2/1.3
// stack (client AND server, ~10,900 lines, its own EXPERIMENTAL/not-
// independently-audited banner already applies transitively here), not a
// prohibited "thin wrapper over another stack" - it's DRY over Salam's
// own implementation rather than reimplementing crypto a second time.
//
// One real limitation, not a style choice: Salam has no type-alias
// mechanism for struct types across packages (`pub type X = int` works
// for primitives - see compiler/interp.salam - but not for structs), so
// a caller that needs to *name* `tls.Conn`/`tls.Config` in its own
// variable/field declarations still needs `import tls` directly; this
// package only saves the *call sites* for the operations below. Server-
// side identity loading (`tls.ServerConfig`/`NewServerConfig`/
// `WrapServer`) is not re-exported here at all: `ServerConfig` is a
// non-`pub` struct in std/tls (see std/tls/serverdriver.salam), so it
// cannot be named in another package's function signature - server code
// (net/http's ServeTLS, net/websocket's wss upgrade, ...) imports
// std/tls directly for that piece.

@en "NewConfig"
@fa "پیکربندی جدید"
@ar "إعداد جدید"
pub func NewConfig(server_name: str): tls.Config:
    ret tls.NewConfig(server_name)
end

@en "Dial"
@fa "شماره گیری امن"
@ar "اتصال آمن"
pub func Dial(host: str, port: int, cfg: tls.Config): tls.Conn:
    ret tls.Dial(host, port, cfg)
end

@en "WrapClient"
@fa "پوشش کارخواه"
@ar "تغليف العميل"
pub func WrapClient(fd: i64, cfg: tls.Config): tls.Conn:
    ret tls.WrapClient(fd, cfg)
end

@en "ConnOk"
@fa "اتصال معتبر"
@ar "الاتصال صالح"
pub func ConnOk(c: tls.Conn): bool:
    ret tls.ConnOk(c)
end

@en "ConnError"
@fa "خطای اتصال"
@ar "خطأ الاتصال"
pub func ConnError(c: tls.Conn): str:
    ret tls.ConnError(c)
end

@en "Write"
@fa "نوشتن"
@ar "کتابة"
pub func Write(c &: tls.Conn, data: str): int:
    ret tls.Write(c, data)
end

@en "WriteBytes"
@fa "نوشتن بایت"
@ar "کتابة بایتات"
pub func WriteBytes(c &: tls.Conn, ptr: void*, n: int): int:
    ret tls.WriteBytes(c, ptr, n)
end

@en "Read"
@fa "خواندن"
@ar "قراءة"
pub func Read(c &: tls.Conn, max: int): str:
    ret tls.Read(c, max)
end

@en "ReadBytes"
@fa "خواندن بایت"
@ar "قراءة بایتات"
pub func ReadBytes(c &: tls.Conn, buf: void*, max: int): int:
    ret tls.ReadBytes(c, buf, max)
end

@en "Close"
@fa "بستن"
@ar "إغلاق"
pub func Close(c &: tls.Conn):
    tls.Close(c)
end
