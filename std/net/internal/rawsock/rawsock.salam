@en "LocalPort"
@fa "درگاه محلی"
pub func LocalPort(s: Socket): int:
    buf := mem.Allocate(16 as u64)
    defer mem.Free(buf)
    lenbuf := mem.Allocate(4 as u64)
    defer mem.Free(lenbuf)
    lenbuf32 := lenbuf as int*
    lenbuf32[0] = 16
    mut ok := 0 - 1
    if SALAM_OS_WINDOWS:
        ok = getsockname(_sk(s.fd), buf, lenbuf)
    else:
        ok = getsockname(s.fd as int, buf, lenbuf)
    end
    if ok != 0: ret 0 end
    bp := buf as i8*
    mut hi := bp[2] as int
    mut lo := bp[3] as int
    if hi < 0: hi += 256 end
    if lo < 0: lo += 256 end
    ret hi * 256 + lo
end

@en "Accept"
@fa "پذیرش"
pub func Accept(server: Socket): Socket:
    if SALAM_OS_WINDOWS:
        c := _fd_of(accept(_sk(server.fd), null, null))
        if c == (0 - 1 as i64): ret Socket { fd = 0 - 1, family = server.family } end
        ret Socket { fd = c, family = server.family }
    else:
        c := accept(server.fd as int, null, null)
        if c == 0 - 1: ret Socket { fd = 0 - 1, family = server.family } end
        _no_sigpipe(c as i64)
        ret Socket { fd = c as i64, family = server.family }
    end
end

