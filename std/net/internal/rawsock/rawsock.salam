@en "OpenDual"
@fa "باز کردن دوگانه"
pub func OpenDual(socktype: int): Socket:
    s := Open(AF_INET6, socktype)
    if s.fd >= 0:
        if _set_v6only(s.fd, false) == 0:
            ret s
        end
        Close(s)
    end
    ret Open(AF_INET, socktype)
end

