    end
    ret Open(AF_INET, socktype)
end

@en "IsIPv6"
@fa "آی‌پی۶ است"
pub func IsIPv6(host: str): bool:
    h := _strip_brackets(host)
    if not _is_v6_text(h):
        ret false
    end
    if _has_char(h, 37):
        ret true
    end
    raw := mem.AllocateZeroed(16 as u64)
    defer mem.Free(raw)
    ret _parse_ip6(h, raw as u8*)
end

@en "IsIPv4"
@fa "آی‌پی۴ است"
pub func IsIPv4(host: str): bool:
    raw := mem.AllocateZeroed(4 as u64)
    defer mem.Free(raw)
    ret _parse_ip4(host, raw as u8*)
end

@en "CanonIP"
@fa "نشانی استاندارد"
pub func CanonIP(host: str): str:
    h := _strip_brackets(host)
    if _is_v6_text(h) and not _has_char(h, 37):
        raw := mem.AllocateZeroed(16 as u64)
        defer mem.Free(raw)
        if _parse_ip6(h, raw as u8*):
            ret _fmt_ip6(raw as u8*, 0)
        end
    end
    ret str.Clone(h)
end

@en "HostPort"
@fa "میزبان و درگاه"
pub func HostPort(host: str, port: int): str:
    h := CanonIP(host)
    if _is_v6_text(h):
        ret "[" + h + "]:" + port
    end
    ret h + ":" + port
end

@en "V6Prefix"
@fa "پیشوند آی‌پی۶"
pub func V6Prefix(host: str, bits: int): str:
    h := _strip_brackets(host)
    if not _is_v6_text(h):
        ret str.Clone(h)
    end
    mut z := h
    if _has_char(h, 37):
        mut cut := 0
        repeat h.len() in i:
            if (h as u8*)[i] == 37 and cut == 0:
                cut = i
            end
        end
        z = h.substr(0, cut)
    end
    raw := mem.AllocateZeroed(16 as u64)
    defer mem.Free(raw)
    b := raw as u8*
    if not _parse_ip6(z, b):
        ret str.Clone(h)
    end
    mut keep := bits
    if keep < 0:
        keep = 0
    end
    if keep > 128:
        keep = 128
    end
    repeat 16 in k:
        lo := k * 8
        if lo >= keep:
            b[k] = 0 as u8
        else keep - lo < 8:
            mask := (255 << (8 - (keep - lo))) & 255
            b[k] = ((b[k] as int) & mask) as u8
        end
    end
    ret _fmt_ip6(b, 0)
end

@en "HexIPv6"
@fa "هگزا آی‌پی۶"
pub func HexIPv6(host: str): str:
    h := _strip_brackets(host)
    if not _is_v6_text(h) or _has_char(h, 37):
        ret ""
    end
    raw := mem.AllocateZeroed(16 as u64)
    defer mem.Free(raw)
    b := raw as u8*
    if not _parse_ip6(h, b):
        ret ""
    end
    d := "0123456789abcdef"
    mut out := ""
    repeat 16 in i:
        v := b[i] as int
        out += d.substr(v >> 4, 1) + d.substr(v & 15, 1)
    end
    ret out
end

@en "ResolveAny"
@fa "تفکیک نشانی هر خانواده"
pub func ResolveAny(host: str): str:
    if SALAM_OS_WINDOWS:
        _net_init()
    end
    mut alen := 0
    sa := _sockaddr_for(host, 0, alen)
    if sa == null:
        ret ""
    end
    mut pp := 0
    t := _sa_text(sa, pp)
    mem.Free(sa)
    ret t
end

@en "Resolve6"
@fa "تفکیک نشانی آی‌پی۶"
pub func Resolve6(host: str): str:
    if SALAM_OS_WINDOWS:
        _net_init()
    end
    mut alen := 0
    h := _strip_brackets(host)
    if h.len() == 0:
        ret ""
    end
    if IsIPv4(h):
        ret ""
    end
    sa := _first_sockaddr(h, 0, AF_INET6, alen)
    if sa == null:
        ret ""
    end
    mut pp := 0
    t := _sa_text(sa, pp)
    mem.Free(sa)
    ret t
end

@en "Send"
@fa "ارسال"
pub func Send(sock: Socket, data: str): int:
    n := data.len()
    ptr := data as void*
    mut sent := 0
    until sent < n:
        mut r := 0
        if SALAM_OS_WINDOWS:
            r = send(_sk(sock.fd), (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
        else:
            r = send(sock.fd as int, (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
        end
        if r <= 0:
            if sent > 0: ret sent end
            ret r
        end
        sent += r
    end
    ret sent
end

@en "SendBytes"
@fa "ارسال بایت"
pub func SendBytes(sock: Socket, ptr: void*, n: int): int:
    if SALAM_OS_WINDOWS:
        mut sent := 0
        until sent < n:
            r := send(_sk(sock.fd), (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
            if r <= 0: ret sent end
            sent += r
        end
        ret sent
    else:
        mut sent := 0
        until sent < n:
            r := send(sock.fd as int, (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
            if r <= 0: ret sent end
            sent += r
        end
        ret sent
    end
end

