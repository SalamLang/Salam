    buf := mem.Allocate((m + 1) as u64)
    defer mem.Free(buf)
    memset(buf, 0, (m + 1) as u64)
    if SALAM_OS_WINDOWS:
        recv(_sk(sock.fd), buf, m, 0)
    else:
        recv(sock.fd as int, buf, m, 0)
    end
    ret str.Clone(buf as str)
end

