@en "Open"
@fa "باز کردن سوکت"
pub func Open(family: int, socktype: int): Socket:
    if SALAM_OS_WINDOWS:
        _net_init()
    end
    if SALAM_OS_WINDOWS:
        s := _fd_of(socket(family, socktype, 0))
        ret Socket { fd = s, family = family }
    else:
        s := socket(family, socktype, 0)
        _no_sigpipe(s as i64)
        ret Socket { fd = s as i64, family = family }
    end
end

@en "Connect"
@fa "اتصال"
pub func Connect(host: str, port: int): Socket:
    ret ConnectProto(host, port, SOCK_STREAM)
end

@en "ConnectTimeout"
@fa "اتصال با مهلت"
pub func ConnectTimeout(host: str, port: int, millis: int): Socket:
    if millis <= 0 or not SALAM_OS_LINUX:
        ret Connect(host, port)
    end
    mut addrs := Vector {} as Vector<i64>
    mut lens := Vector {} as Vector<int>
    mut fams := Vector {} as Vector<int>
    _resolve_all(host, port, 0, SOCK_STREAM, addrs, lens, fams)
    mut order := _interleave(fams)
    mut out := Socket { fd = 0 - 1, family = AF_INET }
    if SALAM_OS_LINUX:
        out = _race_connect(addrs, lens, fams, order, millis)
    end
    repeat addrs.len() in i:
        mem.Free(addrs.get(i) as void*)
    end
    order.free()
    addrs.free()
    lens.free()
    fams.free()
    ret out
end

@en "ConnectAnyTimeout"
@fa "اتصال به یکی از چند نشانی"
pub func ConnectAnyTimeout(hosts &: Vector<str>, port: int, millis: int): Socket:
    if SALAM_OS_WINDOWS:
        _net_init()
    end
    mut addrs := Vector {} as Vector<i64>
    mut lens := Vector {} as Vector<int>
    mut fams := Vector {} as Vector<int>
    repeat hosts.len() in i:
        mut alen := 0
        sa := _sockaddr_for(hosts.get(i), port, alen)
        if sa != null:
            addrs.push(sa as i64)
            lens.push(alen)
            fams.push(_sa_family(sa))
        end
    end
    mut order := _interleave(fams)
    mut out := Socket { fd = 0 - 1, family = AF_INET }
    if SALAM_OS_LINUX:
        mut wait := millis
        if wait <= 0:
            wait = 10000
        end
        out = _race_connect(addrs, lens, fams, order, wait)
    else:
        repeat order.len() in j:
            if out.fd < 0:
                k := order.get(j)
                out = _try_connect(addrs.get(k) as void*, lens.get(k), fams.get(k), SOCK_STREAM)
            end
        end
    end
    repeat addrs.len() in i:
        mem.Free(addrs.get(i) as void*)
    end
    order.free()
    addrs.free()
    lens.free()
    fams.free()
    ret out
end

@en "ConnectProto"
@fa "اتصال با نوع"
pub func ConnectProto(host: str, port: int, socktype: int): Socket:
    if SALAM_OS_WINDOWS:
        _net_init()
    end
    mut addrs := Vector {} as Vector<i64>
    mut lens := Vector {} as Vector<int>
    mut fams := Vector {} as Vector<int>
    _resolve_all(host, port, 0, socktype, addrs, lens, fams)
    mut out := Socket { fd = 0 - 1, family = AF_INET }
    repeat addrs.len() in i:
        if out.fd < 0:
            out = _try_connect(addrs.get(i) as void*, lens.get(i), fams.get(i), socktype)
        end
        mem.Free(addrs.get(i) as void*)
    end
    addrs.free()
    lens.free()
    fams.free()
    ret out
end

