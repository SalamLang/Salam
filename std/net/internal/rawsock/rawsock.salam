@en "net/internal/rawsock"
@fa "سوکت خام"
package rawsock

import mem
import str
import sync

if SALAM_OS_WINDOWS:
    link dynamic "ws2_32"
end

extern:
    func memset(ptr: void*, val: int, n: u64): void*
    func memcpy(dst: void*, src: void*, n: u64): void*
    func htons(n: int): int
    func ntohs(n: int): int
    func inet_ntoa(addr: int): str
end

if SALAM_OS_WINDOWS:
    extern:
        func WSAStartup(version: int, wsa: void*): int
        func socket(family: int, socktype: int, proto: int): usize
        func connect(s: usize, addr: void*, addrlen: int): int
        func bind(s: usize, addr: void*, addrlen: int): int
        func listen(s: usize, backlog: int): int
        func accept(s: usize, addr: void*, addrlen: void*): usize
        func send(s: usize, buf: void*, len: int, flags: int): int
        func recv(s: usize, buf: void*, len: int, flags: int): int
        func sendto(s: usize, buf: void*, len: int, flags: int, addr: void*, addrlen: int): int
        func recvfrom(s: usize, buf: void*, len: int, flags: int, addr: void*, addrlen: void*): int
        func closesocket(s: usize): int
        func shutdown(s: usize, how: int): int
        func setsockopt(s: usize, level: int, optname: int, optval: void*, optlen: int): int
        func getsockname(s: usize, addr: void*, addrlen: void*): int
        func getpeername(s: usize, addr: void*, addrlen: void*): int
        func ioctlsocket(s: usize, cmd: int, argp: void*): int
        func getaddrinfo(node: str, service: str, hints: void*, res: void*): int
        func freeaddrinfo(res: void*)
        func gethostbyname(name: str): void*
        func WSAPoll(fds: void*, nfds: u32, timeout: int): int
    end
else:
    extern:
        func socket(family: int, socktype: int, proto: int): int
        func connect(s: int, addr: void*, addrlen: int): int
        func bind(s: int, addr: void*, addrlen: int): int
        func listen(s: int, backlog: int): int
        func accept(s: int, addr: void*, addrlen: void*): int
        func send(s: int, buf: void*, len: int, flags: int): int
        func recv(s: int, buf: void*, len: int, flags: int): int
        func sendto(s: int, buf: void*, len: int, flags: int, addr: void*, addrlen: int): int
        func recvfrom(s: int, buf: void*, len: int, flags: int, addr: void*, addrlen: void*): int
        func close(s: int): int
        func shutdown(s: int, how: int): int
        func setsockopt(s: int, level: int, optname: int, optval: void*, optlen: int): int
        func getsockname(s: int, addr: void*, addrlen: void*): int
        func getpeername(s: int, addr: void*, addrlen: void*): int
        func fcntl(s: int, cmd: int, ...): int
        func getaddrinfo(node: str, service: str, hints: void*, res: void*): int
        func freeaddrinfo(res: void*)
        func gethostbyname(name: str): void*
        func poll(fds: void*, nfds: usize, timeout: int): int
    end
end

if SALAM_OS_WINDOWS:
    const _SEND_FLAGS := 0
else SALAM_OS_MAC:
    const _SEND_FLAGS := 0
else SALAM_OS_FREEBSD:
    const _SEND_FLAGS := 131072
else SALAM_OS_OPENBSD or SALAM_OS_NETBSD:
    const _SEND_FLAGS := 1024
else:
    const _SEND_FLAGS := 16384
end

@en "AF_INET"
@fa "خانواده آی‌پی۴"
pub const AF_INET := 2
@en "SOCK_STREAM"
@fa "سوکت جریانی"
pub const SOCK_STREAM := 1
@en "SOCK_DGRAM"
@fa "سوکت داده‌نگاری"
pub const SOCK_DGRAM := 2

if SALAM_OS_WINDOWS:
    @en "AF_INET6"
    @fa "خانواده آی‌پی۶"
    pub const AF_INET6 := 23
else SALAM_OS_MAC:
    @en "AF_INET6"
    @fa "خانواده آی‌پی۶"
    pub const AF_INET6 := 30
else SALAM_OS_FREEBSD:
    @en "AF_INET6"
    @fa "خانواده آی‌پی۶"
    pub const AF_INET6 := 28
else SALAM_OS_OPENBSD or SALAM_OS_NETBSD:
    @en "AF_INET6"
    @fa "خانواده آی‌پی۶"
    pub const AF_INET6 := 24
else:
    @en "AF_INET6"
    @fa "خانواده آی‌پی۶"
    pub const AF_INET6 := 10
end

@en "ShutRd"
@fa "بستن خواندن"
pub const ShutRd := 0
@en "ShutWr"
@fa "بستن نوشتن"
pub const ShutWr := 1
@en "ShutRdWr"
@fa "بستن دوطرفه"
pub const ShutRdWr := 2

const _SHUT_BOTH := 2

const _IPPROTO_IPV6 := 41

if SALAM_OS_LINUX:
    const _IPV6_V6ONLY := 26
else:
    const _IPV6_V6ONLY := 27
end

if SALAM_OS_WINDOWS:
    mut _rawsock_wsa_init := 0
end

@en "Socket"
@fa "سوکت"
pub struct Socket:
    pub fd: i64 = 0 - 1
    pub family: int = AF_INET
end

if SALAM_OS_WINDOWS:
    func _net_init():
        if _rawsock_wsa_init == 0:
            wsa := mem.Allocate(512 as u64)
            WSAStartup(514, wsa)
            mem.Free(wsa)
            _rawsock_wsa_init = 1
        end
    end
end

func _sk(fd: i64): usize:
    ret fd as usize
end

func _fd_of(s: usize): i64:
    if s == (0 - 1) as usize: ret 0 - 1 end
    ret s as i64
end

func _hostent_addr4(he: void*): int:
    pw := sizeof(void*) as i64
    mut lo := 2 * pw + 8
    if SALAM_OS_WINDOWS:
        lo = (2 * pw + 4 + pw - 1) / pw * pw
    end
    listp := (he as i64 + lo) as usize*
    list := listp[0]
    if list == (0 as usize): ret 0 end
    addrp := list as usize*
    addr := addrp[0]
    if addr == (0 as usize): ret 0 end
    bytes := addr as int*
    ret bytes[0]
end

func _resolve_addr4(host: str): int:
    he := gethostbyname(host)
    if he == null: ret 0 end
    ret _hostent_addr4(he)
end

func _ai_family(ai: void*): int: ret ((ai as i64 + 4) as int*)[0] end
func _ai_addrlen(ai: void*): i64:
    if SALAM_OS_WINDOWS and sizeof(void*) == 8:
        ret ((ai as i64 + 16) as i64*)[0]
    else:
        ret ((ai as i64 + 16) as int*)[0]
    end
end
func _ai_ptr(ai: void*, slot: int): void*:
    pw := sizeof(void*) as i64
    ret ((ai as i64 + 16 + pw * (slot as i64)) as usize*)[0] as void*
end
func _ai_addr(ai: void*): void*:
    if SALAM_OS_LINUX:
        ret _ai_ptr(ai, 1)
    else:
        ret _ai_ptr(ai, 2)
    end
end
func _ai_next(ai: void*): void*: ret _ai_ptr(ai, 3) end

func _try_connect(sa: void*, alen: int, fam: int, socktype: int): Socket:
    if SALAM_OS_WINDOWS:
        s := _fd_of(socket(fam, socktype, 0))
        if s == (0 - 1 as i64):
            ret Socket { fd = 0 - 1, family = fam }
        end
        if connect(_sk(s), sa, alen) != 0:
            closesocket(_sk(s))
            ret Socket { fd = 0 - 1, family = fam }
        end
        ret Socket { fd = s, family = fam }
    else:
        s := socket(fam, socktype, 0)
        if s == 0 - 1:
            ret Socket { fd = 0 - 1, family = fam }
        end
        if connect(s, sa, alen) != 0:
            close(s)
            ret Socket { fd = 0 - 1, family = fam }
        end
        _no_sigpipe(s as i64)
        ret Socket { fd = s as i64, family = fam }
    end
end

func _resolve_all(host: str, port: int, family: int, socktype: int, addrs &: Vector<i64>, lens &: Vector<int>, fams &: Vector<int>):
    hints := mem.Allocate(48 as u64)
    defer mem.Free(hints)
    memset(hints, 0, 48 as u64)
    hp := hints as int*
    hp[1] = family
    hp[2] = socktype
    res_slot := mem.Allocate(8 as u64)
    defer mem.Free(res_slot)
    rp := res_slot as i64*
    rp[0] = 0
    port_str := str.FromInt(port as i64)
    defer mem.Free(port_str as void*)
    if getaddrinfo(_strip_brackets(host), port_str, hints, res_slot) != 0:
        ret
    end
    res := rp[0] as void*
    if res == null:
        ret
    end
    defer freeaddrinfo(res)
    mut cur := res
    until cur != null:
        mut alen := 0
        sa := _copy_sockaddr(cur, alen)
        addrs.push(sa as i64)
        lens.push(alen)
        fams.push(_ai_family(cur))
        cur = _ai_next(cur)
    end
end

func _copy_sockaddr(ai: void*, out_len &: int): void*:
    alen := _ai_addrlen(ai) as int
    addr := _ai_addr(ai)
    out := mem.Allocate(alen as u64)
    memcpy(out, addr, alen as u64)
    out_len = alen
    ret out
end

func _no_sigpipe(fd: i64):
    if fd < 0:
        ret
    end
    if SALAM_OS_MAC:
        opt := mem.Allocate(4 as u64)
        defer mem.Free(opt)
        o32 := opt as int*
        o32[0] = 1
        setsockopt(fd as int, 65535, 4130, opt, 4)
    end
end

func _sa_family(sa: void*): int:
    b := sa as u8*
    if SALAM_OS_MAC or SALAM_OS_BSD:
        ret b[1] as int
    end
    ret b[0] as int
end

func _is_v6_text(h: str): bool:
    p := h as u8*
    n := h.len()
    repeat n in i:
        if p[i] == 58:
            ret true
        end
    end
    ret false
end

func _has_char(h: str, c: int): bool:
    p := h as u8*
    n := h.len()
    repeat n in i:
        if (p[i] as int) == c:
            ret true
        end
    end
    ret false
end

func _strip_brackets(h: str): str:
    n := h.len()
    if n >= 2:
        p := h as u8*
        if p[0] == 91 and p[n - 1] == 93:
            ret h.substr(1, n - 2)
        end
    end
    ret h
end

func _hexval(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    if c >= 65 and c <= 70:
        ret c - 55
    end
    ret 0 - 1
end

func _parse_ip4(h: str, out: u8*): bool:
    p := h as u8*
    n := h.len()
    if n < 7 or n > 15:
        ret false
    end
    mut part := 0
    mut digits := 0
    mut idx := 0
    mut i := 0
    until i < n:
        c := p[i] as int
        if c >= 48 and c <= 57:
            part = part * 10 + (c - 48)
            digits++
            if part > 255 or digits > 3:
                ret false
            end
        else c == 46:
            if digits == 0 or idx >= 3:
                ret false
            end
            out[idx] = part as u8
            idx++
            part = 0
            digits = 0
        else:
            ret false
        end
        i++
    end
    if digits == 0 or idx != 3:
        ret false
    end
    out[3] = part as u8
    ret true
end

func _parse_ip6(h: str, out: u8*): bool:
    p := h as u8*
    n := h.len()
    if n < 2 or n > 45:
        ret false
    end
    mut g := Vector {} as Vector<int>
    defer g.free()
    mut gap := 0 - 1
    mut i := 0
    if p[0] == 58:
        if p[1] != 58:
            ret false
        end
        gap = 0
        i = 2
    end
    until i < n:
        start := i
        mut v := 0
        mut nd := 0
        mut scanning := true
        until scanning:
            if i < n:
                hv := _hexval(p[i] as int)
                if hv >= 0:
                    v = v * 16 + hv
                    nd++
                    i++
                    if nd > 4:
                        ret false
                    end
                else:
                    scanning = false
                end
            else:
                scanning = false
            end
        end
        if nd == 0:
            ret false
        end
        if i < n and p[i] == 46:
            tail := h.substr(start, n - start)
            b4 := mem.AllocateZeroed(4 as u64)
            defer mem.Free(b4)
            if not _parse_ip4(tail, b4 as u8*):
                ret false
            end
            q := b4 as u8*
            g.push((q[0] as int) * 256 + (q[1] as int))
            g.push((q[2] as int) * 256 + (q[3] as int))
            i = n
        else:
            g.push(v)
            if i < n:
                if p[i] != 58:
                    ret false
                end
                i++
                if i >= n:
                    ret false
                end
                if p[i] == 58:
                    if gap >= 0:
                        ret false
                    end
                    gap = g.len()
                    i++
                end
            end
        end
    end
    total := g.len()
    if gap < 0:
        if total != 8:
            ret false
        end
    else:
        if total > 7:
            ret false
        end
    end
    repeat 16 in z:
        out[z] = 0 as u8
    end
    repeat total in k:
        mut pos := k
        if gap >= 0 and k >= gap:
            pos = k + (8 - total)
        end
        w := g.get(k)
        out[pos * 2] = (w / 256) as u8
        out[pos * 2 + 1] = (w % 256) as u8
    end
    ret true
end

func _hex16(v: int): str:
    d := "0123456789abcdef"
    mut s := ""
    mut started := false
    repeat 4 in j:
        sh := 12 - 4 * j
        nib := (v >> sh) & 15
        if nib != 0 or started or sh == 0:
            s += d.substr(nib, 1)
            started = true
        end
    end
    ret s
end

func _fmt_ip4(b: u8*): str:
    ret "" + (b[0] as int) + "." + (b[1] as int) + "." + (b[2] as int) + "." + (b[3] as int)
end

func _fmt_ip6(b: u8*, scope: int): str:
    mut mapped := true
    repeat 10 in z:
        if b[z] != 0:
            mapped = false
        end
    end
    if mapped and b[10] == 255 and b[11] == 255:
        ret "" + (b[12] as int) + "." + (b[13] as int) + "." + (b[14] as int) + "." + (b[15] as int)
    end
    mut best_s := 0 - 1
    mut best_l := 0
    mut cur_s := 0 - 1
    mut cur_l := 0
    repeat 8 in k:
        w := (b[k * 2] as int) * 256 + (b[k * 2 + 1] as int)
        if w == 0:
            if cur_s < 0:
                cur_s = k
                cur_l = 0
            end
            cur_l++
            if cur_l > best_l:
                best_l = cur_l
                best_s = cur_s
            end
        else:
            cur_s = 0 - 1
        end
    end
    if best_l < 2:
        best_s = 0 - 1
    end
    mut out := ""
    mut k := 0
    mut after_gap := false
    until k < 8:
        if k == best_s:
            out += "::"
            k += best_l
            after_gap = true
        else:
            if k > 0 and not after_gap:
                out += ":"
            end
            out += _hex16((b[k * 2] as int) * 256 + (b[k * 2 + 1] as int))
            after_gap = false
            k++
        end
    end
    if scope != 0 and b[0] == 254 and ((b[1] as int) & 192) == 128:
        out += "%" + scope
    end
    ret out
end

func _make_sa4(h_addr: int, port: int): void*:
    sa := mem.AllocateZeroed(16 as u64)
    b := sa as u8*
    if SALAM_OS_MAC or SALAM_OS_BSD:
        b[0] = 16 as u8
        b[1] = AF_INET as u8
    else:
        b[0] = AF_INET as u8
    end
    b[2] = (port / 256) as u8
    b[3] = (port % 256) as u8
    ((sa as i64 + 4) as int*)[0] = h_addr
    ret sa
end

func _make_sa6(addr: u8*, scope: int, port: int): void*:
    sa := mem.AllocateZeroed(28 as u64)
    b := sa as u8*
    if SALAM_OS_MAC or SALAM_OS_BSD:
        b[0] = 28 as u8
        b[1] = AF_INET6 as u8
    else:
        b[0] = AF_INET6 as u8
    end
    b[2] = (port / 256) as u8
    b[3] = (port % 256) as u8
    repeat 16 in i:
        b[8 + i] = addr[i]
    end
    ((sa as i64 + 24) as int*)[0] = scope
    ret sa
end

func _map4(sa4: void*, port: int): void*:
    addr := mem.AllocateZeroed(16 as u64)
    defer mem.Free(addr)
    a := addr as u8*
    a[10] = 255 as u8
    a[11] = 255 as u8
    src := (sa4 as i64 + 4) as u8*
    repeat 4 in i:
        a[12 + i] = src[i]
    end
    ret _make_sa6(a, 0, port)
end

func _sa_text(sa: void*, out_port &: int): str:
    b := sa as u8*
    fam := _sa_family(sa)
    out_port = (b[2] as int) * 256 + (b[3] as int)
    if fam == AF_INET:
        ret _fmt_ip4((sa as i64 + 4) as u8*)
    end
    if fam == AF_INET6:
        scope := ((sa as i64 + 24) as int*)[0]
        ret _fmt_ip6((sa as i64 + 8) as u8*, scope)
    end
    out_port = 0
    ret ""
end

func _first_sockaddr(host: str, port: int, family: int, out_len &: int): void*:
    mut addrs := Vector {} as Vector<i64>
    mut lens := Vector {} as Vector<int>
    mut fams := Vector {} as Vector<int>
    _resolve_all(host, port, family, SOCK_STREAM, addrs, lens, fams)
    mut found := null as void*
    out_len = 0
    repeat addrs.len() in i:
        a := addrs.get(i) as void*
        if found == null and (family == 0 or fams.get(i) == family):
            found = a
            out_len = lens.get(i)
        else:
            mem.Free(a)
        end
    end
    addrs.free()
    lens.free()
    fams.free()
    ret found
end

func _sockaddr_for(host: str, port: int, out_len &: int): void*:
    h := _strip_brackets(host)
    out_len = 0
    if h.len() == 0:
        ret null
    end
    if _is_v6_text(h):
        if _has_char(h, 37):
            ret _first_sockaddr(h, port, AF_INET6, out_len)
        end
        raw := mem.AllocateZeroed(16 as u64)
        defer mem.Free(raw)
        if not _parse_ip6(h, raw as u8*):
            ret null
        end
        out_len = 28
        ret _make_sa6(raw as u8*, 0, port)
    end
    q := mem.AllocateZeroed(4 as u64)
    defer mem.Free(q)
    if _parse_ip4(h, q as u8*):
        out_len = 16
        ret _make_sa4(((q as int*)[0]), port)
    end
    a4 := _resolve_addr4(h)
    if a4 != 0:
        out_len = 16
        ret _make_sa4(a4, port)
    end
    ret _first_sockaddr(h, port, AF_INET6, out_len)
end

func _sendto_raw(fd: i64, ptr: void*, n: int, sa: void*, alen: int): int:
    if SALAM_OS_WINDOWS:
        ret sendto(_sk(fd), ptr, n, 0, sa, alen)
    else:
        ret sendto(fd as int, ptr, n, 0, sa, alen)
    end
end

func _s_open(fam: int, socktype: int): i64:
    if SALAM_OS_WINDOWS:
        ret _fd_of(socket(fam, socktype, 0))
    else:
        ret socket(fam, socktype, 0)
    end
end

func _s_close(fd: i64):
    if fd < 0:
        ret
    end
    if SALAM_OS_WINDOWS:
        closesocket(_sk(fd))
    else:
        close(fd as int)
    end
end

func _s_bind(fd: i64, sa: void*, alen: int): int:
    if SALAM_OS_WINDOWS:
        ret bind(_sk(fd), sa, alen)
    else:
        ret bind(fd as int, sa, alen)
    end
end

func _s_listen(fd: i64): int:
    if SALAM_OS_WINDOWS:
        ret listen(_sk(fd), 128)
    else:
        ret listen(fd as int, 128)
    end
end

func _set_int_opt(fd: i64, level: int, name: int, val: int): int:
    opt := mem.Allocate(4 as u64)
    defer mem.Free(opt)
    (opt as int*)[0] = val
    if SALAM_OS_WINDOWS:
        ret setsockopt(_sk(fd), level, name, opt, 4)
    else:
        ret setsockopt(fd as int, level, name, opt, 4)
    end
end

func _set_v6only(fd: i64, flag: bool): int:
    mut v := 0
    if flag:
        v = 1
    end
    ret _set_int_opt(fd, _IPPROTO_IPV6, _IPV6_V6ONLY, v)
end

func _all_zero16(addr: u8*): bool:
    repeat 16 in i:
        if addr[i] != 0:
            ret false
        end
    end
    ret true
end

func _listen_sa(sa: void*, alen: int, fam: int, socktype: int, v6mode: int): Socket:
    s := _s_open(fam, socktype)
    if s < 0:
        ret Socket { fd = 0 - 1, family = fam }
    end
    if fam == AF_INET6 and v6mode >= 0:
        _set_v6only(s, v6mode == 1)
    end
    if not SALAM_OS_WINDOWS:
        if SALAM_OS_MAC or SALAM_OS_BSD:
            _set_int_opt(s, 65535, 4, 1)
        else:
            _set_int_opt(s, 1, 2, 1)
        end
    end
    if _s_bind(s, sa, alen) != 0:
        _s_close(s)
        ret Socket { fd = 0 - 1, family = fam }
    end
    if socktype == SOCK_STREAM:
        if _s_listen(s) != 0:
            _s_close(s)
            ret Socket { fd = 0 - 1, family = fam }
        end
    end
    ret Socket { fd = s, family = fam }
end

func _listen_v4(h_addr: int, port: int, socktype: int): Socket:
    sa := _make_sa4(h_addr, port)
    defer mem.Free(sa)
    ret _listen_sa(sa, 16, AF_INET, socktype, 0 - 1)
end

func _listen_host(host: str, port: int, socktype: int, v6mode: int): Socket:
    if SALAM_OS_WINDOWS:
        _net_init()
    end
    h := _strip_brackets(host)
    if h.len() == 0 or h == "0.0.0.0":
        ret _listen_v4(0, port, socktype)
    end
    mut alen := 0
    sa := _sockaddr_for(h, port, alen)
    if sa == null:
        ret Socket { fd = 0 - 1, family = AF_INET }
    end
    defer mem.Free(sa)
    if _sa_family(sa) == AF_INET:
        ret _listen_sa(sa, alen, AF_INET, socktype, 0 - 1)
    end
    wild := _all_zero16((sa as i64 + 8) as u8*)
    mut mode := v6mode
    if mode < 0:
        mode = 1
        if wild:
            mode = 0
        end
    end
    r := _listen_sa(sa, alen, AF_INET6, socktype, mode)
    if r.fd < 0 and wild and mode == 0:
        ret _listen_v4(0, port, socktype)
    end
    ret r
end

func _name_of(fd: i64, peer: bool, out_port &: int): str:
    out_port = 0
    if fd < 0:
        ret ""
    end
    slot := mem.AllocateZeroed(136 as u64)
    defer mem.Free(slot)
    lenp := mem.AllocateZeroed(8 as u64)
    defer mem.Free(lenp)
    (lenp as int*)[0] = 128
    mut rc := 0 - 1
    if SALAM_OS_WINDOWS:
        if peer:
            rc = getpeername(_sk(fd), slot, lenp)
        else:
            rc = getsockname(_sk(fd), slot, lenp)
        end
    else:
        if peer:
            rc = getpeername(fd as int, slot, lenp)
        else:
            rc = getsockname(fd as int, slot, lenp)
        end
    end
    if rc != 0:
        ret ""
    end
    ret _sa_text(slot, out_port)
end

func _connected(fd: int): bool:
    slot := mem.AllocateZeroed(136 as u64)
    defer mem.Free(slot)
    lenp := mem.AllocateZeroed(8 as u64)
    defer mem.Free(lenp)
    (lenp as int*)[0] = 128
    ret getpeername(fd, slot, lenp) == 0
end

func _interleave(fams &: Vector<int>): Vector<int>:
    n := fams.len()
    mut first := Vector {} as Vector<int>
    mut second := Vector {} as Vector<int>
    mut out := Vector {} as Vector<int>
    if n == 0:
        first.free()
        second.free()
        ret out
    end
    f0 := fams.get(0)
    repeat n in i:
        if fams.get(i) == f0:
            first.push(i)
        else:
            second.push(i)
        end
    end
    mut ia := 0
    mut ib := 0
    until ia < first.len() or ib < second.len():
        if ia < first.len():
            out.push(first.get(ia))
            ia++
        end
        if ib < second.len():
            out.push(second.get(ib))
            ib++
        end
    end
    first.free()
    second.free()
    ret out
end

if SALAM_OS_LINUX:
    func _race_connect(addrs &: Vector<i64>, lens &: Vector<int>, fams &: Vector<int>, order &: Vector<int>, millis: int): Socket:
        n := order.len()
        deadline := sync.NowMs() + (millis as i64)
        mut pend := Vector {} as Vector<int>
        mut win := 0 - 1
        mut next := 0
        mut next_at := sync.NowMs()
        mut active := true
        until active:
            now := sync.NowMs()
            if now >= deadline:
                active = false
            else next < n and (pend.len() == 0 or now >= next_at):
                k := order.get(next)
                next++
                next_at = now + 250
                fd := socket(fams.get(k), SOCK_STREAM, 0)
                if fd >= 0:
                    SetNonBlocking(Socket { fd = fd as i64, family = fams.get(k) }, true)
                    if connect(fd, addrs.get(k) as void*, lens.get(k)) == 0:
                        win = fd
                        active = false
                    else:
                        pend.push(fd)
                    end
                end
            else pend.len() == 0:
                active = false
            else:
                m := pend.len()
                pfds := mem.AllocateZeroed((m * 8) as u64)
                repeat m in j:
                    ((pfds as i64 + (j * 8) as i64) as i32*)[0] = pend.get(j)
                    ((pfds as i64 + (j * 8 + 4) as i64) as i16*)[0] = 4 as i16
                end
                mut wait := (deadline - now) as int
                if next < n:
                    gap := (next_at - now) as int
                    if gap < wait:
                        wait = gap
                    end
                end
                if wait < 1:
                    wait = 1
                end
                poll(pfds, m as usize, wait)
                mut j := m - 1
                until j >= 0:
                    rev := ((pfds as i64 + (j * 8 + 6) as i64) as i16*)[0] as int
                    if rev != 0:
                        fd := pend.get(j)
                        if win < 0 and _connected(fd):
                            win = fd
                        else:
                            close(fd)
                        end
                        pend.remove_at(j)
                    end
                    j--
                end
                mem.Free(pfds)
                if win >= 0:
                    active = false
                end
            end
        end
        repeat pend.len() in q:
            close(pend.get(q))
        end
        pend.free()
        if win < 0:
            ret Socket { fd = 0 - 1, family = AF_INET }
        end
        sock := Socket { fd = win as i64, family = AF_INET }
        SetNonBlocking(sock, false)
        _no_sigpipe(win as i64)
        ret sock
    end
end

@en "FromFd"
@fa "سوکت از توصیف‌گر"
pub func FromFd(fd: i64): Socket:
    ret Socket { fd = fd, family = AF_INET }
