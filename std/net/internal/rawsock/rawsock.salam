@en "net/internal/rawsock"
@fa "سوکت خام شبکه"
@ar "مقبس الشبکة الخام"
package rawsock

import mem
import str

// The lowest layer of the net/ stack: raw blocking/non-blocking BSD
// sockets over plain `extern` FFI to libc/Winsock, extending what used to
// live directly in std/net/net.salam (kept there, unchanged, for now -
// see std/net/net.salam's header for the migration status).
//
// Named `rawsock`, not `socket`, specifically to avoid a filename
// collision with std/socket/socket.salam (today's WebSocket package,
// destined to become net/websocket) - a .salam file's C module is keyed
// by filename, not by package, so two different packages both shipping a
// `socket.salam` would silently collide at link time.
//
// New here, beyond what std/net/net.salam has:
//   - IPv6 (AF_INET6) resolution and connection, via getaddrinfo/
//     freeaddrinfo instead of the IPv4-only gethostbyname. EXPERIMENTAL:
//     the addrinfo/sockaddr_in6 struct layouts are hand-decoded via raw
//     pointer offsets (matching this file's existing sockaddr_in
//     handling) assuming the standard 64-bit layout common to Win64/
//     Linux/macOS; not yet interop-tested against a real IPv6 network in
//     this environment.
//   - SOCK_DGRAM (UDP) alongside SOCK_STREAM (TCP), shared by net/tcp and
//     net/udp.
//   - Non-blocking mode, receive/send timeouts, keep-alive, TCP_NODELAY.

if SALAM_OS_WINDOWS:
    link dynamic "ws2_32"
end

// ---------------------------------------------------------------- extern

extern:
    func memset(ptr: void*, val: int, n: u64): void*
    func memcpy(dst: void*, src: void*, n: u64): void*
    func htons(n: int): int
    func ntohs(n: int): int
    func inet_ntoa(addr: int): str
end

if SALAM_OS_WINDOWS:
    extern:
        func WSAStartup(version: int, wsa: void*): int
        func socket(family: int, socktype: int, proto: int): i64
        func connect(s: i64, addr: void*, addrlen: int): int
        func bind(s: i64, addr: void*, addrlen: int): int
        func listen(s: i64, backlog: int): int
        func accept(s: i64, addr: void*, addrlen: void*): i64
        func send(s: i64, buf: void*, len: int, flags: int): int
        func recv(s: i64, buf: void*, len: int, flags: int): int
        func sendto(s: i64, buf: void*, len: int, flags: int, addr: void*, addrlen: int): int
        func recvfrom(s: i64, buf: void*, len: int, flags: int, addr: void*, addrlen: void*): int
        func closesocket(s: i64): int
        func shutdown(s: i64, how: int): int
        func setsockopt(s: i64, level: int, optname: int, optval: void*, optlen: int): int
        func getsockname(s: i64, addr: void*, addrlen: void*): int
        func ioctlsocket(s: i64, cmd: i64, argp: void*): int
        func getaddrinfo(node: str, service: str, hints: void*, res: void*): int
        func freeaddrinfo(res: void*)
        func gethostbyname(name: str): void*
    end
else:
    extern:
        func socket(family: int, socktype: int, proto: int): int
        func connect(s: int, addr: void*, addrlen: int): int
        func bind(s: int, addr: void*, addrlen: int): int
        func listen(s: int, backlog: int): int
        func accept(s: int, addr: void*, addrlen: void*): int
        func send(s: int, buf: void*, len: int, flags: int): int
        func recv(s: int, buf: void*, len: int, flags: int): int
        func sendto(s: int, buf: void*, len: int, flags: int, addr: void*, addrlen: int): int
        func recvfrom(s: int, buf: void*, len: int, flags: int, addr: void*, addrlen: void*): int
        func close(s: int): int
        func shutdown(s: int, how: int): int
        func setsockopt(s: int, level: int, optname: int, optval: void*, optlen: int): int
        func getsockname(s: int, addr: void*, addrlen: void*): int
        func fcntl(s: int, cmd: int, arg: int): int
        func getaddrinfo(node: str, service: str, hints: void*, res: void*): int
        func freeaddrinfo(res: void*)
        func gethostbyname(name: str): void*
    end
end

// ------------------------------------------------------------- constants

pub const AF_INET := 2
pub const SOCK_STREAM := 1
pub const SOCK_DGRAM := 2

// AF_INET6 is not portable across platforms. Windows/Linux values below
// are verified against their public headers; the BSD-family fallback
// uses FreeBSD's value (28) - OpenBSD (24) and NetBSD (24) differ and are
// not separately special-cased yet (SALAM_OS_OPENBSD/SALAM_OS_NETBSD
// exist as macros if that's ever needed).
pub const AF_INET6 := 10

pub const ShutRd := 0
pub const ShutWr := 1
pub const ShutRdWr := 2

// Named `_rawsock_wsa_init`, not the shorter `_g_wsa_init` std/net/net.salam
// uses - top-level global variables are NOT namespaced by package in this
// compiler's C codegen (unlike functions, which get a `_Salam_<pkg>_`
// prefix), so two different packages both picking `_g_wsa_init` collide at
// the C symbol level the moment both end up linked into the same program
// (which happens here: std/tls's bytes.salam imports std/net transitively).
if SALAM_OS_WINDOWS:
    mut _rawsock_wsa_init := 0
end

@en "Socket"
@fa "سوکت"
@ar "مقبس"
pub struct Socket:
    pub fd: i64 = 0 - 1
    pub family: int = AF_INET
end

func _net_init():
    if SALAM_OS_WINDOWS:
        if _rawsock_wsa_init == 0:
            wsa := mem.Allocate(512 as u64)
            WSAStartup(514, wsa)
            mem.Free(wsa)
            _rawsock_wsa_init = 1
        end
    end
end

// -------------------------------------------------------- address helpers

// Reads the first IPv4 address out of a `struct hostent*` returned by
// gethostbyname, exactly as std/net/net.salam does today.
func _hostent_addr4(he: void*): int:
    listp := (he as i64 + 24) as i64*
    list := listp[0]
    if list == 0: ret 0 end
    addrp := list as i64*
    addr := addrp[0]
    if addr == 0: ret 0 end
    bytes := addr as int*
    ret bytes[0]
end

func _resolve_addr4(host: str): int:
    he := gethostbyname(host)
    if he == null: ret 0 end
    ret _hostent_addr4(he)
end

// Builds a 16-byte sockaddr_in: family/port packed into the first 4
// bytes (network byte order), then the 4-byte address, then 8 bytes of
// zero padding - the same ABI-stable layout std/net/net.salam relies on.
func _make_sa4(h_addr: int, port: int): void*:
    sa := mem.Allocate(16 as u64)
    memset(sa, 0, 16 as u64)
    sa32 := sa as int*
    port_n := htons(port)
    packed := (port_n as i64) * 65536 + AF_INET
    sa32[0] = packed as int
    sa32[1] = h_addr
    ret sa
end

// ---------------------------------------------------- getaddrinfo (IPv6+v4)

// struct addrinfo layout on 64-bit Windows/Linux/macOS:
//   0: int ai_flags        4: int ai_family
//   8: int ai_socktype    12: int ai_protocol
//  16: u64 ai_addrlen     24: char* ai_canonname
//  32: sockaddr* ai_addr  40: addrinfo* ai_next     (size 48)
func _ai_family(ai: void*): int: ret ((ai as i64 + 4) as int*)[0] end
func _ai_addrlen(ai: void*): i64: ret ((ai as i64 + 16) as i64*)[0] end
func _ai_addr(ai: void*): void*: ret ((ai as i64 + 32) as i64*)[0] as void* end
func _ai_next(ai: void*): void*: ret ((ai as i64 + 40) as i64*)[0] as void* end

// Resolves `host` to a raw sockaddr blob usable directly with connect()/
// sendto(), preferring an address of `family_hint` (AF_INET or AF_INET6)
// if present, falling back to whatever getaddrinfo returns first
// otherwise. `family_hint` of 0 means "first result, any family".
// Returns (sockaddr void*, addrlen, family) via out-params; the caller
// owns the returned buffer and must mem.Free it.
func _resolve_sockaddr(host: str, family_hint: int, port: int, out_len &: int, out_family &: int): void*:
    _net_init()
    hints := mem.Allocate(48 as u64)
    defer mem.Free(hints)
    memset(hints, 0, 48 as u64)
    hp := hints as int*
    hp[1] = family_hint // ai_family (0 = AF_UNSPEC)
    hp[2] = SOCK_STREAM
    res_slot := mem.Allocate(8 as u64)
    defer mem.Free(res_slot)
    rp := res_slot as i64*
    rp[0] = 0
    port_str := str.FromInt(port as i64)
    rc := getaddrinfo(host, port_str, hints, res_slot)
    if rc != 0:
        out_len = 0
        out_family = 0
        ret (0 as void*)
    end
    res := rp[0] as void*
    if res == null:
        out_len = 0
        out_family = 0
        ret (0 as void*)
    end
    defer freeaddrinfo(res)
    mut cur := res
    until cur != null:
        fam := _ai_family(cur)
        if family_hint == 0 || fam == family_hint:
            out_family = fam
            ret _copy_sockaddr(cur, out_len)
        end
        cur = _ai_next(cur)
    end
    out_len = 0
    out_family = 0
    ret (0 as void*)
end

func _copy_sockaddr(ai: void*, out_len &: int): void*:
    alen := _ai_addrlen(ai) as int
    addr := _ai_addr(ai)
    out := mem.Allocate(alen as u64)
    memcpy(out, addr, alen as u64)
    out_len = alen
    ret out
end

// -------------------------------------------------------------- Socket API

@en "FromFd"
@fa "سوکت از توصیف‌گر"
@ar "مقبس من واصف"
pub func FromFd(fd: i64): Socket:
    ret Socket { fd = fd, family = AF_INET }
end

@en "Open"
@fa "باز کردن سوکت"
@ar "فتح مقبس"
pub func Open(family: int, socktype: int): Socket:
    _net_init()
    if SALAM_OS_WINDOWS:
        s := socket(family, socktype, 0)
        ret Socket { fd = s, family = family }
    else:
        s := socket(family, socktype, 0)
        ret Socket { fd = s as i64, family = family }
    end
end

@en "Connect"
@fa "اتصال"
@ar "اتصال"
pub func Connect(host: str, port: int): Socket:
    ret ConnectProto(host, port, SOCK_STREAM)
end

@en "ConnectProto"
@fa "اتصال با نوع"
@ar "اتصال بنوع"
pub func ConnectProto(host: str, port: int, socktype: int): Socket:
    _net_init()
    mut alen := 0
    mut fam := 0
    sa := _resolve_sockaddr(host, 0, port, alen, fam)
    if sa == null:
        ret Socket { fd = 0 - 1, family = AF_INET }
    end
    defer mem.Free(sa)
    if SALAM_OS_WINDOWS:
        s := socket(fam, socktype, 0)
        if s == (0 - 1 as i64):
            ret Socket { fd = 0 - 1, family = fam }
        end
        r := connect(s, sa, alen)
        if r != 0:
            closesocket(s)
            ret Socket { fd = 0 - 1, family = fam }
        end
        ret Socket { fd = s, family = fam }
    else:
        s := socket(fam, socktype, 0)
        if s == 0 - 1:
            ret Socket { fd = 0 - 1, family = fam }
        end
        r := connect(s, sa, alen)
        if r != 0:
            close(s)
            ret Socket { fd = 0 - 1, family = fam }
        end
        ret Socket { fd = s as i64, family = fam }
    end
end

@en "ListenOn"
@fa "شنود روی"
@ar "استماع علی"
pub func ListenOn(host: str, port: int, socktype: int): Socket:
    _net_init()
    mut h_addr := 0
    if host.len() > 0 && host != "0.0.0.0" && host != "::":
        h_addr = _resolve_addr4(host)
        if h_addr == 0:
            ret Socket { fd = 0 - 1, family = AF_INET }
        end
    end
    if SALAM_OS_WINDOWS:
        s := socket(AF_INET, socktype, 0)
        if s == (0 - 1 as i64): ret Socket { fd = 0 - 1, family = AF_INET } end
        opt := mem.Allocate(4 as u64)
        defer mem.Free(opt)
        mut opt32 := opt as int*
        opt32[0] = 1
        setsockopt(s, 65535, 4, opt, 4) // SOL_SOCKET, SO_REUSEADDR
        sa := _make_sa4(h_addr, port)
        defer mem.Free(sa)
        if bind(s, sa, 16) != 0:
            closesocket(s)
            ret Socket { fd = 0 - 1, family = AF_INET }
        end
        if socktype == SOCK_STREAM:
            if listen(s, 128) != 0:
                closesocket(s)
                ret Socket { fd = 0 - 1, family = AF_INET }
            end
        end
        ret Socket { fd = s, family = AF_INET }
    else:
        s := socket(AF_INET, socktype, 0)
        if s == 0 - 1: ret Socket { fd = 0 - 1, family = AF_INET } end
        opt := mem.Allocate(4 as u64)
        defer mem.Free(opt)
        opt32 := opt as int*
        opt32[0] = 1
        if SALAM_OS_BSD:
            setsockopt(s, 65535, 4, opt, 4)
        else:
            setsockopt(s, 1, 2, opt, 4)
        end
        sa := _make_sa4(h_addr, port)
        defer mem.Free(sa)
        if bind(s, sa, 16) != 0:
            close(s)
            ret Socket { fd = 0 - 1, family = AF_INET }
        end
        if socktype == SOCK_STREAM:
            if listen(s, 128) != 0:
                close(s)
                ret Socket { fd = 0 - 1, family = AF_INET }
            end
        end
        ret Socket { fd = s as i64, family = AF_INET }
    end
end

@en "Listen"
@fa "شنود"
@ar "استماع"
pub func Listen(port: int): Socket:
    ret ListenOn("", port, SOCK_STREAM)
end

// The port a bound Socket actually ended up on - the number to hand a
// peer after ListenOn(host, 0, ...)/Listen(0) asked the OS for a free
// ephemeral port instead of a caller-chosen one, which is what test code
// and short-lived local servers should do rather than hardcode a port
// number that might collide with another process or a host-level
// dynamic port reservation (observed on Windows: Hyper-V/WSL2's NAT
// carves out large "excluded" TCP ranges - see `netsh interface ipv4
// show excludedportrange protocol=tcp` - that shift over the life of a
// dev session and silently blackhole a hardcoded port's SYN packets).
// Reads sin_port directly out of the sockaddr_in getsockname() fills in
// (bytes 2-3, network/big-endian order) rather than reconstructing it
// via arithmetic on the packed 32-bit word ListenOn's _make_sa4 builds -
// ports at or above 32768 flip that word's sign bit, and plain integer
// division does not recover an unsigned high half from a negative signed
// dividend the way a same-signedness bit shift would. Returns 0 if the
// socket is not bound (or getsockname fails for any other reason).
@en "LocalPort"
@fa "درگاه محلی"
@ar "المنفذ المحلي"
pub func LocalPort(s: Socket): int:
    buf := mem.Allocate(16 as u64)
    defer mem.Free(buf)
    lenbuf := mem.Allocate(4 as u64)
    defer mem.Free(lenbuf)
    lenbuf32 := lenbuf as int*
    lenbuf32[0] = 16
    mut ok := 0 - 1
    if SALAM_OS_WINDOWS:
        ok = getsockname(s.fd, buf, lenbuf)
    else:
        ok = getsockname(s.fd as int, buf, lenbuf)
    end
    if ok != 0: ret 0 end
    bp := buf as i8*
    mut hi := bp[2] as int
    mut lo := bp[3] as int
    if hi < 0: hi += 256 end
    if lo < 0: lo += 256 end
    ret hi * 256 + lo
end

@en "Accept"
@fa "پذیرش"
@ar "قبول"
pub func Accept(server: Socket): Socket:
    if SALAM_OS_WINDOWS:
        c := accept(server.fd, null, null)
        if c == (0 - 1 as i64): ret Socket { fd = 0 - 1, family = server.family } end
        ret Socket { fd = c, family = server.family }
    else:
        c := accept(server.fd as int, null, null)
        if c == 0 - 1: ret Socket { fd = 0 - 1, family = server.family } end
        ret Socket { fd = c as i64, family = server.family }
    end
end

@en "Send"
@fa "ارسال"
@ar "إرسال"
pub func Send(sock: Socket, data: str): int:
    if SALAM_OS_WINDOWS:
        ret send(sock.fd, data as void*, data.len(), 0)
    else:
        ret send(sock.fd as int, data as void*, data.len(), 0)
    end
end

@en "SendBytes"
@fa "ارسال بایت"
@ar "إرسال بایتات"
pub func SendBytes(sock: Socket, ptr: void*, n: int): int:
    if SALAM_OS_WINDOWS:
        mut sent := 0
        until sent < n:
            r := send(sock.fd, (ptr as i64 + sent) as void*, n - sent, 0)
            if r <= 0: ret sent end
            sent += r
        end
        ret sent
    else:
        mut sent := 0
        until sent < n:
            r := send(sock.fd as int, (ptr as i64 + sent) as void*, n - sent, 0)
            if r <= 0: ret sent end
            sent += r
        end
        ret sent
    end
end

@en "Recv"
@fa "دریافت"
@ar "استقبال"
pub func Recv(sock: Socket, max: int): str:
    mut m := max
    if m <= 0: m = 4096 end
    buf := mem.Allocate((m + 1) as u64)
    defer mem.Free(buf)
    memset(buf, 0, (m + 1) as u64)
    if SALAM_OS_WINDOWS:
        recv(sock.fd, buf, m, 0)
    else:
        recv(sock.fd as int, buf, m, 0)
    end
    ret str.Clone(buf as str)
end

@en "RecvBytes"
@fa "دریافت بایت"
@ar "استقبال بایتات"
pub func RecvBytes(sock: Socket, buf: void*, max: int): int:
    if SALAM_OS_WINDOWS:
        ret recv(sock.fd, buf, max, 0)
    else:
        ret recv(sock.fd as int, buf, max, 0)
    end
end

@en "Close"
@fa "بستن"
@ar "إغلاق"
pub func Close(sock: Socket):
    if sock.fd < 0: ret end
    if SALAM_OS_WINDOWS:
        closesocket(sock.fd)
    else:
        close(sock.fd as int)
    end
end

@en "Ok"
@fa "معتبر"
@ar "صالح"
pub func Ok(sock: Socket): bool:
    ret sock.fd >= 0
end

@en "Resolve"
@fa "تفکیک نشانی"
@ar "استبانة عنوان"
pub func Resolve(host: str): str:
    _net_init()
    addr := _resolve_addr4(host)
    if addr == 0: ret "" end
    ret str.Clone(inet_ntoa(addr))
end

// The raw packed IPv4 address (network byte order), for callers building
// their own sockaddr/option structs (net/udp's multicast group join).
@en "ResolveAddr4Raw"
@fa "نشانی خام آی‌پی۴"
@ar "عنوان IPv4 الخام"
pub func ResolveAddr4Raw(host: str): int:
    _net_init()
    ret _resolve_addr4(host)
end

// ---------------------------------------------------------- socket options

@en "SetNonBlocking"
@fa "تنظیم حالت غیرمسدود"
@ar "تعیین وضع غیر حاجب"
pub func SetNonBlocking(sock: Socket, enable: bool):
    if SALAM_OS_WINDOWS:
        mode := mem.Allocate(4 as u64)
        defer mem.Free(mode)
        m32 := mode as int*
        if enable: m32[0] = 1 else: m32[0] = 0 end
        ioctlsocket(sock.fd, 0 - 2147195266, mode) // FIONBIO
    else:
        mut flags := fcntl(sock.fd as int, 3, 0) // F_GETFL
        if flags < 0: ret end
        if enable:
            flags = flags | 2048 // O_NONBLOCK
        else:
            flags = flags & (0 - 2049)
        end
        fcntl(sock.fd as int, 4, flags) // F_SETFL
    end
end

@en "SetTimeout"
@fa "تنظیم مهلت زمانی"
@ar "تعیین المهلة"
pub func SetTimeout(sock: Socket, millis: int):
    if SALAM_OS_WINDOWS:
        t := mem.Allocate(4 as u64)
        defer mem.Free(t)
        t32 := t as int*
        t32[0] = millis
        setsockopt(sock.fd, 65535, 4102, t, 4) // SOL_SOCKET, SO_RCVTIMEO
        setsockopt(sock.fd, 65535, 4101, t, 4) // SOL_SOCKET, SO_SNDTIMEO
    else:
        tv := mem.Allocate(16 as u64)
        defer mem.Free(tv)
        memset(tv, 0, 16 as u64)
        tv64 := tv as i64*
        tv64[0] = (millis / 1000) as i64
        usec := tv as void* as i64 + 8
        usecp := usec as i64*
        usecp[0] = ((millis % 1000) * 1000) as i64
        setsockopt(sock.fd as int, 1, 20, tv, 16) // SOL_SOCKET, SO_RCVTIMEO
        setsockopt(sock.fd as int, 1, 21, tv, 16) // SOL_SOCKET, SO_SNDTIMEO
    end
end

@en "SetKeepAlive"
@fa "تنظیم زنده‌نگه‌داری"
@ar "تفعیل الحفاظ علی الاتصال"
pub func SetKeepAlive(sock: Socket, enable: bool):
    opt := mem.Allocate(4 as u64)
    defer mem.Free(opt)
    o32 := opt as int*
    if enable: o32[0] = 1 else: o32[0] = 0 end
    if SALAM_OS_WINDOWS:
        setsockopt(sock.fd, 65535, 8, opt, 4) // SOL_SOCKET, SO_KEEPALIVE
    else:
        setsockopt(sock.fd as int, 1, 9, opt, 4) // SOL_SOCKET, SO_KEEPALIVE
    end
end

@en "SetNoDelay"
@fa "غیرفعال‌سازی نگل"
@ar "تعطیل خوارزمیة ناغل"
pub func SetNoDelay(sock: Socket, enable: bool):
    opt := mem.Allocate(4 as u64)
    defer mem.Free(opt)
    o32 := opt as int*
    if enable: o32[0] = 1 else: o32[0] = 0 end
    // IPPROTO_TCP == 6 on every platform this compiler targets;
    // TCP_NODELAY == 1 on every platform this compiler targets.
    if SALAM_OS_WINDOWS:
        setsockopt(sock.fd, 6, 1, opt, 4)
    else:
        setsockopt(sock.fd as int, 6, 1, opt, 4)
    end
end

// Generic setsockopt passthrough for options this file doesn't already
// wrap (e.g. IP_ADD_MEMBERSHIP for multicast, which net/udp builds on
// top of this rather than duplicating the Windows/POSIX fd-cast split).
@en "SetOpt"
@fa "تنظیم گزینه سوکت"
@ar "تعیین خیار المقبس"
pub func SetOpt(sock: Socket, level: int, optname: int, ptr: void*, optlen: int): int:
    if SALAM_OS_WINDOWS:
        ret setsockopt(sock.fd, level, optname, ptr, optlen)
    else:
        ret setsockopt(sock.fd as int, level, optname, ptr, optlen)
    end
end

@en "SetBroadcast"
@fa "فعال‌سازی پخش"
@ar "تفعیل البث"
pub func SetBroadcast(sock: Socket, enable: bool):
    opt := mem.Allocate(4 as u64)
    defer mem.Free(opt)
    o32 := opt as int*
    if enable: o32[0] = 1 else: o32[0] = 0 end
    if SALAM_OS_WINDOWS:
        setsockopt(sock.fd, 65535, 32, opt, 4) // SOL_SOCKET, SO_BROADCAST
    else:
        setsockopt(sock.fd as int, 1, 6, opt, 4) // SOL_SOCKET, SO_BROADCAST
    end
end

// ------------------------------------------------------- datagram (UDP) API

// Sends one datagram to host:port. Resolution is IPv4-only for now (same
// limitation as ListenOn).
@en "SendToBytes"
@fa "ارسال بایت به"
@ar "إرسال بایتات إلی"
pub func SendToBytes(sock: Socket, host: str, port: int, ptr: void*, n: int): int:
    h_addr := _resolve_addr4(host)
    if h_addr == 0: ret 0 - 1 end
    sa := _make_sa4(h_addr, port)
    defer mem.Free(sa)
    if SALAM_OS_WINDOWS:
        ret sendto(sock.fd, ptr, n, 0, sa, 16)
    else:
        ret sendto(sock.fd as int, ptr, n, 0, sa, 16)
    end
end

@en "SendTo"
@fa "ارسال به"
@ar "إرسال إلی"
pub func SendTo(sock: Socket, host: str, port: int, data: str): int:
    ret SendToBytes(sock, host, port, data as void*, data.len())
end

// Byte-count-returning receive - the `str`-returning RecvFrom below
// truncates at an embedded NUL (`str` is a NUL-terminated C string under
// the hood), which is wrong for a binary protocol like DNS where a
// zero byte can legitimately appear mid-message. Binary-safe callers
// (net/dns) use this one directly.
@en "RecvFromBytes"
@fa "دریافت بایت از"
@ar "استقبال بایتات من"
pub func RecvFromBytes(sock: Socket, buf: void*, max: int, out_host &: str, out_port &: int): int:
    sa := mem.Allocate(16 as u64)
    defer mem.Free(sa)
    memset(sa, 0, 16 as u64)
    salen := mem.Allocate(4 as u64)
    defer mem.Free(salen)
    salen32 := salen as int*
    salen32[0] = 16
    mut n := 0
    if SALAM_OS_WINDOWS:
        n = recvfrom(sock.fd, buf, max, 0, sa, salen)
    else:
        n = recvfrom(sock.fd as int, buf, max, 0, sa, salen)
    end
    if n < 0:
        out_host = ""
        out_port = 0
        ret n
    end
    sa32 := sa as int*
    packed := sa32[0]
    port_n := (packed / 65536) as int
    out_port = ntohs(port_n)
    out_host = str.Clone(inet_ntoa(sa32[1]))
    ret n
end

@en "RecvFrom"
@fa "دریافت از"
@ar "استقبال من"
pub func RecvFrom(sock: Socket, max: int, out_host &: str, out_port &: int): str:
    mut m := max
    if m <= 0: m = 65536 end
    buf := mem.Allocate((m + 1) as u64)
    defer mem.Free(buf)
    memset(buf, 0, (m + 1) as u64)
    n := RecvFromBytes(sock, buf, m, out_host, out_port)
    if n < 0: ret "" end
    ret str.Clone(buf as str).substr(0, n)
end
