@en "SetNonBlocking"
@fa "تنظیم حالت غیرمسدود"
pub func SetNonBlocking(sock: Socket, enable: bool):
    if SALAM_OS_WINDOWS:
        mode := mem.Allocate(4 as u64)
        defer mem.Free(mode)
        m32 := mode as int*
        if enable: m32[0] = 1 else:
            m32[0] = 0
        end
        ioctlsocket(_sk(sock.fd), 0 - 2147195266, mode)
    else:
        mut flags := fcntl(sock.fd as int, 3, 0)
        if flags < 0: ret end
        mut nb := 2048
        if SALAM_OS_MAC or SALAM_OS_BSD:
            nb = 4
        end
        if enable:
            flags |= nb
        else:
            flags &= (0 - nb - 1)
        end
        fcntl(sock.fd as int, 4, flags)
    end
end

@en "SetTimeout"
@fa "تنظیم مهلت زمانی"
pub func SetTimeout(sock: Socket, millis: int):
    if SALAM_OS_WINDOWS:
        t := mem.Allocate(4 as u64)
        defer mem.Free(t)
        t32 := t as int*
        t32[0] = millis
        setsockopt(_sk(sock.fd), 65535, 4102, t, 4)
        setsockopt(_sk(sock.fd), 65535, 4101, t, 4)
    else:
        tv := mem.Allocate(16 as u64)
        defer mem.Free(tv)
        memset(tv, 0, 16 as u64)
        mut tvlen := 16
        if sizeof(void*) == 8:
            tv64 := tv as i64*
            tv64[0] = (millis / 1000) as i64
            tv64[1] = ((millis % 1000) * 1000) as i64
        else:
            tv32 := tv as i32*
            tv32[0] = millis / 1000
            tv32[1] = (millis % 1000) * 1000
            tvlen = 8
        end
        if SALAM_OS_MAC or SALAM_OS_BSD:
            setsockopt(sock.fd as int, 65535, 4102, tv, tvlen)
            setsockopt(sock.fd as int, 65535, 4101, tv, tvlen)
        else:
            setsockopt(sock.fd as int, 1, 20, tv, tvlen)
            setsockopt(sock.fd as int, 1, 21, tv, tvlen)
        end
    end
end

@en "WaitReadable"
@fa "انتظار برای خواندن"
pub func WaitReadable(sock: Socket, timeout_ms: int): bool:
    if sock.fd < 0:
        ret false
    end
    if SALAM_OS_WINDOWS:
        pw := sizeof(void*) as i64
        p := mem.AllocateZeroed(16 as u64)
        defer mem.Free(p)
        fdp := p as usize*
        fdp[0] = sock.fd as usize
        evp := ((p as i64) + pw) as i16*
        evp[0] = 256 as i16
        ret WSAPoll(p, 1 as u32, timeout_ms) > 0
    else:
        p := mem.AllocateZeroed(8 as u64)
        defer mem.Free(p)
        fdp := p as i32*
        fdp[0] = sock.fd as i32
        evp := ((p as i64) + 4) as i16*
        evp[0] = 1 as i16
        ret poll(p, 1 as usize, timeout_ms) > 0
    end
end

@en "WaitReadable2"
@fa "انتظار برای خواندن دو سوکت"
pub func WaitReadable2(a: Socket, b: Socket, timeout_ms: int): int:
    if a.fd < 0 or b.fd < 0:
        ret 0
    end
    mut rc := 0
    if SALAM_OS_WINDOWS:
        pw := sizeof(void*) as i64
        stride := (pw + 4 + pw - 1) / pw * pw
        p := mem.AllocateZeroed((stride * 2) as u64)
        defer mem.Free(p)
        ((p as i64) as usize*)[0] = a.fd as usize
        (((p as i64) + pw) as i16*)[0] = 256 as i16
        (((p as i64) + stride) as usize*)[0] = b.fd as usize
        (((p as i64) + stride + pw) as i16*)[0] = 256 as i16
        rc = WSAPoll(p, 2 as u32, timeout_ms)
        if rc <= 0:
            ret 0
        end
        mut out := 0
        if ((((p as i64) + pw + 2) as i16*)[0] as int) != 0:
            out |= 1
        end
        if ((((p as i64) + stride + pw + 2) as i16*)[0] as int) != 0:
            out |= 2
        end
        ret out
    else:
        p := mem.AllocateZeroed(16 as u64)
        defer mem.Free(p)
        ((p as i64) as i32*)[0] = a.fd as i32
        (((p as i64) + 4) as i16*)[0] = 1 as i16
        (((p as i64) + 8) as i32*)[0] = b.fd as i32
        (((p as i64) + 12) as i16*)[0] = 1 as i16
        rc = poll(p, 2 as usize, timeout_ms)
        if rc <= 0:
            ret 0
        end
        mut out := 0
        if ((((p as i64) + 6) as i16*)[0] as int) != 0:
            out |= 1
        end
        if ((((p as i64) + 14) as i16*)[0] as int) != 0:
            out |= 2
        end
        ret out
    end
end

@en "SetKeepAlive"
@fa "تنظیم زنده‌نگه‌داری"
pub func SetKeepAlive(sock: Socket, enable: bool):
    opt := mem.Allocate(4 as u64)
    defer mem.Free(opt)
    o32 := opt as int*
    if enable: o32[0] = 1 else:
        o32[0] = 0
    end
    if SALAM_OS_WINDOWS:
        setsockopt(_sk(sock.fd), 65535, 8, opt, 4)
    else SALAM_OS_MAC or SALAM_OS_BSD:
        setsockopt(sock.fd as int, 65535, 8, opt, 4)
    else:
        setsockopt(sock.fd as int, 1, 9, opt, 4)
    end
end

@en "SetNoDelay"
@fa "غیرفعال‌سازی نگل"
pub func SetNoDelay(sock: Socket, enable: bool):
    opt := mem.Allocate(4 as u64)
    defer mem.Free(opt)
    o32 := opt as int*
    if enable: o32[0] = 1 else:
        o32[0] = 0
    end
    if SALAM_OS_WINDOWS:
        setsockopt(_sk(sock.fd), 6, 1, opt, 4)
    else:
        setsockopt(sock.fd as int, 6, 1, opt, 4)
    end
end

@en "SetOpt"
@fa "تنظیم گزینه سوکت"
pub func SetOpt(sock: Socket, level: int, optname: int, ptr: void*, optlen: int): int:
    if SALAM_OS_WINDOWS:
        ret setsockopt(_sk(sock.fd), level, optname, ptr, optlen)
    else:
        ret setsockopt(sock.fd as int, level, optname, ptr, optlen)
    end
end

@en "SetBroadcast"
@fa "فعال‌سازی پخش"
pub func SetBroadcast(sock: Socket, enable: bool):
    opt := mem.Allocate(4 as u64)
    defer mem.Free(opt)
    o32 := opt as int*
    if enable: o32[0] = 1 else:
        o32[0] = 0
    end
    if SALAM_OS_WINDOWS:
        setsockopt(_sk(sock.fd), 65535, 32, opt, 4)
    else SALAM_OS_MAC or SALAM_OS_BSD:
        setsockopt(sock.fd as int, 65535, 32, opt, 4)
    else:
        setsockopt(sock.fd as int, 1, 6, opt, 4)
    end
end

@en "SendToBytes"
@fa "ارسال بایت به"
pub func SendToBytes(sock: Socket, host: str, port: int, ptr: void*, n: int): int:
    mut alen := 0
    sa := _sockaddr_for(host, port, alen)
    if sa == null:
        ret 0 - 1
    end
    defer mem.Free(sa)
    mut r := _sendto_raw(sock.fd, ptr, n, sa, alen)
    if r < 0 and _sa_family(sa) == AF_INET:
        m := _map4(sa, port)
        r = _sendto_raw(sock.fd, ptr, n, m, 28)
        mem.Free(m)
    end
    ret r
end

@en "SendTo"
@fa "ارسال به"
pub func SendTo(sock: Socket, host: str, port: int, data: str): int:
    ret SendToBytes(sock, host, port, data as void*, data.len())
end

@en "RecvFromBytes"
@fa "دریافت بایت از"
pub func RecvFromBytes(sock: Socket, buf: void*, max: int, out_host &: str, out_port &: int): int:
    sa := mem.AllocateZeroed(136 as u64)
    defer mem.Free(sa)
    salen := mem.Allocate(4 as u64)
    defer mem.Free(salen)
    (salen as int*)[0] = 128
    mut n := 0
    if SALAM_OS_WINDOWS:
        n = recvfrom(_sk(sock.fd), buf, max, 0, sa, salen)
    else:
        n = recvfrom(sock.fd as int, buf, max, 0, sa, salen)
    end
    if n < 0:
        out_host = ""
        out_port = 0
        ret n
    end
    out_host = _sa_text(sa, out_port)
    ret n
end

@en "RecvFrom"
@fa "دریافت از"
pub func RecvFrom(sock: Socket, max: int, out_host &: str, out_port &: int): str:
    mut m := max
    if m <= 0: m = 65536 end
    buf := mem.Allocate((m + 1) as u64)
    defer mem.Free(buf)
    memset(buf, 0, (m + 1) as u64)
    n := RecvFromBytes(sock, buf, m, out_host, out_port)
    if n < 0: ret "" end
    ret str.Clone(buf as str).substr(0, n)
end
