@en "net/internal/ssrpage"
@fa "برگه رندر"
package ssrpage

import net.ssr
import net.http
import encoding.json
import sync
import str
import fs
import filepath
import os
import io
import env
import time
import conv
import net.router
import net.devreload
import mem

if SALAM_OS_WINDOWS:
    extern:
        func GetCurrentThreadId(): u32
    end
else:
    if not SALAM_OS_WASM:
        extern:
            func pthread_self(): usize
        end
    end
end

const _SHELL_FILE := ".shell.html"

const _STATE_OPEN := "<script type=\"application/json\" id=\"__salam\">"

mut _pg_mu := sync.NewMutex()

mut _pg_active := false

mut _pg_owner := 0 as i64

mut _pg_start := 0 as i64

mut _pg_shell := ""

mut _pg_base := ""

mut _pg_title := ""

mut _pg_title_heap := false

mut _pg_write := ""

mut _pg_write_heap := false

mut _pg_skip := false

mut _pg_num := 0

mut _pg_nop := 0

mut _pg_call_keys := Vector {} as Vector<str>

mut _pg_call_vals := Vector {} as Vector<str>

mut _pg_temps := Vector {} as Vector<str>

func _pg_clean_base(
    base: str
): str:
    mut b := base
    if str.EndsWith(b, "/"): b = b.Substr(0, b.Len() - 1) end
    ret b
end

if SALAM_OS_WINDOWS:
    func _pg_tid(): i64:
        ret GetCurrentThreadId() as i64
    end
else:
    if SALAM_OS_WASM:
        func _pg_tid(): i64:
            ret 1
        end
    else:
        func _pg_tid(): i64:
            ret pthread_self() as i64
        end
    end
end

func _pg_clear_text():
    if _pg_title_heap: mem.Free(_pg_title as void*) end
    if _pg_write_heap: mem.Free(_pg_write as void*) end
    _pg_title = ""
    _pg_write = ""
    _pg_title_heap = false
    _pg_write_heap = false
end

func _pg_free_temps():
    each t in _pg_temps:
        mem.Free(t as void*)
    end
    _pg_temps.Clear()
end

func _pg_free_calls():
    each k in _pg_call_keys:
        mem.Free(k as void*)
    end
    each v in _pg_call_vals:
        mem.Free(v as void*)
    end
    _pg_call_keys.Clear()
    _pg_call_vals.Clear()
    _pg_free_temps()
end

func _pg_budget_ms(): int:
    text := env.Get("SALAM_RENDER_TIMEOUT_MS")
    if text.Len() == 0:
        ret 3000
    end
    ret conv.ParseIntOr(text, 3000) as int
end

func _pg_over_budget(): bool:
    budget := _pg_budget_ms()
    if budget <= 0 or _pg_call_keys.Len() == 0:
        ret false
    end
    ret (time.NowNanos() - _pg_start) / (1000000 as i64) > (budget as i64)
end

func _pg_byte(s: str, i: int): int:
    p := (s as void*) as u8*
    ret p[i] as int
end

func _pg_hex(b: int): int:
    if b >= 48 and b <= 57: ret b - 48 end
    if b >= 65 and b <= 70: ret b - 55 end
    if b >= 97 and b <= 102: ret b - 87 end
    ret -1
end

func _pg_decode(s: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    n := s.Len()
    mut i := 0
    until i < n:
        b := _pg_byte(s, i)
        if b == 37 and i + 2 < n + 0 and _pg_hex(
            _pg_byte(s, i + 1)
        ) >= 0 and _pg_hex(_pg_byte(s, i + 2)) >= 0:
            v := _pg_hex(_pg_byte(s, i + 1)) * 16 + _pg_hex(_pg_byte(s, i + 2))
            if v == 47 or v == 37 or v == 38 or v == 61 or v == 35 or v == 63 or v == 43:
                str.BufAppendChar(sb, 37)
                str.BufAppendChar(
                    sb, _pg_byte(s, i + 1) >= 97 ? _pg_byte(s, i + 1) - 32 : _pg_byte(s, i + 1)
                )
                str.BufAppendChar(
                    sb, _pg_byte(s, i + 2) >= 97 ? _pg_byte(s, i + 2) - 32 : _pg_byte(s, i + 2)
                )
            else:
                str.BufAppendChar(sb, v)
            end
            i += 3
        else:
            str.BufAppendChar(sb, b)
            i++
        end
    end
    ret str.BufStr(sb)
end

func _pg_encode(s: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    digits := "0123456789ABCDEF"
    n := s.Len()
    mut i := 0
    until i < n:
        b := _pg_byte(s, i)
        keep := (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or
            b == 45 or b == 46 or b == 95 or b == 126 or b == 47 or b == 63 or b == 38 or b == 61 or
            b == 37 or b == 43 or b == 58 or b == 64 or b == 44 or b == 59 or b == 36 or b == 33 or
            b == 42
        if keep:
            str.BufAppendChar(sb, b)
        else:
            str.BufAppendChar(sb, 37)
            str.BufAppendChar(sb, _pg_byte(digits, b / 16))
            str.BufAppendChar(sb, _pg_byte(digits, b % 16))
        end
        i++
    end
    ret str.BufStr(sb)
end

func _pg_at(html: str, at: int, want: str): bool:
    n := want.Len()
    if at < 0 or at + n > html.Len(): ret false end
    mut i := 0
    until i < n:
        if _pg_byte(html, at + i) != _pg_byte(want, i): ret false end
        i++
    end
    ret true
end

func _pg_swap(s: str, find: str, with: str): str:
    r := str.Replace(s, find, with)
    mem.Free(s as void*)
    ret r
end

func _pg_json_text(s: str): str:
    mut t := json.Escape(s)
    t = _pg_swap(t, "<", "\\u003c")
    t = _pg_swap(t, ">", "\\u003e")
    t = _pg_swap(t, "&", "\\u0026")
    t = _pg_swap(t, " ", "\\u2028")
    t = _pg_swap(t, " ", "\\u2029")
    ret t
end

func _pg_script_safe(json_text: str): str:
    mut t := str.Replace(json_text, "<", "\\u003c")
    t = _pg_swap(t, ">", "\\u003e")
    t = _pg_swap(t, "&", "\\u0026")
    t = _pg_swap(t, " ", "\\u2028")
    ret _pg_swap(t, " ", "\\u2029")
end

func _pg_public_dir(): str:
    given := env.Get("SALAM_PUBLIC")
    if given.Len() > 0: ret given end
    args := os.Args()
    if args.Len() > 0:
        exe := args.Get(0)
        mut k := exe.Len() - 1
        until k >= 0 and exe.Substr(k, 1) != "/":
            k--
        end
        if k >= 0:
            beside := exe.Substr(0, k) + "/public"
            if os.Exists(beside + "/" + _SHELL_FILE): ret beside end
        end
    end
    if os.Exists("public/" + _SHELL_FILE): ret "public" end
    ret "dist/public"
end

@en "PageInit"
@fa "آماده سازی صفحه"
pub func PageInit(dir: str, base: str): bool:
    shell := filepath.Join(dir, _SHELL_FILE)
    if not os.Exists(shell): ret false end
    _pg_shell = str.Clone(fs.ReadText(shell))
    _pg_base = str.Clone(_pg_clean_base(base))
    ssr.SetStaticDir(dir)
    ret true
end

@en "PageShell"
@fa "پوسته صفحه"
pub func PageShell(): str:
    ret _pg_shell
end

@en "PageNop"
@fa "بی اثر"
pub func PageNop(n: int):
    _pg_nop = n
end

@en "PageCallKey"
@fa "کلید صدازدن"
pub func PageCallKey(name: str, args: str): str:
    mut h := 2166136261 as u64
    n := str.ByteLen(args)
    mut i := 0
    until i < n:
        h ^= (_pg_byte(args, i) as u64)
        h *= (16777619 as u64)
        h %= (4294967296 as u64)
        i++
    end
    hex := "0123456789abcdef"
    mut digits := ""
    mut k := 0
    until k < 8:
        digits = hex.Substr((h % (16 as u64)) as int, 1) + digits
        h /= (16 as u64)
        k++
    end
    base := name + ":" + digits
    mut seen := 0
    each key in _pg_call_keys:
        if str.StartsWith(key, base + ":"): seen++ end
    end
    ret base + ":" + str.FromInt(seen as i64)
end

@en "PageCallPut"
@fa "ثبت صدازدن"
pub func PageCallPut(key: str, value: str):
    if not PageActive():
        ret
    end
    _pg_call_keys.Push(str.Clone(key))
    _pg_call_vals.Push(str.Clone(value))
end

@en "PageCalls"
@fa "فراخوانی ها"
pub func PageCalls(): str:
    mut out := "{"
    mut i := 0
    until i < _pg_call_keys.Len():
        if i > 0: out += "," end
        v := _pg_call_vals.Get(i)
        out += json.Str(_pg_call_keys.Get(i)) + ":" + (json.Valid(v) ? v : "null")
        i++
    end
    ret out + "}"
end

@en "PageActive"
@fa "صفحه فعال"
pub func PageActive(): bool:
    ret _pg_active and _pg_owner == _pg_tid()
end

@en "PageBegin"
@fa "آغاز صفحه"
pub func PageBegin():
    sync.Lock(_pg_mu)
    _pg_owner = _pg_tid()
    _pg_start = time.NowNanos()
    _pg_active = true
    _pg_clear_text()
    _pg_skip = false
    _pg_num = 0
    _pg_free_calls()
end

@en "PageEnd"
@fa "پایان صفحه"
pub func PageEnd():
    _pg_active = false
    _pg_owner = 0 as i64
    _pg_free_calls()
    sync.Unlock(_pg_mu)
end

@en "PageUrl"
@fa "نشانی صفحه"
pub func PageUrl(c: i64): str:
    path := http.Path(c)
    mut rel := path
    mut cut := ""
    mut cut_owned := false
    if _pg_base.Len() > 0:
        if path == _pg_base:
            rel = "/"
        else _pg_at(path, 0, _pg_base) and path.Len() > _pg_base.Len() and _pg_byte(
            path, _pg_base.Len()
        ) == 47:
            cut = path.Substr(_pg_base.Len(), path.Len() - _pg_base.Len())
            cut_owned = true
            rel = cut
        end
    end
    q := http.RawQuery(c)
    mut out := ""
    if q.Len() > 0:
        mut sb := str.NewBuilder()
        str.BufAppend(sb, rel)
        str.BufAppend(sb, "?")
        str.BufAppend(sb, q)
        joined := str.BufStr(sb)
        str.BufFree(sb)
        out = _pg_decode(joined)
        mem.Free(joined as void*)
    else:
        out = _pg_decode(rel)
    end
    if cut_owned: mem.Free(cut as void*) end
    ret out
end

@en "PageTitle"
@fa "عنوان صفحه"
pub func PageTitle(t: str):
    if _pg_title_heap: mem.Free(_pg_title as void*) end
    _pg_title = str.Clone(t)
    _pg_title_heap = true
end

@en "PageWrite"
@fa "نوشتن نشانی"
pub func PageWrite(u: str):
    if _pg_write_heap: mem.Free(_pg_write as void*) end
    _pg_write = str.Clone(u)
    _pg_write_heap = true
end

@en "PageSkip"
@fa "پرش از ناحیه"
pub func PageSkip():
    _pg_skip = true
end

@en "PageSkipped"
@fa "ناحیه پریده شد"
pub func PageSkipped(): bool:
    r := _pg_skip
    _pg_skip = false
    ret r
end

@en "PageHtml"
@fa "امن سازی اچ تی ام ال"
pub func PageHtml(s: str): str:
    mut t := str.Replace(s, "&", "&amp;")
    t = _pg_swap(t, "<", "&lt;")
    t = _pg_swap(t, ">", "&gt;")
    t = _pg_swap(t, "\"", "&quot;")
    ret _pg_swap(t, "'", "&#39;")
end

@en "PageUrlAttr"
@fa "امن سازی نشانی"
pub func PageUrlAttr(s: str): str:
    mut sb := str.NewBuilder()
    n := s.Len()
    mut i := 0
    until i < n:
        b := _pg_byte(s, i)
        if b > 32: str.BufAppendChar(sb, b) end
        i++
    end
    joined := str.BufStr(sb)
    str.BufFree(sb)
    t := str.Lower(joined)
    mem.Free(joined as void*)
    bad := str.StartsWith(
        t, "javascript:"
    ) or str.StartsWith(t, "vbscript:") or str.StartsWith(t, "data:")
    mem.Free(t as void*)
    if bad:
        ret str.Clone("#")
    end
    ret PageHtml(s)
end

@en "PageCss"
@fa "امن سازی سی اس اس"
pub func PageCss(s: str): str:
    mut t := str.Replace(s, ";", "")
    t = _pg_swap(t, "{", "")
    t = _pg_swap(t, "}", "")
    t = _pg_swap(t, "<", "")
    t = _pg_swap(t, ">", "")
    t = _pg_swap(t, "\r", "")
    t = _pg_swap(t, "\n", "")
    out := PageHtml(t)
    mem.Free(t as void*)
    ret out
end

@en "PageNext"
@fa "ناحیه بعدی"
pub func PageNext(html: str, from: int): int:
    mut p := from
    n := html.Len()
    until p < n:
        k := str.IndexFrom(html, "<!--salam:", p)
        if k < 0: ret -1 end
        mut j := k + 10
        mut num := 0
        mut digits := 0
        until j < n and _pg_byte(html, j) >= 48 and _pg_byte(html, j) <= 57:
            num = num * 10 + _pg_byte(html, j) - 48
            digits++
            j++
        end
        open_end := j + 3
        if digits > 0 and open_end <= n and _pg_at(html, j, "-->"):
            digits_text := str.FromInt(num as i64)
            close := "<!--/salam:" + digits_text + "-->"
            mem.Free(digits_text as void*)
            found := _pg_at(html, open_end, close)
            mem.Free(close as void*)
            if found:
                _pg_num = num
                ret k
            end
        end
        p = k + 1
    end
    ret -1
end

@en "PageDrop"
@fa "رها سازی متن"
pub func PageDrop(s: str):
    if s.Len() > 0:
        mem.Free(s as void*)
    end
end

@en "PageKeep"
@fa "ثبت متن موقت"
pub func PageKeep(s: str): str:
    if s.Len() > 0 and _pg_active and _pg_owner == _pg_tid():
        _pg_temps.Push(s)
    end
    ret s
end

@en "PageCopy"
@fa "رونویس متن"
pub func PageCopy(s: str): str:
    if s.Len() == 0:
        ret ""
    end
    ret str.Clone(s)
end

@en "PageNum"
@fa "شماره ناحیه"
pub func PageNum(): int:
    ret _pg_num
end

@en "PageSplice"
@fa "جایگذاری ناحیه"
pub func PageSplice(html: str, at: int, num: int, inner: str): str:
    nt := str.FromInt(num as i64)
    open := "<!--salam:" + nt + "-->"
    pos := at + open.Len()
    mem.Free(nt as void*)
    mem.Free(open as void*)
    head := html.Substr(0, pos)
    tail := html.Substr(pos, html.Len() - pos)
    mut sb := str.NewBuilder()
    str.BufAppend(sb, head)
    str.BufAppend(sb, inner)
    str.BufAppend(sb, tail)
    out := str.BufStr(sb)
    str.BufFree(sb)
    mem.Free(head as void*)
    mem.Free(tail as void*)
    ret out
end

@en "PageAfter"
@fa "پس از ناحیه"
pub func PageAfter(at: int, num: int, inner: str): int:
    n := str.FromInt(num as i64)
    digits := n.Len()
    mem.Free(n as void*)
    ret at + 27 + digits * 2 + inner.Len()
end

@en "PageRespond"
@fa "پاسخ صفحه کامل"
pub func PageRespond(c: i64, path: str, pattern: str, doc: str, calls: str):
    if _pg_over_budget():
        ssr.Respond(
            c,
            504,
            "<!doctype html><title>504</title><h1>504</h1><p>The page took too long to render.</p>",
            ""
        )
        ret
    end
    if _pg_write.Len() > 0:
        target := _pg_encode(_pg_base + _pg_write)
        ssr.Respond(c, 302, "", target)
        mem.Free(target as void*)
        ret
    end
    mut status := 200
    if pattern == "" or pattern == "*": status = 404 end
    mut cj := calls
    if cj.Len() == 0 or not json.Valid(cj): cj = "{}" end
    pj := _pg_json_text(path)
    pp := _pg_json_text(pattern)
    cs := _pg_script_safe(cj)
    st := str.FromInt(status as i64)
    mut sb := str.NewBuilder()
    str.BufAppend(sb, _STATE_OPEN)
    str.BufAppend(sb, "{\"path\":\"")
    str.BufAppend(sb, pj)
    str.BufAppend(sb, "\",\"pattern\":\"")
    str.BufAppend(sb, pp)
    str.BufAppend(sb, "\",\"status\":")
    str.BufAppend(sb, st)
    str.BufAppend(sb, ",\"calls\":")
    str.BufAppend(sb, cs)
    str.BufAppend(sb, "}</script>")
    script := str.BufStr(sb)
    str.BufFree(sb)
    mem.Free(pj as void*)
    mem.Free(pp as void*)
    mem.Free(cs as void*)
    mem.Free(st as void*)
    mut head := doc
    mut head_own := ""
    if _pg_title.Len() > 0:
        a := doc.Find("<title>")
        b := doc.Find("</title>")
        if a >= 0 and b > a:
            ht := PageHtml(_pg_title)
            h1 := doc.Substr(0, a + 7)
            h2 := doc.Substr(b, doc.Len() - b)
            mut tb := str.NewBuilder()
            str.BufAppend(tb, h1)
            str.BufAppend(tb, ht)
            str.BufAppend(tb, h2)
            head_own = str.BufStr(tb)
            head = head_own
            str.BufFree(tb)
            mem.Free(ht as void*)
            mem.Free(h1 as void*)
            mem.Free(h2 as void*)
        end
    end
    mut at := head.Find("<script src=")
    if at < 0: at = head.Find("</body>") end
    mut out := ""
    if at < 0:
        out = head + script
    else:
        p1 := head.Substr(0, at)
        p2 := head.Substr(at, head.Len() - at)
        mut ob := str.NewBuilder()
        str.BufAppend(ob, p1)
        str.BufAppend(ob, script)
        str.BufAppend(ob, p2)
        out = str.BufStr(ob)
        str.BufFree(ob)
        mem.Free(p1 as void*)
        mem.Free(p2 as void*)
    end
    shown := devreload.Enabled() ? devreload.Inject(out) : out
    ssr.Respond(c, status, shown, "")
    if devreload.Enabled():
        mem.Free(shown as void*)
    end
    mem.Free(out as void*)
    mem.Free(script as void*)
    if head_own.Len() > 0: mem.Free(head_own as void*) end
end

@en "PageServe"
@fa "اجرای سرور صفحه"
pub func PageServe(render: i64, base: str):
    dir := _pg_public_dir()
    if not PageInit(dir, base):
        io.EPrintln(
            "salam server: no page shell in '" + dir + "' (set SALAM_PUBLIC to the public folder)"
        )
        os.Exit(2)
    end
    ssr.SetRender(render)
    mut r := router.NewRouter()
    if devreload.InitFromEnv():
        router.Get(r, "/__salam_hmr", devreload.Handler)
    end
    ssr.Mount(r)
    mut host := env.Get("HOST")
    if host.Len() == 0: host = "127.0.0.1" end
    port_text := env.Get("PORT")
    mut want := 8080
    if port_text.Len() > 0: want = conv.ParseIntOr(port_text, 8080) as int end
    mut s := http.NewServer(want)
    http.SetHost(s, host)
    http.Use(s, r)
    port := http.RunBackgroundPort(s)
    if port <= 0:
        io.EPrintln("salam server: cannot listen on " + host + ":" + str.FromInt(want as i64))
        os.Exit(2)
    end
    println "listening on http://" + host + ":" + str.FromInt(port as i64)
    io.Flush()
    until true:
        time.Sleep(60000)
    end
end
