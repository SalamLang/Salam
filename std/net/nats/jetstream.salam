package nats

import conv
import str
import encoding
import encoding.json

const JS_API := "$JS.API."

@en "JSResult"
@fa "نتیجه جت‌استریم"
pub struct JSResult:
    @en "ok"
    @fa "سالم"
    pub ok: bool = false
    @en "err"
    @fa "خطا"
    pub err: str = ""
    @en "code"
    @fa "کد"
    pub code: int = 0
    @en "raw"
    @fa "خام"
    pub raw: str = ""
end

@en "StreamState"
@fa "وضعیت جریان"
pub struct StreamState:
    @en "ok"
    @fa "سالم"
    pub ok: bool = false
    @en "err"
    @fa "خطا"
    pub err: str = ""
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "messages"
    @fa "پیام ها"
    pub messages: int = 0
    @en "bytes"
    @fa "بایت ها"
    pub bytes: int = 0
    @en "first_seq"
    @fa "نخستین شماره"
    pub first_seq: int = 0
    @en "last_seq"
    @fa "واپسین شماره"
    pub last_seq: int = 0
    @en "consumers"
    @fa "مصرف‌کننده ها"
    pub consumers: int = 0
end

@en "PubAck"
@fa "تاییدیه انتشار"
pub struct PubAck:
    @en "ok"
    @fa "سالم"
    pub ok: bool = false
    @en "err"
    @fa "خطا"
    pub err: str = ""
    @en "stream"
    @fa "جریان"
    pub stream: str = ""
    @en "seq"
    @fa "شماره"
    pub seq: int = 0
    @en "duplicate"
    @fa "تکراری"
    pub duplicate: bool = false
end

@en "Batch"
@fa "دسته"
pub struct Batch:
    @en "msgs"
    @fa "پیام ها"
    pub msgs: Vector<Msg> = Vector {} as Vector<Msg>
    @en "err"
    @fa "خطا"
    pub err: str = ""
end

@en "KVEntry"
@fa "ورودی کی‌وی"
pub struct KVEntry:
    @en "ok"
    @fa "سالم"
    pub ok: bool = false
    @en "found"
    @fa "یافت شد"
    pub found: bool = false
    @en "deleted"
    @fa "حذف شده"
    pub deleted: bool = false
    @en "key"
    @fa "کلید"
    pub key: str = ""
    @en "value"
    @fa "مقدار"
    pub value: str = ""
    @en "revision"
    @fa "ویرایش"
    pub revision: int = 0
    @en "err"
    @fa "خطا"
    pub err: str = ""
end

func _unquote(v: str): str:
    if v.Len() >= 2 and v.StartsWith("\"") and v.EndsWith("\""):
        ret v.Substr(1, v.Len() - 2)
    end
    ret v
end

func _js_result(m: Msg): JSResult:
    mut r := JSResult {}
    if not m.ok:
        r.err = m.err
        ret r
    end
    r.raw = m.data
    e := json.Get(m.data, "error")
    if e.Len() > 0:
        r.code = json.GetInt(e, "err_code")
        r.err = _unquote(json.Get(e, "description"))
        if r.err.Len() == 0:
            r.err = e
        end
        ret r
    end
    r.ok = true
    ret r
end

func _unb64(v: str): str:
    mut out := ""
    try:
        out = encoding.Base64Decode(v)
    catch:
        out = ""
    end
    ret out
end

func _str_array(items: Vector<str>): str:
    mut out := "["
    repeat items.Len() in i:
        if i > 0:
            out += ","
        end
        out += json.Str(items.Get(i))
    end
    ret out + "]"
end

@en "JSRequest"
@fa "درخواست جت‌استریم"
pub func JSRequest(nc &: Conn, api: str, body: str, timeout_ms: int): JSResult:
    ret _js_result(Request(nc, JS_API + api, body, timeout_ms))
end

@en "AddStream"
@fa "افزودن جریان"
pub func AddStream(nc &: Conn, name: str, subjects: Vector<str>, timeout_ms: int): JSResult:
    body := "{" + json.Member("name", name) + `,"subjects":` + _str_array(subjects) + `,"storage":"file","retention":"limits"}`
    ret JSRequest(nc, "STREAM.CREATE." + name, body, timeout_ms)
end

@en "DeleteStream"
@fa "حذف جریان"
pub func DeleteStream(nc &: Conn, name: str, timeout_ms: int): JSResult:
    ret JSRequest(nc, "STREAM.DELETE." + name, "", timeout_ms)
end

@en "PurgeStream"
@fa "پاکسازی جریان"
pub func PurgeStream(nc &: Conn, name: str, timeout_ms: int): JSResult:
    ret JSRequest(nc, "STREAM.PURGE." + name, "", timeout_ms)
end

@en "StreamInfo"
@fa "اطلاعات جریان"
pub func StreamInfo(nc &: Conn, name: str, timeout_ms: int): StreamState:
    mut s := StreamState {}
    r := JSRequest(nc, "STREAM.INFO." + name, "", timeout_ms)
    if not r.ok:
        s.err = r.err
        ret s
    end
    st := json.Get(r.raw, "state")
    s.ok = true
    s.name = name
    s.messages = json.GetInt(st, "messages")
    s.bytes = json.GetInt(st, "bytes")
    s.first_seq = json.GetInt(st, "first_seq")
    s.last_seq = json.GetInt(st, "last_seq")
    s.consumers = json.GetInt(st, "consumer_count")
    ret s
end

@en "JSPublish"
@fa "انتشار جت‌استریم"
pub func JSPublish(nc &: Conn, subject: str, data: str, timeout_ms: int): PubAck:
    ret JSPublishHeaders(nc, subject, Header {}, data, timeout_ms)
end

@en "JSPublishHeaders"
@fa "انتشار جت‌استریم با سرآیند"
pub func JSPublishHeaders(nc &: Conn, subject: str, h: Header, data: str, timeout_ms: int): PubAck:
    mut a := PubAck {}
    r := _js_result(RequestMsg(nc, subject, h, data, timeout_ms))
    if not r.ok:
        a.err = r.err
        ret a
    end
    a.ok = true
    a.stream = _unquote(json.Get(r.raw, "stream"))
    a.seq = json.GetInt(r.raw, "seq")
    a.duplicate = json.Get(r.raw, "duplicate") == "true"
    ret a
end

@en "AddConsumer"
@fa "افزودن مصرف‌کننده"
pub func AddConsumer(nc &: Conn, stream: str, durable: str, filter: str, timeout_ms: int): JSResult:
    mut cfg := "{" + json.Member("durable_name", durable) + `,"ack_policy":"explicit"`
    if filter.Len() > 0:
        cfg += "," + json.Member("filter_subject", filter)
    end
    cfg += "}"
    body := "{" + json.Member("stream_name", stream) + `,"config":` + cfg + "}"
    ret JSRequest(nc, "CONSUMER.DURABLE.CREATE." + stream + "." + durable, body, timeout_ms)
end

@en "DeleteConsumer"
@fa "حذف مصرف‌کننده"
pub func DeleteConsumer(nc &: Conn, stream: str, durable: str, timeout_ms: int): JSResult:
    ret JSRequest(nc, "CONSUMER.DELETE." + stream + "." + durable, "", timeout_ms)
end

@en "Fetch"
@fa "واکشی"
pub func Fetch(nc &: Conn, stream: str, durable: str, batch: int, timeout_ms: int): Batch:
    mut out := Batch {}
    inbox := NewInbox(nc)
    s := Subscribe(nc, inbox)
    if not s.ok:
        out.err = nc.err
        ret out
    end
    body := "{" + json.MemberInt("batch", batch as i64) + "," + json.MemberInt("expires", (timeout_ms as i64) * 900000 as i64) + "}"
    subject := JS_API + "CONSUMER.MSG.NEXT." + stream + "." + durable
    if not PublishRequest(nc, subject, inbox, body):
        out.err = nc.err
        Unsubscribe(nc, s)
        ret out
    end
    until out.msgs.Len() < batch:
        m := NextMsg(nc, s, timeout_ms)
        if not m.ok:
            if out.msgs.Len() == 0:
                out.err = m.err
            end
            break
        end
        if m.status == 404 or m.status == 408 or m.status == 409:
            if out.msgs.Len() == 0:
                out.err = m.status_text.Len() > 0 ? m.status_text : conv.FormatInt(m.status as i64)
            end
            break
        end
        if m.status == STATUS_IDLE_HEARTBEAT:
            continue
        end
        out.msgs.Push(m)
    end
    Unsubscribe(nc, s)
    ret out
end

@en "Ack"
@fa "تایید"
pub func Ack(nc &: Conn, m: Msg): bool:
    ret Respond(nc, m, "+ACK")
end

@en "Nak"
@fa "رد"
pub func Nak(nc &: Conn, m: Msg): bool:
    ret Respond(nc, m, "-NAK")
end

@en "Term"
@fa "خاتمه"
pub func Term(nc &: Conn, m: Msg): bool:
    ret Respond(nc, m, "+TERM")
end

@en "InProgress"
@fa "ادامه کار"
pub func InProgress(nc &: Conn, m: Msg): bool:
    ret Respond(nc, m, "+WPI")
end

@en "MsgSequence"
@fa "شماره پیام جریان"
pub func MsgSequence(m: Msg): int:
    parts := m.reply.Split(".")
    defer parts.Free()
    if parts.Len() >= 9:
        ret parts.Get(5).ToInt()
    end
    ret 0
end

@en "AddPushConsumer"
@fa "افزودن مصرف‌کننده فشاری"
pub func AddPushConsumer(nc &: Conn, stream: str, durable: str, filter: str, deliver: str, queue: str, timeout_ms: int): JSResult:
    mut cfg := "{" + json.Member("durable_name", durable) + "," + json.Member("deliver_subject", deliver) + `,"ack_policy":"explicit"`
    if filter.Len() > 0:
        cfg += "," + json.Member("filter_subject", filter)
    end
    if queue.Len() > 0:
        cfg += "," + json.Member("deliver_group", queue)
    else:
        cfg += `,"flow_control":true,"idle_heartbeat":5000000000`
    end
    cfg += "}"
    body := "{" + json.Member("stream_name", stream) + `,"config":` + cfg + "}"
    ret JSRequest(nc, "CONSUMER.DURABLE.CREATE." + stream + "." + durable, body, timeout_ms)
end

@en "NextPush"
@fa "پیام فشاری بعدی"
pub func NextPush(nc &: Conn, s: Subscription, timeout_ms: int): Msg:
    deadline := _now() + timeout_ms as i64
    until true:
        left := deadline - _now()
        if left <= 0:
            break
        end
        m := NextMsg(nc, s, left as int)
        if not m.ok:
            ret m
        end
        if m.status == STATUS_IDLE_HEARTBEAT:
            if m.reply.Len() > 0:
                Respond(nc, m, "")
            end
            continue
        end
        ret m
    end
    mut t := Msg {}
    t.err = "timeout"
    ret t
end

@en "KVCreate"
@fa "ساخت سطل کی‌وی"
pub func KVCreate(nc &: Conn, bucket: str, history: int, timeout_ms: int): JSResult:
    keep := history > 0 ? history : 1
    mut subjects := Vector {} as Vector<str>
    defer subjects.Free()
    subjects.Push("$KV." + bucket + ".>")
    body := "{" + json.Member("name", "KV_" + bucket) + `,"subjects":` + _str_array(subjects) + `,"max_msgs_per_subject":` + conv.FormatInt(keep as i64) + `,"discard":"new","allow_rollup_hdr":true,"deny_delete":true,"allow_direct":true,"storage":"file","retention":"limits"}`
    ret JSRequest(nc, "STREAM.CREATE.KV_" + bucket, body, timeout_ms)
end

@en "KVDeleteBucket"
@fa "حذف سطل کی‌وی"
pub func KVDeleteBucket(nc &: Conn, bucket: str, timeout_ms: int): JSResult:
    ret DeleteStream(nc, "KV_" + bucket, timeout_ms)
end

@en "KVPut"
@fa "نوشتن کی‌وی"
pub func KVPut(nc &: Conn, bucket: str, key: str, value: str, timeout_ms: int): PubAck:
    subject := "$KV." + bucket + "." + key
    if not ValidSubject(subject):
        mut bad := PubAck {}
        bad.err = "invalid key"
        ret bad
    end
    ret JSPublish(nc, subject, value, timeout_ms)
end

@en "KVGet"
@fa "خواندن کی‌وی"
pub func KVGet(nc &: Conn, bucket: str, key: str, timeout_ms: int): KVEntry:
    mut e := KVEntry {}
    e.key = key
    subject := "$KV." + bucket + "." + key
    if not ValidSubject(subject):
        e.err = "invalid key"
        ret e
    end
    r := JSRequest(nc, "STREAM.MSG.GET.KV_" + bucket, "{" + json.Member("last_by_subj", subject) + "}", timeout_ms)
    if not r.ok:
        e.err = r.code == 10037 ? "key not found" : r.err
        e.ok = r.code == 10037
        ret e
    end
    msg := json.Get(r.raw, "message")
    hdrs := _unb64(_unquote(json.Get(msg, "hdrs")))
    e.ok = true
    e.revision = json.GetInt(msg, "seq")
    if hdrs.Find("KV-Operation: DEL") >= 0 or hdrs.Find("KV-Operation: PURGE") >= 0:
        e.deleted = true
        e.err = "key not found"
        ret e
    end
    e.found = true
    e.value = _unb64(_unquote(json.Get(msg, "data")))
    ret e
end

@en "KVDelete"
@fa "حذف کی‌وی"
pub func KVDelete(nc &: Conn, bucket: str, key: str, timeout_ms: int): PubAck:
    subject := "$KV." + bucket + "." + key
    if not ValidSubject(subject):
        mut bad := PubAck {}
        bad.err = "invalid key"
        ret bad
    end
    mut h := NewHeader()
    HeaderAdd(h, "KV-Operation", "DEL")
    ret JSPublishHeaders(nc, subject, h, "", timeout_ms)
end
