@en "net/nats"
@fa "نتس"
package nats

import net.tcp
import net.internal.rawsock
import tls
import str
import conv
import rand
import sync
import encoding.json

const VERSION := "0.1.0"
const DEFAULT_PORT := 4222
const STATUS_NO_RESPONDERS := 503
const STATUS_IDLE_HEARTBEAT := 100

const KIND_QUEUE := 0
const KIND_HANDLER := 1
const KIND_REPLIER := 2

@en "Header"
@fa "سرآیند"
pub struct Header:
    @en "keys"
    @fa "کلیدها"
    pub keys: Vector<str> = Vector {} as Vector<str>
    @en "values"
    @fa "مقدارها"
    pub values: Vector<str> = Vector {} as Vector<str>
end

@en "Msg"
@fa "پیام"
pub struct Msg:
    @en "ok"
    @fa "سالم"
    pub ok: bool = false
    @en "err"
    @fa "خطا"
    pub err: str = ""
    @en "subject"
    @fa "موضوع"
    pub subject: str = ""
    @en "reply"
    @fa "پاسخ به"
    pub reply: str = ""
    @en "data"
    @fa "داده"
    pub data: str = ""
    @en "header"
    @fa "سرآیند"
    pub header: Header = Header {}
    @en "sid"
    @fa "شناسه اشتراک"
    pub sid: int = 0
    @en "status"
    @fa "وضعیت"
    pub status: int = 0
    @en "status_text"
    @fa "متن وضعیت"
    pub status_text: str = ""
end

@en "Subscription"
@fa "نشانگر اشتراک"
pub struct Subscription:
    @en "ok"
    @fa "سالم"
    pub ok: bool = false
    @en "sid"
    @fa "شناسه"
    pub sid: int = 0
    @en "subject"
    @fa "موضوع"
    pub subject: str = ""
    @en "queue"
    @fa "صف"
    pub queue: str = ""
end

@en "ServerInfo"
@fa "اطلاعات کارگزار"
pub struct ServerInfo:
    @en "server_id"
    @fa "شناسه کارگزار"
    pub server_id: str = ""
    @en "server_name"
    @fa "نام کارگزار"
    pub server_name: str = ""
    @en "version"
    @fa "نگارش"
    pub version: str = ""
    @en "host"
    @fa "میزبان"
    pub host: str = ""
    @en "port"
    @fa "درگاه"
    pub port: int = 0
    @en "proto"
    @fa "پروتکل"
    pub proto: int = 0
    @en "client_id"
    @fa "شناسه کارخواه"
    pub client_id: int = 0
    @en "max_payload"
    @fa "بیشینه اندازه بار"
    pub max_payload: int = 1048576
    @en "headers"
    @fa "سرآیند پشتیبانی"
    pub headers: bool = false
    @en "tls_required"
    @fa "تی‌ال‌اس لازم"
    pub tls_required: bool = false
    @en "auth_required"
    @fa "احراز هویت لازم"
    pub auth_required: bool = false
    @en "jetstream"
    @fa "جت‌استریم"
    pub jetstream: bool = false
    @en "raw"
    @fa "خام"
    pub raw: str = ""
end

@en "Options"
@fa "گزینه ها"
pub struct Options:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "user"
    @fa "کاربر"
    pub user: str = ""
    @en "password"
    @fa "گذرواژه"
    pub password: str = ""
    @en "token"
    @fa "توکن"
    pub token: str = ""
    @en "no_echo"
    @fa "بدون پژواک"
    pub no_echo: bool = false
    @en "verbose"
    @fa "پرگو"
    pub verbose: bool = false
    @en "pedantic"
    @fa "سختگیر"
    pub pedantic: bool = false
    @en "secure"
    @fa "امن"
    pub secure: bool = false
    @en "insecure_skip_verify"
    @fa "بدون راستی آزمایی"
    pub insecure_skip_verify: bool = false
    @en "timeout_ms"
    @fa "مهلت میلی‌ثانیه"
    pub timeout_ms: int = 5000
    @en "ping_interval_ms"
    @fa "فاصله پینگ میلی‌ثانیه"
    pub ping_interval_ms: int = 120000
    @en "max_pings_out"
    @fa "بیشینه پینگ بی‌پاسخ"
    pub max_pings_out: int = 2
    @en "inbox_prefix"
    @fa "پیشوند صندوق"
    pub inbox_prefix: str = "_INBOX"
    @en "servers"
    @fa "کارگزارها"
    pub servers: Vector<str> = Vector {} as Vector<str>
    @en "max_reconnects"
    @fa "بیشینه اتصال دوباره"
    pub max_reconnects: int = 0
    @en "reconnect_wait_ms"
    @fa "انتظار اتصال دوباره میلی‌ثانیه"
    pub reconnect_wait_ms: int = 2000
    @en "reconnect_buffer"
    @fa "بافر اتصال دوباره"
    pub reconnect_buffer: int = 8388608
end

@en "Stats"
@fa "آمار"
pub struct Stats:
    @en "in_msgs"
    @fa "پیام ورودی"
    pub in_msgs: i64 = 0
    @en "out_msgs"
    @fa "پیام خروجی"
    pub out_msgs: i64 = 0
    @en "in_bytes"
    @fa "بایت ورودی"
    pub in_bytes: i64 = 0
    @en "out_bytes"
    @fa "بایت خروجی"
    pub out_bytes: i64 = 0
end

@en "Conn"
@fa "اتصال نتس"
pub struct Conn:
    @en "ok"
    @fa "سالم"
    pub ok: bool = false
    @en "closed"
    @fa "قطع شده"
    pub closed: bool = false
    @en "draining"
    @fa "تخلیه شدن"
    pub draining: bool = false
    @en "err"
    @fa "خطا"
    pub err: str = ""
    @en "url"
    @fa "نشانی"
    pub url: str = ""
    @en "info"
    @fa "اطلاعات"
    pub info: ServerInfo = ServerInfo {}
    @en "opts"
    @fa "گزینه ها"
    pub opts: Options = Options {}
    @en "stats"
    @fa "آمار"
    pub stats: Stats = Stats {}
    pub _plain: tcp.Conn = tcp.Conn {}
    pub _tc: tls.Conn = tls.Conn {}
    pub _secure: bool = false
    pub _buf: str = ""
    pub _pos: int = 0
    pub _next_sid: int = 1
    pub _pings_sent: int = 0
    pub _pongs_recv: int = 0
    pub _last_activity: i64 = 0
    pub _sub_sid: Vector<int> = Vector {} as Vector<int>
    pub _sub_subject: Vector<str> = Vector {} as Vector<str>
    pub _sub_queue: Vector<str> = Vector {} as Vector<str>
    pub _sub_kind: Vector<int> = Vector {} as Vector<int>
    pub _sub_max: Vector<int> = Vector {} as Vector<int>
    pub _sub_count: Vector<int> = Vector {} as Vector<int>
    pub _sub_slot: Vector<int> = Vector {} as Vector<int>
    pub _handlers: Vector<func (Msg)> = Vector {} as Vector<func (Msg)>
    pub _repliers: Vector<func (Msg) str> = Vector {} as Vector<func (Msg) str>
    pub _inbox: Vector<Msg> = Vector {} as Vector<Msg>
    pub _pool: Vector<str> = Vector {} as Vector<str>
    pub _sockopen: bool = false
    pub _opening: bool = false
    pub _reconnecting: bool = false
    pub _reconnects: int = 0
    pub _attempts: int = 0
    pub _last_attempt: i64 = 0
    pub _srv_idx: int = 0
    pub _pending: str = ""
end

func _now(): i64:
    ret sync.NowMs()
end

func _close_sock(nc &: Conn):
    if not nc._sockopen:
        ret
    end
    nc._sockopen = false
    if nc._secure:
        tls.Close(nc._tc)
    else:
        tcp.Close(nc._plain)
    end
    nc._secure = false
end

func _shutdown(nc &: Conn):
    if nc.closed:
        ret
    end
    nc.closed = true
    nc.ok = false
    nc._reconnecting = false
    nc._pending = ""
    _close_sock(nc)
end

func _lost(nc &: Conn):
    if nc._opening:
        nc.ok = false
        _close_sock(nc)
        ret
    end
    if nc.closed or nc._reconnecting:
        ret
    end
    if nc.draining or nc.opts.max_reconnects == 0:
        _shutdown(nc)
        ret
    end
    _close_sock(nc)
    nc.ok = false
    nc._reconnecting = true
    nc._attempts = 0
    nc._last_attempt = 0
    nc._buf = ""
    nc._pos = 0
end

func _write(nc &: Conn, data: str): bool:
    if nc.closed:
        nc.err = "connection closed"
        ret false
    end
    if (nc._reconnecting and not nc._opening) or not nc._sockopen:
        nc.err = "reconnecting"
        ret false
    end
    mut n := 0
    if nc._secure:
        n = tls.Write(nc._tc, data)
    else:
        n = tcp.Write(nc._plain, data)
    end
    if n < data.len():
        nc.err = "write failed"
        _lost(nc)
        ret false
    end
    nc._last_activity = _now()
    ret true
end

func _write_pub(nc &: Conn, frame: str): bool:
    if not nc._reconnecting:
        if _write(nc, frame):
            ret true
        end
        if not nc._reconnecting:
            ret false
        end
    end
    if nc._pending.len() + frame.len() > nc.opts.reconnect_buffer:
        nc.err = "reconnect buffer full"
        ret false
    end
    nc._pending += frame
    ret true
end

func _fill(nc &: Conn, timeout_ms: int): int:
    if nc.closed or (nc._reconnecting and not nc._opening) or not nc._sockopen:
        ret 0 - 1
    end
    mut chunk := ""
    if nc._secure:
        if not tls.Readable(nc._tc):
            if not rawsock.WaitReadable(rawsock.FromFd(tls.Fd(nc._tc)), timeout_ms):
                ret 0
            end
        end
        chunk = tls.Read(nc._tc, 65536)
    else:
        if not rawsock.WaitReadable(rawsock.FromFd(nc._plain.fd), timeout_ms):
            ret 0
        end
        chunk = tcp.Read(nc._plain, 65536)
    end
    if chunk.len() == 0:
        if nc.err.len() == 0:
            nc.err = "connection lost"
        end
        _lost(nc)
        ret 0 - 1
    end
    nc._buf += chunk
    nc._last_activity = _now()
    ret chunk.len()
end

func _find_sub(nc: Conn, sid: int): int:
    repeat nc._sub_sid.len() in i:
        if nc._sub_sid.get(i) == sid:
            ret i
        end
    end
    ret 0 - 1
end

func _tombstone(nc &: Conn, idx: int):
    nc._sub_sid.set(idx, 0 - nc._sub_sid.get(idx))
end

func _deliver(nc &: Conn, m: Msg):
    idx := _find_sub(nc, m.sid)
    if idx < 0:
        ret
    end
    nc.stats.in_msgs++
    nc.stats.in_bytes += m.data.len() as i64
    cnt := nc._sub_count.get(idx) + 1
    nc._sub_count.set(idx, cnt)
    kind := nc._sub_kind.get(idx)
    slot := nc._sub_slot.get(idx)
    mx := nc._sub_max.get(idx)
    if mx > 0 and cnt >= mx:
        _tombstone(nc, idx)
    end
    if kind == KIND_HANDLER:
        h := nc._handlers.get(slot)
        h(m)
    else kind == KIND_REPLIER:
        r := nc._repliers.get(slot)
        answer := r(m)
        if m.reply.len() > 0:
            _publish_raw(nc, m.reply, "", Header {}, false, answer)
        end
    else:
        nc._inbox.push(m)
    end
end

func _split_args(line: str): Vector<str>:
    ret str.Fields(line)
end

func _handle_err(nc &: Conn, line: str):
    mut text := str.Trim(line.substr(4, line.len() - 4))
    if text.len() >= 2 and text.starts_with("'"):
        text = text.substr(1, text.len() - 2)
    end
    nc.err = text
    low := str.Lower(text)
    if low.find("authorization") >= 0 or low.find("authentication") >= 0 or low.find("stale connection") >= 0 or low.find("maximum connections") >= 0:
        _shutdown(nc)
    end
end

func _parse_info(line: str): ServerInfo:
    mut s := ServerInfo {}
    body := str.Trim(line.substr(4, line.len() - 4))
    s.raw = body
    s.server_id = json.Get(body, "server_id")
    s.server_name = json.Get(body, "server_name")
    s.version = json.Get(body, "version")
    s.host = json.Get(body, "host")
    s.port = json.GetInt(body, "port")
    s.proto = json.GetInt(body, "proto")
    s.client_id = json.GetInt(body, "client_id")
    mp := json.GetInt(body, "max_payload")
    if mp > 0:
        s.max_payload = mp
    end
    s.headers = json.Get(body, "headers") == "true"
    s.tls_required = json.Get(body, "tls_required") == "true"
    s.auth_required = json.Get(body, "auth_required") == "true"
    s.jetstream = json.Get(body, "jetstream") == "true"
    ret s
end

func _process(nc &: Conn): int:
    mut handled := 0
    until true:
        eol := str.IndexFrom(nc._buf, "\r\n", nc._pos)
        if eol < 0:
            break
        end
        line := nc._buf.substr(nc._pos, eol - nc._pos)
        after := eol + 2
        if line.starts_with("MSG ") or line.starts_with("HMSG "):
            hm := line.starts_with("HMSG ")
            args := _split_args(line)
            defer args.free()
            want := hm ? 5 : 4
            if args.len() != want and args.len() != want + 1:
                nc.err = "malformed MSG"
                _shutdown(nc)
                break
            end
            has_reply := args.len() == want + 1
            mut hlen := 0
            mut total := 0
            if hm:
                hlen = args.get(has_reply ? 4 : 3).to_int()
                total = args.get(has_reply ? 5 : 4).to_int()
            else:
                total = args.get(has_reply ? 4 : 3).to_int()
            end
            if total < 0 or hlen < 0 or hlen > total:
                nc.err = "malformed MSG size"
                _shutdown(nc)
                break
            end
            if nc._buf.len() - after < total + 2:
                break
            end
            mut m := Msg {}
            m.ok = true
            m.subject = args.get(1)
            m.sid = args.get(2).to_int()
            if has_reply:
                m.reply = args.get(3)
            end
            if hm:
                block := nc._buf.substr(after, hlen)
                mut st := 0
                mut stt := ""
                m.header = HeaderParse(block, st, stt)
                m.status = st
                m.status_text = stt
            end
            m.data = nc._buf.substr(after + hlen, total - hlen)
            nc._pos = after + total + 2
            handled++
            _deliver(nc, m)
            if nc.closed:
                break
            end
        else line.starts_with("PING"):
            nc._pos = after
            _write(nc, "PONG\r\n")
        else line.starts_with("PONG"):
            nc._pos = after
            nc._pongs_recv++
        else line.starts_with("+OK"):
            nc._pos = after
        else line.starts_with("-ERR"):
            nc._pos = after
            _handle_err(nc, line)
            if nc.closed:
                break
            end
        else line.starts_with("INFO "):
            nc._pos = after
            nc.info = _parse_info(line)
        else:
            nc._pos = after
        end
    end
    if nc._pos > 0:
        nc._buf = nc._buf.substr(nc._pos, nc._buf.len() - nc._pos)
        nc._pos = 0
    end
    ret handled
end

func _keepalive(nc &: Conn):
    if nc.closed or nc._reconnecting or nc.opts.ping_interval_ms <= 0:
        ret
    end
    if _now() - nc._last_activity < nc.opts.ping_interval_ms as i64:
        ret
    end
    if nc._pings_sent - nc._pongs_recv > nc.opts.max_pings_out:
        nc.err = "stale connection"
        _lost(nc)
        ret
    end
    nc._pings_sent++
    _write(nc, "PING\r\n")
end

func _parse_url(raw: str, host &: str, port &: int, user &: str, pass &: str, token &: str, use_tls &: bool): bool:
    mut rest := str.Trim(raw)
    use_tls = false
    sc := rest.find("://")
    if sc >= 0:
        scheme := str.Lower(rest.substr(0, sc))
        if scheme == "tls" or scheme == "wss" or scheme == "nats+tls":
            use_tls = true
        else scheme != "nats" and scheme != "tcp":
            ret false
        end
        rest = rest.substr(sc + 3, rest.len() - sc - 3)
    end
    slash := rest.find("/")
    if slash >= 0:
        rest = rest.substr(0, slash)
    end
    at := rest.find("@")
    if at >= 0:
        cred := rest.substr(0, at)
        rest = rest.substr(at + 1, rest.len() - at - 1)
        colon := cred.find(":")
        if colon >= 0:
            user = cred.substr(0, colon)
            pass = cred.substr(colon + 1, cred.len() - colon - 1)
        else:
            token = cred
        end
    end
    port = DEFAULT_PORT
    colon := rest.find(":")
    if colon >= 0:
        port = rest.substr(colon + 1, rest.len() - colon - 1).to_int()
        rest = rest.substr(0, colon)
    end
    host = rest
    ret host.len() > 0 and port > 0
end

func _fail(nc &: Conn, why: str): Conn:
    nc.err = why
    _shutdown(nc)
    ret nc
end

func _connect_json(nc: Conn, user: str, pass: str, token: str): str:
    o := nc.opts
    members := Vector {} as Vector<str>
    defer members.free()
    members.push(json.MemberBool("verbose", o.verbose))
    members.push(json.MemberBool("pedantic", o.pedantic))
    members.push(json.MemberBool("tls_required", nc._secure))
    if o.name.len() > 0:
        members.push(json.Member("name", o.name))
    end
    members.push(json.Member("lang", "salam"))
    members.push(json.Member("version", VERSION))
    members.push(json.MemberInt("protocol", 1 as i64))
    members.push(json.MemberBool("echo", not o.no_echo))
    members.push(json.MemberBool("headers", nc.info.headers))
    members.push(json.MemberBool("no_responders", nc.info.headers))
    if user.len() > 0:
        members.push(json.Member("user", user))
        members.push(json.Member("pass", pass))
    end
    if token.len() > 0:
        members.push(json.Member("auth_token", token))
    end
    ret json.Object(members)
end

func _publish_raw(nc &: Conn, subject: str, reply: str, h: Header, with_header: bool, data: str): bool:
    if nc.closed:
        nc.err = "connection closed"
        ret false
    end
    if not ValidSubject(subject):
        nc.err = "invalid subject"
        ret false
    end
    if reply.len() > 0 and not ValidSubject(reply):
        nc.err = "invalid reply subject"
        ret false
    end
    mut line := ""
    mut frame := ""
    mut size := data.len()
    if with_header and h.keys.len() > 0:
        if not nc.info.headers:
            nc.err = "server does not support headers"
            ret false
        end
        hb := HeaderEncode(h)
        size = hb.len() + data.len()
        line = "HPUB " + subject + (reply.len() > 0 ? " " + reply : "") + " " + conv.FormatInt(hb.len() as i64) + " " + conv.FormatInt(size as i64)
        frame = line + "\r\n" + hb + data + "\r\n"
    else:
        line = "PUB " + subject + (reply.len() > 0 ? " " + reply : "") + " " + conv.FormatInt(size as i64)
        frame = line + "\r\n" + data + "\r\n"
    end
    if size > nc.info.max_payload:
        nc.err = "maximum payload exceeded"
        ret false
    end
    if not _write_pub(nc, frame):
        ret false
    end
    nc.stats.out_msgs++
    nc.stats.out_bytes += size as i64
    ret true
end

func _add_sub(nc &: Conn, subject: str, queue: str, kind: int, slot: int): Subscription:
    mut s := Subscription {}
    if nc.closed or nc.draining:
        nc.err = nc.closed ? "connection closed" : "connection draining"
        ret s
    end
    if not ValidSubject(subject) or queue.find(" ") >= 0:
        nc.err = "invalid subject"
        ret s
    end
    sid := nc._next_sid
    line := "SUB " + subject + (queue.len() > 0 ? " " + queue : "") + " " + conv.FormatInt(sid as i64) + "\r\n"
    if not nc._reconnecting:
        if not _write(nc, line):
            if not nc._reconnecting:
                ret s
            end
        end
    end
    nc._next_sid++
    nc._sub_sid.push(sid)
    nc._sub_subject.push(subject)
    nc._sub_queue.push(queue)
    nc._sub_kind.push(kind)
    nc._sub_max.push(0)
    nc._sub_count.push(0)
    nc._sub_slot.push(slot)
    s.ok = true
    s.sid = sid
    s.subject = subject
    s.queue = queue
    ret s
end

func _drop_inbox(nc &: Conn, sid: int):
    mut i := nc._inbox.len() - 1
    until i >= 0:
        if nc._inbox.get(i).sid == sid:
            nc._inbox.remove_at(i)
        end
        i--
    end
end

func _take(nc &: Conn, sid: int): Msg:
    repeat nc._inbox.len() in i:
        if nc._inbox.get(i).sid == sid:
            m := nc._inbox.get(i)
            nc._inbox.remove_at(i)
            ret m
        end
    end
    ret Msg {}
end

func _open(nc &: Conn, url: str): bool:
    opts := nc.opts
    mut host := ""
    mut port := DEFAULT_PORT
    mut user := opts.user
    mut pass := opts.password
    mut token := opts.token
    mut want_tls := opts.secure
    mut url_tls := false
    if not _parse_url(url, host, port, user, pass, token, url_tls):
        nc.err = "invalid url"
        ret false
    end
    if url_tls:
        want_tls = true
    end
    tmo := opts.timeout_ms > 0 ? opts.timeout_ms : 5000
    nc._buf = ""
    nc._pos = 0
    nc._secure = false
    nc._plain = tcp.DialTimeout(host, port, tmo)
    if not tcp.ConnOk(nc._plain):
        nc.err = "could not connect to " + host + ":" + conv.FormatInt(port as i64)
        ret false
    end
    nc._sockopen = true
    nc._opening = true
    nc.url = url
    deadline := _now() + tmo as i64
    until true:
        if str.IndexFrom(nc._buf, "\r\n", 0) >= 0:
            if not nc._buf.starts_with("INFO "):
                nc.err = "expected INFO from server"
                _close_sock(nc)
                nc._opening = false
                ret false
            end
            eol := nc._buf.find("\r\n")
            nc.info = _parse_info(nc._buf.substr(0, eol))
            nc._buf = nc._buf.substr(eol + 2, nc._buf.len() - eol - 2)
            break
        end
        left := deadline - _now()
        if left <= 0:
            nc.err = "timeout waiting for INFO"
            _close_sock(nc)
            nc._opening = false
            ret false
        end
        if _fill(nc, left as int) < 0:
            nc.err = "connection lost before INFO"
            _close_sock(nc)
            nc._opening = false
            ret false
        end
    end
    if nc.info.tls_required or want_tls:
        mut cfg := tls.NewConfig(host)
        cfg.insecure_skip_verify = opts.insecure_skip_verify
        nc._tc = tcp.UpgradeTLS(nc._plain, cfg)
        if not tls.ConnOk(nc._tc):
            nc.err = "tls handshake failed: " + tls.ConnError(nc._tc)
            _close_sock(nc)
            nc._opening = false
            ret false
        end
        nc._secure = true
    end
    if nc.info.auth_required and user.len() == 0 and token.len() == 0:
        nc.err = "authorization required"
        _close_sock(nc)
        nc._opening = false
        ret false
    end
    cj := _connect_json(nc, user, pass, token)
    nc._pings_sent = 1
    nc._pongs_recv = 0
    if not _write(nc, "CONNECT " + cj + "\r\nPING\r\n"):
        nc._opening = false
        ret false
    end
    until nc._pongs_recv >= 1:
        left := deadline - _now()
        if left <= 0:
            nc.err = "timeout waiting for PONG"
            _close_sock(nc)
            nc._opening = false
            ret false
        end
        _process(nc)
        if nc.closed:
            nc._opening = false
            ret false
        end
        if nc._pongs_recv < 1:
            if _fill(nc, left as int) < 0:
                if nc.err.len() == 0 or nc.err == "connection lost":
                    nc.err = "connection lost during handshake"
                end
                nc._opening = false
                ret false
            end
        end
    end
    nc._opening = false
    nc.ok = true
    nc._last_activity = _now()
    ret true
end

func _resubscribe(nc &: Conn): bool:
    mut out := ""
    repeat nc._sub_sid.len() in i:
        sid := nc._sub_sid.get(i)
        if sid <= 0:
            continue
        end
        out += "SUB " + nc._sub_subject.get(i) + (nc._sub_queue.get(i).len() > 0 ? " " + nc._sub_queue.get(i) : "") + " " + conv.FormatInt(sid as i64) + "\r\n"
        mx := nc._sub_max.get(i)
        if mx > 0:
            left := mx - nc._sub_count.get(i)
            if left > 0:
                out += "UNSUB " + conv.FormatInt(sid as i64) + " " + conv.FormatInt(left as i64) + "\r\n"
            end
        end
    end
    if nc._pending.len() > 0:
        out += nc._pending
    end
    if out.len() == 0:
        ret true
    end
    if not _write(nc, out):
        ret false
    end
    nc._pending = ""
    ret true
end

func _reconnect(nc &: Conn, timeout_ms: int): bool:
    deadline := _now() + timeout_ms as i64
    if not nc._reconnecting or nc.closed:
        ret nc.ok
    end
    until true:
        mx := nc.opts.max_reconnects
        if mx > 0 and nc._attempts >= mx:
            nc.err = "maximum reconnects exceeded"
            _shutdown(nc)
            ret false
        end
        wait := nc.opts.reconnect_wait_ms
        since := _now() - nc._last_attempt
        if nc._last_attempt > 0 and since < wait as i64:
            mut pause := wait as i64 - since
            left := deadline - _now()
            if pause > left:
                pause = left
            end
            if pause > 0:
                sync.SleepMs(pause as int)
            end
            if _now() - nc._last_attempt < wait as i64:
                ret false
            end
        end
        nc._last_attempt = _now()
        url := nc._pool.get(nc._srv_idx % nc._pool.len())
        nc._srv_idx++
        nc._attempts++
        if _open(nc, url):
            nc._reconnecting = false
            nc._reconnects++
            nc._attempts = 0
            if not _resubscribe(nc):
                ret false
            end
            ret true
        end
        if nc.closed:
            ret false
        end
        if _now() >= deadline:
            ret false
        end
    end
end

@en "DefaultOptions"
@fa "گزینه های پیش‌فرض"
pub func DefaultOptions(): Options:
    ret Options {}
end

@en "NewHeader"
@fa "سرآیند تازه"
pub func NewHeader(): Header:
    ret Header {}
end

@en "HeaderAdd"
@fa "افزودن سرآیند"
pub func HeaderAdd(h &: Header, key: str, value: str):
    h.keys.push(key)
    h.values.push(value)
end

@en "HeaderDel"
@fa "حذف سرآیند"
pub func HeaderDel(h &: Header, key: str):
    mut i := h.keys.len() - 1
    until i >= 0:
        if str.Lower(h.keys.get(i)) == str.Lower(key):
            h.keys.remove_at(i)
            h.values.remove_at(i)
        end
        i--
    end
end

@en "HeaderSet"
@fa "تنظیم سرآیند"
pub func HeaderSet(h &: Header, key: str, value: str):
    HeaderDel(h, key)
    HeaderAdd(h, key, value)
end

@en "HeaderGet"
@fa "گرفتن سرآیند"
pub func HeaderGet(h: Header, key: str): str:
    repeat h.keys.len() in i:
        if str.Lower(h.keys.get(i)) == str.Lower(key):
            ret h.values.get(i)
        end
    end
    ret ""
end

@en "HeaderValues"
@fa "مقدارهای سرآیند"
pub func HeaderValues(h: Header, key: str): Vector<str>:
    out := Vector {} as Vector<str>
    repeat h.keys.len() in i:
        if str.Lower(h.keys.get(i)) == str.Lower(key):
            out.push(h.values.get(i))
        end
    end
    ret out
end

@en "HeaderHas"
@fa "سرآیند دارد"
pub func HeaderHas(h: Header, key: str): bool:
    repeat h.keys.len() in i:
        if str.Lower(h.keys.get(i)) == str.Lower(key):
            ret true
        end
    end
    ret false
end

@en "HeaderCount"
@fa "شمار سرآیند"
pub func HeaderCount(h: Header): int:
    ret h.keys.len()
end

@en "HeaderEncode"
@fa "رمزگذاری سرآیند"
pub func HeaderEncode(h: Header): str:
    mut out := "NATS/1.0\r\n"
    repeat h.keys.len() in i:
        out += h.keys.get(i) + ": " + h.values.get(i) + "\r\n"
    end
    ret out + "\r\n"
end

@en "HeaderParse"
@fa "تجزیه سرآیند"
pub func HeaderParse(block: str, status &: int, status_text &: str): Header:
    mut h := Header {}
    status = 0
    status_text = ""
    lines := block.split("\r\n")
    defer lines.free()
    repeat lines.len() in i:
        line := lines.get(i)
        if i == 0:
            if line.len() > 9:
                rest := str.Trim(line.substr(8, line.len() - 8))
                sp := rest.find(" ")
                if sp < 0:
                    status = rest.to_int()
                else:
                    status = rest.substr(0, sp).to_int()
                    status_text = str.Trim(rest.substr(sp + 1, rest.len() - sp - 1))
                end
            end
        else line.len() > 0:
            colon := line.find(":")
            if colon > 0:
                HeaderAdd(h, line.substr(0, colon), str.Trim(line.substr(colon + 1, line.len() - colon - 1)))
            end
        end
    end
    ret h
end

@en "NewInbox"
@fa "صندوق تازه"
pub func NewInbox(nc: Conn): str:
    mut prefix := nc.opts.inbox_prefix
    if prefix.len() == 0:
        prefix = "_INBOX"
    end
    ret prefix + "." + rand.Alnum(22)
end

@en "ValidSubject"
@fa "موضوع معتبر"
pub func ValidSubject(subject: str): bool:
    if subject.len() == 0:
        ret false
    end
    repeat subject.len() in i:
        c := char_code(subject.substr(i, 1))
        if c <= 32 or c == 127:
            ret false
        end
    end
    if subject.starts_with(".") or subject.ends_with("."):
        ret false
    end
    ret subject.find("..") < 0
end

@en "SubjectMatches"
@fa "تطبیق موضوع"
pub func SubjectMatches(pattern: str, subject: str): bool:
    pt := pattern.split(".")
    st := subject.split(".")
    defer pt.free()
    defer st.free()
    repeat pt.len() in i:
        p := pt.get(i)
        if p == ">":
            ret i < st.len()
        end
        if i >= st.len():
            ret false
        end
        if p != "*" and p != st.get(i):
            ret false
        end
    end
    ret pt.len() == st.len()
end

@en "Pump"
@fa "پردازش"
pub func Pump(nc &: Conn, timeout_ms: int): int:
    if nc._reconnecting:
        _reconnect(nc, timeout_ms)
        ret 0
    end
    mut handled := _process(nc)
    if handled > 0 or nc.closed:
        ret handled
    end
    r := _fill(nc, timeout_ms)
    if r > 0:
        handled = _process(nc)
    end
    _keepalive(nc)
    ret handled
end

@en "Connect"
@fa "برقراری اتصال"
pub func Connect(url: str): Conn:
    ret ConnectWith(url, Options {})
end

@en "ConnectWith"
@fa "برقراری اتصال با گزینه"
pub func ConnectWith(url: str, opts: Options): Conn:
    rand.SeedAuto()
    mut nc := Conn {}
    nc.url = url
    nc.opts = opts
    nc._pool.push(url)
    each sv in opts.servers:
        nc._pool.push(sv)
    end
    mut last := ""
    repeat nc._pool.len() in i:
        if _open(nc, nc._pool.get(i)):
            nc._srv_idx = i + 1
            ret nc
        end
        last = nc.err
        if nc.closed:
            ret nc
        end
    end
    ret _fail(nc, last)
end

@en "IsConnected"
@fa "وصل است"
pub func IsConnected(nc: Conn): bool:
    ret nc.ok and not nc.closed
end

@en "IsClosed"
@fa "بسته شده است"
pub func IsClosed(nc: Conn): bool:
    ret nc.closed
end

@en "LastError"
@fa "آخرین خطا"
pub func LastError(nc: Conn): str:
    ret nc.err
end

@en "Close"
@fa "بستن"
pub func Close(nc &: Conn):
    _shutdown(nc)
end

@en "Publish"
@fa "انتشار"
pub func Publish(nc &: Conn, subject: str, data: str): bool:
    if nc.draining and not nc.closed:
        nc.err = "connection draining"
        ret false
    end
    ret _publish_raw(nc, subject, "", Header {}, false, data)
end

@en "PublishRequest"
@fa "انتشار درخواست"
pub func PublishRequest(nc &: Conn, subject: str, reply: str, data: str): bool:
    if nc.draining and not nc.closed:
        nc.err = "connection draining"
        ret false
    end
    ret _publish_raw(nc, subject, reply, Header {}, false, data)
end

@en "PublishHeaders"
@fa "انتشار با سرآیند"
pub func PublishHeaders(nc &: Conn, subject: str, h: Header, data: str): bool:
    if nc.draining and not nc.closed:
        nc.err = "connection draining"
        ret false
    end
    ret _publish_raw(nc, subject, "", h, true, data)
end

@en "PublishMsg"
@fa "انتشار پیام"
pub func PublishMsg(nc &: Conn, m: Msg): bool:
    if nc.draining and not nc.closed:
        nc.err = "connection draining"
        ret false
    end
    ret _publish_raw(nc, m.subject, m.reply, m.header, true, m.data)
end

@en "Respond"
@fa "پاسخ"
pub func Respond(nc &: Conn, m: Msg, data: str): bool:
    if m.reply.len() == 0:
        nc.err = "message has no reply subject"
        ret false
    end
    ret _publish_raw(nc, m.reply, "", Header {}, false, data)
end

@en "Subscribe"
@fa "اشتراک"
pub func Subscribe(nc &: Conn, subject: str): Subscription:
    ret _add_sub(nc, subject, "", KIND_QUEUE, 0)
end

@en "QueueSubscribe"
@fa "اشتراک صف"
pub func QueueSubscribe(nc &: Conn, subject: str, queue: str): Subscription:
    ret _add_sub(nc, subject, queue, KIND_QUEUE, 0)
end

@en "SubscribeHandler"
@fa "اشتراک با دستگیره"
pub func SubscribeHandler(nc &: Conn, subject: str, queue: str, handler: func (Msg)): Subscription:
    slot := nc._handlers.len()
    nc._handlers.push(handler)
    ret _add_sub(nc, subject, queue, KIND_HANDLER, slot)
end

@en "SubscribeReplier"
@fa "اشتراک پاسخگو"
pub func SubscribeReplier(nc &: Conn, subject: str, queue: str, handler: func (Msg) str): Subscription:
    slot := nc._repliers.len()
    nc._repliers.push(handler)
    ret _add_sub(nc, subject, queue, KIND_REPLIER, slot)
end

@en "Unsubscribe"
@fa "لغو اشتراک"
pub func Unsubscribe(nc &: Conn, s: Subscription): bool:
    idx := _find_sub(nc, s.sid)
    if idx < 0:
        ret false
    end
    _tombstone(nc, idx)
    _drop_inbox(nc, s.sid)
    if nc._reconnecting:
        ret true
    end
    ret _write(nc, "UNSUB " + conv.FormatInt(s.sid as i64) + "\r\n")
end

@en "AutoUnsubscribe"
@fa "لغو خودکار اشتراک"
pub func AutoUnsubscribe(nc &: Conn, s: Subscription, max: int): bool:
    idx := _find_sub(nc, s.sid)
    if idx < 0 or max <= 0:
        ret false
    end
    nc._sub_max.set(idx, max)
    if nc._sub_count.get(idx) >= max:
        _tombstone(nc, idx)
    end
    if nc._reconnecting:
        ret true
    end
    ret _write(nc, "UNSUB " + conv.FormatInt(s.sid as i64) + " " + conv.FormatInt(max as i64) + "\r\n")
end

@en "IsValidSubscription"
@fa "اشتراک فعال است"
pub func IsValidSubscription(nc: Conn, s: Subscription): bool:
    ret _find_sub(nc, s.sid) >= 0
end

@en "Delivered"
@fa "تحویل شده"
pub func Delivered(nc: Conn, s: Subscription): int:
    repeat nc._sub_sid.len() in i:
        if nc._sub_sid.get(i) == s.sid or nc._sub_sid.get(i) == 0 - s.sid:
            ret nc._sub_count.get(i)
        end
    end
    ret 0
end

@en "Pending"
@fa "صف مانده"
pub func Pending(nc: Conn, s: Subscription): int:
    mut n := 0
    repeat nc._inbox.len() in i:
        if nc._inbox.get(i).sid == s.sid:
            n++
        end
    end
    ret n
end

@en "NextMsg"
@fa "پیام بعدی"
pub func NextMsg(nc &: Conn, s: Subscription, timeout_ms: int): Msg:
    deadline := _now() + timeout_ms as i64
    until true:
        m := _take(nc, s.sid)
        if m.ok:
            ret m
        end
        if nc.closed:
            mut e := Msg {}
            e.err = "connection closed"
            ret e
        end
        left := deadline - _now()
        if left <= 0:
            break
        end
        wait := left > 1000 ? 1000 : (left as int)
        Pump(nc, wait)
    end
    mut t := Msg {}
    t.err = "timeout"
    ret t
end

@en "Flush"
@fa "تخلیه"
pub func Flush(nc &: Conn, timeout_ms: int): bool:
    if nc.closed:
        ret false
    end
    deadline := _now() + timeout_ms as i64
    mut seen := nc._reconnects
    mut target := 0
    mut sent := false
    until true:
        if nc.closed:
            ret false
        end
        if not nc._reconnecting and (not sent or seen != nc._reconnects):
            seen = nc._reconnects
            nc._pings_sent++
            target = nc._pings_sent
            sent = _write(nc, "PING\r\n")
        end
        if sent and not nc._reconnecting and seen == nc._reconnects and nc._pongs_recv >= target:
            break
        end
        left := deadline - _now()
        if left <= 0:
            nc.err = "flush timeout"
            ret false
        end
        Pump(nc, left > 1000 ? 1000 : (left as int))
    end
    ret true
end

@en "Request"
@fa "درخواست"
pub func Request(nc &: Conn, subject: str, data: str, timeout_ms: int): Msg:
    ret RequestMsg(nc, subject, Header {}, data, timeout_ms)
end

@en "RequestMsg"
@fa "درخواست با سرآیند"
pub func RequestMsg(nc &: Conn, subject: str, h: Header, data: str, timeout_ms: int): Msg:
    mut fail := Msg {}
    inbox := NewInbox(nc)
    s := Subscribe(nc, inbox)
    if not s.ok:
        fail.err = nc.err
        ret fail
    end
    AutoUnsubscribe(nc, s, 1)
    if not _publish_raw(nc, subject, inbox, h, true, data):
        fail.err = nc.err
        ret fail
    end
    mut m := NextMsg(nc, s, timeout_ms)
    if not m.ok:
        Unsubscribe(nc, s)
        ret m
    end
    if m.status == STATUS_NO_RESPONDERS:
        m.ok = false
        m.err = "no responders"
    end
    ret m
end

@en "Drain"
@fa "تخلیه کامل"
pub func Drain(nc &: Conn, timeout_ms: int): bool:
    if nc.closed:
        ret false
    end
    if nc._reconnecting:
        _shutdown(nc)
        ret false
    end
    nc.draining = true
    repeat nc._sub_sid.len() in i:
        sid := nc._sub_sid.get(i)
        if sid > 0:
            _write(nc, "UNSUB " + conv.FormatInt(sid as i64) + "\r\n")
        end
    end
    ok := Flush(nc, timeout_ms)
    _shutdown(nc)
    ret ok
end

@en "MaxPayload"
@fa "بیشینه اندازه بار"
pub func MaxPayload(nc: Conn): int:
    ret nc.info.max_payload
end

@en "SubscriptionCount"
@fa "شمار اشتراک"
pub func SubscriptionCount(nc: Conn): int:
    mut n := 0
    repeat nc._sub_sid.len() in i:
        if nc._sub_sid.get(i) > 0:
            n++
        end
    end
    ret n
end

@en "IsReconnecting"
@fa "در حال اتصال دوباره"
pub func IsReconnecting(nc: Conn): bool:
    ret nc._reconnecting and not nc.closed
end

@en "Reconnects"
@fa "شمار اتصال دوباره"
pub func Reconnects(nc: Conn): int:
    ret nc._reconnects
end

@en "BufferedBytes"
@fa "بایت‌های بافر شده"
pub func BufferedBytes(nc: Conn): int:
    ret nc._pending.len()
end
