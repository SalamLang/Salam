package shadowsocks

if SALAM_OS_WINDOWS:
    extern:
        func shutdown(s: usize, how: int): int
    end
else:
    extern:
        func shutdown(s: int, how: int): int
    end
end

const SHUT_WR := 1

func _shut_wr(fd: i64):
    if fd < 0:
        ret
    end
    if SALAM_OS_WINDOWS:
        shutdown(fd as usize, SHUT_WR)
    else:
        shutdown(fd as int, SHUT_WR)
    end
end
