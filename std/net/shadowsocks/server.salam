package shadowsocks

import mem
import net.tcp
import net.internal.rawsock
import pool
import chan
import net.tunnel
import tls

const RELAY_BUF := 16384
const RELAY_HALF_MS := 120000
const PROBE_MIN_MS := 1500
const PROBE_SPAN_MS := 3000

struct _PipeJob:
    pub st: ConnState* = null
    pub tgt: tcp.Conn = tcp.Conn {}
end

@en "ServerState"
@fa "وضعیت سرور"
pub struct ServerState:
    @en "ls"
    @fa "شنونده"
    pub ls: tcp.Server = tcp.Server {}
    @en "method"
    @fa "روش"
    pub method: Method = Method {}
    @en "key"
    @fa "کلید"
    pub key: Buf = Buf {}
    @en "filter"
    @fa "فیلتر"
    pub filter: SaltFilter = SaltFilter {}
    @en "workers"
    @fa "کارگرها"
    pub workers: pool.Pool = pool.Pool {}
    @en "stop"
    @fa "توقف"
    pub stop: i64* = null
    @en "jobs"
    @fa "صف اتصال ها"
    pub jobs: chan.Chan<i64> = chan.Chan {} as chan.Chan<i64>
    @en "obfs_mode"
    @fa "حالت پوشش"
    pub obfs_mode: str = ""
    @en "users"
    @fa "کاربران"
    pub users: HashMap<str, Buf> = HashMap {} as HashMap<str, Buf>
    @en "user_names"
    @fa "نام کاربران"
    pub user_names: HashMap<str, str> = HashMap {} as HashMap<str, str>
    @en "user_n"
    @fa "تعداد کاربران"
    pub user_n: int = 0
end

@en "Server"
@fa "سرور"
pub struct Server:
    @en "st"
    @fa "وضعیت"
    pub st: ServerState* = null
end

func _take_eih(ss: ServerState*, st: ConnState*): int:
    if st.dec.inb.len - st.dec.off < 16:
        ret 0
    end
    kl := st.method.key_len
    h := mem.AllocateZeroed(16 as u64)
    defer mem.Free(h)
    if not EihOpen(ss.key.p, kl, st.dec.salt.p, st.method.salt_len, _at(st.dec.inb.p, st.dec.off), h):
        ret 0 - 1
    end
    id := HexOf(h, 16)
    if not ss.users.has(id):
        ret 0 - 1
    end
    uk := ss.users.get(id)
    st.user = ss.user_names.get(id)
    st.dec.off += 16
    tls.AeadFree(st.dec.ctx)
    st.dec.ctx = _open_ctx(st.method, uk.p, st.dec.salt.p)
    EncoderFree(st.enc)
    st.enc = NewEncoderRandom(st.method, uk.p)
    st.eih_done = true
    ret 1
end

func _handshake(ss: ServerState*, st: ConnState*): bool:
    mut checked := false
    mut res := 2
    until res == 2:
        n := _rx(st, st.rd, RD_SIZE)
        if n <= 0:
            res = 0
        else:
            Feed(st.dec, st.rd, n)
            if not checked and TakeSalt(st.dec):
                checked = true
                if not FilterCheck(ss.filter, st.dec.salt.p, st.method.salt_len):
                    res = 0
                end
            end
            mut ready := true
            if res == 2 and ss.user_n > 0 and st.dec.have_salt and not st.eih_done:
                er := _take_eih(ss, st)
                if er < 0:
                    res = 0
                else er == 0:
                    ready = false
                end
            end
            if res == 2 and ready:
                mut more := true
                until more:
                    r := _next(st)
                    if r < 0:
                        res = 0
                    end
                    if r <= 0:
                        more = false
                    end
                end
                if res == 2 and st.v2022:
                    if st.target_ok:
                        res = 1
                    end
                else res == 2:
                    pn := ParseTarget(st.plain.p, st.plain.len, st.target)
                    if pn > 0:
                        st.plain_pos = pn
                        res = 1
                    else pn < 0:
                        res = 0
                    end
                end
            end
        end
    end
    ret res == 1
end

func _server_state(ss: ServerState*): ConnState*:
    mut k := NewBuf(ss.key.len)
    BufAppend(k, ss.key.p, ss.key.len)
    st := _new_state(ss.method, k, ObfsMode(ss.obfs_mode), true, "")
    st.dec = NewDecoder(ss.method, k.p)
    st.enc = NewEncoderRandom(ss.method, k.p)
    ret st
end

func _probe_drain(st: ConnState*):
    tcp.SetReadDeadline(st.sock, PROBE_MIN_MS + _rand_int(PROBE_SPAN_MS))
    limit := 4096 + _rand_int(60000)
    mut total := 0
    until total < limit:
        n := tcp.ReadBytes(st.sock, st.rd, RD_SIZE)
        if n <= 0:
            break
        end
        total += n
    end
end

func _server_conn(ss: ServerState*, raw: tcp.Conn, drain: bool): Conn:
    st := _server_state(ss)
    st.sock = raw
    if not _handshake(ss, st):
        if drain:
            _probe_drain(st)
        end
        _raw_shutdown(st)
        tcp.Close(raw)
        _free_state(st)
        ret Conn {}
    end
    ret Conn { st = st }
end

func _pipe_down(job: _PipeJob*):
    st := job.st
    buf := mem.Allocate(RELAY_BUF as u64)
    cc := Conn { st = st }
    mut go := true
    until go:
        n := tcp.ReadBytes(job.tgt, buf, RELAY_BUF)
        if n <= 0:
            go = false
        else:
            if Write(cc, buf, n) < 0:
                go = false
            end
        end
    end
    mem.Free(buf)
    if st.use_up:
        _raw_shutdown(st)
    else:
        _shut_wr(st.sock.fd)
        tcp.SetReadDeadline(st.sock, RELAY_HALF_MS)
    end
end

func _serve_one(ss: ServerState*, raw: tcp.Conn, handler: func (Conn)):
    c := _server_conn(ss, raw, true)
    if c.st != null:
        handler(c)
    end
end

func _serve_next(ss: ServerState*, handler: func (Conn), jobs: chan.Chan<i64>):
    mut ok := true
    fd := jobs.recv(ok)
    if ok:
        _serve_one(ss, tcp.Conn { fd = fd }, handler)
    end
end

func _listen(host: str, port: int, method: str, password: str, obfs: str): Server:
    m := LookupMethod(method)
    if not m.ok:
        ret Server {}
    end
    key := MakeKey(m, password)
    if key.bad:
        ret Server {}
    end
    mut ls := tcp.Server {}
    if host == "":
        ls = tcp.Bind(port)
    else:
        ls = tcp.Server { fd = rawsock.ListenOn(host, port, rawsock.SOCK_STREAM).fd, port = port }
    end
    if not tcp.Ok(ls):
        mut k := key
        BufFree(k)
        ret Server {}
    end
    ss := mem.AllocateZeroed(sizeof(ServerState) as u64) as ServerState*
    ss.ls = ls
    ss.method = m
    ss.key = key
    ss.filter = NewSaltFilter(100000)
    ss.workers = pool.NewElastic(2 as i64, 512 as i64, 64 as i64)
    ss.jobs = chan.Chan {} as chan.Chan<i64>
    ss.users = HashMap {} as HashMap<str, Buf>
    ss.user_names = HashMap {} as HashMap<str, str>
    ss.jobs.init(1024 as i64)
    ss.stop = mem.AllocateZeroed(8 as u64) as i64*
    ss.obfs_mode = obfs
    ret Server { st = ss }
end

@en "Listen"
@fa "گوش دادن"
pub func Listen(port: int, method: str, password: str): Server:
    ret ListenObfs(port, method, password, "")
end

@en "ListenOn"
@fa "گوش دادن روی نشانی"
pub func ListenOn(host: str, port: int, method: str, password: str, obfs: str): Server:
    ret _listen(host, port, method, password, obfs)
end

@en "ListenObfs"
@fa "گوش دادن با پوشش"
pub func ListenObfs(port: int, method: str, password: str, obfs: str): Server:
    ret _listen("", port, method, password, obfs)
end

@en "AddUser"
@fa "افزودن کاربر"
pub func AddUser(s: Server, name: str, password: str): bool:
    ss := s.st
    if ss == null or not ss.method.v2022 or ss.method.kind == tls.AEAD_CHACHA20_POLY1305:
        ret false
    end
    k := MakeKey(ss.method, password)
    if k.bad:
        ret false
    end
    h := mem.AllocateZeroed(16 as u64)
    IdentityHash(k.p, ss.method.key_len, h)
    id := HexOf(h, 16)
    mem.Free(h)
    ss.users.put(id, k)
    ss.user_names.put(id, name)
    ss.user_n = ss.users.size()
    ret true
end

@en "ServerOk"
@fa "سرور معتبر"
pub func ServerOk(s: Server): bool:
    ret s.st != null
end

@en "ServerPort"
@fa "درگاه سرور"
pub func ServerPort(s: Server): int:
    ret tcp.Port(s.st.ls)
end

@en "Accept"
@fa "پذیرش"
pub func Accept(s: Server): Conn:
    ss := s.st
    mut res := Conn {}
    mut done := false
    until not done:
        raw := tcp.Accept(ss.ls)
        if not tcp.ConnOk(raw):
            done = true
        else:
            res = _server_conn(ss, raw, false)
            if res.st != null:
                done = true
            end
        end
    end
    ret res
end

@en "AcceptOver"
@fa "پذیرش روی جریان"
pub func AcceptOver(s: Server, io: dyn tunnel.Stream): Conn:
    ss := s.st
    st := _server_state(ss)
    st.up = io
    st.use_up = true
    if not _handshake(ss, st):
        _raw_shutdown(st)
        _free_state(st)
        ret Conn {}
    end
    ret Conn { st = st }
end

@en "Relay"
@fa "رله"
pub func Relay(c: Conn):
    st := c.st
    if st == null:
        ret
    end
    tgt := tcp.Dial(st.target.host, st.target.port)
    if not tcp.ConnOk(tgt):
        Close(c)
        ret
    end
    job := mem.AllocateZeroed(sizeof(_PipeJob) as u64) as _PipeJob*
    job.st = st
    job.tgt = tgt
    th := spawn(_pipe_down, job)
    buf := mem.Allocate(RELAY_BUF as u64)
    mut go := true
    mut hard := false
    until go:
        n := Read(c, buf, RELAY_BUF)
        if n <= 0:
            go = false
        else:
            w := tcp.WriteBytes(tgt, buf, n)
            if w < n:
                go = false
                hard = true
            end
        end
    end
    mem.Free(buf)
    if hard:
        _raw_shutdown(st)
        rawsock.Shutdown(rawsock.Socket { fd = tgt.fd })
    else:
        _shut_wr(tgt.fd)
        tcp.SetReadDeadline(tgt, RELAY_HALF_MS)
    end
    join(th)
    mem.Free(job as void*)
    tcp.Close(tgt)
    Close(c)
end

@en "Serve"
@fa "خدمت"
pub func Serve(s: Server, handler: func (Conn)):
    ss := s.st
    jobs := ss.jobs
    task := (): _serve_next(ss, handler, jobs) end
    until atomic_load(ss.stop) == 0 as i64:
        raw := tcp.Accept(ss.ls)
        if tcp.ConnOk(raw) and atomic_load(ss.stop) == 0 as i64:
            jobs.send(raw.fd)
            pool.Submit(ss.workers, task)
        else tcp.ConnOk(raw):
            tcp.Close(raw)
        end
    end
end

@en "ServeRelay"
@fa "خدمت رله"
pub func ServeRelay(s: Server):
    Serve(s, (c: Conn): Relay(c) end)
end

@en "Stop"
@fa "توقف سرور"
pub func Stop(s: Server):
    ss := s.st
    if ss == null:
        ret
    end
    atomic_store(ss.stop, 1 as i64)
    rawsock.Shutdown(rawsock.Socket { fd = ss.ls.fd })
    wake := tcp.Dial("127.0.0.1", tcp.Port(ss.ls))
    if tcp.ConnOk(wake):
        tcp.Close(wake)
    end
end

@en "Destroy"
@fa "نابودی سرور"
pub func Destroy(s: Server):
    ss := s.st
    if ss == null:
        ret
    end
    tcp.CloseServer(ss.ls)
    pool.Stop(ss.workers)
    ss.jobs.close()
    ss.jobs.free()
    FilterFree(ss.filter)
    each uid, uk in ss.users:
        mut kk := uk
        BufWipe(kk)
        BufFree(kk)
        mem.Free(uid as void*)
    end
    ss.users.free()
    ss.user_names.free()
    BufWipe(ss.key)
    BufFree(ss.key)
    mem.Free(ss.stop as void*)
    mem.Free(ss as void*)
end
