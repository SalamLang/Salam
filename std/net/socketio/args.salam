package socketio

import encoding.json
import encoding.value
import encoding.encerr
import conv

@en "Args"
@fa "آرگومان‌ها"
@ar "الوسائط"
pub struct Args:
    pub items: Vector<str> = Vector {}
    pub bins: Vector<Bytes> = Vector {}
end

func _decode_one(frag: str): value.Value:
    mut err := encerr.EncodingError {}
    ret json.Decode(frag, err)
end


@en "NewArgs"
@fa "آرگومان جدید"
@ar "وسائط جدیدة"
pub func NewArgs(): Args:
    ret Args {}
end

@en "AddStr"
@fa "افزودن رشته"
@ar "إضافة نص"
pub func AddStr(a &: Args, s: str):
    a.items.push(json.Str(s))
end

@en "AddInt"
@fa "افزودن عدد"
@ar "إضافة عدد"
pub func AddInt(a &: Args, n: i64):
    a.items.push("" + n)
end

@en "AddFloat"
@fa "افزودن اعشاری"
@ar "إضافة عشری"
pub func AddFloat(a &: Args, n: f64):
    a.items.push("" + n)
end

@en "AddBool"
@fa "افزودن بولی"
@ar "إضافة منطقی"
pub func AddBool(a &: Args, b: bool):
    if b:
        a.items.push("true")
    else:
        a.items.push("false")
    end
end

@en "AddNull"
@fa "افزودن تهی"
@ar "إضافة فارغ"
pub func AddNull(a &: Args):
    a.items.push("null")
end

@en "AddJSON"
@fa "افزودن جیسون"
@ar "إضافة جیسون"
pub func AddJSON(a &: Args, raw: str):
    if raw.len() == 0:
        a.items.push("null")
    else:
        a.items.push(raw)
    end
end

@en "AddValue"
@fa "افزودن مقدار"
@ar "إضافة قیمة"
pub func AddValue(a &: Args, v: value.Value):
    a.items.push(json.EncodeDefault(v))
end

@en "AddBytes"
@fa "افزودن بایت"
@ar "إضافة بایتات"
pub func AddBytes(a &: Args, ptr: void*, n: int):
    a.items.push(Placeholder(a.bins.len()))
    a.bins.push(NewBytes(ptr, n))
end

@en "AddBinaryStr"
@fa "افزودن رشته دودویی"
@ar "إضافة نص ثنائی"
pub func AddBinaryStr(a &: Args, s: str):
    AddBytes(a, s as void*, s.len())
end

@en "ArgsCount"
@fa "شمار آرگومان"
@ar "عدد الوسائط"
pub func ArgsCount(a: Args): int:
    ret a.items.len()
end

@en "ArgsFree"
@fa "آزادسازی آرگومان"
@ar "تحریر الوسائط"
pub func ArgsFree(a &: Args):
    repeat a.bins.len() with i:
        mut b := a.bins.get(i)
        BytesFree(b)
    end
    a.bins.free()
    a.items.free()
end

@en "ArgsJSON"
@fa "جیسون آرگومان"
@ar "جیسون الوسائط"
pub func ArgsJSON(a: Args, name: str): str:
    mut out := "["
    mut first := true
    if name.len() > 0:
        out += json.Str(name)
        first = false
    end
    repeat a.items.len() with i:
        if !first:
            out += ","
        end
        out += a.items.get(i)
        first = false
    end
    ret out + "]"
end

@en "ItemCount"
@fa "شمار عنصر"
@ar "عدد العناصر"
pub func ItemCount(raw: str): int:
    mut parts := SplitJSONArray(raw)
    defer parts.free()
    ret parts.len()
end

@en "Item"
@fa "عنصر"
@ar "عنصر"
pub func Item(raw: str, i: int): str:
    mut parts := SplitJSONArray(raw)
    defer parts.free()
    if i < 0 || i >= parts.len():
        ret ""
    end
    ret parts.get(i)
end

@en "ItemStr"
@fa "عنصر رشته‌ای"
@ar "عنصر نصی"
pub func ItemStr(raw: str, i: int): str:
    frag := Item(raw, i)
    if frag.len() == 0:
        ret ""
    end
    mut v := _decode_one(frag)
    defer value.ValueFree(v)
    if value.IsString(v):
        ret value.AsString(v)
    end
    ret frag
end

@en "ItemInt"
@fa "عنصر عددی"
@ar "عنصر عددی"
pub func ItemInt(raw: str, i: int): i64:
    mut v := _decode_one(Item(raw, i))
    defer value.ValueFree(v)
    if value.IsString(v):
        ret conv.ParseInt(value.AsString(v))
    end
    ret value.AsInt(v)
end

@en "ItemFloat"
@fa "عنصر اعشاری"
@ar "عنصر عشری"
pub func ItemFloat(raw: str, i: int): f64:
    mut v := _decode_one(Item(raw, i))
    defer value.ValueFree(v)
    if value.IsString(v):
        ret conv.ParseFloat(value.AsString(v))
    end
    ret value.AsFloat(v)
end

@en "ItemBool"
@fa "عنصر بولی"
@ar "عنصر منطقی"
pub func ItemBool(raw: str, i: int): bool:
    mut v := _decode_one(Item(raw, i))
    defer value.ValueFree(v)
    if value.IsBool(v):
        ret value.AsBool(v)
    end
    if value.IsNumber(v):
        ret value.AsInt(v) != 0
    end
    if value.IsString(v):
        t := value.AsString(v)
        ret t == "true" || t == "1"
    end
    ret false
end

@en "ItemValue"
@fa "مقدار عنصر"
@ar "قیمة العنصر"
pub func ItemValue(raw: str, i: int): value.Value:
    ret _decode_one(Item(raw, i))
end
