// Sockets - every namespace open on this connection. The vector is the
// caller's to free; the Clients in it are not.
@en "Sockets"
@fa "سوکت‌ها"
@ar "المقابس"
pub func Sockets(m: Manager): Vector<Client>:
    mut out := Vector {} as Vector<Client>
    if m.p == null:
        ret out
    end
    mp := _mgr(m)
    repeat mp[0].socks.len() with i:
        out.push(mp[0].socks.get(i))
    end
    ret out
end

// Open - bring the transport up without joining a namespace, socket.io's
// `manager.open()`. Connect does this on its own; this is for a program that
// wants the connection established before it decides which namespaces to
// join.
@en "Open"
@fa "باز کردن"
@ar "فتح"
pub func Open(m: Manager): bool:
    if m.p == null:
        ret false
    end
    mp := _mgr(m)
    if mp[0].state == ST_OPEN:
        ret true
    end
    if !mp[0].ep.ok:
        ret false
    end
    if !_engine_open(mp):
        if mp[0].opts.reconnection:
            mp[0].state = ST_WAITING
            mp[0].retry_at = time.MonoMillis() + _backoff(mp)
        end
        ret false
    end
    mp[0].attempts = 0
    ret true
end

// IsOpen - whether the transport underneath is up, whatever the namespaces
// on it are doing.
@en "IsOpen"
@fa "باز است"
@ar "مفتوح"
pub func IsOpen(m: Manager): bool:
    if m.p == null:
        ret false
    end
    ret _mgr(m)[0].state == ST_OPEN
end

// ManagerError - why the last connection attempt on this manager failed.
@en "ManagerError"
@fa "خطای مدیر"
@ar "خطأ المدیر"
pub func ManagerError(m: Manager): str:
    if m.p == null:
        ret "no manager"
    end
    ret _mgr(m)[0].last_error
end

// Refused - whether the server turned this namespace away, and why.
//
// Distinct from a connection that simply is not up: a refusal came from the
// server's own middleware ("Not authorized"), and reconnecting without
// changing anything - a new token through SetAuth, usually - will be
// refused again.
@en "Refused"
@fa "رد شده"
@ar "مرفوض"
pub func Refused(c: Client): bool:
    if c.p == null:
        ret false
    end
    ret _sock(c)[0].refused
end

@en "RefusalReason"
@fa "دلیل رد"
@ar "سبب الرفض"
pub func RefusalReason(c: Client): str:
    if c.p == null:
        ret ""
    end
    ret _sock(c)[0].refusal
end
