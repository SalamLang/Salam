end

@en "ArgFloat"
@fa "آرگومان اعشاری"
@ar "وسیط عشری"
pub func ArgFloat(ev: Event, i: int): f64:
    ret ItemFloat(ev.data, i)
end

@en "ArgBool"
@fa "آرگومان بولی"
@ar "وسیط منطقی"
pub func ArgBool(ev: Event, i: int): bool:
    ret ItemBool(ev.data, i)
end

// ArgValue - argument `i` parsed into a value tree, for an object or an
// array. Free it with value.ValueFree.
@en "ArgValue"
@fa "مقدار آرگومان"
@ar "قیمة الوسیط"
pub func ArgValue(ev: Event, i: int): value.Value:
    ret ItemValue(ev.data, i)
end

// ArgIsBinary - whether argument `i` is a binary attachment rather than JSON.
@en "ArgIsBinary"
@fa "آرگومان دودویی است"
@ar "وسیط ثنائی"
pub func ArgIsBinary(ev: Event, i: int): bool:
    ret PlaceholderNum(Item(ev.data, i)) >= 0
end

// ArgBytes - argument `i` as its attached buffer. Owned by the event.
@en "ArgBytes"
@fa "آرگومان بایتی"
@ar "وسیط بایتات"
pub func ArgBytes(ev: Event, i: int): Bytes:
    n := PlaceholderNum(Item(ev.data, i))
    if n < 0 || n >= ev.bins.len():
        ret Bytes {}
    end
    ret ev.bins.get(n)
end

// AckCount / AckArg / AckStr / AckInt - the same, over an acknowledgement.
@en "AckCount"
@fa "شمار تایید"
@ar "عدد الإقرار"
pub func AckCount(a: Ack): int:
    ret ItemCount(a.data)
end

@en "AckArg"
@fa "آرگومان تایید"
@ar "وسیط الإقرار"
pub func AckArg(a: Ack, i: int): str:
    ret Item(a.data, i)
end

@en "AckStr"
@fa "رشته تایید"
@ar "نص الإقرار"
pub func AckStr(a: Ack, i: int): str:
    ret ItemStr(a.data, i)
end

@en "AckInt"
@fa "عدد تایید"
@ar "عدد الإقرار"
pub func AckInt(a: Ack, i: int): i64:
    ret ItemInt(a.data, i)
end

@en "AckFloat"
@fa "اعشار تایید"
@ar "عشری الإقرار"
pub func AckFloat(a: Ack, i: int): f64:
    ret ItemFloat(a.data, i)
end

@en "AckBool"
@fa "بولی تایید"
@ar "منطقی الإقرار"
pub func AckBool(a: Ack, i: int): bool:
    ret ItemBool(a.data, i)
end

// AckIsBinary - whether answer `i` is a binary attachment rather than JSON.
// A server can acknowledge with bytes as readily as it can emit them.
@en "AckIsBinary"
@fa "تایید دودویی است"
@ar "إقرار ثنائی"
pub func AckIsBinary(a: Ack, i: int): bool:
    ret PlaceholderNum(Item(a.data, i)) >= 0
end

// AckBytes - answer `i` as its attached buffer. Owned by the Ack, and
// released by AckFree.
@en "AckBytes"
@fa "بایت تایید"
@ar "بایتات الإقرار"
pub func AckBytes(a: Ack, i: int): Bytes:
    n := PlaceholderNum(Item(a.data, i))
    if n < 0 || n >= a.bins.len():
        ret Bytes {}
    end
    ret a.bins.get(n)
end

// AckValue - answer `i` parsed into a value tree. Free it with
// value.ValueFree.
@en "AckValue"
@fa "مقدار تایید"
@ar "قیمة الإقرار"
pub func AckValue(a: Ack, i: int): value.Value:
    ret ItemValue(a.data, i)
end

// EventFree - release an event taken from Next.
//
// Only events carrying binary attachments own anything; calling it on the
// rest is free, and it is easier to call it always than to remember which
// are which.
@en "EventFree"
@fa "آزادسازی رویداد"
@ar "تحریر الحدث"
pub func EventFree(ev &: Event):
    _free_bins(ev.bins)
    ev.bins = Vector {} as Vector<Bytes>
end

// AckFree - release an acknowledgement returned by EmitAck.
@en "AckFree"
@fa "آزادسازی تایید"
@ar "تحریر الإقرار"
pub func AckFree(a &: Ack):
    _free_bins(a.bins)
    a.bins = Vector {} as Vector<Bytes>
end

// ------------------------------------------------------------ introspection

// IsConnected - whether the server has accepted this namespace right now.
@en "IsConnected"
@fa "متصل است"
@ar "متصل"
pub func IsConnected(c: Client): bool:
    if c.p == null:
        ret false
    end
    ret _sock(c)[0].connected
end

// Id - the server's id for this namespace's socket, empty while
// disconnected. It changes on every reconnection; it is not an identity.
@en "Id"
@fa "شناسه"
@ar "معرف"
pub func Id(c: Client): str:
    if c.p == null:
        ret ""
    end
    ret _sock(c)[0].id
end

// Sid - the Engine.IO session id, shared by every namespace on the
// connection.
@en "Sid"
@fa "شناسه نشست"
@ar "معرف الجلسة"
pub func Sid(c: Client): str:
    if c.p == null:
        ret ""
    end
    ret _mgr_of(c)[0].sid
end

// Namespace - which namespace this Client is.
@en "Namespace"
@fa "فضای نام"
@ar "مساحة الاسم"
pub func Namespace(c: Client): str:
    if c.p == null:
        ret "/"
    end
    ret _sock(c)[0].nsp
end

// Recovered - whether the last connect resumed the previous session rather
// than starting a new one, so nothing sent in the gap was lost. Only ever
// true against a server with connection state recovery enabled.
@en "Recovered"
@fa "بازیابی شده"
@ar "مستعاد"
pub func Recovered(c: Client): bool:
    if c.p == null:
        ret false
    end
    ret _sock(c)[0].recovered
end

// Transport - which transport is carrying the connection now,
// TRANSPORT_WEBSOCKET or TRANSPORT_POLLING.
@en "Transport"
@fa "حمل‌ونقل"
@ar "النقل"
pub func Transport(c: Client): int:
    if c.p == null:
        ret TRANSPORT_POLLING
    end
    ret _mgr_of(c)[0].transport
end

// LastError - why the last connection attempt failed, or "".
@en "LastError"
@fa "آخرین خطا"
@ar "آخر خطأ"
pub func LastError(c: Client): str:
    if c.p == null:
        ret "no client"
    end
    ret _mgr_of(c)[0].last_error
end

// Buffered - how many emits are waiting for a connection.
@en "Buffered"
@fa "بافر شده"
@ar "مخزن مؤقتا"
pub func Buffered(c: Client): int:
    if c.p == null:
        ret 0
    end
    ret _sock(c)[0].outbuf.len()
end

// Attempts - how many reconnection attempts have been made since the last
// successful connection.
@en "Attempts"
@fa "تلاش‌ها"
@ar "المحاولات"
pub func Attempts(c: Client): int:
    if c.p == null:
        ret 0
    end
    ret _mgr_of(c)[0].attempts
end

// EndpointOf - the parsed URL a Client is connected to.
@en "EndpointOf"
@fa "نقطه پایانی"
@ar "نقطة النهایة"
pub func EndpointOf(c: Client): Endpoint:
    if c.p == null:
        ret Endpoint {}
    end
    ret _mgr_of(c)[0].ep
end

// Send - the "message" event, socket.io's `socket.send(...)`.
@en "Send"
@fa "فرستادن"
@ar "بعث"
pub func Send(c: Client, msg: str): bool:
    ret EmitStr(c, "message", msg)
end

// PrependAny - OnAny, but ahead of the catch-alls already registered.
@en "PrependAny"
@fa "پیش‌افزودن هر"
@ar "إضافة أمامیة لأی"
pub func PrependAny(c: Client, cb: func (Event)):
    if c.p == null:
        ret
    end
    sp := _sock(c)
    mut fresh := Vector {} as Vector<Handler>
    fresh.push(Handler { name = "*", cb = cb })
    repeat sp[0].any_handlers.len() with i:
        fresh.push(sp[0].any_handlers.get(i))
    end
    sp[0].any_handlers.free()
    sp[0].any_handlers = fresh
end

// OnAnyOutgoing - call `cb` for every event this client sends.
//
// The mirror of OnAny, and the place to put logging or tracing so that it
// does not have to wrap every Emit call. The event handed over is the one
// going out: `name`, `data` and the acknowledgement id the caller asked
// for, if any.
//
// It fires when the packet is made, which is what socket.io's
// onAnyOutgoing does - so it also sees an emit that is then held for a
// connection, or dropped because it was volatile and there was none.
@en "OnAnyOutgoing"
@fa "روی هر خروجی"
@ar "علی أی صادر"
pub func OnAnyOutgoing(c: Client, cb: func (Event)):
    if c.p == null:
        ret
    end
    sp := _sock(c)
    sp[0].out_handlers.push(Handler { name = "*", cb = cb })
end

// PrependAnyOutgoing - OnAnyOutgoing, ahead of the ones already registered.
@en "PrependAnyOutgoing"
@fa "پیش‌افزودن هر خروجی"
@ar "إضافة أمامیة لأی صادر"
pub func PrependAnyOutgoing(c: Client, cb: func (Event)):
    if c.p == null:
        ret
    end
    sp := _sock(c)
    mut fresh := Vector {} as Vector<Handler>
    fresh.push(Handler { name = "*", cb = cb })
    repeat sp[0].out_handlers.len() with i:
        fresh.push(sp[0].out_handlers.get(i))
    end
    sp[0].out_handlers.free()
    sp[0].out_handlers = fresh
end

// OffAnyOutgoing - remove the outgoing catch-alls.
@en "OffAnyOutgoing"
@fa "خاموش هر خروجی"
@ar "إیقاف أی صادر"
pub func OffAnyOutgoing(c: Client):
    if c.p == null:
        ret
    end
    sp := _sock(c)
    sp[0].out_handlers.free()
    sp[0].out_handlers = Vector {} as Vector<Handler>
end

// ListenerCount - how many handlers are registered for `name`.
@en "ListenerCount"
@fa "شمار شنونده"
@ar "عدد المستمعین"
pub func ListenerCount(c: Client, name: str): int:
    if c.p == null:
        ret 0
    end
    sp := _sock(c)
    mut n := 0
    repeat sp[0].handlers.len() with i:
        h := sp[0].handlers.get(i)
        if h.alive && h.name == name:
            n += 1
        end
    end
    ret n
end

// HasListeners - whether anything is listening for `name`.
@en "HasListeners"
@fa "شنونده دارد"
@ar "لدیه مستمعون"
pub func HasListeners(c: Client, name: str): bool:
    ret ListenerCount(c, name) > 0
end

// AnyListenerCount - how many catch-alls are registered, incoming and
// outgoing.
@en "AnyListenerCount"
@fa "شمار شنونده هر"
@ar "عدد مستمعی أی"
pub func AnyListenerCount(c: Client): int:
    if c.p == null:
        ret 0
    end
    sp := _sock(c)
    ret sp[0].any_handlers.len() + sp[0].out_handlers.len()
end

// Disconnected - the opposite of IsConnected, spelled the way socket.io
// spells it.
@en "Disconnected"
@fa "قطع شده"
@ar "منفصل"
pub func Disconnected(c: Client): bool:
    ret !IsConnected(c)
end

// Active - whether the caller still wants this namespace connected.
//
// True between Connect and Disconnect, including while a reconnection is in
// flight, which is the difference from IsConnected. It says what the caller
// asked for, not what the connection is managing: after reconnection has run
// out of attempts this is still true while nothing is retrying any more, and
// Pump returning PUMP_CLOSED is what says so.
@en "Active"
@fa "فعال"
@ar "نشط"
pub func Active(c: Client): bool:
    if c.p == null:
        ret false
    end
    ret _sock(c)[0].active
end

// Pending - how many acknowledgements are still outstanding.
@en "Pending"
@fa "در انتظار"
@ar "معلق"
pub func Pending(c: Client): int:
    if c.p == null:
        ret 0
    end
    sp := _sock(c)
    mut n := 0
    repeat sp[0].waiters.len() with i:
        if sp[0].waiters.get(i).alive:
            n += 1
        end
    end
    ret n
end

// Queued - how many events are waiting for Next to take them.
@en "Queued"
@fa "در صف"
@ar "فی الطابور"
pub func Queued(c: Client): int:
    if c.p == null:
        ret 0
    end
    ret _sock(c)[0].inbox.len()
end

// TransportName - "websocket" or "polling", for logging and for a test that
