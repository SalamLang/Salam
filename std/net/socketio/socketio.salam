@en "TransportName"
@fa "نام حمل‌ونقل"
@ar "اسم النقل"
pub func TransportName(c: Client): str:
    if c.p == null:
        ret ""
    end
    if _mgr_of(c)[0].transport == TRANSPORT_WEBSOCKET:
        ret "websocket"
    end
    ret "polling"
end

