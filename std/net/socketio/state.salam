package socketio

import net.websocket
import mem


@en "TransportAuto"
@fa "حمل‌ونقل خودکار"
@ar "نقل تلقائی"
pub const TRANSPORT_AUTO := 0

@en "TransportWebSocket"
@fa "حمل‌ونقل وب‌سوکت"
@ar "نقل وب‌سوکت"
pub const TRANSPORT_WEBSOCKET := 1

@en "TransportPolling"
@fa "حمل‌ونقل نظرخواهی"
@ar "نقل استقصاء"
pub const TRANSPORT_POLLING := 2

@en "EventNone"
@fa "بدون رویداد"
@ar "بلا حدث"
pub const EV_NONE := 0

@en "EventMessage"
@fa "رویداد پیام"
@ar "حدث رسالة"
pub const EV_EVENT := 1

@en "EventConnect"
@fa "رویداد اتصال"
@ar "حدث اتصال"
pub const EV_CONNECT := 2

@en "EventDisconnect"
@fa "رویداد قطع"
@ar "حدث قطع"
pub const EV_DISCONNECT := 3

@en "EventConnectError"
@fa "رویداد خطای اتصال"
@ar "حدث خطأ الاتصال"
pub const EV_CONNECT_ERROR := 4

@en "EventError"
@fa "رویداد خطا"
@ar "حدث خطأ"
pub const EV_ERROR := 5

@en "EventReconnect"
@fa "رویداد اتصال دوباره"
@ar "حدث إعادة الاتصال"
pub const EV_RECONNECT := 6

@en "EventReconnectAttempt"
@fa "رویداد تلاش دوباره"
@ar "حدث محاولة إعادة"
pub const EV_RECONNECT_ATTEMPT := 7

@en "EventReconnectError"
@fa "رویداد خطای دوباره"
@ar "حدث خطأ إعادة"
pub const EV_RECONNECT_ERROR := 8

@en "EventReconnectFailed"
@fa "رویداد شکست دوباره"
@ar "حدث فشل إعادة"
pub const EV_RECONNECT_FAILED := 9

@en "EventPing"
@fa "رویداد پینگ"
@ar "حدث بینغ"
pub const EV_PING := 10

@en "EventTimeout"
@fa "رویداد مهلت"
@ar "حدث مهلة"
pub const EV_TIMEOUT := 11

@en "EventUpgrade"
@fa "رویداد ارتقا"
@ar "حدث الترقیة"
pub const EV_UPGRADE := 12

@en "ReasonServerDisconnect"
@fa "قطع توسط سرور"
@ar "قطع من الخادم"
pub const REASON_SERVER_DISCONNECT := "io server disconnect"

@en "ReasonClientDisconnect"
@fa "قطع توسط کارخواه"
@ar "قطع من العمیل"
pub const REASON_CLIENT_DISCONNECT := "io client disconnect"

@en "ReasonPingTimeout"
@fa "مهلت پینگ"
@ar "مهلة البینغ"
pub const REASON_PING_TIMEOUT := "ping timeout"

@en "ReasonTransportClose"
@fa "بسته شدن حمل‌ونقل"
@ar "إغلاق النقل"
pub const REASON_TRANSPORT_CLOSE := "transport close"

@en "ReasonTransportError"
@fa "خطای حمل‌ونقل"
@ar "خطأ النقل"
pub const REASON_TRANSPORT_ERROR := "transport error"

@en "ReasonParseError"
@fa "خطای تجزیه"
@ar "خطأ التحلیل"
pub const REASON_PARSE_ERROR := "parse error"

@en "PumpOk"
@fa "پمپ موفق"
@ar "ضخ ناجح"
pub const PUMP_OK := 0

@en "PumpTimeout"
@fa "پمپ مهلت"
@ar "ضخ مهلة"
pub const PUMP_TIMEOUT := 1

@en "PumpClosed"
@fa "پمپ بسته"
@ar "ضخ مغلق"
pub const PUMP_CLOSED := 2

const ST_CLOSED := 0
const ST_OPEN := 1
const ST_WAITING := 2


@en "Options"
@fa "گزینه‌ها"
@ar "خیارات"
pub struct Options:
    pub path: str = "/socket.io"
    pub query: str = ""
    pub auth: str = ""
    pub headers: str = ""
    pub transports: int = TRANSPORT_AUTO
    pub reconnection: bool = true
    pub reconnection_attempts: int = 0
    pub reconnection_delay: int = 1000
    pub reconnection_delay_max: int = 5000
    pub randomization_factor: int = 50
    pub timeout: int = 20000
    pub insecure: bool = false
    pub auto_connect: bool = true
    pub event_queue: int = 256
    pub ack_timeout: int = 0
    pub retries: int = 0
    pub trailing_slash: bool = true
    pub remember_upgrade: bool = false
end

@en "Client"
@fa "کارخواه"
@ar "عمیل"
pub struct Client:
    pub p: void* = null
end

@en "Manager"
@fa "مدیر"
@ar "مدیر"
pub struct Manager:
    pub p: void* = null
end

@en "Event"
@fa "رویداد"
@ar "حدث"
pub struct Event:
    pub kind: int = EV_NONE
    pub name: str = ""
    pub nsp: str = "/"
    pub data: str = "[]"
    pub ack_id: int = 0 - 1
    pub message: str = ""
    pub bins: Vector<Bytes> = Vector {}
    pub client: Client = Client {}
end

@en "Ack"
@fa "تایید"
@ar "إقرار"
pub struct Ack:
    pub ok: bool = false
    pub id: int = 0 - 1
    pub data: str = "[]"
    pub bins: Vector<Bytes> = Vector {}
end

struct Handler:
    pub name: str = ""
    pub once: bool = false
    pub alive: bool = true
    pub cb: func (Event) = (e: Event): end
end

struct Outgoing:
    pub text: str = ""
    pub bins: Vector<Bytes> = Vector {}
end

struct AckWaiter:
    pub id: int = 0 - 1
    pub deadline: i64 = 0
    pub has_deadline: bool = false
    pub alive: bool = true
    pub has_cb: bool = false
    pub cb: func (Ack) = (a: Ack): end
    pub retries_left: int = 0
    pub interval: int = 0
    pub internal: bool = false
    pub has_packet: bool = false
    pub packet: Outgoing = Outgoing {}
end

struct SockState:
    pub mgr: void* = null
    pub nsp: str = "/"
    pub id: str = ""
    pub connected: bool = false
    pub active: bool = false
    pub pid: str = ""
    pub last_offset: str = ""
    pub recovered: bool = false
    pub auth: str = ""
    pub refused: bool = false
    pub refusal: str = ""
    pub ack_seq: int = 0
    pub handlers: Vector<Handler> = Vector {}
    pub any_handlers: Vector<Handler> = Vector {}
    pub out_handlers: Vector<Handler> = Vector {}
    pub waiters: Vector<AckWaiter> = Vector {}
    pub results: Vector<Ack> = Vector {}
    pub outbuf: Vector<Outgoing> = Vector {}
    pub inbox: Vector<Event> = Vector {}
    pub queueing: bool = true
    pub max_queue: int = 256
end

struct MgrState:
    pub ep: Endpoint = Endpoint {}
    pub opts: Options = Options {}
    pub socks: Vector<Client> = Vector {}
    pub state: int = ST_CLOSED
    pub transport: int = TRANSPORT_POLLING
    pub ws: websocket.Conn = websocket.Conn {}
    pub sid: str = ""
    pub ping_interval: int = 25000
    pub ping_timeout: int = 20000
    pub max_payload: int = 1000000
    pub can_upgrade: bool = false
    pub upgraded_before: bool = false
    pub last_rx: i64 = 0
    pub cookies: HashMap<str, str> = HashMap {} as HashMap<str, str>
    pub attempts: int = 0
    pub retry_at: i64 = 0
    pub last_error: str = ""
    pub dispatching: int = 0
    pub pollout: Vector<str> = Vector {}
    pub batching: bool = false
    pub recon: bool = false
    pub recon_pkt: Packet = Packet {}
    pub recon_bins: Vector<Bytes> = Vector {}
end

func _sock(c: Client): SockState*:
    ret c.p as SockState*
end

func _mgr(m: Manager): MgrState*:
    ret m.p as MgrState*
end

func _mgr_of(c: Client): MgrState*:
    ret _sock(c)[0].mgr as MgrState*
end

func _new_sock(mgr: void*, nsp: str): Client:
    raw := mem.AllocateZeroed(sizeof(SockState) as u64)
    if raw == null:
        ret Client {}
    end
    mut sp := raw as SockState*
    sp[0] = SockState { mgr = mgr, nsp = nsp }
    ret Client { p = raw }
end

func _new_mgr(ep: Endpoint, opts: Options): Manager:
    raw := mem.AllocateZeroed(sizeof(MgrState) as u64)
    if raw == null:
        ret Manager {}
    end
    mut mp := raw as MgrState*
    mp[0] = MgrState { ep = ep, opts = opts }
    ret Manager { p = raw }
end

func _free_bins(v &: Vector<Bytes>):
    repeat v.len() with i:
        mut b := v.get(i)
        BytesFree(b)
    end
    v.free()
end
