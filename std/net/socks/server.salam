package socks

import mem
import sync
import net.tcp
import net.udp
import net.internal.rawsock
import net.tunnel

struct _AcceptJob:
    pub cfg: ServerConfig = ServerConfig {}
    pub listener: tcp.Server = tcp.Server {}
    pub stop: i64* = null
    pub limits: tunnel.ConnLimits = tunnel.ConnLimits {}
end

struct _ConnJob:
    pub cfg: ServerConfig = ServerConfig {}
    pub st: dyn tunnel.Stream = tunnel.TcpStream {}
    pub peer: str = ""
    pub limits: tunnel.ConnLimits = tunnel.ConnLimits {}
    pub adm: tunnel.Admit = tunnel.Admit {}
end

struct _UState:
    pub learned: bool = false
    pub ch: str = ""
    pub cp: int = 0
end

struct _UDPJob:
    pub cfg: ServerConfig = ServerConfig {}
    pub sock: udp.Socket = udp.Socket {}
    pub osock: udp.Socket = udp.Socket {}
    pub chost: str = ""
    pub cport: int = 0
    pub stop: i64* = null
end

@en "ServerConfig"
@fa "پیکربندی سرور"
pub struct ServerConfig:
    @en "port"
    @fa "درگاه"
    pub port: int = 0
    @en "require_auth"
    @fa "نیاز به احراز هویت"
    pub require_auth: bool = false
    @en "users"
    @fa "کاربران"
    pub users: HashMap<str, str> = HashMap {}
    @en "auth"
    @fa "احراز هویت"
    pub auth: func (str, str) bool = (_u: str, _p: str): ret false end
    @en "has_auth"
    @fa "دارای احراز هویت سفارشی"
    pub has_auth: bool = false
    @en "allow_v4"
    @fa "اجازه ساکس۴"
    pub allow_v4: bool = true
    @en "allow_bind"
    @fa "اجازه پیوند"
    pub allow_bind: bool = false
    @en "allow_udp"
    @fa "اجازه یو دی پی"
    pub allow_udp: bool = true
    @en "bind_host"
    @fa "میزبان پیوند"
    pub bind_host: str = "127.0.0.1"
    @en "handshake_timeout_ms"
    @fa "مهلت دست‌دهی میلی‌ثانیه"
    pub handshake_timeout_ms: int = 10000
    @en "idle_timeout_ms"
    @fa "مهلت بی‌کاری میلی‌ثانیه"
    pub idle_timeout_ms: int = 0
    @en "connect"
    @fa "اتصال به مقصد"
    pub connect: func (str, int) Outbound = (h: str, p: int): ret DirectConnect(h, p, 10000) end
    @en "allow"
    @fa "اجازه"
    pub allow: func (int, str, int) bool = (_c: int, _h: str, _p: int): ret true end
    @en "policy"
    @fa "سیاست مقصد"
    pub policy: tunnel.DestPolicy = tunnel.DestPolicy {}
    @en "has_connect"
    @fa "اتصال سفارشی دارد"
    pub has_connect: bool = false
    @en "max_connections"
    @fa "بیشینه اتصال همزمان"
    pub max_connections: int = 1024
    @en "max_per_source"
    @fa "بیشینه دست دادن مبدا"
    pub max_per_source: int = 32
    @en "handshake_deadline_ms"
    @fa "مهلت کل دست‌دهی"
    pub handshake_deadline_ms: int = 10000
end

@en "Server"
@fa "سرور"
pub struct Server:
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
    @en "port"
    @fa "درگاه"
    pub port: int = 0
    @en "host"
    @fa "میزبان"
    pub host: str = ""
    @en "listener"
    @fa "شنونده"
    pub listener: tcp.Server = tcp.Server {}
    @en "stop_cell"
    @fa "پرچم توقف"
    pub stop_cell: i64* = null
end

func _ct_eq(a: str, b: str): bool:
    n := a.Len()
    m := b.Len()
    mut diff := n ^ m
    pa := a as u8*
    pb := b as u8*
    mut i := 0
    until i < n:
        mut y := 0
        if i < m: y = pb[i] as int end
        diff |= (pa[i] as int) ^ y
        i++
    end
    ret diff == 0
end

func _authorized(cfg: ServerConfig, user: str, pass: str): bool:
    if cfg.users.Has(user):
        if _ct_eq(cfg.users.Get(user), pass): ret true end
    end
    if cfg.has_auth: ret cfg.auth(user, pass) end
    ret false
end

func _reply(s: dyn tunnel.Stream, ver: int, code: int, a: Address): bool:
    if ver == 5:
        v := EncodeReply(code, a)
        defer v.Free()
        ret _send(s, v)
    end
    mut c := Rep4Rejected
    if code == RepSucceeded: c = Rep4Granted end
    mut host := "0.0.0.0"
    if a.kind == AtypIPv4: host = a.host end
    v := Encode4Reply(c, host, a.port)
    defer v.Free()
    ret _send(s, v)
end

func _bind_host(cfg: ServerConfig): str:
    if cfg.bind_host.Len() == 0:
        ret "127.0.0.1"
    end
    ret rawsock.CanonIP(cfg.bind_host)
end

func _wild(): Address:
    ret Address { kind = AtypIPv4, host = "0.0.0.0", port = 0 }
end

func _read_cstr(s: dyn tunnel.Stream, v &: Vector<u8>, max: int): bool:
    mut n := 0
    until n <= max:
        b := tunnel.ReadByte(s)
        if b < 0: ret false end
        v.Push(b as u8)
        if b == 0: ret true end
        n++
    end
    ret false
end

func _policy(cfg: ServerConfig): tunnel.DestPolicy:
    ret tunnel.PolicyForBind(cfg.policy, _bind_host(cfg))
end

func _outbound(cfg: ServerConfig, a: Address): Outbound:
    pol := _policy(cfg)
    if cfg.has_connect:
        pl := tunnel.PolicyPlan(pol, tunnel.NewAddr(a.host, a.port), false)
        if not pl.allowed:
            ret Outbound { ok = false, code = RepNotAllowed, err = pl.reason }
        end
        ret cfg.connect(a.host, a.port)
    end
    ret PolicyConnect(pol, a.host, a.port, 10000)
end

func _do_connect(cfg: ServerConfig, s: dyn tunnel.Stream, ver: int, a: Address):
    if not cfg.allow(CmdConnect, a.host, a.port):
        _reply(s, ver, RepNotAllowed, _wild())
        s.Close()
        ret
    end
    out := _outbound(cfg, a)
    if not out.ok:
        mut code := out.code
        if code == RepSucceeded: code = RepGeneralFailure end
        _reply(s, ver, code, _wild())
        s.Close()
        ret
    end
    mut bound := out.bound
    if bound.kind == 0: bound = _wild() end
    if not _reply(s, ver, RepSucceeded, bound):
        out.stream.Close()
        s.Close()
        ret
    end
    Relay(s, out.stream, cfg.idle_timeout_ms)
end

func _do_bind(cfg: ServerConfig, s: dyn tunnel.Stream, ver: int, a: Address):
    if not cfg.allow_bind:
        _reply(s, ver, RepCmdNotSupported, _wild())
        s.Close()
        ret
    end
    if not cfg.allow(CmdBind, a.host, a.port) or not tunnel.PolicyPlan(_policy(cfg), tunnel.NewAddr(a.host, a.port), false).allowed:
        _reply(s, ver, RepNotAllowed, _wild())
        s.Close()
        ret
    end
    mut bh := _bind_host(cfg)
    if a.kind == AtypIPv6 and rawsock.IsIPv4(bh):
        if bh == "0.0.0.0":
            bh = "::"
        else:
            bh = "::1"
        end
    end
    ls := tcp.BindOn(bh, 0)
    if not tcp.Ok(ls):
        _reply(s, ver, RepGeneralFailure, _wild())
        s.Close()
        ret
    end
    port := tcp.Port(ls)
    if not _reply(s, ver, RepSucceeded, NewAddress(bh, port)):
        tcp.CloseServer(ls)
        s.Close()
        ret
    end
    waited := rawsock.WaitReadable(rawsock.FromFd(ls.fd), 60000)
    if not waited:
        tcp.CloseServer(ls)
        _reply(s, ver, RepGeneralFailure, _wild())
        s.Close()
        ret
    end
    conn := tcp.Accept(ls)
    tcp.CloseServer(ls)
    if not tcp.ConnOk(conn):
        _reply(s, ver, RepGeneralFailure, _wild())
        s.Close()
        ret
    end
    peer := tunnel.TcpStream { conn = conn }
    mut pport := 0
    phost := rawsock.PeerAddr(rawsock.FromFd(conn.fd), pport)
    if not tunnel.PolicyCheckIP(_policy(cfg), phost):
        peer.Close()
        _reply(s, ver, RepNotAllowed, _wild())
        s.Close()
        ret
    end
    mut paddr := _wild()
    if phost.Len() > 0: paddr = NewAddress(phost, pport) end
    if not _reply(s, ver, RepSucceeded, paddr):
        peer.Close()
        s.Close()
        ret
    end
    Relay(s, peer, cfg.idle_timeout_ms)
end

func _decode_head(ibuf: void*, n: int, hd &: UDPHeader): bool:
    mut hv := Vector {} as Vector<u8>
    ip := ibuf as u8*
    mut lim := n
    if lim > 300: lim = 300 end
    repeat lim in i:
        hv.Push(ip[i])
    end
    ok := DecodeUDPHeader(hv, hd)
    hv.Free()
    ret ok
end

func _udp_forward(cfg: ServerConfig, osock: udp.Socket, ibuf: void*, n: int, hd: UDPHeader):
    if hd.frag == 0 and cfg.allow(CmdUDPAssociate, hd.addr.host, hd.addr.port):
        pl := tunnel.PolicyPlan(_policy(cfg), tunnel.NewAddr(hd.addr.host, hd.addr.port), true)
        if pl.allowed and pl.ips.Len() > 0:
            plen := n - hd.length
            udp.SendBytes(osock, pl.ips[0], hd.addr.port, ((ibuf as i64) + (hd.length as i64)) as void*, plen)
        end
        pl.ips.Free()
    end
end

func _udp_wrap(sock: udp.Socket, st: _UState, obuf: void*, ibuf: void*, n: int, fh: str, fp: int):
    hdr := EncodeUDPHeader(NewAddress(fh, fp), 0)
    hl := hdr.Len()
    if hl > 0:
        op := obuf as u8*
        repeat hl in i:
            op[i] = hdr.Get(i)
        end
        mem.Copy(((obuf as i64) + (hl as i64)) as void*, ibuf, n as u64)
        udp.SendBytes(sock, st.ch, st.cp, obuf, hl + n)
    end
    hdr.Free()
end

func _udp_thread(arg: i64):
    jp := (arg as void*) as _UDPJob*
    cfg := jp[0].cfg
    sock := jp[0].sock
    osock := jp[0].osock
    chost := jp[0].chost
    cport := jp[0].cport
    stop := jp[0].stop
    mem.Free(jp as void*)
    split := osock.fd != sock.fd
    cap := 65535 + 300
    ibuf := mem.Allocate(cap as u64)
    obuf := mem.Allocate(cap as u64)
    mut st := _UState {}
    mut expect := rawsock.CanonIP(chost)
    if expect == "0.0.0.0" or expect == "::": expect = "" end
    if cport != 0 and expect.Len() > 0:
        st.learned = true
        st.ch = expect
        st.cp = cport
    end
    rs := rawsock.FromFd(sock.fd)
    ro := rawsock.FromFd(osock.fd)
    until atomic_load(stop) != 0:
        mut ready := 1
        if split:
            ready = rawsock.WaitReadable2(rs, ro, 400)
        else:
            if not rawsock.WaitReadable(rs, 400): ready = 0 end
        end
        if (ready & 1) != 0:
            mut fh := ""
            mut fp := 0
            n := udp.ReceiveBytes(sock, ibuf, cap, fh, fp)
            if n > 0:
                mut hd := UDPHeader {}
                if st.learned and fh == st.ch and fp == st.cp:
                    if _decode_head(ibuf, n, hd): _udp_forward(cfg, osock, ibuf, n, hd) end
                else not st.learned and (expect.Len() == 0 or fh == expect):
                    if _decode_head(ibuf, n, hd):
                        st.learned = true
                        st.ch = fh
                        st.cp = fp
                        _udp_forward(cfg, osock, ibuf, n, hd)
                    end
                else st.learned and not split:
                    _udp_wrap(sock, st, obuf, ibuf, n, fh, fp)
                end
            end
        end
        if split and (ready & 2) != 0:
            mut fh := ""
            mut fp := 0
            n := udp.ReceiveBytes(osock, ibuf, cap, fh, fp)
            if n > 0 and st.learned:
                _udp_wrap(sock, st, obuf, ibuf, n, fh, fp)
            end
        end
    end
    udp.Close(sock)
    if split:
        udp.Close(osock)
    end
    mem.Free(stop as void*)
    mem.Free(ibuf)
    mem.Free(obuf)
end

func _do_udp(cfg: ServerConfig, s: dyn tunnel.Stream, a: Address, peer: str):
    if not cfg.allow_udp:
        _reply(s, 5, RepCmdNotSupported, _wild())
        s.Close()
        ret
    end
    bh := _bind_host(cfg)
    us := udp.BindOn(bh, 0)
    if not udp.Ok(us):
        _reply(s, 5, RepGeneralFailure, _wild())
        s.Close()
        ret
    end
    mut os := us
    if bh != "::":
        wide := udp.OpenAny()
        if udp.Ok(wide): os = wide end
    end
    stop := mem.AllocateZeroed(8 as u64) as i64*
    atomic_store(stop, 1 as i64)
    jb := mem.AllocateZeroed(sizeof(_UDPJob) as u64) as _UDPJob*
    mut chost := a.host
    if (chost == "0.0.0.0" or chost == "::" or chost.Len() == 0) and peer.Len() > 0:
        chost = peer
    end
    jb[0] = _UDPJob { cfg = cfg, sock = us, osock = os, chost = chost, cport = a.port, stop = stop }
    if not _reply(s, 5, RepSucceeded, NewAddress(bh, udp.Port(us))):
        udp.Close(us)
        if os.fd != us.fd: udp.Close(os) end
        mem.Free(stop as void*)
        mem.Free(jb as void*)
        s.Close()
        ret
    end
    Go(_udp_thread, jb as void*)
    s.SetDeadline(0)
    buf := mem.Allocate(64 as u64)
    until s.ReadBytes(buf, 64) > 0:
        continue
    end
    mem.Free(buf)
    atomic_store(stop, 0 as i64)
    s.Close()
end

func _hs5(cfg: ServerConfig, s: dyn tunnel.Stream, req &: Request, user &: str): bool:
    nm := tunnel.ReadByte(s)
    if nm <= 0:
        ret false
    end
    mut mv := Vector {} as Vector<u8>
    defer mv.Free()
    if not _recv(s, mv, nm):
        ret false
    end
    mut has0 := false
    mut has2 := false
    repeat nm in i:
        if _b(mv, i) == AuthNone: has0 = true end
        if _b(mv, i) == AuthUserPass: has2 = true end
    end
    mut choice := AuthNoAcceptable
    if cfg.require_auth:
        if has2: choice = AuthUserPass end
    else has0:
        choice = AuthNone
    end
    cv := EncodeMethodChoice(choice)
    _send(s, cv)
    cv.Free()
    if choice == AuthNoAcceptable:
        ret false
    end
    if choice == AuthUserPass:
        if tunnel.ReadByte(s) != 1:
            ret false
        end
        ul := tunnel.ReadByte(s)
        mut uv := Vector {} as Vector<u8>
        defer uv.Free()
        if ul < 1 or not _recv(s, uv, ul):
            ret false
        end
        pl := tunnel.ReadByte(s)
        mut pv := Vector {} as Vector<u8>
        defer pv.Free()
        if pl < 0 or (pl > 0 and not _recv(s, pv, pl)):
            ret false
        end
        uname := _bytes_str(uv, 0, ul)
        okp := _authorized(cfg, uname, _bytes_str(pv, 0, pl))
        ar := EncodeAuthReply(okp)
        _send(s, ar)
        ar.Free()
        if not okp:
            ret false
        end
        user = uname
    end
    mut rq := Vector {} as Vector<u8>
    defer rq.Free()
    if not _recv(s, rq, 4):
        ret false
    end
    t := _b(rq, 3)
    mut more := 0
    if t == AtypIPv4:
        more = 6
    else t == AtypIPv6:
        more = 18
    else t == AtypDomain:
        if not _recv(s, rq, 1):
            ret false
        end
        more = _b(rq, 4) + 2
    else:
        _reply(s, 5, RepAtypNotSupported, _wild())
        ret false
    end
    if not _recv(s, rq, more):
        ret false
    end
    if DecodeRequest(rq, req) <= 0:
        _reply(s, 5, RepGeneralFailure, _wild())
        ret false
    end
    ret true
end

func _serve5(cfg: ServerConfig, s: dyn tunnel.Stream, peer: str, lim: tunnel.ConnLimits, adm &: tunnel.Admit):
    mut req := Request {}
    mut user := ""
    okh := _hs5(cfg, s, req, user)
    tunnel.LimitsHandshakeDone(lim, adm)
    if not okh:
        s.Close()
        ret
    end
    switch req.cmd:
        1:
            _do_connect(cfg, s, 5, req.addr)
            break
        end
        2:
            _do_bind(cfg, s, 5, req.addr)
            break
        end
        3:
            _do_udp(cfg, s, req.addr, peer)
            break
        end
        else:
            _reply(s, 5, RepCmdNotSupported, _wild())
            s.Close()
        end
    end
end

func _hs4(cfg: ServerConfig, s: dyn tunnel.Stream, req &: Request): bool:
    mut v := Vector {} as Vector<u8>
    defer v.Free()
    v.Push(4 as u8)
    if not _recv(s, v, 7):
        ret false
    end
    if not _read_cstr(s, v, 255):
        ret false
    end
    if _b(v, 4) == 0 and _b(v, 5) == 0 and _b(v, 6) == 0 and _b(v, 7) != 0:
        if not _read_cstr(s, v, 255):
            ret false
        end
    end
    if Decode4Request(v, req) <= 0:
        _reply(s, 4, RepGeneralFailure, _wild())
        ret false
    end
    if cfg.require_auth:
        bad := Encode4Reply(Rep4BadUser, "0.0.0.0", 0)
        _send(s, bad)
        bad.Free()
        ret false
    end
    ret true
end

func _serve4(cfg: ServerConfig, s: dyn tunnel.Stream, lim: tunnel.ConnLimits, adm &: tunnel.Admit):
    mut req := Request {}
    okh := _hs4(cfg, s, req)
    tunnel.LimitsHandshakeDone(lim, adm)
    if not okh:
        s.Close()
        ret
    end
    switch req.cmd:
        1:
            _do_connect(cfg, s, 4, req.addr)
            break
        end
        2:
            _do_bind(cfg, s, 4, req.addr)
            break
        end
        else:
            _reply(s, 4, RepCmdNotSupported, _wild())
            s.Close()
        end
    end
end

func _handle(cfg: ServerConfig, s: dyn tunnel.Stream, peer: str, lim: tunnel.ConnLimits, adm &: tunnel.Admit):
    s.SetDeadline(cfg.handshake_timeout_ms)
    v := tunnel.ReadByte(s)
    if v == 5:
        _serve5(cfg, s, peer, lim, adm)
    else v == 4 and cfg.allow_v4:
        _serve4(cfg, s, lim, adm)
    else:
        tunnel.LimitsHandshakeDone(lim, adm)
        s.Close()
    end
end

func _conn_thread(arg: i64):
    jp := (arg as void*) as _ConnJob*
    cfg := jp[0].cfg
    st := jp[0].st
    peer := jp[0].peer
    lim := jp[0].limits
    mut adm := jp[0].adm
    mem.Free(jp as void*)
    _handle(cfg, st, peer, lim, adm)
    tunnel.LimitsRelease(lim, adm)
end

func _accept_thread(arg: i64):
    jp := (arg as void*) as _AcceptJob*
    cfg := jp[0].cfg
    lst := jp[0].listener
    stop := jp[0].stop
    limits := jp[0].limits
    mem.Free(jp as void*)
    until atomic_load(stop) != 0:
        c := tcp.Accept(lst)
        if atomic_load(stop) == 0:
            if tcp.ConnOk(c): tcp.Close(c) end
        else not tcp.ConnOk(c):
            sync.SleepMs(5)
        else:
            adm := tunnel.LimitsEnter(limits, c.fd)
            if not adm.ok:
                tcp.Close(c)
            else:
                cj := mem.AllocateZeroed(sizeof(_ConnJob) as u64) as _ConnJob*
                cj[0] = _ConnJob { cfg = cfg, st = tunnel.TcpStream { conn = c }, peer = adm.host, limits = limits, adm = adm }
                if not Go(_conn_thread, cj as void*):
                    mut failed := adm
                    tunnel.LimitsRelease(limits, failed)
                    tcp.Close(c)
                    mem.Free(cj as void*)
                end
            end
        end
    end
    tcp.CloseServer(lst)
    mem.Free(stop as void*)
end

@en "NewServerConfig"
@fa "پیکربندی سرور جدید"
pub func NewServerConfig(port: int): ServerConfig:
    ret ServerConfig { port = port }
end

@en "AddUser"
@fa "افزودن کاربر"
pub func AddUser(cfg &: ServerConfig, user: str, pass: str):
    cfg.users.Put(user, pass)
    cfg.require_auth = true
end

@en "SetAuth"
@fa "تعیین احراز هویت"
pub func SetAuth(cfg &: ServerConfig, check: func (str, str) bool):
    cfg.auth = check
    cfg.has_auth = true
    cfg.require_auth = true
end

@en "SetConnector"
@fa "تعیین اتصال به مقصد"
pub func SetConnector(cfg &: ServerConfig, connect: func (str, int) Outbound):
    cfg.connect = connect
    cfg.has_connect = true
end

@en "SetPolicy"
@fa "تعیین سیاست مقصد"
pub func SetPolicy(cfg &: ServerConfig, p: tunnel.DestPolicy):
    cfg.policy = p
end

@en "AllowPrivate"
@fa "اجازه آدرس‌های خصوصی"
pub func AllowPrivate(cfg &: ServerConfig, enabled: bool):
    cfg.policy.allow_private = enabled
end

@en "Handle"
@fa "رسیدگی"
pub func Handle(cfg: ServerConfig, s: dyn tunnel.Stream):
    mut adm := tunnel.Admit { done = true }
    _handle(cfg, s, "", tunnel.ConnLimits {}, adm)
end


@en "Start"
@fa "شروع"
pub func Start(cfg: ServerConfig): Server:
    mut sv := Server {}
    ls := tcp.BindOn(_bind_host(cfg), cfg.port)
    if not tcp.Ok(ls): ret sv end
    stop := mem.AllocateZeroed(8 as u64) as i64*
    atomic_store(stop, 1 as i64)
    jb := mem.AllocateZeroed(sizeof(_AcceptJob) as u64) as _AcceptJob*
    jb[0] = _AcceptJob { cfg = cfg, listener = ls, stop = stop, limits = tunnel.NewConnLimits(cfg.max_connections, cfg.max_per_source, cfg.handshake_deadline_ms) }
    sv.ok = true
    sv.port = tcp.Port(ls)
    sv.host = _bind_host(cfg)
    sv.listener = ls
    sv.stop_cell = stop
    Go(_accept_thread, jb as void*)
    ret sv
end

@en "Stop"
@fa "توقف"
pub func Stop(sv: Server):
    if not sv.ok: ret end
    atomic_store(sv.stop_cell, 0 as i64)
    rawsock.Shutdown(rawsock.FromFd(sv.listener.fd))
    tcp.WakeServer(sv.host, sv.port)
end

@en "Serve"
@fa "خدمت‌رسانی"
pub func Serve(cfg: ServerConfig): bool:
    sv := Start(cfg)
    if not sv.ok: ret false end
    until sv.ok:
        sync.SleepMs(1000)
    end
    ret true
end
