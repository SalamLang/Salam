@en "AtypIPv4"
@fa "نوع آی‌پی۴"
pub const AtypIPv4 := 1

@en "AtypDomain"
@fa "نوع دامنه"
pub const AtypDomain := 3

@en "AtypIPv6"
@fa "نوع آی‌پی۶"
pub const AtypIPv6 := 4

