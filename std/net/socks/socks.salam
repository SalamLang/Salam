@en "Address"
@fa "نشانی"
pub struct Address:
    @en "kind"
    @fa "نوع"
    pub kind: int = 0
    @en "host"
    @fa "میزبان"
    pub host: str = ""
    @en "port"
    @fa "درگاه"
    pub port: int = 0
end

@en "Request"
@fa "درخواست"
pub struct Request:
    @en "version"
    @fa "نسخه"
    pub version: int = 0
    @en "cmd"
    @fa "فرمان"
    pub cmd: int = 0
    @en "addr"
    @fa "نشانی"
    pub addr: Address = Address {}
    @en "user"
    @fa "کاربر"
    pub user: str = ""
end

@en "Reply"
@fa "پاسخ"
pub struct Reply:
    @en "version"
    @fa "نسخه"
    pub version: int = 0
    @en "code"
    @fa "کد"
    pub code: int = 0
    @en "addr"
    @fa "نشانی"
    pub addr: Address = Address {}
end

@en "UDPHeader"
@fa "سرآیند یو دی پی"
pub struct UDPHeader:
    @en "frag"
    @fa "قطعه"
    pub frag: int = 0
    @en "addr"
    @fa "نشانی"
    pub addr: Address = Address {}
    @en "length"
    @fa "طول سرآیند"
    pub length: int = 0
end

inline func _b(v: Vector<u8>, i: int): int:
    ret v.get(i) as int
end

func _digit(c: int): int:
    if c >= 48 and c <= 57: ret c - 48 end
    if c >= 97 and c <= 102: ret c - 87 end
    if c >= 65 and c <= 70: ret c - 55 end
    ret 0 - 1
end

func _ch(s: str, i: int): int:
    p := s as u8*
    ret p[i] as int
end

func _put16(v &: Vector<u8>, n: int):
    v.push(((n >> 8) & 255) as u8)
    v.push((n & 255) as u8)
end

func _put_str(v &: Vector<u8>, s: str):
    n := s.len()
    repeat n in i:
        v.push(_ch(s, i) as u8)
    end
end

func _bytes_str(v: Vector<u8>, off: int, n: int): str:
    buf := mem.AllocateZeroed((n + 1) as u64)
    defer mem.Free(buf)
    p := buf as u8*
    repeat n in i:
        p[i] = v.get(off + i)
    end
    ret str.Clone(buf as str)
end

func _v6_groups(part: str, groups &: Vector<int>): bool:
    n := part.len()
    if n == 0: ret true end
    mut val := 0
    mut digits := 0
    mut i := 0
    mut seg_start := 0
    until i <= n:
        mut c := 58
        if i < n: c = _ch(part, i) end
        if c == 58:
            if digits == 0: ret false end
            groups.push(val)
            val = 0
            digits = 0
            seg_start = i + 1
        else c == 46:
            tail := part.substr(seg_start, n - seg_start)
            mut b4 := Vector {} as Vector<u8>
            defer b4.free()
            if not ParseIPv4(tail, b4): ret false end
            if groups.len() > 0 and digits == 0 and seg_start == i: ret false end
            groups.push(_b(b4, 0) * 256 + _b(b4, 1))
            groups.push(_b(b4, 2) * 256 + _b(b4, 3))
            ret true
        else:
            d := _digit(c)
            if d < 0: ret false end
            val = val * 16 + d
            digits++
            if digits > 4: ret false end
        end
        i++
    end
    ret true
end

func _hex(n: int): str:
    digits := "0123456789abcdef"
    mut out := ""
    mut x := n
    if x == 0: ret "0" end
    until x > 0:
        out = digits.substr(x & 15, 1) + out
        x = x >> 4
    end
    ret out
end

@en "ParseIPv4"
@fa "تجزیه آی‌پی۴"
pub func ParseIPv4(s: str, out &: Vector<u8>): bool:
    n := s.len()
    if n < 7 or n > 15: ret false end
    mut parts := 0
    mut val := 0
    mut digits := 0
    mut tmp := Vector {} as Vector<u8>
    defer tmp.free()
    repeat n in i:
        c := _ch(s, i)
        if c == 46:
            if digits == 0: ret false end
            tmp.push(val as u8)
            parts++
            val = 0
            digits = 0
        else c >= 48 and c <= 57:
            val = val * 10 + (c - 48)
            digits++
            if digits > 3 or val > 255: ret false end
        else:
            ret false
        end
    end
    if digits == 0 or parts != 3: ret false end
    tmp.push(val as u8)
    out.clear()
    repeat 4 in k:
        out.push(tmp.get(k))
    end
    ret true
end

@en "ParseIPv6"
@fa "تجزیه آی‌پی۶"
pub func ParseIPv6(s: str, out &: Vector<u8>): bool:
    n := s.len()
    if n < 2 or n > 45: ret false end
    dc := s.find("::")
    mut head := Vector {} as Vector<int>
    mut tail := Vector {} as Vector<int>
    defer head.free()
    defer tail.free()
    mut ok := false
    if dc < 0:
        ok = _v6_groups(s, head)
        if not ok or head.len() != 8: ret false end
    else:
        rest := s.substr(dc + 2, n - dc - 2)
        if rest.find("::") >= 0: ret false end
        if not _v6_groups(s.substr(0, dc), head): ret false end
        if not _v6_groups(rest, tail): ret false end
        if head.len() + tail.len() > 7: ret false end
        mut fill := 8 - head.len() - tail.len()
        until fill > 0:
            head.push(0)
            fill--
        end
        repeat tail.len() in i:
            head.push(tail.get(i))
        end
    end
    out.clear()
    repeat 8 in g:
        w := head.get(g)
        out.push(((w >> 8) & 255) as u8)
        out.push((w & 255) as u8)
    end
    ret true
end

@en "FormatIPv4"
@fa "قالب آی‌پی۴"
pub func FormatIPv4(v: Vector<u8>, off: int): str:
    ret str.FromInt(_b(v, off) as i64) + "." + str.FromInt(_b(v, off + 1) as i64) + "." + str.FromInt(_b(v, off + 2) as i64) + "." + str.FromInt(_b(v, off + 3) as i64)
end

@en "FormatIPv6"
@fa "قالب آی‌پی۶"
pub func FormatIPv6(v: Vector<u8>, off: int): str:
    mut g := Vector {} as Vector<int>
    defer g.free()
    repeat 8 in i:
        g.push(_b(v, off + 2 * i) * 256 + _b(v, off + 2 * i + 1))
    end
    mut best_at := 0 - 1
    mut best_len := 0
    mut i := 0
    until i < 8:
        if g.get(i) == 0:
            mut j := i
            until j < 8 and g.get(j) == 0:
                j++
            end
            if j - i > best_len:
                best_len = j - i
                best_at = i
            end
            i = j
        else:
            i++
        end
    end
    if best_len < 2: best_at = 0 - 1 end
    mut out := ""
    mut k := 0
    until k < 8:
        if k == best_at:
            out += "::"
            k += best_len
        else:
            if out.len() > 0 and not out.ends_with(":"): out += ":" end
            out += _hex(g.get(k))
            k++
        end
    end
    ret out
end

@en "ClassifyHost"
@fa "دسته‌بندی میزبان"
pub func ClassifyHost(host: str): int:
    mut b := Vector {} as Vector<u8>
    defer b.free()
    if ParseIPv4(host, b): ret AtypIPv4 end
    if host.find(":") >= 0 and ParseIPv6(host, b): ret AtypIPv6 end
    ret AtypDomain
end

@en "NewAddress"
@fa "نشانی جدید"
pub func NewAddress(host: str, port: int): Address:
    ret Address { kind = ClassifyHost(host), host = host, port = port }
end

@en "EncodeAddress"
@fa "رمزگذاری نشانی"
pub func EncodeAddress(a: Address): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    if a.port < 0 or a.port > 65535: ret v end
    if a.kind == AtypIPv4:
        mut b := Vector {} as Vector<u8>
        defer b.free()
        if not ParseIPv4(a.host, b): ret v end
        v.push(1 as u8)
        repeat 4 in i:
            v.push(b.get(i))
        end
    else a.kind == AtypIPv6:
        mut b := Vector {} as Vector<u8>
        defer b.free()
        if not ParseIPv6(a.host, b): ret v end
        v.push(4 as u8)
        repeat 16 in i:
            v.push(b.get(i))
        end
    else a.kind == AtypDomain:
        n := a.host.len()
        if n < 1 or n > 255: ret v end
        v.push(3 as u8)
        v.push(n as u8)
        _put_str(v, a.host)
    else:
        ret v
    end
    _put16(v, a.port)
    ret v
end

@en "DecodeAddress"
@fa "رمزگشایی نشانی"
pub func DecodeAddress(data: Vector<u8>, off: int, out &: Address): int:
    have := data.len() - off
    if have < 1: ret 0 end
    t := _b(data, off)
    if t == AtypIPv4:
        if have < 7: ret 0 end
        out.kind = AtypIPv4
        out.host = FormatIPv4(data, off + 1)
        out.port = _b(data, off + 5) * 256 + _b(data, off + 6)
        ret 7
    else t == AtypIPv6:
        if have < 19: ret 0 end
        out.kind = AtypIPv6
        out.host = FormatIPv6(data, off + 1)
        out.port = _b(data, off + 17) * 256 + _b(data, off + 18)
        ret 19
    else t == AtypDomain:
        if have < 2: ret 0 end
        n := _b(data, off + 1)
        if n == 0: ret 0 - 1 end
        if have < 4 + n: ret 0 end
        out.kind = AtypDomain
        out.host = _bytes_str(data, off + 2, n)
        out.port = _b(data, off + 2 + n) * 256 + _b(data, off + 3 + n)
        ret 4 + n
    end
    ret 0 - 1
end

@en "EncodeGreeting"
@fa "رمزگذاری سلام"
pub func EncodeGreeting(methods: Vector<u8>): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    v.push(5 as u8)
    v.push(methods.len() as u8)
    repeat methods.len() in i:
        v.push(methods.get(i))
    end
    ret v
end

@en "EncodeMethodChoice"
@fa "رمزگذاری انتخاب روش"
pub func EncodeMethodChoice(method: int): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    v.push(5 as u8)
    v.push(method as u8)
    ret v
end

@en "EncodeAuthRequest"
@fa "رمزگذاری درخواست احراز هویت"
pub func EncodeAuthRequest(user: str, pass: str): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    if user.len() < 1 or user.len() > 255 or pass.len() > 255: ret v end
    v.push(1 as u8)
    v.push(user.len() as u8)
    _put_str(v, user)
    v.push(pass.len() as u8)
    _put_str(v, pass)
    ret v
end

@en "EncodeAuthReply"
@fa "رمزگذاری پاسخ احراز هویت"
pub func EncodeAuthReply(ok: bool): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    v.push(1 as u8)
    if ok: v.push(0 as u8) else:
        v.push(1 as u8) end
    ret v
end

@en "EncodeRequest"
@fa "رمزگذاری درخواست"
pub func EncodeRequest(cmd: int, a: Address): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    enc := EncodeAddress(a)
    defer enc.free()
    if enc.len() == 0: ret v end
    v.push(5 as u8)
    v.push(cmd as u8)
    v.push(0 as u8)
    repeat enc.len() in i:
        v.push(enc.get(i))
    end
    ret v
end

@en "EncodeReply"
@fa "رمزگذاری پاسخ"
pub func EncodeReply(code: int, a: Address): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    mut addr := a
    if addr.kind == 0: addr = Address { kind = AtypIPv4, host = "0.0.0.0", port = 0 } end
    enc := EncodeAddress(addr)
    defer enc.free()
    if enc.len() == 0: ret v end
    v.push(5 as u8)
    v.push(code as u8)
    v.push(0 as u8)
    repeat enc.len() in i:
        v.push(enc.get(i))
    end
    ret v
end

@en "DecodeRequest"
@fa "رمزگشایی درخواست"
pub func DecodeRequest(data: Vector<u8>, out &: Request): int:
    if data.len() < 4: ret 0 end
    if _b(data, 0) != 5 or _b(data, 2) != 0: ret 0 - 1 end
    mut a := Address {}
    n := DecodeAddress(data, 3, a)
    if n <= 0: ret n end
    out.version = 5
    out.cmd = _b(data, 1)
    out.addr = a
    ret 3 + n
end

@en "DecodeReply"
@fa "رمزگشایی پاسخ"
pub func DecodeReply(data: Vector<u8>, out &: Reply): int:
    if data.len() < 4: ret 0 end
    if _b(data, 0) != 5 or _b(data, 2) != 0: ret 0 - 1 end
    mut a := Address {}
    n := DecodeAddress(data, 3, a)
    if n <= 0: ret n end
    out.version = 5
    out.code = _b(data, 1)
    out.addr = a
    ret 3 + n
end

@en "EncodeUDPHeader"
@fa "رمزگذاری سرآیند یو دی پی"
pub func EncodeUDPHeader(a: Address, frag: int): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    enc := EncodeAddress(a)
    defer enc.free()
    if enc.len() == 0: ret v end
    v.push(0 as u8)
    v.push(0 as u8)
    v.push(frag as u8)
    repeat enc.len() in i:
        v.push(enc.get(i))
    end
    ret v
end

@en "DecodeUDPHeader"
@fa "رمزگشایی سرآیند یو دی پی"
pub func DecodeUDPHeader(data: Vector<u8>, out &: UDPHeader): bool:
    if data.len() < 4: ret false end
    if _b(data, 0) != 0 or _b(data, 1) != 0: ret false end
    mut a := Address {}
    n := DecodeAddress(data, 3, a)
    if n <= 0: ret false end
    out.frag = _b(data, 2)
    out.addr = a
    out.length = 3 + n
    ret true
end

@en "Encode4Request"
@fa "رمزگذاری درخواست ساکس۴"
pub func Encode4Request(cmd: int, host: str, port: int, user: str): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    if port < 0 or port > 65535 or user.len() > 255: ret v end
    mut ip := Vector {} as Vector<u8>
    defer ip.free()
    mut domain := false
    if not ParseIPv4(host, ip):
        if host.len() < 1 or host.len() > 255: ret v end
        domain = true
    end
    v.push(4 as u8)
    v.push(cmd as u8)
    _put16(v, port)
    if domain:
        v.push(0 as u8)
        v.push(0 as u8)
        v.push(0 as u8)
        v.push(1 as u8)
    else:
        repeat 4 in i:
            v.push(ip.get(i))
        end
    end
    _put_str(v, user)
    v.push(0 as u8)
    if domain:
        _put_str(v, host)
        v.push(0 as u8)
    end
    ret v
end

@en "Decode4Request"
@fa "رمزگشایی درخواست ساکس۴"
pub func Decode4Request(data: Vector<u8>, out &: Request): int:
    n := data.len()
    if n < 9: ret 0 end
    if _b(data, 0) != 4: ret 0 - 1 end
    mut pos := 8
    until pos < n and _b(data, pos) != 0:
        pos++
        if pos - 8 > 255: ret 0 - 1 end
    end
    if pos >= n: ret 0 end
    user := _bytes_str(data, 8, pos - 8)
    pos++
    port := _b(data, 2) * 256 + _b(data, 3)
    mut host := ""
    mut kind := AtypIPv4
    if _b(data, 4) == 0 and _b(data, 5) == 0 and _b(data, 6) == 0 and _b(data, 7) != 0:
        start := pos
        until pos < n and _b(data, pos) != 0:
            pos++
            if pos - start > 255: ret 0 - 1 end
        end
        if pos >= n: ret 0 end
        if pos == start: ret 0 - 1 end
        host = _bytes_str(data, start, pos - start)
        kind = AtypDomain
        pos++
    else:
        host = FormatIPv4(data, 4)
    end
    out.version = 4
    out.cmd = _b(data, 1)
    out.user = user
    out.addr = Address { kind = kind, host = host, port = port }
    ret pos
end

@en "Encode4Reply"
@fa "رمزگذاری پاسخ ساکس۴"
pub func Encode4Reply(code: int, host: str, port: int): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    v.push(0 as u8)
    v.push(code as u8)
    _put16(v, port)
    mut ip := Vector {} as Vector<u8>
    defer ip.free()
    if not ParseIPv4(host, ip):
        repeat 4:
            ip.push(0 as u8)
        end
    end
    repeat 4 in i:
        v.push(ip.get(i))
    end
    ret v
end

@en "Decode4Reply"
@fa "رمزگشایی پاسخ ساکس۴"
pub func Decode4Reply(data: Vector<u8>, out &: Reply): bool:
    if data.len() < 8: ret false end
    if _b(data, 0) != 0: ret false end
    out.version = 4
    out.code = _b(data, 1)
    out.addr = Address { kind = AtypIPv4, host = FormatIPv4(data, 4), port = _b(data, 2) * 256 + _b(data, 3) }
    ret true
end

@en "ReplyText"
@fa "متن پاسخ"
pub func ReplyText(code: int): str:
    switch code:
        0: ret "succeeded" end
        1: ret "general SOCKS server failure" end
        2: ret "connection not allowed by ruleset" end
        3: ret "network unreachable" end
        4: ret "host unreachable" end
        5: ret "connection refused" end
        6: ret "TTL expired" end
        7: ret "command not supported" end
        8: ret "address type not supported" end
        90: ret "request granted" end
        91: ret "request rejected or failed" end
        92: ret "request rejected, identd unreachable" end
        93: ret "request rejected, identd mismatch" end
    end
    ret "unknown reply code"
end

@en "ToHex"
@fa "به هگز"
pub func ToHex(v: Vector<u8>): str:
    mut out := ""
    repeat v.len() in i:
        b := _b(v, i)
        if b < 16: out += "0" end
        out += _hex(b)
    end
    ret out
end
