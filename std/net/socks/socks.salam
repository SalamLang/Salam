@en "net/socks"
@fa "ساکس"
package socks

import mem
import str

@en "VerSocks5"
@fa "نسخه ساکس۵"
pub const VerSocks5 := 5

@en "VerSocks4"
@fa "نسخه ساکس۴"
pub const VerSocks4 := 4

@en "AuthNone"
@fa "بدون احراز هویت"
pub const AuthNone := 0

