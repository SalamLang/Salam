@en "net/tcp"
@fa "تی سی پی شبکه"
@ar "بروتوکول TCP للشبکة"
package tcp

import net.internal.rawsock
import conv
import tls

// Reliable TCP client/server, migrated from (and replacing) std/tcp -
// same Server/Conn/Dial/Accept/Read/Write/Close shape callers already
// know, now built on net/internal/rawsock instead of std/net directly,
// plus: read/write deadlines, keep-alive, TCP_NODELAY, and a simple
// idle-timeout connection pool for clients that repeatedly dial the same
// host:port (HTTP keep-alive, ...).

@en "Server"
@fa "سرور"
@ar "خادم"
pub struct Server:
    pub fd: i64 = 0 - 1
    pub port: int = 0
end

@en "Conn"
@fa "اتصال شبکه"
@ar "اتصال"
pub struct Conn:
    pub fd: i64 = 0 - 1
end

// A minimal idle-connection pool keyed by "host:port" - Get() reuses a
// previously Put() connection to the same address if one is idle and
// still within its TTL, otherwise dials a fresh one. Sized for a single
// caller (an HTTP client, say) reusing a handful of upstream hosts, not
// for a high-fanout connection-per-request server; there is no
// background sweep thread, only a check-on-Get expiry.
@en "PoolEntry"
@fa "مدخل استخر"
@ar "مدخل تجمیع"
pub struct PoolEntry:
    pub key: str = ""
    pub conn: Conn = Conn {}
    pub put_at_ms: i64 = 0
end

@en "PoolEntries"
@fa "مدخل‌های استخر"
@ar "مداخل التجمیع"
pub struct PoolEntries:
    pub items: Vector<PoolEntry> = Vector {}
end

@en "Pool"
@fa "استخر اتصال"
@ar "تجمیع الاتصالات"
pub struct Pool:
    pub entries: PoolEntries = PoolEntries {}
    pub idle_ttl_ms: i64 = 30000
end

func _sock(fd: i64): rawsock.Socket:
    ret rawsock.FromFd(fd)
end

func _pool_key(host: str, port: int): str:
    ret host + ":" + conv.FormatInt(port as i64)
end

@en "Bind"
@fa "پیوند"
@ar "ربط"
pub func Bind(port: int): Server:
    ret Server { fd = rawsock.Listen(port).fd, port = port }
end

@en "Ok"
@fa "معتبر"
@ar "صالح"
pub func Ok(srv: Server): bool:
    ret srv.fd >= 0
end

// The port a server actually ended up bound to. Always equal to the port
// passed to Bind(), except after Bind(0), where it's the ephemeral port
// the OS picked - see rawsock.LocalPort for why binding to 0 and reading
// the real port back this way is worth doing over a hardcoded port
// number for a short-lived local server (test code, an ad hoc dev
// server): it can never collide with another process or a host's
// dynamic port reservations.
@en "Port"
@fa "درگاه"
@ar "منفذ"
pub func Port(srv: Server): int:
    ret rawsock.LocalPort(_sock(srv.fd))
end

@en "Accept"
@fa "پذیرش"
@ar "قبول"
pub func Accept(srv: Server): Conn:
    ret Conn { fd = rawsock.Accept(_sock(srv.fd)).fd }
end

@en "CloseServer"
@fa "بستن سرور"
@ar "إغلاق الخادم"
pub func CloseServer(srv: Server):
    rawsock.Close(_sock(srv.fd))
end

@en "ConnOk"
@fa "اتصال معتبر"
@ar "اتصال صالح"
pub func ConnOk(c: Conn): bool:
    ret c.fd >= 0
end

@en "Read"
@fa "خواندن"
@ar "قراءة"
pub func Read(c: Conn, max: int): str:
    ret rawsock.Recv(_sock(c.fd), max)
end

@en "Write"
@fa "نوشتن"
@ar "کتابة"
pub func Write(c: Conn, data: str): int:
    ret rawsock.Send(_sock(c.fd), data)
end

// Binary-safe read/write for protocols where a `str`'s NUL-terminated
// semantics would silently truncate the message (SOCKS5 - a port whose
// low byte is 0 - HTTP/2 framing, WebSocket binary frames, TLS records).
@en "ReadBytes"
@fa "خواندن بایت"
@ar "قراءة بایتات"
pub func ReadBytes(c: Conn, buf: void*, max: int): int:
    ret rawsock.RecvBytes(_sock(c.fd), buf, max)
end

@en "WriteBytes"
@fa "نوشتن بایت"
@ar "کتابة بایتات"
pub func WriteBytes(c: Conn, ptr: void*, n: int): int:
    ret rawsock.SendBytes(_sock(c.fd), ptr, n)
end

@en "Close"
@fa "بستن"
@ar "إغلاق"
pub func Close(c: Conn):
    rawsock.Close(_sock(c.fd))
end

@en "Dial"
@fa "شماره گیری"
@ar "اتصال هاتفی"
pub func Dial(host: str, port: int): Conn:
    ret Conn { fd = rawsock.Connect(host, port).fd }
end

// tcp.Conn's Read/Write/Close take their argument by value, which is fine
// for a bare fd but would silently lose a std/tls connection's protocol
// state (record sequence numbers, buffered plaintext) between calls if
// wrapped the same way. So this returns a std/tls Conn directly instead
// of a tcp.Conn - use tls.Read/tls.Write/tls.Close/tls.ConnOk on the
// result (net/internal/nettls re-exports the same operations under the
// net/internal layer if you'd rather not import std/tls directly).
@en "DialTLS"
@fa "شماره گیری امن"
@ar "اتصال هاتفی آمن"
pub func DialTLS(host: str, port: int): tls.Conn:
    cfg := tls.NewConfig(host)
    ret tls.Dial(host, port, cfg)
end

// Upgrades an already-connected plain Conn to TLS in place (STARTTLS-
// style: SMTP/IMAP send a plaintext greeting and negotiate the upgrade
// before any TLS byte is sent). `cfg.server_name` must be set. The
// original Conn's fd is consumed - do not use it after this call
// succeeds or fails; use the returned tls.Conn (or its .err) instead.
@en "UpgradeTLS"
@fa "ارتقا به تی ال اس"
@ar "الترقیة إلی TLS"
pub func UpgradeTLS(c: Conn, cfg: tls.Config): tls.Conn:
    ret tls.WrapClient(c.fd, cfg)
end

@en "ConnFromFd"
@fa "اتصال از توصیف‌گر"
@ar "اتصال من واصف"
pub func ConnFromFd(fd: i64): Conn:
    ret Conn { fd = fd }
end

@en "WriteHTTP"
@fa "نوشتن اچ تی تی پی"
@ar "کتابة اتش تی تی بی"
pub func WriteHTTP(c: Conn, status_line: str, content_type: str, body: str):
    blen := conv.FormatInt(len(body) as i64)
    resp := "HTTP/1.1 " + status_line + "\r\n" + "Content-Type: " + content_type + "\r\n" + "Content-Length: " + blen + "\r\n" + "Connection: close\r\n\r\n" + body
    rawsock.Send(_sock(c.fd), resp)
end

// ------------------------------------------------------------ tuning API

@en "SetReadDeadline"
@fa "تنظیم مهلت خواندن"
@ar "تعیین مهلة القراءة"
pub func SetReadDeadline(c: Conn, millis: int):
    rawsock.SetTimeout(_sock(c.fd), millis)
end

@en "SetWriteDeadline"
@fa "تنظیم مهلت نوشتن"
@ar "تعیین مهلة الکتابة"
pub func SetWriteDeadline(c: Conn, millis: int):
    rawsock.SetTimeout(_sock(c.fd), millis)
end

@en "SetDeadline"
@fa "تنظیم مهلت"
@ar "تعیین المهلة"
pub func SetDeadline(c: Conn, millis: int):
    rawsock.SetTimeout(_sock(c.fd), millis)
end

@en "SetKeepAlive"
@fa "تنظیم زنده‌نگه‌داری"
@ar "تفعیل الحفاظ علی الاتصال"
pub func SetKeepAlive(c: Conn, enable: bool):
    rawsock.SetKeepAlive(_sock(c.fd), enable)
end

@en "SetNoDelay"
@fa "غیرفعال‌سازی نگل"
@ar "تعطیل خوارزمیة ناغل"
pub func SetNoDelay(c: Conn, enable: bool):
    rawsock.SetNoDelay(_sock(c.fd), enable)
end

// -------------------------------------------------------- connection pool

@en "NewPool"
@fa "استخر جدید"
@ar "تجمیع جدید"
pub func NewPool(): Pool:
    ret Pool { entries = PoolEntries {}, idle_ttl_ms = 30000 }
end

// Reuses an idle pooled connection to host:port if one exists (and is
// still ConnOk), otherwise dials a fresh one. `now_ms` is caller-supplied
// (e.g. from std/time) since this package has no time dependency of its
// own.
@en "Get"
@fa "دریافت اتصال"
@ar "الحصول علی اتصال"
pub func Get(p &: Pool, host: str, port: int, now_ms: i64): Conn:
    key := _pool_key(host, port)
    n := p.entries.items.len()
    mut i := 0
    until i < n:
        e := p.entries.items.get(i)[0]
        if e.key == key:
            p.entries.items.remove_at(i)
            if ConnOk(e.conn) && (now_ms - e.put_at_ms) < p.idle_ttl_ms:
                ret e.conn
            end
            Close(e.conn)
            ret Dial(host, port)
        end
        i += 1
    end
    ret Dial(host, port)
end

@en "Put"
@fa "بازگرداندن اتصال"
@ar "إعادة الاتصال"
pub func Put(p &: Pool, host: str, port: int, c: Conn, now_ms: i64):
    if !ConnOk(c):
        ret
    end
    entry := PoolEntry { key = _pool_key(host, port), conn = c, put_at_ms = now_ms }
    p.entries.items.push(entry)
end

@en "PoolLen"
@fa "تعداد استخر"
@ar "عدد التجمیع"
pub func PoolLen(p: Pool): int:
    ret p.entries.items.len()
end
