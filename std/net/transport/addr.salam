package transport

import mem
import str

@en "AddrIPv4"
@fa "نشانی آی پی چهار"
pub const AddrIPv4 := 1

@en "AddrDomain"
@fa "نشانی دامنه"
pub const AddrDomain := 2

@en "AddrIPv6"
@fa "نشانی آی پی شش"
pub const AddrIPv6 := 3

@en "Addr"
@fa "نشانی"
pub struct Addr:
    @en "kind"
    @fa "نوع"
    pub kind: int = 2
    @en "host"
    @fa "میزبان"
    pub host: str = ""
    @en "port"
    @fa "درگاه"
    pub port: int = 0
end

func _parse_ipv4(s: str, out: u8*): bool:
    sp := s as u8*
    n := s.len()
    mut part := 0
    mut digits := 0
    mut idx := 0
    repeat n + 1 in i:
        mut ch := 46
        if i < n:
            ch = sp[i] as int
        end
        if ch == 46:
            if digits == 0 or idx > 3 or part > 255:
                ret false
            end
            out[idx] = part as u8
            idx++
            part = 0
            digits = 0
        else ch >= 48 and ch <= 57:
            part = part * 10 + (ch - 48)
            digits++
            if digits > 3:
                ret false
            end
        else:
            ret false
        end
    end
    ret idx == 4
end

func _hexdigit(c: int): int:
    if c >= 48 and c <= 57: ret c - 48 end
    if c >= 97 and c <= 102: ret c - 87 end
    if c >= 65 and c <= 70: ret c - 55 end
    ret 0 - 1
end

func _parse_groups(s: str, out: int*, start: int): int:
    n := s.len()
    if n == 0:
        ret 0
    end
    sp := s as u8*
    mut count := 0
    mut val := 0
    mut digits := 0
    repeat n + 1 in i:
        mut ch := 58
        if i < n:
            ch = sp[i] as int
        end
        if ch == 58:
            if digits == 0 or digits > 4 or start + count >= 8:
                ret 0 - 1
            end
            out[start + count] = val
            count++
            val = 0
            digits = 0
        else:
            h := _hexdigit(ch)
            if h < 0:
                ret 0 - 1
            end
            val = val * 16 + h
            digits++
        end
    end
    ret count
end

func _parse_ipv6(s: str, out: u8*): bool:
    groups := mem.AllocateZeroed(64 as u64) as int*
    defer mem.Free(groups as void*)
    dc := s.find("::")
    if dc < 0:
        if _parse_groups(s, groups, 0) != 8:
            ret false
        end
    else:
        left := s.substr(0, dc)
        right := s.substr(dc + 2, s.len() - dc - 2)
        if right.find("::") >= 0:
            ret false
        end
        nl := _parse_groups(left, groups, 0)
        if nl < 0:
            ret false
        end
        rg := mem.AllocateZeroed(64 as u64) as int*
        defer mem.Free(rg as void*)
        nr := _parse_groups(right, rg, 0)
        if nr < 0 or nl + nr > 7:
            ret false
        end
        repeat nr in i:
            groups[8 - nr + i] = rg[i]
        end
    end
    repeat 8 in i:
        out[2 * i] = ((groups[i] >> 8) & 255) as u8
        out[2 * i + 1] = (groups[i] & 255) as u8
    end
    ret true
end

@en "DetectKind"
@fa "تشخیص نوع نشانی"
pub func DetectKind(host: str): int:
    tmp := mem.AllocateZeroed(16 as u64) as u8*
    defer mem.Free(tmp as void*)
    if _parse_ipv4(host, tmp):
        ret AddrIPv4
    end
    if host.find(":") >= 0 and _parse_ipv6(host, tmp):
        ret AddrIPv6
    end
    ret AddrDomain
end

@en "NewAddr"
@fa "نشانی جدید"
pub func NewAddr(host: str, port: int): Addr:
    mut h := host
    if h.len() > 2 and h.substr(0, 1) == "[":
        h = h.substr(1, h.len() - 2)
    end
    ret Addr { kind = DetectKind(h), host = h, port = port }
end

@en "PutAddr"
@fa "نوشتن نشانی"
pub func PutAddr(b &: Bytes, a: Addr): bool:
    Put16(b, a.port)
    tmp := mem.AllocateZeroed(16 as u64) as u8*
    defer mem.Free(tmp as void*)
    if a.kind == AddrIPv4:
        if not _parse_ipv4(a.host, tmp): ret false end
        Put8(b, 1)
        PutRaw(b, tmp as void*, 4)
    else a.kind == AddrIPv6:
        if not _parse_ipv6(a.host, tmp): ret false end
        Put8(b, 3)
        PutRaw(b, tmp as void*, 16)
    else:
        hl := a.host.len()
        if hl == 0 or hl > 255: ret false end
        Put8(b, 2)
        Put8(b, hl)
        PutStr(b, a.host)
    end
    ret true
end

@en "FormatIPv6"
@fa "قالب آی پی شش"
pub func FormatIPv6(p: u8*): str:
    mut best := 0 - 1
    mut best_len := 0
    mut cur := 0 - 1
    mut cur_len := 0
    repeat 8 in i:
        z := (p[2 * i] as int) == 0 and (p[2 * i + 1] as int) == 0
        if z:
            if cur < 0:
                cur = i
                cur_len = 0
            end
            cur_len++
            if cur_len > best_len:
                best = cur
                best_len = cur_len
            end
        else:
            cur = 0 - 1
            cur_len = 0
        end
    end
    if best_len < 2:
        best = 0 - 1
    end
    mut out := ""
    mut i := 0
    until i < 8:
        if i == best:
            out += "::"
            i += best_len
        else:
            if out.len() > 0 and out.substr(out.len() - 1, 1) != ":":
                out += ":"
            end
            v := (p[2 * i] as int) * 256 + (p[2 * i + 1] as int)
            mut g := ""
            mut started := false
            repeat 4 in k:
                d := (v >> (12 - 4 * k)) & 15
                if d != 0 or started or k == 3:
                    started = true
                    g += "0123456789abcdef".substr(d, 1)
                end
            end
            out += g
            i++
        end
    end
    ret out
end

@en "ReadAddr"
@fa "خواندن نشانی"
pub func ReadAddr(b: Bytes, off: int, a &: Addr): int:
    if off + 4 > b.len: ret 0 - 1 end
    a.port = Peek16(b, off)
    k := At(b, off + 2)
    mut p := off + 3
    if k == 1:
        if p + 4 > b.len: ret 0 - 1 end
        a.kind = 1
        a.host = str.FromInt(At(b, p) as i64) + "." + str.FromInt(At(b, p + 1) as i64) + "." + str.FromInt(At(b, p + 2) as i64) + "." + str.FromInt(At(b, p + 3) as i64)
        ret p + 4
    else k == 3:
        if p + 16 > b.len: ret 0 - 1 end
        a.kind = 3
        a.host = FormatIPv6(((b.p as i64) + (p as i64)) as u8*)
        ret p + 16
    else k == 2:
        hl := At(b, p)
        p++
        if hl == 0 or p + hl > b.len: ret 0 - 1 end
        a.kind = 2
        raw := mem.Allocate((hl + 1) as u64)
        mem.Copy(raw, ((b.p as i64) + (p as i64)) as void*, hl as u64)
        rp := raw as u8*
        rp[hl] = 0 as u8
        a.host = raw as str
        ret p + hl
    end
    ret 0 - 1
end

@en "ParseUUID"
@fa "تجزیه یو یو آی دی"
pub func ParseUUID(s: str): Bytes:
    mut b := NewBytes(16)
    sp := s as u8*
    mut hi := 0 - 1
    repeat s.len() in i:
        ch := sp[i] as int
        if ch == 45:
            continue
        end
        h := _hexdigit(ch)
        if h < 0:
            b.bad = true
            ret b
        end
        if hi < 0:
            hi = h
        else:
            Put8(b, hi * 16 + h)
            hi = 0 - 1
        end
    end
    if hi >= 0 or b.len != 16:
        b.bad = true
    end
    ret b
end

@en "FormatUUID"
@fa "قالب یو یو آی دی"
pub func FormatUUID(b: Bytes): str:
    h := ToHex(b)
    if h.len() != 32:
        ret h
    end
    ret h.substr(0, 8) + "-" + h.substr(8, 4) + "-" + h.substr(12, 4) + "-" + h.substr(16, 4) + "-" + h.substr(20, 12)
end
