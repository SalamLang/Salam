@en "Listener"
@fa "شنونده"
pub struct Listener:
    @en "server"
    @fa "سرور"
    pub server: tcp.Server = tcp.Server {}
    @en "settings"
    @fa "تنظیمات"
    pub settings: Settings = Settings {}
    @en "tls_cfg"
    @fa "پیکربندی تی ال اس"
    pub tls_cfg: tls.ServerConfig = tls.ServerConfig {}
    @en "ready"
    @fa "آماده"
    pub ready: chan.Chan<Conn> = chan.Chan {} as chan.Chan<Conn>
