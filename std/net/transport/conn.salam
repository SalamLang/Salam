    @fa "پرچم ها"
    pub flags: i64* = null
    @en "slots"
    @fa "جایگاه ها"
    pub slots: sync.Semaphore = sync.Semaphore {}
    @en "sources"
    @fa "مبداها"
    pub sources: tunnel.SourceTable = tunnel.SourceTable {}
end

func _ub(p: u8*, i: int): int:
    ret p[i] as int
end

func _raw_read(c &: Conn, buf: void*, max: int): int:
    if c.kind == KindStream:
        ret c.up.ReadBytes(buf, max)
    end
    if c.kind == KindTLS:
        ret tls.ReadBytes(c.tls, buf, max)
    end
    ret tcp.ReadBytes(c.tcp, buf, max)
end

func _raw_write_once(c &: Conn, buf: void*, n: int): int:
    if c.kind == KindStream:
        ret c.up.WriteBytes(buf, n)
    end
    if c.kind == KindTLS:
        ret tls.WriteBytes(c.tls, buf, n)
    end
    ret tcp.WriteBytes(c.tcp, buf, n)
end

func _raw_write(c &: Conn, buf: void*, n: int): bool:
    mut done := 0
    until done < n:
        sent := _raw_write_once(c, ((buf as i64) + (done as i64)) as void*, n - done)
        if sent <= 0:
            ret false
        end
        done += sent
    end
    ret true
end

func _raw_read_full(c &: Conn, buf: void*, n: int): bool:
    mut got := 0
    until got < n:
        r := _raw_read(c, ((buf as i64) + (got as i64)) as void*, n - got)
        if r <= 0:
            ret false
        end
        got += r
    end
    ret true
end

func _read_headers(c &: Conn): str:
    mut b := NewBytes(512)
    defer FreeBytes(b)
    one := mem.Allocate(1 as u64) as u8*
    defer mem.Free(one as void*)
    until b.len < 16384:
        r := _raw_read(c, one as void*, 1)
        if r <= 0:
            ret ""
        end
        Put8(b, one[0] as int)
        if b.len >= 4 and At(b, b.len - 1) == 10 and At(b, b.len - 2) == 13 and At(b, b.len - 3) == 10 and At(b, b.len - 4) == 13:
            Put8(b, 0)
            ret str.Clone(b.p as str)
        end
    end
    ret ""
end

func _header(h: str, name: str): str:
    lower := str.Lower(h)
    idx := str.Find(lower, "\r\n" + name + ":")
    if idx < 0:
        ret ""
    end
    start := idx + 2 + name.len() + 1
    mut e := str.IndexFrom(h, "\r", start)
    if e < 0:
        e = h.len()
    end
    ret str.Trim(h.substr(start, e - start))
end

func _request_path(h: str): str:
    sp := str.Find(h, " ")
    if sp < 0:
        ret ""
    end
    e := str.IndexFrom(h, " ", sp + 1)
    if e < 0:
        ret ""
    end
    mut p := h.substr(sp + 1, e - sp - 1)
    q := str.Find(p, "?")
    if q >= 0:
        p = p.substr(0, q)
    end
    ret p
end

func _b64url_encode(p: void*, n: int): str:
    s := encoding.Base64EncodeBytes(p, n)
    mut out := ""
    sp := s as u8*
    repeat s.len() in i:
        ch := sp[i] as int
        if ch == 43:
            out += "-"
        else ch == 47:
            out += "_"
        else ch != 61:
            out += s.substr(i, 1)
        end
    end
    ret out
end

func _b64val(ch: int): int:
    if ch >= 65 and ch <= 90: ret ch - 65 end
    if ch >= 97 and ch <= 122: ret ch - 71 end
    if ch >= 48 and ch <= 57: ret ch + 4 end
    if ch == 45 or ch == 43: ret 62 end
    if ch == 95 or ch == 47: ret 63 end
    ret 0 - 1
end

func _b64url_decode(s: str): Bytes:
    mut out := NewBytes(s.len())
    sp := s as u8*
    mut acc := 0
    mut bits := 0
    repeat s.len() in i:
        v := _b64val(sp[i] as int)
        if v < 0:
            continue
        end
        acc = (acc << 6) | v
        bits += 6
        if bits >= 8:
            bits -= 8
            Put8(out, (acc >> bits) & 255)
            acc &= ((1 << bits) - 1)
        end
    end
    ret out
end

func _tls_config(host: str, s: Settings): tls.Config:
    mut cfg := tls.NewConfig(host)
    if s.sni.len() > 0:
        cfg.server_name = s.sni
    end
    cfg.insecure_skip_verify = s.allow_insecure
    cfg.alpn = s.alpn
    if s.network == "grpc" and s.alpn.len() == 0:
        cfg.alpn = "h2"
    end
    cfg.ca_file = s.ca_file
    if s.fragment:
        cfg.frag_tcp = s.fragment_mode != "tls"
        cfg.frag_tls = s.fragment_mode == "tls" or s.fragment_mode == "both"
        cfg.frag_sni = s.fragment_sni
        cfg.frag_min = s.fragment_min
        cfg.frag_max = s.fragment_max
        cfg.frag_delay_ms = s.fragment_delay_ms
        cfg.frag_writes = s.fragment_writes
    end
    ret cfg
end

func _ws_fill(client: bool, buf &: Bytes, op: int, p: void*, n: int): bool:
    ResetBytes(buf)
    Reserve(buf, n + 16)
    if buf.bad:
        ret false
    end
    Put8(buf, 0x80 | op)
    mut mb := 0
    if client:
        mb = 0x80
    end
    if n < 126:
        Put8(buf, mb | n)
    else n < 65536:
        Put8(buf, mb | 126)
        Put16(buf, n)
    else:
        Put8(buf, mb | 127)
        Put64(buf, n as u64)
    end
    if client:
        crypto.RandomBytes(((buf.p as i64) + (buf.len as i64)) as void*, 4)
        kp := ((buf.p as i64) + (buf.len as i64)) as u8*
        k0 := kp[0] as int
        k1 := kp[1] as int
        k2 := kp[2] as int
        k3 := kp[3] as int
        buf.len += 4
        dst := ((buf.p as i64) + (buf.len as i64)) as u8*
        src := p as u8*
        mut i := 0
        until i + 4 <= n:
            dst[i] = (src[i] as int ^ k0) as u8
            dst[i + 1] = (src[i + 1] as int ^ k1) as u8
            dst[i + 2] = (src[i + 2] as int ^ k2) as u8
            dst[i + 3] = (src[i + 3] as int ^ k3) as u8
            i += 4
        end
        until i < n:
            mut k := k0
            if (i & 3) == 1:
                k = k1
            else (i & 3) == 2:
                k = k2
            else (i & 3) == 3:
                k = k3
            end
            dst[i] = (src[i] as int ^ k) as u8
            i++
        end
        buf.len += n
    else:
        PutRaw(buf, p, n)
    end
    ret not buf.bad
end

func _ws_send(c &: Conn, op: int, p: void*, n: int): bool:
    if op >= 8:
        mut ctl := NewBytes(n + 16)
        defer FreeBytes(ctl)
        if not _ws_fill(c.client, ctl, op, p, n):
            ret false
        end
        ret _raw_write(c, ctl.p, ctl.len)
    end
    if c.wbuf.p == null:
        c.wbuf = NewBytes(n + 16)
    end
    if not _ws_fill(c.client, c.wbuf, op, p, n):
        ret false
    end
    ok := _raw_write(c, c.wbuf.p, c.wbuf.len)
    if c.wbuf.cap > 262144:
        FreeBytes(c.wbuf)
    end
    ret ok
end

func _ws_next_frame(c &: Conn): int:
    hdr := mem.Allocate(8 as u64) as u8*
    defer mem.Free(hdr as void*)
    until true:
        if not _raw_read_full(c, hdr as void*, 2):
            ret 0
        end
        op := _ub(hdr, 0) & 15
        masked := (_ub(hdr, 1) & 0x80) != 0
        mut ln := _ub(hdr, 1) & 0x7F
        if ln == 126:
            if not _raw_read_full(c, hdr as void*, 2):
                ret 0
            end
            ln = _ub(hdr, 0) * 256 + _ub(hdr, 1)
        else ln == 127:
            if not _raw_read_full(c, hdr as void*, 8):
                ret 0
            end
            mut v := 0 as i64
            repeat 8 in i:
                v = (v << (8 as i64)) | (_ub(hdr, i) as i64)
            end
            if v > (1073741824 as i64):
                ret 0
            end
            ln = v as int
        end
        c.fr_masked = masked
        c.fr_pos = 0
        if masked:
            mk := mem.Allocate(4 as u64) as u8*
            if not _raw_read_full(c, mk as void*, 4):
                mem.Free(mk as void*)
                ret 0
            end
            c.fr_mask = ((_ub(mk, 0) as i64) << (24 as i64)) | ((_ub(mk, 1) as i64) << (16 as i64)) | ((_ub(mk, 2) as i64) << (8 as i64)) | (_ub(mk, 3) as i64)
            mem.Free(mk as void*)
        end
        if op == 8:
            ret 0
        end
        if op == 9 or op == 10:
            mut pl := NewBytes(ln + 1)
            pl.len = ln
            if ln > 0 and not _raw_read_full(c, pl.p, ln):
                FreeBytes(pl)
                ret 0
            end
            if op == 9:
                _ws_send(c, 10, pl.p, pl.len)
            end
            FreeBytes(pl)
            continue
        end
        if ln == 0:
            continue
        end
        c.fr_left = ln
        ret ln
    end
end

func _ws_unmask(c &: Conn, p: u8*, n: int):
    if not c.fr_masked:
        ret
    end
    m0 := ((c.fr_mask >> (24 as i64)) & (255 as i64)) as int
    m1 := ((c.fr_mask >> (16 as i64)) & (255 as i64)) as int
    m2 := ((c.fr_mask >> (8 as i64)) & (255 as i64)) as int
    m3 := (c.fr_mask & (255 as i64)) as int
    mut i := 0
    until ((c.fr_pos + i) & 3) != 0 and i < n:
        mut k := m0
        q := (c.fr_pos + i) & 3
        if q == 1:
            k = m1
        else q == 2:
            k = m2
        else q == 3:
            k = m3
        end
        p[i] = (p[i] as int ^ k) as u8
        i++
    end
    until i + 4 <= n:
        p[i] = (p[i] as int ^ m0) as u8
        p[i + 1] = (p[i + 1] as int ^ m1) as u8
        p[i + 2] = (p[i + 2] as int ^ m2) as u8
        p[i + 3] = (p[i + 3] as int ^ m3) as u8
        i += 4
    end
    until i < n:
        mut k := m0
        q := (c.fr_pos + i) & 3
        if q == 1:
            k = m1
        else q == 2:
            k = m2
        else q == 3:
            k = m3
        end
        p[i] = (p[i] as int ^ k) as u8
        i++
    end
    c.fr_pos += n
end

func _norm_headers(h: str): str:
    if h.len() == 0:
        ret ""
    end
    if str.EndsWith(h, "\r\n"):
        ret h
    end
    ret h + "\r\n"
end

func _client_upgrade(c &: Conn, host: str, s: Settings, early: Bytes): bool:
    mut hostname := host
    if s.host.len() > 0:
        hostname = s.host
    end
    mut path := s.path
    if path.len() == 0:
        path = "/"
    end
    mut req := "GET " + path + " HTTP/1.1\r\nHost: " + hostname + "\r\nUser-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36\r\n"
    mut key := ""
    if s.network == "ws":
        mut kb := NewBytes(16)
        defer FreeBytes(kb)
        crypto.RandomBytes(kb.p, 16)
        kb.len = 16
        key = encoding.Base64EncodeBytes(kb.p, 16)
        req += "Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\n"
        if early.len > 0 and s.early_data > 0:
            req += "Sec-WebSocket-Protocol: " + _b64url_encode(early.p, early.len) + "\r\n"
        end
    else:
        req += "Connection: Upgrade\r\nUpgrade: websocket\r\n"
    end
    req += _norm_headers(s.headers) + "\r\n"
    if not _raw_write(c, req as void*, req.len()):
        c.err = "could not send the upgrade request"
        ret false
    end
    h := _read_headers(c)
    if h.len() == 0:
        c.err = "no upgrade response"
        ret false
    end
    if not str.Contains(h, " 101 "):
        c.err = "upgrade refused: " + h.substr(0, 20)
        ret false
    end
    if s.network == "ws":
        if not str.Contains(h, websocket.AcceptKey(key)):
            c.err = "bad Sec-WebSocket-Accept"
            ret false
        end
        c.ws = true
    end
    ret true
end

func _server_reject(c &: Conn, status: str):
    body := "<html><head><title>" + status + "</title></head><body><center><h1>" + status + "</h1></center><hr><center>nginx</center></body></html>"
    resp := "HTTP/1.1 " + status + "\r\nServer: nginx\r\nContent-Type: text/html\r\nConnection: close\r\nContent-Length: " + str.FromInt(body.len() as i64) + "\r\n\r\n" + body
    _raw_write(c, resp as void*, resp.len())
end

func _stream_read(c &: Conn, buf: void*, max: int): int:
    ret Read(c, buf, max)
end

func _stream_write(c &: Conn, p: void*, n: int): bool:
    ret Write(c, p, n)
end

func _stream_timeout(c &: Conn, ms: int):
    SetReadTimeout(c, ms)
end

func _stream_close(c &: Conn):
    Close(c)
end

func _apply_idle(c &: Conn, s: Settings):
    if s.read_timeout_ms > 0:
        tcp.SetReadDeadline(c.tcp, s.read_timeout_ms)
    end
    if s.write_timeout_ms > 0:
        tcp.SetWriteDeadline(c.tcp, s.write_timeout_ms)
    end
end

func _finish_accept(l: Listener, tc: tcp.Conn): Conn:
    mut c := Conn {}
    tcp.SetNoDelay(tc, true)
    c.tcp = tc
    if l.settings.security == "reality":
        acc := reality.Accept(tc.fd, l.settings.reality_server)
        if not acc.ok:
            c.err = "reality: " + acc.err
            ret c
        end
        c.kind = KindTLS
        c.tls = acc.conn
    else l.settings.tls:
        c.kind = KindTLS
        c.tls = tls.WrapServer(tc.fd, l.tls_cfg)
        if not tls.ConnOk(c.tls):
            c.err = "tls: " + tls.ConnError(c.tls)
            tcp.Close(tc)
            ret c
        end
    end
    c.open = true
    ret c
end

func _hs_release(a: _Hs*):
    me := a[0]
    sync.Lock(me.mu)
    me.st[1]--
    left := me.st[1]
    sync.Unlock(me.mu)
    if left <= (0 as i64):
        sync.Destroy(me.mu)
        sync.DestroyCondVar(me.cv)
        mem.Free(me.st as void*)
        mem.Free(a as void*)
    end
end

func _hs_work(a: _Hs*):
    me := a[0]
    mut c := _finish_accept(me.l, tcp.ConnFromFd(me.fd))
    c.remote = me.host
    if c.open:
        if not Upgrade(c, me.l.settings):
            c.open = false
        end
    end
    sync.Lock(me.mu)
    mut mine := false
    if me.st[0] == 0 as i64:
        me.st[0] = 1 as i64
        mine = true
    end
    sync.Signal(me.cv)
    sync.Unlock(me.mu)
    if not mine:
        if c.open:
            Close(c)
        end
        c.open = false
        c.err = "handshake timeout"
    end
    tunnel.SourceLeave(me.l.sources, me.host)
    if c.open and me.l.settings.network == "grpc":
        _grpc_serve(c, me.l)
    else:
        if c.open:
            _apply_idle(c, me.l.settings)
        end
        if not chan.TrySend(me.l.ready, c) and c.open:
            Close(c)
        end
    end
    sync.Release(me.l.slots)
    _hs_release(a)
end

func _hs_watch(a: _Hs*):
    me := a[0]
    mut limit := me.l.settings.handshake_timeout_ms
    if limit <= 0:
        limit = 10000
    end
    deadline := sync.NowMs() + (limit as i64)
    sync.Lock(me.mu)
    until me.st[0] == 0 as i64:
        left := deadline - sync.NowMs()
        if left <= (0 as i64):
            break
        end
        sync.WaitCondTimeout(me.cv, me.mu, left)
    end
    mut late := false
    if me.st[0] == 0 as i64:
        me.st[0] = 2 as i64
        late = true
    end
    sync.Unlock(me.mu)
    if late:
        rawsock.Shutdown(rawsock.FromFd(me.fd))
    end
    _hs_release(a)
end

func _acceptor(a: _Hs*):
    me := a[0]
    l := me.l
    until l.flags[1] == 0 as i64:
        tc := tcp.Accept(l.server)
        if not tcp.ConnOk(tc):
            if l.flags[1] != 0 as i64:
                break
            end
            sync.SleepMs(5)
            continue
        end
        host := rawsock.PeerHost(rawsock.FromFd(tc.fd))
        if not tunnel.SourceEnter(l.sources, host, l.settings.max_per_source):
            tcp.Close(tc)
            continue
        end
        if not sync.TryAcquire(l.slots):
            tunnel.SourceLeave(l.sources, host)
            tcp.Close(tc)
            continue
        end
        h := mem.AllocateZeroed(sizeof(_Hs) as u64) as _Hs*
        st := mem.AllocateZeroed(16 as u64) as i64*
        st[1] = 2 as i64
        h[0] = _Hs { fd = tc.fd, l = l, st = st, mu = sync.NewMutex(), cv = sync.NewCondVar(), host = host }
        _w := spawn(_hs_work, h)
        _t := spawn(_hs_watch, h)
    end
    chan.Close(l.ready)
    mem.Free(a as void*)
end

@en "FragmentSizes"
@fa "اندازه تکه ها"
pub func FragmentSizes(total: int, min: int, max: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    mut lo := min
    if lo < 1:
        lo = 1
    end
    mut hi := max
    if hi < lo:
        hi = lo
    end
    mut remaining := total
    until remaining > 0:
        mut n := rand.IntRange(lo as i64, hi as i64) as int
        if n < lo:
            n = lo
        end
        if n > remaining:
            n = remaining
        end
        out.push(n)
        remaining -= n
    end
    ret out
end

@en "Ok"
@fa "معتبر"
pub func Ok(c: Conn): bool:
    ret c.open
end

@en "Read"
@fa "خواندن"
pub func Read(c &: Conn, buf: void*, max: int): int:
    if c.pre.len > 0:
        mut n := max
        if n > c.pre.len:
            n = c.pre.len
        end
        mem.Copy(buf, c.pre.p, n as u64)
        Consume(c.pre, n)
        ret n
    end
    if not c.ws:
        ret _raw_read(c, buf, max)
    end
    if c.fr_left == 0:
        if _ws_next_frame(c) <= 0:
            ret 0
        end
    end
    mut take := max
    if take > c.fr_left:
        take = c.fr_left
    end
    r := _raw_read(c, buf, take)
    if r <= 0:
        ret r
    end
    _ws_unmask(c, buf as u8*, r)
    c.fr_left -= r
    ret r
end

@en "ReadFull"
@fa "خواندن کامل"
pub func ReadFull(c &: Conn, buf: void*, n: int): bool:
    mut got := 0
    until got < n:
        r := Read(c, ((buf as i64) + (got as i64)) as void*, n - got)
        if r <= 0:
            ret false
        end
        got += r
    end
    ret true
end

@en "Write"
@fa "نوشتن"
pub func Write(c &: Conn, p: void*, n: int): bool:
    if n <= 0:
        ret true
    end
    if c.ws:
        ret _ws_send(c, 2, p, n)
    end
    ret _raw_write(c, p, n)
end

@en "WriteBytes"
@fa "ارسال بایت ها"
pub func WriteBytes(c &: Conn, b: Bytes): bool:
    ret Write(c, b.p, b.len)
end

@en "SwitchDirect"
@fa "تغییر به خواندن مستقیم"
pub func SwitchDirect(c &: Conn): bool:
    if c.ws:
        ret false
    end
    if c.kind == KindStream:
        c.up.SetDeadline(tunnel.DeadlineDirect)
        ret true
    end
    if c.kind != KindTLS:
        ret false
    end
    tls.SwitchDirect(c.tls)
    ret true
end

@en "SetReadTimeout"
@fa "مهلت خواندن"
pub func SetReadTimeout(c &: Conn, ms: int):
    if c.kind == KindStream:
        c.up.SetDeadline(ms)
    else c.kind == KindTLS:
        tcp.SetReadDeadline(tcp.ConnFromFd(tls.Fd(c.tls)), ms)
    else:
        tcp.SetReadDeadline(c.tcp, ms)
    end
end

@en "Close"
@fa "بستن"
pub func Close(c &: Conn):
    if c.ws and c.open:
        _ws_send(c, 8, null, 0)
    end
    c.open = false
    FreeBytes(c.wbuf)
    if c.kind == KindStream:
        c.up.Close()
    else c.kind == KindTLS:
        tls.Close(c.tls)
    else:
        tcp.Close(c.tcp)
    end
    FreeBytes(c.pre)
end

@en "DialEarly"
@fa "شماره گیری با داده زودهنگام"
pub func DialEarly(host: str, port: int, s: Settings, early: Bytes): Conn:
    mut c := Conn {}
    c.client = true
    mut tc := tcp.Dial(host, port)
    if s.timeout_ms > 0:
        tc = tcp.DialTimeout(host, port, s.timeout_ms)
    end
    if not tcp.ConnOk(tc):
        c.err = "could not connect to " + host
        ret c
    end
    tcp.SetNoDelay(tc, true)
    c.tcp = tc
    if s.security == "reality":
        mut rs := s.reality
        if rs.server_name.len() == 0:
            rs.server_name = s.sni
        end
        if rs.server_name.len() == 0:
            rs.server_name = host
        end
        if s.fingerprint.len() > 0 and rs.fingerprint.len() == 0:
            rs.fingerprint = s.fingerprint
        end
        c.kind = KindTLS
        c.tls = reality.DialOver(tc.fd, rs)
        if not tls.ConnOk(c.tls):
            c.err = "reality: " + tls.ConnError(c.tls)
            tcp.Close(tc)
            ret c
        end
    else s.tls:
        c.kind = KindTLS
        c.tls = tls.WrapClient(tc.fd, _tls_config(host, s))
        if not tls.ConnOk(c.tls):
            c.err = "tls: " + tls.ConnError(c.tls)
            tcp.Close(tc)
            ret c
        end
    end
    if s.network == "grpc":
        gc := _grpc_dial(host, s, c)
        if not gc.open:
            Close(c)
        end
        ret gc
    end
    if s.network == "ws" or s.network == "httpupgrade":
        if not _client_upgrade(c, host, s, early):
            Close(c)
            ret c
        end
    end
    _apply_idle(c, s)
    c.open = true
    ret c
end

@en "Dial"
@fa "شماره گیری"
pub func Dial(host: str, port: int, s: Settings): Conn:
    ret DialEarly(host, port, s, Bytes {})
end

@en "ListenAt"
@fa "شنود در نشانی"
pub func ListenAt(host: str, port: int, s: Settings): Listener:
    mut l := Listener {}
    l.settings = s
    mut h := host
    if h.len() == 0:
        h = "127.0.0.1"
    end
    if h == "all":
        h = "0.0.0.0"
    end
    sock := rawsock.ListenOn(h, port, 1)
    l.server = tcp.Server { fd = sock.fd, port = port }
    l.ready.init(64)
    l.flags = mem.AllocateZeroed(16 as u64) as i64*
    mut cap := s.max_handshakes
    if cap <= 0:
        cap = 128
    end
    l.slots = sync.NewSemaphore(cap as i64)
    l.sources = tunnel.NewSourceTable()
    if s.tls and s.security != "reality":
        l.tls_cfg = tls.NewServerConfig(s.cert_file, s.key_file)
    end
    ret l
end

@en "ListenerFrom"
@fa "شنونده از سرور"
pub func ListenerFrom(server: tcp.Server, s: Settings): Listener:
    mut l := Listener {}
    l.settings = s
    l.server = server
    l.ready.init(64)
    l.flags = mem.AllocateZeroed(16 as u64) as i64*
    mut cap := s.max_handshakes
    if cap <= 0:
        cap = 128
    end
    l.slots = sync.NewSemaphore(cap as i64)
    l.sources = tunnel.NewSourceTable()
    if s.tls and s.security != "reality":
        l.tls_cfg = tls.NewServerConfig(s.cert_file, s.key_file)
    end
    ret l
end

@en "Listen"
@fa "شنود"
pub func Listen(port: int, s: Settings): Listener:
    ret ListenAt(s.bind, port, s)
end

@en "ListenAll"
@fa "شنود همه"
pub func ListenAll(port: int, s: Settings): Listener:
    ret ListenAt("0.0.0.0", port, s)
end

@en "ListenerOk"
@fa "شنونده معتبر"
pub func ListenerOk(l: Listener): bool:
    if not tcp.Ok(l.server):
        ret false
    end
    if l.settings.security == "reality":
        ret l.settings.reality_server.private_key.len() > 0
    end
    if l.settings.tls:
        ret l.tls_cfg.ok
    end
    ret true
end

@en "ListenerPort"
@fa "درگاه شنونده"
pub func ListenerPort(l: Listener): int:
    ret tcp.Port(l.server)
end

@en "CloseListener"
@fa "بستن شنونده"
pub func CloseListener(l: Listener):
    if l.flags != null:
        l.flags[1] = 1 as i64
    end
    rawsock.Shutdown(rawsock.FromFd(l.server.fd))
    tcp.CloseServer(l.server)
end

@en "AcceptRaw"
@fa "پذیرش خام"
pub func AcceptRaw(l: Listener): Conn:
    tc := tcp.Accept(l.server)
    if not tcp.ConnOk(tc):
        mut c := Conn {}
        c.err = "accept failed"
        ret c
    end
    mut c := _finish_accept(l, tc)
    c.remote = rawsock.PeerHost(rawsock.FromFd(tc.fd))
    if c.open:
        _apply_idle(c, l.settings)
    end
    ret c
end

@en "Upgrade"
@fa "ارتقا"
pub func Upgrade(c &: Conn, s: Settings): bool:
    if not c.open:
        ret false
    end
    if s.network != "ws" and s.network != "httpupgrade":
        ret true
    end
    h := _read_headers(c)
    if h.len() == 0:
        c.err = "no request"
        Close(c)
        ret false
    end
    c.request_path = _request_path(h)
    c.request_host = _header(h, "host")
    mut want := s.path
    if want.len() == 0:
        want = "/"
    end
    if c.request_path != want:
        _server_reject(c, "404 Not Found")
        c.err = "path mismatch"
        Close(c)
        ret false
    end
    if s.host.len() > 0:
        mut rh := c.request_host
        colon := str.Find(rh, ":")
        if colon >= 0:
            rh = rh.substr(0, colon)
        end
        if str.Lower(rh) != str.Lower(s.host):
            _server_reject(c, "404 Not Found")
            c.err = "host mismatch"
            Close(c)
            ret false
        end
    end
    mut resp := "HTTP/1.1 101 Switching Protocols\r\nConnection: upgrade\r\nUpgrade: websocket\r\n"
    if s.network == "ws":
        key := _header(h, "sec-websocket-key")
        if key.len() == 0:
            _server_reject(c, "400 Bad Request")
            c.err = "not a websocket request"
            Close(c)
            ret false
        end
        resp += "Sec-WebSocket-Accept: " + websocket.AcceptKey(key) + "\r\n"
        proto := _header(h, "sec-websocket-protocol")
        if proto.len() > 0 and s.early_data > 0:
            c.pre = _b64url_decode(proto)
            resp += "Sec-WebSocket-Protocol: " + proto + "\r\n"
        end
        c.ws = true
    else:
        if str.Lower(_header(h, "upgrade")) != "websocket":
            _server_reject(c, "400 Bad Request")
            c.err = "not an upgrade request"
            Close(c)
            ret false
        end
    end
    resp += "\r\n"
    if not _raw_write(c, resp as void*, resp.len()):
        Close(c)
        ret false
    end
    ret true
end

@en "Accept"
@fa "پذیرش"
pub func Accept(l: Listener): Conn:
    if l.flags == null:
        mut e := Conn {}
        e.err = "listener not open"
        ret e
    end
    if atomic_cas(l.flags, 0 as i64, 1 as i64):
        h := mem.AllocateZeroed(sizeof(_Hs) as u64) as _Hs*
        h[0] = _Hs { l = l }
        _a := spawn(_acceptor, h)
    end
    mut ok := false
    c := chan.Recv(l.ready, ok)
    if not ok:
        mut e := Conn {}
        e.err = "listener closed"
        ret e
    end
    ret c
end

@en "AsStream"
@fa "به عنوان جریان"
pub func AsStream(c: Conn): dyn tunnel.Stream:
    ret _StreamAdapter { c = c }
end

@en "FromStream"
@fa "از جریان"
pub func FromStream(s: dyn tunnel.Stream, client: bool): Conn:
    mut c := Conn {}
    c.kind = KindStream
    c.up = s
    c.client = client
    c.open = s.Ok()
    ret c
end
