package transport

import mem
import sync
import str
import crypto
import rand
import encoding
import tls
import chan
import net.tcp
import net.internal.rawsock
import net.websocket
import net.tunnel
import net.reality

@en "KindTCP"
@fa "نوع تی سی پی"
pub const KindTCP := 0

@en "KindTLS"
@fa "نوع تی ال اس"
pub const KindTLS := 1

@en "KindStream"
@fa "نوع جریان"
pub const KindStream := 2

struct _Hs:
    pub host: str = ""
    pub fd: i64 = 0 - 1
    pub l: Listener = Listener {}
    pub st: i64* = null
    pub mu: sync.Mutex = sync.Mutex {}
    pub cv: sync.CondVar = sync.CondVar {}
end

struct _StreamAdapter:
    pub c: Conn = Conn {}

    pub func Read(max: int): str:
        buf := mem.Allocate((max + 1) as u64)
        n := _stream_read(this.c, buf, max)
        if n <= 0:
            mem.Free(buf)
            ret ""
        end
        bp := buf as u8*
        bp[n] = 0 as u8
        ret buf as str
    end

    pub func ReadBytes(buf: void*, max: int): int:
        ret _stream_read(this.c, buf, max)
    end

    pub func Write(data: str): int:
        if not _stream_write(this.c, data as void*, data.len()):
            ret 0 - 1
        end
        ret data.len()
    end

    pub func WriteBytes(ptr: void*, n: int): int:
        if not _stream_write(this.c, ptr, n):
            ret 0 - 1
        end
        ret n
    end

    pub func SetDeadline(millis: int):
        if millis == tunnel.DeadlineDirect:
            SwitchDirect(this.c)
            ret
        end
        _stream_timeout(this.c, millis)
    end

    pub func Shutdown():
        if this.c.kind == KindTLS:
            rawsock.Shutdown(rawsock.FromFd(tls.Fd(this.c.tls)))
        else this.c.kind == KindTCP:
            rawsock.Shutdown(rawsock.FromFd(this.c.tcp.fd))
        end
    end

    pub func CloseWrite():
        if this.c.kind == KindTLS:
            tls.CloseWrite(this.c.tls)
        else this.c.kind == KindTCP:
            rawsock.ShutdownWrite(rawsock.FromFd(this.c.tcp.fd))
        else this.c.kind == KindStream:
            this.c.up.CloseWrite()
        end
    end

    pub func Close():
        _stream_close(this.c)
    end

    pub func Ok(): bool:
        ret this.c.open
    end
end

