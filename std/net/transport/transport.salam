@en "net/transport"
@fa "انتقال شبکه"
package transport

import mem

@en "Bytes"
@fa "بایت‌ها"
pub struct Bytes:
    @en "p"
    @fa "نشانگر"
    pub p: void* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
    @en "cap"
    @fa "ظرفیت"
    pub cap: int = 0
    @en "bad"
    @fa "خراب"
    pub bad: bool = false
end

inline func _ptr_at(p: void*, off: int): void*:
    ret ((p as i64) + (off as i64)) as void*
end

func _hexval(c: int): int:
    if c >= 48 and c <= 57: ret c - 48 end
    if c >= 97 and c <= 102: ret c - 87 end
    if c >= 65 and c <= 70: ret c - 55 end
    ret 0 - 1
end

@en "NewBytes"
@fa "بایت‌های جدید"
pub func NewBytes(cap0: int): Bytes:
    mut c := cap0
    if c < 32: c = 32 end
    p := mem.AllocateZeroed(c as u64)
    if p == null:
        ret Bytes { p = null, len = 0, cap = 0, bad = true }
    end
    ret Bytes { p = p, len = 0, cap = c, bad = false }
end

@en "FreeBytes"
@fa "آزادسازی بایت‌ها"
pub func FreeBytes(b &: Bytes):
    if b.p != null:
        mem.Set(b.p, 0, b.cap as u64)
        mem.Free(b.p)
    end
    b.p = null
    b.len = 0
    b.cap = 0
end

@en "ResetBytes"
@fa "بازنشانی بایت‌ها"
pub func ResetBytes(b &: Bytes):
    b.len = 0
end

@en "BytesPtr"
@fa "نشانگر بایت‌ها"
pub func BytesPtr(b: Bytes, off: int): void*:
    ret _ptr_at(b.p, off)
end

@en "Reserve"
@fa "رزرو"
pub func Reserve(b &: Bytes, need: int):
    if b.bad: ret end
    if b.len + need <= b.cap: ret end
    mut nc := b.cap
    if nc < 32: nc = 32 end
    until b.len + need <= nc:
        nc *= 2
    end
    np := mem.Reallocate(b.p, nc as u64)
    if np == null:
        b.bad = true
        ret
    end
    b.p = np
    b.cap = nc
end

@en "Put8"
@fa "نوشتن بایت"
pub func Put8(b &: Bytes, v: int):
    Reserve(b, 1)
    if b.bad: ret end
    bp := b.p as u8*
    bp[b.len] = (v & 0xFF) as u8
    b.len++
end

@en "Put16"
@fa "نوشتن شانزده بیت"
pub func Put16(b &: Bytes, v: int):
    Put8(b, (v >> 8) & 0xFF)
    Put8(b, v & 0xFF)
end

@en "Put32"
@fa "نوشتن سی و دو بیت"
pub func Put32(b &: Bytes, v: i64):
    Put8(b, ((v >> 24) & 0xFF) as int)
    Put8(b, ((v >> 16) & 0xFF) as int)
    Put8(b, ((v >> 8) & 0xFF) as int)
    Put8(b, (v & 0xFF) as int)
end

@en "Put64"
@fa "نوشتن شصت و چهار بیت"
pub func Put64(b &: Bytes, v: u64):
    repeat 8 in i:
        sh := ((7 - i) * 8) as u64
        Put8(b, ((v >> sh) & (0xFF as u64)) as int)
    end
end

@en "PutRaw"
@fa "نوشتن خام"
pub func PutRaw(b &: Bytes, src: void*, n: int):
    if n <= 0: ret end
    Reserve(b, n)
    if b.bad: ret end
    mem.Copy(_ptr_at(b.p, b.len), src, n as u64)
    b.len += n
end

@en "PutBytes"
@fa "نوشتن بایت‌ها"
pub func PutBytes(b &: Bytes, src: Bytes):
    PutRaw(b, src.p, src.len)
end

@en "PutStr"
@fa "نوشتن رشته"
pub func PutStr(b &: Bytes, s: str):
    PutRaw(b, s as void*, s.len())
end

@en "PutZeros"
@fa "نوشتن صفرها"
pub func PutZeros(b &: Bytes, n: int):
    if n <= 0: ret end
    Reserve(b, n)
    if b.bad: ret end
    mem.Set(_ptr_at(b.p, b.len), 0, n as u64)
    b.len += n
end

@en "At"
@fa "بایت در"
pub func At(b: Bytes, i: int): int:
    if i < 0 or i >= b.len: ret 0 end
    bp := b.p as u8*
    ret bp[i] as int
end

@en "Set8"
@fa "تنظیم بایت"
pub func Set8(b &: Bytes, i: int, v: int):
    if i < 0 or i >= b.len: ret end
    bp := b.p as u8*
    bp[i] = (v & 0xFF) as u8
end

@en "Peek16"
@fa "خواندن شانزده بیت"
pub func Peek16(b: Bytes, i: int): int:
    ret (At(b, i) << 8) | At(b, i + 1)
end

@en "Peek32"
@fa "خواندن سی و دو بیت"
pub func Peek32(b: Bytes, i: int): i64:
    ret ((At(b, i) as i64) << (24 as i64)) | ((At(b, i + 1) as i64) << (16 as i64)) | ((At(b, i + 2) as i64) << (8 as i64)) | (At(b, i + 3) as i64)
end

@en "Consume"
@fa "مصرف"
pub func Consume(b &: Bytes, n: int):
    if n <= 0: ret end
    if n >= b.len:
        b.len = 0
        ret
    end
    mem.MemMove(b.p, _ptr_at(b.p, n), (b.len - n) as u64)
    b.len -= n
end

@en "Equal"
@fa "برابر"
pub func Equal(a: Bytes, b: Bytes): bool:
    if a.len != b.len: ret false end
    mut diff := 0
    repeat a.len in i:
        diff |= At(a, i) ^ At(b, i)
    end
    ret diff == 0
end

@en "ToHex"
@fa "به هگزا"
pub func ToHex(b: Bytes): str:
    dp := "0123456789abcdef" as u8*
    n := b.len * 2
    out := mem.Allocate((n + 1) as u64)
    op := out as u8*
    repeat b.len in i:
        v := At(b, i)
        op[2 * i] = dp[(v >> 4) & 15]
        op[2 * i + 1] = dp[v & 15]
    end
    op[n] = 0 as u8
    ret out as str
end

@en "FromHex"
@fa "از هگزا"
pub func FromHex(h: str): Bytes:
    mut b := NewBytes(h.len() / 2 + 1)
    hp := h as u8*
    repeat h.len() / 2 in i:
        hi := _hexval(hp[2 * i] as int)
        lo := _hexval(hp[2 * i + 1] as int)
        if hi < 0 or lo < 0:
            b.bad = true
            ret b
        end
        Put8(b, hi * 16 + lo)
    end
    ret b
end

@en "FromStr"
@fa "از رشته"
pub func FromStr(s: str): Bytes:
    mut b := NewBytes(s.len() + 1)
    PutStr(b, s)
    ret b
end
