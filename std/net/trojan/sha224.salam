package trojan

import mem
import compress

const K224 := [
    0x428a2f98 as u32, 0x71374491 as u32, 0xb5c0fbcf as u32, 0xe9b5dba5 as u32
    0x3956c25b as u32, 0x59f111f1 as u32, 0x923f82a4 as u32, 0xab1c5ed5 as u32
    0xd807aa98 as u32, 0x12835b01 as u32, 0x243185be as u32, 0x550c7dc3 as u32
    0x72be5d74 as u32, 0x80deb1fe as u32, 0x9bdc06a7 as u32, 0xc19bf174 as u32
    0xe49b69c1 as u32, 0xefbe4786 as u32, 0x0fc19dc6 as u32, 0x240ca1cc as u32
    0x2de92c6f as u32, 0x4a7484aa as u32, 0x5cb0a9dc as u32, 0x76f988da as u32
    0x983e5152 as u32, 0xa831c66d as u32, 0xb00327c8 as u32, 0xbf597fc7 as u32
    0xc6e00bf3 as u32, 0xd5a79147 as u32, 0x06ca6351 as u32, 0x14292967 as u32
    0x27b70a85 as u32, 0x2e1b2138 as u32, 0x4d2c6dfc as u32, 0x53380d13 as u32
    0x650a7354 as u32, 0x766a0abb as u32, 0x81c2c92e as u32, 0x92722c85 as u32
    0xa2bfe8a1 as u32, 0xa81a664b as u32, 0xc24b8b70 as u32, 0xc76c51a3 as u32
    0xd192e819 as u32, 0xd6990624 as u32, 0xf40e3585 as u32, 0x106aa070 as u32
    0x19a4c116 as u32, 0x1e376c08 as u32, 0x2748774c as u32, 0x34b0bcb5 as u32
    0x391c0cb3 as u32, 0x4ed8aa4a as u32, 0x5b9cca4f as u32, 0x682e6ff3 as u32
    0x748f82ee as u32, 0x78a5636f as u32, 0x84c87814 as u32, 0x8cc70208 as u32
    0x90befffa as u32, 0xa4506ceb as u32, 0xbef9a3f7 as u32, 0xc67178f2 as u32
]

const IV224 := [
    0xc1059ed8 as u32, 0x367cd507 as u32, 0x3070dd17 as u32, 0xf70e5939 as u32
    0xffc00b31 as u32, 0x68581511 as u32, 0x64f98fa7 as u32, 0xbefa4fa4 as u32
]

const HEXDIGITS := "0123456789abcdef"

inline func _rotr(x: u32, n: u32): u32:
    ret (x >> n) | (x << ((32 as u32) - n))
end

func _sha224_block(h: u32*, p: void*, off: int):
    bp := p as u8*
    mut w: u32[64]
    repeat 16 in t:
        o := off + t * 4
        w[t] = ((bp[o] as u32) << (24 as u32)) | ((bp[o + 1] as u32) << (16 as u32)) | ((bp[o + 2] as u32) << (8 as u32)) | (bp[o + 3] as u32)
    end
    repeat 48 in k:
        t := k + 16
        x15 := w[t - 15]
        x2 := w[t - 2]
        s0 := _rotr(x15, 7 as u32) ^ _rotr(x15, 18 as u32) ^ (x15 >> (3 as u32))
        s1 := _rotr(x2, 17 as u32) ^ _rotr(x2, 19 as u32) ^ (x2 >> (10 as u32))
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
    end
    mut a := h[0]
    mut b := h[1]
    mut c := h[2]
    mut d := h[3]
    mut e := h[4]
    mut f := h[5]
    mut g := h[6]
    mut hh := h[7]
    repeat 64 in t:
        bigs1 := _rotr(e, 6 as u32) ^ _rotr(e, 11 as u32) ^ _rotr(e, 25 as u32)
        ch := (e & f) ^ ((~e) & g)
        t1 := hh + bigs1 + ch + K224[t] + w[t]
        bigs0 := _rotr(a, 2 as u32) ^ _rotr(a, 13 as u32) ^ _rotr(a, 22 as u32)
        maj := (a & b) ^ (a & c) ^ (b & c)
        t2 := bigs0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    end
    h[0] += a
    h[1] += b
    h[2] += c
    h[3] += d
    h[4] += e
    h[5] += f
    h[6] += g
    h[7] += hh
end

@en "Sha224"
@fa "اس‌اچ‌ای۲۲۴"
pub func Sha224(p: void*, n: int): compress.ByteBuf:
    mut msg := compress.NewByteBufCap(n + 72)
    defer compress.BufFree(msg)
    compress.BufPushBytes(msg, p, n)
    compress.BufPush(msg, 0x80)
    until msg.len % 64 != 56:
        compress.BufPush(msg, 0)
    end
    bits := (n as u64) * (8 as u64)
    repeat 8 in i:
        sh := ((7 - i) * 8) as u64
        compress.BufPush(msg, ((bits >> sh) & (0xFF as u64)) as int)
    end
    hp := mem.Allocate(32 as u64) as u32*
    defer mem.Free(hp as void*)
    repeat 8 in i:
        hp[i] = IV224[i]
    end
    mut off := 0
    until off < msg.len:
        _sha224_block(hp, msg.data, off)
        off += 64
    end
    mut out := compress.NewByteBufCap(28)
    repeat 7 in i:
        v := hp[i]
        compress.BufPush(out, ((v >> (24 as u32)) & (0xFF as u32)) as int)
        compress.BufPush(out, ((v >> (16 as u32)) & (0xFF as u32)) as int)
        compress.BufPush(out, ((v >> (8 as u32)) & (0xFF as u32)) as int)
        compress.BufPush(out, (v & (0xFF as u32)) as int)
    end
    ret out
end

@en "HexOf"
@fa "هگز"
pub func HexOf(b: compress.ByteBuf): str:
    mut s := ""
    repeat b.len in i:
        v := compress.BufGet(b, i)
        s = s + HEXDIGITS.Substr(v >> 4, 1) + HEXDIGITS.Substr(v & 15, 1)
    end
    ret s
end

@en "Sha224Hex"
@fa "اس‌اچ‌ای۲۲۴ هگز"
pub func Sha224Hex(s: str): str:
    mut d := Sha224(s as void*, s.Len())
    defer compress.BufFree(d)
    ret HexOf(d)
end

@en "PasswordHash"
@fa "درهم گذرواژه"
pub func PasswordHash(password: str): str:
    ret Sha224Hex(password)
end
