@en "net/tun"
@fa "تون"
package tun

import net.tunnel

@en "DefaultAddress"
@fa "نشانی پیش‌فرض"
pub const DefaultAddress := "172.19.0.1"
@en "DefaultAddress6"
@fa "نشانی پیش‌فرض شش"
pub const DefaultAddress6 := "fdfe:dcba:9876::1"
@en "DefaultUpstream"
@fa "نام‌یاب بالادست پیش‌فرض"
pub const DefaultUpstream := "1.1.1.1:53"

@en "Options"
@fa "گزینه‌ها"
pub struct Options:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "address"
    @fa "نشانی"
    pub address: str = "172.19.0.1"
    @en "prefix"
    @fa "پیشوند"
    pub prefix: int = 30
    @en "mtu"
    @fa "بیشینه‌بسته"
    pub mtu: int = 1500
    @en "dialer"
    @fa "شماره‌گیر"
    pub dialer: dyn tunnel.Dialer = tunnel.BlockDialer {}
    @en "exclude"
    @fa "استثناها"
    pub exclude: Vector<str> = Vector {}
    @en "auto_route"
    @fa "مسیریابی خودکار"
    pub auto_route: bool = true
    @en "hijack_dns"
    @fa "ربودن نام‌یابی"
    pub hijack_dns: bool = true
    @en "upstream"
    @fa "نام‌یاب بالادست"
    pub upstream: str = "1.1.1.1:53"
    @en "set_system_dns"
    @fa "تنظیم نام‌یاب سامانه"
    pub set_system_dns: bool = true
    @en "block_ipv6"
    @fa "بستن آی‌پی۶"
    pub block_ipv6: bool = true
    @en "sniff"
    @fa "شناسایی دامنه"
    pub sniff: bool = true
    @en "sniff_ms"
    @fa "مهلت شناسایی"
    pub sniff_ms: int = 300
    @en "idle_ms"
    @fa "مهلت بیکاری"
    pub idle_ms: int = 600000
    @en "dial_ms"
    @fa "مهلت اتصال"
    pub dial_ms: int = 10000
end

@en "Gateway"
@fa "دروازه"
pub struct Gateway:
    @en "ok"
    @fa "درست"
    pub ok: bool = false
    @en "ip"
    @fa "نشانی دروازه"
    pub ip: str = ""
    @en "iface"
    @fa "رابط"
    pub iface: str = ""
    @en "index"
    @fa "شماره رابط"
    pub index: int = 0
end

@en "Plan"
@fa "نقشه"
pub struct Plan:
    @en "up"
    @fa "برپایی"
    pub up: Vector<str> = Vector {}
    @en "down"
    @fa "برچیدن"
    pub down: Vector<str> = Vector {}
end

@en "Availability"
@fa "دسترس‌پذیری"
pub struct Availability:
    @en "ok"
    @fa "درست"
    pub ok: bool = false
    @en "reason"
    @fa "دلیل"
    pub reason: str = ""
end

@en "Stats"
@fa "آمار"
pub struct Stats:
    @en "packets_in"
    @fa "بسته‌های‌ورودی"
    pub packets_in: i64 = 0 as i64
    @en "packets_out"
    @fa "بسته‌های‌خروجی"
    pub packets_out: i64 = 0 as i64
    @en "dropped"
    @fa "دورریخته‌ها"
    pub dropped: i64 = 0 as i64
    @en "connections"
    @fa "اتصال‌ها"
    pub connections: i64 = 0 as i64
    @en "active"
    @fa "اتصال‌های فعال"
    pub active: i64 = 0 as i64
    @en "dns_queries"
    @fa "پرسش‌های نام‌یابی"
    pub dns_queries: i64 = 0 as i64
    @en "sniffed"
    @fa "دامنه‌های شناسایی‌شده"
    pub sniffed: i64 = 0 as i64
    @en "failed"
    @fa "اتصال‌های ناموفق"
    pub failed: i64 = 0 as i64
    @en "bytes_up"
    @fa "بایت‌های بالارو"
    pub bytes_up: i64 = 0 as i64
    @en "bytes_down"
    @fa "بایت‌های پایین‌رو"
    pub bytes_down: i64 = 0 as i64
end

@en "Device"
@fa "دستگاه"
pub struct Device:
    @en "ok"
    @fa "درست"
    pub ok: bool = false
    @en "error"
    @fa "خطا"
    pub error: str = ""
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "mtu"
    @fa "بیشینه‌بسته"
    pub mtu: int = 1500
    @en "fd"
    @fa "توصیف‌گر"
    pub fd: i64 = 0 - 1
    @en "session"
    @fa "نشست وین‌تون"
    pub session: void* = null
    @en "adapter"
    @fa "آداپتور"
    pub adapter: void* = null
    @en "event"
    @fa "رویداد خواندن"
    pub event: void* = null
    @en "scratch"
    @fa "میانگیر"
    pub scratch: void* = null

    @en "Read"
    @fa "خواندن"
    pub func Read(buf: void*, max: int, timeout_ms: int): int:
        if not this.ok:
            ret 0 - 1
        end
        ret _dev_read(this[0], buf, max, timeout_ms)
    end

    @en "Write"
    @fa "نوشتن"
    pub func Write(ptr: void*, n: int): int:
        if not this.ok:
            ret 0 - 1
        end
        ret _dev_write(this[0], ptr, n)
    end

    @en "Close"
    @fa "بستن"
    pub func Close():
        if this.ok:
            _dev_close(this[0])
        end
    end
end

@en "BypassDialer"
@fa "شماره‌گیر دورزن"
pub struct BypassDialer:
    @en "gateway"
    @fa "دروازه فیزیکی"
    pub gateway: Gateway = Gateway {}
    @en "timeout_ms"
    @fa "مهلت اتصال"
    pub timeout_ms: int = 10000

    @en "Dial"
    @fa "اتصال"
    pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
        ret _bypass_dial(this.gateway, target, this.timeout_ms)
    end

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "bypass"
    end
end

@en "Session"
@fa "نشست"
pub struct Session:
    @en "ok"
    @fa "درست"
    pub ok: bool = false
    @en "error"
    @fa "خطا"
    pub error: str = ""
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "address"
    @fa "نشانی"
    pub address: str = ""
    @en "dns"
    @fa "نشانی نام‌یاب"
    pub dns: str = ""
    @en "id"
    @fa "شناسه"
    pub id: int = 0
end
