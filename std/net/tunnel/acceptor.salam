@en "net/tunnel"
@fa "تونل"
package tunnel

import mem
import atomic
import pool
import sync
import net.tcp
import net.internal.rawsock

struct _AcceptJob:
    pub server: AcceptServer = AcceptServer {}
    pub proto: dyn InboundProtocol = NullProtocol {}
    pub handler: dyn Handler = ForwardHandler {}
end

@en "Pending"
@fa "اتصال در انتظار"
pub interface Pending:
    @en "Valid"
    @fa "معتبر"
    func Valid(): bool
    @en "Open"
    @fa "گشودن"
    func Open(): dyn Stream
    @en "Abort"
    @fa "رها کردن"
    func Abort()
    @en "Remote"
    @fa "مبدا"
    func Remote(): str
end

struct _SourceCore:
    pub mu: sync.Mutex = sync.Mutex {}
    pub counts: HashMap<str, int> = HashMap {}
end

@en "SourceTable"
@fa "جدول مبداها"
pub struct SourceTable:
    @en "core"
    @fa "هسته"
    pub core: void* = null
end

@en "Acceptor"
@fa "پذیرنده اتصال"
pub interface Acceptor:
    @en "Accept"
    @fa "پذیرش"
    func Accept(): dyn Pending
    @en "Port"
    @fa "درگاه"
    func Port(): int
    @en "Ok"
    @fa "معتبر"
    func Ok(): bool
    @en "Close"
    @fa "بستن"
    func Close()
end

@en "ReadyConn"
@fa "اتصال آماده"
pub struct ReadyConn:
    @en "stream"
    @fa "جریان"
    pub stream: dyn Stream = ClosedStream {}
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
    @en "remote"
    @fa "مبدا"
    pub remote: str = ""

    @en "Valid"
    @fa "معتبر"
    pub func Valid(): bool:
        ret this.ok
    end

    @en "Open"
    @fa "گشودن"
    pub func Open(): dyn Stream:
        ret this.stream
    end

    @en "Abort"
    @fa "رها کردن"
    pub func Abort():
        this.stream.Close()
    end

    @en "Remote"
    @fa "مبدا"
    pub func Remote(): str:
        ret this.remote
    end
end

@en "TcpAcceptor"
@fa "پذیرنده تی سی پی"
pub struct TcpAcceptor:
    @en "server"
    @fa "کارساز"
    pub server: tcp.Server = tcp.Server {}

    @en "Accept"
    @fa "پذیرش"
    pub func Accept(): dyn Pending:
        c := tcp.Accept(this.server)
        if not tcp.ConnOk(c): ret ReadyConn {} end
        tcp.SetNoDelay(c, true)
        ret ReadyConn { stream = TcpStream { conn = c }, ok = true, remote = rawsock.PeerHost(rawsock.FromFd(c.fd)) }
    end

    @en "Port"
    @fa "درگاه"
    pub func Port(): int:
        ret tcp.Port(this.server)
    end

    @en "Ok"
    @fa "معتبر"
    pub func Ok(): bool:
        ret tcp.Ok(this.server)
    end

    @en "Close"
    @fa "بستن"
    pub func Close():
        tcp.CloseServer(this.server)
    end
end

@en "AcceptServer"
@fa "کارساز پذیرش"
pub struct AcceptServer:
    @en "acceptor"
    @fa "پذیرنده"
    pub acceptor: dyn Acceptor = TcpAcceptor {}
    @en "host"
    @fa "میزبان"
    pub host: str = "127.0.0.1"
    @en "running"
    @fa "فعال"
    pub running: atomic.Flag = atomic.Flag {}
    @en "workers"
    @fa "کارگرها"
    pub workers: pool.Pool = pool.Pool {}
    @en "handshake_ms"
    @fa "مهلت دست‌دهی"
    pub handshake_ms: int = 8000
    @en "per_source"
    @fa "سقف مبدا"
    pub per_source: int = 0
    @en "sources"
    @fa "مبداها"
    pub sources: SourceTable = SourceTable {}

    @en "Ok"
    @fa "معتبر"
    pub func Ok(): bool:
        ret this.acceptor.Ok()
    end

    @en "Port"
    @fa "درگاه"
    pub func Port(): int:
        ret this.acceptor.Port()
    end

    @en "Stop"
    @fa "توقف"
    pub func Stop():
        atomic.Set(this.running, false)
        tcp.WakeServer(this.host, this.acceptor.Port())
        this.acceptor.Close()
    end
end

func _accept_conn(p: dyn Pending, proto: dyn InboundProtocol, h: dyn Handler, handshake_ms: int, sources: SourceTable, host: str):
    up := p.Open()
    if not up.Ok():
        up.Close()
        SourceLeave(sources, host)
        ret
    end
    up.SetDeadline(handshake_ms)
    sess := proto.Handshake(up)
    SourceLeave(sources, host)
    if not sess.ok:
        up.Close()
        ret
    end
    up.SetDeadline(0)
    h.Handle(up, sess)
end

func _accept_loop(srv: AcceptServer, proto: dyn InboundProtocol, h: dyn Handler):
    a := srv.acceptor
    hs := srv.handshake_ms
    limit := srv.per_source
    sources := srv.sources
    until atomic.Get(srv.running):
        p := a.Accept()
        if not p.Valid(): continue end
        if not atomic.Get(srv.running):
            p.Abort()
            break
        end
        host := p.Remote()
        if not SourceEnter(sources, host, limit):
            p.Abort()
            continue
        end
        pool.Submit(srv.workers, (): _accept_conn(p, proto, h, hs, sources, host) end)
    end
end

func _accept_thread(jp: _AcceptJob*):
    j := jp[0]
    mem.Free(jp as void*)
    _accept_loop(j.server, j.proto, j.handler)
end

@en "NewSourceTable"
@fa "جدول مبداها جدید"
pub func NewSourceTable(): SourceTable:
    p := mem.AllocateZeroed(sizeof(_SourceCore) as u64) as _SourceCore*
    p[0] = _SourceCore { mu = sync.NewMutex() }
    ret SourceTable { core = p as void* }
end

@en "SourceKey"
@fa "کلید مبدا"
pub func SourceKey(remote: str): str:
    h := rawsock.CanonIP(remote)
    if rawsock.IsIPv6(h):
        ret rawsock.V6Prefix(h, 64)
    end
    ret h
end

@en "SourceEnter"
@fa "ورود مبدا"
pub func SourceEnter(t: SourceTable, remote: str, limit: int): bool:
    if limit <= 0 or remote.len() == 0 or t.core == null:
        ret true
    end
    host := SourceKey(remote)
    c := t.core as _SourceCore*
    sync.Lock(c[0].mu)
    n := c[0].counts.get_or(host, 0)
    ok := n < limit
    if ok:
        c[0].counts.put(host, n + 1)
    end
    sync.Unlock(c[0].mu)
    ret ok
end

@en "SourceLeave"
@fa "خروج مبدا"
pub func SourceLeave(t: SourceTable, remote: str):
    if remote.len() == 0 or t.core == null:
        ret
    end
    host := SourceKey(remote)
    c := t.core as _SourceCore*
    sync.Lock(c[0].mu)
    n := c[0].counts.get_or(host, 0)
    if n <= 1:
        c[0].counts.remove(host)
    else:
        c[0].counts.put(host, n - 1)
    end
    sync.Unlock(c[0].mu)
end

@en "NewAcceptServer"
@fa "کارساز پذیرش جدید"
pub func NewAcceptServer(a: dyn Acceptor, host: str): AcceptServer:
    ret AcceptServer { acceptor = a, host = host, running = atomic.NewFlag(false), workers = pool.NewElastic(2 as i64, 512 as i64, 1024 as i64), sources = NewSourceTable() }
end

@en "ListenTcpOn"
@fa "شنود تی سی پی روی نشانی"
pub func ListenTcpOn(host: str, port: int): AcceptServer:
    s := rawsock.ListenOn(host, port, rawsock.SOCK_STREAM)
    mut srv := tcp.Server { fd = s.fd }
    if s.fd >= 0: srv.port = rawsock.LocalPort(s) end
    ret NewAcceptServer(TcpAcceptor { server = srv }, host)
end

@en "ListenTcpDual"
@fa "شنود تی سی پی دوگانه"
pub func ListenTcpDual(port: int): AcceptServer:
    ret ListenTcpOn("::", port)
end

@en "ListenLocal6"
@fa "شنود محلی آی‌پی۶"
pub func ListenLocal6(port: int): AcceptServer:
    ret ListenTcpOn("::1", port)
end

@en "ListenLocal"
@fa "شنود محلی"
pub func ListenLocal(port: int): AcceptServer:
    ret ListenTcpOn("127.0.0.1", port)
end

@en "StartAccepting"
@fa "شروع پذیرش"
pub func StartAccepting(srv: AcceptServer, proto: dyn InboundProtocol, h: dyn Handler):
    atomic.Set(srv.running, true)
    jp := mem.AllocateZeroed(sizeof(_AcceptJob) as u64) as _AcceptJob*
    jp[0] = _AcceptJob { server = srv, proto = proto, handler = h }
    _t := spawn(_accept_thread, jp)
end
