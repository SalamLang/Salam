@en "net/tunnel"
@fa "تونل"
package tunnel

import str
import io
import encoding.json

mut _out_registry := Vector {} as Vector<dyn OutboundMaker>
mut _in_registry := Vector {} as Vector<dyn InboundMaker>

@en "InboundConfig"
@fa "پیکربندی درون‌سو"
pub struct InboundConfig:
    @en "tag"
    @fa "برچسب"
    pub tag: str = ""
    @en "protocol"
    @fa "پروتکل"
    pub protocol: str = ""
    @en "listen"
    @fa "نشانی شنود"
    pub listen: str = "127.0.0.1"
    @en "port"
    @fa "درگاه"
    pub port: int = 0
    @en "settings"
    @fa "تنظیمات"
    pub settings: str = ""
    @en "stream_settings"
    @fa "تنظیمات جریان"
    pub stream_settings: str = ""
end

@en "OutboundConfig"
@fa "پیکربندی خروجی"
pub struct OutboundConfig:
    @en "tag"
    @fa "برچسب"
    pub tag: str = ""
    @en "protocol"
    @fa "پروتکل"
    pub protocol: str = ""
    @en "settings"
    @fa "تنظیمات"
    pub settings: str = ""
    @en "stream_settings"
    @fa "تنظیمات جریان"
    pub stream_settings: str = ""
end

@en "RuleConfig"
@fa "پیکربندی قاعده"
pub struct RuleConfig:
    @en "domain"
    @fa "دامنه‌ها"
    pub domain: Vector<str> = Vector {}
    @en "ip"
    @fa "آی‌پی‌ها"
    pub ip: Vector<str> = Vector {}
    @en "port"
    @fa "درگاه"
    pub port: str = ""
    @en "outbound_tag"
    @fa "برچسب خروجی"
    pub outbound_tag: str = ""
end

@en "Config"
@fa "پیکربندی"
pub struct Config:
    @en "log_level"
    @fa "سطح گزارش"
    pub log_level: str = "warning"
    @en "inbounds"
    @fa "درون‌سوها"
    pub inbounds: Vector<InboundConfig> = Vector {}
    @en "outbounds"
    @fa "خروجی‌ها"
    pub outbounds: Vector<OutboundConfig> = Vector {}
    @en "rules"
    @fa "قاعده‌ها"
    pub rules: Vector<RuleConfig> = Vector {}
    @en "default_outbound"
    @fa "خروجی پیش‌فرض"
    pub default_outbound: str = ""
    @en "errors"
    @fa "خطاها"
    pub errors: Vector<str> = Vector {}
end

@en "OutboundMaker"
@fa "خروجی‌ساز"
pub interface OutboundMaker:
    @en "Protocol"
    @fa "پروتکل"
    func Protocol(): str
    @en "Make"
    @fa "ساخت"
    func Make(cfg: OutboundConfig): dyn Dialer
end

@en "InboundMaker"
@fa "درون‌سوساز"
pub interface InboundMaker:
    @en "Protocol"
    @fa "پروتکل"
    func Protocol(): str
    @en "Make"
    @fa "ساخت"
    func Make(cfg: InboundConfig): dyn InboundProtocol
end

func _items(raw: str): Vector<str>:
    ret json.Items(raw)
end

func _strs(raw: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    items := json.Items(raw)
    defer items.Free()
    repeat items.Len() in i:
        out.Push(json.Unquote(items[i]))
    end
    ret out
end

func _arr(items: Vector<str>): str:
    mut q := Vector {} as Vector<str>
    defer q.Free()
    repeat items.Len() in i:
        q.Push(json.Str(items[i]))
    end
    ret json.Array(q)
end

func _member_str(m &: Vector<str>, key: str, value: str):
    if value.Len() > 0: m.Push(json.Member(key, value)) end
end

func _is_port(p: int): bool:
    ret p >= 1 and p <= 65535
end

func _tag_exists(c: Config, tag: str): bool:
    repeat c.outbounds.Len() in i:
        if c.outbounds[i].tag == tag: ret true end
    end
    ret false
end

func _csv_to_array(csv: str): str:
    mut items := Vector {} as Vector<str>
    defer items.Free()
    parts := csv.Split(",")
    defer parts.Free()
    repeat parts.Len() in i:
        p := str.Trim(parts[i])
        if p.Len() > 0: items.Push(p) end
    end
    ret _arr(items)
end

func _array_to_csv(raw: str): str:
    v := _strs(raw)
    defer v.Free()
    mut out := ""
    repeat v.Len() in i:
        if i > 0: out += "," end
        out += v[i]
    end
    ret out
end

@en "RegisterOutbound"
@fa "ثبت خروجی"
pub func RegisterOutbound(m: dyn OutboundMaker):
    name := m.Protocol()
    repeat _out_registry.Len() in i:
        if _out_registry[i].Protocol() == name:
            _out_registry[i] = m
            ret
        end
    end
    _out_registry.Push(m)
end

@en "RegisterInbound"
@fa "ثبت درون‌سو"
pub func RegisterInbound(m: dyn InboundMaker):
    name := m.Protocol()
    repeat _in_registry.Len() in i:
        if _in_registry[i].Protocol() == name:
            _in_registry[i] = m
            ret
        end
    end
    _in_registry.Push(m)
end

@en "HasOutbound"
@fa "خروجی ثبت شده"
pub func HasOutbound(name: str): bool:
    if name == "freedom" or name == "direct" or name == "blackhole" or name == "block": ret true end
    repeat _out_registry.Len() in i:
        if _out_registry[i].Protocol() == name: ret true end
    end
    ret false
end

@en "HasInbound"
@fa "درون‌سو ثبت شده"
pub func HasInbound(name: str): bool:
    repeat _in_registry.Len() in i:
        if _in_registry[i].Protocol() == name: ret true end
    end
    ret false
end

@en "CreateOutbound"
@fa "ساخت خروجی"
pub func CreateOutbound(cfg: OutboundConfig): dyn Dialer:
    if cfg.protocol == "freedom" or cfg.protocol == "direct": ret DirectDialer {} end
    repeat _out_registry.Len() in i:
        if _out_registry[i].Protocol() == cfg.protocol:
            ret _out_registry[i].Make(cfg)
        end
    end
    ret BlockDialer {}
end

@en "CreateInbound"
@fa "ساخت درون‌سو"
pub func CreateInbound(cfg: InboundConfig): dyn InboundProtocol:
    repeat _in_registry.Len() in i:
        if _in_registry[i].Protocol() == cfg.protocol:
            ret _in_registry[i].Make(cfg)
        end
    end
    ret NullProtocol {}
end

@en "ParseConfig"
@fa "تجزیه پیکربندی"
pub func ParseConfig(text: str): Config:
    mut c := Config {}
    if not json.Valid(text):
        c.errors.Push("invalid JSON")
        ret c
    end
    ll := json.Get(json.Get(text, "log"), "loglevel")
    if ll.Len() > 0: c.log_level = ll end
    ins := _items(json.Get(text, "inbounds"))
    defer ins.Free()
    repeat ins.Len() in i:
        raw := ins[i]
        mut ib := InboundConfig { tag = json.Get(raw, "tag"), protocol = json.Get(raw, "protocol"), settings = json.Get(raw, "settings"), stream_settings = json.Get(raw, "streamSettings") }
        l := json.Get(raw, "listen")
        if l.Len() > 0: ib.listen = l end
        ib.port = json.Get(raw, "port").ToInt()
        c.inbounds.Push(ib)
    end
    outs := _items(json.Get(text, "outbounds"))
    defer outs.Free()
    repeat outs.Len() in i:
        raw := outs[i]
        c.outbounds.Push(OutboundConfig { tag = json.Get(raw, "tag"), protocol = json.Get(raw, "protocol"), settings = json.Get(raw, "settings"), stream_settings = json.Get(raw, "streamSettings") })
    end
    routing := json.Get(text, "routing")
    c.default_outbound = json.Get(routing, "defaultOutbound")
    rules := _items(json.Get(routing, "rules"))
    defer rules.Free()
    repeat rules.Len() in i:
        raw := rules[i]
        c.rules.Push(RuleConfig { domain = _strs(json.Get(raw, "domain")), ip = _strs(json.Get(raw, "ip")), port = json.Get(raw, "port"), outbound_tag = json.Get(raw, "outboundTag") })
    end
    if c.default_outbound.Len() == 0 and c.outbounds.Len() > 0:
        c.default_outbound = c.outbounds[0].tag
    end
    ret c
end

@en "LoadConfig"
@fa "بارگذاری پیکربندی"
pub func LoadConfig(path: str): Config:
    text := io.ReadFile(path)
    if text.Len() == 0:
        mut c := Config {}
        c.errors.Push("cannot read " + path)
        ret c
    end
    ret ParseConfig(text)
end

@en "ValidateConfig"
@fa "اعتبارسنجی پیکربندی"
pub func ValidateConfig(c: Config): Vector<str>:
    mut errs := Vector {} as Vector<str>
    repeat c.errors.Len() in i:
        errs.Push(c.errors[i])
    end
    if c.outbounds.Len() == 0: errs.Push("no outbounds") end
    repeat c.inbounds.Len() in i:
        ib := c.inbounds[i]
        if ib.protocol.Len() == 0: errs.Push("inbound " + i + " has no protocol") end
        if not _is_port(ib.port): errs.Push("inbound " + i + " has a bad port " + ib.port) end
        repeat i in j:
            if c.inbounds[j].tag.Len() > 0 and c.inbounds[j].tag == ib.tag:
                errs.Push("duplicate inbound tag " + ib.tag)
            end
        end
    end
    repeat c.outbounds.Len() in i:
        ob := c.outbounds[i]
        if ob.tag.Len() == 0: errs.Push("outbound " + i + " has no tag") end
        if ob.protocol.Len() == 0: errs.Push("outbound " + i + " has no protocol") end
        repeat i in j:
            if c.outbounds[j].tag == ob.tag and ob.tag.Len() > 0:
                errs.Push("duplicate outbound tag " + ob.tag)
            end
        end
    end
    repeat c.rules.Len() in i:
        r := c.rules[i]
        if not _tag_exists(c, r.outbound_tag):
            errs.Push("rule " + i + " points to unknown outbound '" + r.outbound_tag + "'")
        end
        if r.domain.Len() == 0 and r.ip.Len() == 0 and r.port.Len() == 0:
            errs.Push("rule " + i + " has no conditions")
        end
        if r.port.Len() > 0:
            mut probe := NewRule("x")
            if not RulePort(probe, r.port): errs.Push("rule " + i + " has a bad port '" + r.port + "'") end
        end
        repeat r.ip.Len() in k:
            mut probe := NewRule("x")
            if not RuleIpSpec(probe, r.ip[k]): errs.Push("rule " + i + " has a bad ip '" + r.ip[k] + "'") end
        end
        repeat r.domain.Len() in k:
            mut probe := NewRule("x")
            if not RuleDomainSpec(probe, r.domain[k]): errs.Push("rule " + i + " has a bad domain '" + r.domain[k] + "'") end
        end
    end
    if c.default_outbound.Len() > 0 and not _tag_exists(c, c.default_outbound):
        errs.Push("default outbound '" + c.default_outbound + "' does not exist")
    end
    ret errs
end

@en "ConfigToJson"
@fa "پیکربندی به جیسون"
pub func ConfigToJson(c: Config): str:
    mut top := Vector {} as Vector<str>
    defer top.Free()
    mut log := Vector {} as Vector<str>
    defer log.Free()
    log.Push(json.Member("loglevel", c.log_level))
    top.Push(json.MemberRaw("log", json.Object(log)))
    mut ins := Vector {} as Vector<str>
    defer ins.Free()
    repeat c.inbounds.Len() in i:
        ib := c.inbounds[i]
        mut m := Vector {} as Vector<str>
        _member_str(m, "tag", ib.tag)
        m.Push(json.Member("listen", ib.listen))
        m.Push(json.MemberInt("port", ib.port as i64))
        m.Push(json.Member("protocol", ib.protocol))
        if ib.settings.Len() > 0: m.Push(json.MemberRaw("settings", ib.settings)) end
        if ib.stream_settings.Len() > 0: m.Push(json.MemberRaw("streamSettings", ib.stream_settings)) end
        ins.Push(json.Object(m))
        m.Free()
    end
    top.Push(json.MemberRaw("inbounds", json.Array(ins)))
    mut outs := Vector {} as Vector<str>
    defer outs.Free()
    repeat c.outbounds.Len() in i:
        ob := c.outbounds[i]
        mut m := Vector {} as Vector<str>
        m.Push(json.Member("tag", ob.tag))
        m.Push(json.Member("protocol", ob.protocol))
        if ob.settings.Len() > 0: m.Push(json.MemberRaw("settings", ob.settings)) end
        if ob.stream_settings.Len() > 0: m.Push(json.MemberRaw("streamSettings", ob.stream_settings)) end
        outs.Push(json.Object(m))
        m.Free()
    end
    top.Push(json.MemberRaw("outbounds", json.Array(outs)))
    mut rules := Vector {} as Vector<str>
    defer rules.Free()
    repeat c.rules.Len() in i:
        r := c.rules[i]
        mut m := Vector {} as Vector<str>
        m.Push(json.Member("type", "field"))
        if r.domain.Len() > 0: m.Push(json.MemberRaw("domain", _arr(r.domain))) end
        if r.ip.Len() > 0: m.Push(json.MemberRaw("ip", _arr(r.ip))) end
        _member_str(m, "port", r.port)
        m.Push(json.Member("outboundTag", r.outbound_tag))
        rules.Push(json.Object(m))
        m.Free()
    end
    mut routing := Vector {} as Vector<str>
    defer routing.Free()
    _member_str(routing, "defaultOutbound", c.default_outbound)
    routing.Push(json.MemberRaw("rules", json.Array(rules)))
    top.Push(json.MemberRaw("routing", json.Object(routing)))
    ret json.Object(top)
end

@en "BuildRouter"
@fa "ساخت مسیریاب"
pub func BuildRouter(c: Config): Router:
    mut rt := NewRouter(c.default_outbound)
    repeat c.rules.Len() in i:
        r := c.rules[i]
        mut rule := NewRule(r.outbound_tag)
        repeat r.domain.Len() in k:
            RuleDomainSpec(rule, r.domain[k])
        end
        repeat r.ip.Len() in k:
            RuleIpSpec(rule, r.ip[k])
        end
        if r.port.Len() > 0: RulePort(rule, r.port) end
        RouterAdd(rt, rule)
    end
    ret rt
end

@en "OutboundFromNode"
@fa "خروجی از گره"
pub func OutboundFromNode(n: Node, tag: str): OutboundConfig:
    mut o := OutboundConfig { tag = tag, protocol = n.protocol }
    mut ep := Vector {} as Vector<str>
    defer ep.Free()
    ep.Push(json.Member("address", n.host))
    ep.Push(json.MemberInt("port", n.port as i64))
    if n.protocol == "vmess" or n.protocol == "vless":
        mut u := Vector {} as Vector<str>
        defer u.Free()
        u.Push(json.Member("id", n.uuid))
        if n.protocol == "vmess":
            u.Push(json.MemberInt("alterId", n.alter_id as i64))
            mut sec := n.method
            if sec.Len() == 0: sec = "auto" end
            u.Push(json.Member("security", sec))
        else:
            mut enc := n.encryption
            if enc.Len() == 0: enc = "none" end
            u.Push(json.Member("encryption", enc))
            _member_str(u, "flow", n.flow)
        end
        mut ul := Vector {} as Vector<str>
        defer ul.Free()
        ul.Push(json.Object(u))
        ep.Push(json.MemberRaw("users", json.Array(ul)))
        mut vn := Vector {} as Vector<str>
        defer vn.Free()
        vn.Push(json.Object(ep))
        mut s := Vector {} as Vector<str>
        defer s.Free()
        s.Push(json.MemberRaw("vnext", json.Array(vn)))
        o.settings = json.Object(s)
    else:
        if n.protocol == "trojan":
            ep.Push(json.Member("password", n.password))
        else:
            ep.Push(json.Member("method", n.method))
            ep.Push(json.Member("password", n.password))
            _member_str(ep, "plugin", n.plugin)
        end
        mut sv := Vector {} as Vector<str>
        defer sv.Free()
        sv.Push(json.Object(ep))
        mut s := Vector {} as Vector<str>
        defer s.Free()
        s.Push(json.MemberRaw("servers", json.Array(sv)))
        o.settings = json.Object(s)
    end
    mut st := Vector {} as Vector<str>
    defer st.Free()
    st.Push(json.Member("network", n.network))
    mut sec := n.security
    if sec.Len() == 0 and n.tls: sec = "tls" end
    if sec.Len() > 0 and sec != "none": st.Push(json.Member("security", sec)) end
    if sec == "tls":
        mut t := Vector {} as Vector<str>
        defer t.Free()
        _member_str(t, "serverName", n.sni)
        _member_str(t, "fingerprint", n.fingerprint)
        if n.alpn.Len() > 0: t.Push(json.MemberRaw("alpn", _csv_to_array(n.alpn))) end
        if n.allow_insecure: t.Push(json.MemberRaw("allowInsecure", "true")) end
        st.Push(json.MemberRaw("tlsSettings", json.Object(t)))
    else sec == "reality":
        mut t := Vector {} as Vector<str>
        defer t.Free()
        _member_str(t, "serverName", n.sni)
        _member_str(t, "fingerprint", n.fingerprint)
        _member_str(t, "publicKey", n.public_key)
        _member_str(t, "shortId", n.short_id)
        _member_str(t, "spiderX", n.spider_x)
        st.Push(json.MemberRaw("realitySettings", json.Object(t)))
    end
    if n.network == "ws" or n.network == "httpupgrade":
        mut w := Vector {} as Vector<str>
        defer w.Free()
        _member_str(w, "path", n.path)
        if n.host_header.Len() > 0:
            mut h := Vector {} as Vector<str>
            defer h.Free()
            h.Push(json.Member("Host", n.host_header))
            w.Push(json.MemberRaw("headers", json.Object(h)))
        end
        st.Push(json.MemberRaw(n.network == "ws" ? "wsSettings" : "httpupgradeSettings", json.Object(w)))
    else n.network == "grpc":
        mut g := Vector {} as Vector<str>
        defer g.Free()
        _member_str(g, "serviceName", n.service_name)
        if n.grpc_mode == "multi": g.Push(json.MemberRaw("multiMode", "true")) end
        st.Push(json.MemberRaw("grpcSettings", json.Object(g)))
    end
    o.stream_settings = json.Object(st)
    ret o
end

@en "NodeFromOutbound"
@fa "گره از خروجی"
pub func NodeFromOutbound(o: OutboundConfig): Node:
    mut n := Node { protocol = o.protocol, remark = o.tag }
    mut ep := ""
    if o.protocol == "vmess" or o.protocol == "vless":
        vn := _items(json.Get(o.settings, "vnext"))
        defer vn.Free()
        if vn.Len() == 0:
            n.error = "no vnext"
            ret n
        end
        ep = vn[0]
        us := _items(json.Get(ep, "users"))
        defer us.Free()
        if us.Len() == 0:
            n.error = "no users"
            ret n
        end
        n.uuid = json.Get(us[0], "id")
        n.alter_id = json.Get(us[0], "alterId").ToInt()
        if o.protocol == "vmess":
            n.method = json.Get(us[0], "security")
        else:
            n.encryption = json.Get(us[0], "encryption")
            n.flow = json.Get(us[0], "flow")
        end
    else:
        sv := _items(json.Get(o.settings, "servers"))
        defer sv.Free()
        if sv.Len() == 0:
            n.error = "no servers"
            ret n
        end
        ep = sv[0]
        n.password = json.Get(ep, "password")
        n.method = json.Get(ep, "method")
        n.plugin = json.Get(ep, "plugin")
    end
    n.host = json.Get(ep, "address")
    n.port = json.Get(ep, "port").ToInt()
    ss := o.stream_settings
    n.network = json.Get(ss, "network")
    if n.network.Len() == 0: n.network = "tcp" end
    n.security = json.Get(ss, "security")
    n.tls = n.security == "tls" or n.security == "reality"
    mut ts := json.Get(ss, "tlsSettings")
    if n.security == "reality": ts = json.Get(ss, "realitySettings") end
    n.sni = json.Get(ts, "serverName")
    n.fingerprint = json.Get(ts, "fingerprint")
    n.alpn = _array_to_csv(json.Get(ts, "alpn"))
    n.allow_insecure = json.Get(ts, "allowInsecure") == "true"
    n.public_key = json.Get(ts, "publicKey")
    n.short_id = json.Get(ts, "shortId")
    n.spider_x = json.Get(ts, "spiderX")
    mut ws := json.Get(ss, "wsSettings")
    if n.network == "httpupgrade": ws = json.Get(ss, "httpupgradeSettings") end
    n.path = json.Get(ws, "path")
    n.host_header = json.Get(json.Get(ws, "headers"), "Host")
    n.service_name = json.Get(json.Get(ss, "grpcSettings"), "serviceName")
    if json.Get(json.Get(ss, "grpcSettings"), "multiMode") == "true": n.grpc_mode = "multi" end
    n.valid = n.host.Len() > 0 and _is_port(n.port)
    if not n.valid: n.error = "bad address" end
    ret n
end

@en "ConfigFromNodes"
@fa "پیکربندی از گره‌ها"
pub func ConfigFromNodes(nodes: Vector<Node>, listen_port: int): Config:
    mut c := Config {}
    c.inbounds.Push(InboundConfig { tag = "mixed-in", protocol = "mixed", port = listen_port })
    repeat nodes.Len() in i:
        c.outbounds.Push(OutboundFromNode(nodes[i], "proxy-" + (i + 1)))
    end
    c.outbounds.Push(OutboundConfig { tag = "direct", protocol = "freedom" })
    c.outbounds.Push(OutboundConfig { tag = "block", protocol = "blackhole" })
    if nodes.Len() > 0:
        c.default_outbound = "proxy-1"
    else:
        c.default_outbound = "direct"
    end
    mut r := RuleConfig { outbound_tag = "direct" }
    r.domain.Push("suffix:ir")
    r.ip.Push("geoip:private")
    c.rules.Push(r)
    ret c
end
