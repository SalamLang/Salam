@en "net/tunnel"
@fa "تونل"
package tunnel

import str
import encoding
import encoding.json

@en "Node"
@fa "گره"
pub struct Node:
    @en "valid"
    @fa "معتبر"
    pub valid: bool = false
    @en "error"
    @fa "خطا"
    pub error: str = ""
    @en "protocol"
    @fa "پروتکل"
    pub protocol: str = ""
    @en "remark"
    @fa "توضیح"
    pub remark: str = ""
    @en "host"
    @fa "میزبان"
    pub host: str = ""
    @en "port"
    @fa "درگاه"
    pub port: int = 0
    @en "uuid"
    @fa "شناسه"
    pub uuid: str = ""
    @en "password"
    @fa "گذرواژه"
    pub password: str = ""
    @en "method"
    @fa "روش"
    pub method: str = ""
    @en "alter_id"
    @fa "شناسه جایگزین"
    pub alter_id: int = 0
    @en "flow"
    @fa "جریان"
    pub flow: str = ""
    @en "encryption"
    @fa "رمزگذاری"
    pub encryption: str = ""
    @en "network"
    @fa "شبکه"
    pub network: str = "tcp"
    @en "header_type"
    @fa "نوع سرآیند"
    pub header_type: str = ""
    @en "tls"
    @fa "تی ال اس"
    pub tls: bool = false
    @en "security"
    @fa "امنیت"
    pub security: str = ""
    @en "sni"
    @fa "نام سرور"
    pub sni: str = ""
    @en "alpn"
    @fa "پروتکل برنامه"
    pub alpn: str = ""
    @en "fingerprint"
    @fa "اثر انگشت"
    pub fingerprint: str = ""
    @en "path"
    @fa "مسیر"
    pub path: str = ""
    @en "host_header"
    @fa "سرآیند میزبان"
    pub host_header: str = ""
    @en "service_name"
    @fa "نام سرویس"
    pub service_name: str = ""
    @en "grpc_mode"
    @fa "حالت جی آر پی سی"
    pub grpc_mode: str = ""
    @en "public_key"
    @fa "کلید عمومی"
    pub public_key: str = ""
    @en "short_id"
    @fa "شناسه کوتاه"
    pub short_id: str = ""
    @en "spider_x"
    @fa "مسیر عنکبوتی"
    pub spider_x: str = ""
    @en "plugin"
    @fa "افزونه"
    pub plugin: str = ""
    @en "allow_insecure"
    @fa "اجازه ناامن"
    pub allow_insecure: bool = false
end

@en "Subscription"
@fa "اشتراک"
pub struct Subscription:
    @en "nodes"
    @fa "گره‌ها"
    pub nodes: Vector<Node> = Vector {}
    @en "skipped"
    @fa "ردشده"
    pub skipped: int = 0
end

func _b64val(c: int): int:
    if c >= 65 and c <= 90: ret c - 65 end
    if c >= 97 and c <= 122: ret c - 71 end
    if c >= 48 and c <= 57: ret c + 4 end
    if c == 43 or c == 45: ret 62 end
    if c == 47 or c == 95: ret 63 end
    ret 0 - 1
end

func _hexv(c: int): int:
    if c >= 48 and c <= 57: ret c - 48 end
    if c >= 97 and c <= 102: ret c - 87 end
    if c >= 65 and c <= 70: ret c - 55 end
    ret 0 - 1
end

func _digits(s: str): bool:
    n := s.Len()
    if n == 0: ret false end
    p := s as u8*
    repeat n in i:
        c := p[i] as int
        if c < 48 or c > 57: ret false end
    end
    ret true
end

func _qget(q: str, key: str): str:
    if q.Len() == 0: ret "" end
    parts := q.Split("&")
    defer parts.Free()
    repeat parts.Len() in i:
        part := parts[i]
        eqi := part.Find("=")
        if eqi < 0: continue end
        if part.Substr(0, eqi) == key:
            ret PctDecode(part.Substr(eqi + 1, part.Len() - eqi - 1))
        end
    end
    ret ""
end

func _qadd(out &: Vector<str>, key: str, value: str):
    if value.Len() == 0: ret end
    out.Push(key + "=" + PctEncode(value))
end

func _split_hostport(hp: str, n &: Node): bool:
    a := ParseAddr(hp)
    if not a.valid: ret false end
    n.host = a.host
    n.port = a.port
    ret true
end

func _fill_stream(n &: Node, q: str):
    mut net := _qget(q, "type")
    if net.Len() == 0: net = "tcp" end
    n.network = net
    sec := _qget(q, "security")
    if sec.Len() > 0: n.security = sec end
    if n.security == "tls" or n.security == "reality" or n.security == "xtls": n.tls = true end
    n.sni = _qget(q, "sni")
    if n.sni.Len() == 0: n.sni = _qget(q, "peer") end
    n.alpn = _qget(q, "alpn")
    n.fingerprint = _qget(q, "fp")
    n.path = _qget(q, "path")
    n.host_header = _qget(q, "host")
    n.header_type = _qget(q, "headerType")
    n.service_name = _qget(q, "serviceName")
    if net == "grpc" and _qget(q, "mode") == "multi": n.grpc_mode = "multi" end
    n.public_key = _qget(q, "pbk")
    n.short_id = _qget(q, "sid")
    n.spider_x = _qget(q, "spx")
    n.flow = _qget(q, "flow")
    ai := _qget(q, "allowInsecure")
    n.allow_insecure = ai == "1" or ai == "true"
end

func _stream_query(n: Node): Vector<str>:
    mut out := Vector {} as Vector<str>
    if n.protocol == "vless":
        mut enc := n.encryption
        if enc.Len() == 0: enc = "none" end
        _qadd(out, "encryption", enc)
    end
    mut sec := n.security
    if sec.Len() == 0 and n.tls: sec = "tls" end
    if sec.Len() == 0 and n.protocol == "vless": sec = "none" end
    _qadd(out, "security", sec)
    _qadd(out, "sni", n.sni)
    _qadd(out, "fp", n.fingerprint)
    _qadd(out, "alpn", n.alpn)
    _qadd(out, "type", n.network)
    _qadd(out, "headerType", n.header_type)
    _qadd(out, "host", n.host_header)
    _qadd(out, "path", n.path)
    _qadd(out, "serviceName", n.service_name)
    if n.network == "grpc" and n.grpc_mode == "multi": _qadd(out, "mode", "multi") end
    _qadd(out, "flow", n.flow)
    _qadd(out, "pbk", n.public_key)
    _qadd(out, "sid", n.short_id)
    _qadd(out, "spx", n.spider_x)
    if n.allow_insecure: _qadd(out, "allowInsecure", "1") end
    ret out
end

func _hostport(n: Node): str:
    if n.host.Includes(":"): ret "[" + n.host + "]:" + n.port end
    ret n.host + ":" + n.port
end

func _split_link(link: str, scheme_len: int, frag &: str, query &: str): str:
    mut rest := link.Substr(scheme_len, link.Len() - scheme_len)
    hash := rest.Find("#")
    frag = ""
    if hash >= 0:
        frag = PctDecode(rest.Substr(hash + 1, rest.Len() - hash - 1))
        rest = rest.Substr(0, hash)
    end
    query = ""
    qm := rest.Find("?")
    if qm >= 0:
        query = rest.Substr(qm + 1, rest.Len() - qm - 1)
        rest = rest.Substr(0, qm)
    end
    if rest.EndsWith("/"): rest = rest.Substr(0, rest.Len() - 1) end
    ret rest
end

func _parse_url_style(link: str, scheme: str): Node:
    mut n := Node { protocol = scheme }
    mut frag := ""
    mut query := ""
    rest := _split_link(link, scheme.Len() + 3, frag, query)
    at := str.LastIndex(rest, "@")
    if at <= 0:
        n.error = "missing credentials"
        ret n
    end
    cred := PctDecode(rest.Substr(0, at))
    if not _split_hostport(rest.Substr(at + 1, rest.Len() - at - 1), n):
        n.error = "bad host or port"
        ret n
    end
    n.remark = frag
    if scheme == "vless":
        n.uuid = cred
        n.encryption = _qget(query, "encryption")
        if n.encryption.Len() == 0: n.encryption = "none" end
    else:
        n.password = cred
        n.security = "tls"
        n.tls = true
    end
    _fill_stream(n, query)
    if scheme == "trojan" and _qget(query, "security").Len() == 0:
        n.security = "tls"
        n.tls = true
    end
    if scheme == "vless" and n.security.Len() == 0: n.security = "none" end
    n.valid = cred.Len() > 0
    if not n.valid: n.error = "empty credentials" end
    ret n
end

func _parse_vmess(link: str): Node:
    mut n := Node { protocol = "vmess" }
    mut body := str.Trim(link.Substr(8, link.Len() - 8))
    mut frag := ""
    hash := body.Find("#")
    if hash >= 0:
        frag = PctDecode(body.Substr(hash + 1, body.Len() - hash - 1))
        body = body.Substr(0, hash)
    end
    js := B64Decode(body)
    if js.Len() == 0 or not json.Valid(js):
        n.error = "bad vmess payload"
        ret n
    end
    n.host = json.Get(js, "add")
    pt := json.Get(js, "port")
    if not _digits(pt):
        n.error = "bad port"
        ret n
    end
    n.port = pt.ToInt()
    n.uuid = json.Get(js, "id")
    n.alter_id = json.Get(js, "aid").ToInt()
    n.method = json.Get(js, "scy")
    if n.method.Len() == 0: n.method = "auto" end
    n.network = json.Get(js, "net")
    if n.network.Len() == 0: n.network = "tcp" end
    n.header_type = json.Get(js, "type")
    n.host_header = json.Get(js, "host")
    n.path = json.Get(js, "path")
    n.sni = json.Get(js, "sni")
    n.alpn = json.Get(js, "alpn")
    n.fingerprint = json.Get(js, "fp")
    tlsv := json.Get(js, "tls")
    n.tls = tlsv == "tls" or tlsv == "true" or tlsv == "1"
    if n.tls: n.security = "tls" else:
        n.security = "none"
    end
    if n.network == "grpc":
        n.service_name = n.path
        if n.header_type == "multi": n.grpc_mode = "multi" end
    end
    n.remark = json.Get(js, "ps")
    if n.remark.Len() == 0: n.remark = frag end
    n.valid = n.host.Len() > 0 and n.uuid.Len() > 0
    if not n.valid: n.error = "missing address or id" end
    ret n
end

func _parse_ss(link: str): Node:
    mut n := Node { protocol = "ss", network = "tcp" }
    mut frag := ""
    mut query := ""
    rest := _split_link(link, 5, frag, query)
    n.remark = frag
    mut userinfo := ""
    mut hostport := ""
    at := str.LastIndex(rest, "@")
    if at > 0:
        userinfo = rest.Substr(0, at)
        hostport = rest.Substr(at + 1, rest.Len() - at - 1)
        if not userinfo.Includes(":"):
            userinfo = B64Decode(userinfo)
        else:
            userinfo = PctDecode(userinfo)
        end
    else:
        dec := B64Decode(rest)
        a2 := str.LastIndex(dec, "@")
        if a2 <= 0:
            n.error = "bad shadowsocks payload"
            ret n
        end
        userinfo = dec.Substr(0, a2)
        hostport = dec.Substr(a2 + 1, dec.Len() - a2 - 1)
    end
    colon := userinfo.Find(":")
    if colon <= 0:
        n.error = "bad method and password"
        ret n
    end
    n.method = userinfo.Substr(0, colon)
    n.password = userinfo.Substr(colon + 1, userinfo.Len() - colon - 1)
    if not _split_hostport(hostport, n):
        n.error = "bad host or port"
        ret n
    end
    n.plugin = _qget(query, "plugin")
    n.valid = true
    ret n
end

@en "PctDecode"
@fa "رمزگشایی درصدی"
pub func PctDecode(s: str): str:
    n := s.Len()
    p := s as u8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < n:
        c := p[i] as int
        if c == 37 and i + 2 < n and _hexv(p[i + 1] as int) >= 0 and _hexv(p[i + 2] as int) >= 0:
            str.BufAppendChar(sb, _hexv(p[i + 1] as int) * 16 + _hexv(p[i + 2] as int))
            i += 3
        else:
            str.BufAppendChar(sb, c)
            i++
        end
    end
    ret str.BufStr(sb)
end

@en "PctEncode"
@fa "رمزگذاری درصدی"
pub func PctEncode(s: str): str:
    n := s.Len()
    p := s as u8*
    hex := "0123456789ABCDEF"
    hp := hex as u8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n in i:
        c := p[i] as int
        keep := (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95 or c == 46 or c == 126
        if keep:
            str.BufAppendChar(sb, c)
        else:
            str.BufAppendChar(sb, 37)
            str.BufAppendChar(sb, hp[c / 16] as int)
            str.BufAppendChar(sb, hp[c % 16] as int)
        end
    end
    ret str.BufStr(sb)
end

@en "B64Decode"
@fa "رمزگشایی پایه۶۴"
pub func B64Decode(s: str): str:
    n := s.Len()
    p := s as u8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut acc := 0
    mut bits := 0
    repeat n in i:
        c := p[i] as int
        if c == 61 or c == 32 or c == 10 or c == 13 or c == 9: continue end
        v := _b64val(c)
        if v < 0: ret "" end
        acc = ((acc << 6) | v) & 0xFFFFFF
        bits += 6
        if bits >= 8:
            bits -= 8
            str.BufAppendChar(sb, (acc >> bits) & 255)
        end
    end
    ret str.BufStr(sb)
end

@en "B64EncodeUrl"
@fa "رمزگذاری پایه۶۴ نشانی"
pub func B64EncodeUrl(s: str): str:
    std := encoding.Base64Encode(s)
    n := std.Len()
    p := std as u8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n in i:
        c := p[i] as int
        if c == 43:
            str.BufAppendChar(sb, 45)
        else c == 47:
            str.BufAppendChar(sb, 95)
        else c == 61:
            continue
        else:
            str.BufAppendChar(sb, c)
        end
    end
    ret str.BufStr(sb)
end

@en "ParseLink"
@fa "تجزیه لینک"
pub func ParseLink(link: str): Node:
    l := str.Trim(link)
    if l.StartsWith("vmess://"): ret _parse_vmess(l) end
    if l.StartsWith("vless://"): ret _parse_url_style(l, "vless") end
    if l.StartsWith("trojan://"): ret _parse_url_style(l, "trojan") end
    if l.StartsWith("ss://"): ret _parse_ss(l) end
    ret Node { error = "unsupported scheme" }
end

@en "NodeToLink"
@fa "گره به لینک"
pub func NodeToLink(n: Node): str:
    mut tag := ""
    if n.remark.Len() > 0: tag = "#" + PctEncode(n.remark) end
    if n.protocol == "vmess":
        mut m := Vector {} as Vector<str>
        defer m.Free()
        m.Push(json.Member("v", "2"))
        m.Push(json.Member("ps", n.remark))
        m.Push(json.Member("add", n.host))
        m.Push(json.Member("port", "" + n.port))
        m.Push(json.Member("id", n.uuid))
        m.Push(json.Member("aid", "" + n.alter_id))
        mut scy := n.method
        if scy.Len() == 0: scy = "auto" end
        m.Push(json.Member("scy", scy))
        m.Push(json.Member("net", n.network))
        mut htype := n.header_type.Len() > 0 ? n.header_type : "none"
        if n.network == "grpc" and n.grpc_mode == "multi": htype = "multi" end
        m.Push(json.Member("type", htype))
        m.Push(json.Member("host", n.host_header))
        mut pth := n.path
        if n.network == "grpc" and pth.Len() == 0: pth = n.service_name end
        m.Push(json.Member("path", pth))
        m.Push(json.Member("tls", n.tls ? "tls" : ""))
        m.Push(json.Member("sni", n.sni))
        m.Push(json.Member("alpn", n.alpn))
        m.Push(json.Member("fp", n.fingerprint))
        ret "vmess://" + encoding.Base64Encode(json.Object(m))
    end
    if n.protocol == "ss":
        ui := B64EncodeUrl(n.method + ":" + n.password)
        mut q := ""
        if n.plugin.Len() > 0: q = "/?plugin=" + PctEncode(n.plugin) end
        ret "ss://" + ui + "@" + _hostport(n) + q + tag
    end
    q := _stream_query(n)
    defer q.Free()
    mut qs := ""
    repeat q.Len() in i:
        if i > 0: qs += "&" end
        qs += q[i]
    end
    mut cred := n.uuid
    if n.protocol == "trojan": cred = PctEncode(n.password) end
    if qs.Len() > 0: qs = "?" + qs end
    ret n.protocol + "://" + cred + "@" + _hostport(n) + qs + tag
end

@en "ParseSubscription"
@fa "تجزیه اشتراک"
pub func ParseSubscription(text: str): Subscription:
    mut sub := Subscription {}
    mut body := str.Trim(text)
    if not body.Includes("://"):
        body = B64Decode(body)
    end
    body = str.Replace(body, "\r", "")
    lines := body.Split("\n")
    defer lines.Free()
    repeat lines.Len() in i:
        line := str.Trim(lines[i])
        if line.Len() == 0 or line.StartsWith("#"): continue end
        n := ParseLink(line)
        if n.valid:
            sub.nodes.Push(n)
        else:
            sub.skipped++
        end
    end
    ret sub
end

@en "NodeAddr"
@fa "نشانی گره"
pub func NodeAddr(n: Node): Addr:
    ret NewAddr(n.host, n.port)
end

@en "NodeLabel"
@fa "برچسب گره"
pub func NodeLabel(n: Node): str:
    if n.remark.Len() > 0: ret n.remark end
    ret n.protocol + "://" + _hostport(n)
end
