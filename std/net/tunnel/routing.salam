@en "net/tunnel"
@fa "تونل"
package tunnel

@en "RouterDialer"
@fa "شماره‌گیر مسیریاب"
pub struct RouterDialer:
    @en "router"
    @fa "مسیریاب"
    pub router: Router = Router {}
    @en "tags"
    @fa "برچسب‌ها"
    pub tags: Vector<str> = Vector {}
    @en "dialers"
    @fa "شماره‌گیرها"
    pub dialers: Vector<dyn Dialer> = Vector {}
    @en "last_tag"
    @fa "آخرین برچسب"
    pub last_tag: str = ""

    @en "Pick"
    @fa "گزینش"
    pub func Pick(tag: str): dyn Dialer:
        repeat this.tags.Len() in i:
            if this.tags[i] == tag: ret this.dialers[i] end
        end
        if tag == "direct" or tag == "freedom": ret DirectDialer {} end
        ret BlockDialer {}
    end

    @en "Dial"
    @fa "اتصال"
    pub func Dial(target: Addr): dyn Stream:
        tag := this.router.Match(target)
        this.last_tag = tag
        d := this.Pick(tag)
        ret d.Dial(target)
    end

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "router"
    end
end

@en "NewRouterDialer"
@fa "شماره‌گیر مسیریاب جدید"
pub func NewRouterDialer(router: Router): RouterDialer:
    ret RouterDialer { router = router }
end

@en "RouterDialerAdd"
@fa "افزودن به شماره‌گیر مسیریاب"
pub func RouterDialerAdd(rd &: RouterDialer, tag: str, d: dyn Dialer):
    rd.tags.Push(tag)
    rd.dialers.Push(d)
end

@en "BuildDialer"
@fa "ساخت شماره‌گیر"
pub func BuildDialer(c: Config): RouterDialer:
    mut rd := NewRouterDialer(BuildRouter(c))
    repeat c.outbounds.Len() in i:
        RouterDialerAdd(rd, c.outbounds[i].tag, CreateOutbound(c.outbounds[i]))
    end
    ret rd
end
