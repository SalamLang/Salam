@en "net/tunnel"
@fa "تونل"
package tunnel

import mem

if SALAM_OS_WINDOWS:
    extern:
        func _beginthread(start: void *, stack: u32, arg: void *): usize
    end
else:
    extern:
        func pthread_create(thread: void *, attr: void *, start: void *, arg: void *): int
        func pthread_detach(thread: u64): int
    end
end

if SALAM_OS_WINDOWS:
    export:
        func salam_tunnel_go(fn: i64, arg: i64):
            _h := _beginthread(fn as void *, 0 as u32, arg as void *)
        end
    end
else:
    export:
        func salam_tunnel_go(fn: i64, arg: i64):
            t := mem.Allocate(8 as u64)
            if pthread_create(t, null, fn as void *, arg as void *) == 0:
                tp := t as i64 *
                pthread_detach(tp[0] as u64)
            end
            mem.Free(t)
        end
    end
end

@en "Go"
@fa "برو"
pub func Go(fn: i64, arg: void*):
    salam_tunnel_go(fn, arg as i64)
end
