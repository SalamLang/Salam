package vless

import mem
import net.transport
import net.tunnel

struct _Adapter:
    pub c: Conn = Conn {}

    pub func Read(max: int): str:
        buf := mem.Allocate((max + 1) as u64)
        n := _read(this.c, buf, max)
        if n <= 0:
            mem.Free(buf)
            ret ""
        end
        bp := buf as u8*
        bp[n] = 0 as u8
        ret buf as str
    end

    pub func ReadBytes(buf: void*, max: int): int:
        ret _read(this.c, buf, max)
    end

    pub func Write(data: str): int:
        if not _write(this.c, data as void*, data.len()):
            ret 0 - 1
        end
        ret data.len()
    end

    pub func WriteBytes(ptr: void*, n: int): int:
        if not _write(this.c, ptr, n):
            ret 0 - 1
        end
        ret n
    end

    pub func SetDeadline(millis: int):
        transport.SetReadTimeout(this.c.t, millis)
    end

    pub func Shutdown():
        transport.AsStream(this.c.t).Shutdown()
    end

    pub func CloseWrite():
        transport.AsStream(this.c.t).CloseWrite()
    end

    pub func Close():
        _close(this.c)
    end

    pub func Ok(): bool:
        ret this.c.ok
    end
end

func _read(c &: Conn, buf: void*, max: int): int:
    ret Read(c, buf, max)
end

func _write(c &: Conn, p: void*, n: int): bool:
    ret Write(c, p, n)
end

func _close(c &: Conn):
    Close(c)
end

@en "AsStream"
@fa "به عنوان جریان"
pub func AsStream(c: Conn): dyn tunnel.Stream:
    ret _Adapter { c = c }
end

@en "DialOver"
@fa "اتصال روی جریان"
pub func DialOver(s: dyn tunnel.Stream, uuid: str, flow: str, command: int, target: transport.Addr): Conn:
    ret Client(transport.FromStream(s, true), uuid, flow, command, target)
end

@en "AcceptOver"
@fa "پذیرش روی جریان"
pub func AcceptOver(s: dyn tunnel.Stream, users: Vector<User>): Conn:
    ret Accept(transport.FromStream(s, false), users)
end
