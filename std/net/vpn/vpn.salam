@en "net/vpn"
@fa "وی‌پی‌ان"
package vpn

import str
import encoding.json
import net.doh
import net.socks
import net.httpproxy
import net.trojan
import net.vless
import net.vmess
import net.shadowsocks
import net.transport
import net.tunnel

mut _opts := Options {}

@en "Options"
@fa "گزینه‌ها"
pub struct Options:
    @en "fragment"
    @fa "تکه‌تکه کردن"
    pub fragment: bool = false
    @en "fragment_min"
    @fa "کمینه تکه"
    pub fragment_min: int = 4
    @en "fragment_max"
    @fa "بیشینه تکه"
    pub fragment_max: int = 12
    @en "fragment_delay_ms"
    @fa "تاخیر تکه"
    pub fragment_delay_ms: int = 5
    @en "fragment_mode"
    @fa "حالت تکه تکه کردن"
    pub fragment_mode: str = "tcp"
    @en "fragment_sni"
    @fa "برش نام سرور"
    pub fragment_sni: bool = false
    @en "fragment_writes"
    @fa "شمار نوشتن های تکه شده"
    pub fragment_writes: int = 1
    @en "read_timeout_ms"
    @fa "مهلت بی کاری خواندن"
    pub read_timeout_ms: int = 0
    @en "write_timeout_ms"
    @fa "مهلت بی کاری نوشتن"
    pub write_timeout_ms: int = 0
    @en "use_doh"
    @fa "استفاده از دی او اچ"
    pub use_doh: bool = false
    @en "resolver"
    @fa "حل‌کننده"
    pub resolver: doh.Resolver = doh.Resolver {}
end

@en "DohResolver"
@fa "حل‌کننده دی او اچ"
pub struct DohResolver:
    @en "resolver"
    @fa "حل‌کننده"
    pub resolver: doh.Resolver = doh.Resolver {}
    @en "ipv6"
    @fa "نسخه شش"
    pub ipv6: bool = true

    @en "Lookup"
    @fa "جستجو"
    pub func Lookup(host: str): tunnel.LookupResult:
        mut out := tunnel.LookupResult {}
        a := doh.LookupA(this.resolver, host)
        repeat a.Len() in i:
            out.ips.push(a[i])
        end
        if this.ipv6:
            b := doh.LookupAAAA(this.resolver, host)
            repeat b.Len() in i:
                out.ips.push(b[i])
            end
        end
        ret out
    end
end

@en "TransportDialer"
@fa "شماره‌گیر انتقال"
pub struct TransportDialer:
    @en "settings"
    @fa "تنظیمات"
    pub settings: transport.Settings = transport.Settings {}

    @en "Dial"
    @fa "اتصال"
    pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
        c := _connect(target.host, target.port, this.settings)
        if not transport.Ok(c): ret tunnel.ClosedStream {} end
        ret transport.AsStream(c)
    end

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "transport"
    end
end

@en "VlessDialer"
@fa "شماره‌گیر وی‌لس"
pub struct VlessDialer:
    @en "node"
    @fa "گره"
    pub node: tunnel.Node = tunnel.Node {}

    @en "Dial"
    @fa "اتصال"
    pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
        t := _connect(this.node.host, this.node.port, NodeSettings(this.node))
        if not transport.Ok(t): ret tunnel.ClosedStream {} end
        c := vless.Client(t, this.node.uuid, this.node.flow, vless.CmdTCP, transport.NewAddr(target.host, target.port))
        if not c.ok: ret tunnel.ClosedStream {} end
        ret vless.AsStream(c)
    end

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "vless"
    end
end

@en "VmessDialer"
@fa "شماره‌گیر وی‌مس"
pub struct VmessDialer:
    @en "node"
    @fa "گره"
    pub node: tunnel.Node = tunnel.Node {}

    @en "Dial"
    @fa "اتصال"
    pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
        t := _connect(this.node.host, this.node.port, NodeSettings(this.node))
        if not transport.Ok(t): ret tunnel.ClosedStream {} end
        sec := _vmess_security(this.node.method)
        c := vmess.Client(t, this.node.uuid, sec, vmess.DefaultOption(sec), vmess.CmdTCP, transport.NewAddr(target.host, target.port))
        if not c.ok: ret tunnel.ClosedStream {} end
        ret vmess.AsStream(c)
    end

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "vmess"
    end
end

@en "SsDialer"
@fa "شماره‌گیر شدوساکس"
pub struct SsDialer:
    @en "node"
    @fa "گره"
    pub node: tunnel.Node = tunnel.Node {}

    @en "Dial"
    @fa "اتصال"
    pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
        cfg := shadowsocks.ToConfig(shadowsocks.Uri { host = _resolve(this.node.host), port = this.node.port, method = this.node.method, password = this.node.password, plugin = this.node.plugin })
        c := shadowsocks.Dial(cfg, target.host, target.port)
        if not shadowsocks.Ok(c): ret tunnel.ClosedStream {} end
        ret shadowsocks.AsStream(c)
    end

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "shadowsocks"
    end
end

@en "OutMaker"
@fa "خروجی‌ساز"
pub struct OutMaker:
    @en "proto"
    @fa "پروتکل"
    pub proto: str = ""

    @en "Protocol"
    @fa "پروتکل"
    pub func Protocol(): str:
        ret this.proto
    end

    @en "Make"
    @fa "ساخت"
    pub func Make(cfg: tunnel.OutboundConfig): dyn tunnel.Dialer:
        ret DialerFromNode(tunnel.NodeFromOutbound(cfg))
    end
end

@en "VlessInbound"
@fa "درون‌سو وی‌لس"
pub struct VlessInbound:
    @en "users"
    @fa "کاربران"
    pub users: Vector<vless.User> = Vector {}

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "vless"
    end

    @en "Handshake"
    @fa "دست‌دهی"
    pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
        c := vless.AcceptOver(s, this.users)
        if not c.ok: ret tunnel.Session { error = c.err } end
        ret tunnel.Session { ok = true, target = tunnel.NewAddr(c.req.addr.host, c.req.addr.port), protocol = "vless", user = c.user, wrapped = true, stream = vless.AsStream(c) }
    end

    @en "Reply"
    @fa "پاسخ"
    pub func Reply(_s: dyn tunnel.Stream, sess: tunnel.Session, ok: bool):
        if not ok: sess.stream.Close() end
    end
end

@en "VmessInbound"
@fa "درون‌سو وی‌مس"
pub struct VmessInbound:
    @en "users"
    @fa "کاربران"
    pub users: Vector<vmess.User> = Vector {}
    @en "replay"
    @fa "پالایه تکرار"
    pub replay: vmess.ReplayFilter = vmess.NewReplayFilter()

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "vmess"
    end

    @en "Handshake"
    @fa "دست‌دهی"
    pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
        c := vmess.AcceptOver(s, this.users, this.replay)
        if not c.ok: ret tunnel.Session { error = c.err } end
        ret tunnel.Session { ok = true, target = tunnel.NewAddr(c.req.addr.host, c.req.addr.port), protocol = "vmess", wrapped = true, stream = vmess.AsStream(c) }
    end

    @en "Reply"
    @fa "پاسخ"
    pub func Reply(_s: dyn tunnel.Stream, sess: tunnel.Session, ok: bool):
        if not ok: sess.stream.Close() end
    end
end

@en "SsInbound"
@fa "درون‌سو شدوساکس"
pub struct SsInbound:
    @en "server"
    @fa "کارساز"
    pub server: shadowsocks.Server = shadowsocks.Server {}

    @en "Name"
    @fa "نام"
    pub func Name(): str:
        ret "shadowsocks"
    end

    @en "Handshake"
    @fa "دست‌دهی"
    pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
        c := shadowsocks.AcceptOver(this.server, s)
        if not shadowsocks.Ok(c): ret tunnel.Session { error = "shadowsocks handshake failed" } end
        t := shadowsocks.TargetOf(c)
        ret tunnel.Session { ok = true, target = tunnel.NewAddr(t.host, t.port), protocol = "shadowsocks", wrapped = true, stream = shadowsocks.AsStream(c) }
    end

    @en "Reply"
    @fa "پاسخ"
    pub func Reply(_s: dyn tunnel.Stream, sess: tunnel.Session, ok: bool):
        if not ok: sess.stream.Close() end
    end
end

@en "InMaker"
@fa "درون‌سوساز"
pub struct InMaker:
    @en "proto"
    @fa "پروتکل"
    pub proto: str = ""

    @en "Protocol"
    @fa "پروتکل"
    pub func Protocol(): str:
        ret this.proto
    end

    @en "Make"
    @fa "ساخت"
    pub func Make(cfg: tunnel.InboundConfig): dyn tunnel.InboundProtocol:
        clients := json.Items(json.Get(cfg.settings, "clients"))
        defer clients.Free()
        if this.proto == "vless":
            mut p := VlessInbound {}
            repeat clients.Len() in i:
                p.users.push(vless.NewUser(json.Get(clients[i], "id"), json.Get(clients[i], "flow")))
            end
            ret p
        end
        if this.proto == "vmess":
            mut p := VmessInbound {}
            repeat clients.Len() in i:
                p.users.push(vmess.NewUser(json.Get(clients[i], "id")))
            end
            ret p
        end
        if this.proto == "trojan":
            mut p := trojan.NewInbound()
            repeat clients.Len() in i:
                trojan.InboundAddPassword(p, json.Get(clients[i], "password"))
            end
            ret p
        end
        if this.proto == "shadowsocks":
            mut obfs := ""
            plugin := json.Get(cfg.settings, "plugin")
            if plugin.Len() > 0:
                pl := shadowsocks.ParsePlugin(plugin)
                obfs = shadowsocks.PluginGet(pl, "obfs", "")
                shadowsocks.PluginFree(pl)
            end
            ret SsInbound { server = shadowsocks.ListenObfs(0, json.Get(cfg.settings, "method"), json.Get(cfg.settings, "password"), obfs) }
        end
        if this.proto == "socks": ret socks.NewInbound(socks.ServerConfig {}) end
        if this.proto == "http": ret httpproxy.NewInbound(httpproxy.ServerConfig {}) end
        mut m := tunnel.NewMixed()
        tunnel.MixedSetSocks5(m, socks.NewInbound(socks.ServerConfig {}))
        tunnel.MixedSetSocks4(m, socks.NewInbound4(socks.ServerConfig {}))
        tunnel.MixedSetHttp(m, httpproxy.NewInbound(httpproxy.ServerConfig {}))
        ret m
    end
end

func _resolve(host: str): str:
    if not _opts.use_doh or tunnel.IsIP(host): ret host end
    ips := doh.LookupHost(_opts.resolver, host)
    defer ips.Free()
    if ips.Len() == 0: ret host end
    ret ips[0]
end

func _connect(host: str, port: int, s: transport.Settings): transport.Conn:
    mut st := s
    if st.tls and st.sni.Len() == 0: st.sni = host end
    ret transport.Dial(_resolve(host), port, st)
end

func _vmess_security(method: str): int:
    if method == "chacha20-poly1305": ret vmess.SecChaCha20Poly1305 end
    if method == "none": ret vmess.SecNone end
    if method == "zero": ret vmess.SecZero end
    ret vmess.SecAES128GCM
end

func _fragment_into(s &: transport.Settings):
    s.fragment = true
    s.fragment_min = _opts.fragment_min
    s.fragment_max = _opts.fragment_max
    s.fragment_delay_ms = _opts.fragment_delay_ms
    s.fragment_mode = _opts.fragment_mode
    s.fragment_sni = _opts.fragment_sni
    s.fragment_writes = _opts.fragment_writes
end

@en "StreamSettings"
@fa "تنظیمات جریان"
pub func StreamSettings(raw: str): transport.Settings:
    mut s := transport.Settings {}
    n := json.Get(raw, "network")
    if n.Len() > 0: s.network = n end
    s.tls = json.Get(raw, "security") == "tls"
    t := json.Get(raw, "tlsSettings")
    s.sni = json.Get(t, "serverName")
    s.allow_insecure = json.Get(t, "allowInsecure") == "true"
    certs := json.Items(json.Get(t, "certificates"))
    defer certs.Free()
    if certs.Len() > 0:
        s.cert_file = json.Get(certs[0], "certificateFile")
        s.key_file = json.Get(certs[0], "keyFile")
    end
    mut w := json.Get(raw, "wsSettings")
    if s.network == "httpupgrade": w = json.Get(raw, "httpupgradeSettings") end
    p := json.Get(w, "path")
    if p.Len() > 0: s.path = p end
    s.host = json.Get(json.Get(w, "headers"), "Host")
    if json.Get(raw, "security") == "reality":
        s.security = "reality"
        s.tls = false
        r := json.Get(raw, "realitySettings")
        s.reality.server_name = json.Get(r, "serverName")
        s.reality.public_key = json.Get(r, "publicKey")
        s.reality.short_id = json.Get(r, "shortId")
        s.reality.spider_x = json.Get(r, "spiderX")
        fp := json.Get(r, "fingerprint")
        if fp.Len() > 0: s.reality.fingerprint = fp end
        s.sni = s.reality.server_name
        s.reality_server.private_key = json.Get(r, "privateKey")
        s.reality_server.dest = json.Get(r, "dest")
        td := json.Get(r, "maxTimeDiff")
        if td.Len() > 0: s.reality_server.max_time_diff = td.ToInt() end
        names := json.Items(json.Get(r, "serverNames"))
        defer names.Free()
        mut nl := ""
        repeat names.Len() in i:
            if i > 0: nl += "," end
            nl += json.Unquote(names[i])
        end
        s.reality_server.server_names = nl
        ids := json.Items(json.Get(r, "shortIds"))
        defer ids.Free()
        mut il := ""
        repeat ids.Len() in i:
            if i > 0: il += "," end
            il += json.Unquote(ids[i])
        end
        s.reality_server.short_ids = il
    end
    if s.network == "grpc":
        g := json.Get(raw, "grpcSettings")
        s.service_name = json.Get(g, "serviceName")
        if json.Get(g, "multiMode") == "true": s.grpc_mode = "multi" end
    end
    tmo := json.Get(raw, "timeouts")
    if tmo.Len() > 0:
        s.read_timeout_ms = json.Get(tmo, "read").ToInt()
        s.write_timeout_ms = json.Get(tmo, "write").ToInt()
    end
    frag := json.Get(raw, "fragment")
    if frag.Len() > 0 and (s.tls or s.security == "reality"):
        _fragment_into(s)
        mode := json.Get(frag, "mode")
        if mode.Len() > 0: s.fragment_mode = mode end
        if json.Get(frag, "sni") == "true": s.fragment_sni = true end
        w := json.Get(frag, "writes").ToInt()
        if w > 0: s.fragment_writes = w end
        lo := json.Get(frag, "min").ToInt()
        hi := json.Get(frag, "max").ToInt()
        if lo > 0 or hi > 0:
            s.fragment_min = lo
            s.fragment_max = hi
        end
        dl := json.Get(frag, "delay").ToInt()
        if dl > 0: s.fragment_delay_ms = dl end
    end
    ret s
end

@en "NodeSettings"
@fa "تنظیمات گره"
pub func NodeSettings(n: tunnel.Node): transport.Settings:
    mut s := transport.Settings { network = n.network, tls = n.tls, sni = n.sni, alpn = n.alpn, fingerprint = n.fingerprint, allow_insecure = n.allow_insecure, host = n.host_header }
    if n.path.Len() > 0: s.path = n.path end
    if n.network == "grpc":
        s.service_name = n.service_name
        if s.service_name.Len() == 0: s.service_name = n.path end
        if n.grpc_mode == "multi": s.grpc_mode = "multi" end
    end
    if n.security == "reality":
        s.security = "reality"
        s.tls = false
        s.reality.server_name = n.sni
        s.reality.public_key = n.public_key
        s.reality.short_id = n.short_id
        s.reality.spider_x = n.spider_x
        if n.fingerprint.Len() > 0: s.reality.fingerprint = n.fingerprint end
        s.reality.alpn = n.alpn
    end
    s.read_timeout_ms = _opts.read_timeout_ms
    s.write_timeout_ms = _opts.write_timeout_ms
    if (s.tls or s.security == "reality") and _opts.fragment:
        _fragment_into(s)
    end
    ret s
end

@en "DialerFromNode"
@fa "شماره‌گیر از گره"
pub func DialerFromNode(n: tunnel.Node): dyn tunnel.Dialer:
    plain := TransportDialer { settings = NodeSettings(n) }
    if n.protocol == "vless": ret VlessDialer { node = n } end
    if n.protocol == "vmess": ret VmessDialer { node = n } end
    if n.protocol == "ss" or n.protocol == "shadowsocks": ret SsDialer { node = n } end
    if n.protocol == "trojan":
        ret tunnel.Via(plain, trojan.NewConnector(n.host, n.port, n.password))
    end
    if n.protocol == "socks":
        ret tunnel.Via(plain, socks.NewConnector(socks.Client { host = n.host, port = n.port }))
    end
    if n.protocol == "http":
        ret tunnel.Via(plain, httpproxy.NewConnector(httpproxy.Client { host = n.host, port = n.port }))
    end
    ret tunnel.Block()
end

@en "ToTunnelAddr"
@fa "نشانی تونل از انتقال"
pub func ToTunnelAddr(a: transport.Addr): tunnel.Addr:
    ret tunnel.NewAddr(a.host, a.port)
end

@en "ToTransportAddr"
@fa "نشانی انتقال از تونل"
pub func ToTransportAddr(a: tunnel.Addr): transport.Addr:
    ret transport.NewAddr(a.host, a.port)
end

@en "RegisterWith"
@fa "ثبت با گزینه‌ها"
pub func RegisterWith(o: Options):
    _opts = o
    each p in ["vless", "vmess", "trojan", "shadowsocks", "ss", "socks", "http"]:
        tunnel.RegisterOutbound(OutMaker { proto = p })
    end
    each p in ["mixed", "socks", "http", "trojan", "vless", "vmess", "shadowsocks"]:
        tunnel.RegisterInbound(InMaker { proto = p })
    end
end

@en "Register"
@fa "ثبت"
pub func Register():
    RegisterWith(Options {})
end

@en "BuildDialer"
@fa "ساخت شماره‌گیر"
pub func BuildDialer(c: tunnel.Config): tunnel.RouterDialer:
    mut rd := tunnel.BuildDialer(c)
    if _opts.use_doh:
        tunnel.SetResolver(rd.router, DohResolver { resolver = _opts.resolver }, 300000 as i64)
    end
    ret rd
end
