package wifi

if SALAM_OS_LINUX:
    import mem
    import os
    import os.dl
    import os.shell
    import str
end

if SALAM_OS_LINUX:
    mut _g_lib := null as void*
    mut _g_tried := false
    mut _g_bus := null as void*

    func _g(name: str): void*:
        ret dl.Sym(_g_lib, name)
    end

    func _g_ready(): bool:
        if not _g_tried:
            _g_tried = true
            _g_lib = dl.Open("libgio-2.0.so.0")
            if _g_lib != null:
                get := _g("g_bus_get_sync")
                if get != null:
                    f := get as extern func (int, void*, void*) void*
                    _g_bus = f(1, null, null)
                end
            end
        end
        ret _g_bus != null
    end

    func _gv_unref(v: void*):
        if v != null:
            f := _g("g_variant_unref") as extern func (void*)
            f(v)
        end
    end

    func _gv_child(v: void*, i: int): void*:
        f := _g("g_variant_get_child_value") as extern func (void*, usize) void*
        ret f(v, i as usize)
    end

    func _gv_count(v: void*): int:
        f := _g("g_variant_n_children") as extern func (void*) usize
        ret f(v) as int
    end

    func _gv_type(v: void*): str:
        f := _g("g_variant_get_type_string") as extern func (void*) str
        ret f(v)
    end

    func _gv_text(v: void*): str:
        if v == null:
            ret str.Clone("")
        end
        t := _gv_type(v)
        if t != "s" and t != "o":
            ret str.Clone("")
        end
        f := _g("g_variant_get_string") as extern func (void*, void*) str
        ret str.Clone(f(v, null))
    end

    func _gv_int(v: void*): int:
        if v == null:
            ret -1
        end
        t := _gv_type(v)
        if t == "u":
            f := _g("g_variant_get_uint32") as extern func (void*) u32
            ret f(v) as int
        end
        if t == "y":
            f := _g("g_variant_get_byte") as extern func (void*) u8
            ret f(v) as int
        end
        ret -1
    end

    func _gv_bytes(v: void*): str:
        if v == null or _gv_type(v) != "ay":
            ret str.Clone("")
        end
        cell := mem.AllocateZeroed(8 as u64)
        defer mem.Free(cell)
        f := _g("g_variant_get_fixed_array") as extern func (void*, void*, usize) void*
        p := f(v, cell, 1 as usize)
        if p == null:
            ret str.Clone("")
        end
        ret _bytes_text(p, ((cell as usize*)[0]) as int)
    end

    func _nm_call(path: str, iface: str, method: str, params: void*): void*:
        f := _g("g_dbus_connection_call_sync") as extern func (void*, str, str, str, str, void*, void*, int, int, void*, void*) void*
        ret f(_g_bus, "org.freedesktop.NetworkManager", path, iface, method, params, null, 1, 1500, null, null)
    end

    func _nm_prop(path: str, iface: str, name: str): void*:
        news := _g("g_variant_new_string") as extern func (str) void*
        tuple := _g("g_variant_new_tuple") as extern func (void*, usize) void*
        kids := mem.Allocate((2 * 8) as u64)
        (kids as usize*)[0] = news(iface) as usize
        (kids as usize*)[1] = news(name) as usize
        params := tuple(kids, 2 as usize)
        mem.Free(kids)
        reply := _nm_call(path, "org.freedesktop.DBus.Properties", "Get", params)
        if reply == null:
            ret null
        end
        boxed := _gv_child(reply, 0)
        _gv_unref(reply)
        if boxed == null:
            ret null
        end
        f := _g("g_variant_get_variant") as extern func (void*) void*
        inner := f(boxed)
        _gv_unref(boxed)
        ret inner
    end

    func _nm_int(path: str, iface: str, name: str): int:
        v := _nm_prop(path, iface, name)
        n := _gv_int(v)
        _gv_unref(v)
        ret n
    end

    func _nm_text(path: str, iface: str, name: str): str:
        v := _nm_prop(path, iface, name)
        t := _gv_text(v)
        _gv_unref(v)
        ret t
    end

    func _nm_devices(ok &: bool): Vector<str>:
        mut out := Vector {} as Vector<str>
        ok = false
        if not _g_ready():
            ret out
        end
        reply := _nm_call("/org/freedesktop/NetworkManager", "org.freedesktop.NetworkManager", "GetDevices", null)
        if reply == null:
            ret out
        end
        ok = true
        list := _gv_child(reply, 0)
        if list != null:
            repeat _gv_count(list) in i:
                item := _gv_child(list, i)
                out.Push(_gv_text(item))
                _gv_unref(item)
            end
            _gv_unref(list)
        end
        _gv_unref(reply)
        ret out
    end

    func _nm_status(dev: str): Status:
        base := "org.freedesktop.NetworkManager.Device"
        mut s := Status { backend = "networkmanager" }
        s.interface = _nm_text(dev, base, "Interface")
        st := _nm_int(dev, base, "State")
        ap := _nm_text(dev, base + ".Wireless", "ActiveAccessPoint")
        if st == 10:
            s.state = State.Unknown
            s.reason = "not managed by NetworkManager"
            ret s
        end
        s.state = st == 100 ? State.Connected : State.Disconnected
        if ap.Len() == 0 or ap == "/":
            if s.state == State.Connected:
                s.state = State.Disconnected
            end
            ret s
        end
        apif := "org.freedesktop.NetworkManager.AccessPoint"
        v := _nm_prop(ap, apif, "Ssid")
        s.ssid = _gv_bytes(v)
        _gv_unref(v)
        s.ssid_known = s.ssid.Len() > 0
        if not s.ssid_known and s.state == State.Connected:
            s.reason = "hidden network"
        end
        s.bssid = _nm_text(ap, apif, "HwAddress").Lower()
        s.signal = _nm_int(ap, apif, "Strength")
        s.security = SecurityFromNm(_nm_int(ap, apif, "Flags"), _nm_int(ap, apif, "WpaFlags"), _nm_int(ap, apif, "RsnFlags"))
        ret s
    end

    func _lx_sys_names(): Vector<str>:
        mut out := Vector {} as Vector<str>
        names := os.ListDir("/sys/class/net")
        defer names.Free()
        each n in names:
            if n == "." or n == "..":
                continue
            end
            dir := "/sys/class/net/" + n
            if os.Exists(dir + "/wireless") or os.Exists(dir + "/phy80211"):
                out.Push(str.Clone(n))
            end
        end
        ret out
    end

    func _iw_path(): str:
        each p in ["/usr/sbin/iw", "/sbin/iw", "/usr/bin/iw", "/bin/iw"]:
            if os.Exists(p):
                ret p
            end
        end
        ret ""
    end

    func _iw_run(iw: str, a: Vector<str>): str:
        r := shell.Run(iw, a)
        mem.Free(r.err as void*)
        if r.code != 0:
            mem.Free(r.out as void*)
            ret str.Clone("")
        end
        ret r.out
    end

    func _iw_status(iw: str, iface: str): Status:
        mut a := Vector {} as Vector<str>
        defer a.Free()
        a.Push("dev")
        a.Push(iface)
        a.Push("link")
        text := _iw_run(iw, a)
        mut s := ParseIwLink(text, iface)
        mem.Free(text as void*)
        if s.state == State.Connected and s.bssid.Len() > 0:
            a.Clear()
            a.Push("dev")
            a.Push(iface)
            a.Push("scan")
            a.Push("dump")
            dump := _iw_run(iw, a)
            s.security = ParseIwScan(dump, s.bssid)
            mem.Free(dump as void*)
        end
        ret s
    end

    func _has_iface(list: Vector<Status>, name: str): bool:
        each s in list:
            if s.interface == name:
                ret true
            end
        end
        ret false
    end

    func _lx_scan(): Vector<Status>:
        mut out := Vector {} as Vector<Status>
        mut nm_ok := false
        devs := _nm_devices(nm_ok)
        defer devs.Free()
        iw := _iw_path()
        each d in devs:
            if _nm_int(d, "org.freedesktop.NetworkManager.Device", "DeviceType") == 2:
                mut s := _nm_status(d)
                if s.state == State.Unknown and iw.Len() > 0:
                    s = _iw_status(iw, s.interface)
                end
                out.Push(s)
            end
        end
        names := _lx_sys_names()
        defer names.Free()
        if iw.Len() > 0:
            mut a := Vector {} as Vector<str>
            a.Push("dev")
            listing := _iw_run(iw, a)
            a.Free()
            found := ParseIwDev(listing)
            mem.Free(listing as void*)
            each n in found:
                if not _has_iface(out, n):
                    out.Push(_iw_status(iw, n))
                end
            end
            found.Free()
        end
        each n in names:
            if not _has_iface(out, n):
                reason := nm_ok ? "not reported by NetworkManager" : "NetworkManager and iw are not available"
                out.Push(Status { interface = n, backend = "sysfs", reason = reason })
            end
        end
        ret out
    end
end
