package wifi

if SALAM_OS_LINUX:
    import mem
    import os
    import os.dl
    import os.shell
    import str
end

if SALAM_OS_LINUX:
    mut _g_lib := null as void*
    mut _g_lib_tried := false
    mut _g_bus := null as void*

    func _g(name: str): void*:
        ret dl.Sym(_g_lib, name)
    end

    func _g_loaded(): bool:
        if not _g_lib_tried:
            _g_lib_tried = true
            _g_lib = dl.Open("libgio-2.0.so.0")
        end
        ret _g_lib != null
    end

    func _g_ready(): bool:
        if not _g_loaded():
            ret false
        end
        is_closed := _g("g_dbus_connection_is_closed")
        unref := _g("g_object_unref")
        address := _g("g_dbus_address_get_for_bus_sync")
        connect := _g("g_dbus_connection_new_for_address_sync")
        keep := _g("g_dbus_connection_set_exit_on_close")
        gfree := _g("g_free")
        if is_closed == null or unref == null or address == null or connect == null or
            keep == null or gfree == null:
            ret false
        end
        if _g_bus != null:
            closed := is_closed as extern func (void*) int
            if closed(_g_bus) == 0:
                ret true
            end
            drop := unref as extern func (void*)
            drop(_g_bus)
            _g_bus = null
        end
        addr_of := address as extern func (int, void*, void*) void* addr := addr_of(1, null, null)
        if addr == null:
            ret false
        end
        open := connect as extern func (void*, int, void*, void*, void*) void* conn := open(
            addr, 9, null, null, null
        )
        release := gfree as extern func (void*)
        release(addr)
        if conn == null:
            ret false
        end
        stay := keep as extern func (void*, int)
        stay(conn, 0)
        _g_bus = conn
        ret true
    end

    func _gv_unref(v: void*):
        if v != null:
            f := _g("g_variant_unref") as extern func (void*)
            f(v)
        end
    end

    func _gv_child(v: void*, i: int): void*:
        f := _g(
            "g_variant_get_child_value"
        ) as extern func (void*, usize) void* ret f(v, i as usize)
    end

    func _gv_count(v: void*): int:
        f := _g("g_variant_n_children") as extern func (void*) usize
        ret f(v) as int
    end

    func _gv_type(v: void*): str:
        f := _g("g_variant_get_type_string") as extern func (void*) str
        ret f(v)
    end

    func _gv_text(v: void*): str:
        if v == null:
            ret str.Clone("")
        end
        t := _gv_type(v)
        if t != "s" and t != "o":
            ret str.Clone("")
        end
        f := _g("g_variant_get_string") as extern func (void*, void*) str
        ret str.Clone(f(v, null))
    end

    func _gv_int(v: void*): int:
        if v == null:
            ret -1
        end
        t := _gv_type(v)
        if t == "u":
            f := _g("g_variant_get_uint32") as extern func (void*) u32
            ret f(v) as int
        end
        if t == "y":
            f := _g("g_variant_get_byte") as extern func (void*) u8
            ret f(v) as int
        end
        ret -1
    end

    func _gv_bytes(v: void*, nul &: bool): str:
        nul = false
        if v == null or _gv_type(v) != "ay":
            ret str.Clone("")
        end
        cell := mem.AllocateZeroed(8 as u64)
        defer mem.Free(cell)
        f := _g(
            "g_variant_get_fixed_array"
        ) as extern func (void*, void*, usize) void* p := f(v, cell, 1 as usize)
        n := ((cell as usize*)[0]) as int
        if p == null:
            ret str.Clone("")
        end
        if _has_nul(p, n):
            nul = true
            ret str.Clone("")
        end
        ret _bytes_text(p, n)
    end

    func _nm_call(path: str, iface: str, method: str, params: void*): void*:
        f := _g(
            "g_dbus_connection_call_sync"
        ) as extern func (void*, str, str, str, str, void*, void*, int, int, void*, void*) void* ret f(
            _g_bus,
            "org.freedesktop.NetworkManager",
            path,
            iface,
            method,
            params,
            null,
            1,
            1500,
            null,
            null
        )
    end

    func _nm_prop(path: str, iface: str, name: str): void*:
        news := _g(
            "g_variant_new_string"
        ) as extern func (str) void* tuple := _g(
            "g_variant_new_tuple"
        ) as extern func (void*, usize) void* kids := mem.Allocate((2 * 8) as u64)
        (kids as usize*)[0] = news(iface) as usize
        (kids as usize*)[1] = news(name) as usize
        params := tuple(kids, 2 as usize)
        mem.Free(kids)
        reply := _nm_call(path, "org.freedesktop.DBus.Properties", "Get", params)
        if reply == null:
            ret null
        end
        boxed := _gv_child(reply, 0)
        _gv_unref(reply)
        if boxed == null:
            ret null
        end
        f := _g("g_variant_get_variant") as extern func (void*) void* inner := f(boxed)
        _gv_unref(boxed)
        ret inner
    end

    func _nm_int(path: str, iface: str, name: str): int:
        v := _nm_prop(path, iface, name)
        n := _gv_int(v)
        _gv_unref(v)
        ret n
    end

    func _nm_text(path: str, iface: str, name: str): str:
        v := _nm_prop(path, iface, name)
        t := _gv_text(v)
        _gv_unref(v)
        ret t
    end

    func _nm_devices(ok &: bool): Vector<str>:
        mut out := Vector {} as Vector<str>
        ok = false
        if not _g_ready():
            ret out
        end
        reply := _nm_call(
            "/org/freedesktop/NetworkManager", "org.freedesktop.NetworkManager", "GetDevices", null
        )
        if reply == null:
            ret out
        end
        ok = true
        list := _gv_child(reply, 0)
        if list != null:
            repeat _gv_count(list) in i:
                item := _gv_child(list, i)
                out.Push(_gv_text(item))
                _gv_unref(item)
            end
            _gv_unref(list)
        end
        _gv_unref(reply)
        ret out
    end

    func _nm_status(dev: str): Status:
        base := "org.freedesktop.NetworkManager.Device"
        apif := "org.freedesktop.NetworkManager.AccessPoint"
        mut s := _blank("networkmanager")
        s.interface = _swap(s.interface, _nm_text(dev, base, "Interface"))
        repeat 3:
            st := _nm_int(dev, base, "State")
            ap := _nm_text(dev, base + ".Wireless", "ActiveAccessPoint")
            if st < 0:
                mem.Free(ap as void*)
                s.reason = "could not read the device state"
                ret s
            end
            if st == 10:
                mem.Free(ap as void*)
                s.reason = "not managed by NetworkManager"
                ret s
            end
            if ap.Len() == 0 or ap == "/":
                mem.Free(ap as void*)
                s.state = State.Disconnected
                ret s
            end
            mut nul := false
            v := _nm_prop(ap, apif, "Ssid")
            name := _gv_bytes(v, nul)
            _gv_unref(v)
            raw_mac := _nm_text(ap, apif, "HwAddress")
            mac := raw_mac.Lower()
            mem.Free(raw_mac as void*)
            strength := _nm_int(ap, apif, "Strength")
            flags := _nm_int(ap, apif, "Flags")
            wpa := _nm_int(ap, apif, "WpaFlags")
            rsn := _nm_int(ap, apif, "RsnFlags")
            st2 := _nm_int(dev, base, "State")
            ap2 := _nm_text(dev, base + ".Wireless", "ActiveAccessPoint")
            same := st2 == st and ap2 == ap
            mem.Free(ap2 as void*)
            mem.Free(ap as void*)
            if same:
                s.state = st == 100 ? State.Connected : State.Disconnected
                s.ssid = _swap(s.ssid, name)
                s.ssid_known = s.ssid.Len() > 0
                if nul:
                    s.reason = "the SSID contains a NUL byte"
                else not s.ssid_known and s.state == State.Connected:
                    s.reason = "hidden network"
                end
                s.bssid = _swap(s.bssid, mac)
                s.signal = strength
                if flags < 0 or wpa < 0 or rsn < 0:
                    s.security = Security.Unknown
                else:
                    s.security = SecurityFromNm(flags, wpa, rsn)
                end
                ret s
            end
            mem.Free(name as void*)
            mem.Free(mac as void*)
        end
        s.reason = "the access point changed while it was being read"
        ret s
    end

    func _lx_sys_names(): Vector<str>:
        mut out := Vector {} as Vector<str>
        names := os.ListDir("/sys/class/net")
        defer names.Free()
        each n in names:
            if n == "." or n == "..":
                continue
            end
            dir := "/sys/class/net/" + n
            if os.Exists(dir + "/wireless") or os.Exists(dir + "/phy80211"):
                out.Push(str.Clone(n))
            end
            mem.Free(n as void*)
        end
        ret out
    end

    func _iw_path(): str:
        each p in ["/usr/sbin/iw", "/sbin/iw", "/usr/bin/iw", "/bin/iw"]:
            if os.Exists(p):
                ret p
            end
        end
        ret ""
    end

    func _iw_run(iw: str, a: Vector<str>): str:
        r := shell.Run(iw, a)
        mem.Free(r.err as void*)
        if r.code != 0:
            mem.Free(r.out as void*)
            ret str.Clone("")
        end
        ret r.out
    end

    func _iw_status(iw: str, iface: str): Status:
        mut a := Vector {} as Vector<str>
        defer a.Free()
        a.Push("dev")
        a.Push(iface)
        a.Push("link")
        text := _iw_run(iw, a)
        mut s := ParseIwLink(text, iface)
        mem.Free(text as void*)
        if s.state == State.Connected and s.bssid.Len() > 0:
            a.Clear()
            a.Push("dev")
            a.Push(iface)
            a.Push("scan")
            a.Push("dump")
            dump := _iw_run(iw, a)
            s.security = ParseIwScan(dump, s.bssid)
            mem.Free(dump as void*)
        end
        ret s
    end

    func _has_iface(list: Vector<Status>, name: str): bool:
        each s in list:
            if s.interface == name:
                ret true
            end
        end
        ret false
    end

    func _lx_scan(): Vector<Status>:
        mut out := Vector {} as Vector<Status>
        mut nm_ok := false
        devs := _nm_devices(nm_ok)
        defer devs.Free()
        iw := _iw_path()
        each d in devs:
            if _nm_int(d, "org.freedesktop.NetworkManager.Device", "DeviceType") == 2:
                mut s := _nm_status(d)
                if s.state == State.Unknown and iw.Len() > 0 and s.interface.Len() > 0:
                    name := str.Clone(s.interface)
                    FreeStatus(s)
                    s = _iw_status(iw, name)
                    mem.Free(name as void*)
                end
                out.Push(s)
            end
            mem.Free(d as void*)
        end
        names := _lx_sys_names()
        defer names.Free()
        if iw.Len() > 0:
            mut a := Vector {} as Vector<str>
            a.Push("dev")
            listing := _iw_run(iw, a)
            a.Free()
            found := ParseIwDev(listing)
            mem.Free(listing as void*)
            each n in found:
                if not _has_iface(out, n):
                    out.Push(_iw_status(iw, n))
                end
                mem.Free(n as void*)
            end
            found.Free()
        end
        each n in names:
            if not _has_iface(out, n):
                mut s := _blank("sysfs")
                s.interface = _swap(s.interface, str.Clone(n))
                s.reason = nm_ok ? "not reported by NetworkManager" : "NetworkManager and iw are not available"
                out.Push(s)
            end
            mem.Free(n as void*)
        end
        ret out
    end
end
