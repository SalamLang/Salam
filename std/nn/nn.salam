@en "nn"
@fa "شبکه عصبی"
@ar "شبكة عصبية"
package nn

import autograd
import mem
import str
import tensor


@en "Parameter"
@fa "پارامتر"
@ar "معامل"
pub struct Parameter:
    pub name: str = ""
    pub value: tensor.Tensor = tensor.Tensor {}
    pub grad: tensor.Tensor = tensor.Tensor {}
end

@en "ParamStore"
@fa "مخزن پارامتر"
@ar "مخزن المعاملات"
pub struct ParamStore:
    pub items: Vector<Parameter> = Vector {}

    @en "add"
    @fa "افزودن"
    @ar "إضافة"
    pub func add(name: str, t: tensor.Tensor): int:
        mut p := Parameter {}
        p.name = str.Clone(name)
        p.value = t
        p.grad = tensor.Zeros(t.shape)
        id := this.items.len()
        this.items.push(p)
        ret id
    end

    @en "count"
    @fa "شمار"
    @ar "عدد"
    pub func count(): int: ret this.items.len() end

    @en "at"
    @fa "در"
    @ar "عند"
    pub func at(h: int): Parameter: ret this.items.get(h) end

    @en "zero_grad"
    @fa "صفر کردن گرادیان"
    @ar "تصفير التدرج"
    pub func zero_grad():
        repeat this.items.len() with i:
            mut p := this.items.get(i)
            tensor.SetAll(p.grad, 0.0)
        end
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        repeat this.items.len() with i:
            mut p := this.items.get(i)
            p.value.free()
            p.grad.free()
            mem.Free(p.name as void*)
        end
        this.items.free()
    end
end

@en "Bind"
@fa "پیوند"
@ar "ربط"
pub func Bind(tp &: autograd.Tape, ps &: ParamStore, h: int): int:
    mut p := ps.items.get(h)
    ret autograd.Param(tp, p.value, p.grad)
end
