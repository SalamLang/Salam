@en "nn"
@fa "شبکه عصبی"
@ar "شبكة عصبية"
package nn

import autograd
import tensor

// Neural network building blocks over std/autograd and std/tensor.
//
// The one load-bearing type is ParamStore: the registry that owns every
// parameter's value and gradient for the life of a model. Layers are
// plain structs that hold int HANDLES into the store - never pointers,
// because the store's vector reallocates as layers register - and a
// layer's forward() re-binds its parameters onto the tape each call.
// Optimizers walk the same registry by index; checkpoints key it by
// name. One registry, four consumers, no ownership questions.
//
// A model is written as a struct with its layers as fields and one
// forward method that calls them in order:
//
//     struct Mlp:
//         pub fc1: nn.Linear = nn.Linear {}
//         pub fc2: nn.Linear = nn.Linear {}
//         pub func forward(tp &: autograd.Tape, ps &: nn.ParamStore, x: int): int:
//             h := autograd.Relu(tp, this.fc1.forward(tp, ps, x))
//             ret this.fc2.forward(tp, ps, h)
//         end
//     end
//
// and a training step is: tp.reset(), ps.zero_grad(), forward, loss,
// autograd.Backward, optimizer step. Nothing else holds state.
//
// Parameter names ("fc1.w", "conv2.b") become the keys of the SLMT
// checkpoint format, so keep them unique; add() does not police it.

@en "Parameter"
@fa "پارامتر"
@ar "معامل"
pub struct Parameter:
    pub name: str = ""
    pub value: tensor.Tensor = tensor.Tensor {}
    pub grad: tensor.Tensor = tensor.Tensor {}
end

@en "ParamStore"
@fa "مخزن پارامتر"
@ar "مخزن المعاملات"
pub struct ParamStore:
    pub items: Vector<Parameter> = Vector {}

    // Registers a parameter, TAKING OWNERSHIP of `t`, and allocates its
    // zeroed gradient buffer. Returns the handle layers store.
    @en "add"
    @fa "افزودن"
    @ar "إضافة"
    pub func add(name: str, t: tensor.Tensor): int:
        mut p := Parameter {}
        p.name = name
        p.value = t
        p.grad = tensor.Zeros(t.shape)
        id := this.items.len()
        this.items.push(p)
        ret id
    end

    @en "count"
    @fa "شمار"
    @ar "عدد"
    pub func count(): int: ret this.items.len() end

    // The registered parameter at a handle, as aliasing headers: read
    // and write through them, never free them.
    @en "at"
    @fa "در"
    @ar "عند"
    pub func at(h: int): Parameter: ret this.items.get(h) end

    @en "zero_grad"
    @fa "صفر کردن گرادیان"
    @ar "تصفير التدرج"
    pub func zero_grad():
        repeat this.items.len() with i:
            mut p := this.items.get(i)
            tensor.SetAll(p.grad, 0.0)
        end
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free():
        repeat this.items.len() with i:
            mut p := this.items.get(i)
            p.value.free()
            p.grad.free()
        end
        this.items.free()
    end
end

// ---- public API ----

// Binds the parameter at handle `h` onto a tape: its value is read in
// place and backward accumulates into its persistent gradient.
@en "Bind"
@fa "پیوند"
@ar "ربط"
pub func Bind(tp &: autograd.Tape, ps &: ParamStore, h: int): int:
    mut p := ps.items.get(h)
    ret autograd.Param(tp, p.value, p.grad)
end
