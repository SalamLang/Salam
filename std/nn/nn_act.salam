package nn

import autograd

// The stateless layers that carry a hyperparameter: activations are
// called straight off std/autograd (autograd.Relu, .Gelu, .Tanh,
// .Sigmoid), but dropout owns its rate and is worth a field in a model
// struct.

@en "Dropout"
@fa "حذف تصادفی"
@ar "إسقاط"
pub struct Dropout:
    pub p: f64 = 0.1

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, x: int): int:
        ret autograd.Dropout(tp, x, this.p)
    end
end
