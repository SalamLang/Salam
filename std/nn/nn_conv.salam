package nn

import autograd
import tensor

// Convolutional layers over the NCHW kernels. Weights are [OC,C,KH,KW]
// with Kaiming-uniform init at fan_in = C*KH*KW; pooling layers are
// stateless geometry holders so a model can declare its whole shape as
// fields.

@en "Conv2D"
@fa "لایه پیچشی"
@ar "طبقة التفاف"
pub struct Conv2D:
    pub w: int = 0 - 1
    pub b: int = 0 - 1
    pub stride: int = 1
    pub pad: int = 0

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
        wid := Bind(tp, ps, this.w)
        bid := Bind(tp, ps, this.b)
        ret autograd.Conv2D(tp, x, wid, bid, this.stride, this.stride, this.pad, this.pad)
    end
end

@en "MaxPool2D"
@fa "لایه بیشینه‌گیری"
@ar "طبقة تجميع أقصى"
pub struct MaxPool2D:
    pub size: int = 2
    pub stride: int = 2

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, x: int): int:
        ret autograd.MaxPool2D(tp, x, this.size, this.size, this.stride, this.stride)
    end
end

@en "AvgPool2D"
@fa "لایه میانگین‌گیری"
@ar "طبقة تجميع متوسط"
pub struct AvgPool2D:
    pub size: int = 2
    pub stride: int = 2

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, x: int): int:
        ret autograd.AvgPool2D(tp, x, this.size, this.size, this.stride, this.stride)
    end
end

// ---- public API ----

@en "NewConv2D"
@fa "لایه پیچشی نو"
@ar "طبقة التفاف جديدة"
pub func NewConv2D(ps &: ParamStore, name: str, in_ch: int, out_ch: int, k: int, stride: int, pad: int, g &: tensor.Rng): Conv2D:
    mut l := Conv2D {}
    l.stride = stride
    l.pad = pad
    mut w := tensor.Zeros4(out_ch, in_ch, k, k)
    KaimingUniform(w, in_ch * k * k, g)
    l.w = ps.add(name + ".w", w)
    b := tensor.Zeros1(out_ch)
    l.b = ps.add(name + ".b", b)
    ret l
end

// Collapses [N, ...] to [N, rest] on the tape - the conv-to-dense
// hinge.
@en "Flatten"
@fa "تخت‌سازی"
@ar "تسطيح"
pub func Flatten(tp &: autograd.Tape, x: int): int:
    v := autograd.Value(tp, x)
    n := v.dim(0)
    mut s := tensor.Shape2(n, v.numel() / n)
    out := autograd.Reshape(tp, x, s)
    s.free()
    ret out
end
