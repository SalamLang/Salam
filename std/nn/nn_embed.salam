package nn

import autograd
import mem
import math
import tensor


@en "Embedding"
@fa "جاسازی"
pub struct Embedding:
    pub w: int = 0 - 1
    pub vocab: int = 0
    pub dim: int = 0

    @en "forward"
    @fa "پیشرو"
    pub func forward(tp &: autograd.Tape, ps &: ParamStore, indices &: Vector<int>): int:
        wid := Bind(tp, ps, this.w)
        ret autograd.Embedding(tp, wid, indices)
    end
end

@en "NewEmbedding"
@fa "جاسازی نو"
pub func NewEmbedding(ps &: ParamStore, name: str, vocab: int, dim: int, g &: tensor.Rng): Embedding:
    mut e := Embedding {}
    e.vocab = vocab
    e.dim = dim
    mut w := tensor.Zeros2(vocab, dim)
    tensor.FillNormal(w, 0.0, 1.0 / math.Sqrt(dim as f64), g)
    _pn1 := name + ".w"
    e.w = ps.add(_pn1, w)
    mem.Free(_pn1 as void*)
    ret e
end

@en "SinusoidalPositions"
@fa "موقعیت سینوسی"
pub func SinusoidalPositions(batch: int, seq: int, dim: int): tensor.Tensor:
    t := tensor.Zeros2(batch * seq, dim)
    p := t.data.data
    repeat seq with pos:
        repeat dim with i:
            pair := (i / 2) * 2
            freq := 1.0 / math.Pow(10000.0, (pair as f64) / (dim as f64))
            angle := (pos as f64) * freq
            mut v := math.Sin(angle)
            if i % 2 == 1: v = math.Cos(angle) end
            repeat batch with b:
                p[(b * seq + pos) * dim + i] = v as f32
            end
        end
    end
    ret t
end
