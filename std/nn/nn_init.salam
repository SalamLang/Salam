package nn

import math
import tensor

// Weight initializers. Each fills a tensor in place from an explicit
// generator, so a model seeded once initializes identically everywhere:
// thread one tensor.Rng through the constructors in declaration order
// and the whole network is a function of a single integer.
//
// Xavier (Glorot) keeps activation variance flat through tanh/sigmoid
// layers; Kaiming (He) compensates for ReLU halving the variance.
// Uniform and normal forms of both, the usual fan conventions.

// ---- public API ----

@en "XavierUniform"
@fa "زاویه یکنواخت"
@ar "زافييه منتظم"
pub func XavierUniform(t &: tensor.Tensor, fan_in: int, fan_out: int, g &: tensor.Rng):
    limit := math.Sqrt(6.0 / ((fan_in + fan_out) as f64))
    tensor.FillUniform(t, 0.0 - limit, limit, g)
end

@en "XavierNormal"
@fa "زاویه نرمال"
@ar "زافييه طبيعي"
pub func XavierNormal(t &: tensor.Tensor, fan_in: int, fan_out: int, g &: tensor.Rng):
    std := math.Sqrt(2.0 / ((fan_in + fan_out) as f64))
    tensor.FillNormal(t, 0.0, std, g)
end

@en "KaimingUniform"
@fa "کایمینگ یکنواخت"
@ar "كايمينغ منتظم"
pub func KaimingUniform(t &: tensor.Tensor, fan_in: int, g &: tensor.Rng):
    limit := math.Sqrt(6.0 / (fan_in as f64))
    tensor.FillUniform(t, 0.0 - limit, limit, g)
end

@en "KaimingNormal"
@fa "کایمینگ نرمال"
@ar "كايمينغ طبيعي"
pub func KaimingNormal(t &: tensor.Tensor, fan_in: int, g &: tensor.Rng):
    std := math.Sqrt(2.0 / (fan_in as f64))
    tensor.FillNormal(t, 0.0, std, g)
end
