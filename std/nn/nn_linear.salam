package nn

import autograd
import mem
import tensor

// The dense layer: y = x W + b, with x rows as samples. W is stored
// [in, out] so the forward is one gemm with no transpose, and the bias
// add rides the suffix-broadcast mode. Weights get Kaiming-uniform
// init (the ReLU-era default), biases start at zero.

@en "Linear"
@fa "لایه خطی"
@ar "طبقة خطية"
pub struct Linear:
    pub w: int = 0 - 1
    pub b: int = 0 - 1
    pub in_features: int = 0
    pub out_features: int = 0
    pub has_bias: bool = true

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
        wid := Bind(tp, ps, this.w)
        mut out := autograd.MatMul(tp, x, wid)
        if this.has_bias:
            bid := Bind(tp, ps, this.b)
            out = autograd.Add(tp, out, bid)
        end
        ret out
    end
end

// ---- public API ----

@en "NewLinear"
@fa "لایه خطی نو"
@ar "طبقة خطية جديدة"
pub func NewLinear(ps &: ParamStore, name: str, in_f: int, out_f: int, g &: tensor.Rng): Linear:
    mut l := Linear {}
    l.in_features = in_f
    l.out_features = out_f
    mut w := tensor.Zeros2(in_f, out_f)
    KaimingUniform(w, in_f, g)
    _pn1 := name + ".w"
    l.w = ps.add(_pn1, w)
    mem.Free(_pn1 as void*)
    b := tensor.Zeros1(out_f)
    _pn2 := name + ".b"
    l.b = ps.add(_pn2, b)
    mem.Free(_pn2 as void*)
    ret l
end

@en "NewLinearNoBias"
@fa "لایه خطی بی‌بایاس"
@ar "طبقة خطية بلا انحياز"
pub func NewLinearNoBias(ps &: ParamStore, name: str, in_f: int, out_f: int, g &: tensor.Rng): Linear:
    mut l := Linear {}
    l.in_features = in_f
    l.out_features = out_f
    l.has_bias = false
    mut w := tensor.Zeros2(in_f, out_f)
    KaimingUniform(w, in_f, g)
    _pn3 := name + ".w"
    l.w = ps.add(_pn3, w)
    mem.Free(_pn3 as void*)
    ret l
end
