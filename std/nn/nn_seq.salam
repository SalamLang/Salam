package nn

import autograd


@en "Layer"
@fa "لایه"
@ar "طبقة"
pub interface Layer:
    func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int
end

@en "ReluLayer"
@fa "لایه یکسوساز"
@ar "طبقة مقوم"
pub struct ReluLayer:
    pub unused: int = 0

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
        ret autograd.Relu(tp, x)
    end
end

@en "GeluLayer"
@fa "لایه گلو"
@ar "طبقة جيلو"
pub struct GeluLayer:
    pub unused: int = 0

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
        ret autograd.Gelu(tp, x)
    end
end

@en "TanhLayer"
@fa "لایه تانژانت هذلولی"
@ar "طبقة ظل زائدي"
pub struct TanhLayer:
    pub unused: int = 0

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
        ret autograd.Tanh(tp, x)
    end
end

@en "Sequential"
@fa "ترتیبی"
@ar "تسلسلي"
pub struct Sequential:
    pub layers: Vector<dyn Layer> = Vector {}

    @en "add"
    @fa "افزودن"
    @ar "إضافة"
    pub func add(l: dyn Layer): this.layers.push(l) end

    @en "forward"
    @fa "پیشرو"
    @ar "أمامي"
    pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
        mut h := x
        repeat this.layers.len() with i:
            l := this.layers.get(i)
            h = l.forward(tp, ps, h)
        end
        ret h
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحرير"
    pub func free(): this.layers.free() end
end
