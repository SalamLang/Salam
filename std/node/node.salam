package node

import str

extern:
    func require(id: str): i64
    func salam_js_get_prop(obj: i64, name: str): i64
    func salam_js_get_num(obj: i64, name: str): f64
    func salam_js_get_str(obj: i64, name: str): str
    func salam_js_get_bool(obj: i64, name: str): bool
    func salam_js_set_prop(obj: i64, name: str, ...)
    func salam_js_call(obj: i64, method: str, ...): i64
    func salam_js_new(ctor: i64, ...): i64
    func salam_js_invoke(fn: i64, ...): i64
    func salam_js_is_nullish(x: i64): bool
    func salam_js_global(name: str): i64
    func salam_js_array0(): i64
    func salam_js_obj0(): i64
    func salam_js_new_promise(executor: func (i64, i64)): i64
    func salam_js_to_str(x: i64): str
    func salam_js_to_bool(x: i64): bool
    module: i64
    process: i64
    __dirname: i64
    __filename: i64
end

func js_to_str(x: i64): str: ret salam_js_to_str(x) end

@fa "واردکردن"
pub func Require(id: str): i64: ret require(id) end

@fa "صادرات"
pub func Exports(): i64: ret salam_js_get_prop(module, "exports") end

@fa "دریافت خاصیت"
pub func GetProp(obj: i64, name: str): i64: ret salam_js_get_prop(obj, name) end

@fa "دریافت خاصیت عددی"
pub func GetNum(obj: i64, name: str): f64: ret salam_js_get_num(obj, name) end

@fa "دریافت خاصیت رشته ای"
pub func GetStr(obj: i64, name: str): str: ret salam_js_get_str(obj, name) end

@fa "دریافت خاصیت منطقی"
pub func GetBool(obj: i64, name: str): bool: ret salam_js_get_bool(obj, name) end

@fa "تنظیم خاصیت"
pub func SetProp(obj: i64, name: str, value: i64): salam_js_set_prop(obj, name, value) end

@fa "تنظیم خاصیت رشته ای"
pub func SetStr(obj: i64, name: str, value: str): salam_js_set_prop(obj, name, value) end

@fa "تنظیم خاصیت عددی"
pub func SetNum(obj: i64, name: str, value: f64): salam_js_set_prop(obj, name, value) end

@fa "تنظیم خاصیت منطقی"
pub func SetBool(obj: i64, name: str, value: bool): salam_js_set_prop(obj, name, value) end

@fa "تنظیم خاصیت به تابع بدون آرگومان"
pub func SetPropFn0(obj: i64, name: str, fn: func ()): salam_js_set_prop(obj, name, fn) end

@fa "تنظیم خاصیت به تابع یک آرگومانی"
pub func SetPropFn1(obj: i64, name: str, fn: func (i64)): salam_js_set_prop(obj, name, fn) end

@fa "تنظیم خاصیت به تابع یک آرگومانی بازگشتی"
pub func SetPropFn1R(obj: i64, name: str, fn: func (i64) i64): salam_js_set_prop(obj, name, fn) end

@fa "فراخوانی"
pub func Call0(obj: i64, method: str): i64: ret salam_js_call(obj, method) end

@fa "فراخوانی رشته یک"
pub func CallS1(obj: i64, method: str, a: str): i64: ret salam_js_call(obj, method, a) end

@fa "فراخوانی رشته دو"
pub func CallS2(obj: i64, method: str, a: str, b: str): i64: ret salam_js_call(obj, method, a, b) end

@fa "فراخوانی رشته سه"
pub func CallS3(obj: i64, method: str, a: str, b: str, c: str): i64: ret salam_js_call(obj, method, a, b, c) end

@fa "فراخوانی با یک مقدار"
pub func CallV1(obj: i64, method: str, a: i64): i64: ret salam_js_call(obj, method, a) end

@fa "فراخوانی با دو مقدار"
pub func CallV2(obj: i64, method: str, a: i64, b: i64): i64: ret salam_js_call(obj, method, a, b) end

@fa "فراخوانی با سه مقدار"
pub func CallV3(obj: i64, method: str, a: i64, b: i64, c: i64): i64: ret salam_js_call(obj, method, a, b, c) end

@fa "فراخوانی با یک مقدار و یک رشته"
pub func CallVS1(obj: i64, method: str, a: i64, b: str): i64: ret salam_js_call(obj, method, a, b) end

@fa "فراخوانی با یک رشته و یک منطقی"
pub func CallSB1(obj: i64, method: str, a: str, b: bool): i64: ret salam_js_call(obj, method, a, b) end

@fa "فراخوانی با یک منطقی"
pub func CallB1(obj: i64, method: str, a: bool): i64: ret salam_js_call(obj, method, a) end

@fa "فراخوانی با تابع بدون آرگومان"
pub func CallFn0(obj: i64, method: str, fn: func ()): i64: ret salam_js_call(obj, method, fn) end

@fa "فراخوانی با تابع یک آرگومانی"
pub func CallFn1(obj: i64, method: str, fn: func (i64)): i64: ret salam_js_call(obj, method, fn) end

@fa "فراخوانی با رشته و تابع بدون آرگومان"
pub func CallSFn0(obj: i64, method: str, a: str, fn: func ()): i64: ret salam_js_call(obj, method, a, fn) end

@fa "ساخت"
pub func New0(ctor: i64): i64: ret salam_js_new(ctor) end

@fa "ساخت با یک مقدار"
pub func New1(ctor: i64, a: i64): i64: ret salam_js_new(ctor, a) end

@fa "ساخت با چهار مقدار"
pub func New4(ctor: i64, a: i64, b: i64, c: i64, d: i64): i64: ret salam_js_new(ctor, a, b, c, d) end

@fa "فراخوانی مقدار تابع"
pub func Invoke0(fn: i64): i64: ret salam_js_invoke(fn) end

@fa "فراخوانی مقدار تابع با یک آرگومان"
pub func Invoke1(fn: i64, a: i64): i64: ret salam_js_invoke(fn, a) end

@fa "فراخوانی مقدار تابع با دو آرگومان"
pub func Invoke2(fn: i64, a: i64, b: i64): i64: ret salam_js_invoke(fn, a, b) end

@fa "پوچ یا نامعین است"
pub func IsNullish(x: i64): bool: ret salam_js_is_nullish(x) end

@fa "سراسری"
pub func Global(name: str): i64: ret salam_js_global(name) end

@fa "آرایه تازه"
pub func NewArray(): i64: ret salam_js_array0() end

@fa "شیء تازه"
pub func NewObject(): i64: ret salam_js_obj0() end

@fa "افزودن به آرایه"
pub func Push(arr: i64, value: i64): salam_js_call(arr, "push", value) end

@fa "افزودن رشته به آرایه"
pub func PushStr(arr: i64, value: str): salam_js_call(arr, "push", value) end

@fa "وعده تازه"
pub func NewPromise(executor: func (i64, i64)): i64: ret salam_js_new_promise(executor) end

@fa "تبدیل به رشته"
pub func ToStr(x: i64): str: ret salam_js_to_str(x) end

@fa "تبدیل به منطقی"
pub func ToBool(x: i64): bool: ret salam_js_to_bool(x) end

@fa "سکو"
pub func Platform(): str: ret salam_js_get_str(process, "platform") end

@fa "ویندوز است"
pub func IsWindows(): bool: ret str.Equals(Platform(), "win32") end

@fa "پوشه موقت"
pub func TmpDir(): str:
    osmod := require("os")
    ret js_to_str(salam_js_call(osmod, "tmpdir"))
end

@fa "پیوستن مسیر"
pub func PathJoin2(a: str, b: str): str:
    pm := require("path")
    ret js_to_str(salam_js_call(pm, "join", a, b))
end

@fa "پیوستن مسیر سه"
pub func PathJoin3(a: str, b: str, c: str): str:
    pm := require("path")
    ret js_to_str(salam_js_call(pm, "join", a, b, c))
end

@fa "پوشه مسیر"
pub func PathDirname(p: str): str:
    pm := require("path")
    ret js_to_str(salam_js_call(pm, "dirname", p))
end

@fa "ساخت پوشه موقت"
pub func MkdtempSync(prefix: str): str:
    fsmod := require("fs")
    ret js_to_str(salam_js_call(fsmod, "mkdtempSync", prefix))
end

@fa "نوشتن فایل"
pub func WriteFileSync(p: str, contents: str):
    fsmod := require("fs")
    salam_js_call(fsmod, "writeFileSync", p, contents, "utf8")
end

@fa "خواندن فایل"
pub func ReadFileSync(p: str): str:
    fsmod := require("fs")
    ret js_to_str(salam_js_call(fsmod, "readFileSync", p, "utf8"))
end

@fa "حذف بازگشتی"
pub func RmSyncRecursiveForce(p: str):
    fsmod := require("fs")
    opts := salam_js_obj0()
    salam_js_set_prop(opts, "recursive", true)
    salam_js_set_prop(opts, "force", true)
    salam_js_call(fsmod, "rmSync", p, opts)
end

@fa "اجرای فایل فرزند"
pub func ExecFile(cmd: str, args: i64, cwd: str, cb: func (bool, str, str)):
    cpmod := require("child_process")
    opts := salam_js_obj0()
    salam_js_set_prop(opts, "cwd", cwd)
    salam_js_set_prop(opts, "maxBuffer", 33554432)
    handler := (err: i64, stdout: i64, stderr: i64):
        cb(!salam_js_is_nullish(err), js_to_str(stdout), js_to_str(stderr))
    end
    salam_js_call(cpmod, "execFile", cmd, args, opts, handler)
end

@fa "اجرای فایل فرزند خام"
pub func ExecFileRaw(cmd: str, args: i64, cwd: str, cb: func (i64, str, str)):
    cpmod := require("child_process")
    opts := salam_js_obj0()
    salam_js_set_prop(opts, "cwd", cwd)
    salam_js_set_prop(opts, "maxBuffer", 33554432)
    handler := (err: i64, stdout: i64, stderr: i64):
        cb(err, js_to_str(stdout), js_to_str(stderr))
    end
    salam_js_call(cpmod, "execFile", cmd, args, opts, handler)
end
