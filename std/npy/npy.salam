@en "npy"
@fa "ان‌پی‌وای"
package npy

import archive
import compress
import encoding.binary
import matrix
import mem

@en "NPY_F64"
@fa "نوع اعشاری هشت"
pub const NPY_F64 := 0

@en "NPY_F32"
@fa "نوع اعشاری چهار"
pub const NPY_F32 := 1

@en "NPY_I8"
@fa "نوع صحیح یک"
pub const NPY_I8 := 2

@en "NPY_I16"
@fa "نوع صحیح دو"
pub const NPY_I16 := 3

@en "NPY_I32"
@fa "نوع صحیح چهار"
pub const NPY_I32 := 4

@en "NPY_I64"
@fa "نوع صحیح هشت"
pub const NPY_I64 := 5

@en "NPY_U8"
@fa "نوع بی‌علامت یک"
pub const NPY_U8 := 6

@en "NPY_U16"
@fa "نوع بی‌علامت دو"
pub const NPY_U16 := 7

@en "NPY_U32"
@fa "نوع بی‌علامت چهار"
pub const NPY_U32 := 8

@en "NPY_BOOL"
@fa "نوع دودویی"
pub const NPY_BOOL := 9

@en "NpyArray"
@fa "آرایه ان‌پی‌وای"
pub struct NpyArray:
    @en "shape"
    @fa "شکل"
    pub shape: Vector<int> = Vector {}
    @en "dtype"
    @fa "نوع داده"
    pub dtype: int = NPY_F64
    @en "data"
    @fa "عنصرها"
    pub data: Vector<f64> = Vector {}

    @en "Ndim"
    @fa "شمار بعد"
    pub func Ndim(): int: ret this.shape.Len() end

    @en "ndim"
    @fa "شمار بعد"
    pub func ndim(): int: ret this.Ndim() end

    @en "Count"
    @fa "شمار"
    pub func Count(): int: ret this.data.Len() end

    @en "count"
    @fa "شمار"
    pub func count(): int: ret this.Count() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.shape.Free()
        this.data.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

func _elem_size(dtype: int): int:
    if dtype == NPY_F64 or dtype == NPY_I64: ret 8 end
    if dtype == NPY_F32 or dtype == NPY_I32 or dtype == NPY_U32: ret 4 end
    if dtype == NPY_I16 or dtype == NPY_U16: ret 2 end
    ret 1
end

func _read_elem(rd &: compress.ByteReader, dtype: int, big: bool): f64 throws:
    if dtype == NPY_F64: ret try binary.ReadF64(rd, big) end
    if dtype == NPY_F32: ret try binary.ReadF32(rd, big) end
    if dtype == NPY_I8 or dtype == NPY_U8 or dtype == NPY_BOOL:
        mut v := try binary.ReadU8(rd)
        if dtype == NPY_I8 and v >= 128: v -= 256 end
        ret v as f64
    end
    if dtype == NPY_I16 or dtype == NPY_U16:
        mut v := 0
        if big: v = try binary.ReadU16BE(rd) else:
            v = try binary.ReadU16LE(rd)
        end
        if dtype == NPY_I16 and v >= 32768: v -= 65536 end
        ret v as f64
    end
    if dtype == NPY_I32 or dtype == NPY_U32:
        mut v := 0 as i64
        if big: v = (try binary.ReadU32BE(rd)) as i64 else:
            v = (try binary.ReadU32LE(rd)) as i64
        end
        if v < 0: v += 4294967296 end
        if dtype == NPY_I32 and v >= 2147483648: v -= 4294967296 end
        ret v as f64
    end
    if big: ret (try binary.ReadU64BE(rd)) as f64 end
    ret (try binary.ReadU64LE(rd)) as f64
end

func _read_npy(p: void*, n: int): NpyArray throws:
    mut a := NpyArray {}
    mut rd := compress.NewByteReader(p, n)
    mut dtype := 0
    mut big := false
    mut fortran := false
    try:
        _read_header(rd, dtype, big, fortran, a.shape)
    catch e:
        a.shape.Free()
        throw e
    end
    mut total := 1
    repeat a.shape.Len() in i: total *= a.shape.get(i) end
    if a.shape.Len() == 0: total = 1 end
    esz := _elem_size(dtype)
    if compress.RdLeft(rd) < total * esz:
        left := compress.RdLeft(rd)
        a.shape.Free()
        throw Error.At(ErrorKind.UnexpectedEnd, "the data ends early: " + total + " elements need " + (total * esz) + " bytes, " + left + " are left", rd.pos).with_code("npy.truncated")
    end
    if fortran and a.shape.Len() > 2:
        a.shape.Free()
        throw Error.New(ErrorKind.Unsupported, "Fortran order with more than 2 dimensions is not supported").with_code("npy.fortran")
    end
    a.dtype = dtype
    a.data.alloc(total)
    pd := a.data.data
    if dtype == NPY_F64 and big == false and fortran == false:
        src := ((rd.data as i64) + (rd.pos as i64)) as void*
        mem.Copy(pd as void*, src, (total * 8) as u64)
    else fortran and a.shape.Len() == 2:
        rows := a.shape.get(0)
        cols := a.shape.get(1)
        repeat cols in j:
            repeat rows in i: pd[i * cols + j] = try _read_elem(rd, dtype, big) end
        end
    else:
        repeat total in k: pd[k] = try _read_elem(rd, dtype, big) end
    end
    if a.shape.Len() == 0: a.shape.push(1) end
    ret a
end

func _read_file(path: str): compress.ByteBuf throws:
    mut fok := false
    mut raw := archive.ReadBinaryFile(path, fok)
    if fok == false:
        compress.BufFree(raw)
        throw Error.New(ErrorKind.NotFound, "cannot open file").with_path(path).wrap("npy")
    end
    ret raw
end

@en "ReadNpy"
@fa "خواندن ان‌پی‌وای"
pub func ReadNpy(p: void*, n: int): NpyArray throws:
    try:
        ret _read_npy(p, n)
    catch e:
        throw e.wrap("npy")
    end
end

@en "ReadNpyFile"
@fa "خواندن پرونده ان‌پی‌وای"
pub func ReadNpyFile(path: str): NpyArray throws:
    mut raw := try _read_file(path)
    defer compress.BufFree(raw)
    try:
        ret _read_npy(raw.data, compress.BufLen(raw))
    catch e:
        throw e.with_path(path).wrap("npy")
    end
end

@en "WriteNpy"
@fa "نوشتن ان‌پی‌وای"
pub func WriteNpy(a &: NpyArray): compress.ByteBuf:
    mut buf := compress.NewByteBuf()
    _write_header(buf, a.shape)
    n := a.data.Len()
    compress.BufPushBytes(buf, a.data.data as void*, n * 8)
    ret buf
end

@en "WriteNpyFile"
@fa "نوشتن پرونده ان‌پی‌وای"
pub func WriteNpyFile(a &: NpyArray, path: str): bool:
    mut buf := WriteNpy(a)
    ok := archive.WriteBinaryFileBuf(path, buf)
    compress.BufFree(buf)
    ret ok
end

@en "ToMatrix"
@fa "به ماتریس"
pub func ToMatrix(a &: NpyArray): matrix.Matrix throws:
    d := a.shape.Len()
    if d != 1 and d != 2:
        throw Error.New(ErrorKind.InvalidArgument, "ToMatrix needs a 1-D or 2-D array, got " + d + " dimensions").with_code("npy.ndim").wrap("npy")
    end
    mut rows := 1
    mut cols := a.shape.get(0)
    if d == 2:
        rows = a.shape.get(0)
        cols = a.shape.get(1)
    end
    ret matrix.FromArray(rows, cols, a.data)
end

@en "FromMatrix"
@fa "از ماتریس"
pub func FromMatrix(m &: matrix.Matrix): NpyArray:
    mut a := NpyArray {}
    a.shape.push(m.rows)
    a.shape.push(m.cols)
    a.data.alloc(m.count())
    pd := a.data.data
    repeat m.count() in k: pd[k] = m.a.get(k) end
    ret a
end
