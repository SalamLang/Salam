package npy

import compress
import conv
import encoding.binary
import mem
import str

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

func _quoted_after(text: str, key: str): str:
    k := str.IndexOf(text, key)
    if k < 0: ret "" end
    n := str.Len(text)
    bp := _bp(text)
    mut i := k + str.Len(key)
    mut colon := false
    until i < n:
        c := _ub(bp, i)
        if c == 58: colon = true end
        if colon and (c == 39 or c == 34):
            mut j := i + 1
            until j < n and _ub(bp, j) != 39 and _ub(bp, j) != 34: j += 1 end
            ret str.Substr(text, i + 1, j - i - 1)
        end
        i += 1
    end
    ret ""
end

func _bool_after(text: str, key: str, found &: bool): bool:
    found = false
    k := str.IndexOf(text, key)
    if k < 0: ret false end
    rest := str.Substr(text, k + str.Len(key), str.Len(text) - k - str.Len(key))
    t := str.IndexOf(rest, "True")
    f := str.IndexOf(rest, "False")
    mem.Free(rest as void*)
    if t < 0 and f < 0: ret false end
    found = true
    if f < 0: ret true end
    if t < 0: ret false end
    ret t < f
end

func _shape_after(text: str, key: str, shape_out &: Vector<int>): bool:
    k := str.IndexOf(text, key)
    if k < 0: ret false end
    n := str.Len(text)
    bp := _bp(text)
    mut i := k + str.Len(key)
    until i < n and _ub(bp, i) != 40: i += 1 end
    if i >= n: ret false end
    i += 1
    mut cur := 0
    mut have := false
    until i < n:
        c := _ub(bp, i)
        if c >= 48 and c <= 57:
            cur = cur * 10 + (c - 48)
            have = true
        else c == 44:
            if have: shape_out.push(cur) end
            cur = 0
            have = false
        else c == 41:
            if have: shape_out.push(cur) end
            ret true
        else c != 32:
            ret false
        end
        i += 1
    end
    ret false
end

func _descr_to_dtype(descr: str, dtype &: int, big &: bool): bool:
    n := str.Len(descr)
    if n < 2: ret false end
    bp := _bp(descr)
    mut i := 0
    c0 := _ub(bp, 0)
    big = false
    if c0 == 60 or c0 == 124 or c0 == 61:
        i = 1
    else c0 == 62:
        big = true
        i = 1
    end
    if i >= n: ret false end
    kind := _ub(bp, i)
    mut size := 0
    mut j := i + 1
    until j < n:
        d := _ub(bp, j)
        if d < 48 or d > 57: ret false end
        size = size * 10 + (d - 48)
        j += 1
    end
    if kind == 102:
        if size == 8: dtype = NPY_F64 ret true end
        if size == 4: dtype = NPY_F32 ret true end
        ret false
    end
    if kind == 105:
        if size == 1: dtype = NPY_I8 ret true end
        if size == 2: dtype = NPY_I16 ret true end
        if size == 4: dtype = NPY_I32 ret true end
        if size == 8: dtype = NPY_I64 ret true end
        ret false
    end
    if kind == 117:
        if size == 1: dtype = NPY_U8 ret true end
        if size == 2: dtype = NPY_U16 ret true end
        if size == 4: dtype = NPY_U32 ret true end
        ret false
    end
    if kind == 98 and size == 1:
        dtype = NPY_BOOL
        ret true
    end
    ret false
end

func _npy_err(kind: ErrorKind, msg: str, at: int, code: str): Error:
    ret Error.At(kind, msg, at).with_code(code)
end

func _read_header(rd &: compress.ByteReader, dtype &: int, big &: bool, fortran &: bool, shape_out &: Vector<int>) throws:
    word := "NUMPY"
    repeat 6 in k:
        mut want := 147
        if k > 0: want = _ub(_bp(word), k - 1) end
        if (try binary.ReadU8(rd)) != want:
            throw _npy_err(ErrorKind.Syntax, "not a .npy file (bad magic bytes)", 0, "npy.bad_magic")
        end
    end
    major := try binary.ReadU8(rd)
    try binary.ReadU8(rd)
    mut hlen := 0
    if major == 1:
        hlen = try binary.ReadU16LE(rd)
    else major == 2 or major == 3:
        hlen = try binary.ReadU32LE(rd)
    else:
        throw _npy_err(ErrorKind.Unsupported, "unsupported .npy format version " + major, 6, "npy.version")
    end
    at := rd.pos
    if hlen <= 0 or compress.RdLeft(rd) < hlen:
        throw _npy_err(ErrorKind.UnexpectedEnd, "the header says " + hlen + " bytes but " + compress.RdLeft(rd) + " are left", at, "npy.truncated")
    end
    mut hb := compress.RdBytes(rd, hlen)
    text := compress.BufToStrUnsafe(hb)
    compress.BufFree(hb)
    defer mem.Free(text as void*)
    descr := _quoted_after(text, "descr")
    if str.Len(descr) == 0:
        throw _npy_err(ErrorKind.Syntax, "the header has no 'descr'", at, "npy.bad_header")
    end
    defer mem.Free(descr as void*)
    if _descr_to_dtype(descr, dtype, big) == false:
        throw _npy_err(ErrorKind.Unsupported, "unsupported dtype '" + descr + "'", at, "npy.dtype")
    end
    mut found := false
    fortran = _bool_after(text, "fortran_order", found)
    if found == false:
        throw _npy_err(ErrorKind.Syntax, "the header has no 'fortran_order'", at, "npy.bad_header")
    end
    if _shape_after(text, "shape", shape_out) == false:
        throw _npy_err(ErrorKind.Syntax, "the header has no valid 'shape'", at, "npy.bad_header")
    end
end

func _write_header(buf &: compress.ByteBuf, shape &: Vector<int>):
    mut sb := str.NewBuilder()
    str.BufAppend(sb, "{'descr': '<f8', 'fortran_order': False, 'shape': (")
    repeat shape.len() in i:
        str.BufAppendInt(sb, shape.get(i) as i64)
        if shape.len() == 1 or i + 1 < shape.len(): str.BufAppendChar(sb, 44) end
        if i + 1 < shape.len(): str.BufAppendChar(sb, 32) end
    end
    str.BufAppend(sb, "), }")
    total := 10 + (str.BufLen(sb) as int) + 1
    mut pad := 0
    if total % 64 != 0: pad = 64 - total % 64 end
    repeat pad: str.BufAppendChar(sb, 32) end
    str.BufAppendChar(sb, 10)
    dict := str.BufStr(sb)
    str.BufFree(sb)
    binary.WriteU8(buf, 147)
    compress.BufPushBytes(buf, "NUMPY" as void*, 5)
    binary.WriteU8(buf, 1)
    binary.WriteU8(buf, 0)
    binary.WriteU16LE(buf, str.Len(dict))
    compress.BufPushBytes(buf, dict as void*, str.Len(dict))
    mem.Free(dict as void*)
end
