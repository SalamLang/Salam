package npy

import archive
import compress
import mem
import str

func _strip_npy(name: str): str:
    if str.EndsWith(name, ".npy"):
        ret str.Substr(name, 0, str.Len(name) - 4)
    end
    ret str.Clone(name)
end

@en "NpzList"
@fa "فهرست ان‌پی‌زد"
pub func NpzList(path: str): Vector<str> throws:
    mut raw := try _read_file(path)
    defer compress.BufFree(raw)
    mut entries := archive.ZipList(raw.data, compress.BufLen(raw))
    defer archive.FreeEntries(entries)
    if entries.Len() == 0:
        throw Error.New(ErrorKind.Syntax, "not a .npz file (no zip entries)").with_code("npy.bad_npz").with_path(path).wrap("npy")
    end
    mut out := Vector {} as Vector<str>
    repeat entries.Len() in i:
        e := entries.get(i)
        if e.is_dir == false: out.push(_strip_npy(e.name)) end
    end
    ret out
end

@en "NpzRead"
@fa "خواندن ان‌پی‌زد"
pub func NpzRead(path: str, key: str): NpyArray throws:
    mut raw := try _read_file(path)
    defer compress.BufFree(raw)
    mut zok := false
    named := key + ".npy"
    mut member := archive.ZipExtractByName(raw.data, compress.BufLen(raw), named, zok)
    mem.Free(named as void*)
    if zok == false:
        compress.BufFree(member)
        member = archive.ZipExtractByName(raw.data, compress.BufLen(raw), key, zok)
    end
    defer compress.BufFree(member)
    if zok == false:
        throw Error.New(ErrorKind.NotFound, "no array named '" + key + "'").with_code("npy.missing_key").with_path(path).wrap("npy")
    end
    try:
        ret _read_npy(member.data, compress.BufLen(member))
    catch e:
        throw e.with_path(path + ":" + key).wrap("npy")
    end
end

@en "NpzWrite"
@fa "نوشتن ان‌پی‌زد"
pub func NpzWrite(path: str, keys &: Vector<str>, arrays &: Vector<NpyArray>): bool:
    if keys.Len() != arrays.Len() or keys.Len() == 0: ret false end
    mut bufs := Vector {} as Vector<compress.ByteBuf>
    mut inputs := Vector {} as Vector<archive.ZipFileInput>
    repeat keys.Len() in i:
        mut a := arrays.get(i)
        b := WriteNpy(a)
        mut fi := archive.ZipFileInput {}
        fi.name = keys.get(i) + ".npy"
        fi.data_ptr = b.data
        fi.data_len = compress.BufLen(b)
        fi.method = 0
        inputs.push(fi)
        bufs.push(b)
    end
    ok := archive.ZipCreateFile(inputs, path)
    repeat bufs.Len() in i:
        mut b := bufs.get(i)
        compress.BufFree(b)
    end
    repeat inputs.Len() in i: mem.Free(inputs.get(i).name as void*) end
    bufs.Free()
    inputs.Free()
    ret ok
end
