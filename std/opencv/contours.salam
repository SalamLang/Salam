package opencv

import mem

// Contour detection (cv::findContours) - the standard next step after
// thresholding: find the outlines of the resulting white blobs, then
// measure/filter/draw them. Typical pipeline:
//
//   edges := img.to_gray().threshold_otsu(255.0)
//   cs := edges.find_contours()
//   mut i := 0
//   until i < cs.count():
//       if cs.area(i) > 500.0:               // drop tiny noise contours
//           r := cs.bounding_rect(i)
//           img.rectangle(r.x, r.y, r.width, r.height, opencv.RGB(0, 255, 0), 2)
//       end
//       i += 1
//   end
//   cs.free()

@en "Contours"
@fa "پیرامون‌ها"
@ar "كونتورات"
pub struct Contours:
    pub handle: void* = null

    @en "ok"
    @fa "معتبر"
    @ar "صالح"
    pub func ok(): bool: ret this.handle != null end

    @en "count"
    @fa "تعداد"
    @ar "عدد"
    pub func count(): int:
        if this.handle == null: ret 0 end
        ret scv_contour_count(this.handle)
    end

    // Number of boundary points in contour `idx`.
    @en "point_count"
    @fa "تعداد نقطه"
    @ar "عدد النقاط"
    pub func point_count(idx: int): int:
        if this.handle == null: ret 0 end
        ret scv_contour_point_count(this.handle, idx)
    end

    // Boundary point `pt_idx` of contour `idx`. Out-of-range indices
    // return the zero Point rather than erroring.
    @en "point"
    @fa "نقطه"
    @ar "نقطة"
    pub func point(idx: int, pt_idx: int): Point:
        if this.handle == null: ret Point {} end
        buf := mem.Allocate(8 as u64)
        defer mem.Free(buf)
        p := buf as i32*
        scv_contour_point_get(this.handle, idx, pt_idx, p)
        ret Point { x = p[0] as int, y = p[1] as int }
    end

    // Enclosed area of contour `idx`, in pixels - the usual way to filter
    // out tiny noise contours before acting on the rest.
    @en "area"
    @fa "مساحت"
    @ar "مساحة"
    pub func area(idx: int): f64:
        if this.handle == null: ret 0.0 end
        ret scv_contour_area(this.handle, idx)
    end

    // Axis-aligned bounding box of contour `idx`.
    @en "bounding_rect"
    @fa "مستطیل محاط"
    @ar "المستطيل المحيط"
    pub func bounding_rect(idx: int): Rect:
        if this.handle == null: ret Rect {} end
        buf := mem.Allocate(16 as u64)
        defer mem.Free(buf)
        p := buf as i32*
        scv_contour_bounding_rect(this.handle, idx, p)
        ret Rect { x = p[0] as int, y = p[1] as int, width = p[2] as int, height = p[3] as int }
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free():
        if this.handle != null: scv_free_contours(this.handle) end
        this.handle = null
    end
end
