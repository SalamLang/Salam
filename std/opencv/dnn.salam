package opencv

import collections

@en "Net"
@fa "شبکه"
pub struct Net:
    pub handle: void* = null

    @en "ok"
    @fa "معتبر"
    pub func ok(): bool: ret this.handle != null end

    @en "set_input"
    @fa "تنظیم ورودی"
    pub func set_input(image: Mat, scale: f64, mean: Color, swap_rb: bool, size: Size): bool:
        if this.handle == null || image.handle == null: ret false end
        mut swap := 0
        if swap_rb: swap = 1 end
        ret scv_dnn_set_input(this.handle, image.handle, scale, mean.r as f64, mean.g as f64, mean.b as f64, swap, size.width, size.height) != 0
    end

    @en "forward"
    @fa "پیش‌رو"
    pub func forward(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_dnn_forward(this.handle) }
    end

    @en "forward_layer"
    @fa "پیش‌رو لایه"
    pub func forward_layer(layer_name: str): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_dnn_forward_named(this.handle, layer_name) }
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        if this.handle != null: scv_dnn_free(this.handle) end
        this.handle = null
    end
end

@en "Detection"
@fa "شناسایی"
pub struct Detection:
    pub class_id: int = 0
    pub confidence: f64 = 0.0
    pub x: int = 0
    pub y: int = 0
    pub width: int = 0
    pub height: int = 0
end

@en "LoadNet"
@fa "بارگذاری شبکه"
pub func LoadNet(model_path: str, config_path: str): Net:
    ret Net { handle = scv_dnn_load(model_path, config_path) }
end

@en "LoadNetSingleFile"
@fa "بارگذاری شبکه تک‌فایل"
pub func LoadNetSingleFile(path: str): Net:
    ret LoadNet(path, "")
end

@en "ParseSSDDetections"
@fa "تجزیه شناسایی‌های اس‌اس‌دی"
pub func ParseSSDDetections(output: Mat, img_width: int, img_height: int, confidence_threshold: f64): Vector<Detection>:
    mut out := Vector {} as Vector<Detection>
    if output.handle == null: ret out end
    n := output.total() / 7
    p := output.data() as f32*
    mut i := 0
    until i < n:
        base := i * 7
        confidence := p[base + 2] as f64
        if confidence >= confidence_threshold:
            x1 := ((p[base + 3] as f64) * (img_width as f64)) as int
            y1 := ((p[base + 4] as f64) * (img_height as f64)) as int
            x2 := ((p[base + 5] as f64) * (img_width as f64)) as int
            y2 := ((p[base + 6] as f64) * (img_height as f64)) as int
            out.push(
                Detection {
                    class_id = p[base + 1] as int, confidence = confidence, x = x1, y = y1, width = x2 - x1, height = y2 - y1,
                }
            )
        end
        i += 1
    end
    ret out
end
