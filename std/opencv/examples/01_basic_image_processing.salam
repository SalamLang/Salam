// std/opencv example: basic image processing.
//
// Loads an image, converts it to grayscale, runs Canny edge detection,
// resizes the original, and saves both results next to the input.
// Needs the native shim built and linked - see native/BUILD.md.
//
//   salam run 01_basic_image_processing.salam -- path/to/input.jpg

import opencv
import os

func main:
    args := os.Args()
    mut path := "input.jpg"
    if args.len() > 1:
        path = args.get(1)
    end

    img := opencv.Read(path)
    if !img.ok():
        println "failed to read", path, "-", opencv.LastError()
        ret 1
    end
    println "loaded", path, "-", img.width(), "x", img.height(), img.channels(), "channels"

    gray := img.to_gray()
    edges := gray.canny(50.0, 150.0)
    opencv.Write("edges.png", edges)
    println "wrote edges.png"

    resized := img.resize(800, 600, opencv.INTERP_LINEAR)
    opencv.Write("resized.png", resized)
    println "wrote resized.png"

    img.free()
    gray.free()
    edges.free()
    resized.free()
    ret 0
end
