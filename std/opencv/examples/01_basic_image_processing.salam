import opencv
import os

func main:
    args := os.Args()
    mut path := "input.jpg"
    if args.Len() > 1:
        path = args.Get(1)
    end

    img := opencv.Read(path)
    if not img.ok():
        println "failed to read", path, "-", opencv.LastError()
        ret 1
    end
    println "loaded", path, "-", img.width(), "x", img.height(), img.channels(), "channels"

    gray := img.to_gray()
    edges := gray.canny(50.0, 150.0)
    opencv.Write("edges.png", edges)
    println "wrote edges.png"

    resized := img.resize(800, 600, opencv.INTERP_LINEAR)
    opencv.Write("resized.png", resized)
    println "wrote resized.png"

    defer img.Free()
    defer gray.Free()
    defer edges.Free()
    defer resized.Free()
    ret 0
end
