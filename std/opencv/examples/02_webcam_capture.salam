// std/opencv example: real-time webcam capture.
//
// Opens the default camera, runs Canny edge detection on every frame, and
// shows both the raw and processed feed until 'q' or Esc is pressed. Needs
// the native shim built with highgui support - see native/BUILD.md.
//
//   salam run 02_webcam_capture.salam

import opencv

func main:
    cam := opencv.OpenCamera(0)
    if !cam.ok():
        println "could not open camera 0 -", opencv.LastError()
        ret 1
    end
    println "camera open - press 'q' or Esc to quit"

    mut running := true
    until running:
        frame := cam.read()
        if !frame.ok():
            println "frame read failed -", opencv.LastError()
            running = false
        else:
            edges := frame.to_gray().canny(50.0, 150.0)
            opencv.Imshow("Camera", frame)
            opencv.Imshow("Edges", edges)
            frame.free()
            edges.free()

            key := opencv.WaitKey(1)
            if key == 113 || key == 27: // 'q' or Esc
                running = false
            end
        end
    end

    cam.close()
    opencv.DestroyAllWindows()
    ret 0
end
