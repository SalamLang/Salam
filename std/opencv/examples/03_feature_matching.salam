// std/opencv example: ORB feature detection and matching.
//
// Detects ORB keypoints in two images, matches their descriptors, and
// prints the strongest matches - the same pipeline used for panorama
// stitching, logo/object recognition, and simple tracking. Needs the
// native shim built and linked - see native/BUILD.md.
//
//   salam run 03_feature_matching.salam -- sceneA.jpg sceneB.jpg

import opencv
import os

func main:
    args := os.Args()
    if args.len() < 3:
        println "usage: 03_feature_matching <image_a> <image_b>"
        ret 1
    end
    path_a := args.get(1)[0]
    path_b := args.get(2)[0]

    a := opencv.Read(path_a)
    b := opencv.Read(path_b)
    if !a.ok() || !b.ok():
        println "failed to read one of the images -", opencv.LastError()
        ret 1
    end

    kp_a := a.detect_orb(500)
    kp_b := b.detect_orb(500)
    println path_a, "-", kp_a.count(), "keypoints"
    println path_b, "-", kp_b.count(), "keypoints"

    desc_a := kp_a.descriptors()
    desc_b := kp_b.descriptors()
    matches := opencv.MatchDescriptors(desc_a, desc_b, 30, opencv.NORM_HAMMING) as Vector<opencv.Match>
    println matches.len(), "matches (best first)"

    mut i := 0
    until i < matches.len():
        m := matches.get(i)[0]
        println "  query", m.query_idx, "-> train", m.train_idx, "distance", m.distance
        i += 1
    end

    a.free()
    b.free()
    kp_a.free()
    kp_b.free()
    desc_a.free()
    desc_b.free()
    ret 0
end
