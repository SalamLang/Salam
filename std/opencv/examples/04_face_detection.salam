
import opencv
import os

func main:
    args := os.Args()
    if args.len() < 3:
        println "usage: 04_face_detection <image> <cascade.xml>"
        ret 1
    end
    img := opencv.Read(args.get(1))
    if !img.ok():
        println "failed to read image -", opencv.LastError()
        ret 1
    end

    cascade := opencv.LoadCascade(args.get(2))
    if !cascade.ok():
        println "failed to load cascade -", opencv.LastError()
        ret 1
    end

    gray := img.to_gray()
    faces := cascade.detect(gray, 1.1, 3, 50) as Vector<opencv.DetectedObject>
    println "found", faces.len(), "face(s)"

    mut i := 0
    until i < faces.len():
        f := faces.get(i)
        println "  face at (", f.x, ",", f.y, ") size", f.width, "x", f.height
        img.rectangle(f.x, f.y, f.width, f.height, opencv.RGB(0, 255, 0), 2)
        i += 1
    end

    opencv.Write("faces.png", img)
    println "wrote faces.png"

    defer img.free()
    defer gray.free()
    defer cascade.free()
    ret 0
end
