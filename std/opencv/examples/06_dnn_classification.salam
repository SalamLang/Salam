
import opencv
import os

func main:
    args := os.Args()
    if args.len() < 3:
        println "usage: 06_dnn_classification <image> <model.onnx>"
        ret 1
    end

    img := opencv.Read(args.get(1))
    if !img.ok():
        println "failed to read image -", opencv.LastError()
        ret 1
    end

    net := opencv.LoadNetSingleFile(args.get(2))
    if !net.ok():
        println "failed to load model -", opencv.LastError()
        ret 1
    end

    ok := net.set_input(img, 1.0 / 255.0, opencv.RGB(0, 0, 0), true, opencv.Size { width = 224, height = 224 })
    if !ok:
        println "set_input failed -", opencv.LastError()
        ret 1
    end

    output := net.forward()
    if !output.ok():
        println "forward pass failed -", opencv.LastError()
        ret 1
    end

    n := output.total()
    p := output.data() as f32*
    mut best_idx := 0
    mut best_score := p[0]
    mut i := 1
    until i < n:
        if p[i] > best_score:
            best_score = p[i]
            best_idx = i
        end
        i += 1
    end
    println "predicted class:", best_idx, "score:", best_score

    defer img.free()
    defer net.free()
    defer output.free()
    ret 0
end
