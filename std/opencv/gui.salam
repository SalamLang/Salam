package opencv

// Minimal windowed preview (cv::highgui) - handy for local development and
// debugging a pipeline interactively. This module is optional: OpenCV
// builds without GUI support (headless/server builds, no GTK/Win32/Cocoa
// backend) will have these calls fail gracefully (native shim reports
// "no GUI support" via LastError()); don't depend on it for anything
// running on a server. See examples/02_webcam_capture.salam.

// Shows `m` in a named window, creating it on first use.
@en "Imshow"
@fa "نمایش تصویر"
@ar "عرض الصورة"
pub func Imshow(window: str, m: Mat):
    if m.handle == null: ret end
    scv_imshow(window, m.handle)
end

// Pumps the GUI event loop and waits up to delay_ms for a key press (0
// waits forever). Returns the key code, or -1 if none was pressed before
// the timeout - call this after every Imshow, exactly like cv::waitKey,
// or the window will appear frozen.
@en "WaitKey"
@fa "انتظار کلید"
@ar "انتظار مفتاح"
pub func WaitKey(delay_ms: int): int:
    ret scv_wait_key(delay_ms)
end

@en "DestroyWindow"
@fa "بستن پنجره"
@ar "إغلاق النافذة"
pub func DestroyWindow(window: str):
    scv_destroy_window(window)
end

@en "DestroyAllWindows"
@fa "بستن همه پنجره‌ها"
@ar "إغلاق كل النوافذ"
pub func DestroyAllWindows():
    scv_destroy_all_windows()
end

// Creates a slider named `name` in `window` (created first with Imshow if
// it doesn't exist yet), 0..max, starting at `initial`. Deliberately
// poll-based rather than callback-based - read the current position with
// GetTrackbarPos() once per frame in your main loop (the standard OpenCV
// pattern for interactive parameter tuning) instead of registering a
// callback, since Salam's FFI has no ergonomic way to hand a native C
// callback a Salam closure across languages.
@en "CreateTrackbar"
@fa "ایجاد نوار لغزنده"
@ar "إنشاء شريط تمرير"
pub func CreateTrackbar(name: str, window: str, initial: int, max: int): bool:
    ret scv_create_trackbar(name, window, initial, max) != 0
end

@en "GetTrackbarPos"
@fa "موقعیت نوار لغزنده"
@ar "موضع شريط التمرير"
pub func GetTrackbarPos(name: str, window: str): int:
    ret scv_get_trackbar_pos(name, window)
end

@en "SetTrackbarPos"
@fa "تنظیم موقعیت نوار لغزنده"
@ar "تعيين موضع شريط التمرير"
pub func SetTrackbarPos(name: str, window: str, pos: int):
    scv_set_trackbar_pos(name, window, pos)
end
