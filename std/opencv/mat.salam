package opencv

import mem
import collections

@en "Mat"
@fa "ماتریس"
@ar "مصفوفة"
pub struct Mat:
    pub handle: void* = null

    @en "ok"
    @fa "معتبر"
    @ar "صالح"
    pub func ok(): bool: ret this.handle != null end

    @en "empty"
    @fa "خالی"
    @ar "فارغ"
    pub func empty(): bool:
        if this.handle == null: ret true end
        ret scv_empty(this.handle) != 0
    end

    @en "width"
    @fa "عرض"
    @ar "عرض"
    pub func width(): int:
        if this.handle == null: ret 0 end
        ret scv_width(this.handle)
    end

    @en "height"
    @fa "ارتفاع"
    @ar "ارتفاع"
    pub func height(): int:
        if this.handle == null: ret 0 end
        ret scv_height(this.handle)
    end

    @en "channels"
    @fa "کانال‌ها"
    @ar "قنوات"
    pub func channels(): int:
        if this.handle == null: ret 0 end
        ret scv_channels(this.handle)
    end

    @en "size"
    @fa "اندازه"
    @ar "حجم"
    pub func size(): Size: ret Size { width = this.width(), height = this.height() } end

    @en "clone"
    @fa "کپی"
    @ar "استنساخ"
    pub func clone(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_clone(this.handle) }
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free():
        if this.handle != null:
            scv_free(this.handle)
        end
        this.handle = null
    end

    @en "save"
    @fa "ذخیره"
    @ar "حفظ"
    pub func save(path: str): bool:
        if this.handle == null: ret false end
        ret scv_write(path, this.handle) != 0
    end

    @en "data"
    @fa "داده"
    @ar "بيانات"
    pub func data(): void*:
        if this.handle == null: ret null end
        ret scv_data(this.handle)
    end

    @en "step"
    @fa "گام"
    @ar "خطوة"
    pub func step(): int:
        if this.handle == null: ret 0 end
        ret scv_step(this.handle)
    end

    @en "total"
    @fa "مجموع"
    @ar "المجموع"
    pub func total(): int:
        if this.handle == null: ret 0 end
        ret scv_mat_total(this.handle)
    end

    @en "at"
    @fa "در"
    @ar "عند"
    pub func at(x: int, y: int): Color:
        if this.handle == null: ret Color { r = 0, g = 0, b = 0 } end
        buf := mem.Allocate(12 as u64)
        defer mem.Free(buf)
        p := buf as i32*
        if scv_get_pixel(this.handle, x, y, p) == 0:
            ret Color { r = 0, g = 0, b = 0 }
        end
        ret Color { r = p[0], g = p[1], b = p[2] }
    end

    @en "set_pixel"
    @fa "تنظیم پیکسل"
    @ar "عيّن بكسل"
    pub func set_pixel(x: int, y: int, c: Color):
        if this.handle == null: ret end
        scv_set_pixel(this.handle, x, y, c.r, c.g, c.b)
    end

    @en "convert_color"
    @fa "تبدیل رنگ"
    @ar "تحويل اللون"
    pub func convert_color(code: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_cvt_color(this.handle, code) }
    end

    @en "to_gray"
    @fa "به خاکستری"
    @ar "إلى رمادي"
    pub func to_gray(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        if this.channels() == 1: ret this.clone() end
        ret this.convert_color(COLOR_BGR2GRAY)
    end

    @en "to_rgb"
    @fa "به آر‌جی‌بی"
    @ar "إلى آر جي بي"
    pub func to_rgb(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        if this.channels() != 1: ret this.clone() end
        ret this.convert_color(COLOR_GRAY2BGR)
    end

    @en "to_hsv"
    @fa "به اچ‌اس‌وی"
    @ar "إلى إتش إس في"
    pub func to_hsv(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret this.convert_color(COLOR_BGR2HSV)
    end

    @en "hsv_to_rgb"
    @fa "اچ‌اس‌وی به آر‌جی‌بی"
    @ar "إتش إس في إلى آر جي بي"
    pub func hsv_to_rgb(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret this.convert_color(COLOR_HSV2BGR)
    end

    @en "resize"
    @fa "تغییر اندازه"
    @ar "تغییر الحجم"
    pub func resize(width: int, height: int, interpolation: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_resize(this.handle, width, height, interpolation) }
    end

    @en "resize_scale"
    @fa "تغییر اندازه با ضریب"
    @ar "تغییر الحجم بمعامل"
    pub func resize_scale(fx: f64, fy: f64): Mat:
        if this.handle == null: ret Mat { handle = null } end
        w := ((this.width() as f64) * fx) as int
        h := ((this.height() as f64) * fy) as int
        ret this.resize(w, h, INTERP_LINEAR)
    end

    @en "crop"
    @fa "برش"
    @ar "قص"
    pub func crop(x: int, y: int, w: int, h: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_crop(this.handle, x, y, w, h) }
    end

    @en "rotate90"
    @fa "چرخش نود درجه"
    @ar "دوران تسعين درجة"
    pub func rotate90(code: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_rotate90(this.handle, code) }
    end

    @en "rotate"
    @fa "چرخش"
    @ar "دوران"
    pub func rotate(angle_degrees: f64, scale: f64): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_rotate_angle(this.handle, angle_degrees, scale) }
    end

    @en "flip"
    @fa "بازتاب"
    @ar "انعكاس"
    pub func flip(mode: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_flip(this.handle, mode) }
    end

    @en "flip_horizontal"
    @fa "بازتاب افقی"
    @ar "انعكاس أفقي"
    pub func flip_horizontal(): Mat: ret this.flip(FLIP_HORIZONTAL) end

    @en "flip_vertical"
    @fa "بازتاب عمودی"
    @ar "انعكاس عمودي"
    pub func flip_vertical(): Mat: ret this.flip(FLIP_VERTICAL) end

    @en "blur"
    @fa "تاری"
    @ar "تمويه"
    pub func blur(ksize: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_blur(this.handle, ksize) }
    end

    @en "gaussian_blur"
    @fa "تاری گاوسی"
    @ar "تمويه غاوسي"
    pub func gaussian_blur(ksize: int, sigma: f64): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_gaussian_blur(this.handle, ksize, sigma) }
    end

    @en "median_blur"
    @fa "تاری میانه"
    @ar "تمويه وسيط"
    pub func median_blur(ksize: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_median_blur(this.handle, ksize) }
    end

    @en "canny"
    @fa "لبه‌یابی کنی"
    @ar "كشف حواف كاني"
    pub func canny(t1: f64, t2: f64): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_canny(this.handle, t1, t2) }
    end

    @en "threshold"
    @fa "آستانه‌گذاری"
    @ar "عتبة"
    pub func threshold(thresh: f64, maxval: f64, kind: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_threshold(this.handle, thresh, maxval, kind) }
    end

    @en "threshold_otsu"
    @fa "آستانه اوتسو"
    @ar "عتبة أوتسو"
    pub func threshold_otsu(maxval: f64): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_threshold(this.handle, 0.0, maxval, THRESH_OTSU) }
    end

    @en "adaptive_threshold"
    @fa "آستانه تطبیقی"
    @ar "عتبة تكيفية"
    pub func adaptive_threshold(maxval: f64, method: int, kind: int, block_size: int, c: f64): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_adaptive_threshold(this.handle, maxval, method, kind, block_size, c) }
    end

    @en "histogram_gray"
    @fa "هیستوگرام خاکستری"
    @ar "مدرج تكراري رمادي"
    pub func histogram_gray(): Vector<int>:
        mut out := Vector {} as Vector<int>
        if this.handle == null: ret out end
        buf := mem.AllocateZeroed((256 * 4) as u64)
        defer mem.Free(buf)
        p := buf as i32*
        scv_hist_gray(this.handle, p)
        mut i := 0
        until i < 256:
            out.push(p[i])
            i += 1
        end
        ret out
    end

    @en "line"
    @fa "خط"
    @ar "خط"
    pub func line(x1: int, y1: int, x2: int, y2: int, color: Color, thickness: int):
        if this.handle == null: ret end
        scv_line(this.handle, x1, y1, x2, y2, color.r, color.g, color.b, thickness)
    end

    @en "rectangle"
    @fa "مستطیل"
    @ar "مستطيل"
    pub func rectangle(x: int, y: int, w: int, h: int, color: Color, thickness: int):
        if this.handle == null: ret end
        scv_rectangle(this.handle, x, y, w, h, color.r, color.g, color.b, thickness)
    end

    @en "circle"
    @fa "دایره"
    @ar "دائرة"
    pub func circle(cx: int, cy: int, radius: int, color: Color, thickness: int):
        if this.handle == null: ret end
        scv_circle(this.handle, cx, cy, radius, color.r, color.g, color.b, thickness)
    end

    @en "put_text"
    @fa "نوشتن متن"
    @ar "كتابة نص"
    pub func put_text(text: str, x: int, y: int, font_scale: f64, color: Color, thickness: int):
        if this.handle == null: ret end
        scv_put_text(this.handle, text, x, y, font_scale, color.r, color.g, color.b, thickness)
    end

    @en "good_features"
    @fa "ویژگی‌های خوب"
    @ar "ميزات جيدة"
    pub func good_features(max_corners: int, quality: f64, min_dist: f64): Vector<Point>:
        mut out := Vector {} as Vector<Point>
        if this.handle == null || max_corners <= 0: ret out end
        xbuf := mem.Allocate((max_corners * 4) as u64)
        ybuf := mem.Allocate((max_corners * 4) as u64)
        defer mem.Free(xbuf)
        defer mem.Free(ybuf)
        xp := xbuf as i32*
        yp := ybuf as i32*
        n := scv_good_features(this.handle, max_corners, quality, min_dist, xp, yp)
        mut i := 0
        until i < n:
            out.push(Point { x = xp[i], y = yp[i] })
            i += 1
        end
        ret out
    end

    @en "detect_orb"
    @fa "شناسایی اور‌بی"
    @ar "كشف أوربي"
    pub func detect_orb(max_features: int): Keypoints:
        if this.handle == null: ret Keypoints { handle = null } end
        ret Keypoints { handle = scv_orb_detect(this.handle, max_features) }
    end

    @en "detect_sift"
    @fa "شناسایی سیفت"
    @ar "كشف سيفت"
    pub func detect_sift(max_features: int): Keypoints:
        if this.handle == null: ret Keypoints { handle = null } end
        ret Keypoints { handle = scv_sift_detect(this.handle, max_features) }
    end

    @en "erode"
    @fa "فرسایش"
    @ar "تآكل"
    pub func erode(ksize: int, iterations: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_erode(this.handle, ksize, iterations) }
    end

    @en "dilate"
    @fa "اتساع"
    @ar "تمدد"
    pub func dilate(ksize: int, iterations: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_dilate(this.handle, ksize, iterations) }
    end

    @en "morphology"
    @fa "ریخت‌شناسی"
    @ar "مورفولوجيا"
    pub func morphology(op: int, ksize: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_morphology(this.handle, op, ksize) }
    end

    @en "blend"
    @fa "ترکیب"
    @ar "مزج"
    pub func blend(other: Mat, alpha: f64, beta: f64, gamma: f64): Mat:
        if this.handle == null || other.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_add_weighted(this.handle, alpha, other.handle, beta, gamma) }
    end

    @en "bitwise"
    @fa "بیتی"
    @ar "بتّي"
    pub func bitwise(other: Mat, op: int): Mat:
        if this.handle == null || other.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_bitwise(this.handle, other.handle, op) }
    end

    @en "bitwise_not"
    @fa "نقیض بیتی"
    @ar "نفي بتّي"
    pub func bitwise_not(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_bitwise_not(this.handle) }
    end

    @en "abs_diff"
    @fa "تفاضل مطلق"
    @ar "فرق مطلق"
    pub func abs_diff(other: Mat): Mat:
        if this.handle == null || other.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_abs_diff(this.handle, other.handle) }
    end

    @en "warp_perspective"
    @fa "تاب دیدگاهی"
    @ar "تحويل منظوري"
    pub func warp_perspective(src: Vector<Point>, out_width: int, out_height: int): Mat:
        if this.handle == null || src.len() != 4: ret Mat { handle = null } end
        src_buf := mem.Allocate(64 as u64)
        dst_buf := mem.Allocate(64 as u64)
        defer mem.Free(src_buf)
        defer mem.Free(dst_buf)
        sp := src_buf as f64*
        dp := dst_buf as f64*
        mut i := 0
        until i < 4:
            p := src.get(i)
            sp[i * 2] = p.x as f64
            sp[i * 2 + 1] = p.y as f64
            i += 1
        end
        dp[0] = 0.0
        dp[1] = 0.0
        dp[2] = (out_width - 1) as f64
        dp[3] = 0.0
        dp[4] = (out_width - 1) as f64
        dp[5] = (out_height - 1) as f64
        dp[6] = 0.0
        dp[7] = (out_height - 1) as f64
        ret Mat { handle = scv_warp_perspective_quad(this.handle, sp, dp, out_width, out_height) }
    end

    @en "find_template"
    @fa "یافتن الگو"
    @ar "إيجاد قالب"
    pub func find_template(template: Mat): TemplateMatch:
        if this.handle == null || template.handle == null:
            ret TemplateMatch { found = false }
        end
        xbuf := mem.Allocate(4 as u64)
        ybuf := mem.Allocate(4 as u64)
        sbuf := mem.Allocate(8 as u64)
        defer mem.Free(xbuf)
        defer mem.Free(ybuf)
        defer mem.Free(sbuf)
        xp := xbuf as i32*
        yp := ybuf as i32*
        sp := sbuf as f64*
        ok := scv_match_template(this.handle, template.handle, xp, yp, sp)
        if ok == 0: ret TemplateMatch { found = false } end
        ret TemplateMatch { found = true, x = xp[0], y = yp[0], score = sp[0] }
    end

    @en "ellipse"
    @fa "بیضی"
    @ar "قطع ناقص"
    pub func ellipse(cx: int, cy: int, axis_width: int, axis_height: int, angle_degrees: f64, color: Color, thickness: int):
        if this.handle == null: ret end
        scv_ellipse(this.handle, cx, cy, axis_width, axis_height, angle_degrees, color.r, color.g, color.b, thickness)
    end

    @en "polylines"
    @fa "چندخطی"
    @ar "خطوط متعددة"
    pub func polylines(pts: Vector<Point>, closed: bool, color: Color, thickness: int):
        if this.handle == null || pts.len() < 2: ret end
        buf := mem.Allocate((pts.len() * 8) as u64)
        defer mem.Free(buf)
        p := buf as i32*
        mut i := 0
        until i < pts.len():
            pt := pts.get(i)
            p[i * 2] = pt.x
            p[i * 2 + 1] = pt.y
            i += 1
        end
        mut cf := 0
        if closed: cf = 1 end
        scv_polylines(this.handle, p, pts.len(), cf, color.r, color.g, color.b, thickness)
    end

    @en "fill_poly"
    @fa "پر کردن چندضلعی"
    @ar "تعبئة مضلع"
    pub func fill_poly(pts: Vector<Point>, color: Color):
        if this.handle == null || pts.len() < 3: ret end
        buf := mem.Allocate((pts.len() * 8) as u64)
        defer mem.Free(buf)
        p := buf as i32*
        mut i := 0
        until i < pts.len():
            pt := pts.get(i)
            p[i * 2] = pt.x
            p[i * 2 + 1] = pt.y
            i += 1
        end
        scv_fill_poly(this.handle, p, pts.len(), color.r, color.g, color.b)
    end

    @en "find_contours"
    @fa "یافتن پیرامون‌ها"
    @ar "إيجاد الخطوط الكونتورية"
    pub func find_contours(): Contours:
        if this.handle == null: ret Contours { handle = null } end
        ret Contours { handle = scv_find_contours(this.handle) }
    end

    @en "draw_contour"
    @fa "رسم پیرامون"
    @ar "رسم كونتور"
    pub func draw_contour(cs: Contours, idx: int, color: Color, thickness: int):
        if this.handle == null || cs.handle == null: ret end
        scv_draw_contour(this.handle, cs.handle, idx, color.r, color.g, color.b, thickness)
    end
end

@en "TemplateMatch"
@fa "تطابق الگو"
@ar "تطابق القالب"
pub struct TemplateMatch:
    pub found: bool = false
    pub x: int = 0
    pub y: int = 0
    pub score: f64 = 0.0
end

@en "Size"
@fa "اندازه"
@ar "حجم"
pub struct Size:
    pub width: int = 0
    pub height: int = 0
end

@en "Point"
@fa "نقطه"
@ar "نقطة"
pub struct Point:
    pub x: int = 0
    pub y: int = 0
end

@en "Rect"
@fa "مستطیل"
@ar "مستطيل"
pub struct Rect:
    pub x: int = 0
    pub y: int = 0
    pub width: int = 0
    pub height: int = 0
end

@en "Color"
@fa "رنگ"
@ar "لون"
pub struct Color:
    pub r: int = 0
    pub g: int = 0
    pub b: int = 0
end

@en "RGB"
@fa "آر‌جی‌بی"
@ar "آر جي بي"
pub func RGB(r: int, g: int, b: int): Color:
    ret Color { r = r & 255, g = g & 255, b = b & 255 }
end

@en "Black" @fa "سیاه" @ar "أسود"
pub func Black(): Color: ret Color { r = 0, g = 0, b = 0 } end
@en "White" @fa "سفید" @ar "أبيض"
pub func White(): Color: ret Color { r = 255, g = 255, b = 255 } end
@en "Red" @fa "قرمز" @ar "أحمر"
pub func Red(): Color: ret Color { r = 255, g = 0, b = 0 } end
@en "Green" @fa "سبز" @ar "أخضر"
pub func Green(): Color: ret Color { r = 0, g = 255, b = 0 } end
@en "Blue" @fa "آبی" @ar "أزرق"
pub func Blue(): Color: ret Color { r = 0, g = 0, b = 255 } end

@en "Read"
@fa "خواندن"
@ar "قراءة"
pub func Read(path: str): Mat:
    ret Mat { handle = scv_read(path) }
end

@en "Write"
@fa "نوشتن"
@ar "كتابة"
pub func Write(path: str, m: Mat): bool:
    ret m.save(path)
end

@en "NewBlank"
@fa "بوم خالی"
@ar "لوحة فارغة"
pub func NewBlank(width: int, height: int, channels: int, fill: Color): Mat:
    ret Mat { handle = scv_new_blank(width, height, channels, fill.r, fill.g, fill.b) }
end

@en "Zeros"
@fa "صفرها"
@ar "أصفار"
pub func Zeros(width: int, height: int, channels: int): Mat:
    ret NewBlank(width, height, channels, Black())
end
