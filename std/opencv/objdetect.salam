package opencv

import mem
import collections

// Haar-cascade object detection (cv::CascadeClassifier). OpenCV ships
// ready-trained cascades (e.g. haarcascade_frontalface_default.xml) under
// <opencv_install>/share/opencv4/haarcascades/ - point LoadCascade() at one
// of those, or a Haar/LBP cascade you trained yourself. See
// examples/04_face_detection.salam.

// One detected object's bounding box, in the source image's pixel
// coordinates.
@en "DetectedObject"
@fa "شیء شناسایی شده"
@ar "كائن مكتشف"
pub struct DetectedObject:
    pub x: int = 0
    pub y: int = 0
    pub width: int = 0
    pub height: int = 0
end

@en "CascadeClassifier"
@fa "طبقه‌بند آبشاری"
@ar "مصنف متتالي"
pub struct CascadeClassifier:
    pub handle: void* = null

    @en "ok"
    @fa "معتبر"
    @ar "صالح"
    pub func ok(): bool: ret this.handle != null end

    // Runs multi-scale detection over `m` (typically a grayscale Mat -
    // convert with `.to_gray()` first, matching cv::CascadeClassifier's own
    // recommended usage). scale_factor controls how much the search window
    // shrinks between scales (1.1 = 10% smaller each step, a common
    // default); min_neighbors filters out weak/spurious detections (higher
    // = stricter, fewer false positives). At most max_results boxes are
    // returned.
    //
    // Compiler note: assign the result with an explicit, package-qualified
    // cast - `faces := cascade.detect(...) as Vector<opencv.DetectedObject>`
    // - see Mat.good_features()'s doc comment in mat.salam for why.
    @en "detect"
    @fa "شناسایی"
    @ar "كشف"
    pub func detect(m: Mat, scale_factor: f64, min_neighbors: int, max_results: int): Vector<DetectedObject>:
        mut out := Vector {} as Vector<DetectedObject>
        if this.handle == null || m.handle == null || max_results <= 0: ret out end
        xbuf := mem.Allocate((max_results * 4) as u64)
        ybuf := mem.Allocate((max_results * 4) as u64)
        wbuf := mem.Allocate((max_results * 4) as u64)
        hbuf := mem.Allocate((max_results * 4) as u64)
        defer mem.Free(xbuf)
        defer mem.Free(ybuf)
        defer mem.Free(wbuf)
        defer mem.Free(hbuf)
        xp := xbuf as i32*
        yp := ybuf as i32*
        wp := wbuf as i32*
        hp := hbuf as i32*
        n := scv_cascade_detect(this.handle, m.handle, scale_factor, min_neighbors, max_results, xp, yp, wp, hp)
        mut i := 0
        until i < n:
            out.push(DetectedObject { x = xp[i] as int, y = yp[i] as int, width = wp[i] as int, height = hp[i] as int })
            i += 1
        end
        ret out
    end

    @en "free"
    @fa "آزادسازی"
    @ar "تحریر"
    pub func free():
        if this.handle != null: scv_cascade_free(this.handle) end
        this.handle = null
    end
end

// Loads a Haar/LBP cascade from an XML file. Returns a CascadeClassifier
// with handle == null on failure (bad path or malformed file) - check with
// `.ok()`.
@en "LoadCascade"
@fa "بارگذاری آبشار"
@ar "تحميل متتالية"
pub func LoadCascade(path: str): CascadeClassifier:
    ret CascadeClassifier { handle = scv_cascade_load(path) }
end
