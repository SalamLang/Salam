package opencv

// Video I/O: reading frames from a video file or a live camera
// (cv::VideoCapture), and writing frames out to a new video file
// (cv::VideoWriter). See examples/02_webcam_capture.salam for a full
// capture -> process -> display loop.

@en "VideoCapture"
@fa "ضبط ویدیو"
@ar "التقاط فيديو"
pub struct VideoCapture:
    pub handle: void* = null

    // True while the source is open and ready to read from. Also the right
    // way to detect "camera not found" / "file failed to open" right after
    // OpenVideo/OpenCamera.
    @en "ok"
    @fa "معتبر"
    @ar "صالح"
    pub func ok(): bool:
        if this.handle == null: ret false end
        ret scv_video_ok(this.handle) != 0
    end

    // Reads the next frame. Returns a Mat with handle == null at end of
    // stream (file sources) or on a transient camera read failure - check
    // `.ok()` on the capture itself to tell the two apart.
    @en "read"
    @fa "خواندن"
    @ar "قراءة"
    pub func read(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_video_read(this.handle) }
    end

    @en "fps"
    @fa "فریم بر ثانیه"
    @ar "إطارات في الثانية"
    pub func fps(): f64:
        if this.handle == null: ret 0.0 end
        ret scv_video_fps(this.handle)
    end

    // Total frame count for file sources; typically 0/unknown for a live
    // camera, exactly like cv::VideoCapture::get(CAP_PROP_FRAME_COUNT).
    @en "frame_count"
    @fa "تعداد فریم"
    @ar "عدد الإطارات"
    pub func frame_count(): int:
        if this.handle == null: ret 0 end
        ret scv_video_frame_count(this.handle)
    end

    @en "close"
    @fa "بستن"
    @ar "إغلاق"
    pub func close():
        if this.handle != null: scv_video_release(this.handle) end
        this.handle = null
    end
end

@en "VideoWriter"
@fa "نویسنده ویدیو"
@ar "كاتب فيديو"
pub struct VideoWriter:
    pub handle: void* = null

    @en "ok"
    @fa "معتبر"
    @ar "صالح"
    pub func ok(): bool: ret this.handle != null end

    // Appends one frame; `frame`'s size must match the writer's configured
    // width/height. Returns false on a size mismatch or write failure.
    @en "write"
    @fa "نوشتن"
    @ar "كتابة"
    pub func write(frame: Mat): bool:
        if this.handle == null || frame.handle == null: ret false end
        ret scv_writer_write(this.handle, frame.handle) != 0
    end

    @en "close"
    @fa "بستن"
    @ar "إغلاق"
    pub func close():
        if this.handle != null: scv_writer_release(this.handle) end
        this.handle = null
    end
end

// Opens a video file for reading (any container/codec OpenCV was built
// with - typically driven by ffmpeg). Check `.ok()` before reading.
@en "OpenVideo"
@fa "بازکردن ویدیو"
@ar "فتح فيديو"
pub func OpenVideo(path: str): VideoCapture:
    ret VideoCapture { handle = scv_video_open_file(path) }
end

// Opens a live camera by index (0 is usually the system default camera).
// Check `.ok()` immediately - a missing/busy camera is a common failure
// here and is not reported any other way.
@en "OpenCamera"
@fa "بازکردن دوربین"
@ar "فتح كاميرا"
pub func OpenCamera(index: int): VideoCapture:
    ret VideoCapture { handle = scv_video_open_camera(index) }
end

// Opens a new video file for writing. `fourcc` is a 4-character codec tag
// (e.g. "mp4v", "XVID", "MJPG" - passed straight through to
// cv::VideoWriter::fourcc). Check `.ok()` before writing frames.
@en "NewVideoWriter"
@fa "نویسنده ویدیو جدید"
@ar "كاتب فيديو جديد"
pub func NewVideoWriter(path: str, fourcc: str, fps: f64, width: int, height: int): VideoWriter:
    ret VideoWriter { handle = scv_writer_open(path, fourcc, fps, width, height) }
end
