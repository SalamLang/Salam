package opencv

@en "VideoCapture"
@fa "ضبط ویدیو"
pub struct VideoCapture:
    pub handle: void* = null

    @en "ok"
    @fa "معتبر"
    pub func ok(): bool:
        if this.handle == null: ret false end
        ret scv_video_ok(this.handle) != 0
    end

    @en "read"
    @fa "خواندن"
    pub func read(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_video_read(this.handle) }
    end

    @en "fps"
    @fa "فریم بر ثانیه"
    pub func fps(): f64:
        if this.handle == null: ret 0.0 end
        ret scv_video_fps(this.handle)
    end

    @en "frame_count"
    @fa "تعداد فریم"
    pub func frame_count(): int:
        if this.handle == null: ret 0 end
        ret scv_video_frame_count(this.handle)
    end

    @en "close"
    @fa "بستن"
    pub func close():
        if this.handle != null: scv_video_release(this.handle) end
        this.handle = null
    end
end

@en "VideoWriter"
@fa "نویسنده ویدیو"
pub struct VideoWriter:
    pub handle: void* = null

    @en "ok"
    @fa "معتبر"
    pub func ok(): bool: ret this.handle != null end

    @en "write"
    @fa "نوشتن"
    pub func write(frame: Mat): bool:
        if this.handle == null || frame.handle == null: ret false end
        ret scv_writer_write(this.handle, frame.handle) != 0
    end

    @en "close"
    @fa "بستن"
    pub func close():
        if this.handle != null: scv_writer_release(this.handle) end
        this.handle = null
    end
end

@en "OpenVideo"
@fa "بازکردن ویدیو"
pub func OpenVideo(path: str): VideoCapture:
    ret VideoCapture { handle = scv_video_open_file(path) }
end

@en "OpenCamera"
@fa "بازکردن دوربین"
pub func OpenCamera(index: int): VideoCapture:
    ret VideoCapture { handle = scv_video_open_camera(index) }
end

@en "NewVideoWriter"
@fa "نویسنده ویدیو جدید"
pub func NewVideoWriter(path: str, fourcc: str, fps: f64, width: int, height: int): VideoWriter:
    ret VideoWriter { handle = scv_writer_open(path, fourcc, fps, width, height) }
end
