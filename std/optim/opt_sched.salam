package optim

import math

// Learning-rate schedules as pure functions of the step counter: the
// training loop assigns `opt.lr = optim.CosineLR(...)` each iteration
// and owns the counter. No scheduler objects, no hidden state to save
// in a checkpoint.

// ---- public API ----

// base * gamma^(step / every): the staircase drop.
@en "StepLR"
@fa "نرخ پله‌ای"
@ar "معدل درجي"
pub func StepLR(base: f64, step: i64, every: i64, gamma: f64): f64:
    if every <= 0: ret base end
    mut lr := base
    mut k := step / every
    until k > 0:
        lr = lr * gamma
        k -= 1
    end
    ret lr
end

// Cosine annealing from base to min_lr over `total` steps, flat at
// min_lr after.
@en "CosineLR"
@fa "نرخ کسینوسی"
@ar "معدل جيب التمام"
pub func CosineLR(base: f64, step: i64, total: i64, min_lr: f64): f64:
    if total <= 0 || step >= total: ret min_lr end
    if step <= 0: ret base end
    frac := (step as f64) / (total as f64)
    ret min_lr + (base - min_lr) * 0.5 * (1.0 + math.Cos(math.PI * frac))
end

// Linear warmup to base over `warmup` steps, cosine decay to min_lr
// over the rest.
@en "WarmupCosine"
@fa "گرمایش و کسینوس"
@ar "إحماء وجيب تمام"
pub func WarmupCosine(base: f64, step: i64, warmup: i64, total: i64, min_lr: f64): f64:
    if warmup > 0 && step < warmup:
        ret base * ((step + 1) as f64) / (warmup as f64)
    end
    ret CosineLR(base, step - warmup, total - warmup, min_lr)
end
