@en "applog"
@fa "گزارش برنامه"
package applog

import log
import os
import mem
import str
import filepath
import os.desktop.paths

// Application logging helpers with per-app log paths and file rotation.
// Wraps `std/log` and configures it for desktop-app usage (best-effort).

@en "Config"
@fa "پیکربندی"
pub struct Config:
    @en "app_id"
    @fa "شناسه برنامه"
    pub app_id: str = "app"
    @en "file_name"
    @fa "نام پرونده"
    pub file_name: str = "app.log"
    @en "level"
    @fa "سطح"
    pub level: int = log.LevelInfo
    @en "format"
    @fa "قالب"
    pub format: int = log.FormatText
    @en "show_time"
    @fa "نمایش زمان"
    pub show_time: bool = true
    @en "prefix"
    @fa "پیشوند"
    pub prefix: str = ""
    @en "rotate_max_bytes"
    @fa "بیشینه بایت چرخش"
    pub rotate_max_bytes: i64 = 5 * 1024 * 1024
    @en "rotate_max_backups"
    @fa "بیشینه پشتیبان چرخش"
    pub rotate_max_backups: int = 5
    @en "also_stderr"
    @fa "همچنین خطای استاندارد"
    pub also_stderr: bool = false
end

@en "LogPath"
@fa "مسیر گزارش"
pub func LogPath(app_id: str, file_name: str = "app.log"): str:
    dir := paths.AppLogDir(app_id)
    _mk := os.MkdirAll(dir)
    mut name := str.Clone("app.log")
    if str.Len(file_name) > 0:
        mem.Free(name as void*)
        name = str.Clone(file_name)
    end
    path := filepath.Join(dir, name)
    mem.Free(dir as void*)
    mem.Free(name as void*)
    ret path
end

@en "LogDir"
@fa "پوشه گزارش"
pub func LogDir(app_id: str): str:
    dir := paths.AppLogDir(app_id)
    _mk := os.MkdirAll(dir)
    ret dir
end

@en "Init"
@fa "راه‌اندازی"
pub func Init(cfg: Config): str:
    path := LogPath(cfg.app_id, cfg.file_name)
    log.SetLevel(cfg.level)
    log.SetPrefix(cfg.prefix)
    log.ShowTime(cfg.show_time)
    log.SetFormat(cfg.format)
    log.SetRotation(cfg.rotate_max_bytes, cfg.rotate_max_backups)
    _opened := log.ToFile(path)
    // also_stderr is best-effort hint: std/log sinks to one target.
    _keep := cfg.also_stderr
    ret path
end

@en "InitDefault"
@fa "راه‌اندازی پیش‌فرض"
pub func InitDefault(app_id: str): str:
    ret Init(Config { app_id = app_id })
end

@en "Close"
@fa "بستن"
pub func Close():
    log.CloseFile()
end

@en "SetLevel"
@fa "تنظیم سطح"
pub func SetLevel(level: int):
    log.SetLevel(level)
end

@en "Debug"
@fa "اشکال‌زدایی"
pub func Debug(msg: str):
    log.Debug(msg)
end

@en "Info"
@fa "اطلاعات"
pub func Info(msg: str):
    log.Info(msg)
end

@en "Warn"
@fa "هشدار"
pub func Warn(msg: str):
    log.Warn(msg)
end

@en "Error"
@fa "خطا"
pub func Error(msg: str):
    log.Error(msg)
end

@en "Fatal"
@fa "مرگبار"
pub func Fatal(msg: str):
    log.Fatal(msg)
end
