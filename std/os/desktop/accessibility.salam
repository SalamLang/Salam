@en "accessibility"
@fa "دسترسی‌پذیری"
package accessibility

import os
import mem
import str
import conv
import os.shell

// Accessibility preference queries (best-effort).
// Results may be unknown on unsupported desktops or without required tools.

@en "AccessibilityInfo"
@fa "اطلاعات دسترسی‌پذیری"
pub struct AccessibilityInfo:
    @en "high_contrast"
    @fa "کنتراست بالا"
    pub high_contrast: bool = false
    @en "high_contrast_known"
    @fa "کنتراست بالا مشخص"
    pub high_contrast_known: bool = false
    @en "reduced_motion"
    @fa "کاهش حرکت"
    pub reduced_motion: bool = false
    @en "reduced_motion_known"
    @fa "کاهش حرکت مشخص"
    pub reduced_motion_known: bool = false
    @en "screen_reader_hint"
    @fa "نشانه صفحه‌خوان"
    pub screen_reader_hint: bool = false
    @en "note"
    @fa "یادداشت"
    pub note: str = ""
end

@en "PrefersHighContrast"
@fa "کنتراست بالا ترجیحی"
pub func PrefersHighContrast(): bool:
    if SALAM_OS_WINDOWS:
        r := shell.Exec("powershell -NoProfile -Command \"if([System.Windows.Forms.SystemInformation]::HighContrast){'1'}else{'0'}\" 2>nul")
        out := str.Trim(r.out)
        ok := out == "1"
        mem.Free(out as void*)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret ok
    else SALAM_OS_MAC:
        r := shell.Exec("defaults read com.apple.universalaccess increaseContrast 2>/dev/null")
        out := str.Trim(r.out)
        ok := out == "1"
        mem.Free(out as void*)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret ok
    else:
        r := shell.Exec("gsettings get org.gnome.desktop.a11y.interface high-contrast 2>/dev/null")
        out := str.Trim(r.out)
        low := str.Lower(out)
        ok := str.Contains(low, "true")
        mem.Free(low as void*)
        mem.Free(out as void*)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret ok
    end
end

@en "HighContrastKnown"
@fa "کنتراست بالا مشخص است"
pub func HighContrastKnown(): bool:
    if SALAM_OS_WINDOWS or SALAM_OS_MAC: ret true end
    r := shell.Exec("gsettings get org.gnome.desktop.a11y.interface high-contrast 2>/dev/null")
    out := str.Trim(r.out)
    ok := r.code == 0 and out.Len() > 0
    mem.Free(out as void*)
    mem.Free(r.out as void*)
    mem.Free(r.err as void*)
    ret ok
end

@en "PrefersReducedMotion"
@fa "کاهش حرکت ترجیحی"
pub func PrefersReducedMotion(): bool:
    if SALAM_OS_WINDOWS:
        // SystemParametersInfo SPI_GETCLIENTAREAANIMATION is not directly queried here; registry hint used best-effort.
        r := shell.Exec("reg query HKCU\\Control Panel\\Desktop\\WindowMetrics /v MinAnimate 2>nul")
        out := str.Trim(r.out)
        // "0" means animations minimized/off in this setting (best-effort)
        ok := str.Contains(out, "0")
        mem.Free(out as void*)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret ok
    else SALAM_OS_MAC:
        r := shell.Exec("defaults read com.apple.universalaccess reduceMotion 2>/dev/null")
        out := str.Trim(r.out)
        ok := out == "1"
        mem.Free(out as void*)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret ok
    else:
        r := shell.Exec("gsettings get org.gnome.desktop.interface enable-animations 2>/dev/null")
        out := str.Trim(r.out)
        low := str.Lower(out)
        // reduced motion when animations disabled
        ok := str.Contains(low, "false")
        mem.Free(low as void*)
        mem.Free(out as void*)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret ok
    end
end

@en "ReducedMotionKnown"
@fa "کاهش حرکت مشخص است"
pub func ReducedMotionKnown(): bool:
    if SALAM_OS_MAC: ret true end
    if SALAM_OS_WINDOWS:
        r := shell.Exec("reg query HKCU\\Control Panel\\Desktop\\WindowMetrics /v MinAnimate 2>nul")
        ok := r.code == 0
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret ok
    end
    r := shell.Exec("gsettings get org.gnome.desktop.interface enable-animations 2>/dev/null")
    out := str.Trim(r.out)
    ok := r.code == 0 and out.Len() > 0
    mem.Free(out as void*)
    mem.Free(r.out as void*)
    mem.Free(r.err as void*)
    ret ok
end

@en "ScreenReaderHint"
@fa "نشانه صفحه‌خوان"
pub func ScreenReaderHint(): bool:
    // Heuristic only: cannot reliably detect active AT across platforms without native APIs.
    if SALAM_OS_LINUX:
        r := shell.Exec("gsettings get org.gnome.desktop.a11y.applications screen-reader-enabled 2>/dev/null")
        out := str.Trim(r.out)
        low := str.Lower(out)
        ok := str.Contains(low, "true")
        mem.Free(low as void*)
        mem.Free(out as void*)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret ok
    end
    ret false
end

@en "Get"
@fa "دریافت"
pub func Get(): AccessibilityInfo:
    ret AccessibilityInfo {
        high_contrast = PrefersHighContrast(), high_contrast_known = HighContrastKnown(),
        reduced_motion = PrefersReducedMotion(), reduced_motion_known = ReducedMotionKnown(),
        screen_reader_hint = ScreenReaderHint(), note = str.Clone("Best-effort heuristics; values may be unknown or approximate without native accessibility APIs.")
    }
end

@en "IsSupported"
@fa "پشتیبانی می‌شود"
pub func IsSupported(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "CapabilityNote"
@fa "یادداشت قابلیت"
pub func CapabilityNote(): str:
    ret str.Clone("High-contrast and reduced-motion are queried via OS settings where available. Screen reader detection is heuristic; live preference-change events are not exposed.")
end
