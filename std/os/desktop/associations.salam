@en "associations"
@fa "انجمن‌ها"
package associations

import os
import io
import mem
import str
import filepath
import os.shell
import os.desktop.desktop

// Best-effort file association/default app registration and query helpers.
// Registration APIs are intentionally conservative: they create user-level
// launcher/association artifacts where feasible (e.g. Linux .desktop + xdg-mime)
// and return false or a descriptive note on platforms/hosts that require
// elevated privileges, installer frameworks, or unsupported APIs.

@en "AssociationInfo"
@fa "اطلاعات انجمن"
pub struct AssociationInfo:
    @en "ext"
    @fa "پسوند"
    pub ext: str = ""
    @en "mime"
    @fa "مایم"
    pub mime: str = ""
    @en "handler"
    @fa "گرداننده"
    pub handler: str = ""
    @en "supported"
    @fa "پشتیبانی"
    pub supported: bool = false
    @en "note"
    @fa "یادداشت"
    pub note: str = ""
end

func _quote_sh(s: str): str:
    if s.Len() == 0: ret str.Clone("''") end
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 39)
    n := s.Len()
    mut i := 0
    until i < n:
        ch := s.Substr(i, 1)
        if ch == "'":
            str.BufAppend(sb, "'\\''")
        else:
            str.BufAppend(sb, ch)
        end
        mem.Free(ch as void*)
        i++
    end
    str.BufAppendChar(sb, 39)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _trim_dot(ext: str): str:
    e := str.Trim(ext)
    if e.Len() > 0 and e.Substr(0, 1) == ".":
        t := e.Substr(1, e.Len() - 1)
        mem.Free(e as void*)
        ret t
    end
    ret e
end

@en "NormalizeExtension"
@fa "نرمال‌سازی پسوند"
pub func NormalizeExtension(ext: str): str:
    e := _trim_dot(ext)
    low := str.Lower(e)
    mem.Free(e as void*)
    if low.Len() == 0: ret low end
    if low.Substr(0, 1) == ".": ret low end
    out := ".".Concat(low)
    mem.Free(low as void*)
    ret out
end

@en "MimeForExtension"
@fa "مایم برای پسوند"
pub func MimeForExtension(ext: str): str:
    e := NormalizeExtension(ext)
    defer mem.Free(e as void*)
    if e == ".txt": ret str.Clone("text/plain") end
    if e == ".md": ret str.Clone("text/markdown") end
    if e == ".html" or e == ".htm": ret str.Clone("text/html") end
    if e == ".json": ret str.Clone("application/json") end
    if e == ".pdf": ret str.Clone("application/pdf") end
    if e == ".png": ret str.Clone("image/png") end
    if e == ".jpg" or e == ".jpeg": ret str.Clone("image/jpeg") end
    if e == ".svg": ret str.Clone("image/svg+xml") end
    if e == ".csv": ret str.Clone("text/csv") end
    if e == ".xml": ret str.Clone("application/xml") end
    if e == ".zip": ret str.Clone("application/zip") end
    if SALAM_OS_LINUX or SALAM_OS_BSD:
        q := _quote_sh(e)
        cmd := "xdg-mime query filetype /dev/null 2>/dev/null; echo >/dev/null; xdg-mime query filetype ".Concat(q).Concat(" 2>/dev/null")
        // The above is not a real lookup for an extension; fall through to common default.
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
    end
    ret str.Clone("application/octet-stream")
end

@en "QueryDefaultForExtension"
@fa "پرس‌وجوی پیش‌فرض برای پسوند"
pub func QueryDefaultForExtension(ext: str): str:
    e := NormalizeExtension(ext)
    defer mem.Free(e as void*)
    if SALAM_OS_WINDOWS:
        // Best-effort: query HKCU/HKCR assoc via cmd assoc/ftype is limited; return empty when unknown.
        r := shell.Exec("cmd /c assoc " + e)
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    else SALAM_OS_MAC:
        // Best-effort: LaunchServices API not exposed; return empty.
        ret str.Clone("")
    else:
        // xdg-mime needs a mime type; map common extensions.
        mime := MimeForExtension(e)
        defer mem.Free(mime as void*)
        q := _quote_sh(mime)
        cmd := "xdg-mime query default ".Concat(q).Concat(" 2>/dev/null")
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
        r := shell.Exec(cmd)
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    end
end

@en "QueryDefaultForMime"
@fa "پرس‌وجوی پیش‌فرض برای مایم"
pub func QueryDefaultForMime(mime: str): str:
    if mime.Len() == 0: ret str.Clone("") end
    ret desktop.GetDefaultHandler(mime)
end

@en "InfoForExtension"
@fa "اطلاعات برای پسوند"
pub func InfoForExtension(ext: str): AssociationInfo:
    e := NormalizeExtension(ext)
    mime := MimeForExtension(e)
    handler := QueryDefaultForExtension(e)
    supported := SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
    note := str.Clone("Best-effort query; registration support varies by platform and privileges.")
    if handler.Len() == 0:
        mem.Free(note as void*)
        note = str.Clone("No default handler found or query not supported on this host.")
    end
    ret AssociationInfo { ext = e, mime = mime, handler = handler, supported = supported, note = note }
end

@en "RegisterDesktopEntryLinux"
@fa "ثبت ورودی میزکار لینوکس"
pub func RegisterDesktopEntryLinux(app_id: str, app_name: str, exec_cmd: str, mime_types: str = "", icon: str = ""): bool:
    if not (SALAM_OS_LINUX or SALAM_OS_BSD): ret false end
    if app_id.Len() == 0 or exec_cmd.Len() == 0: ret false end
    home := os.Env("HOME")
    if home.Len() == 0: ret false end
    dir := filepath.Join(home, ".local/share/applications")
    defer mem.Free(dir as void*)
    _ = os.MkdirAll(dir)
    path := filepath.Join(dir, app_id + ".desktop")
    defer mem.Free(path as void*)

    mut sb := str.NewBuilder()
    str.BufAppend(sb, "[Desktop Entry]\n")
    str.BufAppend(sb, "Type=Application\n")
    str.BufAppend(sb, "Name=")
    str.BufAppend(sb, app_name.Len() > 0 ? app_name : app_id)
    str.BufAppend(sb, "\nExec=")
    str.BufAppend(sb, exec_cmd)
    str.BufAppend(sb, "\nTerminal=false\n")
    if icon.Len() > 0:
        str.BufAppend(sb, "Icon=")
        str.BufAppend(sb, icon)
        str.BufAppend(sb, "\n")
    end
    if mime_types.Len() > 0:
        str.BufAppend(sb, "MimeType=")
        str.BufAppend(sb, mime_types)
        str.BufAppend(sb, "\n")
    end
    content := str.BufStr(sb)
    str.BufFree(sb)
    ok := io.WriteFile(path, content) >= 0
    mem.Free(content as void*)
    ret ok
end

@en "SetDefaultForMimeLinux"
@fa "تنظیم پیش‌فرض برای مایم در لینوکس"
pub func SetDefaultForMimeLinux(mime: str, desktop_file: str): bool:
    if not (SALAM_OS_LINUX or SALAM_OS_BSD): ret false end
    if mime.Len() == 0 or desktop_file.Len() == 0: ret false end
    q1 := _quote_sh(mime)
    q2 := _quote_sh(desktop_file)
    cmd := "xdg-mime default ".Concat(q2).Concat(" ").Concat(q1).Concat(" >/dev/null 2>&1")
    defer mem.Free(q1 as void*)
    defer mem.Free(q2 as void*)
    defer mem.Free(cmd as void*)
    ret shell.System(cmd) == 0
end

@en "RegisterFileAssociation"
@fa "ثبت انجمن پرونده"
pub func RegisterFileAssociation(ext: str, app_id: str, app_name: str, exec_cmd: str): AssociationInfo:
    e := NormalizeExtension(ext)
    mime := MimeForExtension(e)
    if SALAM_OS_LINUX or SALAM_OS_BSD:
        ok1 := RegisterDesktopEntryLinux(app_id, app_name, exec_cmd, mime, "")
        ok2 := SetDefaultForMimeLinux(mime, app_id + ".desktop")
        mut note := str.Clone("User-level .desktop written; xdg-mime default set when available.")
        if not ok1 or not ok2:
            mem.Free(note as void*)
            note = str.Clone("Best-effort Linux registration attempted; xdg tools or permissions may be missing.")
        end
        handler := QueryDefaultForMime(mime)
        ret AssociationInfo { ext = e, mime = mime, handler = handler, supported = ok1, note = note }
    end
    // Windows/macOS registration typically requires registry/plist changes and elevated or app-bundle context.
    ret AssociationInfo {
        ext = e, mime = mime, handler = str.Clone(""), supported = false, note = str.Clone("Registration is not automated on this platform in std; use installer/OS APIs. Query helpers are available.")
    }
end

@en "OpenWith"
@fa "باز کردن با"
pub func OpenWith(app_cmd: str, target: str): bool:
    if app_cmd.Len() == 0 or target.Len() == 0: ret false end
    if SALAM_OS_WINDOWS:
        // Best-effort: start "" "app" "target"
        cmd := "cmd /c start \"\" \"".Concat(app_cmd).Concat("\" \"").Concat(target).Concat("\"")
        defer mem.Free(cmd as void*)
        ret shell.System(cmd) == 0
    else SALAM_OS_MAC:
        qapp := _quote_sh(app_cmd)
        qt := _quote_sh(target)
        cmd := "open -a ".Concat(qapp).Concat(" ").Concat(qt).Concat(" >/dev/null 2>&1")
        defer mem.Free(qapp as void*)
        defer mem.Free(qt as void*)
        defer mem.Free(cmd as void*)
        if shell.System(cmd) == 0: ret true end
        // Fallback: treat app_cmd as executable
        cmd2 := app_cmd.Concat(" ").Concat(qt)
        defer mem.Free(cmd2 as void*)
        ret shell.System(cmd2) == 0
    else:
        qt := _quote_sh(target)
        cmd := app_cmd.Concat(" ").Concat(qt).Concat(" >/dev/null 2>&1 &")
        defer mem.Free(qt as void*)
        defer mem.Free(cmd as void*)
        ret shell.System(cmd) == 0
    end
end

@en "Note"
@fa "یادداشت"
pub func Note(): str:
    ret str.Clone("File association registration/query is best-effort and platform-guarded. Full installer-level registration is out of scope for std helpers.")
end
