@en "desktop"
@fa "رومیزی"
package desktop

import str

@en "Platform"
@fa "سکو"
pub func Platform(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("windows")
    else SALAM_OS_MAC:
        ret str.Clone("macos")
    else SALAM_OS_LINUX:
        ret str.Clone("linux")
    else SALAM_OS_BSD:
        ret str.Clone("bsd")
    end
    ret str.Clone("unknown")
end

@en "SupportsNotifications"
@fa "اعلان پشتیبانی می‌شود"
pub func SupportsNotifications(): bool:
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret true
    end
    ret false
end

@en "NotificationsNote"
@fa "یادداشت اعلان"
pub func NotificationsNote(): str:
    if SALAM_OS_LINUX:
        ret str.Clone("Uses org.freedesktop.Notifications over D-Bus; sound/click callbacks depend on the notification daemon.")
    else SALAM_OS_WINDOWS:
        ret str.Clone("Best-effort Shell_NotifyIcon balloon notifications; action callbacks and reliable per-toast close are limited.")
    else SALAM_OS_MAC:
        ret str.Clone("Uses NSUserNotification/osascript fallback; click/action tracking and close are limited in the current backend.")
    end
    ret str.Clone("No native notification backend is available on this platform.")
end

@en "SupportsTray"
@fa "سینی پشتیبانی می‌شود"
pub func SupportsTray(): bool:
    // Tray integration is provided by gui.webview/system backends on common desktop OSes.
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret true
    end
    ret false
end

@en "TrayNote"
@fa "یادداشت سینی"
pub func TrayNote(): str:
    if SALAM_OS_LINUX:
        ret str.Clone("Tray/menu behavior depends on the desktop environment and status notifier support.")
    else SALAM_OS_WINDOWS:
        ret str.Clone("Supported via the native shell tray icon APIs.")
    else SALAM_OS_MAC:
        ret str.Clone("Supported via the native status item APIs; appearance follows system menu bar behavior.")
    end
    ret str.Clone("Tray icons are not supported on this platform.")
end

@en "SupportsDragDrop"
@fa "کشیدن و رها کردن پشتیبانی می‌شود"
pub func SupportsDragDrop(): bool:
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret true
    end
    ret false
end

@en "DragDropNote"
@fa "یادداشت کشیدن و رها کردن"
pub func DragDropNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("OLE IDropTarget scaffolding is present; file payload extraction from IDataObject is best-effort and may need host integration.")
    else SALAM_OS_MAC:
        ret str.Clone("NSDraggingDestination registration/extraction is best-effort; coordinate and payload details may require native view integration.")
    else SALAM_OS_LINUX:
        ret str.Clone("GTK drag-destination signals are used; behavior depends on providing a GTK widget/native handle.")
    end
    ret str.Clone("Native drag-and-drop is not supported on this platform.")
end

@en "SupportsAutoStart"
@fa "اجرای خودکار پشتیبانی می‌شود"
pub func SupportsAutoStart(): bool:
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC or SALAM_OS_BSD:
        ret true
    end
    ret false
end

@en "AutoStartNote"
@fa "یادداشت اجرای خودکار"
pub func AutoStartNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Per-user autostart via HKCU\\...\\Run registry entries.")
    else SALAM_OS_MAC:
        ret str.Clone("Per-user LaunchAgents plist in ~/Library/LaunchAgents.")
    else SALAM_OS_LINUX or SALAM_OS_BSD:
        ret str.Clone("Per-user XDG autostart .desktop entries in the autostart config directory.")
    end
    ret str.Clone("Autostart registration is not supported on this platform.")
end

@en "SupportsServices"
@fa "سرویس‌ها پشتیبانی می‌شوند"
pub func SupportsServices(): bool:
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret true
    end
    ret false
end

@en "SupportsUserAgents"
@fa "عامل‌های کاربر پشتیبانی می‌شوند"
pub func SupportsUserAgents(): bool:
    // User-session agents are the portable path (launchd agents, systemd --user, HKCU Run on Windows).
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret true
    end
    ret false
end

@en "ServiceNote"
@fa "یادداشت سرویس"
pub func ServiceNote(): str:
    if SALAM_OS_LINUX:
        ret str.Clone("systemd user units and system units are supported; install/start control depends on permissions.")
    else SALAM_OS_MAC:
        ret str.Clone("launchd LaunchAgents/LaunchDaemons plists are supported; daemon operations may require elevated privileges.")
    else SALAM_OS_WINDOWS:
        ret str.Clone("System services use SCM (Session 0, no GUI). UserAgent installs map to per-user Run entries for GUI-session autostart.")
    end
    ret str.Clone("Service and agent management is not supported on this platform.")
end

@en "SupportsRegistry"
@fa "رجیستری پشتیبانی می‌شود"
pub func SupportsRegistry(): bool:
    if SALAM_OS_WINDOWS:
        ret true
    end
    ret false
end

@en "RegistryNote"
@fa "یادداشت رجیستری"
pub func RegistryNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Windows Registry APIs (HKCU/HKLM/etc.) are available via std/os/winreg.")
    end
    ret str.Clone("Windows Registry is only available on Windows.")
end

@en "SupportsGlobalShortcuts"
@fa "میانبرهای سراسری پشتیبانی می‌شوند"
pub func SupportsGlobalShortcuts(): bool:
    // No dedicated std module in this change set; treat as unavailable/host-dependent.
    ret false
end

@en "GlobalShortcutsNote"
@fa "یادداشت میانبرهای سراسری"
pub func GlobalShortcutsNote(): str:
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret str.Clone("No built-in global-hotkey module in this desktop feature set yet; integration must be provided by the host/webview or a platform library.")
    end
    ret str.Clone("Global shortcuts are not available on this platform.")
end

@en "Reason"
@fa "دلیل"
pub func Reason(feature: str): str:
    if feature == "notifications":
        ret NotificationsNote()
    else feature == "tray":
        ret TrayNote()
    else feature == "dragdrop" or feature == "drag_drop":
        ret DragDropNote()
    else feature == "autostart":
        ret AutoStartNote()
    else feature == "service" or feature == "services" or feature == "agent" or feature == "user_agents":
        ret ServiceNote()
    else feature == "registry" or feature == "winreg":
        ret RegistryNote()
    else feature == "global_shortcuts" or feature == "shortcuts":
        ret GlobalShortcutsNote()
    end
    ret str.Clone("Unknown feature.")
end

@en "PrintSummary"
@fa "چاپ خلاصه"
pub func PrintSummary():
    println "platform: " + Platform()
    println "notifications: " + (SupportsNotifications() ? "yes" : "no") + " - " + NotificationsNote()
    println "tray: " + (SupportsTray() ? "yes" : "no") + " - " + TrayNote()
    println "drag_drop: " + (SupportsDragDrop() ? "yes" : "no") + " - " + DragDropNote()
    println "autostart: " + (SupportsAutoStart() ? "yes" : "no") + " - " + AutoStartNote()
    println "services: " + (SupportsServices() ? "yes" : "no") + " - " + ServiceNote()
    println "user_agents: " + (SupportsUserAgents() ? "yes" : "no")
    println "registry: " + (SupportsRegistry() ? "yes" : "no") + " - " + RegistryNote()
    println "global_shortcuts: " + (SupportsGlobalShortcuts() ? "yes" : "no") + " - " + GlobalShortcutsNote()
end
