@en "capabilities"
@fa "توانایی‌ها"
package capabilities

import str
import os
import mem
import os.shell

@en "FeatureStatus"
@fa "وضعیت ویژگی"
pub struct FeatureStatus:
    @en "feature"
    @fa "ویژگی"
    pub feature: str = ""
    @en "supported"
    @fa "پشتیبانی"
    pub supported: bool = false
    @en "reason"
    @fa "دلیل"
    pub reason: str = ""
end

func _desktop_env(): str:
    x := os.Env("XDG_CURRENT_DESKTOP")
    if x.Len() > 0: ret str.Clone(x) end
    s := os.Env("DESKTOP_SESSION")
    if s.Len() > 0: ret str.Clone(s) end
    if SALAM_OS_MAC: ret str.Clone("macOS") end
    if SALAM_OS_WINDOWS: ret str.Clone("Windows Shell") end
    ret str.Clone("")
end

@en "Platform"
@fa "سکو"
pub func Platform(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("windows")
    else SALAM_OS_MAC:
        ret str.Clone("macos")
    else SALAM_OS_LINUX:
        ret str.Clone("linux")
    else SALAM_OS_BSD:
        ret str.Clone("bsd")
    end
    ret str.Clone("unknown")
end

@en "SupportsNotifications"
@fa "اعلان پشتیبانی می‌شود"
pub func SupportsNotifications(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "NotificationsNote"
@fa "یادداشت اعلان"
pub func NotificationsNote(): str:
    if SALAM_OS_LINUX:
        ret str.Clone("Uses org.freedesktop.Notifications over D-Bus; sound/click callbacks depend on the notification daemon.")
    else SALAM_OS_WINDOWS:
        ret str.Clone("Best-effort Shell_NotifyIcon balloon notifications; action callbacks and reliable per-toast close are limited.")
    else SALAM_OS_MAC:
        ret str.Clone("Uses NSUserNotification/osascript fallback; click/action tracking and close are limited in the current backend.")
    end
    ret str.Clone("No native notification backend is available on this platform.")
end

@en "SupportsTray"
@fa "سینی پشتیبانی می‌شود"
pub func SupportsTray(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "TrayNote"
@fa "یادداشت سینی"
pub func TrayNote(): str:
    if SALAM_OS_LINUX:
        ret str.Clone("Tray/menu behavior depends on the desktop environment and status notifier support.")
    else SALAM_OS_WINDOWS:
        ret str.Clone("Supported via the native shell tray icon APIs.")
    else SALAM_OS_MAC:
        ret str.Clone("Supported via the native status item APIs; appearance follows system menu bar behavior.")
    end
    ret str.Clone("Tray icons are not supported on this platform.")
end

@en "SupportsDragDrop"
@fa "کشیدن و رها کردن پشتیبانی می‌شود"
pub func SupportsDragDrop(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "DragDropNote"
@fa "یادداشت کشیدن و رها کردن"
pub func DragDropNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("OLE IDropTarget scaffolding is present; file payload extraction from IDataObject is best-effort and may need host integration.")
    else SALAM_OS_MAC:
        ret str.Clone("NSDraggingDestination registration/extraction is best-effort; coordinate and payload details may require native view integration.")
    else SALAM_OS_LINUX:
        ret str.Clone("GTK drag-destination signals are used; behavior depends on providing a GTK widget/native handle.")
    end
    ret str.Clone("Native drag-and-drop is not supported on this platform.")
end

@en "SupportsAutoStart"
@fa "اجرای خودکار پشتیبانی می‌شود"
pub func SupportsAutoStart(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC or SALAM_OS_BSD
end

@en "AutoStartNote"
@fa "یادداشت اجرای خودکار"
pub func AutoStartNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Per-user autostart via HKCU\\...\\Run registry entries.")
    else SALAM_OS_MAC:
        ret str.Clone("Per-user LaunchAgents plist in ~/Library/LaunchAgents.")
    else SALAM_OS_LINUX or SALAM_OS_BSD:
        ret str.Clone("Per-user XDG autostart .desktop entries in the autostart config directory.")
    end
    ret str.Clone("Autostart registration is not supported on this platform.")
end

@en "SupportsServices"
@fa "سرویس‌ها پشتیبانی می‌شوند"
pub func SupportsServices(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "SupportsUserAgents"
@fa "عامل‌های کاربر پشتیبانی می‌شوند"
pub func SupportsUserAgents(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "ServiceNote"
@fa "یادداشت سرویس"
pub func ServiceNote(): str:
    if SALAM_OS_LINUX:
        ret str.Clone("systemd user units and system units are supported; install/start control depends on permissions and systemd availability.")
    else SALAM_OS_MAC:
        ret str.Clone("launchd LaunchAgents/LaunchDaemons plists are supported; daemon operations may require elevated privileges.")
    else SALAM_OS_WINDOWS:
        ret str.Clone("System services use SCM (Session 0, no GUI). UserAgent installs map to per-user Run entries for GUI-session autostart.")
    end
    ret str.Clone("Service and agent management is not supported on this platform.")
end

@en "SupportsRegistry"
@fa "رجیستری پشتیبانی می‌شود"
pub func SupportsRegistry(): bool:
    ret SALAM_OS_WINDOWS
end

@en "RegistryNote"
@fa "یادداشت رجیستری"
pub func RegistryNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Windows Registry APIs (HKCU/HKLM/etc.) are available via std/os/winreg.")
    end
    ret str.Clone("Windows Registry is only available on Windows.")
end

@en "SupportsGlobalShortcuts"
@fa "میانبرهای سراسری پشتیبانی می‌شوند"
pub func SupportsGlobalShortcuts(): bool:
    ret false
end

@en "GlobalShortcutsNote"
@fa "یادداشت میانبرهای سراسری"
pub func GlobalShortcutsNote(): str:
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret str.Clone("No built-in global-hotkey module in this desktop feature set yet; integration must be provided by the host/webview or a platform library.")
    end
    ret str.Clone("Global shortcuts are not available on this platform.")
end

@en "SupportsOpenURL"
@fa "باز کردن نشانی پشتیبانی می‌شود"
pub func SupportsOpenURL(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC or SALAM_OS_BSD
end

@en "OpenNote"
@fa "یادداشت باز کردن"
pub func OpenNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Uses cmd/start and Explorer integration; success depends on shell associations.")
    else SALAM_OS_MAC:
        ret str.Clone("Uses open/open -R; success depends on Finder/LaunchServices associations.")
    else SALAM_OS_LINUX or SALAM_OS_BSD:
        ret str.Clone("Uses xdg-open/gio and desktop tools when available; behavior depends on desktop environment.")
    end
    ret str.Clone("No known desktop opener command is available.")
end

@en "SupportsLocaleDetection"
@fa "تشخیص محلی پشتیبانی می‌شود"
pub func SupportsLocaleDetection(): bool:
    if os.Env("LANG").Len() > 0 or os.Env("LC_ALL").Len() > 0: ret true end
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "LocaleNote"
@fa "یادداشت محلی"
pub func LocaleNote(): str:
    ret str.Clone("Best-effort detection from environment variables and optional platform commands; may be empty in minimal/headless environments.")
end

@en "SupportsThemeDetection"
@fa "تشخیص پوسته پشتیبانی می‌شود"
pub func SupportsThemeDetection(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "ThemeNote"
@fa "یادداشت پوسته"
pub func ThemeNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Reads AppsUseLightTheme from registry when available (best-effort).")
    else SALAM_OS_MAC:
        ret str.Clone("Reads AppleInterfaceStyle via defaults (best-effort).")
    else SALAM_OS_LINUX or SALAM_OS_BSD:
        ret str.Clone("Uses GTK_THEME/gsettings hints when available; may be unknown on non-GNOME desktops.")
    end
    ret str.Clone("Theme detection is not available on this platform.")
end

@en "SupportsDisplayInfo"
@fa "اطلاعات نمایشگر پشتیبانی می‌شود"
pub func SupportsDisplayInfo(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "DisplayNote"
@fa "یادداشت نمایشگر"
pub func DisplayNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Best-effort query via PowerShell/CIM; requires available system tools.")
    else SALAM_OS_MAC:
        ret str.Clone("Best-effort query via system_profiler.")
    else SALAM_OS_LINUX or SALAM_OS_BSD:
        ret str.Clone("Best-effort query via xrandr/wlr-randr when present.")
    end
    ret str.Clone("Display info hooks are not available on this platform.")
end

@en "SupportsDefaultAppQueries"
@fa "پرس‌وجوی برنامه پیش‌فرض پشتیبانی می‌شود"
pub func SupportsDefaultAppQueries(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "DefaultAppsNote"
@fa "یادداشت برنامه‌های پیش‌فرض"
pub func DefaultAppsNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Queries URL association ProgId values from registry where available.")
    else SALAM_OS_MAC:
        ret str.Clone("Limited best-effort queries; some handlers may be unavailable without platform frameworks.")
    else SALAM_OS_LINUX or SALAM_OS_BSD:
        ret str.Clone("Uses xdg-settings/xdg-mime when installed.")
    end
    ret str.Clone("Default application queries are not available on this platform.")
end

@en "SupportsDirectoryWatching"
@fa "پایش پوشه پشتیبانی می‌شود"
pub func SupportsDirectoryWatching(): bool:
    ret true
end

@en "DirectoryWatchingNote"
@fa "یادداشت پایش پوشه"
pub func DirectoryWatchingNote(): str:
    ret str.Clone("Polling-based watcher abstraction is available (fs/watcher). Native event backends (inotify/FSEvents/ReadDirectoryChangesW) are not wired in this module.")
end

@en "Reason"
@fa "دلیل"
pub func Reason(feature: str): str:
    if feature == "notifications":
        ret NotificationsNote()
    else feature == "tray":
        ret TrayNote()
    else feature == "dragdrop" or feature == "drag_drop":
        ret DragDropNote()
    else feature == "autostart":
        ret AutoStartNote()
    else feature == "service" or feature == "services" or feature == "agent" or feature == "user_agents":
        ret ServiceNote()
    else feature == "registry" or feature == "winreg":
        ret RegistryNote()
    else feature == "global_shortcuts" or feature == "shortcuts":
        ret GlobalShortcutsNote()
    else feature == "open" or feature == "open_url" or feature == "reveal":
        ret OpenNote()
    else feature == "locale":
        ret LocaleNote()
    else feature == "theme" or feature == "dark_mode":
        ret ThemeNote()
    else feature == "display" or feature == "screen":
        ret DisplayNote()
    else feature == "defaults" or feature == "default_apps" or feature == "associations":
        ret DefaultAppsNote()
    else feature == "watcher" or feature == "watch":
        ret DirectoryWatchingNote()
    end
    ret str.Clone("Unknown feature.")
end

@en "GetStatus"
@fa "دریافت وضعیت"
pub func GetStatus(feature: str): FeatureStatus:
    mut st := FeatureStatus { feature = str.Clone(feature), supported = false, reason = Reason(feature) }
    if feature == "notifications": st.supported = SupportsNotifications()
    else feature == "tray": st.supported = SupportsTray()
    else feature == "dragdrop" or feature == "drag_drop": st.supported = SupportsDragDrop()
    else feature == "autostart": st.supported = SupportsAutoStart()
    else feature == "service" or feature == "services": st.supported = SupportsServices()
    else feature == "user_agents" or feature == "agent": st.supported = SupportsUserAgents()
    else feature == "registry" or feature == "winreg": st.supported = SupportsRegistry()
    else feature == "global_shortcuts" or feature == "shortcuts": st.supported = SupportsGlobalShortcuts()
    else feature == "open" or feature == "open_url" or feature == "reveal": st.supported = SupportsOpenURL()
    else feature == "locale": st.supported = SupportsLocaleDetection()
    else feature == "theme" or feature == "dark_mode": st.supported = SupportsThemeDetection()
    else feature == "display" or feature == "screen": st.supported = SupportsDisplayInfo()
    else feature == "defaults" or feature == "default_apps" or feature == "associations": st.supported = SupportsDefaultAppQueries()
    else feature == "watcher" or feature == "watch": st.supported = SupportsDirectoryWatching()
    end
    ret st
end

@en "PrintSummary"
@fa "چاپ خلاصه"
pub func PrintSummary():
    de := _desktop_env()
    defer mem.Free(de as void*)
    println "platform: " + Platform()
    println "desktop_env: " + de
    println "notifications: " + (SupportsNotifications() ? "yes" : "no") + " - " + NotificationsNote()
    println "tray: " + (SupportsTray() ? "yes" : "no") + " - " + TrayNote()
    println "drag_drop: " + (SupportsDragDrop() ? "yes" : "no") + " - " + DragDropNote()
    println "autostart: " + (SupportsAutoStart() ? "yes" : "no") + " - " + AutoStartNote()
    println "services: " + (SupportsServices() ? "yes" : "no") + " - " + ServiceNote()
    println "user_agents: " + (SupportsUserAgents() ? "yes" : "no")
    println "registry: " + (SupportsRegistry() ? "yes" : "no") + " - " + RegistryNote()
    println "global_shortcuts: " + (SupportsGlobalShortcuts() ? "yes" : "no") + " - " + GlobalShortcutsNote()
    println "open/reveal: " + (SupportsOpenURL() ? "yes" : "no") + " - " + OpenNote()
    println "locale_detection: " + (SupportsLocaleDetection() ? "yes" : "no") + " - " + LocaleNote()
    println "theme_detection: " + (SupportsThemeDetection() ? "yes" : "no") + " - " + ThemeNote()
    println "display_info: " + (SupportsDisplayInfo() ? "yes" : "no") + " - " + DisplayNote()
    println "default_apps: " + (SupportsDefaultAppQueries() ? "yes" : "no") + " - " + DefaultAppsNote()
    println "directory_watch: " + (SupportsDirectoryWatching() ? "yes" : "no") + " - " + DirectoryWatchingNote()
end
