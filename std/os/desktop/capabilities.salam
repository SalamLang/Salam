@en "SupportsRichNotifications"
@fa "اعلان‌های غنی پشتیبانی می‌شوند"
pub func SupportsRichNotifications(): bool:
    // Rich content is modeled in API (subtitle/icon/tag/data/attachments/progress);
    // rendering fidelity is platform/backend dependent.
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

@en "NotificationsNote"
@fa "یادداشت اعلان"
pub func NotificationsNote(): str:
    if SALAM_OS_LINUX:
        ret str.Clone("Uses org.freedesktop.Notifications over D-Bus. Click/action callbacks and hints are best-effort; rich content (images/progress) depends on the notification daemon.")
    else SALAM_OS_WINDOWS:
        ret str.Clone("Best-effort Shell_NotifyIcon balloon notifications. Interactive actions, inline images/progress, and reliable per-toast lifecycle are limited.")
    else SALAM_OS_MAC:
        ret str.Clone("Uses NSUserNotification/osascript fallback. Action callbacks, click tracking, rich attachments/progress, and close behavior are limited in the current backend.")
    end
    ret str.Clone("No native notification backend is available on this platform.")
end

