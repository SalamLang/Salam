@en "Reason"
@fa "دلیل"
pub func Reason(feature: str): str:
    if feature == "notifications":
        ret NotificationsNote()
    else feature == "notification_actions" or feature == "actions":
        ret str.Clone("Interactive notification action buttons are best-effort and primarily supported on Linux/D-Bus backends.")
    else feature == "rich_notifications" or feature == "notification_rich":
        ret str.Clone("Rich notification fields (subtitle/icon/image/tag/progress/data) are accepted by the API; rendering and lifecycle support vary by platform backend.")
    else feature == "tray":
        ret TrayNote()
    else feature == "dragdrop" or feature == "drag_drop":
        ret DragDropNote()
    else feature == "autostart":
        ret AutoStartNote()
    else feature == "service" or feature == "services" or feature == "agent" or feature == "user_agents":
        ret ServiceNote()
    else feature == "registry" or feature == "winreg":
        ret RegistryNote()
    else feature == "global_shortcuts" or feature == "shortcuts":
        ret GlobalShortcutsNote()
    else feature == "open" or feature == "open_url" or feature == "reveal":
        ret OpenNote()
    else feature == "locale":
        ret LocaleNote()
    else feature == "theme" or feature == "dark_mode" or feature == "accent":
        ret ThemeNote()
    else feature == "appearance":
        ret AppearanceNote()
    else feature == "display" or feature == "screen":
        ret DisplayNote()
    else feature == "sysinfo" or feature == "system_info" or feature == "system":
        ret SystemInfoNote()
    else feature == "accessibility" or feature == "a11y" or feature == "high_contrast" or feature == "reduced_motion":
        ret AccessibilityNote()
    else feature == "defaults" or feature == "default_apps" or feature == "associations":
        ret DefaultAppsNote()
    else feature == "watcher" or feature == "watch":
        ret DirectoryWatchingNote()
    else feature == "session" or feature == "display_session":
        ret SessionNote()
    else feature == "wayland":
        ret SessionNote()
    else feature == "x11":
        ret SessionNote()
    else feature == "native_windows" or feature == "windows_native" or feature == "window":
        ret NativeWindowsNote()
    end
    ret str.Clone("Unknown feature.")
end

@en "GetStatus"
@fa "دریافت وضعیت"
pub func GetStatus(feature: str): FeatureStatus:
    mut st := FeatureStatus { feature = str.Clone(feature), supported = false, reason = Reason(feature) }
    if feature == "notifications": st.supported = SupportsNotifications()
    else feature == "notification_actions" or feature == "actions": st.supported = SupportsNotificationActions()
    else feature == "rich_notifications" or feature == "notification_rich": st.supported = SupportsRichNotifications()
    else feature == "tray": st.supported = SupportsTray()
    else feature == "dragdrop" or feature == "drag_drop": st.supported = SupportsDragDrop()
    else feature == "autostart": st.supported = SupportsAutoStart()
    else feature == "service" or feature == "services": st.supported = SupportsServices()
    else feature == "user_agents" or feature == "agent": st.supported = SupportsUserAgents()
    else feature == "registry" or feature == "winreg": st.supported = SupportsRegistry()
    else feature == "global_shortcuts" or feature == "shortcuts": st.supported = SupportsGlobalShortcuts()
    else feature == "open" or feature == "open_url" or feature == "reveal": st.supported = SupportsOpenURL()
    else feature == "locale": st.supported = SupportsLocaleDetection()
    else feature == "theme" or feature == "dark_mode" or feature == "accent": st.supported = SupportsThemeDetection()
    else feature == "appearance": st.supported = SupportsAppearance()
    else feature == "display" or feature == "screen": st.supported = SupportsDisplayInfo()
    else feature == "sysinfo" or feature == "system_info" or feature == "system": st.supported = SupportsSystemInfo()
    else feature == "accessibility" or feature == "a11y" or feature == "high_contrast" or feature == "reduced_motion": st.supported = SupportsAccessibilityPrefs()
    else feature == "defaults" or feature == "default_apps" or feature == "associations": st.supported = SupportsDefaultAppQueries()
    else feature == "watcher" or feature == "watch": st.supported = SupportsDirectoryWatching()
    else feature == "session" or feature == "display_session": st.supported = HasDisplayServer()
    else feature == "wayland": st.supported = SupportsWayland()
    else feature == "x11": st.supported = SupportsX11()
    else feature == "native_windows" or feature == "windows_native" or feature == "window": st.supported = SupportsNativeWindows()
    end
    ret st
end

@en "SessionType"
@fa "نوع نشست"
pub func SessionType(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("windows")
    else SALAM_OS_MAC:
        ret str.Clone("aqua")
    end
    v := os.Env("XDG_SESSION_TYPE")
    if str.Len(v) > 0:
        low := str.Lower(v)
        mem.Free(v as void*)
        if str.Len(low) > 0:
            ret low
        end
        mem.Free(low as void*)
    else:
        mem.Free(v as void*)
    end
    way := os.Env("WAYLAND_DISPLAY")
    disp := os.Env("DISPLAY")
    mut out := str.Clone("")
    if str.Len(way) > 0:
        out = str.Clone("wayland")
    else if str.Len(disp) > 0:
        out = str.Clone("x11")
    end
    mem.Free(way as void*)
    mem.Free(disp as void*)
    if str.Len(out) > 0: ret out end
    mem.Free(out as void*)
    ret str.Clone("")
end

@en "IsWaylandSession"
@fa "نشست ویلند است"
pub func IsWaylandSession(): bool:
    s := SessionType()
    ok := s == "wayland"
    mem.Free(s as void*)
    ret ok
end

@en "IsX11Session"
@fa "نشست ایکس۱۱ است"
pub func IsX11Session(): bool:
    s := SessionType()
    ok := s == "x11"
    mem.Free(s as void*)
    ret ok
end

@en "HasDisplayServer"
@fa "سرور نمایش دارد"
pub func HasDisplayServer(): bool:
    if SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret true
    end
    s := SessionType()
    ok := str.Len(s) > 0
    mem.Free(s as void*)
    ret ok
end

@en "SupportsWayland"
@fa "ویلند پشتیبانی می‌شود"
pub func SupportsWayland(): bool:
    if not SALAM_OS_LINUX and not SALAM_OS_BSD:
        ret false
    end
    if IsWaylandSession():
        ret true
    end
    // Best-effort: compositor/display variable present even if XDG_SESSION_TYPE is unset.
    w := os.Env("WAYLAND_DISPLAY")
    ok := w.Len() > 0
    mem.Free(w as void*)
    ret ok
end

@en "SupportsX11"
@fa "ایکس۱۱ پشتیبانی می‌شود"
pub func SupportsX11(): bool:
    if not SALAM_OS_LINUX and not SALAM_OS_BSD:
        ret false
    end
    if IsX11Session():
        ret true
    end
    d := os.Env("DISPLAY")
    ok := d.Len() > 0
    mem.Free(d as void*)
    ret ok
end

@en "SessionNote"
@fa "یادداشت نشست"
pub func SessionNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Windows desktop session.")
    else SALAM_OS_MAC:
        ret str.Clone("macOS Aqua session.")
    end
    st := SessionType()
    defer mem.Free(st as void*)
    if st == "wayland":
        ret str.Clone("Wayland session detected (best-effort). Native GUI/window backend support may depend on compositor/protocol/toolchain integration.")
    else st == "x11":
        ret str.Clone("X11 session detected (best-effort). Native GUI/window backend support may depend on X11/toolkit integration.")
    end
    ret str.Clone("No desktop display session detected or session type is unknown.")
end

@en "SupportsNativeWindows"
@fa "پنجره‌های بومی پشتیبانی می‌شوند"
pub func SupportsNativeWindows(): bool:
    if SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret true
    end
    if SALAM_OS_LINUX or SALAM_OS_BSD:
        ret HasDisplayServer()
    end
    ret false
end

@en "NativeWindowsNote"
@fa "یادداشت پنجره‌های بومی"
pub func NativeWindowsNote(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("Win32 native window backend is available in source; runtime behavior depends on the Windows build/toolchain and host environment.")
    else SALAM_OS_MAC:
        ret str.Clone("Cocoa native window backend is available in source; runtime behavior depends on the macOS build/toolchain, frameworks, and host environment.")
    end
    st := SessionType()
    defer mem.Free(st as void*)
    if st == "x11":
        ret str.Clone("X11 native window backend is available as the default Linux path (best-effort); runtime behavior depends on DISPLAY/X11 libraries and the host environment.")
    else st == "wayland":
        ret str.Clone("Wayland session detected, but a full native Wayland window runtime backend is not implemented in this build. A source-level Wayland scaffold exists (opt-in) and XWayland/X11 may be required depending on configuration.")
    end
    if SALAM_OS_LINUX or SALAM_OS_BSD:
        ret str.Clone("No display session detected. Use headless mode or run under X11/Wayland (with appropriate backend/runtime support).")
    end
    ret str.Clone("No native window backend is available on this platform in this build.")
end

@en "Summary"
@fa "خلاصه"
pub func Summary(): str:
    de := _desktop_env()
    defer mem.Free(de as void*)
    stype := SessionType()
    defer mem.Free(stype as void*)
    mut sb := str.NewBuilder()
    str.BufAppend(sb, "platform: ")
    p := Platform()
    str.BufAppend(sb, p)
    mem.Free(p as void*)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "session_type: ")
    str.BufAppend(sb, stype)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "desktop_env: ")
    str.BufAppend(sb, de)
    str.BufAppend(sb, "\n")

    n1 := NotificationsNote()
    str.BufAppend(sb, "notifications: " + (SupportsNotifications() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n1)
    str.BufAppend(sb, "\n")
    mem.Free(n1 as void*)
    str.BufAppend(sb, "notification_actions: " + (SupportsNotificationActions() ? "yes" : "no") + "\n")
    str.BufAppend(sb, "rich_notifications: " + (SupportsRichNotifications() ? "yes" : "no") + "\n")

    n2 := TrayNote()
    str.BufAppend(sb, "tray: " + (SupportsTray() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n2)
    str.BufAppend(sb, "\n")
    mem.Free(n2 as void*)

    n3 := DragDropNote()
    str.BufAppend(sb, "drag_drop: " + (SupportsDragDrop() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n3)
    str.BufAppend(sb, "\n")
    mem.Free(n3 as void*)

    n4 := AutoStartNote()
    str.BufAppend(sb, "autostart: " + (SupportsAutoStart() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n4)
    str.BufAppend(sb, "\n")
    mem.Free(n4 as void*)

    n5 := ServiceNote()
    str.BufAppend(sb, "services: " + (SupportsServices() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n5)
    str.BufAppend(sb, "\n")
    mem.Free(n5 as void*)
    str.BufAppend(sb, "user_agents: " + (SupportsUserAgents() ? "yes" : "no") + "\n")

    n6 := RegistryNote()
    str.BufAppend(sb, "registry: " + (SupportsRegistry() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n6)
    str.BufAppend(sb, "\n")
    mem.Free(n6 as void*)

    n7 := GlobalShortcutsNote()
    str.BufAppend(sb, "global_shortcuts: " + (SupportsGlobalShortcuts() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n7)
    str.BufAppend(sb, "\n")
    mem.Free(n7 as void*)

    n8 := OpenNote()
    str.BufAppend(sb, "open/reveal: " + (SupportsOpenURL() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n8)
    str.BufAppend(sb, "\n")
    mem.Free(n8 as void*)

    n9 := LocaleNote()
    str.BufAppend(sb, "locale_detection: " + (SupportsLocaleDetection() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n9)
    str.BufAppend(sb, "\n")
    mem.Free(n9 as void*)

    n10 := ThemeNote()
    str.BufAppend(sb, "theme_detection: " + (SupportsThemeDetection() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n10)
    str.BufAppend(sb, "\n")
    mem.Free(n10 as void*)

    n11 := AppearanceNote()
    str.BufAppend(sb, "appearance: " + (SupportsAppearance() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n11)
    str.BufAppend(sb, "\n")
    mem.Free(n11 as void*)

    n12 := DisplayNote()
    str.BufAppend(sb, "display_info: " + (SupportsDisplayInfo() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n12)
    str.BufAppend(sb, "\n")
    mem.Free(n12 as void*)

    n13 := SystemInfoNote()
    str.BufAppend(sb, "system_info: " + (SupportsSystemInfo() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n13)
    str.BufAppend(sb, "\n")
    mem.Free(n13 as void*)

    n14 := AccessibilityNote()
    str.BufAppend(sb, "accessibility: " + (SupportsAccessibilityPrefs() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n14)
    str.BufAppend(sb, "\n")
    mem.Free(n14 as void*)

    n15 := DefaultAppsNote()
    str.BufAppend(sb, "default_apps: " + (SupportsDefaultAppQueries() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n15)
    str.BufAppend(sb, "\n")
    mem.Free(n15 as void*)

    n16 := DirectoryWatchingNote()
    str.BufAppend(sb, "directory_watch: " + (SupportsDirectoryWatching() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n16)
    str.BufAppend(sb, "\n")
    mem.Free(n16 as void*)

    n17 := SessionNote()
    str.BufAppend(sb, "display_session: " + (HasDisplayServer() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n17)
    str.BufAppend(sb, "\n")
    mem.Free(n17 as void*)

    n18 := NativeWindowsNote()
    str.BufAppend(sb, "native_windows: " + (SupportsNativeWindows() ? "yes" : "no") + " - ")
    str.BufAppend(sb, n18)
    str.BufAppend(sb, "\n")
    mem.Free(n18 as void*)

    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

@en "PrintSummary"
@fa "چاپ خلاصه"
pub func PrintSummary():
    s := Summary()
    println s
    mem.Free(s as void*)
end
