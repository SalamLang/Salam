@en "SupportsLocaleDetection"
@fa "تشخیص محلی پشتیبانی می‌شود"
pub func SupportsLocaleDetection(): bool:
    lang := os.Env("LANG")
    if lang.Len() > 0:
        mem.Free(lang as void*)
        ret true
    end
    mem.Free(lang as void*)
    lc_all := os.Env("LC_ALL")
    if lc_all.Len() > 0:
        mem.Free(lc_all as void*)
        ret true
    end
    mem.Free(lc_all as void*)
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

