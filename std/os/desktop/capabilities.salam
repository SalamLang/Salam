    else SALAM_OS_LINUX or SALAM_OS_BSD:
        ret str.Clone("OS-level global hotkey registration is not wired in this build. gui.shortcut can track accelerators for host-driven dispatch; Wayland/X11/compositor integration is required for real global hooks.")
    end
    ret str.Clone("Global shortcuts are not available on this platform.")
