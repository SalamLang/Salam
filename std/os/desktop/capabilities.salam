@en "capabilities"
@fa "توانایی‌ها"
package capabilities

import str
import os
import mem
import os.shell

@en "FeatureStatus"
@fa "وضعیت ویژگی"
pub struct FeatureStatus:
    @en "feature"
    @fa "ویژگی"
    pub feature: str = ""
    @en "supported"
    @fa "پشتیبانی"
    pub supported: bool = false
    @en "reason"
    @fa "دلیل"
    pub reason: str = ""
end

func _desktop_env(): str:
    x := os.Env("XDG_CURRENT_DESKTOP")
    if x.Len() > 0:
        out := str.Clone(x)
        mem.Free(x as void*)
        ret out
    end
    mem.Free(x as void*)
    s := os.Env("DESKTOP_SESSION")
    if s.Len() > 0:
        out := str.Clone(s)
        mem.Free(s as void*)
        ret out
    end
    mem.Free(s as void*)
    if SALAM_OS_MAC: ret str.Clone("macOS") end
    if SALAM_OS_WINDOWS: ret str.Clone("Windows Shell") end
    ret str.Clone("")
end

@en "Platform"
@fa "سکو"
pub func Platform(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("windows")
    else SALAM_OS_MAC:
        ret str.Clone("macos")
    else SALAM_OS_LINUX:
        ret str.Clone("linux")
    else SALAM_OS_BSD:
        ret str.Clone("bsd")
    end
    ret str.Clone("unknown")
end

@en "SupportsNotifications"
@fa "اعلان پشتیبانی می‌شود"
pub func SupportsNotifications(): bool:
    ret SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC
end

