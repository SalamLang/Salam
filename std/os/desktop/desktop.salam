@en "Hostname"
@fa "نام میزبان"
pub func Hostname(): str:
    if SALAM_OS_WINDOWS:
        v := os.Env("COMPUTERNAME")
        if str.Len(v) > 0:
            ret v
        end
        mem.Free(v as void*)
    else:
        v := os.Env("HOSTNAME")
        if str.Len(v) > 0:
            ret v
        end
        mem.Free(v as void*)
    end
    r := shell.Exec("hostname 2>/dev/null")
    out := str.Trim(r.out)
    mem.Free(r.out as void*)
    mem.Free(r.err as void*)
    if str.Len(out) > 0: ret out end
    mem.Free(out as void*)
    ret str.Clone("")
end

@en "ExecutablePath"
@fa "مسیر فایل اجرایی"
pub func ExecutablePath(): str:
    args := os.Args()
    defer args.Free()
    if args.Len() <= 0: ret str.Clone("") end
    arg0 := str.Clone(args.Get(0))
    defer mem.Free(arg0 as void*)
    if arg0.Len() == 0: ret str.Clone("") end
    if filepath.IsAbs(arg0):
        rp := os.RealPath(arg0)
        if rp.Len() > 0: ret rp end
        ret str.Clone(arg0)
    end
    cwd := os.Cwd()
    defer mem.Free(cwd as void*)
    joined := filepath.Join(cwd, arg0)
    defer mem.Free(joined as void*)
    rp := os.RealPath(joined)
    if rp.Len() > 0: ret rp end
    ret str.Clone(joined)
end

@en "ExecutableDir"
@fa "پوشه فایل اجرایی"
pub func ExecutableDir(): str:
    p := ExecutablePath()
    defer mem.Free(p as void*)
    if p.Len() == 0: ret str.Clone("") end
    ret filepath.Dir(p)
end

