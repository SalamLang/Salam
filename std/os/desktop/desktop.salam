@en "SystemLocale"
@fa "محلی سیستم"
pub func SystemLocale(): str:
    // Best-effort environment-based detection.
    v := os.Env("LC_ALL")
    if v.Len() > 0: ret str.Clone(v) end
    v2 := os.Env("LC_MESSAGES")
    if v2.Len() > 0: ret str.Clone(v2) end
    v3 := os.Env("LANG")
    if v3.Len() > 0: ret str.Clone(v3) end
    if SALAM_OS_WINDOWS:
        r := shell.Exec("powershell -NoProfile -Command \"(Get-Culture).Name\"")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
    else SALAM_OS_MAC:
        r := shell.Exec("defaults read -g AppleLocale 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
    end
    ret str.Clone("")
end

@en "SystemTimezone"
@fa "منطقه زمانی سیستم"
pub func SystemTimezone(): str:
    tz := os.Env("TZ")
    if tz.Len() > 0: ret str.Clone(tz) end
    if SALAM_OS_WINDOWS:
        r := shell.Exec("powershell -NoProfile -Command \"(Get-TimeZone).Id\"")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
    else SALAM_OS_MAC:
        r := shell.Exec("readlink /etc/localtime 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0:
            idx := str.LastIndex(out, "zoneinfo/")
            if idx >= 0:
                part := out.Substr(idx + 9, out.Len() - idx - 9)
                mem.Free(out as void*)
                ret part
            end
            ret out
        end
        mem.Free(out as void*)
    else:
        if os.Exists("/etc/timezone"):
            t := str.Trim(io.ReadFile("/etc/timezone"))
            if t.Len() > 0: ret t end
            mem.Free(t as void*)
        end
        r := shell.Exec("readlink /etc/localtime 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0:
            idx := str.LastIndex(out, "zoneinfo/")
            if idx >= 0:
                part := out.Substr(idx + 9, out.Len() - idx - 9)
                mem.Free(out as void*)
                ret part
            end
            ret out
        end
        mem.Free(out as void*)
    end
    ret str.Clone("")
end

