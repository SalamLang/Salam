end

@en "GetEnvOr"
@fa "دریافت متغیر محیطی یا پیش‌فرض"
pub func GetEnvOr(name: str, def: str): str:
    v := os.Env(name)
    if str.Len(v) == 0:
        mem.Free(v as void*)
        ret str.Clone(def)
    end
    ret v
end

