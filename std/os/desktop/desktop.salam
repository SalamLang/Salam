@en "OpenMail"
@fa "باز کردن نامه"
pub func OpenMail(address_or_mailto: str): bool:
    if address_or_mailto.Len() == 0: ret false end
    if str.StartsWith(address_or_mailto, "mailto:"):
        ret OpenURL(address_or_mailto)
    end
    url := str.Concat("mailto:", address_or_mailto)
    ok := OpenURL(url)
    mem.Free(url as void*)
    ret ok
end

