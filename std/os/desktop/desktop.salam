import os.desktop.appearance as appearance

// Cross-platform desktop/OS integration helpers.
// Most operations are best-effort and return bool/status instead of raising.
// GUI-facing actions depend on host desktop tools and environment variables.

func _quote_sh(s: str): str:
    if s.Len() == 0: ret str.Clone("''") end
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 39)
    n := s.Len()
    mut i := 0
    until i < n:
        ch := s.Substr(i, 1)
        if ch == "'":
            str.BufAppend(sb, "'\\''")
        else:
            str.BufAppend(sb, ch)
        end
        mem.Free(ch as void*)
        i++
    end
    str.BufAppendChar(sb, 39)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _quote_cmd(s: str): str:
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 34)
    n := s.Len()
    mut i := 0
    until i < n:
        ch := s.Substr(i, 1)
        if ch == "\"":
            str.BufAppend(sb, "\"\"")
        else:
            str.BufAppend(sb, ch)
        end
        mem.Free(ch as void*)
        i++
    end
    str.BufAppendChar(sb, 34)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _safe_app_id(app_id: str): str:
    if app_id.Len() == 0: ret str.Clone("default") end
    ret str.Clone(app_id)
end

func _first_nonempty(a: str, b: str): str:
    if a.Len() > 0: ret str.Clone(a) end
    ret str.Clone(b)
end

