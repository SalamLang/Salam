@en "GetDefaultBrowser"
@fa "مرورگر پیش‌فرض"
pub func GetDefaultBrowser(): str:
    if SALAM_OS_WINDOWS:
        r := shell.Exec("reg query HKCU\\Software\\Microsoft\\Windows\\Shell\\Associations\\UrlAssociations\\http\\UserChoice /v ProgId 2>nul")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    else SALAM_OS_MAC:
        // Best-effort: LaunchServices default handler for http (may vary by macOS version/tools)
        r := shell.Exec("python3 -c \"from LaunchServices import LSGetApplicationForURL, kLSRolesAll; import CoreFoundation as CF; u=CF.CFURLCreateWithString(None,'http://example.com',None); r=LSGetApplicationForURL(u,kLSRolesAll,None,None); print(r[1] if r and r[1] else '')\" 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    else:
        r := shell.Exec("xdg-settings get default-web-browser 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    end
end

@en "GetDefaultMailClient"
@fa "رایانامه پیش‌فرض"
pub func GetDefaultMailClient(): str:
    if SALAM_OS_WINDOWS:
        r := shell.Exec("reg query HKCU\\Software\\Microsoft\\Windows\\Shell\\Associations\\UrlAssociations\\mailto\\UserChoice /v ProgId 2>nul")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    else SALAM_OS_MAC:
        ret str.Clone("")
    else:
        r := shell.Exec("xdg-settings get default-url-scheme-handler mailto 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    end
end

@en "GetDefaultHandler"
@fa "برنامه پیش‌فرض"
pub func GetDefaultHandler(scheme_or_mime: str): str:
    if scheme_or_mime.Len() == 0: ret str.Clone("") end
    if scheme_or_mime == "http" or scheme_or_mime == "https": ret GetDefaultBrowser() end
    if scheme_or_mime == "mailto": ret GetDefaultMailClient() end
    if SALAM_OS_LINUX or SALAM_OS_BSD:
        // Try URL scheme handler first, then MIME type query.
        q := _quote_sh(scheme_or_mime)
        cmd := "xdg-mime query default ".Concat(q).Concat(" 2>/dev/null")
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
        r := shell.Exec(cmd)
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
    end
    ret str.Clone("")
end

@en "GetDisplayInfo"
@fa "اطلاعات نمایشگر"
pub func GetDisplayInfo(): str:
    // Best-effort textual summary for diagnostics/hooks.
    if SALAM_OS_WINDOWS:
        r := shell.Exec("powershell -NoProfile -Command \"Get-CimInstance Win32_VideoController | Select-Object -First 1 Name,CurrentHorizontalResolution,CurrentVerticalResolution | Format-List\"")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    else SALAM_OS_MAC:
        r := shell.Exec("system_profiler SPDisplaysDataType 2>/dev/null | sed -n '1,40p'")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    else:
        r := shell.Exec("xrandr --current 2>/dev/null | grep '*' | head -n 5")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        r2 := shell.Exec("wlr-randr 2>/dev/null | sed -n '1,40p'")
        out2 := str.Trim(r2.out)
        if out2.Len() > 0: ret out2 end
        mem.Free(out2 as void*)
        ret str.Clone("")
    end
end

@en "DesktopEnvironment"
@fa "محیط رومیزی"
pub func DesktopEnvironment(): str:
    x := os.Env("XDG_CURRENT_DESKTOP")
    if str.Len(x) > 0: ret x end
    mem.Free(x as void*)
    s := os.Env("DESKTOP_SESSION")
    if str.Len(s) > 0: ret s end
    mem.Free(s as void*)
    if SALAM_OS_MAC: ret str.Clone("macOS") end
    if SALAM_OS_WINDOWS: ret str.Clone("Windows Shell") end
    ret str.Clone("")
end
