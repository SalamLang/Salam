@en "launch"
@fa "اجرا"
package launch

import os
import mem
import str
import os.shell

func _quote_sh(s: str): str:
    if str.Len(s) == 0:
        ret str.Clone("''")
    end
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 39)
    n := str.Len(s)
    mut i := 0
    until i < n:
        ch := str.Substr(s, i, 1)
        if ch == "'":
            str.BufAppend(sb, "'\\''")
        else:
            str.BufAppend(sb, ch)
        end
        mem.Free(ch as void*)
        i++
    end
    str.BufAppendChar(sb, 39)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _quote_cmd(s: str): str:
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 34)
    n := str.Len(s)
    mut i := 0
    until i < n:
        ch := str.Substr(s, i, 1)
        if ch == "\"":
            str.BufAppend(sb, "\"\"")
        else:
            str.BufAppend(sb, ch)
        end
        mem.Free(ch as void*)
        i++
    end
    str.BufAppendChar(sb, 34)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

// Best-effort helpers for launching applications, URLs, files, and folders.
// For richer process control see std/os/process and std/os/shell.

@en "OpenURL"
@fa "باز کردن نشانی"
pub func OpenURL(url: str): bool:
    if str.Len(url) == 0:
        ret false
    end
    if SALAM_OS_WINDOWS:
        cmd := "cmd /c start \"\" " + _quote_cmd(url)
        r := shell.Exec(cmd)
        mem.Free(cmd as void*)
        ret r.code == 0
    else SALAM_OS_MAC:
        cmd := "open " + _quote_sh(url)
        r := shell.Exec(cmd)
        mem.Free(cmd as void*)
        ret r.code == 0
    else:
        cmd := "xdg-open " + _quote_sh(url) + " >/dev/null 2>&1 || gio open " + _quote_sh(url) + " >/dev/null 2>&1"
        r := shell.Exec(cmd)
        mem.Free(cmd as void*)
        ret r.code == 0
    end
end

@en "OpenPath"
@fa "باز کردن مسیر"
pub func OpenPath(path: str): bool:
    if str.Len(path) == 0 or not os.Exists(path):
        ret false
    end
    if SALAM_OS_WINDOWS:
        cmd := "cmd /c start \"\" " + _quote_cmd(path)
        r := shell.Exec(cmd)
        mem.Free(cmd as void*)
        ret r.code == 0
    else SALAM_OS_MAC:
        cmd := "open " + _quote_sh(path)
        r := shell.Exec(cmd)
        mem.Free(cmd as void*)
        ret r.code == 0
    else:
        cmd := "xdg-open " + _quote_sh(path) + " >/dev/null 2>&1 || gio open " + _quote_sh(path) + " >/dev/null 2>&1"
        r := shell.Exec(cmd)
        mem.Free(cmd as void*)
        ret r.code == 0
    end
end

@en "Reveal"
@fa "نمایش در پوشه"
pub func Reveal(path: str): bool:
    if str.Len(path) == 0:
        ret false
    end
    if SALAM_OS_WINDOWS:
        if os.Exists(path):
            cmd := "explorer /select," + _quote_cmd(path)
            r := shell.Exec(cmd)
            mem.Free(cmd as void*)
            ret r.code == 0 or r.code == 1
        end
        ret OpenPath(path)
    else SALAM_OS_MAC:
        if os.Exists(path):
            cmd := "open -R " + _quote_sh(path)
            r := shell.Exec(cmd)
            mem.Free(cmd as void*)
            ret r.code == 0
        end
        ret OpenPath(path)
    else:
        // Best-effort: open containing folder.
        parent := path
        if os.Exists(path) and not os.IsDir(path):
            // fallback to shell dirname
            cmd := "dirname " + _quote_sh(path)
            r := shell.Exec(cmd)
            mem.Free(cmd as void*)
            t := str.Trim(r.out)
            if str.Len(t) > 0:
                parent = t
            end
            mem.Free(r.out as void*)
        end
        ok := OpenPath(parent)
        if parent != path and str.Len(parent) > 0:
            mem.Free(parent as void*)
        end
        ret ok
    end
end

@en "RunDetached"
@fa "اجرای جدا"
pub func RunDetached(command: str): bool:
    if str.Len(command) == 0:
        ret false
    end
    if SALAM_OS_WINDOWS:
        cmd := "cmd /c start \"\" " + command
        r := shell.Exec(cmd)
        mem.Free(cmd as void*)
        ret r.code == 0
    else:
        cmd := "nohup " + command + " >/dev/null 2>&1 &"
        r := shell.Exec(cmd)
        mem.Free(cmd as void*)
        ret r.code == 0
    end
end
