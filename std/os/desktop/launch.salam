@en "launch"
@fa "اجرا"
package launch

import os
import mem
import str
import filepath
import os.shell

func _quote_sh(s: str): str:
    if str.Len(s) == 0:
        ret str.Clone("''")
    end
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 39)
    n := str.Len(s)
    mut i := 0
    until i < n:
        ch := str.Substr(s, i, 1)
        if ch == "'":
            str.BufAppend(sb, "'\\''")
        else:
            str.BufAppend(sb, ch)
        end
        mem.Free(ch as void*)
        i++
    end
    str.BufAppendChar(sb, 39)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func _quote_cmd(s: str): str:
    mut sb := str.NewBuilder()
    str.BufAppendChar(sb, 34)
    n := str.Len(s)
    mut i := 0
    until i < n:
        ch := str.Substr(s, i, 1)
        if ch == "\"":
            str.BufAppend(sb, "\"\"")
        else:
            str.BufAppend(sb, ch)
        end
        mem.Free(ch as void*)
        i++
    end
    str.BufAppendChar(sb, 34)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

// Best-effort helpers for launching applications, URLs, files, and folders.
// For richer process control see std/os/process and std/os/shell.

@en "OpenURL"
@fa "باز کردن نشانی"
pub func OpenURL(url: str): bool:
    if str.Len(url) == 0:
        ret false
    end
    if SALAM_OS_WINDOWS:
        q := _quote_cmd(url)
        cmd := "cmd /c start \"\" " + q
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
        r := shell.Exec(cmd)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret r.code == 0
    else SALAM_OS_MAC:
        q := _quote_sh(url)
        cmd := "open " + q
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
        r := shell.Exec(cmd)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret r.code == 0
    else:
        q := _quote_sh(url)
        cmd := "xdg-open " + q + " >/dev/null 2>&1 || gio open " + q + " >/dev/null 2>&1 || sensible-browser " + q + " >/dev/null 2>&1"
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
        r := shell.Exec(cmd)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret r.code == 0
    end
end

@en "OpenPath"
@fa "باز کردن مسیر"
pub func OpenPath(path: str): bool:
    if str.Len(path) == 0:
        ret false
    end
    if not os.Exists(path):
        // Allow URLs/schemes; local-like paths must exist.
        if not str.Contains(path, "://") and not str.StartsWith(path, "mailto:"):
            ret false
        end
    end
    if SALAM_OS_WINDOWS:
        q := _quote_cmd(path)
        cmd := "cmd /c start \"\" " + q
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
        r := shell.Exec(cmd)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret r.code == 0
    else SALAM_OS_MAC:
        q := _quote_sh(path)
        cmd := "open " + q
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
        r := shell.Exec(cmd)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret r.code == 0
    else:
        q := _quote_sh(path)
        cmd := "xdg-open " + q + " >/dev/null 2>&1 || gio open " + q + " >/dev/null 2>&1"
        defer mem.Free(q as void*)
        defer mem.Free(cmd as void*)
        r := shell.Exec(cmd)
        mem.Free(r.out as void*)
        mem.Free(r.err as void*)
        ret r.code == 0
    end
end

@en "Reveal"
@fa "نمایش در پوشه"
pub func Reveal(path: str): bool:
    if str.Len(path) == 0:
        ret false
    end
    if SALAM_OS_WINDOWS:
        if os.Exists(path):
            q := _quote_cmd(path)
            cmd := "explorer /select," + q
            defer mem.Free(q as void*)
            defer mem.Free(cmd as void*)
            r := shell.Exec(cmd)
            mem.Free(r.out as void*)
            mem.Free(r.err as void*)
            // explorer often returns 1 on success
            ret true
        end
        parent := filepath.Dir(path)
        defer mem.Free(parent as void*)
        if parent.Len() > 0 and os.IsDir(parent):
            ret OpenPath(parent)
        end
        ret false
    else SALAM_OS_MAC:
        if os.Exists(path):
            q := _quote_sh(path)
            cmd := "open -R " + q
            defer mem.Free(q as void*)
            defer mem.Free(cmd as void*)
            r := shell.Exec(cmd)
            mem.Free(r.out as void*)
            mem.Free(r.err as void*)
            ret r.code == 0
        end
        parent := filepath.Dir(path)
        defer mem.Free(parent as void*)
        if parent.Len() > 0 and os.IsDir(parent):
            ret OpenPath(parent)
        end
        ret false
    else:
        if os.Exists(path):
            q := _quote_sh(path)
            sel := "nautilus --select " + q + " >/dev/null 2>&1 || dolphin --select " + q + " >/dev/null 2>&1 || nemo " + q + " >/dev/null 2>&1"
            defer mem.Free(q as void*)
            defer mem.Free(sel as void*)
            r := shell.Exec(sel)
            mem.Free(r.out as void*)
            mem.Free(r.err as void*)
            if r.code == 0:
                ret true
            end
        end
        mut target := str.Clone(path)
        if os.Exists(path):
            if not os.IsDir(path):
                tmp := filepath.Dir(path)
                mem.Free(target as void*)
                target = tmp
            end
        else:
            tmp := filepath.Dir(path)
            mem.Free(target as void*)
            target = tmp
        end
        mut ok := false
        if target.Len() > 0 and os.IsDir(target):
            ok = OpenPath(target)
        else:
            ok = OpenPath(path)
        end
        mem.Free(target as void*)
        ret ok
    end
end

@en "RunDetached"
@fa "اجرای جدا"
pub func RunDetached(command: str): bool:
    if str.Len(command) == 0:
        ret false
    end
    if SALAM_OS_WINDOWS:
        cmd := "cmd /c start \"\" " + command
        defer mem.Free(cmd as void*)
        ret shell.System(cmd) == 0
    else:
        cmd := "nohup " + command + " >/dev/null 2>&1 &"
        defer mem.Free(cmd as void*)
        ret shell.System(cmd) == 0
    end
end

@en "IsSupported"
@fa "پشتیبانی می‌شود"
pub func IsSupported(): bool:
    ret SALAM_OS_WINDOWS or SALAM_OS_MAC or SALAM_OS_LINUX or SALAM_OS_BSD or SALAM_OS_FREEBSD
end

@en "SessionKind"
@fa "نوع نشست"
pub func SessionKind(): str:
    if SALAM_OS_WINDOWS:
        ret str.Clone("windows")
    else SALAM_OS_MAC:
        ret str.Clone("macos")
    else SALAM_OS_LINUX or SALAM_OS_BSD or SALAM_OS_FREEBSD:
        w := os.Env("WAYLAND_DISPLAY")
        wt := str.Trim(w)
        if wt.Len() > 0:
            mem.Free(w as void*)
            mem.Free(wt as void*)
            ret str.Clone("wayland")
        end
        mem.Free(w as void*)
        mem.Free(wt as void*)
        d := os.Env("DISPLAY")
        dt := str.Trim(d)
        if dt.Len() > 0:
            mem.Free(d as void*)
            mem.Free(dt as void*)
            ret str.Clone("x11")
        end
        mem.Free(d as void*)
        mem.Free(dt as void*)
        ret str.Clone("headless-or-unknown")
    end
    ret str.Clone("unknown")
end

@en "OpenMail"
@fa "باز کردن نامه"
pub func OpenMail(mailto_url: str): bool:
    if str.Len(mailto_url) == 0:
        ret false
    end
    if str.StartsWith(mailto_url, "mailto:"):
        ret OpenURL(mailto_url)
    end
    url := str.Concat("mailto:", mailto_url)
    ok := OpenURL(url)
    mem.Free(url as void*)
    ret ok
end
