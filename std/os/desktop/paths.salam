@en "paths"
@fa "مسیرها"
package paths

import os
import mem
import str
import filepath
import os.user

// Cross-platform application path helpers (best-effort).

func _safe_component(id: str): str:
    if id.Len() == 0: ret str.Clone("default") end
    ret str.Clone(id)
end

@en "JoinApp"
@fa "پیوند برنامه"
pub func JoinApp(base: str, app_id: str): str:
    id := _safe_component(app_id)
    defer mem.Free(id as void*)
    ret filepath.Join(base, id)
end

@en "HomeDir"
@fa "پوشه خانگی"
pub func HomeDir(): str:
    ret user.HomeDir()
end

@en "ConfigBaseDir"
@fa "پوشه پایه پیکربندی"
pub func ConfigBaseDir(): str:
    if SALAM_OS_WINDOWS:
        v := os.Env("APPDATA")
        if v.Len() > 0: ret str.Clone(v) end
        v2 := os.Env("USERPROFILE")
        if v2.Len() > 0: ret str.Clone(v2) end
        ret str.Clone(".")
    else SALAM_OS_MAC:
        home := user.HomeDir()
        defer mem.Free(home as void*)
        lib := filepath.Join(home, "Library")
        defer mem.Free(lib as void*)
        ret filepath.Join(lib, "Application Support")
    else:
        x := os.Env("XDG_CONFIG_HOME")
        if x.Len() > 0: ret str.Clone(x) end
        home := user.HomeDir()
        defer mem.Free(home as void*)
        ret filepath.Join(home, ".config")
    end
end

@en "CacheBaseDir"
@fa "پوشه پایه حافظه پنهان"
pub func CacheBaseDir(): str:
    if SALAM_OS_WINDOWS:
        v := os.Env("LOCALAPPDATA")
        if v.Len() > 0: ret str.Clone(v) end
        v2 := os.Env("TEMP")
        if v2.Len() > 0: ret str.Clone(v2) end
        ret os.TempDir()
    else SALAM_OS_MAC:
        home := user.HomeDir()
        defer mem.Free(home as void*)
        lib := filepath.Join(home, "Library")
        defer mem.Free(lib as void*)
        ret filepath.Join(lib, "Caches")
    else:
        x := os.Env("XDG_CACHE_HOME")
        if x.Len() > 0: ret str.Clone(x) end
        home := user.HomeDir()
        defer mem.Free(home as void*)
        ret filepath.Join(home, ".cache")
    end
end

@en "DataBaseDir"
@fa "پوشه پایه داده"
pub func DataBaseDir(): str:
    if SALAM_OS_WINDOWS:
        v := os.Env("APPDATA")
        if v.Len() > 0: ret str.Clone(v) end
        v2 := os.Env("LOCALAPPDATA")
        if v2.Len() > 0: ret str.Clone(v2) end
        ret user.HomeDir()
    else SALAM_OS_MAC:
        home := user.HomeDir()
        defer mem.Free(home as void*)
        lib := filepath.Join(home, "Library")
        defer mem.Free(lib as void*)
        ret filepath.Join(lib, "Application Support")
    else:
        x := os.Env("XDG_DATA_HOME")
        if x.Len() > 0: ret str.Clone(x) end
        home := user.HomeDir()
        defer mem.Free(home as void*)
        local := filepath.Join(home, ".local")
        defer mem.Free(local as void*)
        ret filepath.Join(local, "share")
    end
end

@en "StateBaseDir"
@fa "پوشه پایه وضعیت"
pub func StateBaseDir(): str:
    if SALAM_OS_WINDOWS:
        v := os.Env("LOCALAPPDATA")
        if v.Len() > 0: ret str.Clone(v) end
        ret DataBaseDir()
    else SALAM_OS_MAC:
        home := user.HomeDir()
        defer mem.Free(home as void*)
        lib := filepath.Join(home, "Library")
        defer mem.Free(lib as void*)
        ret filepath.Join(lib, "Application Support")
    else:
        x := os.Env("XDG_STATE_HOME")
        if x.Len() > 0: ret str.Clone(x) end
        home := user.HomeDir()
        defer mem.Free(home as void*)
        local := filepath.Join(home, ".local")
        defer mem.Free(local as void*)
        ret filepath.Join(local, "state")
