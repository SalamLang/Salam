@en "RecentDirs"
@fa "پوشه‌های اخیر"
pub func RecentDirs(): Vector<str>:
    // Best-effort list of likely "recent/useful" directories.
    mut out := Vector {} as Vector<str>
    d := DesktopDir()
    if d.Len() > 0 and os.IsDir(d): out.Push(d) else:
        mem.Free(d as void*)
    end
    docs := DocumentsDir()
    if docs.Len() > 0 and os.IsDir(docs): out.Push(docs) else:
        mem.Free(docs as void*)
    end
    dl := DownloadsDir()
    if dl.Len() > 0 and os.IsDir(dl): out.Push(dl) else:
        mem.Free(dl as void*)
    end
    pic := PicturesDir()
    if pic.Len() > 0 and os.IsDir(pic): out.Push(pic) else:
        mem.Free(pic as void*)
    end
    mus := MusicDir()
    if mus.Len() > 0 and os.IsDir(mus): out.Push(mus) else:
        mem.Free(mus as void*)
    end
    vid := VideosDir()
    if vid.Len() > 0 and os.IsDir(vid): out.Push(vid) else:
        mem.Free(vid as void*)
    end
    home := HomeDir()
    if home.Len() > 0 and os.IsDir(home): out.Push(home) else:
        mem.Free(home as void*)
    end
    ret out
end

@en "EnsureDir"
@fa "اطمینان از وجود پوشه"
pub func EnsureDir(path: str): bool:
    if path.Len() == 0: ret false end
    if os.IsDir(path): ret true end
    ret os.MkdirAll(path) == 0
end

@en "EnsureAppDirs"
@fa "اطمینان از پوشه‌های برنامه"
pub func EnsureAppDirs(app_id: str): bool:
    mut ok := true
    c := AppConfigDir(app_id)
    ca := AppCacheDir(app_id)
    d := AppDataDir(app_id)
    s := AppStateDir(app_id)
    l := AppLogDir(app_id)
    r := AppRuntimeDir(app_id)
    if not EnsureDir(c): ok = false end
    if not EnsureDir(ca): ok = false end
    if not EnsureDir(d): ok = false end
    if not EnsureDir(s): ok = false end
    if not EnsureDir(l): ok = false end
    if not EnsureDir(r): ok = false end
    mem.Free(c as void*)
    mem.Free(ca as void*)
    mem.Free(d as void*)
    mem.Free(s as void*)
    mem.Free(l as void*)
    mem.Free(r as void*)
    ret ok
end

@en "RecentFilesPath"
@fa "مسیر پرونده‌های اخیر"
pub func RecentFilesPath(app_id: str): str:
    base := AppStateDir(app_id)
    defer mem.Free(base as void*)
    _ = EnsureDir(base)
    ret filepath.Join(base, "recent_files.txt")
end

@en "RecentDirsPath"
@fa "مسیر پوشه‌های اخیر"
pub func RecentDirsPath(app_id: str): str:
    base := AppStateDir(app_id)
    defer mem.Free(base as void*)
    _ = EnsureDir(base)
    ret filepath.Join(base, "recent_dirs.txt")
end

@en "NormalizeForDialog"
@fa "نرمال‌سازی برای گفتگو"
pub func NormalizeForDialog(path: str): str:
    // File dialogs/backends behave better with cleaned absolute-ish paths.
    if path.Len() == 0: ret str.Clone("") end
    rp := os.RealPath(path)
    if rp.Len() > 0: ret rp end
    ret filepath.Clean(path)
end

@en "DefaultDialogPath"
@fa "مسیر پیش‌فرض گفتگو"
pub func DefaultDialogPath(preferred: str = ""): str:
    if preferred.Len() > 0 and os.Exists(preferred):
        ret NormalizeForDialog(preferred)
    end
    docs := DocumentsDir()
    if docs.Len() > 0 and os.IsDir(docs): ret docs end
    mem.Free(docs as void*)
    home := HomeDir()
    if home.Len() > 0 and os.IsDir(home): ret home end
    mem.Free(home as void*)
    ret TempBaseDir()
end

@en "BuildFilterPattern"
@fa "ساخت الگوی صافی"
pub func BuildFilterPattern(exts: Vector<str>): str:
    // Build a simple glob-style pattern list like "*.txt;*.md" from extensions.
    mut sb := str.NewBuilder()
    repeat exts.Len() in i:
        if i > 0: str.BufAppend(sb, ";") end
        e := str.Trim(exts.Get(i))
        if e.Len() == 0: continue end
        if e.Substr(0, 2) != "*.":
            if e.Substr(0, 1) == ".":
                str.BufAppend(sb, "*")
                str.BufAppend(sb, e)
            else:
                str.BufAppend(sb, "*.")
                str.BufAppend(sb, e)
            end
        else:
            str.BufAppend(sb, e)
        end
        mem.Free(e as void*)
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end
