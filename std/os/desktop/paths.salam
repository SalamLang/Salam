end

@en "LogBaseDir"
@fa "پوشه پایه گزارش"
pub func LogBaseDir(): str:
    if SALAM_OS_WINDOWS:
        v := os.Env("LOCALAPPDATA")
        if v.Len() > 0: ret str.Clone(v) end
        ret DataBaseDir()
    else SALAM_OS_MAC:
        home := user.HomeDir()
        defer mem.Free(home as void*)
        lib := filepath.Join(home, "Library")
        defer mem.Free(lib as void*)
        ret filepath.Join(lib, "Logs")
    else:
        // Common XDG convention for logs
        st := StateBaseDir()
        defer mem.Free(st as void*)
        ret filepath.Join(st, "logs")
    end
end

@en "RuntimeBaseDir"
@fa "پوشه پایه اجرا"
pub func RuntimeBaseDir(): str:
    if SALAM_OS_WINDOWS or SALAM_OS_MAC:
        ret CacheBaseDir()
    else:
        x := os.Env("XDG_RUNTIME_DIR")
        if x.Len() > 0: ret str.Clone(x) end
        ret CacheBaseDir()
    end
end

@en "TempBaseDir"
@fa "پوشه پایه موقت"
pub func TempBaseDir(): str:
    ret os.TempDir()
end

@en "AppConfigDir"
@fa "پوشه پیکربندی برنامه"
pub func AppConfigDir(app_id: str): str:
    base := ConfigBaseDir()
    defer mem.Free(base as void*)
    ret JoinApp(base, app_id)
end

