@en "DesktopDir"
@fa "پوشه رومیزی"
pub func DesktopDir(): str:
    if SALAM_OS_WINDOWS:
        v := os.Env("USERPROFILE")
        if v.Len() > 0:
            ret filepath.Join(v, "Desktop")
        end
        ret str.Clone("")
    end
    x := os.Env("XDG_DESKTOP_DIR")
    if x.Len() > 0: ret str.Clone(x) end
    home := user.HomeDir()
    defer mem.Free(home as void*)
    ret filepath.Join(home, "Desktop")
end

