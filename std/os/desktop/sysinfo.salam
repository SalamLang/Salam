@en "sysinfo"
@fa "اطلاعات سامانه"
package sysinfo

import os
import io
import mem
import str
import conv
import os.shell
import os.platform
import os.user

@en "SystemInfo"
@fa "اطلاعات سامانه"
pub struct SystemInfo:
    @en "os"
    @fa "سیستم عامل"
    pub os: str = ""
    @en "os_name"
    @fa "نام سیستم عامل"
    pub os_name: str = ""
    @en "os_version"
    @fa "نسخه سیستم عامل"
    pub os_version: str = ""
    @en "arch"
    @fa "معماری"
    pub arch: str = ""
    @en "hostname"
    @fa "نام میزبان"
    pub hostname: str = ""
    @en "username"
    @fa "نام کاربری"
    pub username: str = ""
    @en "cpu_count"
    @fa "تعداد پردازنده"
    pub cpu_count: int = -1
    @en "memory_total_bytes"
    @fa "کل حافظه"
    pub memory_total_bytes: i64 = -1
    @en "memory_available_bytes"
    @fa "حافظه موجود"
    pub memory_available_bytes: i64 = -1
end

@en "OS"
@fa "سیستم عامل"
pub func OS(): str:
    ret platform.OS()
end

@en "Arch"
@fa "معماری"
pub func Arch(): str:
    ret platform.Arch()
end

@en "OSName"
@fa "نام سیستم عامل"
pub func OSName(): str:
    if SALAM_OS_WINDOWS:
        r := shell.Exec("powershell -NoProfile -Command \"(Get-CimInstance Win32_OperatingSystem).Caption\" 2>nul")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("Windows")
    else SALAM_OS_MAC:
        r := shell.Exec("sw_vers -productName 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("macOS")
    else SALAM_OS_LINUX:
        // Prefer /etc/os-release PRETTY_NAME
        data := io.ReadFile("/etc/os-release")
        if data.Len() > 0:
            lines := data.Split("\n")
            defer lines.Free()
            mut i := 0
            until i < lines.Len():
                line := lines.Get(i)
                if line.StartsWith("PRETTY_NAME="):
                    val := line.Substr(12, line.Len() - 12)
                    // trim quotes
                    v2 := str.Trim(val)
                    if v2.Len() >= 2 and v2.Substr(0, 1) == "\"":
                        inner := v2.Substr(1, v2.Len() - 2)
                        mem.Free(v2 as void*)
                        mem.Free(val as void*)
                        mem.Free(data as void*)
                        ret inner
                    end
                    mem.Free(val as void*)
                    mem.Free(data as void*)
                    ret v2
                end
                i++
            end
            mem.Free(data as void*)
        end
        ret str.Clone("Linux")
    end
    ret str.Clone(platform.OS())
end

@en "OSVersion"
@fa "نسخه سیستم عامل"
pub func OSVersion(): str:
    if SALAM_OS_WINDOWS:
        r := shell.Exec("powershell -NoProfile -Command \"(Get-CimInstance Win32_OperatingSystem).Version\" 2>nul")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    else SALAM_OS_MAC:
        r := shell.Exec("sw_vers -productVersion 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    else SALAM_OS_LINUX:
        data := io.ReadFile("/etc/os-release")
        if data.Len() > 0:
            lines := data.Split("\n")
            defer lines.Free()
            mut i := 0
            until i < lines.Len():
                line := lines.Get(i)
                if line.StartsWith("VERSION_ID="):
                    val := str.Trim(line.Substr(11, line.Len() - 11))
                    if val.Len() >= 2 and val.Substr(0, 1) == "\"":
                        inner := val.Substr(1, val.Len() - 2)
                        mem.Free(val as void*)
                        mem.Free(data as void*)
                        ret inner
                    end
                    mem.Free(data as void*)
                    ret val
                end
                i++
            end
            mem.Free(data as void*)
        end
        // kernel fallback
        r := shell.Exec("uname -r 2>/dev/null")
        out := str.Trim(r.out)
        if out.Len() > 0: ret out end
        mem.Free(out as void*)
        ret str.Clone("")
    end
    ret str.Clone("")
end

@en "Hostname"
@fa "نام میزبان"
pub func Hostname(): str:
    if SALAM_OS_WINDOWS:
        v := os.Env("COMPUTERNAME")
        if v.Len() > 0:
            s := str.Clone(v)
            mem.Free(v as void*)
            ret s
        end
        mem.Free(v as void*)
    else:
        v := os.Env("HOSTNAME")
        if v.Len() > 0:
            s := str.Clone(v)
            mem.Free(v as void*)
            ret s
        end
        mem.Free(v as void*)
    end
    r := shell.Exec("hostname 2>/dev/null")
    out := str.Trim(r.out)
    mem.Free(r.out as void*)
    mem.Free(r.err as void*)
    if out.Len() > 0: ret out end
    mem.Free(out as void*)
    ret str.Clone("")
end

@en "Username"
@fa "نام کاربری"
pub func Username(): str:
    ret user.Username()
end

@en "CPUCount"
@fa "تعداد پردازنده"
pub func CPUCount(): int:
    ret platform.CpuCount()
end

@en "TotalMemory"
@fa "کل حافظه"
pub func TotalMemory(): i64:
    ret platform.TotalMemory()
end

@en "AvailableMemory"
@fa "حافظه موجود"
pub func AvailableMemory(): i64:
    ret platform.AvailableMemory()
end

@en "GetInfo"
@fa "دریافت اطلاعات"
pub func GetInfo(): SystemInfo:
    ret SystemInfo {
        os = OS(), os_name = OSName(), os_version = OSVersion(), arch = Arch(), hostname = Hostname(),
        username = Username(), cpu_count = CPUCount(), memory_total_bytes = TotalMemory(),
        memory_available_bytes = AvailableMemory(),
    }
end

@en "IsSupported"
@fa "پشتیبانی می‌شود"
pub func IsSupported(): bool:
    ret true
end

@en "CapabilityNote"
@fa "یادداشت قابلیت"
pub func CapabilityNote(): str:
    ret str.Clone("OS name/version and memory/CPU counts are best-effort and may be unavailable in sandboxed, minimal, or non-standard environments.")
end
