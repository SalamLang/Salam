@en "diagnostics"
@fa "عیب‌یابی"
package diagnostics

import os
import io
import mem
import str
import conv
import time
import filepath
import os.desktop.paths
import os.desktop.sysinfo
import os.desktop.capabilities

// Diagnostic bundle and app health helpers (best-effort, no automatic network upload).

@en "BundleOptions"
@fa "گزینه‌های بسته"
pub struct BundleOptions:
    @en "app_id"
    @fa "شناسه برنامه"
    pub app_id: str = "app"
    @en "app_name"
    @fa "نام برنامه"
    pub app_name: str = ""
    @en "app_version"
    @fa "نسخه برنامه"
    pub app_version: str = ""
    @en "include_logs"
    @fa "شامل گزارش‌ها"
    pub include_logs: bool = true
    @en "log_path"
    @fa "مسیر گزارش"
    pub log_path: str = ""
    @en "max_log_bytes"
    @fa "بیشینه بایت گزارش"
    pub max_log_bytes: int = 256 * 1024
    @en "output_dir"
    @fa "پوشه خروجی"
    pub output_dir: str = ""
end

@en "BundleResult"
@fa "نتیجه بسته"
pub struct BundleResult:
    @en "ok"
    @fa "موفق"
    pub ok: bool = false
    @en "path"
    @fa "مسیر"
    pub path: str = ""
    @en "note"
    @fa "یادداشت"
    pub note: str = ""
end

func _tail_text(path: str, max_bytes: int): str:
    if path.Len() == 0 or not os.Exists(path):
        ret str.Clone("")
    end
    text := io.ReadFile(path)
    if text.Len() <= max_bytes or max_bytes <= 0:
        ret text
    end
    // keep tail (best-effort)
    start := text.Len() - max_bytes
    if start < 0: start = 0 end
    out := text.Substr(start, text.Len() - start)
    mem.Free(text as void*)
    ret out
end

@en "CollectSystemReport"
@fa "گردآوری گزارش سامانه"
pub func CollectSystemReport(): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    si := sysinfo.GetInfo()
    str.BufAppend(sb, "== System Info ==\n")
    str.BufAppend(sb, "os: ")
    str.BufAppend(sb, si.os)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "os_name: ")
    str.BufAppend(sb, si.os_name)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "os_version: ")
    str.BufAppend(sb, si.os_version)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "arch: ")
    str.BufAppend(sb, si.arch)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "hostname: ")
    str.BufAppend(sb, si.hostname)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "username: ")
    str.BufAppend(sb, si.username)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "cpu_count: ")
    str.BufAppend(sb, conv.FormatInt(si.cpu_count as i64))
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "memory_total_bytes: ")
    str.BufAppend(sb, conv.FormatInt(si.memory_total_bytes))
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "memory_available_bytes: ")
    str.BufAppend(sb, conv.FormatInt(si.memory_available_bytes))
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "\n== Desktop Capabilities ==\n")
    caps := capabilities.PrintSummary()
    str.BufAppend(sb, caps)
    mem.Free(caps as void*)
    ret str.BufStr(sb)
end

@en "CollectPathsReport"
@fa "گردآوری گزارش مسیرها"
pub func CollectPathsReport(app_id: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    cfg := paths.AppConfigDir(app_id)
    cache := paths.AppCacheDir(app_id)
    data := paths.AppDataDir(app_id)
    state := paths.AppStateDir(app_id)
    logd := paths.AppLogDir(app_id)
    tmp := paths.AppTempDir(app_id)
    str.BufAppend(sb, "config: ")
    str.BufAppend(sb, cfg)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "cache: ")
    str.BufAppend(sb, cache)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "data: ")
    str.BufAppend(sb, data)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "state: ")
    str.BufAppend(sb, state)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "logs: ")
    str.BufAppend(sb, logd)
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, "temp: ")
    str.BufAppend(sb, tmp)
    str.BufAppend(sb, "\n")
    mem.Free(cfg as void*)
    mem.Free(cache as void*)
    mem.Free(data as void*)
    mem.Free(state as void*)
    mem.Free(logd as void*)
    mem.Free(tmp as void*)
    ret str.BufStr(sb)
end

@en "CreateBundle"
@fa "ایجاد بسته"
pub func CreateBundle(opts: BundleOptions): BundleResult:
    app_id := opts.app_id.Len() > 0 ? opts.app_id : "app"
    out_dir := opts.output_dir
    if out_dir.Len() == 0:
        out_dir = paths.AppTempDir(app_id)
    end
    _mk := os.MkdirAll(out_dir)
    ts := conv.FormatInt(time.Now() as i64)
    name := "diagnostics-".Concat(app_id).Concat("-").Concat(ts).Concat(".txt")
    path := filepath.Join(out_dir, name)
    mem.Free(name as void*)
    mem.Free(ts as void*)

    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "# Salam Diagnostics Bundle\n")
    str.BufAppend(sb, "app_id: ")
    str.BufAppend(sb, app_id)
    str.BufAppend(sb, "\n")
    if opts.app_name.Len() > 0:
        str.BufAppend(sb, "app_name: ")
        str.BufAppend(sb, opts.app_name)
        str.BufAppend(sb, "\n")
    end
    if opts.app_version.Len() > 0:
        str.BufAppend(sb, "app_version: ")
        str.BufAppend(sb, opts.app_version)
        str.BufAppend(sb, "\n")
    end
    str.BufAppend(sb, "\n")
    sys := CollectSystemReport()
    str.BufAppend(sb, sys)
    str.BufAppend(sb, "\n")
    mem.Free(sys as void*)
    str.BufAppend(sb, "== Paths ==\n")
    paths := CollectPathsReport(app_id)
    str.BufAppend(sb, paths)
    str.BufAppend(sb, "\n")
    mem.Free(paths as void*)
    if opts.include_logs and opts.log_path.Len() > 0:
        str.BufAppend(sb, "== Log (tail) ==\n")
        str.BufAppend(sb, "log_path: ")
        str.BufAppend(sb, opts.log_path)
        str.BufAppend(sb, "\n")
        tail := _tail_text(opts.log_path, opts.max_log_bytes)
        str.BufAppend(sb, tail)
        str.BufAppend(sb, "\n")
        mem.Free(tail as void*)
    end

    content := str.BufStr(sb)
    ok := io.WriteFile(path, content) >= 0
    mem.Free(content as void*)
    if not ok:
        mem.Free(path as void*)
        mem.Free(out_dir as void*)
        ret BundleResult { ok = false, path = "", note = "failed to write bundle" }
    end
    if opts.output_dir.Len() == 0:
        mem.Free(out_dir as void*)
    end
    ret BundleResult { ok = true, path = path, note = "diagnostic bundle created (local file only)" }
end

@en "Note"
@fa "یادداشت"
pub func Note(): str:
    ret str.Clone("Diagnostics are collected locally as text bundles; no automatic upload or network transmission is performed.")
end
