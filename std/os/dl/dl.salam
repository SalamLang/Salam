@en "dl"
@fa "بارگذاری کتابخانه"
package dl

import str

if SALAM_OS_LINUX:
    link dynamic "dl"
end

if not SALAM_OS_WINDOWS:
    extern:
        func dlopen(path: void*, flags: int): void*
        func dlsym(handle: void*, name: str): void*
        func dlclose(handle: void*): int
        func dlerror(): void*
    end
end

@en "Supported"
@fa "پشتیبانی می شود"
pub func Supported(): bool:
    ret not SALAM_OS_WINDOWS
end

@en "Open"
@fa "باز کردن"
pub func Open(path: str): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        ret dlopen(path as void*, 2)
    end
end

@en "OpenSelf"
@fa "باز کردن برنامه"
pub func OpenSelf(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        ret dlopen(null, 2)
    end
end

@en "Sym"
@fa "نماد"
pub func Sym(lib: void*, name: str): void*:
    if SALAM_OS_WINDOWS or lib == null:
        ret null
    else:
        ret dlsym(lib, name)
    end
end

@en "Close"
@fa "بستن"
pub func Close(lib: void*): bool:
    if SALAM_OS_WINDOWS or lib == null:
        ret false
    else:
        ret dlclose(lib) == 0
    end
end

@en "Error"
@fa "خطا"
pub func Error(): str:
    if SALAM_OS_WINDOWS:
        ret "dynamic loading is not supported on Windows"
    else:
        e := dlerror()
        if e == null:
            ret ""
        end
        ret str.Clone(e as str)
    end
end

@en "Call"
@fa "فراخوان"
pub func Call(fn: void*, args: size[]): size:
    if fn == null or len(args) > 8:
        ret 0
    end
    n := len(args)
    switch n:
        0:
            f := fn as extern func () size
            ret f()
        end
        1:
            f := fn as extern func (size) size
            ret f(args[0])
        end
        2:
            f := fn as extern func (size, size) size
            ret f(args[0], args[1])
        end
        3:
            f := fn as extern func (size, size, size) size
            ret f(args[0], args[1], args[2])
        end
        4:
            f := fn as extern func (size, size, size, size) size
            ret f(args[0], args[1], args[2], args[3])
        end
        5:
            f := fn as extern func (size, size, size, size, size) size
            ret f(args[0], args[1], args[2], args[3], args[4])
        end
        6:
            f := fn as extern func (size, size, size, size, size, size) size
            ret f(args[0], args[1], args[2], args[3], args[4], args[5])
        end
        7:
            f := fn as extern func (size, size, size, size, size, size, size) size
            ret f(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
        end
        else:
            f := fn as extern func (size, size, size, size, size, size, size, size) size
            ret f(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7])
        end
    end
end
