@en "error"
@fa "خطا"
package error

@en "None"
@fa "بدون خطا"
pub const None := 0

@en "FileNotFound"
@fa "پرونده یافت نشد"
pub const FileNotFound := 1

@en "PermissionDenied"
@fa "دسترسی رد شد"
pub const PermissionDenied := 2

@en "AlreadyExists"
@fa "از قبل موجود است"
pub const AlreadyExists := 3

@en "InvalidPath"
@fa "مسیر نامعتبر"
pub const InvalidPath := 4

@en "NotSupported"
@fa "پشتیبانی نمی شود"
pub const NotSupported := 5

@en "IOError"
@fa "خطای ورودی خروجی"
pub const IOError := 6

@en "Timeout"
@fa "پایان زمان"
pub const Timeout := 7

@en "ProcessFailed"
@fa "فرآیند ناموفق"
pub const ProcessFailed := 8

mut _last_code := 0
mut _last_message := ""
mut _last_operation := ""
mut _last_path := ""
mut _last_system_code := 0

@en "OSError"
@fa "خطای سیستم عامل"
pub struct OSError:
    pub code: int = 0
    pub message: str = ""
    pub operation: str = ""
    pub path: str = ""
    pub system_code: int = 0
end

@en "Set"
@fa "تنظیم خطا"
pub func Set(code: int, message: str, operation: str, path: str, system_code: int):
    _last_code = code
    _last_message = message
    _last_operation = operation
    _last_path = path
    _last_system_code = system_code
end

@en "Clear"
@fa "پاک کردن خطا"
pub func Clear():
    _last_code = None
    _last_message = ""
    _last_operation = ""
    _last_path = ""
    _last_system_code = 0
end

@en "Last"
@fa "آخرین خطا"
pub func Last(): OSError:
    ret OSError {
        code = _last_code, message = _last_message, operation = _last_operation, path = _last_path, system_code = _last_system_code
    }
end

@en "LastCode"
@fa "کد آخرین خطا"
pub func LastCode(): int: ret _last_code end

@en "LastMessage"
@fa "پیام آخرین خطا"
pub func LastMessage(): str: ret _last_message end

@en "HasError"
@fa "خطا دارد"
pub func HasError(): bool: ret _last_code != None end
