@en "mmap"
@fa "نگاشت حافظه"
package mmap

if not SALAM_OS_WINDOWS:
    extern:
        func mmap(addr: void*, len: usize, prot: int, flags: int, fd: int, offset: size): void*
        func munmap(addr: void*, len: usize): int
        func mprotect(addr: void*, len: usize, prot: int): int
        func getpagesize(): int
    end
end

@en "PROT_NONE"
@fa "بدون دسترسی"
pub const PROT_NONE := 0

@en "PROT_READ"
@fa "دسترسی خواندن"
pub const PROT_READ := 1

@en "PROT_WRITE"
@fa "دسترسی نوشتن"
pub const PROT_WRITE := 2

@en "PROT_EXEC"
@fa "دسترسی اجرا"
pub const PROT_EXEC := 4

if SALAM_OS_WINDOWS:
    const MAP_ANON := 0
else SALAM_OS_MAC or SALAM_OS_FREEBSD:
    const MAP_ANON := 4096
else:
    const MAP_ANON := 32
end

@en "Supported"
@fa "پشتیبانی می شود"
pub func Supported(): bool:
    ret not SALAM_OS_WINDOWS
end

@en "PageSize"
@fa "اندازه صفحه"
pub func PageSize(): int:
    if SALAM_OS_WINDOWS:
        ret 4096
    else:
        ret getpagesize()
    end
end

@en "Alloc"
@fa "تخصیص"
pub func Alloc(size: int, prot: int): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        if size <= 0:
            ret null
        end
        p := mmap(null, size as usize, prot, 2 | MAP_ANON, 0 - 1, 0 as size)
        if (p as size) == (0 - 1):
            ret null
        end
        ret p
    end
end

@en "Protect"
@fa "تغییر دسترسی"
pub func Protect(p: void*, size: int, prot: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if p == null or size <= 0:
            ret false
        end
        ret mprotect(p, size as usize, prot) == 0
    end
end

@en "Free"
@fa "آزادسازی"
pub func Free(p: void*, size: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if p == null or size <= 0:
            ret false
        end
        ret munmap(p, size as usize) == 0
    end
end
