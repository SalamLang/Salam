@en "platform"
@fa "سکو"
@ar "المنصة"
package platform

import os
import io
import conv

if SALAM_OS_LINUX:
    extern:
        func sysconf(name: int): i64
    end
end

func str_has_prefix(s: str, prefix: str): bool:
    if prefix.len() > s.len(): ret false end
    ret s.substr(0, prefix.len()) == prefix
end

func extract_digits(s: str): str:
    mut out := ""
    mut i := 0
    n := s.len()
    until i < n:
        c := s.substr(i, 1)
        code := char_code(c)
        if code >= 48 && code <= 57:
            out = out.concat(c)
        else:
            if out.len() > 0: ret out end
        end
        i += 1
    end
    ret out
end

func _meminfo_field(key: str): i64:
    text := io.ReadFile("/proc/meminfo")
    if text.len() == 0: ret 0 - 1 end
    lines := text.split("\n")
    defer lines.free()
    mut i := 0
    n := lines.len()
    until i < n:
        line := lines.get(i)[0]
        if str_has_prefix(line, key):
            rest := line.substr(key.len(), line.len() - key.len())
            digits := extract_digits(rest)
            if digits.len() > 0: ret conv.ParseInt(digits) * 1024 end
            ret 0 - 1
        end
        i += 1
    end
    ret 0 - 1
end

@en "IsLinux"
@fa "لینوکس است"
@ar "هل لینکس"
pub func IsLinux(): bool: if SALAM_OS_LINUX: ret true else: ret false end end

@en "IsWindows"
@fa "ویندوز است"
@ar "هل ویندوز"
pub func IsWindows(): bool: if SALAM_OS_WINDOWS: ret true else: ret false end end

@en "IsMac"
@fa "مک است"
@ar "هل ماك"
pub func IsMac(): bool: if SALAM_OS_MAC: ret true else: ret false end end

@en "IsBSD"
@fa "بی‌اس‌دی است"
@ar "هل بي‌إس‌دي"
pub func IsBSD(): bool: if SALAM_OS_BSD: ret true else: ret false end end

@en "IsFreeBSD"
@fa "فری‌بی‌اس‌دی است"
@ar "هل فري‌بي‌إس‌دي"
pub func IsFreeBSD(): bool: if SALAM_OS_FREEBSD: ret true else: ret false end end

@en "IsAndroid"
@fa "اندروید است"
@ar "هل أندرويد"
pub func IsAndroid(): bool: if SALAM_OS_ANDROID: ret true else: ret false end end

@en "IsWasm"
@fa "وب‌اسمبلی است"
@ar "هل ويب‌أسمبلي"
pub func IsWasm(): bool: if SALAM_OS_WASM: ret true else: ret false end end

@en "OS"
@fa "سیستم عامل"
@ar "نظام التشغیل"
pub func OS(): str:
    if SALAM_OS_WINDOWS: ret "windows"
    else SALAM_OS_MAC: ret "mac"
    else SALAM_OS_LINUX: ret "linux"
    else SALAM_OS_FREEBSD: ret "freebsd"
    else SALAM_OS_ANDROID: ret "android"
    else SALAM_OS_WASM: ret "wasm"
    else: ret "unknown"
    end
end

@en "IsX64"
@fa "ایکس۶۴ است"
@ar "هل إكس٦٤"
pub func IsX64(): bool: if SALAM_ARCH_X64: ret true else: ret false end end

@en "IsArm64"
@fa "آرم۶۴ است"
@ar "هل آرم٦٤"
pub func IsArm64(): bool: if SALAM_ARCH_ARM64: ret true else: ret false end end

@en "IsX86"
@fa "ایکس۸۶ است"
@ar "هل إكس٨٦"
pub func IsX86(): bool: if SALAM_ARCH_X86: ret true else: ret false end end

@en "IsArm"
@fa "آرم است"
@ar "هل آرم"
pub func IsArm(): bool: if SALAM_ARCH_ARM: ret true else: ret false end end

@en "Arch"
@fa "معماری"
@ar "المعماریة"
pub func Arch(): str:
    if SALAM_ARCH_X64: ret "x64"
    else SALAM_ARCH_ARM64: ret "arm64"
    else SALAM_ARCH_X86: ret "x86"
    else SALAM_ARCH_ARM: ret "arm"
    else SALAM_ARCH_WASM: ret "wasm"
    else: ret "unknown"
    end
end

if SALAM_OS_WINDOWS:
    @en "CpuCount"
    @fa "تعداد پردازنده"
    @ar "عدد المعالجات"
    pub func CpuCount(): int:
        v := os.Env("NUMBER_OF_PROCESSORS")
        if v.len() == 0: ret 0 - 1 end
        ret conv.ParseInt(v) as int
    end

    // Memory queries shell out to PowerShell/CIM rather than calling
    // GlobalMemoryStatusEx directly: tcc's bundled kernel32 import stub
    // doesn't cover that symbol, so linking it fails under the default
    // (tcc) build backend; wmic is unavailable on newer Windows builds.
    @en "TotalMemory"
    @fa "کل حافظه"
    @ar "إجمالي الذاکرة"
    pub func TotalMemory(): i64:
        out := os.Output(`powershell -NoProfile -Command "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory"`)
        v := extract_digits(out)
        if v.len() == 0: ret 0 - 1 end
        ret conv.ParseInt(v)
    end

    @en "AvailableMemory"
    @fa "حافظه موجود"
    @ar "الذاکرة المتاحة"
    pub func AvailableMemory(): i64:
        out := os.Output(`powershell -NoProfile -Command "(Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory"`)
        v := extract_digits(out)
        if v.len() == 0: ret 0 - 1 end
        ret conv.ParseInt(v) * 1024
    end
else:
    if SALAM_OS_LINUX:
        @en "CpuCount"
        @fa "تعداد پردازنده"
        @ar "عدد المعالجات"
        pub func CpuCount(): int: ret sysconf(84) as int end
    else:
        @en "CpuCount"
        @fa "تعداد پردازنده"
        @ar "عدد المعالجات"
        pub func CpuCount(): int:
            v := os.Output("sysctl -n hw.ncpu")
            if v.len() == 0: ret 0 - 1 end
            ret conv.ParseInt(v) as int
        end
    end

    @en "TotalMemory"
    @fa "کل حافظه"
    @ar "إجمالي الذاکرة"
    pub func TotalMemory(): i64:
        if SALAM_OS_LINUX:
            v := _meminfo_field("MemTotal:")
            ret v
        else:
            out := os.Output("sysctl -n hw.memsize")
            if out.len() == 0: ret 0 - 1 end
            ret conv.ParseInt(out)
        end
    end

    @en "AvailableMemory"
    @fa "حافظه موجود"
    @ar "الذاکرة المتاحة"
    pub func AvailableMemory(): i64:
        if SALAM_OS_LINUX:
            ret _meminfo_field("MemAvailable:")
        else:
            ret 0 - 1
        end
    end
end
