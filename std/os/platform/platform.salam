@en "platform"
@fa "سکو"
package platform

import os
import io
import conv

if SALAM_OS_LINUX:
    extern:
        func sysconf(name: int): i64
    end

    const _SC_NPROCESSORS_ONLN := 84
end

func str_has_prefix(text: str, prefix: str): bool:
    if prefix.len() > text.len(): ret false end
    ret text.substr(0, prefix.len()) == prefix
end

func extract_digits(text: str): str:
    mut digits := ""
    mut i := 0
    n := text.len()
    until i < n:
        ch := text.substr(i, 1)
        code := char_code(ch)
        if code >= 48 && code <= 57:
            digits = digits.concat(ch)
        else:
            if digits.len() > 0: ret digits end
        end
        i += 1
    end
    ret digits
end

func _meminfo_field(key: str): i64:
    meminfo := io.ReadFile("/proc/meminfo")
    if meminfo.len() == 0: ret 0 - 1 end
    lines := meminfo.split("\n")
    defer lines.free()
    mut i := 0
    line_count := lines.len()
    until i < line_count:
        line := lines.get(i)
        if str_has_prefix(line, key):
            after_key := line.substr(key.len(), line.len() - key.len())
            digits := extract_digits(after_key)
            if digits.len() > 0: ret conv.ParseInt(digits) * 1024 end
            ret 0 - 1
        end
        i += 1
    end
    ret 0 - 1
end

@en "IsLinux"
@fa "لینوکس است"
pub func IsLinux(): bool: if SALAM_OS_LINUX: ret true else:
        ret false
    end
end

@en "IsWindows"
@fa "ویندوز است"
pub func IsWindows(): bool: if SALAM_OS_WINDOWS: ret true else:
        ret false
    end
end

@en "IsMac"
@fa "مک است"
pub func IsMac(): bool: if SALAM_OS_MAC: ret true else:
        ret false
    end
end

@en "IsBSD"
@fa "بی‌اس‌دی است"
pub func IsBSD(): bool: if SALAM_OS_BSD: ret true else:
        ret false
    end
end

@en "IsFreeBSD"
@fa "فری‌بی‌اس‌دی است"
pub func IsFreeBSD(): bool: if SALAM_OS_FREEBSD: ret true else:
        ret false
    end
end

@en "IsAndroid"
@fa "اندروید است"
pub func IsAndroid(): bool: if SALAM_OS_ANDROID: ret true else:
        ret false
    end
end

@en "IsWasm"
@fa "وب‌اسمبلی است"
pub func IsWasm(): bool: if SALAM_OS_WASM: ret true else:
        ret false
    end
end

@en "OS"
@fa "سیستم عامل"
pub func OS(): str:
    if SALAM_OS_WINDOWS: ret "windows"
    else SALAM_OS_MAC: ret "mac"
    else SALAM_OS_LINUX: ret "linux"
    else SALAM_OS_FREEBSD: ret "freebsd"
    else SALAM_OS_ANDROID: ret "android"
    else SALAM_OS_WASM: ret "wasm"
    else:
        ret "unknown"
    end
end

@en "IsX64"
@fa "ایکس۶۴ است"
pub func IsX64(): bool: if SALAM_ARCH_X64: ret true else:
        ret false
    end
end

@en "IsArm64"
@fa "آرم۶۴ است"
pub func IsArm64(): bool: if SALAM_ARCH_ARM64: ret true else:
        ret false
    end
end

@en "IsX86"
@fa "ایکس۸۶ است"
pub func IsX86(): bool: if SALAM_ARCH_X86: ret true else:
        ret false
    end
end

@en "IsArm"
@fa "آرم است"
pub func IsArm(): bool: if SALAM_ARCH_ARM: ret true else:
        ret false
    end
end

@en "Arch"
@fa "معماری"
pub func Arch(): str:
    if SALAM_ARCH_X64: ret "x64"
    else SALAM_ARCH_ARM64: ret "arm64"
    else SALAM_ARCH_X86: ret "x86"
    else SALAM_ARCH_ARM: ret "arm"
    else SALAM_ARCH_WASM: ret "wasm"
    else:
        ret "unknown"
    end
end

if SALAM_OS_WINDOWS:
    @en "CpuCount"
    @fa "تعداد پردازنده"
    pub func CpuCount(): int:
        count := os.Env("NUMBER_OF_PROCESSORS")
        if count.len() == 0: ret 0 - 1 end
        ret conv.ParseInt(count) as int
    end

    @en "TotalMemory"
    @fa "کل حافظه"
    pub func TotalMemory(): i64:
        reply := os.Output(`powershell -NoProfile -Command "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory"`)
        digits := extract_digits(reply)
        if digits.len() == 0: ret 0 - 1 end
        ret conv.ParseInt(digits)
    end

    @en "AvailableMemory"
    @fa "حافظه موجود"
    pub func AvailableMemory(): i64:
        reply := os.Output(`powershell -NoProfile -Command "(Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory"`)
        digits := extract_digits(reply)
        if digits.len() == 0: ret 0 - 1 end
        ret conv.ParseInt(digits) * 1024
    end
else:
    if SALAM_OS_LINUX:
        @en "CpuCount"
        @fa "تعداد پردازنده"
        pub func CpuCount(): int: ret sysconf(_SC_NPROCESSORS_ONLN) as int end
    else:
        @en "CpuCount"
        @fa "تعداد پردازنده"
        pub func CpuCount(): int:
            reply := os.Output("sysctl -n hw.ncpu")
            if reply.len() == 0: ret 0 - 1 end
            ret conv.ParseInt(reply) as int
        end
    end

    @en "TotalMemory"
    @fa "کل حافظه"
    pub func TotalMemory(): i64:
        if SALAM_OS_LINUX:
            ret _meminfo_field("MemTotal:")
        else:
            reply := os.Output("sysctl -n hw.memsize 2>/dev/null || sysctl -n hw.physmem 2>/dev/null")
            if reply.len() == 0: ret 0 - 1 end
            ret conv.ParseInt(reply)
        end
    end

    @en "AvailableMemory"
    @fa "حافظه موجود"
    pub func AvailableMemory(): i64:
        if SALAM_OS_LINUX:
            ret _meminfo_field("MemAvailable:")
        else:
            ret 0 - 1
        end
    end
end
