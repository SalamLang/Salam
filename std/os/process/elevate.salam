package process

import mem
import str
import os

if SALAM_OS_WINDOWS:
    link dynamic "shell32"
    extern:
        func OpenProcess(access: u32, inherit: int, pid: u32): void*
        func ShellExecuteW(
            window: void*, verb: void*, file: void*, params: void*, folder: void*, show: int
        ): void*
        func IsUserAnAdmin(): int
    end
else:
    extern:
        func geteuid(): u32
        func getpgid(pid: int): int
    end
end

func _sh_quote(text: str): str:
    ret "'" + str.Replace(text, "'", "'\\''") + "'"
end

func _script_quote(text: str): str:
    ret "\"" + str.Replace(str.Replace(text, "\\", "\\\\"), "\"", "\\\"") + "\""
end

func _win_quote(text: str): str:
    p := text as u8*
    mut out := str.NewBuilder()
    str.BufAppendChar(out, 34)
    mut slashes := 0
    repeat text.Len() in i:
        c := p[i] as int
        if c == 92:
            slashes++
        else c == 34:
            repeat slashes + 1:
                str.BufAppendChar(out, 92)
            end
            slashes = 0
        else:
            slashes = 0
        end
        str.BufAppendChar(out, c)
    end
    repeat slashes:
        str.BufAppendChar(out, 92)
    end
    str.BufAppendChar(out, 34)
    quoted := str.BufStr(out)
    str.BufFree(out)
    ret quoted
end

func _admin_result(c: Command, timeout_ms: int, refused: str): str:
    r := RunCommand(c, "", timeout_ms)
    if not r.started:
        ret "cannot start " + c.program
    end
    if r.timed_out:
        ret "the administrator prompt timed out"
    end
    if not r.status.Success():
        ret refused
    end
    ret ""
end

func _detached(program: str, args: Vector<str>): Command:
    mut c := NewCommand("/bin/sh")
    c.Arg("-c")
    c.Arg("\"$0\" \"$@\" > /dev/null 2>&1 < /dev/null &")
    c.Arg(program)
    each a in args:
        c.Arg(a)
    end
    ret c
end

@en "IsElevated"
@fa "دسترسی مدیر دارد"
pub func IsElevated(): bool:
    if SALAM_OS_WINDOWS:
        ret IsUserAnAdmin() != 0
    else:
        ret geteuid() == (0 as u32)
    end
end

@en "Alive"
@fa "زنده است"
pub func Alive(pid: int): bool:
    if pid <= 0:
        ret false
    end
    if SALAM_OS_WINDOWS:
        h := OpenProcess(4096 as u32, 0, pid as u32)
        if h == null:
            ret GetLastError() == 5
        end
        code := mem.AllocateZeroed(8 as u64)
        ok := GetExitCodeProcess(h, code)
        value := (code as u32*)[0]
        mem.Free(code)
        _closed := CloseHandle(h)
        ret ok != 0 and value == (259 as u32)
    else:
        ret getpgid(pid) >= 0
    end
end

@en "RunElevated"
@fa "اجرا با دسترسی مدیر"
pub func RunElevated(program: str, args: Vector<str>, prompt: str, timeout_ms: int): str:
    if SALAM_OS_WINDOWS:
        mut line := ""
        each a in args:
            line += _win_quote(a) + " "
        end
        verb := _spawn_wide("runas")
        file := _spawn_wide(program)
        params := _spawn_wide(line)
        done := ShellExecuteW(null, verb, file, params, null, 0)
        mem.Free(verb)
        mem.Free(file)
        mem.Free(params)
        if (done as i64) <= (32 as i64):
            ret "administrator permission was not given"
        end
        ret ""
    else:
        if IsElevated():
            ret _admin_result(_detached(program, args), timeout_ms, "cannot start " + program)
        end
        if SALAM_OS_MAC:
            mut line := _sh_quote(program)
            each a in args:
                line += " " + _sh_quote(a)
            end
            line += " > /dev/null 2>&1 &"
            script := "do shell script " + _script_quote(line) + " with prompt " +
                _script_quote(prompt) + " with administrator privileges"
            mut c := NewCommand("/usr/bin/osascript")
            c.Arg("-e")
            c.Arg(script)
            ret _admin_result(c, timeout_ms, "administrator permission was not given")
        else:
            if not os.Exists("/usr/bin/pkexec"):
                ret "pkexec is not installed: install polkit, or run the program with sudo"
            end
            inner := _detached(program, args)
            mut c := NewCommand("/usr/bin/pkexec")
            c.Arg(inner.program)
            each a in inner.args:
                c.Arg(a)
            end
            ret _admin_result(c, timeout_ms, "administrator permission was not given")
        end
    end
end
