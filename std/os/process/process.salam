@en "process"
@fa "فرآیند"
@ar "العملیة"
package process

import mem
import str
import io
import os
import os.error
import os.temp

if SALAM_OS_WINDOWS:
    link dynamic "kernel32"
    extern:
        func CreateProcessA(app: void*, cmdline: void*, pattr: void*, tattr: void*, inherit: int, flags: int, envp: void*, cwd: void*, si: void*, pi: void*): int
        func WaitForSingleObject(h: void*, ms: int): int
        func GetExitCodeProcess(h: void*, code: void*): int
        func TerminateProcess(h: void*, code: int): int
        func CloseHandle(h: void*): int
        func GetLastError(): int
        func CreateFileA(path: str, access: u32, share: u32, sattr: void*, disp: u32, flags: u32, template: void*): void*
    end
else:
    extern:
        environ: void*
        func posix_spawnp(pid: void*, file: str, file_actions: void*, attrp: void*, argv: void*, envp: void*): int
        func waitpid(pid: int, status: void*, options: int): int
        func kill(pid: int, sig: int): int
        func posix_spawn_file_actions_init(actions: void*): int
        func posix_spawn_file_actions_destroy(actions: void*): int
        func posix_spawn_file_actions_addopen(actions: void*, fd: int, path: str, flags: int, mode: int): int
    end
end

@en "Process"
@fa "فرآیند"
@ar "عملیة"
pub struct Process:
    pub pid: int = 0
    pub handle: void* = null
    pub running: bool = false
    pub exit_code: int = 0
    // Capture is file-backed on every platform - see _open_inheritable and the
    // POSIX StartCaptured - so there are no stream handles to hold onto here.
    pub stdout_path: str = ""
    pub stderr_path: str = ""
end

func _strptr(s: str): i64:
    v := s as void*
    ret v as i64
end

if SALAM_OS_WINDOWS:
    func _u32_at(base: void*, off: i64): u32:
        p := ((base as i64) + off) as u32*
        ret p[0]
    end

    func _u32_set(base: void*, off: i64, v: u32):
        p := ((base as i64) + off) as u32*
        p[0] = v
    end

    func _ptr_at(base: void*, off: i64): void*:
        p := ((base as i64) + off) as i64*
        ret (p[0]) as void*
    end

    func _needs_quotes(s: str): bool:
        if s.len() == 0: ret true end
        ret str.Contains(s, " ")
    end

    func _append_token(sb &: str.StringBuilder, tok: str):
        if _needs_quotes(tok):
            str.BufAppendChar(sb, 34)
            str.BufAppend(sb, tok)
            str.BufAppendChar(sb, 34)
        else:
            str.BufAppend(sb, tok)
        end
    end

    func _build_cmdline(path: str, args: Vector<str>): str:
        mut sb := str.NewBuilder()
        _append_token(sb, path)
        n := args.len()
        mut i := 0
        until i < n:
            str.BufAppendChar(sb, 32)
            _append_token(sb, args.get(i))
            i += 1
        end
        out := str.BufStr(sb)
        str.BufFree(sb)
        ret out
    end

    func _build_sa(): void*:
        sa := mem.AllocateZeroed(24 as u64)
        _u32_set(sa, 0, 24 as u32)
        _u32_set(sa, 16, 1 as u32)
        ret sa
    end

    // Capture targets a real file opened with an inheritable handle, never an
    // anonymous pipe. A pipe has a fixed kernel buffer (4 KB by default, which
    // is what CreatePipe's size=0 asks for): a child that outruns it blocks in
    // WriteFile, and a parent that waits for the child before draining blocks
    // in WaitForSingleObject - neither side can break that. Draining first
    // does not fix it either, because two pipes have to be drained
    // concurrently or whichever one is read second fills up and deadlocks the
    // same way. A file handle applies no back-pressure at all, so both streams
    // are captured with no ordering constraint between Wait and the reads.
    func _open_inheritable(path: str, access: u32, disp: u32): void*:
        sa := _build_sa()
        // FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_ATTRIBUTE_NORMAL: the
        // parent has to be able to read the file back while the child writes.
        h := CreateFileA(path, access, 3 as u32, sa, disp, 128 as u32, null)
        mem.Free(sa)
        invalid := (0 - 1) as i64
        if (h as i64) == invalid: ret null end
        ret h
    end
else:
    func _build_argv(path: str, args: Vector<str>): void*:
        n := args.len()
        arr := mem.Allocate(((n + 2) as u64) * (8 as u64)) as i64*
        arr[0] = _strptr(path)
        mut i := 0
        until i < n:
            arr[i + 1] = _strptr(args.get(i))
            i += 1
        end
        arr[n + 1] = 0 as i64
        ret arr as void*
    end

    // O_WRONLY | O_CREAT | O_TRUNC, whose bit values differ between Linux
    // (0x40 / 0x200) and macOS (0x200 / 0x400).
    func _open_flags(): int:
        if SALAM_OS_MAC: ret 1 + 512 + 1024 end
        ret 1 + 64 + 512
    end
end

if SALAM_OS_WINDOWS:
    @en "Start"
    @fa "شروع"
    @ar "بدء"
    pub func Start(path: str, args: Vector<str>): Process:
        cmdline := _build_cmdline(path, args)
        si := mem.AllocateZeroed(104 as u64)
        _u32_set(si, 0, 104 as u32)
        pi := mem.AllocateZeroed(24 as u64)
        ok := CreateProcessA(null, cmdline as void*, null, null, 0, 0, null, null, si, pi)
        mem.Free(si)
        mut p := Process {}
        if ok == 0:
            error.Set(error.ProcessFailed, "CreateProcess failed", "Start", path, GetLastError())
            mem.Free(pi)
            ret p
        end
        p.pid = _u32_at(pi, 16) as int
        p.handle = _ptr_at(pi, 0)
        th := _ptr_at(pi, 8)
        CloseHandle(th)
        mem.Free(pi)
        p.running = true
        ret p
    end

    @en "StartCaptured"
    @fa "شروع با ضبط"
    @ar "بدء مع الالتقاط"
    pub func StartCaptured(path: str, args: Vector<str>): Process:
        out_path := temp.File()
        err_path := temp.File()
        // GENERIC_WRITE + CREATE_ALWAYS for the two capture files. NUL with
        // GENERIC_READ + OPEN_EXISTING for stdin, so a child that reads stdin
        // sees EOF instead of competing with the parent for its console - a
        // captured child inheriting a live stdin blocks forever on the first
        // read, and the parent blocks with it in Wait.
        out_h := _open_inheritable(out_path, 1073741824 as u32, 2 as u32)
        err_h := _open_inheritable(err_path, 1073741824 as u32, 2 as u32)
        in_h := _open_inheritable("NUL", 2147483648 as u32, 3 as u32)

        cmdline := _build_cmdline(path, args)
        si := mem.AllocateZeroed(104 as u64)
        _u32_set(si, 0, 104 as u32)
        _u32_set(si, 60, 256 as u32)
        p80 := ((si as i64) + 80) as i64*
        p80[0] = in_h as i64
        p88 := ((si as i64) + 88) as i64*
        p88[0] = out_h as i64
        p96 := ((si as i64) + 96) as i64*
        p96[0] = err_h as i64

        pi := mem.AllocateZeroed(24 as u64)
        ok := CreateProcessA(null, cmdline as void*, null, null, 1, 0, null, null, si, pi)
        mem.Free(si)
        // The child owns its own duplicates from here on; without these the
        // parent keeps the capture files open for writing for its own
        // lifetime.
        if in_h != null: CloseHandle(in_h) end
        if out_h != null: CloseHandle(out_h) end
        if err_h != null: CloseHandle(err_h) end

        mut p := Process {}
        // Recorded even on the failure path so Cleanup can still remove the
        // two temp files that were created above.
        p.stdout_path = out_path
        p.stderr_path = err_path
        if ok == 0:
            error.Set(error.ProcessFailed, "CreateProcess failed", "StartCaptured", path, GetLastError())
            mem.Free(pi)
            ret p
        end
        p.pid = _u32_at(pi, 16) as int
        p.handle = _ptr_at(pi, 0)
        th := _ptr_at(pi, 8)
        CloseHandle(th)
        mem.Free(pi)
        p.running = true
        ret p
    end

    @en "Wait"
    @fa "انتظار"
    @ar "انتظار"
    pub func Wait(p &: Process): int:
        // A Process whose spawn failed has no handle to wait on; without this
        // GetExitCodeProcess fails too and its untouched buffer reads back as
        // a clean exit 0.
        if p.handle == null: ret 0 - 1 end
        WaitForSingleObject(p.handle, 0 - 1)
        buf := mem.AllocateZeroed(4 as u64)
        GetExitCodeProcess(p.handle, buf)
        code := _u32_at(buf, 0) as int
        mem.Free(buf)
        CloseHandle(p.handle)
        // Cleared, not just closed: the guard above is only worth anything if
        // a second Wait (or a Kill after Wait) cannot reach a stale handle.
        p.handle = null
        p.running = false
        p.exit_code = code
        ret code
    end

    @en "Kill"
    @fa "کشتن"
    @ar "قتل"
    pub func Kill(p &: Process): int:
        if p.handle == null: ret 0 - 1 end
        if TerminateProcess(p.handle, 1) == 0: ret 0 - 1 end
        p.running = false
        ret 0
    end

    @en "Terminate"
    @fa "پایان دادن"
    @ar "إنهاء"
    pub func Terminate(p &: Process): int: ret Kill(p) end
else:
    @en "Start"
    @fa "شروع"
    @ar "بدء"
    pub func Start(path: str, args: Vector<str>): Process:
        argv := _build_argv(path, args)
        pidbuf := mem.AllocateZeroed(4 as u64)
        rc := posix_spawnp(pidbuf, path, null, null, argv, environ)
        mem.Free(argv)
        mut p := Process {}
        if rc != 0:
            error.Set(error.ProcessFailed, "posix_spawnp failed", "Start", path, rc)
            mem.Free(pidbuf)
            ret p
        end
        pidp := pidbuf as int*
        p.pid = pidp[0]
        mem.Free(pidbuf)
        p.running = true
        ret p
    end

    @en "StartCaptured"
    @fa "شروع با ضبط"
    @ar "بدء مع الالتقاط"
    pub func StartCaptured(path: str, args: Vector<str>): Process:
        out_path := temp.File()
        err_path := temp.File()
        argv := _build_argv(path, args)
        actions := mem.AllocateZeroed(256 as u64)
        posix_spawn_file_actions_init(actions)
        // fd 0 <- /dev/null (O_RDONLY, which is 0 on every supported target).
        // A captured child otherwise inherits the parent's stdin: anything
        // that reads it - a prompt, `git`, a pager - blocks forever with no
        // reader ever supplying input, and Wait below blocks with it. That is
        // a hang whose only visible symptom is an empty capture, because the
        // child never got far enough to write a byte.
        posix_spawn_file_actions_addopen(actions, 0, "/dev/null", 0, 0)
        posix_spawn_file_actions_addopen(actions, 1, out_path, _open_flags(), 420)
        posix_spawn_file_actions_addopen(actions, 2, err_path, _open_flags(), 420)
        pidbuf := mem.AllocateZeroed(4 as u64)
        rc := posix_spawnp(pidbuf, path, actions, null, argv, environ)
        posix_spawn_file_actions_destroy(actions)
        mem.Free(actions)
        mem.Free(argv)
        mut p := Process {}
        // Recorded even on the failure path so Cleanup can still remove the
        // two temp files that were created above.
        p.stdout_path = out_path
        p.stderr_path = err_path
        if rc != 0:
            error.Set(error.ProcessFailed, "posix_spawnp failed", "StartCaptured", path, rc)
            mem.Free(pidbuf)
            ret p
        end
        pidp2 := pidbuf as int*
        p.pid = pidp2[0]
        mem.Free(pidbuf)
        p.running = true
        ret p
    end

    @en "Wait"
    @fa "انتظار"
    @ar "انتظار"
    pub func Wait(p &: Process): int:
        // pid 0 is a Process that never started (Start/StartCaptured left the
        // default in place after a failed spawn). It has to be turned away
        // here: to waitpid and kill, 0 does not mean "nothing", it means
        // "every process in my group".
        if p.pid <= 0: ret 0 - 1 end
        statusbuf := mem.AllocateZeroed(4 as u64)
        mut rc := waitpid(p.pid, statusbuf, 0)
        // waitpid is a cancellation point: any signal delivered to this thread
        // (an http.Run handler thread is as likely to get one as the main
        // thread) cuts it short with EINTR before the child is reaped, leaving
        // statusbuf untouched. The old code ignored the return value entirely
        // and read that still-zero buffer as "exited, status 0" - a success
        // code for a child that was in fact still running, and whose capture
        // files were then read empty. kill(pid, 0) is the errno-free way to
        // tell the two failure modes apart: it succeeds while the child exists
        // (zombies included, so the retry can still reap it) and fails once it
        // is gone for good, which is what stops this from spinning when the
        // child was already reaped elsewhere.
        until rc < 0 && kill(p.pid, 0) == 0:
            rc = waitpid(p.pid, statusbuf, 0)
        end
        sp := statusbuf as int*
        status := sp[0]
        mem.Free(statusbuf)
        mut code := 0 - 1
        if rc == p.pid:
            // Low 7 bits are the terminating signal, 0 for a normal exit, in
            // which case the exit status is the next byte up. A child killed
            // by a signal used to divide down to 0 and report success; report
            // it the way a shell does instead, as 128 + signal.
            low := status % 128
            if low == 0:
                code = (status / 256) % 256
            else:
                if low != 127: code = 128 + low end
            end
        end
        p.running = false
        p.exit_code = code
        ret code
    end

    @en "Kill"
    @fa "کشتن"
    @ar "قتل"
    pub func Kill(p &: Process): int:
        if p.pid <= 0: ret 0 - 1 end // see Wait: kill(0, sig) signals the group
        if kill(p.pid, 9) != 0: ret 0 - 1 end
        p.running = false
        ret 0
    end

    @en "Terminate"
    @fa "پایان دادن"
    @ar "إنهاء"
    pub func Terminate(p &: Process): int:
        if p.pid <= 0: ret 0 - 1 end // see Wait: kill(0, sig) signals the group
        if kill(p.pid, 15) != 0: ret 0 - 1 end
        p.running = false
        ret 0
    end
end

// StartCaptured redirects both streams to temp files on every platform, so
// reading them is one plain file read with no ordering constraint against
// Wait: read before it, after it, twice, or not at all.
@en "ReadStdout"
@fa "خواندن خروجی"
@ar "قراءة المخرجات"
pub func ReadStdout(p: Process): str:
    if p.stdout_path.len() == 0: ret "" end
    ret io.ReadFile(p.stdout_path)
end

@en "ReadStderr"
@fa "خواندن خطا"
@ar "قراءة الأخطاء"
pub func ReadStderr(p: Process): str:
    if p.stderr_path.len() == 0: ret "" end
    ret io.ReadFile(p.stderr_path)
end

// Removes the temp files StartCaptured created. Callers that capture in a
// loop - a request handler shelling out per request, say - have to call this
// or leak two files per spawn for the lifetime of the process.
@en "Cleanup"
@fa "پاکسازی"
@ar "تنظیف"
pub func Cleanup(p &: Process):
    if p.stdout_path.len() > 0:
        os.Remove(p.stdout_path)
        p.stdout_path = ""
    end
    if p.stderr_path.len() > 0:
        os.Remove(p.stderr_path)
        p.stderr_path = ""
    end
end

@en "ExitCode"
@fa "کد خروج"
@ar "رمز الخروج"
pub func ExitCode(p: Process): int: ret p.exit_code end

@en "Pid"
@fa "شناسه فرآیند"
@ar "معرف العملیة"
pub func Pid(p: Process): int: ret p.pid end

@en "IsRunning"
@fa "در حال اجرا"
@ar "قید التشغیل"
pub func IsRunning(p: Process): bool: ret p.running end
