package process

if SALAM_OS_WINDOWS:
    extern:
        func CreateProcessW(app: void*, cmdline: void*, pattr: void*, tattr: void*, inherit: int, flags: u32, env: void*, cwd: void*, si: void*, pi: void*): int
        func MultiByteToWideChar(code_page: u32, flags: u32, mb_str: str, mb_len: i32, wide_buf: void*, wide_len: i32): i32
    end
else:
    extern:
        func setpgid(pid: int, group: int): int
        func chdir(path: str): int
        func open(path: str, flags: int, ...): int
        func dup2(from_fd: int, to_fd: int): int
        func close(fd: int): int
        func execvp(file: str, argv: void*): int
    end
end

@en "SpawnOptions"
@fa "گزینه های راه اندازی"
pub struct SpawnOptions:
    @en "path"
    @fa "مسیر"
    pub path: str = ""
    @en "args"
    @fa "آرگومان ها"
    pub args: Vector<str> = Vector {}
    @en "raw_args"
    @fa "آرگومان های خام"
    pub raw_args: str = ""
    @en "cwd"
    @fa "پوشه کاری"
    pub cwd: str = ""
    @en "output"
    @fa "پرونده خروجی"
    pub output: str = ""
end

if SALAM_OS_WINDOWS:
    func _spawn_wide(s: str): void*:
        needed := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
        buf := mem.Allocate(((needed + 1) as u64) * (2 as u64))
        MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, buf, needed + 1)
        ret buf
    end

    func _spawn_quote(sb &: str.StringBuilder, arg: str):
        n := str.Len(arg)
        bytes := arg as u8*
        mut plain := n > 0
        repeat n in i:
            c := bytes[i] as int
            if c == 32 or c == 9 or c == 34:
                plain = false
            end
        end
        if plain:
            str.BufAppend(sb, arg)
            ret
        end
        str.BufAppendChar(sb, 34)
        mut slashes := 0
        repeat n in i:
            c := bytes[i] as int
            if c == 92:
                slashes++
                str.BufAppendChar(sb, 92)
                continue
            end
            if c == 34:
                repeat slashes + 1:
                    str.BufAppendChar(sb, 92)
                end
            end
            slashes = 0
            str.BufAppendChar(sb, c)
        end
        repeat slashes:
            str.BufAppendChar(sb, 92)
        end
        str.BufAppendChar(sb, 34)
    end

    func _spawn_cmdline(o: SpawnOptions): str:
        mut sb := str.NewBuilder()
        _spawn_quote(sb, o.path)
        each arg in o.args:
            str.BufAppendChar(sb, 32)
            _spawn_quote(sb, arg)
        end
        if o.raw_args.Len() > 0:
            str.BufAppendChar(sb, 32)
            str.BufAppend(sb, o.raw_args)
        end
        out := str.BufStr(sb)
        str.BufFree(sb)
        ret out
    end

    @en "Spawn"
    @fa "راه اندازی"
    pub func Spawn(o: SpawnOptions): Process:
        cmdline := _spawn_wide(_spawn_cmdline(o))
        defer mem.Free(cmdline)
        wide_cwd := o.cwd.Len() > 0 ? _spawn_wide(o.cwd) : null
        si := mem.AllocateZeroed(104 as u64)
        defer mem.Free(si)
        _u32_set(si, 0, _si_size() as u32)
        mut p := Process {}
        out_h := o.output.Len() > 0 ? _open_inheritable(o.output, 1073741824 as u32, 2 as u32) : null
        if o.output.Len() > 0 and out_h == null:
            error.Set(error.ProcessFailed, "cannot open the output file", "Spawn", o.output, -1)
            ret p
        end
        in_h := _open_inheritable("NUL", 2147483648 as u32, 3 as u32)
        if out_h != null:
            _u32_set(si, _si_flags_at(), 256 as u32)
            _ptr_set(si, _si_handles_at(), in_h)
            _ptr_set(si, _si_handles_at() + _word(), out_h)
            _ptr_set(si, _si_handles_at() + _word() * 2, out_h)
        end
        pi := mem.AllocateZeroed(24 as u64)
        defer mem.Free(pi)
        ok := CreateProcessW(null, cmdline, null, null, 1, 0x08000000 as u32, null, wide_cwd, si, pi)
        if in_h != null: CloseHandle(in_h) end
        if out_h != null: CloseHandle(out_h) end
        if wide_cwd != null: mem.Free(wide_cwd) end
        if ok == 0:
            error.Set(error.ProcessFailed, "CreateProcess failed", "Spawn", o.path, GetLastError())
            ret p
        end
        p.pid = _u32_at(pi, _pi_pid_at()) as int
        p.handle = _ptr_at(pi, 0)
        CloseHandle(_ptr_at(pi, _word()))
        p.running = true
        ret p
    end

    @en "TryWait"
    @fa "انتظار بدون توقف"
    pub func TryWait(p &: Process): bool:
        if p.handle == null: ret true end
        if WaitForSingleObject(p.handle, 0) != 0:
            ret false
        end
        buf := mem.AllocateZeroed(4 as u64)
        GetExitCodeProcess(p.handle, buf)
        p.exit_code = _u32_at(buf, 0) as int
        mem.Free(buf)
        CloseHandle(p.handle)
        p.handle = null
        p.running = false
        ret true
    end

    @en "KillTree"
    @fa "کشتن درخت"
    pub func KillTree(p &: Process):
        if p.pid <= 0 or p.handle == null: ret end
        mut args := Vector {} as Vector<str>
        defer args.free()
        args.push("/PID")
        args.push(str.FromInt(p.pid as i64))
        args.push("/T")
        args.push("/F")
        mut killer := Spawn(SpawnOptions { path = "taskkill", args = args })
        _code := Wait(killer)
    end
else:
    @en "Spawn"
    @fa "راه اندازی"
    pub func Spawn(o: SpawnOptions): Process:
        argv := _build_argv(o.path, o.args)
        out_fd := o.output.Len() > 0 ? open(o.output, _open_flags(), 0o600) : -1
        if o.output.Len() > 0 and out_fd < 0:
            mem.Free(argv)
            error.Set(error.ProcessFailed, "cannot open the output file", "Spawn", o.output, -1)
            ret Process {}
        end
        in_fd := open("/dev/null", 0, 0)
        pid := fork()
        if pid == 0:
            _pg := setpgid(0, 0)
            if o.cwd.Len() > 0 and chdir(o.cwd) != 0:
                _exit(126)
            end
            if in_fd >= 0:
                _in := dup2(in_fd, 0)
            end
            if out_fd >= 0:
                _o1 := dup2(out_fd, 1)
                _o2 := dup2(out_fd, 2)
            end
            _gone := execvp(o.path, argv)
            _exit(127)
        end
        mem.Free(argv)
        if out_fd >= 0: close(out_fd) end
        if in_fd >= 0: close(in_fd) end
        mut p := Process {}
        if pid < 0:
            error.Set(error.ProcessFailed, "fork failed", "Spawn", o.path, pid)
            ret p
        end
        _pg2 := setpgid(pid, pid)
        p.pid = pid
        p.running = true
        ret p
    end

    @en "TryWait"
    @fa "انتظار بدون توقف"
    pub func TryWait(p &: Process): bool:
        if p.pid <= 0: ret true end
        statusbuf := mem.AllocateZeroed(4 as u64)
        defer mem.Free(statusbuf)
        rc := waitpid(p.pid, statusbuf, 1)
        if rc == 0:
            ret false
        end
        if rc < 0:
            p.running = false
            ret true
        end
        status := (statusbuf as int*)[0]
        low := status % 128
        if low == 0:
            p.exit_code = (status / 256) % 256
        else:
            p.exit_code = 128 + low
        end
        p.running = false
        ret true
    end

    @en "KillTree"
    @fa "کشتن درخت"
    pub func KillTree(p &: Process):
        if p.pid > 0:
            _sent := kill(0 - p.pid, 9)
        end
    end
end
