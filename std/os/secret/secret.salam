@en "os/secret"
@fa "راز"
package secret

import mem
import str

if SALAM_OS_MAC:
    link framework "Security"
    link framework "CoreFoundation"

    extern:
        func SecKeychainAddGenericPassword(
            chain: void*,
            service_len: u32,
            service: str,
            account_len: u32,
            account: str,
            password_len: u32,
            password: void*,
            item: void*
        ): i32
        func SecKeychainFindGenericPassword(
            chain: void*,
            service_len: u32,
            service: str,
            account_len: u32,
            account: str,
            password_len: void*,
            password: void*,
            item: void*
        ): i32
        func SecKeychainItemModifyAttributesAndData(
            item: void*, attrs: void*, length: u32, data: void*
        ): i32
        func SecKeychainItemFreeContent(attrs: void*, data: void*): i32
        func SecKeychainItemDelete(item: void*): i32
        func SecKeychainCopyDefault(out: void*): i32
        func SecKeychainGetStatus(keychain: void*, out: void*): i32
        func CFRelease(value: void*)
    end

    struct _Slot:
        pub v: void* = null
    end

    func _available(): bool:
        slot := (mem.AllocateZeroed(size(_Slot) as u64)) as _Slot*
        defer mem.Free(slot as void*)
        status := (mem.AllocateZeroed(8 as u64)) as u32*
        defer mem.Free(status as void*)
        if SecKeychainCopyDefault(slot as void*) != 0 or slot[0].v == null:
            ret false
        end
        usable := SecKeychainGetStatus(slot[0].v, status as void*) == 0
        CFRelease(slot[0].v)
        ret usable
    end

    func _set(service: str, key: str, value: str): bool:
        if not _available():
            ret false
        end
        item_out := (mem.AllocateZeroed(size(_Slot) as u64)) as _Slot*
        defer mem.Free(item_out as void*)
        size_out := (mem.AllocateZeroed(8 as u64)) as u32*
        defer mem.Free(size_out as void*)
        data_out := (mem.AllocateZeroed(size(_Slot) as u64)) as _Slot*
        defer mem.Free(data_out as void*)
        service_len := str.Len(service) as u32
        key_len := str.Len(key) as u32
        value_len := str.Len(value) as u32
        found := SecKeychainFindGenericPassword(
            null,
            service_len,
            service,
            key_len,
            key,
            size_out as void*,
            data_out as void*,
            item_out as void*
        )
        if found == 0:
            SecKeychainItemFreeContent(null, data_out[0].v)
            changed := SecKeychainItemModifyAttributesAndData(
                item_out[0].v, null, value_len, value as void*
            )
            CFRelease(item_out[0].v)
            ret changed == 0
        end
        ret SecKeychainAddGenericPassword(
            null, service_len, service, key_len, key, value_len, value as void*, null
        ) == 0
    end

    func _get(service: str, key: str): str:
        if not _available():
            ret str.Clone("")
        end
        size_out := (mem.AllocateZeroed(8 as u64)) as u32*
        defer mem.Free(size_out as void*)
        data_out := (mem.AllocateZeroed(size(_Slot) as u64)) as _Slot*
        defer mem.Free(data_out as void*)
        found := SecKeychainFindGenericPassword(
            null,
            str.Len(service) as u32,
            service,
            str.Len(key) as u32,
            key,
            size_out as void*,
            data_out as void*,
            null
        )
        if found != 0:
            ret str.Clone("")
        end
        size_bytes := size_out[0] as u64
        copy := mem.AllocateZeroed(size_bytes + (1 as u64))
        mem.Copy(copy, data_out[0].v, size_bytes)
        SecKeychainItemFreeContent(null, data_out[0].v)
        ret copy as str
    end

    func _delete(service: str, key: str): bool:
        if not _available():
            ret false
        end
        item_out := (mem.AllocateZeroed(size(_Slot) as u64)) as _Slot*
        defer mem.Free(item_out as void*)
        found := SecKeychainFindGenericPassword(
            null,
            str.Len(service) as u32,
            service,
            str.Len(key) as u32,
            key,
            null,
            null,
            item_out as void*
        )
        if found != 0:
            ret false
        end
        gone := SecKeychainItemDelete(item_out[0].v)
        CFRelease(item_out[0].v)
        ret gone == 0
    end
else SALAM_OS_LINUX and not SALAM_OS_ANDROID:
    link dynamic "dl"

    extern:
        func dlopen(path: str, mode: int): void*
        func dlsym(lib: void*, name: str): void*
    end

    func _library(): void*:
        ret dlopen("libsecret-1.so.0", 2)
    end

    func _schema(service: str): void*:
        schema := mem.AllocateZeroed(1024 as u64)
        fields := schema as i64*
        fields[0] = (service as void*) as i64
        fields[2] = ("key" as void*) as i64
        ret schema
    end

    func _available(): bool:
        lib := _library()
        if lib == null:
            ret false
        end
        lookup := dlsym(lib, "secret_password_lookup_sync")
        if lookup == null:
            ret false
        end
        f := lookup as extern func (void*, void*, void*, str, str, void*) void* schema := _schema(
            "salam.secret.probe"
        )
        defer mem.Free(schema)
        failure := mem.AllocateZeroed(8 as u64)
        defer mem.Free(failure)
        _found := f(schema, null, failure, "key", "probe", null)
        ret (failure as i64*)[0] == (0 as i64)
    end

    func _set(service: str, key: str, value: str): bool:
        lib := _library()
        if lib == null:
            ret false
        end
        store := dlsym(lib, "secret_password_store_sync")
        if store == null:
            ret false
        end
        f := store as extern func (void*, void*, str, str, void*, void*, str, str, void*) int
        schema := _schema(service)
        defer mem.Free(schema)
        ret f(schema, null, service, value, null, null, "key", key, null) != 0
    end

    func _get(service: str, key: str): str:
        lib := _library()
        if lib == null:
            ret str.Clone("")
        end
        lookup := dlsym(lib, "secret_password_lookup_sync")
        if lookup == null:
            ret str.Clone("")
        end
        f := lookup as extern func (void*, void*, void*, str, str, void*) void* schema := _schema(
            service
        )
        defer mem.Free(schema)
        raw := f(schema, null, null, "key", key, null)
        if raw == null:
            ret str.Clone("")
        end
        out := str.Clone(raw as str)
        release := dlsym(lib, "secret_password_free")
        if release != null:
            g := release as extern func (void*)
            g(raw)
        end
        ret out
    end

    func _delete(service: str, key: str): bool:
        lib := _library()
        if lib == null:
            ret false
        end
        clear := dlsym(lib, "secret_password_clear_sync")
        if clear == null:
            ret false
        end
        f := clear as extern func (void*, void*, void*, str, str, void*) int
        schema := _schema(service)
        defer mem.Free(schema)
        ret f(schema, null, null, "key", key, null) != 0
    end
else SALAM_OS_WINDOWS:
    link dynamic "kernel32"

    extern:
        func LoadLibraryW(name: void*): void*
        func GetProcAddress(module: void*, name: str): void*
        func MultiByteToWideChar(
            page: u32, flags: u32, text: str, length: int, out: void*, room: int
        ): int
    end

    struct _Slot:
        pub v: void* = null
    end

    struct _Credential:
        pub flags: u32 = 0
        pub kind: u32 = 1
        pub target: void* = null
        pub comment: void* = null
        pub written_low: u32 = 0
        pub written_high: u32 = 0
        pub blob_size: u32 = 0
        pub blob: void* = null
        pub persist: u32 = 2
        pub attribute_count: u32 = 0
        pub attributes: void* = null
        pub alias: void* = null
        pub user: void* = null
    end

    func _wide(text: str): void*:
        needed := MultiByteToWideChar(65001 as u32, 0 as u32, text, -1, null, 0)
        buf := mem.Allocate(((needed + 1) as u64) * (2 as u64))
        MultiByteToWideChar(65001 as u32, 0 as u32, text, -1, buf, needed + 1)
        ret buf
    end

    func _proc(name: str): void*:
        wide := _wide("advapi32.dll")
        module := LoadLibraryW(wide)
        mem.Free(wide)
        if module == null:
            ret null
        end
        ret GetProcAddress(module, name)
    end

    func _available(): bool:
        ret _proc("CredWriteW") != null
    end

    func _target(service: str, key: str): void*:
        ret _wide(service.Concat("/").Concat(key))
    end

    func _set(service: str, key: str, value: str): bool:
        write_fn := _proc("CredWriteW")
        if write_fn == null:
            ret false
        end
        target := _target(service, key)
        user := _wide(service)
        defer mem.Free(target)
        defer mem.Free(user)
        cred := (mem.AllocateZeroed(size(_Credential) as u64)) as _Credential*
        defer mem.Free(cred as void*)
        cred[0] = _Credential {
            target = target,
            user = user,
            blob = value as void*,
            blob_size = str.Len(value) as u32
        }
        f := write_fn as extern stdcall func (void*, u32) i32
        ret f(cred as void*, 0 as u32) != 0
    end

    func _get(service: str, key: str): str:
        read_fn := _proc("CredReadW")
        if read_fn == null:
            ret str.Clone("")
        end
        target := _target(service, key)
        defer mem.Free(target)
        out := (mem.AllocateZeroed(size(_Slot) as u64)) as _Slot*
        defer mem.Free(out as void*)
        f := read_fn as extern stdcall func (void*, u32, u32, void*) i32
        if f(target, 1 as u32, 0 as u32, out as void*) == 0 or out[0].v == null:
            ret str.Clone("")
        end
        cred := out[0].v as _Credential*
        size_bytes := cred[0].blob_size as u64
        copy := mem.AllocateZeroed(size_bytes + (1 as u64))
        mem.Copy(copy, cred[0].blob, size_bytes)
        free_fn := _proc("CredFree") as extern stdcall func (void*)
        free_fn(out[0].v)
        ret copy as str
    end

    func _delete(service: str, key: str): bool:
        delete_fn := _proc("CredDeleteW")
        if delete_fn == null:
            ret false
        end
        target := _target(service, key)
        defer mem.Free(target)
        f := delete_fn as extern stdcall func (void*, u32, u32) i32
        ret f(target, 1 as u32, 0 as u32) != 0
    end
else:
    func _available(): bool:
        ret false
    end

    func _set(service: str, key: str, value: str): bool:
        ret service.Len() < 0 and key.Len() < 0 and value.Len() < 0
    end

    func _get(service: str, key: str): str:
        ret service.Len() < 0 and key.Len() < 0 ? "" : str.Clone("")
    end

    func _delete(service: str, key: str): bool:
        ret service.Len() < 0 and key.Len() < 0
    end
end

@en "Available"
@fa "در دسترس"
pub func Available(): bool:
    ret _available()
end

@en "Set"
@fa "گذاشتن"
pub func Set(service: str, key: str, value: str): bool:
    ret _set(service, key, value)
end

@en "Get"
@fa "گرفتن"
pub func Get(service: str, key: str): str:
    ret _get(service, key)
end

@en "Delete"
@fa "پاک کردن"
pub func Delete(service: str, key: str): bool:
    ret _delete(service, key)
end
