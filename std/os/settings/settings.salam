@en "settings"
@fa "تنظیمات"
package settings

import os
import io
import str
import mem
import filepath
import fs.path
import fs.dir
import conv
import collections

@en "Store"
@fa "ذخیره ساز"
pub struct Store:
    @en "app_id"
    @fa "شناسه برنامه"
    pub app_id: str = ""
    @en "path"
    @fa "مسیر"
    pub path: str = ""
    @en "data"
    @fa "داده"
    pub data: collections.OrderedMap = collections.OrderedMap {}
    @en "loaded"
    @fa "بارگذاری شده"
    pub loaded: bool = false
end

func _escape(s: str): str:
    mut b := str.NewBuilder()
    n := s.Len()
    repeat n in i:
        ch := s.Substr(i, 1)
        if ch == "\\":
            str.BufAppend(b, "\\\\")
        else ch == "\n":
            str.BufAppend(b, "\\n")
        else ch == "\r":
            str.BufAppend(b, "\\r")
        else ch == "=":
            str.BufAppend(b, "\\=")
        else ch == "#":
            str.BufAppend(b, "\\#")
        else:
            str.BufAppend(b, ch)
        end
        mem.Free(ch as void*)
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func _unescape(s: str): str:
    mut b := str.NewBuilder()
    n := s.Len()
    mut i := 0
    until i < n:
        ch := s.Substr(i, 1)
        if ch == "\\" and i + 1 < n:
            nx := s.Substr(i + 1, 1)
            if nx == "n":
                str.BufAppend(b, "\n")
            else nx == "r":
                str.BufAppend(b, "\r")
            else nx == "\\":
                str.BufAppend(b, "\\")
            else nx == "=":
                str.BufAppend(b, "=")
            else nx == "#":
                str.BufAppend(b, "#")
            else:
                str.BufAppend(b, nx)
            end
            mem.Free(nx as void*)
            i += 2
        else:
            str.BufAppend(b, ch)
            i += 1
        end
        mem.Free(ch as void*)
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func _make_key(section: str, key: str): str:
    if section.Len() == 0: ret str.Clone(key) end
    ret section.Concat(".").Concat(key)
end

func _safe_component(id: str): str:
    if id.Len() == 0: ret str.Clone("default") end
    ret str.Clone(id)
end

func _default_path(app_id: str): str:
    id := _safe_component(app_id)
    defer mem.Free(id as void*)
    mut base := str.Clone("")
    if SALAM_OS_WINDOWS:
        appdata := os.Env("APPDATA")
        if str.Len(appdata) == 0:
            mem.Free(appdata as void*)
            tmp := os.Env("USERPROFILE")
            if str.Len(tmp) == 0:
                mem.Free(tmp as void*)
                base = str.Clone(".")
            else:
                base = tmp
            end
        else:
            base = appdata
        end
    else SALAM_OS_MAC:
        home := os.Env("HOME")
        base = filepath.Join(home, "Library/Application Support")
        mem.Free(home as void*)
    else:
        xdg := os.Env("XDG_CONFIG_HOME")
        if str.Len(xdg) > 0:
            base = xdg
        else:
            mem.Free(xdg as void*)
            home := os.Env("HOME")
            base = filepath.Join(home, ".config")
            mem.Free(home as void*)
        end
    end
    folder := filepath.Join(base, id)
    file := filepath.Join(folder, "settings.properties")
    mem.Free(base as void*)
    mem.Free(folder as void*)
    ret file
end

func _ensure_parent(p: str):
    parent := filepath.Dir(p)
    _r := os.MkdirAll(parent)
    mem.Free(parent as void*)
end

@en "DefaultPath"
@fa "مسیر پیش‌فرض"
pub func DefaultPath(app_id: str): str:
    ret _default_path(app_id)
end

@en "Path"
@fa "مسیر"
pub func Path(s &: Store): str:
    ret str.Clone(s.path)
end

@en "New"
@fa "جدید"
pub func New(app_id: str): Store:
    p := _default_path(app_id)
    ret Store { app_id = str.Clone(app_id), path = p, data = collections.OrderedMap {}, loaded = false }
end

@en "NewWithPath"
@fa "جدید با مسیر"
pub func NewWithPath(app_id: str, path: str): Store:
    ret Store { app_id = str.Clone(app_id), path = str.Clone(path), data = collections.OrderedMap {}, loaded = false }
end

@en "Init"
@fa "مقداردهی"
pub func Init(app_id: str): Store:
    mut st := New(app_id)
    _ok := Load(st)
    ret st
end

@en "InitWithPath"
@fa "مقداردهی با مسیر"
pub func InitWithPath(app_id: str, path: str): Store:
    mut st := NewWithPath(app_id, path)
    _ok := Load(st)
    ret st
end

@en "Load"
@fa "بارگذاری"
pub func Load(s &: Store): bool:
    s.data.Free()
    s.data = collections.OrderedMap {}
    text := io.ReadFile(s.path)
    s.loaded = true
    if text.Len() == 0:
        mem.Free(text as void*)
        ret false
    end
    lines := text.Split("\n")
    defer lines.Free()
    mut section := str.Clone("")
    repeat lines.Len() in i:
        raw := lines.Get(i)
        line := str.Trim(raw)
        if line.Len() > 0:
            head := line.Substr(0, 1)
            mut skip := false
            if head == "#" or head == ";":
                skip = true
            end
            if not skip and head == "[" and str.EndsWith(line, "]"):
                inner := line.Substr(1, line.Len() - 2)
                sec := str.Trim(inner)
                mem.Free(section as void*)
                section = sec
                mem.Free(inner as void*)
                skip = true
            end
            if not skip:
                eq := str.IndexOf(line, "=")
                if eq > 0:
                    left := line.Substr(0, eq)
                    right := line.Substr(eq + 1, line.Len() - eq -1)
                    kraw := str.Trim(left)
                    vraw := str.Trim(right)
                    k := _unescape(kraw)
                    v := _unescape(vraw)
                    full := _make_key(section, k)
                    s.data.Set(full, v)
                    mem.Free(full as void*)
                    mem.Free(k as void*)
                    mem.Free(v as void*)
                    mem.Free(kraw as void*)
                    mem.Free(vraw as void*)
                    mem.Free(left as void*)
                    mem.Free(right as void*)
                end
            end
            mem.Free(head as void*)
        end
        mem.Free(line as void*)
    end
    mem.Free(section as void*)
    mem.Free(text as void*)
    ret true
end

func _key_section(k: str): str:
    dot := str.IndexOf(k, ".")
    if dot <= 0: ret str.Clone("") end
    ret k.Substr(0, dot)
end

func _key_name(k: str): str:
    dot := str.IndexOf(k, ".")
    if dot < 0: ret str.Clone(k) end
    ret k.Substr(dot + 1, k.Len() - dot - 1)
end

@en "Serialize"
@fa "سریال‌سازی"
pub func Serialize(s &: Store): str:
    mut b := str.NewBuilder()

    // root keys (no '.' separator interpreted as section key) first
    repeat s.data.Len() in i:
        k := s.data.key_at(i)
        sec := _key_section(k)
        if sec.Len() == 0:
            ek := _escape(k)
            ev := _escape(s.data.val_at(i))
            str.BufAppend(b, ek)
            str.BufAppend(b, "=")
            str.BufAppend(b, ev)
            str.BufAppend(b, "\n")
            mem.Free(ek as void*)
            mem.Free(ev as void*)
        end
        mem.Free(sec as void*)
    end

    done := Vector {} as Vector<str>
    repeat s.data.Len() in i:
        k := s.data.key_at(i)
        sec := _key_section(k)
        if sec.Len() > 0:
            mut seen := false
            repeat done.Len() in j:
                if done.Get(j) == sec:
                    seen = true
                end
            end
            if not seen:
                done.Push(str.Clone(sec))
                str.BufAppend(b, "[")
                str.BufAppend(b, sec)
                str.BufAppend(b, "]\n")
                repeat s.data.Len() in m:
                    km := s.data.key_at(m)
                    msec := _key_section(km)
                    if msec == sec:
                        local := _key_name(km)
                        ek := _escape(local)
                        ev := _escape(s.data.val_at(m))
                        str.BufAppend(b, ek)
                        str.BufAppend(b, "=")
                        str.BufAppend(b, ev)
                        str.BufAppend(b, "\n")
                        mem.Free(local as void*)
                        mem.Free(ek as void*)
                        mem.Free(ev as void*)
                    end
                    mem.Free(msec as void*)
                end
            end
        end
        mem.Free(sec as void*)
    end

    out := str.BufStr(b)
    str.BufFree(b)
    repeat done.Len() in i:
        mem.Free(done.Get(i) as void*)
    end
    done.Free()
    ret out
end

@en "Save"
@fa "ذخیره"
pub func Save(s &: Store): bool:
    _ensure_parent(s.path)
    out := Serialize(s)
    tmp := s.path.Concat(".tmp")
    ok := io.WriteFile(tmp, out) >= 0
    if ok:
        // atomic-ish replace: remove old then rename temp
        if os.Exists(s.path):
            _r := os.Remove(s.path)
        end
        ok = os.Move(tmp, s.path) == 0
        if not ok:
            // fallback: direct write if rename/move failed
            ok = io.WriteFile(s.path, out) >= 0
            if os.Exists(tmp):
                _r2 := os.Remove(tmp)
            end
        end
    else:
        if os.Exists(tmp):
            _r3 := os.Remove(tmp)
        end
    end
    mem.Free(tmp as void*)
    mem.Free(out as void*)
    ret ok
end

@en "Set"
@fa "تنظیم"
pub func Set(s &: Store, key: str, value: str):
    s.data.Set(key, value)
end

@en "SetSection"
@fa "تنظیم در بخش"
pub func SetSection(s &: Store, section: str, key: str, value: str):
    full := _make_key(section, key)
    s.data.Set(full, value)
    mem.Free(full as void*)
end

@en "Get"
@fa "دریافت"
pub func Get(s &: Store, key: str, def: str): str:
    ret s.data.GetOr(key, def)
end

@en "GetSection"
@fa "دریافت از بخش"
pub func GetSection(s &: Store, section: str, key: str, def: str): str:
    full := _make_key(section, key)
    out := s.data.GetOr(full, def)
    mem.Free(full as void*)
    ret out
end

@en "GetInt"
@fa "دریافت عدد"
pub func GetInt(s &: Store, key: str, def: i64): i64:
    if s.data.Has(key) == false: ret def end
    ret conv.ParseIntOr(s.data.Get(key), def)
end

@en "GetIntSection"
@fa "دریافت عدد از بخش"
pub func GetIntSection(s &: Store, section: str, key: str, def: i64): i64:
    full := _make_key(section, key)
    mut out := def
    if s.data.Has(full):
        out = conv.ParseIntOr(s.data.Get(full), def)
    end
    mem.Free(full as void*)
    ret out
end

@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(s &: Store, key: str, def: bool): bool:
    if s.data.Has(key) == false: ret def end
    ret conv.ParseBoolOr(s.data.Get(key), def)
end

@en "GetBoolSection"
@fa "دریافت منطقی از بخش"
pub func GetBoolSection(s &: Store, section: str, key: str, def: bool): bool:
    full := _make_key(section, key)
    mut out := def
    if s.data.Has(full):
        out = conv.ParseBoolOr(s.data.Get(full), def)
    end
    mem.Free(full as void*)
    ret out
end

@en "Has"
@fa "دارد"
pub func Has(s &: Store, key: str): bool:
    ret s.data.Has(key)
end

@en "HasSection"
@fa "دارد در بخش"
pub func HasSection(s &: Store, section: str, key: str): bool:
    full := _make_key(section, key)
    ok := s.data.Has(full)
    mem.Free(full as void*)
    ret ok
end

@en "Delete"
@fa "حذف"
pub func Delete(s &: Store, key: str): bool:
    ret s.data.Remove(key) >= 0
end

@en "DeleteSection"
@fa "حذف از بخش"
pub func DeleteSection(s &: Store, section: str, key: str): bool:
    full := _make_key(section, key)
    ok := s.data.Remove(full) >= 0
    mem.Free(full as void*)
    ret ok
end

@en "Keys"
@fa "کلیدها"
pub func Keys(s &: Store): Vector<str>:
    ret s.data.CloneKeys()
end

@en "Clear"
@fa "پاک‌کردن"
pub func Clear(s &: Store):
    s.data.Free()
    s.data = collections.OrderedMap {}
end

@en "Reload"
@fa "بارگذاری مجدد"
pub func Reload(s &: Store): bool:
    ret Load(s)
end

@en "MergeFrom"
@fa "ادغام از"
pub func MergeFrom(s &: Store, other &: Store, overwrite: bool = true):
    repeat other.data.Len() in i:
        k := other.data.key_at(i)
        if overwrite or not s.data.Has(k):
            s.data.Set(k, other.data.val_at(i))
        end
    end
end

@en "SetInt"
@fa "تنظیم عدد"
pub func SetInt(s &: Store, key: str, value: i64):
    v := conv.FormatInt(value)
    s.data.Set(key, v)
    mem.Free(v as void*)
end

@en "SetIntSection"
@fa "تنظیم عدد در بخش"
pub func SetIntSection(s &: Store, section: str, key: str, value: i64):
    full := _make_key(section, key)
    v := conv.FormatInt(value)
    s.data.Set(full, v)
    mem.Free(full as void*)
    mem.Free(v as void*)
end

@en "SetBool"
@fa "تنظیم منطقی"
pub func SetBool(s &: Store, key: str, value: bool):
    s.data.Set(key, value ? "true" : "false")
end

@en "SetBoolSection"
@fa "تنظیم منطقی در بخش"
pub func SetBoolSection(s &: Store, section: str, key: str, value: bool):
    full := _make_key(section, key)
    s.data.Set(full, value ? "true" : "false")
    mem.Free(full as void*)
end

@en "ExportTo"
@fa "برون‌بری به"
pub func ExportTo(s &: Store, path: str): bool:
    old := str.Clone(s.path)
    SetPath(s, path)
    ok := Save(s)
    SetPath(s, old)
    mem.Free(old as void*)
    ret ok
end

@en "ImportFrom"
@fa "درون‌ریزی از"
pub func ImportFrom(s &: Store, path: str, overwrite: bool = true): bool:
    mut tmp := NewWithPath(s.app_id, path)
    if not Load(tmp):
        Free(tmp)
        ret false
    end
    MergeFrom(s, tmp, overwrite)
    Free(tmp)
    ret true
end

@en "ExistsOnDisk"
@fa "روی دیسک وجود دارد"
pub func ExistsOnDisk(s &: Store): bool:
    ret os.Exists(s.path)
end

@en "SetPath"
@fa "تنظیم مسیر"
pub func SetPath(s &: Store, path: str):
    if s.path.Len() > 0:
        mem.Free(s.path as void*)
    end
    s.path = str.Clone(path)
end

@en "Count"
@fa "تعداد"
pub func Count(s &: Store): int:
    ret s.data.Len()
end

@en "Remove"
@fa "حذف"
pub func Remove(s &: Store, key: str): bool:
    ret Delete(s, key)
end

@en "RemoveSection"
@fa "حذف از بخش"
pub func RemoveSection(s &: Store, section: str, key: str): bool:
    ret DeleteSection(s, section, key)
end

@en "Free"
@fa "آزادسازی"
pub func Free(s &: Store):
    s.data.Free()
    if s.app_id.Len() > 0:
        mem.Free(s.app_id as void*)
    end
    if s.path.Len() > 0:
        mem.Free(s.path as void*)
    end
    s.app_id = ""
    s.path = ""
    s.loaded = false
end
