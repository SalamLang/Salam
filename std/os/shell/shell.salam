@en "shell"
@fa "پوسته"
package shell

import str
import os.process

// Note: prefer process-based execution to avoid extern C runtime symbol collisions.

@en "CmdResult"
@fa "نتیجه فرمان"
pub struct CmdResult:
    @en "code"
    @fa "کد"
    pub code: int = 0
    @en "out"
    @fa "خروجی"
    pub out: str = ""
    @en "err"
    @fa "خروجی خطا"
    pub err: str = ""
end

@en "Run"
@fa "اجرا"
pub func Run(command: str, args: Vector<str>): CmdResult:
    mut p := process.StartCaptured(command, args)
    if p.pid <= 0:
        process.Cleanup(p)
        ret CmdResult { code = -1, out = str.Clone(""), err = str.Clone("") }
    end
    code := process.Wait(p)
    out := process.ReadStdout(p)
    err := process.ReadStderr(p)
    process.Cleanup(p)
    ret CmdResult { code = code, out = out, err = err }
end

@en "ExecShell"
@fa "اجرا در پوسته"
pub func ExecShell(command: str): CmdResult:
    // Shell-interpreted execution with captured output (quoting/expansion handled by shell).
    if SALAM_OS_WINDOWS:
        mut args := Vector {} as Vector<str>
        defer args.Free()
        args.Push("/c")
        args.Push(command)
        ret Run("cmd.exe", args)
    else:
        mut args := Vector {} as Vector<str>
        defer args.Free()
        args.Push("-c")
        args.Push(command)
        ret Run("/bin/sh", args)
    end
end

@en "Exec"
@fa "اجرا با متن فرمان"
pub func Exec(command: str): CmdResult:
    // Legacy best-effort whitespace split (no shell quoting/expansion). Prefer ExecShell for command strings.
    parts := command.Split(" ")
    defer parts.Free()
    n := parts.Len()
    if n == 0: ret CmdResult { code = -1, out = str.Clone(""), err = str.Clone("") } end
    exe := parts.Get(0)
    mut args := Vector {} as Vector<str>
    defer args.Free()
    mut i := 1
    until i < n:
        seg := parts.Get(i)
        if seg.Len() > 0: args.Push(seg) end
        i++
    end
    ret Run(exe, args)
end

@en "System"
@fa "اجرای پوسته"
pub func System(command: str): int:
    if SALAM_OS_WINDOWS:
        line := "cmd.exe /S /C \"" + command + "\""
        mut p := process.StartCommandLine(line)
        if p.pid <= 0:
            ret 127
        end
        ret process.Wait(p)
    else:
        mut args := Vector {} as Vector<str>
        args.Push("-c")
        args.Push(command)
        mut p := process.Start("/bin/sh", args)
        args.Free()
        if p.pid <= 0:
            ret 127
        end
        ret process.Wait(p)
    end
end
