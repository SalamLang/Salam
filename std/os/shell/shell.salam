@en "shell"
@fa "پوسته"
@ar "الصدفة"
package shell

import os.process

@en "CmdResult"
@fa "نتیجه فرمان"
@ar "نتیجة الأمر"
pub struct CmdResult:
    pub code: int = 0
    pub out: str = ""
    pub err: str = ""
end

@en "Run"
@fa "اجرا"
@ar "تشغیل"
pub func Run(command: str, args: Vector<str>): CmdResult:
    mut p := process.StartCaptured(command, args)
    if p.pid <= 0:
        ret CmdResult { code = 0 - 1 }
    end
    code := process.Wait(p)
    out := process.ReadStdout(p)
    err := process.ReadStderr(p)
    ret CmdResult { code = code, out = out, err = err }
end

@en "Exec"
@fa "اجرا با متن فرمان"
@ar "تنفیذ سطر الأمر"
pub func Exec(command: str): CmdResult:
    parts := command.split(" ")
    defer parts.free()
    n := parts.len()
    if n == 0: ret CmdResult { code = 0 - 1 } end
    exe := parts.get(0)[0]
    args := Vector {} as Vector<str>
    mut i := 1
    until i < n:
        seg := parts.get(i)[0]
        if seg.len() > 0: args.push(seg) end
        i += 1
    end
    ret Run(exe, args)
end
