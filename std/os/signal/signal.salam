if SALAM_OS_WINDOWS:
    @en "SignalSetSize"
    @fa "اندازه مجموعه سیگنال"
    pub const SignalSetSize := 0
else SALAM_OS_MAC:
    @en "SignalSetSize"
    @fa "اندازه مجموعه سیگنال"
    pub const SignalSetSize := 4
else SALAM_OS_OPENBSD:
    @en "SignalSetSize"
    @fa "اندازه مجموعه سیگنال"
    pub const SignalSetSize := 4
else SALAM_OS_BSD:
    @en "SignalSetSize"
    @fa "اندازه مجموعه سیگنال"
    pub const SignalSetSize := 16
else SALAM_OS_ANDROID:
    if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
        @en "SignalSetSize"
        @fa "اندازه مجموعه سیگنال"
        pub const SignalSetSize := 4
    else:
        @en "SignalSetSize"
        @fa "اندازه مجموعه سیگنال"
        pub const SignalSetSize := 8
    end
else:
    @en "SignalSetSize"
    @fa "اندازه مجموعه سیگنال"
    pub const SignalSetSize := 128
end

if SALAM_OS_BSD:
    const _SIG_BLOCK := 1
    const _SIG_UNBLOCK := 2
    const _SIG_SETMASK := 3
else:
    const _SIG_BLOCK := 0
    const _SIG_UNBLOCK := 1
    const _SIG_SETMASK := 2
end

if SALAM_OS_LINUX:
    const _EAGAIN := 11
end

if SALAM_OS_ANDROID:
    if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
        const _SA_HANDLER_U64 := 0
    else:
        const _SA_HANDLER_U64 := 1
    end
else:
    const _SA_HANDLER_U64 := 0
end

if SALAM_OS_WINDOWS:
    const _SIGACTION_SIZE := 0
    const _SA_FLAGS_WORD := 0
    const _SA_RESTART := 0
else SALAM_OS_MAC:
    const _SIGACTION_SIZE := 16
    const _SA_FLAGS_WORD := 3
    const _SA_RESTART := 0x0002
else SALAM_OS_OPENBSD:
    const _SIGACTION_SIZE := 16
    const _SA_FLAGS_WORD := 3
    const _SA_RESTART := 0x0002
else SALAM_OS_NETBSD:
    const _SIGACTION_SIZE := 32
    const _SA_FLAGS_WORD := 6
    const _SA_RESTART := 0x0002
else SALAM_OS_BSD:
    const _SIGACTION_SIZE := 32
    const _SA_FLAGS_WORD := 2
    const _SA_RESTART := 0x0002
else SALAM_OS_ANDROID:
    if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
        const _SIGACTION_SIZE := 16
        const _SA_FLAGS_WORD := 2
    else:
        const _SIGACTION_SIZE := 32
        const _SA_FLAGS_WORD := 0
    end
    const _SA_RESTART := 0x10000000
else SALAM_ARCH_X86 or SALAM_ARCH_ARM:
    const _SIGACTION_SIZE := 140
    const _SA_FLAGS_WORD := 33
    const _SA_RESTART := 0x10000000
else:
    const _SIGACTION_SIZE := 152
    const _SA_FLAGS_WORD := 34
    const _SA_RESTART := 0x10000000
end

if not SALAM_OS_WINDOWS:
    const _REG_SLOTS := 128
    const _REG_HDR_MUTEX := 0
    const _REG_HDR_WAITER := 8
    const _REG_HDR_PENDING := 16
    const _REG_HDR_SIZE := 144
    const _REG_SLOT_SIZE := 80
    const _REG_SLOT_REFS := 0
    const _REG_SLOT_HANDLER := 1
    const _REG_SLOT_PREV := 2
    const _REG_SLOT_KQUEUE := 24
    const _REG_SLOT_KEVENT := 32
    const _REG_SLOT_TIMESPEC := 64

    const _HANDLE_SIZE := _SIGACTION_SIZE + SignalSetSize

    mut _reg := null as void*

    mut _mu := sync.NewMutex()
end

if not SALAM_OS_WINDOWS:
    mut _winch_out := null as void*
end

if not SALAM_OS_WINDOWS:
    func _winch_noop(_sig: int):
        _ := _sig
    end
end

if not SALAM_OS_WINDOWS:
    func _slot(sig: int): void*:
        base := (_reg as u64) + (_REG_HDR_SIZE as u64)
        ret (base + ((sig as u64) * (_REG_SLOT_SIZE as u64))) as void*
    end

    func _registry(): void*:
        if _reg == null:
            _reg = mem.AllocateZeroed((_REG_HDR_SIZE + _REG_SLOTS * _REG_SLOT_SIZE) as u64)
            if _reg == null: ret null end
            _ := sigemptyset(((_reg as u64) + (_REG_HDR_PENDING as u64)) as void*)
        end
        ret _reg
    end

    func _claim_waiter(): bool:
        _ := sync.Lock(_mu)
        if _reg == null:
            _ := sync.Unlock(_mu)
            ret true
        end
        flag := (_reg as u64) + (_REG_HDR_WAITER as u64)
        busy := (flag as i32*)[0] != 0
        if not busy:
            (flag as i32*)[0] = 1
        end
        _ := sync.Unlock(_mu)
        ret not busy
    end

    func _release_waiter():
        _ := sync.Lock(_mu)
        if _reg != null:
            flag := (_reg as u64) + (_REG_HDR_WAITER as u64)
            (flag as i32*)[0] = 0
        end
        _ := sync.Unlock(_mu)
    end

    func _put_back(sig: int, handle: void*): bool:
        disposition_ok := sigaction(sig, handle, null) == 0
        mask := ((handle as u64) + (_SIGACTION_SIZE as u64)) as void*
        mask_ok := SetMask(mask)
        ret disposition_ok and mask_ok
    end

    func _snapshot_copy(canonical: void*): void*:
        copy := mem.AllocateZeroed(_HANDLE_SIZE as u64)
        if copy == null: ret null end
        mem.Copy(copy, canonical, _HANDLE_SIZE as u64)
        ret copy
    end
end

if SALAM_OS_MAC:
    func _single_signal(set: void*): int:
        mut found := 0
        mut i := 1
        until i <= 64:
            if IsSignal(set, i):
                if found > 0: ret -1 end
                found = i
            end
            i++
        end
        if found == 0: ret -1 end
        ret found
    end
end

@en "WinchSupported"
@fa "تغییر اندازه پشتیبانی می شود"
pub func WinchSupported(): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        ret true
    end
end

@en "NewWinchSet"
@fa "مجموعه تغییر اندازه جدید"
pub func NewWinchSet(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        set := NewSet()
        if set == null: ret null end
        if not AddSignal(set, WinchSignal):
            mem.Free(set)
            ret null
        end
        ret set
    end
end

@en "InstallWinchHandler"
@fa "نصب گرداننده تغییر اندازه"
pub func InstallWinchHandler(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        ret Install(WinchSignal, &_winch_noop)
    end
end

@en "Install"
@fa "نصب"
pub func Install(sig: int, handler: void*): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        if sig <= 0 or sig >= _REG_SLOTS: ret null end
        _ := sync.Lock(_mu)
        if _registry() == null:
            _ := sync.Unlock(_mu)
            ret null
        end
        slot := _slot(sig)
        refs := (slot as i64*)[_REG_SLOT_REFS]
        if refs > 0:
            if (slot as u64*)[_REG_SLOT_HANDLER] != (handler as u64):
                _ := sync.Unlock(_mu)
                ret null
            end
            copy := _snapshot_copy((slot as u64*)[_REG_SLOT_PREV] as void*)
            if copy == null:
                _ := sync.Unlock(_mu)
                ret null
            end
            (slot as i64*)[_REG_SLOT_REFS] = refs + 1
            _ := sync.Unlock(_mu)
            ret copy
        end
        canonical := mem.AllocateZeroed(_HANDLE_SIZE as u64)
        if canonical == null:
            _ := sync.Unlock(_mu)
            ret null
        end
        mask := ((canonical as u64) + (_SIGACTION_SIZE as u64)) as void*
        if pthread_sigmask(_SIG_BLOCK, null, mask) != 0:
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        act := mem.AllocateZeroed(_SIGACTION_SIZE as u64)
        if act == null:
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        (act as u64*)[_SA_HANDLER_U64] = handler as u64
        (act as i32*)[_SA_FLAGS_WORD] = _SA_RESTART
        installed := sigaction(sig, act, canonical) == 0
        mem.Free(act)
        if not installed:
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        set := NewSet()
        mut blocked := false
        if set != null:
            if AddSignal(set, sig):
                blocked = Block(set)
            end
            mem.Free(set)
        end
        if not blocked:
            _ := _put_back(sig, canonical)
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        if SALAM_OS_MAC:
            kq := kqueue()
            if kq < 0:
                _ := _put_back(sig, canonical)
                mem.Free(canonical)
                _ := sync.Unlock(_mu)
                ret null
            end
            kev := ((slot as u64) + (_REG_SLOT_KEVENT as u64)) as void*
            (kev as i64*)[0] = sig as i64
            (kev as i16*)[4] = -6 as i16
            (kev as i16*)[5] = 5 as i16
            (kev as i32*)[3] = 0
            (kev as i64*)[2] = 0
            (kev as u64*)[3] = 0
            if kevent(kq, kev, 1, null, 0, null) != 0:
                _ := close(kq)
                _ := _put_back(sig, canonical)
                mem.Free(canonical)
                _ := sync.Unlock(_mu)
                ret null
            end
            (((slot as u64) + (_REG_SLOT_KQUEUE as u64)) as i64*)[0] = kq as i64
        end
        copy := mem.AllocateZeroed(_HANDLE_SIZE as u64)
        if copy == null:
            _ := _put_back(sig, canonical)
            mem.Free(canonical)
            if SALAM_OS_MAC:
                _ := close((((slot as u64) + (_REG_SLOT_KQUEUE as u64)) as i64*)[0] as int)
            end
            _ := sync.Unlock(_mu)
            ret null
        end
        mem.Copy(copy, canonical, _HANDLE_SIZE as u64)
        (slot as u64*)[_REG_SLOT_HANDLER] = handler as u64
        (slot as u64*)[_REG_SLOT_PREV] = canonical as u64
        (slot as i64*)[_REG_SLOT_REFS] = 1
        _ := sync.Unlock(_mu)
        ret copy
    end
end

@en "Restore"
@fa "بازگردانی"
pub func Restore(sig: int, prev: void*): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if sig <= 0 or prev == null: ret false end
        _ := sync.Lock(_mu)
        if _reg == null or sig >= _REG_SLOTS:
            _ := sync.Unlock(_mu)
            ret _put_back(sig, prev)
        end
        slot := _slot(sig)
        refs := (slot as i64*)[_REG_SLOT_REFS]
        if refs > 1:
            (slot as i64*)[_REG_SLOT_REFS] = refs - 1
            _ := sync.Unlock(_mu)
            ret true
        end
        if refs == 1:
            (slot as i64*)[_REG_SLOT_REFS] = 0
            canonical := (slot as u64*)[_REG_SLOT_PREV] as void*
            ok := _put_back(sig, canonical)
            mem.Free((slot as u64*)[_REG_SLOT_PREV] as void*)
            (slot as u64*)[_REG_SLOT_HANDLER] = 0
            (slot as u64*)[_REG_SLOT_PREV] = 0
            if SALAM_OS_MAC:
                kq := ((slot as u64) + (_REG_SLOT_KQUEUE as u64)) as i64*
                if kq[0] >= 0:
                    _ := close(kq[0] as int)
                    kq[0] = -1
                end
            end
            _ := sync.Unlock(_mu)
            ret ok
        end
        _ := sync.Unlock(_mu)
        ret true
    end
end

@en "BlockWinch"
@fa "مسدود کردن تغییر اندازه"
pub func BlockWinch(): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        set := NewWinchSet()
        if set == null: ret false end
        blocked := Block(set)
        mem.Free(set)
        ret blocked
    end
end

@en "Wait"
@fa "انتظار"
pub func Wait(set: void*, out: void*): int:
    if SALAM_OS_WINDOWS:
        ret WaitInvalid
    else:
        if set == null or out == null: ret WaitInvalid end
        if not _claim_waiter(): ret WaitBusy end
        status := sigwait(set, out)
        _release_waiter()
        if status == 0: ret WaitArrived end
        ret WaitFailed
    end
end

@en "WaitTimeout"
@fa "انتظار با مهلت"
pub func WaitTimeout(set: void*, out: void*, millis: int): int:
    if SALAM_OS_WINDOWS:
        ret WaitInvalid
    else:
        if set == null or out == null or millis < 0: ret WaitInvalid end
        if _reg == null: ret WaitInvalid end
        mut sig := 0
        if SALAM_OS_MAC:
            sig = _single_signal(set)
            if sig < 0: ret WaitInvalid end
        end
        if not _claim_waiter(): ret WaitBusy end
        slot := _slot(sig)
        ts := ((slot as u64) + (_REG_SLOT_TIMESPEC as u64)) as i64*
        if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
            (ts as i32*)[0] = millis / 1000
            (ts as i32*)[1] = (millis % 1000) * 1000000
        else:
            ts[0] = (millis / 1000) as i64
            ts[1] = ((millis % 1000) * 1000000) as i64
        end
        mut status := WaitFailed
        if SALAM_OS_MAC:
            kq := (((slot as u64) + (_REG_SLOT_KQUEUE as u64)) as i64*)[0] as int
            kev := ((slot as u64) + (_REG_SLOT_KEVENT as u64)) as void*
            n := kevent(kq, null, 0, kev, 1, ts as void*)
            if n > 0:
                pending := ((_reg as u64) + (_REG_HDR_PENDING as u64)) as void*
                if sigpending(pending) == 0 and IsSignal(pending, sig):
                    if sigwait(set, out) == 0: status = WaitArrived end
                end
                if status != WaitArrived: status = WaitTimedOut end
            else if n == 0:
                status = WaitTimedOut
            end
        else SALAM_OS_LINUX:
            rc := sigtimedwait(set, null, ts as void*)
            if rc > 0:
                (out as i32*)[0] = rc
                status = WaitArrived
            else if rc < 0:
                if (__errno_location() as i32*)[0] == _EAGAIN:
                    status = WaitTimedOut
                end
            end
        else:
            status = WaitInvalid
        end
        _release_waiter()
        ret status
    end
end

@en "WaitWinch"
@fa "انتظار تغییر اندازه"
pub func WaitWinch(set: void*): int:
    if SALAM_OS_WINDOWS:
        ret 0
    else:
        if set == null: ret WaitInvalid end
        if _winch_out == null:
            _winch_out = mem.AllocateZeroed(8 as u64)
            if _winch_out == null: ret WaitFailed end
        end
        status := Wait(set, _winch_out)
        if status != WaitArrived: ret status end
        ret (_winch_out as i32*)[0]
    end
end

@en "WakeWinch"
@fa "بیدار کردن تغییر اندازه"
pub func WakeWinch(): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        ret kill(getpid(), WinchSignal) == 0
    end
end

@en "NewSet"
@fa "مجموعه جدید"
pub func NewSet(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        set := mem.AllocateZeroed(SignalSetSize as u64)
        if set == null: ret null end
        _ := sigemptyset(set)
        ret set
    end
end

@en "FillSet"
@fa "پر کردن مجموعه"
pub func FillSet(set: void*):
    if SALAM_OS_WINDOWS:
        ret
    else:
        if set == null: ret end
        _ := sigfillset(set)
    end
end

@en "AddSignal"
@fa "افزودن سیگنال"
pub func AddSignal(set: void*, sig: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null or sig <= 0: ret false end
        ret sigaddset(set, sig) == 0
    end
end

@en "DelSignal"
@fa "حذف سیگنال"
pub func DelSignal(set: void*, sig: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null or sig <= 0: ret false end
        ret sigdelset(set, sig) == 0
    end
end

@en "IsSignal"
@fa "عضو مجموعه است"
pub func IsSignal(set: void*, sig: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null or sig <= 0: ret false end
        ret sigismember(set, sig) == 1
    end
end

@en "Block"
@fa "مسدود کردن"
pub func Block(set: void*): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null: ret false end
        ret pthread_sigmask(_SIG_BLOCK, set, null) == 0
    end
end

@en "Unblock"
@fa "رفع انسداد"
pub func Unblock(set: void*): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null: ret false end
        ret pthread_sigmask(_SIG_UNBLOCK, set, null) == 0
    end
end

@en "SetMask"
@fa "تنظیم ماسک"
pub func SetMask(set: void*): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null: ret false end
        ret pthread_sigmask(_SIG_SETMASK, set, null) == 0
    end
end

@en "CurrentMask"
@fa "ماسک فعلی"
pub func CurrentMask(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        set := NewSet()
        if set == null: ret null end
        if pthread_sigmask(_SIG_BLOCK, null, set) != 0:
            mem.Free(set)
            ret null
        end
        ret set
    end
end

@en "WaitSignal"
@fa "انتظار سیگنال"
pub func WaitSignal(set: void*): int:
    if SALAM_OS_WINDOWS:
        ret WaitInvalid
    else:
        if set == null: ret WaitInvalid end
        out := mem.AllocateZeroed(8 as u64)
        if out == null: ret WaitFailed end
        status := Wait(set, out)
        sig := (out as i32*)[0]
        mem.Free(out)
        if status != WaitArrived: ret status end
        ret sig
    end
end

@en "Raise"
@fa "فرستادن به خود"
pub func Raise(sig: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if sig <= 0: ret false end
        ret kill(getpid(), sig) == 0
    end
end
