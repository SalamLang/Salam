@en "signal"
@fa "سیگنال"
package signal

if not SALAM_OS_WINDOWS:
    import mem
    import sync
end

if not SALAM_OS_WINDOWS:
    extern:
        func sigaction(sig: int, act: void*, old: void*): int
        func pthread_sigmask(how: int, set: void*, old: void*): int
        func sigemptyset(set: void*): int
        func sigfillset(set: void*): int
        func sigaddset(set: void*, sig: int): int
        func sigdelset(set: void*, sig: int): int
        func sigismember(set: void*, sig: int): int
        func sigwait(set: void*, sig: void*): int
        func kill(pid: int, sig: int): int
        func getpid(): int
        func close(fd: int): int
    end
end

if SALAM_OS_MAC:
    extern:
        func kqueue(): int
        func kevent(kq: int, changelist: void*, nchanges: int, eventlist: void*, nevents: int, timeout: void*): int
        func sigpending(set: void*): int
    end
else SALAM_OS_LINUX:
    extern:
        func sigtimedwait(set: void*, info: void*, timeout: void*): int
        func __errno_location(): void*
    end
end

