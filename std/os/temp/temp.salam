@en "temp"
@fa "موقت"
@ar "مؤقت"
package temp

import os
import fs
import fs.path
import io
import crypto
import os.error

@en "File"
@fa "پرونده موقت"
@ar "ملف مؤقت"
pub func File(): str:
    name := "salam-".concat(crypto.RandomHex(8)).concat(".tmp")
    p := path.Join(os.TempDir(), name)
    io.WriteFile(p, "")
    fs.Chmod(p, 384)
    ret p
end

@en "Directory"
@fa "پوشه موقت"
@ar "مجلد مؤقت"
pub func Directory(): str:
    name := "salam-".concat(crypto.RandomHex(8))
    p := path.Join(os.TempDir(), name)
    if os.Mkdir(p) != 0:
        error.Set(error.IOError, "failed to create temp dir", "Directory", p, 0)
        ret ""
    end
    fs.Chmod(p, 448)
    ret p
end

@en "Remove"
@fa "حذف"
@ar "إزالة"
pub func Remove(p: str): int:
    if os.Remove(p) != 0:
        error.Set(error.IOError, "failed to remove temp file", "Remove", p, 0)
        ret 0 - 1
    end
    ret 0
end

@en "RemoveDir"
@fa "حذف پوشه"
@ar "إزالة مجلد"
pub func RemoveDir(p: str): int:
    if os.RemoveAll(p) != 0:
        error.Set(error.IOError, "failed to remove temp dir", "RemoveDir", p, 0)
        ret 0 - 1
    end
    ret 0
end
