@en "updater"
@fa "به‌روزرسان"
package updater

import mem
import str
import conv

// App update/version helpers (best-effort).
// This module does NOT perform network requests or automatic updates.
// Callers must explicitly fetch update metadata (e.g. via net/http) and invoke
// comparison/apply workflows in their own controlled manner.

@en "Version"
@fa "نسخه"
pub struct Version:
    @en "major"
    @fa "اصلی"
    pub major: int = 0
    @en "minor"
    @fa "فرعی"
    pub minor: int = 0
    @en "patch"
    @fa "وصله"
    pub patch: int = 0
    @en "prerelease"
    @fa "پیش‌انتشار"
    pub prerelease: str = ""
    @en "valid"
    @fa "معتبر"
    pub valid: bool = false

    @en "Free"
    @fa "آزادسازی"
    pub mut func Free(): if this.prerelease.Len() > 0: mem.Free(this.prerelease as void*)
end
this.prerelease = ""
end
end

@en "UpdateInfo"
@fa "اطلاعات به‌روزرسانی"
pub struct UpdateInfo:
    @en "current"
    @fa "کنونی"
    pub current: str = ""
    @en "latest"
    @fa "جدیدترین"
    pub latest: str = ""
    @en "available"
    @fa "موجود"
    pub available: bool = false
    @en "mandatory"
    @fa "اجباری"
    pub mandatory: bool = false
    @en "url"
    @fa "نشانی"
    pub url: str = ""
    @en "notes"
    @fa "یادداشت‌ها"
    pub notes: str = ""

    @en "Free"
    @fa "آزادسازی"
    pub mut func Free(): if this.current.Len() > 0: mem.Free(this.current as void*)
end
if this.latest.Len() > 0: mem.Free(this.latest as void*) end
if this.url.Len() > 0: mem.Free(this.url as void*) end
if this.notes.Len() > 0: mem.Free(this.notes as void*) end
this.current = ""
this.latest = ""
this.url = ""
this.notes = ""
end
end

func _cmp_prerelease(a: str, b: str): int:
    // SemVer-ish: release (empty prerelease) > prerelease; otherwise lexical compare.
    if a.Len() == 0 and b.Len() == 0: ret 0 end
    if a.Len() == 0 and b.Len() > 0: ret 1 end
    if a.Len() > 0 and b.Len() == 0: ret -1 end
    if a == b: ret 0 end
    if a < b: ret -1 end
    ret 1
end

@en "ParseVersion"
@fa "تجزیه نسخه"
pub func ParseVersion(s: str): Version:
    mut v := Version {}
    t := str.Trim(s)
    if t.Len() == 0:
        mem.Free(t as void*)
        ret v
    end
    // strip leading 'v'/'V'
    mut core := str.Clone("")
    if t.StartsWith("v") or t.StartsWith("V"):
        mem.Free(core as void*)
        core = t.Substr(1, t.Len() - 1)
    else:
        mem.Free(core as void*)
        core = str.Clone(t)
    end
    // split prerelease/build metadata (ignore build)
    mut pre := str.Clone("")
    pi := str.IndexOf(core, "-")
    bi := str.IndexOf(core, "+")
    mut cut := -1
    if pi >= 0: cut = pi end
    if bi >= 0 and (cut < 0 or bi < cut): cut = bi end
    if pi >= 0 and (bi < 0 or pi < bi):
        pre_end := core.Len() - (pi + 1)
        mem.Free(pre as void*)
        pre = core.Substr(pi + 1, pre_end)
        p2 := str.IndexOf(pre, "+")
        if p2 >= 0:
            tmp := pre.Substr(0, p2)
            mem.Free(pre as void*)
            pre = tmp
        end
    end
    mut base := str.Clone("")
    if cut >= 0:
        mem.Free(base as void*)
        base = core.Substr(0, cut)
    else:
        mem.Free(base as void*)
        base = str.Clone(core)
    end
    parts := base.Split(".")
    if parts.Len() >= 1: v.major = conv.ParseIntOr(parts.Get(0), 0) end
    if parts.Len() >= 2: v.minor = conv.ParseIntOr(parts.Get(1), 0) end
    if parts.Len() >= 3: v.patch = conv.ParseIntOr(parts.Get(2), 0) end
    v.prerelease = pre
    v.valid = parts.Len() >= 1
    parts.Free()
    mem.Free(base as void*)
    mem.Free(core as void*)
    mem.Free(t as void*)
    ret v
end

@en "Compare"
@fa "مقایسه"
pub func Compare(a: str, b: str): int:
    mut va := ParseVersion(a)
    mut vb := ParseVersion(b)
    mut r := 0
    if va.major < vb.major: r = -1
    else va.major > vb.major: r = 1
    else va.minor < vb.minor: r = -1
    else va.minor > vb.minor: r = 1
    else va.patch < vb.patch: r = -1
    else va.patch > vb.patch: r = 1
    else:
        r = _cmp_prerelease(va.prerelease, vb.prerelease)
    end
    va.Free()
    vb.Free()
    ret r
end

@en "IsNewer"
@fa "جدیدتر است"
pub func IsNewer(latest: str, current: str): bool:
    ret Compare(latest, current) > 0
end

@en "CheckFromStrings"
@fa "بررسی از رشته‌ها"
pub func CheckFromStrings(current: str, latest: str, url: str = "", notes: str = "", mandatory: bool = false): UpdateInfo:
    ret UpdateInfo {
        current = str.Clone(current), latest = str.Clone(latest), available = IsNewer(latest, current),
        mandatory = mandatory, url = str.Clone(url), notes = str.Clone(notes)
    }
end

@en "Note"
@fa "یادداشت"
pub func Note(): str:
    ret str.Clone("No automatic network checks or downloads are performed. Fetch update metadata explicitly, compare versions, and apply updates with user/app-controlled flows.")
end
