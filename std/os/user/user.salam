@en "user"
@fa "کاربر"
@ar "المستخدم"
package user

import os
import fs.path

if SALAM_OS_WINDOWS == false:
    extern:
        func getuid(): int
        func getgid(): int
    end
end

@en "Username"
@fa "نام کاربری"
@ar "اسم المستخدم"
pub func Username(): str:
    if SALAM_OS_WINDOWS:
        ret os.Env("USERNAME")
    else:
        u := os.Env("USER")
        if u.len() > 0: ret u end
        ret os.Env("LOGNAME")
    end
end

if SALAM_OS_WINDOWS:
    @en "Uid"
    @fa "شناسه کاربر"
    @ar "معرف المستخدم"
    pub func Uid(): int: ret 0 - 1 end

    @en "Gid"
    @fa "شناسه گروه"
    @ar "معرف المجموعة"
    pub func Gid(): int: ret 0 - 1 end
else:
    @en "Uid"
    @fa "شناسه کاربر"
    @ar "معرف المستخدم"
    pub func Uid(): int: ret getuid() end

    @en "Gid"
    @fa "شناسه گروه"
    @ar "معرف المجموعة"
    pub func Gid(): int: ret getgid() end
end

@en "HomeDir"
@fa "پوشه خانگی"
@ar "المجلد الرئیسی"
pub func HomeDir(): str:
    if SALAM_OS_WINDOWS: ret os.Env("USERPROFILE")
    else: ret os.Env("HOME")
    end
end

@en "ConfigDir"
@fa "پوشه پیکربندی"
@ar "مجلد الإعدادات"
pub func ConfigDir(): str:
    if SALAM_OS_WINDOWS:
        ret os.Env("APPDATA")
    else:
        x := os.Env("XDG_CONFIG_HOME")
        if x.len() > 0: ret x end
        ret path.Join(HomeDir(), ".config")
    end
end

@en "CacheDir"
@fa "پوشه حافظه پنهان"
@ar "مجلد التخزین المؤقت"
pub func CacheDir(): str:
    if SALAM_OS_WINDOWS:
        ret os.Env("LOCALAPPDATA")
    else:
        x := os.Env("XDG_CACHE_HOME")
        if x.len() > 0: ret x end
        ret path.Join(HomeDir(), ".cache")
    end
end
