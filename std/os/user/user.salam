@en "user"
@fa "کاربر"
@ar "المستخدم"
package user

import os
import fs.path

if SALAM_OS_WINDOWS == false:
    extern:
        func getuid(): int
        func getgid(): int
        func getpwuid(uid: int): void*
    end

    // The account name from the password database.
    //
    // $USER and $LOGNAME are conveniences the login shell sets, not
    // guarantees: a process started by a container entrypoint, cron, a
    // systemd unit or most CI runners has neither, and Username() used to
    // return "" there. This is the authoritative answer, so it is the last
    // resort rather than the first - the environment still wins, which is
    // what lets `USER=deploy ./app` be honoured.
    func _pw_name(): str:
        pw := getpwuid(getuid())
        if pw == null: ret "" end
        // pw_name is the first member of struct passwd in every libc that
        // ships one (glibc, musl, the BSDs, macOS), so reading the leading
        // pointer avoids depending on the rest of the layout, which does
        // differ between them.
        //
        // Read twice through single-pointer views rather than once through
        // a `void**`: Salam lexes `**` as the power operator, so a
        // pointer-to-pointer type cannot currently be spelled at all.
        words := pw as i64*
        if words[0] == 0: ret "" end
        slots := pw as str*
        ret slots[0]
    end
end

@en "Username"
@fa "نام کاربری"
@ar "اسم المستخدم"
pub func Username(): str:
    if SALAM_OS_WINDOWS:
        ret os.Env("USERNAME")
    else:
        u := os.Env("USER")
        if u.len() > 0: ret u end
        l := os.Env("LOGNAME")
        if l.len() > 0: ret l end
        ret _pw_name()
    end
end

if SALAM_OS_WINDOWS:
    @en "Uid"
    @fa "شناسه کاربر"
    @ar "معرف المستخدم"
    pub func Uid(): int: ret 0 - 1 end

    @en "Gid"
    @fa "شناسه گروه"
    @ar "معرف المجموعة"
    pub func Gid(): int: ret 0 - 1 end
else:
    @en "Uid"
    @fa "شناسه کاربر"
    @ar "معرف المستخدم"
    pub func Uid(): int: ret getuid() end

    @en "Gid"
    @fa "شناسه گروه"
    @ar "معرف المجموعة"
    pub func Gid(): int: ret getgid() end
end

@en "HomeDir"
@fa "پوشه خانگی"
@ar "المجلد الرئیسی"
pub func HomeDir(): str:
    if SALAM_OS_WINDOWS: ret os.Env("USERPROFILE")
    else: ret os.Env("HOME")
    end
end

@en "ConfigDir"
@fa "پوشه پیکربندی"
@ar "مجلد الإعدادات"
pub func ConfigDir(): str:
    if SALAM_OS_WINDOWS:
        ret os.Env("APPDATA")
    else:
        x := os.Env("XDG_CONFIG_HOME")
        if x.len() > 0: ret x end
        ret path.Join(HomeDir(), ".config")
    end
end

@en "CacheDir"
@fa "پوشه حافظه پنهان"
@ar "مجلد التخزین المؤقت"
pub func CacheDir(): str:
    if SALAM_OS_WINDOWS:
        ret os.Env("LOCALAPPDATA")
    else:
        x := os.Env("XDG_CACHE_HOME")
        if x.len() > 0: ret x end
        ret path.Join(HomeDir(), ".cache")
    end
end
