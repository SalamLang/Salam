@en "winreg"
@fa "رجیستری ویندوز"
package winreg

import mem
import str

// Predefined roots
pub const HKCR: i64 = 0x80000000
pub const HKCU: i64 = 0x80000001
pub const HKLM: i64 = 0x80000002
pub const HKU: i64 = 0x80000003
pub const HKCC: i64 = 0x80000005

// Value types
pub const REG_NONE: u32 = 0 as u32
pub const REG_SZ: u32 = 1 as u32
pub const REG_EXPAND_SZ: u32 = 2 as u32
pub const REG_BINARY: u32 = 3 as u32
pub const REG_DWORD: u32 = 4 as u32
pub const REG_QWORD: u32 = 11 as u32

// Access rights
pub const KEY_READ: u32 = 0x20019 as u32
pub const KEY_WRITE: u32 = 0x20006 as u32
pub const KEY_ALL_ACCESS: u32 = 0xF003F as u32
pub const KEY_QUERY_VALUE: u32 = 0x0001 as u32
pub const KEY_SET_VALUE: u32 = 0x0002 as u32
pub const KEY_CREATE_SUB_KEY: u32 = 0x0004 as u32
pub const KEY_ENUMERATE_SUB_KEYS: u32 = 0x0008 as u32

// Options/dispositions
pub const REG_OPTION_NON_VOLATILE: u32 = 0 as u32

@en "Key"
@fa "کلید"
pub struct Key:
    @en "handle"
    @fa "دسته"
    pub handle: void* = null
    @en "ok"
    @fa "معتبر"
    pub ok: bool = false
end

@en "StringResult"
@fa "نتیجه رشته"
pub struct StringResult:
    @en "value"
    @fa "مقدار"
    pub value: str = ""
    @en "ok"
    @fa "معتبر"
    pub ok: bool = false
    @en "type"
    @fa "نوع"
    pub kind: u32 = 0 as u32
end

@en "IntResult"
@fa "نتیجه عددی"
pub struct IntResult:
    @en "value"
    @fa "مقدار"
    pub value: i64 = 0
    @en "ok"
    @fa "معتبر"
    pub ok: bool = false
    @en "type"
    @fa "نوع"
    pub kind: u32 = 0 as u32
end

@en "BinaryResult"
@fa "نتیجه دودویی"
pub struct BinaryResult:
    @en "data"
    @fa "داده"
    pub data: void* = null
    @en "size"
    @fa "اندازه"
    pub size: u32 = 0 as u32
    @en "ok"
    @fa "معتبر"
    pub ok: bool = false
end

if SALAM_OS_WINDOWS:
    link dynamic "advapi32"
    link dynamic "kernel32"

    extern:
        func RegOpenKeyExW(hKey: void*, lpSubKey: void*, ulOptions: u32, samDesired: u32, phkResult: void*): i32
        func RegCreateKeyExW(hKey: void*, lpSubKey: void*, Reserved: u32, lpClass: void*, dwOptions: u32, samDesired: u32, lpSecurityAttributes: void*, phkResult: void*, lpdwDisposition: void*): i32
        func RegCloseKey(hKey: void*): i32
        func RegQueryValueExW(hKey: void*, lpValueName: void*, lpReserved: void*, lpType: void*, lpData: void*, lpcbData: void*): i32
        func RegSetValueExW(hKey: void*, lpValueName: void*, Reserved: u32, dwType: u32, lpData: void*, cbData: u32): i32
        func RegDeleteValueW(hKey: void*, lpValueName: void*): i32
        func RegDeleteKeyW(hKey: void*, lpSubKey: void*): i32
        func RegDeleteTreeW(hKey: void*, lpSubKey: void*): i32
        func RegEnumKeyExW(hKey: void*, dwIndex: u32, lpName: void*, lpcchName: void*, lpReserved: void*, lpClass: void*, lpcchClass: void*, lpftLastWriteTime: void*): i32
        func RegEnumValueW(hKey: void*, dwIndex: u32, lpValueName: void*, lpcchValueName: void*, lpReserved: void*, lpType: void*, lpData: void*, lpcbData: void*): i32
        func MultiByteToWideChar(CodePage: u32, dwFlags: u32, lpMultiByteStr: str, cbMultiByte: i32, lpWideCharStr: void*, cchWideChar: i32): i32
        func WideCharToMultiByte(CodePage: u32, dwFlags: u32, lpWideCharStr: void*, cchWideChar: i32, lpMultiByteStr: void*, cbMultiByte: i32, lpDefaultChar: void*, lpUsedDefaultChar: void*): i32
    end

    func _to_wide(s: str): void*:
        if s == null:
            buf := mem.AllocateZeroed(2 as u64)
            ret buf
        end
        n := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
        if n <= 0:
            ret mem.AllocateZeroed(2 as u64)
        end
        w := mem.AllocateZeroed((n * 2) as u64)
        MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, w, n)
        ret w
    end

    func _from_wide(w: void*): str:
        if w == null: ret str.Clone("") end
        n := WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, null, 0, null, null)
        if n <= 0: ret str.Clone("") end
        buf := mem.Allocate(n as u64)
        WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, buf, n, null, null)
        ret buf as str
    end

    func _from_wide_len(w: void*, units: i32): str:
        if w == null or units <= 0: ret str.Clone("") end
        n := WideCharToMultiByte(65001 as u32, 0 as u32, w, units, null, 0, null, null)
        if n <= 0: ret str.Clone("") end
        buf := mem.AllocateZeroed((n + 1) as u64)
        WideCharToMultiByte(65001 as u32, 0 as u32, w, units, buf, n, null, null)
        ret buf as str
    end

    func _hkey(root: i64): void*:
        ret (root as size) as void*
    end
end

@en "Root"
@fa "ریشه"
pub func Root(name: str): i64:
    if name == "HKCU" or name == "HKEY_CURRENT_USER": ret HKCU
    else name == "HKLM" or name == "HKEY_LOCAL_MACHINE": ret HKLM
    else name == "HKCR" or name == "HKEY_CLASSES_ROOT": ret HKCR
    else name == "HKU" or name == "HKEY_USERS": ret HKU
    else name == "HKCC" or name == "HKEY_CURRENT_CONFIG": ret HKCC
    end
    ret 0
end

@en "RootName"
@fa "نام ریشه"
pub func RootName(root: i64): str:
    if root == HKCU: ret "HKCU"
    else root == HKLM: ret "HKLM"
    else root == HKCR: ret "HKCR"
    else root == HKU: ret "HKU"
    else root == HKCC: ret "HKCC"
    end
    ret ""
end

@en "JoinPath"
@fa "پیوند مسیر"
pub func JoinPath(parent: str, child: str): str:
    if parent.Len() == 0: ret str.Clone(child) end
    if child.Len() == 0: ret str.Clone(parent) end
    if str.EndsWith(parent, "\\"): ret parent.Concat(child) end
    ret parent.Concat("\\").Concat(child)
end

@en "IsSupported"
@fa "پشتیبانی می شود"
pub func IsSupported(): bool:
    if SALAM_OS_WINDOWS: ret true end
    ret false
end

@en "Close"
@fa "بستن"
pub func Close(k &: Key):
    if SALAM_OS_WINDOWS:
        if k.ok and k.handle != null:
            _r := RegCloseKey(k.handle)
            k.handle = null
            k.ok = false
        end
    else:
        k.handle = null
        k.ok = false
    end
end

@en "OpenKey"
@fa "باز کردن کلید"
pub func OpenKey(root: i64, path: str, access: u32): Key:
    if SALAM_OS_WINDOWS:
        wpath := _to_wide(path)
        out := mem.AllocateZeroed(sizeof(void*) as u64) as void**
        status := RegOpenKeyExW(_hkey(root), wpath, 0 as u32, access, out as void*)
        h := out[0]
        mem.Free(wpath)
        mem.Free(out as void*)
        if status == 0:
            ret Key { handle = h, ok = true }
        end
        ret Key {}
    else:
        ret Key {}
    end
end

@en "CreateKey"
@fa "ساخت کلید"
pub func CreateKey(root: i64, path: str, access: u32): Key:
    if SALAM_OS_WINDOWS:
        wpath := _to_wide(path)
        out := mem.AllocateZeroed(sizeof(void*) as u64) as void**
        disp := mem.AllocateZeroed(4 as u64)
        status := RegCreateKeyExW(
            _hkey(root), wpath, 0 as u32, null, REG_OPTION_NON_VOLATILE, access, null, out as void*,
            disp
        )
        h := out[0]
        mem.Free(wpath)
        mem.Free(out as void*)
        mem.Free(disp)
        if status == 0:
            ret Key { handle = h, ok = true }
        end
        ret Key {}
    else:
        ret Key {}
    end
end

@en "DeleteKey"
@fa "حذف کلید"
pub func DeleteKey(root: i64, path: str): bool:
    if SALAM_OS_WINDOWS:
        wpath := _to_wide(path)
        status := RegDeleteKeyW(_hkey(root), wpath)
        mem.Free(wpath)
        ret status == 0
    end
    ret false
end

@en "DeleteTree"
@fa "حذف درخت"
pub func DeleteTree(root: i64, path: str): bool:
    if SALAM_OS_WINDOWS:
        wpath := _to_wide(path)
        status := RegDeleteTreeW(_hkey(root), wpath)
        mem.Free(wpath)
        ret status == 0
    end
    ret false
end

@en "DeleteValue"
@fa "حذف مقدار"
pub func DeleteValue(k &: Key, name: str): bool:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret false end
        wname := _to_wide(name)
        status := RegDeleteValueW(k.handle, wname)
        mem.Free(wname)
        ret status == 0
    end
    ret false
end

@en "GetString"
@fa "دریافت رشته"
pub func GetString(k &: Key, name: str): StringResult:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret StringResult {} end
        wname := _to_wide(name)
        typ := mem.AllocateZeroed(4 as u64) as u32*
        size := mem.AllocateZeroed(4 as u64) as u32*
        status := RegQueryValueExW(k.handle, wname, null, typ as void*, null, size as void*)
        if status != 0:
            mem.Free(wname)
            mem.Free(typ as void*)
            mem.Free(size as void*)
            ret StringResult {}
        end
        mut cb := size[0]
        if cb < (2 as u32): cb = 2 as u32 end
        data := mem.AllocateZeroed((cb + 2) as u64)
        status = RegQueryValueExW(k.handle, wname, null, typ as void*, data, size as void*)
        mut out := StringResult {}
        if status == 0:
            t := typ[0]
            out.kind = t
            if t == REG_SZ or t == REG_EXPAND_SZ:
                out.value = _from_wide(data)
                out.ok = true
            else t == REG_DWORD and size[0] >= (4 as u32):
                v := (data as u32*)[0]
                out.value = str.FromInt(v as i64)
                out.ok = true
            else t == REG_QWORD and size[0] >= (8 as u64 as u32):
                v := (data as i64*)[0]
                out.value = str.FromInt(v)
                out.ok = true
            end
        end
        mem.Free(wname)
        mem.Free(typ as void*)
        mem.Free(size as void*)
        mem.Free(data)
        ret out
    end
    ret StringResult {}
end

@en "GetExpandString"
@fa "دریافت رشته قابل گسترش"
pub func GetExpandString(k &: Key, name: str): StringResult:
    r := GetString(k, name)
    if r.ok and r.kind == REG_EXPAND_SZ:
        ret r
    end
    ret StringResult {}
end

@en "GetInt"
@fa "دریافت عدد"
pub func GetInt(k &: Key, name: str): IntResult:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret IntResult {} end
        wname := _to_wide(name)
        typ := mem.AllocateZeroed(4 as u64) as u32*
        size := mem.AllocateZeroed(4 as u64) as u32*
        status := RegQueryValueExW(k.handle, wname, null, typ as void*, null, size as void*)
        if status != 0:
            mem.Free(wname)
            mem.Free(typ as void*)
            mem.Free(size as void*)
            ret IntResult {}
        end
        mut cb := size[0]
        if cb < (8 as u32): cb = 8 as u32 end
        data := mem.AllocateZeroed((cb + 8) as u64)
        status = RegQueryValueExW(k.handle, wname, null, typ as void*, data, size as void*)
        mut out := IntResult {}
        if status == 0:
            t := typ[0]
            out.kind = t
            if t == REG_DWORD and size[0] >= (4 as u32):
                out.value = (data as u32*)[0] as i64
                out.ok = true
            else t == REG_QWORD and size[0] >= (8 as u32):
                out.value = (data as i64*)[0]
                out.ok = true
            end
        end
        mem.Free(wname)
        mem.Free(typ as void*)
        mem.Free(size as void*)
        mem.Free(data)
        ret out
    end
    ret IntResult {}
end

@en "GetBinary"
@fa "دریافت دودویی"
pub func GetBinary(k &: Key, name: str): BinaryResult:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret BinaryResult {} end
        wname := _to_wide(name)
        typ := mem.AllocateZeroed(4 as u64) as u32*
        size := mem.AllocateZeroed(4 as u64) as u32*
        status := RegQueryValueExW(k.handle, wname, null, typ as void*, null, size as void*)
        if status != 0:
            mem.Free(wname)
            mem.Free(typ as void*)
            mem.Free(size as void*)
            ret BinaryResult {}
        end
        cb := size[0]
        data := mem.AllocateZeroed((cb + 1) as u64)
        status = RegQueryValueExW(k.handle, wname, null, typ as void*, data, size as void*)
        mut out := BinaryResult {}
        if status == 0 and typ[0] == REG_BINARY:
            out.data = data
            out.size = size[0]
            out.ok = true
            mem.Free(wname)
            mem.Free(typ as void*)
            mem.Free(size as void*)
            ret out
        end
        mem.Free(data)
        mem.Free(wname)
        mem.Free(typ as void*)
        mem.Free(size as void*)
        ret BinaryResult {}
    end
    ret BinaryResult {}
end

@en "SetString"
@fa "تنظیم رشته"
pub func SetString(k &: Key, name: str, value: str): bool:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret false end
        wname := _to_wide(name)
        wval := _to_wide(value)
        mut chars := 0
        until (wval as u16*)[chars] != (0 as u16):
            chars++
        end
        bytes := ((chars + 1) * 2) as u32
        status := RegSetValueExW(k.handle, wname, 0 as u32, REG_SZ, wval, bytes)
        mem.Free(wname)
        mem.Free(wval)
        ret status == 0
    end
    ret false
end

@en "SetExpandString"
@fa "تنظیم رشته قابل گسترش"
pub func SetExpandString(k &: Key, name: str, value: str): bool:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret false end
        wname := _to_wide(name)
        wval := _to_wide(value)
        mut chars := 0
        until (wval as u16*)[chars] != (0 as u16):
            chars++
        end
        bytes := ((chars + 1) * 2) as u32
        status := RegSetValueExW(k.handle, wname, 0 as u32, REG_EXPAND_SZ, wval, bytes)
        mem.Free(wname)
        mem.Free(wval)
        ret status == 0
    end
    ret false
end

@en "SetDword"
@fa "تنظیم عدد ۳۲ بیتی"
pub func SetDword(k &: Key, name: str, value: u32): bool:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret false end
        wname := _to_wide(name)
        buf := mem.AllocateZeroed(4 as u64) as u32*
        buf[0] = value
        status := RegSetValueExW(k.handle, wname, 0 as u32, REG_DWORD, buf as void*, 4 as u32)
        mem.Free(wname)
        mem.Free(buf as void*)
        ret status == 0
    end
    ret false
end

@en "SetQword"
@fa "تنظیم عدد ۶۴ بیتی"
pub func SetQword(k &: Key, name: str, value: i64): bool:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret false end
        wname := _to_wide(name)
        buf := mem.AllocateZeroed(8 as u64) as i64*
        buf[0] = value
        status := RegSetValueExW(k.handle, wname, 0 as u32, REG_QWORD, buf as void*, 8 as u32)
        mem.Free(wname)
        mem.Free(buf as void*)
        ret status == 0
    end
    ret false
end

@en "SetBinary"
@fa "تنظیم دودویی"
pub func SetBinary(k &: Key, name: str, data: void*, size: u32): bool:
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret false end
        wname := _to_wide(name)
        status := RegSetValueExW(k.handle, wname, 0 as u32, REG_BINARY, data, size)
        mem.Free(wname)
        ret status == 0
    end
    ret false
end

@en "ListSubKeys"
@fa "فهرست زیرکلیدها"
pub func ListSubKeys(k &: Key): Vector<str>:
    out := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret out end
        mut idx := 0 as u32
        until 1 == 1:
            name_buf := mem.AllocateZeroed(512 * 2 as u64)
            len_buf := mem.AllocateZeroed(4 as u64) as u32*
            len_buf[0] = 256 as u32
            status := RegEnumKeyExW(k.handle, idx, name_buf, len_buf as void*, null, null, null, null)
            if status == 0:
                out.Push(_from_wide_len(name_buf, len_buf[0] as i32))
                mem.Free(name_buf)
                mem.Free(len_buf as void*)
                idx = idx + (1 as u32)
            else:
                mem.Free(name_buf)
                mem.Free(len_buf as void*)
                break
            end
        end
    end
    ret out
end

@en "ListValues"
@fa "فهرست مقدارها"
pub func ListValues(k &: Key): Vector<str>:
    out := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        if not k.ok or k.handle == null: ret out end
        mut idx := 0 as u32
        until 1 == 1:
            name_buf := mem.AllocateZeroed(32767 * 2 as u64)
            len_buf := mem.AllocateZeroed(4 as u64) as u32*
            len_buf[0] = 16383 as u32
            status := RegEnumValueW(k.handle, idx, name_buf, len_buf as void*, null, null, null, null)
            if status == 0:
                out.Push(_from_wide_len(name_buf, len_buf[0] as i32))
                mem.Free(name_buf)
                mem.Free(len_buf as void*)
                idx = idx + (1 as u32)
            else:
                mem.Free(name_buf)
                mem.Free(len_buf as void*)
                break
            end
        end
    end
    ret out
end

@en "KeyExists"
@fa "کلید وجود دارد"
pub func KeyExists(root: i64, path: str): bool:
    if SALAM_OS_WINDOWS == false: ret false end
    k := OpenKey(root, path, KEY_READ)
    if k.ok:
        Close(k)
        ret true
    end
    ret false
end

@en "ValueExists"
@fa "مقدار وجود دارد"
pub func ValueExists(k &: Key, name: str): bool:
    if SALAM_OS_WINDOWS == false: ret false end
    if not k.ok or k.handle == null: ret false end
    wname := _to_wide(name)
    status := RegQueryValueExW(k.handle, wname, null, null, null, null)
    mem.Free(wname)
    ret status == 0
end

@en "FreeBinary"
@fa "آزادسازی دودویی"
pub func FreeBinary(r &: BinaryResult):
    if r.data != null:
        mem.Free(r.data)
        r.data = null
    end
    r.size = 0 as u32
    r.ok = false
end

@en "OpenHKCU"
@fa "باز کردن HKCU"
pub func OpenHKCU(path: str, access: u32): Key:
    ret OpenKey(HKCU, path, access)
end

@en "OpenHKLM"
@fa "باز کردن HKLM"
pub func OpenHKLM(path: str, access: u32): Key:
    ret OpenKey(HKLM, path, access)
end

@en "CreateHKCU"
@fa "ساخت در HKCU"
pub func CreateHKCU(path: str, access: u32): Key:
    ret CreateKey(HKCU, path, access)
end

@en "CreateHKLM"
@fa "ساخت در HKLM"
pub func CreateHKLM(path: str, access: u32): Key:
    ret CreateKey(HKLM, path, access)
end

@en "GetStringPath"
@fa "دریافت رشته از مسیر"
pub func GetStringPath(root: i64, path: str, name: str): StringResult:
    k := OpenKey(root, path, KEY_READ)
    if not k.ok: ret StringResult {} end
    out := GetString(k, name)
    Close(k)
    ret out
end

@en "SetStringPath"
@fa "تنظیم رشته در مسیر"
pub func SetStringPath(root: i64, path: str, name: str, value: str): bool:
    k := CreateKey(root, path, KEY_WRITE)
    if not k.ok: ret false end
    ok := SetString(k, name, value)
    Close(k)
    ret ok
end

@en "SetDwordPath"
@fa "تنظیم عدد ۳۲ بیتی در مسیر"
pub func SetDwordPath(root: i64, path: str, name: str, value: u32): bool:
    k := CreateKey(root, path, KEY_WRITE)
    if not k.ok: ret false end
    ok := SetDword(k, name, value)
    Close(k)
    ret ok
end

@en "DeleteValuePath"
@fa "حذف مقدار از مسیر"
pub func DeleteValuePath(root: i64, path: str, name: str): bool:
    k := OpenKey(root, path, KEY_WRITE)
    if not k.ok: ret false end
    ok := DeleteValue(k, name)
    Close(k)
    ret ok
end

@en "DeleteKeyPath"
@fa "حذف کلید مسیر"
pub func DeleteKeyPath(root: i64, path: str): bool:
    ret DeleteKey(root, path)
end
