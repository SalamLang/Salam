@en "pool"
@fa "استخر"
package pool

import mem
import sync
import thread

if SALAM_OS_WINDOWS:
    extern:
        func GetSystemInfo(info: void*)
    end
else:
    extern:
        func sysconf(name: int): size
    end
end

const C_COUNT := 0
const C_RUN := 1
const C_STOP := 2
const C_CAP := 3
const C_HEAD := 4
const C_TAIL := 5
const C_LIVE := 6
const C_IDLE := 7
const C_MAX := 8
const C_CELLS := 9

mut g_ready := mem.AllocateZeroed(8 as u64) as i64*
mut g_pool := mem.AllocateZeroed(16 as u64) as Pool*

struct Node:
    pub task: func () = (): end
    pub next: i64 = 0
end

struct State:
    pub mu: sync.Mutex = sync.Mutex {}
    pub nonempty: sync.CondVar = sync.CondVar {}
    pub nonfull: sync.CondVar = sync.CondVar {}
    pub idle: sync.CondVar = sync.CondVar {}
    pub c: i64* = null
    pub handles: i64* = null
    pub workers: i64 = 0
end

struct GroupState:
    pub p: Pool = Pool {}
    pub mu: sync.Mutex = sync.Mutex {}
    pub err: str = ""
    pub failed: i64* = null
end

struct Range:
    pub body: func (i64) = (_i: i64): end
    pub next: i64* = null
    pub n: i64 = 0
    pub mu: sync.Mutex = sync.Mutex {}
end

@en "Group"
@fa "گروه کار"
pub struct Group:
    @en "state"
    @fa "وضعیت"
    pub state: void* = null
end

@en "Future"
@fa "آینده"
pub struct Future:
    @en "value"
    @fa "مقدار"
    pub value: i64* = null
    @en "text"
    @fa "متن"
    pub text: str* = null
    @en "done"
    @fa "انجام شد"
    pub done: i64* = null
    @en "mu"
    @fa "قفل"
    pub mu: sync.Mutex = sync.Mutex {}
    @en "cv"
    @fa "شرط"
    pub cv: sync.CondVar = sync.CondVar {}
end

@en "Pool"
@fa "استخر نخ"
pub struct Pool:
    @en "state"
    @fa "وضعیت"
    pub state: void* = null
end

func range_worker(rp: Range*):
    r := rp[0]
    c := r.next
    until true:
        sync.Lock(r.mu)
        i := c[0]
        c[0] = i + 1
        sync.Unlock(r.mu)
        if i >= r.n:
            break
        end
        r.body(i)
    end
end

if SALAM_OS_WINDOWS:
    func cpu_count_os(): i64:
        buf := mem.AllocateZeroed(96 as u64)
        GetSystemInfo(buf)
        p := ((buf as i64) + 8 + 3 * (sizeof(usize) as i64)) as i32*
        n := p[0] as i64
        mem.Free(buf)
        ret n
    end
else:
    if defined(SALAM_OS_BSD):
        func cpu_count_os(): i64: ret sysconf(58) end
    else:
        func cpu_count_os(): i64: ret sysconf(84) end
    end
end

func pool_worker(sp: State*):
    s := sp[0]
    c := s.c
    until true:
        sync.Lock(s.mu)
        c[C_IDLE] = c[C_IDLE] + 1
        until c[C_COUNT] == 0 and c[C_STOP] == 0:
            sync.WaitCond(s.nonempty, s.mu)
        end
        c[C_IDLE] = c[C_IDLE] - 1
        if c[C_COUNT] == 0:
            sync.Unlock(s.mu)
            break
        end
        np := c[C_HEAD] as Node*
        node := np[0]
        c[C_HEAD] = node.next
        if node.next == 0:
            c[C_TAIL] = 0
        end
        c[C_COUNT] = c[C_COUNT] - 1
        c[C_RUN] = c[C_RUN] + 1
        sync.Signal(s.nonfull)
        sync.Unlock(s.mu)
        mem.Free(np as void*)
        node.task()
        sync.Lock(s.mu)
        c[C_RUN] = c[C_RUN] - 1
        if c[C_COUNT] == 0 and c[C_RUN] == 0:
            sync.Broadcast(s.idle)
        end
        sync.Unlock(s.mu)
    end
end

func enqueue(sp: State*, task: func ()): bool:
    s := sp[0]
    c := s.c
    np := mem.AllocateZeroed(sizeof(Node) as u64) as Node*
    np[0] = Node { task = task, next = 0 }
    if c[C_TAIL] == 0:
        c[C_HEAD] = np as i64
    else:
        tp := c[C_TAIL] as Node*
        tp[0].next = np as i64
    end
    c[C_TAIL] = np as i64
    c[C_COUNT] = c[C_COUNT] + 1
    if c[C_COUNT] > c[C_IDLE] and c[C_LIVE] < c[C_MAX]:
        s.handles[c[C_LIVE]] = spawn(pool_worker, sp)
        c[C_LIVE] = c[C_LIVE] + 1
    end
    sync.Signal(s.nonempty)
    ret true
end

func default_pool(): Pool:
    until atomic_load(g_ready) != 2:
        if atomic_cas(g_ready, 0 as i64, 1 as i64):
            w := CPUCount()
            g_pool[0] = New(w, w * 64)
            atomic_store(g_ready, 2 as i64)
        else:
            sync.SleepMs(1)
        end
    end
    ret g_pool[0]
end

func group_run(gp: GroupState*, fn: func () str):
    g := gp[0]
    if atomic_load(g.failed) != 0:
        ret
    end
    e := fn()
    if e != "":
        sync.Lock(g.mu)
        if atomic_load(g.failed) == 0:
            gp[0].err = e
            atomic_store(g.failed, 1 as i64)
        end
        sync.Unlock(g.mu)
    end
end

func future_finish(f: Future):
    atomic_store(f.done, 1 as i64)
    sync.Broadcast(f.cv)
    sync.Unlock(f.mu)
end

func future_run(f: Future, fn: func () i64):
    v := fn()
    sync.Lock(f.mu)
    f.value[0] = v
    future_finish(f)
end

func future_run_str(f: Future, fn: func () str):
    v := fn()
    sync.Lock(f.mu)
    f.text[0] = v
    future_finish(f)
end

func future_new(): Future:
    mut f := Future {}
    f.value = mem.AllocateZeroed(8 as u64) as i64*
    f.text = mem.AllocateZeroed(sizeof(str) as u64) as str*
    f.done = mem.AllocateZeroed(8 as u64) as i64*
    f.mu = sync.NewMutex()
    f.cv = sync.NewCondVar()
    ret f
end

func future_wait(f: Future):
    sync.Lock(f.mu)
    until atomic_load(f.done) == 0:
        sync.WaitCond(f.cv, f.mu)
    end
    sync.Unlock(f.mu)
end

@en "CPUCount"
@fa "تعداد پردازنده"
pub func CPUCount(): i64:
    n := cpu_count_os()
    if n < 1:
        ret 1
    end
    ret n
end

@en "ParallelFor"
@fa "برای موازی"
pub func ParallelFor(n: i64, workers: i64, body: func (i64)):
    if n <= 0:
        ret
    end
    mut w := workers
    if w < 1: w = 1 end
    if w > n: w = n end

    rp := mem.AllocateZeroed(sizeof(Range) as u64) as Range*
    c := mem.AllocateZeroed(8 as u64) as i64*
    rp[0] = Range { body = body, next = c, n = n, mu = sync.NewMutex() }

    mut ts := Vector {} as Vector<thread.Thread>
    mut k := 0 as i64
    until k < w:
        ts = thread.Collect(ts, spawn(range_worker, rp))
        k = k + 1
    end
    thread.JoinAll(ts)
    ts.free()

    sync.Destroy(rp[0].mu)
    mem.Free(c as void*)
    mem.Free(rp as void*)
end

@en "ParallelForAuto"
@fa "برای موازی خودکار"
pub func ParallelForAuto(n: i64, body: func (i64)):
    ParallelFor(n, CPUCount(), body)
end

@en "New"
@fa "جدید"
pub func New(workers: i64, queue: i64): Pool:
    ret NewElastic(workers, workers, queue)
end

@en "NewElastic"
@fa "جدید کشسان"
pub func NewElastic(min: i64, max: i64, queue: i64): Pool:
    mut lo := min
    if lo < 1: lo = 1 end
    mut hi := max
    if hi < lo: hi = lo end
    mut q := queue
    if q < 1: q = 1 end
    sp := mem.AllocateZeroed(sizeof(State) as u64) as State*
    c := mem.AllocateZeroed((C_CELLS * 8) as u64) as i64*
    hs := mem.AllocateZeroed((hi * 8) as u64) as i64*
    c[C_CAP] = q
    c[C_MAX] = hi
    sp[0] = State { mu = sync.NewMutex(), nonempty = sync.NewCondVar(), nonfull = sync.NewCondVar(), idle = sync.NewCondVar(), c = c, handles = hs, workers = hi }
    sync.Lock(sp[0].mu)
    until c[C_LIVE] < lo:
        hs[c[C_LIVE]] = spawn(pool_worker, sp)
        c[C_LIVE] = c[C_LIVE] + 1
    end
    sync.Unlock(sp[0].mu)
    ret Pool { state = sp as void* }
end

@en "NewAuto"
@fa "جدید خودکار"
pub func NewAuto(): Pool:
    w := CPUCount()
    ret New(w, w * 4)
end

@en "Submit"
@fa "ارسال"
pub func Submit(p: Pool, task: func ()): bool:
    sp := p.state as State*
    s := sp[0]
    c := s.c
    sync.Lock(s.mu)
    until c[C_COUNT] >= c[C_CAP] and c[C_STOP] == 0:
        sync.WaitCond(s.nonfull, s.mu)
    end
    if c[C_STOP] != 0:
        sync.Unlock(s.mu)
        ret false
    end
    enqueue(sp, task)
    sync.Unlock(s.mu)
    ret true
end

@en "TrySubmit"
@fa "تلاش برای ارسال"
pub func TrySubmit(p: Pool, task: func ()): bool:
    sp := p.state as State*
    s := sp[0]
    c := s.c
    sync.Lock(s.mu)
    if c[C_STOP] != 0 or c[C_COUNT] >= c[C_CAP]:
        sync.Unlock(s.mu)
        ret false
    end
    enqueue(sp, task)
    sync.Unlock(s.mu)
    ret true
end

@en "Wait"
@fa "انتظار"
pub func Wait(p: Pool):
    sp := p.state as State*
    s := sp[0]
    c := s.c
    sync.Lock(s.mu)
    until c[C_COUNT] > 0 or c[C_RUN] > 0:
        sync.WaitCond(s.idle, s.mu)
    end
    sync.Unlock(s.mu)
end

@en "Stop"
@fa "توقف"
pub func Stop(p: Pool):
    sp := p.state as State*
    s := sp[0]
    c := s.c
    sync.Lock(s.mu)
    c[C_STOP] = 1
    sync.Broadcast(s.nonempty)
    sync.Broadcast(s.nonfull)
    sync.Unlock(s.mu)
    mut k := 0 as i64
    until k < c[C_LIVE]:
        thread.Join(thread.New(s.handles[k]))
        k = k + 1
    end
    sync.Destroy(s.mu)
    sync.DestroyCondVar(s.nonempty)
    sync.DestroyCondVar(s.nonfull)
    sync.DestroyCondVar(s.idle)
    mem.Free(s.handles as void*)
    mem.Free(c as void*)
    mem.Free(sp as void*)
end

@en "Running"
@fa "در حال اجرا"
pub func Running(p: Pool): i64:
    sp := p.state as State*
    s := sp[0]
    sync.Lock(s.mu)
    n := s.c[C_RUN]
    sync.Unlock(s.mu)
    ret n
end

@en "Pending"
@fa "در صف"
pub func Pending(p: Pool): i64:
    sp := p.state as State*
    s := sp[0]
    sync.Lock(s.mu)
    n := s.c[C_COUNT]
    sync.Unlock(s.mu)
    ret n
end

@en "Workers"
@fa "کارگرها"
pub func Workers(p: Pool): i64:
    sp := p.state as State*
    s := sp[0]
    sync.Lock(s.mu)
    n := s.c[C_LIVE]
    sync.Unlock(s.mu)
    ret n
end

@en "SubmitOrRun"
@fa "ارسال یا اجرا"
pub func SubmitOrRun(p: Pool, task: func ()):
    if not TrySubmit(p, task):
        task()
    end
end

@en "Go"
@fa "برو"
pub func Go(task: func ()):
    Submit(default_pool(), task)
end

@en "GoWait"
@fa "انتظار برو"
pub func GoWait():
    Wait(default_pool())
end

@en "NewGroup"
@fa "گروه کار جدید"
pub func NewGroup(limit: i64): Group:
    gp := mem.AllocateZeroed(sizeof(GroupState) as u64) as GroupState*
    f := mem.AllocateZeroed(8 as u64) as i64*
    gp[0] = GroupState { p = New(limit, limit * 2), mu = sync.NewMutex(), err = "", failed = f }
    ret Group { state = gp as void* }
end

@en "GroupGo"
@fa "گروه برو"
pub func GroupGo(g: Group, fn: func () str): bool:
    gp := g.state as GroupState*
    ret Submit(gp[0].p, (): group_run(gp, fn) end)
end

@en "GroupFailed"
@fa "گروه شکست خورده"
pub func GroupFailed(g: Group): bool:
    gp := g.state as GroupState*
    ret atomic_load(gp[0].failed) != 0
end

@en "GroupWait"
@fa "گروه انتظار"
pub func GroupWait(g: Group): str:
    gp := g.state as GroupState*
    Wait(gp[0].p)
    ret gp[0].err
end

@en "GroupStop"
@fa "گروه توقف"
pub func GroupStop(g: Group):
    gp := g.state as GroupState*
    s := gp[0]
    Stop(s.p)
    sync.Destroy(s.mu)
    mem.Free(s.failed as void*)
    mem.Free(gp as void*)
end

@en "Async"
@fa "ناهمزمان"
pub func Async(p: Pool, fn: func () i64): Future:
    f := future_new()
    Submit(p, (): future_run(f, fn) end)
    ret f
end

@en "AsyncStr"
@fa "ناهمزمان متن"
pub func AsyncStr(p: Pool, fn: func () str): Future:
    f := future_new()
    Submit(p, (): future_run_str(f, fn) end)
    ret f
end

@en "Await"
@fa "منتظر ماندن"
pub func Await(f: Future): i64:
    future_wait(f)
    ret f.value[0]
end

@en "AwaitStr"
@fa "منتظر ماندن متن"
pub func AwaitStr(f: Future): str:
    future_wait(f)
    ret f.text[0]
end

@en "Ready"
@fa "آماده"
pub func Ready(f: Future): bool:
    ret atomic_load(f.done) != 0
end

@en "Release"
@fa "رها کردن"
pub func Release(f: Future):
    sync.Destroy(f.mu)
    sync.DestroyCondVar(f.cv)
    mem.Free(f.value as void*)
    mem.Free(f.text as void*)
    mem.Free(f.done as void*)
end

@en "Map"
@fa "نگاشت موازی"
pub func Map(n: i64, workers: i64, fn: func (i64) i64): Vector<i64>:
    mut out := Vector {} as Vector<i64>
    if n <= 0:
        ret out
    end
    slots := mem.AllocateZeroed((n * 8) as u64) as i64*
    ParallelFor(n, workers, (i: i64): slots[i] = fn(i) end)
    mut k := 0 as i64
    until k < n:
        out.push(slots[k])
        k = k + 1
    end
    mem.Free(slots as void*)
    ret out
end
