@en "rand"
@fa "تصادفی"
package rand

import time
import str

mut _g_state := 0 as u64
mut _g_seeded := 0

func _pcg_step():
    _g_state = _g_state * (6364136223846793005 as u64) + (1442695040888963407 as u64)
end

func _ensure_seeded():
    if _g_seeded == 0:
        rand_seed(time.Now())
    end
end

func rand_seed(s: i64):
    _g_state = (s as u64) + (1442695040888963407 as u64)
    _pcg_step()
    _g_seeded = 1
end

func rand_int32(): int:
    _ensure_seeded()
    _pcg_step()
    h := _g_state / (4294967296 as u64)
    ret (h % (2147483648 as u64)) as int
end

func rand_int64(): i64:
    _ensure_seeded()
    _pcg_step()
    hi := _g_state / (4294967296 as u64) % (2147483648 as u64)
    _pcg_step()
    lo := _g_state / (4294967296 as u64)
    ret (hi * (4294967296 as u64) + lo) as i64
end

func rand_float64(): f64:
    n := rand_int64()
    n53 := n % 9007199254740992
    ret n53 as f64 / 9007199254740992.0
end

func rand_bytes(n: int): str:
    if n <= 0: ret "" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n:
        str.BufAppendChar(sb, rand_int32() % 255 + 1)
    end
    out := str.BufStr(sb)
    ret out
end

func _hex_digit(d: int): int:
    if d < 10: ret d + 48 end
    ret d + 87
end

func hex_bytes(n: int): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n:
        b := rand_int32() % 256
        str.BufAppendChar(sb, _hex_digit(b / 16))
        str.BufAppendChar(sb, _hex_digit(b % 16))
    end
    out := str.BufStr(sb)
    ret out
end

@en "Seed"
@fa "بذر"
pub func Seed(s: i64):
    rand_seed(s)
end

@en "SeedAuto"
@fa "بذر خودکار"
pub func SeedAuto():
    rand_seed(time.Now())
end

@en "Int"
@fa "عدد تصادفی"
pub func Int(): i64:
    ret rand_int64()
end

@en "Int32"
@fa "عدد ۳۲بیتی"
pub func Int32(): int:
    ret rand_int32()
end

@en "IntN"
@fa "عدد تا ان"
pub func IntN(n: i64): i64:
    ret rand_int64() % n
end

@en "IntRange"
@fa "عدد در بازه"
pub func IntRange(lo: i64, hi: i64): i64:
    ret lo + rand_int64() % (hi - lo + 1)
end

@en "Int32Range"
@fa "عدد ۳۲بیتی در بازه"
pub func Int32Range(lo: int, hi: int): int:
    ret lo + rand_int32() % (hi - lo + 1)
end

@en "IntWithLength"
@fa "عدد با طول"
pub func IntWithLength(digits: int): i64:
    if digits <= 1:
        ret rand_int64() % 10
    end
    mut lo := 1 as i64
    mut k := 1
    until k < digits:
        lo *= 10
        k += 1
    end
    hi := lo * 10 - 1
    ret lo + rand_int64() % (hi - lo + 1)
end

@en "Float"
@fa "اعشار تصادفی"
pub func Float(): f64:
    ret rand_float64()
end

@en "FloatRange"
@fa "اعشار در بازه"
pub func FloatRange(lo: f64, hi: f64): f64:
    ret lo + rand_float64() * (hi - lo)
end

@en "Bool"
@fa "منطقی تصادفی"
pub func Bool(): bool:
    ret rand_int32() % 2 == 0
end

@en "BoolP"
@fa "منطقی با احتمال"
pub func BoolP(p: f64): bool:
    ret rand_float64() < p
end

@en "Bytes"
@fa "بایت های تصادفی"
pub func Bytes(n: int): str:
    ret rand_bytes(n)
end

@en "TextFrom"
@fa "متن از"
pub func TextFrom(n: int, charset: str): str:
    charset_len := charset.len()
    if charset_len == 0 || n <= 0: ret "" end
    cp := (charset as void*) as i8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n:
        idx := rand_int32() % charset_len
        str.BufAppendChar(sb, cp[idx] as int)
    end
    out := str.BufStr(sb)
    ret out
end

@en "Alpha"
@fa "حروف"
pub func Alpha(n: int): str:
    ret TextFrom(n, "abcdefghijklmnopqrstuvwxyz")
end

@en "AlphaUpper"
@fa "حروف بزرگ"
pub func AlphaUpper(n: int): str:
    ret TextFrom(n, "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
end

@en "AlphaMixed"
@fa "حروف ترکیبی"
pub func AlphaMixed(n: int): str:
    ret TextFrom(n, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
end

@en "Digit"
@fa "رقم"
pub func Digit(n: int): str:
    ret TextFrom(n, "0123456789")
end

@en "Alnum"
@fa "حروف و عدد"
pub func Alnum(n: int): str:
    ret TextFrom(n, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
end

@en "Text"
@fa "متن تصادفی"
pub func Text(n: int): str:
    ret TextFrom(n, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()-_=+[]{}|;:,.<>?")
end

@en "HexBytes"
@fa "بایت های شانزده"
pub func HexBytes(n: int): str:
    ret hex_bytes(n)
end

@en "Hash"
@fa "درهم"
pub func Hash(): str:
    ret hex_bytes(16)
end

@en "Hash160"
@fa "درهم ۱۶۰"
pub func Hash160(): str:
    ret hex_bytes(20)
end

@en "Hash256"
@fa "درهم ۲۵۶"
pub func Hash256(): str:
    ret hex_bytes(32)
end

@en "UUID"
@fa "شناسه یکتا"
pub func UUID(): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat 16 with i:
        b := rand_int32() % 256
        mut bval := b
        if i == 6: bval = b % 16 + 64
        else i == 8: bval = b % 64 + 128
        end
        str.BufAppendChar(sb, _hex_digit(bval / 16))
        str.BufAppendChar(sb, _hex_digit(bval % 16))
        if i == 3 || i == 5 || i == 7 || i == 9:
            str.BufAppendChar(sb, 45)
        end
    end
    out := str.BufStr(sb)
    ret out
end

@en "ChoiceStr"
@fa "انتخاب رشته"
pub func ChoiceStr(v: Vector<str>): str:
    idx := rand_int32() % v.len()
    ret v.get(idx)
end

@en "ChoiceInt"
@fa "انتخاب عدد"
pub func ChoiceInt(v: Vector<int>): int:
    idx := rand_int32() % v.len()
    ret v.get(idx)
end

@en "ChoiceChar"
@fa "انتخاب نویسه"
pub func ChoiceChar(s: str): str:
    idx := rand_int32() % s.len()
    ret s.substr(idx, 1)
end

@en "ShuffleStr"
@fa "بهم ریختن رشته"
pub func ShuffleStr(v: Vector<str>): Vector<str>:
    out := Vector {} as Vector<str> mut i := 0
    until i < v.len():
        out.push(v.get(i))
        i += 1
    end
    mut k := out.len() - 1
    until k > 0:
        j := rand_int32() % (k + 1)
        tmp := out.get(k)
        out.set(k, out.get(j))
        out.set(j, tmp)
        k -= 1
    end
    ret out
end

@en "ShuffleInt"
@fa "بهم ریختن عدد"
pub func ShuffleInt(v: Vector<int>): Vector<int>:
    out := Vector {} as Vector<int> mut i := 0
    until i < v.len():
        out.push(v.get(i))
        i += 1
    end
    mut k := out.len() - 1
    until k > 0:
        j := rand_int32() % (k + 1)
        tmp := out.get(k)
        out.set(k, out.get(j))
        out.set(j, tmp)
        k -= 1
    end
    ret out
end
