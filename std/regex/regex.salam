// Whole-match API: does it match, where does it match, replace it. The parts
// that read submatches out of a match live in capture.salam, and the engine
// itself in engine.salam.
//
// Supported syntax: literals, . [abc] [^a-z] [\w.] \d \w \s \D \W \S \n \t \r,
// anchors ^ $, groups (…) (?:…) (?<name>…) (?P<name>…), alternation a|b,
// quantifiers * + ? {n} {n,} {n,m} and their lazy *? +? ?? {n,m}? forms.
// A pattern outside that syntax is invalid rather than literal: check one with
// IsValid, since Match on an invalid pattern is simply false.

@en "regex"
@fa "عبارت باقاعده"
@ar "تعبیر نمطی"
package regex

@en "Regex"
@fa "عبارت باقاعده"
@ar "تعبیر نمطی"
pub struct Regex:
    pub pattern: str = ""
end

@en "Compile"
@fa "کامپایل"
@ar "تجمیع"
pub func Compile(pattern: str): Regex:
    ret Regex { pattern = pattern }
end

@en "IsValid"
@fa "معتبر است"
@ar "صالح"
pub func IsValid(pattern: str): bool:
    ret _re_compile(pattern)
end

@en "Match"
@fa "تطبیق"
@ar "مطابقة"
pub func Match(re: Regex, text: str): bool:
    ret _re_search(re.pattern, text) >= 0
end

@en "Find"
@fa "یافتن"
@ar "بحث"
pub func Find(re: Regex, text: str): int:
    ret _re_search(re.pattern, text)
end

@en "Replace"
@fa "جایگزینی"
@ar "استبدال"
pub func Replace(re: Regex, text: str, replacement: str): str:
    idx := _re_search(re.pattern, text)
    if idx < 0: ret text end
    end_idx := _re_last_end
    mlen := end_idx - idx
    tl := text.len()
    ret text.substr(0, idx).concat(replacement).concat(text.substr(idx + mlen, tl - idx - mlen))
end

@en "ReplaceAll"
@fa "جایگزینی همه"
@ar "استبدال الکل"
pub func ReplaceAll(re: Regex, text: str, replacement: str): str:
    mut result := ""
    mut rest := text
    mut going := true
    until going:
        idx := _re_search(re.pattern, rest)
        if idx < 0:
            going = false
        else:
            mlen := _re_last_end - idx
            result = result.concat(rest.substr(0, idx)).concat(replacement)
            mut adv := idx + mlen
            if mlen == 0:
                if adv < rest.len():
                    result = result.concat(rest.substr(adv, 1))
                end
                adv += 1
            end
            if adv >= rest.len():
                rest = ""
                going = false
            else:
                rest = rest.substr(adv, rest.len() - adv)
            end
        end
    end
    ret result.concat(rest)
end

@en "MatchStr"
@fa "تطبیق رشته"
@ar "مطابقة نص"
pub func MatchStr(pattern: str, text: str): bool:
    ret _re_search(pattern, text) >= 0
end

@en "FindStr"
@fa "یافتن رشته"
@ar "بحث نص"
pub func FindStr(pattern: str, text: str): int:
    ret _re_search(pattern, text)
end

@en "ReplaceStr"
@fa "جایگزینی رشته"
@ar "استبدال نص"
pub func ReplaceStr(pattern: str, text: str, replacement: str): str:
    re := Compile(pattern)
    ret Replace(re, text, replacement)
end

@en "ReplaceAllStr"
@fa "جایگزینی همه رشته"
@ar "استبدال الکل نص"
pub func ReplaceAllStr(pattern: str, text: str, replacement: str): str:
    re := Compile(pattern)
    ret ReplaceAll(re, text, replacement)
end
