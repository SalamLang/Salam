@en "regex"
@fa "عبارت باقاعده"
package regex

import str

@en "Regex"
@fa "عبارت باقاعده"
pub struct Regex:
    @en "pattern"
    @fa "الگو"
    pub pattern: str = ""
end

@en "Compile"
@fa "کامپایل"
pub func Compile(pattern: str): Regex:
    ret Regex { pattern = pattern }
end

@en "IsValid"
@fa "معتبر است"
pub func IsValid(pattern: str): bool:
    ret _re_compile(pattern)
end

@en "Match"
@fa "تطبیق"
pub func Match(re: Regex, text: str): bool:
    ret _re_search(re.pattern, text) >= 0
end

@en "Find"
@fa "یافتن"
pub func Find(re: Regex, text: str): int:
    ret _re_search(re.pattern, text)
end

@en "Replace"
@fa "جایگزینی"
pub func Replace(re: Regex, text: str, replacement: str): str:
    idx := _re_search(re.pattern, text)
    if idx < 0: ret text end
    end_idx := _re_last_end
    mlen := end_idx - idx
    tl := text.len()
    ret text.substr(0, idx).concat(replacement).concat(text.substr(idx + mlen, tl - idx - mlen))
end

@en "ReplaceAll"
@fa "جایگزینی همه"
pub func ReplaceAll(re: Regex, text: str, replacement: str): str:
    tl := text.len()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut cut := 0
    mut from := 0
    mut going := true
    until going:
        if from > tl or not _re_exec_n(re.pattern, text, tl, from):
            going = false
        else:
            start := _re_save[0]
            stop := _re_last_end
            _re_put(sb, text, cut, start)
            str.BufAppend(sb, replacement)
            cut = stop
            from = stop
            if stop == start:
                from = start + 1
                if from <= tl:
                    _re_put(sb, text, cut, from)
                    cut = from
                end
            end
        end
    end
    _re_put(sb, text, cut, tl)
    ret str.BufStr(sb)
end

@en "MatchStr"
@fa "تطبیق رشته"
pub func MatchStr(pattern: str, text: str): bool:
    ret _re_search(pattern, text) >= 0
end

@en "FindStr"
@fa "یافتن رشته"
pub func FindStr(pattern: str, text: str): int:
    ret _re_search(pattern, text)
end

@en "ReplaceStr"
@fa "جایگزینی رشته"
pub func ReplaceStr(pattern: str, text: str, replacement: str): str:
    re := Compile(pattern)
    ret Replace(re, text, replacement)
end

@en "ReplaceAllStr"
@fa "جایگزینی همه رشته"
pub func ReplaceAllStr(pattern: str, text: str, replacement: str): str:
    re := Compile(pattern)
    ret ReplaceAll(re, text, replacement)
end
