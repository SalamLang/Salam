@en "result"
@fa "نتیجه"
package result

extern:
    noret func salam_panic(msg: str)
end

@en "Result"
@fa "نتیجه"
pub enum Result<T, E>:
    @en "Ok"
    @fa "موفق"
    Ok(value: T)
    @en "Err"
    @fa "خطا"
    Err(error: E)
end

@en "IsOk"
@fa "موفق است"
pub func IsOk<T, E>(r: Result<T, E>): bool:
    ret match r:
        Ok(_) => true
        Err(_) => false
    end
end

@en "IsErr"
@fa "خطا است"
pub func IsErr<T, E>(r: Result<T, E>): bool:
    ret not IsOk(r)
end

@en "UnwrapOr"
@fa "با پیش فرض"
pub func UnwrapOr<T, E>(r: Result<T, E>, fallback: T): T:
    ret match r:
        Ok(v) => v
        Err(_) => fallback
    end
end

@en "Expect"
@fa "انتظار"
pub func Expect<T, E>(r: Result<T, E>, msg: str): T:
    match r:
        Ok(v):
            ret v
        end
        Err(_):
            salam_panic(msg)
        end
    end
end
