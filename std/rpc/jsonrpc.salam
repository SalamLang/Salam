package rpc

import encoding.value
import encoding.json
import encoding.encerr

// JSON-RPC 2.0 (https://www.jsonrpc.org/specification), complete:
// requests, notifications (no `id` member at all - distinct from an `id`
// of null), single and batch payloads, the reserved error-code range,
// and the spec's rule that a batch made entirely of notifications gets
// no reply document at all.
//
// Everything goes through encoding.value/encoding.json rather than
// string surgery, so ids keep their JSON type (a string id comes back a
// string, a number id comes back a number) and params of arbitrary
// nesting survive a round trip untouched.

func _is_valid_id(v: value.Value): bool:
    ret value.IsString(v) || value.IsInt(v) || value.IsFloat(v) || value.IsNull(v)
end

func _err_to_value(e: Error): value.Value:
    mut o := value.NewValueObject()
    value.ObjectSet(o, "code", value.ValueInt(e.code as i64))
    value.ObjectSet(o, "message", value.ValueString(e.message))
    if e.has_data:
        value.ObjectSet(o, "data", e.data)
    end
    ret o
end

func _value_to_err(v: value.Value): Error:
    mut e := Error {}
    e.code = RPC_INTERNAL_ERROR
    e.message = "Internal error"
    if !value.IsObject(v): ret e end
    if value.ObjectHas(v, "code"):
        c := value.ObjectGet(v, "code")
        if value.IsInt(c) || value.IsFloat(c): e.code = value.AsInt(c) as int end
    end
    if value.ObjectHas(v, "message"):
        m := value.ObjectGet(v, "message")
        if value.IsString(m): e.message = value.AsString(m) end
    end
    if value.ObjectHas(v, "data"):
        e.data = value.ObjectGet(v, "data")
        e.has_data = true
    end
    ret e
end

// One element of a batch (or a whole non-batch payload) validated
// against the spec's "Request object" rules. Anything that fails lands
// as a Request carrying an invalid-request marker, which the dispatcher
// turns into a per-element error object - a malformed member of a batch
// must not abort the rest of it.
func _decode_one_request(v: value.Value, out &: Request): Error:
    mut e := Error {}
    e.code = 0
    if !value.IsObject(v):
        ret StdError(RPC_INVALID_REQUEST)
    end
    if !value.ObjectHas(v, "jsonrpc"):
        ret StdError(RPC_INVALID_REQUEST)
    end
    ver := value.ObjectGet(v, "jsonrpc")
    if !value.IsString(ver) || value.AsString(ver) != "2.0":
        ret StdError(RPC_INVALID_REQUEST)
    end
    if !value.ObjectHas(v, "method"):
        ret StdError(RPC_INVALID_REQUEST)
    end
    m := value.ObjectGet(v, "method")
    if !value.IsString(m):
        ret StdError(RPC_INVALID_REQUEST)
    end
    out.method = value.AsString(m)
    if value.ObjectHas(v, "params"):
        p := value.ObjectGet(v, "params")
        // The spec restricts params to a structured value: array or object.
        if !value.IsArray(p) && !value.IsObject(p):
            ret StdError(RPC_INVALID_PARAMS)
        end
        out.params = p
        out.has_params = true
    end
    if value.ObjectHas(v, "id"):
        idv := value.ObjectGet(v, "id")
        if !_is_valid_id(idv):
            ret StdError(RPC_INVALID_REQUEST)
        end
        out.id = idv
        out.has_id = true
        if value.IsInt(idv): out.msgid = value.AsInt(idv) end
    end
    ret e
end

func _decode_one_response(v: value.Value, out &: Response): bool:
    if !value.IsObject(v): ret false end
    if value.ObjectHas(v, "id"):
        out.id = value.ObjectGet(v, "id")
        out.has_id = true
        if value.IsInt(out.id): out.msgid = value.AsInt(out.id) end
    end
    if value.ObjectHas(v, "error"):
        out.is_error = true
        out.err = _value_to_err(value.ObjectGet(v, "error"))
        ret true
    end
    if value.ObjectHas(v, "result"):
        out.result = value.ObjectGet(v, "result")
        ret true
    end
    ret false
end

@en "JsonEncodeRequest"
@fa "کدگذاری درخواست جیسون"
@ar "ترمیز طلب جیسون"
pub func JsonEncodeRequest(r: Request): str:
    mut o := value.NewValueObject()
    value.ObjectSet(o, "jsonrpc", value.ValueString("2.0"))
    value.ObjectSet(o, "method", value.ValueString(r.method))
    if r.has_params:
        value.ObjectSet(o, "params", r.params)
    end
    if r.has_id:
        value.ObjectSet(o, "id", r.id)
    end
    ret json.EncodeDefault(o)
end

@en "JsonEncodeResponse"
@fa "کدگذاری پاسخ جیسون"
@ar "ترمیز استجابة جیسون"
pub func JsonEncodeResponse(r: Response): str:
    mut o := value.NewValueObject()
    value.ObjectSet(o, "jsonrpc", value.ValueString("2.0"))
    if r.is_error:
        value.ObjectSet(o, "error", _err_to_value(r.err))
    else:
        value.ObjectSet(o, "result", r.result)
    end
    if r.has_id:
        value.ObjectSet(o, "id", r.id)
    else:
        value.ObjectSet(o, "id", value.ValueNull())
    end
    ret json.EncodeDefault(o)
end

// A batch reply is a JSON array of response objects. Per the spec, if
// every element of the incoming batch was a notification the server
// returns nothing at all - represented here by the empty string, which
// every transport in this package treats as "send no reply".
@en "JsonEncodeResponses"
@fa "کدگذاری پاسخ‌ها"
@ar "ترمیز الاستجابات"
pub func JsonEncodeResponses(rs: Responses): str:
    n := rs.items.len()
    if n == 0: ret "" end
    if !rs.is_batch:
        ret JsonEncodeResponse(rs.items.get(0))
    end
    mut parts := Vector {} as Vector<str>
    mut i := 0
    until i < n:
        parts.push(JsonEncodeResponse(rs.items.get(i)))
        i += 1
    end
    ret json.Array(parts)
end

// Decodes a whole inbound payload: a single Request object, or a batch
// array of them. `ok == false` with `err` set means the payload itself
// was unusable (bad JSON, or an empty batch array) and the caller should
// answer with one top-level error object.
@en "JsonDecodeBatch"
@fa "کدگشایی دسته جیسون"
@ar "فک ترمیز الدفعة"
pub func JsonDecodeBatch(text: str): Batch:
    mut b := Batch {}
    mut jerr := encerr.NoError()
    v := json.Decode(text, jerr)
    if encerr.IsError(jerr):
        b.ok = false
        b.err = StdError(RPC_PARSE_ERROR)
        ret b
    end
    if value.IsArray(v):
        b.is_batch = true
        n := value.ArrayLen(v)
        if n == 0:
            b.ok = false
            b.err = StdError(RPC_INVALID_REQUEST)
            ret b
        end
        mut i := 0
        until i < n:
            mut r := Request {}
            e := _decode_one_request(value.ArrayGet(v, i), r)
            if e.code != 0:
                // Keep the id if the element at least carried a usable
                // one, so the error object can be correlated client-side.
                r.method = ""
                r.err_code = e.code
                r.err_message = e.message
            end
            b.items.push(r)
            i += 1
        end
        ret b
    end
    mut r := Request {}
    e := _decode_one_request(v, r)
    if e.code != 0:
        r.method = ""
        r.err_code = e.code
        r.err_message = e.message
    end
    b.items.push(r)
    ret b
end

@en "JsonDecodeRequest"
@fa "کدگشایی درخواست جیسون"
@ar "فک ترمیز الطلب"
pub func JsonDecodeRequest(text: str, ok &: bool): Request:
    b := JsonDecodeBatch(text)
    mut r := Request {}
    if !b.ok || b.is_batch || b.items.len() != 1:
        ok = false
        ret r
    end
    r = b.items.get(0)
    ok = r.err_code == 0
    ret r
end

@en "JsonDecodeResponse"
@fa "کدگشایی پاسخ جیسون"
@ar "فک ترمیز الاستجابة"
pub func JsonDecodeResponse(text: str, ok &: bool): Response:
    mut r := Response {}
    mut jerr := encerr.NoError()
    v := json.Decode(text, jerr)
    if encerr.IsError(jerr):
        ok = false
        ret r
    end
    ok = _decode_one_response(v, r)
    ret r
end

@en "JsonDecodeResponses"
@fa "کدگشایی پاسخ‌های جیسون"
@ar "فک ترمیز الاستجابات"
pub func JsonDecodeResponses(text: str, ok &: bool): Responses:
    mut rs := Responses {}
    mut jerr := encerr.NoError()
    v := json.Decode(text, jerr)
    if encerr.IsError(jerr):
        ok = false
        ret rs
    end
    if value.IsArray(v):
        rs.is_batch = true
        n := value.ArrayLen(v)
        mut i := 0
        until i < n:
            mut one := Response {}
            if _decode_one_response(value.ArrayGet(v, i), one):
                rs.items.push(one)
            end
            i += 1
        end
        ok = true
        ret rs
    end
    mut one := Response {}
    ok = _decode_one_response(v, one)
    if ok: rs.items.push(one) end
    ret rs
end

// The single top-level error document a server sends when the payload
// never got far enough to have per-request ids (bad JSON, empty batch).
@en "JsonTopLevelError"
@fa "خطای سطح بالای جیسون"
@ar "خطأ المستوی الأعلی"
pub func JsonTopLevelError(e: Error): str:
    mut r := Response {}
    r.is_error = true
    r.err = e
    r.has_id = false
    ret JsonEncodeResponse(r)
end
