@en "rpc"
@fa "فراخوان دور"
package rpc

import encoding.value

@en "RPC_PARSE_ERROR"
@fa "کد خطای تجزیه"
pub const RPC_PARSE_ERROR := 0 - 32700
@en "RPC_INVALID_REQUEST"
@fa "کد درخواست نامعتبر"
pub const RPC_INVALID_REQUEST := 0 - 32600
@en "RPC_METHOD_NOT_FOUND"
@fa "کد روش یافت نشد"
pub const RPC_METHOD_NOT_FOUND := 0 - 32601
@en "RPC_INVALID_PARAMS"
@fa "کد پارامترهای نامعتبر"
pub const RPC_INVALID_PARAMS := 0 - 32602
@en "RPC_INTERNAL_ERROR"
@fa "کد خطای داخلی"
pub const RPC_INTERNAL_ERROR := 0 - 32603
@en "RPC_SERVER_ERROR"
@fa "کد خطای کارساز"
pub const RPC_SERVER_ERROR := 0 - 32000

@en "RPC_KIND_REQUEST"
@fa "نوع درخواست"
pub const RPC_KIND_REQUEST := 1
@en "RPC_KIND_NOTIFICATION"
@fa "نوع اعلان"
pub const RPC_KIND_NOTIFICATION := 2
@en "RPC_KIND_RESPONSE"
@fa "نوع پاسخ"
pub const RPC_KIND_RESPONSE := 3

@en "RPC_CODEC_JSON"
@fa "کدک جیسون"
pub const RPC_CODEC_JSON := 0
@en "RPC_CODEC_MSGPACK"
@fa "کدک مسگ‌پک"
pub const RPC_CODEC_MSGPACK := 1

@en "RPC_FRAME_LINE"
@fa "قاب خطی"
pub const RPC_FRAME_LINE := 0
@en "RPC_FRAME_HEADER"
@fa "قاب سرآیندی"
pub const RPC_FRAME_HEADER := 1
@en "RPC_FRAME_LENGTH"
@fa "قاب طول‌دار"
pub const RPC_FRAME_LENGTH := 2

@en "Error"
@fa "خطای فراخوان"
pub struct Error:
    @en "code"
    @fa "کد"
    pub code: int = 0
    @en "message"
    @fa "پیام"
    pub message: str = ""
    @en "data"
    @fa "داده"
    pub data: value.Value = value.Value {}
    @en "has_data"
    @fa "داده دارد"
    pub has_data: bool = false
end

@en "Request"
@fa "درخواست"
pub struct Request:
    @en "method"
    @fa "متد"
    pub method: str = ""
    @en "params"
    @fa "پارامترها"
    pub params: value.Value = value.Value {}
    @en "has_params"
    @fa "پارامتر دارد"
    pub has_params: bool = false
    @en "id"
    @fa "شناسه"
    pub id: value.Value = value.Value {}
    @en "has_id"
    @fa "شناسه دارد"
    pub has_id: bool = false
    @en "msgid"
    @fa "شناسه عددی"
    pub msgid: i64 = 0
    @en "err_code"
    @fa "کد خطا"
    pub err_code: int = 0
    @en "err_message"
    @fa "پیام خطا"
    pub err_message: str = ""
end

@en "Response"
@fa "پاسخ"
pub struct Response:
    @en "id"
    @fa "شناسه"
    pub id: value.Value = value.Value {}
    @en "has_id"
    @fa "شناسه دارد"
    pub has_id: bool = false
    @en "result"
    @fa "نتیجه"
    pub result: value.Value = value.Value {}
    @en "is_error"
    @fa "خطاست"
    pub is_error: bool = false
    @en "err"
    @fa "خطا"
    pub err: Error = Error {}
    @en "msgid"
    @fa "شناسه عددی"
    pub msgid: i64 = 0
end

@en "Batch"
@fa "دسته"
pub struct Batch:
    @en "items"
    @fa "درخواست‌ها"
    pub items: Vector<Request> = Vector {}
    @en "is_batch"
    @fa "به شکل آرایه"
    pub is_batch: bool = false
    @en "ok"
    @fa "خوانده‌شده"
    pub ok: bool = true
    @en "err"
    @fa "خطا"
    pub err: Error = Error {}
end

@en "Responses"
@fa "پاسخ‌ها"
pub struct Responses:
    @en "items"
    @fa "پاسخ‌ها"
    pub items: Vector<Response> = Vector {}
    @en "is_batch"
    @fa "به شکل آرایه"
    pub is_batch: bool = false
end

@en "Method"
@fa "متد"
pub struct Method:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "fn"
    @fa "تابع"
    pub fn: i64 = 0
    @en "doc"
    @fa "توضیح"
    pub doc: str = ""
end

@en "MethodTable"
@fa "جدول متدها"
pub struct MethodTable:
    @en "items"
    @fa "متد‌ها"
    pub items: Vector<Method> = Vector {}
end

@en "CallSlot"
@fa "جایگاه فراخوان"
pub struct CallSlot:
    @en "req"
    @fa "درخواست"
    pub req: Request = Request {}
    @en "result"
    @fa "نتیجه"
    pub result: value.Value = value.Value {}
    @en "err"
    @fa "خطا"
    pub err: Error = Error {}
    @en "is_error"
    @fa "خطاست"
    pub is_error: bool = false
    @en "replied"
    @fa "پاسخ داده‌شده"
    pub replied: bool = false
    @en "busy"
    @fa "مشغول"
    pub busy: bool = false
end

@en "SlotTable"
@fa "جدول جایگاه‌ها"
pub struct SlotTable:
    @en "items"
    @fa "فراخوان‌ها"
    pub items: Vector<CallSlot> = Vector {}
end

func _code_text(code: int): str:
    if code == RPC_PARSE_ERROR: ret "Parse error" end
    if code == RPC_INVALID_REQUEST: ret "Invalid Request" end
    if code == RPC_METHOD_NOT_FOUND: ret "Method not found" end
    if code == RPC_INVALID_PARAMS: ret "Invalid params" end
    if code == RPC_INTERNAL_ERROR: ret "Internal error" end
    ret "Server error"
end

@en "NewError"
@fa "خطای جدید"
pub func NewError(code: int, message: str): Error:
    mut e := Error {}
    e.code = code
    e.message = message
    e.has_data = false
    ret e
end

@en "StdError"
@fa "خطای استاندارد"
pub func StdError(code: int): Error:
    ret NewError(code, _code_text(code))
end

@en "ErrorWithData"
@fa "خطا با داده"
pub func ErrorWithData(code: int, message: str, data: value.Value): Error:
    mut e := Error {}
    e.code = code
    e.message = message
    e.data = data
    e.has_data = true
    ret e
end

@en "NewRequest"
@fa "درخواست جدید"
pub func NewRequest(method: str, params: value.Value, id: i64): Request:
    mut r := Request {}
    r.method = method
    r.params = params
    r.has_params = true
    r.id = value.ValueInt(id)
    r.has_id = true
    r.msgid = id
    ret r
end

@en "NewRequestStrId"
@fa "درخواست با شناسه متنی"
pub func NewRequestStrId(method: str, params: value.Value, id: str): Request:
    mut r := Request {}
    r.method = method
    r.params = params
    r.has_params = true
    r.id = value.ValueString(id)
    r.has_id = true
    ret r
end

@en "NewNotification"
@fa "اعلان جدید"
pub func NewNotification(method: str, params: value.Value): Request:
    mut r := Request {}
    r.method = method
    r.params = params
    r.has_params = true
    r.has_id = false
    ret r
end

@en "IsNotification"
@fa "اعلان است"
pub func IsNotification(r: Request): bool:
    ret not r.has_id
end

@en "NewResponse"
@fa "پاسخ جدید"
pub func NewResponse(id: value.Value, result: value.Value): Response:
    mut r := Response {}
    r.id = id
    r.has_id = true
    r.result = result
    r.is_error = false
    ret r
end

@en "NewErrorResponse"
@fa "پاسخ خطا"
pub func NewErrorResponse(id: value.Value, e: Error): Response:
    mut r := Response {}
    r.id = id
    r.has_id = true
    r.is_error = true
    r.err = e
    ret r
end

@en "ParamCount"
@fa "تعداد پارامتر"
pub func ParamCount(r: Request): int:
    if not r.has_params: ret 0 end
    if value.IsArray(r.params): ret value.ArrayLen(r.params) end
    if value.IsObject(r.params): ret value.ObjectLen(r.params) end
    ret 0
end

@en "ParamAt"
@fa "پارامتر در جایگاه"
pub func ParamAt(r: Request, i: int): value.Value:
    if not r.has_params: ret value.ValueNull() end
    if not value.IsArray(r.params): ret value.ValueNull() end
    if i < 0 or i >= value.ArrayLen(r.params): ret value.ValueNull() end
    ret value.ArrayGet(r.params, i)
end

@en "ParamNamed"
@fa "پارامتر نام‌دار"
pub func ParamNamed(r: Request, key: str): value.Value:
    if not r.has_params: ret value.ValueNull() end
    if not value.IsObject(r.params): ret value.ValueNull() end
    if not value.ObjectHas(r.params, key): ret value.ValueNull() end
    ret value.ObjectGet(r.params, key)
end

@en "Param"
@fa "پارامتر"
pub func Param(r: Request, key: str, pos: int): value.Value:
    if r.has_params and value.IsObject(r.params):
        ret ParamNamed(r, key)
    end
    ret ParamAt(r, pos)
end

@en "ParamInt"
@fa "پارامتر عددی"
pub func ParamInt(r: Request, key: str, pos: int): i64:
    v := Param(r, key, pos)
    if value.IsInt(v) or value.IsFloat(v): ret value.AsInt(v) end
    ret 0
end

@en "ParamFloat"
@fa "پارامتر اعشاری"
pub func ParamFloat(r: Request, key: str, pos: int): f64:
    v := Param(r, key, pos)
    if value.IsInt(v) or value.IsFloat(v): ret value.AsFloat(v) end
    ret 0.0
end

@en "ParamStr"
@fa "پارامتر متنی"
pub func ParamStr(r: Request, key: str, pos: int): str:
    v := Param(r, key, pos)
    if value.IsString(v): ret value.AsString(v) end
    ret ""
end

@en "ParamBool"
@fa "پارامتر بولی"
pub func ParamBool(r: Request, key: str, pos: int): bool:
    v := Param(r, key, pos)
    if value.IsBool(v): ret value.AsBool(v) end
    ret false
end

@en "HasParam"
@fa "پارامتر دارد"
pub func HasParam(r: Request, key: str, pos: int): bool:
    v := Param(r, key, pos)
    ret not value.IsNull(v)
end
