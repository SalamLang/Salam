@en "runtime"
@fa "زمان اجرا"
@ar "بیئة التشغیل"
package runtime

import os.platform
import time
import conv
import str

mut _start_ms := 0 as i64
mut _start_set := false

func _ensure_start():
    if _start_set == false:
        _start_ms = time.NowMillis()
        _start_set = true
    end
end

@en "OS"
@fa "سیستم عامل"
@ar "نظام التشغیل"
pub func OS(): str: ret platform.OS() end

@en "Arch"
@fa "معماری"
@ar "المعماریة"
pub func Arch(): str: ret platform.Arch() end

@en "CpuCount"
@fa "تعداد پردازنده"
@ar "عدد المعالجات"
pub func CpuCount(): int: ret platform.CpuCount() end

@en "TotalMemory"
@fa "کل حافظه"
@ar "إجمالي الذاکرة"
pub func TotalMemory(): i64: ret platform.TotalMemory() end

@en "AvailableMemory"
@fa "حافظه موجود"
@ar "الذاکرة المتاحة"
pub func AvailableMemory(): i64: ret platform.AvailableMemory() end

@en "UsedMemory"
@fa "حافظه استفاده شده"
@ar "الذاکرة المستخدمة"
pub func UsedMemory(): i64:
    t := TotalMemory()
    a := AvailableMemory()
    if t < 0 || a < 0: ret 0 - 1 end
    ret t - a
end

// MarkStart pins the uptime reference point to "now". Call it once near
// program start for accurate UptimeMs(); if never called, the reference
// point defaults to the first UptimeMs()/UptimeSeconds() call instead.
@en "MarkStart"
@fa "علامت‌گذاری شروع"
@ar "تحدید البدء"
pub func MarkStart(): _ensure_start() end

@en "UptimeMs"
@fa "زمان فعالیت (میلی‌ثانیه)"
@ar "مدة التشغیل (ملی ثانیة)"
pub func UptimeMs(): i64:
    _ensure_start()
    ret time.NowMillis() - _start_ms
end

@en "UptimeSeconds"
@fa "زمان فعالیت (ثانیه)"
@ar "مدة التشغیل (ثانیة)"
pub func UptimeSeconds(): f64: ret (UptimeMs() as f64) / 1000.0 end

@en "IsAsanBuild"
@fa "ساخت آسان"
@ar "بناء آسان"
pub func IsAsanBuild(): bool: if SALAM_ASAN: ret true else: ret false end end

@en "IsMemDebugBuild"
@fa "ساخت اشکال‌زدایی حافظه"
@ar "بناء تصحیح الذاکرة"
pub func IsMemDebugBuild(): bool: if SALAM_MEM_DEBUG: ret true else: ret false end end

@en "IsSafeBuild"
@fa "ساخت ایمن"
@ar "بناء آمن"
pub func IsSafeBuild(): bool: if SALAM_SAFE: ret true else: ret false end end

@en "BuildFlags"
@fa "پرچم‌های ساخت"
@ar "رایات البناء"
pub func BuildFlags(): str:
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    if IsSafeBuild(): parts.push("safe") end
    if IsMemDebugBuild(): parts.push("mem_debug") end
    if IsAsanBuild(): parts.push("asan") end
    if parts.len() == 0: ret "release" end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    repeat parts.len() with i:
        if i > 0: str.BufAppend(b, ",") end
        str.BufAppend(b, parts.get(i)[0])
    end
    ret str.BufStr(b)
end

@en "Summary"
@fa "خلاصه"
@ar "ملخص"
pub func Summary(): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, OS())
    str.BufAppend(b, "/")
    str.BufAppend(b, Arch())
    str.BufAppend(b, " cpus=")
    str.BufAppend(b, conv.FormatInt(CpuCount() as i64))
    str.BufAppend(b, " uptime_ms=")
    str.BufAppend(b, conv.FormatInt(UptimeMs()))
    str.BufAppend(b, " build=")
    str.BufAppend(b, BuildFlags())
    ret str.BufStr(b)
end
