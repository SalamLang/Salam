@en "sftpd"
@fa "سرور اس‌اف‌تی‌پی"
package sftpd

import str
import sshd

@en "Config"
@fa "پیکربندی"
pub struct Config:
    @en "host"
    @fa "میزبان"
    pub host: str = "0.0.0.0"
    @en "port"
    @fa "درگاه"
    pub port: int = 22
    @en "root"
    @fa "ریشه"
    pub root: str = "."
    @en "host_key_file"
    @fa "پرونده کلید میزبان"
    pub host_key_file: str = ""
    @en "users"
    @fa "کاربران"
    pub users: Vector<sshd.User> = Vector {} as Vector<sshd.User>
end

@en "Server"
@fa "سرور"
pub struct Server:
    @en "config"
    @fa "پیکربندی"
    pub config: Config = Config {}
    @en "ssh_server"
    @fa "سرور اس‌اس‌اچ"
    pub ssh_server: sshd.Server = sshd.Server {}
    @en "running"
    @fa "در حال اجرا"
    pub running: bool = false
end

@en "NewConfig"
@fa "پیکربندی نو"
pub func NewConfig(): Config:
    ret Config {}
end

@en "New"
@fa "جدید"
pub func New(cfg: Config): Server:
    mut s := Server {}
    s.config = cfg
    mut sc := sshd.NewConfig()
    sc.host = cfg.host
    sc.port = cfg.port
    sc.host_key_file = cfg.host_key_file
    sc.users = cfg.users
    s.ssh_server = sshd.New(sc)
    ret s
end

@en "Listen"
@fa "گوش دادن"
pub func Listen(srv &: Server): bool:
    ok := sshd.Listen(srv.ssh_server)
    srv.running = ok
    srv.config.port = sshd.Port(srv.ssh_server)
    ret ok
end

@en "Close"
@fa "بستن"
pub func Close(srv &: Server):
    srv.running = false
    sshd.Close(srv.ssh_server)
end

@en "Port"
@fa "درگاه"
pub func Port(srv: Server): int:
    ret srv.config.port
end

@en "ServeOnce"
@fa "یک‌بار خدمت"
pub func ServeOnce(srv &: Server): bool:
    if not srv.running: ret false end
    ret sshd.ServeOnce(srv.ssh_server)
end

@en "Serve"
@fa "خدمت"
pub func Serve(srv &: Server):
    srv.running = true
    sshd.Serve(srv.ssh_server)
    srv.running = false
end
