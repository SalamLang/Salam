package sort

@en "BubbleSort"
@fa "مرتب سازی حبابی"
pub func BubbleSort<T>(v: Vector<T>):
    n := v.Len()
    mut end_i := n - 1
    mut swapped := true
    until swapped:
        swapped = false
        repeat end_i in i:
            if v.Get(i + 1) < v.Get(i):
                Swap(v, i, i + 1)
                swapped = true
            end
        end
        end_i--
    end
end
