package sort

func _bucket_of(x: int, lo: int, span: i64, n: int): int:
    off := (x as i64) - (lo as i64)
    bi := off * (n as i64) / span
    if bi >= (n as i64): ret n - 1 end
    ret bi as int
end

@en "BucketSort"
@fa "مرتب سازی سطلی"
pub func BucketSort(v: Vector<int>):
    n := v.Len()
    if n < 2: ret end
    mut lo := v.Get(0)
    mut hi := lo
    mut i := 1
    until i < n:
        x := v.Get(i)
        if x < lo: lo = x end
        if hi < x: hi = x end
        i++
    end
    if lo == hi: ret end
    span := (hi as i64) - (lo as i64) + 1
    count := Vector {} as Vector<int> defer count.Free()
    mut b := 0
    until b <= n:
        count.Push(0)
        b++
    end
    i = 0
    until i < n:
        bi := _bucket_of(v.Get(i), lo, span, n)
        count.Set(bi, count.Get(bi) + 1)
        i++
    end
    mut s := 1
    until s <= n:
        count.Set(s, count.Get(s) + count.Get(s - 1))
        s++
    end
    starts := Vector {} as Vector<int> defer starts.Free()
    mut k := 0
    until k < n:
        if k == 0: starts.Push(0) else:
            starts.Push(count.Get(k - 1))
        end
        k++
    end
    cursor := Vector {} as Vector<int> defer cursor.Free()
    k = 0
    until k < n:
        cursor.Push(starts.Get(k))
        k++
    end
    out := Vector {} as Vector<int> defer out.Free()
    i = 0
    until i < n:
        out.Push(0)
        i++
    end
    i = 0
    until i < n:
        bi := _bucket_of(v.Get(i), lo, span, n)
        pos := cursor.Get(bi)
        out.Set(pos, v.Get(i))
        cursor.Set(bi, pos + 1)
        i++
    end
    k = 0
    until k < n:
        bstart := starts.Get(k)
        mut bend := n
        if k < n - 1: bend = starts.Get(k + 1) end
        if bend - bstart > 1:
            _insertion_range(out, bstart, bend - 1)
        end
        k++
    end
    i = 0
    until i < n:
        v.Set(i, out.Get(i))
        i++
    end
end
