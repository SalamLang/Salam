package sort

@en "CocktailSort"
@fa "مرتب سازی کوکتلی"
pub func CocktailSort<T>(v: Vector<T>):
    mut lo := 0
    mut hi := v.Len() - 1
    mut swapped := true
    until swapped:
        swapped = false
        mut i := lo
        until i < hi:
            if v.get(i + 1) < v.get(i):
                Swap(v, i, i + 1)
                swapped = true
            end
            i++
        end
        hi--
        mut j := hi
        until j > lo:
            if v.get(j) < v.get(j - 1):
                Swap(v, j, j - 1)
                swapped = true
            end
            j--
        end
        lo++
    end
end
