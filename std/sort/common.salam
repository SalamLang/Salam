package sort

func _insertion_range<T>(v: Vector<T>, lo: int, hi: int):
    mut i := lo + 1
    until i <= hi:
        key := v.Get(i)
        mut j := i - 1
        mut go := true
        until go:
            if j < lo:
                go = false
            else:
                if key < v.Get(j):
                    v.Set(j + 1, v.Get(j))
                    j--
                else:
                    go = false
                end
            end
        end
        v.Set(j + 1, key)
        i++
    end
end

func _partition<T>(v: Vector<T>, lo: int, hi: int): int: mid := lo + (hi - lo) / 2
    if v.Get(mid) < v.Get(lo): Swap(v, lo, mid) end
    if v.Get(hi) < v.Get(lo): Swap(v, lo, hi) end
    if v.Get(hi) < v.Get(mid): Swap(v, mid, hi) end
    Swap(v, mid, hi)
    pivot := v.Get(hi)
    mut i := lo - 1
    mut j := lo
    until j < hi:
        if v.Get(j) < pivot:
            i++
            Swap(v, i, j)
        end
        j++
    end
    Swap(v, i + 1, hi)
    ret i + 1
end

@en "Swap"
@fa "جابجایی"
pub func Swap<T>(v: Vector<T>, i: int, j: int):
    collections.Swap(v, i, j)
end
