package sort

@en "CountingSort"
@fa "مرتب سازی شمارشی"
pub func CountingSort(v: Vector<int>):
    n := v.Len()
    if n < 2: ret end
    mut lo := v.Get(0)
    mut hi := lo
    mut i := 1
    until i < n:
        x := v.Get(i)
        if x < lo: lo = x end
        if hi < x: hi = x end
        i++
    end
    range := hi - lo + 1
    count := Vector {} as Vector<int> defer count.Free()
    repeat range:
        count.Push(0)
    end
    i = 0
    until i < n:
        idx := v.Get(i) - lo
        count.Set(idx, count.Get(idx) + 1)
        i++
    end
    mut o := 0
    repeat range in k:
        mut cnt := count.Get(k)
        until cnt > 0:
            v.Set(o, lo + k)
            o++
            cnt--
        end
    end
end
