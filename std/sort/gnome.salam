package sort

@en "GnomeSort"
@fa "مرتب سازی حلزونی"
pub func GnomeSort<T>(v: Vector<T>):
    n := v.Len()
    mut i := 0
    until i < n:
        if i == 0:
            i = 1
        else:
            if v.Get(i) < v.Get(i - 1):
                Swap(v, i, i - 1)
                i--
            else:
                i++
            end
        end
    end
end
