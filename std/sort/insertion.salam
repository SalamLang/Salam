package sort

@en "InsertionSort"
@fa "مرتب سازی درجی"
pub func InsertionSort<T>(v: Vector<T>):
    if v.Len() < 2: ret end
    _insertion_range(v, 0, v.Len() - 1)
end

@en "BinaryInsertionSort"
@fa "مرتب سازی درجی دودویی"
pub func BinaryInsertionSort<T>(v: Vector<T>):
    n := v.Len()
    mut i := 1
    until i < n:
        key := v.Get(i)
        mut lo := 0
        mut hi := i
        until lo < hi:
            mid := lo + (hi - lo) / 2
            if key < v.Get(mid): hi = mid else:
                lo = mid + 1
            end
        end
        mut j := i
        until j > lo:
            v.Set(j, v.Get(j - 1))
            j--
        end
        v.Set(lo, key)
        i++
    end
end
