package sort

func _key_swap(idx &: Vector<int>, i: int, j: int):
    t := idx.get(i)
    idx.set(i, idx.get(j))
    idx.set(j, t)
end

func _key_insertion(idx &: Vector<int>, keys &: Vector<f64>, lo: int, hi: int):
    mut i := lo + 1
    until i <= hi:
        v := idx.get(i)
        kv := keys.get(v)
        mut j := i - 1
        until j >= lo && keys.get(idx.get(j)) > kv:
            idx.set(j + 1, idx.get(j))
            j -= 1
        end
        idx.set(j + 1, v)
        i += 1
    end
end

func _key_pivot(idx &: Vector<int>, keys &: Vector<f64>, lo: int, hi: int):
    mid := lo + (hi - lo) / 2
    if keys.get(idx.get(mid)) < keys.get(idx.get(lo)): _key_swap(idx, mid, lo) end
    if keys.get(idx.get(hi)) < keys.get(idx.get(lo)): _key_swap(idx, hi, lo) end
    if keys.get(idx.get(hi)) < keys.get(idx.get(mid)): _key_swap(idx, hi, mid) end
    _key_swap(idx, mid, lo)
end

func _key_quick(idx &: Vector<int>, keys &: Vector<f64>, lo0: int, hi0: int):
    mut lo := lo0
    mut hi := hi0
    until hi - lo > 12:
        _key_pivot(idx, keys, lo, hi)
        pivot := keys.get(idx.get(lo))
        mut lt := lo
        mut gt := hi
        mut i := lo
        until i <= gt:
            k := keys.get(idx.get(i))
            if k < pivot:
                _key_swap(idx, lt, i)
                lt += 1
                i += 1
            else k > pivot:
                _key_swap(idx, i, gt)
                gt -= 1
            else:
                i += 1
            end
        end
        if lt - lo < hi - gt:
            _key_quick(idx, keys, lo, lt - 1)
            lo = gt + 1
        else:
            _key_quick(idx, keys, gt + 1, hi)
            hi = lt - 1
        end
    end
    _key_insertion(idx, keys, lo, hi)
end

@en "SortIndex"
@fa "مرتب‌سازی نمایه"
pub func SortIndex(idx &: Vector<int>, keys &: Vector<f64>):
    n := idx.len()
    if n < 2: ret end
    _key_quick(idx, keys, 0, n - 1)
end

@en "SortIndexDesc"
@fa "مرتب‌سازی نمایه نزولی"
pub func SortIndexDesc(idx &: Vector<int>, keys &: Vector<f64>):
    n := idx.len()
    if n < 2: ret end
    _key_quick(idx, keys, 0, n - 1)
    mut i := 0
    mut j := n - 1
    until i < j:
        _key_swap(idx, i, j)
        i += 1
        j -= 1
    end
end
