package sort

func _merge_sort<T>(v: Vector<T>, buf: Vector<T>, lo: int, hi: int):
    if hi - lo < 1: ret end
    if hi - lo < 16:
        _insertion_range(v, lo, hi)
        ret
    end
    mid := lo + (hi - lo) / 2
    _merge_sort(v, buf, lo, mid)
    _merge_sort(v, buf, mid + 1, hi)
    if v.Get(mid) < v.Get(mid + 1): ret end
    if v.Get(mid + 1) < v.Get(mid):
        _merge(v, buf, lo, mid, hi)
    end
end

func _merge<T>(v: Vector<T>, buf: Vector<T>, lo: int, mid: int, hi: int):
    mut k := lo
    until k <= hi:
        buf.Set(k, v.Get(k))
        k++
    end
    mut i := lo
    mut j := mid + 1
    mut o := lo
    until o <= hi:
        if i > mid:
            v.Set(o, buf.Get(j))
            j++
        else:
            if j > hi:
                v.Set(o, buf.Get(i))
                i++
            else:
                if buf.Get(j) < buf.Get(i):
                    v.Set(o, buf.Get(j))
                    j++
                else:
                    v.Set(o, buf.Get(i))
                    i++
                end
            end
        end
        o++
    end
end

@en "MergeSort"
@fa "مرتب سازی ادغامی"
pub func MergeSort<T>(v: Vector<T>):
    n := v.Len()
    if n < 2: ret end
    mut buf := Vector {} as Vector<T> defer buf.Free()
    repeat n in i:
        buf.Push(v.Get(i))
    end
    _merge_sort(v, buf, 0, n - 1)
end
