package sort

@en "OddEvenSort"
@fa "مرتب سازی زوج فرد"
pub func OddEvenSort<T>(v: Vector<T>):
    n := v.Len()
    mut sorted := false
    until sorted == false:
        sorted = true
        mut i := 1
        until i < n - 1:
            if v.Get(i + 1) < v.Get(i):
                Swap(v, i, i + 1)
                sorted = false
            end
            i += 2
        end
        mut j := 0
        until j < n - 1:
            if v.Get(j + 1) < v.Get(j):
                Swap(v, j, j + 1)
                sorted = false
            end
            j += 2
        end
    end
end
