package sort

func _flip<T>(v: Vector<T>, k: int):
    mut a := 0
    mut b := k
    until a < b:
        Swap(v, a, b)
        a++
        b--
    end
end

@en "PancakeSort"
@fa "مرتب سازی پنکیکی"
pub func PancakeSort<T>(v: Vector<T>):
    mut sz := v.Len()
    until sz > 1:
        mut mi := 0
        mut i := 1
        until i < sz:
            if v.Get(mi) < v.Get(i): mi = i end
            i++
        end
        if mi != sz - 1:
            _flip(v, mi)
            _flip(v, sz - 1)
        end
        sz--
    end
end
