package sort

@en "RadixSort"
@fa "مرتب سازی مبنایی"
pub func RadixSort(v: Vector<int>):
    n := v.Len()
    if n < 2: ret end
    mut lo := v.Get(0) as i64
    mut i := 1
    until i < n:
        x := v.Get(i) as i64
        if x < lo: lo = x end
        i++
    end
    a := Vector {} as Vector<i64> defer a.Free()
    out := Vector {} as Vector<i64> defer out.Free()
    mut maxv := 0 as i64
    i = 0
    until i < n:
        d := (v.Get(i) as i64) - lo
        a.Push(d)
        out.Push(0)
        if maxv < d: maxv = d end
        i++
    end
    count := Vector {} as Vector<int> defer count.Free()
    repeat 256:
        count.Push(0)
    end
    mut exp := 1 as i64
    until maxv / exp > 0:
        repeat 256 in b:
            count.Set(b, 0)
        end
        i = 0
        until i < n:
            dig := ((a.Get(i) / exp) % 256) as int
            count.Set(dig, count.Get(dig) + 1)
            i++
        end
        repeat 1 to 255 in s:
            count.Set(s, count.Get(s) + count.Get(s - 1))
        end
        i = n - 1
        until i >= 0:
            dig := ((a.Get(i) / exp) % 256) as int
            count.Set(dig, count.Get(dig) - 1)
            out.Set(count.Get(dig), a.Get(i))
            i--
        end
        i = 0
        until i < n:
            a.Set(i, out.Get(i))
            i++
        end
        exp *= 256
    end
    i = 0
    until i < n:
        v.Set(i, (a.Get(i) + lo) as int)
        i++
    end
end
