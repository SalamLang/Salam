package sort

@en "SelectionSort"
@fa "مرتب سازی انتخابی"
pub func SelectionSort<T>(v: Vector<T>):
    n := v.Len()
    repeat n - 1 in i:
        mut m := i
        mut j := i + 1
        until j < n:
            if v.Get(j) < v.Get(m): m = j end
            j++
        end
        if m != i: Swap(v, i, m) end
    end
end
