package sort

@en "ShellSort"
@fa "مرتب سازی شل"
pub func ShellSort<T>(v: Vector<T>):
    n := v.Len()
    mut gap := 1
    until gap < n / 3: gap = gap * 3 + 1 end
    until gap >= 1:
        mut i := gap
        until i < n:
            key := v.Get(i)
            mut j := i
            mut go := true
            until go:
                if j >= gap:
                    if key < v.Get(j - gap):
                        v.Set(j, v.Get(j - gap))
                        j -= gap
                    else:
                        go = false
                    end
                else:
                    go = false
                end
            end
            v.Set(j, key)
            i++
        end
        gap /= 3
    end
end
