package sort

@en "IsSorted"
@fa "مرتب است"
pub func IsSorted<T>(v: Vector<T>): bool: mut i := 1
    until i < v.Len():
        if v.Get(i) < v.Get(i - 1): ret false end
        i++
    end
    ret true
end

@en "Reverse"
@fa "برعکس"
pub func Reverse<T>(v: Vector<T>):
    mut a := 0
    mut b := v.Len() - 1
    until a < b:
        Swap(v, a, b)
        a++
        b--
    end
end

@en "Min"
@fa "کمینه"
pub func Min<T>(v: Vector<T>): T: mut m := v.Get(0)
    mut i := 1
    until i < v.Len():
        if v.Get(i) < m: m = v.Get(i) end
        i++
    end
    ret m
end

@en "Max"
@fa "بیشینه"
pub func Max<T>(v: Vector<T>): T: mut m := v.Get(0)
    mut i := 1
    until i < v.Len():
        if m < v.Get(i): m = v.Get(i) end
        i++
    end
    ret m
end
