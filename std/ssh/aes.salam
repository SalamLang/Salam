package ssh

// AES-128/256 (FIPS 197) in CTR mode - "aes128-ctr" and "aes256-ctr", the
// cipher this package negotiates. Block cipher code is the same shape as
// std/tls/aes.salam (duplicated rather than imported - see ssh.salam's
// header on the package boundary); the CTR wrapper at the bottom is new.
//
// Only the forward direction is implemented: CTR mode builds a stream
// cipher out of AES-encrypt alone (both encryption and decryption XOR the
// plaintext/ciphertext with AES_encrypt(counter)), so there is no
// InvSubBytes/InvMixColumns to get wrong or carry as dead code.
//
// ==================== CONSTANT-TIME CAVEAT ====================
// SubBytes indexes a 256-byte S-box with key-dependent data, a cache-timing
// side channel on CPUs with data caches - the same caveat std/tls/aes.salam
// documents. Mitigated but not eliminated by using one 256-byte table.
// ================================================================

const AES_SBOX := [
    0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0
    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16
] as int[256]

const AES_RCON := [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36] as int[10]

struct Aes:
    // 60 words is the AES-256 worst case (15 round keys of 4 words).
    pub rk: u32[60] = [
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
    ]
    pub nr: int = 0
end

func _aes_subword(w: u32): u32:
    b0 := AES_SBOX[((w >> (24 as u32)) & (0xFF as u32)) as int] as u32
    b1 := AES_SBOX[((w >> (16 as u32)) & (0xFF as u32)) as int] as u32
    b2 := AES_SBOX[((w >> (8 as u32)) & (0xFF as u32)) as int] as u32
    b3 := AES_SBOX[(w & (0xFF as u32)) as int] as u32
    ret (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3
end

func _aes_rotword(w: u32): u32:
    ret (w << (8 as u32)) | (w >> (24 as u32))
end

// keylen must be 16 (AES-128) or 32 (AES-256). nr == 0 on anything else so
// callers can reject rather than silently key a weaker cipher.
func _aes_init(key: void*, keylen: int): Aes:
    mut a := Aes {}
    mut nk := 0
    if keylen == 16:
        nk = 4
        a.nr = 10
    else keylen == 32:
        nk = 8
        a.nr = 14
    else:
        a.nr = 0
        ret a
    end
    total := 4 * (a.nr + 1)
    repeat nk with i:
        o := i * 4
        a.rk[i] = ((_bget(key, o) as u32) << (24 as u32)) | ((_bget(key, o + 1) as u32) << (16 as u32)) | ((_bget(key, o + 2) as u32) << (8 as u32)) | (_bget(key, o + 3) as u32)
    end
    mut i := nk
    until i < total:
        mut t := a.rk[i - 1]
        if i % nk == 0:
            t = _aes_subword(_aes_rotword(t)) ^ ((AES_RCON[i / nk - 1] as u32) << (24 as u32))
        else nk > 6 && i % nk == 4:
            t = _aes_subword(t)
        end
        a.rk[i] = a.rk[i - nk] ^ t
        i += 1
    end
    ret a
end

// x * 2 in GF(2^8) with the AES reduction polynomial, branch-free so the
// conditional 0x1b never becomes a data-dependent jump.
inline func _xtime(a: int): int:
    r := a << 1
    ret (r ^ (((r >> 8) & 1) * 0x1b)) & 0xFF
end

func _aes_encrypt_block(a: Aes, inp: void*, out: void*):
    // state[r][c] with column-major words, as FIPS 197 defines them.
    mut s: int[16]
    repeat 16 with i:
        s[i] = _bget(inp, i)
    end

    // AddRoundKey(0)
    repeat 4 with c:
        k := a.rk[c]
        s[c * 4] = s[c * 4] ^ (((k >> (24 as u32)) & (0xFF as u32)) as int)
        s[c * 4 + 1] = s[c * 4 + 1] ^ (((k >> (16 as u32)) & (0xFF as u32)) as int)
        s[c * 4 + 2] = s[c * 4 + 2] ^ (((k >> (8 as u32)) & (0xFF as u32)) as int)
        s[c * 4 + 3] = s[c * 4 + 3] ^ ((k & (0xFF as u32)) as int)
    end

    mut round := 1
    until round < a.nr + 1:
        // SubBytes
        repeat 16 with i:
            s[i] = AES_SBOX[s[i]]
        end
        // ShiftRows: row r rotates left by r. Column-major bytes, so byte
        // (c,r) lives at s[c*4+r].
        mut t: int[16]
        repeat 4 with c:
            repeat 4 with r:
                t[c * 4 + r] = s[(((c + r) % 4) * 4) + r]
            end
        end
        repeat 16 with i:
            s[i] = t[i]
        end
        // MixColumns, skipped in the final round.
        if round < a.nr:
            repeat 4 with c:
                o := c * 4
                a0 := s[o]
                a1 := s[o + 1]
                a2 := s[o + 2]
                a3 := s[o + 3]
                x := a0 ^ a1 ^ a2 ^ a3
                s[o] = a0 ^ x ^ _xtime(a0 ^ a1)
                s[o + 1] = a1 ^ x ^ _xtime(a1 ^ a2)
                s[o + 2] = a2 ^ x ^ _xtime(a2 ^ a3)
                s[o + 3] = a3 ^ x ^ _xtime(a3 ^ a0)
            end
        end
        // AddRoundKey(round)
        repeat 4 with c:
            k := a.rk[round * 4 + c]
            s[c * 4] = s[c * 4] ^ (((k >> (24 as u32)) & (0xFF as u32)) as int)
            s[c * 4 + 1] = s[c * 4 + 1] ^ (((k >> (16 as u32)) & (0xFF as u32)) as int)
            s[c * 4 + 2] = s[c * 4 + 2] ^ (((k >> (8 as u32)) & (0xFF as u32)) as int)
            s[c * 4 + 3] = s[c * 4 + 3] ^ ((k & (0xFF as u32)) as int)
        end
        round += 1
    end

    repeat 16 with i:
        _bput(out, i, s[i])
    end
end

// ---------------------------------------------------------------- CTR mode
//
// RFC 4344 3.1 / SSH's aes*-ctr: the 16-byte IV is one big-endian counter,
// incremented as a whole (not per-word) after every block. Same operation
// encrypts and decrypts - XOR with AES_encrypt(counter) is its own inverse -
// so packet.salam calls this for both directions.

func _ctr_increment(block &: Buf):
    mut i := 15
    mut carry := true
    until i >= 0 && carry:
        v := (_bget(block.p, i) + 1) & 0xFF
        _bput(block.p, i, v)
        carry = v == 0
        i -= 1
    end
end

// Encrypts/decrypts `n` bytes from `data` into `out` (may alias `data`) as
// AES-CTR under key `a`, starting from and advancing `counter` (a 16-byte
// Buf the caller owns across calls, so a multi-packet stream keeps the
// counter going instead of restarting it - restarting per packet would
// reuse a keystream and break CTR's security).
func _aes_ctr_xor(a: Aes, counter &: Buf, data: void*, n: int, out: void*):
    mut ks := NewBuf(16)
    BufPutZeros(ks, 16)
    mut done := 0
    until done < n:
        _aes_encrypt_block(a, counter.p, ks.p)
        take := n - done < 16 ? n - done : 16
        repeat take with i:
            _bput(out, done + i, _bget(data, done + i) ^ _bget(ks.p, i))
        end
        _ctr_increment(counter)
        done += take
    end
    WipeBuf(ks)
end
