package ssh

import str

// The algorithm name-lists this client offers in KEXINIT (RFC 4253 7.1),
// in preference order. See ssh.salam's header for why each list is scoped
// the way it is (spanning both "recent OpenSSH" and "old but still
// running" servers with the smallest crypto surface that can do it).

const KEX_ALGORITHMS := "curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group14-sha256,diffie-hellman-group14-sha1"
const HOSTKEY_ALGORITHMS := "rsa-sha2-256,rsa-sha2-512,ssh-rsa"
const CIPHER_ALGORITHMS := "aes128-ctr,aes256-ctr"
const MAC_ALGORITHMS := "hmac-sha2-256,hmac-sha1"
const COMPRESSION_ALGORITHMS := "none"

const KEX_CURVE25519 := "curve25519-sha256"
const KEX_CURVE25519_LIBSSH := "curve25519-sha256@libssh.org"
const KEX_DH14_SHA256 := "diffie-hellman-group14-sha256"
const KEX_DH14_SHA1 := "diffie-hellman-group14-sha1"

const HOSTKEY_SSH_RSA := "ssh-rsa"
const HOSTKEY_RSA_SHA256 := "rsa-sha2-256"
const HOSTKEY_RSA_SHA512 := "rsa-sha2-512"

const CIPHER_AES128_CTR := "aes128-ctr"
const CIPHER_AES256_CTR := "aes256-ctr"

const MAC_HMAC_SHA256 := "hmac-sha2-256"
const MAC_HMAC_SHA1 := "hmac-sha1"

func _cipher_key_len(name: str): int:
    if str.Equals(name, CIPHER_AES256_CTR):
        ret 32
    end
    ret 16
end

func _cipher_iv_len(_name: str): int:
    ret 16
end

func _mac_kind_for(name: str): int:
    if str.Equals(name, MAC_HMAC_SHA256):
        ret MAC_SHA256
    end
    ret MAC_SHA1
end

func _mac_key_len(name: str): int:
    ret _mac_size(_mac_kind_for(name))
end

// Whether a KEX algorithm's exchange hash is computed with SHA-256 (true)
// or SHA-1 (false) - every KEX name this client offers ends in its hash
// function's name.
func _kex_uses_sha256(name: str): bool:
    ret !str.EndsWith(name, "sha1")
end

func _kex_is_curve25519(name: str): bool:
    ret str.Equals(name, KEX_CURVE25519) || str.Equals(name, KEX_CURVE25519_LIBSSH)
end
