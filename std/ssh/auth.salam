package ssh

// User authentication (RFC 4252): the "ssh-userauth" service, password and
// publickey methods. Both go through a shared request/response loop since
// the wire shape (USERAUTH_REQUEST in, SUCCESS/FAILURE out) is identical;
// only the method-specific fields inside the request differ.

const _AUTH_SERVICE := "ssh-connection"

func _auth_request_service(t &: Transport): bool:
    mut req := NewBuf(32)
    BufPutByte(req, SSH_MSG_SERVICE_REQUEST)
    BufPutStringStr(req, "ssh-userauth")
    if !_packet_send(t.ps, req):
        FreeBuf(req)
        ret false
    end
    FreeBuf(req)
    reply := _packet_recv(t.ps)
    if reply.bad:
        ret false
    end
    mut r := ReaderFromBuf(reply)
    msgtype := RGetByte(r)
    mut ok := false
    if !r.bad:
        if msgtype == SSH_MSG_SERVICE_ACCEPT:
            ok = true
        end
    end
    FreeBuf(reply)
    ret ok
end

// Sends one USERAUTH_REQUEST and classifies the single response that
// answers it. Banners (SSH_MSG_USERAUTH_BANNER) may arrive before the real
// answer and are skipped; anything else unexpected counts as failure.
func _auth_send_and_await(t &: Transport, req: Buf): bool:
    if !_packet_send(t.ps, req):
        ret false
    end
    mut attempts := 0
    until attempts < 5:
        reply := _packet_recv(t.ps)
        if reply.bad:
            ret false
        end
        mut r := ReaderFromBuf(reply)
        msgtype := RGetByte(r)
        if msgtype == SSH_MSG_USERAUTH_SUCCESS:
            FreeBuf(reply)
            ret true
        end
        if msgtype == SSH_MSG_USERAUTH_BANNER:
            FreeBuf(reply)
            attempts += 1
            continue
        end
        // FAILURE, PK_OK for a method we didn't probe for, or anything
        // else: this attempt did not succeed.
        FreeBuf(reply)
        ret false
    end
    ret false
end

@en "AuthPassword"
@fa "احراز هویت با رمز"
@ar "مصادقة بكلمة مرور"
func _auth_password(t &: Transport, user: str, password: str): bool:
    mut req := NewBuf(64 + user.len() + password.len())
    BufPutByte(req, SSH_MSG_USERAUTH_REQUEST)
    BufPutStringStr(req, user)
    BufPutStringStr(req, _AUTH_SERVICE)
    BufPutStringStr(req, "password")
    BufPutBool(req, false)
    BufPutStringStr(req, password)
    ok := _auth_send_and_await(t, req)
    FreeBuf(req)
    ret ok
end

func _auth_pubkey_blob(id: Identity): Buf:
    mut blob := NewBuf(16 + id.e.len + id.n.len)
    BufPutStringStr(blob, HOSTKEY_SSH_RSA)
    BufPutMpintBuf(blob, id.e)
    BufPutMpintBuf(blob, id.n)
    ret blob
end

// Builds and signs one publickey USERAUTH_REQUEST for signature algorithm
// `algo` ("ssh-rsa", "rsa-sha2-256" or "rsa-sha2-512" - RFC 8332), then
// sends it and reports whether the server accepted it.
func _auth_try_publickey(t &: Transport, user: str, id: Identity, algo: str): bool:
    mut blob := _auth_pubkey_blob(id)

    mut signed_data := NewBuf(64 + t.session_id.len + user.len() + blob.len)
    BufPutStringBuf(signed_data, t.session_id)
    BufPutByte(signed_data, SSH_MSG_USERAUTH_REQUEST)
    BufPutStringStr(signed_data, user)
    BufPutStringStr(signed_data, _AUTH_SERVICE)
    BufPutStringStr(signed_data, "publickey")
    BufPutBool(signed_data, true)
    BufPutStringStr(signed_data, algo)
    BufPutStringBuf(signed_data, blob)

    kind := _hostkey_digest_kind(algo)
    hlen := _rsa_hash_size(kind)
    mut digest := NewBuf(hlen)
    BufPutZeros(digest, hlen)
    _hash_for_kind(kind, signed_data.p, signed_data.len, digest.p)
    FreeBuf(signed_data)

    mut sigbytes := NewBuf(id.n.len)
    BufPutZeros(sigbytes, id.n.len)
    signed_ok := _rsa_sign_pkcs1(kind, digest.p, id.n, id.e, id.d, id.phi, sigbytes.p)
    FreeBuf(digest)
    if !signed_ok:
        FreeBuf(blob)
        FreeBuf(sigbytes)
        ret false
    end

    mut sigblob := NewBuf(16 + sigbytes.len)
    BufPutStringStr(sigblob, algo)
    BufPutStringBuf(sigblob, sigbytes)
    FreeBuf(sigbytes)

    mut req := NewBuf(64 + user.len() + blob.len + sigblob.len)
    BufPutByte(req, SSH_MSG_USERAUTH_REQUEST)
    BufPutStringStr(req, user)
    BufPutStringStr(req, _AUTH_SERVICE)
    BufPutStringStr(req, "publickey")
    BufPutBool(req, true)
    BufPutStringStr(req, algo)
    BufPutStringBuf(req, blob)
    BufPutStringBuf(req, sigblob)
    FreeBuf(blob)
    FreeBuf(sigblob)

    ok := _auth_send_and_await(t, req)
    FreeBuf(req)
    ret ok
end

// Tries rsa-sha2-256 first (what current OpenSSH - which disabled raw
// ssh-rsa/SHA-1 signatures by default in 8.8 - actually accepts), then
// falls back to the legacy "ssh-rsa" (SHA-1) name for servers old enough
// not to recognise rsa-sha2-*. Both attempts use the exact same RSA key;
// only the signature's hash and the algorithm name sent on the wire differ.
@en "AuthPublicKey"
@fa "احراز هویت با کلید عمومی"
@ar "مصادقة بمفتاح عام"
func _auth_publickey(t &: Transport, user: str, id: Identity): bool:
    if _auth_try_publickey(t, user, id, HOSTKEY_RSA_SHA256):
        ret true
    end
    ret _auth_try_publickey(t, user, id, HOSTKEY_SSH_RSA)
end
