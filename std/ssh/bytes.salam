package ssh

import mem
import str

mut _ssh_split_warmed := false

struct Buf:
    pub p: void* = null
    pub len: int = 0
    pub cap: int = 0
    pub bad: bool = false
end

struct Reader:
    pub p: void* = null
    pub len: int = 0
    pub pos: int = 0
    pub bad: bool = false
end

inline func _bget(p: void*, i: int): int:
    bp := p as u8*
    ret bp[i] as int
end

inline func _bput(p: void*, i: int, v: int):
    bp := p as u8*
    bp[i] = v as u8
end

func _buf_grow(b &: Buf, need: int):
    if b.bad:
        ret
    end
    if b.len + need <= b.cap:
        ret
    end
    mut nc := b.cap
    if nc < 32:
        nc = 32
    end
    until b.len + need > nc:
        nc *= 2
    end
    np := mem.Reallocate(b.p, nc as u64)
    if np == null:
        b.bad = true
        ret
    end
    b.p = np
    b.cap = nc
end

func _ensure_split_warm():
    if !_ssh_split_warmed:
        mut junk := "a,b,c".split(",")
        junk.free()
        _ssh_split_warmed = true
    end
end

@en "NewBuf"
@fa "بافر جدید"
pub func NewBuf(cap0: int): Buf:
    mut c := cap0
    if c < 32:
        c = 32
    end
    p := mem.Allocate(c as u64)
    mut b := Buf {}
    if p == null:
        b.bad = true
        ret b
    end
    b.p = p
    b.len = 0
    b.cap = c
    b.bad = false
    ret b
end

@en "FreeBuf"
@fa "آزادسازی بافر"
pub func FreeBuf(b &: Buf):
    if b.p != null:
        mem.Free(b.p)
    end
    b.p = null
    b.len = 0
    b.cap = 0
end

@en "WipeBuf"
@fa "پاک سازی بافر"
pub func WipeBuf(b &: Buf):
    if b.p != null && b.cap > 0:
        mem.Set(b.p, 0, b.cap as u64)
    end
    FreeBuf(b)
end

@en "BufPutByte"
@fa "افزودن بایت"
pub func BufPutByte(b &: Buf, v: int):
    _buf_grow(b, 1)
    if b.bad:
        ret
    end
    _bput(b.p, b.len, v)
    b.len += 1
end

@en "BufPutBytes"
@fa "افزودن بایت ها"
pub func BufPutBytes(b &: Buf, p: void*, n: int):
    if n <= 0:
        ret
    end
    _buf_grow(b, n)
    if b.bad:
        ret
    end
    mem.Copy((b.p as i64 + b.len) as void*, p, n as u64)
    b.len += n
end

@en "BufPutBuf"
@fa "افزودن بافر"
pub func BufPutBuf(b &: Buf, src: Buf):
    BufPutBytes(b, src.p, src.len)
end

@en "BufPutZeros"
@fa "افزودن صفرها"
pub func BufPutZeros(b &: Buf, n: int):
    if n <= 0:
        ret
    end
    _buf_grow(b, n)
    if b.bad:
        ret
    end
    mem.Set((b.p as i64 + b.len) as void*, 0, n as u64)
    b.len += n
end

@en "BufPutUint32"
@fa "افزودن یو۳۲"
pub func BufPutUint32(b &: Buf, v: u32):
    _buf_grow(b, 4)
    if b.bad:
        ret
    end
    _bput(b.p, b.len, ((v >> (24 as u32)) & (0xFF as u32)) as int)
    _bput(b.p, b.len + 1, ((v >> (16 as u32)) & (0xFF as u32)) as int)
    _bput(b.p, b.len + 2, ((v >> (8 as u32)) & (0xFF as u32)) as int)
    _bput(b.p, b.len + 3, (v & (0xFF as u32)) as int)
    b.len += 4
end

@en "BufPutUint64"
@fa "افزودن یو۶۴"
pub func BufPutUint64(b &: Buf, v: u64):
    _buf_grow(b, 8)
    if b.bad:
        ret
    end
    mut i := 0
    until i < 8:
        sh := ((7 - i) * 8) as u64
        _bput(b.p, b.len + i, ((v >> sh) & (0xFF as u64)) as int)
        i += 1
    end
    b.len += 8
end

@en "BufPutBool"
@fa "افزودن بولی"
pub func BufPutBool(b &: Buf, v: bool):
    if v:
        BufPutByte(b, 1)
    else:
        BufPutByte(b, 0)
    end
end

@en "BufPutString"
@fa "افزودن رشته"
pub func BufPutString(b &: Buf, p: void*, n: int):
    BufPutUint32(b, n as u32)
    BufPutBytes(b, p, n)
end

@en "BufPutStringBuf"
@fa "افزودن رشته بافر"
pub func BufPutStringBuf(b &: Buf, src: Buf):
    BufPutString(b, src.p, src.len)
end

@en "BufPutStringStr"
@fa "افزودن رشته متن"
pub func BufPutStringStr(b &: Buf, s: str):
    BufPutString(b, s as void*, s.len())
end

@en "BufPutMpintBytes"
@fa "افزودن ام پی اینت"
pub func BufPutMpintBytes(b &: Buf, p: void*, n: int):
    mut start := 0
    until start < n:
        if _bget(p, start) != 0:
            break
        end
        start += 1
    end
    mlen := n - start
    mut needpad := false
    if mlen > 0 && (_bget(p, start) & 0x80) != 0:
        needpad = true
    end
    if mlen == 0:
        BufPutUint32(b, 0 as u32)
        ret
    end
    mut extra := 0
    if needpad:
        extra = 1
    end
    BufPutUint32(b, (mlen + extra) as u32)
    if needpad:
        BufPutByte(b, 0)
    end
    BufPutBytes(b, (p as i64 + start) as void*, mlen)
end

@en "BufPutMpintBuf"
@fa "افزودن ام پی اینت بافر"
pub func BufPutMpintBuf(b &: Buf, src: Buf):
    BufPutMpintBytes(b, src.p, src.len)
end

@en "NewReader"
@fa "خواننده جدید"
pub func NewReader(p: void*, n: int): Reader:
    mut r := Reader {}
    r.p = p
    r.len = n
    r.pos = 0
    r.bad = false
    ret r
end

@en "ReaderFromBuf"
@fa "خواننده از بافر"
pub func ReaderFromBuf(b: Buf): Reader:
    ret NewReader(b.p, b.len)
end

@en "RRemaining"
@fa "باقی مانده"
pub func RRemaining(r: Reader): int:
    ret r.len - r.pos
end

@en "RGetByte"
@fa "دریافت بایت"
pub func RGetByte(r &: Reader): int:
    if r.bad || r.pos >= r.len:
        r.bad = true
        ret 0
    end
    v := _bget(r.p, r.pos)
    r.pos += 1
    ret v
end

@en "RGetBool"
@fa "دریافت بولی"
pub func RGetBool(r &: Reader): bool:
    ret RGetByte(r) != 0
end

@en "RSkip"
@fa "رد شدن"
pub func RSkip(r &: Reader, n: int):
    if r.bad || n < 0 || r.pos + n > r.len:
        r.bad = true
        ret
    end
    r.pos += n
end

@en "RGetUint32"
@fa "دریافت یو۳۲"
pub func RGetUint32(r &: Reader): u32:
    if r.bad || r.pos + 4 > r.len:
        r.bad = true
        ret 0
    end
    b0 := _bget(r.p, r.pos) as u32
    b1 := _bget(r.p, r.pos + 1) as u32
    b2 := _bget(r.p, r.pos + 2) as u32
    b3 := _bget(r.p, r.pos + 3) as u32
    r.pos += 4
    ret (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3
end

@en "RGetUint64"
@fa "دریافت یو۶۴"
pub func RGetUint64(r &: Reader): u64:
    if r.bad || r.pos + 8 > r.len:
        r.bad = true
        ret 0
    end
    mut v := 0 as u64
    mut i := 0
    until i < 8:
        v = (v << (8 as u64)) | (_bget(r.p, r.pos + i) as u64)
        i += 1
    end
    r.pos += 8
    ret v
end

@en "RGetStringView"
@fa "دریافت نمای رشته"
pub func RGetStringView(r &: Reader): Reader:
    n := RGetUint32(r) as int
    if r.bad || n < 0 || r.pos + n > r.len:
        r.bad = true
        ret NewReader(null, 0)
    end
    v := NewReader((r.p as i64 + r.pos) as void*, n)
    r.pos += n
    ret v
end

@en "RGetStringCopy"
@fa "کپی رشته"
pub func RGetStringCopy(r &: Reader): Buf:
    v := RGetStringView(r)
    if r.bad:
        ret NewBuf(1)
    end
    mut out := NewBuf(v.len)
    BufPutBytes(out, v.p, v.len)
    ret out
end

@en "RGetStringAsStr"
@fa "دریافت رشته متن"
pub func RGetStringAsStr(r &: Reader): str:
    v := RGetStringView(r)
    if r.bad || v.len == 0:
        ret ""
    end
    p := mem.Allocate((v.len + 1) as u64)
    defer mem.Free(p)
    mem.Copy(p, v.p, v.len as u64)
    _bput(p, v.len, 0)
    ret str.Clone(p as str)
end

@en "RGetMpintView"
@fa "خواندن ام پی اینت"
pub func RGetMpintView(r &: Reader): Reader:
    v := RGetStringView(r)
    if r.bad:
        ret v
    end
    if v.len > 0 && _bget(v.p, 0) == 0:
        ret NewReader((v.p as i64 + 1) as void*, v.len - 1)
    end
    ret v
end

@en "RGetMpintCopy"
@fa "کپی ام پی اینت"
pub func RGetMpintCopy(r &: Reader): Buf:
    v := RGetMpintView(r)
    if r.bad:
        ret NewBuf(1)
    end
    mut out := NewBuf(v.len)
    BufPutBytes(out, v.p, v.len)
    ret out
end

@en "RGetNameList"
@fa "دریافت لیست نام"
pub func RGetNameList(r &: Reader): str:
    ret RGetStringAsStr(r)
end

@en "NameListContains"
@fa "شامل لیست نام"
pub func NameListContains(list: str, name: str): bool:
    if list.len() == 0:
        ret false
    end
    _ensure_split_warm()
    parts := list.split(",")
    defer parts.free()
    mut found := false
    each p in parts:
        if str.Equals(p, name):
            found = true
        end
    end
    ret found
end

@en "NegotiateFirstMatch"
@fa "توافق اولین تطابق"
pub func NegotiateFirstMatch(mine: str, theirs: str): str:
    _ensure_split_warm()
    parts := mine.split(",")
    defer parts.free()
    mut result := ""
    each p in parts:
        if result.len() == 0 && NameListContains(theirs, p):
            result = p
        end
    end
    ret result
end

@en "ConstantTimeEqual"
@fa "برابری زمان ثابت"
pub func ConstantTimeEqual(a: void*, b: void*, n: int): bool:
    mut diff := 0
    repeat n with i:
        diff = diff | (_bget(a, i) ^ _bget(b, i))
    end
    ret diff == 0
end
