package ssh

import io

// Connection + credential configuration for Dial(). Build one with
// NewConfig, then attach exactly one credential with WithPassword or
// WithKeyFile/WithKeyPEM (the last one called wins if more than one is
// set) before calling Dial.

pub struct Config:
    pub host: str = ""
    pub port: int = 22
    pub user: str = ""
    pub password: str = ""
    pub use_password: bool = false
    pub key_pem: str = ""
    pub use_key: bool = false
    pub hostkey_mode: int = 1 // HOSTKEY_MODE_ACCEPT_NEW
    pub known_hosts_path: str = ""
end

@en "NewConfig"
@fa "پیکربندی جدید"
@ar "تكوين جديد"
pub func NewConfig(host: str, port: int, user: str): Config:
    mut cfg := Config {}
    cfg.host = host
    cfg.port = port
    cfg.user = user
    cfg.hostkey_mode = HOSTKEY_MODE_ACCEPT_NEW
    ret cfg
end

@en "WithPassword"
@fa "با رمز عبور"
@ar "بكلمة مرور"
pub func WithPassword(cfg &: Config, password: str):
    cfg.password = password
    cfg.use_password = true
    cfg.use_key = false
end

// Loads and holds a private key from a file path immediately (not lazily at
// Dial time) so a bad path/format is reported where the mistake was made.
@en "WithKeyFile"
@fa "با فایل کلید"
@ar "بملف المفتاح"
pub func WithKeyFile(cfg &: Config, path: str): bool:
    pem := io.ReadFile(path)
    if pem.len() == 0:
        ret false
    end
    cfg.key_pem = pem
    cfg.use_key = true
    cfg.use_password = false
    ret true
end

@en "WithKeyPEM"
@fa "با متن کلید"
@ar "بنص المفتاح"
pub func WithKeyPEM(cfg &: Config, pem: str):
    cfg.key_pem = pem
    cfg.use_key = true
    cfg.use_password = false
end

@en "WithHostKeyMode"
@fa "با حالت کلید میزبان"
@ar "بوضع مفتاح المضيف"
pub func WithHostKeyMode(cfg &: Config, mode: int):
    cfg.hostkey_mode = mode
end

@en "WithKnownHostsPath"
@fa "با مسیر میزبان های شناخته شده"
@ar "بمسار المضيفين المعروفين"
pub func WithKnownHostsPath(cfg &: Config, path: str):
    cfg.known_hosts_path = path
end
