package ssh

import crypto

const _DH14_P_HEX := ""

struct DH14KeyPair:
    pub secret: Buf = Buf {}
    pub public: Buf = Buf {}
end

func _dh14_prime(): Big:
    h := _hexbuf(_DH14_P_HEX)
    p := _big_from_bytes(h.p, h.len)
    FreeBuf(h)
    ret p
end

func _dh14_order(p: Big): Big:
    mut one := _big_new(1)
    _big_set_u32(one, 1 as u32)
    mut order := _big_new(p.n + 1)
    _ok := _big_sub(order, p, one)
    _big_free(one)
    ret order
end

func _dh14_generate(): DH14KeyPair:
    mut p := _dh14_prime()
    mut order := _dh14_order(p)

    mut xbytes := NewBuf(256)
    BufPutZeros(xbytes, 256)
    crypto.RandomBytes(xbytes.p, 256)
    _bput(xbytes.p, 0, _bget(xbytes.p, 0) & 0x7F)
    _bput(xbytes.p, 255, _bget(xbytes.p, 255) | 0x01)
    mut x := _big_from_bytes(xbytes.p, 256)

    mut g := _big_new(1)
    _big_set_u32(g, 2 as u32)

    mut rndmask := NewBuf(32)
    BufPutZeros(rndmask, 32)
    crypto.RandomBytes(rndmask.p, 32)

    mut e := _big_new(p.n + 1)
    _ok := _big_modexp_blinded_dh(e, g, x, order, p, rndmask.p, rndmask.len)

    mut kp := DH14KeyPair {}
    kp.secret = xbytes
    kp.public = NewBuf(_big_bytelen(e))
    BufPutZeros(kp.public, _big_bytelen(e))
    _tobytes_ok := _big_to_bytes(e, kp.public.p, kp.public.len)

    _big_free(p)
    _big_free(order)
    _big_free(x)
    _big_free(g)
    FreeBuf(rndmask)
    _big_free(e)
    ret kp
end

func _dh14_shared(secret_x: Buf, peer_public: Buf): Buf:
    mut p := _dh14_prime()
    mut order := _dh14_order(p)
    mut x := _big_from_bytes(secret_x.p, secret_x.len)
    mut f := _big_from_bytes(peer_public.p, peer_public.len)

    mut two := _big_new(1)
    _big_set_u32(two, 2 as u32)
    mut pm1 := _big_new(p.n + 1)
    mut one := _big_new(1)
    _big_set_u32(one, 1 as u32)
    _ok1 := _big_sub(pm1, p, one)
    bad := _big_cmp(f, two) < 0 || _big_cmp(f, pm1) >= 0
    _big_free(two)
    _big_free(pm1)
    _big_free(one)

    mut rndmask := NewBuf(32)
    BufPutZeros(rndmask, 32)
    crypto.RandomBytes(rndmask.p, 32)

    mut k := _big_new(p.n + 1)
    mut out := NewBuf(1)
    if !bad:
        _ok2 := _big_modexp_blinded_dh(k, f, x, order, p, rndmask.p, rndmask.len)
        FreeBuf(out)
        out = NewBuf(_big_bytelen(k))
        BufPutZeros(out, _big_bytelen(k))
        _tobytes_ok := _big_to_bytes(k, out.p, out.len)
    end

    _big_free(p)
    _big_free(order)
    _big_free(x)
    _big_free(f)
    FreeBuf(rndmask)
    _big_free(k)
    ret out
end
