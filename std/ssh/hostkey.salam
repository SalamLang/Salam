package ssh

import str
import crypto
import encoding

struct HostKey:
    pub ok: bool = false
    pub n: Buf = Buf {}
    pub e: Buf = Buf {}
    pub blob: Buf = Buf {}
end

func _hostkey_free(hk &: HostKey):
    FreeBuf(hk.n)
    FreeBuf(hk.e)
    FreeBuf(hk.blob)
    hk.ok = false
end

func _mpint_significant(b: Buf): int:
    mut i := 0
    until i < b.len and _bget(b.p, i) == 0:
        i += 1
    end
    ret b.len - i
end

func _hostkey_sane(e: Buf, n: Buf): bool:
    nlen := _mpint_significant(n)
    elen := _mpint_significant(e)
    if nlen < 128 or nlen > 2048 or elen < 1 or elen > 8:
        ret false
    end
    if (_bget(n.p, n.len - 1) & 1) == 0 or (_bget(e.p, e.len - 1) & 1) == 0:
        ret false
    end
    ret not (elen == 1 and _bget(e.p, e.len - 1) == 1)
end

func _hostkey_parse(raw: Buf): HostKey:
    mut r := ReaderFromBuf(raw)
    keytype := RGetStringAsStr(r)
    if r.bad or not str.Equals(keytype, "ssh-rsa"):
        ret HostKey {}
    end
    mut e := RGetMpintCopy(r)
    mut n := RGetMpintCopy(r)
    if r.bad:
        FreeBuf(e)
        FreeBuf(n)
        ret HostKey {}
    end
    if not _hostkey_sane(e, n):
        FreeBuf(e)
        FreeBuf(n)
        ret HostKey {}
    end
    mut hk := HostKey {}
    hk.n = n
    hk.e = e
    hk.blob = NewBuf(raw.len)
    BufPutBuf(hk.blob, raw)
    hk.ok = true
    ret hk
end

func _hostkey_digest_kind(sig_format: str): int:
    if str.Equals(sig_format, HOSTKEY_RSA_SHA256):
        ret SSH_HASH_SHA256
    end
    if str.Equals(sig_format, HOSTKEY_RSA_SHA512):
        ret SSH_HASH_SHA512
    end
    ret SSH_HASH_SHA1
end

func _hash_for_kind(kind: int, p: void*, n: int, out: void*):
    if kind == SSH_HASH_SHA1:
        crypto.Sha1Bytes(p, n, out)
        ret
    end
    if kind == SSH_HASH_SHA512:
        crypto.Sha512Bytes(p, n, out)
        ret
    end
    crypto.Sha256Bytes(p, n, out)
end

func _hostkey_verify(hk: HostKey, h: Buf, sig_blob: Buf): bool:
    if not hk.ok:
        ret false
    end
    mut r := ReaderFromBuf(sig_blob)
    sig_format := RGetStringAsStr(r)
    mut sig := RGetStringCopy(r)
    if r.bad or not (str.Equals(sig_format, HOSTKEY_SSH_RSA) or str.Equals(sig_format, HOSTKEY_RSA_SHA256) or str.Equals(sig_format, HOSTKEY_RSA_SHA512)):
        FreeBuf(sig)
        ret false
    end
    kind := _hostkey_digest_kind(sig_format)
    hlen := _rsa_hash_size(kind)
    mut digest := NewBuf(hlen)
    BufPutZeros(digest, hlen)
    _hash_for_kind(kind, h.p, h.len, digest.p)
    result := _rsa_verify_pkcs1(kind, digest.p, hk.n.p, hk.n.len, hk.e.p, hk.e.len, sig.p, sig.len)
    FreeBuf(sig)
    FreeBuf(digest)
    ret result
end

func _hostkey_fingerprint(hk: HostKey): str:
    mut d := NewBuf(32)
    BufPutZeros(d, 32)
    crypto.Sha256Bytes(hk.blob.p, hk.blob.len, d.p)
    b64 := encoding.Base64EncodeBytes(d.p, 32)
    FreeBuf(d)
    mut trimmed := b64
    until str.EndsWith(trimmed, "="):
        trimmed = trimmed.substr(0, trimmed.len() - 1)
    end
    ret "SHA256:" + trimmed
end
