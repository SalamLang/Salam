package ssh

import crypto

const KDF_IV_CTOS := 65 // 'A'
const KDF_IV_STOC := 66 // 'B'
const KDF_KEY_CTOS := 67 // 'C'
const KDF_KEY_STOC := 68 // 'D'
const KDF_MAC_CTOS := 69 // 'E'
const KDF_MAC_STOC := 70

func _kdf_hash(sha256: bool, p: void*, n: int, out: void*):
    if sha256:
        crypto.Sha256Bytes(p, n, out)
        ret
    end
    crypto.Sha1Bytes(p, n, out)
end

func _derive_key(sha256: bool, k_mpint: Buf, h: Buf, session_id: Buf, letter: int, needed_len: int): Buf:
    hlen := sha256 ? 32 : 20
    mut result := NewBuf(needed_len)

    mut hbuf := NewBuf(k_mpint.len + h.len + 1 + session_id.len)
    BufPutBuf(hbuf, k_mpint)
    BufPutBuf(hbuf, h)
    BufPutByte(hbuf, letter)
    BufPutBuf(hbuf, session_id)
    mut block := NewBuf(hlen)
    BufPutZeros(block, hlen)
    _kdf_hash(sha256, hbuf.p, hbuf.len, block.p)
    FreeBuf(hbuf)

    mut take := needed_len
    if take > hlen:
        take = hlen
    end
    BufPutBytes(result, block.p, take)
    FreeBuf(block)

    until result.len < needed_len:
        mut input2 := NewBuf(k_mpint.len + h.len + result.len)
        BufPutBuf(input2, k_mpint)
        BufPutBuf(input2, h)
        BufPutBytes(input2, result.p, result.len)
        mut block2 := NewBuf(hlen)
        BufPutZeros(block2, hlen)
        _kdf_hash(sha256, input2.p, input2.len, block2.p)
        FreeBuf(input2)
        mut take2 := needed_len - result.len
        if take2 > hlen:
            take2 = hlen
        end
        BufPutBytes(result, block2.p, take2)
        FreeBuf(block2)
    end
    ret result
end
