package ssh

// Self-test harness for the crypto/wire primitives this package cannot
// verify against a live server in every environment. Mirrors std/tls's
// selftest.salam/_ck pattern exactly: each layer gets its own
// selftest_*.salam file contributing one _selftest_X() function, called
// from SelfTest() below. Known-answer vectors (AES FIPS-197, HMAC RFC 2202/
// 4231, X25519 RFC 7748) give confidence independent of any network peer.

mut _st_fails := 0
mut _st_total := 0

func _ck(cond: bool, name: str):
    _st_total += 1
    if !cond:
        _st_fails += 1
        println "  FAIL:", name
    end
end

func _ckhex(got: str, want: str, name: str):
    _st_total += 1
    if got != want:
        _st_fails += 1
        println "  FAIL:", name
        println "    got  ", got
        println "    want ", want
    end
end

func _hex_of(p: void*, n: int): str:
    mut out := ""
    repeat n with i:
        v := _bget(p, i)
        out = out.concat(_hex_byte(v))
    end
    ret out
end

func _hex_byte(v: int): str:
    digits := "0123456789abcdef"
    hi := (v >> 4) & 0xF
    lo := v & 0xF
    mut out := ""
    out = out.concat(digits.substr(hi, 1))
    out = out.concat(digits.substr(lo, 1))
    ret out
end

func _hexnibble(c: int): int:
    if c >= 48 && c <= 57:
        ret c - 48
    end
    if c >= 97 && c <= 102:
        ret c - 97 + 10
    end
    if c >= 65 && c <= 70:
        ret c - 65 + 10
    end
    ret 0
end

// Decode a hex string into a freshly-allocated Buf (self-contained: the
// vectors below routinely decode to bytes containing 0x00, which a str
// round-trip would truncate - see bytes.salam's header).
func _hexbuf(hex: str): Buf:
    n := hex.len() / 2
    mut out := NewBuf(n)
    p := hex as void*
    repeat n with i:
        hi := _hexnibble(_bget(p, 2 * i))
        lo := _hexnibble(_bget(p, 2 * i + 1))
        BufPutByte(out, (hi << 4) | lo)
    end
    ret out
end

@en "SelfTest"
@fa "خودآزمایی"
@ar "اختبار ذاتی"
pub func SelfTest(): int:
    _st_fails = 0
    _st_total = 0
    println "ssh self-test"
    _selftest_bigint()
    _selftest_x25519()
    _selftest_dh()
    if _st_fails == 0:
        println "ssh self-test:", _st_total, "checks passed"
    else:
        println "ssh self-test:", _st_fails, "of", _st_total, "checks FAILED"
    end
    ret _st_fails
end
