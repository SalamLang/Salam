package ssh

// Self-tests for algorithms.salam's per-name lookups - the small dispatch
// functions that decide key/IV/MAC sizes and hash choice from the
// negotiated algorithm name string. Wrong here means a correctly-negotiated
// algorithm still gets the wrong key length derived for it (kdf.salam) or
// the wrong exchange-hash function used (transport.salam) - a class of bug
// that would only show up against a real server, never in isolation, which
// is exactly why these lookups get their own direct coverage.

func _selftest_algorithms():
    _ck(_cipher_key_len(CIPHER_AES128_CTR) == 16, "algorithms: aes128-ctr key length is 16 bytes")
    _ck(_cipher_key_len(CIPHER_AES256_CTR) == 32, "algorithms: aes256-ctr key length is 32 bytes")
    _ck(_cipher_iv_len(CIPHER_AES128_CTR) == 16, "algorithms: aes128-ctr IV length is 16 bytes")
    _ck(_cipher_iv_len(CIPHER_AES256_CTR) == 16, "algorithms: aes256-ctr IV length is 16 bytes")

    _ck(_mac_kind_for(MAC_HMAC_SHA256) == MAC_SHA256, "algorithms: hmac-sha2-256 maps to MAC_SHA256")
    _ck(_mac_kind_for(MAC_HMAC_SHA1) == MAC_SHA1, "algorithms: hmac-sha1 maps to MAC_SHA1")
    _ck(_mac_key_len(MAC_HMAC_SHA256) == 32, "algorithms: hmac-sha2-256 key length is 32 bytes")
    _ck(_mac_key_len(MAC_HMAC_SHA1) == 20, "algorithms: hmac-sha1 key length is 20 bytes")

    _ck(_kex_uses_sha256(KEX_CURVE25519), "algorithms: curve25519-sha256 uses SHA-256 for the exchange hash")
    _ck(_kex_uses_sha256(KEX_DH14_SHA256), "algorithms: diffie-hellman-group14-sha256 uses SHA-256")
    _ck(!_kex_uses_sha256(KEX_DH14_SHA1), "algorithms: diffie-hellman-group14-sha1 uses SHA-1, not SHA-256")

    _ck(_kex_is_curve25519(KEX_CURVE25519), "algorithms: curve25519-sha256 is recognized as curve25519")
    _ck(_kex_is_curve25519(KEX_CURVE25519_LIBSSH), "algorithms: the @libssh.org alias is also recognized as curve25519")
    _ck(!_kex_is_curve25519(KEX_DH14_SHA256), "algorithms: group14 is not misclassified as curve25519")
end
