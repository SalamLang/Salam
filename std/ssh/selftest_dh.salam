package ssh

func _selftest_dh():
    mut p := _dh14_prime()
    _ck(_big_bitlen(p) == 2048, "dh14: group prime is 2048 bits")
    _big_free(p)

    alice := _dh14_generate()
    bob := _dh14_generate()
    _ck(alice.public.len > 0, "dh14: alice public value generated")
    _ck(bob.public.len > 0, "dh14: bob public value generated")
    _ck(_hex_of(alice.public.p, alice.public.len) != _hex_of(bob.public.p, bob.public.len), "dh14: two keypairs are not identical")

    mut k_alice := _dh14_shared(alice.secret, bob.public)
    mut k_bob := _dh14_shared(bob.secret, alice.public)
    _ck(k_alice.len > 0, "dh14: alice computed a shared secret")
    _ck(k_bob.len > 0, "dh14: bob computed a shared secret")
    _ckhex(_hex_of(k_alice.p, k_alice.len), _hex_of(k_bob.p, k_bob.len), "dh14: shared secret agrees on both sides")

    // A degenerate peer value (0) must be rejected, not silently accepted.
    mut zero_peer := NewBuf(1)
    BufPutByte(zero_peer, 0)
    mut k_bad := _dh14_shared(alice.secret, zero_peer)
    _ck(k_bad.len == 0, "dh14: degenerate peer public value (0) rejected")

    FreeBuf(zero_peer)
    FreeBuf(k_bad)
    FreeBuf(k_alice)
    FreeBuf(k_bob)
    FreeBuf(alice.secret)
    FreeBuf(alice.public)
    FreeBuf(bob.secret)
    FreeBuf(bob.public)
end
