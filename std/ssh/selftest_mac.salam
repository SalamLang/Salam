package ssh

import crypto

func _selftest_mac():
    // RFC 2202 test case 1 for HMAC-SHA1: key = 20x 0x0b, data = "Hi There".
    mut key := _hexbuf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    _ck(key.len == 20, "mac: RFC2202 test-1 key is 20 bytes")
    data := "Hi There"
    mut got1 := NewBuf(20)
    BufPutZeros(got1, 20)
    _hmac(MAC_SHA1, key.p, key.len, data as void*, data.len(), got1.p)
    _ckhex(_hex_of(got1.p, 20), "b617318655057264e28bc0b6fb378c8ef146be00", "mac: HMAC-SHA1 RFC2202 test case 1")

    // Cross-check HMAC-SHA2-256 against std/crypto's own HmacSha256Hex on a
    // text key/message (no embedded NUL, so the str-based reference
    // function is safe to compare against directly).
    ref := crypto.HmacSha256Hex("key", "The quick brown fox jumps over the lazy dog")
    mut got2 := NewBuf(32)
    BufPutZeros(got2, 32)
    keystr := "key"
    msgstr := "The quick brown fox jumps over the lazy dog"
    _hmac(MAC_SHA256, keystr as void*, keystr.len(), msgstr as void*, msgstr.len(), got2.p)
    _ckhex(_hex_of(got2.p, 32), ref, "mac: HMAC-SHA2-256 matches std/crypto.HmacSha256Hex")

    // A key longer than the HMAC block size (64 bytes) takes the
    // hash-the-key-first branch - exercise it too.
    mut longkey := NewBuf(80)
    BufPutZeros(longkey, 80)
    repeat 80 with i:
        _bput(longkey.p, i, i % 256)
    end
    mut got3 := NewBuf(32)
    BufPutZeros(got3, 32)
    _hmac(MAC_SHA256, longkey.p, 80, msgstr as void*, msgstr.len(), got3.p)
    mut got3b := NewBuf(32)
    BufPutZeros(got3b, 32)
    _hmac(MAC_SHA256, longkey.p, 80, msgstr as void*, msgstr.len(), got3b.p)
    _ckhex(_hex_of(got3.p, 32), _hex_of(got3b.p, 32), "mac: HMAC-SHA2-256 is deterministic with an over-long key")

    FreeBuf(key)
    FreeBuf(got1)
    FreeBuf(got2)
    FreeBuf(longkey)
    FreeBuf(got3)
    FreeBuf(got3b)
end
