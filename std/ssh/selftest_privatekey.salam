func _pk_check(id: Identity, n_hex: str, e_hex: str, d_hex: str, phi_hex: str, label: str):
    _ck(id.ok, label + ": parses successfully")
    if !id.ok:
        ret
    end
    _ckhex(_hex_of(id.n.p, id.n.len), n_hex, label + ": modulus n matches the independent oracle")
    _ckhex(_hex_of(id.e.p, id.e.len), e_hex, label + ": public exponent e matches the independent oracle")
    _ckhex(_hex_of(id.d.p, id.d.len), d_hex, label + ": private exponent d matches the independent oracle")
    _ckhex(_hex_of(id.phi.p, id.phi.len), phi_hex, label + ": phi=(p-1)(q-1) matches the independent oracle")
end

func _selftest_privatekey():
    // ---------------------------------------------------------- PKCS#1 PEM
    id_pkcs1 := _load_identity_pem(_PK_K1_PKCS1_PEM)
    _pk_check(id_pkcs1, _PK_K1_N, _PK_K1_E, _PK_K1_D, _PK_K1_PHI, "privatekey: PKCS#1 PEM (K1)")
    mut id_pkcs1m := id_pkcs1
    _identity_free(id_pkcs1m)

    // ---------------------------------------------------------- PKCS#8 PEM
    id_pkcs8 := _load_identity_pem(_PK_K2_PKCS8_PEM)
    _pk_check(id_pkcs8, _PK_K2_N, _PK_K2_E, _PK_K2_D, _PK_K2_PHI, "privatekey: PKCS#8 PEM (K2)")
    mut id_pkcs8m := id_pkcs8
    _identity_free(id_pkcs8m)

    // ---------------------------------------------------------- OpenSSH container
    // Same underlying key as K1's PKCS#1 PEM above (see the file header) -
    // both parsers must agree on every field, including phi, which the
    // OpenSSH-format parser computes fresh from p/q rather than reusing a
    // stored phi (see _phi_from_pq).
    id_openssh := _load_identity_pem(_PK_K1_OPENSSH)
    _pk_check(id_openssh, _PK_K1_N, _PK_K1_E, _PK_K1_D, _PK_K1_PHI, "privatekey: OpenSSH container format (same key as K1)")
    mut id_opensshm := id_openssh
    _identity_free(id_opensshm)

    // ---------------------------------------------------------- file loading wrapper
    dir := os.TempDir()
    path := dir + "/salam_ssh_selftest_id_rsa"
    _wrote := io.WriteFile(path, _PK_K1_PKCS1_PEM)
    id_file := _load_identity_file(path)
    _pk_check(id_file, _PK_K1_N, _PK_K1_E, _PK_K1_D, _PK_K1_PHI, "privatekey: _load_identity_file reads PEM from disk")
    mut id_filem := id_file
    _identity_free(id_filem)
    _removed := os.Remove(path)

    nonexistent := _load_identity_file(dir + "/salam_ssh_selftest_id_rsa_missing")
    _ck(!nonexistent.ok, "privatekey: loading a nonexistent file fails cleanly, not a crash")

    // ---------------------------------------------------------- malformed input
    empty := _load_identity_pem("")
    _ck(!empty.ok, "privatekey: an empty string is rejected")

    garbage := _load_identity_pem("this is not a PEM file at all")
    _ck(!garbage.ok, "privatekey: non-PEM garbage is rejected")

    // A structurally-tagged OpenSSH block whose body is not valid base64 /
    // not the real magic - must fail the magic check, not crash reading
    // past a too-short decoded buffer.
    fakeopenssh := "-----BEGIN OPENSSH PRIVATE KEY-----\nQUJDRA==\n-----END OPENSSH PRIVATE KEY-----\n"
    fake := _load_identity_pem(fakeopenssh)
    _ck(!fake.ok, "privatekey: an OpenSSH-tagged block with a bad magic/body is rejected, not crashed on")

    // A PEM tag present but with corrupted base64 body (odd/garbled chars)
    // must also fail cleanly.
    badpem := "-----BEGIN RSA PRIVATE KEY-----\n!!!not-valid-base64!!!\n-----END RSA PRIVATE KEY-----\n"
    badid := _load_identity_pem(badpem)
    _ck(!badid.ok, "privatekey: a corrupted PKCS#1 PEM body is rejected, not crashed on")
end
