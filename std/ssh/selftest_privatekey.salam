package ssh

import str
import io
import os

// Self-tests for privatekey.salam's two supported on-disk key formats.
// Both test keys were generated with real tooling, not hand-crafted, so
// parsing them is a genuine interop check rather than a test of this
// package's own encoder decoding its own output:
//   - K1: `ssh-keygen -t rsa -b 1024`, then re-exported to traditional
//     PKCS#1 PEM with `ssh-keygen -p -m PEM`. Same key material also kept
//     in its ORIGINAL OpenSSH-container form (K1_OPENSSH) before that
//     conversion, so both parsers can be checked against one one key.
//   - K2: a second, independent key, exported to PKCS#8 PEM with
//     `ssh-keygen -p -m PKCS8` (the "-----BEGIN PRIVATE KEY-----" form,
//     distinct from K1's PKCS#1 "-----BEGIN RSA PRIVATE KEY-----").
// n/e/d/phi for both were independently extracted with Python's
// `cryptography` library (RSAPrivateNumbers), not derived from this
// package's own parser - an independent oracle, same approach as
// selftest_rsa.salam's _RSA_TV_* fixture.
// 1024-bit only to keep the self-test fast; see selftest_rsa.salam's note.

