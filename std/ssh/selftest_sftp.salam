package ssh

import crypto
import io
import os
import str

func _selftest_sftp():
    mut b0 := NewBuf(4)
    BufPutUint32(b0, 0 as u32)
    mut r0 := NewReader(b0.p, b0.len)
    info0 := _sftp_parse_attrs(r0)
    _ck(not r0.bad, "sftp attrs: flags=0 reads cleanly with nothing left to consume")
    _ck(info0.size == (0 as i64), "sftp attrs: flags=0 leaves size at its zero default")
    _ck(not info0.is_dir, "sftp attrs: flags=0 leaves is_dir at its false default")
    FreeBuf(b0)

    mut b1 := NewBuf(12)
    BufPutUint32(b1, SFTP_ATTR_SIZE as u32)
    BufPutUint64(b1, 123456 as u64)
    mut r1 := NewReader(b1.p, b1.len)
    info1 := _sftp_parse_attrs(r1)
    _ck(not r1.bad, "sftp attrs: SIZE-only decodes without error")
    _ck(info1.size == (123456 as i64), "sftp attrs: SIZE field value round-trips")
    FreeBuf(b1)

    mut b2 := NewBuf(8)
    BufPutUint32(b2, SFTP_ATTR_PERMISSIONS as u32)
    BufPutUint32(b2, 0x41ED as u32)
    mut r2 := NewReader(b2.p, b2.len)
    info2 := _sftp_parse_attrs(r2)
    _ck(info2.permissions == (0x41ED as u32), "sftp attrs: PERMISSIONS field value round-trips")
    _ck(info2.is_dir, "sftp attrs: S_IFDIR permission bits set is_dir")
    FreeBuf(b2)

    mut b3 := NewBuf(8)
    BufPutUint32(b3, SFTP_ATTR_PERMISSIONS as u32)
    BufPutUint32(b3, 0x81A4 as u32)
    mut r3 := NewReader(b3.p, b3.len)
    info3 := _sftp_parse_attrs(r3)
    _ck(not info3.is_dir, "sftp attrs: S_IFREG permission bits do NOT set is_dir")
    FreeBuf(b3)

    mut b4 := NewBuf(32)
    BufPutUint32(b4, 0x0000000F as u32)
    BufPutUint64(b4, 999 as u64)
    BufPutUint32(b4, 1000 as u32)
    BufPutUint32(b4, 1000 as u32)
    BufPutUint32(b4, 0x81A4 as u32)
    BufPutUint32(b4, 1700000000 as u32)
    BufPutUint32(b4, 1700000001 as u32)
    BufPutUint32(b4, 0xCAFEBABE as u32)
    mut r4 := NewReader(b4.p, b4.len)
    info4 := _sftp_parse_attrs(r4)
    _ck(not r4.bad, "sftp attrs: all four optional groups together decode without error")
    _ck(info4.size == (999 as i64), "sftp attrs: SIZE survives alongside UIDGID/PERMISSIONS/ACMODTIME")
    _ck(info4.permissions == (0x81A4 as u32), "sftp attrs: PERMISSIONS survives alongside the other groups")
    marker := RGetUint32(r4)
    _ck(not r4.bad and marker == (0xCAFEBABE as u32), "sftp attrs: the byte immediately after all four groups is read at the right offset")
    FreeBuf(b4)

    mut cf1 := NewBuf(8)
    repeat 8 in i:
        BufPutByte(cf1, i)
    end
    _buf_consume_front(cf1, 3)
    _ck(cf1.len == 5, "consume-front: dropping 3 of 8 bytes leaves len 5")
    _ckhex(_hex_of(cf1.p, 5), "0304050607", "consume-front: remaining bytes shift down correctly")
    FreeBuf(cf1)

    mut cf2 := NewBuf(4)
    repeat 4 in i:
        BufPutByte(cf2, i)
    end
    _buf_consume_front(cf2, 0)
    _ck(cf2.len == 4, "consume-front: n=0 is a no-op")
    FreeBuf(cf2)

    mut cf3 := NewBuf(4)
    repeat 4 in i:
        BufPutByte(cf3, i)
    end
    _buf_consume_front(cf3, 4)
    _ck(cf3.len == 0, "consume-front: consuming exactly len bytes empties the buffer")
    FreeBuf(cf3)

    mut cf4 := NewBuf(4)
    repeat 4 in i:
        BufPutByte(cf4, i)
    end
    _buf_consume_front(cf4, 100)
    _ck(cf4.len == 0, "consume-front: consuming more than len clamps to empty rather than going negative")
    FreeBuf(cf4)

    _selftest_sftp_jail()
end

func _selftest_sftp_jail_clean(base: str):
    each name in ["/root/dang", "/root/up", "/root/d", "/out/f.txt", "/out/new"]:
        _gone := os.Remove(base + name)
    end
    each name in ["/root/sub", "/root", "/out", ""]:
        _gone := os.Rmdir(base + name)
    end
end

func _selftest_sftp_jail():
    base := os.TempDir() + "/salam_ssh_selftest_jail_" + crypto.RandomHex(8)
    _ck(os.Mkdir(base) == 0, "sftp jail: a fresh test directory is created")
    _made_root := os.Mkdir(base + "/root")
    _made_sub := os.Mkdir(base + "/root/sub")
    _made_out := os.Mkdir(base + "/out")
    _wrote := io.WriteFile(base + "/out/f.txt", "outside")
    mut st := SftpSessionState {}
    st.root = os.RealPath(base + "/root")
    _ck(st.root.len() > 0, "sftp jail: the test root resolves")
    _ck(_sftp_inside(st, st.root + "/new.txt"), "sftp jail: a new file in the root is inside")
    _ck(_sftp_inside(st, st.root + "/sub"), "sftp jail: a directory in the root is inside")

    dang := _sftp_symlink(base + "/out/new", st.root + "/dang") == 0
    up := _sftp_symlink(base + "/out/f.txt", st.root + "/up") == 0
    dlink := _sftp_symlink(base + "/out", st.root + "/d") == 0
    _ck(SALAM_OS_WINDOWS or (dang and up and dlink), "sftp jail: test links are planted")
    _ck(not dang or not _sftp_inside(st, st.root + "/dang"), "sftp jail: a dangling link that points outside is refused")
    _ck(not up or not _sftp_inside(st, st.root + "/up"), "sftp jail: a link to a file outside is refused")
    _ck(not up or _sftp_entry_inside(st, st.root + "/up"), "sftp jail: the link entry itself can still be removed")
    _ck(not dlink or not _sftp_inside(st, st.root + "/d/x"), "sftp jail: a new file under a link to an outside directory is refused")
    _ck(not dlink or _sftp_link_target(st, st.root + "/d/l", "x").len() == 0, "sftp jail: no link is made inside an outside directory")
    _ck(not dlink or _sftp_link_target(st, st.root + "/l", "/d/f").len() == 0, "sftp jail: a target reached through a link to an outside directory is refused")
    _ck(not os.Exists(base + "/out/new"), "sftp jail: nothing was created outside the root")

    _ck(str.Equals(_sftp_link_target(st, st.root + "/sub/l", "../f"), "../f"), "sftp jail: a relative target stays relative")
    _ck(str.Equals(_sftp_link_target(st, st.root + "/l", "/sub/f"), "sub/f"), "sftp jail: an absolute target is taken from the root")
    _ck(str.Equals(_sftp_link_target(st, st.root + "/sub/l", "/f"), "../f"), "sftp jail: an absolute target from a subdirectory climbs to the root")
    _ck(_sftp_link_target(st, st.root + "/sub/l", "../../etc/passwd").len() == 0, "sftp jail: a relative target above the root is refused")
    _ck(_sftp_link_target(st, st.root + "/l", "/../f").len() == 0, "sftp jail: an absolute target above the root is refused")
    _selftest_sftp_jail_clean(base)
end
