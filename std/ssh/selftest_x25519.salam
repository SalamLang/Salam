package ssh

// Two 32-byte scalars built from an obviously-correct-length repeating
// pattern (16 bytes x2) rather than a hand-transcribed RFC 7748 constant -
// this environment has no way to double check a memorized hex vector
// byte-for-byte, and a single wrong nibble there would fail the test without
// saying anything about the implementation. What DOES say something about
// the implementation is ECDH's algebraic property: X25519(a, X25519(b, 9))
// must equal X25519(b, X25519(a, 9)) for ANY two scalars, which a broken
// field/ladder implementation could only satisfy by astronomical coincidence.
const _X25519_TV_A := "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc"
const _X25519_TV_B := "c9d6e3f0fd0a1724313e4b5865727f8c99a6b3c0cddae7f4010e1b2835424f5c"

func _selftest_x25519():
    mut alice_sk := _hexbuf(_X25519_TV_A)
    mut bob_sk := _hexbuf(_X25519_TV_B)
    _ck(alice_sk.len == 32, "x25519: test scalar A is 32 bytes")
    _ck(bob_sk.len == 32, "x25519: test scalar B is 32 bytes")

    mut alice_pk := NewBuf(32)
    BufPutZeros(alice_pk, 32)
    _x25519_base(alice_sk.p, alice_pk.p)

    mut bob_pk := NewBuf(32)
    BufPutZeros(bob_pk, 32)
    _x25519_base(bob_sk.p, bob_pk.p)

    // A base-point multiply must never collapse to zero for a well-formed
    // (post-clamping) scalar.
    mut apk_or := 0
    repeat 32 with i:
        apk_or = apk_or | _bget(alice_pk.p, i)
    end
    _ck(apk_or != 0, "x25519: base-point multiply is non-trivial")

    mut shared1 := NewBuf(32)
    BufPutZeros(shared1, 32)
    ok1 := _x25519_shared(alice_sk.p, bob_pk.p, shared1.p)

    mut shared2 := NewBuf(32)
    BufPutZeros(shared2, 32)
    ok2 := _x25519_shared(bob_sk.p, alice_pk.p, shared2.p)

    _ck(ok1 && ok2, "x25519: shared secret computed on both sides")
    _ckhex(_hex_of(shared1.p, 32), _hex_of(shared2.p, 32), "x25519: ECDH is commutative (Alice==Bob)")

    FreeBuf(alice_sk)
    FreeBuf(bob_sk)
    FreeBuf(alice_pk)
    FreeBuf(bob_pk)
    FreeBuf(shared1)
    FreeBuf(shared2)
end
