package ssh

import os
import mem
import str
import fs
import fs.dir
import filepath

// SFTP version 3 (draft-ietf-secsh-filexfer-02) file transfer, the version
// essentially every server still speaks (OpenSSH's sftp-server has offered
// v3 since 2001 and never moved past it, precisely so old and new clients
// alike can rely on it - which is exactly this package's own "old and new"
// brief). Runs over the "sftp" subsystem of an ordinary session channel:
// SFTP's own uint32-length-prefixed packets travel inside SSH_MSG_CHANNEL_
// DATA, so this file has to re-frame them out of the channel's byte stream
// itself (a CHANNEL_DATA message boundary has no relationship to an SFTP
// packet boundary - see _sftp_read_packet).
//
// One request in flight at a time (no pipelining) - simple and correct,
// and file transfer throughput here is dominated by AES-CTR/HMAC and the
// network round-trip, not by request pipelining.
//
// Local file I/O goes through fopen/fread/fwrite directly, not std/io's
// str-based WriteFile/ReadFile (a Salam str truncates at the first
// embedded 0x00 byte - see bytes.salam's header - which would silently
// corrupt any non-text file transferred through this). The extern
// declarations below duplicate names std/fs/fs.salam already declares -
// unavoidable, since fopen/fread/fwrite are what byte-safe file I/O is -
// and merely doing so, without importing fs, is enough to make the
// compiler mis-resolve fs.salam's own conditional extern blocks while
// checking for a conflict (a latent parser bug in that file, unrelated to
// this package: fs.salam compiles and runs correctly on its own, as
// confirmed separately - see this file's PR notes for the isolated repro).
// `import fs` plus one real call to it - not just the import - is the
// workaround: it forces fs.salam to resolve normally through the ordinary
// import path before anything here can trip the conflict check (see
// _fs_import_workaround below, called once from SftpOpen).

extern:
    func fopen(path: str, mode: str): void*
    func fclose(stream: void*): int
    func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
    func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
end

const SSH_FXP_INIT := 1
const SSH_FXP_VERSION := 2
const SSH_FXP_OPEN := 3
const SSH_FXP_CLOSE := 4
const SSH_FXP_READ := 5
const SSH_FXP_WRITE := 6
const SSH_FXP_LSTAT := 7
const SSH_FXP_FSTAT := 8
const SSH_FXP_OPENDIR := 11
const SSH_FXP_READDIR := 12
const SSH_FXP_REMOVE := 13
const SSH_FXP_MKDIR := 14
const SSH_FXP_RMDIR := 15
const SSH_FXP_REALPATH := 16
const SSH_FXP_STAT := 17
const SSH_FXP_RENAME := 18
const SSH_FXP_STATUS := 101
const SSH_FXP_HANDLE := 102
const SSH_FXP_DATA := 103
const SSH_FXP_NAME := 104
const SSH_FXP_ATTRS := 105

const SSH_FXF_READ := 0x00000001
const SSH_FXF_WRITE := 0x00000002
const SSH_FXF_CREAT := 0x00000008
const SSH_FXF_TRUNC := 0x00000010

const SSH_FX_OK := 0
const SSH_FX_EOF := 1

const SFTP_ATTR_SIZE := 0x00000001
const SFTP_ATTR_PERMISSIONS := 0x00000004

const _SFTP_CHUNK := 32768
const _RAW_IO_CHUNK := 65536

pub struct Sftp:
    pub ch: Channel = Channel {}
    pub ok: bool = false
    pub next_id: u32 = 1 as u32
end

pub struct SftpFileInfo:
    pub name: str = ""
    pub size: i64 = 0 as i64
    pub is_dir: bool = false
    pub permissions: u32 = 0 as u32
end

struct SftpPacket:
    pub msgtype: int = 0 - 1
    pub body: Reader = Reader {}
    pub bodybuf: Buf = Buf {}
    pub ok: bool = false
end

// See this file's header: importing fs is not enough by itself to dodge
// the extern-conflict parser bug in fs.salam - fs needs one genuine call
// through the normal import path too, before fopen/fread/fwrite below are
// declared. SftpOpen calls this once; the result is never otherwise used.
func _fs_import_workaround(): i64:
    ret fs.ModTime(".")
end

// Reads a whole file into memory via repeated chunked fread calls (no
// fseek/ftell dependency, since std/fs's own fseek/ftell would need the
// same import-workaround treatment for no benefit here - a plain read
// loop to EOF is all this needs).
func _read_file_bytes(path: str): Buf:
    stream := fopen(path, "rb")
    if stream == null:
        ret NewBuf(0)
    end
    mut contents := NewBuf(_RAW_IO_CHUNK)
    mut chunk := NewBuf(_RAW_IO_CHUNK)
    BufPutZeros(chunk, _RAW_IO_CHUNK)
    mut reading := true
    until reading:
        n_read := fread(chunk.p, 1 as u64, _RAW_IO_CHUNK as u64, stream)
        if n_read == (0 as u64):
            reading = false
        else:
            BufPutBytes(contents, chunk.p, n_read as int)
            if n_read < (_RAW_IO_CHUNK as u64):
                reading = false
            end
        end
    end
    FreeBuf(chunk)
    fclose(stream)
    ret contents
end

func _write_file_bytes(path: str, bytes: void*, n: int): bool:
    stream := fopen(path, "wb")
    if stream == null:
        ret false
    end
    written := fwrite(bytes, 1 as u64, n as u64, stream)
    fclose(stream)
    ret written == (n as u64)
end

func _sftp_alloc_id(sftp &: Sftp): u32:
    id := sftp.next_id
    sftp.next_id = sftp.next_id + (1 as u32)
    ret id
end

// Drops the first `n` bytes of `b`, shifting the remainder down - how
// _sftp_read_packet consumes one reassembled SFTP message out of the
// channel's stdout buffer without disturbing whatever arrived after it.
func _buf_consume_front(b &: Buf, n: int):
    if n <= 0:
        ret
    end
    if n >= b.len:
        b.len = 0
        ret
    end
    remaining := b.len - n
    mem.Copy(b.p, (b.p as i64 + n) as void*, remaining as u64)
    b.len = remaining
end

func _sftp_send(t &: Transport, sftp &: Sftp, msgtype: int, body: Buf): bool:
    mut pkt := NewBuf(5 + body.len)
    BufPutUint32(pkt, (1 + body.len) as u32)
    BufPutByte(pkt, msgtype)
    BufPutBuf(pkt, body)
    ok := _channel_write(t, sftp.ch, pkt.p, pkt.len)
    FreeBuf(pkt)
    ret ok
end

// Pumps channel steps until a full SFTP packet (length prefix + payload)
// is available in sftp.ch.stdout, then removes and returns it as a Reader
// positioned right after the packet's own type byte, plus that type byte.
func _sftp_read_packet(t &: Transport, sftp &: Sftp): SftpPacket:
    mut steps := 0
    until sftp.ch.stdout.len < 4 && steps < 200000:
        code := _channel_pump_step(t, sftp.ch)
        if code == (0 - 1) || code == 3:
            ret SftpPacket {}
        end
        steps += 1
    end
    if sftp.ch.stdout.len < 4:
        ret SftpPacket {}
    end
    // Length prefix counts the type byte plus the body, not itself.
    payload_len := ((_bget(sftp.ch.stdout.p, 0) as u32) << (24 as u32)) | ((_bget(sftp.ch.stdout.p, 1) as u32) << (16 as u32)) | ((_bget(sftp.ch.stdout.p, 2) as u32) << (8 as u32)) | (_bget(sftp.ch.stdout.p, 3) as u32)
    packet_len := 4 + (payload_len as int)
    until sftp.ch.stdout.len < packet_len && steps < 200000:
        code := _channel_pump_step(t, sftp.ch)
        if code == (0 - 1) || code == 3:
            ret SftpPacket {}
        end
        steps += 1
    end
    if sftp.ch.stdout.len < packet_len:
        ret SftpPacket {}
    end
    msgtype := _bget(sftp.ch.stdout.p, 4)
    mut body := NewBuf(payload_len as int - 1)
    BufPutBytes(body, (sftp.ch.stdout.p as i64 + 5) as void*, (payload_len as int) - 1)
    _buf_consume_front(sftp.ch.stdout, packet_len)

    mut pkt := SftpPacket {}
    pkt.msgtype = msgtype
    pkt.bodybuf = body
    pkt.body = ReaderFromBuf(body)
    pkt.ok = true
    ret pkt
end

func _sftp_expect_status_ok(t &: Transport, sftp &: Sftp): bool:
    pkt := _sftp_read_packet(t, sftp)
    if !pkt.ok:
        ret false
    end
    ok := pkt.msgtype == SSH_FXP_STATUS
    mut r := pkt.body
    _id := RGetUint32(r)
    code := RGetUint32(r)
    result := ok && !r.bad && code == (SSH_FX_OK as u32)
    FreeBuf(pkt.bodybuf)
    ret result
end

func _sftp_open_handle(t &: Transport, sftp &: Sftp, path: str, pflags: u32): Buf:
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(32 + path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, path)
    BufPutUint32(body, pflags)
    BufPutUint32(body, 0 as u32) // attrs flags = none
    ok := _sftp_send(t, sftp, SSH_FXP_OPEN, body)
    FreeBuf(body)
    if !ok:
        ret NewBuf(0)
    end
    pkt := _sftp_read_packet(t, sftp)
    if !pkt.ok || pkt.msgtype != SSH_FXP_HANDLE:
        FreeBuf(pkt.bodybuf)
        ret NewBuf(0)
    end
    mut r := pkt.body
    _rid := RGetUint32(r)
    handle := RGetStringCopy(r)
    FreeBuf(pkt.bodybuf)
    if r.bad:
        FreeBuf(handle)
        ret NewBuf(0)
    end
    ret handle
end

func _sftp_close_handle(t &: Transport, sftp &: Sftp, handle: Buf):
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(8 + handle.len)
    BufPutUint32(body, id)
    BufPutStringBuf(body, handle)
    _sent_ok := _sftp_send(t, sftp, SSH_FXP_CLOSE, body)
    FreeBuf(body)
    _status_ok := _sftp_expect_status_ok(t, sftp)
end

func _sftp_parse_attrs(r &: Reader): SftpFileInfo:
    mut info := SftpFileInfo {}
    flags := RGetUint32(r)
    if (flags & (SFTP_ATTR_SIZE as u32)) != (0 as u32):
        info.size = RGetUint64(r) as i64
    end
    if (flags & (0x00000002 as u32)) != (0 as u32): // UIDGID
        _uid := RGetUint32(r)
        _gid := RGetUint32(r)
    end
    if (flags & (SFTP_ATTR_PERMISSIONS as u32)) != (0 as u32):
        info.permissions = RGetUint32(r)
        // POSIX S_IFMT/S_IFDIR. Written in hex, not octal: Salam has no
        // bare-leading-zero octal literal syntax (only an explicit `0o`
        // prefix is octal - see compiler/lexer.salam's scan_number), so
        // the traditional C `0170000`/`0040000` spelling here previously
        // parsed as plain DECIMAL 170000/40000 and silently never matched
        // any real st_mode value, making is_dir always false.
        info.is_dir = (info.permissions & (0xF000 as u32)) == (0x4000 as u32)
    end
    if (flags & (0x00000008 as u32)) != (0 as u32): // ACMODTIME
        _atime := RGetUint32(r)
        _mtime := RGetUint32(r)
    end
    ret info
end

// ============================================================== public API

// Opens the "sftp" subsystem on a fresh channel and completes the
// INIT/VERSION exchange.
@en "SftpOpen"
@fa "باز کردن اس اف تی پی"
@ar "فتح sftp"
pub func SftpOpen(client &: Client): Sftp:
    _fs_workaround_probe := _fs_import_workaround()
    mut sftp := Sftp {}
    sftp.ch = _channel_open_session(client.transport)
    sftp.next_id = 1 as u32
    if !sftp.ch.open:
        ret sftp
    end
    mut extra := NewBuf(16)
    BufPutStringStr(extra, "sftp")
    if !_channel_send_request(client.transport, sftp.ch, "subsystem", true, extra):
        FreeBuf(extra)
        ret sftp
    end
    FreeBuf(extra)

    mut init_body := NewBuf(4)
    BufPutUint32(init_body, 3 as u32) // SFTP protocol version
    if !_sftp_send(client.transport, sftp, SSH_FXP_INIT, init_body):
        FreeBuf(init_body)
        ret sftp
    end
    FreeBuf(init_body)

    pkt := _sftp_read_packet(client.transport, sftp)
    if pkt.ok && pkt.msgtype == SSH_FXP_VERSION:
        sftp.ok = true
    end
    FreeBuf(pkt.bodybuf)
    ret sftp
end

@en "SftpClose"
@fa "بستن اس اف تی پی"
@ar "إغلاق sftp"
pub func SftpClose(client &: Client, sftp &: Sftp):
    _channel_send_eof(client.transport, sftp.ch)
    _channel_send_close(client.transport, sftp.ch)
    _channel_free(sftp.ch)
    sftp.ok = false
end

// Uploads local file `local_path` to `remote_path`, creating/truncating it.
@en "Upload"
@fa "بارگذاری"
@ar "رفع"
pub func Upload(client &: Client, sftp &: Sftp, local_path: str, remote_path: str): bool:
    if !os.Exists(local_path):
        ret false
    end
    handle := _sftp_open_handle(client.transport, sftp, remote_path, (SSH_FXF_WRITE | SSH_FXF_CREAT | SSH_FXF_TRUNC) as u32)
    if handle.len == 0:
        ret false
    end
    content := _read_file_bytes(local_path)
    total := content.len
    mut offset := 0 as u64
    mut ok := true
    mut sent := 0
    until sent < total && ok:
        mut chunk := total - sent
        if chunk > _SFTP_CHUNK:
            chunk = _SFTP_CHUNK
        end
        id := _sftp_alloc_id(sftp)
        mut body := NewBuf(24 + handle.len + chunk)
        BufPutUint32(body, id)
        BufPutStringBuf(body, handle)
        BufPutUint64(body, offset)
        BufPutString(body, (content.p as i64 + sent) as void*, chunk)
        ok = _sftp_send(client.transport, sftp, SSH_FXP_WRITE, body)
        FreeBuf(body)
        if ok:
            ok = _sftp_expect_status_ok(client.transport, sftp)
        end
        offset = offset + (chunk as u64)
        sent += chunk
    end
    _sftp_close_handle(client.transport, sftp, handle)
    FreeBuf(handle)
    FreeBuf(content)
    ret ok
end

// Downloads `remote_path` to local file `local_path`.
@en "Download"
@fa "دانلود"
@ar "تنزيل"
pub func Download(client &: Client, sftp &: Sftp, remote_path: str, local_path: str): bool:
    handle := _sftp_open_handle(client.transport, sftp, remote_path, SSH_FXF_READ as u32)
    if handle.len == 0:
        ret false
    end
    mut downloaded := NewBuf(_RAW_IO_CHUNK)
    mut offset := 0 as u64
    mut done := false
    mut ok := true
    until !done && ok:
        id := _sftp_alloc_id(sftp)
        mut body := NewBuf(20 + handle.len)
        BufPutUint32(body, id)
        BufPutStringBuf(body, handle)
        BufPutUint64(body, offset)
        BufPutUint32(body, _SFTP_CHUNK as u32)
        ok = _sftp_send(client.transport, sftp, SSH_FXP_READ, body)
        FreeBuf(body)
        if !ok:
            continue
        end
        pkt := _sftp_read_packet(client.transport, sftp)
        if !pkt.ok:
            ok = false
        else if pkt.msgtype == SSH_FXP_STATUS:
            mut r := pkt.body
            _rid := RGetUint32(r)
            _status_code := RGetUint32(r)
            done = true // SSH_FX_EOF (or any status here) ends the transfer
            FreeBuf(pkt.bodybuf)
        else if pkt.msgtype == SSH_FXP_DATA:
            mut r := pkt.body
            _rid := RGetUint32(r)
            data := RGetStringView(r)
            if r.bad:
                ok = false
            else:
                BufPutBytes(downloaded, data.p, data.len)
                offset = offset + (data.len as u64)
                if data.len == 0:
                    done = true
                end
            end
            FreeBuf(pkt.bodybuf)
        else:
            FreeBuf(pkt.bodybuf)
            ok = false
        end
    end
    _sftp_close_handle(client.transport, sftp, handle)
    FreeBuf(handle)
    if ok:
        ok = _write_file_bytes(local_path, downloaded.p, downloaded.len)
    end
    FreeBuf(downloaded)
    ret ok
end

@en "Mkdir"
@fa "ساخت پوشه"
@ar "إنشاء مجلد"
pub func Mkdir(client &: Client, sftp &: Sftp, path: str): bool:
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(32 + path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, path)
    BufPutUint32(body, 0 as u32)
    ok := _sftp_send(client.transport, sftp, SSH_FXP_MKDIR, body)
    FreeBuf(body)
    if !ok:
        ret false
    end
    ret _sftp_expect_status_ok(client.transport, sftp)
end

@en "Remove"
@fa "حذف"
@ar "إزالة"
pub func Remove(client &: Client, sftp &: Sftp, path: str): bool:
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(16 + path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, path)
    ok := _sftp_send(client.transport, sftp, SSH_FXP_REMOVE, body)
    FreeBuf(body)
    if !ok:
        ret false
    end
    ret _sftp_expect_status_ok(client.transport, sftp)
end

@en "Rmdir"
@fa "حذف پوشه"
@ar "إزالة مجلد"
pub func Rmdir(client &: Client, sftp &: Sftp, path: str): bool:
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(16 + path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, path)
    ok := _sftp_send(client.transport, sftp, SSH_FXP_RMDIR, body)
    FreeBuf(body)
    if !ok:
        ret false
    end
    ret _sftp_expect_status_ok(client.transport, sftp)
end

@en "Rename"
@fa "تغییر نام"
@ar "إعادة تسمية"
pub func Rename(client &: Client, sftp &: Sftp, old_path: str, new_path: str): bool:
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(32 + old_path.len() + new_path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, old_path)
    BufPutStringStr(body, new_path)
    ok := _sftp_send(client.transport, sftp, SSH_FXP_RENAME, body)
    FreeBuf(body)
    if !ok:
        ret false
    end
    ret _sftp_expect_status_ok(client.transport, sftp)
end

@en "Stat"
@fa "وضعیت"
@ar "حالة"
pub func Stat(client &: Client, sftp &: Sftp, path: str): SftpFileInfo:
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(16 + path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, path)
    ok := _sftp_send(client.transport, sftp, SSH_FXP_STAT, body)
    FreeBuf(body)
    if !ok:
        ret SftpFileInfo {}
    end
    pkt := _sftp_read_packet(client.transport, sftp)
    if !pkt.ok || pkt.msgtype != SSH_FXP_ATTRS:
        FreeBuf(pkt.bodybuf)
        ret SftpFileInfo {}
    end
    mut r := pkt.body
    _rid := RGetUint32(r)
    info := _sftp_parse_attrs(r)
    FreeBuf(pkt.bodybuf)
    info.name = path
    ret info
end

@en "Exists"
@fa "وجود دارد"
@ar "موجود"
pub func Exists(client &: Client, sftp &: Sftp, path: str): bool:
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(16 + path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, path)
    ok := _sftp_send(client.transport, sftp, SSH_FXP_STAT, body)
    FreeBuf(body)
    if !ok:
        ret false
    end
    pkt := _sftp_read_packet(client.transport, sftp)
    result := pkt.ok && pkt.msgtype == SSH_FXP_ATTRS
    FreeBuf(pkt.bodybuf)
    ret result
end

// Lists a directory's entries (excluding "." and "..").
@en "ListDir"
@fa "لیست پوشه"
@ar "قائمة المجلد"
pub func ListDir(client &: Client, sftp &: Sftp, path: str): Vector<SftpFileInfo>:
    mut entries := Vector {} as Vector<SftpFileInfo>
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(16 + path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, path)
    ok := _sftp_send(client.transport, sftp, SSH_FXP_OPENDIR, body)
    FreeBuf(body)
    if !ok:
        ret entries
    end
    open_pkt := _sftp_read_packet(client.transport, sftp)
    if !open_pkt.ok || open_pkt.msgtype != SSH_FXP_HANDLE:
        FreeBuf(open_pkt.bodybuf)
        ret entries
    end
    mut open_reader := open_pkt.body
    _open_rid := RGetUint32(open_reader)
    handle := RGetStringCopy(open_reader)
    FreeBuf(open_pkt.bodybuf)

    mut done := false
    until !done:
        read_id := _sftp_alloc_id(sftp)
        mut read_body := NewBuf(8 + handle.len)
        BufPutUint32(read_body, read_id)
        BufPutStringBuf(read_body, handle)
        read_ok := _sftp_send(client.transport, sftp, SSH_FXP_READDIR, read_body)
        FreeBuf(read_body)
        if !read_ok:
            done = true
            continue
        end
        pkt := _sftp_read_packet(client.transport, sftp)
        if !pkt.ok:
            done = true
            continue
        end
        if pkt.msgtype == SSH_FXP_STATUS:
            done = true
            FreeBuf(pkt.bodybuf)
            continue
        end
        if pkt.msgtype != SSH_FXP_NAME:
            done = true
            FreeBuf(pkt.bodybuf)
            continue
        end
        mut r := pkt.body
        _rid := RGetUint32(r)
        count := RGetUint32(r) as int
        repeat count:
            entry_name := RGetStringAsStr(r)
            _longname := RGetStringAsStr(r)
            info := _sftp_parse_attrs(r)
            if !str.Equals(entry_name, ".") && !str.Equals(entry_name, ".."):
                mut entry := info
                entry.name = entry_name
                entries.push(entry)
            end
        end
        FreeBuf(pkt.bodybuf)
    end

    _sftp_close_handle(client.transport, sftp, handle)
    FreeBuf(handle)
    ret entries
end

// SFTP has no opcode for any of the four below: the protocol works one
// path at a time, so a caller wanting a whole tree had to write the walk
// itself. These do it once, here.

@en "SftpMkdirAll"
@fa "ساخت مسیر کامل"
@ar "إنشاء المسار کاملا"
pub func MkdirAll(client &: Client, sftp &: Sftp, path: str): bool:
    parts := str.Split(path, "/")
    defer parts.free()
    absolute := path.len() > 0 && path.substr(0, 1) == "/"
    mut cur := ""
    each part in parts:
        if part.len() > 0:
            if cur.len() == 0:
                if absolute:
                    cur = "/" + part
                else:
                    cur = part
                end
            else:
                cur = cur + "/" + part
            end
            // An existing component is not a failure - that is the whole
            // difference from Mkdir - so the result is judged by what is
            // there afterwards, not by this call.
            if !Exists(client, sftp, cur):
                Mkdir(client, sftp, cur)
            end
        end
    end
    info := Stat(client, sftp, path)
    ret info.is_dir
end

// Removes `path` whatever it is: a file, or a directory and everything
// beneath it. Depth first, because a directory cannot be removed until
// it is empty.
@en "SftpRemoveAll"
@fa "حذف همه"
@ar "حذف الکل"
pub func RemoveAll(client &: Client, sftp &: Sftp, path: str): bool:
    // Lstat, not Stat: Stat follows the link, so a link to a directory
    // would be walked and its TARGET emptied before the link itself was
    // ever unlinked.
    info := Lstat(client, sftp, path)
    is_link := (info.permissions & (0xF000 as u32)) == (0xA000 as u32)
    if is_link || !info.is_dir:
        ret Remove(client, sftp, path)
    end
    entries := ListDir(client, sftp, path)
    defer entries.free()
    mut ok := true
    each e in entries:
        if e.name != "." && e.name != "..":
            child := path + "/" + e.name
            // ListDir's attrs come from the readdir response, which does
            // not follow links either, but re-checking keeps the decision
            // in one place.
            if e.is_dir && !IsLink(client, sftp, child):
                if !RemoveAll(client, sftp, child): ok = false end
            else:
                if !Remove(client, sftp, child): ok = false end
            end
        end
    end
    if !Rmdir(client, sftp, path): ok = false end
    ret ok
end

// Copies a whole remote directory into `local_path`, creating it and
// every subdirectory. Returns false if any one file failed, having still
// copied the others.
@en "SftpDownloadDir"
@fa "دریافت پوشه"
@ar "تنزیل مجلد"
pub func DownloadDir(client &: Client, sftp &: Sftp, remote_path: str, local_path: str): bool:
    dir.MkdirAll(local_path)
    entries := ListDir(client, sftp, remote_path)
    defer entries.free()
    mut ok := true
    each e in entries:
        // A name is joined onto a local path, so anything that is not one
        // ordinary component - "..", or something containing a separator -
        // could write outside local_path. Server-supplied, so dropped.
        if e.name != "." && e.name != ".." && e.name.find("/") < 0 && e.name.len() > 0:
            rchild := remote_path + "/" + e.name
            lchild := filepath.Join(local_path, e.name)
            if e.is_dir:
                if !DownloadDir(client, sftp, rchild, lchild): ok = false end
            else:
                if !Download(client, sftp, rchild, lchild): ok = false end
            end
        end
    end
    ret ok
end

// Copies a whole local directory to `remote_path`, creating it and every
// subdirectory.
@en "SftpUploadDir"
@fa "ارسال پوشه"
@ar "رفع مجلد"
pub func UploadDir(client &: Client, sftp &: Sftp, local_path: str, remote_path: str): bool:
    MkdirAll(client, sftp, remote_path)
    names := os.ListDir(local_path)
    defer names.free()
    mut ok := true
    each name in names:
        if name != "." && name != "..":
            lchild := filepath.Join(local_path, name)
            rchild := remote_path + "/" + name
            if os.IsDir(lchild):
                if !UploadDir(client, sftp, lchild, rchild): ok = false end
            else:
                if !Upload(client, sftp, lchild, rchild): ok = false end
            end
        end
    end
    ret ok
end

// Like Stat, but does not follow a symbolic link: it reports the link
// itself. SSH_FXP_STAT resolves the target, which makes a link to a
// directory indistinguishable from that directory - and anything that
// then recurses is walking the target's contents by mistake.
@en "SftpLstat"
@fa "وضعیت پیوند"
@ar "حالة الارتباط"
pub func Lstat(client &: Client, sftp &: Sftp, path: str): SftpFileInfo:
    id := _sftp_alloc_id(sftp)
    mut body := NewBuf(16 + path.len())
    BufPutUint32(body, id)
    BufPutStringStr(body, path)
    ok := _sftp_send(client.transport, sftp, SSH_FXP_LSTAT, body)
    FreeBuf(body)
    if !ok:
        ret SftpFileInfo {}
    end
    pkt := _sftp_read_packet(client.transport, sftp)
    if !pkt.ok || pkt.msgtype != SSH_FXP_ATTRS:
        FreeBuf(pkt.bodybuf)
        ret SftpFileInfo {}
    end
    mut r := pkt.body
    _rid := RGetUint32(r)
    mut info := _sftp_parse_attrs(r)
    FreeBuf(pkt.bodybuf)
    info.name = path
    ret info
end

// True when `path` is itself a symbolic link. POSIX S_IFLNK, in hex for
// the same reason _sftp_parse_attrs writes S_IFDIR that way.
@en "SftpIsLink"
@fa "پیوند است"
@ar "هل هو ارتباط"
pub func IsLink(client &: Client, sftp &: Sftp, path: str): bool:
    info := Lstat(client, sftp, path)
    ret (info.permissions & (0xF000 as u32)) == (0xA000 as u32)
end
