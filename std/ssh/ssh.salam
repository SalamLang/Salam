@en "ssh"
@fa "اس اس اچ"
@ar "اس اس اتش"
package ssh

// Native SSH-2 client for Salam: connect to any SSH server (old or new),
// authenticate with a password or a private key, run commands, stream a
// shell, and transfer files over SFTP.
//
// ============================ SECURITY STATUS ============================
// EXPERIMENTAL, like std/tls. This implementation has NOT had independent
// cryptographic review. Do not use it to protect real secrets in production
// until it has been audited.
// =========================================================================
//
// Protocol scope (RFC 4251-4254, RFC 8332):
//   key exchange   curve25519-sha256 (preferred) and
//                  diffie-hellman-group14-sha256 / -sha1 (wide legacy reach)
//   host/user keys RSA only: ssh-rsa (SHA-1) and rsa-sha2-256/512 (RFC 8332).
//                  ECDSA and Ed25519 keys are not yet supported - see
//                  hostkey.salam and privatekey.salam.
//   ciphers        aes128-ctr, aes256-ctr
//   MACs           hmac-sha2-256, hmac-sha1
//   compression    none only
//
// This range is chosen to span both ends of the "old and new server" ask:
// aes128/256-ctr and hmac-sha1/sha2-256 have been in OpenSSH since the
// mid-2000s and group14 since 2001, while curve25519-sha256 and
// rsa-sha2-256/512 are what current OpenSSH (which disabled raw ssh-rsa/
// SHA-1 signatures by default in 8.8) actually negotiates.
//
// Package layout (see each file's header for the detail):
//   bytes.salam        Buf/Reader byte primitives + SSH wire encoding
//   bigint.salam        arbitrary-precision integers (DH, RSA)
//   x25519.salam         Curve25519 ECDH
//   dhgroups.salam       classic Diffie-Hellman (group14) key exchange
//   aes.salam            AES-128/256 block cipher + CTR mode
//   mac.salam            HMAC-SHA1 / HMAC-SHA2-256
//   rsakey.salam         RSA sign (blinded) + verify, PKCS#1 v1.5
//   algorithms.salam     algorithm name constants + negotiation
//   kdf.salam            RFC 4253 7.2 session key derivation
//   privatekey.salam     load a user private key (PEM or OpenSSH format)
//   hostkey.salam        parse/verify/fingerprint a server host key
//   knownhosts.salam     known_hosts file handling
//   packet.salam         the SSH binary packet protocol
//   transport.salam      version exchange, key exchange, rekey-free session
//   auth.salam           userauth: password and publickey
//   channel.salam        SSH channels, window flow control, requests
//   session.salam        Exec/Start/Wait/ExitCode/Output - the command API
//   sftp.salam           file upload/download/list/mkdir/remove
//   config.salam         Config: host, port, user, credentials, policy
//   client.salam         Dial/Reconnect/Close/NewSession/RunCommand
//
// Quick start:
//   cfg := ssh.NewConfig("example.com", 22, "user")
//   ssh.WithPassword(cfg, "secret")               // or ssh.WithKeyFile(cfg, path)
//   client := ssh.Dial(cfg)
//   if ssh.Ok(client):
//       res := ssh.RunCommand(client, "uname -a")
//       println res.stdout, res.exit_code
//       ssh.Close(client)
//   end

@en "DefaultPort"
@fa "پورت پیش فرض"
@ar "المنفذ الافتراضي"
pub const DefaultPort := 22

@en "ClientVersion"
@fa "نسخه کلاینت"
@ar "إصدار العميل"
pub const ClientVersion := "SSH-2.0-Salam_1.0"
