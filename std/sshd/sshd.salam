@en "sshd"
@fa "سرور اس‌اس‌اچ"
package sshd

import str
import chan
import io
import mem
import net.tcp
import pool
import ssh
import fs

@en "DefaultVersion"
@fa "نسخه پیش فرض"
pub const DefaultVersion := "SSH-2.0-SalamServer_1.0"

@en "User"
@fa "کاربر"
pub struct User:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "password"
    @fa "گذرواژه"
    pub password: str = ""
    @en "home"
    @fa "خانه"
    pub home: str = "/"
end

@en "Config"
@fa "پیکربندی"
pub struct Config:
    @en "host"
    @fa "میزبان"
    pub host: str = "0.0.0.0"
    @en "port"
    @fa "درگاه"
    pub port: int = 22
    @en "server_version"
    @fa "نسخه سرور"
    pub server_version: str = DefaultVersion
    @en "host_key_file"
    @fa "پرونده کلید میزبان"
    pub host_key_file: str = ""
    @en "authorized_keys_file"
    @fa "پرونده کلیدهای مجاز"
    pub authorized_keys_file: str = ""
    @en "allow_password"
    @fa "اجازه گذرواژه"
    pub allow_password: bool = true
    @en "allow_publickey"
    @fa "اجازه کلید عمومی"
    pub allow_publickey: bool = true
    @en "root"
    @fa "ریشه"
    pub root: str = "."
    @en "allow_exec"
    @fa "اجازه اجرای فرمان"
    pub allow_exec: bool = true
    @en "allow_shell"
    @fa "اجازه پوسته"
    pub allow_shell: bool = true
    @en "allow_sftp"
    @fa "اجازه اس‌اف‌تی‌پی"
    pub allow_sftp: bool = true
    @en "banner"
    @fa "پیام خوش‌آمد"
    pub banner: str = ""
    @en "max_connections"
    @fa "بیشینه اتصال همزمان"
    pub max_connections: int = 64
    @en "login_grace_ms"
    @fa "مهلت ورود میلی‌ثانیه"
    pub login_grace_ms: int = 120000
    @en "users"
    @fa "کاربران"
    pub users: Vector<User> = Vector {} as Vector<User>
end

@en "Server"
@fa "سرور"
pub struct Server:
    @en "config"
    @fa "پیکربندی"
    pub config: Config = Config {}
    @en "listener"
    @fa "شنونده"
    pub listener: tcp.Server = tcp.Server {}
    @en "running"
    @fa "در حال اجرا"
    pub running: bool = false
    pub _host_key: str = ""
end

struct _Shared:
    pub config: Config = Config {}
    pub host_key: str = ""
    pub jobs: chan.Chan<i64> = chan.Chan {} as chan.Chan<i64>
    pub active: i64* = null
end

func _ssh_config(cfg: Config, host_key: str): ssh.ServerConfig:
    mut sc := ssh.ServerConfig {}
    sc.server_version = cfg.server_version
    sc.host_key_file = cfg.host_key_file
    sc.host_key_hex = host_key
    sc.authorized_keys_file = cfg.authorized_keys_file
    sc.allow_password = cfg.allow_password
    sc.allow_publickey = cfg.allow_publickey
    sc.enable_exec = cfg.allow_exec
    sc.enable_shell = cfg.allow_shell
    sc.enable_sftp = cfg.allow_sftp
    sc.root = cfg.root
    sc.banner = cfg.banner
    sc.login_grace_ms = cfg.login_grace_ms
    mut users := Vector {} as Vector<ssh.ServerUser>
    each u in cfg.users:
        users.push(ssh.ServerUser { name = u.name, password = u.password, home = u.home })
    end
    sc.users = users
    ret sc
end

func _serve_next(sh: _Shared*, jobs: chan.Chan<i64>):
    mut ok := false
    fd := jobs.Recv(ok)
    if ok:
        _served := ssh.ServeConnection(fd, _ssh_config(sh.config, sh.host_key))
        _left := atomic_add(sh.active, 0 - 1 as i64)
    end
end

@en "NewConfig"
@fa "پیکربندی نو"
pub func NewConfig(): Config:
    ret Config {}
end

@en "New"
@fa "جدید"
pub func New(cfg: Config): Server:
    mut s := Server {}
    s.config = cfg
    ret s
end

@en "Listen"
@fa "گوش دادن"
pub func Listen(srv &: Server): bool:
    srv._host_key = ""
    if srv.config.host_key_file.len() > 0:
        if not fs.Exists(srv.config.host_key_file):
            io.EPrintln("sshd: host key file not found: " + srv.config.host_key_file)
            srv.running = false
            ret false
        end
        if not ssh.HostKeyFileOk(srv.config.host_key_file):
            io.EPrintln("sshd: cannot load host key file (need an unencrypted OpenSSH ed25519 or RSA private key): " + srv.config.host_key_file)
            srv.running = false
            ret false
        end
    else:
        srv._host_key = ssh.NewHostKey()
    end
    srv.listener = tcp.BindOn(srv.config.host, srv.config.port)
    srv.running = tcp.Ok(srv.listener)
    if srv.running: srv.config.port = tcp.Port(srv.listener) end
    ret srv.running
end

@en "Close"
@fa "بستن"
pub func Close(srv &: Server):
    srv.running = false
    tcp.CloseServer(srv.listener)
end

@en "Port"
@fa "درگاه"
pub func Port(srv: Server): int:
    ret srv.config.port
end

@en "AddUser"
@fa "افزودن کاربر"
pub func AddUser(cfg &: Config, name: str, password: str, home: str = "/"):
    mut u := User {}
    u.name = name
    u.password = password
    u.home = home
    cfg.users.push(u)
end

@en "ServeOnce"
@fa "یک‌بار خدمت"
pub func ServeOnce(srv &: Server): bool:
    if not tcp.Ok(srv.listener): ret false end
    conn := tcp.Accept(srv.listener)
    if not tcp.ConnOk(conn): ret false end
    _served := ssh.ServeConnection(conn.fd, _ssh_config(srv.config, srv._host_key))
    ret true
end

@en "Serve"
@fa "خدمت"
pub func Serve(srv &: Server):
    srv.running = true
    mut cap := srv.config.max_connections
    if cap < 1:
        cap = 1
    end
    sh := mem.AllocateZeroed(sizeof(_Shared) as u64) as _Shared*
    sh.config = srv.config
    sh.host_key = srv._host_key
    sh.jobs = chan.Chan {} as chan.Chan<i64>
    sh.jobs.Init(cap as i64)
    sh.active = mem.AllocateZeroed(8 as u64) as i64*
    jobs := sh.jobs
    workers := pool.NewElastic(1 as i64, cap as i64, cap as i64)
    task := (): _serve_next(sh, jobs) end
    until srv.running:
        if not tcp.Ok(srv.listener):
            srv.running = false
            break
        end
        conn := tcp.Accept(srv.listener)
        if not tcp.ConnOk(conn):
            continue
        end
        if not srv.running or atomic_load(sh.active) >= (cap as i64):
            tcp.Close(conn)
            continue
        end
        _taken := atomic_add(sh.active, 1 as i64)
        _queued := jobs.Send(conn.fd)
        _submitted := pool.Submit(workers, task)
    end
    pool.Stop(workers)
    jobs.Close()
    jobs.Free()
    mem.Free(sh.active as void*)
    mem.Free(sh as void*)
end
