@en "sshd"
@fa "سرور اس‌اس‌اچ"
package sshd

import str
import net.tcp
import ssh

@en "User"
@fa "کاربر"
pub struct User:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "password"
    @fa "گذرواژه"
    pub password: str = ""
    @en "home"
    @fa "خانه"
    pub home: str = "/"
end

@en "Config"
@fa "پیکربندی"
pub struct Config:
    @en "host"
    @fa "میزبان"
    pub host: str = "0.0.0.0"
    @en "port"
    @fa "درگاه"
    pub port: int = 22
    @en "server_version"
    @fa "نسخه سرور"
    pub server_version: str = ssh.ClientVersion
    @en "host_key_file"
    @fa "پرونده کلید میزبان"
    pub host_key_file: str = ""
    @en "authorized_keys_file"
    @fa "پرونده کلیدهای مجاز"
    pub authorized_keys_file: str = ""
    @en "allow_password"
    @fa "اجازه گذرواژه"
    pub allow_password: bool = true
    @en "allow_publickey"
    @fa "اجازه کلید عمومی"
    pub allow_publickey: bool = true
    @en "users"
    @fa "کاربران"
    pub users: Vector<User> = Vector {} as Vector<User>
end

@en "Server"
@fa "سرور"
pub struct Server:
    @en "config"
    @fa "پیکربندی"
    pub config: Config = Config {}
    @en "listener"
    @fa "شنونده"
    pub listener: tcp.Server = tcp.Server {}
    @en "running"
    @fa "در حال اجرا"
    pub running: bool = false
end

@en "NewConfig"
@fa "پیکربندی نو"
pub func NewConfig(): Config:
    ret Config {}
end

@en "New"
@fa "جدید"
pub func New(cfg: Config): Server:
    mut s := Server {}
    s.config = cfg
    ret s
end

@en "Listen"
@fa "گوش دادن"
pub func Listen(srv &: Server): bool:
    srv.listener = tcp.BindOn(srv.config.host, srv.config.port)
    srv.running = tcp.Ok(srv.listener)
    if srv.running: srv.config.port = tcp.Port(srv.listener) end
    ret srv.running
end

@en "Close"
@fa "بستن"
pub func Close(srv &: Server):
    srv.running = false
    tcp.CloseServer(srv.listener)
end

@en "Port"
@fa "درگاه"
pub func Port(srv: Server): int:
    ret srv.config.port
end

@en "AddUser"
@fa "افزودن کاربر"
pub func AddUser(cfg &: Config, name: str, password: str, home: str = "/"):
    mut u := User {}
    u.name = name
    u.password = password
    u.home = home
    cfg.users.push(u)
end

@en "ServeOnce"
@fa "یک‌بار خدمت"
pub func ServeOnce(srv &: Server): bool:
    if not tcp.Ok(srv.listener): ret false end
    conn := tcp.Accept(srv.listener)
    if not tcp.ConnOk(conn): ret false end
    // Initial scaffold: SSH server protocol handling (key exchange, auth, channels)
    // will be implemented in follow-up iterations.
    tcp.Close(conn)
    ret true
end

@en "Serve"
@fa "خدمت"
pub func Serve(srv &: Server):
    srv.running = true
    until not srv.running:
        conn := tcp.Accept(srv.listener)
        if tcp.ConnOk(conn):
            tcp.Close(conn)
        end
    end
end
