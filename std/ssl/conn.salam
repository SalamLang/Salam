package ssl

@en "Wrap"
@fa "پوشاندن"
pub func Wrap(ctx: Context, fd: i64): Conn:
    if ctx.handle == null or fd < 0:
        ret Conn { handle = null }
    end
    s := mem.AllocateZeroed(sizeof(_Session) as u64) as _Session*
    s[0] = _Session {}
    s[0].ctx = ctx.handle
    s[0].fd = fd
    ret Conn { handle = s as void* }
end

@en "ConnOk"
@fa "اتصال معتبر"
pub func ConnOk(c: Conn): bool:
    ret c.handle != null
end

@en "Connect"
@fa "اتصال برقرار کردن"
pub func Connect(c: Conn): bool:
    if c.handle == null:
        ret false
    end
    s := _session_of(c)
    if s[0].attached:
        ret s[0].live
    end
    cx := s[0].ctx as _Ctx*
    if cx[0].server:
        ret _fail(s, "Connect needs a client context")
    end
    mut cfg := tls.NewConfig(s[0].host)
    cfg.ca_file = cx[0].ca_file
    cfg.insecure_skip_verify = cx[0].verify == VERIFY_NONE
    if not cfg.insecure_skip_verify and s[0].host.len() == 0:
        ret _fail(s, "call SetHostname before Connect so the peer certificate can be checked")
    end
    s[0].conn = tls.WrapClient(s[0].fd, cfg)
    if not _finish(s):
        ret false
    end
    if cfg.insecure_skip_verify:
        s[0].verify_result = _VERIFY_SKIPPED
    else:
        s[0].verify_result = CERT_OK
    end
    ret true
end

@en "Accept"
@fa "پذیرش"
pub func Accept(c: Conn): bool:
    if c.handle == null:
        ret false
    end
    s := _session_of(c)
    if s[0].attached:
        ret s[0].live
    end
    cx := s[0].ctx as _Ctx*
    if not cx[0].server:
        ret _fail(s, "Accept needs a server context")
    end
    s[0].conn = tls.WrapServer(s[0].fd, cx[0].scfg)
    if not _finish(s):
        ret false
    end
    s[0].verify_result = CERT_OK
    ret true
end

@en "Read"
@fa "خواندن"
pub func Read(c: Conn, max: int): str:
    if c.handle == null or max <= 0:
        ret ""
    end
    s := _session_of(c)
    if not s[0].live:
        ret ""
    end
    ret tls.Read(s[0].conn, max)
end

@en "Write"
@fa "نوشتن"
pub func Write(c: Conn, data: str): int:
    if c.handle == null:
        ret 0
    end
    s := _session_of(c)
    if not s[0].live:
        ret 0
    end
    ret tls.Write(s[0].conn, data)
end

@en "Shutdown"
@fa "خاموش‌ کردن"
pub func Shutdown(c: Conn):
    if c.handle == null:
        ret
    end
    s := _session_of(c)
    if s[0].live:
        s[0].closed = true
    end
    _release(s)
end

@en "Close"
@fa "بستن"
pub func Close(c: Conn):
    if c.handle == null:
        ret
    end
    _release(_session_of(c))
    mem.Free(c.handle)
end
