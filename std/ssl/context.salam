package ssl

func _new_ctx(server: bool): Context:
    p := mem.AllocateZeroed(sizeof(_Ctx) as u64) as _Ctx*
    p[0] = _Ctx {}
    p[0].server = server
    ret Context { handle = p as void* }
end

@en "NewClientContext"
@fa "زمینه جدید مشتری"
pub func NewClientContext(): Context:
    ret _new_ctx(false)
end

@en "NewServerContext"
@fa "زمینه جدید سرور"
pub func NewServerContext(cert_file: str, key_file: str): Context:
    mut scfg := tls.NewServerConfig(cert_file, key_file)
    if not scfg.ok:
        tls.FreeRoots(scfg.chain)
        tls.FreePrivateKey(scfg.key)
        _last_error = "could not load the certificate or key file"
        ret Context { handle = null }
    end
    ctx := _new_ctx(true)
    p := _ctx_of(ctx)
    p[0].scfg = scfg
    ret ctx
end

@en "CtxOk"
@fa "زمینه معتبر"
pub func CtxOk(ctx: Context): bool:
    ret ctx.handle != null
end

@en "SetVerify"
@fa "تنظیم تایید"
pub func SetVerify(ctx: Context, mode: int):
    if ctx.handle == null:
        ret
    end
    p := _ctx_of(ctx)
    p[0].verify = mode
end

@en "LoadVerifyLocationsFile"
@fa "بارگذاری مکان تایید"
pub func LoadVerifyLocationsFile(ctx: Context, path: str): bool:
    if ctx.handle == null:
        ret false
    end
    mut roots := tls.LoadRoots(path)
    n := tls.RootCount(roots)
    tls.FreeRoots(roots)
    if n == 0:
        _last_error = "no certificates found in " + path
        ret false
    end
    p := _ctx_of(ctx)
    p[0].ca_file = path
    ret true
end

@en "SetDefaultVerifyPaths"
@fa "تنظیم مسیرهای پیش‌فرض تایید"
pub func SetDefaultVerifyPaths(ctx: Context): bool:
    if ctx.handle == null:
        ret false
    end
    p := _ctx_of(ctx)
    p[0].ca_file = ""
    ret true
end

@en "SetMinVersion"
@fa "تنظیم کمینه نسخه"
pub func SetMinVersion(ctx: Context, version: i64): bool:
    if ctx.handle == null or version < 0 or version > TLS1_3:
        ret false
    end
    p := _ctx_of(ctx)
    p[0].min_version = version
    ret true
end

@en "CloseContext"
@fa "بستن زمینه"
pub func CloseContext(ctx: Context):
    if ctx.handle == null:
        ret
    end
    p := _ctx_of(ctx)
    if p[0].server:
        tls.FreeRoots(p[0].scfg.chain)
        tls.FreePrivateKey(p[0].scfg.key)
    end
    mem.Free(ctx.handle)
end
