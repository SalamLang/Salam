package ssl

@en "ErrorCode"
@fa "کد خطا"
pub func ErrorCode(c: Conn, rc: int): int:
    if c.handle == null or rc > 0:
        ret _ERROR_NONE
    end
    s := _session_of(c)
    if s[0].err.len() > 0:
        ret _ERROR_SSL
    end
    if s[0].closed:
        ret _ERROR_ZERO_RETURN
    end
    ret _ERROR_SYSCALL
end

@en "LastErrorString"
@fa "آخرین متن خطا"
pub func LastErrorString(): str:
    msg := _last_error
    _last_error = ""
    ret msg
end
