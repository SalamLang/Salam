package ssl

@en "SetHostname"
@fa "تنظیم نام میزبان"
pub func SetHostname(c: Conn, host: str): bool:
    if c.handle == null or host.len() == 0:
        ret false
    end
    s := _session_of(c)
    if s[0].attached:
        ret false
    end
    s[0].host = host
    ret true
end

@en "VerifyResult"
@fa "نتیجه تایید"
pub func VerifyResult(c: Conn): i64:
    if c.handle == null:
        ret 0 - 1
    end
    s := _session_of(c)
    ret s[0].verify_result
end

@en "PeerVerified"
@fa "طرف مقابل تاییدشده"
pub func PeerVerified(c: Conn): bool:
    ret VerifyResult(c) == CERT_OK
end
