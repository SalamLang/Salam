package str

@en "Len"
@fa "طول"
pub inline pure func Len(s: str): int: ret s.Len() end

@en "ByteLen"
@fa "طول بایتی"
pub inline pure func ByteLen(s: str): int: ret _blen(s) end

@en "ByteSub"
@fa "زیررشته بایتی"
pub inline func ByteSub(s: str, start: int, n: int): str: ret _bsub(s, start, n) end

@en "Concat"
@fa "پیوست"
pub inline pure func Concat(a: str, b: str): str: ret a.Concat(b) end

@en "Compare"
@fa "مقایسه"
pub inline pure func Compare(a: str, b: str): int:
    c := strcmp(a, b)
    if c < 0: ret 0 - 1 end
    ret c > 0 ? 1 : 0
end

@en "Equals"
@fa "یکسان است"
pub inline pure func Equals(a: str, b: str): bool: ret strcmp(a, b) == 0 end

@en "Substr"
@fa "زیررشته"
pub inline pure func Substr(s: str, start: int, n: int): str: ret s.Substr(start, n) end

@en "SubstrIn"
@fa "زیررشته درون"
pub func SubstrIn(s: str, start: int, n: int): str:
    slen := s.Len()
    mut st := start
    mut ln := n
    if st < 0: st = 0 end
    if st > slen: st = slen end
    if ln < 0: ln = 0 end
    if ln > slen - st: ln = slen - st end
    r := mem.MustAllocateZeroed((ln + 1) as u64)
    if ln > 0:
        mem.Copy(r, ((_bp(s) as void*) as i64 + (st as i64)) as void*, ln as u64)
    end
    ret r as str
end

@en "Find"
@fa "یافتن"
pub inline pure func Find(s: str, sub: str): int: ret s.Find(sub) end

@en "Split"
@fa "تفکیک کردن"
pub pure func Split(s: str, delim: str): Vector<str>: ret s.Split(delim) end

@en "Join"
@fa "بپیوند"
pub func Join(parts: Vector<str>, sep: str): str:
    mut sb := NewBuilder()
    defer BufFree(sb)
    repeat parts.Len() in i:
        if i > 0: BufAppend(sb, sep) end
        BufAppend(sb, parts.Get(i))
    end
    out := BufStr(sb)
    ret out
end

@en "Trim"
@fa "پیرایش"
pub inline pure func Trim(s: str): str: ret s.Trim() end

@en "ToInt"
@fa "تبدیل به عدد"
pub inline pure func ToInt(s: str): int: ret s.ToInt() end

@en "ToFloat"
@fa "تبدیل به اعشار"
pub inline pure func ToFloat(s: str): f64: ret s.ToFloat() end

@en "IsEmpty"
@fa "خالی است"
pub inline pure func IsEmpty(s: str): bool: ret s.Len() == 0 end

@en "Clone"
@fa "رونوشت"
pub func Clone(s: str): str:
    n := s.Len() as i64
    r := mem.MustAllocateZeroed((n + 1) as u64)
    mem.Copy(r, s as void*, n as u64)
    ret r as str
end

@en "Replace"
@fa "جایگزینی"
pub func Replace(s: str, find: str, replacement: str): str:
    fl := find.Len()
    if fl == 0: ret Clone(s) end
    n := s.Len()
    mut idx := _find_n(s, n, find, fl, 0)
    if idx < 0: ret Clone(s) end
    rl := replacement.Len()
    mut sb := NewBuilder()
    defer BufFree(sb)
    mut i := 0
    until idx >= 0:
        _buf_append_range(sb, s, i, idx - i)
        _buf_append_range(sb, replacement, 0, rl)
        i = idx + fl
        idx = _find_n(s, n, find, fl, i)
    end
    _buf_append_range(sb, s, i, n - i)
    ret BufStr(sb)
end

@en "FromInt"
@fa "از عدد"
pub func FromInt(i: i64): str: ret numfmt.FormatInt(i) end

if not SALAM_KERNEL:
    @en "FromFloat"
    @fa "از اعشار"
    pub func FromFloat(f: f64): str: ret numfmt.FormatFloat(f) end
end
