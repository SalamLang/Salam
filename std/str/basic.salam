package str

@en "Len"
@fa "طول"
@ar "طول"
pub inline pure func Len(s: str): int: ret s.len() end

@en "Concat"
@fa "پیوست"
@ar "ضم"
pub inline func Concat(a: str, b: str): str: ret a.concat(b) end

@en "Compare"
@fa "مقایسه"
@ar "مقارنة"
// Orders a before, with or after b as -1, 0 or 1.
//
// C's strcmp only promises a sign, and libc implementations differ in the
// magnitude they give it: on x86-64 glibc "a" vs "b" is -1, on aarch64 it is
// -64. Folding it to a sign is what makes a program print the same number on
// every machine and every backend.
pub inline pure func Compare(a: str, b: str): int:
    c := strcmp(a, b)
    if c < 0: ret 0 - 1 end
    ret c > 0 ? 1 : 0
end

@en "Equals"
@fa "برابر است"
@ar "یساوی"
pub inline pure func Equals(a: str, b: str): bool: ret strcmp(a, b) == 0 end

@en "Substr"
@fa "زیررشته"
@ar "مقطع"
pub inline func Substr(s: str, start: int, n: int): str: ret s.substr(start, n) end

@en "Find"
@fa "یافتن"
@ar "بحث"
pub inline pure func Find(s: str, sub: str): int: ret s.find(sub) end

@en "Split"
@fa "جدا کردن"
@ar "تقسیم"
pub func Split(s: str, delim: str): Vector<str>: ret s.split(delim) end

@en "Join"
@fa "بپیوند"
@ar "دمج"
pub func Join(parts: Vector<str>, sep: str): str:
    mut sb := NewBuilder()
    defer BufFree(sb)
    repeat parts.len() with i:
        if i > 0: BufAppend(sb, sep) end
        BufAppend(sb, parts.get(i))
    end
    out := BufStr(sb)
    ret out
end

@en "Trim"
@fa "پیرایش"
@ar "اقتطاع"
pub inline func Trim(s: str): str: ret s.trim() end

@en "ToInt"
@fa "تبدیل به عدد"
@ar "تحویل الى عدد صحیح"
pub inline func ToInt(s: str): int: ret s.to_int() end

@en "ToFloat"
@fa "تبدیل به اعشار"
@ar "تحویل الى عدد عشری"
pub inline func ToFloat(s: str): f64: ret s.to_float() end

@en "IsEmpty"
@fa "خالی است"
@ar "فارغ"
pub inline pure func IsEmpty(s: str): bool: ret s.len() == 0 end

@en "Clone"
@fa "رونوشت"
@ar "استنساخ"
pub func Clone(s: str): str:
    n := s.len() as i64
    r := mem.AllocateZeroed((n + 1) as u64)
    mem.Copy(r, s as void*, n as u64)
    ret r as str
end

@en "Replace"
@fa "جایگزینی"
@ar "استبدال"
// Returns a heap string the CALLER owns and must free. The two "nothing to
// do" branches allocate a copy rather than returning the argument, for the
// same reason TrimLeft does: a sometimes-aliased return cannot be freed
// safely by anyone. filepath.Normalize is a bare call to this function, so
// filepath.Clean freeing its own working copy was freeing its caller's
// string on every path that contained no backslash - which is every path on
// a POSIX system.
//
// The spans copied out between matches are appended and then released; they
// used to be abandoned, one per match, on every call.
pub func Replace(s: str, find: str, replacement: str): str:
    fl := find.len()
    if fl == 0: ret Clone(s) end
    n := s.len()
    mut idx := IndexFrom(s, find, 0)
    if idx < 0: ret Clone(s) end
    mut sb := NewBuilder()
    defer BufFree(sb)
    mut i := 0
    until idx >= 0:
        if idx > i:
            head := s.substr(i, idx - i)
            BufAppend(sb, head)
            mem.Free(head as void*)
        end
        BufAppend(sb, replacement)
        i = idx + fl
        idx = IndexFrom(s, find, i)
    end
    if i < n:
        tail := s.substr(i, n - i)
        BufAppend(sb, tail)
        mem.Free(tail as void*)
    end
    ret BufStr(sb)
end

@en "FromInt"
@fa "از عدد"
@ar "من عدد صحیح"
pub func FromInt(i: i64): str: ret conv.FormatInt(i) end

@en "FromFloat"
@fa "از اعشار"
@ar "من عدد عشری"
pub func FromFloat(f: f64): str: ret conv.FormatFloat(f) end
