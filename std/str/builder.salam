package str

@en "NewBuilder"
@fa "سازنده"
@ar "منشئ جدید"
pub func NewBuilder(): StringBuilder:
    ret StringBuilder { data = null, len = 0, cap = 0 }
end

@en "BufAppend"
@fa "افزودن به بافر"
@ar "إلحاق بالمخزن"
pub func BufAppend(b &: StringBuilder, s: str):
    n := s.len() as i64
    if n <= 0: ret end
    _buf_ensure(b, b.len + n)
    dst := ((b.data as i64) + b.len) as void*
    mem.Copy(dst, s as void*, n as u64)
    b.len += n
end

@en "BufAppendChar"
@fa "افزودن نویسه به بافر"
@ar "إلحاق حرف بالمخزن"
pub func BufAppendChar(b &: StringBuilder, code: int):
    _buf_ensure(b, b.len + 1)
    p := b.data as i8*
    p[b.len as int] = code as i8
    b.len += 1
end

@en "BufAppendCp"
@fa "افزودن کدنقطه به بافر"
@ar "إلحاق نقطة رمز بالمخزن"
// Appends a code point, UTF-8 encoded into the one to four bytes it needs.
//
// BufAppendChar writes a single raw byte, which is what you want when you are
// copying bytes around; this is what you want when you have a code point,
// such as one that came back from unicode.ToUpper. Passing a Persian letter
// to BufAppendChar would truncate it to its low byte and produce mojibake.
//
// A negative code point, or one past the end of the code space, is written as
// U+FFFD REPLACEMENT CHARACTER, so malformed input from _decode_at round
// trips into something a reader can see rather than silently vanishing.
pub func BufAppendCp(b &: StringBuilder, cp: int):
    mut c := cp
    if c < 0 || c > 0x10FFFF: c = 0xFFFD end
    if c < 0x80:
        BufAppendChar(b, c)
    else c < 0x800:
        BufAppendChar(b, 0xC0 | (c >> 6))
        BufAppendChar(b, 0x80 | (c & 0x3F))
    else c < 0x10000:
        BufAppendChar(b, 0xE0 | (c >> 12))
        BufAppendChar(b, 0x80 | ((c >> 6) & 0x3F))
        BufAppendChar(b, 0x80 | (c & 0x3F))
    else:
        BufAppendChar(b, 0xF0 | (c >> 18))
        BufAppendChar(b, 0x80 | ((c >> 12) & 0x3F))
        BufAppendChar(b, 0x80 | ((c >> 6) & 0x3F))
        BufAppendChar(b, 0x80 | (c & 0x3F))
    end
end

@en "BufAppendInt"
@fa "افزودن عدد به بافر"
@ar "إلحاق عدد بالمخزن"
pub func BufAppendInt(b &: StringBuilder, n: i64):
    BufAppend(b, conv.FormatInt(n))
end

@en "BufLen"
@fa "طول بافر"
@ar "طول المخزن"
pub func BufLen(b &: StringBuilder): i64: ret b.len end

@en "BufIsEmpty"
@fa "بافر خالی است"
@ar "المخزن فارغ"
pub func BufIsEmpty(b &: StringBuilder): bool: ret b.len == 0 end

@en "BufStr"
@fa "رشته بافر"
@ar "نص المخزن"
pub func BufStr(b &: StringBuilder): str:
    if b.data == null: ret "" end
    p := b.data as i8*
    p[b.len as int] = 0 as i8
    ret Clone(b.data as str)
end

@en "BufReset"
@fa "بازنشانی بافر"
@ar "إعادة تعیین المخزن"
pub func BufReset(b &: StringBuilder): b.len = 0 end

@en "BufFree"
@fa "آزادسازی بافر"
@ar "تحریر المخزن"
pub func BufFree(b &: StringBuilder):
    if b.data != null: mem.Free(b.data) end
    b.data = null
    b.len = 0
    b.cap = 0
end
