package str

func _fold_next(bp: i8*, n: int, i &: int, src &: int, k &: int): int:
    if src >= 0 and k < unicode.FullFoldLen(src):
        cp := unicode.FullFoldAt(src, k)
        k++
        ret cp
    end
    if i >= n: ret 0 - 1 end
    mut cur := 0
    i = _decode_at(bp, n, i, cur)
    src = cur
    k = 1
    ret unicode.FullFoldAt(cur, 0)
end

func _fold_all(s: str): Vector<int>:
    n := _blen(s)
    bp := _bp(s)
    out := Vector {} as Vector<int>
    mut i := 0
    mut src := 0 - 1
    mut k := 0
    until true:
        c := _fold_next(bp, n, i, src, k)
        if c < 0: ret out end
        out.push(c)
    end
end

@en "Upper"
@fa "بزرگ"
pub inline pure func Upper(s: str): str: ret s.upper() end

@en "Lower"
@fa "کوچک"
pub inline pure func Lower(s: str): str: ret s.lower() end

@en "Title"
@fa "حالت عنوانی"
pub func Title(s: str): str:
    n := _blen(s)
    bp := _bp(s)
    mut sb := NewBuilder()
    defer BufFree(sb)
    mut start := true
    mut i := 0
    mut cp := 0
    until i < n:
        i = _decode_at(bp, n, i, cp)
        if IsSpace(cp):
            start = true
            BufAppendCp(sb, cp)
        else:
            if start:
                BufAppendCp(sb, unicode.ToTitle(cp))
            else:
                BufAppendCp(sb, unicode.ToLower(cp))
            end
            start = false
        end
    end
    out := BufStr(sb)
    ret out
end

@en "EqualFold"
@fa "یکسان بدون حساسیت"
pub func EqualFold(a: str, b: str): bool:
    an := _blen(a)
    bn := _blen(b)
    ap := _bp(a)
    bq := _bp(b)
    mut ai := 0
    mut asrc := 0 - 1
    mut ak := 0
    mut bi := 0
    mut bsrc := 0 - 1
    mut bk := 0
    until true:
        ca := _fold_next(ap, an, ai, asrc, ak)
        cb := _fold_next(bq, bn, bi, bsrc, bk)
        if ca != cb: ret false end
        if ca < 0: ret true end
    end
end

@en "CompareFold"
@fa "مقایسه بدون حساسیت"
pub func CompareFold(a: str, b: str): int:
    an := _blen(a)
    bn := _blen(b)
    ap := _bp(a)
    bq := _bp(b)
    mut ai := 0
    mut asrc := 0 - 1
    mut ak := 0
    mut bi := 0
    mut bsrc := 0 - 1
    mut bk := 0
    until true:
        ca := _fold_next(ap, an, ai, asrc, ak)
        cb := _fold_next(bq, bn, bi, bsrc, bk)
        if ca != cb: ret ca - cb end
        if ca < 0: ret 0 end
    end
end

@en "StartsWithFold"
@fa "شروع با بدون حساسیت"
pub func StartsWithFold(s: str, prefix: str): bool:
    sn := _blen(s)
    pn := _blen(prefix)
    sp := _bp(s)
    pp := _bp(prefix)
    mut si := 0
    mut ssrc := 0 - 1
    mut sk := 0
    mut pi := 0
    mut psrc := 0 - 1
    mut pk := 0
    until true:
        cp := _fold_next(pp, pn, pi, psrc, pk)
        if cp < 0: ret true end
        cs := _fold_next(sp, sn, si, ssrc, sk)
        if cs != cp: ret false end
    end
end

@en "EndsWithFold"
@fa "پایان با بدون حساسیت"
pub func EndsWithFold(s: str, suffix: str): bool:
    a := _fold_all(s)
    b := _fold_all(suffix)
    defer a.Free()
    defer b.Free()
    off := a.Len() - b.Len()
    if off < 0: ret false end
    repeat b.Len() in i:
        if a.get(off + i) != b.get(i): ret false end
    end
    ret true
end
