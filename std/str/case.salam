package str

// One step of a case-folding cursor over a UTF-8 string.
//
// Returns the next code point of the folded form of the string in `bp`, or -1
// once it is exhausted. The three reference parameters are the cursor state:
// `i` is the byte offset, and `src`/`k` remember a code point that is partway
// through expanding to several. Callers start with i = 0, src = -1, k = 0.
//
// The expansion state is what makes this a cursor instead of a loop. Folding
// is not one-to-one: ß folds to "ss" and ﬄ to "ffl", so one code point on one
// side of a comparison can line up with three on the other, and the two sides
// go out of step. Producing folded code points one at a time from each side
// independently is what lets the comparison stay aligned - and it is why
// EqualFold cannot be the byte-for-byte loop it used to be, which compared
// lengths up front and would have rejected "ß" against "ss" without looking.
func _fold_next(bp: i8*, n: int, i &: int, src &: int, k &: int): int:
    if src >= 0 && k < unicode.FullFoldLen(src):
        cp := unicode.FullFoldAt(src, k)
        k += 1
        ret cp
    end
    if i >= n: ret 0 - 1 end
    mut cur := 0
    i = _decode_at(bp, n, i, cur)
    src = cur
    k = 1
    ret unicode.FullFoldAt(cur, 0)
end

@en "Upper"
@fa "بزرگ"
@ar "أحرف کبیرة"
pub inline func Upper(s: str): str: ret s.upper() end

@en "Lower"
@fa "کوچک"
@ar "أحرف صغیرة"
pub inline func Lower(s: str): str: ret s.lower() end

@en "Title"
@fa "حالت عنوانی"
@ar "حالة العنوان"
// Uppercases the first character of each whitespace-separated word and
// lowercases the rest.
//
// This walks code points and maps them through the Unicode case tables rather
// than adding and subtracting 32 from bytes. The arithmetic version only ever
// worked for ASCII, and on anything else it rewrote individual UTF-8 bytes -
// turning a Persian word into mojibake instead of leaving it alone. Caseless
// scripts now pass through untouched, which is the correct behaviour for
// Persian and Arabic: unicode.ToTitle and ToLower return their argument for
// every code point that has no case.
pub func Title(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut sb := NewBuilder()
    defer BufFree(sb)
    mut start := true
    mut i := 0
    mut cp := 0
    until i < n:
        i = _decode_at(bp, n, i, cp)
        if IsSpace(cp):
            start = true
            BufAppendCp(sb, cp)
        else:
            if start:
                BufAppendCp(sb, unicode.ToTitle(cp))
            else:
                BufAppendCp(sb, unicode.ToLower(cp))
            end
            start = false
        end
    end
    out := BufStr(sb)
    ret out
end

@en "EqualFold"
@fa "برابر بدون حساسیت"
@ar "یساوی دون حساسیة"
// Whether a and b are equal once case is folded away.
//
// Folding, not lowercasing: the Greek final sigma ς compares equal to both σ
// and Σ, which lowercasing alone does not give you. Length is not checked
// first, because equal strings need not be the same length - "STRASSE" and
// "straße" match here.
pub func EqualFold(a: str, b: str): bool:
    an := a.len()
    bn := b.len()
    ap := _bp(a)
    bq := _bp(b)
    mut ai := 0
    mut asrc := 0 - 1
    mut ak := 0
    mut bi := 0
    mut bsrc := 0 - 1
    mut bk := 0
    until true:
        ca := _fold_next(ap, an, ai, asrc, ak)
        cb := _fold_next(bq, bn, bi, bsrc, bk)
        if ca != cb: ret false end
        if ca < 0: ret true end
    end
end

@en "CompareFold"
@fa "مقایسه بدون حساسیت"
@ar "مقارنة دون حساسیة"
// Orders a and b by their case-folded forms: negative, zero or positive.
//
// The ordering is by code point of the folded text, which is stable and
// consistent but is not alphabetical order in any particular language - it
// puts all of Latin before all of Arabic, and within Arabic it follows the
// Unicode block rather than the order the alphabet is recited in. Sorting
// Persian for a reader needs a collation, which this is not.
pub func CompareFold(a: str, b: str): int:
    an := a.len()
    bn := b.len()
    ap := _bp(a)
    bq := _bp(b)
    mut ai := 0
    mut asrc := 0 - 1
    mut ak := 0
    mut bi := 0
    mut bsrc := 0 - 1
    mut bk := 0
    until true:
        ca := _fold_next(ap, an, ai, asrc, ak)
        cb := _fold_next(bq, bn, bi, bsrc, bk)
        if ca != cb: ret ca - cb end
        if ca < 0: ret 0 end
    end
end
