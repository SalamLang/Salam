package str

import unicode

@en "IsAscii"
@fa "اسکی است"
@ar "أسکي"
pub inline pure func IsAscii(code: int): bool:
    ret code >= 0 && code <= 127
end

@en "IsAsciiSpace"
@fa "فاصله اسکی است"
@ar "فراغ أسکي"
pub inline pure func IsAsciiSpace(code: int): bool:
    ret code == 32 || (code >= 9 && code <= 13)
end

@en "IsAsciiDigit"
@fa "رقم اسکی است"
@ar "رقم أسکي"
pub inline pure func IsAsciiDigit(code: int): bool:
    ret code >= 48 && code <= 57
end

@en "IsAsciiUpper"
@fa "بزرگ اسکی است"
@ar "کبیر أسکي"
pub inline pure func IsAsciiUpper(code: int): bool:
    ret code >= 65 && code <= 90
end

@en "IsAsciiLower"
@fa "کوچک اسکی است"
@ar "صغیر أسکي"
pub inline pure func IsAsciiLower(code: int): bool:
    ret code >= 97 && code <= 122
end

@en "IsAsciiAlpha"
@fa "حرف اسکی است"
@ar "حرف أسکي"
pub inline pure func IsAsciiAlpha(code: int): bool:
    ret IsAsciiUpper(code) || IsAsciiLower(code)
end

@en "IsAsciiAlnum"
@fa "حرف یا رقم اسکی است"
@ar "حرف او رقم أسکي"
pub inline pure func IsAsciiAlnum(code: int): bool:
    ret IsAsciiAlpha(code) || IsAsciiDigit(code)
end

@en "IsSpace"
@fa "فاصله است"
@ar "فراغ"
pub pure func IsSpace(code: int): bool:
    if IsAscii(code): ret IsAsciiSpace(code) end
    ret unicode.IsSpace(code)
end

@en "IsDigit"
@fa "رقم است"
@ar "رقم"
pub pure func IsDigit(code: int): bool:
    if IsAscii(code): ret IsAsciiDigit(code) end
    ret unicode.IsDigit(code)
end

@en "IsUpper"
@fa "بزرگ است"
@ar "حرف کبیر"
pub pure func IsUpper(code: int): bool:
    if IsAscii(code): ret IsAsciiUpper(code) end
    ret unicode.IsUpper(code)
end

@en "IsLower"
@fa "کوچک است"
@ar "حرف صغیر"
pub pure func IsLower(code: int): bool:
    if IsAscii(code): ret IsAsciiLower(code) end
    ret unicode.IsLower(code)
end

@en "IsAlpha"
@fa "حرف است"
@ar "حرف"
pub pure func IsAlpha(code: int): bool:
    if IsAscii(code): ret IsAsciiAlpha(code) end
    ret unicode.IsAlphabetic(code)
end

@en "IsAlnum"
@fa "حرف یا رقم است"
@ar "حرف او رقم"
pub pure func IsAlnum(code: int): bool:
    if IsAscii(code): ret IsAsciiAlnum(code) end
    ret unicode.IsAlnum(code)
end

@en "IsPunct"
@fa "نشانه نگارشی است"
@ar "علامة ترقیم"
pub pure func IsPunct(code: int): bool:
    ret unicode.IsPunct(code)
end

@en "IsMark"
@fa "نشانه است"
@ar "علامة"
pub pure func IsMark(code: int): bool:
    ret unicode.IsMark(code)
end

@en "IsControl"
@fa "کنترلی است"
@ar "تحکم"
pub pure func IsControl(code: int): bool:
    ret unicode.IsControl(code)
end
