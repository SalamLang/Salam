package str

// Digit conversion between the three digit scripts Salam programs
// commonly mix in one string: ASCII ("0123456789"), Arabic-Indic
// ("٠١٢٣٤٥٦٧٨٩", used across most Arabic-speaking countries) and
// Extended Arabic-Indic ("۰۱۲۳۴۵۶۷۸۹", the Persian/Urdu digits). All
// three encode the same ten values, just with different codepoints -
// U+0030..U+0039, U+0660..U+0669 and U+06F0..U+06F9 respectively - so
// converting between them is a straight codepoint remap, not a numeric
// parse. Everything else in the string (letters, punctuation, spaces)
// passes through untouched.
const _DIGIT_ASCII_BASE := 0x30
const _DIGIT_ARABIC_BASE := 0x0660
const _DIGIT_PERSIAN_BASE := 0x06F0

// The 0-9 value of a digit codepoint from any of the three scripts, or
// -1 if `cp` is not one of them.
pure func _digit_value(cp: int): int:
    if cp >= _DIGIT_ASCII_BASE && cp <= _DIGIT_ASCII_BASE + 9: ret cp - _DIGIT_ASCII_BASE
    else cp >= _DIGIT_ARABIC_BASE && cp <= _DIGIT_ARABIC_BASE + 9: ret cp - _DIGIT_ARABIC_BASE
    else cp >= _DIGIT_PERSIAN_BASE && cp <= _DIGIT_PERSIAN_BASE + 9: ret cp - _DIGIT_PERSIAN_BASE
    else:
        ret 0 - 1
    end
end

// Appends `digit` (0-9) as a codepoint in the given script's block.
// `base` is one of the _DIGIT_*_BASE constants above; every digit
// codepoint in all three scripts fits in one or two UTF-8 bytes, so
// there is no need for the general 3/4-byte encoder here.
func _append_digit(b &: StringBuilder, digit: int, base: int):
    cp := base + digit
    if cp < 0x80:
        BufAppendChar(b, cp)
    else:
        BufAppendChar(b, 0xC0 | (cp >> 6))
        BufAppendChar(b, 0x80 | (cp & 0x3F))
    end
end

// Decodes the codepoint starting at byte `i`, writes it to `cp` and
// returns the index of the next character. Only 1- and 2-byte UTF-8
// sequences are actually decoded (everything this file cares about -
// ASCII, Arabic-Indic and Extended Arabic-Indic - fits in two bytes);
// a longer or truncated sequence still advances correctly but sets
// `cp` to -1, which reads as "not a digit" everywhere it is checked.
func _next_cp(bp: i8*, n: int, i: int, cp &: int): int:
    b0 := _ub(bp, i)
    clen := CharLen(b0)
    mut ce := i + clen
    if ce > n: ce = n end
    if clen == 1:
        cp = b0
    else clen == 2 && ce == i + 2:
        cp = ((b0 & 0x1F) << 6) | (_ub(bp, i + 1) & 0x3F)
    else:
        cp = 0 - 1
    end
    ret ce
end

func _convert_digits(s: str, base: int): str:
    n := s.len()
    bp := _bp(s)
    mut b := NewBuilder()
    defer BufFree(b)
    mut i := 0
    until i < n:
        mut cp := 0
        ce := _next_cp(bp, n, i, cp)
        d := _digit_value(cp)
        if d >= 0:
            _append_digit(b, d, base)
        else:
            mut k := i
            until k < ce:
                BufAppendChar(b, _ub(bp, k))
                k += 1
            end
        end
        i = ce
    end
    ret BufStr(b)
end

// True if `s` contains at least one digit codepoint from the given
// script's block.
func _has_digit_script(s: str, base: int): bool:
    n := s.len()
    bp := _bp(s)
    mut i := 0
    until i < n:
        mut cp := 0
        ce := _next_cp(bp, n, i, cp)
        if cp >= base && cp <= base + 9: ret true end
        i = ce
    end
    ret false
end

@en "DigitValue"
@fa "مقدار رقم"
@ar "قیمة الرقم"
pub inline pure func DigitValue(cp: int): int: ret _digit_value(cp) end

@en "IsArabicDigit"
@fa "رقم عربی است"
@ar "رقم عربي"
pub inline pure func IsArabicDigit(cp: int): bool:
    ret cp >= _DIGIT_ARABIC_BASE && cp <= _DIGIT_ARABIC_BASE + 9
end

@en "IsPersianDigit"
@fa "رقم فارسی است"
@ar "رقم فارسي"
pub inline pure func IsPersianDigit(cp: int): bool:
    ret cp >= _DIGIT_PERSIAN_BASE && cp <= _DIGIT_PERSIAN_BASE + 9
end

@en "IsAnyDigit"
@fa "رقم است"
@ar "رقم"
pub inline pure func IsAnyDigit(cp: int): bool: ret _digit_value(cp) >= 0 end

// Converts Arabic-Indic and Persian digits in `s` to ASCII digits.
// Handy before parsing user input into a number.
@en "ToEnglishDigits"
@fa "به رقم انگلیسی"
@ar "إلى الأرقام الإنجليزية"
pub func ToEnglishDigits(s: str): str: ret _convert_digits(s, _DIGIT_ASCII_BASE) end

// Converts ASCII and Persian digits in `s` to Arabic-Indic digits.
@en "ToArabicDigits"
@fa "به رقم عربی"
@ar "إلى الأرقام العربية"
pub func ToArabicDigits(s: str): str: ret _convert_digits(s, _DIGIT_ARABIC_BASE) end

// Converts ASCII and Arabic-Indic digits in `s` to Persian digits.
@en "ToPersianDigits"
@fa "به رقم فارسی"
@ar "إلى الأرقام الفارسية"
pub func ToPersianDigits(s: str): str: ret _convert_digits(s, _DIGIT_PERSIAN_BASE) end

@en "HasEnglishDigits"
@fa "دارای رقم انگلیسی است"
@ar "يحتوي على أرقام إنجليزية"
pub func HasEnglishDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_ASCII_BASE) end

@en "HasArabicDigits"
@fa "دارای رقم عربی است"
@ar "يحتوي على أرقام عربية"
pub func HasArabicDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_ARABIC_BASE) end

@en "HasPersianDigits"
@fa "دارای رقم فارسی است"
@ar "يحتوي على أرقام فارسية"
pub func HasPersianDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_PERSIAN_BASE) end
