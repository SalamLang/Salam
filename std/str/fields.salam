package str

@en "Repeat"
@fa "تکرار"
@ar "تکرار"
pub inline func Repeat(s: str, n: int): str: ret s.repeat (n) end

@en "Fields"
@fa "واژه ها"
@ar "کلمات"
// Splits on runs of Unicode whitespace. Note what this does NOT split on:
// ZERO WIDTH NON-JOINER holds Persian compounds together - "می‌رود" is a
// single field, and a splitter that broke it there would hand back two
// fragments that mean nothing on their own.
pub func Fields(s: str): Vector<str>:
    out := Vector {} as Vector<str> n := s.len()
    bp := _bp(s)
    mut i := 0
    mut cp := 0
    until i < n:
        until i < n:
            next := _decode_at(bp, n, i, cp)
            if IsSpace(cp) == false: break end
            i = next
        end
        start := i
        until i < n:
            next := _decode_at(bp, n, i, cp)
            if IsSpace(cp): break end
            i = next
        end
        if i > start:
            out.push(s.substr(start, i - start))
        end
    end
    ret out
end
