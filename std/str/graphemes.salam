package str

func _gcb_is_break(prev: int, curr: int, ri_run: int, pict_zwj: bool, conjunct: bool): bool:
    pc := unicode.GraphemeBreak(prev)
    cc := unicode.GraphemeBreak(curr)

    if pc == unicode.GcbCR && cc == unicode.GcbLF: ret false end
    if pc == unicode.GcbControl || pc == unicode.GcbCR || pc == unicode.GcbLF: ret true end
    if cc == unicode.GcbControl || cc == unicode.GcbCR || cc == unicode.GcbLF: ret true end
    if pc == unicode.GcbL:
        if cc == unicode.GcbL || cc == unicode.GcbV || cc == unicode.GcbLV || cc == unicode.GcbLVT: ret false end
    end
    if pc == unicode.GcbLV || pc == unicode.GcbV:
        if cc == unicode.GcbV || cc == unicode.GcbT: ret false end
    end
    if pc == unicode.GcbLVT || pc == unicode.GcbT:
        if cc == unicode.GcbT: ret false end
    end
    if cc == unicode.GcbExtend || cc == unicode.GcbZWJ: ret false end
    if cc == unicode.GcbSpacingMark: ret false end
    if pc == unicode.GcbPrepend: ret false end
    if conjunct && unicode.ConjunctBreak(curr) == unicode.IncbConsonant: ret false end
    if pc == unicode.GcbZWJ && cc == unicode.GcbExtendedPictographic && pict_zwj: ret false end
    if pc == unicode.GcbRegionalIndicator && cc == unicode.GcbRegionalIndicator:
        if ri_run % 2 == 1: ret false end
    end
    ret true
end

func _gcb_pict_next(state: int, cp: int): int:
    k := unicode.GraphemeBreak(cp)
    if k == unicode.GcbExtendedPictographic: ret 1 end
    if state == 1 && k == unicode.GcbExtend: ret 1 end
    if state == 1 && k == unicode.GcbZWJ: ret 2 end
    ret 0
end

func _gcb_conj_next(state: int, cp: int): int:
    k := unicode.ConjunctBreak(cp)
    if k == unicode.IncbConsonant: ret 1 end
    if state > 0 && k == unicode.IncbLinker: ret 2 end
    if state > 0 && k == unicode.IncbExtend: ret state end
    ret 0
end

@en "GraphemeCount"
@fa "شمار خوشه"
@ar "عدد العناقید"
pub func GraphemeCount(s: str): int:
    n := s.len()
    if n == 0: ret 0 end
    bp := _bp(s)
    mut count := 1
    mut prev := 0
    mut i := _decode_at(bp, n, 0, prev)
    mut ri_run := 0
    if unicode.GraphemeBreak(prev) == unicode.GcbRegionalIndicator: ri_run = 1 end
    mut pict := _gcb_pict_next(0, prev)
    mut conj := _gcb_conj_next(0, prev)
    mut curr := 0
    until i < n:
        i = _decode_at(bp, n, i, curr)
        if _gcb_is_break(prev, curr, ri_run, pict == 2, conj == 2):
            count += 1
            ri_run = 0
        end
        if unicode.GraphemeBreak(curr) == unicode.GcbRegionalIndicator:
            ri_run += 1
        else:
            ri_run = 0
        end
        pict = _gcb_pict_next(pict, curr)
        conj = _gcb_conj_next(conj, curr)
        prev = curr
    end
    ret count
end

@en "Graphemes"
@fa "خوشه ها"
@ar "العناقید"
pub func Graphemes(s: str): Vector<str>:
    out := Vector {} as Vector<str>
    n := s.len()
    if n == 0: ret out end
    bp := _bp(s)
    mut prev := 0
    mut start := 0
    mut i := _decode_at(bp, n, 0, prev)
    mut ri_run := 0
    if unicode.GraphemeBreak(prev) == unicode.GcbRegionalIndicator: ri_run = 1 end
    mut pict := _gcb_pict_next(0, prev)
    mut conj := _gcb_conj_next(0, prev)
    mut curr := 0
    until i < n:
        at := i
        i = _decode_at(bp, n, i, curr)
        if _gcb_is_break(prev, curr, ri_run, pict == 2, conj == 2):
            out.push(s.substr(start, at - start))
            start = at
            ri_run = 0
        end
        if unicode.GraphemeBreak(curr) == unicode.GcbRegionalIndicator:
            ri_run += 1
        else:
            ri_run = 0
        end
        pict = _gcb_pict_next(pict, curr)
        conj = _gcb_conj_next(conj, curr)
        prev = curr
    end
    out.push(s.substr(start, n - start))
    ret out
end

@en "ReverseGraphemes"
@fa "وارونه خوشه ای"
@ar "عکس بالعناقید"
pub func ReverseGraphemes(s: str): str:
    parts := Graphemes(s)
    defer parts.free()
    mut sb := NewBuilder()
    defer BufFree(sb)
    mut i := parts.len() - 1
    until i >= 0:
        BufAppend(sb, parts.get(i))
        i -= 1
    end
    ret BufStr(sb)
end
