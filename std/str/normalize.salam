package str

func _canonical_order(buf &: Vector<int>):
    n := buf.len()
    mut i := 1
    until i < n:
        cp := buf.get(i)
        cc := unicode.CombiningClass(cp)
        if cc != 0:
            mut j := i - 1
            until j >= 0 && unicode.CombiningClass(buf.get(j)) > cc:
                buf.set(j + 1, buf.get(j))
                j -= 1
            end
            buf.set(j + 1, cp)
        end
        i += 1
    end
end

func _decompose(s: str, compat: bool): Vector<int>:
    out := Vector {} as Vector<int>
    n := s.len()
    bp := _bp(s)
    mut i := 0
    mut cp := 0
    until i < n:
        i = _decode_at(bp, n, i, cp)
        if cp < 0: cp = 0xFFFD end
        mut count := unicode.DecompLen(cp)
        if compat: count = unicode.CompatDecompLen(cp) end
        mut k := 0
        until k < count:
            if compat:
                out.push(unicode.CompatDecompAt(cp, k))
            else:
                out.push(unicode.DecompAt(cp, k))
            end
            k += 1
        end
    end
    _canonical_order(out)
    ret out
end

func _compose_canonical(buf: Vector<int>): Vector<int>:
    out := Vector {} as Vector<int>
    n := buf.len()
    if n == 0: ret out end

    mut starter_pos := 0
    mut starter := buf.get(0)
    out.push(starter)

    mut last_class := unicode.CombiningClass(starter)
    if last_class != 0: last_class = 256 end

    mut pos := 1
    until pos < n:
        ch := buf.get(pos)
        ch_class := unicode.CombiningClass(ch)
        composite := unicode.Compose(starter, ch)
        if composite >= 0 && (last_class < ch_class || last_class == 0):
            out.set(starter_pos, composite)
            starter = composite
        else:
            if ch_class == 0:
                starter_pos = out.len()
                starter = ch
            end
            last_class = ch_class
            out.push(ch)
        end
        pos += 1
    end
    ret out
end

func _cps_to_str(cps: Vector<int>): str:
    mut sb := NewBuilder()
    defer BufFree(sb)
    repeat cps.len() with i:
        BufAppendCp(sb, cps.get(i))
    end
    ret BufStr(sb)
end

@en "NFD"
@fa "تجزیه متعارف"
@ar "تفکیک قیاسي"
pub func NFD(s: str): str:
    cps := _decompose(s, false)
    defer cps.free()
    ret _cps_to_str(cps)
end

@en "NFC"
@fa "ترکیب متعارف"
@ar "ترکیب قیاسي"
pub func NFC(s: str): str:
    d := _decompose(s, false)
    defer d.free()
    c := _compose_canonical(d)
    defer c.free()
    ret _cps_to_str(c)
end

@en "NFKD"
@fa "تجزیه سازگاری"
@ar "تفکیک التوافق"
pub func NFKD(s: str): str:
    cps := _decompose(s, true)
    defer cps.free()
    ret _cps_to_str(cps)
end

@en "NFKC"
@fa "ترکیب سازگاری"
@ar "ترکیب التوافق"
pub func NFKC(s: str): str:
    d := _decompose(s, true)
    defer d.free()
    c := _compose_canonical(d)
    defer c.free()
    ret _cps_to_str(c)
end

@en "IsNFC"
@fa "متعارف است"
@ar "قیاسي"
pub func IsNFC(s: str): bool:
    ret NFC(s) == s
end
