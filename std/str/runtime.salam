package str

import mem

extern:
    func strtod(s: str, endptr: void*): f64
end

export:
    func salam_strcat(a: str, b: str): str:
        la := a.len() as i64
        lb := b.len() as i64
        r := mem.AllocateZeroed((la + lb + 1) as u64)
        mem.Copy(r, a as void*, la as u64)
        mem.Copy(((r as i64) + la) as void*, b as void*, lb as u64)
        ret r as str
    end
    func salam_char_from_code(c: int): str:
        r := mem.AllocateZeroed(2 as u64)
        mem.Set(r, c, 1 as u64)
        ret r as str
    end
    func salam_uchar_code(c: str): int:
        n := _blen(c)
        if n == 0:
            ret 0
        end
        mut cp := 0
        _decode_at(_bp(c), n, 0, cp)
        if cp < 0:
            ret 0xFFFD
        end
        ret cp
    end
    func salam_uchar_from_code(cp: int): str:
        mut sb := NewBuilder()
        defer BufFree(sb)
        BufAppendCp(sb, cp)
        ret BufStr(sb)
    end
    func salam_str_substr(s: str, start: int, n: int): str:
        slen := s.len()
        mut st := start
        mut ln := n
        if st < 0: st = 0 end
        if st > slen: st = slen end
        if ln < 0: ln = 0 end
        if st + ln > slen: ln = slen - st end
        r := mem.AllocateZeroed((ln + 1) as u64)
        mem.Copy(r, ((_bp(s) as void*) as i64 + (st as i64)) as void*, ln as u64)
        ret r as str
    end
    func salam_str_char_count(s: str): int:
        ret CharCount(s)
    end
    func salam_str_char_at(s: str, i: int): str:
        ret CharAtIndex(s, i)
    end
    func salam_str_char_substr(s: str, start: int, n: int): str:
        ret CharSubstr(s, start, n)
    end
    func salam_str_char_find(s: str, sub: str): int:
        ret CharFind(s, sub)
    end
    func salam_str_ascii_digits(s: str): str:
        n := s.len()
        p := _bp(s)
        mut hit := false
        mut i := 0
        until i + 1 < n and not hit:
            hit = _ub(p, i) == 0xDB or _ub(p, i) == 0xD9
            i += 1
        end
        if not hit:
            ret s
        end
        r := mem.AllocateZeroed((n + 1) as u64)
        rp := r as i8*
        mut j := 0
        mut k := 0
        until j < n:
            b0 := _ub(p, j)
            mut b1 := 0
            if j + 1 < n: b1 = _ub(p, j + 1) end
            if b0 == 0xDB and b1 >= 0xB0 and b1 <= 0xB9:
                rp[k] = (48 + b1 - 0xB0) as i8
                j += 2
            else b0 == 0xD9 and b1 >= 0xA0 and b1 <= 0xA9:
                rp[k] = (48 + b1 - 0xA0) as i8
                j += 2
            else b0 == 0xD9 and b1 == 0xAB:
                rp[k] = 46 as i8
                j += 2
            else:
                rp[k] = p[j]
                j += 1
            end
            k += 1
        end
        ret r as str
    end
    func salam_strtof64(s: str): f64:
        t := salam_str_ascii_digits(s)
        v := strtod(t, null)
        if (t as void*) != (s as void*):
            mem.Free(t as void*)
        end
        ret v
    end
    func salam_strtoi32(s: str): int:
        t := salam_str_ascii_digits(s)
        v := salam_strtoi32_ascii(t)
        if (t as void*) != (s as void*):
            mem.Free(t as void*)
        end
        ret v
    end
    func salam_strtoi32_ascii(s: str): int:
        n := s.len()
        p := _bp(s)
        mut i := 0
        until i < n and (_ub(p, i) == 32 or _ub(p, i) == 9 or _ub(p, i) == 10 or _ub(p, i) == 13):
            i += 1
        end
        mut neg := false
        if i < n and _ub(p, i) == 45:
            neg = true
            i += 1
        else i < n and _ub(p, i) == 43:
            i += 1
        end
        mut lim := 2147483647 as u64
        if neg: lim = 2147483648 as u64 end
        mut acc := 0 as u64
        until i < n and _ub(p, i) >= 48 and _ub(p, i) <= 57:
            d := (_ub(p, i) - 48) as u64
            if acc > (lim - d) / (10 as u64):
                acc = lim
            else:
                acc = acc * (10 as u64) + d
            end
            i += 1
        end
        if neg: ret (0 - (acc as i64)) as int end
        ret acc as int
    end
end
