package str

import mem

extern:
    func salam_strcat(a: str, b: str): str:
        la := a.len() as i64
        lb := b.len() as i64
        r := mem.AllocateZeroed((la + lb + 1) as u64)
        mem.Copy(r, a as void*, la as u64)
        mem.Copy(((r as i64) + la) as void*, b as void*, lb as u64)
        ret r as str
    end
    func salam_char_from_code(c: int): str:
        r := mem.AllocateZeroed(2 as u64)
        mem.Set(r, c, 1 as u64)
        ret r as str
    end
    func salam_str_substr(s: str, start: int, n: int): str:
        slen := s.len()
        mut st := start
        mut ln := n
        if st < 0: st = 0 end
        if st > slen: st = slen end
        if ln < 0: ln = 0 end
        if st + ln > slen: ln = slen - st end
        r := mem.AllocateZeroed((ln + 1) as u64)
        mem.Copy(r, ((_bp(s) as void*) as i64 + (st as i64)) as void*, ln as u64)
        ret r as str
    end
    func salam_strtoi32(s: str): int:
        n := s.len()
        p := _bp(s)
        mut i := 0
        until i < n && (_ub(p, i) == 32 || _ub(p, i) == 9 || _ub(p, i) == 10 || _ub(p, i) == 13):
            i += 1
        end
        mut neg := false
        if i < n && _ub(p, i) == 45:
            neg = true
            i += 1
        else i < n && _ub(p, i) == 43:
            i += 1
        end
        mut lim := 2147483647 as u64
        if neg: lim = 2147483648 as u64 end
        mut acc := 0 as u64
        until i < n && _ub(p, i) >= 48 && _ub(p, i) <= 57:
            d := (_ub(p, i) - 48) as u64
            if acc > (lim - d) / (10 as u64):
                acc = lim
            else:
                acc = acc * (10 as u64) + d
            end
            i += 1
        end
        if neg: ret (0 - (acc as i64)) as int end
        ret acc as int
    end
end
