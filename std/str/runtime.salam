// The string runtime: the entry points the compiler emits for work the
// language does on its own behalf.
//
// `a + b` on two strings becomes salam_strcat, a slice becomes
// salam_str_substr, and a character code becomes salam_char_from_code. A
// program never imports these - it gets them by writing ordinary Salam - so
// whichever package defines them must be linked into every build that
// touches a string. This one, which is where strings live.
//
// They used to sit in std/text beside salam_fmt_f64. That meant a program
// which only joined two strings still had to be able to link the float
// formatter, and a program compiled without floating-point registers - a
// kernel, most obviously - cannot link a function that names a double. Such
// a program could not have a string runtime at all and had to carry its own
// copy of these three.
package str

import mem

extern:
    func salam_strcat(a: str, b: str): str:
        la := a.len() as i64
        lb := b.len() as i64
        r := mem.AllocateZeroed((la + lb + 1) as u64)
        mem.Copy(r, a as void*, la as u64)
        mem.Copy(((r as i64) + la) as void*, b as void*, lb as u64)
        ret r as str
    end
    func salam_char_from_code(c: int): str:
        r := mem.AllocateZeroed(2 as u64)
        mem.Set(r, c, 1 as u64)
        ret r as str
    end
    func salam_str_substr(s: str, start: int, n: int): str:
        slen := s.len()
        mut st := start
        mut ln := n
        if st < 0: st = 0 end
        if st > slen: st = slen end
        if ln < 0: ln = 0 end
        if st + ln > slen: ln = slen - st end
        r := mem.AllocateZeroed((ln + 1) as u64)
        mem.Copy(r, ((_bp(s) as void*) as i64 + (st as i64)) as void*, ln as u64)
        ret r as str
    end
end
