package str

@en "Contains"
@fa "شامل است"
pub inline pure func Contains(s: str, sub: str): bool:
    ret s.find(sub) >= 0
end

@en "StartsWith"
@fa "شروع با"
pub pure func StartsWith(s: str, prefix: str): bool:
    m := _blen(prefix)
    if m > _blen(s): ret false end
    ret _match_at(_bp(s), 0, _bp(prefix), m)
end

@en "EndsWith"
@fa "پایان با"
pub pure func EndsWith(s: str, suffix: str): bool:
    m := _blen(suffix)
    n := _blen(s)
    if m > n: ret false end
    ret _match_at(_bp(s), n - m, _bp(suffix), m)
end

@en "Search"
@fa "جستجو"
pub inline pure func Search(s: str, sub: str): int: ret s.search(sub) end

@en "IndexOf"
@fa "اندیس"
pub inline pure func IndexOf(s: str, sub: str): int: ret s.indexOf(sub) end

@en "IndexFrom"
@fa "اندیس از"
pub pure func IndexFrom(s: str, sub: str, from: int): int:
    n := _blen(s)
    mut i := from
    if i < 0: i = 0 end
    i = _bidx_in(s, i)
    if i > n: ret 0 - 1 end
    tail := (((s as void*) as i64 + i) as void*) as str
    hit := tail.find(sub)
    if hit < 0: ret 0 - 1 end
    ret _bidx_out(s, i + hit)
end

@en "Count"
@fa "شمارش"
pub pure func Count(s: str, sub: str): int:
    m := _blen(sub)
    if m == 0: ret 0 end
    n := _blen(s)
    hp := _bp(s)
    np := _bp(sub)
    mut count := 0
    mut i := 0
    until i + m <= n:
        if _match_at(hp, i, np, m):
            count++
            i += m
        else:
            i++
        end
    end
    ret count
end

@en "LastIndex"
@fa "آخرین اندیس"
pub pure func LastIndex(s: str, sub: str): int:
    n := _blen(s)
    m := _blen(sub)
    if m == 0 or m > n: ret 0 - 1 end
    hp := _bp(s)
    np := _bp(sub)
    mut i := n - m
    until i >= 0:
        if _match_at(hp, i, np, m): ret _bidx_out(s, i) end
        i--
    end
    ret 0 - 1
end

@en "StartsWithAny"
@fa "شروع با یکی از"
pub func StartsWithAny(s: str, prefixes: Vector<str>): bool:
    repeat prefixes.Len() in i:
        if s.starts_with(prefixes.get(i)): ret true end
    end
    ret false
end

@en "EndsWithAny"
@fa "پایان با یکی از"
pub func EndsWithAny(s: str, suffixes: Vector<str>): bool:
    repeat suffixes.Len() in i:
        if s.ends_with(suffixes.get(i)): ret true end
    end
    ret false
end

@en "CutPrefix"
@fa "برش پیشوند"
pub func CutPrefix(s: str, prefix: str, ok &: bool): str:
    ok = s.starts_with(prefix)
    if ok: ret _bsub(s, _blen(prefix), _blen(s) - _blen(prefix)) end
    ret Clone(s)
end

@en "CutSuffix"
@fa "برش پسوند"
pub func CutSuffix(s: str, suffix: str, ok &: bool): str:
    ok = s.ends_with(suffix)
    if ok: ret _bsub(s, 0, _blen(s) - _blen(suffix)) end
    ret Clone(s)
end

@en "StartsWithBytes"
@fa "شروع بایتی"
pub pure func StartsWithBytes(data: void*, n: int, prefix: void*, m: int): bool:
    if m < 0 or m > n: ret false end
    ret _match_at(data as i8*, 0, prefix as i8*, m)
end

@en "EndsWithBytes"
@fa "پایان بایتی"
pub pure func EndsWithBytes(data: void*, n: int, suffix: void*, m: int): bool:
    if m < 0 or m > n: ret false end
    ret _match_at(data as i8*, n - m, suffix as i8*, m)
end
