@fa "رشته"
@en "str"
package str

import mem
import conv
import unicode

extern:
    pure func strcmp(a: str, b: str): int
end

@en "StringBuilder"
@fa "سازنده رشته"
pub struct StringBuilder:
    pub data: void* = null
    pub len: i64 = 0
    pub cap: i64 = 0
end

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

inline pure func _blen(s: str): int: ret s.len() end

inline pure func _bidx_in(s: str, i: int): int: ret i end

inline pure func _bidx_out(s: str, b: int): int: ret b end

inline func _bsub(s: str, start: int, n: int): str: ret s.substr(start, n) end

pure func _match_at(hp: i8*, hi: int, np: i8*, n: int): bool:
    repeat n in k:
        if hp[hi + k] != np[k]: ret false end
    end
    ret true
end

func _buf_ensure(b &: StringBuilder, need: i64):
    if need + 1 <= b.cap: ret end
    mut c := b.cap
    if c == 0: c = 64 end
    until c < need + 1: c = c * 2 end
    b.data = mem.Reallocate(b.data, c as u64)
    b.cap = c
end

if SALAM_JS:
    func _buf_append_range(b &: StringBuilder, s: str, start: int, n: int):
        BufAppend(b, _bsub(s, start, n))
    end
else:
    func _buf_append_range(b &: StringBuilder, s: str, start: int, n: int):
        if n <= 0: ret end
        _buf_ensure(b, b.len + (n as i64))
        dst := ((b.data as i64) + b.len) as void*
        mem.Copy(dst, ((s as void*) as i64 + (start as i64)) as void*, n as u64)
        b.len += n as i64
    end
end
