package str

@en "TrimLeft"
@fa "پیرایش چپ"
@ar "اقتطاع یسار"
// Removes leading Unicode whitespace.
//
// This walks code points rather than bytes. The byte loop it replaced was
// safe only by accident: no byte of a multi-byte UTF-8 sequence can equal an
// ASCII space, so testing bytes happened to give the right answer for the
// four ASCII characters it knew about. That stops holding as soon as U+00A0
// or U+3000 counts as whitespace, because those have to be recognised as
// whole sequences rather than as their individual bytes.
// Returns a heap string the CALLER owns and must free. The unchanged case
// allocates a copy rather than handing back the argument: a function that
// sometimes returns its input and sometimes a new buffer cannot be freed by
// anybody, because the caller has no way to tell the two apart. net/http hit
// exactly that - filepath.Clean freed what it thought was its own working
// copy and it was the caller's string.
pub func TrimLeft(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut i := 0
    mut cp := 0
    until i < n:
        next := _decode_at(bp, n, i, cp)
        if IsSpace(cp) == false: break end
        i = next
    end
    if i == 0: ret Clone(s) end
    ret s.substr(i, n - i)
end

@en "TrimRight"
@fa "پیرایش راست"
@ar "اقتطاع یمین"
// Removes trailing Unicode whitespace. Walks backwards a code point at a
// time, using _prev_boundary to find where each sequence starts, since UTF-8
// can only be decoded forwards.
pub func TrimRight(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut e := n
    mut cp := 0
    until e > 0:
        start := _prev_boundary(bp, e)
        _dropped := _decode_at(bp, n, start, cp)
        if IsSpace(cp) == false: break end
        e = start
    end
    if e == n: ret Clone(s) end
    ret s.substr(0, e)
end

@en "TrimPrefix"
@fa "حذف پیشوند"
@ar "حذف بادئة"
pub func TrimPrefix(s: str, prefix: str): str:
    if StartsWith(s, prefix):
        ret s.substr(prefix.len(), s.len() - prefix.len())
    end
    ret Clone(s)
end

@en "TrimSuffix"
@fa "حذف پسوند"
@ar "حذف لاحقة"
pub func TrimSuffix(s: str, suffix: str): str:
    if EndsWith(s, suffix):
        ret s.substr(0, s.len() - suffix.len())
    end
    ret Clone(s)
end
