package str

@en "TrimLeft"
@fa "پیرایش چپ"
pub func TrimLeft(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut i := 0
    mut cp := 0
    until i < n:
        next := _decode_at(bp, n, i, cp)
        if IsSpace(cp) == false: break end
        i = next
    end
    if i == 0: ret Clone(s) end
    ret s.substr(i, n - i)
end

@en "TrimRight"
@fa "پیرایش راست"
pub func TrimRight(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut e := n
    mut cp := 0
    until e > 0:
        start := _prev_boundary(bp, e)
        _dropped := _decode_at(bp, n, start, cp)
        if IsSpace(cp) == false: break end
        e = start
    end
    if e == n: ret Clone(s) end
    ret s.substr(0, e)
end

@en "TrimPrefix"
@fa "حذف پیشوند"
pub func TrimPrefix(s: str, prefix: str): str:
    if StartsWith(s, prefix):
        ret s.substr(prefix.len(), s.len() - prefix.len())
    end
    ret Clone(s)
end

@en "TrimSuffix"
@fa "حذف پسوند"
pub func TrimSuffix(s: str, suffix: str): str:
    if EndsWith(s, suffix):
        ret s.substr(0, s.len() - suffix.len())
    end
    ret Clone(s)
end
