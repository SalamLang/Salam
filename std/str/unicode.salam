package str

func _decode_at(bp: i8*, n: int, i: int, cp &: int): int:
    b0 := _ub(bp, i)
    char_len := CharLen(b0)
    next_i := i + char_len
    if next_i > n:
        cp = 0 - 1
        ret n
    end
    if char_len == 1:
        cp = b0
    else char_len == 2:
        cp = ((b0 & 0x1F) << 6) | (_ub(bp, i + 1) & 0x3F)
    else char_len == 3:
        cp = ((b0 & 0x0F) << 12) | ((_ub(bp, i + 1) & 0x3F) << 6) | (_ub(bp, i + 2) & 0x3F)
    else:
        cp = ((b0 & 0x07) << 18) | ((_ub(bp, i + 1) & 0x3F) << 12) | ((_ub(bp, i + 2) & 0x3F) << 6) | (_ub(bp, i + 3) & 0x3F)
    end
    ret next_i
end

pure func _prev_boundary(bp: i8*, e: int): int:
    mut b := e - 1
    until b > 0 and _ub(bp, b) >= 128 and _ub(bp, b) < 192:
        b -= 1
    end
    ret b
end

pure func _char_advance(bp: i8*, n: int, from: int, k: int): int:
    mut i := from
    mut c := 0
    until c < k and i < n:
        mut char_len := CharLen(_ub(bp, i))
        if i + char_len > n: char_len = n - i end
        i += char_len
        c += 1
    end
    ret i
end

@en "CodePointAt"
@fa "کدنقطه در"
pub func CodePointAt(s: str, i: int, cp &: int): int:
    n := _blen(s)
    bi := _bidx_in(s, i)
    if bi < 0 or bi >= n:
        cp = 0 - 1
        ret _bidx_out(s, n)
    end
    ret _bidx_out(s, _decode_at(_bp(s), n, bi, cp))
end

@en "CharLen"
@fa "طول نویسه"
pub inline pure func CharLen(lead: int): int:
    if lead >= 240: ret 4
    else lead >= 224: ret 3
    else lead >= 192: ret 2
    else:
        ret 1
    end
end

@en "CharAt"
@fa "نویسه در"
pub func CharAt(s: str, i: int): str:
    n := _blen(s)
    bi := _bidx_in(s, i)
    if bi < 0 or bi >= n: ret "" end
    mut char_len := CharLen(_ub(_bp(s), bi))
    if bi + char_len > n: char_len = n - bi end
    ret _bsub(s, bi, char_len)
end

@en "Reverse"
@fa "برعکس"
pub func Reverse(s: str): str:
    n := _blen(s)
    bp := _bp(s)
    mut sb := NewBuilder()
    defer BufFree(sb)
    mut e := n
    until e > 0:
        b := _prev_boundary(bp, e)
        _buf_append_range(sb, s, b, e - b)
        e = b
    end
    out := BufStr(sb)
    ret out
end

@en "CharCount"
@fa "شمارنویسه"
pub pure func CharCount(s: str): int:
    n := _blen(s)
    bp := _bp(s)
    mut count := 0
    mut i := 0
    until i < n:
        mut char_len := CharLen(_ub(bp, i))
        if i + char_len > n: char_len = n - i end
        count += 1
        i += char_len
    end
    ret count
end

@en "CharSubstr"
@fa "زیررشته نویسه"
pub func CharSubstr(s: str, start: int, n: int): str:
    total := _blen(s)
    bp := _bp(s)
    mut st := start
    mut ln := n
    if st < 0: st = 0 end
    if ln < 0: ln = 0 end
    b0 := _char_advance(bp, total, 0, st)
    b1 := _char_advance(bp, total, b0, ln)
    ret _bsub(s, b0, b1 - b0)
end

@en "CharAtIndex"
@fa "نویسه شماره"
pub func CharAtIndex(s: str, i: int): str:
    ret CharSubstr(s, i, i < 0 ? 0 : 1)
end

@en "CharFind"
@fa "بیاب نویسه"
pub pure func CharFind(s: str, sub: str): int:
    found := s.find(sub)
    if found < 0: ret 0 - 1 end
    off := _bidx_in(s, found)
    bp := _bp(s)
    mut count := 0
    mut i := 0
    until i < off:
        i += CharLen(_ub(bp, i))
        count += 1
    end
    ret count
end

@en "CodePoints"
@fa "کدنقطه ها"
pub func CodePoints(s: str): Vector<int>:
    out := Vector {} as Vector<int>
    n := _blen(s)
    bp := _bp(s)
    mut i := 0
    mut cp := 0
    until i < n:
        i = _decode_at(bp, n, i, cp)
        if cp < 0: cp = 0xFFFD end
        out.push(cp)
    end
    ret out
end

@en "FromCodePoints"
@fa "از کدنقطه ها"
pub func FromCodePoints(cps: Vector<int>): str:
    mut sb := NewBuilder()
    defer BufFree(sb)
    repeat cps.len() in i:
        BufAppendCp(sb, cps.get(i))
    end
    ret BufStr(sb)
end

@en "AllAscii"
@fa "همه اسکی"
pub pure func AllAscii(s: str): bool:
    n := _blen(s)
    bp := _bp(s)
    repeat n in i:
        if _ub(bp, i) >= 128: ret false end
    end
    ret true
end

@en "Chars"
@fa "نویسه ها"
pub func Chars(s: str): Vector<str>:
    out := Vector {} as Vector<str> n := _blen(s)
    bp := _bp(s)
    mut i := 0
    until i < n:
        mut char_len := CharLen(_ub(bp, i))
        if i + char_len > n: char_len = n - i end
        out.push(_bsub(s, i, char_len))
        i += char_len
    end
    ret out
end
