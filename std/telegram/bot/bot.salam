@en "IsCommand"
@fa "دستور است"
pub func IsCommand(text: str): bool:
    ret text.len() > 0 && text.substr(0, 1) == "/"
end

@en "CommandName"
@fa "نام دستور"
pub func CommandName(text: str): str:
    if !IsCommand(text): ret "" end
    sp := text.find(" ")
    mut head := text
    if sp >= 0: head = text.substr(0, sp) end
    at := head.find("@")
    if at >= 0: head = head.substr(0, at) end
    ret head.substr(1, head.len() - 1)
end

@en "CommandArgs"
@fa "آرگومان های دستور"
pub func CommandArgs(text: str): str:
    sp := text.find(" ")
    if sp < 0: ret "" end
    ret text.substr(sp + 1, text.len() - sp - 1).trim()
end

@en "Poll"
@fa "حلقه دریافت"
pub func Poll(bot: Bot, timeout: i64, handler: func (Update)):
    mut offset := 0 as i64
    until true:
        resp := GetUpdates(bot, offset, 100, timeout)
        if resp.ok:
            updates := ParseUpdates(resp.result)
            repeat updates.len() with i:
                u := updates.get(i)
                handler(u)
                if u.update_id >= offset: offset = u.update_id + 1 end
            end
            updates.free()
        else:
            printerr "getUpdates failed (HTTP " + str.FromInt(resp.http_status) + ", code " + str.FromInt(resp.error_code) + "): " + resp.description
            time.Sleep(1000)
        end
    end
end
