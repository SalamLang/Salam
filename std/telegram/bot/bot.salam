@en "telegram.bot"
@fa "بات تلگرام"
package bot

import net.http
import encoding.json
import str
import conv
import time

@en "User"
@fa "کاربر"
pub struct User:
    pub id: i64 = 0
    pub is_bot: bool = false
    pub first_name: str = ""
    pub last_name: str = ""
    pub username: str = ""
    pub language_code: str = ""
end

@en "Chat"
@fa "گفتگو"
pub struct Chat:
    pub id: i64 = 0
    pub chat_type: str = ""
    pub title: str = ""
    pub username: str = ""
    pub first_name: str = ""
    pub last_name: str = ""
end

@en "ReplyTo"
@fa "پاسخ به"
pub struct ReplyTo:
    pub message_id: i64 = 0
    pub user_id: i64 = 0
    pub user_name: str = ""
end

@en "Message"
@fa "پیام"
pub struct Message:
    pub message_id: i64 = 0
    pub date: i64 = 0
    pub chat: Chat = Chat {}
    pub from_user: User = User {}
    pub text: str = ""
    pub caption: str = ""
    pub reply_to: ReplyTo = ReplyTo {}
end

@en "CallbackQuery"
@fa "پرسمان بازخوان"
pub struct CallbackQuery:
    pub id: str = ""
    pub from_user: User = User {}
    pub message: Message = Message {}
    pub has_message: bool = false
    pub data: str = ""
end

@en "InlineQuery"
@fa "پرسمان درون خطی"
pub struct InlineQuery:
    pub id: str = ""
    pub from_user: User = User {}
    pub query: str = ""
    pub offset: str = ""
end

@en "Update"
@fa "بروزرسانی"
pub struct Update:
    pub update_id: i64 = 0
    pub message: Message = Message {}
    pub has_message: bool = false
    pub channel_post: Message = Message {}
    pub has_channel_post: bool = false
    pub callback_query: CallbackQuery = CallbackQuery {}
    pub has_callback_query: bool = false
    pub inline_query: InlineQuery = InlineQuery {}
    pub has_inline_query: bool = false
end

@en "ApiResponse"
@fa "پاسخ ای پی آی"
pub struct ApiResponse:
    pub ok: bool = false
    pub result: str = ""
    pub description: str = ""
    pub error_code: i64 = 0
    pub http_status: int = 0
    pub http_err: str = ""
end

@en "SendOptions"
@fa "گزینه های ارسال"
pub struct SendOptions:
    pub parse_mode: str = ""
    pub disable_notification: bool = false
    pub reply_to_message_id: i64 = 0
    pub reply_markup: str = ""
end

@en "Bot"
@fa "بات"
pub struct Bot:
    pub token: str = ""
end

func _new_params(): HashMap<str, str>:
    ret HashMap {}
end

func _put_chat_id(params: HashMap<str, str>, chat_id: i64):
    params.put("chat_id", str.FromInt(chat_id))
end

func _put_chat_id(params: HashMap<str, str>, chat_id: str):
    params.put("chat_id", chat_id)
end

func _msg_params(chat_id: i64, message_id: i64): HashMap<str, str>:
    mut params := _new_params()
    _put_chat_id(params, chat_id)
    params.put("message_id", str.FromInt(message_id))
    ret params
end

func _user_params(chat_id: i64, user_id: i64): HashMap<str, str>:
    mut params := _new_params()
    _put_chat_id(params, chat_id)
    params.put("user_id", str.FromInt(user_id))
    ret params
end

func _api_url(bot: Bot, method: str): str:
    ret "https://api.telegram.org/bot".concat(bot.token).concat("/").concat(method)
end

func _call(bot: Bot, method: str, params: HashMap<str, str>): ApiResponse:
    url := http.WithQuery(_api_url(bot, method), params)
    defer params.free()
    r := http.Get(url)
    mut resp := ApiResponse {}
    resp.http_status = r.status
    resp.http_err = r.err
    if r.err.len() > 0:
        resp.description = r.err
        ret resp
    end
    resp.ok = json.Get(r.body, "ok") == "true"
    resp.result = json.Get(r.body, "result")
    resp.description = json.Get(r.body, "description")
    resp.error_code = conv.ParseInt(json.Get(r.body, "error_code"))
    if !resp.ok && resp.description.len() == 0:
        resp.description = "no 'description' field in response (HTTP " + str.FromInt(r.status) + "): " + r.body
    end
    ret resp
end

func _send_media(bot: Bot, chat_id: i64, method: str, field: str, media: str, caption: str): ApiResponse:
    mut params := _new_params()
    _put_chat_id(params, chat_id)
    params.put(field, media)
    if caption.len() > 0: params.put("caption", caption) end
    ret _call(bot, method, params)
end

func _bp(s: str): i8*: ret (s as void*) as i8* end

func _ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

func _split_json_array(raw: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    l := raw.len()
    if l < 2: ret out end
    bp := _bp(raw)
    mut i := 0
    until i < l:
        if _ub(bp, i) == 91: break end
        i += 1
    end
    if i >= l: ret out end
    i += 1
    mut depth := 0
    mut in_str := false
    mut start := i
    until i < l:
        code := _ub(bp, i)
        if in_str:
            if code == 92:
                i += 1
            else code == 34:
                in_str = false
            end
        else code == 34:
            in_str = true
        else code == 123 || code == 91:
            depth += 1
        else code == 125 || code == 93:
            if depth == 0:
                if i > start:
                    item := raw.substr(start, i - start).trim()
                    if item.len() > 0: out.push(item) end
                end
                ret out
            end
            depth -= 1
        else code == 44 && depth == 0:
            item := raw.substr(start, i - start).trim()
            if item.len() > 0: out.push(item) end
            start = i + 1
        end
        i += 1
    end
    ret out
end

@en "ParseUser"
@fa "تجزیه کاربر"
pub func ParseUser(raw: str): User:
    mut u := User {}
    if raw.len() == 0: ret u end
    u.id = conv.ParseInt(json.Get(raw, "id"))
    u.is_bot = json.Get(raw, "is_bot") == "true"
    u.first_name = json.Get(raw, "first_name")
    u.last_name = json.Get(raw, "last_name")
    u.username = json.Get(raw, "username")
    u.language_code = json.Get(raw, "language_code")
    ret u
end

@en "ParseChat"
@fa "تجزیه گفتگو"
pub func ParseChat(raw: str): Chat:
    mut c := Chat {}
    if raw.len() == 0: ret c end
    c.id = conv.ParseInt(json.Get(raw, "id"))
    c.chat_type = json.Get(raw, "type")
    c.title = json.Get(raw, "title")
    c.username = json.Get(raw, "username")
    c.first_name = json.Get(raw, "first_name")
    c.last_name = json.Get(raw, "last_name")
    ret c
end

@en "ParseMessage"
@fa "تجزیه پیام"
pub func ParseMessage(raw: str): Message:
    mut m := Message {}
    if raw.len() == 0: ret m end
    m.message_id = conv.ParseInt(json.Get(raw, "message_id"))
    m.date = conv.ParseInt(json.Get(raw, "date"))
    m.chat = ParseChat(json.Get(raw, "chat"))
    m.from_user = ParseUser(json.Get(raw, "from"))
    m.text = json.Get(raw, "text")
    m.caption = json.Get(raw, "caption")
    reply_raw := json.Get(raw, "reply_to_message")
    if reply_raw.len() > 0:
        reply_user := ParseUser(json.Get(reply_raw, "from"))
        m.reply_to.message_id = conv.ParseInt(json.Get(reply_raw, "message_id"))
        m.reply_to.user_id = reply_user.id
        m.reply_to.user_name = reply_user.first_name
    end
    ret m
end

@en "ParseCallbackQuery"
@fa "تجزیه پرسمان بازخوان"
pub func ParseCallbackQuery(raw: str): CallbackQuery:
    mut q := CallbackQuery {}
    if raw.len() == 0: ret q end
    q.id = json.Get(raw, "id")
    q.from_user = ParseUser(json.Get(raw, "from"))
    msg_raw := json.Get(raw, "message")
    if msg_raw.len() > 0:
        q.message = ParseMessage(msg_raw)
        q.has_message = true
    end
    q.data = json.Get(raw, "data")
    ret q
end

@en "ParseInlineQuery"
@fa "تجزیه پرسمان درون خطی"
pub func ParseInlineQuery(raw: str): InlineQuery:
    mut q := InlineQuery {}
    if raw.len() == 0: ret q end
    q.id = json.Get(raw, "id")
    q.from_user = ParseUser(json.Get(raw, "from"))
    q.query = json.Get(raw, "query")
    q.offset = json.Get(raw, "offset")
    ret q
end

@en "ParseUpdate"
@fa "تجزیه بروزرسانی"
pub func ParseUpdate(raw: str): Update:
    mut u := Update {}
    if raw.len() == 0: ret u end
    u.update_id = conv.ParseInt(json.Get(raw, "update_id"))
    msg_raw := json.Get(raw, "message")
    if msg_raw.len() > 0:
        u.message = ParseMessage(msg_raw)
        u.has_message = true
    end
    post_raw := json.Get(raw, "channel_post")
    if post_raw.len() > 0:
        u.channel_post = ParseMessage(post_raw)
        u.has_channel_post = true
    end
    cq_raw := json.Get(raw, "callback_query")
    if cq_raw.len() > 0:
        u.callback_query = ParseCallbackQuery(cq_raw)
        u.has_callback_query = true
    end
    iq_raw := json.Get(raw, "inline_query")
    if iq_raw.len() > 0:
        u.inline_query = ParseInlineQuery(iq_raw)
        u.has_inline_query = true
    end
    ret u
end

@en "ParseUpdates"
@fa "تجزیه بروزرسانی ها"
pub func ParseUpdates(raw: str): Vector<Update>:
    mut out := Vector {} as Vector<Update>
    items := _split_json_array(raw)
    repeat items.len() with i:
        out.push(ParseUpdate(items.get(i)))
    end
    defer items.free()
    ret out
end

@en "NewBot"
@fa "بات جدید"
pub func NewBot(token: str): Bot:
    ret Bot { token = token }
end

@en "Ok"
@fa "موفق"
pub func Ok(resp: ApiResponse): bool:
    ret resp.ok
end

@en "Call"
@fa "فراخوانی"
pub func Call(bot: Bot, method: str, params: HashMap<str, str>): ApiResponse:
    ret _call(bot, method, params)
end

@en "GetMe"
@fa "دریافت من"
pub func GetMe(bot: Bot): ApiResponse:
    ret _call(bot, "getMe", _new_params())
end

@en "GetUpdates"
@fa "دریافت بروزرسانی ها"
pub func GetUpdates(bot: Bot, offset: i64, limit: i64, timeout: i64): ApiResponse:
    mut params := _new_params()
    if offset != 0: params.put("offset", str.FromInt(offset)) end
    if limit > 0: params.put("limit", str.FromInt(limit)) end
    if timeout > 0: params.put("timeout", str.FromInt(timeout)) end
    ret _call(bot, "getUpdates", params)
end

@en "SendMessage"
@fa "ارسال پیام"
pub func SendMessage(bot: Bot, chat_id: i64, text: str): ApiResponse:
    mut params := _new_params()
    _put_chat_id(params, chat_id)
    params.put("text", text)
    ret _call(bot, "sendMessage", params)
end

@en "SendMessage"
@fa "ارسال پیام"
pub func SendMessage(bot: Bot, chat_id: str, text: str): ApiResponse:
    mut params := _new_params()
    _put_chat_id(params, chat_id)
    params.put("text", text)
    ret _call(bot, "sendMessage", params)
end

@en "SendMessageOptions"
@fa "ارسال پیام با گزینه ها"
pub func SendMessageOptions(bot: Bot, chat_id: i64, text: str, opts: SendOptions): ApiResponse:
    mut params := _new_params()
    _put_chat_id(params, chat_id)
    params.put("text", text)
    if opts.parse_mode.len() > 0: params.put("parse_mode", opts.parse_mode) end
    if opts.disable_notification: params.put("disable_notification", "true") end
    if opts.reply_to_message_id > 0: params.put("reply_to_message_id", str.FromInt(opts.reply_to_message_id)) end
    if opts.reply_markup.len() > 0: params.put("reply_markup", opts.reply_markup) end
    ret _call(bot, "sendMessage", params)
end

