@en "BotCommand"
@fa "دستور بات"
pub func BotCommand(command: str, description: str): str:
    mut members := Vector {} as Vector<str>
    members.push(json.Member("command", command))
    members.push(json.Member("description", description))
    out := json.Object(members)
    defer members.free()
    ret out
end

