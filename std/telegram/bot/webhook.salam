package bot

import encoding.json

@en "SECRET_HEADER"
@fa "سرآیند راز"
pub const SECRET_HEADER := "X-Telegram-Bot-Api-Secret-Token"

func _reply(members: Vector<str>): str:
    out := json.Object(members)
    members.Free()
    ret out
end

@en "SetWebhookSecret"
@fa "تنظیم وب هوک با رمز"
pub func SetWebhookSecret(bot: Bot, url: str, secret_token: str): ApiResponse:
    mut params := _new_params()
    params.Put("url", url)
    params.Put("secret_token", secret_token)
    params.Put("drop_pending_updates", "true")
    ret _call(bot, "setWebhook", params)
end

@en "ReplyMessage"
@fa "پاسخ پیام"
pub func ReplyMessage(chat_id: i64, text: str): str:
    ret ReplyMessageOptions(chat_id, text, SendOptions {})
end

@en "ReplyMessageOptions"
@fa "پاسخ پیام با گزینه ها"
pub func ReplyMessageOptions(chat_id: i64, text: str, opts: SendOptions): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("method", "sendMessage"))
    m.Push(json.MemberInt("chat_id", chat_id))
    m.Push(json.Member("text", text))
    if opts.parse_mode.Len() > 0: m.Push(json.Member("parse_mode", opts.parse_mode)) end
    if opts.disable_notification: m.Push(json.MemberBool("disable_notification", true)) end
    if opts.reply_to_message_id > 0: m.Push(json.MemberInt("reply_to_message_id", opts.reply_to_message_id)) end
    if opts.reply_markup.Len() > 0: m.Push(json.MemberRaw("reply_markup", opts.reply_markup)) end
    ret _reply(m)
end

@en "ReplyEditMessageText"
@fa "پاسخ ویرایش متن پیام"
pub func ReplyEditMessageText(chat_id: i64, message_id: i64, text: str, reply_markup: str): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("method", "editMessageText"))
    m.Push(json.MemberInt("chat_id", chat_id))
    m.Push(json.MemberInt("message_id", message_id))
    m.Push(json.Member("text", text))
    if reply_markup.Len() > 0: m.Push(json.MemberRaw("reply_markup", reply_markup)) end
    ret _reply(m)
end

@en "ReplyAnswerCallbackQuery"
@fa "پاسخ فوری پرسمان بازخوان"
pub func ReplyAnswerCallbackQuery(callback_query_id: str, text: str, show_alert: bool): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("method", "answerCallbackQuery"))
    m.Push(json.Member("callback_query_id", callback_query_id))
    if text.Len() > 0: m.Push(json.Member("text", text)) end
    if show_alert: m.Push(json.MemberBool("show_alert", true)) end
    ret _reply(m)
end

@en "ReplyChatAction"
@fa "پاسخ کنش گفتگو"
pub func ReplyChatAction(chat_id: i64, action: str): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("method", "sendChatAction"))
    m.Push(json.MemberInt("chat_id", chat_id))
    m.Push(json.Member("action", action))
    ret _reply(m)
end
