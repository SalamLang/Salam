// Parent namespace marker only: registers the "telegram" segment alias so
// dotted imports like `telegram.bot` can resolve and translate into other
// languages. No exports live here; see std/telegram/bot.
@en "telegram"
@fa "تلگرام"
@ar "تلغرام"
package telegram
