package tensor

import str

const _FMT_MAX := 16

@en "ShapeString"
@fa "رشته شکل"
@ar "نص الشكل"
pub func ShapeString(x &: Tensor): str:
    r := x.rank()
    mut sb := str.NewBuilder()
    if r == 0:
        str.BufAppend(sb, "empty")
    else:
        repeat r with i:
            if i > 0: str.BufAppendChar(sb, 120) end
            str.BufAppendInt(sb, x.shape.get(i) as i64)
        end
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

@en "ToString"
@fa "به رشته"
@ar "إلى نص"
pub func ToString(x &: Tensor): str:
    mut s := "tensor(" + ShapeString(x) + ")["
    n := x.data.len()
    mut show := n
    if show > _FMT_MAX: show = _FMT_MAX end
    repeat show with k:
        if k > 0: s = s + " " end
        s = s + (x.data.get(k) as f64)
    end
    if n > show: s = s + " ..." end
    s = s + "]"
    ret s
end

@en "Print"
@fa "چاپ"
@ar "طباعة"
pub func Print(x &: Tensor):
    println ToString(x)
end

@en "MaxAbsDiff"
@fa "بیشینه اختلاف مطلق"
@ar "أقصى فرق مطلق"
pub func MaxAbsDiff(x &: Tensor, y &: Tensor): f64:
    if x.same_shape(y) == false: ret 1.0e300 end
    n := x.data.len()
    p := x.data.data
    q := y.data.data
    mut worst := 0.0
    repeat n with k:
        d := (p[k] as f64) - (q[k] as f64)
        mut a := d
        if a < 0.0: a = 0.0 - a end
        if a > worst: worst = a end
    end
    ret worst
end

@en "AllClose"
@fa "همه نزدیک"
@ar "الكل قريب"
pub func AllClose(x &: Tensor, y &: Tensor, tol: f64): bool:
    ret MaxAbsDiff(x, y) <= tol
end

@en "Equal"
@fa "برابر"
@ar "متساو"
pub func Equal(x &: Tensor, y &: Tensor): bool:
    if x.same_shape(y) == false: ret false end
    n := x.data.len()
    p := x.data.data
    q := y.data.data
    mut same := true
    repeat n with k:
        if p[k] != q[k]: same = false end
    end
    ret same
end
