package tensor

// Presentation and comparison. Nothing here is a kernel: these functions
// exist for tests, logging and the REPL, and they favour a stable, small
// output over completeness. A tensor with more elements than _FMT_MAX
// prints its head and an ellipsis, because a 4 MB weight tensor printed
// whole helps nobody.

const _FMT_MAX := 16

// ---- public API ----

// "2x3x4" for a rank-3 tensor, "empty" for the error sentinel.
@en "ShapeString"
@fa "رشته شکل"
@ar "نص الشكل"
pub func ShapeString(x &: Tensor): str:
    r := x.rank()
    if r == 0: ret "empty" end
    mut s := "" + x.shape.get(0)
    repeat r - 1 with i:
        s = s + "x" + x.shape.get(i + 1)
    end
    ret s
end

@en "ToString"
@fa "به رشته"
@ar "إلى نص"
pub func ToString(x &: Tensor): str:
    mut s := "tensor(" + ShapeString(x) + ")["
    n := x.data.len()
    mut show := n
    if show > _FMT_MAX: show = _FMT_MAX end
    repeat show with k:
        if k > 0: s = s + " " end
        s = s + (x.data.get(k) as f64)
    end
    if n > show: s = s + " ..." end
    s = s + "]"
    ret s
end

@en "Print"
@fa "چاپ"
@ar "طباعة"
pub func Print(x &: Tensor):
    println ToString(x)
end

// The largest absolute elementwise difference, in f64 so the comparison
// itself adds no f32 rounding. Shapes must match; a mismatch reports the
// stand-in infinity rather than 0, so a shape bug can never pass as
// equality.
@en "MaxAbsDiff"
@fa "بیشینه اختلاف مطلق"
@ar "أقصى فرق مطلق"
pub func MaxAbsDiff(x &: Tensor, y &: Tensor): f64:
    if x.same_shape(y) == false: ret 1.0e300 end
    n := x.data.len()
    p := x.data.data
    q := y.data.data
    mut worst := 0.0
    repeat n with k:
        d := (p[k] as f64) - (q[k] as f64)
        mut a := d
        if a < 0.0: a = 0.0 - a end
        if a > worst: worst = a end
    end
    ret worst
end

@en "AllClose"
@fa "همه نزدیک"
@ar "الكل قريب"
pub func AllClose(x &: Tensor, y &: Tensor, tol: f64): bool:
    ret MaxAbsDiff(x, y) <= tol
end

// Bitwise value equality, the check the deterministic-parallelism tests
// rely on: serial and parallel runs of the same kernel must agree exactly,
// not merely within tolerance.
@en "Equal"
@fa "برابر"
@ar "متساو"
pub func Equal(x &: Tensor, y &: Tensor): bool:
    if x.same_shape(y) == false: ret false end
    n := x.data.len()
    p := x.data.data
    q := y.data.data
    mut same := true
    repeat n with k:
        if p[k] != q[k]: same = false end
    end
    ret same
end
