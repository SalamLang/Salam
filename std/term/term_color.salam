// The 256-colour cube: 0-7 standard, 8-15 bright, 16-231 a 6x6x6 RGB cube,
// 232-255 a 24-step grey ramp.
@en "Color256"
@fa "رنگ ۲۵۶"
@ar "لون ۲۵۶"
pub func Color256(s: str, n: int): str: ret Paint(s, SeqFg256(n)) end

@en "OnColor256"
@fa "زمینه رنگ ۲۵۶"
@ar "خلفیة لون ۲۵۶"
pub func OnColor256(s: str, n: int): str: ret Paint(s, SeqBg256(n)) end

@en "RGB"
@fa "آراگابی"
@ar "آر‌جي‌بي"
pub func RGB(s: str, r: int, g: int, b: int): str: ret Paint(s, SeqFgRGB(r, g, b)) end

@en "OnRGB"
@fa "زمینه آراگابی"
@ar "خلفیة آر‌جي‌بي"
pub func OnRGB(s: str, r: int, g: int, b: int): str: ret Paint(s, SeqBgRGB(r, g, b)) end

// ------------------------------------------------- escape-aware string work

// Strip removes every escape sequence, leaving the text a user would see.
// This is what to write into a log file, and what to measure a column with.
@en "Strip"
@fa "پاک‌سازی"
@ar "تجرید"
pub func Strip(s: str): str:
    n := s.len()
    bp := _bp(s)
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut i := 0
    until i < n:
        if _ub(bp, i) == 27:
            i = _esc_end(s, i, n)
        else:
            str.BufAppendChar(b, _ub(bp, i))
            i += 1
        end
    end
    out := str.BufStr(b)
    ret out
end

// Width is the visible width in codepoints: escape sequences count for
// nothing, and a multi-byte character counts once (not once per byte, which
// is what str.Len would say and why fmt.PadRight misaligns coloured tables).
@en "Width"
@fa "پهنا"
@ar "عرض"
pub func Width(s: str): int:
    n := s.len()
    bp := _bp(s)
    mut count := 0
    mut i := 0
    until i < n:
        if _ub(bp, i) == 27:
            i = _esc_end(s, i, n)
        else:
            i += str.CharLen(_ub(bp, i))
            count += 1
        end
    end
    ret count
end

// Truncate cuts to `n` visible codepoints, carrying every escape sequence
// through so the styling that was in force still applies to what remains,
// and closing with a reset if anything was left open.
@en "Truncate"
@fa "کوتاه‌سازی"
@ar "اقتطاع"
pub func Truncate(s: str, n: int): str:
    if n <= 0: ret "" end
    if Width(s) <= n: ret s end
    total := s.len()
    bp := _bp(s)
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut styled := false
    mut count := 0
    mut i := 0
    until i < total && count < n:
        if _ub(bp, i) == 27:
            e := _esc_end(s, i, total)
            str.BufAppend(b, str.Substr(s, i, e - i))
            styled = true
            i = e
        else:
            w := str.CharLen(_ub(bp, i))
            str.BufAppend(b, str.Substr(s, i, w))
            i += w
            count += 1
        end
    end
    if styled: str.BufAppend(b, Reset) end
    out := str.BufStr(b)
    ret out
end

// PadRight/PadLeft/Center measure with Width instead of byte length, which
// is the difference between a table that lines up once its cells are
// coloured and one that does not. fmt.PadRight is the right choice for
// plain text; these are for text that may carry escapes.
@en "PadRight"
@fa "پرکردن راست"
@ar "حشو یمین"
pub func PadRight(s: str, n: int): str:
    w := Width(s)
    if w >= n: ret s end
    ret s + str.Repeat(" ", n - w)
end

@en "PadLeft"
@fa "پرکردن چپ"
@ar "حشو یسار"
pub func PadLeft(s: str, n: int): str:
    w := Width(s)
    if w >= n: ret s end
    ret str.Repeat(" ", n - w) + s
end

@en "Center"
@fa "وسط‌چین"
@ar "توسیط"
pub func Center(s: str, n: int): str:
    w := Width(s)
    if w >= n: ret s end
    left := (n - w) / 2
    ret str.Repeat(" ", left) + s + str.Repeat(" ", n - w - left)
end
