// The bright ("aixterm") pairs, 90-97 and 100-107. Prefer these to
// bold-plus-colour: bold is a font weight and terminals are free to render
// it without brightening anything.
@en "FgBright"
@fa "افزونه روشن"
@ar "إزاحة ساطعة"
pub const FgBright := 60

// -------------------------------------------------------------- internals

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

// A str byte as 0..255. Salam's i8 is signed, so the high half arrives
// negative and has to be folded back up before it is compared to a byte.
inline pure func _ub(bp: i8*, i: int): int:
    v := bp[i] as int
    if v < 0: ret v + 256 end
    ret v
end

// Index just past the escape sequence that starts at `i` (which must be an
// ESC). Handles the three shapes that actually turn up in terminal output:
//   CSI  ESC [ ... final byte in 0x40..0x7E   (colours, cursor moves)
//   OSC  ESC ] ... BEL, or ESC \              (window titles, hyperlinks)
//   two-byte  ESC <one byte>                  (charset selection, ESC 7/8)
// An unterminated sequence consumes the rest of the string, which is the
// only reading that cannot loop forever.
func _esc_end(s: str, i: int, n: int): int:
    bp := _bp(s)
    if i + 1 >= n: ret n end
    k := _ub(bp, i + 1)
    if k == 91: // '['
        mut j := i + 2
        until j < n:
            c := _ub(bp, j)
            if c >= 0x40 && c <= 0x7E: ret j + 1 end
            j += 1
        end
        ret n
    end
    if k == 93: // ']'
        mut j := i + 2
        until j < n:
            c := _ub(bp, j)
            if c == 7: ret j + 1 end // BEL
            if c == 27 && j + 1 < n && _ub(bp, j + 1) == 92: ret j + 2 end // ESC '\'
            j += 1
        end
        ret n
    end
    ret i + 2
end

// ------------------------------------------------------------- raw sequences

// Sgr builds one Select-Graphic-Rendition sequence. It is never gated on
// colour support - it is the primitive the gated helpers are made of.
@en "Sgr"
@fa "دنباله نمایش"
@ar "تسلسل العرض"
pub func Sgr(code: int): str: ret Csi + str.FromInt(code as i64) + "m" end

@en "SeqFg256"
@fa "دنباله پیش‌زمینه ۲۵۶"
@ar "تسلسل مقدمة ۲۵۶"
pub func SeqFg256(n: int): str: ret Csi + "38;5;" + str.FromInt(n as i64) + "m" end

@en "SeqBg256"
@fa "دنباله پس‌زمینه ۲۵۶"
@ar "تسلسل خلفیة ۲۵۶"
pub func SeqBg256(n: int): str: ret Csi + "48;5;" + str.FromInt(n as i64) + "m" end

@en "SeqFgRGB"
@fa "دنباله پیش‌زمینه آراگابی"
@ar "تسلسل مقدمة آر‌جي‌بي"
pub func SeqFgRGB(r: int, g: int, b: int): str:
    ret Csi + "38;2;" + str.FromInt(r as i64) + ";" + str.FromInt(g as i64) + ";" + str.FromInt(b as i64) + "m"
end

@en "SeqBgRGB"
@fa "دنباله پس‌زمینه آراگابی"
@ar "تسلسل خلفیة آر‌جي‌بي"
pub func SeqBgRGB(r: int, g: int, b: int): str:
    ret Csi + "48;2;" + str.FromInt(r as i64) + ";" + str.FromInt(g as i64) + ";" + str.FromInt(b as i64) + "m"
end

// --------------------------------------------------------------- painting

// Paint is the one place colour is actually applied, and the only one that
// consults SupportsColor - every named helper below is a call to it.
//
// The str.Replace is what makes nesting work. Text that already carries a
// reset (because it was painted first) would otherwise cancel the outer
// style at that point and leave the remainder plain; re-arming `prefix`
// after each inner reset hands the outer style back instead.
@en "Paint"
@fa "رنگ‌آمیزی"
@ar "تلوین"
pub func Paint(s: str, prefix: str): str:
    if !SupportsColor(): ret s end
    if s.len() == 0: ret s end
    mut body := s
    if str.Contains(s, Reset): body = str.Replace(s, Reset, Reset + prefix) end
    ret prefix + body + Reset
end

// Style applies a bare SGR code, e.g. Style(s, term.StyleUnderline).
@en "Style"
@fa "سبک"
@ar "نمط"
pub func Style(s: str, code: int): str: ret Paint(s, Sgr(code)) end

@en "Bold"
@fa "ضخیم"
@ar "عریض"
pub func Bold(s: str): str: ret Style(s, StyleBold) end

@en "Dim"
@fa "کم‌رنگ"
