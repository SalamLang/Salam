package term

import str

@en "Reset"
@fa "بازنشانی"
pub const Reset := "\x1b[0m"

@en "StyleBold"
@fa "سبک ضخیم"
pub const StyleBold := 1

@en "StyleDim"
@fa "سبک کم‌رنگ"
pub const StyleDim := 2

@en "StyleItalic"
@fa "سبک کج"
pub const StyleItalic := 3

@en "StyleUnderline"
@fa "سبک زیرخط"
pub const StyleUnderline := 4

@en "StyleBlink"
@fa "سبک چشمک"
pub const StyleBlink := 5

@en "StyleReverse"
@fa "سبک وارونه"
pub const StyleReverse := 7

@en "StyleHidden"
@fa "سبک پنهان"
pub const StyleHidden := 8

@en "StyleStrike"
@fa "سبک خط‌خورده"
pub const StyleStrike := 9

@en "FgBlack"
@fa "پیش‌زمینه سیاه"
pub const FgBlack := 30

@en "FgRed"
@fa "پیش‌زمینه قرمز"
pub const FgRed := 31

@en "FgGreen"
@fa "پیش‌زمینه سبز"
pub const FgGreen := 32

@en "FgYellow"
@fa "پیش‌زمینه زرد"
pub const FgYellow := 33

@en "FgBlue"
@fa "پیش‌زمینه آبی"
pub const FgBlue := 34

@en "FgMagenta"
@fa "پیش‌زمینه ارغوانی"
pub const FgMagenta := 35

@en "FgCyan"
@fa "پیش‌زمینه فیروزه‌ای"
pub const FgCyan := 36

@en "FgWhite"
@fa "پیش‌زمینه سفید"
pub const FgWhite := 37

@en "FgDefault"
@fa "پیش‌زمینه پیش‌فرض"
pub const FgDefault := 39

@en "BgBlack"
@fa "پس‌زمینه سیاه"
pub const BgBlack := 40

@en "BgRed"
@fa "پس‌زمینه قرمز"
pub const BgRed := 41

@en "BgGreen"
@fa "پس‌زمینه سبز"
pub const BgGreen := 42

@en "BgYellow"
@fa "پس‌زمینه زرد"
pub const BgYellow := 43

@en "BgBlue"
@fa "پس‌زمینه آبی"
pub const BgBlue := 44

@en "BgMagenta"
@fa "پس‌زمینه ارغوانی"
pub const BgMagenta := 45

@en "BgCyan"
@fa "پس‌زمینه فیروزه‌ای"
pub const BgCyan := 46

@en "BgWhite"
@fa "پس‌زمینه سفید"
pub const BgWhite := 47

@en "BgDefault"
@fa "پس‌زمینه پیش‌فرض"
pub const BgDefault := 49

@en "FgBright"
@fa "افزونه روشن"
pub const FgBright := 60

inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _ub(bp: i8*, i: int): int:
    v := bp[i] as int
    if v < 0: ret v + 256 end
    ret v
end

func _esc_end(s: str, i: int, n: int): int:
    bp := _bp(s)
    if i + 1 >= n: ret n end
    k := _ub(bp, i + 1)
    if k == 91:
        mut j := i + 2
        until j < n:
            c := _ub(bp, j)
            if c >= 0x40 && c <= 0x7E: ret j + 1 end
            j += 1
        end
        ret n
    end
    if k == 93:
        mut j := i + 2
        until j < n:
            c := _ub(bp, j)
            if c == 7: ret j + 1 end
            if c == 27 && j + 1 < n && _ub(bp, j + 1) == 92: ret j + 2 end
            j += 1
        end
        ret n
    end
    ret i + 2
end

@en "Sgr"
@fa "دنباله نمایش"
pub func Sgr(code: int): str: ret Csi + str.FromInt(code as i64) + "m" end

@en "SeqFg256"
@fa "دنباله پیش‌زمینه ۲۵۶"
pub func SeqFg256(n: int): str: ret Csi + "38;5;" + str.FromInt(n as i64) + "m" end

@en "SeqBg256"
@fa "دنباله پس‌زمینه ۲۵۶"
pub func SeqBg256(n: int): str: ret Csi + "48;5;" + str.FromInt(n as i64) + "m" end

@en "SeqFgRGB"
@fa "دنباله پیش‌زمینه آراگابی"
pub func SeqFgRGB(r: int, g: int, b: int): str:
    ret Csi + "38;2;" + str.FromInt(r as i64) + ";" + str.FromInt(g as i64) + ";" + str.FromInt(b as i64) + "m"
end

@en "SeqBgRGB"
@fa "دنباله پس‌زمینه آراگابی"
pub func SeqBgRGB(r: int, g: int, b: int): str:
    ret Csi + "48;2;" + str.FromInt(r as i64) + ";" + str.FromInt(g as i64) + ";" + str.FromInt(b as i64) + "m"
end

@en "Paint"
@fa "رنگ‌آمیزی"
pub func Paint(s: str, prefix: str): str:
    if !SupportsColor(): ret s end
    if s.len() == 0: ret s end
    mut body := s
    if str.Contains(s, Reset): body = str.Replace(s, Reset, Reset + prefix) end
    ret prefix + body + Reset
end

@en "Style"
@fa "سبک"
pub func Style(s: str, code: int): str: ret Paint(s, Sgr(code)) end

@en "Bold"
@fa "ضخیم"
pub func Bold(s: str): str: ret Style(s, StyleBold) end

