package term

import str

// Cursor movement, erasing, scrolling, the alternate screen and mouse
// reporting. Each operation comes as a pair:
//
//   SeqUp(2)  -> "\x1b[2A"   builds the sequence, changes nothing
//   Up(2)                    writes it and flushes
//
// Build with the `Seq*` half and write once when a redraw touches many
// places - one write of a whole frame does not tear the way a dozen
// separate ones can.
//
// Rows and columns are 1-based, as they are in the escape sequences
// themselves: the top-left cell is (1, 1), not (0, 0).
//
// Movement by a non-positive count returns the empty string rather than a
// sequence. This is not just tidiness: terminals read a 0 parameter as 1,
// so `CSI 0A` would move up a line instead of standing still, and a loop
// that happens to compute a zero step would drift up the screen.

// -------------------------------------------------------------- internals

func _csi_n(n: int, final: str): str:
    if n <= 0: ret "" end
    ret Csi + str.FromInt(n as i64) + final
end

// ------------------------------------------------------------- cursor moves

@en "SeqUp"
@fa "دنباله بالا"
@ar "تسلسل أعلی"
pub func SeqUp(n: int): str: ret _csi_n(n, "A") end

@en "SeqDown"
@fa "دنباله پایین"
@ar "تسلسل أسفل"
pub func SeqDown(n: int): str: ret _csi_n(n, "B") end

@en "SeqRight"
@fa "دنباله راست"
@ar "تسلسل یمین"
pub func SeqRight(n: int): str: ret _csi_n(n, "C") end

@en "SeqLeft"
@fa "دنباله چپ"
@ar "تسلسل یسار"
pub func SeqLeft(n: int): str: ret _csi_n(n, "D") end

@en "SeqNextLine"
@fa "دنباله خط بعد"
@ar "تسلسل السطر التالي"
pub func SeqNextLine(n: int): str: ret _csi_n(n, "E") end

@en "SeqPrevLine"
@fa "دنباله خط قبل"
@ar "تسلسل السطر السابق"
pub func SeqPrevLine(n: int): str: ret _csi_n(n, "F") end

@en "SeqColumn"
@fa "دنباله ستون"
@ar "تسلسل العمود"
pub func SeqColumn(col: int): str: ret _csi_n(col, "G") end

@en "SeqMoveTo"
@fa "دنباله رفتن به"
@ar "تسلسل الانتقال"
pub func SeqMoveTo(row: int, col: int): str:
    ret Csi + str.FromInt(row as i64) + ";" + str.FromInt(col as i64) + "H"
end

@en "SeqHome"
@fa "دنباله خانه"
@ar "تسلسل البدایة"
pub func SeqHome(): str: ret Csi + "H" end

// DECSC/DECRC rather than the CSI s/u pair: these save the character
// attributes along with the position, so a restore also puts the colour
// back, and they are the form Windows' virtual terminal also honours.
@en "SeqSaveCursor"
@fa "دنباله ذخیره مکان‌نما"
@ar "تسلسل حفظ المؤشر"
pub func SeqSaveCursor(): str: ret Esc + "7" end

@en "SeqRestoreCursor"
@fa "دنباله بازیابی مکان‌نما"
@ar "تسلسل استعادة المؤشر"
pub func SeqRestoreCursor(): str: ret Esc + "8" end

@en "SeqHideCursor"
@fa "دنباله پنهان‌سازی مکان‌نما"
@ar "تسلسل إخفاء المؤشر"
pub func SeqHideCursor(): str: ret Csi + "?25l" end

@en "SeqShowCursor"
@fa "دنباله نمایش مکان‌نما"
@ar "تسلسل إظهار المؤشر"
pub func SeqShowCursor(): str: ret Csi + "?25h" end

// ------------------------------------------------------------------ erasing

// CSI 2J erases the screen but leaves the cursor where it was, which is
// almost never what a caller means by "clear"; the home is included.
@en "SeqClearScreen"
@fa "دنباله پاک‌سازی صفحه"
@ar "تسلسل مسح الشاشة"
pub func SeqClearScreen(): str: ret Csi + "2J" + Csi + "H" end

// CSI 3J drops the scrollback too - the `clear`-command behaviour, as
// opposed to merely blanking the visible screen.
@en "SeqClearScrollback"
@fa "دنباله پاک‌سازی پیشینه"
@ar "تسلسل مسح السجل"
pub func SeqClearScrollback(): str: ret Csi + "3J" end

@en "SeqClearLine"
@fa "دنباله پاک‌سازی خط"
@ar "تسلسل مسح السطر"
pub func SeqClearLine(): str: ret Csi + "2K" end

@en "SeqClearToLineEnd"
@fa "دنباله پاک تا پایان خط"
@ar "تسلسل مسح حتی نهایة السطر"
pub func SeqClearToLineEnd(): str: ret Csi + "K" end

@en "SeqClearToLineStart"
@fa "دنباله پاک تا آغاز خط"
@ar "تسلسل مسح حتی بدایة السطر"
pub func SeqClearToLineStart(): str: ret Csi + "1K" end

@en "SeqClearBelow"
@fa "دنباله پاک به پایین"
@ar "تسلسل مسح للأسفل"
pub func SeqClearBelow(): str: ret Csi + "J" end

@en "SeqClearAbove"
@fa "دنباله پاک به بالا"
@ar "تسلسل مسح للأعلی"
pub func SeqClearAbove(): str: ret Csi + "1J" end

// The line a progress bar or a spinner redraws over: back to column 1 and
// wipe, so a shorter new line cannot leave the tail of the old one behind.
@en "SeqResetLine"
@fa "دنباله بازنشانی خط"
@ar "تسلسل إعادة السطر"
pub func SeqResetLine(): str: ret "\r" + Csi + "2K" end

// ----------------------------------------------------------------- scrolling

@en "SeqScrollUp"
@fa "دنباله پیمایش بالا"
@ar "تسلسل تمریر أعلی"
pub func SeqScrollUp(n: int): str: ret _csi_n(n, "S") end

@en "SeqScrollDown"
@fa "دنباله پیمایش پایین"
@ar "تسلسل تمریر أسفل"
pub func SeqScrollDown(n: int): str: ret _csi_n(n, "T") end

@en "SeqInsertLines"
@fa "دنباله درج خط"
@ar "تسلسل إدراج سطور"
pub func SeqInsertLines(n: int): str: ret _csi_n(n, "L") end

@en "SeqDeleteLines"
@fa "دنباله حذف خط"
@ar "تسلسل حذف سطور"
pub func SeqDeleteLines(n: int): str: ret _csi_n(n, "M") end

// DECSTBM confines scrolling to rows top..bottom, which is how a full-screen
// app keeps a header or a status bar still while the middle scrolls.
@en "SeqScrollRegion"
@fa "دنباله ناحیه پیمایش"
@ar "تسلسل منطقة التمریر"
pub func SeqScrollRegion(top: int, bottom: int): str:
    ret Csi + str.FromInt(top as i64) + ";" + str.FromInt(bottom as i64) + "r"
end

@en "SeqResetScrollRegion"
@fa "دنباله بازنشانی ناحیه پیمایش"
@ar "تسلسل إعادة منطقة التمریر"
pub func SeqResetScrollRegion(): str: ret Csi + "r" end

// ---------------------------------------------------------- screens & mouse

// 1049 switches to the alternate screen AND saves the cursor, so leaving it
// puts the user's shell back exactly as they left it - no scrollback eaten.
// Anything drawn on the alternate screen is gone on exit, which is the
// contract full-screen programs like an editor or a pager want.
@en "SeqEnterAltScreen"
@fa "دنباله ورود به صفحه جایگزین"
@ar "تسلسل دخول الشاشة البدیلة"
pub func SeqEnterAltScreen(): str: ret Csi + "?1049h" end

@en "SeqExitAltScreen"
@fa "دنباله خروج از صفحه جایگزین"
@ar "تسلسل خروج الشاشة البدیلة"
pub func SeqExitAltScreen(): str: ret Csi + "?1049l" end

// Mode 1000 reports button presses, 1002 adds drags, 1003 every motion;
// 1006 asks for the SGR encoding, which is the only one that can express a
// column past 223. term_key.salam decodes what comes back.
@en "SeqEnableMouse"
@fa "دنباله فعال‌سازی موشواره"
@ar "تسلسل تفعیل الفأرة"
pub func SeqEnableMouse(): str: ret Csi + "?1000h" + Csi + "?1006h" end

@en "SeqEnableMouseMotion"
@fa "دنباله فعال‌سازی حرکت موشواره"
@ar "تسلسل تفعیل حرکة الفأرة"
pub func SeqEnableMouseMotion(): str: ret Csi + "?1003h" + Csi + "?1006h" end

@en "SeqDisableMouse"
@fa "دنباله غیرفعال‌سازی موشواره"
@ar "تسلسل تعطیل الفأرة"
pub func SeqDisableMouse(): str: ret Csi + "?1006l" + Csi + "?1003l" + Csi + "?1002l" + Csi + "?1000l" end

// ------------------------------------------------------- write-now versions

@en "Up"
@fa "بالا"
@ar "أعلی"
pub func Up(n: int): Emit(SeqUp(n)) end

@en "Down"
@fa "پایین"
@ar "أسفل"
pub func Down(n: int): Emit(SeqDown(n)) end

@en "Right"
@fa "راست"
@ar "یمین"
pub func Right(n: int): Emit(SeqRight(n)) end

@en "Left"
@fa "چپ"
@ar "یسار"
pub func Left(n: int): Emit(SeqLeft(n)) end

@en "NextLine"
@fa "خط بعد"
@ar "السطر التالي"
pub func NextLine(n: int): Emit(SeqNextLine(n)) end

@en "PrevLine"
@fa "خط قبل"
@ar "السطر السابق"
pub func PrevLine(n: int): Emit(SeqPrevLine(n)) end

@en "Column"
@fa "ستون"
@ar "عمود"
pub func Column(col: int): Emit(SeqColumn(col)) end

@en "MoveTo"
@fa "رفتن به"
@ar "الانتقال إلی"
pub func MoveTo(row: int, col: int): Emit(SeqMoveTo(row, col)) end

@en "Home"
@fa "خانه"
@ar "البدایة"
pub func Home(): Emit(SeqHome()) end

@en "SaveCursor"
@fa "ذخیره مکان‌نما"
@ar "حفظ المؤشر"
pub func SaveCursor(): Emit(SeqSaveCursor()) end

@en "RestoreCursor"
@fa "بازیابی مکان‌نما"
@ar "استعادة المؤشر"
pub func RestoreCursor(): Emit(SeqRestoreCursor()) end

@en "HideCursor"
@fa "پنهان‌سازی مکان‌نما"
@ar "إخفاء المؤشر"
pub func HideCursor(): Emit(SeqHideCursor()) end

@en "ShowCursor"
@fa "نمایش مکان‌نما"
@ar "إظهار المؤشر"
pub func ShowCursor(): Emit(SeqShowCursor()) end

@en "ClearScreen"
@fa "پاک‌سازی صفحه"
@ar "مسح الشاشة"
pub func ClearScreen(): Emit(SeqClearScreen()) end

@en "ClearScrollback"
@fa "پاک‌سازی پیشینه"
@ar "مسح السجل"
pub func ClearScrollback(): Emit(SeqClearScrollback()) end

@en "ClearLine"
@fa "پاک‌سازی خط"
@ar "مسح السطر"
pub func ClearLine(): Emit(SeqClearLine()) end

@en "ClearToLineEnd"
@fa "پاک تا پایان خط"
@ar "مسح حتی نهایة السطر"
pub func ClearToLineEnd(): Emit(SeqClearToLineEnd()) end

@en "ClearBelow"
@fa "پاک به پایین"
@ar "مسح للأسفل"
pub func ClearBelow(): Emit(SeqClearBelow()) end

@en "ResetLine"
@fa "بازنشانی خط"
@ar "إعادة السطر"
pub func ResetLine(): Emit(SeqResetLine()) end

@en "ScrollUp"
@fa "پیمایش بالا"
@ar "تمریر أعلی"
pub func ScrollUp(n: int): Emit(SeqScrollUp(n)) end

@en "ScrollDown"
@fa "پیمایش پایین"
@ar "تمریر أسفل"
pub func ScrollDown(n: int): Emit(SeqScrollDown(n)) end

@en "InsertLines"
@fa "درج خط"
@ar "إدراج سطور"
pub func InsertLines(n: int): Emit(SeqInsertLines(n)) end

@en "DeleteLines"
@fa "حذف خط"
@ar "حذف سطور"
pub func DeleteLines(n: int): Emit(SeqDeleteLines(n)) end

@en "SetScrollRegion"
@fa "تنظیم ناحیه پیمایش"
@ar "ضبط منطقة التمریر"
pub func SetScrollRegion(top: int, bottom: int): Emit(SeqScrollRegion(top, bottom)) end

@en "ResetScrollRegion"
@fa "بازنشانی ناحیه پیمایش"
@ar "إعادة منطقة التمریر"
pub func ResetScrollRegion(): Emit(SeqResetScrollRegion()) end

@en "EnterAltScreen"
@fa "ورود به صفحه جایگزین"
@ar "دخول الشاشة البدیلة"
pub func EnterAltScreen(): Emit(SeqEnterAltScreen()) end

@en "ExitAltScreen"
@fa "خروج از صفحه جایگزین"
@ar "خروج الشاشة البدیلة"
pub func ExitAltScreen(): Emit(SeqExitAltScreen()) end

@en "EnableMouse"
@fa "فعال‌سازی موشواره"
@ar "تفعیل الفأرة"
pub func EnableMouse(): Emit(SeqEnableMouse()) end

@en "DisableMouse"
@fa "غیرفعال‌سازی موشواره"
@ar "تعطیل الفأرة"
pub func DisableMouse(): Emit(SeqDisableMouse()) end
