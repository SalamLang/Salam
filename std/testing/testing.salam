@en "testing"
@fa "آزمایش"
package testing

import conv
import os
import str

mut _tpass := 0
mut _tfail := 0
mut _tformat := 0
mut _tname := ""
mut _tfile := ""
mut _tfail_at := 0
mut _tlast := ""
mut _tcount := 0
mut _tbad := 0
mut _tfilter := ""

func record(cond: bool, msg: str):
    if cond:
        _tpass += 1
    else:
        _tfail += 1
        _tlast = msg
        printerr "FAIL: "
        printerrln msg
    end
end

func tc_escape(s: str): str:
    mut out := str.Replace(s, "|", "||")
    out = str.Replace(out, "'", "|'")
    out = str.Replace(out, "\n", "|n")
    out = str.Replace(out, "\r", "|r")
    out = str.Replace(out, "[", "|[")
    ret str.Replace(out, "]", "|]")
end

func fail_pair(label: str, got: str, want: str):
    _tfail += 1
    _tlast = label + got + " want " + want
    printerr "FAIL: "
    printerr label
    printerr got
    printerr " want "
    printerrln want
end

@en "Assert"
@fa "ادعا"
pub func Assert(cond: bool): record(cond, "assertion failed") end

@en "AssertMsg"
@fa "ادعا با پیام"
pub func AssertMsg(cond: bool, msg: str): record(cond, msg) end

@en "AssertTrue"
@fa "ادعای درستی"
pub func AssertTrue(cond: bool): record(cond, "expected true") end

@en "AssertFalse"
@fa "ادعای نادرستی"
pub func AssertFalse(cond: bool): record(cond == false, "expected false") end

@en "AssertEqInt"
@fa "ادعای برابری عدد"
pub func AssertEqInt(got: int, want: int):
    if got == want:
        _tpass += 1
        ret
    end
    fail_pair("ints differ: got ", conv.FormatInt(got as i64), conv.FormatInt(want as i64))
end

@en "AssertEqInt64"
@fa "ادعای برابری عدد۶۴"
pub func AssertEqInt64(got: i64, want: i64):
    if got == want:
        _tpass += 1
        ret
    end
    fail_pair("ints differ: got ", conv.FormatInt(got), conv.FormatInt(want))
end

@en "AssertEqFloat"
@fa "ادعای برابری اعشار"
pub func AssertEqFloat(got: f64, want: f64, eps: f64):
    mut diff := got - want
    if diff < 0.0: diff = 0.0 - diff end
    if diff <= eps:
        _tpass += 1
        ret
    end
    fail_pair("floats differ: got ", conv.FormatFloat(got), conv.FormatFloat(want))
end

@en "AssertContains"
@fa "ادعای شامل بودن"
pub func AssertContains(hay: str, needle: str):
    if hay.find(needle) >= 0:
        _tpass += 1
        ret
    end
    fail_pair("string does not contain: got ", hay, needle)
end

@en "AssertEqStr"
@fa "ادعای برابری رشته"
pub func AssertEqStr(got: str, want: str):
    if got == want:
        _tpass += 1
        ret
    end
    fail_pair("strings differ: got ", got, want)
end

@en "AssertEqBool"
@fa "ادعای برابری منطقی"
pub func AssertEqBool(got: bool, want: bool):
    record(got == want, "bools differ")
end

@en "AssertNeInt"
@fa "ادعای نابرابری عدد"
pub func AssertNeInt(a: int, b: int):
    record(a != b, "ints unexpectedly equal")
end

@en "AssertNeStr"
@fa "ادعای نابرابری رشته"
pub func AssertNeStr(a: str, b: str):
    record((a == b) == false, "strings unexpectedly equal")
end

@en "AssertNil"
@fa "ادعای خالی بودن"
pub func AssertNil(p: void*): record(p == null, "expected nil") end

@en "AssertNotNil"
@fa "ادعای خالی نبودن"
pub func AssertNotNil(p: void*): record((p == null) == false, "expected non-nil") end

@en "Reset"
@fa "بازنشانی"
pub func Reset():
    _tpass = 0
    _tfail = 0
end

@en "Passed"
@fa "موفق"
pub func Passed(): int: ret _tpass end

@en "Failed"
@fa "ناموفق"
pub func Failed(): int: ret _tfail end

@en "Summary"
@fa "خلاصه"
pub func Summary(): int:
    println "--"
    print "tests: "
    print _tpass
    print " passed, "
    print _tfail
    println " failed"
    ret _tfail
end

@en "SetFormat"
@fa "قالب گزارش"
pub func SetFormat(format: str):
    _tformat = format == "teamcity" ? 1 : 0
end

@en "SetFilter"
@fa "پالایه آزمون"
pub func SetFilter(part: str):
    _tfilter = part
end

@en "Selected"
@fa "انتخاب شده"
pub func Selected(name: str): bool:
    if str.Len(_tfilter) == 0:
        ret true
    end
    mut f := _tfilter
    at_start := str.StartsWith(f, "^")
    if at_start:
        f = f.substr(1, str.Len(f) - 1)
    end
    at_end := str.EndsWith(f, "$")
    if at_end:
        f = f.substr(0, str.Len(f) - 1)
    end
    if at_start and at_end:
        ret str.Equals(name, f)
    else at_start:
        ret str.StartsWith(name, f)
    else at_end:
        ret str.EndsWith(name, f)
    end
    ret str.Contains(name, f)
end

@en "SuiteStart"
@fa "شروع مجموعه"
pub func SuiteStart(file: str):
    _tfile = file
    _tcount = 0
    _tbad = 0
    if _tformat == 1:
        println "##teamcity[testSuiteStarted name='" + tc_escape(file) + "' locationHint='salam://" + tc_escape(file) + "']"
    end
end

@en "Begin"
@fa "شروع آزمون"
pub func Begin(name: str, line: int):
    _tname = name
    _tfail_at = _tfail
    _tlast = ""
    if _tformat == 1:
        println "##teamcity[testStarted name='" + tc_escape(name) + "' locationHint='salam://" + tc_escape(_tfile) + ":" + conv.FormatInt(line as i64) + "' captureStandardOutput='true']"
    else:
        println "=== RUN   " + name
    end
end

@en "End"
@fa "اتمام آزمون"
pub func End():
    _tcount += 1
    failed := _tfail > _tfail_at
    if failed:
        _tbad += 1
    end
    if _tformat == 1:
        if failed:
            println "##teamcity[testFailed name='" + tc_escape(_tname) + "' message='" + tc_escape(_tlast) + "']"
        end
        println "##teamcity[testFinished name='" + tc_escape(_tname) + "']"
    else:
        verdict := failed ? "--- FAIL: " : "--- PASS: "
        println verdict + _tname
    end
end

@en "Finish"
@fa "جمع‌بندی آزمون‌ها"
pub func Finish():
    if _tformat == 1:
        println "##teamcity[testSuiteFinished name='" + tc_escape(_tfile) + "']"
    else:
        if _tbad > 0:
            println "FAIL " + _tfile + ": " + conv.FormatInt(_tbad as i64) + " of " + conv.FormatInt(_tcount as i64) + " tests failed"
        else:
            println "ok   " + _tfile + ": " + conv.FormatInt(_tcount as i64) + " tests passed"
        end
    end
    if _tbad > 0:
        os.Exit(1)
    end
end
