@en "diff"
@fa "تفاوت"
package diff

import str

const MAX_EDIT_DISTANCE := 3000

@en "Equal"
@fa "همسان"
pub const Equal := 0

@en "Replace"
@fa "جایگزین"
pub const Replace := 1

@en "Delete"
@fa "حذف شده"
pub const Delete := 2

@en "Insert"
@fa "افزوده"
pub const Insert := 3

@en "Opcode"
@fa "دستور ویرایش"
pub struct Opcode:
    @en "tag"
    @fa "نوع"
    pub tag: int = 0
    @en "a_start"
    @fa "آغاز الف"
    pub a_start: int = 0
    @en "a_stop"
    @fa "انتهای الف"
    pub a_stop: int = 0
    @en "b_start"
    @fa "آغاز ب"
    pub b_start: int = 0
    @en "b_stop"
    @fa "انتهای ب"
    pub b_stop: int = 0
end

func _intern(a: Vector<str>, b: Vector<str>, ai &: Vector<int>, bi &: Vector<int>):
    mut ids := HashMap {} as HashMap<str, int>
    defer ids.free()
    repeat a.len() in i:
        s := a.get(i)
        if not ids.has(s):
            ids.put(s, ids.size())
        end
        ai.push(ids.get(s))
    end
    repeat b.len() in i:
        s := b.get(i)
        if not ids.has(s):
            ids.put(s, ids.size())
        end
        bi.push(ids.get(s))
    end
end

func _middle(a: Vector<int>, b: Vector<int>, lo_a: int, hi_a: int, lo_b: int, hi_b: int, steps &: Vector<int>):
    n := hi_a - lo_a
    m := hi_b - lo_b
    if n == 0:
        repeat m:
            steps.push(3)
        end
        ret
    end
    if m == 0:
        repeat n:
            steps.push(2)
        end
        ret
    end
    mut limit := n + m
    if limit > MAX_EDIT_DISTANCE:
        limit = MAX_EDIT_DISTANCE
    end
    width := 2 * limit + 3
    mut v := Vector {} as Vector<int>
    defer v.free()
    repeat width:
        v.push(0)
    end
    mut trace := Vector {} as Vector<int>
    defer trace.free()
    mut offsets := Vector {} as Vector<int>
    defer offsets.free()
    base := limit + 1
    mut found := -1
    mut d := 0
    until d <= limit and found < 0:
        mut k := 0 - d
        until k <= d:
            mut x := 0
            if k == 0 - d or (k != d and v.get(base + k - 1) < v.get(base + k + 1)):
                x = v.get(base + k + 1)
            else:
                x = v.get(base + k - 1) + 1
            end
            mut y := x - k
            until x < n and y < m and a.get(lo_a + x) == b.get(lo_b + y):
                x += 1
                y += 1
            end
            v.set(base + k, x)
            if x >= n and y >= m and found < 0:
                found = d
            end
            k += 2
        end
        offsets.push(trace.len())
        mut kk := 0 - d
        until kk <= d:
            trace.push(v.get(base + kk))
            kk += 1
        end
        d += 1
    end
    if found < 0:
        repeat n:
            steps.push(2)
        end
        repeat m:
            steps.push(3)
        end
        ret
    end
    mut rev := Vector {} as Vector<int>
    defer rev.free()
    mut x := n
    mut y := m
    mut r := found
    until r > 0:
        k := x - y
        prev := r - 1
        off := offsets.get(prev)
        mut pk := 0
        if k == 0 - r or (k != r and trace.get(off + (k - 1) + prev) < trace.get(off + (k + 1) + prev)):
            pk = k + 1
        else:
            pk = k - 1
        end
        px := trace.get(off + pk + prev)
        py := px - pk
        until x > px and y > py:
            rev.push(1)
            x -= 1
            y -= 1
        end
        if x == px:
            rev.push(3)
        else:
            rev.push(2)
        end
        x = px
        y = py
        r -= 1
    end
    until x > 0 and y > 0:
        rev.push(1)
        x -= 1
        y -= 1
    end
    repeat rev.len() in i:
        steps.push(rev.get(rev.len() - 1 - i))
    end
end

func _steps(a: Vector<str>, b: Vector<str>): Vector<int>:
    mut ai := Vector {} as Vector<int>
    defer ai.free()
    mut bi := Vector {} as Vector<int>
    defer bi.free()
    _intern(a, b, ai, bi)
    mut steps := Vector {} as Vector<int>
    mut lo := 0
    until lo < ai.len() and lo < bi.len() and ai.get(lo) == bi.get(lo):
        steps.push(1)
        lo += 1
    end
    mut ha := ai.len()
    mut hb := bi.len()
    until ha > lo and hb > lo and ai.get(ha - 1) == bi.get(hb - 1):
        ha -= 1
        hb -= 1
    end
    _middle(ai, bi, lo, ha, lo, hb, steps)
    mut t := ai.len() - 1
    until t >= ha:
        steps.push(1)
        t -= 1
    end
    ret steps
end

func _range(start: int, stop: int): str:
    mut begin := start + 1
    length := stop - start
    if length == 1:
        ret str.FromInt(begin as i64)
    end
    if length == 0:
        begin -= 1
    end
    ret str.FromInt(begin as i64) + "," + str.FromInt(length as i64)
end

@en "Opcodes"
@fa "دستورهای ویرایش"
pub func Opcodes(a: Vector<str>, b: Vector<str>): Vector<Opcode>:
    steps := _steps(a, b)
    defer steps.free()
    mut out := Vector {} as Vector<Opcode>
    mut i := 0
    mut j := 0
    mut s := 0
    until s < steps.len():
        if steps.get(s) == 1:
            mut e := s
            until e < steps.len() and steps.get(e) == 1:
                e += 1
            end
            out.push(Opcode { tag = 0, a_start = i, a_stop = i + (e - s), b_start = j, b_stop = j + (e - s) })
            i += e - s
            j += e - s
            s = e
        else:
            mut e := s
            mut dels := 0
            mut ins := 0
            until e < steps.len() and steps.get(e) != 1:
                if steps.get(e) == 2:
                    dels += 1
                else:
                    ins += 1
                end
                e += 1
            end
            mut tag := 1
            if ins == 0:
                tag = 2
            else ins > 0 and dels == 0:
                tag = 3
            end
            out.push(Opcode { tag = tag, a_start = i, a_stop = i + dels, b_start = j, b_stop = j + ins })
            i += dels
            j += ins
            s = e
        end
    end
    ret out
end

@en "GroupedOpcodes"
@fa "دستورهای ویرایش گروه بندی شده"
pub func GroupedOpcodes(a: Vector<str>, b: Vector<str>, context: int): Vector<Vector<Opcode>>:
    mut codes := Opcodes(a, b)
    defer codes.free()
    mut out := Vector {} as Vector<Vector<Opcode>>
    n := context
    if codes.len() == 0:
        codes.push(Opcode { tag = 0, a_start = 0, a_stop = 1, b_start = 0, b_stop = 1 })
    end
    first := codes.get(0)
    if first.tag == 0:
        codes.set(0, Opcode { tag = 0, a_start = first.a_stop - n > first.a_start ? first.a_stop - n : first.a_start, a_stop = first.a_stop, b_start = first.b_stop - n > first.b_start ? first.b_stop - n : first.b_start, b_stop = first.b_stop })
    end
    last_at := codes.len() - 1
    last := codes.get(last_at)
    if last.tag == 0:
        codes.set(last_at, Opcode { tag = 0, a_start = last.a_start, a_stop = last.a_stop < last.a_start + n ? last.a_stop : last.a_start + n, b_start = last.b_start, b_stop = last.b_stop < last.b_start + n ? last.b_stop : last.b_start + n })
    end
    mut group := Vector {} as Vector<Opcode>
    repeat codes.len() in c:
        mut op := codes.get(c)
        if op.tag == 0 and op.a_stop - op.a_start > 2 * n:
            group.push(Opcode { tag = 0, a_start = op.a_start, a_stop = op.a_stop < op.a_start + n ? op.a_stop : op.a_start + n, b_start = op.b_start, b_stop = op.b_stop < op.b_start + n ? op.b_stop : op.b_start + n })
            out.push(group)
            group = Vector {} as Vector<Opcode>
            op = Opcode { tag = 0, a_start = op.a_start > op.a_stop - n ? op.a_start : op.a_stop - n, a_stop = op.a_stop, b_start = op.b_start > op.b_stop - n ? op.b_start : op.b_stop - n, b_stop = op.b_stop }
        end
        group.push(op)
    end
    if group.len() > 0 and not (group.len() == 1 and group.get(0).tag == 0):
        out.push(group)
    else:
        group.free()
    end
    ret out
end

@en "Unified"
@fa "تفاوت یکپارچه"
pub func Unified(a: Vector<str>, b: Vector<str>, from_name: str, to_name: str, context: int): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut groups := GroupedOpcodes(a, b, context)
    repeat groups.len() in g:
        group := groups.get(g)
        if g == 0:
            out.push("--- " + from_name)
            out.push("+++ " + to_name)
        end
        first := group.get(0)
        last := group.get(group.len() - 1)
        out.push("@@ -" + _range(first.a_start, last.a_stop) + " +" + _range(first.b_start, last.b_stop) + " @@")
        repeat group.len() in c:
            op := group.get(c)
            if op.tag == 0:
                repeat op.a_stop - op.a_start in i:
                    out.push(" " + a.get(op.a_start + i))
                end
            else:
                if op.tag == 1 or op.tag == 2:
                    repeat op.a_stop - op.a_start in i:
                        out.push("-" + a.get(op.a_start + i))
                    end
                end
                if op.tag == 1 or op.tag == 3:
                    repeat op.b_stop - op.b_start in i:
                        out.push("+" + b.get(op.b_start + i))
                    end
                end
            end
        end
        group.free()
    end
    groups.free()
    ret out
end

@en "Lines"
@fa "خط ها"
pub func Lines(text: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    if text.len() == 0:
        ret out
    end
    parts := str.Split(text, "\n")
    defer parts.free()
    mut n := parts.len()
    if parts.get(n - 1).len() == 0:
        n -= 1
    end
    repeat n in i:
        out.push(str.TrimSuffix(parts.get(i), "\r"))
    end
    ret out
end

@en "UnifiedText"
@fa "تفاوت یکپارچه متن"
pub func UnifiedText(a: str, b: str, from_name: str, to_name: str, context: int): str:
    la := Lines(a)
    defer la.free()
    lb := Lines(b)
    defer lb.free()
    lines := Unified(la, lb, from_name, to_name, context)
    defer lines.free()
    if lines.len() == 0:
        ret ""
    end
    ret str.Join(lines, "\n") + "\n"
end

@en "Ratio"
@fa "نسبت شباهت"
pub func Ratio(a: Vector<str>, b: Vector<str>): f64:
    total := a.len() + b.len()
    if total == 0:
        ret 1.0
    end
    steps := _steps(a, b)
    defer steps.free()
    mut same := 0
    repeat steps.len() in i:
        if steps.get(i) == 1:
            same += 1
        end
    end
    ret 2.0 * (same as f64) / (total as f64)
end

@en "RatioText"
@fa "نسبت شباهت متن"
pub func RatioText(a: str, b: str): f64:
    ca := str.Chars(a)
    defer ca.free()
    cb := str.Chars(b)
    defer cb.free()
    ret Ratio(ca, cb)
end
