// Not @ar "نص" - std/str already claims that name, and two packages with the
// same alias resolve to whichever the directory walk happened to reach first:
// str on Windows, text on Linux, so tests/ar/apps/donut.salam built here and
// failed CI with "the package 'نص' exports no function 'اقتطاع یمین'". متن is
// the Arabic word the Persian alias already borrows, and str keeps نص because
// every Arabic test spells it that way.
@en "text"
@fa "متن"
@ar "متن"
package text

import mem
import str

// salam_fmt_f64 below is conv.FormatFloat. The exact decimal conversion
// lives there, in the package that owns turning numbers into text.
import conv

inline pure func _strptr(s: str): i64:
    v := s as void*
    ret v as i64
end


extern:
    // The shortest text that reads back as exactly this double: 15
    // significant digits, then 16, then 17 - the first that reads back as
    // the same double wins, and 17 always does. Trailing zeros are dropped,
    // so this is the answer Python's repr and JavaScript's String() give.
    //
    // std/dtoa does the conversion exactly, in integer arithmetic. This used
    // to call snprintf and strtod, which meant the language could not print a
    // number without a libc underneath it - fine on a hosted system, and the
    // reason a freestanding target had no float formatting at all.
    func salam_fmt_f64(v: f64): str:
        ret conv.FormatFloat(v)
    end
end

extern:
    func salam_str_repeat(s: str, n: int): str:
        slen := s.len() as i64
        if n <= 1 || slen == 0:
            if n == 1: ret s end
            r := mem.AllocateZeroed(1 as u64)
            ret r as str
        end
        total := slen * (n as i64)
        r := mem.AllocateZeroed((total + 1) as u64)
        mem.Copy(r, s as void*, slen as u64)
        mut filled := slen
        until filled < total:
            mut chunk := filled
            if chunk > total - filled: chunk = total - filled end
            mem.Copy(((r as i64) + filled) as void*, r, chunk as u64)
            filled += chunk
        end
        ret r as str
    end
    func salam_str_upper(s: str): str:
        n := s.len()
        bp := (s as void*) as i8*
        r := mem.AllocateZeroed((n + 1) as u64)
        rp := r as i8*
        repeat n with i:
            mut c := bp[i] as int
            if c < 0: c = c + 256 end
            if c >= 97 && c <= 122: c = c - 32 end
            rp[i] = c as i8
        end
        ret r as str
    end
    func salam_str_lower(s: str): str:
        n := s.len()
        bp := (s as void*) as i8*
        r := mem.AllocateZeroed((n + 1) as u64)
        rp := r as i8*
        repeat n with i:
            mut c := bp[i] as int
            if c < 0: c = c + 256 end
            if c >= 65 && c <= 90: c = c + 32 end
            rp[i] = c as i8
        end
        ret r as str
    end
end

inline pure func _is_ws(ch: int): bool:
    ret ch == 32 || ch == 9 || ch == 10 || ch == 13
end

func _copy_range(s: str, start: int, ln: int): i64:
    r := mem.AllocateZeroed((ln + 1) as u64)
    mem.Copy(r, (_strptr(s) + (start as i64)) as void*, ln as u64)
    ret r as i64
end

func _find_from(s: str, sub: str, from: int): int:
    tail := ((_strptr(s) + (from as i64)) as void*) as str
    idx := tail.find(sub)
    if idx < 0: ret 0 - 1 end
    ret from + idx
end

extern:
    func salam_str_trim(s: str): str:
        bp := (s as void*) as i8*
        slen := s.len()
        mut a := 0
        until a < slen && _is_ws(bp[a] as int):
            a += 1
        end
        mut e := slen
        until e > a && _is_ws(bp[e - 1] as int):
            e -= 1
        end
        ret (_copy_range(s, a, e - a) as void*) as str
    end
end
extern:
    func salam_str_split(s: str, delim: str, out_count: void*): void*:
        oc := out_count as int*
        dl := delim.len()
        n := s.len()
        if dl == 0:
            // sizeof(str), not 8: the caller reads this back as a char*[],
            // whose elements are 4 bytes wide on a 32-bit host. Allocating
            // and indexing it as i64 under-allocated by half and returned
            // pairs of pointers glued together as single addresses.
            arr := mem.Allocate(sizeof(str) as u64) as str*
            arr[0] = (_copy_range(s, 0, n) as void*) as str
            oc[0] = 1
            ret arr as void*
        end
        mut count := 1
        mut idx := _find_from(s, delim, 0)
        until idx >= 0:
            count += 1
            idx = _find_from(s, delim, idx + dl)
        end
        arr := mem.Allocate((count as u64) * (sizeof(str) as u64)) as str*
        mut k := 0
        mut off := 0
        idx = _find_from(s, delim, 0)
        until idx >= 0:
            arr[k] = (_copy_range(s, off, idx - off) as void*) as str
            k += 1
            off = idx + dl
            idx = _find_from(s, delim, off)
        end
        arr[k] = (_copy_range(s, off, n - off) as void*) as str
        oc[0] = count
        ret arr as void*
    end
end
