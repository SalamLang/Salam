/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

// Not @ar "نص" - std/str already claims that name, and two packages with the
// same alias resolve to whichever the directory walk happened to reach first:
// str on Windows, text on Linux, so tests/ar/apps/donut.salam built here and
// failed CI with "the package 'نص' exports no function 'اقتطاع یمین'". متن is
// the Arabic word the Persian alias already borrows, and str keeps نص because
// every Arabic test spells it that way.
@en "text"
@fa "متن"
@ar "متن"
package text

import mem
import str

// libc, for salam_fmt_f64 below: printf is the only correctly-rounded
// decimal formatter available here, and strtod the only correctly-rounded
// reader back.
extern:
    func snprintf(buf: char*, cap: u64, fmt: str, ...): int
    func strtod(s: str, endptr: void*): f64
end

inline pure func _strptr(s: str): i64:
    v := s as void*
    ret v as i64
end

// One "%.Ng" rendering of `v`.
func _fmt_g(v: f64, prec: int): str:
    cap := 64 as u64
    buf := mem.Allocate(cap)
    n := snprintf(buf as char*, cap, "%." + str.FromInt(prec as i64) + "g", v)
    mut out := ""
    if n > 0:
        out = str.Clone(buf as str)
    end
    mem.Free(buf)
    ret out
end

extern:
    // The shortest text that reads back as exactly this double: 15
    // significant digits, then 16, then 17 - the first that survives
    // strtod wins, and 17 always does. printf's %g drops trailing zeros,
    // so this is the answer Python's repr and JavaScript's String() give,
    // and the one the JS backend already printed while the compiled
    // backends printed 6 digits: 1/3 came out "0.333333" and
    // 1000000000.5 came out "1e+09", which is not the same number.
    func salam_fmt_f64(v: f64): str:
        // printf spells a negative NaN "-nan" on glibc; the sign of a NaN
        // is not information this language shows.
        if v != v:
            ret "nan"
        end
        mut prec := 15
        until prec <= 17:
            s := _fmt_g(v, prec)
            if prec == 17 || strtod(s, null) == v:
                ret s
            end
            prec += 1
        end
        ret ""
    end
end

extern:
    func salam_strcat(a: str, b: str): str:
        la := a.len() as i64
        lb := b.len() as i64
        r := mem.AllocateZeroed((la + lb + 1) as u64)
        mem.Copy(r, a as void*, la as u64)
        mem.Copy(((r as i64) + la) as void*, b as void*, lb as u64)
        ret r as str
    end
    func salam_char_from_code(c: int): str:
        r := mem.AllocateZeroed(2 as u64)
        mem.Set(r, c, 1 as u64)
        ret r as str
    end
    func salam_str_substr(s: str, start: int, n: int): str:
        slen := s.len()
        mut st := start
        mut ln := n
        if st < 0: st = 0 end
        if st > slen: st = slen end
        if ln < 0: ln = 0 end
        if st + ln > slen: ln = slen - st end
        r := mem.AllocateZeroed((ln + 1) as u64)
        mem.Copy(r, (_strptr(s) + (st as i64)) as void*, ln as u64)
        ret r as str
    end
    func salam_str_repeat(s: str, n: int): str:
        slen := s.len() as i64
        if n <= 1 || slen == 0:
            if n == 1: ret s end
            r := mem.AllocateZeroed(1 as u64)
            ret r as str
        end
        total := slen * (n as i64)
        r := mem.AllocateZeroed((total + 1) as u64)
        mem.Copy(r, s as void*, slen as u64)
        mut filled := slen
        until filled < total:
            mut chunk := filled
            if chunk > total - filled: chunk = total - filled end
            mem.Copy(((r as i64) + filled) as void*, r, chunk as u64)
            filled += chunk
        end
        ret r as str
    end
    func salam_str_upper(s: str): str:
        n := s.len()
        bp := (s as void*) as i8*
        r := mem.AllocateZeroed((n + 1) as u64)
        rp := r as i8*
        repeat n with i:
            mut c := bp[i] as int
            if c < 0: c = c + 256 end
            if c >= 97 && c <= 122: c = c - 32 end
            rp[i] = c as i8
        end
        ret r as str
    end
    func salam_str_lower(s: str): str:
        n := s.len()
        bp := (s as void*) as i8*
        r := mem.AllocateZeroed((n + 1) as u64)
        rp := r as i8*
        repeat n with i:
            mut c := bp[i] as int
            if c < 0: c = c + 256 end
            if c >= 65 && c <= 90: c = c + 32 end
            rp[i] = c as i8
        end
        ret r as str
    end
end

inline pure func _is_ws(ch: int): bool:
    ret ch == 32 || ch == 9 || ch == 10 || ch == 13
end

func _copy_range(s: str, start: int, ln: int): i64:
    r := mem.AllocateZeroed((ln + 1) as u64)
    mem.Copy(r, (_strptr(s) + (start as i64)) as void*, ln as u64)
    ret r as i64
end

func _find_from(s: str, sub: str, from: int): int:
    tail := ((_strptr(s) + (from as i64)) as void*) as str
    idx := tail.find(sub)
    if idx < 0: ret 0 - 1 end
    ret from + idx
end

extern:
    func salam_str_trim(s: str): str:
        bp := (s as void*) as i8*
        slen := s.len()
        mut a := 0
        until a < slen && _is_ws(bp[a] as int):
            a += 1
        end
        mut e := slen
        until e > a && _is_ws(bp[e - 1] as int):
            e -= 1
        end
        ret (_copy_range(s, a, e - a) as void*) as str
    end
end
extern:
    func salam_str_split(s: str, delim: str, out_count: void*): void*:
        oc := out_count as int*
        dl := delim.len()
        n := s.len()
        if dl == 0:
            // sizeof(str), not 8: the caller reads this back as a char*[],
            // whose elements are 4 bytes wide on a 32-bit host. Allocating
            // and indexing it as i64 under-allocated by half and returned
            // pairs of pointers glued together as single addresses.
            arr := mem.Allocate(sizeof(str) as u64) as str*
            arr[0] = (_copy_range(s, 0, n) as void*) as str
            oc[0] = 1
            ret arr as void*
        end
        mut count := 1
        mut idx := _find_from(s, delim, 0)
        until idx >= 0:
            count += 1
            idx = _find_from(s, delim, idx + dl)
        end
        arr := mem.Allocate((count as u64) * (sizeof(str) as u64)) as str*
        mut k := 0
        mut off := 0
        idx = _find_from(s, delim, 0)
        until idx >= 0:
            arr[k] = (_copy_range(s, off, idx - off) as void*) as str
            k += 1
            off = idx + dl
            idx = _find_from(s, delim, off)
        end
        arr[k] = (_copy_range(s, off, n - off) as void*) as str
        oc[0] = count
        ret arr as void*
    end
end
