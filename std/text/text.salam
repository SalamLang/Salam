@en "text"
@fa "متن"
package text

import mem
import str
import conv

extern:
    noret func abort()
end

inline pure func _strptr(s: str): i64:
    v := s as void*
    ret v as i64
end

noret func _text_oom():
    printerrln "salam: out of memory while building a string"
    abort()
end

func _text_alloc(n: u64): void*:
    p := mem.AllocateZeroed(n)
    if p == null:
        _text_oom()
    end
    ret p
end

func _text_alloc_raw(n: u64): void*:
    p := mem.Allocate(n)
    if p == null:
        _text_oom()
    end
    ret p
end

if not SALAM_KERNEL:
    export:
        func salam_fmt_f64(v: f64): str:
            ret conv.FormatFloat(v)
        end
    end
end

export:
    func salam_str_repeat(s: str, n: int): str:
        slen := s.len() as i64
        if n <= 1 or slen == 0:
            if n == 1: ret s end
            r := _text_alloc(1 as u64)
            ret r as str
        end
        total := slen * (n as i64)
        r := _text_alloc((total + 1) as u64)
        mem.Copy(r, s as void*, slen as u64)
        mut filled := slen
        until filled < total:
            mut chunk := filled
            if chunk > total - filled: chunk = total - filled end
            mem.Copy(((r as i64) + filled) as void*, r, chunk as u64)
            filled += chunk
        end
        ret r as str
    end
    func salam_str_upper(s: str): str:
        n := s.len()
        bp := (s as void*) as i8*
        r := _text_alloc((n + 1) as u64)
        rp := r as i8*
        repeat n in i:
            mut c := bp[i] as int
            if c < 0: c = c + 256 end
            if c >= 97 and c <= 122: c = c - 32 end
            rp[i] = c as i8
        end
        ret r as str
    end
    func salam_str_lower(s: str): str:
        n := s.len()
        bp := (s as void*) as i8*
        r := _text_alloc((n + 1) as u64)
        rp := r as i8*
        repeat n in i:
            mut c := bp[i] as int
            if c < 0: c = c + 256 end
            if c >= 65 and c <= 90: c = c + 32 end
            rp[i] = c as i8
        end
        ret r as str
    end
end

inline pure func _is_ws(ch: int): bool:
    ret ch == 32 or ch == 9 or ch == 10 or ch == 13
end

func _copy_range(s: str, start: int, ln: int): i64:
    r := _text_alloc((ln + 1) as u64)
    mem.Copy(r, (_strptr(s) + (start as i64)) as void*, ln as u64)
    ret r as i64
end

func _find_from(s: str, sub: str, from: int): int:
    tail := ((_strptr(s) + (from as i64)) as void*) as str
    idx := tail.find(sub)
    if idx < 0: ret 0 - 1 end
    ret from + idx
end

export:
    func salam_str_trim(s: str): str:
        bp := (s as void*) as i8*
        slen := s.len()
        mut a := 0
        until a < slen and _is_ws(bp[a] as int):
            a += 1
        end
        mut e := slen
        until e > a and _is_ws(bp[e - 1] as int):
            e -= 1
        end
        ret (_copy_range(s, a, e - a) as void*) as str
    end
end
export:
    func salam_str_split(s: str, delim: str, out_count: void*): void*:
        oc := out_count as int*
        dl := delim.len()
        n := s.len()
        if dl == 0:
            arr := _text_alloc_raw(sizeof(str) as u64) as str*
            arr[0] = (_copy_range(s, 0, n) as void*) as str
            oc[0] = 1
            ret arr as void*
        end
        mut count := 1
        mut idx := _find_from(s, delim, 0)
        until idx >= 0:
            count += 1
            idx = _find_from(s, delim, idx + dl)
        end
        arr := _text_alloc_raw((count as u64) * (sizeof(str) as u64)) as str*
        mut k := 0
        mut off := 0
        idx = _find_from(s, delim, 0)
        until idx >= 0:
            arr[k] = (_copy_range(s, off, idx - off) as void*) as str
            k += 1
            off = idx + dl
            idx = _find_from(s, delim, off)
        end
        arr[k] = (_copy_range(s, off, n - off) as void*) as str
        oc[0] = count
        ret arr as void*
    end
end
