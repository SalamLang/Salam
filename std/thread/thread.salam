@en "thread"
@fa "نخ"
@ar "خیط"
package thread

import mem

if SALAM_OS_UNIX:
    if !defined(SALAM_CC_TCC):
        link dynamic "pthread"
    end
end

if SALAM_OS_WINDOWS:
    extern:
        func _beginthreadex(sec: void*, stack: u32, start: void*, arg: void*, flags: u32, thrdaddr: void*): u64
        func WaitForSingleObject(handle: void*, milliseconds: int): int
        func CloseHandle(handle: void*): int
    end
else:
    extern:
        func pthread_create(thread: void*, attr: void*, start: void*, arg: void*): int
        // pthread_t is pointer-sized on every target glibc and musl
        // support, so void* is the one spelling that is right on both
        // widths. Declaring it u64 made the call (i32, i32) -> i32 on a
        // 32-bit target look like (i64, i32) -> i32: harmless in an ELF
        // link, which never checks, and fatal under wasm-ld, which does.
        // It answered with "function signature mismatch: pthread_join" and
        // a stub that traps the moment anything joins a thread.
        func pthread_join(thread: void*, retval: void*): int
    end
end

@en "Thread"
@fa "نخ"
@ar "خیط"
pub struct Thread:
    pub handle: i64 = 0
end

if SALAM_OS_WINDOWS:
    extern:
        func salam_thread_spawn(fn: void*): i64:
            ret salam_thread_spawn_arg(fn, null)
        end
        func salam_thread_spawn_arg(fn: void*, arg: void*): i64:
            if fn == null: ret 0 end
            ret _beginthreadex(null, 0 as u32, fn, arg, 0 as u32, null) as i64
        end
        func salam_thread_join(h: i64):
            if h == 0: ret end
            WaitForSingleObject(h as void*, 0 - 1)
            CloseHandle(h as void*)
        end
    end
else:
    extern:
        func salam_thread_spawn(fn: void*): i64:
            ret salam_thread_spawn_arg(fn, null)
        end
        func salam_thread_spawn_arg(fn: void*, arg: void*): i64:
            if fn == null: ret 0 end
            // Zeroed, not just allocated: pthread_create fills only the
            // first pointer-sized word, so on a 32-bit target the upper
            // half of this slot is whatever the allocator left behind and
            // the read below would carry it into the join.
            t := mem.AllocateZeroed(8 as u64)
            if pthread_create(t, null, fn, arg) != 0:
                mem.Free(t)
                ret 0
            end
            ret t as i64
        end
        func salam_thread_join(h: i64):
            if h == 0: ret end
            tp := (h as void*) as i64*
            pthread_join(tp[0] as void*, null)
            mem.Free(h as void*)
        end
    end
end

@en "New"
@fa "جدید"
@ar "جدید"
pub func New(h: i64): Thread:
    ret Thread { handle = h }
end

@en "Join"
@fa "پیوستن"
@ar "انضمام"
pub func Join(t: Thread):
    join(t.handle)
end

@en "JoinAll"
@fa "پیوستن به همه"
@ar "انضمام الکل"
pub func JoinAll(threads: Vector<Thread>):
    repeat threads.len() with i:
        join(threads.get(i).handle)
    end
end

@en "Valid"
@fa "معتبر"
@ar "صالح"
pub func Valid(t: Thread): bool:
    ret t.handle != 0
end

@en "Handle"
@fa "دسته"
@ar "مقبض"
pub func Handle(t: Thread): i64:
    ret t.handle
end

@en "Collect"
@fa "جمع آوری"
@ar "تجمیع"
pub func Collect(threads: Vector<Thread>, h: i64): Vector<Thread>:
    threads.push(Thread { handle = h })
    ret threads
end
