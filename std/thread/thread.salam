@en "thread"
@fa "نخ"
package thread

import mem

if SALAM_OS_UNIX:
    if not defined(SALAM_CC_TCC):
        link dynamic "pthread"
    end
end

if SALAM_OS_WINDOWS:
    extern:
        func _beginthreadex(sec: void*, stack: u32, start: void*, arg: void*, flags: u32, thrdaddr: void*): u64
        func WaitForSingleObject(handle: void*, milliseconds: int): int
        func CloseHandle(handle: void*): int
    end
else:
    extern:
        func pthread_create(thread: void*, attr: void*, start: void*, arg: void*): int
        func pthread_join(thread: void*, retval: void*): int
        func pthread_attr_init(attr: void*): int
        func pthread_attr_setstacksize(attr: void*, size: u64): int
        func pthread_attr_destroy(attr: void*): int
    end
end

@en "Thread"
@fa "نخ"
pub struct Thread:
    pub handle: i64 = 0
end

if SALAM_OS_WINDOWS:
    export:
        func salam_thread_spawn(fn: void*): i64:
            ret salam_thread_spawn_arg(fn, null)
        end
        func salam_thread_spawn_arg(fn: void*, arg: void*): i64:
            if fn == null: ret 0 end
            ret _beginthreadex(null, 0 as u32, fn, arg, 0 as u32, null) as i64
        end
        func salam_thread_spawn_stack(fn: void*, arg: void*, stack: u64): i64:
            if fn == null: ret 0 end
            ret _beginthreadex(null, stack as u32, fn, arg, 0x10000 as u32, null) as i64
        end
        func salam_thread_join(h: i64):
            if h == 0: ret end
            WaitForSingleObject(h as void*, 0 - 1)
            CloseHandle(h as void*)
        end
    end
else:
    export:
        func salam_thread_spawn(fn: void*): i64:
            ret salam_thread_spawn_arg(fn, null)
        end
        func salam_thread_spawn_arg(fn: void*, arg: void*): i64:
            if fn == null: ret 0 end
            t := mem.AllocateZeroed(8 as u64)
            if pthread_create(t, null, fn, arg) != 0:
                mem.Free(t)
                ret 0
            end
            ret t as i64
        end
        func salam_thread_spawn_stack(fn: void*, arg: void*, stack: u64): i64:
            if fn == null: ret 0 end
            t := mem.AllocateZeroed(8 as u64)
            attr := mem.AllocateZeroed(256 as u64)
            pthread_attr_init(attr)
            if stack > (0 as u64):
                pthread_attr_setstacksize(attr, stack)
            end
            rc := pthread_create(t, attr, fn, arg)
            pthread_attr_destroy(attr)
            mem.Free(attr)
            if rc != 0:
                mem.Free(t)
                ret 0
            end
            ret t as i64
        end
        func salam_thread_join(h: i64):
            if h == 0: ret end
            tp := (h as void*) as i64*
            pthread_join(tp[0] as void*, null)
            mem.Free(h as void*)
        end
    end
end

@en "New"
@fa "جدید"
pub func New(h: i64): Thread:
    ret Thread { handle = h }
end

@en "SpawnStack"
@fa "اجرا با پشته"
pub func SpawnStack(fn: i64, arg: void*, stack: u64): Thread:
    ret Thread { handle = salam_thread_spawn_stack(fn as void*, arg, stack) }
end

@en "Join"
@fa "پیوستن"
pub func Join(t: Thread):
    join(t.handle)
end

@en "JoinAll"
@fa "پیوستن به همه"
pub func JoinAll(threads: Vector<Thread>):
    repeat threads.len() in i:
        join(threads.get(i).handle)
    end
end

@en "Valid"
@fa "معتبر"
pub func Valid(t: Thread): bool:
    ret t.handle != 0
end

@en "Handle"
@fa "دسته"
pub func Handle(t: Thread): i64:
    ret t.handle
end

@en "Collect"
@fa "جمع آوری"
pub func Collect(threads: Vector<Thread>, h: i64): Vector<Thread>:
    threads.push(Thread { handle = h })
    ret threads
end
