package time

import conv

const _NS_PER_US := 1000 as i64
const _NS_PER_MS := 1000000 as i64
const _NS_PER_SEC := 1000000000 as i64
const _NS_PER_MIN := 60000000000 as i64
const _NS_PER_HOUR := 3600000000000 as i64
const _NS_PER_DAY := 86400000000000 as i64

const _I64_MAX := 9223372036854775807 as i64

const _I64_MIN := 0 - 9223372036854775807 - 1

@en "Duration"
@fa "مدت"
pub struct Duration:
    @en "ns"
    @fa "نانوثانیه خام"
    pub ns: i64 = 0

    @en "Nanos"
    @fa "نانوثانیه"
    pub func Nanos(): i64: ret this.ns end
    @en "nanos"
    @fa "نانوثانیه"
    pub func nanos(): i64: ret this.Nanos() end

    @en "Micros"
    @fa "میکروثانیه"
    pub func Micros(): i64: ret this.ns / _NS_PER_US end
    @en "micros"
    @fa "میکروثانیه"
    pub func micros(): i64: ret this.Micros() end

    @en "Millis"
    @fa "میلی‌ثانیه"
    pub func Millis(): i64: ret this.ns / _NS_PER_MS end
    @en "millis"
    @fa "میلی‌ثانیه"
    pub func millis(): i64: ret this.Millis() end

    @en "Secs"
    @fa "ثانیه‌های کامل"
    pub func Secs(): i64: ret this.ns / _NS_PER_SEC end
    @en "secs"
    @fa "ثانیه‌های کامل"
    pub func secs(): i64: ret this.Secs() end

    @en "Seconds"
    @fa "ثانیه"
    pub func Seconds(): f64: ret (this.ns as f64) / 1000000000.0 end
    @en "seconds"
    @fa "ثانیه"
    pub func seconds(): f64: ret this.Seconds() end

    @en "Minutes"
    @fa "دقیقه"
    pub func Minutes(): f64: ret (this.ns as f64) / 60000000000.0 end
    @en "minutes"
    @fa "دقیقه"
    pub func minutes(): f64: ret this.Minutes() end

    @en "Hours"
    @fa "ساعت"
    pub func Hours(): f64: ret (this.ns as f64) / 3600000000000.0 end
    @en "hours"
    @fa "ساعت"
    pub func hours(): f64: ret this.Hours() end

    @en "Days"
    @fa "روز"
    pub func Days(): f64: ret (this.ns as f64) / 86400000000000.0 end
    @en "days"
    @fa "روز"
    pub func days(): f64: ret this.Days() end

    @en "Add"
    @fa "جمع"
    pub func Add(o: Duration): Duration: ret Duration { ns = this.ns + o.ns } end
    @en "add"
    @fa "جمع"
    pub func add(o: Duration): Duration: ret this.Add(o) end

    @en "Sub"
    @fa "تفریق"
    pub func Sub(o: Duration): Duration: ret Duration { ns = this.ns - o.ns } end
    @en "sub"
    @fa "تفریق"
    pub func sub(o: Duration): Duration: ret this.Sub(o) end

    @en "Mul"
    @fa "ضرب"
    pub func Mul(k: i64): Duration: ret Duration { ns = this.ns * k } end
    @en "mul"
    @fa "ضرب"
    pub func mul(k: i64): Duration: ret this.Mul(k) end

    @en "Div"
    @fa "تقسیم"
    pub func Div(k: i64): Duration:
        if k == 0: ret Duration { ns = 0 } end
        ret Duration { ns = this.ns / k }
    end
    @en "div"
    @fa "تقسیم"
    pub func div(k: i64): Duration: ret this.Div(k) end

    @en "Ratio"
    @fa "نسبت"
    pub func Ratio(o: Duration): i64:
        if o.ns == 0: ret 0 end
        ret this.ns / o.ns
    end
    @en "ratio"
    @fa "نسبت"
    pub func ratio(o: Duration): i64: ret this.Ratio(o) end

    @en "Neg"
    @fa "منفی"
    pub func Neg(): Duration:
        if this.ns == _I64_MIN: ret Duration { ns = _I64_MAX } end
        ret Duration { ns = 0 - this.ns }
    end
    @en "neg"
    @fa "منفی"
    pub func neg(): Duration: ret this.Neg() end

    @en "Abs"
    @fa "قدرمطلق"
    pub func Abs(): Duration:
        if this.ns == _I64_MIN: ret Duration { ns = _I64_MAX } end
        if this.ns < 0: ret Duration { ns = 0 - this.ns } end
        ret Duration { ns = this.ns }
    end
    @en "abs"
    @fa "قدرمطلق"
    pub func abs(): Duration: ret this.Abs() end

    @en "IsZero"
    @fa "صفر است"
    pub func IsZero(): bool: ret this.ns == 0 end
    @en "is_zero"
    @fa "صفر است"
    pub func is_zero(): bool: ret this.IsZero() end

    @en "IsNegative"
    @fa "منفی است"
    pub func IsNegative(): bool: ret this.ns < 0 end
    @en "is_negative"
    @fa "منفی است"
    pub func is_negative(): bool: ret this.IsNegative() end

    @en "Cmp"
    @fa "مقایسه"
    pub func Cmp(o: Duration): int:
        if this.ns < o.ns: ret 0 - 1 end
        if this.ns > o.ns: ret 1 end
        ret 0
    end
    @en "cmp"
    @fa "مقایسه"
    pub func cmp(o: Duration): int: ret this.Cmp(o) end

    @en "Less"
    @fa "کمتر"
    pub func Less(o: Duration): bool: ret this.ns < o.ns end
    @en "less"
    @fa "کمتر"
    pub func less(o: Duration): bool: ret this.Less(o) end

    @en "Equals"
    @fa "یکسان"
    pub func Equals(o: Duration): bool: ret this.ns == o.ns end
    @en "equals"
    @fa "یکسان"
    pub func equals(o: Duration): bool: ret this.Equals(o) end

    @en "Truncate"
    @fa "برش"
    pub func Truncate(m: Duration): Duration:
        if m.ns <= 0: ret Duration { ns = this.ns } end
        ret Duration { ns = this.ns - this.ns % m.ns }
    end
    @en "truncate"
    @fa "برش"
    pub func truncate(m: Duration): Duration: ret this.Truncate(m) end

    @en "Round"
    @fa "گرد کردن"
    pub func Round(m: Duration): Duration:
        if m.ns <= 0: ret Duration { ns = this.ns } end
        r := this.ns % m.ns
        down := this.ns - r
        if r < 0:
            nr := 0 - r
            if nr >= m.ns - nr:
                if down < _I64_MIN + m.ns: ret Duration { ns = down } end
                ret Duration { ns = down - m.ns }
            end
            ret Duration { ns = down }
        end
        if r >= m.ns - r:
            if down > _I64_MAX - m.ns: ret Duration { ns = down } end
            ret Duration { ns = down + m.ns }
        end
        ret Duration { ns = down }
    end
    @en "round"
    @fa "گرد کردن"
    pub func round(m: Duration): Duration: ret this.Round(m) end

    @en "ToStr"
    @fa "به رشته"
    pub func ToStr(): str: ret FormatDuration(Duration { ns = this.ns }) end
    @en "to_str"
    @fa "به رشته"
    pub func to_str(): str: ret this.ToStr() end
end

inline pure func _dbp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _dub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

inline pure func _isDigitByte(c: int): bool: ret c >= 48 and c <= 57 end

func _fracStr(rem: i64, digits: int): str:
    if rem == 0: ret "" end
    mut s := conv.FormatInt(rem)
    until s.Len() < digits:
        s = "0" + s
    end
    mut e := s.Len()
    until e > 0 and s.substr(e - 1, 1) == "0":
        e--
    end
    ret "." + s.substr(0, e)
end

func _unitNanos(u: str): i64:
    if u == "ns": ret 1 end
    if u == "us": ret _NS_PER_US end
    if u == "µs": ret _NS_PER_US end
    if u == "μs": ret _NS_PER_US end
    if u == "ms": ret _NS_PER_MS end
    if u == "s": ret _NS_PER_SEC end
    if u == "m": ret _NS_PER_MIN end
    if u == "h": ret _NS_PER_HOUR end
    if u == "d": ret _NS_PER_DAY end
    ret 0
end

func _derr(s: str, kind: ErrorKind, code: str, message: str, offset: int): Error:
    ret Error.At(kind, message, offset).locate(s).with_code(code).wrap("time")
end

func _dwant(s: str, n: int, i: int, what: str): Error:
    if i >= n:
        ret _derr(s, ErrorKind.UnexpectedEnd, "time.unexpected_end", "expected " + what + ", found the end of the text", i)
    end
    ret _derr(s, ErrorKind.Syntax, "time.syntax", "expected " + what + ", found " + _tdesc(s, i), i)
end

func _dtooLong(s: str, at: int): Error:
    ret _derr(s, ErrorKind.OutOfRange, "time.overflow", "duration is too long (the limit is about 292 years)", at)
end

@en "Nanoseconds"
@fa "نانوثانیه‌ها"
pub inline pure func Nanoseconds(n: i64): Duration: ret Duration { ns = n } end

@en "Microseconds"
@fa "میکروثانیه‌ها"
pub inline pure func Microseconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_US } end

@en "Milliseconds"
@fa "میلی‌ثانیه‌ها"
pub inline pure func Milliseconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_MS } end

@en "Seconds"
@fa "ثانیه‌ها"
pub inline pure func Seconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_SEC } end

@en "Minutes"
@fa "دقیقه‌ها"
pub inline pure func Minutes(n: i64): Duration: ret Duration { ns = n * _NS_PER_MIN } end

@en "Hours"
@fa "ساعت‌ها"
pub inline pure func Hours(n: i64): Duration: ret Duration { ns = n * _NS_PER_HOUR } end

@en "Days"
@fa "روزها"
pub inline pure func Days(n: i64): Duration: ret Duration { ns = n * _NS_PER_DAY } end

@en "SecondsF"
@fa "ثانیه اعشاری"
pub inline pure func SecondsF(x: f64): Duration: ret Duration { ns = (x * 1000000000.0) as i64 } end

@en "ZeroDuration"
@fa "مدت صفر"
pub inline pure func ZeroDuration(): Duration: ret Duration { ns = 0 } end

@en "FormatDuration"
@fa "قالب مدت"
pub func FormatDuration(d: Duration): str:
    if d.ns == 0: ret "0s" end
    if d.ns == _I64_MIN: ret "-2562047h47m16.854775808s" end
    mut sign := ""
    mut v := d.ns
    if v < 0:
        sign = "-"
        v = 0 - v
    end
    if v < _NS_PER_US: ret sign + conv.FormatInt(v) + "ns" end
    if v < _NS_PER_MS:
        ret sign + conv.FormatInt(v / _NS_PER_US) + _fracStr(v % _NS_PER_US, 3) + "us"
    end
    if v < _NS_PER_SEC:
        ret sign + conv.FormatInt(v / _NS_PER_MS) + _fracStr(v % _NS_PER_MS, 6) + "ms"
    end
    secs := v / _NS_PER_SEC
    frac := _fracStr(v % _NS_PER_SEC, 9)
    if secs < 60: ret sign + conv.FormatInt(secs) + frac + "s" end
    if secs < 3600:
        ret sign + conv.FormatInt(secs / 60) + "m" + conv.FormatInt(secs % 60) + frac + "s"
    end
    h := secs / 3600
    m := (secs % 3600) / 60
    s := secs % 60
    ret sign + conv.FormatInt(h) + "h" + conv.FormatInt(m) + "m" + conv.FormatInt(s) + frac + "s"
end

@en "ParseDuration"
@fa "تجزیه مدت"
pub func ParseDuration(s: str): Duration throws:
    n := s.Len()
    if n == 0: throw _derr(s, ErrorKind.UnexpectedEnd, "time.empty", "empty duration", 0) end
    bp := _dbp(s)
    mut i := 0
    mut neg := false
    c0 := _dub(bp, 0)
    if c0 == 45:
        neg = true
        i = 1
    else c0 == 43:
        i = 1
    end
    if i >= n: throw _dwant(s, n, i, "a number") end
    if s.substr(i, n - i) == "0": ret Duration { ns = 0 } end
    mut total := 0 as i64
    until i < n:
        gs := i
        mut whole := 0 as i64
        mut digits := 0
        until i < n and _isDigitByte(_dub(bp, i)):
            dv := (_dub(bp, i) - 48) as i64
            if whole > (_I64_MAX - dv) / 10: throw _dtooLong(s, gs) end
            whole = whole * 10 + dv
            digits++
            i++
        end
        mut fracNum := 0 as i64
        mut fracDen := 1 as i64
        if i < n and _dub(bp, i) == 46:
            i++
            mut fdigits := 0
            mut seen := 0
            until i < n and _isDigitByte(_dub(bp, i)):
                if fdigits < 9:
                    fracNum = fracNum * 10 + ((_dub(bp, i) - 48) as i64)
                    fracDen *= 10
                    fdigits++
                end
                seen++
                i++
            end
            if seen == 0: throw _dwant(s, n, i, "a digit after the decimal point") end
            digits += seen
        end
        if digits == 0: throw _dwant(s, n, i, "a number") end
        us := i
        until i < n and not _isDigitByte(_dub(bp, i)):
            i++
        end
        if i == us:
            throw _derr(s, ErrorKind.UnexpectedEnd, "time.missing_unit", "the number has no unit (ns, us, ms, s, m, h or d)", i)
        end
        unit := s.substr(us, i - us)
        unitNs := _unitNanos(unit)
        if unitNs == 0:
            throw _derr(s, ErrorKind.Syntax, "time.bad_unit", "unknown unit '" + unit + "' (use ns, us, ms, s, m, h or d)", us)
        end
        if whole > _I64_MAX / unitNs: throw _dtooLong(s, gs) end
        q := unitNs / fracDen
        r := unitNs % fracDen
        fpart := fracNum * q + (fracNum * r) / fracDen
        part := whole * unitNs
        if part > _I64_MAX - fpart: throw _dtooLong(s, gs) end
        if total > _I64_MAX - (part + fpart): throw _dtooLong(s, gs) end
        total = total + part + fpart
    end
    if neg: total = 0 - total end
    ret Duration { ns = total }
end

@en "ParseDurationOr"
@fa "تجزیه مدت با پیش فرض"
pub func ParseDurationOr(s: str, fallback: Duration): Duration:
    try:
        ret ParseDuration(s)
    catch:
        ret fallback
    end
end

@en "SleepFor"
@fa "خواب به مدت"
pub func SleepFor(d: Duration):
    if d.ns <= 0: ret end
    ms := d.ns / _NS_PER_MS
    if ms > 0:
        sleep_ms(ms as int)
        ret
    end
    sleep_ms(1)
end

@en "SinceDuration"
@fa "مدت از"
pub func SinceDuration(start_ns: i64): Duration:
    ret Duration { ns = _mono_ns() - start_ns }
end

@en "DurationBetween"
@fa "مدت بین"
pub inline pure func DurationBetween(later: i64, earlier: i64): Duration:
    ret Duration { ns = (later - earlier) * _NS_PER_SEC }
end

@en "AddDuration"
@fa "افزودن مدت"
pub inline pure func AddDuration(epoch: i64, d: Duration): i64:
    ret epoch + d.ns / _NS_PER_SEC
end
