package time

import conv

const _NS_PER_US := 1000 as i64
const _NS_PER_MS := 1000000 as i64
const _NS_PER_SEC := 1000000000 as i64
const _NS_PER_MIN := 60000000000 as i64
const _NS_PER_HOUR := 3600000000000 as i64
const _NS_PER_DAY := 86400000000000 as i64

const _I64_MAX := 9223372036854775807 as i64

const _I64_MIN := 0 - 9223372036854775807 - 1

@en "Duration"
@fa "مدت"
@ar "مدة"
pub struct Duration:
    pub ns: i64 = 0

    @en "nanos"
    @fa "نانوثانیه"
    @ar "نانو ثانیة"
    pub func nanos(): i64: ret this.ns end

    @en "micros"
    @fa "میکروثانیه"
    @ar "میکرو ثانیة"
    pub func micros(): i64: ret this.ns / _NS_PER_US end

    @en "millis"
    @fa "میلی‌ثانیه"
    @ar "میلی ثانیة"
    pub func millis(): i64: ret this.ns / _NS_PER_MS end

    @en "secs"
    @fa "ثانیه‌های کامل"
    @ar "ثوان کاملة"
    pub func secs(): i64: ret this.ns / _NS_PER_SEC end

    @en "seconds"
    @fa "ثانیه"
    @ar "ثانیة"
    pub func seconds(): f64: ret (this.ns as f64) / 1000000000.0 end

    @en "minutes"
    @fa "دقیقه"
    @ar "دقیقة"
    pub func minutes(): f64: ret (this.ns as f64) / 60000000000.0 end

    @en "hours"
    @fa "ساعت"
    @ar "ساعة"
    pub func hours(): f64: ret (this.ns as f64) / 3600000000000.0 end

    @en "days"
    @fa "روز"
    @ar "یوم"
    pub func days(): f64: ret (this.ns as f64) / 86400000000000.0 end

    @en "add"
    @fa "جمع"
    @ar "جمع"
    pub func add(o: Duration): Duration: ret Duration { ns = this.ns + o.ns } end

    @en "sub"
    @fa "تفریق"
    @ar "طرح"
    pub func sub(o: Duration): Duration: ret Duration { ns = this.ns - o.ns } end

    @en "mul"
    @fa "ضرب"
    @ar "ضرب"
    pub func mul(k: i64): Duration: ret Duration { ns = this.ns * k } end

    @en "div"
    @fa "تقسیم"
    @ar "قسمة"
    pub func div(k: i64): Duration:
        if k == 0: ret Duration { ns = 0 } end
        ret Duration { ns = this.ns / k }
    end

    @en "ratio"
    @fa "نسبت"
    @ar "نسبة"
    pub func ratio(o: Duration): i64:
        if o.ns == 0: ret 0 end
        ret this.ns / o.ns
    end

    @en "neg"
    @fa "منفی"
    @ar "سالب"
    pub func neg(): Duration:
        if this.ns == _I64_MIN: ret Duration { ns = _I64_MAX } end
        ret Duration { ns = 0 - this.ns }
    end

    @en "abs"
    @fa "قدرمطلق"
    @ar "مطلق"
    pub func abs(): Duration:
        if this.ns == _I64_MIN: ret Duration { ns = _I64_MAX } end
        if this.ns < 0: ret Duration { ns = 0 - this.ns } end
        ret Duration { ns = this.ns }
    end

    @en "is_zero"
    @fa "صفر است"
    @ar "صفر"
    pub func is_zero(): bool: ret this.ns == 0 end

    @en "is_negative"
    @fa "منفی است"
    @ar "سالب"
    pub func is_negative(): bool: ret this.ns < 0 end

    @en "cmp"
    @fa "مقایسه"
    @ar "مقارنة"
    pub func cmp(o: Duration): int:
        if this.ns < o.ns: ret 0 - 1 end
        if this.ns > o.ns: ret 1 end
        ret 0
    end

    @en "less"
    @fa "کمتر"
    @ar "أصغر"
    pub func less(o: Duration): bool: ret this.ns < o.ns end

    @en "equals"
    @fa "برابر"
    @ar "یساوی"
    pub func equals(o: Duration): bool: ret this.ns == o.ns end

    @en "truncate"
    @fa "برش"
    @ar "قص"
    pub func truncate(m: Duration): Duration:
        if m.ns <= 0: ret Duration { ns = this.ns } end
        ret Duration { ns = this.ns - this.ns % m.ns }
    end

    @en "round"
    @fa "گرد کردن"
    @ar "تقریب"
    pub func round(m: Duration): Duration:
        if m.ns <= 0: ret Duration { ns = this.ns } end
        r := this.ns % m.ns
        down := this.ns - r
        if r < 0:
            nr := 0 - r
            if nr >= m.ns - nr:
                if down < _I64_MIN + m.ns: ret Duration { ns = down } end
                ret Duration { ns = down - m.ns }
            end
            ret Duration { ns = down }
        end
        if r >= m.ns - r:
            if down > _I64_MAX - m.ns: ret Duration { ns = down } end
            ret Duration { ns = down + m.ns }
        end
        ret Duration { ns = down }
    end

    @en "to_str"
    @fa "به رشته"
    @ar "إلى نص"
    pub func to_str(): str: ret FormatDuration(Duration { ns = this.ns }) end
end

@en "DurationResult"
@fa "نتیجه مدت"
@ar "نتیجة المدة"
pub struct DurationResult:
    pub ok: bool = false
    pub value: Duration = Duration { ns = 0 }
end

inline pure func _dbp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _dub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

inline pure func _isDigitByte(c: int): bool: ret c >= 48 && c <= 57 end

func _fracStr(rem: i64, digits: int): str:
    if rem == 0: ret "" end
    mut s := conv.FormatInt(rem)
    until s.len() < digits:
        s = "0" + s
    end
    mut e := s.len()
    until e > 0 && s.substr(e - 1, 1) == "0":
        e -= 1
    end
    ret "." + s.substr(0, e)
end

func _unitNanos(u: str): i64:
    if u == "ns": ret 1 end
    if u == "us": ret _NS_PER_US end
    if u == "µs": ret _NS_PER_US end
    if u == "μs": ret _NS_PER_US end
    if u == "ms": ret _NS_PER_MS end
    if u == "s": ret _NS_PER_SEC end
    if u == "m": ret _NS_PER_MIN end
    if u == "h": ret _NS_PER_HOUR end
    if u == "d": ret _NS_PER_DAY end
    ret 0
end

@en "Nanoseconds"
@fa "نانوثانیه‌ها"
@ar "نانو ثوان"
pub inline pure func Nanoseconds(n: i64): Duration: ret Duration { ns = n } end

@en "Microseconds"
@fa "میکروثانیه‌ها"
@ar "میکرو ثوان"
pub inline pure func Microseconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_US } end

@en "Milliseconds"
@fa "میلی‌ثانیه‌ها"
@ar "میلی ثوان"
pub inline pure func Milliseconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_MS } end

@en "Seconds"
@fa "ثانیه‌ها"
@ar "ثوان"
pub inline pure func Seconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_SEC } end

@en "Minutes"
@fa "دقیقه‌ها"
@ar "دقائق"
pub inline pure func Minutes(n: i64): Duration: ret Duration { ns = n * _NS_PER_MIN } end

@en "Hours"
@fa "ساعت‌ها"
@ar "ساعات"
pub inline pure func Hours(n: i64): Duration: ret Duration { ns = n * _NS_PER_HOUR } end

@en "Days"
@fa "روزها"
@ar "أیام"
pub inline pure func Days(n: i64): Duration: ret Duration { ns = n * _NS_PER_DAY } end

@en "SecondsF"
@fa "ثانیه اعشاری"
@ar "ثوان عشریة"
pub inline pure func SecondsF(x: f64): Duration: ret Duration { ns = (x * 1000000000.0) as i64 } end

@en "ZeroDuration"
@fa "مدت صفر"
@ar "مدة صفریة"
pub inline pure func ZeroDuration(): Duration: ret Duration { ns = 0 } end

@en "FormatDuration"
@fa "قالب مدت"
@ar "تنسیق المدة"
pub func FormatDuration(d: Duration): str:
    if d.ns == 0: ret "0s" end
    if d.ns == _I64_MIN: ret "-2562047h47m16.854775808s" end
    mut sign := ""
    mut v := d.ns
    if v < 0:
        sign = "-"
        v = 0 - v
    end
    if v < _NS_PER_US: ret sign + conv.FormatInt(v) + "ns" end
    if v < _NS_PER_MS:
        ret sign + conv.FormatInt(v / _NS_PER_US) + _fracStr(v % _NS_PER_US, 3) + "us"
    end
    if v < _NS_PER_SEC:
        ret sign + conv.FormatInt(v / _NS_PER_MS) + _fracStr(v % _NS_PER_MS, 6) + "ms"
    end
    secs := v / _NS_PER_SEC
    frac := _fracStr(v % _NS_PER_SEC, 9)
    if secs < 60: ret sign + conv.FormatInt(secs) + frac + "s" end
    if secs < 3600:
        ret sign + conv.FormatInt(secs / 60) + "m" + conv.FormatInt(secs % 60) + frac + "s"
    end
    h := secs / 3600
    m := (secs % 3600) / 60
    s := secs % 60
    ret sign + conv.FormatInt(h) + "h" + conv.FormatInt(m) + "m" + conv.FormatInt(s) + frac + "s"
end

@en "ParseDuration"
@fa "تجزیه مدت"
@ar "تحلیل المدة"
pub func ParseDuration(s: str): DurationResult:
    n := s.len()
    bad := DurationResult { ok = false, value = Duration { ns = 0 } }
    if n == 0: ret bad end
    bp := _dbp(s)
    mut i := 0
    mut neg := false
    c0 := _dub(bp, 0)
    if c0 == 45:
        neg = true
        i = 1
    else c0 == 43:
        i = 1
    end
    if i >= n: ret bad end
    if s.substr(i, n - i) == "0": ret DurationResult { ok = true, value = Duration { ns = 0 } } end
    mut total := 0 as i64
    mut groups := 0
    until i < n:
        mut whole := 0 as i64
        mut digits := 0
        until i < n && _isDigitByte(_dub(bp, i)):
            dv := (_dub(bp, i) - 48) as i64
            if whole > (_I64_MAX - dv) / 10: ret bad end
            whole = whole * 10 + dv
            digits += 1
            i += 1
        end
        mut fracNum := 0 as i64
        mut fracDen := 1 as i64
        if i < n && _dub(bp, i) == 46:
            i += 1
            mut fdigits := 0
            until i < n && _isDigitByte(_dub(bp, i)):
                if fdigits < 9:
                    fracNum = fracNum * 10 + ((_dub(bp, i) - 48) as i64)
                    fracDen = fracDen * 10
                    fdigits += 1
                end
                i += 1
            end
            if fdigits == 0: ret bad end
            digits = digits + fdigits
        end
        if digits == 0: ret bad end
        us := i
        until i < n && !_isDigitByte(_dub(bp, i)):
            i += 1
        end
        if i == us: ret bad end
        unitNs := _unitNanos(s.substr(us, i - us))
        if unitNs == 0: ret bad end
        if whole > _I64_MAX / unitNs: ret bad end
        q := unitNs / fracDen
        r := unitNs % fracDen
        fpart := fracNum * q + (fracNum * r) / fracDen
        part := whole * unitNs
        if part > _I64_MAX - fpart: ret bad end
        if total > _I64_MAX - (part + fpart): ret bad end
        total = total + part + fpart
        groups += 1
    end
    if groups == 0: ret bad end
    if neg: total = 0 - total end
    ret DurationResult { ok = true, value = Duration { ns = total } }
end

@en "ParseDurationOr"
@fa "تجزیه مدت یا"
@ar "تحلیل المدة أو"
pub func ParseDurationOr(s: str, fallback: Duration): Duration:
    r := ParseDuration(s)
    if r.ok: ret r.value end
    ret fallback
end

@en "SleepFor"
@fa "خواب به مدت"
@ar "نوم لمدة"
pub func SleepFor(d: Duration):
    if d.ns <= 0: ret end
    ms := d.ns / _NS_PER_MS
    if ms > 0:
        sleep_ms(ms as int)
        ret
    end
    sleep_ms(1)
end

@en "SinceDuration"
@fa "مدت از"
@ar "المدة منذ"
pub func SinceDuration(start_ns: i64): Duration:
    ret Duration { ns = _mono_ns() - start_ns }
end

@en "DurationBetween"
@fa "مدت بین"
@ar "المدة بین"
pub inline pure func DurationBetween(later: i64, earlier: i64): Duration:
    ret Duration { ns = (later - earlier) * _NS_PER_SEC }
end

@en "AddDuration"
@fa "افزودن مدت"
@ar "إضافة مدة"
pub inline pure func AddDuration(epoch: i64, d: Duration): i64:
    ret epoch + d.ns / _NS_PER_SEC
end
