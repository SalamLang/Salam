package time

@en "NowNanos"
@fa "اکنون نانوثانیه"
pub func NowNanos(): i64: ret _now_ns() end

@en "NowMicros"
@fa "اکنون میکروثانیه"
pub func NowMicros(): i64: ret _now_ns() / 1000 end

@en "NowMillis"
@fa "اکنون میلی ثانیه"
pub func NowMillis(): i64: ret _now_ns() / 1000000 end

@en "ElapsedMs"
@fa "سپری میلی ثانیه"
pub func ElapsedMs(start_ns: i64, end_ns: i64): f64:
    ret ((end_ns - start_ns) as f64) / 1000000.0
end

@en "ElapsedUs"
@fa "سپری میکروثانیه"
pub func ElapsedUs(start_ns: i64, end_ns: i64): f64:
    ret ((end_ns - start_ns) as f64) / 1000.0
end

@en "ElapsedSec"
@fa "سپری ثانیه"
pub func ElapsedSec(start_ns: i64, end_ns: i64): f64:
    ret ((end_ns - start_ns) as f64) / 1000000000.0
end

@en "MonoNanos"
@fa "نانوثانیه یکنواخت"
pub func MonoNanos(): i64: ret _mono_ns() end

@en "MonoMicros"
@fa "میکروثانیه یکنواخت"
pub func MonoMicros(): i64: ret _mono_ns() / 1000 end

@en "MonoMillis"
@fa "میلی‌ثانیه یکنواخت"
pub func MonoMillis(): i64: ret _mono_ns() / 1000000 end

@en "SinceNanos"
@fa "از نانوثانیه"
pub func SinceNanos(start_ns: i64): i64: ret _mono_ns() - start_ns end

@en "SinceMs"
@fa "از میلی ثانیه"
pub func SinceMs(start_ns: i64): f64:
    ret ((_mono_ns() - start_ns) as f64) / 1000000.0
end

@en "SinceUs"
@fa "از میکروثانیه"
pub func SinceUs(start_ns: i64): f64:
    ret ((_mono_ns() - start_ns) as f64) / 1000.0
end

@en "SinceSec"
@fa "از ثانیه"
pub func SinceSec(start_ns: i64): f64:
    ret ((_mono_ns() - start_ns) as f64) / 1000000000.0
end
