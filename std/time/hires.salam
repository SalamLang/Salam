package time

@en "NowNanos"
@fa "اکنون نانوثانیه"
@ar "الآن نانو ثانیة"
pub func NowNanos(): i64: ret _now_ns() end

@en "NowMicros"
@fa "اکنون میکروثانیه"
@ar "الآن میکرو ثانیة"
pub func NowMicros(): i64: ret _now_ns() / 1000 end

@en "NowMillis"
@fa "اکنون میلی ثانیه"
@ar "الآن میلی ثانیة"
pub func NowMillis(): i64: ret _now_ns() / 1000000 end

@en "ElapsedMs"
@fa "سپری میلی ثانیه"
@ar "المنقضی میلی ثانیة"
pub func ElapsedMs(start_ns: i64, end_ns: i64): f64:
    ret ((end_ns - start_ns) as f64) / 1000000.0
end

// Monotonic clock. Use these to MEASURE A DURATION; the Now* functions above
// read the wall clock, which is right for timestamps but wrong for timing:
// on Windows it only moves every ~15.6 ms, and on POSIX it can step backwards
// when the system clock is adjusted.

@en "MonoNanos"
@fa "نانوثانیه یکنواخت"
@ar "نانو ثانیة رتیبة"
pub func MonoNanos(): i64: ret _mono_ns() end

@en "MonoMicros"
@fa "میکروثانیه یکنواخت"
@ar "میکرو ثانیة رتیبة"
pub func MonoMicros(): i64: ret _mono_ns() / 1000 end

@en "MonoMillis"
@fa "میلی‌ثانیه یکنواخت"
@ar "میلی ثانیة رتیبة"
pub func MonoMillis(): i64: ret _mono_ns() / 1000000 end

@en "SinceNanos"
@fa "از نانوثانیه"
@ar "منذ نانو ثانیة"
pub func SinceNanos(start_ns: i64): i64: ret _mono_ns() - start_ns end

@en "SinceMs"
@fa "از میلی ثانیه"
@ar "منذ میلی ثانیة"
pub func SinceMs(start_ns: i64): f64:
    ret ((_mono_ns() - start_ns) as f64) / 1000000.0
end
