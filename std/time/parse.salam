package time

import mem
import conv

if SALAM_OS_WINDOWS:
    extern:
        func _mktime64(tp: void*): i64
    end
else:
    if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
        extern:
            func mktime(tp: void*): i64
        end
    else:
        if SALAM_OS_LINUX:
            extern:
                func __mktime64(tp: void*): i64
            end
        else:
            extern:
                func mktime(tp: void*): i64
            end
        end
    end
end

struct _Parts:
    pub year: int = 1970
    pub month: int = 1
    pub day: int = 1
    pub hour: int = 0
    pub minute: int = 0
    pub second: int = 0
    pub nanos: int = 0
    pub has_offset: bool = false
    pub offset_minutes: int = 0
    pub at_month: int = 0
    pub at_day: int = 0
    pub at_hour: int = 0
    pub at_minute: int = 0
    pub at_second: int = 0
end

inline pure func _pbp(s: str): i8*: ret (s as void*) as i8* end

inline pure func _pub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

pure func _pIsDigit(c: int): bool: ret c >= 48 and c <= 57 end

pure func _pIsAlpha(c: int): bool:
    ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
end

pure func _pIsBlank(c: int): bool:
    ret c == 32 or c == 9 or c == 10 or c == 13
end

func _tdesc(s: str, i: int): str:
    n := s.len()
    if i >= n: ret "the end of the text" end
    c := _pub(_pbp(s), i)
    if c == 32: ret "a space" end
    mut w := 1
    if c >= 240: w = 4
    else c >= 224: w = 3
    else c >= 192: w = 2
    end
    if c < 32 or c == 127 or (c >= 128 and c < 192) or i + w > n:
        ret "byte " + c
    end
    ret "'" + s.substr(i, w) + "'"
end

func _terr(s: str, kind: ErrorKind, code: str, message: str, offset: int): Error:
    ret Error.At(kind, message, offset).locate(s).with_code(code).wrap("time")
end

func _want(s: str, n: int, i: int, what: str): Error:
    if i >= n:
        ret _terr(s, ErrorKind.UnexpectedEnd, "time.unexpected_end", "expected " + what + ", found the end of the text", i)
    end
    ret _terr(s, ErrorKind.Syntax, "time.syntax", "expected " + what + ", found " + _tdesc(s, i), i)
end

func _trailing(s: str, i: int, after: str): Error:
    ret _terr(s, ErrorKind.Syntax, "time.trailing", "expected the end of the text after " + after + ", found " + _tdesc(s, i), i)
end

func _fixedDigits(s: str, n: int, i &: int, count: int, what: str): int throws:
    bp := _pbp(s)
    mut v := 0
    repeat count in k:
        if i + k >= n or not _pIsDigit(_pub(bp, i + k)):
            throw _want(s, n, i + k, "a digit in the " + what)
        end
        v = v * 10 + (_pub(bp, i + k) - 48)
    end
    i = i + count
    ret v
end

func _someDigits(s: str, n: int, i &: int, maxd: int, what: str): int throws:
    bp := _pbp(s)
    mut v := 0
    mut got := 0
    until i < n and got < maxd and _pIsDigit(_pub(bp, i)):
        v = v * 10 + (_pub(bp, i) - 48)
        got += 1
        i += 1
    end
    if got == 0: throw _want(s, n, i, "the " + what) end
    ret v
end

func _expectByte(s: str, n: int, i &: int, c: int, what: str) throws:
    if i >= n or _pub(_pbp(s), i) != c: throw _want(s, n, i, what) end
    i += 1
end

pure func _pfloordiv(a: i64, b: i64): i64:
    q := a / b
    r := a - q * b
    if r != 0 and (r < 0) != (b < 0): ret q - 1 end
    ret q
end

pure func _daysFromCivil(y0: int, m: int, d: int): i64:
    mut y := y0 as i64
    mm := m as i64
    if mm <= 2: y = y - 1 end
    era := _pfloordiv(y, 400)
    yoe := y - era * 400
    mp := (mm + 9) % 12
    doy := (153 * mp + 2) / 5 + (d as i64) - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    ret era * 146097 + doe - 719468
end

pure func _utcEpoch(y: int, mo: int, d: int, h: int, mi: int, s: int): i64:
    ret _daysFromCivil(y, mo, d) * 86400 + (h as i64) * 3600 + (mi as i64) * 60 + (s as i64)
end

pure func _pfloormod(a: i64, b: i64): i64:
    ret a - _pfloordiv(a, b) * b
end

pure func _gmFieldPure(epoch: i64, idx: int): int:
    days := _pfloordiv(epoch, 86400)
    secs := epoch - days * 86400
    if idx == 0: ret (secs % 60) as int end
    if idx == 1: ret ((secs / 60) % 60) as int end
    if idx == 2: ret (secs / 3600) as int end
    if idx == 6: ret _pfloormod(days + 4, 7) as int end

    z := days + 719468
    era := _pfloordiv(z, 146097)
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    mut m := mp + 3
    if mp >= 10: m = mp - 9 end
    mut y := yoe + era * 400
    if m <= 2: y = y + 1 end

    if idx == 3: ret d as int end
    if idx == 4: ret (m - 1) as int end
    if idx == 5: ret (y - 1900) as int end
    if idx == 7: ret (days - _daysFromCivil(y as int, 1, 1)) as int end
    ret 0
end

if SALAM_OS_WINDOWS:
    func _c_mktime(tp: void*): i64: ret _mktime64(tp) end
else:
    if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
        func _c_mktime(tp: void*): i64: ret mktime(tp) end
    else:
        if SALAM_OS_LINUX:
            func _c_mktime(tp: void*): i64: ret __mktime64(tp) end
        else:
            func _c_mktime(tp: void*): i64: ret mktime(tp) end
        end
    end
end

func _localEpoch(y: int, mo: int, d: int, h: int, mi: int, s: int): i64:
    buf := mem.AllocateZeroed(128 as u64)
    if buf == null: ret _utcEpoch(y, mo, d, h, mi, s) end
    p := buf as int*
    p[0] = s
    p[1] = mi
    p[2] = h
    p[3] = d
    p[4] = mo - 1
    p[5] = y - 1900
    p[8] = 0 - 1
    out := _c_mktime(buf)
    mem.Free(buf)
    if out == (0 - 1) as i64: ret _utcEpoch(y, mo, d, h, mi, s) end
    ret out
end

func _daysInMonth(y: int, m: int): int:
    if m == 2:
        if (y % 4 == 0 and y % 100 != 0) or y % 400 == 0: ret 29 end
        ret 28
    end
    if m == 4 or m == 6 or m == 9 or m == 11: ret 30 end
    ret 31
end

func _resolve(s: str, p: _Parts): i64 throws:
    if p.month < 1 or p.month > 12:
        throw _terr(s, ErrorKind.OutOfRange, "time.bad_month", "month " + p.month + " is out of range (1 to 12)", p.at_month)
    end
    dim := _daysInMonth(p.year, p.month)
    if p.day < 1 or p.day > dim:
        throw _terr(s, ErrorKind.OutOfRange, "time.bad_day", "day " + p.day + " is out of range for month " + p.month + " of " + p.year + " (1 to " + dim + ")", p.at_day)
    end
    if p.hour > 24 or (p.hour == 24 and (p.minute != 0 or p.second != 0 or p.nanos != 0)):
        throw _terr(s, ErrorKind.OutOfRange, "time.bad_hour", "hour " + p.hour + " is out of range (0 to 23, or 24:00:00)", p.at_hour)
    end
    if p.minute > 59:
        throw _terr(s, ErrorKind.OutOfRange, "time.bad_minute", "minute " + p.minute + " is out of range (0 to 59)", p.at_minute)
    end
    if p.second > 60:
        throw _terr(s, ErrorKind.OutOfRange, "time.bad_second", "second " + p.second + " is out of range (0 to 60)", p.at_second)
    end
    mut sec := p.second
    if sec == 60: sec = 59 end
    if p.has_offset:
        ret _utcEpoch(p.year, p.month, p.day, p.hour, p.minute, sec) - (p.offset_minutes as i64) * 60
    end
    ret _localEpoch(p.year, p.month, p.day, p.hour, p.minute, sec)
end

func _monthFromName(name: str): int:
    if name.len() < 3: ret 0 end
    k := name.substr(0, 3).lower()
    if k == "jan": ret 1 end
    if k == "feb": ret 2 end
    if k == "mar": ret 3 end
    if k == "apr": ret 4 end
    if k == "may": ret 5 end
    if k == "jun": ret 6 end
    if k == "jul": ret 7 end
    if k == "aug": ret 8 end
    if k == "sep": ret 9 end
    if k == "oct": ret 10 end
    if k == "nov": ret 11 end
    if k == "dec": ret 12 end
    ret 0
end

func _monthName(s: str, n: int, i &: int, p &: _Parts) throws:
    bp := _pbp(s)
    ms := i
    until i < n and _pIsAlpha(_pub(bp, i)):
        i += 1
    end
    if i == ms: throw _want(s, n, i, "a month name") end
    mo := _monthFromName(s.substr(ms, i - ms))
    if mo == 0:
        throw _terr(s, ErrorKind.Syntax, "time.bad_month_name", "unknown month name '" + s.substr(ms, i - ms) + "'", ms)
    end
    p.month = mo
    p.at_month = ms
end

func _parseZone(s: str, n: int, i &: int, p &: _Parts) throws:
    if i >= n: ret end
    bp := _pbp(s)
    c := _pub(bp, i)
    if c == 90 or c == 122:
        i += 1
        p.has_offset = true
        p.offset_minutes = 0
        ret
    end
    if c == 43 or c == 45:
        at := i
        sign := 1 - 2 * ((c == 45) ? 1 : 0)
        i += 1
        hh := try _fixedDigits(s, n, i, 2, "offset")
        mut mm := 0
        if i < n and _pub(bp, i) == 58:
            i += 1
            mm = try _fixedDigits(s, n, i, 2, "offset")
        else i < n and _pIsDigit(_pub(bp, i)):
            mm = try _fixedDigits(s, n, i, 2, "offset")
        end
        if hh > 23 or mm > 59:
            throw _terr(s, ErrorKind.OutOfRange, "time.bad_offset", "offset " + s.substr(at, i - at) + " is out of range (up to 23:59)", at)
        end
        p.has_offset = true
        p.offset_minutes = sign * (hh * 60 + mm)
    end
end

func _skipSpaces(s: str, n: int, i &: int):
    bp := _pbp(s)
    until i < n and (_pub(bp, i) == 32 or _pub(bp, i) == 9):
        i += 1
    end
end

func _parseClock(s: str, n: int, i &: int, p &: _Parts) throws:
    p.at_hour = i
    p.hour = try _fixedDigits(s, n, i, 2, "hour")
    try _expectByte(s, n, i, 58, "':' after the hour")
    p.at_minute = i
    p.minute = try _fixedDigits(s, n, i, 2, "minute")
    if i < n and _pub(_pbp(s), i) == 58:
        i += 1
        p.at_second = i
        p.second = try _fixedDigits(s, n, i, 2, "second")
    end
end

func _parseFraction(s: str, n: int, i &: int): int throws:
    bp := _pbp(s)
    mut scale := 100000000
    mut acc := 0
    mut got := 0
    until i < n and _pIsDigit(_pub(bp, i)):
        if scale >= 1:
            acc = acc + (_pub(bp, i) - 48) * scale
            scale = scale / 10
        end
        got += 1
        i += 1
    end
    if got == 0: throw _want(s, n, i, "a digit of the fraction") end
    ret acc
end

func _trimStart(s: str): int:
    bp := _pbp(s)
    n := s.len()
    mut i := 0
    until i < n and _pIsBlank(_pub(bp, i)):
        i += 1
    end
    ret i
end

func _trimEnd(s: str, from: int): int:
    bp := _pbp(s)
    mut n := s.len()
    until n > from and _pIsBlank(_pub(bp, n - 1)):
        n -= 1
    end
    ret n
end

func _empty(s: str, what: str): Error:
    ret _terr(s, ErrorKind.UnexpectedEnd, "time.empty", "empty " + what, 0)
end

func _scanISO(s: str, p &: _Parts) throws:
    mut i := _trimStart(s)
    n := _trimEnd(s, i)
    if i >= n: throw _empty(s, "date") end
    bp := _pbp(s)
    p.year = try _fixedDigits(s, n, i, 4, "year")
    try _expectByte(s, n, i, 45, "'-' after the year")
    p.at_month = i
    p.month = try _fixedDigits(s, n, i, 2, "month")
    try _expectByte(s, n, i, 45, "'-' after the month")
    p.at_day = i
    p.day = try _fixedDigits(s, n, i, 2, "day")
    if i >= n: ret end
    sep := _pub(bp, i)
    if sep != 84 and sep != 116 and sep != 32:
        throw _want(s, n, i, "'T' or a space before the time")
    end
    i += 1
    try _parseClock(s, n, i, p)
    if i < n and (_pub(bp, i) == 46 or _pub(bp, i) == 44):
        i += 1
        p.nanos = try _parseFraction(s, n, i)
    end
    try _parseZone(s, n, i, p)
    if i != n: throw _trailing(s, i, "the time") end
end

func _httpZone(s: str, n: int, i &: int, p &: _Parts) throws:
    if i >= n: ret end
    bp := _pbp(s)
    c := _pub(bp, i)
    if c == 43 or c == 45:
        try _parseZone(s, n, i, p)
        ret
    end
    zs := i
    until i < n and _pIsAlpha(_pub(bp, i)):
        i += 1
    end
    if i == zs: throw _want(s, n, zs, "GMT or an offset such as +0000") end
    word := s.substr(zs, i - zs)
    nm := word.upper()
    if nm != "GMT" and nm != "UTC" and nm != "UT" and nm != "Z":
        throw _terr(s, ErrorKind.Syntax, "time.syntax", "expected GMT or an offset such as +0000, found '" + word + "'", zs)
    end
end

func _layoutErr(pattern: str, message: str): Error:
    ret Error.New(ErrorKind.InvalidArgument, "layout \"" + pattern + "\" " + message).with_code("time.bad_layout").wrap("time")
end

func _layoutWant(s: str, n: int, i: int, lit: str): Error:
    mut what := "'" + lit + "'"
    if lit == " ": what = "a space" end
    if i >= n:
        ret _terr(s, ErrorKind.UnexpectedEnd, "time.unexpected_end", "expected " + what + " from the layout, found the end of the text", i)
    end
    ret _terr(s, ErrorKind.Syntax, "time.layout_mismatch", "expected " + what + " from the layout, found " + _tdesc(s, i), i)
end

@en "ParseISO"
@fa "تجزیه ایزو"
pub func ParseISO(s: str): i64 throws:
    mut p := _Parts {}
    try _scanISO(s, p)
    ret try _resolve(s, p)
end

@en "ParseISONanos"
@fa "تجزیه ایزو نانوثانیه"
pub func ParseISONanos(s: str): i64 throws:
    mut p := _Parts {}
    try _scanISO(s, p)
    epoch := try _resolve(s, p)
    nanos := p.nanos as i64
    lo := 0 - 9223372037 as i64
    hi := 9223372036 as i64
    if epoch > hi or epoch < lo or (epoch == hi and nanos > 854775807) or (epoch == lo and nanos < 145224192):
        throw _terr(s, ErrorKind.OutOfRange, "time.overflow", "date is outside the range of nanosecond timestamps (years 1677 to 2262)", _trimStart(s))
    end
    ret epoch * 1000000000 + nanos
end

@en "ParseISOIn"
@fa "تجزیه ایزو در"
pub func ParseISOIn(s: str, offsetMinutes: int): i64 throws:
    mut p := _Parts {}
    try _scanISO(s, p)
    if not p.has_offset:
        p.has_offset = true
        p.offset_minutes = offsetMinutes
    end
    ret try _resolve(s, p)
end

@en "ParseHTTPDate"
@fa "تجزیه تاریخ اچ‌تی‌تی‌پی"
pub func ParseHTTPDate(s: str): i64 throws:
    mut i := _trimStart(s)
    n := _trimEnd(s, i)
    if i >= n: throw _empty(s, "date") end
    bp := _pbp(s)
    ds := i
    until i < n and _pIsAlpha(_pub(bp, i)):
        i += 1
    end
    if i == ds: throw _want(s, n, i, "a day name such as 'Mon'") end
    mut isAsctime := true
    if i < n and _pub(bp, i) == 44:
        i += 1
        isAsctime = false
    end
    _skipSpaces(s, n, i)
    mut p := _Parts { has_offset = true, offset_minutes = 0 }
    if isAsctime:
        try _monthName(s, n, i, p)
        _skipSpaces(s, n, i)
        p.at_day = i
        p.day = try _someDigits(s, n, i, 2, "day")
        _skipSpaces(s, n, i)
        try _parseClock(s, n, i, p)
        _skipSpaces(s, n, i)
        p.year = try _fixedDigits(s, n, i, 4, "year")
        if i != n: throw _trailing(s, i, "the year") end
        ret try _resolve(s, p)
    end
    p.at_day = i
    p.day = try _someDigits(s, n, i, 2, "day")
    if i < n and (_pub(bp, i) == 45 or _pub(bp, i) == 32): i += 1 end
    try _monthName(s, n, i, p)
    if i < n and (_pub(bp, i) == 45 or _pub(bp, i) == 32): i += 1 end
    mut y := try _someDigits(s, n, i, 4, "year")
    if y < 100:
        if y < 69: y = y + 2000
        else:
            y = y + 1900
        end
    end
    p.year = y
    _skipSpaces(s, n, i)
    try _parseClock(s, n, i, p)
    _skipSpaces(s, n, i)
    try _httpZone(s, n, i, p)
    if i != n: throw _trailing(s, i, "the time") end
    ret try _resolve(s, p)
end

@en "ParseFormat"
@fa "تجزیه با قالب"
pub func ParseFormat(pattern: str, s: str): i64 throws:
    pn := pattern.len()
    n := s.len()
    pbpv := _pbp(pattern)
    bp := _pbp(s)
    mut pi := 0
    mut i := 0
    mut p := _Parts {}
    until pi < pn:
        pc := _pub(pbpv, pi)
        if pc != 37:
            if pc == 32:
                pi += 1
                _skipSpaces(s, n, i)
                continue
            end
            if i >= n or _pub(bp, i) != pc: throw _layoutWant(s, n, i, pattern.substr(pi, 1)) end
            pi += 1
            i += 1
            continue
        end
        pi += 1
        if pi >= pn: throw _layoutErr(pattern, "ends with a lone '%'") end
        d := _pub(pbpv, pi)
        pi += 1
        if d == 37:
            if i >= n or _pub(bp, i) != 37: throw _layoutWant(s, n, i, "%") end
            i += 1
        else d == 89:
            p.year = try _fixedDigits(s, n, i, 4, "year")
        else d == 121:
            v := try _fixedDigits(s, n, i, 2, "year")
            if v < 69: p.year = v + 2000 else:
                p.year = v + 1900
            end
        else d == 109:
            p.at_month = i
            p.month = try _someDigits(s, n, i, 2, "month")
        else d == 100:
            p.at_day = i
            p.day = try _someDigits(s, n, i, 2, "day")
        else d == 72:
            p.at_hour = i
            p.hour = try _someDigits(s, n, i, 2, "hour")
        else d == 77:
            p.at_minute = i
            p.minute = try _someDigits(s, n, i, 2, "minute")
        else d == 83:
            p.at_second = i
            p.second = try _someDigits(s, n, i, 2, "second")
        else d == 102:
            p.nanos = try _parseFraction(s, n, i)
        else d == 98 or d == 66:
            try _monthName(s, n, i, p)
        else d == 97 or d == 65:
            ds := i
            until i < n and _pIsAlpha(_pub(bp, i)):
                i += 1
            end
            if i == ds: throw _want(s, n, i, "a day name") end
        else d == 122:
            try _parseZone(s, n, i, p)
        else d == 90:
            zs := i
            until i < n and _pIsAlpha(_pub(bp, i)):
                i += 1
            end
            if i == zs: throw _want(s, n, i, "a zone name") end
            nm := s.substr(zs, i - zs).upper()
            if nm == "GMT" or nm == "UTC" or nm == "Z":
                p.has_offset = true
                p.offset_minutes = 0
            end
        else:
            throw _layoutErr(pattern, "has an unknown directive '%" + pattern.substr(pi - 1, 1) + "'")
        end
    end
    if i != n: throw _trailing(s, i, "the layout") end
    ret try _resolve(s, p)
end

@en "ParseISOOr"
@fa "تجزیه ایزو با پیش فرض"
pub func ParseISOOr(s: str, fallback: i64): i64:
    try:
        ret ParseISO(s)
    catch:
        ret fallback
    end
end

@en "FormatISOUTC"
@fa "قالب ایزو جهانی"
pub func FormatISOUTC(epoch: i64): str:
    y := _gm_field(epoch, 5) + 1900
    mo := _gm_field(epoch, 4) + 1
    d := _gm_field(epoch, 3)
    ret conv.FormatInt(y as i64) + "-" + pad2(mo) + "-" + pad2(d) + "T" + pad2(_gm_field(epoch, 2)) + ":" + pad2(_gm_field(epoch, 1)) + ":" + pad2(_gm_field(epoch, 0)) + "Z"
end

@en "FormatRFC3339"
@fa "قالب آر‌اف‌سی۳۳۳۹"
pub func FormatRFC3339(epoch: i64): str:
    body := FormatDate(epoch) + "T" + FormatTime(epoch)
    off := LocalOffsetMinutesAt(epoch)
    if off == 0: ret body + "Z" end
    mut sign := "+"
    mut v := off
    if v < 0:
        sign = "-"
        v = 0 - v
    end
    ret body + sign + pad2(v / 60) + ":" + pad2(v % 60)
end

@en "LocalOffsetMinutesAt"
@fa "اختلاف محلی در"
pub func LocalOffsetMinutesAt(epoch: i64): int:
    local := _utcEpoch(time_year(epoch), time_month(epoch), time_day(epoch), time_hour(epoch), time_minute(epoch), time_second(epoch))
    ret ((local - epoch) / 60) as int
end

@en "FromLocalParts"
@fa "از اجزای محلی"
pub func FromLocalParts(year: int, month: int, day: int, hour: int, minute: int, second: int): i64:
    ret _localEpoch(year, month, day, hour, minute, second)
end

@en "FromUTCParts"
@fa "از اجزای جهانی"
pub func FromUTCParts(year: int, month: int, day: int, hour: int, minute: int, second: int): i64:
    ret _utcEpoch(year, month, day, hour, minute, second)
end
