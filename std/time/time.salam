@en "time"
@fa "زمان"
@ar "وقت"
package time

import mem
import conv

extern:
    func time(tp: void*): i64
    func localtime(tp: void*): void*
    func gmtime(tp: void*): void*
end

if SALAM_OS_WINDOWS:
    extern:
        func SleepEx(ms: u32, alertable: int): u32
        func GetSystemTimeAsFileTime(ft: void*)
    end
else:
    extern:
        func usleep(usec: u32): int
    end
    if SALAM_ARCH_X64 || SALAM_ARCH_ARM64:
        extern:
            func clock_gettime(clock_id: int, ts: void*): int
        end
    end
end

@en "SecondsPerMinute"
@fa "ثانیه در دقیقه"
@ar "ثوانی فی الدقیقة"
pub const SecondsPerMinute := 60
@en "SecondsPerHour"
@fa "ثانیه در ساعت"
@ar "ثوانی فی الساعة"
pub const SecondsPerHour := 3600
@en "SecondsPerDay"
@fa "ثانیه در روز"
@ar "ثوانی فی الیوم"
pub const SecondsPerDay := 86400

@en "DateTime"
@fa "تاریخ زمان"
@ar "تاریخ ووقت"
pub struct DateTime:
    pub epoch: i64 = 0
end

if SALAM_OS_WINDOWS:
    func sleep_ms(ms: int):
        if ms > 0:
            SleepEx(ms as u32, 0)
        end
    end
else:
    func sleep_ms(ms: int):
        if ms > 0:
            usleep((ms * 1000) as u32)
        end
    end
end

func time_now(): i64:
    ret time(null)
end

func _localtime(epoch: i64): void*:
    tp := mem.Allocate(8 as u64)
    tp64 := tp as i64*
    tp64[0] = epoch
    tm := localtime(tp)
    mem.Free(tp)
    ret tm
end

func _tm_field(epoch: i64, idx: int): int:
    tm := _localtime(epoch)
    if tm == null: ret 0 end
    tm32 := tm as int*
    ret tm32[idx]
end

func time_year(epoch: i64): int: ret _tm_field(epoch, 5) + 1900 end

func time_month(epoch: i64): int: ret _tm_field(epoch, 4) + 1 end

func time_day(epoch: i64): int: ret _tm_field(epoch, 3) end

func time_hour(epoch: i64): int: ret _tm_field(epoch, 2) end

func time_minute(epoch: i64): int: ret _tm_field(epoch, 1) end

func time_second(epoch: i64): int: ret _tm_field(epoch, 0) end

func pad2(n: int): str:
    s := conv.FormatInt(n as i64)
    if s.len() < 2: ret "0".concat(s) end
    ret s
end

func _gmtime(epoch: i64): void*:
    tp := mem.Allocate(8 as u64)
    tp64 := tp as i64*
    tp64[0] = epoch
    tm := gmtime(tp)
    mem.Free(tp)
    ret tm
end

func _gm_field(epoch: i64, idx: int): int:
    tm := _gmtime(epoch)
    if tm == null: ret 0 end
    tm32 := tm as int*
    ret tm32[idx]
end

func _weekday_name(w: int): str:
    if w == 0: ret "Sun"
    else w == 1: ret "Mon"
    else w == 2: ret "Tue"
    else w == 3: ret "Wed"
    else w == 4: ret "Thu"
    else w == 5: ret "Fri"
    else:
        ret "Sat"
    end
end

func _month_name(m: int): str:
    if m == 0: ret "Jan"
    else m == 1: ret "Feb"
    else m == 2: ret "Mar"
    else m == 3: ret "Apr"
    else m == 4: ret "May"
    else m == 5: ret "Jun"
    else m == 6: ret "Jul"
    else m == 7: ret "Aug"
    else m == 8: ret "Sep"
    else m == 9: ret "Oct"
    else m == 10: ret "Nov"
    else:
        ret "Dec"
    end
end

if SALAM_OS_WINDOWS:
    func _now_ns(): i64:
        buf := mem.Allocate(8 as u64)
        GetSystemTimeAsFileTime(buf)
        p := buf as u64*
        ft := p[0] as i64
        mem.Free(buf)
        ret (ft - 116444736000000000) * 100
    end
else:
    if SALAM_ARCH_X64 || SALAM_ARCH_ARM64:
        func _now_ns(): i64:
            buf := mem.AllocateZeroed(16 as u64)
            mut out := 0 as i64
            if clock_gettime(0, buf) == 0:
                p := buf as i64*
                out = p[0] * 1000000000 + p[1]
            end
            mem.Free(buf)
            ret out
        end
    else:
        func _now_ns(): i64:
            ret time_now() * 1000000000
        end
    end
end

@en "Now"
@fa "اکنون"
@ar "الآن"
pub func Now(): i64: ret time_now() end

@en "NowDateTime"
@fa "تاریخ زمان اکنون"
@ar "تاریخ ووقت الآن"
pub func NowDateTime(): DateTime:
    ret DateTime { epoch = time_now() }
end

@en "FromEpoch"
@fa "از مبدا"
@ar "من الحقبة"
pub func FromEpoch(seconds: i64): DateTime:
    ret DateTime { epoch = seconds }
end

@en "Epoch"
@fa "مبدا"
@ar "الحقبة"
pub inline pure func Epoch(dt: DateTime): i64:
    ret dt.epoch
end

@en "Year"
@fa "سال"
@ar "سنة"
pub func Year(epoch: i64): int: ret time_year(epoch) end

@en "Month"
@fa "ماه"
@ar "شهر"
pub func Month(epoch: i64): int: ret time_month(epoch) end

@en "Day"
@fa "روز"
@ar "یوم"
pub func Day(epoch: i64): int: ret time_day(epoch) end

@en "Hour"
@fa "ساعت"
@ar "ساعة"
pub func Hour(epoch: i64): int: ret time_hour(epoch) end

@en "Minute"
@fa "دقیقه"
@ar "دقیقة"
pub func Minute(epoch: i64): int: ret time_minute(epoch) end

@en "Second"
@fa "ثانیه"
@ar "ثانیة"
pub func Second(epoch: i64): int: ret time_second(epoch) end

@en "Weekday"
@fa "روز هفته"
@ar "یوم الأسبوع"
pub func Weekday(epoch: i64): int: ret _tm_field(epoch, 6) end

@en "YearDay"
@fa "روز سال"
@ar "یوم السنة"
pub func YearDay(epoch: i64): int: ret _tm_field(epoch, 7) + 1 end

@en "FormatDate"
@fa "قالب تاریخ"
@ar "تنسیق التاریخ"
pub func FormatDate(epoch: i64): str:
    y := time_year(epoch)
    mo := time_month(epoch)
    d := time_day(epoch)
    ret conv.FormatInt(y as i64).concat("-").concat(pad2(mo)).concat("-").concat(pad2(d))
end

@en "FormatTime"
@fa "قالب ساعت"
@ar "تنسیق الوقت"
pub func FormatTime(epoch: i64): str:
    h := time_hour(epoch)
    mi := time_minute(epoch)
    s := time_second(epoch)
    ret pad2(h).concat(":").concat(pad2(mi)).concat(":").concat(pad2(s))
end

@en "Format"
@fa "قالب بندی"
@ar "تنسیق"
pub func Format(epoch: i64): str:
    ret FormatDate(epoch).concat(" ").concat(FormatTime(epoch))
end

@en "FormatISO"
@fa "قالب ایزو"
@ar "تنسیق ایزو"
pub func FormatISO(epoch: i64): str:
    ret FormatDate(epoch).concat("T").concat(FormatTime(epoch))
end

// RFC 1123 "HTTP-date" (e.g. "Wed, 09 Jun 2021 10:18:14 GMT") - the format
// required by Set-Cookie's Expires attribute and the Date/Last-Modified/
// If-Modified-Since headers. Always in GMT (gmtime), never local time -
// FormatDate/FormatTime above are wall-clock-local and would produce a
// wrong, timezone-dependent Expires that browsers evaluate at face value.
@en "FormatHTTPDate"
@fa "قالب تاریخ اچ‌تی‌تی‌پی"
@ar "تنسیق تاریخ HTTP"
pub func FormatHTTPDate(epoch: i64): str:
    wd := _weekday_name(_gm_field(epoch, 6))
    day := _gm_field(epoch, 3)
    mo := _month_name(_gm_field(epoch, 4))
    yr := _gm_field(epoch, 5) + 1900
    hh := _gm_field(epoch, 2)
    mi := _gm_field(epoch, 1)
    ss := _gm_field(epoch, 0)
    ret wd.concat(", ").concat(pad2(day)).concat(" ").concat(mo).concat(" ").concat(conv.FormatInt(yr as i64)).concat(" ").concat(pad2(hh)).concat(":").concat(pad2(mi)).concat(":").concat(pad2(ss)).concat(" GMT")
end

@en "Sleep"
@fa "خواب"
@ar "نوم"
pub func Sleep(ms: int):
    sleep_ms(ms)
end

@en "DiffSeconds"
@fa "اختلاف ثانیه"
@ar "فرق الثوانی"
pub inline pure func DiffSeconds(later: i64, earlier: i64): i64:
    ret later - earlier
end

@en "Since"
@fa "از زمان"
@ar "منذ"
pub func Since(t: i64): i64:
    ret time_now() - t
end

@en "Until"
@fa "تا زمان"
@ar "حتى"
pub func Until(t: i64): i64:
    ret t - time_now()
end
