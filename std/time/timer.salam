package time

import mem

if SALAM_OS_WINDOWS:
    extern:
        func SetWaitableTimer(timer: void*, due: void*, period: int, routine: void*, arg: void*, resume: int): int
        func WaitForSingleObject(h: void*, ms: int): int
        func CloseHandle(h: void*): int
    end
    if SALAM_ARCH_X86:
        extern:
            func CreateWaitableTimerExW(attrs: void*, name: void*, flags: u32, access: u32): void*
        end
    else:
        extern:
            func GetModuleHandleA(name: str): void*
            func GetProcAddress(mod: void*, name: str): void*
        end
    end
    mut _hires_off := false
end

@en "Timer"
@fa "زمان‌سنج"
pub struct Timer:
    @en "deadline_ns"
    @fa "مهلت"
    pub deadline_ns: i64 = 0
    @en "active"
    @fa "فعال"
    pub active: bool = false

    @en "Expired"
    @fa "منقضی شده"
    pub func Expired(): bool:
        if not this.active: ret false end
        ret _mono_ns() >= this.deadline_ns
    end
    @en "expired"
    @fa "منقضی شده"
    pub func expired(): bool: ret this.Expired() end

    @en "Remaining"
    @fa "باقی‌مانده"
    pub func Remaining(): Duration:
        if not this.active: ret Duration { ns = 0 } end
        rem := this.deadline_ns - _mono_ns()
        if rem < 0: ret Duration { ns = 0 } end
        ret Duration { ns = rem }
    end
    @en "remaining"
    @fa "باقی‌مانده"
    pub func remaining(): Duration: ret this.Remaining() end

    @en "Wait"
    @fa "انتظار"
    pub func Wait():
        if not this.active: ret end
        _sleepUntil(this.deadline_ns)
    end
    @en "wait"
    @fa "انتظار"
    pub func wait(): this.Wait() end

    @en "Reset"
    @fa "بازنشانی"
    pub func Reset(d: Duration):
        this.deadline_ns = _mono_ns() + d.ns
        this.active = true
    end
    @en "reset"
    @fa "بازنشانی"
    pub func reset(d: Duration): this.Reset(d) end

    @en "Stop"
    @fa "توقف"
    pub func Stop():
        this.active = false
    end
    @en "stop"
    @fa "توقف"
    pub func stop(): this.Stop() end
end

@en "Ticker"
@fa "تیک‌زن"
pub struct Ticker:
    @en "interval_ns"
    @fa "بازه"
    pub interval_ns: i64 = 0
    @en "next_ns"
    @fa "بعدی"
    pub next_ns: i64 = 0
    @en "active"
    @fa "فعال"
    pub active: bool = false
    @en "dropped"
    @fa "از دست رفته"
    pub dropped: i64 = 0

    @en "Fired"
    @fa "رخ داده"
    pub func Fired(): bool:
        if not this.active or this.interval_ns <= 0: ret false end
        if _mono_ns() < this.next_ns: ret false end
        this.Advance()
        ret true
    end
    @en "fired"
    @fa "رخ داده"
    pub func fired(): bool: ret this.Fired() end

    @en "Wait"
    @fa "انتظار"
    pub func Wait():
        if not this.active or this.interval_ns <= 0: ret end
        late := _mono_ns() - this.next_ns
        if late >= this.interval_ns:
            missed := late / this.interval_ns
            this.dropped += missed
            this.next_ns += missed * this.interval_ns
        end
        _sleepUntil(this.next_ns)
        this.next_ns += this.interval_ns
    end
    @en "wait"
    @fa "انتظار"
    pub func wait(): this.Wait() end

    @en "Advance"
    @fa "پیشروی"
    pub func Advance():
        this.next_ns += this.interval_ns
        now := _mono_ns()
        if this.next_ns <= now:
            missed := (now - this.next_ns) / this.interval_ns + 1
            this.dropped += missed
            this.next_ns += missed * this.interval_ns
        end
    end
    @en "advance"
    @fa "پیشروی"
    pub func advance(): this.Advance() end

    @en "Remaining"
    @fa "باقی‌مانده"
    pub func Remaining(): Duration:
        if not this.active: ret Duration { ns = 0 } end
        rem := this.next_ns - _mono_ns()
        if rem < 0: ret Duration { ns = 0 } end
        ret Duration { ns = rem }
    end
    @en "remaining"
    @fa "باقی‌مانده"
    pub func remaining(): Duration: ret this.Remaining() end

    @en "Reset"
    @fa "بازنشانی"
    pub func Reset(d: Duration):
        this.interval_ns = d.ns
        this.next_ns = _mono_ns() + d.ns
        this.active = d.ns > 0
        this.dropped = 0
    end
    @en "reset"
    @fa "بازنشانی"
    pub func reset(d: Duration): this.Reset(d) end

    @en "Stop"
    @fa "توقف"
    pub func Stop():
        this.active = false
    end
    @en "stop"
    @fa "توقف"
    pub func stop(): this.Stop() end
end

if SALAM_OS_WINDOWS:
    if SALAM_ARCH_X86:
        func _hiresTimerNew(): void*:
            ret CreateWaitableTimerExW(null, null, 2 as u32, 1048578 as u32)
        end
    else:
        func _hiresTimerNew(): void*:
            fp := GetProcAddress(GetModuleHandleA("kernel32.dll"), "CreateWaitableTimerExW")
            if fp == null: ret null end
            f := fp as extern func (void*, void*, u32, u32) void*
            ret f(null, null, 2 as u32, 1048578 as u32)
        end
    end

    func _sleepChunk(ns: i64):
        mut ms := (ns + 999999) / 1000000
        if ms > 1000: ms = 1000 end
        SleepEx(ms as u32, 0)
    end

    func _sleepCoarse(deadline_ns: i64):
        until true:
            rem := deadline_ns - _mono_ns()
            if rem <= 0: break end
            if rem > 20000000:
                _sleepChunk(rem - 16000000)
            else:
                SleepEx(0 as u32, 0)
            end
        end
    end

    func _sleepUntil(deadline_ns: i64):
        if _mono_ns() >= deadline_ns: ret end
        if _hires_off:
            _sleepCoarse(deadline_ns)
            ret
        end
        h := _hiresTimerNew()
        if h == null:
            _hires_off = true
            _sleepCoarse(deadline_ns)
            ret
        end
        due := mem.Allocate(8 as u64)
        dp := due as i64*
        until true:
            rem := deadline_ns - _mono_ns()
            if rem <= 0: break end
            dp[0] = 0 - (rem + 99) / 100
            if SetWaitableTimer(h, due, 0, null, null, 0) == 0 or WaitForSingleObject(h, 0 - 1) != 0:
                _hires_off = true
                _sleepCoarse(deadline_ns)
                break
            end
        end
        mem.Free(due)
        _cl := CloseHandle(h)
    end
else:
    func _sleepChunk(ns: i64):
        mut us := (ns + 999) / 1000
        if us > 999999: us = 999999 end
        usleep(us as u32)
    end

    func _sleepUntil(deadline_ns: i64):
        until true:
            rem := deadline_ns - _mono_ns()
            if rem <= 0: break end
            _sleepChunk(rem)
        end
    end
end

@en "NewTimer"
@fa "زمان‌سنج جدید"
pub func NewTimer(d: Duration): Timer:
    ret Timer { deadline_ns = _mono_ns() + d.ns, active = true }
end

@en "NewTicker"
@fa "تیک‌زن جدید"
pub func NewTicker(d: Duration): Ticker:
    if d.ns <= 0: ret Ticker { interval_ns = 0, next_ns = 0, active = false } end
    ret Ticker { interval_ns = d.ns, next_ns = _mono_ns() + d.ns, active = true }
end

@en "AfterFunc"
@fa "پس از"
pub func AfterFunc(d: Duration, fn: func ()):
    SleepFor(d)
    fn()
end

@en "Every"
@fa "هر"
pub func Every(d: Duration, fn: func () bool): i64:
    mut tk := NewTicker(d)
    if not tk.active: ret 0 end
    mut n := 0 as i64
    until true:
        tk.wait()
        n++
        if not fn(): break end
    end
    ret n
end

@en "RepeatEvery"
@fa "تکرار با فاصله"
pub func RepeatEvery(d: Duration, count: int, fn: func ()):
    if count <= 0: ret end
    mut tk := NewTicker(d)
    if not tk.active: ret end
    repeat count:
        tk.wait()
        fn()
    end
end

@en "WaitUntil"
@fa "صبر برای"
pub func WaitUntil(fn: func () bool, poll: Duration, limit: Duration): bool:
    mut t := NewTimer(limit)
    until true:
        if fn(): ret true end
        if t.expired(): ret false end
        rem := t.remaining()
        if poll.ns < rem.ns:
            SleepFor(poll)
        else:
            SleepFor(rem)
        end
    end
end
