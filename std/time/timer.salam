// Timers, tickers and deadlines.
//
// All of these run on the MONOTONIC clock, so they keep working when the
// system clock is stepped by NTP or by a user editing the date. A deadline
// built from time.Now() would silently fire an hour early or late when that
// happens; these cannot.
//
// A Ticker paces a loop:
//
//     mut tk := time.NewTicker(time.Seconds(1))
//     repeat 10:
//         tk.wait()
//         poll()
//     end
//
// A Timer is a deadline you can test without blocking:
//
//     mut t := time.NewTimer(time.Seconds(30))
//     until !t.expired() && more_work():
//         step()
//     end
//
// NO TICK IS EVER DELIVERED LATE-AND-STACKED. If the body of a loop takes
// longer than the interval, a Ticker drops the ticks that were missed and
// stays on the original phase rather than firing several times in a row to
// catch up - the behavior Go's time.Ticker has, and the one that keeps a
// slow poller from turning into a busy loop. `tk.dropped` counts what was
// skipped, so a loop that is falling behind can notice and say so.
//
// BACKGROUND TIMERS. `spawn` takes a function of no arguments, so there is
// no callback registry here; a background timer is a spawned worker that
// owns its own Ticker:
//
//     func heartbeat():
//         mut tk := time.NewTicker(time.Seconds(5))
//         until running:
//             tk.wait()
//             ping()
//         end
//     end
//     h := spawn(heartbeat)
package time

// A one-shot deadline on the monotonic clock.
@en "Timer"
@fa "زمان‌سنج"
@ar "مؤقت"
pub struct Timer:
    // Monotonic nanoseconds at which this fires.
    pub deadline_ns: i64 = 0
    // A stopped Timer never reports expired and never waits.
    pub active: bool = false

    @en "expired"
    @fa "منقضی شده"
    @ar "منتهی"
    pub func expired(): bool:
        if !this.active: ret false end
        ret _mono_ns() >= this.deadline_ns
    end

    // Time left, or zero once it has fired. Never negative, so it can be
    // fed straight back into a sleep.
    @en "remaining"
    @fa "باقی‌مانده"
    @ar "المتبقی"
    pub func remaining(): Duration:
        if !this.active: ret Duration { ns = 0 } end
        rem := this.deadline_ns - _mono_ns()
        if rem < 0: ret Duration { ns = 0 } end
        ret Duration { ns = rem }
    end

    // Block until it fires. Returns immediately if it already has, or if
    // the Timer is stopped.
    @en "wait"
    @fa "انتظار"
    @ar "انتظار"
    pub func wait():
        if !this.active: ret end
        _sleepUntil(this.deadline_ns)
    end

    // Restart with a fresh span measured from now.
    @en "reset"
    @fa "بازنشانی"
    @ar "إعادة"
    pub func reset(d: Duration):
        this.deadline_ns = _mono_ns() + d.ns
        this.active = true
    end

    @en "stop"
    @fa "توقف"
    @ar "إیقاف"
    pub func stop():
        this.active = false
    end
end

// A repeating tick on a fixed cadence.
@en "Ticker"
@fa "تیک‌زن"
@ar "مؤقت دوری"
pub struct Ticker:
    pub interval_ns: i64 = 0
    // Monotonic nanoseconds of the next tick.
    pub next_ns: i64 = 0
    pub active: bool = false
    // Ticks skipped because the caller was slower than the interval.
    pub dropped: i64 = 0

    // Non-blocking: true exactly once per elapsed interval, and advances
    // to the next one. Use this to fold periodic work into a loop that is
    // already doing something else.
    @en "fired"
    @fa "رخ داده"
    @ar "أطلق"
    pub func fired(): bool:
        if !this.active || this.interval_ns <= 0: ret false end
        if _mono_ns() < this.next_ns: ret false end
        this.advance()
        ret true
    end

    // Block until the next tick, then advance.
    @en "wait"
    @fa "انتظار"
    @ar "انتظار"
    pub func wait():
        if !this.active || this.interval_ns <= 0: ret end
        _sleepUntil(this.next_ns)
        this.advance()
    end

    // Moves next_ns one interval on, skipping whole intervals already
    // missed so the cadence keeps its original phase instead of firing
    // repeatedly to catch up.
    @en "advance"
    @fa "پیشروی"
    @ar "تقدم"
    pub func advance():
        this.next_ns = this.next_ns + this.interval_ns
        now := _mono_ns()
        if this.next_ns <= now:
            missed := (now - this.next_ns) / this.interval_ns + 1
            this.dropped = this.dropped + missed
            this.next_ns = this.next_ns + missed * this.interval_ns
        end
    end

    // Time until the next tick; zero when one is already due.
    @en "remaining"
    @fa "باقی‌مانده"
    @ar "المتبقی"
    pub func remaining(): Duration:
        if !this.active: ret Duration { ns = 0 } end
        rem := this.next_ns - _mono_ns()
        if rem < 0: ret Duration { ns = 0 } end
        ret Duration { ns = rem }
    end

    // Change the cadence; the next tick is one full interval from now.
    @en "reset"
    @fa "بازنشانی"
    @ar "إعادة"
    pub func reset(d: Duration):
        this.interval_ns = d.ns
        this.next_ns = _mono_ns() + d.ns
        this.active = d.ns > 0
        this.dropped = 0
    end

    @en "stop"
    @fa "توقف"
    @ar "إیقاف"
    pub func stop():
        this.active = false
    end
end

// -- internals ------------------------------------------------------------

// Sleeps until a monotonic deadline. Loops because sleep_ms has
// millisecond granularity and may return early on a signal.
func _sleepUntil(deadline_ns: i64):
    until true:
        rem := deadline_ns - _mono_ns()
        if rem <= 0: break end
        ms := rem / 1000000
        if ms > 0:
            sleep_ms(ms as int)
        else:
            sleep_ms(1)
        end
    end
end

// -- constructors ---------------------------------------------------------

// A Timer that fires once, `d` from now. A zero or negative `d` gives an
// already-expired Timer rather than one that never fires.
@en "NewTimer"
@fa "زمان‌سنج جدید"
@ar "مؤقت جدید"
pub func NewTimer(d: Duration): Timer:
    ret Timer { deadline_ns = _mono_ns() + d.ns, active = true }
end

// A Ticker firing every `d`. A zero or negative interval yields an
// inactive Ticker, so a misconfigured value cannot spin.
@en "NewTicker"
@fa "تیک‌زن جدید"
@ar "مؤقت دوری جدید"
pub func NewTicker(d: Duration): Ticker:
    if d.ns <= 0: ret Ticker { interval_ns = 0, next_ns = 0, active = false } end
    ret Ticker { interval_ns = d.ns, next_ns = _mono_ns() + d.ns, active = true }
end

// -- callback helpers -----------------------------------------------------
//
// ⚠ A LAMBDA CAPTURES ENCLOSING LOCALS BY VALUE, so a callback that
// assigns to a local of the calling function updates its own copy and the
// caller sees nothing:
//
//     mut n := 0
//     time.RepeatEvery(time.Seconds(1), 3, (): n = n + 1 end)
//     println n                  // 0, not 3
//
// Callbacks communicate through top-level `mut` globals instead - the same
// rule spawned threads live under, for the same reason:
//
//     mut n := 0                 // at top level, outside any function
//     time.RepeatEvery(time.Seconds(1), 3, (): n = n + 1 end)
//     println n                  // 3

// Sleep for `d`, then call `fn` once. This BLOCKS - Salam's `spawn` takes
// a function of no arguments, so there is no way to hand a delay and a
// callback to a new thread. For a background one-shot, spawn a worker that
// calls this itself.
@en "AfterFunc"
@fa "پس از"
@ar "بعد المدة"
pub func AfterFunc(d: Duration, fn: func ()):
    SleepFor(d)
    fn()
end

// Call `fn` every `d` until it returns false, on a drift-corrected
// cadence: the interval is measured from the scheduled tick, not from when
// `fn` happened to finish, so a slow call does not push the schedule out.
// Returns how many times `fn` was called.
@en "Every"
@fa "هر"
@ar "کل"
pub func Every(d: Duration, fn: func () bool): i64:
    mut tk := NewTicker(d)
    if !tk.active: ret 0 end
    mut n := 0 as i64
    until true:
        tk.wait()
        n += 1
        if !fn(): break end
    end
    ret n
end

// Call `fn` exactly `count` times, one every `d`, on the same
// drift-corrected cadence.
@en "RepeatEvery"
@fa "تکرار هر"
@ar "تکرار کل"
pub func RepeatEvery(d: Duration, count: int, fn: func ()):
    if count <= 0: ret end
    mut tk := NewTicker(d)
    if !tk.active: ret end
    repeat count:
        tk.wait()
        fn()
    end
end

// Poll `fn` every `poll` until it returns true or `limit` runs out.
// Returns true if the condition was met, false on timeout - the shape most
// "wait for the server to come up" loops want.
//
// `fn` is tested once before the first sleep, so a condition that is
// already true costs nothing.
@en "WaitUntil"
@fa "صبر تا"
@ar "انتظر حتى"
pub func WaitUntil(fn: func () bool, poll: Duration, limit: Duration): bool:
    mut t := NewTimer(limit)
    until true:
        if fn(): ret true end
        if t.expired(): ret false end
        rem := t.remaining()
        if poll.ns < rem.ns:
            SleepFor(poll)
        else:
            SleepFor(rem)
        end
    end
end
