package tls

@en "AesGcmSealRaw"
@fa "مهر خام ای ای اس جی سی ام"
pub func AesGcmSealRaw(
    key: void*, keylen: int, nonce: void*, aad: void*, aadlen: int, pt: void*, n: int, out: void*
): bool:
    if keylen != 16 and keylen != 32: ret false end
    mut a := _aes_init(key, keylen)
    defer _aes_free(a)
    _gcm_seal(a, nonce, aad, aadlen, pt, out, n, ((out as i64) + (n as i64)) as void*)
    ret true
end

@en "AesGcmOpenRaw"
@fa "گشودن خام ای ای اس جی سی ام"
pub func AesGcmOpenRaw(
    key: void*, keylen: int, nonce: void*, aad: void*, aadlen: int, sealed: void*, sealed_len: int, out: void*
): bool:
    if keylen != 16 and keylen != 32: ret false end
    if sealed_len < 16: ret false end
    n := sealed_len - 16
    mut a := _aes_init(key, keylen)
    defer _aes_free(a)
    ret _gcm_open(a, nonce, aad, aadlen, sealed, n, ((sealed as i64) + (n as i64)) as void*, out)
end

@en "ChaCha20Poly1305SealRaw"
@fa "مهر خام چاچا۲۰ پلی۱۳۰۵"
pub func ChaCha20Poly1305SealRaw(
    key: void*, nonce: void*, aad: void*, aadlen: int, pt: void*, n: int, out: void*
): bool:
    _cha20poly_seal(key, nonce, aad, aadlen, pt, out, n, ((out as i64) + (n as i64)) as void*)
    ret true
end

@en "ChaCha20Poly1305OpenRaw"
@fa "گشودن خام چاچا۲۰ پلی۱۳۰۵"
pub func ChaCha20Poly1305OpenRaw(
    key: void*, nonce: void*, aad: void*, aadlen: int, sealed: void*, sealed_len: int, out: void*
): bool:
    if sealed_len < 16: ret false end
    n := sealed_len - 16
    ret _cha20poly_open(key, nonce, aad, aadlen, sealed, n, ((sealed as i64) + (n as i64)) as void*, out)
end
