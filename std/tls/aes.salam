package tls

import mem

const AES_RCON := [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]

const AES_ROUND_KEY_WORDS := 8
const AES_MAX_ROUNDS := 14
const AES_BATCH := 64

const AES_M1 := 0x1111111111111111 as u64
const AES_M2 := 0x2222222222222222 as u64
const AES_M4 := 0x4444444444444444 as u64
const AES_M8 := 0x8888888888888888 as u64
const AES_H16 := 0x0000FFFF0000FFFF as u64
const AES_H8 := 0x00FF00FF00FF00FF as u64

struct Aes:
    pub sk: u64* = null
    pub ks: void* = null
    pub nr: int = 0
end

struct AesState:
    pub q0: u64 = 0 as u64
    pub q1: u64 = 0 as u64
    pub q2: u64 = 0 as u64
    pub q3: u64 = 0 as u64
    pub q4: u64 = 0 as u64
    pub q5: u64 = 0 as u64
    pub q6: u64 = 0 as u64
    pub q7: u64 = 0 as u64
end

inline func _aes_ortho(q &: AesState):
    mut t := 0 as u64
    mut v := 0 as u64
    t = q.q0
    v = q.q1
    q.q0 = (t & (0x5555555555555555 as u64)) | ((v & (0x5555555555555555 as u64)) << (1 as u64))
    q.q1 = ((t & (0xAAAAAAAAAAAAAAAA as u64)) >> (1 as u64)) | (v & (0xAAAAAAAAAAAAAAAA as u64))
    t = q.q2
    v = q.q3
    q.q2 = (t & (0x5555555555555555 as u64)) | ((v & (0x5555555555555555 as u64)) << (1 as u64))
    q.q3 = ((t & (0xAAAAAAAAAAAAAAAA as u64)) >> (1 as u64)) | (v & (0xAAAAAAAAAAAAAAAA as u64))
    t = q.q4
    v = q.q5
    q.q4 = (t & (0x5555555555555555 as u64)) | ((v & (0x5555555555555555 as u64)) << (1 as u64))
    q.q5 = ((t & (0xAAAAAAAAAAAAAAAA as u64)) >> (1 as u64)) | (v & (0xAAAAAAAAAAAAAAAA as u64))
    t = q.q6
    v = q.q7
    q.q6 = (t & (0x5555555555555555 as u64)) | ((v & (0x5555555555555555 as u64)) << (1 as u64))
    q.q7 = ((t & (0xAAAAAAAAAAAAAAAA as u64)) >> (1 as u64)) | (v & (0xAAAAAAAAAAAAAAAA as u64))
    t = q.q0
    v = q.q2
    q.q0 = (t & (0x3333333333333333 as u64)) | ((v & (0x3333333333333333 as u64)) << (2 as u64))
    q.q2 = ((t & (0xCCCCCCCCCCCCCCCC as u64)) >> (2 as u64)) | (v & (0xCCCCCCCCCCCCCCCC as u64))
    t = q.q1
    v = q.q3
    q.q1 = (t & (0x3333333333333333 as u64)) | ((v & (0x3333333333333333 as u64)) << (2 as u64))
    q.q3 = ((t & (0xCCCCCCCCCCCCCCCC as u64)) >> (2 as u64)) | (v & (0xCCCCCCCCCCCCCCCC as u64))
    t = q.q4
    v = q.q6
    q.q4 = (t & (0x3333333333333333 as u64)) | ((v & (0x3333333333333333 as u64)) << (2 as u64))
    q.q6 = ((t & (0xCCCCCCCCCCCCCCCC as u64)) >> (2 as u64)) | (v & (0xCCCCCCCCCCCCCCCC as u64))
    t = q.q5
    v = q.q7
    q.q5 = (t & (0x3333333333333333 as u64)) | ((v & (0x3333333333333333 as u64)) << (2 as u64))
    q.q7 = ((t & (0xCCCCCCCCCCCCCCCC as u64)) >> (2 as u64)) | (v & (0xCCCCCCCCCCCCCCCC as u64))
    t = q.q0
    v = q.q4
    q.q0 = (t & (0x0F0F0F0F0F0F0F0F as u64)) | ((v & (0x0F0F0F0F0F0F0F0F as u64)) << (4 as u64))
    q.q4 = ((t & (0xF0F0F0F0F0F0F0F0 as u64)) >> (4 as u64)) | (v & (0xF0F0F0F0F0F0F0F0 as u64))
    t = q.q1
    v = q.q5
    q.q1 = (t & (0x0F0F0F0F0F0F0F0F as u64)) | ((v & (0x0F0F0F0F0F0F0F0F as u64)) << (4 as u64))
    q.q5 = ((t & (0xF0F0F0F0F0F0F0F0 as u64)) >> (4 as u64)) | (v & (0xF0F0F0F0F0F0F0F0 as u64))
    t = q.q2
    v = q.q6
    q.q2 = (t & (0x0F0F0F0F0F0F0F0F as u64)) | ((v & (0x0F0F0F0F0F0F0F0F as u64)) << (4 as u64))
    q.q6 = ((t & (0xF0F0F0F0F0F0F0F0 as u64)) >> (4 as u64)) | (v & (0xF0F0F0F0F0F0F0F0 as u64))
    t = q.q3
    v = q.q7
    q.q3 = (t & (0x0F0F0F0F0F0F0F0F as u64)) | ((v & (0x0F0F0F0F0F0F0F0F as u64)) << (4 as u64))
    q.q7 = ((t & (0xF0F0F0F0F0F0F0F0 as u64)) >> (4 as u64)) | (v & (0xF0F0F0F0F0F0F0F0 as u64))
end

inline func _aes_sbox(q &: AesState):
    x0 := q.q7
    x1 := q.q6
    x2 := q.q5
    x3 := q.q4
    x4 := q.q3
    x5 := q.q2
    x6 := q.q1
    x7 := q.q0
    y14 := x3 ^ x5
    y13 := x0 ^ x6
    y9 := x0 ^ x3
    y8 := x0 ^ x5
    t0 := x1 ^ x2
    y1 := t0 ^ x7
    y4 := y1 ^ x3
    y12 := y13 ^ y14
    y2 := y1 ^ x0
    y5 := y1 ^ x6
    y3 := y5 ^ y8
    t1 := x4 ^ y12
    y15 := t1 ^ x5
    y20 := t1 ^ x1
    y6 := y15 ^ x7
    y10 := y15 ^ t0
    y11 := y20 ^ y9
    y7 := x7 ^ y11
    y17 := y10 ^ y11
    y19 := y10 ^ y8
    y16 := t0 ^ y11
    y21 := y13 ^ y16
    y18 := x0 ^ y16
    t2 := y12 & y15
    t3 := y3 & y6
    t4 := t3 ^ t2
    t5 := y4 & x7
    t6 := t5 ^ t2
    t7 := y13 & y16
    t8 := y5 & y1
    t9 := t8 ^ t7
    t10 := y2 & y7
    t11 := t10 ^ t7
    t12 := y9 & y11
    t13 := y14 & y17
    t14 := t13 ^ t12
    t15 := y8 & y10
    t16 := t15 ^ t12
    t17 := t4 ^ t14
    t18 := t6 ^ t16
    t19 := t9 ^ t14
    t20 := t11 ^ t16
    t21 := t17 ^ y20
    t22 := t18 ^ y19
    t23 := t19 ^ y21
    t24 := t20 ^ y18
    t25 := t21 ^ t22
    t26 := t21 & t23
    t27 := t24 ^ t26
    t28 := t25 & t27
    t29 := t28 ^ t22
    t30 := t23 ^ t24
    t31 := t22 ^ t26
    t32 := t31 & t30
    t33 := t32 ^ t24
    t34 := t23 ^ t33
    t35 := t27 ^ t33
    t36 := t24 & t35
    t37 := t36 ^ t34
    t38 := t27 ^ t36
    t39 := t29 & t38
    t40 := t25 ^ t39
    t41 := t40 ^ t37
    t42 := t29 ^ t33
    t43 := t29 ^ t40
    t44 := t33 ^ t37
    t45 := t42 ^ t41
    z0 := t44 & y15
    z1 := t37 & y6
    z2 := t33 & x7
    z3 := t43 & y16
    z4 := t40 & y1
    z5 := t29 & y7
    z6 := t42 & y11
    z7 := t45 & y17
    z8 := t41 & y10
    z9 := t44 & y12
    z10 := t37 & y3
    z11 := t33 & y4
    z12 := t43 & y13
    z13 := t40 & y5
    z14 := t29 & y2
    z15 := t42 & y9
    z16 := t45 & y14
    z17 := t41 & y8
    t46 := z15 ^ z16
    t47 := z10 ^ z11
    t48 := z5 ^ z13
    t49 := z9 ^ z10
    t50 := z2 ^ z12
    t51 := z2 ^ z5
    t52 := z7 ^ z8
    t53 := z0 ^ z3
    t54 := z6 ^ z7
    t55 := z16 ^ z17
    t56 := z12 ^ t48
    t57 := t50 ^ t53
    t58 := z4 ^ t46
    t59 := z3 ^ t54
    t60 := t46 ^ t57
    t61 := z14 ^ t57
    t62 := t52 ^ t58
    t63 := t49 ^ t58
    t64 := z4 ^ t59
    t65 := t61 ^ t62
    t66 := z1 ^ t63
    s0 := t59 ^ t63
    s6 := t56 ^ ~t62
    s7 := t48 ^ ~t60
    t67 := t64 ^ t65
    s3 := t53 ^ t66
    s4 := t51 ^ t66
    s5 := t47 ^ t65
    s1 := t64 ^ ~s3
    s2 := t55 ^ ~t67
    q.q7 = s0
    q.q6 = s1
    q.q5 = s2
    q.q4 = s3
    q.q3 = s4
    q.q2 = s5
    q.q1 = s6
    q.q0 = s7
end

inline func _aes_shift_row(x: u64): u64:
    ret (x & (0x000000000000FFFF as u64)) | ((x & (0x00000000FFF00000 as u64)) >> (4 as u64)) | ((x & (0x00000000000F0000 as u64)) << (12 as u64)) | ((x & (0x0000FF0000000000 as u64)) >> (8 as u64)) | ((x & (0x000000FF00000000 as u64)) << (8 as u64)) | ((x & (0xF000000000000000 as u64)) >> (12 as u64)) | ((x & (0x0FFF000000000000 as u64)) << (4 as u64))
end

inline func _aes_shift_rows(q &: AesState):
    q.q0 = _aes_shift_row(q.q0)
    q.q1 = _aes_shift_row(q.q1)
    q.q2 = _aes_shift_row(q.q2)
    q.q3 = _aes_shift_row(q.q3)
    q.q4 = _aes_shift_row(q.q4)
    q.q5 = _aes_shift_row(q.q5)
    q.q6 = _aes_shift_row(q.q6)
    q.q7 = _aes_shift_row(q.q7)
end

inline func _aes_rotr16(x: u64): u64:
    ret (x >> (16 as u64)) | (x << (48 as u64))
end

inline func _aes_rotr32(x: u64): u64:
    ret (x << (32 as u64)) | (x >> (32 as u64))
end

inline func _aes_mix_columns(q &: AesState):
    a0 := q.q0
    a1 := q.q1
    a2 := q.q2
    a3 := q.q3
    a4 := q.q4
    a5 := q.q5
    a6 := q.q6
    a7 := q.q7
    r0 := _aes_rotr16(a0)
    r1 := _aes_rotr16(a1)
    r2 := _aes_rotr16(a2)
    r3 := _aes_rotr16(a3)
    r4 := _aes_rotr16(a4)
    r5 := _aes_rotr16(a5)
    r6 := _aes_rotr16(a6)
    r7 := _aes_rotr16(a7)
    q.q0 = a7 ^ r7 ^ r0 ^ _aes_rotr32(a0 ^ r0)
    q.q1 = a0 ^ r0 ^ a7 ^ r7 ^ r1 ^ _aes_rotr32(a1 ^ r1)
    q.q2 = a1 ^ r1 ^ r2 ^ _aes_rotr32(a2 ^ r2)
    q.q3 = a2 ^ r2 ^ a7 ^ r7 ^ r3 ^ _aes_rotr32(a3 ^ r3)
    q.q4 = a3 ^ r3 ^ a7 ^ r7 ^ r4 ^ _aes_rotr32(a4 ^ r4)
    q.q5 = a4 ^ r4 ^ r5 ^ _aes_rotr32(a5 ^ r5)
    q.q6 = a5 ^ r5 ^ r6 ^ _aes_rotr32(a6 ^ r6)
    q.q7 = a6 ^ r6 ^ r7 ^ _aes_rotr32(a7 ^ r7)
end

inline func _aes_add_key(q &: AesState, sk: u64*, off: int):
    q.q0 ^= sk[off + 0]
    q.q1 ^= sk[off + 1]
    q.q2 ^= sk[off + 2]
    q.q3 ^= sk[off + 3]
    q.q4 ^= sk[off + 4]
    q.q5 ^= sk[off + 5]
    q.q6 ^= sk[off + 6]
    q.q7 ^= sk[off + 7]
end

inline func _aes_il_word(x: u32): u64:
    a := (x as u64)
    b := (a | (a << (16 as u64))) & AES_H16
    ret (b | (b << (8 as u64))) & AES_H8
end

inline func _aes_il_low(w0: u32, w2: u32): u64:
    ret _aes_il_word(w0) | (_aes_il_word(w2) << (8 as u64))
end

inline func _aes_ol_word(q: u64): u32:
    a := (q | (q >> (8 as u64))) & AES_H16
    ret (a as u32) | ((a >> (16 as u64)) as u32)
end

func _aes_encrypt4(a: Aes, q &: AesState):
    sk := a.sk
    nr := a.nr
    _aes_ortho(q)
    _aes_add_key(q, sk, 0)
    mut u := 1
    until u < nr:
        _aes_sbox(q)
        _aes_shift_rows(q)
        _aes_mix_columns(q)
        _aes_add_key(q, sk, u * AES_ROUND_KEY_WORDS)
        u++
    end
    _aes_sbox(q)
    _aes_shift_rows(q)
    _aes_add_key(q, sk, nr * AES_ROUND_KEY_WORDS)
    _aes_ortho(q)
end

func _aes_sub_word(x: u32): u32:
    mut q := AesState {}
    q.q0 = x as u64
    _aes_ortho(q)
    _aes_sbox(q)
    _aes_ortho(q)
    ret q.q0 as u32
end

func _aes_init(key: void*, keylen: int): Aes:
    mut a := Aes {}
    mut nk := 0
    if keylen == 16:
        nk = 4
        a.nr = 10
    else keylen == 32:
        nk = 8
        a.nr = 14
    else:
        ret a
    end
    nkf := (a.nr + 1) * 4
    a.sk = mem.Allocate((((a.nr + 1) * AES_ROUND_KEY_WORDS) * 8 + AES_BATCH) as u64) as u64*
    a.ks = ((a.sk as i64) + (((a.nr + 1) * AES_ROUND_KEY_WORDS) * 8) as i64) as void*
    mut w: u32[60]
    repeat nk in i:
        w[i] = _le32(key, i * 4)
    end
    mut tmp := w[nk - 1]
    mut i := nk
    mut j := 0
    mut k := 0
    until i < nkf:
        if j == 0:
            tmp = (tmp << (24 as u32)) | (tmp >> (8 as u32))
            tmp = _aes_sub_word(tmp) ^ (AES_RCON[k] as u32)
        else nk > 6 and j == 4:
            tmp = _aes_sub_word(tmp)
        end
        tmp ^= w[i - nk]
        w[i] = tmp
        j++
        if j == nk:
            j = 0
            k++
        end
        i++
    end
    mut r := 0
    until r <= a.nr:
        o := r * 4
        mut q := AesState {}
        q.q0 = _aes_il_low(w[o], w[o + 2])
        q.q4 = _aes_il_low(w[o + 1], w[o + 3])
        q.q1 = q.q0
        q.q2 = q.q0
        q.q3 = q.q0
        q.q5 = q.q4
        q.q6 = q.q4
        q.q7 = q.q4
        _aes_ortho(q)
        c0 := (q.q0 & AES_M1) | (q.q1 & AES_M2) | (q.q2 & AES_M4) | (q.q3 & AES_M8)
        c1 := (q.q4 & AES_M1) | (q.q5 & AES_M2) | (q.q6 & AES_M4) | (q.q7 & AES_M8)
        _aes_expand_key(a.sk, r * AES_ROUND_KEY_WORDS, c0)
        _aes_expand_key(a.sk, r * AES_ROUND_KEY_WORDS + 4, c1)
        r++
    end
    repeat 60 in z:
        w[z] = 0 as u32
    end
    ret a
end

func _aes_expand_key(sk: u64*, off: int, c: u64):
    x0 := c & AES_M1
    x1 := (c & AES_M2) >> (1 as u64)
    x2 := (c & AES_M4) >> (2 as u64)
    x3 := (c & AES_M8) >> (3 as u64)
    sk[off] = (x0 << (4 as u64)) - x0
    sk[off + 1] = (x1 << (4 as u64)) - x1
    sk[off + 2] = (x2 << (4 as u64)) - x2
    sk[off + 3] = (x3 << (4 as u64)) - x3
end

func _aes_free(a &: Aes):
    if a.sk != null:
        _wipe(a.sk as void*, (a.nr + 1) * AES_ROUND_KEY_WORDS * 8 + AES_BATCH)
        mem.Free(a.sk as void*)
    end
    a.sk = null
    a.ks = null
    a.nr = 0
end

inline func _aes_load4(q &: AesState, w0: u32, w1: u32, w2: u32, c0: u32, c1: u32, c2: u32, c3: u32):
    lo := _aes_il_word(w0)
    mid := _aes_il_word(w1)
    hi := _aes_il_word(w2) << (8 as u64)
    q.q0 = lo | hi
    q.q1 = lo | hi
    q.q2 = lo | hi
    q.q3 = lo | hi
    q.q4 = mid | (_aes_il_word(c0) << (8 as u64))
    q.q5 = mid | (_aes_il_word(c1) << (8 as u64))
    q.q6 = mid | (_aes_il_word(c2) << (8 as u64))
    q.q7 = mid | (_aes_il_word(c3) << (8 as u64))
end

inline func _aes_store_block(q0: u64, q1: u64, out: void*, o: int):
    _ple32(_aes_ol_word(q0 & AES_H8), out, o)
    _ple32(_aes_ol_word(q1 & AES_H8), out, o + 4)
    _ple32(_aes_ol_word((q0 >> (8 as u64)) & AES_H8), out, o + 8)
    _ple32(_aes_ol_word((q1 >> (8 as u64)) & AES_H8), out, o + 12)
end

func _aes_ctr_batch(a: Aes, nonce: void*, ctr: u32):
    mut q := AesState {}
    _aes_load4(q, _le32(nonce, 0), _le32(nonce, 4), _le32(nonce, 8), _bswap32(ctr), _bswap32(ctr + (1 as u32)), _bswap32(ctr + (2 as u32)), _bswap32(ctr + (3 as u32)))
    _aes_encrypt4(a, q)
    _aes_store_block(q.q0, q.q4, a.ks, 0)
    _aes_store_block(q.q1, q.q5, a.ks, 16)
    _aes_store_block(q.q2, q.q6, a.ks, 32)
    _aes_store_block(q.q3, q.q7, a.ks, 48)
end

inline func _bswap32(x: u32): u32:
    ret (x << (24 as u32)) | ((x & (0xFF00 as u32)) << (8 as u32)) | ((x >> (8 as u32)) & (0xFF00 as u32)) | (x >> (24 as u32))
end

func _aes_encrypt_block(a: Aes, inp: void*, out: void*):
    mut q := AesState {}
    q.q0 = _aes_il_low(_le32(inp, 0), _le32(inp, 8))
    q.q4 = _aes_il_low(_le32(inp, 4), _le32(inp, 12))
    _aes_encrypt4(a, q)
    _aes_store_block(q.q0, q.q4, out, 0)
end
