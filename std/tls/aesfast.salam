    0x6161a3c2 as u32, 0x35355f6a as u32, 0x5757f9ae as u32, 0xb9b9d069 as u32, 0x86869117 as u32, 0xc1c15899 as u32, 0x1d1d273a as u32, 0x9e9eb927 as u32,
    0xe1e138d9 as u32, 0xf8f813eb as u32, 0x9898b32b as u32, 0x11113322 as u32, 0x6969bbd2 as u32, 0xd9d970a9 as u32, 0x8e8e8907 as u32, 0x9494a733 as u32,
    0x9b9bb62d as u32, 0x1e1e223c as u32, 0x87879215 as u32, 0xe9e920c9 as u32, 0xcece4987 as u32, 0x5555ffaa as u32, 0x28287850 as u32, 0xdfdf7aa5 as u32,
    0x8c8c8f03 as u32, 0xa1a1f859 as u32, 0x89898009 as u32, 0x0d0d171a as u32, 0xbfbfda65 as u32, 0xe6e631d7 as u32, 0x4242c684 as u32, 0x6868b8d0 as u32,
    0x4141c382 as u32, 0x9999b029 as u32, 0x2d2d775a as u32, 0x0f0f111e as u32, 0xb0b0cb7b as u32, 0x5454fca8 as u32, 0xbbbbd66d as u32, 0x16163a2c as u32
]

struct FastGcm:
    pub rk: u32* = null
    pub ht: u64* = null
    pub nr: int = 0
end

struct FgY:
    pub hi: u64 = 0 as u64
    pub lo: u64 = 0 as u64
end


inline func _fg_sub(x: u32): u32:
    ret ((FG_SBOX[((x >> (24 as u32)) & (255 as u32)) as int] as u32) << (24 as u32)) | ((FG_SBOX[((x >> (16 as u32)) & (255 as u32)) as int] as u32) << (16 as u32)) | ((FG_SBOX[((x >> (8 as u32)) & (255 as u32)) as int] as u32) << (8 as u32)) | (FG_SBOX[(x & (255 as u32)) as int] as u32)
end

inline func _fg_be32(p: void*, o: int): u32:
    bp := p as u8*
    ret ((bp[o] as u32) << (24 as u32)) | ((bp[o + 1] as u32) << (16 as u32)) | ((bp[o + 2] as u32) << (8 as u32)) | (bp[o + 3] as u32)
end

inline func _fg_pbe32(v: u32, p: void*, o: int):
    bp := p as u8*
    bp[o] = (v >> (24 as u32)) as u8
    bp[o + 1] = (v >> (16 as u32)) as u8
    bp[o + 2] = (v >> (8 as u32)) as u8
    bp[o + 3] = v as u8
end

inline func _fg_step(ht: u64*, z &: FgY, b: u64):
    rem := (z.lo & (255 as u64)) as int
    z.lo = (z.hi << (56 as u64)) | (z.lo >> (8 as u64))
    z.hi = (z.hi >> (8 as u64)) ^ FG_REM[rem]
    i := (b as int) * 2
    z.hi ^= ht[i]
    z.lo ^= ht[i + 1]
end

inline func _fg_word(ht: u64*, z &: FgY, x: u64):
    mut w := x
    repeat 8:
        _fg_step(ht, z, w & (255 as u64))
        w >>= (8 as u64)
    end
end

inline func _fg_mix(ht: u64*, y &: FgY, bhi: u64, blo: u64):
    mut z := FgY {}
    _fg_word(ht, z, y.lo ^ blo)
    _fg_word(ht, z, y.hi ^ bhi)
    y.hi = z.hi
    y.lo = z.lo
end

func _fg_ghash(ht: u64*, y &: FgY, p: void*, n: int):
    mut off := 0
    until n - off >= 16:
        _fg_mix(ht, y, _be64(p, off), _be64(p, off + 8))
        off += 16
    end
    if off < n:
        bp := p as u8*
        mut w1 := 0 as u64
        mut w0 := 0 as u64
        repeat n - off in i:
            if i < 8:
                w1 |= ((bp[off + i] as u64) << ((56 - i * 8) as u64))
            else:
                w0 |= ((bp[off + i] as u64) << ((120 - i * 8) as u64))
            end
        end
        _fg_mix(ht, y, w1, w0)
    end
end

func _fg_block(c: FastGcm*, s0i: u32, s1i: u32, s2i: u32, s3i: u32, out: void*, o: int):
    rk := c.rk
    mut s0 := s0i ^ rk[0]
    mut s1 := s1i ^ rk[1]
    mut s2 := s2i ^ rk[2]
    mut s3 := s3i ^ rk[3]
    mut r := 1
    until r < c.nr:
        k := r * 4
        t0 := FG_TE0[(s0 >> (24 as u32)) as int] ^ FG_TE1[((s1 >> (16 as u32)) & (255 as u32)) as int] ^ FG_TE2[((s2 >> (8 as u32)) & (255 as u32)) as int] ^ FG_TE3[(s3 & (255 as u32)) as int] ^ rk[k]
        t1 := FG_TE0[(s1 >> (24 as u32)) as int] ^ FG_TE1[((s2 >> (16 as u32)) & (255 as u32)) as int] ^ FG_TE2[((s3 >> (8 as u32)) & (255 as u32)) as int] ^ FG_TE3[(s0 & (255 as u32)) as int] ^ rk[k + 1]
        t2 := FG_TE0[(s2 >> (24 as u32)) as int] ^ FG_TE1[((s3 >> (16 as u32)) & (255 as u32)) as int] ^ FG_TE2[((s0 >> (8 as u32)) & (255 as u32)) as int] ^ FG_TE3[(s1 & (255 as u32)) as int] ^ rk[k + 2]
        t3 := FG_TE0[(s3 >> (24 as u32)) as int] ^ FG_TE1[((s0 >> (16 as u32)) & (255 as u32)) as int] ^ FG_TE2[((s1 >> (8 as u32)) & (255 as u32)) as int] ^ FG_TE3[(s2 & (255 as u32)) as int] ^ rk[k + 3]
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
        r++
    end
    k := c.nr * 4
    _fg_pbe32(_fg_sub4(s0, s1, s2, s3) ^ rk[k], out, o)
    _fg_pbe32(_fg_sub4(s1, s2, s3, s0) ^ rk[k + 1], out, o + 4)
    _fg_pbe32(_fg_sub4(s2, s3, s0, s1) ^ rk[k + 2], out, o + 8)
    _fg_pbe32(_fg_sub4(s3, s0, s1, s2) ^ rk[k + 3], out, o + 12)
end

inline func _fg_sub4(a: u32, b: u32, c: u32, d: u32): u32:
    ret ((FG_SBOX[(a >> (24 as u32)) as int] as u32) << (24 as u32)) | ((FG_SBOX[((b >> (16 as u32)) & (255 as u32)) as int] as u32) << (16 as u32)) | ((FG_SBOX[((c >> (8 as u32)) & (255 as u32)) as int] as u32) << (8 as u32)) | (FG_SBOX[(d & (255 as u32)) as int] as u32)
end

func _fg_new(key: void*, keylen: int): FastGcm*:
    if keylen != 16 and keylen != 32:
        ret null
    end
    c := mem.AllocateZeroed(sizeof(FastGcm) as u64) as FastGcm*
    c.nr = keylen == 16 ? 10 : 14
    nk := keylen / 4
    total := (c.nr + 1) * 4
    mem_ := mem.AllocateZeroed(4352 as u64)
    c.rk = mem_ as u32*
    c.ht = ((mem_ as i64) + (256 as i64)) as u64*
    rk := c.rk
    repeat nk in i:
        rk[i] = _fg_be32(key, i * 4)
    end
    mut i := nk
    until i < total:
        mut t := rk[i - 1]
        if i % nk == 0:
            t = _fg_sub((t << (8 as u32)) | (t >> (24 as u32))) ^ ((FG_RCON[i / nk - 1] as u32) << (24 as u32))
        else nk > 6 and i % nk == 4:
            t = _fg_sub(t)
        end
        rk[i] = rk[i - nk] ^ t
        i++
    end
    hb := mem.AllocateZeroed(16 as u64)
    _fg_block(c, 0 as u32, 0 as u32, 0 as u32, 0 as u32, hb, 0)
    mut vh := _be64(hb, 0)
    mut vl := _be64(hb, 8)
    mem.Free(hb)
    ht := c.ht
    ht[256] = vh
    ht[257] = vl
    mut k := 64
    until k > 0:
        t := (vl & (1 as u64)) * (0xE100000000000000 as u64)
        vl = (vh << (63 as u64)) | (vl >> (1 as u64))
        vh = (vh >> (1 as u64)) ^ t
        ht[k * 2] = vh
        ht[k * 2 + 1] = vl
        k >>= 1
    end
    mut a := 2
    until a < 256:
        repeat a - 1 in j:
            b := j + 1
            ht[(a + b) * 2] = ht[a * 2] ^ ht[b * 2]
            ht[(a + b) * 2 + 1] = ht[a * 2 + 1] ^ ht[b * 2 + 1]
        end
        a <<= 1
    end
    ret c
end

func _fg_free(c: FastGcm*):
    if c == null:
        ret
    end
    _wipe(c.rk as void*, 4352)
    mem.Free(c.rk as void*)
    _wipe(c as void*, sizeof(FastGcm) as int)
    mem.Free(c as void*)
end

func _fg_ctr(c: FastGcm*, nonce: void*, first: int, inp: void*, out: void*, n: int):
    n0 := _fg_be32(nonce, 0)
    n1 := _fg_be32(nonce, 4)
    n2 := _fg_be32(nonce, 8)
    mut ctr := first as u32
    ks := mem.AllocateZeroed(16 as u64)
    mut off := 0
    until off < n:
        _fg_block(c, n0, n1, n2, ctr, ks, 0)
        ctr++
        left := n - off
        if left >= 16:
            ip := ((inp as i64) + (off as i64)) as void*
            op := ((out as i64) + (off as i64)) as void*
            _ple64(_le64(ip, 0) ^ _le64(ks, 0), op, 0)
            _ple64(_le64(ip, 8) ^ _le64(ks, 8), op, 8)
            off += 16
        else:
            ib := inp as u8*
            kb := ks as u8*
            ob := out as u8*
            repeat left in j:
                ob[off + j] = ib[off + j] ^ (kb[j])
            end
            off += left
        end
    end
    _wipe(ks, 16)
    mem.Free(ks)
end

func _fg_tag(c: FastGcm*, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, mask &: FgY):
    mut y := FgY {}
    if aadlen > 0:
        _fg_ghash(c.ht, y, aad, aadlen)
    end
    if n > 0:
        _fg_ghash(c.ht, y, ct, n)
    end
    _fg_mix(c.ht, y, (aadlen as u64) * (8 as u64), (n as u64) * (8 as u64))
    m := mem.AllocateZeroed(16 as u64)
    _fg_block(c, _fg_be32(nonce, 0), _fg_be32(nonce, 4), _fg_be32(nonce, 8), 1 as u32, m, 0)
    mask.hi = y.hi ^ _be64(m, 0)
    mask.lo = y.lo ^ _be64(m, 8)
    mem.Free(m)
end

func _fg_seal(c: FastGcm*, nonce: void*, aad: void*, aadlen: int, pt: void*, ct: void*, n: int, tag: void*):
    _fg_ctr(c, nonce, 2, pt, ct, n)
    mut t := FgY {}
    _fg_tag(c, nonce, aad, aadlen, ct, n, t)
    _pbe64(t.hi, tag, 0)
    _pbe64(t.lo, tag, 8)
end

func _fg_open(c: FastGcm*, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, tag: void*, pt: void*): bool:
    mut t := FgY {}
    _fg_tag(c, nonce, aad, aadlen, ct, n, t)
    d1 := t.hi ^ _be64(tag, 0)
    d0 := t.lo ^ _be64(tag, 8)
    if (d1 | d0) != (0 as u64):
        ret false
    end
    _fg_ctr(c, nonce, 2, ct, pt, n)
    ret true
end
