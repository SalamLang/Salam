package tls

import mem
import cpu

struct HwGcm:
    pub rk: void* = null
    pub hp: void* = null
    pub nr: int = 0
end

inline func _hg_at(p: void*, off: int): void*:
    ret ((p as i64) + (off as i64)) as void*
end

inline func _hg_red(l: u128): u128:
    o := (l & (127 as u128)) ^ ((l & (3 as u128)) << (5 as u128)) ^ ((l & (1 as u128)) << (6 as u128))
    ret l ^ (l >> (1 as u128)) ^ (l >> (2 as u128)) ^ (l >> (7 as u128)) ^ (o << (121 as u128)) ^ (o << (120 as u128)) ^ (o << (119 as u128)) ^ (o << (114 as u128))
end

inline func _hg_fold(lo: u128, mid: u128, hi: u128): u128:
    rlo := lo ^ (mid << (64 as u128))
    rhi := hi ^ (mid >> (64 as u128))
    shi := (rhi << (1 as u128)) | (rlo >> (127 as u128))
    slo := rlo << (1 as u128)
    ret shi ^ _hg_red(slo)
end

inline func _hg_mul(a: u128, b: u128): u128:
    lo := cpu.HwClmul(a, b, 0)
    hi := cpu.HwClmul(a, b, 17)
    mid := cpu.HwClmul(a, b, 1) ^ cpu.HwClmul(a, b, 16)
    ret _hg_fold(lo, mid, hi)
end

inline func _hg_cb(nlo: u64, nhi: u64, ctr: u32): u128:
    be := ((ctr & (255 as u32)) << (24 as u32)) | ((ctr & (65280 as u32)) << (8 as u32)) | ((ctr >> (8 as u32)) & (65280 as u32)) | (ctr >> (24 as u32))
    hi := nhi | ((be as u64) << (32 as u64))
    ret ((hi as u128) << (64 as u128)) | (nlo as u128)
end

func _hg_enc1(c: HwGcm*, x: u128): u128:
    rk := c.rk
    mut b := x ^ cpu.HwLoad(rk)
    mut r := 1
    until r < c.nr:
        b = cpu.HwAesEnc(b, cpu.HwLoad(_hg_at(rk, r * 16)))
        r++
    end
    ret cpu.HwAesEncLast(b, cpu.HwLoad(_hg_at(rk, c.nr * 16)))
end

func _hg_ctr(c: HwGcm*, nonce: void*, first: u32, inp: void*, out: void*, n: int):
    rk := c.rk
    nr := c.nr
    nlo := _le64(nonce, 0)
    nhi := _le32(nonce, 8) as u64
    mut ctr := first
    mut off := 0
    until n - off >= 128:
        k0 := cpu.HwLoad(rk)
        mut b0 := _hg_cb(nlo, nhi, ctr) ^ k0
        mut b1 := _hg_cb(nlo, nhi, ctr + (1 as u32)) ^ k0
        mut b2 := _hg_cb(nlo, nhi, ctr + (2 as u32)) ^ k0
        mut b3 := _hg_cb(nlo, nhi, ctr + (3 as u32)) ^ k0
        mut b4 := _hg_cb(nlo, nhi, ctr + (4 as u32)) ^ k0
        mut b5 := _hg_cb(nlo, nhi, ctr + (5 as u32)) ^ k0
        mut b6 := _hg_cb(nlo, nhi, ctr + (6 as u32)) ^ k0
        mut b7 := _hg_cb(nlo, nhi, ctr + (7 as u32)) ^ k0
        mut r := 1
        until r < nr:
            kr := cpu.HwLoad(_hg_at(rk, r * 16))
            b0 = cpu.HwAesEnc(b0, kr)
            b1 = cpu.HwAesEnc(b1, kr)
            b2 = cpu.HwAesEnc(b2, kr)
            b3 = cpu.HwAesEnc(b3, kr)
            b4 = cpu.HwAesEnc(b4, kr)
            b5 = cpu.HwAesEnc(b5, kr)
            b6 = cpu.HwAesEnc(b6, kr)
            b7 = cpu.HwAesEnc(b7, kr)
            r++
        end
        kl := cpu.HwLoad(_hg_at(rk, nr * 16))
        b0 = cpu.HwAesEncLast(b0, kl)
        b1 = cpu.HwAesEncLast(b1, kl)
        b2 = cpu.HwAesEncLast(b2, kl)
        b3 = cpu.HwAesEncLast(b3, kl)
        b4 = cpu.HwAesEncLast(b4, kl)
        b5 = cpu.HwAesEncLast(b5, kl)
        b6 = cpu.HwAesEncLast(b6, kl)
        b7 = cpu.HwAesEncLast(b7, kl)
        cpu.HwStore(_hg_at(out, off + 0), cpu.HwLoad(_hg_at(inp, off + 0)) ^ b0)
        cpu.HwStore(_hg_at(out, off + 16), cpu.HwLoad(_hg_at(inp, off + 16)) ^ b1)
        cpu.HwStore(_hg_at(out, off + 32), cpu.HwLoad(_hg_at(inp, off + 32)) ^ b2)
        cpu.HwStore(_hg_at(out, off + 48), cpu.HwLoad(_hg_at(inp, off + 48)) ^ b3)
        cpu.HwStore(_hg_at(out, off + 64), cpu.HwLoad(_hg_at(inp, off + 64)) ^ b4)
        cpu.HwStore(_hg_at(out, off + 80), cpu.HwLoad(_hg_at(inp, off + 80)) ^ b5)
        cpu.HwStore(_hg_at(out, off + 96), cpu.HwLoad(_hg_at(inp, off + 96)) ^ b6)
        cpu.HwStore(_hg_at(out, off + 112), cpu.HwLoad(_hg_at(inp, off + 112)) ^ b7)
        ctr += 8 as u32
        off += 128
    end
    until n - off >= 64:
        k0 := cpu.HwLoad(rk)
        mut b0 := _hg_cb(nlo, nhi, ctr) ^ k0
        mut b1 := _hg_cb(nlo, nhi, ctr + (1 as u32)) ^ k0
        mut b2 := _hg_cb(nlo, nhi, ctr + (2 as u32)) ^ k0
        mut b3 := _hg_cb(nlo, nhi, ctr + (3 as u32)) ^ k0
        mut r := 1
        until r < nr:
            kr := cpu.HwLoad(_hg_at(rk, r * 16))
            b0 = cpu.HwAesEnc(b0, kr)
            b1 = cpu.HwAesEnc(b1, kr)
            b2 = cpu.HwAesEnc(b2, kr)
            b3 = cpu.HwAesEnc(b3, kr)
            r++
        end
        kl := cpu.HwLoad(_hg_at(rk, nr * 16))
        b0 = cpu.HwAesEncLast(b0, kl)
        b1 = cpu.HwAesEncLast(b1, kl)
        b2 = cpu.HwAesEncLast(b2, kl)
        b3 = cpu.HwAesEncLast(b3, kl)
        cpu.HwStore(_hg_at(out, off + 0), cpu.HwLoad(_hg_at(inp, off + 0)) ^ b0)
        cpu.HwStore(_hg_at(out, off + 16), cpu.HwLoad(_hg_at(inp, off + 16)) ^ b1)
        cpu.HwStore(_hg_at(out, off + 32), cpu.HwLoad(_hg_at(inp, off + 32)) ^ b2)
        cpu.HwStore(_hg_at(out, off + 48), cpu.HwLoad(_hg_at(inp, off + 48)) ^ b3)
        ctr += 4 as u32
        off += 64
    end
    until n - off >= 16:
        k0 := cpu.HwLoad(rk)
        mut b0 := _hg_cb(nlo, nhi, ctr) ^ k0
        mut r := 1
        until r < nr:
            kr := cpu.HwLoad(_hg_at(rk, r * 16))
            b0 = cpu.HwAesEnc(b0, kr)
            r++
        end
        kl := cpu.HwLoad(_hg_at(rk, nr * 16))
        b0 = cpu.HwAesEncLast(b0, kl)
        cpu.HwStore(_hg_at(out, off + 0), cpu.HwLoad(_hg_at(inp, off + 0)) ^ b0)
        ctr++
        off += 16
    end
    if off < n:
        ks := _hg_enc1(c, _hg_cb(nlo, nhi, ctr))
        t := mem.AllocateZeroed(16 as u64)
        cpu.HwStore(t, ks)
        tb := t as u8*
        ib := inp as u8*
        ob := out as u8*
        repeat n - off in j:
            ob[off + j] = ib[off + j] ^ tb[j]
        end
        _wipe(t, 16)
        mem.Free(t)
    end
end

func _hg_ghash(c: HwGcm*, y0: u128, p: void*, n: int): u128:
    hp := c.hp
    mut y := y0
    mut off := 0
    until n - off >= 128:
        x0 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 0))) ^ y
        h0 := cpu.HwLoad(_hg_at(hp, 0))
        x1 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 16)))
        h1 := cpu.HwLoad(_hg_at(hp, 16))
        x2 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 32)))
        h2 := cpu.HwLoad(_hg_at(hp, 32))
        x3 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 48)))
        h3 := cpu.HwLoad(_hg_at(hp, 48))
        x4 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 64)))
        h4 := cpu.HwLoad(_hg_at(hp, 64))
        x5 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 80)))
        h5 := cpu.HwLoad(_hg_at(hp, 80))
        x6 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 96)))
        h6 := cpu.HwLoad(_hg_at(hp, 96))
        x7 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 112)))
        h7 := cpu.HwLoad(_hg_at(hp, 112))
        mut lo := cpu.HwClmul(x0, h0, 0)
        mut hi := cpu.HwClmul(x0, h0, 17)
        mut mid := cpu.HwClmul(x0, h0, 1) ^ cpu.HwClmul(x0, h0, 16)
        lo ^= cpu.HwClmul(x1, h1, 0)
        hi ^= cpu.HwClmul(x1, h1, 17)
        mid ^= cpu.HwClmul(x1, h1, 1) ^ cpu.HwClmul(x1, h1, 16)
        lo ^= cpu.HwClmul(x2, h2, 0)
        hi ^= cpu.HwClmul(x2, h2, 17)
        mid ^= cpu.HwClmul(x2, h2, 1) ^ cpu.HwClmul(x2, h2, 16)
        lo ^= cpu.HwClmul(x3, h3, 0)
        hi ^= cpu.HwClmul(x3, h3, 17)
        mid ^= cpu.HwClmul(x3, h3, 1) ^ cpu.HwClmul(x3, h3, 16)
        lo ^= cpu.HwClmul(x4, h4, 0)
        hi ^= cpu.HwClmul(x4, h4, 17)
        mid ^= cpu.HwClmul(x4, h4, 1) ^ cpu.HwClmul(x4, h4, 16)
        lo ^= cpu.HwClmul(x5, h5, 0)
        hi ^= cpu.HwClmul(x5, h5, 17)
        mid ^= cpu.HwClmul(x5, h5, 1) ^ cpu.HwClmul(x5, h5, 16)
        lo ^= cpu.HwClmul(x6, h6, 0)
        hi ^= cpu.HwClmul(x6, h6, 17)
        mid ^= cpu.HwClmul(x6, h6, 1) ^ cpu.HwClmul(x6, h6, 16)
        lo ^= cpu.HwClmul(x7, h7, 0)
        hi ^= cpu.HwClmul(x7, h7, 17)
        mid ^= cpu.HwClmul(x7, h7, 1) ^ cpu.HwClmul(x7, h7, 16)
        y = _hg_fold(lo, mid, hi)
        off += 128
    end
    until n - off >= 64:
        x0 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 0))) ^ y
        h0 := cpu.HwLoad(_hg_at(hp, 64))
        x1 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 16)))
        h1 := cpu.HwLoad(_hg_at(hp, 80))
        x2 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 32)))
        h2 := cpu.HwLoad(_hg_at(hp, 96))
        x3 := cpu.HwBswap(cpu.HwLoad(_hg_at(p, off + 48)))
        h3 := cpu.HwLoad(_hg_at(hp, 112))
        mut lo := cpu.HwClmul(x0, h0, 0)
        mut hi := cpu.HwClmul(x0, h0, 17)
        mut mid := cpu.HwClmul(x0, h0, 1) ^ cpu.HwClmul(x0, h0, 16)
        lo ^= cpu.HwClmul(x1, h1, 0)
        hi ^= cpu.HwClmul(x1, h1, 17)
        mid ^= cpu.HwClmul(x1, h1, 1) ^ cpu.HwClmul(x1, h1, 16)
        lo ^= cpu.HwClmul(x2, h2, 0)
        hi ^= cpu.HwClmul(x2, h2, 17)
        mid ^= cpu.HwClmul(x2, h2, 1) ^ cpu.HwClmul(x2, h2, 16)
        lo ^= cpu.HwClmul(x3, h3, 0)
        hi ^= cpu.HwClmul(x3, h3, 17)
        mid ^= cpu.HwClmul(x3, h3, 1) ^ cpu.HwClmul(x3, h3, 16)
        y = _hg_fold(lo, mid, hi)
        off += 64
    end
    h1 := cpu.HwLoad(_hg_at(hp, 112))
    until n - off >= 16:
        y = _hg_mul(cpu.HwBswap(cpu.HwLoad(_hg_at(p, off))) ^ y, h1)
        off += 16
    end
    if off < n:
        t := mem.AllocateZeroed(16 as u64)
        mem.Copy(t, _hg_at(p, off), (n - off) as u64)
        y = _hg_mul(cpu.HwBswap(cpu.HwLoad(t)) ^ y, h1)
        mem.Free(t)
    end
    ret y
end

func _hg_new(key: void*, keylen: int): HwGcm*:
    if keylen != 16 and keylen != 24 and keylen != 32:
        ret null
    end
    c := mem.AllocateZeroed(sizeof(HwGcm) as u64) as HwGcm*
    base := mem.AllocateZeroed(512 as u64)
    c.rk = base
    c.hp = _hg_at(base, 256)
    c.nr = keylen / 4 + 6
    w := mem.AllocateZeroed(256 as u64) as u32*
    _fg_expand(key, keylen, w)
    repeat (c.nr + 1) * 4 in i:
        _fg_pbe32(w[i], c.rk, i * 4)
    end
    _wipe(w as void*, 256)
    mem.Free(w as void*)
    h1 := cpu.HwBswap(_hg_enc1(c, 0 as u128))
    mut pw := h1
    cpu.HwStore(_hg_at(c.hp, 112), pw)
    repeat 7 in i:
        pw = _hg_mul(pw, h1)
        cpu.HwStore(_hg_at(c.hp, (6 - i) * 16), pw)
    end
    ret c
end

func _hg_try(key: void*, keylen: int): HwGcm*:
    if not cpu.HasHardwareCrypto():
        ret null
    end
    ret _hg_new(key, keylen)
end

func _hg_free(c: HwGcm*):
    if c == null:
        ret
    end
    _wipe(c.rk, 512)
    mem.Free(c.rk)
    _wipe(c as void*, sizeof(HwGcm) as int)
    mem.Free(c as void*)
end

func _hg_finish(c: HwGcm*, nonce: void*, y0: u128, aadlen: int, n: int): u128:
    lens := (((aadlen as u64) * (8 as u64)) as u128) << (64 as u128) | (((n as u64) * (8 as u64)) as u128)
    y := _hg_mul(y0 ^ lens, cpu.HwLoad(_hg_at(c.hp, 112)))
    j0 := _hg_enc1(c, _hg_cb(_le64(nonce, 0), _le32(nonce, 8) as u64, 1 as u32))
    ret cpu.HwBswap(y ^ cpu.HwBswap(j0))
end

func _hg_seal(c: HwGcm*, nonce: void*, aad: void*, aadlen: int, pt: void*, ct: void*, n: int, tag: void*):
    mut y := 0 as u128
    if aadlen > 0:
        y = _hg_ghash(c, y, aad, aadlen)
    end
    mut off := 0
    until off < n:
        mut take := n - off
        if take > 4096:
            take = 4096
        end
        _hg_ctr(c, nonce, (2 + off / 16) as u32, _hg_at(pt, off), _hg_at(ct, off), take)
        y = _hg_ghash(c, y, _hg_at(ct, off), take)
        off += take
    end
    cpu.HwStore(tag, _hg_finish(c, nonce, y, aadlen, n))
end

func _hg_open(c: HwGcm*, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, tag: void*, pt: void*): bool:
    mut y := 0 as u128
    if aadlen > 0:
        y = _hg_ghash(c, y, aad, aadlen)
    end
    if n > 0:
        y = _hg_ghash(c, y, ct, n)
    end
    want := _hg_finish(c, nonce, y, aadlen, n)
    d := want ^ cpu.HwLoad(tag)
    if d != (0 as u128):
        ret false
    end
    _hg_ctr(c, nonce, 2 as u32, ct, pt, n)
    ret true
end
