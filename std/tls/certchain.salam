package tls

// Loading a server's own certificate chain from a PEM file, for presenting
// on the wire (Certificate message) rather than for trust decisions. Reuses
// Roots/verify.salam's DER-concatenation-plus-offset-index storage: a list
// of certificates is the same shape whether it means "anchors we trust" or
// "our own chain to present," and the PEM scanner (_roots_add_pem) already
// does exactly the parsing this needs - find every CERTIFICATE block, add
// each one that parses.

func _load_certchain_pem(pem: str): Roots:
    mut r := _roots_new()
    _roots_add_pem(r, pem)
    ret r
end

@en "LoadCertChainFile"
@fa "بارگذاری فایل زنجیره گواهی"
@ar "تحميل ملف سلسلة الشهادات"
pub func LoadCertChainFile(path: str): Roots:
    if !os.Exists(path):
        r := _roots_new()
        ret r
    end
    pem := io.ReadFile(path)
    ret _load_certchain_pem(pem)
end
