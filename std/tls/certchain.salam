package tls

func _load_certchain_pem(pem: str): Roots:
    mut r := _roots_new()
    _roots_add_pem(r, pem)
    ret r
end

@en "LoadCertChainFile"
@fa "بارگذاری فایل زنجیره گواهی"
@ar "تحميل ملف سلسلة الشهادات"
pub func LoadCertChainFile(path: str): Roots:
    if !os.Exists(path):
        r := _roots_new()
        ret r
    end
    pem := io.ReadFile(path)
    ret _load_certchain_pem(pem)
end
