package tls

import mem

const POLY_MASK26 := 0x3ffffff as u32

struct ChaState:
    pub w: u32[16] = [
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
        0 as u32, 0 as u32, 0 as u32, 0 as u32
    ]
end

struct Poly1305:
    pub r: u32[5] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32]
    pub h: u32[5] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32]
    pub pad: u32[4] = [0 as u32, 0 as u32, 0 as u32, 0 as u32]
    pub blk: u8[16] = [
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
    ]
    pub blen: int = 0
end

inline func _rotl32(x: u32, n: u32): u32:
    ret (x << n) | (x >> ((32 as u32) - n))
end

inline func _le32(p: void*, o: int): u32:
    ret (_bget(p, o) as u32) | ((_bget(p, o + 1) as u32) << (8 as u32)) | ((_bget(p, o + 2) as u32) << (16 as u32)) | ((_bget(p, o + 3) as u32) << (24 as u32))
end

inline func _ple32(v: u32, p: void*, o: int):
    _bput(p, o, (v & (0xFF as u32)) as int)
    _bput(p, o + 1, ((v >> (8 as u32)) & (0xFF as u32)) as int)
    _bput(p, o + 2, ((v >> (16 as u32)) & (0xFF as u32)) as int)
    _bput(p, o + 3, ((v >> (24 as u32)) & (0xFF as u32)) as int)
end

func _cha_setup(st &: ChaState, key: void*, counter: u32, nonce: void*):
    st.w[0] = 0x61707865 as u32
    st.w[1] = 0x3320646e as u32
    st.w[2] = 0x79622d32 as u32
    st.w[3] = 0x6b206574 as u32
    repeat 8 in i:
        st.w[4 + i] = _le32(key, i * 4)
    end
    st.w[12] = counter
    repeat 3 in i:
        st.w[13 + i] = _le32(nonce, i * 4)
    end
end

func _cha_rounds1(st &: ChaState, out: void*):
    mut x0 := st.w[0]
    mut x1 := st.w[1]
    mut x2 := st.w[2]
    mut x3 := st.w[3]
    mut x4 := st.w[4]
    mut x5 := st.w[5]
    mut x6 := st.w[6]
    mut x7 := st.w[7]
    mut x8 := st.w[8]
    mut x9 := st.w[9]
    mut x10 := st.w[10]
    mut x11 := st.w[11]
    mut x12 := st.w[12]
    mut x13 := st.w[13]
    mut x14 := st.w[14]
    mut x15 := st.w[15]
    repeat 10:
        x0 += x4
        x12 = _rotl32(x12 ^ x0, 16 as u32)
        x8 += x12
        x4 = _rotl32(x4 ^ x8, 12 as u32)
        x0 += x4
        x12 = _rotl32(x12 ^ x0, 8 as u32)
        x8 += x12
        x4 = _rotl32(x4 ^ x8, 7 as u32)
        x1 += x5
        x13 = _rotl32(x13 ^ x1, 16 as u32)
        x9 += x13
        x5 = _rotl32(x5 ^ x9, 12 as u32)
        x1 += x5
        x13 = _rotl32(x13 ^ x1, 8 as u32)
        x9 += x13
        x5 = _rotl32(x5 ^ x9, 7 as u32)
        x2 += x6
        x14 = _rotl32(x14 ^ x2, 16 as u32)
        x10 += x14
        x6 = _rotl32(x6 ^ x10, 12 as u32)
        x2 += x6
        x14 = _rotl32(x14 ^ x2, 8 as u32)
        x10 += x14
        x6 = _rotl32(x6 ^ x10, 7 as u32)
        x3 += x7
        x15 = _rotl32(x15 ^ x3, 16 as u32)
        x11 += x15
        x7 = _rotl32(x7 ^ x11, 12 as u32)
        x3 += x7
        x15 = _rotl32(x15 ^ x3, 8 as u32)
        x11 += x15
        x7 = _rotl32(x7 ^ x11, 7 as u32)
        x0 += x5
        x15 = _rotl32(x15 ^ x0, 16 as u32)
        x10 += x15
        x5 = _rotl32(x5 ^ x10, 12 as u32)
        x0 += x5
        x15 = _rotl32(x15 ^ x0, 8 as u32)
        x10 += x15
        x5 = _rotl32(x5 ^ x10, 7 as u32)
        x1 += x6
        x12 = _rotl32(x12 ^ x1, 16 as u32)
        x11 += x12
        x6 = _rotl32(x6 ^ x11, 12 as u32)
        x1 += x6
        x12 = _rotl32(x12 ^ x1, 8 as u32)
        x11 += x12
        x6 = _rotl32(x6 ^ x11, 7 as u32)
        x2 += x7
        x13 = _rotl32(x13 ^ x2, 16 as u32)
        x8 += x13
        x7 = _rotl32(x7 ^ x8, 12 as u32)
        x2 += x7
        x13 = _rotl32(x13 ^ x2, 8 as u32)
        x8 += x13
        x7 = _rotl32(x7 ^ x8, 7 as u32)
        x3 += x4
        x14 = _rotl32(x14 ^ x3, 16 as u32)
        x9 += x14
        x4 = _rotl32(x4 ^ x9, 12 as u32)
        x3 += x4
        x14 = _rotl32(x14 ^ x3, 8 as u32)
        x9 += x14
        x4 = _rotl32(x4 ^ x9, 7 as u32)
    end
    _ple32(x0 + st.w[0], out, 0)
    _ple32(x1 + st.w[1], out, 4)
    _ple32(x2 + st.w[2], out, 8)
    _ple32(x3 + st.w[3], out, 12)
    _ple32(x4 + st.w[4], out, 16)
    _ple32(x5 + st.w[5], out, 20)
    _ple32(x6 + st.w[6], out, 24)
    _ple32(x7 + st.w[7], out, 28)
    _ple32(x8 + st.w[8], out, 32)
    _ple32(x9 + st.w[9], out, 36)
    _ple32(x10 + st.w[10], out, 40)
    _ple32(x11 + st.w[11], out, 44)
    _ple32(x12 + st.w[12], out, 48)
    _ple32(x13 + st.w[13], out, 52)
    _ple32(x14 + st.w[14], out, 56)
    _ple32(x15 + st.w[15], out, 60)
end

func _cha_block(key: void*, counter: u32, nonce: void*, out: void*):
    mut st := ChaState {}
    _cha_setup(st, key, counter, nonce)
    _cha_rounds1(st, out)
end

func _cha20_xor(key: void*, counter: u32, nonce: void*, inp: void*, out: void*, n: int):
    mut st := ChaState {}
    _cha_setup(st, key, counter, nonce)
    ks := mem.Allocate(64 as u64)
    mut off := 0
    until off < n:
        _cha_rounds1(st, ks)
        mut take := n - off
        if take > 64:
            take = 64
        end
        _xor3(((out as i64) + (off as i64)) as void*, ((inp as i64) + (off as i64)) as void*, ks, take)
        st.w[12]++
        off += take
    end
    _wipe(ks, 64)
    mem.Free(ks)
end

func _poly_init(key: void*): Poly1305:
    mut st := Poly1305 {}
    t0 := _le32(key, 0)
    t1 := _le32(key, 4)
    t2 := _le32(key, 8)
    t3 := _le32(key, 12)
    st.r[0] = t0 & (0x3ffffff as u32)
    st.r[1] = ((t0 >> (26 as u32)) | (t1 << (6 as u32))) & (0x3ffff03 as u32)
    st.r[2] = ((t1 >> (20 as u32)) | (t2 << (12 as u32))) & (0x3ffc0ff as u32)
    st.r[3] = ((t2 >> (14 as u32)) | (t3 << (18 as u32))) & (0x3f03fff as u32)
    st.r[4] = (t3 >> (8 as u32)) & (0x00fffff as u32)
    repeat 4 in i:
        st.pad[i] = _le32(key, 16 + i * 4)
    end
    st.blen = 0
    ret st
end

func _poly_words(st &: Poly1305, t0: u32, t1: u32, t2: u32, t3: u32, hibit: u32):
    r0 := st.r[0]
    r1 := st.r[1]
    r2 := st.r[2]
    r3 := st.r[3]
    r4 := st.r[4]
    s1 := r1 * (5 as u32)
    s2 := r2 * (5 as u32)
    s3 := r3 * (5 as u32)
    s4 := r4 * (5 as u32)
    h0 := st.h[0] + (t0 & POLY_MASK26)
    h1 := st.h[1] + (((t0 >> (26 as u32)) | (t1 << (6 as u32))) & POLY_MASK26)
    h2 := st.h[2] + (((t1 >> (20 as u32)) | (t2 << (12 as u32))) & POLY_MASK26)
    h3 := st.h[3] + (((t2 >> (14 as u32)) | (t3 << (18 as u32))) & POLY_MASK26)
    h4 := st.h[4] + ((t3 >> (8 as u32)) | hibit)
    d0 := (h0 as u64) * (r0 as u64) + (h1 as u64) * (s4 as u64) + (h2 as u64) * (s3 as u64) + (h3 as u64) * (s2 as u64) + (h4 as u64) * (s1 as u64)
    mut d1 := (h0 as u64) * (r1 as u64) + (h1 as u64) * (r0 as u64) + (h2 as u64) * (s4 as u64) + (h3 as u64) * (s3 as u64) + (h4 as u64) * (s2 as u64)
    mut d2 := (h0 as u64) * (r2 as u64) + (h1 as u64) * (r1 as u64) + (h2 as u64) * (r0 as u64) + (h3 as u64) * (s4 as u64) + (h4 as u64) * (s3 as u64)
    mut d3 := (h0 as u64) * (r3 as u64) + (h1 as u64) * (r2 as u64) + (h2 as u64) * (r1 as u64) + (h3 as u64) * (r0 as u64) + (h4 as u64) * (s4 as u64)
    mut d4 := (h0 as u64) * (r4 as u64) + (h1 as u64) * (r3 as u64) + (h2 as u64) * (r2 as u64) + (h3 as u64) * (r1 as u64) + (h4 as u64) * (r0 as u64)
    mut c := (d0 >> (26 as u64)) as u32
    n0 := (d0 as u32) & POLY_MASK26
    d1 += c as u64
    c = (d1 >> (26 as u64)) as u32
    n1 := (d1 as u32) & POLY_MASK26
    d2 += c as u64
    c = (d2 >> (26 as u64)) as u32
    st.h[2] = (d2 as u32) & POLY_MASK26
    d3 += c as u64
    c = (d3 >> (26 as u64)) as u32
    st.h[3] = (d3 as u32) & POLY_MASK26
    d4 += c as u64
    c = (d4 >> (26 as u64)) as u32
    st.h[4] = (d4 as u32) & POLY_MASK26
    m0 := n0 + c * (5 as u32)
    c = m0 >> (26 as u32)
    st.h[0] = m0 & POLY_MASK26
    st.h[1] = n1 + c
end

func _poly_blocks(st &: Poly1305, p: void*, n: int):
    hibit := (1 as u32) << (24 as u32)
    r0 := st.r[0]
    r1 := st.r[1]
    r2 := st.r[2]
    r3 := st.r[3]
    r4 := st.r[4]
    s1 := r1 * (5 as u32)
    s2 := r2 * (5 as u32)
    s3 := r3 * (5 as u32)
    s4 := r4 * (5 as u32)
    mut h0 := st.h[0]
    mut h1 := st.h[1]
    mut h2 := st.h[2]
    mut h3 := st.h[3]
    mut h4 := st.h[4]
    mut off := 0
    mut left := n
    until left >= 16:
        t0 := _le32(p, off)
        t1 := _le32(p, off + 4)
        t2 := _le32(p, off + 8)
        t3 := _le32(p, off + 12)
        h0 += t0 & POLY_MASK26
        h1 += ((t0 >> (26 as u32)) | (t1 << (6 as u32))) & POLY_MASK26
        h2 += ((t1 >> (20 as u32)) | (t2 << (12 as u32))) & POLY_MASK26
        h3 += ((t2 >> (14 as u32)) | (t3 << (18 as u32))) & POLY_MASK26
        h4 += (t3 >> (8 as u32)) | hibit

        d0 := (h0 as u64) * (r0 as u64) + (h1 as u64) * (s4 as u64) + (h2 as u64) * (s3 as u64) + (h3 as u64) * (s2 as u64) + (h4 as u64) * (s1 as u64)
        mut d1 := (h0 as u64) * (r1 as u64) + (h1 as u64) * (r0 as u64) + (h2 as u64) * (s4 as u64) + (h3 as u64) * (s3 as u64) + (h4 as u64) * (s2 as u64)
        mut d2 := (h0 as u64) * (r2 as u64) + (h1 as u64) * (r1 as u64) + (h2 as u64) * (r0 as u64) + (h3 as u64) * (s4 as u64) + (h4 as u64) * (s3 as u64)
        mut d3 := (h0 as u64) * (r3 as u64) + (h1 as u64) * (r2 as u64) + (h2 as u64) * (r1 as u64) + (h3 as u64) * (r0 as u64) + (h4 as u64) * (s4 as u64)
        mut d4 := (h0 as u64) * (r4 as u64) + (h1 as u64) * (r3 as u64) + (h2 as u64) * (r2 as u64) + (h3 as u64) * (r1 as u64) + (h4 as u64) * (r0 as u64)

        mut c := (d0 >> (26 as u64)) as u32
        h0 = (d0 as u32) & POLY_MASK26
        d1 += c as u64
        c = (d1 >> (26 as u64)) as u32
        h1 = (d1 as u32) & POLY_MASK26
        d2 += c as u64
        c = (d2 >> (26 as u64)) as u32
        h2 = (d2 as u32) & POLY_MASK26
        d3 += c as u64
        c = (d3 >> (26 as u64)) as u32
        h3 = (d3 as u32) & POLY_MASK26
        d4 += c as u64
        c = (d4 >> (26 as u64)) as u32
        h4 = (d4 as u32) & POLY_MASK26
        h0 += c * (5 as u32)
        c = h0 >> (26 as u32)
        h0 &= POLY_MASK26
        h1 += c

        off += 16
        left -= 16
    end
    st.h[0] = h0
    st.h[1] = h1
    st.h[2] = h2
    st.h[3] = h3
    st.h[4] = h4
end

func _poly_blk_word(st &: Poly1305, o: int): u32:
    ret (st.blk[o] as u32) | ((st.blk[o + 1] as u32) << (8 as u32)) | ((st.blk[o + 2] as u32) << (16 as u32)) | ((st.blk[o + 3] as u32) << (24 as u32))
end

func _poly_flush_blk(st &: Poly1305, hibit: u32):
    _poly_words(st, _poly_blk_word(st, 0), _poly_blk_word(st, 4), _poly_blk_word(st, 8), _poly_blk_word(st, 12), hibit)
    st.blen = 0
end

func _poly_update(st &: Poly1305, p: void*, n: int):
    mut i := 0
    if st.blen > 0:
        mut want := 16 - st.blen
        if want > n:
            want = n
        end
        repeat want in j:
            st.blk[st.blen + j] = _bget(p, j) as u8
        end
        st.blen += want
        i += want
        if st.blen == 16:
            _poly_flush_blk(st, (1 as u32) << (24 as u32))
        end
    end
    whole := ((n - i) / 16) * 16
    if whole > 0:
        _poly_blocks(st, ((p as i64) + (i as i64)) as void*, whole)
        i += whole
    end
    until i < n:
        st.blk[st.blen] = _bget(p, i) as u8
        st.blen++
        i++
    end
end

func _poly_final(st0: Poly1305, out: void*):
    mut st := st0
    if st.blen > 0:
        st.blk[st.blen] = 1 as u8
        mut z := st.blen + 1
        until z < 16:
            st.blk[z] = 0 as u8
            z++
        end
        _poly_flush_blk(st, 0 as u32)
    end

    mut h0 := st.h[0]
    mut h1 := st.h[1]
    mut h2 := st.h[2]
    mut h3 := st.h[3]
    mut h4 := st.h[4]

    mut c := h1 >> (26 as u32)
    h1 &= POLY_MASK26
    h2 += c
    c = h2 >> (26 as u32)
    h2 &= POLY_MASK26
    h3 += c
    c = h3 >> (26 as u32)
    h3 &= POLY_MASK26
    h4 += c
    c = h4 >> (26 as u32)
    h4 &= POLY_MASK26
    h0 += c * (5 as u32)
    c = h0 >> (26 as u32)
    h0 &= POLY_MASK26
    h1 += c

    mut g0 := h0 + (5 as u32)
    c = g0 >> (26 as u32)
    g0 &= POLY_MASK26
    mut g1 := h1 + c
    c = g1 >> (26 as u32)
    g1 &= POLY_MASK26
    mut g2 := h2 + c
    c = g2 >> (26 as u32)
    g2 &= POLY_MASK26
    mut g3 := h3 + c
    c = g3 >> (26 as u32)
    g3 &= POLY_MASK26
    g4 := h4 + c - ((1 as u32) << (26 as u32))

    mut mask := (g4 >> (31 as u32)) - (1 as u32)
    g0 &= mask
    g1 &= mask
    g2 &= mask
    g3 &= mask
    g4m := g4 & mask
    mask = ~mask
    h0 = (h0 & mask) | g0
    h1 = (h1 & mask) | g1
    h2 = (h2 & mask) | g2
    h3 = (h3 & mask) | g3
    h4 = (h4 & mask) | g4m

    h0 |= (h1 << (26 as u32))
    h1 = ((h1 >> (6 as u32)) | (h2 << (20 as u32)))
    h2 = ((h2 >> (12 as u32)) | (h3 << (14 as u32)))
    h3 = ((h3 >> (18 as u32)) | (h4 << (8 as u32)))

    mut f := (h0 as u64) + (st.pad[0] as u64)
    h0 = f as u32
    f = (h1 as u64) + (st.pad[1] as u64) + (f >> (32 as u64))
    h1 = f as u32
    f = (h2 as u64) + (st.pad[2] as u64) + (f >> (32 as u64))
    h2 = f as u32
    f = (h3 as u64) + (st.pad[3] as u64) + (f >> (32 as u64))
    h3 = f as u32

    _ple32(h0, out, 0)
    _ple32(h1, out, 4)
    _ple32(h2, out, 8)
    _ple32(h3, out, 12)
end

func _poly1305(key: void*, msg: void*, n: int, out: void*):
    mut st := _poly_init(key)
    _poly_update(st, msg, n)
    _poly_final(st, out)
end

func _poly_pad16(st &: Poly1305, n: int):
    if n % 16 == 0:
        ret
    end
    until st.blen < 16:
        st.blk[st.blen] = 0 as u8
        st.blen++
    end
    _poly_flush_blk(st, (1 as u32) << (24 as u32))
end

func _cha20poly_tag(key: void*, nonce: void*, aad: void*, aadlen: int, ct: void*, ctlen: int, tag: void*):
    otk := mem.Allocate(64 as u64)
    _cha_block(key, 0 as u32, nonce, otk)
    mut st := _poly_init(otk)
    _wipe(otk, 64)
    mem.Free(otk)
    if aadlen > 0:
        _poly_update(st, aad, aadlen)
    end
    _poly_pad16(st, aadlen)
    if ctlen > 0:
        _poly_update(st, ct, ctlen)
    end
    _poly_pad16(st, ctlen)
    _poly_words(st, aadlen as u32, 0 as u32, ctlen as u32, 0 as u32, (1 as u32) << (24 as u32))
    _poly_final(st, tag)
end

func _cha20poly_seal(key: void*, nonce: void*, aad: void*, aadlen: int, pt: void*, ct: void*, n: int, tag: void*):
    _cha20_xor(key, 1 as u32, nonce, pt, ct, n)
    _cha20poly_tag(key, nonce, aad, aadlen, ct, n, tag)
end

func _cha20poly_open(key: void*, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, tag: void*, pt: void*): bool:
    want := mem.Allocate(16 as u64)
    _cha20poly_tag(key, nonce, aad, aadlen, ct, n, want)
    good := _cteq(want, tag, 16)
    mem.Free(want)
    if not good:
        ret false
    end
    _cha20_xor(key, 1 as u32, nonce, ct, pt, n)
    ret true
end
