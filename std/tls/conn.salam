package tls


// The public connection API. The handshake flows live in driver.salam.

// The public TLS connection: dial, handshake, read, write, close.
//
// The handshake driver lives here rather than in handshake13.salam so that the
// message construction and parsing stay independently testable without a
// socket.

pub struct Config:
    pub server_name: str = ""
    // Path to a PEM trust store. Empty means the default search in roots.salam.
    pub ca_file: str = ""
    // Skip certificate verification. Intended for tests against a known
    // endpoint; it is deliberately verbose to set and is reported by
    // Conn.insecure so a caller cannot forget it is on.
    pub insecure_skip_verify: bool = false
    pub alpn: str = ""
    // Offer only TLS_AES_128_GCM_SHA256. ChaCha20-Poly1305 is preferred by
    // default because it is constant-time by construction; this exists so the
    // AES-GCM path gets exercised against real servers too.
    pub aes_only: bool = false
end

pub struct Conn:
    pub h: Handshake = Handshake {}
    pub host: str = ""
    pub open: bool = false
    pub insecure: bool = false
    // decrypted application data not yet handed to the caller
    pub pending: Buf = Buf {}
    pub err: str = ""
end

func _conn_fail(c &: Conn, msg: str): bool:
    if c.err.len() == 0:
        c.err = msg
    end
    c.open = false
    ret false
end

// ---------------------------------------------------------------- public API

// RFC 8446 section 4.6.3. A peer may rekey at any point after the handshake:
//
//   application_traffic_secret_N+1 =
//       HKDF-Expand-Label(application_traffic_secret_N, "traffic upd", "", Hash.length)
//
// and the sequence number restarts at zero with the new key.
//
// Ignoring a KeyUpdate does not merely lose a feature: every record after it is
// encrypted under a key we no longer hold, so the connection dies with a
// bad-MAC error that reads like corruption. Short request/response exchanges
// never reach it, which is exactly why it went unnoticed.
func _traffic_update(h &: Handshake, secret &: Buf): bool:
    mut next := _newbuf(h.hlen)
    defer _buf_wipe(next)
    _putzeros(next, h.hlen)
    if !_hkdf_expand_label(h.hash, secret.p, secret.len, "traffic upd", null, 0, next.p, h.hlen):
        ret false
    end
    _bufreset(secret)
    _putbuf(secret, next)
    ret true
end

// Handle a KeyUpdate from the peer. `requested` asks us to rekey our own
// sending direction and answer in kind.
func _do_key_update(c &: Conn, requested: bool): bool:
    if c.h.ver != TLS13:
        // TLS 1.2 has no KeyUpdate; seeing one means the peer is confused
        ret false
    end
    if !_traffic_update(c.h, c.h.s_ap_secret):
        ret false
    end
    _tk_free(c.h.rec.rxk)
    c.h.rec.rxk = _tk_derive(c.h.s_ap_secret.p, c.h.s_ap_secret.len, c.h.cipher)
    if !c.h.rec.rxk.live:
        ret false
    end
    if !requested:
        ret true
    end
    // Answer before rekeying our own send direction, so the reply still goes
    // out under the key the peer currently has.
    mut msg := _newbuf(8)
    defer _buf_free(msg)
    _put8(msg, HS_KEY_UPDATE)
    _put24(msg, 1)
    _put8(msg, 0)
    if !_rec_write(c.h.rec, REC_HANDSHAKE, msg.p, msg.len):
        ret false
    end
    if !_traffic_update(c.h, c.h.c_ap_secret):
        ret false
    end
    _tk_free(c.h.rec.txk)
    c.h.rec.txk = _tk_derive(c.h.c_ap_secret.p, c.h.c_ap_secret.len, c.h.cipher)
    ret c.h.rec.txk.live
end

// Pull decrypted application data into c.pending, handling post-handshake
// NewSessionTicket/KeyUpdate messages and alerts along the way. Shared by
// Read and ReadBytes, which differ only in how they drain c.pending
// afterward. Returns false on EOF/alert/error (c.err set if it was an error,
// not a clean close).
func _fill_pending(c &: Conn): bool:
    mut frag := _newbuf(REC_MAX_PLAINTEXT)
    defer _buf_free(frag)
    mut guard := 0
    until c.pending.len == 0 && guard < 64:
        guard += 1
        mut typ := 0
        if !_rec_read(c.h.rec, typ, frag):
            c.open = false
            if c.h.rec.err.len() > 0:
                c.err = c.h.rec.err
            end
            ret false
        end
        if typ == REC_APPLICATION_DATA:
            _putbuf(c.pending, frag)
        else if typ == REC_ALERT:
            c.open = false
            if _bufat(frag, 1) != ALERT_CLOSE_NOTIFY:
                c.err = _alert_text(frag)
            end
            ret false
        else if typ == REC_HANDSHAKE:
            // Post-handshake messages. NewSessionTicket carries no application
            // data and is genuinely safe to drop, but KeyUpdate rekeys the
            // connection and MUST be acted on.
            if frag.len >= 4:
                if _bufat(frag, 0) == HS_KEY_UPDATE:
                    req := _bufat(frag, 4) == 1
                    if !_do_key_update(c, req):
                        c.open = false
                        c.err = "key update failed"
                        ret false
                    end
                end
            end
            continue
        end
    end
    ret true
end

@en "NewConfig"
@fa "پیکربندی جدید"
@ar "إعداد جدید"
pub func NewConfig(server_name: str): Config:
    mut c := Config {}
    c.server_name = server_name
    ret c
end

@en "Dial"
@fa "اتصال امن"
@ar "اتصال آمن"
pub func Dial(host: str, port: int, cfg: Config): Conn:
    mut c := Conn {}
    c.insecure = cfg.insecure_skip_verify
    c.pending = _newbuf(REC_MAX_PLAINTEXT)
    mut conf := cfg
    if conf.server_name.len() == 0:
        conf.server_name = host
    end
    // The name VERIFIED is the configured server_name, not the TCP target.
    // Those differ whenever a caller connects to one address but expects a
    // particular identity (a pinned IP, a proxy, a test harness). Checking the
    // dial target instead would mean a caller who explicitly asked for one
    // identity silently gets whatever the endpoint happens to prove.
    c.host = conf.server_name
    s := net.Connect(host, port)
    if !net.Ok(s):
        c.err = "could not connect to " + host
        ret c
    end
    c.h = Handshake {}
    c.h.rec = _rec_new(s.fd)
    c.h.priv = _newbuf(32)
    c.h.pub_key = _newbuf(32)
    c.h.shared = _newbuf(32)
    c.h.hs_secret = _newbuf(48)
    c.h.master = _newbuf(48)
    c.h.c_hs_secret = _newbuf(48)
    c.h.s_hs_secret = _newbuf(48)
    c.h.c_ap_secret = _newbuf(48)
    c.h.s_ap_secret = _newbuf(48)
    c.h.certs = _newbuf(8192)
    c.h.cert_off = _newbuf(128)
    c.h.crand = _newbuf(32)
    c.h.srand = _newbuf(32)
    c.h.ecpriv = _newbuf(32)
    c.h.ecpub = _newbuf(65)
    _do_handshake(c, conf)
    ret c
end

// Load a server identity: a leaf-first certificate chain PEM and the
// matching private key PEM (PKCS#1/SEC1/PKCS#8, whichever the file uses -
// see privkey.salam). `ok` is false if either file was missing, empty, or
// did not parse; WrapServer refuses to run a handshake with a config that
// failed to load, rather than fail confusingly mid-handshake instead.
@en "NewServerConfig"
@fa "پیکربندی کارساز جدید"
@ar "إعداد الخادم جدید"
pub func NewServerConfig(cert_file: str, key_file: str): ServerConfig:
    mut cfg := ServerConfig {}
    cfg.chain = LoadCertChainFile(cert_file)
    cfg.key = LoadPrivateKeyFile(key_file)
    cfg.ok = cfg.chain.count > 0 && cfg.key.ok
    ret cfg
end

// Run the server side of a TLS handshake on `fd`, an already-accepted plain
// TCP socket (e.g. from net.Accept/tcp.Accept). TLS 1.3 only for now - a
// client that cannot negotiate it is refused with ConnError explaining why,
// not silently mishandled.
@en "WrapServer"
@fa "پوشش کارساز"
@ar "تغليف الخادم"
pub func WrapServer(fd: i64, cfg: ServerConfig): Conn:
    mut c := Conn {}
    c.pending = _newbuf(REC_MAX_PLAINTEXT)
    if !cfg.ok:
        c.err = "server config did not load (bad certificate or key file)"
        ret c
    end
    c.h = Handshake {}
    c.h.rec = _rec_new(fd)
    c.h.priv = _newbuf(32)
    c.h.pub_key = _newbuf(32)
    c.h.shared = _newbuf(32)
    c.h.hs_secret = _newbuf(48)
    c.h.master = _newbuf(48)
    c.h.c_hs_secret = _newbuf(48)
    c.h.s_hs_secret = _newbuf(48)
    c.h.c_ap_secret = _newbuf(48)
    c.h.s_ap_secret = _newbuf(48)
    c.h.certs = _newbuf(8192)
    c.h.cert_off = _newbuf(128)
    c.h.crand = _newbuf(32)
    c.h.srand = _newbuf(32)
    c.h.ecpriv = _newbuf(32)
    c.h.ecpub = _newbuf(65)
    _do_server_handshake(c, cfg)
    ret c
end

@en "ConnOk"
@fa "اتصال معتبر"
@ar "الاتصال صالح"
pub func ConnOk(c: Conn): bool:
    ret c.open
end

@en "ConnError"
@fa "خطای اتصال"
@ar "خطأ الاتصال"
pub func ConnError(c: Conn): str:
    ret c.err
end

@en "Write"
@fa "نوشتن"
@ar "كتابة"
pub func Write(c &: Conn, data: str): int:
    ret WriteBytes(c, data as void*, data.len())
end

// Byte-count variant of Write. str is a NUL-terminated C string under the
// hood (confirmed: str.len() stops at the first embedded NUL byte), so any
// caller layering a binary protocol over TLS - WebSocket framing, with its
// mandatory XOR-masked payloads that can legitimately contain a 0x00 byte
// anywhere - must go through this, not Write, or bytes past the first NUL
// silently never get sent.
@en "WriteBytes"
@fa "نوشتن بایت"
@ar "كتابة بایتات"
pub func WriteBytes(c &: Conn, ptr: void*, n: int): int:
    if !c.open:
        ret 0 - 1
    end
    if !_rec_write(c.h.rec, REC_APPLICATION_DATA, ptr, n):
        _conn_fail(c, "write failed: " + c.h.rec.err)
        ret 0 - 1
    end
    ret n
end

// Read up to `max` bytes of application data. Returns "" at end of stream.
@en "Read"
@fa "خواندن"
@ar "قراءة"
pub func Read(c &: Conn, max: int): str:
    if !c.open:
        ret ""
    end
    if !_fill_pending(c):
        ret ""
    end
    if c.pending.len == 0:
        ret ""
    end
    mut take := c.pending.len
    if max > 0 && take > max:
        take = max
    end
    mut out := _newbuf(take + 1)
    defer _buf_free(out)
    repeat take with i:
        _put8(out, _bufat(c.pending, i))
    end
    _bufconsume(c.pending, take)
    ret _bufstr(out)
end

// Byte-count variant of Read: copies decrypted bytes directly into `buf`
// (caller-owned, at least `max` bytes) and returns the real count, so a
// caller expecting embedded NUL bytes (e.g. WebSocket frame payloads) does
// not lose data the way a str-and-.len() round trip would. Returns 0 at end
// of stream, same as Read returning "".
@en "ReadBytes"
@fa "خواندن بایت"
@ar "قراءة بایتات"
pub func ReadBytes(c &: Conn, buf: void*, max: int): int:
    if !c.open:
        ret 0
    end
    if !_fill_pending(c):
        ret 0
    end
    if c.pending.len == 0:
        ret 0
    end
    mut take := c.pending.len
    if max > 0 && take > max:
        take = max
    end
    mut dst := buf as i8*
    repeat take with i:
        dst[i] = _bufat(c.pending, i) as i8
    end
    _bufconsume(c.pending, take)
    ret take
end

@en "Close"
@fa "بستن اتصال"
@ar "إغلاق الاتصال"
pub func Close(c &: Conn):
    if c.open:
        _rec_send_alert(c.h.rec, 1, ALERT_CLOSE_NOTIFY)
    end
    c.open = false
    if c.h.rec.fd >= 0:
        net.Close(net.SocketFromFd(c.h.rec.fd))
    end
    _rec_free(c.h.rec)
    _hs_free(c.h)
    _buf_free(c.pending)
end

@en "Version"
@fa "نسخه"
@ar "إصدار"
pub func Version(c: Conn): str:
    if c.h.ver == TLS13:
        ret "TLS1.3"
    end
    if c.h.ver == TLS12:
        ret "TLS1.2"
    end
    ret "none"
end

@en "CipherName"
@fa "نام رمز"
@ar "اسم الشفرة"
pub func CipherName(c: Conn): str:
    s := c.h.suite
    if s == TLS_CHACHA20_POLY1305_SHA256:
        ret "TLS_CHACHA20_POLY1305_SHA256"
    end
    if s == TLS_AES_128_GCM_SHA256:
        ret "TLS_AES_128_GCM_SHA256"
    end
    if s == TLS_AES_256_GCM_SHA384:
        ret "TLS_AES_256_GCM_SHA384"
    end
    if s == TLS12_ECDHE_ECDSA_AES128_GCM_SHA256:
        ret "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
    end
    if s == TLS12_ECDHE_RSA_AES128_GCM_SHA256:
        ret "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
    end
    if s == TLS12_ECDHE_ECDSA_AES256_GCM_SHA384:
        ret "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
    end
    if s == TLS12_ECDHE_RSA_AES256_GCM_SHA384:
        ret "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384"
    end
    if s == TLS12_ECDHE_RSA_CHACHA20_SHA256:
        ret "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256"
    end
    if s == TLS12_ECDHE_ECDSA_CHACHA20_SHA256:
        ret "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256"
    end
    ret "none"
end

@en "PeerCertCount"
@fa "تعداد گواهی همتا"
@ar "عدد شهادات الند"
pub func PeerCertCount(c: Conn): int:
    ret c.h.ncerts
end
