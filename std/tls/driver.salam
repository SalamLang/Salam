package tls

func _hs_next_msg(h &: Handshake, buf &: Buf, typ &: int, body &: Buf): bool:
    mut frag := _newbuf(REC_MAX_PLAINTEXT)
    defer _buf_free(frag)
    mut guard := 0
    until guard < 4096:
        guard += 1
        if buf.len >= 4:
            mlen := (_bufat(buf, 1) << 16) | (_bufat(buf, 2) << 8) | _bufat(buf, 3)
            if mlen > REC_MAX_PLAINTEXT * 4:
                ret _hs_fail(h, "handshake message too large")
            end
            if buf.len >= 4 + mlen:
                typ = _bufat(buf, 0)
                _hash_update(h.tr, buf.p, 4 + mlen)
                _bufreset(body)
                repeat mlen in i:
                    _put8(body, _bufat(buf, 4 + i))
                end
                _bufconsume(buf, 4 + mlen)
                ret true
            end
        end
        mut rtyp := 0
        if not _rec_read(h.rec, rtyp, frag):
            ret _hs_fail(h, "connection closed during handshake")
        end
        if rtyp == REC_CHANGE_CIPHER_SPEC:
            continue
        end
        if rtyp == REC_ALERT:
            ret _hs_fail(h, _alert_text(frag))
        end
        if rtyp != REC_HANDSHAKE:
            ret _hs_fail(h, "unexpected record type during handshake")
        end
        _putbuf(buf, frag)
    end
    ret _hs_fail(h, "handshake did not converge")
end

func _alert_text(a: Buf): str:
    if a.len < 2:
        ret "malformed alert"
    end
    d := _bufat(a, 1)
    if d == ALERT_CLOSE_NOTIFY: ret "peer closed the connection" end
    if d == ALERT_BAD_RECORD_MAC: ret "peer reported bad record MAC" end
    if d == ALERT_HANDSHAKE_FAILURE: ret "peer reported handshake failure" end
    if d == ALERT_BAD_CERTIFICATE: ret "peer rejected our certificate" end
    if d == ALERT_ILLEGAL_PARAMETER: ret "peer reported illegal parameter" end
    if d == ALERT_DECODE_ERROR: ret "peer could not decode our message" end
    if d == ALERT_DECRYPT_ERROR: ret "peer reported decrypt error" end
    if d == ALERT_PROTOCOL_VERSION: ret "peer does not support TLS 1.3" end
    ret "peer sent alert " + d
end

func _install_keys(h &: Handshake, rx: Buf, tx: Buf):
    _tk_free(h.rec.rxk)
    _tk_free(h.rec.txk)
    h.rec.rxk = _tk_derive(rx.p, rx.len, h.cipher)
    h.rec.txk = _tk_derive(tx.p, tx.len, h.cipher)
end

func _do_handshake12(c &: Conn, h &: Handshake, cfg: Config, buf &: Buf): bool:
    mut typ := 0
    mut body := _newbuf(REC_MAX_PLAINTEXT)
    defer _buf_free(body)
    mut sesshash := _newbuf(64)
    defer _buf_free(sesshash)

    if not _hs_next_msg(h, buf, typ, body):
        ret _conn_fail(c, h.err)
    end
    if typ != HS_CERTIFICATE:
        ret _conn_fail(c, "expected Certificate")
    end
    if not _hs_read_cert_list(h, _readerof(body), false):
        ret _conn_fail(c, h.err)
    end

    if not _hs_next_msg(h, buf, typ, body):
        ret _conn_fail(c, h.err)
    end
    if typ != HS_SERVER_KEY_EXCHANGE:
        ret _conn_fail(c, "expected ServerKeyExchange (static RSA suites are not offered)")
    end
    sker := _readerof(body)
    if not _tls12_parse_ske(h, sker):
        ret _conn_fail(c, h.err)
    end

    if not _hs_next_msg(h, buf, typ, body):
        ret _conn_fail(c, h.err)
    end
    mut cert_requested := false
    if typ == HS_CERTIFICATE_REQUEST:
        cert_requested = true
        if not _hs_next_msg(h, buf, typ, body):
            ret _conn_fail(c, h.err)
        end
    end
    if typ != HS_SERVER_HELLO_DONE:
        ret _conn_fail(c, "expected ServerHelloDone")
    end

    if not _verify_peer_chain(c, h, cfg):
        ret false
    end

    if cert_requested:
        mut ccert := _newbuf(8)
        defer _buf_free(ccert)
        _put8(ccert, HS_CERTIFICATE)
        _put24(ccert, 3)
        _put24(ccert, 0)
        _hash_update(h.tr, ccert.p, ccert.len)
        if not _rec_write(h.rec, REC_HANDSHAKE, ccert.p, ccert.len):
            ret _conn_fail(c, "could not send client Certificate")
        end
    end

    mut cke := _newbuf(256)
    defer _buf_free(cke)
    _tls12_client_key_exchange(h, h.group, cke)
    _hash_update(h.tr, cke.p, cke.len)
    if not _rec_write(h.rec, REC_HANDSHAKE, cke.p, cke.len):
        ret _conn_fail(c, "could not send ClientKeyExchange")
    end

    _bufreset(h.master)
    _putzeros(h.master, MASTER_SECRET_LEN)
    if h.ems:
        _hs_transcript(h, sesshash)
        _tls12_master_ext(h.hash, h.shared.p, h.shared.len, sesshash, h.master.p)
    else:
        _tls12_master(h.hash, h.shared.p, h.shared.len, h.crand, h.srand, h.master.p)
    end
    h.master.len = MASTER_SECRET_LEN

    mut ccs := _newbuf(1)
    defer _buf_free(ccs)
    _put8(ccs, 1)
    _rec_write_plain(h.rec, REC_CHANGE_CIPHER_SPEC, ccs.p, 1)

    if not _tls12_install_keys(h):
        ret _conn_fail(c, "could not install TLS 1.2 keys")
    end

    mut th := _newbuf(64)
    defer _buf_free(th)
    _hs_transcript(h, th)
    mut fin := _newbuf(32)
    defer _buf_free(fin)
    _tls12_finished_msg(h, PRF_LABEL_CLIENT_FINISHED, th, fin)
    _hash_update(h.tr, fin.p, fin.len)
    if not _rec_write(h.rec, REC_HANDSHAKE, fin.p, fin.len):
        ret _conn_fail(c, "could not send Finished")
    end

    mut th2 := _newbuf(64)
    defer _buf_free(th2)
    _hs_transcript(h, th2)
    mut want := _newbuf(32)
    defer _buf_free(want)
    _tls12_finished_msg(h, PRF_LABEL_SERVER_FINISHED, th2, want)

    if not _hs_next_msg(h, buf, typ, body):
        ret _conn_fail(c, h.err)
    end
    if typ != HS_FINISHED:
        ret _conn_fail(c, "expected server Finished")
    end
    if body.len != VERIFY_DATA_LEN or not _cteq(body.p, _bufptr(want, 4), VERIFY_DATA_LEN):
        _rec_send_alert(h.rec, 2, ALERT_DECRYPT_ERROR)
        ret _conn_fail(c, "server Finished did not verify")
    end

    h.ok = true
    c.open = true
    ret true
end

func _verify_peer_chain(c &: Conn, h &: Handshake, cfg: Config): bool:
    if cfg.insecure_skip_verify:
        ret true
    end
    roots := _roots_shared(cfg.ca_file)
    if roots.count == 0:
        ret _conn_fail(c, "no trusted roots available")
    end
    mut chain: Reader[8]
    repeat 8 in i:
        chain[i] = _newreader(null, 0)
    end
    repeat h.ncerts in i:
        chain[i] = _newreader(_bufptr(h.certs, _cert_start(h, i)), _cert_len(h, i))
    end
    vr := _verify_chain(chain, h.ncerts, roots, c.host, _now_stamp())
    if vr != VERR_NONE:
        _rec_send_alert(h.rec, 2, ALERT_BAD_CERTIFICATE)
        ret _conn_fail(c, "certificate verification failed: " + _verr_str(vr))
    end
    ret true
end

func _read_server_hello(h &: Handshake, frag &: Buf, shlen &: int, err &: str): bool:
    mut rtyp := 0
    mut got := false
    mut guard := 0
    until not got and guard < 16:
        guard += 1
        if not _rec_read(h.rec, rtyp, frag):
            err = "no ServerHello: " + h.rec.err
            ret false
        end
        if rtyp == REC_CHANGE_CIPHER_SPEC:
            continue
        end
        if rtyp == REC_ALERT:
            err = _alert_text(frag)
            ret false
        end
        if rtyp != REC_HANDSHAKE:
            err = "expected ServerHello"
            ret false
        end
        got = true
    end
    if not got or frag.len < 4 or _bufat(frag, 0) != HS_SERVER_HELLO:
        err = "expected ServerHello"
        ret false
    end
    shlen = (_bufat(frag, 1) << 16) | (_bufat(frag, 2) << 8) | _bufat(frag, 3)
    if frag.len < 4 + shlen:
        err = "truncated ServerHello"
        ret false
    end
    ret true
end

func _do_handshake(c &: Conn, cfg: Config): bool:
    mut h := c.h
    mut ch := _newbuf(512)
    defer _buf_free(ch)
    if not _hs_build_client_hello(h, cfg.server_name, cfg.alpn, cfg.aes_only, ch):
        c.h = h
        ret _conn_fail(c, "could not build ClientHello")
    end
    if not _rec_write(h.rec, REC_HANDSHAKE, ch.p, ch.len):
        c.h = h
        ret _conn_fail(c, "could not send ClientHello: " + h.rec.err)
    end

    mut buf := _newbuf(REC_MAX_PLAINTEXT)
    defer _buf_free(buf)
    mut typ := 0
    mut body := _newbuf(REC_MAX_PLAINTEXT)
    defer _buf_free(body)

    mut frag := _newbuf(REC_MAX_PLAINTEXT)
    defer _buf_free(frag)
    mut shlen := 0
    mut sherr := ""
    if not _read_server_hello(h, frag, shlen, sherr):
        c.h = h
        ret _conn_fail(c, sherr)
    end
    shr := _newreader(_bufptr(frag, 4), shlen)
    if not _hs_parse_server_hello(h, shr):
        c.h = h
        ret _conn_fail(c, h.err)
    end

    if h.hrr:
        mut synth := _newbuf(4 + 64)
        defer _buf_free(synth)
        _put8(synth, HS_MESSAGE_HASH)
        _put24(synth, h.hlen)
        _putzeros(synth, h.hlen)
        _hash_oneshot(h.hash, ch.p, ch.len, _bufptr(synth, 4))
        h.tr = _hash_init(h.hash)
        _hash_update(h.tr, synth.p, synth.len)
        _hash_update(h.tr, frag.p, 4 + shlen)
        if not _hs_build_client_hello(h, cfg.server_name, cfg.alpn, cfg.aes_only, ch):
            c.h = h
            ret _conn_fail(c, "could not build the second ClientHello: " + h.err)
        end
        if not _rec_write(h.rec, REC_HANDSHAKE, ch.p, ch.len):
            c.h = h
            ret _conn_fail(c, "could not send the second ClientHello: " + h.rec.err)
        end
        _hash_update(h.tr, ch.p, ch.len)
        _bufreset(frag)
        if not _read_server_hello(h, frag, shlen, sherr):
            c.h = h
            ret _conn_fail(c, sherr)
        end
        shr2 := _newreader(_bufptr(frag, 4), shlen)
        if not _hs_parse_server_hello(h, shr2):
            c.h = h
            ret _conn_fail(c, h.err)
        end
        if h.ver != TLS13:
            c.h = h
            ret _conn_fail(c, "server switched to TLS 1.2 after a HelloRetryRequest")
        end
        _hash_update(h.tr, frag.p, 4 + shlen)
    else:
        h.tr = _hash_init(h.hash)
        _hash_update(h.tr, ch.p, ch.len)
        _hash_update(h.tr, frag.p, 4 + shlen)
    end
    if frag.len > 4 + shlen:
        _putraw(buf, _bufptr(frag, 4 + shlen), frag.len - (4 + shlen))
    end

    if h.ver == TLS12:
        ok12 := _do_handshake12(c, h, cfg, buf)
        c.h = h
        ret ok12
    end

    if not _hs_key_schedule(h):
        c.h = h
        ret _conn_fail(c, "key schedule failed")
    end
    _install_keys(h, h.s_hs_secret, h.c_hs_secret)

    if not _hs_next_msg(h, buf, typ, body):
        c.h = h
        ret _conn_fail(c, h.err)
    end
    if typ != HS_ENCRYPTED_EXTENSIONS:
        c.h = h
        ret _conn_fail(c, "expected EncryptedExtensions")
    end

    if not _hs_next_msg(h, buf, typ, body):
        c.h = h
        ret _conn_fail(c, h.err)
    end
    mut cert_ctx := _newbuf(256)
    defer _buf_free(cert_ctx)
    mut cert_requested := false
    if typ == HS_CERTIFICATE_REQUEST:
        if body.len < 1 or _bufat(body, 0) + 1 > body.len:
            c.h = h
            ret _conn_fail(c, "malformed CertificateRequest")
        end
        repeat _bufat(body, 0) in i:
            _put8(cert_ctx, _bufat(body, 1 + i))
        end
        cert_requested = true
        if not _hs_next_msg(h, buf, typ, body):
            c.h = h
            ret _conn_fail(c, h.err)
        end
    end
    if typ != HS_CERTIFICATE:
        c.h = h
        ret _conn_fail(c, "expected Certificate")
    end
    certr := _readerof(body)
    if not _hs_parse_certificate(h, certr):
        c.h = h
        ret _conn_fail(c, h.err)
    end

    mut th_cv := _newbuf(64)
    defer _buf_free(th_cv)
    _hs_transcript(h, th_cv)

    if not _hs_next_msg(h, buf, typ, body):
        c.h = h
        ret _conn_fail(c, h.err)
    end
    if typ != HS_CERTIFICATE_VERIFY:
        c.h = h
        ret _conn_fail(c, "expected CertificateVerify")
    end
    cvr := _readerof(body)
    if not _hs_verify_cert_verify(h, cvr, th_cv):
        c.h = h
        ret _conn_fail(c, h.err)
    end

    if not _verify_peer_chain(c, h, cfg):
        c.h = h
        ret false
    end

    mut th_fin := _newbuf(64)
    defer _buf_free(th_fin)
    _hs_transcript(h, th_fin)

    if not _hs_next_msg(h, buf, typ, body):
        c.h = h
        ret _conn_fail(c, h.err)
    end
    if typ != HS_FINISHED:
        c.h = h
        ret _conn_fail(c, "expected Finished")
    end
    mut expect := _newbuf(64)
    defer _buf_free(expect)
    if not _hs_finished_mac(h, h.s_hs_secret, th_fin, expect):
        c.h = h
        ret _conn_fail(c, "could not compute Finished MAC")
    end
    if body.len != expect.len or not _cteq(body.p, expect.p, expect.len):
        c.h = h
        _rec_send_alert(h.rec, 2, ALERT_DECRYPT_ERROR)
        ret _conn_fail(c, "server Finished did not verify")
    end

    mut th_app := _newbuf(64)
    defer _buf_free(th_app)
    _hs_transcript(h, th_app)
    if not _hs_derive(h, h.master, "c ap traffic", th_app, h.c_ap_secret):
        c.h = h
        ret _conn_fail(c, "could not derive client application secret")
    end
    if not _hs_derive(h, h.master, "s ap traffic", th_app, h.s_ap_secret):
        c.h = h
        ret _conn_fail(c, "could not derive server application secret")
    end

    mut ccs := _newbuf(1)
    defer _buf_free(ccs)
    _put8(ccs, 1)
    _rec_write_plain(h.rec, REC_CHANGE_CIPHER_SPEC, ccs.p, 1)

    mut th_cfin := _newbuf(64)
    defer _buf_free(th_cfin)
    if cert_requested:
        mut ccert := _newbuf(16 + cert_ctx.len)
        defer _buf_free(ccert)
        _put8(ccert, HS_CERTIFICATE)
        _put24(ccert, 1 + cert_ctx.len + 3)
        _put8(ccert, cert_ctx.len)
        _putbuf(ccert, cert_ctx)
        _put24(ccert, 0)
        _hash_update(h.tr, ccert.p, ccert.len)
        if not _rec_write(h.rec, REC_HANDSHAKE, ccert.p, ccert.len):
            c.h = h
            ret _conn_fail(c, "could not send client Certificate")
        end
    end
    _hs_transcript(h, th_cfin)

    mut cfin := _newbuf(64)
    defer _buf_free(cfin)
    if not _hs_finished_mac(h, h.c_hs_secret, th_cfin, cfin):
        c.h = h
        ret _conn_fail(c, "could not compute client Finished")
    end
    mut fmsg := _newbuf(64)
    defer _buf_free(fmsg)
    _put8(fmsg, HS_FINISHED)
    _put24(fmsg, cfin.len)
    _putbuf(fmsg, cfin)
    if not _rec_write(h.rec, REC_HANDSHAKE, fmsg.p, fmsg.len):
        c.h = h
        ret _conn_fail(c, "could not send Finished")
    end

    _install_keys(h, h.s_ap_secret, h.c_ap_secret)
    h.ok = true
    c.h = h
    c.open = true
    ret true
end
