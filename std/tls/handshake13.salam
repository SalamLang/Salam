package tls

// TLS 1.3 client handshake and key schedule (RFC 8446 sections 4 and 7.1).
//
// Client side only. The flow is:
//
//   -> ClientHello                        (key_share: X25519)
//   <- ServerHello                        (selects suite + peer key share)
//      [derive handshake traffic keys; everything after is encrypted]
//   <- EncryptedExtensions
//   <- Certificate
//   <- CertificateVerify                  (signature over the transcript)
//   <- Finished                           (MAC over the transcript)
//   -> Finished
//      [derive application traffic keys]
//
// THE TRANSCRIPT IS THE POINT. Every handshake message is absorbed into a
// running hash, and both the CertificateVerify signature and both Finished
// MACs cover it. That is what binds the negotiated parameters to the server's
// identity: an attacker who rewrites the ClientHello's cipher list or key share
// changes the transcript, and the server's Finished then fails to verify. So
// the transcript must be fed the exact bytes seen on the wire, in order, and
// nothing else.
//
// NOT IMPLEMENTED: session resumption / PSK, 0-RTT, client certificates,
// HelloRetryRequest, post-handshake KeyUpdate. A server that requires any of
// them will fail the handshake rather than silently degrade.

const HS_CLIENT_HELLO := 1
const HS_SERVER_HELLO := 2
const HS_NEW_SESSION_TICKET := 4
const HS_ENCRYPTED_EXTENSIONS := 8
const HS_CERTIFICATE := 11
const HS_CERTIFICATE_REQUEST := 13
const HS_CERTIFICATE_VERIFY := 15
const HS_FINISHED := 20
const HS_KEY_UPDATE := 24

const EXT_SERVER_NAME := 0
const EXT_SUPPORTED_GROUPS := 10
const EXT_SIGNATURE_ALGORITHMS := 13
const EXT_ALPN := 16
const EXT_SUPPORTED_VERSIONS := 43
const EXT_KEY_SHARE := 51

const GROUP_X25519 := 0x001D
const GROUP_SECP256R1 := 0x0017
const GROUP_SECP384R1 := 0x0018

// signature_algorithms code points
const SA_RSA_PKCS1_SHA256 := 0x0401
const SA_RSA_PKCS1_SHA384 := 0x0501
const SA_ECDSA_P256_SHA256 := 0x0403
const SA_ECDSA_P384_SHA384 := 0x0503
const SA_RSA_PSS_RSAE_SHA256 := 0x0804
const SA_RSA_PSS_RSAE_SHA384 := 0x0805
const SA_RSA_PSS_PSS_SHA256 := 0x0809

// HelloRetryRequest is signalled by this fixed value in ServerHello.random.
const HRR_RANDOM := "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c"

struct Handshake:
    pub rec: RecordLayer = RecordLayer {}
    pub cipher: int = 0
    pub hash: int = 0
    pub hlen: int = 0
    // running transcript hash over every handshake message
    pub tr: Hash = Hash {}
    pub priv: Buf = Buf {}
    pub pub_key: Buf = Buf {}
    pub shared: Buf = Buf {}
    pub hs_secret: Buf = Buf {}
    pub master: Buf = Buf {}
    pub c_hs_secret: Buf = Buf {}
    pub s_hs_secret: Buf = Buf {}
    pub c_ap_secret: Buf = Buf {}
    pub s_ap_secret: Buf = Buf {}
    // the server's certificate chain, as received
    pub certs: Buf = Buf {}
    pub cert_off: Buf = Buf {}
    pub ncerts: int = 0
    // negotiated version, and the randoms TLS 1.2 signs and seeds with
    // the cipher suite exactly as the server sent it, kept so the
    // connection can be reported accurately rather than reconstructed
    pub suite: int = 0
    pub ver: int = 0
    pub crand: Buf = Buf {}
    pub srand: Buf = Buf {}
    pub ems: bool = false
    pub group: int = 0
    pub ecpriv: Buf = Buf {}
    pub ecpub: Buf = Buf {}
    pub ok: bool = false
    pub err: str = ""
end

func _hs_free(h &: Handshake):
    _buf_wipe(h.priv)
    _buf_free(h.pub_key)
    _buf_wipe(h.shared)
    _buf_wipe(h.hs_secret)
    _buf_wipe(h.master)
    _buf_wipe(h.c_hs_secret)
    _buf_wipe(h.s_hs_secret)
    _buf_wipe(h.c_ap_secret)
    _buf_wipe(h.s_ap_secret)
    _buf_free(h.certs)
    _buf_free(h.cert_off)
    _buf_free(h.crand)
    _buf_free(h.srand)
    _buf_wipe(h.ecpriv)
    _buf_free(h.ecpub)
end

func _hs_fail(h &: Handshake, msg: str): bool:
    if h.err.len() == 0:
        h.err = msg
    end
    ret false
end

// Transcript-hash of everything absorbed so far.
func _hs_transcript(h: Handshake, out &: Buf):
    _bufreset(out)
    _putzeros(out, h.hlen)
    _hash_final(h.tr, out.p)
end

// ---------------------------------------------------------------- schedule

// Derive-Secret(secret, label, transcript) for the current hash.
func _hs_derive(h: Handshake, secret: Buf, label: str, th: Buf, out &: Buf): bool:
    _bufreset(out)
    _putzeros(out, h.hlen)
    ret _derive_secret(h.hash, secret.p, secret.len, label, th.p, th.len, out.p)
end

// RFC 8446 section 7.1. With no PSK the early secret is Extract(0, 0), and the
// binder between stages is Derive-Secret(prev, "derived", "").
func _hs_key_schedule(h &: Handshake): bool:
    mut zeros := _newbuf(h.hlen)
    defer _buf_wipe(zeros)
    _putzeros(zeros, h.hlen)

    mut early := _newbuf(h.hlen)
    defer _buf_wipe(early)
    _putzeros(early, h.hlen)
    _hkdf_extract(h.hash, zeros.p, 0, zeros.p, h.hlen, early.p)

    mut emptyhash := _newbuf(h.hlen)
    defer _buf_free(emptyhash)
    _putzeros(emptyhash, h.hlen)
    _hash_oneshot(h.hash, zeros.p, 0, emptyhash.p)

    mut derived := _newbuf(h.hlen)
    defer _buf_wipe(derived)
    if !_hs_derive(h, early, "derived", emptyhash, derived):
        ret false
    end

    // handshake secret = Extract(derived, ECDHE)
    _bufreset(h.hs_secret)
    _putzeros(h.hs_secret, h.hlen)
    _hkdf_extract(h.hash, derived.p, h.hlen, h.shared.p, h.shared.len, h.hs_secret.p)

    mut th := _newbuf(h.hlen)
    defer _buf_free(th)
    _hs_transcript(h, th)
    if !_hs_derive(h, h.hs_secret, "c hs traffic", th, h.c_hs_secret):
        ret false
    end
    if !_hs_derive(h, h.hs_secret, "s hs traffic", th, h.s_hs_secret):
        ret false
    end

    // master secret = Extract(Derive-Secret(hs, "derived", ""), 0)
    mut derived2 := _newbuf(h.hlen)
    defer _buf_wipe(derived2)
    if !_hs_derive(h, h.hs_secret, "derived", emptyhash, derived2):
        ret false
    end
    _bufreset(h.master)
    _putzeros(h.master, h.hlen)
    _hkdf_extract(h.hash, derived2.p, h.hlen, zeros.p, h.hlen, h.master.p)
    ret true
end

// finished_key = HKDF-Expand-Label(secret, "finished", "", hlen)
// verify_data  = HMAC(finished_key, transcript_hash)
func _hs_finished_mac(h: Handshake, secret: Buf, th: Buf, out &: Buf): bool:
    mut fk := _newbuf(h.hlen)
    defer _buf_wipe(fk)
    _putzeros(fk, h.hlen)
    if !_hkdf_expand_label(h.hash, secret.p, secret.len, "finished", null, 0, fk.p, h.hlen):
        ret false
    end
    _bufreset(out)
    _putzeros(out, h.hlen)
    _hmac(h.hash, fk.p, h.hlen, th.p, th.len, out.p)
    ret true
end

// ---------------------------------------------------------------- ClientHello

func _ext_open(b &: Buf, id: int): int:
    _put16(b, id)
    _put16(b, 0)
    ret b.len
end

func _ext_close(b &: Buf, mark: int):
    _patch16(b, mark - 2, b.len - mark)
end

func _hs_build_client_hello(h &: Handshake, host: str, alpn: str, aes_only: bool, out &: Buf): bool:
    _bufreset(out)
    _put8(out, HS_CLIENT_HELLO)
    lenmark := out.len
    _put24(out, 0)
    body := out.len

    // legacy_version is frozen at TLS 1.2; the real version is in an extension
    _put16(out, TLS12)

    mut rnd := _newbuf(32)
    defer _buf_free(rnd)
    _putzeros(rnd, 32)
    crypto.RandomBytes(rnd.p, 32)
    _putbuf(out, rnd)
    _bufreset(h.crand)
    _putbuf(h.crand, rnd)

    // A non-empty legacy_session_id makes the handshake look like a resumed
    // TLS 1.2 session to middleboxes that would otherwise drop it.
    mut sid := _newbuf(32)
    defer _buf_free(sid)
    _putzeros(sid, 32)
    crypto.RandomBytes(sid.p, 32)
    _put8(out, 32)
    _putbuf(out, sid)

    // ChaCha20-Poly1305 first: it is constant-time by construction, whereas the
    // AES here is table-driven (see aes.salam).
    // Both TLS 1.3 and the ECDHE+AEAD TLS 1.2 suites are offered in one hello;
    // the server picks a version by including or omitting supported_versions.
    if aes_only:
        _put16(out, 6)
        _put16(out, TLS_AES_128_GCM_SHA256)
        _put16(out, TLS12_ECDHE_ECDSA_AES128_GCM_SHA256)
        _put16(out, TLS12_ECDHE_RSA_AES128_GCM_SHA256)
    else:
        _put16(out, 16)
        _put16(out, TLS_CHACHA20_POLY1305_SHA256)
        _put16(out, TLS_AES_128_GCM_SHA256)
        _put16(out, TLS12_ECDHE_ECDSA_CHACHA20_SHA256)
        _put16(out, TLS12_ECDHE_RSA_CHACHA20_SHA256)
        _put16(out, TLS12_ECDHE_ECDSA_AES128_GCM_SHA256)
        _put16(out, TLS12_ECDHE_RSA_AES128_GCM_SHA256)
        _put16(out, TLS12_ECDHE_ECDSA_AES256_GCM_SHA384)
        _put16(out, TLS12_ECDHE_RSA_AES256_GCM_SHA384)
    end

    // legacy_compression_methods: null only
    _put8(out, 1)
    _put8(out, 0)

    extmark := out.len
    _put16(out, 0)
    extstart := out.len

    // server_name
    if host.len() > 0:
        m := _ext_open(out, EXT_SERVER_NAME)
        _put16(out, host.len() + 3)
        _put8(out, 0)
        _put16(out, host.len())
        _putstr(out, host)
        _ext_close(out, m)
    end

    // supported_groups
    m2 := _ext_open(out, EXT_SUPPORTED_GROUPS)
    _put16(out, 6)
    _put16(out, GROUP_X25519)
    _put16(out, GROUP_SECP256R1)
    _put16(out, GROUP_SECP384R1)
    _ext_close(out, m2)

    // signature_algorithms
    m3 := _ext_open(out, EXT_SIGNATURE_ALGORITHMS)
    _put16(out, 12)
    _put16(out, SA_ECDSA_P256_SHA256)
    _put16(out, SA_ECDSA_P384_SHA384)
    _put16(out, SA_RSA_PSS_RSAE_SHA256)
    _put16(out, SA_RSA_PSS_RSAE_SHA384)
    _put16(out, SA_RSA_PKCS1_SHA256)
    _put16(out, SA_RSA_PKCS1_SHA384)
    _ext_close(out, m3)

    // supported_versions: TLS 1.3 only
    m4 := _ext_open(out, EXT_SUPPORTED_VERSIONS)
    _put8(out, 4)
    _put16(out, TLS13)
    _put16(out, TLS12)
    _ext_close(out, m4)

    // TLS 1.2 needs these; TLS 1.3 servers ignore them.
    m7 := _ext_open(out, EXT_EC_POINT_FORMATS)
    _put8(out, 1)
    _put8(out, 0)
    _ext_close(out, m7)

    // RFC 7627. Binds the master secret to the handshake transcript rather
    // than just the two randoms, closing the triple-handshake splice.
    m8 := _ext_open(out, EXT_EXTENDED_MASTER_SECRET)
    _ext_close(out, m8)

    // key_share: a single X25519 share
    _bufreset(h.priv)
    _putzeros(h.priv, 32)
    crypto.RandomBytes(h.priv.p, 32)
    _bufreset(h.pub_key)
    _putzeros(h.pub_key, 32)
    _x25519_base(h.priv.p, h.pub_key.p)
    _bufreset(h.ecpriv)
    _putzeros(h.ecpriv, 32)
    crypto.RandomBytes(h.ecpriv.p, 32)
    mut ecx := _newbuf(32)
    defer _buf_free(ecx)
    _putzeros(ecx, 32)
    mut ecy := _newbuf(32)
    defer _buf_free(ecy)
    _putzeros(ecy, 32)
    _bufreset(h.ecpub)
    if _p256_base_mul(h.ecpriv.p, ecx.p, ecy.p):
        _put8(h.ecpub, 4)
        _putbuf(h.ecpub, ecx)
        _putbuf(h.ecpub, ecy)
    end

    m5 := _ext_open(out, EXT_KEY_SHARE)
    _put16(out, 36)
    _put16(out, GROUP_X25519)
    _put16(out, 32)
    _putbuf(out, h.pub_key)
    _ext_close(out, m5)

    if alpn.len() > 0:
        m6 := _ext_open(out, EXT_ALPN)
        _put16(out, alpn.len() + 1)
        _put8(out, alpn.len())
        _putstr(out, alpn)
        _ext_close(out, m6)
    end

    _patch16(out, extmark, out.len - extstart)
    _patch24(out, lenmark, out.len - body)
    ret true
end

// ---------------------------------------------------------------- ServerHello

func _hs_parse_server_hello(h &: Handshake, msg: Reader): bool:
    mut r := msg
    ver := _rd16(r)
    if ver != TLS12:
        // A server that answers 1.0 or 1.1 is not a version we will ever
        // negotiate, and saying so beats a generic parse error. Those versions
        // offer no AEAD cipher suite at all, so supporting them would mean
        // implementing CBC with MAC-then-encrypt and a constant-time padding
        // check: the Lucky13 surface, plus TLS 1.0's implicit IV (BEAST) and an
        // MD5+SHA-1 PRF. RFC 8996 deprecated both in 2021 and every major
        // browser dropped them in 2020.
        if ver == TLS10 || ver == TLS11:
            ret _hs_fail(h, "server requires TLS 1.0/1.1, which this client does not implement (deprecated by RFC 8996)")
        end
        ret _hs_fail(h, "unexpected legacy_version in ServerHello")
    end
    srand := _rdbytes(r, 32)
    _bufreset(h.srand)
    repeat 32 with i:
        _put8(h.srand, _rdat(srand, i))
    end
    mut hrr := _hexbuf(HRR_RANDOM)
    defer _buf_free(hrr)
    if _cteq(srand.p, hrr.p, 32):
        // A HelloRetryRequest means the server rejected our key share. Handling
        // it properly requires re-sending a ClientHello with a different group,
        // which is not implemented; failing is better than looping.
        ret _hs_fail(h, "server sent HelloRetryRequest (unsupported)")
    end
    sid := _rdvec8(r)
    _rdskip(sid, sid.len)
    suite := _rd16(r)
    comp := _rd8(r)
    if r.bad:
        ret _hs_fail(h, "malformed ServerHello")
    end
    if comp != 0:
        ret _hs_fail(h, "server selected a compression method")
    end
    suite13 := _cipher_from_wire(suite)
    suite12 := _tls12_cipher(suite)
    if suite13 == CIPHER_NONE && suite12 == CIPHER_NONE:
        ret _hs_fail(h, "server selected an unsupported cipher suite")
    end

    mut exts := _rdvec16(r)
    if r.bad:
        ret _hs_fail(h, "malformed ServerHello extensions")
    end
    mut got_version := false
    mut peer := _newreader(null, 0)
    until _rdleft(exts) > 0 && !exts.bad:
        id := _rd16(exts)
        mut body := _rdvec16(exts)
        if exts.bad:
            ret _hs_fail(h, "malformed ServerHello extension")
        end
        if id == EXT_SUPPORTED_VERSIONS:
            v := _rd16(body)
            if body.bad || v != TLS13:
                ret _hs_fail(h, "server selected an unknown version")
            end
            got_version = true
        else if id == EXT_EXTENDED_MASTER_SECRET:
            h.ems = true
        else if id == EXT_KEY_SHARE:
            g := _rd16(body)
            if g != GROUP_X25519:
                ret _hs_fail(h, "server selected a group we did not offer a share for")
            end
            peer = _rdvec16(body)
            if body.bad || peer.len != 32:
                ret _hs_fail(h, "malformed key share")
            end
        end
    end
    // No supported_versions means this is a TLS 1.2 ServerHello. The key
    // exchange then arrives later, in ServerKeyExchange.
    if !got_version:
        if suite12 == CIPHER_NONE:
            ret _hs_fail(h, "server picked a TLS 1.3 suite without selecting TLS 1.3")
        end
        h.ver = TLS12
        h.suite = suite
        h.cipher = suite12
        h.hash = _cipher_hash(h.cipher)
        h.hlen = _hash_size(h.hash)
        ret true
    end
    if suite13 == CIPHER_NONE:
        ret _hs_fail(h, "server picked a TLS 1.2 suite while selecting TLS 1.3")
    end
    h.ver = TLS13
    h.suite = suite
    h.cipher = suite13
    h.hash = _cipher_hash(h.cipher)
    h.hlen = _hash_size(h.hash)
    if peer.len != 32:
        ret _hs_fail(h, "server sent no key share")
    end

    _bufreset(h.shared)
    _putzeros(h.shared, 32)
    if !_x25519_shared(h.priv.p, peer.p, h.shared.p):
        // an all-zero shared secret means a small-order peer key
        ret _hs_fail(h, "peer key share produced a degenerate shared secret")
    end
    ret true
end

// ---------------------------------------------------------------- Certificate

// Read a Certificate message's chain into the handshake buffer.
//
// The two versions differ only at the edges: TLS 1.3 prefixes a
// certificate_request_context and follows each entry with an extensions
// vector, TLS 1.2 has neither. Everything between was duplicated, including
// the depth cap and the offset bookkeeping the verifier later reads.
func _hs_read_cert_list(h &: Handshake, msg: Reader, tls13: bool): bool:
    mut r := msg
    if tls13:
        ctx := _rdvec8(r)
        // a non-empty context only answers a CertificateRequest, which this
        // client never sends
        if r.bad || ctx.len != 0:
            ret _hs_fail(h, "unexpected certificate context")
        end
    end
    mut list := _rdvec24(r)
    if r.bad:
        ret _hs_fail(h, "malformed Certificate message")
    end
    _bufreset(h.certs)
    _bufreset(h.cert_off)
    h.ncerts = 0
    until _rdleft(list) > 0 && !list.bad:
        cert := _rdvec24(list)
        if tls13:
            exts := _rdvec16(list)
            _rdskip(exts, exts.len)
        end
        if list.bad:
            ret _hs_fail(h, "malformed certificate entry")
        end
        // Anything past the depth cap is dropped rather than rejected: a
        // server padding its chain should not cost the caller a connection.
        if h.ncerts < MAX_CHAIN_DEPTH:
            begin := h.certs.len
            repeat cert.len with i:
                _put8(h.certs, _rdat(cert, i))
            end
            _put32(h.cert_off, begin as i64)
            _put32(h.cert_off, cert.len as i64)
            h.ncerts += 1
        end
    end
    if h.ncerts == 0:
        ret _hs_fail(h, "server sent no certificates")
    end
    ret true
end

func _hs_parse_certificate(h &: Handshake, msg: Reader): bool:
    ret _hs_read_cert_list(h, msg, true)
end

// The CertificateVerify signature covers a fixed context string rather than the
// transcript alone. The 64 spaces and the label make a signature produced for
// one role or protocol version unusable in another.
func _hs_cv_content(_h: Handshake, th: Buf, out &: Buf):
    _bufreset(out)
    repeat 64 with _i:
        _put8(out, 0x20)
    end
    _putstr(out, "TLS 1.3, server CertificateVerify")
    _put8(out, 0)
    _putbuf(out, th)
end

func _hs_verify_cert_verify(h &: Handshake, msg: Reader, th: Buf): bool:
    mut r := msg
    scheme := _rd16(r)
    sig := _rdvec16(r)
    if r.bad || _rdleft(r) != 0:
        ret _hs_fail(h, "malformed CertificateVerify")
    end

    mut content := _newbuf(128)
    defer _buf_free(content)
    _hs_cv_content(h, th, content)

    leaf := _cert_parse(_bufptr(h.certs, 0), _cert_len(h, 0))
    if !leaf.ok:
        ret _hs_fail(h, "server leaf certificate did not parse")
    end

    // Same dispatch as the TLS 1.2 ServerKeyExchange check, with PKCS#1 v1.5
    // refused: RFC 8446 4.4.3 allows only PSS for RSA in CertificateVerify.
    if !_tls_verify_leaf_sig(leaf, scheme, content, sig, false):
        ret _hs_fail(h, "CertificateVerify signature invalid")
    end
    ret true
end

func _cert_len(h: Handshake, i: int): int:
    mut l := 0
    repeat 4 with k:
        l = (l << 8) | _bufat(h.cert_off, i * 8 + 4 + k)
    end
    ret l
end

func _cert_start(h: Handshake, i: int): int:
    mut o := 0
    repeat 4 with k:
        o = (o << 8) | _bufat(h.cert_off, i * 8 + k)
    end
    ret o
end
