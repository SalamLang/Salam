package tls

import mem

const KECCAK_RC := [
    0x0000000000000001 as u64, 0x0000000000008082 as u64, 0x800000000000808a as u64, 0x8000000080008000 as u64
    0x000000000000808b as u64, 0x0000000080000001 as u64, 0x8000000080008081 as u64, 0x8000000000008009 as u64
    0x000000000000008a as u64, 0x0000000000000088 as u64, 0x0000000080008009 as u64, 0x000000008000000a as u64
    0x000000008000808b as u64, 0x800000000000008b as u64, 0x8000000000008089 as u64, 0x8000000000008003 as u64
    0x8000000000008002 as u64, 0x8000000000000080 as u64, 0x000000000000800a as u64, 0x800000008000000a as u64
    0x8000000080008081 as u64, 0x8000000000008080 as u64, 0x0000000080000001 as u64, 0x8000000080008008 as u64
]

const KECCAK_ROT := [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44]

const KECCAK_PI := [10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1]

struct _Sponge:
    pub st: u64* = null
    pub rate: int = 0
    pub pos: int = 0
    pub ds: int = 0
end

inline func _rotl64(x: u64, n: int): u64:
    ret (x << (n as u64)) | (x >> ((64 - n) as u64))
end

func _keccak_f(st: u64*):
    bc := mem.AllocateZeroed(40 as u64) as u64*
    repeat 24 in r:
        repeat 5 in i:
            bc[i] = st[i] ^ st[i + 5] ^ st[i + 10] ^ st[i + 15] ^ st[i + 20]
        end
        repeat 5 in i:
            t := bc[(i + 4) % 5] ^ _rotl64(bc[(i + 1) % 5], 1)
            repeat 5 in j:
                st[j * 5 + i] ^= t
            end
        end
        mut t := st[1]
        repeat 24 in i:
            j := KECCAK_PI[i]
            bc[0] = st[j]
            st[j] = _rotl64(t, KECCAK_ROT[i])
            t = bc[0]
        end
        repeat 5 in j:
            repeat 5 in i:
                bc[i] = st[j * 5 + i]
            end
            repeat 5 in i:
                st[j * 5 + i] ^= (~bc[(i + 1) % 5]) & bc[(i + 2) % 5]
            end
        end
        st[0] ^= KECCAK_RC[r]
    end
    mem.Free(bc as void*)
end

func _sp_new(rate: int, ds: int): _Sponge:
    ret _Sponge { st = mem.AllocateZeroed(200 as u64) as u64*, rate = rate, pos = 0, ds = ds }
end

func _sp_free(s &: _Sponge):
    mem.Free(s.st as void*)
    s.st = null
end

func _sp_xor(s: _Sponge, i: int, b: int):
    s.st[i >> 3] ^= (b as u64) << ((8 * (i & 7)) as u64)
end

func _sp_absorb(s &: _Sponge, p: void*, n: int):
    bp := p as u8*
    repeat n in i:
        _sp_xor(s, s.pos, bp[i] as int)
        s.pos++
        if s.pos == s.rate:
            _keccak_f(s.st)
            s.pos = 0
        end
    end
end

func _sp_finish(s &: _Sponge):
    _sp_xor(s, s.pos, s.ds)
    _sp_xor(s, s.rate - 1, 0x80)
    _keccak_f(s.st)
    s.pos = 0
end

func _sp_squeeze(s &: _Sponge, out: void*, n: int):
    op := out as u8*
    repeat n in i:
        if s.pos == s.rate:
            _keccak_f(s.st)
            s.pos = 0
        end
        op[i] = ((s.st[s.pos >> 3] >> ((8 * (s.pos & 7)) as u64)) & (0xFF as u64)) as u8
        s.pos++
    end
end

func _sha3_256(data: void*, n: int, out: void*):
    mut s := _sp_new(136, 0x06)
    _sp_absorb(s, data, n)
    _sp_finish(s)
    _sp_squeeze(s, out, 32)
    _sp_free(s)
end

func _sha3_512(data: void*, n: int, out: void*):
    mut s := _sp_new(72, 0x06)
    _sp_absorb(s, data, n)
    _sp_finish(s)
    _sp_squeeze(s, out, 64)
    _sp_free(s)
end

func _shake256(data: void*, n: int, out: void*, outlen: int):
    mut s := _sp_new(136, 0x1F)
    _sp_absorb(s, data, n)
    _sp_finish(s)
    _sp_squeeze(s, out, outlen)
    _sp_free(s)
end

@en "Sha3256"
@fa "شا۳۲۵۶"
pub func Sha3256(data: void*, n: int, out: void*):
    _sha3_256(data, n, out)
end

@en "Sha3512"
@fa "شا۳۵۱۲"
pub func Sha3512(data: void*, n: int, out: void*):
    _sha3_512(data, n, out)
end

@en "Shake128"
@fa "شیک۱۲۸"
pub func Shake128(data: void*, n: int, out: void*, outlen: int):
    mut s := _sp_new(168, 0x1F)
    _sp_absorb(s, data, n)
    _sp_finish(s)
    _sp_squeeze(s, out, outlen)
    _sp_free(s)
end

@en "Shake256"
@fa "شیک۲۵۶"
pub func Shake256(data: void*, n: int, out: void*, outlen: int):
    _shake256(data, n, out, outlen)
end
