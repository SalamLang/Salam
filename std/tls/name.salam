package tls

// Matching a certificate against the identity a caller asked for:
// RFC 6125 hostname rules and iPAddress SANs. Kept separate from
// parsing because this is where name-confusion bugs live.


// A parsed IPv4 literal. IPv6 is deliberately not handled: matching it
// correctly means canonicalising the many textual forms of the same address
// before comparing, and getting that subtly wrong is a name-confusion bug.
// An IPv6 literal simply fails to match rather than matching loosely.
struct Ip4:
    pub ok: bool = false
    pub b: int[4] = [0, 0, 0, 0]
end

// ---------------------------------------------------------------- hostname

// Case-insensitive ASCII compare. Host names are ASCII here; a caller handing
// in a Unicode name is expected to have already applied IDNA.
func _ascii_eqfold(a: str, b: str): bool:
    if a.len() != b.len():
        ret false
    end
    ap := a as void*
    bp := b as void*
    repeat a.len() with i:
        mut x := _bget(ap, i)
        mut y := _bget(bp, i)
        if x >= 65 && x <= 90:
            x += 32
        end
        if y >= 65 && y <= 90:
            y += 32
        end
        if x != y:
            ret false
        end
    end
    ret true
end

// RFC 6125 wildcard matching, deliberately restrictive:
//   * the wildcard must be the entire leftmost label ("*.example.com"), so
//     "w*.example.com" and "*w.example.com" do not match;
//   * it matches exactly one label, never a dot;
//   * it never matches a bare "*" or a two-label name like "*.com".
//
// Written against byte offsets rather than str.substr: substr allocates a
// fresh string per call and Salam has no collector, so the previous
// character-by-character form leaked one allocation per byte of every hostname
// checked, on every connection.
inline func _sbyte(s: str, i: int): int:
    ret _bget(s as void*, i)
end

inline func _lowerb(c: int): int:
    if c >= 65 && c <= 90:
        ret c + 32
    end
    ret c
end

func _host_match(pattern: str, host: str): bool:
    plen := pattern.len()
    hlen := host.len()
    if plen == 0 || hlen == 0:
        ret false
    end
    // 42 is '*', 46 is '.'
    if _sbyte(pattern, 0) != 42:
        ret _ascii_eqfold(pattern, host)
    end
    if plen < 3 || _sbyte(pattern, 1) != 46:
        ret false
    end

    // the part after the wildcard must still hold at least two labels, which
    // is what stops "*.com" matching every domain in a TLD
    mut dots := 0
    mut i := 1
    until i < plen:
        if _sbyte(pattern, i) == 46:
            dots += 1
        end
        i += 1
    end
    if dots < 2:
        ret false
    end

    // the wildcard covers exactly the first label of the host
    mut dot := 0 - 1
    mut j := 0
    until j < hlen:
        if _sbyte(host, j) == 46:
            dot = j
            j = hlen
        else:
            j += 1
        end
    end
    if dot < 0:
        ret false
    end
    if hlen - dot != plen - 1:
        ret false
    end
    mut k := 0
    until k < plen - 1:
        if _lowerb(_sbyte(pattern, 1 + k)) != _lowerb(_sbyte(host, dot + k)):
            ret false
        end
        k += 1
    end
    ret true
end

// Parse a dotted-quad. Strict: no leading zeros beyond a single digit, no
// octal or hex forms, no fewer or more than four parts. Loose IP parsing is a
// classic source of SSRF and name-confusion bugs, and nothing here needs it.
func _parse_ip4(s: str): Ip4:
    mut r := Ip4 {}
    n := s.len()
    if n < 7 || n > 15:
        ret r
    end
    mut parts := 0
    mut val := 0
    mut digits := 0
    mut i := 0
    until i < n:
        c := _sbyte(s, i)
        if c >= 48 && c <= 57:
            if digits == 1 && val == 0:
                // a leading zero would let "0177.0.0.1" style forms through
                ret r
            end
            val = val * 10 + (c - 48)
            digits += 1
            if digits > 3 || val > 255:
                ret r
            end
        else if c == 46:
            if digits == 0 || parts >= 3:
                ret r
            end
            r.b[parts] = val
            parts += 1
            val = 0
            digits = 0
        else:
            ret r
        end
        i += 1
    end
    if digits == 0 || parts != 3:
        ret r
    end
    r.b[3] = val
    r.ok = true
    ret r
end

// Match `host` against the certificate's SubjectAltName dNSName entries.
// CN is never consulted: RFC 6125 deprecated CN matching, and honouring it
// lets a certificate assert a name its issuer never placed in a SAN.
func _cert_match_host(c: Cert, host: str): bool:
    if !c.has_san:
        ret false
    end
    ipa := _parse_ip4(host)
    mut s := c.san
    mut seq := _der_seq(s)
    if s.bad:
        ret false
    end
    until _rdleft(seq) > 0 && !seq.bad:
        t := _der(seq)
        if !t.ok:
            ret false
        end
        // dNSName is [2] IMPLICIT IA5String -> primitive context tag 0x82
        if t.tag == 0x82:
            // An IP literal must never be satisfied by a dNSName entry, even
            // one spelled identically: RFC 6125 matches addresses only against
            // iPAddress.
            if !ipa.ok:
                name := _rd_to_str(t.body)
                if name.len() > 0:
                    if _host_match(name, host):
                        ret true
                    end
                end
            end
        end
        // iPAddress is [7] IMPLICIT OCTET STRING -> primitive context tag 0x87,
        // 4 octets for IPv4 and 16 for IPv6, in network byte order.
        if t.tag == 0x87:
            if ipa.ok && t.body.len == 4:
                mut same := true
                repeat 4 with k:
                    if _rdat(t.body, k) != ipa.b[k]:
                        same = false
                    end
                end
                if same:
                    ret true
                end
            end
        end
    end
    ret false
end
