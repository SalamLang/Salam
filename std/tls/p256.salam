package tls

// NIST P-256 (secp256r1) parameters.
//
// The arithmetic lives in ec.salam; this file only supplies the constants and
// assembles the Curve descriptor. Values are in Montgomery form where the
// arithmetic expects it (one, b, gx, gy), computed once against R = 2^256.
//
// p == -1 mod 2^32, so the field-side Montgomery factor n0inv is simply 1.

const P256_SIZE := 32

// p = 2^256 - 2^224 + 2^192 + 2^96 - 1, little-endian limbs
const P256_P := [
    0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32, 0x00000000 as u32
    0x00000000 as u32, 0x00000000 as u32, 0x00000001 as u32, 0xffffffff as u32
] as u32[8]

const P256_N := [
    0xfc632551 as u32, 0xf3b9cac2 as u32, 0xa7179e84 as u32, 0xbce6faad as u32
    0xffffffff as u32, 0xffffffff as u32, 0x00000000 as u32, 0xffffffff as u32
] as u32[8]

const P256_R2 := [
    0x00000003 as u32, 0x00000000 as u32, 0xffffffff as u32, 0xfffffffb as u32
    0xfffffffe as u32, 0xffffffff as u32, 0xfffffffd as u32, 0x00000004 as u32
] as u32[8]

const P256_R2N := [
    0xbe79eea2 as u32, 0x83244c95 as u32, 0x49bd6fa6 as u32, 0x4699799c as u32
    0x2b6bec59 as u32, 0x2845b239 as u32, 0xf3d95620 as u32, 0x66e12d94 as u32
] as u32[8]

const P256_ONE_MONT := [
    0x00000001 as u32, 0x00000000 as u32, 0x00000000 as u32, 0xffffffff as u32
    0xffffffff as u32, 0xffffffff as u32, 0xfffffffe as u32, 0x00000000 as u32
] as u32[8]

const P256_B_MONT := [
    0x29c4bddf as u32, 0xd89cdf62 as u32, 0x78843090 as u32, 0xacf005cd as u32
    0xf7212ed6 as u32, 0xe5a220ab as u32, 0x04874834 as u32, 0xdc30061d as u32
] as u32[8]

const P256_GX_MONT := [
    0x18a9143c as u32, 0x79e730d4 as u32, 0x5fedb601 as u32, 0x75ba95fc as u32
    0x77622510 as u32, 0x79fb732b as u32, 0xa53755c6 as u32, 0x18905f76 as u32
] as u32[8]

const P256_GY_MONT := [
    0xce95560a as u32, 0xddf25357 as u32, 0xba19e45c as u32, 0x8b4ab8e4 as u32
    0xdd21f325 as u32, 0xd2e88688 as u32, 0x25885d85 as u32, 0x8571ff18 as u32
] as u32[8]

// -n^-1 mod 2^32 for the group order
const P256_N0INV := 0xee00bc4f as u32

func _curve_p256(): Curve:
    mut c := Curve {}
    c.nl = 8
    c.nb = P256_SIZE
    repeat 8 with i:
        c.p[i] = P256_P[i]
        c.n[i] = P256_N[i]
        c.r2p[i] = P256_R2[i]
        c.r2n[i] = P256_R2N[i]
        c.one[i] = P256_ONE_MONT[i]
        c.b[i] = P256_B_MONT[i]
        c.gx[i] = P256_GX_MONT[i]
        c.gy[i] = P256_GY_MONT[i]
    end
    c.n0p = 1 as u32
    c.n0n = P256_N0INV
    ret c
end
