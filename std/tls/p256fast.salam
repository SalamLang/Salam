    d0 := t0 - (0xfc632551 as u64) - bw
    bw = (d0 >> (32 as u64)) & (1 as u64)
    d1 := t1 - (0xf3b9cac2 as u64) - bw
    bw = (d1 >> (32 as u64)) & (1 as u64)
    d2 := t2 - (0xa7179e84 as u64) - bw
    bw = (d2 >> (32 as u64)) & (1 as u64)
    d3 := t3 - (0xbce6faad as u64) - bw
    bw = (d3 >> (32 as u64)) & (1 as u64)
    d4 := t4 - (0xffffffff as u64) - bw
    bw = (d4 >> (32 as u64)) & (1 as u64)
    d5 := t5 - (0xffffffff as u64) - bw
