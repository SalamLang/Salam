    t7 = s & PF_M
    c = s >> (32 as u64)
    t8 += c
    c = (t0 * (0xee00bc4f as u64)) & PF_M
    s = t0 + c * (0xfc632551 as u64)
    s >>= (32 as u64)
    s += t1 + c * (0xf3b9cac2 as u64)
    t0 = s & PF_M
    s >>= (32 as u64)
    s += t2 + c * (0xa7179e84 as u64)
    t1 = s & PF_M
    s >>= (32 as u64)
    s += t3 + c * (0xbce6faad as u64)
    t2 = s & PF_M
    s >>= (32 as u64)
    s += t4 + c * (0xffffffff as u64)
