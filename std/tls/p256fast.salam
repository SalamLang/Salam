    s = t0 + a7 * b0 + c
    t0 = s & PF_M
    c = s >> (32 as u64)
    s = t1 + a7 * b1 + c
    t1 = s & PF_M
    c = s >> (32 as u64)
    s = t2 + a7 * b2 + c
    t2 = s & PF_M
    c = s >> (32 as u64)
