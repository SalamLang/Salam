    r.a6 = ((d6 & mask) | (t6 & ~mask)) as u32
    r.a7 = ((d7 & mask) | (t7 & ~mask)) as u32
end

func _pf_add(r &: F8, a &: F8, b &: F8):
    mut s := 0 as u64
    s = (a.a0 as u64) + (b.a0 as u64) + (s >> (32 as u64))
    t0 := s & PF_M
    s = (a.a1 as u64) + (b.a1 as u64) + (s >> (32 as u64))
    t1 := s & PF_M
    s = (a.a2 as u64) + (b.a2 as u64) + (s >> (32 as u64))
    t2 := s & PF_M
    s = (a.a3 as u64) + (b.a3 as u64) + (s >> (32 as u64))
    t3 := s & PF_M
    s = (a.a4 as u64) + (b.a4 as u64) + (s >> (32 as u64))
    t4 := s & PF_M
    s = (a.a5 as u64) + (b.a5 as u64) + (s >> (32 as u64))
    t5 := s & PF_M
    s = (a.a6 as u64) + (b.a6 as u64) + (s >> (32 as u64))
    t6 := s & PF_M
    s = (a.a7 as u64) + (b.a7 as u64) + (s >> (32 as u64))
    t7 := s & PF_M
    t8 := s >> (32 as u64)
    mut bw := 0 as u64
    d0 := t0 - (0xffffffff as u64) - bw
    bw = (d0 >> (32 as u64)) & (1 as u64)
    d1 := t1 - (0xffffffff as u64) - bw
    bw = (d1 >> (32 as u64)) & (1 as u64)
    d2 := t2 - (0xffffffff as u64) - bw
    bw = (d2 >> (32 as u64)) & (1 as u64)
    d3 := t3 - (0x0 as u64) - bw
    bw = (d3 >> (32 as u64)) & (1 as u64)
    d4 := t4 - (0x0 as u64) - bw
    bw = (d4 >> (32 as u64)) & (1 as u64)
    d5 := t5 - (0x0 as u64) - bw
    bw = (d5 >> (32 as u64)) & (1 as u64)
    d6 := t6 - (0x1 as u64) - bw
    bw = (d6 >> (32 as u64)) & (1 as u64)
    d7 := t7 - (0xffffffff as u64) - bw
    bw = (d7 >> (32 as u64)) & (1 as u64)
    mask := (0 as u64) - ((t8 | (bw ^ (1 as u64))) & (1 as u64))
    r.a0 = ((d0 & mask) | (t0 & ~mask)) as u32
    r.a1 = ((d1 & mask) | (t1 & ~mask)) as u32
    r.a2 = ((d2 & mask) | (t2 & ~mask)) as u32
    r.a3 = ((d3 & mask) | (t3 & ~mask)) as u32
    r.a4 = ((d4 & mask) | (t4 & ~mask)) as u32
    r.a5 = ((d5 & mask) | (t5 & ~mask)) as u32
    r.a6 = ((d6 & mask) | (t6 & ~mask)) as u32
    r.a7 = ((d7 & mask) | (t7 & ~mask)) as u32
end

func _pf_sub(r &: F8, a &: F8, b &: F8):
    mut bw := 0 as u64
    t0 := (a.a0 as u64) - (b.a0 as u64) - bw
    bw = (t0 >> (32 as u64)) & (1 as u64)
    t1 := (a.a1 as u64) - (b.a1 as u64) - bw
    bw = (t1 >> (32 as u64)) & (1 as u64)
    t2 := (a.a2 as u64) - (b.a2 as u64) - bw
    bw = (t2 >> (32 as u64)) & (1 as u64)
    t3 := (a.a3 as u64) - (b.a3 as u64) - bw
    bw = (t3 >> (32 as u64)) & (1 as u64)
    t4 := (a.a4 as u64) - (b.a4 as u64) - bw
    bw = (t4 >> (32 as u64)) & (1 as u64)
    t5 := (a.a5 as u64) - (b.a5 as u64) - bw
    bw = (t5 >> (32 as u64)) & (1 as u64)
    t6 := (a.a6 as u64) - (b.a6 as u64) - bw
    bw = (t6 >> (32 as u64)) & (1 as u64)
    t7 := (a.a7 as u64) - (b.a7 as u64) - bw
    bw = (t7 >> (32 as u64)) & (1 as u64)
    mask := (0 as u64) - bw
    mut c := 0 as u64
    c = (t0 & PF_M) + ((0xffffffff as u64) & mask) + (c >> (32 as u64))
    r.a0 = c as u32
    c = (t1 & PF_M) + ((0xffffffff as u64) & mask) + (c >> (32 as u64))
    r.a1 = c as u32
    c = (t2 & PF_M) + ((0xffffffff as u64) & mask) + (c >> (32 as u64))
    r.a2 = c as u32
    c = (t3 & PF_M) + ((0x0 as u64) & mask) + (c >> (32 as u64))
    r.a3 = c as u32
    c = (t4 & PF_M) + ((0x0 as u64) & mask) + (c >> (32 as u64))
    r.a4 = c as u32
    c = (t5 & PF_M) + ((0x0 as u64) & mask) + (c >> (32 as u64))
    r.a5 = c as u32
    c = (t6 & PF_M) + ((0x1 as u64) & mask) + (c >> (32 as u64))
    r.a6 = c as u32
    c = (t7 & PF_M) + ((0xffffffff as u64) & mask) + (c >> (32 as u64))
    r.a7 = c as u32
end

inline func _pf_cmov(r &: F8, a &: F8, mask: u32):
    r.a0 = (r.a0 & ~mask) | (a.a0 & mask)
    r.a1 = (r.a1 & ~mask) | (a.a1 & mask)
    r.a2 = (r.a2 & ~mask) | (a.a2 & mask)
    r.a3 = (r.a3 & ~mask) | (a.a3 & mask)
    r.a4 = (r.a4 & ~mask) | (a.a4 & mask)
    r.a5 = (r.a5 & ~mask) | (a.a5 & mask)
    r.a6 = (r.a6 & ~mask) | (a.a6 & mask)
    r.a7 = (r.a7 & ~mask) | (a.a7 & mask)
end

inline func _pf_load(r &: F8, p: u32*, off: int):
    r.a0 = p[off + 0]
    r.a1 = p[off + 1]
    r.a2 = p[off + 2]
    r.a3 = p[off + 3]
    r.a4 = p[off + 4]
    r.a5 = p[off + 5]
    r.a6 = p[off + 6]
    r.a7 = p[off + 7]
end

inline func _pf_store(p: u32*, off: int, a &: F8):
    p[off + 0] = a.a0
    p[off + 1] = a.a1
    p[off + 2] = a.a2
    p[off + 3] = a.a3
    p[off + 4] = a.a4
    p[off + 5] = a.a5
    p[off + 6] = a.a6
    p[off + 7] = a.a7
end

inline func _pf_or_mask_load(r &: F8, p: u32*, off: int, mask: u32):
    r.a0 |= (p[off + 0] & mask)
    r.a1 |= (p[off + 1] & mask)
    r.a2 |= (p[off + 2] & mask)
    r.a3 |= (p[off + 3] & mask)
    r.a4 |= (p[off + 4] & mask)
    r.a5 |= (p[off + 5] & mask)
    r.a6 |= (p[off + 6] & mask)
    r.a7 |= (p[off + 7] & mask)
end

inline func _pf_iszero_mask(a &: F8): u32:
    x := a.a0 | a.a1 | a.a2 | a.a3 | a.a4 | a.a5 | a.a6 | a.a7
    ret (0 as u32) - ((((x as u64) - (1 as u64)) >> (63 as u64)) as u32)
end

func _pf_from_fe(r &: F8, f: Fe):
    r.a0 = f.v[0]
    r.a1 = f.v[1]
    r.a2 = f.v[2]
    r.a3 = f.v[3]
    r.a4 = f.v[4]
    r.a5 = f.v[5]
    r.a6 = f.v[6]
    r.a7 = f.v[7]
end

func _pf_to_fe(a &: F8, f &: Fe):
    f.v[0] = a.a0
    f.v[1] = a.a1
    f.v[2] = a.a2
    f.v[3] = a.a3
    f.v[4] = a.a4
    f.v[5] = a.a5
    f.v[6] = a.a6
    f.v[7] = a.a7
end

func _pf_one(): F8:
    mut f := F8 {}
    f.a0 = 1 as u32
    f.a3 = 0xffffffff as u32
    f.a4 = 0xffffffff as u32
    f.a5 = 0xffffffff as u32
    f.a6 = 0xfffffffe as u32
    ret f
end

func _pf_sqn(r &: F8, a &: F8, n: int):
    _pf_mul(r, a, a)
    repeat n - 1:
        _pf_mul(r, r, r)
    end
end

func _pf_inv(r &: F8, a &: F8):
    mut x2 := F8 {}
    _pf_mul(x2, a, a)
    _pf_mul(x2, x2, a)
    mut x3 := F8 {}
    _pf_mul(x3, x2, x2)
    _pf_mul(x3, x3, a)
    mut x6 := F8 {}
    _pf_sqn(x6, x3, 3)
    _pf_mul(x6, x6, x3)
    mut x12 := F8 {}
    _pf_sqn(x12, x6, 6)
    _pf_mul(x12, x12, x6)
    mut x15 := F8 {}
    _pf_sqn(x15, x12, 3)
    _pf_mul(x15, x15, x3)
    mut x30 := F8 {}
    _pf_sqn(x30, x15, 15)
    _pf_mul(x30, x30, x15)
    mut x32 := F8 {}
    _pf_sqn(x32, x30, 2)
    _pf_mul(x32, x32, x2)
    mut t := F8 {}
    _pf_sqn(t, x32, 32)
    _pf_mul(t, t, a)
    _pf_sqn(t, t, 128)
    _pf_mul(t, t, x32)
    _pf_sqn(t, t, 32)
    _pf_mul(t, t, x32)
    _pf_sqn(t, t, 30)
    _pf_mul(t, t, x30)
    _pf_sqn(t, t, 2)
    _pf_mul(r, t, a)
end

func _pfn_inv(r &: F8, a &: F8):
    tab := mem.Allocate((PF_ENTRIES * 32) as u64) as u32*
    _pf_store(tab, 0, a)
    mut t := F8 {}
    t = a
    mut i := 1
    until i < PF_ENTRIES:
        _pfn_mul(t, t, a)
        _pf_store(tab, i * 8, t)
        i++
    end
    mut started := false
    mut w := 63
    until w >= 0:
        limb := P256_N[w / 8]
        mut digit := ((limb >> ((4 * (w % 8)) as u32)) & (15 as u32)) as int
        if w == 1:
            digit--
        else w == 0:
            digit = (digit + 16 - 2) & 15
        end
        if started:
            _pfn_mul(t, t, t)
            _pfn_mul(t, t, t)
            _pfn_mul(t, t, t)
            _pfn_mul(t, t, t)
        end
        if digit != 0:
            mut e := F8 {}
            _pf_load(e, tab, (digit - 1) * 8)
            if started:
                _pfn_mul(t, t, e)
            else:
                t = e
                started = true
            end
        end
        w--
    end
    r = t
    _wipe(tab as void*, PF_ENTRIES * 32)
    mem.Free(tab as void*)
end

func _pf_double(r &: J8, p &: J8):
    mut delta := F8 {}
    _pf_mul(delta, p.z, p.z)
    mut gamma := F8 {}
    _pf_mul(gamma, p.y, p.y)
    mut beta := F8 {}
    _pf_mul(beta, p.x, gamma)
    mut t1 := F8 {}
    _pf_sub(t1, p.x, delta)
    mut t2 := F8 {}
    _pf_add(t2, p.x, delta)
    mut t3 := F8 {}
    _pf_mul(t3, t1, t2)
    mut alpha := F8 {}
    _pf_add(alpha, t3, t3)
    _pf_add(alpha, alpha, t3)
    mut b4 := F8 {}
    _pf_add(b4, beta, beta)
    _pf_add(b4, b4, b4)
    mut b8 := F8 {}
    _pf_add(b8, b4, b4)
    mut x3 := F8 {}
    _pf_mul(x3, alpha, alpha)
    _pf_sub(x3, x3, b8)
    mut z3 := F8 {}
    _pf_add(z3, p.y, p.z)
    _pf_mul(z3, z3, z3)
    _pf_sub(z3, z3, gamma)
    _pf_sub(z3, z3, delta)
    mut y3 := F8 {}
    _pf_sub(b4, b4, x3)
    _pf_mul(y3, alpha, b4)
    mut g2 := F8 {}
    _pf_mul(g2, gamma, gamma)
    _pf_add(g2, g2, g2)
    _pf_add(g2, g2, g2)
    _pf_add(g2, g2, g2)
    _pf_sub(r.y, y3, g2)
    r.x = x3
    r.z = z3
end

func _pf_madd(r &: J8, p &: J8, x2 &: F8, y2 &: F8):
    mut z1z1 := F8 {}
    _pf_mul(z1z1, p.z, p.z)
    mut u2 := F8 {}
    _pf_mul(u2, x2, z1z1)
    mut s2 := F8 {}
    _pf_mul(s2, y2, p.z)
    _pf_mul(s2, s2, z1z1)
    mut h := F8 {}
    _pf_sub(h, u2, p.x)
    mut hh := F8 {}
    _pf_mul(hh, h, h)
    mut i := F8 {}
    _pf_add(i, hh, hh)
    _pf_add(i, i, i)
    mut j := F8 {}
    _pf_mul(j, h, i)
    mut rr := F8 {}
    _pf_sub(rr, s2, p.y)
    _pf_add(rr, rr, rr)
    mut v := F8 {}
    _pf_mul(v, p.x, i)
    mut x3 := F8 {}
    _pf_mul(x3, rr, rr)
    _pf_sub(x3, x3, j)
    _pf_sub(x3, x3, v)
    _pf_sub(x3, x3, v)
    mut y3 := F8 {}
    _pf_sub(y3, v, x3)
    _pf_mul(y3, rr, y3)
    mut yj := F8 {}
    _pf_mul(yj, p.y, j)
    _pf_add(yj, yj, yj)
    _pf_sub(y3, y3, yj)
    mut z3 := F8 {}
    _pf_add(z3, p.z, h)
    _pf_mul(z3, z3, z3)
    _pf_sub(z3, z3, z1z1)
    _pf_sub(r.z, z3, hh)
    r.x = x3
    r.y = y3
end

func _pf_jadd(r &: J8, p &: J8, q &: J8):
    mut z1z1 := F8 {}
    _pf_mul(z1z1, p.z, p.z)
    mut z2z2 := F8 {}
    _pf_mul(z2z2, q.z, q.z)
    mut u1 := F8 {}
    _pf_mul(u1, p.x, z2z2)
    mut u2 := F8 {}
    _pf_mul(u2, q.x, z1z1)
    mut s1 := F8 {}
    _pf_mul(s1, p.y, q.z)
    _pf_mul(s1, s1, z2z2)
    mut s2 := F8 {}
    _pf_mul(s2, q.y, p.z)
    _pf_mul(s2, s2, z1z1)
    mut h := F8 {}
    _pf_sub(h, u2, u1)
    mut i := F8 {}
    _pf_add(i, h, h)
    _pf_mul(i, i, i)
    mut j := F8 {}
    _pf_mul(j, h, i)
    mut rr := F8 {}
    _pf_sub(rr, s2, s1)
    _pf_add(rr, rr, rr)
    mut v := F8 {}
    _pf_mul(v, u1, i)
    mut x3 := F8 {}
    _pf_mul(x3, rr, rr)
    _pf_sub(x3, x3, j)
    _pf_sub(x3, x3, v)
    _pf_sub(x3, x3, v)
    mut y3 := F8 {}
    _pf_sub(y3, v, x3)
    _pf_mul(y3, rr, y3)
    mut sj := F8 {}
    _pf_mul(sj, s1, j)
    _pf_add(sj, sj, sj)
    _pf_sub(y3, y3, sj)
    mut z3 := F8 {}
    _pf_add(z3, p.z, q.z)
    _pf_mul(z3, z3, z3)
    _pf_sub(z3, z3, z1z1)
    _pf_sub(z3, z3, z2z2)
    _pf_mul(r.z, z3, h)
    r.x = x3
    r.y = y3
end

inline func _pfj_load(r &: J8, p: u32*, off: int):
    _pf_load(r.x, p, off)
    _pf_load(r.y, p, off + 8)
    _pf_load(r.z, p, off + 16)
end

inline func _pfj_store(p: u32*, off: int, a &: J8):
    _pf_store(p, off, a.x)
    _pf_store(p, off + 8, a.y)
    _pf_store(p, off + 16, a.z)
end

func _pf_table_build():
    count := PF_WINDOWS * PF_ENTRIES
    jac := mem.Allocate((count * 96) as u64) as u32*
    prod := mem.Allocate((count * 32) as u64) as u32*
    tab := mem.Allocate((count * 64) as u64) as u32*
    mut base := J8 {}
    _pf_from_fe(base.x, _fe_from(_curve_p256().gx, 8))
    _pf_from_fe(base.y, _fe_from(_curve_p256().gy, 8))
    base.z = _pf_one()
    repeat PF_WINDOWS in w:
        row := w * PF_ENTRIES
        _pfj_store(jac, row * 24, base)
        mut d := 2
        until d <= PF_ENTRIES:
            mut e := J8 {}
            if d % 2 == 0:
                mut half := J8 {}
                _pfj_load(half, jac, (row + d / 2 - 1) * 24)
                _pf_double(e, half)
            else:
                mut prev := J8 {}
                _pfj_load(prev, jac, (row + d - 2) * 24)
                _pf_jadd(e, prev, base)
            end
            _pfj_store(jac, (row + d - 1) * 24, e)
            d++
        end
        repeat 4:
            _pf_double(base, base)
        end
    end
    mut acc := _pf_one()
    repeat count in i:
        mut z := F8 {}
        _pf_load(z, jac, i * 24 + 16)
        _pf_store(prod, i * 8, acc)
        _pf_mul(acc, acc, z)
    end
    mut inv := F8 {}
    _pf_inv(inv, acc)
    mut i := count - 1
    until i >= 0:
        mut z := F8 {}
        _pf_load(z, jac, i * 24 + 16)
        mut before := F8 {}
        _pf_load(before, prod, i * 8)
        mut zi := F8 {}
        _pf_mul(zi, inv, before)
        _pf_mul(inv, inv, z)
        mut zi2 := F8 {}
        _pf_mul(zi2, zi, zi)
        mut x := F8 {}
        _pf_load(x, jac, i * 24)
        _pf_mul(x, x, zi2)
        mut y := F8 {}
        _pf_load(y, jac, i * 24 + 8)
        _pf_mul(zi2, zi2, zi)
        _pf_mul(y, y, zi2)
        _pf_store(tab, i * PF_ENTRY_WORDS, x)
        _pf_store(tab, i * PF_ENTRY_WORDS + 8, y)
        i--
    end
    mem.Free(jac as void*)
    mem.Free(prod as void*)
    _pf_tab = tab
end

func _pf_table(): u32*:
    sync.Lock(_pf_tab_mu)
    if _pf_tab == null:
        _pf_table_build()
    end
    t := _pf_tab
    sync.Unlock(_pf_tab_mu)
    ret t
end

inline func _pf_digit(k: Fe, w: int): int:
    ret ((k.v[w / 8] >> ((4 * (w % 8)) as u32)) & (15 as u32)) as int
end

inline func _pf_eq_mask(a: int, b: int): u32:
    x := (a ^ b) as u32
    ret (0 as u32) - ((((x as u64) - (1 as u64)) >> (63 as u64)) as u32)
end

func _pf_base_mul(k: Fe, out &: J8):
    tab := _pf_table()
    mut one := _pf_one()
    mut acc := J8 {}
    acc.x = one
    acc.y = one
    repeat PF_WINDOWS in w:
        d := _pf_digit(k, w)
        mut x := F8 {}
        mut y := F8 {}
        row := w * PF_ENTRIES
        repeat PF_ENTRIES in e:
            mask := _pf_eq_mask(d, e + 1)
            off := (row + e) * PF_ENTRY_WORDS
            _pf_or_mask_load(x, tab, off, mask)
            _pf_or_mask_load(y, tab, off + 8, mask)
        end
        mut sum := J8 {}
        _pf_madd(sum, acc, x, y)
        inf := _pf_iszero_mask(acc.z)
        _pf_cmov(sum.x, x, inf)
        _pf_cmov(sum.y, y, inf)
        _pf_cmov(sum.z, one, inf)
        keep := _pf_eq_mask(d, 0)
        _pf_cmov(sum.x, acc.x, keep)
        _pf_cmov(sum.y, acc.y, keep)
        _pf_cmov(sum.z, acc.z, keep)
        acc = sum
    end
    out = acc
end

func _pf_point_mul(k: Fe, p &: J8, out &: J8):
    tab := mem.Allocate((PF_ENTRIES * 96) as u64) as u32*
    _pfj_store(tab, 0, p)
    mut d := 2
    until d <= PF_ENTRIES:
        mut e := J8 {}
        if d % 2 == 0:
            mut half := J8 {}
            _pfj_load(half, tab, (d / 2 - 1) * 24)
            _pf_double(e, half)
        else:
            mut prev := J8 {}
            _pfj_load(prev, tab, (d - 2) * 24)
            _pf_jadd(e, prev, p)
        end
        _pfj_store(tab, (d - 1) * 24, e)
        d++
    end
    one := _pf_one()
    mut acc := J8 {}
    acc.x = one
    acc.y = one
    mut w := PF_WINDOWS - 1
    until w >= 0:
        if w != PF_WINDOWS - 1:
            repeat 4:
                _pf_double(acc, acc)
            end
        end
        dg := _pf_digit(k, w)
        mut q := J8 {}
        repeat PF_ENTRIES in e:
            mask := _pf_eq_mask(dg, e + 1)
            off := e * 24
            _pf_or_mask_load(q.x, tab, off, mask)
            _pf_or_mask_load(q.y, tab, off + 8, mask)
            _pf_or_mask_load(q.z, tab, off + 16, mask)
        end
        mut sum := J8 {}
        _pf_jadd(sum, acc, q)
        inf := _pf_iszero_mask(acc.z)
        _pf_cmov(sum.x, q.x, inf)
        _pf_cmov(sum.y, q.y, inf)
        _pf_cmov(sum.z, q.z, inf)
        keep := _pf_eq_mask(dg, 0)
        _pf_cmov(sum.x, acc.x, keep)
        _pf_cmov(sum.y, acc.y, keep)
        _pf_cmov(sum.z, acc.z, keep)
        acc = sum
        w--
    end
    out = acc
    _wipe(tab as void*, PF_ENTRIES * 96)
    mem.Free(tab as void*)
end

func _pf_jac_out(a &: J8): Jac:
    mut j := Jac {}
    _pf_to_fe(a.x, j.x)
    _pf_to_fe(a.y, j.y)
    _pf_to_fe(a.z, j.z)
    ret j
end

func _pf_mul_base(k: Fe): Jac:
    mut r := J8 {}
    _pf_base_mul(k, r)
    ret _pf_jac_out(r)
end

func _pf_mul_point(k: Fe, pt: Jac): Jac:
    mut p := J8 {}
    _pf_from_fe(p.x, pt.x)
    _pf_from_fe(p.y, pt.y)
    _pf_from_fe(p.z, pt.z)
    mut r := J8 {}
    _pf_point_mul(k, p, r)
    ret _pf_jac_out(r)
end

func _pf_inv_fe(r &: Fe, a: Fe, modn: bool):
    mut x := F8 {}
    _pf_from_fe(x, a)
    mut y := F8 {}
    if modn:
        _pfn_inv(y, x)
    else:
        _pf_inv(y, x)
    end
    _pf_to_fe(y, r)
end
