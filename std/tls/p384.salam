package tls

// NIST P-384 (secp384r1) parameters.
//
// Needed because a substantial share of the public trust store is anchored at
// P-384 roots: of the 152 certificates in the Mozilla bundle shipped with
// git-for-windows, 39 carry secp384r1 keys. Without this curve those anchors
// parse to nothing usable and every chain beneath them fails.
//
// The arithmetic is shared with P-256 in ec.salam; only the constants differ.
// Like P-256, p == -1 mod 2^32, so the field-side n0inv is 1.

const P384_SIZE := 48

// p = 2^384 - 2^128 - 2^96 + 2^32 - 1, little-endian limbs
const P384_P := [
    0xffffffff as u32, 0x00000000 as u32, 0x00000000 as u32, 0xffffffff as u32
    0xfffffffe as u32, 0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32
    0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32
] as u32[12]

const P384_N := [
    0xccc52973 as u32, 0xecec196a as u32, 0x48b0a77a as u32, 0x581a0db2 as u32
    0xf4372ddf as u32, 0xc7634d81 as u32, 0xffffffff as u32, 0xffffffff as u32
    0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32
] as u32[12]

const P384_R2 := [
    0x00000001 as u32, 0xfffffffe as u32, 0x00000000 as u32, 0x00000002 as u32
    0x00000000 as u32, 0xfffffffe as u32, 0x00000000 as u32, 0x00000002 as u32
    0x00000001 as u32, 0x00000000 as u32, 0x00000000 as u32, 0x00000000 as u32
] as u32[12]

const P384_R2N := [
    0x19b409a9 as u32, 0x2d319b24 as u32, 0xdf1aa419 as u32, 0xff3d81e5 as u32
    0xfcb82947 as u32, 0xbc3e483a as u32, 0x4aab1cc5 as u32, 0xd40d4917 as u32
    0x28266895 as u32, 0x3fb05b7a as u32, 0x2b39bf21 as u32, 0x0c84ee01 as u32
] as u32[12]

const P384_ONE_MONT := [
    0x00000001 as u32, 0xffffffff as u32, 0xffffffff as u32, 0x00000000 as u32
    0x00000001 as u32, 0x00000000 as u32, 0x00000000 as u32, 0x00000000 as u32
    0x00000000 as u32, 0x00000000 as u32, 0x00000000 as u32, 0x00000000 as u32
] as u32[12]

const P384_B_MONT := [
    0x9d412dcc as u32, 0x08118871 as u32, 0x7a4c32ec as u32, 0xf729add8 as u32
    0x1920022e as u32, 0x77f2209b as u32, 0x94938ae2 as u32, 0xe3374bee as u32
    0x1f022094 as u32, 0xb62b21f4 as u32, 0x604fbff9 as u32, 0xcd08114b as u32
] as u32[12]

const P384_GX_MONT := [
    0x49c0b528 as u32, 0x3dd07566 as u32, 0xa0d6ce38 as u32, 0x20e378e2 as u32
    0x541b4d6e as u32, 0x879c3afc as u32, 0x59a30eff as u32, 0x64548684 as u32
    0x614ede2b as u32, 0x812ff723 as u32, 0x299e1513 as u32, 0x4d3aadc2 as u32
] as u32[12]

const P384_GY_MONT := [
    0x4b03a4fe as u32, 0x23043dad as u32, 0x7bb4a9ac as u32, 0xa1bfa8bf as u32
    0x2e83b050 as u32, 0x8bade756 as u32, 0x68f4ffd9 as u32, 0xc6c35219 as u32
    0x3969a840 as u32, 0xdd800226 as u32, 0x5a15c5e9 as u32, 0x2b78abc2 as u32
] as u32[12]

// -n^-1 mod 2^32 for the group order
const P384_N0INV := 0xe88fdc45 as u32

func _curve_p384(): Curve:
    mut c := Curve {}
    c.nl = 12
    c.nb = P384_SIZE
    repeat 12 with i:
        c.p[i] = P384_P[i]
        c.n[i] = P384_N[i]
        c.r2p[i] = P384_R2[i]
        c.r2n[i] = P384_R2N[i]
        c.one[i] = P384_ONE_MONT[i]
        c.b[i] = P384_B_MONT[i]
        c.gx[i] = P384_GX_MONT[i]
        c.gy[i] = P384_GY_MONT[i]
    end
    c.n0p = 1 as u32
    c.n0n = P384_N0INV
    ret c
end
