package tls

const PRF_LABEL_MASTER := "master secret"
const PRF_LABEL_EXT_MASTER := "extended master secret"
const PRF_LABEL_KEY_EXPANSION := "key expansion"
const PRF_LABEL_CLIENT_FINISHED := "client finished"
const PRF_LABEL_SERVER_FINISHED := "server finished"

const MASTER_SECRET_LEN := 48
const VERIFY_DATA_LEN := 12

// P_hash expanded to `olen` bytes.
func _p_hash(kind: int, secret: void*, slen: int, seed: Buf, out: void*, olen: int):
    hlen := _hash_size(kind)
    mut a := _newbuf(hlen)
    defer _buf_wipe(a)
    _putzeros(a, hlen)
    _hmac(kind, secret, slen, seed.p, seed.len, a.p)

    mut blk := _newbuf(hlen)
    defer _buf_wipe(blk)
    _putzeros(blk, hlen)

    mut msg := _newbuf(hlen + seed.len)
    defer _buf_free(msg)

    mut done := 0
    until done < olen:
        _bufreset(msg)
        _putbuf(msg, a)
        _putbuf(msg, seed)
        _hmac(kind, secret, slen, msg.p, msg.len, blk.p)
        mut take := olen - done
        if take > hlen:
            take = hlen
        end
        repeat take with i:
            _bput(out, done + i, _bufat(blk, i))
        end
        done += take
        _hmac(kind, secret, slen, a.p, hlen, a.p)
    end
end

// PRF(secret, label, seed) = P_hash(secret, label || seed)
func _prf(kind: int, secret: void*, slen: int, label: str, seed: Buf, out: void*, olen: int):
    mut ls := _newbuf(label.len() + seed.len)
    defer _buf_free(ls)
    _putstr(ls, label)
    _putbuf(ls, seed)
    _p_hash(kind, secret, slen, ls, out, olen)
end

// master_secret = PRF(pre_master, "master secret", client_random + server_random)
func _tls12_master(kind: int, pms: void*, pmslen: int, crand: Buf, srand: Buf, out: void*):
    mut seed := _newbuf(64)
    defer _buf_free(seed)
    _putbuf(seed, crand)
    _putbuf(seed, srand)
    _prf(kind, pms, pmslen, PRF_LABEL_MASTER, seed, out, MASTER_SECRET_LEN)
end

// RFC 7627: master_secret = PRF(pre_master, "extended master secret",
//                               Hash(handshake_messages))
func _tls12_master_ext(kind: int, pms: void*, pmslen: int, session_hash: Buf, out: void*):
    _prf(kind, pms, pmslen, PRF_LABEL_EXT_MASTER, session_hash, out, MASTER_SECRET_LEN)
end

// key_block = PRF(master, "key expansion", server_random + client_random)
//
// Note the randoms are in the OPPOSITE order to the master-secret seed. Getting
// that backwards yields keys that are self-consistent but disagree with every
// peer, which shows up only as a Finished mismatch.
func _tls12_key_block(kind: int, master: void*, mlen: int, srand: Buf, crand: Buf, out: void*, olen: int):
    mut seed := _newbuf(64)
    defer _buf_free(seed)
    _putbuf(seed, srand)
    _putbuf(seed, crand)
    _prf(kind, master, mlen, PRF_LABEL_KEY_EXPANSION, seed, out, olen)
end

// verify_data = PRF(master, "client finished"|"server finished",
//                   Hash(handshake_messages))[0..12]
func _tls12_verify_data(kind: int, master: void*, mlen: int, label: str, th: Buf, out: void*):
    _prf(kind, master, mlen, label, th, out, VERIFY_DATA_LEN)
end
