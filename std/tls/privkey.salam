package tls

struct PrivateKey:
    pub pk_alg: int = 0
    pub rsa_n: Buf = Buf {}
    pub rsa_e: Buf = Buf {}
    pub rsa_d: Buf = Buf {}
    pub rsa_crt: RsaCrt* = null
    pub ec_scalar: Buf = Buf {}
    pub ok: bool = false
end

func _der_octetstring(r &: Reader): Reader:
    t := _der_tag(r, ASN1_OCTETSTRING)
    if not t.ok:
        ret _newreader(null, 0)
    end
    ret t.body
end

func _parse_rsa_pkcs1_body(body: Reader, k &: PrivateKey): bool:
    mut r := body
    mut seq := _der_seq(r)
    if r.bad:
        ret false
    end
    _der_skip(seq)
    n := _der_uint(seq)
    e := _der_uint(seq)
    d := _der_uint(seq)
    p := _der_uint(seq)
    q := _der_uint(seq)
    if seq.bad:
        ret false
    end
    if n.len < 128:
        ret false
    end
    if e.len == 0 or d.len == 0 or p.len == 0 or q.len == 0:
        ret false
    end
    k.rsa_n = _newbuf(n.len)
    repeat n.len in i:
        _put8(k.rsa_n, _rdat(n, i))
    end
    k.rsa_e = _newbuf(e.len)
    repeat e.len in i:
        _put8(k.rsa_e, _rdat(e, i))
    end
    k.rsa_d = _newbuf(d.len)
    repeat d.len in i:
        _put8(k.rsa_d, _rdat(d, i))
    end

    k.rsa_crt = _rsa_crt_new(n, e, d, p, q)
    if k.rsa_crt == null:
        ret false
    end

    k.pk_alg = PK_RSA
    k.ok = true
    ret true
end

func _parse_ec_sec1_body(body: Reader, curve_hint: int, k &: PrivateKey): bool:
    mut r := body
    mut seq := _der_seq(r)
    if r.bad:
        ret false
    end
    _der_skip(seq)
    priv := _der_octetstring(seq)
    if seq.bad:
        ret false
    end
    mut alg := curve_hint
    if _der_is(seq, ASN1_CTX0):
        pt := _der_tag(seq, ASN1_CTX0)
        if not pt.ok:
            ret false
        end
        mut pb := pt.body
        curve_oid := _der_oid(pb)
        if pb.bad:
            ret false
        end
        if _oid_is(curve_oid, OID_PRIME256V1):
            alg = PK_EC_P256
        else if _oid_is(curve_oid, OID_SECP384R1):
            alg = PK_EC_P384
        else:
            ret false
        end
    end
    if alg == PK_UNKNOWN:
        if priv.len == 32:
            alg = PK_EC_P256
        else if priv.len == 48:
            alg = PK_EC_P384
        else:
            ret false
        end
    end
    mut width := 32
    if alg == PK_EC_P384:
        width = 48
    end
    if priv.len > width or priv.len == 0:
        ret false
    end
    k.ec_scalar = _newbuf(width)
    _putzeros(k.ec_scalar, width - priv.len)
    repeat priv.len in i:
        _put8(k.ec_scalar, _rdat(priv, i))
    end
    k.pk_alg = alg
    k.ok = true
    ret true
end

func _parse_pkcs8_body(body: Reader, k &: PrivateKey): bool:
    mut r := body
    mut seq := _der_seq(r)
    if r.bad:
        ret false
    end
    _der_skip(seq)
    mut params := _newreader(null, 0)
    alg_oid := _der_algid(seq, params)
    if seq.bad:
        ret false
    end
    pkoct := _der_octetstring(seq)
    if seq.bad:
        ret false
    end
    if _oid_is(alg_oid, OID_RSA_ENCRYPTION):
        ret _parse_rsa_pkcs1_body(pkoct, k)
    end
    if _oid_is(alg_oid, OID_EC_PUBLICKEY):
        mut pkcs8_curve := 0
        mut pp := params
        curve_oid := _der_oid(pp)
        if not pp.bad:
            if _oid_is(curve_oid, OID_PRIME256V1):
                pkcs8_curve = PK_EC_P256
            else if _oid_is(curve_oid, OID_SECP384R1):
                pkcs8_curve = PK_EC_P384
            end
        end
        ret _parse_ec_sec1_body(pkoct, pkcs8_curve, k)
    end
    ret false
end

@en "FreePrivateKey"
@fa "آزادسازی کلید خصوصی"
pub func FreePrivateKey(k &: PrivateKey):
    _buf_wipe(k.rsa_d)
    _rsa_crt_free(k.rsa_crt)
    k.rsa_crt = null
    _buf_free(k.rsa_n)
    _buf_free(k.rsa_e)
    _buf_wipe(k.ec_scalar)
    k.ok = false
end

@en "ParsePrivateKeyPEM"
@fa "تجزیه کلید خصوصی پم"
pub func ParsePrivateKeyPEM(pem: str): PrivateKey:
    mut k := PrivateKey {}
    mut markers: str[3]
    markers[0] = "RSA PRIVATE KEY"
    markers[1] = "EC PRIVATE KEY"
    markers[2] = "PRIVATE KEY"
    mut mi := 0
    until mi < 3:
        begintag := "-----BEGIN " + markers[mi] + "-----"
        endtag := "-----END " + markers[mi] + "-----"
        b := pem.find(begintag)
        if b >= 0:
            bodystart := b + begintag.len()
            e := str.IndexFrom(pem, endtag, bodystart)
            if e >= 0:
                room := (e - bodystart) / 4 * 3 + 8
                mut der := _newbuf(room)
                mut good := false
                mut got := 0
                try:
                    got = encoding.Base64DecodeBytes(pem.substr(bodystart, e - bodystart), der.p, room)
                    good = true
                catch:
                    good = false
                end
                if good and got > 0:
                    rd := _newreader(der.p, got)
                    if mi == 0:
                        _parse_rsa_pkcs1_body(rd, k)
                    else if mi == 1:
                        _parse_ec_sec1_body(rd, PK_UNKNOWN, k)
                    else:
                        _parse_pkcs8_body(rd, k)
                    end
                end
                _buf_wipe(der)
                if k.ok:
                    ret k
                end
            end
        end
        mi += 1
    end
    ret k
end

@en "LoadPrivateKeyFile"
@fa "بارگذاری فایل کلید خصوصی"
pub func LoadPrivateKeyFile(path: str): PrivateKey:
    if not os.Exists(path):
        k := PrivateKey {}
        ret k
    end
    pem := io.ReadFile(path)
    ret ParsePrivateKeyPEM(pem)
end
