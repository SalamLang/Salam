package tls

import mem
import net.internal.rawsock

const REC_CHANGE_CIPHER_SPEC := 20
const REC_ALERT := 21
const REC_HANDSHAKE := 22
const REC_APPLICATION_DATA := 23

const REC_MAX_PLAINTEXT := 16384
const REC_MAX_CIPHERTEXT := 16640
const REC_HEADER := 5
const REC_RX_CAP := 16645 + 16384
const REC_SEAL_ROOM := 64
const REC_TX_BATCH := 65536
const REC_TX_KEEP := 32768

const CIPHER_NONE := 0
const CIPHER_AES128_GCM_SHA256 := 1
const CIPHER_CHACHA20_SHA256 := 2
const CIPHER_AES256_GCM_SHA384 := 3

const TLS_AES_128_GCM_SHA256 := 0x1301
const TLS_AES_256_GCM_SHA384 := 0x1302
const TLS_CHACHA20_POLY1305_SHA256 := 0x1303

const ALERT_CLOSE_NOTIFY := 0
const ALERT_UNEXPECTED_MESSAGE := 10
const ALERT_BAD_RECORD_MAC := 20
const ALERT_HANDSHAKE_FAILURE := 40
const ALERT_BAD_CERTIFICATE := 42
const ALERT_CERTIFICATE_EXPIRED := 45
const ALERT_CERTIFICATE_UNKNOWN := 46
const ALERT_ILLEGAL_PARAMETER := 47
const ALERT_DECODE_ERROR := 50
const ALERT_DECRYPT_ERROR := 51
const ALERT_PROTOCOL_VERSION := 70
const ALERT_INTERNAL_ERROR := 80

const HANDSHAKE_READ_TIMEOUT_MS := 15000

struct RecordLayer:
    pub fd: i64 = 0 - 1
    pub rx: Buf = Buf {}
    pub rpos: int = 0
    pub tx: Buf = Buf {}
    pub corked: bool = false
    pub nonce: Buf = Buf {}
    pub aad: Buf = Buf {}
    pub rxk: TrafficKeys = TrafficKeys {}
    pub txk: TrafficKeys = TrafficKeys {}
    pub eof: bool = false
    pub failed: bool = false
    pub err: str = ""
    pub read_deadline_ms: int = 0
end

func _rec_new(fd: i64): RecordLayer:
    mut r := RecordLayer {}
    r.fd = fd
    r.rx = _newbuf(REC_RX_CAP)
    r.tx = _newbuf(REC_MAX_PLAINTEXT + REC_SEAL_ROOM)
    r.nonce = _newbuf(12)
    r.aad = _newbuf(16)
    r.corked = true
    ret r
end

func _rec_free(r &: RecordLayer):
    _buf_wipe(r.rx)
    _buf_wipe(r.tx)
    _buf_free(r.nonce)
    _buf_free(r.aad)
    _tk_free(r.rxk)
    _tk_free(r.txk)
end

func _rec_fail(r &: RecordLayer, msg: str):
    if not r.failed:
        r.failed = true
        r.err = msg
    end
end

func _rec_flush(r &: RecordLayer): bool:
    if r.tx.len == 0:
        ret true
    end
    n := r.tx.len
    sent := rawsock.SendBytes(rawsock.FromFd(r.fd), r.tx.p, n)
    r.tx.len = 0
    if r.tx.cap > REC_TX_KEEP:
        _buf_wipe(r.tx)
        r.tx = _newbuf(REC_MAX_PLAINTEXT + REC_SEAL_ROOM)
    end
    if sent != n:
        _rec_fail(r, "short write")
        ret false
    end
    ret true
end

func _rec_uncork(r &: RecordLayer): bool:
    r.corked = false
    ret _rec_flush(r)
end

func _rec_fill(r &: RecordLayer): bool:
    if not _rec_flush(r):
        r.eof = true
        ret false
    end
    if r.read_deadline_ms > 0:
        if not rawsock.WaitReadable(rawsock.FromFd(r.fd), r.read_deadline_ms):
            _rec_fail(r, "timed out waiting for the peer")
            r.eof = true
            ret false
        end
    end
    n := rawsock.RecvBytes(rawsock.FromFd(r.fd), _bufptr(r.rx, r.rx.len), r.rx.cap - r.rx.len)
    if n <= 0:
        r.eof = true
        ret false
    end
    r.rx.len += n
    ret true
end

func _rec_need(r &: RecordLayer, n: int): bool:
    if r.rx.len - r.rpos >= n:
        ret true
    end
    if r.rpos > 0:
        left := r.rx.len - r.rpos
        if left > 0:
            mem.MemMove(r.rx.p, _bufptr(r.rx, r.rpos), left as u64)
        end
        r.rx.len = left
        r.rpos = 0
    end
    until r.rx.len < n:
        if not _rec_fill(r):
            ret false
        end
    end
    ret true
end

func _rec_buffered(r: RecordLayer): int:
    left := r.rx.len - r.rpos
    if left < REC_HEADER:
        ret 0
    end
    length := (_bget(r.rx.p, r.rpos + 3) << 8) | _bget(r.rx.p, r.rpos + 4)
    if left < REC_HEADER + length:
        ret 0
    end
    ret left
end

func _rec_open(r &: RecordLayer, typ &: int, out &: void*, out_len &: int): bool:
    out = null
    out_len = 0
    if r.failed:
        ret false
    end
    if not _rec_need(r, REC_HEADER):
        ret false
    end
    ctype := _bget(r.rx.p, r.rpos)
    length := (_bget(r.rx.p, r.rpos + 3) << 8) | _bget(r.rx.p, r.rpos + 4)
    if length > REC_MAX_CIPHERTEXT:
        _rec_fail(r, "record too large")
        ret false
    end
    if not _rec_need(r, REC_HEADER + length):
        _rec_fail(r, "truncated record")
        ret false
    end
    base := r.rpos
    body := _bufptr(r.rx, base + REC_HEADER)
    r.rpos = base + REC_HEADER + length

    if not r.rxk.live:
        out = body
        out_len = length
        typ = ctype
        ret true
    end

    if ctype == REC_CHANGE_CIPHER_SPEC:
        typ = REC_CHANGE_CIPHER_SPEC
        ret true
    end

    if length < 17:
        _rec_fail(r, "encrypted record shorter than its tag")
        ret false
    end

    if r.rxk.is12:
        exp := r.rxk.explicit_len
        if length < exp + 17:
            _rec_fail(r, "encrypted record too short")
            ret false
        end
        content_len := length - exp - 16
        _bufreset(r.nonce)
        if exp > 0:
            _putraw(r.nonce, r.rxk.iv.p, 4)
            _putraw(r.nonce, body, 8)
        else:
            _putzeros(r.nonce, 12)
            _tk_nonce(r.rxk, r.nonce)
        end
        _tk12_aad(r.rxk.seq, ctype, content_len, r.aad)
        cp := ((body as i64) + (exp as i64)) as void*
        tp := ((cp as i64) + (content_len as i64)) as void*
        if not _aead_open(r.rxk, r.nonce, r.aad.p, r.aad.len, cp, content_len, tp, cp):
            _rec_fail(r, "bad record MAC")
            ret false
        end
        if not _tk_advance(r.rxk):
            _rec_fail(r, "sequence number exhausted")
            ret false
        end
        out = cp
        out_len = content_len
        typ = ctype
        ret true
    end

    ctlen := length - 16
    _bufreset(r.nonce)
    _putzeros(r.nonce, 12)
    _tk_nonce(r.rxk, r.nonce)
    tagp := ((body as i64) + (ctlen as i64)) as void*
    if not _aead_open(r.rxk, r.nonce, _bufptr(r.rx, base), REC_HEADER, body, ctlen, tagp, body):
        _rec_fail(r, "bad record MAC")
        ret false
    end
    if not _tk_advance(r.rxk):
        _rec_fail(r, "sequence number exhausted")
        ret false
    end

    mut last := ctlen - 1
    until last >= 0 and _bget(body, last) == 0:
        last -= 1
    end
    if last < 0:
        _rec_fail(r, "record with no content type")
        ret false
    end
    typ = _bget(body, last)
    out = body
    out_len = last
    ret true
end

func _rec_read(r &: RecordLayer, typ &: int, out &: Buf): bool:
    mut p := null as void*
    mut n := 0
    if not _rec_open(r, typ, p, n):
        ret false
    end
    _bufreset(out)
    _putraw(out, p, n)
    ret true
end

func _rec_header(r &: RecordLayer, typ: int, body_len: int):
    _put8(r.tx, typ)
    _put16(r.tx, TLS12)
    _put16(r.tx, body_len)
end

func _rec_append_plain(r &: RecordLayer, typ: int, p: void*, n: int):
    _rec_header(r, typ, n)
    _putraw(r.tx, p, n)
end

func _rec_append(r &: RecordLayer, typ: int, p: void*, n: int): bool:
    _buf_grow(r.tx, n + REC_SEAL_ROOM)
    if r.tx.bad:
        _rec_fail(r, "out of memory")
        ret false
    end
    if not r.txk.live:
        _rec_append_plain(r, typ, p, n)
        ret true
    end
    if r.txk.is12:
        exp := r.txk.explicit_len
        _rec_header(r, typ, exp + n + 16)
        _bufreset(r.nonce)
        _putzeros(r.nonce, 12)
        _tk_nonce(r.txk, r.nonce)
        if exp > 0:
            _putraw(r.tx, _bufptr(r.nonce, 4), 8)
        end
        _tk12_aad(r.txk.seq, typ, n, r.aad)
        ctp := _bufptr(r.tx, r.tx.len)
        _aead_seal(r.txk, r.nonce, r.aad.p, r.aad.len, p, ctp, n, ((ctp as i64) + (n as i64)) as void*)
        r.tx.len += n + 16
    else:
        hdr := _bufptr(r.tx, r.tx.len)
        _rec_header(r, REC_APPLICATION_DATA, n + 17)
        ctp := _bufptr(r.tx, r.tx.len)
        if n > 0:
            mem.Copy(ctp, p, n as u64)
        end
        _bput(ctp, n, typ)
        _bufreset(r.nonce)
        _putzeros(r.nonce, 12)
        _tk_nonce(r.txk, r.nonce)
        _aead_seal(r.txk, r.nonce, hdr, REC_HEADER, ctp, ctp, n + 1, ((ctp as i64) + ((n + 1) as i64)) as void*)
        r.tx.len += n + 17
    end
    if not _tk_advance(r.txk):
        _rec_fail(r, "sequence number exhausted")
        ret false
    end
    ret true
end

func _rec_write(r &: RecordLayer, typ: int, p: void*, n: int): bool:
    if r.failed:
        ret false
    end
    if n == 0:
        if not _rec_append(r, typ, p, 0):
            ret false
        end
    end
    mut off := 0
    until off < n:
        mut take := n - off
        if take > REC_MAX_PLAINTEXT:
            take = REC_MAX_PLAINTEXT
        end
        if r.tx.len > 0 and r.tx.len + take + REC_SEAL_ROOM > REC_TX_BATCH:
            if not _rec_flush(r):
                ret false
            end
        end
        if not _rec_append(r, typ, ((p as i64) + (off as i64)) as void*, take):
            ret false
        end
        off += take
    end
    if r.corked:
        ret true
    end
    ret _rec_flush(r)
end

func _rec_write_plain(r &: RecordLayer, typ: int, p: void*, n: int): bool:
    _rec_append_plain(r, typ, p, n)
    if r.corked:
        ret true
    end
    ret _rec_flush(r)
end

func _rec_send_alert(r &: RecordLayer, level: int, desc: int):
    mut a := _newbuf(2)
    defer _buf_free(a)
    _put8(a, level)
    _put8(a, desc)
    _rec_write(r, REC_ALERT, a.p, 2)
    _rec_flush(r)
end
