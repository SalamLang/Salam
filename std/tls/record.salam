package tls
import net.internal.rawsock

const REC_CHANGE_CIPHER_SPEC := 20
const REC_ALERT := 21
const REC_HANDSHAKE := 22
const REC_APPLICATION_DATA := 23

// RFC 8446 allows 2^14 of plaintext, plus up to 256 bytes of expansion.
const REC_MAX_PLAINTEXT := 16384
const REC_MAX_CIPHERTEXT := 16640
const REC_HEADER := 5

const CIPHER_NONE := 0
const CIPHER_AES128_GCM_SHA256 := 1
const CIPHER_CHACHA20_SHA256 := 2
const CIPHER_AES256_GCM_SHA384 := 3

// wire code points
const TLS_AES_128_GCM_SHA256 := 0x1301
const TLS_AES_256_GCM_SHA384 := 0x1302
const TLS_CHACHA20_POLY1305_SHA256 := 0x1303

const ALERT_CLOSE_NOTIFY := 0
const ALERT_UNEXPECTED_MESSAGE := 10
const ALERT_BAD_RECORD_MAC := 20
const ALERT_HANDSHAKE_FAILURE := 40
const ALERT_BAD_CERTIFICATE := 42
const ALERT_CERTIFICATE_EXPIRED := 45
const ALERT_CERTIFICATE_UNKNOWN := 46
const ALERT_ILLEGAL_PARAMETER := 47
const ALERT_DECODE_ERROR := 50
const ALERT_DECRYPT_ERROR := 51
const ALERT_PROTOCOL_VERSION := 70
const ALERT_INTERNAL_ERROR := 80

// How long one handshake read may wait on the peer. Generous on purpose:
// it is a backstop against a connection that stalls forever, not a
// performance bound, and a loaded CI runner doing a full handshake in
// software has been seen to need seconds. Only the handshake uses it; an
// established connection keeps waiting indefinitely, which is what an idle
// WebSocket needs.
const HANDSHAKE_READ_TIMEOUT_MS := 15000

struct RecordLayer:
    pub fd: i64 = 0 - 1
    // bytes received but not yet consumed
    pub rx: Buf = Buf {}
    pub rxk: TrafficKeys = TrafficKeys {}
    pub txk: TrafficKeys = TrafficKeys {}
    pub eof: bool = false
    pub failed: bool = false
    pub err: str = ""
    // Milliseconds a single fill may wait for the peer, or 0 for "block as
    // long as it takes". Only the handshake sets it: an established
    // connection is allowed to sit idle indefinitely, because that is what
    // a WebSocket between messages looks like, but a peer that opens a
    // connection and then says nothing must not pin the accepting thread
    // for the life of the process.
    pub read_deadline_ms: int = 0
end

func _rec_new(fd: i64): RecordLayer:
    mut r := RecordLayer {}
    r.fd = fd
    r.rx = _newbuf(REC_MAX_CIPHERTEXT + REC_HEADER)
    ret r
end

func _rec_free(r &: RecordLayer):
    _buf_free(r.rx)
    _tk_free(r.rxk)
    _tk_free(r.txk)
end

func _rec_fail(r &: RecordLayer, msg: str):
    if !r.failed:
        r.failed = true
        r.err = msg
    end
end

// Pull more bytes from the socket into the receive buffer.
func _rec_fill(r &: RecordLayer): bool:
    if r.read_deadline_ms > 0:
        if !rawsock.WaitReadable(rawsock.FromFd(r.fd), r.read_deadline_ms):
            _rec_fail(r, "timed out waiting for the peer")
            r.eof = true
            ret false
        end
    end
    mut tmp := _newbuf(4096)
    defer _buf_free(tmp)
    _putzeros(tmp, 4096)
    n := rawsock.RecvBytes(rawsock.FromFd(r.fd), tmp.p, 4096)
    if n <= 0:
        r.eof = true
        ret false
    end
    _putraw(r.rx, tmp.p, n)
    ret true
end

// Block until the receive buffer holds at least n bytes.
func _rec_need(r &: RecordLayer, n: int): bool:
    until r.rx.len < n:
        if !_rec_fill(r):
            ret false
        end
    end
    ret true
end

// Read one record. On success `typ` receives the content type and `out` the
// fragment (decrypted, with the inner type and padding stripped, once keys are
// installed).
// Whether a whole record is already here, read off the socket and waiting
// to be decrypted.
//
// This is the difference between "no plaintext yet" and "nothing to read":
// one TCP segment often carries several TLS records, so the first read takes
// them all off the socket and decrypts only the first. The rest sit here,
// invisible to the descriptor - a caller that polls the socket and waits
// would wait for traffic that has already arrived.
func _rec_buffered(r: RecordLayer): int:
    if r.rx.len < REC_HEADER:
        ret 0
    end
    length := (_bufat(r.rx, 3) << 8) | _bufat(r.rx, 4)
    if r.rx.len < REC_HEADER + length:
        ret 0
    end
    ret r.rx.len
end

func _rec_read(r &: RecordLayer, typ &: int, out &: Buf): bool:
    if r.failed:
        ret false
    end
    if !_rec_need(r, REC_HEADER):
        ret false
    end
    ctype := _bufat(r.rx, 0)
    length := (_bufat(r.rx, 3) << 8) | _bufat(r.rx, 4)
    if length > REC_MAX_CIPHERTEXT:
        _rec_fail(r, "record too large")
        ret false
    end
    if !_rec_need(r, REC_HEADER + length):
        _rec_fail(r, "truncated record")
        ret false
    end

    mut hdr := _newbuf(REC_HEADER)
    defer _buf_free(hdr)
    mut n12 := _newbuf(12)
    defer _buf_free(n12)
    mut a12 := _newbuf(16)
    defer _buf_free(a12)
    mut p12 := _newbuf(REC_MAX_CIPHERTEXT)
    defer _buf_free(p12)
    repeat REC_HEADER with i:
        _put8(hdr, _bufat(r.rx, i))
    end

    _bufreset(out)
    if !r.rxk.live:
        repeat length with i:
            _put8(out, _bufat(r.rx, REC_HEADER + i))
        end
        _bufconsume(r.rx, REC_HEADER + length)
        typ = ctype
        ret true
    end

    if ctype == REC_CHANGE_CIPHER_SPEC:
        _bufconsume(r.rx, REC_HEADER + length)
        typ = REC_CHANGE_CIPHER_SPEC
        ret true
    end

    if length < 17:
        _rec_fail(r, "encrypted record shorter than its tag")
        ret false
    end

    if r.rxk.is12:
        exp := r.rxk.explicit_len
        if length < exp + 17:
            _rec_fail(r, "encrypted record too short")
            ret false
        end
        content_len := length - exp - 16
        _bufreset(n12)
        if exp > 0:
            repeat 4 with i:
                _put8(n12, _bufat(r.rxk.iv, i))
            end
            repeat 8 with i:
                _put8(n12, _bufat(r.rx, REC_HEADER + i))
            end
        else:
            _putzeros(n12, 12)
            _tk_nonce(r.rxk, n12)
        end
        _tk12_aad(r.rxk.seq, ctype, content_len, a12)
        _bufreset(p12)
        _putzeros(p12, content_len)
        cp := _bufptr(r.rx, REC_HEADER + exp)
        tp := _bufptr(r.rx, REC_HEADER + exp + content_len)
        if !_aead_open(r.rxk, n12, a12.p, a12.len, cp, content_len, tp, p12.p):
            _rec_fail(r, "bad record MAC")
            ret false
        end
        _bufconsume(r.rx, REC_HEADER + length)
        if !_tk_advance(r.rxk):
            _rec_fail(r, "sequence number exhausted")
            ret false
        end
        repeat content_len with i:
            _put8(out, _bufat(p12, i))
        end
        typ = ctype
        ret true
    end

    ctlen := length - 16
    mut nonce := _newbuf(12)
    defer _buf_free(nonce)
    _putzeros(nonce, 12)
    _tk_nonce(r.rxk, nonce)

    mut plain := _newbuf(ctlen + 1)
    defer _buf_free(plain)
    _putzeros(plain, ctlen)
    ctp := _bufptr(r.rx, REC_HEADER)
    tagp := _bufptr(r.rx, REC_HEADER + ctlen)
    if !_aead_open(r.rxk, nonce, hdr.p, REC_HEADER, ctp, ctlen, tagp, plain.p):
        _rec_fail(r, "bad record MAC")
        ret false
    end
    _bufconsume(r.rx, REC_HEADER + length)
    if !_tk_advance(r.rxk):
        _rec_fail(r, "sequence number exhausted")
        ret false
    end

    mut last := ctlen - 1
    until last >= 0 && _bufat(plain, last) == 0:
        last -= 1
    end
    if last < 0:
        _rec_fail(r, "record with no content type")
        ret false
    end
    typ = _bufat(plain, last)
    repeat last with i:
        _put8(out, _bufat(plain, i))
    end
    ret true
end

func _rec_write_raw(r &: RecordLayer, typ: int, p: void*, n: int): bool:
    mut rec := _newbuf(n + REC_HEADER + 32)
    defer _buf_free(rec)
    mut inner := _newbuf(n + 1)
    defer _buf_free(inner)
    mut nonce := _newbuf(12)
    defer _buf_free(nonce)
    mut ct := _newbuf(n + 1)
    defer _buf_free(ct)
    mut tag := _newbuf(16)
    defer _buf_free(tag)
    mut wa12 := _newbuf(16)
    defer _buf_free(wa12)
    if !r.txk.live:
        _put8(rec, typ)
        _put16(rec, TLS12)
        _put16(rec, n)
        _putraw(rec, p, n)
    else if r.txk.is12:
        exp := r.txk.explicit_len
        _put8(rec, typ)
        _put16(rec, TLS12)
        _put16(rec, exp + n + 16)
        _putzeros(nonce, 12)
        _tk_nonce(r.txk, nonce)
        if exp > 0:
            repeat 8 with i:
                _put8(rec, _bufat(nonce, 4 + i))
            end
        end
        _tk12_aad(r.txk.seq, typ, n, wa12)
        _putzeros(ct, n)
        _putzeros(tag, 16)
        _aead_seal(r.txk, nonce, wa12.p, wa12.len, p, ct.p, n, tag.p)
        _putbuf(rec, ct)
        _putbuf(rec, tag)
        if !_tk_advance(r.txk):
            _rec_fail(r, "sequence number exhausted")
            ret false
        end
    else:
        _putraw(inner, p, n)
        _put8(inner, typ)

        _put8(rec, REC_APPLICATION_DATA)
        _put16(rec, TLS12)
        _put16(rec, inner.len + 16)

        _putzeros(nonce, 12)
        _tk_nonce(r.txk, nonce)

        _putzeros(ct, inner.len)
        _putzeros(tag, 16)
        _aead_seal(r.txk, nonce, rec.p, REC_HEADER, inner.p, ct.p, inner.len, tag.p)
        _putbuf(rec, ct)
        _putbuf(rec, tag)
        if !_tk_advance(r.txk):
            _rec_fail(r, "sequence number exhausted")
            ret false
        end
    end
    sent := rawsock.SendBytes(rawsock.FromFd(r.fd), rec.p, rec.len)
    if sent != rec.len:
        _rec_fail(r, "short write")
        ret false
    end
    ret true
end

// Write a payload, fragmenting at the plaintext record limit.
func _rec_write(r &: RecordLayer, typ: int, p: void*, n: int): bool:
    if r.failed:
        ret false
    end
    mut off := 0
    if n == 0:
        ret _rec_write_raw(r, typ, p, 0)
    end
    until off < n:
        mut take := n - off
        if take > REC_MAX_PLAINTEXT:
            take = REC_MAX_PLAINTEXT
        end
        if !_rec_write_raw(r, typ, ((p as i64) + (off as i64)) as void*, take):
            ret false
        end
        off += take
    end
    ret true
end

// Write an unencrypted record regardless of key state.
//
// Only the middlebox-compatibility ChangeCipherSpec uses this. RFC 8446
// appendix D.4 has that record sent in the clear even though handshake keys
// already exist; encrypting it makes the peer see an inner content type it
// cannot place, and servers answer with unexpected_message.
func _rec_write_plain(r &: RecordLayer, typ: int, p: void*, n: int): bool:
    mut rec := _newbuf(n + REC_HEADER)
    defer _buf_free(rec)
    _put8(rec, typ)
    _put16(rec, TLS12)
    _put16(rec, n)
    _putraw(rec, p, n)
    sent := rawsock.SendBytes(rawsock.FromFd(r.fd), rec.p, rec.len)
    if sent != rec.len:
        _rec_fail(r, "short write")
        ret false
    end
    ret true
end

func _rec_send_alert(r &: RecordLayer, level: int, desc: int):
    mut a := _newbuf(2)
    defer _buf_free(a)
    _put8(a, level)
    _put8(a, desc)
    _rec_write(r, REC_ALERT, a.p, 2)
end
