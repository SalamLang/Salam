package tls

if SALAM_OS_WIN64:
    link dynamic "crypt32"

    extern:
        func CertOpenSystemStoreA(hprov: i64, subsystem: str): void*
        func CertEnumCertificatesInStore(store: void*, prev: void*): void*
        func CertCloseStore(store: void*, flags: int): int
    end
else:
    if SALAM_OS_MAC:
        link framework "Security"
        link framework "CoreFoundation"

        extern:
            func SecTrustCopyAnchorCertificates(anchors: void*): int
            func CFArrayGetCount(arr: void*): i64
            func CFArrayGetValueAtIndex(arr: void*, idx: i64): void*
            func SecCertificateCopyData(cert: void*): void*
            func CFDataGetBytePtr(data: void*): void*
            func CFDataGetLength(data: void*): i64
            func CFRelease(obj: void*)
        end
    end
end

const PEM_BEGIN := "-----BEGIN CERTIFICATE-----"
const PEM_END := "-----END CERTIFICATE-----"

// Candidate system bundle locations, most common first.
const CA_PATH_0 := "/etc/ssl/certs/ca-certificates.crt"
const CA_PATH_1 := "/etc/pki/tls/certs/ca-bundle.crt"
const CA_PATH_2 := "/etc/ssl/ca-bundle.pem"
const CA_PATH_3 := "/etc/ssl/cert.pem"
const CA_PATH_4 := "/usr/local/etc/ssl/cert.pem"
const CA_PATH_5 := "/usr/local/share/certs/ca-root-nss.crt"
const CA_PATH_6 := "/etc/ssl/certs/ca-bundle.crt"
// Windows has no conventional CA bundle file at all: the system trust store
// lives in CryptoAPI, which this package does not read. These are the bundles
// that common toolchains install, and they are the only reason a native
// Windows build finds any roots. Without one, _roots_load returns an empty
// store and every chain fails closed, which is correct but unhelpful; set
// SSL_CERT_FILE or Config.ca_file to fix it explicitly.
const CA_PATH_7 := "C:/Program Files/Git/mingw64/etc/ssl/certs/ca-bundle.crt"
const CA_PATH_8 := "C:/Program Files/Git/usr/ssl/certs/ca-bundle.crt"
const CA_PATH_9 := "C:/msys64/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
// NetBSD's pkgsrc mozilla-rootcerts package installs here (no native
// keychain-style API exists on NetBSD/FreeBSD/OpenBSD, unlike macOS, so a
// flat file is the only source on those three).
const CA_PATH_10 := "/usr/pkg/etc/openssl/certs/ca-certificates.crt"
const CA_PATH_COUNT := 11

mut _shared_roots := Roots {}
mut _shared_key := ""
mut _shared_ready := false

func _ca_path(i: int): str:
    if i == 0: ret CA_PATH_0 end
    if i == 1: ret CA_PATH_1 end
    if i == 2: ret CA_PATH_2 end
    if i == 3: ret CA_PATH_3 end
    if i == 4: ret CA_PATH_4 end
    if i == 5: ret CA_PATH_5 end
    if i == 6: ret CA_PATH_6 end
    if i == 7: ret CA_PATH_7 end
    if i == 8: ret CA_PATH_8 end
    if i == 9: ret CA_PATH_9 end
    if i == 10: ret CA_PATH_10 end
    ret ""
end

// Scan a PEM document and append every CERTIFICATE block to the store.
// Anything that is not a CERTIFICATE block, and any block that fails to decode
// or to parse as a certificate, is skipped rather than aborting the load: a
// real system bundle occasionally carries entries this profile cannot use, and
// one of those should not cost the caller every other root.
func _roots_add_pem(r &: Roots, pem: str): int:
    mut added := 0
    mut pos := 0
    n := pem.len()
    until pos < n:
        b := str.IndexFrom(pem, PEM_BEGIN, pos)
        if b < 0:
            ret added
        end
        body := b + PEM_BEGIN.len()
        e := str.IndexFrom(pem, PEM_END, body)
        if e < 0:
            ret added
        end
        room := (e - body) / 4 * 3 + 8
        mut der := _newbuf(room)
        mut good := false
        b64 := pem.substr(body, e - body)
        got := encoding.Base64DecodeBytes(b64, der.p, room, good)
        mem.Free(b64 as void*)
        if good && got > 0:
            c := _cert_parse(der.p, got)
            if c.ok:
                _roots_add(r, der.p, got)
                added += 1
            end
        end
        _buf_free(der)
        pos = e + PEM_END.len()
    end
    ret added
end

// Overridden by a generated roots_embedded.salam when one is present.
func _embedded_roots_pem(): str:
    ret ""
end

if SALAM_OS_WIN64:
    func _roots_load_native(r &: Roots): int:
        store := CertOpenSystemStoreA(0, "ROOT")
        if store == null:
            ret 0
        end
        mut added := 0
        mut ctx := null as void*
        mut going := true
        until going:
            ctx = CertEnumCertificatesInStore(store, ctx)
            if ctx == null:
                going = false
            else:
                pp := (ctx as i64 + 8) as i64*
                lp := (ctx as i64 + 16) as int*
                der := pp[0] as void*
                dlen := lp[0]
                if der != null && dlen > 0:
                    _roots_add(r, der, dlen)
                    added += 1
                end
            end
        end
        CertCloseStore(store, 0)
        ret added
    end
else:
    if SALAM_OS_MAC:
        // SecTrustCopyAnchorCertificates returns the OS's built-in anchor set
        // (the root-program membership Schannel/Keychain trust by default) -
        // not per-user Keychain trust overrides, which would need the
        // heavier SecTrustSettingsCopyCertificates + per-entry trust-state
        // checks. The simpler call matches what this store already does on
        // every other platform: a root-program bundle, no admin overrides.
        func _roots_load_native(r &: Roots): int:
            outbuf := mem.Allocate(8 as u64)
            defer mem.Free(outbuf)
            outp := outbuf as i64*
            outp[0] = 0
            status := SecTrustCopyAnchorCertificates(outbuf)
            if status != 0:
                ret 0
            end
            arr := outp[0] as void*
            if arr == null:
                ret 0
            end
            defer CFRelease(arr)
            n := CFArrayGetCount(arr)
            mut added := 0
            mut i := 0 as i64
            until i >= n:
                cert := CFArrayGetValueAtIndex(arr, i)
                if cert != null:
                    data := SecCertificateCopyData(cert)
                    if data != null:
                        p := CFDataGetBytePtr(data)
                        dlen := CFDataGetLength(data)
                        if p != null && dlen > 0:
                            _roots_add(r, p, dlen as int)
                            added += 1
                        end
                        CFRelease(data)
                    end
                end
                i += 1
            end
            ret added
        end
    else:
        func _roots_load_native(_r &: Roots): int:
            ret 0
        end
    end
end

func _roots_load_file(r &: Roots, path: str): int:
    if path.len() == 0:
        ret 0
    end
    if !os.Exists(path):
        ret 0
    end
    pem := io.ReadFile(path)
    if pem.len() == 0:
        mem.Free(pem as void*)
        ret 0
    end
    added := _roots_add_pem(r, pem)
    mem.Free(pem as void*)
    ret added
end

/*
 * The trust store, loaded once per process.
 *
 * A system bundle is a hundred-odd certificates to read, base64-decode and
 * parse; doing that inside every handshake made a client that talks to one
 * host repeatedly spend most of its time - and most of its memory - on work
 * whose answer never changes. The store is keyed by the file it came from,
 * so a Config naming its own CA still gets its own, and nothing frees what
 * is handed back: the cache owns it for the life of the process.
 */
func _roots_shared(ca_file: str): Roots:
    if _shared_ready && _shared_key == ca_file:
        ret _shared_roots
    end
    if _shared_ready:
        _roots_free(_shared_roots)
    end
    _shared_roots = _roots_load(ca_file)
    _shared_key = ca_file
    _shared_ready = true
    ret _shared_roots
end

func _roots_load(ca_file: str): Roots:
    mut r := _roots_new()
    if ca_file.len() > 0:
        _roots_load_file(r, ca_file)
        ret r
    end
    env := os.Env("SSL_CERT_FILE")
    if env.len() > 0:
        _roots_load_file(r, env)
        ret r
    end
    if _roots_load_native(r) > 0:
        ret r
    end
    mut i := 0
    until i < CA_PATH_COUNT:
        if _roots_load_file(r, _ca_path(i)) > 0:
            ret r
        end
        i += 1
    end
    emb := _embedded_roots_pem()
    if emb.len() > 0:
        _roots_add_pem(r, emb)
    end
    ret r
end
