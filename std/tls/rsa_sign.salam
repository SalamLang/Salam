package tls

func _rsa_sign_pkcs1(kind: int, digest: void*, n: Buf, crt: RsaCrt*, sigout: void*): bool:
    klen := n.len
    if klen < 16 or klen > RSA_MAX_BYTES:
        ret false
    end
    hlen := _hash_size(kind)
    mut di := _hexbuf(_rsa_digestinfo(kind))
    defer _buf_free(di)
    tlen := di.len + hlen
    if klen < tlen + 11:
        ret false
    end
    mut em := _newbuf(klen)
    defer _buf_free(em)
    _put8(em, 0x00)
    _put8(em, 0x01)
    pslen := klen - tlen - 3
    repeat pslen:
        _put8(em, 0xFF)
    end
    _put8(em, 0x00)
    _putbuf(em, di)
    _putraw(em, digest, hlen)
    ret _rsa_private_op(crt, em.p, em.len, sigout, klen)
end

func _rsa_sign_pss(kind: int, digest: void*, n: Buf, crt: RsaCrt*, slen: int, sigout: void*): bool:
    klen := n.len
    if klen < 16 or klen > RSA_MAX_BYTES:
        ret false
    end
    hlen := _hash_size(kind)

    mut nbig := _big_from_bytes(n.p, n.len)
    defer _big_free(nbig)
    modbits := _big_bitlen(nbig)
    if modbits < 2:
        ret false
    end
    emlen := (modbits - 1 + 7) / 8
    if emlen < hlen + slen + 2:
        ret false
    end
    dblen := emlen - hlen - 1
    skip := klen - emlen

    mut salt := _newbuf(slen)
    defer _buf_wipe(salt)
    _putzeros(salt, slen)
    crypto.RandomBytes(salt.p, slen)

    mut mprime := _newbuf(8 + hlen + slen)
    defer _buf_free(mprime)
    _putzeros(mprime, 8)
    _putraw(mprime, digest, hlen)
    _putbuf(mprime, salt)
    mut hpr := _newbuf(hlen)
    defer _buf_free(hpr)
    _putzeros(hpr, hlen)
    _hash_oneshot(kind, mprime.p, mprime.len, hpr.p)

    mut dbmask := _newbuf(dblen)
    defer _buf_free(dbmask)
    _putzeros(dbmask, dblen)
    _mgf1(kind, hpr.p, hlen, dbmask.p, dblen)

    pslen := dblen - slen - 1
    mut em := _newbuf(klen)
    defer _buf_free(em)
    _putzeros(em, skip)
    repeat pslen in i:
        _put8(em, 0x00 ^ _bufat(dbmask, i))
    end
    _put8(em, 0x01 ^ _bufat(dbmask, pslen))
    repeat slen in i:
        _put8(em, _bufat(salt, i) ^ _bufat(dbmask, pslen + 1 + i))
    end
    unused := 8 * emlen - (modbits - 1)
    topmask := (0xFF >> unused) & 0xFF
    _bufset(em, skip, _bufat(em, skip) & topmask)
    _putbuf(em, hpr)
    _put8(em, 0xbc)

    ret _rsa_private_op(crt, em.p, em.len, sigout, klen)
end
