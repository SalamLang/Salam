package tls

// Self-test harness: the checks themselves live in the selftest_* files
// alongside this one, grouped by the layer they exercise.


mut _st_fails := 0
mut _st_total := 0

func _ck(cond: bool, name: str):
    _st_total += 1
    if !cond:
        _st_fails += 1
        println "  FAIL:", name
    end
end

func _ckhex(got: str, want: str, name: str):
    _st_total += 1
    if got != want:
        _st_fails += 1
        println "  FAIL:", name
        println "    got  ", got
        println "    want ", want
    end
end

@en "SelfTest"
@fa "خودآزمایی"
@ar "اختبار ذاتی"
pub func SelfTest(): int:
    _st_fails = 0
    _st_total = 0
    println "tls self-test"
    _selftest_bytes()
    _selftest_sha()
    _selftest_prf()
    _selftest_legacy()
    _selftest_hmac()
    _selftest_hkdf()
    _selftest_chacha()
    _selftest_aes()
    _selftest_bigint()
    _selftest_x25519()
    _selftest_p256()
    _selftest_p384()
    _selftest_sig()
    _selftest_sign()
    _selftest_x509()
    _selftest_ip()
    _selftest_verify()
    _selftest_roots()
    _selftest_fuzz()
    if _st_fails == 0:
        println "tls self-test:", _st_total, "checks passed"
    else:
        println "tls self-test:", _st_fails, "of", _st_total, "checks FAILED"
    end
    ret _st_fails
end
