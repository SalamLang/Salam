package tls

// DER certificate fixtures for the X.509 self-tests.
//
// Generated once with OpenSSL (via python-cryptography) and pinned here, so the
// parser is checked against encodings a real CA toolchain produces rather than
// against anything this codebase wrote itself. Regenerating them is fine; the
// self-test asserts on structure, not on the exact key material.
//
//   TC_ROOT     RSA-2048 self-signed CA, basicConstraints CA:TRUE pathlen:1
//   TC_LEAF     P-256 leaf signed by TC_ROOT with RSA PKCS#1 v1.5 + SHA-256,
//               SANs example.com and *.example.com, EKU serverAuth
//   TC_EXPIRED  same shape, validity window entirely in the past
//   TC_PSS      same shape, signed with RSASSA-PSS + SHA-256 instead
//   TC_EC_ROOT  P-256 self-signed CA signed with ECDSA + SHA-256

const TC_ROOT := ""

const TC_LEAF := ""

const TC_EXPIRED := ""

const TC_PSS := ""

const TC_EC_ROOT := ""

