@en "tls"
@fa "تی ال اس"
@ar "تی ال اس"
package tls

// Native TLS for Salam.
//
// ============================ SECURITY STATUS ============================
// EXPERIMENTAL. This implementation has NOT had independent cryptographic
// review. Do not use it to protect real secrets. The vetted paths remain
// libcurl/OpenSSL (Unix) and WinHTTP (Windows); this package is reached only
// when a program is built with -DSALAM_NATIVE_TLS.
// =========================================================================
//
// Scope: TLS 1.3 with a TLS 1.2 fallback, X25519 and secp256r1 key exchange,
// AEAD cipher suites only (ChaCha20-Poly1305 and AES-GCM; no CBC suites, so
// no MAC-then-encrypt padding oracles). Certificates are verified against the
// system trust store with an embedded fallback.

// TLS 1.0 (0x0301) and 1.1 (0x0302) are deliberately NOT implemented.
//
// RFC 8996 deprecated both in 2021 and every major browser dropped them in
// 2020. Supporting them would mean adding the machinery this stack exists to
// avoid: CBC cipher suites with MAC-then-encrypt (the BEAST and Lucky13
// padding-oracle families), an MD5+SHA-1 PRF, and SHA-1 signatures. A server
// offering only 1.0/1.1 today is already broken, so the compatibility gained
// does not pay for that surface.
//
// The version constants and negotiation are written so a legacy path could be
// added later behind its own explicitly-unsafe build flag, but nothing here
// will negotiate below TLS 1.2.

@en "TLS10"
@fa "تی ال اس ۱۰"
@ar "تی ال اس ۱۰"
pub const TLS10 := 0x0301

@en "TLS11"
@fa "تی ال اس ۱۱"
@ar "تی ال اس ۱۱"
pub const TLS11 := 0x0302

@en "TLS12"
@fa "تی ال اس ۱۲"
@ar "تی ال اس ۱۲"
pub const TLS12 := 0x0303

@en "TLS13"
@fa "تی ال اس ۱۳"
@ar "تی ال اس ۱۳"
pub const TLS13 := 0x0304

// ---------------------------------------------------------------- byte utils
//
// Exposed so the test-vector suites can build, inspect and release byte
// strings without duplicating a hex codec.

@en "HexEncodeBuf"
@fa "کدگذاری شانزدهی"
@ar "ترمیز سداسی"
pub func HexEncodeBuf(b: Buf): str:
    ret _hexofbuf(b)
end

@en "HexDecodeBuf"
@fa "کدگشایی شانزدهی"
@ar "فك ترمیز سداسی"
pub func HexDecodeBuf(s: str): Buf:
    ret _hexbuf(s)
end

@en "NewBuf"
@fa "بافر جدید"
@ar "مخزن جدید"
pub func NewBuf(cap: int): Buf:
    ret _newbuf(cap)
end

@en "FreeBuf"
@fa "آزادسازی بافر"
@ar "تحریر المخزن"
pub func FreeBuf(b &: Buf):
    _buf_free(b)
end

@en "WipeBuf"
@fa "پاک سازی بافر"
@ar "مسح المخزن"
pub func WipeBuf(b &: Buf):
    _buf_wipe(b)
end

@en "BufLen"
@fa "طول بافر"
@ar "طول المخزن"
pub func BufLen(b: Buf): int:
    ret b.len
end

@en "BufAppendStr"
@fa "افزودن رشته به بافر"
@ar "إلحاق نص بالمخزن"
pub func BufAppendStr(b &: Buf, s: str):
    _putstr(b, s)
end
