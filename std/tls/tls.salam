@en "tls"
@fa "تی ال اس"
@ar "تی ال اس"
package tls

// Native TLS for Salam.
//
// ============================ SECURITY STATUS ============================
// EXPERIMENTAL. This implementation has NOT had independent cryptographic
// review. Do not use it to protect real secrets. It is nonetheless the
// default (and only) TLS backend for std/http on non-Windows targets;
// Windows still uses the OS-provided WinHTTP. There is no libcurl/OpenSSL
// fallback anymore - std/http has none of those dependencies.
// =========================================================================
//
// Scope: TLS 1.3 with a TLS 1.2 fallback, X25519 and secp256r1 key exchange,
// AEAD cipher suites only (ChaCha20-Poly1305 and AES-GCM; no CBC suites, so
// no MAC-then-encrypt padding oracles). Certificates are verified against the
// system trust store with an embedded fallback.
//
// Both roles are supported: Dial() for clients, and NewServerConfig() +
// WrapServer() for servers (RSA and ECDSA leaf certs, PKCS#1/SEC1/PKCS#8
// private keys). Server-side signing uses RSA blinding against timing
// side-channels and RFC 6979 deterministic nonces for ECDSA. See
// privkey.salam, rsa_sign.salam, ecdsa_sign.salam, serverdriver*.salam.

// TLS 1.0 (0x0301) and 1.1 (0x0302) are deliberately NOT implemented.
//
// RFC 8996 deprecated both in 2021 and every major browser dropped them in
// 2020. Supporting them would mean adding the machinery this stack exists to
// avoid: CBC cipher suites with MAC-then-encrypt (the BEAST and Lucky13
// padding-oracle families), an MD5+SHA-1 PRF, and SHA-1 signatures. A server
// offering only 1.0/1.1 today is already broken, so the compatibility gained
// does not pay for that surface.
//
// The version constants and negotiation are written so a legacy path could be
// added later behind its own explicitly-unsafe build flag, but nothing here
// will negotiate below TLS 1.2.

@en "TLS10"
@fa "تی ال اس ۱۰"
@ar "تی ال اس ۱۰"
pub const TLS10 := 0x0301

@en "TLS11"
@fa "تی ال اس ۱۱"
@ar "تی ال اس ۱۱"
pub const TLS11 := 0x0302

@en "TLS12"
@fa "تی ال اس ۱۲"
@ar "تی ال اس ۱۲"
pub const TLS12 := 0x0303

@en "TLS13"
@fa "تی ال اس ۱۳"
@ar "تی ال اس ۱۳"
pub const TLS13 := 0x0304

// ---------------------------------------------------------------- byte utils
//
// Exposed so the test-vector suites can build, inspect and release byte
// strings without duplicating a hex codec.

@en "HexEncodeBuf"
@fa "کدگذاری شانزدهی"
@ar "ترمیز سداسی"
pub func HexEncodeBuf(b: Buf): str:
    ret _hexofbuf(b)
end

@en "HexDecodeBuf"
@fa "کدگشایی شانزدهی"
@ar "فك ترمیز سداسی"
pub func HexDecodeBuf(s: str): Buf:
    ret _hexbuf(s)
end

@en "NewBuf"
@fa "بافر جدید"
@ar "مخزن جدید"
pub func NewBuf(cap: int): Buf:
    ret _newbuf(cap)
end

// A Buf's length only grows through an explicit put/append; NewBuf(n) alone
// gives n bytes of capacity with length 0 - not n usable bytes. This is for
// a caller that wants n zeroed, WRITABLE (Buf.p can be handed to a
// C-level/pointer-taking function) bytes upfront, e.g. as a signature
// output buffer before SignRSAPKCS1/SignECDSA.
@en "NewZeroBuf"
@fa "بافر صفر جدید"
@ar "مخزن صفري جدید"
pub func NewZeroBuf(n: int): Buf:
    mut b := _newbuf(n)
    _putzeros(b, n)
    ret b
end

@en "FreeBuf"
@fa "آزادسازی بافر"
@ar "تحریر المخزن"
pub func FreeBuf(b &: Buf):
    _buf_free(b)
end

@en "WipeBuf"
@fa "پاک سازی بافر"
@ar "مسح المخزن"
pub func WipeBuf(b &: Buf):
    _buf_wipe(b)
end

@en "BufLen"
@fa "طول بافر"
@ar "طول المخزن"
pub func BufLen(b: Buf): int:
    ret b.len
end

@en "BufAppendStr"
@fa "افزودن رشته به بافر"
@ar "إلحاق نص بالمخزن"
pub func BufAppendStr(b &: Buf, s: str):
    _putstr(b, s)
end

// ---------------------------------------------------------------- trust store

@en "LoadRoots"
@fa "بارگذاری ریشه ها"
@ar "تحمیل الجذور"
pub func LoadRoots(ca_file: str): Roots:
    ret _roots_load(ca_file)
end

@en "RootCount"
@fa "تعداد ریشه ها"
@ar "عدد الجذور"
pub func RootCount(r: Roots): int:
    ret r.count
end

@en "FreeRoots"
@fa "آزادسازی ریشه ها"
@ar "تحریر الجذور"
pub func FreeRoots(r &: Roots):
    _roots_free(r)
end

// ---------------------------------------------------------------- certificates

@en "VerifyError"
@fa "خطای تایید"
@ar "خطأ التحقق"
pub func VerifyError(code: int): str:
    ret _verr_str(code)
end

// Verify a single DER certificate against a trust store for `host`, using the
// current system time. Returns 0 on success, or a VerifyError code.
//
// This is the one-certificate case; a full handshake passes the server's whole
// chain instead.
@en "VerifyCert"
@fa "تایید گواهی"
@ar "تحقق الشهادة"
pub func VerifyCert(der: Buf, roots: Roots, host: str): int:
    mut ch: Reader[8]
    repeat 8 with i:
        ch[i] = _newreader(null, 0)
    end
    ch[0] = _readerof(der)
    ret _verify_chain(ch, 1, roots, host, _now_stamp())
end

// Parse a DER certificate and report whether it is well formed. Exposed mostly
// so tooling can check a bundle without attempting to trust it.
@en "CertIsValid"
@fa "گواهی معتبر است"
@ar "الشهادة صالحة"
pub func CertIsValid(der: Buf): bool:
    c := _cert_parse(der.p, der.len)
    ret c.ok
end

@en "CertSubjectCN"
@fa "نام مشترک گواهی"
@ar "الاسم الشائع للشهادة"
pub func CertSubjectCN(der: Buf): str:
    c := _cert_parse(der.p, der.len)
    if !c.ok:
        ret ""
    end
    ret c.subject_cn
end

// ---------------------------------------------------------------- signing
//
// Exposed for the cross-tool interop check (sign here, verify with OpenSSL,
// and the reverse) and for anything outside the package needing raw
// signing without a full handshake - the handshake driver itself will call
// straight into rsa_sign.salam/ecdsa_sign.salam.

@en "HashDigest"
@fa "درهم ساز"
@ar "دالة اختزال"
pub func HashDigest(sha384: bool, msg: str): Buf:
    mut kind := 0 // HASH_SHA256
    mut hlen := 32
    if sha384:
        kind = HASH_SHA384
        hlen = 48
    end
    mut d := _newbuf(hlen)
    _putzeros(d, hlen)
    _hash_oneshot(kind, msg as void*, msg.len(), d.p)
    ret d
end

@en "SignRSAPKCS1"
@fa "امضای آر اس ای پی کی سی اس یک"
@ar "توقيع آر إس إيه بي كي سي إس ون"
pub func SignRSAPKCS1(k: PrivateKey, sha384: bool, digest: Buf, sigout: Buf): bool:
    mut kind := 0 // HASH_SHA256
    if sha384:
        kind = HASH_SHA384
    end
    ret _rsa_sign_pkcs1(kind, digest.p, k.rsa_n, k.rsa_e, k.rsa_d, k.rsa_phi, sigout.p)
end

@en "SignRSAPSS"
@fa "امضای آر اس ای پی اس اس"
@ar "توقيع آر إس إيه بي إس إس"
pub func SignRSAPSS(k: PrivateKey, sha384: bool, digest: Buf, sigout: Buf): bool:
    mut kind := 0 // HASH_SHA256
    mut slen := 32
    if sha384:
        kind = HASH_SHA384
        slen = 48
    end
    ret _rsa_sign_pss(kind, digest.p, k.rsa_n, k.rsa_e, k.rsa_d, k.rsa_phi, slen, sigout.p)
end

@en "SignECDSA"
@fa "امضای بیضوی"
@ar "توقيع منحني بيضوي"
pub func SignECDSA(k: PrivateKey, digest: Buf, rout: Buf, sout: Buf): bool:
    if k.pk_alg == PK_EC_P384:
        ret _ecdsa_sign(_curve_p384(), HASH_SHA384, k.ec_scalar.p, digest.p, digest.len, rout.p, sout.p)
    end
    ret _ecdsa_sign(_curve_p256(), HASH_SHA256, k.ec_scalar.p, digest.p, digest.len, rout.p, sout.p)
end

@en "ECDSADerEncode"
@fa "کدگذاری دی ای آر بیضوی"
@ar "ترميز دي إي آر منحني بيضوي"
pub func ECDSADerEncode(rbytes: Buf, sbytes: Buf, width: int): Buf:
    mut out := _newbuf(2 * width + 8)
    _ecdsa_der_encode(rbytes.p, sbytes.p, width, out)
    ret out
end

// Reverse-direction interop check: something else (OpenSSL) signed, this
// verifies. Takes the PrivateKey only for its public components (n/e, or
// the EC point derived from the scalar) - the digest and signature are the
// untrusted-until-verified inputs.
@en "VerifyRSAPSSWithKey"
@fa "تایید آر اس ای پی اس اس با کلید"
@ar "تحقق آر إس إيه بي إس إس بالمفتاح"
pub func VerifyRSAPSSWithKey(k: PrivateKey, sha384: bool, digest: Buf, sig: Buf): bool:
    mut kind := 0 // HASH_SHA256
    mut slen := 32
    if sha384:
        kind = 1 // HASH_SHA384
        slen = 48
    end
    ret _rsa_verify_pss(kind, digest.p, k.rsa_n.p, k.rsa_n.len, k.rsa_e.p, k.rsa_e.len, sig.p, sig.len, slen)
end

@en "VerifyECDSADERWithKey"
@fa "تایید دی ای آر بیضوی با کلید"
@ar "تحقق دي إي آر منحني بيضوي بالمفتاح"
pub func VerifyECDSADERWithKey(k: PrivateKey, digest: Buf, dersig: Buf): bool:
    mut cv := _curve_p256()
    if k.pk_alg == PK_EC_P384:
        cv = _curve_p384()
    end
    mut xb := _newbuf(cv.nb)
    _putzeros(xb, cv.nb)
    mut yb := _newbuf(cv.nb)
    _putzeros(yb, cv.nb)
    if !_ec_base_mul(cv, k.ec_scalar.p, xb.p, yb.p):
        ret false
    end
    mut pubkey := _newbuf(1 + 2 * cv.nb)
    _put8(pubkey, 0x04)
    _putbuf(pubkey, xb)
    _putbuf(pubkey, yb)
    mut rb := _newbuf(cv.nb)
    mut sb := _newbuf(cv.nb)
    if !_ecdsa_split(_readerof(dersig), rb, sb, cv.nb):
        ret false
    end
    ret _ecdsa_verify(cv, digest.p, digest.len, rb.p, sb.p, pubkey.p, pubkey.len)
end
