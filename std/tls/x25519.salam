package tls

import mem

const X25519_SIZE := 32

const X_LIMBS := 10
const X_SLOT := 80

func _fe25519_mul(h: i64*, f: i64*, g: i64*):
    f0 := f[0]
    f1 := f[1]
    f2 := f[2]
    f3 := f[3]
    f4 := f[4]
    f5 := f[5]
    f6 := f[6]
    f7 := f[7]
    f8 := f[8]
    f9 := f[9]
    g0 := g[0]
    g1 := g[1]
    g2 := g[2]
    g3 := g[3]
    g4 := g[4]
    g5 := g[5]
    g6 := g[6]
    g7 := g[7]
    g8 := g[8]
    g9 := g[9]
    g1x := g1 * (19 as i64)
    g2x := g2 * (19 as i64)
    g3x := g3 * (19 as i64)
    g4x := g4 * (19 as i64)
    g5x := g5 * (19 as i64)
    g6x := g6 * (19 as i64)
    g7x := g7 * (19 as i64)
    g8x := g8 * (19 as i64)
    g9x := g9 * (19 as i64)
    f1d := f1 * (2 as i64)
    f3d := f3 * (2 as i64)
    f5d := f5 * (2 as i64)
    f7d := f7 * (2 as i64)
    f9d := f9 * (2 as i64)
    mut h0 := f0 * g0 + f1d * g9x + f2 * g8x + f3d * g7x + f4 * g6x + f5d * g5x + f6 * g4x + f7d * g3x + f8 * g2x + f9d * g1x
    mut h1 := f0 * g1 + f1 * g0 + f2 * g9x + f3 * g8x + f4 * g7x + f5 * g6x + f6 * g5x + f7 * g4x + f8 * g3x + f9 * g2x
    mut h2 := f0 * g2 + f1d * g1 + f2 * g0 + f3d * g9x + f4 * g8x + f5d * g7x + f6 * g6x + f7d * g5x + f8 * g4x + f9d * g3x
    mut h3 := f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0 + f4 * g9x + f5 * g8x + f6 * g7x + f7 * g6x + f8 * g5x + f9 * g4x
    mut h4 := f0 * g4 + f1d * g3 + f2 * g2 + f3d * g1 + f4 * g0 + f5d * g9x + f6 * g8x + f7d * g7x + f8 * g6x + f9d * g5x
    mut h5 := f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0 + f6 * g9x + f7 * g8x + f8 * g7x + f9 * g6x
    mut h6 := f0 * g6 + f1d * g5 + f2 * g4 + f3d * g3 + f4 * g2 + f5d * g1 + f6 * g0 + f7d * g9x + f8 * g8x + f9d * g7x
    mut h7 := f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0 + f8 * g9x + f9 * g8x
    mut h8 := f0 * g8 + f1d * g7 + f2 * g6 + f3d * g5 + f4 * g4 + f5d * g3 + f6 * g2 + f7d * g1 + f8 * g0 + f9d * g9x
    mut h9 := f0 * g9 + f1 * g8 + f2 * g7 + f3 * g6 + f4 * g5 + f5 * g4 + f6 * g3 + f7 * g2 + f8 * g1 + f9 * g0
    mut c := 0 as i64
    c = (h0 + (33554432 as i64)) >> (26 as i64)
    h1 += c
    h0 -= c << (26 as i64)
    c = (h4 + (33554432 as i64)) >> (26 as i64)
    h5 += c
    h4 -= c << (26 as i64)
    c = (h1 + (16777216 as i64)) >> (25 as i64)
    h2 += c
    h1 -= c << (25 as i64)
    c = (h5 + (16777216 as i64)) >> (25 as i64)
    h6 += c
    h5 -= c << (25 as i64)
    c = (h2 + (33554432 as i64)) >> (26 as i64)
    h3 += c
    h2 -= c << (26 as i64)
    c = (h6 + (33554432 as i64)) >> (26 as i64)
    h7 += c
    h6 -= c << (26 as i64)
    c = (h3 + (16777216 as i64)) >> (25 as i64)
    h4 += c
    h3 -= c << (25 as i64)
    c = (h7 + (16777216 as i64)) >> (25 as i64)
    h8 += c
    h7 -= c << (25 as i64)
    c = (h4 + (33554432 as i64)) >> (26 as i64)
    h5 += c
    h4 -= c << (26 as i64)
    c = (h8 + (33554432 as i64)) >> (26 as i64)
    h9 += c
    h8 -= c << (26 as i64)
    c = (h9 + (16777216 as i64)) >> (25 as i64)
    h0 += c * (19 as i64)
    h9 -= c << (25 as i64)
    c = (h0 + (33554432 as i64)) >> (26 as i64)
    h1 += c
    h0 -= c << (26 as i64)
    h[0] = h0
    h[1] = h1
    h[2] = h2
    h[3] = h3
    h[4] = h4
    h[5] = h5
    h[6] = h6
    h[7] = h7
    h[8] = h8
    h[9] = h9
end

func _fe25519_sq(h: i64*, f: i64*):
    f0 := f[0]
    f1 := f[1]
    f2 := f[2]
    f3 := f[3]
    f4 := f[4]
    f5 := f[5]
    f6 := f[6]
    f7 := f[7]
    f8 := f[8]
    f9 := f[9]
    f0d := f0 * (2 as i64)
    f1d := f1 * (2 as i64)
    f2d := f2 * (2 as i64)
    f3d := f3 * (2 as i64)
    f4d := f4 * (2 as i64)
    f5d := f5 * (2 as i64)
    f6d := f6 * (2 as i64)
    f7d := f7 * (2 as i64)
    f5x := f5 * (38 as i64)
    f6x := f6 * (19 as i64)
    f7x := f7 * (38 as i64)
    f8x := f8 * (19 as i64)
    f9x := f9 * (38 as i64)
    mut h0 := f0 * f0 + f1d * f9x + f2d * f8x + f3d * f7x + f4d * f6x + f5 * f5x
    mut h1 := f0d * f1 + f2 * f9x + f3d * f8x + f4 * f7x + f5d * f6x
    mut h2 := f0d * f2 + f1d * f1 + f3d * f9x + f4d * f8x + f5d * f7x + f6 * f6x
    mut h3 := f0d * f3 + f1d * f2 + f4 * f9x + f5d * f8x + f6 * f7x
    mut h4 := f0d * f4 + f1d * f3d + f2 * f2 + f5d * f9x + f6d * f8x + f7 * f7x
    mut h5 := f0d * f5 + f1d * f4 + f2d * f3 + f6 * f9x + f7d * f8x
    mut h6 := f0d * f6 + f1d * f5d + f2d * f4 + f3d * f3 + f7d * f9x + f8 * f8x
    mut h7 := f0d * f7 + f1d * f6 + f2d * f5 + f3d * f4 + f8 * f9x
    mut h8 := f0d * f8 + f1d * f7d + f2d * f6 + f3d * f5d + f4 * f4 + f9 * f9x
    mut h9 := f0d * f9 + f1d * f8 + f2d * f7 + f3d * f6 + f4d * f5
    mut c := 0 as i64
    c = (h0 + (33554432 as i64)) >> (26 as i64)
    h1 += c
    h0 -= c << (26 as i64)
    c = (h4 + (33554432 as i64)) >> (26 as i64)
    h5 += c
    h4 -= c << (26 as i64)
    c = (h1 + (16777216 as i64)) >> (25 as i64)
    h2 += c
    h1 -= c << (25 as i64)
    c = (h5 + (16777216 as i64)) >> (25 as i64)
    h6 += c
    h5 -= c << (25 as i64)
    c = (h2 + (33554432 as i64)) >> (26 as i64)
    h3 += c
    h2 -= c << (26 as i64)
    c = (h6 + (33554432 as i64)) >> (26 as i64)
    h7 += c
    h6 -= c << (26 as i64)
    c = (h3 + (16777216 as i64)) >> (25 as i64)
    h4 += c
    h3 -= c << (25 as i64)
    c = (h7 + (16777216 as i64)) >> (25 as i64)
    h8 += c
    h7 -= c << (25 as i64)
    c = (h4 + (33554432 as i64)) >> (26 as i64)
    h5 += c
    h4 -= c << (26 as i64)
    c = (h8 + (33554432 as i64)) >> (26 as i64)
    h9 += c
    h8 -= c << (26 as i64)
    c = (h9 + (16777216 as i64)) >> (25 as i64)
    h0 += c * (19 as i64)
    h9 -= c << (25 as i64)
    c = (h0 + (33554432 as i64)) >> (26 as i64)
    h1 += c
    h0 -= c << (26 as i64)
    h[0] = h0
    h[1] = h1
    h[2] = h2
    h[3] = h3
    h[4] = h4
    h[5] = h5
    h[6] = h6
    h[7] = h7
    h[8] = h8
    h[9] = h9
end

func _fe25519_sqn(h: i64*, f: i64*, n: int):
    _fe25519_sq(h, f)
    repeat n - 1:
        _fe25519_sq(h, h)
    end
end

func _fe25519_add(h: i64*, f: i64*, g: i64*):
    repeat X_LIMBS in i:
        h[i] = f[i] + g[i]
    end
end

func _fe25519_sub(h: i64*, f: i64*, g: i64*):
    repeat X_LIMBS in i:
        h[i] = f[i] - g[i]
    end
end

func _fe25519_copy(h: i64*, f: i64*):
    repeat X_LIMBS in i:
        h[i] = f[i]
    end
end

func _fe25519_cswap(f: i64*, g: i64*, b: i64):
    mask := (0 as i64) - b
    repeat X_LIMBS in i:
        x := (f[i] ^ g[i]) & mask
        f[i] ^= x
        g[i] ^= x
    end
end

func _fe25519_mul121666(h: i64*, f: i64*):
    mut h0 := f[0] * (121666 as i64)
    mut h1 := f[1] * (121666 as i64)
    mut h2 := f[2] * (121666 as i64)
    mut h3 := f[3] * (121666 as i64)
    mut h4 := f[4] * (121666 as i64)
    mut h5 := f[5] * (121666 as i64)
    mut h6 := f[6] * (121666 as i64)
    mut h7 := f[7] * (121666 as i64)
    mut h8 := f[8] * (121666 as i64)
    mut h9 := f[9] * (121666 as i64)
    mut c := 0 as i64
    c = (h0 + (33554432 as i64)) >> (26 as i64)
    h1 += c
    h0 -= c << (26 as i64)
    c = (h4 + (33554432 as i64)) >> (26 as i64)
    h5 += c
    h4 -= c << (26 as i64)
    c = (h1 + (16777216 as i64)) >> (25 as i64)
    h2 += c
    h1 -= c << (25 as i64)
    c = (h5 + (16777216 as i64)) >> (25 as i64)
    h6 += c
    h5 -= c << (25 as i64)
    c = (h2 + (33554432 as i64)) >> (26 as i64)
    h3 += c
    h2 -= c << (26 as i64)
    c = (h6 + (33554432 as i64)) >> (26 as i64)
    h7 += c
    h6 -= c << (26 as i64)
    c = (h3 + (16777216 as i64)) >> (25 as i64)
    h4 += c
    h3 -= c << (25 as i64)
    c = (h7 + (16777216 as i64)) >> (25 as i64)
    h8 += c
    h7 -= c << (25 as i64)
    c = (h4 + (33554432 as i64)) >> (26 as i64)
    h5 += c
    h4 -= c << (26 as i64)
    c = (h8 + (33554432 as i64)) >> (26 as i64)
    h9 += c
    h8 -= c << (26 as i64)
    c = (h9 + (16777216 as i64)) >> (25 as i64)
    h0 += c * (19 as i64)
    h9 -= c << (25 as i64)
    c = (h0 + (33554432 as i64)) >> (26 as i64)
    h1 += c
    h0 -= c << (26 as i64)
    h[0] = h0
    h[1] = h1
    h[2] = h2
    h[3] = h3
    h[4] = h4
    h[5] = h5
    h[6] = h6
    h[7] = h7
    h[8] = h8
    h[9] = h9
end

inline func _x_load3(p: void*, o: int): i64:
    ret (_bget(p, o) as i64) | ((_bget(p, o + 1) as i64) << (8 as i64)) | ((_bget(p, o + 2) as i64) << (16 as i64))
end

inline func _x_load4(p: void*, o: int): i64:
    ret _x_load3(p, o) | ((_bget(p, o + 3) as i64) << (24 as i64))
end

func _fe25519_frombytes(h: i64*, s: void*):
    mut h0 := _x_load4(s, 0)
    mut h1 := _x_load3(s, 4) << (6 as i64)
    mut h2 := _x_load3(s, 7) << (5 as i64)
    mut h3 := _x_load3(s, 10) << (3 as i64)
    mut h4 := _x_load3(s, 13) << (2 as i64)
    mut h5 := _x_load4(s, 16)
    mut h6 := _x_load3(s, 20) << (7 as i64)
    mut h7 := _x_load3(s, 23) << (5 as i64)
    mut h8 := _x_load3(s, 26) << (4 as i64)
    mut h9 := (_x_load3(s, 29) & (8388607 as i64)) << (2 as i64)
    mut c := (h9 + (16777216 as i64)) >> (25 as i64)
    h0 += c * (19 as i64)
    h9 -= c << (25 as i64)
    c = (h1 + (16777216 as i64)) >> (25 as i64)
    h2 += c
    h1 -= c << (25 as i64)
    c = (h3 + (16777216 as i64)) >> (25 as i64)
    h4 += c
    h3 -= c << (25 as i64)
    c = (h5 + (16777216 as i64)) >> (25 as i64)
    h6 += c
    h5 -= c << (25 as i64)
    c = (h7 + (16777216 as i64)) >> (25 as i64)
    h8 += c
    h7 -= c << (25 as i64)
    c = (h0 + (33554432 as i64)) >> (26 as i64)
    h1 += c
    h0 -= c << (26 as i64)
    c = (h2 + (33554432 as i64)) >> (26 as i64)
    h3 += c
    h2 -= c << (26 as i64)
    c = (h4 + (33554432 as i64)) >> (26 as i64)
    h5 += c
    h4 -= c << (26 as i64)
    c = (h6 + (33554432 as i64)) >> (26 as i64)
    h7 += c
    h6 -= c << (26 as i64)
    c = (h8 + (33554432 as i64)) >> (26 as i64)
    h9 += c
    h8 -= c << (26 as i64)
    h[0] = h0
    h[1] = h1
    h[2] = h2
    h[3] = h3
    h[4] = h4
    h[5] = h5
    h[6] = h6
    h[7] = h7
    h[8] = h8
    h[9] = h9
end

func _fe25519_tobytes(s: void*, h: i64*):
    mut h0 := h[0]
    mut h1 := h[1]
    mut h2 := h[2]
    mut h3 := h[3]
    mut h4 := h[4]
    mut h5 := h[5]
    mut h6 := h[6]
    mut h7 := h[7]
    mut h8 := h[8]
    mut h9 := h[9]
    mut q := (h9 * (19 as i64) + (16777216 as i64)) >> (25 as i64)
    q = (h0 + q) >> (26 as i64)
    q = (h1 + q) >> (25 as i64)
    q = (h2 + q) >> (26 as i64)
    q = (h3 + q) >> (25 as i64)
    q = (h4 + q) >> (26 as i64)
    q = (h5 + q) >> (25 as i64)
    q = (h6 + q) >> (26 as i64)
    q = (h7 + q) >> (25 as i64)
    q = (h8 + q) >> (26 as i64)
    q = (h9 + q) >> (25 as i64)
    h0 += q * (19 as i64)
    mut c := 0 as i64
    c = h0 >> (26 as i64)
    h1 += c
    h0 -= c << (26 as i64)
    c = h1 >> (25 as i64)
    h2 += c
    h1 -= c << (25 as i64)
    c = h2 >> (26 as i64)
    h3 += c
    h2 -= c << (26 as i64)
    c = h3 >> (25 as i64)
    h4 += c
    h3 -= c << (25 as i64)
    c = h4 >> (26 as i64)
    h5 += c
    h4 -= c << (26 as i64)
    c = h5 >> (25 as i64)
    h6 += c
    h5 -= c << (25 as i64)
    c = h6 >> (26 as i64)
    h7 += c
    h6 -= c << (26 as i64)
    c = h7 >> (25 as i64)
    h8 += c
    h7 -= c << (25 as i64)
    c = h8 >> (26 as i64)
    h9 += c
    h8 -= c << (26 as i64)
    c = h9 >> (25 as i64)
    h9 -= c << (25 as i64)
    _bput(s, 0, ((h0) & (255 as i64)) as int)
    _bput(s, 1, (((h0 >> (8 as i64))) & (255 as i64)) as int)
    _bput(s, 2, (((h0 >> (16 as i64))) & (255 as i64)) as int)
    _bput(s, 3, (((h0 >> (24 as i64)) | (h1 << (2 as i64))) & (255 as i64)) as int)
    _bput(s, 4, (((h1 >> (6 as i64))) & (255 as i64)) as int)
    _bput(s, 5, (((h1 >> (14 as i64))) & (255 as i64)) as int)
    _bput(s, 6, (((h1 >> (22 as i64)) | (h2 << (3 as i64))) & (255 as i64)) as int)
    _bput(s, 7, (((h2 >> (5 as i64))) & (255 as i64)) as int)
    _bput(s, 8, (((h2 >> (13 as i64))) & (255 as i64)) as int)
    _bput(s, 9, (((h2 >> (21 as i64)) | (h3 << (5 as i64))) & (255 as i64)) as int)
    _bput(s, 10, (((h3 >> (3 as i64))) & (255 as i64)) as int)
    _bput(s, 11, (((h3 >> (11 as i64))) & (255 as i64)) as int)
    _bput(s, 12, (((h3 >> (19 as i64)) | (h4 << (6 as i64))) & (255 as i64)) as int)
    _bput(s, 13, (((h4 >> (2 as i64))) & (255 as i64)) as int)
    _bput(s, 14, (((h4 >> (10 as i64))) & (255 as i64)) as int)
    _bput(s, 15, (((h4 >> (18 as i64))) & (255 as i64)) as int)
    _bput(s, 16, ((h5) & (255 as i64)) as int)
    _bput(s, 17, (((h5 >> (8 as i64))) & (255 as i64)) as int)
    _bput(s, 18, (((h5 >> (16 as i64))) & (255 as i64)) as int)
    _bput(s, 19, (((h5 >> (24 as i64)) | (h6 << (1 as i64))) & (255 as i64)) as int)
    _bput(s, 20, (((h6 >> (7 as i64))) & (255 as i64)) as int)
    _bput(s, 21, (((h6 >> (15 as i64))) & (255 as i64)) as int)
    _bput(s, 22, (((h6 >> (23 as i64)) | (h7 << (3 as i64))) & (255 as i64)) as int)
    _bput(s, 23, (((h7 >> (5 as i64))) & (255 as i64)) as int)
    _bput(s, 24, (((h7 >> (13 as i64))) & (255 as i64)) as int)
    _bput(s, 25, (((h7 >> (21 as i64)) | (h8 << (4 as i64))) & (255 as i64)) as int)
    _bput(s, 26, (((h8 >> (4 as i64))) & (255 as i64)) as int)
    _bput(s, 27, (((h8 >> (12 as i64))) & (255 as i64)) as int)
    _bput(s, 28, (((h8 >> (20 as i64)) | (h9 << (6 as i64))) & (255 as i64)) as int)
    _bput(s, 29, (((h9 >> (2 as i64))) & (255 as i64)) as int)
    _bput(s, 30, (((h9 >> (10 as i64))) & (255 as i64)) as int)
    _bput(s, 31, (((h9 >> (18 as i64))) & (255 as i64)) as int)
end

func _fe25519_invert(out: i64*, z: i64*, t0: i64*, t1: i64*, t2: i64*, t3: i64*):
    _fe25519_sq(t0, z)
    _fe25519_sqn(t1, t0, 2)
    _fe25519_mul(t1, z, t1)
    _fe25519_mul(t0, t0, t1)
    _fe25519_sq(t2, t0)
    _fe25519_mul(t1, t1, t2)
    _fe25519_sqn(t2, t1, 5)
    _fe25519_mul(t1, t2, t1)
    _fe25519_sqn(t2, t1, 10)
    _fe25519_mul(t2, t2, t1)
    _fe25519_sqn(t3, t2, 20)
    _fe25519_mul(t2, t3, t2)
    _fe25519_sqn(t2, t2, 10)
    _fe25519_mul(t1, t2, t1)
    _fe25519_sqn(t2, t1, 50)
    _fe25519_mul(t2, t2, t1)
    _fe25519_sqn(t3, t2, 100)
    _fe25519_mul(t2, t3, t2)
    _fe25519_sqn(t2, t2, 50)
    _fe25519_mul(t1, t2, t1)
    _fe25519_sqn(t1, t1, 5)
    _fe25519_mul(out, t1, t0)
end

inline func _x_slot(base: i64*, i: int): i64*:
    ret ((base as i64) + ((i * X_SLOT) as i64)) as i64*
end

func _x25519_scalarmult(scalar: void*, point: void*, out: void*):
    mut z := _newbuf(32)
    defer _buf_wipe(z)
    _putraw(z, scalar, 32)
    _bput(z.p, 0, _bget(z.p, 0) & 248)
    _bput(z.p, 31, (_bget(z.p, 31) & 127) | 64)

    base := mem.Allocate((X_SLOT * 12) as u64) as i64*
    x1 := _x_slot(base, 0)
    x2 := _x_slot(base, 1)
    z2 := _x_slot(base, 2)
    x3 := _x_slot(base, 3)
    z3 := _x_slot(base, 4)
    a := _x_slot(base, 5)
    b := _x_slot(base, 6)
    t2 := _x_slot(base, 7)
    t3 := _x_slot(base, 8)
    _fe25519_frombytes(x1, point)
    repeat X_LIMBS in i:
        x2[i] = 0 as i64
        z2[i] = 0 as i64
        z3[i] = 0 as i64
    end
    x2[0] = 1 as i64
    z3[0] = 1 as i64
    _fe25519_copy(x3, x1)

    mut swap := 0 as i64
    mut pos := 254
    until pos >= 0:
        bit := ((_bget(z.p, pos >> 3) >> (pos & 7)) & 1) as i64
        swap ^= bit
        _fe25519_cswap(x2, x3, swap)
        _fe25519_cswap(z2, z3, swap)
        swap = bit
        _fe25519_sub(a, x3, z3)
        _fe25519_sub(b, x2, z2)
        _fe25519_add(x2, x2, z2)
        _fe25519_add(z2, x3, z3)
        _fe25519_mul(z3, a, x2)
        _fe25519_mul(z2, z2, b)
        _fe25519_sq(a, b)
        _fe25519_sq(b, x2)
        _fe25519_add(x3, z3, z2)
        _fe25519_sub(z2, z3, z2)
        _fe25519_mul(x2, b, a)
        _fe25519_sub(b, b, a)
        _fe25519_sq(z2, z2)
        _fe25519_mul121666(z3, b)
        _fe25519_sq(x3, x3)
        _fe25519_add(a, a, z3)
        _fe25519_mul(z3, x1, z2)
        _fe25519_mul(z2, b, a)
        pos--
    end
    _fe25519_cswap(x2, x3, swap)
    _fe25519_cswap(z2, z3, swap)
    _fe25519_invert(z2, z2, a, b, t2, t3)
    _fe25519_mul(x2, x2, z2)
    _fe25519_tobytes(out, x2)
    _wipe(base as void*, X_SLOT * 12)
    mem.Free(base as void*)
end

func _x25519_base(scalar: void*, out: void*):
    mut bp := _newbuf(32)
    defer _buf_free(bp)
    _put8(bp, 9)
    _putzeros(bp, 31)
    _x25519_scalarmult(scalar, bp.p, out)
end

func _x25519_shared(scalar: void*, peer: void*, out: void*): bool:
    _x25519_scalarmult(scalar, peer, out)
    mut acc := 0
    repeat 32 in i:
        acc |= _bget(out, i)
    end
    ret acc != 0
end
