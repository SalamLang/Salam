package tls

// Certificate structure: the TBS fields, the public key, and the
// signature. Extensions, names and validity times are in x509ext.salam.



// Certificate parsing. Identity matching lives in name.salam.

// X.509 v3 certificate parsing (RFC 5280).
//
// Parsing only; chain building and trust decisions live in verify.salam. The
// split matters: everything here is "what does this blob say", and nothing here
// should ever be read as "and therefore it is trustworthy".
//
// Fields are kept as Readers pointing into the caller's certificate buffer
// rather than copied out. That keeps a Cert cheap and, more importantly, keeps
// `tbs` byte-identical to what the issuer actually signed. Re-encoding a parsed
// structure and verifying the re-encoding is a classic way to accept a
// certificate whose signature covers different bytes than the ones interpreted.
// The consequence is that a Cert is only valid while its backing buffer lives.

// public key algorithms
const PK_UNKNOWN := 0
const PK_RSA := 1
const PK_EC_P256 := 2
const PK_EC_P384 := 3

// signature algorithms
const SIG_UNKNOWN := 0
const SIG_RSA_PKCS1_SHA256 := 1
const SIG_RSA_PKCS1_SHA384 := 2
const SIG_RSA_PKCS1_SHA512 := 3
const SIG_RSA_PSS_SHA256 := 4
const SIG_RSA_PSS_SHA384 := 5
const SIG_ECDSA_SHA256 := 6
const SIG_ECDSA_SHA384 := 7

const OID_RSA_ENCRYPTION := "2a864886f70d010101"
const OID_RSASSA_PSS := "2a864886f70d01010a"
const OID_SHA256_RSA := "2a864886f70d01010b"
const OID_SHA384_RSA := "2a864886f70d01010c"
const OID_SHA512_RSA := "2a864886f70d01010d"
const OID_EC_PUBLICKEY := "2a8648ce3d0201"
const OID_PRIME256V1 := "2a8648ce3d030107"
const OID_SECP384R1 := "2b81040022"
const OID_ECDSA_SHA256 := "2a8648ce3d040302"
const OID_ECDSA_SHA384 := "2a8648ce3d040303"
const OID_SHA256 := "608648016503040201"
const OID_SHA384 := "608648016503040202"

struct Cert:
    // the bytes the issuer signed, exactly as received
    pub tbs: Reader = Reader {}
    pub serial: Reader = Reader {}
    // full DER of the Name, for byte-exact issuer/subject chaining
    pub issuer: Reader = Reader {}
    pub subject: Reader = Reader {}
    pub subject_cn: str = ""

    pub pk_alg: int = 0
    pub rsa_n: Reader = Reader {}
    pub rsa_e: Reader = Reader {}
    pub ec_point: Reader = Reader {}

    pub sig_alg: int = 0
    pub sig: Reader = Reader {}

    // validity as YYYYMMDDHHMMSS packed into an i64, which compares correctly
    // without any calendar arithmetic
    pub not_before: i64 = 0
    pub not_after: i64 = 0

    pub has_basic_constraints: bool = false
    pub is_ca: bool = false
    pub has_path_len: bool = false
    pub path_len: int = 0
    pub has_key_usage: bool = false
    pub key_usage: int = 0
    pub has_eku: bool = false
    pub eku_server_auth: bool = false
    // contents of the SubjectAltName extension, walked by _cert_match_host
    pub san: Reader = Reader {}
    pub has_san: bool = false

    pub ok: bool = false
end

func _sig_alg_from_oid(o: Reader, params: Reader): int:
    if _oid_is(o, OID_SHA256_RSA):
        ret SIG_RSA_PKCS1_SHA256
    end
    if _oid_is(o, OID_SHA384_RSA):
        ret SIG_RSA_PKCS1_SHA384
    end
    if _oid_is(o, OID_SHA512_RSA):
        ret SIG_RSA_PKCS1_SHA512
    end
    if _oid_is(o, OID_ECDSA_SHA256):
        ret SIG_ECDSA_SHA256
    end
    if _oid_is(o, OID_ECDSA_SHA384):
        ret SIG_ECDSA_SHA384
    end
    if _oid_is(o, OID_RSASSA_PSS):
        ret _pss_params_digest(params)
    end
    ret SIG_UNKNOWN
end

// RSASSA-PSS carries its digest in the parameters rather than the algorithm
// OID, so the parameters must actually be read. Defaulting to SHA-1 (the ASN.1
// default) is refused outright.
func _pss_params_digest(params: Reader): int:
    mut p := params
    mut s := _der_seq(p)
    if p.bad:
        ret SIG_UNKNOWN
    end
    if !_der_is(s, ASN1_CTX0):
        ret SIG_UNKNOWN
    end
    t := _der_tag(s, ASN1_CTX0)
    if !t.ok:
        ret SIG_UNKNOWN
    end
    mut inner := t.body
    mut hp := Reader {}
    o := _der_algid(inner, hp)
    if inner.bad:
        ret SIG_UNKNOWN
    end
    if _oid_is(o, OID_SHA256):
        ret SIG_RSA_PSS_SHA256
    end
    if _oid_is(o, OID_SHA384):
        ret SIG_RSA_PSS_SHA384
    end
    ret SIG_UNKNOWN
end

func _sig_hash(alg: int): int:
    if alg == SIG_RSA_PKCS1_SHA384 || alg == SIG_RSA_PSS_SHA384 || alg == SIG_ECDSA_SHA384:
        ret HASH_SHA384
    end
    ret HASH_SHA256
end

func _parse_spki(spki: Reader, c &: Cert): bool:
    mut s := spki
    mut inner := _der_seq(s)
    if s.bad:
        ret false
    end
    mut params := Reader {}
    o := _der_algid(inner, params)
    if inner.bad:
        ret false
    end
    key := _der_bitstring(inner, false)
    if inner.bad:
        ret false
    end
    if _oid_is(o, OID_RSA_ENCRYPTION):
        // RSAPublicKey ::= SEQUENCE { modulus INTEGER, publicExponent INTEGER }
        mut k := key
        mut ks := _der_seq(k)
        if k.bad:
            ret false
        end
        c.rsa_n = _der_uint(ks)
        c.rsa_e = _der_uint(ks)
        if ks.bad || _rdleft(ks) != 0:
            ret false
        end
        if c.rsa_n.len < 128:
            // under 1024 bits; refuse rather than verify something forgeable
            ret false
        end
        c.pk_alg = PK_RSA
        ret true
    end
    if _oid_is(o, OID_EC_PUBLICKEY):
        mut p := params
        curve := _der_oid(p)
        if p.bad:
            ret false
        end
        // Only the two curves the arithmetic implements are accepted. An
        // unsupported curve is refused rather than stored, because keeping a
        // key we cannot check signatures against would let it sit in a trust
        // store looking usable.
        if _oid_is(curve, OID_PRIME256V1):
            if key.len != 65 || _rdat(key, 0) != 0x04:
                ret false
            end
            c.ec_point = key
            c.pk_alg = PK_EC_P256
            ret true
        end
        if _oid_is(curve, OID_SECP384R1):
            if key.len != 97 || _rdat(key, 0) != 0x04:
                ret false
            end
            c.ec_point = key
            c.pk_alg = PK_EC_P384
            ret true
        end
        ret false
    end
    ret false
end

// Parse a DER certificate. Returns a Cert whose `ok` reports success; the
// Readers inside borrow from `p`, which must outlive the Cert.
func _cert_parse(p: void*, n: int): Cert:
    mut c := Cert {}
    mut top := _newreader(p, n)
    mut outer := _der_seq(top)
    if top.bad:
        ret c
    end
    // Trailing bytes after the certificate are not allowed: they would let the
    // same buffer be read two different ways.
    if _rdleft(top) != 0:
        ret c
    end

    tbs := _der_tag(outer, ASN1_SEQUENCE)
    if !tbs.ok:
        ret c
    end
    c.tbs = tbs.full
    mut t := tbs.body

    // version [0] EXPLICIT, default v1
    mut version := 1
    if _der_is(t, ASN1_CTX0):
        vt := _der_tag(t, ASN1_CTX0)
        if !vt.ok:
            ret c
        end
        mut vb := vt.body
        vi := _der_uint(vb)
        if vb.bad || vi.len != 1:
            ret c
        end
        version = _rdat(vi, 0) + 1
    end
    if version != 3:
        // v1/v2 certificates carry no extensions, so no basicConstraints and
        // no SAN. Nothing on the modern web should present one.
        ret c
    end

    c.serial = _der_uint(t)
    if t.bad:
        ret c
    end

    ia := _der_tag(t, ASN1_SEQUENCE)
    if !ia.ok:
        ret c
    end
    mut ib := ia.body
    inner_sig_oid := _der_oid(ib)
    if ib.bad:
        ret c
    end
    inner_params := _rdrest(ib)
    inner_alg := _sig_alg_from_oid(inner_sig_oid, inner_params)

    issuer := _der_tag(t, ASN1_SEQUENCE)
    if !issuer.ok:
        ret c
    end
    c.issuer = issuer.full

    mut validity := _der_seq(t)
    if t.bad:
        ret c
    end
    nb := _der(validity)
    na := _der(validity)
    if !nb.ok || !na.ok || _rdleft(validity) != 0:
        ret c
    end
    c.not_before = _parse_time(nb)
    c.not_after = _parse_time(na)
    if c.not_before == 0 || c.not_after == 0:
        ret c
    end

    subject := _der_tag(t, ASN1_SEQUENCE)
    if !subject.ok:
        ret c
    end
    c.subject = subject.full
    c.subject_cn = _name_cn(subject.full)

    spki := _der_tag(t, ASN1_SEQUENCE)
    if !spki.ok:
        ret c
    end
    if !_parse_spki(spki.full, c):
        ret c
    end

    // issuerUniqueID [1] / subjectUniqueID [2] are v2 leftovers; skip them
    if _der_is(t, ASN1_CTX1):
        _der_skip(t)
    end
    if _der_is(t, ASN1_CTX2):
        _der_skip(t)
    end
    if _der_is(t, ASN1_CTX3):
        et := _der_tag(t, ASN1_CTX3)
        if !et.ok:
            ret c
        end
        if !_parse_extensions(et.body, c):
            ret c
        end
    end
    if t.bad || _rdleft(t) != 0:
        ret c
    end

    oa := _der_tag(outer, ASN1_SEQUENCE)
    if !oa.ok:
        ret c
    end
    mut ob := oa.body
    outer_oid := _der_oid(ob)
    if ob.bad:
        ret c
    end
    outer_params := _rdrest(ob)
    c.sig_alg = _sig_alg_from_oid(outer_oid, outer_params)
    // An unsupported signature algorithm (SHA-1, and anything else outside the
    // supported set) is NOT a parse failure. A trust anchor is trusted because
    // it is in the store, not because of its own self-signature, and many
    // still-valid roots self-sign with SHA-1 while issuing SHA-256
    // intermediates. Refusing to parse them would discard usable anchors for
    // no security gain.
    //
    // Safety comes from the other side: _cert_signed_by only accepts the
    // algorithms it implements, so SIG_UNKNOWN can never verify a link. A
    // certificate carrying one is parseable but unusable as a signature.
    //
    // RFC 5280 4.1.1.2: the inner and outer algorithm identifiers must agree.
    //
    // Compared as full DER, not as the algorithm id they decode to. The outer
    // signatureAlgorithm sits OUTSIDE tbsCertificate and is therefore not
    // covered by the signature, so anything about it that is not checked here
    // can be altered freely on a validly signed certificate. Comparing only
    // the decoded id left the AlgorithmIdentifier parameters unconstrained,
    // which a mutation fuzz found: flipping bytes there produced a modified
    // certificate that still verified. Signature malleability like that is
    // worth closing even when the field carries no meaning of its own.
    if inner_alg != c.sig_alg:
        ret c
    end
    if !_cteqrd(ia.full, oa.full):
        ret c
    end

    c.sig = _der_bitstring(outer, false)
    if outer.bad || _rdleft(outer) != 0:
        ret c
    end

    c.ok = true
    ret c
end
