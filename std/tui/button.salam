package tui

import term

@en "Button"
@fa "دکمه"
pub struct Button:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "label"
    @fa "برچسب"
    pub label: str = ""

    @en "style"
    @fa "ظاهر"
    pub style: Style = StyleDefault

    @en "focus_style"
    @fa "ظاهر تمرکز"
    pub focus_style: Style = StyleDefault

    @en "disabled"
    @fa "غیرفعال"
    pub disabled: bool = false

    @en "on_click"
    @fa "هنگام کلیک"
    pub on_click: func () = (): end

    @en "Focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret not this.disabled and this.Bounds().width > 0
    end

    @en "Hits"
    @fa "اصابت‌پذیر است"
    pub func Hits(): bool:
        ret not this.disabled
    end

    @en "PreferredSize"
    @fa "اندازه ترجیحی"
    pub func PreferredSize(max_width: int): Rect:
        mut w := MeasureText(this.label, 0).width + 2
        if max_width > 0 and w > max_width:
            w = max_width
        end
        ret Rect { width = w, height = 1 }
    end

    @en "HandleEvent"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        if this.disabled:
            ret false
        end
        if event.IsKey(term.KeyEnter) or event.IsKey(term.KeySpace):
            this.on_click()
            ret true
        end
        if event.mouse.ok and event.mouse.pressed and not event.mouse.motion and
            event.mouse.button == 0 and this.Bounds().Contains(
                event.MousePoint()
            ):
            this.on_click()
            ret true
        end
        ret false
    end

    @en "Render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        w := bounds.width
        if w <= 0:
            ret
        end
        mut st := this.style
        if this.disabled:
            st.dim = true
            st.bold = false
        end
        if buf.focused and not this.disabled:
            if StyleEq(this.focus_style, StyleDefault):
                st.bold = true
            else:
                st = this.focus_style
            end
        end
        buf.Fill(Rect {
            x = bounds.x,
            y = bounds.y,
            width = w,
            height = 1
        }, " ", st)
        buf.PutStr(bounds.x, bounds.y, "[", st)
        if w >= 2:
            buf.PutStr(bounds.x + w - 1, bounds.y, "]", st)
        end
        avail := w - 2
        mut pad := (avail - _text_width(this.label)) / 2
        if pad < 0:
            pad = 0
        end
        room := avail - pad
        if room > 0:
            buf.PutStr(bounds.x + 1 + pad, bounds.y, _take_cells(this.label, room), st)
        end
    end

    @en "Visible"
    @fa "نمایان است"
    pub func Visible(): bool:
        ret true
    end

    @en "Bounds"
    @fa "محدوده"
    pub func Bounds(): Rect:
        ret this.rect
    end

    @en "SetBounds"
    @fa "تنظیم محدوده"
    pub func SetBounds(bounds: Rect):
        this.rect = bounds
    end

    @en "Measure"
    @fa "اندازه‌گیری"
    pub func Measure(axis: Axis, max_width: int): Measure:
        _ := axis
        _ := max_width
        ret Measure { ok = false, extent = 0 }
    end

end

@en "NewButton"
@fa "دکمه جدید"
pub func NewButton(label: str): Button:
    ret Button { label = label }
end
