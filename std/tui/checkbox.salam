package tui

import str
import term

@en "Checkbox"
@fa "کادر‌انتخاب"
pub struct Checkbox:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "label"
    @fa "برچسب"
    pub label: str = ""

    @en "box_style"
    @fa "ظاهر کادر"
    pub box_style: Style = StyleDefault

    @en "label_style"
    @fa "ظاهر برچسب"
    pub label_style: Style = StyleDefault

    @en "disabled"
    @fa "غیرفعال"
    pub disabled: bool = false

    @en "on_toggle"
    @fa "هنگام تغییر انتخاب"
    pub on_toggle: func (bool) = (_v: bool): end

    state: bool = false

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret not this.disabled and this.bounds().width > 0
    end

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func focusable(): bool:
        ret this.Focusable()
    end

    @en "hits"
    @fa "اصابت‌پذیر است"
    pub func Hits(): bool:
        ret not this.disabled
    end

    @en "hits"
    @fa "اصابت‌پذیر است"
    pub func hits(): bool:
        ret this.Hits()
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        if this.disabled:
            ret false
        end
        mut toggle := event.is_key(term.KeySpace)
        if event.kind == MouseEvent and event.mouse.ok and event.mouse.pressed and not event.mouse.motion and event.mouse.button == 0 and this.bounds().contains(event.mouse_point()):
            toggle = true
        end
        if not toggle:
            ret false
        end
        this.state = not this.state
        this.on_toggle(this.state)
        ret true
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func handle_event(event: Event): bool:
        ret this.HandleEvent(event)
    end

    @en "checked"
    @fa "انتخاب شده است"
    pub func Checked(): bool:
        ret this.state
    end

    @en "checked"
    @fa "انتخاب شده است"
    pub func checked(): bool:
        ret this.Checked()
    end

    @en "set_checked"
    @fa "تنظیم انتخاب"
    pub func SetChecked(value: bool):
        this.state = value
    end

    @en "set_checked"
    @fa "تنظیم انتخاب"
    pub func set_checked(value: bool):
        this.SetChecked(value)
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    pub func PreferredSize(max_width: int): Rect:
        mut w := MeasureText(this.label, 0).width + 4
        if max_width > 0 and w > max_width:
            w = max_width
        end
        ret Rect { width = w, height = 1 }
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    pub func preferred_size(max_width: int): Rect:
        ret this.PreferredSize(max_width)
    end

    @en "render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        if bounds.is_empty():
            ret
        end
        f := buf.focused and not this.disabled
        gb := _overlay(this.box_style, f, this.disabled)
        gl := _overlay(this.label_style, f, this.disabled)
        w := bounds.width
        buf.fill(Rect { x = bounds.x, y = bounds.y, width = w, height = 1 }, " ", gl)
        mut tick := " "
        if this.state:
            tick = "x"
        end
        buf.put_str(bounds.x, bounds.y, str.CharSubstr("[" + tick + "]", 0, w), gb)
        if w > 4:
            buf.put_str(bounds.x + 4, bounds.y, _take_cells(this.label, w - 4), gl)
        end
    end

    @en "render"
    @fa "ترسیم"
    pub func render(buf: Buffer, bounds: Rect):
        this.Render(buf, bounds)
    end
end

func _overlay(s: Style, focused: bool, disabled: bool): Style:
    ret Style { fg = s.fg, bg = s.bg, bold = (s.bold or focused) and not disabled, dim = s.dim or disabled, italic = s.italic, underline = s.underline, reverse = s.reverse }
end

@en "NewCheckbox"
@fa "کادر انتخاب جدید"
pub func NewCheckbox(label: str, checked: bool): Checkbox:
    ret Checkbox { label = label, state = checked }
end
