/*
 * Events: the one value type that flows from the terminal to widgets.
 *
 * Everything a widget can react to arrives as an Event: a key press, a
 * mouse report, a terminal resize, or a timer tick. A single struct with a
 * `kind` tag (rather than one type per kind) keeps the event channel, the
 * dispatch path, and every handler signature uniform: a widget writes one
 * handle_event and switches on `kind`.
 *
 * The payload fields reuse std/term's own types. `key` is a term.Key exactly
 * as term.ReadKey returned it, and `mouse` is a term.MouseEvent from
 * term.DecodeMouse, so nothing about key decoding is reimplemented here.
 * Fields that do not apply to an event's kind keep their zero values.
 *
 * Mouse coordinates. term.DecodeMouse reports the terminal's own 1-based
 * column and row. Everything else in tui is 0-based (see rect.salam),
 * and the conversion happens in exactly one place, mouse_point, so a
 * widget never has to remember the off-by-one.
 */

package tui

import term

@en "NoEvent"
@fa "بدون رویداد"
/// Kind of a zero-valued Event that carries nothing.
pub const NoEvent := 0

@en "KeyEvent"
@fa "رویداد کیبورد"
/// Kind of a key press. The `key` field holds the decoded key.
pub const KeyEvent := 1

@en "MouseEvent"
@fa "رویداد ماوس"
/// Kind of a mouse report. The `mouse` field holds the decoded report and
/// `key` keeps the raw escape sequence it came from.
pub const MouseEvent := 2

@en "ResizeEvent"
@fa "رویداد تغییر اندازه"
/// Kind of a terminal resize. `width` and `height` hold the new size in
/// cells.
pub const ResizeEvent := 3

@en "TickEvent"
@fa "رویداد تیک"
/// Kind of a periodic timer tick, for animation and background work.
pub const TickEvent := 4

@en "Event"
@fa "رویداد"
/// One input event. `kind` says which of the payload fields are meaningful.
pub struct Event:
    @en "kind"
    @fa "نوع"
    /// One of NoEvent, KeyEvent, MouseEvent, ResizeEvent, TickEvent.
    pub kind: int = 0

    @en "key"
    @fa "کلید"
    /// The key for KeyEvent; the raw sequence (in key.raw) for MouseEvent.
    pub key: term.Key = term.Key {}

    @en "mouse"
    @fa "ماوس"
    /// The decoded report for MouseEvent.
    pub mouse: term.MouseEvent = term.MouseEvent {}

    @en "width"
    @fa "عرض"
    /// The new terminal width in columns, for ResizeEvent.
    pub width: int = 0

    @en "height"
    @fa "ارتفاع"
    /// The new terminal height in rows, for ResizeEvent.
    pub height: int = 0

    @en "mouse_point"
    @fa "مختصات ماوس"
    /// The cell a MouseEvent happened on, as a 0-based Point like every
    /// other coordinate in tui. term.DecodeMouse keeps the terminal's
    /// 1-based column and row, so this subtracts 1 from each. Only
    /// meaningful for a MouseEvent whose `mouse.ok` is true.
    pub func mouse_point(): Point:
        ret Point { x = this.mouse.col - 1, y = this.mouse.row - 1 }
    end

    @en "is_key"
    @fa "کلید است"
    /// True for a KeyEvent whose key code is code (a term.Key* constant,
    /// for example term.KeyEnter or term.KeyUp). Modifiers are ignored.
    pub func is_key(code: int): bool:
        ret this.kind == KeyEvent and this.key.code == code
    end

    @en "is_char"
    @fa "نویسه است"
    /// True for a KeyEvent that typed exactly ch with neither Ctrl nor Alt
    /// held, so is_char("q") does not match Ctrl+Q or Alt+Q.
    pub func is_char(ch: str): bool:
        if not this.is_key(term.KeyChar) or this.key.ctrl or this.key.alt:
            ret false
        end
        ret this.key.ch == ch
    end

    @en "is_ctrl"
    @fa "ترکیب کنترل است"
    /// True for Ctrl plus the letter ch, for example is_ctrl("c") for
    /// Ctrl+C. In raw mode Ctrl+C arrives as this key, not as a signal.
    pub func is_ctrl(ch: str): bool:
        ret this.is_key(term.KeyChar) and this.key.ctrl and this.key.ch == ch
    end
end
