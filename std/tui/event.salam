package tui

import term

@en "NoEvent"
@fa "بدون رویداد"
pub const NoEvent := 0

@en "KeyEvent"
@fa "رویداد کیبورد"
pub const KeyEvent := 1

@en "MouseEvent"
@fa "رویداد ماوس"
pub const MouseEvent := 2

@en "ResizeEvent"
@fa "رویداد تغییر اندازه"
pub const ResizeEvent := 3

@en "TickEvent"
@fa "رویداد تیک"
pub const TickEvent := 4

@en "Event"
@fa "رویداد"
pub struct Event:
    @en "kind"
    @fa "نوع"
    pub kind: int = 0

    @en "key"
    @fa "کلید"
    pub key: term.Key = term.Key {}

    @en "mouse"
    @fa "ماوس"
    pub mouse: term.MouseEvent = term.MouseEvent {}

    @en "width"
    @fa "عرض"
    pub width: int = 0

    @en "height"
    @fa "ارتفاع"
    pub height: int = 0

    @en "bubbled"
    @fa "بالا رفته"
    pub bubbled: bool = false

    @en "mouse_point"
    @fa "مختصات ماوس"
    pub func MousePoint(): Point:
        ret Point { x = this.mouse.col - 1, y = this.mouse.row - 1 }
    end

    @en "mouse_point"
    @fa "مختصات ماوس"
    pub func mouse_point(): Point:
        ret this.MousePoint()
    end

    @en "is_key"
    @fa "کلید است"
    pub func IsKey(code: int): bool:
        ret this.kind == KeyEvent and this.key.code == code
    end

    @en "is_key"
    @fa "کلید است"
    pub func is_key(code: int): bool:
        ret this.IsKey(code)
    end

    @en "is_char"
    @fa "نویسه است"
    pub func IsChar(ch: str): bool:
        if not this.is_key(term.KeyChar) or this.key.ctrl or this.key.alt:
            ret false
        end
        ret this.key.ch == ch
    end

    @en "is_char"
    @fa "نویسه است"
    pub func is_char(ch: str): bool:
        ret this.IsChar(ch)
    end

    @en "is_ctrl"
    @fa "ترکیب کنترل است"
    pub func IsCtrl(ch: str): bool:
        ret this.is_key(term.KeyChar) and this.key.ctrl and this.key.ch == ch
    end

    @en "is_ctrl"
    @fa "ترکیب کنترل است"
    pub func is_ctrl(ch: str): bool:
        ret this.IsCtrl(ch)
    end
end
