package tui

import str
import term

@en "Input"
@fa "کادر‌متن"
pub struct Input:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "placeholder"
    @fa "متن راهنما"
    pub placeholder: str = ""

    @en "style"
    @fa "ظاهر"
    pub style: Style = StyleDefault

    @en "cursor_style"
    @fa "ظاهر مکان‌نما"
    pub cursor_style: Style = Style { reverse = true }

    @en "placeholder_style"
    @fa "ظاهر متن راهنما"
    pub placeholder_style: Style = Style { fg = BrightBlack }

    @en "max_length"
    @fa "حداکثر طول"
    pub max_length: int = 0

    @en "filter"
    @fa "پالایه"
    pub filter: func (str) bool = (_candidate: str): ret true end

    @en "masked"
    @fa "پوشانده"
    pub masked: bool = false

    @en "mask_glyph"
    @fa "نماد پوشش"
    pub mask_glyph: str = "*"

    @en "on_submit"
    @fa "هنگام ثبت"
    pub on_submit: func (str) bool = (_value: str): ret true end

    content: str = ""
    caret: int = 0
    window_start: int = 0

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret true
    end

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func focusable(): bool:
        ret this.Focusable()
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        if event.kind != KeyEvent:
            ret false
        end
        code := event.key.code
        total := str.CharCount(this.content)
        if code == term.KeyChar and not event.key.ctrl and not event.key.alt:
            this._insert(event.key.ch)
            ret true
        end
        if code == term.KeySpace:
            this._insert(" ")
            ret true
        end
        if code == term.KeyLeft and not event.key.ctrl and not event.key.alt:
            if this.caret > 0:
                this.caret--
            end
            ret true
        end
        if code == term.KeyRight and not event.key.ctrl and not event.key.alt:
            if this.caret < total:
                this.caret++
            end
            ret true
        end
        if code == term.KeyHome and not event.key.ctrl and not event.key.alt:
            this.caret = 0
            ret true
        end
        if code == term.KeyEnd and not event.key.ctrl and not event.key.alt:
            this.caret = total
            ret true
        end
        if code == term.KeyBackspace:
            if this.caret > 0:
                this.content = str.CharSubstr(this.content, 0, this.caret - 1) + str.CharSubstr(this.content, this.caret, total - this.caret)
                this.caret--
            end
            ret true
        end
        if code == term.KeyDelete and not event.key.ctrl and not event.key.alt:
            if this.caret < total:
                this.content = str.CharSubstr(this.content, 0, this.caret) + str.CharSubstr(this.content, this.caret + 1, total - this.caret - 1)
            end
            ret true
        end
        if code == term.KeyEnter:
            consumed := this.on_submit(this.content)
            n := str.CharCount(this.content)
            if this.caret > n:
                this.caret = n
            end
            if this.window_start > this.caret:
                this.window_start = this.caret
            end
            ret consumed
        end
        ret false
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func handle_event(event: Event): bool:
        ret this.HandleEvent(event)
    end

    func _insert(ins: str):
        total := str.CharCount(this.content)
        mut piece := ins
        if this.max_length > 0:
            room := this.max_length - total
            if room <= 0:
                ret
            end
            piece = str.CharSubstr(ins, 0, room)
        end
        candidate := str.CharSubstr(this.content, 0, this.caret) + piece + str.CharSubstr(this.content, this.caret, total - this.caret)
        if not this.filter(candidate):
            ret
        end
        this.content = candidate
        this.caret = this.caret + str.CharCount(piece)
    end

    @en "value"
    @fa "مقدار"
    pub func Value(): str:
        ret this.content
    end

    @en "value"
    @fa "مقدار"
    pub func value(): str:
        ret this.Value()
    end

    @en "set_value"
    @fa "تنظیم مقدار"
    pub func SetValue(v: str):
        mut t := v
        if this.max_length > 0 and str.CharCount(t) > this.max_length:
            t = str.CharSubstr(t, 0, this.max_length)
        end
        this.content = t
        this.caret = str.CharCount(t)
    end

    @en "set_value"
    @fa "تنظیم مقدار"
    pub func set_value(v: str):
        this.SetValue(v)
    end

    @en "set_placeholder"
    @fa "تنظیم متن راهنما"
    pub func SetPlaceholder(p: str):
        this.placeholder = p
    end

    @en "set_placeholder"
    @fa "تنظیم متن راهنما"
    pub func set_placeholder(p: str):
        this.SetPlaceholder(p)
    end

    @en "render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        if bounds.IsEmpty():
            ret
        end
        buf.fill(bounds, " ", this.style)
        w := bounds.width
        count := str.CharCount(this.content)
        if this.caret > count:
            this.caret = count
        end
        if this.caret < 0:
            this.caret = 0
        end
        mut start := this.window_start
        if start < 0:
            start = 0
        end
        if start > count:
            start = 0
        end
        mut mg := _take_cells(this.mask_glyph, 1)
        if mg == "" or _text_width(mg) != 1 or (buf.glyphs == GlyphPolicy.ASCII and mg.len() > 1):
            mg = "*"
        end
        mut widths := Vector {} as Vector<int>
        defer widths.free()
        mut chars := str.Chars(this.content)
        defer chars.free()
        repeat chars.len() in k:
            if this.masked:
                widths.push(1)
            else:
                widths.push(_char_width(chars.get(k)))
            end
        end
        if this.caret < start:
            start = this.caret
        end
        mut col := 0
        repeat this.caret - start in k:
            col += widths.get(start + k)
        end
        mut need := 1
        if this.caret < widths.len() and widths.get(this.caret) > 1:
            need = widths.get(this.caret)
        end
        until col + need > w and start < this.caret:
            col -= widths.get(start)
            start++
        end
        this.window_start = start
        if count == 0 and this.placeholder != "":
            ps := StyleMerge(this.style, this.placeholder_style)
            buf.put_str(bounds.x, bounds.y, _take_cells(this.placeholder, w), ps)
        else:
            mut text := ""
            if start < count:
                if this.masked:
                    mut shown := count - start
                    if shown > w:
                        shown = w
                    end
                    text = str.Repeat(mg, shown)
                else:
                    text = _take_cells(str.CharSubstr(this.content, start, count - start), w)
                end
            end
            buf.put_str(bounds.x, bounds.y, text, this.style)
        end
        if buf.focused:
            c := buf.get(bounds.x + col, bounds.y)
            cursor_style := StyleMerge(this.style, this.cursor_style)
            if _char_width(c.ch) == 2:
                buf.put_str(bounds.x + col, bounds.y, c.ch, cursor_style)
            else:
                buf.set(bounds.x + col, bounds.y, Cell { ch = c.ch, style = cursor_style })
            end
        end
    end

    @en "render"
    @fa "ترسیم"
    pub func render(buf: Buffer, bounds: Rect):
        this.Render(buf, bounds)
    end
end

@en "NewInput"
@fa "کادر متن جدید"
pub func NewInput(): Input:
    ret Input {}
end
