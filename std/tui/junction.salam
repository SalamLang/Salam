package tui

func _new_junction_arms(size: int): Vector<int>:
    mut arms := Vector {} as Vector<int>
    repeat size:
        arms.Push(0)
    end
    ret arms
end

func _arms(ch: str): int:
    if ch == " ":
        ret 0
    end
    ret match ch:
        "╵": 1 end "╷": 4 end "╴": 16 end "╶": 64 end
        "│": 5 end "─": 80 end "└": 65 end "┘": 17 end "┌": 68 end "┐": 20 end
        "├": 69 end "┤": 21 end "┬": 84 end "┴": 81 end "┼": 85 end
        "╹": 2 end "╻": 8 end "╸": 32 end "╺": 128 end
        "┃": 10 end "━": 160 end "┗": 130 end "┛": 34 end "┏": 136 end "┓": 40 end
        "┣": 138 end "┫": 42 end "┳": 168 end "┻": 162 end "╋": 170 end
        "║": 15 end "═": 240 end "╚": 195 end "╝": 51 end "╔": 204 end "╗": 60 end
        "╠": 207 end "╣": 63 end "╦": 252 end "╩": 243 end "╬": 255 end
        "┍": 132 end "┑": 36 end "┕": 129 end "┙": 33 end "┝": 133 end "┥": 37 end "┯": 164 end "┷": 161 end "┿": 165 end
        "┎": 72 end "┒": 24 end "┖": 66 end "┚": 18 end "┠": 74 end "┨": 26 end "┰": 88 end "┸": 82 end "╂": 90 end
        "╒": 196 end "╕": 52 end "╘": 193 end "╛": 49 end "╞": 197 end "╡": 53 end "╤": 244 end "╧": 241 end "╪": 245 end
        "╓": 76 end "╖": 28 end "╙": 67 end "╜": 19 end "╟": 79 end "╢": 31 end "╥": 92 end "╨": 83 end "╫": 95 end
        "╭": 68 end "╮": 20 end "╰": 65 end "╯": 17 end
        else: 0 end
    end
end

func _arm_weight(arms: int, shift: int): int:
    ret (arms >> shift) & 3
end

func _with_arm(arms: int, shift: int, weight: int): int:
    ret arms | (weight << shift)
end

func _junction_glyph(arms: int): str:
    ret match arms:
        1: "╵" end 4: "╷" end 16: "╴" end 64: "╶" end
        5: "│" end 80: "─" end 65: "└" end 17: "┘" end 68: "┌" end 20: "┐" end
        69: "├" end 21: "┤" end 84: "┬" end 81: "┴" end 85: "┼" end
        2: "╹" end 8: "╻" end 32: "╸" end 128: "╺" end
        10: "┃" end 160: "━" end 130: "┗" end 34: "┛" end 136: "┏" end 40: "┓" end
        138: "┣" end 42: "┫" end 168: "┳" end 162: "┻" end 170: "╋" end
        15: "║" end 240: "═" end 195: "╚" end 51: "╝" end 204: "╔" end 60: "╗" end
        207: "╠" end 63: "╣" end 252: "╦" end 243: "╩" end 255: "╬" end
        132: "┍" end 36: "┑" end 129: "┕" end 33: "┙" end 133: "┝" end 37: "┥" end 164: "┯" end 161: "┷" end 165: "┿" end
        72: "┎" end 24: "┒" end 66: "┖" end 18: "┚" end 74: "┠" end 26: "┨" end 88: "┰" end 82: "┸" end 90: "╂" end
        196: "╒" end 52: "╕" end 193: "╘" end 49: "╛" end 197: "╞" end 53: "╡" end 244: "╤" end 241: "╧" end 245: "╪" end
        76: "╓" end 28: "╖" end 67: "╙" end 19: "╜" end 79: "╟" end 31: "╢" end 92: "╥" end 83: "╨" end 95: "╫" end
        else: "" end
    end
end

func _join_junctions(buffer: Buffer, arms: Vector<int>, glyphs: GlyphPolicy):
    if glyphs == GlyphPolicy.ASCII:
        ret
    end
    repeat buffer.height in y:
        repeat buffer.width in x:
            index := y * buffer.width + x
            own := arms.Get(index)
            if own == 0:
                continue
            end
            mut result := own
            if y > 0:
                w := _arm_weight(arms.Get(index - buffer.width), 2)
                if _arm_weight(own, 0) == 0 and w != 0: result = _with_arm(result, 0, w) end
            end
            if y + 1 < buffer.height:
                w := _arm_weight(arms.Get(index + buffer.width), 0)
                if _arm_weight(own, 2) == 0 and w != 0: result = _with_arm(result, 2, w) end
            end
            if x > 0:
                w := _arm_weight(arms.Get(index - 1), 6)
                if _arm_weight(own, 4) == 0 and w != 0: result = _with_arm(result, 4, w) end
            end
            if x + 1 < buffer.width:
                w := _arm_weight(arms.Get(index + 1), 4)
                if _arm_weight(own, 6) == 0 and w != 0: result = _with_arm(result, 6, w) end
            end
            if result != own:
                glyph := _junction_glyph(result)
                if glyph != "":
                    cell := buffer.Get(x, y)
                    buffer.Set(x, y, Cell { ch = glyph, style = cell.style })
                end
            end
        end
    end
end
