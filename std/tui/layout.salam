package tui

mut _layout_depth := 0
mut _memo := Vector {} as Vector<_MemoEntry>

struct _MemoEntry:
    pub id: int = 0
    pub axis: Axis = Axis.X
    pub mw: int = 0
    pub known: bool = false
    pub n: int = 0
end

struct _Extent:
    pub known: bool = false
    pub n: int = 0
end

@en "Axis"
@fa "محور"
pub enum Axis:
    @en "X"
    @fa "محور افقی"
    X
    @en "Y"
    @fa "محور عمودی"
    Y
end

@en "Measure"
@fa "اندازه"
pub struct Measure:
    @en "ok"
    @fa "معتبر"
    pub ok: bool = false

    @en "extent"
    @fa "گستره"
    pub extent: int = 0
end

@en "CrossAlign"
@fa "تراز‌عرضی"
pub enum CrossAlign:
    @en "Start"
    @fa "آغاز"
    Start
    @en "Center"
    @fa "مرکز"
    Center
    @en "End"
    @fa "انتها"
    End
    @en "Stretch"
    @fa "کشیده"
    Stretch
end

@en "SizeKind"
@fa "نوع‌اندازه‌گذاری"
pub enum SizeKind:
    @en "Fill"
    @fa "پرکردن فضا"
    Fill
    @en "Fixed"
    @fa "ثابت"
    Fixed
    @en "Pref"
    @fa "ترجیحی"
    Pref
end

@en "LayoutSize"
@fa "قاعده‌اندازه‌گذاری"
pub struct LayoutSize:
    @en "kind"
    @fa "نوع"
    pub kind: SizeKind = SizeKind.Fill

    @en "cells"
    @fa "تعداد سلول"
    pub cells: int = 0

    @en "weight"
    @fa "وزن"
    pub weight: int = 1
end

@en "Insets"
@fa "فاصله‌های‌چهارگانه"
pub struct Insets:
    @en "top"
    @fa "بالا"
    pub top: int = 0

    @en "right"
    @fa "راست"
    pub right: int = 0

    @en "bottom"
    @fa "پایین"
    pub bottom: int = 0

    @en "left"
    @fa "چپ"
    pub left: int = 0
end

@en "LayoutSlot"
@fa "جایگاه‌چیدمان"
pub struct LayoutSlot:
    @en "child"
    @fa "فرزند"
    pub child: dyn Widget

