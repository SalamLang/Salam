    @en "width"
    @fa "عرض"
    pub width: LayoutSize = LayoutSize {}

    @en "height"
    @fa "ارتفاع"
    pub height: LayoutSize = LayoutSize {}

    @en "align_x"
    @fa "تراز افقی"
    pub align_x: CrossAlign = CrossAlign.Stretch

    @en "align_y"
    @fa "تراز عمودی"
    pub align_y: CrossAlign = CrossAlign.Stretch

    @en "row"
    @fa "ردیف"
    pub row: int = 0

    @en "col"
    @fa "ستون"
    pub col: int = 0

    @en "row_span"
    @fa "گستره ردیف"
    pub row_span: int = 1

    @en "col_span"
    @fa "گستره ستون"
    pub col_span: int = 1
end

@en "Row"
@fa "ردیف"
pub struct Row:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "pad"
    @fa "فاصله درونی"
    pub pad: Insets = Insets {}

    @en "gap"
    @fa "فاصله"
    pub gap: int = 0

    @en "items"
    @fa "جایگاه‌ها"
    pub items: Vector<LayoutSlot> = Vector {}

    @en "add"
    @fa "افزودن"
    pub func Add(child: dyn Widget): int:
        ret _slotAdd(this.items, child)
    end

    @en "add"
    @fa "افزودن"
    pub func add(child: dyn Widget): int:
        ret this.Add(child)
    end

    @en "set_margin"
    @fa "تنظیم حاشیه بیرونی"
    pub func SetMargin(i: int, margin: Insets):
        _slotMargin(this.items, i, margin)
    end

    @en "set_margin"
    @fa "تنظیم حاشیه بیرونی"
    pub func set_margin(i: int, margin: Insets):
        this.SetMargin(i, margin)
    end

    @en "set_width"
    @fa "تنظیم عرض"
    pub func SetWidth(i: int, size: LayoutSize):
        _slotWidth(this.items, i, size)
    end

    @en "set_width"
    @fa "تنظیم عرض"
    pub func set_width(i: int, size: LayoutSize):
        this.SetWidth(i, size)
    end

    @en "set_height"
    @fa "تنظیم ارتفاع"
    pub func SetHeight(i: int, size: LayoutSize):
        _slotHeight(this.items, i, size)
    end

    @en "set_height"
    @fa "تنظیم ارتفاع"
    pub func set_height(i: int, size: LayoutSize):
        this.SetHeight(i, size)
    end

    @en "set_align"
    @fa "تنظیم تراز"
    pub func SetAlign(i: int, align_x: CrossAlign, align_y: CrossAlign):
        _slotAlign(this.items, i, align_x, align_y)
    end

    @en "set_align"
    @fa "تنظیم تراز"
    pub func set_align(i: int, align_x: CrossAlign, align_y: CrossAlign):
        this.SetAlign(i, align_x, align_y)
    end

    @en "set_padding"
    @fa "تنظیم فاصله درونی"
    pub func SetPadding(pad: Insets):
        this.pad = pad
    end

    @en "set_padding"
    @fa "تنظیم فاصله درونی"
    pub func set_padding(pad: Insets):
        this.SetPadding(pad)
    end

    @en "set_gap"
    @fa "تنظیم فاصله"
    pub func SetGap(gap: int):
        this.gap = _clampNeg(gap)
    end

    @en "set_gap"
    @fa "تنظیم فاصله"
    pub func set_gap(gap: int):
        this.SetGap(gap)
    end

    @en "measure"
    @fa "اندازه‌گیری"
    pub func Measure(axis: Axis, max_width: int): Measure:
        m := _measureLinear(this.items, this.pad, this.gap, true, axis, max_width)
        _ := this.BaseWidget.Measure(axis, max_width)
        ret m
    end

    @en "measure"
    @fa "اندازه‌گیری"
    pub func measure(axis: Axis, max_width: int): Measure:
        ret this.Measure(axis, max_width)
    end

    @en "set_bounds"
    @fa "تنظیم محدوده"
    pub func SetBounds(bounds: Rect):
        _enter_pass()
        r := FitRect(bounds, bounds)
        this.BaseWidget.SetBounds(r)
        rects := _arrangeLinear(InsetRect(r, this.pad), this.items, true, this.gap)
        repeat this.items.Len() in i:
            this.items.get(i).child.SetBounds(rects.get(i))
        end
        rects.Free()
        _leave_pass()
    end

    @en "set_bounds"
    @fa "تنظیم محدوده"
    pub func set_bounds(bounds: Rect):
        this.SetBounds(bounds)
    end
end

