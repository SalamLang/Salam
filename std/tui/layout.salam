func _clamp(v: int, lo: int, hi: int): int:
    mut out := v
    if out > hi:
        out = hi
    end
    if out < lo:
        out = lo
    end
    ret out
end

func _clampNeg(v: int): int:
    if v < 0:
        ret 0
    end
    ret v
end

func _enter_pass():
    if _layout_depth == 0:
        _memo.clear()
    end
    _layout_depth++
end

func _leave_pass():
    _layout_depth--
end

func _measured(node: dyn Widget, axis: Axis, mw: int): _Extent:
    if mw <= 0:
        ret _Extent { known = true, n = 0 }
    end
    _last_memo_id = 0
    m := node.Measure(axis, mw)
    id := _last_memo_id
    if m.ok:
        ret _Extent { known = true, n = _clampNeg(m.extent) }
    end
    if id == 0:
        ret _preferredExtent(node, axis, mw)
    end
    repeat _memo.Len() in i:
        e := _memo.get(i)
        if e.id == id and e.axis == axis and e.mw == mw:
            ret _Extent { known = e.known, n = e.n }
        end
    end
    got := _preferredExtent(node, axis, mw)
    _memo.push(_MemoEntry { id = id, axis = axis, mw = mw, known = got.known, n = got.n })
    ret got
end

func _preferredExtent(node: dyn Widget, axis: Axis, mw: int): _Extent:
    p := node.PreferredSize(mw)
    comp := axis == Axis.X ? p.width : p.height
    if comp >= 0:
        ret _Extent { known = true, n = _clampNeg(comp) }
    end
    ret _Extent { known = false, n = 0 }
end

func _measureLinear(items: Vector<LayoutSlot>, pad: Insets, gap: int, main_is_x: bool, axis: Axis, mw: int): Measure:
    axis_is_x := axis == Axis.X
    mut pad_n := _clampNeg(pad.top) + _clampNeg(pad.bottom)
    if axis_is_x:
        pad_n = _clampNeg(pad.left) + _clampNeg(pad.right)
    end
    if axis_is_x == main_is_x:
        mut sum := pad_n
        k := items.Len()
        if k > 1:
            sum += _clampNeg(gap) * (k - 1)
        end
        repeat k in i:
            s := items.get(i)
            slot := axis_is_x ? s.width : s.height
            mut part := 0
            if slot.kind == SizeKind.Fixed:
                part = _clampNeg(slot.cells)
            else:
                got := _measured(s.child, axis, mw)
                if not got.known:
                    ret Measure { ok = false, extent = 0 }
                end
                part = got.n
            end
            sum += part
        end
        ret Measure { ok = true, extent = sum }
    end
    mut max_c := 0
    repeat items.Len() in i:
        got := _measured(items.get(i).child, axis, mw)
        if not got.known:
            ret Measure { ok = false, extent = 0 }
        end
        if got.n > max_c:
            max_c = got.n
        end
    end
    ret Measure { ok = true, extent = pad_n + max_c }
end

func _resolveMain(items: Vector<LayoutSlot>, main_is_width: bool, mw: int): Vector<LayoutSize>:
    out := Vector {} as Vector<LayoutSize>
    axis := main_is_width ? Axis.X : Axis.Y
    repeat items.Len() in i:
        s := items.get(i)
        slot := main_is_width ? s.width : s.height
        if slot.kind == SizeKind.Pref:
            got := _measured(s.child, axis, mw)
            if got.known:
                out.push(LayoutSize { kind = SizeKind.Fixed, cells = got.n })
            else:
                out.push(LayoutSize { kind = SizeKind.Fill, weight = 1 })
            end
        else:
            out.push(slot)
        end
    end
    ret out
end

func _naturalWidth(child: dyn Widget, max_width: int, avail: int): int:
    got := _measured(child, Axis.X, max_width)
    if not got.known:
        ret avail
    end
    ret got.n
end

func _naturalHeight(child: dyn Widget, max_width: int, avail: int): int:
    got := _measured(child, Axis.Y, max_width)
    if not got.known:
        ret avail
    end
    ret got.n
end

func _crossWidth(child: dyn Widget, size: LayoutSize, max_width: int, avail: int): int:
    if size.kind == SizeKind.Fixed:
        ret _clampNeg(size.cells)
    end
    ret _naturalWidth(child, max_width, avail)
end

func _crossHeight(child: dyn Widget, size: LayoutSize, max_width: int, avail: int): int:
    if size.kind == SizeKind.Fixed:
        ret _clampNeg(size.cells)
    end
    ret _naturalHeight(child, max_width, avail)
end

func _prefixTotal(lengths: Vector<int>, index: int, start: int): int:
    mut acc := start
    repeat index in k:
        acc += lengths.get(k)
    end
    ret acc
end

func _slotAdd(items &: Vector<LayoutSlot>, child: dyn Widget): int:
    items.push(LayoutSlot { child = child })
    ret items.Len() - 1
end

func _slotMargin(items &: Vector<LayoutSlot>, i: int, margin: Insets):
    if i < 0 or i >= items.Len():
        ret
    end
    mut s := items.get(i)
    s.margin = margin
    items.set(i, s)
end

func _slotWidth(items &: Vector<LayoutSlot>, i: int, size: LayoutSize):
    if i < 0 or i >= items.Len():
        ret
    end
    mut s := items.get(i)
    s.width = size
    items.set(i, s)
end

func _slotHeight(items &: Vector<LayoutSlot>, i: int, size: LayoutSize):
    if i < 0 or i >= items.Len():
        ret
    end
    mut s := items.get(i)
    s.height = size
    items.set(i, s)
end

func _slotAlign(items &: Vector<LayoutSlot>, i: int, align_x: CrossAlign, align_y: CrossAlign):
    if i < 0 or i >= items.Len():
        ret
    end
    mut s := items.get(i)
    s.align_x = align_x
    s.align_y = align_y
    items.set(i, s)
end

func _slotCell(items &: Vector<LayoutSlot>, i: int, row: int, col: int):
    if i < 0 or i >= items.Len():
        ret
    end
    mut s := items.get(i)
    s.row = row
    s.col = col
    items.set(i, s)
end

func _slotSpan(items &: Vector<LayoutSlot>, i: int, rows: int, cols: int):
    if i < 0 or i >= items.Len():
        ret
    end
    mut s := items.get(i)
    s.row_span = rows <= 0 ? 1 : rows
    s.col_span = cols <= 0 ? 1 : cols
    items.set(i, s)
end

func _arrangeLinear(content: Rect, items: Vector<LayoutSlot>, main_is_width: bool, gap: int): Vector<Rect>:
    g := _clampNeg(gap)
    length := main_is_width ? content.width : content.height
    sizes := _resolveMain(items, main_is_width, content.width)
    lengths := SplitMain(length, sizes, g)
    out := Vector {} as Vector<Rect>
    mut pos := main_is_width ? content.x : content.y
    repeat items.Len() in i:
        s := items.get(i)
        length := lengths.get(i)
        mut slot := Rect {}
        if main_is_width:
            slot = Rect { x = pos, y = content.y, width = length, height = content.height }
        else:
            slot = Rect { x = content.x, y = pos, width = content.width, height = length }
        end
        pos = pos + length + g
        box := InsetRect(slot, s.margin)
        mut n := 0
        mut rect := Rect {}
        if main_is_width:
            if s.align_y != CrossAlign.Stretch:
                n = _crossHeight(s.child, s.height, box.width, box.height)
            end
            rect = Rect { x = box.x, y = box.y + PlaceAxisOffset(box.height, s.align_y, n), width = box.width, height = PlaceAxisSize(box.height, s.align_y, n) }
        else:
            if s.align_x != CrossAlign.Stretch:
                n = _crossWidth(s.child, s.width, box.width, box.width)
            end
            rect = Rect { x = box.x + PlaceAxisOffset(box.width, s.align_x, n), y = box.y, width = PlaceAxisSize(box.width, s.align_x, n), height = box.height }
        end
        out.push(FitRect(rect, content))
    end
    sizes.Free()
    lengths.Free()
    ret out
end

func _arrangeGrid(content: Rect, items: Vector<LayoutSlot>, rows: int, cols: int): Vector<Rect>:
    widths := TrackSizes(content.width, cols)
    heights := TrackSizes(content.height, rows)
    out := Vector {} as Vector<Rect>
    repeat items.Len() in i:
        s := items.get(i)
        if s.row < 0 or s.row >= rows or s.col < 0 or s.col >= cols:
            out.push(FitRect(Rect { x = content.x, y = content.y }, content))
        else:
            mut cs := s.col_span
            if cs <= 0:
                cs = 1
            end
            cs = _clamp(cs, 1, cols - s.col)
            mut rs := s.row_span
            if rs <= 0:
                rs = 1
            end
            rs = _clamp(rs, 1, rows - s.row)
            x := _prefixTotal(widths, s.col, content.x)
            y := _prefixTotal(heights, s.row, content.y)
            mut w := 0
            repeat cs in k:
                w += widths.get(s.col + k)
            end
            mut h := 0
            repeat rs in k:
                h += heights.get(s.row + k)
            end
            slot := Rect { x = x, y = y, width = w, height = h }
            box := InsetRect(slot, s.margin)
            mut nw := 0
            if s.align_x != CrossAlign.Stretch:
                nw = _crossWidth(s.child, s.width, box.width, box.width)
            end
            resolved := PlaceAxisSize(box.width, s.align_x, nw)
            mut nh := 0
            if s.align_y != CrossAlign.Stretch:
                nh = _crossHeight(s.child, s.height, resolved, box.height)
            end
            rect := Rect { x = box.x + PlaceAxisOffset(box.width, s.align_x, nw), y = box.y + PlaceAxisOffset(box.height, s.align_y, nh), width = resolved, height = PlaceAxisSize(box.height, s.align_y, nh) }
            out.push(FitRect(rect, content))
        end
    end
    widths.Free()
    heights.Free()
    ret out
end

func _arrangeStack(content: Rect, items: Vector<LayoutSlot>): Vector<Rect>:
    out := Vector {} as Vector<Rect>
    repeat items.Len() in i:
        out.push(FitRect(InsetRect(content, items.get(i).margin), content))
    end
    ret out
end

@en "NewInsets"
@fa "فاصله‌های چهارگانه جدید"
pub func NewInsets(top: int, right: int, bottom: int, left: int): Insets:
    ret Insets { top = _clampNeg(top), right = _clampNeg(right), bottom = _clampNeg(bottom), left = _clampNeg(left) }
end

@en "UniformInsets"
@fa "فاصله‌های چهارگانه یکسان"
pub func UniformInsets(v: int): Insets:
    ret NewInsets(v, v, v, v)
end

@en "FitRect"
@fa "جاسازی مستطیل"
pub func FitRect(r: Rect, box: Rect): Rect:
    x0 := r.x > box.x ? r.x : box.x
    y0 := r.y > box.y ? r.y : box.y
    x1 := r.x + r.width < box.x + box.width ? r.x + r.width : box.x + box.width
    y1 := r.y + r.height < box.y + box.height ? r.y + r.height : box.y + box.height
    if x1 > x0 and y1 > y0:
        ret Rect { x = x0, y = y0, width = x1 - x0, height = y1 - y0 }
    end
    ret Rect { x = _clamp(r.x, box.x, box.x + box.width), y = _clamp(r.y, box.y, box.y + box.height) }
end

@en "InsetRect"
@fa "کاستن از لبه‌های مستطیل"
pub func InsetRect(r: Rect, i: Insets): Rect:
    left := _clampNeg(i.left)
    top := _clampNeg(i.top)
    right := _clampNeg(i.right)
    bottom := _clampNeg(i.bottom)
    raw := Rect { x = r.x + left, y = r.y + top, width = r.width - left - right, height = r.height - top - bottom }
    ret FitRect(raw, r)
end

@en "SplitMain"
@fa "تقسیم محور اصلی"
pub func SplitMain(length: int, sizes: Vector<LayoutSize>, gap: int): Vector<int>:
    mut reserved := 0
    mut sum_w := 0
    repeat sizes.Len() in idx:
        s := sizes.get(idx)
        if s.kind == SizeKind.Fixed:
            reserved += _clampNeg(s.cells)
        else:
            sum_w += _clampNeg(s.weight)
        end
    end
    g := _clampNeg(gap)
    mut budget := 0
    if sizes.Len() > 1:
        budget = g * (sizes.Len() - 1)
    end
    rest := _clampNeg(length - reserved - budget)
    out := Vector {} as Vector<int>
    mut used := 0
    repeat sizes.Len() in idx:
        s := sizes.get(idx)
        if s.kind == SizeKind.Fixed:
            out.push(_clampNeg(s.cells))
        else:
            mut part := 0
            if sum_w > 0:
                part = (rest * _clampNeg(s.weight)) / sum_w
                used += part
            end
            out.push(part)
        end
    end
    spare := rest - used
    if sum_w == 0 or spare <= 0:
        ret out
    end
    taken := Vector {} as Vector<int>
    repeat sizes.Len():
        taken.push(0)
    end
    repeat spare:
        mut best := -1
        mut best_frac := -1
        repeat sizes.Len() in idx:
            s := sizes.get(idx)
            if s.kind != SizeKind.Fixed and taken.get(idx) == 0:
                frac := (rest * _clampNeg(s.weight)) % sum_w
                if best < 0 or frac > best_frac:
                    best = idx
                    best_frac = frac
                end
            end
        end
        taken.set(best, 1)
        out.set(best, out.get(best) + 1)
    end
    taken.Free()
    ret out
end

@en "TrackSizes"
@fa "اندازه‌های بخش‌های شبکه"
pub func TrackSizes(total: int, n: int): Vector<int>:
    out := Vector {} as Vector<int>
    if n <= 0:
        ret out
    end
    base := total / n
    rem := total % n
    repeat n in idx:
        extra := idx < rem ? 1 : 0
        out.push(base + extra)
    end
    ret out
end

@en "PlaceAxisSize"
@fa "اندازه در محور"
pub func PlaceAxisSize(avail: int, align: CrossAlign, natural: int): int:
    if align == CrossAlign.Stretch or avail <= 0:
        ret _clampNeg(avail)
    end
    ret _clamp(natural, 0, avail)
end

@en "PlaceAxisOffset"
@fa "جابه‌جایی در محور"
pub func PlaceAxisOffset(avail: int, align: CrossAlign, natural: int): int:
    if align == CrossAlign.Stretch or avail <= 0:
        ret 0
    end
    n := _clamp(natural, 0, avail)
    free := avail - n
    if align == CrossAlign.End:
        ret free
    end
    if align == CrossAlign.Center:
        ret free / 2
    end
    ret 0
end

@en "NewRow"
@fa "ردیف جدید"
pub func NewRow(): Row:
    ret Row {}
end

@en "NewColumn"
@fa "ستون جدید"
pub func NewColumn(): Column:
    ret Column {}
end

@en "NewGrid"
@fa "شبکه جدید"
pub func NewGrid(rows: int, cols: int): Grid:
    ret Grid { rows = rows, cols = cols }
end

@en "NewStack"
@fa "پشته جدید"
pub func NewStack(): Stack:
    ret Stack {}
end
