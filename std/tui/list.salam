package tui

import str
import term

@en "List"
@fa "فهرست"
pub struct List:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "style"
    @fa "ظاهر"
    pub style: Style = StyleDefault

    @en "selected_style"
    @fa "ظاهر انتخاب"
    pub selected_style: Style = Style { reverse = true }

    @en "selected_unfocused_style"
    @fa "ظاهر انتخاب بی‌تمرکز"
    pub selected_unfocused_style: Style = Style { bg = BrightBlack }

    @en "on_select"
    @fa "هنگام انتخاب"
    pub on_select: func (int) = (_i: int): end

    items: Vector<str> = Vector {}
    selected: int = 0
    window_start: int = 0

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret true
    end

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func focusable(): bool:
        ret this.Focusable()
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        if event.kind != KeyEvent:
            ret false
        end
        if event.is_char("j"):
            if this.items.Len() > 0 and this.selected + 1 < this.items.Len():
                this.selected++
            end
            this._reveal(this.Bounds().height)
            ret true
        end
        if event.is_char("k"):
            if this.selected > 0:
                this.selected--
            end
            this._reveal(this.Bounds().height)
            ret true
        end
        if event.is_key(term.KeyEnter):
            if this.items.Len() > 0:
                this.on_select(this.selected)
            end
            ret true
        end
        ret false
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func handle_event(event: Event): bool:
        ret this.HandleEvent(event)
    end

    @en "selected_index"
    @fa "نمایه انتخاب"
    pub func SelectedIndex(): int:
        if this.items.Len() == 0:
            ret -1
        end
        ret this.selected
    end

    @en "selected_index"
    @fa "نمایه انتخاب"
    pub func selected_index(): int:
        ret this.SelectedIndex()
    end

    @en "selected_item"
    @fa "گزینه انتخاب‌شده"
    pub func SelectedItem(): str:
        if this.selected < 0 or this.selected >= this.items.Len():
            ret ""
        end
        ret this.items.Get(this.selected)
    end

    @en "selected_item"
    @fa "گزینه انتخاب‌شده"
    pub func selected_item(): str:
        ret this.SelectedItem()
    end

    @en "render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        if bounds.IsEmpty():
            ret
        end
        this._reveal(bounds.height)
        n := this.items.Len()
        repeat bounds.height in y:
            idx := this.window_start + y
            mut rowStyle := this.style
            if idx < n and idx == this.selected:
                if buf.focused:
                    rowStyle = this.selected_style
                else:
                    rowStyle = this.selected_unfocused_style
                end
            end
            row := Rect { x = bounds.x, y = bounds.y + y, width = bounds.width, height = 1 }
            buf.fill(row, " ", rowStyle)
            if idx < n:
                buf.put_str(bounds.x, bounds.y + y, _take_cells(this.items.Get(idx), bounds.width), rowStyle)
            end
        end
    end

    @en "render"
    @fa "ترسیم"
    pub func render(buf: Buffer, bounds: Rect):
        this.Render(buf, bounds)
    end

    func _reveal(h: int):
        n := this.items.Len()
        if n == 0:
            this.window_start = 0
            ret
        end
        mut hh := h
        if hh < 1:
            hh = 1
        end
        mut s := this.window_start
        if this.selected < s:
            s = this.selected
        end
        low := this.selected - hh + 1
        if low > s:
            s = low
        end
        if s < 0:
            s = 0
        end
        mut mx := n - hh
        if mx < 0:
            mx = 0
        end
        if s > mx:
            s = mx
        end
        this.window_start = s
    end

    @en "Hits"
    @fa "Hits"
    pub func Hits(): bool:
        ret true
    end

    @en "hits"
    @fa "hits"
    pub func hits(): bool: ret this.Hits() end

    @en "Visible"
    @fa "Visible"
    pub func Visible(): bool:
        ret true
    end

    @en "visible"
    @fa "visible"
    pub func visible(): bool: ret this.Visible() end

    @en "Bounds"
    @fa "Bounds"
    pub func Bounds(): Rect:
        ret this.rect
    end

    @en "bounds"
    @fa "bounds"
    pub func bounds(): Rect: ret this.Bounds() end

    @en "SetBounds"
    @fa "SetBounds"
    pub func SetBounds(bounds: Rect):
        this.rect = bounds
    end

    @en "set_bounds"
    @fa "set_bounds"
    pub func set_bounds(bounds: Rect): this.SetBounds(bounds) end

    @en "PreferredSize"
    @fa "PreferredSize"
    pub func PreferredSize(max_width: int): Rect:
        _ := max_width
        ret Rect { width = -1, height = -1 }
    end

    @en "preferred_size"
    @fa "preferred_size"
    pub func preferred_size(max_width: int): Rect: ret this.PreferredSize(max_width) end

    @en "Measure"
    @fa "Measure"
    pub func Measure(axis: Axis, max_width: int): Measure:
        _ := axis
        _ := max_width
        ret Measure { ok = false, extent = 0 }
    end

    @en "measure"
    @fa "measure"
    pub func measure(axis: Axis, max_width: int): Measure: ret this.Measure(axis, max_width) end

end

@en "NewList"
@fa "فهرست جدید"
pub func NewList(items: Vector<str>): List:
    mut sel := -1
    if items.Len() > 0:
        sel = 0
    end
    ret List { items = items, selected = sel }
end
