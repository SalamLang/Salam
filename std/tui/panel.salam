package tui

@en "Panel"
@fa "پنل"
pub struct Panel:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "border"
    @fa "کادر"
    pub border: BorderStyle = BorderStyle.None

    @en "border_style"
    @fa "ظاهر کادر"
    pub border_style: Style = StyleDefault

    @en "title"
    @fa "عنوان"
    pub title: str = ""

    @en "takes_focus"
    @fa "تمرکز می‌گیرد"
    pub takes_focus: bool = false

    @en "focus_style"
    @fa "ظاهر تمرکز"
    pub focus_style: Style = StyleDefault

    @en "slot"
    @fa "جایگاه"
    pub slot: Vector<LayoutSlot> = Vector {}

    @en "add"
    @fa "افزودن"
    pub func Add(child: dyn Widget):
        if this.slot.Len() > 0:
            this.slot.Set(0, LayoutSlot { child = child })
            ret
        end
        _ := _slotAdd(this.slot, child)
    end

    @en "add"
    @fa "افزودن"
    pub func add(child: dyn Widget):
        this.Add(child)
    end

    @en "set_bounds"
    @fa "تنظیم محدوده"
    pub func SetBounds(bounds: Rect):
        _enter_pass()
        r := FitRect(bounds, bounds)
        this.BaseWidget.SetBounds(r)
        if this.slot.Len() > 0:
            n := BorderInset(this.border)
            inner := InsetRect(r, Insets { top = n, right = n, bottom = n, left = n })
            this.slot.Get(0).child.SetBounds(inner)
        end
        _leave_pass()
    end

    @en "set_bounds"
    @fa "تنظیم محدوده"
    pub func set_bounds(bounds: Rect):
        this.SetBounds(bounds)
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    pub func PreferredSize(max_width: int): Rect:
        if this.slot.Len() == 0:
            ret Rect { width = -1, height = -1 }
        end
        n := BorderInset(this.border)
        mut inner_max := max_width
        if max_width > 0:
            inner_max = max_width - 2 * n
            if inner_max < 1:
                inner_max = 1
            end
        end
        child := this.slot.Get(0).child
        mx := child.Measure(Axis.X, inner_max)
        my := child.Measure(Axis.Y, inner_max)
        mut pref := Rect { width = -1, height = -1 }
        if not mx.ok or not my.ok:
            pref = child.PreferredSize(inner_max)
        end
        mut w := -1
        if mx.ok:
            w = mx.extent
            if w < 0:
                w = 0
            end
            w += 2 * n
        else:
            if pref.width >= 0:
                w = pref.width + 2 * n
            end
        end
        mut h := -1
        if my.ok:
            h = my.extent
            if h < 0:
                h = 0
            end
            h += 2 * n
        else:
            if pref.height >= 0:
                h = pref.height + 2 * n
            end
        end
        ret Rect { width = w, height = h }
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    pub func preferred_size(max_width: int): Rect:
        ret this.PreferredSize(max_width)
    end

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret this.takes_focus
    end

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func focusable(): bool:
        ret this.Focusable()
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        if this.slot.Len() > 0 and not event.bubbled:
            ret this.slot.Get(0).child.HandleEvent(event)
        end
        ret false
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func handle_event(event: Event): bool:
        ret this.HandleEvent(event)
    end

    @en "render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        mut style := this.border_style
        if buf.focused and not StyleEq(this.focus_style, StyleDefault):
            style = this.focus_style
        end
        DrawBorder(buf, bounds, this.border, style, this.title)
    end

    @en "render"
    @fa "ترسیم"
    pub func render(buf: Buffer, bounds: Rect):
        this.Render(buf, bounds)
    end

    @en "Hits"
    @fa "Hits"
    pub func Hits(): bool:
        ret true
    end

    @en "hits"
    @fa "hits"
    pub func hits(): bool: ret this.Hits() end

    @en "Visible"
    @fa "Visible"
    pub func Visible(): bool:
        ret true
    end

    @en "visible"
    @fa "visible"
    pub func visible(): bool: ret this.Visible() end

    @en "Bounds"
    @fa "Bounds"
    pub func Bounds(): Rect:
        ret this.rect
    end

    @en "bounds"
    @fa "bounds"
    pub func bounds(): Rect: ret this.Bounds() end

    @en "Measure"
    @fa "Measure"
    pub func Measure(axis: Axis, max_width: int): Measure:
        _ := axis
        _ := max_width
        ret Measure { ok = false, extent = 0 }
    end

    @en "measure"
    @fa "measure"
    pub func measure(axis: Axis, max_width: int): Measure: ret this.Measure(axis, max_width) end

end
