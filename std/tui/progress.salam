package tui

import str
import term

@en "Progress"
@fa "نوار‌پیشرفت"
pub struct Progress:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "fill_style"
    @fa "ظاهر بخش پر"
    pub fill_style: Style = StyleDefault

    @en "empty_style"
    @fa "ظاهر بخش خالی"
    pub empty_style: Style = StyleDefault

    @en "text_style"
    @fa "ظاهر متن"
    pub text_style: Style = StyleDefault

    value: int = 0
    max: int = 100

    @en "Hits"
    @fa "اصابت‌پذیر است"
    pub func Hits(): bool:
        ret false
    end

    @en "PreferredSize"
    @fa "اندازه ترجیحی"
    pub func PreferredSize(max_width: int): Rect:
        _ := max_width
        ret Rect { width = -1, height = 1 }
    end

    @en "Progress"
    @fa "مقدار پیشرفت"
    pub func Progress(): int:
        ret this.value
    end

    @en "SetProgress"
    @fa "تنظیم پیشرفت"
    pub func SetProgress(percent: int):
        this.value = _clamped(percent, this.max)
    end

    @en "SetMax"
    @fa "تنظیم بیشینه"
    pub func SetMax(limit: int):
        this.max = limit
        this.value = _clamped(this.value, limit)
    end

    @en "Render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        w := bounds.width
        if w <= 0:
            ret
        end
        tail := w >= 6
        mut bar := w
        if tail:
            bar = w - 5
        end
        v := _clamped(this.value, this.max)
        mut filled := 0
        mut pct := 0
        if this.max > 0:
            filled = (bar * v) / this.max
            pct = (100 * v) / this.max
        end
        repeat bar in i:
            if i < filled:
                buf.Set(bounds.x + i, bounds.y, Cell { ch = "#", style = this.fill_style })
            else:
                buf.Set(bounds.x + i, bounds.y, Cell { ch = "-", style = this.empty_style })
            end
        end
        if tail:
            buf.PutStr(bounds.x + bar, bounds.y, " " + term.PadLeft(str.FromInt(pct), 3) + "%", this.text_style)
        end
    end

    @en "HandleEvent"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        _ := event
        ret false
    end

    @en "Focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret false
    end

    @en "Visible"
    @fa "نمایان است"
    pub func Visible(): bool:
        ret true
    end

    @en "Bounds"
    @fa "محدوده"
    pub func Bounds(): Rect:
        ret this.rect
    end

    @en "SetBounds"
    @fa "تنظیم محدوده"
    pub func SetBounds(bounds: Rect):
        this.rect = bounds
    end

    @en "Measure"
    @fa "اندازه‌گیری"
    pub func Measure(axis: Axis, max_width: int): Measure:
        _ := axis
        _ := max_width
        ret Measure { ok = false, extent = 0 }
    end

end

func _clamped(v: int, max: int): int:
    if max <= 0:
        ret 0
    end
    if v < 0:
        ret 0
    end
    if v > max:
        ret max
    end
    ret v
end

@en "NewProgress"
@fa "نوار پیشرفت جدید"
pub func NewProgress(): Progress:
    ret Progress {}
end
