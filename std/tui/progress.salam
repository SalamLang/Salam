package tui

import str
import term

@en "Progress"
@fa "نوار‌پیشرفت"
pub struct Progress:
    pub use BaseWidget

    @en "fill_style"
    @fa "ظاهر بخش پر"
    pub fill_style: Style = StyleDefault

    @en "empty_style"
    @fa "ظاهر بخش خالی"
    pub empty_style: Style = StyleDefault

    @en "text_style"
    @fa "ظاهر متن"
    pub text_style: Style = StyleDefault

    value: int = 0
    max: int = 100

    @en "hits"
    @fa "اصابت‌پذیر است"
    pub func hits(): bool:
        ret false
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    pub func preferred_size(max_width: int): Rect:
        _ := max_width
        ret Rect { width = -1, height = 1 }
    end

    @en "progress"
    @fa "مقدار پیشرفت"
    pub func progress(): int:
        ret this.value
    end

    @en "set_progress"
    @fa "تنظیم پیشرفت"
    pub func set_progress(percent: int):
        this.value = _clamped(percent, this.max)
    end

    @en "set_max"
    @fa "تنظیم بیشینه"
    pub func set_max(limit: int):
        this.max = limit
        this.value = _clamped(this.value, limit)
    end

    @en "render"
    @fa "ترسیم"
    pub func render(buf: Buffer, bounds: Rect):
        w := bounds.width
        if w <= 0:
            ret
        end
        tail := w >= 6
        mut bar := w
        if tail:
            bar = w - 5
        end
        v := _clamped(this.value, this.max)
        mut filled := 0
        mut pct := 0
        if this.max > 0:
            filled = (bar * v) / this.max
            pct = (100 * v) / this.max
        end
        repeat bar in i:
            if i < filled:
                buf.set(bounds.x + i, bounds.y, Cell { ch = "#", style = this.fill_style })
            else:
                buf.set(bounds.x + i, bounds.y, Cell { ch = "-", style = this.empty_style })
            end
        end
        if tail:
            buf.put_str(bounds.x + bar, bounds.y, " " + term.PadLeft(str.FromInt(pct), 3) + "%", this.text_style)
        end
    end
end

func _clamped(v: int, max: int): int:
    if max <= 0:
        ret 0
    end
    if v < 0:
        ret 0
    end
    if v > max:
        ret max
    end
    ret v
end

@en "NewProgress"
@fa "نوار پیشرفت جدید"
pub func NewProgress(): Progress:
    ret Progress {}
end
