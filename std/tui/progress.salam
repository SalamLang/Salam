/*
 * Progress: a one-row bar that shows how far along a task is.
 *
 * Progress draws into the Buffer like every other widget, so it never writes
 * the terminal. It is the Buffer-native equivalent of std/term's Bar: the
 * filled cells are '#', the empty cells are '-', and the fill is computed
 * with integer floor division, so the bar is full exactly at 100%. When the
 * width allows, a fixed five-cell tail shows the percentage. The tail is
 * one space, the percentage right-aligned in three cells, then '%'. It is
 * drawn only when the width is at least six cells, and it is never
 * truncated.
 *
 * This widget deliberately does not take focus, does not take clicks (hits
 * is false, so a click falls through to the widget beneath), and consumes no
 * events. It has no label, no animation, and no redraw API: after
 * set_progress the host sets screen.dirty so the next frame shows the new
 * value.
 */

package tui

import str
import term

@en "Progress"
@fa "نوار پیشرفت"
/// A one-row progress bar. It fills left to right from the value, which is a
/// percentage of max (100 by default). Set the value with set_progress and
/// the maximum with set_max. Style the filled cells, the empty cells and the
/// percent tail separately with the fill_style, empty_style and text_style
/// fields.
pub struct Progress:
    pub use BaseWidget

    @en "fill_style"
    @fa "ظاهر بخش پر"
    /// Style of the filled cells. StyleDefault uses the terminal's defaults.
    pub fill_style: Style = StyleDefault

    @en "empty_style"
    @fa "ظاهر بخش خالی"
    /// Style of the empty cells.
    pub empty_style: Style = StyleDefault

    @en "text_style"
    @fa "ظاهر متن"
    /// Style of the five-cell percent tail.
    pub text_style: Style = StyleDefault

    value: int = 0
    max: int = 100

    @en "hits"
    @fa "اصابت‌پذیر است"
    /// Returns false: a click on the bar falls through to the widget painted
    /// beneath it.
    pub func hits(): bool:
        ret false
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    /// Unknown width (the layout fills the available width) and one row.
    pub func preferred_size(max_width: int): Rect:
        _ := max_width
        ret Rect { width = -1, height = 1 }
    end

    @en "progress"
    @fa "مقدار پیشرفت"
    /// The stored value, already clamped to 0..max.
    pub func progress(): int:
        ret this.value
    end

    @en "set_progress"
    @fa "تنظیم پیشرفت"
    /// Sets the value, clamped to 0..max. Values above max show as full, and
    /// values below 0 show as empty.
    pub func set_progress(percent: int):
        this.value = _clamped(percent, this.max)
    end

    @en "set_max"
    @fa "تنظیم بیشینه"
    /// Sets the value that means 100%, and clamps the stored value to the new
    /// range. A maximum of 0 or less makes the bar empty.
    pub func set_max(limit: int):
        this.max = limit
        this.value = _clamped(this.value, limit)
    end

    @en "render"
    @fa "ترسیم"
    /// Draws one row at bounds.y, from bounds.x across bounds.width cells.
    /// The bar takes the width less the tail, when the tail is shown. Nothing
    /// is drawn when the width is zero or less. Every cell is written through
    /// set, which clips to the buffer.
    pub func render(buf: Buffer, bounds: Rect):
        w := bounds.width
        if w <= 0:
            ret
        end
        tail := w >= 6
        mut bar := w
        if tail:
            bar = w - 5
        end
        v := _clamped(this.value, this.max)
        mut filled := 0
        mut pct := 0
        if this.max > 0:
            filled = (bar * v) / this.max
            pct = (100 * v) / this.max
        end
        repeat bar in i:
            if i < filled:
                buf.set(bounds.x + i, bounds.y, Cell { ch = "#", style = this.fill_style })
            else:
                buf.set(bounds.x + i, bounds.y, Cell { ch = "-", style = this.empty_style })
            end
        end
        if tail:
            buf.put_str(bounds.x + bar, bounds.y, " " + term.PadLeft(str.FromInt(pct), 3) + "%", this.text_style)
        end
    end
end

// Clamps v to 0..max. A non-positive max stores 0, so the value and the
// rendered bar never disagree.
func _clamped(v: int, max: int): int:
    if max <= 0:
        ret 0
    end
    if v < 0:
        ret 0
    end
    if v > max:
        ret max
    end
    ret v
end

@en "NewProgress"
@fa "نوار پیشرفت جدید"
/// Creates a Progress at 0% with the maximum at 100 and default styles.
pub func NewProgress(): Progress:
    ret Progress {}
end
