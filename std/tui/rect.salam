/*
 * Geometry: Point and Rect.
 *
 * Everything in tui is positioned on the terminal's cell grid, so all
 * coordinates are integers: x is the column, y is the row, and (0, 0) is the
 * top-left cell. The origin is 0-based, unlike the 1-based coordinates that
 * terminal escape sequences use; the conversion happens once, when a frame is
 * written out, and nowhere else.
 *
 * A Rect is half-open: it covers columns x .. x + width - 1 and rows
 * y .. y + height - 1. The cell at (x + width, y) is outside it. This makes
 * the edge cases fall out naturally:
 *
 *   - two rects that share an edge (one ends where the other starts) touch
 *     but do not intersect;
 *   - a rect with zero or negative width or height is empty: it contains no
 *     point and intersects nothing, not even itself.
 *
 * Negative coordinates are allowed. A widget may be placed partly or wholly
 * off-screen; drawing clips it, geometry does not reject it.
 *
 * This file deliberately has no notion of layout (splitting, padding,
 * alignment). That is the layout engine's job (layout.salam);
 * widgets receive finished rects through Widget.set_bounds.
 */

package tui

@en "Point"
@fa "نقطه"
/// A single cell position: x is the column, y the row, both 0-based.
pub struct Point:
    @en "x"
    @fa "ایکس"
    /// Column, counted from 0 at the left edge.
    pub x: int = 0

    @en "y"
    @fa "ایگرگ"
    /// Row, counted from 0 at the top edge.
    pub y: int = 0
end

@en "Rect"
@fa "مستطیل"
/// An axis-aligned, half-open rectangle of terminal cells.
/// Covers columns x .. x + width - 1 and rows y .. y + height - 1.
pub struct Rect:
    @en "x"
    @fa "ایکس"
    /// Column of the left edge.
    pub x: int = 0

    @en "y"
    @fa "ایگرگ"
    /// Row of the top edge.
    pub y: int = 0

    @en "width"
    @fa "عرض"
    /// Number of columns. Zero or negative means the rect is empty.
    pub width: int = 0

    @en "height"
    @fa "ارتفاع"
    /// Number of rows. Zero or negative means the rect is empty.
    pub height: int = 0

    @en "is_empty"
    @fa "خالی است"
    /// True when the rect covers no cells (width or height <= 0).
    pub func is_empty(): bool:
        ret this.width <= 0 or this.height <= 0
    end

    @en "right"
    @fa "راست"
    /// The first column to the right of the rect (x + width), exclusive.
    pub func right(): int:
        ret this.x + this.width
    end

    @en "bottom"
    @fa "پایین"
    /// The first row below the rect (y + height), exclusive.
    pub func bottom(): int:
        ret this.y + this.height
    end

    @en "contains"
    @fa "دربرمی‌گیرد"
    /// True when the cell p lies inside the rect. Uses the half-open rule,
    /// so the right and bottom edges are outside, and an empty rect
    /// contains nothing.
    pub func contains(p: Point): bool:
        if this.is_empty():
            ret false
        end
        ret p.x >= this.x and p.x < this.right() and p.y >= this.y and p.y < this.bottom()
    end

    @en "intersects"
    @fa "هم‌پوشانی دارد"
    /// True when the two rects share at least one cell. Rects that only
    /// touch along an edge do not intersect, and an empty rect intersects
    /// nothing.
    pub func intersects(other: Rect): bool:
        if this.is_empty() or other.is_empty():
            ret false
        end
        ret this.x < other.right() and other.x < this.right() and this.y < other.bottom() and other.y < this.bottom()
    end

    @en "intersection"
    @fa "اشتراک"
    /// The cells shared by both rects. When they do not intersect the
    /// result is an empty Rect at the origin.
    pub func intersection(other: Rect): Rect:
        if not this.intersects(other):
            ret Rect {}
        end
        x := this.x > other.x ? this.x : other.x
        y := this.y > other.y ? this.y : other.y
        r := this.right() < other.right() ? this.right() : other.right()
        b := this.bottom() < other.bottom() ? this.bottom() : other.bottom()
        ret Rect { x = x, y = y, width = r - x, height = b - y }
    end

    @en "center"
    @fa "مرکز"
    /// The center cell: (x + width / 2, y + height / 2) with integer
    /// division. An odd size has an exact middle cell (3x3 at the origin
    /// gives (1, 1)). An even size has none, so the cell just right of and
    /// below the geometric middle is used (4x4 at the origin gives (2, 2)).
    /// The result is not meaningful for an empty rect.
    pub func center(): Point:
        ret Point { x = this.x + this.width / 2, y = this.y + this.height / 2 }
    end
end
