package tui

@en "Point"
@fa "نقطه"
pub struct Point:
    @en "x"
    @fa "ایکس"
    pub x: int = 0

    @en "y"
    @fa "ایگرگ"
    pub y: int = 0
end

@en "Rect"
@fa "مستطیل"
pub struct Rect:
    @en "x"
    @fa "ایکس"
    pub x: int = 0

    @en "y"
    @fa "ایگرگ"
    pub y: int = 0

    @en "width"
    @fa "عرض"
    pub width: int = 0

    @en "height"
    @fa "ارتفاع"
    pub height: int = 0

    @en "is_empty"
    @fa "خالی است"
    pub func IsEmpty(): bool:
        ret this.width <= 0 or this.height <= 0
    end

    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): bool:
        ret this.IsEmpty()
    end

    @en "right"
    @fa "راست"
    pub func Right(): int:
        ret this.x + this.width
    end

    @en "right"
    @fa "راست"
    pub func right(): int:
        ret this.Right()
    end

    @en "bottom"
    @fa "پایین"
    pub func Bottom(): int:
        ret this.y + this.height
    end

    @en "bottom"
    @fa "پایین"
    pub func bottom(): int:
        ret this.Bottom()
    end

    @en "contains"
    @fa "دربرمی‌گیرد"
    pub func Contains(p: Point): bool:
        if this.IsEmpty():
            ret false
        end
        ret p.x >= this.x and p.x < this.right() and p.y >= this.y and p.y < this.bottom()
    end

    @en "contains"
    @fa "دربرمی‌گیرد"
    pub func contains(p: Point): bool:
        ret this.Contains(p)
    end

    @en "intersects"
    @fa "هم‌پوشانی دارد"
    pub func Intersects(other: Rect): bool:
        if this.IsEmpty() or other.IsEmpty():
            ret false
        end
        ret this.x < other.right() and other.x < this.right() and this.y < other.bottom() and other.y < this.bottom()
    end

    @en "intersects"
    @fa "هم‌پوشانی دارد"
    pub func intersects(other: Rect): bool:
        ret this.Intersects(other)
    end

    @en "intersection"
    @fa "اشتراک"
    pub func Intersection(other: Rect): Rect:
        if not this.intersects(other):
            ret Rect {}
        end
        x := this.x > other.x ? this.x : other.x
        y := this.y > other.y ? this.y : other.y
        r := this.right() < other.right() ? this.right() : other.right()
        b := this.bottom() < other.bottom() ? this.bottom() : other.bottom()
        ret Rect { x = x, y = y, width = r - x, height = b - y }
    end

    @en "intersection"
    @fa "اشتراک"
    pub func intersection(other: Rect): Rect:
        ret this.Intersection(other)
    end

    @en "center"
    @fa "مرکز"
    pub func Center(): Point:
        ret Point { x = this.x + this.width / 2, y = this.y + this.height / 2 }
    end

    @en "center"
    @fa "مرکز"
    pub func center(): Point:
        ret this.Center()
    end
end
