package tui

import str

@en "Orientation"
@fa "جهت‌گیری"
pub enum Orientation:
    @en "Horizontal"
    @fa "افقی"
    Horizontal

    @en "Vertical"
    @fa "عمودی"
    Vertical
end

@en "Separator"
@fa "جداکننده"
pub struct Separator:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "orientation"
    @fa "جهت‌گیری"
    pub orientation: Orientation = Orientation.Horizontal

    @en "ch"
    @fa "نویسه"
    pub ch: str = ""

    @en "style"
    @fa "ظاهر"
    pub style: Style = StyleDefault

    @en "Focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret false
    end

    @en "Hits"
    @fa "اصابت‌پذیر است"
    pub func Hits(): bool:
        ret false
    end

    @en "HandleEvent"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        _ := event
        ret false
    end

    @en "PreferredSize"
    @fa "اندازه ترجیحی"
    pub func PreferredSize(max_width: int): Rect:
        _ := max_width
        if this.orientation == Orientation.Vertical:
            ret Rect { width = 1, height = -1 }
        end
        ret Rect { width = -1, height = 1 }
    end

    @en "Measure"
    @fa "اندازه‌گیری"
    pub func Measure(axis: Axis, max_width: int): Measure:
        mut along := Axis.X
        if this.orientation == Orientation.Vertical:
            along = Axis.Y
        end
        mut extent := 1
        if axis == along:
            extent = max_width
        end
        ret Measure { ok = true, extent = extent }
    end

    @en "SetOrientation"
    @fa "تنظیم جهت‌گیری"
    pub func SetOrientation(o: Orientation):
        this.orientation = o
    end

    @en "SetCh"
    @fa "تنظیم نویسه"
    pub func SetCh(ch: str): bool:
        if ch == "":
            this.ch = ""
            ret true
        end
        cps := str.CodePoints(ch)
        defer cps.Free()
        if cps.Len() != 1 or _cell_width(cps.Get(0)) != 1:
            ret false
        end
        this.ch = ch
        ret true
    end

    @en "SetStyle"
    @fa "تنظیم ظاهر"
    pub func SetStyle(s: Style):
        this.style = s
    end

    @en "Render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        if bounds.width <= 0 or bounds.height <= 0:
            ret
        end
        if this.style.bg != Color.Default:
            buf.fill(bounds, " ", Style { bg = this.style.bg })
        end
        r := _rune(this.orientation, this.ch, buf.glyphs)
        st := this.style
        if this.orientation == Orientation.Vertical:
            repeat bounds.height in i:
                buf.Set(bounds.x, bounds.y + i, Cell { ch = r, style = st })
            end
        else:
            repeat bounds.width in i:
                buf.Set(bounds.x + i, bounds.y, Cell { ch = r, style = st })
            end
        end
    end

    @en "Visible"
    @fa "Visible"
    pub func Visible(): bool:
        ret true
    end

    @en "Bounds"
    @fa "Bounds"
    pub func Bounds(): Rect:
        ret this.rect
    end

    @en "SetBounds"
    @fa "SetBounds"
    pub func SetBounds(bounds: Rect):
        this.rect = bounds
    end

end

func _rune(o: Orientation, ch: str, glyphs: GlyphPolicy): str:
    ascii := glyphs == GlyphPolicy.ASCII
    if ch != "" and not (ascii and ch.Len() > 1):
        ret ch
    end
    if o == Orientation.Vertical:
        ret ascii ? "|" : "│"
    end
    ret ascii ? "-" : "─"
end

@en "NewSeparator"
@fa "جداکننده جدید"
pub func NewSeparator(): Separator:
    ret Separator {}
end
