/*
 * Separator: a one-line rule, horizontal or vertical, drawn in the rune of
 * your choice.
 *
 * The orientation is a field, never the rect's shape: an 8x3 rect with a
 * horizontal Separator paints row 0 only, and a 3x3 rect with a vertical one
 * paints column 0 only. Cells off that line are not painted, so they keep
 * whatever the frame under them holds. When style.bg is set, the whole rect is
 * filled with the background first, then the runes are drawn over it.
 *
 * The rune is one cell wide by construction (set_ch refuses anything else), so
 * the render path needs no wide-glyph handling. An empty ch means the
 * orientation's default rune: U+2500 for horizontal, U+2502 for vertical.
 *
 * This widget deliberately has no length field (the layout engine sizes it),
 * no dashed or dotted styles, and no per-segment styling. It does not take
 * focus, does not take clicks (hits is false), and consumes no events.
 */

package tui

import str

@en "Orientation"
@fa "جهت‌گیری"
/// The direction of a Separator's rule.
pub enum Orientation:
    @en "Horizontal"
    @fa "افقی"
    /// A rule across row 0 of the rect, full width. The default.
    Horizontal

    @en "Vertical"
    @fa "عمودی"
    /// A rule down column 0 of the rect, full height.
    Vertical
end

@en "Separator"
@fa "جداکننده"
/// A one-line rule that draws one rune repeated along the rect's first row
/// (horizontal) or first column (vertical). Set the direction with
/// set_orientation, the rune with set_ch and its style with set_style.
pub struct Separator:
    pub use BaseWidget

    @en "orientation"
    @fa "جهت‌گیری"
    /// Which line is drawn. Horizontal by default.
    pub orientation: Orientation = Orientation.Horizontal

    @en "ch"
    @fa "نویسه"
    /// The rune, one cell wide. Empty means the orientation's default rune.
    pub ch: str = ""

    @en "style"
    @fa "ظاهر"
    /// The rule's style. Its foreground colours the rune cells. A set
    /// background fills the whole rect before the rune is drawn.
    pub style: Style = StyleDefault

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    /// Returns false: a separator never takes focus.
    pub func focusable(): bool:
        ret false
    end

    @en "hits"
    @fa "اصابت‌پذیر است"
    /// Returns false: a click on the rule falls through to the widget beneath.
    pub func hits(): bool:
        ret false
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    /// Consumes nothing: returns false so the event bubbles on.
    pub func handle_event(event: Event): bool:
        _ := event
        ret false
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    /// Horizontal: unknown width (the layout fills the available width) and
    /// one row. Vertical: one column and unknown height.
    pub func preferred_size(max_width: int): Rect:
        _ := max_width
        if this.orientation == Orientation.Vertical:
            ret Rect { width = 1, height = -1 }
        end
        ret Rect { width = -1, height = 1 }
    end

    @en "measure"
    @fa "اندازه‌گیری"
    /// Always measurable. The cross axis is one cell. The main axis takes
    /// max_width, the same fill the preferred_size sentinel asks for. A
    /// separator never reports ok = false, so the layout never falls back to
    /// a stub.
    pub func measure(axis: Axis, max_width: int): Measure:
        mut along := Axis.X
        if this.orientation == Orientation.Vertical:
            along = Axis.Y
        end
        mut extent := 1
        if axis == along:
            extent = max_width
        end
        ret Measure { ok = true, extent = extent }
    end

    @en "set_orientation"
    @fa "تنظیم جهت‌گیری"
    /// Sets the direction of the rule.
    pub func set_orientation(o: Orientation):
        this.orientation = o
    end

    @en "set_ch"
    @fa "تنظیم نویسه"
    /// Sets the rune. The rune must be exactly one cell wide, by display width.
    /// An empty string resets to the orientation's default rune. Any other
    /// string that is wide or zero-width is refused: nothing changes, the
    /// previous rune stays, and the call returns false. The rule is a bool,
    /// not an error, because the library's constructors and methods are
    /// infallible.
    pub func set_ch(ch: str): bool:
        if ch == "":
            this.ch = ""
            ret true
        end
        cps := str.CodePoints(ch)
        defer cps.free()
        if cps.len() != 1 or _cell_width(cps.get(0)) != 1:
            ret false
        end
        this.ch = ch
        ret true
    end

    @en "set_style"
    @fa "تنظیم ظاهر"
    /// Sets the style of the rule and its background.
    pub func set_style(s: Style):
        this.style = s
    end

    @en "render"
    @fa "ترسیم"
    /// Draws the rule inside bounds. Nothing is drawn when the rect has no
    /// width or no height. A set background fills the whole rect first. The
    /// rune then repeats along row 0 (horizontal) or column 0 (vertical) of
    /// the rect, full length. Every write goes through set, which clips to
    /// the buffer.
    pub func render(buf: Buffer, bounds: Rect):
        if bounds.width <= 0 or bounds.height <= 0:
            ret
        end
        if this.style.bg != Color.Default:
            buf.fill(bounds, " ", Style { bg = this.style.bg })
        end
        r := _rune(this.orientation, this.ch)
        st := this.style
        if this.orientation == Orientation.Vertical:
            repeat bounds.height in i:
                buf.set(bounds.x, bounds.y + i, Cell { ch = r, style = st })
            end
        else:
            repeat bounds.width in i:
                buf.set(bounds.x + i, bounds.y, Cell { ch = r, style = st })
            end
        end
    end
end

// The rune to draw: the caller's ch, or the orientation's default when ch is
// empty. The defaults are the box-drawing light lines, U+2500 and U+2502.
func _rune(o: Orientation, ch: str): str:
    if ch != "":
        ret ch
    end
    if o == Orientation.Vertical:
        ret "│"
    end
    ret "─"
end

@en "NewSeparator"
@fa "جداکننده جدید"
/// Creates a horizontal Separator with the default rune and default style.
pub func NewSeparator(): Separator:
    ret Separator {}
end
