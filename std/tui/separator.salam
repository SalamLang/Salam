package tui

import str

@en "Orientation"
@fa "جهت‌گیری"
pub enum Orientation:
    @en "Horizontal"
    @fa "افقی"
    Horizontal

    @en "Vertical"
    @fa "عمودی"
    Vertical
end

@en "Separator"
@fa "جداکننده"
pub struct Separator:
    pub use BaseWidget

    @en "orientation"
    @fa "جهت‌گیری"
    pub orientation: Orientation = Orientation.Horizontal

    @en "ch"
    @fa "نویسه"
    pub ch: str = ""

    @en "style"
    @fa "ظاهر"
    pub style: Style = StyleDefault

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func focusable(): bool:
        ret false
    end

    @en "hits"
    @fa "اصابت‌پذیر است"
    pub func hits(): bool:
        ret false
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func handle_event(event: Event): bool:
        _ := event
        ret false
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    pub func preferred_size(max_width: int): Rect:
        _ := max_width
        if this.orientation == Orientation.Vertical:
            ret Rect { width = 1, height = -1 }
        end
        ret Rect { width = -1, height = 1 }
    end

    @en "measure"
    @fa "اندازه‌گیری"
    pub func measure(axis: Axis, max_width: int): Measure:
        mut along := Axis.X
        if this.orientation == Orientation.Vertical:
            along = Axis.Y
        end
        mut extent := 1
        if axis == along:
            extent = max_width
        end
        ret Measure { ok = true, extent = extent }
    end

    @en "set_orientation"
    @fa "تنظیم جهت‌گیری"
    pub func set_orientation(o: Orientation):
        this.orientation = o
    end

    @en "set_ch"
    @fa "تنظیم نویسه"
    pub func set_ch(ch: str): bool:
        if ch == "":
            this.ch = ""
            ret true
        end
        cps := str.CodePoints(ch)
        defer cps.free()
        if cps.len() != 1 or _cell_width(cps.get(0)) != 1:
            ret false
        end
        this.ch = ch
        ret true
    end

    @en "set_style"
    @fa "تنظیم ظاهر"
    pub func set_style(s: Style):
        this.style = s
    end

    @en "render"
    @fa "ترسیم"
    pub func render(buf: Buffer, bounds: Rect):
        if bounds.width <= 0 or bounds.height <= 0:
            ret
        end
        if this.style.bg != Color.Default:
            buf.fill(bounds, " ", Style { bg = this.style.bg })
        end
        r := _rune(this.orientation, this.ch, buf.glyphs)
        st := this.style
        if this.orientation == Orientation.Vertical:
            repeat bounds.height in i:
                buf.set(bounds.x, bounds.y + i, Cell { ch = r, style = st })
            end
        else:
            repeat bounds.width in i:
                buf.set(bounds.x + i, bounds.y, Cell { ch = r, style = st })
            end
        end
    end
end

func _rune(o: Orientation, ch: str, glyphs: GlyphPolicy): str:
    ascii := glyphs == GlyphPolicy.ASCII
    if ch != "" and not (ascii and ch.len() > 1):
        ret ch
    end
    if o == Orientation.Vertical:
        ret ascii ? "|" : "│"
    end
    ret ascii ? "-" : "─"
end

@en "NewSeparator"
@fa "جداکننده جدید"
pub func NewSeparator(): Separator:
    ret Separator {}
end
