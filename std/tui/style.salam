package tui

import mem
import str
import term

@en "StyleDefault"
@fa "ظاهر پیش‌فرض"
pub const StyleDefault := Style {}

mut _sgr_builds := 0

@en "BorderStyle"
@fa "سبک‌کادر"
pub enum BorderStyle:
    @en "None"
    @fa "بدون کادر"
    None
    @en "Single"
    @fa "تک خط"
    Single
    @en "Double"
    @fa "دو خط"
    Double
    @en "Rounded"
    @fa "گوشه‌گرد"
    Rounded
end

@en "Style"
@fa "ظاهر"
pub struct Style:
    @en "fg"
    @fa "رنگ پیش‌زمینه"
    pub fg: Color = Color.Default

    @en "bg"
    @fa "رنگ پس‌زمینه"
    pub bg: Color = Color.Default

    @en "bold"
    @fa "پررنگ"
    pub bold: bool = false

    @en "dim"
    @fa "کم‌رنگ"
    pub dim: bool = false

    @en "italic"
    @fa "کج"
    pub italic: bool = false

    @en "underline"
    @fa "زیرخط"
    pub underline: bool = false

    @en "reverse"
    @fa "وارونه"
    pub reverse: bool = false
end

func _color_shown(c: Color, tier: ColorTier): bool:
    ret Lower(c, tier) != Color.Default
end

func _append_free(b &: str.StringBuilder, s: str):
    str.BufAppend(b, s)
    mem.Free(s as void*)
end

func _append_sgr(b &: str.StringBuilder, style: Style, tier: ColorTier): bool:
    mut wrote := false
    if style.bold:
        _append_free(b, term.Sgr(term.StyleBold))
        wrote = true
    end
    if style.dim:
        _append_free(b, term.Sgr(term.StyleDim))
        wrote = true
    end
    if style.italic:
        _append_free(b, term.Sgr(term.StyleItalic))
        wrote = true
    end
    if style.underline:
        _append_free(b, term.Sgr(term.StyleUnderline))
        wrote = true
    end
    if style.reverse:
        _append_free(b, term.Sgr(term.StyleReverse))
        wrote = true
    end
    if _color_shown(style.fg, tier):
        _append_free(b, FgSeqAt(style.fg, tier))
        wrote = true
    end
    if _color_shown(style.bg, tier):
        _append_free(b, BgSeqAt(style.bg, tier))
        wrote = true
    end
    if wrote:
        _sgr_builds++
    end
    ret wrote
end

func _append_sgr_off(b &: str.StringBuilder, style: Style, tier: ColorTier): bool:
    mut wrote := false
    if style.bold or style.dim:
        _append_free(b, term.Sgr(22))
        wrote = true
    end
    if style.italic:
        _append_free(b, term.Sgr(23))
        wrote = true
    end
    if style.underline:
        _append_free(b, term.Sgr(24))
        wrote = true
    end
    if style.reverse:
        _append_free(b, term.Sgr(27))
        wrote = true
    end
    if _color_shown(style.fg, tier):
        _append_free(b, term.Sgr(term.FgDefault))
        wrote = true
    end
    if _color_shown(style.bg, tier):
        _append_free(b, term.Sgr(term.BgDefault))
        wrote = true
    end
    if wrote:
        _sgr_builds++
    end
    ret wrote
end

@en "BorderInset"
@fa "ضخامت کادر"
pub func BorderInset(b: BorderStyle): int:
    ret b == BorderStyle.None ? 0 : 1
end

@en "StyleMerge"
@fa "ادغام ظاهر"
pub func StyleMerge(parent: Style, child: Style): Style:
    ret Style {
        fg = child.fg == Color.Default ? parent.fg : child.fg, bg = child.bg == Color.Default ? parent.bg : child.bg,
        bold = parent.bold or child.bold, dim = parent.dim or child.dim, italic = parent.italic or child.italic,
        underline = parent.underline or child.underline, reverse = parent.reverse or child.reverse,
    }
end

@en "StyleEq"
@fa "برابری ظاهر"
pub func StyleEq(a: Style, b: Style): bool:
    ret a.fg == b.fg and a.bg == b.bg and a.bold == b.bold and a.dim == b.dim and a.italic == b.italic and a.underline == b.underline and a.reverse == b.reverse
end

@en "StyleSgr"
@fa "دنباله فعال‌سازی ظاهر"
pub func StyleSgr(style: Style, tier: ColorTier): str:
    mut b := str.NewBuilder()
    if not _append_sgr(b, style, tier):
        str.BufFree(b)
        ret ""
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

@en "StyleSgrOff"
@fa "دنباله غیرفعال‌سازی ظاهر"
pub func StyleSgrOff(style: Style, tier: ColorTier): str:
    mut b := str.NewBuilder()
    if not _append_sgr_off(b, style, tier):
        str.BufFree(b)
        ret ""
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

@en "SgrBuilds"
@fa "شمار ساخت اس‌جی‌آر"
pub func SgrBuilds(): int:
    ret _sgr_builds
end
