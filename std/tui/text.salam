package tui

import str

@en "Alignment"
@fa "تراز"
pub enum Alignment:
    @en "Left"
    @fa "چپ"
    Left
    @en "Center"
    @fa "مرکز"
    Center
    @en "Right"
    @fa "راست"
    Right
end

@en "WrapMode"
@fa "حالت‌شکست‌خط"
pub enum WrapMode:
    @en "Word"
    @fa "بر پایه واژه"
    Word
    @en "None"
    @fa "بدون شکست"
    None
end

@en "Text"
@fa "متن"
pub struct Text:
    @en "BaseWidget"
    @fa "ویجت پایه"
    pub use BaseWidget

    @en "content"
    @fa "محتوا"
    pub content: str = ""

    @en "align"
    @fa "تراز"
    pub align: Alignment = Alignment.Left

    @en "style"
    @fa "ظاهر"
    pub style: Style = StyleDefault

    @en "wrap"
    @fa "شکست خط"
    pub wrap: WrapMode = WrapMode.Word

    source: func () str = (): ret "" end
    source_set: bool = false

    func _content(): str:
        if this.source_set:
            ret this.source()
        end
        ret this.content
    end

    @en "SetText"
    @fa "تنظیم متن"
    pub func SetText(content: str):
        this.content = content
        this.source_set = false
    end

    @en "SetSource"
    @fa "تنظیم منبع"
    pub func SetSource(src: func () str):
        this.source = src
        this.source_set = true
    end

    @en "ClearSource"
    @fa "پاک‌سازی منبع"
    pub func ClearSource():
        this.source_set = false
    end

    @en "SetAlign"
    @fa "تنظیم تراز"
    pub func SetAlign(align: Alignment):
        this.align = align
    end

    @en "SetStyle"
    @fa "تنظیم ظاهر"
    pub func SetStyle(style: Style):
        this.style = style
    end

    @en "SetWrap"
    @fa "تنظیم شکست خط"
    pub func SetWrap(wrap: WrapMode):
        this.wrap = wrap
    end

    @en "PreferredSize"
    @fa "اندازه ترجیحی"
    pub func PreferredSize(max_width: int): Rect:
        content := this._content()
        if this.source_set and content == "":
            ret Rect {}
        end
        ret MeasureText(content, max_width)
    end

    @en "PreferredWidth"
    @fa "عرض ترجیحی"
    pub func PreferredWidth(): int:
        ret MeasureText(this._content(), 0).width
    end

    @en "Render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        pad := Style { bg = this.style.bg }
        glyph := this.style
        buf.Fill(bounds, " ", pad)
        mut lines := Vector {} as Vector<str>
        if this.wrap == WrapMode.None:
            lines = WrapText(this._content(), 0)
        else:
            lines = WrapText(this._content(), bounds.width)
        end
        defer lines.Free()
        mut n := lines.Len()
        if n > bounds.height:
            n = bounds.height
        end
        if n < 0:
            n = 0
        end
        repeat n in i:
            line := lines.Get(i)
            mut slack := bounds.width - _text_width(line)
            if slack < 0:
                slack = 0
            end
            mut offset := 0
            if this.align == Alignment.Right:
                offset = slack
            else this.align == Alignment.Center:
                offset = slack / 2
            end
            buf.PutStr(bounds.x + offset, bounds.y + i, line, glyph)
        end
    end

    @en "HandleEvent"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        _ := event
        ret false
    end

    @en "Focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret false
    end

    @en "Hits"
    @fa "اصابت‌پذیر است"
    pub func Hits(): bool:
        ret true
    end

    @en "Visible"
    @fa "نمایان است"
    pub func Visible(): bool:
        ret true
    end

    @en "Bounds"
    @fa "محدوده"
    pub func Bounds(): Rect:
        ret this.rect
    end

    @en "SetBounds"
    @fa "تنظیم محدوده"
    pub func SetBounds(bounds: Rect):
        this.rect = bounds
    end

    @en "Measure"
    @fa "اندازه‌گیری"
    pub func Measure(axis: Axis, max_width: int): Measure:
        _ := axis
        _ := max_width
        ret Measure { ok = false, extent = 0 }
    end

end

func _wrapInto(para: str, width: int, out &: Vector<str>):
    if width <= 0 or (para.Find("\t") < 0 and _text_width(para) <= width):
        out.Push(para)
        ret
    end
    mut words := str.Fields(para)
    defer words.Free()
    mut line := ""
    repeat words.Len() in i:
        w := words.Get(i)
        if _text_width(w) > width:
            if _text_width(line) > 0:
                out.Push(line)
                line = ""
            end
            mut chunks := _splitWord(w, width)
            repeat chunks.Len() in c:
                if c + 1 < chunks.Len():
                    out.Push(chunks.Get(c))
                else:
                    line = chunks.Get(c)
                end
            end
            chunks.Free()
        else:
            if _text_width(line) == 0:
                line = w
            else:
                candidate := line + " " + w
                if _text_width(candidate) <= width:
                    line = candidate
                else:
                    out.Push(line)
                    line = w
                end
            end
        end
    end
    out.Push(line)
end

func _splitWord(word: str, width: int): Vector<str>:
    out := Vector {} as Vector<str>
    mut chars := str.Chars(word)
    defer chars.Free()
    mut chunk := ""
    mut chunk_width := 0
    repeat chars.Len() in i:
        ch := chars.Get(i)
        ch_width := _char_width(ch)
        if chunk_width > 0 and chunk_width + ch_width > width:
            out.Push(chunk)
            chunk = ""
            chunk_width = 0
        end
        if chunk_width == 0 and ch_width > width:
            out.Push(chunk + ch)
            chunk = ""
        else:
            chunk += ch
            chunk_width += ch_width
        end
    end
    if chunk_width > 0:
        out.Push(chunk)
    end
    ret out
end

@en "WrapText"
@fa "شکستن خطوط متن"
pub func WrapText(text: str, width: int): Vector<str>:
    mut out := Vector {} as Vector<str>
    paras := str.Split(text, "\n")
    defer paras.Free()
    repeat paras.Len() in i:
        _wrapInto(paras.Get(i), width, out)
    end
    ret out
end

@en "MeasureText"
@fa "اندازه‌گیری متن"
pub func MeasureText(text: str, max_width: int): Rect:
    mut lines := WrapText(text, max_width)
    defer lines.Free()
    mut w := 0
    repeat lines.Len() in i:
        lw := _text_width(lines.Get(i))
        if lw > w:
            w = lw
        end
    end
    ret Rect { width = w, height = lines.Len() }
end

@en "NewText"
@fa "متن جدید"
pub func NewText(content: str): Text:
    ret Text { content = content }
end
