package tui

@en "NoWidget"
@fa "بدون ویجت"
pub const NoWidget := -1

@en "RootId"
@fa "شناسه ریشه"
pub const RootId := 0

@en "Tree"
@fa "درخت"
pub struct Tree:
    @en "widgets"
    @fa "ویجت‌ها"
    pub widgets: Vector<dyn Widget> = Vector {}

    @en "parents"
    @fa "والدها"
    pub parents: Vector<int> = Vector {}

    @en "count"
    @fa "تعداد"
    pub func count(): int:
        ret this.widgets.len()
    end

    @en "valid"
    @fa "معتبر است"
    pub func valid(id: int): bool:
        ret id >= 0 and id < this.widgets.len()
    end

    @en "add"
    @fa "افزودن"
    pub func add(parent: int, w: dyn Widget): int:
        mut p := parent
        if not this.valid(p):
            p = RootId
        end
        this.widgets.push(w)
        this.parents.push(p)
        ret this.widgets.len() - 1
    end

    @en "get"
    @fa "دریافت"
    pub func get(id: int): dyn Widget:
        if not this.valid(id):
            ret this.widgets.get(RootId)
        end
        ret this.widgets.get(id)
    end

    @en "parent"
    @fa "والد"
    pub func parent(id: int): int:
        if not this.valid(id):
            ret NoWidget
        end
        ret this.parents.get(id)
    end

    @en "dispatch"
    @fa "هدایت رویداد"
    pub func dispatch(from: int, event: Event): int:
        mut id := from
        if not this.valid(id):
            id = RootId
        end
        mut ev := event
        until id != NoWidget:
            if this.widgets.get(id).handle_event(ev):
                ret id
            end
            id = this.parents.get(id)
            ev.bubbled = true
        end
        ret NoWidget
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.widgets.free()
        this.parents.free()
    end
end

@en "NewTree"
@fa "درخت جدید"
pub func NewTree(root: dyn Widget): Tree:
    mut t := Tree {}
    t.widgets.push(root)
    t.parents.push(NoWidget)
    ret t
end
