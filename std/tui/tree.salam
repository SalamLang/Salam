/*
 * Tree: the widget registry and event dispatch.
 *
 * The tree records which widgets exist and who is whose parent. It lives
 * outside the widgets on purpose: a widget never needs to know where it
 * sits, and the tree does not add methods to the Widget interface.
 *
 * Identity is an integer ID. Salam's `dyn` values cannot be compared
 * (E021) and cannot be downcast, so "is this the focused widget?" can only
 * be answered by position. A widget's ID is its index in `widgets`:
 *
 *   - the root is always ID 0 (RootId) and has no parent (NoWidget);
 *   - add() appends, so IDs are stable for the tree's lifetime and a
 *     parent's ID is always smaller than its children's. That ordering
 *     makes bubbling loop-free by construction. Focus order (R17) is the
 *     focusable widgets outside hidden subtrees whose stamp equals the
 *     max stamp, ascending id. When nothing is raised, or that layer has
 *     no such widget, it falls back to every focusable widget outside
 *     hidden subtrees in ascending id. Paint order is ascending (stamp,
 *     id) (R16). Unraised widgets share stamp 0, so with nothing raised a
 *     child (added after its parent) paints over it, and a later sibling
 *     paints over an earlier one.
 *
 * Dispatch. An event goes to one starting widget (normally the focused
 * one) and, while unconsumed, to each ancestor in turn up to the root.
 * The first handle_event that returns true stops it. Siblings and
 * descendants never see it. This is how a container handles keys its
 * children ignore without the children knowing about it.
 *
 * Not here: removing or reparenting widgets (IDs would shift), and any
 * notion of focus or the terminal. Focus is kept by the Screen.
 */

package tui

@en "NoWidget"
@fa "بدون ویجت"
/// The ID meaning "no widget": the root's parent, and the result of a
/// dispatch nobody consumed.
pub const NoWidget := -1

@en "RootId"
@fa "شناسه ریشه"
/// The ID of the root widget in every tree.
pub const RootId := 0

@en "Tree"
@fa "درخت"
/// The widgets of one screen and their parent links. Build it with
/// NewTree; a tree always holds at least its root.
pub struct Tree:
    @en "widgets"
    @fa "ویجت‌ها"
    /// The widgets, indexed by ID. Copies of a dyn value share the widget,
    /// so widgets.get(id) reaches the same widget the caller added.
    pub widgets: Vector<dyn Widget> = Vector {}

    @en "parents"
    @fa "والدها"
    /// parents[id] is the parent's ID; NoWidget for the root.
    pub parents: Vector<int> = Vector {}

    @en "count"
    @fa "تعداد"
    /// The number of widgets, root included.
    pub func count(): int:
        ret this.widgets.len()
    end

    @en "valid"
    @fa "معتبر است"
    /// True when id names a widget in this tree.
    pub func valid(id: int): bool:
        ret id >= 0 and id < this.widgets.len()
    end

    @en "add"
    @fa "افزودن"
    /// Adds w as the last child of parent and returns its new ID. An
    /// invalid parent ID attaches the widget to the root instead.
    pub func add(parent: int, w: dyn Widget): int:
        mut p := parent
        if not this.valid(p):
            p = RootId
        end
        this.widgets.push(w)
        this.parents.push(p)
        ret this.widgets.len() - 1
    end

    @en "get"
    @fa "دریافت"
    /// The widget with this ID. An invalid ID returns the root, so the
    /// call can never fail.
    pub func get(id: int): dyn Widget:
        if not this.valid(id):
            ret this.widgets.get(RootId)
        end
        ret this.widgets.get(id)
    end

    @en "parent"
    @fa "والد"
    /// The parent's ID, or NoWidget for the root and for invalid IDs.
    pub func parent(id: int): int:
        if not this.valid(id):
            ret NoWidget
        end
        ret this.parents.get(id)
    end

    @en "dispatch"
    @fa "هدایت رویداد"
    /// Offers event to the widget `from`, then to each of its ancestors up
    /// to the root, until one consumes it. Returns the consumer's ID, or
    /// NoWidget when nobody did. An invalid `from` starts at the root.
    pub func dispatch(from: int, event: Event): int:
        mut id := from
        if not this.valid(id):
            id = RootId
        end
        until id != NoWidget:
            if this.widgets.get(id).handle_event(event):
                ret id
            end
            id = this.parents.get(id)
        end
        ret NoWidget
    end

    @en "free"
    @fa "آزادسازی"
    /// Releases the tree's own storage. The widgets themselves are left
    /// alone: the caller created them and may still hold copies.
    pub func free():
        this.widgets.free()
        this.parents.free()
    end
end

@en "NewTree"
@fa "درخت جدید"
/// Creates a tree whose root (ID 0) is root.
pub func NewTree(root: dyn Widget): Tree:
    mut t := Tree {}
    t.widgets.push(root)
    t.parents.push(NoWidget)
    ret t
end
