package tui

@en "NoWidget"
@fa "بدون ویجت"
pub const NoWidget := -1

@en "RootId"
@fa "شناسه ریشه"
pub const RootId := 0

@en "Tree"
@fa "درخت"
pub struct Tree:
    @en "widgets"
    @fa "ویجت‌ها"
    pub widgets: Vector<dyn Widget> = Vector {}

    @en "parents"
    @fa "والدها"
    pub parents: Vector<int> = Vector {}

    @en "Count"
    @fa "تعداد"
    pub func Count(): int:
        ret this.widgets.Len()
    end

    @en "Valid"
    @fa "معتبر است"
    pub func Valid(id: int): bool:
        ret id >= 0 and id < this.widgets.Len()
    end

    @en "Add"
    @fa "افزودن"
    pub func Add(parent: int, w: dyn Widget): int:
        mut p := parent
        if not this.Valid(p):
            p = RootId
        end
        this.widgets.Push(w)
        this.parents.Push(p)
        ret this.widgets.Len() - 1
    end

    @en "Get"
    @fa "دریافت"
    pub func Get(id: int): dyn Widget:
        if not this.Valid(id):
            ret this.widgets.Get(RootId)
        end
        ret this.widgets.Get(id)
    end

    @en "Parent"
    @fa "والد"
    pub func Parent(id: int): int:
        if not this.Valid(id):
            ret NoWidget
        end
        ret this.parents.Get(id)
    end

    @en "Dispatch"
    @fa "هدایت رویداد"
    pub func Dispatch(from: int, event: Event): int:
        mut id := from
        if not this.Valid(id):
            id = RootId
        end
        mut ev := event
        until id != NoWidget:
            if this.widgets.Get(id).HandleEvent(ev):
                ret id
            end
            id = this.parents.Get(id)
            ev.bubbled = true
        end
        ret NoWidget
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.widgets.Free()
        this.parents.Free()
    end

end

@en "NewTree"
@fa "درخت جدید"
pub func NewTree(root: dyn Widget): Tree:
    mut t := Tree {}
    t.widgets.Push(root)
    t.parents.Push(NoWidget)
    ret t
end
