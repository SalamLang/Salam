package tui

mut _next_memo_id := 0
mut _last_memo_id := 0

@en "Widget"
@fa "ویجت"
pub interface Widget:
    @en "Render"
    @fa "ترسیم"
    func Render(buf: Buffer, bounds: Rect)

    @en "HandleEvent"
    @fa "پردازش رویداد"
    func HandleEvent(event: Event): bool

    @en "Focusable"
    @fa "تمرکز‌پذیر است"
    func Focusable(): bool

    @en "Hits"
    @fa "اصابت‌پذیر است"
    func Hits(): bool

    @en "Visible"
    @fa "نمایان است"
    func Visible(): bool

    @en "Bounds"
    @fa "محدوده"
    func Bounds(): Rect

    @en "SetBounds"
    @fa "تنظیم محدوده"
    func SetBounds(bounds: Rect)

    @en "PreferredSize"
    @fa "اندازه ترجیحی"
    func PreferredSize(max_width: int): Rect

    @en "Measure"
    @fa "اندازه‌گیری"
    func Measure(axis: Axis, max_width: int): Measure

end

@en "BaseWidget"
@fa "ویجت‌پایه"
pub struct BaseWidget:
    @en "rect"
    @fa "مستطیل"
    pub rect: Rect = Rect {}

    memo_id: int = 0

    @en "Render"
    @fa "ترسیم"
    pub func Render(buf: Buffer, bounds: Rect):
        _ := buf
        _ := bounds
    end

    @en "HandleEvent"
    @fa "پردازش رویداد"
    pub func HandleEvent(event: Event): bool:
        _ := event
        ret false
    end

    @en "Focusable"
    @fa "تمرکز‌پذیر است"
    pub func Focusable(): bool:
        ret false
    end

    @en "Hits"
    @fa "اصابت‌پذیر است"
    pub func Hits(): bool:
        ret true
    end

    @en "Visible"
    @fa "نمایان است"
    pub func Visible(): bool:
        ret true
    end

    @en "Bounds"
    @fa "محدوده"
    pub func Bounds(): Rect:
        ret this.rect
    end

    @en "SetBounds"
    @fa "تنظیم محدوده"
    pub func SetBounds(bounds: Rect):
        this.rect = bounds
    end

    @en "PreferredSize"
    @fa "اندازه ترجیحی"
    pub func PreferredSize(max_width: int): Rect:
        _ := max_width
        ret Rect { width = -1, height = -1 }
    end

    @en "Measure"
    @fa "اندازه‌گیری"
    pub func Measure(axis: Axis, max_width: int): Measure:
        _ := axis
        _ := max_width
        this._note_measure()
        ret Measure { ok = false, extent = 0 }
    end

    func _note_measure():
        if this.memo_id == 0:
            _next_memo_id++
            this.memo_id = _next_memo_id
        end
        _last_memo_id = this.memo_id
    end
end
