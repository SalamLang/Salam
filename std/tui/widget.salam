package tui

mut _next_memo_id := 0
mut _last_memo_id := 0

@en "Widget"
@fa "ویجت"
pub interface Widget:
    @en "render"
    @fa "ترسیم"
    func render(buf: Buffer, bounds: Rect)

    @en "handle_event"
    @fa "پردازش رویداد"
    func handle_event(event: Event): bool

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    func focusable(): bool

    @en "hits"
    @fa "اصابت‌پذیر است"
    func hits(): bool

    @en "visible"
    @fa "نمایان است"
    func visible(): bool

    @en "bounds"
    @fa "محدوده"
    func bounds(): Rect

    @en "set_bounds"
    @fa "تنظیم محدوده"
    func set_bounds(bounds: Rect)

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    func preferred_size(max_width: int): Rect

    @en "measure"
    @fa "اندازه‌گیری"
    func measure(axis: Axis, max_width: int): Measure
end

@en "BaseWidget"
@fa "ویجت‌پایه"
pub struct BaseWidget:
    @en "rect"
    @fa "مستطیل"
    pub rect: Rect = Rect {}

    memo_id: int = 0

    @en "render"
    @fa "ترسیم"
    pub func render(buf: Buffer, bounds: Rect):
        _ := buf
        _ := bounds
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    pub func handle_event(event: Event): bool:
        _ := event
        ret false
    end

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    pub func focusable(): bool:
        ret false
    end

    @en "hits"
    @fa "اصابت‌پذیر است"
    pub func hits(): bool:
        ret true
    end

    @en "visible"
    @fa "نمایان است"
    pub func visible(): bool:
        ret true
    end

    @en "bounds"
    @fa "محدوده"
    pub func bounds(): Rect:
        ret this.rect
    end

    @en "set_bounds"
    @fa "تنظیم محدوده"
    pub func set_bounds(bounds: Rect):
        this.rect = bounds
    end

    @en "preferred_size"
    @fa "اندازه ترجیحی"
    pub func preferred_size(max_width: int): Rect:
        _ := max_width
        ret Rect { width = -1, height = -1 }
    end

    @en "measure"
    @fa "اندازه‌گیری"
    pub func measure(axis: Axis, max_width: int): Measure:
        _ := axis
        _ := max_width
        this._note_measure()
        ret Measure { ok = false, extent = 0 }
    end

    func _note_measure():
        if this.memo_id == 0:
            _next_memo_id++
            this.memo_id = _next_memo_id
        end
        _last_memo_id = this.memo_id
    end
end
