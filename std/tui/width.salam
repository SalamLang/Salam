package tui

import str
import unicode

const _WIDE_LO := [0x1100, 0x231A, 0x2329, 0x23E9, 0x23F0, 0x23F3, 0x25FD, 0x2614, 0x2648, 0x267F, 0x2693, 0x26A1, 0x26AA, 0x26BD, 0x26C4, 0x26CE, 0x26D4, 0x26EA, 0x26F2, 0x26F5, 0x26FA, 0x26FD, 0x2705, 0x270A, 0x2728, 0x274C, 0x274E, 0x2753, 0x2757, 0x2795, 0x27B0, 0x27BF, 0x2B1B, 0x2B50, 0x2B55, 0x2E80, 0x3041, 0x3400, 0x4E00, 0xA000, 0xAC00, 0xF900, 0xFE30, 0xFF00, 0xFFE0, 0x1F004, 0x1F0CF, 0x1F18E, 0x1F191, 0x1F200, 0x1F210, 0x1F240, 0x1F250, 0x1F260, 0x1F300, 0x1F680, 0x1F6CC, 0x1F6D0, 0x1F6D5, 0x1F6DC, 0x1F6EB, 0x1F6F4, 0x1F7E0, 0x1F7F0, 0x1F900, 0x1FA70, 0x20000]

const _WIDE_HI := [0x115F, 0x231B, 0x232A, 0x23EC, 0x23F0, 0x23F3, 0x25FE, 0x2615, 0x2653, 0x267F, 0x2693, 0x26A1, 0x26AB, 0x26BE, 0x26C5, 0x26CE, 0x26D4, 0x26EA, 0x26F3, 0x26F5, 0x26FA, 0x26FD, 0x2705, 0x270B, 0x2728, 0x274C, 0x274E, 0x2755, 0x2757, 0x2797, 0x27B0, 0x27BF, 0x2B1C, 0x2B50, 0x2B55, 0x303E, 0x33FF, 0x4DBF, 0x9FFF, 0xA4CF, 0xD7A3, 0xFAFF, 0xFE4F, 0xFF60, 0xFFE6, 0x1F004, 0x1F0CF, 0x1F18E, 0x1F19A, 0x1F202, 0x1F23B, 0x1F248, 0x1F251, 0x1F265, 0x1F64F, 0x1F6C5, 0x1F6CC, 0x1F6D2, 0x1F6D7, 0x1F6DF, 0x1F6EC, 0x1F6FC, 0x1F7EB, 0x1F7F0, 0x1F9FF, 0x1FAFF, 0x3FFFD]

const _WIDE_N := 67

func _cell_width(cp: int): int:
    if cp >= 32 and cp < 127:
        ret 1
    end
    if unicode.IsControl(cp) or unicode.IsMark(cp) or unicode.IsFormat(cp):
        ret 0
    end
    if cp < 0x1100:
        ret 1
    end
    mut lo := 0
    mut hi := _WIDE_N - 1
    until lo <= hi:
        mid := (lo + hi) / 2
        if cp < _WIDE_LO[mid]:
            hi = mid - 1
        else cp > _WIDE_HI[mid]:
            lo = mid + 1
        else:
            ret 2
        end
    end
    ret 1
end

func _char_width(ch: str): int:
    if ch.Len() == 1:
        b := ch[0] as int
        ret b < 32 or b == 127 ? 0 : 1
    end
    if ch.Len() == 0:
        ret 0
    end
    mut cp := 0
    _ := str.CodePointAt(ch, 0, cp)
    if cp < 0:
        ret 1
    end
    ret _cell_width(cp)
end

func _text_width(s: str): int:
    cps := str.CodePoints(s)
    defer cps.Free()
    mut w := 0
    repeat cps.Len() in i:
        w += _cell_width(cps.Get(i))
    end
    ret w
end

func _clip_cells(s: str, n: int): str:
    if n <= 0:
        ret ""
    end
    text := _take_cells(s, n)
    ret text + str.Repeat(" ", n - _text_width(text))
end

func _take_cells(s: str, n: int): str:
    if n <= 0:
        ret ""
    end
    cps := str.CodePoints(s)
    defer cps.Free()
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut used := 0
    mut stop := false
    repeat cps.Len() in i:
        cp := cps.Get(i)
        cw := _cell_width(cp)
        if not stop:
            if used + cw <= n:
                str.BufAppendCp(b, cp)
                used += cw
            else:
                stop = true
            end
        end
    end
    ret str.BufStr(b)
end
