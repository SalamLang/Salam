@en "types"
@fa "نوع‌ها"
@ar "الأنواع"
package types

import str

// Salam is ahead-of-time compiled with no runtime type-info table, so there
// is no true `types.of(anyValue)` reflection here. What IS reliably
// knowable is the *shape* of a raw string - which is exactly the form
// dynamic data actually arrives in throughout this stdlib (env vars, CLI
// args, config/CSV/JSON-ish values): KindOf/IsInt/IsFloat/IsBool classify
// those strings, and Equal<T>/CloneEqual<T> give generic deep-equality for
// the Vector<T> values collections.clone() already copies.
@en "TypeKindNull"
@fa "نوع خالی"
@ar "نوع فارغ"
pub const TypeKindNull := 0

@en "TypeKindBool"
@fa "نوع منطقی"
@ar "نوع منطقی"
pub const TypeKindBool := 1

@en "TypeKindInt"
@fa "نوع صحیح"
@ar "نوع صحیح"
pub const TypeKindInt := 2

@en "TypeKindFloat"
@fa "نوع اعشاری"
@ar "نوع عشری"
pub const TypeKindFloat := 3

@en "TypeKindStr"
@fa "نوع رشته"
@ar "نوع نص"
pub const TypeKindStr := 4

func _is_digit(c: str): bool:
    code := char_code(c)
    ret code >= 48 && code <= 57
end

func _is_sign(c: str): bool: ret c == "-" || c == "+" end

@en "IsInt"
@fa "صحیح است"
@ar "هل صحیح"
pub func IsInt(s: str): bool:
    t := str.Trim(s)
    n := t.len()
    if n == 0: ret false end
    mut i := 0
    if _is_sign(t.substr(0, 1)):
        i = 1
        if n == 1: ret false end
    end
    until i < n:
        if _is_digit(t.substr(i, 1)) == false: ret false end
        i += 1
    end
    ret true
end

@en "IsFloat"
@fa "اعشاری است"
@ar "هل عشري"
pub func IsFloat(s: str): bool:
    t := str.Trim(s)
    n := t.len()
    if n == 0 || IsInt(t): ret false end
    mut i := 0
    mut seen_digit := false
    mut seen_dot := false
    mut seen_e := false
    if _is_sign(t.substr(0, 1)): i = 1 end
    until i < n:
        c := t.substr(i, 1)
        if _is_digit(c):
            seen_digit = true
            i += 1
        else:
            if c == "." && seen_dot == false && seen_e == false:
                seen_dot = true
                i += 1
            else:
                if (c == "e" || c == "E") && seen_e == false && seen_digit:
                    seen_e = true
                    i += 1
                    if i < n && _is_sign(t.substr(i, 1)): i += 1 end
                else:
                    ret false
                end
            end
        end
    end
    ret seen_digit && (seen_dot || seen_e)
end

@en "IsNumeric"
@fa "عددی است"
@ar "هل رقمي"
pub func IsNumeric(s: str): bool: ret IsInt(s) || IsFloat(s) end

@en "IsBool"
@fa "منطقی است"
@ar "هل منطقی"
pub func IsBool(s: str): bool:
    t := str.Lower(str.Trim(s))
    ret t == "true" || t == "false"
end

@en "KindOf"
@fa "نوعِ"
@ar "نوعِ"
pub func KindOf(s: str): int:
    if s.len() == 0: ret TypeKindNull end
    if IsBool(s): ret TypeKindBool end
    if IsInt(s): ret TypeKindInt end
    if IsFloat(s): ret TypeKindFloat end
    ret TypeKindStr
end

@en "KindName"
@fa "نام نوع"
@ar "اسم النوع"
pub func KindName(k: int): str:
    if k == TypeKindNull: ret "null"
    else k == TypeKindBool: ret "bool"
    else k == TypeKindInt: ret "int"
    else k == TypeKindFloat: ret "float"
    else: ret "string"
    end
end

// Equal deep-compares two vectors of the same element type: same length and
// every element == (element-wise). T must be a directly comparable type
// (str/int/i64/f64/bool) - Vector<Vector<T>> is out of scope, matching the
// rest of this stdlib's avoidance of nested-generic Vector instantiations.
@en "Equal"
@fa "برابر"
@ar "متساوٍ"
pub func Equal<T>(a: Vector<T>, b: Vector<T>): bool:
    if a.len() != b.len(): ret false end
    repeat a.len() with i:
        if a.get(i)[0] != b.get(i)[0]: ret false end
    end
    ret true
end
