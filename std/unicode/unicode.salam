@en "unicode"
@fa "یونیکد"
package unicode

pub const ZWNJ := 0x200C

pub const ZWJ := 0x200D

pub const MaxCodePoint := 0x10FFFF

const _ASCII_MAX := 0x7F

pub const HangulSBase := 0xAC00
pub const HangulLBase := 0x1100
pub const HangulVBase := 0x1161
pub const HangulTBase := 0x11A7
pub const HangulLCount := 19
pub const HangulVCount := 21
pub const HangulTCount := 28
pub const HangulNCount := 588
pub const HangulSCount := 11172

pure func _floor_index(keys: int[:], cp: int): int:
    mut lo := 0
    mut hi := keys.len() - 1
    mut found := -1
    until lo <= hi:
        mid := lo + (hi - lo) / 2
        if keys[mid] <= cp:
            found = mid
            lo = mid + 1
        else:
            hi = mid - 1
        end
    end
    ret found
end

pure func _in_ranges(los: int[:], his: int[:], cp: int): bool:
    i := _floor_index(los, cp)
    if i < 0: ret false end
    ret cp <= his[i]
end

pure func _case_map(los: int[:], his: int[:], strides: int[:], deltas: int[:], cp: int): int:
    i := _floor_index(los, cp)
    if i < 0: ret cp end
    if cp > his[i]: ret cp end
    if (cp - los[i]) % strides[i] != 0: ret cp end
    ret cp + deltas[i]
end

pure func _keyed_index(keys: int[:], cp: int): int:
    i := _floor_index(keys, cp)
    if i < 0: ret -1 end
    if keys[i] != cp: ret -1 end
    ret i
end

pure func _fold_full_index(cp: int): int:
    if cp <= _ASCII_MAX: ret -1 end
    ret _keyed_index(_FOLDF_CP[:], cp)
end

@en "Category"
@fa "دسته"
pub pure func Category(cp: int): int:
    if cp < 0 || cp > MaxCodePoint: ret CatCn end
    i := _floor_index(_CAT_LO[:], cp)
    if i < 0: ret CatCn end
    if cp > _CAT_HI[i]: ret CatCn end
    ret _CAT_ID[i]
end

@en "CategoryName"
@fa "نام دسته"
pub pure func CategoryName(cp: int): str:
    ret _CAT_NAMES[Category(cp)]
end

@en "IsAssigned"
@fa "تخصیص یافته است"
pub pure func IsAssigned(cp: int): bool:
    ret Category(cp) != CatCn
end

@en "IsLetter"
@fa "حرف است"
pub pure func IsLetter(cp: int): bool:
    c := Category(cp)
    ret c >= CatLu && c <= CatLo
end

@en "IsAlphabetic"
@fa "الفبایی است"
pub pure func IsAlphabetic(cp: int): bool:
    if cp < 0 || cp > MaxCodePoint: ret false end
    ret _in_ranges(_ALPHA_LO[:], _ALPHA_HI[:], cp)
end

@en "IsUpper"
@fa "بزرگ است"
pub pure func IsUpper(cp: int): bool:
    ret Category(cp) == CatLu
end

@en "IsLower"
@fa "کوچک است"
pub pure func IsLower(cp: int): bool:
    ret Category(cp) == CatLl
end

@en "IsTitle"
@fa "عنوانی است"
pub pure func IsTitle(cp: int): bool:
    ret Category(cp) == CatLt
end

@en "IsMark"
@fa "نشانه است"
pub pure func IsMark(cp: int): bool:
    c := Category(cp)
    ret c >= CatMn && c <= CatMe
end

@en "IsDigit"
@fa "رقم است"
pub pure func IsDigit(cp: int): bool:
    ret Category(cp) == CatNd
end

@en "IsNumber"
@fa "عدد است"
pub pure func IsNumber(cp: int): bool:
    c := Category(cp)
    ret c >= CatNd && c <= CatNo
end

@en "IsAlnum"
@fa "حرف یا رقم است"
pub pure func IsAlnum(cp: int): bool:
    ret IsAlphabetic(cp) || IsDigit(cp)
end

@en "IsPunct"
@fa "نشانه نگارشی است"
pub pure func IsPunct(cp: int): bool:
    c := Category(cp)
    ret c >= CatPc && c <= CatPo
end

@en "IsSymbol"
@fa "نماد است"
pub pure func IsSymbol(cp: int): bool:
    c := Category(cp)
    ret c >= CatSm && c <= CatSo
end

@en "IsSpace"
@fa "فاصله است"
pub pure func IsSpace(cp: int): bool:
    if cp < 0 || cp > MaxCodePoint: ret false end
    ret _in_ranges(_WS_LO[:], _WS_HI[:], cp)
end

@en "IsControl"
@fa "کنترلی است"
pub pure func IsControl(cp: int): bool:
    ret Category(cp) == CatCc
end

@en "IsFormat"
@fa "قالبی است"
pub pure func IsFormat(cp: int): bool:
    ret Category(cp) == CatCf
end

@en "IsJoinControl"
@fa "کنترل اتصال است"
pub inline pure func IsJoinControl(cp: int): bool:
    ret cp == ZWNJ || cp == ZWJ
end

@en "ToUpper"
@fa "به بزرگ"
pub pure func ToUpper(cp: int): int:
    if cp >= 0x61 && cp <= 0x7A: ret cp - 32 end
    if cp <= _ASCII_MAX: ret cp end
    ret _case_map(_UP_LO[:], _UP_HI[:], _UP_STRIDE[:], _UP_DELTA[:], cp)
end

@en "ToLower"
@fa "به کوچک"
pub pure func ToLower(cp: int): int:
    if cp >= 0x41 && cp <= 0x5A: ret cp + 32 end
    if cp <= _ASCII_MAX: ret cp end
    ret _case_map(_LOW_LO[:], _LOW_HI[:], _LOW_STRIDE[:], _LOW_DELTA[:], cp)
end

@en "ToTitle"
@fa "به عنوانی"
pub pure func ToTitle(cp: int): int:
    if cp >= 0x61 && cp <= 0x7A: ret cp - 32 end
    if cp <= _ASCII_MAX: ret cp end
    ret _case_map(_TITLE_LO[:], _TITLE_HI[:], _TITLE_STRIDE[:], _TITLE_DELTA[:], cp)
end

@en "ToFold"
@fa "به تاشده"
pub pure func ToFold(cp: int): int:
    if cp >= 0x41 && cp <= 0x5A: ret cp + 32 end
    if cp <= _ASCII_MAX: ret cp end
    ret _case_map(_FOLD_LO[:], _FOLD_HI[:], _FOLD_STRIDE[:], _FOLD_DELTA[:], cp)
end

@en "HasFullFold"
@fa "تاشدن بلند دارد"
pub pure func HasFullFold(cp: int): bool:
    ret _fold_full_index(cp) >= 0
end

@en "FullFoldLen"
@fa "طول تاشدن بلند"
pub pure func FullFoldLen(cp: int): int:
    i := _fold_full_index(cp)
    if i < 0: ret 1 end
    ret _FOLDF_LEN[i]
end

@en "FullFoldAt"
@fa "تاشدن بلند در"
pub pure func FullFoldAt(cp: int, k: int): int:
    i := _fold_full_index(cp)
    if i < 0: ret ToFold(cp) end
    if k < 0 || k >= _FOLDF_LEN[i]: ret ToFold(cp) end
    ret _FOLDF_SEQ[_FOLDF_OFF[i] + k]
end

@en "CombiningClass"
@fa "رده ترکیبی"
pub pure func CombiningClass(cp: int): int:
    i := _floor_index(_CCC_LO[:], cp)
    if i < 0: ret 0 end
    if cp > _CCC_HI[i]: ret 0 end
    ret _CCC_VAL[i]
end

@en "DecompLen"
@fa "طول تجزیه"
pub pure func DecompLen(cp: int): int:
    if cp >= HangulSBase && cp < HangulSBase + HangulSCount:
        if (cp - HangulSBase) % HangulTCount == 0: ret 2 end
        ret 3
    end
    i := _keyed_index(_NFD_CP[:], cp)
    if i < 0: ret 1 end
    ret _NFD_LEN[i]
end

@en "DecompAt"
@fa "تجزیه در"
pub pure func DecompAt(cp: int, k: int): int:
    if cp >= HangulSBase && cp < HangulSBase + HangulSCount:
        sidx := cp - HangulSBase
        if k == 0: ret HangulLBase + sidx / HangulNCount end
        if k == 1: ret HangulVBase + (sidx % HangulNCount) / HangulTCount end
        if k == 2 && sidx % HangulTCount != 0: ret HangulTBase + sidx % HangulTCount end
        ret cp
    end
    i := _keyed_index(_NFD_CP[:], cp)
    if i < 0: ret cp end
    if k < 0 || k >= _NFD_LEN[i]: ret cp end
    ret _NFD_SEQ[_NFD_OFF[i] + k]
end

@en "CompatDecompLen"
@fa "طول تجزیه سازگاری"
pub pure func CompatDecompLen(cp: int): int:
    if cp >= HangulSBase && cp < HangulSBase + HangulSCount:
        ret DecompLen(cp)
    end
    i := _keyed_index(_NFKD_CP[:], cp)
    if i < 0: ret 1 end
    ret _NFKD_LEN[i]
end

@en "CompatDecompAt"
@fa "تجزیه سازگاری در"
pub pure func CompatDecompAt(cp: int, k: int): int:
    if cp >= HangulSBase && cp < HangulSBase + HangulSCount:
        ret DecompAt(cp, k)
    end
    i := _keyed_index(_NFKD_CP[:], cp)
    if i < 0: ret cp end
    if k < 0 || k >= _NFKD_LEN[i]: ret cp end
    ret _NFKD_SEQ[_NFKD_OFF[i] + k]
end

@en "Compose"
@fa "ترکیب"
pub pure func Compose(a: int, b: int): int:
    lidx := a - HangulLBase
    if lidx >= 0 && lidx < HangulLCount:
        vidx := b - HangulVBase
        if vidx >= 0 && vidx < HangulVCount:
            ret HangulSBase + (lidx * HangulVCount + vidx) * HangulTCount
        end
    end
    sidx := a - HangulSBase
    if sidx >= 0 && sidx < HangulSCount && sidx % HangulTCount == 0:
        tidx := b - HangulTBase
        if tidx > 0 && tidx < HangulTCount: ret a + tidx end
    end
    mut i := _floor_index(_COMP_A[:], a)
    if i < 0: ret 0 - 1 end
    if _COMP_A[i] != a: ret 0 - 1 end
    until i >= 0 && _COMP_A[i] == a:
        if _COMP_B[i] == b: ret _COMP_CP[i] end
        i -= 1
    end
    ret 0 - 1
end

@en "GraphemeBreak"
@fa "شکست خوشه"
pub pure func GraphemeBreak(cp: int): int:
    if cp >= HangulSBase && cp < HangulSBase + HangulSCount:
        if (cp - HangulSBase) % HangulTCount == 0: ret GcbLV end
        ret GcbLVT
    end
    i := _floor_index(_GCB_LO[:], cp)
    if i < 0: ret GcbOther end
    if cp > _GCB_HI[i]: ret GcbOther end
    ret _GCB_ID[i]
end

@en "ConjunctBreak"
@fa "شکست پیوند"
pub pure func ConjunctBreak(cp: int): int:
    i := _floor_index(_INCB_LO[:], cp)
    if i < 0: ret IncbNone end
    if cp > _INCB_HI[i]: ret IncbNone end
    ret _INCB_ID[i]
end

@en "BidiClass"
@fa "رده دوسویه"
pub pure func BidiClass(cp: int): int:
    i := _floor_index(_BIDI_LO[:], cp)
    if i < 0: ret BcL end
    if cp > _BIDI_HI[i]: ret BcL end
    ret _BIDI_ID[i]
end

@en "PairedBracketType"
@fa "گونه کروشه جفت"
pub pure func PairedBracketType(cp: int): int:
    i := _keyed_index(_BRACKET_CP[:], cp)
    if i < 0: ret PbtNone end
    ret _BRACKET_TYPE[i]
end

@en "PairedBracket"
@fa "کروشه جفت"
pub pure func PairedBracket(cp: int): int:
    i := _keyed_index(_BRACKET_CP[:], cp)
    if i < 0: ret cp end
    ret _BRACKET_PAIR[i]
end

@en "Script"
@fa "خط"
pub pure func Script(cp: int): int:
    i := _floor_index(_SCRIPT_LO[:], cp)
    if i < 0: ret ScriptUnknown end
    if cp > _SCRIPT_HI[i]: ret ScriptUnknown end
    ret _SCRIPT_ID[i]
end

@en "ScriptName"
@fa "نام خط"
pub pure func ScriptName(cp: int): str:
    ret _SCRIPT_NAMES[Script(cp)]
end
