// VS Code extension host API interop for the `salam js` backend. Same
// two-layer design as std/dom / std/node: curated wrappers for the pieces
// a typical language-support extension needs (output channel, terminal,
// configuration, commands, editor/document access, message boxes, the
// document formatting provider, TextEdit/Range), plus a generic
// GetProp/SetProp/Call/New/Invoke escape hatch for anything not wrapped.
// `require("vscode")` is what the extension host injects at load time;
// it behaves exactly like any other Node module from Salam's side.

package vscode

extern:
    func require(id: str): i64
    func salam_js_get_prop(obj: i64, name: str): i64
    func salam_js_get_num(obj: i64, name: str): f64
    func salam_js_get_str(obj: i64, name: str): str
    func salam_js_get_bool(obj: i64, name: str): bool
    func salam_js_set_prop(obj: i64, name: str, ...)
    func salam_js_call(obj: i64, method: str, ...): i64
    func salam_js_new(ctor: i64, ...): i64
    func salam_js_invoke(fn: i64, ...): i64
    func salam_js_is_nullish(x: i64): bool
    func salam_js_array0(): i64
    func salam_js_obj0(): i64
    func salam_js_new_promise(executor: func (i64, i64)): i64
    func salam_js_to_str(x: i64): str
    func salam_js_to_bool(x: i64): bool
end

vsc := require("vscode")

struct DocSelector:
    pub language: str
    pub scheme: str
end

func js_to_str(x: i64): str: ret salam_js_to_str(x) end

func vsc_ns(name: str): i64: ret salam_js_get_prop(vsc, name) end

// ---- generic property / call / construct escape hatch --------------------

@fa "دریافت خاصیت"
@ar "جلب الخاصیة"
pub func GetProp(obj: i64, name: str): i64: ret salam_js_get_prop(obj, name) end

@fa "دریافت خاصیت رشته ای"
@ar "جلب الخاصیة النصیة"
pub func GetStr(obj: i64, name: str): str: ret salam_js_get_str(obj, name) end

@fa "دریافت خاصیت عددی"
@ar "جلب الخاصیة العددیة"
pub func GetNum(obj: i64, name: str): f64: ret salam_js_get_num(obj, name) end

@fa "دریافت خاصیت منطقی"
@ar "جلب الخاصیة المنطقیة"
pub func GetBool(obj: i64, name: str): bool: ret salam_js_get_bool(obj, name) end

@fa "تنظیم خاصیت"
@ar "تعیین الخاصیة"
pub func SetProp(obj: i64, name: str, value: i64): salam_js_set_prop(obj, name, value) end

@fa "فراخوانی رشته یک"
@ar "استدعاء نصي واحد"
pub func CallS1(obj: i64, method: str, a: str): i64: ret salam_js_call(obj, method, a) end

@fa "فراخوانی مقدار"
@ar "استدعاء بقيمة"
pub func CallV1(obj: i64, method: str, a: i64): i64: ret salam_js_call(obj, method, a) end

@fa "پوچ یا نامعین است"
@ar "فارغ أو غير معرف"
pub func IsNullish(x: i64): bool: ret salam_js_is_nullish(x) end

@fa "آرایه تازه"
@ar "مصفوفة جديدة"
pub func NewArray(): i64: ret salam_js_array0() end

@fa "افزودن به آرایه"
@ar "إضافة إلى المصفوفة"
pub func Push(arr: i64, value: i64): salam_js_call(arr, "push", value) end

@fa "افزودن رشته به آرایه"
@ar "إضافة نص إلى المصفوفة"
pub func PushStr(arr: i64, value: str): salam_js_call(arr, "push", value) end

@fa "پیوست کردن قابل حذف"
@ar "إلحاق قابل للتصرف"
pub func ContextSubscriptionsPush(ctx: i64, disposable: i64):
    subs := salam_js_get_prop(ctx, "subscriptions")
    salam_js_call(subs, "push", disposable)
end

@fa "دور انداختن"
@ar "التخلص"
pub func Dispose(h: i64): salam_js_call(h, "dispose") end

@fa "پیوست کردن سپس"
@ar "إلحاق ثم"
pub func Then1(promise: i64, onFulfilled: func (i64)): salam_js_call(promise, "then", onFulfilled) end

@fa "تبدیل به رشته"
@ar "تحويل إلى نص"
pub func ToStr(x: i64): str: ret salam_js_to_str(x) end

@fa "پوچ یا نامعین نیست"
@ar "ليس فارغًا أو غير معرف"
pub func IsPresent(x: i64): bool: ret !salam_js_is_nullish(x) end

// ---- output channel / terminal --------------------------------------------

@fa "ساخت کانال خروجی"
@ar "إنشاء قناة الإخراج"
pub func CreateOutputChannel(name: str): i64:
    win := vsc_ns("window")
    ret salam_js_call(win, "createOutputChannel", name)
end

@fa "افزودن خط"
@ar "إضافة سطر"
pub func AppendLine(ch: i64, text: str): salam_js_call(ch, "appendLine", text) end

@fa "نمایش کانال"
@ar "عرض القناة"
pub func ShowOutputChannel(ch: i64): salam_js_call(ch, "show", true) end

@fa "ساخت پایانه"
@ar "إنشاء الطرفية"
pub func CreateTerminal(name: str): i64:
    win := vsc_ns("window")
    ret salam_js_call(win, "createTerminal", name)
end

@fa "نمایش پایانه"
@ar "عرض الطرفية"
pub func ShowTerminal(term: i64): salam_js_call(term, "show", true) end

@fa "ارسال متن"
@ar "إرسال النص"
pub func SendText(term: i64, text: str): salam_js_call(term, "sendText", text) end

@fa "پایانه پایان یافته"
@ar "انتهت الطرفية"
pub func TerminalHasExited(term: i64): bool: ret !salam_js_is_nullish(salam_js_get_prop(term, "exitStatus")) end

@fa "هنگام بستن پایانه"
@ar "عند إغلاق الطرفية"
pub func OnDidCloseTerminal(cb: func (i64)): i64:
    win := vsc_ns("window")
    ret salam_js_call(win, "onDidCloseTerminal", cb)
end

// ---- configuration ---------------------------------------------------

@fa "پیکربندی"
@ar "التكوين"
pub func GetConfiguration(section: str): i64:
    ws := vsc_ns("workspace")
    ret salam_js_call(ws, "getConfiguration", section)
end

@fa "پیکربندی رشته"
@ar "تكوين نصي"
pub func ConfigGetStr(cfg: i64, key: str, def: str): str: ret js_to_str(salam_js_call(cfg, "get", key, def)) end

@fa "پیکربندی منطقی"
@ar "تكوين منطقي"
pub func ConfigGetBool(cfg: i64, key: str, def: bool): bool: ret salam_js_to_bool(salam_js_call(cfg, "get", key, def)) end

// ---- commands --------------------------------------------------------

@fa "ثبت فرمان"
@ar "تسجيل الأمر"
pub func RegisterCommand(id: str, cb: func ()): i64:
    cmds := vsc_ns("commands")
    ret salam_js_call(cmds, "registerCommand", id, cb)
end

@fa "اجرای فرمان"
@ar "تنفيذ الأمر"
pub func ExecuteCommand0(id: str): i64:
    cmds := vsc_ns("commands")
    ret salam_js_call(cmds, "executeCommand", id)
end

@fa "اجرای فرمان با رشته"
@ar "تنفيذ الأمر بنص"
pub func ExecuteCommandS1(id: str, arg: str): i64:
    cmds := vsc_ns("commands")
    ret salam_js_call(cmds, "executeCommand", id, arg)
end

// ---- window / editor / document ---------------------------------------

@fa "ویرایشگر فعال"
@ar "المحرر النشط"
pub func ActiveTextEditor(): i64:
    win := vsc_ns("window")
    ret salam_js_get_prop(win, "activeTextEditor")
end

@fa "سند ویرایشگر"
@ar "مستند المحرر"
pub func EditorDocument(editor: i64): i64: ret salam_js_get_prop(editor, "document") end

@fa "متن سند"
@ar "نص المستند"
pub func DocumentGetText(doc: i64): str: ret js_to_str(salam_js_call(doc, "getText")) end

@fa "شناسه زبان سند"
@ar "معرف لغة المستند"
pub func DocumentLanguageId(doc: i64): str: ret salam_js_get_str(doc, "languageId") end

@fa "سند کثیف است"
@ar "المستند متسخ"
pub func DocumentIsDirty(doc: i64): bool: ret salam_js_get_bool(doc, "isDirty") end

@fa "ذخیره سند"
@ar "حفظ المستند"
pub func DocumentSave(doc: i64): i64: ret salam_js_call(doc, "save") end

@fa "مسیر فایل سند"
@ar "مسار ملف المستند"
pub func DocumentUriFsPath(doc: i64): str:
    uri := salam_js_get_prop(doc, "uri")
    ret salam_js_get_str(uri, "fsPath")
end

@fa "تعداد خط سند"
@ar "عدد أسطر المستند"
pub func DocumentLineCount(doc: i64): i64: ret salam_js_get_num(doc, "lineCount") as i64 end

@fa "خط سند در"
@ar "سطر المستند عند"
pub func DocumentLineAt(doc: i64, n: i64): i64: ret salam_js_call(doc, "lineAt", n) end

@fa "متن خط"
@ar "نص السطر"
pub func LineText(line: i64): str: ret salam_js_get_str(line, "text") end

// ---- messages ----------------------------------------------------------

@fa "نمایش پیام هشدار"
@ar "عرض رسالة تحذير"
pub func ShowWarningMessage(msg: str): i64:
    win := vsc_ns("window")
    ret salam_js_call(win, "showWarningMessage", msg)
end

@fa "نمایش پیام خطا"
@ar "عرض رسالة خطأ"
pub func ShowErrorMessage(msg: str): i64:
    win := vsc_ns("window")
    ret salam_js_call(win, "showErrorMessage", msg)
end

@fa "نمایش پیام خطا با کنش"
@ar "عرض رسالة خطأ بإجراء"
pub func ShowErrorMessageAction(msg: str, action: str): i64:
    win := vsc_ns("window")
    ret salam_js_call(win, "showErrorMessage", msg, action)
end

@fa "اجرای فرمان تنظیمات"
@ar "تنفيذ أمر الإعدادات"
pub func OpenSettings(settingId: str):
    cmds := vsc_ns("commands")
    salam_js_call(cmds, "executeCommand", "workbench.action.openSettings", settingId)
end

// ---- formatting provider / TextEdit / Range ------------------------------

@fa "ثبت ارائه‌دهنده قالب‌بندی سند"
@ar "تسجيل مزود تنسيق المستند"
pub func RegisterDocumentFormattingEditProvider(languageId: str, provideFn: func (i64) i64): i64:
    langs := vsc_ns("languages")
    selector := DocSelector { language = languageId, scheme = "file" }
    provider := salam_js_obj0()
    salam_js_set_prop(provider, "provideDocumentFormattingEdits", (doc: i64, _opts: i64, _tok: i64): ret provideFn(doc) end)
    ret salam_js_call(langs, "registerDocumentFormattingEditProvider", selector, provider)
end

@fa "بازه تازه"
@ar "نطاق جديد"
pub func NewRange(startLine: i64, startChar: i64, endLine: i64, endChar: i64): i64:
    rangeCtor := salam_js_get_prop(vsc, "Range")
    ret salam_js_new(rangeCtor, startLine, startChar, endLine, endChar)
end

@fa "جایگزینی ویرایش متن"
@ar "استبدال تحرير النص"
pub func TextEditReplace(range: i64, newText: str): i64:
    textEditCls := salam_js_get_prop(vsc, "TextEdit")
    ret salam_js_call(textEditCls, "replace", range, newText)
end

@fa "سند متنی باز کن"
@ar "افتح مستند نصي"
pub func OpenTextDocumentContent(content: str, language: str): i64:
    ws := vsc_ns("workspace")
    opts := salam_js_obj0()
    salam_js_set_prop(opts, "content", content)
    salam_js_set_prop(opts, "language", language)
    ret salam_js_call(ws, "openTextDocument", opts)
end

@fa "نمایش سند متنی"
@ar "عرض المستند النصي"
pub func ShowTextDocumentPreview(doc: i64): i64:
    win := vsc_ns("window")
    opts := salam_js_obj0()
    salam_js_set_prop(opts, "preview", true)
    ret salam_js_call(win, "showTextDocument", doc, opts)
end

// ---- input box / quick pick ---------------------------------------------

@fa "جعبه ورودی نمایش بده"
@ar "عرض صندوق الإدخال"
pub func ShowInputBox(prompt: str, placeHolder: str): i64:
    win := vsc_ns("window")
    opts := salam_js_obj0()
    salam_js_set_prop(opts, "prompt", prompt)
    salam_js_set_prop(opts, "placeHolder", placeHolder)
    ret salam_js_call(win, "showInputBox", opts)
end

@fa "انتخاب سریع نمایش بده"
@ar "عرض الاختيار السريع"
pub func ShowQuickPick(items: i64, placeHolder: str): i64:
    win := vsc_ns("window")
    opts := salam_js_obj0()
    salam_js_set_prop(opts, "placeHolder", placeHolder)
    ret salam_js_call(win, "showQuickPick", items, opts)
end
