@en "browser"
@fa "مرورگر"
package browser

if SALAM_JS:
    extern:
        func salam_js_request(
            method: str,
            url: str,
            body: str,
            content_type: str,
            timeout_ms: int,
            done: func (int, str)
        )
        func salam_js_copy_text(text: str)
        func salam_js_copy_text_then(text: str, done: func (bool))
        func salam_js_query_param(name: str): str
    end

    func _request(
        method: str, url: str, body: str, content_type: str, timeout_ms: int, done: func (int, str)
    ):
        salam_js_request(method, url, body, content_type, timeout_ms, done)
    end

    func _copy(text: str):
        salam_js_copy_text(text)
    end

    func _copy_then(text: str, done: func (bool)):
        salam_js_copy_text_then(text, done)
    end

    func _query_param(name: str): str:
        ret salam_js_query_param(name)
    end
else:
    import str
    import net.http
    import gui.clipboard

    func _request(
        method: str, url: str, body: str, content_type: str, timeout_ms: int, done: func (int, str)
    ):
        headers := HashMap {} as HashMap<str, str>
        mut verb := "GET"
        if method.Len() > 0:
            verb = str.Upper(method)
        end
        sends := body.Len() > 0 and verb != "GET" and verb != "HEAD"
        if sends and content_type.Len() > 0:
            headers.Put("Content-Type", content_type)
        end
        mut options := http.RequestOptions { max_redirects = 20 }
        if timeout_ms > 0:
            options.timeout_ms = timeout_ms
            options.idle_ms = timeout_ms
        end
        reply := http.Do(verb, url, headers, sends ? body : "", options)
        headers.Free()
        if reply.err.Len() > 0:
            done(0, "")
            ret
        end
        done(reply.status, reply.body)
    end

    func _copy(text: str):
        clipboard.SetText(text)
    end

    func _copy_then(text: str, done: func (bool)):
        done(clipboard.SetText(text))
    end

    func _query_param(name: str): str:
        _n := name.Len()
        ret ""
    end
end

@en "Request"
@fa "درخواست"
pub func Request(
    method: str, url: str, body: str, content_type: str, timeout_ms: int, done: func (int, str)
):
    _request(method, url, body, content_type, timeout_ms, done)
end

@en "Get"
@fa "دریافت"
pub func Get(url: str, timeout_ms: int, done: func (int, str)):
    _request("GET", url, "", "", timeout_ms, done)
end

@en "PostJson"
@fa "ارسال جیسون"
pub func PostJson(url: str, body: str, timeout_ms: int, done: func (int, str)):
    _request("POST", url, body, "application/json", timeout_ms, done)
end

@en "CopyText"
@fa "کپی متن"
pub func CopyText(text: str):
    _copy(text)
end

@en "CopyText"
@fa "کپی متن"
pub func CopyText(text: str, done: func (bool)):
    _copy_then(text, done)
end

@en "QueryParam"
@fa "پارامتر نشانی"
pub func QueryParam(name: str): str:
    ret _query_param(name)
end
