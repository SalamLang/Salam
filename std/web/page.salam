package web

import str

mut g_web_color_names := HashMap {} as HashMap<str, int>
mut g_web_color_rgb := HashMap {} as HashMap<int, str>
mut g_web_colors_ready := false

@en "Url"
@fa "نشانی وب"
pub struct Url:
    value: str = ""

    @en "Set"
    @fa "تنظیم"
    pub func Set(s: str): bool:
        if not _w_url_ok(s):
            ret false
        end
        this.value = s
        ret true
    end

    @en "set"
    @fa "تنظیم"
    pub func set(s: str): bool:
        ret this.Set(s)
    end

    @en "Text"
    @fa "متن"
    pub pure func Text(): str:
        ret this.value
    end

    @en "text"
    @fa "متن"
    pub pure func text(): str:
        ret this.Text()
    end
end

@en "Color"
@fa "رنگ وب"
pub struct Color:
    value: str = ""

    @en "Set"
    @fa "تنظیم"
    pub func Set(s: str): bool:
        if not _w_color_ok(s):
            ret false
        end
        this.value = s
        ret true
    end

    @en "set"
    @fa "تنظیم"
    pub func set(s: str): bool:
        ret this.Set(s)
    end

    @en "Text"
    @fa "متن"
    pub pure func Text(): str:
        ret this.value
    end

    @en "text"
    @fa "متن"
    pub pure func text(): str:
        ret this.Text()
    end
end

@en "Length"
@fa "اندازه وب"
pub struct Length:
    value: str = ""

    @en "Set"
    @fa "تنظیم"
    pub func Set(s: str): bool:
        if not _w_length_ok(s):
            ret false
        end
        this.value = s
        ret true
    end

    @en "set"
    @fa "تنظیم"
    pub func set(s: str): bool:
        ret this.Set(s)
    end

    @en "Text"
    @fa "متن"
    pub pure func Text(): str:
        ret this.value
    end

    @en "text"
    @fa "متن"
    pub pure func text(): str:
        ret this.Text()
    end
end

inline pure func _wb(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0: v += 256 end
    ret v
end

pure func _w_lower(c: int): int:
    if c >= 65 and c <= 90:
        ret c + 32
    end
    ret c
end

pure func _w_scheme_len(s: str): int:
    n := s.Len()
    if n == 0:
        ret 0
    end
    b0 := _w_lower(_wb(s, 0))
    if b0 < 97 or b0 > 122:
        ret 0
    end
    mut i := 1
    until i < n:
        b := _w_lower(_wb(s, i))
        if b == 58:
            ret i
        end
        ok := (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 46
        if not ok:
            ret 0
        end
        i++
    end
    ret 0
end

pure func _w_prefix_ci(s: str, p: str): bool:
    if s.Len() < p.Len():
        ret false
    end
    repeat p.Len() in i:
        if _w_lower(_wb(s, i)) != _wb(p, i):
            ret false
        end
    end
    ret true
end

pure func _w_url_ok(s: str): bool:
    n := s.Len()
    if n == 0 or n > 8192:
        ret false
    end
    repeat n in i:
        b := _wb(s, i)
        if b < 33 or b == 127 or b == 34 or b == 39 or b == 60 or b == 62 or b == 92 or b == 96:
            ret false
        end
    end
    sl := _w_scheme_len(s)
    if sl == 0:
        ret true
    end
    ret _w_prefix_ci(s, "http://") or _w_prefix_ci(s, "https://") or _w_prefix_ci(s, "mailto:") or _w_prefix_ci(s, "tel:")
end

pure func _w_hex(b: int): bool:
    ret (b >= 48 and b <= 57) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)
end

pure func _w_word(s: str): bool:
    if s.Len() == 0 or s.Len() > 32:
        ret false
    end
    repeat s.Len() in i:
        b := _w_lower(_wb(s, i))
        if b < 97 or b > 122:
            ret false
        end
    end
    ret true
end

pure func _w_hexdig(b: int): int:
    if b >= 48 and b <= 57:
        ret b - 48
    end
    if b >= 97 and b <= 102:
        ret b - 87
    end
    if b >= 65 and b <= 70:
        ret b - 55
    end
    ret 0
end

pure func _w_hexint(s: str): int:
    n := s.Len()
    mut v := 0
    mut i := 2
    until i < n:
        v = v * 16 + _w_hexdig(_wb(s, i))
        i++
    end
    ret v
end

func _w_init_colors():
    if g_web_colors_ready:
        ret
    end
    g_web_colors_ready = true
    table := "aliceblue 0xf0f8ff antiquewhite 0xfaebd7 aqua 0x00ffff aquamarine 0x7fffd4 azure 0xf0ffff beige 0xf5f5dc bisque 0xffe4c4 black 0x000000 blanchedalmond 0xffebcd blue 0x0000ff blueviolet 0x8a2be2 brown 0xa52a2a burlywood 0xdeb887 cadetblue 0x5f9ea0 chartreuse 0x7fff00 chocolate 0xd2691e coral 0xff7f50 cornflowerblue 0x6495ed cornsilk 0xfff8dc crimson 0xdc143c cyan 0x00ffff darkblue 0x00008b darkcyan 0x008b8b darkgoldenrod 0xb8860b darkgray 0xa9a9a9 darkgreen 0x006400 darkgrey 0xa9a9a9 darkkhaki 0xbdb76b darkmagenta 0x8b008b darkolivegreen 0x556b2f darkorange 0xff8c00 darkorchid 0x9932cc darkred 0x8b0000 darksalmon 0xe9967a darkseagreen 0x8fbc8f darkslateblue 0x483d8b darkslategray 0x2f4f4f darkslategrey 0x2f4f4f darkturquoise 0x00ced1 darkviolet 0x9400d3 deeppink 0xff1493 deepskyblue 0x00bfff dimgray 0x696969 dimgrey 0x696969 dodgerblue 0x1e90ff firebrick 0xb22222 floralwhite 0xfffaf0 forestgreen 0x228b22 fuchsia 0xff00ff gainsboro 0xdcdcdc ghostwhite 0xf8f8ff gold 0xffd700 goldenrod 0xdaa520 gray 0x808080 green 0x008000 greenyellow 0xadff2f grey 0x808080 honeydew 0xf0fff0 hotpink 0xff69b4 indianred 0xcd5c5c indigo 0x4b0082 ivory 0xfffff0 khaki 0xf0e68c lavender 0xe6e6fa lavenderblush 0xfff0f5 lawngreen 0x7cfc00 lemonchiffon 0xfffacd lightblue 0xadd8e6 lightcoral 0xf08080 lightcyan 0xe0ffff lightgoldenrodyellow 0xfafad2 lightgray 0xd3d3d3 lightgreen 0x90ee90 lightgrey 0xd3d3d3 lightpink 0xffb6c1 lightsalmon 0xffa07a lightseagreen 0x20b2aa lightskyblue 0x87cefa lightslategray 0x778899 lightslategrey 0x778899 lightsteelblue 0xb0c4de lightyellow 0xffffe0 lime 0x00ff00 limegreen 0x32cd32 linen 0xfaf0e6 magenta 0xff00ff maroon 0x800000 mediumaquamarine 0x66cdaa mediumblue 0x0000cd mediumorchid 0xba55d3 mediumpurple 0x9370db mediumseagreen 0x3cb371 mediumslateblue 0x7b68ee mediumspringgreen 0x00fa9a mediumturquoise 0x48d1cc mediumvioletred 0xc71585 midnightblue 0x191970 mintcream 0xf5fffa mistyrose 0xffe4e1 moccasin 0xffe4b5 navajowhite 0xffdead navy 0x000080 oldlace 0xfdf5e6 olive 0x808000 olivedrab 0x6b8e23 orange 0xffa500 orangered 0xff4500 orchid 0xda70d6 palegoldenrod 0xeee8aa palegreen 0x98fb98 paleturquoise 0xafeeee palevioletred 0xdb7093 papayawhip 0xffefd5 peachpuff 0xffdab9 peru 0xcd853f pink 0xffc0cb plum 0xdda0dd powderblue 0xb0e0e6 purple 0x800080 rebeccapurple 0x663399 red 0xff0000 rosybrown 0xbc8f8f royalblue 0x4169e1 saddlebrown 0x8b4513 salmon 0xfa8072 sandybrown 0xf4a460 seagreen 0x2e8b57 seashell 0xfff5ee sienna 0xa0522d silver 0xc0c0c0 skyblue 0x87ceeb slateblue 0x6a5acd slategray 0x708090 slategrey 0x708090 snow 0xfffafa springgreen 0x00ff7f steelblue 0x4682b4 tan 0xd2b48c teal 0x008080 thistle 0xd8bfd8 tomato 0xff6347 turquoise 0x40e0d0 violet 0xee82ee wheat 0xf5deb3 white 0xffffff whitesmoke 0xf5f5f5 yellow 0xffff00 yellowgreen 0x9acd32"
    mut parts := str.Fields(table)
    mut i := 0
    until i + 1 < parts.Len():
        name := parts.Get(i)
        v := _w_hexint(parts.Get(i + 1))
        g_web_color_names.Put(name, v)
        if not g_web_color_rgb.Has(v):
            g_web_color_rgb.Put(v, name.Copy())
        end
        i += 2
    end
    parts.Free()
end

func _w_named_color_ok(s: str): bool:
    if not _w_word(s):
        ret false
    end
    lw := s.Lower()
    if lw == "transparent" or lw == "currentcolor":
        ret true
    end
    _w_init_colors()
    ret g_web_color_names.Has(lw)
end

pure func _w_is_num(s: str): bool:
    n := s.Len()
    if n == 0:
        ret false
    end
    mut i := 0
    b0 := _wb(s, 0)
    if b0 == 45 or b0 == 43:
        i = 1
    end
    mut digits := 0
    mut dot := false
    until i < n:
        b := _wb(s, i)
        if b >= 48 and b <= 57:
            digits++
        else b == 46 and not dot:
            dot = true
        else:
            ret false
        end
        i++
    end
    ret digits > 0
end

pure func _w_is_pct(s: str): bool:
    n := s.Len()
    if n < 2 or _wb(s, n - 1) != 37:
        ret false
    end
    ret _w_is_num(s.Substr(0, n - 1))
end

pure func _w_unit_num(s: str, unit: str): bool:
    n := s.Len()
    un := unit.Len()
    if n <= un:
        ret false
    end
    ret s.Substr(n - un, un) == unit and _w_is_num(s.Substr(0, n - un))
end

pure func _w_is_angle(s: str): bool:
    ret _w_is_num(s) or _w_unit_num(s, "deg") or _w_unit_num(s, "grad") or _w_unit_num(s, "rad") or _w_unit_num(s, "turn")
end

pure func _w_is_none(s: str): bool:
    ret s == "none"
end

pure func _w_chan_ok(s: str): bool:
    ret _w_is_num(s) or _w_is_pct(s) or _w_is_none(s)
end

func _w_color_tokens(inner: str): Vector<str>:
    mut buf := str.NewBuilder()
    n := inner.Len()
    repeat n in i:
        c := _wb(inner, i)
        if c == 44:
            str.BufAppendChar(buf, 32)
        else c == 47:
            str.BufAppendChar(buf, 32)
            str.BufAppendChar(buf, 47)
            str.BufAppendChar(buf, 32)
        else:
            str.BufAppendChar(buf, c)
        end
    end
    flat := str.BufStr(buf)
    str.BufFree(buf)
    ret str.Fields(flat)
end

func _w_color_fn_args_ok(fname: str, toks: Vector<str>): bool:
    mut n := toks.Len()
    mut alpha := ""
    mut has_alpha := false
    if n >= 2 and toks.Get(n - 2) == "/":
        alpha = toks.Get(n - 1)
        has_alpha = true
        n -= 2
    else n == 4:
        alpha = toks.Get(3)
        has_alpha = true
        n = 3
    end
    if n != 3:
        ret false
    end
    if has_alpha and not _w_chan_ok(alpha):
        ret false
    end
    c0 := toks.Get(0)
    c1 := toks.Get(1)
    c2 := toks.Get(2)
    if fname == "rgb" or fname == "rgba" or fname == "lab" or fname == "oklab":
        ret _w_chan_ok(c0) and _w_chan_ok(c1) and _w_chan_ok(c2)
    end
    if fname == "hsl" or fname == "hsla" or fname == "hwb":
        ret (_w_is_angle(c0) or _w_is_none(c0)) and (_w_is_pct(c1) or _w_is_none(c1)) and (_w_is_pct(c2) or _w_is_none(c2))
    end
    if fname == "lch" or fname == "oklch":
        ret _w_chan_ok(c0) and _w_chan_ok(c1) and (_w_is_angle(c2) or _w_is_none(c2))
    end
    ret false
end

func _w_color_func_ok(s: str): bool:
    n := s.Len()
    if n > 128 or _wb(s, n - 1) != 41:
        ret false
    end
    mut open := 0 - 1
    repeat n in i:
        if _wb(s, i) == 40 and open < 0:
            open = i
        end
    end
    if open <= 0:
        ret false
    end
    fname := s.Substr(0, open).Lower()
    known := fname == "rgb" or fname == "rgba" or fname == "hsl" or fname == "hsla" or fname == "hwb" or fname == "oklch" or fname == "oklab" or fname == "lab" or fname == "lch"
    if not known:
        ret false
    end
    inner := s.Substr(open + 1, n - open - 2)
    toks := _w_color_tokens(inner)
    ok := _w_color_fn_args_ok(fname, toks)
    toks.Free()
    ret ok
end

func _w_color_ok(s: str): bool:
    n := s.Len()
    if n == 0:
        ret false
    end
    if _wb(s, 0) == 35:
        if n != 4 and n != 5 and n != 7 and n != 9:
            ret false
        end
        mut i := 1
        until i < n:
            if not _w_hex(_wb(s, i)):
                ret false
            end
            i++
        end
        ret true
    end
    if _w_named_color_ok(s):
        ret true
    end
    ret _w_color_func_ok(s)
end

func _w_hex1(v: int): str:
    digits := "0123456789abcdef"
    ret digits.Substr(v, 1)
end

func _w_hex2(v: int): str:
    ret _w_hex1(v / 16) + _w_hex1(v % 16)
end

func _w_best_color(r: int, g: int, b: int, a: int): str:
    rr := _w_clamp(r, 255)
    gg := _w_clamp(g, 255)
    bb := _w_clamp(b, 255)
    aa := _w_clamp(a, 255)
    v := rr * 65536 + gg * 256 + bb
    if aa == 255:
        _w_init_colors()
        if g_web_color_rgb.Has(v):
            ret g_web_color_rgb.Get(v).Copy()
        end
        if rr % 17 == 0 and gg % 17 == 0 and bb % 17 == 0:
            ret "#" + _w_hex1(rr / 17) + _w_hex1(gg / 17) + _w_hex1(bb / 17)
        end
        ret "#" + _w_hex2(rr) + _w_hex2(gg) + _w_hex2(bb)
    end
    if rr % 17 == 0 and gg % 17 == 0 and bb % 17 == 0 and aa % 17 == 0:
        ret "#" + _w_hex1(rr / 17) + _w_hex1(gg / 17) + _w_hex1(bb / 17) + _w_hex1(aa / 17)
    end
    ret "#" + _w_hex2(rr) + _w_hex2(gg) + _w_hex2(bb) + _w_hex2(aa)
end

pure func _w_floor(v: f64): f64:
    i := v as int
    fi := i as f64
    ret fi > v ? fi - 1.0 : fi
end

pure func _w_fmin(a: f64, b: f64): f64:
    ret a < b ? a : b
end

pure func _w_fmax(a: f64, b: f64): f64:
    ret a > b ? a : b
end

pure func _w_clampf01(v: f64): f64:
    if v < 0.0:
        ret 0.0
    end
    if v > 1.0:
        ret 1.0
    end
    ret v
end

pure func _w_hsl_channel(n: f64, h: f64, s: f64, l: f64): f64:
    k0 := n + h / 30.0
    k := k0 - _w_floor(k0 / 12.0) * 12.0
    a := s * _w_fmin(l, 1.0 - l)
    mx := _w_fmax(0.0 - 1.0, _w_fmin(_w_fmin(k - 3.0, 9.0 - k), 1.0))
    ret l - a * mx
end

pure func _w_round255(v: f64): int:
    scaled := v * 255.0 + 0.5
    ret _w_clamp(scaled as int, 255)
end

func _w_hsl_to_rgb(h: int, s: int, l: int, r &: int, g &: int, b &: int):
    mut hh := (h % 360) as f64
    if hh < 0.0:
        hh += 360.0
    end
    ss := _w_clampf01(s as f64 / 100.0)
    ll := _w_clampf01(l as f64 / 100.0)
    r = _w_round255(_w_hsl_channel(0.0, hh, ss, ll))
    g = _w_round255(_w_hsl_channel(8.0, hh, ss, ll))
    b = _w_round255(_w_hsl_channel(4.0, hh, ss, ll))
end

pure func _w_clamp(v: int, hi: int): int:
    if v < 0:
        ret 0
    end
    if v > hi:
        ret hi
    end
    ret v
end

pure func _w_length_ok(s: str): bool:
    n := s.Len()
    if n == 0 or n > 32:
        ret false
    end
    if s == "0" or s == "auto":
        ret true
    end
    mut i := 0
    if _wb(s, 0) == 45:
        i = 1
    end
    mut digits := 0
    mut dot := false
    until i < n:
        b := _wb(s, i)
        if b >= 48 and b <= 57:
            digits++
        else b == 46 and not dot:
            dot = true
        else:
            break
        end
        i++
    end
    if digits == 0:
        ret false
    end
    unit := s.Substr(i, n - i)
    ret unit == "px" or unit == "em" or unit == "rem" or unit == "%" or unit == "vh" or unit == "vw" or unit == "vmin" or unit == "vmax" or unit == "pt" or unit == "ch" or unit == "ex" or unit == "cm" or unit == "mm" or unit == "in" or unit == "fr" or unit == ""
end

func _w_escape(b &: str.StringBuilder, s: str):
    n := s.Len()
    mut clean := true
    repeat n in i:
        c := _wb(s, i)
        if c == 38 or c == 60 or c == 62 or c == 34 or c == 39:
            clean = false
            break
        end
    end
    if clean:
        str.BufAppend(b, s)
        ret
    end
    repeat n in j:
        c := _wb(s, j)
        if c == 38:
            str.BufAppend(b, "&amp;")
        else c == 60:
            str.BufAppend(b, "&lt;")
        else c == 62:
            str.BufAppend(b, "&gt;")
        else c == 34:
            str.BufAppend(b, "&quot;")
        else c == 39:
            str.BufAppend(b, "&#39;")
        else:
            str.BufAppendChar(b, c)
        end
    end
end

@en "ParseUrl"
@fa "خواندن نشانی وب"
pub func ParseUrl(s: str, ok &: bool): Url:
    mut v := Url {}
    ok = v.Set(s)
    ret v
end

@en "UrlText"
@fa "متن نشانی وب"
pub pure func UrlText(u: Url): str:
    ret u.text()
end

@en "ParseColor"
@fa "خواندن رنگ وب"
pub func ParseColor(s: str, ok &: bool): Color:
    mut v := Color {}
    ok = v.Set(s)
    ret v
end

@en "Rgb"
@fa "رنگ آر جی بی"
pub func Rgb(r: int, g: int, b: int): Color:
    mut v := Color {}
    _ok := v.Set(_w_best_color(r, g, b, 255))
    ret v
end

@en "Rgba"
@fa "رنگ آر جی بی با شفافیت"
pub func Rgba(r: int, g: int, b: int, a: int): Color:
    mut v := Color {}
    _ok := v.Set(_w_best_color(r, g, b, a))
    ret v
end

@en "Hsl"
@fa "رنگ اچ اس ال"
pub func Hsl(h: int, s: int, l: int): Color:
    mut r := 0
    mut g := 0
    mut b := 0
    _w_hsl_to_rgb(h, s, l, r, g, b)
    ret Rgb(r, g, b)
end

@en "Hsla"
@fa "رنگ اچ اس ال با شفافیت"
pub func Hsla(h: int, s: int, l: int, a: int): Color:
    mut r := 0
    mut g := 0
    mut b := 0
    _w_hsl_to_rgb(h, s, l, r, g, b)
    ret Rgba(r, g, b, a)
end

@en "ParseLength"
@fa "خواندن اندازه وب"
pub func ParseLength(s: str, ok &: bool): Length:
    mut v := Length {}
    ok = v.Set(s)
    ret v
end

@en "Px"
@fa "پیکسل"
pub func Px(n: int): Length:
    mut v := Length {}
    _ok := v.Set("" + n + "px")
    ret v
end

@en "Percent"
@fa "درصد"
pub func Percent(n: int): Length:
