end

@en "Rem"
@fa "رم"
pub func Rem(f: f64): Length:
    mut v := Length {}
    _ok := v.Set("" + f + "rem")
    ret v
end

@en "PageBegin"
@fa "آغاز صفحه"
pub func PageBegin(): str.StringBuilder:
    ret str.NewBuilder()
end

@en "PageEnd"
@fa "پایان صفحه"
pub func PageEnd(b &: str.StringBuilder): str:
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

@en "PageStatic"
@fa "بخش ثابت صفحه"
pub func PageStatic(b &: str.StringBuilder, s: str):
    str.BufAppend(b, s)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, s: str):
    _w_escape(b, s)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, n: int):
    str.BufAppendInt(b, n as i64)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, n: i64):
    str.BufAppendInt(b, n)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, f: f64):
    str.BufAppend(b, "" + f)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, v: bool):
    str.BufAppend(b, v ? "true" : "false")
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, u: Url):
    _w_escape(b, u.text())
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, c: Color):
    _w_escape(b, c.text())
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, l: Length):
    _w_escape(b, l.text())
end

@en "PageUrl"
@fa "نشانی صفحه"
pub func PageUrl(b &: str.StringBuilder, u: Url):
    _w_escape(b, u.text())
end

@en "PageCss"
@fa "سبک صفحه"
pub func PageCss(b &: str.StringBuilder, c: Color):
    _w_escape(b, c.text())
end

@en "PageCss"
@fa "سبک صفحه"
pub func PageCss(b &: str.StringBuilder, l: Length):
    _w_escape(b, l.text())
end

@en "PageCss"
@fa "سبک صفحه"
pub func PageCss(b &: str.StringBuilder, n: int):
    str.BufAppendInt(b, n as i64)
end

@en "PageCss"
@fa "سبک صفحه"
pub func PageCss(b &: str.StringBuilder, f: f64):
    str.BufAppend(b, "" + f)
end

@en "PageCssUrl"
@fa "نشانی سبک صفحه"
pub func PageCssUrl(b &: str.StringBuilder, u: Url):
    str.BufAppend(b, u.text())
end
