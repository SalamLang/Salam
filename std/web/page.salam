package web

import str

@en "Url"
@fa "نشانی وب"
pub struct Url:
    value: str = ""

    @en "set"
    @fa "تنظیم"
    pub func set(s: str): bool:
        if not _w_url_ok(s):
            ret false
        end
        this.value = s
        ret true
    end

    @en "text"
    @fa "متن"
    pub pure func text(): str:
        ret this.value
    end
end

@en "Color"
@fa "رنگ وب"
pub struct Color:
    value: str = ""

    @en "set"
    @fa "تنظیم"
    pub func set(s: str): bool:
        if not _w_color_ok(s):
            ret false
        end
        this.value = s
        ret true
    end

    @en "text"
    @fa "متن"
    pub pure func text(): str:
        ret this.value
    end
end

@en "Length"
@fa "اندازه وب"
pub struct Length:
    value: str = ""

    @en "set"
    @fa "تنظیم"
    pub func set(s: str): bool:
        if not _w_length_ok(s):
            ret false
        end
        this.value = s
        ret true
    end

    @en "text"
    @fa "متن"
    pub pure func text(): str:
        ret this.value
    end
end

inline pure func _wb(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0: v = v + 256 end
    ret v
end

pure func _w_lower(c: int): int:
    if c >= 65 and c <= 90:
        ret c + 32
    end
    ret c
end

pure func _w_scheme_len(s: str): int:
    n := s.len()
    if n == 0:
        ret 0
    end
    b0 := _w_lower(_wb(s, 0))
    if b0 < 97 or b0 > 122:
        ret 0
    end
    mut i := 1
    until i < n:
        b := _w_lower(_wb(s, i))
        if b == 58:
            ret i
        end
        ok := (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 46
        if not ok:
            ret 0
        end
        i += 1
    end
    ret 0
end

pure func _w_prefix_ci(s: str, p: str): bool:
    if s.len() < p.len():
        ret false
    end
    repeat p.len() in i:
        if _w_lower(_wb(s, i)) != _wb(p, i):
            ret false
        end
    end
    ret true
end

pure func _w_url_ok(s: str): bool:
    n := s.len()
    if n == 0 or n > 8192:
        ret false
    end
    repeat n in i:
        b := _wb(s, i)
        if b < 33 or b == 127 or b == 34 or b == 39 or b == 60 or b == 62 or b == 92 or b == 96:
            ret false
        end
    end
    sl := _w_scheme_len(s)
    if sl == 0:
        ret true
    end
    ret _w_prefix_ci(s, "http://") or _w_prefix_ci(s, "https://") or _w_prefix_ci(s, "mailto:") or _w_prefix_ci(s, "tel:")
end

pure func _w_hex(b: int): bool:
    ret (b >= 48 and b <= 57) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)
end

pure func _w_word(s: str): bool:
    if s.len() == 0 or s.len() > 32:
        ret false
    end
    repeat s.len() in i:
        b := _w_lower(_wb(s, i))
        if b < 97 or b > 122:
            ret false
        end
    end
    ret true
end

pure func _w_color_func_ok(s: str): bool:
    n := s.len()
    if n > 64 or _wb(s, n - 1) != 41:
        ret false
    end
    mut open := 0 - 1
    repeat n in i:
        if _wb(s, i) == 40 and open < 0:
            open = i
        end
    end
    if open <= 0:
        ret false
    end
    fname := s.substr(0, open)
    known := fname == "rgb" or fname == "rgba" or fname == "hsl" or fname == "hsla" or fname == "hwb" or fname == "oklch" or fname == "oklab" or fname == "lab" or fname == "lch"
    if not known:
        ret false
    end
    mut i := open + 1
    until i < n - 1:
        b := _wb(s, i)
        ok := (b >= 48 and b <= 57) or b == 46 or b == 44 or b == 32 or b == 37 or b == 47 or b == 45 or b == 43 or (b >= 97 and b <= 122)
        if not ok:
            ret false
        end
        i += 1
    end
    ret true
end

pure func _w_color_ok(s: str): bool:
    n := s.len()
    if n == 0:
        ret false
    end
    if _wb(s, 0) == 35:
        if n != 4 and n != 5 and n != 7 and n != 9:
            ret false
        end
        mut i := 1
        until i < n:
            if not _w_hex(_wb(s, i)):
                ret false
            end
            i += 1
        end
        ret true
    end
    if _w_word(s):
        ret true
    end
    ret _w_color_func_ok(s)
end

pure func _w_clamp(v: int, hi: int): int:
    if v < 0:
        ret 0
    end
    if v > hi:
        ret hi
    end
    ret v
end

pure func _w_length_ok(s: str): bool:
    n := s.len()
    if n == 0 or n > 32:
        ret false
    end
    if s == "0" or s == "auto":
        ret true
    end
    mut i := 0
    if _wb(s, 0) == 45:
        i = 1
    end
    mut digits := 0
    mut dot := false
    until i < n:
        b := _wb(s, i)
        if b >= 48 and b <= 57:
            digits += 1
        else b == 46 and not dot:
            dot = true
        else:
            break
        end
        i += 1
    end
    if digits == 0:
        ret false
    end
    unit := s.substr(i, n - i)
    ret unit == "px" or unit == "em" or unit == "rem" or unit == "%" or unit == "vh" or unit == "vw" or unit == "vmin" or unit == "vmax" or unit == "pt" or unit == "ch" or unit == "ex" or unit == "cm" or unit == "mm" or unit == "in" or unit == "fr" or unit == ""
end

func _w_escape(b &: str.StringBuilder, s: str):
    n := s.len()
    mut clean := true
    repeat n in i:
        c := _wb(s, i)
        if c == 38 or c == 60 or c == 62 or c == 34 or c == 39:
            clean = false
            break
        end
    end
    if clean:
        str.BufAppend(b, s)
        ret
    end
    repeat n in j:
        c := _wb(s, j)
        if c == 38:
            str.BufAppend(b, "&amp;")
        else c == 60:
            str.BufAppend(b, "&lt;")
        else c == 62:
            str.BufAppend(b, "&gt;")
        else c == 34:
            str.BufAppend(b, "&quot;")
        else c == 39:
            str.BufAppend(b, "&#39;")
        else:
            str.BufAppendChar(b, c)
        end
    end
end

@en "ParseUrl"
@fa "خواندن نشانی وب"
pub func ParseUrl(s: str, ok &: bool): Url:
    mut v := Url {}
    ok = v.set(s)
    ret v
end

@en "UrlText"
@fa "متن نشانی وب"
pub pure func UrlText(u: Url): str:
    ret u.text()
end

@en "ParseColor"
@fa "خواندن رنگ وب"
pub func ParseColor(s: str, ok &: bool): Color:
    mut v := Color {}
    ok = v.set(s)
    ret v
end

@en "Rgb"
@fa "رنگ آر جی بی"
pub func Rgb(r: int, g: int, b: int): Color:
    mut v := Color {}
    _ok := v.set("rgb(" + _w_clamp(r, 255) + "," + _w_clamp(g, 255) + "," + _w_clamp(b, 255) + ")")
    ret v
end

@en "ParseLength"
@fa "خواندن اندازه وب"
pub func ParseLength(s: str, ok &: bool): Length:
    mut v := Length {}
    ok = v.set(s)
    ret v
end

@en "Px"
@fa "پیکسل"
pub func Px(n: int): Length:
    mut v := Length {}
    _ok := v.set("" + n + "px")
    ret v
end

@en "Percent"
@fa "درصد"
pub func Percent(n: int): Length:
    mut v := Length {}
    _ok := v.set("" + n + "%")
    ret v
end

@en "Em"
@fa "ام"
pub func Em(f: f64): Length:
    mut v := Length {}
    _ok := v.set("" + f + "em")
    ret v
end

@en "Rem"
@fa "رم"
pub func Rem(f: f64): Length:
    mut v := Length {}
    _ok := v.set("" + f + "rem")
    ret v
end

@en "PageBegin"
@fa "آغاز صفحه"
pub func PageBegin(): str.StringBuilder:
    ret str.NewBuilder()
end

@en "PageEnd"
@fa "پایان صفحه"
pub func PageEnd(b &: str.StringBuilder): str:
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

@en "PageStatic"
@fa "بخش ثابت صفحه"
pub func PageStatic(b &: str.StringBuilder, s: str):
    str.BufAppend(b, s)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, s: str):
    _w_escape(b, s)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, n: int):
    str.BufAppendInt(b, n as i64)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, n: i64):
    str.BufAppendInt(b, n)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, f: f64):
    str.BufAppend(b, "" + f)
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, v: bool):
    str.BufAppend(b, v ? "true" : "false")
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, u: Url):
    _w_escape(b, u.text())
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, c: Color):
    _w_escape(b, c.text())
end

@en "PageText"
@fa "متن صفحه"
pub func PageText(b &: str.StringBuilder, l: Length):
    _w_escape(b, l.text())
end

@en "PageUrl"
@fa "نشانی صفحه"
pub func PageUrl(b &: str.StringBuilder, u: Url):
    _w_escape(b, u.text())
end

@en "PageCss"
@fa "سبک صفحه"
pub func PageCss(b &: str.StringBuilder, c: Color):
    _w_escape(b, c.text())
end

@en "PageCss"
@fa "سبک صفحه"
pub func PageCss(b &: str.StringBuilder, l: Length):
    _w_escape(b, l.text())
end

@en "PageCss"
@fa "سبک صفحه"
pub func PageCss(b &: str.StringBuilder, n: int):
    str.BufAppendInt(b, n as i64)
end

@en "PageCss"
@fa "سبک صفحه"
pub func PageCss(b &: str.StringBuilder, f: f64):
    str.BufAppend(b, "" + f)
end

@en "PageCssUrl"
@fa "نشانی سبک صفحه"
pub func PageCssUrl(b &: str.StringBuilder, u: Url):
    str.BufAppend(b, u.text())
end
