package web

@en "NewServer"
@fa "سرور جدید"
@ar "خادم جدید"
pub func NewServer(port: int): Server:
    ret Server { port = port }
end

@en "Use"
@fa "استفاده"
@ar "استخدام"
pub func Use(s &: Server, r: Router):
    s.router = r
end

@en "HideTokens"
@fa "پنهان سازی توکن"
@ar "إخفاء الرموز"
pub func HideTokens(s &: Server):
    s.hide_tokens = true
end

@en "SetHost"
@fa "تنظیم میزبان"
@ar "تعیین المضیف"
pub func SetHost(s &: Server, host: str):
    s.host = host
end

@en "EnableAccessLog"
@fa "فعال سازی گزارش دسترسی"
@ar "تفعیل سجل الوصول"
pub func EnableAccessLog(s &: Server):
    s.access_log = true
end

@en "Run"
@fa "اجرا"
@ar "تشغیل"
pub func Run(s: Server):
    _reqctx_sizeof()
    _warm_up_split()
    _current_router = s.router
    _hide_tokens = s.hide_tokens
    _access_log = s.access_log
    port := s.port
    lfd := _net_listen(s.host, port)
    if lfd < 0:
        ret
    end
    until 1 == 1:
        cfd := _net_accept(lfd)
        if cfd >= 0:
            salam_spawn_fn_i64(funcptr(_web_conn_handler), cfd)
        end
    end
end
