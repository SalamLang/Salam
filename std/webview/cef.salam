package webview

if SALAM_WEBVIEW_CEF:
    if not SALAM_WEBVIEW_CEF_MOCK:
        link dynamic "salam_webview_cef"
    end

    extern:
        func salam_wv_cef_init(debug: int): int
        func salam_wv_cef_create(width: int, height: int, debug: int): void*
        func salam_wv_cef_destroy(view: void*)
        func salam_wv_cef_pump()
        func salam_wv_cef_is_closed(view: void*): int
        func salam_wv_cef_set_title(view: void*, title: str)
        func salam_wv_cef_set_size(view: void*, width: int, height: int, fixed: int)
        func salam_wv_cef_set_html(view: void*, html: str)
        func salam_wv_cef_navigate(view: void*, url: str)
        func salam_wv_cef_eval(view: void*, js: str)
    end

    mut _cef_views := Vector {} as Vector<void*>

    func _cef_view(id: int): void*:
        ret _cef_views[id]
    end

    func _wv_bk_create(id: int, debug: bool, _visible: bool): bool:
        until _cef_views.len() <= id:
            _cef_views.push(null)
        end
        if salam_wv_cef_init(debug ? 1 : 0) == 0:
            ret false
        end
        view := salam_wv_cef_create(800, 600, debug ? 1 : 0)
        if view == null:
            ret false
        end
        _cef_views[id] = view
        ret true
    end

    func _wv_bk_destroy(id: int):
        salam_wv_cef_destroy(_cef_view(id))
    end

    func _wv_bk_iter():
        salam_wv_cef_pump()
        repeat _cef_views.len() in i:
            if _wv_alive(i) and salam_wv_cef_is_closed(_cef_views[i]) != 0:
                _wv_mark_closed(i)
            end
        end
    end

    func _wv_bk_wake():
        _wv_touch()
    end

    func _wv_bk_set_title(id: int, title: str):
        salam_wv_cef_set_title(_cef_view(id), title)
    end

    func _wv_bk_set_size(id: int, width: int, height: int, hints: int):
        salam_wv_cef_set_size(_cef_view(id), width, height, hints == HINT_FIXED ? 1 : 0)
    end

    func _wv_bk_set_min_size(_id: int, _width: int, _height: int):
        _wv_touch()
    end

    func _wv_bk_set_icon(_id: int, _path: str):
        _wv_touch()
    end

    func _wv_bk_set_html(id: int, html: str):
        salam_wv_cef_set_html(_cef_view(id), html)
    end

    func _wv_bk_navigate(id: int, url: str):
        salam_wv_cef_navigate(_cef_view(id), url)
    end

    func _wv_bk_eval(id: int, js: str):
        salam_wv_cef_eval(_cef_view(id), js)
    end

    func _wv_bk_add_script(id: int, js: str, _all_frames: bool):
        salam_wv_cef_eval(_cef_view(id), js)
    end

    func _wv_bk_url(_id: int): str:
        ret str.Clone("")
    end

    func _wv_bk_show(_id: int):
        _wv_touch()
    end

    func _wv_bk_hide(_id: int):
        _wv_touch()
    end

    func _wv_bk_focus(_id: int):
        _wv_touch()
    end

    func _wv_bk_minimize(_id: int):
        _wv_touch()
    end

    func _wv_bk_maximize(_id: int):
        _wv_touch()
    end

    func _wv_bk_center(_id: int):
        _wv_touch()
    end

    func _wv_bk_is_active(_id: int): bool:
        ret true
    end

    func _wv_bk_native(id: int): void*:
        ret _cef_view(id)
    end

    func _wv_bk_devtools(_id: int):
        _wv_touch()
    end

    func _wv_bk_context_menu(_id: int, _enabled: bool):
        _wv_touch()
    end

    func _wv_bk_register_scheme(_name: str):
        _wv_touch()
    end

    func _wv_bk_content(id: int): void*:
        ret _cef_view(id)
    end

    func _wv_bk_menu_host(): void*:
        ret null
    end

    func _wv_bk_name_message_window(_title: str):
        _wv_touch()
    end

    func _wv_bk_scheme_origin(name: str): str:
        ret name.concat("://localhost")
    end

    func _wv_bk_post_script(): str:
        ret str.Clone("(s)=>{}")
    end
end
