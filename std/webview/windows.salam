package webview

if SALAM_OS_WINDOWS and not SALAM_WEBVIEW_CEF:
    link dynamic "user32"
    link dynamic "kernel32"
    link dynamic "WebView2Loader"

    extern:
        func CreateWindowExA(
            ex_style: u32, class_name: str, window_name: str, style: u32, x: int, y: int, width: int, height: int, parent: void*, menu: void*, instance: void*, param: void*
        ): void*
        func DestroyWindow(hwnd: void*): int
        func IsWindow(hwnd: void*): int
        func PeekMessageA(
            msg: void*, hwnd: void*, filter_min: u32, filter_max: u32, remove: u32
        ): int
        func TranslateMessage(msg: void*): int
        func DispatchMessageA(msg: void*): i64
        func SetWindowTextA(hwnd: void*, text: str): int
        func SetWindowPos(
            hwnd: void*, insert_after: void*, x: int, y: int, width: int, height: int, flags: u32
        ): int
        func MultiByteToWideChar(
            code_page: u32, flags: u32, mb_str: str, mb_len: i32, wide_buf: void*, wide_len: i32
        ): i32
        func CreateCoreWebView2EnvironmentWithOptions(
            browser_exe_folder: void*, user_data_folder: void*, environment_options: void*, handler: void*
        ): i32
    end
    if SALAM_ARCH_X86:
        extern:
            func VirtualAlloc(addr: void*, size: void*, kind: u32, protect: u32): void*
            func VirtualProtect(addr: void*, size: void*, protect: u32, old: void*): int
        end
    end

    @en "HintNone"
    @fa "بدون اشاره"
    pub const HINT_NONE := 0

    @en "HintFixed"
    @fa "اشاره ثابت"
    pub const HINT_FIXED := 1

    mut _wv2_env := null as void*
    mut _wv2_ctrl := null as void*
    mut _h_qi := null as void*
    mut _h_addref := null as void*
    mut _h_release := null as void*
    mut _h_env := null as void*
    mut _h_ctrl := null as void*
    mut _h_exec := null as void*

    struct Slot:
        pub v: void* = null
    end

    struct WvRect:
        pub left: i32 = 0
        pub top: i32 = 0
        pub right: i32 = 0
        pub bottom: i32 = 0
    end

    @en "WebView"
    @fa "نمایش وب"
    pub struct WebView:
        @en "hwnd"
        @fa "دسته پنجره"
        pub hwnd: void* = null
        @en "controller"
        @fa "کنترل‌گر"
        pub controller: void* = null
        @en "webview"
        @fa "دسته مرورگر"
        pub webview: void* = null
        @en "closed"
        @fa "بسته‌شده"
        pub closed: bool = false

        @en "destroy"
        @fa "نابود کردن"
        pub func Destroy():
            if this.hwnd != null and not this.closed:
                if this.controller != null:
                    close_fn := (com_vtbl_slot(this.controller, 24)) as extern stdcall func (void*) i32
                    close_fn(this.controller)
                end
                DestroyWindow(this.hwnd)
                this.hwnd = null
                this.controller = null
                this.webview = null
                this.closed = true
            end
        end

        @en "run"
        @fa "اجرا"
        pub func Run():
            if this.hwnd == null or this.closed:
                ret
            end
            msg := mem.Allocate(48 as u64)
            until not this.closed:
                got := PeekMessageA(msg, null, 0 as u32, 0 as u32, 1 as u32)
                if got != 0:
                    TranslateMessage(msg)
                    DispatchMessageA(msg)
                end
                if IsWindow(this.hwnd) == 0:
                    this.closed = true
                end
            end
        end

        @en "terminate"
        @fa "پایان دادن"
        pub func Terminate():
            this.closed = true
        end

        @en "SetTitle"
        @fa "تنظیم عنوان"
        pub func SetTitle(title: str):
            if this.hwnd != null and not this.closed:
                SetWindowTextA(this.hwnd, title)
            end
        end

        @en "SetSize"
        @fa "تنظیم اندازه"
        pub func SetSize(width: int, height: int, _hints: int = HINT_NONE):
            if this.hwnd != null and not this.closed:
                SetWindowPos(this.hwnd, null, 0, 0, width, height, 2 as u32)
                if this.controller != null:
                    com_put_bounds(this.controller, width, height)
                end
            end
        end

        @en "SetHTML"
        @fa "تنظیم اچ تی ام ال"
        pub func SetHTML(html: str):
            if this.webview != null and not this.closed:
                wide := to_wide(html)
                nav_fn := (com_vtbl_slot(this.webview, 6)) as extern stdcall func (void*, void*) i32
                nav_fn(this.webview, wide)
                mem.Free(wide)
            end
        end

        @en "Navigate"
        @fa "پیمایش"
        pub func Navigate(url: str):
            if this.webview != null and not this.closed:
                wide := to_wide(url)
                nav_fn := (com_vtbl_slot(this.webview, 5)) as extern stdcall func (void*, void*) i32
                nav_fn(this.webview, wide)
                mem.Free(wide)
            end
        end

        @en "Eval"
        @fa "ارزیابی"
        pub func Eval(js: str):
            if this.webview != null and not this.closed:
                wide := to_wide(js)
                exec_handler := make_com_obj(_h_exec)
                exec_fn := (com_vtbl_slot(this.webview, 29)) as extern stdcall func (void*, void*, void*) i32
                exec_fn(this.webview, wide, exec_handler)
                mem.Free(wide)
            end
        end

        @en "Init"
        @fa "اولیه‌سازی"
        pub func Init(js: str):
            this.Eval(js)
        end

        @en "IsClosed"
        @fa "بسته شده است"
        pub func IsClosed(): bool:
            ret this.closed
        end
    end

    export:
        func salam_com_qi(_this: void*, _riid: void*, ppv: void*): i32:
            if ppv != null:
                slot := ppv as Slot*
                slot[0].v = _this
            end
            ret 0
        end
        func salam_com_addref(_this: void*): u32:
            ret 1
        end
        func salam_com_release(_this: void*): u32:
            ret 1
        end
        func salam_env_completed(_this: void*, _error_code: i32, environment: void*): i32:
            _wv2_env = environment
            ret 0
        end
        func salam_ctrl_completed(_this: void*, _error_code: i32, controller: void*): i32:
            _wv2_ctrl = controller
            ret 0
        end
        func salam_exec_completed(_this: void*, _error_code: i32, _result_json: void*): i32:
            ret 0
        end
    end

    if SALAM_ARCH_X86:
        func com_page_open(): void*:
            ret VirtualAlloc(null, (4096 as i64) as void*, 0x3000 as u32, 4 as u32)
        end

        func com_page_close(page: void*): bool:
            old := mem.Allocate(8 as u64)
            done := VirtualProtect(page, (4096 as i64) as void*, 0x20 as u32, old)
            mem.Free(old)
            ret done != 0
        end

        func com_handler(page: void*, index: int, fn: void*, words: int): void*:
            if page == null:
                ret fn
            end
            code := page as u8*
            size := words * 4
            mut at := index * 32
            start := at
            repeat words:
                code[at] = 0xFF as u8
                code[at + 1] = 0x74 as u8
                code[at + 2] = 0x24 as u8
                code[at + 3] = size as u8
                at += 4
            end
            addr := fn as i64
            code[at] = 0xB8 as u8
            repeat 4 in i:
                code[at + 1 + i] = ((addr >> (i * 8)) & (0xFF as i64)) as u8
            end
            code[at + 5] = 0xFF as u8
            code[at + 6] = 0xD0 as u8
            code[at + 7] = 0x83 as u8
            code[at + 8] = 0xC4 as u8
            code[at + 9] = size as u8
            code[at + 10] = 0xC2 as u8
            code[at + 11] = size as u8
            code[at + 12] = 0 as u8
            ret ((page as i64) + (start as i64)) as void*
        end

        func com_put_bounds(ctrl: void*, width: int, height: int):
            f := (com_vtbl_slot(ctrl, 6)) as extern stdcall func (void*, i32, i32, i32, i32) i32
            f(ctrl, 0, 0, width, height)
        end
    else:
        func com_page_open(): void*:
            ret null
        end

        func com_page_close(_page: void*): bool:
            ret true
        end

        func com_handler(_page: void*, _index: int, fn: void*, _words: int): void*:
            ret fn
        end

        if SALAM_ARCH_ARM64:
            func com_put_bounds(ctrl: void*, width: int, height: int):
                f := (com_vtbl_slot(ctrl, 6)) as extern stdcall func (void*, i64, i64) i32
                f(ctrl, 0 as i64, (width as i64) | ((height as i64) << 32))
            end
        else:
            func com_put_bounds(ctrl: void*, width: int, height: int):
                bounds := mem.Allocate(16 as u64)
                (bounds as WvRect*)[0] = WvRect { left = 0, top = 0, right = width, bottom = height }
                f := (com_vtbl_slot(ctrl, 6)) as extern stdcall func (void*, void*) i32
                f(ctrl, bounds)
                mem.Free(bounds)
            end
        end
    end

    func com_handlers_init():
        if _h_qi != null:
            ret
        end
        page := com_page_open()
        _h_qi = com_handler(page, 0, &salam_com_qi, 3)
        _h_addref = com_handler(page, 1, &salam_com_addref, 1)
        _h_release = com_handler(page, 2, &salam_com_release, 1)
        _h_env = com_handler(page, 3, &salam_env_completed, 3)
        _h_ctrl = com_handler(page, 4, &salam_ctrl_completed, 3)
        _h_exec = com_handler(page, 5, &salam_exec_completed, 3)
        if page != null:
            _closed := com_page_close(page)
        end
    end

    func make_com_obj(invoke: void*): void*:
        vtbl := (mem.Allocate(32 as u64)) as Slot*
        vtbl[0].v = _h_qi
        vtbl[1].v = _h_addref
        vtbl[2].v = _h_release
        vtbl[3].v = invoke
        obj := (mem.Allocate(8 as u64)) as Slot*
        obj[0].v = vtbl as void*
        ret obj as void*
    end

    func com_vtbl_slot(obj: void*, slot: int): void*:
        vtbl := (obj as Slot*)[0].v
        ret (vtbl as Slot*)[slot].v
    end

    func to_wide(s: str): void*:
        needed := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
        buf := mem.Allocate(((needed + 1) as u64) * (2 as u64))
        MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, buf, needed + 1)
        ret buf
    end

    @en "create"
    @fa "ایجاد"
    pub func Create(_debug: bool = false): WebView:
        hwnd := CreateWindowExA(
            0 as u32, "STATIC", "", 282001408 as u32, 100, 100, 800, 600, null, null, null, null
        )
        if hwnd == null:
            ret WebView { hwnd = null, controller = null, webview = null, closed = true }
        end

        _wv2_env = null as void*
        _wv2_ctrl = null as void*

        com_handlers_init()
        env_handler := make_com_obj(_h_env)
        CreateCoreWebView2EnvironmentWithOptions(null, null, null, env_handler)

        msg := mem.Allocate(48 as u64)
        mut spins := 0
        until _wv2_env == null and spins <= 200000:
            PeekMessageA(msg, null, 0 as u32, 0 as u32, 1 as u32)
            TranslateMessage(msg)
            DispatchMessageA(msg)
            spins += 1
        end
        if _wv2_env == null:
            DestroyWindow(hwnd)
            ret WebView { hwnd = null, controller = null, webview = null, closed = true }
        end

        ctrl_handler := make_com_obj(_h_ctrl)
        create_ctrl_fn := (com_vtbl_slot(_wv2_env, 3)) as extern stdcall func (void*, void*, void*) i32
        create_ctrl_fn(_wv2_env, hwnd, ctrl_handler)

        spins = 0
        until _wv2_ctrl == null and spins <= 200000:
            PeekMessageA(msg, null, 0 as u32, 0 as u32, 1 as u32)
            TranslateMessage(msg)
            DispatchMessageA(msg)
            spins += 1
        end
        if _wv2_ctrl == null:
            DestroyWindow(hwnd)
            ret WebView { hwnd = null, controller = null, webview = null, closed = true }
        end

        com_put_bounds(_wv2_ctrl, 800, 600)

        webview_slot := (mem.Allocate(8 as u64)) as Slot*
        get_wv_fn := (com_vtbl_slot(_wv2_ctrl, 25)) as extern stdcall func (void*, void*) i32
        get_wv_fn(_wv2_ctrl, webview_slot as void*)

        ret WebView {
            hwnd = hwnd, controller = _wv2_ctrl, webview = webview_slot[0].v, closed = false
        }
    end
end
