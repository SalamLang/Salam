@en "webview-cef"
@fa "نمایش وب CEF"
@ar "عرض الويب CEF"
package webview_cef

import mem
import str
import core

// Bundled CEF libraries. libcef itself ships as a shared library in CEF's
// binary distribution (libcef.so/.dylib/.dll alongside the CEF resources);
// cef_dll_wrapper is the static glue archive CEF provides specifically to
// be linked statically into the embedding app - that's its whole purpose.
link dynamic "cef"
link static "cef_dll_wrapper"

// Platform-specific system libraries
if SALAM_OS_WINDOWS:
    link dynamic "user32"
    link dynamic "gdi32"
    link dynamic "ole32"
    link dynamic "shell32"
    link dynamic "advapi32"
end

if SALAM_OS_LINUX:
    link dynamic "pthread"
    link dynamic "dl"
    link dynamic "m"
    link dynamic "X11"
end

if SALAM_OS_DARWIN:
    link dynamic "cocoa"
    link dynamic "coreservices"
    link dynamic "corefoundation"
    link dynamic "iokit"
end

extern:
    func cef_initialize(settings: void*): int
    func cef_create_browser_window(url: str, width: int, height: int, title: str): void*
    func cef_message_loop_run()
    func cef_shutdown()
    func cef_browser_close_browser(browser: void*, force: int)
    func cef_browser_set_title(browser: void*, title: str)
    func cef_browser_execute_function(browser: void*, js: str): int
    func cef_browser_load_url(browser: void*, url: str)
    func cef_browser_load_string(browser: void*, html: str)
    func cef_browser_reload(browser: void*)
    func cef_browser_get_focused(browser: void*): int
end

@en "HintNone"
@fa "بدون اشاره"
@ar "لا تلميح"
pub const HINT_NONE := 0

@en "HintFixed"
@fa "اشاره ثابت"
@ar "تلميح ثابت"
pub const HINT_FIXED := 1

mut _g_cef_initialized := false

@en "Settings"
@fa "تنظیمات"
@ar "إعدادات"
pub struct Settings:
    pub debug: bool = false
    pub cache_path: str = ""
    pub user_agent: str = ""
    pub log_level: int = 0
end

@en "WebView"
@fa "نمایش وب"
@ar "عرض الويب"
pub struct WebView:
    pub handle: void* = null
    pub closed: bool = false
    pub width: int = 800
    pub height: int = 600

    @en "CreateWindow"
    @fa "ایجاد پنجره"
    @ar "إنشاء نافذة"
    pub func CreateWindow(url: str, title: str):
        handle := cef_create_browser_window(url, this.width, this.height, title)
        if handle != null:
            this.handle = handle
        end
    end

    @en "Close"
    @fa "بسته کردن"
    @ar "إغلاق"
    pub func Close():
        if this.handle != null && !this.closed:
            cef_browser_close_browser(this.handle, 1)
            this.handle = null
            this.closed = true
        end
    end

    @en "Destroy"
    @fa "نابود کردن"
    @ar "تدمير"
    pub func Destroy():
        this.Close()
    end

    @en "SetTitle"
    @fa "تنظیم عنوان"
    @ar "تعيين العنوان"
    pub func SetTitle(title: str):
        if this.handle != null && !this.closed:
            cef_browser_set_title(this.handle, title)
        end
    end

    @en "SetSize"
    @fa "تنظیم اندازه"
    @ar "تعيين الحجم"
    pub func SetSize(width: int, height: int):
        this.width = width
        this.height = height
    end

    @en "SetHTML"
    @fa "تنظیم HTML"
    @ar "تعيين HTML"
    pub func SetHTML(html: str):
        if this.handle != null && !this.closed:
            cef_browser_load_string(this.handle, html)
        end
    end

    @en "Navigate"
    @fa "پیمایش"
    @ar "التنقل"
    pub func Navigate(url: str):
        if this.handle != null && !this.closed:
            cef_browser_load_url(this.handle, url)
        end
    end

    @en "Eval"
    @fa "ارزیابی"
    @ar "تقييم"
    pub func Eval(js: str): bool:
        if this.handle != null && !this.closed:
            result := cef_browser_execute_function(this.handle, js)
            ret result == 1
        end
        ret false
    end

    @en "Reload"
    @fa "بارگذاری مجدد"
    @ar "إعادة التحميل"
    pub func Reload():
        if this.handle != null && !this.closed:
            cef_browser_reload(this.handle)
        end
    end

    @en "IsFocused"
    @fa "متمرکز است"
    @ar "مركزة"
    pub func IsFocused(): bool:
        if this.handle != null && !this.closed:
            result := cef_browser_get_focused(this.handle)
            ret result == 1
        end
        ret false
    end

    @en "IsClosed"
    @fa "بسته شده است"
    @ar "مغلق"
    pub func IsClosed(): bool:
        ret this.closed
    end
end

func _initialize_cef(_settings: Settings):
    settings_ptr := mem.Allocate(512 as u64)
    if settings_ptr == null:
        ret
    end

    // Zero-initialize
    mem.Set(settings_ptr, 0, 512 as u64)

    // A cache path would be written into the settings block here; the
    // layout is CEF-version specific and nothing reads it yet.

    // Call CEF initialization
    result := cef_initialize(settings_ptr)

    mem.Free(settings_ptr)

    if result != 1:
        println "Failed to initialize CEF"
    end
end

@en "Create"
@fa "ایجاد"
@ar "إنشاء"
pub func Create(settings: Settings = Settings {}): WebView:
    if !_g_cef_initialized:
        _initialize_cef(settings)
        _g_cef_initialized = true
    end

    ret WebView { handle = null, closed = false, width = 800, height = 600 }
end

@en "Run"
@fa "اجرا"
@ar "تشغيل"
pub func Run():
    cef_message_loop_run()
end

@en "Shutdown"
@fa "خاموشی"
@ar "الإيقاف"
pub func Shutdown():
    cef_shutdown()
end
