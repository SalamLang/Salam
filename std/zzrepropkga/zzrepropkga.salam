package zzrepropkga

import zzrepropkgb

mut g_slots := Vector {} as Vector<zzrepropkgb.Foo>

pub struct Bar:
    pub y: int = 0
end

pub func Setup(): int:
    g_slots.push(zzrepropkgb.Empty())
    ret g_slots.len() - 1
end

pub func BumpSlot(idx: int):
    zzrepropkgb.Bump(g_slots.get(idx)[0])
end

pub func SlotValue(idx: int): int:
    ret g_slots.get(idx)[0].x
end
