// لغة: العربية
//
// donut.c - حلقة أندي سلون الدوارة بالمحارف، منقولة إلى سلام.
//
// الأصل صفحة من شيفرة سي مبهمة ترسم حلقة في مخزن محارف بحجم ٨٠ في ٢٢ ثم
// تعيد طباعته إلى الأبد. كل رقم سحري هنا هو رقم donut.c نفسه وقد نال اسما؛
// التغيير المتعمد الوحيد هو المشغل: بدل حلقة لا نهائية فوق طرفية ممسوحة
// نطبع عددا ثابتا من الإطارات كي يبقى الخرج قابلا للتكرار.
//
// السطح دائرة نصف قطرها «نصف صغير» في مستوى س-ص، تزاح إلى «نصف كبير» وتكنس
// حول محور ص بالزاوية فاي. ثم تدور بالزاوية أ حول محور س وبالزاوية ب حول
// محور ع، وتبعد عن العين بمقدار «بعد»، ثم تسقط على الشاشة.

استيراد ریاضیات
استيراد نص

// ---------------------------------------------------------------------------
// الشاشة
// ---------------------------------------------------------------------------

ثابت عرض := 80
ثابت ارتفاع := 22
ثابت خلايا := 1760 // عرض × ارتفاع - وهو b[1760] و z[1760] في donut.c

// سلم السطوع من الأخفت إلى الأسطع: وهو ".,-~:;=!*#$@" في donut.c
ثابت سلم := ".,-~:;=!*#$@"

// مركز الإسقاط ومقياسا البكسل الأفقي والرأسي. بينهما نسبة ٢ إلى ١ لأن خانة
// الطرفية أطول من عرضها بنحو الضعف، وهذا ما يبقي الحلقة مستديرة بدل أن
// تصير بيضوية.
ثابت مركزأفقي := 40.0
ثابت مركزرأسي := 12.0
ثابت مقياسأفقي := 30.0
ثابت مقياسرأسي := 15.0

// ---------------------------------------------------------------------------
// الهندسة
// ---------------------------------------------------------------------------

ثابت نصفصغير := 1.0 // نصف قطر المقطع الدائري للأنبوب
ثابت نصفكبير := 2.0 // المسافة من المبدأ إلى مركز الأنبوب
ثابت بعد := 5.0 // المسافة من العين إلى الحلقة

ثابت خطوةثيتا := 0.07 // الخطوة على المقطع
ثابت خطوةفاي := 0.02 // الخطوة حول الحلقة
ثابت دورة := 6.28 // donut.c يقف قبيل دورة كاملة ٢ باي

// ---------------------------------------------------------------------------
// التحريك
// ---------------------------------------------------------------------------

ثابت خطوةأ := 0.04 // في donut.c: كل نبضة A += 0.04 (دوران حول س)
ثابت خطوةب := 0.02 // في donut.c: كل نبضة B += 0.02 (دوران حول ع)
ثابت لفة := 26.0 // عدد النبضات بين الإطارات التي نطبعها فعلا
ثابت إطارات := 6 // ٦ × ٢٦ × ٠٫٠٤ دورة كاملة حول س

// ---------------------------------------------------------------------------
// مخازن الإطار - يحفظهما donut.c مصفوفتين مسطحتين ونفعل مثله. «إضاءة» تحمل
// لكل خانة فهرسا في «سلم»، أو -١ بمعنى «لم يرسم هنا شيء».
// ---------------------------------------------------------------------------

متغير إضاءة: صحيح[خلايا]
متغير عمق: عشري٦٤[خلايا]

// وهو memset(b, 32, 1760) و memset(z, 0, 7040) في donut.c
دالة مسح:
    كرر خلايا مع i:
        إضاءة[i] = -1
        عمق[i] = 0.0
    نهاية
نهاية

// رسم الحلقة كلها لزوج من زوايا الدوران، مع مخزن عمق كي يحجب نصف الأنبوب
// القريب نصفه البعيد.
دالة رسم(زاويةأ: عشري٦٤, زاويةب: عشري٦٤):
    جيبأ := ریاضیات.جیب(زاويةأ)
    جتمامأ := ریاضیات.جیب تمام(زاويةأ)
    جيبب := ریاضیات.جیب(زاويةب)
    جتمامب := ریاضیات.جیب تمام(زاويةب)

    متغير ثيتا := 0.0
    بينما ثيتا < دورة:
        جيبث := ریاضیات.جیب(ثيتا)
        جتمامث := ریاضیات.جیب تمام(ثيتا)

        // دائرة المقطع قبل أن تكنس حول محور ص
        دائرةأفقي := نصفكبير + نصفصغير * جتمامث
        دائرةرأسي := نصفصغير * جيبث

        متغير فاي := 0.0
        بينما فاي < دورة:
            جيبف := ریاضیات.جیب(فاي)
            جتمامف := ریاضیات.جیب تمام(فاي)

            // مقلوب ع للنقطة بعد الدوران. كلما كبر اقتربت النقطة من العين،
            // وهذا بالضبط ما يجعله صالحا مفتاحا للعمق أدناه.
            مقلوبعمق := 1.0 / (جيبف * دائرةأفقي * جيبأ + دائرةرأسي * جتمامأ + بعد)

            // التعبير الجزئي المشترك الذي يسميه donut.c بـ t: مركبة ص للنقطة
            // بعد تطبيق أ
            وسيط := جيبف * دائرةأفقي * جتمامأ - دائرةرأسي * جيبأ

            نقطةأفقي := (مركزأفقي + مقياسأفقي * مقلوبعمق * (جتمامف * دائرةأفقي * جتمامب - وسيط * جيبب)) بوصفه صحيح
            نقطةرأسي := (مركزرأسي + مقياسرأسي * مقلوبعمق * (جتمامف * دائرةأفقي * جيبب + وسيط * جتمامب)) بوصفه صحيح

            // الضرب القياسي للعمودي على السطح في اتجاه الضوء (٠، ١، −١)،
            // مضروبا في ٨ ليقع على السلم ذي الاثنتي عشرة درجة. السالب يعني
            // أن الرقعة تولي الضوء ظهرها، وdonut.c يثبته عند الصفر.
            سطوع := (8.0 * ((جيبث * جيبأ - جيبف * جتمامث * جتمامأ) * جتمامب - جيبف * جتمامث * جيبأ - جيبث * جتمامأ - جتمامف * جتمامث * جيبب)) بوصفه صحيح

            إذا نقطةرأسي > 0 && نقطةرأسي < ارتفاع && نقطةأفقي > 0 && نقطةأفقي < عرض:
                موضع := نقطةأفقي + عرض * نقطةرأسي
                إذا مقلوبعمق > عمق[موضع]:
                    عمق[موضع] = مقلوبعمق
                    إذا سطوع > 0:
                        إضاءة[موضع] = سطوع
                    وإلا:
                        إضاءة[موضع] = 0
                    نهاية
                نهاية
            نهاية

            فاي = فاي + خطوةفاي
        نهاية

        ثيتا = ثيتا + خطوةثيتا
    نهاية
نهاية

// وهي حلقة putchar في donut.c. تقتطع الفراغات الأخيرة كي تسهل مقارنة
// الإطارات.
دالة طباعة:
    كرر ارتفاع مع صف:
        متغير سطر := ""
        كرر عرض مع عمود:
            فهرس := إضاءة[صف * عرض + عمود]
            إذا فهرس < 0:
                سطر = سطر.دمج(" ")
            وإلا:
                سطر = سطر.دمج(سلم.مقطع(فهرس, 1))
            نهاية
        نهاية
        اطبع نص.اقتطاع یمین(سطر)
    نهاية
نهاية

دالة الرئیسیة:
    كرر إطارات مع ك:
        اطبع "-- إطار", ك
        مسح()
        رسم((ك بوصفه عشري٦٤) * خطوةأ * لفة, (ك بوصفه عشري٦٤) * خطوةب * لفة)
        طباعة()
    نهاية
نهاية
