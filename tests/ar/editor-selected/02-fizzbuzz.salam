//! وضع: برنامج | عنوان: فيزباز
// لغة: العربية
دالة الرئیسیة:
    كرر 1 إلى 15 مع i:
        إذا i % 15 == 0: اطبع "فيزباز"
        وإلا i % 3 == 0: اطبع "فيز"
        وإلا i % 5 == 0: اطبع "باز"
        وإلا:
            اطبع i
        نهاية
    نهاية
نهاية
