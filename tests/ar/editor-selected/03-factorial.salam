//! وضع: برنامج | عنوان: مضروب
// لغة: العربية
دالة مضروب(ن: صحیح): صحیح:
    إذا ن <= 1: أرجع 1 نهاية
    أرجع ن * مضروب(ن - 1)
نهاية

دالة الرئیسیة:
    كرر 1 إلى 6 مع i:
        اطبع i, "! =", مضروب(i)
    نهاية
نهاية
