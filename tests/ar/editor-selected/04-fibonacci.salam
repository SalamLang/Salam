//! وضع: برنامج | عنوان: فيبوناتشي
// لغة: العربية
دالة فیب(ن: صحیح): صحیح:
    إذا ن < 2: أرجع ن نهاية
    أرجع فیب(ن - 1) + فیب(ن - 2)
نهاية

دالة الرئیسیة:
    متغير سطر := ""
    كرر 12 مع i: سطر = سطر + فیب(i) + " " نهاية
    اطبع "فيبوناتشي:", سطر
نهاية
