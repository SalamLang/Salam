//! وضع: برنامج | عنوان: عكس النص
// لغة: العربية
دالة الرئیسیة:
    س := "Salam"
    متغير ر := ""
    متغير i := س.طول() - 1
    بينما i >= 0:
        ر = ر.دمج(س.مقطع(i, 1))
        i = i - 1
    نهاية
    اطبع "عكس", س, "هو", ر
نهاية
