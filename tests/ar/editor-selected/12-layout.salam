//! وضع: تخطيط | عنوان: صفحة وب
// لغة: العربية
صفحة:
    لقب = "برنامجي"
    لغة = "عربیة"
    اتجاه = "من الیمین إلى الیسار"
    ترويسة:
        خلفية = "أزرق"
        لون = "أبیض"
        حشو = "24px"
        عنوان: حجم = 1 محتوى = "مرحبا بك في سلام" نهاية
    نهاية
    صندوق:
        حشو = "20px"
        فقرة: محتوى = "أُنشئت هذه الصفحة من كود سلام." نهاية
    نهاية
نهاية
