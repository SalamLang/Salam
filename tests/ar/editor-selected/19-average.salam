//! وضع: برنامج | عنوان: المعدل
// لغة: العربية
دالة الرئیسیة:
    م := [10, 20, 30, 40, 50, 60] بوصفه صحیح[6]
    متغير مجموع := 0
    كرر 6 مع i: مجموع = مجموع + م[i] نهاية
    معدل := (مجموع بوصفه عشری٦٤) / 6.0
    اطبع "المجموع =", مجموع
    اطبع "المعدل =", معدل
نهاية
