//! وضع: برنامج | عنوان: جدول الضرب
// لغة: العربية
دالة الرئیسیة:
    كرر 1 إلى 5 مع i:
        متغير سطر := ""
        كرر 1 إلى 5 مع j: سطر = سطر + (i * j) + " " نهاية
        اطبع سطر
    نهاية
نهاية
