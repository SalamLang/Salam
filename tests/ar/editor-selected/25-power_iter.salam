//! وضع: برنامج | عنوان: الأس الصحيح
// لغة: العربية
دالة أس(أساس: صحیح, قوة: صحیح): صحیح:
    متغير نتیجة := 1
    كرر قوة مع i: نتیجة = نتیجة * أساس نهاية
    أرجع نتیجة
نهاية

دالة الرئیسیة:
    كرر 0 إلى 8 مع e:
        اطبع "٢ أس", e, "=", أس(2, e)
    نهاية
نهاية
