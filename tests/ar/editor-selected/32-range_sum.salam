//! وضع: برنامج | عنوان: مجموع المدى
// لغة: العربية
دالة الرئیسیة:
    ن := 100
    متغير مجموع := 0
    كرر 1 إلى ن مع i: مجموع = مجموع + i نهاية
    صیغة := ن * (ن + 1) / 2
    اطبع "مجموع الحلقة =", مجموع
    اطبع "مجموع الصيغة =", صیغة
نهاية
