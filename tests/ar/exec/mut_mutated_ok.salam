// لغة: العربية
دالة الرئیسیة:
    متغير أول := 1
    أول = 2
    اطبع أول

    متغير ثان := 5
    إذا ثان > 3:
        ثان = 30
    نهاية
    اطبع ثان

    متغير مجموع := 0
    كرر 4 مع عداد:
        مجموع += عداد
    نهاية
    اطبع مجموع

    متغير ثالث := 9
    ثالث++
    اطبع ثالث
نهاية
