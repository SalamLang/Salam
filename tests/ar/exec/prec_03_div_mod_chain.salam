// لغة: العربية
دالة الرئیسیة:
    أ := 20
    ب := 6
    ج := 4

    اطبع أ / ب * ج
    اطبع أ / (ب * ج)
    اطبع أ % ب * ج
    اطبع أ % (ب * ج)
نهاية
