// لغة: العربية
دالة الرئیسیة:
    أ := 2
    ب := 3
    ج := 4
    د := 5

    اطبع أ + ب < ج * د
    اطبع (أ + ب) < (ج * د)
    اطبع أ - ب > ج - د
    اطبع أ * ب >= ج + د
نهاية
