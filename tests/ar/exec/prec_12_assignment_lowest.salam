// لغة: العربية
دالة الرئیسیة:
    أ := 2
    ب := 3
    ج := 4
    د := 5

    متغير ر := خطأ
    ر = أ < ب || ج > د
    اطبع ر

    متغير س := 0
    س = أ + ب * ج
    اطبع س
نهاية
