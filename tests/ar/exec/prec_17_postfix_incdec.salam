// لغة: العربية
دالة الرئیسیة:
    متغير ن := 3
    اطبع -ن++
    اطبع ن

    متغير م := 3
    اطبع -(--م)
    اطبع م

    ح := 2
    متغير ک := 3
    اطبع ح ** ک++
    اطبع ک
نهاية
