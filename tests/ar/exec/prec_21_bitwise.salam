// لغة: العربية
دالة الرئیسیة:
    اطبع 1 | 2 & 3
    اطبع (1 | 2) & 3
    اطبع 12 ^ 10 & 6
    اطبع (12 ^ 10) & 6
    اطبع 1 << 4 + 1
    اطبع (1 << 4) + 1
    اطبع 96 >> 2 * 2
    اطبع (96 >> 2) * 2
    اطبع 1 << 2 | 1
    اطبع 3 & 1 << 2
    اطبع ~3 & 15
    اطبع ~(3 & 15)
    اطبع 1 << 3 > 4
    اطبع 16 >> 2 == 4
    اطبع ((5 & 4) != 0) && ((5 & 1) != 0)
نهاية
