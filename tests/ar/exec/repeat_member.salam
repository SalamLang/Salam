// لغة: العربية
// حد الحلقة المنتهي بوصول إلى حقل يجب أن يتوقف قبل «مع»، وإلا ابتلع
// اسم الحقل متغير العداد.

بنية شبكة:
    عام صفوف: صحیح
    عام أعمدة: صحیح
نهاية

بنية لوحة:
    عام حجم: شبكة
    عام أدنى: صحیح
    عام أعلى: صحیح
    عام قفزة: صحیح
نهاية

دالة الرئیسیة:
    ش := شبكة { صفوف = 3, أعمدة = 2 }
    متغير أ := ""
    كرر ش.صفوف مع ک:
        أ = أ + ک
    نهاية
    اطبع أ

    ل := لوحة { حجم = ش, أدنى = 1, أعلى = 4, قفزة = 2 }
    متغير ب := ""
    كرر ل.حجم.أعمدة مع ک:
        ب = ب + ک
    نهاية
    اطبع ب

    متغير ج := ""
    كرر ل.أدنى إلى ل.أعلى مع ک:
        ج = ج + ک
    نهاية
    اطبع ج

    متغير د := ""
    كرر ل.أدنى إلى ل.أعلى خطوة ل.قفزة مع ک:
        د = د + ک
    نهاية
    اطبع د
نهاية
