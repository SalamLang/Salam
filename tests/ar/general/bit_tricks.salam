// لغة: العربية
دالة عدد البتات(ن: صحیح): صحیح:
    متغير س := ن
    متغير عد := 0
    بينما س != 0:
        س = س & (س - 1)
        عد = عد + 1
    نهاية
    أرجع عد
نهاية

دالة عدد بسيط(ن: صحیح): صحیح:
    متغير س := ن
    متغير عد := 0
    بينما س > 0:
        عد = عد + (س & 1)
        س = س >> 1
    نهاية
    أرجع عد
نهاية

دالة قوة اثنين(ن: صحیح): منطقی:
    أرجع ن != 0 && (ن & (ن - 1)) == 0
نهاية

دالة زوجي(ن: صحیح): منطقی:
    أرجع (ن & 1) == 0
نهاية

دالة أدنى بت(ن: صحیح): صحیح:
    أرجع ن & (0 - ن)
نهاية

دالة القيمة المطلقة(س: صحیح): صحیح:
    م := س >> 31
    أرجع (س + م) ^ م
نهاية

دالة الرئیسیة:
    متغير أعداد := ""
    كرر 12 مع فهرس:
        أعداد = أعداد + عدد البتات((1 << فهرس) - 1) + " "
    نهاية
    اطبع أعداد

    متغير متطابق := صواب
    متغير ك := 0
    بينما ك < 300:
        إذا عدد البتات(ك) != عدد بسيط(ك):
            متطابق = خطأ
        نهاية
        ك = ك + 1
    نهاية
    اطبع "الطريقتان متطابقتان:", متطابق

    اطبع عدد البتات(0), عدد البتات(255), عدد البتات(-1)

    متغير قوى := ""
    كرر 10 مع فهرس:
        قوى = قوى + قوة اثنين(فهرس) + " "
    نهاية
    اطبع قوى

    اطبع زوجي(0), زوجي(7), زوجي(-8)
    اطبع أدنى بت(12), أدنى بت(8), أدنى بت(0)
    اطبع القيمة المطلقة(7), القيمة المطلقة(-7), القيمة المطلقة(0)

    // التبديل بالياء الحصرية بدون متغير مساعد
    متغير ب := 0x1234
    متغير ق := 0xABCD
    ب ^= ق
    ق ^= ب
    ب ^= ق
    اطبع ب, ق
نهاية
