// لغة: العربية
دالة الرئیسیة:
    اطبع 0 & 0, 0 & 1, 1 & 0, 1 & 1
    اطبع 0 | 0, 0 | 1, 1 | 0, 1 | 1
    اطبع 0 ^ 0, 0 ^ 1, 1 ^ 0, 1 ^ 1
    اطبع ~0, ~1, ~127, ~(-1)

    الف := 0b1100
    ب := 0b1010
    اطبع الف & ب, الف | ب, الف ^ ب
    اطبع الف & ~ب, ~الف & ب

    س := 0x5A5A
    اطبع س & 0, س & (-1), س | 0, س | (-1)
    اطبع س ^ 0, س ^ س, (س ^ (-1)) == ~س

    اطبع ~(الف & ب) == (~الف | ~ب)
    اطبع ~(الف | ب) == (~الف & ~ب)

    م := 1234
    ن := 5678
    اطبع (م ^ ن) + ((م & ن) * 2) == م + ن
    اطبع (م | ن) + (م & ن)

    اطبع 0xFF & 0b11110000, 0b101 | 0x0A
نهاية
