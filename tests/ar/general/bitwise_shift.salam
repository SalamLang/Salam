// لغة: العربية
دالة يسار(س: صحیح, ن: صحیح): صحیح:
    أرجع س << ن
نهاية

دالة يمين(س: صحیح, ن: صحیح): صحیح:
    أرجع س >> ن
نهاية

دالة الرئیسیة:
    متغير سطر := ""
    كرر 16 مع فهرس:
        سطر = سطر + (1 << فهرس) + " "
    نهاية
    اطبع سطر

    اطبع 3 << 0, 3 << 1, 3 << 4, 3 << 10
    اطبع (3 << 10) == 3 * 1024
    اطبع 1024 >> 0, 1024 >> 1, 1024 >> 4, 1024 >> 10
    اطبع -1 >> 1, -2 >> 1, -8 >> 2, -9 >> 1
    اطبع -1024 >> 4, -1024 / 16

    // الإزاحة أضعف من + و - وأقوى من المقارنات
    اطبع 1 << 4 + 1, (1 << 4) + 1
    اطبع 64 >> 2 + 1, (64 >> 2) + 1
    اطبع 1 << 3 > 4, 16 >> 2 == 4

    // وأقوى من & ^ |
    اطبع 1 << 2 | 1, 3 & 1 << 2, 6 ^ 1 << 1

    اطبع يسار(1, 30), يمين(1073741824, 30)
    اطبع يسار(-1, 4), يمين(-16, 4)

    متغير مركب := 0
    مركب = مركب | (0xAB << 8)
    مركب = مركب | 0xCD
    اطبع مركب, مركب >> 8, مركب & 0xFF

    متغير ف := 0
    ف |= 5
    ف &= 6
    ف ^= 1
    ف <<= 2
    ف >>= 1
    اطبع ف
نهاية
