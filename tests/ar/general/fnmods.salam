// لغة: العربية
ثابت عشرة := 10

متغير معامل := 2

// دوال البنية تقبل نفس سوابق الدوال
عام بنية مقیاسي:
    عام قیمة: صحیح = 0

    عام مضمن دالة قیمة حالیة(): صحیح: أرجع هذا.قیمة نهاية

    عام مضمن نقي دالة ضعف(): صحیح: أرجع هذا.قیمة * 2 نهاية

    عام غيرمضمن دالة أضف(مقدار: صحیح): هذا.قیمة = هذا.قیمة + مقدار نهاية
نهاية

غيرمضمن دالة ثلاثة(قیمة: صحیح): صحیح: أرجع قیمة * 3 نهاية

عام نقي دالة جمع صافی(أ: صحیح, ب: صحیح): صحیح: أرجع أ + ب نهاية

عام نقي دالة مقیاس(قیمة: صحیح): صحیح: أرجع قیمة * معامل + عشرة نهاية

عام مضمن دالة زیادة(قیمة: صحیح): صحیح:
    معامل = معامل + 1
    أرجع قیمة + معامل
نهاية

عام مهجور دالة قدیم(قیمة: صحیح): صحیح: أرجع قیمة + 1 نهاية

دالة الرئیسیة:
    اطبع جمع صافی(1, 2)
    اطبع ثلاثة(2)
    اطبع قدیم(9)
    اطبع مقیاس(3)
    اطبع زیادة(1)
    متغير عداد := مقیاسي {}
    عداد.أضف(7)
    اطبع عداد.قیمة حالیة()
    اطبع عداد.ضعف()
نهاية
