// لغة: العربية
دالة الرئیسیة:
    اعداد := [1, 2, 3] بوصفه صحیح[3]
    اعداد[0] = 10
    اعداد[1]++
    اطبع اعداد[0]
    اطبع اعداد[1]

    متغير عدد := 5
    عدد = 6
    اطبع عدد

    ثابت ث := [7, 8, 9] بوصفه صحیح[3]
    اطبع ث[2]
نهاية
