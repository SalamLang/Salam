استيراد تعبیر نمطی

دالة استخرج_العنوان(نص_م: نص): نص:
    إذا !تعبیر نمطی.مطابقةنص("<title>.*</title>", نص_م):
        أرجع ""
    نهاية
    خطوة1 := تعبیر نمطی.استبدالنص(".*<title>", نص_م, "")
    أرجع تعبیر نمطی.استبدالنص("</title>.*", خطوة1, "")
نهاية

دالة اطبع_الروابط(نص_م: نص):
    متغير باقی := نص_م
    متغير نشط := صواب
    بينما نشط:
        الفهرس := تعبیر نمطی.بحثنص("href=\"", باقی)
        إذا الفهرس < 0:
            نشط = خطأ
        وإلا:
            بعد := الفهرس + 6
            ذیل := باقی.مقطع(بعد, باقی.طول() - بعد)
            نهایةالاقتباس := تعبیر نمطی.بحثنص("\"", ذیل)
            إذا نهایةالاقتباس < 0:
                نشط = خطأ
            وإلا:
                اطبع ذیل.مقطع(0, نهایةالاقتباس)
                تقدم := بعد + نهایةالاقتباس + 1
                باقی = باقی.مقطع(تقدم, باقی.طول() - تقدم)
            نهاية
        نهاية
    نهاية
نهاية

دالة الرئیسیة:
    الصفحة := "<html><head><title>Salam Lang Docs</title></head><body>hi</body></html>"
    اطبع استخرج_العنوان(الصفحة)

    بدون_عنوان := "<html><body>no title here</body></html>"
    اطبع استخرج_العنوان(بدون_عنوان)

    الروابط := "<a href=\"https://salamlang.org\">Home</a><a href=\"https://salamlang.org/docs\">Docs</a><a href=\"/about\">About</a>"
    اطبع_الروابط(الروابط)

    البرید := "contact: ada@example.com or grace@example.org"
    اطبع تعبیر نمطی.مطابقةنص("\\w+@\\w+\\.\\w+", البرید)
    اطبع تعبیر نمطی.بحثنص("@", البرید) > 0

    الأرقام_فقط := تعبیر نمطی.استبدالالکلنص("[0-9]", "room 42, floor 7", "")
    اطبع الأرقام_فقط

    السیإسڤی := "name,age,city"
    اطبع تعبیر نمطی.استبدالالکلنص(",", السیإسڤی, " | ")
نهاية
