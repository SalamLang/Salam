// لغة: العربية
دالة الرئیسیة:
    نص := "salam"
    متغير عد := 0
    كرر 5 مع فهرس:
        إذا نص[فهرس] == 'a': عد = عد + 1 نهاية
    نهاية
    اطبع عد
نهاية
