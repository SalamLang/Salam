// لغة: العربية
//
// سواغر بالعربية: المسارات تُقرأ من الموجه والمخططات من نوع البيانات، فتنتج
// وثيقة OpenAPI دون كتابة أي مخطط باليد.
استيراد شبکة.موجه الشبکة
استيراد شبکة.HTTP للشبکة.سواغر
استيراد ترمیز.جیسون

@doc "عنصر واحد في القائمة"
بنية مهمة:
    @doc "یُعطى عند الإنشاء"
    عام معرف: صحيح٦٤ = 0 بوصفه صحيح٦٤
    @doc "ما الذي یجب عمله"
    عام عنوان: نص = ""
    @json "" "omitempty"
    عام ملاحظة: نص = ""
نهاية

بنية طلب:
    عام عنوان: نص = ""
نهاية

دالة سرد المهام(_سیاق: صحيح٦٤): أرجع نهاية
دالة إنشاء مهمة(_سیاق: صحيح٦٤): أرجع نهاية
دالة مهمة واحدة(_سیاق: صحيح٦٤): أرجع نهاية
دالة الصحة(_سیاق: صحيح٦٤): أرجع نهاية

دالة الرئیسیة:
    متغير موجه := موجه الشبکة.موجه جدید()
    موجه الشبکة.جلب(موجه, "/api/todos", سرد المهام)
    موجه الشبکة.إرسال(موجه, "/api/todos", إنشاء مهمة)
    موجه الشبکة.جلب(موجه, "/api/todos/:id", مهمة واحدة)
    موجه الشبکة.جلب(موجه, "/health", الصحة)

    متغير وثیقة := سواغر.جدید("قائمة المهام", "1.0.0")
    سواغر.وصف(وثیقة, "قائمة مهام عبر HTTP")
    سواغر.خادم(وثیقة, "http://127.0.0.1:8090", "محلي")
    سواغر.مصادقة الحامل(وثیقة, "bearer", "JWT")

    // كل مسار مسجل في الموجه، سواء وُصف أم لا.
    سواغر.مسح(وثیقة, موجه)

    _أ := سواغر.عند(وثیقة, "GET", "/api/todos")
    سواغر.وسم(وثیقة, "المهام")
    سواغر.ملخص(وثیقة, "سرد المهام")
    سواغر.استعلام(وثیقة, "status", "الكل أو مفتوح أو منجز", خطأ)
    سواغر.یرجع(وثیقة, 200, "كل المهام", متجه {} بوصفه متجه<مهمة>)

    _ب := سواغر.عند(وثیقة, "POST", "/api/todos")
    سواغر.وسم(وثیقة, "المهام")
    سواغر.ملخص(وثیقة, "إنشاء مهمة")
    سواغر.مؤمن(وثیقة, "bearer")
    سواغر.یقبل(وثیقة, "المهمة المراد إنشاؤها", طلب {})
    سواغر.یرجع(وثیقة, 201, "المهمة مع معرفها", مهمة {})
    سواغر.یرجع ترویسة(وثیقة, 201, "Location", "عنوان المهمة الجدیدة")

    مواصفات := سواغر.مواصفات(وثیقة)
    اطبع جیسون.صالح(مواصفات)
    اطبع جیسون.جلب(مواصفات, "openapi")

    مسارات := جیسون.جلب(مواصفات, "paths")
    مفاتیح := جیسون.مفاتیح(مسارات)
    أجل مفاتیح.حرر()
    كرر مفاتیح.طول() مع ن:
        اطبع مفاتیح.احصل(ن)
    نهاية

    مخططات := جیسون.جلب(جیسون.جلب(مواصفات, "components"), "schemas")
    // الوصف العربي وصل من @doc إلى الوثيقة.
    اطبع جیسون.جلب(جیسون.جلب(مخططات, "مهمة"), "description")
    اطبع جیسون.جلب(مخططات, "مهمة")

    مشاكل := سواغر.مشاكل(وثیقة)
    أجل مشاكل.حرر()
    اطبع مشاكل.طول()
    غیر موثق := سواغر.غیر موثق(وثیقة)
    أجل غیر موثق.حرر()
    كرر غیر موثق.طول() مع م:
        اطبع غیر موثق.احصل(م)
    نهاية
    سواغر.تحریر(وثیقة)
نهاية
