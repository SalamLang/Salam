// لغة: العربية
استيراد یامل

دالة الرئیسیة:
    اطبع یامل.نص یامل("hi \"there\"")
    اطبع یامل.عضو("name", "salam")
    اطبع یامل.عضو عدد صحیح("age", 5)
    اطبع یامل.عضو منطقی("ok", صواب)
    اطبع یامل.عضو عدد عشری("pi", 3.5)
    اطبع یامل.عضو خام("raw", "[1, 2, 3]")

    متغير علامات := متجه {} بوصفه متجه<نص>
    علامات.أضف(یامل.نص یامل("a"))
    علامات.أضف(یامل.نص یامل("b"))
    علامات_یامل := یامل.مصفوفة(علامات)
    اطبع علامات_یامل

    متغير نقطة := متجه {} بوصفه متجه<نص>
    نقطة.أضف(یامل.عضو عدد صحیح("x", 1))
    نقطة.أضف(یامل.عضو عدد صحیح("y", 2))
    نقطة_یامل := یامل.کائن(نقطة)
    اطبع نقطة_یامل

    متغير مستند := متجه {} بوصفه متجه<نص>
    مستند.أضف(یامل.عضو("name", "salam"))
    مستند.أضف(یامل.عضو عدد صحیح("version", 2))
    مستند.أضف(یامل.عضو منطقی("active", صواب))
    مستند.أضف(یامل.عضو خام("tags", علامات_یامل))
    مستند.أضف(یامل.عضو خام("point", نقطة_یامل))
    مستند_یامل := یامل.کائن(مستند)
    اطبع مستند_یامل

    کتلة := "name: salam\nversion: 2\nactive: true\ntags:\n  - a\n  - b\npoint:\n  x: 1\n  y: 2\n"
    اطبع یامل.تحلیل(کتلة)
    اطبع یامل.لجیسون(کتلة) == یامل.تحلیل(کتلة)

    اطبع یامل.صالح(کتلة)
    اطبع یامل.صالح("{ not: valid")
    اطبع یامل.صالح("[1, 2")
    اطبع یامل.صالح("\"unterminated")

    اطبع یامل.جلب(کتلة, "name")
    اطبع یامل.جلب عدد صحیح(کتلة, "version")
    اطبع یامل.جلب منطقی(کتلة, "active")
    اطبع یامل.جلب(کتلة, "tags[0]")
    اطبع یامل.جلب(کتلة, "tags[1]")
    اطبع یامل.جلب عدد صحیح(کتلة, "point.x")
    اطبع یامل.جلب عدد صحیح(کتلة, "point.y")
    اطبع یامل.یملک(کتلة, "point.y")
    اطبع یامل.یملک(کتلة, "missing")
    اطبع یامل.نوع (کتلة, "tags")
    اطبع یامل.نوع (کتلة, "point")
    اطبع یامل.نوع (کتلة, "name")
    اطبع یامل.نوع (کتلة, "version")
    اطبع یامل.نوع (کتلة, "missing")
    اطبع یامل.طول(کتلة, "tags")

    متغير مطلوب := متجه {} بوصفه متجه<نص>
    مطلوب.أضف("name")
    مطلوب.أضف("version")
    اطبع یامل.یملک مفاتیح(کتلة, مطلوب)
    مطلوب.أضف("missing")
    اطبع یامل.یملک مفاتیح(کتلة, مطلوب)

    تدفق := "{a: 1, b: [1, 2, 3], c: {x: true, y: null}}"
    اطبع یامل.تحلیل(تدفق)

    اقتباس := "title: 'it''s here'\nurl: \"http://x:80/a#b\"\n"
    اطبع یامل.تحلیل(اقتباس)

    کتلة_نص := "desc: |\n  line one\n  line two\nfolded: >\n  a b\n  c d\n"
    اطبع یامل.تحلیل(کتلة_نص)

    قائمة := "items:\n  - name: a\n    val: 1\n  - name: b\n    val: 2\n"
    اطبع یامل.تحلیل(قائمة)
    اطبع یامل.جلب(قائمة, "items[1].name")
    اطبع یامل.جلب عدد صحیح(قائمة, "items[0].val")

    متعدد_المستندات := "a: 1\n---\nb: 2\n"
    مستندات := یامل.تقسیم المستندات(متعدد_المستندات)
    اطبع مستندات.طول()
    اطبع یامل.تحلیل(مستندات.احصل(0)[0])
    اطبع یامل.تحلیل(مستندات.احصل(1)[0])

    اطبع یامل.تفریغ(مستند_یامل)
    اطبع یامل.تفریغ مخصص(مستند_یامل, "    ")
    اطبع یامل.تفریغ بتاب(مستند_یامل)

    اطبع یامل.تحلیل(یامل.تفریغ(کتلة)) == یامل.تحلیل(کتلة)
نهاية
