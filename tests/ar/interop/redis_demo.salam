// لغة: العربية
استيراد قاعدة بیانات.ردیس

دالة الرئیسیة:
    ک := ردیس.اتصال("127.0.0.1", 6379)
    إذا ردیس.صالح(ک):
        اطبع "تم الاتصال بردیس، بينغ:", ردیس.بینغ(ک)

        ردیس.تعیین(ک, "salam:example:ar:greeting", "مرحبا من سلام")
        اطبع ردیس.جلب(ک, "salam:example:ar:greeting")

        ردیس.إزالة(ک, "salam:example:ar:visits")
        ردیس.زیادة(ک, "salam:example:ar:visits")
        ردیس.زیادة(ک, "salam:example:ar:visits")
        n := ردیس.زیادة(ک, "salam:example:ar:visits")
        اطبع "عدد الزیارات:", n

        ردیس.إزالة(ک, "salam:example:ar:fruits")
        ردیس.إضافة لنهایة القائمة(ک, "salam:example:ar:fruits", "تفاح")
        ردیس.إضافة لنهایة القائمة(ک, "salam:example:ar:fruits", "موز")
        ردیس.إضافة لنهایة القائمة(ک, "salam:example:ar:fruits", "كرز")
        الفواکه := ردیس.مدى القائمة(ک, "salam:example:ar:fruits", 0, 0 - 1)
        اطبع "الفواكه:"
        كرر الفواکه.طول() مع i:
            اطبع "  -", الفواکه.احصل(i)[0]
        نهاية

        ردیس.إزالة(ک, "salam:example:ar:greeting")
        ردیس.إزالة(ک, "salam:example:ar:visits")
        ردیس.إزالة(ک, "salam:example:ar:fruits")
        ردیس.إغلاق(ک)
    وإلا:
        اطبع "تعذر الاتصال بردیس:", ردیس.خطأ(ک)
    نهاية
نهاية
