// لغة: العربية
استيراد دوم

دالة الرئیسیة:
    عنصر := دوم.أنشئ("span")
    دوم.إلحاق(دوم.الجسم(), عنصر)
    دوم.تعیین السمة(عنصر, "data-role", "tag")
    اطبع دوم.جلب السمة(عنصر, "data-role")

    دوم.إضافة فئة(عنصر, "card")
    دوم.إضافة فئة(عنصر, "big")
    اطبع دوم.جلب السمة(عنصر, "class")

    دوم.تبدیل فئة(عنصر, "big")
    اطبع دوم.جلب السمة(عنصر, "class")

    دوم.تبدیل فئة(عنصر, "big")
    اطبع دوم.جلب السمة(عنصر, "class")

    دوم.إزالة فئة(عنصر, "card")
    اطبع دوم.جلب السمة(عنصر, "class")
نهاية
