// لغة: العربية
استيراد دوم

متغير عدد النقرات := 0

دالة الرئیسیة:
    زر := دوم.أنشئ("button")
    دوم.تعیین السمة(زر, "id", "btn")
    دوم.تعیین السمة(زر, "data-autofire", "click")
    دوم.إلحاق(دوم.الجسم(), زر)
    دوم.عند الحدث(
        زر, "click", (): عدد النقرات = عدد النقرات + 1 اطبع "clicked" نهاية
    )
    اطبع "before"
    اطبع عدد النقرات
نهاية
