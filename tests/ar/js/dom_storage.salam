// لغة: العربية
استيراد دوم

دالة الرئیسیة:
    دوم.تعیین عدد التخزین("count", 42)
    اطبع دوم.جلب عدد التخزین("count")
    دوم.تعیین نص التخزین("name", "salam")
    اطبع دوم.جلب نص التخزین("name")
    اطبع دوم.جلب عدد التخزین("missing")
    اطبع دوم.جلب نص التخزین("missing") == ""
نهاية
