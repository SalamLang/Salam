// لغة: العربية
استيراد دوم

دالة الرئیسیة:
    عنصر := دوم.أنشئ("div")
    دوم.إلحاق(دوم.الجسم(), عنصر)
    دوم.تعیین النمط(عنصر, "color", "red")
    دوم.تعیین النمط(عنصر, "font-size", "12px")
    اطبع دوم.جلب النمط(عنصر, "color")
    اطبع دوم.جلب النمط(عنصر, "font-size")
    دوم.تعیین النمط(عنصر, "color", "blue")
    اطبع دوم.جلب النمط(عنصر, "color")
نهاية
