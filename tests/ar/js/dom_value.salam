// لغة: العربية
استيراد دوم

دالة الرئیسیة:
    مدخل := دوم.أنشئ("input")
    دوم.إلحاق(دوم.الجسم(), مدخل)
    دوم.تعیین القیمة(مدخل, "hello")
    اطبع دوم.جلب القیمة(مدخل)
    دوم.تعیین القیمة(مدخل, "world")
    اطبع دوم.جلب القیمة(مدخل)
نهاية
