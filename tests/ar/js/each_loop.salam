// لغة: العربية
دالة الرئیسیة:
    أسماء := ["a", "b", "c"]
    كل س في أسماء:
        إذا س != "b":
            اطبع س
        نهاية
    نهاية
    أعداد := [10, 20, 30] بوصفه صحیح[3]
    متغير مجموع := 0
    كل س في أعداد:
        مجموع = مجموع + س
    نهاية
    اطبع مجموع
نهاية
