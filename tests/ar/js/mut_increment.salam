// لغة: العربية
دالة الرئیسیة:
    متغير قیمة := 0
    قیمة = قیمة + 1
    قیمة++
    قیمة += 5
    قیمة -= 2
    قیمة *= 3
    اطبع قیمة
    متغير آخر := 10
    آخر--
    اطبع آخر
نهاية
