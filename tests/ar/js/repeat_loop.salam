// لغة: العربية
دالة الرئیسیة:
    متغير ع := 0
    كرر 4:
        ع = ع + 1
    نهاية
    اطبع ع

    متغير صعود := ""
    كرر 1 إلى 5 مع ک:
        صعود = صعود + ک
    نهاية
    اطبع صعود

    متغير نزول := ""
    كرر 5 إلى 1 مع ک:
        نزول = نزول + ک
    نهاية
    اطبع نزول
نهاية
