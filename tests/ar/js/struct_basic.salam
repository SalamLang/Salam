// لغة: العربية
بنية عداد:
    قیمة: صحیح = 0
    عام دالة زیادة():
        هذا.قیمة = هذا.قیمة + 1
    نهاية
    عام دالة احصل(): صحیح:
        أرجع هذا.قیمة
    نهاية
نهاية

دالة الرئیسیة:
    متغير ع := عداد { قیمة = 5 }
    ع.زیادة()
    ع.زیادة()
    اطبع ع.احصل()
نهاية
