// لغة: العربية
دالة تصنیف(ن: صحیح): نص:
    أرجع ن < 0 ? "negative" : ن == 0 ? "zero" : "positive"
نهاية

دالة الرئیسیة:
    اطبع تصنیف(-4)
    اطبع تصنیف(0)
    اطبع تصنیف(9)
    س := 7
    اطبع س > 5 ? "big" : "small"
نهاية
