// لغة: العربية
دالة الرئیسیة:
    متغير ک := 0
    متغير مجموع := 0
    بينما ک < 5:
        مجموع = مجموع + ک
        ک = ک + 1
    نهاية
    اطبع مجموع
    اطبع ک
نهاية
