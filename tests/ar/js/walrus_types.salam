// لغة: العربية
دالة الرئیسیة:
    رقم := 7
    فاصلة := 2.5
    کلمة := "hi"
    علم := خطأ
    اطبع رقم
    اطبع فاصلة
    اطبع کلمة
    اطبع علم
    اطبع رقم + 1
    اطبع فاصلة + 1.0
نهاية
