// لغة: العربية
استيراد یامل

دالة الرئیسیة:
    الإعدادات := "app:\n  name: Salam\n  version: 3\n  debug: false\nservers:\n  - host: alpha.example.com\n    port: 8080\n  - host: beta.example.com\n    port: 8081\n"

    اطبع "صالح:", یامل.صالح(الإعدادات)
    اطبع "اسم التطبیق:", یامل.جلب(الإعدادات, "app.name")
    اطبع "نسخة التطبیق:", یامل.جلب عدد صحیح(الإعدادات, "app.version")
    اطبع "وضع التصحیح:", یامل.جلب منطقی(الإعدادات, "app.debug")
    اطبع "عدد الخوادم:", یامل.طول(الإعدادات, "servers")
    اطبع "مضیف الخادم الأول:", یامل.جلب(الإعدادات, "servers[0].host")
    اطبع "منفذ الخادم الثانی:", یامل.جلب عدد صحیح(الإعدادات, "servers[1].port")

    اطبع "--- کنص جيسون ---"
    اطبع یامل.لجیسون(الإعدادات)

    اطبع "--- يامل بصیغة معاد تنسیقها ---"
    اطبع یامل.تفریغ(الإعدادات)
نهاية
