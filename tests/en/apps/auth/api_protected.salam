package main


import crypto
import jwt
import net.http
import net.router
import encoding.json

const PORT := 8081

func guard(): jwt.Guard:
    mut g := jwt.NewGuard("dev-only-secret-change-me")
    g.opts.issuer = "jwt.example"
    g.opts.require_exp = true
    g.opts.leeway = 30 as i64
    ret g
end

func password_hash(email: str): str:
    if email == "sara@example.com": ret crypto.HashPassword("hunter2") end
    if email == "ali@example.com": ret crypto.HashPassword("salam") end
    ret ""
end

func send(ctx: i64, code: int, body: str):
    http.Ctx_status(ctx, code)
    http.Ctx_json(ctx, body)
end

func login(ctx: i64):
    body := http.Ctx_body(ctx)
    email := json.Get(body, "email")
    password := json.Get(body, "password")
    stored := password_hash(email)
    if stored.len() == 0 || !crypto.VerifyPassword(password, stored):
        send(ctx, 401, `{"error":"invalid credentials"}`)
        ret
    end
    mut c := jwt.NewClaims()
    c.sub = email
    jwt.SetStr(c, "name", display_name(email))
    mut err := 0
    token := jwt.Issue(guard(), c, 3600 as i64, err)
    if err != jwt.JWT_OK:
        send(ctx, 500, `{"error":"could not issue a token"}`)
        ret
    end
    send(ctx, 200, `{"token":"` + token + `","expires_in":3600}`)
end

func display_name(email: str): str:
    if email == "sara@example.com": ret "Sara" end
    ret "Ali"
end

func me(ctx: i64):
    mut t := jwt.Token {}
    if !jwt.Require(ctx, guard(), t): ret end
    send(ctx, 200, `{"sub":"` + t.claims.sub + `","name":"` + jwt.Str(t, "name") + `"}`)
end

func home(ctx: i64):
    mut err := 0
    t := jwt.Check(ctx, guard(), err)
    if err == jwt.JWT_OK:
        send(ctx, 200, `{"hello":"` + jwt.Str(t, "name") + `"}`)
        ret
    end
    send(ctx, 200, `{"hello":"stranger"}`)
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/", home)
    router.Post(r, "/login", login)
    router.Get(r, "/me", me)
    mut s := http.NewServer(PORT)
    http.Use(s, r)
    println "listening on http://localhost:8081"
    http.Run(s)
    ret 0
end
