package main

import crypto
import jwt
import conv
import net.http
import net.router
import encoding.json

const PORT := 8082
const ACCESS_TTL := 900
const REFRESH_TTL := 604800

func guard(): jwt.Guard:
    mut g := jwt.NewGuard("dev-only-secret-change-me")
    g.opts.issuer = "jwt.example"
    g.opts.require_exp = true
    ret g
end

func password_hash(email: str): str:
    if email == "sara@example.com": ret crypto.HashPassword("hunter2") end
    ret ""
end

func send(ctx: i64, code: int, body: str):
    http.Ctx_status(ctx, code)
    http.Ctx_json(ctx, body)
end

func issue_access(subject: str, err &: int): str:
    mut c := jwt.NewClaims()
    c.sub = subject
    jwt.SetStr(c, "kind", "access")
    jwt.SetStr(c, "scope", "profile:read")
    ret jwt.Issue(guard(), c, ACCESS_TTL as i64, err)
end

func issue_refresh(subject: str, err &: int): str:
    mut c := jwt.NewClaims()
    c.sub = subject
    jwt.SetStr(c, "kind", "refresh")
    c.jti = crypto.RandomHex(12)
    ret jwt.Issue(guard(), c, REFRESH_TTL as i64, err)
end

func login(ctx: i64):
    body := http.Ctx_body(ctx)
    email := json.Get(body, "email")
    stored := password_hash(email)
    if stored.len() == 0 || !crypto.VerifyPassword(json.Get(body, "password"), stored):
        send(ctx, 401, `{"error":"invalid credentials"}`)
        ret
    end
    mut err := 0
    access := issue_access(email, err)
    refresh_tok := issue_refresh(email, err)
    if err != jwt.JWT_OK:
        send(ctx, 500, `{"error":"could not issue tokens"}`)
        ret
    end
    send(ctx, 200, `{"access":"` + access + `","refresh":"` + refresh_tok + `","expires_in":900}`)
end

func refresh(ctx: i64):
    mut t := jwt.Token {}
    if !jwt.Require(ctx, guard(), t): ret end
    if jwt.Str(t, "kind") != "refresh":
        jwt.Forbidden(ctx, "this route needs a refresh token")
        ret
    end
    mut err := 0
    access := issue_access(t.claims.sub, err)
    if err != jwt.JWT_OK:
        send(ctx, 500, `{"error":"could not issue a token"}`)
        ret
    end
    send(ctx, 200, `{"access":"` + access + `","expires_in":900}`)
end

func me(ctx: i64):
    mut t := jwt.Token {}
    if !jwt.Require(ctx, guard(), t): ret end
    if jwt.Str(t, "kind") != "access":
        jwt.Forbidden(ctx, "this route needs an access token")
        ret
    end
    send(ctx, 200, `{"sub":"` + t.claims.sub + `","expires_at":` + expiry(t) + "}")
end

func expiry(t: jwt.Token): str:
    ret conv.FormatInt(t.claims.exp)
end

func main:
    mut r := router.NewRouter()
    router.Post(r, "/auth/login", login)
    router.Post(r, "/auth/refresh", refresh)
    router.Get(r, "/api/me", me)
    mut s := http.NewServer(PORT)
    http.Use(s, r)
    println "listening on http://localhost:8082"
    http.Run(s)
    ret 0
end
