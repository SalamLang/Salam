package main

// Reading a token you were handed - the jwt.io "debugger" view, in 60 lines.
//
//     salam run tests/en/apps/auth/jwt_inspect.salam
//
// This is the one place jwt.Decode belongs: showing a human what is inside a
// token. Decode checks NOTHING - not the signature, not the expiry - and the
// Token it returns always reports valid = false. The last section shows what
// that means in practice: a token signed by a stranger decodes perfectly.

import jwt

// A token from "somewhere else" - a client, a log line, a bug report.
const FOREIGN := "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"

func describe(token: str):
    mut err := 0
    t := jwt.Decode(token, err)
    if err != jwt.JWT_OK:
        println "not a readable token:", jwt.ErrorText(err)
        ret
    end
    println "header    :", t.header_json
    println "payload   :", t.payload_json
    println "alg       :", t.alg
    println "typ       :", t.typ
    if t.kid.len() > 0:
        // Which key signed it. Look a key up by this, and nothing else: it
        // is attacker-controlled like the rest of the header.
        println "kid       :", t.kid
    end
    println "issuer    :", t.claims.iss
    println "subject   :", t.claims.sub
    println "audience  :", t.claims.aud
    println "issued at :", t.claims.iat
    println "expires   :", t.claims.exp
    println "verified  :", t.valid
end

func rotation_example():
    // Two keys live at once during a rotation. The kid says which one to
    // reach for; the signature check still decides whether to believe it.
    mut c := jwt.NewClaims()
    c.sub = "user-7"
    c.exp = 2000000000 as i64
    mut err := 0
    token := jwt.SignWithKid(c, jwt.JWT_HS256, "2026-key", "the-new-key", err)
    peek := jwt.Decode(token, err)
    println "signed with kid:", peek.kid
    secret := key_for(peek.kid)
    if secret.len() == 0:
        println "unknown kid, refusing"
        ret
    end
    mut o := jwt.DefaultOptions()
    o.now = 1700000000 as i64
    t := jwt.Verify(token, secret, o, err)
    println "verified with that key:", t.valid
end

func key_for(kid: str): str:
    if kid == "2025-key": ret "the-old-key" end
    if kid == "2026-key": ret "the-new-key" end
    ret ""
end

func decode_is_not_verify():
    // Signed by someone who does not have our key at all.
    mut c := jwt.NewClaims()
    c.sub = "admin"
    c.exp = 2000000000 as i64
    mut err := 0
    forged := jwt.SignHS256(c, "an-attacker-secret", err)
    d := jwt.Decode(forged, err)
    println "decoded subject:", d.claims.sub
    println "decoded valid  :", d.valid
    mut o := jwt.DefaultOptions()
    o.now = 1700000000 as i64
    println "would verify   :", jwt.IsValid(forged, "our-real-secret", o)
end

func main:
    println "-- a token from elsewhere"
    describe(FOREIGN)
    println ""
    println "-- key rotation by kid"
    rotation_example()
    println ""
    println "-- Decode reads, it does not trust"
    decode_is_not_verify()
    ret 0
end
