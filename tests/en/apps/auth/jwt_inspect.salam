package main

import jwt

const FOREIGN := "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"

func describe(token: str):
    mut t := jwt.Token {}
    try:
        t = jwt.Decode(token)
    catch e:
        println "not a readable token:", e.message
        ret
    end
    println "header    :", t.header_json
    println "payload   :", t.payload_json
    println "alg       :", t.alg
    println "typ       :", t.typ
    if t.kid.Len() > 0:
        println "kid       :", t.kid
    end
    println "issuer    :", t.claims.iss
    println "subject   :", t.claims.sub
    println "audience  :", t.claims.aud
    println "issued at :", t.claims.iat
    println "expires   :", t.claims.exp
    println "verified  :", t.valid
end

func rotation_example() throws:
    mut c := jwt.NewClaims()
    c.sub = "user-7"
    c.exp = 2000000000 as i64
    token := try jwt.SignWithKid(c, jwt.JWT_HS256, "2026-key", "the-new-key")
    peek := try jwt.Decode(token)
    println "signed with kid:", peek.kid
    secret := key_for(peek.kid)
    if secret.Len() == 0:
        println "unknown kid, refusing"
        ret
    end
    mut o := jwt.DefaultOptions()
    o.now = 1700000000 as i64
    t := try jwt.Verify(token, secret, o)
    println "verified with that key:", t.valid
end

func key_for(kid: str): str:
    if kid == "2025-key": ret "the-old-key" end
    if kid == "2026-key": ret "the-new-key" end
    ret ""
end

func decode_is_not_verify() throws:
    mut c := jwt.NewClaims()
    c.sub = "admin"
    c.exp = 2000000000 as i64
    forged := try jwt.SignHS256(c, "an-attacker-secret")
    d := try jwt.Decode(forged)
    println "decoded subject:", d.claims.sub
    println "decoded valid  :", d.valid
    mut o := jwt.DefaultOptions()
    o.now = 1700000000 as i64
    println "would verify   :", jwt.IsValid(forged, "our-real-secret", o)
end

func main:
    println "-- a token from elsewhere"
    describe(FOREIGN)
    println ""
    try:
        println "-- key rotation by kid"
        rotation_example()
        println ""
        println "-- Decode reads, it does not trust"
        decode_is_not_verify()
    catch e:
        println "failed:", e.ToStr()
    end
    ret 0
end
