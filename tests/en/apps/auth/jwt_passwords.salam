package main

// The half of an auth layer that runs BEFORE a token exists: storing a
// password, checking one, and comparing a fixed secret without leaking it.
//
//     salam run tests/en/apps/auth/jwt_passwords.salam
//
// The hashes and secrets are random by design, so this prints properties
// (lengths, booleans, "are these two different") rather than the values.

import auth
import jwt

func check(label: str, got: bool, want: bool):
    if got == want:
        println label, "ok"
    else:
        println label, "UNEXPECTED"
    end
end

func passwords():
    // What goes in the database. The salt and iteration count travel inside
    // the string, so this one column is the whole record.
    stored := auth.HashPassword("correct horse battery staple")
    check("right password :", auth.VerifyPassword("correct horse battery staple", stored), true)
    check("wrong password :", auth.VerifyPassword("Correct horse battery staple", stored), false)
    check("empty password :", auth.VerifyPassword("", stored), false)
    // Hashing the same password twice must not produce the same row, or the
    // database would leak which users share a password.
    again := auth.HashPassword("correct horse battery staple")
    check("salted apart   :", stored != again, true)
    check("both verify    :", auth.VerifyPassword("correct horse battery staple", again), true)
end

func secrets():
    // For API keys and webhook signatures: compare in constant time. `==`
    // stops at the first differing byte, and that timing is enough to
    // recover a key one byte at a time.
    check("api key match  :", auth.SecretEquals("k_live_9f2c", "k_live_9f2c"), true)
    check("api key differ :", auth.SecretEquals("k_live_9f2d", "k_live_9f2c"), false)
    check("length differ  :", auth.SecretEquals("k_live_9f2cx", "k_live_9f2c"), false)
    // An unset expected secret must never match, or a missing config value
    // would turn into "everyone is authorised".
    check("unset secret   :", auth.SecretEquals("", ""), false)
    // 32 bytes of entropy is a reasonable floor for a JWT signing key.
    key := auth.RandomSecret(32)
    println "generated key  :", key.len(), "hex chars"
    check("keys differ    :", auth.RandomSecret(32) != auth.RandomSecret(32), true)
end

// The whole login route, minus the HTTP: look the user up, check the
// password, mint a token. Returns "" when the credentials do not check out.
func login(email: str, password: str, stored_hash: str, signing_key: str): str:
    if stored_hash.len() == 0: ret "" end
    if !auth.VerifyPassword(password, stored_hash): ret "" end
    g := auth.NewGuard(signing_key)
    mut err := 0
    ret auth.IssueFor(g, email, 900 as i64, err)
end

func login_flow():
    signing_key := auth.RandomSecret(32)
    stored := auth.HashPassword("hunter2")
    bad := login("sara@example.com", "wrong", stored, signing_key)
    check("bad login      :", bad.len() == 0, true)
    // An unknown user takes the same path as a wrong password: the caller
    // must not be able to tell which of the two it was.
    missing := login("nobody@example.com", "hunter2", "", signing_key)
    check("unknown user   :", missing.len() == 0, true)
    token := login("sara@example.com", "hunter2", stored, signing_key)
    check("good login     :", token.len() > 0, true)
    mut err := 0
    t := jwt.Verify(token, signing_key, jwt.DefaultOptions(), err)
    check("token verifies :", t.valid, true)
    println "token subject  :", t.claims.sub
    println "token lifetime :", t.claims.exp - t.claims.iat, "seconds"
end

func main:
    passwords()
    println ""
    secrets()
    println ""
    login_flow()
    ret 0
end
