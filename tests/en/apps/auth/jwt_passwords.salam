package main


import crypto
import jwt

func check(label: str, got: bool, want: bool):
    if got == want:
        println label, "ok"
    else:
        println label, "UNEXPECTED"
    end
end

func passwords():
    stored := crypto.HashPassword("correct horse battery staple")
    check("right password :", crypto.VerifyPassword("correct horse battery staple", stored), true)
    check("wrong password :", crypto.VerifyPassword("Correct horse battery staple", stored), false)
    check("empty password :", crypto.VerifyPassword("", stored), false)
    again := crypto.HashPassword("correct horse battery staple")
    check("salted apart   :", stored != again, true)
    check("both verify    :", crypto.VerifyPassword("correct horse battery staple", again), true)
end

func api_key_ok(given: str, expected: str): bool:
    if expected.len() == 0: ret false end
    ret crypto.SecretEquals(given, expected)
end

func secrets():
    check("api key match  :", crypto.SecretEquals("k_live_9f2c", "k_live_9f2c"), true)
    check("api key differ :", crypto.SecretEquals("k_live_9f2d", "k_live_9f2c"), false)
    check("length differ  :", crypto.SecretEquals("k_live_9f2cx", "k_live_9f2c"), false)
    check("empty == empty :", crypto.SecretEquals("", ""), true)
    check("guarded, unset :", api_key_ok("anything", ""), false)
    check("guarded, right :", api_key_ok("k_live_9f2c", "k_live_9f2c"), true)
    key := crypto.RandomHex(32)
    println "generated key  :", key.len(), "hex chars"
    check("keys differ    :", crypto.RandomHex(32) != crypto.RandomHex(32), true)
end

func login(email: str, password: str, stored_hash: str, signing_key: str): str:
    if stored_hash.len() == 0: ret "" end
    if !crypto.VerifyPassword(password, stored_hash): ret "" end
    g := jwt.NewGuard(signing_key)
    mut err := 0
    ret jwt.IssueFor(g, email, 900 as i64, err)
end

func login_flow():
    signing_key := crypto.RandomHex(32)
    stored := crypto.HashPassword("hunter2")
    bad := login("sara@example.com", "wrong", stored, signing_key)
    check("bad login      :", bad.len() == 0, true)
    missing := login("nobody@example.com", "hunter2", "", signing_key)
    check("unknown user   :", missing.len() == 0, true)
    token := login("sara@example.com", "hunter2", stored, signing_key)
    check("good login     :", token.len() > 0, true)
    mut err := 0
    t := jwt.Verify(token, signing_key, jwt.DefaultOptions(), err)
    check("token verifies :", t.valid, true)
    println "token subject  :", t.claims.sub
    println "token lifetime :", t.claims.exp - t.claims.iat, "seconds"
end

func main:
    passwords()
    println ""
    secrets()
    println ""
    login_flow()
    ret 0
end
