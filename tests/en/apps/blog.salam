page:
    lang = "en"
    dir = "ltr"
    title = "Salam Blog"
    header:
        class = "site-header"
        background = "#222222"
        color = "white"
        padding = 20px
        heading:
            size = 1
            content = "Salam Blog"
            font size = 32px
        end
    end
    box:
        class = "grid"
        layout = "grid"
        columns = repeat(fit, minmax(250, 1fr))
        gap = 16px
        padding = 20px
        article:
            background = "#f5f5f5"
            padding = 16px
            radius = 8px
            heading:
                size = 2
                content = "First Post"
            end
            paragraph:
                content = "Hello from the Salam layout DSL."
            end
            link:
                source = "/post/1"
                content = "Read more"
                color = "blue"
            end
        end
        media:
            condition = "(max-width: 600px)"
            columns = 1fr
        end
    end
    form:
        id = "subscribe"
        submit = "return validate()"
        input:
            type = "text"
            name = "email"
            placeholder = "Your email"
        end
        button:
            type = "submit"
            content = "Subscribe"
            hover background = "#0a0"
        end
    end
    script:
        content = """
function validate() {
    var f = document.getElementById('subscribe');
    return f != null;
}
"""
    end
end
