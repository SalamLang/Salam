package main

import net.http
import net.router

func hello(h: i64):
    http.Text(http.Ctx(h), "Hello, World! Salam from Cloudflare Workers.\n")
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/", hello)
    s := http.NewServer(8080)
    http.Use(s, r)
    http.Run(s)
end
