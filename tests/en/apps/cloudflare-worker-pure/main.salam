package main

import str
import os
import encoding.json
import encoding.query

struct Request:
    pub method: str = ""
    pub path: str = ""
    pub query: str = ""
    pub body: str = ""
end

struct Response:
    pub status: int = 200
    pub content_type: str = "text/plain; charset=utf-8"
    pub body: str = ""
end

struct Info:
    pub language: str = ""
    pub runtime: str = ""
    pub method: str = ""
    pub path: str = ""
    pub routes: Vector<str> = Vector {} as Vector<str>
end

struct Echo:
    pub length: int = 0
    pub body: str = ""
end

struct Fib:
    pub n: int = 0
    pub value: i64 = 0
end

struct ApiError:
    pub error: str = ""
    pub path: str = ""
end

func text(status: int, body: str): Response:
    ret Response { status = status, body = body }
end

func json_resp(status: int, body: str): Response:
    ret Response { status = status, content_type = "application/json", body = body }
end

func error(status: int, what: str, path: str): Response:
    ret json_resp(status, json.Marshal(ApiError { error = what, path = path }))
end

func reason(status: int): str:
    switch status:
        200:
            ret "OK"
        end
        400:
            ret "Bad Request"
        end
        404:
            ret "Not Found"
        end
        405:
            ret "Method Not Allowed"
        end
    end
    ret "Unknown"
end

func is_digits(s: str): bool:
    if s.Len() == 0 or s.Len() > 2:
        ret false
    end
    repeat s.Len() in i:
        c := s.Substr(i, 1)
        if c < "0" or c > "9":
            ret false
        end
    end
    ret true
end

func fib(n: int): i64:
    mut a := 0 as i64
    mut b := 1 as i64
    repeat n:
        t := a + b
        a = b
        b = t
    end
    ret a
end

func home(): Response:
    mut html := "<!doctype html><html><head><meta charset=\"utf-8\"><title>Salam on Workers</title></head><body>"
    html += "<h1>Salam &#x1F44B; from Cloudflare Workers</h1>"
    html += "<p>This page was rendered by a Salam program compiled to WebAssembly (wasm32-wasi).</p>"
    html += "<ul><li><a href=\"/hello/world\">/hello/:name</a></li>"
    html += "<li><a href=\"/greet?name=Salam\">/greet?name=</a></li>"
    html += "<li><a href=\"/api/info\">/api/info</a></li>"
    html += "<li><a href=\"/api/fib/40\">/api/fib/:n</a></li>"
    html += "<li>POST /api/echo</li></ul></body></html>"
    ret Response { content_type = "text/html; charset=utf-8", body = html }
end

func info(req: Request): Response:
    mut i := Info { language = "Salam", runtime = "wasm32-wasi on Cloudflare Workers", method = req.method, path = req.path }
    i.routes.Push("GET /")
    i.routes.Push("GET /hello/:name")
    i.routes.Push("GET /greet?name=")
    i.routes.Push("GET /api/info")
    i.routes.Push("GET /api/fib/:n")
    i.routes.Push("POST /api/echo")
    ret json_resp(200, json.Marshal(i))
end

func route_post(req: Request): Response:
    switch req.path:
        "/api/echo":
            ret json_resp(200, json.Marshal(Echo { length = req.body.Len(), body = req.body }))
        end
    end
    ret error(405, "method_not_allowed", req.path)
end

func route_prefix(req: Request): Response:
    p := req.path
    if str.StartsWith(p, "/hello/"):
        name := p.Substr(7, p.Len() - 7)
        if name.Len() > 0:
            ret text(200, "Salam, " + name + "!\n")
        end
    end
    if str.StartsWith(p, "/api/fib/"):
        n := p.Substr(9, p.Len() - 9)
        if not is_digits(n) or str.ToInt(n) > 90:
            ret error(400, "n must be an integer in 0..90", p)
        end
        k := str.ToInt(n) as int
        ret json_resp(200, json.Marshal(Fib { n = k, value = fib(k) }))
    end
    ret error(404, "not_found", p)
end

func route_get(req: Request): Response:
    switch req.path:
        "/":
            ret home()
        end
        "/api/info":
            ret info(req)
        end
        "/greet":
            mut name := query.Get(req.query, "name")
            if name.Len() == 0:
                name = "stranger"
            end
            ret text(200, "Salam, " + name + "!\n")
        end
    end
    ret route_prefix(req)
end

func route(req: Request): Response:
    switch req.method:
        "POST":
            ret route_post(req)
        end
        "GET", "HEAD":
            ret route_get(req)
        end
    end
    ret error(405, "method_not_allowed", req.path)
end

func render(res: Response): str:
    mut out := "Status: " + str.FromInt(res.status as i64) + " " + reason(res.status) + "\n"
    out += "Content-Type: " + res.content_type + "\n"
    out += "X-Powered-By: Salam\n\n"
    out += res.body
    ret out
end

func self_test():
    mut reqs := Vector {} as Vector<Request>
    reqs.Push(Request { method = "GET", path = "/hello/world" })
    reqs.Push(Request { method = "GET", path = "/greet", query = "name=Cloud%20Flare" })
    reqs.Push(Request { method = "GET", path = "/greet" })
    reqs.Push(Request { method = "GET", path = "/api/fib/40" })
    reqs.Push(Request { method = "GET", path = "/api/fib/x" })
    reqs.Push(Request { method = "POST", path = "/api/echo", body = "{\"hi\":1}" })
    reqs.Push(Request { method = "DELETE", path = "/api/info" })
    reqs.Push(Request { method = "GET", path = "/nope" })
    reqs.Push(Request { method = "GET", path = "/api/info" })
    repeat reqs.Len() in i:
        r := reqs.Get(i)
        println "== " + r.method + " " + r.path
        println render(route(r))
    end
end

func read_body(): str:
    want := str.ToInt(os.Env("CONTENT_LENGTH"))
    mut body := ""
    until (body.Len() as i64) < want:
        if body.Len() > 0:
            body += "\n"
        end
        body += input ""
    end
    ret body
end

func main:
    method := os.Env("REQUEST_METHOD")
    if method.Len() == 0:
        self_test()
        ret
    end
    mut req := Request { method = method, path = os.Env("PATH_INFO"), query = os.Env("QUERY_STRING") }
    if req.path.Len() == 0:
        req.path = "/"
    end
    if method == "POST":
        req.body = read_body()
    end
    res := route(req)
    if method == "HEAD":
        print render(Response { status = res.status, content_type = res.content_type })
        ret
    end
    print render(res)
end
