package main

import os
import telegram.bot

func need(name: str): str:
    v := os.Env(name)
    if v.len() == 0:
        println "missing environment variable " + name
        os.Exit(1)
    end
    ret v
end

func check(what: str, r: bot.ApiResponse):
    if bot.Ok(r):
        println what + ": ok"
    else:
        println what + ": FAILED - " + r.description
        os.Exit(1)
    end
end

func main:
    b := bot.NewBot(need("TELEGRAM_TOKEN"))
    url := need("WEBHOOK_URL")
    secret := need("TELEGRAM_SECRET")

    me := bot.GetMe(b)
    check("getMe", me)
    println "  " + me.result

    mut cmds := Vector {} as Vector<str>
    cmds.push(bot.BotCommand("start", "Show the menu"))
    cmds.push(bot.BotCommand("help", "What I can do"))
    cmds.push(bot.BotCommand("echo", "Repeat a text"))
    cmds.push(bot.BotCommand("upper", "Upper-case a text"))
    cmds.push(bot.BotCommand("reverse", "Reverse a text"))
    cmds.push(bot.BotCommand("fib", "n-th Fibonacci number"))
    cmds.push(bot.BotCommand("whoami", "What Telegram says about you"))
    cmds.push(bot.BotCommand("time", "Time on the edge"))
    check("setMyCommands", bot.SetMyCommands(b, cmds))

    check("setWebhook " + url, bot.SetWebhookSecret(b, url, secret))
    info := bot.GetWebhookInfo(b)
    check("getWebhookInfo", info)
    println "  " + info.result
end
