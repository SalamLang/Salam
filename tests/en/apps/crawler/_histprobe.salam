package main

import ac "_alanchand.salam"
import encoding.json
import encoding.value
import encoding.encerr
import str
import time

func slice_array(html: str, name: str): str:
    mut at := str.Find(html, "const " + name)
    if at < 0:
        at = str.Find(html, "let " + name)
    end
    if at < 0:
        ret ""
    end
    open := str.IndexFrom(html, "[", at)
    close := str.IndexFrom(html, "];", open)
    if open < 0 || close < 0:
        ret ""
    end
    ret html.substr(open, close - open + 1)
end



func main:
    mut s := ac.NewSession()
    urls := ["https://alanchand.com/en/gold-price/abshodeh", "https://alanchand.com/en/currencies-price/archive/usd", "https://alanchand.com/en/currencies-price/archive/eur"] as str[3]
    each u in urls:
        html := ac.Fetch(s, u)
        raw := slice_array(html, "fullPriceData")
        t0 := time.MonoMillis()
        mut err := encerr.NoError()
        doc := json.Decode(raw, err)
        t1 := time.MonoMillis()
        println u
        println "  json bytes=" + str.FromInt(raw.len() as i64) + " points=" + str.FromInt(value.ArrayLen(doc) as i64) + " decode_ms=" + str.FromInt((t1 - t0) as i64)
    end
    ret 0
end
