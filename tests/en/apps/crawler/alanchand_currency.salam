package main

import ac "_alanchand.salam"
import acjson "_alanchand_json.salam"
import str
import fmt

const NAME_W := 26
const PRICE_W := 14
const RATE_W := 10
const OUT_FILE := "alanchand-currency.json"

struct Rate:
    pub name: str = ""
    pub buy: str = ""
    pub sell: str = ""
    pub usd: str = ""
end

func collect(html: str): Vector<Rate>:
    mut rates := Vector {} as Vector<Rate>
    mut pos := 0
    until true:
        mut next := 0
        name := ac.Text(html, `class="currName"`, pos, "</td>", next)
        if next < 0:
            break
        end
        if name.len() > 0:
            mut r := Rate {}
            r.name = name
            r.buy = ac.CellText(html, `class="buyPrice`, next)
            r.sell = ac.CellText(html, `class="sellPrice`, next)
            r.usd = ac.CellText(html, `class="usdRate`, next)
            rates.push(r)
        end
        pos = next
    end
    ret rates
end

func show_row(name: str, buy: str, sell: str, usd: str):
    mut line := fmt.PadRight(name, NAME_W)
    line = line + " " + fmt.PadLeft(buy, PRICE_W)
    line = line + " " + fmt.PadLeft(sell, PRICE_W)
    line = line + " " + fmt.PadLeft(usd, RATE_W)
    println line
end

func show_table(rates: Vector<Rate>):
    show_row("Currency", "Buy (IRR)", "Sell (IRR)", "USD rate")
    println str.Repeat("-", NAME_W + PRICE_W + PRICE_W + RATE_W + 3)
    each r in rates:
        show_row(r.name, r.buy, r.sell, r.usd)
    end
end

func encode(r: Rate): str:
    mut members := Vector {} as Vector<str>
    defer members.free()
    members.push(acjson.TextMember("name", r.name))
    members.push(acjson.NumberMember("buy", r.buy))
    members.push(acjson.NumberMember("sell", r.sell))
    members.push(acjson.NumberMember("usd_rate", r.usd))
    ret acjson.Object(members)
end

func save(rates: Vector<Rate>, last_update: str):
    mut items := Vector {} as Vector<str>
    defer items.free()
    each r in rates:
        items.push(encode(r))
    end
    _ok := acjson.Write(OUT_FILE, acjson.Document(ac.CURRENCY_URL, last_update, "currencies", items))
end

func main:
    mut session := ac.NewSession()
    println "Fetching " + ac.CURRENCY_URL
    html := ac.Fetch(session, ac.CURRENCY_URL)
    if html.len() == 0:
        println "no currency data"
        ret 1
    end
    _saved := ac.SaveCookies(session)

    println ""
    ac.Banner("Alanchand - live currency prices (Iranian Rial)", ac.CURRENCY_URL, html)

    rates := collect(html)
    defer rates.free()
    show_table(rates)
    println ""
    println str.FromInt(rates.len() as i64) + " currencies"
    save(rates, ac.LastUpdate(html))
    ret 0
end
