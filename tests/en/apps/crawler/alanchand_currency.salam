// Scrapes every currency row from https://alanchand.com/en - the buy price,
// the sell price and, where the site publishes one, the USD rate. Gold and
// crypto live on their own pages and have their own scrapers next to this
// one (alanchand_gold.salam, alanchand_crypto.salam).
//
// Run it with:  salam run alanchand_currency.salam
//
// A row on that page looks like this, and the four class names are the only
// thing this parser depends on:
//
//   <tr onclick="...">
//     <td class="currName"><span class="flag-container">..</span> US Dollar</td>
//     <td class="buyPrice text-center">1,852,000</td>
//     <td class="sellPrice text-center">1,870,500<span class="priceSymbol down"></span></td>
//     <td class="usdRate text-center">-<span class="priceSymbol no_change"></span></td>
//   </tr>

package main

import ac "_alanchand.salam"
import str
import fmt

const NAME_W := 26
const PRICE_W := 14
const RATE_W := 10

func show_row(name: str, buy: str, sell: str, usd: str):
    mut line := fmt.PadRight(name, NAME_W)
    line = line + " " + fmt.PadLeft(buy, PRICE_W)
    line = line + " " + fmt.PadLeft(sell, PRICE_W)
    line = line + " " + fmt.PadLeft(usd, RATE_W)
    println line
end

func show_header():
    show_row("Currency", "Buy (IRR)", "Sell (IRR)", "USD rate")
    println str.Repeat("-", NAME_W + PRICE_W + PRICE_W + RATE_W + 3)
end

// Walks the page one currName cell at a time; the three price cells always
// follow their name cell, so the name's end offset anchors the whole row.
func scrape(html: str): int:
    mut pos := 0
    mut found := 0
    until true:
        mut next := 0
        name := ac.Text(html, `class="currName"`, pos, "</td>", next)
        if next < 0:
            break
        end
        if name.len() > 0:
            buy := ac.CellText(html, `class="buyPrice`, next)
            sell := ac.CellText(html, `class="sellPrice`, next)
            usd := ac.CellText(html, `class="usdRate`, next)
            show_row(name, buy, sell, usd)
            found = found + 1
        end
        pos = next
    end
    ret found
end

func main:
    mut session := ac.NewSession()
    println "Fetching " + ac.CURRENCY_URL
    html := ac.Fetch(session, ac.CURRENCY_URL)
    if html.len() == 0:
        println "no currency data"
        ret 1
    end
    _saved := ac.SaveCookies(session)

    println ""
    ac.Banner("Alanchand - live currency prices (Iranian Rial)", ac.CURRENCY_URL, html)
    show_header()
    n := scrape(html)
    println ""
    println str.FromInt(n as i64) + " currencies"
    ret 0
end
