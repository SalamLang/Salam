// Price history for one currency or one gold item on alanchand.com, with a
// summary and an ASCII chart. Companion to the three table scrapers in this
// directory (alanchand_currency / _gold / _crypto), which read today's
// numbers; this one reads the whole series behind the site's chart.
//
// Run it with:  salam run alanchand_history.salam
//
// The one function to call is:
//
//     series(kind, slug)  ->  Vector<Point>
//
//   kind: "currency" or "gold"
//   slug: "usd" / "eur" / "aed" / "jpy" ... for currencies
//         "abshodeh" / "18ayar" / "sekkeh" ... for gold
//
// It builds the right URL, fetches it through the shared browser session,
// lifts the chart series out of the page's inline script and JSON-decodes it
// into a Vector<Point>. The two pages ship different record shapes:
//
//   currency  https://alanchand.com/en/currencies-price/archive/usd
//             const fullPriceData = [{"timestamp":1207769400,"price":190}, ...]
//
//   gold      https://alanchand.com/en/gold-price/abshodeh
//             let fullPriceData = [{"timestamp":1753043105,"price":29790000,
//                 "real_price":30377626.55,"hobab":-587627,"hobab_percent":-1.97}, ...]
//
// "hobab" is the bubble: how far the quoted price sits above or below the
// intrinsic one. Gold records carry it, currency records do not, so Point
// keeps it optional behind has_bubble.

package main

import ac "_alanchand.salam"
import encoding.json
import encoding.value
import encoding.encerr
import str
import fmt
import time
import conv

const CHART_COLS := 62
const CHART_ROWS := 14
const AXIS_W := 14
const RECENT_ROWS := 8

pub struct Point:
    pub at: i64 = 0
    pub price: f64 = 0.0
    pub real_price: f64 = 0.0
    pub bubble: f64 = 0.0
    pub bubble_pct: f64 = 0.0
    pub has_bubble: bool = false
end

// ------------------------------------------------------------- fetching ----

func series_url(kind: str, slug: str): str:
    if kind == "gold":
        // Gold has no /archive/ page: the item page itself carries the series.
        ret "https://alanchand.com/en/gold-price/" + slug
    end
    ret "https://alanchand.com/en/currencies-price/archive/" + slug
end

func number(o: value.Value, key: str): f64:
    if !value.ObjectHas(o, key):
        ret 0.0
    end
    ret value.AsFloat(value.ObjectGet(o, key))
end

func point_of(o: value.Value): Point:
    mut p := Point {}
    p.at = value.AsInt(value.ObjectGet(o, "timestamp"))
    p.price = number(o, "price")
    if value.ObjectHas(o, "real_price"):
        p.real_price = number(o, "real_price")
        p.bubble = number(o, "hobab")
        p.bubble_pct = number(o, "hobab_percent")
        p.has_bubble = true
    end
    ret p
end

func decode_points(raw: str): Vector<Point>:
    mut points := Vector {} as Vector<Point>
    mut err := encerr.NoError()
    doc := json.Decode(raw, err)
    if encerr.IsError(err):
        println "  JSON error at " + str.FromInt(err.position as i64) + ": " + err.message
        ret points
    end
    if !value.IsArray(doc):
        println "  chart data is not a JSON array"
        ret points
    end
    n := value.ArrayLen(doc)
    repeat n with i:
        points.push(point_of(value.ArrayGet(doc, i)))
    end
    ret points
end

// The whole job in one call: kind ("currency" / "gold") plus slug ("usd",
// "eur", "18ayar", "sekkeh", ...) in, the full price history out. An empty
// vector means the page could not be read; the reason is printed.
func series(kind: str, slug: str): Vector<Point>:
    mut session := ac.NewSession()
    url := series_url(kind, slug)
    println "Fetching " + url
    html := ac.Fetch(session, url)
    _saved := ac.SaveCookies(session)
    if html.len() == 0:
        ret Vector {} as Vector<Point>
    end
    raw := ac.ScriptArray(html, "fullPriceData")
    if raw.len() == 0:
        println "  no fullPriceData series on that page"
        ret Vector {} as Vector<Point>
    end
    println "  " + str.FromInt(raw.len() as i64) + " bytes of JSON, decoding"
    started := time.MonoMillis()
    points := decode_points(raw)
    spent := (time.MonoMillis() - started) as f64 / 1000.0
    println "  " + str.FromInt(points.len() as i64) + " points in " + conv.FormatFloatPrec(spent, 1) + "s"
    ret points
end

// ----------------------------------------------------------- formatting ----

// 1879500 -> "1,879,500", the way the site itself prints prices.
func group(n: f64): str:
    mut digits := str.FromInt(n as i64)
    mut sign := ""
    if str.StartsWith(digits, "-"):
        sign = "-"
        digits = digits.substr(1, digits.len() - 1)
    end
    mut out := ""
    mut left := digits.len()
    until left > 3:
        out = "," + digits.substr(left - 3, 3) + out
        left = left - 3
    end
    ret sign + digits.substr(0, left) + out
end

// Two decimals, sign always shown: "+12.40%", "-4.13%".
func signed_pct(x: f64): str:
    mut sign := "+"
    if x < 0.0:
        sign = ""
    end
    ret sign + conv.FormatFloatPrec(x, 2) + "%"
end

func change_pct(part: f64, whole: f64): str:
    if whole == 0.0:
        ret "n/a"
    end
    ret signed_pct((part - whole) / whole * 100.0)
end

// --------------------------------------------------------------- report ----

func extremes(points: Vector<Point>, want_high: bool): f64:
    mut best := points[0].price
    each p in points:
        if want_high && p.price > best:
            best = p.price
        end
        if !want_high && p.price < best:
            best = p.price
        end
    end
    ret best
end

func average(points: Vector<Point>): f64:
    mut total := 0.0
    each p in points:
        total = total + p.price
    end
    ret total / (points.len() as f64)
end

func show_summary(points: Vector<Point>):
    first := points[0]
    last := points[points.len() - 1]
    println "Points      : " + str.FromInt(points.len() as i64)
    println "Range       : " + time.FormatDate(first.at) + "  ..  " + time.FormatDate(last.at)
    println "Latest      : " + group(last.price) + "   (" + change_pct(last.price, first.price) + " since " + time.FormatDate(first.at) + ")"
    println "Low / High  : " + group(extremes(points, false)) + "  /  " + group(extremes(points, true))
    println "Average     : " + group(average(points))
    if last.has_bubble:
        println "Real price  : " + group(last.real_price)
        println "Bubble      : " + group(last.bubble) + "  (" + signed_pct(last.bubble_pct) + ")"
    end
end

func show_recent(points: Vector<Point>):
    mut head := fmt.PadRight("Date", 12) + fmt.PadLeft("Price", 18)
    if points[points.len() - 1].has_bubble:
        head = head + fmt.PadLeft("Real price", 18) + fmt.PadLeft("Bubble %", 12)
    end
    println head
    println str.Repeat("-", head.len())
    mut i := points.len() - RECENT_ROWS
    if i < 0:
        i = 0
    end
    until i < points.len():
        p := points[i]
        mut line := fmt.PadRight(time.FormatDate(p.at), 12) + fmt.PadLeft(group(p.price), 18)
        if p.has_bubble:
            line = line + fmt.PadLeft(group(p.real_price), 18) + fmt.PadLeft(signed_pct(p.bubble_pct), 12)
        end
        println line
        i = i + 1
    end
end

// ---------------------------------------------------------------- chart ----

// One sample per column, picked evenly across the series, mapped onto
// CHART_ROWS levels between the series low and high.
func levels_of(points: Vector<Point>, low: f64, high: f64): Vector<int>:
    mut levels := Vector {} as Vector<int>
    span := high - low
    last := points.len() - 1
    repeat CHART_COLS with c:
        idx := c * last / (CHART_COLS - 1)
        share := (points[idx].price - low) / span
        levels.push((share * ((CHART_ROWS - 1) as f64)) as int)
    end
    ret levels
end

// '*' marks the sample in this column; '|' fills the gap to the previous
// column so a steep move reads as a line rather than two dots.
func cell(levels: Vector<int>, c: int, row: int): str:
    here := levels[c]
    if here == row:
        ret "*"
    end
    if c == 0:
        ret " "
    end
    before := levels[c - 1]
    if row > here && row < before:
        ret "|"
    end
    if row < here && row > before:
        ret "|"
    end
    ret " "
end

func chart_row(levels: Vector<int>, row: int, label: str):
    mut line := fmt.PadLeft(label, AXIS_W) + " |"
    repeat CHART_COLS with c:
        line = line + cell(levels, c, row)
    end
    println line
end

func show_chart(points: Vector<Point>):
    low := extremes(points, false)
    mut high := extremes(points, true)
    if high <= low:
        high = low + 1.0
    end
    levels := levels_of(points, low, high)
    defer levels.free()
    repeat CHART_ROWS with r:
        row := CHART_ROWS - 1 - r
        mut label := ""
        if row == CHART_ROWS - 1:
            label = group(high)
        end
        if row == 0:
            label = group(low)
        end
        chart_row(levels, row, label)
    end
    println fmt.PadLeft("", AXIS_W) + " +" + str.Repeat("-", CHART_COLS)
    first_day := time.FormatDate(points[0].at)
    last_day := time.FormatDate(points[points.len() - 1].at)
    println fmt.PadLeft("", AXIS_W) + "  " + fmt.PadRight(first_day, CHART_COLS - last_day.len()) + last_day
end

func report(kind: str, slug: str):
    println ""
    println "=============================================================================="
    println kind + " / " + slug
    println "=============================================================================="
    points := series(kind, slug)
    defer points.free()
    if points.len() < 2:
        println "  no series"
        ret
    end
    println ""
    show_summary(points)
    println ""
    show_chart(points)
    println ""
    show_recent(points)
end

func main:
    kinds := ["currency", "currency", "currency", "currency", "gold", "gold", "gold"] as str[7]
    slugs := ["usd", "eur", "aed", "jpy", "abshodeh", "18ayar", "sekkeh"] as str[7]
    println "Alanchand price history (the currency archives are large, this takes a moment)"
    repeat 7 with i:
        report(kinds[i], slugs[i])
    end
    ret 0
end
