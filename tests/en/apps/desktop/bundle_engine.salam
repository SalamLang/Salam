import gui.webview.bundle
import io
import os

func main:
    dir := os.TempDir() + "/salam-bundle-engine-test"
    os.MkdirAll(dir)
    path := dir + "/salam.toml"
    io.WriteFile(path, "[app]\nid = \"com.example.a\"\nname = \"A\"\nengine = \"chromium\"\nruntime = \"cef\"\n")
    mut m := bundle.Manifest {}
    println bundle.ReadManifest(path, m), m.engine, m.runtime
    io.WriteFile(path, "[app]\nid = \"com.example.a\"\nname = \"A\"\n")
    mut d := bundle.Manifest {}
    println bundle.ReadManifest(path, d), d.engine, d.runtime.len()
    os.RemoveAll(dir)
end
