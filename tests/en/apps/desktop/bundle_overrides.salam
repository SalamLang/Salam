import gui.webview.bundle
import io
import os

func main:
    dir := os.TempDir() + "/salam-bundle-overrides-test"
    os.MkdirAll(dir)
    path := dir + "/salam.toml"
    io.WriteFile(
        path,
        "[app]\nid = \"com.example.a\"\nname = \"A\"\n\n[windows]\nproduct = \"Product A\"\ncopyright = \"Example Ltd\"\nsubsystem = \"console\"\nmanifest = \"a.manifest\"\n\n[linux]\nproduct = \"Other\"\n"
    )
    mut m := bundle.Manifest {}
    println bundle.ReadManifest(path, m), m.overrides.Len() > 0, m.subsystem
    bundle.ApplyOverrides(m, "windows")
    println m.product, m.copyright, m.subsystem, m.manifest
    mut l := bundle.Manifest {}
    bundle.ReadManifest(path, l)
    bundle.ApplyOverrides(l, "linux")
    println l.product, l.subsystem
    os.RemoveAll(dir)
end
