import gui.webview
import gui.webview.bundle

func show(name: str, value: str):
    println name + " = [" + value + "]"
end

func main:
    show("https", webview.OriginOf("https://Ai.SalamLang.ir:443/x?y#z"))
    show("port", webview.OriginOf("http://localhost:3000/chat"))
    show("userinfo", webview.OriginOf("https://evil@bank.example/x"))
    show("blank", webview.OriginOf("about:blank"))
    show("index", webview.SafeAssetPath("/"))
    show("folder", webview.SafeAssetPath("/sub/"))
    show("parent", webview.SafeAssetPath("/../secret"))
    show("encoded parent", webview.SafeAssetPath("/%2e%2e/secret"))
    show("backslash", webview.SafeAssetPath("/a\\b"))
    show("nul", webview.SafeAssetPath("/a%00b"))
    show("persian", webview.SafeAssetPath("/%D8%B3.png"))
    webview.Init(webview.Config { id = "ir.salamlang.logic" })
    mut only := Vector {} as Vector<str>
    only.Push("agent_*")
    only.Push("ping")
    webview.Allow("https://ai.salamlang.ir/", only)
    println webview.Allowed("https://ai.salamlang.ir", "agent_info")
    println webview.Allowed("https://ai.salamlang.ir", "ping")
    println webview.Allowed("https://ai.salamlang.ir", "shell")
    println webview.Allowed("https://evil.example", "ping")
    mut m := bundle.Manifest {}
    println bundle.ReadManifest("does-not-exist.toml", m)
end
