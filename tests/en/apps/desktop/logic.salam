import desktop
import desktop.bundle

func show(name: str, value: str):
    println name + " = [" + value + "]"
end

func main:
    show("https", desktop.OriginOf("https://Ai.SalamLang.ir:443/x?y#z"))
    show("port", desktop.OriginOf("http://localhost:3000/chat"))
    show("userinfo", desktop.OriginOf("https://evil@bank.example/x"))
    show("blank", desktop.OriginOf("about:blank"))
    show("index", desktop.SafeAssetPath("/"))
    show("folder", desktop.SafeAssetPath("/sub/"))
    show("parent", desktop.SafeAssetPath("/../secret"))
    show("encoded parent", desktop.SafeAssetPath("/%2e%2e/secret"))
    show("backslash", desktop.SafeAssetPath("/a\\b"))
    show("nul", desktop.SafeAssetPath("/a%00b"))
    show("persian", desktop.SafeAssetPath("/%D8%B3.png"))
    desktop.Init(desktop.Config { id = "ir.salamlang.logic" })
    mut only := Vector {} as Vector<str>
    only.push("agent_*")
    only.push("ping")
    desktop.Allow("https://ai.salamlang.ir/", only)
    println desktop.Allowed("https://ai.salamlang.ir", "agent_info")
    println desktop.Allowed("https://ai.salamlang.ir", "ping")
    println desktop.Allowed("https://ai.salamlang.ir", "shell")
    println desktop.Allowed("https://evil.example", "ping")
    mut m := bundle.Manifest {}
    println bundle.ReadManifest("does-not-exist.toml", m)
end
