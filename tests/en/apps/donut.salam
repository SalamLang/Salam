package main

import math
import str

const WIDTH := 80
const HEIGHT := 22
const CELLS := 1760

const RAMP := ".,-~:;=!*#$@"

const CENTER_X := 40.0
const CENTER_Y := 12.0
const X_SCALE := 30.0
const Y_SCALE := 15.0

const R1 := 1.0
const R2 := 2.0
const K2 := 5.0

const THETA_STEP := 0.07
const PHI_STEP := 0.02
const SWEEP := 6.28

const A_STEP := 0.04
const B_STEP := 0.02
const SPIN := 26.0
const FRAMES := 6

mut g_lum: int[CELLS]
mut g_zbuf: f64[CELLS]

func clear_frame:
    repeat CELLS with i:
        g_lum[i] = -1
        g_zbuf[i] = 0.0
    end
end

func plot(a: f64, b: f64):
    sa := math.Sin(a)
    ca := math.Cos(a)
    sb := math.Sin(b)
    cb := math.Cos(b)

    mut theta := 0.0
    until theta < SWEEP:
        st := math.Sin(theta)
        ct := math.Cos(theta)

        cx := R2 + R1 * ct
        cy := R1 * st

        mut phi := 0.0
        until phi < SWEEP:
            sp := math.Sin(phi)
            cp := math.Cos(phi)

            ooz := 1.0 / (sp * cx * sa + cy * ca + K2)

            ty := sp * cx * ca - cy * sa

            sx := (CENTER_X + X_SCALE * ooz * (cp * cx * cb - ty * sb)) as int
            sy := (CENTER_Y + Y_SCALE * ooz * (cp * cx * sb + ty * cb)) as int

            lum := (8.0 * ((st * sa - sp * ct * ca) * cb - sp * ct * sa - st * ca - cp * ct * sb)) as int

            if sy > 0 && sy < HEIGHT && sx > 0 && sx < WIDTH:
                o := sx + WIDTH * sy
                if ooz > g_zbuf[o]:
                    g_zbuf[o] = ooz
                    if lum > 0:
                        g_lum[o] = lum
                    else:
                        g_lum[o] = 0
                    end
                end
            end

            phi = phi + PHI_STEP
        end

        theta = theta + THETA_STEP
    end
end

func draw:
    repeat HEIGHT with row:
        mut line := ""
        repeat WIDTH with col:
            idx := g_lum[row * WIDTH + col]
            if idx < 0:
                line = line.concat(" ")
            else:
                line = line.concat(RAMP.substr(idx, 1))
            end
        end
        println str.TrimRight(line)
    end
end

func main:
    repeat FRAMES with f:
        println "-- frame", f
        clear_frame()
        plot((f as f64) * A_STEP * SPIN, (f as f64) * B_STEP * SPIN)
        draw()
    end
end
