package main

import os
import io
import str
import conv
import math
import encoding.json

struct Rows:
    pub bykey: HashMap<str, str> = HashMap {}
    pub connections: int = 0
    pub threads: int = 0
    pub duration_s: f64 = 0.0
    pub seeded: bool = false
end

func server_order(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("salam") v.Push("go") v.Push("fiber") v.Push("gin") v.Push("echo")
    v.Push("nginx") v.Push("apache") v.Push("node") v.Push("php")
    ret v
end

func server_labels(): HashMap<str, str>:
    mut m := HashMap {} as HashMap<str, str>
    m.Put("salam", "Salam")
    m.Put("go", "Go (net/http)")
    m.Put("fiber", "Go (Fiber)")
    m.Put("gin", "Go (Gin)")
    m.Put("echo", "Go (Echo)")
    m.Put("nginx", "nginx")
    m.Put("apache", "Apache")
    m.Put("node", "node/express")
    m.Put("php", "php -S")
    ret m
end

func route_keys(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("plaintext") v.Push("json") v.Push("cached") v.Push("file")
    v.Push("users") v.Push("search") v.Push("compute") v.Push("headers")
    v.Push("static") v.Push("home") v.Push("echo")
    ret v
end

func route_labels(): HashMap<str, str>:
    mut m := HashMap {} as HashMap<str, str>
    m.Put("plaintext", "/plaintext")
    m.Put("json", "/json")
    m.Put("cached", "/cached")
    m.Put("file", "/file")
    m.Put("users", "/users/42")
    m.Put("search", "/search?q=&n=5")
    m.Put("compute", "/compute?n=1000")
    m.Put("headers", "/headers")
    m.Put("static", "/static/style.css")
    m.Put("home", "/")
    m.Put("echo", "POST /echo")
    ret m
end

func group_thousands(digits: str): str:
    mut sign := ""
    mut body := digits
    if str.StartsWith(body, "-"):
        sign = "-"
        body = body.Substr(1, body.Len() - 1)
    end
    n := body.Len()
    if n <= 3: ret sign + body end
    mut out := ""
    mut i := 0
    until i < n:
        left := n - i
        if i > 0 and left % 3 == 0:
            out += ","
        end
        out += body.Substr(i, 1)
        i++
    end
    ret sign + out
end

func round_half_even(v: f64): f64:
    fl := math.Floor(v)
    d := v - fl
    if d > 0.5: ret fl + 1.0 end
    if d < 0.5: ret fl end
    half := fl / 2.0
    if half == math.Floor(half): ret fl end
    ret fl + 1.0
end

func fixed0(v: f64): str:
    ret conv.FormatFloatPrec(round_half_even(v), 0)
end

func fmt_rps(v: f64): str:
    ret group_thousands(fixed0(v))
end

func fmt_us(v: f64): str:
    if v >= 1000.0:
        ret conv.FormatFloatPrec(v / 1000.0, 1) + " ms"
    end
    ret fixed0(v) + " us"
end

func fmt_commas(n: int): str:
    ret group_thousands(conv.FormatInt(n as i64))
end

func key_of(server: str, route: str): str:
    ret server + "\t" + route
end

func load(path: str): Rows:
    mut rows := Rows {}
    each line in str.Split(os.ReadFile(path), "\n"):
        t := str.Trim(line)
        if t.Len() == 0: continue end
        rows.bykey.Put(key_of(json.Get(t, "server"), json.Get(t, "route")), t)
        if rows.seeded == false:
            rows.connections = json.GetInt(t, "connections")
            rows.threads = json.GetInt(t, "threads")
            rows.duration_s = json.GetFloat(t, "duration_s")
            rows.seeded = true
        end
    end
    ret rows
end

func present_servers(rows &: Rows): Vector<str>:
    mut out := Vector {} as Vector<str>
    each s in server_order():
        mut found := false
        each r in route_keys():
            if rows.bykey.Has(key_of(s, r)): found = true end
        end
        if found: out.Push(s) end
    end
    ret out
end

func spaces(n: int): str:
    mut out := ""
    mut i := 0
    until i < n:
        out += " "
        i++
    end
    ret out
end

func dashes(n: int): str:
    mut out := ""
    mut i := 0
    until i < n:
        out += "-"
        i++
    end
    ret out
end

func cells_of(line: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    parts := line.Split("|")
    mut i := 1
    until i < parts.Len() - 1:
        out.Push(str.Trim(parts.Get(i)))
        i++
    end
    ret out
end

func align_of(cell: str): str:
    left := str.StartsWith(cell, ":")
    right := str.EndsWith(cell, ":")
    if left and right: ret "center" end
    if right: ret "right" end
    if left: ret "left" end
    ret "none"
end

func grid(lines: Vector<str>): str:
    mut matrix := Vector {} as Vector<Vector<str>>
    each line in lines:
        matrix.Push(cells_of(line))
    end
    cols := matrix.Get(0).Len()
    mut aligns := Vector {} as Vector<str>
    mut widths := Vector {} as Vector<int>
    mut c := 0
    until c < cols:
        aligns.Push(align_of(matrix.Get(1).Get(c)))
        mut w := 3
        mut r := 0
        until r < matrix.Len():
            if r != 1 and matrix.Get(r).Get(c).Len() > w:
                w = matrix.Get(r).Get(c).Len()
            end
            r++
        end
        widths.Push(w)
        c++
    end
    mut out := Vector {} as Vector<str>
    mut r := 0
    until r < matrix.Len():
        mut cells := Vector {} as Vector<str>
        mut k := 0
        until k < cols:
            w := widths.Get(k)
            a := aligns.Get(k)
            if r == 1:
                if a == "center":
                    cells.Push(":" + dashes(w - 2) + ":")
                else a == "right":
                    cells.Push(dashes(w - 1) + ":")
                else a == "left":
                    cells.Push(":" + dashes(w - 1))
                else:
                    cells.Push(dashes(w))
                end
            else:
                text := matrix.Get(r).Get(k)
                gap := w - text.Len()
                if a == "right":
                    cells.Push(spaces(gap) + text)
                else a == "center":
                    before := gap / 2
                    cells.Push(spaces(before) + text + spaces(gap - before))
                else:
                    cells.Push(text + spaces(gap))
                end
            end
            k++
        end
        out.Push("| " + str.Join(cells, " | ") + " |")
        r++
    end
    ret str.Join(out, "\n")
end

func table(rows &: Rows, servers &: Vector<str>, field: str, as_us: bool): str:
    labels := server_labels()
    routes := route_keys()
    rlabels := route_labels()

    mut head := "| Route |"
    mut sep := "| --- |"
    each s in servers:
        head = head + " " + labels.Get(s) + " |"
        sep += " ---: |"
    end

    mut out := Vector {} as Vector<str>
    out.Push(head)
    out.Push(sep)

    each route in routes:
        mut cells := Vector {} as Vector<str>
        mut any := false
        each s in servers:
            k := key_of(s, route)
            if rows.bykey.Has(k) == false:
                cells.Push("")
            else:
                v := json.GetFloat(rows.bykey.Get(k), field)
                mut c := ""
                if as_us:
                    c = fmt_us(v)
                else:
                    c = fmt_rps(v)
                end
                cells.Push(c)
                if c.Len() > 0: any = true end
            end
        end
        if any:
            mut row := "| `" + rlabels.Get(route) + "` |"
            each c in cells:
                row = row + " " + c + " |"
            end
            out.Push(row)
        end
    end
    ret grid(out)
end

func health_table(rows &: Rows, servers &: Vector<str>): str:
    labels := server_labels()
    routes := route_keys()
    rlabels := route_labels()

    mut out := Vector {} as Vector<str>
    out.Push("| Server | Route | non-2xx | connect errors | I/O errors | reconnects | died |")
    out.Push("| --- | --- | ---: | ---: | ---: | ---: | :---: |")

    each s in servers:
        each route in routes:
            k := key_of(s, route)
            if rows.bykey.Has(k) == false: continue end
            r := rows.bykey.Get(k)
            non2xx := json.GetInt(r, "non2xx")
            connect_err := json.GetInt(r, "connect_err")
            io_err := json.GetInt(r, "io_err")
            reconnects := json.GetInt(r, "reconnects")
            died := json.Get(r, "died") == "true"
            bad := non2xx + connect_err + io_err
            if bad == 0 and reconnects == 0 and died == false: continue end
            mut mark := ""
            if died: mark = "**yes**" end
            out.Push(
                "| " + labels.Get(s) + " | `" + rlabels.Get(route) + "` | " + fmt_commas(non2xx) + " | " + fmt_commas(connect_err) + " | " + fmt_commas(io_err) + " | " + fmt_commas(reconnects) + " | " + mark + " |"
            )
        end
    end

    if out.Len() > 2:
        ret grid(out)
    end
    ret "_No errors, no forced reconnects, no crashes._"
end

func geomean_of(rows &: Rows, server: str, routes &: Vector<str>, out &: f64): bool:
    mut sum := 0.0
    mut n := 0
    each r in routes:
        k := key_of(server, r)
        if rows.bykey.Has(k) == false: ret false end
        v := json.GetFloat(rows.bykey.Get(k), "rps")
        if v <= 0.0: ret false end
        sum += math.Log(v)
        n++
    end
    if n == 0: ret false end
    out = math.Exp(sum / (n as f64))
    ret true
end

func ratio_text(v: f64, base: f64): str:
    if v == base: ret "n/a" end
    if v > base:
        ret conv.FormatFloatPrec(v / base, 2) + "x faster"
    end
    ret conv.FormatFloatPrec(base / v, 2) + "x slower"
end

func geomean_table(rows &: Rows, servers &: Vector<str>, routes &: Vector<str>): str:
    labels := server_labels()
    mut names := Vector {} as Vector<str>
    mut means := Vector {} as Vector<f64>
    each s in servers:
        mut g := 0.0
        if geomean_of(rows, s, routes, g):
            mut at := names.Len()
            until at > 0 and means.Get(at - 1) < g:
                at--
            end
            names.Insert(at, s)
            means.Insert(at, g)
        end
    end
    mut base := 0.0
    _has := geomean_of(rows, "salam", routes, base)
    mut out := Vector {} as Vector<str>
    out.Push("| Server | Geomean req/s | vs Salam |")
    out.Push("| --- | ---: | ---: |")
    repeat names.Len() in i:
        s := names.Get(i)
        g := means.Get(i)
        mut rel := "n/a"
        if base > 0.0 and s != "salam": rel = ratio_text(g, base) end
        mut label := labels.Get(s)
        if s == "salam": label = "**" + label + "**" end
        out.Push("| " + label + " | " + fmt_rps(g) + " | " + rel + " |")
    end
    ret grid(out)
end

func nginx_routes(rows &: Rows): Vector<str>:
    mut out := Vector {} as Vector<str>
    each r in route_keys():
        if rows.bykey.Has(key_of("nginx", r)): out.Push(r) end
    end
    ret out
end

func main:
    args := os.Args()
    defer args.Free()
    if args.Len() < 2:
        println "usage: salam run tests/en/apps/httpbench/bench/report.salam <results.json>"
        ret 1
    end
    path := args.Get(1)
    if os.Exists(path) == false:
        io.EPrintln("report: no such file: " + path)
        ret 1
    end

    mut rows := load(path)
    mut servers := present_servers(rows)
    if servers.Len() == 0:
        println "no results"
        ret 0
    end

    println "<!-- generated by bench/report.salam from " + path + " -->"
    println ""
    println "Load: " + conv.FormatInt(rows.connections as i64) + " connections, " + conv.FormatInt(rows.threads as i64) + " generator threads, " + fixed0(rows.duration_s) + "s measured per route."
    println ""
    println "## Requests per second"
    println ""
    println table(rows, servers, "rps", false)
    println ""
    println "## Requests per minute"
    println ""
    println table(rows, servers, "rpm", false)
    println ""
    println "## Latency, 99th percentile"
    println ""
    println table(rows, servers, "p99_us", true)
    println ""
    println "## Latency, median"
    println ""
    println table(rows, servers, "p50_us", true)
    println ""
    mut all_routes := route_keys()
    println "## Geometric mean, every route"
    println ""
    println "Servers that answer all " + conv.FormatInt(all_routes.Len() as i64) + " routes."
    println ""
    println geomean_table(rows, servers, all_routes)
    println ""
    mut ng := nginx_routes(rows)
    if ng.Len() > 0:
        println "## Geometric mean on the routes nginx answers"
        println ""
        println "The " + conv.FormatInt(ng.Len() as i64) + " routes nginx serves from its own config, for every server that answers all of them."
        println ""
        println geomean_table(rows, servers, ng)
        println ""
    end
    println "## Errors and forced reconnects"
    println ""
    println health_table(rows, servers)
    ret 0
end
