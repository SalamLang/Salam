// image_basics - a tour of std/image: create a canvas, draw on it, save
// it, load it back, resize it, and convert it to another format. Mirrors
// the conceptual walkthrough from the package's design brief, translated
// into Salam's idiom: free functions over a plain `Image` struct (the same
// shape std/compress's ByteBuf and std/archive use), not method chaining.

package main

import image
import os

func main:
    // --- create ---------------------------------------------------
    mut img := image.New(800, 600)
    image.FillHex(img, "#ffffff")

    image.DrawRectFilled(img, 10, 10, 200, 100, image.RGB(255, 0, 0))
    image.SetPixel(img, 50, 50, image.RGB(0, 0, 0))
    image.DrawCircleFilled(img, 400, 300, 80, image.RGBA(0, 120, 255, 200))
    image.DrawText(img, 10, 130, "SALAM IMAGE", image.RGB(20, 20, 20), 3)

    image.Save(img, "test.png")
    println "wrote test.png:", img.width, "x", img.height

    // --- load, resize, re-encode -----------------------------------
    mut ok := false
    mut img2 := image.Open("test.png", ok)
    if !ok:
        println "failed to open test.png"
        os.Exit(1)
    end

    resized := image.ResizeBilinearFilter(img2, 400, 300)
    image.Free(img2)
    img2 = resized

    // SaveQuality picks the encoder from the extension (.jpg -> JPEG) and
    // Convert (called internally) flattens the alpha channel onto white,
    // since JPEG has no alpha channel of its own.
    image.SaveQuality(img2, "test.jpg", 80)
    println "wrote test.jpg:", img2.width, "x", img2.height

    // --- format conversion ------------------------------------------
    // WebP is a documented extension point, not yet implemented (see
    // std/image/webp.salam) - Save reports false rather than writing a
    // bogus file, so check it like any other I/O call.
    webp_ok := image.Save(img2, "test.webp")
    println "webp save (not yet implemented):", webp_ok

    image.Free(img2)
    image.Free(img)
end
