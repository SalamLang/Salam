package main

import image
import os

func main:
    mut img := image.New(800, 600)
    image.FillHex(img, "#ffffff")

    image.DrawRectFilled(img, 10, 10, 200, 100, image.RGB(255, 0, 0))
    image.SetPixel(img, 50, 50, image.RGB(0, 0, 0))
    image.DrawCircleFilled(img, 400, 300, 80, image.RGBA(0, 120, 255, 200))
    image.DrawText(img, 10, 130, "SALAM IMAGE", image.RGB(20, 20, 20), 3)

    image.Save(img, "test.png")
    println "wrote test.png:", img.width, "x", img.height

    mut ok := false
    mut img2 := image.Open("test.png", ok)
    if !ok:
        println "failed to open test.png"
        os.Exit(1)
    end

    resized := image.ResizeBilinearFilter(img2, 400, 300)
    image.Free(img2)
    img2 = resized

    image.SaveQuality(img2, "test.jpg", 80)
    println "wrote test.jpg:", img2.width, "x", img2.height

    webp_ok := image.Save(img2, "test.webp")
    println "webp save (not yet implemented):", webp_ok

    image.Free(img2)
    image.Free(img)
end
