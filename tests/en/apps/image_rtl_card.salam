package main

import image
import os
import filepath

const CARD_W := 700
const CARD_H := 420

const TITLE_FA := "دعوت‌نامه"
const HEAD_FA := "کارگاه زبان برنامه‌نویسی سلام"
const WHEN_FA := "پنج‌شنبه ۲۵ مرداد - ساعت ۱۸:۳۰"
const WHERE_FA := "تهران، خیابان آزادی، پلاک 120"
const NOTE_FA := "ورود برای همه آزاد است (ظرفیت 250 نفر)"

const TITLE_EN := "Invitation"
const HEAD_EN := "Salam Programming Language Workshop"
const WHEN_EN := "Thursday, August 16 - 18:30"
const WHERE_EN := "Tehran, Azadi Street, No. 120"
const NOTE_EN := "Open to everyone (250 seats)"

func paint_background(img &: image.Image):
    top := image.RGB(252, 251, 248)
    bottom := image.RGB(232, 238, 246)
    mut y := 0
    until y < img.height:
        t := (y as f64) / ((img.height - 1) as f64)
        image.DrawLine(img, 0, y, img.width - 1, y, image.LerpColor(top, bottom, t))
        y += 1
    end
    image.DrawRect(img, 0, 0, img.width, img.height, image.RGB(60, 80, 110))
    image.DrawRect(img, 6, 6, img.width - 12, img.height - 12, image.RGB(150, 170, 195))
    image.DrawRectFilled(img, 40, 120, img.width - 80, 84, image.RGBA(60, 80, 110, 22))
end

func draw_card(img &: image.Image, f: image.Font, title: str, head: str, when_line: str, where_line: str, note: str): f64:
    ink := image.RGB(28, 34, 52)
    accent := image.RGB(150, 40, 60)

    mut big := image.TextStyle {}
    big.size = 44.0
    image.DrawTextCentered(img, (img.width as f64) * 0.5, 70.0, title, accent, f, big)

    style := image.TextStyle {}
    used := image.DrawTextFitBox(img, 40.0, 120.0, (img.width - 80) as f64, 84.0, head, ink, f, style, 0.92, 60.0)

    mut body := image.TextStyle {}
    body.size = 26.0
    mut align := image.TextAlignRight
    if image.BaseDirection(head) == image.TextDirLTR:
        align = image.TextAlignLeft
    end
    image.DrawTextInBox(img, 60.0, 230.0, (img.width - 120) as f64, 40.0, when_line, ink, f, body, align, image.TextVAlignMiddle)
    image.DrawTextInBox(img, 60.0, 275.0, (img.width - 120) as f64, 40.0, where_line, ink, f, body, align, image.TextVAlignMiddle)

    mut small := image.TextStyle {}
    small.size = 20.0
    image.DrawTextCentered(img, (img.width as f64) * 0.5, 345.0, note, image.RGB(90, 100, 120), f, small)

    mut foot := image.TextStyle {}
    foot.size = 16.0
    foot.tracking = 1.5
    image.DrawTextInBox(img, 40.0, 375.0, (img.width - 80) as f64, 24.0, "salam-lang.org", image.RGB(120, 130, 150), f, foot, image.TextAlignLeft, image.TextVAlignMiddle)
    image.DrawTextInBox(img, 40.0, 375.0, (img.width - 80) as f64, 24.0, "std/image", image.RGB(120, 130, 150), f, foot, image.TextAlignRight, image.TextVAlignMiddle)
    ret used
end

func main:
    if image.IsRTLText(HEAD_FA):
        println "persian is rtl: yes"
    end
    if image.BaseDirection(HEAD_FA) == image.TextDirRTL:
        println "persian base: rtl"
    end
    if image.BaseDirection(HEAD_EN) == image.TextDirLTR:
        println "english base: ltr"
    end
    if image.ShapeArabic(HEAD_FA) != HEAD_FA:
        println "shaping applied: yes"
    end
    if image.ToVisualOrder(HEAD_FA, image.TextDirAuto) != image.ShapeArabic(HEAD_FA):
        println "reordered: yes"
    end
    if image.ToVisualOrder(HEAD_EN, image.TextDirAuto) == HEAD_EN:
        println "latin untouched: yes"
    end

    arabic_path := image.FindArabicFont()
    mut font_ok := false
    mut font := image.LoadFont(arabic_path, font_ok)
    persian := font_ok
    if !font_ok:
        font = image.LoadSystemFont(font_ok)
    end
    if !font_ok:
        println "no usable font on this machine"
        ret 0
    end
    println "font: " + image.FindSystemFont()

    mut img := image.New(CARD_W, CARD_H)
    paint_background(img)
    mut used := 0.0
    if persian:
        println "language: persian"
        used = draw_card(img, font, TITLE_FA, HEAD_FA, WHEN_FA, WHERE_FA, NOTE_FA)
    else:
        println "language: english (no persian-capable font found)"
        used = draw_card(img, font, TITLE_EN, HEAD_EN, WHEN_EN, WHERE_EN, NOTE_EN)
    end
    if used > 0.0:
        println "headline sized: ok"
    end

    outdir := filepath.Join(os.TempDir(), "salam_rtl_card")
    os.MkdirAll(outdir)
    png_path := filepath.Join(outdir, "card.png")
    if image.Save(img, png_path):
        println "saved png: ok"
    end
    println "file: " + png_path

    image.Free(img)
    image.FreeFont(font)
    ret 0
end
