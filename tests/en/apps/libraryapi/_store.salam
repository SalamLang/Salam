package store

// SQL for the library API, and the file that shows how to talk to MariaDB
// from a threaded server.
//
// ONE CONNECTION PER REQUEST, NEVER ONE PER PROCESS
//
// net/http gives every connection its own thread. A MariaDB connection
// cannot be used by two threads at once - not "should not", cannot: the
// driver multiplexes one socket with one result-set cursor, so a second
// thread sending a command while the first is reading rows puts the protocol
// out of sync, libmariadb tears the connection down mid-read, and the first
// thread walks freed memory. That is a segfault, not an error return.
//
// A mutex around every call does technically prevent it, and was tried here
// first. It is still the wrong answer: it serializes the entire server behind
// one socket, so a thread-per-connection server can never do two things at
// once and one slow query blocks every other request in the process.
//
// So there is no shared connection in this file. Connect() opens one, the
// handler closes it, and nothing crosses a thread boundary:
//
//     mut c := store.Conn { }
//     if !db(ctx, c): ret end        // Connect, or 503
//     defer store.Close(c)           // released however the handler exits
//
// The cost is a TCP connect and an auth handshake per request. On a local
// socket that is well under a millisecond; across the internet it is a real
// tens of milliseconds, and the answer there is a pool - N connections made
// up front, each handed to one request at a time. A pool would be a change to
// Connect() and Close() alone, because every function below already takes the
// connection it uses as an argument. That is why it is passed explicitly.
//
// Two calls the driver requires that nothing else will make for you:
//   - LibraryInit() once, from main, before any thread exists (main.salam)
//   - ThreadInit() from each thread before its first call (Connect, below)

import os
import str
import conv
import db.mysql
import encoding.json

const BOOK_COLS := "id, isbn, title, author, published_year, copies_total, copies_available"
const LOAN_LIMIT := 3
const LOAN_DAYS := 14

// Connection settings, read once at startup and never written again. Sharing
// them across threads is safe precisely because nothing mutates them after
// Configure returns.
mut _host := "127.0.0.1"
mut _port := 3306
mut _user := "root"
mut _pass := ""
mut _name := "salam_library"

// One request's connection. Passed explicitly to every function here, so a
// caller cannot be vague about which connection it is using.
//
// It holds the raw handle rather than a mysql.Database, and _db() rebuilds
// the struct on the way into the driver. That is a workaround, not a design:
// a struct field whose DEFAULT is a struct from another package makes the C
// backend emit the type name without its module prefix - `(Database){0}`
// instead of `(mysql__Database){0}` - and the generated C does not compile.
// A pointer field with a `null` default has no such problem.
pub struct Conn:
    pub handle: void* = null
    pub ok: bool = false
    pub err: str = ""
end

pub struct User:
    pub id: i64 = 0
    pub email: str = ""
    pub hash: str = ""
    pub role: str = ""
end

// A borrow attempt can fail in four ways the caller has to tell apart, so it
// returns a reason rather than a bool.
pub struct BorrowResult:
    pub loan_id: i64 = 0
    // "" on success, otherwise one of: no_book, unavailable, already_out,
    // limit_reached, db
    pub reason: str = ""
    pub due_at: str = ""
end

// The driver handle, rebuilt from the raw pointer. See Conn above.
func _db(c: Conn): mysql.Database:
    ret mysql.Database { handle = c.handle }
end

func _env(name: str, fallback: str): str:
    v := os.Env(name)
    if v.len() == 0: ret fallback end
    ret v
end

func _quote(c: Conn, s: str): str:
    ret "'".concat(mysql.Escape(_db(c), s)).concat("'")
end

func _num(v: i64): str:
    ret conv.FormatInt(v)
end

func _exec(c: Conn, sql: str, err &: str): bool:
    err = ""
    if mysql.Exec(_db(c), sql) != 0:
        err = mysql.Error(_db(c))
        ret false
    end
    ret true
end

func _scalar(c: Conn, sql: str): i64:
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret 0 as i64 end
    mut v := 0 as i64
    if mysql.Next(res): v = mysql.Int64(res, 0) end
    mysql.Finish(res)
    ret v
end

func _text_or_null(res: mysql.Result, col: int): str:
    if mysql.IsNull(res, col): ret "null" end
    ret json.Str(mysql.Text(res, col))
end

func _book_json(res: mysql.Result): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, `{"id":`)
    str.BufAppend(sb, mysql.Text(res, 0))
    str.BufAppend(sb, `,"isbn":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 1)))
    str.BufAppend(sb, `,"title":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 2)))
    str.BufAppend(sb, `,"author":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 3)))
    str.BufAppend(sb, `,"year":`)
    if mysql.IsNull(res, 4):
        str.BufAppend(sb, "null")
    else:
        str.BufAppend(sb, mysql.Text(res, 4))
    end
    str.BufAppend(sb, `,"copies_total":`)
    str.BufAppend(sb, mysql.Text(res, 5))
    str.BufAppend(sb, `,"copies_available":`)
    str.BufAppend(sb, mysql.Text(res, 6))
    str.BufAppendChar(sb, 125)
    out := str.BufStr(sb)
    ret out
end

// l.*, then the book's title and the member's email from the joins.
func _loan_json(res: mysql.Result): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, `{"id":`)
    str.BufAppend(sb, mysql.Text(res, 0))
    str.BufAppend(sb, `,"book_id":`)
    str.BufAppend(sb, mysql.Text(res, 1))
    str.BufAppend(sb, `,"title":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 2)))
    str.BufAppend(sb, `,"member":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 3)))
    str.BufAppend(sb, `,"borrowed_at":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 4)))
    str.BufAppend(sb, `,"due_at":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 5)))
    str.BufAppend(sb, `,"returned_at":`)
    str.BufAppend(sb, _text_or_null(res, 6))
    str.BufAppend(sb, `,"overdue":`)
    if mysql.Int(res, 7) == 1:
        str.BufAppend(sb, "true")
    else:
        str.BufAppend(sb, "false")
    end
    str.BufAppendChar(sb, 125)
    out := str.BufStr(sb)
    ret out
end

func _book_array(c: Conn, sql: str): str:
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _book_json(res))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

func _loan_array(c: Conn, sql: str): str:
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _loan_json(res))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

// The SELECT list every loan query uses, including the computed `overdue`.
func _loan_select(): str:
    mut s := "SELECT l.id, l.book_id, b.title, u.email, l.borrowed_at, l.due_at, l.returned_at,"
    s = s.concat(" (l.returned_at IS NULL AND l.due_at < CURDATE()) AS overdue")
    s = s.concat(" FROM loans l JOIN books b ON b.id = l.book_id JOIN users u ON u.id = l.user_id")
    ret s
end

func _book_row(c: Conn, id: i64): str:
    sql := "SELECT ".concat(BOOK_COLS).concat(" FROM books WHERE id = ").concat(_num(id)).concat(" LIMIT 1")
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "" end
    mut out := ""
    if mysql.Next(res): out = _book_json(res) end
    mysql.Finish(res)
    ret out
end

func _open_loans(c: Conn, user_id: i64): i64:
    mut sql := "SELECT COUNT(*) FROM loans WHERE user_id = ".concat(_num(user_id))
    sql = sql.concat(" AND returned_at IS NULL")
    ret _scalar(c, sql)
end

func _has_copy_out(c: Conn, user_id: i64, book_id: i64): bool:
    mut sql := "SELECT COUNT(*) FROM loans WHERE user_id = ".concat(_num(user_id))
    sql = sql.concat(" AND book_id = ").concat(_num(book_id)).concat(" AND returned_at IS NULL")
    ret _scalar(c, sql) > 0 as i64
end

func _loan_due(c: Conn, loan_id: i64): str:
    sql := "SELECT due_at FROM loans WHERE id = ".concat(_num(loan_id))
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "" end
    mut out := ""
    if mysql.Next(res): out = mysql.Text(res, 0) end
    mysql.Finish(res)
    ret out
end

// ---------------------------------------------------------------- connection

// Read the settings and prove they work, once, from main. Returns false with
// a reason rather than letting every request discover the problem separately.
pub func Configure(err &: str): bool:
    err = ""
    if !mysql.LibraryInit():
        err = "cannot initialise the MariaDB client library"
        ret false
    end
    _host = _env("DB_HOST", "127.0.0.1")
    _port = _env("DB_PORT", "3306").to_int()
    _user = _env("DB_USER", "root")
    // No default. A password compiled into a program is a password in the
    // repository, and a default of "" hides a missing one until production.
    _pass = os.Env("DB_PASS")
    _name = _env("DB_NAME", "salam_library")
    probe := Connect()
    if !probe.ok:
        err = probe.err
        ret false
    end
    Close(probe)
    ret true
end

// One connection, for one request, on the thread that will use it.
pub func Connect(): Conn:
    mut c := Conn {}
    // Per-thread driver state. Cheap after the first call on a thread, and
    // required before any other libmariadb call from it.
    _t := mysql.ThreadInit()
    d := mysql.Open(_host, _user, _pass, _name, _port)
    if !mysql.Ok(d):
        c.err = mysql.Error(d)
        // Even a failed handle has to be closed: mysql_init allocated it.
        mysql.Close(d)
        ret c
    end
    // Tell the server the connection speaks utf8mb4, or a 4-byte character
    // arrives mangled no matter what the column says.
    _x := mysql.SetCharset(d, "utf8mb4")
    c.handle = d.handle
    c.ok = true
    ret c
end

pub func Close(c: Conn):
    if c.handle != null: mysql.Close(_db(c)) end
end

pub func Ok(c: Conn): bool:
    ret c.ok
end

pub func Err(c: Conn): str:
    ret c.err
end

// Release the calling thread's driver state. A request thread does not need
// it - the thread dies with the request - but a long-lived worker that stops
// using the database should.
pub func ThreadDone():
    mysql.ThreadEnd()
end

pub func Shutdown():
    mysql.LibraryEnd()
end

// A string, escaped and quoted, ready to drop into SQL. Takes the connection
// because escaping depends on its character set.
pub func Q(c: Conn, s: str): str:
    ret _quote(c, s)
end

// A number, as SQL text. Going through i64 means a caller cannot smuggle
// anything but digits into the statement.
pub func N(v: i64): str:
    ret _num(v)
end

// ---------------------------------------------------------------- users

pub func CreateUser(c: Conn, email: str, hash: str, err &: str): i64:
    mut sql := "INSERT INTO users (email, pass_hash) VALUES ("
    sql = sql.concat(_quote(c, email)).concat(", ").concat(_quote(c, hash)).concat(")")
    if !_exec(c, sql, err): ret 0 as i64 end
    ret mysql.LastInsertId(_db(c))
end

pub func FindUser(c: Conn, email: str): User:
    mut u := User {}
    mut sql := "SELECT id, email, pass_hash, role FROM users WHERE email = "
    sql = sql.concat(_quote(c, email)).concat(" LIMIT 1")
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret u end
    if mysql.Next(res):
        u.id = mysql.Int64(res, 0)
        u.email = mysql.Text(res, 1)
        u.hash = mysql.Text(res, 2)
        u.role = mysql.Text(res, 3)
    end
    mysql.Finish(res)
    ret u
end

pub func IsLibrarian(c: Conn, user_id: i64): bool:
    sql := "SELECT COUNT(*) FROM users WHERE id = ".concat(_num(user_id)).concat(" AND role = 'librarian'")
    ret _scalar(c, sql) > 0 as i64
end

// ---------------------------------------------------------------- catalogue

pub func ListBooks(c: Conn, q: str, only_available: bool, limit: int, offset: int): str:
    mut sql := "SELECT ".concat(BOOK_COLS).concat(" FROM books WHERE 1 = 1")
    if q.len() > 0:
        like := _quote(c, "%".concat(q).concat("%"))
        sql = sql.concat(" AND (title LIKE ").concat(like).concat(" OR author LIKE ").concat(like)
        sql = sql.concat(" OR isbn LIKE ").concat(like).concat(")")
    end
    if only_available: sql = sql.concat(" AND copies_available > 0") end
    sql = sql.concat(" ORDER BY title ASC LIMIT ").concat(_num(limit as i64))
    sql = sql.concat(" OFFSET ").concat(_num(offset as i64))
    ret _book_array(c, sql)
end

pub func CountBooks(c: Conn, q: str, only_available: bool): i64:
    mut sql := "SELECT COUNT(*) FROM books WHERE 1 = 1"
    if q.len() > 0:
        like := _quote(c, "%".concat(q).concat("%"))
        sql = sql.concat(" AND (title LIKE ").concat(like).concat(" OR author LIKE ").concat(like)
        sql = sql.concat(" OR isbn LIKE ").concat(like).concat(")")
    end
    if only_available: sql = sql.concat(" AND copies_available > 0") end
    ret _scalar(c, sql)
end

pub func GetBook(c: Conn, id: i64): str:
    ret _book_row(c, id)
end

pub func AddBook(c: Conn, isbn: str, title: str, author: str, year: str, copies: int, err &: str): i64:
    mut cols := "isbn, title, author, copies_total, copies_available"
    mut vals := _quote(c, isbn).concat(", ").concat(_quote(c, title)).concat(", ").concat(_quote(c, author))
    vals = vals.concat(", ").concat(_num(copies as i64)).concat(", ").concat(_num(copies as i64))
    if year.len() > 0:
        cols = cols.concat(", published_year")
        vals = vals.concat(", ").concat(_quote(c, year))
    end
    sql := "INSERT INTO books (".concat(cols).concat(") VALUES (").concat(vals).concat(")")
    if !_exec(c, sql, err): ret 0 as i64 end
    ret mysql.LastInsertId(_db(c))
end

// Adding copies raises both counts; the CHECK constraint stops a librarian
// from lowering the total below what is currently on loan.
pub func AddCopies(c: Conn, id: i64, delta: int, err &: str): bool:
    mut sql := "UPDATE books SET copies_total = copies_total + ".concat(_num(delta as i64))
    sql = sql.concat(", copies_available = copies_available + ").concat(_num(delta as i64))
    sql = sql.concat(" WHERE id = ").concat(_num(id))
    if !_exec(c, sql, err): ret false end
    ret mysql.AffectedRows(_db(c)) > 0 as i64
end

pub func DeleteBook(c: Conn, id: i64, err &: str): bool:
    // Only when every copy is on the shelf. The foreign key would refuse it
    // anyway once a loan exists, but this gives a usable error instead of a
    // constraint violation.
    mut sql := "DELETE FROM books WHERE id = ".concat(_num(id))
    sql = sql.concat(" AND copies_available = copies_total")
    if !_exec(c, sql, err): ret false end
    ret mysql.AffectedRows(_db(c)) > 0 as i64
end

// ---------------------------------------------------------------- borrowing

pub func OpenLoanCount(c: Conn, user_id: i64): i64:
    ret _open_loans(c, user_id)
end

pub func HasCopyOut(c: Conn, user_id: i64, book_id: i64): bool:
    ret _has_copy_out(c, user_id, book_id)
end

// Lend one copy.
//
// The obvious way to do this is to SELECT the copy count, check it is above
// zero, then UPDATE it down by one - and that is wrong on any server with two
// clients, because another request can take the last copy in between. The fix
// is not a bigger lock, it is a smaller step: the condition moves INTO the
// update, and AffectedRows says whether this request was the one that got it.
//
// Now that each request has its own connection, two of these really do run at
// the same time - which is exactly the case the conditional UPDATE exists to
// survive, and what the concurrency check in the README exercises.
pub func Borrow(c: Conn, user_id: i64, book_id: i64): BorrowResult:
    mut r := BorrowResult {}
    if _book_row(c, book_id).len() == 0:
        r.reason = "no_book"
        ret r
    end
    // These two are policy, not integrity: a stale read here means at worst
    // a member briefly holding a fourth book, and no shelf count is harmed.
    // The copy count is the one that must not be raced, and it is not.
    if _open_loans(c, user_id) >= LOAN_LIMIT as i64:
        r.reason = "limit_reached"
        ret r
    end
    if _has_copy_out(c, user_id, book_id):
        r.reason = "already_out"
        ret r
    end
    mut err := ""
    if mysql.Begin(_db(c)) != 0:
        r.reason = "db"
        ret r
    end
    mut claim := "UPDATE books SET copies_available = copies_available - 1 WHERE id = "
    claim = claim.concat(_num(book_id)).concat(" AND copies_available > 0")
    if !_exec(c, claim, err):
        _r1 := mysql.Rollback(_db(c))
        r.reason = "db"
        ret r
    end
    // 0 rows means the last copy went to somebody else between the check
    // above and this statement. That is exactly the race this shape exists
    // to lose safely.
    if mysql.AffectedRows(_db(c)) == 0 as i64:
        _r2 := mysql.Rollback(_db(c))
        r.reason = "unavailable"
        ret r
    end
    mut ins := "INSERT INTO loans (book_id, user_id, due_at) VALUES ("
    ins = ins.concat(_num(book_id)).concat(", ").concat(_num(user_id))
    ins = ins.concat(", DATE_ADD(CURDATE(), INTERVAL ").concat(_num(LOAN_DAYS as i64)).concat(" DAY))")
    if !_exec(c, ins, err):
        _r3 := mysql.Rollback(_db(c))
        r.reason = "db"
        ret r
    end
    id := mysql.LastInsertId(_db(c))
    if mysql.Commit(_db(c)) != 0:
        _r4 := mysql.Rollback(_db(c))
        r.reason = "db"
        ret r
    end
    r.loan_id = id
    r.due_at = _loan_due(c, id)
    ret r
end

// Give it back. Same shape in reverse: the WHERE clause carries the "still
// out" condition, so returning twice cannot credit two copies.
pub func ReturnLoan(c: Conn, user_id: i64, loan_id: i64, librarian: bool): str:
    owner_sql := "SELECT user_id FROM loans WHERE id = ".concat(_num(loan_id))
    owner := _scalar(c, owner_sql)
    if owner == 0 as i64: ret "no_loan" end
    if owner != user_id && !librarian: ret "not_yours" end
    mut err := ""
    if mysql.Begin(_db(c)) != 0: ret "db" end
    mut close_sql := "UPDATE loans SET returned_at = NOW() WHERE id = ".concat(_num(loan_id))
    close_sql = close_sql.concat(" AND returned_at IS NULL")
    if !_exec(c, close_sql, err):
        _r1 := mysql.Rollback(_db(c))
        ret "db"
    end
    if mysql.AffectedRows(_db(c)) == 0 as i64:
        _r2 := mysql.Rollback(_db(c))
        ret "already_returned"
    end
    mut back := "UPDATE books SET copies_available = copies_available + 1 WHERE id ="
    back = back.concat(" (SELECT book_id FROM loans WHERE id = ").concat(_num(loan_id)).concat(")")
    if !_exec(c, back, err):
        _r3 := mysql.Rollback(_db(c))
        ret "db"
    end
    if mysql.Commit(_db(c)) != 0:
        _r4 := mysql.Rollback(_db(c))
        ret "db"
    end
    ret ""
end

pub func MyLoans(c: Conn, user_id: i64, open_only: bool): str:
    mut sql := _loan_select().concat(" WHERE l.user_id = ").concat(_num(user_id))
    if open_only: sql = sql.concat(" AND l.returned_at IS NULL") end
    sql = sql.concat(" ORDER BY l.id DESC LIMIT 100")
    ret _loan_array(c, sql)
end

pub func OverdueLoans(c: Conn): str:
    mut sql := _loan_select().concat(" WHERE l.returned_at IS NULL AND l.due_at < CURDATE()")
    sql = sql.concat(" ORDER BY l.due_at ASC LIMIT 200")
    ret _loan_array(c, sql)
end
