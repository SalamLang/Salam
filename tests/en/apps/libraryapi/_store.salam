package store

// SQL for the library API, and the one file in these examples that runs a
// transaction.
//
// BORROWING IS THE WHOLE POINT
//
// The obvious way to lend a book is: SELECT the copy count, check it is more
// than zero, then UPDATE it down by one. That code is wrong on any server
// with two clients. Between the SELECT and the UPDATE another request can do
// the same thing, and the last copy goes out twice.
//
// The fix is not a bigger lock, it is a smaller step. The condition moves
// INTO the update:
//
//     UPDATE books SET copies_available = copies_available - 1
//      WHERE id = ? AND copies_available > 0
//
// One statement. The database applies it atomically, and AffectedRows tells
// you whether YOU were the one who got the copy: 1 means yes, 0 means
// someone else took the last one between your read and your write. No
// SELECT ... FOR UPDATE, no retry loop, no lock held across a round trip.
//
// The transaction around it exists for a different reason: the loan row and
// the decremented count have to land together, or the shelf count drifts.
// Rollback on any failure, commit only when both are done.

import os
import sync
import str
import conv
import db.mysql
import encoding.json

const BOOK_COLS := "id, isbn, title, author, published_year, copies_total, copies_available"
const LOAN_LIMIT := 3
const LOAN_DAYS := 14

mut _db := mysql.Database {}
mut _mu := sync.Mutex {}

pub struct User:
    pub id: i64 = 0
    pub email: str = ""
    pub hash: str = ""
    pub role: str = ""
end

// A borrow attempt can fail in four ways the caller has to tell apart, so it
// returns a reason rather than a bool.
pub struct BorrowResult:
    pub loan_id: i64 = 0
    // "" on success, otherwise one of: no_book, unavailable, already_out,
    // limit_reached, db
    pub reason: str = ""
    pub due_at: str = ""
end

// Take the connection, and make this thread ready to use it.
//
// net/http runs every request on its own thread. libmariadb keeps per-thread
// state that mysql_thread_init() sets up, and a single MariaDB connection
// cannot be used by two threads at once - so every public entry point below
// prepares the thread and then holds _mu for the whole of its work.
//
// KNOWN ISSUE: this is necessary but is NOT currently sufficient. Two
// overlapping requests that both reach the database still crash the process,
// with two threads inside libmariadb at the same time despite this lock. See
// the "Known issue" section in ../README.md for the repro and what has been
// ruled out. Run these examples without overlapping requests until it is
// root-caused.
func _enter():
    _t := mysql.ThreadInit()
    sync.Lock(_mu)
end

func _env(name: str, fallback: str): str:
    v := os.Env(name)
    if v.len() == 0: ret fallback end
    ret v
end

func _exec(sql: str, err &: str): bool:
    err = ""
    if mysql.Exec(_db, sql) != 0:
        err = mysql.Error(_db)
        ret false
    end
    ret true
end

func _scalar(sql: str): i64:
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret 0 as i64 end
    mut v := 0 as i64
    if mysql.Next(res): v = mysql.Int64(res, 0) end
    mysql.Finish(res)
    ret v
end

func _text_or_null(res: mysql.Result, col: int): str:
    if mysql.IsNull(res, col): ret "null" end
    ret json.Str(mysql.Text(res, col))
end

func _book_json(res: mysql.Result): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, `{"id":`)
    str.BufAppend(sb, mysql.Text(res, 0))
    str.BufAppend(sb, `,"isbn":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 1)))
    str.BufAppend(sb, `,"title":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 2)))
    str.BufAppend(sb, `,"author":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 3)))
    str.BufAppend(sb, `,"year":`)
    if mysql.IsNull(res, 4):
        str.BufAppend(sb, "null")
    else:
        str.BufAppend(sb, mysql.Text(res, 4))
    end
    str.BufAppend(sb, `,"copies_total":`)
    str.BufAppend(sb, mysql.Text(res, 5))
    str.BufAppend(sb, `,"copies_available":`)
    str.BufAppend(sb, mysql.Text(res, 6))
    str.BufAppendChar(sb, 125)
    out := str.BufStr(sb)
    ret out
end

// l.*, then the book's title and the member's email from the joins.
func _loan_json(res: mysql.Result): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, `{"id":`)
    str.BufAppend(sb, mysql.Text(res, 0))
    str.BufAppend(sb, `,"book_id":`)
    str.BufAppend(sb, mysql.Text(res, 1))
    str.BufAppend(sb, `,"title":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 2)))
    str.BufAppend(sb, `,"member":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 3)))
    str.BufAppend(sb, `,"borrowed_at":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 4)))
    str.BufAppend(sb, `,"due_at":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 5)))
    str.BufAppend(sb, `,"returned_at":`)
    str.BufAppend(sb, _text_or_null(res, 6))
    str.BufAppend(sb, `,"overdue":`)
    if mysql.Int(res, 7) == 1:
        str.BufAppend(sb, "true")
    else:
        str.BufAppend(sb, "false")
    end
    str.BufAppendChar(sb, 125)
    out := str.BufStr(sb)
    ret out
end

func _book_array(sql: str): str:
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _book_json(res))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

func _loan_array(sql: str): str:
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _loan_json(res))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

// The SELECT list every loan query uses, including the computed `overdue`.
func _loan_select(): str:
    mut s := "SELECT l.id, l.book_id, b.title, u.email, l.borrowed_at, l.due_at, l.returned_at,"
    s = s.concat(" (l.returned_at IS NULL AND l.due_at < CURDATE()) AS overdue")
    s = s.concat(" FROM loans l JOIN books b ON b.id = l.book_id JOIN users u ON u.id = l.user_id")
    ret s
end

// Unlocked forms of the three checks Borrow makes while it already holds the
// mutex. The public wrappers below are the same calls with the lock taken.
func _book_row(id: i64): str:
    sql := "SELECT ".concat(BOOK_COLS).concat(" FROM books WHERE id = ").concat(N(id)).concat(" LIMIT 1")
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret "" end
    mut out := ""
    if mysql.Next(res): out = _book_json(res) end
    mysql.Finish(res)
    ret out
end

func _open_loans(user_id: i64): i64:
    mut sql := "SELECT COUNT(*) FROM loans WHERE user_id = ".concat(N(user_id))
    sql = sql.concat(" AND returned_at IS NULL")
    ret _scalar(sql)
end

func _has_copy_out(user_id: i64, book_id: i64): bool:
    mut sql := "SELECT COUNT(*) FROM loans WHERE user_id = ".concat(N(user_id))
    sql = sql.concat(" AND book_id = ").concat(N(book_id)).concat(" AND returned_at IS NULL")
    ret _scalar(sql) > 0 as i64
end

func _loan_due(loan_id: i64): str:
    sql := "SELECT due_at FROM loans WHERE id = ".concat(N(loan_id))
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret "" end
    mut out := ""
    if mysql.Next(res): out = mysql.Text(res, 0) end
    mysql.Finish(res)
    ret out
end

// net/http runs every connection on its own thread (see std/net/http's Run:
// one salam_spawn_fn_i64 per accepted socket), and a MariaDB connection is
// NOT safe to use from two threads at once. Sharing one connection without
// this mutex is not a subtle race: it segfaults, and before it does it hands
// one request another request's rows.
//
// Serializing database access - one query at a time across the whole process
// - is the honest cost of a single connection. The next step up is a pool: N
// connections behind the same mutex, each checked out for the length of one
// call. That is the right change to make when the lock shows up in a profile,
// and not before.
//
// Q() deliberately does NOT lock: the functions below call it while holding
// the mutex, and mysql_real_escape_string only reads the connection's charset
// rather than touching the socket.

// ---------------------------------------------------------------- connection
pub func Open(err &: str): bool:
    err = ""
    host := _env("DB_HOST", "127.0.0.1")
    port := _env("DB_PORT", "3306")
    user := _env("DB_USER", "root")
    pass := os.Env("DB_PASS")
    name := _env("DB_NAME", "salam_library")
    d := mysql.Open(host, user, pass, name, port.to_int())
    if !mysql.Ok(d):
        err = mysql.Error(d)
        ret false
    end
    _x := mysql.SetCharset(d, "utf8mb4")
    _db = d
    _mu = sync.NewMutex()
    ret true
end

pub func Close():
    mysql.Close(_db)
end

pub func Q(s: str): str:
    ret "'".concat(mysql.Escape(_db, s)).concat("'")
end

pub func N(v: i64): str:
    ret conv.FormatInt(v)
end

// ---------------------------------------------------------------- users
pub func CreateUser(email: str, hash: str, err &: str): i64:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "INSERT INTO users (email, pass_hash) VALUES ("
    sql = sql.concat(Q(email)).concat(", ").concat(Q(hash)).concat(")")
    if !_exec(sql, err): ret 0 as i64 end
    ret mysql.LastInsertId(_db)
end

pub func FindUser(email: str): User:
    _enter()
    defer sync.Unlock(_mu)
    mut u := User {}
    mut sql := "SELECT id, email, pass_hash, role FROM users WHERE email = "
    sql = sql.concat(Q(email)).concat(" LIMIT 1")
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret u end
    if mysql.Next(res):
        u.id = mysql.Int64(res, 0)
        u.email = mysql.Text(res, 1)
        u.hash = mysql.Text(res, 2)
        u.role = mysql.Text(res, 3)
    end
    mysql.Finish(res)
    ret u
end

pub func IsLibrarian(user_id: i64): bool:
    _enter()
    defer sync.Unlock(_mu)
    sql := "SELECT COUNT(*) FROM users WHERE id = ".concat(N(user_id)).concat(" AND role = 'librarian'")
    ret _scalar(sql) > 0 as i64
end

// ---------------------------------------------------------------- catalogue
pub func ListBooks(q: str, only_available: bool, limit: int, offset: int): str:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "SELECT ".concat(BOOK_COLS).concat(" FROM books WHERE 1 = 1")
    if q.len() > 0:
        like := Q("%".concat(q).concat("%"))
        sql = sql.concat(" AND (title LIKE ").concat(like).concat(" OR author LIKE ").concat(like)
        sql = sql.concat(" OR isbn LIKE ").concat(like).concat(")")
    end
    if only_available: sql = sql.concat(" AND copies_available > 0") end
    sql = sql.concat(" ORDER BY title ASC LIMIT ").concat(N(limit as i64))
    sql = sql.concat(" OFFSET ").concat(N(offset as i64))
    ret _book_array(sql)
end

pub func CountBooks(q: str, only_available: bool): i64:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "SELECT COUNT(*) FROM books WHERE 1 = 1"
    if q.len() > 0:
        like := Q("%".concat(q).concat("%"))
        sql = sql.concat(" AND (title LIKE ").concat(like).concat(" OR author LIKE ").concat(like)
        sql = sql.concat(" OR isbn LIKE ").concat(like).concat(")")
    end
    if only_available: sql = sql.concat(" AND copies_available > 0") end
    ret _scalar(sql)
end

pub func GetBook(id: i64): str:
    _enter()
    defer sync.Unlock(_mu)
    ret _book_row(id)
end

pub func AddBook(isbn: str, title: str, author: str, year: str, copies: int, err &: str): i64:
    _enter()
    defer sync.Unlock(_mu)
    mut cols := "isbn, title, author, copies_total, copies_available"
    mut vals := Q(isbn).concat(", ").concat(Q(title)).concat(", ").concat(Q(author))
    vals = vals.concat(", ").concat(N(copies as i64)).concat(", ").concat(N(copies as i64))
    if year.len() > 0:
        cols = cols.concat(", published_year")
        vals = vals.concat(", ").concat(Q(year))
    end
    sql := "INSERT INTO books (".concat(cols).concat(") VALUES (").concat(vals).concat(")")
    if !_exec(sql, err): ret 0 as i64 end
    ret mysql.LastInsertId(_db)
end

// Adding copies raises both counts; the CHECK constraint stops a librarian
// from lowering the total below what is currently on loan.
pub func AddCopies(id: i64, delta: int, err &: str): bool:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "UPDATE books SET copies_total = copies_total + ".concat(N(delta as i64))
    sql = sql.concat(", copies_available = copies_available + ").concat(N(delta as i64))
    sql = sql.concat(" WHERE id = ").concat(N(id))
    if !_exec(sql, err): ret false end
    ret mysql.AffectedRows(_db) > 0 as i64
end

pub func DeleteBook(id: i64, err &: str): bool:
    _enter()
    defer sync.Unlock(_mu)
    // Only when every copy is on the shelf. The foreign key would refuse it
    // anyway once a loan exists, but this gives a usable error instead of a
    // constraint violation.
    mut sql := "DELETE FROM books WHERE id = ".concat(N(id))
    sql = sql.concat(" AND copies_available = copies_total")
    if !_exec(sql, err): ret false end
    ret mysql.AffectedRows(_db) > 0 as i64
end

// ---------------------------------------------------------------- borrowing
pub func OpenLoanCount(user_id: i64): i64:
    _enter()
    defer sync.Unlock(_mu)
    ret _open_loans(user_id)
end

pub func HasCopyOut(user_id: i64, book_id: i64): bool:
    _enter()
    defer sync.Unlock(_mu)
    ret _has_copy_out(user_id, book_id)
end

// Lend one copy. See the header for why the availability check lives inside
// the UPDATE and not in front of it.
pub func Borrow(user_id: i64, book_id: i64): BorrowResult:
    _enter()
    defer sync.Unlock(_mu)
    mut r := BorrowResult {}
    if _book_row(book_id).len() == 0:
        r.reason = "no_book"
        ret r
    end
    // These two are policy, not integrity: a stale read here means at worst
    // a member briefly holding a fourth book, and no shelf count is harmed.
    // The copy count is the one that must not be raced, and it is not.
    if _open_loans(user_id) >= LOAN_LIMIT as i64:
        r.reason = "limit_reached"
        ret r
    end
    if _has_copy_out(user_id, book_id):
        r.reason = "already_out"
        ret r
    end
    mut err := ""
    if mysql.Begin(_db) != 0:
        r.reason = "db"
        ret r
    end
    mut claim := "UPDATE books SET copies_available = copies_available - 1 WHERE id = "
    claim = claim.concat(N(book_id)).concat(" AND copies_available > 0")
    if !_exec(claim, err):
        _r1 := mysql.Rollback(_db)
        r.reason = "db"
        ret r
    end
    // 0 rows means the last copy went to somebody else between the check
    // above and this statement. That is exactly the race this shape exists
    // to lose safely.
    if mysql.AffectedRows(_db) == 0 as i64:
        _r2 := mysql.Rollback(_db)
        r.reason = "unavailable"
        ret r
    end
    mut ins := "INSERT INTO loans (book_id, user_id, due_at) VALUES ("
    ins = ins.concat(N(book_id)).concat(", ").concat(N(user_id))
    ins = ins.concat(", DATE_ADD(CURDATE(), INTERVAL ").concat(N(LOAN_DAYS as i64)).concat(" DAY))")
    if !_exec(ins, err):
        _r3 := mysql.Rollback(_db)
        r.reason = "db"
        ret r
    end
    id := mysql.LastInsertId(_db)
    if mysql.Commit(_db) != 0:
        _r4 := mysql.Rollback(_db)
        r.reason = "db"
        ret r
    end
    r.loan_id = id
    r.due_at = _loan_due(id)
    ret r
end

// Give it back. Same shape in reverse: the WHERE clause carries the "still
// out" condition, so returning twice cannot credit two copies.
pub func ReturnLoan(user_id: i64, loan_id: i64, librarian: bool): str:
    _enter()
    defer sync.Unlock(_mu)
    owner_sql := "SELECT user_id FROM loans WHERE id = ".concat(N(loan_id))
    owner := _scalar(owner_sql)
    if owner == 0 as i64: ret "no_loan" end
    if owner != user_id && !librarian: ret "not_yours" end
    mut err := ""
    if mysql.Begin(_db) != 0: ret "db" end
    mut close := "UPDATE loans SET returned_at = NOW() WHERE id = ".concat(N(loan_id))
    close = close.concat(" AND returned_at IS NULL")
    if !_exec(close, err):
        _r1 := mysql.Rollback(_db)
        ret "db"
    end
    if mysql.AffectedRows(_db) == 0 as i64:
        _r2 := mysql.Rollback(_db)
        ret "already_returned"
    end
    mut back := "UPDATE books SET copies_available = copies_available + 1 WHERE id ="
    back = back.concat(" (SELECT book_id FROM loans WHERE id = ").concat(N(loan_id)).concat(")")
    if !_exec(back, err):
        _r3 := mysql.Rollback(_db)
        ret "db"
    end
    if mysql.Commit(_db) != 0:
        _r4 := mysql.Rollback(_db)
        ret "db"
    end
    ret ""
end

pub func MyLoans(user_id: i64, open_only: bool): str:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := _loan_select().concat(" WHERE l.user_id = ").concat(N(user_id))
    if open_only: sql = sql.concat(" AND l.returned_at IS NULL") end
    sql = sql.concat(" ORDER BY l.id DESC LIMIT 100")
    ret _loan_array(sql)
end

pub func OverdueLoans(): str:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := _loan_select().concat(" WHERE l.returned_at IS NULL AND l.due_at < CURDATE()")
    sql = sql.concat(" ORDER BY l.due_at ASC LIMIT 200")
    ret _loan_array(sql)
end
