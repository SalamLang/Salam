package main

// A lending library: a public catalogue, members who borrow, librarians who
// manage the shelves.
//
//   POST   /auth/register           {email, password}     -> member
//   POST   /auth/login
//   GET    /books                   ?q=&available=1       (public)
//   GET    /books/:id               (public)
//   POST   /api/books               {isbn, title, author, year?, copies?}  librarian
//   POST   /api/books/:id/copies    {delta}                                librarian
//   DELETE /api/books/:id           librarian, only when nothing is out
//   POST   /api/books/:id/borrow    member
//   POST   /api/loans/:id/return    the borrower, or a librarian
//   GET    /api/loans/mine          ?open=1
//   GET    /api/loans/overdue       librarian
//   GET    /health
//
// WHAT THIS ONE IS ABOUT
//
// The other examples answer "may you?". This one also has to answer "is it
// possible?" - and the second question has a race in it. Two members can ask
// for the last copy in the same millisecond, and exactly one of them must
// get it. _store.salam's Borrow is where that is handled; read its header.
//
// The other half is error vocabulary. "Cannot borrow" is four different
// answers, and a client needs to tell them apart to say anything useful:
//
//   404 no such book
//   409 every copy is out                  (try again later)
//   409 you already have this one          (you are looking at it)
//   409 you are at your three-book limit   (return something first)
//
// 409 Conflict, not 400: the request was well formed, the world just is not
// in a state where it can happen. A 400 tells the client to change the
// request, which is wrong advice here.

import os
import auth
import jwt
import conv
import net.http
import net.router
import encoding.json
import store "_store.salam"

const PORT := 8092
const ACCESS_TTL := 3600
const MAX_PAGE := 50

func secret(): str:
    s := os.Env("JWT_SECRET")
    if s.len() > 0: ret s end
    ret "dev-only-secret-change-me"
end

func guard(): auth.Guard:
    mut g := auth.NewGuard(secret())
    g.opts.issuer = "library.salam"
    g.opts.require_exp = true
    // Half a minute of tolerance on exp/nbf/iat. Not politeness: two
    // machines never agree on the time to the second, and without it a
    // token minted a moment ago can be refused as "issued in the future".
    g.opts.leeway = 30 as i64
    ret g
end

// ---------------------------------------------------------------- helpers

func send(ctx: i64, code: int, body: str):
    http.Ctx_status(ctx, code)
    http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
    http.Ctx_json(ctx, body)
end

func fail(ctx: i64, code: int, message: str):
    send(ctx, code, `{"error":`.concat(json.Str(message)).concat("}"))
end

func db_fail(ctx: i64, where: str, err: str):
    println "[db] ", where, ": ", err
    fail(ctx, 500, "database error")
end

func caller(ctx: i64): i64:
    mut t := jwt.Token {}
    if !auth.Require(ctx, guard(), t): ret 0 as i64 end
    ret t.claims.sub.to_int() as i64
end

// Signed in AND on the staff. The role lives in the database, so revoking it
// takes effect on the next request rather than on the next login.
func librarian(ctx: i64): i64:
    uid := caller(ctx)
    if uid == 0 as i64: ret 0 as i64 end
    if !store.IsLibrarian(uid):
        auth.Forbidden(ctx, "librarians only")
        ret 0 as i64
    end
    ret uid
end

func int_param(ctx: i64, name: str, fallback: int, max: int): int:
    raw := http.Ctx_query(ctx, name)
    if raw.len() == 0: ret fallback end
    v := raw.to_int()
    if v < 0: ret fallback end
    if v > max: ret max end
    ret v
end

func path_id(ctx: i64): i64:
    ret http.Ctx_param(ctx, "id").to_int() as i64
end

func borrow_message(reason: str): str:
    if reason == "unavailable": ret "every copy is on loan" end
    if reason == "already_out": ret "you already have a copy of this book" end
    if reason == "limit_reached": ret "you are at the three-book limit" end
    ret "could not borrow this book"
end

// ---------------------------------------------------------------- auth

func register(ctx: i64):
    body := http.Ctx_body(ctx)
    email := json.Get(body, "email").trim().lower()
    password := json.Get(body, "password")
    if email.len() < 3 || email.find("@") < 0:
        fail(ctx, 400, "a valid email is required")
        ret
    end
    if password.len() < 8:
        fail(ctx, 400, "password must be at least 8 characters")
        ret
    end
    if store.FindUser(email).id != 0 as i64:
        fail(ctx, 409, "that email is already registered")
        ret
    end
    mut err := ""
    id := store.CreateUser(email, auth.HashPassword(password), err)
    if id == 0 as i64:
        db_fail(ctx, "create user", err)
        ret
    end
    send(ctx, 201, `{"id":`.concat(conv.FormatInt(id)).concat(`,"email":`).concat(json.Str(email)).concat(`,"role":"member"}`))
end

func login(ctx: i64):
    body := http.Ctx_body(ctx)
    u := store.FindUser(json.Get(body, "email").trim().lower())
    mut stored := u.hash
    if stored.len() == 0: stored = auth.HashPassword("_no_such_user_") end
    ok := auth.VerifyPassword(json.Get(body, "password"), stored)
    if u.id == 0 as i64 || !ok:
        fail(ctx, 401, "invalid email or password")
        ret
    end
    mut c := jwt.NewClaims()
    c.sub = conv.FormatInt(u.id)
    mut err := 0
    token := auth.Issue(guard(), c, ACCESS_TTL as i64, err)
    if err != jwt.JWT_OK:
        fail(ctx, 500, "could not issue a token")
        ret
    end
    send(ctx, 200, `{"access":`.concat(json.Str(token)).concat(`,"role":`).concat(json.Str(u.role)).concat("}"))
end

// ---------------------------------------------------------------- catalogue

func list_books(ctx: i64):
    q := http.Ctx_query(ctx, "q")
    available := http.Ctx_query(ctx, "available") == "1"
    limit := int_param(ctx, "limit", 20, MAX_PAGE)
    offset := int_param(ctx, "offset", 0, 100000)
    items := store.ListBooks(q, available, limit, offset)
    total := store.CountBooks(q, available)
    send(ctx, 200, `{"items":`.concat(items).concat(`,"total":`).concat(conv.FormatInt(total)).concat("}"))
end

func get_book(ctx: i64):
    row := store.GetBook(path_id(ctx))
    if row.len() == 0:
        fail(ctx, 404, "no such book")
        ret
    end
    send(ctx, 200, row)
end

func add_book(ctx: i64):
    if librarian(ctx) == 0 as i64: ret end
    body := http.Ctx_body(ctx)
    isbn := json.Get(body, "isbn").trim()
    title := json.Get(body, "title").trim()
    author := json.Get(body, "author").trim()
    if isbn.len() == 0 || title.len() == 0 || author.len() == 0:
        fail(ctx, 400, "isbn, title and author are required")
        ret
    end
    mut copies := json.GetInt(body, "copies")
    if copies < 1: copies = 1 end
    if copies > 999: copies = 999 end
    mut err := ""
    id := store.AddBook(isbn, title, author, json.Get(body, "year"), copies, err)
    if id == 0 as i64:
        // The UNIQUE on isbn is what makes this reachable, and a duplicate
        // ISBN is the librarian's mistake to see, not a 500.
        if err.find("Duplicate") >= 0:
            fail(ctx, 409, "a book with that ISBN is already in the catalogue")
            ret
        end
        db_fail(ctx, "add book", err)
        ret
    end
    send(ctx, 201, store.GetBook(id))
end

func add_copies(ctx: i64):
    if librarian(ctx) == 0 as i64: ret end
    id := path_id(ctx)
    delta := json.GetInt(http.Ctx_body(ctx), "delta")
    if delta < 1 || delta > 100:
        fail(ctx, 400, "delta must be between 1 and 100")
        ret
    end
    mut err := ""
    if !store.AddCopies(id, delta, err):
        if err.len() > 0:
            db_fail(ctx, "add copies", err)
            ret
        end
        fail(ctx, 404, "no such book")
        ret
    end
    send(ctx, 200, store.GetBook(id))
end

func delete_book(ctx: i64):
    if librarian(ctx) == 0 as i64: ret end
    id := path_id(ctx)
    if store.GetBook(id).len() == 0:
        fail(ctx, 404, "no such book")
        ret
    end
    mut err := ""
    if !store.DeleteBook(id, err):
        if err.len() > 0:
            db_fail(ctx, "delete book", err)
            ret
        end
        // The DELETE matched nothing, and the book exists, so a copy is out.
        fail(ctx, 409, "some copies are still on loan")
        ret
    end
    send(ctx, 200, `{"deleted":true}`)
end

// ---------------------------------------------------------------- loans

func borrow(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    r := store.Borrow(uid, path_id(ctx))
    if r.reason == "no_book":
        fail(ctx, 404, "no such book")
        ret
    end
    if r.reason == "db":
        db_fail(ctx, "borrow", "transaction failed")
        ret
    end
    if r.reason.len() > 0:
        // 409: the request is fine, the shelf is not.
        send(ctx, 409, `{"error":`.concat(json.Str(borrow_message(r.reason))).concat(`,"reason":`).concat(json.Str(r.reason)).concat("}"))
        ret
    end
    send(ctx, 201, `{"loan_id":`.concat(conv.FormatInt(r.loan_id)).concat(`,"due_at":`).concat(json.Str(r.due_at)).concat("}"))
end

func return_loan(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    reason := store.ReturnLoan(uid, path_id(ctx), store.IsLibrarian(uid))
    if reason == "no_loan":
        fail(ctx, 404, "no such loan")
        ret
    end
    if reason == "not_yours":
        auth.Forbidden(ctx, "that is not your loan")
        ret
    end
    if reason == "already_returned":
        fail(ctx, 409, "that loan was already returned")
        ret
    end
    if reason.len() > 0:
        db_fail(ctx, "return", reason)
        ret
    end
    send(ctx, 200, `{"returned":true}`)
end

func my_loans(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    open_only := http.Ctx_query(ctx, "open") == "1"
    send(ctx, 200, store.MyLoans(uid, open_only))
end

func overdue(ctx: i64):
    if librarian(ctx) == 0 as i64: ret end
    send(ctx, 200, store.OverdueLoans())
end

func health(ctx: i64):
    send(ctx, 200, `{"status":"ok","service":"library"}`)
end

func main:
    mut err := ""
    if !store.Open(err):
        println "cannot reach the database: ", err
        println "set DB_HOST / DB_PORT / DB_USER / DB_PASS / DB_NAME, then load schema.sql"
        ret 1
    end
    defer store.Close()
    mut r := router.NewRouter()
    router.Post(r, "/auth/register", register)
    router.Post(r, "/auth/login", login)
    router.Get(r, "/books", list_books)
    router.Get(r, "/books/:id", get_book)
    router.Post(r, "/api/books", add_book)
    router.Post(r, "/api/books/:id/copies", add_copies)
    router.Post(r, "/api/books/:id/borrow", borrow)
    router.Delete(r, "/api/books/:id", delete_book)
    router.Post(r, "/api/loans/:id/return", return_loan)
    router.Get(r, "/api/loans/mine", my_loans)
    router.Get(r, "/api/loans/overdue", overdue)
    router.Get(r, "/health", health)
    mut s := http.NewServer(PORT)
    http.Use(s, r)
    println "library API on http://localhost:8092"
    http.Run(s)
    ret 0
end
