package main

import os
import jwt
import conv
import crypto
import net.http
import net.router
import encoding.json
import store "_store.salam"

const PORT := 8094
const ACCESS_TTL := 3600
const CODE_LEN := 7
const MAX_PAGE := 100

func secret(): str:
    s := os.Env("JWT_SECRET")
    if s.len() > 0: ret s end
    ret "dev-only-secret-change-me"
end

func guard(): jwt.Guard:
    mut g := jwt.NewGuard(secret())
    g.opts.issuer = "links.salam"
    g.opts.require_exp = true
    g.opts.leeway = 30 as i64
    ret g
end

func send(ctx: i64, code: int, body: str):
    http.Ctx_status(ctx, code)
    http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
    http.Ctx_json(ctx, body)
end

func fail(ctx: i64, code: int, message: str):
    send(ctx, code, `{"error":`.concat(json.Str(message)).concat("}"))
end

func db_fail(ctx: i64, where: str, err: str):
    println "[db] ", where, ": ", err
    fail(ctx, 500, "database error")
end

func db(ctx: i64, c &: store.Conn): bool:
    conn := store.Connect()
    if !store.Ok(conn):
        println "[db] connect: ", store.Err(conn)
        fail(ctx, 503, "database unavailable")
        ret false
    end
    c = conn
    ret true
end

func caller(ctx: i64): i64:
    mut t := jwt.Token {}
    if !jwt.Require(ctx, guard(), t): ret 0 as i64 end
    ret t.claims.sub.to_int() as i64
end

func int_param(ctx: i64, name: str, fallback: int, max: int): int:
    raw := http.Ctx_query(ctx, name)
    if raw.len() == 0: ret fallback end
    v := raw.to_int()
    if v < 0: ret fallback end
    if v > max: ret max end
    ret v
end

func safe_target(url: str): bool:
    if url.len() < 10 || url.len() > 2048: ret false end
    lower := url.lower()
    if lower.substr(0, 7) == "http://": ret true end
    if lower.substr(0, 8) == "https://": ret true end
    ret false
end

func valid_code(code: str): bool:
    n := code.len()
    if n < 3 || n > 32: ret false end
    repeat n with i:
        c := code.substr(i, 1)
        ok := (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "-" || c == "_"
        if !ok: ret false end
    end
    ret !reserved(code)
end

func reserved(code: str): bool:
    ret code == "api" || code == "auth" || code == "health" || code == "favicon.ico"
end

func fresh_code(conn: store.Conn): str:
    mut tries := 0
    until tries < 8:
        candidate := crypto.RandomHex(CODE_LEN).substr(0, CODE_LEN)
        if !store.CodeExists(conn, candidate): ret candidate end
        tries += 1
    end
    ret ""
end

func register(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    body := http.Ctx_body(ctx)
    email := json.Get(body, "email").trim().lower()
    password := json.Get(body, "password")
    if email.len() < 3 || email.find("@") < 0:
        fail(ctx, 400, "a valid email is required")
        ret
    end
    if password.len() < 8:
        fail(ctx, 400, "password must be at least 8 characters")
        ret
    end
    if store.FindUser(conn, email).id != 0 as i64:
        fail(ctx, 409, "that email is already registered")
        ret
    end
    mut err := ""
    id := store.CreateUser(conn, email, crypto.HashPassword(password), err)
    if id == 0 as i64:
        db_fail(ctx, "create user", err)
        ret
    end
    send(ctx, 201, `{"id":`.concat(conv.FormatInt(id)).concat(`,"email":`).concat(json.Str(email)).concat("}"))
end

func login(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    body := http.Ctx_body(ctx)
    u := store.FindUser(conn, json.Get(body, "email").trim().lower())
    mut stored := u.hash
    if stored.len() == 0: stored = crypto.HashPassword("_no_such_user_") end
    ok := crypto.VerifyPassword(json.Get(body, "password"), stored)
    if u.id == 0 as i64 || !ok:
        fail(ctx, 401, "invalid email or password")
        ret
    end
    mut c := jwt.NewClaims()
    c.sub = conv.FormatInt(u.id)
    mut err := 0
    token := jwt.Issue(guard(), c, ACCESS_TTL as i64, err)
    send(ctx, 200, `{"access":`.concat(json.Str(token)).concat("}"))
end

func create_link(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    body := http.Ctx_body(ctx)
    target := json.Get(body, "target").trim()
    if !safe_target(target):
        fail(ctx, 400, "target must be an absolute http:// or https:// URL")
        ret
    end
    mut code := json.Get(body, "code").trim()
    if code.len() == 0:
        code = fresh_code(conn)
        if code.len() == 0:
            fail(ctx, 500, "could not allocate a code")
            ret
        end
    else:
        if !valid_code(code):
            fail(ctx, 400, "code must be 3-32 characters of a-z, 0-9, - or _, and not a reserved word")
            ret
        end
    end
    mut err := ""
    reason := store.CreateLink(conn, uid, code, target, err)
    if reason == "taken":
        fail(ctx, 409, "that code is already in use")
        ret
    end
    if reason.len() > 0:
        db_fail(ctx, "create link", err)
        ret
    end
    http.Ctx_set_header(ctx, "Location", "/".concat(code))
    send(ctx, 201, store.GetLink(conn, code))
end

func my_links(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    limit := int_param(ctx, "limit", 20, MAX_PAGE)
    offset := int_param(ctx, "offset", 0, 100000)
    send(ctx, 200, store.MyLinks(conn, uid, limit, offset))
end

func own_code(conn: store.Conn, ctx: i64, uid: i64, code &: str): bool:
    c := http.Ctx_param(ctx, "code")
    owner := store.OwnerOf(conn, c)
    if owner == 0 as i64 || owner != uid:
        fail(ctx, 404, "no such link")
        ret false
    end
    code = c
    ret true
end

func get_link(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    mut code := ""
    if !own_code(conn, ctx, uid, code): ret end
    send(ctx, 200, store.GetLink(conn, code))
end

func link_stats(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    mut code := ""
    if !own_code(conn, ctx, uid, code): ret end
    l := store.Resolve(conn, code)
    days := int_param(ctx, "days", 30, 365)
    mut out := `{"code":`.concat(json.Str(code))
    out = out.concat(`,"daily":`).concat(store.DailyStats(conn, l.id, days))
    out = out.concat(`,"referrers":`).concat(store.TopReferrers(conn, l.id, 10))
    send(ctx, 200, out.concat("}"))
end

func update_link(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    mut code := ""
    if !own_code(conn, ctx, uid, code): ret end
    body := http.Ctx_body(ctx)
    if !json.Has(body, "disabled"):
        fail(ctx, 400, "nothing to update")
        ret
    end
    mut err := ""
    if !store.SetDisabled(conn, code, uid, json.Get(body, "disabled") == "true", err):
        db_fail(ctx, "update link", err)
        ret
    end
    send(ctx, 200, store.GetLink(conn, code))
end

func delete_link(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    mut code := ""
    if !own_code(conn, ctx, uid, code): ret end
    mut err := ""
    if !store.DeleteLink(conn, code, uid, err):
        db_fail(ctx, "delete link", err)
        ret
    end
    send(ctx, 200, `{"deleted":true}`)
end

func redirect(ctx: i64):
    mut conn := store.Conn {}
    if !db(ctx, conn): ret end
    defer store.Close(conn)
    code := http.Ctx_param(ctx, "code")
    l := store.Resolve(conn, code)
    if l.id == 0 as i64:
        fail(ctx, 404, "no such link")
        ret
    end
    if l.disabled:
        fail(ctx, 410, "this link has been disabled")
        ret
    end
    http.Ctx_redirect(ctx, l.target)
    store.RecordClick(conn, l.id, http.Ctx_header(ctx, "Referer"))
end

func health(ctx: i64):
    send(ctx, 200, `{"status":"ok","service":"links"}`)
end

func main:
    mut err := ""
    if !store.Configure(err):
        println "cannot reach the database: ", err
        println "set DB_HOST / DB_PORT / DB_USER / DB_PASS / DB_NAME, then load schema.sql"
        ret 1
    end
    defer store.Shutdown()
    mut r := router.NewRouter()
    router.Get(r, "/health", health)
    router.Post(r, "/auth/register", register)
    router.Post(r, "/auth/login", login)
    router.Post(r, "/api/links", create_link)
    router.Get(r, "/api/links", my_links)
    router.Get(r, "/api/links/:code", get_link)
    router.Get(r, "/api/links/:code/stats", link_stats)
    router.Patch(r, "/api/links/:code", update_link)
    router.Delete(r, "/api/links/:code", delete_link)
    router.Get(r, "/:code", redirect)
    mut s := http.NewServer(PORT)
    http.Use(s, r)
    println "links API on http://localhost:8094"
    http.Run(s)
    ret 0
end
