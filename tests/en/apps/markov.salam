package main

import str
import rand

func next word(words: Vector<str>, word: str): str:
    mut matches := Vector {} as Vector<str> defer matches.Free()
    mut i := 0
    until i < words.Len() - 1:
        if str.Equals(words.Get(i), word):
            matches.Push(words.Get(i + 1))
        end
        i++
    end
    if matches.Len() == 0:
        ret ""
    end
    choice := matches.Get(rand.IntN(matches.Len() as i64) as int)
    ret choice
end

func main:
    rand.Seed(7)
    corpus := "the cat sat on the mat the dog sat on the log the cat saw the dog and the dog saw the cat the mat was on the log"
    words := str.Split(corpus, " ")
    defer words.Free()
    repeat 4:
        mut cur := "the"
        mut out := cur
        mut steps := 0
        until steps < 9:
            nxt := next word(words, cur)
            if str.IsEmpty(nxt): steps = 9 else:
                out = out.Concat(" ").Concat(nxt)
                cur = nxt
                steps++
            end
        end
        println out.Concat(".")
    end
end
