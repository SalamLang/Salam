page:
    lang = "en"
    dir = "ltr"
    title = "Contact Us"
    form:
        id = "contactForm"
        input:
            id = "name"
            type = "text"
            required = true
        end
        button:
            type = "submit"
            content = "Submit"
        end
    end
end
