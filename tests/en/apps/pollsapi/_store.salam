package store

// SQL for the polls API.
//
// TWO IDEAS WORTH TAKING FROM THIS FILE
//
// 1. Let the database say no. "One vote per person" is a UNIQUE index, not
//    an `if` in Vote(). Checking first and inserting second leaves a window
//    where two requests both see no vote and both insert one. Here the
//    INSERT is attempted and error 1062 (duplicate key) is translated into
//    "already_voted" - the check and the write are the same operation, so
//    there is no window to lose.
//
// 2. Count at read time. There is no votes_count column. A tally is a
//    GROUP BY over the votes table, which cannot drift from the votes
//    themselves; a stored counter can, and eventually does. Store the count
//    only when the read volume makes it necessary, and know you are taking
//    on the job of keeping it true.

import os
import str
import conv
import db.mysql
import encoding.json

// MariaDB's duplicate-key error. The one error code this API reads, because
// it is the one that means something other than "broken".
const ER_DUP_ENTRY := 1062

// Connection settings, read once at startup and never written again. Sharing
// them across threads is safe precisely because nothing mutates them after
// Configure returns.
mut _host := "127.0.0.1"
mut _port := 3306
mut _user := "root"
mut _pass := ""
mut _name := "salam_polls"

// One request's connection.
//
// It holds the raw handle rather than a mysql.Database, and _db() rebuilds
// the struct on the way into the driver. That is a workaround, not a design:
// a struct field whose DEFAULT is a struct from another package makes the C
// backend emit the type name without its module prefix - (Database){0}
// instead of (mysql__Database){0} - and the generated C does not compile.
// A pointer field with a null default has no such problem.
pub struct Conn:
    pub handle: void* = null
    pub ok: bool = false
    pub err: str = ""
end

pub struct Poll:
    pub id: i64 = 0
    pub owner_id: i64 = 0
    pub closed: bool = false
    pub json: str = ""
end

pub struct User:
    pub id: i64 = 0
    pub email: str = ""
    pub hash: str = ""
end

// The driver handle, rebuilt from the raw pointer. See Conn above.
func _db(c: Conn): mysql.Database:
    ret mysql.Database { handle = c.handle }
end

func _quote(c: Conn, s: str): str:
    ret "'".concat(mysql.Escape(_db(c), s)).concat("'")
end

func _num(v: i64): str:
    ret conv.FormatInt(v)
end

func _env(name: str, fallback: str): str:
    v := os.Env(name)
    if v.len() == 0: ret fallback end
    ret v
end

func _exec(c: Conn, sql: str, err &: str): bool:
    err = ""
    if mysql.Exec(_db(c), sql) != 0:
        err = mysql.Error(_db(c))
        ret false
    end
    ret true
end

func _scalar(c: Conn, sql: str): i64:
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret 0 as i64 end
    mut v := 0 as i64
    if mysql.Next(res): v = mysql.Int64(res, 0) end
    mysql.Finish(res)
    ret v
end

// The options of one poll with their vote counts. LEFT JOIN, so an option
// nobody picked still comes back - with a zero, which is the answer.
func _tally_json(c: Conn, poll_id: i64): str:
    mut sql := "SELECT o.id, o.label, COUNT(v.id) FROM options o"
    sql = sql.concat(" LEFT JOIN votes v ON v.option_id = o.id")
    sql = sql.concat(" WHERE o.poll_id = ").concat(conv.FormatInt(poll_id))
    sql = sql.concat(" GROUP BY o.id, o.label, o.position ORDER BY o.position ASC, o.id ASC")
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, `{"id":`)
        str.BufAppend(sb, mysql.Text(res, 0))
        str.BufAppend(sb, `,"label":`)
        str.BufAppend(sb, json.Str(mysql.Text(res, 1)))
        str.BufAppend(sb, `,"votes":`)
        str.BufAppend(sb, mysql.Text(res, 2))
        str.BufAppendChar(sb, 125)
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

func _poll_row_json(c: Conn, res: mysql.Result, with_options: bool): str:
    id := mysql.Int64(res, 0)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, `{"id":`)
    str.BufAppend(sb, mysql.Text(res, 0))
    str.BufAppend(sb, `,"question":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 1)))
    str.BufAppend(sb, `,"closed":`)
    if mysql.Int(res, 2) == 1:
        str.BufAppend(sb, "true")
    else:
        str.BufAppend(sb, "false")
    end
    str.BufAppend(sb, `,"closes_at":`)
    if mysql.IsNull(res, 3):
        str.BufAppend(sb, "null")
    else:
        str.BufAppend(sb, json.Str(mysql.Text(res, 3)))
    end
    str.BufAppend(sb, `,"created_at":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 4)))
    str.BufAppend(sb, `,"owner":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 6)))
    str.BufAppend(sb, `,"votes":`)
    str.BufAppend(sb, mysql.Text(res, 7))
    if with_options:
        str.BufAppend(sb, `,"options":`)
        str.BufAppend(sb, _tally_json(c, id))
    end
    str.BufAppendChar(sb, 125)
    out := str.BufStr(sb)
    ret out
end

// p.id, question, closed, closes_at, created_at, owner_id, owner email, and
// the total vote count as a correlated subquery.
func _poll_select(): str:
    mut s := "SELECT p.id, p.question, p.closed, p.closes_at, p.created_at, p.owner_id, u.email,"
    s = s.concat(" (SELECT COUNT(*) FROM votes v WHERE v.poll_id = p.id) AS total")
    s = s.concat(" FROM polls p JOIN users u ON u.id = p.owner_id")
    ret s
end

func _one_poll(c: Conn, sql: str, with_options: bool): Poll:
    mut p := Poll {}
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret p end
    if mysql.Next(res):
        p.id = mysql.Int64(res, 0)
        p.owner_id = mysql.Int64(res, 5)
        p.closed = mysql.Int(res, 2) == 1
        p.json = _poll_row_json(c, res, with_options)
    end
    mysql.Finish(res)
    ret p
end

// ---------------------------------------------------------------- connection

// Read the settings and prove they work, once, from main. Returns false with
// a reason rather than letting every request discover the problem separately.
pub func Configure(err &: str): bool:
    err = ""
    if !mysql.LibraryInit():
        err = "cannot initialise the MariaDB client library"
        ret false
    end
    _host = _env("DB_HOST", "127.0.0.1")
    _port = _env("DB_PORT", "3306").to_int()
    _user = _env("DB_USER", "root")
    // No default. A password compiled into a program is a password in the
    // repository, and a default of "" hides a missing one until production.
    _pass = os.Env("DB_PASS")
    _name = _env("DB_NAME", "salam_polls")
    probe := Connect()
    if !probe.ok:
        err = probe.err
        ret false
    end
    Close(probe)
    ret true
end

// One connection, for one request, on the thread that will use it.
pub func Connect(): Conn:
    mut c := Conn {}
    // Per-thread driver state. Cheap after the first call on a thread, and
    // required before any other libmariadb call from it.
    _t := mysql.ThreadInit()
    d := mysql.Open(_host, _user, _pass, _name, _port)
    if !mysql.Ok(d):
        c.err = mysql.Error(d)
        // Even a failed handle has to be closed: mysql_init allocated it.
        mysql.Close(d)
        ret c
    end
    // Tell the server the connection speaks utf8mb4, or a 4-byte character
    // arrives mangled no matter what the column says.
    _x := mysql.SetCharset(d, "utf8mb4")
    c.handle = d.handle
    c.ok = true
    ret c
end

pub func Close(c: Conn):
    if c.handle != null: mysql.Close(_db(c)) end
end

pub func Ok(c: Conn): bool:
    ret c.ok
end

pub func Err(c: Conn): str:
    ret c.err
end

// Release the calling thread's driver state. A request thread does not need
// it - the thread dies with the request - but a long-lived worker that stops
// using the database should.
pub func ThreadDone():
    mysql.ThreadEnd()
end

pub func Shutdown():
    mysql.LibraryEnd()
end

// A string, escaped and quoted, ready to drop into SQL. Takes the connection
// because escaping depends on its character set.
pub func Q(c: Conn, s: str): str:
    ret _quote(c, s)
end

// A number, as SQL text. Going through i64 means a caller cannot smuggle
// anything but digits into the statement.
pub func N(v: i64): str:
    ret _num(v)
end

// ---------------------------------------------------------------- users
pub func CreateUser(c: Conn, email: str, hash: str, err &: str): i64:
    mut sql := "INSERT INTO users (email, pass_hash) VALUES ("
    sql = sql.concat(_quote(c, email)).concat(", ").concat(_quote(c, hash)).concat(")")
    if !_exec(c, sql, err): ret 0 as i64 end
    ret mysql.LastInsertId(_db(c))
end

pub func FindUser(c: Conn, email: str): User:
    mut u := User {}
    mut sql := "SELECT id, email, pass_hash FROM users WHERE email = "
    sql = sql.concat(_quote(c, email)).concat(" LIMIT 1")
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret u end
    if mysql.Next(res):
        u.id = mysql.Int64(res, 0)
        u.email = mysql.Text(res, 1)
        u.hash = mysql.Text(res, 2)
    end
    mysql.Finish(res)
    ret u
end

// ---------------------------------------------------------------- polls

// A poll and its options are one thing, so they are one transaction: a poll
// with no options is not half-created, it is a bug that would sit in the
// database looking like data.
pub func CreatePoll(c: Conn, owner_id: i64, question: str, closes_at: str, labels: Vector<str>, err &: str): i64:
    if mysql.Begin(_db(c)) != 0:
        err = "cannot start a transaction"
        ret 0 as i64
    end
    mut cols := "owner_id, question"
    mut vals := _num(owner_id).concat(", ").concat(_quote(c, question))
    if closes_at.len() > 0:
        cols = cols.concat(", closes_at")
        vals = vals.concat(", ").concat(_quote(c, closes_at))
    end
    sql := "INSERT INTO polls (".concat(cols).concat(") VALUES (").concat(vals).concat(")")
    if !_exec(c, sql, err):
        _r1 := mysql.Rollback(_db(c))
        ret 0 as i64
    end
    id := mysql.LastInsertId(_db(c))
    n := labels.len()
    repeat n with i:
        mut ins := "INSERT INTO options (poll_id, label, position) VALUES ("
        ins = ins.concat(_num(id)).concat(", ").concat(_quote(c, labels.get(i))).concat(", ").concat(_num(i as i64)).concat(")")
        if !_exec(c, ins, err):
            _r2 := mysql.Rollback(_db(c))
            ret 0 as i64
        end
    end
    if mysql.Commit(_db(c)) != 0:
        _r3 := mysql.Rollback(_db(c))
        err = "cannot commit"
        ret 0 as i64
    end
    ret id
end

pub func ListPolls(c: Conn, open_only: bool, limit: int, offset: int): str:
    mut sql := _poll_select()
    if open_only: sql = sql.concat(" WHERE p.closed = 0") end
    sql = sql.concat(" ORDER BY p.id DESC LIMIT ").concat(_num(limit as i64))
    sql = sql.concat(" OFFSET ").concat(_num(offset as i64))
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _poll_row_json(c, res, false))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

pub func GetPoll(c: Conn, id: i64): Poll:
    sql := _poll_select().concat(" WHERE p.id = ").concat(_num(id)).concat(" LIMIT 1")
    ret _one_poll(c, sql, true)
end

pub func MyPolls(c: Conn, owner_id: i64): str:
    mut sql := _poll_select().concat(" WHERE p.owner_id = ").concat(_num(owner_id))
    sql = sql.concat(" ORDER BY p.id DESC LIMIT 100")
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _poll_row_json(c, res, true))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

pub func ClosePoll(c: Conn, id: i64, err &: str): bool:
    sql := "UPDATE polls SET closed = 1 WHERE id = ".concat(_num(id))
    ret _exec(c, sql, err)
end

// ---------------------------------------------------------------- voting

// The option must belong to this poll. Without this check a caller could
// vote for an option id from a different poll entirely, and the tally would
// quietly lose their vote.
pub func OptionInPoll(c: Conn, poll_id: i64, option_id: i64): bool:
    mut sql := "SELECT COUNT(*) FROM options WHERE id = ".concat(_num(option_id))
    sql = sql.concat(" AND poll_id = ").concat(_num(poll_id))
    ret _scalar(c, sql) > 0 as i64
end

// Past its closing time, or closed by hand. Evaluated by the SERVER, so a
// client with a wrong clock cannot vote late.
pub func IsExpired(c: Conn, poll_id: i64): bool:
    mut sql := "SELECT COUNT(*) FROM polls WHERE id = ".concat(_num(poll_id))
    sql = sql.concat(" AND (closed = 1 OR (closes_at IS NOT NULL AND closes_at <= NOW()))")
    ret _scalar(c, sql) > 0 as i64
end

// "" on success. "already_voted" comes from the UNIQUE index rather than
// from a check this code performs - see the header.
pub func Vote(c: Conn, poll_id: i64, option_id: i64, user_id: i64): str:
    mut sql := "INSERT INTO votes (poll_id, option_id, user_id) VALUES ("
    sql = sql.concat(_num(poll_id)).concat(", ").concat(_num(option_id)).concat(", ").concat(_num(user_id)).concat(")")
    mut err := ""
    if _exec(c, sql, err): ret "" end
    if mysql.Errno(_db(c)) == ER_DUP_ENTRY: ret "already_voted" end
    println "[db] vote: ", err
    ret "db"
end

// 0 when this user has not voted in this poll.
pub func MyVote(c: Conn, poll_id: i64, user_id: i64): i64:
    mut sql := "SELECT option_id FROM votes WHERE poll_id = ".concat(_num(poll_id))
    sql = sql.concat(" AND user_id = ").concat(_num(user_id)).concat(" LIMIT 1")
    ret _scalar(c, sql)
end

// Changing your mind: allowed while the poll is open, and it is an UPDATE of
// the one row the UNIQUE index guarantees exists, so there is still exactly
// one vote afterwards.
pub func ChangeVote(c: Conn, poll_id: i64, option_id: i64, user_id: i64, err &: str): bool:
    mut sql := "UPDATE votes SET option_id = ".concat(_num(option_id))
    sql = sql.concat(" WHERE poll_id = ").concat(_num(poll_id)).concat(" AND user_id = ").concat(_num(user_id))
    ret _exec(c, sql, err)
end
