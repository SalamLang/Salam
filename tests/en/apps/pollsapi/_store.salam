package store

// SQL for the polls API.
//
// TWO IDEAS WORTH TAKING FROM THIS FILE
//
// 1. Let the database say no. "One vote per person" is a UNIQUE index, not
//    an `if` in Vote(). Checking first and inserting second leaves a window
//    where two requests both see no vote and both insert one. Here the
//    INSERT is attempted and error 1062 (duplicate key) is translated into
//    "already_voted" - the check and the write are the same operation, so
//    there is no window to lose.
//
// 2. Count at read time. There is no votes_count column. A tally is a
//    GROUP BY over the votes table, which cannot drift from the votes
//    themselves; a stored counter can, and eventually does. Store the count
//    only when the read volume makes it necessary, and know you are taking
//    on the job of keeping it true.

import os
import sync
import str
import conv
import db.mysql
import encoding.json

// MariaDB's duplicate-key error. The one error code this API reads, because
// it is the one that means something other than "broken".
const ER_DUP_ENTRY := 1062

mut _db := mysql.Database {}
mut _mu := sync.Mutex {}

pub struct Poll:
    pub id: i64 = 0
    pub owner_id: i64 = 0
    pub closed: bool = false
    pub json: str = ""
end

pub struct User:
    pub id: i64 = 0
    pub email: str = ""
    pub hash: str = ""
end

// Take the connection, and make this thread ready to use it.
//
// net/http runs every request on its own thread. libmariadb keeps per-thread
// state that mysql_thread_init() sets up, and a single MariaDB connection
// cannot be used by two threads at once - so every public entry point below
// prepares the thread and then holds _mu for the whole of its work.
//
// KNOWN ISSUE: this is necessary but is NOT currently sufficient. Two
// overlapping requests that both reach the database still crash the process,
// with two threads inside libmariadb at the same time despite this lock. See
// the "Known issue" section in ../README.md for the repro and what has been
// ruled out. Run these examples without overlapping requests until it is
// root-caused.
func _enter():
    _t := mysql.ThreadInit()
    sync.Lock(_mu)
end

func _env(name: str, fallback: str): str:
    v := os.Env(name)
    if v.len() == 0: ret fallback end
    ret v
end

func _exec(sql: str, err &: str): bool:
    err = ""
    if mysql.Exec(_db, sql) != 0:
        err = mysql.Error(_db)
        ret false
    end
    ret true
end

func _scalar(sql: str): i64:
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret 0 as i64 end
    mut v := 0 as i64
    if mysql.Next(res): v = mysql.Int64(res, 0) end
    mysql.Finish(res)
    ret v
end

// The options of one poll with their vote counts. LEFT JOIN, so an option
// nobody picked still comes back - with a zero, which is the answer.
func _tally_json(poll_id: i64): str:
    mut sql := "SELECT o.id, o.label, COUNT(v.id) FROM options o"
    sql = sql.concat(" LEFT JOIN votes v ON v.option_id = o.id")
    sql = sql.concat(" WHERE o.poll_id = ").concat(conv.FormatInt(poll_id))
    sql = sql.concat(" GROUP BY o.id, o.label, o.position ORDER BY o.position ASC, o.id ASC")
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, `{"id":`)
        str.BufAppend(sb, mysql.Text(res, 0))
        str.BufAppend(sb, `,"label":`)
        str.BufAppend(sb, json.Str(mysql.Text(res, 1)))
        str.BufAppend(sb, `,"votes":`)
        str.BufAppend(sb, mysql.Text(res, 2))
        str.BufAppendChar(sb, 125)
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

func _poll_row_json(res: mysql.Result, with_options: bool): str:
    id := mysql.Int64(res, 0)
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, `{"id":`)
    str.BufAppend(sb, mysql.Text(res, 0))
    str.BufAppend(sb, `,"question":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 1)))
    str.BufAppend(sb, `,"closed":`)
    if mysql.Int(res, 2) == 1:
        str.BufAppend(sb, "true")
    else:
        str.BufAppend(sb, "false")
    end
    str.BufAppend(sb, `,"closes_at":`)
    if mysql.IsNull(res, 3):
        str.BufAppend(sb, "null")
    else:
        str.BufAppend(sb, json.Str(mysql.Text(res, 3)))
    end
    str.BufAppend(sb, `,"created_at":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 4)))
    str.BufAppend(sb, `,"owner":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 6)))
    str.BufAppend(sb, `,"votes":`)
    str.BufAppend(sb, mysql.Text(res, 7))
    if with_options:
        str.BufAppend(sb, `,"options":`)
        str.BufAppend(sb, _tally_json(id))
    end
    str.BufAppendChar(sb, 125)
    out := str.BufStr(sb)
    ret out
end

// p.id, question, closed, closes_at, created_at, owner_id, owner email, and
// the total vote count as a correlated subquery.
func _poll_select(): str:
    mut s := "SELECT p.id, p.question, p.closed, p.closes_at, p.created_at, p.owner_id, u.email,"
    s = s.concat(" (SELECT COUNT(*) FROM votes v WHERE v.poll_id = p.id) AS total")
    s = s.concat(" FROM polls p JOIN users u ON u.id = p.owner_id")
    ret s
end

func _one_poll(sql: str, with_options: bool): Poll:
    mut p := Poll {}
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret p end
    if mysql.Next(res):
        p.id = mysql.Int64(res, 0)
        p.owner_id = mysql.Int64(res, 5)
        p.closed = mysql.Int(res, 2) == 1
        p.json = _poll_row_json(res, with_options)
    end
    mysql.Finish(res)
    ret p
end

// net/http runs every connection on its own thread (see std/net/http's Run:
// one salam_spawn_fn_i64 per accepted socket), and a MariaDB connection is
// NOT safe to use from two threads at once. Sharing one connection without
// this mutex is not a subtle race: it segfaults, and before it does it hands
// one request another request's rows.
//
// Serializing database access - one query at a time across the whole process
// - is the honest cost of a single connection. The next step up is a pool: N
// connections behind the same mutex, each checked out for the length of one
// call. That is the right change to make when the lock shows up in a profile,
// and not before.
//
// Q() deliberately does NOT lock: the functions below call it while holding
// the mutex, and mysql_real_escape_string only reads the connection's charset
// rather than touching the socket.

// ---------------------------------------------------------------- connection

pub func Open(err &: str): bool:
    err = ""
    host := _env("DB_HOST", "127.0.0.1")
    port := _env("DB_PORT", "3306")
    user := _env("DB_USER", "root")
    pass := os.Env("DB_PASS")
    name := _env("DB_NAME", "salam_polls")
    d := mysql.Open(host, user, pass, name, port.to_int())
    if !mysql.Ok(d):
        err = mysql.Error(d)
        ret false
    end
    _x := mysql.SetCharset(d, "utf8mb4")
    _db = d
    _mu = sync.NewMutex()
    ret true
end

pub func Close():
    mysql.Close(_db)
end

pub func Q(s: str): str:
    ret "'".concat(mysql.Escape(_db, s)).concat("'")
end

pub func N(v: i64): str:
    ret conv.FormatInt(v)
end

// ---------------------------------------------------------------- users
pub func CreateUser(email: str, hash: str, err &: str): i64:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "INSERT INTO users (email, pass_hash) VALUES ("
    sql = sql.concat(Q(email)).concat(", ").concat(Q(hash)).concat(")")
    if !_exec(sql, err): ret 0 as i64 end
    ret mysql.LastInsertId(_db)
end

pub func FindUser(email: str): User:
    _enter()
    defer sync.Unlock(_mu)
    mut u := User {}
    mut sql := "SELECT id, email, pass_hash FROM users WHERE email = "
    sql = sql.concat(Q(email)).concat(" LIMIT 1")
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret u end
    if mysql.Next(res):
        u.id = mysql.Int64(res, 0)
        u.email = mysql.Text(res, 1)
        u.hash = mysql.Text(res, 2)
    end
    mysql.Finish(res)
    ret u
end

// ---------------------------------------------------------------- polls

// A poll and its options are one thing, so they are one transaction: a poll
// with no options is not half-created, it is a bug that would sit in the
// database looking like data.
pub func CreatePoll(owner_id: i64, question: str, closes_at: str, labels: Vector<str>, err &: str): i64:
    _enter()
    defer sync.Unlock(_mu)
    if mysql.Begin(_db) != 0:
        err = "cannot start a transaction"
        ret 0 as i64
    end
    mut cols := "owner_id, question"
    mut vals := N(owner_id).concat(", ").concat(Q(question))
    if closes_at.len() > 0:
        cols = cols.concat(", closes_at")
        vals = vals.concat(", ").concat(Q(closes_at))
    end
    sql := "INSERT INTO polls (".concat(cols).concat(") VALUES (").concat(vals).concat(")")
    if !_exec(sql, err):
        _r1 := mysql.Rollback(_db)
        ret 0 as i64
    end
    id := mysql.LastInsertId(_db)
    n := labels.len()
    repeat n with i:
        mut ins := "INSERT INTO options (poll_id, label, position) VALUES ("
        ins = ins.concat(N(id)).concat(", ").concat(Q(labels.get(i)[0])).concat(", ").concat(N(i as i64)).concat(")")
        if !_exec(ins, err):
            _r2 := mysql.Rollback(_db)
            ret 0 as i64
        end
    end
    if mysql.Commit(_db) != 0:
        _r3 := mysql.Rollback(_db)
        err = "cannot commit"
        ret 0 as i64
    end
    ret id
end

pub func ListPolls(open_only: bool, limit: int, offset: int): str:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := _poll_select()
    if open_only: sql = sql.concat(" WHERE p.closed = 0") end
    sql = sql.concat(" ORDER BY p.id DESC LIMIT ").concat(N(limit as i64))
    sql = sql.concat(" OFFSET ").concat(N(offset as i64))
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _poll_row_json(res, false))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

pub func GetPoll(id: i64): Poll:
    _enter()
    defer sync.Unlock(_mu)
    sql := _poll_select().concat(" WHERE p.id = ").concat(N(id)).concat(" LIMIT 1")
    ret _one_poll(sql, true)
end

pub func MyPolls(owner_id: i64): str:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := _poll_select().concat(" WHERE p.owner_id = ").concat(N(owner_id))
    sql = sql.concat(" ORDER BY p.id DESC LIMIT 100")
    mut res := mysql.Query(_db, sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _poll_row_json(res, true))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

pub func ClosePoll(id: i64, err &: str): bool:
    _enter()
    defer sync.Unlock(_mu)
    sql := "UPDATE polls SET closed = 1 WHERE id = ".concat(N(id))
    ret _exec(sql, err)
end

// ---------------------------------------------------------------- voting

// The option must belong to this poll. Without this check a caller could
// vote for an option id from a different poll entirely, and the tally would
// quietly lose their vote.
pub func OptionInPoll(poll_id: i64, option_id: i64): bool:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "SELECT COUNT(*) FROM options WHERE id = ".concat(N(option_id))
    sql = sql.concat(" AND poll_id = ").concat(N(poll_id))
    ret _scalar(sql) > 0 as i64
end

// Past its closing time, or closed by hand. Evaluated by the SERVER, so a
// client with a wrong clock cannot vote late.
pub func IsExpired(poll_id: i64): bool:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "SELECT COUNT(*) FROM polls WHERE id = ".concat(N(poll_id))
    sql = sql.concat(" AND (closed = 1 OR (closes_at IS NOT NULL AND closes_at <= NOW()))")
    ret _scalar(sql) > 0 as i64
end

// "" on success. "already_voted" comes from the UNIQUE index rather than
// from a check this code performs - see the header.
pub func Vote(poll_id: i64, option_id: i64, user_id: i64): str:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "INSERT INTO votes (poll_id, option_id, user_id) VALUES ("
    sql = sql.concat(N(poll_id)).concat(", ").concat(N(option_id)).concat(", ").concat(N(user_id)).concat(")")
    mut err := ""
    if _exec(sql, err): ret "" end
    if mysql.Errno(_db) == ER_DUP_ENTRY: ret "already_voted" end
    println "[db] vote: ", err
    ret "db"
end

// 0 when this user has not voted in this poll.
pub func MyVote(poll_id: i64, user_id: i64): i64:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "SELECT option_id FROM votes WHERE poll_id = ".concat(N(poll_id))
    sql = sql.concat(" AND user_id = ").concat(N(user_id)).concat(" LIMIT 1")
    ret _scalar(sql)
end

// Changing your mind: allowed while the poll is open, and it is an UPDATE of
// the one row the UNIQUE index guarantees exists, so there is still exactly
// one vote afterwards.
pub func ChangeVote(poll_id: i64, option_id: i64, user_id: i64, err &: str): bool:
    _enter()
    defer sync.Unlock(_mu)
    mut sql := "UPDATE votes SET option_id = ".concat(N(option_id))
    sql = sql.concat(" WHERE poll_id = ").concat(N(poll_id)).concat(" AND user_id = ").concat(N(user_id))
    ret _exec(sql, err)
end
