// Acknowledgements, all the way round.
//
// Socket.IO acknowledgements are a request/response channel hidden inside a
// fire-and-forget one, and they go both ways: the client can ask the server
// to confirm an event, and the server can ask the client. Either side may
// answer with bytes rather than JSON, and either side may never answer at
// all - which is the case worth testing, because a client that waits for an
// answer it will never get is a client that has stopped.

import net.socketio
import net.websocket
import sync
import str
import mem

const PORT := 19419

mut ready := sync.NewWaitGroup()
mut server log := ""
mut closed from handler := false

func ack id of(text: str): int:
    mut i := 1
    mut id := 0
    mut seen := false
    until i < text.len():
        c := char_code(text.substr(i, 1))
        if c < 48 || c > 57:
            i = text.len()
        else:
            id = id * 10 + (c - 48)
            seen = true
            i += 1
        end
    end
    if !seen:
        ret 0 - 1
    end
    ret id
end

func sio server():
    srv := websocket.Listen(PORT)
    sync.Done(ready)
    if !websocket.Ok(srv):
        ret
    end
    mut c := websocket.Accept(srv)
    if !websocket.IsOpen(c):
        websocket.CloseServer(srv)
        ret
    end
    websocket.SendText(c, `0{"sid":"acks","upgrades":[],"pingInterval":30000,"pingTimeout":30000}`)
    mut going := true
    mut idle := 0
    until going:
        m := websocket.Poll(c, 2000)
        if m.kind == websocket.TIMEOUT:
            idle += 1
            if idle > 30:
                going = false
            end
        else m.kind != websocket.TEXT:
            going = false
        else:
            idle = 0
            body := m.text.substr(1, m.text.len() - 1)
            if body == "0":
                websocket.SendText(c, `40{"sid":"acks-nsp"}`)
                // The server asks the client to confirm something. Ack id 5.
                websocket.SendText(c, `425["confirm","please"]`)
            else str.StartsWith(body, "3") && str.Contains(body, "confirmed"):
                server log += "client confirmed: " + body + ";"
            else str.StartsWith(body, "2") && str.Contains(body, `"sum"`):
                websocket.SendText(c, "43" + ack id of(body) + "[7]")
            else str.StartsWith(body, "2") && str.Contains(body, `"quiet"`):
                // Never answered, on purpose.
                server log += "stayed quiet;"
            else str.StartsWith(body, "2") && str.Contains(body, `"blob"`):
                // A BINARY_ACK: one attachment, then the buffer itself.
                websocket.SendText(c, "461-" + ack id of(body) + `[{"_placeholder":true,"num":0}]`)
                raw := mem.Allocate(3 as u64)
                bp := raw as i8*
                bp[0] = 7 as i8
                bp[1] = 0 as i8
                bp[2] = 9 as i8
                websocket.SendBinaryBytes(c, raw, 3)
                mem.Free(raw)
            else str.StartsWith(body, "2") && str.Contains(body, `"last"`):
                websocket.SendText(c, `42["last","here"]`)
            else body == "1":
                going = false
            end
        end
    end
    websocket.Close(c)
    websocket.CloseServer(srv)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(sio server)
    sync.Wait(ready)

    mut o := socketio.NewOptions()
    o.transports = socketio.TRANSPORT_WEBSOCKET
    o.timeout = 3000
    o.reconnection = false
    c := socketio.DialWith("http://127.0.0.1:" + PORT, o)
    println "connected:", socketio.IsConnected(c)

    println "-- the server asks the client"
    mut asked := 0 - 1
    mut i := 0
    until i < 12 && asked < 0:
        mut ev := socketio.NextEvent(c, 250)
        if ev.name == "confirm":
            asked = ev.ack_id
            println "asked to confirm:", socketio.ArgStr(ev, 0), "ack id:", ev.ack_id
            socketio.ReplyStr(ev, "confirmed")
        end
        socketio.EventFree(ev)
        i += 1
    end
    println "answered:", asked >= 0

    println "-- the client asks the server"
    mut a := socketio.NewArgs()
    socketio.AddInt(a, 3)
    socketio.AddInt(a, 4)
    mut ack := socketio.EmitAck(c, "sum", a, 2000)
    socketio.ArgsFree(a)
    println "answered:", ack.ok, "value:", socketio.AckInt(ack, 0), "count:", socketio.AckCount(ack)
    socketio.AckFree(ack)

    println "-- an answer that never comes"
    mut q := socketio.NewArgs()
    mut late := socketio.EmitAck(c, "quiet", q, 250)
    socketio.ArgsFree(q)
    println "timed out:", !late.ok, "no data:", socketio.AckCount(late)
    socketio.AckFree(late)
    println "nothing left waiting:", socketio.Pending(c)

    println "-- an answer made of bytes"
    mut b := socketio.NewArgs()
    mut bin ack := socketio.EmitAck(c, "blob", b, 2000)
    socketio.ArgsFree(b)
    println "answered:", bin ack.ok, "is binary:", socketio.AckIsBinary(bin ack, 0)
    got := socketio.AckBytes(bin ack, 0)
    println "bytes:", got.len, socketio.BytesAt(got, 0), socketio.BytesAt(got, 1), socketio.BytesAt(got, 2)
    println "base64:", socketio.BytesToBase64(got)
    socketio.AckFree(bin ack)
    println "released:", socketio.AckBytes(bin ack, 0).len

    println "-- Close from inside a handler disconnects, and does not free"
    // The dispatch loop is standing on the memory Close would release, so it
    // degrades to Disconnect rather than pulling the floor out.
    socketio.On(c, "last", (e: socketio.Event):
        socketio.Close(e.client)
        closed from handler = true
    end)
    socketio.Emit(c, "last")
    mut j := 0
    until j < 12 && !closed from handler:
        mut ev := socketio.Next(c, 250)
        socketio.EventFree(ev)
        j += 1
    end
    println "handler ran:", closed from handler
    println "disconnected by it:", !socketio.IsConnected(c), "and not active:", !socketio.Active(c)
    // Still a live handle, so the driving loop can release it properly.
    println "queued events still readable:", socketio.Queued(c) >= 0
    socketio.Close(c)

    join(t)
    println "server saw:", server log
end
