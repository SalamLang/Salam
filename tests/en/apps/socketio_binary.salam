// Binary attachments, in both directions and in both packet types.
//
// JSON cannot hold bytes, so Socket.IO sends a binary event as ordinary JSON
// with `{"_placeholder":true,"num":N}` where each buffer belonged, followed
// by the buffers as their own frames. Every byte value has to survive that,
// NUL included - which is exactly what a Salam `str` cannot carry, and why
// the API deals in Bytes here rather than text.

import net.socketio
import net.websocket
import sync
import str
import mem

const PORT := 19415

mut ready := sync.NewWaitGroup()
mut server log := ""

func ack id of(text: str): int:
    mut i := 1
    mut id := 0
    mut seen := false
    until i < text.len():
        c := char_code(text.substr(i, 1))
        if c < 48 || c > 57:
            i = text.len()
        else:
            id = id * 10 + (c - 48)
            seen = true
            i += 1
        end
    end
    if !seen:
        ret 0 - 1
    end
    ret id
end

func describe(m: websocket.Message): str:
    mut out := "" + m.len + "["
    repeat m.len with i:
        if i > 0:
            out += " "
        end
        bp := m.data as i8*
        mut v := bp[i] as int
        if v < 0:
            v += 256
        end
        out += "" + v
    end
    ret out + "]"
end

func sio server():
    srv := websocket.Listen(PORT)
    sync.Done(ready)
    if !websocket.Ok(srv):
        ret
    end
    mut c := websocket.Accept(srv)
    if !websocket.IsOpen(c):
        websocket.CloseServer(srv)
        ret
    end
    websocket.SendText(c, `0{"sid":"bin","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    mut pending ack := 0 - 1
    mut going := true
    mut idle := 0
    // A poll that times out is not the end of anything - under a loaded
    // test runner the client can be several seconds between packets - so it
    // only counts towards a hard stop that stops this thread wedging.
    until going:
        m := websocket.Poll(c, 2000)
        if m.kind == websocket.TIMEOUT:
            idle += 1
            if idle > 30:
                going = false
            end
        else m.kind == websocket.BINARY:
            idle = 0
            // The buffers that belong to the packet just before them.
            server log += "bin" + describe(m) + ";"
            if pending ack >= 0:
                websocket.SendText(c, "43" + pending ack + "[true]")
                pending ack = 0 - 1
            end
        else m.kind != websocket.TEXT:
            going = false
        else:
            idle = 0
            body := m.text.substr(1, m.text.len() - 1)
            if body == "0":
                websocket.SendText(c, `40{"sid":"bin-nsp"}`)
            else str.StartsWith(body, "5"):
                // A BINARY_EVENT: how many attachments, and the ack id if
                // the client wants one.
                dash := str.Find(body, "-")
                server log += "attachments=" + body.substr(1, dash - 1) + ";"
                rest := body.substr(dash + 1, body.len() - dash - 1)
                pending ack = ack id of("x" + rest)
            else str.StartsWith(body, `2["send"`):
                // Two attachments in one event, plus a plain argument.
                websocket.SendText(c, `452-["files","report",{"_placeholder":true,"num":0},{"_placeholder":true,"num":1}]`)
                raw := mem.Allocate(4 as u64)
                bp := raw as i8*
                bp[0] = 0 as i8
                bp[1] = 255 as i8
                bp[2] = 0 as i8
                bp[3] = 16 as i8
                websocket.SendBinaryBytes(c, raw, 4)
                bp[0] = 65 as i8
                bp[1] = 66 as i8
                websocket.SendBinaryBytes(c, raw, 2)
                mem.Free(raw)
            else body == "1":
                server log += "left;"
                going = false
            end
        end
    end
    websocket.Close(c)
    websocket.CloseServer(srv)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(sio server)
    sync.Wait(ready)

    mut o := socketio.NewOptions()
    o.transports = socketio.TRANSPORT_WEBSOCKET
    o.timeout = 5000
    o.reconnection = false
    c := socketio.DialWith("http://127.0.0.1:" + PORT, o)
    println "connected:", socketio.IsConnected(c)

    println "-- two attachments out, with an acknowledgement"
    raw := mem.Allocate(5 as u64)
    bp := raw as i8*
    bp[0] = 0 as i8
    bp[1] = 1 as i8
    bp[2] = 0 as i8
    bp[3] = 254 as i8
    bp[4] = 255 as i8
    mut a := socketio.NewArgs()
    socketio.AddStr(a, "two files")
    socketio.AddBytes(a, raw, 5)
    socketio.AddBinaryStr(a, "AB")
    mem.Free(raw)
    mut ack := socketio.EmitAck(c, "upload", a, 3000)
    socketio.ArgsFree(a)
    println "acknowledged:", ack.ok, socketio.AckArg(ack, 0)
    socketio.AckFree(ack)

    println "-- two attachments in"
    socketio.Emit(c, "send")
    mut got := socketio.NextEvent(c, 3000)
    until got.name != "files" && got.kind != socketio.EV_TIMEOUT:
        socketio.EventFree(got)
        got = socketio.NextEvent(c, 3000)
    end
    println "event:", got.name, "arguments:", socketio.ArgCount(got)
    println "plain argument:", socketio.ArgStr(got, 0), "binary?", socketio.ArgIsBinary(got, 0)
    println "second is binary:", socketio.ArgIsBinary(got, 1), "third is binary:", socketio.ArgIsBinary(got, 2)
    one := socketio.ArgBytes(got, 1)
    two := socketio.ArgBytes(got, 2)
    println "first buffer:", one.len, socketio.BytesAt(one, 0), socketio.BytesAt(one, 1), socketio.BytesAt(one, 2), socketio.BytesAt(one, 3)
    println "second buffer:", two.len, socketio.BytesToStr(two)
    println "base64, which keeps the NULs:", socketio.BytesToBase64(one)
    // A str stops at the first NUL, which is the whole reason for Bytes.
    println "as text, truncated:", socketio.BytesToStr(one).len()
    println "out of range byte:", socketio.BytesAt(one, 99)
    socketio.EventFree(got)
    println "released:", socketio.ArgBytes(got, 1).len

    socketio.Close(c)
    join(t)
    println "server saw:", server log
end
