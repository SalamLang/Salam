import net.socketio
import net.tcp
import time

mut attempts seen := 0
mut errors seen := 0
mut gave up := false

func main:
    probe := tcp.Bind(0)
    port := tcp.Port(probe)
    tcp.CloseServer(probe)
    println "picked a free port:", port > 0

    mut o := socketio.NewOptions()
    o.transports = socketio.TRANSPORT_WEBSOCKET
    o.timeout = 1000
    o.reconnection = true
    o.reconnection_attempts = 2
    o.reconnection_delay = 60
    o.reconnection_delay_max = 120
    o.randomization_factor = 0
    o.auto_connect = false
    c := socketio.DialWith("http://127.0.0.1:" + port, o)

    socketio.On(c, "reconnect_attempt", (e: socketio.Event): attempts seen += 1 end)
    socketio.On(c, "reconnect_error", (e: socketio.Event): errors seen += 1 end)
    socketio.On(c, "reconnect_failed", (e: socketio.Event): gave up = true end)

    println "first attempt fails:", socketio.Connect(c)
    println "and says why:", socketio.LastError(c).len() > 0
    println "but is still trying:", socketio.Active(c)

    mut rc := socketio.PUMP_TIMEOUT
    mut i := 0
    until i < 40 && !gave up:
        rc = socketio.Pump(c, 100)
        i += 1
    end

    println "gave up:", gave up
    println "attempts made:", attempts seen, "of", socketio.OptionsOf(socketio.ManagerOf(c)).reconnection_attempts
    println "each one reported an error:", errors seen == attempts seen
    println "the pump now says closed:", socketio.Pump(c, 0) == socketio.PUMP_CLOSED
    println "and keeps saying it:", socketio.Pump(c, 0) == socketio.PUMP_CLOSED
    println "no further attempts:", attempts seen

    mut queued kinds := 0
    mut d := 0
    until d < 40:
        mut ev := socketio.Next(c, 0)
        if ev.kind == socketio.EV_TIMEOUT:
            d = 40
        else:
            queued kinds += 1
        end
        socketio.EventFree(ev)
        d += 1
    end
    println "lifecycle events were queued for Next:", queued kinds > 0
    start := time.MonoMillis()
    ev := socketio.Next(c, 3000)
    waited := time.MonoMillis() - start
    println "returns at once:", ev.kind == socketio.EV_TIMEOUT, waited < 1000

    println "emit still buffered:", socketio.EmitStr(c, "later", "x"), socketio.Buffered(c)
    println "not connected:", !socketio.IsConnected(c)
    socketio.Close(c)
end
