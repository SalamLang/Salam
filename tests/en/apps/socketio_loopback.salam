import net.socketio
import net.websocket
import sync
import str
import mem

mut PORT := 0
mut ready := sync.NewWaitGroup()
mut server_log := ""

func ack_id_of(text: str): int:
    mut i := 1
    mut id := 0
    mut seen := false
    until i < text.Len():
        c := char_code(text.Substr(i, 1))
        if c < 48 or c > 57:
            i = text.Len()
        else:
            id = id * 10 + (c - 48)
            seen = true
            i++
        end
    end
    if not seen:
        ret 0 - 1
    end
    ret id
end

func sio_server():
    srv := websocket.Listen(0)
    PORT = websocket.Port(srv)
    sync.Done(ready)
    if not websocket.Ok(srv):
        ret
    end
    mut c := websocket.Accept(srv)
    if not websocket.IsOpen(c):
        websocket.CloseServer(srv)
        ret
    end
    if str.Contains(c.path, "EIO=4") and str.Contains(c.path, "transport=websocket"):
        server_log += "handshake ok;"
    end
    if str.Contains(c.path, "room=7"):
        server_log += "url query;"
    end
    if str.Contains(c.path, "client=salam"):
        server_log += "options query;"
    end
    if str.Contains(c.hdr, "X-Api-Key: k-123"):
        server_log += "extra header;"
    end
    websocket.SendText(
        c, `0{"sid":"loopback-sid","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`
    )
    mut going := true
    mut idle := 0
    until going:
        m := websocket.Poll(c, 2000)
        if m.kind == websocket.TIMEOUT:
            idle++
            if idle > 30:
                going = false
            end
        else m.kind != websocket.TEXT:
            going = false
        else:
            idle = 0
            t := m.text
            body := t.Substr(1, t.Len() - 1)
            if t == "40":
                websocket.SendText(c, `40{"sid":"nsp-socket-1"}`)
            else body == "3":
                server_log += "pong;"
            else str.StartsWith(body, `2["echo"`):
                server_log += "echo;"
                websocket.SendText(c, `42["echoed","and back"]`)
                websocket.SendText(c, `427["question","2+2"]`)
                websocket.SendText(c, `451-["blob",{"_placeholder":true,"num":0}]`)
                raw := mem.Allocate(4 as u64)
                bp := raw as i8*
                bp[0] = 9 as i8
                bp[1] = 0 as i8
                bp[2] = 200 as i8
                bp[3] = 255 as i8
                websocket.SendBinaryBytes(c, raw, 4)
                mem.Free(raw)
            else str.StartsWith(body, "2") and str.Contains(body, `"add"`):
                id := ack_id_of(body)
                server_log += "add#" + id + ";"
                websocket.SendText(c, "43" + id + "[5]")
            else str.StartsWith(body, "37"):
                server_log += "replied=" + body.Substr(2, body.Len() - 2) + ";"
            else body == "1":
                server_log += "client left;"
                going = false
            end
        end
    end
    websocket.Close(c)
    websocket.CloseServer(srv)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(sio_server)
    sync.Wait(ready)

    mut o := socketio.NewOptions()
    o.transports = socketio.TRANSPORT_WEBSOCKET
    o.timeout = 3000
    o.reconnection = false
    o.query = "?client=salam"
    o.headers = "X-Api-Key: k-123"
    c := socketio.DialWith("http://127.0.0.1:" + PORT + "/?room=7", o)

    println "connected:", socketio.IsConnected(c)
    println "engine sid:", socketio.Sid(c)
    println "namespace socket id:", socketio.Id(c)
    println "namespace:", socketio.Namespace(c)
    println "transport is websocket:", socketio.Transport(c) == socketio.TRANSPORT_WEBSOCKET

    socketio.EmitStr(c, "echo", "please")
    mut got_event := ""
    mut got_binary := ""
    mut question_id := 0 - 1
    mut n := 0
    until n < 8:
        mut ev := socketio.Next(c, 400)
        if ev.kind == socketio.EV_EVENT:
            switch ev.name:
                "echoed":
                    got_event = socketio.ArgStr(ev, 0)
                    break
                end
                "question":
                    question_id = ev.ack_id
                    socketio.ReplyStr(ev, "four")
                    break
                end
                "blob":
                    b := socketio.ArgBytes(ev, 0)
                    got_binary = "" + b.len + ":" + socketio.BytesAt(b, 0) + "," +
                        socketio.BytesAt(b, 1) + "," + socketio.BytesAt(b, 2) + "," +
                        socketio.BytesAt(b, 3)
                    break
                end
            end
        end
        socketio.EventFree(ev)
        n++
    end
    println "event argument:", got_event
    println "binary argument:", got_binary
    println "question wanted an ack:", question_id >= 0

    mut a := socketio.NewArgs()
    socketio.AddInt(a, 2)
    socketio.AddInt(a, 3)
    mut ack := socketio.EmitAck(c, "add", a, 2000)
    socketio.ArgsFree(a)
    println "ack ok:", ack.ok, "value:", socketio.AckInt(ack, 0)
    socketio.AckFree(ack)

    println "reserved name refused:", not socketio.Emit(c, "connect")

    socketio.Close(c)
    join(t)
    println "server saw:", server_log
end
