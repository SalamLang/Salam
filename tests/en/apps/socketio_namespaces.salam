import net.socketio
import net.websocket
import sync
import str

const PORT := 19413

mut ready := sync.NewWaitGroup()
mut server log := ""

func ack id of(text: str): int:
    mut i := 1
    mut id := 0
    mut seen := false
    until i < text.len():
        c := char_code(text.substr(i, 1))
        if c < 48 || c > 57:
            i = text.len()
        else:
            id = id * 10 + (c - 48)
            seen = true
            i += 1
        end
    end
    if !seen:
        ret 0 - 1
    end
    ret id
end

func sio server():
    srv := websocket.Listen(PORT)
    sync.Done(ready)
    if !websocket.Ok(srv):
        ret
    end
    mut c := websocket.Accept(srv)
    if !websocket.IsOpen(c):
        websocket.CloseServer(srv)
        ret
    end
    websocket.SendText(c, `0{"sid":"one-session","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    mut going := true
    mut idle := 0
    until going:
        m := websocket.Poll(c, 2000)
        if m.kind == websocket.TIMEOUT:
            idle += 1
            if idle > 30:
                going = false
            end
        else m.kind != websocket.TEXT:
            going = false
        else:
            idle = 0
            body := m.text.substr(1, m.text.len() - 1)
            if body == "0":
                websocket.SendText(c, `40{"sid":"root-socket"}`)
            else str.StartsWith(body, "0/admin,"):
                server log += "admin auth=" + body.substr(8, body.len() - 8) + ";"
                websocket.SendText(c, `40/admin,{"sid":"admin-socket"}`)
            else str.StartsWith(body, "0/staff,"):
                websocket.SendText(c, `44/staff,{"message":"Not authorized"}`)
            else str.StartsWith(body, `2/admin,["shout"`):
                server log += "admin shout;"
                websocket.SendText(c, `42/admin,["heard","in admin"]`)
                websocket.SendText(c, `42["heard","in root"]`)
            else str.StartsWith(body, "2") && str.Contains(body, `"ask"`):
                id := ack id of(body)
                server log += "root ask#" + id + ";"
                websocket.SendText(c, "43" + id + `["root says hi"]`)
            else str.StartsWith(body, "1/admin,"):
                server log += "admin left;"
            else body == "1":
                server log += "root left;"
                going = false
            end
        end
    end
    websocket.Close(c)
    websocket.CloseServer(srv)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(sio server)
    sync.Wait(ready)

    mut o := socketio.NewOptions()
    o.transports = socketio.TRANSPORT_WEBSOCKET
    o.timeout = 3000
    o.reconnection = false
    m := socketio.NewManager("http://127.0.0.1:" + PORT, o)

    println "transport up before any namespace:", socketio.Open(m), socketio.IsOpen(m)

    root := socketio.Of(m, "/")
    admin := socketio.Of(m, "/admin")
    staff := socketio.Of(m, "/staff")
    socketio.SetAuth(admin, `{"token":"a-1"}`)

    println "root connects:", socketio.Connect(root)
    println "admin connects:", socketio.Connect(admin)
    println "staff is refused:", socketio.Connect(staff), socketio.Refused(staff), socketio.RefusalReason(staff)

    println "one session, three sockets:", socketio.Sid(root) == socketio.Sid(admin)
    println "root id:", socketio.Id(root), "admin id:", socketio.Id(admin), "staff id:", socketio.Id(staff) == ""
    mut socks := socketio.Sockets(m)
    println "namespaces:", socks.len()
    socks.free()

    socketio.EmitStr(admin, "shout", "hello")
    mut admin heard := ""
    mut root heard := ""
    mut n := 0
    until n < 10 && (admin heard == "" || root heard == ""):
        mut ea := socketio.NextEvent(admin, 250)
        if ea.kind == socketio.EV_EVENT && ea.name == "heard":
            admin heard = socketio.ArgStr(ea, 0)
        end
        socketio.EventFree(ea)
        mut er := socketio.NextEvent(root, 250)
        if er.kind == socketio.EV_EVENT && er.name == "heard":
            root heard = socketio.ArgStr(er, 0)
        end
        socketio.EventFree(er)
        n += 1
    end
    println "admin received:", admin heard
    println "root received:", root heard

    mut a := socketio.NewArgs()
    mut ack := socketio.EmitAck(root, "ask", a, 2000)
    socketio.ArgsFree(a)
    println "root ack:", ack.ok, socketio.AckStr(ack, 0)
    socketio.AckFree(ack)

    socketio.Close(admin)
    println "after closing admin - transport still up:", socketio.IsOpen(m), "root still connected:", socketio.IsConnected(root)
    mut left := socketio.Sockets(m)
    println "namespaces left:", left.len()
    left.free()

    socketio.CloseManager(m)
    join(t)
    println "server saw:", server log
end
