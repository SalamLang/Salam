import net.socketio
import net.tcp
import sync
import str
import time
import mem

const PORT := 19417

mut ready := sync.NewWaitGroup()
mut outbox := Vector {} as Vector<str>
mut server log := ""
mut saw pong := false
mut biggest post := 0
mut pending blob ack := 0 - 1
mut running := true

func header value(head: str, name: str): int:
    lower := str.Lower(head)
    at := str.Find(lower, name)
    if at < 0:
        ret 0
    end
    colon := str.IndexFrom(head, ":", at)
    if colon < 0:
        ret 0
    end
    mut stop := str.IndexFrom(head, "\r", colon)
    if stop < 0:
        stop = head.len()
    end
    ret str.Trim(head.substr(colon + 1, stop - colon - 1)).to_int()
end

func read request(c: tcp.Conn, target &: str, body &: str): bool:
    mut buf := ""
    mut going := true
    until going:
        chunk := tcp.Read(c, 8192)
        if chunk.len() == 0:
            ret false
        end
        buf += chunk
        if str.Contains(buf, "\r\n\r\n"):
            going = false
        end
    end
    split := str.Find(buf, "\r\n\r\n")
    head := buf.substr(0, split)
    mut rest := buf.substr(split + 4, buf.len() - split - 4)
    mut want := header value(head, "content-length")
    until rest.len() < want:
        chunk := tcp.Read(c, 8192)
        if chunk.len() == 0:
            want = rest.len()
        else:
            rest += chunk
        end
    end
    first := str.Find(head, " ")
    second := str.IndexFrom(head, " ", first + 1)
    target = head.substr(0, second)
    body = rest
    ret true
end

func ack id of(text: str): int:
    mut i := 1
    mut id := 0
    mut seen := false
    until i < text.len():
        c := char_code(text.substr(i, 1))
        if c < 48 || c > 57:
            i = text.len()
        else:
            id = id * 10 + (c - 48)
            seen = true
            i += 1
        end
    end
    if !seen:
        ret 0 - 1
    end
    ret id
end

func handle payload(payload: str):
    if payload.len() == 0:
        ret
    end
    if str.StartsWith(payload, "b"):
        server log += "binary=" + payload.substr(1, payload.len() - 1) + ";"
        if pending blob ack >= 0:
            outbox.push("43" + pending blob ack + "[true]")
            pending blob ack = 0 - 1
        end
        ret
    end
    kind := socketio.EngineKind(payload)
    rest := socketio.EngineBody(payload)
    if kind == socketio.EIO_PONG:
        saw pong = true
    else kind == socketio.EIO_CLOSE:
        server log += "client closed the session;"
        running = false
    else kind == socketio.EIO_MESSAGE:
        if rest == "0":
            outbox.push(`40{"sid":"polling-nsp"}`)
            server log += "joined;"
        else str.StartsWith(rest, "2") && str.Contains(rest, `"echo"`):
            server log += "echo;"
            outbox.push(`42["echoed","over polling"]`)
        else str.StartsWith(rest, "2") && str.Contains(rest, `"held"`):
            server log += "held " + rest.substr(1, rest.len() - 1) + ";"
        else str.StartsWith(rest, "5") && str.Contains(rest, `"upload"`):
            dash := str.Find(rest, "-")
            server log += "attachments=" + rest.substr(1, dash - 1) + ";"
            pending blob ack = ack id of("x" + rest.substr(dash + 1, rest.len() - dash - 1))
        else str.StartsWith(rest, "2") && str.Contains(rest, `"fetch"`):
            outbox.push(`451-["blob",{"_placeholder":true,"num":0}]`)
            outbox.push("bCQAH/w==")
        else str.StartsWith(rest, "2") && str.Contains(rest, `"sum"`):
            id := ack id of(rest)
            server log += "sum#" + id + ";"
            outbox.push("43" + id + "[7]")
        else rest == "1":
            server log += "left the namespace;"
        end
    end
end

func serve(c: tcp.Conn):
    mut target := ""
    mut body := ""
    if !read request(c, target, body):
        ret
    end
    if str.StartsWith(target, "POST"):
        mut items := socketio.SplitPayloads(body)
        if items.len() > biggest post:
            biggest post = items.len()
        end
        repeat items.len() with i:
            handle payload(items.get(i))
        end
        items.free()
        tcp.WriteHTTP(c, "200 OK", "text/html", "ok")
        ret
    end
    if !str.Contains(target, "sid="):
        tcp.WriteHTTP(c, "200 OK", "text/plain; charset=UTF-8",
            `0{"sid":"polling-session","upgrades":[],"pingInterval":20000,"pingTimeout":5000,"maxPayload":65536}`)
        ret
    end
    if outbox.len() == 0:
        time.Sleep(60)
        tcp.WriteHTTP(c, "200 OK", "text/plain; charset=UTF-8", socketio.EncodeEngine(socketio.EIO_PING, ""))
        ret
    end
    body out := socketio.JoinPayloads(outbox)
    outbox.clear()
    tcp.WriteHTTP(c, "200 OK", "text/plain; charset=UTF-8", body out)
end

func http server():
    srv := tcp.Bind(PORT)
    sync.Done(ready)
    if !tcp.Ok(srv):
        ret
    end
    until running:
        c := tcp.Accept(srv)
        if !tcp.ConnOk(c):
            running = false
        else:
            serve(c)
            tcp.Close(c)
        end
    end
    tcp.CloseServer(srv)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(http server)
    sync.Wait(ready)

    mut o := socketio.NewOptions()
    o.transports = socketio.TRANSPORT_AUTO
    o.timeout = 3000
    o.reconnection = false
    o.auto_connect = false
    c := socketio.DialWith("http://127.0.0.1:" + PORT, o)
    socketio.EmitStr(c, "held", "first")
    socketio.EmitStr(c, "held", "second")
    socketio.EmitStr(c, "held", "third")
    println "held before connecting:", socketio.Buffered(c)

    println "connected:", socketio.Connect(c)
    println "transport:", socketio.TransportName(c)
    println "session:", socketio.Sid(c), "namespace socket:", socketio.Id(c)
    println "heartbeat:", socketio.PingInterval(c), socketio.PingTimeout(c)
    println "max payload:", socketio.MaxPayload(c)

    socketio.EmitStr(c, "echo", "hello")
    mut ev := socketio.NextEvent(c, 1500)
    println "event:", ev.name, socketio.ArgStr(ev, 0)
    socketio.EventFree(ev)

    mut a := socketio.NewArgs()
    socketio.AddInt(a, 3)
    socketio.AddInt(a, 4)
    mut ack := socketio.EmitAck(c, "sum", a, 2000)
    socketio.ArgsFree(a)
    println "acknowledged:", ack.ok, socketio.AckInt(ack, 0)
    socketio.AckFree(ack)

    println "-- binary, which polling carries as base64"
    buf := mem.Allocate(5 as u64)
    bp := buf as i8*
    bp[0] = 0 as i8
    bp[1] = 30 as i8
    bp[2] = 255 as i8
    bp[3] = 0 as i8
    bp[4] = 65 as i8
    mut up := socketio.NewArgs()
    socketio.AddBytes(up, buf, 5)
    mem.Free(buf)
    mut sent := socketio.EmitAck(c, "upload", up, 2000)
    socketio.ArgsFree(up)
    println "server took the attachment:", sent.ok
    socketio.AckFree(sent)

    socketio.Emit(c, "fetch")
    mut blob := socketio.NextEvent(c, 1500)
    mut spins := 0
    until blob.name != "blob" && blob.kind != socketio.EV_TIMEOUT && spins < 6:
        socketio.EventFree(blob)
        blob = socketio.NextEvent(c, 1500)
        spins += 1
    end
    down := socketio.ArgBytes(blob, 0)
    println "attachment back:", down.len, socketio.BytesAt(down, 0), socketio.BytesAt(down, 1), socketio.BytesAt(down, 2), socketio.BytesAt(down, 3)
    println "base64:", socketio.BytesToBase64(down)
    socketio.EventFree(blob)

    socketio.RunFor(c, 800)
    println "answered the heartbeat:", saw pong
    println "nothing held any more:", socketio.Buffered(c)
    println "most packets in one request:", biggest post

    socketio.Close(c)
    println "connected after close:", socketio.IsConnected(c)
    join(t)
    println "server saw:", server log
end
