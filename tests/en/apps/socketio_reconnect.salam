// Losing the connection and getting it back.
//
// The point of the exercise is that the code doing the emitting never finds
// out. The server drops the socket mid-session; the client notices, reports
// the standard reason, holds what is emitted in the meantime, reconnects,
// re-joins its namespace and sends the held packets. Everything below is
// deterministic - the server drops the connection when asked to, rather than
// on a timer.

import net.socketio
import net.websocket
import sync
import str

const PORT := 19414

mut ready := sync.NewWaitGroup()
mut server log := ""

// One session: the open packet, the namespace handshake, then events until
// the client asks to be dropped or leaves. Returns true if it was a drop.
func serve one(c &: websocket.Conn, sid: str): bool:
    websocket.SendText(c, `0{"sid":"` + sid + `","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    mut dropped := false
    mut going := true
    mut idle := 0
    // A poll that times out is not the end of anything - under a loaded
    // test runner the client can be several seconds between packets - so it
    // only counts towards a hard stop that stops this thread wedging.
    until going:
        m := websocket.Poll(c, 2000)
        if m.kind == websocket.TIMEOUT:
            idle += 1
            if idle > 30:
                going = false
            end
        else m.kind != websocket.TEXT:
            going = false
        else:
            idle = 0
            body := m.text.substr(1, m.text.len() - 1)
            if body == "0":
                websocket.SendText(c, `40{"sid":"` + sid + `-nsp"}`)
                server log += sid + ":joined;"
            else str.StartsWith(body, `2["drop"`):
                server log += sid + ":drop;"
                dropped = true
                going = false
            else str.StartsWith(body, "2"):
                // Echo the event name back so the client can prove a held
                // packet really arrived after the reconnection.
                server log += sid + ":got " + body + ";"
            else body == "1":
                server log += sid + ":left;"
                going = false
            end
        end
    end
    ret dropped
end

func sio server():
    srv := websocket.Listen(PORT)
    sync.Done(ready)
    if !websocket.Ok(srv):
        ret
    end
    mut round := 1
    mut going := true
    until going && round <= 2:
        mut c := websocket.Accept(srv)
        if !websocket.IsOpen(c):
            going = false
        else:
            dropped := serve one(c, "s" + round)
            if dropped:
                // Cut the connection without a close handshake, the way a
                // network does.
                websocket.Stop(c)
            end
            websocket.Close(c)
            round += 1
        end
    end
    websocket.CloseServer(srv)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(sio server)
    sync.Wait(ready)

    mut o := socketio.NewOptions()
    o.transports = socketio.TRANSPORT_WEBSOCKET
    o.timeout = 5000
    o.reconnection = true
    o.reconnection_delay = 120
    o.reconnection_delay_max = 300
    o.randomization_factor = 0
    c := socketio.DialWith("http://127.0.0.1:" + PORT, o)
    println "connected:", socketio.IsConnected(c), "id:", socketio.Id(c)

    // Ask the server to cut the connection, then pump until it is noticed.
    socketio.Emit(c, "drop")
    mut reason := ""
    mut i := 0
    until i < 40 && reason == "":
        mut ev := socketio.Next(c, 200)
        if ev.kind == socketio.EV_DISCONNECT:
            reason = ev.message
        end
        socketio.EventFree(ev)
        i += 1
    end
    println "disconnect reason:", reason
    println "still active, so it will come back:", socketio.Active(c)
    println "connected right now:", socketio.IsConnected(c)

    // Emitted into a connection that does not exist. Nothing is lost.
    socketio.EmitStr(c, "while-down", "held")
    println "held packets:", socketio.Buffered(c)

    // Two things have to happen, in this order: the TRANSPORT comes back
    // (EV_RECONNECT), and then the namespace is joined again on it
    // (EV_CONNECT). socket.io reports them separately for the same reason -
    // a live socket is not yet a live namespace.
    mut transport back := false
    mut attempted := false
    mut rejoined := false
    mut j := 0
    until j < 60 && !rejoined:
        mut ev := socketio.Next(c, 200)
        if ev.kind == socketio.EV_RECONNECT_ATTEMPT:
            attempted = true
        else ev.kind == socketio.EV_RECONNECT:
            transport back = true
        else ev.kind == socketio.EV_CONNECT:
            rejoined = true
        end
        socketio.EventFree(ev)
        j += 1
    end
    println "reconnect attempted:", attempted
    println "transport back:", transport back
    println "namespace re-joined:", rejoined, "connected:", socketio.IsConnected(c)
    println "new namespace id:", socketio.Id(c)
    println "attempt counter reset:", socketio.Attempts(c)
    println "nothing held any more:", socketio.Buffered(c)

    // Give the server a moment to log the packet that was held.
    socketio.RunFor(c, 300)
    socketio.Close(c)
    join(t)
    println "server saw:", server log
end
