// Options.retries: sending an event again when nothing acknowledges it.
//
// Buffering covers a connection that is DOWN. This covers the other case -
// the connection is up, the packet went out, and it still did not arrive.
// The only evidence a packet arrived is an acknowledgement, so turning
// retries on makes every emit ask for one, whether or not the caller wanted
// it; the id is the client's own and the answer is thrown away.
//
// The server here acknowledges one event on its second arrival and never
// acknowledges the other, so both halves are visible: the retry that
// succeeds and stops, and the one that gives up after the budget.

import net.socketio
import net.websocket
import sync
import str

const PORT := 19416

mut ready := sync.NewWaitGroup()
mut flaky count := 0
mut never count := 0

func ack id of(text: str): int:
    mut i := 1
    mut id := 0
    mut seen := false
    until i < text.len():
        c := char_code(text.substr(i, 1))
        if c < 48 || c > 57:
            i = text.len()
        else:
            id = id * 10 + (c - 48)
            seen = true
            i += 1
        end
    end
    if !seen:
        ret 0 - 1
    end
    ret id
end

func sio server():
    srv := websocket.Listen(PORT)
    sync.Done(ready)
    if !websocket.Ok(srv):
        ret
    end
    mut c := websocket.Accept(srv)
    if !websocket.IsOpen(c):
        websocket.CloseServer(srv)
        ret
    end
    websocket.SendText(c, `0{"sid":"retry","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    mut going := true
    mut idle := 0
    // A poll that times out is not the end of anything - under a loaded
    // test runner the client can be several seconds between packets - so it
    // only counts towards a hard stop that stops this thread wedging.
    until going:
        m := websocket.Poll(c, 2000)
        if m.kind == websocket.TIMEOUT:
            idle += 1
            if idle > 30:
                going = false
            end
        else m.kind != websocket.TEXT:
            going = false
        else:
            idle = 0
            body := m.text.substr(1, m.text.len() - 1)
            if body == "0":
                websocket.SendText(c, `40{"sid":"retry-nsp"}`)
            else str.StartsWith(body, "2") && str.Contains(body, `"flaky"`):
                flaky count += 1
                // Silence the first time, so the client has to try again.
                if flaky count >= 2:
                    websocket.SendText(c, "43" + ack id of(body) + "[]")
                end
            else str.StartsWith(body, "2") && str.Contains(body, `"never"`):
                never count += 1
            else body == "1":
                going = false
            end
        end
    end
    websocket.Close(c)
    websocket.CloseServer(srv)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(sio server)
    sync.Wait(ready)

    mut o := socketio.NewOptions()
    o.transports = socketio.TRANSPORT_WEBSOCKET
    o.timeout = 3000
    o.reconnection = false
    o.retries = 2
    o.ack_timeout = 150
    c := socketio.DialWith("http://127.0.0.1:" + PORT, o)
    println "connected:", socketio.IsConnected(c)
    println "retries configured:", socketio.OptionsOf(socketio.ManagerOf(c)).retries

    // Neither emit asks for an acknowledgement; retries adds one behind the
    // caller's back, which is why Pending counts them.
    socketio.EmitStr(c, "flaky", "a")
    socketio.EmitStr(c, "never", "b")
    println "waiting on acknowledgements nobody asked for:", socketio.Pending(c)

    socketio.RunFor(c, 2000)

    println "delivered on the retry, then stopped:", flaky count
    println "retried to the end of the budget, then gave up:", never count
    println "no acknowledgements outstanding:", socketio.Pending(c)
    // The internal acknowledgements are the client's own business and never
    // reach the caller's queue as results.
    println "still connected:", socketio.IsConnected(c)

    socketio.Close(c)
    join(t)
end
