// The simplest possible Telegram bot: greets /start and echoes every other
// message back with the sender's name. Get a token from @BotFather on
// Telegram, then run with:
//   BOT_TOKEN=123456:your-token salam run hello_bot.salam

package main

import telegram.bot
import os

func on_update(b: bot.Bot, u: bot.Update):
    if !u.has_message: ret end
    m := u.message

    if bot.CommandName(m.text) == "start":
        bot.SendMessage(b, m.chat.id, "Hello! I'm a Salam-powered bot. Send me anything and I'll greet you back.")
        ret
    end

    bot.SendMessage(b, m.chat.id, "Hello, " + m.from_user.first_name + "! You said: " + m.text)
end

func main:
    token := os.Env("BOT_TOKEN")
    if token.len() == 0:
        println "Set BOT_TOKEN to your bot token (from @BotFather) before running this example."
        ret
    end

    b := bot.NewBot(token)
    me := bot.GetMe(b)
    if !me.ok:
        println "could not reach Telegram with this token: " + me.description
        ret
    end
    println "hello_bot is running as @" + bot.ParseUser(me.result).username

    bot.Poll(b, 30, (u: bot.Update): on_update(b, u) end)
end
