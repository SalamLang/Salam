// Replies "pong" to "ping" (case-insensitive), shows a "typing..." status
// first, and keeps a running counter across the whole session. Demonstrates
// SendChatAction and a top-level mutable global surviving the Poll loop.
//   BOT_TOKEN=123456:your-token salam run ping_pong_bot.salam

package main

import telegram.bot
import os
import str
import time

mut pong_count := 0

func on_update(b: bot.Bot, u: bot.Update):
    if !u.has_message: ret end
    m := u.message
    chat_id := m.chat.id

    if bot.IsCommand(m.text):
        if bot.CommandName(m.text) == "start":
            bot.SendMessage(b, chat_id, `Ping-pong bot ready. Send me "ping" and I will reply "pong". /stats shows the tally.`)
        else bot.CommandName(m.text) == "stats":
            bot.SendMessage(b, chat_id, "I have answered " + str.FromInt(pong_count as i64) + " pings so far.")
        end
        ret
    end

    if str.Lower(str.Trim(m.text)) == "ping":
        bot.SendChatAction(b, chat_id, "typing")
        time.Sleep(300)
        pong_count += 1
        bot.SendMessage(b, chat_id, "pong (#" + str.FromInt(pong_count as i64) + ")")
    end
end

func main:
    token := os.Env("BOT_TOKEN")
    if token.len() == 0:
        println "Set BOT_TOKEN to your bot token (from @BotFather) before running this example."
        ret
    end

    b := bot.NewBot(token)
    me := bot.GetMe(b)
    if !me.ok:
        println "could not reach Telegram with this token: " + me.description
        ret
    end
    println "ping_pong_bot is running as @" + bot.ParseUser(me.result).username

    bot.Poll(b, 30, (u: bot.Update): on_update(b, u) end)
end
