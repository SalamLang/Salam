// A one-question quiz with an inline keyboard. Demonstrates InlineButton /
// Row / InlineKeyboardMarkup, answering a callback query, editing the
// original message, and using bot.Call() to reach a Bot API method
// (editMessageReplyMarkup) that has no dedicated wrapper.
//   BOT_TOKEN=123456:your-token salam run quiz_bot.salam

package main

import telegram.bot
import os
import str

const QUESTION := "Quiz: what is the capital of France?"
const CORRECT_ANSWER := "paris"

func send_quiz(b: bot.Bot, chat_id: i64):
    mut choices := Vector {} as Vector<str>
    choices.push(bot.InlineButton("Paris", "paris"))
    choices.push(bot.InlineButton("London", "london"))
    choices.push(bot.InlineButton("Berlin", "berlin"))
    mut rows := Vector {} as Vector<str>
    rows.push(bot.Row(choices))
    choices.free()
    keyboard := bot.InlineKeyboardMarkup(rows)
    rows.free()

    opts := bot.SendOptions { reply_markup = keyboard }
    bot.SendMessageOptions(b, chat_id, QUESTION, opts)
end

func clear_keyboard(b: bot.Bot, chat_id: i64, message_id: i64):
    mut params := HashMap {} as HashMap<str, str>
    params.put("chat_id", str.FromInt(chat_id))
    params.put("message_id", str.FromInt(message_id))
    params.put("reply_markup", `{"inline_keyboard": []}`)
    bot.Call(b, "editMessageReplyMarkup", params)
end

func on_callback(b: bot.Bot, cq: bot.CallbackQuery):
    if !cq.has_message: ret end
    chat_id := cq.message.chat.id
    message_id := cq.message.message_id

    if cq.data == CORRECT_ANSWER:
        bot.AnswerCallbackQuery(b, cq.id, "Correct!")
        bot.EditMessageText(b, chat_id, message_id, QUESTION + "\n\nYou answered correctly: Paris.")
    else:
        bot.AnswerCallbackQuery(b, cq.id, "Not quite.")
        bot.EditMessageText(b, chat_id, message_id, QUESTION + "\n\nWrong answer. The correct answer was Paris.")
    end
    clear_keyboard(b, chat_id, message_id)
end

func on_update(b: bot.Bot, u: bot.Update):
    if u.has_message:
        m := u.message
        if bot.CommandName(m.text) == "quiz":
            send_quiz(b, m.chat.id)
        else bot.CommandName(m.text) == "start":
            bot.SendMessage(b, m.chat.id, "Send /quiz to try a question.")
        end
        ret
    end

    if u.has_callback_query:
        on_callback(b, u.callback_query)
    end
end

func main:
    token := os.Env("BOT_TOKEN")
    if token.len() == 0:
        println "Set BOT_TOKEN to your bot token (from @BotFather) before running this example."
        ret
    end

    b := bot.NewBot(token)
    me := bot.GetMe(b)
    if !me.ok:
        println "could not reach Telegram with this token: " + me.description
        ret
    end
    println "quiz_bot is running as @" + bot.ParseUser(me.result).username

    bot.Poll(b, 30, (u: bot.Update): on_update(b, u) end)
end
