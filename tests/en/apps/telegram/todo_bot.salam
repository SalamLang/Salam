// A per-chat todo list kept in memory: /add, /list, /done, /clear.
// Demonstrates per-chat state (HashMap<i64, str>) and command argument
// parsing (CommandArgs). Each chat's list is stored as its lines joined by
// "\n" rather than as a HashMap<i64, Vector<str>> - nested generic
// collections (a Vector/HashMap of Vectors) don't reliably resolve their
// element type in the compiler yet, so keep values flat. State lives only
// for the process lifetime - a real bot would persist it (db.sqlite, a
// file, ...).
//   BOT_TOKEN=123456:your-token salam run todo_bot.salam

package main

import telegram.bot
import os
import str

mut todos := HashMap {} as HashMap<i64, str>

func todo_text(chat_id: i64): str:
    if !todos.has(chat_id): ret "" end
    ret todos.get(chat_id)
end

func todo_lines(chat_id: i64): Vector<str>:
    text := todo_text(chat_id)
    if text.len() == 0: ret Vector {} as Vector<str> end
    ret text.split("\n")
end

func save_lines(chat_id: i64, lines: Vector<str>):
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat lines.len() with i:
        if i > 0: str.BufAppend(sb, "\n") end
        str.BufAppend(sb, lines.get(i)[0])
    end
    todos.put(chat_id, str.BufStr(sb))
end

func reply_list(b: bot.Bot, chat_id: i64):
    mut lines := todo_lines(chat_id)
    if lines.len() == 0:
        bot.SendMessage(b, chat_id, "Your todo list is empty. Use /add <task> to add one.")
        lines.free()
        ret
    end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat lines.len() with i:
        str.BufAppend(sb, str.FromInt((i + 1) as i64))
        str.BufAppend(sb, ". ")
        str.BufAppend(sb, lines.get(i)[0])
        str.BufAppend(sb, "\n")
    end
    bot.SendMessage(b, chat_id, str.BufStr(sb))
    lines.free()
end

func on_update(b: bot.Bot, u: bot.Update):
    if !u.has_message: ret end
    m := u.message
    chat_id := m.chat.id
    if !bot.IsCommand(m.text): ret end

    cmd := bot.CommandName(m.text)
    args := bot.CommandArgs(m.text)

    if cmd == "start" || cmd == "help":
        bot.SendMessage(b, chat_id, "Todo bot commands:\n/add <task>\n/list\n/done <number>\n/clear")
    else cmd == "add":
        if args.len() == 0:
            bot.SendMessage(b, chat_id, "Usage: /add <task>")
        else:
            mut current := todo_text(chat_id)
            if current.len() > 0: current = current + "\n" end
            todos.put(chat_id, current + args)
            bot.SendMessage(b, chat_id, "Added: " + args)
        end
    else cmd == "list":
        reply_list(b, chat_id)
    else cmd == "done":
        mut lines := todo_lines(chat_id)
        idx := str.ToInt(args)
        if idx < 1 || idx > lines.len():
            bot.SendMessage(b, chat_id, "Give a valid task number. Use /list to see numbers.")
        else:
            done := lines.get(idx - 1)[0]
            lines.remove_at(idx - 1)
            save_lines(chat_id, lines)
            bot.SendMessage(b, chat_id, "Done: " + done)
        end
        lines.free()
    else cmd == "clear":
        todos.put(chat_id, "")
        bot.SendMessage(b, chat_id, "Todo list cleared.")
    end
end

func main:
    token := os.Env("BOT_TOKEN")
    if token.len() == 0:
        println "Set BOT_TOKEN to your bot token (from @BotFather) before running this example."
        ret
    end

    b := bot.NewBot(token)
    me := bot.GetMe(b)
    if !me.ok:
        println "could not reach Telegram with this token: " + me.description
        ret
    end
    println "todo_bot is running as @" + bot.ParseUser(me.result).username

    bot.Poll(b, 30, (u: bot.Update): on_update(b, u) end)
end
