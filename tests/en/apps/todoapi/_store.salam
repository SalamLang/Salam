package store


import os
import str
import conv
import db.mysql
import encoding.json

const COLS := "id, title, notes, done, due_on, created_at"

mut _host := "127.0.0.1"
mut _port := 3306
mut _user := "root"
mut _pass := ""
mut _name := "salam_todo"

pub struct Conn:
    pub handle: void* = null
    pub ok: bool = false
    pub err: str = ""
end

pub struct User:
    pub id: i64 = 0
    pub email: str = ""
    pub hash: str = ""
end

func _db(c: Conn): mysql.Database:
    ret mysql.Database { handle = c.handle }
end

func _quote(c: Conn, s: str): str:
    ret "'".concat(mysql.Escape(_db(c), s)).concat("'")
end

func _num(v: i64): str:
    ret conv.FormatInt(v)
end

func _env(name: str, fallback: str): str:
    v := os.Env(name)
    if v.len() == 0: ret fallback end
    ret v
end

func _exec(c: Conn, sql: str, err &: str): bool:
    err = ""
    if mysql.Exec(_db(c), sql) != 0:
        err = mysql.Error(_db(c))
        ret false
    end
    ret true
end

func _scalar(c: Conn, sql: str): i64:
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret 0 as i64 end
    mut v := 0 as i64
    if mysql.Next(res): v = mysql.Int64(res, 0) end
    mysql.Finish(res)
    ret v
end

func _text_or_null(res: mysql.Result, col: int): str:
    if mysql.IsNull(res, col): ret "null" end
    ret json.Str(mysql.Text(res, col))
end

func _bool_json(res: mysql.Result, col: int): str:
    if mysql.Int(res, col) == 1: ret "true" end
    ret "false"
end

func _row_json(res: mysql.Result): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, `{"id":`)
    str.BufAppend(sb, mysql.Text(res, 0))
    str.BufAppend(sb, `,"title":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 1)))
    str.BufAppend(sb, `,"notes":`)
    str.BufAppend(sb, _text_or_null(res, 2))
    str.BufAppend(sb, `,"done":`)
    str.BufAppend(sb, _bool_json(res, 3))
    str.BufAppend(sb, `,"due_on":`)
    str.BufAppend(sb, _text_or_null(res, 4))
    str.BufAppend(sb, `,"created_at":`)
    str.BufAppend(sb, json.Str(mysql.Text(res, 5)))
    str.BufAppendChar(sb, 125)
    out := str.BufStr(sb)
    ret out
end

func _count(c: Conn, user_id: i64, status: str): i64:
    mut sql := "SELECT COUNT(*) FROM todos WHERE user_id = ".concat(_num(user_id))
    sql = sql.concat(_status_clause(status))
    ret _scalar(c, sql)
end

func _status_clause(status: str): str:
    if status == "open": ret " AND done = 0" end
    if status == "done": ret " AND done = 1" end
    ret ""
end


pub func Configure(err &: str): bool:
    err = ""
    if !mysql.LibraryInit():
        err = "cannot initialise the MariaDB client library"
        ret false
    end
    _host = _env("DB_HOST", "127.0.0.1")
    _port = _env("DB_PORT", "3306").to_int()
    _user = _env("DB_USER", "root")
    _pass = os.Env("DB_PASS")
    _name = _env("DB_NAME", "salam_todo")
    probe := Connect()
    if !probe.ok:
        err = probe.err
        ret false
    end
    Close(probe)
    ret true
end

pub func Connect(): Conn:
    mut c := Conn {}
    _t := mysql.ThreadInit()
    d := mysql.Open(_host, _user, _pass, _name, _port)
    if !mysql.Ok(d):
        c.err = mysql.Error(d)
        mysql.Close(d)
        ret c
    end
    _x := mysql.SetCharset(d, "utf8mb4")
    c.handle = d.handle
    c.ok = true
    ret c
end

pub func Close(c: Conn):
    if c.handle != null: mysql.Close(_db(c)) end
end

pub func Ok(c: Conn): bool:
    ret c.ok
end

pub func Err(c: Conn): str:
    ret c.err
end

pub func ThreadDone():
    mysql.ThreadEnd()
end

pub func Shutdown():
    mysql.LibraryEnd()
end

pub func Q(c: Conn, s: str): str:
    ret _quote(c, s)
end

pub func N(v: i64): str:
    ret _num(v)
end

pub func CreateUser(c: Conn, email: str, hash: str, err &: str): i64:
    mut sql := "INSERT INTO users (email, pass_hash) VALUES ("
    sql = sql.concat(_quote(c, email)).concat(", ").concat(_quote(c, hash)).concat(")")
    if !_exec(c, sql, err): ret 0 as i64 end
    ret mysql.LastInsertId(_db(c))
end

pub func FindUser(c: Conn, email: str): User:
    mut u := User {}
    mut sql := "SELECT id, email, pass_hash FROM users WHERE email = "
    sql = sql.concat(_quote(c, email)).concat(" LIMIT 1")
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret u end
    if mysql.Next(res):
        u.id = mysql.Int64(res, 0)
        u.email = mysql.Text(res, 1)
        u.hash = mysql.Text(res, 2)
    end
    mysql.Finish(res)
    ret u
end

pub func ListTodos(c: Conn, user_id: i64, status: str, limit: int, offset: int): str:
    mut sql := "SELECT ".concat(COLS).concat(" FROM todos WHERE user_id = ").concat(_num(user_id))
    sql = sql.concat(_status_clause(status))
    sql = sql.concat(" ORDER BY due_on IS NULL, due_on ASC, id DESC")
    sql = sql.concat(" LIMIT ").concat(_num(limit as i64)).concat(" OFFSET ").concat(_num(offset as i64))
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "[]" end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    mut n := 0
    until mysql.Next(res):
        if n > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, _row_json(res))
        n += 1
    end
    str.BufAppendChar(sb, 93)
    mysql.Finish(res)
    out := str.BufStr(sb)
    ret out
end

pub func CountTodos(c: Conn, user_id: i64, status: str): i64:
    ret _count(c, user_id, status)
end

pub func GetTodo(c: Conn, user_id: i64, id: i64): str:
    mut sql := "SELECT ".concat(COLS).concat(" FROM todos WHERE id = ").concat(_num(id))
    sql = sql.concat(" AND user_id = ").concat(_num(user_id)).concat(" LIMIT 1")
    mut res := mysql.Query(_db(c), sql)
    if !mysql.QueryOk(res): ret "" end
    mut out := ""
    if mysql.Next(res): out = _row_json(res) end
    mysql.Finish(res)
    ret out
end

pub func CreateTodo(c: Conn, user_id: i64, title: str, notes: str, due: str, err &: str): i64:
    mut cols := "user_id, title"
    mut vals := _num(user_id).concat(", ").concat(_quote(c, title))
    if notes.len() > 0:
        cols = cols.concat(", notes")
        vals = vals.concat(", ").concat(_quote(c, notes))
    end
    if due.len() > 0:
        cols = cols.concat(", due_on")
        vals = vals.concat(", ").concat(_quote(c, due))
    end
    sql := "INSERT INTO todos (".concat(cols).concat(") VALUES (").concat(vals).concat(")")
    if !_exec(c, sql, err): ret 0 as i64 end
    ret mysql.LastInsertId(_db(c))
end

pub func UpdateTodo(c: Conn, user_id: i64, id: i64, set: str, err &: str): bool:
    err = ""
    if set.len() == 0: ret false end
    mut sql := "UPDATE todos SET ".concat(set).concat(" WHERE id = ").concat(_num(id))
    sql = sql.concat(" AND user_id = ").concat(_num(user_id))
    ret _exec(c, sql, err)
end

pub func DeleteTodo(c: Conn, user_id: i64, id: i64, err &: str): bool:
    mut sql := "DELETE FROM todos WHERE id = ".concat(_num(id))
    sql = sql.concat(" AND user_id = ").concat(_num(user_id))
    if !_exec(c, sql, err): ret false end
    ret mysql.AffectedRows(_db(c)) > 0 as i64
end

pub func Stats(c: Conn, user_id: i64): str:
    total := _count(c, user_id, "all")
    done := _count(c, user_id, "done")
    mut osql := "SELECT COUNT(*) FROM todos WHERE user_id = ".concat(_num(user_id))
    osql = osql.concat(" AND done = 0 AND due_on IS NOT NULL AND due_on < CURDATE()")
    overdue := _scalar(c, osql)
    mut out := `{"total":`.concat(_num(total)).concat(`,"done":`).concat(_num(done))
    out = out.concat(`,"open":`).concat(_num(total - done))
    out = out.concat(`,"overdue":`).concat(_num(overdue)).concat("}")
    ret out
end
