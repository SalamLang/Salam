package main

// A todo API: register, sign in, and CRUD over your own list. MariaDB for
// storage, JWT for identity. See README.md to run it.
//
//   POST   /auth/register          {email, password}
//   POST   /auth/login             {email, password} -> access + refresh
//   POST   /auth/refresh           Bearer <refresh>  -> access
//   GET    /api/todos              ?status=all|open|done&limit=&offset=
//   POST   /api/todos              {title, notes?, due_on?}
//   GET    /api/todos/:id
//   PATCH  /api/todos/:id          {title?, notes?, done?, due_on?}
//   DELETE /api/todos/:id
//   GET    /api/stats
//   GET    /health
//
// THE SHAPE
//
// main.salam is HTTP: parse the request, check the caller, call the store,
// write a response. _store.salam is SQL. Nothing in this file builds a query
// and nothing in that one knows what a request is. The seam is what lets the
// store enforce escaping and ownership on every statement (see its header).
//
// Identity comes from the token's `sub` claim, which holds the user's id. It
// is never read from the path or the body: a client that could name its own
// user_id would not need to steal a token.

import os
import auth
import jwt
import conv
import net.http
import net.router
import encoding.json
import store "_store.salam"

const PORT := 8090
const ACCESS_TTL := 900
const REFRESH_TTL := 604800
const MAX_PAGE := 100

func guard(): auth.Guard:
    mut g := auth.NewGuard(secret())
    g.opts.issuer = "todo.salam"
    g.opts.require_exp = true
    g.opts.leeway = 30 as i64
    ret g
end

func secret(): str:
    s := os.Env("JWT_SECRET")
    if s.len() > 0: ret s end
    // Fine for a demo on localhost. In production this is a 32-byte value
    // from the environment, and the process should refuse to start without
    // it rather than fall back to a constant every reader of this file knows.
    ret "dev-only-secret-change-me"
end

// ---------------------------------------------------------------- helpers

func send(ctx: i64, code: int, body: str):
    http.Ctx_status(ctx, code)
    http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
    http.Ctx_json(ctx, body)
end

func fail(ctx: i64, code: int, message: str):
    send(ctx, code, `{"error":`.concat(json.Str(message)).concat("}"))
end

// The store's errors carry SQL in them. They belong in the log, not in the
// response - a duplicate-key message tells a stranger which addresses are
// registered.
func db_fail(ctx: i64, where: str, err: str):
    println "[db] ", where, ": ", err
    fail(ctx, 500, "database error")
end

// Identify the caller and hand back their user id. Returns 0 when the guard
// already answered the request.
func caller(ctx: i64): i64:
    mut t := jwt.Token {}
    if !auth.Require(ctx, guard(), t): ret 0 as i64 end
    if jwt.Str(t, "kind") != "access":
        auth.Forbidden(ctx, "this route needs an access token")
        ret 0 as i64
    end
    ret t.claims.sub.to_int() as i64
end

func int_param(ctx: i64, name: str, fallback: int, max: int): int:
    raw := http.Ctx_query(ctx, name)
    if raw.len() == 0: ret fallback end
    v := raw.to_int()
    if v < 0: ret fallback end
    if v > max: ret max end
    ret v
end

// ---------------------------------------------------------------- auth

func register(ctx: i64):
    body := http.Ctx_body(ctx)
    email := json.Get(body, "email").trim().lower()
    password := json.Get(body, "password")
    if email.len() < 3 || email.find("@") < 0:
        fail(ctx, 400, "a valid email is required")
        ret
    end
    // Eight is a floor, not a policy. Length is the only rule worth keeping;
    // the composition rules ("one capital, one digit") push people towards
    // passwords that are shorter and more guessable, not less.
    if password.len() < 8:
        fail(ctx, 400, "password must be at least 8 characters")
        ret
    end
    existing := store.FindUser(email)
    if existing.id != 0 as i64:
        // A registration form leaks address existence no matter what, since
        // it has to refuse a duplicate. The place to be careful is /login.
        fail(ctx, 409, "that email is already registered")
        ret
    end
    mut err := ""
    id := store.CreateUser(email, auth.HashPassword(password), err)
    if id == 0 as i64:
        db_fail(ctx, "create user", err)
        ret
    end
    send(ctx, 201, `{"id":`.concat(conv.FormatInt(id)).concat(`,"email":`).concat(json.Str(email)).concat("}"))
end

func issue(user_id: i64, kind: str, ttl: int, err &: int): str:
    mut c := jwt.NewClaims()
    c.sub = conv.FormatInt(user_id)
    jwt.SetStr(c, "kind", kind)
    ret auth.Issue(guard(), c, ttl as i64, err)
end

func login(ctx: i64):
    body := http.Ctx_body(ctx)
    email := json.Get(body, "email").trim().lower()
    u := store.FindUser(email)
    // One answer for "no such user" and "wrong password", and the password
    // is verified either way so the two paths take the same time. Skipping
    // the hash when the user is unknown turns login into an account
    // enumerator that anyone can time from the other side of the internet.
    mut stored := u.hash
    if stored.len() == 0: stored = auth.HashPassword("_no_such_user_") end
    ok := auth.VerifyPassword(json.Get(body, "password"), stored)
    if u.id == 0 as i64 || !ok:
        fail(ctx, 401, "invalid email or password")
        ret
    end
    mut err := 0
    access := issue(u.id, "access", ACCESS_TTL, err)
    refresh := issue(u.id, "refresh", REFRESH_TTL, err)
    if err != jwt.JWT_OK:
        fail(ctx, 500, "could not issue tokens")
        ret
    end
    send(
        ctx, 200, `{"access":`.concat(json.Str(access)).concat(`,"refresh":`).concat(json.Str(refresh)).concat(`,"expires_in":`).concat(conv.FormatInt(ACCESS_TTL as i64)).concat("}")
    )
end

func refresh(ctx: i64):
    mut t := jwt.Token {}
    if !auth.Require(ctx, guard(), t): ret end
    if jwt.Str(t, "kind") != "refresh":
        auth.Forbidden(ctx, "this route needs a refresh token")
        ret
    end
    mut err := 0
    access := issue(t.claims.sub.to_int() as i64, "access", ACCESS_TTL, err)
    if err != jwt.JWT_OK:
        fail(ctx, 500, "could not issue a token")
        ret
    end
    send(
        ctx, 200, `{"access":`.concat(json.Str(access)).concat(`,"expires_in":`).concat(conv.FormatInt(ACCESS_TTL as i64)).concat("}")
    )
end

// ---------------------------------------------------------------- todos

func list_todos(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    status := status_filter(http.Ctx_query(ctx, "status"))
    limit := int_param(ctx, "limit", 20, MAX_PAGE)
    offset := int_param(ctx, "offset", 0, 1000000)
    items := store.ListTodos(uid, status, limit, offset)
    total := store.CountTodos(uid, status)
    // The count comes back with the page so a client can render "1-20 of 57"
    // without a second request.
    send(
        ctx, 200, `{"items":`.concat(items).concat(`,"total":`).concat(conv.FormatInt(total)).concat(`,"limit":`).concat(conv.FormatInt(limit as i64)).concat(`,"offset":`).concat(conv.FormatInt(offset as i64)).concat("}")
    )
end

func status_filter(raw: str): str:
    if raw == "open" || raw == "done": ret raw end
    ret "all"
end

func get_todo(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    row := store.GetTodo(uid, path_id(ctx))
    if row.len() == 0:
        fail(ctx, 404, "no such todo")
        ret
    end
    send(ctx, 200, row)
end

func path_id(ctx: i64): i64:
    ret http.Ctx_param(ctx, "id").to_int() as i64
end

func create_todo(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    body := http.Ctx_body(ctx)
    title := json.Get(body, "title").trim()
    if title.len() == 0:
        fail(ctx, 400, "title is required")
        ret
    end
    if title.len() > 255:
        // Refuse it here rather than let MariaDB truncate silently.
        fail(ctx, 400, "title is too long (255 bytes max)")
        ret
    end
    due := json.Get(body, "due_on")
    if due.len() > 0 && !is_date(due):
        fail(ctx, 400, "due_on must be YYYY-MM-DD")
        ret
    end
    mut err := ""
    id := store.CreateTodo(uid, title, json.Get(body, "notes"), due, err)
    if id == 0 as i64:
        db_fail(ctx, "create todo", err)
        ret
    end
    http.Ctx_set_header(ctx, "Location", "/api/todos/".concat(conv.FormatInt(id)))
    send(ctx, 201, store.GetTodo(uid, id))
end

// YYYY-MM-DD, checked here so a bad date is a 400 and not a 500 from the
// driver. MariaDB does the real validation on the column.
func is_date(s: str): bool:
    if s.len() != 10: ret false end
    if s.substr(4, 1) != "-" || s.substr(7, 1) != "-": ret false end
    ret digits(s.substr(0, 4)) && digits(s.substr(5, 2)) && digits(s.substr(8, 2))
end

func digits(s: str): bool:
    n := s.len()
    repeat n with i:
        c := s.substr(i, 1)
        if c < "0" || c > "9": ret false end
    end
    ret n > 0
end

func update_todo(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    id := path_id(ctx)
    // 404 before doing any work, so a caller cannot use the difference
    // between "nothing changed" and "not yours" to probe for ids.
    if store.GetTodo(uid, id).len() == 0:
        fail(ctx, 404, "no such todo")
        ret
    end
    body := http.Ctx_body(ctx)
    mut set := ""
    if json.Has(body, "title"):
        title := json.Get(body, "title").trim()
        if title.len() == 0:
            fail(ctx, 400, "title cannot be empty")
            ret
        end
        set = add_set(set, "title = ".concat(store.Q(title)))
    end
    if json.Has(body, "notes"):
        set = add_set(set, "notes = ".concat(store.Q(json.Get(body, "notes"))))
    end
    if json.Has(body, "due_on"):
        due := json.Get(body, "due_on")
        if due.len() == 0:
            set = add_set(set, "due_on = NULL")
        else:
            if !is_date(due):
                fail(ctx, 400, "due_on must be YYYY-MM-DD")
                ret
            end
            set = add_set(set, "due_on = ".concat(store.Q(due)))
        end
    end
    if json.Has(body, "done"):
        if json.Get(body, "done") == "true":
            set = add_set(set, "done = 1")
        else:
            set = add_set(set, "done = 0")
        end
    end
    if set.len() == 0:
        fail(ctx, 400, "nothing to update")
        ret
    end
    mut err := ""
    if !store.UpdateTodo(uid, id, set, err):
        db_fail(ctx, "update todo", err)
        ret
    end
    send(ctx, 200, store.GetTodo(uid, id))
end

func add_set(set: str, clause: str): str:
    if set.len() == 0: ret clause end
    ret set.concat(", ").concat(clause)
end

func delete_todo(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    mut err := ""
    gone := store.DeleteTodo(uid, path_id(ctx), err)
    if err.len() > 0:
        db_fail(ctx, "delete todo", err)
        ret
    end
    if !gone:
        fail(ctx, 404, "no such todo")
        ret
    end
    send(ctx, 200, `{"deleted":true}`)
end

func stats(ctx: i64):
    uid := caller(ctx)
    if uid == 0 as i64: ret end
    send(ctx, 200, store.Stats(uid))
end

// Unauthenticated on purpose: this is what a load balancer polls.
func health(ctx: i64):
    send(ctx, 200, `{"status":"ok","service":"todo"}`)
end

func main:
    mut err := ""
    if !store.Open(err):
        println "cannot reach the database: ", err
        println "set DB_HOST / DB_PORT / DB_USER / DB_PASS / DB_NAME, then load schema.sql"
        ret 1
    end
    defer store.Close()
    mut r := router.NewRouter()
    router.Post(r, "/auth/register", register)
    router.Post(r, "/auth/login", login)
    router.Post(r, "/auth/refresh", refresh)
    router.Get(r, "/api/todos", list_todos)
    router.Post(r, "/api/todos", create_todo)
    router.Get(r, "/api/todos/:id", get_todo)
    // Get/Post/Put/Delete/Patch/Head/Options have helpers; anything else
    // goes through router.Method(r, "VERB", path, fn).
    router.Patch(r, "/api/todos/:id", update_todo)
    router.Delete(r, "/api/todos/:id", delete_todo)
    router.Get(r, "/api/stats", stats)
    router.Get(r, "/health", health)
    mut s := http.NewServer(PORT)
    http.Use(s, r)
    println "todo API on http://localhost:8090"
    http.Run(s)
    ret 0
end
