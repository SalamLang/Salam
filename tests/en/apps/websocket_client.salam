package main

import net.websocket

func main:
    mut c := websocket.Dial("127.0.0.1", 8079, "/")
    if !websocket.IsOpen(c):
        println "could not connect to ws://127.0.0.1:8079/"
        println "this example expects nothing to be listening on that port"
        ret
    end
    defer println "closed"
    defer websocket.Close(c)
    println "connected"
    websocket.SendText(c, "hello from salam")
    println "server said: " + websocket.ReceiveText(c)
    websocket.SendText(c, "second message")
    println "server said: " + websocket.ReceiveText(c)
    websocket.Ping(c, "ping!")
    m := websocket.Receive(c)
    if websocket.IsPong(m):
        println "pong received: " + m.text
    end
end
