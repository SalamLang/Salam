package main

import net.websocket
import str
import time

func cmd echo(args: str): str:
    if args == "":
        ret "ECHO(no arguments)"
    end
    ret "ECHO: " + args
end

func cmd time(): str:
    ret time.Format(time.Now())
end

func cmd reverse(args: str): str:
    ret str.Reverse(args)
end

func dispatch(line: str): str:
    trimmed := str.Trim(line)
    if trimmed == "":
        ret "ERROR empty command"
    end

    mut cmd := trimmed
    mut args := ""
    sp := str.Find(trimmed, " ")

    if sp >= 0:
        cmd = trimmed.substr(0, sp)
        args = str.Trim(trimmed.substr(sp + 1, str.Len(trimmed) - sp - 1))
    end

    if cmd == "echo":
        ret cmd echo(args)
    else cmd == "time":
        ret cmd time()
    else cmd == "reverse":
        ret cmd reverse(args)
    else cmd == "help":
        ret "commands: echo <text>, time, reverse <text>, help"
    end
    ret "ERROR unknown command: " + cmd
end

func serve client(c &: websocket.Conn):
    defer websocket.Close(c)
    mut m := websocket.Receive(c)
    until websocket.IsText(m):
        websocket.SendText(c, dispatch(m.text))
        m = websocket.Receive(c)
    end
end

func main:
    srv := websocket.Listen(8090)
    if !websocket.Ok(srv):
        println "failed to listen on port 8090"
        ret
    end
    defer websocket.CloseServer(srv)

    println "websocket command server on ws://localhost:8090/"
    println "commands: echo <text>, time, reverse <text>, help"

    running := true
    until running:
        mut c := websocket.Accept(srv)
        if websocket.IsOpen(c):
            println "client connected"
            serve client(c)
            println "client disconnected"
        end
    end
end
