package main

import net.websocket
import conv

func main:
    // 8080 is a popular number, and on a machine where something else
    // already holds it the demo used to stop right here. Fall back to an
    // OS-picked port instead, and let the banner name whichever port the
    // server really ended up on.
    mut srv := websocket.Listen(8080)
    if !websocket.Ok(srv):
        srv = websocket.Listen(0)
    end
    if !websocket.Ok(srv):
        println "failed to listen"
        ret
    end
    defer websocket.CloseServer(srv)
    println "websocket echo server listening on ws://localhost:" + conv.FormatInt(websocket.Port(srv) as i64) + "/"
    running := true
    until running:
        mut c := websocket.Accept(srv)
        if websocket.IsOpen(c):
            println "client connected"
            mut m := websocket.Receive(c)
            until websocket.IsText(m):
                println "received: " + m.text
                websocket.SendText(c, "echo: " + m.text)
                m = websocket.Receive(c)
            end
            println "client disconnected"
        end
    end
end
