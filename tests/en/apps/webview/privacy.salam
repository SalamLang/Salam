import gui.webview

func main():
    mut wv := webview.Create(false)
    defer wv.Destroy()

    wv.SetTitle("Locked-down WebView")
    wv.SetSize(800, 600, webview.HINT_NONE)

    wv.SetContextMenu(false)
    wv.SetDevToolsEnabled(false)
    wv.SetTranslateEnabled(false)

    if wv.IsDevToolsEnabled():
        println "devtools should be disabled"
    end
    if wv.IsTranslateEnabled():
        println "translation should be disabled"
    end

    wv.OpenDevTools()

    wv.SetDevToolsEnabled(true)
    if not wv.IsDevToolsEnabled():
        println "devtools should be enabled"
    end
    wv.OpenDevTools()

    wv.SetHTML("<h1>Locked down</h1>")
    wv.Run()
end
