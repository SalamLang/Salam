// Regression test: build-only.
//
// Importing `webview` puts codegen in GUI mode, which emits `#include
// <windows.h>` into the module header. Every std module whose own `extern:`
// block declares a Win32 API that <windows.h> also declares then had TWO
// declarations of that symbol in one translation unit - and they can never
// agree, because <windows.h> spells them with HANDLE/DWORD/BOOL/LPVOID and
// enum types (GET_FILEEX_INFO_LEVELS) that no Salam extern can name. tcc and
// gcc both reject that as "incompatible types for redefinition".
//
// codegen guards those externs behind SALAM_EXTERN_LIBC_ON_WIN32 so the real
// prototype from <windows.h> wins, but the guarded-name list is hand-written
// and had drifted: os/process (CreateProcessA, CreatePipe, ReadFile,
// GetStdHandle, ...), debug (DebugBreak) and fs (GetFileAttributesExA) were
// all missing, so any GUI program importing them failed to compile.
//
// Touching each affected module is enough - this only has to reach codegen
// and the C compiler, so it never opens a window and is registered
// .buildonly.
import webview
import os.process
import debug
import fs

func main():
    // fs -> GetFileAttributesExA, os/process -> CreateProcessA/CreatePipe/
    // ReadFile/GetStdHandle/..., debug -> the DebugBreak-declaring module.
    p := process.Process {}
    println process.Pid(p)
    println fs.Permissions(".")
    debug.Enter("win32_externs")
    debug.Exit()

    mut wv := webview.Create(false)
    defer wv.Destroy()
    wv.SetTitle("win32 extern guard regression")
    wv.SetHTML("<html><body>ok</body></html>")
end
