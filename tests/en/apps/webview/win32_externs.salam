import webview
import os.process
import debug
import fs
import sync
import pool
import term

func main():
    p := process.Process {}
    println process.Pid(p)
    println fs.Permissions(".")
    debug.Enter("win32_externs")
    debug.Exit()
    m := sync.NewMutex()
    sync.Lock(m)
    sync.Unlock(m)
    sync.SleepMs(1)
    println pool.CPUCount(), term.Cols()

    mut wv := webview.Create(false)
    defer wv.Destroy()
    wv.SetTitle("win32 extern guard regression")
    wv.SetHTML("<html><body>ok</body></html>")
end
