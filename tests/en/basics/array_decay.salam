// An array decays to a pointer to its first element, so a module can own a
// table of bytes and hand its address to anything that walks memory. Without
// it a data blob had to be a C array or an .incbin, because '&' in Salam
// takes a function's address and nothing else.

const TABLE := [11 as u8, 22 as u8, 33 as u8]

mut BUF := [0 as u8, 0 as u8, 0 as u8, 0 as u8]

func table_base(): u64:
    ret (TABLE as void*) as u64
end

func buf_base(): u64:
    ret (BUF as void*) as u64
end

func main:
    read := (table_base() + (1 as u64)) as u8*
    println read[0] as int

    write := buf_base() as u8*
    write[2] = 77 as u8
    println BUF[2] as int

    local := [5 as u8, 6 as u8]
    near := (local as void*) as u8*
    println near[1] as int

    mut total := 0
    mut i := 0 as u64
    while i < (3 as u64):
        byte := (table_base() + i) as u8*
        total += byte[0] as int
        i += 1 as u64
    end
    println total
end
