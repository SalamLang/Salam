const READ := 1
const WRITE := 2
const EXEC := 4

func describe(bits: int): str:
    mut s := ""
    if (bits & READ) != 0: s = s + "r" end
    if (bits & WRITE) != 0: s = s + "w" end
    if (bits & EXEC) != 0: s = s + "x" end
    if s == "": ret "---" end
    ret s
end

func main:
    mut perms := 0
    println perms, describe(perms)

    perms = perms | READ
    println "after granting read: ", perms, describe(perms)

    perms = perms | WRITE
    println "after granting write:", perms, describe(perms)

    perms = perms & ~WRITE
    println "after revoking write:", perms, describe(perms)

    perms = perms ^ EXEC
    println "after toggling exec: ", perms, describe(perms)

    perms = perms ^ EXEC
    println "after toggling again:", perms, describe(perms)

    println "can read: ", (perms & READ) != 0
    println "can write:", (perms & WRITE) != 0

    println "every combination:"
    repeat 8 with i:
        println i, describe(i)
    end
end
