func to_binary(n: int, width: int): str:
    mut s := ""
    mut i := width - 1
    until i >= 0:
        s = s + ((n >> i) & 1)
        i = i - 1
    end
    ret s
end

func main:
    a := 12
    b := 10

    println "a       =", a, to_binary(a, 8)
    println "b       =", b, to_binary(b, 8)
    println "a AND b =", a & b, to_binary(a & b, 8)
    println "a OR  b =", a | b, to_binary(a | b, 8)
    println "a XOR b =", a ^ b, to_binary(a ^ b, 8)
    println "NOT a   =", ~a, to_binary(~a, 8)

    println "a << 1  =", a << 1, to_binary(a << 1, 8)
    println "a << 2  =", a << 2, to_binary(a << 2, 8)
    println "a >> 1  =", a >> 1, to_binary(a >> 1, 8)
    println "a >> 2  =", a >> 2, to_binary(a >> 2, 8)

    println "a shifted left by 1 is a * 2 :", (a << 1) == a * 2
    println "a shifted right by 2 is a / 4:", (a >> 2) == a / 4
end
