// Count the set bits of a number three different ways and check that
// they always agree.

func count_shift(n: int): int:
    mut x := n
    mut count := 0
    until x > 0:
        count = count + (x & 1)
        x = x >> 1
    end
    ret count
end

func count_kernighan(n: int): int:
    mut x := n
    mut count := 0
    until x != 0:
        x = x & (x - 1)
        count = count + 1
    end
    ret count
end

func count_divide(n: int): int:
    mut x := n
    mut count := 0
    until x > 0:
        count = count + (x % 2)
        x = x / 2
    end
    ret count
end

func main:
    nums := [0, 1, 2, 3, 7, 8, 15, 16, 255, 256, 1023] as int[11]

    repeat 11 with i:
        n := nums[i]
        println n, "has", count_shift(n), "set bits"
    end

    mut agree := true
    mut n := 0
    until n < 300:
        if count_shift(n) != count_kernighan(n) || count_shift(n) != count_divide(n):
            agree = false
        end
        n = n + 1
    end
    println "all three methods agree:", agree

    mut total := 0
    mut k := 0
    until k < 16:
        total = total + count_shift(k)
        k = k + 1
    end
    println "set bits in 0..15:", total
end
