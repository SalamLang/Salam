struct Job:
    pub function: str = ""
    pub return: int = 0
end

func main:
    for := 3
    while := 2
    mut fn_ty := 1
    fn_ty += for
    j := Job { function = "build", return = while }
    println for, while, fn_ty, j.function, j.return
end
