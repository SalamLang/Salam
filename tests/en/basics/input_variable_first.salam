func main:
    name := input "Name: "
    println "[" + name + "]"
    mut line := input "Line: "
    line = input "Again: "
    println "Hi " + line + "!"
    typed := input "Typed: "
    println "<" + typed + ">"
    prompt := "Prompt: "
    answer := input prompt
    println answer + "!"
end
