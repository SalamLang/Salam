package main

func pair(a: int, b: int): int:
    ret a * 1000 + b
end

func main:
    println 0xA5
    println 0x3C
    println pair(0xA5, 0x3C)
    println pair(0b1010, 0b11)
    println pair(0o17, 0o7)
    println pair(0XFF, 0B1)
    println pair(0O10, 0xA53C)
    arr := [0xA5, 0x3C, 0x01]
    println pair(arr[0], arr[1])
    println arr[2]
    println 0xDEAD_BEEF
    println 1_000_000
    println pair(0x7F, 0b0)
    farr := [1.5f, 2.5f]
    println farr[0]
    println farr[1]
    println 1.5f
    ret 0
end
