struct Node:
    pub val: int
end

func getNode(): Node:
    ret Node { val = 7 }
end

func main:
    a := 2
    b := 3
    c := 2
    d := 3
    e := 1
    println a + b * c ** d + e
    println 2 ** 3 ** 2
    println (a + b) * c
    println 10 - 4 - 3
    println 100 / 10 / 5
    println 0 - 2 ** 2
    println -2 ** 2
    println 7 % 4 * 2
    println 1 + 2 == 3 and 2 * 2 == 4
    println not false and false
    println not (false and false)
    println true or false and false
    println 1 << 2 + 1
    println getNode().val + 1
    t := true
    f := false
    println not t or f
end
