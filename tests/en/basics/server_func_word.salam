import net.http

struct Site:
    pub server: str = ""
    pub port: int = 0
end

struct Item:
    pub name: str = ""
    pub price: float = 0.0
end

server func Price(id: int): float?:
    if id == 1:
        ret 2.5
    end
    ret null
end

pub server func Items(tag: str): Vector<Item>:
    mut out := Vector {} as Vector<Item>
    out.Push(Item { name = tag, price = 1.5 })
    ret out
end

func main:
    server := "local"
    site := Site { server = server, port = 80 }
    mut srv := http.NewServer(site.port)
    println site.server
    p := Price(1)
    println p.present
    println Items("pen").Get(0).name
    http.HideTokens(srv)
    println site.port
end
