include szpkg "_size_user_pkg.salam"
include szbuiltin "_size_builtin_pkg.salam"

func size(label: str): int:
    println label
    ret 7
end

func main:
    println size("mine")
    println szpkg.size(2), szpkg.Twice(3)
    println szbuiltin.Bytes(), szbuiltin.Wide()
    println size(i32)
end
