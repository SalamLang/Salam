struct Bag:
    pub items: int

    pub func size(): int:
        ret this.items
    end

    pub func sizeof(): int:
        ret this.items * 2
    end
end

func main:
    b := Bag { items = 5 }
    size := 3
    sizeof := 4
    println b.size(), b.sizeof(), size, sizeof
    println size(i32), size(Bag)
end
