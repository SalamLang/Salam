component Row(label: str):
    item:
        content = label
    end
end

page Home(names: Vector<str>):
    list:
        each j, name in names:
            item:
                key = j
                content = name
            end
        end
        each i, other in names:
            item: key = i content = other end
        end
        each j, used in names:
            Row:
                key = j
                label = used
            end
        end
    end
end

func main:
    println Home(Vector {} as Vector<str>)
end
