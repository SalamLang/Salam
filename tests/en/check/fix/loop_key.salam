component Row(label: str):
    item:
        content = label
    end
end

page Home(names: Vector<str>):
    list:
        each name in names:
            item:
                content = name
            end
        end
        each i, other in names:
            item: content = other end
        end
        each used in names:
            Row:
                label = used
            end
        end
    end
end

func main:
    println Home(Vector {} as Vector<str>)
end
