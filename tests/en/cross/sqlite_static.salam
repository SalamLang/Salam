import db.sqlite
func main:
    db := sqlite.Open(":memory:")
    sqlite.Exec(db, "CREATE TABLE t(x INTEGER)")
    sqlite.Exec(db, "INSERT INTO t VALUES (42)")
    println sqlite.QueryInt(db, "SELECT x FROM t")
    sqlite.Close(db)
end
