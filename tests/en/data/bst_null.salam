// A binary search tree built from heap nodes whose children are raw
// pointers. An absent child is `null`, so every walk has to ask
// `!= null` before it follows a link.

import mem

struct Node:
    pub key: int = 0
    pub left: Node* = null
    pub right: Node* = null
end

func leaf(k: int): Node*:
    n := mem.Allocate(sizeof(Node) as u64) as Node*
    n[0] = Node { key = k, left = null, right = null }
    ret n
end

func insert(root: Node*, k: int): Node*:
    if root == null: ret leaf(k) end
    if k < root.key:
        root.left = insert(root.left, k)
    else k > root.key:
        root.right = insert(root.right, k)
    end
    ret root
end

func contains(root: Node*, k: int): bool:
    mut cur := root
    until cur != null:
        if k == cur.key: ret true end
        cur = k < cur.key ? cur.left : cur.right
    end
    ret false
end

// The four cases an app has to distinguish: both children, one child
// (either side), or none.
func shape(n: Node*): str:
    if n == null: ret "absent" end
    has_left := n.left != null
    has_right := n.right != null
    if has_left && has_right: ret "both" end
    if has_left: ret "left only" end
    if has_right: ret "right only" end
    ret "leaf"
end

func height(n: Node*): int:
    if n == null: ret 0 end
    l := height(n.left)
    r := height(n.right)
    ret 1 + (l > r ? l : r)
end

func count(n: Node*): int:
    if n == null: ret 0 end
    ret 1 + count(n.left) + count(n.right)
end

// Leftmost node: walk while a left child exists.
func min_key(n: Node*): int:
    mut cur := n
    until cur.left != null: cur = cur.left end
    ret cur.key
end

func max_key(n: Node*): int:
    mut cur := n
    until cur.right != null: cur = cur.right end
    ret cur.key
end

func inorder(n: Node*):
    if n == null: ret end
    inorder(n.left)
    print n.key, ""
    inorder(n.right)
end

func find(root: Node*, k: int): Node*:
    mut cur := root
    until cur != null:
        if k == cur.key: ret cur end
        cur = k < cur.key ? cur.left : cur.right
    end
    ret null
end

// Post-order teardown: free both subtrees before the node itself, or the
// pointers to them are gone.
func destroy(n: Node*):
    if n == null: ret end
    destroy(n.left)
    destroy(n.right)
    mem.Free(n as void*)
end

func main:
    mut root := null as Node*
    keys := [50, 30, 70, 20, 40, 60, 80, 35]
    each k in keys: root = insert(root, k) end

    print "inorder:"
    inorder(root)
    println ""

    println "count =", count(root)
    println "height =", height(root)
    println "min =", min_key(root), "max =", max_key(root)

    println "root shape:", shape(root)
    println "30 shape:", shape(find(root, 30))
    println "40 shape:", shape(find(root, 40))
    println "35 shape:", shape(find(root, 35))
    println "80 shape:", shape(find(root, 80))
    println "99 shape:", shape(find(root, 99))

    println "has 60:", contains(root, 60)
    println "has 65:", contains(root, 65)

    // An empty tree is just a null root; every helper must survive it.
    empty := null as Node*
    println "empty count =", count(empty), "height =", height(empty)
    println "empty shape:", shape(empty)
    println "empty has 1:", contains(empty, 1)

    // Derived printing never follows a pointer, so children render as
    // null / <ptr> and a leaf is visibly a leaf.
    println find(root, 35)[0]

    destroy(root)
end
