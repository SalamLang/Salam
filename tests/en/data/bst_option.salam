// The same binary search tree without a single pointer: nodes live in an
// arena Vector and a child is an Option<int> index. There is nothing to
// dereference, so a missing child cannot be walked into by mistake -
// IsSome has to be asked first, exactly like Rust's Option<Box<Node>>.

import option

type Link = option.Option<int>

struct Node:
    pub key: int = 0
    pub left: Link
    pub right: Link
end

struct Tree:
    pub nodes: Vector<Node> = Vector {}
    pub root: Link
end

// The type parameter of None() is inferred from the return type, so this
// wrapper is what makes `no_child()` usable wherever a Link is expected.
func no_child(): Link: ret option.None() end

func child(i: int): Link: ret option.Some(i) end

func add_node(t &: Tree, k: int): int:
    t.nodes.push(Node { key = k, left = no_child(), right = no_child() })
    ret t.nodes.len() - 1
end

func attach(t &: Tree, at: int, k: int):
    mut cur := at
    until true:
        node := t.nodes[cur]
        if k < node.key:
            if option.IsNone(node.left):
                fresh := add_node(t, k)
                p := t.nodes.ref(cur)
                p.left = child(fresh)
                ret
            end
            cur = option.Unwrap(node.left)
        else k > node.key:
            if option.IsNone(node.right):
                fresh := add_node(t, k)
                p := t.nodes.ref(cur)
                p.right = child(fresh)
                ret
            end
            cur = option.Unwrap(node.right)
        else:
            ret
        end
    end
end

func insert(t &: Tree, k: int):
    if option.IsNone(t.root):
        t.root = child(add_node(t, k))
        ret
    end
    attach(t, option.Unwrap(t.root), k)
end

func shape(t: Tree, at: Link): str:
    if option.IsNone(at): ret "absent" end
    n := t.nodes[option.Unwrap(at)]
    has_left := option.IsSome(n.left)
    has_right := option.IsSome(n.right)
    if has_left && has_right: ret "both" end
    if has_left: ret "left only" end
    if has_right: ret "right only" end
    ret "leaf"
end

func find(t: Tree, k: int): Link:
    mut at := t.root
    until option.IsSome(at):
        n := t.nodes[option.Unwrap(at)]
        if k == n.key: ret at end
        at = k < n.key ? n.left : n.right
    end
    ret no_child()
end

func height(t: Tree, at: Link): int:
    if option.IsNone(at): ret 0 end
    n := t.nodes[option.Unwrap(at)]
    l := height(t, n.left)
    r := height(t, n.right)
    ret 1 + (l > r ? l : r)
end

func inorder(t: Tree, at: Link):
    if option.IsNone(at): ret end
    n := t.nodes[option.Unwrap(at)]
    inorder(t, n.left)
    print n.key, ""
    inorder(t, n.right)
end

// UnwrapOr is the "give me a default instead of crashing" reader: no
// branch of this function can touch an absent child.
func left_key_or(t: Tree, at: Link, fallback: int): int:
    if option.IsNone(at): ret fallback end
    c := t.nodes[option.Unwrap(at)].left
    if option.IsNone(c): ret fallback end
    ret t.nodes[option.Unwrap(c)].key
end

func main:
    mut t := Tree { root = no_child() }
    defer t.nodes.free()

    each k in [50, 30, 70, 20, 40, 60, 80, 35]: insert(t, k) end

    print "inorder:"
    inorder(t, t.root)
    println ""

    println "nodes =", t.nodes.len()
    println "height =", height(t, t.root)

    println "root shape:", shape(t, t.root)
    println "30 shape:", shape(t, find(t, 30))
    println "40 shape:", shape(t, find(t, 40))
    println "35 shape:", shape(t, find(t, 35))
    println "80 shape:", shape(t, find(t, 80))
    println "99 shape:", shape(t, find(t, 99))

    println "left of 40 =", left_key_or(t, find(t, 40), -1)
    println "left of 35 =", left_key_or(t, find(t, 35), -1)
    println "left of 99 =", left_key_or(t, find(t, 99), -1)

    println "found 60:", option.IsSome(find(t, 60))
    println "found 65:", option.IsSome(find(t, 65))

    // An empty tree carries a None root; nothing special-cases it.
    mut empty := Tree { root = no_child() }
    defer empty.nodes.free()
    println "empty height =", height(empty, empty.root)
    println "empty shape:", shape(empty, empty.root)
    println "empty found 1:", option.IsSome(find(empty, 1))
end
