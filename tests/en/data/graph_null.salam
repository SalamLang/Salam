// A directed graph as classic C-style adjacency lists: every vertex owns a
// singly linked chain of Edge nodes terminated by `null`. An isolated
// vertex is one whose head is null, so "does this vertex have any
// neighbour?" is the very same null test a tree asks about left and right.

import mem

struct Edge:
    pub dst: int = 0
    pub next: Edge* = null
end

struct Vertex:
    pub first: Edge* = null
end

struct Graph:
    pub verts: Vector<Vertex> = Vector {}
end

func add_vertex(g &: Graph): g.verts.push(Vertex { first = null }) end

func link(g &: Graph, from: int, dst: int):
    e := mem.Allocate(sizeof(Edge) as u64) as Edge*
    e[0] = Edge { dst = dst, next = g.verts[from].first }
    v := g.verts.ref(from)
    v.first = e
end

// The three questions an adjacency walk has to answer, all of them null
// tests: any neighbour at all, how many, and is this specific one there.
func has_edges(g: Graph, v: int): bool: ret g.verts[v].first != null end

func degree(g: Graph, v: int): int:
    mut n := 0
    mut e := g.verts[v].first
    until e != null:
        n = n + 1
        e = e.next
    end
    ret n
end

func has_edge(g: Graph, from: int, dst: int): bool:
    mut e := g.verts[from].first
    until e != null:
        if e.dst == dst: ret true end
        e = e.next
    end
    ret false
end

// Iterative DFS. `parent` is -1 at the source and -1 for every vertex the
// walk never reaches: the index-world stand-in for a null link.
func reach(g: Graph, src: int, seen &: Vector<bool>, parent &: Vector<int>):
    mut stack := Vector {} as Vector<int>
    defer stack.free()
    seen[src] = true
    stack.push(src)
    until stack.len() > 0:
        v := stack.pop()
        mut e := g.verts[v].first
        until e != null:
            if seen[e.dst] == false:
                seen[e.dst] = true
                parent[e.dst] = v
                stack.push(e.dst)
            end
            e = e.next
        end
    end
end

func path_to(parent: Vector<int>, v: int): str:
    mut out := "" + v
    mut cur := parent[v]
    until cur != -1:
        out = "" + cur + " -> " + out
        cur = parent[cur]
    end
    ret out
end

func release(g &: Graph):
    repeat g.verts.len() with v:
        mut e := g.verts[v].first
        until e != null:
            nxt := e.next
            mem.Free(e as void*)
            e = nxt
        end
        p := g.verts.ref(v)
        p.first = null
    end
end

func main:
    mut g := Graph {}
    defer g.verts.free()
    repeat 6: add_vertex(g) end

    // 0 -> 1 -> 3, 0 -> 2 -> 3 -> 4, with 5 left isolated.
    link(g, 0, 2)
    link(g, 0, 1)
    link(g, 1, 3)
    link(g, 2, 3)
    link(g, 3, 4)

    repeat 6 with v:
        println "vertex", v, "has edges:", has_edges(g, v), "degree:", degree(g, v)
    end

    println "0->1:", has_edge(g, 0, 1)
    println "1->0:", has_edge(g, 1, 0)
    println "5 has any:", has_edges(g, 5)

    mut seen := Vector {} as Vector<bool>
    defer seen.free()
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    repeat 6:
        seen.push(false)
        parent.push(-1)
    end
    reach(g, 0, seen, parent)

    repeat 6 with v:
        if seen[v]:
            println "reached", v, "via", path_to(parent, v)
        else:
            println "unreachable", v
        end
    end

    // Walking off the end of a chain must simply stop.
    tail := g.verts[3].first
    println "last edge of 3:", tail.dst, "next is null:", tail.next == null

    release(g)
    println "after release, 0 has edges:", has_edges(g, 0)
end
