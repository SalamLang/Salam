import core

type Maybe = int?

struct Graph:
    pub n: int = 0
    pub adj: Vector<bool> = Vector {}
end

func nothing(): Maybe: ret null end

func just(i: int): Maybe: ret i end

func make_graph(n: int): Graph:
    mut g := Graph { n = n }
    repeat n * n: g.adj.push(false) end
    ret g
end

func link(g &: Graph, from: int, dst: int): g.adj[from * g.n + dst] = true end

func has_edge(g: Graph, from: int, dst: int): bool: ret g.adj[from * g.n + dst] end

func first_neighbor(g: Graph, v: int): Maybe:
    repeat g.n in j:
        if g.adj[v * g.n + j]: ret just(j) end
    end
    ret nothing()
end

func last_neighbor(g: Graph, v: int): Maybe:
    mut found := nothing()
    repeat g.n in j:
        if g.adj[v * g.n + j]: found = just(j) end
    end
    ret found
end

func degree(g: Graph, v: int): int:
    mut d := 0
    repeat g.n in j:
        if g.adj[v * g.n + j]: d++ end
    end
    ret d
end

func bfs(g: Graph, src: int, parent &: Vector<Maybe>, dist &: Vector<Maybe>):
    mut queue := Vector {} as Vector<int>
    defer queue.Free()
    dist[src] = just(0)
    queue.push(src)
    mut head := 0
    until head < queue.Len():
        v := queue[head]
        head++
        d := dist[v].unwrap()
        repeat g.n in j:
            if g.adj[v * g.n + j] and dist[j].is_none():
                dist[j] = just(d + 1)
                parent[j] = just(v)
                queue.push(j)
            end
        end
    end
end

func path_to(parent: Vector<Maybe>, dist: Vector<Maybe>, v: int): str:
    if dist[v].is_none(): ret "no path" end
    mut out := "" + v
    mut at := parent[v]
    until at.is_some():
        p := at.unwrap()
        out = "" + p + " -> " + out
        at = parent[p]
    end
    ret out
end

func main:
    mut g := make_graph(6)
    defer g.adj.Free()

    link(g, 0, 1)
    link(g, 0, 2)
    link(g, 1, 3)
    link(g, 2, 3)
    link(g, 3, 4)

    repeat 6 in v:
        f := first_neighbor(g, v)
        l := last_neighbor(g, v)
        print "vertex", v, "degree", degree(g, v)
        print " first", f.unwrap_or(-1), "last", l.unwrap_or(-1)
        println " isolated", f.is_none()
    end

    println "0->1:", has_edge(g, 0, 1)
    println "1->0:", has_edge(g, 1, 0)

    mut parent := Vector {} as Vector<Maybe>
    defer parent.Free()
    mut dist := Vector {} as Vector<Maybe>
    defer dist.Free()
    repeat 6:
        parent.push(nothing())
        dist.push(nothing())
    end
    bfs(g, 0, parent, dist)

    repeat 6 in v:
        if dist[v].is_some():
            d := dist[v].unwrap()
            println "reached", v, "at depth", d, "via", path_to(parent, dist, v)
        else:
            println "unreachable", v, "depth", dist[v].unwrap_or(-1)
        end
    end

    print "root reached:", dist[0].is_some()
    println " root has parent:", parent[0].is_some()
    print "5 reached:", dist[5].is_some()
    println " 5 has parent:", parent[5].is_some()
    println "path to 5:", path_to(parent, dist, 5)

    println "depth of 4 =", core.Expect(dist[4], "4 must be reachable from 0")
end
