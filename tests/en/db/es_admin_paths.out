== elasticsearch
put pipeline true
   PUT /_ingest/pipeline/p%201 {"processors":[]}
get pipeline body
   GET /_ingest/pipeline/p%201
delete pipeline true
   DELETE /_ingest/pipeline/p%201
simulate body
   POST /_ingest/pipeline/_simulate {"docs":[]}
create stream true
   PUT /_data_stream/logs-a
get stream body
   GET /_data_stream/logs-*
delete stream true
   DELETE /_data_stream/logs-a
rollover true
   POST /logs-a/_rollover
put policy true
   PUT /_ilm/policy/keep {"policy":{}}
delete policy true
   DELETE /_ilm/policy/keep
repository true
   PUT /_snapshot/r {"type":"fs"}
snapshot true
   PUT /_snapshot/r/s1?wait_for_completion=true
restore true
   POST /_snapshot/r/s1/_restore?wait_for_completion=true
list s1,s2
   GET /_snapshot/r/_all
delete snapshot true
   DELETE /_snapshot/r/s1
delete repository true
   DELETE /_snapshot/r
cluster settings true
   PUT /_cluster/settings {"persistent":{}}
get cluster settings body
   GET /_cluster/settings?flat_settings=true
task true
   GET /_tasks/node%3A7
cancel ok true
   POST /_tasks/node%3A7/_cancel
cancel failed false
   POST /_tasks/node%3A9/_cancel
start reindex node:7
   POST /_reindex?wait_for_completion=false {"source": {"index": "a"}, "dest": {"index": "b"}}
start delete node:7
   POST /a/_delete_by_query?wait_for_completion=false {"query": {"match_all": {}}}
start update node:7
   POST /a/_update_by_query?wait_for_completion=false {"query": {"term": {"t": "x"}}, "script": {"source": "ctx._source.n = 1", "lang": "painless"}}
stored script true
   PUT /_scripts/s {"script": {"lang": "painless", "source": "ctx._source.n++"}}
stored template true
   PUT /_scripts/t {"script": {"lang": "mustache", "source": {"query":{"match_all":{}}}}}
delete script true
   DELETE /_scripts/s
template search 0
   POST /a/_search/template {"id": "t", "params": {"q":1}}
async AS1 false 3
   POST /a,b/_async_search?keep_on_completion=true&wait_for_completion_timeout=1s {"size": 0}
async get AS1
   GET /_async_search/AS1?wait_for_completion_timeout=2s
async delete true
   DELETE /_async_search/AS1
explain body
   POST /a/_explain/1 {"query": {"match_all": {}}}
validate true
   POST /_validate/query {"query": {"match_all": {}}}
field caps body
   GET /a/_field_caps?fields=title,n*
term vectors body
   GET /a/_termvectors/1?fields=title,n*
stats body
   GET /_stats
== opensearch
put policy true
   PUT /_plugins/_ism/policies/keep {"policy":{}}
async AS1
   POST /_plugins/_asynchronous_search?keep_on_completion=true&index=a&wait_for_completion_timeout=1s {"size": 0}
async delete true
   DELETE /_plugins/_asynchronous_search/AS1
