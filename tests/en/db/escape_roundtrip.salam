import db.mysql

include "_linkmock.salam"

func main:
    db := mysql.Open("", "root", "", "test", 3306)
    mysql.Exec(db, "CREATE TABLE t(n TEXT)")
    name := "O'Brien"
    mysql.Exec(db, "INSERT INTO t(n) VALUES ('" + mysql.Escape(db, name) + "')")
    println mysql.QueryText(db, "SELECT n FROM t LIMIT 1")
    mysql.Close(db)
end
