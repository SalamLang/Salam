import db
import db.sqlite
import db.postgres
import "_linkmock.salam"

func exercise(c: dyn db.Connection):
    mut m := db.NewMigrator()
    // Added out of order on purpose: the migrator keeps them in version order.
    db.AddMigration(m, 2, "posts",
        "CREATE TABLE posts (id INTEGER PRIMARY KEY, title TEXT)",
        "DROP TABLE posts")
    db.AddMigration(m, 1, "users",
        "CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT NOT NULL); INSERT INTO users (id, email) VALUES (1, 'a@b.c')",
        "DROP TABLE users")

    println db.MigrationCount(m), db.SchemaVersion(m, c), db.PendingCount(m, c)
    println db.MigrateUp(m, c)
    println db.SchemaVersion(m, c), db.PendingCount(m, c)
    println db.QueryInt(c, "SELECT COUNT(*) FROM users")
    println db.IsApplied(m, c, 1), db.IsApplied(m, c, 2), db.IsApplied(m, c, 3)
    println db.MigrateUp(m, c)

    println db.Rollback(m, c)
    println db.SchemaVersion(m, c)
    println db.MigrateTo(m, c, 2)
    println db.SchemaVersion(m, c)
    println db.MigrateTo(m, c, 0)
    println db.SchemaVersion(m, c)

    db.FreeMigrator(m)
end

func main:
    d := sqlite.Open(":memory:")
    exercise(sqlite.Conn(d))
    sqlite.Close(d)
    p := postgres.Open("host=127.0.0.1 dbname=test")
    exercise(postgres.Conn(p))
    postgres.Close(p)

    parts := db.SplitStatements("SELECT ';' ; UPDATE t SET s = 'a;b' ; ")
    println parts.len()
    println parts.get(0)
    println parts.get(1)
    parts.free()
end
