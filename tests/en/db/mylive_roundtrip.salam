import db.mysql
import os
import conv

func main:
    p := os.Env("SALAM_TEST_MYSQL").split(" ")
    d := mysql.Open(p.get(0), p.get(2), p.get(3), p.get(4), conv.ParseInt(p.get(1)) as int)
    println mysql.Ok(d)
    mysql.Exec(d, "DROP TABLE IF EXISTS mylive_items")
    println mysql.Exec(d, "CREATE TABLE mylive_items (id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(50), score DOUBLE, note TEXT) CHARACTER SET utf8mb4")
    println mysql.Exec(d, "INSERT INTO mylive_items (name, score, note) VALUES ('a', 1.5, NULL), ('سلام', 2.25, 'x')")
    println mysql.AffectedRows(d)
    println mysql.LastInsertId(d)
    r := mysql.Query(d, "SELECT id, name, score, note FROM mylive_items ORDER BY id")
    println mysql.ColumnCount(r)
    println mysql.RowCount(r)
    println mysql.ColumnName(r, 1)
    mut rr := r
    until mysql.Next(rr):
        println mysql.Text(rr, 0) + "|" + mysql.Text(rr, 1) + "|" + mysql.Text(rr, 2) + "|" + mysql.Text(rr, 3)
        println mysql.IsNull(rr, 3)
    end
    mysql.Finish(rr)
    e := mysql.Escape(d, "it's a \"q\" \\ test")
    println mysql.QueryText(d, "SELECT '" + e + "'")
    println mysql.Exec(d, "SELECT * FROM mylive_missing")
    println mysql.Errno(d)
    println mysql.QueryInt(d, "SELECT LENGTH(REPEAT('x', 100000))")
    println mysql.Ping(d)
    println mysql.Begin(d)
    mysql.Exec(d, "INSERT INTO mylive_items (name) VALUES ('rolled back')")
    println mysql.Rollback(d)
    println mysql.QueryInt(d, "SELECT COUNT(*) FROM mylive_items")
    println mysql.Exec(d, "DROP TABLE mylive_items")
    mysql.Close(d)
    bad := mysql.Open(p.get(0), p.get(2), "wrong-password", p.get(4), conv.ParseInt(p.get(1)) as int)
    println mysql.Ok(bad)
    println mysql.Error(bad).includes("denied")
end
