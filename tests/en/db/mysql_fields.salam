import db
import db.mysql

include "_linkmock.salam"

func main:
    d := mysql.OpenFull("127.0.0.1", "root", "", "test", 3306, "", 0 as u64)
    println mysql.Ok(d)
    println mysql.Exec(d, "CREATE TABLE t (id INTEGER, name TEXT, w REAL)")
    println mysql.Exec(d, "INSERT INTO t VALUES (1, 'ada', 1.5)")
    println mysql.Exec(d, "INSERT INTO t VALUES (2, NULL, NULL)")
    mut r := mysql.Query(d, "SELECT id, name, w FROM t ORDER BY id")
    until mysql.Next(r):
        println mysql.FieldType(r, 0), mysql.FieldType(r, 1), mysql.FieldType(r, 2)
        println mysql.FieldKind(r, 0), mysql.FieldKind(r, 1), mysql.FieldKind(r, 2)
        println mysql.ColumnKind(r, 0), mysql.ColumnKind(r, 1), mysql.ColumnKind(r, 2)
    end
    mysql.Finish(r)
    mysql.Close(d)
    println db.TYPE_NULL, db.TYPE_INT, db.TYPE_FLOAT, db.TYPE_TEXT
end
