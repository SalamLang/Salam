// MySQL through the shared db.Connection surface. It is kept apart from
// shared_iface because this API hands every value over as text, so ColumnType
// answers TYPE_TEXT (3) where sqlite and postgres report the column's own type.

import db
import db.mysql
import "_linkmock.salam"

func exercise(c: dyn db.Connection):
    println c.Kind(), c.Ok(), c.Ping()
    println c.Exec("CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    println c.Exec("INSERT INTO t (id, name) VALUES (1, 'ada')")
    println c.Exec("INSERT INTO t (id, name) VALUES (2, 'grace')")
    println c.Changes(), c.LastInsertId()
    r := c.Query("SELECT id, name FROM t ORDER BY id")
    println r.Ok(), r.ColumnCount(), r.ColumnName(1)
    until r.Next():
        println r.Int(0), r.Text(1), r.IsNull(1), r.ColumnType(1)
    end
    println r.Close()
    println db.QueryInt(c, "SELECT COUNT(*) FROM t")
    println db.QueryText(c, "SELECT name FROM t ORDER BY id")
    println db.CountRows(c, "SELECT id FROM t")

    t := c.Begin()
    println t.Ok()
    println t.Exec("INSERT INTO t (id, name) VALUES (3, 'edsger')")
    println t.Commit()
    println db.QueryInt(c, "SELECT COUNT(*) FROM t")
end

func main:
    d := mysql.Open("", "root", "", "test", 3306)
    exercise(mysql.Conn(d))
    mysql.Close(d)
end
