import db.postgres

include "_linkmock.salam"

func main:
    c := postgres.OpenFull("127.0.0.1", 5432, "app", "secret", "shop")
    println postgres.Ok(c)
    println postgres.DatabaseName(c), postgres.UserName(c), postgres.HostName(c)
    postgres.Close(c)

    bare := postgres.OpenFull("", 0, "", "", "")
    println postgres.Ok(bare)
    println postgres.DatabaseName(bare).len(), postgres.UserName(bare).len()
    postgres.Close(bare)
end
