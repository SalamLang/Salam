import db.postgres
import "_linkmock.salam"

func main:
    c := postgres.Open("host=127.0.0.1 dbname=test")
    println postgres.Ok(c)
    println postgres.Exec(c, "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, w REAL)")
    println postgres.Exec(c, "INSERT INTO t (id, name, w) VALUES (1, 'ada', 1.5)")
    println postgres.Exec(c, "INSERT INTO t (id, name, w) VALUES (2, 'grace', 2.25)")
    r := postgres.Query(c, "SELECT id, name, w FROM t ORDER BY id")
    println r.Ok(), r.ColumnCount(), r.RowCount()
    println r.ColumnName(0), r.ColumnName(1), r.ColumnName(2)
    until r.Next():
        println r.Int(0), r.Text(1), r.Float(2)
    end
    println r.Close()
    println postgres.QueryInt(c, "SELECT COUNT(*) FROM t")
    println postgres.QueryText(c, "SELECT name FROM t ORDER BY id DESC")
    postgres.Close(c)
end
