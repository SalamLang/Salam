import db.postgres
import os
import str

func main:
    d := postgres.Open(os.Env("SALAM_TEST_PG"))
    println postgres.Ok(d)
    postgres.Exec(d, "DROP TABLE IF EXISTS pglive_items")
    println postgres.Exec(d, "CREATE TABLE pglive_items (id serial PRIMARY KEY, name text, score float8, ok bool)")
    println postgres.ExecCount(d, "INSERT INTO pglive_items (name, score, ok) VALUES ('a', 1.5, true), ('b', NULL, false), ('سلام', 2.25, NULL)")
    println postgres.ExecCount(d, "UPDATE pglive_items SET score = 3 WHERE id > 1")
    r := postgres.Query(d, "SELECT id, name, score, ok FROM pglive_items ORDER BY id")
    println r.ColumnCount()
    println r.RowCount()
    println r.ColumnName(1)
    until r.Next():
        println r.Text(0) + "|" + r.Text(1) + "|" + r.Text(2) + "|" + r.Text(3)
        println r.IsNull(3)
    end
    r.Close()
    q := postgres.Quote(d, "it's a \\ test")
    println postgres.QueryText(d, "SELECT " + q)
    println postgres.Exec(d, "SELECT * FROM pglive_missing")
    println str.StartsWith(postgres.Error(d), "ERROR:")
    println postgres.QueryInt(d, "SELECT count(*) FROM generate_series(1, 20000)")
    tx := d.Begin()
    tx.Exec("INSERT INTO pglive_items (name) VALUES ('rolled back')")
    tx.Rollback()
    println postgres.QueryInt(d, "SELECT count(*) FROM pglive_items")
    println postgres.Exec(d, "DROP TABLE pglive_items")
    postgres.Close(d)
end
