import db
import db.sqlite
import "_linkmock.salam"

func main:
    mut p := db.NewPool(3)
    mut i := 0
    until i < 4:
        println db.Add(p, sqlite.Conn(sqlite.Open(":memory:")))
        i = i + 1
    end
    println db.Size(p), db.Idle(p), db.InUse(p)

    a := db.Acquire(p)
    b := db.Acquire(p)
    c := db.Acquire(p)
    none := db.Acquire(p)
    println db.Leased(a), db.Leased(none)
    println db.Idle(p), db.InUse(p)

    conn := db.Conn(p, a)
    println conn.Exec("CREATE TABLE t (id INTEGER)")
    println conn.Kind()

    db.Release(p, a)
    println db.Idle(p)
    again := db.Acquire(p)
    println again == a

    db.Release(p, again)
    db.Release(p, b)
    db.Release(p, c)
    println db.Idle(p), db.InUse(p)
    println db.DropDead(p)

    db.Free(p)
    println db.Size(p)
end
