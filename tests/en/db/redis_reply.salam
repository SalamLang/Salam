import db.redis

func main:
    c := redis.Connect("127.0.0.1", 6379)
    println redis.Select(c, 14)
    redis.Del(c, "salam:test:ex")
    redis.Del(c, "salam:test:members")

    println redis.SetEx(c, "salam:test:ex", "temp", 100)
    println redis.Get(c, "salam:test:ex")
    ttl := redis.TTL(c, "salam:test:ex")
    println ttl > 0 and ttl <= 100

    redis.SAdd(c, "salam:test:members", "b")
    redis.SAdd(c, "salam:test:members", "a")
    members := redis.SMembers(c, "salam:test:members")
    println members.len(), members.get(0) + members.get(1) == "ab" or members.get(0) + members.get(1) == "ba"

    mut args := Vector {} as Vector<str>
    args.push("LRANGE")
    args.push("salam:test:members")
    args.push("0")
    args.push("-1")
    wrong := redis.Command(c, args)
    println redis.ReplyOk(wrong), redis.ReplyIsError(wrong), redis.ReplyIsNil(wrong), redis.ReplyType(wrong)
    redis.FreeReply(wrong)

    mut get := Vector {} as Vector<str>
    get.push("GET")
    get.push("salam:test:none")
    missing := redis.Command(c, get)
    println redis.ReplyOk(missing), redis.ReplyIsNil(missing), redis.ReplyType(missing)
    redis.FreeReply(missing)

    mut all := Vector {} as Vector<str>
    all.push("SMEMBERS")
    all.push("salam:test:members")
    reply := redis.Command(c, all)
    println redis.ReplyOk(reply), redis.ReplyIsError(reply), redis.ReplyType(reply), redis.ReplyArrayLen(reply)
    first := redis.ReplyArrayGet(reply, 0)
    println redis.ReplyType(first), redis.ReplyStr(first) == "a" or redis.ReplyStr(first) == "b"
    redis.FreeReply(reply)

    redis.Del(c, "salam:test:ex")
    redis.Del(c, "salam:test:members")
    println redis.FlushDB(c)
    println redis.Get(c, "salam:test:ex").len()
    redis.Close(c)
end
