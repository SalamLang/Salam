// One function, two engines: the point of db.Connection.

import db
import db.sqlite
import db.postgres
import "_linkmock.salam"

func exercise(c: dyn db.Connection):
    println c.Kind(), c.Ok(), c.Ping()
    println c.Exec("CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, w REAL)")
    println c.Exec("INSERT INTO t (id, name, w) VALUES (1, 'ada', 1.5)")
    println c.Exec("INSERT INTO t (id, name, w) VALUES (2, 'grace', NULL)")
    r := c.Query("SELECT id, name, w FROM t ORDER BY id")
    println r.Ok(), r.ColumnCount(), r.ColumnName(1)
    until r.Next():
        println r.Int(0), r.Text(1), r.IsNull(2), r.ColumnType(0)
    end
    println r.Close()
    println db.QueryInt(c, "SELECT COUNT(*) FROM t")
    println db.QueryText(c, "SELECT name FROM t ORDER BY id")
    println db.CountRows(c, "SELECT id FROM t")
    println db.Run(c, "DELETE FROM t WHERE id = 2")
    println db.QueryInt(c, "SELECT COUNT(*) FROM t")
    println c.Quote("O'Brien")
end

func main:
    d := sqlite.Open(":memory:")
    exercise(sqlite.Conn(d))
    sqlite.Close(d)
    p := postgres.Open("host=127.0.0.1 dbname=test")
    exercise(postgres.Conn(p))
    postgres.Close(p)
end
