import os
import db.typesense

func main:
    parts := os.Env("SALAM_TEST_TYPESENSE").split(" ")
    mut c := typesense.New(parts.get(0), parts.get(1))
    defer typesense.Free(c)
    mut err := typesense.Error {}
    println "snapshot:", typesense.CreateSnapshot(c, "/tmp/salam-ex-snapshot", err), typesense.ErrorString(err)
    println "cache cleared:", typesense.ClearCache(c, err)
    println "compacted:", typesense.CompactDB(c, err)
    println "schema changes running:", typesense.SchemaChanges(c, err).len()
    println "slow request log:", typesense.SetSlowRequestLog(c, 2000, err)
    println "config:", typesense.UpdateConfig(c, `{"log-slow-requests-time-ms": -1}`, err)
    println "status:", typesense.Status(c, err).state
end
