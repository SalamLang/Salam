import os
import db.typesense

func main:
    parts := os.Env("SALAM_TEST_TYPESENSE").split(" ")
    mut c := typesense.New(parts.get(0), parts.get(1))
    defer typesense.Free(c)
    mut err := typesense.Error {}
    _ := typesense.DeleteCollection(c, "ex_geo_cafes", err)
    mut s := typesense.Schema { name = "ex_geo_cafes" }
    s.fields.push(typesense.NewField("name", typesense.TYPE_STRING))
    s.fields.push(typesense.NewField("location", typesense.TYPE_GEOPOINT))
    _ := typesense.CreateCollection(c, s, err)
    mut docs := Vector {} as Vector<str>
    docs.push(`{"id": "1", "name": "Cafe Naderi", "location": [35.7019, 51.4223]}`)
    docs.push(`{"id": "2", "name": "Lalezar Tea House", "location": [35.6990, 51.4180]}`)
    docs.push(`{"id": "3", "name": "Tajrish Coffee", "location": [35.8040, 51.4330]}`)
    docs.push(`{"id": "4", "name": "Isfahan Roastery", "location": [32.6546, 51.6680]}`)
    _ := typesense.ImportDocuments(c, "ex_geo_cafes", docs, typesense.WriteOptions {}, err)

    mut near := typesense.NewSearch("*", "")
    near.filter_by = "location:(35.7000, 51.4200, 2 km)"
    near.sort_by = "location(35.7000, 51.4200):asc"
    r := typesense.Search(c, "ex_geo_cafes", near, err)
    println "within 2 km of the square:", r.found
    each h in r.hits:
        println "  ", h.document, h.geo_distance_meters
    end

    mut city := typesense.NewSearch("*", "")
    city.filter_by = "location:(35.7000, 51.4200, 20 km)"
    println "within 20 km:", typesense.Search(c, "ex_geo_cafes", city, err).found

    mut box := typesense.NewSearch("*", "")
    box.filter_by = "location:(33.0, 51.0, 33.0, 52.5, 32.0, 52.5, 32.0, 51.0)"
    println "inside the Isfahan box:", typesense.Search(c, "ex_geo_cafes", box, err).hits.get(0).document
    _ := typesense.DeleteCollection(c, "ex_geo_cafes", err)
end
