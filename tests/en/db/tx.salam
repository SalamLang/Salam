// Commit keeps the work, rollback discards it, and db.InTx does both.

import db
import db.sqlite
import db.postgres
import "_linkmock.salam"

func exercise(c: dyn db.Connection):
    c.Exec("CREATE TABLE t (id INTEGER PRIMARY KEY)")

    t := c.Begin()
    println t.Ok()
    println t.Exec("INSERT INTO t (id) VALUES (1)")
    println t.Commit()
    println db.QueryInt(c, "SELECT COUNT(*) FROM t")

    u := c.Begin()
    println u.Exec("INSERT INTO t (id) VALUES (2)")
    r := u.Query("SELECT COUNT(*) FROM t")
    if r.Next():
        println r.Int(0)
    end
    println r.Close()
    println u.Rollback()
    println db.QueryInt(c, "SELECT COUNT(*) FROM t")

    good := Vector {} as Vector<str> defer good.free()
    good.push("INSERT INTO t (id) VALUES (3)")
    good.push("INSERT INTO t (id) VALUES (4)")
    println db.InTx(c, good)
    println db.QueryInt(c, "SELECT COUNT(*) FROM t")

    bad := Vector {} as Vector<str> defer bad.free()
    bad.push("INSERT INTO t (id) VALUES (5)")
    bad.push("INSERT INTO nope (id) VALUES (6)")
    println db.InTx(c, bad)
    println db.QueryInt(c, "SELECT COUNT(*) FROM t")
end

func main:
    d := sqlite.Open(":memory:")
    exercise(sqlite.Conn(d))
    sqlite.Close(d)
    p := postgres.Open("host=127.0.0.1 dbname=test")
    exercise(postgres.Conn(p))
    postgres.Close(p)
end
