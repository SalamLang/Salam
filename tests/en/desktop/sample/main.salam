import desktop
import os

func main:
    args := os.Args()
    auto := args.len() > 1 and args[1] == "--self-test"
    mut code := 1
    desktop.Init(desktop.Config { id = "ir.salamlang.sample", name = "Salam Sample", version = "1.2.3" })
    desktop.Command("start", (c: desktop.Call): c.ResolveBool(auto) end)
    desktop.Command(
        "greet", (c: desktop.Call): c.ResolveStr("سلام " + c.Str("name")) end
    )
    desktop.Command(
        "finish", (c: desktop.Call): println c.Str("text")
        c.ResolveNull()
        desktop.Quit() end
    )
    w := desktop.Open(desktop.WindowOptions { title = "Salam Sample", width = 720, height = 480, min_width = 400, min_height = 300 })
    if w.IsClosed():
        println "could not open a window: " + desktop.LastError()
        ret code
    end
    desktop.Run()
    code = 0
    ret code
end
