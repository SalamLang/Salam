import gui.webview
import os

func main:
    args := os.Args()
    auto := args.Len() > 1 and args[1] == "--self-test"
    mut code := 1
    webview.Init(webview.Config { id = "ir.salamlang.sample", name = "Salam Sample", version = "1.2.3" })
    webview.Command("start", (c: webview.Call): c.ResolveBool(auto) end)
    webview.Command(
        "greet", (c: webview.Call): c.ResolveStr("سلام " + c.Str("name")) end
    )
    webview.Command(
        "finish", (c: webview.Call): println c.Str("text")
        c.ResolveNull()
        webview.Quit() end
    )
    w := webview.Open(webview.WindowOptions { title = "Salam Sample", width = 720, height = 480, min_width = 400, min_height = 300 })
    if w.IsClosed():
        println "could not open a window: " + webview.LastError()
        ret code
    end
    webview.Run()
    code = 0
    ret code
end
