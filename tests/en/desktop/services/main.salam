import gui.desktop
import filepath
import io
import os
import os.process
import sync

func str_code(n: int): str:
    ret n == 0 ? "0" : "nonzero"
end

func check(name: str, ok: bool):
    println (ok ? "ok   " : "FAIL ") + name
end

func main:
    desktop.Init(desktop.Config { id = "ir.salamlang.services", name = "Salam Services" })
    desktop.SecretDelete("k")
    check("secret empty", desktop.SecretGet("k") == "")
    check("secret set", desktop.SecretSet("k", "سلام-secret"))
    check("secret get", desktop.SecretGet("k") == "سلام-secret")
    check("secret update", desktop.SecretSet("k", "two"))
    check("secret get2", desktop.SecretGet("k") == "two")
    desktop.SecretDelete("k")
    check("secret gone", desktop.SecretGet("k") == "")
    dir := os.TempDir()
    out := filepath.Join(dir, "salam-services-out.txt")
    shell_name := SALAM_OS_WINDOWS ? "cmd.exe" : "sh"
    flag := SALAM_OS_WINDOWS ? "/C" : "-c"
    mut args := Vector {} as Vector<str>
    args.push(flag)
    args.push("echo hello")
    mut p := process.Spawn(process.SpawnOptions { path = shell_name, args = args, cwd = dir, output = out })
    check("spawn", p.pid > 0)
    mut waited := 0
    until waited < 500 and not process.TryWait(p):
        sync.SleepMs(10)
        waited += 1
    end
    text := io.ReadFile(out)
    check("spawn exit " + str_code(p.exit_code), p.exit_code == 0)
    check("spawn output", text.includes("hello"))
    mut slow := Vector {} as Vector<str>
    slow.push(flag)
    slow.push(SALAM_OS_WINDOWS ? "ping -n 30 127.0.0.1" : "sleep 30")
    mut q := process.Spawn(process.SpawnOptions { path = shell_name, args = slow, output = out + "2" })
    sync.SleepMs(300)
    check("still running", not process.TryWait(q))
    process.KillTree(q)
    waited = 0
    until waited < 500 and not process.TryWait(q):
        sync.SleepMs(10)
        waited += 1
    end
    check("killed", waited < 500)
    first := desktop.SingleInstance((a: Vector<str>): println "second", a.len() end)
    check("primary", first)
    mut items := Vector {} as Vector<desktop.MenuItem>
    items.push(desktop.Item("one", "یک"))
    items.push(desktop.Separator())
    w := desktop.Open(desktop.WindowOptions { title = "سلام", width = 400, height = 300 })
    check("window", not w.IsClosed())
    mut bar := Vector {} as Vector<desktop.MenuItem>
    bar.push(desktop.Submenu("File", items))
    desktop.SetMenu(w, bar)
    desktop.OnMenu((id: str): println "menu", id end)
    println "tray", desktop.SetTray("", "tip", items)
    println "notify", desktop.Notify("عنوان", "body", "alert")
    desktop.RequestAttention(w)
    desktop.RemoveTray()
    println "url", w.URL()
    w.Close()
    println "done", w.IsClosed()
end
