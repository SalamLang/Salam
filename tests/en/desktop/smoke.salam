import gui.webview
import filepath
import io
import os
import str
import sync

const PAGE := `<!doctype html><html dir="rtl"><meta charset="utf-8"><title>smoke</title>
<link rel="stylesheet" href="style.css">
<body><h1>سلام</h1><iframe src="frame.html"></iframe>
<script src="sub/app.js"></script>`

const STYLE := `body { color: rgb(1, 2, 3) }`

const FRAME := `<!doctype html><script>parent.postMessage(typeof window.salam, "*")</script>`

const APP := `(async function () {
  var report = function (name, value) { return salam.invoke("report", { name: name, value: String(value) }); };
  var frame = new Promise(function (done) { window.addEventListener("message", function (e) { done(e.data); }); });
  try {
    await report("invoke", await salam.invoke("add", { a: 40, b: 2 }));
    await report("worker", await salam.invoke("worker", {}));
    await report("unicode", await salam.invoke("echo", { text: "سلام \"دنیا\"\n" }));
    await report("unknown", await salam.invoke("missing").catch(function (e) { return e.message; }));
    await report("origin", location.origin === salam_expected_origin());
    await report("css", getComputedStyle(document.body).color);
    await report("mime", (await fetch("sub/app.js")).headers.get("content-type"));
    await report("header", (await fetch("style.css")).headers.get("x-content-type-options"));
    await report("notfound", (await fetch("missing.txt")).status);
    await report("escape", (await fetch("../../etc/hosts")).status);
    await report("storage", (localStorage.setItem("k", "v"), localStorage.getItem("k")));
    await report("frame", await frame);
    var heard = new Promise(function (done) { var off = salam.listen("tick", function (d) { off(); done(d.n); }); });
    salam.emit("ping", { n: 7 });
    await report("event", await heard);
    await report("frozen", (function () { try { window.salam = 1; } catch (e) {} return typeof window.salam; })());
    var channel = (window.webkit && window.webkit.messageHandlers.salam) || (window.chrome && window.chrome.webview);
    channel.postMessage({ not: "a string" });
    channel.postMessage(5);
    await report("flag", String(await salam.invoke("flag", {})));
    location.href = "https://blocked.example/";
    await new Promise(function (done) { setTimeout(done, 400); });
    await report("stayed", location.origin === salam_expected_origin());
    salam.emit("finish", {});
  } catch (e) {
    await report("exception", e && e.message);
    salam.emit("finish", {});
  }
})();`

mut g_failed := 0
mut g_passed := 0
mut g_win := webview.Window {}

func expect(name: str, got: str, want: str):
    if got == want:
        g_passed++
        println "ok   " + name
    else:
        g_failed++
        println "FAIL " + name + ": got [" + got + "] want [" + want + "]"
    end
end

func watchdog():
    sync.SleepMs(140000)
    println "FAIL timed out: " + webview.LastError()
    os.Exit(2)
end

func write_tree(root: str):
    _a := os.MkdirAll(filepath.Join(root, "sub"))
    _b := io.WriteFile(filepath.Join(root, "index.html"), PAGE)
    _c := io.WriteFile(filepath.Join(root, "style.css"), STYLE)
    _d := io.WriteFile(filepath.Join(root, "frame.html"), FRAME)
    _e := io.WriteFile(filepath.Join(root, "sub/app.js"), APP)
end

func report(c: webview.Call):
    name := c.Str("name")
    value := c.Str("value")
    if name == "invoke":
        expect(name, value, "42")
    else name == "worker":
        expect(name, value, "from a worker")
    else name == "unicode":
        expect(name, value, "سلام \"دنیا\"\n")
    else name == "unknown":
        expect(name, value, "unknown command: missing")
    else name == "origin" or name == "stayed":
        expect(name, value, "true")
    else name == "css":
        expect(name, value, "rgb(1, 2, 3)")
    else name == "mime":
        expect(name, value, "application/javascript")
    else name == "header":
        expect(name, value, "nosniff")
    else name == "notfound":
        expect(name, value, "404")
    else name == "escape":
        expect(name, value == "404" or value == "403" ? "refused" : value, "refused")
    else name == "storage":
        expect(name, value, "v")
    else name == "frame":
        expect(name, value, "undefined")
    else name == "event":
        expect(name, value, "7")
    else name == "frozen":
        expect(name, value, "object")
    else name == "flag":
        expect(name, value, "false")
    else:
        expect(name, value, "?")
    end
    c.ResolveNull()
end

func main:
    _dog := spawn(watchdog)
    root := filepath.Join(os.TempDir(), "salam-desktop-smoke")
    write_tree(root)
    pack := filepath.Join(os.TempDir(), "salam-desktop-smoke.pack")
    expect("pack", str.FromInt(webview.PackDir(root, pack, "ir.salamlang.smoke") as i64), "4")
    _gone := os.RemoveAll(root)
    webview.Init(webview.Config { id = "ir.salamlang.smoke", name = "Smoke", pack_path = pack, external_links = false })
    webview.Command("add", (c: webview.Call): c.ResolveInt((c.Int("a") + c.Int("b")) as i64) end)
    webview.CommandAsync("worker", (c: webview.Call): c.ResolveStr("from a worker") end)
    webview.Command("flag", (c: webview.Call): c.ResolveBool(c.Bool("missing")) end)
    webview.Command("echo", (c: webview.Call): c.ResolveStr(c.Str("text")) end)
    webview.Command("report", (c: webview.Call): report(c) end)
    webview.On("ping", (data: str): webview.Emit("tick", data) end)
    webview.On("finish", (_data: str): webview.Quit() end)
    mut scripts := Vector {} as Vector<str>
    origin := webview.AssetURL("")
    scripts.push("window.salam_expected_origin = function () { return \"" + origin + "\"; };")
    g_win = webview.Open(webview.WindowOptions { title = "سلام smoke", width = 640, height = 480, scripts = scripts })
    if g_win.IsClosed():
        println "FAIL no window: " + webview.LastError()
        ret 1
    end
    webview.Run()
    secret := "شناسه-" + origin
    expect("secret set", webview.SecretSet("smoke", secret) ? "yes" : "no", "yes")
    expect("secret get", webview.SecretGet("smoke"), secret)
    webview.SecretDelete("smoke")
    expect("secret gone", webview.SecretGet("smoke"), "")
    g_win.Close()
    println "passed " + str.FromInt(g_passed as i64) + " failed " + str.FromInt(g_failed as i64)
    ret g_failed == 0 ? 0 : 1
end
