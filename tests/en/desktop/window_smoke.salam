import gui.window
import mem
import time

func waker():
    time.Sleep(150)
    window.Wake()
end

func next_of(kind: window.EventKind): window.Event:
    repeat 400:
        e := window.Wait(50)
        if e.kind == kind:
            ret e
        end
    end
    ret window.Event {}
end

func main(): int:
    w := window.Open(window.Options { title = "Salam window smoke", width = 320.0, height = 200.0 })
    if not w.IsOpen():
        println "could not open a window:", window.LastError()
        ret 1
    end
    println "scale factor known:", w.ScaleFactor() > 0.0
    first := next_of(window.EventKind.RedrawRequested)
    if first.kind != window.EventKind.RedrawRequested:
        println "no redraw request arrived"
        ret 1
    end
    size := w.Size()
    pw := size.physical_width
    ph := size.physical_height
    pixels := mem.AllocateZeroed(((pw * ph) * 4) as u64) as u32*
    defer mem.Free(pixels as void*)
    repeat pw * ph in i:
        pixels[i] = 0xFF2060A0 as u32
    end
    if not w.PresentAll(pixels as void*, pw, ph, pw * 4):
        println "present failed"
        ret 1
    end
    repeat 10:
        _e := window.Wait(20)
    end
    shown := w.ShownPixel(pw / 2, ph / 2)
    println "frame shown:", shown == (0xFF2060A0 as u32)
    if shown != (0xFF2060A0 as u32):
        println "the window shows", shown
        ret 1
    end
    w.SetCursor(window.Cursor.Pointer)
    w.SetImeRect(10.0, 10.0, 2.0, 18.0)
    w.SetTitle("Salam window smoke, retitled")
    timer := window.SetTimer(200, false)
    thread := spawn(waker)
    mut woke := false
    mut fired := false
    repeat 200:
        e := window.Wait(100)
        if e.kind == window.EventKind.Wake:
            woke = true
        else e.kind == window.EventKind.Timer and e.timer == timer:
            fired = true
        end
        if woke and fired:
            break
        end
    end
    join(thread)
    println "woken from another thread:", woke
    println "timer fired:", fired
    w.Close()
    println "closed:", not w.IsOpen()
    if not woke or not fired:
        ret 1
    end
    println "window smoke: ok"
end
