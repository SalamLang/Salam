//! mode: app | title: FizzBuzz
func main:
    repeat 1 to 15 with i:
        if i % 15 == 0: println "FizzBuzz"
        else i % 3 == 0: println "Fizz"
        else i % 5 == 0: println "Buzz"
        else:
            println i
        end
    end
end
