//! mode: app | title: Fibonacci
func fib(n: int): int:
    if n < 2: ret n end
    ret fib(n - 1) + fib(n - 2)
end

func main:
    mut line := ""
    repeat 12 with i: line = line + fib(i) + " " end
    println "Fibonacci:", line
end
