//! mode: app | title: GCD
func gcd(a: int, b: int): int:
    mut x := a
    mut y := b
    until y != 0:
        t := y
        y = x % y
        x = t
    end
    ret x
end

func main:
    println "gcd(48, 36) =", gcd(48, 36)
    println "gcd(17, 5) =", gcd(17, 5)
end
