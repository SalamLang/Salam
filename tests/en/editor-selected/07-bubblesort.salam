func main:
    mut a := [5, 2, 8, 1, 9, 3]
    repeat 6 in i:
        repeat 5 - i in j:
            if a[j] > a[j + 1]:
                t := a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            end
        end
    end
    mut line := ""
    repeat 6 in k: line = line + a[k] + " " end
    println "Sorted:", line
end
