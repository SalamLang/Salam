//! mode: app | title: Reverse string
func main:
    s := "Salam"
    mut r := ""
    mut i := s.len() - 1
    until i >= 0:
        r = r.concat(s.substr(i, 1))
        i = i - 1
    end
    println "reverse of", s, "is", r
end
