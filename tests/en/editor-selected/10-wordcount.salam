func main:
    text := "the cat the dog the bird"
    mut words := text.Split(" ")
    mut counts := HashMap {} as HashMap<str, int>
    repeat words.Len() in i:
        w := words.Get(i)
        if counts.Has(w):
            counts.Put(w, counts.Get(w) + 1)
        else:
            counts.Put(w, 1)
        end
    end
    mut it := counts.Iter()
    until it.HasNext():
        println it.Key(), "->", it.Value()
        it.Next()
    end
end
