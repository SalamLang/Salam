//! mode: app | title: Temperature
func main:
    println "Celsius -> Fahrenheit"
    repeat 0 to 40 by 10 with c:
        f := (c as f64) * 9.0 / 5.0 + 32.0
        println c, "C =", f, "F"
    end
end
