func main:
    mut n := 27
    mut steps := 0
    println "Collatz from", n
    until n != 1:
        if n % 2 == 0: n /= 2
        else:
            n = 3 * n + 1
        end
        steps++
    end
    println "reached 1 in", steps, "steps"
end
