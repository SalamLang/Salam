func digit_sum(n: int): int:
    mut x := n
    mut s := 0
    until x > 0:
        s += x % 10
        x /= 10
    end
    ret s
end

func main:
    println "digit sum of 12345 =", digit_sum(12345)
    println "digit sum of 99 =", digit_sum(99)
end
