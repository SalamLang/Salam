//! mode: app | title: Min & max
func main:
    a := [5, 9, 1, 7, 3, 8, 2] as int[7]
    mut lo := a[0]
    mut hi := a[0]
    repeat 1 to 7 - 1 with i:
        if a[i] < lo: lo = a[i] end
        if a[i] > hi: hi = a[i] end
    end
    println "min =", lo, "max =", hi
end
