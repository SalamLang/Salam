//! mode: app | title: Average
func main:
    a := [10, 20, 30, 40, 50, 60] as int[6]
    mut sum := 0
    repeat 6 with i: sum = sum + a[i] end
    avg := (sum as f64) / 6.0
    println "sum =", sum
    println "average =", avg
end
