func main:
    s := "salam donya"
    mut count := 0
    repeat s.Len() in i:
        c := s.Substr(i, 1)
        if c == "a" or c == "e" or c == "i" or c == "o" or c == "u":
            count++
        end
    end
    println "vowels in", s, "=", count
end
