//! mode: app | title: Count vowels
func main:
    s := "salam donya"
    mut count := 0
    repeat s.len() with i:
        c := s.substr(i, 1)
        if c == "a" || c == "e" || c == "i" || c == "o" || c == "u":
            count = count + 1
        end
    end
    println "vowels in", s, "=", count
end
