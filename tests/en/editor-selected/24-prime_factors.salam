//! mode: app | title: Prime factors
func main:
    n := 360
    mut x := n
    mut line := ""
    mut d := 2
    until d * d <= x:
        until x % d == 0:
            line = line + d + " "
            x = x / d
        end
        d = d + 1
    end
    if x > 1: line = line + x + " " end
    println n, "=", line
end
