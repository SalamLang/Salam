func main:
    n := 360
    mut x := n
    mut line := ""
    mut d := 2
    until d * d <= x:
        until x % d == 0:
            line = line + d + " "
            x /= d
        end
        d++
    end
    if x > 1: line = line + x + " " end
    println n, "=", line
end
