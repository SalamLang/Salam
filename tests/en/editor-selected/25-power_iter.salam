//! mode: app | title: Integer power
func power(base: int, exp: int): int:
    mut result := 1
    repeat exp with i: result = result * base end
    ret result
end

func main:
    repeat 0 to 8 with e:
        println "2 ^", e, "=", power(2, e)
    end
end
