func main:
    mut s := Vector {} as Vector<int> s.Push(1)
    s.Push(2)
    s.Push(3)
    println "size =", s.Len()
    until s.Len() > 0:
        println "pop", s.Pop()
    end
    println "size =", s.Len()
end
