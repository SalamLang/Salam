//! mode: app | title: Weekdays (enum)
enum Day: Mon, Tue, Wed, Thu, Fri, Sat, Sun end

func is weekend(d: Day): bool: ret d == Day.Sat || d == Day.Sun end

func main:
    d := Day.Sat
    println "day index =", d as int
    if is weekend(d): println "it is the weekend"
    else:
        println "it is a weekday"
    end
end
