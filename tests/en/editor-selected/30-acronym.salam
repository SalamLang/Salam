//! mode: app | title: Acronym
func main:
    phrase := "salam azad multi platform"
    mut words := phrase.split(" ")
    mut acro := ""
    repeat words.len() with i:
        w := words.get(i)[0]
        acro = acro + w.substr(0, 1)
    end
    println phrase, "->", acro
end
