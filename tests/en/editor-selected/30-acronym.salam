func main:
    phrase := "salam azad multi platform"
    mut words := phrase.Split(" ")
    mut acro := ""
    repeat words.Len() in i:
        w := words.Get(i)
        acro += w.Substr(0, 1)
    end
    println phrase, "->", acro
end
