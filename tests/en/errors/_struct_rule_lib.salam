package rulelib

pub struct Conn:
    @en "user"
    @fa "کاربر"
    pub user: str = ""
    @en "pass"
    @fa "رمز"
    pub pass: str = ""
    @en "token"
    @fa "توکن"
    pub token: str = ""
    rule user needs pass
end
