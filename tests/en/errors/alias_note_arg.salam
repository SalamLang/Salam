// EXPECT: E012
// EXPECT-MSG: argument 1: cannot pass 'i32' to 'Age' ('Years' is an alias of 'Age')
struct Age:
    pub years: int = 0
end

type Years = Age

func show(a: Years): int:
    ret a.years
end

func main:
    println show(5)
end
