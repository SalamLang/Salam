// EXPECT: E021
// `==` binds tighter than `&`, so this parses as `flags & (8 == 8)` and
// the bitwise operator is handed a bool. The mask test has to be
// written `(flags & 8) == 8`.
func main:
    flags := 12
    println flags & 8 == 8
end
