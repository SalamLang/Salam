// EXPECT: E002
// EXPECT-MSG: 'Sq' does not implement interface 'Named': missing method 'name'
interface Shape:
    func area(): int
end

interface Named:
    func name(): str
end

struct Sq:
    pub s: int = 3
end

impl Shape on Sq:
    func area(): int: ret this.s * this.s end
end

func main:
    sq := Sq {}
    d := sq as dyn Named
    println d.name()
end
