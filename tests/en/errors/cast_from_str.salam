// EXPECT: E023
// EXPECT-MSG: cannot cast 'str' to 'i8'
// EXPECT-MSG: cannot cast 'str' to 'i16'
// EXPECT-MSG: cannot cast 'str' to 'i32'
// EXPECT-MSG: cannot cast 'str' to 'i64'
// EXPECT-MSG: cannot cast 'str' to 'u8'
// EXPECT-MSG: cannot cast 'str' to 'u16'
// EXPECT-MSG: cannot cast 'str' to 'u32'
// EXPECT-MSG: cannot cast 'str' to 'u64'
// EXPECT-MSG: cannot cast 'str' to 'f32'
// EXPECT-MSG: cannot cast 'str' to 'f64'
// EXPECT-MSG: cannot cast 'str' to 'bool'
// EXPECT-MSG: cannot cast 'str' to 'char'
// EXPECT-MSG: cannot cast 'str' to 'uchar'
// EXPECT-MSG: cannot cast 'str' to 'usize'
func main:
    v0 := "A"
    w0 := v0 as i8
    println w0
    v1 := "A"
    w1 := v1 as i16
    println w1
    v2 := "A"
    w2 := v2 as i32
    println w2
    v3 := "A"
    w3 := v3 as i64
    println w3
    v4 := "A"
    w4 := v4 as u8
    println w4
    v5 := "A"
    w5 := v5 as u16
    println w5
    v6 := "A"
    w6 := v6 as u32
    println w6
    v7 := "A"
    w7 := v7 as u64
    println w7
    v8 := "A"
    w8 := v8 as f32
    println w8
    v9 := "A"
    w9 := v9 as f64
    println w9
    v10 := "A"
    w10 := v10 as bool
    println w10
    v11 := "A"
    w11 := v11 as char
    println w11
    v12 := "A"
    w12 := v12 as uchar
    println w12
    v13 := "A"
    w13 := v13 as usize
    println w13
end
