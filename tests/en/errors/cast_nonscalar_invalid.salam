// EXPECT: E023
// EXPECT-MSG: cannot cast 'Box' to 'i32'
// EXPECT-MSG: cannot cast 'Box' to 'str'
// EXPECT-MSG: cannot cast 'Box' to 'void*'
// EXPECT-MSG: cannot cast 'Tag' to 'i32'
// EXPECT-MSG: cannot cast 'Shade' to 'str'
// EXPECT-MSG: cannot cast 'i32[2]' to 'i32'
enum Shade: Red = 1 end
enum Tag: First = "ay" end

struct Box:
    x: i32 = 0
end

func main:
    b := Box {}
    w0 := b as i32
    w1 := b as str
    w2 := b as void*
    w3 := Tag.First as i32
    w4 := Shade.Red as str
    arr := [1, 2]
    w5 := arr as i32
    println w0, w1, w3, w4, w5
    println w2 as u64
end
