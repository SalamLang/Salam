// EXPECT: E023
// EXPECT-MSG: cannot cast 'i8' to 'str'
// EXPECT-MSG: cannot cast 'i16' to 'str'
// EXPECT-MSG: cannot cast 'i32' to 'str'
// EXPECT-MSG: cannot cast 'i64' to 'str'
// EXPECT-MSG: cannot cast 'u8' to 'str'
// EXPECT-MSG: cannot cast 'u16' to 'str'
// EXPECT-MSG: cannot cast 'u32' to 'str'
// EXPECT-MSG: cannot cast 'u64' to 'str'
// EXPECT-MSG: cannot cast 'f32' to 'str'
// EXPECT-MSG: cannot cast 'f64' to 'str'
// EXPECT-MSG: cannot cast 'bool' to 'str'
// EXPECT-MSG: cannot cast 'char' to 'str'
// EXPECT-MSG: cannot cast 'usize' to 'str'
func main:
    v0 := 65 as i8
    w0 := v0 as str
    println w0
    v1 := 65 as i16
    w1 := v1 as str
    println w1
    v2 := 65
    w2 := v2 as str
    println w2
    v3 := 65 as i64
    w3 := v3 as str
    println w3
    v4 := 65 as u8
    w4 := v4 as str
    println w4
    v5 := 65 as u16
    w5 := v5 as str
    println w5
    v6 := 65 as u32
    w6 := v6 as str
    println w6
    v7 := 65 as u64
    w7 := v7 as str
    println w7
    v8 := 65.0 as f32
    w8 := v8 as str
    println w8
    v9 := 65.0
    w9 := v9 as str
    println w9
    v10 := true
    w10 := v10 as str
    println w10
    v11 := 'A'
    w11 := v11 as str
    println w11
    v12 := 65 as usize
    w12 := v12 as str
    println w12
end
