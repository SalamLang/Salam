// EXPECT: E023
// EXPECT-MSG: cannot cast 'f32' to 'uchar'
// EXPECT-MSG: cannot cast 'f64' to 'uchar'
// EXPECT-MSG: cannot cast 'bool' to 'uchar'
// EXPECT-MSG: cannot cast 'char' to 'uchar'
// EXPECT-MSG: cannot cast 'uchar' to 'f32'
// EXPECT-MSG: cannot cast 'uchar' to 'f64'
// EXPECT-MSG: cannot cast 'uchar' to 'bool'
// EXPECT-MSG: cannot cast 'uchar' to 'char'
func main:
    v0 := 65.0 as f32
    w0 := v0 as uchar
    println w0
    v1 := 65.0
    w1 := v1 as uchar
    println w1
    v2 := true
    w2 := v2 as uchar
    println w2
    v3 := 'A'
    w3 := v3 as uchar
    println w3
    v4 := u'A'
    w4 := v4 as f32
    println w4
    v5 := u'A'
    w5 := v5 as f64
    println w5
    v6 := u'A'
    w6 := v6 as bool
    println w6
    v7 := u'A'
    w7 := v7 as char
    println w7
end
