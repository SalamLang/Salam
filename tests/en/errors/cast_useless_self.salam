// EXPECT: E093
// EXPECT-MSG: useless cast: this expression already has type 'i8'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'i16'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'i32'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'i64'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'u8'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'u16'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'u32'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'u64'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'f32'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'f64'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'bool'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'char'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'uchar'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'str'; remove the cast
// EXPECT-MSG: useless cast: this expression already has type 'usize'; remove the cast
func main:
    v0 := 65 as i8
    w0 := v0 as i8
    println w0
    v1 := 65 as i16
    w1 := v1 as i16
    println w1
    v2 := 65
    w2 := v2 as i32
    println w2
    v3 := 65 as i64
    w3 := v3 as i64
    println w3
    v4 := 65 as u8
    w4 := v4 as u8
    println w4
    v5 := 65 as u16
    w5 := v5 as u16
    println w5
    v6 := 65 as u32
    w6 := v6 as u32
    println w6
    v7 := 65 as u64
    w7 := v7 as u64
    println w7
    v8 := 65.0 as f32
    w8 := v8 as f32
    println w8
    v9 := 65.0
    w9 := v9 as f64
    println w9
    v10 := true
    w10 := v10 as bool
    println w10
    v11 := 'A'
    w11 := v11 as char
    println w11
    v12 := u'A'
    w12 := v12 as uchar
    println w12
    v13 := "A"
    w13 := v13 as str
    println w13
    v14 := 65 as usize
    w14 := v14 as usize
    println w14
end
