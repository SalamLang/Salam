// EXPECT: E167
// EXPECT-MSG: constant 'ROOT' needs a value known at compile time, but its initializer calls a function
import math

const SIZE := sizeof(i64)
const ROOT := math.Sqrt(16.0)

func main:
    println ROOT, SIZE
end
