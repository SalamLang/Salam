// EXPECT: E167
// EXPECT-MSG: constant 'N' needs a value known at compile time, but its initializer calls a function
// EXPECT-NOT: constant 'K'
// EXPECT-NOT: constant 'M'
const P := Pair{a = 1, b = 2}
const N := P.len()
const K := "abc".len()
const A := [1, 2, 3]
const M := A.len()

struct Pair:
    pub a: int = 0
    pub b: int = 0
    pub func len(): int:
        ret this.a + this.b
    end
end

func main:
    println N, K, M
end
