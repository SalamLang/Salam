// EXPECT: error:
// EXPECT-MSG: a container is not created by calling it
// EXPECT-NOT: unknown identifier
// EXPECT-NOT: expected an expression
func main:
    v := Vector<int>()
    v.push(2)
    m := HashMap<str, int>()
    m.put("a", 1)
    println v.len(), m.size()
end
