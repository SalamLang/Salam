// EXPECT: E021
// EXPECT-MSG: none of its versions accepts
type Meters: int
    func + (o: Meters): Meters:
        ret ((this as int) + (o as int)) as Meters
    end
end

func main:
    a := 5 as Meters
    x := 3
    println (a + x) as int
end
