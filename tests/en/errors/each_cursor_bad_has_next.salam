// EXPECT: E065
// EXPECT-MSG: it needs 'len()' and 'get(i: int)'
struct BadIter:
    pub pos: int = 0
    pub func has_next(): int: ret this.pos end
    pub func value(): int: ret this.pos end
    pub func next(): this.pos = this.pos + 1 end
end

struct Holder:
    pub z: int = 0
    pub func iter(): BadIter: ret BadIter { pos = this.z } end
end

func main:
    h := Holder { z = 0 }
    each x in h:
        println x
    end
end
