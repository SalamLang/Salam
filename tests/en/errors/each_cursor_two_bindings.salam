// EXPECT: E065
// EXPECT-MSG: iterates one value per step, so 'each' over it takes one binding
struct VIter:
    pub cur: int = 0
    pub func has_next(): bool: ret this.cur < 3 end
    pub func value(): int: ret this.cur end
    pub func next(): this.cur = this.cur + 1 end
end

struct Vals:
    pub z: int = 0
    pub func iter(): VIter: ret VIter { cur = this.z } end
end

func main:
    v := Vals { z = 0 }
    each k, x in v:
        println k, x
    end
end
