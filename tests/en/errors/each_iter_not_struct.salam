// EXPECT-MSG: it needs 'len()' and 'get(i: int)'
struct Odd:
    pub n: int = 0
    pub func iter(): int: ret this.n end
end

func main:
    o := Odd { n = 2 }
    each x in o:
        println x
    end
end
