// EXPECT: E065
// EXPECT-MSG: it needs 'len()' and 'get(i: int)'
struct Plain:
    pub n: int = 0
    pub func Double(): int: ret this.n * 2 end
end

func main:
    p := Plain { n = 2 }
    each x in p:
        println x
    end
end
