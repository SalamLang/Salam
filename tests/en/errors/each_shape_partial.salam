// EXPECT: E065
// EXPECT-MSG: it needs 'len()' and 'get(i: int)'
struct Half:
    pub n: int = 0
    pub func len(): int: ret this.n end
end

func main:
    h := Half { n = 2 }
    each x in h:
        println x
    end
end
