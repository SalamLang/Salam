// EXPECT: E001
// EXPECT-MSG: identifier 'جایگاه' must be English in an English file
// EXPECT-MSG: the English name is 'offset'
import encoding.json

func main:
    try:
        _ := json.Decode("[1, 2")
    catch e:
        println e.kind_name(), e.جایگاه
    end
end
