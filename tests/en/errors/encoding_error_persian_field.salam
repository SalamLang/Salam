// EXPECT: E001
// EXPECT-MSG: identifier 'موقعیت' must be English in an English file
// EXPECT-MSG: the English name is 'position'
import encoding.json
import encoding.encerr

func main:
    mut e := encerr.NoError()
    _ := json.Decode("[1, 2", e)
    println encerr.IsError(e), e.موقعیت
end
