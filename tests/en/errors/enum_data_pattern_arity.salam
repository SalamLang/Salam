// EXPECT: E076
enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

func main:
    s := Shape.Empty
    match s:
        Rect(w):
            println 1
        end
        else:
            println 0
        end
    end
end
