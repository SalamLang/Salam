// EXPECT: E080
// EXPECT-MSG: non-exhaustive match on enum 'Day': missing member Wed
enum Day: Mon, Tue, Wed end

func main:
    d := Day.Mon
    match d:
        Mon: println "m" end
        Tue: println "t" end
    end
end
