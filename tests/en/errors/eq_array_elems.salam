// EXPECT: E021
// EXPECT-MSG: arrays of type 'Vector<i32>[1]' cannot be compared with '==' because their elements cannot be
func main:
    mut v := Vector {} as Vector<int>
    defer v.free()
    a := [v]
    println a == a
end
