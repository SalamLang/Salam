// EXPECT: E021
// EXPECT-MSG: 'HashMap<str, i32>' cannot be compared with '=='
interface Sh:
    func area(): int
end
struct P:
    pub x: int = 0
    pub func area(): int: ret this.x end
end
func main:
    m := HashMap {} as HashMap<str, int>
    m2 := HashMap {} as HashMap<str, int>
    println m == m2
end
