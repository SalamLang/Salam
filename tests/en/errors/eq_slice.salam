// EXPECT: E021
// EXPECT-MSG: slices of type 'i32[]' cannot be compared with '=='
interface Sh:
    func area(): int
end
struct P:
    pub x: int = 0
    pub func area(): int: ret this.x end
end
func main:
    arr := [1, 2]
    sl := arr[:]
    sl2 := arr[:]
    println sl == sl2
end
