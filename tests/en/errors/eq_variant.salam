// EXPECT: E021
interface Sh:
    func area(): int
end
struct P:
    pub x: int = 0
    pub func area(): int: ret this.x end
end
func main:
    va := 1 as (i32 or str)
    va2 := 2 as (i32 or str)
    println va == va2
end
