// EXPECT: E021
// EXPECT-MSG: 'Vector<i32>' cannot be compared with '=='; compare its elements in a loop
interface Sh:
    func area(): int
end
struct P:
    pub x: int = 0
    pub func area(): int: ret this.x end
end
func main:
    v := Vector {} as Vector<int>
    v2 := Vector {} as Vector<int>
    println v == v2
end
