// EXPECT: E109
// EXPECT-MSG: do not call os.Exit in main
import os

func Fail(message: str):
    printerrln message
    os.Exit(1)
end

func main:
    if os.Args().len() > 99: Fail("too many") end
    os.Exit(2)
end
