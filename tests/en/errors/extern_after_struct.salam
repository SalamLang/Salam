// EXPECT: E083
// EXPECT-MSG: the 'extern:' block that declares 'abs' must come with the imports, before any other top-level statement; move it above 'Point' (line 19)
// EXPECT-NOT: 'import' must appear
// EXPECT-NOT: 'labs'
struct Point:
    pub x: int = 0
end

extern:
    func abs(x: int): int
    func labs(x: i64): i64
end

func main:
    p := Point{x = -3}
    println abs(p.x), labs(-4 as i64)
end
