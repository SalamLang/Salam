// EXPECT: error:
// EXPECT-MSG: Salam spells 'elif' as 'else'
// EXPECT-NOT: unknown identifier
// EXPECT-NOT: top-level definition
// EXPECT-NOT: expected an expression
func grade(n: int): str:
    if n > 90:
        ret "A"
    elif n > 80:
        ret "B"
    else:
        ret "C"
    end
end

func main:
    println grade(85)
end
