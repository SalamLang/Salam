// EXPECT: error:
// EXPECT-MSG: Salam has no C-style 'for' loop
// EXPECT-NOT: 'for' uses ','
// EXPECT-MSG: repeat n in i:
func main:
    mut total := 0
    for i := 0; i < 3; i += 1:
        total += i
    end
    println total
end
