// EXPECT: E002
// EXPECT-MSG: 'Rock' does not implement interface 'Named': missing method 'Name'
// EXPECT-NOT: E017
interface Named:
    func Name(): str
end

struct Dog:
    pub n: str = "rex"
    pub func Name(): str:
        ret this.n
    end
end

struct Rock:
    pub w: int = 3
end

func Greet<T: Named>(x: T): str:
    ret "hi " + x.Name()
end

func main():
    println Greet(Dog {})
    println Greet(Rock {})
end
