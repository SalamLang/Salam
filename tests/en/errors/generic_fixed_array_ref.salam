import encoding.json

// EXPECT: E098
// EXPECT-NOT: E002
// EXPECT-NOT: E069
func main:
    mut out := [0, 0, 0]
    try:
        json.Unmarshal("[7,8,9]", out)
    catch e:
        println e.message
    end
    println out[0]
end
