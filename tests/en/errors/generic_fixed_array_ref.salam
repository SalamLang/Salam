import encoding.json
import encoding.encerr

// EXPECT: E098
// EXPECT-NOT: E002
// EXPECT-NOT: E069
func main:
    mut out := [0, 0, 0]
    mut err := encerr.EncodingError {}
    ok := json.Unmarshal("[7,8,9]", out, err)
    println ok, out[0]
end
