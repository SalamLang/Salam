// EXPECT: E001
// EXPECT-MSG: is not an interface
interface Shape:
    func Area(): f64
end

struct Thing:
    pub n: int = 0
end

struct Cube:
    pub s: f64 = 1.0
    pub func Area(): f64: ret this.s end
end

func show<T: Shape + Thing>(v: T):
    println v.Area()
end

func main:
    show(Cube { s = 2.0 })
end
