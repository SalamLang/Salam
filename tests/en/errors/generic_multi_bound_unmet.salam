// EXPECT: E002
// EXPECT-MSG: does not implement interface 'Named': missing method 'Name'
interface Shape:
    func Area(): f64
end

interface Named:
    func Name(): str
end

struct Blob:
    pub r: f64 = 1.0
    pub func Area(): f64: ret this.r end
end

func show<T: Shape + Named>(v: T):
    println v.Area()
end

func main:
    show(Blob { r = 2.0 })
end
