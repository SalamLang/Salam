// EXPECT: E002
// EXPECT-NOT: E017
interface Named:
    func Name(): str
end

struct Rock:
    pub w: int = 3
end

struct Box<T: Named>:
    pub v: T
    pub func Show(): str:
        ret "box " + this.v.Name()
    end
end

func main():
    b := Box { v = Rock {} } as Box<Rock>
    println b.Show()
end
