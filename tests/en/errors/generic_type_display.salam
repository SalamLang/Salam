// EXPECT: E002
// EXPECT-MSG: cannot assign 'Pair<str, i32>' to 'i32'
struct Pair<K, V>:
    pub a: K
    pub b: V
end

func main:
    p := Pair { a = "x", b = 1 } as Pair<str, int>
    mut n := 0
    n = p
    println n
end
