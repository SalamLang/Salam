// EXPECT: E002
// EXPECT-MSG: missing method 'Area'
interface Shape:
    func Area(): f64
end

interface Solid:
    use Shape
    func Volume(): f64
end

struct Cube:
    pub s: f64 = 1.0
    pub func Volume(): f64: ret this.s end
end

impl Solid on Cube:
end

func main:
    println Cube { s = 1.0 }.Volume()
end
