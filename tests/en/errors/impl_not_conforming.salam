// EXPECT: E002
// EXPECT-MSG: does not implement interface 'Shape': missing method 'Area'
interface Shape:
    func Area(): f64
end

struct Blob:
    pub r: f64 = 1.0
end

impl Shape on Blob:
end

func main:
    b := Blob { r = 2.0 }
    println b.r
end
