// EXPECT: E002
// EXPECT-MSG: signature that does not match interface 'Shape'
interface Shape:
    func Area(): f64
end

struct Square:
    pub s: f64 = 1.0
    pub func Area(): int: ret 1 end
end

impl Shape on Square:
end

func main:
    println Square { s = 2.0 }.Area()
end
