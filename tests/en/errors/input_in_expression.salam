// EXPECT: E296
// EXPECT-MSG: 'input' cannot be used inside another expression
// EXPECT-MSG: store the answer in a variable first, then use it:
// EXPECT-MSG: answer := input "Enter your name: "
// EXPECT-MSG: println answer
func greet(who: str): str:
    ret "Hi " + who
end

func ask(): str:
    ret input "ask: "
end

func main:
    println input "Enter your name: "
    println "Hi " + input "name"
    if input "x" == "y":
        println "same"
    end
    msg := greet(input "who: ")
    names := ["a", "b"]
    println names[input "i: "]
    n := 1
    n += input "n: "
end
