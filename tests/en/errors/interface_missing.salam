// EXPECT: E002
interface Shape:
    func area(): f64
    func name(): str
end

struct Point:
    pub x: f64 = 0.0
    pub func area(): f64: ret 0.0 end
end

func describe<T: Shape>(s: T): println s.area() end
func main:
    describe(Point { x = 1.0 })
end
