// EXPECT: E012

import encoding.json

struct Person:
    pub name: str = ""
    pub age: int = 0
end

func main:
    persons := Vector {} as Vector<Person>
    persons.push(Person { name = "Ali", age = 30 })
    println json.Encode(persons, json.JSONOptions {})
end
