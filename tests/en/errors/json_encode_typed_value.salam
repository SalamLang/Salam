// EXPECT: E012
// json.Encode is the dynamic-tree encoder: its parameter is a value.Value,
// the run-time tagged node json.Decode hands back. A Vector<Person> is a
// concrete compiled type and does not convert to one, so this is a plain
// argument type error rather than a gap in the encoder.
//
// The typed value wants json.Marshal, which derives a codec for exactly
// this T. Kept as a test because the two names are close enough that the
// diagnostic is what people read first.

import encoding.json

struct Person:
    pub name: str = ""
    pub age: int = 0
end

func main:
    persons := Vector {} as Vector<Person>
    persons.push(Person { name = "Ali", age = 30 })
    println json.Encode(persons, json.JSONOptions {})
end
