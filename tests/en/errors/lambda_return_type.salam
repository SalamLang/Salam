// EXPECT: error:
// EXPECT-MSG: a lambda cannot declare a return type
// EXPECT-NOT: reserved word
func apply(f: func (int) int, x: int): int:
    ret f(x)
end

func main:
    println apply((x: int): int: ret x + 1 end, 2)
end
