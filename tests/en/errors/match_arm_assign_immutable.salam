// EXPECT: E013
// EXPECT-MSG: cannot reassign immutable variable 'total'; declare it 'mut' to reassign it, or assign to its elements or fields instead
func main:
    total := 0
    x := 2
    match x:
        1 => total = 10
        else => total = 20
    end
    println total
end
