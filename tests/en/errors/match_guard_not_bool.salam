// EXPECT: E002
enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

func main:
    s := Shape.Circle(1.0)
    println match s:
        Circle(r) if r: 1 end
        else: 0 end
    end
end
