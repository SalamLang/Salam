// EXPECT: E079
enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

func main:
    s := Shape.Circle(1.0)
    println match s:
        Circle(r) if r > 1.0 => 1
        Rect(_, _) => 2
        Empty => 3
    end
end
