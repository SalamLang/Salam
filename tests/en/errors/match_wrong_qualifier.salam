// EXPECT: E016
// EXPECT-MSG: pattern 'Op.Add' names 'Op', but the match subject is a 'Color'
enum Color:
    Red, Green
end

enum Op:
    Add
end

func main:
    c := Color.Red
    x := match c:
        Op.Add: 1 end
        else: 2 end
    end
    println x
end
