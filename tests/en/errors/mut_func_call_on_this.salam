// EXPECT: E105
struct Counter:
    n: int = 0
    pub mut func Tick():
        this.n++
    end
    pub func Count(): int:
        this.Tick()
        ret this.n
    end
end

func main:
    mut c := Counter {}
    c.Tick()
    println c.Count()
end
