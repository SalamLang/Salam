// EXPECT: E002
interface Reader:
    func Tick()
end

struct Counter:
    n: int = 0
    pub mut func Tick():
        this.n += 1
    end
end

func use<R: Reader>(r &: R):
    r.Tick()
end

func main:
    mut c := Counter {}
    use(c)
end
