// EXPECT: E106
struct Counter:
    n: int = 0
    pub mut func Tick():
        this.n += 1
    end
    pub func Count(): int:
        ret this.n
    end
end

func tick(c: Counter):
    c.Tick()
end

func main:
    c := Counter {}
    tick(c)
    println c.Count()
end
