// `null` is a pointer value, never a stand-in for a missing int. The
// classic tree typo - testing the payload instead of the child link -
// is a type error, not a silent always-false comparison.

struct Node:
    pub key: int = 0
    pub left: Node* = null
    pub right: Node* = null
end

// EXPECT: E021
func main:
    n := Node { key = 1, left = null, right = null }
    println n.key == null
end
