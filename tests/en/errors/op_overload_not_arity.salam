// EXPECT: E012
// EXPECT-MSG: takes no parameters: it applies to 'this' alone
struct V:
    pub ok: bool = true
    pub func operator !(o: V): bool:
        ret o.ok
    end
end

func main:
    println (V {}).ok
end
