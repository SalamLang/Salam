// EXPECT: not
// EXPECT-MSG: only the built-in operators can be overloaded
struct V:
    pub x: int = 0
    pub func operator ***(o: V): V:
        ret V { x = this.x * o.x }
    end
end

func main:
    println (V {}).x
end
