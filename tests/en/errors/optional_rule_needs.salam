// EXPECT: E159
// EXPECT-MSG: struct literal 'Auth' sets 'user', which needs 'pass'
struct Auth:
    pub user: str?
    pub pass: str?
    rule user needs pass
end

func main:
    a := Auth { user = "u" }
    println a.user.present
end
