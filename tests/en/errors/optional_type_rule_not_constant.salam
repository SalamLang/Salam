// EXPECT: E159
// EXPECT-MSG: struct literal 'Conn' must set 'm' because 'n' may equal 5 (its value is not a constant)
struct Conn:
    pub n: int?
    pub m: int?
    rule n == 5 needs m
end

func pick(): int?:
    ret 5
end

func main:
    c := Conn { n = pick() }
    println c.m.is_none()
end
