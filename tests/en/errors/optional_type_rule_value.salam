// EXPECT: E159
// EXPECT-MSG: struct literal 'Conn' has 'n' equal to 5, which needs 'm'
struct Conn:
    pub n: int?
    pub m: int?
    rule n == 5 needs m
end

func main:
    c := Conn { n = 5 }
    println c.m.is_none()
end
