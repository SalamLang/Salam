// EXPECT: E259
struct Box:
    pub v: Vector<int> = Vector {}
end

func keep(store &: Vector<Box>, v: Vector<int>):
    store.Push(Box { v = v })
end

func main:
    mut store := Vector {} as Vector<Box>
    mut d := Vector {} as Vector<int>
    d.Push(4)
    keep(store, d)
    println d.Len(), store.Len()
end
