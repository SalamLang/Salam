// EXPECT: E140
// EXPECT-MSG: 's' is freed twice: its storage was already freed on line 23
import mem
import str

func main:
    s := "n=" + str.FromInt(3)
    println s
    mem.Free(s as void*)
    mem.Free(s as void*)
end
