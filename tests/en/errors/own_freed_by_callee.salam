// EXPECT: E139
// EXPECT-MSG: 'name' is used after its storage was freed on line 31
import mem
import str

func release(s: str):
    println "releasing " + s
    mem.Free(s as void*)
end

func forget(s: str):
    release(s)
end

func main:
    name := "user-" + str.FromInt(42 as i64)
    forget(name)
    println name
end
