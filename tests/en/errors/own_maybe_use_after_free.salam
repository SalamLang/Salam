// FLAGS: --ownership=warn --log-level=warn
// EXPECT: W142
import mem
import str

func show(c: bool, s: str):
    if c:
        mem.Free(s as void*)
    end
    println s
end

func main:
    show(false, "x" + str.FromInt(1 as i64))
end
