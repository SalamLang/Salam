// FLAGS: --ownership=warn --log-level=warn
// EXPECT: W163
// EXPECT-MSG: so take 'basket.Copy()' where both are needed
func keep(store &: Vector<Vector<int>>, v: Vector<int>):
    store.Push(v)
end

func main:
    mut store := Vector {} as Vector<Vector<int>>
    mut basket := Vector {} as Vector<int>
    basket.Push(4)
    keep(store, basket)
    println basket.Len(), store.Len()
end
