// FLAGS: --ownership=warn --log-level=warn
// EXPECT: W144
func main:
    mut v := Vector {} as Vector<int>
    v.Push(1)
    p := v.Ref(0)
    v.Push(2)
    println p[0]
    v.Free()
end
