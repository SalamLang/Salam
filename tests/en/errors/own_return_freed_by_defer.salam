// EXPECT: E141
// EXPECT-MSG: 'v' is returned, but the deferred free on line 19 releases its storage
func make(): Vector<int>:
    mut v := Vector {} as Vector<int>
    defer v.free()
    v.push(1)
    ret v
end

func main:
    v := make()
    println v.len()
end
