// EXPECT: E141
// EXPECT-MSG: 'v' is returned, but the deferred free on line 18 releases its storage
func make(): Vector<int>:
    mut v := Vector {} as Vector<int>
    defer v.Free()
    v.Push(1)
    ret v
end

func main:
    v := make()
    println v.Len()
end
