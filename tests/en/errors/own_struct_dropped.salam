// EXPECT: E250
// EXPECT-MSG: this call returns a struct that owns a heap string and the result is thrown away, so it is never freed
struct User:
    pub name: str = ""
end

func ask(): User:
    ret User { name = "  bob ".Trim() }
end

func main:
    ask()
end
