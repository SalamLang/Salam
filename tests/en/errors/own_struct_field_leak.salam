// EXPECT: E250
// EXPECT-MSG: 'u.name' owns a heap string that is never freed
struct User:
    pub name: str = ""
end

func ask(): User:
    ret User { name = "  bob ".Trim() }
end

func main:
    u := ask()
    println u.name
end
