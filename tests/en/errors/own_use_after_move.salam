// FLAGS: --ownership=error
// EXPECT: E163
// EXPECT-MSG: 'a' is used after its buffer was moved on line 21
func main:
    mut a := Vector {} as Vector<int>
    a.push(1)
    b := a
    println b.len(), a.len()
end
