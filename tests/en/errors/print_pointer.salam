// EXPECT: E002
// ref hands back a pointer into the vector, so this needs `[0]` to print
// the element. Without the check it reached the C backend as
// printf("%d", (int)ptr) - a truncated address printed as a number.
// (get itself is the element now, and prints without any of this.)
func main:
    mut names := Vector {} as Vector<str>
    names.push("ali")
    println names.ref(0)
    names.free()
end
