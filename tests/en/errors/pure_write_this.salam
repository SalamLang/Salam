// EXPECT: E013
// EXPECT-MSG: cannot assign to field 'count' of 'this'
struct Counter:
    pub count: int = 0

    pub pure func Bump(): int:
        this.count++
        ret this.count
    end
end

func main:
    mut c := Counter { count = 1 }
    println c.Bump()
end
