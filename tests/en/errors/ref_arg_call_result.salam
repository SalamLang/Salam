// EXPECT: E013
// EXPECT-MSG: cannot pass a temporary value to reference parameter 'n'; pass a 'mut' variable, field or element
func increase(n &: int):
    n += 1
end

func three(): int:
    ret 3
end

func main:
    increase(three())
end
