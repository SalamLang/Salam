// EXPECT: E013
// EXPECT-MSG: cannot pass immutable variable 'total' to reference parameter 'into'; declare it 'mut'
struct Adder:
    pub step: int = 2
    pub func AddTo(into &: int):
        into += this.step
    end
end

func main:
    a := Adder {}
    total := 0
    a.AddTo(total)
    println total
end
