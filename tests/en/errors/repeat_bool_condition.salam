// EXPECT: E063
// EXPECT-MSG: repeat count must be a number, got 'bool'
// EXPECT-MSG: write 'until <condition>:'
// EXPECT-MSG: write 'repeat 10 in i:'
func main:
    mut n := 1
    repeat n <= 100:
        n += 1
    end
    println n
end
