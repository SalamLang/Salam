// A variable named after a keyword used to report the useless "expected an
// expression (near 'by')", followed by a cascade of "unknown identifier
// '<error>'" from sema. It now names the word and says what to do about it.
// EXPECT: reserved

func main:
    by := 1 + 2
    println by
    ret 0
end
