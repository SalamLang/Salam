// A signed value may widen into an unsigned return type only when it
// provably cannot be negative. -5 can, and would arrive as
// 18446744073709551611.

// EXPECT: E002
func nr(): u64:
    val := 0 - 5 as i16
    ret val
end

func main:
    println nr()
end
