// Same rule where the value is only known at run time: nothing here can
// prove the parameter is not negative, so the widening stays an error and
// the caller has to say 'as u64' to mean it.

// EXPECT: E002
func nr(x: int): u64:
    val := x as i16
    ret val
end

func main:
    println nr(7)
end
