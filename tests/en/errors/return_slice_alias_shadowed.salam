// EXPECT: E012
// EXPECT-MSG: cannot return a slice of 'a'
func view(b: int[], n: int): int[]:
    a := [1, 2, 3]
    v := a[1:]
    repeat n:
        a := b
        println len(a)
        ret v
    end
    ret b
end

func main:
    nums := [4, 5]
    println len(view(nums, 1))
end
