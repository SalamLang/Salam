// EXPECT: E001
// EXPECT-MSG: unknown type 'Self'
interface Cloneable:
    func Dup(): Self
end

struct A:
    pub n: int = 0
    pub func Dup(): A: ret A { n = this.n } end
end

func main:
    println A { n = 1 }.Dup().n
end
