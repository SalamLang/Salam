// EXPECT: E162
// EXPECT-MSG: 'x = x + y' is not allowed: write 'x += y'
// EXPECT-MSG: 'x = y + x' is not allowed: write 'x += y'
// EXPECT-MSG: 'x = x - y' is not allowed: write 'x -= y'
// EXPECT-MSG: 'x = x * y' is not allowed: write 'x *= y'
// EXPECT-MSG: 'x = x / y' is not allowed: write 'x /= y'
// EXPECT-MSG: 'x = x % y' is not allowed: write 'x %= y'
// EXPECT-MSG: 'x = x & y' is not allowed: write 'x &= y'
// EXPECT-MSG: 'x = x | y' is not allowed: write 'x |= y'
// EXPECT-MSG: 'x = x ^ y' is not allowed: write 'x ^= y'
// EXPECT-MSG: 'x = x << y' is not allowed: write 'x <<= y'
// EXPECT-MSG: 'x = x >> y' is not allowed: write 'x >>= y'
// EXPECT-MSG: 'x = x + 2' is not allowed: write 'x += 2'
// EXPECT-MSG: 'x = x + y * 3' is not allowed: write 'x += y * 3'
// EXPECT-MSG: 'x = (x) + (y + 1)' is not allowed: write 'x += (y + 1)'
// EXPECT-MSG: 'x = (y + x)' is not allowed: write 'x += y'
// EXPECT-MSG: 'f = f * g' is not allowed: write 'f *= g'
// EXPECT-MSG: 's = s + "b"' is not allowed: write 's += "b"'
// EXPECT-MSG: 'this.value = this.value * k' is not allowed: write 'this.value *= k'
// EXPECT-MSG: 'a[i] = a[i] + y' is not allowed: write 'a[i] += y'
// EXPECT-MSG: 'v[i - 1] = v[i - 1] + y' is not allowed: write 'v[i - 1] += y'
// EXPECT-MSG: Write 'x += y'
struct Counter:
    pub value: int = 0
    pub func scale(k: int):
        this.value = this.value * k
    end
end

func twice(n: int): int:
    ret n * 2
end

func main:
    mut x := 5
    y := 3
    mut f := 2.5
    g := 2.0
    mut s := "a"
    mut a := [1, 2, 3]
    mut v := Vector {} as Vector<int>
    defer v.Free()
    v.push(1)
    i := 1
    mut c := Counter { value = 2 }
    x = x + y
    x = y + x
    x = x - y
    x = x * y
    x = x / y
    x = x % y
    x = x & y
    x = x | y
    x = x ^ y
    x = x << y
    x = x >> y
    x = x + 2
    x = x + y * 3
    x = (x) + (y + 1)
    x = (y + x)
    f = f * g
    s = s + "b"
    a[i] = a[i] + y
    v[i - 1] = v[i - 1] + y
    c.scale(3)
    println x, f, s, a[1], v[0], c.value, twice(x)
end
