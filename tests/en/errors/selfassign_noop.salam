// EXPECT: E162
// EXPECT-MSG: 'x = x + 0' does nothing: remove this statement
// EXPECT-MSG: 'x = 0 + x' does nothing: remove this statement
// EXPECT-MSG: 'x = x - 0' does nothing: remove this statement
// EXPECT-MSG: 'x = x * 1' does nothing: remove this statement
// EXPECT-MSG: 'x = 1 * x' does nothing: remove this statement
// EXPECT-MSG: 'x = x / 1' does nothing: remove this statement
// EXPECT-MSG: 'x += 0' does nothing: remove this statement
// EXPECT-MSG: 'x -= 0' does nothing: remove this statement
// EXPECT-MSG: 'x *= 1' does nothing: remove this statement
// EXPECT-MSG: 'x /= 1' does nothing: remove this statement
// EXPECT-MSG: 'x = x | 0' does nothing: remove this statement
// EXPECT-MSG: 'x = x ^ 0' does nothing: remove this statement
// EXPECT-MSG: 'x = x << 0' does nothing: remove this statement
// EXPECT-MSG: 'x >>= 0' does nothing: remove this statement
// EXPECT-MSG: 'x = x & -1' does nothing: remove this statement
// EXPECT-MSG: 'x = x' does nothing: remove this statement
// EXPECT-MSG: 'f = f ** 1' does nothing: remove this statement
// EXPECT-MSG: 'this.value = this.value * 1' does nothing: remove this statement
// EXPECT-MSG: Remove this statement
struct Counter:
    pub value: int = 0
    pub func keep():
        this.value = this.value * 1
    end
end

func main:
    mut x := 5
    mut f := 2.5
    mut c := Counter {}
    x = x + 0
    x = 0 + x
    x = x - 0
    x = x * 1
    x = 1 * x
    x = x / 1
    x += 0
    x -= 0
    x *= 1
    x /= 1
    x = x | 0
    x = x ^ 0
    x = x << 0
    x >>= 0
    x = x & -1
    x = x
    f = f ** 1
    c.keep()
    println x, f, c.value
end
