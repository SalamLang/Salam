// EXPECT: E162
// EXPECT-MSG: 'x = x + 1' is not allowed: write 'x++'
// EXPECT-MSG: 'x = 1 + x' is not allowed: write 'x++'
// EXPECT-MSG: 'x += 1' is not allowed: write 'x++'
// EXPECT-MSG: 'x = x - 1' is not allowed: write 'x--'
// EXPECT-MSG: 'x -= 1' is not allowed: write 'x--'
// EXPECT-MSG: 'x -= -1' is not allowed: write 'x++'
// EXPECT-MSG: 'x += -1' is not allowed: write 'x--'
// EXPECT-MSG: 'x = x - (-1)' is not allowed: write 'x++'
// EXPECT-MSG: 'x = -1 + x' is not allowed: write 'x--'
// EXPECT-MSG: 'x = (x) + 1' is not allowed: write 'x++'
// EXPECT-MSG: 'x = (x + 1)' is not allowed: write 'x++'
// EXPECT-MSG: 'x = x + ONE' is not allowed: write 'x++'
// EXPECT-MSG: 'x = x + (3 - 2)' is not allowed: write 'x++'
// EXPECT-MSG: 'f = f + 1.0' is not allowed: write 'f++'
// EXPECT-MSG: 'f += 1' is not allowed: write 'f++'
// EXPECT-MSG: 'this.value = this.value + 1' is not allowed: write 'this.value++'
// EXPECT-MSG: 'a[1] = a[1] + 1' is not allowed: write 'a[1]++'
// EXPECT-MSG: 'a[x] -= 1' is not allowed: write 'a[x]--'
// EXPECT-MSG: 'q[0] = q[0] + 1' is not allowed: write 'q[0]++'
// EXPECT-MSG: Write 'x++'
// EXPECT-MSG: Write 'x--'
import mem

const ONE := 1

struct Counter:
    pub value: int = 0
    pub func bump():
        this.value = this.value + 1
    end
end

func main:
    mut x := 1
    mut f := 1.5
    mut a := [1, 2, 3]
    mut c := Counter {}
    q := mem.Allocate(8 as u64) as i64*
    x = x + 1
    x = 1 + x
    x += 1
    x = x - 1
    x -= 1
    x -= -1
    x += -1
    x = x - (-1)
    x = -1 + x
    x = (x) + 1
    x = (x + 1)
    x = x + ONE
    x = x + (3 - 2)
    f = f + 1.0
    f += 1
    a[1] = a[1] + 1
    a[x] -= 1
    q[0] = q[0] + 1
    c.bump()
    println x, f, a[0], c.value, q[0]
    mem.Free(q as void*)
end
