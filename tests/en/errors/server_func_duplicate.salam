// EXPECT: E288
// EXPECT-MSG: two server funcs are named 'Find'
// EXPECT-NOT: fatal signal
server func Find(id: int): str:
    ret "a"
end

server func Find(name: str): str:
    ret name
end

func main:
    println Find(1)
end
