// EXPECT: E287
// EXPECT-MSG: server func 'Get' must be declared at the top level
struct Shop:
    pub name: str = ""
    server func Get(this): str:
        ret this.name
    end
end

func main:
    s := Shop { name = "a" }
    println s.name
end
