// EXPECT: E285
// EXPECT-MSG: server func 'Load' result has type 'Box', which cannot cross the network
struct Box:
    pub name: str = ""
    pub raw: int* = null
end

server func Load(id: int): Box:
    ret Box { name = "a" }
end

func main:
    println Load(1).name
end
