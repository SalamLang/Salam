// EXPECT: E285
// EXPECT-MSG: server func 'Bump' parameter 'n' has type 'i32', which cannot cross the network
server func Bump(n &: int): int:
    n++
    ret n
end

func main:
    mut v := 1
    println Bump(v)
end
