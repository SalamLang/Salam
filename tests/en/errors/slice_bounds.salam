// EXPECT: E021
// EXPECT-MSG: slice bound 10 is out of bounds for an array of length 3
// EXPECT-MSG: slice bound 5 is out of bounds for an array of length 3
// EXPECT-MSG: slice bound -1 is out of bounds for an array of length 3
// EXPECT-MSG: slice start 2 is greater than its end 1
func main:
    arr := [1, 2, 3]
    println arr[1:10].len()
    println arr[5:6].len()
    println arr[0 - 1:2].len()
    println arr[2:1].len()
end
