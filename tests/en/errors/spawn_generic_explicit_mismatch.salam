// EXPECT: E012
import mem

struct Box<T>:
    pub n: int = 0
end

func worker<T>(b: Box<T>*):
    b.n = b.n + 1
end

func main:
    p := mem.Allocate(sizeof(Box<int>)) as Box<int>*
    t := spawn(worker<str>, p)
    join(t)
end
