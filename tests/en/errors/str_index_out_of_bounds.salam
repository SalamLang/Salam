// EXPECT: E021
// EXPECT-MSG: index 99 is out of bounds for a string of length 2
// EXPECT-MSG: index 2 is out of bounds for a string of length 2
// EXPECT-MSG: index -5 is out of bounds for a string of length 2
// EXPECT-MSG: index 10 is out of bounds for a string of length 5
const GREET := "hello"

func main:
    s := "ab"
    println s[99]
    println s[2]
    println s[0 - 5]
    println GREET[10]
    println "ab"[7]
end
