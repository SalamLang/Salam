// EXPECT: error:
// EXPECT-MSG: a struct literal sets fields with '=', not ':'
// EXPECT-NOT: expected an expression
struct Point:
    pub x: int = 0
    pub y: int = 0
end

func main:
    p := Point { x: 1, y: 2 }
    println p.x, p.y
end
