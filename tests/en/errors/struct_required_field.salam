// EXPECT: E028
// EXPECT-MSG: struct literal 'Client' requires field 'host'
// EXPECT-NOT: requires field 'port'
struct Client:
    pub host: str
    pub port: int = 443
end

func main:
    c := Client { port = 80 }
    println c.port
end
