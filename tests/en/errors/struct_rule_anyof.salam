// EXPECT: E159
// EXPECT-MSG: struct literal 'S' must set at least one of 'a', 'b'
struct S:
    pub a: int = 0
    pub b: int = 0
    rule anyof(a, b)
end

func main:
    s := S {}
    println s.a
end
