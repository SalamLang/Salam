// EXPECT: E159
// EXPECT-MSG: struct literal 'Auth' sets 'user', which needs 'pass'
struct Auth:
    pub user: str = ""
    pub pass: str = ""
    rule user needs pass
end

struct Client:
    use Auth
    pub host: str = ""
end

func main:
    c := Client { user = "u" }
    println c.host
end
