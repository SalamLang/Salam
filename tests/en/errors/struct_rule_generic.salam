// EXPECT: E159
// EXPECT-MSG: sets 'a', which needs 'b'
struct Box<T>:
    pub a: str = ""
    pub b: str = ""
    pub v: T
    rule a needs b
end

func main:
    s := Box { a = "x", v = 1 } as Box<int>
    println s.a
end
