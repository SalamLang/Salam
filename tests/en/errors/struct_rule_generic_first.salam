// EXPECT: E159
// EXPECT-MSG: struct literal 'Box<i32>' sets 'u', which needs 'p'
struct A:
    pub b: Box<int>
end

struct Box<T>:
    @en "user"
    pub u: str = ""
    pub p: str = ""
    pub v: T
    rule user needs p
end

func main:
    s := Box { u = "x", v = 1 } as Box<int>
    println s.u
end
