// EXPECT: E159
// EXPECT-MSG: struct literal 'Client' sets 'key1', which needs 'key2'
// EXPECT-MSG: the struct declares: rule key1 needs key2
struct Client:
    pub key1: str = ""
    pub key2: str = ""
    rule key1 needs key2
end

func main:
    c := Client { key1 = "a" }
    println c.key1
end
