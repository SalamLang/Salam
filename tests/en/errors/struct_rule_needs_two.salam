// EXPECT: E159
// EXPECT-MSG: sets 'a', which needs 'b'
// EXPECT-MSG: sets 'a', which needs 'c'
struct S:
    pub a: int = 0
    pub b: int = 0
    pub c: int = 0
    rule a needs b, c
end

func main:
    s := S { a = 1 }
    println s.a
end
