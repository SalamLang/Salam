// EXPECT: E161
// EXPECT-MSG: no literal of struct 'S' can satisfy its rules
struct S:
    pub a: int = 0
    pub b: int = 0
    rule oneof(a, b)
    rule a needs b
    rule b needs a
end

func main:
    println 1
end
