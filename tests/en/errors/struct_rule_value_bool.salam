// EXPECT: E159
// EXPECT-MSG: struct literal 'S' has 'use_key' equal to true, which needs 'key'
// EXPECT-MSG: the struct declares: rule use_key == true needs key
struct S:
    pub use_key: bool = false
    pub key: str = ""
    rule use_key == true needs key
end

func main:
    s := S { use_key = true }
    println s.key
end
