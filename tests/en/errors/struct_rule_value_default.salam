// EXPECT: E159
// EXPECT-MSG: struct literal 'S' has 'secure' equal to true, which needs 'ca'
struct S:
    pub secure: bool = true
    pub ca: str = ""
    rule secure == true needs ca
end

func main:
    s := S {}
    println s.ca
end
