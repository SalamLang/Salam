// EXPECT: E159
// EXPECT-MSG: struct literal 'S' has 'mode' equal to Tls, which needs 'cert'
enum Mode:
    Plain, Tls
end

struct S:
    pub mode: Mode = Mode.Plain
    pub cert: str = ""
    rule mode == Mode.Tls needs cert
end

func main:
    s := S { mode = Mode.Tls }
    println s.cert
end
