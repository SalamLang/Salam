// EXPECT: E159
// EXPECT-MSG: must set 'y' because 'c' may equal G
enum C:
    G, R
end

struct H:
    pub G: C = C.R
end

struct S:
    pub c: C = C.R
    pub y: str = ""
    rule c == C.G needs y
end

func main:
    h := H {}
    s := S { c = h.G }
    println s.y
end
