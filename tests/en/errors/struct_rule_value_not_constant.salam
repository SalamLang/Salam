// EXPECT: E159
// EXPECT-MSG: struct literal 'S' must set 'key' because 'use_key' may equal true (its value is not a constant)
struct S:
    pub use_key: bool = false
    pub key: str = ""
    rule use_key == true needs key
end

func pick(): bool:
    ret false
end

func main:
    s := S { use_key = pick() }
    println s.key
end
