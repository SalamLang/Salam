// EXPECT: E160
// EXPECT-MSG: the value in a rule must be a literal or a plain enum member
const LIMIT := 3

struct S:
    pub n: int = 0
    pub m: int = 0
    rule n == LIMIT needs m
end

func main:
    println S {}.m
end
