// EXPECT: E159
// EXPECT-MSG: struct literal 'S' has 'kind' equal to "unix", which needs 'path'
struct S:
    pub kind: str = "tcp"
    pub path: str = ""
    rule kind == "unix" needs path
end

func main:
    s := S { kind = "unix" }
    println s.path
end
