// EXPECT: E016
// EXPECT-MSG: struct 'Point' has no field 'xpso'; did you mean 'xpos'?
struct Point:
    pub xpos: int = 0
    pub ypos: int = 0
end

func main:
    p := Point { ypos = 1, xpso = 2 }
    println p.ypos
end
