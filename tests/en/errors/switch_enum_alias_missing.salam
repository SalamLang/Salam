// EXPECT: E103
// EXPECT-MSG: does not cover: Square
enum Shape:
    Circle, Square
end

type Figure = Shape

func name(f: Figure): str:
    switch f:
        Figure.Circle:
            ret "circle"
        end
    end
    ret "?"
end

func main:
    println name(Figure.Circle)
end
