// EXPECT: E103
// EXPECT-MSG: switch on enum 'Color' does not cover: Green, Blue
enum Color:
    Red, Green, Blue
end

func name(c: Color): str:
    switch c:
        Color.Red:
            ret "red"
        end
    end
    ret "?"
end

func main:
    println name(Color.Red)
end
