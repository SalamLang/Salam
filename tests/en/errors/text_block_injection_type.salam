// EXPECT: E021
// EXPECT-MSG: operator '+' on a string requires the other operand to be a string, number, bool, or char (got 'str' and 'Point')
struct Point:
    pub x: int = 0
end

func main:
    p := Point { x = 1 }
    s := ```
        p=${{ p }}
        ```
    println s
end
