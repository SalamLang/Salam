// EXPECT: E237
// EXPECT-MSG: 'throws' is no longer a keyword; write 'throw'
func half(n: int): int throws:
    if n % 2 != 0:
        throw "odd"
    end
    ret n / 2
end

func check(n: int) throws:
    if n < 0:
        throw "negative"
    end
end

func main throws:
    println try half(8)
    check(1)
end
