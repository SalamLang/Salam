// EXPECT: E012
// EXPECT-MSG: '?' must be the whole value of its statement
// EXPECT-NOT: expected an expression
enum Result<T, E>:
    Ok(value: T)
    Err(error: E)
end

func get(n: int): Result<int, str>:
    ret Result.Ok(n)
end

func use(n: int): Result<int, str>:
    x := get(n)? > 1 ? 1 : 2
    ret Result.Ok(x)
end

func main:
    println use(5)
end
