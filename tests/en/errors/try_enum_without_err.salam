// EXPECT: E012
// EXPECT-MSG: '?' returns the error early as an 'Err' member, but 'Res', the return type of this function, has no member named 'Err'
// EXPECT-NOT: double free
enum Res:
    Ok(v: int)
    Fail(msg: str)
end

func half(n: int): Res:
    if n % 2 != 0:
        ret Res.Fail("odd")
    end
    ret Res.Ok(n / 2)
end

func quarter(n: int): Res:
    h := half(n)?
    ret Res.Ok(h)
end

func main:
    println quarter(8)
end
