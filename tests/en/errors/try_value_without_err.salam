// EXPECT: E016
// EXPECT-MSG: '?' needs a value of an enum with 'Ok' and 'Err' members, but 'Res' has no member named 'Err'
// EXPECT-NOT: __tryerr
enum Res:
    Ok(v: int)
    Fail(msg: str)
end

enum Result<T, E>:
    Ok(value: T)
    Err(error: E)
end

func half(n: int): Res:
    ret Res.Ok(n / 2)
end

func quarter(n: int): Result<int, str>:
    h := half(n)?
    ret Result.Ok(h)
end

func main:
    println quarter(8)
end
