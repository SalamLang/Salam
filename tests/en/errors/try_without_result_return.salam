// EXPECT: E012
enum Result<T, E>:
    Ok(value: T)
    Err(error: E)
end

func one(): Result<int, str>:
    ret Result.Ok(1)
end

func two(): int:
    one()?
    ret 2
end

func main:
    println two()
end
