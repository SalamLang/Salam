// EXPECT: E001
// EXPECT-MSG: 'config' is a local variable of 'load'
// EXPECT-MSG: 'count' is a parameter of 'helper'
// EXPECT-MSG: 'inner' is declared on line
// EXPECT-MSG: 'later' is declared later, on line
// EXPECT-MSG: 'item' is the variable of the loop on line
// EXPECT-MSG: unknown identifier 'itmes'; did you mean 'items'?
// EXPECT-MSG: 'ghost' was never declared; to create a variable write 'ghost := value'
// EXPECT-MSG: 'os' is a standard package that is not imported; add 'import os'
// EXPECT-MSG: nothing named 'settings' is declared here
// EXPECT-MSG: 'println' is one word: write 'println items'
// EXPECT-MSG: call to undefined function 'prinln'
// EXPECT-NOT: assignment target is not assignable
// EXPECT-NOT: Add 'import config'

func load:
    config := 5
    println config
end

func helper(count: int):
    println count
end

func main:
    load()
    helper(1)
    println config * 3
    println count
    items := 3
    println itmes, items
    if items > 0:
        inner := 2
        println inner
    end
    println inner
    println later
    later := 1
    println later
    each item in [1, 2]:
        println item
    end
    println item
    ghost = 3
    println os.Args()
    println settings
    print ln items
    prinln(items)
end
