// EXPECT-NOT: assignment target is not assignable
// EXPECT-NOT: Add 'import config'

func load:
    config := 5
    println config
end

func helper(count: int):
    println count
end

func main:
    load()
    helper(1)
    println config * 3
    println count
    items := 3
    println itmes, items
    if items > 0:
        inner := 2
        println inner
    end
    println inner
    println later
    later := 1
    println later
    each item in [1, 2]:
        println item
    end
    println item
    ghost = 3
    println os.Args()
    println settings
    print ln items
    prinln(items)
    launch()
end
