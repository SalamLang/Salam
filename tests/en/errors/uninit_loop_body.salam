// EXPECT: E089
// A loop body may run zero times, so what it assigns is not guaranteed after it.
func f(n: int): int:
    mut x: int
    mut i := 0
    until i < n:
        x = i
        i = i + 1
    end
    ret x
end

func main:
    println f(3)
    ret 0
end
