// EXPECT: E146
// EXPECT-MSG: index out of bounds: the index is 4, but 'p' has 4 elements
import mem

func main:
    p := mem.Allocate(32 as u64) as i64*
    repeat 4 in i:
        p[i] = i as i64
    end
    p[4] = 0 as i64
    println p[0]
    mem.Free(p as void*)
end
