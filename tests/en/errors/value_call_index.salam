// EXPECT: E146
// EXPECT-MSG: index out of bounds: 'i' is 4, but 'xs' has 4 elements (in the call to 'get')
// EXPECT-MSG: 'get' always reads 'xs[i]' on line 19 before it can return
func get(xs: int[], i: int): int:
    ret xs[i]
end

func main:
    a := [1, 2, 3, 4]
    println get(a, 3)
    println get(a, 4)
end
