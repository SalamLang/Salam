// EXPECT: E146
// EXPECT-MSG: index out of bounds: 'i + 1' is xs.Len(), past the last element of 'xs' (on the last pass of the loop on line 19)
func rising(xs: int[]): int:
    mut n := 0
    each i, x in xs:
        if x < xs[i + 1]:
            n++
        end
    end
    ret n
end

func main:
    println rising([1, 2, 3])
end
