// EXPECT: E146
// EXPECT-MSG: index out of bounds: 'os.Args().len() + 5' is at least 5, but 'xs' has 3 elements
import os

func main:
    xs := [10, 20, 30]
    println xs[os.Args().len() + 5]
end
