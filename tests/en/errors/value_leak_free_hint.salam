// FLAGS: --log-level=warn
// EXPECT: W158
// EXPECT-MSG: the memory 'buf' gets from mem.Allocate on line 22 is never freed
// EXPECT-MSG: free it with 'defer mem.Free(buf as void*)' on the line after the allocation
import mem

func main:
    buf := mem.Allocate(8 as u64) as i64*
    buf[0] = 7
    println buf[0]
end
