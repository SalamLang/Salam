// EXPECT: E146
// EXPECT-MSG: index out of bounds: 'i' is xs.Len(), past the last element of 'xs' (on the last pass of the loop on line 19)
func total(xs: int[]): int:
    mut t := 0
    repeat 0 to xs.Len() in i:
        t += xs[i]
    end
    ret t
end

func main:
    println total([1, 2, 3])
end
