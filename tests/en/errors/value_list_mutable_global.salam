// EXPECT: E135
// EXPECT-MSG: a style value from runtime must be a web.Color, a web.Length or a number
mut theme := "serif"

page Home(n: int):
    box: font family = theme, "serif" content = "x" + n end
end

func main:
    theme = "mono"
    println Home(1)
end
