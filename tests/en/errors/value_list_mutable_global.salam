// EXPECT: E132
// EXPECT-MSG: 'font family' on 'box' must be known at compile time
mut theme := "serif"

page Home(n: int):
    box: font family = theme, serif content = "x" + n end
end

func main:
    theme = "mono"
    println Home(1)
end
