// EXPECT: E152
// EXPECT-MSG: null pointer dereference: 'p' is null here, because 'find' always returns null
struct Node:
    pub key: int = 0
end

func find(k: int): Node*:
    if k > 100:
        ret null
    end
    ret null
end

func main:
    p := find(3)
    println p.key
end
