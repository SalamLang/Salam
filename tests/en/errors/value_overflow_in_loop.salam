// EXPECT: E148
// EXPECT-MSG: integer overflow: 'f *= i' gives 6227020800, which does not fit in 'i32' (on pass 13 of the loop on line 19)
func main:
    mut f := 1
    repeat 1 to 20 in i:
        f *= i
    end
    println f
end
