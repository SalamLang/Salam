// EXPECT: E148
// EXPECT-MSG: integer overflow: 'a + 1' gives 2147483648, which does not fit in 'i32'
// EXPECT-MSG: cast an operand to a wider type such as 'i64' first
func main:
    a := 2147483647 as i32
    b := a + 1
    println b
end
