// EXPECT: E146
// EXPECT-MSG: valid indices of 'nums' are 0 to 2; 'repeat a to b' includes b itself, so count with 'repeat xs.len() in i:' or 'each i, x in xs:'
func main:
    nums := [10, 20, 30]
    repeat 0 to nums.len() in i:
        println nums[i]
    end
end
