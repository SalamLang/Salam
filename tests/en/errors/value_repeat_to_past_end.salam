// EXPECT: E146
// EXPECT-MSG: index out of bounds: 'i' is 3, but 'xs' has 3 elements (on pass 4 of the loop on line 20)
// EXPECT-MSG: 'repeat a to b' includes b itself
func main:
    xs := [10, 20, 30]
    repeat 0 to 3 in i:
        println xs[i]
    end
end
