// A bare function name is a value (its address), so a local may not reuse
// one: inside main, `handler` would silently stop meaning the function.
// EXPECT: E090
func handler(x: i64): i64:
    ret x + 1
end

func main:
    handler := 5
    println handler
    ret 0
end
