// EXPECT: E012
// EXPECT-MSG: cannot pass 'Vector<i32>' to 'i32[]'
func total(xs: int[]): int:
    ret len(xs)
end

func main:
    mut v := Vector {} as Vector<int>
    v.Push(1)
    println total(v)
end
