// EXPECT: E304
// EXPECT-MSG: '0 - 1' is not allowed: write '-1'
// EXPECT-MSG: '0.0 - v' is not allowed: write '-v'
// EXPECT-MSG: '0 - a * b' is not allowed: write '-(a * b)'
// EXPECT-MSG: '0.0 - 1' is not allowed: write '-1.0'
// EXPECT-MSG: '0 - 2' is not allowed: write '-2'
// EXPECT-MSG: '0 - (a + b) ** 2' is not allowed: write '-((a + b) ** 2)'

const START := 0 - 2

func main:
    a := 4
    b := 3
    v := 2.5
    println 0 - 1, 0.0 - v, 0 - a * b, 0.0 - 1, START, 0 - (a + b) ** 2
end
