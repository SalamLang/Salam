// Helper for general/generic_xpkg: a struct another package builds a
// Vector<> of. Named by two different modules on purpose - the whole point
// of the test.
package genrow

pub struct Row:
    pub id: int = 0
    pub tag: str = ""
end

pub func List(n: int): Vector<Row>:
    mut v := Vector {} as Vector<Row>
    repeat n with i:
        v.push(Row { id = i, tag = "r" })
    end
    ret v
end
