package genshadowa

mut hits := 100

pub struct Error:
    pub code: int = 0
end

pub struct Box<T>:
    pub v: T

    pub func label(): str:
        ret _name() + " box"
    end

    pub func check(): bool:
        e := Error { code = 7 }
        ret Ok(e)
    end
end

func _name(): str:
    ret "a"
end

func _on(x: i64):
    hits = hits + 1
    println "a on", x, hits
end

pub func Ok(e: Error): bool:
    ret e.code == 7
end

pub func Show<T>(_x: T): str:
    e := Error { code = 7 }
    if Ok(e):
        ret _name() + " " + hits
    end
    ret "bad"
end

pub func Fire<T>(_x: T):
    callhandler(_on, 9)
end
