package genshadowb

pub struct Socket:
    pub fd: int = 0
end

func _name(): str:
    ret "b"
end

pub func Ok(s: Socket): bool:
    ret s.fd > 0
end

pub func Get<T>(_x: T): str:
    ret _name() + " get"
end
