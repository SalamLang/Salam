// A broad walk over the bit operators under the interpreter: signed
// `int` behaviour, the unsigned widths, shifts in both directions,
// compound assignment, and a few small kernels built out of them.

func popcount(x: int): int:
    mut v := x
    mut n := 0
    until v != 0:
        v = v & (v - 1)
        n = n + 1
    end
    ret n
end

func rotl32(x: u32, n: u32): u32:
    ret (x << n) | (x >> ((32 as u32 - n) & (31 as u32)))
end

func main:
    // signed basics
    println 12 & 10, 12 | 10, 12 ^ 10, ~12
    println 0 & 0, 0 | 0, 0 ^ 0, ~0
    println -1 & 255, -1 | 0, -1 ^ -1, ~-1

    // shifts
    println 1 << 0, 1 << 1, 1 << 10, 1 << 30
    println 1024 >> 0, 1024 >> 5, 1024 >> 10
    println -16 >> 1, -16 >> 2, -1 >> 20

    // shift/multiply and shift/divide equivalence
    println (7 << 5) == 7 * 32, (960 >> 6) == 960 / 64

    // compound assignment
    mut a := 0b1010
    a |= 0b0101
    println a
    a &= 0b1100
    println a
    a ^= 0b1111
    println a
    a <<= 4
    println a
    a >>= 2
    println a

    // unsigned widths
    println ~(0 as u8), ~(0 as u16), ~(0 as u32), ~(0 as u64)
    println (1 as u8) << (7 as u8), (1 as u16) << (15 as u16)
    println (1 as u32) << (31 as u32), (1 as u64) << (63 as u64)
    println ~(0 as u32) >> (16 as u32), ~(0 as u64) >> (32 as u64)
    println (0xFF as u8) + (1 as u8), (0 as u32) - (1 as u32)
    println (0xDEADBEEF as u32) & (0xFFFF as u32)
    println (0xDEADBEEF as u32) >> (16 as u32)
    println rotl32(0x12345678 as u32, 8 as u32)

    // masks and tests
    mut flags := 0
    flags |= 1 << 0
    flags |= 1 << 3
    flags |= 1 << 6
    println flags
    println (flags & (1 << 3)) != 0, (flags & (1 << 4)) != 0
    flags &= ~(1 << 3)
    println flags
    println popcount(flags), popcount(0), popcount(255), popcount(-1)

    // xor swap and xor round-trip
    mut p := 0x1234
    mut q := 0xABCD
    p ^= q
    q ^= p
    p ^= q
    println p, q
    key := 0x5A
    msg := 0x42
    println ((msg ^ key) ^ key) == msg

    // the logical connectives alongside the bitwise ones
    println true && false, true || false, !true
    println ((3 & 1) == 1) && ((3 | 4) == 7)
    println ((3 & 4) == 4) || ((3 ^ 3) == 0)

    // building a number bit by bit, then taking it apart again
    mut built := 0
    repeat 8 with i:
        if i % 3 != 0:
            built |= 1 << i
        end
    end
    println built
    mut bits := ""
    mut i := 7
    until i >= 0:
        bits = bits + ((built >> i) & 1)
        i = i - 1
    end
    println bits
end
