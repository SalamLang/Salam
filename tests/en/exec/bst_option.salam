type Link = int?

struct Node:
    pub key: int = 0
    pub left: Link
    pub right: Link
end

struct Tree:
    pub nodes: Vector<Node> = Vector {}
    pub root: Link
end

func no_child(): Link: ret null end

func child(i: int): Link: ret i end

func add_node(t &: Tree, k: int): int:
    t.nodes.push(Node { key = k, left = no_child(), right = no_child() })
    ret t.nodes.len() - 1
end

func attach(t &: Tree, at: int, k: int):
    mut cur := at
    until true:
        node := t.nodes[cur]
        if k < node.key:
            if node.left.is_none():
                fresh := add_node(t, k)
                p := t.nodes.ref(cur)
                p.left = child(fresh)
                ret
            end
            cur = node.left.unwrap()
        else k > node.key:
            if node.right.is_none():
                fresh := add_node(t, k)
                p := t.nodes.ref(cur)
                p.right = child(fresh)
                ret
            end
            cur = node.right.unwrap()
        else:
            ret
        end
    end
end

func insert(t &: Tree, k: int):
    if t.root.is_none():
        t.root = child(add_node(t, k))
        ret
    end
    attach(t, t.root.unwrap(), k)
end

func shape(t: Tree, at: Link): str:
    if at.is_none(): ret "absent" end
    n := t.nodes[at.unwrap()]
    has_left := n.left.is_some()
    has_right := n.right.is_some()
    if has_left and has_right: ret "both" end
    if has_left: ret "left only" end
    if has_right: ret "right only" end
    ret "leaf"
end

func find(t: Tree, k: int): Link:
    mut at := t.root
    until at.is_some():
        n := t.nodes[at.unwrap()]
        if k == n.key: ret at end
        at = k < n.key ? n.left : n.right
    end
    ret no_child()
end

func height(t: Tree, at: Link): int:
    if at.is_none(): ret 0 end
    n := t.nodes[at.unwrap()]
    l := height(t, n.left)
    r := height(t, n.right)
    ret 1 + (l > r ? l : r)
end

func inorder(t: Tree, at: Link):
    if at.is_none(): ret end
    n := t.nodes[at.unwrap()]
    inorder(t, n.left)
    print n.key, ""
    inorder(t, n.right)
end

func left_key_or(t: Tree, at: Link, fallback: int): int:
    if at.is_none(): ret fallback end
    c := t.nodes[at.unwrap()].left
    if c.is_none(): ret fallback end
    ret t.nodes[c.unwrap()].key
end

func main:
    mut t := Tree { root = no_child() }
    defer t.nodes.free()

    each k in [50, 30, 70, 20, 40, 60, 80, 35]: insert(t, k) end

    print "inorder:"
    inorder(t, t.root)
    println ""

    println "nodes =", t.nodes.len()
    println "height =", height(t, t.root)

    println "root shape:", shape(t, t.root)
    println "30 shape:", shape(t, find(t, 30))
    println "40 shape:", shape(t, find(t, 40))
    println "35 shape:", shape(t, find(t, 35))
    println "80 shape:", shape(t, find(t, 80))
    println "99 shape:", shape(t, find(t, 99))

    println "left of 40 =", left_key_or(t, find(t, 40), -1)
    println "left of 35 =", left_key_or(t, find(t, 35), -1)
    println "left of 99 =", left_key_or(t, find(t, 99), -1)

    println "found 60:", find(t, 60).is_some()
    println "found 65:", find(t, 65).is_some()

    mut empty := Tree { root = no_child() }
    defer empty.nodes.free()
    println "empty height =", height(empty, empty.root)
    println "empty shape:", shape(empty, empty.root)
    println "empty found 1:", find(empty, 1).is_some()
end
