import mem

limit := depth(5000)

struct Node:
    pub val: int = 0
    pub next: Node* = null
end

func depth(n: int): int:
    if n == 0: ret 0 end
    ret depth(n - 1) + 1
end

func build(n: int): Node*:
    if n == 0: ret null end
    p := mem.Allocate(sizeof(Node) as u64) as Node*
    p[0] = Node { val = n, next = build(n - 1) }
    ret p
end

func count(p: Node*): int:
    if p == null: ret 0 end
    ret count(p.next) + 1
end

func main:
    println limit
    println depth(20000)
    println count(build(10000))
end
