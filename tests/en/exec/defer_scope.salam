func report(tag: str):
    print tag
    println ""
end

func block_local():
    n := 3
    if n > 1:
        mut v := Vector {} as Vector<int>
        defer v.free()
        v.push(7)
        println v.len()
    end
    report("after branch")
end

func untaken_branch():
    mut v := Vector {} as Vector<int>
    n := 0
    if n > 1:
        defer v.free()
        report("taken")
    end
    v.push(7)
    println v.len()
    v.free()
    report("after untaken")
end

func per_iteration():
    mut i := 0
    until i < 3:
        defer report("iter")
        i = i + 1
    end
    report("after loop")
end

func through_break():
    mut i := 0
    until i < 5:
        defer report("b-iter")
        if i == 1:
            break
        end
        i = i + 1
    end
    report("after break")
end

func through_continue():
    mut i := 0
    until i < 3:
        defer report("c-iter")
        i = i + 1
        if i == 2:
            continue
        end
        report("body-end")
    end
    report("after continue")
end

func through_return(n: int): int:
    defer report("fn-level")
    if n > 0:
        defer report("branch-level")
        ret 1
    end
    ret 0
end

func main:
    block_local()
    untaken_branch()
    per_iteration()
    through_break()
    through_continue()
    println through_return(1)
    println through_return(0)
    ret 0
end
