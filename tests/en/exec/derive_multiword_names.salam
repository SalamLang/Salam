import encoding.json
import encoding.encerr

enum Stage:
    waiting room, under review, shipped out
end

enum Parcel:
    Small Box,
    Big Crate(weight: int)
end

struct Spot:
    pub grid row: int = 0
    pub grid col: int = 0
end

struct Order:
    pub pet name: str = ""
    pub line count: int = 0
    pub current stage: Stage = Stage.under review
    pub tag list: Vector<str> = Vector {} as Vector<str>
end

func main:
    mut a := Order { pet name = "x", line count = 3 }
    a.tag list.push("t")
    b := a.copy()
    c := a.deep_copy()
    println a
    println Spot { grid row = 1 } == Spot { grid row = 1 }, Spot { grid col = 2 } == Spot {}, b.line count, c.tag list.len()
    text := json.Marshal(a)
    println text
    mut back := Order {}
    mut err := encerr.NoError()
    println json.Unmarshal(text, back, err), back.pet name, back.current stage == Stage.under review
    println json.Schema(Order {})
    p := Parcel.Big Crate(10)
    println p, p == Parcel.Big Crate(10), p.copy()
    println json.Marshal(p), json.Marshal(Parcel.Small Box)
end
