func run(f: func ()):
    f()
end

func main:
    mut v := Vector {} as Vector<int>
    v.Push(1)
    v.Push(2)
    run(():
        println "a"
        each x in v:
            println x
        end
        repeat 0 to 5 by 2 in i:
            println i
        end
    end)
    v.Free()
end
