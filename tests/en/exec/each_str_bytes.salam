func hex(n: int): str:
    digits := "0123456789abcdef"
    ret digits.Substr(n / 16, 1) + digits.Substr(n % 16, 1)
end

func dump(s: str): str:
    mut out := ""
    each b in s.Bytes():
        out = out + hex(b as int) + " "
    end
    ret out
end

func make(): str:
    ret "یک"
end

func main:
    println dump("AZaz09")
    println dump("سلام")
    println dump("€👋")
    mut lead := 0
    mut sum := 0
    mut same := true
    text := "Hi سلام 👋"
    each i, b in text.Bytes():
        v := b as int
        sum += v
        if v < 128 or v >= 192:
            lead++
        end
        if b != text[i]:
            same = false
        end
    end
    println "bytes:", text.Len(), "lead bytes:", lead, "chars:", text.CharCount(), "sum:", sum, "index matches:", same
    mut empty := 0
    each _ in "".Bytes():
        empty++
    end
    println "empty:", empty
    mut first := -1
    each i, b in "abc✓def".Bytes():
        if (b as int) >= 128:
            first = i
            break
        end
    end
    println "first non-ASCII byte at:", first
    println dump(make())
end
