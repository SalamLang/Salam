include geo "_enum_data_geo.salam"

enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

struct Point:
    pub x: int = 0
    pub y: int = 0
end

enum Event:
    Click(at: Point, button: int)
    Key(code: str)
    Quit
end

struct Log:
    pub last: Event = Event.Quit
    pub count: int = 0
end

func area(s: Shape): f64:
    ret match s:
        Circle(r) => 3.0 * r * r
        Rect(w, h) => w * h
        Empty => 0.0
    end
end

func describe(t: geo.Token): str:
    ret match t:
        Num(v) => "num " + v
        Word(w) => "word " + w
        End => "end"
    end
end

func main:
    a := Shape.Circle(2.0)
    b := Shape.Rect(3.0, 4.0)
    println area(a)
    println area(b)
    println area(Shape.Empty)
    println a
    println b
    println Shape.Empty
    println a == Shape.Circle(2.0)
    println a == b
    println b != Shape.Rect(3.0, 5.0)
    match b:
        Rect(_, h):
            println h
        end
        Circle c:
            println c.r
        end
        else:
            println "other"
        end
    end
    e := Event.Click(Point { x = 1, y = 2 }, 1)
    println e
    mut lg := Log {}
    println lg
    lg.last = Event.Key("q")
    lg.count += 1
    println lg
    println lg == Log { last = Event.Key("q"), count = 1 }
    toks := [geo.Token.Num(4), geo.Token.Word("hi"), geo.Token.End]
    repeat 3 in i:
        println describe(toks[i])
    end
    mut v := Vector {} as Vector<Event>
    v.push(Event.Quit)
    v.push(e)
    println v.len()
    v.free()
end
