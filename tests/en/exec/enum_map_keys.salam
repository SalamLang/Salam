enum Color:
    Red, Green, Blue
end

enum Word:
    Low = "low", High = "high"
end

struct Tagged:
    pub c: Color
    pub n: int
end

func main:
    mut m := HashMap {} as HashMap<Color, int>
    m.Put(Color.Red, 1)
    m.Put(Color.Red, 2)
    m.Put(Color.Blue, 3)
    println m.Size(), m.Get(Color.Red), m.Get(Color.Blue), m.Has(Color.Green)
    println m.Remove(Color.Red), m.Size(), m.Has(Color.Red)

    mut s := Set {} as Set<Color>
    s.Add(Color.Green)
    s.Add(Color.Green)
    s.Add(Color.Blue)
    println s.Size(), s.Has(Color.Green), s.Has(Color.Red)

    mut w := HashMap {} as HashMap<Word, int>
    w.Put(Word.High, 5)
    w.Put(Word.High, 6)
    println w.Size(), w.Get(Word.High), w.Has(Word.Low)

    mut v := Vector {} as Vector<Color>
    v.Push(Color.Blue)
    v.Push(Color.Red)
    println v.Get(0) == Color.Blue, v.Get(1) == Color.Red, v.Get(0) == Color.Red
    match v.Get(0):
        Color.Red: println "red" end
        Color.Green: println "green" end
        Color.Blue: println "blue" end
    end

    t := Tagged { c = Color.Blue, n = 7 }
    println t.c == Color.Blue, t.n
end
