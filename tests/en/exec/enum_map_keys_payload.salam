enum Shape:
    Dot, Circle(r: int)
end

enum Color:
    Red, Green
end

struct Key:
    pub c: Color
    pub n: int
end

func main:
    mut m := HashMap {} as HashMap<Shape, int>
    m.Put(Shape.Circle(3), 1)
    m.Put(Shape.Circle(3), 2)
    m.Put(Shape.Circle(4), 3)
    m.Put(Shape.Dot, 4)
    m.Put(Shape.Dot, 5)
    println m.Size(), m.Get(Shape.Circle(3)), m.Get(Shape.Dot)

    mut k := HashMap {} as HashMap<Key, int>
    k.Put(Key { c = Color.Green, n = 1 }, 1)
    k.Put(Key { c = Color.Green, n = 1 }, 2)
    k.Put(Key { c = Color.Red, n = 1 }, 3)
    println k.Size(), k.Get(Key { c = Color.Green, n = 1 })

    mut s := Set {} as Set<Key>
    s.Add(Key { c = Color.Red, n = 2 })
    s.Add(Key { c = Color.Red, n = 2 })
    println s.Size(), s.Has(Key { c = Color.Red, n = 2 }), s.Has(Key { c = Color.Green, n = 2 })
end
