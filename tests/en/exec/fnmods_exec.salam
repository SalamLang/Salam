pure func add3(a: int, b: int, c: int): int: ret a + b + c end

inline func twice(x: int): int: ret x * 2 end

noinline func third(x: int): int: ret x / 3 end

func main:
    println add3(1, 2, 3)
    println twice(21)
    println third(9)
end
