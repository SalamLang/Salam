package main

include genuse "_genuse.salam"
include genrow "_genrow.salam"

func main:
    println genuse.Sum(4)
    mut v := genrow.List(3)
    defer v.Free()
    println v.Len(), v.Get(2).id, v.Get(1).tag
end
