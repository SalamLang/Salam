enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

mut probes := 0

func big(x: f64): bool:
    probes += 1
    ret x > 5.0
end

func kind(s: Shape): str:
    ret match s:
        Circle(r) if big(r) => "big circle"
        Circle(_) => "circle"
        Rect(w, h) if w == h => "square"
        Rect(w, h) => "rect " + w + "x" + h
        Empty => "empty"
    end
end

func grade(n: int): str:
    ret match n:
        0 => "zero"
        else => "some"
    end
end

func main:
    println kind(Shape.Circle(10.0))
    println kind(Shape.Circle(1.0))
    println kind(Shape.Rect(2.0, 2.0))
    println kind(Shape.Rect(2.0, 3.0))
    println kind(Shape.Empty)
    println probes
    x := 7
    match x:
        7 if probes > 100:
            println "never"
        end
        7:
            println "seven"
        end
        else:
            println "other"
        end
    end
    println grade(0)
end
