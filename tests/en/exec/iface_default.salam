interface Shape:
    func Area(): f64
    func Name(): str
    func Describe(): str:
        ret this.Name() + " with area " + this.Area()
    end
    func Double(): f64:
        ret this.Area() * 2.0
    end
end

struct Square:
    pub side: f64 = 1.0
    pub func Area(): f64:
        ret this.side * this.side
    end
    pub func Name(): str:
        ret "square"
    end
end

struct Circle:
    pub r: f64 = 1.0
    pub func Area(): f64:
        ret 3.0 * this.r * this.r
    end
    pub func Name(): str:
        ret "circle"
    end
    pub func Describe(): str:
        ret "a round circle"
    end
end

interface Show:
    func Label(): str
    func Print():
        println "<" + this.Label() + ">"
    end
end

impl Show on int:
    func Label(): str:
        ret "int " + this
    end
end

struct P:
    pub x: int = 0
    pub func Label(): str:
        ret "P" + this.x
    end
end

func show<T: Shape>(x: T): str:
    ret x.Describe()
end

func main:
    sq := Square { side = 2.0 }
    println sq.Describe()
    println sq.Double()
    println show(Circle { r = 1.0 })
    d := sq as dyn Shape
    println d.Describe()
    n := 5
    n.Print()
    pp := P { x = 2 }
    pp.Print()
end
