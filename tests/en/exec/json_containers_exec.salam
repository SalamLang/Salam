import encoding.json
import encoding.value

struct Person:
    pub name: str = ""
    pub age: int = 0
end

func decodes<T>(text: str, out &: T): bool:
    try:
        json.Unmarshal(text, out)
    catch:
        ret false
    end
    ret true
end

func main:
    persons := Vector {} as Vector<Person>
    persons.push(Person { name = "Ali", age = 30 })
    persons.push(Person { name = "Kuri", age = 55 })

    println persons

    text := json.Marshal(persons)
    println text

    mut back := Vector {} as Vector<Person>
    println decodes(text, back)
    println back.Len()
    println back.get(1).name
    println json.Marshal(back) == text

    mut grid := Vector {} as Vector<Vector<Person>>
    println decodes(`[[{"name":"a","age":1}],[]]`, grid)
    println grid.Len()
    println grid.get(0).get(0).name
    println grid.get(1).Len()

    mut counts := HashMap {} as HashMap<str, int>
    println decodes(`{"only":7}`, counts)
    println counts.get("only")

    mut v := try json.Decode(text) catch value.ValueNull()
    println value.IsNull(v)
    println value.ArrayLen(v)
    println value.AsString(value.ObjectGet(value.ArrayGet(v, 1), "name"))
    mut v2 := try json.Decode(json.EncodeDefault(v)) catch value.ValueNull()
    println value.Equal(v, v2)
    value.ValueFree(v2)
    value.ValueFree(v)

    mut mixed := try json.Decode(`[1,"two",null]`) catch value.ValueNull()
    println value.IsInt(value.ArrayGet(mixed, 0))
    println value.IsString(value.ArrayGet(mixed, 1))
    println value.IsNull(value.ArrayGet(mixed, 2))
    value.ValueFree(mixed)
end
