// The same JSON work under the tree walker rather than a compiled binary.
//
// json_derive_exec.salam next door covers a struct; this one covers the
// containers, because `salam exec` is what a one-file script actually runs
// under and a Vector of structs as the whole document is what those scripts
// mostly hold. Both derived codecs and the dynamic value tree are exercised:
// the derived functions are synthetic top-level declarations, so the
// interpreter has to walk code no source file contains.

import encoding.json
import encoding.value
import encoding.encerr

struct Person:
    pub name: str = ""
    pub age: int = 0
end

func main:
    persons := Vector {} as Vector<Person>
    persons.push(Person { name = "Ali", age = 30 })
    persons.push(Person { name = "Kuri", age = 55 })

    println persons

    text := json.Marshal(persons)
    println text

    mut back := Vector {} as Vector<Person>
    mut e := encerr.NoError()
    println json.Unmarshal(text, back, e)
    println back.len()
    println back.get(1).name
    println json.Marshal(back) == text

    // A container of containers, decoded from a literal rather than from
    // something this program encoded a moment ago.
    mut grid := Vector {} as Vector<Vector<Person>>
    println json.Unmarshal(`[[{"name":"a","age":1}],[]]`, grid, e)
    println grid.len()
    println grid.get(0).get(0).name
    println grid.get(1).len()

    mut counts := HashMap {} as HashMap<str, int>
    println json.Unmarshal(`{"only":7}`, counts, e)
    println counts.get("only")

    // The dynamic side, same interpreter.
    mut de := encerr.NoError()
    v := json.Decode(text, de)
    println encerr.IsError(de)
    println value.ArrayLen(v)
    println value.AsString(value.ObjectGet(value.ArrayGet(v, 1), "name"))
    // Re-encoded and read back it is the same document. Compared as trees,
    // not as text: object key order out of a HashMap is not fixed, so the
    // two encoders can spell the same object in different orders.
    mut re := encerr.NoError()
    v2 := json.Decode(json.EncodeDefault(v), re)
    println value.Equal(v, v2)
    value.ValueFree(v2)
    value.ValueFree(v)

    // A document the typed reader has no type for.
    mut me := encerr.NoError()
    mixed := json.Decode(`[1,"two",null]`, me)
    println value.IsInt(value.ArrayGet(mixed, 0))
    println value.IsString(value.ArrayGet(mixed, 1))
    println value.IsNull(value.ArrayGet(mixed, 2))
    value.ValueFree(mixed)
end
