// The compiler-derived JSON codecs under the tree walker. Three things have to
// hold for this to work, and each of them was broken here on its own:
//
//   - a field default written in another package resolves in that package
//     (EncodingError's `kind: int = KindNone`),
//   - a `&:` parameter carries what the callee left in it back to the caller
//     (every `_dgstr(s, p, q)`-style out parameter, and `err = ...` itself),
//   - a Vector or a pointer field holds real structs in real memory.

import encoding.json
import encoding.encerr

struct Addr:
    pub city: str = ""
    pub zip: int = 0
end

struct User:
    pub name: str = ""
    pub age: int = 0
    pub active: bool = false
    pub addr: Addr = Addr {}
    pub tags: Vector<str> = Vector {} as Vector<str>
    pub next: User* = null
end

func main:
    mut u := User { name = "ali", age = 30, active = true }
    u.addr = Addr { city = "tehran", zip = 11 }
    u.tags.push("x")
    u.tags.push("y")
    text := json.Marshal(u)
    println text

    mut back := User {}
    mut err := encerr.NoError()
    println json.Unmarshal(text, back, err)
    println back.name
    println back.age
    println back.active
    println back.addr.city
    println back.addr.zip
    println back.tags.get(1)
    println err.kind
    println json.Marshal(back) == text

    // A failure has to report itself through the same reference parameter.
    mut bad := User {}
    mut berr := encerr.NoError()
    println json.Unmarshal("{\"name\":", bad, berr)
    println encerr.IsError(berr)
    println berr.position
end
