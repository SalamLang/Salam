import encoding.json

struct Addr:
    pub city: str = ""
    pub zip: int = 0
end

struct User:
    pub name: str = ""
    pub age: int = 0
    pub active: bool = false
    pub addr: Addr = Addr {}
    pub tags: Vector<str> = Vector {} as Vector<str>
    pub next: User* = null
end

func decodes<T>(text: str, out &: T): bool:
    try:
        json.Unmarshal(text, out)
    catch:
        ret false
    end
    ret true
end

func main:
    mut u := User { name = "ali", age = 30, active = true }
    u.addr = Addr { city = "tehran", zip = 11 }
    u.tags.Push("x")
    u.tags.Push("y")
    text := json.Marshal(u)
    println text

    mut back := User {}
    println decodes(text, back)
    println back.name
    println back.age
    println back.active
    println back.addr.city
    println back.addr.zip
    println back.tags.Get(1)
    println json.Marshal(back) == text

    mut bad := User {}
    try:
        json.Unmarshal("{\"name\":", bad)
        println "decoded"
    catch e:
        println e.kind_name()
        println e.offset
        println e.line, e.column
    end
end
