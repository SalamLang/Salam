layout Home(user: str, lucky: int, items: Vector<str>, admin: bool):
    title = "Hi " + user
    heading: size = 1 content = "Welcome, " + user end
    paragraph: content = "Lucky number: " + lucky * 2 end
    if lucky > 50:
        paragraph: content = "Big!" color = "green" end
    else lucky > 10:
        paragraph: content = "Medium" end
    else:
        paragraph: content = "Small" end
    end
    list:
        each i, it in items:
            item: content = i + ": " + it end
        end
    end
    input: type = "checkbox" checked = admin end
end

func main:
    mut xs := Vector {} as Vector<str>
    xs.push("<script>alert(1)</script>")
    xs.push("b & c")
    println Home("Ali", 70, xs, true)
    println Home("<Sara>", 20, xs, false)
    println Home("Reza", 3, xs, false)
    xs.free()
end
