import str
import web

page Card(name: str, where: str):
    title = "Card " + name
    paragraph:
        title = name
        content = name
        font = name
    end
    sidebar menu button:
        url = where
        content = name
    end
end

page Numbers(whole: i64, part: f64, flag: bool):
    sidebar menu button:
        url = whole
        content = "whole"
    end
    sidebar menu button:
        url = part
        content = "part"
    end
    sidebar menu button:
        url = flag
        content = "flag"
    end
end

func main:
    html := Card(
        "</script></style><img src=x onerror=window.pwned=1>", " \tjava\nscript:window.pwned=2"
    )
    println str.Contains(html, "</script></style><img")
    println str.Contains(html, "&lt;/script&gt;&lt;/style&gt;&lt;img")
    println str.Contains(html, "<\\/script><\\/style>")
    println str.Contains(html, "script:window.pwned=2")
    println str.Contains(html, "href=\"#\"")
    println str.Contains(
        Card("x", "https://example.com/a?b=1&c=2"), "href=\"https://example.com/a?b=1&amp;c=2\""
    )
    numbers := Numbers(7000000000, 2.5, true)
    println str.Contains(numbers, "href=\"7000000000\"")
    println str.Contains(numbers, "href=\"2.5\"")
    println str.Contains(numbers, "href=\"true\"")
end
