import str

component Badge(label: str):
    box:
        padding = 8
        if page.compact:
            padding = 2
        end
        content = label
    end
end

page Home(n: int):
    Badge: label = "n " + n end
    box:
        if page.dark:
            color = "white"
        end
        content = "x"
    end
end

func main:
    html := Home(3)
    println str.Contains(html, "@media (width < 600px)")
    println str.Contains(html, "@media (prefers-color-scheme: dark)")
    println str.Contains(html, "n 3")
end
