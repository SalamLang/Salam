import str

func body(html: str): str:
    ret str.Substr(html, str.Find(html, "<body>"), str.Len(html) - str.Find(html, "<body>"))
end

page Inbox(user: str, subjects: Vector<str>):
    if subjects.IsEmpty():
        paragraph:
            content = "No new messages for " + user
        end
    else:
        paragraph:
            content = "Unread: " + subjects.Len()
        end
        each i, s in subjects:
            box:
                key = i
                content = (i + 1) + ". " + s
            end
        end
    end
end

func main:
    mut subjects := Vector {} as Vector<str>
    defer subjects.Free()
    println body(Inbox("Sara", subjects))
    subjects.Push("Meeting at 10")
    subjects.Push("<b>FREE</b> prize & more")
    println body(Inbox("Sara", subjects))
end
