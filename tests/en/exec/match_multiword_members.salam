enum Status:
    waiting, being packed, out for delivery
end

enum Shape:
    Unit Circle,
    Big Square(side: int)
end

func label(s: Status): str:
    ret match s:
        waiting: "w" end
        Status.being packed: "bp" end
        out for delivery: "ofd" end
    end
end

func area(s: Shape): int:
    match s:
        Unit Circle:
            ret 1
        end
        Big Square(n):
            ret n * n
        end
    end
    ret 0
end

func kind(s: Shape): str:
    match s:
        Shape.Big Square whole:
            ret "big " + whole.side
        end
        else:
            ret "other"
        end
    end
end

func main:
    println label(Status.waiting), label(Status.being packed), label(Status.out for delivery)
    println area(Shape.Unit Circle), area(Shape.Big Square(3))
    println kind(Shape.Big Square(4)), kind(Shape.Unit Circle)
    println Shape.Big Square(2), Shape.Big Square(2) == Shape.Big Square(2)
    c := Shape.Big Square(5)
    d := c.copy()
    println d
end
