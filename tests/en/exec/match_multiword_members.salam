enum Status:
    waiting, being_packed, out_for_delivery
end

enum Shape:
    Unit_Circle, Big_Square(side: int)
end

func label(s: Status): str:
    ret match s:
        waiting: "w" end
        Status.being_packed: "bp" end
        out_for_delivery: "ofd" end
    end
end

func area(s: Shape): int:
    match s:
        Unit_Circle:
            ret 1
        end
        Big_Square(n):
            ret n * n
        end
    end
    ret 0
end

func kind(s: Shape): str:
    match s:
        Shape.Big_Square whole:
            ret "big " + whole.side
        end
        else:
            ret "other"
        end
    end
end

func main:
    println label(Status.waiting), label(Status.being_packed), label(Status.out_for_delivery)
    println area(Shape.Unit_Circle), area(Shape.Big_Square(3))
    println kind(Shape.Big_Square(4)), kind(Shape.Unit_Circle)
    println Shape.Big_Square(2), Shape.Big_Square(2) == Shape.Big_Square(2)
    c := Shape.Big_Square(5)
    d := c.Copy()
    println d
end
