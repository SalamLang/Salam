func main:
    mut a := 1
    a = 2
    println a

    mut b := 5
    if b > 3:
        b = 30
    end
    println b

    mut s := 0
    repeat 4 with k:
        s += k
    end
    println s

    mut c := 9
    c++
    println c
end
