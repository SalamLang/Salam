package main

extern:
    func abs(x: int): int
end

struct Ops:
    pub un: extern func (int) int
end

export:
    func fpx_twice(x: int): int:
        ret x * 2
    end
end

func through_param(f: extern func (int) int, v: int): int:
    ret f(v)
end

func main:
    raw := (&abs) as i64
    la := raw as void* as extern func (int) int
    println la(0 - 7)
    println through_param(la, 0 - 9)
    ops := Ops { un = la }
    println ops.un(0 - 11)
    rt := (&fpx_twice) as i64
    tw := rt as void* as extern func (int) int
    println tw(21), through_param(tw, 5)
    o2 := Ops { un = tw }
    println o2.un(8)
end
