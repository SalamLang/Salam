package main

import mem

extern:
    func strchr(text: str, c: int): str
    func strncmp(a: str, b: str, n: usize): int
    func strtol(text: str, stop: void*, base: int): int
    func pow(x: f64, y: f64): f64
    func atan2(y: f64, x: f64): f64
    func ldexp(x: f64, e: int): f64
    func frexp(x: f64, e: int*): f64
end

if SALAM_OS_WINDOWS:
    extern:
        func _abs64(x: i64): i64
        func _jn(n: int, x: f64): f64
        func _snprintf(out: void*, size: usize, format: str, a: f64, b: int, c: f64, d: int, e: f64): int
    end
else:
    extern:
        func llabs(x: i64): i64
        func jn(n: int, x: f64): f64
        func tmpfile(): void*
        func fileno(fp: void*): int
        func fclose(fp: void*): int
        func modf(x: f64, whole &: f64): f64
    end
end

if SALAM_OS_LINUX:
    extern:
        func lseek64(fd: int, offset: i64, whence: int): i64
    end
else SALAM_OS_MAC:
    extern:
        func lseek(fd: int, offset: i64, whence: int): i64
    end
end

if not (SALAM_OS_WINDOWS and SALAM_ARCH_X86):
    extern:
        func powf(x: f32, y: f32): f32
        func atan2f(y: f32, x: f32): f32
    end
end

if SALAM_OS_WINDOWS:
    func abs_ptr(): void*:
        ret &_abs64
    end

    func bessel_ptr(): void*:
        ret &_jn
    end

    func floats_on_stack():
        buf := mem.AllocateZeroed(64 as u64)
        f := (&_snprintf) as extern func (void*, usize, str, f64, int, f64, int, f64) int
        println f(buf, 64 as usize, "%.1f %d %.1f %d %.1f", 1.5, 7, 2.5, 8, 3.5)
        println buf as str
        mem.Free(buf)
    end

    func wide_in_the_middle():
        println 5
    end

    func ref_argument():
        println 0.5, 2
    end
else:
    func abs_ptr(): void*:
        ret &llabs
    end

    func bessel_ptr(): void*:
        ret &jn
    end

    func floats_on_stack():
        println 15
        println "1.5 7 2.5 8 3.5"
    end

    func wide_in_the_middle():
        fp := tmpfile()
        if SALAM_OS_LINUX:
            seek := (&lseek64) as extern func (int, i64, int) i64
            println seek(fileno(fp), 5 as i64, 0)
        else:
            seek := (&lseek) as extern func (int, i64, int) i64
            println seek(fileno(fp), 5 as i64, 0)
        end
        fclose(fp)
    end

    func ref_argument():
        mut whole := 0.0
        println modf(2.5, whole), whole
    end
end

if SALAM_OS_WINDOWS and SALAM_ARCH_X86:
    func single_floats():
        println 1024, 785
    end
else:
    func single_floats():
        pw := (&powf) as extern func (f32, f32) f32
        at := (&atan2f) as extern func (f32, f32) f32
        println pw(2.0 as f32, 10.0 as f32), ((at(1.0 as f32, 1.0 as f32) as f64) * 1000.0) as int
    end
end

func main:
    sc := (&strchr) as extern func (str, int) str
    println sc("hello", 108)
    sn := (&strncmp) as extern func (str, str, usize) int
    println sn("abcd", "abcf", 3 as usize), sn("abcd", "abcf", 4 as usize) < 0
    sl := (&strtol) as extern func (str, void*, int) int
    println sl("ff", null, 16), sl("-12", null, 10)
    wa := abs_ptr() as extern func (i64) i64
    println wa(0 - (123456789012 as i64))
    pw := (&pow) as extern func (f64, f64) f64
    println pw(2.0, 10.0)
    at := (&atan2) as extern func (f64, f64) f64
    println (at(1.0, 1.0) * 1000.0) as int
    le := (&ldexp) as extern func (f64, int) f64
    println le(1.5, 4)
    fe := (&frexp) as extern func (f64, int*) f64
    ex := mem.AllocateZeroed(8 as u64) as int*
    println fe(12.0, ex), ex[0]
    mem.Free(ex as void*)
    bj := bessel_ptr() as extern func (int, f64) f64
    println (bj(2, 1.5) * 1000.0) as int
    single_floats()
    floats_on_stack()
    wide_in_the_middle()
    ref_argument()
end
