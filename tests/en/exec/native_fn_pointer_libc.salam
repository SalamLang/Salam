package main

import mem

if SALAM_OS_LINUX:
    extern:
        func abs(x: int): int
        func strlen(text: str): usize
        func sqrt(x: f64): f64
        func strtol(text: str, stop: void*, base: int): int
        func memset(out: void*, c: int, n: usize): void*
        func pow(x: f64, y: f64): f64
        func ldexp(x: f64, e: int): f64
        func powf(x: f32, y: f32): f32
        func modf(x: f64, whole &: f64): f64
        func socket(family: int, kind: int, proto: int): int
        func bind(fd: int, addr: void*, addr_len: int): int
        func getsockname(fd: int, addr: void*, addr_len: int*): int
        func sendto(fd: int, data: str, n: usize, flags: int, addr: void*, addr_len: int): int
        func recvfrom(fd: int, out: void*, n: usize, flags: int, addr: void*, addr_len: void*): int
        func close(fd: int): int
    end

    func one_argument():
        ab := (&abs) as extern func (int) int
        println ab(0 - 7)
        sl := (&strlen) as extern func (str) usize
        println sl("hello")
        sq := (&sqrt) as extern func (f64) f64
        println sq(16.0)
    end

    func three_arguments():
        st := (&strtol) as extern func (str, void*, int) int
        println st("ff", null, 16)
        ms := (&memset) as extern func (void*, int, usize) void*
        buf := mem.AllocateZeroed(8 as u64)
        ms(buf, 65, 3 as usize)
        println buf as str
        mem.Free(buf)
    end

    func float_arguments():
        pw := (&pow) as extern func (f64, f64) f64
        println pw(2.0, 10.0)
        le := (&ldexp) as extern func (f64, int) f64
        println le(1.5, 4)
        pf := (&powf) as extern func (f32, f32) f32
        println pf(2.0 as f32, 10.0 as f32)
    end

    func loopback_address(): void*:
        addr := mem.AllocateZeroed(16 as u64)
        bytes := addr as u8*
        bytes[0] = 2 as u8
        bytes[4] = 127 as u8
        bytes[7] = 1 as u8
        ret addr
    end

    func six_arguments():
        fd := socket(2, 2, 0)
        addr := loopback_address()
        addr_len := mem.AllocateZeroed(8 as u64) as int*
        addr_len[0] = 16
        if fd < 0 or bind(fd, addr, 16) != 0 or getsockname(fd, addr, addr_len) != 0:
            println 5
            println 5, "hello"
        else:
            so := (&sendto) as extern func (int, str, usize, int, void*, int) int
            println so(fd, "hello", 5 as usize, 0, addr, 16)
            rf := (&recvfrom) as extern func (int, void*, usize, int, void*, void*) int
            out := mem.AllocateZeroed(16 as u64)
            println rf(fd, out, 15 as usize, 0, null, null), out as str
            mem.Free(out)
        end
        if fd >= 0:
            close(fd)
        end
        mem.Free(addr_len as void*)
        mem.Free(addr)
    end

    func by_reference():
        mut whole := 0.0
        println modf(2.5, whole), whole
    end
else:
    func one_argument():
        println 7
        println 5
        println 4
    end

    func three_arguments():
        println 255
        println "AAA"
    end

    func float_arguments():
        println 1024
        println 24
        println 1024
    end

    func six_arguments():
        println 5
        println 5, "hello"
    end

    func by_reference():
        println 0.5, 2
    end
end

func main:
    one_argument()
    three_arguments()
    float_arguments()
    six_arguments()
    by_reference()
end
