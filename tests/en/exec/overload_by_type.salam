struct Box:
    v: str = "box"

    pub func text(): str:
        ret this.v
    end
end

func show(n: int): str:
    ret "int " + n
end

func show(b: Box): str:
    ret "box " + b.text()
end

func show(s: str): str:
    ret "str " + s
end

func main:
    println show(3)
    println show(Box {})
    println show("x")
end
