import encoding.json

include l "../general/_pkg_enum_lib.salam"
include s "../general/_pkg_enum_json_lib.salam"

enum Tone:
    Bright, Dim, Soft, Loud, Extra
end

struct Inner:
    pub t: l.Tone = l.Tone.Soft
end

struct Doc:
    pub t: l.Tone = l.Tone.Soft
    pub own: Tone = Tone.Bright
    pub other: s.Tone = s.Tone.Quiet
    pub inner: Inner = Inner {}
    pub many: Vector<l.Tone> = Vector {}
    pub named: HashMap<str, l.Tone> = HashMap {}
    pub opt: l.Tone? = null
    pub shape: l.Shape = l.Shape.Empty
    pub need: int = 0
    rule t == l.Tone.Loud needs need
end

func decode(text: str):
    mut d := Doc {}
    try:
        json.Unmarshal(text, d)
    catch e:
        println "err", e.message
        ret
    end
    println d.t as int, d.own as int, d.other as int, d.inner.t as int
    println d.many.Get(1) as int, d.named.Get("a") as int, d.opt.unwrap() as int, d.shape
    println json.Marshal(d)
end

func main:
    decode(`{"t":"Loud","own":"Extra","other":"Mid","inner":{"t":"Loud"},"many":["Soft","Loud"],"named":{"a":"Loud"},"opt":"Loud","shape":{"Circle":{"r":2}},"need":1}`)
    decode(`{"t":"Nope"}`)
    decode(`{"t":"Loud","own":"Extra","other":"Mid","inner":{"t":"Loud"},"many":[],"named":{},"opt":"Loud","shape":"Empty"}`)
    mut v := Vector {} as Vector<s.Pair>
    try:
        json.Unmarshal(`[{"a":"Loud","m":"Wild"}]`, v)
    catch e:
        println "err", e.message
    end
    println v.Get(0).a as int, json.Marshal(v)
    p := s.Decode(`{"a":"Loud","m":"Wild"}`)
    println p.a as int, s.MoodNum(p), s.Encode(p)
    w := s.DecodeWrap(`{"p":{"a":"Mid","m":"Wild"},"n":3}`)
    println w.p.a as int, w.n
end
