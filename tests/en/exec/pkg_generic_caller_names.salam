include genshadowb "_genshadow_b.salam"
include genshadowa "_genshadow_a.salam"

mut hits := 0

func _name(): str:
    ret "main"
end

func _on(x: i64):
    hits = hits + 1
    println "main on", x, hits
end

func main:
    println genshadowb.Get(1), genshadowb.Ok(genshadowb.Socket { fd = 1 })
    println genshadowa.Show(1), genshadowa.Show("s"), _name(), hits
    genshadowa.Fire(1)
    callhandler(_on, 2)
    b := genshadowa.Box { v = 1 } as genshadowa.Box<int>
    println b.label(), b.check()
end
