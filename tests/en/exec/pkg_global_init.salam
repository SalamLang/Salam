// A package global with a non-constant initialiser. Only the main module's
// were ever run - every imported package's were emitted and then dropped, so
// the global kept its zero value and the failure surfaced far from the cause.
package main

import pkginit "_pkginit.salam"

mut g_main := twice(10)

func twice(x: int): int:
    ret x * 2
end

func main:
    println pkginit.N()
    println pkginit.Add("a"), pkginit.Add("b")
    println g_main
end
