// & binds tighter than ^, which binds tighter than |, and all three
// are left-associative.

func main:
    println 1 | 2 & 3
    println (1 | 2) & 3
    println 1 | (2 & 3)
    println 8 | 4 ^ 12
    println (8 | 4) ^ 12
    println 12 ^ 10 & 6
    println 12 ^ (10 & 6)
    println 1 | 2 ^ 4 & 12
    println 15 & 12 & 10
    println 1 | 2 | 4
    println 15 ^ 12 ^ 10
end
