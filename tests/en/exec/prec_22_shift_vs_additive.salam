// The shifts bind looser than + - * / %, so the whole arithmetic
// expression on the right becomes the shift count.

func main:
    println 1 << 4 + 1
    println (1 << 4) + 1
    println 2 << 1 + 2
    println (2 << 1) + 2
    println 96 >> 2 * 2
    println (96 >> 2) * 2
    println 1 << 8 / 2
    println (1 << 8) / 2
    println 1 << 3 - 1
    println (1 << 3) - 1
    println 256 >> 9 % 4
    println (256 >> 9) % 4
end
