// The shifts bind tighter than & ^ |, so a shifted mask needs no
// parentheses on the shift side.

func main:
    println 1 << 2 | 1
    println (1 << 2) | 1
    println 3 & 1 << 2
    println 3 & (1 << 2)
    println 6 ^ 1 << 1
    println 6 ^ (1 << 1)
    println 1 << 3 | 1 << 1
    println 255 & 15 << 4
    println 255 & (15 << 4)
    println 12 >> 2 | 3 << 2
end
