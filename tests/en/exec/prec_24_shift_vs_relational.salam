// The shifts bind tighter than the comparisons, so a shifted value can
// be compared directly.

func main:
    println 1 << 3 > 4
    println 1 << 3 < 4
    println 16 >> 2 == 4
    println 16 >> 2 != 4
    println 1 << 2 <= 4
    println 1 << 2 >= 5
    println 2 << 3 > 1 << 2
    println (2 << 3) > (1 << 2)
end
