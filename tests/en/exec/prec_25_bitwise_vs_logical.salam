func main:
    println (1 & 1) == 1 and (2 | 4) == 6
    println (1 & 2) == 0 or (2 & 4) == 1
    println (3 & 1) == 1 and (3 | 4) == 7 or false
    println false or (3 ^ 1) == 2 and true
    println ((5 & 4) != 0) and ((5 & 1) != 0)
    println ((5 & 4) != 0) or ((5 & 2) != 0)
    println not ((5 & 2) != 0)
    println (0 | 0) == 0 or (1 & 1) == 1
end
