// & ^ | all bind tighter than && and ||, and && binds tighter than ||.

func main:
    println (1 & 1) == 1 && (2 | 4) == 6
    println (1 & 2) == 0 || (2 & 4) == 1
    println (3 & 1) == 1 && (3 | 4) == 7 || false
    println false || (3 ^ 1) == 2 && true
    println ((5 & 4) != 0) && ((5 & 1) != 0)
    println ((5 & 4) != 0) || ((5 & 2) != 0)
    println !((5 & 2) != 0)
    println (0 | 0) == 0 || (1 & 1) == 1
end
