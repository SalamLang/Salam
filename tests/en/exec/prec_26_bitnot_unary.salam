// Unary ~ and - bind tighter than every binary operator, so they take
// only the immediately following operand.

func main:
    println ~3 & 15
    println ~(3 & 15)
    println ~1 + 1
    println ~(1 + 1)
    println -4 >> 1
    println -(4 >> 1)
    println ~0 ^ 5
    println ~(0 ^ 5)
    println ~2 * 3
    println ~(2 * 3)
    println ~~7
    println -~7
    println ~-7
end
