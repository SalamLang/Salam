// Assignment is the loosest operator, so the entire right-hand side is
// evaluated before the compound bit-assignment applies.

func main:
    mut a := 0xF0
    a |= 1 << 2 | 1
    println a
    mut b := 0xFF
    b &= 0x0F | 0x30
    println b
    mut c := 0b1100
    c ^= 0b1010 & 0b1110
    println c
    mut d := 8
    d <<= 1 + 2
    println d
    mut e := 1024
    e >>= 8 / 4
    println e
    mut f := 0b1111
    f &= ~0b0101
    println f
    mut g := 1
    g <<= 2
    g |= 1
    g ^= 8
    g &= 0xFE
    g >>= 1
    println g
end
