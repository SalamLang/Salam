func main:
    println 1 | 2 ^ 3 & 4 + 5 * 2 >> 1
    println 1 | (2 ^ (3 & ((4 + (5 * 2)) >> 1)))
    println ~1 & 3 | 4 ^ 2 << 1
    println ((~1) & 3) | (4 ^ (2 << 1))
    println (2 ^^ 3 as int) | 1
    println (7 & 3) == 3
    println (7 & 8) == 0
    println 1 << 2 == 4 && 8 >> 1 == 4 || false
    println ((1 << 2) == 4) && ((8 >> 1) == 4) || false
    mut x := 5
    x |= 3 & 6 ^ 1 << 3
    println x
end
