func first_or(v: Vector<int>, d: int): int:
    if v.Len() == 0:
        ret d
    end
    ret v.Get(0)
end

func last_differs(v: Vector<int>, x: int): bool:
    ret v.Len() == 0 or v.Get(v.Len() - 1) != x
end

func both(v: Vector<int>): bool:
    ret v.Len() > 2 and v.Get(2) == 7
end

func main:
    mut seen := Vector {} as Vector<int>
    each x in [3, 3, 4, 4, 5]:
        if seen.Len() == 0 or seen[0] != x:
            seen.Push(x)
        end
        if last_differs(seen, x):
            seen.Push(x)
        end
    end
    println seen.Len(), first_or(seen, 9), both(seen)
    mut empty := Vector {} as Vector<int>
    println first_or(empty, 9), last_differs(empty, 1)
    mut q := Vector {} as Vector<int>
    q.Push(1)
    q.Push(2)
    mut i := 0
    until i < q.Len():
        println q.Get(i)
        i++
    end
    seen.Free()
    empty.Free()
    q.Free()
end
