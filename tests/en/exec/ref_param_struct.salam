package main

struct Key:
    pub ok: bool = false
    pub n: int = 0
end

struct Session:
    pub key: Key = Key {}
end

func mk(n: int): Key:
    ret Key { ok = true, n = n }
end

func whole(k &: Key, n: int):
    k = mk(n)
end

func field(k &: Key):
    k.ok = true
end

func through(k &: Key, n: int):
    whole(k, n)
end

func main:
    mut a := Key {}
    whole(a, 7)
    println a.ok, a.n

    mut b := Key {}
    field(b)
    println b.ok, b.n

    mut c := Key {}
    through(c, 9)
    println c.ok, c.n

    mut s := Session {}
    whole(s.key, 11)
    println s.key.ok, s.key.n

    arr: Key[2]
    whole(arr[1], 13)
    println arr[1].ok, arr[1].n
end
