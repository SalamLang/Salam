struct Grid:
    pub rows: int = 3
    pub cols: int = 2
end

struct Board:
    pub size: Grid = Grid {}
    pub lo: int = 1
    pub hi: int = 4
    pub stride: int = 2
    pub func total(): int: ret this.hi end
end

func main:
    g := Grid {}
    repeat g.rows with i:
        print i
    end
    println ""

    b := Board {}
    repeat b.size.cols with j:
        print j
    end
    println ""

    repeat b.lo to b.hi with k:
        print k
    end
    println ""

    repeat b.lo to b.hi by b.stride with m:
        print m
    end
    println ""

    repeat b.total() with n:
        print n
    end
    println ""

    repeat g.cols:
        print "*"
    end
    println ""

    nested := [Grid {}, Grid {}]
    repeat nested[1].rows with q:
        print q
    end
    println ""
end
