func main:
    mut c := 0
    repeat 1 to 5:
        c += 1
    end
    println c

    mut s := 0
    repeat 1 to 100 by 10:
        s += 1
    end
    println s

    repeat 9 to 7 with i:
        print i
    end
    println "done"
end
