func main:
    mut t := 0
    repeat 4:
        t += 1
    end
    println t

    mut e := 0
    repeat 2 to 8 by 2:
        e += 1
    end
    println e

    mut o := 0
    repeat 0 to 10 by 3:
        o += 1
    end
    println o
end
