extern:
    noret func salam_panic(msg: str)
end

mut calls := 0

enum Result<T, E>:
    Ok(value: T)
    Err(error: E)
end

func IsOk<T, E>(r: Result<T, E>): bool:
    ret match r:
        Ok(_): true end
        Err(_): false end
    end
end

func IsErr<T, E>(r: Result<T, E>): bool:
    ret not IsOk(r)
end

func UnwrapOr<T, E>(r: Result<T, E>, fallback: T): T:
    ret match r:
        Ok(v): v end
        Err(_): fallback end
    end
end

func Expect<T, E>(r: Result<T, E>, msg: str): T:
    match r:
        Ok(v):
            ret v
        end
        Err(_):
            salam_panic(msg)
        end
    end
end

func parse(s: str): Result<int, str>:
    calls++
    if s == "7":
        ret Result.Ok(7)
    end
    if s == "9":
        ret Result.Ok(9)
    end
    ret Result.Err("bad " + s)
end

func sum(a: str, b: str): Result<int, str>:
    defer println "leaving sum"
    x := parse(a)?
    mut y := 0
    y = parse(b)?
    ret Result.Ok(x + y)
end

func check(a: str): Result<bool, str>:
    parse(a)?
    ret Result.Ok(true)
end

func helpers():
    a := parse("7")
    b := parse("q")
    println IsOk(a)
    println IsErr(b)
    println UnwrapOr(b, 0)
    println Expect(a, "no")
end

func main:
    helpers()
    println sum("7", "9")
    println sum("7", "q")
    println sum("z", "9")
    println check("7")
    println check("x")
    println calls
end
