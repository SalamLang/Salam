include sp "_spelling_lib.salam"

func BuildName(): str:
    ret "salam"
end

func main:
    mut c := sp.Counter {}
    println sp.parse_header("abcd")
    println build_name()
    c.add_item(3)
    c.AddItem(4)
    println c.n
    println sp.total(), sp.Total()
end
