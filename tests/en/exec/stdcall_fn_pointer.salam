package main

if SALAM_OS_WINDOWS:
    extern:
        func GetModuleHandleA(name: str): void*
        func GetProcAddress(mod: void*, name: str): void*
    end
end

struct Api:
    pub len: extern stdcall func (str) int
end

if SALAM_OS_WINDOWS:
    func lookup(name: str): void*:
        ret GetProcAddress(GetModuleHandleA("kernel32.dll"), name)
    end
else:
    export:
        func sfp_muldiv(a: int, b: int, c: int): int:
            ret a * b / c
        end

        func sfp_sleep(ms: int):
            _ms := ms
        end

        func sfp_lstrlen(text: str): int:
            ret text.len()
        end

        func sfp_tick(): u32:
            ret 1
        end

        func sfp_module(_name: str): void*:
            ret null
        end
    end

    func lookup(name: str): void*:
        if name == "MulDiv":
            ret &sfp_muldiv
        end
        if name == "Sleep":
            ret &sfp_sleep
        end
        if name == "lstrlenA":
            ret &sfp_lstrlen
        end
        if name == "GetTickCount":
            ret &sfp_tick
        end
        ret &sfp_module
    end
end

func work(n: int, md: extern stdcall func (int, int, int) int, nap: extern stdcall func (int)): int:
    mut total := 0
    repeat n in i:
        nap(0)
        total = total + md(i, 6, 3)
    end
    ret total
end

func main:
    md := lookup("MulDiv") as extern stdcall func (int, int, int) int
    nap := lookup("Sleep") as extern stdcall func (int)
    println md(0 - 7, 10, 2), md(7, 10, 2)
    println work(100, md, nap)
    api := Api { len = lookup("lstrlenA") as extern stdcall func (str) int }
    println api.len("salam")
    tick := lookup("GetTickCount") as extern stdcall func () u32
    println tick() != (0 as u32)
    module := lookup("GetModuleHandleA") as extern stdcall func (str) void*
    println module("no-such-module.dll") == null
end
