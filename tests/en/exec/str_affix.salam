func main:
    s := "salam donya"
    println s.StartsWith("salam")
    println s.StartsWith("donya")
    println s.EndsWith("donya")
    println s.EndsWith("salam")
    println s.Includes("am do")
    println s.Includes("xyz")
    println s.StartsWith("")
    println s.EndsWith("")
    println "ab".EndsWith("abc")
    println "سلام دنیا".StartsWith("سلام")
    println "سلام دنیا".EndsWith("دنیا")
    if s.Includes("don") and not s.EndsWith("x"):
        println "ok"
    end
end
