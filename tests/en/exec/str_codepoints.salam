import str

func main:
    s := "سلام world"
    c := u'س'
    println c, s.CharAt(0) == c, s.CharAt(1) == u'س', u'ل' == s.CharAt(1)
    mut vowels := 0
    repeat s.CharCount() in i:
        switch s.CharAt(i):
            u'ا', "o":
                vowels++
                break
            end
        end
    end
    println vowels
    cps := str.CodePoints(s)
    println cps.Len(), cps.Get(0), cps.Get(4), cps.Get(cps.Len() - 1)
    cps.Set(0, 0x0634)
    println str.FromCodePoints(cps)
    mut bad := Vector {} as Vector<int>
    bad.Push(65)
    bad.Push(0 - 5)
    bad.Push(0x110000)
    bad.Push(0x1F44B)
    println str.FromCodePoints(bad)
    println str.AllAscii("hello, world"), str.AllAscii(s), str.AllAscii("")
    println str.CodePoints("").Len(), str.FromCodePoints(str.CodePoints("a👋ب")) == "a👋ب"
end
