func main:
    s := "سلام hi 👋!"
    println s.char_count()
    println s.char_at(0)
    println s.char_at(3)
    println s.char_at(8)
    println "[" + s.char_at(10) + "]"
    println "[" + s.char_at(0 - 1) + "]"
    println s.char_substr(0, 4)
    println s.char_substr(5, 2)
    println s.char_substr(7, 100)
    println "[" + s.char_substr(50, 2) + "]"
    println s.char_substr(0 - 3, 2)
    println "[" + s.char_substr(2, 0 - 1) + "]"
    println s.char_find("hi")
    println s.char_find("👋")
    println s.char_find("xyz")
    println s.char_find("")
    println "".char_count()
    println "abc".char_count()
    n := s.char_count()
    mut out := ""
    repeat n in i:
        out = out + s.char_at(n - 1 - i)
    end
    println out
end
