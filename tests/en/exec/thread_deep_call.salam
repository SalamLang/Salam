package main

func depth(n: int): int:
    if n == 0:
        ret 0
    end
    ret 1 + depth(n - 1)
end

func work(_arg: void*):
    println depth(150)
end

func main:
    t := spawn(work, null)
    join(t)
    println "done"
end
