func num(text: str): int throws:
    if text == "" or text == "x":
        throw Error.New(ErrorKind.Syntax, "not a number: '" + text + "'")
    end
    ret text.to_int()
end

func add(a: int, b: int): int:
    ret a + b
end

func sum3(a: str, b: str, c: str): int throws:
    ret add(try num(a), try num(b)) + try num(c)
end

func find_big(xs: Vector<str>): int:
    mut found := 0 - 1
    each i, x in xs:
        try:
            v := num(x)
            if v > 100:
                found = i
                break
            end
        catch:
            println "bad item " + i
        end
    end
    ret found
end

func classify(xs: Vector<str>): int:
    mut total := 0
    try:
        each x in xs:
            switch num(x):
                0:
                    println "zero"
                    break
                end
                else:
                    total += 1
                end
            end
        end
        throw "done early"
    catch e:
        println "classify stopped: " + e.message
    end
    ret total
end

func nested(a: str, b: str): str:
    try:
        x := num(a)
        try:
            y := num(b)
            ret "both " + (x + y)
        catch inner:
            ret "inner " + inner.message
        end
    catch outer:
        ret "outer " + outer.message
    end
end

func main:
    try:
        println sum3("1", "2", "3")
        println sum3("1", "x", "3")
    catch e:
        println e.to_str()
    end
    mut xs := Vector {} as Vector<str>
    xs.push("5")
    xs.push("x")
    xs.push("500")
    xs.push("7")
    println find_big(xs)
    mut ys := Vector {} as Vector<str>
    ys.push("1")
    ys.push("0")
    ys.push("x")
    ys.push("9")
    println classify(ys)
    println nested("1", "2")
    println nested("1", "x")
    println nested("", "2")
    n := try num("x") catch 0 - 1
    println n
    k := add(1, try num("41") catch 0)
    println k
end
