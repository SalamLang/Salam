func divmod(a: int, b: int): (int, int):
    ret a / b, a % b
end

func pair(): (int, str):
    ret 7, "seven"
end

func main:
    q, r := divmod(17, 5)
    println q, r
    n, name := pair()
    println n, name
    t := divmod(9, 4)
    println t.f0, t.f1
    x, _ := divmod(100, 7)
    println x
    mut p, mut z := divmod(3, 2)
    p += 10
    z += 20
    println p, z
    a, b := 1, "x"
    println a, b
end
