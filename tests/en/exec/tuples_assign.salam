func two(): (int, str):
    ret 1, "a"
end

func tri(): ((int, int), str):
    ret (4, 5), "n"
end

func main:
    t := two()
    println t.0, t.1
    w := tri()
    println w.0.1, w.1, w.0.0
    mut a := 1
    mut b := 2
    a, b = b, a
    println a, b
    mut xs := [10, 20, 30]
    xs[0], xs[2] = xs[2], xs[0]
    println xs[0], xs[1], xs[2]
    mut n := 0
    mut s := ""
    n, s = two()
    println n, s
    _, s = two()
    println s
end
