func swap pair<A, B>(p: (A, B)): (B, A):
    a, b := p
    ret b, a
end

func first<A, B>(p: (A, B)): A:
    x, _ := p
    ret x
end

func main:
    s, n := swap pair((1, "one"))
    println s, n
    f, g := swap pair(("two", 2.5))
    println f, g
    println first((9, true)), first(("k", 1))
    base, step := 10, 3
    add := (k: int): ret base + step * k end
    println add(2)
    mut total := 0
    repeat 3 in i:
        lo, hi := i, i * 2
        total += lo + hi
    end
    println total
end
