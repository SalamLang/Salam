package main

func main:
    mut i := 0
    until i < 3:
        print "w", i, " "
        i++
    end
    println ""

    mut j := 3
    until j > 0:
        print "u", j, " "
        j--
    end
    println ""

    mut k := 0
    until true:
        k++
        if k == 2: break end
    end
    println k
end
