// Structs and fixed arrays are values on every backend: a new name, an
// assignment, a by-value parameter, a field and an element each get their
// own copy, while a Vector field keeps sharing its buffer.

struct Inner:
    pub v: int
end

struct Outer:
    pub in: Inner
    pub arr: int[3]
    pub tags: Vector<int>

    pub func bump(): void: this.in.v += 1 end
end

func modify(o: Outer): void:
    o.in.v = 99
    o.arr[0] = 99
end

func modify_arr(xs: int[3]): void:
    xs[0] = 77
end

func first(xs: int[3]): int:
    ret xs[0]
end

func main:
    mut o := Outer { in = Inner { v = 1 }, arr = [1, 2, 3], tags = Vector {} as Vector<int> }
    o.bump()
    println o.in.v
    modify(o)
    println o.in.v, o.arr[0]
    c := o
    o.bump()
    println c.in.v, o.in.v
    arr := [1, 2, 3]
    modify_arr(arr)
    println arr[0], first(arr)
    mut o2 := o
    o2.arr[0] = 50
    o2.in.v = 7
    println o.arr[0], o2.arr[0], o.in.v, o2.in.v
    holder := Outer { in = o.in, arr = o.arr, tags = o.tags }
    o.in.v = 123
    println holder.in.v
    pair := [o.in, c.in]
    o.in.v = 5
    println pair[0].v, pair[1].v
    mut row := o.arr
    row = c.arr
    row[1] = 0
    println c.arr[1], row[1]
    o.tags.free()
end
