func main:
    mut v := Vector {} as Vector<int or str>
    v.Push(5 as (int or str))
    x := v.Get(0)
    match x:
        int n:
            println n
        end
        str s:
            println s
        end
    end
    arr := [1 as (int or str), "x" as (int or str)]
    match arr[1]:
        int n:
            println n
        end
        str t:
            println t
        end
    end
    v.Free()
end
