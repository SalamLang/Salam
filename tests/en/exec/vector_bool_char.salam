// bool and char occupy one byte, so a Vector of them allocates one byte
// per element. The interpreter used to read and write those slots at
// pointer width, running eight bytes past a one-byte element and
// corrupting the allocator ("realloc(): invalid next size").

struct Grid:
    pub n: int = 0
    pub cells: Vector<bool> = Vector {}
end

func make_grid(n: int): Grid:
    mut g := Grid { n = n }
    repeat n * n: g.cells.push(false) end
    ret g
end

func light(g &: Grid, row: int, col: int): g.cells[row * g.n + col] = true end

func lit(g: Grid): int:
    mut n := 0
    each c in g.cells:
        if c: n = n + 1 end
    end
    ret n
end

func main:
    mut g := make_grid(4)
    defer g.cells.free()
    light(g, 0, 1)
    light(g, 2, 3)
    light(g, 3, 3)
    println g.cells[1], g.cells[0], g.cells[11], g.cells[15]
    println "lit", lit(g)

    // A plain Vector<bool>, written through both the index and push.
    mut flags := Vector {} as Vector<bool>
    defer flags.free()
    repeat 8: flags.push(false) end
    flags[3] = true
    flags[7] = true
    mut set_count := 0
    repeat flags.len() with i:
        if flags[i]: set_count = set_count + 1 end
    end
    println flags.len(), set_count, flags[3], flags[4]

    // Same story for char.
    mut cs := Vector {} as Vector<char>
    defer cs.free()
    cs.push('a')
    cs.push('b')
    cs.push('c')
    cs[1] = 'z'
    println cs.len(), cs[0], cs[1], cs[2]
end
