// A container of structs under the tree walker. std's Vector and HashMap are
// ordinary Salam: they really do allocate `count * sizeof(T)` bytes and index
// them, so an element of struct type only works if the interpreter lays the
// fields out in that memory the same way sizeof measures them. Reading a
// field off an element used to fail with "cannot access member".

struct Inner:
    pub n: int = 0
    pub flag: bool = false
end

struct Tag:
    pub name: str = ""
    pub weight: f64 = 0.0
    pub small: u8 = 0
    pub inner: Inner = Inner {}
end

func main:
    mut v := Vector {} as Vector<Tag>
    defer v.free()
    v.push(Tag { name = "ali", weight = 1.5, small = 200 as u8, inner = Inner { n = 7, flag = true } })
    v.push(Tag { name = "reza", weight = 2.5, small = 9 as u8 })

    println v.len()
    first := v.get(0)
    println first.name
    println first.weight
    println first.small
    println first.inner.n
    println first.inner.flag
    println v.get(1).name

    // Writes have to reach the bytes, not a copy of them.
    v.set(0, Tag { name = "sara", weight = 3.5, small = 1 as u8 })
    println v.get(0).name
    println v.get(0).weight
    println v.get(1).name

    // ref() hands back the element's address: a field written through it
    // stays written, the same as under a compiled backend.
    p := v.ref(1)
    p[0].name = "hasan"
    p[0].inner.n = 42
    println v.get(1).name
    println v.get(1).inner.n

    mut m := HashMap {} as HashMap<str, Tag>
    defer m.free()
    m.put("one", Tag { name = "first", small = 3 as u8 })
    println m.get("one").name
    println m.get("one").small
end
