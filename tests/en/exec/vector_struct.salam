struct Inner:
    pub n: int = 0
    pub flag: bool = false
end

struct Tag:
    pub name: str = ""
    pub weight: f64 = 0.0
    pub small: u8 = 0
    pub inner: Inner = Inner {}
end

func main:
    mut v := Vector {} as Vector<Tag>
    defer v.Free()
    v.Push(Tag { name = "ali", weight = 1.5, small = 200 as u8, inner = Inner { n = 7, flag = true } })
    v.Push(Tag { name = "reza", weight = 2.5, small = 9 as u8 })

    println v.Len()
    first := v.Get(0)
    println first.name
    println first.weight
    println first.small
    println first.inner.n
    println first.inner.flag
    println v.Get(1).name

    v.Set(0, Tag { name = "sara", weight = 3.5, small = 1 as u8 })
    println v.Get(0).name
    println v.Get(0).weight
    println v.Get(1).name

    p := v.Ref(1)
    p[0].name = "hasan"
    p[0].inner.n = 42
    println v.Get(1).name
    println v.Get(1).inner.n

    mut m := HashMap {} as HashMap<str, Tag>
    defer m.Free()
    m.Put("one", Tag { name = "first", small = 3 as u8 })
    println m.Get("one").name
    println m.Get("one").small
end
