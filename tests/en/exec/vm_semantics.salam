 * Repository: https://github.com/SalamLang/Salam
 *
 */

mut counter := 0

struct Pt:
    pub x: int = 3
    pub y: int = 4
    pub tag: str = "pt"

    pub func len2(): int:
        ret this.x * this.x + this.y * this.y
    end

    pub func + (o: Pt): Pt:
        ret Pt { x = this.x + o.x, y = this.y + o.y }
    end
end

struct Box:
    pub v: int = 0

    pub func len2(): int:
        ret this.v
    end
end

func bump(n: int):
    counter += n
end

func swap(a &: int, b &: int):
    t := a
    a = b
    b = t
end

func narrow(): str:
    mut b := 250 as u8
    b += 10 as u8
    mut s := 2147483647
    s += 1
    mut big := 9223372036854775807 as i64
    big += 1 as i64
    ret b + " " + s + " " + big
end

func divs(): str:
    a := 0 - 7
    ret (a / 2) + " " + (a % 2) + " " + (7 / (0 - 2)) + " " + (7 % (0 - 2))
end

func with_defers(n: int): str:
    mut log := ""
    repeat n in i:
        defer bump(1)
        if i == 1:
            continue
        end
        if i == 3:
            break
        end
        log = log + i
    end
    ret log
end

func ret_defer(): int:
    mut v := 10
    defer bump(100)
    v = 20
    ret v
end

func sum_vec(v: Vector<i64>): i64:
    mut s := 0 as i64
    repeat v.len() in i:
        s += v.get(i)
    end
    ret s
end

func shapes(): str:
    mut out := ""
    repeat 4 in i:
        if i % 2 == 0:
            p := Pt { x = i }
            out = out + p.len2() + ","
        else:
            b := Box { v = i }
            out = out + b.len2() + ","
        end
    end
    ret out
end

func main:
    println narrow()
    println divs()
    mut x := 1
    mut y := 2
    swap(x, y)
    println x, y
    println with_defers(5), counter
    println ret_defer(), counter
    mut v := Vector {} as Vector<i64>
    repeat 10 in i:
        v.push((i * i) as i64)
    end
    v.set(3, 100 as i64)
    println sum_vec(v), v.len(), v.get(9)
    mut bytes := Vector {} as Vector<u8>
    bytes.zeros(4)
    bytes.set(2, 300 as u8)
    println bytes.get(2), bytes.get(0)
    println shapes()
    p := Pt { y = 1 } + Pt {}
    println p.x, p.y, p.tag
    mut total := 0
    each n in [1, 2, 3]:
        total += n
    end
    sq := (k: int): ret k * k end
    println total, sq(7)
    mut f := 0.5
    f *= 3.0
    println f, 7 / 2, 7.0 / 2.0
    mut i := 0
    until true:
        i += 1
        if i > 5:
            break
        end
    end
    println i
end
