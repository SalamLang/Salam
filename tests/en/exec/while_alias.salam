package main

func main:
    mut i := 0
    while i < 3:
        print "w", i, " "
        i += 1
    end
    println ""

    mut j := 3
    until j > 0:
        print "u", j, " "
        j -= 1
    end
    println ""

    mut k := 0
    while true:
        k += 1
        if k == 2: break end
    end
    println k
end
