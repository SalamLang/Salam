package genchan

import chan

pub struct Event<T>:
    pub v: T
end

pub struct Handler<T>:
    pub id: int = 0
    pub val: T
end

pub struct Bus<T>:
    pub hs: Vector<Handler<T>> = Vector {}
    pub q: chan.Chan<Event<T>> = chan.Chan {}
end

pub func Open<T>(bus &: Bus<T>):
    bus.q.init(4 as i64)
end

pub func Add<T>(bus &: Bus<T>, id: int, v: T):
    bus.hs.push(Handler { id = id, val = v } as Handler<T>)
end

pub func Count<T>(bus &: Bus<T>): int:
    ret bus.hs.len()
end

pub func Post<T>(bus &: Bus<T>, v: T):
    bus.q.send(Event { v = v } as Event<T>)
end

pub func Take<T>(bus &: Bus<T>): T:
    mut ok := true
    r := bus.q.recv(ok)
    ret r.v
end

pub func Close<T>(bus &: Bus<T>):
    bus.q.free()
    bus.hs.free()
end
