package gendupb

pub struct Box<T>:
    pub v: T
    pub n: int = 7
end

func _describe(n: int): str:
    ret "b:" + n
end

pub func Label(n: int): str:
    ret "B" + n
end

pub func Show<T>(n: int, _x: T): str:
    ret _describe(n) + " " + Label(n)
end
