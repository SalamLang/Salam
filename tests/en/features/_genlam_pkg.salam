package genlam

import mem

pub struct Box<T>:
    pub v: T

    pub func Make(): func () T*:
        val := this.v
        ret ():
            b := mem.Allocate(sizeof(T)) as T*
            b[0] = val
            ret b
        end
    end
end

pub func Keep<T>(v: T): func () T*:
    ret ():
        b := mem.Allocate(sizeof(T)) as T*
        b[0] = v
        ret b
    end
end

pub func Twice<T>(v: T): int:
    f := ():
        b := mem.Allocate(sizeof(T)) as T*
        b[0] = v
        mem.Free(b as void*)
        ret 2
    end
    ret f()
end
