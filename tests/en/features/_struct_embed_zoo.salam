package struct_embed_zoo

pub struct Tag:
    pub label: str = ""
end

pub struct Animal:
    pub name: str = "anon"
    pub func Describe(): str:
        ret "I am " + this.name
    end
    pub func Tagged(t: Tag): Tag:
        ret Tag { label = this.name + ":" + t.label }
    end
    func secret(): int:
        ret 1
    end
end
