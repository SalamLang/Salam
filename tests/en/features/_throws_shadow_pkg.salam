package throwsshadow

pub struct Error:
    pub code: int = 0
end

pub func Make(c: int): Error:
    ret Error { code = c }
end

pub func Check(c: int): int throws:
    if c < 0:
        throw "negative code"
    end
    e := Error { code = c }
    ret e.code
end
