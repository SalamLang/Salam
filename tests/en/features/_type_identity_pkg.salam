package tidpkg

pub struct Item:
    pub n: int = 11
end

pub type Meters: int
end

pub func New(): Item:
    ret Item {}
end

pub func Get(it: Item): int:
    ret it.n
end

pub func Make(): Meters:
    ret 5
end
