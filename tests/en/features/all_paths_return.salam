import core

enum Shape:
    Circle
    Square
end

func sign(n: int): int:
    if n > 0:
        ret 1
    else n < 0:
        ret -1
    else:
        ret 0
    end
end

func first_even(xs: int[]): int:
    each x in xs:
        if x % 2 == 0: ret x end
    end
    ret -1
end

func spin(): int:
    mut i := 0
    until true:
        i += 1
        if i == 5: ret i end
    end
end

func name(s: Shape): str:
    ret match s:
        Circle: "circle" end
        Square: "square" end
    end
end

func code(s: Shape): int:
    match s:
        Circle:
            ret 1
        end
        Square:
            ret 2
        end
    end
end

func grade(n: int): str:
    switch n:
        10:
            ret "top"
        end
        5 to 9:
            ret "pass"
        end
        else:
            ret "fail"
        end
    end
end

func checked(n: int): int:
    if n >= 0: ret n end
    core.Panic("negative")
end

func main:
    println sign(5), sign(-3), sign(0)
    println first_even([1, 3, 4, 6]), first_even([1])
    println spin()
    println name(Shape.Square)
    println code(Shape.Circle), code(Shape.Square)
    println grade(10), grade(7), grade(2)
    println checked(3)
end
