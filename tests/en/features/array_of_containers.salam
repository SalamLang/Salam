struct Money:
    pub cents: int = 0

    pub func operator_eq(o: Money): bool:
        ret this.cents == o.cents
    end
end

func main:
    mut vs := [Vector {} as Vector<int>, Vector {} as Vector<int>]
    vs[0].push(3)
    vs[1].push(4)
    vs[1].push(5)
    println vs[0].len(), vs[1].len(), vs[1].get(1)
    mut grid := [[Vector {} as Vector<str>]]
    grid[0][0].push("x")
    println grid[0][0].get(0)
    a := [Money { cents = 1 }, Money { cents = 2 }]
    b := [Money { cents = 1 }, Money { cents = 2 }]
    println a[0] == b[0], a[1].cents
end
