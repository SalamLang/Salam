// The hidden C name for a by-value array parameter used to be built by
// string concatenation (`p.name + "__in"`), which collided with a second,
// real parameter that happened to be named that way and produced a
// duplicate C parameter (a build error). The hidden name is now keyed by
// parameter position instead.

func sum3(a: int[3], a__in: int): int:
    ret a[0] + a[1] + a[2] + a__in
end

func main:
    println sum3([1, 2, 3], 10)
end
