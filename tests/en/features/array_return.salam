struct Grid:
    pub cells: int[3]
end

func make(): int[3]:
    a := [1, 2, 3]
    ret a
end

func make2(k: int): int[3]:
    ret [k, k + 1, k + 2]
end

func sum3(xs: int[3]): int:
    ret xs[0] + xs[1] + xs[2]
end

func main:
    r := make()
    println r[0], r[1], r[2]

    mut c := [0, 0, 0]
    c = make2(10)
    println c[0], c[1], c[2]

    println sum3(make())
    println make()[1]

    g := Grid { cells = make2(5) }
    println g.cells[0], g.cells[2]

    mut d := make()
    d[0] = 99
    e := make()
    println d[0], e[0]
end
