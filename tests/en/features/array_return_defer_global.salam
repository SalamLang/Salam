mut log_count := 0
garr := compute_global()

func compute_global(): i32[3]:
    ret [100, 200, 300]
end

func bump_log(): int:
    log_count = log_count + 1
    ret log_count
end

func with_defer(v: int): i32[3]:
    defer bump_log()
    a := [v, v + 1, v + 2]
    ret a
end

func with_defer_literal(v: int): i32[3]:
    defer bump_log()
    ret [v * 10, v * 20, v * 30]
end

func main:
    r1 := with_defer(1)
    r2 := with_defer_literal(2)
    println r1[0], r1[1], r1[2], log_count
    println r2[0], r2[1], r2[2], log_count
    println garr[0], garr[1], garr[2]
end
