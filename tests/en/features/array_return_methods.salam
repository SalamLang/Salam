struct Box:
    pub v: int = 0
    pub func get(): i32[3]: ret [this.v, this.v + 1, this.v + 2] end
end

interface Maker:
    func vals(): i32[3]
end

struct M:
    pub base: int = 0
    pub func vals(): i32[3]: ret [this.base, this.base * 2, this.base * 3] end
end

struct V3:
    pub x: int = 0
    pub y: int = 0
    pub z: int = 0
    pub func operator_add(o: V3): i32[3]: ret [this.x + o.x, this.y + o.y, this.z + o.z] end
end

func mk(v: int): Box: ret Box { v = v } end

func sum3(arr: i32[3]): int:
    ret arr[0] + arr[1] + arr[2]
end

func mkv(x: int, y: int, z: int): V3: ret V3 { x = x, y = y, z = z } end

func main:
    r := mk(5).get()
    println r[0], r[1], r[2]

    d := M { base = 3 } as dyn Maker
    v := d.vals()
    println v[0], v[1], v[2]

    println sum3(mk(1).get())

    s := mkv(1, 2, 3) + mkv(10, 20, 30)
    println s[0], s[1], s[2]

    println mk(2).get()[2]
end
