struct Point:
    pub x: int = 0
    pub y: int = 0
end

struct Summer:
    pub base: int = 0

    pub func total(xs: int[]): int:
        mut t := this.base
        each x in xs: t += x end
        ret t
    end
end

func join(xs: str[]): str:
    mut s := ""
    each x in xs: s = s + x + "|" end
    ret s
end

func bump(xs: int[]):
    repeat len(xs) in i:
        xs[i] = xs[i] + 10
    end
end

func sum_x(ps: Point[]): int:
    mut t := 0
    each p in ps: t += p.x end
    ret t
end

func main:
    println join(["a", "b", "c"])
    println join(["x"])
    words := ["p", "q"]
    println join(words)
    mut nums := [1, 2, 3]
    bump(nums)
    println nums[0], nums[2]
    println Summer { base = 100 }.total([1, 2, 3]), Summer {}.total(nums)
    println sum_x([Point { x = 2 }, Point { x = 5 }])
    repeat 3 in k:
        print join(["r", "s"]), k
    end
    println ""
end
