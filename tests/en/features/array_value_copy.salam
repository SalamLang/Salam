struct Grid:
    pub cells: int[3]
    pub tag: str
end

func bump_first(xs: int[3]): int:
    xs[0] = xs[0] + 100
    ret xs[0]
end

func sum3(xs: int[3]): int:
    ret xs[0] + xs[1] + xs[2]
end

func main:
    a := [1, 2, 3]
    mut b := a
    b[0] = 9
    println a[0], b[0]

    mut c := [0, 0, 0]
    c = a
    c[2] = 7
    println a[2], c[2]
    c = [4, 5, 6]
    println c

    println bump_first(a), a[0], sum3(a)

    names := ["x", "y"]
    mut t := names
    t[1] = "z"
    println names[1], t[1]

    g := Grid { cells = [1, 2, 3], tag = "g" }
    mut h := g
    h.cells[1] = 20
    println g.cells[1], h.cells[1]
    mut row := g.cells
    row[0] = 50
    println g.cells[0], row[0]

    m := [[1, 2], [3, 4]]
    mut r := m[1]
    r[0] = 30
    println m[1][0], r[0]
    mut m2 := m
    m2[0][1] = 22
    println m[0][1], m2[0][1]
    m2[0] = m[1]
    println m2[0]
end
