func main:
    zero := 0
    even := 64
    odd := 65
    neg := 0 - 2
    big := 4294967296 as i64
    println zero as bool, even as bool, odd as bool, neg as bool, big as bool
    fz := 0.0
    fe := 64.0
    ff := 0.5
    fneg := 0.0 - 2.0
    println fz as bool, fe as bool, ff as bool, fneg as bool
    f32z := 0.0 as f32
    f32e := 64.0 as f32
    println f32z as bool, f32e as bool
    u := 256 as u8
    v := 2 as u16
    println u as bool, v as bool
    println true as i32, false as i32
end
