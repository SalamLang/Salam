type Meters: int
end

type Feet: int
end

interface Shape:
    func area(): int
end

struct Sq:
    pub s: int = 3
end

impl Shape on Sq:
    func area(): int: ret this.s * this.s end
end

func main:
    m := 5 as Meters
    println m as int
    println (m as int) as Feet as int
    sq := Sq {}
    d := sq as dyn Shape
    println d.area()
    arr := [1, 2, 3]
    sl := arr[:]
    println sl.len(), sl[1]
end
