import mem

enum Shade: Red = 1, Green = 2 end
enum Tag: First = "ay", Second = "bee" end

func main:
    p := mem.AllocateZeroed(8 as u64) as i64*
    p[0] = 7
    vp := p as void*
    back := vp as i64*
    println back[0]
    println (p as u64) == (vp as u64)
    s := "hi"
    sp := s as void*
    println sp as str
    arr := [1, 2, 3]
    ap := arr as i32*
    println ap[1], ap[2]
    println Shade.Green as i32, Shade.Red as i64
    println Tag.First as str, Tag.Second as str
    mem.Free(vp)
end
