struct Book:
    pub title: str
    pub component: int
end

func twice(component: int): int:
    ret component * 2
end

func main:
    b := Book { title = "a", component = 3 }
    println b.title, b.component
    component := b.component + 1
    println twice(component)
    each component in [7, 8]:
        println component
    end
end
