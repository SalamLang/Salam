const A := 1 << 20
const B := A * 4096
const C := 0 - A
const D := A as i64
const E := ~A
const F := A > 5 ? 1 : 2
const K := 100
const S := "ab"
const T := S + "cd"
const RPT := S * 3
const B1 := true
const B2 := not B1
const F1 := 1.5
const F2 := F1 * 2.0

func main:
    println A, B, C, D, E, F
    println K + 3, K - 3, K * 3, K * K
    r1 := ~(0 as u8)
    println r1
    r2 := ~(1 as u16)
    println r2
    r3 := -(1 as i8)
    println r3
    r4 := (255 as u8) as i8
    println r4
    r5 := (1 << 31) as u32
    println r5
    println T, RPT
    println B2, F2
end
