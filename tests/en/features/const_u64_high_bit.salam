// Regression test for Issue #2534: u64 & usize constants >= 2^63
const HIGH_BIT := 0x8000000000000000 as u64
const MAX_U64 := 0xFFFFFFFFFFFFFFFF as u64
const SHIFTED := (1 as u64) << 63
const SHR_TEST := HIGH_BIT >> 1
const SHR_ALL := HIGH_BIT >> 63

const USIZE_HIGH := 0x8000000000000000 as usize
const BIT_OR := HIGH_BIT | 1
const BIT_AND := MAX_U64 & HIGH_BIT
const BIT_XOR := MAX_U64 ^ HIGH_BIT
const COND := HIGH_BIT != 0 ? 42 : 0

func main:
    println HIGH_BIT
    println MAX_U64
    println SHIFTED
    println SHR_TEST
    println SHR_ALL
    println USIZE_HIGH
    println BIT_OR
    println BIT_AND
    println BIT_XOR
    println COND
end
