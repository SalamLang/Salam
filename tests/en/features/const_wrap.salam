// A constant expression wraps at its type's width exactly as the same
// arithmetic does at run time, so folding never changes a program's answer.

const A := 1 << 20
const B := A * 4096

func main:
    println A, B
    println 2147483647 + 1 == -2147483648
    println 2147483647 + 1
    println (1 << 31) as u32
    println 255 + 1
    println (200 as u8) + (100 as u8)
    println (1 as i64) << 40
    x := 2147483647
    println x + 1
end
