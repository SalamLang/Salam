const A := 1 << 20
const B := (A as i64) * 4096

func main:
    println A, B
    println (2147483647 as u32) + (1 as u32)
    println (1 << 31) as u32
    println 255 + 1
    println (200 as u8) + (100 as u8)
    println (1 as i64) << 40
    x := 4294967295 as u32
    println x + (1 as u32)
end
