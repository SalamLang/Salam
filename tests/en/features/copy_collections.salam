import collections

func main:
    mut st := collections.Stack {} as collections.Stack<int>
    st.Push(1)
    st2 := st.Copy()
    st.Push(2)
    println st.Size(), st2.Size(), st2.Peek()

    mut q := collections.Queue {} as collections.Queue<str>
    q.enqueue("a")
    q2 := q.DeepCopy()
    q.enqueue("b")
    println q.Size(), q2.Size()

    mut d := collections.Deque {} as collections.Deque<int>
    d.PushBack(1)
    d.PushFront(0)
    d2 := d.Copy()
    d.PushBack(2)
    println d.Size(), d2.Size()

    mut s := collections.Set {} as collections.Set<str>
    s.Add("x")
    s2 := s.Copy()
    s.Add("y")
    println s.Size(), s2.Size(), s2.Has("y")

    mut stacks := Vector {} as Vector<collections.Stack<int>>
    mut inner := collections.Stack {} as collections.Stack<int>
    inner.Push(5)
    stacks.Push(inner)
    sd := stacks.DeepCopy()
    mut i0 := stacks.Get(0)
    i0.Push(6)
    stacks.Set(0, i0)
    println stacks.Get(0).Size(), sd.Get(0).Size()
end
