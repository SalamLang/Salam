struct Point:
    pub x: int = 0
    pub y: int = 0
end

enum Shape:
    Dot
    Circle(r: int)
    Poly(name: str, pts: Vector<Point>)
end

func describe(s: Shape): str:
    ret match s:
        Dot: "dot" end
        Circle(_): "circle" end
        Poly(name, _): name end
    end
end

func points(s: Shape): int:
    ret match s:
        Poly(_, pts): pts.len() end
        else: 0 end
    end
end

func first_x(s: Shape): int:
    ret match s:
        Poly(_, pts): pts.get(0).x end
        else: 0 - 1 end
    end
end

func main:
    mut pts := Vector {} as Vector<Point>
    pts.push(Point { x = 1 })
    shape := Shape.Poly("tri", pts)
    shallow := shape.copy()
    deep := shape.deep_copy()
    pts.push(Point { x = 2 })
    pts.set(0, Point { x = 9 })
    println describe(shallow), points(shallow), first_x(shallow)
    println describe(deep), points(deep), first_x(deep)
    println describe(Shape.Dot.copy()), describe(Shape.Circle(3).deep_copy())

    mut nums := [1, 2, 3]
    n2 := nums.copy()
    n3 := nums.deep_copy()
    nums[1] = 20
    println n2[1], n3[1], nums[1]

    mut grid := [[1, 2], [3, 4]]
    g2 := grid.deep_copy()
    grid[1][0] = 30
    println g2[1][0], grid[1][0]

    mut names := ["x", "y"]
    nd := names.deep_copy()
    names[0] = "changed"
    println nd[0], names[0]

    mut ps := [Point { x = 1 }, Point { x = 2 }]
    pc := ps.copy()
    ps[0].x = 10
    println pc[0].x, ps[0].x
end
