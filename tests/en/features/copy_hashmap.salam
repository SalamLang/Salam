func main:
    mut ages := HashMap {} as HashMap<str, int>
    ages.put("sara", 30)
    ages.put("ali", 41)
    snap := ages.copy()
    ages.put("sara", 31)
    ages.put("reza", 25)
    println snap.size(), snap.get("sara"), snap.has("reza")
    println ages.size(), ages.get("sara")

    mut groups := HashMap {} as HashMap<str, Vector<int>>
    mut evens := Vector {} as Vector<int>
    evens.push(2)
    groups.put("even", evens)
    shallow := groups.copy()
    deep := groups.deep_copy()
    mut e := groups.get("even")
    e.set(0, 4)
    println shallow.get("even").get(0), deep.get("even").get(0)

    mut nested := HashMap {} as HashMap<int, HashMap<str, str>>
    mut inner := HashMap {} as HashMap<str, str>
    inner.put("k", "v")
    nested.put(1, inner)
    nd := nested.deep_copy()
    mut in1 := nested.get(1)
    in1.put("k", "changed")
    in1.put("k2", "new")
    println nd.get(1).get("k"), nd.get(1).size()

    empty := HashMap {} as HashMap<str, int>
    println empty.copy().size(), empty.deep_copy().size()
end
