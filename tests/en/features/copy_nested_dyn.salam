interface Counter:
    func bump(): int
    func total(): int
end

struct Tally:
    pub n: int = 0

    pub func bump(): int:
        this.n += 1
        ret this.n
    end

    pub func total(): int:
        ret this.n
    end
end

func main:
    mut grid := Vector {} as Vector<Vector<dyn Counter>>
    mut row := Vector {} as Vector<dyn Counter>
    row.push(Tally { n = 4 })
    grid.push(row)
    g2 := grid.deep_copy()
    g3 := grid.copy()
    grid.get(0).get(0).bump()
    println g2.get(0).get(0).total(), g3.get(0).get(0).total(), grid.get(0).get(0).total()
end
