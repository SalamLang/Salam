interface Counter:
    func bump(): int
    func total(): int
end

struct Tally:
    pub n: int = 0

    pub func bump(): int:
        this.n++
        ret this.n
    end

    pub func total(): int:
        ret this.n
    end
end

func main:
    mut grid := Vector {} as Vector<Vector<dyn Counter>>
    mut row := Vector {} as Vector<dyn Counter>
    row.Push(Tally { n = 4 })
    grid.Push(row)
    g2 := grid.DeepCopy()
    g3 := grid.Copy()
    grid.Get(0).Get(0).bump()
    println g2.Get(0).Get(0).total(), g3.Get(0).Get(0).total(), grid.Get(0).Get(0).total()
end
