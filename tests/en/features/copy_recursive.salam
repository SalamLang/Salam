struct Node:
    pub name: str = ""
    pub children: Vector<Node> = Vector {}
end

struct Graph:
    pub adj: HashMap<str, Vector<str>> = HashMap {}
    pub weights: Vector<Vector<Vector<int>>> = Vector {}
end

func size_of(n: Node): int:
    mut c := 1
    repeat n.children.len() in i:
        c += size_of(n.children.get(i))
    end
    ret c
end

func depth_of(n: Node): int:
    mut best := 0
    repeat n.children.len() in i:
        d := depth_of(n.children.get(i))
        if d > best:
            best = d
        end
    end
    ret best + 1
end

func chain(n: int): Node:
    mut cur := Node { name = "leaf" }
    repeat n:
        mut up := Node { name = "n" }
        up.children.push(cur)
        cur = up
    end
    ret cur
end

func main:
    mut root := Node { name = "root" }
    mut a := Node { name = "a" }
    a.children.push(Node { name = "a1" })
    a.children.push(Node { name = "a2" })
    root.children.push(a)
    root.children.push(Node { name = "b" })
    snap := root.deep_copy()
    mut ra := root.children.get(0)
    mut ra1 := ra.children.get(0)
    ra1.name = "renamed"
    ra1.children.push(Node { name = "deeper" })
    ra.children.set(0, ra1)
    root.children.set(0, ra)
    println size_of(root), size_of(snap)
    println root.children.get(0).children.get(0).name, snap.children.get(0).children.get(0).name

    long := chain(50)
    lc := long.deep_copy()
    println depth_of(lc), size_of(lc)

    mut g := Graph {}
    mut out := Vector {} as Vector<str>
    out.push("b")
    g.adj.put("a", out)
    mut plane := Vector {} as Vector<Vector<int>>
    mut line := Vector {} as Vector<int>
    line.push(1)
    plane.push(line)
    g.weights.push(plane)
    gs := g.copy()
    gd := g.deep_copy()
    mut l2 := g.weights.get(0).get(0)
    l2.set(0, 7)
    mut o2 := g.adj.get("a")
    o2.set(0, "c")
    println gs.weights.get(0).get(0).get(0), gs.adj.get("a").get(0)
    println gd.weights.get(0).get(0).get(0), gd.adj.get("a").get(0)
end
