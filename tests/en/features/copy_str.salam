func main:
    s := "hello world"
    whole := s.Copy()
    println whole, whole == s
    println s.Copy(6)
    println s.Copy(0, 5)
    println s.Copy(-5)
    println s.Copy(-5, 3)
    println "[" + s.Copy(40) + "]"
    println "[" + s.Copy(3, 0) + "]"
    println "[" + s.Copy(3, 0 - 1) + "]"
    println s.Copy(0 - 100, 4)
    println s.Copy(8, 1000)
    println s.DeepCopy(0, 4)
    fa := "سلام"
    println fa.Copy(), fa.Copy(0, 4), fa.Len()
    println "[" + "".Copy() + "]", "".Copy(2, 2).Len()
end
