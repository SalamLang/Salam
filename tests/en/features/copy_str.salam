func main:
    s := "hello world"
    whole := s.copy()
    println whole, whole == s
    println s.copy(6)
    println s.copy(0, 5)
    println s.copy(-5)
    println s.copy(-5, 3)
    println "[" + s.copy(40) + "]"
    println "[" + s.copy(3, 0) + "]"
    println "[" + s.copy(3, 0 - 1) + "]"
    println s.copy(0 - 100, 4)
    println s.copy(8, 1000)
    println s.deep_copy(0, 4)
    fa := "سلام"
    println fa.copy(), fa.copy(0, 4), fa.len()
    println "[" + "".copy() + "]", "".copy(2, 2).len()
end
