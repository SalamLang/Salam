func show(label: str, v: Vector<int>):
    print label, ":"
    repeat v.len() in i:
        print " ", v.get(i)
    end
    println ""
end

func main:
    mut v := Vector {} as Vector<int>
    repeat 8 in i:
        v.push(i * 10)
    end

    full := v.copy()
    v.set(0, 99)
    v.push(80)
    show("full", full)
    show("source", v)

    show("from 3", v.copy(3))
    show("from -2", v.copy(-2))
    show("from 20", v.copy(20))
    show("from -20", v.copy(0 - 20))
    show("3 from 2", v.copy(2, 3))
    show("count past end", v.copy(6, 50))
    show("zero count", v.copy(1, 0))
    show("negative count", v.copy(1, 0 - 4))
    show("step 2", v.copy(0, 4, 2))
    show("step 3 to end", v.copy(1, 100, 3))
    show("reverse", v.copy(-1, 100, 0 - 1))
    show("reverse 3 from 5", v.copy(5, 3, 0 - 1))
    show("reverse step 2", v.copy(-1, 3, 0 - 2))

    d := v.deep_copy(2, 2)
    show("deep range", d)

    mut empty := Vector {} as Vector<int>
    ec := empty.copy()
    empty.push(1)
    show("empty copy", ec)
    show("source grew", empty)

    mut words := Vector {} as Vector<str>
    words.push("salam")
    words.push("dunya")
    w2 := words.deep_copy()
    words.set(0, "bye")
    println w2.get(0), w2.get(1), words.get(0)
end
