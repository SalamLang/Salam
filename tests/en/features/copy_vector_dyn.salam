interface Counter:
    func total(): int
end

struct Tally:
    pub n: int = 0

    pub func total(): int:
        ret this.n
    end
end

func main:
    mut list := Vector {} as Vector<dyn Counter>
    list.Push(Tally { n = 3 })
    l2 := list.Copy()
    println l2.Get(0).total(), l2.Len()
end
