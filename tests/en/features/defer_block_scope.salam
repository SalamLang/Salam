// `defer` belongs to the block it is written in, not to the function: the
// cleanup runs at that block's end, where the name it mentions is still in
// scope, and only when that branch actually ran. Hoisting it to function
// scope emitted C that named a variable declared inside an `if`.
package main

func drop(tag: str):
    println "drop", tag
end

func branch(flag: bool):
    if flag:
        b := "b"
        defer drop(b)
        println "in-branch"
    else:
        e := "e"
        defer drop(e)
        println "in-else"
    end
    println "after"
end

func looped:
    repeat 2 with i:
        v := i
        defer drop("iter")
        if v == 1: continue end
        println "body", v
    end
end

func early(flag: bool): int:
    outer := "outer"
    defer drop(outer)
    if flag:
        inner := "inner"
        defer drop(inner)
        ret 1
    end
    ret 0
end

func main:
    branch(true)
    branch(false)
    looped()
    println early(true)
    println early(false)
end
