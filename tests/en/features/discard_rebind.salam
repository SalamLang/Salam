// `_` discards a value. Two of them in one block are two discards, not a
// redefinition, and neither the C nor the JS output may declare `_` twice.

mut hits := 0

struct Big:
    pub a: int
    pub b: str
end


func tick(): int:
    hits += 1
    ret hits
end

func make(): Big:
    _ := tick()
    ret Big { a = hits, b = "x" }
end

func main:
    _ := tick()
    _ := tick()
    _ := make()
    _ := [1, 2, 3]
    if hits > 0:
        _ := tick()
        _ := tick()
    end
    println hits
end
