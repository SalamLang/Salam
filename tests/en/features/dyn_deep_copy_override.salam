interface Named:
    func name(): str
end

struct Plain:
    pub n: str = "plain"

    pub func name(): str:
        ret this.n
    end
end

struct Custom:
    pub n: str = "custom"

    pub func name(): str:
        ret this.n
    end

    pub func deep_copy(): Custom:
        ret Custom { n = this.n + " copy" }
    end
end

func main:
    a := Plain {} as dyn Named
    b := Custom {} as dyn Named
    println a.deep_copy().name(), b.deep_copy().name()
end
