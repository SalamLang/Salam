interface Counter:
    func bump(): int
    func total(): int
end

interface Logger:
    func log(msg: str): int
    func count(): int
end

struct Ticker:
    pub n: int = 0

    pub func bump(): int:
        this.n += 1
        ret this.n
    end

    pub func total(): int:
        ret this.n
    end
end

struct Stepper:
    pub n: int = 0
    pub step: int = 10

    pub func bump(): int:
        this.n += this.step
        ret this.n
    end

    pub func total(): int:
        ret this.n
    end
end

struct MemLog:
    pub lines: Vector<str> = Vector {}

    pub func log(msg: str): int:
        this.lines.push(msg)
        ret this.lines.len()
    end

    pub func count(): int:
        ret this.lines.len()
    end
end

struct Service:
    pub name: str = ""
    pub hits: dyn Counter = Ticker {}
    pub logger: dyn Logger = MemLog {}
end

struct Wrap<T>:
    pub item: T
    pub c: dyn Counter = Stepper { step = 5 }
end

func make(name: str, fast: bool): Service:
    mut s := Service { name = name }
    if fast:
        s.hits = Stepper { step = 100 }
    end
    ret s
end

func run(s: Service, times: int): int:
    mut last := 0
    repeat times:
        last = s.hits.bump()
    end
    ret last
end

func main:
    mut a := make("a", false)
    b := make("b", true)
    a.hits.bump()
    a.hits.bump()
    println a.name, a.hits.total(), b.name, b.hits.bump()
    println run(a, 3), a.hits.total()
    a.logger.log("one")
    println a.logger.log("two"), a.logger.count()
    a.hits = Stepper { step = 7 }
    println a.hits.bump(), a.hits.bump()
    mut w := Wrap { item = "x" } as Wrap<str>
    println w.item, w.c.bump(), w.c.bump()
    mut list := Vector {} as Vector<Service>
    list.push(a)
    list.push(b)
    mut sum := 0
    repeat list.len() in i:
        sum += list.get(i).hits.total()
    end
    println sum
    a.hits.free()
    a.logger.free()
end
