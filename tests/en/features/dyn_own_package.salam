package shapes

interface Shape:
    func Area(): int
end

struct Square:
    pub side: int = 0
    pub func Area(): int:
        ret this.side * this.side
    end
end

func area_of(s: dyn Shape): int:
    ret s.Area()
end

func main:
    s := Square { side = 3 } as dyn Shape
    println s.Area()
    println area_of(Square { side = 4 })
end
