struct Walker:
    pub func total(s: Steps): int:
        mut sum := 0
        each v in s:
            sum = sum + v
        end
        ret sum
    end
    pub func first(t: Three): int:
        each i, v in t:
            if i == 0:
                ret v
            end
        end
        ret 0
    end
end

struct StepIter:
    pub cur: int = 0
    pub stop: int = 0
    pub func has_next:
        ret this.cur < this.stop
    end
    pub func value:
        ret this.cur * 2
    end
    pub func next():
        this.cur = this.cur + 1
    end
end

struct Steps:
    pub hi: int = 0
    pub func iter:
        ret StepIter { stop = this.hi }
    end
end

struct Three:
    pub func len:
        ret 3
    end
    pub func get(i: int):
        ret i + 10
    end
end

func main:
    w := Walker {}
    println "total", w.total(Steps { hi = 4 })
    println "first", w.first(Three {})
    s := Steps { hi = 3 }
    each v in s:
        println "step", v
    end
end
