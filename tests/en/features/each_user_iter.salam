struct Bag:
    pub items: Vector<int> = Vector {}
    pub func len(): int: ret this.items.len() end
    pub func get(i: int): int: ret this.items.get(i) end
end

struct RangeIter:
    pub cur: int = 0
    pub stop: int = 0
    pub func has_next(): bool: ret this.cur < this.stop end
    pub func value(): int: ret this.cur end
    pub func next(): this.cur = this.cur + 1 end
end

struct Range:
    pub lo: int = 0
    pub hi: int = 0
    pub func iter(): RangeIter: ret RangeIter { cur = this.lo, stop = this.hi } end
end

struct PairIter:
    pub keys: Vector<str> = Vector {}
    pub vals: Vector<int> = Vector {}
    pub pos: int = 0
    pub func has_next(): bool: ret this.pos < this.keys.len() end
    pub func key(): str: ret this.keys.get(this.pos) end
    pub func value(): int: ret this.vals.get(this.pos) end
    pub func next(): this.pos = this.pos + 1 end
end

struct Table:
    pub keys: Vector<str> = Vector {}
    pub vals: Vector<int> = Vector {}
    pub func iter(): PairIter: ret PairIter { keys = this.keys, vals = this.vals } end
end

func main:
    mut b := Bag {}
    b.items.push(7)
    b.items.push(9)
    each x in b:
        println "bag", x
    end
    each i, x in b:
        println "idx", i, x
    end

    r := Range { lo = 2, hi = 5 }
    each v in r:
        println "range", v
    end

    mut t := Table {}
    t.keys.push("a")
    t.keys.push("b")
    t.vals.push(1)
    t.vals.push(2)
    each k, v in t:
        println "table", k, v
    end
end
