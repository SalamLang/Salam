struct Bag:
    pub items: Vector<int> = Vector {}
    pub func len(): int: ret this.items.len() end
    pub func get(i: int): int: ret this.items.get(i) end
end

struct RIter:
    pub cur: int = 0
    pub stop: int = 0
    pub func has_next(): bool: ret this.cur < this.stop end
    pub func value(): int: ret this.cur end
    pub func next(): this.cur = this.cur + 1 end
end

struct R:
    pub hi: int = 0
    pub func iter(): RIter: ret RIter { cur = 0, stop = this.hi } end
end

func main:
    mut b := Bag {}
    b.items.push(1)
    b.items.push(2)
    b.items.push(3)
    each x in b:
        if x == 2:
            continue
        end
        if x == 3:
            break
        end
        println "seq", x
    end
    r := R { hi = 4 }
    each v in r:
        if v == 1:
            continue
        end
        if v == 3:
            break
        end
        println "cur", v
    end
    each x in b:
        each v in r:
            println "nest", x, v
        end
    end
end
