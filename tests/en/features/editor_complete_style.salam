include "../../../editor/complete.salam"

func has(list: str, word: str): bool:
    repeat complete.Count(list) in i:
        if complete.Label(complete.Item(list, i)) == word:
            ret true
        end
    end
    ret false
end

func list_at(src: str, lang: str): str:
    pos := src.Len()
    ws := complete.WordStart(src, pos)
    ret complete.Build(src.Substr(ws, pos - ws), complete.Mode(src, pos), lang)
end

func main:
    println has(list_at("page:\n    box:\n        gap", "en"), "gap")
    println has(list_at("page:\n    box:\n        align", "en"), "align content")
    println has(list_at("page:\n    box:\n        align = c", "en"), "center")
    println has(list_at("page:\n    box:\n        align = c", "en"), "stack")
    println has(list_at("page:\n    box:\n        justify = ", "en"), "between")
    println has(list_at("page:\n    box:\n        padding = 8, ", "en"), "8, 16")
    println has(list_at("page:\n    box:\n        hover align = ", "en"), "center")
    println has(list_at("func main:\n    gap = c", "en"), "center")
end
