import encoding.json
import encoding.encerr
import result

enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

struct Doc:
    pub name: str = ""
    pub shape: Shape = Shape.Empty
end

struct P:
    pub x: int
    pub name: str
end

func main:
    d := Doc { name = "a", shape = Shape.Rect(2.0, 3.0) }
    text := json.Marshal(d)
    println text
    mut back := Doc {}
    mut e := encerr.NoError()
    println json.Unmarshal(text, back, e)
    println back
    mut v := Vector {} as Vector<Shape>
    println json.Unmarshal("[\"Empty\", {\"Circle\": {\"r\": 2}}, {\"Rect\":{\"w\":1,\"h\":4}}]", v, e)
    println v
    println json.Marshal(v)
    mut bad := Vector {} as Vector<Shape>
    println json.Unmarshal("[{\"Hexagon\": {}}]", bad, e)
    println e.message
    mut r := result.Result.Ok(3) as result.Result<int, str>
    println json.Marshal(r)
    println json.Unmarshal("{\"Err\":{\"error\":\"nope\"}}", r, e)
    println r
    mut ps := Vector {} as Vector<P>
    println json.Unmarshal("[{\"x\":1,\"name\":\"a\"},{\"x\":2,\"name\":\"b\"}]", ps, e)
    println ps.get(1).name
    v.free()
    bad.free()
    ps.free()
end
