import result

enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

func main:
    s := Shape.Rect(1.0, 2.0)
    println s.name()
    println Shape.Empty.name()
    println Shape.Count()
    r := result.Result.Err("x") as result.Result<int, str>
    println r.name()
    println result.Result.Count()
end
