enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

enum Result<T, E>:
    Ok(value: T)
    Err(error: E)
end

func main:
    s := Shape.Rect(1.0, 2.0)
    println s.name()
    println Shape.Empty.name()
    println Shape.Count()
    r := Result.Err("x") as Result<int, str>
    println r.name()
    println Result.Count()
end
