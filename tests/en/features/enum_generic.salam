enum Result<T, E>:
    Ok(value: T)
    Err(error: E)
end

enum Maybe<T>:
    Some(v: T)
    Nothing
end

func parse(s: str): Result<int, str>:
    if s == "7":
        ret Result.Ok(7)
    end
    ret Result.Err("bad: " + s)
end

func first(xs: Vector<int>): Maybe<int>:
    if xs.len() == 0:
        ret Maybe.Nothing
    end
    ret Maybe.Some(xs.get(0))
end

func main:
    a := parse("7")
    b := parse("x")
    println a
    println b
    match a:
        Ok(v):
            println v + 1
        end
        Err(e):
            println e
        end
    end
    msg := match b:
        Ok(_) => "ok"
        Err(e) => "err " + e
    end
    println msg
    println a == Result.Ok(7) as Result<int, str>
    c := Result.Err("boom") as Result<f64, str>
    println c
    mut xs := Vector {} as Vector<int>
    println first(xs)
    xs.push(42)
    println first(xs)
    xs.free()
end
