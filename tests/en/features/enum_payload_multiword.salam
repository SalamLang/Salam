import str

enum Payment:
    Cash
    Card(last digits: str, expiry year: int)
end

func describe(p: Payment): str:
    ret match p:
        Cash: "cash" end
        Card(d, y): "card " + d + " until " + str.FromInt(y as i64) end
    end
end

func main:
    p := Payment.Card("1234", 2030)
    println describe(p)
    println describe(Payment.Cash)
    println p
end
