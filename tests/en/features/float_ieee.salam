func zero(): f64: ret 0.0 end

func one(): f64: ret 1.0 end

func main:
    println 0.1 + 0.2 == 0.3
    println 0.1 + 0.2
    nz := zero()
    po := one()
    inf := po / nz
    nan := nz / nz
    println inf, 0.0 - inf
    println nan == nan
    println inf > 1.0e308
    println 0.0 - 0.0 == 0.0
    println 1.0 / 3.0
    println (1.0 / 3.0) as f32
end
