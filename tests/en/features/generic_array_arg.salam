import encoding.json

struct Person:
    pub name: str = ""
    pub age: int = 0
end

func describe<T>(v: T): str:
    ret json.Marshal(v)
end

func same<T>(v: T): T:
    ret v
end

func main:
    names := [
    1
    2
    3
    4
    5
    ]
    println json.Marshal(names)
    println json.Marshal(["سلام", "hi \"q\"", ""])
    println json.MarshalIndent([1.5, 2.0], "  ")
    println json.Marshal([Person { name = "Ali", age = 30 }, Person { name = "Sara", age = 25 }])
    println describe([true, false])
    s := same(names)
    println s.len(), s[4]
end
