func idt<T>(x: T): T: ret x end

func keep<T>(x: T): T:
    ret x
end

func main:
    println idt([1, 2])[1]
    a := keep([10, 20, 30])
    b := keep([40, 50, 60])
    println a[0], a[2], b[1]
    nums := [7, 8, 9]
    c := keep(nums)
    println c.len(), c[2]
end
