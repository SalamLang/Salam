type IntFn = func (int) int

struct Pipeline:
    pub stages: Vector<IntFn>

    pub func run(x: int): int:
        mut v := x
        each st in this.stages:
            v = st(v)
        end
        ret v
    end
end

func main:
    fs := Vector {} as Vector<func (int) int> repeat 3 in k: fs.push((v: int): ret v * (k + 1) end)
end
println fs.get(2)(10)
println fs.len()
fs.free()

m := HashMap {} as HashMap<str, func (int) int> m.put("dbl", (v: int): ret v * 2 end)
m.put("neg", (v: int): ret 0 - v end)
dbl := m.get("dbl")
neg := m.get("neg")
println dbl(21), neg(5)
m.free()

p := Pipeline { stages = Vector {} as Vector<IntFn> }
p.stages.push((v: int): ret v + 1 end)
p.stages.push((v: int): ret v * 10 end)
println p.run(4)
p.stages.free()
end
