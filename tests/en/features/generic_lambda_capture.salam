import mem

struct Tag<T>:
    pub n: int = 0
end

func twice<T>(x: T): T:
    ret x
end

func bump<T>(_x: T, c: int*):
    c[0] = c[0] + 1
end

func Run<T>(v: T, c: int*): T:
    f := ():
        bump(v, c)
        ret twice(v)
    end
    ret f()
end

func Peek<T>(t: Tag<T>*): int:
    g := ():
        ret t.n
    end
    ret g()
end

func main:
    c := mem.Allocate(4 as u64) as int*
    c[0] = 0
    println Run(7, c)
    println Run("a", c)
    println c[0]
    t := mem.Allocate(sizeof(Tag<int>)) as Tag<int>*
    t.n = 9
    println Peek(t)
    mem.Free(t as void*)
    mem.Free(c as void*)
end
