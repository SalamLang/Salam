include genlam "_genlam_pkg.salam"

func main:
    keep := genlam.Keep(7)
    p := keep()
    println p[0]
    println genlam.Twice(5)
    keep_s := genlam.Keep("seven")
    q := keep_s()
    println q[0]
    box := genlam.Box { v = 9 } as genlam.Box<int>
    make := box.Make()
    r := make()
    println r[0]
end
