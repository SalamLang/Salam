interface Shape:
    func Area(): f64
end

interface Named:
    func Name(): str
end

interface Tagged:
    func Tag(): int
end

struct Cube:
    pub s: f64 = 1.0
    pub func Area(): f64: ret 6.0 * this.s * this.s end
    pub func Name(): str: ret "cube" end
    pub func Tag(): int: ret 7 end
end

func show<T: Shape + Named>(v: T):
    println v.Name(), v.Area()
end

func show3<T: Shape + Named + Tagged>(v: T):
    println v.Name(), v.Area(), v.Tag()
end

func main:
    c := Cube { s = 2.0 }
    show(c)
    show3(c)
end
