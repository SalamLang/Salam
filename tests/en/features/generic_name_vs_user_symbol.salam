include ga "_gendup_a.salam"
include gb "_gendup_b.salam"

func Box_i32(): str:
    ret "user one"
end

func Box_i32_gendupb(): str:
    ret "user two"
end

func main:
    x := ga.Box { v = 1 } as ga.Box<int>
    y := gb.Box { v = 2 } as gb.Box<int>
    println x.v, x.tag, y.v, y.n
    println Box_i32(), Box_i32_gendupb()
end
