func twice<T>(x: T): T:
    ret x
end

func Nest<T>(v: T): T:
    outer := ():
        inner := ():
            ret twice(v)
        end
        ret inner()
    end
    ret outer()
end

func main:
    println Nest(5)
    println Nest("s")
end
