include ga "_gendup_a.salam"
include gb "_gendup_b.salam"

func main:
    println ga.Show(1, 5)
    println gb.Show(2, 5)
    println gb.Show(3, "x")
    println ga.Show(4, "y")
    x := ga.Box { v = 1 } as ga.Box<int>
    y := gb.Box { v = 2 } as gb.Box<int>
    println x.v, x.tag
    println y.v, y.n
end
