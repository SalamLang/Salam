include gc "_genchan_pkg.salam"

func main:
    mut bus := gc.Bus {} as gc.Bus<int>
    gc.Open(bus)
    gc.Add(bus, 1, 10)
    gc.Add(bus, 2, 20)
    println gc.Count(bus)
    gc.Post(bus, 5)
    println gc.Take(bus)
    gc.Close(bus)
end
