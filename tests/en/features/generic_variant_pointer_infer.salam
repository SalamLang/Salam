import mem

enum Maybe<T>:
    Some(v: T)
    Nothing
end

func make(n: int): Maybe<int>:
    if n > 0:
        ret Maybe.Some(n)
    end
    ret Maybe.Nothing
end

func Present<T>(m: Maybe<T>*): bool:
    match m[0]:
        Some(_v):
            ret true
        end
        Nothing:
            ret false
        end
    end
end

func main:
    p := mem.Allocate(sizeof(Maybe<int>)) as Maybe<int>*
    p[0] = make(3)
    println Present(p)
    p[0] = make(0)
    println Present(p)
    mem.Free(p as void*)
end
