interface Shape:
    func Area(): f64
end

interface Named:
    func Name(): str
end

interface Solid:
    use Shape
    use Named
    func Volume(): f64
    func Describe(): str:
        ret this.Name() + " v=" + this.Volume() + " a=" + this.Area()
    end
end

struct Cube:
    pub s: f64 = 1.0
    pub func Area(): f64: ret 6.0 * this.s * this.s end
    pub func Name(): str: ret "cube" end
    pub func Volume(): f64: ret this.s * this.s * this.s end
end

impl Solid on Cube:
end

func show<T: Solid>(v: T):
    println "static", v.Name(), v.Area(), v.Volume()
end

func draw(v: dyn Solid):
    println "dyn", v.Describe()
end

func main:
    c := Cube { s = 2.0 }
    show(c)
    draw(c as dyn Solid)
    println c.Describe()
end
