interface Shape:
    func Area(): f64
    func Name(): str
end

struct Circle:
    pub r: f64 = 1.0
    pub func Area(): f64: ret 3.0 * this.r * this.r end
    pub func Name(): str: ret "circle" end
end

impl Shape on Circle:
end

struct Sq:
    pub s: f64 = 1.0
    pub func Area(): f64: ret this.s * this.s end
end

impl Shape on Sq:
    func Name(): str: ret "square" end
end

func draw(v: dyn Shape):
    println v.Name(), v.Area()
end

func main:
    draw(Circle { r = 2.0 } as dyn Shape)
    draw(Sq { s = 3.0 } as dyn Shape)
end
