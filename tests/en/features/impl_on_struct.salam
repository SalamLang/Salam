// A struct's methods can come partly from its own body and partly from an
// `impl Iface on Struct` block; either is enough to call the method
// directly or to satisfy a generic bound / dyn coercion.

interface Speaker:
    func speak(): str
end

struct Animal:
    pub name: str
end

impl Speaker on Animal:
    func speak(): str: ret this.name + " makes a sound" end
end

struct Dog:
    pub name: str
    pub func speak(): str: ret this.name + " barks" end
end

func greet<T: Speaker>(x: T): str:
    ret x.speak()
end

func main:
    a := Animal { name = "Cat" }
    println a.speak()
    println greet(a)
    d := Dog { name = "Rex" }
    println greet(d)
    sa := a as dyn Speaker
    sd := d as dyn Speaker
    println sa.speak()
    println sd.speak()
end
