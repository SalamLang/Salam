func check(n: int) throws:
    if n > 2:
        throw Error.New(ErrorKind.OutOfRange, "too big: " + n)
    end
    println "checked " + n
end

func main throws:
    defer println "main done"
    repeat 5 in i:
        try check(i)
    end
end
