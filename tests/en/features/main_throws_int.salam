func half(n: int): int throws:
    if n % 2 != 0:
        throw "odd number: " + n
    end
    ret n / 2
end

func main(): int throws:
    println try half(10)
    try:
        println half(7)
    catch e:
        println e.ToStr()
    end
    ret 0
end
