enum Weekday:
    mon,
    tue,
    wed,
    thu,
    fri,
    sat,
    sun
end

func kind_of_day(d: Weekday): str:
    ret match d:
        sat, sun: "weekend" end
        else: "weekday" end
    end
end

func grade(score: i32): str:
    ret match score / 10:
        10, 9: "A" end
        8: "B" end
        7: "C" end
        else: "F" end
    end
end

func parse_command(word: str): str:
    result := match word:
        "ping": ret 1 end
        "quit": ret true end
        else: ret word end
    end
    ret match result:
        i32 code: "code " + code end
        bool flag: "flag " + flag end
        str text: "unknown: " + text end
    end
end

func main:
    println kind_of_day(Weekday.mon)
    println kind_of_day(Weekday.sat)

    println grade(95)
    println grade(81)
    println grade(40)

    println parse_command("ping")
    println parse_command("quit")
    println parse_command("hello")
end
