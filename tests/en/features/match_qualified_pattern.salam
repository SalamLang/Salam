enum Shape:
    Dot
    Circle(r: int)
end

enum Color:
    Red, Green
end

func area(s: Shape): int:
    ret match s:
        Shape.Circle(r): r * r end
        Shape.Dot: 0 end
    end
end

func name(c: Color): str:
    ret match c:
        Color.Red: "red" end
        Green: "green" end
    end
end

func main:
    println area(Shape.Circle(3)), area(Shape.Dot), name(Color.Red), name(Color.Green)
end
