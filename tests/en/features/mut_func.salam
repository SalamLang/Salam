interface Ticker:
    mut func Tick()
    func Count(): int
end

struct Counter:
    n: int = 0
    last: int[2] = [0, 0]
    log: Vector<int> = Vector {}
    pub func Count(): int:
        ret this.n
    end
    pub mut func Tick():
        this.n += 1
        this.last[0] = this.n
    end
    pub mut func TickTwice():
        this.Tick()
        this.Tick()
    end
    pub func Note(x: int):
        this.log.push(x)
    end
    pub func Notes(): int:
        ret this.log.len()
    end
    pub func Free():
        this.log.free()
    end
end

struct Old:
    pub n: int = 0
    pub func Bump():
        this.n += 1
    end
end

func bump(c &: Counter):
    c.Tick()
end

func drive<T: Ticker>(t &: T): int:
    t.Tick()
    ret t.Count()
end

func main:
    mut c := Counter {}
    c.Tick()
    c.TickTwice()
    bump(c)
    println c.Count()
    println drive(c)
    c.Note(7)
    c.Note(8)
    println c.Notes()
    c.Free()
    o := Old {}
    o.Bump()
    println o.n
end
