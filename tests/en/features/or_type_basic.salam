import str

func describe(v: int or str or bool): str:
    ret match v:
        int n: "int " + str.FromInt(n as i64) end
        str s: "str " + s end
        bool b: "bool " + (b ? "true" : "false") end
    end
end

func main:
    println describe(5)
    println describe("hi")
    println describe(true)
    println describe(false)
end
