import str

struct Cell:
    pub v: int or str = 0
end

func pick(flag: bool): int or str:
    if flag:
        ret 7
    end
    ret "none"
end

func show(v: int or str): str:
    ret match v:
        int n: "n=" + str.FromInt(n as i64) end
        str s: "s=" + s end
    end
end

func takeit(v: int or str): str:
    ret show(v)
end

func main:
    mut c := Cell {}
    println show(c.v)
    c.v = "hello"
    println show(c.v)
    c.v = 9
    println show(c.v)

    println show(pick(true))
    println show(pick(false))

    println takeit(5)
    println takeit("abc")

    mut v := 1 as (int or str)
    println show(v)
    v = "two"
    println show(v)
end
