import str

enum Color:
    Red
    Green
    Blue
end

func render(v: int or f64 or str or bool or Color): str:
    ret match v:
        int n: "int " + str.FromInt(n as i64) end
        f64 f: "float " + str.FromFloat(f) end
        str s: "str " + s end
        bool b: "bool " + (b ? "true" : "false") end
        Color c: "color " + str.FromInt(c as i64) end
    end
end

func main:
    println render(1)
    println render(2.5)
    println render("x")
    println render(false)
    println render(Color.Green)
end
