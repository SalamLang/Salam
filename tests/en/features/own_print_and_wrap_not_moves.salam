struct Query:
    pub fields: Vector<str> = Vector {}
end

func count(q: Query): int:
    ret q.fields.Len()
end

func ask(fields: Vector<str>): int:
    ret count(Query { fields = fields })
end

func main:
    mut v := Vector {} as Vector<int>
    v.Push(1)
    v.Push(2)
    println v
    println v.Len()
    mut f := Vector {} as Vector<str>
    f.Push("title")
    println ask(f)
    println ask(f)
    println f.Len()
    v.Free()
    f.Free()
end
