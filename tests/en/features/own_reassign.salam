 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */


import str

func label(n: int): str:
    ret "n" + str.FromInt(n as i64)
end

func wrap(s: str): str:
    ret "[" + s + "]"
end

func shout(s: str): str:
    ret s + "!"
end

func upto(n: int): str:
    mut out := ""
    repeat n in i:
        out = out + label(i) + ","
    end
    ret out
end

func upto_plus(n: int): str:
    mut out := ""
    repeat n in i:
        out += label(i)
        out += ";"
    end
    ret out
end

func fresh_start(n: int): str:
    mut out := "<" + label(0)
    repeat n in i:
        out += str.FromInt(i as i64)
    end
    ret out
end

func scoped(n: int): int:
    mut out := ""
    repeat n in i:
        out += label(i)
    end
    println out
    ret str.Len(out)
end

func skips(n: int): str:
    mut out := ""
    repeat n in i:
        if i == 1:
            continue
        end
        if i == 4:
            break
        end
        out += label(i)
    end
    ret out
end

func nested(): str:
    mut out := ""
    repeat 3 in i:
        repeat 2 in j:
            out = out + str.FromInt(i as i64) + str.FromInt(j as i64) + " "
        end
    end
    ret out
end

func wrapped(n: int): str:
    mut s := "x"
    repeat n:
        s = wrap(s)
    end
    ret s
end

func reset(): str:
    mut out := ""
    repeat 3 in i:
        out += label(i)
        if i == 1:
            out = ""
        end
    end
    ret out
end

func alias(): int:
    mut out := ""
    mut saved := ""
    repeat 3 in i:
        out += label(i)
        if i == 1:
            saved = out
        end
    end
    println saved
    ret str.Len(saved) + str.Len(out)
end

func borrowed(s: str): str:
    mut t := s
    repeat 2:
        t += "+"
    end
    ret t
end

func by_ref(o &: str, n: int):
    repeat n in i:
        o = o + label(i)
    end
end

func arms(n: int): str:
    mut out := ""
    repeat n in i:
        switch i % 3:
            0:
                out += "a"
            end
            1:
                out += "b"
            end
            else:
                out = shout(out)
            end
        end
    end
    ret out
end

func unused_loop(n: int): int:
    mut out := ""
    repeat n:
        out += "z"
    end
    ret 0
end

func both(a: bool): str:
    mut out := "start"
    if a:
        out += "-yes"
    else:
        out += "-no"
    end
    println out
    out += "."
    println str.Len(out)
    ret out
end

func chain(n: int): str:
    if str.Len(label(n) + "x") == 99:
        ret "a"
    else str.Len(label(n) + "yy") == 4:
        ret "b"
    else str.Len(wrap(label(n))) > 100:
        ret "c"
    else str.Len(shout(label(n) + "q")) == 7:
        ret "d"
    else:
        ret "e"
    end
end

func kept(): int:
    mut out := ""
    mut seen := Vector {} as Vector<str>
    repeat 3:
        out += "k"
        seen.Push(out)
    end
    out += "z"
    total := str.Len(out) + str.Len(seen.Get(0)) + str.Len(seen.Get(2))
    seen.Free()
    ret total
end

func same_name(k: int, n: int): str:
    if k == 1:
        mut out := "a["
        repeat n in i:
            if i > 0: out += "," end
            out += "x"
        end
        ret out + "]"
    end
    if k == 2:
        mut out := "b{"
        repeat n in i:
            if i > 0: out += "," end
            out += "y"
        end
        ret out + "}"
    end
    ret "?"
end

func main:
    println upto(4)
    println upto_plus(3)
    println fresh_start(3)
    println scoped(3)
    println skips(7)
    println nested()
    println wrapped(3)
    println reset()
    println alias()
    lit := "lit"
    println borrowed(lit)
    println lit
    mut acc := "r"
    by_ref(acc, 3)
    println acc
    println arms(7)
    println unused_loop(5)
    println both(true)
    println both(false)
    println upto(0)
    println chain(0)
    println chain(12)
    println chain(123)
    println chain(1234)
    println kept()
    println same_name(1, 3)
    println same_name(2, 2)
    println same_name(3, 0)
end
