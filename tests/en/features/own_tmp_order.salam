import str

mut calls := 0
mut keep := ""

func tick(): int:
    calls++
    ret calls
end

func label(n: int): str:
    ret "n" + str.FromInt(n as i64)
end

func peek(s: str): int:
    ret str.Len(s)
end

func stash(s: str): int:
    keep = s
    ret str.Len(s)
end

func pair(a: int, b: str): int:
    ret a * 100 + str.Len(b)
end

func order(): int:
    ret pair(tick(), "x" + str.FromInt((calls * 1000) as i64))
end

func lazy(flag: bool, a: str): bool:
    ret flag and str.Equals(a + "!", "ok!")
end

func pick(flag: bool, a: str): int:
    ret flag ? peek(a + "1") : peek(a + "22")
end

func main:
    println order()
    println order()
    println peek("ab" + label(7))
    println stash("kept" + label(1))
    println keep
    println lazy(false, "ok")
    println lazy(true, "ok")
    println lazy(true, "no")
    println pick(true, "q")
    println pick(false, "q")
    if peek(label(2) + label(3)) == 4:
        println "four"
    end
    println keep
end
