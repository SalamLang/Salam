 */
struct Stack:
    pub items: Vector<int> = Vector {}
    pub count: int = 0
    pub func Push(x: int):
        this.items.Push(x)
        this.count++
    end
    pub func Len(): int: ret this.items.Len() end
end

func main:
    mut v := Vector {} as Vector<int>
    v.Push(3)
    v.Push(4)
    v.Push(5)
    println v.Len(), v.Get(0), v.Pop(), v.Cap() >= 3
    v.Set(0, 9)
    println v.Get(0), v.Ref(1)[0]
    mut m := HashMap {} as HashMap<str, int>
    m.Put("a", 1)
    m.Put("b", 2)
    println m.Has("a"), m.Get("a"), m.Size()
    m.Remove("a")
    println m.Has("a"), m.Size()
    s := "  Salam Dunya  "
    t := s.Trim()
    println t.StartsWith("Sa"), t.EndsWith("ya"), t.Includes("la"), t.Find("D"), t.Substr(1, 4)
    println t.Upper(), t.Lower(), "12".ToInt(), "2.5".ToFloat()
    println t.CharCount(), t.CharAt(0), t.CharSubstr(0, 3), t.CharFind("D")
    parts := t.Split(" ")
    println parts.Len(), parts.Get(1)
    println "ab".Repeat(3), "ab".Concat("cd")
    n := v.Len()
    w := v.DeepCopy()
    w.Push(7)
    println n, w.Len()
    mut st := Stack {}
    st.Push(1)
    st.Push(2)
    println st.Len(), st.count
    each k, x in m:
        println k, x
    end
    w.Free()
    m.Free()
    parts.Free()
end
