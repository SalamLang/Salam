import mem

struct State:
    pub items: Vector<int>
    pub n: int
end

struct Client:
    pub p: State*
end

func state_of(c: Client): State*:
    ret c.p
end

func main:
    p := mem.AllocateZeroed(64 as u64) as State*
    p[0].items = Vector {} as Vector<int>
    c := Client { p = p }
    state_of(c)[0].items.push(5)
    state_of(c)[0].items.push(6)
    state_of(c)[0].n += 1
    state_of(c)[0].n = state_of(c)[0].n * 10
    println state_of(c)[0].items.len()
    println p[0].items.len(), p[0].n
    p[0].items.free()
    mem.Free(p as void*)
end
