struct Box:
    pub n: int = 0
    pub items: int[3] = [0, 0, 0]
end

struct Counter:
    pub hits: int = 0
    pub func Hit():
        increase(this.hits)
    end
end

func increase(n &: int):
    n += 1
end

func twice(n &: int):
    increase(n)
    increase(n)
end

func bump box(b &: Box):
    increase(b.n)
    increase(b.items[1])
end

func make box(k: int): Box:
    ret Box { n = k }
end

func peek(b &: Box): int:
    b.n += 1
    ret b.n
end

func main:
    mut x := 3
    increase(x)
    twice(x)
    println x
    mut b := Box {}
    bump box(b)
    increase(b.n)
    println b.n, b.items[1]
    mut arr := [1, 2, 3]
    increase(arr[2])
    println arr[2]
    mut c := Counter {}
    c.Hit()
    c.Hit()
    println c.hits
    mut nums := Vector {} as Vector<int>
    nums.push(7)
    p := nums.ref(0)
    increase(p)
    increase(p[0])
    increase(nums.ref(0))
    println nums.get(0)
    nums.free()
    println peek(make box(4))
end
