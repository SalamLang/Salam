import result

mut calls := 0

func parse(s: str): result.Result<int, str>:
    calls += 1
    if s == "7":
        ret result.Result.Ok(7)
    end
    if s == "9":
        ret result.Result.Ok(9)
    end
    ret result.Result.Err("bad " + s)
end

func sum(a: str, b: str): result.Result<int, str>:
    defer println "leaving sum"
    x := parse(a)?
    mut y := 0
    y = parse(b)?
    ret result.Result.Ok(x + y)
end

func check(a: str): result.Result<bool, str>:
    parse(a)?
    ret result.Result.Ok(true)
end

func helpers():
    a := parse("7")
    b := parse("q")
    println result.IsOk(a)
    println result.IsErr(b)
    println result.UnwrapOr(b, 0)
    println result.Expect(a, "no")
end

func main:
    helpers()
    println sum("7", "9")
    println sum("7", "q")
    println sum("z", "9")
    println check("7")
    println check("x")
    println calls
end
