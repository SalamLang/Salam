mut g := [1, 2, 3]

struct Box:
    pub arr: int[3] = [0, 0, 0]

    pub func view(): int[]:
        ret this.arr[:]
    end
end

func pass(xs: int[]): int[]:
    ret xs[1:]
end

func glob(): int[]:
    ret g[:]
end

func main:
    g[0] = 1
    b := Box {}
    println len(pass([1, 2, 3])), len(glob()), len(b.view())
end
