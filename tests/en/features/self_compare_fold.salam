func bump(n &: int): int:
    n += 1
    ret n
end

func main:
    a := 6
    b := 3
    mut c := 1
    println (a & b) == (b & a), (a + b) != (b + a), a < a, (a * b) <= (b * a)
    println bump(c) == bump(c), c
    f := 0.5
    println f == f, (a - b) == (b - a)
end
