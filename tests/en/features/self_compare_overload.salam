mut calls := 0

struct Meter:
    pub n: int = 0

    pub func operator_sub(): int:
        calls += 1
        ret 0 - this.n
    end

    pub func operator_add(o: Meter): int:
        calls += 1
        ret this.n + o.n
    end
end

func main:
    v := Meter { n = 3 }
    w := Meter { n = 4 }
    println (-v) == (-v), calls
    println (v + w) == (v + w), calls
end
