struct Node:
    pub v: int = 0
    pub func With(n: int): Self:
        ret Self { v = n }
    end
    pub static func Make(n: int): Self:
        ret Self { v = n * 2 }
    end
end

struct Pair<A, B>:
    pub first: A
    pub second: B
    pub static func Of(x: A, y: B): Self:
        ret Self { first = x, second = y }
    end
    pub func Swapped(): Pair<B, A>:
        ret Pair { first = this.second, second = this.first }
    end
end

type Meters: int
    func Twice(): Self:
        ret ((this as int) * 2) as Self
    end
end

func main:
    n := Node {}.With(5)
    println n.v
    println Node.Make(4).v
    p := Pair.Of(1, "x")
    println p.first, p.second
    println p.Swapped().first
    m := 3 as Meters
    println m.Twice() as int
end
