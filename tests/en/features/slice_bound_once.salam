mut calls := 0

func lo(): int:
    calls += 1
    ret 1
end

func total(xs: int[]): int:
    mut s := 0
    each x in xs:
        s += x
    end
    ret s
end

func pick(k: int): int:
    a := [10, 20, 30]
    sl := match k:
        1: a[1:] end
        else: a[:1] end
    end
    ret total(sl)
end

func main:
    println total([1, 2, 3, 4][lo():]), calls
    println pick(1), pick(0)
end
