func total(xs: int[]): int:
    mut t := 0
    each x in xs: t += x end
    ret t
end

func main:
    println total([1, 2, 3, 4][:]), total([1, 2, 3, 4][1:3]), total([5, 6][1:])
    names := ["a", "b", "c"][:]
    println names.len(), names[2]
end
