// A slice is a view onto its array. Writing through one that a callee
// received changes the array, and taking the slice is what makes the
// `mut` on that array real.

struct Buf:
    pub data: int[4]
end

func fill(xs: int[:], v: int):
    repeat len(xs) with i:
        xs[i] = v
    end
end

func total(xs: int[:]): int:
    mut t := 0
    each x in xs: t += x end
    ret t
end

func main:
    mut a := [1, 2, 3, 4, 5]
    println total(a[:]), total(a[1:3])
    fill(a[2:], 0)
    println a
    mut b := Buf { data = [9, 9, 9, 9] }
    fill(b.data[1:3], 0)
    println b.data
    view := a[:2]
    view[0] = 7
    println a[0], len(view)
end
