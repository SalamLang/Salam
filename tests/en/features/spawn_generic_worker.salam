import mem

struct Box<T>:
    pub n: int = 0
    pub done: bool = false
end

func worker<T>(b: Box<T>*):
    b.n = b.n * 2
    b.done = true
end

func main:
    p := mem.Allocate(sizeof(Box<int>)) as Box<int>*
    p.n = 21
    t := spawn(worker, p)
    join(t)
    println p.n, p.done
    p.n = 4
    p.done = false
    t2 := spawn(worker<int>, p)
    join(t2)
    println p.n, p.done
    mem.Free(p as void*)
end
