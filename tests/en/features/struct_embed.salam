include zoo "_struct_embed_zoo.salam"

interface Describer:
    func Describe(): str
end

struct Being:
    pub alive: bool = true
    pub func Breathe(): str:
        ret "breathing"
    end
end

struct Animal:
    pub use Being
    pub name: str = ""
    legs: int = 4
    pub func Describe(): str:
        ret this.name + " has " + this.legs + " legs"
    end
    pub mut func Rename(n: str):
        this.name = n
    end
end

struct Dog:
    pub use Animal
    pub breed: str = ""
    pub func Bark(): str:
        ret this.name + " woofs"
    end
end

struct Cat:
    pub use zoo.Animal
    pub func Describe(): str:
        ret "cat " + this.name
    end
end

func show(d: dyn Describer): str:
    ret d.Describe()
end

func tell<T: Describer>(t: T): str:
    ret t.Describe()
end

func main:
    mut d := Dog { name = "Rex", breed = "lab" }
    println d.Bark()
    println d.Describe()
    d.Rename("Max")
    println d.name
    d.name = "Bo"
    println d.Animal.name
    println d.alive
    println d.Breathe()
    println tell(d)
    println show(d as dyn Describer)
    println d
    e := Dog { Animal = Animal { name = "Tri" }, breed = "mix" }
    println e.Describe()
    c := Cat { name = "Tom" }
    println c.Describe()
    println c.Animal.Describe()
    t := c.Tagged(zoo.Tag { label = "x" })
    println t.label
end
