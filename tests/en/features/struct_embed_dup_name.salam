include zoo "_struct_embed_dup_zoo.salam"

struct Animal:
    pub name: str = ""
    pub func Describe(): str: ret "local " + this.name end
end

struct Dog:
    pub use Animal
end

struct Cat:
    pub use zoo.Animal
end

func main:
    d := Dog { name = "Rex" }
    println d.Describe()
    c := Cat { name = "Tom" }
    println c.Who()
end
