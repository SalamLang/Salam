struct Stack<T>:
    pub items: Vector<T> = Vector {}
    pub mut func Push(x: T):
        this.items.push(x)
    end
    pub func Top(): T:
        ret this.items.get(this.items.len() - 1)
    end
    pub func Size(): int:
        ret this.items.len()
    end
    pub mut func Free():
        this.items.free()
    end
end

struct History:
    pub use Stack<str>
    pub title: str = "h"
end

func main:
    mut h := History {}
    h.Push("a")
    h.Push("b")
    println h.Top()
    println h.Size()
    println h.items.len()
    h.Free()
end
