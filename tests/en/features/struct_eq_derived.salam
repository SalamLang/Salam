enum Kind: Small, Large end

struct Pt:
    pub x: int
    pub y: int
end

struct Shape:
    pub name: str
    pub kind: Kind
    pub origin: Pt
    pub dims: int[2]
    pub scale: f64 = 1.0
end

struct Approx:
    pub v: f64
    pub func operator_eq(o: Approx): bool:
        d := this.v - o.v
        ret d < 0.01 && d > -0.01
    end
end

func main:
    a := Pt { x = 1, y = 2 }
    b := Pt { x = 1, y = 2 }
    c := Pt { x = 2, y = 2 }
    println a == b, a == c, a != c

    s1 := Shape { name = "box", kind = Kind.Small, origin = a, dims = [3, 4] }
    s2 := Shape { name = "box", kind = Kind.Small, origin = b, dims = [3, 4] }
    s3 := Shape { name = "box", kind = Kind.Small, origin = b, dims = [3, 5] }
    s4 := Shape { name = "box", kind = Kind.Large, origin = b, dims = [3, 4] }
    println s1 == s2, s1 == s3, s1 != s4

    println Approx { v = 1.0 } == Approx { v = 1.001 }, Approx { v = 1.0 } == Approx { v = 2.0 }

    pts := [a, c]
    println pts[0] == a, pts[1] == a
end
