include tidpkg "_type_identity_pkg.salam"
include tidpkg2 "_type_identity_pkg2.salam"

struct tidpkg_Item:
    pub s: str = "local"
    pub f: f64 = 2.5
end

struct Box<T>:
    pub v: T
end

func Show<T>(x: T): str:
    b := Box { v = x } as Box<T>
    println b
    ret "shown"
end

func Twice<T>(x: T): T:
    ret x + x
end

func main:
    x := tidpkg.New()
    y := tidpkg_Item {}
    println x.n, y.s, y.f
    println x, y
    println tidpkg.Get(x)
    println Show(tidpkg.New())
    println Show(tidpkg_Item {})
    println Twice(tidpkg.Make()) as int
    println Twice(tidpkg2.Make()) as f64
end
