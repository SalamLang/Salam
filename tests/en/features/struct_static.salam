include tp "_struct_static_pkg.salam"

struct Color:
    pub r: int
    pub g: int
    pub b: int
    hidden: int = 0
    pub const Max := 255
    pub static func Gray(v: int): Color:
        ret Color { r = v, g = v, b = v, hidden = Color.Salt() }
    end
    pub static func White(): Color:
        ret Color.Gray(Color.Max)
    end
    static func Salt(): int:
        ret 42
    end
    pub func Sum(): int:
        ret this.r + this.g + this.b + Color.Salt() - this.hidden
    end
end

func main:
    c := Color.Gray(10)
    println c.Sum()
    w := Color.White()
    println w.r
    println Color.Max
    t := tp.Temp.FromF(212)
    println t.c
    println tp.Temp.Boiling
end
