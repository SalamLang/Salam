struct Box<T>:
    pub items: Vector<T> = Vector {}
    pub static func Of(x: T): Box<T>:
        mut b := Box {} as Box<T>
        b.items.push(x)
        ret b
    end
    pub static func Empty(): Box<T>:
        ret Box {}
    end
    pub func Len(): int:
        ret this.items.len()
    end
    pub func Free():
        this.items.free()
    end
end

func make(): Box<str>:
    ret Box.Empty()
end

func main:
    b := Box.Of(42)
    println b.Len()
    c := make()
    println c.Len()
    d := Box.Empty() as Box<f64>
    println d.Len()
    b.Free()
    c.Free()
    d.Free()
end
