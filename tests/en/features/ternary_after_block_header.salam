func pick(n: int): int:
    if n > 1 ? true : false:
        ret 1
    end
    ret 0
end

func main:
    x := 5
    if x > 1:
        println "block"
    end
    y := x > 1 ? 10 : 20
    println y
    z := x > 9 ? x > 3 ? 1 : 2 : 3
    println z
    println pick(5)
    println pick(0)
end
