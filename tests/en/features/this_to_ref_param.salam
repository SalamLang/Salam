struct Vec2:
    pub x: int
    pub y: int

    pub func dot(other &: Vec2): int:
        ret this.x * other.x + this.y * other.y
    end
    pub func norm2(): int:
        ret this.dot(this)
    end
    pub func grow(): void:
        scale(this, 3)
    end
end

func scale(v &: Vec2, k: int): void:
    v.x = v.x * k
    v.y = v.y * k
end

func sum(v &: Vec2): int:
    ret v.x + v.y
end

func main:
    mut v := Vec2 { x = 1, y = 2 }
    println v.norm2()
    v.grow()
    println v.x, v.y
    println sum(v)
end
