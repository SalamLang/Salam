func half(n: int): int throw:
    if n % 2 != 0:
        throw "odd: " + n
    end
    ret n / 2
end

func check(n: int) throw:
    if n < 0:
        throw "negative"
    end
end

func main throw:
    println try half(8)
    println try half(3) catch 0
    try:
        check(0 - 1)
    catch e:
        println e.message
    end
end
