include throwsshadow "_throws_shadow_pkg.salam"

func main:
    e := throwsshadow.Make(3)
    println e.code
    mine := Error.New(ErrorKind.NotFound, "made with New")
    println mine.message
    lit := Error { kind = ErrorKind.Io, message = "made with a literal" }
    println lit.to_str(), lit.is(ErrorKind.Io)
    try:
        println throwsshadow.Check(5)
        println throwsshadow.Check(0 - 1)
    catch err:
        println err.to_str()
    end
end
