interface Source:
    func read(): str throws
end

struct Fixed:
    pub text: str = ""
    pub func read(): str throws:
        if this.text == "":
            throw Error.New(ErrorKind.UnexpectedEnd, "nothing to read")
        end
        ret this.text
    end
end

struct Account:
    pub balance: int = 0
    pub mut func withdraw(amount: int) throws:
        if amount > this.balance:
            throw Error.New(ErrorKind.InvalidArgument, "insufficient funds")
        end
        this.balance -= amount
    end
end

func read_twice<T: Source>(src: T): str throws:
    a := try src.read()
    ret a + a
end

func main:
    good := Fixed { text = "ab" }
    empty := Fixed {}
    try:
        println read_twice(good)
        println read_twice(empty)
    catch e:
        println "read failed: " + e.message
        println e.is(ErrorKind.UnexpectedEnd)
    end
    mut acc := Account { balance = 10 }
    try:
        acc.withdraw(4)
        acc.withdraw(4)
        acc.withdraw(4)
    catch e:
        println e.message
    end
    println acc.balance
    f := (n: int): ret n + 1 end
    println f(1)
end
