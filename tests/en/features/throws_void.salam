mut saved := Vector {} as Vector<int>

func save(n: int) throws:
    defer println "save " + n + " done"
    if n % 3 == 0:
        throw Error.New(ErrorKind.Io, "cannot save " + n)
    end
    saved.Push(n)
end

func save_all(items: Vector<int>) throws:
    each n in items:
        try save(n)
    end
end

func first_failure(limit: int): int:
    mut i := 1
    until i <= limit:
        try:
            defer println "leaving try " + i
            save(i)
        catch e:
            println "stop: " + e.message
            ret i
        end
        i++
    end
    ret 0 - 1
end

func count_saved(limit: int): int:
    mut ok := 0
    repeat limit in i:
        try:
            save(i + 1)
            ok++
        catch:
            println "skip " + (i + 1)
        end
        if ok == 3:
            break
        end
    end
    ret ok
end

func main:
    println first_failure(10)
    println count_saved(10)
    mut items := Vector {} as Vector<int>
    items.Push(1)
    items.Push(2)
    items.Push(6)
    items.Push(7)
    try:
        save_all(items)
        println "all saved"
    catch e:
        println "save_all failed: " + e.ToStr()
    end
    println saved.Len()
end
