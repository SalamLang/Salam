func main:
    a := 2 *
        3
    b := 2 **
        3
    c := 6 &
        3
    d := 4 |
        1
    e := 5 ^
        1
    f := 1 <<
        4
    g := 64 >>
        2
    mut h := 3
    h *=
        4
    println a
    println b
    println c
    println d
    println e
    println f
    println g
    println h
end
