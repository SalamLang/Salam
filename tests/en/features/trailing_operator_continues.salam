func main:
    a := 2 *
        3
    b := 2 **
        3
    c := 6 &
        3
    d := 4 |
        1
    e := 5 ^
        1
    f := 1 <<
        4
    g := 64 >>
        2
    mut h := 3
    h *=
        4
    println a
    println b
    println c
    println d
    println e
    println f
    println g
    println h
    mut m := 12
    m &=
        10
    m |=
        1
    m ^=
        3
    m <<=
        2
    m >>=
        1
    println m
    s := "A"
    p := s as i8 *
    println p[0]
    mut grid := Vector {} as Vector<Vector<int>>
    mut _o: int?
    println grid.Len()
end
