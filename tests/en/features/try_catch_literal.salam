func name_of(id: int): str throw:
    if id < 0:
        throw Error.New(ErrorKind.InvalidArgument, "negative id")
    end
    ret "user" + id
end

func is_admin(id: int): bool throw:
    if id < 0:
        throw "negative id"
    end
    ret id == 1
end

func main:
    println try name_of(7) catch "?"
    println try name_of(-1) catch "?"
    println try is_admin(1) catch false
    println try is_admin(-1) catch false
end
