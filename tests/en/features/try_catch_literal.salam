func name of(id: int): str throws:
    if id < 0:
        throw Error.New(ErrorKind.InvalidArgument, "negative id")
    end
    ret "user" + id
end

func is admin(id: int): bool throws:
    if id < 0:
        throw "negative id"
    end
    ret id == 1
end

func main:
    println try name of(7) catch "?"
    println try name of(-1) catch "?"
    println try is admin(1) catch false
    println try is admin(-1) catch false
end
