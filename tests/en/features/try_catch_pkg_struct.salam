include throwsshadow "_throws_shadow_pkg.salam"

func code of(c: int): int:
    e := throwsshadow.Error { code = try throwsshadow.Check(c) catch 0 }
    ret e.code
end

func main:
    fallback := throwsshadow.Error { code = 7 } as throwsshadow.Error
    println fallback.code
    println code of(5)
    println code of(-1)
    picked := try throwsshadow.Pick(-2) catch throwsshadow.Error { code = 99 }
    println picked.code
    kept := try throwsshadow.Pick(3) catch throwsshadow.Error {}
    println kept.code
end
