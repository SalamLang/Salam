import conv

struct Box:
    pub pos: (int, int)
    pub label: str
end

type Pf = func (int) (int, str)

func parse(s: str): (i64, bool) throws:
    v := try conv.ParseInt(s)
    ret v, v > 10
end

func apply(cb: Pf, x: int): (int, str):
    ret cb(x)
end

func swap(p: (int, str)): (str, int):
    a, b := p
    ret b, a
end

func nested(): ((int, int), str):
    ret (1, 2), "n"
end

func fl(): (f64, i64, str):
    ret 1.5, 3, "z"
end

func main:
    try:
        v, big := try parse("42")
        println v, big
    catch e:
        println "err", e.message
    end
    s, i := swap((5, "five"))
    println s, i
    pair, tag := nested()
    pa, pb := pair
    println pa, pb, tag
    bx := Box { pos = (3, 4), label = "box" }
    bx1, bx2 := bx.pos
    println bx1, bx2, bx.label
    mut items := Vector {} as Vector<(int, str)>
    items.Push((1, "a"))
    items.Push((2, "b"))
    each k, it in items:
        n, w := it
        println k, n, w
    end
    r1, r2 := apply((x: int): ret x * 2, "twice" end, 21)
    println r1, r2
    g := (x: int): ret x + 1 end
    println g(1)
    fa, fb, fc := fl()
    println fa, fb, fc
    m := HashMap {} as HashMap<str, (int, int)>
    mut mm := m
    mm.Put("k", (9, 8))
    m1, m2 := mm.Get("k")
    println m1, m2
end
