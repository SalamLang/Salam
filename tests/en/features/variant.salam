struct Reading:
    pub sensor: str
    pub value: i32 or f64 or str
end

func describe(v: i32 or f64 or str): str:
    ret match v:
        i32 n: "int " + n end
        f64 f: "float " + f end
        str err: "error: " + err end
    end
end

func main:
    mut sample := 21 as (i32 or f64 or str)
    println describe(sample)

    sample = 21.5
    println describe(sample)

    sample = "sensor offline"
    println describe(sample)

    readings := [
        Reading { sensor = "temp", value = 21.5 }, Reading { sensor = "humidity", value = 55 }, Reading { sensor = "pressure", value = "sensor offline" }
    ]
    repeat 3 in i:
        r := readings[i]
        println r.sensor + ": " + describe(r.value)
    end
end
