struct Holder:
    pub v: Variant<i32, str> = 5 as Variant<i32, str>
    pub w: Variant<i32, str> = "x"
    pub z: Variant<i32, str> = 7
end

func show(v: Variant<i32, str>): str:
    ret match v:
        i32 n => "int " + n
        str s => "str " + s
    end
end

func main:
    h := Holder {}
    println show(h.v), show(h.w), show(h.z)
    h2 := Holder { w = 3 }
    println show(h2.w), show(h2.z)
end
