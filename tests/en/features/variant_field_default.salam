struct Holder:
    pub v: i32 or str = 5 as (i32 or str)
    pub w: i32 or str = "x"
    pub z: i32 or str = 7
end

func show(v: i32 or str): str:
    ret match v:
        i32 n: "int " + n end
        str s: "str " + s end
    end
end

func main:
    h := Holder {}
    println show(h.v), show(h.w), show(h.z)
    h2 := Holder { w = 3 }
    println show(h2.w), show(h2.z)
end
