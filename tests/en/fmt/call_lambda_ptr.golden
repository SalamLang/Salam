package fmtfixes

struct Holder:
    pub hs: Vector<int>** = null
    pub tail: int* = null
end

func apply(v: int, f: func (int) int): int:
    ret f(v)
end

func main:
    h := Holder {}
    println h.hs == null, h.tail == null
    r := apply(
        3, (n: int): m := n + 1 ret m * 2 end
    )
    println r
end
