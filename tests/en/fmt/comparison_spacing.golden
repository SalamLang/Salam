func main:
    x := 3
    v := Vector {} as Vector<Vector<int>>
    fs := Vector {} as Vector<func (int) int>
    if x > 0 and x < 10:
        println x<<1, x>>1, v.len(), fs.len()
    end
    println x >= 3, x <= 2
end
