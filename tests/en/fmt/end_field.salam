struct Span:
  pub start: int = 0
    pub end: int = 0
  pub name: str = ""
end

func Width(s: Span): int:
    ret s.end - s.start
end

func main:
    mut s := Span { start = 2, end = 9, name = "x" }
    s.end++
    println Width(s), s.end, s.name
end
