func add(r &: int, v: int):
    r += v
end

func pick(c: int): int:
    mut r := 0
    if c > 0:
        if c == 1: add(r, 1)
        else c == 2: add(r, 2)
        else c == 3: add(r, 3)
        else c == 4: add(r, 4)
        else:
            add(r, 9)
        end
        r += 100
    end
    ret r
end

func main:
    println pick(3)
    println pick(7)
    x := pick(1)
    if x > 100: println "big"
    else:
        println "small"
    end
end
