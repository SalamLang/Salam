struct Resp:
    pub type: str = ""
        pub mut: int = 0
        pub if: bool = false
        end

        pub func main:
            mut r := Resp { type = "json", mut = 5, if = true }
            println r.type, r.mut, r.if
            r.type = "html"
            r.mut = 9
            println r.type, r.mut, r.if
        end
