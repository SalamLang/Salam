package fmtlambdas

func apply(f: func (int) int, v: int): int:
    ret f(v)
end

func pair(f: func (int, int) int, a: int, b: int): int:
    ret f(a, b)
end

func make adder(n: int): func (int) int: ret (x: int): ret x + n end end

func main:
    inc := (n: int): ret n + 1 end
    println inc(1)
    println apply((n: int): ret n * 2 end, 21)
    println pair((a: int, b: int): ret a * b end, 6, 7)
    add5 := make adder(5)
    println add5(10)
    sq := (x: int):
        y := x * x
        ret y + 1
    end
    println sq(3)
    nested := (x: int): ret apply((y: int): ret y + 1 end, x) end
    println nested(41)
end
