func add(
    a: int
    b: int
): int:
    ret a + b
end

func main:
    names := [
        "ada"
        "alan"
        "grace"
    ]
    s := "abc"
    println names.len()
    println add(
        1
        2
    )
    println add(1,
        2)
    println add(s
        .len(), 1)
    println add(1
        + 2, 3)
end
