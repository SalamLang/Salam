struct Box:
    pub a: int?
    pub b: str? = "x"
    pub c: Vector<int?> = Vector {}
end

func f(x: int?, y: int? = null): int?:
    if x.is_some():
        ret x
    end
    ret y
end

func main:
    t := 3 > 2 ? 1 : 0
    b := Box { a = t }
    v := 4 as int?
    println t < 2 ? 1 : 2, b.a.value, v.value, f(1).unwrap(), f(null).is_none()
end
