// Everything here is in the wrong order on purpose. The formatter reorders
// top-level declarations by default, so this file only builds at all once it
// has been through `salam format` - which is exactly what this test checks,
// along with the result being stable on a second pass.

pub func total(): int:
    ret base() + EXTRA
end

func base(): int:
    ret 40
end

// A package below the first statement is a *parse* error, so hoisting it is
// what lets the rest of the file be parsed and reordered at all.
package orderfix

// The import moves up as one unit, keyword and all.
import str

const EXTRA := 2

func main:
    println total(), str.Len("ab")
end
