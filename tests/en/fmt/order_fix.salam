pub func total(): int:
    ret base() + EXTRA
end

func base(): int:
    ret 40
end

package orderfix

import str

const EXTRA := 2

pub struct Holder:
    pub t: Tag = Tag {}
end

pub enum Level: Low, High end

struct Tag:
    pub n: int = 3
end

enum Mode: Off, On end

func main:
    println total(), str.Len("ab"), Holder {}.t.n, Level.High as int, Mode.On as int
end
