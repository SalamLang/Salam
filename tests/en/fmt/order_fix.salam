// Everything here is in the wrong order on purpose. The formatter reorders
// top-level declarations by default, so this file only builds at all once it
// has been through `salam format` - which is exactly what this test checks,
// along with the result being stable on a second pass.

pub func total(): int:
    ret base() + EXTRA
end

func base(): int:
    ret 40
end

// A package below the first statement is a *parse* error, so hoisting it is
// what lets the rest of the file be parsed and reordered at all.
package orderfix

// The import moves up as one unit, keyword and all.
import str

const EXTRA := 2

// Types split by visibility the same way functions do: the private ones
// gather first, the pub ones after. Reordering them is safe because
// declaration order carries no meaning for types - Holder below is declared
// before the Tag it holds by value.
pub struct Holder:
    pub t: Tag = Tag {}
end

pub enum Level: Low, High end

struct Tag:
    pub n: int = 3
end

enum Mode: Off, On end

func main:
    println total(), str.Len("ab"), Holder {}.t.n, Level.High as int, Mode.On as int
end
