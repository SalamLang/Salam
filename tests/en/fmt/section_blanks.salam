package sections
import str
extern:
    func abs(x: int): int
end
pub const LOW := 1
pub const HIGH := 2
const STEP := 3

const LIMIT := 4
mut hits := 0
// kept with the struct below
pub struct Box:
    pub n: int = 0
end
pub struct Pair:
    pub a: int = 0
end
func bump(): int:
    hits += STEP
    ret hits
end
func main:
    println str.Len("ab"), abs(0 - 4), LOW + HIGH + LIMIT, bump(), Box {}.n, Pair {}.a
end
