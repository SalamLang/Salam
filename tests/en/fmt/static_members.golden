package staticmembers

const BASE := 10

type Cm: int
    func show(): int:
        ret this as int
    end
end

enum Shape:
    Circle(r: int)
    Square(s: int)
end

struct Color:
    pub r: int = 0
    pub const Max := 255
    pub static func Gray(v: int): Color:
        ret Color { r = v + Color.Salt() }
    end
    static func Salt(): int:
        ret 1
    end
end

func twice(n: int): int:
    ret n * 2
end

func area(s: Shape): int:
    ret match s:
        Circle(r): r * r * 3 end
        Square(x): x * x end
    end
end

func main:
    c := 5 as Cm
    println twice(BASE), c.show(), area(Shape.Square(4)), Color.Gray(2).r, Color.Max
end
