package fmtthrows

func half(n: int): int throws:
  if n % 2 != 0:
        throw "odd: " + n
  end
  ret n / 2
end

func check(n: int) throws:
    if n < 0: throw "negative" end
end

func main(): int throws:
    total := try half(8)
    println try half(3) catch 0
    try:
      check(1)
          println half(6)
      println half(5)
    catch e:
            println e.message
    end
    try:
        check(-1)
    catch:
      println "skipped"
    end
    ret total - 4
end
