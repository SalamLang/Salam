func divmod(a:int,b:int):(int,int):
    ret a/b,a%b
end

func pair():(int,str):
    ret 7,"seven"
end

func apply(cb:func (int) (int,str),v:int):(int,str):
    ret cb(v)
end

func main:
    q,r:=divmod(17,5)
    println q,r
    n,name:=pair()
    println n,name
    mut x,mut y:=divmod(9,4)
    x,y=y,x
    println x,y
    t:=pair()
    println t.0,t.1
    items:=Vector {} as Vector<(int,str)>
    mut list:=items
    list.Push((1,"a"))
    each k,it in list:
        a,b:=it
        println k,a,b
    end
    c,d:=apply((z:int):ret z*2,"twice" end,21)
    println c,d
end
