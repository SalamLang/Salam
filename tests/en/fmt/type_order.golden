package fmttypeorder

pub struct Box:
    pub v: int = 0
end

type Count = int

enum Mode:
    Fast, Slow
end

pub interface Sized:
    func Size(): int
end

impl Sized on Box:
    func Size(): int:
        ret this.v * 2
    end
end

func helper(): int:
    ret 3
end

pub func Api(): int:
    ret helper()
end

func main:
    b := Box { v = 21 }
    n := b.Size() as Count
    println n, Api(), Mode.Fast != Mode.Slow
end
