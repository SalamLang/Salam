component PadKey(key: str, label: str, col: int, line: int):
    button:
        id = key
        content = label
        column = col
        row = line
        font size = 20
        line height = 1
        color = #e8e8ff
        background = #2b3f9e4d
        border = 2, solid, #2b3f9e
        radius = 14
        touch action = none
        selectable = false
        cursor = pointer
        active:
            background = #7cf7c459
            border color = #7cf7c4
        end
    end
end

page:
    title = "Salam Pac-Man"
    background = "radial(circle, [50%, 0%], #141433 0%, #05050f 70%)"
    color = #e8e8ff
    font = "Courier New", mono
    padding = 10, 8, 12, 8
    align = center
    justify = center
    box:
        id = "wrap"
        text align = center
        width = 100%
        max width = 520
        heading:
            content = "SALAM PAC-MAN"
            color = #ffd21f
            letter spacing = 0.28em
            margin = 6, 0, 4, 0
            font size = 28
            text shadow = 0, 0, 18, #ffd21f73
        end
        box:
            id = "hud"
            content = "Loading..."
            font size = 16
            margin = 4, 0, 10, 0
            color = #7cf7c4
            wrap text = false
        end
        canvas:
            id = "game"
            width = 456
            height = 360
            max width = 100%
            margin = 0, auto
            border = 3, solid, #2b3f9e
            radius = 12
            shadow = 0, 0, 34, #2b3f9e8c
            background = #050514
            touch action = none
        end
        box:
            id = "pad"
            layout = grid
            columns = repeat(3, minmax(56, 72))
            rows = repeat(3, 52)
            gap = 8
            justify = center
            margin = 14, auto, 0, auto
            PadKey: key = "pad_up" label = "▲" col = 2 line = 1 end
            PadKey: key = "pad_left" label = "◀" col = 1 line = 2 end
            PadKey: key = "pad_pause" label = "❚❚" col = 2 line = 2 end
            PadKey: key = "pad_right" label = "▶" col = 3 line = 2 end
            PadKey: key = "pad_down" label = "▼" col = 2 line = 3 end
        end
        paragraph:
            id = "msg"
            content = "Loading..."
            color = #9aa0d8
            font size = 13
            margin = 10, 0, 0, 0
            padding = 0, 6
        end
    end
    script: src = "src/game.salam" end
end
