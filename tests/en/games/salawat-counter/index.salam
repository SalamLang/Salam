/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

page:
    title = "Salam Salawat Counter"
    background = "radial(circle, [50%, 0%], #0f2318 0%, #050a08 70%)"
    color = #f2ead4
    font = system, "Segoe UI", Arial, sans
    padding = 14
    align = center
    justify = center
    box:
        id = "wrap"
        text align = center
        width = 100%
        max width = 380
        heading:
            id = "title"
            content = "Salawat Counter"
            color = #e8c15a
            margin = 6, 0, 4, 0
            font size = 30
            text shadow = 0, 0, 16, #e8c15a66
        end
        paragraph:
            id = "sub"
            content = "Tap the button to send a salawat"
            font size = 15
            color = #bfd6c5
            margin = 0, 0, 10, 0
        end
        box:
            id = "phrase"
            content = "اللهم صل علی محمد و آل محمد"
            font size = 19
            color = #f2ead4
            background = #0e1f16
            border = 1, solid, #2c4a37
            radius = 12
            padding = 14, 10
            margin = 6, 0, 4, 0
        end
        paragraph:
            id = "translit"
            content = "Allahumma salli 'ala Muhammadin wa aali Muhammad"
            font size = 12
            color = #7f9c88
            margin = 0, 0, 16, 0
        end
        box:
            id = "count"
            content = "0"
            font size = 72
            font weight = bold
            color = #8fe3a8
            text shadow = 0, 0, 22, #8fe3a866
            margin = 4, 0
        end
        box:
            id = "hud"
            content = "Tap to begin"
            font size = 15
            color = #e8c15a
            min height = 1.6em
            margin = 6, 0, 14, 0
        end
        button:
            touch action = manipulation
            id = "tapBtn"
            content = "🤲 Salawat"
            font size = 24
            width = 100%
            padding = 18, 0
            radius = 18
            background = #1c6b3f
            border = 2, solid, #2f8f57
            color = #fff
            font weight = bold
        end
        button:
            touch action = manipulation
            id = "resetBtn"
            content = "Reset"
            font size = 14
            align self = center
            margin = 12, 0, 0, 0
            padding = 10, 18
            radius = 12
            background = transparent
            border = 1, solid, #4a4032
            color = #bfae7e
        end
    end
    script:
        src = "game.salam"
    end
end
