بسته هندسه

@en "Limit"
@fa "حد"
همگانی پایا حد := ۷

@en "Shade"
@fa "سایه"
همگانی جداشمار سایه:
    @en "Dark"
    @fa "تیره"
    تیره
    @en "Light"
    @fa "روشن"
    روشن
پایان

@en "Point"
@fa "نقطه"
همگانی ساختار نقطه:
    @en "x"
    @fa "ایکس"
    همگانی ایکس: صحیح = ۰
    @en "y"
    @fa "ایگرگ"
    همگانی ایگرگ: صحیح = ۰
    @en "Sum"
    @fa "جمع"
    همگانی روال جمع(): صحیح:
        برگشت این.ایکس + این.ایگرگ
    پایان
پایان

@en "Twice"
@fa "دوبار"
همگانی روال دوبار(ع: صحیح): صحیح:
    برگشت ع * ۲
پایان

@en "Make"
@fa "بساز"
همگانی روال بساز(الف: صحیح، ب: صحیح): نقطه:
    برگشت نقطه { ایکس = الف، ایگرگ = ب }
پایان
