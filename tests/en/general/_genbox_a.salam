package genboxa

pub struct Mark:
    pub level: int = 0
end

func _label(m: Mark): str:
    ret "mark " + m.level
end

pub func Ok(m: Mark): bool:
    ret m.level > 0
end

pub func Label(m: Mark): str:
    ret _label(m)
end
