package genboxb

pub struct Tag:
    pub name: str = ""
end

pub struct Box<T>:
    pub items: Vector<T> = Vector {} as Vector<T>
    pub tag: Tag = Tag { name = "default" }
    pub owner: str = ""

    pub func Add(x: T): bool:
        t := Tag { name = this.owner }
        if not Ok(t): ret false end
        this.items.push(x)
        ret true
    end

    pub func Describe(): str:
        ret _label(this.tag) + " holds " + this.items.len()
    end
end

func _label(t: Tag): str:
    ret "tag " + t.name
end

pub func Ok(t: Tag): bool:
    ret t.name.len() > 0
end
