package genrow

pub struct Row:
    pub id: int = 0
    pub tag: str = ""
end

pub func List(n: int): Vector<Row>:
    mut v := Vector {} as Vector<Row>
    repeat n in i:
        v.Push(Row { id = i, tag = "r" })
    end
    ret v
end
