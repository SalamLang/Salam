// Helper for general/generic_xpkg: the *first* module to name
// Vector<genrow.Row>, so main below is the second.
package genuse

import genrow "_genrow.salam"

pub func Sum(n: int): int:
    mut v := genrow.List(n)
    defer v.free()
    mut total := 0
    repeat v.len() with i:
        total += v.get(i).id
    end
    ret total
end
