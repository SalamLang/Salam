// Helper for interface_pkg: two drivers in a third package, each satisfying
// an interface declared in ifacestore.

package ifacedriver

import ifacestore "_ifacestore.salam"

@en "Memory"
@fa "حافظه"
@ar "ذاكرة"
pub struct Memory:
    pub base: int = 0
    pub func Get(id: int): ifacestore.Row:
        ret ifacestore.Row { id = this.base + id, name = "mem" }
    end
    pub func Kind(): str: ret "memory" end
end

@en "Fixed"
@fa "ثابت"
@ar "ثابت"
pub struct Fixed:
    pub only: str = ""
    pub func Get(id: int): ifacestore.Row:
        ret ifacestore.Row { id = id, name = this.only }
    end
    pub func Kind(): str: ret "fixed" end
end
