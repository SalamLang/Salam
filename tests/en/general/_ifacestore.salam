package ifacestore

@en "Row"
@fa "ردیف"
pub struct Row:
    pub id: int = 0
    pub name: str = ""
end

@en "Store"
@fa "انبار"
pub interface Store:
    func Get(id: int): Row
    func Kind(): str
end
