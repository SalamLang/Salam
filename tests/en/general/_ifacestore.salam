// Helper for interface_pkg: an interface, and the row type its methods hand
// back, owned by a package other than the one that implements them.

package ifacestore

@en "Row"
@fa "ردیف"
@ar "صف"
pub struct Row:
    pub id: int = 0
    pub name: str = ""
end

@en "Store"
@fa "انبار"
@ar "مخزن"
pub interface Store:
    func Get(id: int): Row
    func Kind(): str
end
