package inlinelib

pub const Factor := 3

func hidden(x: int): int: ret x + 100 end

pub inline func Twice(x: int): int: ret x * 2 end

pub inline func Scaled(x: int): int: ret x * Factor end

pub inline func ViaHidden(x: int): int: ret hidden(x) end
