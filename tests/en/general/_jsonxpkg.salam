// Helper for general/json_xpkg_generic_field: the package that owns the
// generic-instance fields. It has to be a package other than main, because
// that is the whole point of the test - see there.
package jsonxpkg

pub struct Sms:
    pub id: i64 = 0
    pub body: str = ""
end

pub struct Page:
    pub items: Vector<Sms> = Vector {} as Vector<Sms>
    pub sizes: Vector<i64> = Vector {} as Vector<i64>
    pub tags: HashMap<str, i64> = HashMap {} as HashMap<str, i64>
    pub count: i64 = 0
end

pub func Make(): Page:
    mut v := Vector {} as Vector<Sms>
    v.push(Sms { id = 1, body = "a" })
    v.push(Sms { id = 2, body = "b" })
    mut sz := Vector {} as Vector<i64>
    sz.push(7 as i64)
    mut m := HashMap {} as HashMap<str, i64>
    m.put("x", 9 as i64)
    ret Page { items = v, sizes = sz, tags = m, count = 2 as i64 }
end
