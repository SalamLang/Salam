// Helper for general/pkg_struct_lit: one of two packages that export a
// struct called 'Input'.
package litalpha

pub struct Input:
    pub a: str = "alpha-a"
    pub n: int = 1
end

pub func Show(x: Input): str:
    ret "alpha " + x.a + " " + x.n
end
