package modlib
// A pub inline method is exported as a body in this package's header, so the
// importing module can inline it; PScaled reaches a module-private function
// and has to give the inline back.
pub struct PBox:
    pub w: int = 0
    pub h: int = 0

    pub inline func PArea(): int: ret this.w * this.h end

    pub inline pure func PPerim(): int: ret 2 * (this.w + this.h) end

    pub noinline func PWiden(k: int): this.w = this.w + k end

    pub inline func PScaled(): int: ret hidden boost(this.w) end
end

pure func hidden boost(x: int): int: ret x + 50 end
pub pure func PSum(a: int, b: int): int: ret a + b end
pub inline pure func PSquare(x: int): int: ret x * x end
pub noinline func PTriple(x: int): int: ret x * 3 end
pub deprecated func POld(x: int): int: ret x - 1 end
pub inline func PBoosted(x: int): int: ret hidden boost(x) end
pub pure func PPick<T>(a: T, b: T): T: if a > b: ret a
end
ret b
end
