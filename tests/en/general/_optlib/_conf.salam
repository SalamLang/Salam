package conf

pub struct Conf:
    pub host: str
    pub port: int?
    pub name: str? = "n"
end

pub func Make(p: int?): Conf:
    ret Conf { host = "h", port = p }
end

pub func Port(c: Conf): int:
    ret c.port.unwrap_or(0 - 1)
end
