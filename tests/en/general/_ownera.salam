// Helper for general/pkg_method_owner: one of two packages with a struct called
// 'Input', each carrying its own free().
package ownera

pub struct Input:
    pub title: str = ""
    pub count: i64 = 0
    pub v: Vector<i64> = Vector {}

    pub func tag(): str:
        ret "ownera"
    end

    pub func free():
        this.v.free()
    end
end

pub func Make(): Input:
    mut i := Input {}
    i.title = "a"
    i.v.push(1 as i64)
    i.v.push(2 as i64)
    ret i
end
