package pkgenumjsonlib

import encoding.json

include o "_pkg_enum_other.salam"

pub enum Tone:
    Quiet, Mid, Soft, Loud
end

pub struct Pair:
    pub a: Tone = Tone.Quiet
    pub m: o.Mood = o.Mood.Calm
end

pub struct Wrap:
    pub p: Pair = Pair {}
    pub n: int = 0
end

pub func Decode(text: str): Pair:
    mut c := Pair {}
    try:
        json.Unmarshal(text, c)
    catch e:
        println "err", e.message
    end
    ret c
end

pub func DecodeWrap(text: str): Wrap:
    mut c := Wrap {}
    try:
        json.Unmarshal(text, c)
    catch e:
        println "err", e.message
    end
    ret c
end

pub func Encode(c: Pair): str:
    ret json.Marshal(c)
end

pub func MoodNum(c: Pair): int:
    ret c.m as int
end
