package pkgenumlib

include o "_pkg_enum_other.salam"

const PRIV := 41

pub const TOP := Tone.Loud

pub enum Tone:
    Soft, Loud
end

pub enum Label:
    Ann = "ann",
    Bob = "bob"
end

pub enum Shape:
    Circle(r: f64)
    Empty
end

type Tn = Tone

pub struct Conf:
    pub t: Tone = Tone.Loud
    pub alias: Tn = Tn.Loud
    pub label: Label = Label.Bob
    pub shape: Shape = Shape.Empty
    pub m: o.Mood = o.Mood.Wild
    pub arr: Tone[2] = [Tone.Loud, Tone.Soft]
    pub p: int = PRIV
    pub h: int = helper()
    pub w: int = o.WILDNESS
end

pub struct Outer:
    pub set: Conf = Conf { t = Tone.Soft }
    pub plain: Conf = Conf {}
end

pub struct Box<T>:
    pub items: Vector<T> = Vector {}
    pub t: Tone = Tone.Loud
end

pub struct Picker:
    pub n: int = 0

    pub func Pick(t: Tone = Tone.Loud, p: int = PRIV): int:
        ret (t as int) * 100 + p
    end
end

func helper(): int:
    ret PRIV + 1
end

pub func Pick(t: Tone = Tone.Loud, p: int = PRIV, h: int = helper(), w: int = o.WILDNESS): int:
    ret (t as int) * 1000 + p + h + w
end

pub func MoodNum(c: Conf): int:
    ret c.m as int
end

pub func Make<T>(_x: T): Box<T>:
    ret Box {}
end

pub func Say(t: Tone): str:
    switch t:
        Soft:
            ret "soft"
        end
        Loud:
            ret "loud"
        end
    end
    ret "?"
end
