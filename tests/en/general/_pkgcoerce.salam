package pkgcoerce

pub mut OnShape := (x: dyn Shape): ret x.Area() end
pub mut OnValue := (v: int or str): ret Show(v) end

pub interface Shape:
    func Area(): int
end

pub interface Taker:
    func Take(x: dyn Shape): int
    func TakeValue(v: int or str): str
end

pub struct Sq:
    pub s: int = 0
    pub func Area(): int: ret this.s * this.s end
end

pub struct Tri:
    pub b: int = 0
    pub h: int = 0
    pub func Area(): int: ret this.b * this.h / 2 end
end

pub struct Maker:
    pub tag: int = 1
    pub func Take(x: dyn Shape): int: ret this.tag + x.Area() end
    pub func TakeValue(v: int or str): str: ret this.tag + ":" + Show(v) end
    pub static func Measure(x: dyn Shape): int: ret x.Area() end
    pub static func Label(v: int or str): str: ret Show(v) end
end

pub struct Hold:
    pub on_shape: func (dyn Shape) int
    pub on_value: func (int or str) str
end

pub func AreaOf(x: dyn Shape): int:
    ret x.Area()
end

pub func Between(a: int, x: dyn Shape, b: int): int:
    ret a + x.Area() + b
end

pub func Show(v: int or str): str:
    ret match v:
        int n: "int:" + n end
        str t: "str:" + t end
    end
end

pub func ShowSq(v: Sq or str): str:
    ret match v:
        Sq q: "sq:" + q.s end
        str t: "str:" + t end
    end
end

pub func DefaultText(k: int, v: int or str = "dflt"): str:
    ret k + "/" + Show(v)
end

pub func DefaultNum(k: int, v: int or str = 9): str:
    ret k + "/" + Show(v)
end

pub func DefaultShape(k: int, x: dyn Shape = Sq { s = 3 }): int:
    ret k + x.Area()
end

pub func DefaultTail(v: int or str, m: str = "m"): str:
    ret Show(v) + m
end

pub func GenShape<T>(_t: T, x: dyn Shape): int:
    ret x.Area()
end

pub func GenValue<T>(_t: T, v: int or str): str:
    ret Show(v)
end

pub func GenDefault<T>(_t: T, v: int or str = "gd"): str:
    ret Show(v)
end

pub func Pick(x: dyn Shape): str:
    ret "shape:" + x.Area()
end

pub func Pick(a: int, v: int or str): str:
    ret "value:" + a + ":" + Show(v)
end

pub func GetOnShape(): func (dyn Shape) int:
    ret (x: dyn Shape): ret x.Area() end
end

pub func GetOnValue(): func (int or str) str:
    ret (v: int or str): ret Show(v) end
end

pub func MakeHold(): Hold:
    ret Hold { on_shape = GetOnShape(), on_value = GetOnValue() }
end

pub func Wide(x: i128): str:
    ret "wide:" + (x as i64)
end

pub func Mix(r &: int, x: dyn Shape, v: int or str, o: int?, w: i128): str:
    r++
    ret r + "," + x.Area() + "," + Show(v) + "," + o.unwrap_or(0 - 1) + "," + (w as i64)
end
