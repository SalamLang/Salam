package pkgcoercedrv

include pc "_pkgcoerce.salam"

pub struct Mem:
    pub n: int = 0
    pub func Area(): int: ret this.n + 100 end
end

pub func Run(x: dyn pc.Shape): int:
    ret x.Area()
end

pub func RunDefault(k: int, x: dyn pc.Shape = pc.Sq { s = 2 }): int:
    ret k + x.Area()
end

pub func ShowVia(v: pc.Sq or str): str:
    ret pc.ShowSq(v)
end

pub func ShowDefault(k: int, v: pc.Sq or str = pc.Sq { s = 9 }): str:
    ret k + pc.ShowSq(v)
end

pub func MakeSq(n: int): pc.Sq:
    ret pc.Sq { s = n }
end
