// Helper for general/pkg_global_init: globals whose initialisers are calls,
// in a package that is not the program's own module.
package pkginit

mut g_n := seed()
mut g_names := Vector {} as Vector<str>

func seed(): int:
    ret 6 * 7
end

pub func N(): int:
    ret g_n
end

pub func Add(s: str): int:
    g_names.push(s)
    ret g_names.len()
end
