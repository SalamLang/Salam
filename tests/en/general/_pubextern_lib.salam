@en "cstd"
@fa "سی‌استاندارد"
package cstd

extern:
    @en "div"
    @fa "تقسیم"
    pub func div(dividend: int, divisor: int): DivResult
    @en "abs"
    @fa "قدرمطلق"
    pub func abs(x: int): int
end

@en "DivResult"
@fa "نتیجه"
pub struct DivResult:
    @en "quot"
    @fa "خارج‌قسمت"
    pub quot: int = 0
    @en "rem"
    @fa "باقی‌مانده"
    pub rem: int = 0
end
