// A method whose body is exactly `ret this.<field>` is emitted as a field
// read rather than a call, so this file is mostly about the shapes that
// must NOT take that path: a multi-statement body, one that takes a
// parameter, one that returns an aggregate by value. The receiver forms
// matter too - a value, a reference, a temporary, and `this` inside
// another method of the same struct - because each reaches the field
// differently and all four must still evaluate the receiver exactly once.

struct Point:
    x: int = 0
    y: int = 0

    pub func get_x(): int: ret this.x end
    pub func get_y(): int: ret this.y end
    // Not an accessor: two statements.
    pub func sum(): int:
        t := this.x + this.y
        ret t
    end
    // Not an accessor: takes a parameter.
    pub func scaled(k: int): int: ret this.x * k end
    // An accessor reached from another method of the same struct.
    pub func twice_x(): int: ret this.get_x() + this.get_x() end
end

struct Box:
    inner: Point = Point {}
    // The field is an aggregate: returned by value, so not the fast path.
    pub func take(): Point: ret this.inner end
    pub func depth(): int: ret this.inner.get_y() end
end

func make(): Point: ret Point { x = 7, y = 9 } end

func via_ref(p &: Point): int: ret p.get_x() end

func main:
    p := Point { x = 3, y = 4 }
    println "fields:", p.get_x(), p.get_y()
    println "sum:", p.sum(), "scaled:", p.scaled(5)
    println "twice:", p.twice_x()
    // A temporary receiver: evaluated exactly once either way.
    println "temp:", make().get_x()
    println "ref:", via_ref(p)
    b := Box { inner = p }
    println "nested:", b.take().get_y(), b.depth()
    mut v := Vector {} as Vector<int>
    repeat 5 with i:
        v.push(i * i)
    end
    println "len:", v.len(), "cap>=len:", v.cap() >= v.len(), "empty:", v.is_empty()
    mut total := 0
    each x in v:
        total = total + x
    end
    println "each:", total
    v.free()
end
