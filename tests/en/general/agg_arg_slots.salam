struct Client:
    pub handle: int = 0
end

struct Req:
    pub id: int = 0
    pub n: int = 0
end

noinline func send(c: Client, q: str, params: Vector<str>, size: int): Req:
    mut total := c.handle * 100 + size
    each p in params:
        total += p.len()
    end
    ret Req { id = total, n = params.len() + q.len() }
end

func run(c: Client, q: str): Req:
    ret send(c, q, Vector {} as Vector<str>, 0)
end

func main:
    c := Client { handle = 7 }
    r := run(c, "select")
    println r.id, r.n
    mut ps := Vector {} as Vector<str>
    ps.push("ab")
    ps.push("cde")
    r2 := send(Client { handle = 3 }, "q", ps, 1)
    println r2.id, r2.n
    ps.free()
end
