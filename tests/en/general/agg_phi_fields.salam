package main

import mem

struct Px:
    pub r: u8 = 0 as u8
    pub g: u8 = 0 as u8
    pub b: u8 = 0 as u8
    pub a: u8 = 0 as u8
end

struct Mix:
    pub n: int = 0
    pub x: f64 = 0.0
    pub p: Px = Px {}
end

noinline func opaque(v: int): int:
    ret v
end

func get(buf: u8*, n: int, i: int): Px:
    if i < 0 or i >= n:
        ret Px {}
    end
    mut c := Px { r = buf[i], g = buf[i + 1] }
    c.b = buf[i + 2]
    c.a = buf[i + 3]
    ret c
end

noinline func make(k: int): Mix:
    ret Mix { n = k, x = (k as f64) * 0.5, p = Px { r = k as u8 } }
end

func pick(k: int, m: Mix): Mix:
    if k == 0:
        ret Mix {}
    end
    if k == 1:
        ret m
    end
    if k == 2:
        ret make(k * 7)
    end
    mut o := Mix { n = k }
    o.x = 1.5
    o.p.b = 9 as u8
    ret o
end

func loaded(k: int, a &: Mix, b &: Mix): Mix:
    mut r := Mix {}
    if k > 0:
        r = a
        a.n = 100
    else:
        r = b
        b.n = 200
    end
    ret r
end

func main:
    p := mem.Allocate(16 as u64) as u8*
    repeat 16 in i:
        p[i] = (i * 3 + 1) as u8
    end
    mut s := 0
    mut k := 0 - 2
    until k < 14:
        c := get(p, 12, k)
        s = s * 3 + (c.r as int) + (c.g as int) * 2 + (c.b as int) * 5
        println k, c.r, c.g, c.b, c.a
        k += 3
    end
    println s

    base := Mix { n = 5, x = 2.25, p = Px { g = 4 as u8 } }
    repeat 4 in j:
        m := pick(opaque(j), base)
        println m.n, m.x, m.p.r, m.p.g, m.p.b
    end

    mut a := Mix { n = 1, x = 0.5 }
    mut b := Mix { n = 2, x = 0.25 }
    r0 := loaded(opaque(1), a, b)
    r1 := loaded(opaque(0), a, b)
    println r0.n, r0.x, r1.n, r1.x, a.n, b.n
end
