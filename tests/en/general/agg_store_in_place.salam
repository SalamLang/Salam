struct Pt:
    pub x: int = 0
    pub y: int = 0
end

struct Box:
    pub a: Vector<int> = Vector {}
    pub p: Pt = Pt {}
    pub n: int = 0
    pub b: Vector<int> = Vector {}
end

noinline func swap(p &: Pt):
    p = Pt { x = p.y, y = p.x }
end

noinline func bump(p &: Pt, k: int):
    p = Pt { x = p.x + k, y = p.x * 2 + p.y }
end

noinline func fresh(b &: Box, n: int):
    b = Box { n = n + b.n, p = Pt { x = b.p.y, y = n } }
end

noinline func total(b &: Box): int:
    mut s := b.n + b.p.x * 10 + b.p.y * 100
    each v in b.a:
        s += v
    end
    each w in b.b:
        s += w * 1000
    end
    ret s
end

func main:
    mut p := Pt { x = 1, y = 2 }
    swap(p)
    println p.x, p.y
    bump(p, 5)
    println p.x, p.y
    mut b := Box { n = 3 }
    b.a.push(7)
    b.b.push(2)
    println total(b)
    b.a.free()
    b.b.free()
    fresh(b, 4)
    println total(b)
    mut q := Pt {}
    repeat 3 in i:
        q = Pt { x = q.y + i, y = q.x + 1 }
    end
    println q.x, q.y
end
