import arabic
import str
import unicode

func main:
    arabic_form := "كتاب"
    persian_form := "کتاب"
    println arabic_form == persian_form
    println str.CharCount(arabic_form), str.CharCount(persian_form)

    println str.NFC(arabic_form) == str.NFC(persian_form)
    println str.NFKC(arabic_form) == str.NFKC(persian_form)
    println str.EqualFold(arabic_form, persian_form)

    println arabic.NormalizePersian(arabic_form) == persian_form
    println arabic.EqualLoose(arabic_form, persian_form)

    println arabic.EqualLoose("كِتَاب", persian_form)
    println arabic.Normalize("كِتَاب", arabic.StripHarakat) == arabic_form

    println arabic.EqualLoose("ﻛﺘﺎﺏ", persian_form)

    println arabic.Normalize("کـــتاب", arabic.StripTatweel) == persian_form
    println arabic.IsTatweel(0x0640)

    println arabic.NormalizePersian("می‌رود") == "می‌رود"
    println arabic.Normalize("می‌رود", arabic.StripZWNJ) == "میرود"
    println arabic.EqualLoose("می‌رود", "میرود")

    println arabic.SearchKey("أحمد")
    println arabic.SearchKey("مدرسة")
    println arabic.NormalizePersian("أحمد") == "أحمد"

    println arabic.SearchKey("سال ۱۴۰۳"), arabic.SearchKey("سال ١٤٠٣")
    println arabic.EqualLoose("سال ۱۴۰۳", "سال 1403")

    println arabic.IsHaraka(0x064E), arabic.IsHaraka(0x0633)
    println arabic.IsArabicScript(0x0633), arabic.IsArabicScript(0x0041)
    println unicode.ScriptName(0x0633), unicode.ScriptName(0x064E)
    println arabic.IsArabicScript(0x064E)
end
