// An array literal passed straight into a call, with no local to name it
// first. A braced list is only an initializer in C, so in an argument slot
// it has to be emitted as a compound literal instead.

struct P:
    pub x: int = 0
    pub y: int = 0
end

func total(xs: int[3]): int:
    mut s := 0
    repeat 3 with i: s = s + xs[i] end
    ret s
end

func first_x(ps: P[2]): int: ret ps[0].x end

func join(names: str[2]): str: ret names[0] + "-" + names[1] end

func widest(rows: int[2][2]): int:
    mut m := 0
    repeat 2 with r:
        repeat 2 with c:
            if rows[r][c] > m: m = rows[r][c] end
        end
    end
    ret m
end

func main:
    println total([1, 2, 3])
    println total([10, 20, 30])

    // Elements that are themselves expressions, not constants.
    n := 7
    println total([n, n + 1, n * 2])

    // Struct and str elements.
    println first_x([P { x = 4, y = 0 }, P { x = 5, y = 1 }])
    println join(["a", "b"])

    // Nested, and a literal feeding another call's argument.
    println widest([[1, 9], [3, 4]])
    println total([total([1, 1, 1]), 2, 3])

    // A named local still works exactly as before.
    xs := [5, 6, 7]
    println total(xs)
end
