import mem

// The intrinsic names are only magic when nothing else claims them. A real
// declaration in scope wins, so adding atomics to the language cannot break a
// program that already had a function by one of these names.
func atomic_add(a: i64, b: i64): i64:
    ret a + b + 1000
end

func main:
    println "shadowed:", atomic_add(2 as i64, 3 as i64)

    // The others are still intrinsics.
    c := mem.AllocateZeroed(8 as u64) as i64*
    atomic_store(c, 41 as i64)
    println "intrinsic:", atomic_load(c)
    println "cas:", atomic_cas(c, 41 as i64, 42 as i64), atomic_load(c)
    mem.Free(c as void*)
end
