struct Box:
    pub items: Vector<int> = Vector {}
end

func squares(n: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat n in i:
        out.push(i * i)
    end
    ret out
end

func total(v: Vector<int>): int:
    mut t := 0
    each x in v:
        t += x
    end
    ret t
end

func fill(v &: Vector<int>, n: int):
    repeat n in i:
        v.push(i)
    end
end

func counts(words: Vector<str>): int:
    mut m := HashMap {} as HashMap<str, int>
    each w in words:
        m.put(w, m.get_or(w, 0) + 1)
    end
    ret m.size()
end

func main:
    mut sum := 0
    repeat 3 in r:
        s := squares(4 + r)
        sum += total(s)
        mut tmp := Vector {} as Vector<int>
        fill(tmp, 5)
        sum += tmp.len()
    end
    println sum
    mut kept := Vector {} as Vector<int>
    kept.push(7)
    b := Box { items = kept }
    println b.items.get(0)
    mut manual := Vector {} as Vector<int>
    manual.push(1)
    defer manual.free()
    mut again := Vector {} as Vector<int>
    again.push(2)
    again = squares(2)
    println again.len(), manual.len()
    mut ws := Vector {} as Vector<str>
    ws.push("a")
    ws.push("b")
    ws.push("a")
    println counts(ws)
    mut it := HashMap {} as HashMap<str, int>
    it.put("k", 1)
    each k, val in it:
        println k, val
    end
end
