struct Box:
    pub items: Vector<int> = Vector {}
end

func squares(n: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat n in i:
        out.Push(i * i)
    end
    ret out
end

func total(v: Vector<int>): int:
    mut t := 0
    each x in v:
        t += x
    end
    ret t
end

func fill(v &: Vector<int>, n: int):
    repeat n in i:
        v.Push(i)
    end
end

func counts(words: Vector<str>): int:
    mut m := HashMap {} as HashMap<str, int>
    each w in words:
        m.Put(w, m.GetOr(w, 0) + 1)
    end
    ret m.Size()
end

func main:
    mut sum := 0
    repeat 3 in r:
        s := squares(4 + r)
        sum += total(s)
        mut tmp := Vector {} as Vector<int>
        fill(tmp, 5)
        sum += tmp.Len()
    end
    println sum
    mut kept := Vector {} as Vector<int>
    kept.Push(7)
    b := Box { items = kept }
    println b.items.Get(0)
    mut manual := Vector {} as Vector<int>
    manual.Push(1)
    defer manual.Free()
    mut again := Vector {} as Vector<int>
    again.Push(2)
    again = squares(2)
    println again.Len(), manual.Len()
    mut ws := Vector {} as Vector<str>
    ws.Push("a")
    ws.Push("b")
    ws.Push("a")
    println counts(ws)
    mut it := HashMap {} as HashMap<str, int>
    it.Put("k", 1)
    each k, val in it:
        println k, val
    end
end
