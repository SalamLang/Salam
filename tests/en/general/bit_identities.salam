// Algebraic laws of the bit operators, checked exhaustively by brute
// force rather than on hand-picked values: every pair (and for the
// distributive laws every triple) drawn from a small range has to
// satisfy each identity, so a wrong operator cannot slip through on a
// lucky example.

func check(name: str, ok: bool):
    if ok:
        println name, "holds"
    else:
        println name, "FAILED"
    end
end

func main:
    lo := -8
    hi := 8

    // idempotence, commutativity, identity and absorbing elements
    mut idem := true
    mut comm := true
    mut ident := true
    mut absorb := true
    mut selfxor := true
    mut compl := true
    mut a := lo
    until a < hi:
        if (a & a) != a || (a | a) != a: idem = false end
        if (a ^ a) != 0: selfxor = false end
        if (a & 0) != 0 || (a | (-1)) != (-1): absorb = false end
        if (a & (-1)) != a || (a | 0) != a || (a ^ 0) != a: ident = false end
        if ~a != (0 - a) - 1 || (a ^ (-1)) != ~a: compl = false end
        if (a & ~a) != 0 || (a | ~a) != (-1): compl = false end
        mut b := lo
        until b < hi:
            if (a & b) != (b & a) || (a | b) != (b | a) || (a ^ b) != (b ^ a):
                comm = false
            end
            b = b + 1
        end
        a = a + 1
    end
    check("idempotence", idem)
    check("commutativity", comm)
    check("identity", ident)
    check("absorbing", absorb)
    check("self-xor", selfxor)
    check("complement", compl)

    // absorption, De Morgan, and xor in terms of and/or/not
    mut absorption := true
    mut demorgan := true
    mut xorform := true
    mut xorsub := true
    a = lo
    until a < hi:
        mut b := lo
        until b < hi:
            if (a & (a | b)) != a || (a | (a & b)) != a: absorption = false end
            if ~(a & b) != (~a | ~b) || ~(a | b) != (~a & ~b): demorgan = false end
            if (a ^ b) != ((a | b) & ~(a & b)): xorform = false end
            if (a ^ b) != ((a & ~b) | (~a & b)): xorform = false end
            if (a ^ b) != ((a | b) - (a & b)): xorsub = false end
            b = b + 1
        end
        a = a + 1
    end
    check("absorption", absorption)
    check("de morgan", demorgan)
    check("xor as and/or/not", xorform)
    check("xor as or minus and", xorsub)

    // associativity and distributivity over every triple
    mut assoc := true
    mut distrib := true
    a = lo
    until a < hi:
        mut b := lo
        until b < hi:
            mut c := lo
            until c < hi:
                if ((a & b) & c) != (a & (b & c)): assoc = false end
                if ((a | b) | c) != (a | (b | c)): assoc = false end
                if ((a ^ b) ^ c) != (a ^ (b ^ c)): assoc = false end
                if (a & (b | c)) != ((a & b) | (a & c)): distrib = false end
                if (a | (b & c)) != ((a | b) & (a | c)): distrib = false end
                if (a & (b ^ c)) != ((a & b) ^ (a & c)): distrib = false end
                c = c + 1
            end
            b = b + 1
        end
        a = a + 1
    end
    check("associativity", assoc)
    check("distributivity", distrib)

    // arithmetic written with bit operators
    mut addlaw := true
    mut sublaw := true
    mut neglaw := true
    a = lo
    until a < hi:
        if (0 - a) != (~a + 1): neglaw = false end
        mut b := lo
        until b < hi:
            if (a + b) != ((a ^ b) + ((a & b) << 1)): addlaw = false end
            if (a + b) != ((a | b) + (a & b)): addlaw = false end
            if (a - b) != (a + ~b + 1): sublaw = false end
            b = b + 1
        end
        a = a + 1
    end
    check("add via xor and carry", addlaw)
    check("sub via complement", sublaw)
    check("negate via complement", neglaw)

    // shifts against multiplication and floor division
    mut shiftmul := true
    mut shiftdiv := true
    mut n := 0
    until n < 10:
        mut v := 0
        until v < 100:
            if (v << n) != v * (1 << n): shiftmul = false end
            if (v >> n) != v / (1 << n): shiftdiv = false end
            v = v + 1
        end
        n = n + 1
    end
    check("shl is multiply", shiftmul)
    check("shr is divide (non-negative)", shiftdiv)

    // an arithmetic right shift floors, while division truncates toward
    // zero, so the two disagree on negative values that are not exact
    println -7 >> 1, -7 / 2
    println -8 >> 1, -8 / 2
    println -1 >> 4, -1 / 16

    // shifting is associative in the exponent
    mut shiftassoc := true
    mut i := 0
    until i < 6:
        mut j := 0
        until j < 6:
            if ((1 << i) << j) != (1 << (i + j)): shiftassoc = false end
            j = j + 1
        end
        i = i + 1
    end
    check("shift exponents add", shiftassoc)

    // masking is the same as a modulo by a power of two, for values
    // that are not negative
    mut masklaw := true
    mut k := 0
    until k < 200:
        if (k & 7) != k % 8 || (k & 15) != k % 16 || (k & 255) != k % 256:
            masklaw = false
        end
        k = k + 1
    end
    check("mask is modulo", masklaw)
end
