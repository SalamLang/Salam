// Packing several small fields into one word and taking them apart
// again: a colour quadruple, an arbitrary bitfield extract/insert
// pair, byte-order swapping, sign extension from a narrow field, and
// base-2/base-16 rendering driven entirely by shifts and masks.

func pack_rgba(r: u32, g: u32, b: u32, a: u32): u32:
    ret (r << (24 as u32)) | (g << (16 as u32)) | (b << (8 as u32)) | a
end

func red(c: u32): u32:
    ret (c >> (24 as u32)) & (0xFF as u32)
end

func green(c: u32): u32:
    ret (c >> (16 as u32)) & (0xFF as u32)
end

func blue(c: u32): u32:
    ret (c >> (8 as u32)) & (0xFF as u32)
end

func alpha(c: u32): u32:
    ret c & (0xFF as u32)
end

// extract `width` bits starting at `pos`
func extract(x: u32, pos: u32, width: u32): u32:
    ret (x >> pos) & (((1 as u32) << width) - (1 as u32))
end

// replace those bits with `v`
func insert(x: u32, pos: u32, width: u32, v: u32): u32:
    m := (((1 as u32) << width) - (1 as u32)) << pos
    ret (x & ~m) | ((v << pos) & m)
end

func bswap32(x: u32): u32:
    b0 := (x & (0x000000FF as u32)) << (24 as u32)
    b1 := (x & (0x0000FF00 as u32)) << (8 as u32)
    b2 := (x & (0x00FF0000 as u32)) >> (8 as u32)
    b3 := (x & (0xFF000000 as u32)) >> (24 as u32)
    ret b0 | b1 | b2 | b3
end

func bswap16(x: u16): u16:
    ret (x << (8 as u16)) | (x >> (8 as u16))
end

// sign-extend the low `bits` of x to a full 32-bit signed value
func sign_extend(x: int, bits: int): int:
    sh := 32 - bits
    ret (x << sh) >> sh
end

func to_binary(x: u32, width: int): str:
    mut s := ""
    mut i := width - 1
    until i >= 0:
        s = s + (((x >> (i as u32)) & (1 as u32)) as int)
        i = i - 1
    end
    ret s
end

func to_hex(x: u32, digits: int): str:
    table := "0123456789ABCDEF"
    mut s := ""
    mut i := digits - 1
    until i >= 0:
        nib := ((x >> ((i * 4) as u32)) & (0xF as u32)) as int
        s = s + table[nib]
        i = i - 1
    end
    ret s
end

func main:
    // pack and unpack a colour
    c := pack_rgba(0x12 as u32, 0x34 as u32, 0x56 as u32, 0x78 as u32)
    println c
    println red(c), green(c), blue(c), alpha(c)
    println pack_rgba(red(c), green(c), blue(c), alpha(c)) == c
    println to_hex(c, 8)

    // a fully saturated and a fully clear colour
    println pack_rgba(0xFF as u32, 0xFF as u32, 0xFF as u32, 0xFF as u32)
    println pack_rgba(0 as u32, 0 as u32, 0 as u32, 0 as u32)

    // arbitrary bitfields
    w := 0b1101_0110_1011_0001 as u32
    println to_binary(w, 16)
    println extract(w, 0 as u32, 4 as u32)
    println extract(w, 4 as u32, 4 as u32)
    println extract(w, 8 as u32, 4 as u32)
    println extract(w, 12 as u32, 4 as u32)
    println extract(w, 3 as u32, 6 as u32)

    // insert replaces exactly the chosen window
    w2 := insert(w, 4 as u32, 4 as u32, 0b1111 as u32)
    println to_binary(w2, 16)
    println extract(w2, 4 as u32, 4 as u32), extract(w2, 0 as u32, 4 as u32), extract(w2, 8 as u32, 4 as u32)
    w3 := insert(w, 0 as u32, 8 as u32, 0 as u32)
    println to_binary(w3, 16)
    println insert(w, 4 as u32, 4 as u32, extract(w, 4 as u32, 4 as u32)) == w

    // an over-wide value is truncated to the window, not spilled
    println to_binary(insert(0 as u32, 4 as u32, 4 as u32, 0xFF as u32), 16)

    // byte order
    println to_hex(bswap32(0x12345678 as u32), 8)
    println bswap32(bswap32(0xDEADBEEF as u32)) == (0xDEADBEEF as u32)
    println bswap16(0xABCD as u16)
    println bswap32(0x000000FF as u32), bswap32(0xFF000000 as u32)

    // sign extension out of a narrow field
    println sign_extend(0b0111, 4), sign_extend(0b1111, 4)
    println sign_extend(0b0111_1111, 8), sign_extend(0b1000_0000, 8)
    println sign_extend(1, 1), sign_extend(0, 1)
    println sign_extend(0b10_0000_0000_0000_0000, 18)

    // rendering the same number in both bases
    println to_binary(0 as u32, 8), to_binary(5 as u32, 8), to_binary(255 as u32, 8)
    println to_hex(0 as u32, 4), to_hex(4660 as u32, 4), to_hex(65535 as u32, 4)

    // a three-field record: 5 bits, 6 bits, 5 bits
    rec := insert(insert(insert(0 as u32, 0 as u32, 5 as u32, 17 as u32), 5 as u32, 6 as u32, 40 as u32), 11 as u32, 5 as u32, 9 as u32)
    println rec, to_binary(rec, 16)
    println extract(rec, 0 as u32, 5 as u32), extract(rec, 5 as u32, 6 as u32), extract(rec, 11 as u32, 5 as u32)
end
