// The classic bit-twiddling kernels, each computed two independent ways
// so the test checks the operators against a reference rather than
// against itself: population count, trailing/leading zeros, lowest set
// bit, power-of-two tests, parity, Hamming distance, Gray code and a
// full bit reversal.

// Kernighan: clearing the lowest set bit once per iteration
func popcount(x: u32): int:
    mut v := x
    mut n := 0
    until v != (0 as u32):
        v = v & (v - (1 as u32))
        n = n + 1
    end
    ret n
end

// SWAR: the same count with no loop at all
func popcount_swar(x: u32): int:
    mut v := x
    v = v - ((v >> (1 as u32)) & (0x55555555 as u32))
    v = (v & (0x33333333 as u32)) + ((v >> (2 as u32)) & (0x33333333 as u32))
    v = (v + (v >> (4 as u32))) & (0x0F0F0F0F as u32)
    ret ((v * (0x01010101 as u32)) >> (24 as u32)) as int
end

// the naive reference: look at one bit at a time
func popcount_naive(x: u32): int:
    mut n := 0
    mut b := 0
    until b < 32:
        n = n + (((x >> (b as u32)) & (1 as u32)) as int)
        b = b + 1
    end
    ret n
end

func ctz(x: u32): int:
    if x == (0 as u32): ret 32 end
    mut n := 0
    mut v := x
    until (v & (1 as u32)) == (0 as u32):
        v = v >> (1 as u32)
        n = n + 1
    end
    ret n
end

func clz(x: u32): int:
    if x == (0 as u32): ret 32 end
    mut n := 0
    mut v := x
    until (v & ((1 as u32) << (31 as u32))) == (0 as u32):
        v = v << (1 as u32)
        n = n + 1
    end
    ret n
end

func lowest_set(x: u32): u32:
    ret x & (~x + (1 as u32))
end

func clear_lowest(x: u32): u32:
    ret x & (x - (1 as u32))
end

func is_pow2(x: u32): bool:
    ret x != (0 as u32) && (x & (x - (1 as u32))) == (0 as u32)
end

func next_pow2(x: u32): u32:
    mut v := x - (1 as u32)
    v = v | (v >> (1 as u32))
    v = v | (v >> (2 as u32))
    v = v | (v >> (4 as u32))
    v = v | (v >> (8 as u32))
    v = v | (v >> (16 as u32))
    ret v + (1 as u32)
end

func parity(x: u32): int:
    mut v := x
    v = v ^ (v >> (16 as u32))
    v = v ^ (v >> (8 as u32))
    v = v ^ (v >> (4 as u32))
    v = v ^ (v >> (2 as u32))
    v = v ^ (v >> (1 as u32))
    ret (v & (1 as u32)) as int
end

func hamming(a: u32, b: u32): int:
    ret popcount(a ^ b)
end

func gray(x: u32): u32:
    ret x ^ (x >> (1 as u32))
end

func ungray(x: u32): u32:
    mut v := x
    v = v ^ (v >> (1 as u32))
    v = v ^ (v >> (2 as u32))
    v = v ^ (v >> (4 as u32))
    v = v ^ (v >> (8 as u32))
    v = v ^ (v >> (16 as u32))
    ret v
end

func reverse32(x: u32): u32:
    mut v := x
    v = ((v >> (1 as u32)) & (0x55555555 as u32)) | ((v & (0x55555555 as u32)) << (1 as u32))
    v = ((v >> (2 as u32)) & (0x33333333 as u32)) | ((v & (0x33333333 as u32)) << (2 as u32))
    v = ((v >> (4 as u32)) & (0x0F0F0F0F as u32)) | ((v & (0x0F0F0F0F as u32)) << (4 as u32))
    v = ((v >> (8 as u32)) & (0x00FF00FF as u32)) | ((v & (0x00FF00FF as u32)) << (8 as u32))
    ret (v >> (16 as u32)) | (v << (16 as u32))
end

func reverse32_naive(x: u32): u32:
    mut r := 0 as u32
    mut b := 0
    until b < 32:
        r = (r << (1 as u32)) | ((x >> (b as u32)) & (1 as u32))
        b = b + 1
    end
    ret r
end

func main:
    samples := [0 as u32, 1 as u32, 2 as u32, 3 as u32, 7 as u32, 8 as u32, 255 as u32, 256 as u32, 1023 as u32, 305419896 as u32, 2863311530 as u32, 4294967295 as u32] as u32[12]

    // three popcount implementations must agree on every sample
    mut pc := ""
    mut ok := true
    repeat 12 with i:
        x := samples[i]
        a := popcount(x)
        b := popcount_swar(x)
        c := popcount_naive(x)
        pc = pc + a + " "
        if a != b || b != c:
            ok = false
        end
    end
    println pc
    println "popcount agrees:", ok

    // trailing and leading zeros
    println ctz(1 as u32), ctz(2 as u32), ctz(8 as u32), ctz(256 as u32), ctz(0 as u32)
    println clz(1 as u32), clz(2 as u32), clz(255 as u32), clz(4294967295 as u32), clz(0 as u32)
    println ctz(0x80000000 as u32), clz(0x80000000 as u32)

    // ctz(x) is the index of the lowest set bit
    println lowest_set(12 as u32), lowest_set(8 as u32), lowest_set(0 as u32)
    println ((1 as u32) << (ctz(12 as u32) as u32)) == lowest_set(12 as u32)
    println clear_lowest(12 as u32), clear_lowest(1 as u32), clear_lowest(255 as u32)

    // powers of two
    mut pw := ""
    repeat 10 with i:
        pw = pw + is_pow2(i as u32) + " "
    end
    println pw
    println is_pow2(1024 as u32), is_pow2(1023 as u32), is_pow2(0 as u32)
    println next_pow2(1 as u32), next_pow2(5 as u32), next_pow2(17 as u32), next_pow2(1024 as u32), next_pow2(1025 as u32)

    // parity is the low bit of the population count
    mut par := true
    repeat 12 with i:
        if parity(samples[i]) != popcount(samples[i]) % 2:
            par = false
        end
    end
    println "parity matches popcount:", par
    println parity(0 as u32), parity(1 as u32), parity(3 as u32), parity(7 as u32)

    // Hamming distance
    println hamming(0 as u32, 4294967295 as u32)
    println hamming(0b1010 as u32, 0b0101 as u32)
    println hamming(0x12345678 as u32, 0x12345678 as u32)
    println hamming(1 as u32, 2 as u32)

    // Gray code: consecutive codes differ in exactly one bit, and the
    // decoder inverts the encoder
    mut g := ""
    mut gray_ok := true
    repeat 8 with i:
        code := gray(i as u32)
        g = g + code + " "
        if ungray(code) != (i as u32):
            gray_ok = false
        end
        if i > 0 && hamming(gray((i - 1) as u32), code) != 1:
            gray_ok = false
        end
    end
    println g
    println "gray round-trips:", gray_ok

    // bit reversal, both ways, and reversing twice is the identity
    println reverse32(1 as u32), reverse32(0x80000000 as u32)
    println reverse32(0x12345678 as u32)
    println reverse32_naive(0x12345678 as u32)
    println reverse32(0x12345678 as u32) == reverse32_naive(0x12345678 as u32)
    println reverse32(reverse32(0xDEADBEEF as u32)) == (0xDEADBEEF as u32)

    // branchless min/max/abs on signed ints
    println branchless_min(3, 9), branchless_min(-4, -9), branchless_min(5, 5)
    println branchless_max(3, 9), branchless_max(-4, -9), branchless_max(5, 5)
    println branchless_abs(7), branchless_abs(-7), branchless_abs(0)

    // sign of a value from its sign bit alone
    println sign_of(42), sign_of(-42), sign_of(0)

    // even/odd from the low bit
    println is_even(0), is_even(7), is_even(-8)
end

func branchless_min(a: int, b: int): int:
    ret b ^ ((a ^ b) & (0 - ((a < b) as int)))
end

func branchless_max(a: int, b: int): int:
    ret a ^ ((a ^ b) & (0 - ((a < b) as int)))
end

func branchless_abs(x: int): int:
    m := x >> 31
    ret (x + m) ^ m
end

func sign_of(x: int): int:
    ret ((x > 0) as int) - ((x < 0) as int)
end

func is_even(x: int): bool:
    ret (x & 1) == 0
end
