 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */


enum Perm:
    Read = 1
    Write = 2
    Exec = 4
    Delete = 8
    Admin = 16
end

func has(bits: int, m: int): bool:
    ret (bits & m) == m
end

func has_any(bits: int, m: int): bool:
    ret (bits & m) != 0
end

func set(bits: int, m: int): int:
    ret bits | m
end

func clear(bits: int, m: int): int:
    ret bits & ~m
end

func toggle(bits: int, m: int): int:
    ret bits ^ m
end

func subset(a: int, b: int): bool:
    ret (a & b) == a
end

func describe(bits: int): str:
    mut s := ""
    if has(bits, Perm.Read as int): s = s + "r" end
    if has(bits, Perm.Write as int): s = s + "w" end
    if has(bits, Perm.Exec as int): s = s + "x" end
    if has(bits, Perm.Delete as int): s = s + "d" end
    if has(bits, Perm.Admin as int): s = s + "A" end
    if s == "": ret "-" end
    ret s
end

func main:
    println Perm.Read as int, Perm.Write as int, Perm.Exec as int, Perm.Delete as int, Perm.Admin as int

    rw := (Perm.Read as int) | (Perm.Write as int)
    println rw, describe(rw)
    all := (Perm.Read as int) | (Perm.Write as int) | (Perm.Exec as int) | (Perm.Delete as int) | (Perm.Admin as int)
    println all, describe(all)
    println describe(0)

    println has(rw, Perm.Read as int), has(rw, Perm.Exec as int)
    println has_any(rw, (Perm.Exec as int) | (Perm.Write as int))
    println has_any(rw, (Perm.Exec as int) | (Perm.Admin as int))

    println has(rw, rw), has(rw, all), has(all, rw)

    mut p := 0
    p = set(p, Perm.Read as int)
    p = set(p, Perm.Read as int)
    println p, describe(p)
    p = set(p, Perm.Exec as int)
    println p, describe(p)
    p = clear(p, Perm.Read as int)
    println p, describe(p)
    p = clear(p, Perm.Read as int)
    println p, describe(p)
    p = toggle(p, Perm.Write as int)
    println p, describe(p)
    p = toggle(p, Perm.Write as int)
    println p, describe(p)

    println subset(rw, all), subset(all, rw), subset(rw, rw)
    println rw & all, rw | all, rw ^ all
    println all & ~rw, describe(all & ~rw)

    mut q := 0
    q |= Perm.Write as int
    q |= Perm.Delete as int
    println q, describe(q)
    q &= ~(Perm.Write as int)
    println q, describe(q)
    q ^= Perm.Admin as int
    println q, describe(q)

    base := (Perm.Read as int) | (Perm.Write as int) | (Perm.Exec as int)
    mut listing := ""
    repeat 8 with i:
        listing = listing + describe(i & base) + " "
    end
    println listing

    println count_flags(0), count_flags(rw), count_flags(all)
end

func count_flags(bits: int): int:
    mut v := bits
    mut n := 0
    until v != 0:
        v = v & (v - 1)
        n = n + 1
    end
    ret n
end
