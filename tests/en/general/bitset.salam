// A bitset spread over an array of 64-bit words: word/bit addressing by
// shift and mask, set/clear/flip/test, the set algebra (union,
// intersection, difference, symmetric difference, complement) and a
// population count over the whole structure.

struct BitSet:
    pub w0: u64 = 0
    pub w1: u64 = 0
    pub w2: u64 = 0
    pub w3: u64 = 0
end

func word_of(i: int): int:
    ret i >> 6
end

func bit_of(i: int): u64:
    ret (1 as u64) << ((i & 63) as u64)
end

func get_word(s: BitSet, w: int): u64:
    if w == 0: ret s.w0 end
    if w == 1: ret s.w1 end
    if w == 2: ret s.w2 end
    ret s.w3
end

func with_word(s: BitSet, w: int, v: u64): BitSet:
    if w == 0: ret BitSet { w0 = v, w1 = s.w1, w2 = s.w2, w3 = s.w3 } end
    if w == 1: ret BitSet { w0 = s.w0, w1 = v, w2 = s.w2, w3 = s.w3 } end
    if w == 2: ret BitSet { w0 = s.w0, w1 = s.w1, w2 = v, w3 = s.w3 } end
    ret BitSet { w0 = s.w0, w1 = s.w1, w2 = s.w2, w3 = v }
end

func bs_set(s: BitSet, i: int): BitSet:
    w := word_of(i)
    ret with_word(s, w, get_word(s, w) | bit_of(i))
end

func bs_clear(s: BitSet, i: int): BitSet:
    w := word_of(i)
    ret with_word(s, w, get_word(s, w) & ~bit_of(i))
end

func bs_flip(s: BitSet, i: int): BitSet:
    w := word_of(i)
    ret with_word(s, w, get_word(s, w) ^ bit_of(i))
end

func bs_test(s: BitSet, i: int): bool:
    ret (get_word(s, word_of(i)) & bit_of(i)) != (0 as u64)
end

func bs_or(a: BitSet, b: BitSet): BitSet:
    ret BitSet { w0 = a.w0 | b.w0, w1 = a.w1 | b.w1, w2 = a.w2 | b.w2, w3 = a.w3 | b.w3 }
end

func bs_and(a: BitSet, b: BitSet): BitSet:
    ret BitSet { w0 = a.w0 & b.w0, w1 = a.w1 & b.w1, w2 = a.w2 & b.w2, w3 = a.w3 & b.w3 }
end

func bs_xor(a: BitSet, b: BitSet): BitSet:
    ret BitSet { w0 = a.w0 ^ b.w0, w1 = a.w1 ^ b.w1, w2 = a.w2 ^ b.w2, w3 = a.w3 ^ b.w3 }
end

func bs_not(a: BitSet): BitSet:
    ret BitSet { w0 = ~a.w0, w1 = ~a.w1, w2 = ~a.w2, w3 = ~a.w3 }
end

func bs_diff(a: BitSet, b: BitSet): BitSet:
    ret bs_and(a, bs_not(b))
end

func popcount64(x: u64): int:
    mut v := x
    mut n := 0
    until v != (0 as u64):
        v = v & (v - (1 as u64))
        n = n + 1
    end
    ret n
end

func bs_count(s: BitSet): int:
    ret popcount64(s.w0) + popcount64(s.w1) + popcount64(s.w2) + popcount64(s.w3)
end

func bs_empty(s: BitSet): bool:
    ret (s.w0 | s.w1 | s.w2 | s.w3) == (0 as u64)
end

func bs_eq(a: BitSet, b: BitSet): bool:
    ret bs_empty(bs_xor(a, b))
end

func bs_show(s: BitSet, n: int): str:
    mut out := ""
    mut i := 0
    until i < n:
        if bs_test(s, i):
            out = out + "1"
        else:
            out = out + "0"
        end
        i = i + 1
    end
    ret out
end

func main:
    // word and bit addressing
    println word_of(0), word_of(63), word_of(64), word_of(127), word_of(255)
    println bit_of(0), bit_of(1), bit_of(63), bit_of(64), bit_of(65)

    // set a handful of bits, including across every word boundary
    mut s := BitSet {}
    s = bs_set(s, 0)
    s = bs_set(s, 5)
    s = bs_set(s, 63)
    s = bs_set(s, 64)
    s = bs_set(s, 127)
    s = bs_set(s, 200)
    s = bs_set(s, 255)
    println bs_count(s)
    println bs_test(s, 0), bs_test(s, 1), bs_test(s, 63), bs_test(s, 64), bs_test(s, 255)
    println s.w0, s.w1, s.w2, s.w3

    // setting an already-set bit changes nothing; clearing is its inverse
    s = bs_set(s, 5)
    println bs_count(s)
    s = bs_clear(s, 5)
    println bs_count(s), bs_test(s, 5)
    s = bs_clear(s, 5)
    println bs_count(s)

    // flip toggles, twice returns to the start
    before := bs_count(s)
    s = bs_flip(s, 5)
    mid := bs_count(s)
    s = bs_flip(s, 5)
    println before, mid, bs_count(s)

    // the sieve of Eratosthenes over the first 64 numbers
    mut composite := BitSet {}
    mut p := 2
    until p * p < 64:
        if !bs_test(composite, p):
            mut k := p * p
            until k < 64:
                composite = bs_set(composite, k)
                k = k + p
            end
        end
        p = p + 1
    end
    mut primes := ""
    mut n := 2
    until n < 64:
        if !bs_test(composite, n):
            primes = primes + n + " "
        end
        n = n + 1
    end
    println primes
    println 62 - bs_count(composite)

    // set algebra over two small sets
    mut a := BitSet {}
    mut b := BitSet {}
    mut i := 0
    until i < 16:
        if i % 2 == 0: a = bs_set(a, i) end
        if i % 3 == 0: b = bs_set(b, i) end
        i = i + 1
    end
    println bs_show(a, 16)
    println bs_show(b, 16)
    println bs_show(bs_or(a, b), 16)
    println bs_show(bs_and(a, b), 16)
    println bs_show(bs_xor(a, b), 16)
    println bs_show(bs_diff(a, b), 16)
    println bs_show(bs_diff(b, a), 16)
    println bs_count(a), bs_count(b), bs_count(bs_or(a, b)), bs_count(bs_and(a, b))

    // inclusion-exclusion: |A| + |B| == |A or B| + |A and B|
    println bs_count(a) + bs_count(b) == bs_count(bs_or(a, b)) + bs_count(bs_and(a, b))

    // union of the two differences is the symmetric difference
    println bs_eq(bs_or(bs_diff(a, b), bs_diff(b, a)), bs_xor(a, b))

    // complementing twice is the identity, and a full set has 256 bits
    println bs_eq(bs_not(bs_not(a)), a)
    println bs_count(bs_not(BitSet {}))
    println bs_empty(BitSet {}), bs_empty(a)
    println bs_eq(bs_and(a, bs_not(a)), BitSet {})
    println bs_count(bs_or(a, bs_not(a)))
end
