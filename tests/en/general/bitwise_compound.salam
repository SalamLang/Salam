// The compound bit-assignments &= |= ^= <<= >>= : on plain variables,
// on array elements, on struct fields, inside loops, and the rule that
// `lhs op= rhs` evaluates the whole right-hand side first (assignment
// is the loosest operator).

struct Flags:
    pub bits: int = 0
    pub func set(m: int):
        this.bits |= m
    end
    pub func clear(m: int):
        this.bits &= ~m
    end
    pub func toggle(m: int):
        this.bits ^= m
    end
    pub func has(m: int): bool:
        ret (this.bits & m) == m
    end
end

func main:
    // the plain forms, one at a time from a known start
    mut a := 0b1100
    a &= 0b1010
    println a
    mut b := 0b1100
    b |= 0b1010
    println b
    mut c := 0b1100
    c ^= 0b1010
    println c
    mut d := 0b1100
    d <<= 3
    println d
    mut e := 0b1100
    e >>= 2
    println e

    // chained, in sequence
    mut f := 0
    f |= 5
    f &= 6
    f ^= 1
    f <<= 2
    f >>= 1
    println f

    // the right-hand side is evaluated as a whole first
    mut g := 0xF0
    g |= 1 << 2 | 1
    println g
    mut h := 0xFF
    h &= 0x0F | 0x30
    println h
    mut i := 8
    i <<= 1 + 2
    println i
    mut j := 1024
    j >>= 8 / 4
    println j

    // ~ combines with &= to clear bits
    mut k := 0b1111
    k &= ~0b0101
    println k

    // on array elements
    mut xs := [1, 2, 3, 4] as int[4]
    repeat 4 with n:
        xs[n] <<= 4
        xs[n] |= n
    end
    println xs[0], xs[1], xs[2], xs[3]
    xs[0] ^= 0xFF
    xs[3] &= 0x0F
    println xs[0], xs[3]

    // on struct fields, directly and through methods
    mut fl := Flags { bits = 0 }
    fl.bits |= 0b0001
    fl.bits |= 0b0100
    println fl.bits, fl.has(0b0001), fl.has(0b0010)
    fl.set(0b1000)
    fl.toggle(0b0001)
    println fl.bits, fl.has(0b1000), fl.has(0b0001)
    fl.clear(0b0100)
    println fl.bits

    // accumulating a mask in a loop
    mut mask := 0
    repeat 8 with n:
        if n % 2 == 0:
            mask |= 1 << n
        end
    end
    println mask

    // and clearing it back down one bit at a time
    mut m2 := mask
    repeat 8 with n:
        m2 &= ~(1 << n)
    end
    println m2

    // xor-swap without a temporary
    mut p := 0xAAAA
    mut q := 0x5555
    p ^= q
    q ^= p
    p ^= q
    println p, q
end
