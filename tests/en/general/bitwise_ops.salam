 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */


func main:
    println 0 & 0, 0 & 1, 1 & 0, 1 & 1
    println 0 | 0, 0 | 1, 1 | 0, 1 | 1
    println 0 ^ 0, 0 ^ 1, 1 ^ 0, 1 ^ 1

    println ~0, ~1, ~2, ~127
    println ~(-1), ~(-2), ~(-128)

    a := 0b1100
    b := 0b1010
    println a & b, a | b, a ^ b
    println a & ~b, ~a & b
    println ((a & b) | (a ^ b)) == (a | b)

    x := 0x5A5A
    println x & 0, x & (-1), x | 0, x | (-1)
    println x ^ 0, x ^ x, (x ^ (-1)) == ~x

    p := 0x0F0F
    q := 0x3333
    r := 0x5555
    println (p & q) == (q & p), (p | q) == (q | p), (p ^ q) == (q ^ p)
    println ((p & q) & r) == (p & (q & r))
    println ((p | q) | r) == (p | (q | r))
    println ((p ^ q) ^ r) == (p ^ (q ^ r))
    println (p & (q | r)) == ((p & q) | (p & r))
    println (p | (q & r)) == ((p | q) & (p | r))

    println ~(p & q) == (~p | ~q)
    println ~(p | q) == (~p & ~q)

    m := 1234
    n := 5678
    println (m ^ n) + ((m & n) * 2) == m + n
    println (m | n) + (m & n) == m + n
    println (m ^ n) + ((m & n) * 2)

    neg := -12
    println neg & 0xFF, neg | 0x0F, neg ^ (-1), ~neg

    println 0xFF & 0b11110000
    println 0b101 | 0x0A
    println 255 == 0xFF, 255 == 0b11111111
end
