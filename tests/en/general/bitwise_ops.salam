// Exhaustive ground rules for the bitwise operators on the default
// signed 32-bit `int`: per-bit truth tables, two's-complement `~`,
// the absorbing/identity elements, De Morgan and the classic
// xor/and decomposition of addition.

func main:
    // one-bit truth tables
    println 0 & 0, 0 & 1, 1 & 0, 1 & 1
    println 0 | 0, 0 | 1, 1 | 0, 1 | 1
    println 0 ^ 0, 0 ^ 1, 1 ^ 0, 1 ^ 1

    // ~x is -x - 1 in two's complement, in both directions
    println ~0, ~1, ~2, ~127
    println ~(-1), ~(-2), ~(-128)

    // nibble patterns
    a := 0b1100
    b := 0b1010
    println a & b, a | b, a ^ b
    println a & ~b, ~a & b
    println ((a & b) | (a ^ b)) == (a | b)

    // identity / absorbing elements
    x := 0x5A5A
    println x & 0, x & (-1), x | 0, x | (-1)
    println x ^ 0, x ^ x, (x ^ (-1)) == ~x

    // commutative, associative, distributive
    p := 0x0F0F
    q := 0x3333
    r := 0x5555
    println (p & q) == (q & p), (p | q) == (q | p), (p ^ q) == (q ^ p)
    println ((p & q) & r) == (p & (q & r))
    println ((p | q) | r) == (p | (q | r))
    println ((p ^ q) ^ r) == (p ^ (q ^ r))
    println (p & (q | r)) == ((p & q) | (p & r))
    println (p | (q & r)) == ((p | q) & (p | r))

    // De Morgan
    println ~(p & q) == (~p | ~q)
    println ~(p | q) == (~p & ~q)

    // xor is add-without-carry, and holds the carries
    m := 1234
    n := 5678
    println (m ^ n) + ((m & n) * 2) == m + n
    println (m | n) + (m & n) == m + n
    println (m ^ n) + ((m & n) * 2)

    // negative operands keep working bit for bit
    neg := -12
    println neg & 0xFF, neg | 0x0F, neg ^ (-1), ~neg

    // literal radices denote the same bits
    println 0xFF & 0b11110000
    println 0b101 | 0x0A
    println 255 == 0xFF, 255 == 0b11111111
end
