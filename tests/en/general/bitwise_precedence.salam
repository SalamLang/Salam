 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

func main:
    println 1 | 2 ^ 3 & 3
    println 1 | (2 ^ (3 & 3))
    println ((1 | 2) ^ 3) & 3
    println 12 ^ 10 & 6, (12 ^ 10) & 6, 12 ^ (10 & 6)
    println 8 | 4 ^ 12, (8 | 4) ^ 12, 8 | (4 ^ 12)

    println 15 & 12 & 10, (15 & 12) & 10
    println 1 | 2 | 4, (1 | 2) | 4
    println 15 ^ 12 ^ 10, (15 ^ 12) ^ 10

    println 2 << 1 + 2, (2 << 1) + 2
    println 96 >> 2 * 2, (96 >> 2) * 2
    println 1 << 8 / 2, (1 << 8) / 2

    println 1 << 2 | 1, (1 << 2) | 1
    println 3 & 1 << 2, 3 & (1 << 2)
    println 6 ^ 1 << 1, 6 ^ (1 << 1)

    println (5 & 4) != 0
    println (5 & 2) != 0

    println 1 << 2 == 4
    println 8 >> 1 > 3

    println ((5 & 4) != 0) && ((5 & 1) != 0)
    println ((5 & 4) != 0) || ((5 & 2) != 0)
    println (0 | 0) == 0 || (1 & 1) == 1
    println (3 & 1) == 1 && (3 | 4) == 7 || false

    println true || false && false
    println (true || false) && false

    println ~3 & 15, ~(3 & 15)
    println -4 >> 1, -(4 >> 1)
    println ~1 + 1, ~(1 + 1)

    println 7 as u8 & 12
    println (7 as u8) & (12 as u8)

    mut z := 0
    z = 1 | 2 & 3
    println z
    mut w := 12
    w &= 10 | 3
    println w
end
