// Precedence and associativity of the bit operators relative to each
// other and to arithmetic, comparison and the logical connectives.
// Salam follows C: `**` > unary > `as` > `* / %` > `+ -` > `<< >>` >
// `< > <= >=` > `== !=` > `&` > `^` > `|` > `&&` > `||` > assignment.

func main:
    // & tighter than ^ tighter than |
    println 1 | 2 ^ 3 & 3
    println 1 | (2 ^ (3 & 3))
    println ((1 | 2) ^ 3) & 3
    println 12 ^ 10 & 6, (12 ^ 10) & 6, 12 ^ (10 & 6)
    println 8 | 4 ^ 12, (8 | 4) ^ 12, 8 | (4 ^ 12)

    // all three are left-associative
    println 15 & 12 & 10, (15 & 12) & 10
    println 1 | 2 | 4, (1 | 2) | 4
    println 15 ^ 12 ^ 10, (15 ^ 12) ^ 10

    // arithmetic binds tighter than the shifts
    println 2 << 1 + 2, (2 << 1) + 2
    println 96 >> 2 * 2, (96 >> 2) * 2
    println 1 << 8 / 2, (1 << 8) / 2

    // shifts bind tighter than the bit operators
    println 1 << 2 | 1, (1 << 2) | 1
    println 3 & 1 << 2, 3 & (1 << 2)
    println 6 ^ 1 << 1, 6 ^ (1 << 1)

    // comparison binds tighter than & ^ |, so a mask test needs parens
    println (5 & 4) != 0
    println (5 & 2) != 0

    // ... and looser than the shifts
    println 1 << 2 == 4
    println 8 >> 1 > 3

    // & ^ | bind tighter than && and ||, but looser than ==, so a mask
    // test written without parentheses is a type error, not a surprise
    // result (see tests/en/errors/bitwise_mask_no_parens.salam)
    println ((5 & 4) != 0) && ((5 & 1) != 0)
    println ((5 & 4) != 0) || ((5 & 2) != 0)
    println (0 | 0) == 0 || (1 & 1) == 1
    println (3 & 1) == 1 && (3 | 4) == 7 || false

    // && tighter than ||
    println true || false && false
    println (true || false) && false

    // unary ~ and - bind tighter than every binary operator here
    println ~3 & 15, ~(3 & 15)
    println -4 >> 1, -(4 >> 1)
    println ~1 + 1, ~(1 + 1)

    // `as` binds tighter than the arithmetic and bit operators
    println 7 as u8 & 12
    println (7 as u8) & (12 as u8)

    // assignment is the loosest of all
    mut z := 0
    z = 1 | 2 & 3
    println z
    mut w := 12
    w &= 10 | 3
    println w
end
