 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

func rotl8(x: u8, n: u8): u8:
    ret (x << n) | (x >> ((8 as u8 - n) & (7 as u8)))
end

func rotr8(x: u8, n: u8): u8:
    ret (x >> n) | (x << ((8 as u8 - n) & (7 as u8)))
end

func rotl16(x: u16, n: u16): u16:
    ret (x << n) | (x >> ((16 as u16 - n) & (15 as u16)))
end

func rotl32(x: u32, n: u32): u32:
    ret (x << n) | (x >> ((32 as u32 - n) & (31 as u32)))
end

func rotr32(x: u32, n: u32): u32:
    ret (x >> n) | (x << ((32 as u32 - n) & (31 as u32)))
end

func rotl64(x: u64, n: u64): u64:
    ret (x << n) | (x >> ((64 as u64 - n) & (63 as u64)))
end

func rotr64(x: u64, n: u64): u64:
    ret (x >> n) | (x << ((64 as u64 - n) & (63 as u64)))
end

func main:
    mut line := ""
    mut i := 0
    until i < 9:
        line = line + rotl8(1 as u8, i as u8) + " "
        i = i + 1
    end
    println line

    println rotl8(0xB7 as u8, 0 as u8), rotl8(0xB7 as u8, 8 as u8)
    println rotl32(0xDEADBEEF as u32, 0 as u32), rotl32(0xDEADBEEF as u32, 32 as u32)

    v8 := 0b1001_0110 as u8
    println v8, rotl8(v8, 3 as u8), rotr8(rotl8(v8, 3 as u8), 3 as u8)
    v32 := 0x12345678 as u32
    println rotl32(v32, 8 as u32), rotr32(rotl32(v32, 8 as u32), 8 as u32)

    println rotl32(0x12345678 as u32, 8 as u32)
    println rotl32(0x12345678 as u32, 16 as u32)
    println rotl32(0x12345678 as u32, 24 as u32)

    println rotr32(v32, 12 as u32) == rotl32(v32, 20 as u32)
    println rotr64(0x0123456789ABCDEF as u64, 16 as u64) == rotl64(0x0123456789ABCDEF as u64, 48 as u64)

    println rotl16(0xABCD as u16, 8 as u16)

    w := 0x0123456789ABCDEF as u64
    println rotl64(w, 4 as u64)
    println rotl64(w, 32 as u64)
    println rotr64(w, 4 as u64)
    println rotl64(w, 63 as u64)

    mut ones_before := 0
    mut ones_after := 0
    mut b := 0
    src := 0xF0F0F0F0 as u32
    rot := rotl32(src, 5 as u32)
    until b < 32:
        if ((src >> (b as u32)) & (1 as u32)) == (1 as u32):
            ones_before = ones_before + 1
        end
        if ((rot >> (b as u32)) & (1 as u32)) == (1 as u32):
            ones_after = ones_after + 1
        end
        b = b + 1
    end
    println ones_before, ones_after, ones_before == ones_after

    mut acc := 0x9E3779B9 as u32
    mut k := 0
    until k < 32:
        acc = rotl32(acc, 1 as u32)
        k = k + 1
    end
    println acc, acc == (0x9E3779B9 as u32)
end
