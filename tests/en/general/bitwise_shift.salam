// Shift operators on signed `int`: `<<` as multiply-by-power-of-two,
// `>>` as an arithmetic (sign-propagating) divide, the round-trip
// behaviour of shifting out bits, and shift/add precedence.

func shl(x: int, n: int): int:
    ret x << n
end

func shr(x: int, n: int): int:
    ret x >> n
end

func main:
    // powers of two by shifting
    mut i := 0
    mut line := ""
    until i < 16:
        line = line + (1 << i) + " "
        i = i + 1
    end
    println line

    // << n is * 2**n while nothing is shifted out
    println 3 << 0, 3 << 1, 3 << 4, 3 << 10
    println (3 << 10) == 3 * 1024

    // >> n on non-negative values is / 2**n
    println 1024 >> 0, 1024 >> 1, 1024 >> 4, 1024 >> 10
    println 1000 >> 3, 1000 / 8

    // >> is arithmetic: the sign bit is replicated, so it floors
    println -1 >> 1, -2 >> 1, -8 >> 2, -9 >> 1
    println -1024 >> 4, -1024 / 16
    println -7 >> 1, -7 / 2

    // shifting out low bits is lossy, high bits round-trip
    v := 0b1011_0110
    println v, v >> 3, (v >> 3) << 3
    println (v << 4) >> 4

    // shifts bind looser than + and - (C precedence)
    println 1 << 4 + 1, (1 << 4) + 1
    println 64 >> 2 + 1, (64 >> 2) + 1
    println 1 << 3 - 1, (1 << 3) - 1

    // and tighter than the comparisons
    println 1 << 3 > 4, 16 >> 2 == 4

    // shifts through a call boundary (no constant folding involved)
    println shl(1, 30), shr(1073741824, 30)
    println shl(-1, 4), shr(-16, 4)

    // building and taking apart a value one shift at a time
    mut packed := 0
    packed = packed | (0xAB << 8)
    packed = packed | 0xCD
    println packed, packed >> 8, packed & 0xFF
end
