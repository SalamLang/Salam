// Bit operations on the unsigned widths u8/u16/u32/u64: masking and
// wrapping happen in the operand's own width, `>>` is a logical shift
// (no sign to propagate) and `~` fills the whole width with ones.

func mask_u8(x: u8, m: u8): u8:
    ret x & m
end

func hi16(x: u32): u32:
    ret x >> 16
end

func lo16(x: u32): u32:
    ret x & (0xFFFF as u32)
end

func main:
    // ~ produces the all-ones value of each width
    println ~(0 as u8), ~(0 as u16), ~(0 as u32), ~(0 as u64)

    // the top bit is just another bit, not a sign
    println (1 as u8) << (7 as u8)
    println (1 as u16) << (15 as u16)
    println (1 as u32) << (31 as u32)
    println (1 as u64) << (63 as u64)

    // >> is logical: zeros come in at the top
    println ~(0 as u8) >> (1 as u8)
    println ~(0 as u16) >> (1 as u16)
    println ~(0 as u32) >> (1 as u32)
    println ~(0 as u64) >> (1 as u64)
    println ~(0 as u32) >> (28 as u32)

    // results wrap inside the operand width, they do not widen
    println (0xF0 as u8) << (4 as u8)
    println (0xFF as u8) + (1 as u8)
    println (0xFFFF as u16) + (1 as u16)
    println (0 as u32) - (1 as u32)
    println (0 as u64) - (1 as u64)

    // masking a 32-bit word apart and back together
    w := 0xDEADBEEF as u32
    println hi16(w), lo16(w)
    println (hi16(w) << (16 as u32)) | lo16(w)
    println ((hi16(w) << (16 as u32)) | lo16(w)) == w

    // byte extraction
    println (w >> (24 as u32)) & (0xFF as u32)
    println (w >> (16 as u32)) & (0xFF as u32)
    println (w >> (8 as u32)) & (0xFF as u32)
    println w & (0xFF as u32)

    // nibble masking through a call
    println mask_u8(0xAB as u8, 0x0F as u8), mask_u8(0xAB as u8, 0xF0 as u8)

    // & | ^ on a full 64-bit pattern
    p := 0xF0F0F0F0F0F0F0F0 as u64
    q := 0x0F0F0F0F0F0F0F0F as u64
    println p & q, p | q, p ^ q
    println (p | q) == ~(0 as u64)
    println p ^ ~(0 as u64)

    // compound assignment stays inside the width
    mut u := 0x80 as u8
    u <<= 1 as u8
    println u
    u = 0x80 as u8
    u >>= 7 as u8
    println u
    mut v := 1 as u32
    v <<= 31 as u32
    println v
    v >>= 31 as u32
    println v
    mut t := 0 as u64
    t |= (1 as u64) << (63 as u64)
    println t
    t ^= ~(0 as u64)
    println t

    // an unsigned comparison does not order by the signed reading
    big := ~(0 as u32)
    println big > (1 as u32), big > (2147483647 as u32)
    println ~(0 as u64) > (9223372036854775807 as u64)
end
