package main

import mem

noinline func opaque(v: int): int:
    ret v
end

func in_box(x: int, y: int, w: int, h: int): bool:
    ret x >= 0 and y >= 0 and x < w and y < h
end

func on_edge(x: int, y: int, w: int, h: int): bool:
    ret x == 0 or y == 0 or x == w - 1 or y == h - 1
end

func pick(x: int, y: int): int:
    mut r := 7
    if x > 3 and y < 9:
        r = x + y
    else x < 0 or y > 20:
        r = x - y
    end
    ret r
end

func mixed(a: int, b: int, c: int): int:
    mut s := 0
    if (a > 0 and b > 0) or c > 0:
        s = 1
    end
    if (a > 0 or b > 0) and c > 0:
        s += 2
    end
    if not (a > 0 and b > 0):
        s += 4
    end
    if not (a > 0 or c > 0):
        s += 8
    end
    ret s
end

func stored(a: int, b: int, c: int): int:
    both := a > b and b > c
    either := a < b or b < c
    mut s := 0
    if both: s++ end
    if either: s += 2 end
    if both and either: s += 4 end
    ret s
end

func count_box(buf: u8*, n: int, w: int, h: int): int:
    mut hits := 0
    repeat n in i:
        x := (buf[i] as int) - 40
        y := (buf[i + 1] as int) - 30
        if in_box(x, y, w, h):
            hits += x * y + 1
        else on_edge(x, y, w, h):
            hits--
        end
    end
    ret hits
end

func loop_cond(p: u8*, n: int, k: int): int:
    mut i := 0
    until i < n and (p[i] as int) != k:
        i++
    end
    ret i
end

func main:
    buf := mem.Allocate(256 as u64) as u8*
    repeat 256 in i:
        buf[i] = ((i * 73 + 11) & 255) as u8
    end
    println count_box(buf, 200, opaque(90), opaque(60))
    println loop_cond(buf, 256, opaque(84)), loop_cond(buf, opaque(0), 84), loop_cond(buf, 100, opaque(255))
    mut t := 0
    mut x := 0 - 2
    until x < 7:
        mut y := 0 - 2
        until y < 7:
            println x, y, in_box(x, y, 4, 3), on_edge(x, y, 4, 3), pick(x * 3, y * 4), mixed(x, y, x - y), stored(x, y, 1)
            t += pick(x, y) + mixed(y, x, y - x)
            y += 3
        end
        x += 3
    end
    println t
end
