func main:
    mut count := 0
    repeat 4 in i:
        repeat 4 in j:
            if j == i: break end
            count++
        end
    end
    println count

    mut sum := 0
    repeat 3:
        repeat 3 in j:
            if j == 1: continue end
            sum++
        end
    end
    println sum

    mut outer := 0
    repeat 3:
        outer++
        repeat 5:
            break
        end
    end
    println outer

    mut total := 0
    mut x := 0
    until x < 3:
        x++
        repeat 10 in y:
            if y == 2: break end
            total++
        end
    end
    println total

    mut outerhits := 0
    mut innerhits := 0
    repeat 3:
        outerhits++
        repeat 4 in j:
            if j % 2 == 0: continue end
            innerhits++
        end
    end
    println outerhits
    println innerhits
end
