func main:
    mut a := 0
    repeat 10 in i:
        if i == 5: break end
        a += i
    end
    println a

    mut b := 0
    repeat 10 in i:
        if i % 2 == 0: continue end
        b += i
    end
    println b

    mut c := 0
    repeat 100 in j:
        if j == 7: break end
        c++
    end
    println c

    mut d := 0
    mut k := 0
    until k < 10:
        k++
        if k % 2 == 0: continue end
        d++
    end
    println d

    mut e := 0
    repeat 10:
        e++
        if e == 3: break end
    end
    println e

    mut f := 0
    mut g := 0
    repeat 6:
        g++
        if g % 3 == 0: continue end
        f++
    end
    println f
end
