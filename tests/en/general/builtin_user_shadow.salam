func env(name: str): str:
    ret "env:" + name
end

func listdir(path: str): int:
    ret len(path) + 6
end

func strcmp(a: str, b: str): int:
    ret len(a) * 10 + len(b)
end

func lang(): str:
    ret "mine"
end

func hash(x: int): int:
    ret x * 2
end

func char_code(c: str): int:
    ret len(c) + 98
end

func main:
    println env("X"), listdir("/"), strcmp("a", "a"), lang(), hash(21), char_code("A")
end
