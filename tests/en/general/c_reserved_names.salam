struct FILE:
    pub EOF: int = -1
    pub NULL: int = 0
    pub linux: bool = true
    pub M_PI: f64 = 3.0
    pub func exit(): int: ret this.EOF + this.NULL end
end

enum tm:
    stdin
    stdout
end

func abs(NULL: int, INFINITY: f64, unix: int): f64:
    ret (NULL as f64) + INFINITY + (unix as f64)
end

func main:
    pow := 2.0
    strcmp := "x"
    printf := 3
    NAN := 4
    _Bool := 5
    _Reserved := 6
    __twice := 7
    y := pow ^^ 3.0
    same := strcmp == "x"
    f := FILE { EOF = 10 }
    println y, same, printf + NAN + _Bool + _Reserved + __twice
    println f.exit(), f.linux, f.M_PI, tm.stdout as int
    println abs(1, 2.5, 3)
end
