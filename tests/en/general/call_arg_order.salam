func bump(n &: int): int:
    n += 1
    ret n
end

func pair(a: int, b: int): int:
    ret a * 10 + b
end

func triple(a: int, b: int, c: int): int:
    ret a * 100 + b * 10 + c
end

func apply(f: func (int) int, x: int): int:
    ret f(x)
end

func main:
    mut c := 1
    println pair(c, bump(c))
    mut d := 1
    println pair(d + 0, bump(d))
    mut e := 1
    println triple(e, bump(e), e)
    mut f := 1
    println apply((x: int): ret x + f end, bump(f))
    mut g := 5
    println pair(bump(g), g)
end
