func bump(n &: int): int:
    n += 1
    ret n
end

func pick(a: int, p: void*, b: int): int:
    if p == null:
        ret a * 10 + b
    end
    ret 0
end

func main:
    mut h := 1
    println pick(h, null, bump(h))
end
