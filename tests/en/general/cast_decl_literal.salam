func main:
    small := 300 as u8
    letter := 65 as char
    whole := 3.9 as int
    flag := 1 as bool
    wide := -1 as u32
    one := 1587 as uchar
    tiny := 100 as i8
    println small, letter, whole, flag, wide, one, tiny
end
