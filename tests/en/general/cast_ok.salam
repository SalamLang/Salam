// Casts the useless-cast rule (E093) must NOT flag: each of these looks
// like it could be a no-op cast, but the target type only comes from the
// cast itself, so removing it would change (or break) the program.

func main:
    // Numeric-literal disambiguation: without the cast, 5 defaults to i32.
    a := 5 as i64
    println a

    // Real, meaningful conversion.
    b := 3.7
    println b as int

    // Generic struct instantiation via the `:= expr as Type` sugar.
    mut v := Vector {} as Vector<int>
    v.push(1)
    v.push(2)
    println v.len()
end
