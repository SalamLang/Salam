struct Acc:
    pub v: int = 0
    pub func add(n: int): Acc*:
        this.v = this.v + n
        ret this
    end
    pub func get(): int: ret this.v end
end

func main:
    mut a := Acc {}
    a.add(2).add(3).add(5)
    println a.get()
end
