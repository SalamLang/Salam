struct Acc:
    pub v: int = 0
    pub func add(n: int): Acc*:
        this.v += n
        ret this
    end
    pub func get(): int: ret this.v end
end

func main:
    mut a := Acc {}
    a.Add(2).Add(3).Add(5)
    println a.Get()
end
