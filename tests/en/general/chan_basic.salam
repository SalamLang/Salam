import chan
import sync

mut jobs := chan.Chan {} as chan.Chan<i64>
mut results := chan.Chan {} as chan.Chan<i64>
mut wg := sync.NewWaitGroup()

func worker():
    mut ok := true
    until true:
        v := jobs.Recv(ok)
        if not ok: break end
        results.Send(v * v)
    end
    sync.Done(wg)
end

func main:
    jobs.Init(4 as i64)
    results.Init(64 as i64)

    sync.Add(wg, 3 as i64)
    t1 := spawn(worker)
    t2 := spawn(worker)
    t3 := spawn(worker)

    mut i := 1 as i64
    until i <= 20:
        jobs.Send(i)
        i++
    end
    jobs.Close()

    sync.Wait(wg)
    join(t1)
    join(t2)
    join(t3)
    results.Close()

    mut total := 0 as i64
    mut n := 0 as i64
    mut ok := true
    until true:
        v := results.Recv(ok)
        if not ok: break end
        total += v
        n++
    end

    println "count:", n
    println "total:", total
    println "drained:", jobs.Len(), results.Len()
    println "closed:", jobs.IsClosed()
    println "cap:", jobs.Capacity()

    mut ok2 := true
    _ := results.TryRecv(ok2)
    println "try_recv empty:", ok2
    println "send after close:", jobs.Send(1 as i64)

    sync.DestroyWaitGroup(wg)
    jobs.Free()
    results.Free()
end
