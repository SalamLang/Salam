import chan
import sync

mut hand := chan.Chan {} as chan.Chan<i64>
mut done := chan.Chan {} as chan.Chan<i64>
mut wg := sync.NewWaitGroup()

mut sends_done := 0 as i64
mut max_lead := 0 as i64
mut lead_mu := sync.NewMutex()

func producer():
    mut i := 1 as i64
    until i <= 50:
        hand.Send(i)
        sync.Lock(lead_mu)
        sends_done++
        sync.Unlock(lead_mu)
        i++
    end
    hand.Close()
    sync.Done(wg)
end

func consumer():
    mut ok := true
    mut total := 0 as i64
    until true:
        v := hand.Recv(ok)
        if not ok: break end
        sync.Lock(lead_mu)
        lead := sends_done - v
        if lead > max_lead: max_lead = lead end
        sync.Unlock(lead_mu)
        total += v
    end
    done.Send(total)
    sync.Done(wg)
end

func main:
    hand.Init(0 as i64)
    done.Init(1 as i64)

    println "cap:", hand.Capacity()

    sync.Add(wg, 2 as i64)
    t1 := spawn(producer)
    t2 := spawn(consumer)
    sync.Wait(wg)
    join(t1)
    join(t2)

    mut ok := true
    total := done.Recv(ok)
    println "total:", total
    println "no lead:", max_lead <= 0

    mut idle := chan.Chan {} as chan.Chan<i64>
    idle.Init(2 as i64)
    t0 := sync.NowMs()
    mut ok2 := true
    _ := idle.RecvTimeout(ok2, 120 as i64)
    waited := sync.NowMs() - t0
    println "recv timed out:", not ok2
    println "waited enough:", waited >= 110

    mut lonely := chan.Chan {} as chan.Chan<i64>
    lonely.Init(0 as i64)
    sent := lonely.SendTimeout(99 as i64, 120 as i64)
    mut ok3 := true
    _2 := lonely.TryRecv(ok3)
    println "send timed out:", not sent
    println "nothing left:", not ok3

    mut small := chan.Chan {} as chan.Chan<i64>
    small.Init(1 as i64)
    first := small.SendTimeout(1 as i64, 100 as i64)
    second := small.SendTimeout(2 as i64, 100 as i64)
    println "buffered timeout:", first, second

    sync.DestroyWaitGroup(wg)
    sync.Destroy(lead_mu)
    hand.Free()
    done.Free()
    idle.Free()
    lonely.Free()
    small.Free()
end
