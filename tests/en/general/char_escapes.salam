func main:
    println 'A'
    println '\x41'
    println '\n' as int
    println '\t' as int
    println '\r' as int
    println '\a' as int
    println '\b' as int
    println '\f' as int
    println '\v' as int
    println '\0' as int
    println '\x5A'
    println '\xD8' as int
    println '\U00000041' as int
end
