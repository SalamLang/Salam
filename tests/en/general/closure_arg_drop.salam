mut g_keep := Vector {} as Vector<func (int) int>

func apply(f: func (int) int, x: int): int:
    ret f(x)
end

func stash(f: func (int) int):
    g_keep.push(f)
end

func twice(f: func (int) int, x: int): int:
    ret apply(f, apply(f, x))
end

func bump(n &: int): int:
    n += 1
    ret n
end

func main:
    mut total := 0
    repeat 4 in i:
        base := i * 3
        total += apply((x: int): ret x + base end, 1)
    end
    k := 7
    stash((x: int): ret x * k end)
    mut c := 1
    total += apply((x: int): ret x + c end, bump(c))
    println total, g_keep.get(0)(2), twice((x: int): ret x + k end, 1)
end
