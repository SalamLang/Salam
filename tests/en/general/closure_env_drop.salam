mut g_keep := Vector {} as Vector<func (int) int>

func apply(f: func (int) int, x: int): int:
    ret f(x)
end

func stash(f: func (int) int):
    g_keep.push(f)
end

func main:
    mut total := 0
    repeat 3 in i:
        base := i * 10
        add := (x: int): ret x + base end
        total += add(1)
        total += apply(add, 2)
    end
    k := 5
    kept := (x: int): ret x * k end
    stash(kept)
    println total, g_keep.get(0)(3)
end
