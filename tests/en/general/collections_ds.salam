import collections

func main:
    mut v := Vector {} as collections.Vector<int> v.Push(10)
    v.Push(20)
    v.Push(30)
    println v.Len()
    println v[1]
    println v.Get(2)
    v.Insert(1, 99)
    println v.Get(1)
    println v.RemoveAt(1)
    println v.Len()
    mut vit := v.Iter()
    mut vsum := 0
    until vit.HasNext():
        vsum += vit.Value()
        vit.Next()
    end
    println vsum

    mut m := HashMap {} as collections.HashMap<str, int> m.Put("a", 1)
    m.Put("b", 2)
    m.Put("a", 9)
    println m.Get("a")
    println m.Has("b")
    println m.Has("z")
    println m.Size()
    m.Remove("a")
    println m.Has("a")
    println m.Size()
    mut total := 0
    mut mit := m.Iter()
    until mit.HasNext():
        total += mit.Value()
        mit.Next()
    end
    println total

    mut st := Stack {} as collections.Stack<int> st.Push(1)
    st.Push(2)
    st.Push(3)
    println st.Pop()
    println st.Size()
    mut q := Queue {} as collections.Queue<int> q.enqueue(10)
    q.enqueue(20)
    println q.dequeue()
    println q.Size()
    mut dq := Deque {} as collections.Deque<int> dq.PushBack(1)
    dq.PushFront(2)
    println dq.FrontVal()
    println dq.PopBack()

    mut pq := PriorityQueue {} as collections.PriorityQueue<int> pq.Push(5)
    pq.Push(1)
    pq.Push(3)
    println pq.Pop()
    println pq.Pop()
    mut ll := LinkedList {} as collections.LinkedList<int> ll.PushBack(1)
    ll.PushFront(0)
    ll.PushBack(2)
    println ll.Size()
    println ll.Get(1)
    println ll.PopFront()
    mut cl := CircularList {} as collections.CircularList<int> cl.Add(10)
    cl.Add(20)
    cl.Add(30)
    println cl.current()
    cl.rotate(2)
    println cl.current()

    mut s := Set {} as collections.Set<str> s.Add("a")
    s.Add("b")
    s.Add("a")
    println s.Size()
    println s.Has("a")
    mut c := Counter {} as collections.Counter<str> c.Add("x")
    c.Add("x")
    c.Add("y")
    println c.count("x")
    println c.distinct()
    p := Pair { first = 7, second = "hi" } as collections.Pair<int, str> println p.first
    println p.second

    println collections.Contains(v, 99)
    println collections.IndexOf(v, 30)
end
