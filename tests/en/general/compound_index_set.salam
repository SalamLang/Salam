mut idx_calls := 0
mut arr_calls := 0

struct Vec2:
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub func + (other: Vec2): Vec2: ret Vec2 { x = this.x + other.x, y = this.y + other.y }
    end
end

struct Tally:
    pub cells: Vector<int> = Vector {} as Vector<int>
    pub gets: int = 0
    pub sets: int = 0
    pub func operator_index(i: int): int:
        this.gets += 1
        ret this.cells.get(i)
    end
    pub func operator_index_set(i: int, x: int):
        this.sets += 1
        this.cells.set(i, x)
    end
end

struct Holder:
    pub items: Vector<int> = Vector {} as Vector<int>
end

func next_slot(): int:
    idx_calls += 1
    ret idx_calls
end

func arr_slot(): int:
    arr_calls += 1
    ret 2
end

func main:
    mut cnt := Vector {} as Vector<int>
    repeat 4 in i:
        cnt.push(i + 1)
    end
    repeat 3 in q:
        cnt[q + 1] += cnt[q]
    end
    println cnt[3]

    mut iv := Vector {} as Vector<int>
    repeat 10 in j:
        iv.push(100 + j)
    end
    iv[0] += 5
    iv[1] -= 3
    iv[2] *= 4
    iv[3] /= 7
    iv[4] %= 7
    iv[5] &= 12
    iv[6] |= 5
    iv[7] ^= 3
    iv[8] <<= 2
    iv[9] >>= 1
    repeat 10 in k:
        println iv[k]
    end

    mut fv := Vector {} as Vector<f64>
    repeat 5 in m:
        fv.push(2.0 + m)
    end
    fv[0] += 0.5
    fv[1] -= 0.25
    fv[2] *= 1.5
    fv[3] /= 2.0
    fv[4] **= 2.0
    repeat 5 in m2:
        println fv[m2]
    end

    mut sv := Vector {} as Vector<str>
    sv.push("ab")
    sv.push("x")
    sv[0] += "cd"
    sv[1] += "y"
    sv[1] += "z"
    println sv[0]
    println sv[1]

    order := Vector {} as Vector<int>
    order.push(2)
    order.push(0)
    order.push(2)
    mut hist := Vector {} as Vector<int>
    repeat 3 in h:
        hist.push(h * 0)
    end
    repeat order.len() in o:
        hist[order[o]] += 1
    end
    println hist[0]
    println hist[1]
    println hist[2]

    mut once := Vector {} as Vector<int>
    repeat 4 in w:
        once.push(w * 10)
    end
    once[next_slot()] += 7
    once[next_slot()] *= 3
    println idx_calls
    println once[1]
    println once[2]

    mut ta := Tally {}
    ta.cells.push(5)
    ta.cells.push(6)
    ta[1] += 10
    ta[0] *= 3
    ta[1] -= 1
    println ta[0]
    println ta[1]
    println ta.gets
    println ta.sets

    mut vs := Vector {} as Vector<Vec2>
    vs.push(Vec2 { x = 1.0, y = 2.0 })
    vs[0] += Vec2 { x = 0.5, y = 0.25 }
    println vs[0].x
    println vs[0].y

    mut ho := Holder {}
    ho.items.push(1)
    ho.items.push(2)
    ho.items[1] += 40
    println ho.items[1]

    mut grid := Vector {} as Vector<Vector<int>>
    mut row := Vector {} as Vector<int>
    row.push(1)
    row.push(2)
    grid.push(row)
    grid[0][1] += 5
    println grid[0][1]
    grid[0][0] = 9
    println grid[0][0]

    mut arr := [1, 2, 3, 4]
    arr[arr_slot()] += 10
    arr[arr_slot()] *= 2
    println arr[2]
    println arr_calls
end
