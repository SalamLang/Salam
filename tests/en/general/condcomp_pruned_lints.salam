func off_only():
    println "off"
end

func pick(flag: bool): int:
    if !FEATURE_ON:
        if flag:
            ret 1
        end
    end
    ret 0
end

func main:
    mut counter := 0
    spare := 41
    mut nums := Vector {} as Vector<int>
    defer nums.free()
    if !FEATURE_ON:
        counter = spare + 1
        off_only()
        nums.push(counter)
    end
    println counter
    println pick(true)
    println nums.len()
end
