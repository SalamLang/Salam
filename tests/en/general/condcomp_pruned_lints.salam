// Pruning runs before sema, so everything mentioned only inside the branch
// condcomp drops has no reference left by the time the unused/never-mutated
// lints run. Each name below is live on the host where `!FEATURE_ON` is the
// arm that survives, and used to be a hard error (E059/E062/E066/E069) here.
// DEFINE: FEATURE_ON

// Called only from the dropped branch of main - E066 without the bookkeeping.
func off_only():
    println "off"
end

// `flag` is read only inside the arm that goes away - E062.
func pick(flag: bool): int:
    if !FEATURE_ON:
        if flag:
            ret 1
        end
    end
    ret 0
end

func main:
    // Assigned only in the dropped arm - E069.
    mut counter := 0
    // The only read of it is in the dropped arm - E059.
    spare := 41
    // push() in the dropped arm is a mutation through a method call; the
    // defer below already counts as one, so this only covers the receiver.
    mut nums := Vector {} as Vector<int>
    defer nums.free()
    if !FEATURE_ON:
        counter = spare + 1
        off_only()
        nums.push(counter)
    end
    println counter
    println pick(true)
    println nums.len()
end
