// CONST: AGE=22
// CONST: LABEL=salam
// CONST: RATIO=1.5
// CONST: ENABLED=true
// CONST: OFFSET=-7
// CONST: TAG="0.3"
// CONST: BARE
// CONST: SHADOWED=from_the_command_line
const SHADOWED := "from source"

func main:
    println AGE + 1
    println LABEL
    println RATIO * 2.0
    println ENABLED
    println OFFSET
    println TAG
    println BARE
    println SHADOWED
    println SALAM_VERSION == ""
end
