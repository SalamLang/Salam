 */

// CONST: AGE=22
// CONST: LABEL=salam
// CONST: RATIO=1.5
// CONST: ENABLED=true
// CONST: OFFSET=-7
// CONST: TAG="0.3"
// CONST: BARE
// CONST: SHADOWED=from_the_command_line
//
// -dNAME=VALUE constants read exactly like a top-level `const NAME := VALUE`,
// with the value's shape deciding the type. TAG is quoted, so it stays the
// string "0.3" instead of becoming the float 0.3.
const SHADOWED := "from source"

func main:
    println AGE + 1
    println LABEL
    println RATIO * 2.0
    println ENABLED
    println OFFSET
    println TAG
    println BARE
    // A constant declared in the source wins over one defined on the command
    // line: -d is only consulted for a name nothing else defines.
    println SHADOWED
    // No flag needed for the toolchain's own build info.
    println SALAM_VERSION == ""
end
