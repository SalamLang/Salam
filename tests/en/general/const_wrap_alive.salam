// A u8 sum that wraps at run time: 200 + 100 is 44 in u8, not the 300
// an i64 fold would produce. The dead-loop check must decline to fold it
// rather than call the loop dead, so this program still runs its body.
const WIDE := 200 as u8
const OTHER := 100 as u8

func main:
    mut hits := 0
    until hits < 1 && WIDE + OTHER == 44 as u8:
        hits += 1
    end
    println hits
end
