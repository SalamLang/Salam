func main:
    a := (2 + 3) * 4 - 6 / 2
    b := 1.5 * 2.0 + 0.25
    s := "con" + "cat"
    t := 7 > 2
    u := -5 * 3
    mut down := 0
    repeat 10 to 1 with i:
        down += i
    end
    println a
    println b
    println s
    println t
    println u
    println down
end
