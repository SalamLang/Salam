import crypto

func main:
    println crypto.Sha1Hex("")
    println crypto.Sha1Hex("abc")
    println crypto.Sha1Hex("The quick brown fox jumps over the lazy dog")
    println crypto.Sha1Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    println crypto.Sha1Base64("abc")
end
