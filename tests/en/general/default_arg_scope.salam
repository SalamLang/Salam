include dscope "_default_scope_pkg.salam"

func main:
    LIMIT := 99
    b := dscope.Box { v = 1 }
    f := (): ret dscope.Limit() end
    println dscope.Limit(), dscope.Limit(3), b.Add(), b.Add(2), f(), LIMIT
end
