// The shapes definite-assignment analysis must keep accepting: a declaration
// with no initializer is fine as long as every path to a read assigns first.

func fill(out &: int):
    out = 42
end

func both_branches(c: bool): int:
    mut x: int
    if c:
        x = 1
    else:
        x = 2
    end
    ret x
end

func after_early_ret(c: bool): int:
    mut x: int
    if !c:
        ret 0
    end
    x = 7
    ret x
end

func scratch_array(): int:
    mut m: int[16]
    repeat 16 with t:
        m[t] = t * 2
    end
    mut s := 0
    repeat 16 with t:
        s = s + m[t]
    end
    ret s
end

func through_ref(): int:
    mut v: int
    fill(v)
    ret v
end

func main:
    println both_branches(true)
    println both_branches(false)
    println after_early_ret(true)
    println scratch_array()
    println through_ref()
    ret 0
end
