import encoding.json

enum Stage:
    waiting_room, under_review, shipped_out
end

enum Parcel:
    Small_Box,
    Big_Crate(weight: int)
end

struct Spot:
    pub grid_row: int = 0
    pub grid_col: int = 0
end

struct Order:
    pub pet_name: str = ""
    pub line_count: int = 0
    pub current_stage: Stage = Stage.under_review
    pub tag_list: Vector<str> = Vector {} as Vector<str>
end

func decodes<T>(text: str, out &: T): bool:
    try:
        json.Unmarshal(text, out)
    catch:
        ret false
    end
    ret true
end

func main:
    mut a := Order { pet_name = "x", line_count = 3 }
    a.tag_list.Push("t")
    b := a.Copy()
    c := a.DeepCopy()
    println a
    println Spot { grid_row = 1 } == Spot { grid_row = 1 }, Spot { grid_col = 2 } == Spot {}, b.line_count, c.tag_list.Len()
    text := json.Marshal(a)
    println text
    mut back := Order {}
    println decodes(text, back), back.pet_name, back.current_stage == Stage.under_review
    println json.Schema(Order {})
    p := Parcel.Big_Crate(10)
    println p, p == Parcel.Big_Crate(10), p.Copy()
    println json.Marshal(p), json.Marshal(Parcel.Small_Box)
end
