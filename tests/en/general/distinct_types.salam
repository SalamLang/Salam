 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

type Meters: int
    func + (other: Meters): Meters:
        ret ((this as int) + (other as int) + 1000) as Meters
    end
    func *(k: int): Meters:
        ret ((this as int) * k) as Meters
    end
    func *(o: Meters): int:
        ret (this as int) * (o as int)
    end
    func -: Meters:
        ret (0 - (this as int)) as Meters
    end
    func == (other: Meters): bool:
        ret (this as int) == (other as int)
    end
    func km: f64:
        ret (this as f64) / 1000.0
    end
end

type Money: f64
    func + (o: Money): Money:
        ret ((this as f64) + (o as f64)) as Money
    end
end

type Length = Meters

type Flag: bool
    func not: Flag:
        ret (this as bool) as Flag
    end
end

func main:
    a := 5 as Meters
    b := 7 as Meters
    println (a + b) as int
    println (a + 3) as int
    println (3 + a) as int
    println (a * 4) as int
    println a * b
    println (-a) as int
    println a == b
    println a != b
    println a < b
    println (b - a) as int
    println (a * 400).km()
    l := 2 as Length
    println (l + a) as int
    m := 1.5 as Money
    println (m + m) as f64
    println a
    mut c := 5 as Meters
    c += b
    println c
    c -= b
    println c
    f := true as Flag
    println (not f) as bool
end
