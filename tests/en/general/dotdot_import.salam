// Regression: one module imported via two path spellings (plain from the
// root, "../"-qualified from a subdirectory) must dedup to ONE module.
// Before path_normalize collapsed "seg/../" this failed to link
// ('LIM defined twice').
package main

import lib "_ddlib.salam"
import sub "_ddsub/ddsub.salam"

func main:
    println lib.Tag(7)
    println sub.Deep(7)
end
