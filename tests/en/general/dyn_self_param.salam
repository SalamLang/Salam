interface Maker:
    func value(): int
    func combine(o: dyn Maker): int
    func clone(): dyn Maker
end

struct M:
    pub v: int = 1
    pub func value(): int: ret this.v end
    pub func combine(o: dyn Maker): int: ret this.v + o.value() end
    pub func clone(): dyn Maker: ret M { v = this.v * 10 } as dyn Maker end
end

func main:
    a := M { v = 5 } as dyn Maker
    b := M { v = 2 } as dyn Maker
    println a.combine(b), a.clone().value(), b.clone().combine(a)
end
