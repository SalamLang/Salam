import collections
import sort

func main:
    mut s := collections.Set {} as collections.Set<int>
    s.add(3)
    s.add(1)
    s.add(2)
    mut members := Vector {} as Vector<int>
    each x in s:
        members.push(x)
    end
    sort.Sort(members)
    each x in members:
        println "set", x
    end

    mut st := collections.Stack {} as collections.Stack<int>
    st.push(1)
    st.push(2)
    each x in st:
        println "stack", x
    end

    mut q := collections.Queue {} as collections.Queue<int>
    q.enqueue(10)
    q.enqueue(20)
    q.enqueue(30)
    println "drop", q.dequeue()
    each x in q:
        println "queue", x
    end

    mut d := collections.Deque {} as collections.Deque<int>
    d.push_back(1)
    d.push_front(0)
    each x in d:
        println "deque", x
    end

    mut l := collections.LinkedList {} as collections.LinkedList<int>
    l.push_back(7)
    l.push_back(8)
    each x in l:
        println "list", x
    end

    mut o := collections.OrderedMap {}
    o.set("b", "2")
    o.set("a", "1")
    each k, v in o:
        println "omap", k, v
    end

    mut c := collections.Counter {} as collections.Counter<str>
    c.add("x")
    c.add("x")
    each k, n in c:
        println "count", k, n
    end
end
