func main:
    mut users := HashMap {} as HashMap<str, int> users.Put("a", 10)
    users.Put("b", 20)
    users.Put("c", 30)
    mut total := 0
    mut count := 0
    each key, value in users:
        if key != "":
            total += value
            count++
        end
    end
    println count, total
end
