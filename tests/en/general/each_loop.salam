func main:
    names := ["ali", "reza", "hasan"]
    each name in names:
        if name != "reza":
            println name
        end
    end
    each i, n in names:
        println i, n
    end
    mut v := Vector {} as Vector<int> v.Push(10)
    v.Push(20)
    v.Push(30)
    mut sum := 0
    each x in v:
        sum += x
    end
    println sum
    each i, x in v:
        if x > 10:
            println i, x
        end
    end
    each n in [5, 6]:
        print n
    end
    println ""
end
