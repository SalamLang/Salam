func main:
    names := ["ali", "reza", "hasan"]
    each i, n in names:
        println i, n
    end
    mut v := Vector {} as Vector<int>
    v.push(10)
    v.push(20)
    each i, x in v:
        println i, x
    end
    mut users := HashMap {} as HashMap<str, int>
    users.put("a", 10)
    mut total := 0
    each key, value in users:
        if key != "":
            total = total + value
        end
    end
    println total
    each n in [5, 6]:
        print n
    end
    println ""
end
