struct Note:
    pub title: str = ""
end

func words(s: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut cur := ""
    each ch in s:
        if ch == " ":
            if cur.len() > 0:
                out.push(cur)
                cur = ""
            end
            continue
        end
        cur = cur + ch
    end
    if cur.len() > 0:
        out.push(cur)
    end
    ret out
end

func digits_only(s: str): str:
    all := "0123456789۰۱۲۳۴۵۶۷۸۹"
    mut out := ""
    each ch in s:
        if all.includes(ch):
            out = out + ch
        end
    end
    ret out
end

func first_non_ascii(s: str): int:
    each i, ch in s:
        if ch.len() > 1:
            ret i
        end
    end
    ret -1
end

func title_case(s: str): str:
    mut out := ""
    mut start := true
    each ch in s:
        if start:
            out = out + ch.upper()
        else:
            out = out + ch
        end
        start = ch == " "
    end
    ret out
end

func main:
    ws := words("  Salam   سلام دنیا  hello ")
    println ws.len()
    each w in ws:
        print "[" + w + "]"
    end
    println ""
    mut letters := 0
    each w in ws:
        each _ in w:
            letters += 1
        end
    end
    println "letters:", letters
    println "digits:", digits_only("tel: 021-۸۸۷۷ ext 42")
    println "first non-ASCII:", first_non_ascii("Hello سلام"), first_non_ascii("plain")
    println title_case("salam to you")
    mut s := "abc"
    mut turns := 0
    each ch in s:
        s = s + ch
        turns += 1
    end
    println "snapshot:", s, turns
    note := Note { title = "یادداشت" }
    mut n := 0
    each _ in note.title:
        n += 1
    end
    println "field:", n
    mut m := HashMap {} as HashMap<str, str>
    m.put("fa", "سلام")
    mut total := 0
    each _, v in m:
        each _ in v:
            total += 1
        end
    end
    println "map values:", total
    mut kept := ""
    each i, ch in "a1b2c3":
        if i % 2 == 1:
            continue
        end
        if i > 3:
            break
        end
        kept = kept + ch
    end
    println "kept:", kept
end
