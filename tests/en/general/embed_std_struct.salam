package main

import tui

struct Label:
    pub use tui.BaseWidget
    pub text: str = ""

    pub func Render(buf: tui.Buffer, bounds: tui.Rect):
        buf.PutStr(bounds.x + 1, bounds.y, this.text, tui.StyleDefault)
    end
end

func main:
    mut screen := tui.NewScreen(Label { text = "salam" }, 8, 1)
    defer screen.Close()
    screen.Draw()
    println "[" + screen.buffer.RowText(0) + "]"
    mut l := Label {}
    l.SetBounds(tui.Rect { width = 5, height = 2 })
    println l.Bounds().width, l.Bounds().height, l.Focusable(), l.Visible()
end
