package main

import tui

struct Label:
    pub use tui.BaseWidget
    pub text: str = ""

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        buf.put_str(bounds.x + 1, bounds.y, this.text, tui.StyleDefault)
    end
end

func main:
    mut screen := tui.NewScreen(Label { text = "salam" }, 8, 1)
    defer screen.close()
    screen.draw()
    println "[" + screen.buffer.row_text(0) + "]"
    mut l := Label {}
    l.set_bounds(tui.Rect { width = 5, height = 2 })
    println l.bounds().width, l.bounds().height, l.focusable(), l.visible()
end
