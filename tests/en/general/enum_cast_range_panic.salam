enum Day: Mon, Tue end
enum Code: Ok = 200, Moved = 301, Missing = 404 end

func name(d: Day): str:
    ret match d:
        Day.Mon: "mon" end
        Day.Tue: "tue" end
    end
end

func main:
    n := "1".ToInt()
    println name(n as Day)
    println (n + 300) as Code == Code.Moved
    println (n + 403) as Code == Code.Missing
    println "before"
    println name((n + 104) as Day)
    println "unreachable"
end
