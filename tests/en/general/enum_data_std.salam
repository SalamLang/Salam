package main

import tui

func main:
    red := tui.Color.Rgb(255, 0, 0)
    println tui.Lower(red, tui.ColorTier.Ansi16) == tui.BrightRed
    println tui.Color.Default == tui.Color.Default
    mut dialog := tui.NewModal()
    dialog.set_size(tui.ModalSize.Fixed(10, 3))
    dialog.set_size(tui.ModalSize.Percent(50, 40))
    println "ok"
end
