enum Weight:
    Light = 1.1
    Medium = 2.2
    Heavy = 3.3
end

func main:
    println Weight.Light as f64
    println Weight.Medium as f64
    println Weight.Light == Weight.Light
    println Weight.Light == Weight.Medium
    println Weight.Heavy.name()
    println Weight.Count()
end
