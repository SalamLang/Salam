enum Color:
    Red
    Green = 5
    Blue
end

func main:
    println Color.Green.name()
    println Color.Red.name()

    mut ok := false
    r := Color.FromString("Green", ok)
    println ok
    println r as int

    mut ok2 := true
    _r2 := Color.FromString("Bogus", ok2)
    println ok2

    println Color.Count()

    names := Color.Names()
    println names.len()
    println names.get(0)
    println names.get(1)
    println names.get(2)
end
