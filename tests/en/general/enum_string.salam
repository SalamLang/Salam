enum Color:
    Red = "is_red"
    Green = "is_green"
    Blue = "is_blue"
end

func main:
    println Color.Red as str
    println Color.Green as str
    println Color.Red == Color.Red
    println Color.Red == Color.Green
    println Color.Red.name()
    println Color.Blue.name()

    mut ok := false
    hit := Color.FromString("Green", ok)
    println ok
    println hit.name()

    mut ok2 := true
    _miss := Color.FromString("Nope", ok2)
    println ok2

    println Color.Count()
end
