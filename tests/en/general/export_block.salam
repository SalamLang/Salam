extern:
    func abs(x: int): int
end

export:
    func demo_twice(x: int): int:
        ret x * 2
    end
    pure func demo_square(x: int): int:
        ret x * x
    end
    deprecated func demo_old(): int:
        ret 1
    end
end

func main:
    println demo_twice(21)
    println demo_square(abs(0 - 7))
    fp := (&demo_twice) as extern func (int) int
    println fp(5)
end
