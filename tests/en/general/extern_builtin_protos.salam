extern:
    func abs(x: i64): i64
    func labs(x: i64): i64
    func llabs(x: i64): i64
    func strdup(s: str): str
    func strndup(s: str, n: i32): str
    func atoi(s: str): i32
    func strchr(s: str, c: i32): str
end

func main:
    println abs(-3), labs(-4), llabs(-5)
    println strdup("copy"), strndup("truncate", 5), atoi("42")
    println strchr("hello", 108)
end
