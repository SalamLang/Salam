struct Pair:
    pub a: i32 = 0 as i32
    pub b: i32 = 0 as i32
end

struct Rect:
    pub a: i32 = 0 as i32
    pub b: i32 = 0 as i32
    pub c: i32 = 0 as i32
    pub d: i32 = 0 as i32
end

struct Tiny3:
    pub a: i8 = 0 as i8
    pub b: i8 = 0 as i8
    pub c: i8 = 0 as i8
end

struct Flt2:
    pub a: f32 = 0 as f32
    pub b: f32 = 0 as f32
end

struct Flt3:
    pub a: f32 = 0 as f32
    pub b: f32 = 0 as f32
    pub c: f32 = 0 as f32
end

struct Dbl2:
    pub a: f64 = 0 as f64
    pub b: f64 = 0 as f64
end

struct Dbl4:
    pub a: f64 = 0 as f64
    pub b: f64 = 0 as f64
    pub c: f64 = 0 as f64
    pub d: f64 = 0 as f64
end

struct FltInt:
    pub a: f32 = 0 as f32
    pub b: i32 = 0 as i32
end

struct DblInt:
    pub a: f64 = 0 as f64
    pub b: i32 = 0 as i32
end

struct IntDbl:
    pub a: i32 = 0 as i32
    pub b: f64 = 0 as f64
end

struct Big3:
    pub a: i64 = 0 as i64
    pub b: i64 = 0 as i64
    pub c: i64 = 0 as i64
end

export:
    func ex_Pair(a: Pair, k: i32): Pair:
        mut r := Pair {}
        r.a = ((a.a as i64) + (k as i64)) as i32
        r.b = ((a.b as i64) + (k as i64)) as i32
        ret r
    end

    func ex_Pair_many(g0: i64, g1: i64, g2: i64, g3: i64, g4: i64, a: Pair, f0: f64, f1: f64, f2: f64, f3: f64, f4: f64, f5: f64, f6: f64, b: Pair, k: i32): Pair:
        mut r := Pair {}
        r.a = ((a.a as i64) + (b.a as i64) + (k as i64) + g0 + g1 + g2 + g3 + g4 + (f0 as i64) + (f1 as i64) + (f2 as i64) + (f3 as i64) + (f4 as i64) + (f5 as i64) + (f6 as i64)) as i32
        r.b = ((a.b as i64) + (b.b as i64) + (k as i64) + g0 + g1 + g2 + g3 + g4 + (f0 as i64) + (f1 as i64) + (f2 as i64) + (f3 as i64) + (f4 as i64) + (f5 as i64) + (f6 as i64)) as i32
        ret r
    end

