        r.a = (a.a + b.a + (k as i64) + g0 + g1 + g2 + g3 + g4 + (f0 as i64) + (f1 as i64) + (f2 as i64) + (f3 as i64) + (f4 as i64) + (f5 as i64) + (f6 as i64))
        r.b = (a.b + b.b + (k as i64) + g0 + g1 + g2 + g3 + g4 + (f0 as i64) + (f1 as i64) + (f2 as i64) + (f3 as i64) + (f4 as i64) + (f5 as i64) + (f6 as i64))
