        r.b = ((a.b as i64) + (b.b as i64) + (k as i64) + g0 + g1 + g2 + g3 + g4 + (f0 as i64) + (f1 as i64) + (f2 as i64) + (f3 as i64) + (f4 as i64) + (f5 as i64) + (f6 as i64)) as i32
        r.c = ((a.c as i64) + (b.c as i64) + (k as i64) + g0 + g1 + g2 + g3 + g4 + (f0 as i64) + (f1 as i64) + (f2 as i64) + (f3 as i64) + (f4 as i64) + (f5 as i64) + (f6 as i64)) as i32
        r.d = ((a.d as i64) + (b.d as i64) + (k as i64) + g0 + g1 + g2 + g3 + g4 + (f0 as i64) + (f1 as i64) + (f2 as i64) + (f3 as i64) + (f4 as i64) + (f5 as i64) + (f6 as i64)) as i32
