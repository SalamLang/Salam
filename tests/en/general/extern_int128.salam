link static "extern_int128"

extern:
    func w_add(a: i128, b: i128): i128
    func w_mul(a: u64, b: u64): u128
    func w_high(v: u128): i64
    func w_tail(a: i64, b: i64, c: i64, d: i64, e: i64, f: i128, g: i64): i64
    func w_mix(x: f64, v: i128, y: f64): f64
    func w_odd(a: i64, v: i128): i64
end

func main:
    println w_add(1 as i128 << 100, -1)
    println w_mul(4294967296 as u64, 4294967296 as u64)
    println w_high((7 as u128 << 64) | 3)
    println w_tail(1, 2, 3, 4, 5, 6 as i128 << 64, 7)
    println w_mix(1.5, 40, 0.5)
    println w_odd(5, 3 as i128 << 64)
end
