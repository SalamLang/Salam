extern:
    func fdopen(fd: int, mode: str): void*
    func fwrite(ptr: str, size: int, nmemb: int, stream: void*): u64
    func write(fd: int, buf: str, n: int): i64
    func puts(s: str): int
end

func main:
    f := fdopen(1, "w")
    println "one"
    _a := fwrite("two\n", 1, 4, f)
    _b := write(1, "three\n", 6)
    _c := puts("four")
    println "five"
    _d := fwrite("six\n", 1, 4, f)
    _e := write(1, "seven\n", 6)
end
