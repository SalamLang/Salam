link static "extern_struct_abi"

extern:
    func mix_make(d: f64, i: i32): Mix
    func flt3_scale(f: Flt3, k: f32): Flt3
    func dbl2_swap(d: Dbl2): Dbl2
    func tiny_neg(t: Tiny): Tiny
    func f1_twice(x: F1): F1
    func big_sum(a: Big, b: Big): Big
    func wide_make(a: i64, b: i32): Wide
    func fi_mix(a: FI, m: Mix, b: FI): FI
    func quad_rev(q: Quad): Quad
    func many_fp(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: Dbl2, i: FI, j: f64): f64
end

struct Mix:
    pub d: f64 = 0.0
    pub i: i32 = 0
end

struct Flt3:
    pub x: f32 = 0.0 as f32
    pub y: f32 = 0.0 as f32
    pub z: f32 = 0.0 as f32
end

struct Dbl2:
    pub x: f64 = 0.0
    pub y: f64 = 0.0
end

struct Tiny:
    pub c: i8 = 0 as i8
end

struct F1:
    pub x: f32 = 0.0 as f32
end

struct Big:
    pub a: i64 = 0 as i64
    pub b: i64 = 0 as i64
    pub c: i64 = 0 as i64
end

struct Wide:
    pub a: i64 = 0 as i64
    pub b: i32 = 0
end

struct FI:
    pub f: f32 = 0.0 as f32
    pub i: i32 = 0
end

struct Quad:
    pub a: f64 = 0.0
    pub b: f64 = 0.0
    pub c: f64 = 0.0
    pub d: f64 = 0.0
end

func main:
    m := mix_make(1.25, 41)
    println m.d, m.i
    f := flt3_scale(Flt3 { x = 1.5 as f32, y = (0.0 - 2.0) as f32, z = 0.25 as f32 }, 4.0 as f32)
    println f.x, f.y, f.z
    d := dbl2_swap(Dbl2 { x = 3.5, y = 0 - 7.25 })
    println d.x, d.y
    t := tiny_neg(Tiny { c = 42 as i8 })
    println t.c
    e := f1_twice(F1 { x = (0.0 - 1.75) as f32 })
    println e.x
    b := big_sum(Big { a = 5000000000 as i64, b = 2 as i64, c = 0 - 3 }, Big { a = 1 as i64, b = 0 - 7000000000, c = 9 as i64 })
    println b.a, b.b, b.c
    w := wide_make(0 - 3000000000, 77)
    println w.a, w.b
    r := fi_mix(FI { f = 0.5 as f32, i = 3 }, Mix { d = 2.0, i = 100 }, FI { f = 1.25 as f32, i = 20 })
    println r.f, r.i
    q := quad_rev(Quad { a = 1.0, b = 2.5, c = 0 - 3.0, d = 4.75 })
    println q.a, q.b, q.c, q.d
    println many_fp(0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, Dbl2 { x = 1.0, y = 2.0 }, FI { f = 0.5 as f32, i = 3 }, 0.25)
end
