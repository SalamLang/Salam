extern:
    func div(a: i32, b: i32): DivT
    func lldiv(a: i64, b: i64): LLDivT
end

struct DivT:
    pub quot: i32 = 0
    pub rem: i32 = 0
end

struct LLDivT:
    pub quot: i64 = 0
    pub rem: i64 = 0
end

struct Pair:
    pub small: DivT
    pub wide: LLDivT
    pub tag: i32 = 0
end

func halve(n: i32): DivT:
    ret div(n, 2)
end

func split_wide(n: i64, d: i64): LLDivT:
    ret lldiv(n, d)
end

func main:
    d := div(17, 5)
    println d.quot, d.rem
    n := div(0 - 17, 5)
    println n.quot, n.rem
    h := halve(9)
    println h.quot, h.rem
    q := lldiv(10000000000007, 1000)
    println q.quot, q.rem
    w := split_wide(0 - 9000000000000000001, 1000000007)
    println w.quot, w.rem
    mut p := Pair { small = DivT {}, wide = LLDivT {}, tag = 7 }
    p.small = div(100, 7)
    p.wide = lldiv(5000000000, 3)
    println p.small.quot, p.small.rem, p.wide.quot, p.wide.rem, p.tag
    mut total := 0 as i64
    repeat 5 in k:
        r := lldiv((k as i64) * 1000003, 7)
        total += r.quot * 10 + r.rem
    end
    println total
end
