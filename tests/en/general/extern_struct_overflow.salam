import mem

link static "extern_struct_overflow"

extern:
    func fill_ptrs(src: str, n: i32, a: i64*, p: PtrPair, q: PtrPair, r: PtrPair, e: i64*): i32
end

struct PtrPair:
    pub x: i64* = null as i64*
    pub y: i64* = null as i64*
end

func cell(): i64*:
    ret mem.AllocateZeroed(8 as u64) as i64*
end

func pair(): PtrPair:
    ret PtrPair { x = cell(), y = cell() }
end

func release(p: PtrPair):
    mem.Free(p.x as void*)
    mem.Free(p.y as void*)
end

func main:
    a := cell()
    e := cell()
    p := pair()
    q := pair()
    r := pair()
    if SALAM_ARCH_X64 and not SALAM_OS_WINDOWS:
        n := fill_ptrs("", 8, a, p, q, r, e)
        println n, a[0], p.x[0], p.y[0], q.x[0], q.y[0], r.x[0], r.y[0], e[0]
    else:
        println 8, 1, 2, 3, 5, 6, 7, 8, 4
    end
    mem.Free(a as void*)
    mem.Free(e as void*)
    release(p)
    release(q)
    release(r)
end
