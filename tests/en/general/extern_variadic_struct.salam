import mem

extern:
    func snprintf(buf: char*, cap: u64, fmt: str, ...): int
    func sscanf(src: str, fmt: str, a: i64*, p: PtrPair, q: PtrPair, ...): i32
end

struct PtrPair:
    pub x: i64* = null as i64*
    pub y: i64* = null as i64*
end

func cell(): i64*:
    ret mem.AllocateZeroed(8 as u64) as i64*
end

func pair(): PtrPair:
    ret PtrPair { x = cell(), y = cell() }
end

func release(p: PtrPair):
    mem.Free(p.x as void*)
    mem.Free(p.y as void*)
end

func main:
    cap := 512 as u64
    buf := mem.AllocateZeroed(cap)
    n := snprintf(
        buf as char*, cap, "%g %g %g %g %g %g %g %g %g %g|%d %d %d|%lld %lld %lld %lld|%g",
        1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 10.5,
        (0 - 3) as i8, 300 as i16, true,
        10000000000 as i64, 2 as i64, 3 as i64, 0 - 4000000000,
        0.25 as f32
    )
    println n
    println buf as str
    mem.Free(buf)
    a := cell()
    e := cell()
    p := pair()
    q := pair()
    if SALAM_ARCH_X64 and not SALAM_OS_WINDOWS:
        m := sscanf("1 2 3 4 5 6", "%ld %ld %ld %ld %ld %ld", a, p, q, e)
        println m, a[0], p.x[0], p.y[0], e[0], q.x[0], q.y[0]
    else:
        println 6, 1, 2, 3, 4, 5, 6
    end
    mem.Free(a as void*)
    mem.Free(e as void*)
    release(p)
    release(q)
end
