import mem

link static "extern_variadic_va_struct"

extern:
    func va_trace(out: char*, fmt: str, ...): i32
    func va_tagged(out: char*, tag: Pair, fmt: str, ...): i32
    func va_summix(n: i32, ...): Mix
    func fixed_after_ints(out: char*, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, v: Dbl2, w: F1): i32
end

struct Pair:
    pub a: i32 = 0
    pub b: i32 = 0
end

struct Mix:
    pub d: f64 = 0.0
    pub i: i32 = 0
end

struct Dbl2:
    pub x: f64 = 0.0
    pub y: f64 = 0.0
end

struct Flt3:
    pub x: f32 = 0.0 as f32
    pub y: f32 = 0.0 as f32
    pub z: f32 = 0.0 as f32
end

struct Big:
    pub a: i64 = 0 as i64
    pub b: i64 = 0 as i64
    pub c: i64 = 0 as i64
end

struct Tiny:
    pub c: i8 = 0 as i8
end

struct Odd:
    pub s: i16 = 0 as i16
    pub c: i8 = 0 as i8
end

struct Three:
    pub a: i8 = 0 as i8
    pub b: i8 = 0 as i8
    pub c: i8 = 0 as i8
end

struct Wide:
    pub a: i64 = 0 as i64
    pub b: i32 = 0
end

struct Quad:
    pub a: f64 = 0.0
    pub b: f64 = 0.0
    pub c: f64 = 0.0
    pub d: f64 = 0.0
end

struct F1:
    pub x: f32 = 0.0 as f32
end

func main:
    buf := mem.AllocateZeroed(4096 as u64)
    out := buf as char*
    p := Pair { a = 7, b = 0 - 9 }
    m := Mix { d = 2.5, i = 0 - 31 }
    d := Dbl2 { x = 0.25, y = 0 - 1.75 }
    f := Flt3 { x = 1.5 as f32, y = (0.0 - 2.25) as f32, z = 3.75 as f32 }
    big := Big { a = 5000000000 as i64, b = 0 - 6000000000, c = 42 as i64 }
    t := Tiny { c = (0 - 5) as i8 }
    o := Odd { s = (0 - 1234) as i16, c = 77 as i8 }
    h := Three { a = 1 as i8, b = (0 - 2) as i8, c = 3 as i8 }
    w := Wide { a = 0 - 7000000000, b = 123456 }
    q := Quad { a = 1.25, b = 2.5, c = 0 - 3.75, d = 4.0 }
    e := F1 { x = (0.0 - 8.5) as f32 }

    _n1 := va_trace(out, "pmd", p, m, d)
    println buf as str
    _n2 := va_trace(out, "ftohe", f, t, o, h, e)
    println buf as str
    _n3 := va_trace(out, "bqw", big, q, w)
    println buf as str
    _n4 := va_trace(out, "iiiwpil", 1, 2, 3, w, p, 4, 9000000000 as i64)
    println buf as str
    _n5 := va_trace(out, "gggggggdgm", 0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, d, 7.5, m)
    println buf as str
    _n6 := va_trace(out, "ggggggqgdi", 0.5, 1.5, 2.5, 3.5, 4.5, 5.5, q, 6.5, d, 8)
    println buf as str
    _n7 := va_trace(out, "iiiiipwbi", 1, 2, 3, 4, 5, p, w, big, 6)
    println buf as str
    _n8 := va_trace(out, "imgiflt", 1, m, 0.75, 2, f, 0 - 3000000000, t)
    println buf as str
    _n9 := va_tagged(out, Pair { a = 100, b = 200 }, "pdie", p, d, 5, e)
    println buf as str
    s := va_summix(3, m, Mix { d = 1.25, i = 10 }, Mix { d = 0 - 0.5, i = 5 })
    println s.d, s.i
    _n10 := va_trace(
        out, "pmdftohebqwiglpmdftohebqwigl", p, m, d, f, t, o, h, e, big, q, w, 11, 0.25, 12 as i64,
        p, m, d, f, t, o, h, e, big, q, w, 13, 0.75, 14 as i64
    )
    println buf as str
    _n11 := fixed_after_ints(out, 1 as i64, 2 as i64, 3 as i64, 4 as i64, 5 as i64, 6 as i64, 7 as i64, 8 as i64, d, e)
    println buf as str
    mem.Free(buf)
end
