include g "_falib_en.salam"

func helper(p: g.Point): int:
    ret p.y
end

func main():
    println g.Twice(21)
    println g.Limit
    n := g.Make(2, 3)
    println n.Sum()
    println n.x
    m := g.Point { x = 4, y = 5 }
    println m.Sum()
    s := g.Shade.Light
    println s == g.Shade.Light
    println s != g.Shade.Dark
    println helper(m)
end
