extern:
    func printf(format: str, ...): int
    func strlen(s: str): u64
    func malloc(size: u64): void*
    func free(ptr: void*)
end

func main:
    printf("sum=%d\n", 20 + 22)
    s := "salam"
    // The cast is load-bearing, not decoration. Codegen emits no prototype
    // for a libc function <string.h> already declares, so the generated C
    // calls the REAL strlen and hands printf a size_t - which `%d` does not
    // match. Distro gcc (Debian/Ubuntu) turns -Wformat on by default, and
    // the test suite builds with SALAM_C_STRICT=1 (-Werror), so the
    // uncast form fails to compile there.
    //
    // `as int` and not a wider format specifier: `%lu` would only be right
    // where size_t is unsigned long, and this suite also runs on 32-bit
    // hosts and on Windows, where it is not.
    printf("len=%d\n", strlen(s) as int)
    p := malloc(32 as u64)
    if p == null:
        printf("alloc=fail\n")
    else:
        printf("alloc=ok\n")
        free(p)
    end
end
