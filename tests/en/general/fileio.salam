import os

extern:
    func salam_open(path: str, mode: str): File*
    func exit(code: int)
end

func main:
    os.MkdirAll("tests/.work")
    path := "tests/.work/_fileio_test.txt"
    mut w := salam_open(path, "w")
    if w == null:
        println "open failed"
        exit(1)
    end
    w.Write("alpha\n")
    w.Write("beta\n")
    w.Write("gamma\n")
    w.Close()
    mut r := salam_open(path, "r")
    mut lines := Vector {} as Vector<str> defer lines.Free()
    mut line := r.Readline()
    until line.Len() > 0:
        lines.Push(line)
        line = r.Readline()
    end
    r.Close()
    println lines.Len()
    repeat lines.Len() in i:
        println lines.Get(i)
    end
end
