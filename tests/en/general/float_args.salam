// Regression test: floating-point arguments that are *computed expressions*
// and sit next to another floating-point argument.
//
// tcc 0.9.27 (x86-64) - the current tinycc release, and the build bundled
// with the Windows dist - miscompiles a prototyped call of that shape: the
// earlier float argument is overwritten with the later one's value, so
// `(a + 1.0) ** b` came out as `b ** b` and `dist(a + 1.0, b)` lost its
// first argument entirely. Only the last float argument of a run is safe,
// which is why general/power.salam (`2.0 ** 10.0`, both operands literal)
// never caught it. codegen wraps the affected arguments in SALAM_FPARG_D -
// see cg_needs_fparg.
//
// Every value below is chosen so the digits identify *which* argument
// arrived where, rather than just whether the result is plausible.
import math

func dist(x: f64, y: f64): f64:
    ret x * 1000.0 + y
end

func mid3(x: f64, y: f64, z: f64): f64:
    ret x * 10000.0 + y * 100.0 + z
end

func main:
    a := 3.0
    b := 2.0
    c := 5.0

    // `**` with a computed base next to the exponent.
    println (a + 1.0) ^^ b

    // Compound `**=`, whose lowering builds its own pow() call.
    mut p := 2.0
    p ^^= b + 1.0
    println p

    // A plain Salam function with two adjacent f64 params.
    println dist(a + 1.0, b)
    println dist(a, b)

    // Three adjacent f64 params: the middle one is a victim too, since it
    // is followed by another float.
    println mid3(a + 1.0, b - 1.0, c)

    // Same shape through the stdlib.
    println math.Pow(a + 1.0, b)
    ret 0
end
