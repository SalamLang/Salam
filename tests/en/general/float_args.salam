import math

func dist(x: f64, y: f64): f64:
    ret x * 1000.0 + y
end

func mid3(x: f64, y: f64, z: f64): f64:
    ret x * 10000.0 + y * 100.0 + z
end

func main:
    a := 3.0
    b := 2.0
    c := 5.0

    println (a + 1.0) ^^ b

    mut p := 2.0
    p ^^= b + 1.0
    println p

    println dist(a + 1.0, b)
    println dist(a, b)

    println mid3(a + 1.0, b - 1.0, c)

    println math.Pow(a + 1.0, b)
    ret 0
end
