mut calls := 0

struct Pair:
    pub a: f32
    pub b: f64
end

func next_value(): f64:
    calls++
    ret 2.75
end

func main:
    p := Pair { a = next_value() as f32, b = next_value() }
    q := next_value() as f32
    n := next_value() as i32
    println calls, p.a, p.b, q, n
end
