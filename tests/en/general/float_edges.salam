func keep<T>(x: T): T:
    ret x
end

func fma_like(a: f64, b: f64, c: f64): f64:
    ret a * b + c
end

func main:
    z := keep(0.0)
    println -z, -z, -0.0, keep(-0.0), 1.0 / -z
    println 5e-324, keep(5e-324), keep(-1e-320), keep(2.2250738585072014e-308)
    println keep(0.1) + keep(0.2), keep(0.1) + keep(0.2) == 0.3, keep(0.3) - keep(0.2)
    mut t := 0.0
    repeat 10:
        t += keep(0.1)
    end
    println t, keep(1e21), keep(123.456), keep(1.0) / keep(3.0)
    println fma_like(keep(0.1), keep(10.0), keep(-1.0))
end
