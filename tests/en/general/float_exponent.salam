import conv

// A float small or large enough to print in exponent form must print the
// same text everywhere. C99 asks for the fewest exponent digits with a
// minimum of two; the Windows CRT writes three, so 0.00001 came out
// "1e-005" there and "1e-05" on every other platform.
//
// Each value goes through all three renderings that exist: folded by the
// compiler (a literal), rendered at runtime (through a function, so the
// constant is out of reach), and conv.FormatFloat. They have to agree.
func through(x: f64): f64: ret x end

func main:
    println 0.00001
    println through(0.00001)
    println conv.FormatFloat(0.00001)
    println 1.0e-7
    println through(0.0 - 2.5e-11)
    println conv.FormatFloat(1.0e-7)
    println 1.0e100
    println through(1.0e300)
    println conv.FormatFloat(1.0e300)
    println 0.1
    println through(1234567.0)
end
