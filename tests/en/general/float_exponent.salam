import conv

func through(x: f64): f64: ret x end

func main:
    println 0.00001
    println through(0.00001)
    println conv.FormatFloat(0.00001)
    println 1.0e-7
    println through(0.0 - 2.5e-11)
    println conv.FormatFloat(1.0e-7)
    println 1.0e100
    println through(1.0e300)
    println conv.FormatFloat(1.0e300)
    println 0.1
    println through(1234567.0)
end
