// A folded constant that overflows to infinity, or is not a number, has
// no C spelling of its own (`inf` is not an identifier). The C backend
// emits it as the division that produces it.

func main:
    big := 1e308 * 10.0
    neg := -1e308 * 10.0
    z := 0.0
    nan := z / z
    println big > 1e308, neg < -1e308, nan != nan
end
