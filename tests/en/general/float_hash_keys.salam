func keep<T>(x: T): T:
    ret x
end

func main:
    z := keep(0.0)
    nan := z / z
    inf := keep(1.0) / z
    println hash(keep(0.0)) == hash(keep(-0.0)),
        hash(nan) == hash(-nan),
        hash(nan) == hash(inf - inf)
    println hash(keep(1e300)) == hash(keep(1e300)), hash(keep(1e300)) != hash(keep(-1e300))
    println hash(keep(0.5 as f32)) == hash(keep(0.5 as f32)),
        hash(keep(-0.0 as f32)) == hash(keep(0.0 as f32))
    mut m := HashMap {} as HashMap<f64, int>
    defer m.Free()
    m.Put(keep(1e300), 6)
    m.Put(keep(-1e300), 7)
    m.Put(keep(1e-300), 8)
    m.Put(keep(0.0), 9)
    m.Put(nan, 10)
    println m.Has(keep(1e300)), m.Get(keep(1e300)), m.Has(keep(-1e300)), m.Get(keep(-1e300))
    println m.Has(keep(1e-300)), m.Get(keep(1e-300)), m.Get(keep(-0.0)), m.Has(keep(-0.0))
    println m.Has(keep(1e299)), m.Has(keep(2.5))
    m.Put(keep(-0.0), 11)
    println m.Get(keep(0.0))
    println m.Remove(keep(1e300)), m.Remove(keep(-0.0)), m.Remove(keep(5.0))
    println m.Has(keep(1e300)), m.Has(keep(0.0)), m.Get(keep(-1e300)), m.Get(keep(1e-300))
    repeat 1 to 200 in i:
        m.Put((i as f64) * 1e250, i)
    end
    println m.Get(keep(1e250)), m.Get(keep(100.0) * 1e250), m.Get(keep(-1e300))
    mut im := HashMap {} as HashMap<f64, int>
    defer im.Free()
    im.Put(5, 1)
    n := keep(7)
    im.Put(n, 3)
    im.Put(keep(6.0), 2)
    println im.Get(keep(5.0)), im.Has(keep(5.0)), im.Get(keep(7.0)), im.Get(6), im.Has(6)
    mut fm := HashMap {} as HashMap<f32, str>
    defer fm.Free()
    fm.Put(keep(0.1 as f32), "a")
    fm.Put(keep(3.0e38) as f32, "b")
    println fm.Get(keep(0.1 as f32)), fm.Get(keep(3.0e38) as f32), fm.Has(keep(0.2 as f32))
end
