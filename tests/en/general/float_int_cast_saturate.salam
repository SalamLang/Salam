const BIG := 1e20 as i32
const NEG := -1e20 as i64

func opf(f: f64): f64:
    ret f
end

func show(name: str, f: f64):
    println name, f as i32, f as i64, f as u8, f as u32, f as u64, f as i8, f as i16, f as u16
end

func main:
    show("1e20", opf(1e20))
    show("-1e20", opf(-1e20))
    show("nan", opf(0.0) / opf(0.0))
    show("3.5e9", opf(3.5e9))
    show("-3.7", opf(-3.7))
    show("300.9", opf(300.9))
    h := opf(1e20) as f32
    println "f32", h as i32, h as u64
    println "lit", 1e20 as i32, 3.5e9 as i32, -1e20 as u32
    println "const", BIG, NEG
end
