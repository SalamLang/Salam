import conv
import conv.numfmt

func show(s: str):
    a := conv.FormatFloat(s.ToFloat())
    b := conv.FormatFloat(numfmt.ScanFloat(s))
    c := conv.FormatFloat(conv.ParseFloatOr(s, -7.0))
    println "[" + s + "] " + a + " " + b + " " + c
end

func main throw:
    xs := [
        "nan", "inf", "-inf", "+inf", "infinity", "-infinity", "NaN", "Inf", "INF", "INFINITY",
        "-Infinity", "nAn", "+nan", "nanx", "infx", "infinite", "infinityx", " inf", "inf ", "\tinf",
        "in", "na", "-in", "2.5", "-1e3", "1e400", "-1e400", "1e-400", "abc", "", "-", "-abc",
        "3.5x", ".5", "-.5e-1", "-0", "1e", "1e+", "0x10", "-0x10", "0x1.8p1", "0X1P3", "0x", "۲.۵",
        "-۳", "٣.٥", "٫٥"
    ]
    each x in xs:
        show(x)
    end
    println try conv.ParseFloat("inf")
    println try conv.ParseFloat("-Infinity")
    println try conv.ParseFloat("NaN")
    println try conv.ParseFloat("۲.۵")
end
