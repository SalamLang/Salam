import conv
import encoding.json

struct Reading:
    pub value: f64 = 0.0
    pub count: int = 0
end

func decode(text: str):
    mut r := Reading {}
    try:
        json.Unmarshal(text, r)
        println "ok", r.value, r.count
    catch e:
        println "error", e.kind == ErrorKind.OutOfRange, e.message
    end
end

func decode_value(text: str):
    try:
        v := json.Decode(text)
        println "ok", json.EncodeDefault(v)
    catch e:
        println "error", e.kind == ErrorKind.OutOfRange, e.message
    end
end

func main:
    zero := 0.0
    nan := zero / zero
    mut m := HashMap {} as HashMap<f64, int>
    m.Put(nan, 3)
    m.Put(nan, 4)
    println m.Size(), m.Get(nan), m.Has(nan)
    m.Put(0.0, 1)
    m.Put(-0.0, 2)
    m.Put(-2.5, 5)
    m.Put(12345.75, 6)
    m.Put(-2.5, 7)
    println m.Size(), m.Get(0.0), m.Get(-0.0), m.Get(-2.5), m.Get(12345.75)
    println m.Remove(nan), m.Has(nan), m.Size()
    mut h := HashMap {} as HashMap<f32, int>
    hz := 0.0 as f32
    h.Put(hz / hz, 1)
    h.Put(hz / hz, 2)
    println h.Size(), h.Get(hz / hz)

    println conv.FormatFloatPrec(1e21, 2)
    println conv.FormatFloatPrec(-1e22, 1)
    println conv.FormatFloatPrec(123456789012345678.0, 2)
    println conv.FormatFloatPrec(1e20, 0)
    println conv.FormatFloatPrec(12345.678, 15)
    println conv.FormatFloatPrec(1.5e30, 3).Len()
    println conv.FormatFloatPrec(0.000001, 3)
    println conv.FormatFloatPrec(0.125, 2)
    println conv.FormatFloatPrec(3.14159, 3)
    println conv.FormatFloatPrec(nan, 2),
        conv.FormatFloatPrec(1.0 / zero, 2),
        conv.FormatFloatPrec(-1.0 / zero, 2)

    decode(`{"value": 1e400, "count": 1}`)
    decode(`{"value": -1e309, "count": 1}`)
    decode(`{"value": 1e-400, "count": 2}`)
    decode(`{"value": 1.5e300, "count": 3}`)
    decode_value(`[1, 2.5, 1e400]`)
    decode_value(`[1, 2.5, 1e-400]`)
end
