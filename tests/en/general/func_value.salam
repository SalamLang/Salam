func greet(x: i64):
    println "greet", x
end

func twice(x: i64):
    println "twice", x * 2
end

func dispatch(fn: i64, arg: i64):
    callhandler(fn, arg)
end

func main:
    h := greet
    callhandler(h, 1)
    callhandler(greet, 2)
    dispatch(twice, 3)
    ret 0
end
