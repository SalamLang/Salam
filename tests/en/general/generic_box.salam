struct Box<T>:
    pub val: T
end

struct Pair<A, B>:
    pub first: A
    pub second: B
end

func main:
    b := Box { val = 42 } as Box<int> println b.val
    p := Pair { first = 7, second = "hi" } as Pair<int, str> println p.first
    println p.second
end
