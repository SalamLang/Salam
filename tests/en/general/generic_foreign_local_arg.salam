package main

import chan
import option

struct Event:
    pub kind: int = 0
end

enum Mode:
    Idle
    Busy
end

type Id = int

struct Bus:
    pub events: chan.Chan<Event>
    pub last: option.Option<Event>
    pub mode: option.Option<Mode>
    pub id: option.Option<Id>
    pub refs: chan.Chan<Event*>
end

func main:
    mut events := chan.Chan {} as chan.Chan<Event>
    events.init(4)
    mut refs := chan.Chan {} as chan.Chan<Event*>
    refs.init(4)
    bus := Bus { events = events, last = option.Some(Event { kind = 3 }), mode = option.Some(Mode.Busy), id = option.Some(7 as Id), refs = refs }
    bus.events.send(Event { kind = 9 })
    mut open := true
    got := bus.events.recv(open)
    println got.kind
    println option.Unwrap(bus.last).kind
    println option.IsSome(bus.mode)
    println option.Unwrap(bus.id)
    println bus.refs.capacity()
    ret 0
end
