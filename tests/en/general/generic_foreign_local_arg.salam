package main

import chan
import core

struct Event:
    pub kind: int = 0
end

enum Mode:
    Idle
    Busy
end

type Id = int

struct Bus:
    pub events: chan.Chan<Event>
    pub last: core.Option<Event>
    pub mode: core.Option<Mode>
    pub id: core.Option<Id>
    pub refs: chan.Chan<Event*>
end

func main:
    mut events := chan.Chan {} as chan.Chan<Event>
    events.init(4)
    mut refs := chan.Chan {} as chan.Chan<Event*>
    refs.init(4)
    bus := Bus { events = events, last = core.Some(Event { kind = 3 }), mode = core.Some(Mode.Busy), id = core.Some(7 as Id), refs = refs }
    bus.events.send(Event { kind = 9 })
    mut open := true
    got := bus.events.recv(open)
    println got.kind
    println core.Unwrap(bus.last).kind
    println core.IsSome(bus.mode)
    println core.Unwrap(bus.id)
    println bus.refs.capacity()
    ret 0
end
