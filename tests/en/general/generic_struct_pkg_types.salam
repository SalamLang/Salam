package main

include genboxa "_genbox_a.salam"
include genboxb "_genbox_b.salam"

func main:
    println genboxa.Label(genboxa.Mark { level = 2 }), genboxa.Ok(genboxa.Mark { level = 2 })
    mut nums := genboxb.Box { owner = "ana" } as genboxb.Box<int>
    println nums.Add(1), nums.Add(2), nums.Describe()
    mut nobody := genboxb.Box {} as genboxb.Box<str>
    println nobody.Add("x"), nobody.Describe(), nobody.tag.name
end
