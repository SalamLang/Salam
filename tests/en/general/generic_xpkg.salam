// A generic instantiated over a struct from another package, named from two
// modules. The instance is created once per module that mentions it, and the
// second copy used to resolve `T*` inside Vector's own body by name - a name
// only the declaring package can see - and failed with
// "unknown type 'genrow_Row'", pointing at unrelated line numbers.
package main

import genuse "_genuse.salam"
import genrow "_genrow.salam"

func main:
    println genuse.Sum(4)
    mut v := genrow.List(3)
    defer v.free()
    println v.len(), v.get(2).id, v.get(1).tag
end
