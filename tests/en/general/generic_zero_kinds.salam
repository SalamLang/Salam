type Flag: bool
    func show: str:
        ret (this as bool) ? "on" : "off"
    end
end

type Money: f64
    func label: str:
        ret "money"
    end
end

type Name: str
    func label: str:
        ret "name"
    end
end

enum Color:
    Red = "is_red", Green = "is_green"
end

enum Blank:
    Empty = "", Full = "full"
end

struct Arr:
    pub vals: int[3]
    pub tag: str = "t"
end

struct Box<V>:
    pub x: int = 0
    pub func zero(): V:
        ret V {}
    end
end

struct LBox<V>:
    pub x: int = 0
    pub func label(): str:
        z := V {}
        ret z.label()
    end
end

struct FBox<V>:
    pub x: int = 0
    pub func show(): str:
        z := V {}
        ret z.show()
    end
end

func main:
    println (FBox {} as FBox<Flag>).show()
    println (LBox {} as LBox<Money>).label(), (LBox {} as LBox<Name>).label()
    c := (Box {} as Box<Color>).zero()
    println c == Color.Red, c as str
    e := (Box {} as Box<Blank>).zero()
    println e == Blank.Empty, "[" + (e as str) + "]"
    b := (Box {} as Box<Arr>).zero()
    println b.tag, b.vals[0], b.vals[2]
end
