struct P:
    pub name: str = "def"
    pub n: int = 7
end

struct Req:
    pub label: str
    pub count: int
    pub inner: P
end

struct G<T>:
    pub v: int = 3
end

enum Color:
    Red,
    Green
end

struct Box<V>:
    pub x: int = 0
    pub func zero(): V:
        ret V {}
    end
end

func main:
    println (Box {} as Box<i64>).zero(), (Box {} as Box<f32>).zero(), (Box {} as Box<u8>).zero(), (Box {} as Box<f64>).zero()
    println (Box {} as Box<int*>).zero() == null
    c := (Box {} as Box<Color>).zero()
    println c == Color.Red
    v := (Box {} as Box<Vector<int>>).zero()
    println v.len()
    m := (Box {} as Box<HashMap<str, int>>).zero()
    println m.size()
    g := (Box {} as Box<G<int>>).zero()
    println g.v
    f := (Box {} as Box<func (int) int>).zero()
    _ := f
    s := (Box {} as Box<str>).zero()
    println s.len(), (Box {} as Box<P>).zero().name
    r := (Box {} as Box<Req>).zero()
    println r.label.len(), r.count, r.inner.n, r.inner.name
end
