include ze "zeroenum/zeroenum.salam"

struct Box<V>:
    pub x: int = 0
    pub func zero(): V:
        ret V {}
    end
end

func main:
    s := (Box {} as Box<ze.Shade>).zero()
    println s == ze.Shade.Light, s as str
end
