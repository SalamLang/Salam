include ze "zeroenum/zeroenum.salam"

struct Inner:
    pub v: int = 5
end

type InnerAlias = Inner

struct Outer:
    pub spot: ze.Spot
    pub n: int = 1
end

struct Big:
    pub buf: u8[100000]
    pub tag: str = "b"
end

struct Holder:
    pub big: Big
end

struct Box<V>:
    pub x: int = 0
    pub func zero(): V:
        ret V {}
    end
end

func main:
    a := (Box {} as Box<InnerAlias>).zero()
    println a.v
    o := (Box {} as Box<Outer>).zero()
    println o.spot.x, o.spot.y, o.n
    b := (Box {} as Box<Big>).zero()
    println b.tag, b.buf[0], b.buf[99999]
    mut h: Holder
    h.big.tag = "h"
    println h.big.tag, h.big.buf[12]
end
