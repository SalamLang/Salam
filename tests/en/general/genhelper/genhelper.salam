package genhelper

mut _calls := 0

func _double(x: int): int:
    _calls = _calls + 1
    ret x + x
end

pub func Quad<T>(x: T): T: ret _double(_double(x))
end

pub func Bump<T>(x: T): T: _calls = _calls + 1
    ret x
end

pub func Calls(): int:
    ret _calls
end
