// A module-level array copied from another module-level array, or from a
// row of a 2-D array. C cannot initialise one array object from another,
// so this runs as a statement in the module's own init function.

ga := [1, 2, 3]
gb := ga
grid := [[1, 2], [3, 4]]
grow := grid[1]

func main:
    println gb[0], gb[1], gb[2], grow[0], grow[1]
end
