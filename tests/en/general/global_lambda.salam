// A lambda in a global initializer: the value is taken by address in the
// module's init function, ahead of the lambda body.

inc := (a: i32) => a + 1
twice := (f: func(i32) i32, x: i32) => f(f(x))

func main:
    println inc(1), twice(inc, 5)
end
