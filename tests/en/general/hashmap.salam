func main:
    m := HashMap {} as HashMap<int, str> m.Put(1, "one")
    m.Put(2, "two")
    println m.Get(1), m.Get(2)
    println m.Has(2), m.Has(9)
    println m.Size()
    m.Remove(1)
    println m.Size()
end
