func main:
    mut m := HashMap {} as HashMap<str, int> m.Put("a", 10)
    m.Put("b", 20)
    m.Put("c", 30)
    mut total := 0
    it := m.Iter()
    until it.HasNext():
        total += it.Value()
        it.Next()
    end
    println total
end
