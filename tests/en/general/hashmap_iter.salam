func main:
    mut m := HashMap {} as HashMap<str, int> m.put("a", 10)
    m.put("b", 20)
    m.put("c", 30)
    mut total := 0
    it := m.iter()
    until it.has_next():
        total = total + it.value()
        it.next()
    end
    println total
end
