import mem

struct Sink:
    pub data: u8* = null
    pub len: int = 0
    pub cap: int = 0
    pub acc: i64 = 0
    pub nbits: int = 0
    pub grows: int = 0
end

struct Source:
    pub data: u8* = null
    pub len: int = 0
    pub pos: int = 0
    pub acc: i64 = 0
    pub nbits: int = 0
    pub bad: bool = false
    pub refills: int = 0
end

noinline func note_refill(r &: Source, b: int):
    r.refills += 1 + (b & 1)
end

func push_byte(s &: Sink, v: int):
    if s.len >= s.cap:
        mut nc := s.cap < 8 ? 8 : s.cap * 2
        until nc < s.len + 1:
            nc *= 2
        end
        s.data = mem.Reallocate(s.data as void*, nc as u64) as u8*
        s.cap = nc
        s.grows++
    end
    s.data[s.len] = (v & 255) as u8
    s.len++
end

func put_bits(s &: Sink, value: i64, count: int):
    if count <= 0 or count > 56:
        ret
    end
    s.acc = (s.acc << count) | (value & (((1 as i64) << count) - 1))
    s.nbits += count
    until s.nbits >= 8:
        push_byte(s, ((s.acc >> (s.nbits - 8)) & 255) as int)
        s.nbits -= 8
        s.acc &= (((1 as i64) << s.nbits) - 1)
    end
end

func get_bits(r &: Source, count: int): i64:
    if count <= 0 or count > 56:
        ret 0
    end
    until r.nbits < count:
        if r.pos >= r.len:
            r.bad = true
            r.acc <<= 8
        else:
            b := r.data[r.pos] as int
            r.acc = (r.acc << 8) | (b as i64)
            r.pos++
            if (b & 7) == 5:
                note_refill(r, b)
            end
        end
        r.nbits += 8
    end
    left := r.nbits - count
    v := (r.acc >> left) & (((1 as i64) << count) - 1)
    r.nbits = left
    r.acc &= (((1 as i64) << left) - 1)
    ret v
end

func get_unary(r &: Source): int:
    mut n := 0
    until not r.bad:
        if get_bits(r, 1) == 1:
            break
        end
        n++
    end
    ret n
end

func main():
    mut s := Sink {}
    put_bits(s, 5, 3)
    mut i := 0
    until i < 5000:
        w := 1 + (i * 7) % 23
        put_bits(s, i * 2654435761, w)
        q := i % 5
        mut k := 0
        until k < q:
            put_bits(s, 0, 1)
            k++
        end
        put_bits(s, 1, 1)
        i++
    end
    put_bits(s, 0, 7)
    println s.len, s.nbits, s.grows
    mut h := 0 as i64
    mut j := 0
    until j < s.len:
        h = (h * 31 + (s.data[j] as i64)) % 1000000007
        j++
    end
    println h
    mut r := Source { data = s.data, len = s.len }
    first := get_bits(r, 3)
    mut sum := 0 as i64
    mut uns := 0
    mut ok := 0
    i = 0
    until i < 5000:
        w := 1 + (i * 7) % 23
        v := get_bits(r, w)
        want := (i * 2654435761) & (((1 as i64) << w) - 1)
        if v == want:
            ok++
        end
        sum += v
        u := get_unary(r)
        if u == i % 5:
            uns++
        end
        i++
    end
    println first, ok, uns, sum, r.pos, r.bad
    mut extra := 0 as i64
    mut t := 0
    until t < 64:
        extra += get_bits(r, 13)
        t++
    end
    println extra, r.bad, r.nbits, r.refills
    mem.Free(s.data as void*)
end
