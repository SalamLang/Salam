import http

func main:
    mut h := http.NewHeaders()
    h.put("Authorization", "Bearer xyz")
    h.put("Accept", "application/json")
    println h.size()
    println h.get("Authorization")
    println h.get("Accept")
    println h.has("Accept")
    println h.has("Missing")
end
