func run(f: func (int)):
    f(4)
end

func main():
    mut total seen := 0
    mut a := 0
    mut b := 0
    mut c := 0
    run((v: int): a = v b = a c = b * 2 total seen += c println a, b, c, total seen end)
    a = 1 b = a total seen = b
    println a, b, total seen
end
