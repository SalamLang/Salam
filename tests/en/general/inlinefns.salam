import il "_inlinelib.salam"

inline func local half(x: int): int: ret x / 2 end

pub inline func Square(x: int): int: ret x * x end

func main:
    println il.Twice(21)
    println il.Scaled(5)
    println il.ViaHidden(1)
    println local half(10)
    println Square(7)
end
