import conv
import str
import encoding.json

struct Ledger:
    pub id: u64 = 0
    pub balance: i64 = 0
    pub count: int = 0
end

func keep<T>(x: T): T:
    ret x
end

func mix(h: u64, x: u64): u64:
    ret (h ^ x) * (1099511628211 as u64)
end

func total(v: Vector<i64>): i64:
    mut s := 0 as i64
    each x in v:
        s += x
    end
    ret s
end

func widen(n: int): i64:
    ret n
end

func main:
    max := keep(9223372036854775807 as i64)
    min := keep(-9223372036854775807 as i64) - (1 as i64)
    println max + (1 as i64), min - (1 as i64), max * (2 as i64)
    println keep(3037000500 as i64) * keep(3037000500 as i64)
    p := keep(9007199254740993 as i64)
    println p, p + (2 as i64), p == p - (1 as i64), p > (9007199254740992 as i64)
    println min / keep(-1 as i64),
        min % keep(-1 as i64),
        keep(-7 as i64) / (2 as i64),
        keep(-7 as i64) % (2 as i64)
    umax := keep(18446744073709551615 as u64)
    println umax,
        umax + (1 as u64),
        keep(0 as u64) - (1 as u64),
        umax / (3 as u64),
        umax % (1000 as u64)
    one := keep(1 as i64)
    println one << (63 as i64),
        (one << (63 as i64)) >> (3 as i64),
        umax >> (1 as u64),
        one << keep(65 as i64)
    println max & keep(-256 as i64),
        max ^ keep(81985529216486895 as i64),
        ~p,
        umax ^ (12297829382473034410 as u64)
    mut h := keep(14695981039346656037 as u64)
    repeat 10 in k:
        h = mix(h, k as u64)
    end
    println h
    n := keep(-5)
    println n as u64, n as i64, widen(n), max as i32, umax as u8, max as f64, p as f32
    println keep(1e19) as i64,
        keep(-1e19) as i64,
        keep(1e20) as u64,
        keep(-1.0) as u64,
        keep(0.0 / 0.0) as i64
    println keep(4611686018427387904.0) as i64,
        umax as i64,
        min as u64,
        (umax as i128) + 1,
        (keep(1 as i128) << 70) as i64
    println "p=" + p, "u=" + umax, conv.FormatInt(min), conv.FormatUint(umax)
    println conv.ParseIntOr("-9223372036854775808", 0 as i64),
        conv.ParseIntOr("9007199254740993", 0 as i64)
    mut m := HashMap {} as HashMap<i64, str>
    m.Put(p, "odd")
    m.Put(p - (1 as i64), "even")
    println m.Get(9007199254740993 as i64), m.Get(9007199254740992 as i64), m.Has(p + (1 as i64))
    m.Free()
    mut v := Vector {} as Vector<i64>
    v.Push(max)
    v.Push(keep(2 as i64))
    v.Push(p)
    println total(v), v.Get(2) - v.Get(1)
    v.Free()
    arr := [1, 2, 3, 4]
    idx := keep(2 as i64)
    println arr[idx]
    mut acc := 0 as i64
    repeat p to p + (3 as i64) in i:
        acc += i % (10 as i64)
    end
    println acc
    led := Ledger { id = umax - (5 as u64), balance = min + (7 as i64), count = 3 }
    txt := json.Marshal(led)
    println str.Contains(txt, "18446744073709551610"), str.Contains(txt, "-9223372036854775801")
    mut back := Ledger {}
    try:
        json.Unmarshal(txt, back)
    catch e:
        println "err", e.message
    end
    println back.id == led.id, back.balance, back.count
    println hash(p) == hash(keep(9007199254740993 as i64)), hash(p) == hash(p - (1 as i64))
    println hash(keep(42 as i64)), hash(keep("salam"))
end
