func d8(x: i8, y: i8): i8:
    ret x / y
end

func r8(x: i8, y: i8): i8:
    ret x % y
end

func d16(x: i16, y: i16): i16:
    ret x / y
end

func r16(x: i16, y: i16): i16:
    ret x % y
end

func d32(x: i32, y: i32): i32:
    ret x / y
end

func r32(x: i32, y: i32): i32:
    ret x % y
end

func d64(x: i64, y: i64): i64:
    ret x / y
end

func r64(x: i64, y: i64): i64:
    ret x % y
end

func lit32(x: i32): i32:
    ret x / -1
end

func grows(x: i32): bool:
    ret x + 1 > x
end

func main:
    println "i8", d8(-128 as i8, -1 as i8), r8(-128 as i8, -1 as i8)
    println "i16", d16(-32768 as i16, -1 as i16), r16(-32768 as i16, -1 as i16)
    println "i32", d32(-2147483648 as i32, -1), r32(-2147483648 as i32, -1)
    mn := (-9223372036854775807 as i64) - 1
    println "i64", d64(mn, -1), r64(mn, -1)
    println "lit", lit32(-2147483648 as i32), lit32(7)
    mut c := -2147483648 as i32
    c /= d32(-1, 1)
    println "compound div", c
    mut e := mn
    e %= d64(-1, 1)
    println "compound mod", e
    println "plain", d32(7, -1), r32(-7, -1), d32(7, 2), r32(-7, 2), d64(-9, 4), r64(-9, 4)
    println "wrap", grows(2147483647), grows(5)
end
