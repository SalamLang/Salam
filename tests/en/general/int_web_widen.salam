package main

noinline func sift(arr: Vector<i64>, n: int, start: int): int:
    mut i := start
    mut steps := 0
    until true:
        mut largest := i
        l := 2 * i + 1
        r := 2 * i + 2
        if l < n and arr.get(l) > arr.get(largest):
            largest = l
        end
        if r < n and arr.get(r) > arr.get(largest):
            largest = r
        end
        if largest == i:
            break
        end
        tmp := arr.get(i)
        arr.set(i, arr.get(largest))
        arr.set(largest, tmp)
        i = largest
        steps += 1
    end
    ret steps
end

noinline func walk(v: Vector<int>, off: int, lim: int): i64:
    mut k := off
    mut s := 0 as i64
    mut guard := 0
    until guard < 200:
        idx := k - off
        s = s * 31 + (v.get(idx) as i64)
        nk := k + v.get(idx) % 3 - 1
        mut next := nk
        if (nk - off) as u32 >= lim as u32:
            next = off
        end
        k = next
        guard += 1
    end
    ret s % 1000000007
end

func main:
    mut a := Vector {} as Vector<i64>
    repeat 101 in i:
        a.push(((i * 7919) % 211) as i64)
    end
    mut st := 0
    mut j := 49
    until j >= 0:
        st += sift(a, 101, j)
        j -= 1
    end
    mut h := 0 as i64
    each x in a:
        h = h * 131 + x
        h = h % 1000000007
    end
    mut v := Vector {} as Vector<int>
    repeat 64 in i:
        v.push((i * 37) % 17)
    end
    println st, h, walk(v, 0 - 50, 64), walk(v, 1000, 64)
    a.free()
    v.free()
end
