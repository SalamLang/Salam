// Integer width and signedness: arithmetic wraps modulo 2^n in the
// operand's own type, and signed/unsigned pick different operations for
// >>, /, %, comparisons and printing (SALAM-TYPES.md 4.1, 15, 16, 21).
// The same file lives in tests/en/general and tests/en/llvm so the
// interpreter, the C backend and the LLVM backend must agree byte for byte.

func rotl32(x: u32, n: u32): u32:
    ret (x << n) | (x >> (32 - n))
end

func widen(x: u8): u64:
    ret x as u64
end

func main:
    // u32 wraparound
    a := 4000000000 as u32
    b := 1000000000 as u32
    println "add wrap:", a + b
    c := 3000000000 as u32
    println "mul wrap:", c * (3 as u32)

    // logical (not arithmetic) shift right on u32
    d := 4294967295 as u32
    println "u32 shr:", d >> 28
    println "rotl8:", rotl32(0x12345678 as u32, 8 as u32)
    println "xor:", (0xF0F0F0F0 as u32) ^ (0x0F0F0F0F as u32)
    println "not:", ~(0 as u32)

    // u64 stays unsigned through arithmetic, shifts and printing
    p := 4000000000 as u64
    q := 4000000000 as u64
    println "u64 mul:", p * q
    println "u64 shr32:", (p * q) >> 32
    big := 18000000000000000000 as u64
    println "u64 print:", big
    println "u64 div:", big / (7 as u64)
    println "u64 mod:", big % (7 as u64)
    println "u64 shl:", (1 as u64) << (63 as u64)

    // plain int is i32 and wraps at 32 bits
    x := 2000000000
    println "i32 add:", x + x
    println "i32 mul:", x * 3

    // narrow types wrap at their own width, no promotion to int
    b8 := 200 as u8
    println "u8 add:", b8 + (100 as u8)
    println "u8 not:", ~b8
    h16 := 60000 as u16
    println "u16 add:", h16 + (10000 as u16)
    s8 := 100 as i8
    println "i8 add:", s8 + (100 as i8)
    s16 := 30000 as i16
    println "i16 add:", s16 + (10000 as i16)

    // unary minus preserves the operand type
    println "u32 neg:", -(1 as u32)
    println "u64 neg:", -(1 as u64)

    // signed shift right is arithmetic
    println "i64 sar:", (-16 as i64) >> (2 as i64)
    println "sar63:", (-1 as i64) >> (63 as i64)

    // comparisons must not order by the signed reinterpretation
    println "u64 cmp:", big > (1 as u64), big < (1 as u64), big == big
    println "u32 cmp:", (4000000000 as u32) > (1 as u32)

    // compound assignment and inc/dec wrap in the variable's type
    mut m := 4000000000 as u32
    m += 1000000000 as u32
    println "cmp-add:", m
    m <<= 5 as u32
    println "cmp-shl:", m
    m >>= 3 as u32
    println "cmp-shr:", m
    mut w := 4294967295 as u32
    w++
    println "inc-wrap:", w
    w--
    println "dec-wrap:", w

    // casts truncate to the target width and reinterpret the bit pattern
    v := 4294967295 as u32
    println "chain:", v as u8, v as u16, v as i32, v as i64
    n := -1 as i32
    println "chain2:", n as u8, n as u16, n as u32, n as u64
    println "roundtrip:", (200 as u32) as int
    println "widen:", widen(200 as u8)

    // unsigned values format unsigned when concatenated too
    println "concat:", "" + big + "|" + (4000000000 as u32)

    // an fnv-1a style u64 accumulation loop
    mut h := 14695981039346656037 as u64
    mut i := 0
    until i < 8:
        h = h ^ ((i + 1) as u64)
        h = h * (1099511628211 as u64)
        i++
    end
    println "fnv:", h
end
