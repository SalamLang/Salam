package main

// An interface method with `&:` parameters, called through a dyn value:
// the callee must see the caller's variable, not a copy, on both backends.

struct Counter:
    pub n: int = 0
end

interface Visitor:
    func visit(c &: Counter, weight: int): int
end

struct Adder:
    pub step: int = 1
    pub func visit(c &: Counter, weight: int): int:
        c.n += this.step * weight
        ret c.n
    end
end

struct Doubler:
    pub unused: int = 0
    pub func visit(c &: Counter, weight: int): int:
        c.n = c.n * 2 + weight
        ret c.n
    end
end

func run(v: dyn Visitor, c &: Counter, w: int): int:
    ret v.visit(c, w)
end

func main:
    mut c := Counter {}
    a := Adder { step = 3 } as dyn Visitor
    println run(a, c, 2)
    println c.n
    d := Doubler {} as dyn Visitor
    println run(d, c, 1)
    println c.n
    mut vs := Vector {} as Vector<dyn Visitor>
    vs.push(a)
    vs.push(d)
    repeat vs.len() with i:
        v := vs.get(i)
        println v.visit(c, 10)
    end
    println c.n
    vs.free()
end
