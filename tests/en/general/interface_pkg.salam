// An interface declared in one package, implemented in another, and named by
// a third as `dyn pkg.Iface` and `<T: pkg.Iface>`. Both spellings have to name
// the SAME type as the bare `Store` that ifacestore itself would write, or the
// two would get separate vtables and a boxed value would not dispatch.

import ifacestore "_ifacestore.salam"
import ifacedriver "_ifacedriver.salam"

func show(s: dyn ifacestore.Store):
    r := s.Get(2)
    println s.Kind(), r.id, r.name
end

func showbound<T: ifacestore.Store>(s: T):
    r := s.Get(5)
    println r.id, r.name
end

func pick(flag: bool): dyn ifacestore.Store:
    if flag:
        ret ifacedriver.Memory { base = 100 }
    end
    ret ifacedriver.Fixed { only = "one" }
end

func main:
    show(ifacedriver.Memory { base = 10 } as dyn ifacestore.Store)
    show(ifacedriver.Fixed { only = "one" } as dyn ifacestore.Store)
    show(pick(true))
    show(pick(false))
    showbound(ifacedriver.Memory { base = 1000 })

    stores := Vector {} as Vector<dyn ifacestore.Store> defer stores.free()
    stores.push(ifacedriver.Memory { base = 7 })
    stores.push(ifacedriver.Fixed { only = "last" })
    mut i := 0
    until i < stores.len():
        show(stores.get(i))
        i = i + 1
    end
end
