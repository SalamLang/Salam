// An interface method may return a struct by value, through dynamic dispatch
// as well as a static bound. An aggregate return lowers to an out-parameter,
// so the vtable slot, the thunk and the call site all have to agree on that
// shape - they used to disagree and the generated C did not compile.

interface Rows:
    func Next(): bool
    func Text(): str
end

struct Cursor:
    pub n: int = 0
    pub label: str = ""
    pub func Next(): bool:
        if this.n > 0:
            this.n = this.n - 1
            ret true
        end
        ret false
    end
    pub func Text(): str: ret this.label end
end

struct Pair:
    pub a: int = 0
    pub b: int = 0
end

interface Conn:
    func Query(sql: str): Cursor
    func Stats(): Pair
    func Open(): dyn Rows
    func Kind(): str
end

struct Sqlite:
    pub tag: str = "sqlite"
    pub rows: int = 0
    pub func Query(sql: str): Cursor:
        ret Cursor { n = len(sql), label = this.tag }
    end
    pub func Stats(): Pair: ret Pair { a = this.rows, b = 2 } end
    pub func Open(): dyn Rows: ret Cursor { n = 2, label = "r" } end
    pub func Kind(): str: ret this.tag end
end

func viadyn(c: dyn Conn):
    cur := c.Query("abc")
    println c.Kind(), cur.n, cur.label
    st := c.Stats()
    println st.a, st.b
    r := c.Open()
    until r.Next():
        println r.Text()
    end
end

func viabound<T: Conn>(c: T):
    cur := c.Query("hello")
    println cur.n, cur.label
end

func main:
    s := Sqlite { tag = "sqlite", rows = 7 }
    viadyn(s as dyn Conn)
    viabound(s)
end
