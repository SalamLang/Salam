interface Shape:
    func area(): int
    func name(): str
end

struct Sq:
    pub s: int = 0
    pub func area(): int: ret this.s * this.s end
    pub func name(): str: ret "sq" end
end

struct Rect:
    pub w: int = 0
    pub h: int = 0
    pub func area(): int: ret this.w * this.h end
    pub func name(): str: ret "rect" end
end

func main:
    shapes := Vector {} as Vector<dyn Shape> defer shapes.Free()
    shapes.Push(Sq { s = 4 })
    shapes.Push(Rect { w = 3, h = 6 })
    shapes.Push(Sq { s = 2 })
    mut i := 0
    mut total := 0
    until i < shapes.Len():
        print shapes.Get(i).name()
        print "="
        println shapes.Get(i).area()
        total += shapes.Get(i).area()
        shapes.Get(i).Free()
        i++
    end
    print "total="
    println total
end
