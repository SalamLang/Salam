// io.Flush pushes every buffered output stream out to the operating system.
// Calling it with nothing pending is a no-op, so the only thing this checks
// is that the call exists, compiles, and runs on every backend.
package main

import io

func main:
    print "before"
    io.Flush()
    println " after"
    io.Flush()
    println "done"
end
