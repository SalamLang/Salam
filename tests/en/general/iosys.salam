import io
import os
import time

func main:
    path := "_iosys_test.txt"
    os.Remove(path)
    io.WriteFile(path, "alpha\n")
    io.AppendFile(path, "beta\n")
    io.AppendFile(path, "gamma\n")
    lines := io.Lines(path)
    defer lines.Free()
    println lines.Len()
    println lines.Get(0)
    println lines.Get(2)
    println os.Exists(path)
    os.Remove(path)
    println os.Exists(path)
    println os.Cwd().Len() > 0
    t0 := time.Now()
    time.Sleep(0)
    println time.Now() >= t0
end
