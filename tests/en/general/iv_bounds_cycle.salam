package main

noinline func f0(a: i64, b: i64): i64:
    mut x := a
    mut y := b
    mut z := a ^ b
    mut v := Vector {} as Vector<i64>
    if (((0 - 7 as i64) & (0 - 1 as i64)) ^ (a & b)) + x > ((b & x) >> (z & 31)):
        each e in v:
            y = (y + e * 3) % 1000003
        end
    else:
        if ((((y % 46337) * ((0 - 7 as i64) % 46337)) % 1000003) >> ((((z % 46337) * (y % 46337)) % 1000003) & 31)) + x > (((5 as i64) % ((x % 11) + 13)) >> (((7 as i64) & (7 as i64)) & 31)):
            repeat 17 in i3:
                y = (((((i3 as i64) % ((x % 11) + 13)) & 65535) << (x & 15)) ^ ((a < b ? b : a) % ((((b - y) % 1000003) % 11) + 13)))
            end
        else:
            if (((((y as u8) as i64) + (((255 as i64) as i16) as i64)) as i32) as i64) + x > ((255 as i64) % (((y != z ? (1 as i64) : y) % 11) + 13)):
                y = ((b ^ (y % ((x % 11) + 13))) / (((5 as i64) % 7) + 8))
            else:
                z = (((((1 as i64) | a) / ((((((1000 as i64) % 46337) * ((13 as i64) % 46337)) % 1000003) % 7) + 8)) & 65535) << (((b | (1000 as i64)) % (((3 as i64) % 11) + 13)) & 15))
            end
            if (((x % ((a % 11) + 13)) - ((z as i32) as i64)) % 1000003) + x > (((z > z ? (13 as i64) : z) + x) % 1000003):
                z = (((a >> ((0 - 1 as i64) & 31)) <= ((z + (65535 as i64)) % 1000003) ? ((((0 as i64) % 46337) * ((13 as i64) % 46337)) % 1000003) : (a >> ((0 - 1 as i64) & 31))) | (((a / (((7 as i64) % 7) + 8)) + ((7 as i64) & y)) % 1000003))
            else:
                x = (y & ((((b % 46337) * (z % 46337)) % 1000003) ^ z))
            end
            if v.len() > 0:
                v.set(((((((13 as i64) | a) < a ? ((0 - 7 as i64) & b) : ((13 as i64) | a)) % (v.len() as i64)) + (v.len() as i64)) % (v.len() as i64)) as int, (z >> (a & 31)))
            end
        end
    end
    mut s := x * 7 + y * 3 + z
    each w in v:
        s = (s * 31 + w) % 1000003
    end
    ret s
end

func main:
    println f0((5 as i64), (7 as i64))
end
