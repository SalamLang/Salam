import encoding.json
import encoding.encerr

struct Money:
    pub cents: i64 = 0
    pub func to_json(): str:
        ret "\"" + this.cents + "c\""
    end
    pub func from_json(raw: str): bool:
        if raw.len() < 3: ret false end
        this.cents = 99
        ret true
    end
end

struct Rec:
    @json "user_name"
    pub name: str = ""
    @json "-"
    pub secret: str = ""
    @json "" "omitempty"
    pub nick: str = ""
    @json "" "optional"
    pub note: str = "def"
    @json "" "string"
    pub bigid: i64 = 0
    pub price: Money = Money {}
end

func show(text: str):
    mut r := Rec {}
    mut e := encerr.NoError()
    print text
    print " -> "
    if json.Unmarshal(text, r, e):
        println json.Marshal(r)
    else:
        print "ERR "
        print e.message
        print " @"
        println e.position
    end
end

func lenient(text: str):
    mut r := Rec {}
    mut e := encerr.NoError()
    print text
    print " ~> "
    if json.UnmarshalLenient(text, r, e):
        println json.Marshal(r)
    else:
        print "ERR "
        println e.message
    end
end

func main:
    m := Money { cents = 250 }
    r := Rec { name = "ali", secret = "hidden", bigid = 9007199254740993, price = m }
    println json.Marshal(r)

    show("{\"user_name\":\"a\",\"bigid\":\"7\",\"price\":\"1c\"}")
    show("{\"user_name\":\"a\",\"nick\":\"n\",\"note\":\"x\",\"bigid\":\"7\",\"price\":\"1c\"}")
    show("{\"bigid\":\"7\",\"price\":\"1c\"}")
    show("{\"user_name\":\"a\",\"secret\":\"s\",\"bigid\":\"7\",\"price\":\"1c\"}")
    show("{\"user_name\":\"a\",\"user_name\":\"b\",\"bigid\":\"7\",\"price\":\"1c\"}")
    show("{\"user_name\":\"a\",\"bigid\":7,\"price\":\"1c\"}")
    show("{\"user_name\":5,\"bigid\":\"7\",\"price\":\"1c\"}")
    show("{\"user_name\":\"a\",\"bigid\":\"7\",\"price\":\"1c\"} junk")
    lenient("{\"user_name\":\"a\",\"zz\":[1,{\"q\":2}],\"bigid\":\"7\",\"price\":\"1c\"}")
    lenient("{\"price\":\"1c\"}")
end
