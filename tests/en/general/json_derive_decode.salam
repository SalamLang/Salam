import encoding.json
import encoding.encerr

enum Role:
    Guest
    Admin
end

struct Addr:
    pub city: str = ""
    pub zip: int = 0
end

struct User:
    pub name: str = ""
    pub age: int = 0
    pub active: bool = false
    pub role: Role = Role.Guest
    pub addr: Addr = Addr {}
    pub tags: Vector<str> = Vector {} as Vector<str>
    pub next: User* = null
end

struct Wide:
    pub id: i64 = 0
    pub big: u64 = 0
    pub ratio: f64 = 0.0
    pub letter: char = 'a'
    pub small: u8 = 0
end

func main:
    text := "{\"name\":\"sara\",\"age\":41,\"active\":true,\"role\":\"Admin\",\"addr\":{\"city\":\"tabriz\",\"zip\":5},\"tags\":[\"a\",\"b\"],\"next\":{\"name\":\"deep\",\"age\":1,\"active\":false,\"role\":\"Guest\",\"addr\":{\"city\":\"\",\"zip\":0},\"tags\":[],\"next\":null}}"
    mut u := User {}
    mut e := encerr.NoError()
    println json.Unmarshal(text, u, e)
    println u.name
    println u.age
    println u.active
    println u.role as i64
    println u.addr.city
    println u.tags.get(1)
    println u.next[0].name
    println json.Marshal(u) == text

    wtext := "{\"id\":9007199254740993,\"big\":18446744073709551615,\"ratio\":0.125,\"letter\":\"z\",\"small\":200}"
    mut w := Wide {}
    println json.Unmarshal(wtext, w, e)
    println w.id
    println w.small
    println json.Marshal(w) == wtext

    mut m := HashMap {} as HashMap<str, int>
    println json.Unmarshal("{\"a\":1,\"b\":2}", m, e)
    println m.get("b")

    mut v := Vector {} as Vector<int>
    println json.Unmarshal("[3,4,5]", v, e)
    println v.len()
    println v.get(2)

    mut esc := ""
    println json.Unmarshal("\"a\\u0041b\\n\"", esc, e)
    println esc.len()
end
