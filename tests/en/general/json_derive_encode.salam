import encoding.json

enum Role:
    Guest
    Admin
end

struct Addr:
    pub city: str = ""
    pub zip: int = 0
end

struct Wide:
    pub id: i64 = 0
    pub big: u64 = 0
    pub ratio: f64 = 0.0
    pub letter: char = 'a'
    pub small: u8 = 0
end

struct User:
    pub name: str = ""
    pub age: int = 0
    pub active: bool = false
    pub role: Role = Role.Guest
    pub addr: Addr = Addr {}
    pub tags: Vector<str> = Vector {} as Vector<str>
    pub friends: Vector<Addr> = Vector {} as Vector<Addr>
    pub next: User* = null
end

func main:
    a := Addr { city = "tehran", zip = 11 }
    mut u := User { name = "ali", age = 30, active = true, role = Role.Admin, addr = a }
    u.tags.push("x")
    u.tags.push("y")
    f := Addr { city = "shiraz", zip = 22 }
    u.friends.push(f)
    println json.Marshal(u)

    w := Wide { id = 9007199254740993, big = 18446744073709551615, ratio = 0.125, letter = 'z', small = 200 as u8 }
    println json.Marshal(w)

    mut m := HashMap {} as HashMap<str, int>
    m.put("k", 7)
    println json.Marshal(m)

    mut v := Vector {} as Vector<int>
    v.push(1)
    v.push(2)
    println json.Marshal(v)

    println json.Marshal("quote \" tab \t done")
    println json.Marshal(42)
    println json.Marshal(true)
    println json.MarshalIndent(a, "  ")
end
