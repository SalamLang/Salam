// A package that defines its own helpers named like the derived codec's.
//
// The derived encoder and decoder call the json package's private helpers
// by bare name from inside the calling package, so a local function of the
// same name used to win the lookup. _db was the one that bit: a package
// with `func _db(c: Conn)` - the shape every db-backed worked example in
// tests/en/apps uses - derived a call passing a bool to it, and the C
// backend rejected the program with
//
//     cannot convert '_Bool' to 'struct Conn'
//
// The helpers are named __jd* now, so a package can keep using these names.

import encoding.json
import encoding.encerr

struct Conn:
    pub id: int = 0
end

struct Row:
    pub name: str = ""
    pub active: bool = false
    pub hits: i64 = 0
    pub ratio: f64 = 0.5
    pub tag: char = 'x'
end

func _db(c: Conn): int:
    ret c.id
end

func _dqs(s: str): str:
    ret "<" + s + ">"
end

func _di(n: i64): str:
    ret "#" + n
end

func _dadd(a: int, b: int): int:
    ret a + b
end

func main:
    mut r := Row {}
    r.name = "ali"
    r.active = true
    r.hits = 7
    println json.Marshal(r)

    mut back := Row {}
    mut err := encerr.NoError()
    if json.Unmarshal(json.Marshal(r), back, err):
        println back.name + " " + back.active + " " + back.hits
    else:
        println "decode failed"
    end

    println _db(Conn { id = 3 })
    println _dqs("q")
    println _di(9 as i64)
    println _dadd(1, 2)
end
