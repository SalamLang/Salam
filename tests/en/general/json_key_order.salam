import encoding.json
import encoding.value

func main throws:
    src := "{\"zeta\": 1, \"alpha\": {\"y\": 2, \"x\": 3}, \"mid\": [true, null], \"beta\": \"b\"}"
    v := try json.Decode(src)
    once := json.EncodeDefault(v)
    println once
    twice := json.EncodeDefault(try json.Decode(once))
    println once == twice
    mut o := value.NewValueObject()
    value.ObjectSet(o, "c", value.ValueInt(1))
    value.ObjectSet(o, "a", value.ValueInt(2))
    value.ObjectSet(o, "b", value.ValueInt(3))
    value.ObjectSet(o, "a", value.ValueInt(4))
    println json.EncodeDefault(o)
    _gone := value.ObjectDelete(o, "c")
    value.ObjectSet(o, "c", value.ValueInt(5))
    println json.EncodeDefault(o)
    mut inner := value.ObjectGet(v, "alpha")
    value.ObjectSet(inner, "w", value.ValueInt(9))
    println json.EncodeDefault(v)
    println value.ObjectKeys(value.ValueClone(v))
end
