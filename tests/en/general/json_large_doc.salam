import str
import encoding.json
import encoding.encerr
import encoding.value

func big_array(n: int): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, "[")
    repeat n in i:
        if i > 0: str.BufAppend(b, ", ")
        end
        str.BufAppend(b, "{\"id\": ")
        str.BufAppendInt(b, i as i64)
        str.BufAppend(b, ", \"name\": \"n\\\"")
        str.BufAppendInt(b, i as i64)
        str.BufAppend(b, "\", \"ok\": true, \"x\": null, \"f\": -1.5e2}")
    end
    str.BufAppend(b, "]")
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func big_object(n: int): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, "{")
    repeat n in i:
        if i > 0: str.BufAppend(b, ",")
        end
        str.BufAppend(b, "\"k")
        str.BufAppendInt(b, i as i64)
        str.BufAppend(b, "\": ")
        str.BufAppendInt(b, (i * 3) as i64)
    end
    str.BufAppend(b, "}")
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func main:
    arr := big_array(20000)
    println arr.len()
    println json.Valid(arr)
    items := json.Items(arr)
    println items.len()
    println items.get(19999)
    mut err := encerr.EncodingError {}
    v := json.Decode(arr, err)
    println encerr.IsError(err), value.ArrayLen(v)
    enc := json.EncodeDefault(v)
    mut err1 := encerr.EncodingError {}
    again := json.EncodeDefault(json.Decode(enc, err1))
    println enc.len(), again.len() == enc.len()
    ind := json.Indent(arr)
    println ind.len(), json.Minify(ind) == json.Minify(arr)

    obj := big_object(20000)
    keys := json.Keys(obj)
    println keys.len(), keys.get(0), keys.get(19999)
    println json.Get(obj, "k19999"), json.GetInt(obj, "k12345"), json.Has(obj, "k20000")

    mut err2 := encerr.EncodingError {}
    _bad := json.Decode("[1, 2, @]", err2)
    println encerr.IsError(err2)
    mut err3 := encerr.EncodingError {}
    _trail := json.Decode("{\"a\": 1} x", err3)
    println encerr.IsError(err3)
end
