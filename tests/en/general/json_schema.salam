// json.Schema: the JSON Schema of a type, derived by the compiler from the
// same declaration - the same `@json` markers, and the same `@doc` prose - as
// json.Marshal's encoder.

import encoding.json

@doc "how far along a todo is"
enum Status:
    Open
    Done
end

struct Tag:
    pub name: str = ""
end

@doc "one item on the list"
struct Todo:
    @doc "assigned when the todo is created," "and never reused"
    pub id: i64 = 0 as i64
    @doc "what to do"
    pub title: str = ""
    @json "is_done"
    pub done: bool = false
    pub state: Status = Status.Open
    pub tags: Vector<Tag> = Vector {}
    @json "" "omitempty"
    pub notes: str = ""
    @json "-"
    pub secret: int = 0
    pub score: f32 = 0.0
    pub ratio: f64 = 0.0
    pub count: u32 = 0 as u32
    @json "" "string"
    pub big: i64 = 0 as i64
end

// A node holding a Vector of itself: the reason schemas need $defs at all.
struct Node:
    pub label: str = ""
    pub kids: Vector<Node> = Vector {}
end

// A `@doc` on a field whose schema is a `$ref` cannot be written next to the
// ref - plenty of readers still follow OpenAPI 3.0's rule that a `$ref`
// object's siblings are ignored - so it goes in an allOf of one.
struct Household:
    @doc "who lives here"
    pub head: Tag = Tag {}
    pub other: Tag = Tag {}
end

struct Bag:
    pub counts: HashMap<str, int> = HashMap {} as HashMap<str, int>
    pub ids: HashMap<int, str> = HashMap {} as HashMap<int, str>
    pub grid: int[3] = [0, 0, 0]
    pub letter: char = 'x'
    pub flag: bool = false
end

func main:
    println json.Schema(Todo {})
    println json.Schema(Node {})
    println json.Schema(Bag {})
    println json.Schema(Household {})
    // A scalar and an array are documents of their own, with no $defs.
    println json.Schema(42)
    println json.Schema("")
    println json.Schema(Vector {} as Vector<Tag>)
    // The envelope the swagger package splits apart, before it is merged.
    println json.SchemaEnvelope(Tag {})
end
