import encoding.json

struct Login:
    pub host: str
    pub user: str = ""
    pub pass: str = ""
    pub token: str = ""
    pub cert: str = ""
    pub key: str = ""
    pub a: int = 0
    pub b: int = 0
    pub c: int = 0
    rule user needs pass
    rule allornone(cert, key)
    rule oneof(user, token)
    rule atmostone(a, b, c)
end

func show(text: str):
    mut r := Login { host = "", token = "" }
    try:
        json.Unmarshal(text, r)
        println "ok", r.host, r.user, r.token, r.a
    catch e:
        println "err", e.message
    end
end

func lenient(text: str):
    mut r := Login { host = "", token = "" }
    try:
        json.UnmarshalLenient(text, r)
        println "ok", r.host, r.user
    catch e:
        println "err", e.message
    end
end

func main:
    show(`{"host":"h","token":"t"}`)
    show(`{"host":"h","user":"u","pass":"p"}`)
    show(`{"host":"h","token":"t","cert":"c","key":"k","a":1}`)
    show(`{"host":"h"}`)
    show(`{"token":"t"}`)
    show(`{"host":"h","user":"u"}`)
    show(`{"host":"h","user":"u","pass":"p","token":"t"}`)
    show(`{"host":"h","token":"t","cert":"c"}`)
    show(`{"host":"h","token":"t","a":1,"b":2}`)
    lenient(`{"host":"h","user":"u"}`)
    println json.Schema(Login { host = "", token = "" })
end
