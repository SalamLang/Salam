// A container of structs as the top-level value, rather than a struct that
// happens to hold one. `json.Marshal(persons)` where persons is a
// Vector<Person> is the shape everybody reaches for first, and the derived
// codec has to bind T to the container itself: the encoder for Vector<Person>
// derives the encoder for Person on the way through, and the decoder has to
// build the elements it pushes out of nothing but their defaults.
//
// Also here because it is the mistake worth catching: json.Encode is the
// dynamic-tree encoder and takes a value.Value, so handing it a Vector<Person>
// is a type error, not a missing feature. Marshal is the typed one.

import encoding.json
import encoding.encerr

struct Person:
    pub name: str = ""
    pub age: int = 0
end

struct Team:
    pub title: str = ""
    pub members: Vector<Person> = Vector {} as Vector<Person>
end

func main:
    persons := Vector {} as Vector<Person>
    persons.push(Person { name = "Ali", age = 30 })
    persons.push(Person { name = "Kuri", age = 55 })

    // The derived printer, same pass, different output shape.
    println persons

    text := json.Marshal(persons)
    println text
    println json.MarshalIndent(persons, "  ")

    // Round trip: a Vector<Person> as the decode target, elements built from
    // Person's field defaults and pushed one at a time.
    mut back := Vector {} as Vector<Person>
    mut e := encerr.NoError()
    println json.Unmarshal(text, back, e)
    println back.len()
    println back.get(0).name
    println back.get(1).age
    println json.Marshal(back) == text

    // An empty container is a document too.
    empty := Vector {} as Vector<Person>
    println json.Marshal(empty)
    mut back_empty := Vector {} as Vector<Person>
    println json.Unmarshal("[]", back_empty, e)
    println back_empty.len()

    // Nesting: the element type is itself a container of structs.
    grid := Vector {} as Vector<Vector<Person>>
    grid.push(persons)
    grid.push(empty)
    gtext := json.Marshal(grid)
    println gtext
    mut back_grid := Vector {} as Vector<Vector<Person>>
    println json.Unmarshal(gtext, back_grid, e)
    println back_grid.get(0).get(1).name
    println back_grid.get(1).len()

    // A map keyed by string, one entry so the iteration order cannot vary.
    mut by_name := HashMap {} as HashMap<str, Person>
    by_name.put("lead", persons.get(0))
    mtext := json.Marshal(by_name)
    println mtext
    mut back_map := HashMap {} as HashMap<str, Person>
    println json.Unmarshal(mtext, back_map, e)
    println back_map.get("lead").age

    // The same Vector one level down, as a field.
    t := Team { title = "core", members = persons }
    ttext := json.Marshal(t)
    println ttext
    mut back_team := Team {}
    println json.Unmarshal(ttext, back_team, e)
    println back_team.members.get(1).name
    println json.Marshal(back_team) == ttext
end
