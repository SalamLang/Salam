// A generic instance as a field of a struct another package declares.
//
// A derived codec is installed in std/encoding/json's scope, so every type it
// names has to be spelled the way that scope can resolve. A generic instance
// is `Vector_i64` internally, and that name is defined only in the scope the
// instantiation happened in - here, jsonxpkg's. Spelling it by that name gave
// json's scope nothing to resolve, the encoder came back empty, and marshal
// failed with "field 'items' of type 'Vector_i64' has no JSON form" for a
// field that has an obvious one. Only main's own instances resolved, which is
// why the same struct worked until it was moved into a package.
//
// The spelling that travels is the `Vector<i64>` the programmer wrote. The
// derived printer took the same wrong turn, so `println` is checked here too.
package main

import encoding.json
import encoding.encerr
import jsonxpkg "_jsonxpkg.salam"

func main:
    p := jsonxpkg.Make()

    // The derived printer, which used to render the fields as <Vector_i64>.
    println p.items
    println p.sizes

    text := json.Marshal(p)
    println text

    // Round trip: the same instances as decode targets.
    mut back := jsonxpkg.Page {}
    mut e := encerr.NoError()
    println json.Unmarshal(text, back, e)
    println back.items.len(), back.items.get(1).body
    println back.sizes.get(0), back.tags.get("x"), back.count
    println json.Marshal(back) == text
end
