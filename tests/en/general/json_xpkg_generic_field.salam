package main

import encoding.json
import encoding.encerr
import jsonxpkg "_jsonxpkg.salam"

func main:
    p := jsonxpkg.Make()

    println p.items
    println p.sizes

    text := json.Marshal(p)
    println text

    mut back := jsonxpkg.Page {}
    mut e := encerr.NoError()
    println json.Unmarshal(text, back, e)
    println back.items.len(), back.items.get(1).body
    println back.sizes.get(0), back.tags.get("x"), back.count
    println json.Marshal(back) == text
end
