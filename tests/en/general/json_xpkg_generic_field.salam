package main

import encoding.json

include jsonxpkg "_jsonxpkg.salam"

func decodes<T>(text: str, out &: T): bool:
    try:
        json.Unmarshal(text, out)
    catch:
        ret false
    end
    ret true
end

func main:
    p := jsonxpkg.Make()

    println p.items
    println p.sizes

    text := json.Marshal(p)
    println text

    mut back := jsonxpkg.Page {}
    println decodes(text, back)
    println back.items.Len(), back.items.get(1).body
    println back.sizes.get(0), back.tags.get("x"), back.count
    println json.Marshal(back) == text
end
