struct Op:
    pub fn: func (int, int) int
    pub name: str
end

func make inc(): func (int) int: ret (n: int): ret n + 100 end end

func make adder(n: int): func (int) int: ret (x: int): ret x + n end end

func make counter(): func () int:
    mut c := 0
    ret (): c = c + 1 ret c end
end

pub func apply(f: func (int) int, x: int): int: ret f(x) end

func main:
    inc := (n: int): ret n + 1 end
    println inc(41)
    add := (a: int, b: int): ret a + b end
    println add(20, 22)
    println apply((n: int): ret n * 2 end, 21)
    o := Op { fn = (x: int, y: int): ret x * y end, name = "mul" }
    println o.fn(6, 7)
    println o.name
    println make inc()(5)
    add10 := make adder(10)
    println add10(5)
    base := 1000
    f := (y: int): ret y + base end
    println f(7)
    g := (a: int):
        b := 20
        h := (cc: int): ret a + b + cc end
        ret h(3)
    end
    println g(100)
    cnt := make counter()
    println cnt()
    println cnt()
end
