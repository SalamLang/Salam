func apply(f: func (int, int) int, x: int): int:
    ret f(x, 1)
end

func each_pair(f: func (int, int)):
    f(1, 2)
end

func main():
    println apply((a: int, _b: int): ret a * 3 end, 4)
    each_pair((_a: int, b: int):
        println b
    end)
end
