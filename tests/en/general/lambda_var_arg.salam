// A lambda bound to an immutable name and THEN passed on, rather than written
// inline at the call. The binding lowers to the closure environment pointer,
// which a callee takes as a plain `void*` and may write through, so it must
// not pick up a const qualifier from the name being immutable - that produced
// C which did not compile under -Werror.

func apply(f: func (int) int, v: int): int: ret f(v) end

func apply2(f: func (int, int) int, a: int, b: int): int: ret f(a, b) end

func call twice(f: func (int) int, v: int): int: ret f(f(v)) end

func make counter(): func () int:
    mut c := 0
    ret (): c = c + 1 ret c end
end

func main:
    double := (n: int) => n * 2
    square := (n: int) => n * n
    println apply(double, 21)
    println apply(square, 9)
    println double(square(3))

    mul := (a: int, b: int) => a * b
    println apply2(mul, 6, 7)
    println call twice(double, 5)

    // The captured state is written through the same pointer the parameter
    // receives, which is why the binding cannot be const.
    tick := make counter()
    println tick(), tick(), tick()
end
