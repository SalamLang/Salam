import str

layout Summary(names: Vector<str>, ages: HashMap<str, int>, owner: str):
    title = str.Upper(owner) + " has " + names.len() + " names"
    if names.is_empty():
        paragraph: content = "nobody yet" end
    else:
        paragraph: content = names.first() + " .. " + names.last() + " (second: " + names.get(1) + ", third: " + names[2] + ")" end
    end
    paragraph: content = "known: " + ages.size() + ", has Sara: " + ages.has("Sara") + ", Ali is " + ages.get("Ali") + ", Reza is " + ages.get_or("Reza", 0) end
    paragraph: content = owner.upper() + " " + owner.len() + " " + str.Trim("  x  ") end
    list:
        each name in names:
            item: content = name end
        end
    end
end

func main:
    mut names := Vector {} as Vector<str>
    mut ages := HashMap {} as HashMap<str, int>
    ages.put("Ali", 30)
    println Summary(names, ages, "mina")
    names.push("Ali")
    names.push("<Sara>")
    names.push("Reza")
    println Summary(names, ages, "mina")
    names.free()
    ages.free()
end
