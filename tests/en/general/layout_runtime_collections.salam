import str

page Summary(names: Vector<str>, ages: HashMap<str, int>, owner: str):
    title = str.Upper(owner) + " has " + names.Len() + " names"
    if names.IsEmpty():
        paragraph: content = "nobody yet" end
    else:
        paragraph: content = names.First() + " .. " + names.Last() + " (second: " + names.Get(1) + ", third: " + names[2] + ")" end
    end
    paragraph: content = "known: " + ages.Size() + ", has Sara: " + ages.Has("Sara") + ", Ali is " + ages.Get("Ali") + ", Reza is " + ages.GetOr("Reza", 0) end
    paragraph: content = owner.Upper() + " " + owner.Len() + " " + str.Trim("  x  ") end
    list:
        each name in names:
            item: content = name end
        end
    end
end

func main:
    mut names := Vector {} as Vector<str>
    mut ages := HashMap {} as HashMap<str, int>
    ages.Put("Ali", 30)
    println Summary(names, ages, "mina")
    names.Push("Ali")
    names.Push("<Sara>")
    names.Push("Reza")
    println Summary(names, ages, "mina")
    names.Free()
    ages.Free()
end
