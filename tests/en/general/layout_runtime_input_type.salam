import str

page Field(kind: str):
    input:
        type = kind
        name = "f"
    end
end

func show(html: str):
    p := str.IndexOf(html, "<input")
    q := str.IndexFrom(html, ">", p)
    println str.Substr(html, p, q - p + 1)
end

func main:
    show(Field("textarea"))
    show(Field("password"))
    show(Field("my-widget"))
end
