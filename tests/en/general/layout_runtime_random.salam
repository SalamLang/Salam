import rand
import str

layout Lucky(n: int, code: str):
    paragraph: content = "Your number: " + n end
    paragraph: content = "Code: " + code end
end

func main:
    n := rand.IntN(100) as int
    code := rand.Alnum(8)
    page := Lucky(n, code)
    println str.Contains(page, "<p>Your number: " + n + "</p>")
    println str.Contains(page, "<p>Code: " + code + "</p>")
    println n >= 0 and n < 100
    println code.len()
end
