import net.http
import net.router
import net.internal.rawsock
import rand
import str
import time
import net.tcp

mut web_port := 0

page Greeting(name: str, visit: int):
    title = "Hello " + name
    heading: size = 1 content = "Hello, " + name end
    paragraph: content = "Visit #" + visit end
end

func home_h(ctx: i64):
    name := http.Query(ctx, "name")
    http.Html(ctx, Greeting(name, 1 + rand.IntN(9) as int))
end

func run_web():
    mut r := router.NewRouter()
    router.Get(r, "/", home_h)
    mut s := http.NewServer(web_port)
    http.Use(s, r)
    http.Run(s)
end

func get_resp(path: str): str:
    mut sock := rawsock.Connect("127.0.0.1", web_port)
    mut tries := 0
    until not rawsock.Ok(sock) and tries < 200:
        time.Sleep(10)
        sock = rawsock.Connect("127.0.0.1", web_port)
        tries = tries + 1
    end
    if not rawsock.Ok(sock):
        ret ""
    end
    rawsock.Send(sock, "GET " + path + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
    resp := rawsock.Recv(sock, 8192)
    rawsock.Close(sock)
    ret resp
end

func main:
    web_port = tcp.FreePort()
    _t := spawn(run_web)
    r1 := get_resp("/?name=Ali")
    println str.Contains(r1, "text/html")
    println str.Contains(r1, "<title>Hello Ali</title>")
    println str.Contains(r1, "<h1>Hello, Ali</h1>")
    println str.Contains(r1, "<p>Visit #")
    r2 := get_resp("/?name=%3Cscript%3E")
    println str.Contains(r2, "&lt;script&gt;")
    println str.Contains(r2, "<script>")
end
