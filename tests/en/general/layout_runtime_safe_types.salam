import web

layout Card(home: web.Url, tint: web.Color, wide: web.Length, z: int):
    link: url = home content = "home" color = tint width = wide z index = z end
end

func main:
    mut ok := false
    u := web.ParseUrl("/a?x=1&y=2", ok)
    println ok
    c := web.ParseColor("#09f", ok)
    println ok
    println Card(u, c, web.Px(40), 3)
    _bad := web.ParseUrl("javascript:alert(1)", ok)
    println ok
    _bad2 := web.ParseUrl(" javascript:alert(1)", ok)
    println ok
    _bad3 := web.ParseColor("red;}body{", ok)
    println ok
    _bad4 := web.ParseLength("10px;x", ok)
    println ok
    l := web.ParseLength("1.5rem", ok)
    println ok
    println web.UrlText(u) + " " + l.text() + " " + web.Rgb(300, 0, -5).text()
end
