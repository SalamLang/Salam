struct Book:
    pub page_layout: str = ""
    pub layouts: int = 0
end

func layout_name(b: Book): str:
    ret b.page_layout + "/" + b.layouts
end

func main:
    b := Book { page_layout = "grid", layouts = 3 }
    my_layout := layout_name(b)
    println my_layout
end
