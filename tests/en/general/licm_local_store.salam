package main

import mem

noinline func opaque(p: f64*): f64*:
    ret p
end

noinline func opaque_i(v: int): int:
    ret v
end

func dot_rows(src: f64*, ct: f64*, out: f64*):
    mut tmp: f64[16]
    repeat 4 in y:
        repeat 4 in u:
            mut sum := 0.0
            repeat 4 in x:
                sum += src[y * 4 + x] * ct[x * 4 + u]
            end
            tmp[y * 4 + u] = sum
        end
    end
    repeat 16 in i:
        out[i] = tmp[i] + 1.0
    end
end

func aliased_local(n: int): f64:
    mut tmp: f64[8]
    p := opaque(tmp as f64*)
    mut s := 0.0
    repeat n in i:
        tmp[i] = (i as f64) + 1.0
        s += p[0] + p[7]
    end
    ret s
end

func maybe_null(p: f64*, n: int): f64:
    mut s := 0.0
    mut i := 0
    until i < n:
        s += p[1]
        i += 1
    end
    ret s
end

func guarded_first(p: f64*, k: int): f64:
    mut tmp: f64[4]
    mut i := 0
    until i < 4:
        if k == 0:
            break
        end
        tmp[i] = p[2] * (i as f64)
        i += 1
    end
    ret tmp[0] + tmp[1] + tmp[2] + tmp[3]
end

func writes_through_pointer(p: f64*, q: f64*): f64:
    mut s := 0.0
    repeat 4 in i:
        s += q[0]
        p[i] = s + 1.0
    end
    ret s
end

func bytes_to_local(row: u8*, n: int, ch: int): int:
    mut total := 0
    repeat n in x:
        mut px := [0, 0, 0, 0]
        repeat ch in c:
            px[c] = row[x * ch + c] as int
        end
        total = total * 7 + px[0] + px[1] * 2 + px[2] * 3 + px[3] * 5
    end
    ret total
end

func main:
    src := mem.Allocate(128 as u64) as f64*
    ct := mem.Allocate(128 as u64) as f64*
    out := mem.Allocate(128 as u64) as f64*
    repeat 16 in i:
        src[i] = ((i + 1) as f64) * 0.5
        ct[i] = 1.0 / ((i as f64) + 1.0)
    end
    dot_rows(src, ct, out)
    repeat 16 in j:
        println out[j]
    end
    println aliased_local(8)
    println maybe_null(null as f64*, 0)
    println maybe_null(src, 3)
    println guarded_first(null as f64*, opaque_i(0))
    println guarded_first(src, opaque_i(1))
    println writes_through_pointer(src, src)
    println writes_through_pointer(out, src)
    row := mem.Allocate(64 as u64) as u8*
    repeat 64 in k:
        row[k] = (k * 11 + 3) as u8
    end
    println bytes_to_local(row, 4, 3)
    println bytes_to_local(row, 4, 4)
    println bytes_to_local(row, 2, 12 / opaque_i(6))
end
