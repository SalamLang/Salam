func note(tag: str, v: bool): bool:
    print tag
    ret v
end

func mark(tag: str, v: int): int:
    print tag
    ret v
end

func main:
    print "["
    r1 := note("a", false) and note("b", true)
    println "]", r1
    print "["
    r2 := note("a", true) and note("b", false)
    println "]", r2
    print "["
    r3 := note("a", true) or note("b", false)
    println "]", r3
    print "["
    r4 := note("a", false) or note("b", true)
    println "]", r4

    print "["
    r5 := note("a", true) and note("b", true) and note("c", false) and note("d", true)
    println "]", r5
    print "["
    r6 := note("a", false) or note("b", false) or note("c", true) or note("d", true)
    println "]", r6

    d := 0
    if d != 0 and 10 / d > 0:
        println "unreachable"
    end
    println "guard held"

    print "["
    r7 := note("a", true) and note("b", false) or note("c", true)
    println "]", r7

    print "["
    r8 := note("a", true) and (note("b", false) or note("c", true))
    println "]", r8

    print "["
    r9 := note("a", false) and note("b", true) or note("c", false)
    println "]", r9

    println true and true, true and false, false and true, false and false
    println true or true, true or false, false or true, false or false
    println not true, not false, not not true

    println not (true and false) == (not true or not false)
    println not (true or false) == (not true and not false)

    println not true == false
    println not (true == false)
    println not false and false
    println not (false and false)

    println bxor(true, false), bxor(true, true), bxor(false, false)
    println implies(true, false), implies(false, true), implies(true, true)

    print "["
    b1 := (mark("p", 1) | mark("q", 0)) != 0
    println "]", b1
    print "["
    b2 := (mark("p", 0) & mark("q", 1)) != 0
    println "]", b2
    print "["
    b3 := (mark("p", 3) ^ mark("q", 3)) != 0
    println "]", b3

    mut i := 0
    mut steps := 0
    until i < 5 and steps < 3:
        steps = steps + 1
        i = i + 1
    end
    println i, steps

    mut hits := 0
    repeat 6 in n:
        if n > 0 and 12 % n == 0:
            hits = hits + 1
        end
    end
    println hits
end

func bxor(a: bool, b: bool): bool:
    ret (a or b) and not (a and b)
end

func implies(a: bool, b: bool): bool:
    ret not a or b
end
