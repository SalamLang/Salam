// The short-circuit connectives `&&` and `||`: which operand is
// evaluated, in what order, and which one is skipped. Every operand is
// a call that prints its own tag first, so the trace between the
// brackets is the evaluation order and the value after them is the
// result.

func note(tag: str, v: bool): bool:
    print tag
    ret v
end

func mark(tag: str, v: int): int:
    print tag
    ret v
end

func main:
    // && stops at the first false, || stops at the first true
    print "["
    r1 := note("a", false) && note("b", true)
    println "]", r1
    print "["
    r2 := note("a", true) && note("b", false)
    println "]", r2
    print "["
    r3 := note("a", true) || note("b", false)
    println "]", r3
    print "["
    r4 := note("a", false) || note("b", true)
    println "]", r4

    // chains stop as soon as the answer is known, left to right
    print "["
    r5 := note("a", true) && note("b", true) && note("c", false) && note("d", true)
    println "]", r5
    print "["
    r6 := note("a", false) || note("b", false) || note("c", true) || note("d", true)
    println "]", r6

    // a guarded division never evaluates the divide
    d := 0
    if d != 0 && 10 / d > 0:
        println "unreachable"
    end
    println "guard held"

    // && binds tighter than ||, so this is (T && F) || T
    print "["
    r7 := note("a", true) && note("b", false) || note("c", true)
    println "]", r7

    // ... and the parenthesised grouping evaluates differently
    print "["
    r8 := note("a", true) && (note("b", false) || note("c", true))
    println "]", r8

    // the same shape with the outcome flipped
    print "["
    r9 := note("a", false) && note("b", true) || note("c", false)
    println "]", r9

    // the full two-operand truth tables
    println true && true, true && false, false && true, false && false
    println true || true, true || false, false || true, false || false
    println !true, !false, !!true

    // De Morgan on booleans
    println !(true && false) == (!true || !false)
    println !(true || false) == (!true && !false)

    // ! binds tighter than every binary operator
    println !true == false
    println !(true == false)
    println !false && false
    println !(false && false)

    // xor and implication built out of the connectives
    println bxor(true, false), bxor(true, true), bxor(false, false)
    println implies(true, false), implies(false, true), implies(true, true)

    // the bitwise operators are not short-circuiting: both sides run
    print "["
    b1 := (mark("p", 1) | mark("q", 0)) != 0
    println "]", b1
    print "["
    b2 := (mark("p", 0) & mark("q", 1)) != 0
    println "]", b2
    print "["
    b3 := (mark("p", 3) ^ mark("q", 3)) != 0
    println "]", b3

    // short-circuiting inside a loop condition
    mut i := 0
    mut steps := 0
    until i < 5 && steps < 3:
        steps = steps + 1
        i = i + 1
    end
    println i, steps

    // and in an if/else chain
    mut hits := 0
    repeat 6 with n:
        if n > 0 && 12 % n == 0:
            hits = hits + 1
        end
    end
    println hits
end

func bxor(a: bool, b: bool): bool:
    ret (a || b) && !(a && b)
end

func implies(a: bool, b: bool): bool:
    ret !a || b
end
