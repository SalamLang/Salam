func check(a: bool, b: bool): str:
    if a and b:
        ret "both"
    else a or b:
        ret "one"
    end
    ret "none"
end

func main:
    println check(true, true)
    println check(true, false)
    println check(false, false)
    x := 5
    println not (x > 3)
    println not false and x == 5
    println x > 1 and x < 10 or x == 100
    if not SALAM_KERNEL:
        println "hosted"
    end
end
