// A struct or function name longer than the C port's old 96-byte type
// buffer used to be truncated on its way into the generated C.

struct AVeryLongStructNameThatGoesOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOn:
    pub x: int = 1
end

func averylongfunctionnamethatgoesonandonandonandonandonandonandonandonandonandonandonandonandonandonandonandonandonandon(
    a: AVeryLongStructNameThatGoesOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOn
): int:
    ret a.x
end

func main:
    v := AVeryLongStructNameThatGoesOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOnAndOn { x = 41 }
    println averylongfunctionnamethatgoesonandonandonandonandonandonandonandonandonandonandonandonandonandonandonandonandonandon(v) + 1
end
