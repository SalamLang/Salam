package main

noinline func bump(n &: int):
    n = n * 3 + 1
end

noinline func run_from(start_at: int): int:
    mut acc := 0
    mut i := 5
    if start_at > 100:
        i = 9
    end
    until i < 7:
        bump(acc)
        i = i + 1
    end
    ret acc
end

func main:
    mut a := 0
    mut i := 0
    until i < 1000:
        bump(a)
        a = a % 100003
        i = i + 1
    end
    println a
    mut b := 0
    mut k := 3
    until k < 3:
        bump(b)
        k = k + 1
    end
    println b
    mut c := 0
    mut m := 3
    until m < 4:
        bump(c)
        m = m + 1
    end
    println c
    mut d := 0
    mut q := 0 - 4
    until q <= 4:
        bump(d)
        q = q + 1
    end
    println d
    println run_from(1), run_from(200)
end
