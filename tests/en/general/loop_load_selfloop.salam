package main

noinline func drain(stk &: Vector<int>, stop: int): int:
    mut n := 0
    until true:
        w := stk.Pop()
        n = n * 3 + w
        if w == stop: break end
    end
    ret n
end

noinline func walk(stk &: Vector<int>, seen &: Vector<bool>): int:
    mut total := 0
    until stk.Len() > 0:
        top := stk.Last()
        if seen.Get(top):
            total += drain(stk, top)
        else:
            seen.Set(top, true)
            if top > 0:
                stk.Push(top - 1)
            end
        end
    end
    ret total
end

func main:
    mut stk := Vector {} as Vector<int>
    defer stk.Free()
    repeat 10 in i:
        stk.Push(i + 1)
    end
    println drain(stk, 4), stk.Len()
    mut seen := Vector {} as Vector<bool>
    defer seen.Free()
    repeat 8:
        seen.Push(false)
    end
    stk.Push(7)
    println walk(stk, seen), stk.Len()
end
