package main

noinline func drain(stk &: Vector<int>, stop: int): int:
    mut n := 0
    until true:
        w := stk.pop()
        n = n * 3 + w
        if w == stop: break end
    end
    ret n
end

noinline func walk(stk &: Vector<int>, seen &: Vector<bool>): int:
    mut total := 0
    until stk.len() > 0:
        top := stk.last()
        if seen.get(top):
            total = total + drain(stk, top)
        else:
            seen.set(top, true)
            if top > 0:
                stk.push(top - 1)
            end
        end
    end
    ret total
end

func main:
    mut stk := Vector {} as Vector<int>
    defer stk.free()
    repeat 10 in i:
        stk.push(i + 1)
    end
    println drain(stk, 4), stk.len()
    mut seen := Vector {} as Vector<bool>
    defer seen.free()
    repeat 8:
        seen.push(false)
    end
    stk.push(7)
    println walk(stk, seen), stk.len()
end
