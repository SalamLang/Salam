package main

import mem

noinline func opaque(v: int): int:
    ret v
end

func first_differs(c: int*, dc: int, ac: int): int:
    mut nz := 0
    mut n := 0
    until n < 16:
        q := n == 0 ? dc : ac
        v := c[n]
        lv := (v * (65536 / q)) >> 16
        c[n] = lv * q
        if lv != 0:
            nz++
        end
        n++
    end
    ret nz + n * 100
end

func quant(c: int*, first: int, dc: int, ac: int, sharp: bool): int:
    mut nz := 0
    mut n := first
    until n < 16:
        q := n == 0 ? dc : ac
        v := c[n]
        a := (v < 0 ? 0 - v : v) + (sharp ? (v * q) >> 11 : 0)
        mut lv := (a * ((1 << 17) / q) + 512) >> 17
        if lv > 2047:
            lv = 2047
        end
        c[n] = v < 0 ? 0 - lv : lv
        if lv != 0:
            nz++
        end
        n++
    end
    ret nz
end

func caller(c: int*, d: int*, q: int):
    mut t := 0
    t += quant(c, 0, q, q + 1, false)
    repeat 4 in i:
        t += quant(d, 1, q, q + i + 2, true)
    end
    println t
end

func not_first_negative(a: int): int:
    mut s := 0
    mut i := 3
    until i > 0 - 2:
        s = s * 2 + (i == 3 ? a : 1)
        i--
    end
    ret s
end

func zero_divisor_never_runs(n: int, d: int): int:
    mut s := 0
    mut i := 0
    until i < n:
        s += 100 / d
        i++
    end
    ret s
end

func zero_divisor_after_break(k: int, d: int): int:
    mut s := 0
    mut i := 0
    until i < 8:
        if k == 0:
            break
        end
        s += 100 / d + i
        i++
    end
    ret s
end

func zero_divisor_late(d: int): int:
    mut s := 0
    repeat 40 in i:
        if i > 50:
            s += 100 / d
        end
        s += i
    end
    ret s
end

func hoisted_rem(n: int, d: int): int:
    mut s := 0
    repeat n in i:
        s += (1000 % d) + (777 / d) + i
    end
    ret s
end

func start_nonzero(base: int): int:
    mut s := 0
    mut n := 2
    until n < 12:
        s += n == 2 ? base : (n == 0 ? 1000000 : n)
        n++
    end
    ret s
end

func not_equal_first(p: int*): int:
    mut prev := 0
    mut s := 0
    mut i := 0
    until i < 10:
        if i != 0:
            s += p[i] - prev
        end
        prev = p[i]
        i++
    end
    ret s + prev
end

func out_of_range_eq(k: int): int:
    mut s := 0
    repeat 20 in i:
        if i == 25:
            s += k
        end
        if i != 30:
            s += i
        end
    end
    ret s
end

func main:
    c := mem.Allocate(64 as u64) as int*
    d := mem.Allocate(64 as u64) as int*
    repeat 16 in i:
        c[i] = (i * 37) - 200
        d[i] = 300 - (i * i * 5)
    end
    println first_differs(c, opaque(3), opaque(5))
    repeat 16 in j:
        print c[j], " "
    end
    println ""
    caller(c, d, opaque(7))
    repeat 16 in j2:
        print c[j2], " ", d[j2], " "
    end
    println ""
    println not_first_negative(opaque(9))
    println zero_divisor_never_runs(opaque(0), opaque(0))
    println zero_divisor_after_break(opaque(0), opaque(0))
    println zero_divisor_after_break(opaque(1), opaque(3))
    println zero_divisor_late(opaque(0))
    println hoisted_rem(opaque(0), opaque(0))
    println hoisted_rem(opaque(5), opaque(7))
    println start_nonzero(opaque(50))
    println not_equal_first(c)
    println out_of_range_eq(opaque(4))
end
