noinline func add32(a: Vector<int>, b: Vector<int>, o &: Vector<int>, n: int):
    repeat n in i:
        o.Set(i, a.Get(i) * b.Get(i) + (a.Get(i) ^ 0x55) - (b.Get(i) >> 3))
    end
end

noinline func ops64(a: Vector<i64>, o &: Vector<i64>, n: int, s: int):
    repeat n in i:
        x := a.Get(i)
        o.Set(i, (x << 3) - (x >> 63) + (x >> (s as i64)) + ((x as u64) >> (7 as u64)) as i64)
    end
end

noinline func f32k(a: Vector<f32>, b: Vector<f32>, o &: Vector<f32>, k: f32, n: int):
    repeat n in i:
        o.Set(i, a.Get(i) * k + b.Get(i) / (2.0 as f32) - a.Get(i))
    end
end

noinline func f64k(a: Vector<f64>, o &: Vector<f64>, k: f64, n: int):
    repeat n in i:
        o.Set(i, a.Get(i) * k - 1.5)
    end
end

noinline func ops16(a: Vector<i16>, b: Vector<i16>, o &: Vector<i16>, n: int):
    repeat n in i:
        x := a.Get(i)
        y := b.Get(i)
        o.Set(i, x > y ? x * y : x - y)
    end
end

noinline func ops8(a: Vector<u8>, o &: Vector<u8>, c: u8, n: int):
    repeat n in i:
        x := a.Get(i)
        o.Set(i, x >= c ? x - c : x + c)
    end
end

noinline func sum32(a: Vector<int>, n: int): int:
    mut s := 0
    repeat n in i:
        s += a.Get(i)
    end
    ret s
end

noinline func sum64(a: Vector<i64>, n: int): i64:
    mut s := 0 as i64
    repeat n in i:
        s += a.Get(i) & (0xFFFFFF as i64)
    end
    ret s
end

noinline func mm32(a: Vector<int>, n: int): int:
    mut lo := 1000000000
    mut hi := 0 - 1000000000
    repeat n in i:
        x := a.Get(i)
        lo = x < lo ? x : lo
        hi = x > hi ? x : hi
    end
    ret hi * 3 - lo
end

noinline func umax(a: Vector<u32>, n: int): u32:
    mut m := 3 as u32
    repeat n in i:
        x := a.Get(i)
        if x > m:
            m = x
        end
    end
    ret m
end

noinline func ivdata(o &: Vector<int>, p &: Vector<i64>, n: int):
    repeat n in i:
        o.Set(i, i * 5 - 9)
        p.Set(i, (i as i64) * 3)
    end
end

noinline func pick(a: Vector<int>, o &: Vector<int>, f: bool, n: int):
    repeat n in i:
        o.Set(i, f ? a.Get(i) + 1 : a.Get(i) - 1)
    end
end

func main:
    each n in [0, 1, 3, 4, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100, 257]:
        mut a := Vector {} as Vector<int>
        mut b := Vector {} as Vector<int>
        mut o := Vector {} as Vector<int>
        mut l := Vector {} as Vector<i64>
        mut lo := Vector {} as Vector<i64>
        mut fa := Vector {} as Vector<f32>
        mut fb := Vector {} as Vector<f32>
        mut fo := Vector {} as Vector<f32>
        mut da := Vector {} as Vector<f64>
        mut dres := Vector {} as Vector<f64>
        mut ha := Vector {} as Vector<i16>
        mut hb := Vector {} as Vector<i16>
        mut ho := Vector {} as Vector<i16>
        mut ba := Vector {} as Vector<u8>
        mut bo := Vector {} as Vector<u8>
        mut u := Vector {} as Vector<u32>
        repeat n in i:
            a.Push((i * 7919) % 2003 - 1000)
            b.Push((i * 104729) % 977 + 1)
            o.Push(0)
            l.Push((i as i64) * (6364136223846793005 as i64) + (1442695040888963407 as i64))
            lo.Push(0 as i64)
            fa.Push(((i % 13) as f32) * (0.75 as f32))
            fb.Push(((i % 5) as f32) - (2.0 as f32))
            fo.Push(0.0 as f32)
            da.Push(((i % 11) as f64) * 0.125)
            dres.Push(0.0)
            ha.Push(((i * 977) % 65536 - 32768) as i16)
            hb.Push(((i * 331) % 65536 - 32768) as i16)
            ho.Push(0 as i16)
            ba.Push(((i * 37 + 11) % 256) as u8)
            bo.Push(0 as u8)
            u.Push(((i as i64) * (2654435761 as i64)) as u32)
        end
        mut h := 0 as i64
        add32(a, b, o, n)
        each x in o: h = h * 31 + (x as i64) end
        ops64(l, lo, n, n % 17)
        each y in lo: h = h * 17 + y end
        f32k(fa, fb, fo, 1.25 as f32, n)
        mut fs := 0.0
        each z in fo: fs = fs * 0.5 + (z as f64) end
        f64k(da, dres, 3.0, n)
        each w in dres: fs = fs * 0.5 + w end
        ops16(ha, hb, ho, n)
        each q in ho: h = h * 7 + (q as i64) end
        ops8(ba, bo, 100 as u8, n)
        each c in bo: h = h * 3 + (c as i64) end
        ivdata(o, lo, n)
        each x2 in o: h = h * 31 + (x2 as i64) end
        each y2 in lo: h = h * 5 + y2 end
        pick(a, o, n % 2 == 0, n)
        each x3 in o: h = h * 13 + (x3 as i64) end
        println n, h, fs
        println sum32(a, n), sum64(l, n), mm32(a, n), umax(u, n)
    end
end
