import mem

func at(p: u8*, k: int): u8*:
    ret ((p as i64) + (k as i64)) as u8*
end

noinline func b_pick(x: u8*, y: u8*, o: u8*, n: int, lim: int):
    repeat n in i:
        a := x[i] as int
        b := y[i] as int
        o[i] = ((a > lim ? b : a + 3) & 255) as u8
    end
end

noinline func b_minmax(x: u8*, y: u8*, lo: u8*, hi: u8*, n: int):
    repeat n in i:
        a := x[i]
        b := y[i]
        lo[i] = a < b ? a : b
        hi[i] = a > b ? a : b
    end
end

noinline func b_abs(x: u8*, y: u8*, o: u8*, n: int):
    repeat n in i:
        d := (x[i] as int) - (y[i] as int)
        o[i] = ((d < 0 ? 0 - d : d) & 255) as u8
    end
end

noinline func sb_minmax(x: i8*, y: i8*, lo: i8*, hi: i8*, n: int):
    repeat n in i:
        a := x[i]
        b := y[i]
        lo[i] = a < b ? a : b
        hi[i] = a >= b ? a : b
    end
end

noinline func sb_abs(x: i8*, o: i8*, n: int):
    repeat n in i:
        a := x[i]
        o[i] = a < (0 as i8) ? (0 as i8) - a : a
    end
end

noinline func sb_widen(x: i8*, y: u8*, o: u8*, n: int):
    repeat n in i:
        o[i] = (((x[i] as int) * 3 + (y[i] as int)) & 255) as u8
    end
end

noinline func w_minmax(a: Vector<i16>, b: Vector<i16>, lo &: Vector<i16>, hi &: Vector<i16>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        lo.set(i, x <= y ? x : y)
        hi.set(i, y < x ? x : y)
    end
end

noinline func uw_minmax(a: Vector<u16>, b: Vector<u16>, lo &: Vector<u16>, hi &: Vector<u16>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        lo.set(i, x < y ? x : y)
        hi.set(i, x > y ? x : y)
    end
end

noinline func w_pick(a: Vector<i16>, b: Vector<i16>, o &: Vector<i16>, n: int):
    repeat n in i:
        x := a.get(i) as int
        y := b.get(i) as int
        d := x - y
        o.set(i, (d < 0 ? (0 - d) + 1 : (x > 100 ? y : x)) as i16)
    end
end

noinline func w_abs(a: Vector<i16>, o &: Vector<i16>, n: int):
    repeat n in i:
        x := a.get(i)
        o.set(i, x < (0 as i16) ? (0 as i16) - x : x)
    end
end

noinline func i_minmax(a: Vector<int>, b: Vector<int>, lo &: Vector<int>, hi &: Vector<int>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        lo.set(i, x < y ? x : y)
        hi.set(i, x > y ? x : y)
    end
end

noinline func u_minmax(a: Vector<u32>, b: Vector<u32>, lo &: Vector<u32>, hi &: Vector<u32>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        lo.set(i, x < y ? x : y)
        hi.set(i, x >= y ? x : y)
    end
end

noinline func i_pick(a: Vector<int>, b: Vector<int>, o &: Vector<int>, n: int, k: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        o.set(i, x > y ? x * k - y : y * y + k)
    end
end

noinline func i_shared(a: Vector<int>, b: Vector<int>, o &: Vector<int>, q &: Vector<int>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        c := x + y > 50
        o.set(i, c ? x : y)
        q.set(i, c ? y - x : x ^ y)
    end
end

noinline func i_abs(a: Vector<int>, o &: Vector<int>, n: int):
    repeat n in i:
        x := a.get(i)
        o.set(i, x < 0 ? 0 - x : x)
    end
end

noinline func l_eq(a: Vector<i64>, b: Vector<i64>, o &: Vector<i64>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        o.set(i, x == y ? x + (7 as i64) : y - x)
    end
end

noinline func f_pick(a: Vector<f32>, b: Vector<f32>, o &: Vector<f32>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        o.set(i, x > y ? x - y : x + y)
    end
end

noinline func d_pick(a: Vector<f64>, b: Vector<f64>, o &: Vector<f64>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        o.set(i, x <= y ? x * y : y - x)
    end
end

noinline func wide_u8(p: u8*, o &: Vector<int>, n: int):
    repeat n in i:
        o.set(i, (p[i] as int) * 3 + 1)
    end
end

noinline func wide_i8(p: i8*, o &: Vector<int>, n: int):
    repeat n in i:
        o.set(i, (p[i] as int) * 5 - 2)
    end
end

noinline func wide_u16(a: Vector<u16>, o &: Vector<int>, n: int):
    repeat n in i:
        o.set(i, (a.get(i) as int) + 70000)
    end
end

noinline func wide_i16(a: Vector<i16>, o &: Vector<int>, n: int):
    repeat n in i:
        o.set(i, (a.get(i) as int) - 70000)
    end
end

noinline func narrow32(a: Vector<int>, o: u8*, n: int):
    repeat n in i:
        o[i] = (a.get(i) & 255) as u8
    end
end

noinline func narrow16(x: u8*, y: u8*, o: u8*, n: int):
    repeat n in i:
        o[i] = ((x[i] as int) * 2 - (y[i] as int) & 255) as u8
    end
end

noinline func spilled(a: Vector<int>, b: Vector<int>, o &: Vector<int>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        s0 := x + 1
        s1 := y + 2
        s2 := x ^ 3
        s3 := y ^ 4
        s4 := x - 5
        s5 := y - 6
        s6 := x * 7
        s7 := y * 9
        s8 := x | 10
        s9 := y | 11
        sa := x & 12
        sb := y & 13
        sc := x * 14
        sd := y * 15
        se := x - y
        sf := y - x
        p0 := s0 > s1 ? s2 : s3
        p1 := s4 > s5 ? s6 : s7
        p2 := s8 > s9 ? sa : sb
        p3 := sc > sd ? se : sf
        p4 := p0 > p1 ? s0 + s4 : s1 + s5
        p5 := p2 > p3 ? s8 + sc : s9 + sd
        o.set(i, p4 + p5 + s2 + s3 + s6 + s7 + sa + sb + se + sf)
    end
end

noinline func konst(a: Vector<int>, b: Vector<int>, o &: Vector<int>, n: int):
    repeat n in i:
        x := a.get(i)
        y := b.get(i)
        s0 := x + 1
        s1 := y + 2
        s2 := x ^ 3
        s3 := y ^ 4
        s4 := x - 5
        s5 := y - 6
        s6 := x * 7
        s7 := y * 9
        s8 := x | 10
        s9 := y | 11
        sa := x & 12
        sb := y & 13
        sc := x * 14
        sd := y * 15
        p0 := s0 > s1 ? 7777 : s3
        p1 := s4 > s5 ? 8888 : s7
        p2 := s8 > s9 ? 7777 : sb
        p3 := sc > sd ? 8888 : p0
        o.set(i, p0 + p1 + p2 + p3 + s2 + s3 + s6 + s7 + sa + sb + s0 + s1 + s4 + s5 + s8 + s9 + sc + sd)
    end
end

noinline func mm_red(a: Vector<int>, n: int): int:
    mut lo := 1000000000
    mut hi := 0 - 1000000000
    repeat n in i:
        x := a.get(i)
        lo = x < lo ? x : lo
        hi = x > hi ? x : hi
    end
    ret hi * 3 - lo
end

noinline func um_red(a: Vector<u32>, n: int): u32:
    mut lo := 4000000000 as u32
    mut hi := 3 as u32
    repeat n in i:
        x := a.get(i)
        if x < lo: lo = x end
        if x > hi: hi = x end
    end
    ret hi - lo
end

func hash(p: u8*, n: int): i64:
    mut h := 7 as i64
    repeat n in i:
        h = (h * (31 as i64) + (p[i] as i64)) % (1000000007 as i64)
    end
    ret h
end

func vhash(v: Vector<int>, n: int): i64:
    mut h := 11 as i64
    repeat n in i:
        h = (h * (131 as i64) + (v.get(i) as i64)) % (1000000007 as i64)
    end
    ret h
end

func uhash(v: Vector<u32>, n: int): i64:
    mut h := 17 as i64
    repeat n in i:
        h = (h * (139 as i64) + (v.get(i) as i64)) % (1000000007 as i64)
    end
    ret h
end

func whash(v: Vector<i16>, n: int): i64:
    mut h := 13 as i64
    repeat n in i:
        h = (h * (137 as i64) + (v.get(i) as i64)) % (1000000007 as i64)
    end
    ret h
end

func uwhash(v: Vector<u16>, n: int): i64:
    mut h := 19 as i64
    repeat n in i:
        h = (h * (149 as i64) + (v.get(i) as i64)) % (1000000007 as i64)
    end
    ret h
end

func lhash(v: Vector<i64>, n: int): i64:
    mut h := 23 as i64
    repeat n in i:
        h = (h * (151 as i64) + (v.get(i) % (1000003 as i64))) % (1000000007 as i64)
    end
    ret h
end

func fhash(v: Vector<f32>, n: int): i64:
    mut h := 29 as i64
    repeat n in i:
        h = (h * (157 as i64) + ((v.get(i) * (4 as f32)) as i64)) % (1000000007 as i64)
    end
    ret h
end

func dhash(v: Vector<f64>, n: int): i64:
    mut h := 31 as i64
    repeat n in i:
        h = (h * (163 as i64) + ((v.get(i) * (4 as f64)) as i64)) % (1000000007 as i64)
    end
    ret h
end

func fill(p: u8*, n: int, seed: int):
    repeat n in i:
        p[i] = ((i * 29 + seed * 17 + (i >> 2) * 3 + (i * i) % 11) % 256) as u8
    end
end

func val(i: int, s: int): int:
    ret ((i * 7919 + s * 104729) % 2003) * ((i & 3) == 1 ? 0 - 1 : 1) + (i % 5 == 0 ? 1000000000 * ((i >> 1) % 3 - 1) : 0)
end

func bytes(n: int, from: int):
    cap := n + 80
    x := mem.AllocateZeroed(cap as u64) as u8*
    y := mem.AllocateZeroed(cap as u64) as u8*
    o := mem.AllocateZeroed(cap as u64) as u8*
    q := mem.AllocateZeroed(cap as u64) as u8*
    fill(x, cap, 1)
    fill(y, cap, 2)
    mut line := "b n=" + n + " from=" + from
    each lim in [0, 100, 255]:
        b_pick(at(x, from), y, at(o, 1), n, lim)
        line = line + " p" + lim + "=" + hash(o, cap)
    end
    b_minmax(at(x, from), y, o, q, n)
    line = line + " mn=" + hash(o, cap) + " mx=" + hash(q, cap)
    b_abs(at(x, from), y, o, n)
    line = line + " ab=" + hash(o, cap)
    sb_minmax(at(x, from) as i8*, y as i8*, o as i8*, q as i8*, n)
    line = line + " smn=" + hash(o, cap) + " smx=" + hash(q, cap)
    sb_abs(at(x, from) as i8*, o as i8*, n)
    line = line + " sa=" + hash(o, cap)
    sb_widen(at(x, from) as i8*, y, at(o, 1), n)
    line = line + " sw=" + hash(o, cap)
    narrow16(at(x, from), y, at(o, 2), n)
    line = line + " nw=" + hash(o, cap)
    println line
    mem.Free(x as void*)
    mem.Free(y as void*)
    mem.Free(o as void*)
    mem.Free(q as void*)
end

func lanes(n: int):
    mut ia := Vector {} as Vector<int>
    mut ib := Vector {} as Vector<int>
    mut io := Vector {} as Vector<int>
    mut iq := Vector {} as Vector<int>
    mut ua := Vector {} as Vector<u32>
    mut ub := Vector {} as Vector<u32>
    mut uo := Vector {} as Vector<u32>
    mut uq := Vector {} as Vector<u32>
    mut wa := Vector {} as Vector<i16>
    mut wb := Vector {} as Vector<i16>
    mut wo := Vector {} as Vector<i16>
    mut wq := Vector {} as Vector<i16>
    mut za := Vector {} as Vector<u16>
    mut zb := Vector {} as Vector<u16>
    mut zo := Vector {} as Vector<u16>
    mut zq := Vector {} as Vector<u16>
    mut la := Vector {} as Vector<i64>
    mut lb := Vector {} as Vector<i64>
    mut lo := Vector {} as Vector<i64>
    mut fa := Vector {} as Vector<f32>
    mut fb := Vector {} as Vector<f32>
    mut fo := Vector {} as Vector<f32>
    mut da := Vector {} as Vector<f64>
    mut db := Vector {} as Vector<f64>
    mut dd := Vector {} as Vector<f64>
    repeat n + 1 in i:
        x := val(i, 1)
        y := val(i, 2)
        ia.push(x)
        ib.push(y)
        io.push(0)
        iq.push(0)
        ua.push(x as u32)
        ub.push(y as u32)
        uo.push(0 as u32)
        uq.push(0 as u32)
        wa.push(((x * 37) % 65536) as i16)
        wb.push(((y * 41) % 65536) as i16)
        wo.push(0 as i16)
        wq.push(0 as i16)
        za.push(((x * 37) % 65536) as u16)
        zb.push(((y * 41) % 65536) as u16)
        zo.push(0 as u16)
        zq.push(0 as u16)
        la.push((x as i64) * (65536 as i64) + ((i % 3) as i64))
        lb.push((i % 2 == 0 ? (x as i64) * (65536 as i64) + ((i % 3) as i64) : (y as i64)))
        lo.push(0 as i64)
        fa.push((x % 4001) as f32)
        fb.push((y % 4001) as f32)
        fo.push(0 as f32)
        da.push((x % 4001) as f64)
        db.push((y % 4001) as f64)
        dd.push(0 as f64)
    end
    mut line := "v n=" + n
    i_minmax(ia, ib, io, iq, n)
    line = line + " imn=" + vhash(io, n) + " imx=" + vhash(iq, n)
    u_minmax(ua, ub, uo, uq, n)
    line = line + " umn=" + uhash(uo, n) + " umx=" + uhash(uq, n)
    i_pick(ia, ib, io, n, 3)
    line = line + " ip=" + vhash(io, n)
    i_shared(ia, ib, io, iq, n)
    line = line + " is=" + vhash(io, n) + "," + vhash(iq, n)
    i_abs(ia, io, n)
    line = line + " ia=" + vhash(io, n)
    w_minmax(wa, wb, wo, wq, n)
    line = line + " wmn=" + whash(wo, n) + " wmx=" + whash(wq, n)
    uw_minmax(za, zb, zo, zq, n)
    line = line + " zmn=" + uwhash(zo, n) + " zmx=" + uwhash(zq, n)
    w_pick(wa, wb, wo, n)
    line = line + " wp=" + whash(wo, n)
    w_abs(wa, wo, n)
    line = line + " wa=" + whash(wo, n)
    l_eq(la, lb, lo, n)
    line = line + " le=" + lhash(lo, n)
    f_pick(fa, fb, fo, n)
    line = line + " fp=" + fhash(fo, n)
    d_pick(da, db, dd, n)
    line = line + " dp=" + dhash(dd, n)
    spilled(ia, ib, io, n)
    line = line + " sp=" + vhash(io, n)
    konst(ia, ib, io, n)
    line = line + " kp=" + vhash(io, n)
    wide_u16(za, io, n)
    line = line + " wz=" + vhash(io, n)
    wide_i16(wa, io, n)
    line = line + " ws=" + vhash(io, n)
    line = line + " mr=" + mm_red(ia, n) + " ur=" + um_red(ua, n)
    println line
    cap := n + 40
    p := mem.AllocateZeroed(cap as u64) as u8*
    fill(p, cap, 3)
    wide_u8(at(p, 1), io, n)
    line = "w n=" + n + " u8=" + vhash(io, n)
    wide_i8(at(p, 2) as i8*, io, n)
    line = line + " i8=" + vhash(io, n)
    i_pick(ia, ib, io, n, 11)
    narrow32(io, at(p, 3), n)
    line = line + " n32=" + hash(p, cap)
    println line
    mem.Free(p as void*)
    ia.free()
    ib.free()
    io.free()
    iq.free()
    ua.free()
    ub.free()
    uo.free()
    uq.free()
    wa.free()
    wb.free()
    wo.free()
    wq.free()
    za.free()
    zb.free()
    zo.free()
    zq.free()
    la.free()
    lb.free()
    lo.free()
    fa.free()
    fb.free()
    fo.free()
    da.free()
    db.free()
    dd.free()
end

func main:
    each n in [0, 1, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 47, 63, 64, 65, 129, 300]:
        each from in [0, 1, 5]:
            bytes(n, from)
        end
        lanes(n)
    end
end
