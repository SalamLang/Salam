/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */


func run(n: int, seed: int):
    mut a := Vector {} as Vector<u8>
    mut b := Vector {} as Vector<u8>
    mut o := Vector {} as Vector<u8>
    mut sa := Vector {} as Vector<i8>
    mut so := Vector {} as Vector<i8>
    repeat n in i:
        a.Push(((i * 37 + seed) % 256) as u8)
        b.Push(((i * 101 + 3) % 256) as u8)
        o.Push(0 as u8)
        sa.Push((((i * 53 + seed) % 256) - 128) as i8)
        so.Push(0 as i8)
    end
    lim := (100 + seed) as u8
    c := (7 + seed) as u8
    mut h := 0
    repeat n in i1:
        o.Set(i1, a.Get(i1) + b.Get(i1))
    end
    repeat n in k1: h = h * 31 + (o.Get(k1) as int) end
    repeat n in i2:
        o.Set(i2, (a.Get(i2) ^ b.Get(i2)) & (0x5A as u8))
    end
    repeat n in k2: h = h * 31 + (o.Get(k2) as int) end
    repeat n in i3:
        x := a.Get(i3)
        o.Set(i3, x > lim ? lim : x)
    end
    repeat n in k3: h = h * 31 + (o.Get(k3) as int) end
    repeat n in i4:
        o.Set(i4, a.Get(i4) == c ? (1 as u8) : b.Get(i4))
    end
    repeat n in k4: h = h * 31 + (o.Get(k4) as int) end
    repeat n in i5:
        o.Set(i5, a.Get(i5) <= b.Get(i5) ? a.Get(i5) - b.Get(i5) : b.Get(i5))
    end
    repeat n in k5: h = h * 31 + (o.Get(k5) as int) end
    repeat n in i6:
        x2 := sa.Get(i6)
        so.Set(i6, x2 < (0 as i8) ? (0 as i8) - x2 : x2)
    end
    repeat n in k6: h = h * 31 + (so.Get(k6) as int) end
    repeat n in i7:
        so.Set(i7, sa.Get(i7) >= (10 as i8) ? sa.Get(i7) : (10 as i8))
    end
    repeat n in k7: h = h * 31 + (so.Get(k7) as int) end
    println n, h
end

func main:
    each n in [0, 1, 7, 15, 16, 17, 31, 32, 33, 64, 100, 1000]:
        run(n, n % 3)
    end
end
