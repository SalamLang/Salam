noinline func zeros(a: Vector<i8>, n: int): i64:
    mut count := 0 as i64
    mut k := 0
    until k < n:
        if a.Get(k) == 0:
            count++
        end
        k++
    end
    ret count
end

noinline func notsev(a: Vector<u8>, n: int): int:
    mut c := 3
    repeat n in i:
        if a.Get(i) != (7 as u8):
            c++
        end
    end
    ret c
end

noinline func big(a: Vector<u8>, n: int): i64:
    mut c := 0 as i64
    repeat n in i:
        if a.Get(i) > (200 as u8):
            c++
        end
    end
    ret c
end

func main:
    each n in [0, 1, 15, 16, 17, 33, 1000, 70000]:
        mut a := Vector {} as Vector<i8>
        mut b := Vector {} as Vector<u8>
        repeat n in i:
            a.Push((i % 3) as i8)
            b.Push(((i * 37) % 256) as u8)
        end
        println n, zeros(a, n), notsev(b, n), big(b, n)
    end
end
