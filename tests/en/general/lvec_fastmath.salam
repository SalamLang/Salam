noinline func sum64(a: Vector<f64>, n: int): f64:
    mut s := 0.0
    repeat n in i:
        s += a.get(i)
    end
    ret s
end

noinline func dot32(a: Vector<f32>, b: Vector<f32>, n: int): f32:
    mut s := 0.0 as f32
    repeat n in i:
        s += a.get(i) * b.get(i)
    end
    ret s
end

func main:
    each n in [0, 1, 2, 3, 4, 5, 7, 8, 9, 100, 1001]:
        mut a := Vector {} as Vector<f64>
        mut b := Vector {} as Vector<f32>
        repeat n in i:
            a.push(((i % 8) as f64) * 0.25)
            b.push(((i % 4) as f32) * (0.5 as f32))
        end
        println n, sum64(a, n), dot32(b, b, n)
    end
end
