noinline func addb(a: Vector<u8>, b: Vector<u8>, o &: Vector<u8>, n: int):
    repeat n in i:
        o.set(i, a.get(i) + b.get(i))
    end
end

noinline func clampb(a: Vector<u8>, o &: Vector<u8>, n: int, lim: u8):
    repeat n in i:
        x := a.get(i)
        o.set(i, x > lim ? lim : x)
    end
end

noinline func scale(a: Vector<int>, o &: Vector<int>, n: int, k: int):
    repeat n in i:
        o.set(i, a.get(i) * k + 1)
    end
end

noinline func inplace(o &: Vector<u8>, n: int):
    repeat n in i:
        o.set(i, o.get(i) ^ (0x33 as u8))
    end
end

func main:
    each n in [0, 1, 15, 16, 17, 100, 1000]:
        mut a := Vector {} as Vector<u8>
        mut b := Vector {} as Vector<u8>
        mut o := Vector {} as Vector<u8>
        mut ia := Vector {} as Vector<int>
        mut io := Vector {} as Vector<int>
        repeat n in i:
            a.push((i * 7) as u8)
            b.push((i * 13) as u8)
            o.push(0 as u8)
            ia.push(i * 3 - 7)
            io.push(0)
        end
        addb(a, b, o, n)
        mut h := 0
        repeat n in k: h = h * 31 + (o.get(k) as int) end
        clampb(a, o, n, 100 as u8)
        repeat n in k2: h = h * 31 + (o.get(k2) as int) end
        scale(ia, io, n, 5)
        repeat n in k3: h = h * 31 + io.get(k3) end
        inplace(o, n)
        repeat n in k4: h = h * 31 + (o.get(k4) as int) end
        addb(o, o, o, n)
        repeat n in k5: h = h * 31 + (o.get(k5) as int) end
        println n, h
    end
end
