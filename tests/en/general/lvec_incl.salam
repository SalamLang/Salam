noinline func cp(a: Vector<int>, o &: Vector<int>, lo: int, hi: int): int:
    mut j := lo
    until j <= hi:
        o.set(j, a.get(j) * 3 + 1)
        j = j + 1
    end
    ret j
end

noinline func sm(a: Vector<i64>, hi: int): i64:
    mut s := 0 as i64
    mut j := 0
    until j <= hi:
        s = s + a.get(j)
        j = j + 1
    end
    ret s + (j as i64) * (1000 as i64)
end

func main:
    each hi in [0 - 1, 0, 1, 2, 3, 4, 5, 7, 8, 9, 16, 17, 99]:
        mut a := Vector {} as Vector<int>
        mut o := Vector {} as Vector<int>
        mut l := Vector {} as Vector<i64>
        repeat 110 in i:
            a.push(i * 7 - 50)
            o.push(0)
            l.push((i as i64) * (12345 as i64))
        end
        e := cp(a, o, 0, hi)
        e2 := cp(a, o, 3, hi)
        mut h := 0
        repeat 110 in k:
            h = h * 31 + o.get(k)
        end
        println hi, e, e2, h, sm(l, hi)
    end
end
