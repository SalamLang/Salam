noinline func fill64(o &: Vector<i64>, n: int):
    repeat n in i:
        o.set(i, i as i64)
    end
end

noinline func fill32(o &: Vector<int>, n: int):
    repeat n in i:
        o.set(i, i * 3 + 7)
    end
end

noinline func mix(a: Vector<int>, o &: Vector<int>, n: int):
    repeat n in i:
        o.set(i, a.get(i) ^ i)
    end
end

noinline func from(o &: Vector<i64>, s: int, n: int):
    mut j := s
    until j < n:
        o.set(j, (j as i64) * 2)
        j = j + 1
    end
end

func main:
    each n in [0, 1, 2, 3, 4, 5, 9, 16, 17, 100]:
        mut a := Vector {} as Vector<i64>
        mut b := Vector {} as Vector<int>
        mut c := Vector {} as Vector<int>
        repeat n in i:
            a.push(0 as i64)
            b.push(0)
            c.push(i * 13)
        end
        fill64(a, n)
        fill32(b, n)
        mix(c, b, n)
        from(a, n / 3, n)
        mut h := 0 as i64
        each x in a: h = h * 31 + x end
        each y in b: h = h * 17 + (y as i64) end
        println n, h
    end
end
