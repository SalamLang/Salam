func run(n: int):
    mut a := Vector {} as Vector<int>
    mut b := Vector {} as Vector<int>
    mut c := Vector {} as Vector<int>
    repeat n in i:
        a.push(i * 7919 - 40000)
        b.push((i * 31) % 1001 - 500)
        c.push(0)
    end
    repeat n in j:
        c.set(j, a.get(j) * b.get(j))
    end
    mut h := 0
    repeat n in k:
        h = h * 31 + c.get(k)
    end
    repeat n in j2:
        c.set(j2, a.get(j2) * 3 + b.get(j2) * (0 - 7))
    end
    repeat n in k2:
        h = h * 31 + c.get(k2)
    end
    mut s := 0
    repeat n in k3:
        s += a.get(k3) * b.get(k3)
    end
    println n, h, s
end

func main:
    each n in [0, 1, 3, 4, 5, 8, 9, 15, 16, 17, 33, 100, 1001]:
        run(n)
    end
end
