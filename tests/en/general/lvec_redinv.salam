package main

noinline func cost(res: Vector<i64>, n: int, p: int, k: i64): i64:
    mut total := 0 as i64
    mut i := 0
    until i < n:
        total += (res.get(i) >> p) + 1 + k
        i += 1
    end
    ret total
end

noinline func cost32(res: Vector<int>, n: int, c: int): int:
    mut total := 7
    mut i := 3
    until i < n:
        total += res.get(i) + c
        i += 1
    end
    ret total
end

func main:
    mut v := Vector {} as Vector<i64>
    mut w := Vector {} as Vector<int>
    repeat 37 in i:
        v.push((i * 977 - 4000) as i64)
        w.push(i * 31 - 500)
    end
    mut h := 0 as i64
    repeat 37 in n:
        h = h * 31 + cost(v, n, n % 5, (n as i64) - 9) + (cost32(w, n, n - 2) as i64)
        h = h % 1000000007
    end
    println h
    v.free()
    w.free()
end
