 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

noinline func s8u(a: Vector<u8>, n: int): int:
    mut s := 0
    repeat n in i:
        s += a.get(i) as int
    end
    ret s
end

noinline func s8s(a: Vector<i8>, n: int): int:
    mut s := 0
    repeat n in i:
        s += a.get(i) as int
    end
    ret s
end

noinline func s16s(a: Vector<i16>, n: int): int:
    mut s := 0
    repeat n in i:
        s += a.get(i) as int
    end
    ret s
end

noinline func s16u(a: Vector<u16>, n: int): int:
    mut s := 0
    repeat n in i:
        s += a.get(i) as int
    end
    ret s
end

noinline func widen(a: Vector<i16>, o &: Vector<int>, n: int):
    repeat n in i:
        o.set(i, (a.get(i) as int) * 3 - 7)
    end
end

noinline func copy16(a: Vector<i16>, o &: Vector<i16>, n: int):
    repeat n in i:
        o.set(i, a.get(i))
    end
end

noinline func mx1(a: Vector<int>, n: int): int:
    mut m := 0 - 1000000000
    repeat n in i:
        if a.get(i) > m:
            m = a.get(i)
        end
    end
    ret m
end

noinline func mn1(a: Vector<int>, n: int): int:
    mut m := 1000000000
    repeat n in i:
        x := a.get(i)
        m = x < m ? x : m
    end
    ret m
end

noinline func mx2(a: Vector<int>, n: int, s: int): int:
    mut m := s
    repeat n in i:
        x := a.get(i)
        m = m >= x ? m : x
    end
    ret m
end

noinline func mn2(a: Vector<int>, n: int): int:
    mut m := 7
    repeat n in i:
        x := a.get(i)
        m = m <= x ? m : x
    end
    ret m
end

noinline func umx(a: Vector<u32>, n: int): u32:
    mut m := 5 as u32
    repeat n in i:
        x := a.get(i)
        if x > m:
            m = x
        end
    end
    ret m
end

noinline func umn(a: Vector<u32>, n: int): u32:
    mut m := 0xFFFFFFF0 as u32
    repeat n in i:
        x := a.get(i)
        m = x < m ? x : m
    end
    ret m
end

noinline func both(a: Vector<int>, n: int): int:
    mut lo := 1000000000
    mut hi := 0 - 1000000000
    mut s := 0
    repeat n in i:
        x := a.get(i)
        lo = x < lo ? x : lo
        hi = x > hi ? x : hi
        s += x
    end
    ret hi - lo + s
end

noinline func lmx(a: Vector<i64>, n: int): i64:
    mut m := 0 - 99 as i64
    repeat n in i:
        x := a.get(i)
        m = x > m ? x : m
    end
    ret m
end

func main:
    each n in [0, 1, 3, 4, 5, 15, 16, 17, 1001]:
        mut a8 := Vector {} as Vector<u8>
        mut b8 := Vector {} as Vector<i8>
        mut c16 := Vector {} as Vector<i16>
        mut d16 := Vector {} as Vector<u16>
        mut o := Vector {} as Vector<int>
        mut o2 := Vector {} as Vector<i16>
        mut a := Vector {} as Vector<int>
        mut u := Vector {} as Vector<u32>
        mut l := Vector {} as Vector<i64>
        repeat n in i:
            a8.push((i * 37 + 200) as u8)
            b8.push(((i * 53) % 256 - 128) as i8)
            c16.push(((i * 977) % 65536 - 32768) as i16)
            d16.push(((i * 1231) % 65536) as u16)
            o.push(0)
            o2.push(0 as i16)
            a.push((i * 7919) % 2003 - 1000)
            u.push(((i as i64) * (2654435761 as i64)) as u32)
            l.push((i as i64) * (6364136223846793005 as i64))
        end
        widen(c16, o, n)
        copy16(c16, o2, n)
        mut h := 0
        repeat n in k:
            h = h * 31 + o.get(k) + (o2.get(k) as int)
        end
        println n, s8u(a8, n), s8s(b8, n), s16s(c16, n), s16u(d16, n), h
        println mx1(a, n), mn1(a, n), mx2(a, n, 50), mn2(a, n), umx(u, n), umn(u, n), both(a, n), lmx(l, n)
    end
end
