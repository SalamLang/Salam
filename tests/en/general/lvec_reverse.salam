package main

noinline func rev64(arr: Vector<i64>, lo_in: int, hi_in: int):
    mut lo := lo_in
    mut hi := hi_in
    until lo < hi:
        tmp := arr.get(lo)
        arr.set(lo, arr.get(hi))
        arr.set(hi, tmp)
        lo = lo + 1
        hi = hi - 1
    end
end

noinline func rev32(arr: Vector<int>, lo_in: int, hi_in: int):
    mut lo := lo_in
    mut hi := hi_in
    until lo < hi:
        tmp := arr.get(lo)
        arr.set(lo, arr.get(hi))
        arr.set(hi, tmp)
        lo = lo + 1
        hi = hi - 1
    end
end

noinline func revf(arr: Vector<f64>, lo_in: int, hi_in: int):
    mut lo := lo_in
    mut hi := hi_in
    until lo < hi:
        tmp := arr.get(lo)
        arr.set(lo, arr.get(hi))
        arr.set(hi, tmp)
        lo = lo + 1
        hi = hi - 1
    end
end

noinline func mirror(dst: Vector<int>, src: Vector<int>, n: int):
    mut i := 0
    mut j := n - 1
    until i < j:
        dst.set(i, src.get(j) * 3)
        i = i + 1
        j = j - 1
    end
end

func main:
    mut h := 0 as i64
    repeat 23 in n:
        repeat 3 in off:
            mut a := Vector {} as Vector<i64>
            mut b := Vector {} as Vector<int>
            mut c := Vector {} as Vector<f64>
            mut d := Vector {} as Vector<int>
            repeat n + 4 in i:
                a.push((i * 7 + 1) as i64)
                b.push(i * 5 - 9)
                c.push((i as f64) * 0.5)
                d.push(0)
            end
            rev64(a, off, n + off - 1)
            rev32(b, off, n + off - 1)
            revf(c, off, n + off - 1)
            mirror(d, b, n + off)
            repeat n + 4 in i:
                h = (h * 31 + a.get(i) + (b.get(i) as i64) * 7 + ((c.get(i) * 2.0) as i64) * 11 + (d.get(i) as i64) * 13) % 1000000007
            end
            a.free()
            b.free()
            c.free()
            d.free()
        end
    end
    println h
end
