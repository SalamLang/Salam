noinline func z64(a: Vector<i64>, n: int): i64:
    mut s := 0 as i64
    repeat n in i:
        v := a.get(i)
        s += (v << 1) ^ (v >> 63)
    end
    ret s
end

noinline func rc(a: Vector<i64>, n: int, p: int): i64:
    mut t := 0 as i64
    repeat n in i:
        t += (a.get(i) >> (p as i64)) + 1
    end
    ret t
end

noinline func sh32(a: Vector<int>, o &: Vector<int>, n: int, k: int):
    repeat n in i:
        o.set(i, (a.get(i) << k) + (a.get(i) >> k))
    end
end

noinline func ush64(a: Vector<u64>, o &: Vector<u64>, n: int, k: u64):
    repeat n in i:
        o.set(i, (a.get(i) >> k) ^ (a.get(i) << (k + (1 as u64))))
    end
end

noinline func sh16(a: Vector<i16>, o &: Vector<i16>, n: int, k: i16):
    repeat n in i:
        o.set(i, (a.get(i) >> k) - (a.get(i) << k))
    end
end

noinline func ash(a: Vector<i64>, o &: Vector<i64>, n: int):
    repeat n in i:
        o.set(i, (a.get(i) >> 5) + (a.get(i) >> 40))
    end
end

func main:
    each n in [0, 1, 3, 4, 5, 17, 100]:
        mut a := Vector {} as Vector<i64>
        mut b := Vector {} as Vector<int>
        mut c := Vector {} as Vector<u64>
        mut d := Vector {} as Vector<i16>
        mut o := Vector {} as Vector<i64>
        mut ob := Vector {} as Vector<int>
        mut oc := Vector {} as Vector<u64>
        mut od := Vector {} as Vector<i16>
        repeat n in i:
            x := (i as i64) * (6364136223846793005 as i64) + (1442695040888963407 as i64)
            a.push(x)
            b.push((x >> 20) as int)
            c.push(x as u64)
            d.push((x >> 40) as i16)
            o.push(0 as i64)
            ob.push(0)
            oc.push(0 as u64)
            od.push(0 as i16)
        end
        mut h := z64(a, n)
        each p in [0, 1, 7, 31, 63]:
            h = h * 31 + rc(a, n, p)
            sh32(b, ob, n, p)
            each v in ob: h = h * 7 + (v as i64) end
            ush64(c, oc, n, (p % 62) as u64)
            each v2 in oc: h = h * 5 + (v2 as i64) end
            sh16(d, od, n, (p % 15) as i16)
            each v3 in od: h = h * 3 + (v3 as i64) end
        end
        ash(a, o, n)
        each v4 in o: h = h * 11 + v4 end
        println n, h
    end
end
