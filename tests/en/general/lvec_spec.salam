noinline func csum(m: Vector<int>, a: Vector<int>): int:
    mut s := 0
    repeat a.len() in i:
        if m.get(i) > 0:
            s += a.get(i)
        end
    end
    ret s
end

noinline func csum64(m: Vector<i64>, a: Vector<i64>): i64:
    mut s := 7 as i64
    repeat a.len() in i:
        if m.get(i) <= (0 as i64):
            s += a.get(i) * (3 as i64)
        end
    end
    ret s
end

noinline func upd(a &: Vector<int>, b: Vector<int>, n: int):
    repeat n in i:
        x := b.get(i)
        mut y := 0
        if x > 3:
            y = a.get(i)
        end
        a.set(i, y + x)
    end
end

noinline func pickf(m: Vector<int>, a: Vector<f32>, o &: Vector<f32>):
    repeat a.len() in i:
        mut v := 1.5 as f32
        if m.get(i) != 0:
            v = a.get(i) * (2.0 as f32)
        end
        o.set(i, v)
    end
end

noinline func both(m: Vector<int>, a: Vector<int>, o &: Vector<int>):
    repeat a.len() in i:
        mut v := 0
        if m.get(i) > 1:
            v = a.get(i) * 3
        else:
            v = 5 - a.get(i)
        end
        o.set(i, v)
    end
end

noinline func arr(m: Vector<int>): int:
    mut t: int[64]
    repeat 64 in j:
        t[j] = j * j - 100
    end
    mut s := 0
    repeat 64 in i:
        mut v := 1
        if m.get(i) > 0:
            v = t[i]
        end
        s += v
    end
    ret s
end

noinline func unsafe_len(m: Vector<int>, e: Vector<int>): int:
    mut s := 0
    repeat m.len() in i:
        if m.get(i) > 1000000:
            s += e.get(i)
        end
    end
    ret s
end

noinline func unsafe_store(m: Vector<int>, o &: Vector<int>, n: int):
    repeat n in i:
        if m.get(i) > 0:
            o.set(i, m.get(i) + 1)
        end
    end
end

func main:
    each n in [0, 1, 3, 4, 7, 8, 9, 15, 16, 17, 31, 33, 64, 100, 257]:
        mut m := Vector {} as Vector<int>
        mut a := Vector {} as Vector<int>
        mut o := Vector {} as Vector<int>
        mut ml := Vector {} as Vector<i64>
        mut al := Vector {} as Vector<i64>
        mut fa := Vector {} as Vector<f32>
        mut fo := Vector {} as Vector<f32>
        e := Vector {} as Vector<int>
        repeat n in i:
            m.push((i * 7919) % 11 - 4)
            a.push((i * 104729) % 977 - 300)
            o.push(i)
            ml.push(((i * 31) % 9 - 4) as i64)
            al.push((i as i64) * (6364136223846793005 as i64))
            fa.push(((i % 13) as f32) * (0.75 as f32))
            fo.push(0.0 as f32)
        end
        mut h := csum(m, a) as i64
        h = h * 31 + csum64(ml, al)
        upd(o, m, n)
        each x in o: h = h * 7 + (x as i64) end
        pickf(m, fa, fo)
        mut fs := 0.0
        each z in fo: fs = fs * 0.5 + (z as f64) end
        both(m, a, o)
        each y in o: h = h * 5 + (y as i64) end
        if n >= 64:
            h = h * 3 + (arr(m) as i64)
        end
        h = h * 3 + (unsafe_len(m, e) as i64)
        unsafe_store(m, o, n)
        each w in o: h = h * 11 + (w as i64) end
        println n, h, fs
    end
end
