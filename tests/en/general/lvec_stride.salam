import mem

struct P:
    pub x: f32
    pub y: f32
end

struct C:
    pub re: f64
    pub im: f64
end

noinline func mag(a: Vector<f32>, o &: Vector<f32>, n: int):
    repeat n in i:
        re := a.get(2 * i)
        im := a.get(2 * i + 1)
        o.set(i, re * re + im * im)
    end
end

noinline func evens(a: Vector<int>, o &: Vector<int>, n: int):
    repeat n in i:
        o.set(i, a.get(2 * i) + 1)
    end
end

noinline func odds64(a: Vector<i64>, o &: Vector<i64>, n: int):
    repeat n in i:
        o.set(i, a.get(2 * i + 1) - (5 as i64))
    end
end

noinline func pts(p: Vector<P>, o &: Vector<f32>, n: int):
    repeat n in i:
        q := p.get(i)
        o.set(i, q.x - q.y * (0.5 as f32))
    end
end

noinline func cmag(c: Vector<C>, o &: Vector<f64>, n: int):
    repeat n in i:
        z := c.get(i)
        o.set(i, z.re * z.re - z.im)
    end
end

noinline func ptr2(a: f64*, o: f64*, n: int):
    repeat n in i:
        o[i] = a[2 * i] * 0.5 + a[2 * i + 1]
    end
end

noinline func inplace(a &: Vector<int>, n: int):
    repeat n in i:
        a.set(i, a.get(2 * i) + 1)
    end
end

noinline func ysum(p: Vector<P>, n: int): f32:
    mut s := 0.0 as f32
    repeat n in i:
        s = s + p.get(i).y
    end
    ret s
end

func main:
    each n in [0, 1, 3, 4, 7, 8, 9, 15, 16, 17, 33, 100]:
        mut a := Vector {} as Vector<f32>
        mut o := Vector {} as Vector<f32>
        mut ai := Vector {} as Vector<int>
        mut oi := Vector {} as Vector<int>
        mut al := Vector {} as Vector<i64>
        mut ol := Vector {} as Vector<i64>
        mut p := Vector {} as Vector<P>
        mut c := Vector {} as Vector<C>
        mut od := Vector {} as Vector<f64>
        repeat 2 * n in i:
            a.push((((i * 37) % 23) as f32) * (0.5 as f32))
            ai.push((i * 7919) % 2003 - 1000)
            al.push((i as i64) * (6364136223846793005 as i64))
        end
        repeat n in j:
            o.push(0.0 as f32)
            oi.push(0)
            ol.push(0 as i64)
            od.push(0.0)
            p.push(P { x = (j as f32), y = ((j % 7) as f32) * (0.25 as f32) })
            c.push(C { re = (j as f64) * 0.5, im = ((j % 5) as f64) - 2.0 })
        end
        mut h := 0 as i64
        mut fs := 0.0
        mag(a, o, n)
        each z in o: fs = fs * 0.5 + (z as f64) end
        evens(ai, oi, n)
        each w in oi: h = h * 31 + (w as i64) end
        odds64(al, ol, n)
        each w2 in ol: h = h * 7 + w2 end
        pts(p, o, n)
        each z2 in o: fs = fs * 0.5 + (z2 as f64) end
        cmag(c, od, n)
        each z3 in od: fs = fs * 0.5 + z3 end
        pa := mem.Allocate(((2 * n + 1) * 8) as u64) as f64*
        po := mem.Allocate(((n + 1) * 8) as u64) as f64*
        repeat 2 * n in k:
            pa[k] = (k as f64) * 0.25 - 3.0
        end
        ptr2(pa, po, n)
        repeat n in k2:
            fs = fs * 0.5 + po[k2]
        end
        mem.Free(pa as void*)
        mem.Free(po as void*)
        inplace(ai, n)
        each w3 in ai: h = h * 3 + (w3 as i64) end
        fs = fs + (ysum(p, n) as f64)
        println n, h, fs
    end
end
