import mem

func sub_row(cp: u8*, out: u8*, n: int):
    mut i := 0
    until i < n:
        mut a := 0
        if i >= 4: a = cp[i - 4] as int end
        out[i] = ((cp[i] as int - a) & 255) as u8
        i += 1
    end
end

func avg_row(cp: u8*, pp: u8*, out: u8*, n: int):
    mut i := 0
    until i < n:
        mut a := 0
        if i >= 4: a = cp[i - 4] as int end
        out[i] = ((cp[i] as int - (a + pp[i] as int) / 2) & 255) as u8
        i += 1
    end
end

func paeth_row(cp: u8*, pp: u8*, out: u8*, n: int):
    mut i := 0
    until i < n:
        mut a := 0
        mut c := 0
        if i >= 4:
            a = cp[i - 4] as int
            c = pp[i - 4] as int
        end
        b := pp[i] as int
        p := a + b - c
        mut pa := p - a
        if pa < 0: pa = -pa end
        mut pb := p - b
        if pb < 0: pb = -pb end
        mut pc := p - c
        if pc < 0: pc = -pc end
        mut pr := c
        if pb <= pc: pr = b end
        if pa <= pb and pa <= pc: pr = a end
        out[i] = ((cp[i] as int - pr) & 255) as u8
        i += 1
    end
end

func widen_row(src: u8*, out: i32*, n: int, k: int):
    mut i := 0
    until i < n:
        out[i] = (src[i] as i32) * k + 7
        i += 1
    end
end

func sum_bytes(p: u8*, n: int): int:
    mut s := 0
    mut i := 0
    until i < n:
        s = (s * 31 + (p[i] as int)) & 16777215
        i += 1
    end
    ret s
end

func sum_ints(p: i32*, n: int): int:
    mut s := 0
    mut i := 0
    until i < n:
        s = (s * 31 + p[i]) & 16777215
        i += 1
    end
    ret s
end

func main:
    cap := 96
    cp := mem.AllocateZeroed(cap as u64) as u8*
    pp := mem.AllocateZeroed(cap as u64) as u8*
    out := mem.AllocateZeroed(cap as u64) as u8*
    wo := mem.AllocateZeroed((cap * 4) as u64) as i32*
    mut seed := 99 as i64
    repeat cap in k:
        seed = (seed * 1103515245 + 12345) & 2147483647
        cp[k] = ((seed >> 16) & 255) as u8
        seed = (seed * 1103515245 + 12345) & 2147483647
        pp[k] = ((seed >> 16) & 255) as u8
    end
    mut n := 0
    until n <= 80:
        sub_row(cp, out, n)
        s1 := sum_bytes(out, n)
        avg_row(cp, pp, out, n)
        s2 := sum_bytes(out, n)
        paeth_row(cp, pp, out, n)
        s3 := sum_bytes(out, n)
        widen_row(cp, wo, n, n + 3)
        s4 := sum_ints(wo, n)
        println "n=" + n + " sub=" + s1 + " avg=" + s2 + " paeth=" + s3 + " widen=" + s4
        n += 1
    end
    mem.Free(cp as void*)
    mem.Free(pp as void*)
    mem.Free(out as void*)
    mem.Free(wo as void*)
end
