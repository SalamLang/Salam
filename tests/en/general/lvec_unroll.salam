import mem

func at(p: u8*, k: int): u8*:
    ret ((p as i64) + (k as i64)) as u8*
end

noinline func sub_left(cp: u8*, out: u8*, n: int):
    mut i := 0
    until i < n:
        a := i >= 4 ? cp[i - 4] as int : 0
        out[i] = (((cp[i] as int) - a) & 255) as u8
        i++
    end
end

noinline func sub_up(cp: u8*, pp: u8*, out: u8*, n: int):
    repeat n in i:
        out[i] = (((cp[i] as int) - (pp[i] as int)) & 255) as u8
    end
end

noinline func avg_up(cp: u8*, pp: u8*, out: u8*, n: int):
    repeat n in i:
        out[i] = (((cp[i] as int) - ((cp[i] as int) + (pp[i] as int)) / 2) & 255) as u8
    end
end

noinline func clamp_pick(x: u8*, y: u8*, out: u8*, n: int, lim: int):
    repeat n in i:
        a := x[i] as int
        b := y[i] as int
        mut r := a
        if a > lim: r = b end
        if b > a + 9: r ^= 0x5A end
        out[i] = (r & 255) as u8
    end
end

noinline func mix32(a: Vector<int>, b: Vector<int>, o &: Vector<int>, n: int, k: int):
    repeat n in i:
        x := a.Get(i)
        y := b.Get(i)
        o.Set(i, x > y ? x - y * k : y + (x ^ k))
    end
end

noinline func mix16(a: Vector<i16>, b: Vector<i16>, o &: Vector<i16>, n: int):
    repeat n in i:
        x := a.Get(i) as int
        y := b.Get(i) as int
        o.Set(i, (x < y ? y - x : x + y) as i16)
    end
end

noinline func small_arr(p: u8*, n: int): int:
    mut vals := [0, 0, 0, 0]
    mut s := 0
    repeat n in i:
        repeat 4 in ch:
            vals[ch] = p[i * 4 + ch] as int
        end
        s += vals[0] * 3 + vals[1] * 5 + vals[2] * 7 + vals[3]
    end
    ret s
end

func hash(p: u8*, n: int): i64:
    mut h := 7 as i64
    repeat n in i:
        h = (h * (31 as i64) + (p[i] as i64)) % (1000000007 as i64)
    end
    ret h
end

func vhash(v: Vector<int>, n: int): i64:
    mut h := 11 as i64
    repeat n in i:
        h = (h * (131 as i64) + (v.Get(i) as i64)) % (1000000007 as i64)
    end
    ret h
end

func whash(v: Vector<i16>, n: int): i64:
    mut h := 13 as i64
    repeat n in i:
        h = (h * (137 as i64) + (v.Get(i) as i64)) % (1000000007 as i64)
    end
    ret h
end

func fill(p: u8*, n: int, seed: int):
    repeat n in i:
        p[i] = ((i * 29 + seed * 17 + (i >> 2) * 3 + (i * i) % 11) % 256) as u8
    end
end

func run(n: int, from: int):
    cap := n * 4 + 80
    x := mem.AllocateZeroed(cap as u64) as u8*
    y := mem.AllocateZeroed(cap as u64) as u8*
    o := mem.AllocateZeroed(cap as u64) as u8*
    fill(x, cap, 1)
    fill(y, cap, 2)
    mut line := "n=" + n + " from=" + from
    sub_left(at(x, from), at(o, from), n)
    line = line + " sl=" + hash(o, cap)
    sub_up(at(x, from), y, at(o, 2), n)
    line = line + " su=" + hash(o, cap)
    avg_up(at(x, from), at(y, 3), o, n)
    line = line + " av=" + hash(o, cap)
    each lim in [0, 100, 255]:
        clamp_pick(at(x, from), y, at(o, 1), n, lim)
        line = line + " cp" + lim + "=" + hash(o, cap)
    end
    fill(o, cap, 5)
    sub_up(at(o, 1), o, o, n)
    line = line + " ov=" + hash(o, cap)
    fill(o, cap, 6)
    sub_left(o, at(o, 4), n)
    line = line + " ol=" + hash(o, cap)
    line = line + " sa=" + small_arr(at(x, from), n)
    println line
    mem.Free(x as void*)
    mem.Free(y as void*)
    mem.Free(o as void*)
end

func runv(n: int):
    mut a := Vector {} as Vector<int>
    mut b := Vector {} as Vector<int>
    mut o := Vector {} as Vector<int>
    mut c := Vector {} as Vector<i16>
    mut d := Vector {} as Vector<i16>
    mut w := Vector {} as Vector<i16>
    repeat n in i:
        a.Push((i * 7919) % 1000 - 500)
        b.Push((i * 104729) % 777 - 300)
        o.Push(0)
        c.Push(((i * 4099) % 3000 - 1500) as i16)
        d.Push(((i * 613) % 2000 - 1000) as i16)
        w.Push(0 as i16)
    end
    mix32(a, b, o, n, 3)
    mix16(c, d, w, n)
    println "v n=" + n + " m32=" + vhash(o, n) + " m16=" + whash(w, n)
end

func main:
    each n in [0, 1, 3, 15, 16, 17, 31, 32, 33, 63, 64, 65, 95, 96, 97, 127, 128, 129, 159, 160, 161, 191, 192, 193, 255, 256, 257, 300, 1031]:
        each from in [0, 1, 5]:
            run(n, from)
        end
        runv(n)
    end
end
