func run16(n: int, seed: int): int:
    mut a := Vector {} as Vector<i16>
    mut b := Vector {} as Vector<i16>
    mut o := Vector {} as Vector<i16>
    mut ua := Vector {} as Vector<u16>
    mut ub := Vector {} as Vector<u16>
    mut uo := Vector {} as Vector<u16>
    repeat n in i:
        a.push((((i * 977 + seed) % 65536) - 32768) as i16)
        b.push((((i * 313 + 11) % 65536) - 32768) as i16)
        o.push(0 as i16)
        ua.push(((i * 1231 + seed) % 65536) as u16)
        ub.push(((i * 457 + 9) % 65536) as u16)
        uo.push(0 as u16)
    end
    k := (seed * 5) as i16
    mut h := 0
    repeat n in i1:
        o.set(i1, a.get(i1) + b.get(i1) * k)
    end
    repeat n in k1: h = h * 31 + (o.get(k1) as int) end
    repeat n in i2:
        o.set(i2, (a.get(i2) >> (3 as i16)) - (b.get(i2) << (2 as i16)))
    end
    repeat n in k2: h = h * 31 + (o.get(k2) as int) end
    repeat n in i3:
        o.set(i3, a.get(i3) < b.get(i3) ? a.get(i3) - k : b.get(i3) + k)
    end
    repeat n in k3: h = h * 31 + (o.get(k3) as int) end
    repeat n in i4:
        o.set(i4, a.get(i4) != b.get(i4) ? a.get(i4) ^ k : k)
    end
    repeat n in k4: h = h * 31 + (o.get(k4) as int) end
    repeat n in i5:
        uo.set(i5, ua.get(i5) > ub.get(i5) ? ua.get(i5) - ub.get(i5) : ub.get(i5) >> (1 as u16))
    end
    repeat n in k5: h = h * 31 + (uo.get(k5) as int) end
    repeat n in i6:
        uo.set(i6, ua.get(i6) <= ub.get(i6) ? ua.get(i6) : (7 as u16))
    end
    repeat n in k6: h = h * 31 + (uo.get(k6) as int) end
    ret h
end

func run32(n: int, seed: int): int:
    mut a := Vector {} as Vector<u32>
    mut b := Vector {} as Vector<u32>
    mut o := Vector {} as Vector<u32>
    repeat n in i:
        a.push(((i as i64) * (2654435761 as i64) + (seed as i64)) as u32)
        b.push(((i as i64) * (40503 as i64) + (7 as i64)) as u32)
        o.push(0 as u32)
    end
    mut h := 0
    repeat n in i1:
        o.set(i1, a.get(i1) > b.get(i1) ? a.get(i1) - b.get(i1) : b.get(i1) - a.get(i1))
    end
    repeat n in k1: h = h * 31 + ((o.get(k1) % (1000 as u32)) as int) end
    repeat n in i3:
        o.set(i3, a.get(i3) < b.get(i3) ? a.get(i3) + (3 as u32) : b.get(i3) ^ a.get(i3))
    end
    repeat n in k3: h = h * 31 + ((o.get(k3) % (1000 as u32)) as int) end
    repeat n in i2:
        o.set(i2, a.get(i2) >= b.get(i2) ? (1 as u32) : (2 as u32))
    end
    repeat n in k2: h = h * 31 + (o.get(k2) as int) end
    ret h
end

func run64(n: int, seed: int): int:
    mut a := Vector {} as Vector<i64>
    mut b := Vector {} as Vector<i64>
    mut o := Vector {} as Vector<i64>
    mut ua := Vector {} as Vector<u64>
    mut ub := Vector {} as Vector<u64>
    mut uo := Vector {} as Vector<u64>
    repeat n in i:
        x := (i as i64) * (6364136223846793005 as i64) + (seed as i64)
        y := (i as i64) * (1442695040888963407 as i64) - (5 as i64)
        a.push(x)
        b.push(i % 7 == 0 ? x : y)
        o.push(0 as i64)
        ua.push(x as u64)
        ub.push(y as u64)
        uo.push(0 as u64)
    end
    mut h := 0
    repeat n in i1:
        o.set(i1, a.get(i1) > b.get(i1) ? a.get(i1) - b.get(i1) : b.get(i1) + (1 as i64))
    end
    repeat n in k1: h = h * 31 + ((o.get(k1) % (1000 as i64)) as int) end
    repeat n in i2:
        o.set(i2, a.get(i2) == b.get(i2) ? (1 as i64) : (2 as i64))
    end
    repeat n in k2: h = h * 31 + (o.get(k2) as int) end
    repeat n in i3:
        o.set(i3, a.get(i3) <= b.get(i3) ? (3 as i64) : (4 as i64))
    end
    repeat n in k3: h = h * 31 + (o.get(k3) as int) end
    repeat n in i4:
        uo.set(i4, ua.get(i4) < ub.get(i4) ? ub.get(i4) - ua.get(i4) : ua.get(i4) ^ ub.get(i4))
    end
    repeat n in k4: h = h * 31 + ((uo.get(k4) % (1000 as u64)) as int) end
    repeat n in i5:
        uo.set(i5, ua.get(i5) >= ub.get(i5) ? ub.get(i5) + ua.get(i5) : ua.get(i5) - (9 as u64))
    end
    repeat n in k5: h = h * 31 + ((uo.get(k5) % (1000 as u64)) as int) end
    ret h
end

func main:
    each n in [0, 1, 7, 8, 9, 15, 16, 17, 31, 100, 1003]:
        println n, run16(n, 3), run32(n, 5), run64(n, 9)
    end
end
