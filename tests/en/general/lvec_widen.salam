import mem

func at(p: u8*, k: int): u8*:
    ret ((p as i64) + (k as i64)) as u8*
end

func paeth_pick(a: int, b: int, c: int): int:
    p := a + b - c
    mut pa := p - a
    if pa < 0: pa = -pa end
    mut pb := p - b
    if pb < 0: pb = -pb end
    mut pc := p - c
    if pc < 0: pc = -pc end
    if pa <= pb and pa <= pc: ret a end
    if pb <= pc: ret b end
    ret c
end

func sbyte(v: int): int:
    b := v & 255
    if b >= 128: ret 256 - b end
    ret b
end

noinline func score(cp: u8*, pp: u8*, n: int): int:
    mut s0 := 0
    mut s1 := 0
    mut s2 := 0
    mut s3 := 0
    mut s4 := 0
    mut j := 0
    until j < n:
        xv := cp[j] as int
        b := pp[j] as int
        mut a := 0
        mut c := 0
        if j >= 4:
            a = cp[j - 4] as int
            c = pp[j - 4] as int
        end
        s0 += sbyte(xv)
        s1 += sbyte(xv - a)
        s2 += sbyte(xv - b)
        s3 += sbyte(xv - (a + b) / 2)
        s4 += sbyte(xv - paeth_pick(a, b, c))
        j += 1
    end
    ret s0 + s1 * 3 + s2 * 5 + s3 * 7 + s4 * 11
end

noinline func apply(cp: u8*, pp: u8*, out: u8*, n: int, kind: int):
    mut i := 0
    until i < n:
        xv := cp[i] as int
        mut a := 0
        if i >= 4: a = cp[i - 4] as int end
        b := pp[i] as int
        mut c := 0
        if i >= 4: c = pp[i - 4] as int end
        mut fv := xv
        if kind == 1: fv = xv - a end
        if kind == 2: fv = xv - b end
        if kind == 3: fv = xv - (a + b) / 2 end
        if kind == 4: fv = xv - paeth_pick(a, b, c) end
        out[i] = (fv & 255) as u8
        i += 1
    end
end

noinline func pick(x: u8*, y: u8*, out: u8*, n: int, mode: int):
    repeat n in i:
        a := x[i] as int
        b := y[i] as int
        mut r := a
        if mode == 7: r = a + b end
        if mode == 9: r = a ^ b end
        if mode == 11: r = a * 3 - b end
        out[i] = (r & 255) as u8
    end
end

noinline func flagpick(x: u8*, y: u8*, out: u8*, n: int, flag: int, mode: int):
    repeat n in i:
        a := x[i] as int
        b := y[i] as int
        mut r := a
        if flag == 5: r = a + 1 end
        if mode == 1: r = r ^ b end
        if mode == 2: r = r - b end
        if mode == 3: r = r + b * 2 end
        out[i] = (r & 255) as u8
    end
end

noinline func sdist(x: i8*, y: i8*, n: int): int:
    mut s := 0
    repeat n in i:
        d := (x[i] as int) - (y[i] as int)
        s += d < 0 ? 0 - d : d
    end
    ret s
end

noinline func wsum(x: Vector<u16>, y: Vector<i16>, n: int): int:
    mut s := 0
    mut t := 0
    repeat n in i:
        u := x.get(i) as int
        v := y.get(i) as int
        s += u > v ? u - v : v - u
        t += u ^ (v & 1023)
    end
    ret s * 7 + t
end

func hash(p: u8*, n: int): i64:
    mut h := 7 as i64
    repeat n in i:
        h = (h * (31 as i64) + (p[i] as i64)) % (1000000007 as i64)
    end
    ret h
end

func fill(p: u8*, n: int, seed: int):
    repeat n in i:
        p[i] = ((i * 37 + seed * 11 + (i >> 3) * 5 + (i * i) % 7) % 256) as u8
    end
end

func run(n: int, from: int):
    cap := n + 64
    x := mem.AllocateZeroed(cap as u64) as u8*
    y := mem.AllocateZeroed(cap as u64) as u8*
    o := mem.AllocateZeroed(cap as u64) as u8*
    fill(x, cap, 1)
    fill(y, cap, 2)
    mut line := "n=" + n + " from=" + from + " score=" + score(at(x, from), at(y, from), n)
    repeat 6 in kind:
        apply(at(x, from), at(y, from), at(o, from), n, kind)
        line = line + " k" + kind + "=" + hash(o, cap)
    end
    each mode in [0, 7, 9, 11, 13]:
        pick(at(x, from), y, at(o, 1), n, mode)
        line = line + " m" + mode + "=" + hash(o, cap)
    end
    each fm in [0, 1, 2, 3, 4]:
        flagpick(at(x, from), y, at(o, 2), n, 5 - (fm & 1) * 5, fm)
        line = line + " f" + fm + "=" + hash(o, cap)
    end
    line = line + " sd=" + sdist(at(x, from) as i8*, y as i8*, n)
    fill(o, cap, 5)
    apply(o, o, o, n, 4)
    line = line + " inpl=" + hash(o, cap)
    fill(o, cap, 5)
    apply(at(o, 1), o, o, n, 3)
    line = line + " lag=" + hash(o, cap)
    println line
    mem.Free(x as void*)
    mem.Free(y as void*)
    mem.Free(o as void*)
end

func run16(n: int):
    mut a := Vector {} as Vector<u16>
    mut b := Vector {} as Vector<i16>
    repeat n in i:
        a.push(((i * 7919 + 65000) % 65536) as u16)
        b.push((((i * 4099) % 65536) - 32768) as i16)
    end
    println "w16 n=" + n + " s=" + wsum(a, b, n)
end

func main:
    each n in [0, 1, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100, 1000]:
        each from in [0, 1, 3]:
            run(n, from)
        end
        run16(n)
    end
end
