package main

import mem

struct Empty:
    pub func value(): int:
        ret 1
    end
end

func main:
    mut items := Vector {} as Vector<Empty>
    repeat 100:
        items.Push(Empty {})
    end
    println items.Len(), items[99].Value()
    a := mem.MustAllocate(16 as u64) as i64*
    a[1] = 7
    println a[1]
    b := mem.MustAllocateZeroed(16 as u64) as i64*
    println b[1]
    mut c := mem.MustReallocate(null, 8 as u64) as i64*
    c[0] = 5
    c = mem.MustReallocate(c as void*, 64 as u64) as i64*
    println c[0]
    mem.Free(a as void*)
    mem.Free(b as void*)
    freed := mem.MustReallocate(c as void*, 0 as u64)
    mem.Free(freed)
    println "done"
end
