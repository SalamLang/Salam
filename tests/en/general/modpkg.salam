import ml "_modlib.salam"

func main:
    println ml.PAdd(3, 4)
    println ml.PSquare(6)
    println ml.PTriple(5)
    println ml.POld(10)
    println ml.PBoosted(1)
    println ml.PPick(2, 8)
    println ml.PPick(0.5, 0.25)
end
