include ml "_modlib.salam"

func main:
    println ml.PSum(3, 4)
    println ml.PSquare(6)
    println ml.PTriple(5)
    println ml.PBoosted(1)
    println ml.PPick(2, 8)
    println ml.PPick(0.5, 0.25)
    mut b := ml.PBox {}
    b.w = 4
    b.h = 5
    println b.PArea()
    println b.PPerim()
    b.PWiden(6)
    println b.PArea()
    println b.PScaled()
end
