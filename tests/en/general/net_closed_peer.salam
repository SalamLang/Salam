import net.websocket
import net.tcp
import sync
import time

mut ws_ready := sync.NewWaitGroup()
mut tcp_ready := sync.NewWaitGroup()
mut ws_port := 0
mut tcp_port := 0
mut ws_writes := 0
mut tcp_writes := 0

func ws_server():
    srv := websocket.Listen(0)
    ws_port = websocket.Port(srv)
    sync.Done(ws_ready)
    if not websocket.Ok(srv):
        ret
    end
    mut c := websocket.Accept(srv)
    time.Sleep(200)
    repeat 10 in i:
        websocket.SendText(c, "into the void " + i)
        ws_writes++
        time.Sleep(20)
    end
    websocket.Close(c)
    websocket.CloseServer(srv)
end

func tcp_server():
    srv := tcp.Bind(0)
    tcp_port = tcp.Port(srv)
    sync.Done(tcp_ready)
    if not tcp.Ok(srv):
        ret
    end
    c := tcp.Accept(srv)
    time.Sleep(200)
    repeat 10 in i:
        tcp.Write(c, "into the void " + i + "\n")
        tcp_writes++
        time.Sleep(20)
    end
    tcp.Close(c)
    tcp.CloseServer(srv)
end

func main:
    sync.Add(ws_ready, 1 as i64)
    wt := spawn(ws_server)
    sync.Wait(ws_ready)
    mut wc := websocket.Dial("127.0.0.1", ws_port, "/")
    println "websocket connected:", websocket.IsOpen(wc)
    websocket.Close(wc)
    join(wt)
    println "server wrote to a closed peer and lived:", ws_writes

    sync.Add(tcp_ready, 1 as i64)
    tt := spawn(tcp_server)
    sync.Wait(tcp_ready)
    tc := tcp.Dial("127.0.0.1", tcp_port)
    println "tcp connected:", tcp.ConnOk(tc)
    tcp.Close(tc)
    join(tt)
    println "server wrote to a closed peer and lived:", tcp_writes

    println "reached the end"
end
