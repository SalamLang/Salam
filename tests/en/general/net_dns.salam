// Protocol-level only (RFC 1035 message encode/decode) - no live network
// access, so this test is deterministic and offline-safe.

import net.dns

func main:
    q := dns.EncodeQuery("www.example.com", dns.TypeA, 1234)
    println q.len > 0

    msg := dns.Decode(q.data, q.len)
    println msg.id == 1234
    println msg.rd == true
    println msg.qr == false
    println msg.questions.items.len() == 1
    q0 := msg.questions.items.get(0)
    println q0[0].name == "www.example.com"
    println q0[0].qtype == dns.TypeA
    println q0[0].qclass == dns.ClassIN

    q2 := dns.EncodeQuery("a.b", dns.TypeAAAA, 42)
    msg2 := dns.Decode(q2.data, q2.len)
    println msg2.id == 42
    q2_0 := msg2.questions.items.get(0)
    println q2_0[0].name == "a.b"
    println q2_0[0].qtype == dns.TypeAAAA

    println dns.TypeA == 1
    println dns.TypeNS == 2
    println dns.TypeCNAME == 5
    println dns.TypeMX == 15
    println dns.TypeTXT == 16
    println dns.TypeAAAA == 28
    println dns.TypePTR == 12
    println dns.ClassIN == 1
end
