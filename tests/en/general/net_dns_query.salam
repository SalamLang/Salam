package main

import net.dns

func main:
    println dns.Lookup("127.0.0.1")
    servers := dns.DefaultServers()
    println servers.len() > 0
    println servers.get(0).len() > 0

    msg := dns.QueryServer("no.such.host.invalid", "example.com", dns.TypeA, 100)
    println msg.id
    println msg.answers.items.len()
    println msg.questions.items.len()

    println dns.LookupPTR("not-an-ip").len()
end
