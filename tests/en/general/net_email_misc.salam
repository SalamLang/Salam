// XOAUTH2 SASL string construction (deterministic, no network), the
// three BuildMessage shapes (text-only / html-only / multipart-
// alternative), and IMAP/POP3 Dial failing gracefully (not hanging,
// not crashing) against a port nothing is listening on.

import net.email
import encoding

func main:
    token := email.BuildXOAuth2("user@example.com", "token123")
    decoded := encoding.Base64Decode(token)
    println decoded.find("user=user@example.com") == 0
    println decoded.find("auth=Bearer token123") > 0
    // Deterministic: encoding the same inputs twice must produce the
    // same token (no hidden randomness/timestamp in the SASL string).
    token2 := email.BuildXOAuth2("user@example.com", "token123")
    println token == token2

    text_only := email.BuildMessage("a@x.com", "b@x.com", "Subj", "plain body", "")
    println text_only.find("Content-Type: text/plain; charset=utf-8") >= 0
    println text_only.find("multipart") < 0
    println text_only.find("plain body") >= 0

    html_only := email.BuildMessage("a@x.com", "b@x.com", "Subj", "", "<p>hi</p>")
    println html_only.find("Content-Type: text/html; charset=utf-8") >= 0
    println html_only.find("<p>hi</p>") >= 0

    both := email.BuildMessage("a@x.com", "b@x.com", "Subj", "plain part", "<p>html part</p>")
    println both.find("multipart/alternative") >= 0
    println both.find("Content-Type: text/plain; charset=utf-8") >= 0
    println both.find("Content-Type: text/html; charset=utf-8") >= 0
    println both.find("plain part") >= 0
    println both.find("<p>html part</p>") >= 0

    // Nothing is listening on these ports - Dial must fail gracefully
    // (ok == false), not hang or crash.
    imap_c := email.DialIMAP("127.0.0.1", 19511)
    println imap_c.ok == false

    pop_c := email.DialPOP3("127.0.0.1", 19512)
    println pop_c.ok == false
end
