import net.email
import net.tcp
import sync
import time

mut smwg := sync.NewWaitGroup()

func mock_smtp_server():
    srv := tcp.Bind(19501)
    sync.Done(smwg)
    if !tcp.Ok(srv):
        ret
    end
    c := tcp.Accept(srv)
    if !tcp.ConnOk(c):
        tcp.CloseServer(srv)
        ret
    end

    tcp.Write(c, "220 mock.smtp ready\r\n")
    tcp.Read(c, 4096)
    tcp.Write(c, "250-mock.smtp\r\n250 AUTH PLAIN\r\n")
    tcp.Read(c, 4096)
    tcp.Write(c, "235 Authentication successful\r\n")
    tcp.Read(c, 4096)
    tcp.Write(c, "250 OK\r\n")
    tcp.Read(c, 4096)
    tcp.Write(c, "250 OK\r\n")
    tcp.Read(c, 4096)
    tcp.Write(c, "354 Send message\r\n")

    mut body := ""
    mut going := true
    until going:
        chunk := tcp.Read(c, 4096)
        body += chunk
        if body.find("\r\n.\r\n") >= 0:
            going = false
        end
    end
    println body.find("\r\n..\r\n") >= 0

    tcp.Write(c, "250 OK: queued\r\n")
    tcp.Read(c, 4096)

    tcp.Close(c)
    tcp.CloseServer(srv)
end

func dial_smtp_retry(): email.SMTPClient:
    mut attempt := 0
    mut c := email.SMTPClient {}
    until !c.ok && attempt < 300:
        c = email.DialSMTP("127.0.0.1", 19501)
        if !c.ok:
            time.Sleep(10)
        end
        attempt += 1
    end
    ret c
end

func main:
    sync.Add(smwg, 1 as i64)
    t := spawn(mock_smtp_server)
    sync.Wait(smwg)

    mut c := dial_smtp_retry()
    println c.ok

    println email.Hello(c, "client.example")
    println email.AuthPlain(c, "user@example.com", "secret")
    println email.MailFrom(c, "sender@example.com")
    println email.RcptTo(c, "dest@example.com")

    msg := email.BuildMessage("sender@example.com", "dest@example.com", "Test Subject", "line one\r\n.\r\nline three (dot-stuff test)", "")
    println email.Data(c, msg)

    email.Quit(c)
    join(t)
end
