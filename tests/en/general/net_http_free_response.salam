import net.http
import net.router
import str

func hello(h: i64):
    http.SetHeader(h, "Set-Cookie", "sid=abc")
    http.SetHeader(h, "X-Answer", "42")
    http.Text(h, "hello")
end

func gone(h: i64):
    http.SetHeader(h, "Set-Cookie", "sid=; Max-Age=0")
    http.Text(h, "bye")
end

func spin(h: i64):
    http.Redirect(h, "/spin")
end

func bad(h: i64):
    http.Redirect(h, "/a b")
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/gone", gone)
    router.Get(r, "/spin", spin)
    router.Get(r, "/bad", bad)
    router.Get(r, "/x", hello)
    router.Post(r, "/x", hello)
    mut app := http.NewServer(0)
    http.Use(app, r)
    port := http.RunBackgroundPort(app)
    target := "http://127.0.0.1:" + port + "/x"
    first := http.Get(target)
    body := str.Clone(http.Body(first))
    answer := http.HeaderValue(first.head, "X-Answer")
    status := first.status
    http.FreeResponse(first)
    println status, body, answer
    mut c := http.NewClient()
    mut sent := 0
    repeat 200:
        res := c.Get(target)
        if res.status == 200: sent += 1 end
        http.FreeResponse(res)
    end
    println "answered:", sent
    println "cookie kept:", c.cookies.has("sid")
    c.SetHeader("Host", "example.test")
    c.SetHeader("X-Extra", "1")
    posted := c.Post(target, "a=1")
    println "post without a type:", posted.status
    http.FreeResponse(posted)
    c.cookie_hosts.put("mine", "caller.example")
    c.ClearCookies()
    println "cookies cleared:", c.cookies.has("sid")
    c.cookie_hosts.put("mine", "caller.example")
    repeat 20:
        again := c.Get(target)
        http.FreeResponse(again)
        c.SetCookie("sid", "mine")
        c.ClearCookies()
    end
    println "jar cycles ok:", c.cookies.has("sid")
    http.FreeResponse(c.Get(target))
    c.SetCookie("sid", "mine")
    http.FreeResponse(c.Get(target))
    println "cookie after replace:", c.cookies.has("sid")
    http.FreeResponse(c.Get("http://127.0.0.1:" + port + "/gone"))
    println "cookie after expiry:", c.cookies.has("sid")
    http.FreeResponse(c.Get(target))
    c.SetCookie("sid", c.cookies.get("sid"))
    c.SetCookie("copy", c.cookies.get("sid"))
    http.FreeResponse(c.Get(target))
    println "aliased cookie:", c.cookies.get("sid"), c.cookies.get("copy")
    base := "http://127.0.0.1:" + port
    repeat 5:
        http.FreeResponse(c.Get(base + "/spin"))
    end
    c.SetMaxRedirects(3)
    repeat 5:
        looped := c.Get(base + "/spin")
        if looped.err.len() == 0: println "no error" end
        http.FreeResponse(looped)
        badref := c.Get(base + "/bad")
        if badref.err.len() == 0: println "no error" end
        http.FreeResponse(badref)
    end
    println "redirect failures freed"
    c.Free()
    empty := http.Response {}
    http.FreeResponse(empty)
    println "empty response freed"
end
