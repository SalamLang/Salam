import net.http
import net.router
import str

func hello(h: i64):
    http.SetHeader(h, "Set-Cookie", "sid=abc")
    http.SetHeader(h, "X-Answer", "42")
    http.Text(h, "hello")
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/x", hello)
    mut app := http.NewServer(0)
    http.Use(app, r)
    port := http.RunBackgroundPort(app)
    target := "http://127.0.0.1:" + port + "/x"
    first := http.Get(target)
    body := str.Clone(http.Body(first))
    answer := http.HeaderValue(first.head, "X-Answer")
    status := first.status
    http.FreeResponse(first)
    println status, body, answer
    mut c := http.NewClient()
    mut sent := 0
    repeat 200:
        res := c.Get(target)
        if res.status == 200: sent += 1 end
        http.FreeResponse(res)
    end
    println "answered:", sent
    println "cookie kept:", c.cookies.has("sid")
    empty := http.Response {}
    http.FreeResponse(empty)
    println "empty response freed"
end
