import net.http
import net.router
import net.internal.rawsock
import str

mut PORT := 0

func take(ctx: i64):
    http.Text(ctx, "len=" + str.FromInt(http.Body(ctx).Len() as i64))
end

func status_of(raw: str): str:
    c := rawsock.Connect("127.0.0.1", PORT)
    if not rawsock.Ok(c):
        ret "connect failed"
    end
    rawsock.SetTimeout(c, 2000)
    rawsock.Send(c, raw)
    mut all := ""
    mut tries := 0
    until tries < 6:
        part := rawsock.Recv(c, 2048)
        if part.Len() == 0: break end
        all = all.Concat(part)
        tries++
    end
    rawsock.Close(c)
    if str.IndexFrom(all, "413 Content Too Large", 0) >= 0: ret "413" end
    if str.IndexFrom(all, "400 Bad Request", 0) >= 0: ret "400" end
    if str.IndexFrom(all, "200 OK", 0) >= 0: ret "200" end
    ret "none"
end

func main:
    http.SetMaxBodyBytes(4096)
    mut r := router.NewRouter()
    router.Post(r, "/up", take)
    mut s := http.NewServer(0)
    http.Use(s, r)
    PORT = http.RunBackgroundPort(s)
    if PORT == 0:
        println "server failed to start"
        ret
    end

    println "over-cap     " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 100000\r\n\r\n"
    )
    println "overflow-cl  " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 99999999999999999999\r\n\r\n"
    )
    println "cl 2147483000 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 2147483000\r\n\r\nhello"
    )
    println "cl 2147483600 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 2147483600\r\n\r\nhello"
    )
    println "cl 2147483647 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 2147483647\r\n\r\nhello"
    )
    println "cl 3000000000 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 3000000000\r\n\r\nhello"
    )
    println "cl 4294967296 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 4294967296\r\n\r\nhello"
    )
    println "cl 5000000000 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 5000000000\r\n\r\nhello"
    )
    println "cl 99999999999 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 99999999999\r\n\r\nhello"
    )
    println "cl 999999999999 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 999999999999\r\n\r\nhello"
    )
    println "cl 9999999999999 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 9999999999999\r\n\r\nhello"
    )
    println "cl 99999999999999 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 99999999999999\r\n\r\nhello"
    )
    println "cl 999999999999999 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 999999999999999\r\n\r\nhello"
    )
    http.SetMaxBodyBytes(2147483647)
    println "max-cap 2147483640 " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 2147483640\r\n\r\nhello"
    )
    http.SetMaxBodyBytes(4096)
    println "under-cap    " + status_of(
        "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello"
    )
end
