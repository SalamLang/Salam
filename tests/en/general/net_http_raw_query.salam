import net.http
import net.router

mut PORT := 0

func raw(ctx: i64):
    http.Text(ctx, http.RawQuery(http.Ctx(ctx)) + " [" + http.RawQuery(ctx) + "]")
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/q", raw)
    mut s := http.NewServer(0)
    http.Use(s, r)
    PORT = http.RunBackgroundPort(s)
    if PORT == 0:
        println "server failed to start"
        ret
    end
    base := "http://127.0.0.1:" + PORT
    println http.Body(http.Get(base + "/q?query=%7B%20me%20%7D&x=1"))
    println http.Body(http.Get(base + "/q"))
end
