import net.http
import net.router

const PORT := 19471

func raw(ctx: i64):
    http.Ctx_text(ctx, http.RawQuery(http.Ctx(ctx)) + " [" + http.Ctx_raw_query(ctx) + "]")
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/q", raw)
    s := http.NewServer(PORT)
    http.Use(s, r)
    if not http.RunBackground(s):
        println "server failed to start"
        ret
    end
    base := "http://127.0.0.1:" + PORT
    println http.Body(http.Get(base + "/q?query=%7B%20me%20%7D&x=1"))
    println http.Body(http.Get(base + "/q"))
end
