import net.http
import net.router
import net.internal.rawsock
import str

mut PORT := 0

func hello(ctx: i64):
    http.Text(ctx, "ok")
end

func status_of(raw: str): str:
    c := rawsock.Connect("127.0.0.1", PORT)
    if not rawsock.Ok(c):
        ret "connect failed"
    end
    rawsock.SetTimeout(c, 2000)
    rawsock.Send(c, raw)
    mut all := ""
    mut tries := 0
    until tries < 8:
        part := rawsock.Recv(c, 2048)
        if part.Len() == 0: break end
        all = all.Concat(part)
        tries++
    end
    rawsock.Close(c)
    mut n := 0
    mut at := str.IndexFrom(all, "HTTP/1.1 ", 0)
    until at >= 0:
        n++
        at = str.IndexFrom(all, "HTTP/1.1 ", at + 9)
    end
    mut code := "none"
    if str.IndexFrom(all, "400 Bad Request", 0) >= 0: code = "400" end
    if str.IndexFrom(all, "200 OK", 0) >= 0: code = "200" end
    ret "responses=" + str.FromInt(n as i64) + " " + code
end

func main:
    mut r := router.NewRouter()
    router.Post(r, "/echo", hello)
    router.Get(r, "/echo", hello)
    router.Get(r, "/admin", hello)
    mut s := http.NewServer(0)
    http.Use(s, r)
    PORT = http.RunBackgroundPort(s)
    if PORT == 0:
        println "server failed to start"
        ret
    end

    println "chunked      " + status_of("POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nb\r\nhello world\r\n0\r\n\r\n")
    println "dup-cl       " + status_of("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 11\r\n\r\nhello world")
    println "bad-cl       " + status_of("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: abc\r\n\r\nhello world")
    println "valid-cl     " + status_of("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 11\r\n\r\nhello world")
    println "get-cl       " + status_of("GET /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 32\r\n\r\nGET /admin HTTP/1.1\r\nHost: x\r\n\r\n")
    println "head-cl      " + status_of("HEAD /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 32\r\n\r\nGET /admin HTTP/1.1\r\nHost: x\r\n\r\n")
    println "options-cl   " + status_of("OPTIONS /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 32\r\n\r\nGET /admin HTTP/1.1\r\nHost: x\r\n\r\n")
    println "cl-space     " + status_of("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length : 4\r\n\r\nabcd")
    println "te-tab       " + status_of("POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding\t: chunked\r\nContent-Length: 4\r\n\r\nabcd")
    println "obs-fold     " + status_of("POST /echo HTTP/1.1\r\nHost: x\r\nX: a\r\n Content-Length: 4\r\n\r\nabcd")
end
