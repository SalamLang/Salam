import net.http
import net.router
import net.internal.rawsock
import str

const PORT := 19461

func hello(ctx: i64):
    http.Ctx_text(ctx, "ok")
end

func status of(raw: str): str:
    c := rawsock.Connect("127.0.0.1", PORT)
    if !rawsock.Ok(c):
        ret "connect failed"
    end
    rawsock.SetTimeout(c, 2000)
    rawsock.Send(c, raw)
    mut all := ""
    mut tries := 0
    until tries < 8:
        part := rawsock.Recv(c, 2048)
        if part.len() == 0: break end
        all = all.concat(part)
        tries += 1
    end
    rawsock.Close(c)
    mut n := 0
    mut at := str.IndexFrom(all, "HTTP/1.1 ", 0)
    until at >= 0:
        n += 1
        at = str.IndexFrom(all, "HTTP/1.1 ", at + 9)
    end
    mut code := "none"
    if str.IndexFrom(all, "400 Bad Request", 0) >= 0: code = "400" end
    if str.IndexFrom(all, "200 OK", 0) >= 0: code = "200" end
    ret "responses=" + str.FromInt(n as i64) + " " + code
end

func main:
    mut r := router.NewRouter()
    router.Post(r, "/echo", hello)
    s := http.NewServer(PORT)
    http.Use(s, r)
    if !http.RunBackground(s):
        println "server failed to start"
        ret
    end

    println "chunked      " + status of("POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nb\r\nhello world\r\n0\r\n\r\n")
    println "dup-cl       " + status of("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 11\r\n\r\nhello world")
    println "bad-cl       " + status of("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: abc\r\n\r\nhello world")
    println "valid-cl     " + status of("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 11\r\n\r\nhello world")
end
