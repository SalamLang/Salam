import net.http
import net.router
import net.internal.rawsock
import os.temp
import os
import io
import filepath
import time
import net.tcp

mut web_port := 0

func run_server():
    dir := filepath.Join(temp.Directory(), "salam_net_http_static_test")
    os.Mkdir(dir)
    io.WriteFile(filepath.Join(dir, "index.html"), "<h1>hi</h1>")
    io.WriteFile(filepath.Join(dir, "style.css"), "body{color:red}")
    os.Mkdir(filepath.Join(dir, "docs"))
    io.WriteFile(filepath.Join(filepath.Join(dir, "docs"), "index.html"), "<h1>docs</h1>")

    mut r := router.NewRouter()
    router.Static(r, "/static/", dir)
    mut s := http.NewServer(web_port)
    http.Use(s, r)
    http.Run(s)
end

func get_raw(path: str): str:
    mut sock := rawsock.Connect("127.0.0.1", web_port)
    mut tries := 0
    until not rawsock.Ok(sock) and tries < 300:
        time.Sleep(10)
        sock = rawsock.Connect("127.0.0.1", web_port)
        tries++
    end
    if not rawsock.Ok(sock):
        ret ""
    end
    rawsock.Send(sock, "GET " + path + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
    mut resp := ""
    mut going := true
    until going:
        chunk := rawsock.Recv(sock, 8192)
        if chunk.Len() == 0:
            going = false
        else:
            resp += chunk
        end
    end
    rawsock.Close(sock)
    ret resp
end

func main:
    web_port = tcp.FreePort()
    _t := spawn(run_server)

    r1 := get_raw("/static/style.css")
    println r1.Find("200 OK") >= 0
    println r1.Find("text/css") >= 0
    println r1.Find("body{color:red}") >= 0

    r2 := get_raw("/static/index.html")
    println r2.Find("200 OK") >= 0
    println r2.Find("text/html") >= 0
    println r2.Find("<h1>hi</h1>") >= 0

    r3 := get_raw("/static/../../../../etc/passwd")
    println r3.Find("200 OK") < 0

    r4 := get_raw("/static/does-not-exist.txt")
    println r4.Find("404") >= 0

    r5 := get_raw("/not-static-at-all")
    println r5.Find("404") >= 0

    r6 := get_raw("/static/docs?v=1")
    println r6.Find("301") >= 0
    println r6.Find("Location: /static/docs/?v=1") >= 0

    r7 := get_raw("/static/docs/")
    println r7.Find("200 OK") >= 0
    println r7.Find("<h1>docs</h1>") >= 0
end
