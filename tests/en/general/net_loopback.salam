import net.internal.rawsock
import sync

mut net_port := 0
mut nloop wg := sync.NewWaitGroup()
func net server():
    srv := rawsock.Listen(0)
    net_port = rawsock.LocalPort(srv)
    sync.Done(nloop wg)
    if not rawsock.Ok(srv):
        ret
    end
    c := rawsock.Accept(srv)
    if rawsock.Ok(c):
        data := rawsock.Recv(c, 1024)
        rawsock.Send(c, "got:" + data)
        rawsock.Close(c)
    end
    rawsock.Close(srv)
end

func main:
    sync.Add(nloop wg, 1 as i64)
    t := spawn(net server)
    sync.Wait(nloop wg)
    c := rawsock.Connect("127.0.0.1", net_port)
    println rawsock.Ok(c)
    rawsock.Send(c, "world")
    resp := rawsock.Recv(c, 1024)
    println resp
    rawsock.Close(c)
    join(t)
end
