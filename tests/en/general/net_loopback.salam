import net.internal.rawsock
import sync

mut nloop wg := sync.NewWaitGroup()
func net server():
    srv := rawsock.Listen(19201)
    sync.Done(nloop wg)
    if !rawsock.Ok(srv):
        ret
    end
    c := rawsock.Accept(srv)
    if rawsock.Ok(c):
        data := rawsock.Recv(c, 1024)
        rawsock.Send(c, "got:" + data)
        rawsock.Close(c)
    end
    rawsock.Close(srv)
end

func main:
    sync.Add(nloop wg, 1 as i64)
    t := spawn(net server)
    sync.Wait(nloop wg)
    c := rawsock.Connect("127.0.0.1", 19201)
    println rawsock.Ok(c)
    rawsock.Send(c, "world")
    resp := rawsock.Recv(c, 1024)
    println resp
    rawsock.Close(c)
    join(t)
end
