import net.mime

func main:
    println mime.MimeType("index.html") == "text/html; charset=utf-8"
    println mime.MimeType("app.js") == "application/javascript"
    println mime.MimeType("photo.png") == "image/png"
    println mime.MimeType("mystery.xyz") == "application/octet-stream"
    println mime.StatusText(404) == "Not Found"
    println mime.StatusText(999) == "Unknown"

    ct := mime.ParseContentType("multipart/form-data; boundary=abc123; charset=utf-8")
    println ct.media_type == "multipart/form-data"
    println mime.ParamGet(ct, "boundary") == "abc123"
    println mime.ParamGet(ct, "charset") == "utf-8"
    println mime.ParamGet(ct, "missing") == ""

    mut w := mime.NewMultipartWriter()
    mime.WriteField(w, "name", "Ali")
    mime.WriteFileStr(w, "file", "hello.txt", "text/plain", "hello world")
    body := mime.CloseWriter(w)
    println body.len > 0
    println mime.ContentTypeHeader(w) == "multipart/form-data; boundary=" + w.boundary

    boundary := w.boundary
    parts := mime.ParseMultipart(body.data, body.len, boundary)
    println parts.items.len() == 2
    p0 := parts.items.get(0)
    println p0.name == "name"
    p1 := parts.items.get(1)
    println p1.name == "file"
    println p1.filename == "hello.txt"
    println p1.content_type == "text/plain"
    println p1.body.len == 11
end
