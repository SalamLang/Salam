package main

import compress
import encoding.binary
import net.mime

func main:
    mut raw := compress.NewByteBuf()
    binary.WriteU8(raw, 0)
    binary.WriteU8(raw, 255)
    binary.WriteU8(raw, 10)
    binary.WriteU8(raw, 0)
    binary.WriteU8(raw, 7)

    mut w := mime.NewMultipartWriter()
    mime.WriteFileBytes(w, "blob", "data.bin", "application/x-custom", raw.data, raw.len)
    mime.WriteFileBytes(w, "pic", "photo.png", "", raw.data, 3)
    body := mime.CloseWriter(w)

    parts := mime.ParseMultipart(body.data, body.len, w.boundary)
    println parts.items.Len()
    p0 := parts.items.get(0)
    println p0.name
    println p0.filename
    println p0.content_type
    println p0.body.len
    println compress.BufGet(p0.body, 0)
    println compress.BufGet(p0.body, 1)
    println compress.BufGet(p0.body, 3)
    println compress.BufGet(p0.body, 4)
    p1 := parts.items.get(1)
    println p1.name
    println p1.filename
    println p1.content_type
    println p1.body.len
    println compress.BufGet(p1.body, 1)
end
