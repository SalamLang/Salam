import net.tcp
import net.internal.poller

func main:
    srv := tcp.Bind(19701)
    println tcp.Ok(srv)

    mut p := poller.New()
    println poller.Register(p, srv.fd, poller.Readable)

    ev0 := poller.Wait(p, 0)
    println ev0.items.len() == 0

    client := tcp.Dial("127.0.0.1", 19701)
    println tcp.ConnOk(client)

    ev1 := poller.Wait(p, 2000)
    println ev1.items.len() == 1
    e0 := ev1.items.get(0)
    println e0.fd == srv.fd
    println e0.readable == true

    conn := tcp.Accept(srv)
    println tcp.ConnOk(conn)

    println poller.Unregister(p, srv.fd)

    println poller.Register(p, conn.fd, poller.Readable)
    tcp.Write(client, "ping")
    ev2 := poller.Wait(p, 2000)
    println ev2.items.len() == 1
    e1 := ev2.items.get(0)
    println e1.fd == conn.fd
    msg := tcp.Read(conn, 1024)
    println msg == "ping"

    println poller.Modify(p, conn.fd, poller.Writable)
    println poller.Unregister(p, conn.fd)

    tcp.Close(conn)
    tcp.Close(client)
    tcp.CloseServer(srv)
    poller.Close(p)
end
