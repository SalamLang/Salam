import net.router

func h1: ret end
func h2: ret end
func h3: ret end
func h4: ret end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/users/:id", funcptr(h1))
    router.Get(r, "/users/list", funcptr(h2))
    router.Get(r, "/files/*", funcptr(h3))
    router.Group(r, "/v1", "GET", "/status", funcptr(h4))

    // Static "/users/list" wins over ":id" even though the param route
    // was registered first - route priority, not registration order.
    m1 := router.Dispatch(r, "GET", "/users/list")
    println m1.matched == true
    println m1.fn == funcptr(h2)

    m2 := router.Dispatch(r, "GET", "/users/42")
    println m2.matched == true
    println m2.fn == funcptr(h1)
    println router.ParamGet(m2, "id") == "42"

    m3 := router.Dispatch(r, "GET", "/files/a/b/c.txt")
    println m3.matched == true
    println m3.fn == funcptr(h3)

    m4 := router.Dispatch(r, "POST", "/users/list")
    println m4.matched == false

    m5 := router.Dispatch(r, "GET", "/v1/status")
    println m5.matched == true
    println m5.fn == funcptr(h4)

    m6 := router.Dispatch(r, "GET", "/nope")
    println m6.matched == false

    mut r2 := router.NewRouter()
    println r2.has_static == false
    router.Static(r2, "/static/", "./public")
    println r2.has_static == true
    println r2.static_prefix == "/static/"
    println r2.static_dir == "./public"
    router.EnableListing(r2)
    println r2.static_listing == true
end
