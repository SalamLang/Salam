import net.internal.rawsock
import time

func main:
    srv := rawsock.Listen(19207)
    if !rawsock.Ok(srv):
        println "listen failed"
        ret
    end
    c := rawsock.Connect("127.0.0.1", 19207)
    a := rawsock.Accept(srv)

    rawsock.SetTimeout(c, 250)
    t0 := time.MonoMillis()
    rawsock.Recv(c, 16)
    waited := time.MonoMillis() - t0
    if waited >= 50 && waited < 5000:
        println "timeout fired"
    else:
        println "timeout NOT honoured"
    end

    rawsock.SetNonBlocking(c, true)
    t1 := time.MonoMillis()
    rawsock.Recv(c, 16)
    quick := time.MonoMillis() - t1
    if quick < 250:
        println "nonblocking immediate"
    else:
        println "nonblocking NOT honoured"
    end

    rawsock.Close(c)
    rawsock.Close(a)
    rawsock.Close(srv)
end
