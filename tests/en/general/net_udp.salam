import net.udp
import mem

func send_recv(sender: udp.Socket, receiver: udp.Socket, dest_host: str, dest_port: int, msg: str, max: int, tries: int): udp.Packet:
    mut attempt := 0
    mut p := udp.Packet {}
    until attempt < tries:
        udp.Send(sender, dest_host, dest_port, msg)
        p = udp.Receive(receiver, max)
        if p.data.len() > 0:
            ret p
        end
        attempt += 1
    end
    ret p
end

func main:
    srv := udp.Bind(0)
    println udp.Ok(srv)
    udp.SetTimeout(srv, 2000)
    srv_port := udp.Port(srv)

    c := udp.Open()
    println udp.Ok(c)
    udp.SetTimeout(c, 2000)

    p := send_recv(c, srv, "127.0.0.1", srv_port, "hello-udp", 1024, 5)
    println p.data == "hello-udp"

    resp := send_recv(srv, c, p.from_host, p.from_port, "echo:" + p.data, 1024, 5)
    println resp.data == "echo:hello-udp"

    udp.Close(c)
    udp.Close(srv)

    srv2 := udp.Bind(0)
    println udp.Ok(srv2)
    udp.SetTimeout(srv2, 2000)
    srv2_port := udp.Port(srv2)
    c2 := udp.Open()

    buf := mem.Allocate(5 as u64)
    bp := buf as i8*
    bp[0] = 65 as i8
    bp[1] = 0 as i8
    bp[2] = 66 as i8
    bp[3] = 67 as i8
    bp[4] = 68 as i8
    sent := udp.SendBytes(c2, "127.0.0.1", srv2_port, buf, 5)
    println sent == 5

    rbuf := mem.Allocate(16 as u64)
    mut fh := ""
    mut fp := 0
    mut n := udp.ReceiveBytes(srv2, rbuf, 16, fh, fp)
    mut attempt := 0
    until n <= 0 && attempt < 4:
        udp.SendBytes(c2, "127.0.0.1", srv2_port, buf, 5)
        n = udp.ReceiveBytes(srv2, rbuf, 16, fh, fp)
        attempt += 1
    end
    println n == 5
    rp := rbuf as i8*
    println rp[0] as int == 65
    println rp[1] as int == 0
    println rp[2] as int == 66
    println rp[3] as int == 67
    println rp[4] as int == 68
    mem.Free(buf)
    mem.Free(rbuf)
    udp.Close(c2)
    udp.Close(srv2)
end
