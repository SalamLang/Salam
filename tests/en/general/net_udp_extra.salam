package main

import net.udp

func main:
    srv := udp.BindOn("127.0.0.1", 0)
    println udp.Ok(srv)
    udp.SetTimeout(srv, 2000)
    srv_port := udp.Port(srv)
    println srv_port > 0

    c := udp.Open()
    udp.SetTimeout(c, 2000)
    udp.SetBroadcast(c, true)
    udp.SetBroadcast(c, false)

    mut got := udp.Packet {}
    mut tries := 0
    until got.data.len() == 0 and tries < 5:
        udp.SendTo(c, "127.0.0.1", srv_port, "via-sendto")
        got = udp.Receive(srv, 1024)
        tries++
    end
    println got.data
    println got.from_host

    println udp.JoinMulticast(srv, "not-an-address")
    println udp.LeaveMulticast(srv, "not-an-address")
    joined := udp.JoinMulticast(srv, "239.255.42.99")
    left := udp.LeaveMulticast(srv, "239.255.42.99")
    println left == joined
    println udp.LeaveMulticast(srv, "239.255.42.99")

    udp.Close(c)
    udp.Close(srv)
end
