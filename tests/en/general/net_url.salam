import net.url
import encoding.query

func main:
    u := url.Parse("https://user:pass@example.com:8443/a/b%20c?x=1&x=2&y=3#frag")
    println u.scheme
    println u.userinfo
    println u.host
    println u.port
    println u.path
    println u.raw_query
    println u.fragment
    println url.DecodedPath(u)
    println url.String(u) == "https://user:pass@example.com:8443/a/b%20c?x=1&x=2&y=3#frag"

    q := url.Query(u)
    xs := q.data.get("x") as query.QueryValues
    println xs.items.len() == 2
    x0 := xs.items.get(0)
    x1 := xs.items.get(1)
    println x0[0] == "1"
    println x1[0] == "2"

    u2 := url.Parse("//cdn.example.com/lib.js")
    println u2.scheme == ""
    println u2.host == "cdn.example.com"
    println u2.path == "/lib.js"

    u3 := url.Parse("/just/a/path?z=9")
    println u3.host == ""
    println u3.path == "/just/a/path"
    println u3.raw_query == "z=9"

    u4 := url.Parse("http://[::1]:9000/x")
    println u4.host == "::1"
    println u4.port == 9000
    println url.HostPort(u4) == "[::1]:9000"

    base := url.Parse("https://example.com/a/b/c")
    r1 := url.Join(base, "d")
    println url.String(r1) == "https://example.com/a/b/d"
    r2 := url.Join(base, "/root")
    println url.String(r2) == "https://example.com/root"
    r3 := url.Join(base, "https://other.com/x")
    println url.String(r3) == "https://other.com/x"

    println url.EncodePathSegment("a b/c") == "a%20b%2Fc"

    u5 := url.Parse("http://example.com:8080/api/v1")
    println u5.scheme == "http"
    println u5.host == "example.com"
    println u5.port == 8080
    println u5.path == "/api/v1"
end
