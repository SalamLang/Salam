import net.internal.rawsock
import sync
import str

func main:
    s := rawsock.Connect("127.0.0.1", 1)
    println rawsock.Ok(s)
    srv := rawsock.Listen(0)
    println rawsock.Ok(srv)
    rawsock.Close(srv)
    m := sync.NewMutex()
    println sync.Lock(m)
    println sync.Unlock(m)
    sync.Destroy(m)
    println str.FromInt(42 as i64)
    println str.FromFloat(3.5)
end
