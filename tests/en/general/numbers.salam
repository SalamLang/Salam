func main:
    println 0xFF
    println 0Xff
    println 0b1010
    println 0o17
    println 1_000_000
    println 0xDEAD_BEEF
    println 0b1111_0000
    big := 0xFFFF_FFFF_FF
    println big
    m := 0xFFFF_FFFF_FFFF_FFFF
    println m
end
