package main

import mem

if SALAM_OS_LINUX:
    extern:
        func setrlimit(what: int, limits: void*): int
        func getrlimit(what: int, limits: void*): int
    end
end

mut g_kept := 0 as i64

func show(p: void*):
    g_kept = p as i64
    println g_kept == 0
end

if SALAM_OS_LINUX:
    func limit_memory(): bool:
        raw := mem.AllocateZeroed(16 as u64)
        if getrlimit(9, raw) != 0:
            println "cannot read the memory limit"
            ret false
        end
        limits := raw as usize*
        limits[0] = (64 * 1024 * 1024) as usize
        if setrlimit(9, raw) != 0:
            println "cannot set the memory limit"
            ret false
        end
        ret true
    end
else:
    func limit_memory(): bool:
        ret false
    end
end

func main:
    if SALAM_OS_LINUX:
        if not limit_memory():
            ret
        end
        size := (1024 * 1024 * 1024) as u64
        show(mem.Allocate(size))
        show(mem.AllocateZeroed(size))
        show(mem.AllocateArray(size, 1 as u64))
        small := mem.Allocate(16 as u64)
        show(mem.Reallocate(small, size))
        show(mem.Allocate(16 as u64))
    else:
        println true
        println true
        println true
        println true
        println false
    end
end
