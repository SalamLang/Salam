package main

if SALAM_OS_LINUX:
    import mem
    import str

    extern:
        func setrlimit(what: int, limits: void*): int
        func getrlimit(what: int, limits: void*): int
        func prctl(option: int, value: u64): int
    end
else:
    extern:
        noret func exit(code: int)
    end
end

mut g_head := 0 as i64
mut g_word := "hello"

if SALAM_OS_LINUX:
    func limit_memory(): bool:
        raw := mem.AllocateZeroed(16 as u64)
        if getrlimit(9, raw) != 0:
            println "cannot read the memory limit"
            ret false
        end
        limits := raw as usize*
        limits[0] = (64 * 1024 * 1024) as usize
        if setrlimit(9, raw) != 0:
            println "cannot set the memory limit"
            ret false
        end
        _dump := prctl(4, 0 as u64)
        ret true
    end

    func exhaust(): bool:
        mut size := (1024 * 1024) as u64
        mut held := 0 as u64
        until size >= (8 as u64):
            mut p := mem.Allocate(size)
            until p != null:
                held += size
                if held > ((256 * 1024 * 1024) as u64):
                    println "the memory limit is not enforced"
                    ret false
                end
                q := p as i64*
                q[0] = g_head
                g_head = p as i64
                p = mem.Allocate(size)
            end
            size /= (2 as u64)
        end
        ret true
    end

    func run():
        if not limit_memory():
            ret
        end
        println "start"
        mut sb := str.NewBuilder()
        if not exhaust():
            ret
        end
        str.BufAppend(sb, g_word)
        println str.BufLen(sb)
    end
else:
    func run():
        println "start"
        printerrln "salam: out of memory"
        exit(134)
    end
end

func main:
    run()
end
