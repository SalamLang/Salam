import os

func main:
    w := open("open_builtin.tmp", "w")
    w.write("salam")
    w.close()
    r := open("open_builtin.tmp", "r")
    println r.read(5)
    r.close()
    names := listdir(".")
    println names.len() > 0
    println os.Remove("open_builtin.tmp") == 0
end
