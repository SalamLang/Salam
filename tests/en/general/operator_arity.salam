struct Money:
    pub cents: int = 0
    pub func operator -(): Money:
        ret Money { cents = 0 - this.cents }
    end
    pub func operator -(other: Money): Money:
        ret Money { cents = this.cents - other.cents }
    end
    pub func operator + (other: Money): Money:
        ret Money { cents = this.cents + other.cents }
    end
    pub func operator !(): bool:
        ret this.cents == 0
    end
    pub func operator **(n: f64): f64:
        ret (this.cents as f64) ** n
    end
end

func main:
    a := Money { cents = 250 }
    b := Money { cents = 100 }
    println (-a).cents
    println (a - b).cents
    println (a + (-b)).cents
    println !a
    println not Money {}
    println b ** 2.0
    x := 7
    println -(-x)
    println x - (-3)
    mut n := 1
    println (n++) + 10
    println n
end
