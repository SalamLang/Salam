struct Vector2:
    pub x: int = 0
    pub y: int = 0
    pub func operator + (other: Vector2): Vector2: ret Vector2 { x = this.x + other.x, y = this.y + other.y }
    end
    pub func operator -(other: Vector2): Vector2: ret Vector2 { x = this.x - other.x, y = this.y - other.y }
    end
    pub func operator -(): Vector2: ret Vector2 { x = -this.x, y = -this.y }
    end
    pub func operator == (other: Vector2): bool: ret this.x == other.x && this.y == other.y
    end
end

struct Bag:
    pub data: int[4] = [0, 0, 0, 0]
    pub func operator [](i: int): int:
        ret this.data[i]
    end
    pub func operator [] = (i: int, v: int):
        this.data[i] = v
    end
end

func main:
    a := Vector2 { x = 3, y = 4 }
    b := Vector2 { x = 1, y = 2 }
    c := a + b
    println c.x
    println c.y
    d := a - b
    println d.x
    println d.y
    e := -a
    println e.x
    println e.y
    a2 := Vector2 { x = 3, y = 4 }
    println a == a2
    println a == b
    println a != b
    mut f := Vector2 { x = 1, y = 1 }
    f += b
    println f.x
    println f.y
    mut bag := Bag {}
    bag[0] = 10
    bag[1] = 20
    bag[2] = 30
    println bag[0]
    println bag[1]
    println bag[2]
end
