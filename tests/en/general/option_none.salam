import core

func main:
    s := core.Some(7)
    n := core.None() as core.Option<int> println core.Unwrap(s), core.UnwrapOr(n, 42)
    println core.IsSome(n), core.IsNone(n)
    println core.Expect(s, "present")
    m := core.None() as core.Option<str> println core.UnwrapOr(m, "default")
end
