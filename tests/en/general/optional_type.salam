struct Client:
    pub host: str
    pub port: int?
    pub name: str? = "anon"
    pub ratio: f64?
    pub big: i64?
end

struct Pair<T>:
    pub left: T?
    pub right: T?
end

func find(key: str): int?:
    if key == "a":
        ret 1
    end
    ret null
end

func show(label: str, v: int?):
    if v.IsSome():
        println label, v.value
    else:
        println label, "none"
    end
end

func withdefault(v: int? = null): int:
    ret v.UnwrapOr(7)
end

func main:
    a := Client { host = "x" }
    println a.port.IsNone(), a.name.value, a.ratio.present
    mut b := Client {
        host = "y",
        port = 80,
        name = null,
        ratio = 2,
        big = 9
    }
    println b.port.value, b.name.IsNone(), b.ratio.value, b.big.value
    b.port = 443
    println b.port.Unwrap()
    b.port = null
    println b.port.UnwrapOr(0)
    show("one", 5)
    show("two", null)
    show("three", find("a"))
    show("four", find("z"))
    println withdefault(), withdefault(3)
    mut x := 4 as int?
    println x.value
    x = null
    println x.IsNone()
    y := "text" as str?
    z := (2 as int?).Unwrap() + 1
    println z
    println y.Unwrap()
    p := Pair { left = 1, right = null } as Pair<int>
    println p.left.value, p.right.IsSome()
    q := Pair { left = "l" } as Pair<str>
    println q.left.value, q.right.IsNone()
    t := 3 > 2 ? 1 : 0
    println t, 5 as i64 > 2 ? "yes" : "no"
end
