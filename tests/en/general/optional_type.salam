struct Client:
    pub host: str
    pub port: int?
    pub name: str? = "anon"
    pub ratio: f64?
    pub big: i64?
end

struct Pair<T>:
    pub left: T?
    pub right: T?
end

func find(key: str): int?:
    if key == "a":
        ret 1
    end
    ret null
end

func show(label: str, v: int?):
    if v.is_some():
        println label, v.value
    else:
        println label, "none"
    end
end

func withdefault(v: int? = null): int:
    ret v.unwrap_or(7)
end

func main:
    a := Client { host = "x" }
    println a.port.is_none(), a.name.value, a.ratio.present
    mut b := Client { host = "y", port = 80, name = null, ratio = 2, big = 9 }
    println b.port.value, b.name.is_none(), b.ratio.value, b.big.value
    b.port = 443
    println b.port.unwrap()
    b.port = null
    println b.port.unwrap_or(0)
    show("one", 5)
    show("two", null)
    show("three", find("a"))
    show("four", find("z"))
    println withdefault(), withdefault(3)
    mut x := 4 as int?
    println x.value
    x = null
    println x.is_none()
    y := "text" as str?
    z := (2 as int?).unwrap() + 1
    println z
    println y.unwrap()
    p := Pair { left = 1, right = null } as Pair<int>
    println p.left.value, p.right.is_some()
    q := Pair { left = "l" } as Pair<str>
    println q.left.value, q.right.is_none()
    t := 3 > 2 ? 1 : 0
    println t, 5 as i64 > 2 ? "yes" : "no"
end
