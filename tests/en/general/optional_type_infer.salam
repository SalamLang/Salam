import option

func accept<T>(value: T?): bool:
    ret value.is_some()
end

func pick<T>(value: T?, fallback: T): T:
    ret value.unwrap_or(fallback)
end

func main:
    println accept(1), accept("a"), accept(option.Some(2))
    println pick(5, 1), pick(null, 7), pick("s", "t")
    o := 4 as int?
    println pick(o, 0)
end
