import encoding.json

struct Cfg:
    pub host: str
    pub port: int?
    pub name: str?
    @json "" "omitempty"
    pub tag: str?
end

func main throws:
    mut c := Cfg { host = "" }
    try json.Unmarshal("{\"host\":\"h\",\"port\":80,\"name\":null}", c)
    println c.host, c.port.value, c.name.is_none(), c.tag.is_none()
    mut d := Cfg { host = "" }
    try json.Unmarshal("{\"host\":\"h\"}", d)
    println d.port.is_none()
    println json.Marshal(c)
    println json.Marshal(Cfg { host = "x", name = "n", tag = "t" })
end
