import encoding.json

struct Cfg:
    pub port: int?
    pub name: str?
    pub tags: Vector<int>?
end

func main throws:
    mut c := Cfg {}
    try json.Unmarshal("{\"port\":80,\"name\":\"n\",\"tags\":[1,2]}", c)
    println c.port.value, c.name.value, c.tags.value.len()
    try json.Unmarshal("{\"port\":null,\"name\":null,\"tags\":null}", c)
    println c.port.is_none(), c.port.value, c.name.is_none(), c.name.value.len(), c.tags.is_none(), c.tags.value.len()
    try json.Unmarshal("{\"tags\":[3]}", c)
    println c.tags.value.len(), c.tags.value.get(0)
end
