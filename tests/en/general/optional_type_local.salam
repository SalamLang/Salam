struct Client:
    pub host: str = "h"
    pub name: str?
end

func main:
    mut a: int?
    a = 5
    println a.value
    a = null
    println a.is_none()
    mut s: str?
    s = null
    println s.present, s
    s = "text"
    println s.value
    mut c: Client
    c = Client {}
    println c.name.is_none()
end
