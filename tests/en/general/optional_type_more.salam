type MaybeInt = int?

struct Named:
    pub n: str?
end

struct Point:
    pub x: int = 0
end

struct Holder:
    pub p: Point?
    pub m: MaybeInt = null
    pub items: Vector<int?> = Vector {}
    pub func set(v: int?):
        this.m = v
    end
    pub func get(): int?:
        ret this.m
    end
end

interface Lookup:
    func look(k: int): int?
end

struct Table:
    pub base: int = 10
    pub func look(k: int): int?:
        if k > 0:
            ret this.base + k
        end
        ret null
    end
end

func first<T>(v: Vector<T>): T?:
    if v.len() > 0:
        ret v.get(0)
    end
    ret null
end

func orzero<T>(v: T?, z: T): T:
    ret v.unwrap_or(z)
end

func main:
    println Named {}
    println (Named {}).n.value.len()
    mut h := Holder { p = Point { x = 3 } }
    println h.p.value.x, h.m.is_none()
    h.set(5)
    println h.get().value
    h.set(null)
    println h.get().is_none()
    h.items.push(1 as int?)
    h.items.push(null as int?)
    println h.items.get(0).value, h.items.get(1).present
    t := Table {}
    d := t as dyn Lookup
    println d.look(1).value, d.look(0).is_none()
    mut v := Vector {} as Vector<str>
    println first(v).is_none()
    v.push("a")
    println first(v).value
    println orzero(first(v), "z")
    f := (n: int?): ret n.unwrap_or(1) + 1 end
    println f(2), f(null)
    w := Point { x = 7 } as Point?
    println w.value.x
    c := h
    println c.p.value.x
    println 2 > 1 ? 1 as int : 0
end
