import core

struct Box:
    pub v: int?
end

func main:
    b := Box { v = core.Some(3) }
    println core.UnwrapOr(b.v, 0)
    c := Box { v = core.None() as core.Option<int> }
    println core.IsNone(c.v)
    o := b.v
    println o.value
    println b.v.IsSome(), c.v.IsNone(), b.v.Unwrap(), c.v.UnwrapOr(9)
end
