import option

struct Box:
    pub v: int?
end

func main:
    b := Box { v = option.Some(3) }
    println option.UnwrapOr(b.v, 0)
    c := Box { v = option.None() as option.Option<int> }
    println option.IsNone(c.v)
    o := b.v
    println o.value
    println b.v.is_some(), c.v.is_none(), b.v.unwrap(), c.v.unwrap_or(9)
end
