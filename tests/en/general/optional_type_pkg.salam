include conf "@/_optlib/_conf.salam"

func main:
    a := conf.Conf { host = "x" }
    println a.port.is_none(), a.name.value
    b := conf.Conf { host = "y", port = 8, name = null }
    println b.port.value, b.name.present
    println conf.Port(a), conf.Port(b), conf.Port(conf.Make(3)), conf.Port(conf.Make(null))
end
