import encoding.json

struct Conn:
    pub host: str
    pub timeout: int?
    pub user: str?
    pub pass: str?
    pub token: str?
    pub retries: int? = 3
    pub mark: str?
    pub n: int?
    pub m: int?
    rule user needs pass
    rule oneof(user, token)
    rule n == 5 needs m
    rule retries == 9 needs mark
    rule mark == "x" needs timeout
end

func show(text: str):
    mut r := Conn { host = "", token = "" }
    try:
        json.Unmarshal(text, r)
        println "ok", r.host, r.n.unwrap_or(0), r.m.unwrap_or(0)
    catch e:
        println "err", e.message
    end
end

func main:
    a := Conn { host = "a", user = "u", pass = "p" }
    println a.user.unwrap_or("-"), a.timeout.is_none(), a.retries.unwrap_or(0)
    b := Conn { host = "b", token = "t", timeout = 5, n = 4 }
    println b.token.unwrap_or("-"), b.timeout.unwrap_or(0), b.n.unwrap_or(0)
    c := Conn { host = "c", token = "t", n = 5, m = 1, retries = 9, mark = "y" }
    println c.m.unwrap_or(0), c.mark.unwrap_or("-")
    d := Conn { host = "d", token = "t", n = null }
    println d.n.is_none()
    show(`{"host":"h","token":"t"}`)
    show(`{"host":"h","token":"t","n":4}`)
    show(`{"host":"h","token":"t","n":null}`)
    show(`{"host":"h","token":"t","n":5,"m":1}`)
    show(`{"host":"h","token":"t","n":5}`)
    show(`{"host":"h","user":"u"}`)
    println json.Schema(Conn { host = "", token = "" })
end
