import collections
import conv

// A struct in another package holding an OrderedMap, which is how
// config.Config and envfile.Doc use it.
struct Holder:
    pub m: collections.OrderedMap = collections.OrderedMap {}
end

func dump(h &: Holder):
    mut i := 0
    until i < h.m.len():
        print h.m.key_at(i)
        print "="
        print h.m.val_at(i)
        print ";"
        i += 1
    end
    println ""
end

func main:
    mut h := Holder {}
    defer h.m.free()

    // set reports the position it used: appends land at the end
    println h.m.set("b", "2")
    println h.m.set("a", "1")
    println h.m.set("c", "3")
    println h.m.len()

    // overwriting keeps the entry where it already was
    println h.m.set("b", "two")
    println h.m.len()
    println h.m.get("b")

    // iteration is insertion order, not hash bucket order
    dump(h)

    println h.m.has("a")
    println h.m.has("zz")
    println h.m.get("zz")
    println h.m.get_or("zz", "def")
    println h.m.index_of("c")
    println h.m.index_of("zz")
    println h.m.key_at(0)
    println h.m.val_at(0)
    println h.m.key_at(99)
    println h.m.val_at(0 - 1)

    h.m.set_at(0, "TWO")
    println h.m.get("b")
    h.m.set_at(99, "ignored")
    println h.m.len()

    // removing shifts later entries down and moves their positions with
    // them, so lookups after a remove still land on the right entry
    println h.m.remove("a")
    println h.m.len()
    dump(h)
    println h.m.index_of("c")
    println h.m.get("c")
    println h.m.remove("a")

    // keys built at runtime, never literals, must still match
    src := "hello=world"
    h.m.set(src.substr(0, 5), "w")
    println h.m.get("hello")
    println h.m.index_of("hello")

    // order survives the growth that rehashes the index
    mut n := 0
    until n < 300:
        h.m.set("k".concat(conv.FormatInt(n as i64)), conv.FormatInt(n as i64))
        n += 1
    end
    println h.m.len()
    println h.m.get("k250")
    println h.m.key_at(3)
    println h.m.key_at(h.m.len() - 1)

    keys := h.m.clone_keys()
    defer keys.free()
    println keys.len()
    println keys.get(0)
    ret 0
end
