import collections
import conv

struct Holder:
    pub m: collections.OrderedMap = collections.OrderedMap {}
end

func dump(h &: Holder):
    mut i := 0
    until i < h.m.Len():
        print h.m.KeyAt(i)
        print "="
        print h.m.ValAt(i)
        print ";"
        i++
    end
    println ""
end

func main:
    mut h := Holder {}
    defer h.m.Free()

    println h.m.Set("b", "2")
    println h.m.Set("a", "1")
    println h.m.Set("c", "3")
    println h.m.Len()

    println h.m.Set("b", "two")
    println h.m.Len()
    println h.m.Get("b")

    dump(h)

    println h.m.Has("a")
    println h.m.Has("zz")
    println h.m.Get("zz")
    println h.m.GetOr("zz", "def")
    println h.m.IndexOf("c")
    println h.m.IndexOf("zz")
    println h.m.KeyAt(0)
    println h.m.ValAt(0)
    println h.m.KeyAt(99)
    println h.m.ValAt(0 - 1)

    h.m.SetAt(0, "TWO")
    println h.m.Get("b")
    h.m.SetAt(99, "ignored")
    println h.m.Len()

    println h.m.Remove("a")
    println h.m.Len()
    dump(h)
    println h.m.IndexOf("c")
    println h.m.Get("c")
    println h.m.Remove("a")

    src := "hello=world"
    h.m.Set(src.Substr(0, 5), "w")
    println h.m.Get("hello")
    println h.m.IndexOf("hello")

    mut n := 0
    until n < 300:
        h.m.Set("k".Concat(conv.FormatInt(n as i64)), conv.FormatInt(n as i64))
        n++
    end
    println h.m.Len()
    println h.m.Get("k250")
    println h.m.KeyAt(3)
    println h.m.KeyAt(h.m.Len() - 1)

    keys := h.m.CloneKeys()
    defer keys.Free()
    println keys.Len()
    println keys.Get(0)
    ret 0
end
