import os
import filepath
import io
import str

if SALAM_OS_WINDOWS:
    func _link(_target: str, _path: str): int:
        ret 0 - 1
    end
else:
    extern:
        func symlink(target: str, path: str): int
    end

    func _link(target: str, path: str): int:
        ret symlink(target, path)
    end
end

func main:
    base := filepath.Join(os.TempDir(), "salam_real_path")
    os.RemoveAll(base)
    os.MkdirAll(filepath.Join(base, "real"))
    root := os.RealPath(base)
    println str.Len(root) > 0
    println filepath.IsAbs(root)
    io.WriteFile(filepath.Join(base, "real/a.txt"), "x")
    file := os.RealPath(filepath.Join(base, "real/a.txt"))
    println str.EndsWith(file, "a.txt")
    println str.StartsWith(file, root)
    println os.RealPath(filepath.Join(base, "missing")) == ""
    linked := _link(filepath.Join(base, "real"), filepath.Join(base, "alias")) == 0
    through := filepath.Join(base, "alias/a.txt")
    println not linked or os.RealPath(through) == file
    println os.RemoveAll(base)
end
