import os
import filepath
import io

if SALAM_OS_WINDOWS:
    func _link(target: str, path: str): int:
        ret 0 - 1
    end
else:
    extern:
        func symlink(target: str, path: str): int
    end

    func _link(target: str, path: str): int:
        ret symlink(target, path)
    end
end

func main:
    base := filepath.Join(os.TempDir(), "salam_removeall_links")
    tree := filepath.Join(base, "tree")
    keep := filepath.Join(base, "keep")
    os.RemoveAll(base)
    os.MkdirAll(tree)
    os.MkdirAll(keep)
    io.WriteFile(filepath.Join(keep, "precious.txt"), "stay")
    io.WriteFile(filepath.Join(tree, "plain.txt"), "gone")
    _link(keep, filepath.Join(tree, "to_dir"))
    _link("no_such_target", filepath.Join(tree, "dangling"))
    println os.RemoveAll(tree)
    println os.Exists(tree)
    println io.ReadFile(filepath.Join(keep, "precious.txt"))
    println os.RemoveAll(base)
    println os.Exists(base)
end
