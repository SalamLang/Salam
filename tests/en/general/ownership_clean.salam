import mem
import str

func trim_slashes(p: str): str:
    mut q := str.Clone(p)
    until q.len() > 1 and str.EndsWith(q, "/"):
        shorter := q.substr(0, q.len() - 1)
        mem.Free(q as void*)
        q = shorter
    end
    ret q
end

func rows(n: int): int:
    mut prev := Vector {} as Vector<int>
    prev.push(1)
    repeat n in i:
        mut cur := Vector {} as Vector<int>
        cur.push(1)
        repeat prev.len() - 1 in k:
            cur.push(prev.get(k) + prev.get(k + 1))
        end
        cur.push(1)
        prev.free()
        prev = cur
        if i < 0:
            break
        end
    end
    total := prev.len()
    prev.free()
    ret total
end

func main:
    t := trim_slashes("a/b///")
    println t
    mem.Free(t as void*)

    mut v := Vector {} as Vector<int>
    defer v.free()
    v.push(1)
    v.free()
    v.push(2)
    v.push(3)
    first := v.ref(0)
    println first[0], v.len()

    mut s := "x" + str.FromInt(1)
    mem.Free(s as void*)
    s = "y" + str.FromInt(2)
    println s
    mem.Free(s as void*)

    println rows(4)
end
