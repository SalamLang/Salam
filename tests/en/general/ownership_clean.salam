import mem
import str

func trim_slashes(p: str): str:
    mut q := str.Clone(p)
    until q.Len() > 1 and str.EndsWith(q, "/"):
        shorter := q.Substr(0, q.Len() - 1)
        mem.Free(q as void*)
        q = shorter
    end
    ret q
end

func rows(n: int): int:
    mut prev := Vector {} as Vector<int>
    prev.Push(1)
    repeat n in i:
        mut cur := Vector {} as Vector<int>
        cur.Push(1)
        repeat prev.Len() - 1 in k:
            cur.Push(prev.Get(k) + prev.Get(k + 1))
        end
        cur.Push(1)
        prev.Free()
        prev = cur
        if i < 0:
            break
        end
    end
    total := prev.Len()
    prev.Free()
    ret total
end

func main:
    t := trim_slashes("a/b///")
    println t
    mem.Free(t as void*)

    mut v := Vector {} as Vector<int>
    defer v.Free()
    v.Push(1)
    v.Free()
    v.Push(2)
    v.Push(3)
    first := v.Ref(0)
    println first[0], v.Len()

    mut s := "x" + str.FromInt(1)
    mem.Free(s as void*)
    s = "y" + str.FromInt(2)
    println s
    mem.Free(s as void*)

    println rows(4)
end
