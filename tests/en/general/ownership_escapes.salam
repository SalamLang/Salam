import str

extern:
    pure func strstr(haystack: str, needle: str): str
end

mut g_keep := Vector {} as Vector<int>

func tail(n: int): str:
    s := "head-" + str.FromInt(n as i64) + "-suffix-and-more-padding-text"
    ret strstr(s, "suffix")
end

func grow_keep(v &: Vector<int>):
    v.push(41)
    v.push(42)
    g_keep = v
end

func work():
    mut tmp := Vector {} as Vector<int>
    grow_keep(tmp)
    println tmp.len()
end

func buffer(): int*:
    mut v := Vector {} as Vector<int>
    v.push(11)
    v.push(22)
    ret v.data
end

func main:
    t := tail(7)
    work()
    p := buffer()
    mut junk := Vector {} as Vector<str>
    repeat 64 in i:
        junk.push("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" + str.FromInt(i as i64))
    end
    println t
    println g_keep.get(0), g_keep.get(1)
    println p[0], p[1]
    println junk.len()
end
