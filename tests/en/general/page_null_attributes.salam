import str

struct Work:
    pub title: str?
    pub note: str?
    pub n: int?
end

page Row(w: Work):
    link:
        url = "/x"
        title = w.note
        content = w.title
    end
    box:
        width = w.n
    end
end

func show(h: str):
    i := str.IndexOf(h, "<body>")
    j := str.IndexOf(h, "</body>")
    println str.Substr(h, i + 6, j - i - 6)
end

func main:
    show(Row(Work { title = "t" }))
    show(Row(Work { title = "t", note = "nn", n = 5 }))
    show(Row(Work { note = "null" }))
end
