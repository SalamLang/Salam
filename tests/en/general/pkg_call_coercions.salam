include pc "_pkgcoerce.salam"
include shapes "_pkgcoerce.salam"
include drv "_pkgcoerce_drv.salam"

struct Sq:
    pub s: int = 0
    pub func Area(): int: ret this.s + 1000 end
end

func main:
    println pc.AreaOf(pc.Sq { s = 3 })
    println pc.AreaOf(pc.Tri { b = 4, h = 5 })
    println pc.Between(1, pc.Sq { s = 2 }, 3)
    println pc.AreaOf(Sq { s = 1 })
    held := pc.Sq { s = 7 } as dyn pc.Shape
    println pc.AreaOf(held)

    println pc.Show(5)
    println pc.Show("hi")
    boxed := 8 as Variant<int, str>
    println pc.Show(boxed)
    n := 11
    println pc.Show(n)
    println pc.ShowSq(pc.Sq { s = 2 })
    println pc.ShowSq("t")

    println pc.DefaultText(1)
    println pc.DefaultText(1, 2)
    println pc.DefaultNum(2)
    println pc.DefaultNum(2, "y")
    println pc.DefaultShape(1)
    println pc.DefaultShape(1, pc.Tri { b = 2, h = 3 })
    println pc.DefaultTail(3)
    println pc.DefaultTail("t", "z")

    m := pc.Maker { tag = 10 }
    println m.Take(pc.Sq { s = 3 })
    println m.TakeValue(4)
    println m.TakeValue("q")
    taker := pc.Maker { tag = 20 } as dyn pc.Taker
    println taker.Take(pc.Sq { s = 2 })
    println taker.TakeValue("r")

    println pc.GenShape(1, pc.Sq { s = 3 })
    println pc.GenShape("a", Sq { s = 2 })
    println pc.GenValue(1, 4)
    println pc.GenValue(1, "z")
    println pc.GenDefault(1)

    println pc.Pick(pc.Sq { s = 3 })
    println pc.Pick(1, 2)
    println pc.Pick(1, "s")

    println pc.Maker.Measure(pc.Sq { s = 3 })
    println pc.Maker.Label(4)
    println pc.Maker.Label("r")

    f := pc.GetOnShape()
    println f(pc.Sq { s = 3 })
    g := pc.GetOnValue()
    println g(4)
    println g("w")
    println pc.GetOnValue()("c")
    h := pc.MakeHold()
    println h.on_shape(pc.Sq { s = 4 })
    println h.on_value(5)
    println h.on_value("e")
    gs := pc.OnShape
    println gs(pc.Sq { s = 5 })
    gv := pc.OnValue
    println gv(6)
    println gv("g")

    println pc.Wide(5)
    c := 7 as i16
    println pc.Wide(c)

    mut r := 1
    println pc.Mix(r, pc.Sq { s = 2 }, 3, 4, 5)
    println pc.Mix(r, Sq { s = 2 }, "t", null, 6)
    println r

    println shapes.AreaOf(shapes.Sq { s = 6 })
    println shapes.Show("alias")

    println drv.Run(drv.Mem { n = 1 })
    println drv.Run(drv.MakeSq(3))
    println drv.ShowVia(drv.MakeSq(4))
    println drv.ShowVia("x")
    println drv.RunDefault(1)
    println drv.ShowDefault(1)
    println drv.ShowDefault(1, "y")
end
