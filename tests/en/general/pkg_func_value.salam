package main

import pkghandlers "_pkghandlers.salam"

func local_one(ctx: i64):
    println "main.local_one ", ctx
end

func main:
    a := pkghandlers.home
    b := pkghandlers.about
    c := local_one
    d := &pkghandlers.home
    println (d as i64) == a
    callhandler(a, 1)
    callhandler(b, 2)
    callhandler(c, 3)
end
