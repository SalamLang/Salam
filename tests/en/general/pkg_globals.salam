package main

import pkgconsta "_pkgconst_a.salam"
import pkgconstb "_pkgconst_b.salam"

const COLS := "main-cols"

func main:
    println pkgconsta.Get(), " ", pkgconstb.Get(), " ", COLS
    println pkgconsta.Bump(), " ", pkgconstb.Bump()
    println pkgconsta.Bump(), " ", pkgconstb.Bump()
end
