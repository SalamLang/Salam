include samenamea "_samename_a.salam"
include u "_samename_v.salam"

const LIMIT := 99

enum Color:
    Blue
    Green
    Red
end

struct Item:
    pub label: str = "main"

    pub func show(): str:
        ret "main item " + this.label
    end
end

func inner<T>(_x: T): str:
    ret "main inner"
end

func main:
    println samenamea.Make(1)
    println samenamea.Make("s")
    w := samenamea.Wrap(1, samenamea.Item {})
    h := samenamea.Holder { v = 2 } as samenamea.Holder<int>
    println w.show(), h.describe(), samenamea.Name(samenamea.Color.Red)
    c := Color.Red
    m := Item {}
    println m.show(), LIMIT, u.Tag(), c == Color.Red, c as int, inner(2.5)
end
