package main

import litalpha "_litalpha.salam"
import litbeta "_litbeta.salam"

func main:
    x := litalpha.Input { a = "x" }
    y := litbeta.Input { n = 9 }
    println litalpha.Show(x)
    println litbeta.Show(y)
end
