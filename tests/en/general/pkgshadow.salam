import filepath

func extlen(filepath: str): int:
    ret filepath.len()
end

func main:
    println filepath.Ext("a/b.c")
    println extlen("hello.txt")
    filepath := "abc/def.txt"
    println filepath.len()
    println filepath.substr(0, 3)
end
