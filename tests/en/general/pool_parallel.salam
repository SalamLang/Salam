import pool
import sync
import mem

mut out := null as i64*
mut hits := 0 as i64
mut mu := sync.NewMutex()

// Each index is written by exactly one worker, so no lock is needed on `out`
// itself - only on the counter that proves every index ran exactly once.
func square_at(i: i64):
    o := out
    o[i] = i * i
    sync.Lock(mu)
    hits = hits + 1
    sync.Unlock(mu)
end

func main:
    n := 500 as i64
    out = mem.AllocateZeroed((n * 8) as u64) as i64*

    pool.ParallelFor(n, 4 as i64, (i: i64): square_at(i) end)

    mut total := 0 as i64
    mut i := 0 as i64
    until i < n:
        total = total + out[i]
        i = i + 1
    end

    println "hits:", hits
    println "total:", total
    println "cpus>=1:", pool.CPUCount() >= 1

    // A degenerate range must be a no-op, not a hang or a crash.
    pool.ParallelFor(0 as i64, 4 as i64, (i: i64): square_at(i) end)
    println "empty ok"

    mem.Free(out as void*)
    sync.Destroy(mu)
end
