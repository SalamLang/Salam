import mem

struct Edge:
    pub dst: int = 0
end

struct Holder:
    pub cells: Edge**= null
end

func main:
    println 2 ^^ 10
    println 2 ^^ 3 ^^ 2
    println 2 + 3 * 4 ^^ 2 - 6 / 3
    a := 3
    println (0 - a) ^^ 2
    println a as f64 ^^ 2

    mut p := 2.0
    p ^^= 5
    println p
    println 9.0 ^^ 0.5

    println 5 ^ 3
    println 5 ^ 3 ^ 1
    mut z := 5
    z ^= 3
    println z

    println 1 ^ 2 ^^ 3 as int

    println a * 2
    cell := mem.Allocate(sizeof(Edge) as u64) as Edge*
    cell[0] = Edge { dst = 7 }
    slot := mem.Allocate(8 as u64) as Edge**
    slot[0] = cell
    h := Holder { cells = slot }
    println h.cells[0].dst
    mem.Free(slot as void*)
    mem.Free(cell as void*)
end
