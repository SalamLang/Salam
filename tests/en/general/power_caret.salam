// Power is `^^`; `^` on its own is still bitwise XOR, and `*` is only
// multiplication and the pointer suffix. The three have to coexist without
// the lexer stealing characters from one another.

import mem

struct Edge:
    pub dst: int = 0
end

struct Holder:
    pub cells: Edge** = null
end

func main:
    // Power, right-associative, tighter than * and unary minus.
    println 2 ^^ 10
    println 2 ^^ 3 ^^ 2
    println 2 + 3 * 4 ^^ 2 - 6 / 3
    a := 3
    println (0 - a) ^^ 2
    println a as f64 ^^ 2

    // Always a float result, hence the f64 target.
    mut p := 2.0
    p ^^= 5
    println p
    println 9.0 ^^ 0.5

    // XOR is untouched, including its compound form.
    println 5 ^ 3
    println 5 ^ 3 ^ 1
    mut z := 5
    z ^= 3
    println z

    // Precedence between the two: ^^ binds tighter than ^.
    println 1 ^ 2 ^^ 3 as int

    // `*` is multiplication next to a pointer suffix in the same file.
    println a * 2
    cell := mem.Allocate(sizeof(Edge) as u64) as Edge*
    cell[0] = Edge { dst = 7 }
    slot := mem.Allocate(8 as u64) as Edge**
    slot[0] = cell
    h := Holder { cells = slot }
    println h.cells[0].dst
    mem.Free(slot as void*)
    mem.Free(cell as void*)
end
