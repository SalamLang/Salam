struct Vec2:
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub func **(n: f64): Vec2:
        ret Vec2 { x = this.x ** n, y = this.y ** n }
    end
end

func main:
    println 2 ** 10
    println 2 ** 3 ** 2
    println -2 ** 2
    println 1.5 ** 2.0
    println 2 ** 10 == 2 ** 10
    println 2 * 3 ** 2
    println (2 * 3) ** 2
    x := 3
    println x as i64 ** 2
    mut acc := 3.0
    acc **= 3.0
    println acc
    mut old := 3.0
    old **= 3.0
    println old == acc
    v := Vec2 { x = 2.0, y = 3.0 } ** 2.0
    println v.x, v.y
end
