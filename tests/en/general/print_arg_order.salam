mut n := 0

func bump(): int:
    n = n + 1
    ret n
end

func main:
    println bump(), bump(), bump(), bump()

    n = 0
    println bump(), "-", bump()

    n = 0
    printerrln bump()
    println "err evals:", n

    n = 0
    printerrln bump(), bump()
    println "err evals:", n
end
