 */

mut n := 0

func bump(): int:
    n = n + 1
    ret n
end

func main:
    /*
     * Print arguments must be evaluated in source order. C leaves the order
     * of call arguments unspecified and the two supported compilers disagree
     * - gcc goes right to left, tcc left to right - so the print lowering
     * binds each argument to its own declaration inside the statement
     * expression, which is sequenced. Without that this line printed
     * "4 3 2 1" under one compiler and "1 2 3 4" under the other, and the
     * difference went unnoticed because nothing tested it.
     */
    println bump(), bump(), bump(), bump()

    n = 0
    println bump(), "-", bump()

    /*
     * The stderr path names its argument list twice - once with a null
     * snprintf to size the buffer, once to fill it - so an argument with a
     * side effect ran twice. It has to advance the counter by exactly one,
     * whatever the argument count.
     */
    n = 0
    printerrln bump()
    println "err evals:", n

    n = 0
    printerrln bump(), bump()
    println "err evals:", n
end
