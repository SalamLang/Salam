func side(tag: str): str:
    println "side", tag
    ret tag
end

func main:
    s := "abc"
    n := 42
    big := 18446744073709551615 as u64
    neg := -9223372036854775807 as i64 - 1
    println "[" + s + "]"
    println "n=" + n + " ok=" + true + " f=" + 2.5
    println "call:" + side("x") + "|" + side("y")
    println "edge", big, neg, 0, -1
    print "a" + s
    print " b\n"
    println "c:" + 'z'
end
