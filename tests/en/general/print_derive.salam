// `println <aggregate>` derives a stringify function for the type and prints
// what it returns. Fields stay readable whether or not they are `pub`.

import mem

enum Color:
    Red
    Green
end

struct Point:
    x: int
    y: int
end

struct Node:
    pub id: int
    pub next: Node*
end

struct Mixed:
    pub flag: bool
    pub ratio: f64
    pub label: str
    pub tint: Color
    pub inner: Point
end

struct Box<T>:
    pub v: T
end

struct Money:
    pub cents: int

    pub func to_str(): str:
        ret "$" + (this.cents / 100) + "." + (this.cents % 100)
    end
end

func main:
    p := Point {x = 10, y = 15}
    println p

    pts := [Point {x = 10, y = 15}, Point {x = 20, y = 25}] as Point[2]
    println pts

    names := ["ali", "reza", "hamid"] as str[3]
    println names

    grid := [[1, 2], [3, 4]] as int[2][2]
    println grid

    println Mixed {
        flag = true, ratio = 2.5, label = "hi", tint = Color.Green, inner = p
    }

    println Node {id = 2, next = null}
    raw := mem.Allocate(64 as u64)
    defer mem.Free(raw)
    tail := raw as Node*
    tail[0] = Node {id = 2, next = null}
    println Node {id = 1, next = tail}

    println Money {cents = 1234}
    println Box {v = 7} as Box<int>
    println Box {v = p} as Box<Point>

    mut v := Vector {} as Vector<int> defer v.free()
    v.push(3)
    v.push(4)
    println v

    mut vp := Vector {} as Vector<Point> defer vp.free()
    vp.push(Point {x = 1, y = 2})
    println vp

    mut m := HashMap {} as HashMap<str, int>
    m.put("a", 1)
    println m

    mut mp := HashMap {} as HashMap<str, Point>
    mp.put("origin", Point {x = 0, y = 0})
    println mp

    println "before", p, "after"
    ret 0
end
