import filepath
import os
import os.process

func exit_three(): process.SpawnOptions:
    mut args := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        args.push("/C")
        args.push("exit 3")
        ret process.SpawnOptions { path = "cmd", args = args }
    else:
        args.push("-c")
        args.push("exit 3")
        ret process.SpawnOptions { path = "sh", args = args }
    end
end

func main:
    base := filepath.Join(os.TempDir(), "salam_spawn_errors")
    os.RemoveAll(base)
    os.MkdirAll(base)
    mut bad := exit_three()
    bad.output = filepath.Join(base, "no_such_folder/out.txt")
    refused := process.Spawn(bad)
    println "bad output refused:", refused.pid <= 0
    mut ok := process.Spawn(exit_three())
    println "started:", ok.pid > 0
    println "exit code:", process.Wait(ok)
    println "polling after the end:", process.TryWait(ok), ok.exit_code
    process.KillTree(ok)
    println "kill after the end is safe:", ok.exit_code
    os.RemoveAll(base)
end
