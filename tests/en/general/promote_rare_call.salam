struct Acc:
    pub sum: i64 = 0
    pub n: int = 0
    pub flushes: int = 0
    pub peak: i64 = 0
end

noinline func flush(a &: Acc):
    a.flushes++
    if a.sum > a.peak:
        a.peak = a.sum
    end
    a.sum %= 1000
    a.n = a.flushes % 3
end

func feed(a &: Acc, v: int):
    a.sum += v as i64
    a.n++
    if a.n >= 7:
        flush(a)
    end
end

func run(a &: Acc, k: int): int:
    mut i := 0
    until i < k:
        a.sum += (i * 3) as i64
        a.n++
        if a.n >= 7:
            flush(a)
        end
        if a.flushes == 120 and a.n < 3:
            ret 0 - i
        end
        i++
    end
    ret i
end

func scan(a &: Acc, data: Vector<int>): int:
    mut i := 0
    until i < data.Len():
        feed(a, data[i])
        if a.flushes > 40:
            break
        end
        i++
    end
    ret i
end

func main():
    mut a := Acc {}
    r1 := run(a, 1000)
    println r1, a.sum, a.n, a.flushes, a.peak
    mut b := Acc {}
    mut data := Vector {} as Vector<int>
    mut k := 0
    until k < 500:
        data.push((k * 37) % 101)
        k++
    end
    r2 := scan(b, data)
    println r2, b.sum, b.n, b.flushes, b.peak
    mut c := Acc {}
    mut j := 0
    until j < 300:
        feed(c, j % 17)
        j++
    end
    println c.sum, c.n, c.flushes, c.peak
    data.Free()
end
