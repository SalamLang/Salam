// Arrays whose ELEMENT is a pointer: "T*[N]", the shape every adjacency
// list and bucket table is built on. The star sits before the dims, and
// a bare [null, ...] literal fills such an array.

import mem

struct Edge:
    pub dst: int = 0
    pub next: Edge* = null
end

struct Graph:
    pub head: Edge* [4] = [null, null, null, null]
end

func push_edge(g &: Graph, from: int, dst: int):
    e := mem.Allocate(sizeof(Edge) as u64) as Edge*
    e[0] = Edge { dst = dst, next = g.head[from] }
    g.head[from] = e
end

func degree(g: Graph, v: int): int:
    mut n := 0
    mut e := g.head[v]
    until e != null:
        n = n + 1
        e = e.next
    end
    ret n
end

func all_empty(slots: Edge* [4]): bool:
    repeat 4 with i:
        if slots[i] != null: ret false end
    end
    ret true
end

func release(g &: Graph):
    repeat 4 with v:
        mut e := g.head[v]
        until e != null:
            nxt := e.next
            mem.Free(e as void*)
            e = nxt
        end
        g.head[v] = null
    end
end

func main:
    // Every slot starts null, straight from the field default.
    mut g := Graph {}
    println g.head[0] == null, g.head[3] == null

    push_edge(g, 0, 1)
    push_edge(g, 0, 2)
    push_edge(g, 2, 3)

    repeat 4 with v:
        println "vertex", v, "degree", degree(g, v), "empty", g.head[v] == null
    end

    // The chain is walkable through the array slot.
    first := g.head[0]
    println first.dst, first.next.dst, first.next.next == null

    release(g)
    println "released:", g.head[0] == null, degree(g, 0)

    // A local array of pointers, and one built by casting a null literal.
    mut slots := [null as Edge*, null as Edge*]
    e := mem.Allocate(sizeof(Edge) as u64) as Edge*
    e[0] = Edge { dst = 9, next = null }
    slots[1] = e
    println slots[0] == null, slots[1].dst
    mem.Free(e as void*)

    // A T*[N] passes to a parameter of the same type by decay, like any
    // other array.
    println all_empty(g.head)
end
