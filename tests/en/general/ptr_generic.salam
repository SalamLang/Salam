// Pointers nest. A generic instantiated with a pointer argument has to
// keep BOTH levels: Vector<Edge*> reaches its elements through an Edge**
// data pointer inside std/collections/vector.salam, and flattening that to
// one star made the vector's own body fail to type-check.

import mem

struct Edge:
    pub dst: int = 0
end

func alloc_edge(d: int): Edge*:
    e := mem.Allocate(sizeof(Edge) as u64) as Edge*
    e[0] = Edge { dst = d }
    ret e
end

func main:
    // Vector<T*>: the element type is itself a pointer.
    mut v := Vector {} as Vector<Edge*>
    defer v.free()
    a := alloc_edge(11)
    b := alloc_edge(22)
    v.push(a)
    v.push(b)
    v.push(null as Edge*)
    println v.len(), v[0].dst, v[1].dst, v[2] == null

    mut total := 0
    each e in v:
        if e != null: total = total + e.dst end
    end
    println "total", total

    // A Vector<T*> hands its elements back as real pointers.
    front := v[0]
    println front.dst, front == a

    mem.Free(b as void*)
    mem.Free(a as void*)

    // `**` stays the power operator; a pointer-to-pointer is not spellable.
    n := 2
    println n as i64 ** 2
end
