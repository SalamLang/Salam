import mem

struct Edge:
    pub dst: int = 0
end

func alloc_edge(d: int): Edge*:
    e := mem.Allocate(sizeof(Edge) as u64) as Edge*
    e[0] = Edge { dst = d }
    ret e
end

func main:
    mut v := Vector {} as Vector<Edge*>
    defer v.Free()
    a := alloc_edge(11)
    b := alloc_edge(22)
    v.Push(a)
    v.Push(b)
    v.Push(null as Edge*)
    println v.Len(), v[0].dst, v[1].dst, v[2] == null

    mut total := 0
    each e in v:
        if e != null: total += e.dst end
    end
    println "total", total

    front := v[0]
    println front.dst, front == a

    mem.Free(b as void*)
    mem.Free(a as void*)

    n := 2
    println n as i64 ** 2
end
