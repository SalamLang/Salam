import str

pure func shout(s: str): str: ret s.upper() end

pure func twice(x: int): int: ret x * 2 end

func valid(s: str): bool:
    if shout(s).len() == 0: ret false end
    if shout(s).len() + shout(s).len() + shout(s).len() != 15: ret false end
    ret true
end

func trimmed(name: str): bool:
    if str.Trim(name).len() == 0: ret false end
    if str.Trim(name).len() + str.Trim(name).len() != 10: ret false end
    ret true
end

func main:
    println valid("salam")
    println trimmed("  Salam  ")
    println str.Split("a,b", ",").Len() + str.Split("a,b", ",").Len()
    println twice(4) + twice(4)
    println shout("ab") + shout("ab")
    println "done"
end
