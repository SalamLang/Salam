package main

noinline func cold(x: int): int:
    ret (x * 7 + 1) % 1000003
end

noinline func fcold(x: f64): f64:
    ret x * 0.5 + 1.0
end

noinline func mix(n: int, a: int, b: int, c: int, d: int, e: int, f: int): int:
    mut s0 := a
    mut s1 := b
    mut s2 := c
    mut s3 := d
    mut s4 := e
    mut s5 := f
    mut s6 := a + b
    mut s7 := c + d
    mut s8 := e + f
    mut s9 := a * 3
    repeat n in i:
        s0 = (s0 + i * 3) % 1000003
        s1 = s1 ^ (s0 >> 2)
        s2 = (s2 + s1) % 999983
        if i % 97 == 0:
            s3 = s3 + cold(s0 + s1)
        end
        s4 = (s4 * 5 + s3) % 1000033
        s5 = s5 + (s4 & 255)
        if i % 41 == 7:
            s6 = s6 + cold(s5) + cold(s2)
        end
        s7 = (s7 + s6 + s0) % 1000037
        s8 = s8 ^ s7
        s9 = (s9 + s8 + s1) % 1000039
    end
    ret s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9
end

noinline func fmix(n: int): f64:
    mut x := 1.0
    mut y := 2.0
    mut z := 0.25
    mut w := 3.5
    repeat n in i:
        x = x * 0.999 + y * 0.001
        y = y + z
        if i % 10 == 3:
            z = fcold(z) * 0.5
            w = w + fcold(x)
        end
        w = w * 0.9 + x
    end
    ret x + y + z + w
end

noinline func rotate(n: int): int:
    mut a := 1
    mut b := 2
    mut c := 3
    mut d := 4
    mut e := 5
    mut f := 6
    mut g := 7
    repeat n in i:
        t := a
        a = b
        b = c
        c = d
        d = e
        e = f
        f = g
        g = (t + i) % 10007
        if i % 13 == 0:
            a = a + cold(g) % 17
        end
    end
    ret a * 1 + b * 3 + c * 5 + d * 7 + e * 11 + f * 13 + g * 17
end

noinline func swaps(n: int, k: int): int:
    mut a := k
    mut b := k + 1
    mut acc := 0
    repeat n in i:
        if i % 3 == 0:
            t := a
            a = b
            b = t
        end
        if i % 50 == 49:
            acc = acc + cold(a - b)
        end
        acc = (acc + a * 2 - b) % 1000003
    end
    ret acc + a + b
end

func main:
    println mix(5000, 1, 2, 3, 4, 5, 6)
    println mix(77, 9, 8, 7, 6, 5, 4)
    println fmix(1000)
    println rotate(3000)
    println swaps(1000, 5)
end
