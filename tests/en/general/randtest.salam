import rand

func main:
    rand.Seed(7)
    seq_a := rand.Int()
    seq_b := rand.Int()
    rand.Seed(7)
    seq_c := rand.Int()
    seq_d := rand.Int()
    println seq_a == seq_c
    println seq_b == seq_d
    rand.Seed(1)
    diff_x := rand.Int()
    rand.Seed(2)
    diff_y := rand.Int()
    println diff_x != diff_y
    rand.SeedAuto()
    after_auto := rand.Int()
    println after_auto >= 0
    rand.Seed(42)
    i1 := rand.Int()
    i2 := rand.Int()
    println i1 >= 0
    println i2 >= 0
    println i1 != i2
    i32a := rand.Int32()
    i32b := rand.Int32()
    println i32a >= 0
    println i32b >= 0
    println i32a != i32b
    n1 := rand.IntN(100)
    println n1 >= 0
    println n1 < 100
    n2 := rand.IntN(1)
    println n2 == 0
    r1 := rand.IntRange(10, 20)
    println r1 >= 10
    println r1 <= 20
    r2 := rand.IntRange(0, 0)
    println r2 == 0
    r3 := rand.Int32Range(1, 6)
    println r3 >= 1
    println r3 <= 6
    r4 := rand.Int32Range(5, 5)
    println r4 == 5
    w1 := rand.IntWithLength(1)
    println w1 >= 0
    println w1 <= 9
    w5 := rand.IntWithLength(5)
    println w5 >= 10000
    println w5 <= 99999
    w3 := rand.IntWithLength(3)
    println w3 >= 100
    println w3 <= 999
    f1 := rand.Float()
    f2 := rand.Float()
    println f1 >= 0.0
    println f1 < 1.0
    println f2 >= 0.0
    println f2 < 1.0
    fr1 := rand.FloatRange(5.0, 10.0)
    println fr1 >= 5.0
    println fr1 < 10.0
    fr2 := rand.FloatRange(0.0 - 1.0, 0.0)
    println fr2 >= 0.0 - 1.0
    println fr2 < 0.0
    b1 := rand.Bool()
    b2 := rand.Bool()
    println b1 == true or b1 == false
    println b2 == true or b2 == false
    println rand.BoolP(0.0) == false
    println rand.BoolP(1.0) == true
    println rand.BoolP(0.0) == false
    println rand.BoolP(1.0) == true
    println rand.Bytes(8).Len() == 8
    println rand.Bytes(1).Len() == 1
    println rand.Bytes(32).Len() == 32
    println rand.TextFrom(5, "abc").Len() == 5
    println rand.TextFrom(4, "X") == "XXXX"
    println rand.TextFrom(1, "Z") == "Z"
    println rand.Alpha(8).Len() == 8
    println rand.Alpha(1).Len() == 1
    println rand.Alpha(20).Len() == 20
    println rand.AlphaUpper(6).Len() == 6
    println rand.AlphaUpper(10).Len() == 10
    println rand.AlphaMixed(5).Len() == 5
    println rand.AlphaMixed(15).Len() == 15
    println rand.Digit(4).Len() == 4
    println rand.Digit(6).Len() == 6
    d1 := rand.Digit(1)
    println d1 >= "0"
    println d1 <= "9"
    println rand.Alnum(12).Len() == 12
    println rand.Alnum(3).Len() == 3
    println rand.Text(16).Len() == 16
    println rand.Text(1).Len() == 1
    println rand.Text(100).Len() == 100
    println rand.HexBytes(8).Len() == 16
    println rand.HexBytes(4).Len() == 8
    println rand.HexBytes(1).Len() == 2
    h1 := rand.Hash()
    h2 := rand.Hash()
    println h1.Len() == 32
    println h2.Len() == 32
    println h1 != h2
    h160a := rand.Hash160()
    h160b := rand.Hash160()
    println h160a.Len() == 40
    println h160b.Len() == 40
    println h160a != h160b
    h256a := rand.Hash256()
    h256b := rand.Hash256()
    println h256a.Len() == 64
    println h256b.Len() == 64
    println h256a != h256b
    u1 := rand.UUID()
    println u1.Len() == 36
    println u1.Substr(8, 1) == "-"
    println u1.Substr(13, 1) == "-"
    println u1.Substr(18, 1) == "-"
    println u1.Substr(23, 1) == "-"
    println u1.Substr(14, 1) == "4"
    ychar := u1.Substr(19, 1)
    println ychar == "8" or ychar == "9" or ychar == "a" or ychar == "b"
    u2 := rand.UUID()
    println u2.Len() == 36
    println u1 != u2
    mut opts := Vector {} as Vector<str> defer opts.Free()
    opts.Push("red")
    opts.Push("green")
    opts.Push("blue")
    pick := rand.ChoiceStr(opts)
    println pick == "red" or pick == "green" or pick == "blue"
    mut one_s := Vector {} as Vector<str> defer one_s.Free()
    one_s.Push("only")
    println rand.ChoiceStr(one_s) == "only"
    println rand.ChoiceStr(one_s) == "only"
    mut nums := Vector {} as Vector<int> defer nums.Free()
    nums.Push(10)
    nums.Push(20)
    nums.Push(30)
    pn := rand.ChoiceInt(nums)
    println pn == 10 or pn == 20 or pn == 30
    mut one_i := Vector {} as Vector<int> defer one_i.Free()
    one_i.Push(99)
    println rand.ChoiceInt(one_i) == 99
    println rand.ChoiceInt(one_i) == 99
    cc := rand.ChoiceChar("Salam")
    println cc.Len() == 1
    println rand.ChoiceChar("Q") == "Q"
    println rand.ChoiceChar("Q") == "Q"
    mut sv := Vector {} as Vector<str> defer sv.Free()
    sv.Push("a")
    sv.Push("b")
    sv.Push("c")
    sv.Push("d")
    shuffled_s := rand.ShuffleStr(sv)
    defer shuffled_s.Free()
    println shuffled_s.Len() == 4
    mut single_s := Vector {} as Vector<str> defer single_s.Free()
    single_s.Push("solo")
    sh1 := rand.ShuffleStr(single_s)
    defer sh1.Free()
    println sh1.Len() == 1
    println sh1.Get(0) == "solo"
    mut iv := Vector {} as Vector<int> defer iv.Free()
    iv.Push(1)
    iv.Push(2)
    iv.Push(3)
    iv.Push(4)
    shuffled_i := rand.ShuffleInt(iv)
    defer shuffled_i.Free()
    println shuffled_i.Len() == 4
    s := shuffled_i.Get(0) + shuffled_i.Get(1) + shuffled_i.Get(2) + shuffled_i.Get(3)
    println s == 10
    mut single_i := Vector {} as Vector<int> defer single_i.Free()
    single_i.Push(77)
    sh2 := rand.ShuffleInt(single_i)
    defer sh2.Free()
    println sh2.Len() == 1
    println sh2.Get(0) == 77
end
