func main:
    println `hello world`
    println `no\n escape here`
    println `contains "double" quotes`
    println `contains 'single' quotes`
    println `tab\there`
    prefix := `Path: `
    println prefix + "/usr/bin"
    println `first` + ` ` + `second`
end
