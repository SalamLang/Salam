import regex

func main throws:
    println try regex.MatchStr("[0-9]+", "abc123")
    println try regex.MatchStr("[0-9]+", "abcxyz")

    println try regex.FindStr("wor", "hello world")
    println try regex.FindStr("zzz", "hello world")

    re := try regex.Compile("^[A-Za-z]+$")
    println regex.Match(re, "Hello")
    println regex.Match(re, "Hello123")

    println try regex.MatchStr("^abc$", "abc")
    println try regex.MatchStr("^abc$", "abcd")

    println try regex.MatchStr("[^0-9]+", "###")
    println try regex.MatchStr("^[^0-9]+$", "a1b")

    println try regex.MatchStr("colou?r", "color")
    println try regex.MatchStr("colou?r", "colour")
    println try regex.MatchStr("colou?r", "colouur")

    println try regex.MatchStr("go+gle", "gooogle")
    println try regex.MatchStr("go+gle", "ggle")

    println try regex.MatchStr("\\d\\d\\d", "room 404")
    println try regex.MatchStr("\\s", "a b")
    println try regex.MatchStr("\\w+", "_hi9")

    println try regex.MatchStr("a.c", "abc")
    println try regex.MatchStr("a.c", "ac")

    println try regex.MatchStr("a\\.b", "a.b")
    println try regex.MatchStr("a\\.b", "axb")

    println try regex.ReplaceStr("[0-9]+", "item1 item2 item3", "#")
    println try regex.ReplaceAllStr("[0-9]+", "item1 item2 item3", "#")

    re2 := try regex.Compile("o")
    println regex.Replace(re2, "foo", "0")
    println regex.ReplaceAll(re2, "foo", "0")

    println try regex.ReplaceStr("zzz", "hello", "Q")
end
