import regex

func show(v: Vector<str>):
    print v.len()
    each x in v:
        print " <" + x + ">"
    end
    println ""
end

func main:
    // groups, by number and by position
    m := regex.FindMatchStr(`(\d{4})-(\d{2})-(\d{2})`, "due 2026-08-17.")
    println m.ok, m.start, m.stop, regex.Group(m, 0)
    println regex.GroupCount(m), regex.Group(m, 1), regex.Group(m, 2), regex.Group(m, 3)
    println regex.GroupStart(m, 1), regex.GroupEnd(m, 1), regex.Group(m, 4)

    // a group that took no part in the match reads back empty, not missing
    alt := regex.FindMatchStr(`(a)|(b)`, "zzb")
    println alt.start, regex.GroupOk(alt, 1), regex.GroupOk(alt, 2), regex.Group(alt, 2)

    // alternation and a quantified group: the last repetition is what is kept
    rep := regex.FindMatchStr(`((a)(b))+`, "xabab!")
    println rep.start, rep.stop, regex.Group(rep, 1), regex.Group(rep, 2), regex.Group(rep, 3)

    // lazy quantifiers stop at the first closing tag
    lazy := regex.FindMatchStr(`<title>(.*?)</title>`, "<html><title>Hi</title><title>No</title>")
    println regex.Group(lazy, 1)

    // named groups, in either spelling
    named := regex.FindMatchStr(`(?<user>\w+)@(?P<host>[\w.]+)`, "mail: ada@example.com!")
    println regex.GroupByName(named, "user"), regex.GroupByName(named, "host")
    println regex.GroupIndex(named, "host"), regex.GroupByName(named, "nope")

    // no match: every accessor stays safe
    none := regex.FindMatchStr(`(\d+)`, "no digits")
    println none.ok, none.start, regex.Group(none, 1), regex.GroupCount(none)

    // whole match plus every group, in one vector
    sub := regex.FindSubmatchStr(`(\w+)=(\w+)`, "key=value")
    defer sub.free()
    show(sub)

    // every match in the subject
    all := regex.FindAllStr(`\d+`, "a1 bb22 c333")
    defer all.free()
    show(all)

    few := regex.FindAllN(regex.Compile(`[a-z]`), "abcdef", 3)
    defer few.free()
    show(few)

    hrefs := regex.FindAllMatches(regex.Compile(`href="([^"]*)"`), `<a href="/a">A</a><a href="/b">B</a>`, -1)
    defer hrefs.free()
    each h in hrefs:
        println regex.Group(h, 1), h.start
    end

    // splitting on a pattern
    parts := regex.SplitStr(`\s*,\s*`, "a, b ,c,,d")
    defer parts.free()
    show(parts)

    two := regex.SplitN(regex.Compile(`,`), "a,b,c,d", 2)
    defer two.free()
    show(two)

    // rewriting with group references
    println regex.ReplaceAllExpandStr(`(\w+)@(\w+)`, "ada@lovelace and grace@hopper", `$2/$1`)
    println regex.ReplaceExpandStr(`(?<y>\d{4})-(?<m>\d{2})`, "on 2026-08 ok", `${m}.${y}`)
    println regex.ReplaceAllExpandStr(`(a)`, "banana", `[$1$$]`)
    println regex.Expand(m, `$3/$2/$1`)

    // an unsupported or unbalanced pattern is invalid, and never matches
    println regex.IsValid(`(a)|(b)`), regex.IsValid(`(a`), regex.IsValid(`a)`), regex.IsValid(`[a-`)
    println regex.MatchStr(`(a`, "a")

    // a pattern that can loop on empty still terminates
    println regex.MatchStr(`(a*)*b`, "aaab"), regex.MatchStr(`(a+)+b`, "aaab")
end
