import regex

func show(v: Vector<str>):
    print v.Len()
    each x in v:
        print " <" + x + ">"
    end
    println ""
end

func main throws:
    m := try regex.FindMatchStr(`(\d{4})-(\d{2})-(\d{2})`, "due 2026-08-17.")
    println m.ok, m.start, m.stop, regex.Group(m, 0)
    println regex.GroupCount(m), regex.Group(m, 1), regex.Group(m, 2), regex.Group(m, 3)
    println regex.GroupStart(m, 1), regex.GroupEnd(m, 1), regex.Group(m, 4)

    alt := try regex.FindMatchStr(`(a)|(b)`, "zzb")
    println alt.start, regex.GroupOk(alt, 1), regex.GroupOk(alt, 2), regex.Group(alt, 2)

    rep := try regex.FindMatchStr(`((a)(b))+`, "xabab!")
    println rep.start, rep.stop, regex.Group(rep, 1), regex.Group(rep, 2), regex.Group(rep, 3)

    lazy := try regex.FindMatchStr(`<title>(.*?)</title>`, "<html><title>Hi</title><title>No</title>")
    println regex.Group(lazy, 1)

    named := try regex.FindMatchStr(`(?<user>\w+)@(?P<host>[\w.]+)`, "mail: ada@example.com!")
    println regex.GroupByName(named, "user"), regex.GroupByName(named, "host")
    println regex.GroupIndex(named, "host"), regex.GroupByName(named, "nope")

    none := try regex.FindMatchStr(`(\d+)`, "no digits")
    println none.ok, none.start, regex.Group(none, 1), regex.GroupCount(none)

    sub := try regex.FindSubmatchStr(`(\w+)=(\w+)`, "key=value")
    defer sub.free()
    show(sub)

    all := try regex.FindAllStr(`\d+`, "a1 bb22 c333")
    defer all.free()
    show(all)

    few := regex.FindAllN(try regex.Compile(`[a-z]`), "abcdef", 3)
    defer few.free()
    show(few)

    hrefs := regex.FindAllMatches(try regex.Compile(`href="([^"]*)"`), `<a href="/a">A</a><a href="/b">B</a>`, -1)
    defer hrefs.free()
    each h in hrefs:
        println regex.Group(h, 1), h.start
    end

    parts := try regex.SplitStr(`\s*,\s*`, "a, b ,c,,d")
    defer parts.free()
    show(parts)

    two := regex.SplitN(try regex.Compile(`,`), "a,b,c,d", 2)
    defer two.free()
    show(two)

    println try regex.ReplaceAllExpandStr(`(\w+)@(\w+)`, "ada@lovelace and grace@hopper", `$2/$1`)
    println try regex.ReplaceExpandStr(`(?<y>\d{4})-(?<m>\d{2})`, "on 2026-08 ok", `${m}.${y}`)
    println try regex.ReplaceAllExpandStr(`(a)`, "banana", `[$1$$]`)
    println regex.Expand(m, `$3/$2/$1`)

    println regex.IsValid(`(a)|(b)`), regex.IsValid(`(a`), regex.IsValid(`a)`), regex.IsValid(`[a-`)
    try:
        println regex.MatchStr(`(a`, "a")
    catch e:
        println e.code, e.offset, e.ToStr()
    end

    println try regex.MatchStr(`(a*)*b`, "aaab"), try regex.MatchStr(`(a+)+b`, "aaab")
end
