import regex

func extractTitle(html: str): str throws:
    if not try regex.MatchStr("<title>.*</title>", html):
        ret ""
    end
    step1 := try regex.ReplaceStr(".*<title>", html, "")
    ret try regex.ReplaceStr("</title>.*", step1, "")
end

func printHrefs(html: str) throws:
    mut rest := html
    mut going := true
    until going:
        idx := try regex.FindStr(`href="`, rest)
        if idx < 0:
            going = false
        else:
            afterAttr := idx + 6
            tail := rest.Substr(afterAttr, rest.Len() - afterAttr)
            endq := try regex.FindStr(`"`, tail)
            if endq < 0:
                going = false
            else:
                println tail.Substr(0, endq)
                adv := afterAttr + endq + 1
                rest = rest.Substr(adv, rest.Len() - adv)
            end
        end
    end
end

func main throws:
    page := "<html><head><title>Salam Lang Docs</title></head><body>hi</body></html>"
    println try extractTitle(page)

    noTitle := "<html><body>no title here</body></html>"
    println try extractTitle(noTitle)

    links := `<a href="https://salamlang.org">Home</a><a href="https://salamlang.org/docs">Docs</a><a href="/about">About</a>`
    try printHrefs(links)

    email := "contact: ada@example.com or grace@example.org"
    println try regex.MatchStr("\\w+@\\w+\\.\\w+", email)
    firstAt := try regex.FindStr("@", email)
    println firstAt > 0

    digitsOnly := try regex.ReplaceAllStr("[0-9]", "room 42, floor 7", "")
    println digitsOnly

    csv := "name,age,city"
    println try regex.ReplaceAllStr(",", csv, " | ")
end
