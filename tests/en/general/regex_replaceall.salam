import regex

func main throws:
    println try regex.ReplaceAllStr("a", "banana", "X")
    println try regex.ReplaceAllStr("[0-9]+", "a1b22c333", "#")
    println try regex.ReplaceStr("a", "banana", "X")
    println try regex.ReplaceAllStr("z", "banana", "X")
end
