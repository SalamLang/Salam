import regex

func show(v: Vector<str>):
    mut s := "["
    repeat v.len() in i:
        if i > 0: s = s + "|" end
        s = s + v.get(i)
    end
    println s + "]"
end

func main:
    println regex.ReplaceAllStr("x*", "abc", "-")
    println regex.ReplaceAllStr("a|", "banana", "<>")
    println regex.ReplaceAllStr("$", "abc", "!")
    println regex.ReplaceAllStr("^a", "aaa", "#")
    println regex.ReplaceAllStr("a$", "aaa", "#")
    println regex.ReplaceAllStr("[0-9]+", "", "#")
    println regex.ReplaceAllStr("an", "banana", "")
    println regex.ReplaceAllStr("س", "سلام سیب", "ص")
    println regex.ReplaceAllStr("(a)(n)", "banana", "X")
    show(regex.FindAllStr("[0-9]+", "a1b22c333d"))
    show(regex.FindAllStr("x*", "abc"))
    show(regex.FindAllStr("[a-z]+", "Hello World foo"))
    show(regex.SplitStr(",", "a,b,,c,"))
    show(regex.SplitStr("x*", "abc"))
    show(regex.SplitStr("[0-9]", "1a2b3"))
    println regex.ReplaceAllExpandStr(`(\w+)@(\w+)`, "ada@lovelace and grace@hopper", `$2/$1`)
    println regex.ReplaceAllExpandStr(`x*`, "abc", `[$0]`)
    println regex.ReplaceAllExpandStr(`(a)`, "banana", `[$1$$]`)
    re := regex.Compile("o")
    println regex.ReplaceAll(re, "foo boo", "0")
    ms := regex.FindAllMatches(re, "foo boo", 3)
    println ms.len()
    show(regex.FindAllN(re, "foo boo", 2))
end
