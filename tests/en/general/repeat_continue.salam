func main:
    mut sum := 0
    mut i := 0
    repeat 10:
        i = i + 1
        if i % 2 == 0:
            continue
        end
        sum = sum + i
    end
    println sum
    zero := i - 10
    repeat zero:
        println "never"
    end
    println "done"
end
