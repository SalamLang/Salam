func main:
    mut sum := 0
    repeat 4 in i:
        sum += i
    end
    println sum

    mut picked := 0
    repeat 1 to 10 each 3 in k:
        picked += k
    end
    println picked

    mut stepped := 0
    repeat 0 to 10 each 5:
        stepped += 1
    end
    println stepped

    mut n := 0
    until n < 3:
        n += 1
    end
    println n
end
