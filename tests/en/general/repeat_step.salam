func main:
    mut a := 0
    repeat 0 to 10 by 2:
        a += 1
    end
    println a

    mut b := 0
    repeat 10 to 100 by 30:
        b += 1
    end
    println b

    mut c := 0
    repeat 1 to 100 by 10:
        c += 1
    end
    println c
end
