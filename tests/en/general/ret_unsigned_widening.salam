// What a `ret` accepts on the way into an unsigned type. The rejections
// live in tests/en/errors/ret_cast_*.salam and ret_signed_*.salam; this
// file is the other half - everything here has to keep compiling, and the
// casts that remain are the ones actually doing work.

func plain(): u64:
    // The literal takes the return type on its own; no cast to write.
    ret 0
end

func from_unsigned(): u64:
    // Same signedness, narrower: implicit as it always was.
    val := 19 as u32
    ret val
end

func from_signed_narrow(): u64:
    // Signed into unsigned, allowed because 19 provably cannot be negative
    // and i16 fits inside u64.
    val := 19 as i16
    ret val
end

func from_signed_wide(): u64:
    // Same rule at the same width: i64's negative half is what the rule
    // guards against, and this value has none of it.
    val := 19 as i64
    ret val
end

func through_const(): u64:
    // The proof follows an immutable binding to its initializer, and
    // through constant arithmetic.
    const BASE := 12
    val := (BASE + 7) as i16
    ret val
end

func load_bearing(x: i16): u64:
    // Nothing proves x is non-negative, so this cast is doing real work
    // and stays legal - the caller is asserting the reinterpretation.
    ret x as u64
end

func narrowing_cast(): u8:
    // The cast narrows, which no implicit conversion would do for us.
    val := 300 as i32
    ret val as u8
end

func main:
    println plain()
    println from_unsigned()
    println from_signed_narrow()
    println from_signed_wide()
    println through_const()
    println load_bearing(21 as i16)
    println narrowing_cast()
end
