package main

noinline func cnt_f(v: Vector<f64>, lim: f64): i64:
    mut a := 0 as i64
    mut b := 0 as i64
    mut c := 0 as i64
    mut d := 0 as i64
    each x in v:
        if x <= lim:
            a++
        end
        if x >= lim:
            b++
        end
        if lim >= x:
            c++
        end
        if not (x >= lim):
            d++
        end
    end
    ret a * 1000000 + b * 10000 + c * 100 + d
end

noinline func cnt_u(v: Vector<u32>, lim: u32): i64:
    mut a := 0 as i64
    mut b := 0
    mut c := 0 as i64
    mut d := 0
    each x in v:
        if x < lim:
            a++
        end
        if x <= lim:
            b++
        end
        if x > lim:
            c++
        end
        if x >= lim:
            d++
        end
    end
    ret a * 1000000 + (b as i64) * 10000 + c * 100 + (d as i64)
end

func main:
    mut v := Vector {} as Vector<f64>
    mut w := Vector {} as Vector<u32>
    nan := 0.0 / 0.0
    repeat 40 in i:
        v.Push((i as f64) * 0.25 - 3.0)
        w.Push(((i * 2654435761) % 100) as u32)
    end
    v.Push(nan)
    v.Push(nan)
    println cnt_f(v, 1.5), cnt_f(v, nan), cnt_u(w, 50 as u32), cnt_u(w, 0 as u32)
    v.Free()
    w.Free()
end
