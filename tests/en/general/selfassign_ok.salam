mut g := 10

type Meters: int
    func +(other: Meters): Meters:
        ret ((this as int) + (other as int) + 1000) as Meters
    end
end

struct Vec2:
    pub x: int = 0
    pub func +(o: Vec2): Vec2:
        ret Vec2 { x = this.x + o.x + 100 }
    end
end

struct Box:
    pub n: int = 0
    pub func grow():
        this.n += 2
        this.n = this.n + bump()
    end
end

func bump(): int:
    g += 5
    ret 1
end

func next(i: int): int:
    ret i + 1
end

func main:
    mut x := 1
    y := 4
    mut s := "mid"
    b := "pre-"
    mut a := [10, 20, 30]
    i := 0
    mut v := Vector {} as Vector<int>
    defer v.free()
    v.push(7)
    x += 2
    x *= 3
    x = y + 1
    x = x * y + 3
    x = x + y + 3
    x = y - x
    x = y % 7
    s = b + s
    a[next(i)] = a[next(i)] + 1
    a[i] = y - a[i]
    v[0] = v[0] + 1
    mut m := 5 as Meters
    m = m + (1 as Meters)
    mut w := Vec2 { x = 1 }
    w = w + Vec2 { x = 2 }
    mut bx := Box {}
    bx.grow()
    println x, s, a[0], a[1], a[2], v[0], g, m as int, w.x, bx.n
end
