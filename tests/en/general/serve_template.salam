import net.http
import net.router

func main:
    mut r := router.NewRouter()
    router.EnableListing(r)
    router.Static(r, "/", ".")
    mut s := http.NewServer(8000)
    http.SetHost(s, "127.0.0.1")
    http.EnableAccessLog(s)
    http.Use(s, r)

    println r.has_static
    println r.static_listing
    println r.static_prefix == "/"
    println r.static_dir == "."
    println s.port == 8000
    println s.host == "127.0.0.1"
    println s.access_log
    println s.router.has_static
    println s.router.static_listing
end
