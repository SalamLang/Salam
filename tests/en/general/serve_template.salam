// Guard for `salam serve`, which does not compile any checked-in file:
// both drivers (c/src/driver/serve_build.c and
// compiler/driver/driver_api_web.salam's Serve) generate this exact
// program into a scratch file at run time and build it. The std/net
// calls in it are resolved at that point, so renaming or moving any of
// them shows up only as an E012 "package has no exported function" the
// first time a user types `salam serve` - which is how the old
// std/web-based template silently rotted when the router/server moved to
// std/net/router and std/net/http.
//
// Keep the wiring below identical to the generated source in those two
// drivers. http.Run is deliberately the one call not made here (it is an
// endless accept loop); the loop itself is covered by
// net_http_static.salam, which serves real files over a real socket.

import net.http
import net.router

func main:
    mut r := router.NewRouter()
    router.EnableListing(r)
    router.Static(r, "/", ".")
    mut s := http.NewServer(8000)
    http.SetHost(s, "127.0.0.1")
    http.EnableAccessLog(s)
    http.Use(s, r)

    println r.has_static
    println r.static_listing
    println r.static_prefix == "/"
    println r.static_dir == "."
    println s.port == 8000
    println s.host == "127.0.0.1"
    println s.access_log
    println s.router.has_static
    println s.router.static_listing
end
