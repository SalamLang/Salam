func sh(x: i32, n: i32): i32:
    ret x << n
end

func shr(x: u8, n: i32): u8:
    ret x >> n
end

func main:
    println sh(1, 4), sh(1, 36), shr(128 as u8, 7), shr(128 as u8, 15)
end
