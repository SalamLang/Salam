func op(n: int): int:
    ret n
end

func sub(a: int[], lo: int, hi: int): int:
    s := a[lo:hi]
    ret s.Len()
end

func main:
    arr := [1, 2, 3]
    println "ok", sub(arr, op(0), op(3))
    println "start"
    println "unreachable", sub(arr, op(2), op(1))
end
