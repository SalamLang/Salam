func op(n: int): int:
    ret n
end

func geta(a: int[], i: int): int:
    ret a[i]
end

func main:
    arr := [10, 20, 30]
    println "ok", geta(arr, op(2))
    println "start"
    println "unreachable", geta(arr, op(5))
end
