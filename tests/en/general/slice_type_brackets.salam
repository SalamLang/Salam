func total(view: int[]): int:
    mut t := 0
    each v in view:
        t = t + v
    end
    ret t
end

func head_of(view: str[]): str:
    ret view[0]
end

func total_old(view: int[:]): int:
    mut t := 0
    each v in view:
        t = t + v
    end
    ret t
end

func main:
    a := [1, 2, 3, 4, 5]
    println total(a[:])
    println total_old(a[:])
    println total(a[1: 4])
    println total(a[: 2])
    println total(a[3:])
    names := ["ali", "reza"]
    println head_of(names[:])
    println head_of(names[1:])
end
