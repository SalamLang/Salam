import mem

noinline func kern(pa: f32*, pb: f32*, kn: int, c: f32*):
    mut c0 := c[0]
    mut c1 := c[1]
    mut c2 := c[2]
    mut c3 := c[3]
    mut c4 := c[4]
    mut c5 := c[5]
    mut c6 := c[6]
    mut c7 := c[7]
    mut d0 := c[8]
    mut d1 := c[9]
    mut d2 := c[10]
    mut d3 := c[11]
    repeat kn in k:
        pk := (pb as i64 + (k as i64) * 48) as f32*
        v := pa[k]
        w := pa[k + 1]
        c0 += v * pk[0]
        c1 += v * pk[1]
        c2 += v * pk[2]
        c3 += v * pk[3]
        c4 += v * pk[4]
        c5 += v * pk[5]
        c6 += v * pk[6]
        c7 += v * pk[7]
        d0 += w * pk[8]
        d1 += w * pk[9]
        d2 += w * pk[10]
        d3 += w * pk[11]
    end
    c[0] = c0
    c[1] = c1
    c[2] = c2
    c[3] = c3
    c[4] = c4
    c[5] = c5
    c[6] = c6
    c[7] = c7
    c[8] = d0
    c[9] = d1
    c[10] = d2
    c[11] = d3
end

noinline func quad64(a: f64*, b: f64*, o: f64*, s: f64):
    a0 := a[0]
    a1 := a[1]
    a2 := a[2]
    a3 := a[3]
    b0 := b[0]
    b1 := b[1]
    b2 := b[2]
    b3 := b[3]
    o[0] = (a0 - b0) * s + a0 / b0
    o[1] = (a1 - b1) * s + a1 / b1
    o[2] = (a2 - b2) * s + a2 / b2
    o[3] = (a3 - b3) * s + a3 / b3
    o[4] = a[4] * s
    o[5] = a[5] * s
end

noinline func mix32(a: f32*, o: f32*, s: f32):
    o[0] = a[3] * s
    o[1] = a[2] * s
    o[2] = a[1] * s
    o[3] = a[0] * s
    o[4] = a[4] * s
    o[5] = a[5] * s
    o[6] = a[6] * s
    o[7] = a[7] * s
end

noinline func sum32(a: Vector<int>): int:
    mut s := 0
    mut i := 0
    until i < a.len():
        s += a.get(i)
        i += 1
    end
    ret s
end

noinline func sum64(a: Vector<i64>, n: int): i64:
    mut s := 0 as i64
    mut k := 0
    until k < n:
        s = s + a.get(k)
        k += 1
    end
    ret s
end

noinline func sum64le(a: Vector<i64>, n: int): i64:
    mut s := 5 as i64
    mut k := 1
    until k <= n:
        s = s + a.get(k)
        k += 1
    end
    ret s
end

func fsum(p: f32*, n: int): f64:
    mut s := 0.0
    repeat n in i:
        s = s * 0.75 + (p[i] as f64)
    end
    ret s
end

func main:
    pa := mem.Allocate(64 * 4 as u64) as f32*
    pb := mem.Allocate(768 * 4 as u64) as f32*
    pc := mem.Allocate(16 * 4 as u64) as f32*
    repeat 64 in i:
        pa[i] = (((i * 37) % 19) as f32) * (0.25 as f32) - (2.0 as f32)
    end
    repeat 768 in j:
        pb[j] = (((j * 53) % 23) as f32) * (0.125 as f32) - (1.0 as f32)
    end
    each kn in [0, 1, 2, 7, 31, 63]:
        repeat 16 in q:
            pc[q] = (q as f32) * (0.5 as f32)
        end
        kern(pa, pb, kn, pc)
        println kn, fsum(pc, 12)
    end
    da := mem.Allocate(8 * 8 as u64) as f64*
    db := mem.Allocate(8 * 8 as u64) as f64*
    dout := mem.Allocate(8 * 8 as u64) as f64*
    repeat 8 in k:
        da[k] = (k as f64) * 1.5 + 0.25
        db[k] = 3.0 - (k as f64) * 0.5
        dout[k] = 0.0
    end
    quad64(da, db, dout, 0.75)
    mut ds := 0.0
    repeat 8 in k2:
        ds = ds * 0.5 + dout[k2]
    end
    println ds
    mix32(pa, pc, 1.5 as f32)
    println fsum(pc, 8)
    each n in [0, 1, 3, 7, 8, 9, 15, 16, 17, 31, 32, 33, 100, 257]:
        mut a := Vector {} as Vector<int>
        mut l := Vector {} as Vector<i64>
        repeat n in i2:
            a.push((i2 * 7919) % 2003 - 1000)
        end
        repeat n + 1 in i3:
            l.push((i3 as i64) * (6364136223846793005 as i64) + (1442695040888963407 as i64))
        end
        println n, sum32(a), sum64(l, n), sum64le(l, n)
    end
end
