import net.websocket
import sync
import str

mut srv wg := sync.NewWaitGroup()
func ws server():
    srv := websocket.Listen(19210)
    sync.Done(srv wg)
    if !websocket.Ok(srv):
        ret
    end
    mut c := websocket.Accept(srv)
    if websocket.IsOpen(c):
        mut m := websocket.Receive(c)
        until websocket.IsText(m):
            websocket.SendText(c, "echo:" + m.text)
            m = websocket.Receive(c)
        end
    end
    websocket.CloseServer(srv)
end

func main:
    sync.Add(srv wg, 1 as i64)
    t := spawn(ws server)
    sync.Wait(srv wg)
    mut c := websocket.Dial("127.0.0.1", 19210, "/")
    println websocket.IsOpen(c)
    websocket.SendText(c, "hello")
    println websocket.ReceiveText(c)
    big := str.Repeat("ab", 100)
    websocket.SendText(c, big)
    reply := websocket.ReceiveText(c)
    println str.Len(reply)
    println str.StartsWith(reply, "echo:ab")
    websocket.Ping(c, "hi")
    m := websocket.Receive(c)
    println websocket.IsPong(m)
    println m.text
    websocket.Close(c)
    join(t)
end
