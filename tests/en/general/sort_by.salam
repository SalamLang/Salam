import sort
import collections

func main:
    mut v := Vector {} as collections.Vector<int> v.Push(3)
    v.Push(1)
    v.Push(2)

    s := sort.SortedBy(v, (a: int, b: int): ret a < b end)
    println s.Get(0), s.Get(1), s.Get(2)
    println v.Get(0), v.Get(1), v.Get(2)
    sort.SortBy(v, (a: int, b: int): ret a > b end)
    println v.Get(0), v.Get(1), v.Get(2)
end
