import collections
import sort

func fill(v &: collections.Vector<int>):
    v.Clear()
    v.Push(5)
    v.Push(2)
    v.Push(8)
    v.Push(1)
    v.Push(9)
    v.Push(3)
    v.Push(7)
    v.Push(4)
    v.Push(6)
    v.Push(0)
    v.Push(2)
    v.Push(8)
end

func main:
    mut v := Vector {} as collections.Vector<int> fill(v)
    sort.BubbleSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.SelectionSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.InsertionSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.BinaryInsertionSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.GnomeSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.CocktailSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.OddEvenSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.PancakeSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.ShellSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.CombSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.MergeSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.QuickSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.HeapSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.IntroSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.Sort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.CountingSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.RadixSort(v)
    println sort.IsSorted(v)
    fill(v)
    sort.BucketSort(v)
    println sort.IsSorted(v)

    fill(v)
    sort.Sort(v)
    repeat v.Len() in i:
        print v.Get(i)
        print " "
    end
    println ""

    fill(v)
    sort.SortDesc(v)
    println v.Get(0)
    println v.Get(v.Len() - 1)

    mut w := Vector {} as collections.Vector<int> w.Push(0 - 3)
    w.Push(5)
    w.Push(0 - 10)
    w.Push(2)
    w.Push(0 - 3)
    w.Push(7)
    sort.RadixSort(w)
    println sort.IsSorted(w)
    println w.Get(0)
    println w.Get(5)
    sort.CountingSort(w)
    println sort.IsSorted(w)

    fill(v)
    sort.Sort(v)
    println sort.BinarySearch(v, 7)
    println sort.BinarySearch(v, 100)
    println sort.LowerBound(v, 2)
    println sort.UpperBound(v, 2)
    println sort.Min(v)
    println sort.Max(v)

    fill(v)
    sort.SortBy(v, (a: int, b: int): ret b < a end)
    println v.Get(0)
    println sort.IsSortedBy(v, (a: int, b: int): ret b < a end)

    fill(v)
    sort.StableSortBy(v, (a: int, b: int): ret a < b end)
    println sort.IsSorted(v)

    mut s := Vector {} as collections.Vector<str> s.Push("pear")
    s.Push("apple")
    s.Push("fig")
    s.Push("banana")
    sort.Sort(s)
    println s.Get(0)
    println s.Get(3)
    println sort.IsSorted(s)

    fill(v)
    cp := sort.Sorted(v)
    println sort.IsSorted(cp)
    println sort.IsSorted(v)
    println v.Get(0)
end
