import sync
import mem

mut lock := sync.NewMutex()
mut wg := sync.NewWaitGroup()

struct Job:
    pub slot: i64* = null
    pub times: i64 = 0
end

func worker(p: Job*):
    j := p[0]
    c := j.slot
    repeat j.times:
        sync.Lock(lock)
        c[0] = c[0] + 1
        sync.Unlock(lock)
    end
    sync.Done(wg)
end

func main:
    total := mem.Allocate(8 as u64) as i64*
    total[0] = 0

    n := 3
    jobs := mem.Allocate(((n as i64) * (sizeof(Job) as i64)) as u64) as Job*
    repeat n with i:
        jobs[i] = Job { slot = total, times = (1000 + i) as i64 }
    end

    sync.Add(wg, n as i64)
    t1 := spawn(worker, ((jobs as i64) + 0 * (sizeof(Job) as i64)) as Job*)
    t2 := spawn(worker, ((jobs as i64) + 1 * (sizeof(Job) as i64)) as Job*)
    t3 := spawn(worker, ((jobs as i64) + 2 * (sizeof(Job) as i64)) as Job*)
    sync.Wait(wg)
    join(t1)
    join(t2)
    join(t3)

    println total[0]
    mem.Free(jobs as void*)
    mem.Free(total as void*)
end
