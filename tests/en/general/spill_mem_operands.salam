package main

import mem

struct Pix:
    pub r: u8 = 0 as u8
    pub g: u8 = 0 as u8
    pub b: u8 = 0 as u8
    pub a: u8 = 0 as u8
end

noinline func bump(v: int): int:
    ret v + 1
end

func busy(p: int*, q: u8*, n: int, a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, c0: Pix, c1: Pix, l: i64, m: i64, w16: u16, r16: u16*): i64:
    mut s := 0 as i64
    mut neg := 0
    repeat n in i:
        x := p[i % 8]
        y := q[i % 8] as int
        mut k := x > a ? b : c
        v16 := r16[i % 4]
        if i % 3 == 0:
            k = bump(k)
        end
        z := x * a + y * b - k * c
        w := (z > d ? e : f) + (z < g ? h : a)
        if c0.a == (255 as u8):
            s += w as i64
        end
        if c1.a != (0 as u8):
            s += (w * (c0.r as int) + (c1.g as int)) as i64
        end
        if a == 0:
            neg += 1
        end
        if w16 == (1000 as u16):
            s += 5 as i64
        end
        if v16 == (2000 as u16):
            s += 11 as i64
        end
        if l == (77 as i64):
            s -= 1 as i64
        end
        if m < (0 as i64):
            s = s * m
        end
        s = s * 3 + (z as i64) + l * (i as i64) + (w as i64) * m
        s += ((d * e * x) + (f * g * y) + (h * x)) as i64
        s += (c0.g as f64 + c1.b as f64) as i64
        p[(i + 1) % 8] = (z & 255) - (k & 15)
    end
    ret s + (neg as i64)
end

func pick_big(n: int, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, j: i64, k: i64): i64:
    mut s := 0 as i64
    repeat n in i:
        t := bump(i) as i64
        u := t > (2 as i64) ? a : b
        v := t > (3 as i64) ? c * t : d
        wide := t > (1 as i64) ? e : (f == (6 as i64) ? g : h)
        s += u * v + wide * j + k * t
        if s == (0 as i64):
            s = j
        end
    end
    ret s
end

func main:
    p := mem.Allocate(32 as u64) as int*
    q := mem.Allocate(8 as u64) as u8*
    r16 := mem.Allocate(8 as u64) as u16*
    repeat 4 in t:
        r16[t] = (1000 * t) as u16
    end
    repeat 8 in i:
        p[i] = i * 7 - 9
        q[i] = (i * 41 + 200) as u8
    end
    c0 := Pix { r = 12 as u8, g = 200 as u8, b = 7 as u8, a = 255 as u8 }
    c1 := Pix { r = 1 as u8, g = 44 as u8, b = 255 as u8, a = 9 as u8 }
    c2 := Pix { r = 250 as u8, g = 3 as u8, b = 128 as u8, a = 0 as u8 }
    println busy(p, q, 40, 3, 5, 7, 11, 13, 17, 19, 23, c0, c1, 77 as i64, 2 as i64, 1000 as u16, r16)
    println busy(p, q, 25, 0, 1, 2, 3, 4, 5, 6, 7, c2, c0, 9 as i64, 0 - 3 as i64, 999 as u16, r16)
    repeat 8 in j:
        print p[j], " "
    end
    println ""
    println pick_big(9, 1 as i64, 2 as i64, 3 as i64, 4 as i64, 5 as i64, 6 as i64, 7 as i64, 8 as i64, 9 as i64, 10 as i64)
    println pick_big(3, 0 - 5000000000 as i64, 5000000000 as i64, 3 as i64, 4 as i64, 5 as i64, 0 as i64, 7 as i64, 8 as i64, 9 as i64, 10 as i64)
end
