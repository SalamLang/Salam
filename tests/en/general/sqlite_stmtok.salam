import db.sqlite

func run():
    db := sqlite.Open(":memory:")
    sqlite.Exec(db, "CREATE TABLE t(v INTEGER)")
    good := sqlite.Query(db, "SELECT v FROM t")
    println sqlite.StmtOk(good)
    sqlite.Finish(good)
    bad := sqlite.Query(db, "SELECT v FROM missing")
    println sqlite.StmtOk(bad)
    sqlite.Close(db)
end

func main:
    if sqlite.Available():
        run()
    else:
        println true
        println false
    end
end
