import db.sqlite
func run():
    db := sqlite.Open(":memory:")
    sqlite.Exec(db, "CREATE TABLE t(id INTEGER PRIMARY KEY)")
    sqlite.Begin(db)
    sqlite.Exec(db, "INSERT INTO t(id) VALUES (1), (2)")
    sqlite.Commit(db)
    println sqlite.QueryInt(db, "SELECT COUNT(*) FROM t")
    sqlite.Close(db)
end

func main:
    if sqlite.Available():
        run()
    else:
        println 2
    end
end
