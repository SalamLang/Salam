import stats
import fmt

func main:
    mut v := Vector {} as Vector<f64> v.Push(3.0)
    v.Push(1.0)
    v.Push(2.0)
    println stats.Sum(v)
    println stats.Mean(v)
    println stats.Min(v)
    println stats.Max(v)
    println stats.Median(v)
    mut v4 := Vector {} as Vector<f64> v4.Push(4.0)
    v4.Push(1.0)
    v4.Push(3.0)
    v4.Push(2.0)
    println stats.Median(v4)
    mut w := Vector {} as Vector<f64> w.Push(2.0)
    w.Push(4.0)
    w.Push(4.0)
    w.Push(4.0)
    w.Push(5.0)
    w.Push(5.0)
    w.Push(7.0)
    w.Push(9.0)
    println stats.PopVariance(w)
    println stats.PopStdev(w)
    println fmt.FloatPrec(stats.Variance(w), 4)
    println fmt.FloatPrec(stats.Stdev(w), 4)
    mut g := Vector {} as Vector<f64> g.Push(1.0)
    g.Push(100.0)
    println fmt.FloatPrec(stats.Geomean(g), 2)
    println stats.Percentile(v4, 0.0)
    println stats.Percentile(v4, 25.0)
    println stats.Percentile(v4, 50.0)
    println stats.Percentile(v4, 100.0)
    e := Vector {} as Vector<f64> println stats.Mean(e)
    println stats.Stdev(e)
end
