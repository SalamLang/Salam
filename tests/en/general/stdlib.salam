import math
import str

func main:
    println math.Sqrt(16.0)
    println math.Pow(2.0, 10.0)
    println str.Len("hello")
    println str.Compare("a", "b")
    println str.Concat("foo", "bar")
    parts := str.Split("a,b,c,d", ",")
    defer parts.free()
    println parts.len()
end
