func main:
    s := "salam donya"
    println s.starts_with("salam")
    println s.starts_with("donya")
    println s.ends_with("donya")
    println s.ends_with("salam")
    println s.includes("am do")
    println s.includes("xyz")
    println s.starts_with("")
    println s.ends_with("")
    println "ab".ends_with("abc")
    println "سلام دنیا".starts_with("سلام")
    println "سلام دنیا".ends_with("دنیا")
    if s.includes("don") and not s.ends_with("x"):
        println "ok"
    end
end
