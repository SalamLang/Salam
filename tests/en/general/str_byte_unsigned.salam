func main:
    s := "é"
    c := s[0]
    println s.Len(), s[0] as int, c as int, c as i64, (c as u8) as int
    println c > 'z', s[1] < 'a'
    mut hex := ""
    repeat s.Len() in i:
        hex += (s[i] as int) + " "
    end
    println hex.Trim()
end
