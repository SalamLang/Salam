import str

func main:
    println str.Compare("a", "b")
    println str.Compare("a", "z")
    println str.Compare("z", "a")
    println str.Compare("abc", "abc")
    println str.Compare("", "salam")
    println str.Compare("salam", "")
    println str.Compare("apple", "apricot")
end
