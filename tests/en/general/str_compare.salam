import str

// str.Compare answers -1, 0 or 1 and nothing else. C's strcmp only promises a
// sign, and each libc picks its own magnitude: glibc on x86-64 hands back the
// difference of the first differing bytes, on aarch64 something else again.
// Pairs far apart in the alphabet are here so a raw strcmp shows up as a
// wrong number on any machine, not only the one the CI happens to run.
func main:
    println str.Compare("a", "b")
    println str.Compare("a", "z")
    println str.Compare("z", "a")
    println str.Compare("abc", "abc")
    println str.Compare("", "salam")
    println str.Compare("salam", "")
    println str.Compare("apple", "apricot")
end
