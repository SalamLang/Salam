import str

func main:
    println str.ToEnglishDigits("۰۱۲۳۴۵۶۷۸۹")
    println str.ToEnglishDigits("٠١٢٣٤٥٦٧٨٩")
    println str.ToPersianDigits("0123456789")
    println str.ToArabicDigits("0123456789")
    println str.ToEnglishDigits("قیمت: ۱۲۳ تومان و 45 دلار و ٦٧ ریال")

    println str.DigitValue(48), str.DigitValue(1776), str.DigitValue(1632), str.DigitValue(65)

    println str.HasEnglishDigits("abc123"), str.HasEnglishDigits("abc")
    println str.HasPersianDigits("سلام ۱۲۳"), str.HasPersianDigits("42")
    println str.HasArabicDigits("مرحبا ٤٥٦"), str.HasArabicDigits("۱۲۳")
end
