func main:
    a := "abcdef"
    println "[" + a.Substr(2, 100) + "]"
    println "[" + a.Substr(0 - 2, 3) + "]"
    println "[" + a.Substr(50, 2) + "]"
    println "[" + a.Substr(2, 0 - 1) + "]"
    println "[" + a.Substr(6, 1) + "]"
    println a.Find(""), a.Find("f"), a.Find("zz")
    println "[" + "  x y  ".Trim() + "]"
    println "[" + "".Trim() + "]"
    println "[" + "ab".Repeat(0) + "]", "[" + "ab".Repeat(0 - 2) + "]", "ab".Repeat(3)
    println "AbC-ÄÖ".Lower(), "AbC-äö".Upper()
    println "12abc".ToInt(), "-7".ToInt(), " 42".ToInt(), "x".ToInt()
    println "99999999999".ToInt()
    println "1.5e2".ToFloat(), "abc".ToFloat()
    println "a,,b".Split(",").Len()
    println "".Split(",").Len()
    println "".Len(), "".CharCount()
    println "[" + "".CharAt(0) + "]", "".CharFind(""), "".CharFind("a")
    println "[" + "".CharSubstr(0, 3) + "]"
end
