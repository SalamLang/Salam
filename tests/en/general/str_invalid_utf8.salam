func main:
    bad := "a\xFFb"
    trunc := "x\xC3"
    cont := "\x80z"
    pair := "\xED\xA0\x80"
    println "bad", bad.len(), bad.char_count(), bad[0] as int, bad[1] as int, bad[2] as int
    println "trunc", trunc.len(), trunc[1] as int
    println "cont", cont.len(), cont[0] as int, cont[1] as int
    println "pair", pair.len(), pair[0] as int, pair[1] as int, pair[2] as int
    println "find", bad.find("b"), trunc.find("x")
    println "sub", bad.substr(0, 1).len(), bad.substr(1, 1).len()
end
