import str

func show(s: str):
    println "[" + s + "]"
end

func main:
    show(str.Replace("hello world", "o", "0"))
    show(str.Replace("aaa", "aa", "b"))
    show(str.Replace("abc", "", "x"))
    show(str.Replace("abc", "abcd", "x"))
    show(str.Replace("abc", "abc", ""))
    show(str.Replace("", "a", "b"))
    show(str.Replace("a,b,,c,", ",", ""))
    show(str.Replace("سلام دنیا سلام", "سلام", "درود"))
    show(str.Replace("xyx", "x", "longer-text"))
    show(str.Replace("start middle end", "start", "S"))
    show(str.Replace("start middle end", "end", "E"))
    show(str.Replace("no match here", "zz", "q"))
    mut b := str.NewBuilder()
    repeat 200000 in _:
        str.BufAppend(b, "ab,")
    end
    big := str.BufStr(b)
    str.BufFree(b)
    r := str.Replace(big, ",", ";;")
    println r.len(), str.Count(r, ";;"), str.Count(r, ",")
end
