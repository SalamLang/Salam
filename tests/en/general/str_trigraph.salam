// "??/" and friends are trigraphs to a C compiler, which ignores them but
// warns (-Wtrigraphs, part of -Wall). The C backend escapes the second
// `?` so the sequence never appears in the emitted text.

func main:
    println "??/ ??= ??( ??) ??' ??< ??> ??! ??-"
    s := "a??=b"
    println s, len(s)
    println "?" + "?" + "?"
end
