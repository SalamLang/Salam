import str

func main:
    println str.IsAlpha(0x0633), str.IsAlpha(0x0627), str.IsAlpha(0x06CC)
    println str.IsAlnum(0x06F3), str.IsDigit(0x0667)

    println str.IsAsciiDigit(0x0037), str.IsAsciiDigit(0x06F7)
    println str.IsAsciiAlpha(0x0041), str.IsAsciiAlpha(0x0633)
    println str.IsAscii(0x007F), str.IsAscii(0x0080)

    println str.IsSpace(0x00A0), str.IsSpace(0x3000), str.IsSpace(0x000C)
    println str.IsSpace(0x200C)

    println "[" + str.TrimLeft(" 　 hi") + "]"
    println "[" + str.TrimRight("hi  　") + "]"

    f := str.Fields("سلام دنیا می‌رود")
    println f.len()
    repeat f.len() with i: println f.get(i) end

    println str.EqualFold("Hello", "hELLO")
    println str.EqualFold("STRASSE", "straße")
    println str.EqualFold("Σ", "ς"), str.EqualFold("σ", "ς")
    println str.EqualFold("سلام", "سلام")
    println str.EqualFold("abc", "abd")
    println str.CompareFold("abc", "ABC")
    println str.CompareFold("a", "ab") < 0, str.CompareFold("ab", "a") > 0

    println str.Title("hello world")
    println str.Title("سلام دنیا")

    s := "aس۳1"
    mut i := 0
    mut cp := 0
    until i < s.len():
        i = str.CodePointAt(s, i, cp)
        println cp, str.IsAlpha(cp), str.IsDigit(cp)
    end
end
