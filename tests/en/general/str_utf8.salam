func main:
    s := "سلام hi 👋!"
    println s.Len(), s.CharCount()
    println s.Find("hi"), s.CharFind("hi")
    println s.Substr(0, 2), s.CharSubstr(0, 2)
    println s.CharAt(1), s.CharAt(8)
    println "[" + s.CharAt(10) + "]"
    println s.CharSubstr(5, 100)
    println s.CharFind("👋"), s.CharFind("xyz")
    word := "درود"
    mut out := ""
    repeat word.CharCount() in i:
        out = out + word.CharAt(i) + "."
    end
    println out
end
