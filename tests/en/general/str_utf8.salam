func main:
    s := "سلام hi 👋!"
    println s.len(), s.char_count()
    println s.find("hi"), s.char_find("hi")
    println s.substr(0, 2), s.char_substr(0, 2)
    println s.char_at(1), s.char_at(8)
    println "[" + s.char_at(10) + "]"
    println s.char_substr(5, 100)
    println s.char_find("👋"), s.char_find("xyz")
    word := "درود"
    mut out := ""
    repeat word.char_count() in i:
        out = out + word.char_at(i) + "."
    end
    println out
end
