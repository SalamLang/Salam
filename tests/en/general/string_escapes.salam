func main:
    println "hello\tworld"
    println "line1\nline2"
    println "back\\slash"
    println "quote: \"hi\""
    println "apostrophe: \'ok\'"
    println "\x48\x65\x6C\x6C\x6F"
    println "\x41\x42\x43"
    println "abc\x64ef"
end
