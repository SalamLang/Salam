import str

func label(n: int): str:
    head := "item-" + str.FromInt(n as i64)
    ret head.len() > 3 ? "long" : "short"
end

func build(n: int): str:
    ret "a" + str.FromInt(n as i64) + "b" + n + "c" + true + 'x'
end

func count(n: int): int:
    mut total := 0
    repeat n in i:
        line := "row " + i + ": " + (i * 2)
        if str.StartsWith(line, "row"):
            total += line.len()
        end
        println line
    end
    ret total
end

func keep(n: int): Vector<str>:
    mut v := Vector {} as Vector<str>
    repeat n in i:
        s := "k" + i
        v.push(s)
    end
    ret v
end

func main:
    println label(5)
    b := build(7)
    println b
    println count(3)
    mut v := keep(3)
    println v.get(2)
    v.free()
    t := "x" + 1 + "y"
    switch t:
        "x1y": println "match" break end
        else: println "no" break end
    end
end
