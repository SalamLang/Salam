import str

func describe(n: int): int:
    r := match n:
        1:
            s := "one-" + str.FromInt(n as i64)
            println s
            s.len()
        end
        else:
            t := "many-" + str.FromInt(n as i64)
            t.len()
        end
    end
    ret r
end

func main:
    println describe(1), describe(5)
end
