EXAMPLES := [
    Entry { id = 1, name = "a" }, Entry { id = 2, name = "b" }, Entry { id = 3, name = "c" }
] as Entry[3]

struct Entry:
    pub id: int = 0
    pub name: str = ""
end

func main:
    println EXAMPLES.len()
    println len(EXAMPLES)
end
