struct Client:
    pub host: str
    pub port: int = 443
    pub name: str = "anon"
end

func main:
    a := Client { host = "a.test" }
    println a.host, a.port, a.name
    b := Client { host = "b.test", port = 80, name = "bob" }
    println b.host, b.port, b.name
end
