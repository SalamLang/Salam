import encoding.json

const LABEL := "z"
const SEVEN := 7

struct Wrap:
    pub b: Box<int>
end

struct Box<T>:
    @en "user"
    pub u: str = ""
    pub p: str = ""
    pub v: T
    rule user needs p
    rule atmostone(user, v)
end

struct In:
    @json "" "optional"
    pub x: str
    pub y: str = ""
    rule x == "v" needs y
end

struct Vals:
    pub n: int = 0
    pub m: int = 0
    pub f: f32 = 0.0
    pub g: f64 = 1.5
    pub mode: str = "a"
    pub k: int = SEVEN
    pub y: str = ""
    pub needs: int = 0
    pub other: int = 0
    rule n == -3 needs y
    rule f == 2.5 needs y
    rule g == -1.5 needs y
    rule mode == "x" needs y
    rule k == 8 needs y
    rule needs needs other
    rule other needs needs
end

struct Dup:
    pub a: int = 0
    pub b: int = 0
    pub c: int = 0
    rule a needs b
    rule allornone(a, b)
    rule a needs b, c
end

struct Text:
    @json "" "string"
    pub n: int = 0
    pub y: str = ""
    rule n == 5 needs y
end

func main:
    b := Box { p = "p", v = 1 } as Box<int>
    println b.p
    println Vals { n = 1, f = 1.5 as f32, g = 2.0, mode = LABEL, k = 9 }.n
    println Vals { n = -3, y = "s" }.y
    println Vals { needs = 1, other = 2 }.other
    mut items := Vector {} as Vector<In>
    try:
        json.Unmarshal(`[{"y":"k"}]`, items)
        println items.Len(), items.get(0).y
        json.Unmarshal(`[{"x":"v"}]`, items)
    catch e:
        println "err", e.message
    end
    println json.Schema(Dup {})
    println json.Schema(Text {})
end
