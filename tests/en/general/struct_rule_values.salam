import encoding.json

enum Mode:
    Plain, Tls
end

struct Ssh:
    pub use_key: bool = false
    pub key_pem: str = ""
    pub mode: Mode = Mode.Plain
    pub cert: str = ""
    pub port: int = 22
    pub sock: str = ""
    pub kind: str = "tcp"
    pub path: str = ""
    pub secure: bool = true
    pub ca: str = ""
    rule use_key == true needs key_pem
    rule mode == Mode.Tls needs cert
    rule port == 0 needs sock
    rule kind == "unix" needs path
    rule secure == true needs ca
end

func show(text: str):
    mut r := Ssh { ca = "" }
    try:
        json.Unmarshal(text, r)
        println "ok", r.use_key, r.port
    catch e:
        println "err", e.message
    end
end

func main:
    a := Ssh { use_key = false, ca = "c" }
    println a.use_key
    b := Ssh { use_key = true, key_pem = "pem", ca = "c" }
    println b.key_pem
    c := Ssh { mode = Mode.Plain, port = 2222, kind = "tcp", secure = false }
    println c.port
    d := Ssh { mode = Mode.Tls, cert = "x", port = 0, sock = "s", kind = "unix", path = "p", ca = "c" }
    println d.cert, d.sock, d.path
    flag := a.use_key
    e := Ssh { use_key = flag, key_pem = "pem", secure = false }
    println e.key_pem
    show(`{"ca":"c"}`)
    show(`{"use_key":true,"key_pem":"p","ca":"c"}`)
    show(`{"use_key":true,"ca":"c"}`)
    show(`{"mode":"Tls","ca":"c"}`)
    show(`{"port":0,"ca":"c"}`)
    show(`{"kind":"unix","ca":"c"}`)
    show(`{"secure":false}`)
    println json.Schema(Ssh { ca = "" })
end
