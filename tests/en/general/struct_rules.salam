 * Repository: https://github.com/SalamLang/Salam
 *
 */

struct Client:
    pub host: str
    pub rule: int = 1
    pub user: str = ""
    pub pass: str = ""
    pub token: str = ""
    pub cert: str = ""
    pub key: str = ""
    pub a: int = 0
    pub b: int = 0
    pub c: int = 0
    rule user needs pass
    rule allornone(cert, key)
    rule anyof(user, token)
    rule atmostone(a, b, c)
end

struct Mode:
    pub plain: bool = false
    pub secret: str = ""
    rule oneof(plain, secret)
end

struct Oneway:
    pub key1: str = ""
    pub key2: str = ""
    rule key1 needs key2
end

struct Box<T>:
    pub value: T
    pub label: str = ""
    pub note: str = ""
    rule label needs note
end

struct Auth:
    pub user: str = ""
    pub pass: str = ""
    rule allornone(user, pass)
end

struct Site:
    pub use Auth
    pub name: str = ""
end

func describe(c: Client): str:
    ret c.host + " " + c.user + " " + c.token
end

func main:
    a := Client { host = "a", user = "u", pass = "p", cert = "c", key = "k", b = 2 }
    println describe(a), a.rule, a.b
    b := Client { host = "b", token = "t" }
    println describe(b), b.cert, b.a
    println Mode { plain = true }.plain
    println Mode { secret = "s" }.secret
    println Oneway {}.key1 == ""
    println Oneway { key2 = "only" }.key2
    println Oneway { key1 = "one", key2 = "two" }.key1
    println (Box { value = 1 } as Box<int>).value
    println (Box { value = 2, label = "l", note = "n" } as Box<int>).label
    println Site { name = "s" }.name
    println Site { user = "u", pass = "p" }.pass
    mut late := Oneway {}
    late.key1 = "set later"
    println late.key1
end
