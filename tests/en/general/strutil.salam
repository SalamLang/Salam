func main:
    s := "hello world"
    println s.Len()
    println s.substr(0, 5)
    println s.find("world")
    println s.find("xyz")
    println "  trim me  ".trim()
    println "a,b,c,d".split(",").Len()
    parts := "10 20 30".split(" ")
    defer parts.Free()
    mut total := 0
    repeat parts.Len() in i:
        total += parts.get(i).ToInt()
    end
    println total
    println "3.5".ToFloat() + 1.5
    println "foo".concat("bar")
end
