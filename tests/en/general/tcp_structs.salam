import net.tcp

func main:
    refused := tcp.Dial("127.0.0.1", 1)
    println tcp.ConnOk(refused)
    srv := tcp.Bind(0)
    println tcp.Ok(srv)
    tcp.CloseServer(srv)
    println "done"
end
