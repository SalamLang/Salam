// Progress-bar layout and the two number formatters, exercised through the
// pure render half so no terminal is needed.
//
// Every varying input is pinned deliberately: `width` is set so the bar
// never consults the terminal size, `fill`/`empty` are set so the locale's
// UTF-8-ness cannot swap in block characters, and the spinner is built from
// explicit frames for the same reason. Draw calls are intentionally left
// out - off a terminal they write nothing, which is itself checked below.
package main

import term
import str

func bar(b &: term.Bar): str:
    ret "[" + term.BarRender(b) + "]"
end

func main:
    println "-- format bytes"
    println term.FormatBytes(0 as i64)
    println term.FormatBytes(999 as i64)
    println term.FormatBytes(1023 as i64)
    println term.FormatBytes(1024 as i64)
    println term.FormatBytes(1536 as i64)
    println term.FormatBytes(1048576 as i64)
    println term.FormatBytes(5242880 as i64)
    println term.FormatBytes(3221225472 as i64)
    println term.FormatBytes(0 - 5 as i64)

    println "-- format duration"
    println term.FormatDuration(0 as i64)
    println term.FormatDuration(250 as i64)
    println term.FormatDuration(1234 as i64)
    println term.FormatDuration(9900 as i64)
    println term.FormatDuration(45000 as i64)
    println term.FormatDuration(185000 as i64)
    println term.FormatDuration(3600000 as i64)
    println term.FormatDuration(7325000 as i64)

    println "-- bar"
    mut b := term.NewBar(10, "build")
    b.width = 20
    b.fill = "#"
    b.empty = "-"
    println bar(b)
    term.BarSet(b, 1)
    println bar(b)
    term.BarSet(b, 5)
    println bar(b)
    term.BarSet(b, 10)
    println bar(b)

    // Out-of-range updates clamp instead of overflowing the bar.
    term.BarSet(b, 99)
    println bar(b)
    term.BarSet(b, 0 - 5)
    println bar(b)
    term.BarAdd(b, 3)
    println bar(b)

    println "-- bar options"
    b.show_count = true
    println bar(b)
    b.show_percent = false
    println bar(b)
    b.show_count = false
    b.label = ""
    println bar(b)

    println "-- bar head"
    mut h := term.NewBar(4, "")
    h.width = 8
    h.fill = "="
    h.empty = " "
    h.head = ">"
    term.BarSet(h, 2)
    println bar(h)
    term.BarSet(h, 4)
    println bar(h)

    println "-- zero total"
    mut z := term.NewBar(0, "")
    z.width = 6
    z.fill = "#"
    z.empty = "-"
    println bar(z)

    println "-- draws are silent off a terminal"
    term.BarDraw(b)
    term.BarDraw(h)
    println "still-here"

    println "-- spinner"
    mut frames := Vector {} as Vector<str>
    defer frames.free()
    frames.push("|")
    frames.push("/")
    frames.push("-")
    mut s := term.NewSpinnerFrames("working", frames)
    defer term.SpinnerFree(s)
    repeat 5:
        println term.SpinnerFrame(s)
        term.SpinnerTick(s)
    end
    println "idx = " + str.FromInt(s.idx as i64)
end
