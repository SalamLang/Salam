package main

import term
import str

func show(label: str, s: str):
    println label + " = " + str.Replace(s, "\x1b", "<E>")
end

func main:
    term.SetColorMode(term.ColorAlways)

    show("red", term.Red("hi"))
    show("green", term.Green("hi"))
    show("bold", term.Bold("hi"))
    show("underline", term.Underline("hi"))
    show("gray", term.Gray("hi"))
    show("brightblue", term.BrightBlue("hi"))
    show("onred", term.OnRed("hi"))
    show("style", term.Style("hi", term.StyleStrike))
    show("c256", term.Color256("hi", 42))
    show("onc256", term.OnColor256("hi", 42))
    show("rgb", term.RGB("hi", 255, 128, 0))
    show("onrgb", term.OnRGB("hi", 0, 64, 255))
    show("sgr", term.Sgr(31))

    show("nested", term.Bold("a" + term.Red("b") + "c"))
    show("empty", term.Paint("", term.Sgr(31)))

    term.SetColorMode(term.ColorNever)
    show("off-red", term.Red("hi"))
    show("off-bold", term.Bold("hi"))
    show("off-rgb", term.RGB("hi", 1, 2, 3))
    println "mode = " + str.FromInt(term.ColorMode() as i64)

    term.SetColorMode(term.ColorAlways)

    painted := term.Red("hello")
    println "strip = " + term.Strip(painted)
    println "width = " + str.FromInt(term.Width(painted) as i64)
    println "bytes = " + str.FromInt(str.Len(painted) as i64)
    println "width-utf8 = " + str.FromInt(term.Width("سلام") as i64)
    println "width-plain = " + str.FromInt(term.Width("abc") as i64)
    println "width-empty = " + str.FromInt(term.Width("") as i64)

    println "strip-osc = [" + term.Strip(term.SeqTitle("t") + "x") + "]"

    show("trunc", term.Truncate(term.Red("hello world"), 5))
    println "trunc-plain = " + term.Truncate("hello world", 5)
    println "trunc-short = " + term.Truncate("hi", 5)
    println "trunc-zero = [" + term.Truncate("hi", 0) + "]"

    println "pad-right = [" + term.Strip(term.PadRight(term.Red("ab"), 6)) + "]"
    println "pad-left = [" + term.Strip(term.PadLeft(term.Red("ab"), 6)) + "]"
    println "center = [" + term.Strip(term.Center(term.Red("ab"), 6)) + "]"
    println "pad-noop = [" + term.PadRight("abcdef", 3) + "]"
end
