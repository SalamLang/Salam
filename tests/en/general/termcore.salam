// The terminal-facing half of term, checked in the one situation a test
// suite can guarantee: stdout is a pipe, not a terminal.
//
// That is what makes this test meaningful rather than awkward - every
// question here has a defined answer when there is no tty, and those
// answers are the fallbacks a CLI depends on when its output is redirected.
// Size still has to report something usable, raw mode has to fail cleanly
// instead of half-applying, and Restore has to decline to act on a state
// that was never established.
package main

import term
import str

func yn(b: bool): str:
    if b: ret "true" end
    ret "false"
end

func main:
    // A pipe is not a terminal, and colour follows suit under ColorAuto.
    term.SetColorMode(term.ColorAuto)
    println "isterminal = " + yn(term.IsTerminal())
    println "color-auto = " + yn(term.SupportsColor())

    // ...but the policy overrides always win, which is what --color=always
    // and --no-color are wired to.
    term.SetColorMode(term.ColorAlways)
    println "color-always = " + yn(term.SupportsColor())
    term.SetColorMode(term.ColorNever)
    println "color-never = " + yn(term.SupportsColor())
    term.SetColorMode(term.ColorAuto)

    // EnableAnsi is a no-op that reports success off Windows.
    println "ansi = " + yn(term.EnableAnsi())

    // Size must always answer with something a caller can divide by, even
    // with no kernel and no environment to ask.
    s := term.Size()
    println "size-positive = " + yn(s.cols > 0 && s.rows > 0)
    println "cols-matches = " + yn(term.Cols() == s.cols)
    println "rows-matches = " + yn(term.Rows() == s.rows)

    // Raw mode on something that is not a terminal must fail cleanly: no
    // half-applied state, and a Restore that knows there is nothing to undo.
    mut st := term.MakeRaw(term.StdinFd)
    println "raw-ok = " + yn(st.ok)
    println "restore = " + yn(term.Restore(st))
    mut cb := term.MakeCbreak(term.StdinFd)
    println "cbreak-ok = " + yn(cb.ok)
    println "restore-twice = " + yn(term.Restore(cb)) + " " + yn(term.Restore(cb))

    // The file descriptors are the POSIX ones, and Write shares the stdout
    // buffer with println, so this line cannot arrive out of order.
    println "fds = " + str.FromInt(term.StdinFd as i64) + str.FromInt(term.StdoutFd as i64) + str.FromInt(term.StderrFd as i64)
    term.Write("written")
    term.Write("\n")
    term.Flush()
    println "done"
end
