// The exact bytes of every cursor, erase, scroll and screen sequence. These
// are what a terminal actually parses, so they are pinned here rather than
// left to be checked by eye - ESC prints as <E>, CR as <R> and BEL as <B>
// to keep the expectation file readable.
package main

import term
import str

func show(label: str, s: str):
    println label + " = " + str.Replace(str.Replace(str.Replace(s, "\x1b", "<E>"), "\r", "<R>"), "\x07", "<B>")
end

func main:
    show("up", term.SeqUp(3))
    show("down", term.SeqDown(1))
    show("right", term.SeqRight(12))
    show("left", term.SeqLeft(2))
    show("nextline", term.SeqNextLine(2))
    show("prevline", term.SeqPrevLine(2))
    show("column", term.SeqColumn(40))
    show("moveto", term.SeqMoveTo(5, 12))
    show("home", term.SeqHome())

    // A non-positive count must produce nothing at all: terminals read a 0
    // parameter as 1, so emitting "CSI 0A" would move instead of standing
    // still and a zero-step loop would walk up the screen.
    show("up-zero", term.SeqUp(0))
    show("up-negative", term.SeqUp(0 - 4))
    show("right-zero", term.SeqRight(0))

    show("save", term.SeqSaveCursor())
    show("restore", term.SeqRestoreCursor())
    show("hide", term.SeqHideCursor())
    show("showcursor", term.SeqShowCursor())

    show("clearscreen", term.SeqClearScreen())
    show("clearscrollback", term.SeqClearScrollback())
    show("clearline", term.SeqClearLine())
    show("cleartoend", term.SeqClearToLineEnd())
    show("cleartostart", term.SeqClearToLineStart())
    show("clearbelow", term.SeqClearBelow())
    show("clearabove", term.SeqClearAbove())
    show("resetline", term.SeqResetLine())

    show("scrollup", term.SeqScrollUp(2))
    show("scrolldown", term.SeqScrollDown(2))
    show("insertlines", term.SeqInsertLines(3))
    show("deletelines", term.SeqDeleteLines(3))
    show("region", term.SeqScrollRegion(2, 20))
    show("regionreset", term.SeqResetScrollRegion())

    show("altenter", term.SeqEnterAltScreen())
    show("altexit", term.SeqExitAltScreen())
    show("mouseon", term.SeqEnableMouse())
    show("mousemotion", term.SeqEnableMouseMotion())
    show("mouseoff", term.SeqDisableMouse())

    show("title", term.SeqTitle("build"))
    println "esc-len = " + str.FromInt(str.Len(term.Esc) as i64)
    println "csi-len = " + str.FromInt(str.Len(term.Csi) as i64)
end
