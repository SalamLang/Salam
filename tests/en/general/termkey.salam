// Keyboard decoding, driven from byte strings rather than a real terminal.
// term.Decode and term.DecodeMouse are pure functions over what a terminal
// sent, which is exactly what makes the key handling of a full-screen
// program testable in a suite that has no tty.
package main

import term
import str

func yn(b: bool): str:
    if b: ret "true" end
    ret "false"
end

func mods(k &: term.Key): str:
    mut out := ""
    if k.ctrl: out = out + "+ctrl" end
    if k.alt: out = out + "+alt" end
    if k.shift: out = out + "+shift" end
    ret out
end

func show(label: str, seq: str):
    mut k := term.Decode(seq)
    println label + " = " + str.FromInt(k.code as i64) + " ch=" + k.ch + mods(k)
end

func main:
    // Plain and control bytes.
    show("char-a", "a")
    show("char-Z", "Z")
    show("digit", "7")
    show("space", " ")
    show("enter-cr", "\r")
    show("enter-lf", "\n")
    show("tab", "\t")
    show("backspace-del", "\x7f")
    show("backspace-bs", "\x08")
    show("escape", "\x1b")
    show("ctrl-a", "\x01")
    show("ctrl-c", "\x03")
    show("ctrl-z", "\x1a")
    show("empty", "")

    // Arrows, in both the CSI and the SS3 (application cursor) forms every
    // terminal switches to inside a full-screen program.
    show("up", "\x1b[A")
    show("down", "\x1b[B")
    show("right", "\x1b[C")
    show("left", "\x1b[D")
    show("ss3-up", "\x1bOA")
    show("csi-home", "\x1b[H")
    show("csi-end", "\x1b[F")

    // xterm's modifier parameter: "CSI 1 ; 5 A" is Ctrl+Up.
    show("ctrl-up", "\x1b[1;5A")
    show("shift-left", "\x1b[1;2D")
    show("alt-down", "\x1b[1;3B")
    show("ctrl-shift-right", "\x1b[1;6C")

    // The "CSI n ~" family.
    show("home-tilde", "\x1b[1~")
    show("insert", "\x1b[2~")
    show("delete", "\x1b[3~")
    show("end-tilde", "\x1b[4~")
    show("pageup", "\x1b[5~")
    show("pagedown", "\x1b[6~")
    show("shift-delete", "\x1b[3;2~")

    // Function keys arrive as SS3 below F5 and as "CSI n ~" above it.
    show("f1", "\x1bOP")
    show("f4", "\x1bOS")
    show("f5", "\x1b[15~")
    show("f6", "\x1b[17~")
    show("f10", "\x1b[21~")
    show("f11", "\x1b[23~")
    show("f12", "\x1b[24~")

    // Alt sends the bare key prefixed with ESC; a whole UTF-8 codepoint
    // comes through intact rather than as its first byte.
    show("alt-x", "\x1bx")
    show("utf8", "س")
    show("unknown", "\x1b[Z")

    println "f-range = " + str.FromInt((term.KeyF1 + 11) as i64)

    // SGR mouse reports: "ESC [ < button ; col ; row M" for a press, and the
    // same ending in 'm' for a release.
    press := term.DecodeMouse("\x1b[<0;12;34M")
    println "press = ok:" + yn(press.ok) + " btn:" + str.FromInt(press.button as i64) + " col:" + str.FromInt(press.col as i64) + " row:" + str.FromInt(press.row as i64) + " down:" + yn(press.pressed)
    release := term.DecodeMouse("\x1b[<0;12;34m")
    println "release = ok:" + yn(release.ok) + " down:" + yn(release.pressed)
    drag := term.DecodeMouse("\x1b[<32;100;200M")
    println "drag = ok:" + yn(drag.ok) + " motion:" + yn(drag.motion) + " col:" + str.FromInt(drag.col as i64)
    right := term.DecodeMouse("\x1b[<2;5;6M")
    println "right-btn = " + str.FromInt(right.button as i64)
    bad := term.DecodeMouse("\x1b[A")
    println "not-mouse = " + yn(bad.ok)

    // A mouse report reaching Decode is reported as such rather than being
    // mistaken for a cursor key.
    mk := term.Decode("\x1b[<0;1;1M")
    println "decode-mouse = " + str.FromInt(mk.code as i64)
end
