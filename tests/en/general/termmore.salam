package main

import term
import str
import env

func vis(s: str): str:
    ret str.Replace(str.Replace(s, "\x1b", "<E>"), "\x07", "<B>")
end

func show(label: str, s: str):
    println label + " = " + vis(s)
end

func yn(b: bool): str:
    if b: ret "true" end
    ret "false"
end

func main:
    term.SetColorMode(term.ColorAlways)
    show("dim", term.Dim("x"))
    show("italic", term.Italic("x"))
    show("blink", term.Blink("x"))
    show("hidden", term.Hidden("x"))
    show("strike", term.Strike("x"))
    show("yellow", term.Yellow("x"))
    show("magenta", term.Magenta("x"))
    show("cyan", term.Cyan("x"))
    show("brightred", term.BrightRed("x"))
    show("brightgreen", term.BrightGreen("x"))
    show("brightyellow", term.BrightYellow("x"))
    show("brightmagenta", term.BrightMagenta("x"))
    show("brightcyan", term.BrightCyan("x"))
    show("brightwhite", term.BrightWhite("x"))
    show("ongreen", term.OnGreen("x"))
    show("onyellow", term.OnYellow("x"))
    show("onblue", term.OnBlue("x"))
    show("onmagenta", term.OnMagenta("x"))
    show("oncyan", term.OnCyan("x"))
    show("onwhite", term.OnWhite("x"))
    show("fg256", term.SeqFg256(200))
    show("bg256", term.SeqBg256(17))
    show("fgrgb", term.SeqFgRGB(1, 2, 3))
    show("bgrgb", term.SeqBgRGB(4, 5, 6))
    term.SetColorMode(term.ColorAuto)

    println "tty-fd-matches = " + yn(term.IsTTY(term.StdoutFd) == term.IsTerminal())
    println "tty-bad-fd = " + yn(term.IsTTY(99))
    ct := env.Get("COLORTERM")
    println "truecolor = " + yn(term.SupportsTrueColor() == (ct == "truecolor" or ct == "24bit"))
    t := env.Get("TERM")
    println "256color = " + yn(term.Supports256Color() == (str.Contains(t, "256color") or ct.Len() > 0))

    term.Write("emit:\n")
    term.Up(1)
    term.Write("\n")
    term.Down(2)
    term.Write("\n")
    term.Right(3)
    term.Write("\n")
    term.Left(4)
    term.Write("\n")
    term.NextLine(2)
    term.Write("\n")
    term.PrevLine(2)
    term.Write("\n")
    term.Column(5)
    term.Write("\n")
    term.MoveTo(3, 4)
    term.Write("\n")
    term.Home()
    term.Write("\n")
    term.SaveCursor()
    term.Write("\n")
    term.RestoreCursor()
    term.Write("\n")
    term.HideCursor()
    term.Write("\n")
    term.ShowCursor()
    term.Write("\n")
    term.ClearScreen()
    term.Write("\n")
    term.ClearScrollback()
    term.Write("\n")
    term.ClearLine()
    term.Write("\n")
    term.ClearToLineEnd()
    term.Write("\n")
    term.ClearBelow()
    term.Write("\n")
    term.ResetLine()
    term.Write("\n")
    term.ScrollUp(1)
    term.Write("\n")
    term.ScrollDown(1)
    term.Write("\n")
    term.InsertLines(2)
    term.Write("\n")
    term.DeleteLines(2)
    term.Write("\n")
    term.SetScrollRegion(1, 10)
    term.Write("\n")
    term.ResetScrollRegion()
    term.Write("\n")
    term.EnterAltScreen()
    term.Write("\n")
    term.ExitAltScreen()
    term.Write("\n")
    term.EnableMouse()
    term.Write("\n")
    term.DisableMouse()
    term.Write("\n")
    term.Bell()
    term.Write("\n")
    term.SetTitle("demo")
    term.Write("\n")
    term.Flush()

    term.SetColorMode(term.ColorNever)
    mut b := term.NewBar(4, "job")
    b.width = 8
    b.fill = "#"
    b.empty = "-"
    term.BarSet(b, 2)
    term.BarFinish(b)

    mut sp := term.NewSpinner("wait")
    println "frame-present = " + yn(term.SpinnerFrame(sp).Len() > 0)
    term.SpinnerTick(sp)
    term.SpinnerStop(sp, "spinner done")
    term.SpinnerFree(sp)

    if term.IsTTY(term.StdinFd) == false:
        println "key-ready = " + yn(term.KeyReady(0))
        println "byte = " + str.FromInt(term.ReadByte() as i64)
        k := term.ReadKey()
        println "key-eof = " + yn(k.code == term.KeyEOF)
        pw := term.ReadPassword("password: ")
        println "password-len = " + str.FromInt(pw.Len() as i64)
    end

    term.WriteErr("to stderr\n")
    println "done"
end
