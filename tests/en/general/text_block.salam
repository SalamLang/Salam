const OB_SIZE := 65536
const ABI := "salam1"
const DEBUG := false

struct Point:
    pub x: int = 0
    pub y: int = 0
end

func shout(s: str): str:
    ret s.upper()
end

func wrap(s: str): str:
    ret "[" + s + "]"
end

func main:
    name := "Ali"
    n := 7
    hdr := ```
        #define SALAM_OB_SZ ${{ OB_SIZE }}
        #define HALF ${{OB_SIZE / 2}}
        #define ABI "${{  ABI  }}" debug=${{ DEBUG }}
        static inline int nl(void) { return '\n' == 10; }
        ```
    println hdr
    msg := ```
        hello ${{ name }}, n=${{ n + 1 }} ${{ shout("x") }} big=${{ n > 3 }}

            indented line
        point=${{ Point { x = 3, y = 4 }.x }} braces=${{ "}}" }}
        end
        ```
    println msg
    esc := ```
        literal: $${{ not injected }}
        plain: $ {{a}} ${b} $$ }} {
        ```
    println esc
    println wrap(```
        ${{ name }} first
        ```)
    println "[" + ```
        no injections here
        ``` + "]"
end
