func main:
    println """hello "world" """
    println """line1\nline2"""
    println """tab\there"""
    println """say "hi" and salam"""
    println """back\\slash"""
    println """one " two "" three"""
    println """\x48\x65\x6C\x6C\x6F"""
    println """quote: " and escape: \t done"""
end
