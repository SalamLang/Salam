type Bytes = size

struct Buf:
    pub cap: int = 0
    pub size: int = 0
    pub len: int = 0
    pub key: str = ""
end

func grow(size: int): int:
    ret size * 2
end

func half(n: size): size:
    ret n / (2 as size)
end

func main:
    size := 5
    total := size + grow(size)
    mut b := Buf { size = total, key = "k" }
    b.cap = 64
    b.len = b.size / 3
    mut m := HashMap {} as HashMap<str, size>
    m.Put("a", 7 as size)
    mut v := Vector {} as Vector<int>
    v.Push(b.len)
    v.Push(b.cap)
    w := 9 as Bytes
    println size, total, b.size, b.cap, b.len, b.key, v.Len(), v.Get(1), m.Get("a"), half(w)
end
