func main:
    e := u'é'
    s := u'س'
    smile := u'😀'
    println e as int, s as int, smile as int
    println e as i64, s as u32, u'A' as u8
    println 1587 as uchar, 233 as uchar, 128512 as uchar
    code := s as int
    println (code + 1) as uchar
    bad := 2000000 as uchar
    println bad as int
    neg := -5
    println (neg as uchar) as int
end
