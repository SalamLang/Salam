func twice(v: int): int: ret v * 2 end

func main:
    _k8 := twice(4)
    _linux := twice(5)
    _unix := twice(6)
    _amd64 := twice(7)
    _core2 := twice(8)
    println _k8, _linux, _unix, _amd64, _core2

    a_b := 1
    _a_b := 2
    __a_b := 3
    println a_b, _a_b, __a_b

    _ignored := twice(9)
    println "done"
end
