// A leading underscore is the "declared on purpose, never read" spelling, so
// these names reach the C backend verbatim. They must not land in C's
// reserved "__*" namespace: gcc predefines __k8, __linux, __unix and friends
// as target macros there, and a name that collides expands to `1` before the
// C compiler ever sees a declaration.

func twice(v: int): int: ret v * 2 end

func main:
    // Every one of these is a real gcc/clang predefined macro once the
    // leading underscore is doubled.
    _k8 := twice(4)
    _linux := twice(5)
    _unix := twice(6)
    _amd64 := twice(7)
    _core2 := twice(8)
    println _k8, _linux, _unix, _amd64, _core2

    // Interior underscores still have to stay distinct from leading ones.
    a_b := 1
    _a_b := 2
    __a_b := 3
    println a_b, _a_b, __a_b

    // And a genuinely unused one still compiles without a warning.
    _ignored := twice(9)
    println "done"
end
