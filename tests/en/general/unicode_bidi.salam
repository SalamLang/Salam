import bidi
import str
import unicode

// Prints the resolved levels as a space-separated list, with "x" for the
// characters rule X9 removes.
func levels_of(s: str, dir: int): str:
    lv := bidi.Levels(s, dir)
    defer lv.free()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat lv.len() with i:
        if i > 0: str.BufAppend(sb, " ") end
        if lv.get(i) < 0: str.BufAppend(sb, "x")
        else: str.BufAppendInt(sb, lv.get(i) as i64) end
    end
    ret str.BufStr(sb)
end

func order_of(s: str, dir: int): str:
    o := bidi.VisualOrder(s, dir)
    defer o.free()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat o.len() with i:
        if i > 0: str.BufAppend(sb, " ") end
        str.BufAppendInt(sb, o.get(i) as i64)
    end
    ret str.BufStr(sb)
end

func main:
    // P2/P3: the base direction is that of the first strong character.
    println bidi.ParagraphLevel("hello", bidi.DirAuto)
    println bidi.ParagraphLevel("سلام", bidi.DirAuto)
    println bidi.ParagraphLevel("123", bidi.DirAuto)

    // A Persian sentence that opens with an English word auto-detects as
    // left-to-right, which is why a document that knows its language should
    // say so instead of leaving it to the text.
    println bidi.ParagraphLevel("Salam سلام", bidi.DirAuto)
    println bidi.ParagraphLevel("Salam سلام", bidi.DirRTL)

    // Arabic and Persian letters are AL; Arabic-Indic digits are AN, and they
    // run left to right inside right-to-left text.
    println unicode.BidiClass(0x0633) == unicode.BcAL
    println unicode.BidiClass(0x0660) == unicode.BcAN
    println unicode.BidiClass(0x05D0) == unicode.BcR
    println unicode.BidiClass(0x0041) == unicode.BcL

    // Pure right-to-left text simply reverses.
    println levels_of("سلام", bidi.DirAuto)
    println order_of("سلام", bidi.DirAuto)

    // A number inside right-to-left text keeps its own direction: the digits
    // of "۱۲۳" stay in reading order even though the words around them do not.
    println levels_of("سلام ۱۲۳", bidi.DirRTL)
    println order_of("سلام ۱۲۳", bidi.DirRTL)

    // An English word embedded in a Persian sentence.
    println levels_of("سلام abc", bidi.DirRTL)
    println order_of("سلام abc", bidi.DirRTL)

    // N0: brackets take the direction of what they enclose, so the
    // parentheses around a Persian phrase face the right way.
    println levels_of("(سلام)", bidi.DirRTL)
    println order_of("(سلام)", bidi.DirRTL)

    // Reordering is its own inverse only for text that is entirely one
    // direction; in general display order is not re-runnable.
    println bidi.Reorder("سلام", bidi.DirAuto) == str.Reverse("سلام")
    println bidi.Reorder("abc", bidi.DirAuto) == "abc"

    // L1: trailing whitespace returns to the paragraph level.
    println levels_of("سلام  ", bidi.DirRTL)

    // An isolate keeps the direction of its contents from leaking out. U+2067
    // is RLI and U+2069 is PDI.
    println levels_of("abc ⁧سلام⁩ def", bidi.DirLTR)
end
