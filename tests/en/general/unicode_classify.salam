import unicode

func main:
    println unicode.Version

    // Persian and Arabic letters classify as letters. This is the case that
    // the old ASCII-only table got wrong.
    println unicode.IsAlphabetic(0x0633), unicode.IsLetter(0x0633)
    println unicode.CategoryName(0x0633), unicode.CategoryName(0x0041)

    // Harakat are marks, but Alphabetic still covers them.
    println unicode.CategoryName(0x064B), unicode.IsMark(0x064B), unicode.IsAlphabetic(0x064B)

    // Caseless scripts have no upper or lower case.
    println unicode.IsUpper(0x0633), unicode.IsLower(0x0633)

    // Digits in all three scripts Salam cares about.
    println unicode.IsDigit(0x0037), unicode.IsDigit(0x0667), unicode.IsDigit(0x06F7)

    // Arabic punctuation.
    println unicode.IsPunct(0x060C), unicode.IsPunct(0x061F), unicode.IsPunct(0x061B)

    // White_Space is the Unicode property, not the ASCII four.
    println unicode.IsSpace(0x0020), unicode.IsSpace(0x00A0), unicode.IsSpace(0x202F)
    println unicode.IsSpace(0x3000), unicode.IsSpace(0x000B)

    // ZWNJ holds Persian words together. It is a format character, not a
    // space, and classifying it as one would split words at the joint.
    println unicode.IsSpace(unicode.ZWNJ), unicode.IsFormat(unicode.ZWNJ)
    println unicode.IsJoinControl(unicode.ZWNJ), unicode.IsJoinControl(unicode.ZWJ)
    println unicode.IsJoinControl(0x0020)

    // Case mapping beyond ASCII.
    println unicode.ToUpper(0x00E9), unicode.ToLower(0x00C9)
    println unicode.ToUpper(0x03C3), unicode.ToLower(0x0410)

    // Folding unifies the two lowercase sigmas with the capital; lowercasing
    // does not.
    println unicode.ToFold(0x03A3), unicode.ToFold(0x03C2), unicode.ToFold(0x03C3)
    println unicode.ToLower(0x03A3) == unicode.ToLower(0x03C2)

    // Folds that grow.
    println unicode.HasFullFold(0x00DF), unicode.FullFoldLen(0x00DF)
    println unicode.FullFoldAt(0x00DF, 0), unicode.FullFoldAt(0x00DF, 1)
    println unicode.HasFullFold(0x0041), unicode.FullFoldLen(0x0041)

    // Unassigned and out-of-range code points answer safely.
    println unicode.IsAssigned(0x0633), unicode.IsAssigned(0x0378)
    println unicode.CategoryName(0x110000), unicode.IsAlphabetic(-1)
end
