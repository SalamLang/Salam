import str
import unicode

// Builds a string from explicit code points, so that tests which depend on the
// ORDER of combining marks say what that order is instead of relying on how an
// editor happened to store the file.
func cps(a: int, b: int, c: int): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendCp(sb, a)
    if b > 0: str.BufAppendCp(sb, b) end
    if c > 0: str.BufAppendCp(sb, c) end
    ret str.BufStr(sb)
end

func main:
    // Composed and decomposed spellings of the same text.
    e_acute := "é"
    println str.CharCount(e_acute), str.CharCount(str.NFD(e_acute))
    println str.NFC(str.NFD(e_acute)) == e_acute
    println str.NFD(e_acute) == e_acute
    println str.IsNFC(e_acute), str.IsNFC(str.NFD(e_acute))

    // A combining mark is its own code point but not its own character.
    println str.GraphemeCount(e_acute), str.GraphemeCount(str.NFD(e_acute))

    // Arabic harakat ride on their letter: 5 code points, 4 characters.
    salam := "سَلام"
    println str.CharCount(salam), str.GraphemeCount(salam)

    // Marks typed in either order normalize to the same sequence. Shadda has
    // combining class 33 and fatha 30, so canonical ordering puts the fatha
    // first however the author typed them.
    println unicode.CombiningClass(0x064E), unicode.CombiningClass(0x0651)
    fatha_first := cps(0x0628, 0x064E, 0x0651)
    shadda_first := cps(0x0628, 0x0651, 0x064E)
    println fatha_first == shadda_first
    println str.NFC(fatha_first) == str.NFC(shadda_first)
    println str.NFC(shadda_first) == fatha_first

    // Arabic presentation forms are folded away only by the compatibility
    // forms - this is what NFKC is for when text arrives out of a PDF.
    lam_alef := "ﻻ"
    println str.CharCount(lam_alef), str.CharCount(str.NFKC(lam_alef))
    println str.NFKC(lam_alef) == "لا"
    println str.NFC(lam_alef) == lam_alef

    // NFKC also collapses ligatures and width variants.
    println str.NFKC("ﬁ"), str.NFKC("ＡＢ")

    // Hangul composes and decomposes by arithmetic rather than by table.
    println str.CharCount(str.NFD("각")), str.NFC(str.NFD("각")) == "각"

    // Reversing by code point detaches marks from their base; reversing by
    // grapheme cluster does not.
    println str.Reverse(salam) == str.ReverseGraphemes(salam)
    println str.ReverseGraphemes(str.ReverseGraphemes(salam)) == salam

    // Clusters, and the code point count of each.
    g := str.Graphemes(salam)
    defer g.free()
    println g.len()
    repeat g.len() with i: println str.CharCount(g.get(i)) end

    // A flag is two regional indicators and one character; four are two.
    println str.GraphemeCount("🇮🇷"), str.CharCount("🇮🇷")
    println str.GraphemeCount("🇮🇷🇩🇪")

    // An emoji ZWJ sequence is one character.
    println str.GraphemeCount("👨‍👩‍👦"), str.CharCount("👨‍👩‍👦")

    // CR LF is one cluster but two code points.
    println str.GraphemeCount("\r\n"), str.CharCount("\r\n")

    // A Devanagari conjunct spans its virama.
    println str.GraphemeCount("क्त"), str.CharCount("क्त")
end
