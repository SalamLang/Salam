import str

func first_neg(xs: int[]): int:
    repeat 6 in i:
        if xs[i] < 0:
            ret i
        end
    end
    ret 0 - 1
end

func sum_until_big(xs: int[]): int:
    mut s := 0
    repeat 5 in i:
        if xs[i] > 100:
            break
        end
        s += xs[i] * (i + 1)
    end
    ret s
end

func class_of(c: int): int:
    if (c >= 97 and c <= 122) or (c >= 65 and c <= 90):
        ret 1
    end
    if c >= 48 and c <= 57:
        ret 2
    end
    ret 0
end

func main:
    a := [3, 5, 0 - 2, 7, 0 - 9, 1]
    b := [1, 2, 3, 4, 5, 6]
    println first_neg(a), first_neg(b)
    println sum_until_big([1, 2, 300, 4, 5] as int[]), sum_until_big([1, 2, 3, 4, 5] as int[])
    l := "  %t = call ptr @f(ptr %a), !dbg !12"
    println str.IndexFrom(l, ", !dbg !", 0), str.IndexFrom(l, " @", 5), str.IndexFrom(l, "zz", 0)
    mut cs := 0
    each ch in [97, 122, 123, 65, 90, 91, 48, 57, 58, 47, 64, 96] as int[]:
        cs = cs * 3 + class_of(ch)
    end
    println cs
end
