struct Box:
    pub label: str
    pub value: i32 or str or bool
end

func describe(v: i32 or str or bool): str:
    ret match v:
        i32 n: "int:" + n end
        str s: "str:" + s end
        bool b: "bool:" + b end
    end
end

func main:
    mut x := 42 as (i32 or str or bool)
    println describe(x)
    x = "hello"
    println describe(x)
    x = true
    println describe(x)

    b := Box { label = "a", value = 7 }
    println b.label + ":" + describe(b.value)
end
