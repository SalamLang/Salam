struct Slot:
    pub v: Variant<i32, str> = 7 as Variant<i32, str>
    pub next: Variant<i32, Slot*> = 0 as Variant<i32, Slot*>
end

func show(v: Variant<i32, str>): str:
    ret match v:
        i32 n => "int " + n
        str t => "str " + t
    end
end

func pick(flag: bool): Variant<i32, str>:
    if flag: ret 1 as Variant<i32, str> end
    ret "two" as Variant<i32, str>
end

func main:
    s := Slot {}
    println show(s.v), show(3 as Variant<i32, str>), show("x" as Variant<i32, str>)
    println show(pick(true)), show(pick(false))
end
