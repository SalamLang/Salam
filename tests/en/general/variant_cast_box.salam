struct Slot:
    pub v: i32 or str = 7 as (i32 or str)
    pub next: i32 or Slot* = 0 as (i32 or Slot*)
end

func show(v: i32 or str): str:
    ret match v:
        i32 n: "int " + n end
        str t: "str " + t end
    end
end

func pick(flag: bool): i32 or str:
    if flag: ret 1 as (i32 or str) end
    ret "two" as (i32 or str)
end

func main:
    s := Slot {}
    println show(s.v), show(3 as (i32 or str)), show("x" as (i32 or str))
    println show(pick(true)), show(pick(false))
end
