func main:
    mut v := Vector {} as Vector<int> defer v.Free()
    mut i := 0
    until i < 5:
        v.push(i * 10)
        i++
    end
    println v.Len()
    println v.cap()
    mut sum := 0
    i = 0
    until i < v.Len():
        sum += v.get(i)
        i++
    end
    println sum
    v.resize_set(10, 999)
    println v.Len()
    println v.get(10)
    println v.pop()
    println v.Len()
end
