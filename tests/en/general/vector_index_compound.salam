struct Cell:
    pub n: int = 0
end

func main():
    mut cnt := Vector {} as Vector<int>
    repeat 4:
        cnt.push(0)
    end
    b := 2
    cnt[b + 1] += 5
    cnt[b] -= 2
    cnt[1] += 3
    cnt[1] *= 4
    cnt[0] += cnt[1]
    println cnt[0], cnt[1], cnt[2], cnt[3]
    mut f := Vector {} as Vector<f64>
    f.push(1.5)
    f[0] += 2.0
    f[0] **= 2.0
    println f[0]
    mut cells := Vector {} as Vector<Cell>
    cells.push(Cell {})
    cells[0].n += 7
    println cells[0].n
end
