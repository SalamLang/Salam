import mem

struct Range:
    pub lo: int = 0
    pub hi: int = 0
end

func make range(lo: int, hi: int): Range*:
    p := mem.Allocate(sizeof(Range) as u64) as Range*
    p[0] = Range{lo = lo, hi = hi}
    ret p
end

func width(rs: Vector<Range*>): int:
    mut total := 0
    each r in rs:
        total += r[0].hi - r[0].lo
    end
    ret total
end

func main:
    mut rs := Vector {} as Vector<Range*>
    rs.push(make range(1, 4))
    rs.push(make range(10, 20))
    rs.get(0)[0].hi = 5
    println rs.Len(), width(rs), rs.get(0)[0].hi
    each r in rs:
        mem.Free(r as void*)
    end
    rs.free()
end
