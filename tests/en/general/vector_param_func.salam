func total(xs: Vector<int>): int:
    mut sum := 0
    repeat xs.len() in i:
        sum += xs.get(i)
    end
    ret sum
end

func add_twice(xs &: Vector<int>, v: int):
    xs.push(v)
    xs.push(v)
end

func evens(n: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat n in i:
        if i % 2 == 0:
            out.push(i)
        end
    end
    ret out
end

func longest(words: Vector<str>): str:
    mut best := ""
    repeat words.len() in i:
        if words.get(i).len() > best.len():
            best = words.get(i)
        end
    end
    ret best
end

func main:
    mut xs := Vector {} as Vector<int>
    xs.push(4)
    add_twice(xs, 3)
    println "total:", total(xs), "len:", xs.len()
    ev := evens(7)
    println "evens:", ev.len(), total(ev)
    mut words := Vector {} as Vector<str>
    words.push("salam")
    words.push("hi")
    words.push("hello")
    println "longest:", longest(words)
end
