func main:
    mut names := Vector {} as Vector<str> defer names.Free()
    names.Push("ali")
    names.Push("sara")
    names.Push("reza")
    println names.Len()
    mut counts := HashMap {} as HashMap<str, int> mut i := 0
    until i < names.Len():
        nm := names.Get(i)
        counts.Put(nm, i + 1)
        i++
    end
    println counts.Get("sara")
    println names.Get(0)
    println names.Pop()
    println names.Len()
end
