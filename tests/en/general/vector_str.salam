func main:
    mut names := Vector {} as Vector<str> defer names.Free()
    names.push("ali")
    names.push("sara")
    names.push("reza")
    println names.Len()
    mut counts := HashMap {} as HashMap<str, int> mut i := 0
    until i < names.Len():
        nm := names.get(i)
        counts.put(nm, i + 1)
        i++
    end
    println counts.get("sara")
    println names.get(0)
    println names.pop()
    println names.Len()
end
