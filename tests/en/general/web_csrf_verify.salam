import net.http.session

func main:
    mut s := session.New()
    t := session.CSRFToken(s)
    if t.len() == 0:
        println "no token minted"
        ret
    end
    if session.CSRFVerify(s, t):
        println "correct accepted"
    else:
        println "correct REJECTED"
    end
    if session.CSRFVerify(s, "wrong-token-value"):
        println "wrong ACCEPTED"
    else:
        println "wrong rejected"
    end
    if session.CSRFVerify(s, ""):
        println "empty ACCEPTED"
    else:
        println "empty rejected"
    end
    fresh := session.New()
    if session.CSRFVerify(fresh, "anything"):
        println "unminted ACCEPTED"
    else:
        println "unminted rejected"
    end
end
