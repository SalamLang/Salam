import net.http
import net.router
import net.internal.rawsock
import str
import time

func home_h(ctx: i64):
    http.Ctx_html(ctx, "web-ok")
end

func json_h(ctx: i64):
    http.Ctx_json(ctx, "42")
end

func param_h(ctx: i64):
    id := http.Ctx_param(ctx, "id")
    http.Ctx_text(ctx, "id=" + id)
end

func run_web():
    mut r := router.NewRouter()
    router.Get(r, "/", funcptr(home_h))
    router.Get(r, "/json", funcptr(json_h))
    router.Get(r, "/item/:id", funcptr(param_h))
    s := http.NewServer(19204)
    http.Use(s, r)
    http.Run(s)
end

func get_resp(path: str): str:
    mut sock := rawsock.Connect("127.0.0.1", 19204)
    mut tries := 0
    until !rawsock.Ok(sock) && tries < 200:
        time.Sleep(10)
        sock = rawsock.Connect("127.0.0.1", 19204)
        tries = tries + 1
    end
    if !rawsock.Ok(sock):
        ret ""
    end
    rawsock.Send(sock, "GET " + path + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
    resp := rawsock.Recv(sock, 8192)
    rawsock.Close(sock)
    ret resp
end

func main:
    _t := spawn(run_web)
    r1 := get_resp("/")
    println str.Contains(r1, "web-ok")
    println str.Contains(r1, "text/html")
    r2 := get_resp("/json")
    println str.Contains(r2, "42")
    println str.Contains(r2, "application/json")
    r3 := get_resp("/item/99")
    println str.Contains(r3, "id=99")
    r4 := get_resp("/missing")
    println str.Contains(r4, "404")
end
