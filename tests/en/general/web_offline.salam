import net.http
import net.router

func h_dummy(_ctx: i64): ret end

func main:
    r0 := router.NewRouter()
    println r0.routes.len() == 0
    mut r := router.NewRouter()
    router.Get(r, "/", funcptr(h_dummy))
    router.Post(r, "/items", funcptr(h_dummy))
    println r.routes.len() == 2
    println r.has_static == false
    router.Static(r, "/static/", "./public")
    println r.has_static == true
    println r.static_prefix == "/static/"
    s := http.NewServer(8080)
    println s.port == 8080
    println s.hide_tokens == false
end
