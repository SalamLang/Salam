import net.http
import net.router
import net.internal.rawsock
import str
import time

func get_h(ctx: i64): http.Ctx_text(ctx, "GET-ok") end

func post_h(ctx: i64): http.Ctx_text(ctx, "POST-ok") end

func put_h(ctx: i64):
    http.Ctx_text(ctx, "PUT-ok id=" + http.Ctx_param(ctx, "id"))
end

func del_h(ctx: i64):
    http.Ctx_text(ctx, "DELETE-ok id=" + http.Ctx_param(ctx, "id"))
end

func run_web():
    mut r := router.NewRouter()
    router.Get(r, "/res", funcptr(get_h))
    router.Post(r, "/res", funcptr(post_h))
    router.Put(r, "/res/:id", funcptr(put_h))
    router.Delete(r, "/res/:id", funcptr(del_h))
    s := http.NewServer(19206)
    http.Use(s, r)
    http.Run(s)
end

func req(method: str, path: str): str:
    mut sock := rawsock.Connect("127.0.0.1", 19206)
    mut tries := 0
    until !rawsock.Ok(sock) && tries < 200:
        time.Sleep(10)
        sock = rawsock.Connect("127.0.0.1", 19206)
        tries = tries + 1
    end
    if !rawsock.Ok(sock):
        ret ""
    end
    rawsock.Send(sock, method + " " + path + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
    resp := rawsock.Recv(sock, 8192)
    rawsock.Close(sock)
    ret resp
end

func main:
    _t := spawn(run_web)

    println str.Contains(req("GET", "/res"), "GET-ok")
    println str.Contains(req("POST", "/res"), "POST-ok")

    println str.Contains(req("PUT", "/res/7"), "PUT-ok id=7")
    println str.Contains(req("DELETE", "/res/9"), "DELETE-ok id=9")

    println str.Contains(req("PUT", "/res"), "404")
    println str.Contains(req("GET", "/res/7"), "404")
end
