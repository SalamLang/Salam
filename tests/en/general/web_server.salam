import net.http
import net.router
import net.http.validate
import net.http.middleware
import net.internal.rawsock
import str
import time

func echo_h(ctx: i64):
    body := http.Ctx_body(ctx)
    http.Ctx_text(ctx, "got:" + body)
end

func query_h(ctx: i64):
    name := http.Ctx_query(ctx, "name")
    http.Ctx_text(ctx, "hi " + name)
end

func secure_h(ctx: i64):
    middleware.Secure(ctx)
    http.Ctx_text(ctx, "secure")
end

func redirect_h(ctx: i64):
    http.Ctx_redirect(ctx, "/dest")
end

func signup_h(ctx: i64):
    email := http.Ctx_form(ctx, "email")
    if validate.IsEmail(email):
        http.Ctx_text(ctx, "email-ok")
    else:
        http.Ctx_status(ctx, 400)
        http.Ctx_text(ctx, "bad-email")
    end
end

func created_h(ctx: i64):
    http.Ctx_status(ctx, 201)
    http.Ctx_json(ctx, `{"ok":true}`)
end

func run_web():
    mut r := router.NewRouter()
    router.Post(r, "/echo", funcptr(echo_h))
    router.Get(r, "/q", funcptr(query_h))
    router.Get(r, "/sec", funcptr(secure_h))
    router.Get(r, "/go", funcptr(redirect_h))
    router.Post(r, "/signup", funcptr(signup_h))
    router.Get(r, "/create", funcptr(created_h))
    s := http.NewServer(19205)
    http.Use(s, r)
    http.Run(s)
end

func send_raw(req: str): str:
    mut sock := rawsock.Connect("127.0.0.1", 19205)
    mut tries := 0
    until !rawsock.Ok(sock) && tries < 200:
        time.Sleep(10)
        sock = rawsock.Connect("127.0.0.1", 19205)
        tries = tries + 1
    end
    if !rawsock.Ok(sock):
        ret ""
    end
    rawsock.Send(sock, req)
    resp := rawsock.Recv(sock, 8192)
    rawsock.Close(sock)
    ret resp
end

func post(path: str, body: str): str:
    req := "POST " + path + " HTTP/1.0\r\nHost: localhost\r\nContent-Length: " + str.FromInt(len(body) as i64) + "\r\n\r\n" + body
    ret send_raw(req)
end

func get(path: str): str:
    ret send_raw("GET " + path + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
end

func main:
    _t := spawn(run_web)

    r1 := post("/echo", "hello")
    println str.Contains(r1, "got:hello")

    r2 := get("/q?name=Sara")
    println str.Contains(r2, "hi Sara")

    r3 := get("/sec")
    println str.Contains(r3, "X-Frame-Options: DENY")
    println str.Contains(r3, "secure")

    r4 := get("/go")
    println str.Contains(r4, "302")
    println str.Contains(r4, "Location: /dest")

    r5 := post("/signup", "email=a@b.com")
    println str.Contains(r5, "email-ok")
    r6 := post("/signup", "email=nope")
    println str.Contains(r6, "400")
    println str.Contains(r6, "bad-email")

    r7 := get("/create")
    println str.Contains(r7, "201")
    println str.Contains(r7, "application/json")
end
