func main:
    a := 3
    if a lt 4:
        println "lt"
    end
    if a gt 2:
        println "gt"
    end
    if a lte 3 and a gte 3:
        println "lte gte"
    end
    println a lt 3, a gt 3, a lte 2, a gte 4
    println 1 + 2 gte 3, 2 * 2 lt 3 + 2
    mut i := 0
    until i lt 3:
        i += 1
    end
    println i
    if (a < 4) and (a >= 3):
        println "symbols"
    end
end
