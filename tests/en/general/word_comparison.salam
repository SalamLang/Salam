func main:
    a := 3
    if a < 4:
        println "lt"
    end
    if a > 2:
        println "gt"
    end
    if a <= 3 and a >= 3:
        println "lte gte"
    end
    println a < 3, a > 3, a <= 2, a >= 4
    println 1 + 2 >= 3, 2 * 2 < 3 + 2
    mut i := 0
    until i < 3:
        i++
    end
    println i
    if (a < 4) and (a >= 3):
        println "symbols"
    end
end
