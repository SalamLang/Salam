func main:
    a := 3
    if a eq 3:
        println "eq"
    end
    if a neq 4:
        println "neq"
    end
    if a eq 4 or a neq 3:
        println "no"
    else:
        println "yes"
    end
    println (a eq 3) and (a neq 5)
    name := "salam"
    println name eq "salam", name neq "salam"
    println 1 + 2 eq 3, not true eq false
    if (a == 3) and (a != 4):
        println "symbols"
    end
end
