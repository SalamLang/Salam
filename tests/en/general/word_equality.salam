func main:
    a := 3
    if a == 3:
        println "eq"
    end
    if a != 4:
        println "neq"
    end
    if a == 4 or a != 3:
        println "no"
    else:
        println "yes"
    end
    println (a == 3) and (a != 5)
    name := "salam"
    println name == "salam", name != "salam"
    println 1 + 2 == 3, not true == false
    if (a == 3) and (a != 4):
        println "symbols"
    end
end
