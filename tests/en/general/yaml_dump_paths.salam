import encoding.yaml

func main:
    doc := "name: Salam\nversion: 6\ntags:\n  - fast\n  - \"quoted \\\"x\\\"\"\n  - 3.5\nowner:\n  login: max\n  roles:\n    - admin\n    - dev\n  meta: {a: 1, b: [x, y]}\nempty: []\nnone: null\nflag: true\n"
    println yaml.Dump(doc)
    println yaml.DumpTabs(doc)
    println yaml.ToJSON(doc)
    println yaml.Get(doc, "owner.roles.1"), yaml.Get(doc, "tags.1"), yaml.GetInt(doc, "version"), yaml.GetBool(doc, "flag")
    println yaml.Keys(doc, "owner").len(), yaml.Len(doc, "tags"), yaml.TypeOf(doc, "owner.meta"), yaml.Has(doc, "owner.meta.b"), yaml.Valid(doc)
end
