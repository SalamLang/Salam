extern:
    func printf(format: str, ...): int
    func getenv(name: str): str
    func strlen(s: str): u64
end

if SALAM_OS_WINDOWS:
    extern:
        func _putenv_s(name: str, value: str): int
    end
else:
    extern:
        func setenv(name: str, value: str, overwrite: int): int
    end
end

func main:
    if SALAM_OS_WINDOWS:
        _putenv_s("SALAM_FFI_ENV_TEST", "hello_salam_ffi_env_test")
    else:
        setenv("SALAM_FFI_ENV_TEST", "hello_salam_ffi_env_test", 1)
    end
    path := getenv("SALAM_FFI_ENV_TEST")
    printf("PATH is %d bytes long\n", strlen(path))
end
