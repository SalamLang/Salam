extern:
    func printf(format: str, ...): int
    func getenv(name: str): str
    func strlen(s: str): u64
end

func main:
    if SALAM_OS_WINDOWS:
        mut user := getenv("USERNAME")
    else:
        mut user := getenv("USER")
    end
    if (user as void*) == null:
        user = "unknown"
    end
    // `as int` because strlen resolves to the real <string.h> one and hands
    // printf a size_t, which `%d` does not match - fatal under the suite's
    // SALAM_C_STRICT=1 (-Werror) on a gcc with -Wformat on by default.
    printf("Hello! Your username variable is %d bytes.\n", strlen(user) as int)
    printf("Pi is about %.2f and 7 * 6 = %d\n", 3.14159, 7 * 6)
end
