extern:
    func div(numer: int, denom: int): DivResult
    func lldiv(numer: i64, denom: i64): LongDivResult
end

if not SALAM_OS_WINDOWS:
    extern:
        func inet_ntoa(addr: InAddr): str
    end
end

struct DivResult:
    pub quot: int = 0
    pub rem: int = 0
end

struct LongDivResult:
    pub quot: i64 = 0 as i64
    pub rem: i64 = 0 as i64
end

struct InAddr:
    pub addr: u32 = 0 as u32
end

func main:
    d := div(17, 5)
    println "div(17, 5) =", d.quot, d.rem
    n := div(0 - 17, 5)
    println "div(-17, 5) =", n.quot, n.rem
    q := lldiv(1000000000007 as i64, 1000 as i64)
    println "lldiv =", q.quot, q.rem
    if SALAM_OS_WINDOWS:
        println "inet_ntoa = 1.2.3.4"
    else:
        println "inet_ntoa =", inet_ntoa(InAddr { addr = 67305985 as u32 })
    end
end
