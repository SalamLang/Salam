package main

import db.redis

func main:
    c := redis.Connect("127.0.0.1", 6379)
    if redis.Ok(c):
        println "connected to redis, ping:", redis.Ping(c)

        redis.Set(c, "salam:example:en:greeting", "hello from Salam")
        println redis.Get(c, "salam:example:en:greeting")

        redis.Del(c, "salam:example:en:visits")
        redis.Incr(c, "salam:example:en:visits")
        redis.Incr(c, "salam:example:en:visits")
        n := redis.Incr(c, "salam:example:en:visits")
        println "visits:", n

        redis.Del(c, "salam:example:en:fruits")
        redis.RPush(c, "salam:example:en:fruits", "apple")
        redis.RPush(c, "salam:example:en:fruits", "banana")
        redis.RPush(c, "salam:example:en:fruits", "cherry")
        fruits := redis.LRange(c, "salam:example:en:fruits", 0, -1)
        println "fruits:"
        repeat fruits.len() with i:
            println "  -", fruits.get(i)[0]
        end

        redis.Del(c, "salam:example:en:greeting")
        redis.Del(c, "salam:example:en:visits")
        redis.Del(c, "salam:example:en:fruits")
        redis.Close(c)
    else:
        println "could not connect to redis:", redis.Error(c)
    end
end
