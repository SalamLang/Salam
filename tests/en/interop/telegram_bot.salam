package main

import telegram.bot
import encoding.json
import os

func handle(b: bot.Bot, u: bot.Update):
    if !u.has_message:
        ret
    end

    chat_id := u.message.chat.id
    text := u.message.text
    println "update", u.update_id, "from chat", chat_id, ":", text

    if text == "/start":
        bot.SendMessage(b, chat_id, "Hi! Salam bot is up.")
    else text == "/help":
        bot.SendMessage(b, chat_id, "Commands:\n/start\n/help")
    else:
        bot.SendMessage(b, chat_id, "You said:\n" + text)
    end
end

func main:
    token := os.Env("TELEGRAM_BOT_TOKEN")
    if token.len() == 0:
        printerr "TELEGRAM_BOT_TOKEN is not set."
        ret
    end

    b := bot.NewBot(token)

    me := bot.GetMe(b)
    if !me.ok:
        printerr "Could not connect to Telegram:", me.description
        ret
    end
    who := bot.ParseUser(me.result)
    println "Connected as @" + who.username, "(id", who.id, ")"

    wh := bot.GetWebhookInfo(b)
    if wh.ok && json.Get(wh.result, "url").len() > 0:
        println "A webhook is set (" + json.Get(wh.result, "url") + "); clearing it so polling can work."
        bot.DeleteWebhook(b)
    end

    println "Polling for updates. Send /start to the bot now."
    bot.Poll(b, 30, (u: bot.Update): handle(b, u) end)
end
