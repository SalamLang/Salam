package main

import telegram.bot

func main:
    chat := bot.ParseChat(`{"id":-100123,"type":"supergroup","title":"Salam Dev","username":"salam_dev"}`)
    println chat.id
    println chat.chat_type
    println chat.title
    println chat.username
    println bot.ParseChat("").id

    msg := bot.ParseMessage(`{"message_id":7,"date":1700000001,"chat":{"id":55,"type":"private","first_name":"Sara","last_name":"K"},"from":{"id":55,"is_bot":false,"first_name":"Sara","language_code":"fa"},"text":"/ping now","reply_to_message":{"message_id":3,"from":{"id":9,"first_name":"Bot"}}}`)
    println msg.message_id
    println msg.date
    println msg.chat.first_name
    println msg.chat.last_name
    println msg.from_user.language_code
    println msg.text
    println msg.reply_to.message_id
    println msg.reply_to.user_id
    println msg.reply_to.user_name

    cq := bot.ParseCallbackQuery(`{"id":"cb1","from":{"id":55,"first_name":"Sara"},"message":{"message_id":8,"chat":{"id":55,"type":"private"}},"data":"yes"}`)
    println cq.id
    println cq.from_user.id
    println cq.has_message
    println cq.message.message_id
    println cq.data
    println bot.ParseCallbackQuery(`{"id":"cb2","data":"no"}`).has_message

    iq := bot.ParseInlineQuery(`{"id":"iq1","from":{"id":77,"first_name":"Omid"},"query":"salam","offset":"10"}`)
    println iq.id
    println iq.from_user.first_name
    println iq.query
    println iq.offset

    raw := `[{"update_id":1,"message":{"message_id":1,"chat":{"id":5,"type":"private"},"text":"a, b"}},{"update_id":2,"callback_query":{"id":"c","data":"d"}},{"update_id":3,"inline_query":{"id":"q","query":"x"}}]`
    updates := bot.ParseUpdates(raw)
    println updates.Len()
    println updates.Get(0).update_id
    println updates.Get(0).message.text
    println updates.Get(1).has_callback_query
    println updates.Get(1).callback_query.data
    println updates.Get(2).has_inline_query
    println updates.Get(2).inline_query.query
    println bot.ParseUpdates("[]").Len()

    b := bot.NewBot("123:ABC")
    println bot.FileURL(b, "photos/file_1.jpg")

    println bot.KeyboardButton("Yes")
    mut row := Vector {} as Vector<str>
    row.Push(bot.KeyboardButton("Yes"))
    row.Push(bot.KeyboardButton("No"))
    mut rows := Vector {} as Vector<str>
    rows.Push(bot.Row(row))
    println bot.ReplyKeyboardMarkup(rows)
    println bot.RemoveKeyboard()
    println bot.ForceReply()

    println bot.ReplyChatAction(55, "typing")
    println bot.ReplyEditMessageText(55, 8, "edited", "")
    markup := bot.InlineKeyboardMarkup(rows)
    println bot.ReplyEditMessageText(55, 8, "edited", markup)
end
