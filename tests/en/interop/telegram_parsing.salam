package main

import telegram.bot

func main:
    raw := `{"update_id":123456789,"message":{"message_id":42,"date":1700000000,"chat":{"id":987654321,"type":"private","first_name":"Ali"},"from":{"id":987654321,"is_bot":false,"first_name":"Ali","username":"ali_dev"},"text":"/start hello"}}`

    u := bot.ParseUpdate(raw)
    println "update_id:", u.update_id
    println "has_message:", u.has_message
    println "chat_id:", u.message.chat.id
    println "from:", u.message.from_user.username
    println "text:", u.message.text
    println "is_command:", bot.IsCommand(u.message.text)
    println "command:", bot.CommandName(u.message.text)
    println "args:", bot.CommandArgs(u.message.text)
end
