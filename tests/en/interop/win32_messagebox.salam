if SALAM_OS_WINDOWS:
    import text
    import mem

    link "user32"

    extern:
        // MessageBoxTimeoutW is an undocumented but stably-exported user32
        // export (present since Windows 2000) that behaves exactly like
        // MessageBoxW but auto-dismisses after dwMilliseconds. Plain
        // MessageBoxW would hang this test forever on CI runners, which run
        // with no interactive desktop session to click "OK" - this keeps
        // the test exercising the real FFI/ABI path without ever blocking.
        func MessageBoxTimeoutW(handle: void*, msg: u16*, caption: u16*, style: int, lang_id: u16, timeout_ms: u32): int
    end

    func show(caption: str, msg: str):
        cap := text.ToUtf16(caption)
        body := text.ToUtf16(msg)
        MessageBoxTimeoutW(null, body as u16*, cap as u16*, 0, 0 as u16, 3000 as u32)
        mem.Free(cap)
        mem.Free(body)
    end

    func main:
        show("Γειά σου Κόσμε!", "Hello, world!\n你好世界！\nПривет, мир!\n👋🌎!")
        println "MessageBoxW FFI test complete."
    end
else:
    func main:
        println "MessageBoxW FFI test complete."
    end
end
