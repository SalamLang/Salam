package samenamea

include u "_samename_u.salam"

const LIMIT := 5

pub enum Color:
    Red
    Green
end

pub struct Item:
    pub n: int = 1

    pub func show(): str:
        ret "pkg item " + this.n
    end
end

pub struct Holder<T>:
    pub v: T
    pub it: Item = Item { n = 4 }

    pub func describe(): str:
        ret this.it.show()
    end
end

func inner<T>(_x: T): str:
    ret "pkg inner"
end

pub func Name(c: Color): str:
    if c == Color.Green:
        ret "pkg green"
    end
    ret "pkg red"
end

pub func Make<T>(x: T): str:
    it := Item { n = 2 }
    c := Color.Green
    ret it.show() + " " + LIMIT + " " + u.Tag() + " " + Name(c) + " " + inner(x)
end

pub func Wrap<T>(_x: T, i: Item): Item:
    ret Item { n = i.n + 10 }
end
