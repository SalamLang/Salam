// Short-circuit evaluation in the JS backend: which operand runs, in
// what order, and the fact that & | ^ always evaluate both sides. Each
// operand announces itself on its own line, so the lines before the
// "= <result>" line are exactly the operands that were evaluated.

func note(tag: str, v: bool): bool:
    println "  eval", tag
    ret v
end

func mark(tag: str, v: int): int:
    println "  eval", tag
    ret v
end

func bxor(a: bool, b: bool): bool:
    ret (a || b) && !(a && b)
end

func implies(a: bool, b: bool): bool:
    ret !a || b
end

func main:
    println "F && T"
    r1 := note("a", false) && note("b", true)
    println "  =", r1

    println "T && F"
    r2 := note("a", true) && note("b", false)
    println "  =", r2

    println "T || F"
    r3 := note("a", true) || note("b", false)
    println "  =", r3

    println "F || T"
    r4 := note("a", false) || note("b", true)
    println "  =", r4

    println "T && T && F && T"
    r5 := note("a", true) && note("b", true) && note("c", false) && note("d", true)
    println "  =", r5

    println "F || F || T || T"
    r6 := note("a", false) || note("b", false) || note("c", true) || note("d", true)
    println "  =", r6

    // && binds tighter than ||, so this is (F && b) || c and b is skipped
    println "F && T || F"
    r7 := note("a", false) && note("b", true) || note("c", false)
    println "  =", r7

    // a guarded division is never evaluated
    d := 0
    if d != 0 && 10 / d > 0:
        println "unreachable"
    end
    println "guard held"

    // truth tables and De Morgan
    println true && true, true && false, false && true, false && false
    println true || true, true || false, false || true, false || false
    println !true, !false, !!true
    println !(true && false) == (!true || !false)
    println !(true || false) == (!true && !false)
    println bxor(true, false), bxor(true, true), bxor(false, false)
    println implies(true, false), implies(false, true), implies(true, true)

    // the bit operators are not short-circuiting: both sides always run
    println "1 | 0"
    b1 := (mark("p", 1) | mark("q", 0)) != 0
    println "  =", b1

    println "0 & 1"
    b2 := (mark("p", 0) & mark("q", 1)) != 0
    println "  =", b2

    // mask tests need their own parentheses, since == binds tighter
    // than & ^ |
    println ((5 & 4) != 0) && ((5 & 1) != 0)
    println ((5 & 4) != 0) || ((5 & 2) != 0)
    println (0 | 0) == 0 || (1 & 1) == 1

    // short-circuiting in a loop condition
    mut i := 0
    mut steps := 0
    until i < 5 && steps < 3:
        steps = steps + 1
        i = i + 1
    end
    println i, steps
end
