// The JS backend has to produce the same signed 32-bit results as the
// native backends for & | ^ ~ << >> and their compound forms.

func band(a: int, b: int): int:
    ret a & b
end

func shl(x: int, n: int): int:
    ret x << n
end

func sar(x: int, n: int): int:
    ret x >> n
end

func popcount(x: int): int:
    mut v := x
    mut n := 0
    until v != 0:
        v = v & (v - 1)
        n = n + 1
    end
    ret n
end

func main:
    // truth tables
    println 0 & 0, 0 & 1, 1 & 0, 1 & 1
    println 0 | 0, 0 | 1, 1 | 0, 1 | 1
    println 0 ^ 0, 0 ^ 1, 1 ^ 0, 1 ^ 1
    println ~0, ~1, ~127, ~(-1)

    a := 0b1100
    b := 0b1010
    println a & b, a | b, a ^ b
    println a & ~b, ~a & b
    println band(a, b), band(-12, 255)

    // identities and De Morgan
    x := 0x5A5A
    println x & 0, x & (-1), x | 0, x | (-1), x ^ 0, x ^ x
    println ~(a & b) == (~a | ~b), ~(a | b) == (~a & ~b)
    println (x ^ (-1)) == ~x

    // shifts
    mut line := ""
    repeat 16 with i:
        line = line + (1 << i) + " "
    end
    println line
    println 3 << 4, 1024 >> 4, -16 >> 2, -1 >> 20
    println shl(1, 30), sar(1073741824, 30)
    println (12345 << 8) >> 8

    // precedence
    println 1 << 4 + 1, (1 << 4) + 1
    println 1 | 2 & 3, 12 ^ 10 & 6
    println 1 << 2 | 1, 3 & 1 << 2
    println 1 << 3 > 4, 16 >> 2 == 4
    println ~3 & 15, ~(3 & 15)

    // compound assignment
    mut f := 0
    f |= 5
    f &= 6
    f ^= 1
    f <<= 2
    f >>= 1
    println f
    mut m := 0xFF
    m &= ~0x0F
    println m
    mut s := 1
    s <<= 10
    println s
    s >>= 3
    println s

    // masks and flags
    mut flags := 0
    flags |= 1 << 0
    flags |= 1 << 3
    flags |= 1 << 6
    println flags, (flags & (1 << 3)) != 0, (flags & (1 << 4)) != 0
    flags &= ~(1 << 3)
    println flags
    println popcount(0), popcount(255), popcount(flags), popcount(-1)

    // xor swap and round-trip
    mut p := 0x1234
    mut q := 0xABCD
    p ^= q
    q ^= p
    p ^= q
    println p, q
    println ((0x42 ^ 0x5A) ^ 0x5A) == 0x42

    // add via xor and carry
    println (1234 ^ 5678) + ((1234 & 5678) * 2) == 1234 + 5678
end
