func main:
    two := 2
    big := 256 as i64
    half := 0.5
    tiny := 0.25 as f32
    zero := 0.0
    negzero := -0.0 as f32
    println two as bool, big as bool, half as bool, tiny as bool
    println zero as bool, negzero as bool, 0 as bool, (two - 2) as bool
    println (big - 255) as bool, (two * 128) as u8 as bool
end
