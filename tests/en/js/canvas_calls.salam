import dom
import web.canvas

func main:
    el := dom.Create("canvas")
    dom.SetAttr(el, "id", "board")
    dom.SetAttr(el, "width", "320")
    dom.SetAttr(el, "height", "200")
    dom.Append(dom.Body(), el)
    c := canvas.Get("board")
    println canvas.Width(c), canvas.Height(c)

    canvas.FillStyle(c, "#f5f0e6")
    println dom.GetStr(c, "fillStyle")
    canvas.StrokeStyle(c, "#333")
    println dom.GetStr(c, "strokeStyle")
    canvas.LineWidth(c, 2.5)
    println dom.GetNum(c, "lineWidth")
    canvas.Font(c, "16px Inter")
    println dom.GetStr(c, "font")
    canvas.TextAlign(c, "center")
    println dom.GetStr(c, "textAlign")
    canvas.Alpha(c, 0.5)
    println dom.GetNum(c, "globalAlpha")

    canvas.FillRect(c, 0.0, 0.0, 10.0, 10.0)
    canvas.StrokeRect(c, 1.0, 1.0, 8.0, 8.0)
    canvas.ClearRect(c, 2.0, 2.0, 4.0, 4.0)
    canvas.RoundRect(c, 0.0, 0.0, 10.0, 10.0, 3.0)
    canvas.BeginPath(c)
    canvas.MoveTo(c, 0.0, 0.0)
    canvas.LineTo(c, 5.0, 5.0)
    canvas.Arc(c, 5.0, 5.0, 2.0, 0.0, 6.28)
    canvas.ClosePath(c)
    canvas.Fill(c)
    canvas.Stroke(c)
    canvas.FillText(c, "hi", 3.0, 3.0)
    canvas.Save(c)
    canvas.Translate(c, 1.0, 1.0)
    canvas.Rotate(c, 0.1)
    canvas.Scale(c, 2.0, 2.0)
    canvas.Restore(c)
    img := dom.LoadImage("logo.png")
    canvas.DrawImage(c, img, 0.0, 0.0, 4.0, 4.0)

    calls := dom.GetProp(c, "calls")
    each name in ["fillRect", "strokeRect", "clearRect", "roundRect", "beginPath", "moveTo", "lineTo", "arc", "closePath", "fill", "stroke", "fillText", "save", "translate", "rotate", "scale", "restore", "drawImage"]:
        println name, dom.GetNum(calls, name)
    end

    other := dom.Create("canvas")
    second := canvas.Of(other)
    println dom.GetNum(dom.GetProp(second, "canvas"), "width")
    println canvas.Height(second)
end
