func main:
    s := "a+b"
    c := s[1]
    println "" + c
    println "x" + c + "y"
    d := 'z'
    println "q" + d
    println c + "!"
    println s + c
    println c + s
    mut acc := "ab"
    acc += d
    println acc
    mut t := ""
    repeat 3 in i:
        t += s[i]
    end
    println t
end
