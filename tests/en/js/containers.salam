import str
import collections

func total(v: Vector<int>): int:
    mut t := 0
    repeat v.Len() in i:
        t += v.Get(i)
    end
    ret t
end

func main:
    mut v := Vector {} as Vector<int>
    v.Push(3)
    v.Push(7)
    v.Push(11)
    println v.Len()
    println v.Get(0)
    println v[2]
    v.Set(1, 70)
    v[2] = 110
    println v[1], v[2]
    println total(v)
    println collections.Contains(v, 70)
    println collections.IndexOf(v, 110)
    each x in v:
        print x
        print " "
    end
    println ""
    each i, x in v:
        println i, x
    end
    mut it := v.Iter()
    mut seen := 0
    until it.HasNext():
        seen += it.Value()
        it.Next()
    end
    println seen
    println v.Pop()
    println v.IsEmpty()

    parts := str.Split("a,b,c", ",")
    println parts.Len(), parts.Get(1)

    mut grid := Vector {} as Vector<Vector<int>>
    mut row := Vector {} as Vector<int>
    row.Push(5)
    grid.Push(row)
    println grid.Get(0).Get(0)

    mut m := HashMap {} as HashMap<str, int>
    m.Put("a", 1)
    m.Put("b", 2)
    println m.Size(), m.Get("a"), m.Has("b"), m.Has("zz")
    println m.GetOr("zz", 9)
    _r := m.Remove("a")
    println m.Size()
    mut mi := m.Iter()
    until mi.HasNext():
        println mi.Key(), mi.Value()
        mi.Next()
    end

    mut sb := str.NewBuilder()
    str.BufAppend(sb, "hi ")
    str.BufAppendInt(sb, 42)
    str.BufAppendChar(sb, 33)
    println str.BufStr(sb), str.BufLen(sb)
    str.BufReset(sb)
    println str.BufIsEmpty(sb)
    str.BufFree(sb)
end
