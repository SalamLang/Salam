// The prelude's containers over their JS representations: a Vector is an
// array here and a HashMap is a Map, so every method has to answer the way
// it does when compiled. A vector growing used to reach realloc and throw.
import str
import collections

func total(v: Vector<int>): int:
    mut t := 0
    repeat v.len() with i:
        t = t + v.get(i)
    end
    ret t
end

func main:
    mut v := Vector {} as Vector<int>
    v.push(3)
    v.push(7)
    v.push(11)
    println v.len()
    println v.get(0)
    println v[2]
    v.set(1, 70)
    v[2] = 110
    println v[1], v[2]
    println total(v)
    println collections.contains(v, 70)
    println collections.index_of(v, 110)
    each x in v:
        print x
        print " "
    end
    println ""
    each (i, x) in v:
        println i, x
    end
    mut it := v.iter()
    mut seen := 0
    until it.has_next():
        seen = seen + it.value()
        it.next()
    end
    println seen
    println v.pop()
    println v.is_empty()

    parts := str.Split("a,b,c", ",")
    println parts.len(), parts.get(1)

    mut grid := Vector {} as Vector<Vector<int>>
    mut row := Vector {} as Vector<int>
    row.push(5)
    grid.push(row)
    println grid.get(0).get(0)

    mut m := HashMap {} as HashMap<str, int>
    m.put("a", 1)
    m.put("b", 2)
    println m.size(), m.get("a"), m.has("b"), m.has("zz")
    println m.get_or("zz", 9)
    _r := m.remove("a")
    println m.size()
    mut mi := m.iter()
    until mi.has_next():
        println mi.key(), mi.value()
        mi.next()
    end

    mut sb := str.NewBuilder()
    str.BufAppend(sb, "hi ")
    str.BufAppendInt(sb, 42)
    str.BufAppendChar(sb, 33)
    println str.BufStr(sb), str.BufLen(sb)
    str.BufReset(sb)
    println str.BufIsEmpty(sb)
    str.BufFree(sb)
end
