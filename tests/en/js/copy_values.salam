struct Point:
    pub x: int = 0
    pub y: int = 0
end

struct Profile:
    pub name: str = ""
    pub scores: Vector<int> = Vector {}
    pub home: Point = Point {}
end

struct Team:
    pub title: str = ""
    pub lead: Profile = Profile {}
    pub members: Vector<Profile> = Vector {}
end

struct Counted:
    pub n: int = 0
    pub copies: int = 0

    pub func copy(): Counted:
        ret Counted { n = this.n, copies = this.copies + 1 }
    end

    pub func deep_copy(): Counted:
        ret Counted { n = this.n, copies = this.copies + 10 }
    end
end

struct Wrapper:
    pub c: Counted = Counted {}
    pub list: Vector<Counted> = Vector {}
end

struct Box<T>:
    pub items: Vector<T> = Vector {}
    pub label: str = ""
end

func main:
    p := Point { x = 1, y = 2 }
    p2 := p.Copy()
    p3 := p.DeepCopy()
    println p2.x, p2.y, p3.x + p3.y

    mut pr := Profile { name = "sara" }
    pr.scores.Push(10)
    shallow := pr.Copy()
    deep := pr.DeepCopy()
    pr.scores.Push(20)
    pr.scores.Set(0, 11)
    pr.home.x = 5
    println shallow.scores.Len(), shallow.scores.Get(0), shallow.home.x
    println deep.scores.Len(), deep.scores.Get(0), deep.name

    mut t := Team { title = "core" }
    t.lead.scores.Push(1)
    t.members.Push(pr)
    ts := t.Copy()
    td := t.DeepCopy()
    t.lead.scores.Set(0, 2)
    mut m0 := t.members.Get(0)
    m0.scores.Set(0, 99)
    t.members.Push(Profile {})
    println ts.lead.scores.Get(0), ts.members.Len(), ts.members.Get(0).scores.Get(0)
    println td.lead.scores.Get(0), td.members.Len(), td.members.Get(0).scores.Get(0)

    c := Counted { n = 7 }
    println c.Copy().copies, c.DeepCopy().copies
    mut w := Wrapper {}
    w.list.Push(Counted { n = 1 })
    ws := w.Copy()
    wd := w.DeepCopy()
    println ws.c.copies, ws.list.Get(0).copies, wd.c.copies, wd.list.Get(0).copies

    mut b := Box {} as Box<str>
    b.items.Push("a")
    b.label = "first"
    b2 := b.DeepCopy()
    b.items.Set(0, "z")
    b.items.Push("y")
    println b2.items.Len(), b2.items.Get(0), b2.label
end
