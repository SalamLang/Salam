import dom

mut ticks := 0
mut fired := 0
mut timer := 0 as i64

func main:
    println dom.GetNum(dom.Window(), "innerWidth")
    dom.Alert("hello")

    math := dom.Global("Math")
    println dom.Call0(dom.Global("Date"), "now") > 0
    println dom.Call1(math, "abs", 0.0 - 3.0)
    println dom.Call2(math, "max", 3.0, 9.0)
    println dom.Call3(math, "min", 5.0, 2.0, 8.0)
    println dom.Call4(math, "hypot", 3.0, 4.0, 0.0, 0.0)

    keep := ():
        fired++
        println "kept handler"
    end
    gone := ():
        println "removed handler ran"
    end
    tick := ():
        ticks++
        println "tick", ticks
        if ticks == 3:
            dom.ClearInterval(timer)
            println "interval cleared"
        end
    end

    box := dom.Create("div")
    dom.SetAttr(box, "id", "box")
    dom.Append(dom.Body(), box)
    dom.CallS2(box, "setAttribute", "title", "tip")
    println dom.GetAttr(box, "title")
    dom.SetProp(box, "badge", 42)
    println dom.GetNum(box, "badge")

    btn := dom.Create("button")
    dom.SetAttr(btn, "id", "btn")
    dom.SetAttr(btn, "data-autofire", "click")
    dom.Append(dom.Body(), btn)
    dom.OnEvent(btn, "click", keep)
    dom.OnEvent(btn, "click", gone)
    dom.OffEvent(btn, "click", gone)
    dom.OnEventE(
        btn, "click", (ev: i64): println "target:", dom.GetAttr(dom.EventTarget(ev), "id")
        dom.StopPropagation(ev) end
    )

    dom.OnReady(
        (): println "ready" end
    )
    dom.OnWindow(
        "resize", (): println "window resized" end
    )
    dom.OnWindowE(
        "resize", (ev: i64): println "window event:", dom.GetStr(ev, "type") end
    )
    dom.RequestFrame(
        (t: f64): println "frame", t end
    )

    img := dom.LoadImage("logo.png")
    println dom.ImageReady(img)
    dom.SetBool(img, "complete", true)
    dom.SetNum(img, "naturalWidth", 4.0)
    println dom.ImageReady(img)

    canvas := dom.Create("canvas")
    dom.SetAttr(canvas, "width", "64")
    dom.Append(dom.Body(), canvas)
    ctx := dom.GetContext(canvas, "2d")
    println dom.GetNum(dom.GetProp(ctx, "canvas"), "width")

    timer = dom.SetInterval(tick, 5)
    cancelled := dom.SetTimeout(
        (): println "cancelled timeout ran" end, 20
    )
    dom.ClearTimeout(cancelled)
    dom.SetTimeout(
        (): println "late timeout, clicks:", fired end, 200
    )
    println "main done"
end
