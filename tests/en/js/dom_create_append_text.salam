import dom

func main:
    box := dom.Create("div")
    dom.SetAttr(box, "id", "box")
    dom.SetText(box, "hello dom")
    dom.Append(dom.Body(), box)

    found := dom.ById("box")
    println dom.GetText(found)

    dom.SetHtml(found, "<b>bold</b>")
    println found != dom.Body()
end
