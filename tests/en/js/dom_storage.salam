import dom

func main:
    dom.StoreSetInt("count", 42)
    println dom.StoreGetInt("count")
    dom.StoreSetStr("name", "salam")
    println dom.StoreGetStr("name")
    println dom.StoreGetInt("missing")
    println dom.StoreGetStr("missing") == ""
end
