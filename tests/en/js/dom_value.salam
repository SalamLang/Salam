import dom

func main:
    inp := dom.Create("input")
    dom.Append(dom.Body(), inp)
    dom.SetValue(inp, "hello")
    println dom.GetValue(inp)
    dom.SetValue(inp, "world")
    println dom.GetValue(inp)
end
