// Three things the browser build renders itself rather than through the
// runtime the compiled backends use: dispatch on a `dyn` value, `print`
// with no newline after it, and how a double and a char read back.
interface Shape:
    func name(): str
    func area(): f64
end

struct Circle:
    pub r: f64 = 0.0
    pub func name(): str: ret "circle" end
    pub func area(): f64: ret 3.14159 * this.r * this.r end
end

struct Rect:
    pub w: f64 = 0.0
    pub h: f64 = 0.0
    pub func name(): str: ret "rect" end
    pub func area(): f64: ret this.w * this.h end
end

func describe(s: dyn Shape):
    println s.name() + " area=" + s.area()
end

func main:
    c := Circle { r = 2.0 } as dyn Shape
    r := Rect { w = 3.0, h = 4.0 } as dyn Shape
    describe(c)
    describe(r)

    // print does not end the line; the three pieces make one.
    print "a"
    print "b"
    println "c"

    println 1.0 / 3.0
    println 0.1 + 0.2
    println 1000000000.5
    println 0.00001
    println 100000.0
    println 2.5

    ch := 'A'
    println ch
    println 'z'
end
