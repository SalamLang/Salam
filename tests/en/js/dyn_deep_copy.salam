interface Counter:
    func bump(): int
    func total(): int
end

struct Tally:
    pub n: int = 0
    pub log: Vector<int> = Vector {}

    pub func bump(): int:
        this.n += 1
        this.log.push(this.n)
        ret this.n
    end

    pub func total(): int:
        ret this.n * 100 + this.log.len()
    end
end

struct Handle:
    pub raw: int* = null
    pub n: int = 0

    pub func bump(): int:
        this.n += 10
        ret this.n
    end

    pub func total(): int:
        ret this.n
    end
end

struct Svc:
    pub name: str = ""
    pub c: dyn Counter = Tally {}
end

func main:
    mut a := Tally {} as dyn Counter
    a.bump()
    b := a.deep_copy()
    a.bump()
    println a.total(), b.total()

    mut s := Svc { name = "s" }
    s.c.bump()
    s2 := s.deep_copy()
    s3 := s.copy()
    s.c.bump()
    println s.c.total(), s2.c.total(), s3.c.total()

    mut list := Vector {} as Vector<dyn Counter>
    list.push(Tally {})
    list.push(Handle {})
    l2 := list.deep_copy()
    list.get(0).bump()
    list.get(1).bump()
    println list.get(0).total(), l2.get(0).total(), list.get(1).total(), l2.get(1).total()
end
