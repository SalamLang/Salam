interface Shape:
    func area(): int
    func name(): str
end

struct Square:
    pub side: int = 1

    pub func area(): int:
        ret this.side * this.side
    end

    pub func name(): str:
        ret "square"
    end
end

struct Rect:
    pub w: int = 1
    pub h: int = 1

    pub func area(): int:
        ret this.w * this.h
    end

    pub func name(): str:
        ret "rect"
    end
end

struct Slot:
    pub label: str = ""
    pub shape: dyn Shape = Square { side = 2 }
end

func total(slots: Vector<Slot>): int:
    mut t := 0
    repeat slots.len() in i:
        t += slots.get(i).shape.area()
    end
    ret t
end

func main:
    a := Slot { label = "a" }
    b := Slot { label = "b", shape = Rect { w = 2, h = 5 } }
    println a.shape.name(), a.shape.area(), b.shape.name(), b.shape.area()
    mut c := Slot { label = "c" }
    mut sq := Square { side = 3 }
    c.shape = sq
    sq.side = 10
    println c.shape.area()
    mut slots := Vector {} as Vector<Slot>
    slots.push(a)
    slots.push(b)
    slots.push(c)
    println total(slots)
    mut shapes := Vector {} as Vector<dyn Shape>
    shapes.push(Square { side = 4 })
    shapes.push(Rect { w = 1, h = 7 })
    println shapes.get(0).area() + shapes.get(1).area()
end
