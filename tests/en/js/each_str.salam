struct Blob:
    pub data: str = ""

    pub func bytes(): Vector<int>:
        mut v := Vector {} as Vector<int>
        v.push(this.data.len())
        ret v
    end
end

func greet(): str:
    ret "Salam سلام"
end

func show(s: str):
    mut out := ""
    mut back := ""
    each ch in s:
        out = out + "[" + ch.len() + "]"
        back = back + ch
    end
    println out, back == s
end

func main:
    each ch in "سلام 👋":
        print ch, "|"
    end
    println ""
    mut empty := 0
    each ch in "":
        empty += ch.len()
    end
    println "empty:", empty
    each i, ch in "aسb":
        println i, ch, ch.len()
    end
    mut kept := ""
    each ch in "a-b-c":
        if ch == "-": continue end
        if ch == "c": break end
        kept = kept + ch
    end
    println "kept:", kept
    mut joined := ""
    each ch in greet():
        joined = joined + "[" + ch + "]"
    end
    println joined
    mut n := 0
    each ch in "سلام":
        if ch == "ل": n += 1 end
    end
    println "lam:", n
    each b in "Hi".bytes():
        println b as int
    end
    each i, b in "سا".bytes():
        println i, b as int
    end
    blob := Blob { data = "xyz" }
    each v in blob.bytes():
        println "struct bytes():", v
    end
    mut count := 0
    each _ in "👋🏽":
        count += 1
    end
    println "code points:", count
    show("€")
    show("\xf0\x9f\x91\x8bz")
end
