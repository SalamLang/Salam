enum Color:
    Red = "is_red"
    Green = "is_green"
    Blue = "is_blue"
end

func main:
    println Color.Red as str
    println Color.Red == Color.Green
    println Color.Green.name()

    mut ok := false
    hit := Color.FromString("Blue", ok)
    println ok
    println hit.name()

    println Color.Count()
end
