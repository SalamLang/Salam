const HALF := 7.5 % 2.0
const NEG := -7.5 % 2.0
const ZERO := 6.0 % 3.0

type Meters: f64
end

func keep<T>(x: T): T:
    ret x
end

func sign_of_zero(x: f64): str:
    if 1.0 / x < 0.0:
        ret "-0"
    end
    ret "+0"
end

func main:
    println keep(7.5) % keep(2.0), keep(-7.5) % keep(2.0), keep(7.5) % keep(-2.0)
    println 7.5 % 2.0, HALF, NEG, ZERO, -6.5 % 2.0
    z := keep(0.0)
    inf := keep(1.0) / z
    println keep(5.0) % z, inf % keep(2.0), keep(5.0) % inf, keep(-5.0) % inf
    println sign_of_zero(keep(-4.0) % keep(2.0)), sign_of_zero(keep(4.0) % keep(2.0))
    println sign_of_zero(keep(-0.0) % keep(3.0)), sign_of_zero(-6.0 % 3.0)
    n := keep(3)
    println keep(10.5) % n,
        keep(10) % keep(4.0),
        keep(7.5) % keep(2 as i64),
        keep(7.5) % keep(2 as u64)
    f := keep(7.5 as f32)
    println f % keep(2.0 as f32), f % n, keep(1.0 as f32) % keep(0.25 as f32)
    g := keep(1.0 as f32)
    println g % keep(0.1 as f32), keep(1.0) % keep(0.1), g % 0.1, g + 0.1
    mut h := g
    h %= 0.1
    println h
    mut a := keep(17.25)
    a %= 5.0
    println a
    mut b := keep(-17.25 as f32)
    b %= keep(5.0 as f32)
    println b
    mut c := keep(9.5)
    c %= n
    println c
    mut arr := [keep(10.5), keep(11.5)]
    arr[1] %= 4.0
    println arr[0], arr[1]
    m := keep(7.5) as Meters
    d := keep(2.0) as Meters
    println (m % d) as f64
    mut acc := 0.0
    repeat 1 to 10 in i:
        acc += ((i as f64) * 1.25) % 3.0
    end
    println acc
end
