package main

import fmt

func show(x: f64, spec: str):
    println spec + " [" + fmt.FormatFloat(x, spec) + "]"
end

func showi(n: i64, spec: str):
    println spec + " [" + fmt.FormatInt(n, spec) + "]"
end

func main:
    println "rounding of the exact binary value"
    show(0.125, "%.2f")
    show(0.375, "%.2f")
    show(2.5, "%.0f")
    show(3.5, "%.0f")
    show(0.135, "%.2f")
    show(2.675, "%.2f")
    show(1.005, "%.2f")
    show(0.9995, "%.3f")
    show(9.9999995, "%g")
    show(0.1, "%.20f")
    show(0.3, "%.17g")
    show(-0.0004, "%.3f")

    println "conversions"
    show(1234.5678, "%f")
    show(1234.5678, "%e")
    show(1234.5678, "%E")
    show(1234.5678, "%g")
    show(1234567.0, "%g")
    show(1234567.0, "%G")
    show(0.0001234, "%g")
    show(0.00001234, "%g")
    show(100.0, "%g")
    show(100.0, "%#g")
    show(1.5, "%.0e")
    show(1.5, "%#.0e")
    show(7.0, "%#.0f")
    show(0.0, "%e")
    show(0.0, "%g")
    show(42.0, "")

    println "flags and width"
    show(3.14159, "%10.3f")
    show(3.14159, "%-10.3f")
    show(3.14159, "%+.2f")
    show(3.14159, "% .2f")
    show(-3.14159, "%010.2f")
    show(3.14159, "%+010.2f")
    show(-0.0, "%.1f")
    show(-0.0, "%+g")
    show(1.0, "%-+8.1f")

    println "extremes"
    show(1e300, "%e")
    show(1e300, "%.3g")
    show(1.7976931348623157e308, "%.17e")
    show(2.2250738585072014e-308, "%.6e")
    show(5e-324, "%.3e")
    show(5e-324, "%g")
    show(1e22, "%f")
    show(1e23, "%.0f")

    println "nan and inf"
    big := 1e308
    inf := big * 10.0
    nan := inf - inf
    show(inf, "%f")
    show(-inf, "%e")
    show(inf, "%+G")
    show(nan, "%F")
    show(nan, "% g")
    show(inf, "%08f")
    show(-inf, "%-8f")

    println "integers"
    showi(42 as i64, "%d")
    showi(42 as i64, "%5d")
    showi(42 as i64, "%-5d")
    showi(42 as i64, "%05d")
    showi(42 as i64, "%+d")
    showi(42 as i64, "% d")
    showi(-42 as i64, "%05d")
    showi(42 as i64, "%.5d")
    showi(42 as i64, "%8.5d")
    showi(42 as i64, "%08.5d")
    showi(0 as i64, "%.0d")
    showi(255 as i64, "%x")
    showi(255 as i64, "%X")
    showi(255 as i64, "%#x")
    showi(255 as i64, "%#010x")
    showi(0 as i64, "%#x")
    showi(-255 as i64, "%x")
    showi(8 as i64, "%o")
    showi(8 as i64, "%#o")
    showi(0 as i64, "%#o")
    showi(5 as i64, "%b")
    showi(5 as i64, "%#b")
    showi(-5 as i64, "%08b")
    showi(9007199254740991 as i64, "%d")
    showi(-9007199254740991 as i64, "%x")
    showi(7 as i64, "%i")
    showi(7 as i64, "%lld")

    println "persian digits in the spec"
    show(3.14159, "%.۲f")
    showi(7 as i64, "%۰۴d")

    println "bad specs"
    show(1.0, "%d")
    showi(1 as i64, "%f")
    show(1.0, "%.2fx")
    showi(1 as i64, "%q")
end
