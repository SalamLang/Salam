const MAX_U := 340282366920938463463374607431768211455 as u128
const MIN_I := -170141183460469231731687303715884105728 as i128

struct Account:
    pub id: u128 = 0
    pub balance: i128 = 0
end

func mul_hi(a: u128, b: u128): u128:
    ret (a * b) >> 64
end

func main:
    println MAX_U, MIN_I
    mut x := 1 as u128 << 100
    x += 5
    println x, x >> 90, x / 7, x % 7, ~x
    println mul_hi(1 as u128 << 40, 1 as u128 << 40)
    y := -(1 as i128 << 100)
    println y, y >> 3, y / 7, y % 7
    a := Account { id = MAX_U, balance = MIN_I }
    println a.id == MAX_U, a.balance < 0
    mut v := Vector {} as Vector<u128>
    v.push(x)
    v.push(MAX_U)
    println v.get(0) + v.get(1)
    v.free()
    mut m := HashMap {} as HashMap<u128, str>
    m.put(MAX_U, "max")
    println m.get(MAX_U), m.has(x)
    m.free()
    println "x=" + x
    println x as f64, (1.5e30 as u128) > x, y as i32
end
