func big(): i64:
    ret 1099511627776
end

func main:
    one := 1 as i64
    println one << (40 as i64)
    println big() >> (8 as i64)
    println (0 as i64) - big() >> (3 as i64)
    println big() | (5 as i64)
    println (big() + (255 as i64)) & (4095 as i64)
    println big() ^ (1099511627775 as i64)
    println ~big()
    u := 3 as u64
    println u + (5 as u64) - (7 as u64) == (1 as u64)
    println (1 as u64) << (52 as u64)
    mut w := 4503599627370495 as u64
    w &= 1099511627775 as u64
    println w
    w |= 1 as u64 << (45 as u64)
    println w
    w ^= 3 as u64
    println w
    w <<= 2 as u64
    println w
    w >>= 3 as u64
    println w
    n := -5
    println n as i64
    println (n as i64) * big()
    mut x := 3 as u32
    x ^= 4294967295 as u32
    println x
    x &= 2147483648 as u32
    println x
    x |= 7 as u32
    println x
    mut y := 1 as u8
    y <<= 9 as u8
    println y
    z := 7 as usize
    println z << (40 as usize)
    s := 0 - 12
    println s as size >> (1 as size)
end
