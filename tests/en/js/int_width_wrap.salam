// Integer width and signedness in the JS backend. JavaScript has a single
// f64 numeric type and its bitwise operators coerce to signed 32-bit, so
// sized integers need explicit wrapping to keep salam's modulo-2^n
// semantics (SALAM-TYPES.md 4.1, 15, 16, 21).
//
// Only widths up to 32 bits appear here: an f64 cannot represent every
// i64/u64 value, so 64-bit integers are outside what this backend models -
// tests/en/{exec,general,llvm}/int_width_wrap.salam cover those.

func rotl32(x: u32, n: u32): u32:
    ret (x << n) | (x >> (32 - n))
end

func main:
    a := 4000000000 as u32
    b := 1000000000 as u32
    println "add wrap:", a + b
    c := 3000000000 as u32
    println "mul wrap:", c * (3 as u32)

    // logical (not arithmetic) shift right
    d := 4294967295 as u32
    println "u32 shr:", d >> 28
    println "rotl8:", rotl32(0x12345678 as u32, 8 as u32)
    println "xor:", (0xF0F0F0F0 as u32) ^ (0x0F0F0F0F as u32)
    println "not:", ~(0 as u32)

    // narrow types wrap at their own width
    b8 := 200 as u8
    println "u8 add:", b8 + (100 as u8)
    println "u8 not:", ~b8
    println "u16 add:", (60000 as u16) + (10000 as u16)
    println "i8 add:", (100 as i8) + (100 as i8)
    println "i16 add:", (30000 as i16) + (10000 as i16)

    // unary minus preserves the operand type
    println "u32 neg:", -(1 as u32)

    // unsigned division and comparison must not use the signed reading
    println "u32 div:", (4000000000 as u32) / (3 as u32)
    println "u32 mod:", (4000000000 as u32) % (3 as u32)
    println "u32 cmp:", (4000000000 as u32) > (1 as u32)

    // casts truncate to the target width and reinterpret the bit pattern
    v := 4294967295 as u32
    println "chain:", v as u8, v as u16, v as i32
    n := -1 as i32
    println "chain2:", n as u8, n as u16, n as u32

    // a u32 accumulation loop, the shape real hashing code has
    mut h := 2166136261 as u32
    mut i := 0
    until i < 8:
        h = h ^ ((i + 1) as u32)
        h = h * (16777619 as u32)
        i++
    end
    println "fnv32:", h
end
