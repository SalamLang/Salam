// json.Schema in the browser.
//
// A derived schema is an ordinary generated function returning an ordinary
// string, so there is nothing backend-specific about it - but the merge step
// runs json.Get over the document, and json.salam reads its input through a
// byte pointer into the string. That is the one thing a JS string does not
// have, so this is the test that says the JS backend gives it one: a schema
// that came back as "{}" here would mean the scanner saw nothing.
//
// json.Keys is exercised for the same reason, and because net/http/swagger
// walks a document's definitions with it.

import encoding.json

@doc "how far along a todo is"
enum Status:
    Open
    Done
end

@doc "one item on the list"
struct Todo:
    @doc "assigned when the todo is created"
    pub id: i64 = 0 as i64
    @json "is_done"
    pub done: bool = false
    pub state: Status = Status.Open
    @json "" "omitempty"
    pub notes: str = ""
end

func main:
    schema := json.Schema(Todo {})
    println schema
    println json.Valid(schema)

    defs := json.Get(schema, "$defs")
    names := json.Keys(defs)
    defer names.free()
    repeat names.len() with i:
        println names.get(i)
    end

    todo := json.Get(defs, "Todo")
    props := json.Keys(json.Get(todo, "properties"))
    defer props.free()
    repeat props.len() with j:
        println props.get(j)
    end
    println json.Get(todo, "description")
    println json.Get(todo, "required")

    // The round trip the schema describes: an encoder, and a decoder that
    // agrees with it about which keys are allowed to be missing.
    t := Todo { id = 7 as i64, done = true, state = Status.Done }
    text := json.Marshal(t)
    println text
end
