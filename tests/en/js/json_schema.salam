import encoding.json

@doc "how far along a todo is"
enum Status:
    Open
    Done
end

@doc "one item on the list"
struct Todo:
    @doc "assigned when the todo is created"
    pub id: i64 = 0 as i64
    @json "is_done"
    pub done: bool = false
    pub state: Status = Status.Open
    @json "" "omitempty"
    pub notes: str = ""
end

func main:
    schema := json.Schema(Todo {})
    println schema
    println json.Valid(schema)

    defs := json.Get(schema, "$defs")
    names := json.Keys(defs)
    defer names.free()
    repeat names.len() with i:
        println names.get(i)
    end

    todo := json.Get(defs, "Todo")
    props := json.Keys(json.Get(todo, "properties"))
    defer props.free()
    repeat props.len() with j:
        println props.get(j)
    end
    println json.Get(todo, "description")
    println json.Get(todo, "required")

    t := Todo { id = 7 as i64, done = true, state = Status.Done }
    text := json.Marshal(t)
    println text
end
