import math

func keep<T>(x: T): T:
    ret x
end

func main:
    x := keep(2.0 as f32)
    y := keep(0.5 as f32)
    println math.SqrtF32(x), math.AbsF32(keep(-2.5 as f32)), math.FloorF32(keep(-2.5 as f32))
    println math.CeilF32(keep(-2.5 as f32)),
        math.RoundF32(keep(2.5 as f32)),
        math.RoundF32(keep(-2.5 as f32))
    println math.TruncF32(keep(-2.75 as f32)), math.TruncF32(keep(2.75 as f32))
    println math.SinF32(y), math.CosF32(y), math.TanF32(y)
    println math.ExpF32(y), math.LogF32(x), math.PowF32(x, y), math.PowF32(x, keep(10.0 as f32))
    println math.ModF32(keep(7.5 as f32), x), math.ModF32(keep(-7.5 as f32), x), x % y
    println math.HypotF32(keep(3.0 as f32), keep(4.0 as f32)), math.Atan2F32(y, x)
    println math.MinF32(x, y), math.MaxF32(x, y)
    big := keep(3.0e38) as f32
    println math.HypotF32(big, keep(1.0 as f32)),
        math.ExpF32(keep(100.0 as f32)),
        math.SqrtF32(keep(-1.0 as f32))
    println math.Sqrt(2.0), math.SqrtF32(x) as f64 == math.Sqrt(2.0)
    mut sum := 0.0 as f32
    repeat 1 to 100 in i:
        sum += math.SqrtF32(i as f32)
    end
    println sum
end
