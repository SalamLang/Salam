func f1(): int:
    ret 1
end

func f2(): int:
    ret 2
end

func f3(): int:
    ret 3
end

func f4(): int:
    ret 4
end

func f5(): int:
    ret 5
end

func f6(): int:
    ret 6
end

func f7(): int:
    ret 7
end

func f8(): int:
    ret 8
end

func f9(): int:
    ret 9
end

func f10(): int:
    ret 10
end

func f11(): int:
    ret 11
end

func f12(): int:
    ret 12
end

func main:
    mut t := 0
    repeat 3:
        t += f1()
        t += f2()
        t += f3()
        t += f4()
        t += f5()
        t += f6()
        t += f7()
        t += f8()
        t += f9()
        t += f10()
        t += f11()
        t += f12()
    end
    println t
end
