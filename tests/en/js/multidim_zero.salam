func main:
    mut g: int[2][3]
    mut c: u8[2][2][4]
    g[1][2] = 9
    c[1][1][3] = 7 as u8
    println len(g), len(g[0]), g[1][2], g[0][0]
    println len(c), len(c[1]), len(c[1][1]), c[1][1][3]
end
