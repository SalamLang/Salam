 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

import node

func main:
    println node.IsWindows() == (node.Platform() == "win32")

    fsm := node.Require("fs")
    exp := node.Exports()
    println node.IsNullish(exp)
    node.SetStr(exp, "name", "demo")
    node.SetNum(exp, "count", 3.0)
    node.SetBool(exp, "ready", true)
    println node.GetStr(exp, "name"), node.GetNum(exp, "count"), node.GetBool(exp, "ready")
    inner := node.NewObject()
    node.SetNum(inner, "value", 7.0)
    node.SetProp(exp, "inner", inner)
    println node.GetNum(node.GetProp(exp, "inner"), "value")

    list := node.NewArray()
    node.PushStr(list, "b")
    node.PushStr(list, "a")
    node.PushStr(list, "c")
    println node.ToStr(node.Call0(list, "reverse"))
    println node.ToBool(node.CallS1(list, "includes", "a"))
    println node.ToStr(node.CallS2(node.Global("Math"), "hypot", "3", "4"))
    println node.ToStr(node.CallS3(list, "splice", "0", "1", "z"))
    println node.ToStr(list)

    other := node.NewArray()
    node.Push(other, node.Global("Math"))
    println node.GetNum(other, "length")
    println node.ToStr(node.CallV2(node.Global("Math"), "max", node.GetProp(list, "length"), node.GetProp(list, "length")))
    println node.ToStr(node.CallV3(node.Global("Math"), "min", node.GetProp(list, "length"), node.GetProp(list, "length"), node.GetProp(list, "length")))

    node.SetPropFn0(
        exp, "ping", (): println "ping called" end
    )
    node.Call0(exp, "ping")
    node.SetPropFn1R(
        exp, "double", (x: i64): ret node.CallV1(node.Global("Math"), "abs", x) end
    )
    println node.IsNullish(node.GetProp(exp, "double"))
    println node.ToStr(node.Invoke1(node.GetProp(node.Global("Math"), "abs"), node.GetProp(node.Global("Number"), "NaN")))

    arr2 := node.NewArray()
    node.PushStr(arr2, "x")
    node.PushStr(arr2, "y")
    println node.ToStr(node.CallB1(node.Global("JSON"), "stringify", true))
    println node.ToStr(node.CallVS1(arr2, "fill", node.GetProp(arr2, "length"), "z"))
    node.CallFn1(arr2, "forEach", (x: i64): println "element:", node.ToStr(x) end)
    node.CallFn0(node.Global("process"), "nextTick", (): println "tick" end)
    emitter := node.New0(node.GetProp(node.Require("events"), "EventEmitter"))
    node.CallSFn0(emitter, "on", "ping", (): println "pinged" end)
    node.CallS1(emitter, "emit", "ping")
    node.SetPropFn1(emitter, "show", (x: i64): println "show:", node.ToStr(x) end)
    node.Invoke2(node.GetProp(emitter, "show"), arr2, arr2)
    node.Invoke0(node.GetProp(emitter, "show"))
    date := node.New4(node.Global("Date"), node.GetProp(node.Global("Number"), "EPSILON"), node.GetProp(node.Global("Number"), "EPSILON"), node.GetProp(node.Global("Number"), "EPSILON"), node.GetProp(node.Global("Number"), "EPSILON"))
    println node.IsNullish(date)
    promise := node.NewPromise((resolve: i64, reject: i64): node.Invoke1(resolve, reject) end)
    println node.IsNullish(promise)

    base := node.TmpDir()
    println base.Len() > 0
    dir := node.MkdtempSync(node.PathJoin2(base, "salam-node-"))
    file := node.PathJoin3(dir, "sub", "note.txt")
    println node.PathDirname(file) == node.PathJoin2(dir, "sub")
    node.CallSB1(fsm, "mkdirSync", node.PathJoin2(dir, "sub"), true)
    node.WriteFileSync(file, "hello node")
    println node.ReadFileSync(file)
    node.RmSyncRecursiveForce(dir)
    println node.ToBool(node.CallS1(fsm, "existsSync", dir))

    args := node.NewArray()
    node.PushStr(args, "-e")
    node.PushStr(args, "console.log('child ok')")
    node.ExecFile(
        "node", args, base, (failed: bool, out: str, err: str): println "child:", failed, out.Len(),
        err.Len()
        node.ExecFileRaw(
            "node", args, base, (code: i64, out2: str, err2: str): println "raw:", node.IsNullish(code),
            out2.Len(), err2.Len() end
        ) end
    )
end
