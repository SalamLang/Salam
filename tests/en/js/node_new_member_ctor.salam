import node

func main:
    ee := node.New0(node.GetProp(node.Require("events"), "EventEmitter"))
    println node.IsNullish(ee)
    println node.ToStr(
        node.CallS1(node.New1(node.Global("Array"), node.Global("undefined")), "concat", "x")
    )
end
