interface Shape:
    func area(): int
    func label(): str:
        ret "shape " + this.area()
    end
end

struct Being:
    pub alive: bool = true

    pub func breathe(): str:
        ret "breathing"
    end
end

struct Pet:
    pub use Being
    pub name: str = ""

    pub mut func rename(n: str):
        this.name = n
    end
end

struct Vec2:
    pub x: int = 0
    pub y: int = 0

    pub func +(o: Vec2): Vec2:
        ret Vec2 { x = this.x + o.x, y = this.y + o.y }
    end

    pub func ==(o: Vec2): bool:
        ret this.x == o.x and this.y == o.y
    end

    pub func -: Vec2:
        ret Vec2 { x = 0 - this.x, y = 0 - this.y }
    end
end

struct Sq:
    pub s: int = 0

    pub func area(): int:
        ret this.s * this.s
    end
end

func main:
    q := Sq { s = 3 } as dyn Shape
    println q.label(), Sq { s = 2 }.label()
    mut p := Pet { name = "rex" }
    p.rename("max")
    println p.name, p.breathe(), p.alive
    a := Vec2 { x = 1, y = 2 }
    b := Vec2 { x = 3, y = 4 }
    c := a + b
    d := -c
    println c.x, c.y, d.x, a == Vec2 { x = 1, y = 2 }, a == b
    mut sum := Vec2 {}
    repeat 3:
        sum = sum + a
    end
    println sum.x, sum.y
end
