func main:
    quarter := 25%
    half := 12.5%
    rem := 7%3
    spaced := 10 % 4
    pct := 50
    m := pct%7
    parts := [10%, 20%, 100%]
    paren := (5%)
    blue := #3366aa
    white := #fff
    clear := #3366aa80
    four := #fffa
    hundred := 1e2%
    println quarter
    println half
    println rem
    println spaced
    println m
    println parts[1] + parts[2]
    println paren * 4.0
    println quarter + 1.0
    println blue
    println white.len()
    println clear
    println four + "!"
    println hundred
end
