include drv "../general/_pkgcoerce_drv.salam"

func main:
    println drv.Run(drv.Mem { n = 1 })
    println drv.Run(drv.MakeSq(3))
    println drv.ShowVia(drv.MakeSq(4))
    println drv.ShowVia("x")
    println drv.RunDefault(1)
    println drv.RunDefault(1, drv.Mem { n = 2 })
    println drv.ShowDefault(1)
    println drv.ShowDefault(1, "y")
end
