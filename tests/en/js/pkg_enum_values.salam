include l "../general/_pkg_enum_lib.salam"
include o "../general/_pkg_enum_decoy.salam"

const PRIV := 1

mut G := l.Conf {}

enum Tone:
    Bright, Dim, Soft, Loud
end

struct Local:
    pub t: l.Tone = l.Tone.Loud
    pub own: Tone = Tone.Loud
    pub c: l.Conf = l.Conf {}
end

struct Wrap<T>:
    pub items: Vector<T> = Vector {}
    pub t: l.Tone = l.Tone.Loud
end

struct Shadow:
    pub p: int = 5

    pub func go(): int:
        c := l.Conf {}
        ret this.p + c.p
    end
end

func helper(): int:
    ret 2
end

func show(c: l.Conf):
    println c.t as int, c.alias as int, l.MoodNum(c), c.arr[0] as int, c.p, c.h, c.w
    println c.label == l.Label.Bob, c.shape
end

func by_switch(t: l.Tone): str:
    switch t:
        l.Tone.Soft:
            ret "soft"
        end
        l.Tone.Loud:
            ret "loud"
        end
    end
    ret "?"
end

func by_bare(t: l.Tone): str:
    switch t:
        Soft:
            ret "soft"
        end
        Loud:
            ret "loud"
        end
    end
    ret "?"
end

func by_match(t: l.Tone): str:
    ret match t:
        Soft: "soft" end
        l.Tone.Loud: "loud" end
    end
end

func shadowed(PRIV2: int): int:
    t2 := 7
    c := l.Conf {}
    ret PRIV2 + t2 + c.p
end

func main:
    show(l.Conf {})
    show(G)
    println l.Pick()
    println (l.Picker {}).Pick()
    println l.TOP as int
    println Tone.Loud as int, o.Mood.Wild as int, o.WILDNESS, PRIV, helper()
    println l.Tone.Loud as int, l.Tone.Soft as int
    a := Local {}
    println a.t as int, a.own as int, a.c.t as int
    out := l.Outer {}
    println out.set.t as int, out.plain.t as int
    b := l.Box {} as l.Box<int>
    println b.t as int
    w := Wrap {} as Wrap<int>
    println w.t as int
    println l.Make("x").t as int
    println by_switch(l.Tone.Loud), by_bare(l.Tone.Loud), by_match(l.Tone.Loud), l.Say(l.Tone.Loud)
    println shadowed(3)
    println (Shadow {}).go()
    Tn := 7
    println (l.Conf {}).alias as int, Tn
end
