func factorial(n: int): int:
    if n <= 1:
        ret 1
    end
    ret n * factorial(n - 1)
end

func fib(n: int): int:
    if n < 2:
        ret n
    end
    ret fib(n - 1) + fib(n - 2)
end

func main:
    println factorial(6)
    println fib(10)
end
