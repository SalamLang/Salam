func main:
    mut c := 0
    repeat 4:
        c = c + 1
    end
    println c

    mut up seq := ""
    repeat 1 to 5 with i:
        up seq = up seq + i
    end
    println up seq

    mut down seq := ""
    repeat 5 to 1 with i:
        down seq = down seq + i
    end
    println down seq
end
