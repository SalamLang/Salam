func main:
    mut c := 0
    repeat 4:
        c++
    end
    println c

    mut up_seq := ""
    repeat 1 to 5 in i:
        up_seq += i
    end
    println up_seq

    mut down_seq := ""
    repeat 5 to 1 in i:
        down_seq += i
    end
    println down_seq
end
