import math

func keep<T>(x: T): T:
    ret x
end

func main:
    println math.Round(keep(2.5)),
        math.Round(keep(-2.5)),
        math.Round(keep(3.5)),
        math.Round(keep(-3.5))
    println math.Round(keep(0.5)),
        math.Round(keep(-0.5)),
        math.Round(keep(-0.4)),
        math.Round(keep(0.4))
    println math.Round(keep(0.49999999999999994)), math.Round(keep(-0.49999999999999994))
    println math.Round(keep(4503599627370497.0)), math.Round(keep(-4503599627370497.0))
    println math.Round(keep(2.0)), math.Round(keep(-7.0)), math.Round(keep(1.0e300))
    println math.Round(keep(-0.0)),
        math.Round(keep(0.0)),
        math.Round(keep(2.4999)),
        math.Round(keep(-2.5001))
    z := keep(0.0)
    println math.Round(keep(1.0) / z), math.Round(keep(-1.0) / z), math.Round(z / z)
    println math.RoundF32(keep(2.5 as f32)),
        math.RoundF32(keep(-2.5 as f32)),
        math.RoundF32(keep(-0.25 as f32))
    println math.RoundF32(keep(8388609.0 as f32)), math.RoundF32(keep(0.49999997 as f32))
    println math.Round(2.5), math.Round(-2.5), math.Round(-0.4)
end
