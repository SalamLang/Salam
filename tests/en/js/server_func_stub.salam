package main

struct Item:
    pub id: int = 0
    pub name: str = ""
    pub tags: Vector<str> = Vector {}
end

server func Add(a: int, b: int): int:
    secret := "never-in-the-browser"
    ret a + b + secret.Len()
end

server func Greet(name: str): str:
    ret "server says " + name
end

server func Fetch(id: int): Item:
    ret Item { id = id }
end

server func Stock(sku: str): int throw:
    throw "no stock for " + sku
end

func main:
    println Add(40, 2)
    println Greet("salam")
    it := Fetch(3)
    println it.name + " " + it.tags.Len() + " " + it.id
    try:
        println Stock("x1")
    catch e:
        println "caught " + e.message
    end
end
