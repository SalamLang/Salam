mut g_calls := 0
mut g_it_calls := 0
mut g_store := Vector {} as Vector<int>

func next_cap(): int:
    g_calls++
    ret 8
end

func make_vec(): Vector<int>:
    g_calls++
    ret g_store
end

func store_iter(): VectorIter<int>:
    g_it_calls++
    ret g_store.Iter()
end

func main:
    g_store.Push(4)
    g_store.Push(5)
    make_vec().Reserve(next_cap())
    println g_calls
    println store_iter().HasNext(), g_it_calls
    println store_iter().Value(), g_it_calls
    mut it := g_store.Iter()
    mut sum := 0
    until it.HasNext():
        sum += it.Value()
        it.Next()
    end
    println sum
end
