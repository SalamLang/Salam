struct Pair:
    pub a: i64
    pub b: i64
end

func main:
    println size(i32), size(i64), size(bool), size(Pair)
    println size(i32*) == size(usize), size(Pair*) == size(usize)
    println size(u8) + size(i16)
    total := size(Pair) * 3
    println total
end
