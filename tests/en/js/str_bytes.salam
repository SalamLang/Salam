import conv
import config
import filepath

func main:
    println conv.ParseInt("8080")
    println conv.ParseInt("  -42")
    println conv.ParseFloat("2.5")
    println conv.ParseBool("true")

    mut text := "port = 8080\n"
    text = text.concat("name = \"my app\" # display name\n")
    text = text.concat("[db]\n")
    text = text.concat("host=localhost\n")
    cfg := config.ParseINI(text)
    println config.Get(cfg, "port")
    println config.Get(cfg, "name")
    println config.Get(cfg, "db.host")
    println config.GetInt(cfg, "port", 0)

    println filepath.Base("/tmp/dir/file.txt")
    println filepath.Ext("/tmp/dir/file.txt")
    println filepath.Dir("/tmp/dir/file.txt")
end
