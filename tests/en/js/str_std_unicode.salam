import str

func main:
    s := "سلام دنیا 👋 سلام"
    println "Compare", str.Compare("ب", "آ")
    println "Trim", "[" + str.Trim("  سلام  ") + "]"
    println "Replace", str.Replace(s, "سلام", "hi")
    println "Upper", str.Upper("héllo سلام")
    println "Lower", str.Lower("HÉLLO سلام")
    println "Title", str.Title("héllo wörld")
    println "EqualFold", str.EqualFold("Straße", "STRASSE"), str.EqualFold("سلام", "سلام")
    println "CompareFold", str.CompareFold("ab", "AC")
    println "ToEnglishDigits", str.ToEnglishDigits("۱۲۳ ٤٥")
    println "ToPersianDigits", str.ToPersianDigits("123 سلام")
    println "ToArabicDigits", str.ToArabicDigits("123")
    println "HasPersianDigits", str.HasPersianDigits("x۵"), str.HasEnglishDigits("۵")
    println "Repeat", str.Repeat("سل", 2)
    println "Fields", str.Fields(" سلام  دنیا\tx ").len()
    println "GraphemeCount", str.GraphemeCount("é👋🏽a")
    println "Graphemes", str.Graphemes("é👋a").len()
    println "ReverseGraphemes", str.ReverseGraphemes("é👋a")
    println "NFC", str.NFC("e\u0301") == "é", str.NFD("é") == "e\u0301", str.IsNFC("é")
    println "Contains", str.Contains(s, "👋"), str.Contains(s, "x")
    println "StartsWith", str.StartsWith(s, "سلام"), str.EndsWith(s, "سلام")
    println "Count", str.Count(s, "سلام")
    println "TrimLeft", "[" + str.TrimLeft("  سل ") + "]", "[" + str.TrimRight(" سل  ") + "]"
    println "TrimPrefix", str.TrimPrefix(s, "سلام "), "|", str.TrimSuffix(s, " سلام")
    println "Reverse", str.Reverse("سلام👋")
    println "CharCount", str.CharCount(s)
    println "CharSubstr", str.CharSubstr(s, 5, 4)
    println "CharAtIndex", str.CharAtIndex(s, 10)
    println "CharFind", str.CharFind(s, "👋")
    println "Split", "abc".split("").len(), "a,b,".split(",").len()
    println "Chars", str.Chars("a👋ب").len()
end
