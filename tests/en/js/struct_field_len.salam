struct Span:
    pub len: int
    pub word: str
end

func widen(s &: Span, amount: int):
    s.len += amount
end

func fill(out &: int):
    out = 9
end

func main:
    mut sp := Span { len = 3, word = "ab" }
    widen(sp, 4)
    println sp.len
    fill(sp.len)
    println sp.len
    println sp.word
    xs := [1, 2, 3]
    println len(xs)
end
