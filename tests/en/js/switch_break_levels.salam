func first_negative(xs: Vector<int>): int:
    mut found := 0 - 1
    repeat xs.len() with i:
        switch xs.get(i):
            0:
                continue
            end
            < 0:
                found = i
                break 2
            end
        end
    end
    ret found
end

func find_pair(target: int): str:
    mut out := "none"
    repeat 5 with i:
        repeat 5 with j:
            if i * j == target:
                out = "" + i + "x" + j
                break 2
            end
        end
    end
    ret out
end

func deep(): str:
    mut trace := ""
    mut k := 0
    until k < 10:
        k += 1
        switch k:
            3:
                switch true:
                    true:
                        trace += "exit@3"
                        break 3
                    end
                end
            end
            else:
                trace += "" + k + ","
            end
        end
    end
    ret trace
end

func with_defers(): str:
    repeat 2 with i:
        defer println "outer defer", i
        repeat 3 with j:
            defer println "inner defer", i, j
            if j == 1:
                break 2
            end
        end
    end
    ret "done"
end

func main:
    mut xs := Vector {} as Vector<int>
    xs.push(3)
    xs.push(0)
    xs.push(-4)
    xs.push(-9)
    println "first negative at", first_negative(xs)
    println "pair for 6:", find_pair(6), "pair for 99:", find_pair(99)
    println "deep:", deep()
    println with_defers()
    mut n := 0
    until true:
        n += 1
        if n == 3:
            break 1
        end
    end
    println "break 1 stopped at", n
end
