func grade(x: int, name: str): str:
    switch true:
        x < 0:
            ret "negative"
        end
        x == 0 || name == "zero":
            ret "zero"
        end
        x > 100:
            ret "huge"
        end
    end
    ret "normal"
end

func bucket(x: int): str:
    lo := 10
    switch x:
        lo - 10 to lo - 1:
            ret "single digit"
        end
        lo to lo * 10 - 1:
            ret "double digit"
        end
    end
    ret "large"
end

func main:
    println grade(-5, ""), grade(0, ""), grade(7, "zero"), grade(500, ""), grade(50, "")
    println bucket(3), bucket(42), bucket(700)
end
