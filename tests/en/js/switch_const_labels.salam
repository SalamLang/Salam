const RED := 1
const GREEN := 2
const BLUE := 3
const BASE := 10
const NEXT := BASE + 1
const NEG := -1
const BIG := 5000000000 as i64
const CMD_START := "start"
const CMD_HELP := "help"

enum Shape:
    Circle, Square, Triangle
end

struct Config:
    pub admin: str = "ali"
end

func color_name(c: int): str:
    switch c:
        RED:
            ret "red"
        end
        GREEN, BLUE:
            ret "green or blue"
        end
    end
    ret "unknown"
end

func classify(x: int): str:
    switch x:
        NEG:
            ret "minus one"
        end
        BASE:
            ret "base"
        end
        NEXT:
            ret "next"
        end
        BASE + 2 to BASE * 2:
            ret "teens"
        end
    end
    ret "other"
end

func command(cmd: str): str:
    switch cmd:
        CMD_START:
            ret "starting"
        end
        CMD_HELP:
            ret "helping"
        end
    end
    ret "unknown command"
end

func sides(s: Shape): int:
    switch s:
        Shape.Circle:
            ret 0
        end
        Shape.Square:
            ret 4
        end
        Shape.Triangle:
            ret 3
        end
    end
    ret 0 - 1
end

func describe(n: int): str:
    switch n:
        1:
            const LABEL := "one"
            ret LABEL
        end
        2:
            const LABEL := "two"
            ret LABEL
        end
    end
    ret "many"
end

func main:
    println color_name(1), color_name(3), color_name(9)
    println classify(-1), classify(10), classify(11), classify(15), classify(50)
    println command("help"), command("start"), command("stop")
    big := 5000000000 as i64
    switch big:
        BIG:
            println "big matched"
            break
        end
    end
    println sides(Shape.Circle), sides(Shape.Square), sides(Shape.Triangle)
    owner := "ali"
    limit := 3
    cfg := Config {}
    who := "ali"
    switch who:
        owner:
            println "matched a local"
            break
        end
    end
    switch limit:
        3:
            println "matched a literal"
            break
        end
    end
    switch who:
        cfg.admin:
            println "matched a field"
            break
        end
    end
    println describe(1), describe(2), describe(3)
end
