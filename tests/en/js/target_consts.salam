func main():
    println SALAM_OS
    println SALAM_ARCH
    println SALAM_JS
    println SALAM_OS_LINUX, SALAM_OS_WINDOWS, SALAM_OS_MAC, SALAM_OS_WASM, SALAM_OS_UNIX
    println SALAM_ARCH_X64, SALAM_ARCH_ARM64, SALAM_ARCH_WASM
    if SALAM_OS_LINUX or SALAM_OS_WINDOWS or SALAM_OS_MAC:
        println "native branch"
    else:
        println "js branch"
    end
end
