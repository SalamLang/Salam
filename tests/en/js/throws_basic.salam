func parse_port(text: str): int throws:
    if text == "":
        throw Error.New(ErrorKind.InvalidArgument, "empty port")
    end
    n := text.to_int()
    if n <= 0:
        throw "port must be positive"
    end
    if n > 65535:
        throw Error.At(ErrorKind.OutOfRange, "port too large", 0)
    end
    ret n
end

func double_port(text: str): int throws:
    p := try parse_port(text)
    ret p * 2
end

func describe(text: str): str:
    try:
        ret "ok " + double_port(text)
    catch e:
        ret "failed: " + e.to_str()
    end
end

func load(text: str): int throws:
    try:
        ret try double_port(text)
    catch e:
        throw e.wrap("loading " + text)
    end
end

func main:
    println describe("80")
    println describe("")
    println describe("-5")
    println describe("70000")
    port := try parse_port("") catch 8080
    println port
    good := try parse_port("443") catch 1
    println good
    try:
        println load("x")
    catch e:
        println e.to_str()
        println e.is(ErrorKind.Other)
        println e.message
        println e.context
    end
    try:
        println load("")
    catch e:
        println e.is(ErrorKind.InvalidArgument)
        println e.to_str()
    end
end
