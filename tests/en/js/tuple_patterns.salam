func where(p: (int, int)): str:
    ret match p:
        (0, 0): "origin" end
        (0, y): "on y axis at " + y end
        (x, 0): "on x axis at " + x end
        (x, y) if x == y: "diagonal " + x end
        else: "somewhere" end
    end
end

func label(t: (str, int)): str:
    ret match t:
        ("a", n): "alpha " + n end
        (_, 0): "zero" end
        (s, n): s + n end
    end
end

func main:
    println where((0, 0))
    println where((0, 5))
    println where((7, 0))
    println where((3, 3))
    println where((1, 2))
    println label(("a", 4))
    println label(("b", 0))
    println label(("c", 9))
    a := 2
    b := "x"
    match (a, b):
        (1, _):
            println "one"
        end
        (n, "x"):
            println "x with " + n
        end
        else:
            println "other"
        end
    end
    match (1, 2, 3):
        (1, _, z):
            println "z is " + z
        end
        else:
            println "no"
        end
    end
end
