mut counter := (0, 0)

interface Bounded:
    func bounds(): (int, int)
end

struct Range:
    pub lo: int
    pub hi: int

    pub func bounds(): (int, int):
        ret this.lo, this.hi
    end
end

func ident<T>(x: T): T:
    ret x
end

func fib pair(n: int): (int, int):
    if n == 0:
        ret 0, 1
    end
    a, b := fib pair(n - 1)
    ret b, a + b
end

func bump(p &: (int, int)):
    p.0++
    p.1 += 10
end

func describe(b: dyn Bounded): int:
    lo, hi := b.Bounds()
    ret hi - lo
end

func main:
    r := Range { lo = 3, hi = 9 }
    lo, hi := r.Bounds()
    println lo, hi
    println describe(r)
    x := ident((1, "a"))
    println x
    f0, f1 := fib pair(10)
    println f0, f1
    mut t := (1, 2)
    t.0 += 5
    bump(t)
    println t
    counter.0 = 7
    println counter
    if t == (6, 12):
        println "eq"
    end
    nested := ((1, 2), (3, 4))
    println nested == ((1, 2), (3, 4)), nested.1.0
    big := (1, 2.5, "s", true, 'c', 7 as u8, 8 as i64, 9)
    println big.0, big.1, big.2, big.3, big.5, big.6
end
