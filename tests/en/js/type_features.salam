 *
 */
struct Bag:
    pub items: Vector<int> = Vector {}
    pub func len(): int: ret this.items.len() end
    pub func get(i: int): int: ret this.items.get(i) end
end

struct RangeIter:
    pub cur: int = 0
    pub stop: int = 0
    pub func has_next(): bool: ret this.cur < this.stop end
    pub func value(): int: ret this.cur end
    pub func next(): this.cur = this.cur + 1 end
end

struct Range:
    pub lo: int = 0
    pub hi: int = 0
    pub func iter(): RangeIter: ret RangeIter { cur = this.lo, stop = this.hi } end
end

interface Shape:
    func Area(): f64
end

interface Named:
    func Name(): str
end

interface Solid:
    use Shape
    use Named
    func Volume(): f64
end

struct Cube:
    pub s: f64 = 1.0
    pub func Area(): f64: ret 6.0 * this.s * this.s end
    pub func Name(): str: ret "cube" end
    pub func Volume(): f64: ret this.s * this.s * this.s end
    pub static func Of(n: f64): Self: ret Self { s = n } end
end

impl Solid on Cube:
end

func show<T: Shape + Named>(v: T):
    println v.Name(), v.Area()
end

func draw(v: dyn Solid):
    println "dyn", v.Name(), v.Volume()
end

func main:
    mut b := Bag {}
    b.items.push(7)
    b.items.push(9)
    each x in b:
        println "bag", x
    end
    r := Range { lo = 2, hi = 5 }
    each v in r:
        println "range", v
    end
    c := Cube.Of(2.0)
    show(c)
    draw(c as dyn Solid)
end
