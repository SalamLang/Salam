import encoding.json
import mem
import str

func f32_bits(v: f32): int:
    buf := mem.Allocate(4 as u64)
    p := buf as f32*
    p[0] = v
    q := buf as u32*
    bits := q[0] as int
    mem.Free(buf)
    ret bits
end

func main:
    println json.Str("سلام دنیا")
    println json.Minify(`{"a": "سلام",   "b": [1, 2]}`)
    println json.Get(`{"a": "سلام", "b": "x"}`, "a")
    println str.ByteLen("سلام"), str.ByteSub("سلام دنیا", 9, 8)
    mut sb := str.NewBuilder()
    s := "یک 😀"
    p := (s as void*) as i8*
    repeat str.ByteLen(s) in i: str.BufAppendChar(sb, p[i] as int) end
    println str.BufStr(sb)
    str.BufFree(sb)
    println f32_bits(1.5 as f32), f32_bits(0.0 as f32 - 2.0 as f32)
end
