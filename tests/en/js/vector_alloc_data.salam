func fill(v &: Vector<f64>, n: int):
    p := v.data
    repeat n in i:
        p[i] = (i * i) as f64
    end
end

func main:
    mut v := Vector {} as Vector<f64>
    v.alloc(5)
    println v.len()
    fill(v, 5)
    p := v.data
    mut s := 0.0
    repeat 5 in i:
        s += p[i]
    end
    println s
    println v[4]
    mut w := Vector {} as Vector<int>
    w.zeros(3)
    println w[0], w[2]
end
