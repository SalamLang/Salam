struct Pos:
    pub x: int = 0
    pub y: int = 0
end

struct P:
    pub n: int = 0
    pub pos: Pos = Pos {}
    pub tags: Vector<int> = Vector {} as Vector<int>
    pub func Grow():
        this.n += 100
    end
end

struct World:
    pub items: Vector<P> = Vector {} as Vector<P>
end

func bump(n &: int):
    n += 10
end

func shift(p &: P):
    p.pos.x += 1000
end

func main:
    mut v := Vector {} as Vector<P>
    v.push(P {})
    v.push(P {})
    v[0].n = 5
    v[1].n += 3
    v[1].n += 1
    v[1].n++
    v[0].pos.x = 7
    v[0].pos.y -= 2
    i := 1
    v[i].pos.x = v[0].pos.x * 2
    bump(v[i].n)
    v[0].tags.push(42)
    println v[0].n, v[1].n, v[0].pos.x, v[0].pos.y, v[1].pos.x, v[0].tags.len()
    mut w := World {}
    w.items.push(P {})
    w.items[0].pos.y = 9
    w.items[0].n += 4
    println w.items[0].pos.y, w.items[0].n
    mut grid := Vector {} as Vector<Vector<P>>
    mut row := Vector {} as Vector<P>
    row.push(P {})
    grid.push(row)
    grid[0][0].n = 11
    println grid[0][0].n
    v[0].Grow()
    shift(v[1])
    mut nums := Vector {} as Vector<int>
    nums.push(1)
    bump(nums[0])
    println v[0].n, v[1].pos.x, nums[0]
end
