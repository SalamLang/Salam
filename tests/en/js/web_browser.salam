import web.browser

func reply(status: int, text: str):
    println status, " ", text
    browser.Request(
        "GET",
        "http://127.0.0.1:1/none",
        "",
        "",
        2000,
        (code: int, body: str):
        println code,
        " [",
        body,
        "]"
        browser.PostJson(
            "http://127.0.0.1:1/none",
            "{}",
            2000,
            (failed: int, answer: str):
            println failed,
            " ",
            answer.Len()
            browser.CopyText("salam", (done: bool): println done end)
            browser.CopyText("salam")
            end
        )
        end
    )
end

func main:
    println "[", browser.QueryParam("ref"), "]"
    browser.Get("data:text/plain,hello", 5000, (status: int, text: str): reply(status, text) end)
end
