// EXPECT: <h2>Hi there</h2>
component Card(title, body):
    box:
        class = "card"
        heading: size = 2 content = title end
        paragraph: content = "{body}!" end
    end
end
layout:
    Card: title = "Hi there" body = "World" end
end
