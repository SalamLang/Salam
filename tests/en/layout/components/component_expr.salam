// EXPECT: <p>Total: 14</p>
// EXPECT: <p>Total: 6</p>
component Total(n):
    paragraph: content = "Total: " + n * 2 end
end
layout:
    Total: n = 7 end
    Total: n = 1 + 2 end
end
