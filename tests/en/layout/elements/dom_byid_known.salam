// EXPECT: id="result"
// EXPECT: getElementById("result")
import dom

func onClick():
    dom.SetText(dom.ById("result"), "clicked")
end

layout:
    paragraph: id = "result" content = "hi" end
    button: click = onClick content = "Click" end
end
