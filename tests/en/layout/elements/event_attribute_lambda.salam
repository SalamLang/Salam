// EXPECT: onclick="__sl_ev_1()"
// EXPECT: function __sl_ev_1()
layout:
    button:
        click = ():
            mut n := 0
            if n == 0:
                print "rock"
            else:
                print "paper"
            end
            until n >= 3:
                n += 1
            end
        end
        content = "Go"
    end
end
