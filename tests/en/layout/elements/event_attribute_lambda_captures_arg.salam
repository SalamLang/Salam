// EXPECT: __sal_out(1, false, false);
// EXPECT: __sal_out(2, false, false);
component btn(n: i64):
    button:
        content = n
        click = ():
            print n
        end
    end
end

layout:
    btn: n = 1 end
    btn: n = 2 end
end
