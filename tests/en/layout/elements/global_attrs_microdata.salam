// EXPECT: itemscope
// EXPECT: itemtype="https://schema.org/Person"
// EXPECT: itemprop="name"
// EXPECT: autofocus
// EXPECT: translate="no"
layout:
    box:
        item scope = true
        item type = "https://schema.org/Person"
        span: item prop = "name" content = "Ali" translatable = "no" end
        input: type = "text" autofocus = true end
    end
end
