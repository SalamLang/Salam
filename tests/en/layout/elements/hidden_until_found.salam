// EXPECT: <div hidden>a</div>
// EXPECT: <div hidden="until-found">b</div>
// EXPECT-NOT: hidden="true"
// EXPECT-NOT: hidden="false"
layout:
    box: hidden = true content = "a" end
    box: hidden = "until-found" content = "b" end
    box: hidden = false content = "c" end
end
