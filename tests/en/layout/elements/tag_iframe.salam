// EXPECT: <iframe
// EXPECT:  srcdoc="x1"
// EXPECT:  allowfullscreen
// EXPECT:  loading="lazy"
// EXPECT:  referrerpolicy="no-referrer"
layout:
    iframe:
        srcdoc = "x1"
        allow fullscreen = true
        loading = "lazy"
        referrer policy = "no-referrer"
    end
end
