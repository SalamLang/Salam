// EXPECT: <input
// EXPECT:  accept="x1"
// EXPECT:  autocomplete="x1"
// EXPECT:  autofocus
// EXPECT:  dirname="t1"
// EXPECT:  form="target1"
// EXPECT:  formaction="/a.html"
// EXPECT:  formmethod="get"
// EXPECT:  formenctype="application/x-www-form-urlencoded"
// EXPECT:  formnovalidate
// EXPECT:  formtarget="_blank"
// EXPECT:  list="target1"
// EXPECT:  max="x1"
// EXPECT:  min="x1"
// EXPECT:  maxlength="2"
// EXPECT:  minlength="2"
// EXPECT:  multiple
// EXPECT:  pattern="x1"
// EXPECT:  readonly
// EXPECT:  size="2"
// EXPECT:  step="x1"
// EXPECT:  popovertarget="target1"
// EXPECT:  alpha
// EXPECT:  colorspace="limited-srgb"
// EXPECT:  src="/a.html"
// EXPECT:  alt="x1"
// EXPECT:  popovertargetaction="toggle"
layout:
    box: id = "target1" end
    input:
        type = "text"
        accept = "x1"
        autocomplete = "x1"
        autofocus = true
        dirname = "t1"
        form = "target1"
        form action = "/a.html"
        form method = "get"
        form enctype = "application/x-www-form-urlencoded"
        form novalidate = true
        form target = "_blank"
        list = "target1"
        max = "x1"
        min = "x1"
        maxlength = "2"
        minlength = "2"
        multiple = true
        pattern = "x1"
        readonly = true
        size = "2"
        step = "x1"
        popover target = "target1"
        alpha = true
        colorspace = "limited-srgb"
        url = "/a.html"
        alt = "x1"
        popover target action = "toggle"
    end
end
