// EXPECT: <a
// EXPECT:  href="/a.html"
// EXPECT:  download="x1"
// EXPECT:  rel="t1"
// EXPECT:  hreflang="en"
// EXPECT:  referrerpolicy="no-referrer"
// EXPECT:  ping="/a.html"
// EXPECT:  type="text/plain"
layout:
    link:
        url = "/a.html"
        download = "x1"
        rel = "t1"
        hreflang = "en"
        referrer policy = "no-referrer"
        ping = "/a.html"
        type = "text/plain"
        content = "hello"
    end
end
