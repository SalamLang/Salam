// EXPECT: <meter
// EXPECT:  value="0.5"
// EXPECT:  min="0.5"
// EXPECT:  max="0.5"
// EXPECT:  low="0.5"
// EXPECT:  high="0.5"
// EXPECT:  optimum="0.5"
layout:
    meter:
        value = "0.5"
        min = "0.5"
        max = "0.5"
        low = "0.5"
        high = "0.5"
        optimum = "0.5"
        content = "hello"
    end
end
