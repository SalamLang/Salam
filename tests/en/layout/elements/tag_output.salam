// EXPECT: <output
// EXPECT:  for="target1"
// EXPECT:  name="x1"
// EXPECT:  form="target1"
layout:
    box: id = "target1" end
    output:
        for = "target1"
        name = "x1"
        form = "target1"
        content = "hello"
    end
end
