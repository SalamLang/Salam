// EXPECT: <source
// EXPECT:  src="/a.html"
// EXPECT:  srcset="/a.png 1x, /b.png 2x"
// EXPECT:  sizes="x1"
// EXPECT:  type="text/plain"
// EXPECT:  media="(min-width: 600px)"
// EXPECT-NOT: />
layout:
    picture:
        source:
            url = "/a.html"
            srcset = "/a.png 1x, /b.png 2x"
            sizes = "x1"
            type = "text/plain"
            media = "(min-width: 600px)"
        end
    end
end
