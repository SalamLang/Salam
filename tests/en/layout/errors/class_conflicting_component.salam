// EXPECT: E136
// EXPECT-MSG: class 'tag' on 'span' has different styles
component Tag(label, tint):
    span: class = "tag" color = tint content = label end
end
layout:
    Tag: label = "new" tint = "green" end
    Tag: label = "old" tint = "gray" end
end
