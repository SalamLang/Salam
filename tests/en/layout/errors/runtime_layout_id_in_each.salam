// EXPECT: E134
// EXPECT-MSG: fixed id 'row'
layout Rows(xs: Vector<str>):
    each x in xs:
        box: id = "row" content = x end
    end
end

func main:
    xs := Vector {} as Vector<str>
    println Rows(xs)
end
