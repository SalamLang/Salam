// EXPECT: E012
// EXPECT-MSG: 'pure' function 'Lucky' cannot call 'IntN'
import rand

layout Lucky(name: str):
    paragraph: content = name + " got " + rand.IntN(10) end
end

func main:
    println Lucky("Ali")
end
