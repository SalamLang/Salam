// EXPECT: E012
// EXPECT-MSG: 'pure' function 'Names' cannot call 'pop'
layout Names(xs: Vector<str>):
    paragraph: content = "n=" + xs.len() + " last=" + xs.pop() end
end

func main:
    mut xs := Vector {} as Vector<str>
    xs.push("a")
    println Names(xs)
    xs.free()
end
