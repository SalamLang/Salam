// EXPECT: <div>7</div>
// EXPECT: <h2>Title</h2>
layout:
    box: content = 4 * 10 end
    box: content = (1 + 2) * 3 - 10 / 5 end
    heading: size = 10 / 5 content = "Title" end
end
