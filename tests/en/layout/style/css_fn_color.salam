// EXPECT: color: rgb(10 20 30 / 50%);
// EXPECT: background-color: rgba(10, 20, 30, 0.5);
// EXPECT: border-color: hsl(120deg 50% 50%);
// EXPECT: outline-color: oklch(70% 0.1 120);
// EXPECT: color: color(display-p3 1 0 0 / 0.8);
// EXPECT: background-color: color-mix(in oklch longer hue, red 30%, blue);
// EXPECT: border-color: light-dark(white, black);
// EXPECT: outline-color: rgb(from red r g calc(b * 2) / alpha);
layout:
    box:
        color = "rgb(10 20 30 / 50%)"
        background color = "rgba(10, 20, 30, 0.5)"
        border color = "hsl(120deg 50% 50%)"
        outline color = "oklch(70% 0.1 120)"
    end
    box:
        color = "color(display-p3 1 0 0 / 0.8)"
        background color = "color-mix(in oklch longer hue, red 30%, blue)"
        border color = "light-dark(white, black)"
        outline color = "rgb(from red r g calc(b * 2) / alpha)"
    end
end
