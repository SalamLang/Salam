// EXPECT: transition-timing-function: cubic-bezier(0.1, 0.7, 1, 0.1);
// EXPECT: animation-timing-function: steps(4, jump-end), linear(0, 0.25 75%, 1);
// EXPECT: grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
layout:
    box:
        transition timing function = "cubic-bezier(0.1, 0.7, 1, 0.1)"
        animation timing function = "steps(4, jump-end), linear(0, 0.25 75%, 1)"
        grid template columns = "repeat(auto-fill, minmax(100px, 1fr))"
    end
end
