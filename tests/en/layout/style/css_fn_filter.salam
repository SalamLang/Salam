// EXPECT: filter: blur(4px) brightness(1.2) drop-shadow(0 0 4px black) hue-rotate(90deg);
// EXPECT: backdrop-filter: grayscale(50%) blur();
layout:
    box:
        filter = "blur(4px) brightness(1.2) drop-shadow(0 0 4px black) hue-rotate(90deg)"
        backdrop filter = "grayscale(50%) blur()"
    end
end
