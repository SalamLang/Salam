// EXPECT: background-image: linear-gradient(to right, red, blue 50%);
// EXPECT: radial-gradient(circle at center, red, blue)
// EXPECT: conic-gradient(from 45deg at 50% 50%, red 0deg, blue 180deg)
// EXPECT: repeating-linear-gradient(45deg in oklch, red 0, blue 10px)
// EXPECT: image-set(url(a.png) 1x, url(b.png) 2x)
layout:
    box:
        background image = "linear-gradient(to right, red, blue 50%)"
    end
    box:
        background image = "radial-gradient(circle at center, red, blue)"
    end
    box:
        background image = "conic-gradient(from 45deg at 50% 50%, red 0deg, blue 180deg)"
    end
    box:
        background image = "repeating-linear-gradient(45deg in oklch, red 0, blue 10px)"
    end
    box:
        background image = "image-set(url(a.png) 1x, url(b.png) 2x)"
    end
end
