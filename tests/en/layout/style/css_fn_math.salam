// EXPECT: width: calc(100% - 20px);
// EXPECT: height: clamp(200px, 50%, 800px);
// EXPECT: min-width: min(100%, 600px);
// EXPECT: max-width: calc(2 * (10px + 1em));
// EXPECT: transform: rotate(calc(10deg * 2));
// EXPECT: opacity: calc(1 / 2);
// EXPECT: width: round(up, 33px, 10px);
// EXPECT: height: calc-size(auto, size + 20px);
// EXPECT: transform: rotate(atan2(1, 2));
// EXPECT: font-size: calc(pi * 1px);
layout:
    box:
        width = "calc(100%-20)"
        height = "clamp(200px, 50%, 800px)"
        min width = "min(100%, 600px)"
        max width = "calc(2 * (10px + 1em))"
        transform = "rotate(calc(10deg * 2))"
        opacity = "calc(1 / 2)"
    end
    box:
        width = "round(up, 33px, 10px)"
        height = "calc-size(auto, size + 20px)"
        transform = "rotate(atan2(1, 2))"
        font size = "calc(pi * 1px)"
    end
end
