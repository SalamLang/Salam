// EXPECT: width: min(10px, 100%);
// EXPECT: height: calc(+infinity * 1px);
// EXPECT: font: italic calc(1em + 2px) serif;
// EXPECT: min-width: var(--x, calc(1px + 2px));
layout:
    box:
        width = "min(10, 100%)"
        height = "calc(+infinity * 1px)"
        font = "italic calc(1em+2px) serif"
        min width = "var(--x, calc(1px+2px))"
    end
end
