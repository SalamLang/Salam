// EXPECT: clip-path: polygon(0px 0px, 100% 0px, 50% 100%);
// EXPECT: clip-path: circle(50% at 50% 50%);
// EXPECT: clip-path: inset(10px round 5px);
// EXPECT: shape-outside: ellipse(40% 30% at left);
layout:
    box:
        clip path = "polygon(0 0, 100% 0, 50% 100%)"
    end
    box:
        clip path = "circle(50% at 50% 50%)"
    end
    box:
        clip path = "inset(10px round 5px)"
        shape outside = "ellipse(40% 30% at left)"
    end
end
