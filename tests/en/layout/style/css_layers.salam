// EXPECT: background-image: url(a.png), linear-gradient(red, blue);
// EXPECT: background-size: cover, 10px 20px;
// EXPECT: background-repeat: no-repeat, repeat-x;
// EXPECT: background-position-x: left, 20px;
// EXPECT: background-clip: border-box, text;
layout:
    box:
        background image = "url(a.png), linear-gradient(red, blue)"
        background size = "cover, 10px 20px"
        background repeat = "no-repeat, repeat-x"
        background position x = "left, 20px"
        background clip = "border-box, text"
    end
end
