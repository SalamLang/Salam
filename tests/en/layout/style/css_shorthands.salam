// EXPECT: grid-template: "a b" 40px "c d" 1fr / 1fr 2fr;
// EXPECT: grid: auto-flow dense / 1fr 1fr;
// EXPECT: offset: path("M 0 0 H 100") 50% auto / left top;
// EXPECT: font-family: "Vazir", "B Nazanin", sans-serif;
layout:
    box:
        grid template = "\"a b\" 40px \"c d\" 1fr / 1fr 2fr"
        grid = "auto-flow dense / 1fr 1fr"
        offset = "path(\"M 0 0 H 100\") 50% auto / left top"
        font family = "\"Vazir\", B Nazanin, sans-serif"
    end
end
