// EXPECT: justify-content: space-between;
// EXPECT: background: linear-gradient(red, blue);
// EXPECT: transform: rotate(45deg);
// EXPECT: width: 10em;
layout:
    box:
        content = "x"
        display = flex
        justify content = space-between
        background = linear-gradient(red, blue)
        transform = rotate(45deg)
        width = 10em
    end
end
