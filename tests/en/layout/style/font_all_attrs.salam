// EXPECT: font-family: "Estedad"; src: url("https://editor.salamlang.ir/fonts/Estedad-Light.ttf") format("truetype"); font-weight: 300; font-style: italic; font-display: swap; unicode-range: U+0600-06FF, U+200C;
layout:
    font:
        name = "Estedad"
        url = "https://editor.salamlang.ir/fonts/Estedad-Light.ttf"
        weight = "300"
        style = italic
        display = swap
        range = "U+0600-06FF, U+200C"
    end
end
