// EXPECT: font-family: var(--font);
// EXPECT: font-family: var(--mono, monospace), "Courier New", monospace;
// EXPECT-NOT: "var(
layout:
    global: selector = "body" font family = "var(--font)" end
    box: font family = "var(--mono, monospace), Courier New, monospace" end
end
