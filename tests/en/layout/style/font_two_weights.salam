// EXPECT: src: url("https://cdn.example.com/Estedad-Light.woff2") format("woff2"); font-weight: 300;
// EXPECT: src: url("https://cdn.example.com/Estedad-Bold.woff2") format("woff2"); font-weight: 700;
// EXPECT: font-family: Estedad, sans-serif;
layout:
    font: name = "Estedad" url = "https://cdn.example.com/Estedad-Light.woff2" weight = "300" end
    font: name = "Estedad" url = "https://cdn.example.com/Estedad-Bold.woff2" weight = "700" end
    box:
        content = "hi"
        font family = "Estedad, sans-serif"
    end
end
