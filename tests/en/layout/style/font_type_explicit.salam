// EXPECT: url("https://cdn.example.com/font?id=7") format("opentype")
// EXPECT: font-weight: 100 900; font-style: italic;
// EXPECT: unicode-range: U+0600-06FF, U+200C;
layout:
    font:
        name = "My Font"
        url = "https://cdn.example.com/font?id=7"
        type = otf
        weight = "100 900"
        style = italic
        range = "U+0600-06FF, U+200C"
    end
end
