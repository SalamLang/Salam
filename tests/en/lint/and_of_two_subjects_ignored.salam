// EXPECT-WARNINGS: 0

func pick(a: int, b: int): int:
    if a >= 0 and b <= 9:
        ret 1
    end
    if a >= 10 and b <= 99:
        ret 2
    end
    if a >= 100 and b <= 999:
        ret 3
    end
    if a >= 1000 and b <= 9999:
        ret 4
    end
    ret 0
end

func main:
    println pick(5, 5)
end
