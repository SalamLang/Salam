// EXPECT-WARNINGS: 0

func pick(a: bool, b: bool, c: bool, d: bool): int:
    if a == true:
        ret 10
    end
    if b == true:
        ret 20
    end
    if c == true:
        ret 30
    end
    if d == true:
        ret 40
    end
    ret 0
end

func main:
    println pick(false, false, true, false)
end
