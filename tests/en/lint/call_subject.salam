// EXPECT-WARNINGS: 0

func pick(xs: Vector<int>): int:
    if xs.Len() == 1:
        ret 10
    end
    if xs.Len() == 2:
        ret 20
    end
    if xs.Len() == 3:
        ret 30
    end
    if xs.Len() == 4:
        ret 40
    end
    ret 0
end

func main:
    mut xs := Vector {} as Vector<int>
    xs.Push(1)
    xs.Push(2)
    println pick(xs)
end
