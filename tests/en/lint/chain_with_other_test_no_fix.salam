// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 0

func pick(x: int, y: int): int:
    mut r := 0
    if x == 1:
        r = 10
    else x == 2:
        r = 20
    else x == 3:
        r = 30
    else x == 4:
        r = 40
    else y > 0:
        r = 50
    end
    ret r
end

func main:
    println pick(3, 0)
end
