// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

const KIND_A := 1
const KIND_B := 2
const KIND_C := 3
const KIND_D := 0 - 1

func pick(kind: int): int:
    if kind == KIND_A:
        ret 10
    end
    if KIND_B == kind:
        ret 20
    end
    if kind == KIND_C or kind == 9:
        ret 30
    end
    if kind == KIND_D:
        ret 40
    end
    ret 0
end

func main:
    println pick(3)
end
