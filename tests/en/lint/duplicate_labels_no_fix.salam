// EXPECT-WARNINGS: 2
// EXPECT-FIXES: 0

const SAME_A := 5
const SAME_B := 5

func by_literal(x: int): int:
    if x == 1:
        ret 10
    end
    if x == 2:
        ret 20
    end
    if x == 1:
        ret 30
    end
    if x == 4:
        ret 40
    end
    ret 0
end

func by_const(x: int): int:
    if x == SAME_A:
        ret 10
    end
    if x == 2:
        ret 20
    end
    if x == SAME_B:
        ret 30
    end
    if x == 4:
        ret 40
    end
    ret 0
end

func main:
    println by_literal(1), by_const(5)
end
