// EXPECT-WARNINGS: 0

enum Color:
    Red,
    Green
end

enum Shape:
    Round,
    Flat
end

func pick(c: Color, s: Shape): int:
    if c == Color.Red:
        ret 1
    end
    if s == Shape.Round:
        ret 2
    end
    if c == Color.Green:
        ret 3
    end
    if s == Shape.Flat:
        ret 4
    end
    ret 0
end

func main:
    println pick(Color.Red, Shape.Flat)
end
