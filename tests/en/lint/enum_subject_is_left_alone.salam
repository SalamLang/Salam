// EXPECT-WARNINGS: 0

enum Color:
    Red,
    Green,
    Blue,
    Black
end

func pick(c: Color): int:
    if c == Color.Red:
        ret 1
    end
    if c == Color.Green:
        ret 2
    end
    if c == Color.Blue:
        ret 3
    end
    if c == Color.Black:
        ret 4
    end
    ret 0
end

func main:
    println pick(Color.Blue)
end
