// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

enum Color:
    Red,
    Green,
    Blue,
    Black,
    White
end

func pick(c: Color): int:
    mut r := 0
    if c == Color.Red:
        r = 1
    else c == Color.Green:
        r = 2
    else c == Color.Blue:
        r = 3
    else c == Color.Black:
        r = 4
    else:
        r = 5
    end
    ret r
end

func main:
    println pick(Color.Blue)
end
