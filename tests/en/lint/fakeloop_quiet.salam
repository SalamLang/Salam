// EXPECT: ok
// EXPECT-EXIT: 0
mut g_stop := false

struct Job:
    pub stop: bool = false
end

func spin_param(flag &: bool, n &: int):
    until not flag:
        n++
        if n > 3:
            flag = true
        end
    end
end

func wait_global(n &: int):
    until not g_stop:
        n++
        if n > 2:
            g_stop = true
        end
    end
end

func wait_field(j &: Job, n &: int):
    until not j.stop:
        n++
        j.stop = n > 2
    end
end

func with_break(): int:
    mut n := 0
    until true:
        n++
        if n > 4:
            break
        end
    end
    ret n
end

func with_ret(): int:
    mut n := 0
    until true:
        n++
        if n > 6:
            ret n
        end
    end
end

func flag_in_body(): int:
    mut go := true
    mut n := 0
    until go:
        n++
        if n > 5:
            go = false
        end
    end
    ret n
end

func flag_by_call(): int:
    mut go := true
    mut n := 0
    until go:
        n++
        finish_local(go)
    end
    ret n
end

func finish_local(flag &: bool):
    flag = false
end

func flag_by_lambda(limit: int): int:
    mut go := true
    mut n := 0
    stop := ():
        go = false
    end
    until go:
        n++
        if n > limit:
            stop()
        end
    end
    ret n
end

func counted(): int:
    mut i := 0
    mut total := 0
    until i < 4:
        total += i
        i++
    end
    ret total
end

func nested_pass(): int:
    mut hits := 0
    mut round := 0
    until round < 3:
        mut inner := round == 0
        until inner:
            hits++
            inner = false
        end
        round++
    end
    ret hits
end

func late_flag(): int:
    mut stale := false
    mut round := 0
    mut n := 0
    until round < 3:
        until stale:
            n++
            break
        end
        stale = true
        round++
    end
    ret n
end

func server_style(): int:
    mut n := 0
    until true:
        n = next_value(n)
        if n > 2:
            ret n
        end
    end
end

func next_value(n: int): int:
    ret n + 1
end

func main:
    mut stop := false
    mut a := 0
    wait_global(a)
    spin_param(stop, a)
    mut j := Job {}
    j.stop = false
    wait_field(j, a)
    println with_break(), with_ret(), counted(), nested_pass(), late_flag(), server_style()
    println flag_in_body(), flag_by_call()
    if a < 0:
        println flag_by_lambda(1)
    end
    println "ok"
end
