func pick(c: char): int:
    switch c:
        'a':
            ret 1
        end
        'b', 'B':
            ret 2
        end
        'c':
            ret 3
        end
        'd':
            ret 4
        end
    end
    ret 0
end

func main:
    println pick('a'), pick('B'), pick('c'), pick('d'), pick('z')
end
