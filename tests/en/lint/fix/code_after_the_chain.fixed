func pick(x: int): int:
    mut r := 0
    switch x:
        1:
            r = 10
            break
        end
        2:
            r = 20
            break
        end
        3:
            r = 30
            break
        end
        4:
            r = 40
        end
    end
    r += 1000
    ret r
end

func main:
    println pick(1), pick(2), pick(3), pick(4), pick(5)
end
