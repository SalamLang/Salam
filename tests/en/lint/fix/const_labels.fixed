const KIND_A := 1
const KIND_B := 2
const KIND_C := 3
const KIND_D := 0 - 1

func pick(kind: int): int:
    switch kind:
        KIND_A:
            ret 10
        end
        KIND_B:
            ret 20
        end
        KIND_C, 9:
            ret 30
        end
        KIND_D:
            ret 40
        end
    end
    ret 0
end

func main:
    println pick(1), pick(2), pick(3), pick(9), pick(0 - 1), pick(7)
end
