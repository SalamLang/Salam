func pick(x: int): int:
    mut r := 0
    switch x:
        1:
            r = 10
            break
        end
        2:
            r = 20
            r += 1
            break
        end
        3, 4:
            r = 30
            break
        end
        5:
            r = 50
            break
        end
        else:
            r = 99
        end
    end
    ret r + 1
end

func main:
    println pick(1), pick(2), pick(3), pick(4), pick(5), pick(6)
end
