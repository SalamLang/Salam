func pick(x: int): int:
    mut r := 0
    if x == 1:
        r = 10
    else x == 2:
        r = 20
        r += 1
    else x == 3 or x == 4:
        r = 30
    else x == 5:
        r = 50
    else:
        r = 99
    end
    ret r + 1
end

func main:
    println pick(1), pick(2), pick(3), pick(4), pick(5), pick(6)
end
