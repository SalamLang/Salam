enum Level:
    Low,
    Mid,
    High,
    Top
end

func name(l: Level): str:
    switch l:
        Level.Low:
            ret "low"
        end
        Level.Mid:
            ret "mid"
        end
        Level.High:
            ret "high"
        end
        Level.Top:
            ret "top"
        end
    end
    ret "?"
end

func main:
    println name(Level.Low), name(Level.Mid), name(Level.High), name(Level.Top)
end
