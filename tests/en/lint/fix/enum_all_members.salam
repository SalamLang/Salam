enum Level:
    Low,
    Mid,
    High,
    Top
end

func name(l: Level): str:
    if l == Level.Low:
        ret "low"
    end
    if l == Level.Mid:
        ret "mid"
    end
    if l == Level.High:
        ret "high"
    end
    if l == Level.Top:
        ret "top"
    end
    ret "?"
end

func main:
    println name(Level.Low), name(Level.Mid), name(Level.High), name(Level.Top)
end
