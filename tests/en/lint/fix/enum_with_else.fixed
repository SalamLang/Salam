enum Color:
    Red,
    Green,
    Blue,
    Black,
    White
end

func pick(c: Color): int:
    mut r := 0
    switch c:
        Color.Red:
            r = 1
            break
        end
        Color.Green:
            r = 2
            break
        end
        Color.Blue:
            r = 3
            break
        end
        Color.Black:
            r = 4
            break
        end
        else:
            r = 9
        end
    end
    ret r
end

func main:
    println pick(Color.Red), pick(Color.Green), pick(Color.Blue), pick(Color.Black), pick(Color.White)
end
