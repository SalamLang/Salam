func grade(score: int): str:
    mut g := "F"
    if score >= 90:
        g = "A"
    else score >= 80:
        g = "B"
    else score >= 70:
        g = "C"
    else score >= 60:
        g = "D"
    end
    ret g
end

func main:
    println grade(100), grade(90), grade(89), grade(80), grade(79), grade(70), grade(60), grade(59), grade(0)
end
