func pick(xs: Vector<int>): int:
    mut n := 0
    each v in xs:
        if v == 1:
            n += 1
            continue
        end
        if v == 2:
            n += 2
            continue
        end
        if v == 3:
            n += 3
            continue
        end
        if v == 4:
            n += 4
            continue
        end
        n += 100
    end
    ret n
end

func main:
    mut xs := Vector {} as Vector<int>
    xs.push(1)
    xs.push(4)
    xs.push(9)
    xs.push(2)
    println pick(xs)
end
