func pick(fl: i64): int:
    switch (fl & (3 as i64)):
        0 as i64:
            ret 1
        end
        1 as i64:
            ret 2
        end
        2 as i64:
            ret 3
        end
        3 as i64:
            ret 4
        end
    end
    ret 0
end

func pick_cast(k: u8): int:
    switch (k as int):
        1:
            ret 10
        end
        2:
            ret 20
        end
        3:
            ret 30
        end
        4:
            ret 40
        end
    end
    ret 0
end

func main:
    println pick(4 as i64), pick(5 as i64), pick(6 as i64), pick(7 as i64)
    println pick_cast(1 as u8), pick_cast(4 as u8), pick_cast(9 as u8)
end
