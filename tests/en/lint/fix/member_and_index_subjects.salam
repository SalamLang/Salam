struct Item:
    pub kind: int = 0
    pub tags: Vector<int> = Vector {}
end

func by_field(it: Item): int:
    if it.kind == 1:
        ret 10
    end
    if it.kind == 2:
        ret 20
    end
    if it.kind == 3:
        ret 30
    end
    if it.kind == 4:
        ret 40
    end
    ret 0
end

func by_index(it &: Item, i: int): int:
    if it.tags[i] == 1:
        ret 10
    end
    if it.tags[i] == 2:
        ret 20
    end
    if it.tags[i] == 3:
        ret 30
    end
    if it.tags[i] == 4:
        ret 40
    end
    ret 0
end

func main:
    mut it := Item {}
    it.kind = 2
    it.tags.push(3)
    it.tags.push(4)
    println by_field(it), by_index(it, 0), by_index(it, 1)
end
