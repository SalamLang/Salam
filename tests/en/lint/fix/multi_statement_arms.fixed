func pick(x: int): int:
    mut total := 0
    switch x:
        1:
            total += 1

            total += 2
            ret total
        end
        2:
            repeat 4 in i:
                if i == 2:
                    continue
                end
                total += i
            end
            ret total
        end
        3:
            ret 300
        end
        4:
            defer println "deferred"
            ret 400
        end
    end
    ret 0
end

func main:
    println pick(1), pick(2), pick(3), pick(4), pick(5)
end
