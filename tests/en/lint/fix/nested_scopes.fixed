func pick(xs: Vector<int>, y: int): int:
    mut n := 0
    each v in xs:
        if y > 0:
            switch v:
                1:
                    n += 1
                    break
                end
                2:
                    n += 2
                    break
                end
                3:
                    n += 3
                    break
                end
                4:
                    n += 4
                end
            end
        end
    end
    f := (z: int):
        switch z:
            1:
                ret 10
            end
            2:
                ret 20
            end
            3:
                ret 30
            end
            4:
                ret 40
            end
        end
        ret 0
    end
    switch y:
        1:
            ret n + f(y)
        end
        2:
            ret n + f(y)
        end
        3:
            ret n + f(y)
        end
        4:
            ret n + f(y)
        end
    end
    ret n
end

func main:
    mut xs := Vector {} as Vector<int>
    xs.push(2)
    xs.push(3)
    xs.push(9)
    println pick(xs, 1), pick(xs, 3), pick(xs, 4), pick(xs, 0)
end
