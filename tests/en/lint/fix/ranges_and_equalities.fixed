func size(n: int): int:
    switch n:
        0 to 9:
            ret 1
        end
        10 to 99:
            ret 2
        end
        100 to 999:
            ret 3
        end
        1000, 2000:
            ret 4
        end
    end
    ret 0
end

func main:
    println size(0), size(9), size(10), size(99), size(100), size(999), size(1000), size(2000), size(1500), size(0 - 1)
end
