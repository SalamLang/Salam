func size(n: int): int:
    if n >= 0 and n <= 9:
        ret 1
    end
    if 10 <= n and n <= 99:
        ret 2
    end
    if n <= 999 and n >= 100:
        ret 3
    end
    if n == 1000 or n == 2000:
        ret 4
    end
    ret 0
end

func main:
    println size(0), size(9), size(10), size(99), size(100), size(999), size(1000), size(2000), size(1500), size(0 - 1)
end
