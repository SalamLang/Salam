func band(x: int): int:
    switch x:
        > 100:
            ret 4
        end
        > 50:
            ret 3
        end
        >= 10:
            ret 2
        end
        >= 0:
            ret 1
        end
    end
    ret 0
end

func main:
    println band(500), band(101), band(100), band(51), band(50), band(10), band(9), band(0), band(0 - 4)
end
