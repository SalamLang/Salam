func pick(ty: int): int:
    switch ty:
        7:
            ret 1
        end
        8:
            ret 2
        end
        9, 12:
            ret 3
        end
        11:
            ret 4
        end
    end
    ret 0
end

func main:
    println pick(7), pick(8), pick(9), pick(12), pick(11), pick(5)
end
