import str

func pick(s: str): int:
    if str.Equals(s, "red"):
        ret 1
    end
    if str.Equals(s, "green") or str.Equals("lime", s):
        ret 2
    end
    if s == "blue":
        ret 3
    end
    if str.Equals(s, "cyan"):
        ret 4
    end
    ret 0
end

func main:
    println pick("red"), pick("lime"), pick("green"), pick("blue"), pick("cyan"), pick("pink")
end
