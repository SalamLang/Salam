import str

func pick(s: str): int:
    switch s:
        "red":
            ret 1
        end
        "green":
            ret 2
        end
        "blue":
            ret 3
        end
        "cyan":
            ret 4
        end
    end
    ret str.Len(s)
end

func main:
    println pick("red"), pick("cyan"), pick("pink")
end
