import str

func pick(s: str): int:
    if str.Equals(s, "red"):
        ret 1
    end
    if str.Equals(s, "green"):
        ret 2
    end
    if str.Equals(s, "blue"):
        ret 3
    end
    if str.Equals(s, "cyan"):
        ret 4
    end
    ret str.Len(s)
end

func main:
    println pick("red"), pick("cyan"), pick("pink")
end
