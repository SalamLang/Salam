func pick(s: str): int:
    switch s:
        "red":
            ret 1
        end
        "green", "lime":
            ret 2
        end
        "blue":
            ret 3
        end
        "cyan":
            ret 4
        end
    end
    ret 0
end

func main:
    println pick("red"), pick("lime"), pick("green"), pick("cyan"), pick("pink")
end
