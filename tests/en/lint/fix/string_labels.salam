func pick(s: str): int:
    if s == "red":
        ret 1
    end
    if s == "green" or s == "lime":
        ret 2
    end
    if s == "blue":
        ret 3
    end
    if s == "cyan":
        ret 4
    end
    ret 0
end

func main:
    println pick("red"), pick("lime"), pick("green"), pick("cyan"), pick("pink")
end
