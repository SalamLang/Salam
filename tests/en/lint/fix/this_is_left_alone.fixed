struct Counter:
    pub n: int = 0
    pub func Name(k: int): str:
        switch k:
            1:
                ret "one"
            end
            2:
                ret "two"
            end
            3:
                ret "three"
            end
            4:
                ret "four"
            end
        end
        ret "many"
    end
    pub func Bump(): int:
        this.n += 1
        ret this.n
    end
end

func main:
    mut c := Counter {}
    println c.Name(2), c.Name(9), c.Bump(), c.Bump()
end
