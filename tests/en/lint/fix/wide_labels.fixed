const SHT_NULL := 0
const SHT_LOUSER := 0x80000000
const NEG := 0 - 5

func kind(ty: i64): int:
    switch ty:
        7 as i64:
            ret 1
        end
        0x70000001 as i64:
            ret 2
        end
        NEG as i64, SHT_NULL as i64:
            ret 3
        end
        SHT_LOUSER:
            ret 4
        end
    end
    ret 0
end

func big(v: u32): int:
    switch v:
        0x7FFFFFFF:
            ret 1
        end
        4000000000:
            ret 2
        end
        255:
            ret 3
        end
        0:
            ret 4
        end
    end
    ret 5
end

func main:
    println kind(7 as i64), kind(0x70000001 as i64), kind(0 as i64), kind(0x80000000 as i64), kind(9 as i64)
    println big(0x7FFFFFFF as u32), big(4000000000 as u32), big(255 as u32), big(0 as u32), big(1 as u32)
end
