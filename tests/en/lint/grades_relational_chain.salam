// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

func grade(score: int): str:
    mut g := "F"
    if score >= 90:
        g = "A"
    else score >= 80:
        g = "B"
    else score >= 70:
        g = "C"
    else score >= 60:
        g = "D"
    end
    ret g
end

func main:
    println grade(95), grade(85), grade(72), grade(61), grade(10)
end
