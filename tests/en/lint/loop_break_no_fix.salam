// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 0

func pick(xs: Vector<int>): int:
    mut n := 0
    each v in xs:
        if v == 1:
            n++
            continue
        end
        if v == 2:
            n += 2
            continue
        end
        if v == 3:
            n += 3
            continue
        end
        if v == 4:
            break
        end
        n += 100
    end
    ret n
end

func main:
    mut xs := Vector {} as Vector<int>
    xs.Push(1)
    xs.Push(4)
    println pick(xs)
end
