// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

func pick(fl: i64): int:
    if (fl & (3 as i64)) == (0 as i64):
        ret 1
    end
    if (fl & (3 as i64)) == (1 as i64):
        ret 2
    end
    if (fl & (3 as i64)) == (2 as i64):
        ret 3
    end
    if (fl & (3 as i64)) == (3 as i64):
        ret 4
    end
    ret 0
end

func main:
    println pick(6 as i64)
end
