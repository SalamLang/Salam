// EXPECT-WARNINGS: 0

import str

func starts(s: str, p: str): bool:
    ret str.StartsWith(s, p)
end

func pick(ty: int, name: str): int:
    if ty == 1 or starts(name, "a"):
        ret 10
    end
    if ty == 2 or starts(name, "b"):
        ret 20
    end
    if ty == 3 or starts(name, "c"):
        ret 30
    end
    if ty == 4 or starts(name, "d"):
        ret 40
    end
    ret 0
end

func main:
    println pick(3, "z")
end
