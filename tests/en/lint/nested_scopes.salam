// EXPECT-WARNINGS: 3
// EXPECT-FIXES: 3

func pick(xs: Vector<int>, y: int): int:
    mut n := 0
    each v in xs:
        if y > 0:
            if v == 1:
                n += 1
            else v == 2:
                n += 2
            else v == 3:
                n += 3
            else v == 4:
                n += 4
            end
        end
    end
    f := (z: int):
        if z == 1:
            ret 10
        end
        if z == 2:
            ret 20
        end
        if z == 3:
            ret 30
        end
        if z == 4:
            ret 40
        end
        ret 0
    end
    if y == 1:
        ret n + f(y)
    end
    if y == 2:
        ret n + 2
    end
    if y == 3:
        ret n + 3
    end
    if y == 4:
        ret n + 4
    end
    ret n
end

func main:
    mut xs := Vector {} as Vector<int>
    xs.push(2)
    println pick(xs, 1)
end
