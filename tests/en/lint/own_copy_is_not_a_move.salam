// EXPECT-CODE: 163
// EXPECT-WARNINGS: 1
// EXPECT-MSG: 'shared' is used after its buffer was moved
// EXPECT-NOT: 'nums' is used after
// EXPECT-NOT: 'names' is used after
// EXPECT-NOT: 'ages' is used after
// EXPECT-NOT: 'tags' is used after
func main:
    mut nums := Vector {} as Vector<int>
    nums.push(1)
    a := nums.copy()
    nums.push(2)
    println a.Len(), nums.Len()

    mut names := Vector {} as Vector<str>
    names.push("x")
    b := names.deep_copy()
    names.push("y")
    println b.Len(), names.Len()

    mut ages := HashMap {} as HashMap<str, int>
    ages.put("x", 1)
    c := ages.copy()
    ages.put("y", 2)
    println c.size(), ages.size()

    mut tags := HashMap {} as HashMap<str, str>
    tags.put("x", "1")
    d := tags.deep_copy()
    tags.put("y", "2")
    println d.size(), tags.size()

    mut shared := Vector {} as Vector<int>
    shared.push(1)
    e := shared
    shared.push(2)
    println e.Len(), shared.Len()
end
