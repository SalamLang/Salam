// EXPECT-CODE: 143
// EXPECT-WARNINGS: 0
// EXPECT-NOT: W142
func main:
    mut names := Vector {} as Vector<str>
    names.Push("a")
    names.Free()
    println names.Len()

    mut seen := HashMap {} as HashMap<str, int>
    defer seen.Free()
    seen.Put("a", 1)
    println seen.Size()
    seen.Free()
end
