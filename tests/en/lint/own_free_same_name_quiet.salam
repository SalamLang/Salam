// EXPECT-CODE: 143
// EXPECT-WARNINGS: 0
// EXPECT-NOT: W142
func main:
    mut names := Vector {} as Vector<str>
    names.push("a")
    names.free()
    println names.Len()

    mut seen := HashMap {} as HashMap<str, int>
    defer seen.free()
    seen.put("a", 1)
    println seen.size()
    seen.free()
end
