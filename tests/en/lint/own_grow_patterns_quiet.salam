// EXPECT-CODE: 144
// EXPECT-WARNINGS: 0
struct G:
    pub op: Vector<int> = Vector {}
    pub vk: Vector<int> = Vector {}
    pub src: Vector<int> = Vector {}
end

func grow(g &: G, v: int):
    g.vk.push(v)
end

func each_field(g &: G):
    each b in g.src:
        g.op.push(b)
        grow(g, b)
    end
    g.op.push(0)
end

func branch_then_ref(n: int): int:
    mut c := G {}
    if n > 2:
        c.op.push(n)
        grow(c, n)
    end
    t := c.op.Len() + c.vk.Len()
    c.op.free()
    c.vk.free()
    c.src.free()
    ret t
end

func main:
    mut g := G {}
    g.src.push(3)
    each_field(g)
    println g.op.Len(), branch_then_ref(5)
end
