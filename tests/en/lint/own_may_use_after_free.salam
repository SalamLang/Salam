// ARGS: --ownership=on
// EXPECT-CODE: 142
// EXPECT-WARNINGS: 1
// EXPECT-MSG: 's' may be used after its storage was freed on line 25 (on some paths)
import mem
import str

func main:
    s := "a" + str.FromInt(1)
    if s.Len() > 1:
        mem.Free(s as void*)
    end
    println s
end
