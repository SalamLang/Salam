// EXPECT-WARNINGS: 1
// EXPECT-MSG: 'p' points into storage that the call on line 22 may have moved
func main:
    mut v := Vector {} as Vector<int>
    v.Push(1)
    p := v.Ref(0)
    v.Push(2)
    println p[0]
    v.Free()
end
