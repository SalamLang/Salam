// EXPECT-CODE: 142
// EXPECT-WARNINGS: 0
func drop_all(v &: Vector<int>):
    v.Free()
end

func read(bad: bool): Vector<int>:
    mut row := Vector {} as Vector<int>
    row.Push(1)
    if bad:
        drop_all(row)
    end
    ret row
end

func main:
    r := read(true)
    println r.Len()
end
