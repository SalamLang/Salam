// EXPECT-WARNINGS: 0

func size(n: int): int:
    if n >= 0 and n <= 9:
        ret 1
    end
    if n >= 99 and n <= 10:
        ret 2
    end
    if n >= 100 and n <= 999:
        ret 3
    end
    if n >= 1000 and n <= 9999:
        ret 4
    end
    ret 0
end

func main:
    println size(5), size(50), size(500)
end
