// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

func size(n: int): int:
    if n >= 0 and n <= 9:
        ret 1
    end
    if 10 <= n and n <= 99:
        ret 2
    end
    if n <= 999 and n >= 100:
        ret 3
    end
    if n == 1000 or n == 2000:
        ret 4
    end
    ret 0
end

func main:
    println size(5), size(50), size(500), size(2000), size(70000)
end
