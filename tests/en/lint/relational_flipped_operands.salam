// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

func band(x: int): int:
    if 100 < x:
        ret 4
    end
    if 50 < x:
        ret 3
    end
    if 10 <= x:
        ret 2
    end
    if 0 <= x:
        ret 1
    end
    ret 0
end

func main:
    println band(500), band(60), band(10), band(3), band(0 - 4)
end
