// EXPECT-WARNINGS: 0

func by_float(f: f64): int:
    if f < 1.0:
        ret 1
    end
    if f < 2.0:
        ret 2
    end
    if f < 3.0:
        ret 3
    end
    if f < 4.0:
        ret 4
    end
    ret 0
end

func by_text(s: str): int:
    if s < "d":
        ret 1
    end
    if s < "h":
        ret 2
    end
    if s < "m":
        ret 3
    end
    if s < "s":
        ret 4
    end
    ret 0
end

func main:
    println by_float(2.5), by_text("k")
end
