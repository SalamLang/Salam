// ARGS: --switch-lint=warn --switch-lint-min=2
// EXPECT-WARNINGS: 2
// EXPECT-FIXES: 2

func pick(x: int, y: int): int:
    if x == 1:
        ret 10
    end
    if x == 2:
        ret 20
    end
    if y > 0:
        ret 99
    end
    if x == 3:
        ret 30
    end
    if x == 4:
        ret 40
    end
    ret 0
end

func main:
    println pick(4, 0)
end
