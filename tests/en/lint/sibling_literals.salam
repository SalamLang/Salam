// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1
// EXPECT-MSG: 4 consecutive comparisons of 'x' against constants could be a switch
// EXPECT-MSG: group them as 'switch x:' with one label per constant

func pick(x: int): int:
    if x == 1:
        ret 10
    end
    if x == 2:
        ret 20
    end
    if x == 3:
        ret 30
    end
    if x == 4:
        ret 40
    end
    ret 0
end

func main:
    println pick(3)
end
