// ARGS: --switch-lint=warn --switch-lint-min=3
// EXPECT-WARNINGS: 0

func pick(x: int): int:
    if x == 1:
        ret 10
    end
    if x == 2:
        ret 20
    end
    println "between"
    if x == 3:
        ret 30
    end
    if x == 4:
        ret 40
    end
    ret 0
end

func main:
    println pick(4)
end
