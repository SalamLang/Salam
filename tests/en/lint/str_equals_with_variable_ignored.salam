// EXPECT-WARNINGS: 0

import str

func pick(a: str, b: str): int:
    if str.Equals(a, b):
        ret 1
    end
    if str.Equals(a, "x"):
        ret 2
    end
    if str.Equals(b, "y"):
        ret 3
    end
    if str.Equals(a, b + "!"):
        ret 4
    end
    ret 0
end

func main:
    println pick("a", "b")
end
