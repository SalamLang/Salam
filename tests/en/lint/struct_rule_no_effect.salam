// ARGS: --log-level=warn
// EXPECT-CODE: 159
// EXPECT-WARNINGS: 2
// EXPECT-MSG: this rule can never fail, so it has no effect
struct S:
    pub a: int = 0
    pub b: int
    pub c: int = 0
    pub d: int = 0
    rule a needs b
    rule anyof(b, c)
    rule atmostone(c, d)
end

func main:
    println S { b = 1 }.b
end
