// EXPECT-CODE: 234
// EXPECT-WARNINGS: 2
// EXPECT-FIXES: 2
// EXPECT-MSG: 'throws' is deprecated, use 'throw'

func half(n: int): int throws:
    if n % 2 != 0:
        throw "odd: " + n
    end
    ret n / 2
end

func check(n: int) throws:
    if n < 0:
        throw "negative"
    end
end

func main throws:
    println try half(8)
    println try half(3) catch 0
    try:
        check(0 - 1)
    catch e:
        println e.message
    end
end
