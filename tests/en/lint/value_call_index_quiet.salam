// ARGS: --range-checks=on
// EXPECT-CODE: 146
// EXPECT-WARNINGS: 0
func get_or(xs: int[], i: int, d: int): int:
    if i < 0 or i >= xs.len():
        ret d
    end
    ret xs[i]
end

func first(xs: int[], i: int): int:
    mut j := i
    j = 0
    ret xs[j]
end

func main:
    a := [1, 2, 3, 4]
    println get_or(a, 9, 0), first(a, 7)
end
