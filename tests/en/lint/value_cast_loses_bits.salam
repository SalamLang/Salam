// ARGS: --range-checks=on
// EXPECT-CODE: 154
// EXPECT-WARNINGS: 1
// EXPECT-MSG: 300 does not fit in 'u8'; the cast keeps only the low 8 bits, giving 44
func main:
    x := 300 as u8
    println x
end
