// ARGS: --range-checks=on
// EXPECT-CODE: 147
// EXPECT-WARNINGS: 0
struct Node:
    pub key: int = 0
    pub next: Node* = null
end

func find(xs: int[], k: int): int:
    repeat xs.Len() in i:
        if xs[i] == k:
            ret i
        end
    end
    ret -1
end

func at_or(xs: int[], i: int, d: int): int:
    if i < 0 or i >= xs.Len():
        ret d
    end
    ret xs[i]
end

func walk(head: Node*): int:
    mut n := 0
    mut cur := head
    until cur != null:
        n += cur.key
        cur = cur.next
    end
    ret n
end

func last_of(v: Vector<int>): int:
    if v.Len() == 0:
        ret 0
    end
    ret v[v.Len() - 1]
end

func pairs(xs: int[]): int:
    mut t := 0
    each i, x in xs:
        if i + 1 < xs.Len():
            t += x * xs[i + 1]
        end
        if i > 0:
            t += xs[i - 1]
        end
    end
    ret t
end

func rev(xs: int[]): int:
    mut j := xs.Len() - 1
    mut t := 0
    until j >= 0:
        t += xs[j]
        j--
    end
    ret t
end

func avg(xs: int[]): int:
    n := xs.Len()
    if n == 0:
        ret 0
    end
    mut t := 0
    each x in xs:
        t += x
    end
    ret t / n
end

func fact64(): i64:
    mut f := 1 as i64
    repeat 1 to 20 in i:
        f *= (i as i64)
    end
    ret f
end

func main:
    a := [5, 6, 7, 8]
    println find(a, 7), at_or(a, 9, 0), pairs(a), rev(a), avg(a), fact64()
    mut v := Vector {} as Vector<int>
    v.push(3)
    println last_of(v), walk(null)
end
