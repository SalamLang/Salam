// ARGS: --range-checks=on
// EXPECT-CODE: 158
// EXPECT-WARNINGS: 1
// EXPECT-MSG: the memory 'buf' gets from mem.Allocate on line 22 is never freed
import mem

func lost(): int:
    buf := mem.Allocate(64 as u64) as u8*
    buf[0] = 7 as u8
    ret buf[0] as int
end

func kept(): u8*:
    out := mem.Allocate(8 as u64) as u8*
    out[0] = 1 as u8
    ret out
end

func freed(): int:
    tmp := mem.Allocate(8 as u64) as u8*
    defer mem.Free(tmp as void*)
    tmp[0] = 2 as u8
    ret tmp[0] as int
end

func main:
    k := kept()
    println lost(), freed(), k[0]
    mem.Free(k as void*)
end
