// ARGS: --range-checks=on
// EXPECT-CODE: 147
// EXPECT-WARNINGS: 1
// EXPECT-MSG: index may be out of bounds: 'i' can be 3, but 'xs' has 3 elements
func main:
    xs := [1, 2, 3]
    mut i := 0
    until i <= xs.len():
        println xs[i]
        i++
    end
end
