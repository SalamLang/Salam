// ARGS: --range-checks=on
// EXPECT-CODE: 153
// EXPECT-WARNINGS: 1
// EXPECT-MSG: 'best' may be null here: it is still null on some paths
struct Item:
    pub score: int = 0
end

func pick(items: Vector<Item*>): int:
    mut best := null as Item*
    each it in items:
        if best == null or it.score > best.score:
            best = it
        end
    end
    ret best.score
end

func main:
    v := Vector {} as Vector<Item*>
    println pick(v)
end
