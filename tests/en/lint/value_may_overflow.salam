// ARGS: --range-checks=on
// EXPECT-CODE: 149
// EXPECT-WARNINGS: 1
// EXPECT-MSG: possible integer overflow: 'n * 1000000' can reach 5000000000, which does not fit in 'i32'
func scale(n: int): int:
    if n < 0 or n > 5000:
        ret 0
    end
    ret n * 1000000
end

func main:
    println scale(3)
end
