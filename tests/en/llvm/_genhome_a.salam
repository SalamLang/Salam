package genhomea

pub struct Gauge:
    pub level: int = 0
end

func _describe(g: Gauge): str:
    ret "gauge " + g.level
end

pub func Ok(g: Gauge): bool:
    ret g.level > 0
end

pub func Show(g: Gauge): str:
    ret _describe(g)
end
