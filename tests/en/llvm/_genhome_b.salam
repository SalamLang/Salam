package genhomeb

pub struct Status:
    pub code: str = ""
end

func _describe(s: Status): str:
    ret "status " + s.code
end

pub func Ok(s: Status): bool:
    ret s.code.len() == 0
end

pub func Report(s: Status): str:
    ret _describe(s)
end

pub func Keep<T>(value: T, s: Status, out &: Vector<T>): bool:
    if not Ok(s): ret false end
    out.push(value)
    ret true
end

pub func Explain<T>(_value: T, s: Status): str:
    ret Report(s)
end
