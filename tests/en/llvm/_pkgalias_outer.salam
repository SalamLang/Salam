// Helper for llvm/pkg_alias_shadow: imports its own 'board', different from
// the one the entry file imports under that same name.
package pkgalias_outer

import board "_pkgalias_inner.salam"

pub func Register(): str:
    ret "outer.Register -> " + board.Prepare()
end
