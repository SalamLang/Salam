package shadow_api

include model "_pkgfunc_shadow_model.salam"
include util "_pkgfunc_shadow_util.salam"

type Val = model.Val
type Mode = model.Mode

pub func Make(n: int): Val:
    mut v := model.Val {}
    v.n = n
    ret v
end

pub func DefaultMode(): Mode:
    ret model.Mode.Second
end

pub func IsSecond(m: Mode): bool:
    ret m == model.Mode.Second
end

pub func Run(n: int): int:
    v := Make(n)
    ret util.Double(v.n)
end
