// Helper for llvm/pkg_func_value: handlers that a route table in another
// module points at by address.
package pkghandlers

pub func home(ctx: i64):
    println "pkghandlers.home ", ctx
end

pub func about(ctx: i64):
    println "pkghandlers.about ", ctx
end
