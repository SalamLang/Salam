package pkgshadow

mut seen := 0

func handle(x: i64):
    println "pkgshadow.handle", x
end

func worker():
    seen = 7
end

pub func Handler(): i64:
    ret handle
end

pub func RunWorker(): int:
    t := spawn(worker)
    join(t)
    ret seen
end
