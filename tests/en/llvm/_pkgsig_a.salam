// Helper for llvm/pkg_same_name: a private 'render' taking two arguments.
// The entry module declares a private 'render' of its own with a different
// arity, and the global scope holds that one.
package pkgsiga

func render(x: int, y: int): int:
    ret (x * 10) + y
end

pub func Run(): int:
    ret render(4, 2)
end
