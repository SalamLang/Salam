// Helper for llvm/pkg_same_name: a third 'render', four arguments wide, so
// a backend that resolves a signature by name rather than by declaration
// reads past the end of one list or the other.
package pkgsigb

func render(a: int, b: int, c: int, d: int): int:
    ret (((a + b) + c) + d)
end

pub func Run(): int:
    ret render(1, 2, 3, 4)
end
