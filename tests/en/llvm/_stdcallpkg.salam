package stdcallpkg

if SALAM_OS_WINDOWS:
    extern:
        pub func Sleep(ms: int)
        pub func GetTickCount(): u32
    end
else:
    pub func Sleep(ms: int):
        _ms := ms
    end

    pub func GetTickCount(): u32:
        ret 7
    end
end
