struct Big:
    pub buf: u8[65536]
    pub tag: str = "b"
    pub n: int = 0
end

struct Holder:
    pub inner: Big
    pub id: int = 7
    pub func get(): Big:
        ret this.inner
    end
    pub mut func put(b: Big): this.inner = b
end
end

func mk(t: str): Big:
    mut b: Big
    b.tag = t
    b.buf[100] = 42 as u8
    ret b
end

func lit(): Big:
    ret Big { buf = mk("x").buf, tag = "lit", n = 3 }
end

func sum(b: Big): int:
    ret (b.buf[100] as int) + b.n
end

func pick(flag: bool): Big:
    if flag:
        ret mk("yes")
    end
    ret mk("no")
end

func main:
    a := mk("a")
    println a.tag, a.buf[100], sum(a)
    mut h := Holder { inner = mk("h") }
    println h.inner.tag, h.id
    h.inner = mk("h2")
    g := h.get()
    println g.tag, g.buf[100]
    h.put(mk("h3"))
    println h.inner.tag
    l := lit()
    println l.tag, l.n, l.buf[100], sum(l)
    println pick(true).tag, pick(false).tag
    mut v := Vector {} as Vector<Big>
    defer v.free()
    v.push(mk("v0"))
    v.push(a)
    println v.len(), v.get(0).tag, v.get(1).tag
end
