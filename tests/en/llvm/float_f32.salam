import mem
import math
import conv.numfmt

struct Sample:
    pub w: f32
    pub d: f64
end

func keep<T>(x: T): T:
    ret x
end

func third(): f32:
    ret keep(1.0 as f32) / keep(3.0 as f32)
end

func main:
    a := keep(0.1 as f32)
    b := keep(0.2 as f32)
    println a, b, a + b, a * b, (a + b) as f64
    s := Sample { w = keep(2.5 as f32) / keep(7.0 as f32), d = keep(2.5) / keep(7.0) }
    println s.w, s.d
    mut v := Vector {} as Vector<f32>
    v.Push(keep(0.3 as f32))
    v.Push(keep(16777217.0) as f32)
    println v.Get(0), v.Get(1), third()
    p := mem.Allocate(8 as u64) as f32*
    p[0] = keep(1.1 as f32)
    println p[0]
    mem.Free(p as void*)
    println "f32 " + a + " " + third(), "f64 " + keep(0.1) + " " + keep(1e-7) + " " + keep(1e21)
    println numfmt.FormatFloat32(keep(3.4028235e38 as f32)), numfmt.FormatFloat32(keep(1e-45 as f32))
    println keep(3.4e38 as f32) * keep(10.0 as f32), keep(0.0 as f32) / keep(0.0 as f32), -keep(0.0 as f32)
    println keep(120.0 as f32), keep(5040.0 as f32), keep(1e9 as f32), keep(1e-5 as f32)
    println math.Round(keep(2.5)), math.Round(keep(-2.5)), math.Round(keep(0.49999999999999994))
    println math.Round(keep(4503599627370497.0)), math.Round(keep(-0.5)), math.Round(keep(1.5))
end
