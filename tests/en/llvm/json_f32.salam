import encoding.json

struct Pt:
    @json "x"
    pub x: f64 = 0.0
    @json "y"
    pub y: f32 = 0.0 as f32
    @json "ys"
    pub ys: Vector<f32> = Vector {} as Vector<f32>
end

func keep<T>(x: T): T:
    ret x
end

func decode(text: str):
    mut p := Pt {}
    try:
        json.Unmarshal(text, p)
        println "ok", p.y, json.Marshal(p)
    catch e:
        println "ERR", e.message
    end
end

func main:
    mut p := Pt { x = keep(0.1), y = keep(0.1 as f32) }
    p.ys.Push(keep(1.5 as f32))
    p.ys.Push(keep(3.4028234663852886e38) as f32)
    p.ys.Push(keep(1e-45) as f32)
    text := json.Marshal(p)
    println text
    mut back := Pt {}
    try:
        json.Unmarshal(text, back)
    catch e:
        println "ERR", e.message
    end
    println back.y == p.y, back.ys.Len(), back.ys[1] == p.ys[1], back.ys[2] == p.ys[2]
    decode(`{"x":1,"y":0.30000001192092896,"ys":[]}`)
    decode(`{"x":1,"y":3.4028235e38,"ys":[]}`)
    decode(`{"x":1,"y":-3.4e38,"ys":[]}`)
    decode(`{"x":1,"y":1e40,"ys":[]}`)
    decode(`{"x":1,"y":-1e39,"ys":[]}`)
    decode(`{"x":1,"y":2,"ys":[1,1e300]}`)
    decode(`{"x":1,"y":1e-50,"ys":[]}`)
    p.y = (keep(1e30) as f32) * (keep(1e30) as f32)
    println json.Marshal(p)
    back.ys.Free()
    p.ys.Free()
end
