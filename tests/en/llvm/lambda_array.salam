func main:
    ops := [(a: int): ret a + 1 end, (a: int): ret a * 10 end]
    println ops[1](4)
    println ops[0](4)
    k := 3
    mut more := [(a: int): ret a + k end, (a: int): ret a - k end, (a: int): ret a * k end]
    println more[2](5)
    more[1] = (a: int): ret a * a end
    println more[1](6)
    repeat 3 in j:
        println more[j](2)
    end
end
