func main:
    mut a := [2, 4, 6, 8, 10] as int[5]
    a[1] = 99
    mut sum := 0
    repeat 5 with i:
        sum = sum + a[i]
    end
    println sum
    println len(a)
    println a[0]
    println a[1]
end
