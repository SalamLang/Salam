func sum(n: int): int:
    arr := [10, 20, 30, 40, 50]
    mut t := 0
    mut i := 0
    until i < n:
        t += arr[i]
        i += 1
    end
    ret t
end

func main:
    arr := [10, 20, 30, 40, 50]
    mut last := 0
    mut i := 0
    until i < 5:
        last = arr[i]
        i += 1
    end
    println last
    println arr[4]
    println sum(5)
    println sum(0)
end
