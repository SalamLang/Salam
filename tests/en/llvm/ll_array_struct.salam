struct Cell:
    pub n: int = 0
end

func main:
    mut cells := [Cell { n = 1 }, Cell { n = 2 }, Cell { n = 3 }] as Cell[3]
    cells[2].n = 42
    mut total := 0
    repeat 3 with i:
        total = total + cells[i].n
    end
    println total
    println cells[2].n
end
