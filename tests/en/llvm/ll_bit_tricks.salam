// Bit kernels compiled through LLVM, each computed two independent ways
// so the backend is checked against a reference and not against itself.

func popcount(x: u32): int:
    mut v := x
    mut n := 0
    until v != (0 as u32):
        v = v & (v - (1 as u32))
        n = n + 1
    end
    ret n
end

func popcount_swar(x: u32): int:
    mut v := x
    v = v - ((v >> (1 as u32)) & (0x55555555 as u32))
    v = (v & (0x33333333 as u32)) + ((v >> (2 as u32)) & (0x33333333 as u32))
    v = (v + (v >> (4 as u32))) & (0x0F0F0F0F as u32)
    ret ((v * (0x01010101 as u32)) >> (24 as u32)) as int
end

func ctz(x: u32): int:
    if x == (0 as u32): ret 32 end
    mut n := 0
    mut v := x
    until (v & (1 as u32)) == (0 as u32):
        v = v >> (1 as u32)
        n = n + 1
    end
    ret n
end

func clz(x: u32): int:
    if x == (0 as u32): ret 32 end
    mut n := 0
    mut v := x
    until (v & ((1 as u32) << (31 as u32))) == (0 as u32):
        v = v << (1 as u32)
        n = n + 1
    end
    ret n
end

func is_pow2(x: u32): bool:
    ret x != (0 as u32) && (x & (x - (1 as u32))) == (0 as u32)
end

func next_pow2(x: u32): u32:
    mut v := x - (1 as u32)
    v = v | (v >> (1 as u32))
    v = v | (v >> (2 as u32))
    v = v | (v >> (4 as u32))
    v = v | (v >> (8 as u32))
    v = v | (v >> (16 as u32))
    ret v + (1 as u32)
end

func reverse32(x: u32): u32:
    mut v := x
    v = ((v >> (1 as u32)) & (0x55555555 as u32)) | ((v & (0x55555555 as u32)) << (1 as u32))
    v = ((v >> (2 as u32)) & (0x33333333 as u32)) | ((v & (0x33333333 as u32)) << (2 as u32))
    v = ((v >> (4 as u32)) & (0x0F0F0F0F as u32)) | ((v & (0x0F0F0F0F as u32)) << (4 as u32))
    v = ((v >> (8 as u32)) & (0x00FF00FF as u32)) | ((v & (0x00FF00FF as u32)) << (8 as u32))
    ret (v >> (16 as u32)) | (v << (16 as u32))
end

func reverse32_naive(x: u32): u32:
    mut r := 0 as u32
    mut b := 0
    until b < 32:
        r = (r << (1 as u32)) | ((x >> (b as u32)) & (1 as u32))
        b = b + 1
    end
    ret r
end

func rotl32(x: u32, n: u32): u32:
    ret (x << n) | (x >> ((32 as u32 - n) & (31 as u32)))
end

func rotr32(x: u32, n: u32): u32:
    ret (x >> n) | (x << ((32 as u32 - n) & (31 as u32)))
end

func gray(x: u32): u32:
    ret x ^ (x >> (1 as u32))
end

func ungray(x: u32): u32:
    mut v := x
    v = v ^ (v >> (1 as u32))
    v = v ^ (v >> (2 as u32))
    v = v ^ (v >> (4 as u32))
    v = v ^ (v >> (8 as u32))
    v = v ^ (v >> (16 as u32))
    ret v
end

func branchless_abs(x: int): int:
    m := x >> 31
    ret (x + m) ^ m
end

func branchless_max(a: int, b: int): int:
    ret a ^ ((a ^ b) & (0 - ((a < b) as int)))
end

func main:
    // the two popcounts have to agree everywhere
    mut counts := ""
    mut agree := true
    mut i := 0
    until i < 20:
        x := ((i * 2654435761) & 2147483647) as u32
        if popcount(x) != popcount_swar(x): agree = false end
        i = i + 1
    end
    repeat 12 with n:
        v := (1 << n) - 1
        counts = counts + popcount(v as u32) + " "
        if popcount(v as u32) != popcount_swar(v as u32): agree = false end
    end
    println counts
    println "popcount agrees:", agree
    println popcount(0 as u32), popcount(4294967295 as u32), popcount_swar(4294967295 as u32)

    // trailing and leading zeros
    println ctz(1 as u32), ctz(8 as u32), ctz(256 as u32), ctz(2147483648 as u32), ctz(0 as u32)
    println clz(1 as u32), clz(255 as u32), clz(2147483648 as u32), clz(0 as u32)

    // powers of two
    mut pw := ""
    repeat 10 with n:
        pw = pw + is_pow2(n as u32) + " "
    end
    println pw
    println next_pow2(5 as u32), next_pow2(17 as u32), next_pow2(1024 as u32), next_pow2(1025 as u32)

    // reversal, both ways
    println reverse32(1 as u32), reverse32(2147483648 as u32)
    println reverse32(0x12345678 as u32) == reverse32_naive(0x12345678 as u32)
    println reverse32(reverse32(0xDEADBEEF as u32)) == (0xDEADBEEF as u32)
    println reverse32_naive(0xF0F0F0F0 as u32)

    // rotation
    println rotl32(0x12345678 as u32, 8 as u32), rotl32(0x12345678 as u32, 16 as u32)
    println rotr32(rotl32(0xDEADBEEF as u32, 11 as u32), 11 as u32) == (0xDEADBEEF as u32)
    println rotl32(0xDEADBEEF as u32, 0 as u32), rotl32(0xDEADBEEF as u32, 32 as u32)

    // gray code
    mut g := ""
    mut ok := true
    repeat 8 with n:
        code := gray(n as u32)
        g = g + code + " "
        if ungray(code) != (n as u32): ok = false end
    end
    println g
    println "gray round-trips:", ok

    // branchless helpers
    println branchless_abs(7), branchless_abs(-7), branchless_abs(0)
    println branchless_max(3, 9), branchless_max(-4, -9), branchless_max(5, 5)

    // an FNV-1a style accumulation, entirely in u64
    mut h := 14695981039346656037 as u64
    mut k := 0
    until k < 8:
        h = h ^ ((k + 1) as u64)
        h = h * (1099511628211 as u64)
        k = k + 1
    end
    println h
end
