// Unsigned bit work through LLVM: every operation happens in the
// operand's own width, `~` fills that width with ones, `>>` is logical,
// and arithmetic wraps modulo 2^n rather than widening.

func mask8(x: u8, m: u8): u8:
    ret x & m
end

func mask16(x: u16, m: u16): u16:
    ret x & m
end

func byte_of(x: u32, i: u32): u32:
    ret (x >> (i * (8 as u32))) & (0xFF as u32)
end

func bswap32(x: u32): u32:
    b0 := (x & (0x000000FF as u32)) << (24 as u32)
    b1 := (x & (0x0000FF00 as u32)) << (8 as u32)
    b2 := (x & (0x00FF0000 as u32)) >> (8 as u32)
    b3 := (x & (0xFF000000 as u32)) >> (24 as u32)
    ret b0 | b1 | b2 | b3
end

func main:
    // all ones at every width
    println ~(0 as u8), ~(0 as u16), ~(0 as u32), ~(0 as u64)

    // the top bit is a value bit, not a sign bit
    println (1 as u8) << (7 as u8), (1 as u16) << (15 as u16)
    println (1 as u32) << (31 as u32), (1 as u64) << (63 as u64)

    // logical right shift brings in zeros
    println ~(0 as u8) >> (1 as u8), ~(0 as u16) >> (1 as u16)
    println ~(0 as u32) >> (1 as u32), ~(0 as u64) >> (1 as u64)
    println ~(0 as u32) >> (24 as u32), ~(0 as u64) >> (56 as u64)

    // arithmetic wraps inside the width
    println (0xFF as u8) + (1 as u8), (0xFFFF as u16) + (1 as u16)
    println (0 as u32) - (1 as u32), (0 as u64) - (1 as u64)
    println (0xF0 as u8) << (4 as u8), (0xFF00 as u16) << (8 as u16)
    println (200 as u8) * (2 as u8)

    // masking at each width
    println mask8(0xAB as u8, 0x0F as u8), mask8(0xAB as u8, 0xF0 as u8)
    println mask16(0xABCD as u16, 0x00FF as u16), mask16(0xABCD as u16, 0xFF00 as u16)

    // taking a 32-bit word apart byte by byte and putting it back
    w := 0xDEADBEEF as u32
    println byte_of(w, 0 as u32), byte_of(w, 1 as u32), byte_of(w, 2 as u32), byte_of(w, 3 as u32)
    rebuilt := (byte_of(w, 3 as u32) << (24 as u32)) | (byte_of(w, 2 as u32) << (16 as u32)) | (byte_of(w, 1 as u32) << (8 as u32)) | byte_of(w, 0 as u32)
    println rebuilt, rebuilt == w
    println bswap32(w), bswap32(bswap32(w)) == w

    // 64-bit patterns
    p := 0xF0F0F0F0F0F0F0F0 as u64
    q := 0x0F0F0F0F0F0F0F0F as u64
    println p & q, p | q, p ^ q
    println (p | q) == ~(0 as u64), (p ^ q) == ~(0 as u64)
    println p ^ ~(0 as u64)
    println p >> (4 as u64), q << (4 as u64)

    // compound assignment stays inside the width
    mut u := 0x80 as u8
    u <<= 1 as u8
    println u
    u = 0x01 as u8
    u -= 2 as u8
    println u
    mut h := 0xFFFF as u16
    h &= 0x0FF0 as u16
    println h
    h |= 0xF00F as u16
    println h
    h ^= 0xFFFF as u16
    println h
    mut d := 0 as u64
    d |= (1 as u64) << (63 as u64)
    d >>= 32 as u64
    println d

    // unsigned comparisons do not order by the signed reading
    println ~(0 as u32) > (2147483647 as u32)
    println ~(0 as u64) > (9223372036854775807 as u64)
    println ((0 as u32) - (1 as u32)) > (0 as u32)

    // an unsigned accumulation loop
    mut acc := 0 as u32
    mut i := 0
    until i < 16:
        acc = (acc << (2 as u32)) | ((i & 3) as u32)
        i = i + 1
    end
    println acc
end
