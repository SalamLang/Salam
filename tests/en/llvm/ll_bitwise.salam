// The LLVM backend must emit and/or/xor/not with the same results as
// the C backend: truth tables, identities, De Morgan, and the operators
// applied to negative operands.

func band(a: int, b: int): int:
    ret a & b
end

func bor(a: int, b: int): int:
    ret a | b
end

func bxor(a: int, b: int): int:
    ret a ^ b
end

func bnot(a: int): int:
    ret ~a
end

func main:
    println 0 & 0, 0 & 1, 1 & 0, 1 & 1
    println 0 | 0, 0 | 1, 1 | 0, 1 | 1
    println 0 ^ 0, 0 ^ 1, 1 ^ 0, 1 ^ 1
    println ~0, ~1, ~127, ~(-1)

    a := 0b1100
    b := 0b1010
    println a & b, a | b, a ^ b
    println a & ~b, ~a & b

    // through call boundaries, so nothing can be constant-folded away
    println band(a, b), bor(a, b), bxor(a, b), bnot(a)
    println band(-12, 255), bor(-12, 15), bxor(-12, -1), bnot(-12)

    // identities
    x := 0x5A5A
    println x & 0, x & (-1), x | 0, x | (-1), x ^ 0, x ^ x
    println (x ^ (-1)) == ~x

    // De Morgan and distributivity
    p := 0x0F0F
    q := 0x3333
    r := 0x5555
    println ~(p & q) == (~p | ~q), ~(p | q) == (~p & ~q)
    println (p & (q | r)) == ((p & q) | (p & r))
    println (p | (q & r)) == ((p | q) & (p | r))
    println ((p ^ q) ^ r) == (p ^ (q ^ r))

    // add without carry, plus the carries
    m := 1234
    n := 5678
    println (m ^ n) + ((m & n) * 2) == m + n
    println (m | n) + (m & n)

    // in a loop, accumulating into one word
    mut acc := 0
    repeat 8 with i:
        acc |= 1 << i
    end
    println acc
    repeat 4 with i:
        acc &= ~(1 << (i * 2))
    end
    println acc
    repeat 8 with i:
        acc ^= 1 << i
    end
    println acc

    // 64-bit signed operands
    big := 1152921504606846976 as i64
    println big | (1 as i64), big & (0 as i64), big ^ big
    println ~(0 as i64), ~(1 as i64) & (255 as i64)
end
