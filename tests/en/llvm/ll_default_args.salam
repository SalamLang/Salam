const STEP := 5

func area(w: int, h: int = 2): int:
    ret w * h
end

func bump(x: int, delta: int = STEP): int:
    ret x + delta
end

func main:
    println area(3)
    println area(3, 4)
    println bump(10)
    println bump(10, 1)
end
