func pieces(s: str): str:
    mut out := ""
    mut back := ""
    each ch in s:
        out = out + "[" + ch.len() + "]"
        back = back + ch
    end
    ret out + " lossless=" + (back == s ? "yes" : "no")
end

func main:
    println "stray byte      ", pieces("a\xffb")
    println "lone continue   ", pieces("x\x80\x80y")
    println "truncated 2     ", pieces("\xd8")
    println "truncated 3     ", pieces("\xe2\x82")
    println "truncated 4     ", pieces("\xf0\x9f\x91")
    println "cut by ascii    ", pieces("\xe2a\x82")
    println "f8 lead         ", pieces("\xf8\x88\x80\x80\x80")
    println "valid then bad  ", pieces("سلام\xff")
    println "bad then valid  ", pieces("\xc0سلام")
    mut bytes := 0
    each _ in "a\xffb".bytes():
        bytes += 1
    end
    println "bytes():", bytes
end
