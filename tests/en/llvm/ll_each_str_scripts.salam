func list(label: str, s: str):
    mut parts := ""
    mut widths := ""
    mut n := 0
    each i, ch in s:
        if ch != s.char_at(i):
            println "mismatch at", i
        end
        parts = parts + ch + "|"
        widths = widths + ch.len()
        n += 1
    end
    println label, n, s.char_count(), s.len(), widths, parts
end

func reverse(s: str): str:
    mut out := ""
    each ch in s:
        out = ch + out
    end
    ret out
end

func main:
    list("ascii", "Salam!")
    list("persian", "سلام دنیا")
    list("arabic", "مرحبا")
    list("hebrew", "שלום")
    list("cjk", "你好世界")
    list("korean", "한글")
    list("emoji", "👋🌍✨")
    list("mixed", "Hi سلام 123 ۱۲۳")
    list("zwnj", "می‌روم")
    list("combining", "e\u0301")
    list("devanagari", "नमस्ते")
    list("empty", "")
    println reverse("سلام"), reverse("abc"), reverse("a👋b")
    mut seen := 0
    each ch in "سلام سلام":
        if ch == u'س':
            seen += 1
        end
    end
    println "sin:", seen
end
