func grade(n: int): str:
    if n >= 90: ret "A"
    else n >= 80: ret "B"
    else n >= 70: ret "C"
    else:
        ret "F"
    end
end

func main:
    println grade(95)
    println grade(85)
    println grade(72)
    println grade(50)
end
