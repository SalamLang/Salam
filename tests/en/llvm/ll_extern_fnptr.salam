import mem

extern:
    func qsort(base: void*, n: usize, size: usize, cmp: void*)
    func strcmp(a: str, b: str): int
    func puts(s: void*): int
end

func main:
    words := ["pear", "apple", "fig", "banana"]
    buf := mem.AllocateZeroed(32 as u64)
    repeat words.len() in i:
        mem.Copy(((buf as i64) + (i * 8) as i64) as void*, words[i] as void*, (words[i].len() + 1) as u64)
    end
    qsort(buf, 4 as usize, 8 as usize, &strcmp)
    repeat 4 in k:
        _p := puts(((buf as i64) + (k * 8) as i64) as void*)
    end
    mem.Free(buf)
end
