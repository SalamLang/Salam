interface Hashable:
    func hash(): u64
end
impl Hashable on int:
    func hash(): u64:
        ret (this * 2654435761) as u64
    end
end

func hashed<T: Hashable>(x: T): u64: ret x.hash()
end
func main:
    println hashed(7)
    println hashed(100)
end
