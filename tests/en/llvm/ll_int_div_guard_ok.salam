func half(x: int): int:
    ret x / 2
end

func main:
    a := "17".to_int()
    b := "5".to_int()
    n := "-7".to_int()
    println a / b
    println a % b
    println n / b
    println n % b
    println a / n
    println a % n
    mut c := a
    c /= b
    println c
    c = a
    c %= b
    println c
    big := 9000000000 as i64
    bb := b as i64
    println big / bb
    println big % bb
    ub := 18000000000000000000 as u64
    us := 7 as u64
    println ub / us
    println ub % us
    mut uu := ub
    uu /= us
    println uu
    small := "200".to_int() as u8
    sd := "7".to_int() as u8
    println small / sd
    println small % sd
    println half(a)
end
