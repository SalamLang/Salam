func is even(n: int): bool:
    if n == 0: ret true end
    ret is odd(n - 1)
end

func is odd(n: int): bool:
    if n == 0: ret false end
    ret is even(n - 1)
end

func main:
    println is even(10)
    println is odd(7)
    println is even(3)
end
