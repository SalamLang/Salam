import kinds "_pkgenum_kinds.salam"

func main:
    k := kinds.Kind.Beta
    println k as int
    println k.name()
    println k == kinds.Kind.Beta

    mut ok := false
    hit := kinds.Kind.FromString("Gamma", ok)
    println ok
    println hit.name()

    println kinds.Kind.Count()

    names := kinds.Kind.Names()
    println names.len()
    println names.get(0)
end
