// Constant initializers of pointer type (`0 as T*`, a nonzero address) and a
// float global initialised from an integer literal: the LLVM backend has to
// write them as null / inttoptr / a float constant, never `ptr 0`.

import mem

mut cell := 0 as i64*
mut addr := 4096 as void*
mut ratio := 2 as f64

struct Box:
    pub p: void* = 0 as void*
    pub n: int = 3
end

func main:
    println cell == null
    cell = mem.AllocateZeroed(8 as u64) as i64*
    cell[0] = 41
    println cell[0] + 1
    println addr as i64
    println ratio
    b := Box {}
    println b.p == null, " ", b.n
    mem.Free(cell as void*)
end
