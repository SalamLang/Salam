import math

pure func poly(x: f64): f64:
    ret x * x + 2.0 * x + 1.0
end

func main:
    println math.Sqrt(25.0)
    println math.Floor(3.7)
    println math.Abs(0.0 - 4.5)
    println poly(3.0)
end
