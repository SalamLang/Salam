/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

func shl(x: int, n: int): int:
    ret x << n
end

func sar(x: int, n: int): int:
    ret x >> n
end

func shr_u32(x: u32, n: u32): u32:
    ret x >> n
end

func sar_i64(x: i64, n: i64): i64:
    ret x >> n
end

func main:
    mut line := ""
    repeat 16 with i:
        line = line + (1 << i) + " "
    end
    println line

    println 3 << 4, 3 * 16, (3 << 4) == 3 * 16
    println 1000 >> 3, 1000 / 8

    println -1 >> 1, -2 >> 1, -7 >> 1, -8 >> 1
    println sar(-1024, 4), -1024 / 16
    println sar(-1, 31), sar(-1, 30)

    println shr_u32(~(0 as u32), 1 as u32)
    println shr_u32(~(0 as u32), 28 as u32)
    println shr_u32(0x80000000 as u32, 31 as u32)

    println (-1 as i32) >> (1 as i32), ((-1 as i32) as u32) >> (1 as u32)

    println (1 as i64) << (40 as i64)
    println sar_i64(-1099511627776 as i64, 10 as i64)
    println (1 as u64) << (63 as u64)
    println ~(0 as u64) >> (60 as u64)

    println 1 << 4 + 1, (1 << 4) + 1
    println 96 >> 2 * 2, (96 >> 2) * 2
    println 1 << 2 | 1, 3 & 1 << 2
    println 1 << 3 > 4, 16 >> 2 == 4

    mut v := 1
    v <<= 10
    println v
    v >>= 4
    println v
    mut u := 0x80 as u8
    u >>= 7 as u8
    println u
    mut w := 1 as u32
    w <<= 31 as u32
    println w
    w >>= 31 as u32
    println w

    println shl(1, 30), sar(1073741824, 30)
    println (12345 << 8) >> 8
end
