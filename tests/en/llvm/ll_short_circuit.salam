func noisy(): bool:
    println "side"
    ret true
end

func main:
    x := 0

    if x != 0 && noisy():
        println "and"
    end
    if x == 0 || noisy():
        println "or"
    end

    if x != 0 && 10 / x > 0:
        println "bad"
    end
    println "done"
end
