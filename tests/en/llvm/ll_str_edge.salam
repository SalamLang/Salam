func main:
    a := "abcdef"
    println "[" + a.substr(2, 100) + "]"
    println "[" + a.substr(0 - 2, 3) + "]"
    println "[" + a.substr(50, 2) + "]"
    println "[" + a.substr(2, 0 - 1) + "]"
    println "[" + a.substr(6, 1) + "]"
    println a.find(""), a.find("f"), a.find("zz")
    println "[" + "  x y  ".trim() + "]"
    println "[" + "".trim() + "]"
    println "[" + "ab".repeat(0) + "]", "[" + "ab".repeat(0 - 2) + "]", "ab".repeat(3)
    println "AbC-ÄÖ".lower(), "AbC-äö".upper()
    println "12abc".to_int(), "-7".to_int(), " 42".to_int(), "x".to_int()
    println "99999999999".to_int()
    println "1.5e2".to_float(), "abc".to_float()
    println "a,,b".split(",").len()
    println "".split(",").len()
    println "".len(), "".char_count()
    println "[" + "".char_at(0) + "]", "".char_find(""), "".char_find("a")
    println "[" + "".char_substr(0, 3) + "]"
end
