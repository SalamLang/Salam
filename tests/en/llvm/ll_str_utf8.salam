func main:
    s := "سلام hi 👋!"
    println s.CharCount()
    println s.CharAt(0)
    println s.CharAt(3)
    println s.CharAt(8)
    println "[" + s.CharAt(10) + "]"
    println "[" + s.CharAt(0 - 1) + "]"
    println s.CharSubstr(0, 4)
    println s.CharSubstr(5, 2)
    println s.CharSubstr(7, 100)
    println "[" + s.CharSubstr(50, 2) + "]"
    println s.CharSubstr(0 - 3, 2)
    println "[" + s.CharSubstr(2, 0 - 1) + "]"
    println s.CharFind("hi")
    println s.CharFind("👋")
    println s.CharFind("xyz")
    println s.CharFind("")
    println "".CharCount()
    println "abc".CharCount()
    n := s.CharCount()
    mut out := ""
    repeat n in i:
        out += s.CharAt(n - 1 - i)
    end
    println out
end
