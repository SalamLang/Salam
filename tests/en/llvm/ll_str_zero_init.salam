mut g_names: str[3]
mut g_rec: Rec

struct Rec:
    pub name: str
    pub tags: str[2]
    pub n: int = 0
end

func main:
    mut names: str[2]
    names[1] = "x"
    println names
    println names[0].len()
    println names[0] + "|" + names[1]
    mut grid: str[2][3]
    grid[0][0] = "a"
    println grid
    println grid[1][2].len()
    mut recs: Rec[2]
    recs[0].n = 4
    println recs[1].name.len()
    println recs[1].tags
    println recs[0].n
    g_names[2] = "z"
    println g_names
    println g_rec.name.len()
    println g_rec.tags
    mut total := 0
    each s in names:
        total += s.len()
    end
    println total
end
