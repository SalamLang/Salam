func main:
    s := "hello world"
    println s.len()
    println s.concat("!")
    println s.substr(0, 5)
    println s.substr(6, 5)
    println s.find("world")
    println s.find("xyz")
    println "42".to_int() + 8
    println char_from_code(65)
end
