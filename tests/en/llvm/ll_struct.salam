struct Point:
    pub x: int = 0
    pub y: int = 0
end

func main:
    mut p := Point { x = 3, y = 7 }
    println p.x
    println p.y
    p.x = p.x + 10
    p.y = p.y * 2
    println p.x
    println p.y
end
