struct Vec2:
    pub x: int = 0
    pub y: int = 0
end

func add(a: Vec2, b: Vec2): Vec2:
    r := Vec2 { x = a.x + b.x, y = a.y + b.y }
    ret r
end

func main:
    a := Vec2 { x = 1, y = 2 }
    b := Vec2 { x = 30, y = 40 }
    c := add(a, b)
    println c.x
    println c.y
end
