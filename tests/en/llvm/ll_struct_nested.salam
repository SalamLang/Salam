struct Inner:
    pub v: int = 0
end

struct Outer:
    pub a: Inner
    pub b: Inner
end

func main:
    mut o := Outer { a = Inner { v = 5 }, b = Inner { v = 9 } }
    println o.a.v
    println o.b.v
    o.b.v = o.a.v + o.b.v
    println o.b.v
end
