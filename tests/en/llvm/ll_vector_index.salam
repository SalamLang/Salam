struct P:
    pub x: int = 0
    pub y: int = 0
end

func main:
    mut v := Vector {} as Vector<P>
    defer v.free()
    v.push(P { x = 1, y = 2 })
    v.push(P { x = 3, y = 4 })
    v.push(P { x = 5, y = 6 })

    println v.len()
    println v[0].x, v[1].y, v[2].x

    p := v[1]
    println p.x, p.y

    r := v.ref(0)
    r.x = 90
    println v[0].x

    v[2] = P { x = 7, y = 8 }
    println v[2].x, v[2].y

    mut sum := 0
    repeat v.len() with i:
        sum = sum + v[i].x + v[i].y
    end
    println "sum", sum

    mut ns := Vector {} as Vector<int>
    defer ns.free()
    ns.push(10)
    ns.push(20)
    ns[1] = ns[0] + 5
    println ns[0], ns[1]
end
