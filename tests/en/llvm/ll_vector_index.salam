// v[i] where the element is a struct. The elements live off the Vector's
// data pointer, not inside the Vector struct, so the address form has to
// load that buffer first - indexing the struct itself by a runtime value
// is not even representable in LLVM IR.

struct P:
    pub x: int = 0
    pub y: int = 0
end

func main:
    mut v := Vector {} as Vector<P>
    defer v.free()
    v.push(P { x = 1, y = 2 })
    v.push(P { x = 3, y = 4 })
    v.push(P { x = 5, y = 6 })

    println v.len()
    println v[0].x, v[1].y, v[2].x

    // Reading a whole element, and reaching a field through the index.
    p := v[1]
    println p.x, p.y

    // Writing through ref(), then through the index itself.
    r := v.ref(0)
    r.x = 90
    println v[0].x

    v[2] = P { x = 7, y = 8 }
    println v[2].x, v[2].y

    mut sum := 0
    repeat v.len() with i:
        sum = sum + v[i].x + v[i].y
    end
    println "sum", sum

    // A Vector of ints still indexes the same way.
    mut ns := Vector {} as Vector<int>
    defer ns.free()
    ns.push(10)
    ns.push(20)
    ns[1] = ns[0] + 5
    println ns[0], ns[1]
end
