import conv
import str

func keep<T>(x: T): T:
    ret x
end

func main:
    z := keep(0.0)
    neg := -(z / z)
    pos := z / z
    println neg, pos, -neg
    println "" + neg, str.FromFloat(neg), conv.FormatFloat(neg)
    println conv.FormatFloatShort(neg), conv.FormatFloatPrec(neg, 3)
    f := neg as f32
    println f, "" + f, -(f)
    println -(0.0 / 0.0), 0.0 / 0.0
    println -(z / z) * 2.0, keep(-1.0) / z, keep(1.0) / z
end
