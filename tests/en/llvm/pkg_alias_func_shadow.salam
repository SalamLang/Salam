// The entry package declares `util`, which is also the alias of an included
// package inside `shadow_api`. The LLVM backend must resolve the name in the
// package that uses it, and structs and enums reached through a type alias
// (`type Val = model.Val`) must find the real declaration. `extra` is only
// reached through an alias in the entry package, so its type definition must
// still be emitted before `main` uses it.

package main

include api "_pkgfunc_shadow_api.salam"
include extra "_pkgfunc_shadow_extra.salam"

type Extra = extra.Extra

func util(n: int): int:
    ret n + 1000
end

func main:
    println api.Run(21)
    v := api.Make(5)
    println v.n
    println util(1)
    println api.IsSecond(api.DefaultMode())
    e := extra.Extra { m = 7 }
    println e.m
end
