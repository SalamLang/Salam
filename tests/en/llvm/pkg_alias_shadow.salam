// An import alias belongs to the file that wrote it. The entry file's imports
// are defined in the global scope, and the LLVM backend consulted that scope
// before the package it was emitting - so this file's 'board' answered for the
// middle module's 'board' too, and its Prepare came back as "package function
// 'Prepare' not found". The C backend always scoped these correctly.
package main

import board "_pkgalias_outer.salam"

func main:
    println board.Register()
end
