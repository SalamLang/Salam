include pkgshadow "_pkgshadow.salam"

mut ran := 0

func handle(x: i64):
    println "main.handle", x
end

func worker():
    ran = 1
end

func mine(): i64:
    ret handle
end

func main:
    callhandler(mine(), 1)
    callhandler(pkgshadow.Handler(), 2)
    println pkgshadow.RunWorker(), ran
    t := spawn(worker)
    join(t)
    println ran
end
