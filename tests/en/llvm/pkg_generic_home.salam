package main

include genhomea "_genhome_a.salam"
include genhomeb "_genhome_b.salam"

func main:
    println genhomea.Show(genhomea.Gauge { level = 3 }), genhomea.Ok(genhomea.Gauge { level = 3 })
    mut kept := Vector {} as Vector<int>
    println genhomeb.Keep(7, genhomeb.Status {}, kept), genhomeb.Keep(8, genhomeb.Status { code = "bad" }, kept), kept.len()
    mut words := Vector {} as Vector<str>
    println genhomeb.Keep("hi", genhomeb.Status {}, words), words.get(0)
    println genhomeb.Explain(1.5, genhomeb.Status { code = "late" })
end
