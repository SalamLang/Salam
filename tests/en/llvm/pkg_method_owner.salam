package main

include ownera "_ownera.salam"
include ownerb "_ownerb.salam"

func main:
    repeat 3:
        mut a := ownera.Make()
        mut b := ownerb.Make()
        println a.tag(), " ", a.v.len(), " ", b.tag(), " ", b.v.len()
        a.free()
        b.free()
    end
    println "ok"
end
