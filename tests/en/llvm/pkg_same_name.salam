// Three modules, three private functions called 'render', three different
// arities. A function's signature has to be found by the declaration it
// belongs to: looked up by name, the entry module's 'render' answers for
// every other module's, and the backend emitted one function's body under
// another's parameter list - or walked off the end of the shorter one and
// took the compiler down with it.
package main

import pkgsiga "_pkgsig_a.salam"
import pkgsigb "_pkgsig_b.salam"

func render(text: str): str:
    ret "[" + text + "]"
end

func main:
    println render("here")
    println pkgsiga.Run()
    println pkgsigb.Run()
end
