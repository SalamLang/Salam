include sh "_shade.salam"

struct Swatch:
    pub tone: sh.Shade
    pub name: str = "s"
end

func first(): sh.Shade:
    ret sh.Shade.Light
end

func flip(t: sh.Shade): sh.Shade:
    ret t == sh.Shade.Light ? sh.Shade.Dark : sh.Shade.Light
end

func main:
    a := first()
    println a == sh.Shade.Light, a as str
    b := flip(a)
    println b == sh.Shade.Dark, b as str
    w := Swatch { tone = b }
    println w.name, w.tone as str
end
