// A `repeat` index takes the type of the values that drive the loop: a u8
// count binds a u8 index, an i64 count an i64 one, and bounds with no
// common type fall back to i32. The typed_* helpers below are the real
// assertions - each accepts exactly one type, so this file only compiles
// if the index handed to it already has that type.
// The same file lives in tests/en/general, tests/en/exec and
// tests/en/llvm, so the C backend, the interpreter and the LLVM backend
// must agree byte for byte.

func typed_u8(x: u8): u8: ret x end
func typed_i8(x: i8): i8: ret x end
func typed_u16(x: u16): u16: ret x end
func typed_u64(x: u64): u64: ret x end
func typed_i64(x: i64): i64: ret x end
func typed_i32(x: i32): i32: ret x end

func main:
    // A u8 count binds a u8 index.
    small := 200 as u8
    mut u8sum := 0 as u8
    repeat small with i:
        if i < 10:
            u8sum = u8sum + typed_u8(i)
        end
    end
    println "u8 index:", u8sum

    tiny := 100 as i8
    mut i8last := 0 as i8
    repeat tiny with i:
        i8last = typed_i8(i)
    end
    println "i8 index:", i8last

    mid := 300 as u16
    mut u16last := 0 as u16
    repeat mid with i:
        u16last = typed_u16(i)
    end
    println "u16 index:", u16last

    // A u64 count above INT64_MAX: through a signed counter it reads as
    // negative, and the loop that should run forever ran not at all.
    huge := 18446744073709551615 as u64
    mut ran := 0
    repeat huge with i:
        ran += 1
        if typed_u64(i) >= (2 as u64):
            break
        end
    end
    println "u64 count:", ran

    n64 := 3 as i64
    mut last64 := 0 as i64
    repeat n64 with i:
        last64 = typed_i64(i)
    end
    println "i64 index:", last64

    // A range keeps its bounds' type, top of the range included.
    mut hi := 0 as u8
    repeat (250 as u8) to (255 as u8) with i:
        hi = typed_u8(i)
    end
    println "u8 range:", hi

    mut stepped := 0 as u16
    repeat (10 as u16) to (20 as u16) by (5 as u16) with i:
        stepped = typed_u16(i)
    end
    println "u16 by:", stepped

    // A signed bound and an unsigned one have no common type, so the
    // index falls back to i32 - as it does for a count that is not an
    // integer at all.
    mut mixed := 0
    repeat 0 to (3 as u8) with i:
        mixed = typed_i32(i)
    end
    println "mixed bounds:", mixed

    mut fl := 0
    repeat 3.7 with i:
        fl = typed_i32(i)
    end
    println "float count:", fl

    mut plain := 0
    repeat 4 with i:
        plain = typed_i32(i)
    end
    println "plain count:", plain

    // A count at its own type's maximum still terminates: the counter is
    // wider than the index it hands out, so 255 iterations end at 254.
    full := 255 as u8
    mut seen := 0
    mut u8last := 0 as u8
    repeat full with i:
        u8last = typed_u8(i)
        seen += 1
    end
    println "u8 full:", seen, u8last

    // A zero u64 count runs zero times - nothing here may read 0-1 as a
    // huge unsigned bound.
    zero := 0 as u64
    mut zran := 0
    repeat zero with i:
        zran = zran + (typed_u64(i) as int)
        zran += 1
    end
    println "zero u64:", zran

    // A negative count runs zero times (a *constant* negative count is
    // E068, so this one has to come through a binding).
    neg := 0 - 3
    mut nran := 0
    repeat neg with i:
        nran = nran + typed_i32(i)
        nran += 1
    end
    println "negative count:", nran
end
