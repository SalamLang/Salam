struct Buf:
    pub limit: usize = 0
    pub used: usize = 0
end

func half(n: usize): usize:
    ret n / (2 as usize)
end

func to_i(n: usize): i64:
    ret n as i64
end

func signed_size():
    sn := (0 as size) - (5 as size)
    println sn
    println sn < (0 as size)
    println sn / (2 as size)
    println sn % (3 as size)
    println sn >> (1 as size)
    println sn * (4 as size)
    println sn as i64
    println sn as usize > (0 as usize)
    println (7 as usize) as size
    println sizeof(size) == sizeof(usize)
    mut d := 10 as size
    d -= 25
    println d
    println d == -15
    println d + 1
    mut acc := Vector {} as Vector<size>
    acc.push(d)
    acc.push(sn)
    println acc.get(0) + acc.get(1)
    switch d:
        -15:
            println "minus fifteen"
            break
        end
        0 to 9:
            println "small"
        end
        else:
            println "other"
        end
    end
end

func main:
    a := 10 as usize
    b := 3 as usize
    println a
    println a + b
    println a - b
    println a * b
    println a / b
    println a % b
    println a > b
    println a == (10 as usize)
    z := 0 as usize
    wrap := z - (1 as usize)
    println wrap
    println wrap > a
    println wrap / (2 as usize)
    println wrap >> (60 as usize)
    println (1 as usize) << (40 as usize)
    println half(a)
    println to_i(a)
    neg := -1
    println neg as usize
    println wrap as i64
    println (a as i32) + 1
    println a as u64
    println a as f64
    println sizeof(i64)
    println sizeof(i64) * (2 as usize)
    mut c := 0 as usize
    c += 5 as usize
    c -= 2 as usize
    c *= 4 as usize
    println c
    mut bf := Buf {}
    bf.limit = 64 as usize
    bf.used = bf.limit - (1 as usize)
    println bf.used
    mut v := Vector {} as Vector<usize>
    v.push(7 as usize)
    v.push(wrap)
    println v.get(0)
    println v.get(1)
    mut i := 0 as usize
    mut total := 0 as usize
    until i < (5 as usize):
        total = total + i
        i = i + (1 as usize)
    end
    println total
    arr := [1, 2, 3, 4]
    println arr[1 as usize]
    switch a:
        10 as usize:
            println "ten"
        end
        else:
            println "other"
        end
    end
    mut m := HashMap {} as HashMap<usize, str>
    m.put(wrap, "max")
    println m.get(wrap)
    signed_size()
end
