package main

include stdcallpkg "_stdcallpkg.salam"

func work(n: int, seed: int): int:
    mut a := seed
    mut b := seed * 3 + 1
    mut c := seed * 7 + 2
    repeat n in i:
        stdcallpkg.Sleep(0)
        a = a + i
        b = b ^ (a + i)
        t := stdcallpkg.GetTickCount()
        c = c + b % 13 + (t as int) * 0
    end
    ret a + b + c
end

func main:
    mut total := 0
    repeat 20 in k:
        total = total + work(50, k) % 1000
    end
    println "total", total
    ret 0
end
