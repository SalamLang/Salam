package main

import llvm

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "probe")
    if llvm.ModuleToString(m).Len() > 0:
        println "OK"
    else:
        println "EMPTY"
    end
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
