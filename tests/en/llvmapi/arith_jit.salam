package main

import llvm
import io
import os
import str

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "arith")
    b := llvm.NewBuilder(ctx)
    i32 := llvm.Int32Type(ctx)

    mut two ints := Vector {} as Vector<llvm.Type>
    defer two ints.free()
    two ints.push(i32)
    two ints.push(i32)
    mul ty := llvm.FunctionType(i32, two ints, false)
    mul fn := llvm.AddFunction(m, "mul", mul ty)
    llvm.SetLinkage(mul fn, llvm.LINKAGE_INTERNAL)

    body := llvm.AppendBlock(ctx, mul fn, "entry")
    llvm.PositionAtEnd(b, body)
    _mret := llvm.Ret(b, llvm.Mul(b, llvm.Param(mul fn, 0), llvm.Param(mul fn, 1), "p"))

    mut none := Vector {} as Vector<llvm.Type>
    defer none.free()
    main ty := llvm.FunctionType(i32, none, false)
    main fn := llvm.AddFunction(m, "main", main ty)
    entry := llvm.AppendBlock(ctx, main fn, "entry")
    llvm.PositionAtEnd(b, entry)

    mut args := Vector {} as Vector<llvm.Value>
    defer args.free()
    args.push(llvm.ConstInt(i32, 6 as i64))
    args.push(llvm.ConstInt(i32, 7 as i64))
    _r := llvm.Ret(b, llvm.Call(b, mul ty, mul fn, args, "r"))

    v := llvm.Verify(m)
    if !v.ok:
        println "verify failed: " + v.err
        ret
    end

    path := os.TempDir() + "/salam_llvmapi_arith.ll"
    if io.WriteFile(path, llvm.ModuleToString(m)) < 0:
        println "could not write the module"
        ret
    end
    out := llvm.RunJIT(path)
    if out.ok:
        println "jit returned " + str.FromInt(out.rc as i64)
    else:
        println "jit failed: " + out.err
    end

    llvm.FreeBuilder(b)
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
