package main

import llvm
import io
import os
import str

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "emit")
    b := llvm.NewBuilder(ctx)
    i32 := llvm.Int32Type(ctx)

    mut two ints := Vector {} as Vector<llvm.Type>
    defer two ints.free()
    two ints.push(i32)
    two ints.push(i32)
    add ty := llvm.FunctionType(i32, two ints, false)
    add fn := llvm.AddFunction(m, "salam_add", add ty)
    entry := llvm.AppendBlock(ctx, add fn, "entry")
    llvm.PositionAtEnd(b, entry)
    _r := llvm.Ret(b, llvm.Add(b, llvm.Param(add fn, 0), llvm.Param(add fn, 1), "s"))

    v := llvm.Verify(m)
    if !v.ok:
        println "verify failed: " + v.err
        ret
    end

    tmr := llvm.NewTargetMachine("", llvm.OPT_O2, false)
    if !tmr.ok:
        println "no target machine: " + tmr.err
        ret
    end

    asm path := os.TempDir() + "/salam_llvmapi_emit.s"
    ar := llvm.EmitAsm(m, tmr.tm, asm path)
    if ar.ok:
        text := io.ReadFile(asm path)
        if str.IndexFrom(text, "salam_add", 0) >= 0:
            println "assembly names salam_add"
        else:
            println "assembly missing the symbol"
        end
    else:
        println "asm failed: " + ar.err
    end

    obj path := os.TempDir() + "/salam_llvmapi_emit.o"
    orr := llvm.EmitObject(m, tmr.tm, obj path)
    if orr.ok && os.Exists(obj path):
        println "object emitted"
    else:
        println "object failed: " + orr.err
    end

    llvm.FreeTargetMachine(tmr.tm)
    llvm.FreeBuilder(b)
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
