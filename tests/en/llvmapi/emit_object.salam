package main

import llvm
import io
import os
import str

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "emit")
    b := llvm.NewBuilder(ctx)
    i32 := llvm.Int32Type(ctx)

    mut two_ints := Vector {} as Vector<llvm.Type>
    defer two_ints.Free()
    two_ints.Push(i32)
    two_ints.Push(i32)
    add_ty := llvm.FunctionType(i32, two_ints, false)
    add_fn := llvm.AddFunction(m, "salam_add", add_ty)
    entry := llvm.AppendBlock(ctx, add_fn, "entry")
    llvm.PositionAtEnd(b, entry)
    _r := llvm.Ret(b, llvm.Add(b, llvm.Param(add_fn, 0), llvm.Param(add_fn, 1), "s"))

    v := llvm.Verify(m)
    if not v.ok:
        println "verify failed: " + v.err
        ret
    end

    tmr := llvm.NewTargetMachine("", llvm.OPT_O2, false)
    if not tmr.ok:
        println "no target machine: " + tmr.err
        ret
    end

    asm_path := os.TempDir() + "/salam_llvmapi_emit.s"
    ar := llvm.EmitAsm(m, tmr.tm, asm_path)
    if ar.ok:
        text := io.ReadFile(asm_path)
        if str.IndexFrom(text, "salam_add", 0) >= 0:
            println "assembly names salam_add"
        else:
            println "assembly missing the symbol"
        end
    else:
        println "asm failed: " + ar.err
    end

    obj_path := os.TempDir() + "/salam_llvmapi_emit.o"
    orr := llvm.EmitObject(m, tmr.tm, obj_path)
    if orr.ok and os.Exists(obj_path):
        println "object emitted"
    else:
        println "object failed: " + orr.err
    end

    llvm.FreeTargetMachine(tmr.tm)
    llvm.FreeBuilder(b)
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
