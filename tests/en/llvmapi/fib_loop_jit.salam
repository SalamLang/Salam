package main

import llvm
import io
import os
import str

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "fib")
    b := llvm.NewBuilder(ctx)
    i32 := llvm.Int32Type(ctx)

    mut none := Vector {} as Vector<llvm.Type>
    defer none.Free()
    main_ty := llvm.FunctionType(i32, none, false)
    main_fn := llvm.AddFunction(m, "main", main_ty)

    entry := llvm.AppendBlock(ctx, main_fn, "entry")
    loop := llvm.AppendBlock(ctx, main_fn, "loop")
    done := llvm.AppendBlock(ctx, main_fn, "done")

    llvm.PositionAtEnd(b, entry)
    _br := llvm.Br(b, loop)

    llvm.PositionAtEnd(b, loop)
    i_phi := llvm.Phi(b, i32, "i")
    a_phi := llvm.Phi(b, i32, "a")
    b_phi := llvm.Phi(b, i32, "b")
    sum := llvm.Add(b, a_phi, b_phi, "sum")
    i_next := llvm.Add(b, i_phi, llvm.ConstInt(i32, 1 as i64), "inext")
    more := llvm.ICmp(b, llvm.INT_SLT, i_next, llvm.ConstInt(i32, 10 as i64), "more")
    _cbr := llvm.CondBr(b, more, loop, done)

    mut from := Vector {} as Vector<llvm.BasicBlock>
    defer from.Free()
    from.Push(entry)
    from.Push(loop)

    mut i_vals := Vector {} as Vector<llvm.Value>
    defer i_vals.Free()
    i_vals.Push(llvm.ConstInt(i32, 0 as i64))
    i_vals.Push(i_next)
    llvm.AddIncoming(i_phi, i_vals, from)

    mut a_vals := Vector {} as Vector<llvm.Value>
    defer a_vals.Free()
    a_vals.Push(llvm.ConstInt(i32, 0 as i64))
    a_vals.Push(b_phi)
    llvm.AddIncoming(a_phi, a_vals, from)

    mut b_vals := Vector {} as Vector<llvm.Value>
    defer b_vals.Free()
    b_vals.Push(llvm.ConstInt(i32, 1 as i64))
    b_vals.Push(sum)
    llvm.AddIncoming(b_phi, b_vals, from)

    llvm.PositionAtEnd(b, done)
    _r := llvm.Ret(b, b_phi)

    v := llvm.Verify(m)
    if not v.ok:
        println "verify failed: " + v.err
        ret
    end

    path := os.TempDir() + "/salam_llvmapi_fib.ll"
    if io.WriteFile(path, llvm.ModuleToString(m)) < 0:
        println "could not write the module"
        ret
    end
    out := llvm.RunJIT(path)
    if out.ok:
        println "fib(10) = " + str.FromInt(out.rc as i64)
    else:
        println "jit failed: " + out.err
    end

    llvm.FreeBuilder(b)
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
