package main

import llvm
import io
import os
import str

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "fib")
    b := llvm.NewBuilder(ctx)
    i32 := llvm.Int32Type(ctx)

    mut none := Vector {} as Vector<llvm.Type>
    defer none.free()
    main ty := llvm.FunctionType(i32, none, false)
    main fn := llvm.AddFunction(m, "main", main ty)

    entry := llvm.AppendBlock(ctx, main fn, "entry")
    loop := llvm.AppendBlock(ctx, main fn, "loop")
    done := llvm.AppendBlock(ctx, main fn, "done")

    llvm.PositionAtEnd(b, entry)
    _br := llvm.Br(b, loop)

    llvm.PositionAtEnd(b, loop)
    i phi := llvm.Phi(b, i32, "i")
    a phi := llvm.Phi(b, i32, "a")
    b phi := llvm.Phi(b, i32, "b")
    sum := llvm.Add(b, a phi, b phi, "sum")
    i next := llvm.Add(b, i phi, llvm.ConstInt(i32, 1 as i64), "inext")
    more := llvm.ICmp(b, llvm.INT_SLT, i next, llvm.ConstInt(i32, 10 as i64), "more")
    _cbr := llvm.CondBr(b, more, loop, done)

    mut from := Vector {} as Vector<llvm.BasicBlock>
    defer from.free()
    from.push(entry)
    from.push(loop)

    mut i vals := Vector {} as Vector<llvm.Value>
    defer i vals.free()
    i vals.push(llvm.ConstInt(i32, 0 as i64))
    i vals.push(i next)
    llvm.AddIncoming(i phi, i vals, from)

    mut a vals := Vector {} as Vector<llvm.Value>
    defer a vals.free()
    a vals.push(llvm.ConstInt(i32, 0 as i64))
    a vals.push(b phi)
    llvm.AddIncoming(a phi, a vals, from)

    mut b vals := Vector {} as Vector<llvm.Value>
    defer b vals.free()
    b vals.push(llvm.ConstInt(i32, 1 as i64))
    b vals.push(sum)
    llvm.AddIncoming(b phi, b vals, from)

    llvm.PositionAtEnd(b, done)
    _r := llvm.Ret(b, b phi)

    v := llvm.Verify(m)
    if !v.ok:
        println "verify failed: " + v.err
        ret
    end

    path := os.TempDir() + "/salam_llvmapi_fib.ll"
    if io.WriteFile(path, llvm.ModuleToString(m)) < 0:
        println "could not write the module"
        ret
    end
    out := llvm.RunJIT(path)
    if out.ok:
        println "fib(10) = " + str.FromInt(out.rc as i64)
    else:
        println "jit failed: " + out.err
    end

    llvm.FreeBuilder(b)
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
