package main

import llvm

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "hello")
    b := llvm.NewBuilder(ctx)

    i32 := llvm.Int32Type(ctx)
    ptr := llvm.PointerType(ctx)

    mut one_ptr := Vector {} as Vector<llvm.Type>
    defer one_ptr.Free()
    one_ptr.Push(ptr)
    puts_ty := llvm.FunctionType(i32, one_ptr, false)
    puts_fn := llvm.AddFunction(m, "puts", puts_ty)

    mut no_args := Vector {} as Vector<llvm.Type>
    defer no_args.Free()
    main_ty := llvm.FunctionType(i32, no_args, false)
    main_fn := llvm.AddFunction(m, "main", main_ty)

    entry := llvm.AppendBlock(ctx, main_fn, "entry")
    llvm.PositionAtEnd(b, entry)

    msg := llvm.GlobalString(b, "Hello, world!", "msg")
    mut call_args := Vector {} as Vector<llvm.Value>
    defer call_args.Free()
    call_args.Push(msg)
    _call := llvm.Call(b, puts_ty, puts_fn, call_args, "")
    _ret := llvm.Ret(b, llvm.ConstInt(i32, 0 as i64))

    v := llvm.Verify(m)
    if not v.ok:
        println "verify failed: " + v.err
        ret
    end
    print llvm.ModuleToString(m)

    llvm.FreeBuilder(b)
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
