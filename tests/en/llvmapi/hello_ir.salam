package main

import llvm

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "hello")
    b := llvm.NewBuilder(ctx)

    i32 := llvm.Int32Type(ctx)
    ptr := llvm.PointerType(ctx)

    mut one ptr := Vector {} as Vector<llvm.Type>
    defer one ptr.free()
    one ptr.push(ptr)
    puts ty := llvm.FunctionType(i32, one ptr, false)
    puts fn := llvm.AddFunction(m, "puts", puts ty)

    mut no args := Vector {} as Vector<llvm.Type>
    defer no args.free()
    main ty := llvm.FunctionType(i32, no args, false)
    main fn := llvm.AddFunction(m, "main", main ty)

    entry := llvm.AppendBlock(ctx, main fn, "entry")
    llvm.PositionAtEnd(b, entry)

    msg := llvm.GlobalString(b, "Hello, world!", "msg")
    mut call args := Vector {} as Vector<llvm.Value>
    defer call args.free()
    call args.push(msg)
    _call := llvm.Call(b, puts ty, puts fn, call args, "")
    _ret := llvm.Ret(b, llvm.ConstInt(i32, 0 as i64))

    v := llvm.Verify(m)
    if !v.ok:
        println "verify failed: " + v.err
        ret
    end
    print llvm.ModuleToString(m)

    llvm.FreeBuilder(b)
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
