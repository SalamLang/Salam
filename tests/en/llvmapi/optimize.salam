package main

import llvm
import str

func has(text: str, needle: str): str:
    if str.IndexFrom(text, needle, 0) >= 0:
        ret "yes"
    end
    ret "no"
end

func main:
    ctx := llvm.NewContext()
    m := llvm.NewModule(ctx, "folding")
    b := llvm.NewBuilder(ctx)
    i32 := llvm.Int32Type(ctx)

    mut one int := Vector {} as Vector<llvm.Type>
    defer one int.free()
    one int.push(i32)
    fn ty := llvm.FunctionType(i32, one int, false)
    fn v := llvm.AddFunction(m, "ident", fn ty)
    entry := llvm.AppendBlock(ctx, fn v, "entry")
    llvm.PositionAtEnd(b, entry)

    x := llvm.Param(fn v, 0)
    sum := llvm.Add(b, x, llvm.ConstInt(i32, 0 as i64), "sum")
    scaled := llvm.Mul(b, sum, llvm.ConstInt(i32, 1 as i64), "scaled")
    _r := llvm.Ret(b, scaled)

    before := llvm.ModuleToString(m)
    println "before: add=" + has(before, " add ") + " mul=" + has(before, " mul ")

    tmr := llvm.NewTargetMachine("", llvm.OPT_O2, false)
    if !tmr.ok:
        println "no target machine: " + tmr.err
        ret
    end
    o := llvm.RunOpt(m, tmr.tm, llvm.OPT_O2)
    if !o.ok:
        println "opt failed: " + o.err
        ret
    end

    after := llvm.ModuleToString(m)
    println "after:  add=" + has(after, " add ") + " mul=" + has(after, " mul ")
    println "returns the argument: " + has(after, "ret i32 %0")

    llvm.FreeTargetMachine(tmr.tm)
    llvm.FreeBuilder(b)
    llvm.FreeModule(m)
    llvm.FreeContext(ctx)
end
