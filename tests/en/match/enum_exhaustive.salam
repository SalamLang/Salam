enum Color:
    red,
    green,
    blue
end

func name_of(c: Color): str:
    ret match c:
        red => "warm"
        green, blue => "cool"
    end
end

func main:
    println name_of(Color.red)
    println name_of(Color.green)
    println name_of(Color.blue)
end
