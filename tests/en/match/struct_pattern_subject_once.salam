mut made := 0

struct Point:
    pub x: int = 0
    pub y: int = 0
end


func mk(a: int): Point:
    made += 1
    ret Point { x = a, y = a * 2 }
end

func main:
    match mk(3):
        Point{x = 1, y}:
            println "one " + y
        end
        Point{x, y}:
            println x + y
        end
    end
    println made
end
