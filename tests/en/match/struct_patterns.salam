struct Point:
    pub x: int = 0
    pub y: int = 0
end

enum Shape:
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty
end

func where(p: Point): str:
    ret match p:
        Point{x = 0, y = 0} => "origin"
        Point{x = 0, y} => "on y axis at " + y
        Point{x, y = 0} => "on x axis at " + x
        Point{x, y} if x == y => "diagonal " + x
        else => "somewhere"
    end
end

func kind(s: Shape): str:
    ret match s:
        Rect{w, h = 1.0} => "strip " + w
        Rect{w, h} => "rect " + w + "x" + h
        Circle{r} => "circle " + r
        Empty => "empty"
    end
end

func main:
    println where(Point {})
    println where(Point { x = 0, y = 5 })
    println where(Point { x = 7 })
    println where(Point { x = 3, y = 3 })
    println where(Point { x = 1, y = 2 })
    println kind(Shape.Rect(4.0, 1.0))
    println kind(Shape.Rect(2.0, 3.0))
    println kind(Shape.Circle(1.5))
    println kind(Shape.Empty)
end
