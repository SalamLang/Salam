func describe(v: i32 or f64 or str): str:
    ret match v:
        i32 n: "int " + n end
        f64 f: "float " + f end
        str s: "text " + s end
    end
end

func main:
    mut sample := 21 as (i32 or f64 or str)
    println describe(sample)
    sample = 21.5
    println describe(sample)
    sample = "offline"
    println describe(sample)
end
