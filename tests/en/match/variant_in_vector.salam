func main:
    mut v := Vector {} as Vector<Variant<int, str>>
    v.push(5 as Variant<int, str>)
    x := v.get(0)
    match x:
        int n:
            println n
        end
        str s:
            println s
        end
    end
    arr := [1 as Variant<int, str>, "x" as Variant<int, str>]
    match arr[1]:
        int n:
            println n
        end
        str t:
            println t
        end
    end
    v.free()
end
