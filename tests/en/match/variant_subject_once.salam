mut calls := 0

func make(k: int): int or str: calls++
    if k == 0:
        ret 7 as (int or str)
    end
    ret "s" as (int or str)
end

func main:
    r := match make(0):
        int n: n end
        str _t: 0 end
    end
    println r
    match make(1):
        int n:
            println n
        end
        str t:
            println t
            inner := match make(0):
                int m: m + 1 end
                str _u: 0 end
            end
            println inner
        end
    end
    println calls
end
