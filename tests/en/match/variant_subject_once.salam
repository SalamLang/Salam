mut calls := 0

func make(k: int): Variant<int, str>:
    calls += 1
    if k == 0:
        ret 7 as Variant<int, str>
    end
    ret "s" as Variant<int, str>
end

func main:
    r := match make(0):
        int n => n
        str _t => 0
    end
    println r
    match make(1):
        int n:
            println n
        end
        str t:
            println t
            inner := match make(0):
                int m => m + 1
                str _u => 0
            end
            println inner
        end
    end
    println calls
end
