// Links the dependency-free native/mock/opencv_mock.c stand-in instead of
// the real OpenCV-backed shim - see opencv.salam's `if !SALAM_OPENCV_MOCK:`
// guard. Built once per test run (see run-tests.sh's "opencv" section) into
// $WORK/opencvwork/.work/libsalam_opencv_mock.a; run-one-build.sh symlinks
// that directory to "ocvtests" inside each job's working directory so the
// relative "-Locvtests/.work" below resolves. Mirrors tests/en/db/
// _linkmock.salam's "-Ltests/.work" trick exactly (renamed to avoid
// colliding with that unrelated symlink in the same job directory).
package linkmock
link dynamic "-Locvtests/.work"
link dynamic "salam_opencv_mock"
