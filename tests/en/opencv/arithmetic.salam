import opencv
import "_linkmock.salam"

func main:
    a := opencv.NewBlank(4, 4, 1, opencv.RGB(100, 100, 100))
    b := opencv.NewBlank(4, 4, 1, opencv.RGB(40, 40, 40))

    blended := a.blend(b, 0.5, 0.5, 0.0)
    println blended.at(0, 0).r

    blended_gamma := a.blend(b, 1.0, 0.0, 10.0)
    println blended_gamma.at(0, 0).r

    x := opencv.NewBlank(2, 2, 1, opencv.RGB(12, 12, 12))
    y := opencv.NewBlank(2, 2, 1, opencv.RGB(10, 10, 10))

    anded := x.bitwise(y, opencv.BITWISE_AND)
    println anded.at(0, 0).r
    ored := x.bitwise(y, opencv.BITWISE_OR)
    println ored.at(0, 0).r
    xored := x.bitwise(y, opencv.BITWISE_XOR)
    println xored.at(0, 0).r

    notted := x.bitwise_not()
    println notted.at(0, 0).r

    diffed := x.abs_diff(y)
    println diffed.at(0, 0).r
    diffed_rev := y.abs_diff(x)
    println diffed_rev.at(0, 0).r

    small := opencv.NewBlank(1, 1, 1, opencv.RGB(0, 0, 0))
    mismatched := a.blend(small, 0.5, 0.5, 0.0)
    println mismatched.ok()
    println opencv.LastError() != ""

    defer a.free()
    defer b.free()
    defer x.free()
    defer y.free()
    defer small.free()
    ret 0
end
