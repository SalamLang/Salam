import opencv
import "_linkmock.salam"

func main:
    img := opencv.NewBlank(4, 4, 3, opencv.RGB(90, 150, 30))

    gray := img.to_gray()
    println gray.channels()
    gc := gray.at(0, 0)
    println gc.r, gc.g, gc.b

    back := gray.to_rgb()
    println back.channels()
    bc := back.at(0, 0)
    println bc.r, bc.g, bc.b

    // to_gray on an already-gray Mat is a plain clone (no channel change)
    regray := gray.to_gray()
    println regray.channels()

    // to_rgb on an already multi-channel Mat is a plain clone
    reback := back.to_rgb()
    println reback.channels()

    direct := img.convert_color(opencv.COLOR_BGR2GRAY)
    println direct.channels()
    dc := direct.at(0, 0)
    println dc.r, dc.g, dc.b

    hsv := img.to_hsv()
    println hsv.channels()
    rgb_back := hsv.hsv_to_rgb()
    hbc := rgb_back.at(0, 0)
    println hbc.r, hbc.g, hbc.b

    // COLOR_RGB2GRAY/RGB2HSV/HSV2RGB (codes 2/8/9) are real OpenCV codes
    // the mock deliberately doesn't implement (see opencv_mock.c's header
    // comment) - convert_color() must fail gracefully, not crash.
    unsupported := img.convert_color(opencv.COLOR_RGB2GRAY)
    println unsupported.ok()
    println opencv.LastError() != ""

    img.free()
    gray.free()
    back.free()
    regray.free()
    reback.free()
    direct.free()
    hsv.free()
    rgb_back.free()
    ret 0
end
