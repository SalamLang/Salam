import opencv

include "_linkmock.salam"

func main:
    img := opencv.NewBlank(4, 4, 3, opencv.RGB(90, 150, 30))

    gray := img.ToGray()
    println gray.Channels()
    gc := gray.At(0, 0)
    println gc.r, gc.g, gc.b

    back := gray.ToRgb()
    println back.Channels()
    bc := back.At(0, 0)
    println bc.r, bc.g, bc.b

    regray := gray.ToGray()
    println regray.Channels()

    reback := back.ToRgb()
    println reback.Channels()

    direct := img.ConvertColor(opencv.COLOR_BGR2GRAY)
    println direct.Channels()
    dc := direct.At(0, 0)
    println dc.r, dc.g, dc.b

    hsv := img.ToHsv()
    println hsv.Channels()
    rgb_back := hsv.HsvToRgb()
    hbc := rgb_back.At(0, 0)
    println hbc.r, hbc.g, hbc.b

    unsupported := img.ConvertColor(opencv.COLOR_RGB2GRAY)
    println unsupported.Ok()
    println opencv.LastError() != ""

    defer img.Free()
    defer gray.Free()
    defer back.Free()
    defer regray.Free()
    defer reback.Free()
    defer direct.Free()
    defer hsv.Free()
    defer rgb_back.Free()
    ret 0
end
