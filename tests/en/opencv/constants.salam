// Locks in this package's own constant numbering (opencv.salam) as a
// regression guard - these are Salam-owned values (decoupled from
// cv::*'s own enums by design; see opencv.salam's header comment), so an
// accidental renumbering would silently break every caller storing a code
// in a variable/config, not just this test.
//
// Note: even though main() below only touches `pub const` values, every
// pub func in the opencv package still gets compiled into this binary
// (Salam includes a whole imported package, not just what main()
// transitively calls) - so this still needs the mock linked, exactly
// like every other test here, or link fails on the other pub funcs'
// scv_* calls.
import opencv
import "_linkmock.salam"

func main:
    println opencv.COLOR_BGR2GRAY, opencv.COLOR_GRAY2BGR, opencv.COLOR_RGB2GRAY,
        opencv.COLOR_GRAY2RGB, opencv.COLOR_BGR2RGB, opencv.COLOR_RGB2BGR,
        opencv.COLOR_BGR2HSV, opencv.COLOR_HSV2BGR, opencv.COLOR_RGB2HSV, opencv.COLOR_HSV2RGB

    println opencv.THRESH_BINARY, opencv.THRESH_BINARY_INV, opencv.THRESH_TRUNC,
        opencv.THRESH_TOZERO, opencv.THRESH_TOZERO_INV, opencv.THRESH_OTSU

    println opencv.ADAPTIVE_MEAN, opencv.ADAPTIVE_GAUSSIAN

    println opencv.INTERP_NEAREST, opencv.INTERP_LINEAR, opencv.INTERP_CUBIC,
        opencv.INTERP_AREA, opencv.INTERP_LANCZOS4

    println opencv.ROTATE_90_CW, opencv.ROTATE_180, opencv.ROTATE_90_CCW

    println opencv.FLIP_VERTICAL, opencv.FLIP_HORIZONTAL, opencv.FLIP_BOTH

    println opencv.MORPH_OPEN, opencv.MORPH_CLOSE, opencv.MORPH_GRADIENT,
        opencv.MORPH_TOPHAT, opencv.MORPH_BLACKHAT

    println opencv.BITWISE_AND, opencv.BITWISE_OR, opencv.BITWISE_XOR

    println opencv.NORM_HAMMING, opencv.NORM_L2

    ret 0
end
