import opencv
import "_linkmock.salam"

func main:
    img := opencv.NewBlank(10, 10, 1, opencv.RGB(255, 255, 255))
    cs := img.find_contours()
    println cs.ok()
    println opencv.LastError() != ""

    println cs.count()
    println cs.point_count(0)
    p := cs.point(0, 0)
    println p.x, p.y
    println cs.area(0)
    r := cs.bounding_rect(0)
    println r.x, r.y, r.width, r.height

    before := img.clone()
    img.draw_contour(cs, -1, opencv.RGB(0, 255, 0), 2)
    println before.at(0, 0).r == img.at(0, 0).r

    defer cs.free()
    defer img.free()
    defer before.free()
    ret 0
end
