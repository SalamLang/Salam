import opencv

include "_linkmock.salam"

func main:
    img := opencv.NewBlank(10, 10, 1, opencv.RGB(255, 255, 255))
    cs := img.FindContours()
    println cs.Ok()
    println opencv.LastError() != ""

    println cs.Count()
    println cs.PointCount(0)
    p := cs.Point(0, 0)
    println p.x, p.y
    println cs.Area(0)
    r := cs.BoundingRect(0)
    println r.x, r.y, r.width, r.height

    before := img.Clone()
    img.DrawContour(cs, -1, opencv.RGB(0, 255, 0), 2)
    println before.At(0, 0).r == img.At(0, 0).r

    defer cs.Free()
    defer img.Free()
    defer before.Free()
    ret 0
end
