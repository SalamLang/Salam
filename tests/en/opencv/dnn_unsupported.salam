// DNN inference needs a real OpenCV dnn module + model file; the mock
// doesn't reimplement it - verifies graceful failure across the whole
// Net lifecycle and that ParseSSDDetections handles an empty/null output
// Mat safely.
import opencv
import "_linkmock.salam"

func main:
    net := opencv.LoadNet("model.onnx", "")
    println net.ok()
    println opencv.LastError() != ""

    same := opencv.LoadNetSingleFile("model.onnx")
    println same.ok()

    img := opencv.NewBlank(8, 8, 3, opencv.RGB(1, 2, 3))
    ok := net.set_input(img, 1.0, opencv.RGB(0, 0, 0), true, opencv.Size { width = 4, height = 4 })
    println ok

    out := net.forward()
    println out.ok()

    named := net.forward_layer("output")
    println named.ok()

    detections := opencv.ParseSSDDetections(out, 8, 8, 0.5) as Vector<opencv.Detection>
    println detections.len()

    net.free()
    same.free()
    img.free()
    ret 0
end
