import opencv
import "_linkmock.salam"

func main:
    canvas := opencv.NewBlank(20, 20, 3, opencv.RGB(0, 0, 0))

    canvas.line(0, 0, 5, 0, opencv.RGB(255, 0, 0), 1)
    println canvas.at(0, 0).r, canvas.at(3, 0).r, canvas.at(10, 0).r

    canvas.rectangle(10, 10, 5, 5, opencv.RGB(0, 255, 0), -1) // filled
    println canvas.at(12, 12).g // inside, filled
    println canvas.at(0, 15).g  // outside

    canvas.circle(15, 5, 3, opencv.RGB(0, 0, 255), -1) // filled
    println canvas.at(15, 5).b  // center, inside
    println canvas.at(19, 19).b // far corner, untouched

    canvas.ellipse(5, 15, 3, 2, 0.0, opencv.RGB(200, 200, 0), -1)
    println canvas.at(5, 15).r, canvas.at(5, 15).g // center of filled ellipse

    poly := Vector {} as Vector<opencv.Point>
    poly.push(opencv.Point { x = 0, y = 19 })
    poly.push(opencv.Point { x = 5, y = 19 })
    poly.push(opencv.Point { x = 5, y = 15 })
    canvas.polylines(poly, true, opencv.RGB(9, 9, 9), 1)
    println canvas.at(0, 19).r

    fillcanvas := opencv.NewBlank(10, 10, 3, opencv.RGB(0, 0, 0))
    tri := Vector {} as Vector<opencv.Point>
    tri.push(opencv.Point { x = 1, y = 1 })
    tri.push(opencv.Point { x = 8, y = 1 })
    tri.push(opencv.Point { x = 8, y = 8 })
    fillcanvas.fill_poly(tri, opencv.RGB(77, 88, 99))
    inside := fillcanvas.at(6, 3)
    outside := fillcanvas.at(1, 8)
    println inside.r, inside.g, inside.b
    println outside.r, outside.g, outside.b

    // put_text isn't implemented in the mock; it must not crash and must
    // leave pixels untouched (an honest no-op, not a partial draw).
    before := canvas.clone()
    canvas.put_text("hi", 1, 1, 1.0, opencv.RGB(255, 255, 255), 1)
    println before.at(1, 1).r == canvas.at(1, 1).r

    defer canvas.free()
    defer fillcanvas.free()
    defer before.free()
    ret 0
end
