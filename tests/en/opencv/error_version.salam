import ai.opencv

include "_linkmock.salam"

func main:
    println opencv.Available()
    println opencv.Version() != ""

    bad := opencv.LoadCascade("nope.xml")
    println opencv.LastError() != ""

    ok_mat := opencv.NewBlank(2, 2, 1, opencv.RGB(1, 1, 1))
    println ok_mat.ok()

    defer bad.Free()
    defer ok_mat.Free()
    ret 0
end
