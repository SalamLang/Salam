import opencv
import "_linkmock.salam"

func main:
    println opencv.Available()
    println opencv.Version() != ""

    // a failing call sets LastError to a non-empty message
    bad := opencv.LoadCascade("nope.xml")
    println opencv.LastError() != ""

    // a successful call doesn't necessarily clear LastError to empty in
    // general, but a fresh op that itself succeeds must not report failure
    // through .ok() - the two are checked independently, never conflated.
    ok_mat := opencv.NewBlank(2, 2, 1, opencv.RGB(1, 1, 1))
    println ok_mat.ok()

    bad.free()
    ok_mat.free()
    ret 0
end
