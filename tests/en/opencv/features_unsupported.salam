import opencv

include "_linkmock.salam"

func main:
    img := opencv.NewBlank(10, 10, 1, opencv.RGB(128, 128, 128))

    corners := img.GoodFeatures(50, 0.01, 5.0) as Vector<opencv.Point>
    println corners.Len()

    orb := img.DetectOrb(500)
    println orb.Ok()
    println opencv.LastError() != ""
    println orb.Count()
    kp := orb.Get(0)
    println kp.x, kp.y, kp.size, kp.angle, kp.response
    desc := orb.Descriptors()
    println desc.Ok()

    sift := img.DetectSift(500)
    println sift.Ok()

    matches := opencv.MatchDescriptors(desc, desc, 10, opencv.NORM_HAMMING) as Vector<opencv.Match>
    println matches.Len()

    defer orb.Free()
    defer sift.Free()
    defer img.Free()
    ret 0
end
