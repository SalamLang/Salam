// Corner/keypoint detection and matching are real OpenCV algorithms the
// dependency-free mock doesn't reimplement - verifies graceful failure
// across good_features/detect_orb/detect_sift/MatchDescriptors and that
// the Keypoints accessor surface degrades safely when handle == null.
import opencv
import "_linkmock.salam"

func main:
    img := opencv.NewBlank(10, 10, 1, opencv.RGB(128, 128, 128))

    corners := img.good_features(50, 0.01, 5.0) as Vector<opencv.Point>
    println corners.len()

    orb := img.detect_orb(500)
    println orb.ok()
    println opencv.LastError() != ""
    println orb.count()
    kp := orb.get(0)
    println kp.x, kp.y, kp.size, kp.angle, kp.response
    desc := orb.descriptors()
    println desc.ok()

    sift := img.detect_sift(500)
    println sift.ok()

    matches := opencv.MatchDescriptors(desc, desc, 10, opencv.NORM_HAMMING) as Vector<opencv.Match>
    println matches.len()

    defer orb.free()
    defer sift.free()
    defer img.free()
    ret 0
end
