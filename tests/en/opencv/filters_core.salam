import opencv
import "_linkmock.salam"

func main:
    flat := opencv.NewBlank(5, 5, 1, opencv.RGB(50, 50, 50))
    blurred_flat := flat.blur(3)
    bc := blurred_flat.at(2, 2)
    println bc.r // uniform input stays uniform after averaging

    speck := opencv.NewBlank(5, 5, 1, opencv.RGB(0, 0, 0))
    speck.set_pixel(2, 2, opencv.RGB(255, 255, 255))
    blurred_speck := speck.blur(3)
    center := blurred_speck.at(2, 2)
    corner := blurred_speck.at(0, 0)
    println center.r > 0 && center.r < 255 // averaged down from 255
    println corner.r // untouched by the 3x3 window around (2,2)

    // On a 1-channel Mat, set_pixel/RGB() averages (r+g+b)/3 - use equal
    // triples (RGB(v, v, v)) so the stored gray value is exactly v.
    gray := opencv.NewBlank(4, 4, 1, opencv.RGB(0, 0, 0))
    gray.set_pixel(0, 0, opencv.RGB(200, 200, 200))
    gray.set_pixel(1, 0, opencv.RGB(100, 100, 100))
    gray.set_pixel(2, 0, opencv.RGB(50, 50, 50))

    bin := gray.threshold(90.0, 255.0, opencv.THRESH_BINARY)
    println bin.at(0, 0).r, bin.at(1, 0).r, bin.at(2, 0).r
    bin_inv := gray.threshold(90.0, 255.0, opencv.THRESH_BINARY_INV)
    println bin_inv.at(0, 0).r, bin_inv.at(1, 0).r, bin_inv.at(2, 0).r
    trunc := gray.threshold(90.0, 255.0, opencv.THRESH_TRUNC)
    println trunc.at(0, 0).r, trunc.at(1, 0).r, trunc.at(2, 0).r
    tozero := gray.threshold(90.0, 255.0, opencv.THRESH_TOZERO)
    println tozero.at(0, 0).r, tozero.at(1, 0).r, tozero.at(2, 0).r
    tozero_inv := gray.threshold(90.0, 255.0, opencv.THRESH_TOZERO_INV)
    println tozero_inv.at(0, 0).r, tozero_inv.at(1, 0).r, tozero_inv.at(2, 0).r

    // Otsu is not implemented in the mock - graceful failure.
    otsu := gray.threshold_otsu(255.0)
    println otsu.ok()
    println opencv.LastError() != ""

    hist := gray.histogram_gray()
    println hist.len()
    println hist.get(0) // count of value 0 (13 of the 16 pixels are black)
    println hist.get(200)
    println hist.get(100)
    println hist.get(50)

    defer flat.free()
    defer blurred_flat.free()
    defer speck.free()
    defer blurred_speck.free()
    defer gray.free()
    defer bin.free()
    defer bin_inv.free()
    defer trunc.free()
    defer tozero.free()
    defer tozero_inv.free()
    ret 0
end
