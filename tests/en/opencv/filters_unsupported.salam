// Gaussian/median blur, Canny and adaptive threshold are real algorithms
// the dependency-free mock honestly does not reimplement (see
// native/mock/opencv_mock.c's header comment) - this locks in the
// "graceful failure, not a crash" contract: null Mat + a LastError message,
// verified against the real OpenCV-backed shim instead (see examples/).
import opencv
import "_linkmock.salam"

func main:
    img := opencv.NewBlank(8, 8, 1, opencv.RGB(100, 100, 100))

    g := img.gaussian_blur(3, 1.0)
    println g.ok()
    println opencv.LastError() != ""

    m := img.median_blur(3)
    println m.ok()
    println opencv.LastError() != ""

    c := img.canny(50.0, 150.0)
    println c.ok()
    println opencv.LastError() != ""

    a := img.adaptive_threshold(255.0, opencv.ADAPTIVE_MEAN, opencv.THRESH_BINARY, 3, 2.0)
    println a.ok()
    println opencv.LastError() != ""

    // A failed Mat chains safely into further calls without crashing.
    chained := g.to_gray().resize(4, 4, opencv.INTERP_LINEAR).blur(3)
    println chained.ok()

    defer img.free()
    ret 0
end
