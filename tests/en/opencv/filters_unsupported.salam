import opencv

include "_linkmock.salam"

func main:
    img := opencv.NewBlank(8, 8, 1, opencv.RGB(100, 100, 100))

    g := img.GaussianBlur(3, 1.0)
    println g.Ok()
    println opencv.LastError() != ""

    m := img.MedianBlur(3)
    println m.Ok()
    println opencv.LastError() != ""

    c := img.Canny(50.0, 150.0)
    println c.Ok()
    println opencv.LastError() != ""

    a := img.AdaptiveThreshold(255.0, opencv.ADAPTIVE_MEAN, opencv.THRESH_BINARY, 3, 2.0)
    println a.Ok()
    println opencv.LastError() != ""

    chained := g.ToGray().Resize(4, 4, opencv.INTERP_LINEAR).Blur(3)
    println chained.Ok()

    defer img.Free()
    ret 0
end
