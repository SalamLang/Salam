// imshow needs a real GUI backend; the mock doesn't reimplement it - only
// verifies it doesn't crash and that WaitKey/DestroyWindow degrade safely
// (trackbars are covered separately in trackbar.salam - those ARE real in
// the mock).
import opencv
import "_linkmock.salam"

func main:
    img := opencv.NewBlank(4, 4, 3, opencv.RGB(1, 2, 3))
    opencv.Imshow("preview", img)
    println opencv.LastError() != ""

    key := opencv.WaitKey(1)
    println key

    opencv.DestroyWindow("preview")
    opencv.DestroyAllWindows()
    println "no crash"

    img.free()
    ret 0
end
