import opencv
import image
import "_linkmock.salam"

func main:
    src := image.New(3, 3)
    image.SetPixel(src, 0, 0, image.RGBA(10, 20, 30, 128))
    image.SetPixel(src, 1, 1, image.RGBA(200, 100, 50, 255))

    mat := opencv.FromImage(src)
    println mat.ok()
    println mat.width(), mat.height(), mat.channels()

    c00 := mat.at(0, 0)
    println c00.r, c00.g, c00.b // alpha dropped, RGB preserved
    c11 := mat.at(1, 1)
    println c11.r, c11.g, c11.b

    back := opencv.ToImage(mat)
    println back.width, back.height
    b00 := image.GetPixel(back, 0, 0)
    println b00.r, b00.g, b00.b, b00.a // alpha forced fully opaque
    b11 := image.GetPixel(back, 1, 1)
    println b11.r, b11.g, b11.b, b11.a

    // an empty/zero-sized Image converts to an empty Mat
    empty_img := image.New(0, 0)
    empty_mat := opencv.FromImage(empty_img)
    println empty_mat.ok()

    // a null-handle Mat converts to a zero-sized Image, not a crash
    empty_mat2 := opencv.Mat { handle = null }
    back_empty := opencv.ToImage(empty_mat2)
    println back_empty.width, back_empty.height

    image.Free(src)
    defer mat.free()
    image.Free(back)
    ret 0
end
