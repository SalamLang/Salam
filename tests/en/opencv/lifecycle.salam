import ai.opencv

include "_linkmock.salam"

func main:
    println opencv.Available()

    blank := opencv.NewBlank(16, 10, 3, opencv.RGB(10, 20, 30))
    println blank.ok()
    println blank.empty()
    println blank.width()
    println blank.height()
    println blank.channels()
    println blank.total()

    sz := blank.Size()
    println sz.width
    println sz.height

    zeros := opencv.Zeros(4, 4, 1)
    println zeros.width(), zeros.height(), zeros.channels()

    clone := blank.Clone()
    println clone.width(), clone.height(), clone.channels()
    println clone.handle != blank.handle

    empty := opencv.Mat { handle = null }
    println empty.ok()
    println empty.empty()
    println empty.width()
    println empty.height()
    println empty.channels()
    println empty.total()
    println empty.Size().width, empty.Size().height

    dataptr := blank.data()
    println dataptr != null
    println blank.Step()

    blank.Free()
    println blank.ok()
    defer zeros.Free()
    defer clone.Free()

    ret 0
end
