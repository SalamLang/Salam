import opencv

include "_linkmock.salam"

func main:
    speck := opencv.NewBlank(5, 5, 1, opencv.RGB(0, 0, 0))
    speck.SetPixel(2, 2, opencv.RGB(255, 255, 255))

    eroded := speck.Erode(3, 1)
    println eroded.At(2, 2).r

    dilated := speck.Dilate(3, 1)
    println dilated.At(1, 1).r, dilated.At(2, 2).r, dilated.At(3, 3).r

    opened := speck.Morphology(opencv.MORPH_OPEN, 3)
    println opened.At(2, 2).r

    closed := speck.Morphology(opencv.MORPH_CLOSE, 3)
    println closed.At(1, 1).r, closed.At(2, 2).r

    grad := speck.Morphology(opencv.MORPH_GRADIENT, 3)
    println grad.ok()
    println opencv.LastError() != ""

    defer speck.Free()
    defer eroded.Free()
    defer dilated.Free()
    defer opened.Free()
    defer closed.Free()
    ret 0
end
