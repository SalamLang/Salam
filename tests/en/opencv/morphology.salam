import opencv
import "_linkmock.salam"

func main:
    // A single white speck on black: erode (min filter) should wipe it out;
    // dilate (max filter) should grow it into its neighbors.
    speck := opencv.NewBlank(5, 5, 1, opencv.RGB(0, 0, 0))
    speck.set_pixel(2, 2, opencv.RGB(255, 255, 255))

    eroded := speck.erode(3, 1)
    println eroded.at(2, 2).r // the speck's own min-neighborhood includes black -> wiped

    dilated := speck.dilate(3, 1)
    println dilated.at(1, 1).r, dilated.at(2, 2).r, dilated.at(3, 3).r // grown into neighbors

    opened := speck.morphology(opencv.MORPH_OPEN, 3)
    println opened.at(2, 2).r // erode-then-dilate: a 1px speck doesn't survive opening

    closed := speck.morphology(opencv.MORPH_CLOSE, 3)
    println closed.at(1, 1).r, closed.at(2, 2).r // dilate-then-erode: speck survives closing, thinned

    // GRADIENT/TOPHAT/BLACKHAT are not implemented in the mock.
    grad := speck.morphology(opencv.MORPH_GRADIENT, 3)
    println grad.ok()
    println opencv.LastError() != ""

    speck.free()
    eroded.free()
    dilated.free()
    opened.free()
    closed.free()
    ret 0
end
