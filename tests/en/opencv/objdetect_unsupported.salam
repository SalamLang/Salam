// Haar-cascade loading/detection needs real OpenCV; the mock doesn't
// reimplement it - verifies graceful failure for both a bad path and a
// well-formed-looking one, and that detect() on a dead classifier is a
// safe empty result rather than a crash.
import opencv
import "_linkmock.salam"

func main:
    bad := opencv.LoadCascade("this/path/does/not/exist.xml")
    println bad.ok()
    println opencv.LastError() != ""

    img := opencv.NewBlank(10, 10, 1, opencv.RGB(128, 128, 128))
    faces := bad.detect(img, 1.1, 3, 10) as Vector<opencv.DetectedObject>
    println faces.len()

    bad.free()
    println bad.ok()
    img.free()
    ret 0
end
