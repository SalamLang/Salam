import opencv

include "_linkmock.salam"

func main:
    img := opencv.NewBlank(5, 5, 3, opencv.RGB(1, 2, 3))

    c := img.At(0, 0)
    println c.r, c.g, c.b

    img.SetPixel(2, 2, opencv.RGB(200, 150, 50))
    got := img.At(2, 2)
    println got.r, got.g, got.b

    other := img.At(0, 0)
    println other.r, other.g, other.b

    oob := img.At(-1, -1)
    println oob.r, oob.g, oob.b
    img.SetPixel(999, 999, opencv.RGB(9, 9, 9))
    println img.Width(), img.Height()

    gray := opencv.NewBlank(3, 3, 1, opencv.RGB(77, 0, 0))
    gc := gray.At(1, 1)
    println gc.r, gc.g, gc.b

    defer img.Free()
    defer gray.Free()
    ret 0
end
