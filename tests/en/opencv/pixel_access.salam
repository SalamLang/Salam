import opencv
import "_linkmock.salam"

func main:
    img := opencv.NewBlank(5, 5, 3, opencv.RGB(1, 2, 3))

    c := img.at(0, 0)
    println c.r, c.g, c.b

    img.set_pixel(2, 2, opencv.RGB(200, 150, 50))
    got := img.at(2, 2)
    println got.r, got.g, got.b

    // unchanged neighbor
    other := img.at(0, 0)
    println other.r, other.g, other.b

    // out of bounds reads/writes are safe no-ops
    oob := img.at(-1, -1)
    println oob.r, oob.g, oob.b
    img.set_pixel(999, 999, opencv.RGB(9, 9, 9))
    println img.width(), img.height()

    gray := opencv.NewBlank(3, 3, 1, opencv.RGB(77, 0, 0))
    gc := gray.at(1, 1)
    println gc.r, gc.g, gc.b

    defer img.free()
    defer gray.free()
    ret 0
end
