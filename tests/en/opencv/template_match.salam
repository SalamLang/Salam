import opencv
import "_linkmock.salam"

func main:
    scene := opencv.NewBlank(20, 20, 1, opencv.RGB(0, 0, 0))
    // paint a distinct 3x3 patch at (12, 7)
    mut y := 0
    until y < 3:
        mut x := 0
        until x < 3:
            scene.set_pixel(12 + x, 7 + y, opencv.RGB(200, 200, 200))
            x += 1
        end
        y += 1
    end

    tmpl := scene.crop(12, 7, 3, 3)
    m := scene.find_template(tmpl)
    println m.found
    println m.x, m.y

    // template larger than the search image fails gracefully
    big := opencv.NewBlank(30, 30, 1, opencv.RGB(1, 1, 1))
    bad := scene.find_template(big)
    println bad.found
    println opencv.LastError() != ""

    defer scene.free()
    defer tmpl.free()
    defer big.free()
    ret 0
end
