import opencv
import "_linkmock.salam"

func main:
    created := opencv.CreateTrackbar("thresh", "demo", 50, 255)
    println created
    println opencv.GetTrackbarPos("thresh", "demo")

    opencv.SetTrackbarPos("thresh", "demo", 200)
    println opencv.GetTrackbarPos("thresh", "demo")

    // A second, independently-named trackbar in the same window.
    opencv.CreateTrackbar("blur", "demo", 3, 21)
    println opencv.GetTrackbarPos("blur", "demo")
    println opencv.GetTrackbarPos("thresh", "demo") // unaffected by the other trackbar

    // Same trackbar name in a different window is independent.
    opencv.CreateTrackbar("thresh", "other", 10, 255)
    println opencv.GetTrackbarPos("thresh", "other")
    println opencv.GetTrackbarPos("thresh", "demo")

    // Querying a trackbar that was never created is a safe zero, not a crash.
    println opencv.GetTrackbarPos("nope", "nowhere")

    ret 0
end
