import opencv
import "_linkmock.salam"

func main:
    img := opencv.NewBlank(10, 6, 3, opencv.RGB(1, 2, 3))
    img.set_pixel(0, 0, opencv.RGB(255, 0, 0))
    img.set_pixel(9, 0, opencv.RGB(0, 255, 0))
    img.set_pixel(0, 5, opencv.RGB(0, 0, 255))
    img.set_pixel(9, 5, opencv.RGB(255, 255, 0))

    resized := img.resize(20, 12, opencv.INTERP_LINEAR)
    println resized.width(), resized.height()

    cropped := img.crop(2, 1, 4, 3)
    println cropped.width(), cropped.height()

    // rotate90 CW: top-left corner (red) moves to top-right
    r90 := img.rotate90(opencv.ROTATE_90_CW)
    println r90.width(), r90.height()
    rc := r90.at(r90.width() - 1, 0)
    println rc.r, rc.g, rc.b

    r180 := img.rotate90(opencv.ROTATE_180)
    println r180.width(), r180.height()
    r180c := r180.at(r180.width() - 1, r180.height() - 1)
    println r180c.r, r180c.g, r180c.b

    r90ccw := img.rotate90(opencv.ROTATE_90_CCW)
    println r90ccw.width(), r90ccw.height()

    // flip vertical: top-left (red) should end up bottom-left
    fv := img.flip(opencv.FLIP_VERTICAL)
    fvc := fv.at(0, fv.height() - 1)
    println fvc.r, fvc.g, fvc.b

    // flip horizontal: top-left (red) should end up top-right
    fh := img.flip(opencv.FLIP_HORIZONTAL)
    fhc := fh.at(fh.width() - 1, 0)
    println fhc.r, fhc.g, fhc.b

    fb := img.flip(opencv.FLIP_BOTH)
    fbc := fb.at(fb.width() - 1, fb.height() - 1)
    println fbc.r, fbc.g, fbc.b

    // rotate (arbitrary-angle rotation) is not implemented in the mock
    angled := img.rotate(45.0, 1.0)
    println angled.ok()
    println opencv.LastError() != ""

    img.free()
    resized.free()
    cropped.free()
    r90.free()
    r180.free()
    r90ccw.free()
    fv.free()
    fh.free()
    fb.free()
    ret 0
end
