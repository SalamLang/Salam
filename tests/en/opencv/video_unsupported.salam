import ai.opencv

include "_linkmock.salam"

func main:
    cam := opencv.OpenCamera(0)
    println cam.ok()
    println opencv.LastError() != ""

    frame := cam.Read()
    println frame.ok()
    println cam.fps()
    println cam.frame_count()
    cam.Close()
    println cam.ok()

    file_cap := opencv.OpenVideo("does-not-exist.mp4")
    println file_cap.ok()

    frame2 := opencv.NewBlank(4, 4, 3, opencv.RGB(1, 2, 3))
    writer := opencv.NewVideoWriter("out.mp4", "mp4v", 30.0, 4, 4)
    println writer.ok()
    println writer.Write(frame2)
    writer.Close()

    defer frame2.Free()
    ret 0
end
