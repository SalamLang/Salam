// Video capture/writing needs a real OpenCV videoio backend; the mock
// doesn't reimplement it - verifies graceful failure end to end.
import opencv
import "_linkmock.salam"

func main:
    cam := opencv.OpenCamera(0)
    println cam.ok()
    println opencv.LastError() != ""

    frame := cam.read()
    println frame.ok()
    println cam.fps()
    println cam.frame_count()
    cam.close()
    println cam.ok()

    file_cap := opencv.OpenVideo("does-not-exist.mp4")
    println file_cap.ok()

    frame2 := opencv.NewBlank(4, 4, 3, opencv.RGB(1, 2, 3))
    writer := opencv.NewVideoWriter("out.mp4", "mp4v", 30.0, 4, 4)
    println writer.ok()
    println writer.write(frame2)
    writer.close()

    defer frame2.free()
    ret 0
end
