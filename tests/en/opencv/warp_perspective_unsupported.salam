// A true perspective warp (homography solve) is out of scope for the
// dependency-free mock - verifies the graceful-failure contract, and that
// the ergonomic warp_perspective() argument marshaling (4-point Vector ->
// flat buffer) runs without crashing even though the native call fails.
import opencv
import "_linkmock.salam"

func main:
    img := opencv.NewBlank(20, 20, 3, opencv.RGB(10, 20, 30))

    quad := Vector {} as Vector<opencv.Point>
    quad.push(opencv.Point { x = 0, y = 0 })
    quad.push(opencv.Point { x = 19, y = 0 })
    quad.push(opencv.Point { x = 19, y = 19 })
    quad.push(opencv.Point { x = 0, y = 19 })

    out := img.warp_perspective(quad, 40, 40)
    println out.ok()
    println opencv.LastError() != ""

    // Wrong point count is rejected before ever reaching the native call.
    bad_quad := Vector {} as Vector<opencv.Point>
    bad_quad.push(opencv.Point { x = 0, y = 0 })
    bad_quad.push(opencv.Point { x = 1, y = 1 })
    bad := img.warp_perspective(bad_quad, 40, 40)
    println bad.ok()

    defer img.free()
    ret 0
end
