// EXPECT: pick-
// EXPECT-NOT: E012
mut chosen := ""

component Row(pick: func (str), code: str):
    button:
        id = "pick-" + code
        content = code
        click = ():
            pick(code)
        end
    end
end

component Rows:
    codes := Vector {} as Vector<str>
    box:
        button:
            click = (): codes.Push("a") codes.Push("b") end
            content = "add"
        end
        each code in codes:
            Row:
                code = code
                pick = (c: str):
                    chosen = c
                end
            end
        end
    end
end

page:
    paragraph:
        content = chosen
    end
    Rows: end
end
