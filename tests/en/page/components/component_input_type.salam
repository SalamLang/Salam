// EXPECT: <textarea name="bio"></textarea>
// EXPECT: <input type="password" name="pw">
// EXPECT: <input type="my-widget" name="w">
component Field(kind, label):
    box:
        input:
            type = kind
            name = label
        end
    end
end

page:
    Field:
        kind = "textarea"
        label = "bio"
    end
    Field:
        kind = "password"
        label = "pw"
    end
    Field:
        kind = "my-widget"
        label = "w"
    end
end
