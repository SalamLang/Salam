// EXPECT: window.__salam_bind = function (f) {
// EXPECT: __sal_request(
// EXPECT: function __sal_copy(text, done) {
// EXPECT: function __sal_query(name) {
// EXPECT: setTimeout(__sal_bind(
// EXPECT: salamWsAt(1,${salamWsCur(1)});
// EXPECT-NOT: E133
import dom
import web.browser

mut ref := browser.QueryParam("ref")

component Row(name: str):
    mut reply := "idle"
    item:
        button:
            id = "send-" + name
            content = name + " " + reply
            click = ():
                browser.PostJson(
                    "/echo", "{}", 5000, (status: int, text: str):
                    reply = status + " " + text
                    end
                )
            end
        end
        button:
            id = "later-" + name
            content = "later " + reply
            click = ():
                dom.SetTimeout((): reply = "late " + name end, 100)
            end
        end
        button:
            content = "copy"
            click = (): browser.CopyText(name, (done: bool): reply = "copied " + done end) end
        end
    end
end

component Rows:
    items := Vector {} as Vector<str>
    next := 0
    box:
        button:
            id = "add"
            click = (): items.Push("r" + next) next++ end
            content = "Add " + ref
        end
        list:
            each _, it in items:
                Row:
                    key = "row-" + it
                    name = it
                end
            end
        end
    end
end

page:
    title = "Requests"
    Rows: end
end
