// EXPECT: <p>slotted child</p>
component Wrap(heading):
    section:
        class = "wrap"
        heading:
            size = 3
            content = heading
        end
        content: end
    end
end
page:
    Wrap:
        heading = "Title"
        paragraph:
            content = "slotted child"
        end
    end
end
