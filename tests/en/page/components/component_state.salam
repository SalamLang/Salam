// EXPECT: <!--salam:0--><!--/salam:0-->
// EXPECT: <!--salam:1--><!--/salam:1-->
// EXPECT: let __salam_ws_0 = 0;
// EXPECT: let __salam_ws_1 = 10;
// EXPECT: salamWsTouch(0);
// EXPECT: function __salam_view_1() {
// EXPECT: <button id="a" onclick="__sl_ev_1()">
// EXPECT: var __salam_views = [__salam_view_0, __salam_view_1];
// EXPECT: function salamWsTouch(i) {
// EXPECT-NOT: ____salam
component Counter(name: str, start: int):
    count := start
    label := "clicks"
    box:
        button: id = name click = (): count++ end content = name + " " + count + " " + label end
    end
end

page:
    title = "State"
    heading: content = "Counters" end
    Counter: name = "a" start = 0 end
    Counter: name = "b" start = 10 end
end
