// EXPECT: <!--salam:0--><!--/salam:0-->
// EXPECT: salamWsSlot(1, `row-${it}`);
// EXPECT: if (salamWsFresh()) {
// EXPECT: salamWsAt(1,${salamWsCur(1)});
// EXPECT: let __salam_ws_2 = [];
// EXPECT: salamWsTouch(0);
// EXPECT: var __salam_views = [__salam_view_0, null];
// EXPECT: var __salam_inits = [__salam_init_0, null];
// EXPECT-NOT: E133
component Row(name: str):
    hits := 0
    item: id = "row-" + name click = (): hits++ end content = name + " " + hits end
end

component Rows:
    items := Vector {} as Vector<str>
    next := 0
    box:
        button: id = "add" click = (): items.push("r" + next) next++ end content = "Add" end
        button: id = "rot" click = (): items.insert(0, items.pop()) end content = "Rotate" end
        list:
            each it in items:
                Row: name = it end
            end
        end
    end
end

page:
    title = "Rows"
    Rows: end
end
