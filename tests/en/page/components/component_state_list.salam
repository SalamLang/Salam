// EXPECT: var __salam_inits = [__salam_init_0, __salam_init_1, __salam_init_2, __salam_init_3];
// EXPECT-NOT: E133
component Toggle(label: str):
    state open := false
    box:
        button: id = label + "-btn" click = (): open = not open end content = label end
        if open:
            paragraph: id = label + "-body" content = "Body of " + label end
        end
    end
end

component Todo:
    state items := Vector {} as Vector<str>
    state next := 0
    box:
        input: id = "todo-text" type = "text" end
        button: id = "todo-add" click = (): items.push("t" + next) next++ end content = "Add" end
        button: id = "todo-rot" click = (): items.insert(0, items.pop()) end content = "Rotate" end
        list:
            id = "todo-list"
            each it in items:
                item: key = it content = it end
            end
        end
    end
end

component Inner(name: str):
    state n := 0
    button: id = name click = (): n++ end content = name + " " + n end
end

component Outer:
    state show := true
    state m := 0
    box:
        button: id = "outer-toggle" click = (): show = not show end content = "toggle" end
        button: id = "outer-bump" click = (): m++ end content = "outer " + m end
        if show:
            Inner: name = "inner" end
        end
    end
end

page:
    title = "Rich"
    Toggle: label = "A" end
    Todo: end
    Outer: end
end
