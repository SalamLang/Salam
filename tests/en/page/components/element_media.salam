// EXPECT: @media (width > 1024px) { .a { width:300px; } }
// EXPECT: @media (width < 600px) { .b { padding:4px; } }
// EXPECT: @media (prefers-color-scheme: dark) { .b { background-color:#000000;background-image:none; } }
// EXPECT: @media (prefers-color-scheme: dark) { .b { color:#ffffff; } }
// EXPECT: @media (prefers-color-scheme: dark) { .c { background-color:#ff0000;background-image:none; } }
// EXPECT: @media (width < 600px){.s0-a{display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,column);--salam-rev:column-reverse}}
// EXPECT: salamWsStyle(1, 0, `${envx_compact && open ? "2" : ""}`)
// EXPECT: @media (width < 600px) { .card.
// EXPECT: @media (prefers-color-scheme: dark) { .card.
// EXPECT-NOT: .card { padding:2px
// EXPECT: @media print{@media (prefers-color-scheme: dark) { .
mut open := false

component Tag(shade: str):
    box:
        if page.dark:
            background = shade
        end
    end
end

component Card(title: str):
    box:
        padding = 16
        if page.compact:
            padding = 4
        end
        if page.dark:
            background = "black"
            color = "white"
        end
        paragraph: content = title end
    end
end

page:
    nav:
        layout = row
        if page.compact:
            layout = "column"
        end
        if page.compact and open:
            gap = 2
        end
        button: click = (): open = not open end content = "menu" end
    end
    box:
        id = "w"
        if page.wide:
            width = 300
        end
    end
    Card: title = "One" end
    Card: title = "Two" end
    Tag: shade = "red" end
    box: padding = 16 content = "plain" end
    box:
        class = "card"
        padding = 8
        if page.compact:
            padding = 2
        end
    end
    box:
        class = "card"
        padding = 8
        if page.dark:
            padding = 9
        end
    end
    box:
        padding = 1
        media:
            condition = "print"
            if page.dark:
                color = "gray"
            end
        end
    end
end
