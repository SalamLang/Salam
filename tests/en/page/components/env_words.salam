// EXPECT: function __salam_env_sync()
// EXPECT: window.matchMedia
// EXPECT: salamWsStyle(38, 0, `${envx_compact ? "4" : envx_wide ? "32" : "16"}`)
// EXPECT: salamWsStyle(114, 0, `${envx_dark ? "white" : "black"}`)
// EXPECT: salamWsStyle(1, 0, `${envx_touch && envx_w < 500 ? "12" : ""}`)
// EXPECT-NOT: dom_envx
// EXPECT-NOT: envx_watch
component Bar(label: str):
    open := false
    nav:
        id = "bar"
        padding = 16
        color = "black"
        if compact:
            padding = 4
        else if wide:
            padding = 32
        end
        if dark:
            color = "white"
        end
        if touch and screen width < 500:
            gap = 12
        end
        if reduced motion:
            transition = none
        end
        button: id = "toggle" click = (): open = not open end content = label end
    end
end

page:
    title = "Env"
    Bar: label = "Menu" end
end
