// EXPECT: function __salam_env_sync()
// EXPECT: window.matchMedia
// EXPECT: @media (width < 600px){.s0-a{padding:4px}}
// EXPECT: @media (width > 1024px) and not (width < 600px){.s0-a{padding:32px}}
// EXPECT: @media (prefers-color-scheme: dark){.s0-a{color:#ffffff}}
// EXPECT: @media (pointer: coarse) and (width < 500px){.s0-a{gap:12px}}
// EXPECT: @media (prefers-reduced-motion: reduce){.s0-a{transition-duration:0s;transition-delay:0s}}
// EXPECT-NOT: dom_envx
// EXPECT-NOT: envx_watch
component Bar(label: str):
    open := false
    nav:
        id = "bar"
        padding = 16
        color = "black"
        if compact:
            padding = 4
        else if wide:
            padding = 32
        end
        if dark:
            color = "white"
        end
        if touch and screen width < 500:
            gap = 12
        end
        if reduced motion:
            transition = none
        end
        button:
            id = "toggle"
            click = (): open = not open end
            content = label
        end
    end
end

page:
    title = "Env"
    Bar:
        label = "Menu"
    end
end
