component Bar(label: str):
    open := false
    nav:
        id = "bar"
        padding = 16
        color = "black"
        if compact:
            padding = 4
        else if wide:
            padding = 32
        end
        if dark:
            color = "white"
        end
        if touch and screen width < 500:
            gap = 12
        end
        if reduced motion:
            transition = none
        end
        button: id = "toggle" click = (): open = not open end content = label end
    end
end

page:
    title = "Env"
    Bar: label = "Menu" end
end
