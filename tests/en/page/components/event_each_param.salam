// EXPECT-NOT: E001
component Pick(name: str):
    item: id = "p-" + name click = (): picked = name end content = name end
end

mut picked := ""

component Rows:
    items := Vector {} as Vector<str>
    box:
        button: id = "add" click = (): items.Push("r1") items.Push("r2") end content = "Add" end
        list:
            each it in items:
                Pick: name = it end
            end
        end
    end
end

page:
    title = "Each parameter"
    paragraph: content = "picked " + picked end
    Rows: end
end
