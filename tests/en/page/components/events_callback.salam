// EXPECT: salamWsTouch(4);
// EXPECT: })(__salam_ws_0);
// EXPECT: })(__salam_ws_1);
// EXPECT-NOT: change(
// EXPECT-NOT: report(
mut total := 0

component Counter(name: str, change):
    count := 0
    button: id = name click = (): count++ change(count) end content = name + " " + count end
end

component Pair(report: func (int)):
    sum := 0
    box:
        paragraph: id = "sum" content = "sum " + sum end
        Counter:
            name = "a"
            change = (v: int):
                sum += v
                report(sum)
            end
        end
        Counter: name = "b" change = (v: int): sum += v * 10 end end
    end
end

page:
    title = "Callbacks"
    paragraph: id = "total" content = "total " + total end
    Pair: report = (v: int): total = v end end
    Counter: name = "solo" end
end
