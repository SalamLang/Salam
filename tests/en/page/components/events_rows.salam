// EXPECT: salamWsAt(1,${salamWsCur(1)});
// EXPECT: __salam_ws_0[salamWsCur(0)] = v;
// EXPECT: picks = ((picks + 1) | 0);
// EXPECT-NOT: emit(
mut groups := ["g1", "g2"]
mut rows := ["x", "y"]
mut picks := 0

component Row(group: str, name: str):
    state hits := 0
    state label := name
    item: key = name id = group + "-" + name click = (): hits++ emit("picked", label + hits) end content = name + " " + hits end
end

component Group(name: str):
    state picked := "-"
    box:
        id = name
        paragraph: id = name + "-p" content = name + " picked " + picked end
        list:
            each it in rows:
                Row: group = name name = it on picked = (v: str): picked = v end end
            end
        end
    end
end

page:
    title = "Rows"
    on picked = (): picks++ end
    paragraph: id = "picks" content = "picks " + picks end
    each g in groups:
        Group: name = g end
    end
end
