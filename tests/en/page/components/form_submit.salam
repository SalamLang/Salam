func remember():
    mark := 1
    println mark
end

component Counter(label: str):
    typed := ""
    box:
        form:
            id = label + "-form"
            submit = (): typed = "handled" end
            input:
                name = "q"
                aria label = "q"
            end
            button:
                id = label + "-send"
                type = "submit"
                content = "send"
            end
        end
        paragraph:
            id = label + "-out"
            content = "typed " + typed
        end
    end
end

component Rows:
    names := Vector {} as Vector<str>
    box:
        button:
            id = "add"
            click = (): names.Push("x") names.Push("y") end
            content = "add"
        end
        each _, name in names:
            box:
                key = name
                Counter: label = name end
            end
        end
    end
end

page:
    Counter: label = "a" end
    Counter: label = "b" end
    Rows: end
    form:
        id = "named"
        submit = remember
        button:
            id = "named-send"
            type = "submit"
            content = "named"
        end
    end
    form:
        id = "native"
        action = "native-target.html"
        input:
            name = "n"
            value = "1"
            aria label = "n"
        end
        button:
            id = "native-send"
            type = "submit"
            content = "native"
        end
    end
end
