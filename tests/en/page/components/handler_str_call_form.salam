// EXPECT: <input id="a" oninput="update_text(event.target.value || &#39;&#39;)">
// EXPECT: <input id="b" oninput="update_text(event.target.value || &#39;&#39;)">
// EXPECT: window["update_text"] = update_text;
mut seen := ""

func update_text(text: str):
    seen = text
end

page:
    title = "Call"
    box:
        input:
            id = "a"
            input = update_text
        end
        input:
            id = "b"
            input = update_text()
        end
    end
end
