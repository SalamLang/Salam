// EXPECT: id="t"
mut wide := false

page:
    title = "Branch ids"
    box:
        id = "x"
        if wide:
            paragraph:
                id = "t"
                content = "a"
            end
        else:
            paragraph:
                id = "t"
                content = "b"
            end
        end
    end
end
