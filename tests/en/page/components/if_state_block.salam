// EXPECT: salamWsStyle(61, 0, `${__salam_ws_0 ? "orange" : "blue"}`)
// EXPECT: salamWsStyle(61, 1, `${__salam_ws_0 ? "red" : "navy"}`)
component Seg(label: str):
    picked := false
    button:
        id = "seg"
        background = "blue"
        hover:
            background = "navy"
        end
        if picked:
            background = "orange"
            hover:
                background = "red"
            end
        end
        click = (): picked = not picked end
        content = label
    end
end

page:
    title = "If and state"
    Seg:
        label = "A"
    end
end
