// EXPECT-NOT: salamWsStyle(38
// EXPECT-NOT: __salam_ws_0 ? "red"
component Seg(label: str):
    picked := false
    button:
        id = "a"
        if false:
            padding = 8
        end
        if picked:
            color = "red"
        end
        color = "blue"
        click = ():
            picked = not picked
        end
        content = label
    end
end

page:
    title = "Edges"
    Seg: label = "A" end
end
