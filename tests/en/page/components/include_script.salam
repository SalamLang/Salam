// EXPECT: function rules_TitleProblem(
// EXPECT: msg = rules_TitleProblem("");
// EXPECT: function str_Repeat(
// EXPECT: function str_Len(
include rules "_inc_rules.salam"

mut msg := ""

func check():
    msg = rules.TitleProblem("")
end

page:
    title = "Rules"
    button: id = "check" click = check content = "Check" end
    paragraph: id = "msg" content = msg end
end
