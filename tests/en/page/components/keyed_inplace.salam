// EXPECT: salamWsRowIn()
// EXPECT: salamWsHit(
// EXPECT-NOT: E133
mut names := Vector {} as Vector<str>
mut labels := Vector {} as Vector<str>
mut picked := ""

func fill():
    names.Clear()
    labels.Clear()
    each it in ["a", "b", "c", "d", "e"]:
        names.Push(it)
        labels.Push(it + " one")
    end
end

func flip():
    mut n2 := Vector {} as Vector<str>
    mut l2 := Vector {} as Vector<str>
    repeat names.Len() in i:
        n2.Insert(0, names.Get(i))
        l2.Insert(0, labels.Get(i))
    end
    names.Clear()
    labels.Clear()
    repeat n2.Len() in j:
        names.Push(n2.Get(j))
        labels.Push(l2.Get(j))
    end
    n2.Free()
    l2.Free()
end

func rename(n: str, text: str):
    repeat names.Len() in i:
        if names.Get(i) == n:
            labels.Set(i, text)
        end
    end
end

component Line(name: str, label: str, lit: bool):
    item:
        key = name
        id = "row-" + name
        class = lit ? "on" : "off"
        span:
            id = "label-" + name
            content = label
        end
        button:
            id = "pick-" + name
            click = (): picked = name end
            content = "pick"
        end
        input:
            id = "in-" + name
            type = "text"
        end
        list:
            each _, w in label.Split(" "):
                item:
                    key = w
                    content = w
                end
            end
        end
    end
end

page:
    title = "Keyed in place"
    box:
        button:
            id = "fill"
            click = fill
            content = "Fill"
        end
        button:
            id = "rename-c"
            click = (): rename("c", "c two words") end
            content = "Rename c"
        end
        button:
            id = "amp"
            click = (): rename("c", "c & <co>") end
            content = "Amp"
        end
        button:
            id = "rename-d"
            click = (): rename("d", "d two") end
            content = "Rename d"
        end
        button:
            id = "rev"
            click = flip
            content = "Reverse"
        end
        button:
            id = "ins"
            click = (): names.Insert(1, "x") labels.Insert(1, "x one") end
            content = "Insert"
        end
        button:
            id = "drop"
            click = (): names.RemoveAt(1) labels.RemoveAt(1) end
            content = "Drop"
        end
    end
    list:
        id = "rows"
        each i, it in names:
            Line:
                name = it
                label = labels.Get(i)
                lit = it == picked
            end
        end
    end
    paragraph:
        id = "picked"
        content = "picked " + picked
    end
end
