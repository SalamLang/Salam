// EXPECT: salamWsRow(true)
// EXPECT: salamWsRow(false)
// EXPECT-NOT: E133
mut rows := Vector {} as Vector<str>

func fill():
    rows.Clear()
    each it in ["a", "b", "c", "d", "e"]:
        rows.Push(it)
    end
end

func swap_ends():
    first := rows.Get(0)
    rows.Set(0, rows.Get(rows.Len() - 1))
    rows.Set(rows.Len() - 1, first)
end

func reverse_rows():
    mut out := Vector {} as Vector<str>
    each it in rows:
        out.Insert(0, it)
    end
    rows.Clear()
    each it2 in out:
        rows.Push(it2)
    end
    out.Free()
end

page:
    title = "Keyed moves"
    box:
        button:
            id = "fill"
            click = fill
            content = "Fill"
        end
        button:
            id = "swap"
            click = swap_ends
            content = "Swap"
        end
        button:
            id = "drop"
            click = (): rows.RemoveAt(1) end
            content = "Drop"
        end
        button:
            id = "rev"
            click = reverse_rows
            content = "Reverse"
        end
        button:
            id = "add"
            click = (): rows.Push("f") end
            content = "Add"
        end
    end
    list:
        id = "rows"
        each _, it in rows:
            item:
                key = it
                id = "row-" + it
                span:
                    content = it
                end
                input:
                    id = "in-" + it
                    type = "text"
                end
            end
        end
    end
end
