// EXPECT: salamWsRow(true)
// EXPECT: salamWsRow(false)
// EXPECT-NOT: E133
mut rows := Vector {} as Vector<str>
mut last := ""

func fill():
    rows.Clear()
    each it in ["a", "b", "c", "d", "e"]:
        rows.Push(it)
    end
end

func swap_ends():
    first := rows.Get(0)
    rows.Set(0, rows.Get(rows.Len() - 1))
    rows.Set(rows.Len() - 1, first)
end

func reverse_rows():
    mut out := Vector {} as Vector<str>
    each it in rows:
        out.Insert(0, it)
    end
    rows.Clear()
    each it2 in out:
        rows.Push(it2)
    end
    out.Free()
end

component Row(name: str):
    hits := 0
    item:
        key = name
        id = "row-" + name
        span:
            content = name
        end
        button:
            id = "hit-" + name
            click = (): hits++ last = name end
            content = name + " " + hits
        end
        input:
            id = "in-" + name
            type = "text"
        end
    end
end

component Tag(name: str):
    taps := 0
    item:
        button:
            id = "tag-" + name
            click = (): taps++ last = name end
            content = name + " " + taps
        end
    end
end

page:
    title = "Keyed moves"
    box:
        button:
            id = "fill"
            click = fill
            content = "Fill"
        end
        button:
            id = "swap"
            click = swap_ends
            content = "Swap"
        end
        button:
            id = "drop"
            click = (): rows.RemoveAt(1) end
            content = "Drop"
        end
        button:
            id = "rev"
            click = reverse_rows
            content = "Reverse"
        end
        button:
            id = "add"
            click = (): rows.Push("f") end
            content = "Add"
        end
    end
    list:
        id = "rows"
        each _, it in rows:
            Row:
                name = it
            end
        end
    end
    list:
        id = "plain"
        each _, it in rows:
            Tag:
                name = it
            end
        end
    end
    paragraph:
        id = "last"
        content = "last " + last
    end
end
