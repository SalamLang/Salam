// EXPECT-NOT: E292
mut names := Vector {} as Vector<str>

func fill():
    names.Push("a")
    names.Push("b")
end

component Row(label: str):
    item:
        content = label
    end
end

component Keyed(key: str):
    item:
        content = key
    end
end

component Pair(label: str):
    term:
        content = label
    end
    description:
        content = label
    end
end

page:
    button:
        click = fill
        content = "fill"
    end
    list:
        each i, name in names:
            item:
                key = i
                content = name
            end
        end
        each one in names:
            item: key = one content = one end
        end
        each used in names:
            Row:
                key = "use-" + used
                label = used
            end
        end
        each own in names:
            Keyed:
                key = own
            end
        end
    end
    description list:
        each pair in names:
            Pair:
                key = pair
                label = pair
            end
        end
    end
    box:
        each j, branch in names:
            if j > 0:
                span:
                    key = branch
                    content = branch
                end
            else:
                bold:
                    key = branch + "!"
                    content = branch
                end
            end
        end
        each group in names:
            box:
                key = group
                each child in names:
                    span:
                        key = group + child
                        content = child
                    end
                end
            end
        end
    end
end
