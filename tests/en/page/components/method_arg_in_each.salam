// EXPECT-NOT: E001
component Bubble(who: str, text: str):
    box:
        if who == "me":
            background = #2563eb
        end
        paragraph: content = who + ": " + text end
    end
end

component Chat:
    names := Vector {} as Vector<str>
    lines := Vector {} as Vector<str>
    box:
        button: id = "add" click = (): names.Push("me") lines.Push("hi") end content = "Add" end
        list:
            each i, line in lines:
                item: key = i
                    Bubble: who = names.Get(i) text = line end
                end
            end
        end
    end
end

page:
    title = "Method call in a component argument"
    Chat: end
end
