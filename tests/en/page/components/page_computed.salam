// EXPECT: function __salam_view_0
// EXPECT: Hello from a function
func greeting(): str:
    ret "Hello from a function"
end

component Hero:
    sample := greeting()
    items := [1, 2]
    box:
        paragraph: content = sample end
        each i, n in items:
            paragraph:
                key = i
                content = "n " + n
            end
        end
    end
end

page:
    Hero: end
end
