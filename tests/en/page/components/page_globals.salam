// EXPECT: <!--salam:1--><!--/salam:1-->
// EXPECT: <!--salam:3--><!--/salam:3-->
// EXPECT: salamWsTouch(2);
// EXPECT: salamWsTouch(3);
// EXPECT: function __salam_view_3() {
// EXPECT: salamWsSlot(0,
// EXPECT-NOT: E129
// EXPECT-NOT: E133
mut total := 0
mut names := Vector {} as Vector<str>

func bump():
    total++
    names.Push("n" + total)
end

component Row(name: str):
    hits := 0
    item: key = name click = (): hits++ end content = name + " " + hits end
end

page:
    title = "Globals"
    paragraph: id = "total" content = "Total " + total end
    button: id = "bump" click = bump content = "Bump" end
    if total > 2:
        paragraph: id = "big" content = "Big" end
    end
    list:
        id = "names"
        each n in names:
            Row: name = n end
        end
    end
end
