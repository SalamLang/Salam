// EXPECT: @media (prefers-color-scheme: dark) { .a { color:#ffffff; } }
// EXPECT: @media (width < 600px) and not (prefers-color-scheme: dark) { .a { font-size:14px; } }
// EXPECT: @media (width >= 400px) and (height < 900px) { .a { background-color:#008000;background-image:none; } }
// EXPECT: @media (width < 600px) or (prefers-color-scheme: dark) { .a { padding:4px; } }
// EXPECT: @media (width < 600px) { .b { display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,column);--salam-rev:column-reverse; } }
// EXPECT: @media (not (width > 1024px)) and (width > 300px) { .b { gap:12px; } }
// EXPECT: function __salam_env_sync()
page:
    title = "Page props"
    background = "red"
    if page.width >= 400 and page.height < 900:
        background = "green"
    end
    if page.compact or page.dark:
        padding = 4
    end
    if page.dark:
        color = "white"
    else if page.compact:
        font size = 14
    end
    nav:
        id = "bar"
        layout = "row"
        if page.compact:
            layout = "column"
        end
        if not page.wide and page.width > 300:
            gap = 12
        end
        link:
            url = "/"
            content = "Home"
        end
    end
    if page.width < 500:
        paragraph:
            id = "small"
            content = "small"
        end
    end
end
