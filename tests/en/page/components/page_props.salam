// EXPECT: @media (width >= 400px) and (height < 900px) { .a { background-color:#008000;background-image:none; } }
// EXPECT: @media (width < 600px) or (prefers-color-scheme: dark) { .a { padding:4px; } }
// EXPECT: salamWsStyle(0, 0, `${envx_compact ? "column" : "row"}`)
// EXPECT: salamWsStyle(1, 0, `${!envx_wide && envx_w > 300 ? "12" : ""}`)
// EXPECT: function __salam_env_sync()
page:
    title = "Page props"
    background = "red"
    if page.width >= 400 and page.height < 900:
        background = "green"
    end
    if page.compact or page.dark:
        padding = 4
    end
    nav:
        id = "bar"
        layout = row
        if page.compact:
            layout = "column"
        end
        if not page.wide and page.width > 300:
            gap = 12
        end
        link: url = "/" content = "Home" end
    end
    if page.width < 500:
        paragraph: id = "small" content = "small" end
    end
end
