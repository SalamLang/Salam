// EXPECT: @media (width < 640px) { .a { gap:4px; } }
// EXPECT: @media (width < 640px) { .b { padding:8px; } }
component Card(t: str):
    box:
        padding = 32
        if page.width < 640:
            padding = 8
        end
        paragraph: content = t end
    end
end

page:
    title = "W"
    box:
        id = "outer"
        layout = row
        gap = 24
        if page.width < 640:
            layout = column
            gap = 4
        end
        Card: t = "a" end
    end
end
