// EXPECT: <h2>Hi</h2>
pub component Card2(title):
    heading:
        size = 2
        content = title
    end
end
pub component HTMLView(title):
    box:
        content = title
    end
end
component private_card(title):
    box:
        content = title
    end
end
page:
    Card2:
        title = "Hi"
    end
    HTMLView:
        title = "x"
    end
    private_card:
        title = "y"
    end
end
