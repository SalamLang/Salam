// EXPECT: window.__salam_runs++;
// EXPECT: ui trace: run instance
// EXPECT: window.__salam_runs = 0;
// EXPECT-NOT: window.__salam_trace = true;
component Counter(name: str, start: int):
    count := start
    label := "clicks"
    box:
        button:
            id = name
            click = (): count++ end
            content = name + " " + count + " " + label
        end
    end
end

page:
    title = "State"
    heading:
        content = "Counters"
    end
    Counter:
        name = "a"
        start = 0
    end
    Counter:
        name = "b"
        start = 10
    end
end
