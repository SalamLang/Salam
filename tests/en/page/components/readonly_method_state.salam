// EXPECT: if (k === "transparent" || k === "شفاف") {
// EXPECT-NOT: salamWsTouch(2)
mut query := ""
mut dark := false

func shown(name: str): bool:
    ret name.Lower().Includes(query)
end

page:
    box:
        background = dark ? "transparent" : "#ff0000"
        input:
            id = "q"
            bind = query
        end
        if shown("Abc"):
            paragraph:
                content = "match"
            end
        end
    end
end
