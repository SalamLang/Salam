// EXPECT: salamWsMemo(
// EXPECT: salamWsSame()
// EXPECT-NOT: E133
mut names := Vector {} as Vector<str>
mut suffix := "x"
mut chosen := ""

func fill():
    names.Clear()
    each it in ["a", "b", "c", "d", "e", "f"]:
        names.Push(it)
    end
end

func double_b():
    names.Insert(2, "b")
end

func drop_many():
    names.RemoveAt(0)
    names.RemoveAt(0)
    names.RemoveAt(0)
end

component Cell(name: str, lit: bool):
    item:
        key = name
        id = "cell-" + name
        class = lit ? "on" : "off"
        span:
            class = "tag"
            content = name + "-" + suffix
        end
        button:
            id = "go-" + name
            click = (): chosen = name end
            content = "go"
        end
    end
end

page:
    title = "Row memo"
    box:
        button:
            id = "fill"
            click = fill
            content = "Fill"
        end
        button:
            id = "suffix"
            click = (): suffix += "y" end
            content = "Suffix"
        end
        button:
            id = "dup"
            click = double_b
            content = "Dup"
        end
        button:
            id = "many"
            click = drop_many
            content = "Drop many"
        end
        button:
            id = "clear"
            click = (): names.Clear() end
            content = "Clear"
        end
    end
    list:
        id = "cells"
        each _, it in names:
            Cell:
                name = it
                lit = it == chosen
            end
        end
    end
    paragraph:
        id = "chosen"
        content = "chosen " + chosen
    end
end
