// EXPECT: padding-block:8px;padding-inline:16px
// EXPECT: border:1px solid #ff0000
// EXPECT: transition-duration:150ms;transition-timing-function:ease-out
// EXPECT: grid-template-columns:repeat(2,1fr)
component Demo:
    n := 0
    box:
        id = "g"
        columns = repeat(2, 1fr)
        padding = 8, 16
        border = 1, solid, red
        transition = 150ms, ease out
        button: id = "go" content = "x" click = (): n++ end end
    end
    paragraph: content = n end
end

page:
    Demo: end
end
