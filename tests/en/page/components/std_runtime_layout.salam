// EXPECT: salamWsStyle(0, 0,
// EXPECT: salamWsStyle(75, 0,
// EXPECT-NOT: layout=
component Demo:
    l := "row"
    r := 4
    button:
        id = "go"
        content = "x"
        layout = l
        radius = r
        click = (): l = "column" r++ end
    end
end

page:
    Demo: end
end
