// EXPECT: function salamWsStyle(prop, state, text)
// EXPECT: salamWsStyle(114, 0,
// EXPECT: salamWsStyle(1, 0,
// EXPECT: salamWsStyle(61, 1,
// EXPECT: salamWsStyle(38, 0,
// EXPECT-NOT: style="color
component Demo:
    c := "red"
    n := 4
    button:
        id = "go"
        content = "x"
        color = c
        gap = n * 2
        hover background = c
        padding = n, 16
        click = ():
            c = "blue"
            n++
        end
    end
end

page:
    Demo: end
end
