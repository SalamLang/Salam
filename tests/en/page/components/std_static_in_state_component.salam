// EXPECT: font-feature-settings:"tnum"
// EXPECT: display:var(--salam-o,block) grid
// EXPECT: :hover{opacity:0.5
component Demo:
    n := 0
    button:
        id = "go"
        content = "x"
        layout = grid
        font features = "tnum"
        hover opacity = 0.5
        click = (): n++ end
    end
    paragraph: content = n end
end

page:
    Demo: end
end
