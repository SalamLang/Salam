// EXPECT: let __salam_ws_2 = 0;
// EXPECT: salamWsTouch(0);
// EXPECT: salamWsTouch(1);
// EXPECT: salamWsTouch(2);
// EXPECT: let total = 0;
// EXPECT: __salam_ws_1 = ((__salam_ws_1 + 1) | 0);
// EXPECT: main panel ${__salam_ws_0}
// EXPECT: badge ${((Math.imul(__salam_ws_0, 10)) | 0)} ${__salam_ws_2}
// EXPECT: <!--salam:1--><!--/salam:1-->
// EXPECT-NOT: salamWsTouch(3)
// EXPECT-NOT: __salam_ws_3
component Badge(value: int):
    text := "badge " + value
    taps := 0
    paragraph: id = "badge" click = (): taps++ end content = text + " " + taps end
end

component Panel(name: str):
    count := 0
    presses := 0
    title := name + " panel"
    box:
        paragraph: id = "title" content = title + " " + count end
        button: id = "inc" click = (): count++ end content = "+" end
        button: id = "quiet" click = (): presses++ end content = "quiet" end
        Badge: value = count * 10 end
    end
end

page:
    total := 0
    label := "total " + total
    title = "Variables"
    paragraph: id = "total" content = label end
    button: id = "add" click = (): total += 2 end content = "add" end
    Panel: name = "main" end
end
