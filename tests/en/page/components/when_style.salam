// EXPECT: salamWsStyle(61, 0, `${__salam_ws_0 ? "orange" : "blue"}`)
// EXPECT: salamWsStyle(114, 0, `${__salam_ws_0 ? "black" : "white"}`)
// EXPECT: salamWsStyle(61, 1, `${__salam_ws_0 ? "red" : "navy"}`)
// EXPECT: salamWsStyle(38, 0, `${__salam_ws_0 && __salam_ws_1 ? "40" : __salam_ws_1 ? "24" : "8"}`)
component Seg(label: str):
    picked := false
    big := false
    button:
        id = "seg"
        background = "blue"
        color = "white"
        hover background = "navy"
        padding = 8
        when picked:
            background = "orange"
            color = "black"
            hover background = "red"
        end
        when big:
            padding = 24
        end
        when picked and big:
            padding = 40
        end
        click = ():
            picked = not picked
            big = not big
        end
        content = label
    end
end

page:
    title = "When"
    Seg: label = "A" end
end
