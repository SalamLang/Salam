// EXPECT: data-slot="accordion" data-type="multiple" data-collapsible
// EXPECT: data-slot="accordion-item" data-state="open"
// EXPECT: data-slot="accordion-trigger" type="button" aria-expanded="false"
// EXPECT: data-slot="accordion-content" role="region"
// EXPECT: window.salamDsAccordion
page:
    design = "shadcn"
    accordion:
        type = "multiple"
        collapsible = true
    end
    accordion item:
        open = true
        value = "1"
    end
    accordion trigger:
        content = "Why"
    end
    accordion content:
        content = "Because"
    end
end
