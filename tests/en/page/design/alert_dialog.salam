// EXPECT: <dialog data-slot="alert-dialog" data-overlay data-state="closed" role="alertdialog" data-size="default">
// EXPECT: data-slot="alert-dialog-title"
// EXPECT: <button data-slot="alert-dialog-cancel" type="button" data-dialog-close data-variant="outline">
// EXPECT: <button data-slot="alert-dialog-action" type="button" data-dialog-close data-variant="destructive">
page:
    alert dialog:
    end
    alert dialog title:
        content = "Sure?"
    end
    alert dialog cancel:
        content = "No"
    end
    alert dialog action:
        variant = "destructive"
        content = "Yes"
    end
end
