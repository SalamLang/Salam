// EXPECT: <span data-slot="avatar" data-size="lg"></span>
// EXPECT: <img data-slot="avatar-image" src="a.png" alt="x">
// EXPECT: data-slot="avatar-fallback">CN</span>
// EXPECT: window.salamDsAvatar
page:
    design = "shadcn"
    avatar:
        size = "lg"
    end
    avatar image:
        url = "a.png"
        alt = "x"
    end
    avatar fallback:
        content = "CN"
    end
end
