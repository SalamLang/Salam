// EXPECT: <span data-slot="badge" data-variant="secondary">New</span>
// EXPECT: <a data-slot="badge"
// EXPECT: [data-slot="badge"][data-variant="outline"]
page:
    badge:
        variant = secondary
        content = "New"
    end
    badge:
        url = "/docs"
        variant = outline
        content = "Docs"
    end
end
