// EXPECT: <div data-slot="calendar" id="c1" data-calendar="jalali" data-mode="range" data-week-start="6" data-min="2026-01-01" data-disabled-days="5" data-value="2026-11-10/2026-11-16">
// EXPECT: <div data-slot="date-picker" data-state="closed" data-name="when" data-calendar="jalali">
// EXPECT: <div data-slot="calendar" data-calendar="jalali">
// EXPECT: window.salamDsCalendar
// EXPECT: window.salamDsDatePicker
// EXPECT: [data-slot="calendar-day"][data-today]
page:
    design = "shadcn"
    calendar:
        id = "c1"
        calendar = "jalali"
        mode = "range"
        week start = 6
        min = "2026-01-01"
        disabled days = "5"
        value = "2026-11-10/2026-11-16"
    end
    date picker:
        name = "when"
        calendar = "jalali"
    end
end
