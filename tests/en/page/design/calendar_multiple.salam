// EXPECT: <div data-slot="calendar" data-calendar="jalali" data-mode="multiple" data-value="2026-03-21,2026-03-25">
// EXPECT: <div data-slot="date-picker" data-state="closed" data-name="days" data-mode="multiple">
// EXPECT: function jalCal(jy)
// EXPECT: 'Ordibehesht'
// EXPECT: aria-multiselectable
page:
    calendar:
        calendar = "jalali"
        mode = "multiple"
        value = "2026-03-21,2026-03-25"
    end
    date picker:
        name = "days"
        mode = "multiple"
    end
end
