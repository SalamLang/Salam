// EXPECT: <div data-slot="carousel" role="region" aria-roledescription="carousel" tabindex="0" data-orientation="horizontal" id="c1" data-loop data-autoplay="4000" data-dots>
// EXPECT: data-slot="carousel-item" role="group" aria-roledescription="slide"
// EXPECT: <button data-slot="carousel-next" type="button" aria-label="Next slide">
// EXPECT: <div data-slot="resizable" data-orientation="vertical">
// EXPECT: <div data-slot="resizable-panel" data-size="30" data-min-size="10">
// EXPECT: <div data-slot="resizable-handle" data-grip><div data-slot="resizable-grip">
// EXPECT: window.salamDsCarousel
// EXPECT: window.salamDsResizable
page:
    carousel:
        id = "c1"
        loop = true
        autoplay = 4000
        dots = true
    end
    carousel item:
        content = "One"
    end
    carousel next:
    end
    resizable:
        orientation = "vertical"
    end
    resizable panel:
        size = 30
        min size = 10
    end
    resizable handle:
        grip = true
    end
end
