// EXPECT: <div data-slot="chart" data-type="donut" data-height="240" data-legend data-grid="false" data-stacked data-center="Visitors"><div data-slot="chart-data">
// EXPECT: <div data-slot="chart-series" data-label="Desktop" data-color="var(--chart-2)">
// EXPECT: <span data-slot="chart-point" data-label="Jan" data-value="186"></span>
// EXPECT: window.salamDsChart
// EXPECT: [data-slot="chart-tooltip"]
page:
    chart:
        type = "donut"
        chart height = 240
        legend = true
        grid = "false"
        stacked = true
        center = "Visitors"
    end
    chart series:
        label = "Desktop"
        tint = "var(--chart-2)"
    end
    chart point:
        label = "Jan"
        value = "186"
    end
end
