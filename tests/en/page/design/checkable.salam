// EXPECT: role="radiogroup" data-slot="radio-group"
page:
    box:
        input:
            id = "c1"
            type = "checkbox"
            checked = true
        end
        radio group:
            input:
                type = "radio"
                name = "g"
            end
            input:
                type = "radio"
                name = "g"
            end
        end
        input:
            type = "range"
            min = "0"
            max = "100"
        end
    end
end
