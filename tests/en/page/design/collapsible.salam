// EXPECT: data-slot="collapsible-trigger" type="button" aria-expanded="false"
// EXPECT: data-slot="collapsible-content"
// EXPECT: window.salamDsCollapsible
page:
    collapsible:
        open = true
    end
    collapsible trigger:
        content = "More"
    end
    collapsible content:
        content = "Hidden"
    end
end
