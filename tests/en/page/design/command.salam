// EXPECT: <div data-slot="command" id="c1">
// EXPECT: <input type="text" data-slot="command-input" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Search">
// EXPECT: data-slot="command-item" role="option" aria-selected="false" data-value="cal" data-keywords="date"
// EXPECT: data-slot="command-group" role="group" data-heading="Tools"
// EXPECT: <dialog data-slot="dialog" data-overlay data-command-dialog data-state="closed" aria-label="Command palette" data-hotkey="k">
// EXPECT: window.salamDsPick
page:
    command:
        id = "c1"
    end
    command input:
        placeholder = "Search"
    end
    command group:
        heading = "Tools"
    end
    command item:
        value = "cal"
        keywords = "date"
        content = "Calendar"
    end
    command dialog:
        hotkey = "k"
    end
end
