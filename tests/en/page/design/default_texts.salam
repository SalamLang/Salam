// EXPECT: aria-label="pagination"
// EXPECT: <span data-slot="pagination-label">Previous</span>
// EXPECT: <span data-slot="pagination-label">Next</span>
// EXPECT: aria-label="Toggle theme"
// EXPECT: aria-label="Next slide"
// EXPECT: <span data-slot="combobox-value">Select...</span>
// EXPECT: placeholder="Search..."
// EXPECT: aria-label="Previous month"
// EXPECT: <span data-slot="pagination-label">Go on</span>
page:
    pagination:
    end
    pagination previous:
    end
    pagination next:
    end
    theme toggle:
    end
    carousel next:
    end
    combobox:
        name = "x"
    end
    calendar:
    end
    pagination next:
        content = "Go on"
    end
end
