// EXPECT: window.salamDsDialog
page:
    design = "shadcn"
    dialog:
        id = "d1"
    end
    dialog trigger:
        opens = "d1"
    end
    dialog title:
        content = "Title"
    end
    dialog close:
        content = "Close"
    end
end
