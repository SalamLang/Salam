// EXPECT: <a data-slot="item" data-variant="outline" data-size="sm" href="/x">
// EXPECT: data-slot="item-title">Name</div>
// EXPECT: data-slot="item-description">Text</p>
page:
    design = "shadcn"
    entry:
        variant = "outline"
        size = "sm"
        url = "/x"
    end
    entry title:
        content = "Name"
    end
    entry description:
        content = "Text"
    end
end
