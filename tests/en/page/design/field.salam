// EXPECT: <fieldset data-slot="field-set">
// EXPECT: <legend data-slot="field-legend" data-variant="label">
// EXPECT: <div data-slot="field" role="group" data-orientation="horizontal">
// EXPECT: <div data-slot="field-error" role="alert">Required</div>
// EXPECT: @container field-group (min-width:448px)
page:
    design = "shadcn"
    form:
        field set:
            legend:
                variant = "label"
                content = "Account"
            end
            field:
                orientation = "horizontal"
                field label:
                    content = "Name"
                end
                input:
                    type = "text"
                end
                field error:
                    content = "Required"
                end
            end
        end
    end
end
