// EXPECT: <select data-size="sm">
// EXPECT: :where(select[data-size="sm"]){height:32px}
// EXPECT: <input type="range" data-orientation="vertical" value="40">
// EXPECT: data-slot="slider-range" data-orientation="vertical" data-low="20" data-high="70"
// EXPECT: <input type="range" min="0" max="100" step="1" data-thumb="high" value="70">
// EXPECT: function salamDsRange
// EXPECT: <input type="checkbox" data-indeterminate>
// EXPECT: function salamDsIndeterminate
// EXPECT: <select aria-invalid="true">
// EXPECT: <textarea aria-invalid="true" name="bio" rows="3"></textarea>
// EXPECT: var seen = f()
page:
    design = "shadcn"
    script:
        content = "var seen = f()"
    end
    box:
        select:
            control size = "sm"
            option:
                content = "A"
            end
        end
        select:
            aria invalid = "true"
            option:
                content = "A"
            end
        end
        input:
            type = "range"
            orientation = "vertical"
            value = "40"
        end
        range slider:
            orientation = "vertical"
            low = 20
            high = 70
        end
        input:
            type = "checkbox"
            indeterminate = true
        end
        input:
            type = "textarea"
            aria invalid = "true"
            name = "bio"
            rows = 3
        end
        avatar:
        end
    end
end
