// EXPECT: <input id="mail" type="email" name="mail" aria-invalid="true">
// EXPECT: <textarea name="bio" rows="3">hi</textarea>
// EXPECT: :where(input:not([type=checkbox])
// EXPECT: :where(textarea:focus-visible)
// EXPECT: :where(label){display:flex
page:
    form:
        label:
            for = "mail"
            content = "Email"
        end
        input:
            id = "mail"
            type = "email"
            name = "mail"
            aria invalid = "true"
        end
        input:
            type = "textarea"
            name = "bio"
            rows = 3
            content = "hi"
        end
    end
end
