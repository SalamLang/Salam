// EXPECT: <div data-slot="input-group" role="group">
// EXPECT: data-slot="input-group-addon" role="group" data-align="inline-end"
// EXPECT: <span data-slot="input-group-text">https://</span>
// EXPECT: <div data-slot="button-group" role="group" data-orientation="horizontal">
// EXPECT: function salamDsToggle
page:
    design = "shadcn"
    box:
        input group:
            input group addon:
                align = "inline-end"
                input group text:
                    content = "https://"
                end
            end
            input:
                type = "text"
            end
        end
        button group:
            button:
                content = "A"
            end
        end
        toggle group:
            toggle:
                content = "B"
            end
        end
    end
end
