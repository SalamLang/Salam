// EXPECT: <div data-slot="dropdown-menu" data-froot="menu" data-kind="dropdown">
// EXPECT: data-slot="menu-content" data-float hidden data-state="closed" role="menu" data-menu aria-orientation="vertical"
// EXPECT: <div data-slot="menu-item" data-menu-item role="menuitem" tabindex="-1" data-variant="destructive" data-disabled>Delete</div>
// EXPECT: data-slot="menu-checkbox-item" data-menu-item role="menuitemcheckbox" tabindex="-1" aria-checked="false" data-checked
// EXPECT: <div data-slot="menu-radio-group" role="group" data-radio-group data-value="a">
// EXPECT: <div data-slot="menu-separator" role="separator"></div>
// EXPECT: <span data-slot="menu-shortcut">Ctrl K</span>
page:
    design = "shadcn"
    dropdown menu:
    end
    menu content:
    end
    menu item:
        variant = "destructive"
        disabled = true
        content = "Delete"
    end
    menu checkbox item:
        checked = true
    end
    menu radio group:
        value = "a"
    end
    menu separator:
    end
    menu shortcut:
        content = "Ctrl K"
    end
end
