// EXPECT: <div data-slot="tabs-list" role="tablist" data-variant="default"><button data-slot="tabs-trigger" type="button" role="tab" aria-selected="false" data-value="a">Account</button><button data-slot="tabs-trigger" type="button" role="tab" aria-selected="false" data-value="b">Password</button></div>
// EXPECT: <div data-slot="card-content"><button data-variant="outline">Save</button>
page:
    title = "Nested"
    tabs:
        default value = "a"
        tab list:
            tab trigger:
                value = "a"
                content = "Account"
            end
            tab trigger:
                value = "b"
                content = "Password"
            end
        end
        tab content:
            value = "a"
            card:
                card content:
                    button:
                        variant = "outline"
                        content = "Save"
                    end
                end
            end
        end
    end
end
