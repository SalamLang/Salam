// EXPECT: <div data-slot="card"><div data-slot="card-header"><div data-slot="card-title">Plan</div><div data-slot="card-description">Monthly</div></div><div data-slot="card-content">Body</div></div>
// EXPECT: <div data-slot="alert" role="alert"><div data-slot="alert-title">Heads up</div></div>
page:
    card:
        card header:
            card title:
                content = "Plan"
            end
            card description:
                content = "Monthly"
            end
        end
        card content:
            content = "Body"
        end
    end
    alert:
        alert title:
            content = "Heads up"
        end
    end
end
