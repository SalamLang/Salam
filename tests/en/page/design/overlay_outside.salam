// EXPECT: data-close-outside="false"
// EXPECT: data-slot="alert-dialog"
// EXPECT: getAttribute('data-close-outside')!=='false'
// EXPECT: [data-slot="alert-dialog"]>[data-slot="alert-dialog-media"]){justify-self:center}
page:
    dialog:
        id = "d1"
        close outside = false
        dialog title:
            content = "T"
        end
    end
    alert dialog:
        id = "d2"
        alert dialog media:
            span:
                content = "!"
            end
        end
    end
end
