// EXPECT: <div data-slot="popover" data-froot="popover">
// EXPECT: <button data-slot="popover-trigger" type="button" data-ftrigger data-variant="outline">Open</button>
// EXPECT: data-slot="popover-content" data-float hidden data-state="closed" role="dialog" data-side="top" data-align="end" data-offset="8"
// EXPECT: window.salamDsFloat
page:
    popover:
    end
    popover trigger:
        content = "Open"
    end
    popover content:
        side = "top"
        align = "end"
        side offset = 8
    end
end
