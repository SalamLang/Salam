// EXPECT: <body data-design="none">
// EXPECT: <button>A</button>
// EXPECT: <div data-ds-on data-design="shadcn" data-theme="dark">
// EXPECT: <button data-ds-on>B</button>
// EXPECT: <div data-ds-off data-design="none">
// EXPECT: <button data-ds-off>C</button>
// EXPECT: :where([data-ds-on]):where(button){display:inline-flex
// EXPECT-NOT: :where(:not([data-ds-off])):where(button)
// EXPECT-NOT: body{background:var(--background)
page:
    title = "Scope page none"
    design = "none"
    button:
        content = "A"
    end
    box:
        design = "shadcn"
        theme = "dark"
        button:
            content = "B"
        end
        box:
            design = "none"
            button:
                content = "C"
            end
        end
    end
end
