// EXPECT: data-slot="combobox" data-combobox data-state="closed" data-name="fw" data-clearable
// EXPECT: <input type="hidden" data-slot="combobox-input-hidden" name="fw">
// EXPECT: data-slot="combobox-item" role="option" aria-selected="false" data-value="next">Next.js
// EXPECT: <button data-slot="select-trigger" type="button" data-size="sm"><span data-slot="select-value">Pick</span>
// EXPECT: data-slot="select-item" role="option" aria-selected="false" data-value="a" data-disabled
// EXPECT: [data-slot="select-trigger"][data-size="sm"]
page:
    design = "shadcn"
    combobox:
        name = "fw"
        clearable = true
    end
    combobox item:
        value = "next"
        content = "Next.js"
    end
    select box:
        name = "pick"
    end
    select trigger:
        size = "sm"
        content = "Pick"
    end
    select item:
        value = "a"
        disabled = true
        content = "A"
    end
end
