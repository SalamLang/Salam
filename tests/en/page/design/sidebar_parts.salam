// EXPECT: <button data-slot="sidebar-rail" type="button" tabindex="-1" aria-label="Toggle sidebar" title="Toggle sidebar"></button>
// EXPECT: <ul data-slot="sidebar-menu-sub"><li data-slot="sidebar-menu-sub-item">
// EXPECT: <a data-slot="sidebar-menu-sub-button" data-size="sm" href="#a" data-active>Alpha</a>
// EXPECT: <li data-slot="sidebar-menu-item" data-open>
// EXPECT: data-tooltip="Go home"
// EXPECT: data-slot="sidebar-tooltip"
page:
    design = "shadcn"
    sidebar panel:
        sidebar rail:
        end
        sidebar menu:
            sidebar menu item:
                open = true
                sidebar menu button:
                    tooltip = "Go home"
                    content = "Home"
                end
                sidebar menu sub:
                    sidebar menu sub item:
                        sidebar menu sub button:
                            size = "sm"
                            url = "#a"
                            active = true
                            content = "Alpha"
                        end
                    end
                end
            end
        end
    end
end
