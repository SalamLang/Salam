// EXPECT: data-slot="switch-thumb" data-state="checked"
// EXPECT: <input type="checkbox" hidden tabindex="-1" data-slot="switch-input" name="notify" value="on" checked>
// EXPECT: function salamDsSwitch
// EXPECT: data-size="sm"
page:
    box:
        switch:
            name = "notify"
            checked = true
        end
        switch:
            size = "sm"
            disabled = true
        end
    end
