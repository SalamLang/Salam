// EXPECT: data-slot="tabs"
// EXPECT: data-orientation="vertical"
// EXPECT: data-default-value="b"
// EXPECT: data-slot="tabs-list" role="tablist" data-variant="line"
// EXPECT: data-slot="tabs-trigger"
// EXPECT: data-value="a"
// EXPECT: window.salamDsTabs
page:
    tabs:
        orientation = "vertical"
        default value = "b"
    end
    tab list:
        variant = "line"
    end
    tab trigger:
        value = "a"
        content = "One"
    end
end
