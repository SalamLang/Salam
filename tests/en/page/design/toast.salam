// EXPECT: <ol data-slot="toaster" role="region" aria-label="Notifications" aria-live="polite" data-placement="top-center" data-closable>
// EXPECT: data-toast="Saved" data-toast-description="Done" data-toast-variant="success"
// EXPECT: window.salamToast
// EXPECT: :where([data-slot="toaster"][data-placement="top-right"])
page:
    design = "shadcn"
    toaster:
        placement = "top center"
        close button = true
    end
    button:
        toast = "Saved"
        toast description = "Done"
        toast variant = "success"
        content = "Save"
    end
end
