// EXPECT: <button data-slot="toggle" type="button" aria-pressed="true" data-state="on" data-variant="outline" data-size="lg"
// EXPECT: <div data-slot="toggle-group" role="group" data-spacing="0" data-type="multiple">
// EXPECT: <kbd data-slot="kbd">K</kbd>
// EXPECT: data-slot="input-otp-separator"
// EXPECT: name="code"
// EXPECT: :where(select:dir(rtl))
page:
    box:
        toggle:
            variant = "outline"
            size = "lg"
            pressed = true
            content = "B"
        end
        toggle group:
            type = "multiple"
            toggle:
                content = "I"
            end
        end
        keyboard:
            content = "K"
        end
        input otp:
            length = 6
            group size = 3
            name = "code"
        end
        select:
            option:
                content = "One"
            end
        end
    end
end
