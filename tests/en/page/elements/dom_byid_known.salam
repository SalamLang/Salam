// EXPECT: id="result"
// EXPECT: getElementById("result")
// EXPECT: window["onClick"] = onClick;
import dom

func onClick():
    dom.SetText(dom.ById("result"), "clicked")
end

page:
    paragraph:
        id = "result"
        content = "hi"
    end
    button:
        click = onClick
        content = "Click"
    end
end
