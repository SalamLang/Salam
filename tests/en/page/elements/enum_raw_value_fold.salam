// EXPECT: <button>Rock</button>
// EXPECT: <button>Paper</button>
enum Choice:
    Rock = "Rock"
    Paper = "Paper"
end

component btn(choice: Choice):
    button:
        content = choice as str
    end
end

page:
    btn:
        choice = Choice.Rock
    end
    btn:
        choice = Choice.Paper
    end
end
