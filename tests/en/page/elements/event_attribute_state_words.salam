// EXPECT: onfocusin="alert(1)"
// EXPECT: onfocusout="alert(2)"
// EXPECT: onbeforeinput="alert(3)"
// EXPECT: onbeforetoggle="alert(4)"
// EXPECT: onbeforematch="alert(5)"
// EXPECT-NOT: ::after
page:
    input: focus in = "alert(1)" focus out = "alert(2)" before input = "alert(3)" end
    details: before toggle = "alert(4)" before match = "alert(5)" content = "x" end
end
