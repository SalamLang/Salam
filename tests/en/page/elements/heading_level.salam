// EXPECT: <h2>Two</h2>
// EXPECT: <h6>Six</h6>
// EXPECT: <h1>Low</h1>
// EXPECT-NOT: ="2"
page:
    heading: size = 2 content = "Two" end
    heading: level = 6 content = "Six" end
    heading: size = 0 content = "Low" end
end
