// EXPECT: <title>T &lt;/title&gt;&lt;img src=x&gt;</title>
// EXPECT: &lt;/script&gt;&lt;script&gt;window.pwned=1&lt;/script&gt;
// EXPECT: <\/script><script>window.pwned=2<\/script>
// EXPECT: <\/SCRIPT ><img src=x onerror=window.pwned=3>
// EXPECT: <\!--<script>
// EXPECT: x${msg}<\/script><\!--<script>
// EXPECT: salamWsUrl(
// EXPECT: salam-fake&lt;img src=x onerror=window.pwned=5&gt;
// EXPECT: salam-dyn-0&lt;img src=x onerror=window.pwned=6&gt;
// EXPECT-NOT: <img src=x onerror=window.pwned=5>
// EXPECT-NOT: </script><script>window.pwned
// EXPECT-NOT: </SCRIPT ><img
// EXPECT: &lt;img src=x onerror=window.pwned=4&gt;
mut msg := "</script><script>window.pwned=2</script>"
mut where := "/start"

page:
    title = "T </title><img src=x>"
    paragraph:
        content = "</script><script>window.pwned=1</script>"
    end
    paragraph:
        title = msg
        content = msg
    end
    paragraph:
        content = "a\u0002<img src=x onerror=window.pwned=4>\u0003"
    end
    paragraph:
        content = "\u0002salam-fake<img src=x onerror=window.pwned=5>"
    end
    paragraph:
        content = "\u0002salam-dyn-0\u0003<img src=x onerror=window.pwned=6>"
    end
    button:
        click = (): msg = "</scr" + "ipt><script>window.pwned=2</scr" + "ipt></SCRIPT ><img src=x onerror=window.pwned=3><!" + "--<scr" + "ipt>" end
        content = "go"
    end
    button:
        click = (): msg = "x${msg}</script><!--<script>" where = msg end
        content = "template"
    end
    sidebar menu button:
        url = where
        content = "side"
    end
end
