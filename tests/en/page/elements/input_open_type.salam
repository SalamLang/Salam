// EXPECT: <input type="month" name="m">
// EXPECT: <input type="my-widget" name="w">
// EXPECT-NOT: <textarea
page:
    form:
        input:
            type = "month"
            name = "m"
        end
        input:
            type = "my-widget"
            name = "w"
        end
    end
end
