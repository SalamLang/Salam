// EXPECT: <textarea
// EXPECT: wrap="hard"
// EXPECT: wrap="soft"
page:
    input:
        type = "textarea"
        name = "poem"
        cols = 30
        wrap = "hard"
    end
    input:
        type = "textarea"
        name = "note"
        wrap = "soft"
    end
end
