// EXPECT: if (flag)
// EXPECT:  checked
// EXPECT:  disabled
// EXPECT:  selected
// EXPECT:  required
// EXPECT-NOT: salamWsHtml(`${flag}`)
// EXPECT-NOT: salamWsHtml(`${sel === "a"}`)
mut flag := false
mut sel := "a"

page:
    title = "State bool attributes"
    input:
        type = "checkbox"
        checked = flag
        required = flag
        change = (): flag = not flag end
    end
    button:
        disabled = flag
        content = "Go"
    end
    select:
        option:
            value = "a"
            selected = sel == "a"
            content = "A"
        end
    end
end
