// EXPECT: if (flag)
// EXPECT:  hidden
// EXPECT:  readonly
// EXPECT:  open
// EXPECT:  multiple
// EXPECT-NOT: hidden="
// EXPECT-NOT: salamWsHtml(`${flag}`)
mut flag := false

page:
    title = "More state bool attributes"
    paragraph:
        hidden = flag
        content = "x"
    end
    input:
        type = "text"
        readonly = flag
        change = (): flag = not flag end
    end
    details:
        open = flag
        content = "more"
    end
    select:
        multiple = flag
        option:
            value = "a"
            content = "A"
        end
    end
end
