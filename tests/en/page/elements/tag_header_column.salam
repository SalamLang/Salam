// EXPECT: <th
// EXPECT:  colspan="2"
// EXPECT:  rowspan="2"
// EXPECT:  headers="target1"
// EXPECT:  scope="row"
// EXPECT:  abbr="x1"
page:
    box:
        id = "target1"
    end
    table:
        header:
            row:
                column:
                    colspan = "2"
                    rowspan = "2"
                    headers = "target1"
                    scope = "row"
                    abbr = "x1"
                    content = "hello"
                end
            end
        end
    end
end
