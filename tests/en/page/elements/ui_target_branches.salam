// EXPECT: <p>web</p>
// EXPECT: <span>after</span>
// EXPECT-NOT: native only
page:
    if SALAM_UI_WEB:
        paragraph: content = "web" end
    else:
        paragraph: content = "native only" end
    end
    box:
        if SALAM_UI_NATIVE:
            span: content = "native only" end
        end
        span: content = "after" end
    end
end
