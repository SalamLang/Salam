// FLAGS: --log-level=warn
// EXPECT: W299
// EXPECT-MSG: the word 'ease out' is a value, not a name; write it in quotes
component Card(title: str):
    box:
        transition = 150ms, ease out
        content = title
    end
end

page:
    Card:
        title = "x"
    end
end
