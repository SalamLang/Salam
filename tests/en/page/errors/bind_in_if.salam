// EXPECT: ERROR
// EXPECT-MSG: 'bind' cannot be used inside 'if' or 'each'
mut name := ""
mut loud := false

page:
    title = "Bind in if"
    input:
        type = "text"
        if loud:
            bind = name
        end
    end
end
