// EXPECT: E136
// EXPECT-MSG: remove 'class' so each element gets its own generated class
component Tag(lit: bool, label: str):
    box:
        class = "tag"
        padding = 6
        if lit:
            background = "gold"
        else:
            background = "gray"
        end
        content = label
    end
end

page:
    title = "Tags"
    Tag:
        lit = true
        label = "a"
    end
    Tag:
        lit = false
        label = "b"
    end
end
