// EXPECT: E012
// EXPECT-MSG: component 'Row' cannot call 'shout'
mut count := 0

func shout(x: int): str:
    count++
    ret "n" + x
end

component Row(x: int):
    paragraph:
        content = shout(x)
    end
end

page:
    title = "Impure"
    Row:
        x = 3
    end
end
