// EXPECT: E270
// EXPECT-MSG: component 'App' has empty parentheses
// EXPECT-MSG: write 'component App:', or declare parameters as in 'component App(title: str):'
// EXPECT-MSG: write 'pub component Card:', or declare parameters as in 'pub component Card(title: str):'
component App():
    box:
        content = "app"
    end
end

pub component Card():
    box:
        content = "card"
    end
end

page:
    App: end
    Card: end
end
