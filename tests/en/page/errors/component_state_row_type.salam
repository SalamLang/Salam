// EXPECT: E029
// EXPECT-MSG: component_state_row_type.salam:20:25
component Counter(label: str):
    count := 0
    box:
        button:
            click = (): count.Missing() end
            content = label + count
        end
    end
end

mut names := ["a", "b"]

page:
    each i, name in names:
        Counter:
            key = i
            label = name
        end
    end
end
