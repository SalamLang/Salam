// EXPECT: E138
// EXPECT-MSG: no element with id 'card_id' in this file's layout
import dom

page Card(name: str):
    box: id = "card_id" content = name end
end

func use_card(): str:
    ret Card("x")
end

func handler():
    dom.SetText(dom.ById("card_id"), "x")
end

page:
    box: content = "main page" end
    button: click = handler content = "go" end
end
