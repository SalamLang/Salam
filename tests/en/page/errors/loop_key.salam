// EXPECT: E292
// EXPECT-MSG: 'item' is a row of 'each' and has no key; every rendered row needs one
// EXPECT-MSG: write 'each i, it in ...:' and add the line 'key = i' inside 'item:'
// EXPECT-MSG: 'Row' is a row of 'each' and has no key
// EXPECT-MSG: add the line 'key = n' inside 'span:'
// EXPECT-MSG: 'paragraph' is a row of 'each' and has no key
// EXPECT-MSG: this key does not use the variable or the index of its 'each' ('constant')
// EXPECT-MSG: this key does not use the variable or the index of its 'each' ('inner')
// EXPECT-MSG: this 'each' renders no element that can carry its key
mut names := Vector {} as Vector<str>

component Row(name: str):
    item:
        key = name
        content = name
    end
end

page:
    list:
        each it in names:
            item:
                content = it
            end
        end
        each use in names:
            Row:
                name = use
            end
        end
        each n, branch in names:
            if n > 0:
                item:
                    key = n
                    content = branch
                end
            else:
                span:
                    id = branch
                    data-key = n
                    content = branch
                end
            end
        end
        each two in names:
            item:
                key = two
                content = two
            end
            paragraph:
                span:
                    key = two
                    content = two
                end
            end
        end
        each constant in names:
            item:
                key = "row"
                content = constant
            end
        end
        each outer in names:
            box:
                key = outer
                each inner in names:
                    span:
                        key = outer
                        content = inner
                    end
                end
            end
        end
        each empty in names:
            title = empty
        end
    end
end
