// FLAGS: --ui=native --log-level=warn
// EXPECT: W166
// EXPECT-MSG: 'meta' is web page metadata and is ignored by the native target
page:
    meta: name = "description" content = "A notes app" end
    paragraph: content = "hello" end
end
