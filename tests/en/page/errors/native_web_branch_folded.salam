// FLAGS: --ui=native --log-level=warn
// EXPECT: W166
// EXPECT-NOT: E165
page:
    meta: name = "description" content = "A notes app" end
    if SALAM_UI_WEB:
        script: content = "console.log(1)" end
    end
    box:
        if SALAM_UI_NATIVE:
            paragraph: content = "native" end
        else:
            iframe: url = "https://example.com" end
        end
    end
end
