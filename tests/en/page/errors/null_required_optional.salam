// EXPECT: E300
// EXPECT-MSG: may be null, but the attribute is required
// EXPECT-MSG: UnwrapOr
import web

struct Work:
    pub title: str
    pub next: web.Url?
end

page Go(w: Work):
    link: url = w.next content = w.title end
end

func main:
    println Go(Work { title = "a" })
end
