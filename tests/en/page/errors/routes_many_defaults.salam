// EXPECT: E263
// EXPECT-MSG: more than three optional parameters with default values
component Docs(a: str = "a", b: str = "b", c: str = "c", d: str = "d"):
    paragraph: content = a + b + c + d end
end

routes:
    "/docs/:a?/:b?/:c?/:d?" : Docs
end

page:
    Outlet: end
end
