// EXPECT: E259
// EXPECT-MSG: needs parameter 'id'
// EXPECT-NOT: __salam_outlet
component User(id: int):
    paragraph: content = "user " + id end
end

routes:
    "/users" : User
end

page:
    Outlet: end
end
