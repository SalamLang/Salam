// EXPECT: E134
// EXPECT-MSG: fixed id 'row'
page Rows(xs: Vector<str>):
    each i, x in xs:
        box: key = i id = "row" content = x end
    end
end

func main:
    xs := Vector {} as Vector<str>
    println Rows(xs)
end
