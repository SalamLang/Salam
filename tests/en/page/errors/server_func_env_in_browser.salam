// EXPECT: E286
// EXPECT-MSG: 'api_base' runs in the browser but uses 'env.Get', which only exists on the server
import env

mut total := 0

func api_base(): str:
    ret env.Get("SHOP_API")
end

server func Quote(sku: str): int:
    ret sku.Len() + api_base().Len()
end

page:
    server = "https://front.example.com"
    box:
        button: click = (): total = api_base().Len() + Quote("a1") end content = "Get" end
        paragraph: content = total end
    end
end
