// EXPECT: E289
// EXPECT-MSG: server func 'Quote' is reachable from a static build; build with --ssr or set 'server'
mut total := 0

server func Quote(sku: str): int:
    ret sku.Len()
end

page:
    box:
        button: click = (): total = Quote("a1") end content = "Get" end
        paragraph: content = total end
    end
end
