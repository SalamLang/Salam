pub component Menu:
    nav:
        MenuItem:
            dest = "/"
            label = "Home"
        end
        MenuItem:
            dest = "/about"
            label = "About"
        end
    end
end

component MenuItem(dest: str, label: str):
    link:
        to = dest
        if page.route.path == dest:
            font weight = 700
        end
        content = label
    end
end
