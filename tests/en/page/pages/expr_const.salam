// EXPECT: <title>Salam | Home</title>
// EXPECT: <div>Count: 15</div>
// EXPECT: width:302px;
const BASE := 10
const SITE := "Salam"
const WIDE := BASE * 30 + 2
page:
    title = SITE + " | Home"
    box:
        content = "Count: " + (BASE + 5)
    end
    box:
        content = "wide"
        width = WIDE + "px"
    end
end
