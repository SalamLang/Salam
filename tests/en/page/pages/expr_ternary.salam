// EXPECT: <div>big</div>
// EXPECT: <div>true</div>
// EXPECT: <div>v1.5</div>
const N := 10
const NAME := "Salam"
page:
    box:
        content = N > 3 ? "big" : "small"
    end
    box:
        content = (N > 3 and NAME == "Salam")
    end
    box:
        content = "v" + 1.5
    end
end
