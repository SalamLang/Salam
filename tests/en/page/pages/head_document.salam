// EXPECT-BASE: <html lang="en" dir="ltr">
// EXPECT: <title>My app</title>
// EXPECT: <h1>Welcome to Salam</h1>
// EXPECT-NOT: <body title
// EXPECT-NOT: <body lang
// EXPECT-NOT: ="1"
page:
    title = "My app"
    lang = "english"
    dir = "left to right"
    header:
        background = #2563eb
        color = "white"
        padding = 24px
        heading: size = 1 content = "Welcome to Salam" end
    end
    box:
        padding = 20px
        paragraph: content = "This page was built from Salam code." end
    end
end
