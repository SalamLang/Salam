// EXPECT: <html lang="en" dir="rtl">
// EXPECT: <p lang="fa" dir="ltr">
// EXPECT: <p lang="fa" dir="auto">
// EXPECT: <p lang="fa-IR" dir="auto">
// EXPECT: <p lang="ar" dir="rtl">
page:
    title = "Hello"
    lang = "انگلیسی"
    dir = "راست به چپ"
    paragraph: lang = "فارسی" dir = "چپ به راست" content = "a" end
    paragraph: lang = "persian" dir = "خودکار" content = "b" end
    paragraph: lang = "fa-IR" dir = "auto" content = "c" end
    paragraph: lang = "عربی" dir = "right to left" content = "d" end
end
