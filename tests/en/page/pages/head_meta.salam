// EXPECT: <title>Shop &amp; Co</title>
// EXPECT: <meta name="author" content="Ali">
// EXPECT: <meta name="description" content="Fresh bread">
// EXPECT: <meta name="keywords" content="bread, bakery">
// EXPECT: <meta name="theme-color" content="#2563eb">
// EXPECT: <meta name="robots" content="noindex, nofollow">
// EXPECT: <link rel="canonical" href="https://shop.example/">
// EXPECT: <link rel="icon" href="/icon.png">
// EXPECT: <meta http-equiv="refresh" content="30">
// EXPECT: <meta property="og:title" content="Shop">
// EXPECT: <meta property="og:image" content="/og.png">
// EXPECT: <meta name="twitter:card" content="summary">
// EXPECT: <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
// EXPECT-BASE: <body>
// EXPECT-NOT: <body title
page:
    title = "Shop & Co"
    author = "Ali"
    description = "Fresh bread"
    keywords = "bread, bakery"
    theme color = #2563eb
    robots = "noindex, nofollow"
    canonical = "https://shop.example/"
    icon = "/icon.png"
    refresh = 30
    og title = "Shop"
    og image = "/og.png"
    twitter card = "summary"
    viewport = "width=device-width, initial-scale=1, viewport-fit=cover"
    paragraph: content = "Open daily" end
end
