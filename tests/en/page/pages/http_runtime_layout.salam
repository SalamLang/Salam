// EXPECT: Served pages

import net.http
import net.router

page Greeting(name: str):
    title = "Hello, " + name
    paragraph: content = "Hello, " + name end
end

func home(ctx: i64):
    http.Html(ctx, Greeting(http.Query(ctx, "name")))
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/", home)
    mut s := http.NewServer(8080)
    http.Use(s, r)
    http.Run(s)
end

page:
    title = "Served pages"
    paragraph: content = "A static page next to a runtime layout and the http package." end
end
