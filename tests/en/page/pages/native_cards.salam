// EXPECT: display: flex
// EXPECT: .card:hover { background: #ffeecc;
// EXPECT: box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25)
component Card(name):
    box:
        class = "card"
        padding = 12px
        border = "2px solid #3366aa"
        border radius = 10px
        box shadow = "0 4px 8px rgba(0, 0, 0, 0.25)"
        background = "#ffffff"
        hover background = "#ffeecc"
        heading: size = 3 content = name end
        paragraph: content = "Fresh {name}" end
    end
end

page:
    title = "Cards"
    lang = "en"
    box:
        id = "row"
        display = "flex"
        gap = 12px
        padding = 16px
        background = "#f4f6fa"
        Card: name = "Tea" end
        Card: name = "Coffee" end
        Card: name = "Juice" end
    end
    button:
        id = "order"
        content = "Order"
        padding = "8px 16px"
        border radius = 6px
        hover background = "#88aaff"
    end
end
