// EXPECT: flex-direction:var(--salam-dir,row)
// EXPECT: .card:hover { background-color:#ffeecc;
// EXPECT: box-shadow:0 4px 8px 0 #00000040
component Card(name):
    box:
        class = "card"
        padding = 12px
        border = 2px, solid, #3366aa
        radius = 10px
        shadow = [0, 4px, 8px, "rgba(0, 0, 0, 0.25)"]
        background = #ffffff
        hover background = #ffeecc
        heading: size = 3 content = name end
        paragraph: content = "Fresh {name}" end
    end
end

page:
    title = "Cards"
    lang = "en"
    box:
        id = "row"
        layout = row
        gap = 12px
        padding = 16px
        background = #f4f6fa
        Card: name = "Tea" end
        Card: name = "Coffee" end
        Card: name = "Juice" end
    end
    button:
        id = "order"
        content = "Order"
        padding = 8px, 16px
        radius = 6px
        hover background = #88aaff
    end
end
