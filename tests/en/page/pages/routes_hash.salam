// EXPECT: var __salam_rt_hash = true
// EXPECT-NOT: <meta name="salam-router"
mut signed_in := false

component Home:
    heading: content = "Home" end
end

component User(id: int):
    heading: content = "User " + id end
    button:
        id = "next"
        click = ():
            go("/users/" + (id + 1))
        end
        content = "Next user"
    end
    link: to = "/" content = "Back home" end
end

component Admin:
    paragraph: content = "Admin area" end
    button:
        id = "signout"
        click = ():
            signed_in = false
        end
        content = "Sign out"
    end
end

component Login:
    button:
        id = "login"
        click = ():
            signed_in = true
            replace("/admin")
        end
        content = "Sign in"
    end
end

component Missing:
    paragraph: content = "Nothing at " + route.path end
end

routes:
    mode = hash
    "/" : Home title = "Home"
    "/users/:id" : User
    "/admin" : Admin guard = signed_in redirect = "/login"
    "/login" : Login
    "*" : Missing
end

page:
    title = "Router"
    nav:
        link: to = "/" content = "Home" end
        link: to = "/users/1" content = "User 1" end
        link: to = "/admin" content = "Admin" end
    end
    Outlet: end
end
