// EXPECT: var __salam_rt_hash = true
// EXPECT-NOT: <meta name="salam-router"
mut signed_in := false

page:
    mode = hash
    title = "Router"
    nav:
        link:
            to = "/"
            content = "Home"
        end
        link:
            to = "/users/1"
            content = "User 1"
        end
        link:
            to = "/admin"
            content = "Admin"
        end
    end
    Outlet: end
end
