mut signed_in := false

pub component Home:
    heading:
        content = "Home"
    end
end

page:
    title = "Router"
    nav:
        link:
            to = "/"
            content = "Home"
        end
        link:
            to = "/users/1"
            content = "User 1"
        end
        link:
            to = "/admin"
            content = "Admin"
        end
    end
    link:
        id = "plain"
        url = "/users/7"
        content = "Plain link"
    end
    Outlet: end
end
