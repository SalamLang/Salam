// EXPECT: function __salam_route_pick(
// EXPECT-NOT: E086
const SITE := "Shop"

component Home:
    heading: content = SITE end
end

component Docs(topic: str = "intro", n: int = 1):
    paragraph: content = "Docs " + topic + " " + n end
end

routes:
    "/" : Home
    "/docs/:topic?/:n?" : Docs
end

page:
    title = "Options"
    Outlet: end
end
