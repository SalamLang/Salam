// EXPECT: <!--salam:0--><h1>Home</h1><p id="count">Count 3</p>
// EXPECT: <meta name="salam-router" content="history">
mut count := 3

pub component Home:
    heading: content = "Home" end
    paragraph: id = "count" content = "Count " + count end
    button: id = "more" click = (): count++ end content = "More" end
end

page:
    title = "Prerender"
    nav:
        link: to = "/" content = "Home" end
        link: to = "/about" content = "About" end
    end
    Outlet: end
end
