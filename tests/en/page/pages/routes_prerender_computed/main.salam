// EXPECT: <div><p>Hello from a function</p></div><!--/salam:0-->
func greeting(): str:
    ret "Hello from a function"
end

component Hero:
    sample := greeting()
    box:
        paragraph: content = sample end
    end
end

page:
    title = "Computed"
    Hero: end
    Outlet: end
end
