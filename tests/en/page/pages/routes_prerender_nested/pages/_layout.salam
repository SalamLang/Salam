component SiteHeader:
    menu := false
    header:
        button:
            content = menu ? "Close" : "Menu"
            click = (): menu = not menu end
        end
        if menu:
            paragraph: content = "open menu" end
        end
    end
end

pub component SiteLayout:
    box:
        SiteHeader: end
        Outlet: end
    end
end
