component Fruit(name: str):
    picked := false
    button:
        content = picked ? "picked" : name
        click = (): picked = true end
    end
end

pub component HomePage:
    title = "Home"
    fruits := ["apple", "pear"]
    box:
        each i, name in fruits:
            Fruit: key = i name = name end
        end
    end
end
