component Card(side: str):
    box:
        background = wide ? "#ffffff" : "#eeeeee"
        direction = side
        paragraph: content = "card" end
    end
end

pub component HomePage:
    title = "Home"
    button:
        content = "Widen"
        click = (): wide = true end
    end
    Card: side = wide ? "ltr" : "rtl" end
end
