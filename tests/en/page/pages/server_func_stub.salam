// EXPECT-BASE: /_salam/fn/
// EXPECT-BASE: Quote
// EXPECT-BASE: salam-server
// EXPECT-NOT: sk-live-do-not-ship
// EXPECT-NOT: vault-only-note
mut total := 0

func vault_note(): str:
    ret "vault-only-note"
end

server func Quote(sku: str): int: key := "sk-live-do-not-ship"
ret key.Len() + vault_note().Len() + sku.Len()
end

page:
    server = "https://front.example.com"
    box:
        button:
            click = (): total = Quote("a1") end
            content = "Get"
        end
        paragraph:
            content = total
        end
    end
end
