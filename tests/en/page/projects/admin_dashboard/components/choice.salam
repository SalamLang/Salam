pub component Choice(caption: str, active: bool, pick):
    button:
        class = "choice"
        type = button
        padding = 8, 14
        radius = 999
        cursor = pointer
        border = 1, solid, #cfd5e2
        background = #ffffff
        color = #1b2333
        if active:
            background = #2a49d8
            color = #ffffff
            border = 1, solid, #2a49d8
        end
        aria pressed = active ? "true" : "false"
        click = pick
        content = caption
    end
end
