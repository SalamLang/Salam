pub component RoleChoice(id: int, code: str, caption: str):
    button:
        class = "role-choice"
        type = button
        padding = 8, 14
        radius = 999
        cursor = pointer
        border = 1, solid, #cfd5e2
        background = #ffffff
        color = #1b2333
        if users[index_of(id)].role == code:
            background = #2a49d8
            color = #ffffff
            border = 1, solid, #2a49d8
        end
        click = ():
            set_user_role(id, code)
        end
        content = caption
    end
end

pub component ActiveToggle(id: int):
    button:
        class = "active-toggle"
        type = button
        padding = 8, 14
        radius = 999
        cursor = pointer
        border = 1, solid, #cfd5e2
        background = #ffffff
        color = #1b2333
        if users[index_of(id)].active:
            background = #2a49d8
            color = #ffffff
            border = 1, solid, #2a49d8
        end
        click = ():
            flip_user_active(id)
        end
        content = users[index_of(id)].active ? "Account is active" : "Account is disabled"
    end
end
