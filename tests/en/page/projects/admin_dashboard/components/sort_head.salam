pub component SortHead(caption: str, field: str):
    button:
        id = "sort-" + field
        border = 0
        padding = 0
        background = transparent
        font weight = 700
        font size = 13
        color = #4a5570
        cursor = pointer
        click = ():
            sort_by(field)
        end
        content = caption + ((sort_key == field) ? (sort_up ? " ▲" : " ▼") : "")
    end
end
