pub component StatCard(caption: str, amount: str, note: str):
    box:
        padding = 18
        gap = 4
        radius = 14
        background = "#ffffff"
        border = 1, "solid", "#e3e7ef"
        paragraph:
            margin = 0
            font size = 13
            color = "#667089"
            content = caption
        end
        paragraph:
            margin = 0
            font size = 28
            font weight = 800
            content = amount
        end
        paragraph:
            margin = 0
            font size = 13
            color = "#1f8a4c"
            content = note
        end
    end
end
