// EXPECT: var __salam_rt_hash = true
// EXPECT: function __salam_route_pick(
// EXPECT: Admin console
import dom

const PAGE_SIZE := 5

mut signed_in := false
mut me := ""
mut login_mail := ""
mut login_word := ""
mut login_error := ""
mut sort_key := "name"
mut sort_up := true
mut query := ""
mut role_filter := "all"
mut page_no := 0
mut users := seed_users()
mut saved_at := 0 - 1

struct User:
    pub id: int
    pub name: str
    pub mail: str
    pub role: str
    pub active: bool
    pub spend: int
end

func make_user(id: int, name: str, mail: str, role: str, active: bool, spend: int): User:
    ret User {id = id, name = name, mail = mail, role = role, active = active, spend = spend}
end

func seed_users(): Vector<User>:
    mut v := Vector {} as Vector<User>
    v.Push(make_user(1, "Ada Lovelace", "ada@example.com", "admin", true, 4200))
    v.Push(make_user(2, "Grace Hopper", "grace@example.com", "editor", true, 1850))
    v.Push(make_user(3, "Alan Turing", "alan@example.com", "viewer", false, 0))
    v.Push(make_user(4, "Linus Torvalds", "linus@example.com", "editor", true, 910))
    v.Push(make_user(5, "Margaret Hamilton", "margaret@example.com", "admin", true, 3100))
    v.Push(make_user(6, "Dennis Ritchie", "dennis@example.com", "viewer", true, 260))
    v.Push(make_user(7, "Barbara Liskov", "barbara@example.com", "editor", false, 740))
    v.Push(make_user(8, "Ken Thompson", "ken@example.com", "viewer", true, 120))
    v.Push(make_user(9, "Radia Perlman", "radia@example.com", "editor", true, 2380))
    v.Push(make_user(10, "Donald Knuth", "donald@example.com", "viewer", true, 505))
    v.Push(make_user(11, "Frances Allen", "frances@example.com", "admin", false, 1500))
    v.Push(make_user(12, "Tim Berners-Lee", "tim@example.com", "editor", true, 1975))
    ret v
end

pure func index_of(id: int): int:
    repeat users.Len() in i:
        if users[i].id == id:
            ret i
        end
    end
    ret 0 - 1
end

func sign_in():
    if login_mail.Trim().Len() == 0 or login_word.Len() == 0:
        login_error = "Enter your email and password."
        ret
    end
    if login_word != "salam":
        login_error = "Wrong password. Try salam."
        ret
    end
    signed_in = true
    me = login_mail.Trim()
    login_error = ""
    login_word = ""
    page.route.Redirect("/")
end

func sign_out():
    signed_in = false
    me = ""
    page.route.Redirect("/login")
end

func key_value(u: User, key: str): str:
    if key == "mail":
        ret u.mail.Lower()
    else key == "role":
        ret u.role
    else key == "spend":
        ret pad_num(u.spend)
    end
    ret u.name.Lower()
end

func pad_num(n: int): str:
    mut s := "" + n
    until s.Len() >= 9:
        s = "0" + s
    end
    ret s
end

func shows(u: User): bool:
    if role_filter != "all" and u.role != role_filter:
        ret false
    end
    q := query.Trim().Lower()
    if q.Len() == 0:
        ret true
    end
    ret u.name.Lower().Includes(q) or u.mail.Lower().Includes(q)
end

func matching(): Vector<int>:
    mut ids := Vector {} as Vector<int>
    repeat users.Len() in i:
        if shows(users[i]):
            ids.Push(i)
        end
    end
    n := ids.Len()
    repeat n in a:
        mut best := a
        repeat n - a in k:
            b := a + k
            ka := key_value(users[ids[best]], sort_key)
            kb := key_value(users[ids[b]], sort_key)
            before := sort_up ? kb < ka : kb > ka
            if before:
                best = b
            end
        end
        if best != a:
            t := ids[a]
            ids[a] = ids[best]
            ids[best] = t
        end
    end
    ret ids
end

func page_count(): int:
    n := matching().Len()
    if n == 0:
        ret 1
    end
    ret (n + PAGE_SIZE - 1) / PAGE_SIZE
end

func page_rows(): Vector<int>:
    all := matching()
    mut out := Vector {} as Vector<int>
    start := page_no * PAGE_SIZE
    repeat PAGE_SIZE in k:
        if start + k < all.Len():
            out.Push(all[start + k])
        end
    end
    ret out
end

func set_user_role(id: int, role: str):
    users[index_of(id)].role = role
end

func flip_user_active(id: int):
    at := index_of(id)
    users[at].active = not users[at].active
end

func sort_by(key: str):
    if sort_key == key:
        sort_up = not sort_up
    else:
        sort_key = key
        sort_up = true
    end
    page_no = 0
end

func set_query(v: str):
    query = v
    page_no = 0
end

func set_role(v: str):
    role_filter = v
    page_no = 0
end

func prev_page():
    if page_no > 0:
        page_no--
    end
end

func next_page():
    if page_no < page_count() - 1:
        page_no++
    end
end

func total_spend(): int:
    mut t := 0
    repeat users.Len() in i:
        t += users[i].spend
    end
    ret t
end

func active_count(): int:
    mut c := 0
    repeat users.Len() in i:
        if users[i].active:
            c++
        end
    end
    ret c
end

func role_count(role: str): int:
    mut c := 0
    repeat users.Len() in i:
        if users[i].role == role:
            c++
        end
    end
    ret c
end

pure func money(n: int): str:
    ret "$" + n
end

component NavLink(path: str, caption: str):
    link:
        to = path
        padding = 10, 14
        radius = 10
        color = #c4cad8
        text decoration = none
        hover:
            background = #20283d
        end
        content = caption
    end
end

pub component UserRow(at: int):
    row:
        key = users[at].id
        column:
            padding = 12, 14
            link:
                to = "/users/" + users[at].id
                color = #2a49d8
                font weight = 600
                text decoration = none
                content = users[at].name
            end
        end
        column:
            padding = 12, 14
            content = users[at].mail
        end
        column:
            padding = 12, 14
            content = users[at].role
        end
        column:
            padding = 12, 14
            span:
                padding = 2, 10
                radius = 999
                font size = 12
                background = users[at].active ? "#dcf5e6" : "#fbe4e4"
                color = users[at].active ? "#14633a" : "#9a2b2b"
                content = users[at].active ? "active" : "disabled"
            end
        end
        column:
            padding = 12, 14
            text align = right
            content = money(users[at].spend)
        end
    end
end

page:
    mode = hash
    title = "Admin console"
    lang = "en"
    style:
        content = "nav a[aria-current=page] { background: #2d3856; color: #ffffff; }"
    end
    font family = "system-ui, sans-serif"
    box:
        layout = row
        min height = 100vh
        background = #f3f5f9
        color = #1b2333
        if signed_in:
            nav:
                width = 220
                padding = 22, 14
                gap = 6
                background = #141a29
                link:
                    to = "/"
                    padding = 6, 12
                    font size = 20
                    font weight = 800
                    color = #ffffff
                    text decoration = none
                    content = "Admin console"
                end
                NavLink:
                    path = "/"
                    caption = "Overview"
                end
                NavLink:
                    path = "/users"
                    caption = "Users"
                end
                paragraph:
                    margin = 18, 0, 0, 12
                    font size = 13
                    color = #8a94a8
                    content = me
                end
                button:
                    id = "signout"
                    margin = 4, 0, 0, 0
                    padding = 9, 12
                    radius = 10
                    border = 0
                    background = #252d42
                    color = #e6e9f2
                    click = sign_out
                    content = "Sign out"
                end
            end
        end
        main:
            grow = 1
            padding = 30, 36
            Outlet: end
        end
    end
end
