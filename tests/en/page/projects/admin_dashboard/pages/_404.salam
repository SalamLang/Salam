pub component Missing:
    box:
        gap = 12
        max width = 480
        margin = 60, auto
        if signed_in:
            heading:
                size = 1
                content = "Page not found"
            end
            link:
                to = "/"
                content = "Back to the overview"
            end
        else:
            heading:
                size = 1
                content = "Sign in required"
            end
            paragraph:
                content = "This page is for signed in users."
            end
            button:
                id = "gate-login"
                padding = 10, 16
                radius = 10
                border = 0
                background = #2a49d8
                color = #ffffff
                click = ():
                    page.route.GoTo("/login")
                end
                content = "Go to sign in"
            end
        end
    end
end
