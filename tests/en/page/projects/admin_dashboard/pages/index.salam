pub component Overview:
    page.Guard(signed_in)
    title = "Overview"
    box:
        gap = 20
        heading:
            size = 1
            margin = 0
            content = "Overview"
        end
        box:
            layout = "grid"
            columns = repeat (fit, minmax(190px, 1fr))
            gap = 16
            StatCard:
                caption = "Users"
                amount = "" + users.Len()
                note = active_count() + " active"
            end
            StatCard:
                caption = "Revenue"
                amount = money(total_spend())
                note = "all time"
            end
            StatCard:
                caption = "Admins"
                amount = "" + role_count("admin")
                note = "full access"
            end
            StatCard:
                caption = "Editors"
                amount = "" + role_count("editor")
                note = "can publish"
            end
        end
        box:
            padding = 18
            radius = 14
            background = "#ffffff"
            border = 1, "solid", "#e3e7ef"
            gap = 8
            heading:
                size = 3
                margin = 0
                content = "Quick links"
            end
            link:
                to = "/users"
                content = "Manage users"
            end
        end
    end
end
