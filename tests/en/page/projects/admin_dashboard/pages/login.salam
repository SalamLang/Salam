pub component Login:
    title = "Sign in"
    form:
        id = "login-form"
        max width = 380
        margin = 60, auto
        padding = 28
        gap = 10
        radius = 16
        background = #ffffff
        border = 1, solid, #e3e7ef
        submit = (e: i64):
            dom.PreventDefault(e)
            sign_in()
        end
        heading:
            size = 1
            margin = 0
            content = "Admin console"
        end
        paragraph:
            margin = 0, 0, 8, 0
            color = #667089
            content = "Sign in with any email and the password salam."
        end
        label:
            for = "login-mail"
            font weight = 600
            content = "Email"
        end
        input:
            id = "login-mail"
            type = email
            padding = 10, 12
            radius = 10
            border = 1, solid, #cfd5e2
            placeholder = "you@example.com"
            bind = login_mail
        end
        label:
            for = "login-word"
            font weight = 600
            content = "Password"
        end
        input:
            id = "login-word"
            type = password
            padding = 10, 12
            radius = 10
            border = 1, solid, #cfd5e2
            bind = login_word
        end
        paragraph:
            id = "login-error"
            margin = 0
            min height = 20
            color = #b3261e
            content = login_error
        end
        button:
            id = "login"
            type = submit
            padding = 12
            radius = 10
            border = 0
            background = #2a49d8
            color = #ffffff
            font weight = 700
            content = "Sign in"
        end
    end
end
