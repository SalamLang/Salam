component UserEditor(id: int):
    if index_of(id) < 0:
        heading:
            size = 1
            content = "No such user"
        end
    else:
        box:
            gap = 16
            heading:
                size = 1
                margin = 0
                content = users[index_of(id)].name
            end
            form:
                id = "edit-form"
                padding = 22
                gap = 10
                radius = 14
                background = #ffffff
                border = 1, solid, #e3e7ef
                submit = (e: i64):
                    dom.PreventDefault(e)
                    saved_at = index_of(id)
                end
                label:
                    for = "edit-name"
                    font weight = 600
                    content = "Name"
                end
                input:
                    id = "edit-name"
                    padding = 10, 12
                    radius = 10
                    border = 1, solid, #cfd5e2
                    bind = users[index_of(id)].name
                end
                label:
                    for = "edit-mail"
                    font weight = 600
                    content = "Email"
                end
                input:
                    id = "edit-mail"
                    type = email
                    padding = 10, 12
                    radius = 10
                    border = 1, solid, #cfd5e2
                    bind = users[index_of(id)].mail
                end
                paragraph:
                    margin = 0
                    font weight = 600
                    content = "Role"
                end
                box:
                    layout = row
                    gap = 8
                    RoleChoice:
                        id = id
                        code = "admin"
                        caption = "Admin"
                    end
                    RoleChoice:
                        id = id
                        code = "editor"
                        caption = "Editor"
                    end
                    RoleChoice:
                        id = id
                        code = "viewer"
                        caption = "Viewer"
                    end
                end
                ActiveToggle:
                    id = id
                end
                paragraph:
                    id = "saved"
                    margin = 0
                    min height = 20
                    color = #1f8a4c
                    content = (saved_at == index_of(id)) ? "Saved." : ""
                end
                button:
                    id = "save"
                    type = submit
                    padding = 12
                    radius = 10
                    border = 0
                    background = #2a49d8
                    color = #ffffff
                    font weight = 700
                    content = "Save changes"
                end
            end
        end
    end
end

component UserPanel(id: int):
    box:
        gap = 16
        max width = 560
        link:
            to = "/users"
            color = #2a49d8
            content = "Back to users"
        end
        UserEditor:
            id = id
        end
    end
end

pub component UserDetail(id: int):
    page.Guard(signed_in)
    title = "User details"
    UserPanel:
        id = id
    end
end
