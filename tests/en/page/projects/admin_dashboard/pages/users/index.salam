pub component UserList:
    page.Guard(signed_in)
    title = "Users"
    box:
        gap = 16
        heading:
            size = 1
            margin = 0
            content = "Users"
        end
        box:
            layout = row
            gap = 10
            wrap = true
            input:
                id = "search"
                type = search
                grow = 1
                min width = 220
                padding = 10, 12
                radius = 10
                border = 1, solid, #cfd5e2
                placeholder = "Search name or email"
                value = query
                input = (v: str):
                    set_query(v)
                end
            end
            Choice:
                caption = "All roles"
                active = (role_filter == "all")
                pick = ():
                    set_role("all")
                end
            end
            Choice:
                caption = "Admins"
                active = (role_filter == "admin")
                pick = ():
                    set_role("admin")
                end
            end
            Choice:
                caption = "Editors"
                active = (role_filter == "editor")
                pick = ():
                    set_role("editor")
                end
            end
            Choice:
                caption = "Viewers"
                active = (role_filter == "viewer")
                pick = ():
                    set_role("viewer")
                end
            end
        end
        box:
            overflow = auto
            radius = 14
            background = #ffffff
            border = 1, solid, #e3e7ef
            table:
                width = 100%
                header:
                    row:
                        column:
                            heading = true
                            padding = 12, 14
                            text align = left
                            SortHead:
                                caption = "Name"
                                field = "name"
                            end
                        end
                        column:
                            heading = true
                            padding = 12, 14
                            text align = left
                            SortHead:
                                caption = "Email"
                                field = "mail"
                            end
                        end
                        column:
                            heading = true
                            padding = 12, 14
                            text align = left
                            SortHead:
                                caption = "Role"
                                field = "role"
                            end
                        end
                        column:
                            heading = true
                            padding = 12, 14
                            text align = left
                            content = "Status"
                        end
                        column:
                            heading = true
                            padding = 12, 14
                            text align = right
                            SortHead:
                                caption = "Spent"
                                field = "spend"
                            end
                        end
                    end
                end
                main:
                    each at in page_rows():
                        UserRow:
                            at = at
                        end
                    end
                end
            end
            if matching().Len() == 0:
                paragraph:
                    id = "empty"
                    padding = 20
                    color = #667089
                    content = "No users match."
                end
            end
        end
        box:
            layout = row
            align = center
            justify = between
            paragraph:
                id = "count"
                margin = 0
                color = #667089
                content = matching().Len() + " users, page " + (page_no + 1) + " of " + page_count()
            end
            box:
                layout = row
                gap = 8
                button:
                    id = "prev"
                    padding = 8, 14
                    radius = 8
                    border = 1, solid, #cfd5e2
                    background = #ffffff
                    if page_no == 0:
                        opacity = 0.4
                    end
                    aria disabled = (page_no == 0) ? "true" : "false"
                    click = prev_page
                    content = "Previous"
                end
                button:
                    id = "next"
                    padding = 8, 14
                    radius = 8
                    border = 1, solid, #cfd5e2
                    background = #ffffff
                    if page_no >= page_count() - 1:
                        opacity = 0.4
                    end
                    aria disabled = (page_no >= page_count() - 1) ? "true" : "false"
                    click = next_page
                    content = "Next"
                end
            end
        end
    end
end
