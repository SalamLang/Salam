pub component Square(game: int, sq: int, glyph: str, tone: int):
    button:
        class = "square"
        aspect ratio = 1
        min width = 0
        font size = 28
        font weight = 700
        radius = 10
        border = 0
        background = #2a3045
        color = #e8ebf4
        cursor = pointer
        if tone == 1:
            background = #3b4466
        end
        if tone == 2:
            background = #2f9e6e
            color = #ffffff
        end
        if tone == 3:
            background = #d64550
            color = #ffffff
        end
        if tone == 4:
            background = #d9a441
            color = #1c2030
        end
        click = ():
            press(game, sq)
        end
        content = glyph
    end
end
