pub component StatusBar(message: str, detail: str, good: bool):
    box:
        layout = "row"
        align = "center"
        justify = "between"
        padding = 10, 14
        radius = 10
        background = "#1c2030"
        paragraph:
            class = "status"
            margin = 0
            font weight = 700
            if good:
                color = #7ee2a8
            end
            content = message
        end
        small:
            class = "detail"
            opacity = 0.75
            content = detail
        end
    end
end
