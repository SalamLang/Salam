pub component Hub:
    title = "Arcade"
    box:
        gap = 14
        heading:
            size = 1
            margin = 0
            content = "Pick a game"
        end
        link:
            to = "/memory"
            padding = 16
            radius = 14
            background = #1c2030
            color = #e8ebf4
            text decoration = none
            content = "Memory match: find the six pairs"
        end
        link:
            to = "/tictactoe"
            padding = 16
            radius = 14
            background = #1c2030
            color = #e8ebf4
            text decoration = none
            content = "Tic tac toe: play a friend or the computer"
        end
        link:
            to = "/mines"
            padding = 16
            radius = 14
            background = #1c2030
            color = #e8ebf4
            text decoration = none
            content = "Mines: clear the grid without a blast"
        end
        paragraph:
            opacity = 0.7
            content = "Press r on any game to restart it."
        end
    end
end
