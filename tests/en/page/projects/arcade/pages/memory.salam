pub component Memory:
    title = "Memory"
    box:
        gap = 14
        heading:
            size = 2
            margin = 0
            content = "Memory match"
        end
        StatusBar:
            message = memory_won() ? "All pairs found" : "Find the pairs"
            detail = "Flips: " + flips + (best_flips > 0 ? ", best " + best_flips : "")
            good = memory_won()
        end
        box:
            layout = "grid"
            columns = 4
            gap = 10
            each _, card in CELLS12:
                Square:
                    game = 0
                    sq = card
                    glyph = (faces[card] == 0) ? "?" : symbol_of(deck[card])
                    tone = faces[card]
                end
            end
        end
        button:
            id = "again-memory"
            padding = 10, 20
            radius = 10
            border = 0
            background = "#ffd166"
            color = "#1c2030"
            font weight = 700
            cursor = "pointer"
            click = new_memory
            content = "Shuffle and restart"
        end
    end
end
