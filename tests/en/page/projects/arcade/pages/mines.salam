pub component Mines:
    title = "Mines"
    box:
        gap = 14
        heading:
            size = 2
            margin = 0
            content = "Mines"
        end
        StatusBar:
            message = boom ? "Boom! A mine went off" : (mines_won() ? "Cleared the field" : "Clear the safe squares")
            detail = "Flags left: " + flags_left()
            good = mines_won()
        end
        box:
            layout = "grid"
            columns = 6
            gap = 6
            each sq in CELLS36:
                Square:
                    game = 2
                    sq = sq
                    glyph = mine_glyph(sq)
                    tone = mine_tone(sq)
                end
            end
        end
        box:
            layout = "row"
            align = "center"
            gap = 14
            button:
                id = "again-mines"
                padding = 10, 20
                radius = 10
                border = 0
                background = "#ffd166"
                color = "#1c2030"
                font weight = 700
                cursor = "pointer"
                click = new_mines
                content = "New field"
            end
            label:
                layout = "row"
                align = "center"
                gap = 8
                input:
                    id = "flagging"
                    type = "checkbox"
                    bind = flag_mode
                end
                span:
                    content = "Flag mode (key f)"
                end
            end
        end
    end
end
