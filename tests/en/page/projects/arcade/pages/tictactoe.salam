pub component Tictactoe:
    title = "Tic tac toe"
    box:
        gap = 14
        heading:
            size = 2
            margin = 0
            content = "Tic tac toe"
        end
        StatusBar:
            message = ttt_status()
            detail = "X " + wins_x + "  O " + wins_o + "  draws " + draws
            good = ttt_over()
        end
        box:
            layout = grid
            columns = 3
            gap = 10
            each sq in CELLS9:
                Square:
                    game = 1
                    sq = sq
                    glyph = mark_text(board[sq])
                    tone = (board[sq] == 0) ? 0 : 1
                end
            end
        end
        box:
            layout = row
            align = center
            gap = 14
            button:
                id = "again-ttt"
                padding = 10, 20
                radius = 10
                border = 0
                background = #ffd166
                color = #1c2030
                font weight = 700
                cursor = pointer
                click = new_round
                content = "New round"
            end
            label:
                layout = row
                align = center
                gap = 8
                input:
                    id = "cpu"
                    type = checkbox
                    bind = versus_cpu
                end
                span:
                    content = "Play the computer"
                end
            end
        end
        small:
            opacity = 0.7
            content = "Keys 1 to 9 place a mark."
        end
    end
end
