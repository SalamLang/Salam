pub component PostCard(slug: str, title: str, summary: str, tag: str, date: str, minutes: int):
    article:
        padding = 18, 20
        radius = 14
        background = card_bg()
        border = 1, solid, line_color()
        gap = 6
        transition = 160ms
        hover:
            translate = 0, -2
        end
        box:
            layout = "row"
            gap = 10
            align = "center"
            color = muted()
            font family = "system-ui, sans-serif"
            font size = 13
            link:
                to = "/tag/" + tag
                color = accent()
                text decoration = "none"
                font weight = 600
                content = tag
            end
            span:
                content = date
            end
            span:
                class = "minutes"
                content = minutes + " min read"
            end
        end
        h2:
            margin = 0
            font size = 22
            link:
                to = "/post/" + slug
                color = page_fg()
                text decoration = "none"
                content = title
            end
        end
        paragraph:
            margin = 0
            color = muted()
            content = summary
        end
    end
end
