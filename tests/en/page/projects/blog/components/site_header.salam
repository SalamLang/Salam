pub component SiteHeader:
    header:
        layout = "row"
        align = "center"
        justify = "between"
        wrap = true
        gap = 12
        padding = 16, 24
        background = card_bg()
        border bottom = 1, solid, line_color()
        link:
            to = "/"
            font size = 22
            font weight = 700
            color = accent()
            text decoration = "none"
            content = "Field Notes"
        end
        nav:
            layout = "row"
            align = "center"
            gap = 18
            font family = "system-ui, sans-serif"
            font size = 15
            link:
                to = "/"
                color = page_fg()
                text decoration = "none"
                content = "Posts"
            end
            link:
                to = "/about"
                color = page_fg()
                text decoration = "none"
                content = "About"
            end
            button:
                id = "theme"
                padding = 6, 12
                radius = 999
                border = 1, solid, line_color()
                background = "transparent"
                color = page_fg()
                cursor = "pointer"
                click = (): dark = not dark end
                content = theme_label()
            end
        end
    end
end
