pub component TagChip(label: str, active: bool):
    button:
        padding = 4, 12
        radius = 999
        border = 1, solid, line_color()
        background = transparent
        color = muted()
        font = "system-ui, sans-serif"
        font size = 14
        cursor = "pointer"
        if active:
            background = accent()
            border = 1, solid, accent()
            color = #ffffff
        end
        click = (): active_tag = label == "all" ? "" : label end
        content = label
    end
end
