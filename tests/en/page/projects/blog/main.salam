// EXPECT: var __salam_rt_hash = true
// EXPECT: Field Notes
// EXPECT-NOT: <meta name="salam-router"
const WORDS_PER_MINUTE := 60

mut dark := false
mut query := ""
mut active_tag := ""

struct Article:
    pub slug: str
    pub title: str
    pub tag: str
    pub date: str
    pub summary: str
    pub body: str
end

func posts(): Vector<Article>:
    mut v := Vector {} as Vector<Article>
    v.Push(Article {
        slug = "slow-mornings"
        title = "In praise of slow mornings"
        tag = "life"
        date = "2026-03-02"
        summary = "Why the first hour of the day is better without a screen."
        body = "I used to reach for my phone before my eyes were fully open. Now the phone stays in another room until I have made tea and looked out of the window for a while. Nothing dramatic happened. I just noticed that the day began calmer, and that the small worries of the morning were smaller when I met them with a warm cup in my hands."
    })
    v.Push(Article {
        slug = "salam-first-page"
        title = "My first page in Salam"
        tag = "code"
        date = "2026-03-19"
        summary = "A page is a few lines of text that look like what they build."
        body = "A page in Salam reads like an outline. You write a box, put a heading in it, and give the heading a size and some words. There is no template language to learn and no build step to configure. When the page needed to remember something, I added a variable at the top, and every place that used it updated by itself. That was the moment it clicked for me, and I closed the other editor tab for good."
    })
    v.Push(Article {
        slug = "market-lunch"
        title = "A lunch at the Friday market"
        tag = "food"
        date = "2026-04-07"
        summary = "Flatbread, herbs and a stranger who gave away her recipe."
        body = "The stall was nothing more than a table, a hot plate and a stack of flatbread under a cloth. The woman behind it filled each one with herbs, a little cheese and a spoon of pickled onion. When I asked how she made the onions, she told me everything: the vinegar, the pinch of sugar, the three days of waiting. I went home with a jar of her pickles and a plan to try it the same evening. The first batch was too sour. The second was nearly right. By the third I understood why she smiled when I asked."
    })
    v.Push(Article {
        slug = "train-to-the-coast"
        title = "The slow train to the coast"
        tag = "life"
        date = "2026-05-14"
        summary = "Six hours, one window seat and no plan at all."
        body = "There is a train that takes six hours to reach the sea, and a bus that takes three. I took the train. Somewhere after the second tunnel I stopped checking the time and started counting orchards. We passed a school with its doors open, a field of sunflowers all facing the wrong way, and a man who waved at every carriage as if he knew us. Arriving was almost a disappointment, because I was just getting used to moving."
    })
    v.Push(Article {
        slug = "state-without-fear"
        title = "State without fear"
        tag = "code"
        date = "2026-06-01"
        summary = "Keep the truth in a few variables and draw everything from it."
        body = "Most bugs in small apps come from two copies of the same fact. A counter in a variable and a counter in a label that someone forgot to update. The cure is to keep the fact in one place and describe the screen as a function of it. In Salam the list on the page is just an each over a vector, the filter is a condition, and the count at the top is a method call. Change the vector and everything else follows. I no longer write code that redraws anything."
    })
    v.Push(Article {
        slug = "lentil-soup"
        title = "The only lentil soup you need"
        tag = "food"
        date = "2026-06-22"
        summary = "One pot, ten minutes of chopping, and leftovers for the week."
        body = "Fry a chopped onion in oil until it turns golden, then add a spoon of cumin and two grated carrots. Stir in a cup of red lentils and four cups of water, and let it all bubble gently for twenty minutes. Blend half of it, leave the other half rough, and finish with lemon juice and a lot of black pepper. It tastes better the next day, which is the real reason to make too much."
    })
    ret v
end

func tags(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("life")
    v.Push("code")
    v.Push("food")
    ret v
end

func word_count(text: str): int:
    ret text.Trim().Split(" ").Len()
end

func reading_minutes(a: Article): int:
    ret (word_count(a.body) + WORDS_PER_MINUTE - 1) / WORDS_PER_MINUTE
end

func is_visible(a: Article): bool:
    if active_tag.Len() > 0 and a.tag != active_tag:
        ret false
    end
    if query.Len() == 0:
        ret true
    end
    q := query.Lower()
    ret a.title.Lower().Includes(q) or a.summary.Lower().Includes(q)
end

func visible_count(): int:
    mut n := 0
    each a in posts():
        if is_visible(a):
            n++
        end
    end
    ret n
end

func find_post(slug: str): int:
    repeat posts().Len() in i:
        if posts().Get(i).slug == slug:
            ret i
        end
    end
    ret -1
end

func page_bg(): str:
    if dark:
        ret "#14161a"
    end
    ret "#faf8f4"
end

func page_fg(): str:
    if dark:
        ret "#e8e6e1"
    end
    ret "#24211c"
end

func card_bg(): str:
    if dark:
        ret "#1d2026"
    end
    ret "#ffffff"
end

func line_color(): str:
    if dark:
        ret "#2e323a"
    end
    ret "#e6e1d8"
end

func muted(): str:
    if dark:
        ret "#9a9a94"
    end
    ret "#7a7468"
end

func accent(): str:
    if dark:
        ret "#f0a35c"
    end
    ret "#b4531b"
end

func theme_label(): str:
    if dark:
        ret "Light mode"
    end
    ret "Dark mode"
end

page:
    mode = hash
    title = "Field Notes"
    lang = "en"
    font family = "Georgia, serif"
    box:
        min height = 100vh
        background = page_bg()
        color = page_fg()
        line height = 1.7
        transition = 200ms
        SiteHeader: end
        main:
            max width = 760
            margin = 0, auto
            padding = 32, 20
            Outlet: end
        end
        footer:
            padding = 24, 20
            text align = center
            color = muted()
            font size = 14
            content = "Field Notes, written in Salam"
        end
    end
end
