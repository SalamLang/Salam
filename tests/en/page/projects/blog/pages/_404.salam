pub component Missing:
    title = "Not found"
    box:
        gap = 12
        heading:
            size = 1
            content = "Page not found"
        end
        paragraph:
            content = "That page does not exist, or it has moved."
        end
        link:
            to = "/"
            color = accent()
            content = "Go to the latest posts"
        end
    end
end
