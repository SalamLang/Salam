pub component About:
    title = "About"
    box:
        gap = 14
        heading:
            size = 1
            margin = 0
            content = "About Field Notes"
        end
        paragraph:
            content = "Field Notes is a small personal blog about slow days, simple food and the code that runs this very page."
        end
        paragraph:
            content = "It is a single page app: every post is a route, the search box filters while you type, and the dark mode switch changes the colors of every part at once."
        end
        paragraph:
            color = muted()
            content = "Written in Salam with the page language only."
        end
    end
end
