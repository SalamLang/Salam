pub component Home:
    title = "Field Notes"
    box:
        gap = 18
        heading:
            size = 1
            margin = 0
            content = "Latest posts"
        end
        input:
            id = "search"
            type = "search"
            padding = 10, 14
            radius = 12
            border = 1, solid, line_color()
            background = card_bg()
            color = page_fg()
            font size = 16
            placeholder = "Search posts"
            aria label = "Search posts"
            bind = query
        end
        box:
            layout = "row"
            wrap = true
            gap = 8
            TagChip:
                label = "all"
                active = active_tag.Len() == 0
            end
            each _, t in tags():
                TagChip:
                    label = t
                    active = active_tag == t
                end
            end
        end
        paragraph:
            id = "count"
            margin = 0
            color = muted()
            content = visible_count() + " of " + posts().Len() + " posts"
        end
        each _, a in posts():
            if is_visible(a):
                PostCard:
                    slug = a.slug
                    title = a.title
                    summary = a.summary
                    tag = a.tag
                    date = a.date
                    minutes = reading_minutes(a)
                end
            end
        end
        if visible_count() == 0:
            paragraph:
                id = "empty"
                color = muted()
                content = "Nothing matches that search."
            end
        end
    end
end
