pub component PostPage(slug: str):
    at := find_post(slug)
    box:
        gap = 14
        if at >= 0:
            link:
                to = "/"
                color = accent()
                decoration = "none"
                content = "Back to all posts"
            end
            heading:
                size = 1
                margin = 0
                line height = 1.2
                content = posts()[at].title
            end
            box:
                layout = "row"
                gap = 12
                align = "center"
                color = muted()
                font = "system-ui, sans-serif"
                font size = 14
                link:
                    to = "/tag/" + posts()[at].tag
                    color = accent()
                    decoration = "none"
                    font weight = 600
                    content = posts()[at].tag
                end
                time:
                    datetime = posts()[at].date
                    content = posts()[at].date
                end
                span:
                    id = "minutes"
                    content = reading_minutes(posts()[at]) + " min read"
                end
            end
            paragraph:
                font size = 19
                line height = 1.8
                content = posts()[at].body
            end
        else:
            heading:
                size = 1
                content = "No such post"
            end
            link:
                to = "/"
                color = accent()
                content = "Back to all posts"
            end
        end
    end
end
