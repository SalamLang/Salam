pub component TagPage(name: str):
    title = "Posts tagged " + name
    box:
        gap = 18
        heading:
            size = 1
            margin = 0
            content = "Posts tagged " + name
        end
        each a in posts():
            if a.tag == name:
                PostCard:
                    slug = a.slug
                    title = a.title
                    summary = a.summary
                    tag = a.tag
                    date = a.date
                    minutes = reading_minutes(a)
                end
            end
        end
        link:
            to = "/"
            color = accent()
            text decoration = "none"
            content = "All posts"
        end
    end
end
