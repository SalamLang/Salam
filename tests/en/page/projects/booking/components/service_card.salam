pub component ServiceCard(at: int):
    button:
        class = "service"
        grow = 1
        basis = 0
        min width = 220
        padding = 20
        gap = 6
        radius = 16
        text align = "left"
        cursor = "pointer"
        background = #ffffff
        border = 2, solid, #d4e6e6
        hover:
            border = 2, solid, #0d6b6b
        end
        if service == at:
            border = 2, solid, #0d6b6b
            background = #e4f3f3
        end
        click = ():
            pick_service(at)
        end
        strong:
            font size = 17
            content = service_name(at)
        end
        span:
            color = "#4f6d72"
            content = service_minutes(at) + " minutes"
        end
        span:
            font size = 22
            font weight = 800
            color = "#0d6b6b"
            content = "$" + service_price(at)
        end
    end
end
