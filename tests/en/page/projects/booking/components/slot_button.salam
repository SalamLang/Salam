pub component SlotButton(clock: str):
    button:
        class = "slot"
        padding = 10, 0
        radius = 10
        cursor = pointer
        border = 1, solid, #b9d5d5
        background = #ffffff
        color = #123036
        aria disabled = is_taken(chosen, clock) ? "true" : "false"
        if is_taken(chosen, clock):
            background = #e6eded
            color = #9ab0b3
            cursor = not allowed
        end
        if slot == clock:
            background = #0d6b6b
            color = #ffffff
            border = 1, solid, #0d6b6b
        end
        click = ():
            pick_slot(clock)
        end
        content = clock
    end
end

pub component DayChip(offset: int):
    button:
        class = "day"
        padding = 10, 14
        radius = 12
        gap = 2
        text align = "center"
        cursor = "pointer"
        border = 1, solid, #b9d5d5
        background = #ffffff
        color = #123036
        if chosen == offset:
            background = #0d6b6b
            color = #ffffff
        end
        click = ():
            pick_day(offset)
        end
        small:
            content = weekday_name(offset)
        end
        strong:
            content = day_number(offset)
        end
    end
end
