// EXPECT: var __salam_rt_hash = true
// EXPECT: function __salam_route_pick(
// EXPECT: Clear Water Spa
import dom
import calendar

const BASE_YEAR := 2026
const BASE_MONTH := 11
const BASE_DAY := 24

mut service := -1
mut chosen := 0
mut slot := ""
mut guest := ""
mut mail := ""
mut tried := false
mut bookings := Vector {} as Vector<Booking>

struct Booking:
    pub service: int
    pub on_day: int
    pub slot: str
    pub guest: str
end

func service_name(i: int): str:
    if i == 0:
        ret "Deep tissue massage"
    else i == 1:
        ret "Facial treatment"
    else i == 2:
        ret "Sauna and steam"
    end
    ret "none"
end

func service_minutes(i: int): int:
    if i == 0:
        ret 60
    else i == 1:
        ret 45
    else i == 2:
        ret 90
    end
    ret 0
end

func service_price(i: int): int:
    if i == 0:
        ret 95
    else i == 1:
        ret 70
    else i == 2:
        ret 40
    end
    ret 0
end

func slot_time(k: int): str:
    h := 9 + k / 2
    m := k % 2 == 0 ? "00" : "30"
    ret (h < 10 ? "0" : "") + h + ":" + m
end

func jdn_of(offset: int): i64:
    base := calendar.GregorianToJDN(calendar.GregorianDate {year = BASE_YEAR, month = BASE_MONTH, day = BASE_DAY})
    ret base + offset
end

func weekday_name(offset: int): str:
    ret calendar.WeekdayNameEn(calendar.Weekday(jdn_of(offset)))
end

func month_name(m: int): str:
    names := ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    ret names[m]
end

func day_number(offset: int): str:
    d := calendar.JDNToGregorian(jdn_of(offset))
    ret "" + d.day
end

func day_label(offset: int): str:
    d := calendar.JDNToGregorian(jdn_of(offset))
    ret weekday_name(offset) + " " + d.day + " " + month_name(d.month)
end

func is_taken(offset: int, time: str): bool:
    repeat bookings.Len() in i:
        if bookings[i].on_day == offset and bookings[i].slot == time:
            ret true
        end
    end
    ret false
end

func free_count(offset: int): int:
    mut c := 0
    repeat 16 in k:
        if not is_taken(offset, slot_time(k)):
            c++
        end
    end
    ret c
end

func pick_service(i: int):
    service = i
    slot = ""
    page.route.GoTo("/time")
end

func pick_day(offset: int):
    chosen = offset
    slot = ""
end

func pick_slot(time: str):
    if not is_taken(chosen, time):
        slot = time
    end
end

func go_summary():
    if slot.Len() > 0:
        page.route.GoTo("/summary")
    end
end

func ready(): bool:
    ret service >= 0 and slot.Len() > 0
end

func mail_ok(): bool:
    ret mail.Includes("@") and mail.Includes(".")
end

func confirm():
    tried = true
    if guest.Trim().Len() == 0 or not mail_ok():
        ret
    end
    bookings.Push(Booking {service = service, on_day = chosen, slot = slot, guest = guest.Trim()})
    ref := bookings.Len() - 1
    service = -1
    slot = ""
    tried = false
    page.route.Redirect("/done/" + ref)
end

component Step(n: int, caption: str, current: int):
    box:
        layout = "row"
        align = "center"
        gap = 8
        color = "#7e9a9d"
        if current >= n:
            color = "#123036"
        end
        span:
            width = 26
            height = 26
            radius = 999
            text align = "center"
            line height = 26
            font size = 13
            font weight = 700
            background = "#c5dcdc"
            if current >= n:
                background = "#0d6b6b"
            end
            color = "#ffffff"
            content = "" + n
        end
        span:
            font size = 14
            content = caption
        end
    end
end

pub component Steps(current: int):
    nav:
        class = "steps"
        layout = "row"
        wrap = true
        gap = 22
        Step:
            n = 1
            caption = "Service"
            current = current
        end
        Step:
            n = 2
            caption = "Date and time"
            current = current
        end
        Step:
            n = 3
            caption = "Confirm"
            current = current
        end
    end
end

func seq(n: int): Vector<int>:
    mut v := Vector {} as Vector<int>
    repeat n in i:
        v.Push(i)
    end
    ret v
end

page:
    mode = "hash"
    title = "Clear Water Spa"
    lang = "en"
    font = "system-ui, sans-serif"
    background = "#f2f8f8"
    color = "#123036"
    header:
        padding = 18, 32
        gap = 12
        background = "#ffffff"
        border bottom = 1, "solid", "#d4e6e6"
        link:
            to = "/"
            font size = 20
            font weight = 800
            color = "#0d6b6b"
            decoration = "none"
            content = "Clear Water Spa"
        end
    end
    main:
        padding = 28, 32
        max width = 860
        margin = 0, "auto"
        Outlet: end
    end
end
