component DonePanel(ref: int):
    box:
        gap = 12
        max width = 520
        if ref >= bookings.Len():
            heading:
                size = 1
                content = "No such booking"
            end
        else:
            heading:
                size = 1
                margin = 0
                content = "You are booked"
            end
            paragraph:
                id = "reference"
                margin = 0
                font size = 18
                content = "Reference CW-" + (1000 + ref)
            end
            paragraph:
                id = "details"
                margin = 0
                content = service_name(bookings[ref].service) + ", " + day_label(bookings[ref].on_day) + " at " + bookings[ref].slot + " for " + bookings[ref].guest
            end
        end
        link:
            to = "/"
            color = #0d6b6b
            content = "Book another"
        end
    end
end

pub component Done(ref: int):
    title = "Booked"
    DonePanel:
        ref = ref
    end
end
