pub component ChooseService:
    title = "Choose a service"
    box:
        gap = 18
        Steps:
            current = 1
        end
        heading:
            size = 1
            margin = 0
            content = "Choose a service"
        end
        box:
            layout = row
            wrap = true
            gap = 14
            ServiceCard:
                at = 0
            end
            ServiceCard:
                at = 1
            end
            ServiceCard:
                at = 2
            end
        end
        paragraph:
            id = "booked-count"
            color = #4f6d72
            content = (bookings.Len() == 0) ? "No bookings yet." : bookings.Len() + " booked so far."
        end
    end
end
