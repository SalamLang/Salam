pub component Summary:
    page.Guard(ready())
    title = "Confirm"
    form:
        id = "confirm-form"
        gap = 12
        max width = 520
        submit = (e: i64):
            dom.PreventDefault(e)
            confirm()
        end
        Steps:
            current = 3
        end
        heading:
            size = 1
            margin = 0
            content = "Confirm your booking"
        end
        box:
            id = "summary"
            padding = 18
            gap = 4
            radius = 14
            background = "#ffffff"
            border = 1, solid, #d4e6e6
            strong:
                content = service_name(service)
            end
            span:
                content = day_label(chosen) + " at " + slot
            end
            span:
                color = "#4f6d72"
                content = service_minutes(service) + " minutes, $" + service_price(service)
            end
        end
        label:
            for = "guest"
            font weight = 600
            content = "Your name"
        end
        input:
            id = "guest"
            padding = 10, 12
            radius = 10
            border = 1, solid, #b9d5d5
            bind = guest
        end
        paragraph:
            id = "guest-note"
            margin = 0
            min height = 18
            color = "#b3261e"
            content = (tried and guest.Trim().Len() == 0) ? "Please tell us your name." : ""
        end
        label:
            for = "mail"
            font weight = 600
            content = "Email"
        end
        input:
            id = "mail"
            type = "email"
            padding = 10, 12
            radius = 10
            border = 1, solid, #b9d5d5
            bind = mail
        end
        paragraph:
            id = "mail-note"
            margin = 0
            min height = 18
            color = "#b3261e"
            content = (tried and not mail_ok()) ? "That does not look like an email address." : ""
        end
        box:
            layout = "row"
            gap = 12
            align = "center"
            link:
                to = "/time"
                color = "#0d6b6b"
                content = "Change time"
            end
            button:
                id = "confirm"
                type = "submit"
                padding = 12, 20
                radius = 10
                border = 0
                background = "#0d6b6b"
                color = "#ffffff"
                font weight = 700
                content = "Confirm booking"
            end
        end
    end
end
