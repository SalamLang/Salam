pub component PickTime:
    page.Guard(service >= 0)
    title = "Date and time"
    box:
        gap = 18
        Steps:
            current = 2
        end
        heading:
            size = 1
            margin = 0
            content = service_name(service)
        end
        box:
            id = "days"
            layout = "row"
            wrap = true
            gap = 8
            each _, d in seq(7):
                DayChip:
                    offset = d
                end
            end
        end
        paragraph:
            id = "free"
            margin = 0
            color = "#4f6d72"
            content = day_label(chosen) + ": " + free_count(chosen) + " times free"
        end
        box:
            id = "slots"
            layout = "grid"
            columns = repeat (fit, minmax(90px, 1fr))
            gap = 8
            each _, k in seq(16):
                SlotButton:
                    clock = slot_time(k)
                end
            end
        end
        box:
            layout = "row"
            gap = 12
            align = "center"
            link:
                to = "/"
                color = "#0d6b6b"
                content = "Back"
            end
            button:
                id = "to-summary"
                padding = 12, 20
                radius = 10
                border = 0
                background = "#0d6b6b"
                color = "#ffffff"
                font weight = 700
                if slot.Len() == 0:
                    opacity = 0.4
                end
                aria disabled = (slot.Len() == 0) ? "true" : "false"
                click = go_summary
                content = "Continue"
            end
        end
    end
end
