pub component Bubble(mine: int, message: str, sent_at: str):
    box:
        layout = "row"
        justify = start
        if mine == 1:
            justify = end
        end
        box:
            max width = 70%
            padding = 8, 12
            radius = 14
            background = #ffffff
            color = #1b2230
            shadow = 0, 1, 2, #0000001a
            if mine == 1:
                background = #3d5afe
                color = #ffffff
            end
            paragraph:
                margin = 0
                line height = 1.4
                content = message
            end
            paragraph:
                margin = 2, 0, 0, 0
                font size = 11
                opacity = 0.7
                text align = "end"
                content = sent_at
            end
        end
    end
end
