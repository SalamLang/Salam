pub component Composer(id: int):
    form:
        layout = row
        gap = 8
        padding = 12, 16
        background = #ffffff
        border top = 1, solid, #dde2eb
        submit = (ev: i64):
            dom.PreventDefault(ev)
            send(id)
        end
        input:
            id = "draft"
            grow = 1
            padding = 10, 14
            radius = 999
            border = 1, solid, #ccd3e0
            font size = 15
            placeholder = "Message " + name_of(id)
            bind = draft
        end
        button:
            id = "send"
            type = submit
            padding = 10, 20
            radius = 999
            border = 0
            background = #3d5afe
            color = #ffffff
            font weight = 600
            cursor = pointer
            content = "Send"
        end
    end
end
