// EXPECT: <meta name="salam-router" content="history">
// EXPECT: "/chat/:id"
// EXPECT: function __salam_route_pick(
import dom

const CHATS := [0, 1, 2, 3]

mut msg_chat := seed_chat()
mut msg_mine := seed_mine()
mut msg_text := seed_text()
mut msg_time := seed_time()
mut unread := seed_unread()
mut draft := ""
mut typing := -1
mut clock := 9 * 60 + 41
mut delay := 1200
mut dark := false

func seed_chat(): Vector<int>:
    mut entries := Vector {} as Vector<int>
    entries.Push(0)
    entries.Push(0)
    entries.Push(1)
    entries.Push(2)
    entries.Push(2)
    entries.Push(3)
    ret entries
end

func seed_mine(): Vector<int>:
    mut entries := Vector {} as Vector<int>
    entries.Push(0)
    entries.Push(1)
    entries.Push(0)
    entries.Push(0)
    entries.Push(0)
    entries.Push(1)
    ret entries
end

func seed_text(): Vector<str>:
    mut entries := Vector {} as Vector<str>
    entries.Push("Are we still on for lunch?")
    entries.Push("Yes, noon at the usual place")
    entries.Push("Pushed the fix, please review")
    entries.Push("The photos are ready")
    entries.Push("I put them in the shared folder")
    entries.Push("Thanks, see you Friday")
    ret entries
end

func seed_time(): Vector<int>:
    mut entries := Vector {} as Vector<int>
    entries.Push(8 * 60 + 12)
    entries.Push(8 * 60 + 15)
    entries.Push(9 * 60 + 2)
    entries.Push(9 * 60 + 30)
    entries.Push(9 * 60 + 31)
    entries.Push(7 * 60 + 50)
    ret entries
end

func seed_unread(): Vector<int>:
    mut entries := Vector {} as Vector<int>
    entries.Push(0)
    entries.Push(1)
    entries.Push(2)
    entries.Push(0)
    ret entries
end

pure func name_of(cid: int): str:
    if cid == 0:
        ret "Maya"
    else cid == 1:
        ret "Leo"
    else cid == 2:
        ret "Nora"
    end
    ret "Sam"
end

pure func pad2(num: int): str:
    if num < 10:
        ret "0" + num
    end
    ret "" + num
end

pure func stamp(minute: int): str:
    ret pad2(minute / 60 % 24) + ":" + pad2(minute % 60)
end

pure func canned(cid: int, num: int): str:
    rest := (cid + num) % 4
    if rest == 0:
        ret "Sounds good"
    else rest == 1:
        ret "Give me a minute"
    else rest == 2:
        ret "Ha, true"
    end
    ret "Let us talk tomorrow"
end

pure func last_text(cid: int): str:
    mut place := msg_text.Len() - 1
    until place >= 0:
        if msg_chat[place] == cid:
            ret msg_text[place]
        end
        place--
    end
    ret "No messages yet"
end

pure func total_unread(): int:
    mut piece := 0
    each num in unread:
        piece += num
    end
    ret piece
end

func add_message(cid: int, mine: int, message: str):
    clock++
    msg_chat.Push(cid)
    msg_mine.Push(mine)
    msg_text.Push(message)
    msg_time.Push(clock)
end

func read_chat(cid: int):
    unread[cid] = 0
end

func deliver(cid: int):
    add_message(cid, 0, canned(cid, msg_text.Len()))
    if typing == cid:
        typing = -1
    end
    if page.route.path != "/chat/" + cid:
        unread[cid] = unread[cid] + 1
    end
end

func send(cid: int):
    message := draft.Trim()
    if message.Len() == 0:
        ret
    end
    add_message(cid, 1, message)
    draft = ""
    typing = cid
    dom.SetTimeout((): deliver(cid) end, delay)
end

pub component ContactRow(place: int, person: str, snippet: str, unread_n: int, current: bool):
    link:
        to = "/chat/" + place
        layout = row
        align = center
        gap = 12
        padding = 10, 12
        radius = 12
        color = #1b2230
        if dark:
            color = #e6e9ef
        end
        text decoration = none
        hover:
            background = #eef1f6
        end
        if current:
            background = #e3e8ff
        end
        click = ():
            read_chat(place)
        end
        box:
            width = 40
            height = 40
            radius = 50%
            background = #3d5afe
            color = #ffffff
            align = center
            justify = center
            font weight = 700
            content = person.Substr(0, 1)
        end
        box:
            grow = 1
            min width = 0
            paragraph:
                margin = 0
                font weight = 700
                content = person
            end
            paragraph:
                margin = 0
                font size = 13
                opacity = 0.65
                ellipsis = true
                content = snippet
            end
        end
        if unread_n > 0:
            span:
                class = "badge"
                min width = 22
                padding = 2, 7
                radius = 999
                background = #ff3d71
                color = #ffffff
                font size = 12
                font weight = 700
                text align = center
                content = unread_n
            end
        end
    end
end

page:
    title = "Chatter"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        layout = row
        min height = 100vh
        background = #eef1f6
        color = #1b2230
        if dark:
            background = #10141c
            color = #e6e9ef
        end
        nav:
            width = 280
            gap = 4
            padding = 16, 10
            background = #ffffff
            border right = 1, solid, #dde2eb
            if dark:
                background = #181d28
                border right = 1, solid, #2a3140
            end
            box:
                layout = row
                align = center
                justify = between
                padding = 4, 8, 10, 8
                link:
                    to = "/"
                    font size = 20
                    font weight = 800
                    color = #3d5afe
                    text decoration = none
                    content = "chatter"
                end
                span:
                    id = "total"
                    font size = 13
                    opacity = 0.7
                    content = total_unread() + " unread"
                end
            end
            each cid in CHATS:
                ContactRow:
                    place = cid
                    person = name_of(cid)
                    snippet = last_text(cid)
                    unread_n = unread[cid]
                    current = (page.route.path == "/chat/" + cid)
                end
            end
            link:
                to = "/settings"
                margin = 14, 0, 0, 0
                padding = 10, 12
                color = #6b7385
                text decoration = none
                content = "Settings"
            end
        end
        main:
            grow = 1
            Outlet: end
        end
    end
end
