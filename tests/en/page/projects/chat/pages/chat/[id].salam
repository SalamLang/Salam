pub component Thread(id: int):
    title = "Chat with " + name_of(id)
    box:
        height = 100vh
        if id < 4:
            header:
                padding = 14, 20
                background = #ffffff
                border bottom = 1, solid, #dde2eb
                heading:
                    size = 2
                    margin = 0
                    content = name_of(id)
                end
                if typing == id:
                    small:
                        id = "typing"
                        opacity = 0.65
                        content = "typing..."
                    end
                end
            end
            box:
                grow = 1
                overflow = auto
                padding = 16, 20
                gap = 8
                each rowno, piece in msg_text:
                    if msg_chat[rowno] == id:
                        Bubble:
                            mine = msg_mine[rowno]
                            message = piece
                            sent_at = stamp(msg_time[rowno])
                        end
                    end
                end
            end
            Composer:
                id = id
            end
        else:
            box:
                padding = 40
                heading:
                    size = 2
                    content = "No such conversation"
                end
            end
        end
    end
end
