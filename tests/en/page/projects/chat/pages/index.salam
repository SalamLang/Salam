pub component Inbox:
    title = "Chatter"
    box:
        height = 100vh
        align = center
        justify = center
        gap = 8
        text align = center
        heading:
            size = 2
            content = "Pick a conversation"
        end
        paragraph:
            opacity = 0.7
            content = total_unread() + " unread messages waiting"
        end
    end
end
