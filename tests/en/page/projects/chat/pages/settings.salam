pub component Settings:
    title = "Settings"
    box:
        padding = 32
        gap = 16
        max width = 480
        heading:
            size = 1
            content = "Settings"
        end
        label:
            layout = row
            align = center
            gap = 10
            input:
                id = "dark"
                type = checkbox
                bind = dark
            end
            span:
                content = "Dark theme"
            end
        end
        label:
            gap = 6
            span:
                content = "Reply delay: " + delay + " ms"
            end
            input:
                id = "delay"
                type = range
                min = 200
                max = 4000
                step = 200
                value = delay
                input = (entries: str):
                    delay = entries.ToInt()
                end
            end
        end
    end
end
