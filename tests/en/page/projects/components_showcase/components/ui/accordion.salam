pub component AccordionItem(heading_text: str):
    opened := false
    box:
        border = 1, solid, #e1e4f0
        radius = 10
        background = #ffffff
        button:
            layout = row
            justify = between
            width = 100%
            padding = 12, 16
            border = 0
            background = transparent
            font weight = 600
            cursor = pointer
            click = (): opened = not opened end
            span:
                content = heading_text
            end
            span:
                content = opened ? "-" : "+"
            end
        end
        if opened:
            box:
                padding = 0, 16, 14, 16
                content: end
            end
        end
    end
end
