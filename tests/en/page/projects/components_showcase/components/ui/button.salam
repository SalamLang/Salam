pub component Btn(caption: str, kind: str, off: bool, act: func ()):
    held := false
    button:
        padding = 9, 18
        radius = 10
        border = 1, solid, #3c4a8a
        background = #3c4a8a
        color = #ffffff
        font weight = 600
        cursor = pointer
        transition = 120ms
        hover:
            opacity = 0.88
        end
        if kind == "soft":
            background = #e3e7fb
            color = #2b3770
        end
        if kind == "outline":
            background = #ffffff
            color = #3c4a8a
        end
        if kind == "danger":
            background = #b42318
            border color = #b42318
        end
        if held:
            opacity = 0.7
        end
        if off:
            opacity = 0.45
        end
        mouse down = (): held = true end
        mouse up = (): held = false end
        mouse leave = (): held = false end
        disabled = off
        click = act
        content = caption
    end
end
