pub component Card(heading_text: str, note: str):
    section:
        gap = 8
        padding = 18
        radius = 14
        background = "#ffffff"
        border = 1, "solid", "#e1e4f0"
        shadow = 0, 2, 8, #1d223614
        heading:
            size = 3
            content = heading_text
        end
        if note != "":
            small:
                opacity = 0.65
                content = note
            end
        end
        content: end
    end
end
