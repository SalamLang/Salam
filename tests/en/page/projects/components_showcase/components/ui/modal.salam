pub component Modal(shown: bool, heading_text: str):
    if shown:
        box:
            position = fixed
            inset = 0
            layout = column
            align = center
            justify = center
            background = #0f1224aa
            click = hide_modal
            dialog:
                id = "kit-modal"
                open = true
                click = (e: i64): dom.StopPropagation(e) end
                width = 92%
                max width = 420
                padding = 22
                radius = 16
                border = 0
                background = #ffffff
                color = #1d2236
                gap = 12
                heading:
                    size = 3
                    content = heading_text
                end
                content: end
                box:
                    layout = row
                    gap = 8
                    justify = end
                    Btn:
                        caption = "Cancel"
                        kind = "outline"
                        off = false
                        act = hide_modal
                    end
                    Btn:
                        caption = "Confirm"
                        kind = "solid"
                        off = false
                        act = confirm_modal
                    end
                end
            end
        end
    end
end
