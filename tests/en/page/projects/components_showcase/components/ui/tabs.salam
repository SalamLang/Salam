pub component TabButton(name: str, caption: str):
    button:
        padding = 8, 16
        border = 0
        border bottom = 3, solid, #00000000
        background = "transparent"
        color = #5a6288
        cursor = "pointer"
        if tab == name:
            border bottom = 3, solid, #3c4a8a
            color = #1d2236
            font weight = 700
        end
        click = (): pick_tab(name) end
        content = caption
    end
end

pub component TabBar:
    box:
        layout = "row"
        gap = 4
        border bottom = 1, solid, #e1e4f0
        content: end
    end
end
