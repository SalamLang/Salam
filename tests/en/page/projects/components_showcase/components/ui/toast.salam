pub component ToastStack:
    box:
        position = fixed
        bottom = 18
        right = 18
        gap = 8
        each t in toasts:
            box:
                padding = 10, 16
                radius = 10
                background = #1d2236
                color = #ffffff
                shadow = 0, 6, 18, #00000040
                content = t
            end
        end
    end
end
