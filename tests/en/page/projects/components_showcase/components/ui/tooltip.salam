pub component Tip(hint: str):
    hot := false
    span:
        layout = "column"
        gap = 4
        mouse enter = (): hot = true end
        mouse leave = (): hot = false end
        content: end
        if hot:
            small:
                align self = "start"
                padding = 3, 10
                radius = 8
                background = "#1d2236"
                color = "#ffffff"
                content = hint
            end
        end
    end
end
