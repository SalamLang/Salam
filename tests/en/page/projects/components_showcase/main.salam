// EXPECT: var __salam_rt_hash = true
// EXPECT: Design kit
// EXPECT: Open the modal
// EXPECT: Saved to your library
import dom

mut modal_open := false
mut tab := "usage"
mut toasts := Vector {} as Vector<str>
mut clicks := 0

func drop_toast():
    if toasts.Len() > 0:
        toasts.RemoveAt(0)
    end
end

func say(line_text: str):
    toasts.Push(line_text)
    _t := dom.SetTimeout((): drop_toast() end, 3000)
end

func show_modal():
    modal_open = true
end

func hide_modal():
    modal_open = false
end

func confirm_modal():
    modal_open = false
    clicks++
    say("Saved to your library")
end

func pick_tab(name: str):
    tab = name
end

page:
    mode = "hash"
    title = "Design kit"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = "#f6f7fb"
        color = "#1d2236"
        header:
            layout = "row"
            align = "center"
            gap = 20
            padding = 14, 28
            background = "#ffffff"
            border bottom = 1, "solid", "#e1e4f0"
            strong:
                font size = 20
                content = "Design kit"
            end
            nav:
                layout = "row"
                gap = 6
                link:
                    to = "/"
                    padding = 6, 12
                    radius = 8
                    text decoration = "none"
                    color = "#3c4a8a"
                    content = "Overview"
                end
                link:
                    to = "/buttons"
                    padding = 6, 12
                    radius = 8
                    text decoration = "none"
                    color = "#3c4a8a"
                    content = "Buttons"
                end
                link:
                    to = "/layout"
                    padding = 6, 12
                    radius = 8
                    text decoration = "none"
                    color = "#3c4a8a"
                    content = "Layout"
                end
                link:
                    to = "/overlays"
                    padding = 6, 12
                    radius = 8
                    text decoration = "none"
                    color = "#3c4a8a"
                    content = "Overlays"
                end
            end
        end
        main:
            max width = 860
            margin = 0, "auto"
            padding = 28
            Outlet: end
        end
        ToastStack: end
        Modal:
            shown = modal_open
            heading_text = "Add to library?"
            paragraph:
                content = "The item will be kept on this device."
            end
        end
    end
end
