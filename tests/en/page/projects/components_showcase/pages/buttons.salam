pub component Buttons:
    title = "Buttons"
    off := false
    box:
        gap = 16
        heading:
            size = 1
            content = "Buttons"
        end
        box:
            layout = "row"
            gap = 10
            wrap = true
            Btn:
                caption = "Solid"
                kind = "solid"
                off = off
                act = (): say("Solid pressed") end
            end
            Btn:
                caption = "Soft"
                kind = "soft"
                off = off
                act = (): say("Soft pressed") end
            end
            Btn:
                caption = "Outline"
                kind = "outline"
                off = off
                act = (): say("Outline pressed") end
            end
            Btn:
                caption = "Danger"
                kind = "danger"
                off = off
                act = (): say("Danger pressed") end
            end
        end
        label:
            layout = "row"
            gap = 8
            input:
                id = "off"
                type = "checkbox"
                change = (): off = not off end
            end
            span:
                content = "Disable all buttons"
            end
        end
    end
end
