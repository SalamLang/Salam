pub component Overview:
    title = "Design kit"
    box:
        gap = 16
        heading:
            size = 1
            content = "Design kit"
        end
        paragraph:
            content = "Small parts that every page of this project reuses: buttons, cards, a modal, tabs, an accordion, a tooltip and toasts."
        end
        box:
            layout = "grid"
            columns = "repeat(fill, minmax(240, 1fr))"
            gap = 14
            Card:
                heading_text = "Buttons"
                note = "four looks and a disabled state"
                link:
                    to = "/buttons"
                    content = "See the buttons"
                end
            end
            Card:
                heading_text = "Layout"
                note = "cards, tabs and an accordion"
                link:
                    to = "/layout"
                    content = "See the layout parts"
                end
            end
            Card:
                heading_text = "Overlays"
                note = "modal, tooltip and toasts"
                link:
                    to = "/overlays"
                    content = "See the overlays"
                end
            end
        end
        paragraph:
            content = "Items confirmed so far: " + clicks
        end
    end
end
