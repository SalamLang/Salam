pub component Layouts:
    title = "Layout"
    box:
        gap = 18
        heading:
            size = 1
            content = "Layout"
        end
        TabBar:
            TabButton:
                name = "usage"
                caption = "Usage"
            end
            TabButton:
                name = "props"
                caption = "Props"
            end
            TabButton:
                name = "notes"
                caption = "Notes"
            end
        end
        if tab == "usage":
            paragraph:
                id = "tab-usage"
                content = "Write the component name and fill its props. The body goes in the slot."
            end
        end
        if tab == "props":
            paragraph:
                id = "tab-props"
                content = "A Card takes heading_text and note. A Btn takes caption, kind, off and act."
            end
        end
        if tab == "notes":
            paragraph:
                id = "tab-notes"
                content = "Components live in the components folder and need no include."
            end
        end
        box:
            gap = 8
            AccordionItem:
                heading_text = "Why a slot?"
                paragraph:
                    content = "The content line marks where the children of the component go."
                end
            end
            AccordionItem:
                heading_text = "Where is the state?"
                paragraph:
                    content = "Open and closed lives inside each accordion item, tabs share one variable."
                end
            end
        end
    end
end
