pub component Overlays:
    title = "Overlays"
    box:
        gap = 16
        heading:
            size = 1
            content = "Overlays"
        end
        box:
            layout = "row"
            gap = 14
            align = "center"
            Btn:
                caption = "Open the modal"
                kind = "solid"
                off = false
                act = show_modal
            end
            Btn:
                caption = "Toast"
                kind = "soft"
                off = false
                act = (): say("Hello from a toast") end
            end
            Tip:
                hint = "Tooltips show on hover"
                strong:
                    content = "Hover me"
                end
            end
        end
        paragraph:
            content = "Confirmed " + clicks + " time(s)."
        end
    end
end
