page:
    title = "design"
    design = "shadcn"
    card:
        card content:
            button: variant = "secondary" content = "Save" end
            input: aria label = "name" end
            badge: variant = "outline" content = "badge" end
        end
    end
    accordion:
        type = "multiple"
        collapsible = true
        accordion item:
            value = "1"
            accordion trigger:
                content = "Why"
            end
            accordion content:
                content = "Because"
            end
        end
    end
    button: variant = "destructive" content = "clicked" end
    Outlet: end
end
