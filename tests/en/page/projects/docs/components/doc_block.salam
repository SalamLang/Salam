pub component DocBlock(text: str):
    if is_heading(text):
        h2:
            id = anchor_of(text)
            margin = 28, 0, 8, 0
            font size = 22
            content = heading_text(text)
        end
    else text.StartsWith("$ "):
        preformatted:
            margin = 8, 0
            padding = 12, 16
            radius = 10
            background = #0f1a2b
            color = #e2f3ef
            overflow = auto
            font family = "ui-monospace, monospace"
            font size = 14
            content = text.Substr(2, text.Len())
        end
    else:
        paragraph:
            margin = 8, 0
            content = text
        end
    end
end
