pub component DocsMenu:
    nav:
        width = 250
        padding = 24, 16
        gap = 18
        border right = 1, solid, #e4e7ee
        aria label = "Documentation"
        each s in sections():
            box:
                gap = 4
                paragraph:
                    margin = 0
                    font size = 12
                    font weight = 700
                    color = #6b7385
                    text transform = uppercase
                    letter spacing = 0.06em
                    content = section_title(s)
                end
                each d in docs():
                    if d.section == s:
                        SideLink:
                            target = doc_link(d)
                            label = d.title
                        end
                    end
                end
            end
        end
    end
end
