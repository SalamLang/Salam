pub component Pager(at: int):
    nav:
        layout = row
        justify = between
        gap = 12
        margin = 36, 0, 0, 0
        aria label = "Previous and next"
        if at > 0:
            link:
                id = "prev"
                to = doc_path(at - 1)
                padding = 10, 16
                radius = 10
                border = 1, solid, #e4e7ee
                color = #1c2230
                text decoration = none
                content = "Previous: " + docs().Get(at - 1).title
            end
        else:
            span: end
        end
        if at + 1 < docs().Len():
            link:
                id = "next"
                to = doc_path(at + 1)
                padding = 10, 16
                radius = 10
                border = 1, solid, #e4e7ee
                color = #1c2230
                text decoration = none
                content = "Next: " + docs().Get(at + 1).title
            end
        end
    end
end
