pub component SideLink(target: str, label: str):
    link:
        to = target
        padding = 6, 10
        radius = 8
        color = #364054
        text decoration = none
        hover:
            background = #f1f4f9
        end
        if on_route(target):
            background = #ccfbf1
            color = #0f766e
            font weight = 600
        end
        content = label
    end
end
