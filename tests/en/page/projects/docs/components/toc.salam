pub component Toc(at: int):
    if heading_count(at) > 0:
        nav:
            id = "toc"
            padding = 12, 16
            radius = 12
            background = "#f6f8fb"
            gap = 4
            aria label = "On this page"
            paragraph:
                margin = 0
                font size = 12
                font weight = 700
                color = "#6b7385"
                transform text = "upper"
                content = "On this page"
            end
            each _, b in blocks_of(at):
                if is_heading(b):
                    link:
                        url = "#" + anchor_of(b)
                        color = "#0f766e"
                        decoration = "none"
                        font size = 14
                        content = heading_text(b)
                    end
                end
            end
        end
    end
end
