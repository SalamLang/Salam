// EXPECT: <meta name="salam-router" content="history">
// EXPECT: Kite docs
import str

const PRODUCT := "Kite"

struct Doc:
    pub section: str
    pub slug: str
    pub title: str
    pub body: str
end

func make_doc(section: str, slug: str, title: str, body: str): Doc:
    ret Doc { section = section slug = slug title = title body = body }
end

func docs(): Vector<Doc>:
    mut v := Vector {} as Vector<Doc>
    v.Push(make_doc("start", "intro", "Introduction",
        "Kite builds a static site from a folder of text files.\n# What you get\nA fast build, clean addresses and no runtime to ship.\n# Who it is for\nPeople who write more than they configure."))
    v.Push(make_doc("start", "install", "Installation",
        "Kite is one file. Download it, put it on your path and check the version.\n# Download\nPick the archive for your system.\n$ kite version\n# Update\nRun the same command again to update in place."))
    v.Push(make_doc("guide", "pages", "Writing pages",
        "Every file in the content folder becomes one page.\n# Front matter\nThe first lines of a file hold its title and date.\n$ title: Hello\n# Links\nLink to other pages by file name and Kite fixes the address for you."))
    v.Push(make_doc("guide", "themes", "Themes",
        "A theme is a folder of templates and styles.\n# Choosing a theme\nSet the theme name in the config file.\n$ theme = \"paper\"\n# Writing your own\nStart from the default theme and change one template at a time."))
    v.Push(make_doc("reference", "config", "Configuration",
        "All settings live in kite.toml at the root of the project.\n# Keys\nThe keys are title, base, theme and out.\n$ out = \"public\"\n# Defaults\nEvery key has a default, so an empty file is valid."))
    v.Push(make_doc("reference", "cli", "Command line",
        "The command line has three commands.\n# build\nWrites the site to the out folder.\n$ kite build\n# serve\nServes the site and rebuilds when a file changes.\n# clean\nRemoves the out folder."))
    ret v
end

func section_title(section: str): str:
    if section == "start":
        ret "Getting started"
    else section == "guide":
        ret "Guide"
    end
    ret "Reference"
end

func sections(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("start")
    v.Push("guide")
    v.Push("reference")
    ret v
end

func find_doc(section: str, slug: str): int:
    all := docs()
    repeat all.Len() in i:
        d := all.Get(i)
        if d.section == section and d.slug == slug:
            ret i
        end
    end
    ret -1
end

func on_route(target: str): bool:
    ret page.route.path == target
end

func doc_link(d: Doc): str:
    ret "/docs/" + d.section + "/" + d.slug
end

func doc_path(at: int): str:
    d := docs().Get(at)
    ret "/docs/" + d.section + "/" + d.slug
end

func blocks_of(at: int): Vector<str>:
    ret docs().Get(at).body.Split("\n")
end

func is_heading(block: str): bool:
    ret block.StartsWith("# ")
end

func heading_text(block: str): str:
    ret block.Substr(2, block.Len())
end

func anchor_of(block: str): str:
    ret str.Replace(heading_text(block).Lower(), " ", "-")
end

func heading_count(at: int): int:
    mut n := 0
    each b in blocks_of(at):
        if is_heading(b):
            n++
        end
    end
    ret n
end

page:
    title = PRODUCT + " docs"
    lang = "en"
    font family = "system-ui, sans-serif"
    background = #ffffff
    color = #1c2230
    line height = 1.65
    header:
        layout = row
        align = center
        justify = between
        padding = 14, 24
        border bottom = 1, solid, #e4e7ee
        position = sticky
        top = 0
        background = #ffffff
        link:
            to = "/"
            font size = 20
            font weight = 800
            color = #0f766e
            text decoration = none
            content = PRODUCT
        end
        nav:
            layout = row
            gap = 18
            link:
                to = "/docs"
                color = #1c2230
                text decoration = none
                content = "Docs"
            end
            link:
                to = "/docs/reference/cli"
                color = #1c2230
                text decoration = none
                content = "CLI"
            end
        end
    end
    main:
        Outlet: end
    end
end
