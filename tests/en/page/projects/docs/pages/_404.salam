pub component Missing:
    title = "Not found"
    section:
        max width = 640
        margin = 0, auto
        padding = 48, 24
        gap = 12
        heading:
            size = 1
            content = "Page not found"
        end
        link:
            to = "/docs"
            color = "#0f766e"
            content = "Browse the docs"
        end
    end
end
