pub component DocPage(section: str, slug: str):
    at := find_doc(section, slug) as int
    if at >= 0:
        title = docs().Get(at).title + " | " + PRODUCT
        article:
            max width = 720
            paragraph:
                margin = 0
                color = "#6b7385"
                font size = 14
                content = section_title(section)
            end
            heading:
                size = 1
                margin = 4, 0, 12, 0
                content = docs().Get(at).title
            end
            Toc:
                at = at
            end
            each _, b in blocks_of(at):
                DocBlock:
                    text = b
                end
            end
            Pager:
                at = at
            end
        end
    else:
        box:
            gap = 10
            heading:
                size = 1
                content = "No such doc page"
            end
            link:
                to = "/docs"
                color = "#0f766e"
                content = "Browse the docs"
            end
        end
    end
end
