pub component DocsLayout:
    box:
        layout = "row"
        wrap = true
        max width = 1200
        margin = 0, auto
        DocsMenu: end
        section:
            grow = 1
            basis = 0
            min width = 320
            padding = 28, 32
            Outlet: end
        end
    end
end
