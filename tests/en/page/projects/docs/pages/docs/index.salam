pub component DocsHome:
    title = "Documentation | " + PRODUCT
    box:
        gap = 14
        max width = 720
        heading:
            size = 1
            margin = 0
            content = "Documentation"
        end
        paragraph:
            margin = 0
            content = "Everything about " + PRODUCT + ", from the first install to the last config key."
        end
        each s in sections():
            box:
                gap = 4
                h2:
                    margin = 14, 0, 0, 0
                    font size = 20
                    content = section_title(s)
                end
                each i, d in docs():
                    if d.section == s:
                        link:
                            to = doc_path(i)
                            color = #0f766e
                            content = d.title
                        end
                    end
                end
            end
        end
    end
end
