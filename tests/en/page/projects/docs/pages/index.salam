pub component Landing:
    title = PRODUCT + " docs"
    section:
        max width = 760
        margin = 0, auto
        padding = 72, 24
        gap = 16
        text align = "center"
        heading:
            size = 1
            margin = 0
            font size = 54
            content = PRODUCT
        end
        paragraph:
            margin = 0
            font size = 20
            color = "#4a5468"
            content = "A tiny toolkit that turns a folder of text into a fast static site."
        end
        box:
            layout = "row"
            justify = "center"
            gap = 12
            link:
                to = "/docs/start/intro"
                padding = 12, 22
                radius = 12
                background = "#0f766e"
                color = "#ffffff"
                text decoration = "none"
                font weight = 600
                content = "Read the docs"
            end
            link:
                to = "/docs/start/install"
                padding = 12, 22
                radius = 12
                border = 1, solid, #cdd3de
                color = "#1c2230"
                text decoration = "none"
                content = "Install"
            end
        end
    end
end
