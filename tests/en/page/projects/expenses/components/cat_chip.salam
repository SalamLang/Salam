pub component CategoryChip(cat: int):
    button:
        class = "chip"
        type = "button"
        padding = 5, 12
        radius = 16
        border = 2, "solid", cat_color(cat)
        background = cat_pick == cat ? cat_color(cat) : "#ffffff"
        color = cat_pick == cat ? "#ffffff" : "#25221d"
        cursor = "pointer"
        aria pressed = cat_pick == cat
        click = (): cat_pick = cat end
        content = cat_name(cat)
    end
end
