pub component Chart(month: int):
    box:
        class = "chart"
        gap = 8
        each c in CATS:
            box:
                class = "bar-row"
                width = 100%
                layout = "row"
                align = "center"
                gap = 10
                span:
                    width = 64
                    content = cat_name(c)
                end
                box:
                    grow = 1
                    min width = 120
                    height = 18
                    radius = 9
                    background = "#e8e5de"
                    box:
                        class = "bar"
                        height = 18
                        radius = 9
                        background = cat_color(c)
                        width = share(c, month) + "%"
                    end
                end
                span:
                    class = "bar-total"
                    width = 64
                    text align = "end"
                    content = "$" + cat_total(c, month)
                end
            end
        end
    end
end
