pub component EntryForm:
    form:
        gap = 10
        padding = 14
        radius = 14
        background = "#ffffff"
        submit = (e: i64):
            dom.PreventDefault(e)
            add_expense()
        end
        box:
            layout = "row"
            gap = 8
            wrap = true
            input:
                id = "desc"
                grow = 2
                min width = 140
                padding = 10, 12
                radius = 10
                border = 1, "solid", "#d8d4cb"
                placeholder = "What was it?"
                aria label = "Description"
                bind = desc_text
            end
            input:
                id = "amount"
                grow = 1
                min width = 90
                padding = 10, 12
                radius = 10
                border = 1, "solid", "#d8d4cb"
                placeholder = "Amount"
                aria label = "Amount"
                bind = amount_text
            end
            input:
                id = "month"
                width = 64
                padding = 10, 12
                radius = 10
                border = 1, "solid", "#d8d4cb"
                aria label = "Month number"
                bind = month_text
            end
        end
        box:
            layout = "row"
            gap = 6
            wrap = true
            role = "group"
            aria label = "Category"
            each _, c in CATS:
                CategoryChip:
                    cat = c
                end
            end
        end
        box:
            layout = "row"
            align = "center"
            gap = 12
            button:
                id = "add"
                type = "submit"
                padding = 10, 20
                radius = 10
                border = 0
                background = "#25221d"
                color = "#ffffff"
                font weight = 600
                cursor = "pointer"
                content = "Add expense"
            end
            if problem.Len() > 0:
                span:
                    id = "problem"
                    color = "#b42318"
                    role = "alert"
                    content = problem
                end
            end
        end
    end
end
