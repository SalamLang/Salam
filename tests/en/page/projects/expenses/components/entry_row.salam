pub component EntryRow(at: int):
    item:
        class = "entry"
        layout = "row"
        align = "center"
        gap = 10
        padding = 10, 14
        radius = 10
        background = "#ffffff"
        box:
            width = 10
            height = 10
            radius = 5
            background = cat_color(cats.Get(at))
        end
        span:
            grow = 1
            content = descs.Get(at) + " (" + cat_name(cats.Get(at)) + ")"
        end
        span:
            class = "amount"
            font weight = 700
            content = "$" + amounts.Get(at)
        end
        button:
            class = "remove"
            border = 0
            background = "transparent"
            color = "#8a857a"
            cursor = "pointer"
            aria label = "Remove"
            click = (): remove_expense(at) end
            content = "x"
        end
    end
end
