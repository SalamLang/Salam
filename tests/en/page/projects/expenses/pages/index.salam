pub component Entries:
    title = "Entries"
    EntryForm: end
    box:
        layout = "row"
        justify = "between"
        align = "center"
        heading:
            size = 2
            margin = 0
            content = "All entries"
        end
        span:
            id = "grand"
            font weight = 700
            content = "Total $" + total_of(0)
        end
    end
    if descs.Len() == 0:
        paragraph:
            class = "empty"
            opacity = 0.6
            content = "No expenses yet."
        end
    else:
        list:
            padding = 0
            margin = 0
            gap = 6
            each i, _ in descs:
                EntryRow:
                    at = i
                end
            end
        end
    end
end
