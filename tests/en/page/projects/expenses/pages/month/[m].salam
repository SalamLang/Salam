pub component MonthPage(m: int):
    title = "Month"
    box:
        gap = 12
        if m >= 1 and m <= 12:
            heading:
                size = 1
                margin = 0
                content = month_name(m)
            end
            paragraph:
                id = "month-total"
                margin = 0
                content = count_of(m) + " entries, $" + total_of(m)
            end
            if count_of(m) > 0:
                paragraph:
                    id = "top"
                    margin = 0
                    content = "Biggest category: " + cat_name(top_cat(m))
                end
            end
            Chart:
                month = m
            end
        else:
            heading:
                size = 1
                content = "No such month"
            end
        end
        link:
            to = "/summary"
            content = "Back to the summary"
        end
    end
end
