pub component Summary:
    title = "Summary"
    heading:
        size = 1
        margin = 0
        content = "Summary"
    end
    paragraph:
        id = "overall"
        margin = 0
        content = count_of(0) + " entries, $" + total_of(0) + " in total"
    end
    Chart:
        month = 0
    end
    heading:
        size = 2
        margin = 0
        content = "By month"
    end
    box:
        layout = "row"
        gap = 6
        wrap = true
        each k in MONTHS:
            if count_of(k) > 0:
                link:
                    class = "month-link"
                    to = "/month/" + k
                    padding = 6, 12
                    radius = 8
                    background = "#e8e5de"
                    color = "#25221d"
                    text decoration = "none"
                    content = month_name(k)
                end
            end
        end
    end
end
