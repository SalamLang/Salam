pub component Avatar(nick: str):
    box:
        width = 36
        height = 36
        radius = 50%
        align = "center"
        justify = "center"
        color = "#ffffff"
        font weight = 700
        background = #4a5bd8
        if nick == "bo":
            background = #d8704a
        else nick == "cy":
            background = #2f9e6e
        else nick == "you":
            background = #8a4ad8
        end
        content = nick.Substr(0, 1).Upper()
    end
end
