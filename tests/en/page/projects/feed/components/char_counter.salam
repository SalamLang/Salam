pub component CharCounter(remaining: int):
    span:
        id = "counter"
        font weight = 600
        color = #6b7385
        if remaining < 20:
            color = #d97706
        end
        if remaining < 0:
            color = #dc2626
        end
        content = remaining
    end
end
