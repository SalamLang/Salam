pub component FollowButton(nick: str, active: bool):
    button:
        id = "follow"
        padding = 8, 20
        radius = 999
        border = 1, solid, #4a5bd8
        background = #4a5bd8
        color = #ffffff
        font weight = 600
        cursor = pointer
        if active:
            background = transparent
            color = #4a5bd8
        end
        click = ():
            toggle_follow(nick)
        end
        content = active ? "Following" : "Follow"
    end
end
