pub component LikeButton(post: int, total: int, lit: bool):
    button:
        class = "like"
        padding = 6, 12
        radius = 999
        border = 1, solid, #ccd2e0
        background = transparent
        cursor = "pointer"
        if lit:
            background = #ffe3ea
            border = 1, solid, #ff6b8b
            color = #c2204a
        end
        click = ():
            toggle_like(post)
        end
        content = (lit ? "Liked " : "Like ") + total
    end
end
