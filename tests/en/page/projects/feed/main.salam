// EXPECT: <meta name="salam-router" content="history">
// EXPECT: "/u/:nick"
// EXPECT: "/compose"
import dom

const HANDLES := ["ada", "bo", "cy"]
const LIMIT := 140

mut post_by := seed_by()
mut post_body := seed_body()
mut post_likes := seed_likes()
mut post_liked := seed_liked()
mut post_open := seed_liked()
mut note_post := Vector {} as Vector<int>
mut note_body := Vector {} as Vector<str>
mut follows := seed_follows()
mut draft := ""
mut used := 0
mut remark := ""
mut problem := ""
mut night := false

func seed_by(): Vector<str>:
    mut acc := Vector {} as Vector<str>
    acc.Push("ada")
    acc.Push("bo")
    acc.Push("ada")
    acc.Push("cy")
    acc.Push("bo")
    ret acc
end

func seed_body(): Vector<str>:
    mut acc := Vector {} as Vector<str>
    acc.Push("Shipped the router today. File names are routes now.")
    acc.Push("Coffee first, compiler second.")
    acc.Push("Small functions, small bugs.")
    acc.Push("Anyone up for a Salam meetup next week?")
    acc.Push("Reading the page DSL docs again, still finding new tricks.")
    ret acc
end

func seed_likes(): Vector<int>:
    mut acc := Vector {} as Vector<int>
    acc.Push(12)
    acc.Push(3)
    acc.Push(8)
    acc.Push(5)
    acc.Push(1)
    ret acc
end

func seed_liked(): Vector<int>:
    mut acc := Vector {} as Vector<int>
    acc.Push(0)
    acc.Push(0)
    acc.Push(0)
    acc.Push(0)
    acc.Push(0)
    ret acc
end

func seed_follows(): Vector<int>:
    mut acc := Vector {} as Vector<int>
    acc.Push(0)
    acc.Push(1)
    acc.Push(0)
    ret acc
end

pure func nick_index(nick: str): int:
    each at, candidate in HANDLES:
        if candidate == nick:
            ret at
        end
    end
    ret -1
end

pure func bio_of(nick: str): str:
    if nick == "ada":
        ret "Compiler tinkerer. Writes tests first."
    else nick == "bo":
        ret "Coffee, bikes and page layouts."
    else nick == "cy":
        ret "Organises the monthly meetup."
    end
    ret "Nobody lives here"
end

pure func posts_of(nick: str): int:
    mut total := 0
    each who in post_by:
        if who == nick:
            total++
        end
    end
    ret total
end

pure func notes_for(post: int): int:
    mut total := 0
    each wanted in note_post:
        if wanted == post:
            total++
        end
    end
    ret total
end

pure func fans_of(nick: str): int:
    at := nick_index(nick)
    if at < 0:
        ret 0
    end
    ret 20 + at * 7 + follows[at]
end

pure func is_following(nick: str): bool:
    at := nick_index(nick)
    if at < 0:
        ret false
    end
    ret follows[at] == 1
end

pure func left_chars(): int:
    ret LIMIT - used
end

func toggle_like(post: int):
    if post_liked[post] == 1:
        post_liked[post] = 0
        post_likes[post] = post_likes[post] - 1
    else:
        post_liked[post] = 1
        post_likes[post] = post_likes[post] + 1
    end
end

func toggle_notes(post: int):
    post_open[post] = 1 - post_open[post]
end

func toggle_follow(nick: str):
    at := nick_index(nick)
    if at >= 0:
        follows[at] = 1 - follows[at]
    end
end

func publish():
    clean := draft.Trim()
    if used == 0 or clean.Len() == 0:
        problem = "Write something first"
        ret
    end
    if used > LIMIT:
        problem = "That is " + (used - LIMIT) + " characters too long"
        ret
    end
    post_by.Insert(0, "you")
    post_body.Insert(0, clean)
    post_likes.Insert(0, 0)
    post_liked.Insert(0, 0)
    post_open.Insert(0, 0)
    repeat note_post.Len() in at:
        note_post[at] = note_post[at] + 1
    end
    draft = ""
    used = 0
    problem = ""
    page.route.GoTo("/")
end

func add_note(post: int):
    clean := remark.Trim()
    if clean.Len() == 0:
        ret
    end
    note_post.Push(post)
    note_body.Push(clean)
    remark = ""
end

func send_note(ev: i64, post: int):
    dom.PreventDefault(ev)
    add_note(post)
end

func compose_key(ev: i64):
    held := dom.GetBool(ev, "ctrlKey") or dom.GetBool(ev, "metaKey")
    if held and dom.EventKey(ev) == "Enter":
        dom.PreventDefault(ev)
        publish()
    end
end

func typed(chars: str):
    draft = chars
    used = dom.GetNum(dom.ById("draft"), "textLength") as int
    problem = ""
end

pub component PostCard(post: int, author: str, post_text: str, likes: int, liked: int, opened: int):
    article:
        gap = 10
        padding = 16
        radius = 14
        background = #ffffff
        border = 1, solid, #e3e6ee
        if night:
            background = #1b2130
            border = 1, solid, #2c3548
        end
        box:
            layout = row
            align = center
            gap = 10
            Avatar:
                nick = author
            end
            link:
                to = "/u/" + author
                font weight = 700
                color = #4a5bd8
                text decoration = none
                content = "@" + author
            end
        end
        paragraph:
            margin = 0
            line height = 1.5
            content = post_text
        end
        box:
            layout = row
            gap = 8
            LikeButton:
                post = post
                total = likes
                lit = (liked == 1)
            end
            button:
                class = "notes"
                padding = 6, 12
                radius = 999
                border = 1, solid, #ccd2e0
                background = transparent
                cursor = pointer
                click = ():
                    toggle_notes(post)
                end
                content = "Comments " + notes_for(post)
            end
        end
        if opened == 1:
            box:
                gap = 6
                each at, who in note_post:
                    if who == post:
                        paragraph:
                            margin = 0
                            padding = 6, 10
                            radius = 10
                            background = #f1f3f9
                            color = #1b2230
                            content = note_body[at]
                        end
                    end
                end
                form:
                    layout = row
                    gap = 6
                    submit = (ev: i64):
                        send_note(ev, post)
                    end
                    input:
                        class = "note-input"
                        grow = 1
                        padding = 6, 10
                        radius = 999
                        border = 1, solid, #ccd2e0
                        placeholder = "Reply"
                        bind = remark
                    end
                    button:
                        type = submit
                        padding = 6, 14
                        radius = 999
                        border = 0
                        background = #4a5bd8
                        color = #ffffff
                        cursor = pointer
                        content = "Reply"
                    end
                end
            end
        end
    end
end

page:
    title = "Chirp"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = #f4f5fa
        color = #1b2230
        if night:
            background = #0f1320
            color = #e6e9f2
        end
        header:
            layout = row
            align = center
            justify = between
            padding = 14, 24
            background = #4a5bd8
            link:
                to = "/"
                font size = 22
                font weight = 800
                color = #ffffff
                text decoration = none
                content = "chirp"
            end
            nav:
                layout = row
                gap = 8
                link:
                    to = "/compose"
                    padding = 8, 16
                    radius = 999
                    background = #ffffff
                    color = #4a5bd8
                    font weight = 600
                    text decoration = none
                    content = "New post"
                end
                link:
                    to = "/u/you"
                    padding = 8, 16
                    color = #ffffff
                    text decoration = none
                    content = "Profile"
                end
                button:
                    id = "night"
                    padding = 8, 12
                    radius = 999
                    border = 1, solid, #ffffff
                    background = transparent
                    color = #ffffff
                    cursor = pointer
                    click = ():
                        night = not night
                    end
                    content = night ? "Light" : "Dark"
                end
            end
        end
        main:
            max width = 640
            width = 100%
            margin = 0, auto
            padding = 20, 16
            Outlet: end
        end
    end
end
