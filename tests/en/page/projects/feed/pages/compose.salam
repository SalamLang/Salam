pub component Compose:
    title = "New post"
    box:
        gap = 12
        heading:
            size = 2
            margin = 0
            content = "New post"
        end
        box:
            key down = compose_key
            gap = 8
            input:
                id = "draft"
                type = "textarea"
                rows = 5
                padding = 12
                radius = 12
                border = 1, solid, #ccd2e0
                font size = 16
                placeholder = "What is happening? Ctrl+Enter posts."
                value = draft
                input = (chars: str):
                    typed(chars)
                end
            end
        end
        box:
            layout = row
            align = center
            justify = between
            CharCounter:
                remaining = left_chars()
            end
            button:
                id = "post"
                padding = 10, 22
                radius = 999
                border = 0
                background = #4a5bd8
                color = #ffffff
                font weight = 600
                cursor = pointer
                click = publish
                content = "Post"
            end
        end
        if problem.Len() > 0:
            paragraph:
                id = "problem"
                margin = 0
                color = #dc2626
                content = problem
            end
        end
    end
end
