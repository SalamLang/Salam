pub component Timeline:
    title = "Chirp"
    box:
        gap = 14
        heading:
            size = 2
            margin = 0
            content = "Latest posts"
        end
        each at, writer in post_by:
            PostCard:
                key = at
                post = at
                author = writer
                post_text = post_body[at]
                likes = post_likes[at]
                liked = post_liked[at]
                opened = post_open[at]
            end
        end
    end
end
