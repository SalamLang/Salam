pub component Profile(nick: str):
    title = "@" + nick
    box:
        gap = 14
        if nick_index(nick) >= 0 or nick == "you":
            box:
                layout = row
                align = center
                gap = 14
                Avatar:
                    nick = nick
                end
                box:
                    grow = 1
                    heading:
                        id = "who"
                        size = 2
                        margin = 0
                        content = "@" + nick
                    end
                    paragraph:
                        margin = 0
                        opacity = 0.7
                        content = bio_of(nick)
                    end
                end
                if nick != "you":
                    FollowButton:
                        nick = nick
                        active = (follows[nick_index(nick)] == 1)
                    end
                end
            end
            paragraph:
                id = "stats"
                margin = 0
                content = posts_of(nick) + " posts, " + fans_of(nick) + " followers"
            end
            each at, writer in post_by:
                if writer == nick:
                    PostCard:
                        post = at
                        author = writer
                        post_text = post_body[at]
                        likes = post_likes[at]
                        liked = post_liked[at]
                        opened = post_open[at]
                    end
                end
            end
        else:
            heading:
                size = 2
                content = "No such user"
            end
            link:
                to = "/"
                content = "Back to the timeline"
            end
        end
    end
end
