pub component Field(caption: str, target: str, problem: str, shown: bool):
    box:
        gap = 4
        label:
            for = target
            font weight = 600
            content = caption
        end
        content: end
        if shown and problem != "":
            small:
                id = target + "-error"
                color = "#b42318"
                content = problem
            end
        end
    end
end

pub component Plain(caption: str, target: str):
    box:
        gap = 4
        label:
            for = target
            font weight = 600
            content = caption
        end
        content: end
    end
end

pub component Notice(kind: str, message: str):
    box:
        padding = 12, 16
        radius = 10
        background = #e7f6ec
        color = #14532d
        if kind == "error":
            background = #fdecea
            color = #7a1f12
        end
        content = message
    end
end

pub component SummaryRow(row_key: str, row_val: str):
    box:
        layout = "row"
        gap = 12
        padding = 8, 0
        border bottom = 1, "solid", "#d9dcf2"
        strong:
            width = 140
            content = row_key
        end
        span:
            content = (row_val == "" ? "-" : row_val)
        end
    end
end
