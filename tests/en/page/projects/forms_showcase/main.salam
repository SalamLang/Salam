// EXPECT: var __salam_rt_hash = true
// EXPECT: type="range"
// EXPECT: type="date"
// EXPECT: type="file"
// EXPECT: Enter a valid email address
// EXPECT: Passwords do not match
import dom

mut full_name := ""
mut mail := ""
mut age := ""
mut secret := ""
mut again := ""
mut bio := ""
mut city := ""
mut plan := "free"
mut level := "5"
mut start := ""
mut cv_name := ""
mut news := false
mut terms := false
mut attempted := false
mut sent := false

func err_name(): str:
    if full_name.Len() < 2:
        ret "Tell us your name (2 letters or more)"
    end
    ret ""
end

func err_mail(): str:
    if not (mail.Includes("@") and mail.Includes(".")) or mail.Len() < 6:
        ret "Enter a valid email address"
    end
    ret ""
end

func err_age(): str:
    if age.Len() == 0 or age.Len() > 3:
        ret "Age is a number between 16 and 120"
    end
    n := age.ToInt()
    if n < 16 or n > 120:
        ret "Age is a number between 16 and 120"
    end
    ret ""
end

func err_secret(): str:
    if secret.Len() < 8:
        ret "Use at least 8 characters"
    end
    ret ""
end

func err_again(): str:
    if again != secret:
        ret "Passwords do not match"
    end
    ret ""
end

func err_city(): str:
    if city == "":
        ret "Pick a city"
    end
    ret ""
end

func err_terms(): str:
    if not terms:
        ret "You must accept the rules"
    end
    ret ""
end

func form_ok(): bool:
    ret err_name() == "" and err_mail() == "" and err_age() == "" and err_secret() == "" and err_again() == "" and err_city() == "" and err_terms() == ""
end

func problem_count(): int:
    mut n := 0
    if err_name() != "":
        n++
    end
    if err_mail() != "":
        n++
    end
    if err_age() != "":
        n++
    end
    if err_secret() != "":
        n++
    end
    if err_again() != "":
        n++
    end
    if err_city() != "":
        n++
    end
    if err_terms() != "":
        n++
    end
    ret n
end

func submit_form(e: i64):
    dom.PreventDefault(e)
    attempted = true
    if form_ok():
        sent = true
        page.route.GoTo("/review")
    end
end

func start_over():
    full_name = ""
    mail = ""
    age = ""
    secret = ""
    again = ""
    bio = ""
    city = ""
    plan = "free"
    level = "5"
    start = ""
    cv_name = ""
    news = false
    terms = false
    attempted = false
    sent = false
    page.route.GoTo("/register")
end

page:
    mode = "hash"
    title = "Hack Weekend"
    lang = "en"
    font = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = "#f3f4fb"
        color = "#1e2140"
        header:
            layout = "row"
            align = "center"
            gap = 16
            padding = 14, 28
            background = "#2b2f77"
            strong:
                color = "#ffffff"
                font size = 20
                content = "Hack Weekend"
            end
            nav:
                layout = "row"
                gap = 6
                link:
                    to = "/"
                    padding = 6, 12
                    radius = 8
                    color = "#dfe2ff"
                    decoration = "none"
                    content = "About"
                end
                link:
                    to = "/register"
                    padding = 6, 12
                    radius = 8
                    color = "#dfe2ff"
                    decoration = "none"
                    content = "Register"
                end
                if sent:
                    link:
                        to = "/review"
                        padding = 6, 12
                        radius = 8
                        color = "#dfe2ff"
                        decoration = "none"
                        content = "Your entry"
                    end
                end
            end
        end
        main:
            max width = 680
            margin = 0, "auto"
            padding = 28
            Outlet: end
        end
    end
end
