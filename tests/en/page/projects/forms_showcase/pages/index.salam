pub component Intro:
    title = "Hack Weekend"
    box:
        gap = 14
        heading:
            size = 1
            content = "Hack Weekend"
        end
        paragraph:
            content = "Two days, one idea, small teams. Fill in the form to get a seat."
        end
        link:
            to = "/register"
            align self = start
            padding = 10, 20
            radius = 10
            background = "#2b2f77"
            color = "#ffffff"
            text decoration = "none"
            content = "Register now"
        end
        if sent:
            Notice:
                kind = "ok"
                message = "Thanks " + full_name + ", your entry is saved."
            end
        end
    end
end
