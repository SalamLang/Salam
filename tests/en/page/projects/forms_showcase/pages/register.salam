pub component Register:
    title = "Register"
    form:
        id = "signup"
        gap = 16
        submit = submit_form
        heading:
            size = 1
            content = "Register"
        end
        if attempted and problem_count() > 0:
            Notice:
                kind = "error"
                message = problem_count() + " field(s) need attention"
            end
        end
        Field:
            caption = "Full name"
            target = "name"
            problem = err_name()
            shown = attempted
            input:
                id = "name"
                autocomplete = "name"
                placeholder = "Ada Lovelace"
                padding = 10, 12
                radius = 8
                border = 1, solid, #b8bce0
                bind = full_name
            end
        end
        Field:
            caption = "Email"
            target = "mail"
            problem = err_mail()
            shown = attempted
            input:
                id = "mail"
                type = "email"
                autocomplete = "email"
                padding = 10, 12
                radius = 8
                border = 1, solid, #b8bce0
                bind = mail
            end
        end
        Field:
            caption = "Age"
            target = "age"
            problem = err_age()
            shown = attempted
            input:
                id = "age"
                type = "number"
                min = 16
                max = 120
                padding = 10, 12
                radius = 8
                border = 1, solid, #b8bce0
                value = age
                input = (v: str): age = v end
            end
        end
        Field:
            caption = "Password"
            target = "secret"
            problem = err_secret()
            shown = attempted
            input:
                id = "secret"
                type = "password"
                autocomplete = "new-password"
                padding = 10, 12
                radius = 8
                border = 1, solid, #b8bce0
                bind = secret
            end
        end
        Field:
            caption = "Repeat the password"
            target = "again"
            problem = err_again()
            shown = attempted
            input:
                id = "again"
                type = "password"
                autocomplete = "new-password"
                padding = 10, 12
                radius = 8
                border = 1, solid, #b8bce0
                bind = again
            end
        end
        Field:
            caption = "City"
            target = "city"
            problem = err_city()
            shown = attempted
            select:
                id = "city"
                padding = 10, 12
                radius = 8
                change = (v: str): city = v end
                option:
                    value = ""
                    content = "Choose a city"
                end
                option group:
                    label = "Europe"
                    option:
                        value = "oslo"
                        content = "Oslo"
                    end
                    option:
                        value = "rome"
                        content = "Rome"
                    end
                end
                option group:
                    label = "Asia"
                    option:
                        value = "tokyo"
                        content = "Tokyo"
                    end
                end
            end
        end
        field set:
            legend:
                content = "Ticket"
            end
            label:
                layout = "row"
                gap = 8
                input:
                    id = "plan-free"
                    type = "radio"
                    name = "plan"
                    checked = (plan == "free")
                    change = (): plan = "free" end
                end
                span:
                    content = "Free (workshop only)"
                end
            end
            label:
                layout = "row"
                gap = 8
                input:
                    id = "plan-pro"
                    type = "radio"
                    name = "plan"
                    checked = (plan == "pro")
                    change = (): plan = "pro" end
                end
                span:
                    content = "Pro (workshop and dinner)"
                end
            end
        end
        Plain:
            caption = "Experience: " + level + " / 10"
            target = "level"
            input:
                id = "level"
                type = "range"
                min = 1
                max = 10
                value = level
                input = (v: str): level = v end
            end
        end
        Plain:
            caption = "Start date"
            target = "start"
            input:
                id = "start"
                type = "date"
                padding = 8, 12
                radius = 8
                border = 1, solid, #b8bce0
                value = start
                change = (v: str): start = v end
            end
        end
        Plain:
            caption = "About you (" + (200 - bio.Len()) + " characters left)"
            target = "bio"
            input:
                id = "bio"
                type = "textarea"
                rows = 4
                maxlength = 200
                padding = 10, 12
                radius = 8
                border = 1, solid, #b8bce0
                bind = bio
            end
        end
        Plain:
            caption = "CV (optional)" + (cv_name == "" ? "" : ": " + cv_name)
            target = "cv"
            input:
                id = "cv"
                type = "file"
                accept = ".pdf,.txt"
                change = ():
                    files := dom.GetProp(dom.ById("cv"), "files")
                    if dom.CountOf(files) > 0:
                        cv_name = dom.GetStr(dom.ItemAt(files, 0), "name")
                    else:
                        cv_name = ""
                    end
                end
            end
        end
        label:
            layout = "row"
            gap = 8
            input:
                id = "news"
                type = "checkbox"
                bind = news
            end
            span:
                content = "Send me the schedule by email"
            end
        end
        Field:
            caption = ""
            target = "terms"
            problem = err_terms()
            shown = attempted
            label:
                layout = "row"
                gap = 8
                input:
                    id = "terms"
                    type = "checkbox"
                    bind = terms
                end
                span:
                    content = "I accept the rules"
                end
            end
        end
        box:
            layout = "row"
            gap = 10
            button:
                id = "send"
                type = "submit"
                padding = 12, 24
                radius = 10
                border = 0
                background = "#2b2f77"
                color = "#ffffff"
                font weight = 600
                disabled:
                    opacity = 0.5
                end
                disabled = (attempted and not form_ok())
                content = "Send entry"
            end
            button:
                id = "clear"
                type = "button"
                padding = 12, 20
                radius = 10
                border = 1, solid, #b8bce0
                background = "transparent"
                click = start_over
                content = "Clear"
            end
        end
    end
end
