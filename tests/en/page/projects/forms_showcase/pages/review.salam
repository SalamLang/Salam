pub component Review:
    title = "Your entry"
    box:
        gap = 12
        heading:
            size = 1
            content = "Your entry"
        end
        if not sent:
            Notice:
                kind = "error"
                message = "Nothing was sent yet."
            end
            link:
                to = "/register"
                content = "Go to the form"
            end
        else:
            SummaryRow:
                row_key = "Name"
                row_val = full_name
            end
            SummaryRow:
                row_key = "Email"
                row_val = mail
            end
            SummaryRow:
                row_key = "Age"
                row_val = age
            end
            SummaryRow:
                row_key = "City"
                row_val = city
            end
            SummaryRow:
                row_key = "Ticket"
                row_val = plan
            end
            SummaryRow:
                row_key = "Experience"
                row_val = level + " / 10"
            end
            SummaryRow:
                row_key = "Start date"
                row_val = start
            end
            SummaryRow:
                row_key = "CV"
                row_val = cv_name
            end
            SummaryRow:
                row_key = "Schedule mail"
                row_val = news ? "yes" : "no"
            end
            button:
                id = "again-btn"
                align self = start
                padding = 10, 18
                radius = 10
                click = start_over
                content = "Register someone else"
            end
        end
    end
end
