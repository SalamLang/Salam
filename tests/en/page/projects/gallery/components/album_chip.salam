pub component AlbumChip(album: int, label: str, chosen: bool):
    button:
        class = "chip"
        padding = 8, 16
        radius = 999
        border = 1, "solid", "#c2410c"
        background = transparent
        color = #c2410c
        cursor = "pointer"
        if chosen:
            background = #c2410c
            color = #ffffff
        end
        click = ():
            pick_album(album)
        end
        content = label
    end
end
