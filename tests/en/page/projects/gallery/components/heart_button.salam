pub component HeartButton(shot: int, lit: bool):
    button:
        class = "heart"
        width = fill
        padding = 8
        border = 0
        border top = 1, solid, #e2e5ea
        background = transparent
        color = #6b7385
        cursor = pointer
        if lit:
            color = #e11d48
        end
        click = ():
            toggle_star(shot)
        end
        content = lit ? "♥ Saved" : "♡ Save"
    end
end
