pub component Favourites:
    title = "Favourites"
    box:
        gap = 16
        heading:
            size = 2
            margin = 0
            content = "Favourites"
        end
        if starred_total() == 0:
            paragraph:
                id = "none"
                content = "Nothing saved yet. Press Save on a photo."
            end
        end
        box:
            layout = "row"
            wrap = true
            gap = 14
            each i, shot in SHOTS:
                if starred[shot] == 1:
                    Tile:
                        key = i
                        shot = shot
                    end
                end
            end
        end
    end
end
