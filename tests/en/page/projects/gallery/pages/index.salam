pub component Grid:
    title = "Lumen"
    box:
        gap = 16
        heading:
            size = 2
            margin = 0
            content = "Photos"
        end
        box:
            layout = row
            wrap = true
            gap = 8
            AlbumChip:
                album = -1
                label = "All"
                chosen = (album_now < 0)
            end
            each album in ALBUMS:
                AlbumChip:
                    album = album
                    label = album_name(album)
                    chosen = (album_now == album)
                end
            end
        end
        paragraph:
            id = "shown"
            margin = 0
            opacity = 0.7
            content = shown_total() + " photos"
        end
        if recent >= 0:
            paragraph:
                id = "recent"
                margin = 0
                opacity = 0.7
                content = "Last opened: " + caption_of(recent)
            end
        end
        box:
            layout = row
            wrap = true
            gap = 14
            each shot in SHOTS:
                if shown(shot):
                    Tile:
                        shot = shot
                    end
                end
            end
        end
    end
end
