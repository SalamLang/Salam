pub component Viewer(id: int):
    title = caption_of(id)
    box:
        key down = browse_key
        tab index = 0
        id = "viewer"
        gap = 14
        if id >= 0 and id < 12:
            box:
                layout = "row"
                align = "center"
                justify = "between"
                link:
                    to = "/"
                    color = "#c2410c"
                    text decoration = "none"
                    content = "Back to the grid"
                end
                small:
                    opacity = 0.65
                    content = "Keys: left, right, f to save, Escape to close"
                end
            end
            box:
                height = 340
                radius = 20
                align = "center"
                justify = "center"
                font size = 140
                background = tone_of(id)
                content = glyph_of(id)
            end
            heading:
                id = "caption"
                size = 2
                margin = 0
                content = caption_of(id)
            end
            paragraph:
                margin = 0
                opacity = 0.7
                content = album_name(album_of(id)) + " album, photo " + (id + 1) + " of 12"
            end
            box:
                layout = "row"
                gap = 8
                link:
                    id = "prev"
                    to = "/photo/" + neighbour(id, -1)
                    padding = 8, 16
                    radius = 999
                    border = 1, solid, #c2410c
                    color = "#c2410c"
                    text decoration = "none"
                    content = "Previous"
                end
                link:
                    id = "next"
                    to = "/photo/" + neighbour(id, 1)
                    padding = 8, 16
                    radius = 999
                    border = 1, solid, #c2410c
                    color = "#c2410c"
                    text decoration = "none"
                    content = "Next"
                end
                button:
                    id = "star"
                    padding = 8, 16
                    radius = 999
                    border = 0
                    background = "#c2410c"
                    color = "#ffffff"
                    cursor = "pointer"
                    click = ():
                        toggle_star(id)
                    end
                    content = (starred[id] == 1) ? "Remove from favourites" : "Add to favourites"
                end
            end
        else:
            heading:
                size = 2
                content = "No such photo"
            end
            link:
                to = "/"
                content = "Back to the grid"
            end
        end
    end
end
