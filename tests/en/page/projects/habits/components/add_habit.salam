pub component AddHabit:
    form:
        gap = 6
        submit = (e: i64):
            dom.PreventDefault(e)
            add_habit()
        end
        box:
            layout = "row"
            gap = 8
            input:
                id = "name"
                grow = 1
                padding = 10, 12
                radius = 10
                border = 1, "solid", "#b8cabf"
                placeholder = "New habit"
                aria label = "New habit"
                bind = draft
            end
            button:
                id = "add"
                type = "submit"
                padding = 0, 18
                radius = 10
                border = 0
                background = "#1f6f4a"
                color = "#ffffff"
                font weight = 600
                cursor = "pointer"
                content = "Add"
            end
        end
        if problem.Len() > 0:
            paragraph:
                id = "problem"
                margin = 0
                color = "#b42318"
                role = "alert"
                content = problem
            end
        end
    end
end
