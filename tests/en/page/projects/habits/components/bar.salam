pub component Bar(label: str, value: int):
    box:
        layout = "row"
        align = "center"
        gap = 10
        span:
            width = 140
            content = label
        end
        box:
            grow = 1
            height = 14
            radius = 7
            background = "#dbe7df"
            box:
                class = "fill"
                height = 14
                radius = 7
                background = "#1f6f4a"
                width = value + "%"
            end
        end
        span:
            class = "pct"
            width = 44
            text align = "end"
            content = value + "%"
        end
    end
end
