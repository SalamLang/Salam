pub component DayCell(h: int, d: int):
    button:
        class = "cell"
        width = 36
        height = 36
        radius = 8
        border = 1, "solid", "#b8cabf"
        cursor = "pointer"
        background = is_set(h, d) ? "#1f6f4a" : "#ffffff"
        color = "#ffffff"
        aria label = names.Get(h) + " " + day_name(d)
        aria pressed = is_set(h, d)
        click = (): toggle_day(h, d) end
        content = is_set(h, d) ? "v" : ""
    end
end
