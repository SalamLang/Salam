// EXPECT: <meta name="salam-router" content="history">
// EXPECT: Habits
// EXPECT-NOT: var __salam_rt_hash = true
import dom

const DAYS := [0, 1, 2, 3, 4, 5, 6]

mut names := load_names()
mut marks := load_marks()
mut draft := ""
mut problem := ""

func records(): Vector<str>:
    mut out := Vector {} as Vector<str>
    raw := dom.StoreGetStr("habits.list")
    if raw.Len() == 0:
        out.Push("Drink water\t1110110")
        out.Push("Read 20 pages\t0110000")
        out.Push("Walk outside\t1011100")
        ret out
    end
    parts := raw.Split("\n")
    repeat parts.Len() in i:
        if parts.Get(i).Len() > 8:
            out.Push(parts.Get(i))
        end
    end
    ret out
end

func load_names(): Vector<str>:
    mut out := Vector {} as Vector<str>
    rows := records()
    repeat rows.Len() in i:
        out.Push(rows.Get(i).Split("\t").Get(0))
    end
    ret out
end

func load_marks(): Vector<str>:
    mut out := Vector {} as Vector<str>
    rows := records()
    repeat rows.Len() in i:
        out.Push(rows.Get(i).Split("\t").Get(1))
    end
    ret out
end

func save():
    mut out := ""
    repeat names.Len() in i:
        out += names.Get(i) + "\t" + marks.Get(i) + "\n"
    end
    dom.StoreSetStr("habits.list", out)
end

func day_name(d: int): str:
    if d == 0:
        ret "Mon"
    else d == 1:
        ret "Tue"
    else d == 2:
        ret "Wed"
    else d == 3:
        ret "Thu"
    else d == 4:
        ret "Fri"
    else d == 5:
        ret "Sat"
    end
    ret "Sun"
end

func is_set(h: int, d: int): bool:
    ret marks.Get(h).Substr(d, 1) == "1"
end

func toggle_day(h: int, d: int):
    row := marks.Get(h)
    flipped := is_set(h, d) ? "0" : "1"
    marks.Set(h, row.Substr(0, d) + flipped + row.Substr(d + 1, 7))
    save()
end

func week_total(h: int): int:
    mut n := 0
    repeat 7 in d:
        if is_set(h, d):
            n++
        end
    end
    ret n
end

func best_streak(h: int): int:
    mut best := 0
    mut run := 0
    repeat 7 in d:
        if is_set(h, d):
            run++
            if run > best:
                best = run
            end
        else:
            run = 0
        end
    end
    ret best
end

func current_streak(h: int): int:
    mut run := 0
    mut d := 6
    until d >= 0 and not is_set(h, d):
        d--
    end
    until d >= 0 and is_set(h, d):
        run++
        d--
    end
    ret run
end

func percent(h: int): int:
    ret week_total(h) * 100 / 7
end

func grand_total(): int:
    mut n := 0
    repeat names.Len() in h:
        n += week_total(h)
    end
    ret n
end

func best_habit(): int:
    mut at := -1
    mut top := -1
    repeat names.Len() in h:
        if week_total(h) > top:
            top = week_total(h)
            at = h
        end
    end
    ret at
end

func add_habit():
    clean := draft.Trim()
    if clean.Len() == 0:
        problem = "Give the habit a name"
        ret
    end
    if clean.Len() > 24:
        problem = "Use 24 characters or fewer"
        ret
    end
    repeat names.Len() in i:
        if names.Get(i) == clean:
            problem = "You already track that"
            ret
        end
    end
    names.Push(clean)
    marks.Push("0000000")
    draft = ""
    problem = ""
    save()
end

func remove_habit(h: int):
    names.RemoveAt(h)
    marks.RemoveAt(h)
    save()
end

pub component WeekGrid:
    if names.Len() == 0:
        paragraph:
            class = "empty"
            content = "No habits yet. Add one to start your streak."
        end
    else:
        table:
            width = 100%
            header:
                row:
                    column:
                        content = "Habit"
                    end
                    each i, d in DAYS:
                        column:
                            key = i
                            content = day_name(d)
                        end
                    end
                    column:
                        content = "Streak"
                    end
                end
            end
            main:
                each h, name in names:
                    row:
                        key = h
                        class = "habit"
                        column:
                            link:
                                to = "/habit/" + h
                                color = "#17251d"
                                content = name
                            end
                        end
                        each i, d in DAYS:
                            column:
                                key = i
                                DayCell:
                                    h = h
                                    d = d
                                end
                            end
                        end
                        column:
                            span:
                                class = "streak"
                                content = current_streak(h) + " day" + (current_streak(h) == 1 ? "" : "s")
                            end
                        end
                    end
                end
            end
        end
    end
end

page:
    title = "Habits"
    lang = "en"
    font = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = "#f3f7f4"
        color = "#17251d"
        Outlet: end
    end
end
