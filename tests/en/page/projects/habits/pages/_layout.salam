pub component Shell:
    header:
        layout = "row"
        align = "center"
        gap = 20
        padding = 14, 24
        background = "#1f6f4a"
        color = "#ffffff"
        span:
            font size = 20
            font weight = 800
            content = "Habits"
        end
        nav:
            layout = "row"
            gap = 6
            ShellLink:
                dest = ""
                label = "This week"
            end
            ShellLink:
                dest = "stats"
                label = "Stats"
            end
        end
    end
    box:
        max width = 760
        margin = 0, "auto"
        padding = 20, 16
        gap = 16
        Outlet: end
    end
end

component ShellLink(dest: str, label: str):
    link:
        to = "/" + dest
        padding = 6, 12
        radius = 8
        color = "#ffffff"
        decoration = "none"
        if page.route.path == "/" + dest:
            background = "#17543a"
        end
        content = label
    end
end
