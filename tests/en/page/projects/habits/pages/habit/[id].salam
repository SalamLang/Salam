pub component HabitPage(id: int):
    title = "Habit"
    box:
        gap = 12
        padding = 18
        radius = 14
        background = "#ffffff"
        if id < names.Len():
            heading:
                size = 1
                margin = 0
                content = names.Get(id)
            end
            paragraph:
                id = "best-streak"
                margin = 0
                content = "Best streak: " + best_streak(id)
            end
            paragraph:
                id = "week"
                margin = 0
                content = "Done " + week_total(id) + " of 7 days"
            end
            button:
                id = "remove"
                padding = 8, 14
                radius = 10
                border = 0
                background = "#fde7e4"
                color = "#b42318"
                cursor = "pointer"
                click = ():
                    remove_habit(id)
                    page.route.GoTo("/")
                end
                content = "Stop tracking"
            end
        else:
            heading:
                size = 1
                content = "No such habit"
            end
        end
        link:
            to = "/"
            content = "Back to the week"
        end
    end
end
