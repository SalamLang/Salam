pub component Stats:
    title = "Stats"
    heading:
        size = 1
        margin = 0
        content = "Stats"
    end
    paragraph:
        id = "total"
        margin = 0
        content = "Total check ins this week: " + grand_total()
    end
    if names.Len() > 0:
        paragraph:
            id = "best"
            margin = 0
            content = "Most consistent: " + names.Get(best_habit())
        end
        each h, name in names:
            Bar:
                label = name
                value = percent(h)
            end
        end
    else:
        paragraph:
            content = "Nothing to measure yet."
        end
    end
end
