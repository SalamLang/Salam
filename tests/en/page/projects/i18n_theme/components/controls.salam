pub component TopicChip(key: str):
    button:
        padding = 6, 14
        radius = 20
        border = 1, "solid", "#8886"
        background = transparent
        if topic == key:
            background = #4a7cff
            color = #ffffff
        end
        click = (): topic = key end
        content = tr(key)
    end
end

pub component ThemeOption(key: str):
    label:
        layout = "row"
        gap = 8
        input:
            id = "theme-" + key
            type = "radio"
            name = "theme"
            checked = (cur_theme() == key)
            change = (): set_theme(key) end
        end
        span:
            content = tr(key)
        end
    end
end

pub component LangSwitch:
    box:
        layout = "row"
        gap = 4
        button:
            id = "lang-en"
            padding = 4, 10
            radius = 8
            border = 1, "solid", "#8886"
            background = transparent
            if not is_fa():
                background = #4a7cff
                color = #ffffff
            end
            click = (): set_lang("en") end
            content = "EN"
        end
        button:
            id = "lang-fa"
            padding = 4, 10
            radius = 8
            border = 1, "solid", "#8886"
            background = transparent
            if is_fa():
                background = #4a7cff
                color = #ffffff
            end
            click = (): set_lang("fa") end
            content = "FA"
        end
    end
end
