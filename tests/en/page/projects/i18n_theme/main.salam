// EXPECT: <meta name="salam-router" content="history">
// EXPECT: localStorage
// EXPECT: Phrasebook
// EXPECT: prefers-color-scheme
import dom

mut fallback_lang := "en"
mut lang_code := dom.StoreGetStr("lang")
mut theme := dom.StoreGetStr("theme")
mut topic := "all"

func cur_theme(): str:
    if theme == "dark" or theme == "light":
        ret theme
    end
    ret "auto"
end

func cur_lang(): str:
    if lang_code == "":
        ret fallback_lang
    end
    ret lang_code == "fa" ? "fa" : "en"
end

func is_fa(): bool:
    ret cur_lang() == "fa"
end

func set_lang(code: str):
    lang_code = code
    dom.StoreSetStr("lang", code)
end

func set_theme(name: str):
    theme = name
    dom.StoreSetStr("theme", name)
end

func dark_now(): bool:
    ret theme == "dark"
end

func tr(key: str): str:
    if is_fa():
        if key == "title":
            ret "عبارت‌نامه"
        else key == "home":
            ret "عبارت‌ها"
        else key == "settings":
            ret "تنظیمات"
        else key == "about":
            ret "درباره"
        else key == "language":
            ret "زبان"
        else key == "theme":
            ret "پوسته"
        else key == "light":
            ret "روشن"
        else key == "dark":
            ret "تاریک"
        else key == "auto":
            ret "خودکار"
        else key == "all":
            ret "همه"
        else key == "greeting":
            ret "سلام"
        else key == "travel":
            ret "سفر"
        else key == "food":
            ret "غذا"
        else key == "saved":
            ret "ترجیح شما ذخیره شد"
        else key == "missing":
            ret "این عبارت پیدا نشد"
        end
    else:
        if key == "title":
            ret "Phrasebook"
        else key == "home":
            ret "Phrases"
        else key == "settings":
            ret "Settings"
        else key == "about":
            ret "About"
        else key == "language":
            ret "Language"
        else key == "theme":
            ret "Theme"
        else key == "light":
            ret "Light"
        else key == "dark":
            ret "Dark"
        else key == "auto":
            ret "Auto"
        else key == "all":
            ret "All"
        else key == "greeting":
            ret "Greeting"
        else key == "travel":
            ret "Travel"
        else key == "food":
            ret "Food"
        else key == "saved":
            ret "Your choice is saved"
        else key == "missing":
            ret "That phrase does not exist"
        end
    end
    ret key
end

func phrase_ids(): Vector<int>:
    mut v := Vector {} as Vector<int>
    v.Push(0)
    v.Push(1)
    v.Push(2)
    v.Push(3)
    v.Push(4)
    v.Push(5)
    ret v
end

func phrase_topic(num: int): str:
    if num < 2:
        ret "greeting"
    else num < 4:
        ret "travel"
    end
    ret "food"
end

func phrase_text(num: int): str:
    if is_fa():
        if num == 0:
            ret "صبح بخیر"
        else num == 1:
            ret "خوشحالم که می‌بینمت"
        else num == 2:
            ret "ایستگاه قطار کجاست؟"
        else num == 3:
            ret "یک بلیت لطفا"
        else num == 4:
            ret "یک چای می‌خواهم"
        else num == 5:
            ret "صورتحساب لطفا"
        end
    else:
        if num == 0:
            ret "Good morning"
        else num == 1:
            ret "Nice to meet you"
        else num == 2:
            ret "Where is the train station?"
        else num == 3:
            ret "One ticket, please"
        else num == 4:
            ret "I would like a tea"
        else num == 5:
            ret "The bill, please"
        end
    end
    ret ""
end

func phrase_other(num: int): str:
    if is_fa():
        if num == 0:
            ret "Good morning"
        else num == 1:
            ret "Nice to meet you"
        else num == 2:
            ret "Where is the train station?"
        else num == 3:
            ret "One ticket, please"
        else num == 4:
            ret "I would like a tea"
        else num == 5:
            ret "The bill, please"
        end
    else:
        if num == 0:
            ret "صبح بخیر"
        else num == 1:
            ret "خوشحالم که می‌بینمت"
        else num == 2:
            ret "ایستگاه قطار کجاست؟"
        else num == 3:
            ret "یک بلیت لطفا"
        else num == 4:
            ret "یک چای می‌خواهم"
        else num == 5:
            ret "صورتحساب لطفا"
        end
    end
    ret ""
end

func is_here(slug: str): bool:
    ret page.route.path == "/" + slug
end

func menu_label(slug: str): str:
    if slug == "settings":
        ret tr("settings")
    else slug == "about":
        ret tr("about")
    end
    ret tr("home")
end

pub component MenuLink(slug: str, caption: str, active: bool):
    taps := 0
    link:
        click = (): taps++ end
        if taps > 0 and not active:
            opacity = 0.85
        end
        to = "/" + slug
        padding = 6, 12
        radius = 8
        text decoration = none
        color = #3b5bdb
        hover:
            background = #8883
        end
        if active:
            background = #4a7cff33
            font weight = 700
        end
        content = caption
    end
end

pub component PhraseCard(num: int):
    taps := 0
    link:
        click = (): taps++ end
        to = "/phrase/" + num
        layout = column
        gap = 4
        padding = 14
        radius = 12
        text decoration = none
        border = 1, solid, #8883
        hover:
            background = #8881
        end
        span:
            font size = 18
            content = phrase_text(num)
        end
        small:
            opacity = 0.65
            content = tr(phrase_topic(num)) + (taps > 0 ? " " + taps : "")
        end
    end
end

page:
    title = "Phrasebook"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        dir = is_fa() ? "rtl" : "ltr"
        lang = cur_lang()
        min height = 100vh
        background = #fbfaf7
        color = #232323
        if cur_theme() == "dark":
            background = #16181d
            color = #ececec
        end
        if cur_theme() == "auto" and page.dark:
            background = #16181d
            color = #ececec
        end
        header:
            layout = row
            align = center
            gap = 16
            padding = 14, 24
            border bottom = 1, solid, #8884
            strong:
                font size = 20
                content = tr("title")
            end
            nav:
                layout = row
                gap = 8
                grow = 1
                each item in ["", "settings", "about"]:
                    MenuLink:
                        slug = item
                        caption = menu_label(item)
                        active = is_here(item)
                    end
                end
            end
            LangSwitch: end
        end
        main:
            max width = 760
            margin = 0, auto
            padding = 24
            Outlet: end
        end
    end
end
