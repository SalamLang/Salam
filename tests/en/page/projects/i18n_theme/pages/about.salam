pub component About:
    title = "About"
    box:
        gap = 12
        heading:
            size = 1
            content = tr("about")
        end
        paragraph:
            content = is_fa() ? "این برنامه با زبان سلام نوشته شده و زبان و پوسته را در مرورگر نگه می‌دارد." : "This app is written in Salam and keeps your language and theme in the browser."
        end
        paragraph:
            id = "dirnote"
            content = is_fa() ? "جهت صفحه: راست به چپ" : "Page direction: left to right"
        end
    end
end
