pub component Home:
    title = "Phrasebook"
    box:
        gap = 14
        heading:
            size = 1
            content = tr("home")
        end
        box:
            layout = "row"
            gap = 8
            wrap = true
            TopicChip:
                key = "all"
            end
            TopicChip:
                key = "greeting"
            end
            TopicChip:
                key = "travel"
            end
            TopicChip:
                key = "food"
            end
        end
        each i, num in phrase_ids():
            if topic == "all" or topic == phrase_topic(num):
                PhraseCard:
                    key = i
                    num = num
                end
            end
        end
    end
end
