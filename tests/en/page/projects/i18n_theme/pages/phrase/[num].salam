pub component Phrase(num: int):
    title = "Phrase"
    box:
        gap = 12
        if num >= 0 and num < 6:
            heading:
                size = 1
                content = phrase_text(num)
            end
            paragraph:
                dir = "auto"
                opacity = 0.7
                content = phrase_other(num)
            end
            button:
                id = "again"
                align self = "start"
                padding = 8, 14
                radius = 10
                click = (): page.route.Back() end
                content = tr("home")
            end
        else:
            paragraph:
                content = tr("missing")
            end
        end
    end
end
