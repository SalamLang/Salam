pub component Settings:
    title = "Settings"
    box:
        gap = 16
        heading:
            size = 1
            content = tr("settings")
        end
        field set:
            legend:
                content = tr("language")
            end
            label:
                layout = row
                gap = 8
                input:
                    id = "pick-en"
                    type = radio
                    name = "lang"
                    checked = (not is_fa())
                    change = (): set_lang("en") end
                end
                span:
                    content = "English"
                end
            end
            label:
                layout = row
                gap = 8
                input:
                    id = "pick-fa"
                    type = radio
                    name = "lang"
                    checked = is_fa()
                    change = (): set_lang("fa") end
                end
                span:
                    content = "فارسی"
                end
            end
        end
        field set:
            legend:
                content = tr("theme")
            end
            ThemeOption:
                key = "light"
            end
            ThemeOption:
                key = "dark"
            end
            ThemeOption:
                key = "auto"
            end
        end
        paragraph:
            id = "saved"
            opacity = 0.7
            content = tr("saved") + ": " + cur_lang() + " / " + cur_theme()
        end
    end
end
