component Figure(caption: str, amount: str, warn: bool):
    box:
        grow = 1
        basis = 0
        min width = 150
        padding = 14, 18
        radius = 12
        background = #ffffff
        border = 1, solid, #e8dfcc
        if warn:
            background = #fff1e0
        end
        paragraph:
            margin = 0
            font size = 12
            color = #7a6e58
            content = caption
        end
        paragraph:
            margin = 0
            font size = 24
            font weight = 800
            content = amount
        end
    end
end

pub component Totals:
    box:
        layout = row
        wrap = true
        gap = 12
        Figure:
            caption = "Products"
            amount = "" + products.Len()
            warn = false
        end
        Figure:
            caption = "Units in stock"
            amount = "" + units()
            warn = false
        end
        Figure:
            caption = "Stock amount"
            amount = money(stock_value())
            warn = false
        end
        Figure:
            caption = "Low stock"
            amount = "" + low_count()
            warn = (low_count() > 0)
        end
    end
end
