// EXPECT: var __salam_rt_hash = true
// EXPECT: function __salam_route_pick(
// EXPECT: Stockroom
import dom

mut products := seed_products()
mut next_id := 7
mut search := ""
mut flash := ""

struct Product:
    pub id: int
    pub name: str
    pub sku: str
    pub qty: int
    pub low: int
    pub cents: int
end

func make(id: int, name: str, sku: str, qty: int, low: int, cents: int): Product:
    ret Product {id = id, name = name, sku = sku, qty = qty, low = low, cents = cents}
end

func seed_products(): Vector<Product>:
    mut v := Vector {} as Vector<Product>
    v.Push(make(1, "Espresso beans 1kg", "COF-001", 24, 10, 1850))
    v.Push(make(2, "Paper filters", "COF-014", 6, 12, 399))
    v.Push(make(3, "Ceramic mug", "MUG-210", 48, 15, 725))
    v.Push(make(4, "Milk frother", "EQP-032", 3, 5, 2990))
    v.Push(make(5, "Gift card 25", "GFT-025", 100, 20, 2500))
    v.Push(make(6, "Travel tumbler", "MUG-305", 14, 10, 1950))
    ret v
end

func index_of(id: int): int:
    repeat products.Len() in i:
        if products[i].id == id:
            ret i
        end
    end
    ret 0 - 1
end

func is_low(p: Product): bool:
    ret p.qty <= p.low
end

func low_count(): int:
    mut c := 0
    repeat products.Len() in i:
        if is_low(products[i]):
            c++
        end
    end
    ret c
end

func units(): int:
    mut t := 0
    repeat products.Len() in i:
        t += products[i].qty
    end
    ret t
end

func stock_value(): int:
    mut t := 0
    repeat products.Len() in i:
        t += products[i].qty * products[i].cents
    end
    ret t
end

func money(cents: int): str:
    c := cents % 100
    ret "$" + (cents / 100) + "." + (c < 10 ? "0" : "") + c
end

func is_number(s: str): bool:
    if s.Len() == 0:
        ret false
    end
    repeat s.Len() in i:
        ch := s.Substr(i, 1)
        if ch < "0" or ch > "9":
            ret false
        end
    end
    ret true
end

func matches(p: Product): bool:
    q := search.Trim().Lower()
    if q.Len() == 0:
        ret true
    end
    ret p.name.Lower().Includes(q) or p.sku.Lower().Includes(q)
end

func shown_count(): int:
    mut c := 0
    repeat products.Len() in i:
        if matches(products[i]):
            c++
        end
    end
    ret c
end

func create_product(name: str, sku: str, qty: str, low: str, price: str):
    ok := name.Trim().Len() > 0 and sku.Trim().Len() >= 3 and is_number(qty) and is_number(low) and is_number(price) and price.ToInt() > 0
    if not ok:
        ret
    end
    products.Push(make(next_id, name.Trim(), sku.Trim().Upper(), qty.ToInt(), low.ToInt(), price.ToInt() * 100))
    next_id++
    flash = "Added " + name.Trim()
    page.route.GoTo("/")
end

func set_number(at: int, field: str, v: str):
    if not is_number(v):
        ret
    end
    if field == "qty":
        products[at].qty = v.ToInt()
    else field == "low":
        products[at].low = v.ToInt()
    else:
        products[at].cents = v.ToInt() * 100
    end
    flash = ""
end

func remove_product(id: int):
    at := index_of(id)
    if at < 0:
        ret
    end
    mut keep := Vector {} as Vector<Product>
    repeat products.Len() in i:
        if i != at:
            keep.Push(products[i])
        end
    end
    flash = "Deleted " + products[at].name
    products = keep
end

func adjust(id: int, delta: int):
    at := index_of(id)
    if at >= 0 and products[at].qty + delta >= 0:
        products[at].qty += delta
    end
end

component Tab(path: str, caption: str):
    link:
        to = path
        padding = 8, 14
        radius = 999
        text decoration = none
        color = #3a3226
        content = caption
    end
end

pub component ProductRow(at: int):
    item:
        key = products[at].id
        layout = row
        align = center
        gap = 12
        padding = 12, 16
        radius = 12
        background = #ffffff
        border = 1, solid, #e8dfcc
        if is_low(products[at]):
            background = #fff1e0
            border = 1, solid, #f0b765
        end
        box:
            grow = 1
            gap = 2
            link:
                to = "/edit/" + products[at].id
                font weight = 700
                color = #2c261c
                text decoration = none
                content = products[at].name
            end
            span:
                font size = 12
                color = #7a6e58
                content = products[at].sku + " , " + money(products[at].cents)
            end
        end
        box:
            layout = row
            align = center
            gap = 6
            button:
                class = "minus"
                padding = 4, 10
                radius = 8
                border = 1, solid, #d9cdb3
                background = #ffffff
                click = ():
                    adjust(products[at].id, 0 - 1)
                end
                content = "-"
            end
            strong:
                class = "qty"
                min width = 36
                text align = center
                content = "" + products[at].qty
            end
            button:
                class = "plus"
                padding = 4, 10
                radius = 8
                border = 1, solid, #d9cdb3
                background = #ffffff
                click = ():
                    adjust(products[at].id, 1)
                end
                content = "+"
            end
        end
        if is_low(products[at]):
            span:
                class = "low"
                padding = 2, 10
                radius = 999
                font size = 12
                font weight = 700
                background = #f0b765
                color = #4a2c00
                content = "Low stock"
            end
        end
        button:
            class = "delete"
            padding = 6, 12
            radius = 8
            border = 0
            background = #f6dcd8
            color = #8a1c12
            click = ():
                remove_product(products[at].id)
            end
            content = "Delete"
        end
    end
end

func seq(n: int): Vector<int>:
    mut v := Vector {} as Vector<int>
    repeat n in i:
        v.Push(i)
    end
    ret v
end

pub component FormRow(caption: str, field: str, note: str):
    box:
        gap = 4
        label:
            for = field
            font weight = 600
            content = caption
        end
        content: end
        paragraph:
            id = field + "-note"
            margin = 0
            min height = 18
            font size = 13
            color = #b3261e
            content = note
        end
    end
end

pub component ProductForm:
    name := ""
    sku := ""
    qty := ""
    low := "5"
    price := ""
    tried := false
    form:
        id = "new-form"
        max width = 520
        padding = 24
        gap = 8
        radius = 16
        background = #ffffff
        border = 1, solid, #e8dfcc
        submit = (e: i64):
            dom.PreventDefault(e)
            tried = true
            create_product(name, sku, qty, low, price)
        end
        FormRow:
            caption = "Name"
            field = "new-name"
            note = (tried and name.Trim().Len() == 0) ? "Give the product a name." : ""
            input:
                id = "new-name"
                padding = 10, 12
                radius = 10
                border = 1, solid, #d9cdb3
                bind = name
            end
        end
        FormRow:
            caption = "SKU"
            field = "new-sku"
            note = (tried and sku.Trim().Len() < 3) ? "At least three characters." : ""
            input:
                id = "new-sku"
                padding = 10, 12
                radius = 10
                border = 1, solid, #d9cdb3
                bind = sku
            end
        end
        FormRow:
            caption = "Quantity"
            field = "new-qty"
            note = (tried and not is_number(qty)) ? "Whole number, zero or more." : ""
            input:
                id = "new-qty"
                padding = 10, 12
                radius = 10
                border = 1, solid, #d9cdb3
                bind = qty
            end
        end
        FormRow:
            caption = "Low stock at"
            field = "new-low"
            note = (tried and not is_number(low)) ? "Whole number, zero or more." : ""
            input:
                id = "new-low"
                padding = 10, 12
                radius = 10
                border = 1, solid, #d9cdb3
                bind = low
            end
        end
        FormRow:
            caption = "Price in dollars"
            field = "new-price"
            note = (tried and (not is_number(price) or price.ToInt() == 0)) ? "A whole number above zero." : ""
            input:
                id = "new-price"
                padding = 10, 12
                radius = 10
                border = 1, solid, #d9cdb3
                bind = price
            end
        end
        button:
            id = "new-save"
            type = submit
            margin = 8, 0, 0, 0
            padding = 12
            radius = 10
            border = 0
            background = #3a3226
            color = #fffaf0
            font weight = 700
            content = "Add product"
        end
    end
end

page:
    mode = hash
    title = "Stockroom"
    lang = "en"
    style:
        content = "nav a[aria-current=page] { background: #3a3226; color: #fffaf0; }"
    end
    font family = "system-ui, sans-serif"
    background = #faf6ee
    color = #2c261c
    header:
        layout = row
        align = center
        justify = between
        padding = 16, 32
        border bottom = 1, solid, #e8dfcc
        link:
            to = "/"
            font size = 20
            font weight = 800
            color = #2c261c
            text decoration = none
            content = "Stockroom"
        end
        nav:
            layout = row
            gap = 6
            Tab:
                path = "/"
                caption = "Products"
            end
            Tab:
                path = "/new"
                caption = "Add product"
            end
        end
    end
    main:
        padding = 28, 32
        max width = 980
        margin = 0, auto
        Outlet: end
    end
end
