component EditPanel(id: int):
    box:
        gap = 14
        if index_of(id) < 0:
            heading:
                size = 1
                content = "No such product"
            end
            link:
                to = "/"
                content = "Back to products"
            end
        else:
            heading:
                size = 1
                margin = 0
                content = "Edit " + products[index_of(id)].name
            end
            box:
                max width = 520
                padding = 24
                gap = 8
                radius = 16
                background = "#ffffff"
                border = 1, "solid", "#e8dfcc"
                FormRow:
                    caption = "Name"
                    field = "edit-name"
                    note = (products[index_of(id)].name.Trim().Len() == 0) ? "Give the product a name." : ""
                    input:
                        id = "edit-name"
                        padding = 10, 12
                        radius = 10
                        border = 1, "solid", "#d9cdb3"
                        bind = products[index_of(id)].name
                    end
                end
                FormRow:
                    caption = "SKU"
                    field = "edit-sku"
                    note = (products[index_of(id)].sku.Trim().Len() < 3) ? "At least three characters." : ""
                    input:
                        id = "edit-sku"
                        padding = 10, 12
                        radius = 10
                        border = 1, "solid", "#d9cdb3"
                        bind = products[index_of(id)].sku
                    end
                end
                FormRow:
                    caption = "Quantity"
                    field = "edit-qty"
                    note = ""
                    input:
                        id = "edit-qty"
                        padding = 10, 12
                        radius = 10
                        border = 1, "solid", "#d9cdb3"
                        value = "" + products[index_of(id)].qty
                        input = (v: str):
                            set_number(index_of(id), "qty", v)
                        end
                    end
                end
                FormRow:
                    caption = "Low stock at"
                    field = "edit-low"
                    note = ""
                    input:
                        id = "edit-low"
                        padding = 10, 12
                        radius = 10
                        border = 1, "solid", "#d9cdb3"
                        value = "" + products[index_of(id)].low
                        input = (v: str):
                            set_number(index_of(id), "low", v)
                        end
                    end
                end
                FormRow:
                    caption = "Price in dollars"
                    field = "edit-price"
                    note = ""
                    input:
                        id = "edit-price"
                        padding = 10, 12
                        radius = 10
                        border = 1, "solid", "#d9cdb3"
                        value = "" + (products[index_of(id)].cents / 100)
                        input = (v: str):
                            set_number(index_of(id), "price", v)
                        end
                    end
                end
                link:
                    id = "edit-done"
                    to = "/"
                    margin = 8, 0, 0, 0
                    padding = 12
                    radius = 10
                    background = "#3a3226"
                    color = "#fffaf0"
                    decoration = "none"
                    text align = "center"
                    font weight = 700
                    content = "Done"
                end
            end
        end
    end
end

pub component EditProduct(id: int):
    title = "Edit product"
    EditPanel:
        id = id
    end
end
