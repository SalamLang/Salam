pub component Products:
    title = "Products"
    box:
        gap = 16
        Totals: end
        if flash.Len() > 0:
            paragraph:
                id = "flash"
                margin = 0
                padding = 10, 14
                radius = 10
                background = #e7f3e4
                color = #1f5a1a
                content = flash
            end
        end
        input:
            id = "search"
            type = search
            padding = 10, 14
            radius = 10
            border = 1, solid, #d9cdb3
            placeholder = "Search by name or SKU"
            bind = search
        end
        list:
            id = "products"
            gap = 8
            padding = 0
            each at in seq(products.Len()):
                if matches(products[at]):
                    ProductRow:
                        at = at
                    end
                end
            end
        end
        if shown_count() == 0:
            paragraph:
                id = "none"
                color = #7a6e58
                content = "No products match."
            end
        end
    end
end
