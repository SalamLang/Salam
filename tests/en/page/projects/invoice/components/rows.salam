pub component ReadRow(at: int):
    row:
        column:
            padding = 10, 8
            content = items[at].desc
        end
        column:
            padding = 10, 8
            text align = "right"
            content = "" + items[at].qty
        end
        column:
            padding = 10, 8
            text align = "right"
            content = money(items[at].cents)
        end
        column:
            padding = 10, 8
            text align = "right"
            font weight = 600
            content = money(items[at].qty * items[at].cents)
        end
    end
end

pub component EditRow(at: int):
    row:
        column:
            padding = 10, 8
            content = items[at].desc
        end
        column:
            padding = 10, 8
            text align = "right"
            content = "" + items[at].qty
        end
        column:
            padding = 10, 8
            text align = "right"
            content = money(items[at].cents)
        end
        column:
            padding = 10, 8
            text align = "right"
            font weight = 600
            content = money(items[at].qty * items[at].cents)
        end
        column:
            padding = 10, 8
            button:
                class = "remove"
                border = 0
                padding = 4, 10
                radius = 6
                background = "#f6dcd8"
                color = "#8a1c12"
                click = ():
                    remove_line(at)
                end
                content = "Remove"
            end
        end
    end
end
