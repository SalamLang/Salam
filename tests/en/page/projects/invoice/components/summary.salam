component SumRow(caption: str, amount: str, strong_row: bool):
    box:
        layout = row
        justify = between
        padding = 6, 0
        if strong_row:
            font weight = 800
            font size = 18
            border top = 2, solid, #17212b
            margin = 6, 0, 0, 0
        end
        span:
            content = caption
        end
        span:
            class = "amount"
            content = amount
        end
    end
end

pub component Summary(sid: str):
    box:
        id = sid
        margin = 0, 0, 0, auto
        min width = 280
        SumRow:
            caption = "Subtotal"
            amount = money(subtotal())
            strong_row = false
        end
        if discount > 0:
            SumRow:
                caption = "Discount (" + discount + "%)"
                amount = "-" + money(discount_amount())
                strong_row = false
            end
        end
        SumRow:
            caption = "Tax (" + tax + "%)"
            amount = money(tax_amount())
            strong_row = false
        end
        SumRow:
            caption = "Total due"
            amount = money(total())
            strong_row = true
        end
    end
end
