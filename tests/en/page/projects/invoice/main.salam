// EXPECT: var __salam_rt_hash = true
// EXPECT: function __salam_route_pick(
// EXPECT: Invoice generator
import dom

mut client := "Northwind Traders"
mut number := "2026-014"
mut issued := "2026-11-23"
mut tax := 8
mut discount := 0
mut draft_desc := ""
mut draft_qty := "1"
mut draft_price := ""
mut add_error := ""
mut items := seed_items()

struct Entry:
    pub desc: str
    pub qty: int
    pub cents: int
end

func seed_items(): Vector<Entry>:
    mut v := Vector {} as Vector<Entry>
    v.Push(Entry {desc = "Website redesign", qty = 1, cents = 240000})
    v.Push(Entry {desc = "Hosting, 12 months", qty = 12, cents = 1500})
    v.Push(Entry {desc = "Extra page", qty = 3, cents = 9000})
    ret v
end

func group(n: int): str:
    s := "" + n
    mut out := ""
    repeat s.Len() in i:
        rest := s.Len() - i
        if i > 0 and rest % 3 == 0:
            out += ","
        end
        out += s.Substr(i, 1)
    end
    ret out
end

func money(cents: int): str:
    c := cents % 100
    ret "$" + group(cents / 100) + "." + (c < 10 ? "0" : "") + c
end

func subtotal(): int:
    mut t := 0
    repeat items.Len() in i:
        t += items[i].qty * items[i].cents
    end
    ret t
end

func discount_amount(): int:
    ret subtotal() * discount / 100
end

func taxable(): int:
    ret subtotal() - discount_amount()
end

func tax_amount(): int:
    ret taxable() * tax / 100
end

func total(): int:
    ret taxable() + tax_amount()
end

func clamp_pct(v: str): int:
    n := v.ToInt()
    if n < 0:
        ret 0
    end
    if n > 100:
        ret 100
    end
    ret n
end

func is_number(s: str): bool:
    if s.Len() == 0:
        ret false
    end
    repeat s.Len() in i:
        ch := s.Substr(i, 1)
        if ch < "0" or ch > "9":
            ret false
        end
    end
    ret true
end

func add_line():
    if draft_desc.Trim().Len() == 0:
        add_error = "Describe the work."
        ret
    end
    if not is_number(draft_qty) or draft_qty.ToInt() == 0:
        add_error = "Quantity must be a whole number above zero."
        ret
    end
    if not is_number(draft_price) or draft_price.ToInt() == 0:
        add_error = "Price must be a whole number of dollars above zero."
        ret
    end
    items.Push(Entry {desc = draft_desc.Trim(), qty = draft_qty.ToInt(), cents = draft_price.ToInt() * 100})
    draft_desc = ""
    draft_qty = "1"
    draft_price = ""
    add_error = ""
end

func remove_line(at: int):
    mut keep := Vector {} as Vector<Entry>
    repeat items.Len() in i:
        if i != at:
            keep.Push(items[i])
        end
    end
    items = keep
end

func date_text(iso: str): str:
    parts := iso.Split("-")
    if parts.Len() != 3:
        ret iso
    end
    names := ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    m := parts[1].ToInt()
    if m < 1 or m > 12:
        ret iso
    end
    ret "" + parts[2].ToInt() + " " + names[m] + " " + parts[0]
end

func print_now():
    dom.Call0(dom.Window(), "print")
end

func seq(n: int): Vector<int>:
    mut v := Vector {} as Vector<int>
    repeat n in i:
        v.Push(i)
    end
    ret v
end

component Tab(path: str, caption: str):
    link:
        to = path
        padding = 8, 14
        radius = 8
        decoration = "none"
        color = "#23405c"
        content = caption
    end
end

page:
    mode = "hash"
    title = "Invoice generator"
    lang = "en"
    style:
        content = "nav a[aria-current=page] { background: #23405c; color: #ffffff; }"
    end
    font = "system-ui, sans-serif"
    background = "#eef3f8"
    color = "#17212b"
    header:
        layout = "row"
        align = "center"
        justify = "between"
        padding = 14, 32
        background = "#ffffff"
        border bottom = 1, "solid", "#d6e0ea"
        media:
            condition = "print"
            visible = false
        end
        strong:
            content = "Invoice generator"
        end
        nav:
            layout = "row"
            gap = 6
            Tab:
                path = "/"
                caption = "Edit"
            end
            Tab:
                path = "/invoice"
                caption = "Preview"
            end
        end
    end
    main:
        padding = 26, 32
        max width = 900
        margin = 0, "auto"
        Outlet: end
    end
end
