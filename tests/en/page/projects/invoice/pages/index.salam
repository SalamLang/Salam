pub component Editor:
    title = "Edit invoice"
    box:
        gap = 18
        heading:
            size = 1
            margin = 0
            content = "New invoice"
        end
        box:
            layout = "grid"
            columns = repeat (fit, minmax(200px, 1fr))
            gap = 12
            box:
                gap = 4
                label:
                    for = "client"
                    font weight = 600
                    content = "Client"
                end
                input:
                    id = "client"
                    padding = 10, 12
                    radius = 8
                    border = 1, "solid", "#c3d0de"
                    bind = client
                end
            end
            box:
                gap = 4
                label:
                    for = "number"
                    font weight = 600
                    content = "Invoice number"
                end
                input:
                    id = "number"
                    padding = 10, 12
                    radius = 8
                    border = 1, "solid", "#c3d0de"
                    bind = number
                end
            end
            box:
                gap = 4
                label:
                    for = "issued"
                    font weight = 600
                    content = "Issue date"
                end
                input:
                    id = "issued"
                    type = "date"
                    padding = 10, 12
                    radius = 8
                    border = 1, "solid", "#c3d0de"
                    value = issued
                    input = (v: str):
                        issued = v
                    end
                end
            end
        end
        box:
            overflow = "auto"
            radius = 12
            background = "#ffffff"
            border = 1, "solid", "#d6e0ea"
            table:
                width = 100%
                header:
                    row:
                        column:
                            heading = true
                            padding = 10, 8
                            text align = "left"
                            content = "Description"
                        end
                        column:
                            heading = true
                            padding = 10, 8
                            text align = "right"
                            content = "Qty"
                        end
                        column:
                            heading = true
                            padding = 10, 8
                            text align = "right"
                            content = "Price"
                        end
                        column:
                            heading = true
                            padding = 10, 8
                            text align = "right"
                            content = "Amount"
                        end
                        column:
                            heading = true
                            padding = 10, 8
                            content = ""
                        end
                    end
                end
                main:
                    each _, at in seq(items.Len()):
                        EditRow:
                            at = at
                        end
                    end
                end
            end
        end
        form:
            id = "add-form"
            layout = "row"
            wrap = true
            gap = 8
            align = "end"
            submit = (e: i64):
                dom.PreventDefault(e)
                add_line()
            end
            input:
                id = "desc"
                grow = 3
                basis = 0
                min width = 180
                padding = 10, 12
                radius = 8
                border = 1, "solid", "#c3d0de"
                placeholder = "Description"
                bind = draft_desc
            end
            input:
                id = "qty"
                grow = 1
                basis = 0
                min width = 70
                padding = 10, 12
                radius = 8
                border = 1, "solid", "#c3d0de"
                placeholder = "Qty"
                bind = draft_qty
            end
            input:
                id = "price"
                grow = 1
                basis = 0
                min width = 90
                padding = 10, 12
                radius = 8
                border = 1, "solid", "#c3d0de"
                placeholder = "Price in dollars"
                bind = draft_price
            end
            button:
                id = "add"
                type = "submit"
                padding = 10, 18
                radius = 8
                border = 0
                background = "#23405c"
                color = "#ffffff"
                font weight = 700
                content = "Add line"
            end
        end
        paragraph:
            id = "add-error"
            margin = 0
            min height = 18
            color = "#b3261e"
            content = add_error
        end
        box:
            layout = "row"
            gap = 16
            wrap = true
            align = "end"
            box:
                gap = 4
                label:
                    for = "tax"
                    font weight = 600
                    content = "Tax %"
                end
                input:
                    id = "tax"
                    width = 90
                    padding = 10, 12
                    radius = 8
                    border = 1, "solid", "#c3d0de"
                    value = "" + tax
                    input = (v: str):
                        tax = clamp_pct(v)
                    end
                end
            end
            box:
                gap = 4
                label:
                    for = "discount"
                    font weight = 600
                    content = "Discount %"
                end
                input:
                    id = "discount"
                    width = 90
                    padding = 10, 12
                    radius = 8
                    border = 1, "solid", "#c3d0de"
                    value = "" + discount
                    input = (v: str):
                        discount = clamp_pct(v)
                    end
                end
            end
            Summary:
                sid = "summary"
            end
        end
        link:
            id = "preview"
            to = "/invoice"
            padding = 12, 18
            radius = 10
            background = "#23405c"
            color = "#ffffff"
            decoration = "none"
            text align = "center"
            font weight = 700
            content = "Preview the invoice"
        end
    end
end
