pub component Printable:
    title = "Invoice " + number
    box:
        gap = 18
        box:
            layout = "row"
            gap = 10
            media:
                condition = "print"
                display = "none"
            end
            button:
                id = "print"
                padding = 10, 18
                radius = 8
                border = 0
                background = "#23405c"
                color = "#ffffff"
                font weight = 700
                click = print_now
                content = "Print"
            end
            link:
                to = "/"
                padding = 10, 14
                color = "#23405c"
                content = "Back to editing"
            end
        end
        article:
            id = "sheet"
            padding = 40
            gap = 24
            radius = 8
            background = "#ffffff"
            border = 1, solid, #d6e0ea
            box:
                layout = "row"
                justify = "between"
                align = "start"
                box:
                    heading:
                        size = 1
                        margin = 0
                        content = "INVOICE"
                    end
                    paragraph:
                        id = "inv-number"
                        margin = 4, 0, 0, 0
                        color = "#52627a"
                        content = "No. " + number
                    end
                end
                box:
                    text align = "right"
                    paragraph:
                        margin = 0
                        font weight = 700
                        content = "Salam Studio"
                    end
                    paragraph:
                        id = "inv-date"
                        margin = 4, 0, 0, 0
                        color = "#52627a"
                        content = "Issued " + date_text(issued)
                    end
                end
            end
            box:
                paragraph:
                    margin = 0
                    font size = 13
                    color = "#52627a"
                    content = "Billed to"
                end
                paragraph:
                    id = "inv-client"
                    margin = 0
                    font size = 18
                    font weight = 700
                    content = client
                end
            end
            table:
                width = 100%
                header:
                    row:
                        column:
                            heading = true
                            padding = 10, 8
                            text align = "left"
                            content = "Description"
                        end
                        column:
                            heading = true
                            padding = 10, 8
                            text align = "right"
                            content = "Qty"
                        end
                        column:
                            heading = true
                            padding = 10, 8
                            text align = "right"
                            content = "Price"
                        end
                        column:
                            heading = true
                            padding = 10, 8
                            text align = "right"
                            content = "Amount"
                        end
                    end
                end
                main:
                    each at in seq(items.Len()):
                        ReadRow:
                            at = at
                        end
                    end
                end
            end
            Summary:
                sid = "sheet-summary"
            end
        end
    end
end
