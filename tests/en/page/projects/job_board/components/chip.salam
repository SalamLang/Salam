pub component Chip(code: str):
    button:
        class = "chip"
        padding = 7, 14
        radius = 999
        cursor = "pointer"
        border = 1, solid, #bcd3c5
        background = #ffffff
        color = #1c3d2e
        if kind_filter == code:
            background = #1c3d2e
            color = #ffffff
        end
        click = ():
            kind_filter = code
        end
        content = kind_name(code)
    end
end

pub component MinChip(amount: int, caption: str):
    button:
        class = "minchip"
        padding = 7, 14
        radius = 999
        cursor = "pointer"
        border = 1, solid, #bcd3c5
        background = #ffffff
        color = #1c3d2e
        if min_salary == amount:
            background = #1c3d2e
            color = #ffffff
        end
        click = ():
            min_salary = amount
        end
        content = caption
    end
end
