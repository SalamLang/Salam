pub component SaveButton(id: int):
    button:
        class = "save"
        padding = 7, 12
        radius = 8
        cursor = "pointer"
        border = 1, "solid", "#bcd3c5"
        background = #ffffff
        color = #1c3d2e
        if is_saved(id):
            background = #1c3d2e
            color = #ffffff
        end
        click = ():
            toggle_saved(id)
        end
        content = is_saved(id) ? "Saved" : "Save"
    end
end
