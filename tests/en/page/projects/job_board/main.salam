// EXPECT: var __salam_rt_hash = true
// EXPECT: function __salam_route_pick(
// EXPECT: Hire Bridge
mut jobs := seed_jobs()
mut saved := Vector {} as Vector<int>
mut applied := Vector {} as Vector<int>
mut query := ""
mut kind_filter := "any"
mut min_salary := 0
mut newest_first := true

struct Job:
    pub id: int
    pub position: str
    pub company: str
    pub city: str
    pub kind: str
    pub salary: int
    pub posted: int
    pub about: str
end

func job(id: int, position: str, company: str, city: str, kind: str, salary: int, posted: int, about: str): Job:
    ret Job {id = id, position = position, company = company, city = city, kind = kind, salary = salary, posted = posted, about = about}
end

func seed_jobs(): Vector<Job>:
    mut v := Vector {} as Vector<Job>
    v.Push(job(1, "Frontend developer", "Lumen Labs", "Berlin", "full", 72, 2, "Build the dashboards our customers use every day."))
    v.Push(job(2, "Product designer", "Paperplane", "Remote", "remote", 65, 5, "Own the design system and ship small, careful changes."))
    v.Push(job(3, "Support specialist", "Harbor Cloud", "Lisbon", "part", 28, 1, "Answer customers, write help articles, escalate bugs."))
    v.Push(job(4, "Backend engineer", "Lumen Labs", "Berlin", "full", 85, 8, "Design APIs and keep the data pipeline healthy."))
    v.Push(job(5, "Data analyst", "Quill", "Remote", "remote", 58, 3, "Turn product events into questions worth asking."))
    v.Push(job(6, "Office manager", "Paperplane", "Hamburg", "part", 30, 12, "Keep the office running and the coffee stocked."))
    v.Push(job(7, "DevOps engineer", "Harbor Cloud", "Remote", "remote", 90, 4, "Automate deploys and keep latency flat."))
    ret v
end

func index_of(id: int): int:
    repeat jobs.Len() in i:
        if jobs[i].id == id:
            ret i
        end
    end
    ret 0 - 1
end

func is_saved(id: int): bool:
    repeat saved.Len() in i:
        if saved[i] == id:
            ret true
        end
    end
    ret false
end

func is_applied(id: int): bool:
    repeat applied.Len() in i:
        if applied[i] == id:
            ret true
        end
    end
    ret false
end

func toggle_saved(id: int):
    if is_saved(id):
        mut keep := Vector {} as Vector<int>
        repeat saved.Len() in i:
            if saved[i] != id:
                keep.Push(saved[i])
            end
        end
        saved = keep
    else:
        saved.Push(id)
    end
end

func apply_to(id: int):
    if not is_applied(id):
        applied.Push(id)
    end
end

func shows(j: Job): bool:
    if kind_filter != "any" and j.kind != kind_filter:
        ret false
    end
    if j.salary < min_salary:
        ret false
    end
    q := query.Trim().Lower()
    if q.Len() == 0:
        ret true
    end
    ret j.position.Lower().Includes(q) or j.company.Lower().Includes(q) or j.city.Lower().Includes(q)
end

func matching(): Vector<int>:
    mut ids := Vector {} as Vector<int>
    repeat jobs.Len() in i:
        if shows(jobs[i]):
            ids.Push(i)
        end
    end
    n := ids.Len()
    repeat n in a:
        mut best := a
        repeat n - a in k:
            b := a + k
            before := newest_first ? jobs[ids[b]].posted < jobs[ids[best]].posted : jobs[ids[b]].salary > jobs[ids[best]].salary
            if before:
                best = b
            end
        end
        if best != a:
            t := ids[a]
            ids[a] = ids[best]
            ids[best] = t
        end
    end
    ret ids
end

pure func kind_name(k: str): str:
    if k == "full":
        ret "Full time"
    else k == "part":
        ret "Part time"
    else k == "remote":
        ret "Remote"
    end
    ret "Any"
end

pure func age_text(days: int): str:
    if days == 1:
        ret "1 day ago"
    end
    ret days + " days ago"
end

func saved_jobs(): Vector<int>:
    mut ids := Vector {} as Vector<int>
    repeat jobs.Len() in i:
        if is_saved(jobs[i].id):
            ids.Push(i)
        end
    end
    ret ids
end

component Tab(path: str, caption: str):
    link:
        to = "" + path
        padding = 8, 14
        radius = 999
        text decoration = none
        color = #1c3d2e
        content = caption
    end
end

pub component JobCard(at: int):
    item:
        key = jobs[at].id
        layout = row
        align = center
        gap = 14
        padding = 16, 18
        radius = 14
        background = #ffffff
        border = 1, solid, #dbe8e0
        box:
            grow = 1
            gap = 3
            link:
                class = "job-title"
                to = "/job/" + jobs[at].id
                font size = 17
                font weight = 700
                color = #15261d
                text decoration = none
                content = jobs[at].position
            end
            span:
                color = #4d6657
                content = jobs[at].company + " , " + jobs[at].city
            end
            span:
                font size = 13
                color = #6f8678
                content = kind_name(jobs[at].kind) + " , " + age_text(jobs[at].posted)
            end
        end
        strong:
            class = "salary"
            color = #1c3d2e
            content = "$" + jobs[at].salary + "k"
        end
        SaveButton:
            id = jobs[at].id
        end
    end
end

page:
    mode = hash
    title = "Hire Bridge"
    lang = "en"
    style:
        content = "nav a[aria-current=page] { background: #1c3d2e; color: #ffffff; }"
    end
    font family = "system-ui, sans-serif"
    background = #f4f8f5
    color = #15261d
    header:
        layout = row
        align = center
        justify = between
        padding = 16, 32
        background = #ffffff
        border bottom = 1, solid, #dbe8e0
        link:
            to = "/"
            font size = 20
            font weight = 800
            color = #1c3d2e
            text decoration = none
            content = "Hire Bridge"
        end
        nav:
            layout = row
            gap = 6
            Tab:
                path = "/"
                caption = "Jobs"
            end
            Tab:
                path = "/saved"
                caption = "Saved (" + saved.Len() + ")"
            end
        end
    end
    main:
        padding = 26, 32
        max width = 860
        margin = 0, auto
        Outlet: end
    end
end
