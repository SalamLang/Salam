pub component Jobs:
    title = "Jobs"
    box:
        gap = 14
        input:
            id = "search"
            type = "search"
            padding = 12, 16
            radius = 12
            border = 1, "solid", "#bcd3c5"
            placeholder = "Search title, company or city"
            bind = query
        end
        box:
            layout = "row"
            wrap = true
            gap = 8
            align = "center"
            Chip:
                code = "any"
            end
            Chip:
                code = "full"
            end
            Chip:
                code = "part"
            end
            Chip:
                code = "remote"
            end
            MinChip:
                amount = 0
                caption = "Any pay"
            end
            MinChip:
                amount = 50
                caption = "$50k+"
            end
            MinChip:
                amount = 70
                caption = "$70k+"
            end
            button:
                id = "order"
                padding = 7, 12
                radius = 8
                cursor = "pointer"
                border = 1, "solid", "#bcd3c5"
                background = "#ffffff"
                click = ():
                    newest_first = not newest_first
                end
                content = newest_first ? "Newest first" : "Highest pay first"
            end
        end
        paragraph:
            id = "count"
            margin = 0
            color = "#4d6657"
            content = matching().Len() + " of " + jobs.Len() + " jobs"
        end
        list:
            id = "jobs"
            gap = 10
            padding = 0
            each _, at in matching():
                JobCard:
                    key = jobs[at].id
                    at = at
                end
            end
        end
        if matching().Len() == 0:
            paragraph:
                id = "none"
                color = "#4d6657"
                content = "No jobs match. Try another filter."
            end
        end
    end
end
