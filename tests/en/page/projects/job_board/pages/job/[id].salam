component JobPanel(id: int):
    box:
        gap = 14
        max width = 640
        link:
            to = "/"
            color = #1c3d2e
            content = "All jobs"
        end
        if index_of(id) < 0:
            heading:
                size = 1
                content = "No such job"
            end
        else:
            heading:
                size = 1
                margin = 0
                content = jobs[index_of(id)].position
            end
            paragraph:
                id = "meta"
                margin = 0
                color = #4d6657
                content = jobs[index_of(id)].company + " , " + jobs[index_of(id)].city + " , " + kind_name(jobs[index_of(id)].kind) + " , $" + jobs[index_of(id)].salary + "k"
            end
            paragraph:
                margin = 0
                line height = 1.6
                content = jobs[index_of(id)].about
            end
            box:
                layout = row
                gap = 10
                SaveButton:
                    id = id
                end
                button:
                    id = "apply"
                    padding = 10, 20
                    radius = 8
                    border = 0
                    cursor = pointer
                    background = #2d7a53
                    color = #ffffff
                    font weight = 700
                    click = ():
                        apply_to(id)
                    end
                    content = is_applied(id) ? "Application sent" : "Apply now"
                end
            end
        end
    end
end

pub component JobDetail(id: int):
    title = "Job details"
    JobPanel:
        id = id
    end
end
