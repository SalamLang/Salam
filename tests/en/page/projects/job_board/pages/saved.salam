pub component SavedJobs:
    title = "Saved jobs"
    box:
        gap = 14
        heading:
            size = 1
            margin = 0
            content = "Saved jobs"
        end
        if saved.Len() == 0:
            paragraph:
                id = "saved-none"
                color = "#4d6657"
                content = "Nothing saved yet. Use Save on a job you like."
            end
        end
        list:
            id = "saved-jobs"
            gap = 10
            padding = 0
            each _, at in saved_jobs():
                JobCard:
                    key = jobs[at].id
                    at = at
                end
            end
        end
    end
end
