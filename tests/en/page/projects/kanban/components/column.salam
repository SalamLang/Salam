pub component Column(col: int):
    section:
        class = "column"
        grow = 1
        min width = 240
        gap = 10
        padding = 12
        radius = 14
        background = "#dde2ee"
        header:
            layout = "row"
            align = "center"
            justify = "between"
            heading:
                size = 3
                margin = 0
                content = column_name(col)
            end
            span:
                class = "count"
                padding = 2, 10
                radius = 12
                background = "#ffffff"
                font size = 13
                content = count_in(col)
            end
        end
        each i, _ in titles:
            if cols.Get(i) == col:
                CardTile:
                    key = i
                    at = i
                end
            end
        end
    end
end
