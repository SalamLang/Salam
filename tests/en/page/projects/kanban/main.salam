// EXPECT: var __salam_rt_hash = true
// EXPECT: Kanban
// EXPECT-NOT: <meta name="salam-router"
import dom

mut titles := load_titles()
mut notes := load_notes()
mut cols := load_cols()
mut draft := ""
mut problem := ""

func records(): Vector<str>:
    mut out := Vector {} as Vector<str>
    raw := dom.StoreGetStr("kanban.cards")
    if raw.Len() == 0:
        out.Push("0\tDraft the release notes\tNeeds a changelog")
        out.Push("0\tReview open pull requests\t")
        out.Push("1\tFix the flaky test\tSeen only on Linux")
        out.Push("2\tSet up the repository\tDone on day one")
        ret out
    end
    parts := raw.Split("\n")
    repeat parts.Len() in i:
        if parts.Get(i).Len() > 2:
            out.Push(parts.Get(i))
        end
    end
    ret out
end

func field(line: str, at: int): str:
    parts := line.Split("\t")
    if at < parts.Len():
        ret parts.Get(at)
    end
    ret ""
end

func load_titles(): Vector<str>:
    mut out := Vector {} as Vector<str>
    rows := records()
    repeat rows.Len() in i:
        out.Push(field(rows.Get(i), 1))
    end
    ret out
end

func load_notes(): Vector<str>:
    mut out := Vector {} as Vector<str>
    rows := records()
    repeat rows.Len() in i:
        out.Push(field(rows.Get(i), 2))
    end
    ret out
end

func load_cols(): Vector<int>:
    mut out := Vector {} as Vector<int>
    rows := records()
    repeat rows.Len() in i:
        c := field(rows.Get(i), 0)
        out.Push(c == "1" ? 1 : (c == "2" ? 2 : 0))
    end
    ret out
end

func save():
    mut out := ""
    repeat titles.Len() in i:
        out += cols.Get(i) + "\t" + titles.Get(i) + "\t" + notes.Get(i) + "\n"
    end
    dom.StoreSetStr("kanban.cards", out)
end

func column_name(c: int): str:
    if c == 0:
        ret "To do"
    else c == 1:
        ret "Doing"
    end
    ret "Done"
end

func count_in(c: int): int:
    mut n := 0
    repeat cols.Len() in i:
        if cols.Get(i) == c:
            n++
        end
    end
    ret n
end

func add_card():
    clean := draft.Trim()
    if clean.Len() == 0:
        problem = "A card needs a title"
        ret
    end
    if clean.Find("\t") >= 0:
        problem = "Tabs are not allowed in a title"
        ret
    end
    titles.Push(clean)
    notes.Push("")
    cols.Push(0)
    draft = ""
    problem = ""
    save()
end

func move_card(i: int, step: int):
    next := cols.Get(i) + step
    if next < 0 or next > 2:
        ret
    end
    cols.Set(i, next)
    save()
end

func remove_card(i: int):
    titles.RemoveAt(i)
    notes.RemoveAt(i)
    cols.RemoveAt(i)
    save()
end

func save_notes():
    save()
end

pub component CardTile(at: int):
    article:
        class = "card"
        gap = 8
        padding = 12
        radius = 10
        background = "#ffffff"
        shadow = 0, 1, 3, "#1c233318"
        link:
            to = "/card/" + at
            color = "#1c2333"
            font weight = 600
            decoration = "none"
            content = titles.Get(at)
        end
        if notes.Get(at).Len() > 0:
            paragraph:
                margin = 0
                font size = 13
                opacity = 0.65
                content = notes.Get(at)
            end
        end
        box:
            layout = "row"
            gap = 6
            button:
                class = "left"
                padding = 4, 10
                radius = 8
                border = 1, "solid", "#c5ccdb"
                background = "#ffffff"
                cursor = "pointer"
                aria label = "Move left"
                disabled = cols.Get(at) == 0
                click = (): move_card(at, -1) end
                content = "<"
            end
            button:
                class = "right"
                padding = 4, 10
                radius = 8
                border = 1, "solid", "#c5ccdb"
                background = "#ffffff"
                cursor = "pointer"
                aria label = "Move right"
                disabled = cols.Get(at) == 2
                click = (): move_card(at, 1) end
                content = ">"
            end
            button:
                class = "delete"
                padding = 4, 10
                radius = 8
                border = 0
                background = "transparent"
                color = "#b42318"
                cursor = "pointer"
                aria label = "Delete card"
                click = (): remove_card(at) end
                content = "x"
            end
        end
    end
end

page:
    mode = "hash"
    title = "Kanban"
    lang = "en"
    font = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = "#eef1f6"
        color = "#1c2333"
        header:
            layout = "row"
            align = "center"
            justify = "between"
            padding = 14, 24
            background = "#1c2333"
            color = "#ffffff"
            link:
                to = "/"
                color = "#ffffff"
                font size = 20
                font weight = 800
                decoration = "none"
                content = "Kanban"
            end
            span:
                id = "total"
                opacity = 0.7
                content = titles.Len() + " cards"
            end
        end
        main:
            padding = 20, 24
            gap = 16
            Outlet: end
        end
    end
end
