pub component CardPage(id: int):
    title = "Card"
    box:
        gap = 12
        max width = 560
        padding = 18
        radius = 14
        background = "#ffffff"
        if id < titles.Len():
            heading:
                size = 1
                margin = 0
                content = titles.Get(id)
            end
            paragraph:
                id = "where"
                margin = 0
                content = "In column: " + column_name(cols.Get(id))
            end
            label:
                gap = 4
                span:
                    content = "Notes"
                end
                input:
                    id = "note"
                    padding = 10, 12
                    radius = 10
                    border = 1, "solid", "#c5ccdb"
                    bind = notes[id]
                    change = save_notes
                end
            end
            box:
                layout = "row"
                gap = 8
                button:
                    id = "back-col"
                    padding = 8, 14
                    radius = 10
                    cursor = "pointer"
                    disabled = cols.Get(id) == 0
                    click = (): move_card(id, -1) end
                    content = "Move back"
                end
                button:
                    id = "next-col"
                    padding = 8, 14
                    radius = 10
                    cursor = "pointer"
                    disabled = cols.Get(id) == 2
                    click = (): move_card(id, 1) end
                    content = "Move forward"
                end
                button:
                    id = "remove"
                    padding = 8, 14
                    radius = 10
                    border = 0
                    background = "#fde7e4"
                    color = "#b42318"
                    cursor = "pointer"
                    click = ():
                        remove_card(id)
                        page.route.GoTo("/")
                    end
                    content = "Delete card"
                end
            end
        else:
            heading:
                size = 1
                content = "No such card"
            end
        end
        link:
            to = "/"
            content = "Back to the board"
        end
    end
end
