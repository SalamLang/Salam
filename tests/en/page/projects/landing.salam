// EXPECT: >Ship pages in Salam</h1>
// EXPECT: Start free
component Feature(icon: str, name: str, about: str):
    box:
        grow = 1
        basis = 0
        min width = 220
        padding = 20
        gap = 8
        radius = 14
        background = #ffffff
        border = 1, solid, #e6e8ef
        transition = 200ms, ease out
        hover:
            shadow = 0, 10, 30, #1f29371f
            translate = 0, -2
        end
        paragraph: font size = 28 content = icon end
        heading: size = 3 content = name end
        paragraph: color = #5b6475 line height = 1.6 content = about end
    end
end

component Plan(name: str, price: str, note: str, bg: str, fg: str, cta: str, cta_fg: str):
    box:
        grow = 1
        min width = 240
        padding = 24
        gap = 12
        radius = 16
        border = 1, solid, #e6e8ef
        background = bg
        color = fg
        transition = 200ms, ease out
        hover:
            shadow = 0, 18, 40, #11182733
        end
        paragraph: font size = 14 font weight = 600 letter spacing = 1 content = name end
        paragraph: font size = 40 font weight = 800 content = "$" + price end
        paragraph: opacity = 0.75 content = note end
        button:
            padding = 10, 16
            radius = 10
            font weight = 600
            background = cta
            color = cta_fg
            hover:
                opacity = 0.9
            end
            content = "Choose " + name
        end
    end
end

component Question(ask: str, answer: str):
    details:
        width = 100%
        padding = 14, 18
        radius = 12
        background = #ffffff
        border = 1, solid, #e6e8ef
        summary: font weight = 600 cursor = pointer content = ask end
        paragraph: margin = 10, 0, 0, 0 color = #5b6475 line height = 1.6 content = answer end
    end
end

page:
    title = "Salam pages"
    lang = "en"
    background = #f6f7fb
    color = #111827
    font family = "system-ui, sans-serif"
    header:
        layout = row
        align = center
        justify = between
        padding = 18, 32
        background = #ffffff
        border bottom = 1, solid, #e6e8ef
        paragraph: font size = 20 font weight = 800 content = "salam.pages" end
        nav:
            layout = row
            gap = 20
            link: url = "#features" color = #374151 text decoration = none content = "Features" end
            link: url = "#pricing" color = #374151 text decoration = none content = "Pricing" end
            link: url = "#faq" color = #374151 text decoration = none content = "FAQ" end
        end
    end
    main:
        box:
            padding = 80, 32, 64, 32
            gap = 18
            align = center
            text align = center
            background = #eef0ff
            heading: size = 1 font size = 48 font weight = 800 content = "Ship pages in Salam" end
            paragraph: max width = 620 font size = 19 color = #4b5563 line height = 1.6 content = "One language for the layout, the styles and the logic. Build a page, a single-page app or a desktop window from the same source." end
            box:
                layout = row
                gap = 12
                justify = center
                link: url = "#pricing" padding = 12, 22 radius = 12 background = #6366f1 color = #ffffff font weight = 600 text decoration = none content = "Start free" end
                link: url = "#features" padding = 12, 22 radius = 12 background = #ffffff color = #3730a3 font weight = 600 border = 1, solid, #c7d2fe text decoration = none content = "See features" end
            end
        end
        box:
            id = "features"
            padding = 56, 32
            gap = 24
            max width = 1080
            margin = 0, auto
            width = 100%
            heading: size = 2 text align = center content = "Everything in one place" end
            box:
                layout = row
                wrap = true
                gap = 16
                Feature: icon = "⚡" name = "Fast by default" about = "Pages build to minified HTML, CSS and JavaScript with no runtime to download." end
                Feature: icon = "🧭" name = "Routes built in" about = "A routes block turns one page into a single-page app with links, guards and history." end
                Feature: icon = "🌗" name = "Light and dark" about = "Style if blocks read the window: width, dark mode and reduced motion." end
            end
        end
        box:
            id = "pricing"
            padding = 56, 32
            gap = 24
            max width = 1080
            margin = 0, auto
            width = 100%
            heading: size = 2 text align = center content = "Simple pricing" end
            box:
                layout = row
                wrap = true
                gap = 16
                align = stretch
                Plan: name = "Starter" price = "0" note = "For side projects" bg = "#ffffff" fg = "#111827" cta = "#eef0ff" cta_fg = "#3730a3" end
                Plan: name = "Team" price = "12" note = "Per person, per month" bg = "#111827" fg = "#ffffff" cta = "#6366f1" cta_fg = "#ffffff" end
                Plan: name = "Scale" price = "49" note = "Priority support" bg = "#ffffff" fg = "#111827" cta = "#eef0ff" cta_fg = "#3730a3" end
            end
        end
        box:
            id = "faq"
            padding = 56, 32
            gap = 12
            max width = 760
            margin = 0, auto
            width = 100%
            heading: size = 2 text align = center content = "Questions" end
            Question: ask = "Do I need JavaScript?" answer = "No. Static pages ship as plain HTML and CSS; state and routes add only the script they need." end
            Question: ask = "Can I deploy anywhere?" answer = "Yes. Any static host works; history mode routes get a 404.html and an .htaccess for you." end
        end
    end
    footer:
        padding = 28, 32
        text align = center
        color = #6b7280
        border top = 1, solid, #e6e8ef
        paragraph: content = "Built with Salam" end
    end
end
