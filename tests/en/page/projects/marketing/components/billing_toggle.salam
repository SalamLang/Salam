pub component BillingToggle:
    box:
        layout = "row"
        justify = "center"
        align = "center"
        gap = 12
        span:
            font weight = yearly ? 400 : 700
            content = "Monthly"
        end
        button:
            class = "billing"
            width = 52
            height = 28
            radius = 999
            border = 0
            padding = 3
            background = yearly ? "#4338ca" : "#c7cbe6"
            cursor = "pointer"
            aria label = "Bill yearly"
            aria pressed = yearly
            click = (): yearly = not yearly end
            span:
                layout = "column"
                width = 22
                height = 22
                radius = 999
                background = "#ffffff"
                transition = 160ms
                translate = yearly ? "24px" : "0px", 0
            end
        end
        span:
            font weight = yearly ? 700 : 400
            content = "Yearly, save " + YEARLY_DISCOUNT_PERCENT + "%"
        end
    end
end
