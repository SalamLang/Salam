pub component Carousel:
    section:
        class = "carousel"
        gap = 14
        align = "center"
        text align = "center"
        max width = 640
        margin = 0, auto
        aria label = "Customer quotes"
        block quote:
            id = "quote"
            margin = 0
            font size = 22
            line height = 1.4
            content = quote_text(slide)
        end
        paragraph:
            id = "author"
            margin = 0
            color = "#5b6280"
            content = quote_author(slide)
        end
        box:
            layout = "row"
            align = "center"
            gap = 14
            button:
                id = "prev"
                padding = 6, 14
                radius = 999
                border = 1, "solid", "#c7cbe6"
                background = "#ffffff"
                cursor = "pointer"
                aria label = "Previous quote"
                click = prev_slide
                content = "<"
            end
            span:
                id = "position"
                color = "#5b6280"
                content = (slide + 1) + " / " + quote_count()
            end
            button:
                id = "next"
                padding = 6, 14
                radius = 999
                border = 1, "solid", "#c7cbe6"
                background = "#ffffff"
                cursor = "pointer"
                aria label = "Next quote"
                click = next_slide
                content = ">"
            end
        end
    end
end
