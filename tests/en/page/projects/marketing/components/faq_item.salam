pub component FaqItem(at: int):
    box:
        class = "faq"
        border bottom = 1, solid, #e1e4f2
        button:
            class = "question"
            width = 100%
            layout = "row"
            justify = "between"
            padding = 16, 4
            border = 0
            background = "transparent"
            color = "#14213d"
            font size = 17
            font weight = 600
            text align = "start"
            cursor = "pointer"
            aria expanded = (open_faq == at)
            click = (): toggle_faq(at) end
            span:
                content = faq_question(at)
            end
            span:
                content = (open_faq == at) ? "-" : "+"
            end
        end
        if open_faq == at:
            paragraph:
                class = "answer"
                margin = 0
                padding = 0, 4, 16, 4
                color = "#4a5170"
                content = faq_answer(at)
            end
        end
    end
end
