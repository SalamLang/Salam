pub component Newsletter:
    form:
        novalidate = true
        gap = 10
        max width = 460
        margin = 0, auto
        submit = (e: i64):
            submit_form(e)
        end
        box:
            layout = "row"
            gap = 8
            input:
                class = "mail"
                type = "email"
                grow = 1
                padding = 11, 14
                radius = 10
                border = 1, "solid", "#c7cbe6"
                font size = 16
                autocomplete = "email"
                aria label = "Your email"
                placeholder = "you@example.com"
                bind = subscriber_email
            end
            button:
                class = "join"
                type = "submit"
                padding = 11, 18
                radius = 10
                border = 0
                background = "#4338ca"
                color = "#ffffff"
                font weight = 600
                cursor = "pointer"
                content = "Subscribe"
            end
        end
        if tried and email_error().Len() > 0:
            paragraph:
                class = "error"
                margin = 0
                color = "#b91c1c"
                font size = 14
                role = "alert"
                content = email_error()
            end
        end
    end
end
