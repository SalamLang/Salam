pub component PlanCard(plan: int):
    section:
        class = "plan"
        padding = 24
        radius = 18
        gap = 8
        background = "#ffffff"
        border = 1, solid, #e1e4f2
        if plan == 1:
            border = 2, solid, #4338ca
            shadow = 0, 16, 36, #4338ca24
        end
        h2:
            margin = 0
            font size = 20
            content = plan_name(plan)
        end
        paragraph:
            margin = 0
            color = "#5b6280"
            content = plan_blurb(plan)
        end
        paragraph:
            class = "price"
            margin = 8, 0, 0, 0
            font size = 40
            font weight = 800
            content = "$" + shown_price(plan)
            span:
                font size = 15
                font weight = 400
                color = "#5b6280"
                content = " / month"
            end
        end
        paragraph:
            class = "billed"
            margin = 0
            color = "#5b6280"
            font size = 14
            content = billed_text(plan)
        end
        link:
            to = "/subscribe"
            margin = 10, 0, 0, 0
            padding = 11, 16
            radius = 12
            text align = "center"
            text decoration = "none"
            font weight = 600
            background = (plan == 1) ? "#4338ca" : "#eef0fb"
            color = (plan == 1) ? "#ffffff" : "#4338ca"
            content = "Choose " + plan_name(plan)
        end
    end
end
