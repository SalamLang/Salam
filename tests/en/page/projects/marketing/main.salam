// EXPECT: <meta name="salam-router" content="history">
// EXPECT: Tempo
import dom

const BRAND := "Tempo"
const YEARLY_DISCOUNT_PERCENT := 20

mut yearly := false
mut open_faq := -1
mut slide := 0
mut subscriber_email := ""
mut tried := false

func plan_names(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("Solo")
    v.Push("Team")
    v.Push("Company")
    ret v
end

func plan_name(plan: int): str:
    ret plan_names().Get(plan)
end

func faq_question(at: int): str:
    ret faq_questions().Get(at)
end

func submit_form(e: i64):
    dom.PreventDefault(e)
    subscribe()
end

func monthly_price(plan: int): int:
    if plan == 0:
        ret 9
    else plan == 1:
        ret 29
    end
    ret 79
end

func shown_price(plan: int): int:
    if yearly:
        ret monthly_price(plan) * (100 - YEARLY_DISCOUNT_PERCENT) / 100
    end
    ret monthly_price(plan)
end

func billed_text(plan: int): str:
    if yearly:
        ret "billed yearly, " + (shown_price(plan) * 12) + " per year"
    end
    ret "billed monthly"
end

func plan_blurb(plan: int): str:
    if plan == 0:
        ret "For one person with a lot to plan."
    else plan == 1:
        ret "Shared boards for up to ten people."
    end
    ret "Unlimited people, single sign on and a human on call."
end

func faq_questions(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("Can I try Tempo for free?")
    v.Push("Can I change plans later?")
    v.Push("Do you offer refunds?")
    v.Push("Where is my data stored?")
    ret v
end

func faq_answer(at: int): str:
    if at == 0:
        ret "Yes. Every plan starts with 30 days free and needs no card."
    else at == 1:
        ret "Any time. The price changes from your next billing day."
    else at == 2:
        ret "If Tempo is not right for you, write to us within 60 days and we refund the last payment."
    end
    ret "In the European Union, encrypted at rest. You can export everything as a file."
end

func toggle_faq(at: int):
    if open_faq == at:
        open_faq = -1
    else:
        open_faq = at
    end
end

func quote_text(at: int): str:
    if at == 0:
        ret "We stopped losing tasks in chat the week we moved to Tempo."
    else at == 1:
        ret "It is the first planner my whole team opens without being asked."
    end
    ret "Setup took ten minutes, and nobody needed training."
end

func quote_author(at: int): str:
    if at == 0:
        ret "Dana, studio lead"
    else at == 1:
        ret "Marcus, engineering manager"
    end
    ret "Priya, operations"
end

func quote_count(): int:
    ret 3
end

func next_slide():
    slide = (slide + 1) % quote_count()
end

func prev_slide():
    slide = (slide + quote_count() - 1) % quote_count()
end

func email_error(): str:
    if not subscriber_email.Includes("@") or not subscriber_email.Includes("."):
        ret "Enter a valid email address."
    end
    ret ""
end

func subscribe():
    tried = true
    if email_error().Len() == 0:
        page.route.GoTo("/subscribed")
    end
end

page:
    title = BRAND + ", plans that keep up"
    lang = "en"
    background = "#ffffff"
    color = "#14213d"
    font family = "system-ui, sans-serif"
    line height = 1.6
    header:
        layout = "row"
        align = "center"
        justify = "between"
        wrap = true
        gap = 10
        padding = 16, 5vw
        position = "sticky"
        top = 0
        background = "#ffffffee"
        link:
            to = "/"
            font size = 22
            font weight = 800
            color = "#4338ca"
            text decoration = "none"
            content = BRAND
        end
        nav:
            layout = "row"
            align = "center"
            gap = 18
            link:
                to = "/pricing"
                color = "#14213d"
                text decoration = "none"
                content = "Pricing"
            end
            link:
                to = "/faq"
                color = "#14213d"
                text decoration = "none"
                content = "FAQ"
            end
            link:
                to = "/subscribe"
                padding = 8, 16
                radius = 999
                background = "#4338ca"
                color = "#ffffff"
                text decoration = "none"
                content = "Get updates"
            end
        end
    end
    main:
        Outlet: end
    end
    footer:
        padding = 32, 5vw
        background = "#f4f5fb"
        color = "#5b6280"
        text align = "center"
        font size = 14
        content = BRAND + ", made with Salam"
    end
end
