pub component Missing:
    title = "Not found"
    box:
        padding = 64, 5vw
        gap = 12
        text align = "center"
        heading:
            size = 1
            content = "Page not found"
        end
        link:
            to = "/"
            color = "#4338ca"
            content = "Go home"
        end
    end
end
