pub component Faq:
    title = "FAQ | " + BRAND
    box:
        padding = 48, 5vw
        max width = 720
        margin = 0, auto
        heading:
            size = 1
            content = "Frequently asked questions"
        end
        each i, _ in faq_questions():
            FaqItem:
                at = i
            end
        end
    end
end
