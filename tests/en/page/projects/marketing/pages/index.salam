pub component Home:
    title = BRAND + ", plans that keep up"
    box:
        section:
            padding = 72, 5vw
            text align = "center"
            gap = 16
            background = "#f1f1fb"
            heading:
                size = 1
                margin = 0
                font size = 52
                line height = 1.1
                content = "Plan the week. Keep the calm."
            end
            paragraph:
                margin = 0, auto
                max width = 540
                font size = 19
                color = "#4a5170"
                content = BRAND + " turns a pile of tasks into a week you can actually finish."
            end
            box:
                layout = "row"
                justify = "center"
                gap = 12
                link:
                    to = "/pricing"
                    padding = 13, 24
                    radius = 12
                    background = "#4338ca"
                    color = "#ffffff"
                    text decoration = "none"
                    font weight = 600
                    content = "See pricing"
                end
                link:
                    to = "/faq"
                    padding = 13, 24
                    radius = 12
                    border = 1, solid, #c7cbe6
                    color = "#14213d"
                    text decoration = "none"
                    content = "Questions"
                end
            end
        end
        section:
            padding = 56, 5vw
            gap = 24
            heading:
                size = 2
                margin = 0
                text align = "center"
                content = "Plans for every size"
            end
            BillingToggle: end
            box:
                layout = "grid"
                columns = repeat (fit, minmax(240px, 1fr))
                gap = 20
                max width = 960
                margin = 0, auto
                each i, _ in plan_names():
                    PlanCard:
                        plan = i
                    end
                end
            end
        end
        section:
            padding = 56, 5vw
            background = "#f4f5fb"
            gap = 20
            heading:
                size = 2
                margin = 0
                text align = "center"
                content = "Loved by small teams"
            end
            Carousel: end
        end
        section:
            padding = 56, 5vw
            gap = 12
            text align = "center"
            heading:
                size = 2
                margin = 0
                content = "Get product news"
            end
            Newsletter: end
        end
    end
end
