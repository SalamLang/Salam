pub component Pricing:
    title = "Pricing | " + BRAND
    box:
        padding = 48, 5vw
        gap = 24
        heading:
            size = 1
            margin = 0
            text align = "center"
            content = "Simple pricing"
        end
        BillingToggle: end
        box:
            layout = "grid"
            columns = repeat (fit, minmax(240px, 1fr))
            gap = 20
            max width = 960
            margin = 0, auto
            each i, _ in plan_names():
                PlanCard:
                    plan = i
                end
            end
        end
    end
end
