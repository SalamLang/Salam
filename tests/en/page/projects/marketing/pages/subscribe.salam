pub component Subscribe:
    title = "Subscribe | " + BRAND
    box:
        padding = 64, 5vw
        gap = 16
        text align = "center"
        heading:
            size = 1
            margin = 0
            content = "Stay in the loop"
        end
        paragraph:
            margin = 0
            color = "#4a5170"
            content = "One short email a month. No spam, leave any time."
        end
        Newsletter: end
    end
end
