pub component Subscribed:
    title = "Welcome | " + BRAND
    box:
        padding = 64, 5vw
        gap = 14
        text align = "center"
        heading:
            size = 1
            margin = 0
            content = "You are on the list"
        end
        paragraph:
            id = "confirmation"
            margin = 0
            content = "We sent a confirmation to " + subscriber_email + "."
        end
        link:
            to = "/"
            color = "#4338ca"
            content = "Back to " + BRAND
        end
    end
end
