pub component ProgressBar(percent: int):
    box:
        class = "bar"
        height = 6
        radius = 999
        background = #e4e2ee
        overflow = hidden
        box:
            class = "fill"
            height = 100%
            width = percent + "%"
            background = #7c3aed
            transition = 300ms, linear
        end
    end
end
