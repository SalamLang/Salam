pub component QueueRow(place: int, song: int):
    box:
        class = "queued"
        layout = row
        align = center
        gap = 10
        padding = 10, 14
        radius = 12
        background = #ffffff
        border = 1, solid, #e4e2ee
        span:
            font weight = 700
            color = #7c3aed
            content = (place + 1) + "."
        end
        paragraph:
            margin = 0
            grow = 1
            content = title_of(song) + " - " + artist_of(song)
        end
        button:
            class = "up"
            padding = 4, 10
            radius = 999
            border = 1, solid, #ccc9e0
            background = transparent
            cursor = pointer
            click = ():
                raise_in_queue(place)
            end
            content = "Up"
        end
        button:
            class = "remove"
            padding = 4, 10
            radius = 999
            border = 1, solid, #e11d48
            background = transparent
            color = #e11d48
            cursor = pointer
            click = ():
                drop_from_queue(place)
            end
            content = "Remove"
        end
    end
end
