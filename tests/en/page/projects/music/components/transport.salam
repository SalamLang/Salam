pub component Transport(running: bool):
    box:
        layout = "row"
        align = "center"
        justify = "center"
        gap = 14
        button:
            id = "prev"
            padding = 10, 18
            radius = 999
            border = 1, solid, #7c3aed
            background = "transparent"
            color = "#7c3aed"
            cursor = "pointer"
            click = previous
            content = "Prev"
        end
        button:
            id = "play"
            padding = 12, 28
            radius = 999
            border = 0
            background = "#7c3aed"
            color = "#ffffff"
            font weight = 700
            cursor = "pointer"
            click = toggle_play
            content = running ? "Pause" : "Play"
        end
        button:
            id = "next"
            padding = 10, 18
            radius = 999
            border = 1, solid, #7c3aed
            background = "transparent"
            color = "#7c3aed"
            cursor = "pointer"
            click = advance
            content = "Next"
        end
    end
end
