// EXPECT: <meta name="salam-router" content="history">
// EXPECT: "/track/:id"
// EXPECT: "/queue"
// EXPECT: "/now"
import dom

const TRACKS := [0, 1, 2, 3, 4, 5]

mut cur_track := 0
mut elapsed := 0
mut playing := false
mut ticker := 0 as i64
mut upcoming := Vector {} as Vector<int>
mut volume := 70
mut fast := false
mut loop_all := true

pure func title_of(song: int): str:
    if song == 0:
        ret "Morning Static"
    else song == 1:
        ret "Paper Boats"
    else song == 2:
        ret "Low Tide Radio"
    else song == 3:
        ret "Copper Wire"
    else song == 4:
        ret "Slow Lanterns"
    end
    ret "Last Train Home"
end

pure func artist_of(song: int): str:
    if song % 2 == 0:
        ret "The Quiet Engines"
    end
    ret "Mira Dalton"
end

pure func length_of(song: int): int:
    if song == 0:
        ret 184
    else song == 1:
        ret 212
    else song == 2:
        ret 167
    else song == 3:
        ret 241
    else song == 4:
        ret 198
    end
    ret 223
end

pure func two_digits(num: int): str:
    if num < 10:
        ret "0" + num
    end
    ret "" + num
end

pure func mmss(secs: int): str:
    ret (secs / 60) + ":" + two_digits(secs % 60)
end

pure func percent_done(): int:
    ret elapsed * 100 / length_of(cur_track)
end

pure func pace(): int:
    if fast:
        ret 10
    end
    ret 1
end

func advance():
    elapsed = 0
    if upcoming.Len() > 0:
        cur_track = upcoming[0]
        upcoming.RemoveAt(0)
    else loop_all:
        cur_track = (cur_track + 1) % 6
    end
end

func tick():
    elapsed += pace()
    if elapsed >= length_of(cur_track):
        advance()
    end
end

func start():
    if not playing:
        ticker = dom.SetInterval((): tick() end, 1000)
        playing = true
    end
end

func stop():
    if playing:
        dom.ClearInterval(ticker)
        playing = false
    end
end

func toggle_play():
    if playing:
        stop()
    else:
        start()
    end
end

func play_track(song: int):
    cur_track = song
    elapsed = 0
    start()
end

func previous():
    if elapsed > 3:
        elapsed = 0
    else:
        cur_track = (cur_track + 5) % 6
        elapsed = 0
    end
end

func enqueue(song: int):
    upcoming.Push(song)
end

func drop_from_queue(at: int):
    upcoming.RemoveAt(at)
end

func raise_in_queue(at: int):
    if at > 0:
        above := upcoming[at - 1]
        upcoming[at - 1] = upcoming[at]
        upcoming[at] = above
    end
end

func seek_to(typed: str):
    elapsed = typed.ToInt()
end

func set_volume(typed: str):
    volume = typed.ToInt()
end

func shell_key(ev: i64):
    key := dom.EventKey(ev)
    if key == " ":
        dom.PreventDefault(ev)
        toggle_play()
    else key == "n":
        advance()
    else key == "p":
        previous()
    end
end

pub component TrackRow(song: int, current: bool):
    box:
        class = "track"
        layout = "row"
        align = "center"
        gap = 12
        padding = 10, 14
        radius = 12
        background = "#ffffff"
        border = 1, "solid", "#e4e2ee"
        if current:
            border = 1, "solid", "#7c3aed"
            background = "#f3edff"
        end
        button:
            class = "play"
            width = 36
            height = 36
            radius = 50%
            border = 0
            background = "#7c3aed"
            color = "#ffffff"
            cursor = "pointer"
            click = ():
                play_track(song)
            end
            content = (current and playing) ? "||" : ">"
        end
        link:
            to = "/track/" + song
            grow = 1
            color = "#1d1b2e"
            text decoration = "none"
            font weight = 600
            content = title_of(song)
        end
        small:
            opacity = 0.65
            content = artist_of(song)
        end
        small:
            opacity = 0.65
            content = mmss(length_of(song))
        end
        button:
            class = "queue-add"
            padding = 4, 10
            radius = 999
            border = 1, "solid", "#7c3aed"
            background = "transparent"
            color = "#7c3aed"
            cursor = "pointer"
            click = ():
                enqueue(song)
            end
            content = "+ Queue"
        end
    end
end

page:
    title = "Echo"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        key down = shell_key
        tab index = 0
        min height = 100vh
        background = "#f6f5fb"
        color = "#1d1b2e"
        header:
            layout = "row"
            align = "center"
            justify = "between"
            wrap = true
            gap = 10
            padding = 14, 28
            background = "#1d1b2e"
            link:
                to = "/"
                font size = 22
                font weight = 800
                color = "#ffffff"
                text decoration = "none"
                content = "echo"
            end
            nav:
                layout = "row"
                gap = 6
                link:
                    to = "/"
                    padding = 8, 14
                    color = "#d9d4f5"
                    text decoration = "none"
                    content = "Library"
                end
                link:
                    to = "/now"
                    padding = 8, 14
                    color = "#d9d4f5"
                    text decoration = "none"
                    content = "Now playing"
                end
                link:
                    id = "queue-link"
                    to = "/queue"
                    padding = 8, 14
                    radius = 999
                    background = "#7c3aed"
                    color = "#ffffff"
                    text decoration = "none"
                    content = "Queue (" + upcoming.Len() + ")"
                end
            end
        end
        main:
            max width = 760
            width = 100%
            margin = 0, "auto"
            padding = 20, 16, 110, 16
            Outlet: end
        end
        footer:
            id = "mini"
            position = "fixed"
            bottom = 0
            left = 0
            right = 0
            layout = "row"
            align = "center"
            gap = 12
            padding = 10, 20
            background = "#ffffff"
            border top = 1, "solid", "#e4e2ee"
            button:
                id = "toggle"
                width = 40
                height = 40
                radius = 50%
                border = 0
                background = "#7c3aed"
                color = "#ffffff"
                cursor = "pointer"
                click = toggle_play
                content = playing ? "||" : ">"
            end
            box:
                grow = 1
                paragraph:
                    id = "mini-title"
                    margin = 0
                    font weight = 700
                    content = title_of(cur_track)
                end
                ProgressBar:
                    percent = percent_done()
                end
            end
            span:
                id = "clock"
                content = mmss(elapsed) + " / " + mmss(length_of(cur_track))
            end
        end
    end
end
