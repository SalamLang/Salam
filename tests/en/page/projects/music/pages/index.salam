pub component Library:
    title = "Echo"
    box:
        gap = 10
        heading:
            size = 2
            margin = 0
            content = "Library"
        end
        each i, song in TRACKS:
            TrackRow:
                key = i
                song = song
                current = (song == cur_track)
            end
        end
    end
end
