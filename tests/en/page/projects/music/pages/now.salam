pub component Now:
    title = "Now playing"
    box:
        gap = 18
        align = center
        text align = center
        box:
            width = 220
            height = 220
            radius = 24
            align = center
            justify = center
            font size = 80
            color = #ffffff
            background = #7c3aed
            content = playing ? "♪" : "♫"
        end
        heading:
            id = "now-title"
            size = 2
            margin = 0
            content = title_of(cur_track)
        end
        paragraph:
            margin = 0
            opacity = 0.7
            content = artist_of(cur_track)
        end
        box:
            width = 100%
            max width = 420
            gap = 6
            input:
                id = "seek"
                type = range
                min = 0
                max = length_of(cur_track)
                value = elapsed
                input = (typed: str):
                    seek_to(typed)
                end
            end
            box:
                layout = row
                justify = between
                small:
                    id = "elapsed"
                    content = mmss(elapsed)
                end
                small:
                    content = mmss(length_of(cur_track))
                end
            end
        end
        Transport:
            running = playing
        end
        label:
            layout = row
            align = center
            gap = 8
            input:
                id = "fast"
                type = checkbox
                bind = fast
            end
            span:
                content = "Demo speed (10x)"
            end
        end
        label:
            layout = row
            align = center
            gap = 8
            span:
                content = "Volume " + volume
            end
            input:
                id = "volume"
                type = range
                min = 0
                max = 100
                value = volume
                input = (typed: str):
                    set_volume(typed)
                end
            end
        end
    end
end
