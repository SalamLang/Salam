pub component Queue:
    title = "Queue"
    box:
        gap = 10
        heading:
            size = 2
            margin = 0
            content = "Up next"
        end
        if upcoming.Len() == 0:
            paragraph:
                id = "empty"
                content = "The queue is empty. After the current track the library plays in order."
            end
        end
        each place, song in upcoming:
            QueueRow:
                key = place
                place = place
                song = song
            end
        end
        link:
            to = "/"
            color = "#7c3aed"
            content = "Add more from the library"
        end
    end
end
