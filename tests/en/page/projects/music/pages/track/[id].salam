pub component Detail(id: int):
    title = title_of(id)
    box:
        gap = 12
        if id >= 0 and id < 6:
            link:
                to = "/"
                color = #7c3aed
                text decoration = none
                content = "Back to the library"
            end
            heading:
                id = "detail-title"
                size = 1
                margin = 0
                content = title_of(id)
            end
            paragraph:
                margin = 0
                content = artist_of(id) + " - " + mmss(length_of(id))
            end
            box:
                layout = row
                gap = 8
                button:
                    id = "detail-play"
                    padding = 10, 22
                    radius = 999
                    border = 0
                    background = #7c3aed
                    color = #ffffff
                    cursor = pointer
                    click = ():
                        play_track(id)
                    end
                    content = "Play"
                end
                button:
                    id = "detail-queue"
                    padding = 10, 22
                    radius = 999
                    border = 1, solid, #7c3aed
                    background = transparent
                    color = #7c3aed
                    cursor = pointer
                    click = ():
                        enqueue(id)
                    end
                    content = "Add to queue"
                end
            end
        else:
            heading:
                size = 2
                content = "No such track"
            end
            link:
                to = "/"
                content = "Back to the library"
            end
        end
    end
end
