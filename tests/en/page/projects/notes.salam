// EXPECT: var __salam_rt_hash = true
// EXPECT-NOT: <meta name="salam-router"
mut titles := seed_titles()
mut bodies := seed_bodies()
mut draft := ""
mut dark := false

func seed_titles(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("Groceries")
    v.Push("Ideas")
    v.Push("Trip plan")
    ret v
end

func seed_bodies(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("Oats, lemons, coffee")
    v.Push("A notes app written in Salam")
    v.Push("Train at nine, museum after lunch")
    ret v
end

func add_note():
    if draft.Len() == 0:
        ret
    end
    titles.Push("" + draft)
    bodies.Push("")
    draft = ""
    page.GoTo("/note/" + (titles.Len() - 1))
end

component NoteLink(at: int, name: str):
    link:
        to = "/note/" + at
        padding = 10, 14
        radius = 10
        color = #d6d9e0
        text decoration = none
        hover:
            background = #2a2f3a
        end
        if page.route.path == "/note/" + at:
            background = #3b4252
            color = #ffffff
        end
        content = name
    end
end

component Welcome:
    box:
        gap = 12
        heading: size = 1 content = "Notes" end
        paragraph: opacity = 0.7 content = "Pick a note on the left, or write a new one." end
    end
end

component Note(id: int):
    box:
        gap = 14
        max width = 720
        if id < titles.Len():
            heading: size = 1 content = titles[id] end
            input:
                id = "body"
                width = 100%
                padding = 14
                radius = 12
                border = 1, solid, #cfd4dd
                font size = 16
                line height = 1.6
                bind = bodies[id]
            end
            box:
                layout = row
                align = center
                justify = between
                paragraph: opacity = 0.6 content = "Saved as you type" end
                button:
                    id = "clear"
                    padding = 8, 14
                    radius = 10
                    background = #e9ebf2
                    click = ():
                        bodies[id] = ""
                    end
                    content = "Clear"
                end
            end
        else:
            heading: size = 1 content = "No such note" end
        end
    end
end

component NewNote:
    box:
        gap = 14
        max width = 520
        heading: size = 1 content = "New note" end
        input:
            id = "draft"
            padding = 12, 14
            radius = 12
            border = 1, solid, #cfd4dd
            placeholder = "Title"
            bind = draft
        end
        button:
            id = "create"
            padding = 12, 18
            radius = 12
            background = #5b6cff
            color = #ffffff
            font weight = 600
            click = add_note
            content = "Create"
        end
    end
end

component Settings:
    box:
        gap = 14
        heading: size = 1 content = "Settings" end
        label:
            layout = row
            align = center
            gap = 10
            input: id = "dark" type = checkbox bind = dark end
            span: content = "Dark theme" end
        end
    end
end

component Missing:
    box:
        gap = 10
        heading: size = 1 content = "Not found" end
        link: to = "/" content = "Back to notes" end
    end
end

routes:
    mode = hash
    "/" : Welcome title = "Notes"
    "/note/:id" : Note
    "/new" : NewNote title = "New note"
    "/settings" : Settings title = "Settings"
    "*" : Missing
end

page:
    title = "Notes"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        layout = row
        min height = 100vh
        background = #f5f6f8
        color = #1d2230
        if dark:
            background = #12151c
            color = #e8eaf0
        end
        nav:
            width = 240
            padding = 20, 12
            gap = 6
            background = #1b1f27
            link: to = "/" padding = 6, 14 font size = 20 font weight = 800 color = #ffffff text decoration = none content = "notes" end
            link: to = "/new" margin = 8, 0 padding = 10, 14 radius = 10 background = #5b6cff color = #ffffff text decoration = none font weight = 600 content = "+ New note" end
            each i, t in titles:
                NoteLink: at = i name = t end
            end
            link: to = "/settings" margin = 16, 0, 0, 0 padding = 10, 14 color = #9aa1ad text decoration = none content = "Settings" end
        end
        main:
            grow = 1
            padding = 36, 40
            Outlet: end
        end
    end
end
