// EXPECT: var __salam_rt_hash = true
// EXPECT-NOT: <meta name="salam-router"
mut titles := seed_titles()
mut bodies := seed_bodies()
mut draft := ""
mut dark := false

func seed_titles(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("Groceries")
    v.Push("Ideas")
    v.Push("Trip plan")
    ret v
end

func seed_bodies(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("Oats, lemons, coffee")
    v.Push("A notes app written in Salam")
    v.Push("Train at nine, museum after lunch")
    ret v
end

func add_note():
    if draft.Len() == 0:
        ret
    end
    titles.Push("" + draft)
    bodies.Push("")
    draft = ""
    page.route.GoTo("/note/" + (titles.Len() - 1))
end

component NoteLink(at: int, name: str):
    link:
        to = "/note/" + at
        padding = 10, 14
        radius = 10
        color = "#d6d9e0"
        decoration = "none"
        hover:
            background = "#2a2f3a"
        end
        if page.route.path == "/note/" + at:
            background = "#3b4252"
            color = "#ffffff"
        end
        content = name
    end
end

page:
    mode = "hash"
    title = "Notes"
    lang = "en"
    font = "system-ui, sans-serif"
    box:
        layout = "row"
        min height = 100vh
        background = "#f5f6f8"
        color = "#1d2230"
        if dark:
            background = "#12151c"
            color = "#e8eaf0"
        end
        nav:
            width = 240
            padding = 20, 12
            gap = 6
            background = "#1b1f27"
            link:
                to = "/"
                padding = 6, 14
                font size = 20
                font weight = 800
                color = "#ffffff"
                decoration = "none"
                content = "notes"
            end
            link:
                to = "/new"
                margin = 8, 0
                padding = 10, 14
                radius = 10
                background = "#5b6cff"
                color = "#ffffff"
                decoration = "none"
                font weight = 600
                content = "+ New note"
            end
            each i, t in titles:
                NoteLink:
                    at = i
                    name = t
                end
            end
            link:
                to = "/settings"
                margin = 16, 0, 0, 0
                padding = 10, 14
                color = "#9aa1ad"
                decoration = "none"
                content = "Settings"
            end
        end
        main:
            grow = 1
            padding = 36, 40
            Outlet: end
        end
    end
end
