pub component NewNote:
    title = "New note"
    box:
        gap = 14
        max width = 520
        heading:
            size = 1
            content = "New note"
        end
        input:
            id = "draft"
            padding = 12, 14
            radius = 12
            border = 1, solid, #cfd4dd
            placeholder = "Title"
            bind = draft
        end
        button:
            id = "create"
            padding = 12, 18
            radius = 12
            background = "#5b6cff"
            color = "#ffffff"
            font weight = 600
            click = add_note
            content = "Create"
        end
    end
end
