pub component Note(id: int):
    box:
        gap = 14
        max width = 720
        if id < titles.Len():
            heading:
                size = 1
                content = titles[id]
            end
            input:
                id = "body"
                width = 100%
                padding = 14
                radius = 12
                border = 1, solid, #cfd4dd
                font size = 16
                line height = 1.6
                bind = bodies[id]
            end
            box:
                layout = "row"
                align = "center"
                justify = "between"
                paragraph:
                    opacity = 0.6
                    content = "Saved as you type"
                end
                button:
                    id = "clear"
                    padding = 8, 14
                    radius = 10
                    background = "#e9ebf2"
                    click = ():
                        bodies[id] = ""
                    end
                    content = "Clear"
                end
            end
        else:
            heading:
                size = 1
                content = "No such note"
            end
        end
    end
end
