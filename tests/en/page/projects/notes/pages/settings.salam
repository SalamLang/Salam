pub component Settings:
    title = "Settings"
    box:
        gap = 14
        heading: size = 1 content = "Settings" end
        label:
            layout = row
            align = center
            gap = 10
            input: id = "dark" type = checkbox bind = dark end
            span: content = "Dark theme" end
        end
    end
end
