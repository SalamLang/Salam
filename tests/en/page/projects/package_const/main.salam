// EXPECT: .a { background-color:#eeeeee;gap:12px;border:1px solid #112233;color:#112233; }
// EXPECT-NOT: salamWsStyle
include theme "lib/theme.salam"

page:
    box:
        background = theme.SOFT
        gap = theme.GAP
        border = 1, "solid", theme.INK
        color = theme.INK
        paragraph: content = "themed" end
    end
end
