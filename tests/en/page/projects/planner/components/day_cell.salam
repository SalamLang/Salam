pub component DayCell(day: int):
    button:
        class = "day"
        height = 56
        radius = 10
        border = sel == day ? 2 : 1, "solid", sel == day ? "#2d3a8c" : "#d6dbe8"
        background = sel == day ? "#e6eaff" : "#ffffff"
        cursor = "pointer"
        aria pressed = sel == day
        click = (): sel = day end
        span:
            font weight = 600
            content = day
        end
        if events_on(day) > 0:
            span:
                class = "dot"
                font size = 11
                color = "#2d3a8c"
                content = events_on(day) + " ev"
            end
        end
    end
end
