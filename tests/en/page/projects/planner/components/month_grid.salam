pub component MonthGrid:
    box:
        gap = 10
        box:
            layout = "row"
            align = "center"
            justify = "between"
            button:
                id = "prev"
                padding = 6, 12
                radius = 8
                cursor = "pointer"
                aria label = "Previous month"
                click = (): shift_month(-1) end
                content = "<"
            end
            heading:
                id = "month-title"
                size = 2
                margin = 0
                content = month_name(month) + " " + year
            end
            button:
                id = "next"
                padding = 6, 12
                radius = 8
                cursor = "pointer"
                aria label = "Next month"
                click = (): shift_month(1) end
                content = ">"
            end
        end
        box:
            layout = "grid"
            columns = 7
            gap = 6
            each i, w in DAYS:
                span:
                    key = i
                    class = "weekday"
                    text align = "center"
                    font size = 13
                    opacity = 0.6
                    content = weekday_name(w)
                end
            end
            each i, _ in blanks():
                span:
                    key = i
                end
            end
            each _, k in day_list():
                DayCell:
                    day = k
                end
            end
        end
    end
end
