// EXPECT: var __salam_rt_hash = true
// EXPECT: Planner
// EXPECT-NOT: <meta name="salam-router"
import dom

const DAYS := [0, 1, 2, 3, 4, 5, 6]

mut year := 2026
mut month := 11
mut sel := 15
mut ev_day := load_days()
mut ev_month := load_event_months()
mut ev_year := load_event_years()
mut ev_title := load_titles()
mut ev_time := load_times()
mut title_text := ""
mut time_text := ""
mut problem := ""

func records(): Vector<str>:
    mut out := Vector {} as Vector<str>
    raw := dom.StoreGetStr("planner.events")
    if raw.Len() == 0:
        out.Push("2026\t11\t3\t09:30\tDentist")
        out.Push("2026\t11\t15\t12:30\tTeam lunch")
        out.Push("2026\t11\t15\t18:00\tCall mom")
        out.Push("2026\t11\t28\t08:00\tRent due")
        out.Push("2026\t12\t24\t19:00\tFamily dinner")
        ret out
    end
    parts := raw.Split("\n")
    repeat parts.Len() in i:
        if parts.Get(i).Len() > 8:
            out.Push(parts.Get(i))
        end
    end
    ret out
end

func cell(line: str, at: int): str:
    ret line.Split("\t").Get(at)
end

func load_event_years(): Vector<int>:
    mut out := Vector {} as Vector<int>
    rows := records()
    repeat rows.Len() in i:
        out.Push(cell(rows.Get(i), 0).ToInt())
    end
    ret out
end

func load_event_months(): Vector<int>:
    mut out := Vector {} as Vector<int>
    rows := records()
    repeat rows.Len() in i:
        out.Push(cell(rows.Get(i), 1).ToInt())
    end
    ret out
end

func load_days(): Vector<int>:
    mut out := Vector {} as Vector<int>
    rows := records()
    repeat rows.Len() in i:
        out.Push(cell(rows.Get(i), 2).ToInt())
    end
    ret out
end

func load_times(): Vector<str>:
    mut out := Vector {} as Vector<str>
    rows := records()
    repeat rows.Len() in i:
        out.Push(cell(rows.Get(i), 3))
    end
    ret out
end

func load_titles(): Vector<str>:
    mut out := Vector {} as Vector<str>
    rows := records()
    repeat rows.Len() in i:
        out.Push(cell(rows.Get(i), 4))
    end
    ret out
end

func save():
    mut out := ""
    repeat ev_day.Len() in i:
        out += ev_year.Get(i) + "\t" + ev_month.Get(i) + "\t" + ev_day.Get(i) + "\t" + ev_time.Get(i) + "\t" + ev_title.Get(i) + "\n"
    end
    dom.StoreSetStr("planner.events", out)
end

func is_leap(y: int): bool:
    ret (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
end

func days_in(y: int, m: int): int:
    if m == 2:
        ret is_leap(y) ? 29 : 28
    end
    if m == 4 or m == 6 or m == 9 or m == 11:
        ret 30
    end
    ret 31
end

func weekday(y: int, m: int, d: int): int:
    mut yy := y
    if m < 3:
        yy = y - 1
    end
    t := "032503514624".Substr(m - 1, 1).ToInt()
    ret (yy + yy / 4 - yy / 100 + yy / 400 + t + d) % 7
end

func lead_blanks(): int:
    ret (weekday(year, month, 1) + 6) % 7
end

func blanks(): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat lead_blanks() in i:
        out.Push(i)
    end
    ret out
end

func day_list(): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat days_in(year, month) in i:
        out.Push(i + 1)
    end
    ret out
end

func month_name(m: int): str:
    if m == 1:
        ret "January"
    else m == 2:
        ret "February"
    else m == 3:
        ret "March"
    else m == 4:
        ret "April"
    else m == 5:
        ret "May"
    else m == 6:
        ret "June"
    else m == 7:
        ret "July"
    else m == 8:
        ret "August"
    else m == 9:
        ret "September"
    else m == 10:
        ret "October"
    else m == 11:
        ret "November"
    end
    ret "December"
end

func weekday_name(w: int): str:
    if w == 0:
        ret "Mon"
    else w == 1:
        ret "Tue"
    else w == 2:
        ret "Wed"
    else w == 3:
        ret "Thu"
    else w == 4:
        ret "Fri"
    else w == 5:
        ret "Sat"
    end
    ret "Sun"
end

func events_on(d: int): int:
    mut n := 0
    repeat ev_day.Len() in i:
        if ev_day.Get(i) == d and ev_month.Get(i) == month and ev_year.Get(i) == year:
            n++
        end
    end
    ret n
end

func shift_month(step: int):
    mut m := month + step
    mut y := year
    if m < 1:
        m = 12
        y--
    end
    if m > 12:
        m = 1
        y++
    end
    month = m
    year = y
    sel = 1
end

func add_event():
    clean := title_text.Trim()
    when := time_text.Trim()
    if clean.Len() == 0:
        problem = "Give the event a title"
        ret
    end
    if when.Len() != 5 or when.Substr(2, 1) != ":":
        problem = "Write the time as HH:MM"
        ret
    end
    hh := when.Substr(0, 2).ToInt()
    mm := when.Substr(3, 5).ToInt()
    if hh > 23 or mm > 59:
        problem = "That time does not exist"
        ret
    end
    ev_year.Push(year)
    ev_month.Push(month)
    ev_day.Push(sel)
    ev_time.Push(when)
    ev_title.Push(clean)
    title_text = ""
    time_text = ""
    problem = ""
    save()
end

func remove_event(i: int):
    ev_year.RemoveAt(i)
    ev_month.RemoveAt(i)
    ev_day.RemoveAt(i)
    ev_time.RemoveAt(i)
    ev_title.RemoveAt(i)
    save()
end

func stamp(i: int): int:
    ret (ev_year.Get(i) - 2020) * 100000000 + ev_month.Get(i) * 1000000 + ev_day.Get(i) * 10000 + ev_time.Get(i).Substr(0, 2).ToInt() * 100 + ev_time.Get(i).Substr(3, 5).ToInt()
end

func agenda_order(): Vector<int>:
    mut order := Vector {} as Vector<int>
    repeat ev_day.Len() in i:
        order.Push(i)
    end
    repeat order.Len() in a:
        repeat order.Len() - 1 - a in b:
            if stamp(order.Get(b)) > stamp(order.Get(b + 1)):
                tmp := order.Get(b)
                order.Set(b, order.Get(b + 1))
                order.Set(b + 1, tmp)
            end
        end
    end
    ret order
end

pub component TabLink(dest: str, label: str):
    link:
        to = "/" + dest
        padding = 6, 12
        radius = 8
        color = "#ffffff"
        text decoration = "none"
        if page.route.path == "/" + dest:
            background = "#1f2a6b"
        end
        content = label
    end
end

pub component DayPanel:
    box:
        gap = 10
        padding = 16
        radius = 14
        background = "#ffffff"
        heading:
            id = "day-title"
            size = 3
            margin = 0
            content = month_name(month) + " " + sel
        end
        if events_on(sel) == 0:
            paragraph:
                class = "none"
                margin = 0
                opacity = 0.6
                content = "Nothing planned."
            end
        else:
            list:
                padding = 0
                margin = 0
                gap = 6
                each i, _ in ev_day:
                    if ev_day.Get(i) == sel and ev_month.Get(i) == month and ev_year.Get(i) == year:
                        item:
                            class = "ev"
                            layout = "row"
                            gap = 10
                            span:
                                font weight = 700
                                content = ev_time.Get(i)
                            end
                            link:
                                to = "/event/" + i
                                color = "#1d2433"
                                content = ev_title.Get(i)
                            end
                        end
                    end
                end
            end
        end
        form:
            gap = 8
            submit = (e: i64):
                dom.PreventDefault(e)
                add_event()
            end
            box:
                layout = "row"
                gap = 8
                input:
                    id = "ev-title"
                    grow = 1
                    padding = 8, 10
                    radius = 8
                    border = 1, "solid", "#d6dbe8"
                    placeholder = "Event title"
                    aria label = "Event title"
                    bind = title_text
                end
                input:
                    id = "ev-time"
                    width = 80
                    padding = 8, 10
                    radius = 8
                    border = 1, "solid", "#d6dbe8"
                    placeholder = "HH:MM"
                    aria label = "Time"
                    bind = time_text
                end
                button:
                    id = "ev-add"
                    type = "submit"
                    padding = 0, 14
                    radius = 8
                    border = 0
                    background = "#2d3a8c"
                    color = "#ffffff"
                    cursor = "pointer"
                    content = "Add"
                end
            end
            if problem.Len() > 0:
                paragraph:
                    id = "problem"
                    margin = 0
                    color = "#b42318"
                    role = "alert"
                    content = problem
                end
            end
        end
    end
end

page:
    mode = hash
    title = "Planner"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = "#f4f6fb"
        color = "#1d2433"
        header:
            layout = "row"
            align = "center"
            gap = 20
            padding = 14, 24
            background = "#2d3a8c"
            color = "#ffffff"
            span:
                font size = 20
                font weight = 800
                content = "Planner"
            end
            nav:
                layout = "row"
                gap = 6
                TabLink:
                    dest = ""
                    label = "Month"
                end
                TabLink:
                    dest = "agenda"
                    label = "Agenda"
                end
            end
        end
        main:
            max width = 860
            margin = 0, "auto"
            padding = 20, 16
            gap = 16
            Outlet: end
        end
    end
end
