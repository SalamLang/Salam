pub component Agenda:
    title = "Agenda"
    heading:
        size = 1
        margin = 0
        content = "Agenda"
    end
    if ev_day.Len() == 0:
        paragraph:
            class = "empty"
            content = "Your agenda is empty."
        end
    else:
        list:
            padding = 0
            margin = 0
            gap = 6
            each _, i in agenda_order():
                item:
                    class = "row"
                    layout = "row"
                    gap = 12
                    padding = 10, 14
                    radius = 10
                    background = "#ffffff"
                    span:
                        width = 120
                        content = month_name(ev_month.Get(i)) + " " + ev_day.Get(i)
                    end
                    span:
                        font weight = 700
                        content = ev_time.Get(i)
                    end
                    link:
                        to = "/event/" + i
                        color = "#1d2433"
                        content = ev_title.Get(i)
                    end
                end
            end
        end
    end
end
