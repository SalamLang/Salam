pub component EventPage(id: int):
    title = "Event"
    box:
        gap = 10
        padding = 18
        radius = 14
        background = "#ffffff"
        if id < ev_day.Len():
            heading:
                size = 1
                margin = 0
                content = ev_title.Get(id)
            end
            paragraph:
                id = "when"
                margin = 0
                content = month_name(ev_month.Get(id)) + " " + ev_day.Get(id) + ", " + ev_year.Get(id) + " at " + ev_time.Get(id)
            end
            button:
                id = "remove"
                padding = 8, 14
                radius = 10
                border = 0
                background = "#fde7e4"
                color = "#b42318"
                cursor = "pointer"
                click = ():
                    remove_event(id)
                    page.route.GoTo("/agenda")
                end
                content = "Delete event"
            end
        else:
            heading:
                size = 1
                content = "No such event"
            end
        end
        link:
            to = "/agenda"
            content = "Back to the agenda"
        end
    end
end
