pub component Home:
    title = "Month"
    box:
        layout = "row"
        gap = 16
        wrap = true
        box:
            grow = 2
            min width = 320
            MonthGrid: end
        end
        box:
            grow = 1
            min width = 260
            DayPanel: end
        end
    end
end
