pub component Controls:
    box:
        layout = "row"
        justify = "center"
        gap = 10
        if running:
            Action:
                name = "pause"
                label = "Pause"
                run = pause_timer
            end
        else:
            Action:
                name = "start"
                label = left == phase_len() ? "Start" : "Resume"
                run = start_timer
            end
        end
        Action:
            name = "reset"
            label = "Reset"
            run = reset_timer
        end
        Action:
            name = "skip"
            label = "Skip"
            run = skip_phase
        end
    end
end

component Action(name: str, label: str, run):
    button:
        id = name
        padding = 10, 22
        radius = 12
        border = 0
        background = "#2a2320"
        color = "#ffffff"
        font weight = 600
        cursor = "pointer"
        click = run
        content = label
    end
end
