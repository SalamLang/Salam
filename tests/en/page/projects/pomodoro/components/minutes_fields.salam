pub component FocusField(label: str, hint: str):
    label:
        gap = 4
        span:
            font weight = 600
            content = label
        end
        input:
            id = "focus"
            padding = 10, 12
            radius = 10
            border = 1, "solid", "#d9cfca"
            bind = focus_text
        end
        span:
            font size = 13
            opacity = 0.6
            content = hint
        end
    end
end

pub component BreakField(label: str, hint: str):
    label:
        gap = 4
        span:
            font weight = 600
            content = label
        end
        input:
            id = "break"
            padding = 10, 12
            radius = 10
            border = 1, "solid", "#d9cfca"
            bind = break_text
        end
        span:
            font size = 13
            opacity = 0.6
            content = hint
        end
    end
end
