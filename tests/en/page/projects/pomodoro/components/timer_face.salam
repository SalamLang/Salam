pub component TimerFace:
    box:
        gap = 6
        align = "center"
        padding = 28
        radius = 24
        background = "#ffffff"
        shadow = 0, 6, 24, "#2a232018"
        span:
            id = "phase"
            font size = 14
            font weight = 700
            letter spacing = 2
            transform text = "upper"
            content = resting ? "Break" : "Focus"
        end
        span:
            id = "clock"
            font size = 72
            font weight = 800
            font features = "tnum"
            content = clock_text(left)
        end
        progress:
            id = "bar"
            width = 100%
            max = phase_len()
            value = phase_len() - left
        end
    end
end
