pub component Shell:
    header:
        layout = "row"
        align = "center"
        justify = "center"
        gap = 8
        padding = 16
        ShellLink:
            dest = ""
            label = "Timer"
        end
        ShellLink:
            dest = "history"
            label = "History"
        end
        ShellLink:
            dest = "settings"
            label = "Settings"
        end
    end
    box:
        max width = 520
        margin = 0, "auto"
        padding = 12, 16
        gap = 16
        Outlet: end
    end
end

component ShellLink(dest: str, label: str):
    link:
        to = "/" + dest
        padding = 8, 16
        radius = 20
        decoration = "none"
        color = "#2a2320"
        if page.route.path == "/" + dest:
            background = "#2a2320"
            color = "#ffffff"
        end
        content = label
    end
end
