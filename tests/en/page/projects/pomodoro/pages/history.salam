pub component History:
    title = "History"
    heading:
        size = 1
        margin = 0
        content = "History"
    end
    paragraph:
        id = "total"
        margin = 0
        content = focus_total() + " focused minutes in " + focus_sessions() + " sessions"
    end
    if log_kind.Len() == 0:
        paragraph:
            class = "empty"
            opacity = 0.6
            content = "No sessions yet. Finish a focus period to see it here."
        end
    else:
        list:
            padding = 0
            margin = 0
            gap = 6
            each i, _ in log_kind:
                SessionRow:
                    key = i
                    at = i
                end
            end
        end
        button:
            id = "clear"
            padding = 8, 14
            radius = 10
            border = 1, "solid", "#d9cfca"
            background = "#ffffff"
            cursor = "pointer"
            click = clear_log
            content = "Clear history"
        end
    end
end
