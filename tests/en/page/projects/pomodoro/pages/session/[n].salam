pub component Session(n: int):
    title = "Session"
    box:
        gap = 8
        padding = 16
        radius = 14
        background = "#ffffff"
        if n < log_kind.Len():
            heading:
                size = 1
                margin = 0
                content = "Session " + (n + 1)
            end
            paragraph:
                id = "detail"
                margin = 0
                content = log_kind.Get(n) + ", " + log_mins.Get(n) + " minutes"
            end
        else:
            heading:
                size = 1
                content = "No such session"
            end
        end
        link:
            to = "/history"
            content = "Back to history"
        end
    end
end
