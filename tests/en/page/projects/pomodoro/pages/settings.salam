pub component Settings:
    title = "Settings"
    heading:
        size = 1
        margin = 0
        content = "Settings"
    end
    form:
        gap = 12
        submit = (e: i64):
            dom.PreventDefault(e)
            save_settings()
        end
        FocusField:
            label = "Focus minutes"
            hint = "Between 1 and 90"
        end
        BreakField:
            label = "Break minutes"
            hint = "Between 1 and 30"
        end
        button:
            id = "save"
            type = "submit"
            padding = 10, 18
            radius = 10
            border = 0
            background = "#2a2320"
            color = "#ffffff"
            cursor = "pointer"
            content = "Save"
        end
        if settings_note.Len() > 0:
            paragraph:
                id = "note"
                margin = 0
                role = "status"
                content = settings_note
            end
        end
    end
end
