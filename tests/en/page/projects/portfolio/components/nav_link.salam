pub component NavLink(path: str, label: str):
    link:
        to = path
        padding = 8, 14
        radius = 999
        color = #1b1d29
        text decoration = none
        hover:
            background = #eef0f7
        end
        if on_route(path):
            background = #eef0f7
            font weight = 700
        end
        content = label
    end
end
