pub component SiteNav:
    header:
        layout = row
        align = center
        justify = between
        wrap = true
        gap = 12
        padding = 16, 24
        border bottom = 1, solid, #e9eaf1
        background = #ffffff
        link:
            to = "/"
            font weight = 800
            font size = 20
            color = #1b1d29
            text decoration = none
            content = OWNER
        end
        nav:
            layout = row
            align = center
            gap = 8
            NavLink:
                path = "/"
                label = "Work"
            end
            NavLink:
                path = "/about"
                label = "About"
            end
            link:
                to = "/contact"
                padding = 8, 16
                radius = 999
                background = #1b1d29
                color = #ffffff
                text decoration = none
                font weight = 600
                content = "Contact"
            end
        end
    end
end
