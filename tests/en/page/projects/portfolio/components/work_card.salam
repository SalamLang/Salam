pub component WorkCard(at: int):
    article:
        radius = 18
        background = #ffffff
        border = 1, solid, #e9eaf1
        overflow = hidden
        transition = 180ms
        hover:
            translate = 0, -3
            shadow = 0, 14, 30, #1b1d2914
        end
        box:
            height = 120
            background = works().Get(at).colour
            align = center
            justify = center
            color = #ffffff
            font size = 30
            font weight = 800
            content = works().Get(at).title
        end
        box:
            padding = 16, 18
            gap = 4
            paragraph:
                margin = 0
                color = #6b7080
                font size = 13
                content = works().Get(at).kind + " / " + works().Get(at).year
            end
            paragraph:
                margin = 0
                content = works().Get(at).summary
            end
            link:
                to = "/work/" + at
                margin = 8, 0, 0, 0
                color = #1b1d29
                font weight = 600
                content = "View project"
            end
        end
    end
end
