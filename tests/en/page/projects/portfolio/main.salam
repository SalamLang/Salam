// EXPECT: <meta name="salam-router" content="history">
// EXPECT: Nora Hale
import dom

const OWNER := "Nora Hale"
const MIN_MESSAGE := 20

mut from_name := ""
mut from_email := ""
mut from_message := ""
mut tried := false

struct Work:
    pub title: str
    pub kind: str
    pub year: int
    pub colour: str
    pub summary: str
    pub story: str
end

func works(): Vector<Work>:
    mut v := Vector {} as Vector<Work>
    v.Push(Work {
        title = "Harbor"
        kind = "Mobile app"
        year = 2026
        colour = "#2563eb"
        summary = "A tide and weather companion for small boat owners."
        story = "Harbor started as a spreadsheet taped to a mast. I turned it into an app that shows the next tide, the wind and a short list of things to check before leaving the dock. The hardest part was deleting features until it fit in one thumb reach."
    })
    v.Push(Work {
        title = "Paperlane"
        kind = "Website"
        year = 2025
        colour = "#db2777"
        summary = "An online shop for a family run stationery studio."
        story = "Paperlane sells notebooks in small batches, so the shop had to feel handmade without being slow. We kept the catalogue to a single page, wrote every product description by hand and measured success by how many people came back for a second notebook."
    })
    v.Push(Work {
        title = "Quill"
        kind = "Design system"
        year = 2025
        colour = "#059669"
        summary = "A small set of components shared by four teams."
        story = "Quill is eleven components and a page of rules. It exists because four teams were building four different buttons. We wrote the rules together, kept the set small on purpose and removed anything that nobody used for a quarter."
    })
    v.Push(Work {
        title = "Lantern"
        kind = "Dashboard"
        year = 2024
        colour = "#d97706"
        summary = "Energy use at a glance for a community of 300 homes."
        story = "Lantern turns a long table of meter readings into one number and one colour. Residents told us they only ever wanted to know whether this week was better than the last, so that is the first thing the page says."
    })
    ret v
end

func work_count(): int:
    ret works().Len()
end

func name_error(): str:
    if from_name.Trim().Len() == 0:
        ret "Please tell me your name."
    end
    ret ""
end

func email_error(): str:
    if not from_email.Includes("@") or not from_email.Includes("."):
        ret "That does not look like an email address."
    end
    ret ""
end

func message_error(): str:
    if from_message.Trim().Len() < MIN_MESSAGE:
        ret "Write at least " + MIN_MESSAGE + " characters so I know how to help."
    end
    ret ""
end

func form_valid(): bool:
    ret name_error().Len() == 0 and email_error().Len() == 0 and message_error().Len() == 0
end

func on_route(target: str): bool:
    ret page.route.path == target
end

func send():
    tried = true
    if form_valid():
        page.route.GoTo("/thanks")
    end
end

func start_over():
    from_name = ""
    from_email = ""
    from_message = ""
    tried = false
    page.route.GoTo("/")
end

page:
    title = OWNER + ", designer"
    lang = "en"
    background = "#fbfbfd"
    color = "#1b1d29"
    font = "system-ui, sans-serif"
    line height = 1.6
    SiteNav: end
    main:
        max width = 960
        margin = 0, "auto"
        padding = 32, 24
        Outlet: end
    end
    footer:
        padding = 32, 24
        text align = "center"
        color = "#6b7080"
        font size = 14
        content = OWNER + ", available for projects from January"
    end
end
