pub component Missing:
    title = "Not found"
    box:
        gap = 12
        heading:
            size = 1
            content = "Nothing here"
        end
        paragraph:
            content = "The page you asked for does not exist."
        end
        link:
            to = "/"
            color = #4f46e5
            content = "See the work"
        end
    end
end
