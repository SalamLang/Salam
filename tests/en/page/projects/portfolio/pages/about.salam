pub component About:
    title = "About " + OWNER
    box:
        gap = 14
        max width = 640
        heading:
            size = 1
            margin = 0
            content = "About me"
        end
        paragraph:
            margin = 0
            content = "I am Nora, a designer who writes code. For ten years I have worked with small teams that want software to feel quiet and clear."
        end
        paragraph:
            margin = 0
            content = "I like projects with a real person on the other side of the screen: a boat owner, a stationery shop, a neighbour reading her electricity bill."
        end
        link:
            to = "/contact"
            color = "#4f46e5"
            font weight = 600
            content = "Tell me about your project"
        end
    end
end
