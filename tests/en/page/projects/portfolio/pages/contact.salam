pub component Contact:
    title = "Contact"
    box:
        gap = 16
        max width = 520
        heading:
            size = 1
            margin = 0
            content = "Let's talk"
        end
        form:
            novalidate = true
            gap = 14
            submit = (e: i64):
                dom.PreventDefault(e)
                send()
            end
            box:
                label:
                    for = "name"
                    font weight = 600
                    content = "Your name"
                end
                input:
                    id = "name"
                    width = 100%
                    padding = 11, 14
                    radius = 10
                    border = 1, solid, #cfd2de
                    font size = 16
                    autocomplete = name
                    bind = from_name
                end
                FieldError:
                    message = name_error()
                end
            end
            box:
                label:
                    for = "email"
                    font weight = 600
                    content = "Email"
                end
                input:
                    id = "email"
                    type = email
                    width = 100%
                    padding = 11, 14
                    radius = 10
                    border = 1, solid, #cfd2de
                    font size = 16
                    autocomplete = email
                    bind = from_email
                end
                FieldError:
                    message = email_error()
                end
            end
            box:
                label:
                    for = "message"
                    font weight = 600
                    content = "What are you working on?"
                end
                text area:
                    id = "message"
                    width = 100%
                    rows = 5
                    padding = 11, 14
                    radius = 10
                    border = 1, solid, #cfd2de
                    font size = 16
                    bind = from_message
                end
                paragraph:
                    margin = 4, 0, 0, 0
                    color = #6b7080
                    font size = 13
                    content = from_message.Trim().Len() + " of " + MIN_MESSAGE + " characters"
                end
                FieldError:
                    message = message_error()
                end
            end
            button:
                id = "send"
                type = submit
                padding = 12, 20
                radius = 12
                border = 0
                background = #4f46e5
                color = #ffffff
                font weight = 600
                font size = 16
                cursor = pointer
                content = "Send message"
            end
        end
    end
end
