pub component Home:
    title = OWNER + ", designer"
    box:
        gap = 28
        box:
            gap = 10
            max width = 620
            paragraph:
                margin = 0
                color = "#4f46e5"
                font weight = 700
                content = "Product designer and developer"
            end
            heading:
                size = 1
                margin = 0
                font size = 44
                line height = 1.15
                content = "I design calm software and build it myself."
            end
            paragraph:
                margin = 0
                color = "#4a4e60"
                font size = 18
                content = "Four recent projects, from a tide app to a design system. Each page tells how the work was done, not only how it looks."
            end
        end
        box:
            layout = "grid"
            columns = repeat (fit, minmax(220px, 1fr))
            gap = 20
            each i, _ in works():
                WorkCard:
                    key = i
                    at = i
                end
            end
        end
    end
end
