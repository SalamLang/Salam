pub component Thanks:
    title = "Thank you"
    box:
        gap = 14
        max width = 520
        heading:
            size = 1
            margin = 0
            content = "Thank you, " + from_name.Trim()
        end
        paragraph:
            margin = 0
            content = "Your message is on its way. I answer within two working days, at " + from_email + "."
        end
        button:
            id = "again"
            padding = 10, 18
            radius = 10
            border = 1, solid, #cfd2de
            background = #ffffff
            cursor = pointer
            click = start_over
            content = "Back to the work"
        end
    end
end
