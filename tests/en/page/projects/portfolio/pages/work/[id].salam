pub component WorkDetail(id: int):
    box:
        gap = 18
        max width = 720
        if id < work_count():
            link:
                to = "/"
                color = "#4f46e5"
                decoration = "none"
                content = "All work"
            end
            box:
                height = 200
                radius = 18
                background = works().Get(id).colour
                align = "center"
                justify = "center"
                color = "#ffffff"
                font size = 44
                font weight = 800
                content = works().Get(id).title
            end
            heading:
                size = 1
                margin = 0
                content = works().Get(id).title
            end
            paragraph:
                margin = 0
                color = "#6b7080"
                content = works().Get(id).kind + ", " + works().Get(id).year
            end
            paragraph:
                margin = 0
                font size = 18
                content = works().Get(id).story
            end
            box:
                layout = "row"
                gap = 12
                if id > 0:
                    link:
                        id = "prev"
                        to = "/work/" + (id - 1)
                        color = "#1b1d29"
                        content = "Previous: " + works().Get(id - 1).title
                    end
                end
                if id + 1 < work_count():
                    link:
                        id = "next"
                        to = "/work/" + (id + 1)
                        color = "#1b1d29"
                        content = "Next: " + works().Get(id + 1).title
                    end
                end
            end
        else:
            heading:
                size = 1
                content = "No such project"
            end
        end
    end
end
