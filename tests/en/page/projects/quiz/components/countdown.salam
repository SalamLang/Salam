pub component Countdown(remaining: int, total: int):
    box:
        gap = 4
        box:
            height = 8
            radius = 999
            background = "#e2e8f0"
            overflow = "hidden"
            box:
                class = "countdown-fill"
                height = 100%
                width = (remaining * 100 / total) + "%"
                background = #4f46e5
                if remaining <= 4:
                    background = #dc2626
                end
                transition = 900ms, linear
            end
        end
        small:
            id = "seconds"
            opacity = 0.7
            content = remaining + " s left"
        end
    end
end
