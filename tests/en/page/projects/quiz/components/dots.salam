pub component Dots(reached: int):
    box:
        layout = row
        gap = 6
        each dot in QUESTIONS:
            box:
                class = "dot"
                width = 12
                height = 12
                radius = 50%
                background = #cbd5e1
                if dot < reached:
                    background = #4f46e5
                end
                if dot == reached:
                    background = #f59e0b
                end
            end
        end
    end
end
