// EXPECT: <meta name="salam-router" content="history">
// EXPECT: "/quiz/:num"
// EXPECT: "/results"
import dom

const QUESTIONS := [0, 1, 2, 3, 4, 5]
const TIME_LIMIT := 12

mut picks := fresh_picks()
mut cur_q := 0
mut seconds_left := TIME_LIMIT
mut ticker := 0 as i64
mut running := false
mut player := ""

func fresh_picks(): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat 6:
        out.Push(-1)
    end
    ret out
end

pure func prompt_of(quest: int): str:
    if quest == 0:
        ret "Which element is the largest heading?"
    else quest == 1:
        ret "Which attribute gives an image its text alternative?"
    else quest == 2:
        ret "Which event fires on every keystroke in a field?"
    else quest == 3:
        ret "Which layout value places children in a line?"
    else quest == 4:
        ret "What does a dynamic route file look like?"
    end
    ret "Which file shows a page for unknown addresses?"
end

pure func choice_of(quest: int, opt: int): str:
    if quest == 0:
        ret opt == 0 ? "h6" : (opt == 1 ? "h1" : (opt == 2 ? "header" : "title"))
    else quest == 1:
        ret opt == 0 ? "src" : (opt == 1 ? "title" : (opt == 2 ? "alt" : "href"))
    else quest == 2:
        ret opt == 0 ? "input" : (opt == 1 ? "load" : (opt == 2 ? "click" : "scroll"))
    else quest == 3:
        ret opt == 0 ? "stack" : (opt == 1 ? "grid" : (opt == 2 ? "flow" : "row"))
    else quest == 4:
        ret opt == 0 ? "route.salam" : (opt == 1 ? "[id].salam" : (opt == 2 ? "id.salam" : "dynamic.salam"))
    end
    ret opt == 0 ? "_404.salam" : (opt == 1 ? "missing.salam" : (opt == 2 ? "error.salam" : "index.salam"))
end

pure func solution_of(quest: int): int:
    if quest == 0:
        ret 1
    else quest == 1:
        ret 2
    else quest == 2:
        ret 0
    else quest == 3:
        ret 3
    else quest == 4:
        ret 1
    end
    ret 0
end

pure func mark_of(quest: int, opt: int): int:
    if picks[quest] < 0:
        ret 0
    end
    if opt == solution_of(quest):
        ret 1
    end
    if opt == picks[quest]:
        ret 2
    end
    ret 0
end

pure func score(): int:
    mut total := 0
    each reached, picked in picks:
        if picked == solution_of(reached):
            total++
        end
    end
    ret total
end

pure func answered(): int:
    mut total := 0
    each picked in picks:
        if picked >= 0:
            total++
        end
    end
    ret total
end

pure func verdict(): str:
    points := score()
    if points == 6:
        ret "Perfect"
    else points >= 4:
        ret "Well done"
    else points >= 2:
        ret "Getting there"
    end
    ret "Keep practising"
end

func tick():
    if seconds_left > 0:
        seconds_left--
    end
    if seconds_left == 0 and picks[cur_q] < 0:
        picks[cur_q] = 9
    end
end

func halt_clock():
    if running:
        dom.ClearInterval(ticker)
        running = false
    end
end

func begin():
    picks = fresh_picks()
    cur_q = 0
    seconds_left = TIME_LIMIT
    if not running:
        ticker = dom.SetInterval((): tick() end, 1000)
        running = true
    end
    page.route.GoTo("/quiz/0")
end

func choose(quest: int, opt: int):
    if quest >= 0 and quest < 6 and picks[quest] < 0:
        picks[quest] = opt
    end
end

func go_next(quest: int):
    if quest + 1 >= 6:
        halt_clock()
        page.route.GoTo("/results")
    else:
        cur_q = quest + 1
        seconds_left = TIME_LIMIT
        page.route.GoTo("/quiz/" + (quest + 1))
    end
end

func quiz_key(ev: i64):
    key := dom.EventKey(ev)
    if key == "1":
        choose(cur_q, 0)
    else key == "2":
        choose(cur_q, 1)
    else key == "3":
        choose(cur_q, 2)
    else key == "4":
        choose(cur_q, 3)
    else key == "Enter" and picks[cur_q] >= 0:
        go_next(cur_q)
    end
end

pub component Choice(quest: int, opt: int, label: str, mark: int):
    button:
        class = "choice"
        width = fill
        margin = 5, 0
        padding = 12, 16
        text align = start
        font size = 16
        radius = 10
        border = 1, solid, #cbd5e1
        background = #ffffff
        cursor = pointer
        hover:
            background = #eef2ff
        end
        if mark == 1:
            background = #dcfce7
            border = 1, solid, #16a34a
        end
        if mark == 2:
            background = #fee2e2
            border = 1, solid, #dc2626
        end
        click = ():
            choose(quest, opt)
        end
        content = (opt + 1) + ". " + label
    end
end

page:
    title = "Quizzy"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = #f1f5f9
        color = #0f172a
        header:
            layout = row
            align = center
            justify = between
            padding = 14, 24
            background = #4f46e5
            link:
                to = "/"
                font size = 22
                font weight = 800
                color = #ffffff
                text decoration = none
                content = "quizzy"
            end
            paragraph:
                id = "status"
                margin = 0
                color = #e0e7ff
                content = answered() + " of 6 answered"
            end
        end
        main:
            max width = 620
            width = 100%
            margin = 0, auto
            padding = 24, 16
            Outlet: end
        end
    end
end
