pub component Welcome:
    title = "Quizzy"
    box:
        gap = 14
        heading:
            size = 1
            margin = 0
            content = "Web basics quiz"
        end
        paragraph:
            margin = 0
            content = "Six questions, " + TIME_LIMIT + " seconds each. Press 1 to 4 to answer and Enter for the next question."
        end
        label:
            gap = 6
            span:
                content = "Your name"
            end
            input:
                id = "player"
                padding = 10, 14
                radius = 10
                border = 1, solid, #cbd5e1
                font size = 16
                placeholder = "Anonymous"
                bind = player
            end
        end
        button:
            id = "start"
            padding = 12, 24
            radius = 10
            border = 0
            background = "#4f46e5"
            color = "#ffffff"
            font weight = 700
            cursor = "pointer"
            click = begin
            content = "Start the quiz"
        end
    end
end
