pub component Question(num: int):
    title = "Question " + (num + 1)
    box:
        key down = quiz_key
        tab index = 0
        id = "quiz-box"
        gap = 12
        if num >= 0 and num < 6:
            box:
                layout = row
                align = center
                justify = between
                Dots:
                    reached = num
                end
                small:
                    id = "counter"
                    content = "Question " + (num + 1) + " of 6"
                end
            end
            if picks[num] < 0 and num == cur_q:
                Countdown:
                    remaining = seconds_left
                    total = TIME_LIMIT
                end
            end
            heading:
                id = "prompt"
                size = 2
                margin = 0
                content = prompt_of(num)
            end
            each opt in [0, 1, 2, 3]:
                Choice:
                    quest = num
                    opt = opt
                    label = choice_of(num, opt)
                    mark = mark_of(num, opt)
                end
            end
            if picks[num] >= 0:
                paragraph:
                    id = "feedback"
                    margin = 0
                    font weight = 600
                    content = (picks[num] == 9) ? "Time is up. The right answer is marked." : ((picks[num] == solution_of(num)) ? "Correct" : "Not quite")
                end
                button:
                    id = "next"
                    padding = 10, 22
                    radius = 10
                    border = 0
                    background = #4f46e5
                    color = #ffffff
                    cursor = pointer
                    click = ():
                        go_next(num)
                    end
                    content = (num == 5) ? "See results" : "Next question"
                end
            end
        else:
            heading:
                size = 2
                content = "No such question"
            end
            link:
                to = "/"
                content = "Back to the start"
            end
        end
    end
end
