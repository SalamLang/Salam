pub component Results:
    title = "Results"
    box:
        gap = 12
        if answered() < 6:
            heading:
                size = 2
                margin = 0
                content = "The quiz is not finished"
            end
            link:
                to = "/"
                content = "Start over"
            end
        else:
            heading:
                id = "final"
                size = 1
                margin = 0
                content = (player.Len() > 0 ? player : "You") + " scored " + score() + " of 6"
            end
            paragraph:
                id = "verdict"
                margin = 0
                font size = 20
                content = verdict()
            end
            list:
                padding = 0
                each reached, picked in picks:
                    item:
                        class = "review"
                        padding = 8, 12
                        margin = 4, 0
                        radius = 8
                        background = "#ffffff"
                        content = (picked == solution_of(reached) ? "Right: " : "Wrong: ") + prompt_of(reached)
                    end
                end
            end
            box:
                layout = "row"
                gap = 10
                button:
                    id = "retry"
                    padding = 10, 22
                    radius = 10
                    border = 0
                    background = "#4f46e5"
                    color = "#ffffff"
                    cursor = "pointer"
                    click = begin
                    content = "Try again"
                end
                link:
                    to = "/"
                    padding = 10, 22
                    color = "#4f46e5"
                    content = "Back to the start"
                end
            end
        end
    end
end
