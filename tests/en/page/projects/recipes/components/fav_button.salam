pub component FavButton(recipe: int):
    button:
        class = "fav"
        padding = 4, 10
        radius = 999
        border = 1, "solid", "#f0e4d2"
        background = transparent
        font size = 18
        cursor = "pointer"
        aria label = is_favourite(recipe) ? "Remove from favourites" : "Add to favourites"
        if is_favourite(recipe):
            background = #fee2e2
            border = 1, "solid", "#fca5a5"
        end
        click = (): toggle_favourite(recipe) end
        content = is_favourite(recipe) ? "♥" : "♡"
    end
end
