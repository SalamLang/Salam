pub component NavPill(path: str, label: str):
    link:
        to = path
        padding = 7, 14
        radius = 999
        color = #3a2a1a
        text decoration = none
        hover:
            background = #fdebd3
        end
        if on_route(path):
            background = #fdebd3
            font weight = 700
        end
        content = label
    end
end
