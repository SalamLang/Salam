pub component RecipeCard(recipe: int):
    article:
        padding = 18
        radius = 16
        background = "#ffffff"
        border = 1, "solid", "#f0e4d2"
        gap = 8
        transition = 160ms
        hover:
            translate = 0, -2
            shadow = 0, 12, 26, #3a2a1a14
        end
        box:
            layout = "row"
            justify = "between"
            align = "center"
            span:
                font size = 40
                content = recipe_emoji(recipe)
            end
            FavButton:
                recipe = recipe
            end
        end
        h2:
            margin = 0
            font size = 20
            link:
                to = "/recipe/" + recipe
                color = "#3a2a1a"
                decoration = "none"
                content = recipe_title(recipe)
            end
        end
        paragraph:
            margin = 0
            color = "#8a7358"
            font size = 14
            content = recipe_line(recipe)
        end
    end
end
