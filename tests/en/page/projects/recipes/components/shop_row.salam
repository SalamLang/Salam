pub component ShopRow(entry: str):
    held := entry
    item:
        key = entry
        layout = "row"
        align = "center"
        gap = 10
        padding = 10, 14
        radius = 10
        background = "#ffffff"
        border = 1, "solid", "#f0e4d2"
        button:
            class = "tick"
            border = 0
            background = "transparent"
            padding = 0
            font size = 20
            cursor = "pointer"
            role = "checkbox"
            aria checked = is_ticked(entry)
            aria label = entry
            click = (): toggle_tick(held) end
            content = is_ticked(entry) ? "☑" : "☐"
        end
        span:
            color = is_ticked(entry) ? "#b8a58a" : "#3a2a1a"
            decoration = is_ticked(entry) ? "strike" : "none"
            content = entry
        end
    end
end
