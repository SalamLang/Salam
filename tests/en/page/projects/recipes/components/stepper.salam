pub component Stepper:
    box:
        layout = "row"
        align = "center"
        gap = 10
        span:
            font weight = 600
            content = "Servings"
        end
        button:
            id = "less"
            width = 34
            height = 34
            radius = 999
            border = 1, "solid", "#e4d3b8"
            background = "#ffffff"
            cursor = "pointer"
            aria label = "Fewer servings"
            click = fewer_servings
            content = "-"
        end
        span:
            id = "servings"
            min width = 28
            text align = "center"
            font size = 18
            font weight = 700
            aria live = "polite"
            content = servings
        end
        button:
            id = "more"
            width = 34
            height = 34
            radius = 999
            border = 1, "solid", "#e4d3b8"
            background = "#ffffff"
            cursor = "pointer"
            aria label = "More servings"
            click = more_servings
            content = "+"
        end
    end
end
