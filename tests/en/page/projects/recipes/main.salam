// EXPECT: var __salam_rt_hash = true
// EXPECT: Pantry
const BRAND := "Pantry"

mut servings := 4
mut favourites := Vector {} as Vector<int>
mut shopping := Vector {} as Vector<str>
mut ticked := Vector {} as Vector<str>

struct Recipe:
    pub title: str
    pub emoji: str
    pub minutes: int
    pub base: int
    pub ingredients: str
    pub steps: str
end

func recipes(): Vector<Recipe>:
    mut v := Vector {} as Vector<Recipe>
    v.Push(Recipe {
        title = "Lentil soup"
        emoji = "🍲"
        minutes = 35
        base = 4
        ingredients = "300|g|red lentils\n2|pcs|carrots\n1|pcs|onion\n1.5|l|water\n2|tbsp|olive oil"
        steps = "Fry the chopped onion in the oil.\nAdd the carrots and lentils.\nPour in the water and simmer for 20 minutes.\nBlend half and season well."
    })
    v.Push(Recipe {
        title = "Flatbread"
        emoji = "🫓"
        minutes = 45
        base = 6
        ingredients = "500|g|flour\n300|ml|warm water\n1|tsp|salt\n1|tbsp|yeast"
        steps = "Mix everything into a soft dough.\nRest it for 30 minutes.\nRoll thin and cook in a hot dry pan."
    })
    v.Push(Recipe {
        title = "Tomato pasta"
        emoji = "🍝"
        minutes = 20
        base = 2
        ingredients = "200|g|spaghetti\n400|g|tomatoes\n2|pcs|garlic cloves\n3|tbsp|olive oil"
        steps = "Boil the pasta in salted water.\nCook the garlic and tomatoes into a sauce.\nToss together with a splash of pasta water."
    })
    v.Push(Recipe {
        title = "Berry porridge"
        emoji = "🥣"
        minutes = 10
        base = 1
        ingredients = "50|g|oats\n250|ml|milk\n100|g|berries\n1|tsp|honey"
        steps = "Heat the oats and milk until thick.\nTop with berries and honey."
    })
    ret v
end

func recipe_emoji(at: int): str:
    ret recipes().Get(at).emoji
end

func recipe_title(at: int): str:
    ret recipes().Get(at).title
end

func recipe_line(at: int): str:
    r := recipes().Get(at)
    ret r.minutes + " min, serves " + r.base
end

func on_route(target: str): bool:
    ret page.route.path == target
end

func part(line: str, at: int): str:
    ret line.Split("|").Get(at)
end

func ingredient_lines(id: int): Vector<str>:
    ret recipes().Get(id).ingredients.Split("\n")
end

func step_lines(id: int): Vector<str>:
    ret recipes().Get(id).steps.Split("\n")
end

func scaled(line: str, id: int): f64:
    ret part(line, 0).ToFloat() * servings / recipes().Get(id).base
end

func show_number(x: f64): str:
    tenths := (x * 10 + 0.5) as int
    whole := tenths / 10
    rest := tenths % 10
    if rest == 0:
        ret "" + whole
    end
    ret whole + "." + rest
end

func ingredient_text(line: str, id: int): str:
    ret show_number(scaled(line, id)) + " " + part(line, 1) + " " + part(line, 2)
end

func is_favourite(id: int): bool:
    each f in favourites:
        if f == id:
            ret true
        end
    end
    ret false
end

func toggle_favourite(id: int):
    if is_favourite(id):
        mut keep := Vector {} as Vector<int>
        each f in favourites:
            if f != id:
                keep.Push(f)
            end
        end
        favourites = keep
    else:
        favourites.Push(id)
    end
end

func more_servings():
    if servings < 12:
        servings++
    end
end

func fewer_servings():
    if servings > 1:
        servings--
    end
end

func add_to_shopping(id: int):
    each line in ingredient_lines(id):
        shopping.Push(ingredient_text(line, id))
    end
end

func is_ticked(item: str): bool:
    each t in ticked:
        if t == item:
            ret true
        end
    end
    ret false
end

func toggle_tick(item: str):
    if is_ticked(item):
        mut keep := Vector {} as Vector<str>
        each t in ticked:
            if t != item:
                keep.Push(t)
            end
        end
        ticked = keep
    else:
        ticked.Push(item)
    end
end

func clear_shopping():
    shopping = Vector {} as Vector<str>
    ticked = Vector {} as Vector<str>
end

page:
    mode = "hash"
    title = BRAND
    lang = "en"
    background = "#fffaf2"
    color = "#3a2a1a"
    font family = "system-ui, sans-serif"
    line height = 1.55
    header:
        layout = "row"
        align = "center"
        justify = "between"
        wrap = true
        gap = 10
        padding = 14, 24
        background = "#ffffff"
        border bottom = 1, "solid", "#f0e4d2"
        link:
            to = "/"
            font size = 22
            font weight = 800
            color = "#c2410c"
            text decoration = "none"
            content = BRAND
        end
        nav:
            layout = "row"
            gap = 8
            NavPill:
                path = "/"
                label = "Recipes"
            end
            NavPill:
                path = "/favourites"
                label = "Favourites (" + favourites.Len() + ")"
            end
            NavPill:
                path = "/shopping"
                label = "Shopping (" + shopping.Len() + ")"
            end
        end
    end
    main:
        max width = 900
        margin = 0, "auto"
        padding = 28, 20
        Outlet: end
    end
end
