pub component Favourites:
    title = "Favourites"
    box:
        gap = 18
        heading:
            size = 1
            margin = 0
            content = "Your favourites"
        end
        if favourites.Len() == 0:
            paragraph:
                id = "no-favourites"
                color = "#8a7358"
                content = "Nothing here yet. Tap the heart on a recipe to keep it close."
            end
        else:
            box:
                layout = "grid"
                columns = repeat (fit, minmax(240px, 1fr))
                gap = 16
                each _, f in favourites:
                    RecipeCard:
                        recipe = f
                    end
                end
            end
        end
    end
end
