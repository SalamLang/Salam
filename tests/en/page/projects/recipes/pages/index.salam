pub component Home:
    title = BRAND
    box:
        gap = 18
        heading:
            size = 1
            margin = 0
            content = "Weeknight recipes"
        end
        paragraph:
            margin = 0
            color = "#8a7358"
            content = "Pick one, set how many you are cooking for, and the amounts follow."
        end
        box:
            layout = "grid"
            columns = repeat (fit, minmax(240px, 1fr))
            gap = 16
            each i, _ in recipes():
                RecipeCard:
                    key = i
                    recipe = i
                end
            end
        end
    end
end
