pub component RecipePage(id: int):
    box:
        gap = 16
        if id < recipes().Len():
            link:
                to = "/"
                color = "#c2410c"
                decoration = "none"
                content = "All recipes"
            end
            box:
                layout = "row"
                align = "center"
                justify = "between"
                heading:
                    size = 1
                    margin = 0
                    content = recipes().Get(id).emoji + " " + recipes().Get(id).title
                end
                FavButton:
                    recipe = id
                end
            end
            paragraph:
                margin = 0
                color = "#8a7358"
                content = recipes().Get(id).minutes + " minutes. The amounts below are for " + servings + " servings."
            end
            Stepper: end
            h2:
                margin = 8, 0, 0, 0
                font size = 20
                content = "Ingredients"
            end
            list:
                id = "ingredients"
                margin = 0
                each i, line in ingredient_lines(id):
                    item:
                        key = i
                        padding = 4, 0
                        content = ingredient_text(line, id)
                    end
                end
            end
            button:
                id = "to-shopping"
                padding = 10, 16
                radius = 10
                border = 0
                background = "#c2410c"
                color = "#ffffff"
                font weight = 600
                cursor = "pointer"
                click = (): add_to_shopping(id) end
                content = "Add to shopping list"
            end
            h2:
                margin = 8, 0, 0, 0
                font size = 20
                content = "Method"
            end
            ordered list:
                margin = 0
                each i, s in step_lines(id):
                    item:
                        key = i
                        padding = 4, 0
                        content = s
                    end
                end
            end
        else:
            heading:
                size = 1
                content = "No such recipe"
            end
        end
    end
end
