pub component Shopping:
    title = "Shopping list"
    box:
        gap = 16
        max width = 560
        heading:
            size = 1
            margin = 0
            content = "Shopping list"
        end
        if shopping.Len() == 0:
            paragraph:
                id = "empty-list"
                color = #8a7358
                content = "The list is empty. Add the ingredients of a recipe from its page."
            end
        else:
            list:
                id = "shopping-items"
                margin = 0
                padding = 0
                gap = 6
                each s in shopping:
                    ShopRow:
                        entry = s
                    end
                end
            end
            button:
                id = "clear"
                padding = 9, 16
                radius = 10
                border = 1, solid, #e4d3b8
                background = #ffffff
                cursor = pointer
                click = clear_shopping
                content = "Clear the list"
            end
        end
    end
end
