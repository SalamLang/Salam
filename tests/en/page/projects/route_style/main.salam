// EXPECT: href="#b"
component NavLink(to_path: str, label: str):
    link:
        to = to_path
        content = label
        color = "#333333"
        if page.route.path == "/" + to_path:
            color = "#ff0000"
        end
    end
end

page:
    mode = "hash"
    nav:
        NavLink:
            to_path = "a"
            label = "A"
        end
        NavLink:
            to_path = "b"
            label = "B"
        end
        NavLink:
            to_path = "c"
            label = "C"
        end
    end
    Outlet: end
end
