pub component Badge(level: str):
    span:
        align self = "start"
        padding = 2, 10
        radius = 20
        font size = 13
        font weight = 600
        background = #cfe8cf
        color = #174d26
        if level == "Moderate":
            background = #f5e3b3
            color = #6a4b00
        end
        if level == "Hard":
            background = #f2c9c3
            color = #7a1f12
        end
        content = level
    end
end
