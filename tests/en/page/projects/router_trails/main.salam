// EXPECT: <meta name="salam-router" content="history">
// EXPECT: function __salam_route_pick(
// EXPECT: history.pushState(
// EXPECT: Trailhead
// EXPECT: aria-current
// EXPECT: No such trail.
// EXPECT: segment(s) under /help
// EXPECT: result(s) for
// EXPECT: data-route
import dom

mut signed_in := false
mut recent := Vector {} as Vector<str>

pure func region_name(r: str): str:
    if r == "alps":
        ret "The Alps"
    else r == "dolomites":
        ret "Dolomites"
    else r == "pyrenees":
        ret "Pyrenees"
    end
    ret ""
end

func trails_of(r: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    if r == "alps":
        v.Push("eiger-trail")
        v.Push("matterhorn-loop")
    else r == "dolomites":
        v.Push("cinque-torri")
        v.Push("seceda-ridge")
    else r == "pyrenees":
        v.Push("aneto-base")
    end
    ret v
end

pure func trail_title(t: str): str:
    if t == "eiger-trail":
        ret "Eiger Trail"
    else t == "matterhorn-loop":
        ret "Matterhorn Loop"
    else t == "cinque-torri":
        ret "Five Towers Loop"
    else t == "seceda-ridge":
        ret "Seceda Ridge"
    else t == "aneto-base":
        ret "Aneto Base Camp"
    end
    ret ""
end

pure func trail_km(t: str): int:
    if t == "eiger-trail":
        ret 6
    else t == "matterhorn-loop":
        ret 14
    else t == "cinque-torri":
        ret 10
    else t == "seceda-ridge":
        ret 9
    else t == "aneto-base":
        ret 17
    end
    ret 0
end

pure func trail_level(t: str): str:
    if trail_km(t) >= 14:
        ret "Hard"
    else trail_km(t) >= 9:
        ret "Moderate"
    end
    ret "Easy"
end

func visit(t: str):
    if recent.Len() == 0 or recent[recent.Len() - 1] != t:
        recent.Push(t)
    end
end

func all_regions(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("alps")
    v.Push("dolomites")
    v.Push("pyrenees")
    ret v
end

func matches(q: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    needle := q.Lower()
    each r in all_regions():
        each t in trails_of(r):
            if needle.Len() > 0 and trail_title(t).Lower().Includes(needle):
                out.Push(r + "/" + t)
            end
        end
    end
    ret out
end

func sign_out():
    signed_in = false
    page.route.GoTo("/")
end

func is_here(prefix: str): bool:
    ret page.route.path == prefix or page.route.path.StartsWith(prefix + "/")
end

pub component NavLink(slug: str, label: str, active: bool):
    link:
        to = "/" + slug
        padding = 8, 14
        radius = 10
        color = "#d8e8d8"
        decoration = "none"
        hover:
            background = "#2d6a42"
        end
        if active:
            background = "#ffffff"
            color = "#1f4d2e"
            font weight = 700
        end
        content = label
    end
end

pub component TrailCard(region: str, trail: str):
    link:
        to = "/guides/" + region + "/" + trail
        layout = "column"
        gap = 4
        padding = 16
        radius = 14
        background = "#ffffff"
        color = "#1b2a1f"
        decoration = "none"
        border = 1, "solid", "#d5e0d3"
        transition = 160ms
        hover:
            shadow = 0, 6, 18, "#1f4d2e33"
        end
        if page.dark:
            background = "#1b261d"
            color = "#e6efe6"
            border = 1, "solid", "#2c3d2f"
        end
        strong:
            content = trail_title(trail)
        end
        small:
            opacity = 0.75
            content = region_name(region) + ", " + trail_km(trail) + " km"
        end
        Badge:
            level = trail_level(trail)
        end
    end
end

pub component Crumbs(region: str, trail: str):
    nav:
        layout = "row"
        gap = 8
        font size = 14
        opacity = 0.85
        link:
            to = "/guides"
            content = "Guides"
        end
        span:
            content = "/"
        end
        link:
            to = "/guides/" + region
            content = region_name(region)
        end
        if trail != "":
            span:
                content = "/"
            end
            span:
                content = trail_title(trail)
            end
        end
    end
end

page:
    title = "Trailhead"
    lang = "en"
    font = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = "#f4f7f2"
        color = "#1b2a1f"
        if page.dark:
            background = #101712
            color = #e6efe6
        end
        header:
            layout = "row"
            align = "center"
            gap = 18
            padding = 14, 28
            background = "#1f4d2e"
            link:
                to = "/"
                color = "#ffffff"
                font size = 22
                font weight = 800
                decoration = "none"
                content = "Trailhead"
            end
            nav:
                layout = "row"
                gap = 6
                grow = 1
                NavLink:
                    slug = "guides"
                    active = is_here("/guides")
                    label = "Guides"
                end
                NavLink:
                    slug = "search"
                    active = is_here("/search")
                    label = "Search"
                end
                NavLink:
                    slug = "help/start/first-hike"
                    active = is_here("/help/start/first-hike")
                    label = "Help"
                end
            end
            if signed_in:
                NavLink:
                    slug = "account"
                    active = is_here("/account")
                    label = "My account"
                end
                button:
                    id = "signout"
                    padding = 6, 12
                    radius = 8
                    border = 0
                    background = "#d8e8d8"
                    click = sign_out
                    content = "Sign out"
                end
            else:
                NavLink:
                    slug = "login"
                    active = is_here("/login")
                    label = "Sign in"
                end
            end
        end
        main:
            max width = 980
            margin = 0, "auto"
            padding = 28
            Outlet: end
        end
        footer:
            padding = 20, 28
            text align = "center"
            opacity = 0.7
            content = "Trailhead, " + recent.Len() + " trails opened this visit"
        end
    end
end
