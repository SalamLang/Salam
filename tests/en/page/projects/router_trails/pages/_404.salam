pub component NotFound:
    title = "Not found"
    box:
        gap = 12
        heading:
            size = 1
            content = "No trail here"
        end
        paragraph:
            content = "This path leads nowhere: " + page.route.path
        end
        link:
            to = "/guides"
            color = #1f6b3a
            content = "Browse all guides"
        end
    end
end
