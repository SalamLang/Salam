pub component AccountLayout:
    page.Guard(signed_in)
    box:
        layout = row
        gap = 24
        nav:
            width = 180
            gap = 6
            NavLink:
                slug = "account"
                active = is_here("/account")
                label = "Overview"
            end
            NavLink:
                slug = "account/history"
                active = is_here("/account/history")
                label = "History"
            end
        end
        box:
            grow = 1
            Outlet: end
        end
    end
end
