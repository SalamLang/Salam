pub component AccountHistory:
    title = "History"
    box:
        gap = 10
        heading:
            size = 1
            content = "Recently opened"
        end
        if recent.Len() == 0:
            paragraph:
                content = "Nothing yet."
            end
        end
        list:
            each i, t in recent:
                item:
                    key = i
                    content = trail_title(t)
                end
            end
        end
    end
end
