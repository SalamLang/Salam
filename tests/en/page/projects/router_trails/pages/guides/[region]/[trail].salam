pub component TrailPage(region: str, trail: str):
    title = trail_title(trail)
    box:
        gap = 12
        if trail_title(trail) != "" and region_name(region) != "":
            Crumbs:
                region = region
                trail = trail
            end
            heading:
                size = 1
                content = trail_title(trail)
            end
            box:
                layout = row
                gap = 10
                align = center
                Badge:
                    level = trail_level(trail)
                end
                span:
                    id = "km"
                    content = trail_km(trail) + " km"
                end
            end
            button:
                id = "mark"
                align self = start
                padding = 10, 18
                radius = 10
                border = 0
                background = #1f4d2e
                color = #ffffff
                click = (): visit(trail) end
                content = "Mark as opened"
            end
            button:
                id = "next"
                align self = start
                padding = 8, 14
                radius = 10
                border = 1, solid, #b9cbb7
                background = transparent
                click = (): page.route.GoTo("/guides/" + region) end
                content = "More in " + region_name(region)
            end
        else:
            paragraph:
                content = "No such trail."
            end
        end
    end
end
