pub component RegionPage(region: str):
    title = region_name(region)
    box:
        gap = 12
        if region_name(region) != "":
            Crumbs:
                region = region
                trail = ""
            end
            heading:
                size = 1
                content = region_name(region)
            end
            box:
                layout = "grid"
                columns = "repeat(fill, minmax(200, 1fr))"
                gap = 10
                each _, t in trails_of(region):
                    TrailCard:
                        region = region
                        trail = t
                    end
                end
            end
        else:
            paragraph:
                content = "No such trail."
            end
        end
    end
end
