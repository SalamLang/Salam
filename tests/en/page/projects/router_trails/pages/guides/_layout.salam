pub component GuidesLayout:
    box:
        layout = "row"
        gap = 28
        wrap = true
        nav:
            width = 200
            gap = 6
            strong:
                content = "Regions"
            end
            each i, r in all_regions():
                NavLink:
                    key = i
                    slug = "guides/" + r
                    active = is_here("/guides/" + r)
                    label = region_name(r)
                end
            end
        end
        box:
            grow = 1
            min width = 280
            Outlet: end
        end
    end
end
