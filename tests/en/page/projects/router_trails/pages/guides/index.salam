pub component GuidesHome:
    title = "Guides"
    box:
        gap = 12
        heading:
            size = 1
            content = "All guides"
        end
        each i, r in all_regions():
            box:
                key = i
                gap = 8
                heading:
                    size = 3
                    content = region_name(r)
                end
                box:
                    layout = "grid"
                    columns = "repeat(fill, minmax(200, 1fr))"
                    gap = 10
                    each k, t in trails_of(r):
                        TrailCard:
                            key = k
                            region = r
                            trail = t
                        end
                    end
                end
            end
        end
    end
end
