pub component Help(rest: str):
    title = "Help"
    parts := rest.Split("/")
    box:
        gap = 10
        heading:
            size = 1
            content = "Help: " + rest
        end
        paragraph:
            id = "depth"
            content = parts.Len() + " segment(s) under /help"
        end
        link:
            to = "/help/start/first-hike"
            content = "Your first hike"
        end
        link:
            to = "/help/gear/boots/fit"
            content = "Fitting boots"
        end
    end
end
