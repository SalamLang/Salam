pub component Home:
    title = "Trailhead"
    q := ""
    box:
        gap = 20
        heading:
            size = 1
            content = "Find your next hike"
        end
        paragraph:
            max width = 560
            content = "Guides for " + all_regions().Len() + " mountain regions, with distances and difficulty."
        end
        form:
            layout = row
            gap = 8
            submit = (e: i64):
                dom.PreventDefault(e)
                page.route.GoTo("/search?q=" + q)
            end
            input:
                id = "q"
                type = search
                placeholder = "Search trails"
                padding = 10, 14
                radius = 10
                border = 1, solid, #b9cbb7
                bind = q
            end
            button:
                id = "go"
                type = submit
                padding = 10, 18
                radius = 10
                border = 0
                background = #1f4d2e
                color = #ffffff
                content = "Search"
            end
        end
        box:
            layout = grid
            columns = "repeat(fill, minmax(220, 1fr))"
            gap = 14
            each r in all_regions():
                TrailCard:
                    region = r
                    trail = trails_of(r)[0]
                end
            end
        end
    end
end
