pub component Login:
    title = "Sign in"
    box:
        gap = 12
        max width = 360
        heading:
            size = 1
            content = "Sign in"
        end
        paragraph:
            content = "The account area is only open when you are signed in."
        end
        button:
            id = "signin"
            padding = 10, 18
            radius = 10
            border = 0
            background = "#1f4d2e"
            color = "#ffffff"
            click = ():
                signed_in = true
                page.route.Redirect("/account")
            end
            content = "Sign in as Ada"
        end
        button:
            id = "back"
            padding = 8, 14
            radius = 10
            border = 1, solid, #b9cbb7
            background = "transparent"
            click = (): page.route.Back() end
            content = "Go back"
        end
    end
end
