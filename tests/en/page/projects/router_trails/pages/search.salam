pub component Search:
    title = "Search"
    q := ""
    box:
        gap = 14
        heading:
            size = 1
            content = "Search"
        end
        input:
            id = "term"
            type = "search"
            placeholder = "Trail name"
            padding = 10, 14
            radius = 10
            border = 1, "solid", "#b9cbb7"
            value = page.route.Query("q")
            input = (v: str): q = v end
        end
        button:
            id = "apply"
            padding = 8, 16
            radius = 10
            border = 0
            background = "#1f4d2e"
            color = "#ffffff"
            click = (): page.route.Redirect("/search?q=" + q) end
            content = "Apply"
        end
        if page.route.Query("q") == "":
            paragraph:
                content = "Type part of a trail name."
            end
        else:
            paragraph:
                id = "count"
                content = matches(page.route.Query("q")).Len() + " result(s) for " + page.route.Query("q")
            end
            each _, hit in matches(page.route.Query("q")):
                TrailCard:
                    region = hit.Split("/")[0]
                    trail = hit.Split("/")[1]
                end
            end
        end
    end
end
