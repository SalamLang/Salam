// EXPECT: <meta name="salam-router" content="history">
// EXPECT: function __salam_route_pick(
const CATALOG := [1, 2, 3, 4, 5, 6]

mut cart := Vector {} as Vector<int>

pure func name_of(id: int): str:
    if id == 1:
        ret "Desk lamp"
    else id == 2:
        ret "Notebook"
    else id == 3:
        ret "Headphones"
    else id == 4:
        ret "Coffee mug"
    else id == 5:
        ret "Backpack"
    end
    ret "Plant"
end

pure func icon_of(id: int): str:
    if id == 1:
        ret "💡"
    else id == 2:
        ret "📓"
    else id == 3:
        ret "🎧"
    else id == 4:
        ret "☕"
    else id == 5:
        ret "🎒"
    end
    ret "🪴"
end

pure func price_of(id: int): int:
    if id == 1:
        ret 39
    else id == 2:
        ret 12
    else id == 3:
        ret 89
    else id == 4:
        ret 15
    else id == 5:
        ret 64
    end
    ret 24
end

pure func total(): int:
    mut t := 0
    each id in cart:
        t += price_of(id)
    end
    ret t
end

func drop_at(at: int):
    mut keep := Vector {} as Vector<int>
    repeat cart.Len() in i:
        if i != at:
            keep.Push(cart.Get(i))
        end
    end
    cart = keep
end

pub component Tile(id: int):
    box:
        grow = 1
        basis = 0
        min width = 200
        max width = 260
        padding = 18
        gap = 10
        radius = 16
        background = "#ffffff"
        border = 1, "solid", "#ebe7e0"
        transition = 180ms, "ease out"
        hover:
            shadow = 0, 14, 30, "#2b1d0e1a"
            translate = 0, -2
        end
        box:
            height = 120
            radius = 12
            background = "#f6efe6"
            align = "center"
            justify = "center"
            font size = 52
            content = icon_of(id)
        end
        paragraph:
            font weight = 700
            content = name_of(id)
        end
        box:
            layout = "row"
            align = "center"
            justify = "between"
            paragraph:
                color = "#8a5a2b"
                font weight = 700
                content = "$" + price_of(id)
            end
            link:
                to = "/product/" + id
                color = "#8a5a2b"
                text decoration = "none"
                font weight = 600
                content = "View"
            end
        end
    end
end

pub component CartRow(at: int, id: int):
    item:
        key = at
        layout = "row"
        align = "center"
        gap = 12
        padding = 12, 16
        radius = 12
        background = "#ffffff"
        border = 1, "solid", "#ebe7e0"
        paragraph:
            font size = 24
            content = icon_of(id)
        end
        paragraph:
            grow = 1
            font weight = 600
            content = name_of(id)
        end
        paragraph:
            color = "#8a5a2b"
            content = "$" + price_of(id)
        end
        button:
            padding = 6, 10
            radius = 8
            background = "#f6efe6"
            click = ():
                drop_at(at)
            end
            content = "Remove"
        end
    end
end

page:
    title = "Shop"
    lang = "en"
    background = "#fbf8f3"
    color = "#2b1d0e"
    font family = "system-ui, sans-serif"
    header:
        layout = "row"
        align = "center"
        justify = "between"
        padding = 16, 28
        background = "#fbf8f3"
        border bottom = 1, "solid", "#ebe7e0"
        link:
            to = "/"
            font size = 20
            font weight = 800
            color = "#2b1d0e"
            text decoration = "none"
            content = "calm.shop"
        end
        nav:
            layout = "row"
            gap = 8
            link:
                to = "/"
                padding = 8, 14
                radius = 999
                color = "#2b1d0e"
                text decoration = "none"
                content = "Shop"
            end
            link:
                to = "/cart"
                padding = 8, 14
                radius = 999
                background = "#2b1d0e"
                color = "#ffffff"
                text decoration = "none"
                content = "Cart (" + cart.Len() + ")"
            end
        end
    end
    main:
        padding = 32, 28
        max width = 1080
        width = 100%
        margin = 0, "auto"
        Outlet: end
    end
end
