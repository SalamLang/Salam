pub component Missing:
    box:
        gap = 12
        heading: size = 1 content = "Nothing here" end
        paragraph: color = #6b5d4f content = "No page at " + page.route.path end
        link: to = "/" color = #8a5a2b content = "Go to the shop" end
    end
end
