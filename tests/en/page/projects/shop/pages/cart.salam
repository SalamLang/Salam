pub component Cart:
    title = "Cart"
    box:
        gap = 16
        max width = 640
        heading: size = 1 content = "Your cart" end
        if cart.Len() == 0:
            paragraph: color = #6b5d4f content = "The cart is empty." end
            link: to = "/" color = #8a5a2b content = "Find something nice" end
        else:
            list:
                gap = 10
                padding = 0
                each i, id in cart:
                    CartRow: at = i id = id end
                end
            end
            box:
                layout = row
                justify = between
                align = center
                paragraph: font size = 20 font weight = 700 content = "Total $" + total() end
                link: to = "/checkout" padding = 12, 20 radius = 12 background = #2b1d0e color = #ffffff text decoration = none font weight = 600 content = "Checkout" end
            end
        end
    end
end
