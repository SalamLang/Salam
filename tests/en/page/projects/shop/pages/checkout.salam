pub component Checkout:
    title = "Checkout"
    guard = cart.Len() > 0
    redirect = "/cart"
    box:
        gap = 16
        max width = 520
        heading: size = 1 content = "Checkout" end
        paragraph: content = cart.Len() + " items, $" + total() end
        button:
            id = "place"
            padding = 12, 20
            radius = 12
            background = #2b1d0e
            color = #ffffff
            font weight = 600
            click = ():
                cart = Vector {} as Vector<int>
                page.Redirect("/thanks")
            end
            content = "Place order"
        end
    end
end
