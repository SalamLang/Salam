pub component Checkout:
    title = "Checkout"
    box:
        gap = 16
        max width = 520
        heading: size = 1 content = "Checkout" end
        if cart.Len() == 0:
            paragraph: content = "Your cart is empty." end
            link: to = "/" color = #8a5a2b content = "Find something nice" end
        else:
            paragraph: content = cart.Len() + " items, $" + total() end
            button:
                id = "place"
                padding = 12, 20
                radius = 12
                background = #2b1d0e
                color = #ffffff
                font weight = 600
                click = ():
                    cart = Vector {} as Vector<int>
                    page.route.Redirect("/thanks")
                end
                content = "Place order"
            end
        end
    end
end
