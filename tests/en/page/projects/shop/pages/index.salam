pub component Shop:
    title = "Shop"
    box:
        gap = 20
        heading:
            size = 1
            content = "New arrivals"
        end
        paragraph:
            color = "#6b5d4f"
            content = "Small things for a calm desk."
        end
        box:
            layout = "row"
            wrap = true
            gap = 16
            each _, id in CATALOG:
                Tile:
                    id = id
                end
            end
        end
    end
end
