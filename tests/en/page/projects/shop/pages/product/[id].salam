pub component Product(id: int):
    box:
        layout = "row"
        wrap = true
        gap = 32
        box:
            grow = 1
            basis = 0
            min width = 260
            height = 320
            radius = 20
            background = "#f6efe6"
            align = "center"
            justify = "center"
            font size = 120
            content = icon_of(id)
        end
        box:
            grow = 1
            basis = 0
            min width = 260
            gap = 14
            link:
                to = "/"
                color = "#8a5a2b"
                text decoration = "none"
                content = "Back to the shop"
            end
            heading:
                size = 1
                content = name_of(id)
            end
            paragraph:
                font size = 28
                font weight = 700
                color = "#8a5a2b"
                content = "$" + price_of(id)
            end
            paragraph:
                color = "#6b5d4f"
                line height = 1.6
                content = "Made to last, shipped in recycled paper. Free returns for thirty days."
            end
            button:
                id = "add"
                padding = 12, 20
                radius = 12
                background = "#2b1d0e"
                color = "#ffffff"
                font weight = 600
                hover:
                    background = "#4a3320"
                end
                click = ():
                    cart.Push(id)
                end
                content = "Add to cart"
            end
        end
    end
end
