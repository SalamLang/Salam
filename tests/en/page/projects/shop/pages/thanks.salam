pub component Thanks:
    title = "Thank you"
    box:
        gap = 12
        align = "center"
        text align = "center"
        padding = 40
        paragraph:
            font size = 56
            content = "🎉"
        end
        heading:
            size = 1
            content = "Thank you"
        end
        link:
            to = "/"
            color = "#8a5a2b"
            content = "Keep shopping"
        end
    end
end
