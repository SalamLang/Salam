pub component Card(heading_text: str):
    box:
        padding = 26
        gap = 12
        radius = 18
        background = #ffffff
        border = 1, solid, #e4def4
        heading:
            size = 2
            margin = 0
            content = heading_text
        end
        content: end
    end
end

pub component Note(message: str):
    paragraph:
        class = "note"
        margin = 0
        min height = 18
        font size = 13
        color = #b3261e
        content = message
    end
end
