pub component Choice(caption: str, active: bool, pick):
    button:
        class = "choice"
        type = "button"
        padding = 9, 16
        radius = 999
        cursor = "pointer"
        border = 1, "solid", "#cfc6e6"
        background = #ffffff
        color = #251d3a
        if active:
            background = #5b3fd1
            color = #ffffff
            border = 1, "solid", "#5b3fd1"
        end
        aria pressed = active ? "true" : "false"
        click = pick
        content = caption
    end
end
