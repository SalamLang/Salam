pub component PlanChoice(code: str, blurb: str):
    button:
        class = "plan"
        padding = 16
        gap = 4
        radius = 14
        text align = "left"
        cursor = "pointer"
        background = #ffffff
        border = 2, solid, #e4def4
        if plan == code:
            border = 2, solid, #5b3fd1
            background = #f1ecfd
        end
        click = ():
            plan = code
        end
        strong:
            content = plan_title(code) + ((plan_price(code) > 0) ? ", $" + plan_price(code) + " a month" : ", free")
        end
        span:
            color = "#5d5478"
            content = blurb
        end
    end
end
