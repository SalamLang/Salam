// EXPECT: var __salam_rt_hash = true
// EXPECT: function __salam_route_pick(
// EXPECT: Create your account
import dom

mut mail := ""
mut word := ""
mut again := ""
mut fullname := ""
mut country := ""
mut role := ""
mut plan := "free"
mut terms := false
mut news := true
mut created := false

func good_mail(s: str): bool:
    t := s.Trim()
    ret t.Len() >= 6 and t.Includes("@") and t.Includes(".")
end

func has_digit(s: str): bool:
    repeat s.Len() in i:
        ch := s.Substr(i, 1)
        if ch >= "0" and ch <= "9":
            ret true
        end
    end
    ret false
end

func good_word(s: str): bool:
    ret s.Len() >= 8 and has_digit(s)
end

func account_ok(): bool:
    ret good_mail(mail) and good_word(word) and again == word
end

func profile_ok(): bool:
    ret fullname.Trim().Len() >= 2 and country.Len() > 0 and role.Len() > 0
end

func plan_ok(): bool:
    ret plan == "free" or plan == "pro" or plan == "team"
end

func plan_price(p: str): int:
    if p == "pro":
        ret 12
    else p == "team":
        ret 39
    end
    ret 0
end

func plan_title(p: str): str:
    if p == "pro":
        ret "Pro"
    else p == "team":
        ret "Team"
    end
    ret "Free"
end

func masked(s: str): str:
    mut out := ""
    repeat s.Len():
        out += "*"
    end
    ret out
end

func finish():
    if account_ok() and profile_ok() and plan_ok() and terms:
        created = true
        page.route.Redirect("/welcome")
    end
end

component Dot(n: int, caption: str, step: int):
    box:
        grow = 1
        gap = 4
        text align = "center"
        font size = 12
        color = "#9a90b8"
        if step >= n:
            color = "#5b3fd1"
        end
        if step == n:
            font weight = 700
        end
        content = n + ". " + caption
    end
end

component Seg(n: int, step: int):
    box:
        grow = 1
        height = 8
        radius = 999
        background = "#ddd6f0"
        if step >= n:
            background = "#5b3fd1"
        end
    end
end

pub component Progress(step: int):
    box:
        gap = 8
        box:
            layout = "row"
            Dot:
                n = 1
                caption = "Account"
                step = step
            end
            Dot:
                n = 2
                caption = "Profile"
                step = step
            end
            Dot:
                n = 3
                caption = "Plan"
                step = step
            end
            Dot:
                n = 4
                caption = "Review"
                step = step
            end
        end
        box:
            class = "bar"
            layout = "row"
            gap = 4
            Seg:
                n = 1
                step = step
            end
            Seg:
                n = 2
                step = step
            end
            Seg:
                n = 3
                step = step
            end
            Seg:
                n = 4
                step = step
            end
        end
    end
end

pub component Nav(back: str, caption: str, ok: bool, go: str):
    box:
        layout = "row"
        justify = "between"
        align = "center"
        margin = 8, 0, 0, 0
        if back.Len() > 0:
            link:
                class = "back"
                to = back
                color = "#5b3fd1"
                content = "Back"
            end
        else:
            span: end
        end
        button:
            class = "next"
            padding = 12, 22
            radius = 10
            border = 0
            background = "#5b3fd1"
            color = "#ffffff"
            font weight = 700
            cursor = "pointer"
            if not ok:
                opacity = 0.4
                cursor = "not allowed"
            end
            aria disabled = ok ? "false" : "true"
            click = ():
                if ok:
                    page.route.GoTo(go)
                end
            end
            content = caption
        end
    end
end

page:
    mode = "hash"
    title = "Create your account"
    lang = "en"
    font = "system-ui, sans-serif"
    background = "#f6f4fb"
    color = "#251d3a"
    main:
        max width = 560
        margin = 36, "auto"
        padding = 0, 18
        gap = 18
        Outlet: end
    end
end
