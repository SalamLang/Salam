pub component AccountStep:
    title = "Step 1: account"
    Progress:
        step = 1
    end
    Card:
        heading_text = "Your account"
        label:
            for = "mail"
            font weight = 600
            content = "Email"
        end
        input:
            id = "mail"
            type = email
            padding = 10, 12
            radius = 10
            border = 1, solid, #cfc6e6
            bind = mail
        end
        Note:
            message = (mail.Len() > 0 and not good_mail(mail)) ? "That does not look like an email address." : ""
        end
        label:
            for = "word"
            font weight = 600
            content = "Password"
        end
        input:
            id = "word"
            type = password
            padding = 10, 12
            radius = 10
            border = 1, solid, #cfc6e6
            bind = word
        end
        Note:
            message = (word.Len() > 0 and not good_word(word)) ? "Use 8 characters or more, with a digit." : ""
        end
        label:
            for = "again"
            font weight = 600
            content = "Repeat the password"
        end
        input:
            id = "again"
            type = password
            padding = 10, 12
            radius = 10
            border = 1, solid, #cfc6e6
            bind = again
        end
        Note:
            message = (again.Len() > 0 and again != word) ? "The two passwords differ." : ""
        end
        Nav:
            back = "/"
            caption = "Next"
            ok = account_ok()
            go = "/profile"
        end
    end
end
