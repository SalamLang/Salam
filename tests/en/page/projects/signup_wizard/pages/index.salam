pub component Start:
    title = "Create your account"
    Card:
        heading_text = "Create your account"
        paragraph:
            margin = 0
            color = #5d5478
            content = "Four short steps: account, profile, plan and a final review."
        end
        link:
            id = "begin"
            to = "/account"
            padding = 12, 22
            radius = 10
            background = #5b3fd1
            color = #ffffff
            text decoration = none
            text align = center
            font weight = 700
            content = "Get started"
        end
    end
end
