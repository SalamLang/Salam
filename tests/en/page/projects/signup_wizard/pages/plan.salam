pub component PlanStep:
    page.Guard(account_ok() and profile_ok())
    title = "Step 3: plan"
    Progress:
        step = 3
    end
    Card:
        heading_text = "Pick a plan"
        PlanChoice:
            code = "free"
            blurb = "One project and community support."
        end
        PlanChoice:
            code = "pro"
            blurb = "Unlimited projects and email support."
        end
        PlanChoice:
            code = "team"
            blurb = "Everything in Pro, with shared workspaces."
        end
        Choice:
            caption = news ? "Product news: on" : "Product news: off"
            active = news
            pick = ():
                news = not news
            end
        end
        Nav:
            back = "/profile"
            caption = "Review"
            ok = plan_ok()
            go = "/review"
        end
    end
end
