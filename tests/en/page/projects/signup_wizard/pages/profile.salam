pub component ProfileStep:
    page.Guard(account_ok())
    title = "Step 2: profile"
    Progress:
        step = 2
    end
    Card:
        heading_text = "About you"
        label:
            for = "fullname"
            font weight = 600
            content = "Full name"
        end
        input:
            id = "fullname"
            padding = 10, 12
            radius = 10
            border = 1, "solid", "#cfc6e6"
            bind = fullname
        end
        Note:
            message = (fullname.Len() > 0 and fullname.Trim().Len() < 2) ? "At least two characters." : ""
        end
        paragraph:
            margin = 0
            font weight = 600
            content = "Country"
        end
        box:
            layout = "row"
            wrap = true
            gap = 8
            Choice:
                caption = "Germany"
                active = (country == "de")
                pick = ():
                    country = "de"
                end
            end
            Choice:
                caption = "Iran"
                active = (country == "ir")
                pick = ():
                    country = "ir"
                end
            end
            Choice:
                caption = "United States"
                active = (country == "us")
                pick = ():
                    country = "us"
                end
            end
        end
        paragraph:
            margin = 0
            font weight = 600
            content = "What do you do?"
        end
        box:
            layout = "row"
            wrap = true
            gap = 8
            Choice:
                caption = "Developer"
                active = (role == "dev")
                pick = ():
                    role = "dev"
                end
            end
            Choice:
                caption = "Designer"
                active = (role == "design")
                pick = ():
                    role = "design"
                end
            end
            Choice:
                caption = "Something else"
                active = (role == "other")
                pick = ():
                    role = "other"
                end
            end
        end
        Nav:
            back = "/account"
            caption = "Next"
            ok = profile_ok()
            go = "/plan"
        end
    end
end
