component ReviewLine(caption: str, shown: str, edit: str):
    box:
        layout = "row"
        justify = "between"
        align = "center"
        padding = 8, 0
        border bottom = 1, solid, #eee9f8
        box:
            span:
                font size = 12
                color = "#7a7096"
                content = caption
            end
            strong:
                class = "value"
                content = shown
            end
        end
        link:
            to = edit
            color = "#5b3fd1"
            font size = 13
            content = "Edit"
        end
    end
end

pub component ReviewStep:
    page.Guard(account_ok() and profile_ok() and plan_ok())
    title = "Step 4: review"
    Progress:
        step = 4
    end
    Card:
        heading_text = "Review and create"
        ReviewLine:
            caption = "Email"
            shown = mail.Trim()
            edit = "/account"
        end
        ReviewLine:
            caption = "Password"
            shown = masked(word)
            edit = "/account"
        end
        ReviewLine:
            caption = "Name"
            shown = fullname.Trim()
            edit = "/profile"
        end
        ReviewLine:
            caption = "Country and role"
            shown = country + " , " + role
            edit = "/profile"
        end
        ReviewLine:
            caption = "Plan"
            shown = plan_title(plan) + (news ? ", with news" : ", no news")
            edit = "/plan"
        end
        Choice:
            caption = terms ? "Terms accepted" : "I accept the terms of service"
            active = terms
            pick = ():
                terms = not terms
            end
        end
        box:
            layout = "row"
            justify = "between"
            align = "center"
            link:
                class = "back"
                to = "/plan"
                color = "#5b3fd1"
                content = "Back"
            end
            button:
                id = "create"
                padding = 12, 22
                radius = 10
                border = 0
                background = "#5b3fd1"
                color = "#ffffff"
                font weight = 700
                if not terms:
                    opacity = 0.4
                    cursor = not allowed
                end
                aria disabled = terms ? "false" : "true"
                click = finish
                content = "Create account"
            end
        end
    end
end
