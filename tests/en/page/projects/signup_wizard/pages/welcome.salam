pub component Welcome:
    page.Guard(created)
    title = "Welcome"
    Card:
        heading_text = "Welcome, " + fullname.Trim()
        paragraph:
            id = "done"
            margin = 0
            content = "Your " + plan_title(plan) + " account for " + mail.Trim() + " is ready."
        end
    end
end
