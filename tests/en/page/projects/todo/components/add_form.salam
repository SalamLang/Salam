pub component AddForm:
    form:
        gap = 6
        submit = (e: i64):
            dom.PreventDefault(e)
            add_todo()
        end
        box:
            layout = "row"
            gap = 8
            input:
                id = "draft"
                grow = 1
                padding = 12, 14
                radius = 12
                border = 2, "solid", "#d7dbea"
                font size = 16
                placeholder = "What needs doing?"
                aria label = "New todo"
                bind = draft
            end
            button:
                id = "add"
                type = "submit"
                padding = 0, 20
                radius = 12
                border = 0
                background = "#4c5bd4"
                color = "#ffffff"
                font weight = 600
                cursor = "pointer"
                content = "Add"
            end
        end
        if problem.Len() > 0:
            paragraph:
                id = "problem"
                margin = 0
                color = "#b42318"
                font size = 14
                role = "alert"
                content = problem
            end
        end
    end
end
