pub component ClearBar:
    if done_count() > 0:
        box:
            layout = "row"
            justify = "end"
            button:
                id = "clear"
                padding = 8, 14
                radius = 10
                border = 1, "solid", "#d7dbea"
                background = "#ffffff"
                color = "#b42318"
                cursor = "pointer"
                click = clear_done
                content = "Clear completed (" + done_count() + ")"
            end
        end
    end
end
