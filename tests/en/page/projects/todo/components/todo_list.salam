pub component TodoList(filter: str, empty: str):
    if shown_count(filter) == 0:
        paragraph:
            class = "empty"
            text align = "center"
            opacity = 0.6
            padding = 24
            content = empty
        end
    else:
        list:
            padding = 0
            margin = 0
            gap = 8
            each i, _ in texts:
                if shows(filter, i):
                    TodoRow:
                        key = i
                        at = i
                    end
                end
            end
        end
    end
end
