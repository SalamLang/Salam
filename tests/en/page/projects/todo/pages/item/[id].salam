pub component Item(id: int):
    title = "Todo details"
    box:
        gap = 12
        padding = 16
        radius = 12
        background = "#ffffff"
        if id < texts.Len():
            heading:
                size = 2
                margin = 0
                content = texts.Get(id)
            end
            paragraph:
                id = "state"
                margin = 0
                content = dones.Get(id) ? "Status: done" : "Status: still to do"
            end
            button:
                id = "flip"
                padding = 8, 14
                radius = 10
                border = 0
                background = "#e4e7f5"
                cursor = "pointer"
                click = (): toggle(id) end
                content = dones.Get(id) ? "Mark as active" : "Mark as done"
            end
        else:
            heading:
                size = 2
                content = "No such todo"
            end
        end
        link:
            to = "/"
            content = "Back to the list"
        end
    end
end
