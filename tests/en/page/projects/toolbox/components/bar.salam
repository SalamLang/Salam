pub component Bar(percent: int, caption: str, reading: str):
    box:
        class = "bar"
        align = center
        gap = 4
        grow = 1
        small:
            content = reading
        end
        box:
            width = 100%
            height = 100
            justify = end
            background = #e5eeee
            radius = 8
            overflow = hidden
            box:
                width = 100%
                height = percent + "%"
                background = #0d9488
            end
        end
        small:
            opacity = 0.7
            content = caption
        end
    end
end
