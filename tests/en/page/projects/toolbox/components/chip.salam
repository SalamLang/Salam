pub component Chip(label: str, chosen: bool, group: int, code: int):
    button:
        class = "chip"
        padding = 6, 14
        radius = 999
        border = 1, solid, #0d9488
        background = transparent
        color = #0d9488
        cursor = "pointer"
        if chosen:
            background = #0d9488
            color = #ffffff
        end
        click = ():
            chip_pick(group, code)
        end
        content = label
    end
end
