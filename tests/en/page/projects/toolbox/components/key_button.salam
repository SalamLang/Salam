pub component KeyButton(label: str, tone: int, onpress):
    button:
        padding = 16, 0
        font size = 20
        radius = 12
        border = 0
        background = #ffffff
        color = #14211f
        cursor = "pointer"
        shadow = 0, 1, 2, #00000022
        if tone == 1:
            background = #0d9488
            color = #ffffff
        end
        if tone == 2:
            background = #e5e7eb
        end
        click = onpress
        content = label
    end
end
