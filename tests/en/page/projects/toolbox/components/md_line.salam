pub component MdLine(variant: int, body: str):
    if variant == 1:
        heading:
            class = "md-h1"
            size = 1
            margin = 4, 0
            content = body
        end
    else variant == 2:
        heading:
            class = "md-h2"
            size = 2
            margin = 4, 0
            content = body
        end
    else variant == 3:
        box:
            class = "md-li"
            layout = "row"
            gap = 8
            padding = 0, 12
            span:
                content = "•"
            end
            paragraph:
                margin = 2, 0
                each at, piece in body.Split("**"):
                    if at % 2 == 1:
                        strong:
                            content = piece
                        end
                    else:
                        span:
                            content = piece
                        end
                    end
                end
            end
        end
    else variant == 4:
        paragraph:
            class = "md-p"
            margin = 4, 0
            each at, piece in body.Split("**"):
                if at % 2 == 1:
                    strong:
                        content = piece
                    end
                else:
                    span:
                        content = piece
                    end
                end
            end
        end
    end
end
