pub component Swatch(tint: str, lock_on: bool, slot_no: int):
    box:
        class = "swatch"
        grow = 1
        basis = 0
        min width = 90
        gap = 6
        box:
            height = 110
            radius = 12
            background = tint
        end
        small:
            class = "css"
            content = tint
        end
        button:
            class = "lock"
            padding = 4, 8
            radius = 999
            border = 1, solid, #0d9488
            background = transparent
            color = #0d9488
            cursor = pointer
            if lock_on:
                background = #0d9488
                color = #ffffff
            end
            click = ():
                toggle_lock(slot_no)
            end
            content = lock_on ? "Locked" : "Lock"
        end
    end
end
