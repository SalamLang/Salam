pub component Missing:
    box:
        gap = 10
        heading:
            size = 2
            content = "Page not found"
        end
        paragraph:
            content = "Nothing at " + page.route.path
        end
        link:
            to = "/"
            content = "Back to the toolbox"
        end
    end
end
