pub component Calculator:
    title = "Calculator"
    box:
        id = "calc-box"
        key down = calc_key
        tab index = 0
        gap = 12
        max width = 340
        heading:
            size = 2
            margin = 0
            content = "Calculator"
        end
        box:
            padding = 16
            radius = 14
            background = "#14211f"
            color = "#ffffff"
            text align = "end"
            font size = 34
            font weight = 600
            span:
                id = "screen"
                content = calc_show
            end
        end
        box:
            layout = "grid"
            columns = 4
            gap = 8
            KeyButton:
                label = "C"
                tone = 2
                onpress = calc_clear
            end
            KeyButton:
                label = "+/-"
                tone = 2
                onpress = calc_negate
            end
            KeyButton:
                label = "<"
                tone = 2
                onpress = calc_back
            end
            KeyButton:
                label = "/"
                tone = 1
                onpress = ():
                    calc_operator("/")
                end
            end
            KeyButton:
                label = "7"
                tone = 0
                onpress = ():
                    calc_digit("7")
                end
            end
            KeyButton:
                label = "8"
                tone = 0
                onpress = ():
                    calc_digit("8")
                end
            end
            KeyButton:
                label = "9"
                tone = 0
                onpress = ():
                    calc_digit("9")
                end
            end
            KeyButton:
                label = "x"
                tone = 1
                onpress = ():
                    calc_operator("*")
                end
            end
            KeyButton:
                label = "4"
                tone = 0
                onpress = ():
                    calc_digit("4")
                end
            end
            KeyButton:
                label = "5"
                tone = 0
                onpress = ():
                    calc_digit("5")
                end
            end
            KeyButton:
                label = "6"
                tone = 0
                onpress = ():
                    calc_digit("6")
                end
            end
            KeyButton:
                label = "-"
                tone = 1
                onpress = ():
                    calc_operator("-")
                end
            end
            KeyButton:
                label = "1"
                tone = 0
                onpress = ():
                    calc_digit("1")
                end
            end
            KeyButton:
                label = "2"
                tone = 0
                onpress = ():
                    calc_digit("2")
                end
            end
            KeyButton:
                label = "3"
                tone = 0
                onpress = ():
                    calc_digit("3")
                end
            end
            KeyButton:
                label = "+"
                tone = 1
                onpress = ():
                    calc_operator("+")
                end
            end
            KeyButton:
                label = "0"
                tone = 0
                onpress = ():
                    calc_digit("0")
                end
            end
            KeyButton:
                label = "."
                tone = 0
                onpress = ():
                    calc_digit(".")
                end
            end
            KeyButton:
                label = "="
                tone = 1
                onpress = calc_equals
            end
        end
        box:
            id = "history"
            gap = 4
            each entry in calc_log:
                small:
                    class = "entry"
                    opacity = 0.75
                    content = entry
                end
            end
        end
    end
end
