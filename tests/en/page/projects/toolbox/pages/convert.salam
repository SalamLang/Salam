pub component Converter:
    title = "Converter"
    box:
        gap = 14
        heading:
            size = 2
            margin = 0
            content = "Unit converter"
        end
        box:
            layout = "row"
            wrap = true
            gap = 8
            each i, catg in [0, 1, 2]:
                Chip:
                    key = i
                    label = cat_name(catg)
                    chosen = (conv_cat == catg)
                    code = catg
                    group = 0
                end
            end
        end
        input:
            id = "amount"
            padding = 10, 14
            radius = 10
            border = 1, "solid", "#b9c7c5"
            font size = 20
            bind = conv_text
        end
        box:
            gap = 6
            small:
                content = "From"
            end
            box:
                layout = "row"
                wrap = true
                gap = 8
                each i, at in [0, 1, 2, 3]:
                    if at < unit_total(conv_cat):
                        Chip:
                            key = i
                            label = unit_name(conv_cat, at)
                            chosen = (conv_from == at)
                            code = at
                            group = 1
                        end
                    end
                end
            end
            small:
                content = "To"
            end
            box:
                layout = "row"
                wrap = true
                gap = 8
                each i, at in [0, 1, 2, 3]:
                    if at < unit_total(conv_cat):
                        Chip:
                            key = i
                            label = unit_name(conv_cat, at)
                            chosen = (conv_to == at)
                            code = at
                            group = 2
                        end
                    end
                end
            end
        end
        box:
            layout = "row"
            align = "center"
            gap = 12
            button:
                id = "swap"
                padding = 8, 16
                radius = 10
                border = 1, "solid", "#0d9488"
                background = "transparent"
                color = "#0d9488"
                cursor = "pointer"
                click = swap_units
                content = "Swap units"
            end
            paragraph:
                id = "answer"
                margin = 0
                font size = 24
                font weight = 700
                content = conv_text + " " + unit_name(conv_cat, conv_from) + " = " + conv_result() + " " + unit_name(conv_cat, conv_to)
            end
        end
    end
end
