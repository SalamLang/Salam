pub component Menu:
    title = "Toolbox"
    box:
        gap = 12
        heading:
            size = 1
            margin = 0
            content = "Small tools"
        end
        link:
            to = "/calc"
            padding = 14
            radius = 12
            background = "#ffffff"
            color = "#14211f"
            text decoration = "none"
            content = "Calculator: keyboard friendly, with history"
        end
        link:
            to = "/convert"
            padding = 14
            radius = 12
            background = "#ffffff"
            color = "#14211f"
            text decoration = "none"
            content = "Unit converter: length, mass and temperature"
        end
        link:
            to = "/tip"
            padding = 14
            radius = 12
            background = "#ffffff"
            color = "#14211f"
            text decoration = "none"
            content = "Tip splitter: share the bill"
        end
        link:
            to = "/markdown"
            padding = 14
            radius = 12
            background = "#ffffff"
            color = "#14211f"
            text decoration = "none"
            content = "Markdown preview: type on the left, read on the right"
        end
        link:
            to = "/palette"
            padding = 14
            radius = 12
            background = "#ffffff"
            color = "#14211f"
            text decoration = "none"
            content = "Palette maker: colour schemes from one hue"
        end
        link:
            to = "/weather"
            padding = 14
            radius = 12
            background = "#ffffff"
            color = "#14211f"
            text decoration = "none"
            content = "Weather: four cities with mock data"
        end
    end
end
