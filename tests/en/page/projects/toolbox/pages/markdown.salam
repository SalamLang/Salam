pub component Markdown:
    title = "Markdown"
    box:
        gap = 12
        heading:
            size = 2
            margin = 0
            content = "Markdown preview"
        end
        box:
            layout = row
            wrap = true
            gap = 16
            input:
                id = "source"
                type = "textarea"
                rows = 14
                grow = 1
                basis = 0
                min width = 260
                padding = 12
                radius = 12
                border = 1, solid, #b9c7c5
                font family = "ui-monospace, monospace"
                bind = md_src
            end
            box:
                id = "preview"
                grow = 1
                basis = 0
                min width = 260
                padding = 12
                radius = 12
                background = #ffffff
                each src_line in md_src.Split("\n"):
                    MdLine:
                        variant = line_kind(src_line)
                        body = line_body(src_line)
                    end
                end
            end
        end
        small:
            id = "words"
            opacity = 0.7
            content = md_words() + " words"
        end
    end
end
