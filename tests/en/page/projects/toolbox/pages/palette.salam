pub component Palette:
    title = "Palette"
    box:
        id = "palette-box"
        key down = palette_key
        tab index = 0
        gap = 14
        heading:
            size = 2
            margin = 0
            content = "Palette maker"
        end
        box:
            layout = "row"
            wrap = true
            gap = 8
            each i, scheme_no in [0, 1, 2, 3]:
                Chip:
                    key = i
                    label = scheme_name(scheme_no)
                    chosen = (scheme == scheme_no)
                    code = scheme_no
                    group = 4
                end
            end
        end
        label:
            gap = 6
            span:
                id = "hue-label"
                content = "Hue " + hue
            end
            input:
                id = "hue"
                type = "range"
                min = 0
                max = 359
                value = hue
                input = (typed: str):
                    hue = typed.ToInt()
                end
            end
        end
        button:
            id = "random"
            padding = 10, 20
            radius = 10
            border = 0
            background = "#0d9488"
            color = "#ffffff"
            cursor = "pointer"
            click = shuffle_hue
            content = "Random hue (space)"
        end
        box:
            layout = "row"
            wrap = true
            gap = 10
            each i, at in FIVE:
                Swatch:
                    key = i
                    tint = swatch_css(at)
                    lock_on = (locked[at] == 1)
                    slot_no = at
                end
            end
        end
    end
end
