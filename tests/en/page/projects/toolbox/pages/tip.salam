pub component Tip:
    title = "Tip splitter"
    box:
        gap = 14
        max width = 460
        heading:
            size = 2
            margin = 0
            content = "Tip splitter"
        end
        label:
            gap = 6
            span:
                content = "Bill amount"
            end
            input:
                id = "bill"
                padding = 10, 14
                radius = 10
                border = 1, solid, #b9c7c5
                font size = 20
                bind = bill_text
            end
        end
        if not bill_ok():
            paragraph:
                id = "bill-error"
                margin = 0
                color = "#dc2626"
                content = "Enter a bill above zero, for example 48.50"
            end
        end
        box:
            gap = 6
            span:
                content = "Tip " + tip_pct + "%"
            end
            box:
                layout = "row"
                wrap = true
                gap = 8
                each pcnt in PERCENTS:
                    Chip:
                        label = pcnt + "%"
                        chosen = (tip_pct == pcnt)
                        code = pcnt
                        group = 3
                    end
                end
            end
        end
        box:
            layout = "row"
            align = "center"
            gap = 10
            span:
                content = "People"
            end
            button:
                id = "fewer"
                padding = 6, 14
                radius = 999
                border = 1, solid, #0d9488
                background = "transparent"
                cursor = "pointer"
                click = ():
                    more_people(-1)
                end
                content = "-"
            end
            strong:
                id = "party"
                content = party
            end
            button:
                id = "more"
                padding = 6, 14
                radius = 999
                border = 1, solid, #0d9488
                background = "transparent"
                cursor = "pointer"
                click = ():
                    more_people(1)
                end
                content = "+"
            end
        end
        if bill_ok():
            box:
                padding = 16
                radius = 14
                background = "#ffffff"
                gap = 6
                paragraph:
                    id = "tip-amount"
                    margin = 0
                    content = "Tip: " + money(tip_cents())
                end
                paragraph:
                    id = "total"
                    margin = 0
                    content = "Total: " + money(total_cents())
                end
                paragraph:
                    id = "each"
                    margin = 0
                    font size = 22
                    font weight = 700
                    content = "Each pays: " + money(each_cents())
                end
            end
        end
    end
end
