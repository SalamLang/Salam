pub component Forecast(city: str):
    title = "Weather"
    box:
        gap = 14
        if city_index(city) >= 0:
            link:
                to = "/weather"
                color = #0d9488
                text decoration = none
                content = "All cities"
            end
            heading:
                id = "city-name"
                size = 1
                margin = 0
                content = city_name(city_index(city))
            end
            paragraph:
                id = "now"
                margin = 0
                font size = 28
                content = temp_text(city_temp(city_index(city))) + ", " + city_sky(city_index(city))
            end
            paragraph:
                id = "extras"
                margin = 0
                opacity = 0.75
                content = "Humidity " + city_humidity(city_index(city)) + "%, wind " + city_wind(city_index(city)) + " km/h"
            end
            box:
                layout = row
                gap = 8
                each hrs in [0, 1, 2, 3, 4, 5]:
                    Bar:
                        percent = 30 + hour_temp(city_index(city), hrs) * 2
                        caption = (9 + hrs * 3) + ":00"
                        reading = temp_text(hour_temp(city_index(city), hrs))
                    end
                end
            end
            label:
                layout = row
                align = center
                gap = 8
                input:
                    id = "fahrenheit-detail"
                    type = checkbox
                    bind = use_fahrenheit
                end
                span:
                    content = "Fahrenheit"
                end
            end
        else:
            heading:
                size = 2
                content = "No weather for " + city
            end
            link:
                to = "/weather"
                content = "Pick a known city"
            end
        end
    end
end
