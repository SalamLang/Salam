pub component CityList:
    title = "Weather"
    box:
        gap = 14
        box:
            layout = row
            align = center
            justify = between
            heading:
                size = 2
                margin = 0
                content = "Weather"
            end
            label:
                layout = row
                align = center
                gap = 8
                input:
                    id = "fahrenheit"
                    type = checkbox
                    bind = use_fahrenheit
                end
                span:
                    content = "Fahrenheit"
                end
            end
        end
        box:
            layout = row
            wrap = true
            gap = 12
            each c in CITIES:
                link:
                    class = "city"
                    to = "/weather/" + city_slug(c)
                    grow = 1
                    basis = 0
                    min width = 140
                    padding = 14
                    radius = 14
                    background = #ffffff
                    color = #14211f
                    text decoration = none
                    box:
                        font size = 14
                        content = city_name(c)
                    end
                    box:
                        font size = 30
                        font weight = 700
                        content = temp_text(city_temp(c))
                    end
                    small:
                        opacity = 0.7
                        content = city_sky(c)
                    end
                end
            end
        end
    end
end
