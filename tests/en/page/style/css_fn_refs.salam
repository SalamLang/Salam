// EXPECT: width: var(--w, 10px);
// EXPECT: margin: env(safe-area-inset-top, 20px);
// EXPECT: height: calc(var(--h) * 2);
// EXPECT: min-width: attr(data-w px, 10px);
page:
    box:
        width = "var(--w, 10px)"
        margin = "env(safe-area-inset-top, 20px)"
        height = "calc(var(--h) * 2)"
        min width = "attr(data-w px, 10px)"
    end
end
