// EXPECT: rotate:45deg
// EXPECT: rotate:180deg
page:
    box:
        rotate = 45
        content = "x"
    end
    box:
        rotate = 90deg
        content = "x"
    end
    box:
        rotate = 0.5turn
        content = "x"
    end
    box:
        rotate = 1rad
        content = "x"
    end
end
