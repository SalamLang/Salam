// EXPECT: border:2px solid #ff0000
// EXPECT: border:3px dotted #0000ff
page:
    box:
        border = 2, solid, red
        content = "x"
    end
    box:
        border = red, 1, dashed
        content = "x"
    end
    box:
        border = dotted, blue, 3
        content = "x"
    end
end
