// EXPECT: color:#ff0000
// EXPECT: color:#ffffff88
// EXPECT: color:#3366aa80
// EXPECT: color:#336699
// EXPECT: color:#00000000
page:
    box:
        color = red
        content = "x"
    end
    box:
        color = #fff
        content = "x"
    end
    box:
        color = #fff8
        content = "x"
    end
    box:
        color = #3366aa
        content = "x"
    end
    box:
        color = #3366aa80
        content = "x"
    end
    box:
        color = rgb(51, 102, 170)
        content = "x"
    end
    box:
        color = rgba(0, 0, 0, 0.25)
        content = "x"
    end
    box:
        color = hsl(210, 50%, 40%)
        content = "x"
    end
    box:
        color = current
        content = "x"
    end
    box:
        color = transparent
        content = "x"
    end
end
