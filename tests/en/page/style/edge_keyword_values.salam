// EXPECT: display:var(--salam-o,block) flex
// EXPECT: flex-direction:var(--salam-dir,row)
// EXPECT: --salam-rev:row-reverse
// EXPECT: align-items:center
page:
    box:
        layout = row
        content = "x"
    end
    box:
        layout = column
        content = "x"
    end
    box:
        align = center
        content = "x"
    end
    box:
        justify = between
        content = "x"
    end
end
