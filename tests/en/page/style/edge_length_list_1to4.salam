// EXPECT: padding:4px
// EXPECT: padding-top:4px
// EXPECT: padding-inline:8px
// EXPECT: padding-bottom:12px
page:
    box:
        padding = 4
        content = "x"
    end
    box:
        padding = 4, 8
        content = "x"
    end
    box:
        padding = 4, 8, 12
        content = "x"
    end
    box:
        padding = 4, 8, 12, 16
        content = "x"
    end
end
