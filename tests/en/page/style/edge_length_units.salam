// EXPECT: width:10px
// EXPECT: width:1.5rem
// EXPECT: width:50vw
// EXPECT: height:25vh
// EXPECT: margin:-4px
page:
    box:
        width = 10px
        content = "x"
    end
    box:
        width = 2em
        content = "x"
    end
    box:
        width = 1.5rem
        content = "x"
    end
    box:
        width = 50%
        content = "x"
    end
    box:
        width = 50vw
        height = 25vh
        content = "x"
    end
    box:
        padding = 0
        content = "x"
    end
    box:
        margin = -4
        content = "x"
    end
    box:
        max width = 99999999px
        content = "x"
    end
end
