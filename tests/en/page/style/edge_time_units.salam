// EXPECT: transition-duration:200ms
// EXPECT: transition-timing-function:ease
// EXPECT: transition-delay:0ms
// EXPECT: transition-duration:400ms
page:
    box:
        transition = 200ms
        content = "x"
    end
    box:
        transition = 2s
        content = "x"
    end
    box:
        transition = 400ms
        content = "x"
    end
end
