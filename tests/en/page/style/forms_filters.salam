// EXPECT: --salam-f-blur:blur(4px)
// EXPECT: --salam-f-brightness:brightness(1.2)
// EXPECT: --salam-f-hue-rotate:hue-rotate(90deg)
// EXPECT: --salam-b-grayscale:grayscale(0.5)
page:
    box: content = "x0" blur = 4 end
    box: content = "x1" brightness = 1.2 end
    box: content = "x2" hue rotate = 90 end
    box: content = "x3" backdrop grayscale = 50% end
end
