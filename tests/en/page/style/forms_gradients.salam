// EXPECT: background-image:conic-gradient(from 0deg,#ff0000,#0000ff)
// EXPECT: conic-gradient(from 45deg,#ff0000,#0000ff)
// EXPECT: radial-gradient(circle,#ff0000,#0000ff)
page:
    box: content = "x0" background = conic(red, blue) end
    box: content = "x1" background = conic(45, red, blue) end
    box: content = "x2" background = radial(circle, red, blue) end
end
