// EXPECT: justify-content:space-between
// EXPECT: justify-content:space-around
// EXPECT: justify-content:space-evenly
page:
    title = "Justify words"
    box:
        layout = row
        justify = between
        box: width = 20 end
        box: width = 20 end
    end
    box:
        layout = row
        justify = around
        box: width = 20 end
    end
    box:
        layout = row
        justify = evenly
        box: width = 20 end
    end
end
