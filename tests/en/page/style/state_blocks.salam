// EXPECT: :hover { background-color:#000080;background-image:none;padding:12px;
// EXPECT: :focus-within { border:2px solid #ff0000;
// EXPECT: :active { color:#00ff00;
// EXPECT: :disabled { opacity:0.4;
// EXPECT: :checked { background-color:#123456;background-image:none;
// EXPECT: :invalid { color:#aa0000;
// EXPECT: ::selection { color:#0000aa;
page:
    input:
        background = #ffffff
        hover:
            background = #000080
            padding = 12
        end
        focus within:
            border = 2, solid, #ff0000
        end
        active:
            color = #00ff00
        end
        disabled:
            opacity = 0.4
        end
        checked:
            background = #123456
        end
        invalid:
            color = #aa0000
        end
        selection:
            color = #0000aa
        end
    end
end
