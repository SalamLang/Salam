// EXPECT: flex-direction:var(--salam-dir,row)
// EXPECT: flex-direction:var(--salam-dir,column)
// EXPECT: display:var(--salam-o,block) grid
// EXPECT: &>*{grid-area:1/1}
// EXPECT: &>*{--salam-o:inline}
// EXPECT-NOT: style="display
page:
    box:
        layout = row
        content = "a"
    end
    box:
        layout = column
        content = "b"
    end
    box:
        layout = grid
        content = "c"
    end
    box:
        layout = stack
        content = "d"
    end
    box:
        layout = flow
        content = "e"
    end
end
