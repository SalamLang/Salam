// EXPECT: aspect-ratio:1.7778;
// EXPECT: opacity:0.5;
// EXPECT: aspect-ratio:2;
// EXPECT: width:12px;
page:
    box: content = "a" aspect ratio = 16 / 9 end
    box: content = "b" opacity = 1 / 2 end
    box: content = "c" aspect ratio = 1.5 + 0.5 end
    box: content = "d" width = 3 * 4 end
end
