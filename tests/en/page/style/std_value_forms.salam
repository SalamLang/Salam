// EXPECT: gap:8px;
const GAP := 4
page:
    box: content = "a" color = rgb(51, 102, 170) end
    box: content = "b" color = hsl(210, 50%, 40%) end
    box: content = "c" color = mix(red, blue, 30%) end
    box: content = "d" color = light dark(white, black) end
    box: content = "e" background = linear(90, red, blue) end
    box: content = "f" background = radial(red, blue) end
    box: content = "g" background = image("a.png") end
    box: content = "h" columns = repeat(3, 1fr) end
    box: content = "i" rows = minmax(100, 1fr) end
    box: content = "j" transition = 150ms, ease out end
    box: content = "k" transition = 200ms, ease(0.2, 0, 0, 1) end
    box: content = "l" width = 100% - 40 end
    box: content = "m" cursor = not allowed end
    box: content = "n" gap = GAP * 2 end
end
