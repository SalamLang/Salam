// EXPECT: font-size:32px;
// EXPECT: id="my_box"
// EXPECT: class="my_class"
// EXPECT: grid-template-columns: repeat(2, 1fr)
component Counter(change_value):
    box:
        content = change_value
        class = "my_class"
    end
end

page:
    Counter:
        change_value = "ok"
    end
    box:
        id = "my_box"
        content = "hi"
        font size = 32px
        grid template columns = repeat (2, 1fr)
    end
end
