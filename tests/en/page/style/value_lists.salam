page:
    box:
        padding = 8, 16
        border = 2, solid, #3366aa
        shadow = 0, 4px, 8px, #000000
        width = 50%
        font = "Open Sans", serif
        margin = 4, 8,
                 12, 16
        content = "x"
    end
    box: padding = 1, 2 color = #fff content = "y" end
    box: background = #3366aa80 content = "z" end
    box: font = serif, mono content = "q" end
end
