page:
    box:
        padding = 8, 16
        border = 2, solid, #3366aa
        box shadow = [0, 4, 8, black], [0, 1, 2, red]
        width = 50%
        font family = "Open Sans", serif
        margin = 4, 8,
                 12, 16
        content = "x"
    end
    box: padding = 1, 2 color = #fff content = "y" end
    box: background color = #3366aa80 content = "z" end
    box: font family = "serif", monospace content = "q" end
end
