// EXPECT: display:var(--salam-o,block) grid
// EXPECT: gap:1em 2rem
// EXPECT: grid-template-columns:1fr 2fr 100px
// EXPECT: transition-duration:200ms
// EXPECT: transition-timing-function:ease
// EXPECT: transition-delay:0ms
// EXPECT: rotate:45deg
// EXPECT: border-radius:50%
// EXPECT: margin-top:-1em
// EXPECT: margin-inline-end:10%
// EXPECT: margin-bottom:0
// EXPECT: margin-inline-start:auto
// EXPECT: rotate:55deg
// EXPECT: transition-duration:300ms
// EXPECT: max-width:100%
page:
    box:
        layout = "grid"
        gap = 1em, 2rem
        columns = 1fr, 2fr, 100px
        transition = 200ms, "ease"
        rotate = 45deg
        content = "a"
    end
    box:
        width = 50vw
        height = 25vh
        content = "b"
    end
    box:
        radius = 50%
        margin = -1em, 10%, 0, "auto"
        content = "c"
    end
    box:
        width = 100% - 20
        height = 50vh + 2em
        content = "d"
    end
    box:
        rotate = 55
        transition = 300ms
        max width = 100% - 0
        content = "e"
    end
end
