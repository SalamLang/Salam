// EXPECT: gap: 1em 2rem;
// EXPECT: grid-template-columns: 1fr 2fr 100px;
// EXPECT: transition: opacity 200ms ease;
// EXPECT: rotate: 45deg;
// EXPECT: width: 50vw; height: 25vh;
// EXPECT: animation-duration: 2s;
// EXPECT: border-radius: 50%;
// EXPECT: margin: -1em 10% 0px auto;
// EXPECT: width: calc(100% - 20px); height: calc(50vh + 2em);
page:
    box:
        display = grid
        gap = 1em, 2rem
        grid template columns = 1fr, 2fr, 100px
        transition = opacity, 200ms, ease
        rotate = 45deg
        content = "a"
    end
    box: width = 50vw height = 25vh animation duration = 2s content = "b" end
    box: border radius = 50% margin = -1em, 10%, 0, auto content = "c" end
    box: width = 100% - 20 height = 50vh + 2em content = "d" end
end
