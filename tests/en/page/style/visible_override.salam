// EXPECT: @media not (width < 900px)
// EXPECT: @media (width >= 600px)
page:
    box:
        visible = false
        if screen width < 900:
            visible = true
        end
        paragraph: content = "narrow only" end
    end
    box:
        layout = "row"
        if screen width >= 600:
            visible = false
        end
        paragraph: content = "hidden when wide" end
    end
end
