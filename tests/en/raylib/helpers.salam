import gui.raylib

func main:
    v := raylib.Vec2(1.5, 2.5)
    println v.x, v.y
    w := raylib.Vec3(1.0, 2.0, 3.0)
    println w.x, w.y, w.z
    r := raylib.Rect(10.0, 20.0, 30.0, 40.0)
    println r.x, r.y, r.width, r.height
    c := raylib.RGBA(10, 20, 30, 40)
    println c.r, c.g, c.b, c.a
    println raylib.RGB(1, 2, 3).a
    red := raylib.Red()
    println red.r, red.g, red.b, red.a
    println raylib.Blank().a
    println raylib.ColorIsEqual(raylib.White(), raylib.RGBA(255, 255, 255, 255))
    println raylib.KEY_SPACE, raylib.KEY_ESCAPE, raylib.KEY_A, raylib.KEY_F5, raylib.KEY_KP_ENTER
    println raylib.MOUSE_BUTTON_LEFT, raylib.MOUSE_BUTTON_MIDDLE
    println raylib.FLAG_VSYNC_HINT | raylib.FLAG_WINDOW_RESIZABLE
    println raylib.LOG_WARNING, raylib.BLEND_ADDITIVE, raylib.CAMERA_ORBITAL
    cam := raylib.NewCamera3D(raylib.Vec3(0.0, 10.0, 10.0), raylib.Vec3(0.0, 0.0, 0.0), raylib.Vec3(0.0, 1.0, 0.0), 45.0, raylib.CAMERA_PERSPECTIVE)
    println cam.position.y, cam.fovy, cam.projection
    cam2 := raylib.NewCamera2D(raylib.Vec2(1.0, 2.0), raylib.Vec2(3.0, 4.0), 5.0, 6.0)
    println cam2.offset.y, cam2.target.x, cam2.rotation, cam2.zoom
end
