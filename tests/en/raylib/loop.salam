import gui.raylib

func main:
    raylib.SetConfigFlags(raylib.FLAG_VSYNC_HINT)
    raylib.InitWindow(800, 450, "Salam raylib")
    raylib.SetTargetFPS(60)
    mut x := 100.0
    mut frames := 0
    until not raylib.WindowShouldClose():
        x += 50.0 * raylib.GetFrameTime() as f64
        raylib.BeginDrawing()
        raylib.ClearBackground(raylib.RayWhite())
        raylib.DrawCircle(x as int, 225, 40.0, raylib.Maroon())
        raylib.DrawRectangleRec(raylib.Rect(10.0, 10.0, 100.0, 50.0), raylib.Fade(raylib.Blue(), 0.5))
        raylib.DrawText("frame", 20, 20, 20, raylib.DarkGray())
        raylib.EndDrawing()
        frames++
    end
    raylib.CloseWindow()
    println "frames", frames
    println "x", x
end
