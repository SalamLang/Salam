import gui.raylib

extern:
    func salam_mock_last(): f64
end

func main:
    m := raylib.GetMousePosition()
    println "mouse", m.x, m.y
    println "frame", raylib.GetFrameTime()
    println "width", raylib.GetScreenWidth()
    println "rand", raylib.GetRandomValue(3, 4)
    a := raylib.Rect(0.0, 0.0, 10.0, 10.0)
    b := raylib.Rect(5.0, 5.0, 10.0, 10.0)
    c := raylib.Rect(50.0, 50.0, 1.0, 1.0)
    println "recs", raylib.CheckCollisionRecs(a, b), raylib.CheckCollisionRecs(a, c)
    f := raylib.Fade(raylib.RGB(1, 2, 3), 0.5)
    println "fade", f.r, f.g, f.b, f.a
    println "toint", raylib.ColorToInt(raylib.RGBA(1, 2, 3, 4))
    println "key", raylib.IsKeyDown(raylib.KEY_A), raylib.IsKeyDown(raylib.KEY_B)
    t := raylib.LoadTexture("x.png")
    println "tex", t.id, t.width, t.height, t.mipmaps, t.format
    img := raylib.GenImageColor(16, 8, raylib.RGBA(5, 0, 0, 9))
    println "img", img.width, img.height, img.mipmaps, img.format
    font := raylib.GetFontDefault()
    sz := raylib.MeasureTextEx(font, "abc", 20.0, 1.0)
    println "measure", sz.x, sz.y
    cam := raylib.NewCamera2D(raylib.Vec2(100.0, 0.0), raylib.Vec2(0.0, 7.0), 2.0, 3.0)
    mat := raylib.GetCameraMatrix2D(cam)
    println "matrix", mat.m0, mat.m5, mat.m12, mat.m13
    ray := raylib.Ray { position = raylib.Vec3(1.0, 0.0, 0.0), direction = raylib.Vec3(0.0, 0.0, 9.0) }
    rc := raylib.GetRayCollisionSphere(ray, raylib.Vec3(0.0, 2.0, 0.0), 4.0)
    println "ray", rc.hit, rc.distance, rc.point.z, rc.normal.y
    model := raylib.Model { meshCount = 3, boneCount = 5 }
    bb := raylib.GetModelBoundingBox(model)
    println "bbox", bb.min.x, bb.max.y, bb.max.z
    raylib.DrawTexturePro(t, raylib.Rect(0.0, 0.0, 8.0, 8.0), raylib.Rect(0.0, 0.0, 1.0, 16.0), raylib.Vec2(0.0, 4.0), 2.0, raylib.RGB(0, 0, 100))
    println "drawpro", salam_mock_last()
    raylib.SetShaderValueMatrix(raylib.Shader { id = 5 as u32 }, 2, raylib.Matrix { m15 = 1.5 as f32 })
    println "shadermat", salam_mock_last()
    anim := raylib.ModelAnimation { boneCount = 2, frameCount = 10 }
    raylib.UpdateModelAnimation(model, anim, 1)
    println "anim", salam_mock_last()
    println "monitor", raylib.GetMonitorName(0), raylib.GetMonitorName(1)
    mut pic := raylib.GenImageColor(4, 4, raylib.Blank())
    raylib.ImageResize(pic, 30, 20)
    println "resize", pic.width, pic.height
    mut hitp := raylib.Vec2(0.0, 0.0)
    ok := raylib.CheckCollisionLines(raylib.Vec2(0.0, 0.0), raylib.Vec2(1.0, 1.0), raylib.Vec2(0.0, 1.0), raylib.Vec2(1.0, 0.0), hitp)
    println "lines", ok, hitp.x, hitp.y
    mut n := 0
    raylib.LoadFileData("f", n)
    println "filedata", n
end
