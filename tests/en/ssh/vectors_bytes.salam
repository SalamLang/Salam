// std/ssh known-answer + local-loopback self-tests. Entry point for
// ssh.SelfTest(), which runs every _selftest_*() module in the package:
// bigint, x25519, dh, aes, mac, rsa (known-answer vectors, several
// independently produced with openssl), bytes/algorithms/kdf/hostkey/
// knownhosts/privatekey (wire-format and file-parsing logic, several using
// real openssl/ssh-keygen-produced keys as fixtures), sftp (attribute wire
// format), and packet (a real TCP loopback round trip on 127.0.0.1, both
// plaintext and encrypted).
//
// HOW TO RUN (mirrors tests/en/tls/vectors_bytes.salam):
//
//   rm -rf .salam-build
//   salam build tests/en/ssh/vectors_bytes.salam --output=/tmp/sshtest
//   /tmp/sshtest        # exits 0 on success, else the failure count
//
// Use the COMPILED backend, not `salam run` - see the tls suite's note on
// why (interpreter integer-width semantics and runaway-execution guards on
// crypto-heavy loops), and clear .salam-build first for the same
// stale-module-cache reason.
//
// None of this suite talks to a real server - see tests/en/ssh/live_*.salam
// for that. A green run here proves the primitives and wire format are
// correct in isolation; it does NOT prove interop with an actual sshd.

package main

import ssh
import os

func main:
    os.Exit(ssh.SelfTest())
end
