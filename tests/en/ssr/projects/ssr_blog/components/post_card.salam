pub component PostCard(slug: str, heading_text: str, day: str, tag: str):
    link:
        to = "/post/" + slug
        layout = "column"
        gap = 4
        padding = 16, 0
        border bottom = 1, "solid", "#e3dccb"
        color = "#2a2620"
        decoration = "none"
        heading:
            size = 2
            content = heading_text
        end
        small:
            opacity = 0.65
            content = day + " in " + tag
        end
    end
end
