import env
import net.http
import encoding.json

struct Post:
    pub slug: str = ""
    pub title: str = ""
    pub tag: str = ""
    pub day: str = ""
    pub story: str = ""
end

struct Feed:
    pub posts: Vector<Post> = Vector {} as Vector<Post>
end

server func ListPosts(tag: str): Vector<Post>:
    r := http.Get(env.Get("BLOG_API") + "/posts?tag=" + tag)
    mut feed := Feed {}
    try:
        json.Unmarshal(r.body, feed)
    catch e:
        println "bad feed:", e.message
    end
    ret feed.posts
end

server func GetPost(slug: str): Post:
    r := http.Get(env.Get("BLOG_API") + "/posts/" + slug)
    mut p := Post {}
    try:
        json.Unmarshal(r.body, p)
    catch e:
        println "bad post:", e.message
    end
    ret p
end

page:
    title = "Field Notes"
    lang = "en"
    font family = "Georgia, serif"
    box:
        min height = 100vh
        background = "#fbf8f1"
        color = "#2a2620"
        header:
            layout = "row"
            align = "center"
            gap = 22
            padding = 18, 32
            border bottom = 1, "solid", "#e3dccb"
            link:
                to = "/"
                font size = 24
                font weight = 700
                color = "#2a2620"
                text decoration = "none"
                content = "Field Notes"
            end
            nav:
                layout = "row"
                gap = 16
                link:
                    to = "/"
                    color = "#6b5c3a"
                    content = "Posts"
                end
                link:
                    to = "/tag/travel"
                    color = "#6b5c3a"
                    content = "Travel"
                end
                link:
                    to = "/tag/code"
                    color = "#6b5c3a"
                    content = "Code"
                end
                link:
                    to = "/about"
                    color = "#6b5c3a"
                    content = "About"
                end
            end
        end
        main:
            max width = 680
            margin = 0, "auto"
            padding = 32
            Outlet: end
        end
        footer:
            padding = 24, 32
            text align = "center"
            opacity = 0.6
            content = "Rendered on the server, taken over in the browser."
        end
    end
end
