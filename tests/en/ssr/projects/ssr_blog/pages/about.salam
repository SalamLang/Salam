pub component About:
    title = "About"
    prerender = ["/about"]
    box:
        gap = 10
        heading:
            size = 1
            content = "About this blog"
        end
        paragraph:
            content = "Field Notes is a small blog written in Salam. The server answers every address with finished HTML, and the browser takes over when the script has loaded."
        end
    end
end
