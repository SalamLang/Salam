pub component Home:
    title = "Field Notes"
    posts := ListPosts("")
    box:
        gap = 6
        heading:
            size = 1
            content = "Latest posts"
        end
        if posts.Len() == 0:
            paragraph:
                content = "No posts yet."
            end
        end
        each _, p in posts:
            PostCard:
                slug = p.slug
                heading_text = p.title
                day = p.day
                tag = p.tag
            end
        end
    end
end
