pub component PostPage(slug: str):
    post := GetPost(slug)
    likes := 0
    title = "Post " + slug
    box:
        gap = 12
        if post.title == "":
            heading:
                size = 1
                content = "This post does not exist"
            end
            link:
                to = "/"
                content = "Back to all posts"
            end
        else:
            heading:
                size = 1
                content = post.title
            end
            small:
                opacity = 0.65
                content = post.day + " in " + post.tag
            end
            paragraph:
                line height = 1.8
                content = post.story
            end
            button:
                id = "like"
                align self = "start"
                padding = 8, 16
                radius = 20
                border = 1, solid, #c9b98f
                background = "#fff7e0"
                click = (): likes++ end
                content = "Like " + likes
            end
        end
    end
end
