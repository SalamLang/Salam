pub component TagPage(name: str):
    title = "Tag " + name
    posts := ListPosts(name)
    box:
        gap = 6
        heading:
            size = 1
            content = "Posts about " + name
        end
        each i, p in posts:
            PostCard:
                key = i
                slug = p.slug
                heading_text = p.title
                day = p.day
                tag = p.tag
            end
        end
    end
end
