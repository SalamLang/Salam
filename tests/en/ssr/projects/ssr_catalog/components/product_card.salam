pub component ProductCard(pid: int, product: str, price: int, stock: int):
    link:
        to = "/product/" + pid
        layout = column
        gap = 6
        padding = 16
        radius = 14
        background = #ffffff
        color = #1c2b26
        text decoration = none
        border = 1, solid, #dce6e1
        hover:
            shadow = 0, 6, 18, #12372a22
        end
        strong:
            content = product
        end
        span:
            content = "$" + price
        end
        if stock > 0:
            small:
                color = #1c6b45
                content = stock + " in stock"
            end
        else:
            small:
                color = #5b6b64
                content = "sold out"
            end
        end
    end
end
