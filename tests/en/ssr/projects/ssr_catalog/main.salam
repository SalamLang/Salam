import env
import str
import net.http
import encoding.json

mut basket := Vector {} as Vector<int>
struct Product:
    pub id: int = 0
    pub name: str = ""
    pub category: str = ""
    pub price: int = 0
    pub stock: int = 0
    pub blurb: str = ""
end

struct Listing:
    pub items: Vector<Product> = Vector {} as Vector<Product>
end

struct Receipt:
    pub ok: bool = false
    pub left: int = 0
end


server func ListProducts(category: str): Vector<Product>:
    r := http.Get(env.Get("SHOP_API") + "/products?category=" + category)
    mut l := Listing {}
    try:
        json.Unmarshal(r.body, l)
    catch e:
        println "bad listing:", e.message
    end
    ret l.items
end

server func GetProduct(id: int): Product:
    r := http.Get(env.Get("SHOP_API") + "/products/" + str.FromInt(id as i64))
    mut p := Product {}
    try:
        json.Unmarshal(r.body, p)
    catch e:
        println "bad product:", e.message
    end
    ret p
end

server func Reserve(id: int, qty: int): Receipt:
    mut headers := http.NewHeaders()
    headers.Insert("Authorization", "Bearer " + env.Get("SHOP_TOKEN"))
    body := "{\"id\":" + str.FromInt(id as i64) + ",\"qty\":" + str.FromInt(qty as i64) + "}"
    r := http.PostWith(env.Get("SHOP_API") + "/reserve", body, headers)
    mut out := Receipt {}
    try:
        json.Unmarshal(r.body, out)
    catch e:
        println "bad receipt:", e.message
    end
    ret out
end

func add_to_basket(id: int):
    basket.Push(id)
end

page:
    title = "Corner Shop"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = #f5f7f6
        color = #1c2b26
        header:
            layout = row
            align = center
            gap = 20
            padding = 14, 28
            background = #12372a
            link:
                to = "/"
                color = #ffffff
                font size = 22
                font weight = 800
                text decoration = none
                content = "Corner Shop"
            end
            nav:
                layout = row
                gap = 14
                grow = 1
                link:
                    to = "/?cat=fruit"
                    color = #cfe8dc
                    content = "Fruit"
                end
                link:
                    to = "/?cat=bakery"
                    color = #cfe8dc
                    content = "Bakery"
                end
                link:
                    to = "/?cat=drinks"
                    color = #cfe8dc
                    content = "Drinks"
                end
            end
            link:
                to = "/basket"
                color = #ffffff
                content = "Basket (" + basket.Len() + ")"
            end
        end
        main:
            max width = 920
            margin = 0, auto
            padding = 28
            Outlet: end
        end
    end
end
