pub component Basket:
    title = "Basket"
    box:
        gap = 10
        heading:
            size = 1
            content = "Your basket"
        end
        if basket.Len() == 0:
            paragraph:
                content = "Nothing reserved yet."
            end
        end
        list:
            each i, id in basket:
                item:
                    key = i
                    link:
                        to = "/product/" + id
                        content = "Product " + id
                    end
                end
            end
        end
        button:
            id = "empty"
            align self = "start"
            padding = 8, 16
            radius = 10
            click = (): basket = Vector {} as Vector<int> end
            content = "Empty the basket"
        end
    end
end
