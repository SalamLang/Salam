pub component Home:
    title = "Corner Shop"
    items := ListProducts(page.route.Query("cat"))
    box:
        gap = 14
        heading:
            size = 1
            content = (page.route.Query("cat") == "" ? "All products" : "Category: " + page.route.Query("cat"))
        end
        if items.Len() == 0:
            paragraph:
                content = "Nothing in this category."
            end
        end
        box:
            layout = "grid"
            columns = "repeat(fill, minmax(200, 1fr))"
            gap = 14
            each p in items:
                ProductCard:
                    pid = p.id
                    product = p.name
                    price = p.price
                    stock = p.stock
                end
            end
        end
    end
end
