pub component ProductPage(id: int):
    title = "Product " + id
    p := GetProduct(id)
    note := ""
    box:
        gap = 12
        if p.name == "":
            heading:
                size = 1
                content = "No such product"
            end
            link:
                to = "/"
                content = "Back to the shop"
            end
        else:
            heading:
                size = 1
                content = p.name
            end
            paragraph:
                content = p.blurb
            end
            strong:
                content = "$" + p.price
            end
            button:
                id = "reserve"
                align self = start
                padding = 10, 20
                radius = 10
                border = 0
                background = #12372a
                color = #ffffff
                disabled = (p.stock == 0)
                click = ():
                    got := Reserve(p.id, 1)
                    if got.ok:
                        add_to_basket(p.id)
                        note = "Reserved, " + got.left + " left"
                    else:
                        note = "Could not reserve it"
                    end
                end
                content = "Reserve one"
            end
            paragraph:
                id = "note"
                content = note
            end
        end
    end
end
