pub component StatCard(caption: str, figure: str):
    box:
        gap = 4
        padding = 16
        radius = 14
        background = #ffffff
        small:
            opacity = 0.65
            content = caption
        end
        strong:
            font size = 26
            content = figure
        end
    end
end

pub component Bar(day: str, amount: int):
    box:
        layout = row
        align = center
        gap = 10
        small:
            width = 40
            content = day
        end
        progress:
            grow = 1
            value = amount
            max = 20
        end
        small:
            width = 24
            content = amount
        end
    end
end

pub component StatusPill(phase: str):
    if phase == "shipped":
        span:
            padding = 2, 10
            radius = 20
            font size = 13
            background = #d7f5e3
            color = #14532d
            content = phase
        end
    else:
        span:
            padding = 2, 10
            radius = 20
            font size = 13
            background = #fff3cd
            color = #6b5200
            content = phase
        end
    end
end
