pub component StatCard(caption: str, figure: str):
    box:
        gap = 4
        padding = 16
        radius = 14
        background = #ffffff
        small:
            opacity = 0.65
            content = caption
        end
        strong:
            font size = 26
            content = figure
        end
    end
end

pub component Bar(day: str, amount: int):
    box:
        layout = column
        align = center
        justify = end
        gap = 4
        height = 160
        small:
            content = amount
        end
        box:
            width = 28
            radius = 6
            background = #4a63d8
            height = (amount * 5) + "%"
        end
        small:
            opacity = 0.65
            content = day
        end
    end
end

pub component StatusPill(phase: str):
    if phase == "shipped":
        span:
            padding = 2, 10
            radius = 20
            font size = 13
            background = #d7f5e3
            color = #14532d
            content = phase
        end
    else:
        span:
            padding = 2, 10
            radius = 20
            font size = 13
            background = #fff3cd
            color = #6b5200
            content = phase
        end
    end
end
