import env
import str
import net.http
import encoding.json

struct Ack:
    pub ok: bool = false
end

struct Point:
    pub day: str = ""
    pub amount: int = 0
end

struct Totals:
    pub orders: int = 0
    pub revenue: int = 0
    pub visitors: int = 0
    pub week: Vector<Point> = Vector {} as Vector<Point>
end

struct Order:
    pub id: int = 0
    pub customer: str = ""
    pub total: int = 0
    pub status: str = ""
end

struct OrderList:
    pub rows: Vector<Order> = Vector {} as Vector<Order>
end


func bar_pct(amount: int, top: int): str:
    if top <= 0:
        ret "0%"
    end
    ret "" + (amount * 100 / top) + "%"
end

func api_headers(): HashMap<str, str>:
    mut h := http.NewHeaders()
    h.Insert("Authorization", "Bearer " + env.Get("DESK_TOKEN"))
    ret h
end

server func Overview(): Totals:
    r := http.GetWith(env.Get("DESK_API") + "/overview", api_headers())
    mut t := Totals {}
    try:
        json.Unmarshal(r.body, t)
    catch e:
        println "bad overview:", e.message
    end
    ret t
end

server func Orders(stage: str): Vector<Order>:
    r := http.GetWith(env.Get("DESK_API") + "/orders?status=" + stage, api_headers())
    mut l := OrderList {}
    try:
        json.Unmarshal(r.body, l)
    catch e:
        println "bad orders:", e.message
    end
    ret l.rows
end

server func OrderById(id: int): Order:
    r := http.GetWith(env.Get("DESK_API") + "/orders/" + str.FromInt(id as i64), api_headers())
    mut o := Order {}
    try:
        json.Unmarshal(r.body, o)
    catch e:
        println "bad order:", e.message
    end
    ret o
end

server func MarkShipped(id: int): Ack:
    r := http.PostWith(env.Get("DESK_API") + "/orders/" + str.FromInt(id as i64) + "/ship", "", api_headers())
    mut a := Ack {}
    a.ok = r.status == 200
    ret a
end

page:
    title = "Order Desk"
    lang = "en"
    font family = "system-ui, sans-serif"
    box:
        min height = 100vh
        background = #eef1f6
        color = #1b2236
        header:
            layout = row
            align = center
            gap = 18
            padding = 14, 28
            background = #1b2236
            link:
                to = "/"
                color = #ffffff
                font size = 20
                font weight = 800
                text decoration = none
                content = "Order Desk"
            end
            link:
                to = "/desk"
                color = #c9d2ee
                content = "Overview"
            end
            link:
                to = "/desk/orders"
                color = #c9d2ee
                content = "Orders"
            end
        end
        main:
            max width = 940
            margin = 0, auto
            padding = 28
            Outlet: end
        end
    end
end
