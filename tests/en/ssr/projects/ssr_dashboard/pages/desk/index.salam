pub component Overview2:
    title = "Overview"
    t := Overview()
    days := Weekly()
    box:
        gap = 16
        heading:
            size = 1
            content = "Overview"
        end
        box:
            layout = grid
            columns = "repeat(fill, minmax(180, 1fr))"
            gap = 12
            StatCard:
                caption = "Orders"
                figure = "" + t.orders
            end
            StatCard:
                caption = "Revenue"
                figure = "$" + t.revenue
            end
            StatCard:
                caption = "Visitors"
                figure = "" + t.visitors
            end
        end
        box:
            padding = 16
            radius = 14
            background = #ffffff
            heading:
                size = 3
                content = "Orders this week"
            end
            box:
                layout = row
                gap = 14
                justify = around
                each pt in days:
                    Bar:
                        day = pt.day
                        amount = pt.amount
                    end
                end
            end
        end
    end
end
