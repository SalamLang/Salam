pub component OrderList2:
    title = "Orders"
    rows := Orders(page.route.Query("status"))
    box:
        gap = 12
        heading:
            size = 1
            content = "Orders"
        end
        box:
            layout = row
            gap = 10
            link:
                to = "/desk/orders"
                content = "All"
            end
            link:
                to = "/desk/orders?status=pending"
                content = "Pending"
            end
            link:
                to = "/desk/orders?status=shipped"
                content = "Shipped"
            end
        end
        table:
            header:
                row:
                    column:
                        content = "Order"
                    end
                    column:
                        content = "Customer"
                    end
                    column:
                        content = "Total"
                    end
                    column:
                        content = "Status"
                    end
                end
            end
            main:
                each o in rows:
                    row:
                        column:
                            link:
                                to = "/order/" + o.id
                                content = "#" + o.id
                            end
                        end
                        column:
                            content = o.customer
                        end
                        column:
                            content = "$" + o.total
                        end
                        column:
                            StatusPill:
                                phase = o.status
                            end
                        end
                    end
                end
            end
        end
    end
end
