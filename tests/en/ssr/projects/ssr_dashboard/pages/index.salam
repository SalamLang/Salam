pub component Welcome:
    title = "Order Desk"
    box:
        gap = 12
        max width = 420
        heading:
            size = 1
            content = "Order Desk"
        end
        paragraph:
            content = "Figures come from the shop API through server functions, so the browser never sees the token."
        end
        link:
            to = "/desk"
            align self = "start"
            padding = 10, 20
            radius = 10
            background = "#1b2236"
            color = "#ffffff"
            decoration = "none"
            content = "Open the desk"
        end
    end
end
