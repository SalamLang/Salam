pub component OrderPage(id: int):
    title = "Order"
    o := OrderById(id)
    msg := ""
    box:
        gap = 12
        heading:
            size = 1
            content = "Order #" + id
        end
        if o.id == 0:
            paragraph:
                content = "This order does not exist."
            end
        else:
            paragraph:
                content = o.customer
            end
            StatusPill:
                phase = o.status
            end
            button:
                id = "ship-btn"
                align self = start
                padding = 10, 18
                radius = 10
                disabled = (o.status == "shipped")
                click = ():
                    ack := MarkShipped(o.id)
                    if ack.ok:
                        msg = "Marked as shipped"
                    else:
                        msg = "The shop refused"
                    end
                end
                content = "Mark as shipped"
            end
            paragraph:
                id = "msg"
                content = msg
            end
        end
        link:
            to = "/desk/orders"
            content = "All orders"
        end
    end
end
