pub component Counter:
    title = "Counter"
    n := 0
    heading:
        content = "Counter"
    end
    button:
        id = "inc"
        click = (): n++ end
        content = "Add"
    end
    paragraph:
        id = "count"
        content = "Count " + n
    end
end
