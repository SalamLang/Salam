import str

mut counter := 0

struct Info:
    pub label: str = ""
    pub size: int = 0
end

server func Next(): int:
    counter++
    println "Next ran"
    ret counter
end

server func Other(start: int): int:
    println "Other ran"
    ret start + 40
end

server func Names(): Vector<str>:
    println "Names ran"
    mut v := Vector {} as Vector<str>
    v.Push("one")
    v.Push("two")
    ret v
end

server func Details(): Info:
    println "Details ran"
    ret Info { label = str.Upper("box"), size = 3 }
end

page:
    title = "state"
    nav:
        link:
            id = "to-home"
            to = "/"
            content = "Home"
        end
        link:
            id = "to-other"
            to = "/other"
            content = "Other"
        end
    end
    Outlet: end
end
