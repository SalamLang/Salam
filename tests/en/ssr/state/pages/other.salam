component Amount(start: int):
    n := Other(start) as int
    button:
        id = "again"
        click = (): n = Other(n) end
        content = "again " + n
    end
end

pub component OtherPage:
    names := Names() as Vector<str>
    info := Details() as Info
    base := 2
    box:
        paragraph:
            id = "info"
            content = info.label + " " + info.size + " " + names.Len()
        end
        button:
            id = "drop"
            click = (): names.Remove(0) end
            content = "drop"
        end
        Amount:
            start = base
        end
    end
end
