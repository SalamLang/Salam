package main

import tls
import cpu
import mem
import str

mut failures := 0
mut seed := 12345

func check(name: str, ok: bool):
    if ok:
        println "PASS", name
    else:
        println "FAIL", name
        failures++
    end
end

func rnd(): int:
    seed = (seed * 1103515245 + 12345) & 0x7fffffff
    ret seed >> 8
end

func fill(p: void*, n: int):
    b := p as u8*
    repeat n in i:
        b[i] = (rnd() & 255) as u8
    end
end

func same(a: void*, b: void*, n: int): bool:
    x := a as u8*
    y := b as u8*
    mut d := 0
    repeat n in i:
        d |= (x[i] ^ y[i]) as int
    end
    ret d == 0
end

func both(klen: int, n: int, al: int):
    key := mem.AllocateZeroed(32 as u64)
    nonce := mem.AllocateZeroed(12 as u64)
    aad := mem.AllocateZeroed(80 as u64)
    pt := mem.AllocateZeroed((n + 1) as u64)
    hw := mem.AllocateZeroed((n + 17) as u64)
    sw := mem.AllocateZeroed((n + 17) as u64)
    back := mem.AllocateZeroed((n + 1) as u64)
    fill(key, 32)
    fill(nonce, 12)
    fill(aad, 80)
    fill(pt, n)
    cpu.SetHardware(true)
    tls.AesGcmSealRaw(key, klen, nonce, aad, al, pt, n, hw)
    cpu.SetHardware(false)
    tls.AesGcmSealRaw(key, klen, nonce, aad, al, pt, n, sw)
    same_out := same(hw, sw, n + 16)
    cpu.SetHardware(true)
    open_hw := tls.AesGcmOpenRaw(key, klen, nonce, aad, al, sw, n + 16, back)
    ok1 := open_hw and same(back, pt, n)
    mem.Set(back, 0, (n + 1) as u64)
    cpu.SetHardware(false)
    open_sw := tls.AesGcmOpenRaw(key, klen, nonce, aad, al, hw, n + 16, back)
    ok2 := open_sw and same(back, pt, n)
    cpu.SetHardware(true)
    hb := hw as u8*
    hb[n + (rnd() & 15)] ^= (1 as u8)
    bad_tag := not tls.AesGcmOpenRaw(key, klen, nonce, aad, al, hw, n + 16, back)
    ctx := tls.AeadNew(klen == 16 ? tls.AEAD_AES_128_GCM : tls.AEAD_AES_256_GCM, key)
    out3 := mem.AllocateZeroed((n + 17) as u64)
    tls.AeadSeal(ctx, nonce, aad, al, pt, n, out3)
    ctx_same := same(out3, sw, n + 16)
    tls.AeadFree(ctx)
    check("aes-" + str.FromInt(klen * 8) + " size " + str.FromInt(n) + " aad " + str.FromInt(al), same_out and ok1 and ok2 and bad_tag and ctx_same)
    if n > 0:
        cpu.SetHardware(true)
        tls.AesGcmSealRaw(key, klen, nonce, aad, al, pt, n, hw)
        hb[rnd() % n] ^= (4 as u8)
        check("tampered body rejected " + str.FromInt(n), not tls.AesGcmOpenRaw(key, klen, nonce, aad, al, hw, n + 16, back))
    end
    mem.Free(key)
    mem.Free(nonce)
    mem.Free(aad)
    mem.Free(pt)
    mem.Free(hw)
    mem.Free(sw)
    mem.Free(back)
    mem.Free(out3)
end

func main():
    cpu.SetHardware(false)
    check("hardware can be forced off", not cpu.HasHardwareCrypto())
    cpu.SetHardware(true)
    sizes := [0, 1, 15, 16, 17, 31, 32, 33, 47, 48, 63, 64, 65, 100, 127, 128, 129, 143, 144, 191, 192, 255, 256, 257, 511, 1000, 1500, 4095, 4096, 4097, 8192, 16384, 16401, 70000]
    each n in sizes:
        both(16, n, n % 41)
        both(32, n, (n * 3) % 80)
    end
    println "failures", failures
end
