package main

import archive
import compress
import testing
import os
import filepath
import mem

func main(): int:
    tmpdir := filepath.Join(os.TempDir(), "salam_bzip2_file_test")
    defer mem.Free(tmpdir as void*)
    os.MkdirAll(tmpdir)

    mut text := compress.BufFromStr("bzip2 files: the quick brown fox jumps over the lazy dog, again and again and again.\n")
    src := filepath.Join(tmpdir, "plain.txt")
    packed := filepath.Join(tmpdir, "plain.txt.bz2")
    back := filepath.Join(tmpdir, "plain_back.txt")
    missing := filepath.Join(tmpdir, "no_such_file.bz2")
    junk := filepath.Join(tmpdir, "junk.bz2")
    defer mem.Free(src as void*)
    defer mem.Free(packed as void*)
    defer mem.Free(back as void*)
    defer mem.Free(missing as void*)
    defer mem.Free(junk as void*)

    testing.AssertTrue(archive.WriteBinaryFile(src, text.data, text.len))
    testing.AssertTrue(archive.Bzip2CompressFile(src, packed))
    testing.AssertTrue(archive.Bzip2DecompressFile(packed, back))
    mut rok := false
    mut got := archive.ReadBinaryFile(back, rok)
    testing.AssertTrue(rok)
    testing.AssertTrue(compress.BufEquals(got, text))
    compress.BufFree(got)

    mut head := archive.ReadBinaryFile(packed, rok)
    testing.AssertEqInt(compress.BufGet(head, 0), 66)
    testing.AssertEqInt(compress.BufGet(head, 1), 90)
    testing.AssertEqInt(compress.BufGet(head, 2), 104)
    compress.BufFree(head)

    testing.AssertFalse(archive.Bzip2CompressFile(missing, packed))
    testing.AssertFalse(archive.Bzip2DecompressFile(missing, back))
    testing.AssertTrue(archive.WriteBinaryFile(junk, text.data, text.len))
    testing.AssertFalse(archive.Bzip2DecompressFile(junk, back))

    _ := os.Remove(src)
    _ := os.Remove(packed)
    _ := os.Remove(back)
    _ := os.Remove(junk)
    compress.BufFree(text)
    ret testing.Summary()
end
