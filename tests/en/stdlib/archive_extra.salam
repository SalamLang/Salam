package main

import archive
import compress
import os
import filepath
import mem
import str

func rar_block(b &: compress.ByteBuf, name: str, data: str):
    name_len := name.len()
    data_len := data.len()
    archive.LEPut16(b, 0)
    compress.BufPush(b, 0x74)
    archive.LEPut16(b, 0)
    archive.LEPut16(b, 32 + name_len)
    archive.LEPut32(b, data_len)
    archive.LEPut32(b, data_len)
    compress.BufPush(b, 0)
    archive.LEPut32(b, compress.CRC32Str(data) as int)
    archive.LEPut32(b, 0)
    compress.BufPush(b, 20)
    compress.BufPush(b, 0x30)
    archive.LEPut16(b, name_len)
    archive.LEPut32(b, 0x20)
    compress.BufPushBytes(b, name as void*, name_len)
    compress.BufPushBytes(b, data as void*, data_len)
end

func build_rar(): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    compress.BufPush(b, 0x52)
    compress.BufPush(b, 0x61)
    compress.BufPush(b, 0x72)
    compress.BufPush(b, 0x21)
    compress.BufPush(b, 0x1a)
    compress.BufPush(b, 0x07)
    compress.BufPush(b, 0x00)
    archive.LEPut16(b, 0)
    compress.BufPush(b, 0x73)
    archive.LEPut16(b, 0)
    archive.LEPut16(b, 13)
    archive.LEPut16(b, 0)
    archive.LEPut32(b, 0)
    rar_block(b, "top.txt", "top level")
    rar_block(b, "sub/inner.txt", "inner file")
    rar_block(b, "../escape.txt", "nope")
    archive.LEPut16(b, 0)
    compress.BufPush(b, 0x7b)
    archive.LEPut16(b, 0)
    archive.LEPut16(b, 7)
    ret b
end

func read_text(path: str): str:
    mut ok := false
    mut buf := archive.ReadBinaryFile(path, ok)
    defer compress.BufFree(buf)
    if not ok:
        ret str.Clone("missing")
    end
    ret compress.BufToStrUnsafe(buf)
end

func print_text(dir: str, name: str):
    path := filepath.Join(dir, name)
    t := read_text(path)
    println t
    mem.Free(t as void*)
    mem.Free(path as void*)
end

func main:
    mut le := compress.NewByteBuf()
    compress.BufPush(le, 0x34)
    compress.BufPush(le, 0x12)
    compress.BufPush(le, 0x78)
    compress.BufPush(le, 0x56)
    compress.BufPush(le, 0x7f)
    println archive.LEGet16(le.data, 0), archive.LEGet16(le.data, 2), archive.LEGet16(le.data, 3)
    println archive.LEGet32(le.data, 0), archive.LEGet32(le.data, 1)
    mut round := compress.NewByteBuf()
    archive.LEPut32(round, 305419896)
    archive.LEPut16(round, 513)
    println archive.LEGet32(round.data, 0), archive.LEGet16(round.data, 4)
    compress.BufFree(le)
    compress.BufFree(round)

    body := "a payload that is longer than ten bytes"
    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.push(archive.MakeZipFileInput("p.txt", body as void*, body.len(), 8))
    mut z := archive.ZipCreate(files)
    files.free()
    mut ok := false
    mut small := archive.ZipExtractByNameMax(z.data, z.len, "p.txt", 10, ok)
    println ok, small.len
    mut exact := archive.ZipExtractByNameMax(z.data, z.len, "p.txt", body.len(), ok)
    exact_text := compress.BufToStrUnsafe(exact)
    println ok, exact_text == body
    mut open := archive.ZipExtractByNameMax(z.data, z.len, "p.txt", 0, ok)
    println ok, open.len
    mut none := archive.ZipExtractByNameMax(z.data, z.len, "none", 100, ok)
    println ok
    mem.Free(exact_text as void*)
    compress.BufFree(small)
    compress.BufFree(exact)
    compress.BufFree(open)
    compress.BufFree(none)
    compress.BufFree(z)

    dir := filepath.Join(os.TempDir(), "salam_archive_extra")
    os.RemoveAll(dir)
    mut rar := build_rar()
    mut listed := archive.RarList(rar.data, rar.len)
    println archive.IsRar(rar.data, rar.len), listed.len()
    archive.FreeEntries(listed)
    println archive.RarExtractAll(rar.data, rar.len, dir)
    print_text(dir, "top.txt")
    print_text(dir, "sub/inner.txt")
    escape := filepath.Join(dir, "../escape.txt")
    println os.Exists(escape)
    mem.Free(escape as void*)
    os.RemoveAll(dir)
    mem.Free(dir as void*)
    compress.BufFree(rar)
end
