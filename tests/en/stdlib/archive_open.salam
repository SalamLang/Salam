package main

import archive
import compress
import filepath
import os

const SEVENZ := """

"""

func hex_val(c: int): int:
    if c >= 97: ret c - 87 end
    ret c - 48
end

func unhex(h: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := h as u8*
    mut i := 0
    until i < h.len():
        c := bp[i] as int
        if (c >= 48 and c <= 57) or (c >= 97 and c <= 102):
            if i + 1 < h.len():
                compress.BufPush(b, hex_val(c) * 16 + hex_val(bp[i + 1] as int))
            end
            i += 2
        else:
            i++
        end
    end
    ret b
end

func make_files(): Vector<archive.FileInput>:
    mut v := Vector {} as Vector<archive.FileInput>
    v.push(archive.MakeFileInput("docs/", null, 0, true))
    v.push(archive.MakeFileInput("docs/a.txt", "hello hello hello hello" as void*, 23, false))
    v.push(archive.MakeFileInput("b.txt", "bee" as void*, 3, false))
    ret v
end

func roundtrip(label: str, format: int):
    mut files := make_files()
    mut st := 0
    mut buf := archive.CreateBuf(format, files, st)
    mut arc := archive.Open(buf.data, buf.len, "")
    println label, st, archive.FormatName(arc.format), arc.status
    mut es := archive.List(arc)
    println es.len()
    mut data := archive.Read(arc, "docs/a.txt")
    println arc.status, data.len
    compress.BufFree(data)
    mut miss := archive.Read(arc, "nope")
    println arc.status, archive.ArchiveStatusText(arc.status)
    compress.BufFree(miss)
    archive.FreeEntries(es)
    dest := filepath.Join(os.TempDir(), "salam_open_demo")
    os.RemoveAll(dest)
    n := archive.ExtractAll(arc, dest)
    println n, arc.status, os.Exists(filepath.Join(dest, "docs/a.txt")), os.Exists(filepath.Join(dest, "b.txt"))
    os.RemoveAll(dest)
    archive.Close(arc)
    compress.BufFree(buf)
    files.free()
end

func single(label: str, format: int):
    mut files := Vector {} as Vector<archive.FileInput>
    files.push(archive.MakeFileInput("x.txt", "single stream" as void*, 13, false))
    mut st := 0
    mut buf := archive.CreateBuf(format, files, st)
    mut arc := archive.Open(buf.data, buf.len, "")
    mut es := archive.List(arc)
    mut data := archive.Read(arc, "")
    println label, st, archive.FormatName(arc.format), es.len(), data.len, arc.status
    compress.BufFree(data)
    archive.FreeEntries(es)
    archive.Close(arc)
    compress.BufFree(buf)
    files.free()
end


func unsafe_cases():
    dest := filepath.Join(os.TempDir(), "salam_open_unsafe")
    os.RemoveAll(dest)
    mut zs := Vector {} as Vector<archive.ZipFileInput>
    zs.push(archive.MakeZipFileInput("ok.txt", "fine" as void*, 4, 0))
    zs.push(archive.MakeZipFileInput("../evil.txt", "bad" as void*, 3, 0))
    mut zb := archive.ZipCreate(zs)
    mut za := archive.Open(zb.data, zb.len, "")
    println archive.ExtractAll(za, dest), za.status, os.Exists(filepath.Join(dest, "ok.txt"))
    archive.Close(za)
    compress.BufFree(zb)
    mut ts := Vector {} as Vector<archive.TarFileInput>
    ts.push(archive.MakeTarSymlink("link", "../../etc"))
    mut tb := archive.TarCreate(ts)
    mut ta := archive.Open(tb.data, tb.len, "")
    println archive.ExtractAll(ta, dest), ta.status
    archive.Close(ta)
    compress.BufFree(tb)
    mut hs := Vector {} as Vector<archive.TarFileInput>
    hs.push(archive.MakeTarSymlink("d", "sub"))
    hs.push(archive.MakeTarFileInput("d/x.txt", "x" as void*, 1, false))
    mut hb := archive.TarCreate(hs)
    mut ha := archive.Open(hb.data, hb.len, "")
    println archive.ExtractAll(ha, dest), ha.status
    archive.Close(ha)
    compress.BufFree(hb)
    files := make_files()
    mut st := 0
    mut buf := archive.CreateBuf(archive.FormatZip, files, st)
    mut lim := archive.DefaultLimits()
    lim.max_entries = 2
    mut a1 := archive.OpenWith(buf.data, buf.len, "", lim)
    println archive.ExtractAll(a1, dest), a1.status
    archive.Close(a1)
    lim = archive.DefaultLimits()
    lim.max_entry = 10 as i64
    mut a2 := archive.OpenWith(buf.data, buf.len, "", lim)
    println archive.ExtractAll(a2, dest), a2.status
    mut d2 := archive.Read(a2, "docs/a.txt")
    println d2.len, a2.status
    compress.BufFree(d2)
    archive.Close(a2)
    mut big := compress.NewByteBuf()
    mut zero := compress.NewByteBuf()
    repeat 4096:
        compress.BufPush(zero, 0)
    end
    repeat 300:
        compress.BufPushBuf(big, zero)
    end
    compress.BufFree(zero)
    mut bf := Vector {} as Vector<archive.FileInput>
    bf.push(archive.MakeFileInput("z.bin", big.data, big.len, false))
    mut zbuf := archive.CreateBuf(archive.FormatTar, bf, st)
    mut gz := compress.GzipCompressBuf(zbuf)
    lim = archive.DefaultLimits()
    lim.max_ratio = 1
    mut a3 := archive.OpenWith(gz.data, gz.len, "", lim)
    println archive.ExtractAll(a3, dest), a3.status
    archive.Close(a3)
    lim = archive.DefaultLimits()
    lim.max_total = 1000000 as i64
    mut a4 := archive.OpenWith(gz.data, gz.len, "", lim)
    println a4.status, archive.ArchiveStatusText(a4.status)
    archive.Close(a4)
    made := filepath.Join(os.TempDir(), "salam_open_made.zip")
    println archive.Create(made, files), os.Exists(made)
    os.Remove(made)
    compress.BufFree(buf)
    compress.BufFree(big)
    compress.BufFree(zbuf)
    compress.BufFree(gz)
    bf.free()
    os.RemoveAll(dest)
end

func file_cases():
    dir := filepath.Join(os.TempDir(), "salam_open_files")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    mut files := make_files()
    path := filepath.Join(dir, "pack.tgz")
    println archive.Create(path, files)
    mut st := 0
    mut es := archive.ListFile(path, "", st)
    println es.len(), st
    archive.FreeEntries(es)
    out := filepath.Join(dir, "out")
    println archive.ExtractFile(path, out, "", st), st, os.Exists(filepath.Join(out, "b.txt"))
    mut arc := archive.OpenFile(path, "")
    println archive.Detect(arc.data, arc.len) == archive.FormatGzip, archive.FormatName(arc.format)
    println archive.Extract(arc, "docs/a.txt", filepath.Join(dir, "one")), os.Exists(filepath.Join(dir, "one/docs/a.txt"))
    println archive.Extract(arc, "missing", filepath.Join(dir, "one")), arc.status
    mut lim := archive.DefaultLimits()
    lim.max_entry = 5 as i64
    archive.SetLimits(arc, lim)
    println archive.Extract(arc, "docs/a.txt", filepath.Join(dir, "two")), arc.status
    archive.Close(arc)
    os.RemoveAll(dir)
    files.free()
end

func main:
    unsafe_cases()
    file_cases()
    roundtrip("zip", archive.FormatZip)
    roundtrip("tar", archive.FormatTar)
    roundtrip("tgz", archive.FormatTarGz)
    roundtrip("tbz2", archive.FormatTarBz2)
    roundtrip("tzst", archive.FormatTarZstd)
    roundtrip("rar", archive.FormatRar)
    roundtrip("7z", archive.FormatSevenZip)
    single("gz", archive.FormatGzip)
    single("bz2", archive.FormatBzip2)
    single("zst", archive.FormatZstd)
    mut z := unhex(SEVENZ)
    mut arc := archive.Open(z.data, z.len, "")
    mut es := archive.List(arc)
    println archive.FormatName(arc.format), arc.status, es.len()
    archive.FreeEntries(es)
    archive.Close(arc)
    compress.BufFree(z)
    println archive.DetectName("a.TAR.GZ"), archive.DetectName("x.tgz"), archive.DetectName("x.7z"), archive.DetectName("x.bin"), archive.DetectName("a.tar.zst"), archive.DetectName("b.zst")
    junk := archive.Open("plain text here" as void*, 15, "")
    println archive.FormatName(junk.format), junk.status, archive.ArchiveStatusText(junk.status)
    zst := archive.Open("\x28\xb5\x2f\xfdabcd" as void*, 8, "")
    println archive.FormatName(zst.format), archive.ArchiveStatusText(zst.status)
    bad := archive.OpenFile("/nonexistent/file.zip", "")
    println archive.ArchiveStatusText(bad.status)
    mut files := make_files()
    println archive.Create("/tmp/x.zst", files), archive.Create("/tmp/x.xyz", files)
    files.free()
end
