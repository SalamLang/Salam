package main

import archive
import compress
import filepath
import os

func files(): Vector<archive.FileInput>:
    mut v := Vector {} as Vector<archive.FileInput>
    v.push(archive.MakeFileInput("docs/", null, 0, true))
    v.push(archive.MakeFileInput("docs/a.txt", "hello hello hello hello" as void*, 23, false))
    v.push(archive.MakeFileInput("b.txt", "bee" as void*, 3, false))
    ret v
end

func one(dir: str, ext: str):
    path := filepath.Join(dir, "pack." + ext)
    mut fs := files()
    println ext, archive.Create(path, fs)
    fs.free()
    mut arc := archive.OpenFile(path, "")
    println "  open", archive.FormatName(arc.format), arc.status, arc.disk != 0, arc.data == null
    mut es := archive.List(arc)
    println "  list", es.len(), arc.status
    archive.FreeEntries(es)
    mut data := archive.Read(arc, "docs/a.txt")
    println "  read", compress.BufToStrUnsafe(data), arc.status
    compress.BufFree(data)
    mut none := archive.Read(arc, "missing")
    println "  missing", none.len, arc.status
    compress.BufFree(none)
    one_dir := filepath.Join(dir, "one_" + ext)
    println "  extract", archive.Extract(arc, "b.txt", one_dir), os.Exists(filepath.Join(one_dir, "b.txt"))
    all_dir := filepath.Join(dir, "all_" + ext)
    println "  all", archive.ExtractAll(arc, all_dir), arc.status, os.Exists(filepath.Join(all_dir, "docs/a.txt"))
    mut lim := archive.DefaultLimits()
    lim.max_entry = 5 as i64
    archive.SetLimits(arc, lim)
    println "  limit", archive.ExtractAll(arc, filepath.Join(dir, "lim_" + ext)), arc.status
    archive.Close(arc)
    mut st := 0
    mut listed := archive.ListFile(path, "", st)
    println "  listfile", listed.len(), st
    archive.FreeEntries(listed)
    println "  extractfile", archive.ExtractFile(path, filepath.Join(dir, "ef_" + ext), "", st), st
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_open_disk_demo")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    one(dir, "zip")
    one(dir, "tar")
    one(dir, "tgz")
    one(dir, "7z")
    one(dir, "rar")
    gz := filepath.Join(dir, "single.txt.gz")
    mut fs := Vector {} as Vector<archive.FileInput>
    fs.push(archive.MakeFileInput("single.txt", "just one file" as void*, 13, false))
    println archive.Create(gz, fs)
    fs.free()
    mut arc := archive.OpenFile(gz, "")
    println archive.FormatName(arc.format), arc.status, arc.disk != 0
    archive.Close(arc)
    bad := filepath.Join(dir, "junk.zip")
    archive.WriteBinaryFileBuf(bad, compress.BufFromStr("this is not a zip file at all, only some text"))
    mut junk := archive.OpenFile(bad, "")
    println archive.ArchiveStatusText(junk.status)
    archive.Close(junk)
    println archive.Detect("PK\x03\x04" as void*, 4) == archive.FormatZip
    os.RemoveAll(dir)
end
