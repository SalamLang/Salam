package main

import archive
import compress
import os
import fs
import filepath

func hex_val(c: int): int:
    if c >= 97: ret c - 87 end
    ret c - 48
end

func unhex(h: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := h as u8*
    mut i := 0
    until i + 1 < h.len():
        compress.BufPush(b, hex_val(bp[i] as int) * 16 + hex_val(bp[i + 1] as int))
        i += 2
    end
    ret b
end

func short(s: str): str:
    if s.len() > 40:
        ret s.substr(0, 12) + "..." + s.substr(s.len() - 12, 12)
    end
    ret s
end

func show(label: str, gz: str):
    mut z := unhex(gz)
    mut ok := false
    mut es := archive.TarGzList(z.data, z.len, ok)
    println "==", label, ok, es.len()
    each e in es:
        println e.kind, e.is_dir, e.name.len(), short(e.name), e.link.len(), short(e.link), e.size, e.mtime, e.mode
    end
    archive.FreeEntries(es)
    compress.BufFree(z)
end

func read_text(path: str): str:
    mut ok := false
    b := archive.ReadBinaryFile(path, ok)
    if not ok: ret "missing" end
    ret compress.BufToStrUnsafe(b)
end

func main:
    show("gnu", "")
    show("ustar", "1f8b08000000000002ff4bd62ba92861a02d300002331313300d04e834109833189a981a99989b1b981818311898189a9a1b31281830d0019416972416019d426d7313a902f493a802703bb3a028352db3828b61148c8251300a46c1c802008e3757a100080000")
    show("pax", "")
    show("global", "")
    show("7z", "1f8b08000000000002ff2b4e2d4bcdd32ba92861a01d300002331313300d04e8344896c1d0d4c8dcc4c8d0d004c836303037333266503060a003282d2e492c52506018a1a01814ff5c0ca360148c8251300a4618000018cd7efb00080000")

    root := filepath.Join(os.TempDir(), "salam_tar_extra")
    os.RemoveAll(root)
    gz := unhex("")
    out1 := filepath.Join(root, "gnu")
    println archive.TarGzExtractAll(gz.data, gz.len, out1)
    println read_text(filepath.Join(out1, "a.txt")), read_text(filepath.Join(out1, "hl")), read_text(filepath.Join(out1, "sl"))
    long := "g".repeat(50) + "/" + "h".repeat(50) + "/" + "i".repeat(20) + ".txt"
    println read_text(filepath.Join(out1, long))
    println read_text(filepath.Join(out1, "é日本.txt"))
    println os.Exists(filepath.Join(out1, "emptydir"))
    mut gok := false
    one := archive.TarGzExtractByName(gz.data, gz.len, "./a.txt", gok)
    println gok, compress.BufToStrUnsafe(one)
    perm := fs.Permissions(filepath.Join(out1, "a.txt"))
    mt := fs.ModTime(filepath.Join(out1, "a.txt"))
    println SALAM_OS_WINDOWS or perm == 420
    println SALAM_OS_WINDOWS or sizeof(void*) != 8 or mt == (1700000000 as i64)

    mut fl := Vector {} as Vector<archive.TarFileInput>
    d := compress.BufFromStr("payload\n")
    mut f0 := archive.MakeTarFileInput("a.txt", d.data, d.len, false)
    f0.mtime = 1700000000 as i64
    f0.mode = 0o640
    fl.push(f0)
    fl.push(archive.MakeTarFileInput("dir", null, 0, true))
    fl.push(archive.MakeTarSymlink("dir/sl", "../a.txt"))
    fl.push(archive.MakeTarHardlink("hl", "a.txt"))
    split := "p1234567890/".repeat(6) + "x/" + "n".repeat(90) + ".txt"
    fl.push(archive.MakeTarFileInput(split, d.data, d.len, false))
    deep := "q".repeat(150) + "/f.txt"
    fl.push(archive.MakeTarFileInput(deep, d.data, d.len, false))
    wide := "é日本-" + "z".repeat(200) + ".txt"
    fl.push(archive.MakeTarFileInput(wide, d.data, d.len, false))
    fl.push(archive.MakeTarSymlink("l".repeat(120), "t".repeat(130)))
    mut big := archive.MakeTarFileInput("late.txt", d.data, d.len, false)
    big.mtime = 99999999999 as i64
    fl.push(big)
    t := archive.TarCreate(fl)
    println t.len % 512
    mut es := archive.TarList(t.data, t.len)
    each e in es:
        println e.kind, e.name.len(), e.link.len(), e.size, e.mtime, e.mode
    end
    archive.FreeEntries(es)
    println archive.TarList(t.data, t.len).get(4).name == split
    out2 := filepath.Join(root, "made")
    println archive.TarExtractAll(t.data, t.len, out2)
    println read_text(filepath.Join(out2, "hl")), read_text(filepath.Join(out2, "dir/sl")), read_text(filepath.Join(out2, split)), read_text(filepath.Join(out2, wide))
    println read_text(filepath.Join(out2, "late.txt"))
    tg := archive.TarGzCreate(fl)
    mut tok := false
    mut tes := archive.TarGzList(tg.data, tg.len, tok)
    println tok, tes.len()
    archive.FreeEntries(tes)
    tl := archive.TarGzListMax(tg.data, tg.len, 1000, tok)
    println tok, tl.len()
    println archive.TarGzExtractAllMax(tg.data, tg.len, filepath.Join(root, "capped"), 1000), os.Exists(filepath.Join(root, "capped"))
    one2 := archive.TarGzExtractByNameMax(tg.data, tg.len, "late.txt", 1000, tok)
    println tok, one2.len
    one3 := archive.TarGzExtractByName(tg.data, tg.len, "late.txt", tok)
    println tok, compress.BufToStrUnsafe(one3)
    println archive.TarGzCreateFile(fl, filepath.Join(root, "x.tar.gz"))
    println archive.TarGzExtractAll(tg.data, tg.len, filepath.Join(root, "viagz"))
    println read_text(filepath.Join(root, "viagz/a.txt"))
    junk := compress.BufFromStr("not gzip data at all, just text")
    println archive.TarGzExtractAll(junk.data, junk.len, filepath.Join(root, "junk")), os.Exists(filepath.Join(root, "junk"))

    mut bad := Vector {} as Vector<archive.TarFileInput>
    bad.push(archive.MakeTarFileInput("ok.txt", d.data, d.len, false))
    bad.push(archive.MakeTarSymlink("abs", "/etc/passwd"))
    bad.push(archive.MakeTarSymlink("up", ".."))
    bad.push(archive.MakeTarSymlink("deep/up", "../../x"))
    bad.push(archive.MakeTarSymlink("mid", "a/../.."))
    bad.push(archive.MakeTarSymlink("empty", ""))
    bad.push(archive.MakeTarHardlink("hard", "../outside.txt"))
    bad.push(archive.MakeTarHardlink("hard2", "/etc/passwd"))
    bad.push(archive.MakeTarSymlink("dot", "."))
    bad.push(archive.MakeTarSymlink("dot/back", ".."))
    bad.push(archive.MakeTarFileInput("dot/escape.txt", d.data, d.len, false))
    bad.push(archive.MakeTarSymlink("good", "ok.txt"))
    b := archive.TarCreate(bad)
    sec := filepath.Join(root, "sec")
    inner := filepath.Join(sec, "inner")
    println archive.TarExtractAll(b.data, b.len, inner)
    println os.Exists(filepath.Join(sec, "escape.txt")), os.Exists(filepath.Join(sec, "outside.txt"))
    println os.Exists(filepath.Join(inner, "abs")), os.Exists(filepath.Join(inner, "up")), os.Exists(filepath.Join(inner, "hard"))
    println read_text(filepath.Join(inner, "ok.txt")), read_text(filepath.Join(inner, "good"))

    os.RemoveAll(root)
end
