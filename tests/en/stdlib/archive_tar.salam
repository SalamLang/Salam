package main

import archive
import compress
import os
import fs
import filepath
import mem
import str

mut pool_s := Vector {} as Vector<str>
mut pool_b := Vector {} as Vector<compress.ByteBuf>

func hex_val(c: int): int:
    if c >= 97: ret c - 87 end
    ret c - 48
end

func unhex(h: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := h as u8*
    mut i := 0
    until i + 1 < h.Len():
        compress.BufPush(b, hex_val(bp[i] as int) * 16 + hex_val(bp[i + 1] as int))
        i += 2
    end
    ret b
end

func keep(s: str): str:
    pool_s.Push(s)
    ret s
end

func keepb(b: compress.ByteBuf): compress.ByteBuf:
    pool_b.Push(b)
    ret b
end

func release():
    repeat pool_s.Len() in i:
        mem.Free(pool_s.Get(i) as void*)
    end
    pool_s.Free()
    repeat pool_b.Len() in i:
        mut b := pool_b.Get(i)
        compress.BufFree(b)
    end
    pool_b.Free()
end

func j(a: str, b: str): str:
    ret keep(filepath.Join(a, b))
end

func cat(a: str, b: str): str:
    mut sb := str.NewBuilder()
    str.BufAppend(sb, a)
    str.BufAppend(sb, b)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret keep(out)
end

func rep(a: str, n: int): str:
    ret keep(a.Repeat(n))
end

func short(s: str): str:
    if s.Len() > 40:
        head := keep(s.Substr(0, 12))
        tail := keep(s.Substr(s.Len() - 12, 12))
        ret cat(cat(head, "..."), tail)
    end
    ret s
end

func show(label: str, gz: str):
    mut z := unhex(gz)
    mut ok := false
    mut es := archive.TarGzList(z.data, z.len, ok)
    println "==", label, ok, es.Len()
    each e in es:
        println e.kind, e.is_dir, e.name.Len(), short(e.name), e.link.Len(), short(e.link), e.size, e.mtime, e.mode
    end
    archive.FreeEntries(es)
    compress.BufFree(z)
    release()
end

func rt(path: str): str:
    mut ok := false
    mut b := archive.ReadBinaryFile(path, ok)
    defer compress.BufFree(b)
    if not ok: ret keep(str.Clone("missing")) end
    ret keep(compress.BufToStrUnsafe(b))
end

func main:
    show("gnu", "")
    show("ustar", "1f8b08000000000002ff4bd62ba92861a02d300002331313300d04e834109833189a981a99989b1b981818311898189a9a1b31281830d0019416972416019d426d7313a902f493a802703bb3a028352db3828b61148c8251300a46c1c802008e3757a100080000")
    show("pax", "")
    show("global", "")
    show("7z", "1f8b08000000000002ff2b4e2d4bcdd32ba92861a01d300002331313300d04e8344896c1d0d4c8dcc4c8d0d004c836303037333266503060a003282d2e492c52506018a1a01814ff5c0ca360148c8251300a4618000018cd7efb00080000")

    root := j(os.TempDir(), "salam_tar_extra")
    os.RemoveAll(root)
    mut gz := unhex("")
    out1 := j(root, "gnu")
    println archive.TarGzExtractAll(gz.data, gz.len, out1)
    println rt(j(out1, "a.txt")), rt(j(out1, "hl")), rt(j(out1, "sl"))
    long := cat(cat(cat(cat(cat(rep("g", 50), "/"), rep("h", 50)), "/"), rep("i", 20)), ".txt")
    println rt(j(out1, long))
    println rt(j(out1, "é日本.txt"))
    println os.Exists(j(out1, "emptydir"))
    mut gok := false
    one := keepb(archive.TarGzExtractByName(gz.data, gz.len, "./a.txt", gok))
    println gok, keep(compress.BufToStrUnsafe(one))
    perm := fs.Permissions(j(out1, "a.txt"))
    mt := fs.ModTime(j(out1, "a.txt"))
    println SALAM_OS_WINDOWS or perm == 420
    println SALAM_OS_WINDOWS or sizeof(void*) != 8 or mt == (1700000000 as i64)

    mut fl := Vector {} as Vector<archive.TarFileInput>
    mut d := compress.BufFromStr("payload\n")
    mut f0 := archive.MakeTarFileInput("a.txt", d.data, d.len, false)
    f0.mtime = 1700000000 as i64
    f0.mode = 0o640
    fl.Push(f0)
    fl.Push(archive.MakeTarFileInput("dir", null, 0, true))
    fl.Push(archive.MakeTarSymlink("dir/sl", "../a.txt"))
    fl.Push(archive.MakeTarHardlink("hl", "a.txt"))
    split := cat(cat(cat(rep("p1234567890/", 6), "x/"), rep("n", 90)), ".txt")
    fl.Push(archive.MakeTarFileInput(split, d.data, d.len, false))
    deep := cat(rep("q", 150), "/f.txt")
    fl.Push(archive.MakeTarFileInput(deep, d.data, d.len, false))
    wide := cat(cat("é日本-", rep("z", 200)), ".txt")
    fl.Push(archive.MakeTarFileInput(wide, d.data, d.len, false))
    fl.Push(archive.MakeTarSymlink(rep("l", 120), rep("t", 130)))
    mut big := archive.MakeTarFileInput("late.txt", d.data, d.len, false)
    big.mtime = 99999999999 as i64
    fl.Push(big)
    mut t := archive.TarCreate(fl)
    println t.len % 512
    mut es := archive.TarList(t.data, t.len)
    each e in es:
        println e.kind, e.name.Len(), e.link.Len(), e.size, e.mtime, e.mode
    end
    archive.FreeEntries(es)
    mut tl4 := archive.TarList(t.data, t.len)
    println tl4.Get(4).name == split
    archive.FreeEntries(tl4)
    out2 := j(root, "made")
    println archive.TarExtractAll(t.data, t.len, out2)
    println rt(j(out2, "hl")), rt(j(out2, "dir/sl")), rt(j(out2, split)), rt(j(out2, wide))
    println rt(j(out2, "late.txt"))
    mut tg := archive.TarGzCreate(fl)
    mut tok := false
    mut tes := archive.TarGzList(tg.data, tg.len, tok)
    println tok, tes.Len()
    archive.FreeEntries(tes)
    mut tl := archive.TarGzListMax(tg.data, tg.len, 1000, tok)
    println tok, tl.Len()
    archive.FreeEntries(tl)
    println archive.TarGzExtractAllMax(tg.data, tg.len, j(root, "capped"), 1000), os.Exists(j(root, "capped"))
    one2 := keepb(archive.TarGzExtractByNameMax(tg.data, tg.len, "late.txt", 1000, tok))
    println tok, one2.len
    one3 := keepb(archive.TarGzExtractByName(tg.data, tg.len, "late.txt", tok))
    println tok, keep(compress.BufToStrUnsafe(one3))
    println archive.TarGzCreateFile(fl, j(root, "x.tar.gz"))
    println archive.TarGzExtractAll(tg.data, tg.len, j(root, "viagz"))
    println rt(j(root, "viagz/a.txt"))
    mut junk := compress.BufFromStr("not gzip data at all, just text")
    println archive.TarGzExtractAll(junk.data, junk.len, j(root, "junk")), os.Exists(j(root, "junk"))

    mut bad := Vector {} as Vector<archive.TarFileInput>
    bad.Push(archive.MakeTarFileInput("ok.txt", d.data, d.len, false))
    bad.Push(archive.MakeTarSymlink("abs", "/etc/passwd"))
    bad.Push(archive.MakeTarSymlink("up", ".."))
    bad.Push(archive.MakeTarSymlink("deep/up", "../../x"))
    bad.Push(archive.MakeTarSymlink("mid", "a/../.."))
    bad.Push(archive.MakeTarSymlink("empty", ""))
    bad.Push(archive.MakeTarHardlink("hard", "../outside.txt"))
    bad.Push(archive.MakeTarHardlink("hard2", "/etc/passwd"))
    bad.Push(archive.MakeTarSymlink("dot", "."))
    bad.Push(archive.MakeTarSymlink("dot/back", ".."))
    bad.Push(archive.MakeTarFileInput("dot/escape.txt", d.data, d.len, false))
    bad.Push(archive.MakeTarSymlink("good", "ok.txt"))
    mut b := archive.TarCreate(bad)
    sec := j(root, "sec")
    inner := j(sec, "inner")
    println archive.TarExtractAll(b.data, b.len, inner)
    println os.Exists(j(sec, "escape.txt")), os.Exists(j(sec, "outside.txt"))
    println os.Exists(j(inner, "abs")), os.Exists(j(inner, "up")), os.Exists(j(inner, "hard"))
    println rt(j(inner, "ok.txt")), rt(j(inner, "good"))

    os.RemoveAll(root)
    fl.Free()
    bad.Free()
    compress.BufFree(gz)
    compress.BufFree(d)
    compress.BufFree(t)
    compress.BufFree(tg)
    compress.BufFree(junk)
    compress.BufFree(b)
    release()
end
