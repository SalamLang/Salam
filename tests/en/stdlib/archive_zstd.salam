package main

import archive
import compress
import filepath
import os

const TAR_ZST := """
28b52ffd046865040012861311907db0413366107777857e139cf3244501e9cb223cdbf9c2a3512693565a25ef3c5a12
e051fa4f6901d23406c165dc4595f24120c465196bf00218b314fab59049a88053fe1f20a41ee49d070b1520002fcc32
ebfd690fc64c258d01a44a41001e577a0c54e2c8b80376ea006b00a316100c7b8001a63a9e9ae8531cf4c46d04150183
02d84e060e2b40389e
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func read_text(path: str): str:
    mut ok := false
    b := archive.ReadBinaryFile(path, ok)
    if not ok:
        ret "missing"
    end
    ret compress.BufToStrUnsafe(b)
end

func main:
    root := filepath.Join(os.TempDir(), "salam_archive_zstd_test")
    os.RemoveAll(root)
    os.MkdirAll(root)

    println "== files =="
    plain := filepath.Join(root, "plain.txt")
    packed := filepath.Join(root, "plain.txt.zst")
    back := filepath.Join(root, "back.txt")
    text := compress.BufFromStr("zstd files: the quick brown fox jumps over the lazy dog, again and again and again.\n".repeat(4))
    println archive.WriteBinaryFileBuf(plain, text)
    println archive.ZstdCompressFile(plain, packed)
    mut ok := false
    z := archive.ReadBinaryFile(packed, ok)
    println ok, compress.IsZstd(z.data, z.len), z.len < text.len
    println archive.ZstdDecompressFile(packed, back), read_text(back) == compress.BufToStrUnsafe(text)
    println archive.ZstdCompressFileLevel(plain, packed, 19), archive.ZstdDecompressFile(packed, back), read_text(back) == compress.BufToStrUnsafe(text)
    println archive.ZstdCompressFileLevel(plain, packed, 0), archive.ZstdDecompressFile(packed, back), read_text(back) == compress.BufToStrUnsafe(text)
    println archive.ZstdDecompressFile(plain, back)
    println archive.ZstdCompressFile(filepath.Join(root, "missing"), packed)
    println archive.ZstdDecompressFile(filepath.Join(root, "missing"), back)

    println "== tar.zst from tar and zstd =="
    tz := unhex(TAR_ZST)
    mut es := archive.TarZstdList(tz.data, tz.len, ok)
    println ok, es.Len()
    each e in es:
        println e.kind, e.is_dir, e.name, e.size
    end
    archive.FreeEntries(es)
    out1 := filepath.Join(root, "ex")
    println archive.TarZstdExtractAll(tz.data, tz.len, out1)
    println read_text(filepath.Join(out1, "a.txt")).Len(), read_text(filepath.Join(out1, "sub/b.txt")).Len(), os.Exists(filepath.Join(out1, "empty"))
    one := archive.TarZstdExtractByName(tz.data, tz.len, "a.txt", ok)
    println ok, compress.BufToStrUnsafe(one)
    miss := archive.TarZstdExtractByName(tz.data, tz.len, "nothere", ok)
    println ok, miss.len
    println archive.TarZstdListMax(tz.data, tz.len, 100, ok).Len(), ok
    println archive.TarZstdExtractAllMax(tz.data, tz.len, filepath.Join(root, "capped"), 100), os.Exists(filepath.Join(root, "capped"))
    println archive.TarZstdExtractAllMax(tz.data, tz.len, filepath.Join(root, "roomy"), 100000)
    one2 := archive.TarZstdExtractByNameMax(tz.data, tz.len, "a.txt", 100, ok)
    println ok, one2.len

    println "== tar.zst made here =="
    mut fl := Vector {} as Vector<archive.TarFileInput>
    d := compress.BufFromStr("payload\n")
    mut f0 := archive.MakeTarFileInput("a.txt", d.data, d.len, false)
    f0.mtime = 1700000000 as i64
    fl.push(f0)
    fl.push(archive.MakeTarFileInput("dir", null, 0, true))
    big := compress.BufFromStr("0123456789".repeat(1000))
    fl.push(archive.MakeTarFileInput("dir/big.txt", big.data, big.len, false))
    tg := archive.TarZstdCreate(fl)
    println compress.IsZstd(tg.data, tg.len), tg.len < 2000
    mut tes := archive.TarZstdList(tg.data, tg.len, ok)
    println ok, tes.Len()
    archive.FreeEntries(tes)
    out2 := filepath.Join(root, "made")
    println archive.TarZstdExtractAll(tg.data, tg.len, out2)
    println read_text(filepath.Join(out2, "a.txt")).trim(), read_text(filepath.Join(out2, "dir/big.txt")).Len()
    path := filepath.Join(root, "x.tar.zst")
    println archive.TarZstdCreateFile(fl, path)
    fz := archive.ReadBinaryFile(path, ok)
    println ok, compress.BufEquals(fz, tg)
    junk := compress.BufFromStr("not zstd data at all, just text")
    println archive.TarZstdExtractAll(junk.data, junk.len, filepath.Join(root, "junk")), os.Exists(filepath.Join(root, "junk"))
    jl := archive.TarZstdList(junk.data, junk.len, ok)
    println ok, jl.Len()

    os.RemoveAll(root)
end
