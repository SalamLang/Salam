package main

import audio
import compress
import testing

func two_bytes(a: int, b: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    compress.BufPush(out, a)
    compress.BufPush(out, b)
    ret out
end

func main:
    println "most significant bit first"
    src := two_bytes(0xA5, 0x3C)
    mut r := audio.BitInFromBuf(src)
    testing.AssertEqInt(audio.BitInRead(r, 4), 10)
    testing.AssertEqInt(audio.BitInRead(r, 4), 5)
    testing.AssertEqInt(audio.BitInRead(r, 8), 60)
    testing.AssertFalse(audio.BitInBad(r))

    println "single bits"
    mut r2 := audio.BitInFromBuf(src)
    testing.AssertEqInt(audio.BitInReadBit(r2), 1)
    testing.AssertEqInt(audio.BitInReadBit(r2), 0)
    testing.AssertEqInt(audio.BitInReadBit(r2), 1)
    testing.AssertEqInt(audio.BitInReadBit(r2), 0)
    testing.AssertEqInt(audio.BitInTell(r2), 4)

    println "wide and signed reads"
    mut r3 := audio.BitInFromBuf(src)
    testing.AssertEqInt(audio.BitInRead(r3, 16), 0xA53C)
    mut r4 := audio.BitInFromBuf(src)
    testing.AssertEqInt(audio.BitInReadSigned(r4, 4), -6)
    mut r5 := audio.BitInFromBuf(src)
    testing.AssertEqInt64(audio.BitInReadI64(r5, 16), 0xA53C as i64)
    mut r6 := audio.BitInFromBuf(src)
    testing.AssertEqInt(audio.BitInRead(r6, 0), 0)
    testing.AssertEqInt(audio.BitInRead(r6, 33), 0)

    println "unary codes"
    mut uw := audio.NewBitOut()
    audio.BitOutWriteUnary(uw, 0)
    audio.BitOutWriteUnary(uw, 3)
    audio.BitOutWriteUnary(uw, 5)
    ubuf := audio.BitOutFinish(uw)
    mut ur := audio.BitInFromBuf(ubuf)
    testing.AssertEqInt(audio.BitInUnary(ur), 0)
    testing.AssertEqInt(audio.BitInUnary(ur), 3)
    testing.AssertEqInt(audio.BitInUnary(ur), 5)

    println "skip, align and seek"
    mut r7 := audio.BitInFromBuf(src)
    audio.BitInSkip(r7, 8)
    testing.AssertEqInt(audio.BitInRead(r7, 8), 60)
    mut r8 := audio.BitInFromBuf(src)
    audio.BitInRead(r8, 3)
    audio.BitInAlign(r8)
    testing.AssertEqInt(audio.BitInRead(r8, 8), 60)
    mut r9 := audio.BitInFromBuf(src)
    audio.BitInSeek(r9, 8)
    testing.AssertEqInt(audio.BitInRead(r9, 8), 60)
    audio.BitInSeek(r9, 4)
    testing.AssertEqInt(audio.BitInRead(r9, 4), 5)
    mut r10 := audio.BitInFromBuf(src)
    testing.AssertEqInt(audio.BitInLeft(r10), 16)
    audio.BitInRead(r10, 5)
    testing.AssertEqInt(audio.BitInLeft(r10), 11)

    println "reading past the end sets the bad flag"
    mut short := audio.NewBitIn(src.data, 1)
    audio.BitInRead(short, 16)
    testing.AssertTrue(audio.BitInBad(short))

    println "writer round-trip"
    mut w := audio.NewBitOut()
    audio.BitOutWrite(w, 10, 4)
    audio.BitOutWrite(w, 5, 4)
    audio.BitOutWrite(w, 60, 8)
    out := audio.BitOutFinish(w)
    testing.AssertEqInt(compress.BufLen(out), 2)
    testing.AssertEqInt(compress.BufGet(out, 0), 0xA5)
    testing.AssertEqInt(compress.BufGet(out, 1), 0x3C)

    println "writer pads the last byte"
    mut w2 := audio.NewBitOut()
    audio.BitOutWrite(w2, 1, 1)
    testing.AssertEqInt(audio.BitOutLen(w2), 0)
    out2 := audio.BitOutFinish(w2)
    testing.AssertEqInt(compress.BufLen(out2), 1)
    testing.AssertEqInt(compress.BufGet(out2, 0), 128)

    println "a long value survives the full width"
    mut w3 := audio.NewBitOut()
    audio.BitOutWrite(w3, 0x123456 as i64, 24)
    out3 := audio.BitOutFinish(w3)
    mut r11 := audio.BitInFromBuf(out3)
    testing.AssertEqInt(audio.BitInRead(r11, 24), 0x123456)

    audio.BitOutFree(w)
    audio.BitOutFree(w2)
    audio.BitOutFree(w3)
    audio.BitOutFree(uw)
    compress.BufFree(src)
    ret testing.Summary()
end
