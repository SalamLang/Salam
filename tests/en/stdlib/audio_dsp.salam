package main

import audio
import audio.dsp
import math
import testing

func tone(rate: int, freq: f64, frames: int): audio.Clip:
    mut c := audio.New(rate, 1, frames)
    mut i := 0
    until i < frames:
        audio.SetSample(c, i, 0, math.Sin(2.0 * math.PI * freq * (i as f64) / (rate as f64)))
        i += 1
    end
    ret c
end

func main:
    println "powers of two"
    testing.AssertTrue(dsp.IsPow2(1024))
    testing.AssertFalse(dsp.IsPow2(1000))
    testing.AssertFalse(dsp.IsPow2(0))
    testing.AssertEqInt(dsp.NextPow2(1000), 1024)
    testing.AssertEqInt(dsp.NextPow2(1024), 1024)
    testing.AssertEqInt(dsp.NextPow2(1), 1)

    println "complex arithmetic"
    a := dsp.Complex { re = 3.0, im = 4.0 }
    b := dsp.Complex { re = 1.0, im = -2.0 }
    testing.AssertEqFloat(dsp.CAbs(a), 5.0, 0.000000001)
    testing.AssertEqFloat(dsp.CAdd(a, b).re, 4.0, 0.0)
    testing.AssertEqFloat(dsp.CAdd(a, b).im, 2.0, 0.0)
    testing.AssertEqFloat(dsp.CSub(a, b).im, 6.0, 0.0)
    testing.AssertEqFloat(dsp.CMul(a, b).re, 11.0, 0.000000001)
    testing.AssertEqFloat(dsp.CMul(a, b).im, -2.0, 0.000000001)
    testing.AssertEqFloat(dsp.CScale(a, 2.0).re, 6.0, 0.0)
    testing.AssertEqFloat(dsp.CConj(a).im, -4.0, 0.0)
    testing.AssertEqFloat(dsp.CArg(dsp.Complex { re = 0.0, im = 1.0 }), math.PI / 2.0, 0.000000001)
    polar := dsp.CFromPolar(2.0, 0.0)
    testing.AssertEqFloat(polar.re, 2.0, 0.000000001)

    println "a complex exponential gives one peak"
    n := 64
    k := 5
    mut re := Vector {} as Vector<f64>
    mut im := Vector {} as Vector<f64>
    mut re0 := Vector {} as Vector<f64>
    mut im0 := Vector {} as Vector<f64>
    mut i := 0
    until i < n:
        ang := 2.0 * math.PI * (k as f64) * (i as f64) / (n as f64)
        re.push(math.Cos(ang))
        im.push(math.Sin(ang))
        re0.push(math.Cos(ang))
        im0.push(math.Sin(ang))
        i += 1
    end
    testing.AssertTrue(dsp.FFTVec(re, im))
    mags := dsp.Magnitude(re.ref(0), im.ref(0), n)
    testing.AssertEqInt(dsp.PeakBin(mags), k)
    testing.AssertEqFloat(mags.get(k), n as f64, 0.000001)
    mut leak := 0.0
    mut bin := 0
    until bin < n:
        if bin != k and mags.get(bin) > leak:
            leak = mags.get(bin)
        end
        bin += 1
    end
    testing.AssertMsg(leak < 0.000000001, "energy should not leak outside the peak bin")
    testing.AssertEqFloat(dsp.BinFrequency(k, n, 48000), 3750.0, 0.000000001)

    println "the inverse puts it back"
    testing.AssertTrue(dsp.IFFTVec(re, im))
    mut worst := 0.0
    mut m := 0
    until m < n:
        d := math.Abs(re.get(m) - re0.get(m))
        if d > worst:
            worst = d
        end
        e := math.Abs(im.get(m) - im0.get(m))
        if e > worst:
            worst = e
        end
        m += 1
    end
    testing.AssertMsg(worst < 0.000000001, "the round-trip should return the input")
    testing.AssertFalse(dsp.FFT(re.ref(0), im.ref(0), 15))
    testing.AssertEqInt(dsp.PeakBin(Vector {} as Vector<f64>), -1)

    println "windows"
    testing.AssertEqFloat(dsp.BesselI0(0.0), 1.0, 0.000000001)
    hann := dsp.MakeWindow(dsp.WindowHann, 9, 0.0)
    testing.AssertEqInt(hann.len(), 9)
    testing.AssertEqFloat(hann.get(0), 0.0, 0.000000001)
    testing.AssertEqFloat(hann.get(8), 0.0, 0.000000001)
    testing.AssertEqFloat(hann.get(4), 1.0, 0.000000001)
    testing.AssertEqFloat(dsp.WindowValue(dsp.WindowRectangular, 0, 9, 0.0), 1.0, 0.0)
    testing.AssertEqFloat(dsp.WindowValue(dsp.WindowHamming, 0, 9, 0.0), 0.08, 0.000000001)
    testing.AssertEqFloat(dsp.MakeWindow(dsp.WindowKaiser, 9, 8.6).get(4), 1.0, 0.000000001)
    testing.AssertEqFloat(dsp.MakeWindow(dsp.WindowBlackman, 9, 0.0).get(4), 1.0, 0.000000001)
    testing.AssertEqFloat(dsp.MakeWindow(dsp.WindowSine, 9, 0.0).get(4), 1.0, 0.000000001)
    testing.AssertEqFloat(dsp.MakeWindow(dsp.WindowVorbis, 9, 0.0).get(0), 0.0, 0.000000001)
    testing.AssertEqStr(dsp.WindowName(dsp.WindowHann), "hann")
    testing.AssertEqStr(dsp.WindowName(99), "unknown")
    testing.AssertEqFloat(dsp.WindowSum(dsp.WindowRectangular, 8, 0.0), 8.0, 0.0)
    mut wbuf := Vector {} as Vector<f64>
    mut wi := 0
    until wi < 8:
        wbuf.push(1.0)
        wi += 1
    end
    dsp.ApplyWindow(wbuf.ref(0), 8, dsp.WindowHann, 0.0)
    testing.AssertEqFloat(wbuf.get(0), 0.0, 0.000000001)

    println "biquad responses follow the cookbook"
    lp := dsp.LowPass(1000.0, 0.707, 48000)
    testing.AssertMsg(dsp.BiquadResponse(lp, 100.0, 48000) > 0.99, "a low pass should pass 100 Hz")
    testing.AssertEqFloat(dsp.BiquadResponse(lp, 1000.0, 48000), 0.7071, 0.01)
    testing.AssertMsg(dsp.BiquadResponse(lp, 10000.0, 48000) < 0.02, "a low pass should stop 10 kHz")
    hp := dsp.HighPass(1000.0, 0.707, 48000)
    testing.AssertMsg(dsp.BiquadResponse(hp, 10000.0, 48000) > 0.99, "a high pass should pass 10 kHz")
    testing.AssertMsg(dsp.BiquadResponse(hp, 100.0, 48000) < 0.02, "a high pass should stop 100 Hz")
    bp := dsp.BandPass(1000.0, 1.0, 48000)
    testing.AssertEqFloat(dsp.BiquadResponse(bp, 1000.0, 48000), 1.0, 0.01)
    testing.AssertMsg(dsp.BiquadResponse(bp, 100.0, 48000) < 0.2, "a band pass should stop 100 Hz")
    nt := dsp.Notch(1000.0, 1.0, 48000)
    testing.AssertMsg(dsp.BiquadResponse(nt, 1000.0, 48000) < 0.01, "a notch should stop its centre")
    testing.AssertMsg(dsp.BiquadResponse(nt, 100.0, 48000) > 0.9, "a notch should pass elsewhere")
    ap := dsp.AllPass(1000.0, 0.707, 48000)
    testing.AssertEqFloat(dsp.BiquadResponse(ap, 500.0, 48000), 1.0, 0.000001)
    pk := dsp.Peaking(1000.0, 1.0, 6.0, 48000)
    testing.AssertEqFloat(dsp.BiquadResponse(pk, 1000.0, 48000), 1.9952623149688795, 0.01)
    ls := dsp.LowShelf(1000.0, 0.707, 6.0, 48000)
    testing.AssertMsg(dsp.BiquadResponse(ls, 50.0, 48000) > 1.9, "a low shelf should lift the bottom")
    testing.AssertEqFloat(dsp.BiquadResponse(ls, 20000.0, 48000), 1.0, 0.05)
    hs := dsp.HighShelf(1000.0, 0.707, 6.0, 48000)
    testing.AssertMsg(dsp.BiquadResponse(hs, 20000.0, 48000) > 1.9, "a high shelf should lift the top")

    println "filtering a real tone"
    mut hi := tone(48000, 10000.0, 2048)
    before := audio.RMS(hi)
    dsp.BiquadProcessAll(lp, hi)
    after := audio.RMS(hi)
    testing.AssertMsg(audio.GainToDb(after / before) < -20.0, "the low pass should cut a 10 kHz tone")
    mut lo := tone(48000, 100.0, 2048)
    lo_before := audio.RMS(lo)
    dsp.BiquadProcessAll(lp, lo)
    testing.AssertMsg(audio.GainToDb(audio.RMS(lo) / lo_before) > -1.0, "the low pass should keep a 100 Hz tone")
    mut step := dsp.LowPass(1000.0, 0.707, 48000)
    dsp.BiquadStep(step, 1.0)
    dsp.BiquadReset(step)
    testing.AssertEqFloat(step.z1, 0.0, 0.0)
    testing.AssertEqFloat(step.z2, 0.0, 0.0)

    println "resampling keeps the signal"
    src := tone(44100, 440.0, 4410)
    up := dsp.ResampleSinc(src, 48000, 16)
    testing.AssertEqInt(up.rate, 48000)
    testing.AssertEqInt(up.frames, 4800)
    back := dsp.ResampleSinc(up, 44100, 16)
    testing.AssertEqInt(back.frames, 4410)
    inner_a := audio.Slice(src, 64, src.frames - 128)
    inner_b := audio.Slice(back, 64, back.frames - 128)
    testing.AssertMsg(dsp.Correlation(inner_a, inner_b) > 0.999, "sinc resampling should keep the signal")
    cub := dsp.ResampleCubic(src, 48000)
    cback := dsp.ResampleCubic(cub, 44100)
    inner_c := audio.Slice(cback, 64, cback.frames - 128)
    testing.AssertMsg(dsp.Correlation(inner_a, inner_c) > 0.999, "cubic resampling should keep the signal")
    lin := dsp.ResampleTo(src, 48000, dsp.QualityLinear)
    testing.AssertEqInt(lin.rate, 48000)
    testing.AssertEqInt(dsp.ResampleTo(src, 48000, dsp.QualityCubic).rate, 48000)
    testing.AssertEqInt(dsp.ResampleTo(src, 48000, dsp.QualitySinc).rate, 48000)
    same := dsp.ResampleSinc(src, 44100, 16)
    testing.AssertEqFloat(dsp.Correlation(src, same), 1.0, 0.000001)
    testing.AssertEqFloat(dsp.Correlation(src, audio.Clip {}), 0.0, 0.0)

    println "removing a dc offset"
    mut dc := tone(8000, 100.0, 800)
    audio.Scale(dc, 0.5)
    mut j := 0
    until j < dc.frames:
        audio.AddSample(dc, j, 0, 0.25)
        j += 1
    end
    testing.AssertMsg(audio.DcOffset(dc) > 0.2, "the offset should be there first")
    dsp.DCRemove(dc)
    testing.AssertMsg(math.Abs(audio.DcOffset(dc)) < 0.000001, "the offset should be gone")

    audio.Free(hi)
    audio.Free(lo)
    audio.Free(src)
    audio.Free(up)
    audio.Free(back)
    audio.Free(cub)
    audio.Free(cback)
    audio.Free(lin)
    audio.Free(same)
    audio.Free(inner_a)
    audio.Free(inner_b)
    audio.Free(inner_c)
    audio.Free(dc)
    ret testing.Summary()
end
