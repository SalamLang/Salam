package main

import audio
import audio.dsp
import audio.synth
import math

func main:
    println "spectrum helpers"
    n := 8
    mut re := Vector {} as Vector<f64>
    mut im := Vector {} as Vector<f64>
    mut i := 0
    until i < n:
        re.push(math.Cos(2.0 * math.PI * 2.0 * (i as f64) / (n as f64)))
        im.push(0.0)
        i++
    end
    orig := re.get(1)
    println dsp.FFT(re.ref(0), im.ref(0), n)
    pw := dsp.PowerSpectrum(re.ref(0), im.ref(0), n)
    println pw.len(), math.Round(pw.get(2)), math.Round(pw.get(6)), pw.get(0) < 0.000001
    ph := dsp.Phase(re.ref(0), im.ref(0), n)
    println ph.len(), math.Abs(ph.get(2)) < 0.000001
    println dsp.IFFT(re.ref(0), im.ref(0), n)
    println math.Abs(re.get(1) - orig) < 0.000000001, math.Abs(im.get(1)) < 0.000000001
    println dsp.IFFT(re.ref(0), im.ref(0), 6)

    println "biquad over a clip"
    mut src := synth.Tone(2000.0, 0.05, 8000, synth.WaveSine)
    mut low := audio.Clone(src)
    mut lp := dsp.LowPass(200.0, 0.707, 8000)
    dsp.BiquadProcess(lp, low, 0)
    println low.frames == src.frames, audio.RMS(low) < audio.RMS(src) * 0.2
    mut again := audio.Clone(src)
    lp2 := dsp.LowPass(200.0, 0.707, 8000)
    dsp.BiquadProcessAll(lp2, again)
    println audio.Sample(again, 100, 0) == audio.Sample(low, 100, 0)
    mut keep := audio.Clone(src)
    mut hp := dsp.HighPass(200.0, 0.707, 8000)
    dsp.BiquadProcess(hp, keep, 0)
    println audio.RMS(keep) > audio.RMS(src) * 0.9
    mut untouched := audio.Clone(src)
    mut any := dsp.LowPass(200.0, 0.707, 8000)
    dsp.BiquadProcess(any, untouched, 5)
    println audio.Sample(untouched, 100, 0) == audio.Sample(src, 100, 0)

    println "delay"
    mut d := audio.New(1000, 1, 100)
    audio.SetSample(d, 0, 0, 1.0)
    dsp.Delay(d, 0.01, 0.5, 1.0)
    println audio.Sample(d, 0, 0), audio.Sample(d, 9, 0), audio.Sample(d, 10, 0), audio.Sample(d, 11, 0)
    mut skipped := audio.New(1000, 1, 100)
    audio.SetSample(skipped, 0, 0, 1.0)
    dsp.Delay(skipped, 0.0, 0.5, 1.0)
    dsp.Delay(skipped, 5.0, 0.5, 1.0)
    println audio.Sample(skipped, 0, 0), audio.Peak(skipped)

    println "oscillator"
    mut o := synth.NewOsc(synth.WaveSquare, 1000.0, 8000)
    println o.wave == synth.WaveSquare, o.freq, o.rate
    mut seq := ""
    mut k := 0
    until k < 16:
        v := synth.OscNext(o)
        seq += v > 0.0 ? "+" : "-"
        k++
    end
    println seq
    mut saw := synth.NewOsc(synth.WaveSaw, 2000.0, 8000)
    println synth.OscNext(saw), synth.OscNext(saw), synth.OscNext(saw), synth.OscNext(saw), synth.OscNext(saw)
    mut sine := synth.NewOsc(synth.WaveSine, 1000.0, 8000)
    println synth.OscNext(sine), math.Abs(synth.OscNext(sine) - math.Sin(math.PI / 4.0)) < 0.000001
    mut stopped := synth.NewOsc(synth.WaveSaw, 440.0, 0)
    println synth.OscNext(stopped), synth.OscNext(stopped)

    audio.Free(src)
    audio.Free(low)
    audio.Free(again)
    audio.Free(keep)
    audio.Free(untouched)
    audio.Free(d)
    audio.Free(skipped)
end
