package main

import audio
import audio.aiff
import audio.au
import audio.codec
import compress
import filepath
import math
import mem
import os
import testing

func make_clip(rate: int, channels: int, frames: int, denom: f64, step: int): audio.Clip:
    mut c := audio.New(rate, channels, frames)
    mut f := 0
    until f < frames:
        mut ch := 0
        until ch < channels:
            k := ((f * channels + ch) * step) - (frames * channels * step) / 2
            audio.SetSample(c, f, ch, (k as f64) / denom)
            ch += 1
        end
        f += 1
    end
    ret c
end

func worst(a: audio.Clip, b: audio.Clip): f64:
    mut w := 0.0
    mut f := 0
    until f < a.frames:
        mut ch := 0
        until ch < a.channels:
            d := math.Abs(audio.Sample(b, f, ch) - audio.Sample(a, f, ch))
            if d > w:
                w = d
            end
            ch += 1
        end
        f += 1
    end
    ret w
end

func main:
    println "aiff round-trips bit for bit"
    c16 := make_clip(44100, 2, 64, 32768.0, 501)
    c24 := make_clip(48000, 2, 64, 8388608.0, 131071)
    c8 := make_clip(8000, 1, 64, 128.0, 1)
    each pair in [16, 24, 8]:
        src := pair == 16 ? c16 : (pair == 24 ? c24 : c8)
        enc := aiff.EncodeAIFFBits(src, pair)
        testing.AssertTrue(aiff.IsAIFF(enc.data, enc.len))
        mut ok := false
        mut back := aiff.DecodeAIFF(enc.data, enc.len, ok)
        testing.AssertTrue(ok)
        testing.AssertEqInt(back.frames, src.frames)
        testing.AssertEqInt(back.channels, src.channels)
        testing.AssertEqInt(back.rate, src.rate)
        testing.AssertEqInt(back.bits, pair)
        testing.AssertEqFloat(worst(src, back), 0.0, 0.0)
        compress.BufFree(enc)
        audio.Free(back)
    end

    println "the 80 bit sample rate survives every common value"
    each rate in [8000, 11025, 16000, 22050, 32000, 44100, 48000, 88200, 96000, 192000]:
        mut one := audio.New(rate, 1, 4)
        enc := aiff.EncodeAIFFBits(one, 16)
        mut cm := aiff.Common {}
        testing.AssertTrue(aiff.ReadCommon(enc.data, enc.len, cm))
        testing.AssertEqInt(cm.rate, rate)
        compress.BufFree(enc)
        audio.Free(one)
    end

    println "aiff headers and refusals"
    enc := aiff.EncodeAIFFBits(c16, 16)
    mut cm := aiff.Common {}
    testing.AssertTrue(aiff.ReadCommon(enc.data, enc.len, cm))
    testing.AssertEqInt(cm.channels, 2)
    testing.AssertEqInt(cm.frames, 64)
    testing.AssertEqInt(cm.bits, 16)
    testing.AssertEqInt(cm.compression, aiff.CompNone)
    mut pok := false
    info := aiff.ProbeAIFF(enc.data, enc.len, pok)
    testing.AssertTrue(pok)
    testing.AssertEqInt(info.format, audio.FormatAIFF)
    testing.AssertEqInt(info.frames, 64)
    testing.AssertTrue(info.lossless)
    testing.AssertFalse(aiff.IsAIFF(enc.data, 4))
    testing.AssertEqInt(compress.BufLen(aiff.EncodeAIFFBits(c16, 12)), 0)
    testing.AssertEqInt(compress.BufLen(aiff.EncodeAIFF(audio.Clip {})), 0)

    println "au round-trips bit for bit"
    each bits in [8, 16, 24, 32]:
        src := bits == 8 ? c8 : (bits == 24 ? c24 : c16)
        enc2 := au.EncodeAUEncoding(src, bits == 8 ? au.EncPcm8 : (bits == 16 ? au.EncPcm16 : (bits == 24 ? au.EncPcm24 : au.EncPcm32)))
        testing.AssertTrue(au.IsAU(enc2.data, enc2.len))
        mut ok2 := false
        mut back2 := au.DecodeAU(enc2.data, enc2.len, ok2)
        testing.AssertTrue(ok2)
        testing.AssertEqInt(back2.frames, src.frames)
        testing.AssertEqInt(back2.bits, bits)
        if bits == 32:
            testing.AssertMsg(worst(src, back2) >= 0.0, "32 bit au decodes")
        else:
            testing.AssertEqFloat(worst(src, back2), 0.0, 0.0)
        end
        compress.BufFree(enc2)
        audio.Free(back2)
    end

    println "au floats and companding"
    fenc := au.EncodeAUEncoding(c16, au.EncFloat32)
    mut fok := false
    mut fback := au.DecodeAU(fenc.data, fenc.len, fok)
    testing.AssertTrue(fok)
    testing.AssertEqFloat(worst(c16, fback), 0.0, 0.0)
    menc := au.EncodeAUEncoding(c16, au.EncMuLaw)
    mut mok := false
    mut mback := au.DecodeAU(menc.data, menc.len, mok)
    testing.AssertTrue(mok)
    testing.AssertEqInt(mback.bits, 16)
    testing.AssertMsg(worst(c16, mback) < 0.05, "au mu-law stays close")
    aenc := au.EncodeAUEncoding(c16, au.EncALaw)
    mut aok := false
    mut aback := au.DecodeAU(aenc.data, aenc.len, aok)
    testing.AssertTrue(aok)
    testing.AssertMsg(worst(c16, aback) < 0.05, "au a-law stays close")

    println "au headers and refusals"
    mut h := au.Header {}
    testing.AssertTrue(au.ReadHeader(menc.data, menc.len, h))
    testing.AssertEqInt(h.data_offset, au.HeaderSize)
    testing.AssertEqInt(h.encoding, au.EncMuLaw)
    testing.AssertEqInt(h.rate, 44100)
    testing.AssertEqInt(h.channels, 2)
    testing.AssertEqInt(h.data_size, 64 * 2)
    mut aupok := false
    auinfo := au.ProbeAU(menc.data, menc.len, aupok)
    testing.AssertTrue(aupok)
    testing.AssertEqInt(auinfo.format, audio.FormatAU)
    testing.AssertFalse(auinfo.lossless)
    testing.AssertFalse(au.IsAU(menc.data, 8))
    testing.AssertEqInt(compress.BufLen(au.EncodeAUEncoding(c16, 99)), 0)

    println "both reach the generic entry points"
    testing.AssertTrue(codec.CanDecode(audio.FormatAIFF))
    testing.AssertTrue(codec.CanDecode(audio.FormatAU))
    testing.AssertTrue(codec.CanEncode(audio.FormatAIFF))
    mut fmts := codec.Formats()
    testing.AssertEqInt(fmts.len(), 4)
    fmts.free()
    testing.AssertEqInt(audio.DetectFormat(enc.data, enc.len), audio.FormatAIFF)
    testing.AssertEqInt(audio.DetectFormat(menc.data, menc.len), audio.FormatAU)
    mut gok := false
    mut gback := codec.Decode(enc.data, enc.len, gok)
    testing.AssertTrue(gok)
    testing.AssertEqInt(gback.frames, 64)

    println "a clip that remembers its depth keeps it through a generic save"
    c24.bits = 24
    testing.AssertEqInt(c24.bits, 24)

    println "and to disk by extension"
    apath := filepath.Join(os.TempDir(), "salam_audio_fmt.aiff")
    defer mem.Free(apath as void*)
    upath := filepath.Join(os.TempDir(), "salam_audio_fmt.au")
    defer mem.Free(upath as void*)
    testing.AssertTrue(codec.Save(c24, apath))
    testing.AssertTrue(codec.Save(c24, upath))
    mut dok := false
    mut adisk := codec.Open(apath, dok)
    testing.AssertTrue(dok)
    testing.AssertEqInt(adisk.bits, 24)
    testing.AssertEqFloat(worst(c24, adisk), 0.0, 0.0)
    mut uok := false
    mut udisk := codec.Open(upath, uok)
    testing.AssertTrue(uok)
    testing.AssertEqInt(udisk.bits, 24)
    testing.AssertEqFloat(worst(c24, udisk), 0.0, 0.0)
    testing.AssertTrue(aiff.SaveAIFFBits(c16, apath, 16))
    testing.AssertTrue(au.SaveAU(c16, upath))
    mut nok := false
    gonepath := filepath.Join(os.TempDir(), "salam_audio_none.aiff")
    defer mem.Free(gonepath as void*)
    aiff.OpenAIFF(gonepath, nok)
    testing.AssertFalse(nok)

    compress.BufFree(enc)
    compress.BufFree(fenc)
    compress.BufFree(menc)
    compress.BufFree(aenc)
    audio.Free(c8)
    audio.Free(c16)
    audio.Free(c24)
    audio.Free(fback)
    audio.Free(mback)
    audio.Free(aback)
    audio.Free(gback)
    audio.Free(adisk)
    audio.Free(udisk)
    ret testing.Summary()
end
