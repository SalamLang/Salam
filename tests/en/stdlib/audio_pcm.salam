package main

import audio
import compress
import math

func main:
    mut c := audio.New(8000, 1, 4)
    audio.SetSample(c, 0, 0, 0.5)
    audio.SetSample(c, 1, 0, -0.5)
    audio.SetSample(c, 2, 0, 0.25)
    audio.SetSample(c, 3, 0, 0.0)

    println "integer pcm"
    mut le := compress.NewByteBuf()
    audio.EncodePcm(le, c, 16, false, false)
    mut be := compress.NewByteBuf()
    audio.EncodePcm(be, c, 16, true, false)
    println compress.BufLen(le), compress.BufLen(be)
    println compress.BufGet(le, 0), compress.BufGet(le, 1), compress.BufGet(be, 0), compress.BufGet(be, 1)
    mut a := audio.New(8000, 1, 4)
    mut b := audio.New(8000, 1, 4)
    println audio.DecodePcm(le.data, 0, a, 16, false, false)
    println audio.DecodePcm(be.data, 0, b, 16, true, false)
    println audio.Sample(a, 0, 0), audio.Sample(a, 1, 0), audio.Sample(a, 2, 0), audio.Sample(a, 3, 0)
    println audio.Sample(b, 0, 0) == audio.Sample(a, 0, 0), audio.Sample(b, 1, 0) == audio.Sample(a, 1, 0)

    println "unsigned eight bit"
    mut u8 := compress.NewByteBuf()
    audio.EncodePcm(u8, c, 8, false, true)
    println compress.BufLen(u8), compress.BufGet(u8, 0), compress.BufGet(u8, 3)
    mut d := audio.New(8000, 1, 4)
    println audio.DecodePcm(u8.data, 0, d, 8, false, true)
    println math.Abs(audio.Sample(d, 0, 0) - 0.5) < 0.01

    println "float pcm"
    mut f32 := compress.NewByteBuf()
    audio.EncodeFloatPcm(f32, c, 32, false)
    mut f64 := compress.NewByteBuf()
    audio.EncodeFloatPcm(f64, c, 64, true)
    println compress.BufLen(f32), compress.BufLen(f64)
    mut e := audio.New(8000, 1, 4)
    mut g := audio.New(8000, 1, 4)
    println audio.DecodeFloatPcm(f32.data, f32.len, 0, e, 32, false)
    println audio.DecodeFloatPcm(f64.data, f64.len, 0, g, 64, true)
    println audio.Sample(e, 1, 0), audio.Sample(g, 2, 0)
    println audio.DecodeFloatPcm(f32.data, 3, 0, e, 32, false)

    println "companded pcm"
    mut mu := compress.NewByteBuf()
    audio.EncodeLawPcm(mu, c, false)
    mut al := compress.NewByteBuf()
    audio.EncodeLawPcm(al, c, true)
    println compress.BufLen(mu), compress.BufLen(al)
    mut h := audio.New(8000, 1, 4)
    mut k := audio.New(8000, 1, 4)
    println audio.DecodeLawPcm(mu.data, 0, h, false)
    println audio.DecodeLawPcm(al.data, 0, k, true)
    println math.Abs(audio.Sample(h, 1, 0) + 0.5) < 0.02, math.Abs(audio.Sample(k, 1, 0) + 0.5) < 0.02
    println audio.Sample(h, 3, 0), audio.Sample(k, 3, 0) < 0.001

    println "mix at an offset"
    mut dst := audio.New(8000, 1, 6)
    mut src := audio.New(8000, 1, 3)
    audio.SetSample(src, 0, 0, 0.5)
    audio.SetSample(src, 1, 0, 0.25)
    audio.SetSample(src, 2, 0, 1.0)
    audio.MixAt(dst, src, 2, 0.5)
    println audio.Sample(dst, 1, 0), audio.Sample(dst, 2, 0), audio.Sample(dst, 3, 0), audio.Sample(dst, 4, 0), audio.Sample(dst, 5, 0)
    audio.MixAt(dst, src, 5, 1.0)
    println audio.Sample(dst, 5, 0)
    audio.MixAt(dst, src, -2, 1.0)
    println audio.Sample(dst, 0, 0), audio.Sample(dst, 1, 0)

    println "rms of a range"
    println audio.RMSRange(src, 0, 1), audio.RMSRange(src, 2, 1), audio.RMSRange(src, 0, 0)
    println audio.RMSRange(src, 1, 100) == audio.RMSRange(src, 1, 2)
    println audio.RMSRange(src, 0, 3) == audio.RMS(src)

    println "bit writer"
    mut w := audio.NewMsbWriter()
    audio.MsbWriteBit(w, 1)
    audio.MsbWriteBit(w, 0)
    audio.MsbWriteBit(w, 1)
    println audio.MsbLen(w)
    audio.MsbPad(w)
    println audio.MsbLen(w)
    audio.MsbWrite(w, 255, 8)
    out := audio.MsbFinish(w)
    println compress.BufLen(out), compress.BufGet(out, 0), compress.BufGet(out, 1)
    mut p := audio.NewMsbWriter()
    audio.MsbPad(p)
    println audio.MsbLen(p)
    audio.MsbFree(w)
    audio.MsbFree(p)

    compress.BufFree(le)
    compress.BufFree(be)
    compress.BufFree(u8)
    compress.BufFree(f32)
    compress.BufFree(f64)
    compress.BufFree(mu)
    compress.BufFree(al)
    audio.Free(c)
    audio.Free(a)
    audio.Free(b)
    audio.Free(d)
    audio.Free(e)
    audio.Free(g)
    audio.Free(h)
    audio.Free(k)
    audio.Free(dst)
    audio.Free(src)
end
