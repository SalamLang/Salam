package main

import archive
import audio
import audio.aiff
import audio.au
import audio.codec
import audio.wav
import compress
import filepath
import math
import mem
import os

func main:
    mut c := audio.New(8000, 1, 32)
    audio.SetSample(c, 3, 0, 0.5)
    audio.SetSample(c, 4, 0, -0.5)
    c.bits = 16

    println "wav files"
    wpath := filepath.Join(os.TempDir(), "salam_audio_save.wav")
    defer mem.Free(wpath as void*)
    println wav.SaveWAV(c, wpath)
    mut wok := false
    wback := wav.OpenWAV(wpath, wok)
    println wok, wback.rate, wback.channels, wback.bits, wback.frames
    println math.Abs(audio.Sample(wback, 3, 0) - 0.5) < 0.001, math.Abs(audio.Sample(wback, 4, 0) + 0.5) < 0.001
    fpath := filepath.Join(os.TempDir(), "salam_audio_save_f32.wav")
    defer mem.Free(fpath as void*)
    println wav.SaveWAVFloat(c, fpath)
    mut fok := false
    fback := wav.OpenWAV(fpath, fok)
    println fok, fback.bits, audio.Sample(fback, 3, 0), audio.Sample(fback, 4, 0)
    println wav.SaveWAV(c, filepath.Join(os.TempDir(), "salam_no_such_dir/x.wav"))

    println "aiff file"
    apath := filepath.Join(os.TempDir(), "salam_audio_save.aiff")
    defer mem.Free(apath as void*)
    println aiff.SaveAIFF(c, apath)
    mut aok := false
    aback := aiff.OpenAIFF(apath, aok)
    println aok, aback.rate, aback.bits, aback.frames
    println math.Abs(audio.Sample(aback, 3, 0) - 0.5) < 0.001

    println "au encode and open"
    enc := au.EncodeAU(c)
    println au.IsAU(enc.data, enc.len), compress.BufLen(enc) == au.HeaderSize + 64
    mut h := au.Header {}
    println au.ReadHeader(enc.data, enc.len, h), h.encoding == au.EncPcm16, h.rate, h.channels
    upath := filepath.Join(os.TempDir(), "salam_audio_save.au")
    defer mem.Free(upath as void*)
    println archive.WriteBinaryFileBuf(upath, enc)
    mut uok := false
    uback := au.OpenAU(upath, uok)
    println uok, uback.rate, uback.frames, uback.bits
    println math.Abs(audio.Sample(uback, 4, 0) + 0.5) < 0.001
    mut gone := false
    au.OpenAU(filepath.Join(os.TempDir(), "salam_audio_save_none.au"), gone)
    println gone
    println compress.BufLen(au.EncodeAU(audio.Clip {}))

    println "probing by content"
    wbuf := wav.EncodeWAV(c)
    abuf := aiff.EncodeAIFF(c)
    each pair in [0, 1, 2]:
        mut pok := false
        mut info := audio.Info {}
        if pair == 0:
            info = codec.Probe(wbuf.data, wbuf.len, pok)
        end
        if pair == 1:
            info = codec.Probe(abuf.data, abuf.len, pok)
        end
        if pair == 2:
            info = codec.Probe(enc.data, enc.len, pok)
        end
        println pok, info.rate, info.channels, info.bits, info.frames
    end
    mut nok := true
    codec.Probe(wbuf.data, 6, nok)
    println nok

    compress.BufFree(enc)
    compress.BufFree(wbuf)
    compress.BufFree(abuf)
    audio.Free(c)
    audio.Free(wback)
    audio.Free(fback)
    audio.Free(aback)
    audio.Free(uback)
end
