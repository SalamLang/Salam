package main

// std/autograd: batched matmul, permute, embedding, layer norm and
// dropout - gradients against central differences, dropout semantics
// by inspection.

import autograd
import tensor
import testing

mut g_x := tensor.Tensor {}
mut g_b := tensor.Tensor {}
mut g_c := tensor.Tensor {}
mut g_gamma := tensor.Tensor {}
mut g_beta := tensor.Tensor {}
mut g_idx := Vector {} as Vector<int>

func perm201(): Vector<int>:
    mut p := Vector {} as Vector<int>
    p.push(2)
    p.push(0)
    p.push(1)
    ret p
end

func f_bmm(t: tensor.Tensor): f64:
    mut tp := autograd.NewTape(1)
    x := autograd.Input(tp, t)
    b := autograd.Input(tp, g_b)
    v := autograd.Value(tp, autograd.Sum(tp, autograd.Square(tp, autograd.BatchMatMul(tp, x, b))))
    out := v.at(0)
    tp.free()
    ret out
end

func f_bmm_b(t: tensor.Tensor): f64:
    mut tp := autograd.NewTape(1)
    x := autograd.Input(tp, g_x)
    b := autograd.Input(tp, t)
    v := autograd.Value(tp, autograd.Sum(tp, autograd.Square(tp, autograd.BatchMatMul(tp, x, b))))
    out := v.at(0)
    tp.free()
    ret out
end

func f_perm(t: tensor.Tensor): f64:
    mut tp := autograd.NewTape(1)
    x := autograd.Input(tp, t)
    c := autograd.Input(tp, g_c)
    mut p := perm201()
    v := autograd.Value(tp, autograd.Sum(tp, autograd.Mul(tp, autograd.Permute(tp, x, p), c)))
    p.free()
    out := v.at(0)
    tp.free()
    ret out
end

func f_embed(t: tensor.Tensor): f64:
    mut tp := autograd.NewTape(1)
    w := autograd.Input(tp, t)
    v := autograd.Value(tp, autograd.Sum(tp, autograd.Square(tp, autograd.Embedding(tp, w, g_idx))))
    out := v.at(0)
    tp.free()
    ret out
end

// Layer norm loss with x, gamma, beta selectable as the perturbed one
// (which == 0, 1, 2); the others come from the globals.
func ln_loss(tp &: autograd.Tape, x: int, gm: int, bt: int): int:
    c := autograd.Input(tp, g_c)
    ret autograd.Sum(tp, autograd.Mul(tp, autograd.Square(tp, autograd.LayerNorm(tp, x, gm, bt, 0.00001)), c))
end

func f_ln_x(t: tensor.Tensor): f64:
    mut tp := autograd.NewTape(1)
    x := autograd.Input(tp, t)
    gm := autograd.Input(tp, g_gamma)
    bt := autograd.Input(tp, g_beta)
    v := autograd.Value(tp, ln_loss(tp, x, gm, bt))
    out := v.at(0)
    tp.free()
    ret out
end

func f_ln_gamma(t: tensor.Tensor): f64:
    mut tp := autograd.NewTape(1)
    x := autograd.Input(tp, g_x)
    gm := autograd.Input(tp, t)
    bt := autograd.Input(tp, g_beta)
    v := autograd.Value(tp, ln_loss(tp, x, gm, bt))
    out := v.at(0)
    tp.free()
    ret out
end

func f_ln_beta(t: tensor.Tensor): f64:
    mut tp := autograd.NewTape(1)
    x := autograd.Input(tp, g_x)
    gm := autograd.Input(tp, g_gamma)
    bt := autograd.Input(tp, t)
    v := autograd.Value(tp, ln_loss(tp, x, gm, bt))
    out := v.at(0)
    tp.free()
    ret out
end

func main:
    h := 0.01
    tol := 0.02

    // BatchMatMul, both operands
    mut sx := tensor.Shape3(2, 3, 4)
    g_x = tensor.RandUniform(sx, 0.0 - 1.0, 1.0, 21)
    sx.free()
    mut sb := tensor.Shape3(2, 4, 2)
    g_b = tensor.RandUniform(sb, 0.0 - 1.0, 1.0, 22)
    sb.free()
    mut tp := autograd.NewTape(1)
    xid := autograd.Watch(tp, g_x)
    bid := autograd.Watch(tp, g_b)
    loss := autograd.Sum(tp, autograd.Square(tp, autograd.BatchMatMul(tp, xid, bid)))
    autograd.Backward(tp, loss)
    mut gx := tensor.Clone(autograd.Grad(tp, xid))
    mut gb := tensor.Clone(autograd.Grad(tp, bid))
    tp.free()
    testing.AssertTrue(autograd.GradCheck((t: tensor.Tensor): ret f_bmm(t) end, g_x, gx, h, tol))
    testing.AssertTrue(autograd.GradCheck((t: tensor.Tensor): ret f_bmm_b(t) end, g_b, gb, h, tol))
    tensor.Free(gx)
    tensor.Free(gb)

    // Permute [2,3,4] by (2,0,1) -> [4,2,3], weighted by a constant
    mut sc := tensor.Shape3(4, 2, 3)
    g_c = tensor.RandUniform(sc, 0.0 - 1.0, 1.0, 23)
    sc.free()
    mut tp2 := autograd.NewTape(1)
    pid := autograd.Watch(tp2, g_x)
    cid := autograd.Input(tp2, g_c)
    mut perm := perm201()
    ploss := autograd.Sum(tp2, autograd.Mul(tp2, autograd.Permute(tp2, pid, perm), cid))
    perm.free()
    autograd.Backward(tp2, ploss)
    mut gp := tensor.Clone(autograd.Grad(tp2, pid))
    tp2.free()
    testing.AssertTrue(autograd.GradCheck((t: tensor.Tensor): ret f_perm(t) end, g_x, gp, h, tol))
    tensor.Free(gp)

    // Embedding with a repeated index, so the scatter must accumulate
    mut sw := tensor.Shape2(5, 3)
    mut w := tensor.RandUniform(sw, 0.0 - 1.0, 1.0, 24)
    sw.free()
    g_idx.push(4)
    g_idx.push(1)
    g_idx.push(4)
    g_idx.push(0)
    mut tp3 := autograd.NewTape(1)
    wid := autograd.Watch(tp3, w)
    eloss := autograd.Sum(tp3, autograd.Square(tp3, autograd.Embedding(tp3, wid, g_idx)))
    ev := autograd.Value(tp3, eloss)
    testing.AssertTrue(ev.at(0) > 0.0)
    autograd.Backward(tp3, eloss)
    mut ge := tensor.Clone(autograd.Grad(tp3, wid))
    tp3.free()
    // Row 2 and 3 are never looked up: zero gradient there.
    testing.AssertEqFloat(ge.at2(2, 0), 0.0, 0.000001)
    testing.AssertTrue(autograd.GradCheck((t: tensor.Tensor): ret f_embed(t) end, w, ge, h, tol))
    tensor.Free(ge)

    // LayerNorm over the last axis of [2,3,4]: x, gamma and beta
    mut sg := tensor.Shape1(4)
    g_gamma = tensor.RandUniform(sg, 0.5, 1.5, 25)
    g_beta = tensor.RandUniform(sg, 0.0 - 0.5, 0.5, 26)
    sg.free()
    tensor.Free(g_c)
    mut sc2 := tensor.Shape3(2, 3, 4)
    g_c = tensor.RandUniform(sc2, 0.0 - 1.0, 1.0, 27)
    sc2.free()
    mut tp4 := autograd.NewTape(1)
    lx := autograd.Watch(tp4, g_x)
    lg := autograd.Watch(tp4, g_gamma)
    lb := autograd.Watch(tp4, g_beta)
    lloss := ln_loss(tp4, lx, lg, lb)
    autograd.Backward(tp4, lloss)
    mut glx := tensor.Clone(autograd.Grad(tp4, lx))
    mut glg := tensor.Clone(autograd.Grad(tp4, lg))
    mut glb := tensor.Clone(autograd.Grad(tp4, lb))
    tp4.free()
    testing.AssertTrue(autograd.GradCheck((t: tensor.Tensor): ret f_ln_x(t) end, g_x, glx, h, tol))
    testing.AssertTrue(autograd.GradCheck((t: tensor.Tensor): ret f_ln_gamma(t) end, g_gamma, glg, h, tol))
    testing.AssertTrue(autograd.GradCheck((t: tensor.Tensor): ret f_ln_beta(t) end, g_beta, glb, h, tol))
    tensor.Free(glx)
    tensor.Free(glg)
    tensor.Free(glb)

    // Dropout: training keeps ~(1-p) of the elements, scaled by 1/(1-p);
    // inference is the identity and records no node.
    mut big := tensor.Zeros2(100, 100)
    tensor.SetAll(big, 1.0)
    mut tp5 := autograd.NewTape(9)
    did := autograd.Watch(tp5, big)
    dres := autograd.Dropout(tp5, did, 0.25)
    dv := autograd.Value(tp5, dres)
    mut kept := 0
    mut only := true
    repeat dv.numel() with k:
        v := dv.at(k)
        if v != 0.0:
            kept += 1
            if v < 1.3 || v > 1.4: only = false end
        end
    end
    testing.AssertTrue(only)
    frac := (kept as f64) / (dv.numel() as f64)
    testing.AssertTrue(frac > 0.7)
    testing.AssertTrue(frac < 0.8)
    dl := autograd.Sum(tp5, dres)
    autograd.Backward(tp5, dl)
    dg := autograd.Grad(tp5, did)
    // gradient is mask/(1-p): matches the forward's zeros exactly
    mut agree := true
    repeat dv.numel() with k:
        if (dv.at(k) == 0.0) != (dg.at(k) == 0.0): agree = false end
    end
    testing.AssertTrue(agree)
    tp5.reset()
    tp5.training = false
    did2 := autograd.Watch(tp5, big)
    dres2 := autograd.Dropout(tp5, did2, 0.25)
    testing.AssertEqInt(dres2, did2)
    testing.AssertEqInt(tp5.nodes.len(), 0)
    tp5.free()

    tensor.Free(g_x)
    tensor.Free(g_b)
    tensor.Free(g_c)
    tensor.Free(g_gamma)
    tensor.Free(g_beta)
    tensor.Free(w)
    tensor.Free(big)
    g_idx.free()

    ret testing.Summary()
end
