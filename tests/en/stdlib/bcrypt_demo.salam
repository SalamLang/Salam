package main

import crypto

func check(label: str, ok: bool):
    if ok:
        println label, ": ok"
    else:
        println label, ": FAIL"
    end
end

func main:
    // Vectors produced by PHP crypt() / password_hash().
    check("verify password", crypto.BcryptVerify("password", "$2y$04$abcdefghijklmnopqrstuughE8Ev8uGFaUgY2cNEySvxngrb/Jzdm"))
    check("verify empty", crypto.BcryptVerify("", "$2y$04$abcdefghijklmnopqrstuubyCG3zY1GIXMyxfivm.ClDiInHzxjiq"))
    check("verify persian", crypto.BcryptVerify("سلام دنیا", "$2y$05$ZYXWVUTSRQPONMLKJIHGFeWZhLCcOvkQLOf7OuGxDYSfBVkumy4Fu"))
    check("verify long", crypto.BcryptVerify("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "$2y$04$0123456789./abcdefghieE6MctTXHk0HyomIUTbtqOgcMfUqq3fu"))
    check("verify 2a", crypto.BcryptVerify("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"))
    check("verify cost 10", crypto.BcryptVerify("yasna123", "$2y$10$z6NHrWayXy6sLgXpqElb.ugxO1e59DzqPHuaYbeiVs8wyO605be9S"))
    check("reject wrong", not crypto.BcryptVerify("Password", "$2y$04$abcdefghijklmnopqrstuughE8Ev8uGFaUgY2cNEySvxngrb/Jzdm"))
    check("reject junk", not crypto.BcryptVerify("password", "pbkdf2-sha256$1$aa$bb"))

    h := crypto.BcryptHash("roundtrip", 4)
    check("hash shape", crypto.IsBcryptHash(h) and h.substr(0, 7) == "$2y$04$")
    check("hash roundtrip", crypto.BcryptVerify("roundtrip", h))
    println "cost: ", crypto.BcryptCost("$2y$10$z6NHrWayXy6sLgXpqElb.ugxO1e59DzqPHuaYbeiVs8wyO605be9S")
end
