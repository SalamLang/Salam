package main

import bigint
import testing

func expect(x: bigint.Int, want: str):
    mut v := x
    testing.AssertEqStr(bigint.ToStr(v), want)
    v.Free()
end

func main:
    println "small integer helpers"
    mut a := bigint.FromInt(1000000007 as i64)
    expect(bigint.SubInt(a, 8 as i64), "999999999")
    expect(bigint.SubInt(a, 2000000000 as i64), "-999999993")
    expect(bigint.Sqr(a), "1000000014000000049")
    testing.AssertTrue(bigint.EqualsInt(a, 1000000007 as i64))
    testing.AssertFalse(bigint.EqualsInt(a, 7 as i64))
    testing.AssertEqInt(bigint.ModInt(a, 1000 as i64) as int, 7)
    mut rem := 0 as i64
    expect(bigint.DivModInt(a, 1000 as i64, rem), "1000000")
    testing.AssertEqInt(rem as int, 7)
    expect(bigint.DivModInt(a, 0 as i64, rem), "0")
    testing.AssertEqInt(rem as int, 0)

    println "in place updates"
    bigint.AddIntTo(a, 3 as i64)
    testing.AssertEqStr(bigint.ToStr(a), "1000000010")
    bigint.AddIntTo(a, 0 - 10 as i64)
    testing.AssertEqStr(bigint.ToStr(a), "1000000000")
    bigint.ShlBy(a, 4)
    testing.AssertEqStr(bigint.ToStr(a), "16000000000")
    bigint.ShrBy(a, 8)
    testing.AssertEqStr(bigint.ToStr(a), "62500000")
    bigint.ShrBy(a, 100)
    testing.AssertEqStr(bigint.ToStr(a), "0")
    a.Free()

    println "unsigned and bits"
    mut big := bigint.FromUint(18446744073709551615 as u64)
    testing.AssertEqStr(bigint.ToStr(big), "18446744073709551615")
    testing.AssertEqInt(bigint.BitLen(big), 64)
    testing.AssertEqInt(bigint.Bit(big, 0), 1)
    testing.AssertEqInt(bigint.Bit(big, 63), 1)
    testing.AssertEqInt(bigint.Bit(big, 64), 0)
    testing.AssertEqInt(bigint.Bit(big, 0 - 1), 0)
    bigint.ShrBy(big, 63)
    testing.AssertEqInt(bigint.BitLen(big), 1)
    big.Free()
    mut five := bigint.FromInt(5 as i64)
    testing.AssertEqInt(bigint.BitLen(five), 3)
    testing.AssertEqInt(bigint.Bit(five, 1), 0)
    testing.AssertEqInt(bigint.Bit(five, 2), 1)
    five.Free()

    println "floor division"
    mut x := bigint.FromInt(0 - 7 as i64)
    mut y := bigint.FromInt(2 as i64)
    mut q := bigint.Int {}
    mut r := bigint.Int {}
    testing.AssertTrue(bigint.FloorDivMod(x, y, q, r))
    testing.AssertEqStr(bigint.ToStr(q), "-4")
    testing.AssertEqStr(bigint.ToStr(r), "1")
    mut tq := bigint.Int {}
    mut tr := bigint.Int {}
    testing.AssertTrue(bigint.DivMod(x, y, tq, tr))
    testing.AssertEqStr(bigint.ToStr(tq), "-3")
    testing.AssertEqStr(bigint.ToStr(tr), "-1")
    mut zero := bigint.FromInt(0 as i64)
    testing.AssertFalse(bigint.FloorDivMod(x, zero, q, r))
    q.Free()
    r.Free()
    tq.Free()
    tr.Free()
    x.Free()
    y.Free()
    zero.Free()

    println "parse with a base"
    mut ok := false
    mut h := bigint.ParseBase("ff", 16, ok)
    testing.AssertTrue(ok)
    testing.AssertEqStr(bigint.ToStr(h), "255")
    h.Free()
    mut b := bigint.ParseBase("-101", 2, ok)
    testing.AssertTrue(ok)
    testing.AssertEqStr(bigint.ToStr(b), "-5")
    b.Free()
    mut bad := bigint.ParseBase("12", 2, ok)
    testing.AssertFalse(ok)
    bad.Free()
    mut huge := bigint.ParseBase("zzzzzzzzzzzzzzzzzzzzzzzz", 36, ok)
    testing.AssertTrue(ok)
    testing.AssertEqInt(bigint.BitLen(huge), 125)
    testing.AssertTrue(bigint.ToIntClamped(huge) == 9223372036854775807)
    huge.Free()

    println "clamped conversion"
    mut n := bigint.FromInt(0 - 12 as i64)
    testing.AssertEqInt(bigint.ToIntClamped(n) as int, 0 - 12)
    n.Free()
    mut over := bigint.Parse("100000000000000000000000", ok)
    testing.AssertEqStr(bigint.ToStr(over), "100000000000000000000000")
    testing.AssertTrue(bigint.ToIntClamped(over) == 9223372036854775807)
    mut under := bigint.Parse("-100000000000000000000000", ok)
    testing.AssertTrue(bigint.ToIntClamped(under) < 0 - 9223372036854775807)
    over.Free()
    under.Free()
    ret testing.Summary()
end
