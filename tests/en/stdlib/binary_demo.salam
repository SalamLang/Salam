package main

import encoding.binary
import compress
import testing
import os

func main:
    // WriteU32BE(0x01020304) -> bytes 01 02 03 04
    mut b1 := compress.NewByteBuf()
    binary.WriteU32BE(b1, 0x01020304)
    testing.AssertEqInt(compress.BufLen(b1), 4)
    testing.AssertEqInt(compress.BufGet(b1, 0), 0x01)
    testing.AssertEqInt(compress.BufGet(b1, 1), 0x02)
    testing.AssertEqInt(compress.BufGet(b1, 2), 0x03)
    testing.AssertEqInt(compress.BufGet(b1, 3), 0x04)
    r1 := compress.NewByteReader(b1.data, b1.len)
    mut rr1 := r1
    testing.AssertEqInt(binary.ReadU32BE(rr1), 0x01020304)

    // WriteU32LE round trip
    mut b2 := compress.NewByteBuf()
    binary.WriteU32LE(b2, 0x01020304)
    testing.AssertEqInt(compress.BufGet(b2, 0), 0x04)
    testing.AssertEqInt(compress.BufGet(b2, 3), 0x01)
    mut r2 := compress.NewByteReader(b2.data, b2.len)
    testing.AssertEqInt(binary.ReadU32LE(r2), 0x01020304)

    // U16 both orders
    mut b3 := compress.NewByteBuf()
    binary.WriteU16BE(b3, 0xABCD)
    testing.AssertEqInt(compress.BufGet(b3, 0), 0xAB)
    testing.AssertEqInt(compress.BufGet(b3, 1), 0xCD)
    mut r3 := compress.NewByteReader(b3.data, b3.len)
    testing.AssertEqInt(binary.ReadU16BE(r3), 0xABCD)

    mut b4 := compress.NewByteBuf()
    binary.WriteU16LE(b4, 0xABCD)
    testing.AssertEqInt(compress.BufGet(b4, 0), 0xCD)
    testing.AssertEqInt(compress.BufGet(b4, 1), 0xAB)
    mut r4 := compress.NewByteReader(b4.data, b4.len)
    testing.AssertEqInt(binary.ReadU16LE(r4), 0xABCD)

    // U64 both orders
    big := 0x0102030405060708 as i64
    mut b5 := compress.NewByteBuf()
    binary.WriteU64BE(b5, big)
    testing.AssertEqInt(compress.BufLen(b5), 8)
    testing.AssertEqInt(compress.BufGet(b5, 0), 0x01)
    testing.AssertEqInt(compress.BufGet(b5, 7), 0x08)
    mut r5 := compress.NewByteReader(b5.data, b5.len)
    testing.AssertEqInt64(binary.ReadU64BE(r5), big)

    mut b6 := compress.NewByteBuf()
    binary.WriteU64LE(b6, big)
    testing.AssertEqInt(compress.BufGet(b6, 0), 0x08)
    testing.AssertEqInt(compress.BufGet(b6, 7), 0x01)
    mut r6 := compress.NewByteReader(b6.data, b6.len)
    testing.AssertEqInt64(binary.ReadU64LE(r6), big)

    // float round trips
    mut b7 := compress.NewByteBuf()
    binary.WriteF64(b7, 1.5, true)
    mut r7 := compress.NewByteReader(b7.data, b7.len)
    testing.AssertEqFloat(binary.ReadF64(r7, true), 1.5, 0.0000001)

    mut b8 := compress.NewByteBuf()
    binary.WriteF64(b8, 0.0 - 42.25, false)
    mut r8 := compress.NewByteReader(b8.data, b8.len)
    testing.AssertEqFloat(binary.ReadF64(r8, false), 0.0 - 42.25, 0.0000001)

    mut b9 := compress.NewByteBuf()
    binary.WriteF32(b9, 3.5, true)
    testing.AssertEqInt(compress.BufLen(b9), 4)
    mut r9 := compress.NewByteReader(b9.data, b9.len)
    testing.AssertEqFloat(binary.ReadF32(r9, true), 3.5, 0.0001)

    // ReadU16LE past end sets the sticky `bad` flag (inherited from
    // compress.ByteReader semantics)
    mut bshort := compress.NewByteBuf()
    compress.BufPush(bshort, 1)
    mut rshort := compress.NewByteReader(bshort.data, bshort.len)
    binary.ReadU16LE(rshort)
    testing.AssertTrue(rshort.bad)

    compress.BufFree(b1)
    compress.BufFree(b2)
    compress.BufFree(b3)
    compress.BufFree(b4)
    compress.BufFree(b5)
    compress.BufFree(b6)
    compress.BufFree(b7)
    compress.BufFree(b8)
    compress.BufFree(b9)
    compress.BufFree(bshort)

    os.Exit(testing.Summary())
end
