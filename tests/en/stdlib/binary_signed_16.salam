import compress
import encoding.binary

func main:
    mut b := compress.NewByteBuf()
    binary.WriteI16BE(b, 0 - 2)
    binary.WriteI16LE(b, 0 - 32768)
    binary.WriteI16BE(b, 32767)
    mut r := compress.ReaderFromBuf(b)
    println binary.ReadI16BE(r), binary.ReadI16LE(r), binary.ReadI16BE(r)
    compress.BufFree(b)
end
