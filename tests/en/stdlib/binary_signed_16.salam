import compress
import encoding.binary

func main throw:
    mut b := compress.NewByteBuf()
    binary.WriteI16BE(b, -2)
    binary.WriteI16LE(b, -32768)
    binary.WriteI16BE(b, 32767)
    mut r := compress.ReaderFromBuf(b)
    println try binary.ReadI16BE(r), try binary.ReadI16LE(r), try binary.ReadI16BE(r)
    compress.BufFree(b)
end
