import encoding.binary
import mem

func main:
    raw := mem.AllocateZeroed(40 as u64)
    defer mem.Free(raw)
    v := binary.NewView(raw, 40)
    println binary.PutU32LE(v, 0, 0xFADE0CC0 as i64), binary.PutU32BE(v, 4, 0xFADE0CC0 as i64), binary.PutU16LE(v, 8, 0xBEEF as i64), binary.PutU16BE(v, 10, 0xBEEF as i64)
    println binary.GetU32LE(v, 0), binary.GetU32BE(v, 4), binary.GetU32LE(v, 4), binary.GetU16LE(v, 8), binary.GetU16BE(v, 8), binary.GetU16BE(v, 10)
    println binary.PutU64LE(v, 16, 0x0123456789ABCDEF as i64), binary.GetU64LE(v, 16), binary.GetU64BE(v, 16), binary.GetU8(v, 16), binary.GetU8(v, 23)
    println binary.PutU64BE(v, 24, 258 as i64), binary.GetU64BE(v, 24), binary.GetU64LE(v, 24), binary.GetU8(v, 31)
    println binary.PutU8(v, 32, 104 as i64), binary.PutU8(v, 33, 105 as i64)
    name := binary.CStringAt(v, 32)
    fixed := binary.FixedStringAt(v, 32, 2)
    println name, fixed, name.Len(), binary.CStringAt(v, 39).Len()
    println binary.Has(v, 38, 2), binary.Has(v, 39, 2), binary.Has(v, 0 - 1, 1)
    println binary.GetU32LE(v, 38), binary.PutU32LE(v, 38, 1 as i64), binary.PutU8(v, 40, 1 as i64)
    w := binary.NewView(null, 0)
    println binary.GetU8(w, 0), binary.CStringAt(w, 0).Len(), binary.Has(w, 0, 0)
end
