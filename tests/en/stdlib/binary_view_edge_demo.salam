import encoding.binary
import compress
import mem

func main:
    mut buf := compress.NewByteBuf()
    defer compress.BufFree(buf)
    repeat 0 to 11 in i:
        compress.BufPush(buf, i + 1)
    end
    v := binary.ViewOf(buf)
    println "view of buffer:", v.len, v.data == buf.data
    println binary.GetU8(v, 0), binary.GetU8(v, 11), binary.GetU8(v, 12), binary.GetU8(v, 0 - 1)
    println binary.GetU16LE(v, 0), binary.GetU16BE(v, 0), binary.GetU16LE(v, 10), binary.GetU16LE(v, 11)
    println binary.GetU32LE(v, 0), binary.GetU32BE(v, 0), binary.GetU32LE(v, 8), binary.GetU32LE(v, 9)
    println binary.GetU64LE(v, 0), binary.GetU64BE(v, 0), binary.GetU64LE(v, 4), binary.GetU64LE(v, 5)
    println binary.PutU8(v, 0, 255 as i64), binary.GetU8(v, 0), binary.PutU8(v, 0, 256 as i64), binary.GetU8(v, 0), binary.PutU8(v, 0, 0x1FF as i64), binary.GetU8(v, 0)
    println binary.PutU16LE(v, 0, 0xFFFFFFFF as i64), binary.GetU16LE(v, 0), binary.GetU16BE(v, 0)
    println binary.PutU32BE(v, 0, 0x1FFFFFFFF as i64), binary.GetU32BE(v, 0), binary.PutU32LE(v, 8, 0 - 1 as i64), binary.GetU32LE(v, 8)

    println "bounds"
    println binary.Has(v, 0, 12), binary.Has(v, 0, 13), binary.Has(v, 12, 0), binary.Has(v, 12, 1), binary.Has(v, 13, 0), binary.Has(v, 0, 0 - 1)
    println binary.Has(v, 2147483647, 2), binary.Has(v, 2147483647, 2147483647), binary.Has(v, 1, 2147483647)
    println binary.GetU32LE(v, 2147483647), binary.PutU32LE(v, 2147483647, 1 as i64), binary.GetU8(v, 2147483647)
    println binary.GetU64LE(v, 2147483640), binary.PutU64BE(v, 0 - 2147483647, 1 as i64)
    println binary.CStringAt(v, 2147483647).Len(), binary.FixedStringAt(v, 2147483647, 5).Len(), binary.FixedStringAt(v, 1, 2147483647).Len()

    println "64-bit values"
    raw := mem.AllocateZeroed(16 as u64)
    defer mem.Free(raw)
    w := binary.NewView(raw, 16)
    println binary.PutU64LE(w, 0, 0 - 1 as i64), binary.GetU64LE(w, 0), binary.GetU64BE(w, 0), binary.GetU32LE(w, 0), binary.GetU16BE(w, 6)
    println binary.PutU64BE(w, 8, 0x8000000000000000 as i64), binary.GetU64BE(w, 8), binary.GetU8(w, 8), binary.GetU8(w, 15), binary.GetU32BE(w, 8)
    println binary.PutU32BE(w, 0, 0x80000000 as i64), binary.GetU32BE(w, 0), binary.GetU16BE(w, 0), binary.GetU16BE(w, 2)

    println "strings"
    println binary.PutU32LE(w, 4, 0 as i64)
    println binary.PutU8(w, 0, 97 as i64), binary.PutU8(w, 1, 0 as i64), binary.PutU8(w, 2, 98 as i64), binary.PutU8(w, 3, 99 as i64)
    println binary.CStringAt(w, 0), binary.CStringAt(w, 0).Len(), binary.CStringAt(w, 2), binary.CStringAt(w, 1).Len(), binary.CStringAt(w, 3)
    println binary.FixedStringAt(w, 0, 4), binary.FixedStringAt(w, 0, 1), binary.FixedStringAt(w, 2, 2), binary.FixedStringAt(w, 2, 1), binary.FixedStringAt(w, 0, 0).Len(), binary.FixedStringAt(w, 0, 0 - 1).Len()
    println binary.FixedStringAt(w, 14, 2).Len(), binary.FixedStringAt(w, 15, 2).Len(), binary.FixedStringAt(w, 16, 1).Len(), binary.CStringAt(w, 16).Len(), binary.CStringAt(w, 0 - 1).Len()

    println "utf-8 text"
    text := "سلام"
    n := text.Len()
    t := binary.NewView(text as void*, n)
    println n, binary.GetU8(t, 0), binary.GetU8(t, 1), binary.GetU16BE(t, 0), binary.GetU16LE(t, 0)
    println binary.FixedStringAt(t, 0, n) == text, binary.FixedStringAt(t, 0, 2), binary.FixedStringAt(t, 2, 4) == "لا", binary.CStringAt(t, 0) == text

    println "empty views"
    nothing := binary.NewView(null, 0)
    println binary.Has(nothing, 0, 0), binary.GetU8(nothing, 0), binary.PutU8(nothing, 0, 1 as i64), binary.CStringAt(nothing, 0).Len(), binary.FixedStringAt(nothing, 0, 1).Len()
    solo := binary.NewView(null, 8)
    println binary.Has(solo, 0, 1), binary.GetU64LE(solo, 0), binary.PutU64LE(solo, 0, 1 as i64)
    zero := binary.NewView(raw, 0)
    println binary.Has(zero, 0, 0), binary.Has(zero, 0, 1), binary.GetU8(zero, 0), binary.PutU8(zero, 0, 1 as i64), binary.CStringAt(zero, 0).Len()
end
