package main

import compress
import encoding.binary

func main:
    mut w := compress.NewByteBuf()
    binary.WriteI32BE(w, 258)
    binary.WriteI32BE(w, 0 - 2)
    binary.WriteI64LE(w, 4294967298)
    println compress.BufLen(w), compress.BufGet(w, 2), compress.BufGet(w, 3), compress.BufGet(w, 4), compress.BufGet(w, 7), compress.BufGet(w, 8), compress.BufGet(w, 12)
    mut r := compress.ReaderFromBuf(w)
    try:
        println binary.ReadI32BE(r), binary.ReadI32BE(r), binary.ReadI64LE(r), r.bad
    catch e:
        println e.ToStr()
    end

    mut le := compress.NewByteBuf()
    binary.WriteI32LE(le, 0 - 5)
    binary.WriteI64BE(le, 0 - 7)
    binary.WriteU32LE(le, 100000)
    mut rl := compress.ReaderFromBuf(le)
    try:
        println binary.ReadI32LE(rl), binary.ReadI64BE(rl), binary.ReadI32LE(rl)
    catch e:
        println e.ToStr()
    end
    try:
        _ := binary.ReadI32LE(rl)
        println "no error"
    catch e:
        println e.is(ErrorKind.UnexpectedEnd)
    end
end
