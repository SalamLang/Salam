// Date arithmetic across all three calendars. Day arithmetic is exact
// (it happens in JDN space); month and year arithmetic clamps to the last
// valid day of the target month, which is what makes "January 31st plus one
// month" answerable at all. Fixed inputs throughout, so the clock is never
// consulted and the expectations never drift.
package main

import testing
import calendar

func test_add_days_crosses_boundaries():
    // Year boundary, and the leap day in both directions.
    y := calendar.AddDaysGregorian(calendar.GregorianDate { year = 2024, month = 12, day = 31 }, 1)
    testing.AssertEqStr(calendar.FormatGregorian(y), "2025-01-01")
    b := calendar.AddDaysGregorian(calendar.GregorianDate { year = 2024, month = 1, day = 1 }, 0 - 1)
    testing.AssertEqStr(calendar.FormatGregorian(b), "2023-12-31")
    leap := calendar.AddDaysGregorian(calendar.GregorianDate { year = 2024, month = 2, day = 28 }, 1)
    testing.AssertEqStr(calendar.FormatGregorian(leap), "2024-02-29")
    noleap := calendar.AddDaysGregorian(calendar.GregorianDate { year = 2023, month = 2, day = 28 }, 1)
    testing.AssertEqStr(calendar.FormatGregorian(noleap), "2023-03-01")
    // Adding zero is the identity, and weeks are just seven days.
    same := calendar.AddDaysGregorian(calendar.GregorianDate { year = 2024, month = 6, day = 15 }, 0)
    testing.AssertEqStr(calendar.FormatGregorian(same), "2024-06-15")
    wk := calendar.AddWeeksGregorian(calendar.GregorianDate { year = 2024, month = 6, day = 15 }, 2)
    testing.AssertEqStr(calendar.FormatGregorian(wk), "2024-06-29")
end

func test_add_months_clamps():
    // The whole point: there is no February 31st.
    jan31 := calendar.GregorianDate { year = 2024, month = 1, day = 31 }
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddMonthsGregorian(jan31, 1)), "2024-02-29")
    jan31b := calendar.GregorianDate { year = 2023, month = 1, day = 31 }
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddMonthsGregorian(jan31b, 1)), "2023-02-28")
    // A day that exists in the target month is untouched.
    mid := calendar.GregorianDate { year = 2024, month = 1, day = 15 }
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddMonthsGregorian(mid, 1)), "2024-02-15")
    // Going backwards past January must land in the previous year, which
    // needs floor division rather than truncation.
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddMonthsGregorian(mid, 0 - 1)), "2023-12-15")
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddMonthsGregorian(mid, 0 - 14)), "2022-11-15")
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddMonthsGregorian(mid, 24)), "2026-01-15")
end

func test_add_years_clamps_leap_day():
    feb29 := calendar.GregorianDate { year = 2024, month = 2, day = 29 }
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddYearsGregorian(feb29, 1)), "2025-02-28")
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddYearsGregorian(feb29, 4)), "2028-02-29")
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddYearsGregorian(feb29, 0 - 1)), "2023-02-28")
    // 1900 was not a leap year (divisible by 100, not by 400).
    testing.AssertEqStr(calendar.FormatGregorian(calendar.AddYearsGregorian(feb29, 0 - 124)), "1900-02-28")
end

func test_days_between_and_bounds():
    a := calendar.GregorianDate { year = 2024, month = 1, day = 1 }
    b := calendar.GregorianDate { year = 2025, month = 1, day = 1 }
    testing.AssertEqInt64(calendar.DaysBetweenGregorian(a, b), 366 as i64)
    testing.AssertEqInt64(calendar.DaysBetweenGregorian(b, a), 0 - 366 as i64)
    testing.AssertEqInt64(calendar.DaysBetweenGregorian(a, a), 0 as i64)
    testing.AssertEqInt(calendar.DaysInGregorianYear(2024), 366)
    testing.AssertEqInt(calendar.DaysInGregorianYear(2023), 365)
    testing.AssertEqInt(calendar.DaysInGregorianYear(1900), 365)
    testing.AssertEqInt(calendar.DaysInGregorianYear(2000), 366)
    mid := calendar.GregorianDate { year = 2024, month = 2, day = 5 }
    testing.AssertEqStr(calendar.FormatGregorian(calendar.StartOfMonthGregorian(mid)), "2024-02-01")
    testing.AssertEqStr(calendar.FormatGregorian(calendar.EndOfMonthGregorian(mid)), "2024-02-29")
end

func test_jalali_arithmetic():
    // 1403 is a Jalali leap year, so Esfand has 30 days; 1404 does not.
    testing.AssertTrue(calendar.IsLeapJalali(1403))
    testing.AssertFalse(calendar.IsLeapJalali(1404))
    esf := calendar.JalaliDate { year = 1403, month = 12, day = 30 }
    testing.AssertEqStr(calendar.FormatJalali(calendar.AddYearsJalali(esf, 1)), "1404-12-29")
    // The day after the last day of the year is Nowruz.
    testing.AssertEqStr(calendar.FormatJalali(calendar.AddDaysJalali(esf, 1)), "1404-01-01")
    testing.AssertEqInt(calendar.DaysInJalaliYear(1403), 366)
    testing.AssertEqInt(calendar.DaysInJalaliYear(1404), 365)
    // Month lengths change at Mehr (month 7): 31 days before, 30 after.
    d := calendar.JalaliDate { year = 1403, month = 6, day = 31 }
    testing.AssertEqStr(calendar.FormatJalali(calendar.AddMonthsJalali(d, 1)), "1403-07-30")
    testing.AssertEqStr(calendar.FormatJalali(calendar.StartOfMonthJalali(d)), "1403-06-01")
    testing.AssertEqStr(calendar.FormatJalali(calendar.EndOfMonthJalali(d)), "1403-06-31")
    a := calendar.JalaliDate { year = 1403, month = 1, day = 1 }
    b := calendar.JalaliDate { year = 1404, month = 1, day = 1 }
    testing.AssertEqInt64(calendar.DaysBetweenJalali(a, b), 366 as i64)
end

func test_hijri_arithmetic():
    h := calendar.HijriDate { year = 1445, month = 12, day = 29 }
    testing.AssertEqStr(calendar.FormatHijri(calendar.AddDaysHijri(h, 1)), "1445-12-30")
    testing.AssertEqStr(calendar.FormatHijri(calendar.AddDaysHijri(h, 2)), "1446-01-01")
    testing.AssertEqStr(calendar.FormatHijri(calendar.AddMonthsHijri(h, 1)), "1446-01-29")
    testing.AssertEqStr(calendar.FormatHijri(calendar.AddYearsHijri(h, 1)), "1446-12-29")
    testing.AssertEqStr(calendar.FormatHijri(calendar.StartOfMonthHijri(h)), "1445-12-01")
    testing.AssertEqStr(calendar.FormatHijri(calendar.AddWeeksHijri(h, 1)), "1446-01-06")
    // A tabular Islamic year is 354 days, or 355 in a leap year. 1445 is
    // one: 1445 mod 30 = 5, and 5 is in the 30-year cycle's leap set
    // (2, 5, 7, 10, 13, 16, 18, 21, 24, 26, 29).
    a := calendar.HijriDate { year = 1445, month = 1, day = 1 }
    b := calendar.HijriDate { year = 1446, month = 1, day = 1 }
    testing.AssertEqInt64(calendar.DaysBetweenHijri(a, b), 355 as i64)
    c := calendar.HijriDate { year = 1447, month = 1, day = 1 }
    testing.AssertEqInt64(calendar.DaysBetweenHijri(b, c), 354 as i64)
end

func test_day_arithmetic_is_reversible():
    // Days are exact, so adding and subtracting always returns the start -
    // unlike months, which clamp and therefore cannot be reversible.
    start := calendar.GregorianDate { year = 2024, month = 1, day = 31 }
    repeat 40 with k:
        there := calendar.AddDaysGregorian(start, k + 1)
        back := calendar.AddDaysGregorian(there, 0 - (k + 1))
        testing.AssertEqInt(calendar.CompareGregorian(back, start), 0)
    end
    // The documented asymmetry of month arithmetic, stated as a test so it
    // is a decision rather than a surprise.
    once := calendar.AddMonthsGregorian(start, 1)
    twice := calendar.AddMonthsGregorian(once, 0 - 1)
    testing.AssertEqStr(calendar.FormatGregorian(twice), "2024-01-29")
end

func test_weekdays():
    // 2000-01-01 was a Saturday; 1970-01-01 a Thursday.
    testing.AssertEqInt(calendar.WeekdayGregorian(calendar.GregorianDate { year = 2000, month = 1, day = 1 }), 6)
    testing.AssertEqInt(calendar.WeekdayGregorian(calendar.GregorianDate { year = 1970, month = 1, day = 1 }), 4)
    testing.AssertEqStr(calendar.WeekdayNameEn(calendar.WeekdayGregorian(calendar.GregorianDate { year = 2024, month = 3, day = 1 })), "Friday")
    // The three calendars agree, because they are the same day.
    g := calendar.GregorianDate { year = 2024, month = 3, day = 20 }
    testing.AssertEqInt(calendar.WeekdayJalali(calendar.GregorianToJalali(g)), calendar.WeekdayGregorian(g))
    testing.AssertEqInt(calendar.WeekdayHijri(calendar.GregorianToHijri(g)), calendar.WeekdayGregorian(g))
    // On-or-after leaves a date that already matches alone.
    fri := calendar.GregorianDate { year = 2024, month = 3, day = 1 }
    testing.AssertEqStr(calendar.FormatGregorian(calendar.NextWeekdayOnOrAfter(fri, 5)), "2024-03-01")
    testing.AssertEqStr(calendar.FormatGregorian(calendar.NextWeekdayOnOrAfter(fri, 0)), "2024-03-03")
end

func main:
    test_add_days_crosses_boundaries()
    test_add_months_clamps()
    test_add_years_clamps_leap_day()
    test_days_between_and_bounds()
    test_jalali_arithmetic()
    test_hijri_arithmetic()
    test_day_arithmetic_is_reversible()
    test_weekdays()
    testing.Summary()
    ret 0
end
