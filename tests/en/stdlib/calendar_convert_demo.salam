// Mode 2 of calendar's two ways to get a date: the caller already has one
// (a struct literal, or a Unix timestamp) and wants it in another calendar,
// another representation, or formatted. calendar_now_demo.salam covers mode
// 1 (reading the system clock) separately, since that one's expected output
// isn't a fixed constant.
package main

import testing
import calendar

func test_jalali_hijri_direct():
    // Jalali -> Hijri and back, without a Gregorian pit stop in the test
    // itself (the package always pivots through JDN internally either way).
    h1 := calendar.JalaliToHijri(calendar.JalaliDate { year = 1300, month = 1, day = 1 })
    testing.AssertEqInt(h1.year, 1339)
    testing.AssertEqInt(h1.month, 7)
    testing.AssertEqInt(h1.day, 11)

    h2 := calendar.JalaliToHijri(calendar.JalaliDate { year = 1357, month = 11, day = 22 })
    testing.AssertEqInt(h2.year, 1399)
    testing.AssertEqInt(h2.month, 3)
    testing.AssertEqInt(h2.day, 13)

    j1 := calendar.HijriToJalali(calendar.HijriDate { year = 1420, month = 9, day = 24 })
    testing.AssertEqInt(j1.year, 1378)
    testing.AssertEqInt(j1.month, 10)
    testing.AssertEqInt(j1.day, 11)
end

func test_three_way_roundtrip():
    // Gregorian -> Jalali -> Hijri -> Jalali -> Gregorian must be the
    // identity, since every hop pivots through the same JDN.
    g := calendar.GregorianDate { year = 2024, month = 3, day = 20 }
    j := calendar.GregorianToJalali(g)
    h := calendar.JalaliToHijri(j)
    j2 := calendar.HijriToJalali(h)
    g2 := calendar.JalaliToGregorian(j2)
    testing.AssertEqInt(g2.year, g.year)
    testing.AssertEqInt(g2.month, g.month)
    testing.AssertEqInt(g2.day, g.day)
end

func test_formatting():
    testing.AssertEqStr(calendar.FormatGregorian(calendar.GregorianDate { year = 2024, month = 3, day = 20 }), "2024-03-20")
    testing.AssertEqStr(calendar.FormatJalali(calendar.JalaliDate { year = 1403, month = 1, day = 1 }), "1403-01-01")
    testing.AssertEqStr(calendar.FormatHijri(calendar.HijriDate { year = 1445, month = 9, day = 10 }), "1445-09-10")
    testing.AssertEqStr(calendar.FormatClockTime(calendar.ClockTime { hour = 9, minute = 5, second = 3 }), "09:05:03")
    testing.AssertEqStr(calendar.FormatJalaliLongFa(calendar.JalaliDate { year = 1403, month = 1, day = 1 }), "1 فروردین 1403")
    testing.AssertEqStr(calendar.FormatHijriLongAr(calendar.HijriDate { year = 1445, month = 1, day = 1 }), "1 محرم 1445")
    testing.AssertEqStr(calendar.FormatGregorianLongEn(calendar.GregorianDate { year = 2024, month = 3, day = 20 }), "March 20, 2024")
end

func test_unix_utc():
    testing.AssertEqInt64(calendar.GregorianToUnixUTC(calendar.GregorianDate { year = 1970, month = 1, day = 1 }, 0, 0, 0), 0 as i64)
    testing.AssertEqInt64(calendar.GregorianToUnixUTC(calendar.GregorianDate { year = 2024, month = 3, day = 20 }, 12, 0, 0), 1710936000 as i64)

    // Jalali/Hijri equivalents of the same instant (1403-01-01 00:00:00
    // and 1445-09-10 00:00:00 UTC both name 2024-03-20 00:00:00 UTC).
    epochFromJalali := calendar.JalaliToUnixUTC(calendar.JalaliDate { year = 1403, month = 1, day = 1 }, 0, 0, 0)
    epochFromHijri := calendar.HijriToUnixUTC(calendar.HijriDate { year = 1445, month = 9, day = 10 }, 0, 0, 0)
    epochFromGregorian := calendar.GregorianToUnixUTC(calendar.GregorianDate { year = 2024, month = 3, day = 20 }, 0, 0, 0)
    testing.AssertEqInt64(epochFromJalali, epochFromGregorian)
    testing.AssertEqInt64(epochFromHijri, epochFromGregorian)
end

func test_epoch_to_calendars():
    epoch := calendar.GregorianToUnixUTC(calendar.GregorianDate { year = 2024, month = 3, day = 20 }, 0, 0, 0)
    // WallClockGregorian at UTC is the deterministic (host-independent) way
    // to read an epoch back out - EpochToGregorian/EpochToJalali/EpochToHijri
    // instead go through std/time's *local* wall clock, so they're covered
    // by calendar_now_demo.salam's sanity checks, not exact-value asserts here.
    back := calendar.WallClockGregorian(epoch, calendar.TZUTC())
    testing.AssertEqInt(back.year, 2024)
    testing.AssertEqInt(back.month, 3)
    testing.AssertEqInt(back.day, 20)

    jBack := calendar.WallClockJalali(epoch, calendar.TZUTC())
    testing.AssertEqInt(jBack.year, 1403)
    testing.AssertEqInt(jBack.month, 1)
    testing.AssertEqInt(jBack.day, 1)

    hBack := calendar.WallClockHijri(epoch, calendar.TZUTC())
    testing.AssertEqInt(hBack.year, 1445)
    testing.AssertEqInt(hBack.month, 9)
    testing.AssertEqInt(hBack.day, 10)
end

func main:
    test_jalali_hijri_direct()
    test_three_way_roundtrip()
    test_formatting()
    test_unix_utc()
    test_epoch_to_calendars()
    testing.Summary()
    ret 0
end
