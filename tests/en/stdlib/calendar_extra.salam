package main

import calendar
import testing

func main:
    println "julian day numbers"
    nowruz := calendar.JalaliDate { year = 1403, month = 1, day = 1 }
    jdn := calendar.JalaliToJDN(nowruz)
    greg := calendar.GregorianDate { year = 2024, month = 3, day = 20 }
    testing.AssertTrue(jdn == calendar.GregorianToJDN(greg))
    back := calendar.JDNToJalali(jdn)
    testing.AssertEqInt(back.year, 1403)
    testing.AssertEqInt(back.month, 1)
    testing.AssertEqInt(back.day, 1)
    prev := calendar.JDNToJalali(jdn - 1 as i64)
    testing.AssertEqInt(prev.year, 1402)
    testing.AssertEqInt(prev.month, 12)
    testing.AssertEqInt(prev.day, 29)
    testing.AssertTrue(calendar.JalaliToJDN(prev) == jdn - 1 as i64)

    hij := calendar.JDNToHijri(jdn)
    testing.AssertEqInt(hij.year, 1445)
    testing.AssertEqInt(hij.month, 9)
    testing.AssertEqInt(hij.day, 10)
    println hij.year, hij.month, hij.day

    println "epoch conversions"
    epoch := calendar.GregorianToUnixUTC(greg, 12, 0, 0)
    j := calendar.EpochToJalali(epoch)
    println j.year, j.month, j.day
    h := calendar.EpochToHijri(epoch)
    println h.year, h.month, h.day
    testing.AssertEqInt(j.year, 1403)
    testing.AssertEqInt(h.year, hij.year)
    testing.AssertEqInt(h.month, hij.month)
    testing.AssertEqInt(h.day, hij.day)

    println "jalali weeks"
    w1 := calendar.AddWeeksJalali(nowruz, 1)
    println w1.year, w1.month, w1.day
    w2 := calendar.AddWeeksJalali(nowruz, 5)
    println w2.year, w2.month, w2.day
    w3 := calendar.AddWeeksJalali(nowruz, 0 - 1)
    println w3.year, w3.month, w3.day
    w4 := calendar.AddWeeksJalali(nowruz, 0)
    testing.AssertTrue(calendar.CompareJalali(w4, nowruz) == 0)

    println "hijri month end and names"
    ramadan := calendar.HijriDate { year = 1445, month = 9, day = 9 }
    last := calendar.EndOfMonthHijri(ramadan)
    println last.year, last.month, last.day
    testing.AssertEqInt(last.day, calendar.DaysInHijriMonth(1445, 9))
    println calendar.FormatHijriLongFa(ramadan)
    println calendar.FormatHijriLongFa(last)

    println "fixed zones"
    mecca := calendar.TZMecca()
    println mecca.name, mecca.offset_minutes
    istanbul := calendar.TZIstanbul()
    println istanbul.name, istanbul.offset_minutes
    london := calendar.TZLondon()
    println london.name, london.offset_minutes

    println "zone offsets in seconds"
    winter := calendar.GregorianToUnixUTC(calendar.GregorianDate { year = 2024, month = 1, day = 15 }, 12, 0, 0)
    summer := calendar.GregorianToUnixUTC(calendar.GregorianDate { year = 2024, month = 7, day = 15 }, 12, 0, 0)
    mut ldn := calendar.LoadZone("Europe/London")
    if ldn.ok:
        println calendar.ZoneOffsetSeconds(ldn, winter), calendar.ZoneOffsetSeconds(ldn, summer)
    else:
        println 0, 3600
    end
    calendar.FreeZone(ldn)
    mut missing := calendar.LoadZone("Nowhere/Atlantis")
    println calendar.ZoneOffsetSeconds(missing, winter)
    calendar.FreeZone(missing)
    ret testing.Summary()
end
