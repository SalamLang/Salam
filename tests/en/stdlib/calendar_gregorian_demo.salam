package main

import testing
import calendar

func test_jdn_anchors():
    // Well-known Julian Day Number anchors.
    testing.AssertEqInt64(calendar.GregorianToJDN(calendar.GregorianDate { year = 1970, month = 1, day = 1 }), 2440588 as i64)
    testing.AssertEqInt64(calendar.GregorianToJDN(calendar.GregorianDate { year = 2000, month = 1, day = 1 }), 2451545 as i64)
end

func assert_gregorian_roundtrip(d: calendar.GregorianDate):
    back := calendar.JDNToGregorian(calendar.GregorianToJDN(d))
    testing.AssertEqInt(back.year, d.year)
    testing.AssertEqInt(back.month, d.month)
    testing.AssertEqInt(back.day, d.day)
end

func test_jdn_roundtrip():
    assert_gregorian_roundtrip(calendar.GregorianDate { year = 1600, month = 2, day = 29 })
    assert_gregorian_roundtrip(calendar.GregorianDate { year = 1900, month = 3, day = 1 })
    assert_gregorian_roundtrip(calendar.GregorianDate { year = 1970, month = 1, day = 1 })
    assert_gregorian_roundtrip(calendar.GregorianDate { year = 2000, month = 2, day = 29 })
    assert_gregorian_roundtrip(calendar.GregorianDate { year = 2024, month = 3, day = 20 })
    assert_gregorian_roundtrip(calendar.GregorianDate { year = 2100, month = 12, day = 31 })
end

func test_leap_years():
    testing.AssertFalse(calendar.IsLeapGregorian(1900))
    testing.AssertTrue(calendar.IsLeapGregorian(2000))
    testing.AssertTrue(calendar.IsLeapGregorian(2024))
    testing.AssertFalse(calendar.IsLeapGregorian(2023))
    testing.AssertTrue(calendar.IsLeapGregorian(1600))
end

func test_days_in_month():
    testing.AssertEqInt(calendar.DaysInGregorianMonth(2024, 2), 29)
    testing.AssertEqInt(calendar.DaysInGregorianMonth(2023, 2), 28)
    testing.AssertEqInt(calendar.DaysInGregorianMonth(2024, 1), 31)
    testing.AssertEqInt(calendar.DaysInGregorianMonth(2024, 4), 30)
end

func test_validation():
    testing.AssertTrue(calendar.IsValidGregorianDate(2024, 2, 29))
    testing.AssertFalse(calendar.IsValidGregorianDate(2023, 2, 29))
    testing.AssertFalse(calendar.IsValidGregorianDate(2024, 13, 1))
    testing.AssertFalse(calendar.IsValidGregorianDate(2024, 4, 31))
    testing.AssertFalse(calendar.IsValidGregorianDate(2024, 1, 0))
end

func test_weekday():
    // 1970-01-01 is a Thursday, 2000-01-01 a Saturday, 2024-03-20 a Wednesday.
    testing.AssertEqInt(calendar.Weekday(2440588 as i64), 4)
    testing.AssertEqInt(calendar.Weekday(2451545 as i64), 6)
    jdn := calendar.GregorianToJDN(calendar.GregorianDate { year = 2024, month = 3, day = 20 })
    testing.AssertEqInt(calendar.Weekday(jdn), 3)
    testing.AssertEqStr(calendar.WeekdayNameEn(calendar.Weekday(jdn)), "Wednesday")
    testing.AssertEqStr(calendar.WeekdayNameEn(0), "Sunday")
    testing.AssertEqStr(calendar.WeekdayNameEn(6), "Saturday")
    testing.AssertEqStr(calendar.WeekdayNameFa(6), "شنبه")
    testing.AssertEqStr(calendar.WeekdayNameAr(0), "الأحد")
end

func test_month_names():
    testing.AssertEqStr(calendar.GregorianMonthNameEn(1), "January")
    testing.AssertEqStr(calendar.GregorianMonthNameEn(12), "December")
end

func test_compare():
    early := calendar.GregorianDate { year = 2020, month = 1, day = 1 }
    late := calendar.GregorianDate { year = 2024, month = 3, day = 20 }
    testing.AssertEqInt(calendar.CompareGregorian(early, late), 0 - 1)
    testing.AssertEqInt(calendar.CompareGregorian(late, early), 1)
    testing.AssertEqInt(calendar.CompareGregorian(early, early), 0)
end

func main:
    test_jdn_anchors()
    test_jdn_roundtrip()
    test_leap_years()
    test_days_in_month()
    test_validation()
    test_weekday()
    test_month_names()
    test_compare()
    testing.Summary()
    ret 0
end
