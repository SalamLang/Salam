package main

import testing
import calendar

// Every Gregorian <-> Hijri anchor below was cross-checked against Python's
// `convertdate.islamic`, which implements the same tabular/civil Islamic
// calendar this package does.
func test_gregorian_to_hijri():
    h1 := calendar.GregorianToHijri(calendar.GregorianDate { year = 2000, month = 1, day = 1 })
    testing.AssertEqInt(h1.year, 1420)
    testing.AssertEqInt(h1.month, 9)
    testing.AssertEqInt(h1.day, 24)

    h2 := calendar.GregorianToHijri(calendar.GregorianDate { year = 2024, month = 7, day = 7 })
    testing.AssertEqInt(h2.year, 1445)
    testing.AssertEqInt(h2.month, 12)
    testing.AssertEqInt(h2.day, 30)

    h3 := calendar.GregorianToHijri(calendar.GregorianDate { year = 2023, month = 7, day = 19 })
    testing.AssertEqInt(h3.year, 1445)
    testing.AssertEqInt(h3.month, 1)
    testing.AssertEqInt(h3.day, 1)

    h4 := calendar.GregorianToHijri(calendar.GregorianDate { year = 1979, month = 2, day = 11 })
    testing.AssertEqInt(h4.year, 1399)
    testing.AssertEqInt(h4.month, 3)
    testing.AssertEqInt(h4.day, 13)
end

func test_hijri_to_gregorian():
    g1 := calendar.HijriToGregorian(calendar.HijriDate { year = 1445, month = 1, day = 1 })
    testing.AssertEqInt(g1.year, 2023)
    testing.AssertEqInt(g1.month, 7)
    testing.AssertEqInt(g1.day, 19)

    // The Hijri epoch itself: 1 Muharram 1 AH = 622-07-19 CE (Julian).
    g2 := calendar.HijriToGregorian(calendar.HijriDate { year = 1, month = 1, day = 1 })
    testing.AssertEqInt(g2.year, 622)
    testing.AssertEqInt(g2.month, 7)
    testing.AssertEqInt(g2.day, 19)
end

func test_epoch_jdn():
    testing.AssertEqInt64(calendar.HijriToJDN(calendar.HijriDate { year = 1, month = 1, day = 1 }), 1948440 as i64)
end

func assert_hijri_roundtrip(h: calendar.HijriDate):
    back := calendar.GregorianToHijri(calendar.HijriToGregorian(h))
    testing.AssertEqInt(back.year, h.year)
    testing.AssertEqInt(back.month, h.month)
    testing.AssertEqInt(back.day, h.day)
end

func test_roundtrip():
    assert_hijri_roundtrip(calendar.HijriDate { year = 1, month = 1, day = 1 })
    assert_hijri_roundtrip(calendar.HijriDate { year = 1420, month = 9, day = 24 })
    assert_hijri_roundtrip(calendar.HijriDate { year = 1445, month = 1, day = 1 })
    assert_hijri_roundtrip(calendar.HijriDate { year = 1445, month = 12, day = 30 })
    assert_hijri_roundtrip(calendar.HijriDate { year = 1446, month = 12, day = 29 })
end

func test_leap_years():
    testing.AssertTrue(calendar.IsLeapHijri(1445))
    testing.AssertFalse(calendar.IsLeapHijri(1446))
    testing.AssertTrue(calendar.IsLeapHijri(1420))
    testing.AssertFalse(calendar.IsLeapHijri(1))
    testing.AssertTrue(calendar.IsLeapHijri(2))
end

func test_days_in_month():
    testing.AssertEqInt(calendar.DaysInHijriMonth(1445, 1), 30)
    testing.AssertEqInt(calendar.DaysInHijriMonth(1445, 2), 29)
    testing.AssertEqInt(calendar.DaysInHijriMonth(1445, 12), 30)
    testing.AssertEqInt(calendar.DaysInHijriMonth(1446, 12), 29)
end

func test_validation():
    testing.AssertTrue(calendar.IsValidHijriDate(1445, 12, 30))
    testing.AssertFalse(calendar.IsValidHijriDate(1446, 12, 30))
    testing.AssertFalse(calendar.IsValidHijriDate(1445, 13, 1))
    testing.AssertFalse(calendar.IsValidHijriDate(1445, 1, 31))
end

func test_names():
    testing.AssertEqStr(calendar.HijriMonthNameAr(1), "محرم")
    testing.AssertEqStr(calendar.HijriMonthNameAr(12), "ذو الحجة")
    testing.AssertEqStr(calendar.HijriMonthNameEn(1), "Muharram")
    testing.AssertEqStr(calendar.HijriMonthNameEn(9), "Ramadan")
    testing.AssertEqStr(calendar.HijriMonthNameFa(9), "رمضان")
end

func test_compare():
    early := calendar.HijriDate { year = 1, month = 1, day = 1 }
    late := calendar.HijriDate { year = 1445, month = 1, day = 1 }
    testing.AssertEqInt(calendar.CompareHijri(early, late), 0 - 1)
    testing.AssertEqInt(calendar.CompareHijri(late, early), 1)
    testing.AssertEqInt(calendar.CompareHijri(early, early), 0)
end

func main:
    test_gregorian_to_hijri()
    test_hijri_to_gregorian()
    test_epoch_jdn()
    test_roundtrip()
    test_leap_years()
    test_days_in_month()
    test_validation()
    test_names()
    test_compare()
    testing.Summary()
    ret 0
end
