package main

import testing
import calendar

// Every Gregorian -> Jalali anchor below was cross-checked against Python's
// `jdatetime` (which implements the same Borkowski/jalaali-js astronomical
// algorithm this package ports).
func test_gregorian_to_jalali():
    j1 := calendar.GregorianToJalali(calendar.GregorianDate { year = 2024, month = 3, day = 20 })
    testing.AssertEqInt(j1.year, 1403)
    testing.AssertEqInt(j1.month, 1)
    testing.AssertEqInt(j1.day, 1)

    j2 := calendar.GregorianToJalali(calendar.GregorianDate { year = 2021, month = 3, day = 21 })
    testing.AssertEqInt(j2.year, 1400)
    testing.AssertEqInt(j2.month, 1)
    testing.AssertEqInt(j2.day, 1)

    // The 1979 Iranian revolution's well-known Jalali date.
    j3 := calendar.GregorianToJalali(calendar.GregorianDate { year = 1979, month = 2, day = 11 })
    testing.AssertEqInt(j3.year, 1357)
    testing.AssertEqInt(j3.month, 11)
    testing.AssertEqInt(j3.day, 22)

    j4 := calendar.GregorianToJalali(calendar.GregorianDate { year = 2000, month = 1, day = 1 })
    testing.AssertEqInt(j4.year, 1378)
    testing.AssertEqInt(j4.month, 10)
    testing.AssertEqInt(j4.day, 11)
end

func test_jalali_to_gregorian():
    g1 := calendar.JalaliToGregorian(calendar.JalaliDate { year = 1403, month = 1, day = 1 })
    testing.AssertEqInt(g1.year, 2024)
    testing.AssertEqInt(g1.month, 3)
    testing.AssertEqInt(g1.day, 20)

    g2 := calendar.JalaliToGregorian(calendar.JalaliDate { year = 1300, month = 1, day = 1 })
    testing.AssertEqInt(g2.year, 1921)
    testing.AssertEqInt(g2.month, 3)
    testing.AssertEqInt(g2.day, 21)

    g3 := calendar.JalaliToGregorian(calendar.JalaliDate { year = 1357, month = 11, day = 22 })
    testing.AssertEqInt(g3.year, 1979)
    testing.AssertEqInt(g3.month, 2)
    testing.AssertEqInt(g3.day, 11)
end

func assert_jalali_roundtrip(j: calendar.JalaliDate):
    back := calendar.GregorianToJalali(calendar.JalaliToGregorian(j))
    testing.AssertEqInt(back.year, j.year)
    testing.AssertEqInt(back.month, j.month)
    testing.AssertEqInt(back.day, j.day)
end

func test_roundtrip():
    assert_jalali_roundtrip(calendar.JalaliDate { year = 1300, month = 1, day = 1 })
    assert_jalali_roundtrip(calendar.JalaliDate { year = 1357, month = 11, day = 22 })
    assert_jalali_roundtrip(calendar.JalaliDate { year = 1400, month = 6, day = 31 })
    assert_jalali_roundtrip(calendar.JalaliDate { year = 1403, month = 12, day = 30 })
    assert_jalali_roundtrip(calendar.JalaliDate { year = 1404, month = 12, day = 29 })
end

func test_leap_years():
    testing.AssertTrue(calendar.IsLeapJalali(1403))
    testing.AssertFalse(calendar.IsLeapJalali(1404))
    testing.AssertFalse(calendar.IsLeapJalali(1405))
    testing.AssertTrue(calendar.IsLeapJalali(1300))
    testing.AssertTrue(calendar.IsLeapJalali(1350))
end

func test_days_in_month():
    testing.AssertEqInt(calendar.DaysInJalaliMonth(1403, 1), 31)
    testing.AssertEqInt(calendar.DaysInJalaliMonth(1403, 7), 30)
    testing.AssertEqInt(calendar.DaysInJalaliMonth(1403, 12), 30)
    testing.AssertEqInt(calendar.DaysInJalaliMonth(1404, 12), 29)
end

func test_validation():
    testing.AssertTrue(calendar.IsValidJalaliDate(1403, 12, 30))
    testing.AssertFalse(calendar.IsValidJalaliDate(1404, 12, 30))
    testing.AssertFalse(calendar.IsValidJalaliDate(1403, 13, 1))
    testing.AssertFalse(calendar.IsValidJalaliDate(1403, 1, 32))
end

func test_names():
    testing.AssertEqStr(calendar.JalaliMonthNameFa(1), "فروردین")
    testing.AssertEqStr(calendar.JalaliMonthNameFa(12), "اسفند")
    testing.AssertEqStr(calendar.JalaliMonthNameEn(1), "Farvardin")
    testing.AssertEqStr(calendar.JalaliMonthNameEn(7), "Mehr")

    // 2024-03-20 (Nowruz 1403) is a Wednesday; the Persian week starts
    // Saturday (index 0), so Wednesday lands at index 4.
    jdn := calendar.GregorianToJDN(calendar.GregorianDate { year = 2024, month = 3, day = 20 })
    testing.AssertEqInt(calendar.JalaliWeekday(jdn), 4)
    testing.AssertEqStr(calendar.JalaliWeekdayNameFa(calendar.JalaliWeekday(jdn)), "چهارشنبه")
    testing.AssertEqStr(calendar.JalaliWeekdayNameFa(0), "شنبه")
end

func test_compare():
    early := calendar.JalaliDate { year = 1357, month = 11, day = 22 }
    late := calendar.JalaliDate { year = 1403, month = 1, day = 1 }
    testing.AssertEqInt(calendar.CompareJalali(early, late), 0 - 1)
    testing.AssertEqInt(calendar.CompareJalali(late, early), 1)
    testing.AssertEqInt(calendar.CompareJalali(early, early), 0)
end

func main:
    test_gregorian_to_jalali()
    test_jalali_to_gregorian()
    test_roundtrip()
    test_leap_years()
    test_days_in_month()
    test_validation()
    test_names()
    test_compare()
    testing.Summary()
    ret 0
end
