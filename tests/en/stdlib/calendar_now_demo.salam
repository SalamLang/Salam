// Mode 1 of calendar's two ways to get a date: reading the system clock
// (Today*/Now*, via std/time's localtime()). Unlike calendar_convert_demo.
// salam's fixed-input tests, "today" changes every day the suite runs, so
// this checks invariants (valid ranges, cross-calendar/round-trip
// consistency) rather than one fixed expected date - the same approach
// tests/en/general/time_capture.salam uses for time.NowNanos()/NowMillis().
package main

import testing
import calendar
import time

func test_today_gregorian_is_sane():
    g := calendar.TodayGregorian()
    testing.AssertTrue(g.year >= 2024)
    testing.AssertTrue(calendar.IsValidGregorianDate(g.year, g.month, g.day))
end

func test_today_matches_epoch_conversion():
    // TodayGregorian() is just EpochToGregorian(time.Now()) under the hood;
    // check they agree instead of hard-coding a date.
    now := time.Now()
    testing.AssertEqInt(calendar.TodayGregorian().year, calendar.EpochToGregorian(now).year)
    testing.AssertEqInt(calendar.TodayGregorian().month, calendar.EpochToGregorian(now).month)
    testing.AssertEqInt(calendar.TodayGregorian().day, calendar.EpochToGregorian(now).day)
end

func test_today_jalali_is_sane():
    j := calendar.TodayJalali()
    testing.AssertTrue(calendar.IsValidJalaliDate(j.year, j.month, j.day))
    // Today's Jalali date must be exactly what converting today's Gregorian
    // date gives - this is the cross-calendar consistency check.
    g := calendar.TodayGregorian()
    fromG := calendar.GregorianToJalali(g)
    testing.AssertEqInt(j.year, fromG.year)
    testing.AssertEqInt(j.month, fromG.month)
    testing.AssertEqInt(j.day, fromG.day)
end

func test_today_hijri_is_sane():
    h := calendar.TodayHijri()
    testing.AssertTrue(calendar.IsValidHijriDate(h.year, h.month, h.day))
    g := calendar.TodayGregorian()
    fromG := calendar.GregorianToHijri(g)
    testing.AssertEqInt(h.year, fromG.year)
    testing.AssertEqInt(h.month, fromG.month)
    testing.AssertEqInt(h.day, fromG.day)
end

func test_now_clock_time_is_sane():
    t := calendar.NowClockTime()
    testing.AssertTrue(t.hour >= 0)
    testing.AssertTrue(t.hour <= 23)
    testing.AssertTrue(t.minute >= 0)
    testing.AssertTrue(t.minute <= 59)
    testing.AssertTrue(t.second >= 0)
    testing.AssertTrue(t.second <= 59)
end

func test_epoch_helpers_agree_with_time_package():
    now := time.Now()
    e := calendar.EpochToGregorian(now)
    testing.AssertEqInt(e.year, time.Year(now))
    testing.AssertEqInt(e.month, time.Month(now))
    testing.AssertEqInt(e.day, time.Day(now))

    ct := calendar.EpochToClockTime(now)
    testing.AssertEqInt(ct.hour, time.Hour(now))
    testing.AssertEqInt(ct.minute, time.Minute(now))
end

func main:
    test_today_gregorian_is_sane()
    test_today_matches_epoch_conversion()
    test_today_jalali_is_sane()
    test_today_hijri_is_sane()
    test_now_clock_time_is_sane()
    test_epoch_helpers_agree_with_time_package()
    testing.Summary()
    ret 0
end
