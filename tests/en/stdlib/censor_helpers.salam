import net.censor
import compress

const HELLO := ``

func same(a: compress.ByteBuf, b: compress.ByteBuf): bool:
    ret compress.BufEquals(a, b)
end

func sum(v: Vector<int>): int:
    mut t := 0
    repeat v.Len() in i:
        t += v.get(i)
    end
    ret t
end

func payload_of(pieces: Vector<compress.ByteBuf>): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    repeat pieces.Len() in i:
        b := pieces.get(i)
        compress.BufPushBytes(out, ((b.data as i64) + 5) as void*, b.len - 5)
    end
    ret out
end

func main:
    hello := censor.FromHex(HELLO)
    println "hello bytes", hello.len
    println censor.KindName(censor.Sniff(hello.data, hello.len))
    println censor.KindName(censor.Sniff("GET / HTTP/1.1" as void*, 14))
    println censor.KindName(censor.Sniff("POST /x" as void*, 7))
    println censor.KindName(censor.Sniff("SSH-2.0-OpenSSH_9.6" as void*, 19))
    println censor.KindName(censor.Sniff("GE" as void*, 2))
    println censor.KindName(censor.Sniff("zzzz" as void*, 4))
    s5 := censor.FromHex("050100")
    println censor.KindName(censor.Sniff(s5.data, s5.len))
    s4 := censor.FromHex("0401005000000001")
    println censor.KindName(censor.Sniff(s4.data, s4.len))

    ch := censor.ParseClientHello(hello.data, hello.len)
    println ch.ok, ch.truncated, ch.record_len
    println ch.sni, ch.sni_offset, ch.sni_len
    println ch.record_version, ch.hello_version, ch.session_id_len, ch.cipher_count, ch.ext_count
    println ch.has_tls13, ch.has_ech, ch.alpn.Len(), ch.alpn.get(0), ch.alpn.get(1)
    println censor.ExtractSNI(hello.data, 200)
    cut := censor.ParseClientHello(hello.data, 200)
    println cut.ok, cut.truncated, cut.sni
    println censor.ParseClientHello(hello.data, 60).sni.Len()
    println censor.ParseClientHello("GET / HTTP/1.1" as void*, 14).ok

    even := censor.SplitSizes(100, censor.SplitEven, 3, 0, 1 as i64)
    println even.get(0), even.get(1), even.get(2), sum(even)
    rnd := censor.SplitSizes(1000, censor.SplitRandom, 5, 0, 42 as i64)
    println rnd.Len(), sum(rnd)
    rnd2 := censor.SplitSizes(1000, censor.SplitRandom, 5, 0, 42 as i64)
    println rnd.get(0) == rnd2.get(0), rnd.get(4) == rnd2.get(4)
    first := censor.SplitSizes(517, censor.SplitFirst, 2, 5, 0 as i64)
    println first.get(0), first.get(1)
    many := censor.SplitSizes(3, censor.SplitEven, 10, 0, 0 as i64)
    println many.Len(), sum(many)

    ssz := censor.SNISplitSizes(hello.data, hello.len, false)
    println ssz.get(0), ssz.get(1), sum(ssz)
    ssz2 := censor.SNISplitSizes(hello.data, hello.len, true)
    println ssz2.Len(), ssz2.get(0), ssz2.get(1), sum(ssz2)

    mut parts := censor.Slice(hello.data, hello.len, ssz)
    joined := censor.Concat(parts)
    println parts.Len(), same(joined, hello)
    censor.FreePieces(parts)

    mut recs := censor.FragmentClientHello(hello.data, hello.len, 4, censor.SplitEven, 0 as i64)
    println recs.Len()
    first_rec := recs.get(0)
    println first_rec.len, compress.BufGet(first_rec, 0), compress.BufGet(first_rec, 1), compress.BufGet(first_rec, 2), compress.BufGet(first_rec, 3) * 256 + compress.BufGet(first_rec, 4)
    mut orig_payload := compress.NewByteBuf()
    compress.BufPushBytes(orig_payload, ((hello.data as i64) + 5) as void*, hello.len - 5)
    println same(payload_of(recs), orig_payload)
    all := censor.Concat(recs)
    println all.len, all.len == hello.len + 15
    censor.FreePieces(recs)

    body := "secret payload"
    wrapped := censor.WrapRecord(body as void*, body.Len(), 20)
    println wrapped.len, compress.BufGet(wrapped, 0), compress.BufGet(wrapped, 1), compress.BufGet(wrapped, 2)
    mut got := compress.NewByteBuf()
    println censor.UnwrapRecord(wrapped.data, wrapped.len, got), got.len
    println censor.UnwrapRecord(wrapped.data, wrapped.len - 1, got)
    println censor.UnwrapRecord(hello.data, hello.len, got)
    mut big := compress.NewByteBuf()
    repeat 40000 in i:
        compress.BufPush(big, i % 251)
    end
    stream := censor.WrapStream(big.data, big.len, 5, 50)
    mut back := compress.NewByteBuf()
    mut off := 0
    mut nrec := 0
    until off < stream.len:
        used := censor.UnwrapRecord(((stream.data as i64) + (off as i64)) as void*, stream.len - off, back)
        if used <= 0:
            break
        end
        off += used
        nrec++
    end
    println nrec, same(back, big), off == stream.len
    pl := censor.PadLength(100, 10, 10, 64)
    println pl
    println censor.RandomBytes(32).len, censor.RandomInt(5, 5)
    r := censor.RandomInt(10, 20)
    println r >= 10, r <= 20

    mut set := censor.NewDomainSet()
    println censor.AddRule(set, "example.com"), censor.AddRule(set, "full:only.test.org"), censor.AddRule(set, "keyword:torrent"), censor.AddRule(set, "domain:*.cdn.net"), censor.AddRule(set, "regexp:a.*"), censor.AddRule(set, "  ")
    println censor.AddRules(set, "# comment\nblocked.io # trailing\n\nfoo.bar\n")
    println censor.MatchDomain(set, "example.com"), censor.MatchDomain(set, "WWW.Example.COM."), censor.MatchDomain(set, "badexample.com")
    println censor.MatchDomain(set, "only.test.org"), censor.MatchDomain(set, "x.only.test.org"), censor.MatchDomain(set, "my-torrent-site.xyz")
    println censor.MatchDomain(set, "a.b.cdn.net"), censor.MatchDomain(set, "x.blocked.io"), censor.MatchDomain(set, "net")

    mut cl := censor.NewClassifier(censor.DecisionProxy)
    cl.direct = censor.IranDirectSet()
    cl.block = censor.NewDomainSet()
    println censor.AddRule(cl.block, "ads.example.org")
    println censor.Classify(cl, "www.digikala.com"), censor.Classify(cl, "mail.sharif.ir"), censor.Classify(cl, "youtube.com"), censor.Classify(cl, "ads.example.org"), censor.Classify(cl, "192.168.1.5"), censor.Classify(cl, "172.20.0.1"), censor.Classify(cl, "172.40.0.1")
    filtered := censor.FilteredSet()
    println censor.MatchDomain(filtered, "m.youtube.com"), censor.MatchDomain(filtered, "digikala.com")

    mut g := censor.NewProbeGuard(3, 1000 as i64, 5000 as i64)
    println censor.GuardAllowed(g, "1.2.3.4", 0 as i64)
    println censor.GuardRecordFail(g, "1.2.3.4", 100 as i64), censor.GuardRecordFail(g, "1.2.3.4", 200 as i64), censor.GuardRecordFail(g, "1.2.3.4", 300 as i64)
    println censor.GuardAllowed(g, "1.2.3.4", 400 as i64), censor.GuardAllowed(g, "5.6.7.8", 400 as i64), censor.GuardAllowed(g, "1.2.3.4", 5400 as i64)
    println censor.GuardRecordFail(g, "9.9.9.9", 0 as i64), censor.GuardRecordFail(g, "9.9.9.9", 2000 as i64), censor.GuardRecordFail(g, "9.9.9.9", 2100 as i64)
    mut rc := censor.NewReplayCache(1000 as i64, 4)
    println censor.ReplaySeen(rc, "a", 0 as i64), censor.ReplaySeen(rc, "a", 500 as i64), censor.ReplaySeen(rc, "a", 1600 as i64)
    println censor.ShouldFallback(false), censor.ShouldFallback(true)
    println censor.DecoyResponse().substr(0, 22)
end
