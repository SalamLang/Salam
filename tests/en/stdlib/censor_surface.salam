import net.censor
import compress

func main:
    mut b := censor.FromHex("00ff10")
    println censor.ToHex(b)
    compress.BufFree(b)

    mut ds := censor.NewDomainSet()
    censor.FreeDomainSet(ds)
    println censor.IsPrivateHost("192.168.1.5"), censor.IsPrivateHost("example.com")
    println censor.IranDirectList().Len() > 0, censor.FilteredList().Len() > 0

    mut g := censor.NewProbeGuard(3, 60000 as i64, 600000 as i64)
    censor.GuardRecordOK(g, "10.0.0.1")
    println censor.GuardAllowed(g, "10.0.0.1", 1 as i64)
    censor.FreeProbeGuard(g)

    mut rc := censor.NewReplayCache(1000 as i64, 16)
    println censor.ReplaySeen(rc, "k", 1 as i64)
    censor.FreeReplayCache(rc)

    d := censor.DelayMs(5, 9)
    println d >= 5 and d <= 9

    mut sizes := Vector {} as Vector<int>
    sizes.push(2)
    sizes.push(3)
    rec := censor.FromHex("1603010005aabbccddee")
    mut parts := censor.FragmentRecords(rec.data, rec.len, sizes)
    println parts.Len()
    repeat parts.Len() in i:
        println censor.ToHex(parts.get(i))
    end
end
