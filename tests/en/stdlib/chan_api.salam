package main

import chan

func main:
    c := chan.New(3 as i64) as chan.Chan<str>
    println "cap:", chan.Capacity(c), "len:", chan.Len(c)

    values := Vector {} as Vector<str>
    values.push("a")
    values.push("b")
    println "send all:", chan.SendAll(c, values)
    println "queued:", chan.Len(c)
    values.free()

    mut ok := false
    println "recv:", chan.Recv(c, ok), ok
    println "try recv:", chan.TryRecv(c, ok), ok
    chan.Close(c)
    println "closed:", chan.IsClosed(c), "send after close:", chan.TrySend(c, "x")

    rest := chan.Drain(c)
    println "drained:", rest.len()
    rest.free()

    slow := chan.New(1 as i64) as chan.Chan<i64>
    println "send timeout:", chan.SendTimeout(slow, 1 as i64, 100 as i64)
    println "send timeout full:", chan.SendTimeout(slow, 2 as i64, 20 as i64)

    idle := chan.New(0 as i64) as chan.Chan<i64>
    mut timed_out := true
    _ := chan.RecvTimeout(idle, timed_out, 20 as i64)
    println "recv timeout:", timed_out

    nums := Vector {} as Vector<i64>
    nums.push(1 as i64)
    nums.push(2 as i64)
    taken := chan.Take(slow, 1 as i64)
    println "take:", taken.len()
    taken.free()
    nums.free()

    a := chan.New(1 as i64) as chan.Chan<i64>
    b := chan.New(1 as i64) as chan.Chan<i64>
    mut cs := Vector {} as Vector<chan.Chan<i64>>
    cs.push(a)
    cs.push(b)
    mut got := 0 as i64
    println "try select:", chan.TrySelect(cs, got)

    chan.Send(b, 7 as i64)
    println "select recv:", chan.SelectRecv(cs, got, ok, 100 as i64), got, ok
    println "select send:", chan.SelectSend(cs, 9 as i64, 100 as i64)
    println "select send again:", chan.SelectSend(cs, 10 as i64, 100 as i64)
    println "select send full:", chan.TrySelectSend(cs, 11 as i64)

    cs.free()
    a.free()
    b.free()
    idle.free()
    slow.free()
end
