package main

import chan
import pool

func main:
    mut a := chan.Chan {} as chan.Chan<i64>
    mut b := chan.Chan {} as chan.Chan<i64>
    a.init(4 as i64)
    b.init(4 as i64)
    mut cs := Vector {} as Vector<chan.Chan<i64>>
    cs.push(a)
    cs.push(b)
    p := pool.New(2 as i64, 4 as i64)
    pool.Submit(p, (): b.send(42 as i64) end)
    mut got := 0 as i64
    idx := chan.Select(cs, got, 1000 as i64)
    println "from: ", idx, " value: ", got
    println "timeout: ", chan.Select(cs, got, 20 as i64)
    a.close()
    b.close()
    println "closed: ", chan.Select(cs, got, 20 as i64)
    pool.Stop(p)
    a.free()
    b.free()
end
