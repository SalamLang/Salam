package main

import chan
import pool
import sync

mut a := chan.Chan {} as chan.Chan<i64>
mut b := chan.Chan {} as chan.Chan<i64>

func late_sender():
    sync.SleepMs(100)
    b.send(5 as i64)
end

func main:
    a.init(1 as i64)
    b.init(0 as i64)
    mut all := Vector {} as Vector<chan.Chan<i64>>
    all.push(a)
    all.push(b)
    p := pool.New(2 as i64, 4 as i64)
    pool.Submit(p, (): late_sender() end)
    mut v := 0 as i64
    t0 := sync.NowMs()
    idx := chan.Select(all, v, 0 as i64 - 1)
    waited := sync.NowMs() - t0
    println "index: ", idx, " value: ", v
    println "waited for the sender: ", waited >= 90
    println "woke promptly: ", waited < 400
    pool.Wait(p)

    mut total := 0 as i64
    repeat 200:
        pool.Submit(p, (): a.send(1 as i64) end)
        chan.Select(all, v, 1000 as i64)
        total += v
    end
    pool.Wait(p)
    println "received: ", total

    a.close()
    println "closed one: ", chan.Select(all, v, 20 as i64)
    b.close()
    println "all closed: ", chan.Select(all, v, 20 as i64)
    pool.Stop(p)
    a.Free()
    b.Free()
end
