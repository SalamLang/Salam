package main

import chan

func main:
    mut work := chan.Chan {} as chan.Chan<i64>
    work.init(1 as i64)
    mut cs := Vector {} as Vector<chan.Chan<i64>>
    cs.push(work)
    t := chan.After(30 as i64)
    cs.push(t.c)
    mut v := 0 as i64
    println "timer fired first: ", chan.Select(cs, v, 2000 as i64)
    println "tick value: ", v
    chan.StopTimer(t)

    k := chan.Tick(10 as i64)
    mut ok := false
    mut seen := 0
    until seen < 3:
        k.c.recv(ok)
        seen++
    end
    println "ticks: ", seen
    chan.StopTimer(k)

    quick := chan.After(500 as i64)
    chan.StopTimer(quick)
    println "stopped early"
    work.Free()
end
