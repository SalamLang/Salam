package main

import cli
import flag
import debug

func main:
    mut app := cli.New("tool", "demo tool", "1.2.0")
    cli.Register(app, "build", "compile the project")
    cli.Register(app, "test", "run the tests")
    println cli.CommandDesc(app, "build")
    println cli.CommandDesc(app, "test")
    println cli.CommandDesc(app, "deploy").len()

    mut fs := flag.New("tool build", "build")
    flag.AddStr(fs, "out", "o", "a.out", "output")
    flag.AddBool(fs, "fast", "f", false, "fast mode")
    flag.AddInt(fs, "jobs", "j", 1, "jobs")
    mut names := Vector {} as Vector<str>
    names.push("out")
    names.push("jobs")
    mut missing := cli.RequireFlags(fs, names)
    println missing.len()
    mut args := Vector {} as Vector<str>
    args.push("--out")
    args.push("x.bin")
    println flag.Parse(fs, args)
    missing = cli.RequireFlags(fs, names)
    println missing.len()
    println missing.get(0)
    flag.Free(fs)

    println cli.PromptOr("Name", "guest")
    println cli.Prompt("Email").len()

    println debug.TraceEnabled()
    debug.EnableTrace(true)
    println debug.TraceEnabled()
    debug.EnableTrace(false)
    println debug.TraceEnabled()
end
