package fake

import str
import net.http
import net.router

mut _codes := Vector {} as Vector<int>
mut _bodies := Vector {} as Vector<str>
mut _heads := Vector {} as Vector<str>
mut _next := 0
mut _last := ""
mut _count := 0

func _handle(h: i64):
    ctx := http.Ctx(h)
    method := http.Method(ctx)
    path := http.Path(ctx)
    query := http.RawQuery(ctx)
    _count++
    mut line := method + " " + path
    if query.Len() > 0: line = line + "?" + query end
    user := http.Header(ctx, "X-ClickHouse-User")
    if user.Len() > 0: line = line + "\n  user: " + user end
    key := http.Header(ctx, "X-ClickHouse-Key")
    if key.Len() > 0: line = line + "\n  key: " + key end
    body := http.Body(ctx)
    if body.Len() > 0: line = line + "\n  body: " + str.TrimRight(body) end
    _last = line
    if _next >= _codes.Len():
        http.SetStatus(ctx, 500)
        http.Text(ctx, "Code: 999. DB::Exception: no reply queued")
        ret
    end
    code := _codes.get(_next)
    reply := _bodies.get(_next)
    head := _heads.get(_next)
    _next++
    if head.Len() > 0:
        c := head.find(":")
        http.SetHeader(ctx, head.substr(0, c), head.substr(c + 1, head.Len() - c - 1))
    end
    http.SetStatus(ctx, code)
    http.Text(ctx, reply)
end

pub func Reply(code: int, body: str):
    _codes.push(code)
    _bodies.push(body)
    _heads.push("")
end

pub func ReplyWith(code: int, body: str, header: str):
    _codes.push(code)
    _bodies.push(body)
    _heads.push(header)
end

pub func Last(): str:
    ret _last
end

pub func Count(): int:
    ret _count
end

pub func StartFree(): int:
    mut r := router.NewRouter()
    router.Get(r, "/*", _handle)
    router.Post(r, "/*", _handle)
    mut s := http.NewServer(0)
    http.Use(s, r)
    ret http.RunBackgroundPort(s)
end
