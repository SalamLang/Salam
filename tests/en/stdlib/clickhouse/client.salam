import str
import db.clickhouse

include fake "_fake.salam"

mut PORT := 0

func main:
    fake.Reply(200, "Ok.\n")
    fake.Reply(200, "")
    fake.ReplyWith(200, "", "X-ClickHouse-Summary:{\"read_rows\":\"0\",\"written_rows\":\"3\"}")
    fake.Reply(404, "Code: 60. DB::Exception: Table default.nope does not exist. (UNKNOWN_TABLE)\n")
    fake.Reply(200, "Ok.\n")
    PORT = fake.StartFree()
    if PORT == 0:
        println "fake server did not start"
        ret
    end
    addr := "127.0.0.1:" + str.FromInt(PORT as i64)

    mut o := clickhouse.DefaultOptions()
    o.addr = addr
    o.database = "shop"
    o.username = "alice"
    o.password = "s3cret"
    o.settings.put("max_threads", "2")
    mut c := clickhouse.Open(o)
    println "ping:", c.Ping()
    println fake.Last()

    println "exec:", c.Exec("CREATE TABLE t (id UInt64) ENGINE = Memory", Vector {} as Vector<str>)
    println fake.Last()

    mut args := Vector {} as Vector<str>
    args.push(clickhouse.IntArg(7 as i64))
    args.push(clickhouse.StrArg("o'brien"))
    println "exec args:", c.Exec("INSERT INTO t VALUES (?, ?)", args)
    println fake.Last()

    println "written:", c.written_rows
    println "bad:", c.Exec("DROP TABLE nope", Vector {} as Vector<str>)
    println "code:", c.Code(), "ok:", c.Ok()
    println "error:", str.Trim(c.Error())
    println "ping again:", c.Ping()
    c.Close()
    println "closed ping:", c.Ping(), c.Error()

    d := clickhouse.OpenURL("clickhouse://bob:p%40ss@db.example.com:9001/logs?secure=false&max_threads=4")
    println d.base, d.opts.username, d.opts.password, d.opts.database, d.opts.settings.get("max_threads")
    e := clickhouse.OpenURL("https://host.example.com")
    println e.base, e.opts.username
    f := clickhouse.OpenURL("not a url")
    println "bad url:", f.Ok(), f.Error()
end
