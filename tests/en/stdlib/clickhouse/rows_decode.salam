import str
import db.clickhouse

include fake "_fake.salam"

const SAMPLE := `{"meta":[{"name":"id","type":"UInt64"},{"name":"delta","type":"Int64"},{"name":"name","type":"Nullable(String)"},{"name":"score","type":"Float64"},{"name":"tags","type":"Array(String)"},{"name":"at","type":"DateTime('UTC')"},{"name":"ok","type":"Bool"}],"data":[["18446744073709551615","-9223372036854775808","line \"one\"\nsecond",1.5,["a","b,c"],"2024-05-06 07:08:09",true],["1","42",null,"nan",[],"2024-05-06 07:08:10",false]],"rows":2,"statistics":{"elapsed":0.001,"rows_read":2,"bytes_read":64}}`

mut PORT := 0

func main:
    fake.Reply(200, SAMPLE)
    fake.Reply(200, `{"meta":[{"name":"version()","type":"String"}],"data":[["24.8.1.1"]],"rows":1}`)
    fake.Reply(200, `{"meta":[{"name":"n","type":"UInt64"}],"data":[["9007199254740993"]],"rows":1}`)
    fake.Reply(200, `{"meta":[],"data":[],"rows":0}`)
    fake.Reply(500, "Code: 62. DB::Exception: Syntax error: failed at position 1. (SYNTAX_ERROR)\n")
    PORT = fake.StartFree()
    if PORT == 0:
        println "fake server did not start"
        ret
    end
    mut o := clickhouse.DefaultOptions()
    o.addr = "127.0.0.1:" + str.FromInt(PORT as i64)
    mut c := clickhouse.Open(o)

    mut args := Vector {} as Vector<str>
    args.push(clickhouse.UIntArg(1 as u64))
    mut rows := c.Query("SELECT * FROM t WHERE id >= ?", args)
    println fake.Last()
    println "ok:", rows.Ok(), "cols:", rows.ColumnCount(), "rows:", rows.RowCount()
    repeat rows.ColumnCount() in i:
        println i, rows.ColumnName(i), rows.ColumnType(i), rows.ColumnKind(i)
    end
    until rows.Next():
        println "id:", rows.UInt64(0), "delta:", rows.Int64(1)
        println "name:", rows.IsNull(2), rows.Text(2)
        println "score:", rows.Float(3), "ok:", rows.Bool(6)
        tags := rows.List(4)
        println "tags:", tags.Len(), rows.Raw(4)
        println "at:", rows.TextBy("at"), rows.ColumnIndex("at"), rows.ColumnIndex("zzz")
    end
    rows.Close()

    println "version:", c.ServerVersion()
    println "big:", c.QueryInt("SELECT 2 * 4503599627370496 + 1")
    println fake.Last()

    empty := c.Query("SELECT 1 WHERE 0", Vector {} as Vector<str>)
    println "empty:", empty.Ok(), empty.RowCount(), empty.ColumnCount()

    bad := c.Query("SELEC 1", Vector {} as Vector<str>)
    println "bad:", bad.Ok(), c.Code()
    println bad.Error()

    mut few := Vector {} as Vector<str>
    few.push("1")
    r2 := c.Query("SELECT ?, ?", few)
    println "mismatch:", r2.Ok(), r2.Error()
end
