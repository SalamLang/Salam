package main

import compress

func check(label: str, method: int, plain: compress.ByteBuf):
    mut packed := compress.Compress(method, plain.data, plain.len)
    mut ok := false
    mut back := compress.DecompressMax(method, packed.data, packed.len, 0, ok)
    println label, ok, compress.BufEquals(back, plain)
    compress.BufFree(back)
    mut small := compress.DecompressMax(method, packed.data, packed.len, 4, ok)
    println label, "capped", ok, small.len
    compress.BufFree(small)
    mut cut := compress.DecompressMax(method, packed.data, packed.len / 2, 0, ok)
    println label, "truncated", ok, cut.len
    compress.BufFree(cut)
    mut junk := compress.NewByteBuf()
    repeat 64 in i:
        compress.BufPush(junk, (i * 37 + 11) & 255)
    end
    mut bad := compress.DecompressMax(method, junk.data, junk.len, 0, ok)
    println label, "junk", ok, bad.len
    compress.BufFree(bad)
    compress.BufFree(junk)
    compress.BufFree(packed)
end

func blob(v: int[]): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    each x in v:
        compress.BufPush(b, x)
    end
    ret b
end

func main:
    mut plain := compress.BufFromStr("abracadabra abracadabra abracadabra, salam salam salam")
    check("rle", compress.MethodRLE, plain)
    check("huffman", compress.MethodHuffman, plain)
    check("lz77", compress.MethodLZ77, plain)
    check("lzw", compress.MethodLZW, plain)
    check("deflate", compress.MethodDeflate, plain)
    check("bwt", compress.MethodBWT, plain)
    mut ok := false
    mut in_r := blob([255, 255, 255, 255, 0])
    mut r := compress.RLEDecompressMax(in_r.data, in_r.len, 0, ok)
    println ok, r.len
    mut in_h := blob([127, 255, 255, 255, 1])
    mut h := compress.HuffmanDecompressMax(in_h.data, in_h.len, 0, ok)
    println ok, h.len
    mut in_l := blob([0, 0, 0, 16, 255, 255])
    mut l := compress.LZ77DecompressMax(in_l.data, in_l.len, 0, ok)
    println ok, l.len
    mut in_w := blob([0, 0, 0, 16, 255, 255])
    mut w := compress.LZWDecompressMax(in_w.data, in_w.len, 0, ok)
    println ok, w.len
    mut in_d := blob([0, 0, 0, 16, 255, 255])
    mut d := compress.DeflateDecompressMax(in_d.data, in_d.len, 0, ok)
    println ok, d.len
    mut in_b := blob([0, 0, 0, 16, 255, 255, 255, 255])
    mut b := compress.BWTDecompressMax(in_b.data, in_b.len, 0, ok)
    println ok, b.len
    compress.BufFree(r)
    compress.BufFree(in_r)
    compress.BufFree(h)
    compress.BufFree(in_h)
    compress.BufFree(l)
    compress.BufFree(in_l)
    compress.BufFree(w)
    compress.BufFree(in_w)
    compress.BufFree(d)
    compress.BufFree(in_d)
    compress.BufFree(b)
    compress.BufFree(in_b)
    compress.BufFree(plain)
end
