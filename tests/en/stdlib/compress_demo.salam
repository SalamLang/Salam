package main

import compress
import testing

func roundtrip_check(name: str, orig: compress.ByteBuf, decoded: compress.ByteBuf):
    testing.AssertMsg(compress.BufEquals(orig, decoded), name + " round-trip mismatch")
end

func check_rle(s: str):
    mut orig := compress.BufFromStr(s)
    mut comp := compress.RLECompress(orig.data, orig.len)
    mut decomp := compress.RLEDecompress(comp.data, comp.len)
    roundtrip_check("rle:" + s, orig, decomp)
    compress.BufFree(orig)
    compress.BufFree(comp)
    compress.BufFree(decomp)
end

func check_huffman(s: str):
    mut orig := compress.BufFromStr(s)
    mut comp := compress.HuffmanCompress(orig.data, orig.len)
    mut decomp := compress.HuffmanDecompress(comp.data, comp.len)
    roundtrip_check("huffman:" + s, orig, decomp)
    compress.BufFree(orig)
    compress.BufFree(comp)
    compress.BufFree(decomp)
end

func check_lz77(s: str):
    mut orig := compress.BufFromStr(s)
    mut comp := compress.LZ77Compress(orig.data, orig.len)
    mut decomp := compress.LZ77Decompress(comp.data, comp.len)
    roundtrip_check("lz77:" + s, orig, decomp)
    compress.BufFree(orig)
    compress.BufFree(comp)
    compress.BufFree(decomp)
end

func check_lzw(s: str):
    mut orig := compress.BufFromStr(s)
    mut comp := compress.LZWCompress(orig.data, orig.len)
    mut decomp := compress.LZWDecompress(comp.data, comp.len)
    roundtrip_check("lzw:" + s, orig, decomp)
    compress.BufFree(orig)
    compress.BufFree(comp)
    compress.BufFree(decomp)
end

func check_deflate(s: str):
    mut orig := compress.BufFromStr(s)
    mut comp := compress.DeflateCompress(orig.data, orig.len)
    mut decomp := compress.DeflateDecompress(comp.data, comp.len)
    roundtrip_check("deflate:" + s, orig, decomp)
    compress.BufFree(orig)
    compress.BufFree(comp)
    compress.BufFree(decomp)
end

func check_bwt(s: str):
    mut orig := compress.BufFromStr(s)
    mut comp := compress.BWTCompress(orig.data, orig.len)
    mut decomp := compress.BWTDecompress(comp.data, comp.len)
    roundtrip_check("bwt:" + s, orig, decomp)
    compress.BufFree(orig)
    compress.BufFree(comp)
    compress.BufFree(decomp)
end

func check_raw_deflate(s: str):
    mut orig := compress.BufFromStr(s)
    mut comp := compress.RawDeflate(orig.data, orig.len)
    mut ok := false
    mut decomp := compress.RawInflate(comp.data, comp.len, orig.len, ok)
    testing.AssertMsg(ok, "raw_deflate:" + s + " reported not ok")
    roundtrip_check("raw_deflate:" + s, orig, decomp)
    compress.BufFree(orig)
    compress.BufFree(comp)
    compress.BufFree(decomp)
end

func check_gzip(s: str):
    mut orig := compress.BufFromStr(s)
    mut comp := compress.GzipCompress(orig.data, orig.len)
    mut ok := false
    mut decomp := compress.GzipDecompress(comp.data, comp.len, ok)
    testing.AssertMsg(ok, "gzip:" + s + " reported not ok")
    roundtrip_check("gzip:" + s, orig, decomp)
    compress.BufFree(orig)
    compress.BufFree(comp)
    compress.BufFree(decomp)
end

func repeat_str(s: str, count: int): str:
    mut sb := ""
    mut i := 0
    until i < count:
        sb = sb + s
        i += 1
    end
    ret sb
end

func check_corrupt_inflate(bytes: str):
    mut buf := compress.NewByteBuf()
    parts := bytes.split(" ")
    repeat parts.len() in i:
        compress.BufPush(buf, parts.get(i).to_int())
    end
    parts.free()
    mut ok := true
    mut out := compress.RawInflate(buf.data, buf.len, 0, ok)
    testing.AssertMsg(not ok, "corrupt inflate:" + bytes + " reported ok")
    compress.BufFree(out)
    compress.BufFree(buf)
end

func main:
    testing.AssertEqInt(compress.CRC32Str("123456789") as int, -873187034)
    testing.AssertEqInt(compress.Adler32Str("Wikipedia") as int, 300286872)
    testing.AssertEqInt(compress.CRC32Str("") as int, 0)

    corpus := [
        ""
        "a"
        "abcdefgh"
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        "aaabbbbbbbbccccccccccccccccddddddefgh"
        "the quick brown fox jumps over the lazy dog the quick brown fox jumps over the lazy dog"
        "bananabananabananabanana"
        "mississippi"
        "abababababababababab"
    ]

    mut i := 0
    until i < 9:
        s := corpus[i]
        check_rle(s)
        check_huffman(s)
        check_lz77(s)
        check_lzw(s)
        check_deflate(s)
        check_bwt(s)
        check_raw_deflate(s)
        check_gzip(s)
        i += 1
    end

    check_corrupt_inflate("61 102 201")
    check_corrupt_inflate("124 12 228 94 61")
    check_corrupt_inflate("133 51 167 86 13")
    check_corrupt_inflate("77 202 24 37 48 187 29 109")

    check_lzw(repeat_str("The quick brown fox jumps over the lazy dog. ", 200))

    mut bin := compress.NewByteBuf()
    compress.BufPush(bin, 0)
    compress.BufPush(bin, 1)
    compress.BufPush(bin, 2)
    compress.BufPush(bin, 0)
    compress.BufPush(bin, 0)
    compress.BufPush(bin, 255)
    compress.BufPush(bin, 254)
    compress.BufPush(bin, 0)

    mut bc := compress.HuffmanCompress(bin.data, bin.len)
    mut bd := compress.HuffmanDecompress(bc.data, bc.len)
    roundtrip_check("binary:huffman", bin, bd)
    compress.BufFree(bc)
    compress.BufFree(bd)

    bc = compress.RLECompress(bin.data, bin.len)
    bd = compress.RLEDecompress(bc.data, bc.len)
    roundtrip_check("binary:rle", bin, bd)
    compress.BufFree(bc)
    compress.BufFree(bd)

    bc = compress.LZ77Compress(bin.data, bin.len)
    bd = compress.LZ77Decompress(bc.data, bc.len)
    roundtrip_check("binary:lz77", bin, bd)
    compress.BufFree(bc)
    compress.BufFree(bd)

    bc = compress.LZWCompress(bin.data, bin.len)
    bd = compress.LZWDecompress(bc.data, bc.len)
    roundtrip_check("binary:lzw", bin, bd)
    compress.BufFree(bc)
    compress.BufFree(bd)

    bc = compress.DeflateCompress(bin.data, bin.len)
    bd = compress.DeflateDecompress(bc.data, bc.len)
    roundtrip_check("binary:deflate", bin, bd)
    compress.BufFree(bc)
    compress.BufFree(bd)

    bc = compress.BWTCompress(bin.data, bin.len)
    bd = compress.BWTDecompress(bc.data, bc.len)
    roundtrip_check("binary:bwt", bin, bd)
    compress.BufFree(bc)
    compress.BufFree(bd)

    bc = compress.RawDeflate(bin.data, bin.len)
    mut raw_ok := false
    bd = compress.RawInflate(bc.data, bc.len, bin.len, raw_ok)
    testing.AssertMsg(raw_ok, "binary:raw_deflate reported not ok")
    roundtrip_check("binary:raw_deflate", bin, bd)
    compress.BufFree(bc)
    compress.BufFree(bd)

    bc = compress.GzipCompress(bin.data, bin.len)
    mut gz_ok := false
    bd = compress.GzipDecompress(bc.data, bc.len, gz_ok)
    testing.AssertMsg(gz_ok, "binary:gzip reported not ok")
    roundtrip_check("binary:gzip", bin, bd)
    compress.BufFree(bc)
    compress.BufFree(bd)

    compress.BufFree(bin)

    mut text := compress.BufFromStr("the quick brown fox jumps over the lazy dog the quick brown fox jumps over the lazy dog")
    methods := [
        compress.MethodNone, compress.MethodRLE, compress.MethodHuffman
        compress.MethodLZ77, compress.MethodLZW, compress.MethodDeflate, compress.MethodBWT
    ]
    mut m := 0
    until m < 7:
        method := methods[m]
        mut mc := compress.CompressBuf(method, text)
        mut md := compress.DecompressBuf(method, mc)
        testing.AssertMsg(compress.BufEquals(text, md), "dispatch method " + method + " round-trip mismatch")
        compress.BufFree(mc)
        compress.BufFree(md)
        m += 1
    end

    mut winner := compress.MethodNone
    mut best := compress.CompressBest(text.data, text.len, winner)
    mut bestDecoded := compress.Decompress(winner, best.data, best.len)
    testing.AssertMsg(compress.BufEquals(text, bestDecoded), "CompressBest round-trip mismatch")
    testing.AssertTrue(compress.BufLen(best) <= compress.BufLen(text) + 5)
    compress.BufFree(best)
    compress.BufFree(bestDecoded)
    compress.BufFree(text)

    ret testing.Summary()
end
