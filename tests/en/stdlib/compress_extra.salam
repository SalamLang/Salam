package main

import compress
import mem

mut pool_s := Vector {} as Vector<str>
mut pool_b := Vector {} as Vector<compress.ByteBuf>

func ks(s: str): str:
    pool_s.Push(s)
    ret s
end

func kb(b: compress.ByteBuf): compress.ByteBuf:
    pool_b.Push(b)
    ret b
end

func txt(b: compress.ByteBuf): str:
    ret ks(compress.BufToStrUnsafe(b))
end

func b64(b: compress.ByteBuf): str:
    ret ks(compress.BufToBase64(b))
end

func release():
    repeat pool_s.Len() in i:
        s := pool_s.Get(i)
        if s.Len() > 0:
            mem.Free(s as void*)
        end
    end
    pool_s.Free()
    repeat pool_b.Len() in i:
        mut b := pool_b.Get(i)
        compress.BufFree(b)
    end
    pool_b.Free()
end

func main:
    println compress.CRC32Str("123456789") as int
    b := kb(compress.BufFromStr("123456789"))
    println compress.CRC32(b.data, b.len) as int, compress.CRC32Buf(b) as int
    println compress.Adler32(b.data, b.len) as int, compress.Adler32Buf(b) as int, compress.Adler32Str("123456789") as int

    mut w := compress.NewBitWriter()
    compress.BitWriteBit(w, 1)
    compress.BitWriteBit(w, 0)
    compress.BitWriteBits(w, 5, 3)
    compress.BitWriteBits(w, 1000, 11)
    println compress.BitWriterLen(w)
    compress.BitFlush(w)
    println compress.BitWriterLen(w)
    mut r := compress.BitReaderFromBuf(w.buf)
    println compress.BitReadBit(r), compress.BitReadBit(r), compress.BitReadBits(r, 3), compress.BitReadBits(r, 11)
    println r.bad
    _ := compress.BitReadBits(r, 16)
    println r.bad
    mut r2 := compress.NewBitReader(w.buf.data, 1)
    println compress.BitReadBits(r2, 8), r2.bad
    compress.BitWriterFree(w)

    mut cap := compress.NewByteBufCap(4)
    compress.BufPushU32(cap, 258)
    compress.BufPush(cap, 255)
    println compress.BufLen(cap), b64(cap)
    mut rd := compress.ReaderFromBuf(cap)
    println compress.RdByte(rd), compress.RdByte(rd), compress.RdByte(rd), compress.RdByte(rd)
    mut rd2 := compress.ReaderFromBuf(cap)
    mut two := compress.RdBytes(rd2, 2)
    println compress.BufLen(two), compress.RdLeft(rd2), rd2.bad
    mut rd3 := compress.ReaderFromBuf(cap)
    println compress.RdU32(rd3), compress.RdByte(rd3), rd3.bad
    println b64(kb(compress.BufFromStr("foobar")))
    compress.BufFree(two)
    compress.BufFree(cap)

    mut primary := 0
    src := kb(compress.BufFromStr("banana"))
    t := kb(compress.BWTTransform(src.data, src.len, primary))
    println txt(t), primary
    back := kb(compress.BWTInverse(t.data, t.len, primary))
    println txt(back)
    m := kb(compress.MTFEncode(src))
    println compress.BufLen(m), compress.BufGet(m, 0), compress.BufGet(m, 1), compress.BufGet(m, 2)
    println txt(kb(compress.MTFDecode(m)))

    text := "to be or not to be, to be or not to be"
    c := kb(compress.CompressStr(compress.MethodRLE, text))
    println txt(kb(compress.Decompress(compress.MethodRLE, c.data, c.len))) == text
    each mm in [compress.MethodNone, compress.MethodHuffman, compress.MethodLZ77, compress.MethodLZW, compress.MethodDeflate, compress.MethodBWT]:
        z := kb(compress.Compress(mm, text as void*, text.Len()))
        d := kb(compress.Decompress(mm, z.data, z.len))
        println mm, txt(d) == text
    end
    println compress.Ratio(50, 100), compress.Ratio(1, 4), compress.Ratio(5, 0)

    g := kb(compress.GzipCompressStr(text))
    mut ok := false
    gd := kb(compress.GzipDecompressBuf(g, ok))
    println ok, txt(gd) == text
    _ := kb(compress.GzipDecompressMax(g.data, g.len, 5, ok))
    println ok
    gm := kb(compress.GzipDecompressMax(g.data, g.len, 0, ok))
    println ok, txt(gm) == text
    raw := kb(compress.RawDeflate(text as void*, text.Len()))
    _ := kb(compress.RawInflateMax(raw.data, raw.len, text.Len(), 5, ok))
    println ok
    rm := kb(compress.RawInflateMax(raw.data, raw.len, text.Len(), 0, ok))
    println ok, txt(rm) == text
    release()
end
