package main

import compress

func main:
    println compress.CRC32Str("123456789") as int
    b := compress.BufFromStr("123456789")
    println compress.CRC32(b.data, b.len) as int, compress.CRC32Buf(b) as int
    println compress.Adler32(b.data, b.len) as int, compress.Adler32Buf(b) as int, compress.Adler32Str("123456789") as int

    mut w := compress.NewBitWriter()
    compress.BitWriteBit(w, 1)
    compress.BitWriteBit(w, 0)
    compress.BitWriteBits(w, 5, 3)
    compress.BitWriteBits(w, 1000, 11)
    println compress.BitWriterLen(w)
    compress.BitFlush(w)
    println compress.BitWriterLen(w)
    mut r := compress.BitReaderFromBuf(w.buf)
    println compress.BitReadBit(r), compress.BitReadBit(r), compress.BitReadBits(r, 3), compress.BitReadBits(r, 11)
    println r.bad
    _ := compress.BitReadBits(r, 16)
    println r.bad
    mut r2 := compress.NewBitReader(w.buf.data, 1)
    println compress.BitReadBits(r2, 8), r2.bad
    compress.BitWriterFree(w)

    mut cap := compress.NewByteBufCap(4)
    compress.BufPushU32(cap, 258)
    compress.BufPush(cap, 255)
    println compress.BufLen(cap), compress.BufToBase64(cap)
    mut rd := compress.ReaderFromBuf(cap)
    println compress.RdByte(rd), compress.RdByte(rd), compress.RdByte(rd), compress.RdByte(rd)
    mut rd2 := compress.ReaderFromBuf(cap)
    mut two := compress.RdBytes(rd2, 2)
    println compress.BufLen(two), compress.RdLeft(rd2), rd2.bad
    mut rd3 := compress.ReaderFromBuf(cap)
    println compress.RdU32(rd3), compress.RdByte(rd3), rd3.bad
    println compress.BufToBase64(compress.BufFromStr("foobar"))
    compress.BufFree(two)
    compress.BufFree(cap)

    mut primary := 0
    src := compress.BufFromStr("banana")
    t := compress.BWTTransform(src.data, src.len, primary)
    println compress.BufToStrUnsafe(t), primary
    back := compress.BWTInverse(t.data, t.len, primary)
    println compress.BufToStrUnsafe(back)
    m := compress.MTFEncode(src)
    println compress.BufLen(m), compress.BufGet(m, 0), compress.BufGet(m, 1), compress.BufGet(m, 2)
    println compress.BufToStrUnsafe(compress.MTFDecode(m))

    text := "to be or not to be, to be or not to be"
    c := compress.CompressStr(compress.MethodRLE, text)
    println compress.BufToStrUnsafe(compress.Decompress(compress.MethodRLE, c.data, c.len)) == text
    each mm in [compress.MethodNone, compress.MethodHuffman, compress.MethodLZ77, compress.MethodLZW, compress.MethodDeflate, compress.MethodBWT]:
        z := compress.Compress(mm, text as void*, text.len())
        d := compress.Decompress(mm, z.data, z.len)
        println mm, compress.BufToStrUnsafe(d) == text
    end
    println compress.Ratio(50, 100), compress.Ratio(1, 4), compress.Ratio(5, 0)

    g := compress.GzipCompressStr(text)
    mut ok := false
    gd := compress.GzipDecompressBuf(g, ok)
    println ok, compress.BufToStrUnsafe(gd) == text
    _ := compress.GzipDecompressMax(g.data, g.len, 5, ok)
    println ok
    gm := compress.GzipDecompressMax(g.data, g.len, 0, ok)
    println ok, compress.BufToStrUnsafe(gm) == text
    raw := compress.RawDeflate(text as void*, text.len())
    _ := compress.RawInflateMax(raw.data, raw.len, text.len(), 5, ok)
    println ok
    rm := compress.RawInflateMax(raw.data, raw.len, text.len(), 0, ok)
    println ok, compress.BufToStrUnsafe(rm) == text
end
