package main

import compress
import mem
import testing

func assert_buf_str(b: compress.ByteBuf, want: str):
    got := compress.BufToStrUnsafe(b)
    testing.AssertEqStr(got, want)
    if got.Len() > 0:
        mem.Free(got as void*)
    end
end

func main(): int:
    text := "the quick brown fox jumps over the lazy dog"
    mut packed := compress.GzipCompressStr(text)
    mut ok := false
    mut out := compress.GzipDecompressBuf(packed, ok)
    testing.AssertTrue(ok)
    assert_buf_str(out, text)
    compress.BufFree(out)

    // A corrupted CRC32 in the trailer must be noticed, not ignored.
    mut bad_crc := compress.BufClone(packed)
    compress.BufSet(bad_crc, bad_crc.len - 8, (compress.BufGet(bad_crc, bad_crc.len - 8) ^ 1))
    ok = true
    out = compress.GzipDecompressBuf(bad_crc, ok)
    testing.AssertFalse(ok)
    testing.AssertEqInt(out.len, 0)
    compress.BufFree(out)
    compress.BufFree(bad_crc)

    // The uncompressed length (ISIZE) is checked too.
    mut bad_size := compress.BufClone(packed)
    compress.BufSet(bad_size, bad_size.len - 1, (compress.BufGet(bad_size, bad_size.len - 1) + 1) & 255)
    ok = true
    out = compress.GzipDecompressBuf(bad_size, ok)
    testing.AssertFalse(ok)
    testing.AssertEqInt(out.len, 0)
    compress.BufFree(out)
    compress.BufFree(bad_size)

    // A copy that is left alone still round-trips.
    ok = false
    out = compress.GzipDecompressBuf(packed, ok)
    testing.AssertTrue(ok)
    assert_buf_str(out, text)
    compress.BufFree(out)
    compress.BufFree(packed)

    ret testing.Summary()
end
