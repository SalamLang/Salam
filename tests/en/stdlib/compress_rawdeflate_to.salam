package main

import compress
import testing

func make_data(n: int, seed: int): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        compress.BufPush(b, 97 + (x >> 16) % 7)
    end
    ret b
end

func main(): int:
    mut data := make_data(50000, 5)
    mut w := compress.NewBitWriter()
    mut at := 0
    until at < data.len:
        mut take := 12345
        if data.len - at < take:
            take = data.len - at
        end
        last := at + take >= data.len
        compress.RawDeflateTo(w, ((data.data as i64) + (at as i64)) as void*, take, last)
        at += take
    end
    compress.BitFlush(w)
    mut ok := false
    mut out := compress.RawInflate(w.buf.data, w.buf.len, data.len, ok)
    testing.AssertTrue(ok)
    testing.AssertTrue(compress.BufEquals(out, data))
    compress.BufFree(out)

    mut whole := compress.RawDeflate(data.data, data.len)
    mut again := compress.RawInflate(whole.data, whole.len, data.len, ok)
    testing.AssertTrue(ok and compress.BufEquals(again, data))
    compress.BufFree(again)
    compress.BufFree(whole)

    mut empty := compress.NewBitWriter()
    compress.RawDeflateTo(empty, null, 0, true)
    compress.BitFlush(empty)
    mut none := compress.RawInflate(empty.buf.data, empty.buf.len, 0, ok)
    testing.AssertTrue(ok and none.len == 0)
    compress.BufFree(none)
    compress.BitWriterFree(empty)

    compress.BitWriterFree(w)
    compress.BufFree(data)
    ret testing.Summary()
end
