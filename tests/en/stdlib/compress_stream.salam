import compress
import filepath
import mem
import os

func main:
    base := filepath.Join(os.TempDir(), "salam_compress_stream")
    os.RemoveAll(base)
    os.MkdirAll(base)
    text := "stream me, stream me, stream me. " * 100
    packed := compress.RawDeflate(text as void*, text.len())

    mut sink := compress.SinkOpen(filepath.Join(base, "packed.bin"), 0 as i64)
    println compress.SinkWrite(sink, packed.data, packed.len), sink.written == (packed.len as i64), sink.failed
    println compress.SinkClose(sink), sink.fp == null

    fp := compress.FileOpenRead(filepath.Join(base, "packed.bin"))
    size := compress.FileSize(fp)
    println size == (packed.len as i64)
    head := mem.Allocate(4 as u64)
    got := compress.FileReadAt(fp, 0 as i64, head, 4)
    println got, compress.FileSeek(fp, 0 as i64)
    mem.Free(head)

    mut reader := compress.NewFileBitReader(fp, 0 as i64, size)
    println reader.fp == fp, reader.left == size
    mut out := compress.SinkOpen(filepath.Join(base, "text.txt"), 0 as i64)
    ok := compress.RawInflateToSink(reader, out, false)
    compress.FileBitReaderFree(reader)
    println ok, compress.SinkClose(out), out.written == (text.len() as i64), out.crc == compress.CRC32Str(text)

    mut small := compress.SinkOpen(filepath.Join(base, "small.txt"), 100 as i64)
    mut again := compress.NewFileBitReader(fp, 0 as i64, size)
    println compress.RawInflateToSink(again, small, false), small.over, small.cap
    compress.FileBitReaderFree(again)
    compress.SinkClose(small)

    mut part := compress.SinkOpen(filepath.Join(base, "part.bin"), 0 as i64)
    println compress.SinkCopyFrom(part, fp, 2 as i64, 10 as i64), part.written
    compress.SinkClose(part)
    compress.FileClose(fp)

    first := "hello, "
    second := "world"
    running := compress.CRC32Update(compress.CRC32Update(0 as u32, first as void*, first.len()), second as void*, second.len())
    println running == compress.CRC32Str(first + second)

    gen := (off: i64, dst: void*, n: int, _c: void*):
        p := dst as u8*
        repeat n in k:
            p[k] = ((off + (k as i64)) & (255 as i64)) as u8
        end
        ret n
    end
    marker := mem.Allocate(8 as u64)
    cfp := compress.CallbackOpenRead(1000 as i64, gen, marker)
    println compress.FileSize(cfp), compress.CallbackContext(cfp) == marker
    probe := mem.Allocate(4 as u64)
    println compress.FileReadAt(cfp, 258 as i64, probe, 4), (probe as u8*)[0], (probe as u8*)[3]
    compress.FileClose(cfp)
    mem.Free(probe)
    mem.Free(marker)

    call := mem.AllocateZeroed(16 as u64) as u8*
    call[0] = 0xE8 as u8
    call[2] = 1 as u8
    mut mask := 0
    done := compress.BcjStep(compress.BcjX86, call as void*, 16, 0 as i64, mask)
    println done, call[1] as int, call[2] as int, call[3] as int, call[4] as int, mask
    mem.Free(call as void*)

    wf := compress.FileOpenWrite(filepath.Join(base, "empty.bin"))
    println compress.FileSize(wf)
    compress.FileClose(wf)
    println compress.FileOpenRead("no-such-file.bin") == null
    os.RemoveAll(base)
end
