package main

import conv

func show(label: str, e: Error):
    println label + ": " + e.kind_name() + " | " + e.ToStr() + " [" + e.code + ", offset " + e.offset + "]"
end

func int_case(label: str, text: str):
    try:
        println label + ": ok " + conv.ParseInt(text)
    catch e:
        show(label, e)
    end
end

func atoi_case(label: str, text: str):
    try:
        println label + ": ok " + conv.Atoi(text)
    catch e:
        show(label, e)
    end
end

func float_case(label: str, text: str):
    try:
        println label + ": ok " + conv.FormatFloat(conv.ParseFloat(text))
    catch e:
        show(label, e)
    end
end

func bool_case(label: str, text: str):
    try:
        println label + ": ok " + conv.ParseBool(text)
    catch e:
        show(label, e)
    end
end

func hex_case(label: str, text: str):
    try:
        println label + ": ok " + conv.ParseHex(text)
    catch e:
        show(label, e)
    end
end

func ints():
    println "== ParseInt =="
    int_case("plain", "42")
    int_case("spaces and sign", "  -42\n")
    int_case("plus sign", "+7")
    int_case("Persian digits", "۱۴۰۳")
    int_case("Arabic digits", "٤٥")
    int_case("largest", "9223372036854775807")
    int_case("smallest", "-9223372036854775808")
    int_case("empty", "")
    int_case("only spaces", "   ")
    int_case("sign alone", "-")
    int_case("letters after digits", "12abc")
    int_case("space inside", "1 000")
    int_case("underscore", "1_000")
    int_case("decimal point", "12.5")
    int_case("Persian word", "سلام")
    int_case("one past the largest", "9223372036854775808")
    int_case("twenty digits", "-99999999999999999999")
end

func atois():
    println ""
    println "== Atoi =="
    atoi_case("fits", "2147483647")
    atoi_case("smallest", "-2147483648")
    atoi_case("too large for int", "3000000000")
    atoi_case("bad character", "80a")
end

func floats():
    println ""
    println "== ParseFloat =="
    float_case("plain", "2.5")
    float_case("exponent", "-1.25e2")
    float_case("Persian separator", "۳٫۷۵")
    float_case("leading point", ".5")
    float_case("infinity", "-Infinity")
    float_case("underflow is zero", "1e-400")
    float_case("comma", "1,5")
    float_case("second point", "1.2.3")
    float_case("bare exponent", "1e")
    float_case("point alone", ".")
    float_case("hex prefix", "0x10")
    float_case("too large", "1e400")
end

func bools():
    println ""
    println "== ParseBool =="
    each t in ["true", " yes ", "on", "1", "false", "no", "off", "0"]:
        bool_case("[" + t + "]", t)
    end
    bool_case("capital letter", "True")
    bool_case("empty", "")
    bool_case("other word", "maybe")
end

func hexes():
    println ""
    println "== ParseHex =="
    hex_case("prefix", "0xff")
    hex_case("upper case digits", "1A")
    hex_case("all 64 bits", "ffffffffffffffff")
    hex_case("upper case prefix", "0X1A")
    hex_case("prefix alone", "0x")
    hex_case("hash sign", "#fff")
    hex_case("seventeen digits", "10000000000000000")
end

func fallbacks():
    println ""
    println "== fallbacks =="
    println "ParseIntOr:", conv.ParseIntOr("12abc", 0 - 1), conv.ParseIntOr(" 12 ", 0 - 1)
    println "AtoiOr:", conv.AtoiOr("", 8080), conv.AtoiOr("443", 8080)
    println "ParseFloatOr:", conv.ParseFloatOr("n/a", 0.5), conv.ParseFloatOr("۱٫۲۵", 0.5)
    println "ParseBoolOr:", conv.ParseBoolOr("True", false), conv.ParseBoolOr("on", false)
    println "ParseHexOr:", conv.ParseHexOr("zz", 0 - 1), conv.ParseHexOr("0x10", 0 - 1)
    port := try conv.Atoi("abc") catch 3000
    println "try with catch:", port
end

func total(parts: str[]): i64 throws:
    mut sum := 0 as i64
    each p in parts:
        sum += try conv.ParseInt(p)
    end
    ret sum
end

func propagate():
    println ""
    println "== passing the error on =="
    try:
        println "good list:", total(["1", "۲", "3"])
        println "bad list:", total(["1", "two", "3"])
    catch e:
        println e.is(ErrorKind.Syntax), e.column, e.ToStr()
    end
end

func main:
    ints()
    atois()
    floats()
    bools()
    hexes()
    fallbacks()
    propagate()
end
