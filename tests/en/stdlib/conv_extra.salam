package main

import conv
import math

func main:
    println "short float text"
    println conv.FormatFloatShort(0.0), conv.FormatFloatShort(-1.5)
    println conv.FormatFloatShort(1.0),
        conv.FormatFloatShort(100.0),
        conv.FormatFloatShort(123456.0)
    println conv.FormatFloatShort(0.5),
        conv.FormatFloatShort(0.125),
        conv.FormatFloatShort(3.14159265)
    println conv.FormatFloatShort(0.0001), conv.FormatFloatShort(0.00001)
    println conv.FormatFloatShort(1234567.0), conv.FormatFloatShort(-25000000.0)
    println conv.FormatFloatShort(1.0 / 3.0), conv.FormatFloatShort(2.0 / 3.0)
    nan := 0.0 / 0.0
    inf := 1.0 / 0.0
    println conv.FormatFloatShort(nan), conv.FormatFloatShort(inf), conv.FormatFloatShort(-inf)

    println "not a number"
    println conv.IsNaNF(nan), conv.IsNaNF(0.0), conv.IsNaNF(inf), conv.IsNaNF(-1.0)
    println conv.IsNaNF(nan + 1.0), conv.IsNaNF(inf - inf), conv.IsNaNF(math.Sqrt(-1.0))
end
