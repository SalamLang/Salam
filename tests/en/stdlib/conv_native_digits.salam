import conv
import fmt
func main throws:
    println try conv.ParseInt("  -۲۷ "), try conv.ParseInt("٣٤"), try conv.ParseInt("12"), try conv.ParseFloat("۱۲٫۵"), try conv.ParseFloat("2.5e3")
    println "[" + fmt.PadLeft("سلام", 6) + "]", "[" + fmt.Center("ab", 6) + "]"
end
