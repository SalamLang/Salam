import conv
import fmt
func main:
    println conv.ParseInt("  -۲۷ "), conv.ParseInt("٣٤x"), conv.ParseInt("12"), conv.ParseFloat("۱۲٫۵"), conv.ParseFloat("2.5e3")
    println "[" + fmt.PadLeft("سلام", 6) + "]", "[" + fmt.Center("ab", 6) + "]"
end
