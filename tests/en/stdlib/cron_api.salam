package main

import cron

const ZONE := "Invalid/Nowhere"
const OFF := 210
const NOON := 1792843200

func main:
    println "offset fallback: ", cron.OffsetSeconds(ZONE, OFF, NOON as i64)
    println "offset negative: ", cron.OffsetSeconds(ZONE, -300, NOON as i64)

    every5 := cron.Parse("*/5 * * * *")
    println "local 0 min: ", cron.MatchesLocal(every5, 1792843200 as i64)
    println "local 5 min: ", cron.MatchesLocal(every5, 1792843500 as i64)
    println "local 7 min: ", cron.MatchesLocal(every5, 1792843620 as i64)

    daily := cron.Parse("0 12 * * *")
    println "daily noon: ", cron.MatchesLocal(daily, 1792843200 as i64)
    println "daily 12:01: ", cron.MatchesLocal(daily, 1792843260 as i64)

    bad := cron.Parse("nope")
    println "invalid expr: ", cron.MatchesLocal(bad, 1792843200 as i64)

    shifted := NOON as i64 + cron.OffsetSeconds(ZONE, OFF, NOON as i64)
    println "shifted 15:30: ", cron.MatchesLocal(cron.Parse("30 15 * * *"), shifted)
end
