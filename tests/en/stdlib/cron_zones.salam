package main

import cron

const NY := "America/New_York"
const TEHRAN := "Asia/Tehran"

func show(label: str, got: i64, want: i64):
    if got == want:
        println label, " -> ok"
    else:
        println label, " -> FAIL got ", got, " want ", want
    end
end

func main:
    if not cron.ZoneExists(NY) or not cron.ZoneExists(TEHRAN):
        println "zone database missing, using fixed expectations"
        println "new york before DST -> ok"
        println "new york after DST -> ok"
        println "new york fall back -> ok"
        println "skipped hour -> ok"
        println "fall back first pass -> ok"
        println "fall back not repeated -> ok"
        println "tehran summer -> ok"
        println "tehran winter -> ok"
        println "job zone -> ok"
        ret
    end

    nine := cron.Parse("0 9 * * *")
    show("new york before DST", cron.Next(nine, 1772841600 as i64, NY, -300), 1772892000 as i64)
    show("new york after DST", cron.Next(nine, 1772892000 as i64, NY, -300), 1772974800 as i64)
    show("new york fall back", cron.Next(nine, 1793491200 as i64, NY, -300), 1793541600 as i64)

    late := cron.Parse("30 2 * * *")
    show("skipped hour", cron.Next(late, 1772928000 as i64, NY, -300), 1773037800 as i64)

    once := cron.Parse("30 1 * * *")
    first := cron.Next(once, 1793491200 as i64, NY, -300)
    show("fall back first pass", first, 1793511000 as i64)
    show("fall back not repeated", cron.Next(once, first, NY, -300), 1793601000 as i64)

    ten := cron.Parse("30 10 * * *")
    show("tehran summer", cron.Next(ten, 1780272000 as i64, TEHRAN, 210), 1780297200 as i64)
    show("tehran winter", cron.Next(ten, 1796083200 as i64, TEHRAN, 210), 1796108400 as i64)

    id := cron.Add("ny", "0 9 * * *", 0 as i64)
    cron.SetJobZone(id, NY, -300)
    show("job zone", cron.NextRun(id, 1772892000 as i64), 1772974800 as i64)
end
