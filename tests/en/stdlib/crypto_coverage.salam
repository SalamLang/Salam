package main

import testing
import crypto
import mem
import str

pure func hexdigit(v: int): int:
    if v < 10: ret 48 + v end
    ret 87 + v
end

func hex_of(p: void*, n: int): str:
    bp := p as u8*
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    repeat n in i:
        b := bp[i] as int
        str.BufAppendChar(sb, hexdigit(b / 16))
        str.BufAppendChar(sb, hexdigit(b % 16))
    end
    out := str.BufStr(sb)
    ret out
end

func test_digests():
    msg := "abc"
    out := mem.Allocate(64 as u64)
    defer mem.Free(out)
    crypto.Md5Bytes(msg as void*, 3, out)
    testing.AssertEqStr(hex_of(out, 16), "900150983cd24fb0d6963f7d28e17f72")
    crypto.Sha1Bytes(msg as void*, 3, out)
    testing.AssertEqStr(hex_of(out, 20), "a9993e364706816aba3e25717850c26c9cd0d89d")
    crypto.Sha384Bytes(msg as void*, 3, out)
    testing.AssertEqStr(hex_of(out, 48), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    crypto.Sha512Bytes(msg as void*, 3, out)
    testing.AssertEqStr(hex_of(out, 64), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
end

func test_streaming():
    out := mem.Allocate(64 as u64)
    defer mem.Free(out)
    mut s := crypto.Sha256New()
    crypto.Sha256Update(s, "a" as void*, 1)
    crypto.Sha256Update(s, "bc" as void*, 2)
    crypto.Sha256Final(s, out)
    testing.AssertEqStr(hex_of(out, 32), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    mut s3 := crypto.Sha384New()
    crypto.Sha512Update(s3, "a" as void*, 1)
    crypto.Sha512Update(s3, "bc" as void*, 2)
    crypto.Sha512Final(s3, out)
    testing.AssertEqStr(hex_of(out, 48), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    mut s5 := crypto.Sha512New()
    crypto.Sha512Update(s5, "ab" as void*, 2)
    crypto.Sha512Update(s5, "c" as void*, 1)
    crypto.Sha512Final(s5, out)
    testing.AssertEqStr(hex_of(out, 64), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
end

func test_hmac():
    key := "Jefe"
    data := "what do ya want for nothing?"
    out := mem.Allocate(64 as u64)
    defer mem.Free(out)
    crypto.HmacSha1Bytes(key, data, out)
    testing.AssertEqStr(hex_of(out, 20), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    testing.AssertEqStr(crypto.HmacSha1Hex(key, data), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    testing.AssertEqStr(crypto.HmacSha1Base64(key, data), "7/zfauXrL6LSdBbV8YTfnCWafHk=")
    crypto.HmacSha1Raw(key as void*, 4, data as void*, data.len(), out)
    testing.AssertEqStr(hex_of(out, 20), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    crypto.HmacSha384Bytes(key, data, out)
    testing.AssertEqStr(hex_of(out, 48), "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
    crypto.HmacSha512Bytes(key, data, out)
    testing.AssertEqStr(hex_of(out, 64), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
end

func test_bcrypt_salt():
    salt := mem.AllocateZeroed(16 as u64)
    defer mem.Free(salt)
    a := crypto.BcryptHashWithSalt("secret", 4, salt)
    b := crypto.BcryptHashWithSalt("secret", 4, salt)
    testing.AssertEqStr(a, b)
    testing.AssertEqInt(a.len(), 60)
    testing.AssertEqStr(a.substr(0, 7), "$2y$04$")
    testing.AssertEqStr(a.substr(7, 22), "......................")
    testing.AssertTrue(crypto.BcryptVerify("secret", a))
    testing.AssertFalse(crypto.BcryptVerify("other", a))
    testing.AssertEqInt(crypto.BcryptCost(a), 4)
end

func test_random_and_hash():
    buf := mem.AllocateZeroed(32 as u64)
    defer mem.Free(buf)
    other := mem.AllocateZeroed(32 as u64)
    defer mem.Free(other)
    crypto.RandomBytes(buf, 32)
    crypto.RandomBytes(other, 32)
    testing.AssertNeStr(hex_of(buf, 32), hex_of(other, 32))
    zero := mem.AllocateZeroed(32 as u64)
    defer mem.Free(zero)
    testing.AssertNeStr(hex_of(buf, 32), hex_of(zero, 32))
    testing.AssertTrue(crypto.HashBytes("abc" as void*, 3 as u64) == crypto.HashBytes("abc" as void*, 3 as u64))
    testing.AssertTrue(crypto.HashBytes("abc" as void*, 3 as u64) != crypto.HashBytes("abe" as void*, 3 as u64))
end

func main:
    test_digests()
    test_streaming()
    test_hmac()
    test_bcrypt_salt()
    test_random_and_hash()
    testing.Summary()
    ret 0
end
