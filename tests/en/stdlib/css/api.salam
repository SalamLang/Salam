import gui.css
import str
import mem

func media(cond: str, env: css.Env):
    println "media", cond, css.MediaMatches(cond, env)
end

func main:
    ua := css.DefaultCss()
    println "default style sheet has h1 rule", str.Contains(ua, "h1 { font-size: 2em")
    println "tags", css.TagOf("paragraph"), css.TagOf("box"), css.TagOf("item"), css.TagOf("text area"), css.TagOf("page"), css.TagOf("h3")
    mut sheet := css.EmptySheet()
    defer sheet.Free()
    println "empty", sheet.RuleCount()
    println "defaults", sheet.AddDefaults() > 50, sheet.RuleCount() > 100
    mut els := Vector {} as Vector<css.Element>
    els.push(css.NewElement("page", -1))
    mut a := css.NewElement("link", 0)
    a.AddAttr("href", "/home")
    println "attr", a.HasAttr("href"), a.HasAttr("title")
    els.push(a)
    mut b := css.NewElement("link", 0)
    b.AddAttr("href", "/about")
    els.push(b)
    mut c := css.NewElement("paragraph", 0)
    c.base = "color: red"
    els.push(c)
    println "before compute", sheet.Count(), sheet.StyleId(0)
    _n := sheet.Compute(els, css.Env {})
    println "elements", sheet.Count(), "same style for both links", sheet.StyleId(1) == sheet.StyleId(2), "paragraph differs", sheet.StyleId(3) != sheet.StyleId(1)
    println "cascades", sheet.CascadeCount(), "distinct", sheet.DistinctStyles()
    narrow := css.Env { width = 500.0, height = 800.0, dark = true, reduced_motion = true }
    wide := css.Env { width = 1280.0, height = 720.0 }
    media("(max-width: 600px)", narrow)
    media("(max-width: 600px)", wide)
    media("(min-width: 600px) and (orientation: landscape)", wide)
    media("screen and (prefers-color-scheme: dark)", narrow)
    media("not print", wide)
    media("print", wide)
    media("(400px <= width <= 700px)", narrow)
    media("(width > 1000px), (prefers-reduced-motion: reduce)", narrow)
    media("(hover: hover) and (pointer: fine)", wide)
    media("(min-aspect-ratio: 16/9)", wide)
    media("(max-width: 40em)", narrow)
    repeat els.Len() in i:
        mut x := els.ref(i)
        x.Free()
    end
    els.free()
    mem.Free(ua as void*)
end
