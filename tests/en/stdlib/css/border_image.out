typed border-image: linear-gradient(to right, #0a0, oklch(70% 0.1 200)) 30 fill / 12px / 4px repeat
    border-image-source = linear-gradient(90deg, rgb(0, 170, 0), rgb(64, 177, 183))
    border-image-slice = 30 fill
    border-image-width = 12px
    border-image-outset = 4px
    border-image-repeat = repeat
    slice kinds true false fill true stops 2
typed border-image-slice: 20%; border-image-width: 3; border-image-outset: calc(2px + 1px)
