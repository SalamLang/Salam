color: red
    border-image-source = none
    border-image-slice = 100%
    border-image-width = 1
    border-image-outset = 0
    border-image-repeat = stretch
border-image: linear-gradient(red, blue) 1
    border-image-source = linear-gradient(180deg, rgb(255, 0, 0), rgb(0, 0, 255))
    border-image-slice = 1
    border-image-width = 1
    border-image-outset = 0
    border-image-repeat = stretch
border-image: url(frame.png) 30 fill / 10px / 4px round space
    border-image-source = url("frame.png")
    border-image-slice = 30 fill
    border-image-width = 10px
    border-image-outset = 4px
    border-image-repeat = round space
border-image: repeat linear-gradient(45deg, #000, #fc0) 25% 10 / auto 2 3em
    border-image-source = linear-gradient(45deg, rgb(0, 0, 0), rgb(255, 204, 0))
    border-image-slice = 25% 10
    border-image-width = auto 2 48px
    border-image-outset = 0
    border-image-repeat = repeat
border-image: radial-gradient(#fff, #000) 10 / / 2
    border-image-source = radial-gradient(rgb(255, 255, 255), rgb(0, 0, 0))
    border-image-slice = 10
    border-image-width = 1
    border-image-outset = 2
    border-image-repeat = stretch
border-image-source: none; border-image-slice: fill 1 2; border-image-width: 1px 2 30% auto; border-image-outset: 1 2px; border-image-repeat: round
    border-image-source = none
    border-image-slice = 1 2 fill
    border-image-width = 1px 2 30% auto
    border-image-outset = 1 2px
    border-image-repeat = round
