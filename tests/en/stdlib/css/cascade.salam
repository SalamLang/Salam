import gui.css

func add(els &: Vector<css.Element>, kind: str, parent: int, base: str): int:
    mut e := css.NewElement(kind, parent)
    e.base = base
    els.Push(e)
    ret els.Len() - 1
end

func free_all(els &: Vector<css.Element>):
    repeat els.Len() in i:
        mut x := els.Ref(i)
        x.Free()
    end
    els.Free()
end

func box(label: str, cs: css.ComputedStyle):
    println label, "display", cs.display, "margin", css.LenText(cs.margin_top), css.LenText(cs.margin_right), css.LenText(cs.margin_bottom), css.LenText(cs.margin_left), "padding", css.LenText(cs.padding_top), css.LenText(cs.padding_left)
end

func text(label: str, cs: css.ComputedStyle):
    println label, "font", cs.font_size, cs.font_weight, cs.font_style, cs.font_family, "color", css.ColorText(cs.color), "line", cs.line_height
end

func main:
    mut sheet := css.NewSheet()
    defer sheet.Free()
    mut els := Vector {} as Vector<css.Element>
    body := add(els, "page", -1, "")
    h1 := add(els, "h1", body, "")
    sec := add(els, "section", body, "")
    h1s := add(els, "h1", sec, "")
    p := add(els, "paragraph", body, "")
    b := add(els, "bold", p, "")
    code := add(els, "code", p, "")
    ul := add(els, "list", body, "")
    li := add(els, "item", ul, "")
    ul2 := add(els, "list", li, "")
    link := add(els, "link", body, "")
    mut le := els.Ref(link)
    le.AddAttr("href", "/x")
    btn := add(els, "button", body, "")
    inp := add(els, "input", body, "")
    hr := add(els, "line", body, "")
    small := add(els, "small", p, "")
    sub := add(els, "subscript", p, "")
    table := add(els, "table", body, "")
    td := add(els, "cell", table, "")
    mark := add(els, "mark", p, "")
    pre := add(els, "preformatted", body, "")
    bq := add(els, "block quote", body, "")
    _n := sheet.Compute(els, css.Env {})
    box("body", sheet.Style(body))
    box("h1", sheet.Style(h1))
    text("h1", sheet.Style(h1))
    text("section h1", sheet.Style(h1s))
    box("section h1", sheet.Style(h1s))
    box("p", sheet.Style(p))
    text("b", sheet.Style(b))
    text("code", sheet.Style(code))
    box("ul", sheet.Style(ul))
    box("nested ul", sheet.Style(ul2))
    println "list types", sheet.Style(ul).list_style_type, sheet.Style(ul2).list_style_type, "li", sheet.Style(li).display
    a := sheet.Style(link)
    println "link", css.ColorText(a.color), a.underline, a.cursor
    bt := sheet.Style(btn)
    println "button", bt.display, bt.font_size, bt.font_family, css.LenText(bt.padding_left), bt.border_top.width, bt.border_top.style, css.ColorText(bt.border_top.color), css.ColorText(bt.background_color), bt.text_align, bt.appearance
    it := sheet.Style(inp)
    println "input", css.LenText(it.padding_top), css.LenText(it.padding_left), it.border_left.width, it.border_left.style, css.ColorText(it.background_color), it.cursor
    h := sheet.Style(hr)
    println "hr", css.LenText(h.margin_top), css.LenText(h.margin_left), h.border_top.width, h.border_top.style, css.ColorText(h.border_top.color), h.overflow_x
    println "small", sheet.Style(small).font_size, "sub", sheet.Style(sub).font_size, sheet.Style(sub).vertical_align
    t := sheet.Style(table)
    println "table", t.display, t.border_spacing_x, t.box_sizing, "td", sheet.Style(td).display, css.LenText(sheet.Style(td).padding_top)
    println "mark", css.ColorText(sheet.Style(mark).background_color), "pre", sheet.Style(pre).white_space, sheet.Style(pre).font_size
    box("blockquote", sheet.Style(bq))
    free_all(els)

    mut s2 := css.NewSheet()
    defer s2.Free()
    _r1 := s2.AddRule("p", "color: green; margin: 2px")
    _r2 := s2.AddRule(".note", "color: blue")
    _r3 := s2.AddRule("#first", "color: purple")
    _r4 := s2.AddRule("p", "color: orange !important")
    _r5 := s2.AddRule("div p", "font-size: 30px")
    _r6 := s2.AddRule(".warn", "border: 1px solid; padding: inherit; margin: initial; color: unset")
    _r7 := s2.AddMediaRule("(max-width: 600px)", ".resp", "width: 100px")
    _r8 := s2.AddMediaRule("(prefers-color-scheme: dark)", ".resp", "background-color: black")
    _r9 := s2.AddCss("@media (orientation: portrait) { .resp { height: 50px } } .x:hover .y { color: red }")
    mut e2 := Vector {} as Vector<css.Element>
    root := add(e2, "page", -1, "color: #123456; font-size: 18px; line-height: 1.5; padding: 7px")
    div := add(e2, "box", root, "letter-spacing: 1px")
    mut de := e2.Ref(div)
    de.classes = "x"
    p1 := add(e2, "paragraph", div, "")
    mut pe := e2.Ref(p1)
    pe.id = "first"
    pe.classes = "note"
    w := add(e2, "box", root, "padding: 3px")
    mut we := e2.Ref(w)
    we.classes = "warn"
    resp := add(e2, "box", root, "width: 300px; color: maroon")
    mut re := e2.Ref(resp)
    re.classes = "resp"
    re.hover = "color: navy"
    re.focus = "outline: 2px solid red"
    re.AddMedia("(min-width: 900px)", "width: 500px")
    y := add(e2, "span", div, "")
    mut ye := e2.Ref(y)
    ye.classes = "y"
    rtl := add(e2, "box", root, "direction: rtl; margin-inline-start: 10px; padding-inline-end: 4px; border-start-start-radius: 6px; text-align: end")
    child := add(e2, "box", rtl, "")
    flex := add(e2, "box", root, "display: flex")
    item := add(e2, "span", flex, "")
    abs := add(e2, "span", root, "position: absolute; float: left")
    lone := add(e2, "box", root, "border-width: 5px; outline-width: 3px")
    _n2 := s2.Compute(e2, css.Env { width = 1000.0, height = 800.0 })
    pp := s2.Style(p1)
    println "important wins", css.ColorText(pp.color), "descendant", pp.font_size, "inherited spacing", pp.letter_spacing, "line", pp.line_height
    ws := s2.Style(w)
    println "keywords", css.LenText(ws.padding_top), css.LenText(ws.margin_top), css.ColorText(ws.color), ws.border_top.width, css.ColorText(ws.border_top.color)
    rs := s2.Style(resp)
    println "media", css.LenText(rs.width), css.LenText(rs.height), css.ColorText(rs.background_color), css.ColorText(rs.color)
    println "rtl", s2.Style(rtl).direction, css.LenText(s2.Style(rtl).margin_right), css.LenText(s2.Style(rtl).margin_left), css.LenText(s2.Style(rtl).padding_left), css.LenText(s2.Style(rtl).radius_top_right.h), s2.Style(rtl).text_align, "child inherits", s2.Style(child).direction, s2.Style(child).text_align
    println "blockify", s2.Style(item).display, s2.Style(abs).display, s2.Style(abs).float_mode
    println "no style no width", s2.Style(lone).border_top.width, s2.Style(lone).outline.width
    mut re2 := e2.Ref(resp)
    re2.hovered = true
    println "restyled", s2.Restyle(e2, resp), css.ColorText(s2.Style(resp).color)
    mut re3 := e2.Ref(resp)
    re3.focused = true
    println "restyled", s2.Restyle(e2, resp), s2.Style(resp).outline.width, s2.Style(resp).outline.style
    println "before hover y", css.ColorText(s2.Style(y).color)
    top := css.HoverChain(e2, y)
    println "chain top", top, "restyled", s2.Restyle(e2, top), "y", css.ColorText(s2.Style(y).color), "resp", css.ColorText(s2.Style(resp).color)
    _n3 := s2.Compute(e2, css.Env { width = 500.0, height = 800.0, dark = true })
    rs2 := s2.Style(resp)
    println "narrow dark", css.LenText(rs2.width), css.LenText(rs2.height), css.ColorText(rs2.background_color)
    free_all(e2)

    mut s3 := css.EmptySheet()
    defer s3.Free()
    _c := s3.AddCss(":root { --brand: #0ea5e9; --space: 8px } .card { --space: 12px; padding: var(--space); color: var(--brand) } html { color-scheme: light dark }")
    mut e3 := Vector {} as Vector<css.Element>
    r3 := add(e3, "page", -1, "background-color: canvas; color: canvastext")
    card := add(e3, "box", r3, "")
    mut ce := e3.Ref(card)
    ce.classes = "card"
    inner := add(e3, "box", card, "margin: var(--space)")
    _n4 := s3.Compute(e3, css.Env {})
    println "vars", css.LenText(s3.Style(card).padding_top), css.ColorText(s3.Style(card).color), css.LenText(s3.Style(inner).margin_top), "var text", s3.Var(inner, "--space")
    println "light", css.ColorText(s3.Style(r3).background_color), css.ColorText(s3.Style(r3).color)
    _n5 := s3.Compute(e3, css.Env { dark = true })
    println "dark", css.ColorText(s3.Style(r3).background_color), css.ColorText(s3.Style(r3).color), s3.Style(r3).used_dark
    root_style := s3.RootStyle()
    println "root", root_style.display, root_style.color_scheme
    free_all(e3)
end
