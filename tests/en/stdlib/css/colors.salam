import gui.css
import mem

func hex_of(text: str): str:
    mut p := css.NewProgram()
    _id := css.CompileDecls(p, "color: " + text)
    src := css.ProgramSource(p, "s", "css")
    k := src.Find("ColorValue(")
    mut r := "unresolved"
    if k >= 0:
        rest := src.Substr(k + 11, src.Len() - k - 11)
        r = rest.Substr(0, rest.Find(")"))
        mem.Free(rest as void*)
    end
    mem.Free(src as void*)
    p.Free()
    ret r
end

func main:
    forms := [
        `#3366aa`,
        `#3366aa80`,
        `#abc`,
        `rebeccapurple`,
        `transparent`,
        `rgb(255 128 0)`,
        `rgb(255 128 0 / 50%)`,
        `rgba(10, 20, 30, 0.4)`,
        `rgb(100%, 50%, 0%)`,
        `rgb(300 -20 128.6)`,
        `rgb(none 128 255)`,
        `hsl(210 50% 40%)`,
        `hsl(210deg 50% 40% / 0.5)`,
        `hsla(120, 100%, 25%, 0.75)`,
        `hsl(0.5turn 60 70)`,
        `hsl(-30 80% 60%)`,
        `hsl(200 0% 50%)`,
        `hsl(30 150% 50%)`,
        `hwb(210 20% 30%)`,
        `hwb(90 60% 60%)`,
        `hwb(320deg 10% 5% / 80%)`,
        `lab(50 20 -30)`,
        `lab(75% 40% -20%)`,
        `lab(90 -60 80)`,
        `lab(0 0 0)`,
        `lab(100 0 0)`,
        `lch(60 40 120)`,
        `lch(50% 50% 270deg)`,
        `lch(70 100 30)`,
        `oklab(0.6 0.1 -0.1)`,
        `oklab(70% 20% -30%)`,
        `oklab(0.9 -0.15 0.15)`,
        `oklch(0.7 0.1 30)`,
        `oklch(60% 0.15 250)`,
        `oklch(0.8 0.3 140)`,
        `oklch(0.5 0.4 30)`,
        `oklch(1 0 0)`,
        `color(srgb 0.2 0.4 0.6)`,
        `color(srgb 50% 25% 75% / 0.5)`,
        `color(srgb-linear 0.2 0.4 0.6)`,
        `color(display-p3 0.3 0.6 0.4)`,
        `color(display-p3 1 0 0)`,
        `color(a98-rgb 0.5 0.3 0.8)`,
        `color(prophoto-rgb 0.4 0.4 0.5)`,
        `color(rec2020 0.3 0.5 0.4)`,
        `color(xyz 0.2 0.3 0.4)`,
        `color(xyz-d50 0.2 0.3 0.4)`,
        `color(xyz-d65 0.4 0.3 0.2)`,
        `color-mix(in srgb, red, blue)`,
        `color-mix(in srgb, red 30%, blue)`,
        `color-mix(in srgb-linear, red, blue)`,
        `color-mix(in oklab, red, blue)`,
        `color-mix(in oklch, red, blue)`,
        `color-mix(in oklch longer hue, red, blue)`,
        `color-mix(in oklch increasing hue, red 40%, blue)`,
        `color-mix(in oklch decreasing hue, red, blue)`,
        `color-mix(in lab, #3366aa, white 25%)`,
        `color-mix(in lch, gold, teal)`,
        `color-mix(in hsl, red, lime)`,
        `color-mix(in hwb, red 20%, blue 40%)`,
        `color-mix(in srgb, red 20%, blue 20%)`,
        `color-mix(in srgb, rgb(255 0 0 / 0.2), blue)`,
        `color-mix(in oklab, transparent, red)`,
        `color-mix(in xyz, purple, orange)`,
        `color-mix(in display-p3, red, green)`,
        `color-mix(in srgb, color-mix(in oklch, red, yellow), blue 70%)`,
        `rgb(from #3366aa r g b / 50%)`,
        `rgb(from red b g r)`,
        `hsl(from teal h s 80)`,
        `oklch(from #ff8800 l c 200)`,
        `lab(from navy 60 a b)`,
        `color(from red srgb r g 0.5)`,
        `light-dark(#111, #eee)`,
        `rgb(from red r g calc(b * 2) / alpha)`,
        `hsl(from #3366aa calc(h + 180) s l)`,
        `oklch(from blue calc(l * 1.2) c h)`,
        `rgb(from rebeccapurple calc(r + 50) g b / calc(alpha / 2))`,
        `lab(from #3366aa calc(l + 10) a b)`
    ]
    repeat len(forms) in i:
        mut c := css.Color {}
        ok := css.ParseColor(forms[i], c)
        println forms[i], ok, c.r, c.g, c.b, c.a, hex_of(forms[i])
    end
    println "scheme pair", hex_of("light-dark(CanvasText, Canvas)"), hex_of("ButtonFace"), hex_of("Highlight")
    println "current color stays", hex_of("currentColor"), hex_of("color-mix(in srgb, currentColor, red)")
    println "mix", css.ColorText(css.MixColors(css.Color { r = 255, a = 0 }, css.Color { b = 255 }, 0.5))
end
