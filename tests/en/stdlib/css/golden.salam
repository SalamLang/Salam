import gui.css
import str

const PAGE_CSS := `
body { font-family: Vazirmatn, sans-serif; background: #f8fafc; color: #0f172a;  }
* { box-sizing: border-box;  }
.card p:first-child, nav > a:hover { color: #334155; margin: 0px 0px 8px;  }
li:nth-child(2n) { background: #f1f5f9;  }
button:focus-visible { outline: 3px solid var(--brand, #2563eb); outline-offset: 2px;  }
.e { background: linear-gradient(90deg, #0ea5e9, #6366f1); color: white; padding: 16px 24px;  }
.f { font-size: 2rem; letter-spacing: -0.02em;  }
.g { padding: 4px 8px; border-radius: 999px;  }
.card { display: flex; flex-wrap: wrap; gap: 12px 1em; padding: var(--space, 12px); border: 1px solid #e2e8f0; border-radius: 12px / 8px; box-shadow: 0 1px 2px rgba(0, 0, 0, .1), inset 0 0 0 1px #fff;  }
@media (max-width: 600px) { .card { display: block; padding: 8px;  } }
.i { line-height: 1.5; text-transform: uppercase;  }
.j { background: hsl(210 80% 50%); color: white; border: none; padding: 6px 12px; transition: background 200ms ease-in-out, transform 0.1s; cursor: pointer; transform: translateY(-1px) scale(1.02);  }
.j:hover { background: #1d4ed8;  }
.k { width: calc(100% - 2em); font-size: 14px;  }
.l { direction: rtl; text-align: start; margin-inline-start: 20px; padding-inline-end: 6px; border-inline-start: 4px solid var(--brand, #2563eb);  }
.m { font-weight: bold;  }
.n { padding: 4px;  }
.o { text-align: right;  }
.p { font: italic 600 14px/20px Georgia, serif; opacity: 0.8; text-decoration: underline dotted;  }
`

const PROPS := "display margin-top margin-right margin-bottom margin-left padding-top padding-right padding-bottom padding-left border-top-width border-top-style border-top-color border-left-width border-left-color border-top-left-radius color background-color background-image font-size font-weight font-style font-family line-height letter-spacing text-align text-transform text-decoration-line direction box-shadow transform transition-property transition-duration row-gap column-gap flex-wrap opacity cursor list-style-type white-space box-sizing vertical-align width"

struct Node:
    pub kind: str = ""
    pub tag: str = ""
    pub parent: int = -1
    pub classes: str = ""
    pub id: str = ""
    pub base: str = ""
    pub hover: str = ""
end

func node(nodes &: Vector<Node>, kind: str, tag: str, parent: int, classes: str, base: str): int:
    nodes.Push(Node { kind = kind, tag = tag, parent = parent, classes = classes, base = base })
    ret nodes.Len() - 1
end

func page(nodes &: Vector<Node>):
    body := node(nodes, "page", "body", -1, "", "font-family: Vazirmatn, sans-serif; background: #f8fafc; color: #0f172a")
    header := node(nodes, "header", "header", body, "e", "background: linear-gradient(90deg, #0ea5e9, #6366f1); color: white; padding: 16px 24px")
    _h := node(nodes, "heading", "h1", header, "f", "font-size: 2rem; letter-spacing: -0.02em")
    nav := node(nodes, "nav", "nav", header, "", "")
    _a1 := node(nodes, "link", "a", nav, "", "")
    _a2 := node(nodes, "link", "a", nav, "g", "padding: 4px 8px; border-radius: 999px")
    card := node(nodes, "box", "div", body, "card", "display: flex; flex-wrap: wrap; gap: 12px 1em; padding: var(--space, 12px); border: 1px solid #e2e8f0; border-radius: 12px / 8px; box-shadow: 0 1px 2px rgba(0, 0, 0, .1), inset 0 0 0 1px #fff")
    _p := node(nodes, "paragraph", "p", card, "i", "line-height: 1.5; text-transform: uppercase")
    btn := node(nodes, "button", "button", card, "j", "background: hsl(210 80% 50%); color: white; border: none; padding: 6px 12px; transition: background 200ms ease-in-out, transform 0.1s; cursor: pointer; transform: translateY(-1px) scale(1.02)")
    mut bn := nodes.Ref(btn)
    bn.hover = "background: #1d4ed8"
    _in := node(nodes, "input", "input", card, "k", "width: calc(100% - 2em); font-size: 14px")
    ul := node(nodes, "list", "ul", card, "", "")
    repeat 3:
        _li := node(nodes, "item", "li", ul, "", "")
    end
    rtl := node(nodes, "box", "div", card, "l", "direction: rtl; text-align: start; margin-inline-start: 20px; padding-inline-end: 6px; border-inline-start: 4px solid var(--brand, #2563eb)")
    _sp := node(nodes, "span", "span", rtl, "m", "font-weight: bold")
    _pre := node(nodes, "preformatted", "pre", card, "", "")
    table := node(nodes, "table", "table", card, "", "")
    tbody := node(nodes, "table body", "tbody", table, "", "")
    tr := node(nodes, "row", "tr", tbody, "", "")
    _td1 := node(nodes, "cell", "td", tr, "n", "padding: 4px")
    _td2 := node(nodes, "cell", "td", tr, "o", "text-align: right")
    footer := node(nodes, "footer", "footer", body, "p", "font: italic 600 14px/20px Georgia, serif; opacity: 0.8; text-decoration: underline dotted")
    _fp := node(nodes, "paragraph", "p", footer, "", "")
end

func elements(nodes: Vector<Node>, with_decls: bool): Vector<css.Element>:
    mut els := Vector {} as Vector<css.Element>
    repeat nodes.Len() in i:
        n := nodes[i]
        mut e := css.NewElement(n.kind, n.parent)
        e.tag = n.tag
        e.classes = n.classes
        if n.classes == "card":
            e.id = "main"
            if with_decls:
                e.AddMedia("(max-width: 600px)", "display: block; padding: 8px")
            end
        end
        if n.tag == "a":
            e.AddAttr("href", "/a")
        end
        if n.tag == "input":
            e.AddAttr("type", "text")
            e.AddAttr("placeholder", "Name")
        end
        if with_decls:
            if n.tag != "body":
                e.classes = n.classes == "card" ? "card" : ""
            end
            e.base = n.base
            e.hover = n.hover
        end
        els.Push(e)
    end
    ret els
end

func free_els(els &: Vector<css.Element>):
    repeat els.Len() in i:
        mut x := els.Ref(i)
        x.Free()
    end
    els.Free()
end

func dump(sheet &: css.Sheet, els: Vector<css.Element>, props: Vector<str>):
    repeat els.Len() in i:
        cs := sheet.Style(i)
        e := els[i]
        println "#" + i, e.tag + (e.classes.Len() > 0 ? "." + e.classes : "")
        repeat props.Len() in k:
            v := css.ValueText(cs, props[k])
            println "  " + props[k] + "=" + v
        end
    end
end

func mismatches(a &: css.Sheet, b &: css.Sheet, n: int, props: Vector<str>): int:
    mut bad := 0
    repeat n in i:
        ca := a.Style(i)
        cb := b.Style(i)
        repeat props.Len() in k:
            va := css.ValueText(ca, props[k])
            vb := css.ValueText(cb, props[k])
            if va != vb:
                println "mismatch", i, props[k], va, vb
                bad++
            end
        end
    end
    ret bad
end

func main:
    mut props := str.Fields(PROPS)
    defer props.Free()
    mut nodes := Vector {} as Vector<Node>
    defer nodes.Free()
    page(nodes)
    mut a := css.NewSheet()
    defer a.Free()
    println "rules", a.AddCss(PAGE_CSS)
    mut ea := elements(nodes, false)
    _na := a.Compute(ea, css.Env { width = 800.0, height = 600.0 })
    println "== style sheet mode, 800 wide"
    dump(a, ea, props)
    mut b := css.NewSheet()
    defer b.Free()
    _g1 := b.AddRule("*", "box-sizing: border-box")
    _g2 := b.AddRule(".card p:first-child, nav > a:hover", "color: #334155; margin: 0px 0px 8px")
    _g3 := b.AddRule("li:nth-child(2n)", "background: #f1f5f9")
    _g4 := b.AddRule("button:focus-visible", "outline: 3px solid var(--brand, #2563eb); outline-offset: 2px")
    mut eb := elements(nodes, true)
    _nb := b.Compute(eb, css.Env { width = 800.0, height = 600.0 })
    println "== declaration mode agrees:", mismatches(a, b, ea.Len(), props) == 0
    _na2 := a.Compute(ea, css.Env { width = 500.0, height = 600.0 })
    _nb2 := b.Compute(eb, css.Env { width = 500.0, height = 600.0 })
    println "== 500 wide, modes agree:", mismatches(a, b, ea.Len(), props) == 0
    card := a.Style(6)
    println "card", css.ValueText(card, "display"), css.ValueText(card, "padding-top"), "p", css.ValueText(a.Style(7), "display")
    mut hb := eb.Ref(8)
    hb.hovered = true
    mut ha := ea.Ref(8)
    ha.hovered = true
    println "hover restyle", a.Restyle(ea, 8), b.Restyle(eb, 8), css.ValueText(a.Style(8), "background-color"), css.ValueText(b.Style(8), "background-color")
    mut fa := ea.Ref(8)
    fa.focus_visible = true
    _r := a.Restyle(ea, 8)
    println "focus ring", css.ValueText(a.Style(8), "outline-style"), css.ValueText(a.Style(8), "outline-width"), css.ValueText(a.Style(8), "outline-color"), css.ValueText(a.Style(8), "outline-offset")
    println "distinct styles", a.DistinctStyles(), "for", ea.Len(), "elements"
    free_els(ea)
    free_els(eb)
end
