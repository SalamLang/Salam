import gui.css
import math
import mem

func mix(a: str, b: str):
    mut ca := css.Color {}
    mut cb := css.Color {}
    _x := css.ParseColor(a, ca)
    _y := css.ParseColor(b, cb)
    println a, "->", b, "legacy", ca.legacy, cb.legacy
    each f in [0.25, 0.5, 0.75]:
        m := css.MixColors(ca, cb, f)
        t := css.ColorText(m)
        println "   ", f, t, m.legacy
        mem.Free(t as void*)
    end
end

func stops(image: str, length: f64, every: int):
    mut sheet := css.NewSheet()
    mut els := Vector {} as Vector<css.Element>
    mut e := css.NewElement("box", -1)
    e.base = "background-image: " + image
    els.push(e)
    _n := sheet.Compute(els, css.Env { width = 800.0, height = 600.0 })
    cs := sheet.Style(0)
    l := cs.backgrounds[0]
    mut v := css.GradientStops(l, length)
    println image, "length", length, "stops", v.Len(), "space", l.interpolation, "hue", l.hue_interpolation, "explicit", l.interpolation_set
    repeat v.Len() in i:
        if i % every == 0 or i == v.Len() - 1:
            t := css.ColorText(v[i].color)
            println "   ", math.Round(v[i].pos.px * 100.0) / 100.0, t
            mem.Free(t as void*)
        end
    end
    v.Free()
    vt := css.ValueText(cs, "background-image")
    println "   ", vt
    mem.Free(vt as void*)
    repeat els.Len() in i:
        mut x := els.ref(i)
        x.Free()
    end
    els.Free()
    sheet.Free()
end

func main:
    mix("red", "blue")
    mix("oklch(70% 0.15 30)", "oklch(60% 0.12 250)")
    mix("red", "oklab(0.5 0 -0.2)")
    mix("#ff000080", "lab(50% 40 -30)")
    mix("rgb(255 0 0)", "color(srgb 0 0 1)")
    mix("transparent", "oklch(80% 0.1 140)")
    mix("hsl(120 100% 50%)", "hwb(240 0% 0%)")
    stops("linear-gradient(90deg, red, 20%, blue)", 300.0, 1)
    stops("linear-gradient(90deg, red, 80%, blue)", 300.0, 1)
    stops("linear-gradient(90deg, #000 10%, 30%, #fff 90%)", 300.0, 1)
    stops("linear-gradient(90deg, red, 50%, blue)", 300.0, 1)
    stops("linear-gradient(90deg, red, 0%, blue)", 300.0, 1)
    stops("linear-gradient(90deg, red calc(10% + 20px), blue calc(100% - 40px))", 300.0, 1)
    stops("linear-gradient(90deg, red 50px, blue 40px, lime)", 300.0, 1)
    stops("linear-gradient(90deg in oklab, red, blue)", 300.0, 9)
    stops("linear-gradient(90deg, oklch(60% 0.2 30), oklch(70% 0.15 250))", 300.0, 9)
    stops("linear-gradient(90deg in oklch longer hue, red, blue)", 300.0, 9)
    stops("linear-gradient(90deg in oklab, red, 25%, blue calc(50% + 30px), lime)", 300.0, 12)
    stops("conic-gradient(red, 90deg, blue)", 360.0, 1)
end
