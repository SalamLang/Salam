import gui.css

const RULE_CSS := `@media (prefers-color-scheme: dark) { body { background: #111; color: #eee } } ul li:first-child + li { margin-left: 1em } li::marker { color: red }`

func compile(p &: css.Program): int:
    _r1 := css.CompileRule(p, "*", "box-sizing:border-box", "")
    _r2 := css.CompileRule(p, ".card", "padding:12px; border:2px solid #3366aa; border-radius:10px; box-shadow:0 4px 8px rgba(0,0,0,.25); background:#fff", "")
    _r3 := css.CompileRule(p, ".card:hover", "background:#ffeecc", "")
    _r4 := css.CompileRule(p, "h3, .title > b", "margin:0 0 4px; font: italic bold 15px/1.4 Georgia, serif; color: hsl(210 50% 40%)", "")
    _r5 := css.CompileRule(p, ".wide", "width: calc(100% - 2em); --gap: 8px; gap: var(--gap)", "(max-width: 600px)")
    _r6 := css.CompileRule(p, "a:not(.x)", "text-decoration: underline dotted; transition: color .2s ease-in-out", "")
    _r7 := css.CompileRule(p, "p", "color: red !important; transform: rotate(45deg) translate(2px, 3px)", "")
    _r8 := css.CompileRule(p, ".pic", "background-image: url(a.png); font-family: \"My Font\", serif", "")
    _n := css.CompileCss(p, RULE_CSS)
    ret css.CompileDecls(p, "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)")
end

