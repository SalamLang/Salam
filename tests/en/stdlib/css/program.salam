func add(els &: Vector<css.Element>, tag: str, parent: int, classes: str): int:
    mut e := css.NewElement("box", parent)
    e.tag = tag
    e.classes = classes
    els.push(e)
    ret els.len() - 1
end

func free_all(els &: Vector<css.Element>):
    repeat els.len() in i:
        mut x := els.ref(i)
        x.Free()
    end
    els.free()
end

func tree(els &: Vector<css.Element>):
    body := add(els, "body", -1, "")
    card := add(els, "div", body, "card")
    _h3 := add(els, "h3", card, "")
    p := add(els, "p", card, "")
    _a := add(els, "a", p, "")
    ul := add(els, "ul", body, "")
    _li1 := add(els, "li", ul, "")
    _li2 := add(els, "li", ul, "")
    _wide := add(els, "div", body, "wide")
    _plain := add(els, "div", body, "")
end

func show(label: str, a: css.Sheet, b: css.Sheet, n: int):
    props := ["display", "width", "padding-top", "margin-left", "margin-bottom", "border-top", "border-top-left-radius", "box-shadow", "background-color", "background-image", "color", "font-size", "font-family", "font-style", "font-weight", "line-height", "row-gap", "column-gap", "text-decoration-line", "transition-duration", "transform", "box-sizing"]
    mut same := 0
    mut diff := 0
    repeat n in i:
        sa := a.Style(i)
        sb := b.Style(i)
        repeat len(props) in k:
            va := css.ValueText(sa, props[k])
            vb := css.ValueText(sb, props[k])
            if va == vb:
                same++
            else:
                diff++
                println label, "differs", i, props[k], va, "/", vb
            end
        end
    end
    println label, "same", same, "different", diff
end

func main:
    mut p := css.NewProgram()
    base := compile(p)
    src_a := css.ProgramSource(p, "styles", "css")
    println "base list", base, "again", css.CompileDecls(p, "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)")
    println "empty list", css.CompileDecls(p, "  ")
    println "bad rule", css.CompileRule(p, "a[[", "color: red", "")
    _bad := css.CompileDecls(p, "colr: red; width: banana")
    println "errors", css.ProgramErrors(p)
    repeat css.ProgramErrors(p) in i:
        e := css.ProgramError(p, i)
        println " ", e
    end
    mut q := styles()
    src_b := css.ProgramSource(q, "styles", "css")
    println "source round trip", src_a == src_b, src_a.len() > 1000
    fa := css.ProgramSource(css.NewProgram(), "سبک ها", "سی اس اس")
    println "persian empty", fa.len() > 0, fa.includes("برنامه‌سبک"), fa.includes("برنامه سبک تازه")
    mut text_sheet := css.NewSheet()
    _a1 := text_sheet.AddRule("*", "box-sizing:border-box")
    _a2 := text_sheet.AddRule(".card", "padding:12px; border:2px solid #3366aa; border-radius:10px; box-shadow:0 4px 8px rgba(0,0,0,.25); background:#fff")
    _a3 := text_sheet.AddRule(".card:hover", "background:#ffeecc")
    _a4 := text_sheet.AddRule("h3, .title > b", "margin:0 0 4px; font: italic bold 15px/1.4 Georgia, serif; color: hsl(210 50% 40%)")
    _a5 := text_sheet.AddMediaRule("(max-width: 600px)", ".wide", "width: calc(100% - 2em); --gap: 8px; gap: var(--gap)")
    _a6 := text_sheet.AddRule("a:not(.x)", "text-decoration: underline dotted; transition: color .2s ease-in-out")
    _a7 := text_sheet.AddRule("p", "color: red !important; transform: rotate(45deg) translate(2px, 3px)")
    _a8 := text_sheet.AddCss(RULE_CSS)
    mut prog_sheet := css.SheetFromProgram(q)
    mut ea := Vector {} as Vector<css.Element>
    mut eb := Vector {} as Vector<css.Element>
    tree(ea)
    tree(eb)
    mut pa := ea.ref(9)
    pa.base = "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)"
    mut pb := eb.ref(9)
    pb.decl_base = base
    env := css.Env { width = 500.0, dark = true }
    _c1 := text_sheet.Compute(ea, env)
    _c2 := prog_sheet.Compute(eb, env)
    show("start", text_sheet, prog_sheet, ea.len())
    mut ha := ea.ref(1)
    ha.hovered = true
    mut hb := eb.ref(1)
    hb.hovered = true
    _r1 := text_sheet.Restyle(ea, 1)
    _r2 := prog_sheet.Restyle(eb, 1)
    show("hover", text_sheet, prog_sheet, ea.len())
    println "card hover", css.ValueText(prog_sheet.Style(1), "background-color")
    println "wide", css.ValueText(prog_sheet.Style(8), "width"), css.ValueText(prog_sheet.Style(8), "row-gap")
    w1 := css.DynDecl(q, "width", "120px")
    w2 := css.DynDecl(q, "width", "120px")
    println "dyn same id", w1 == w2, "bad", css.DynDecl(q, "width", "banana")
    mut pd := eb.ref(2)
    pd.decl_dyn.push(w1)
    println "synced", prog_sheet.AddProgram(q)
    _c3 := prog_sheet.Compute(eb, env)
    println "dyn width", css.ValueText(prog_sheet.Style(2), "width")
    free_all(ea)
    free_all(eb)
    text_sheet.Free()
    prog_sheet.Free()
    q.Free()
    p.Free()
end
