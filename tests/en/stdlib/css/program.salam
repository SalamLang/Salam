import gui.css

const RULE_CSS := `@media (prefers-color-scheme: dark) { body { background: #111; color: #eee } } ul li:first-child + li { margin-left: 1em } li::marker { color: red }`

func compile(p &: css.Program): int:
    _r1 := css.CompileRule(p, "*", "box-sizing:border-box", "")
    _r2 := css.CompileRule(p, ".card", "padding:12px; border:2px solid #3366aa; border-radius:10px; box-shadow:0 4px 8px rgba(0,0,0,.25); background:#fff", "")
    _r3 := css.CompileRule(p, ".card:hover", "background:#ffeecc", "")
    _r4 := css.CompileRule(p, "h3, .title > b", "margin:0 0 4px; font: italic bold 15px/1.4 Georgia, serif; color: hsl(210 50% 40%)", "")
    _r5 := css.CompileRule(p, ".wide", "width: calc(100% - 2em); --gap: 8px; gap: var(--gap)", "(max-width: 600px)")
    _r6 := css.CompileRule(p, "a:not(.x)", "text-decoration: underline dotted; transition: color .2s ease-in-out", "")
    _r7 := css.CompileRule(p, "p", "color: red !important; transform: rotate(45deg) translate(2px, 3px)", "")
    _n := css.CompileCss(p, RULE_CSS)
    ret css.CompileDecls(p, "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)")
end

func styles(): css.Program:
    mut p := css.NewProgram()
    p.AddMedia(-1, [css.Fn(""), css.Kw("max-width"), css.Delim(58, false), css.Dim(600.0, "px"), css.Close()])
    p.AddMedia(-1, [css.Fn(""), css.Kw("prefers-color-scheme"), css.Delim(58, false), css.Kw("dark"), css.Close()])
    p.AddSimple(3, "card", "", 0, 0, 0, false)
    p.AddSimple(3, "card", "", 0, 0, 0, false)
    p.AddSimple(5, "", "", 0, 1, 0, false)
    p.AddSimple(1, "h3", "", 0, 0, 0, false)
    p.AddSimple(3, "title", "", 0, 0, 0, false)
    p.AddSimple(1, "b", "", 0, 0, 0, false)
    p.AddSimple(3, "wide", "", 0, 0, 0, false)
    p.AddSimple(3, "x", "", 0, 0, 0, false)
    p.AddSimple(1, "a", "", 0, 0, 0, false)
    p.AddSimple(7, "", "", 0, 6, 1, false)
    p.AddSimple(1, "p", "", 0, 0, 0, false)
    p.AddSimple(1, "body", "", 0, 0, 0, false)
    p.AddSimple(1, "ul", "", 0, 0, 0, false)
    p.AddSimple(1, "li", "", 0, 0, 0, false)
    p.AddSimple(5, "", "", 0, 5, 0, false)
    p.AddSimple(1, "li", "", 0, 0, 0, false)
    p.AddCompound(0, 0, 0)
    p.AddCompound(0, 1, 0)
    p.AddCompound(1, 2, 0)
    p.AddCompound(3, 1, 0)
    p.AddCompound(4, 1, 0)
    p.AddCompound(5, 1, 2)
    p.AddCompound(6, 1, 0)
    p.AddCompound(7, 1, 0)
    p.AddCompound(8, 2, 0)
    p.AddCompound(10, 1, 0)
    p.AddCompound(11, 1, 0)
    p.AddCompound(12, 1, 0)
    p.AddCompound(13, 2, 1)
    p.AddCompound(15, 1, 3)
    p.AddSelector(0, 1, 0, false, false)
    p.AddSelector(1, 1, 1000, false, false)
    p.AddSelector(2, 1, 2000, false, false)
    p.AddSelector(3, 1, 1, false, false)
    p.AddSelector(4, 2, 1001, false, false)
    p.AddSelector(6, 1, 1000, false, false)
    p.AddSelector(7, 1, 1000, false, false)
    p.AddSelector(8, 1, 1001, false, false)
    p.AddSelector(9, 1, 1, false, false)
    p.AddSelector(10, 1, 1, false, false)
    p.AddSelector(11, 3, 1003, false, true)
    p.AddDecl("box-sizing", false, [css.Kw("border-box")])
    p.EndList(1)
    p.AddDecl("padding-top", false, [css.Dim(12.0, "px")])
    p.AddDecl("padding-right", false, [css.Dim(12.0, "px")])
    p.AddDecl("padding-bottom", false, [css.Dim(12.0, "px")])
    p.AddDecl("padding-left", false, [css.Dim(12.0, "px")])
    p.AddDecl("border-top-width", false, [css.Dim(2.0, "px")])
    p.AddDecl("border-right-width", false, [css.Dim(2.0, "px")])
    p.AddDecl("border-bottom-width", false, [css.Dim(2.0, "px")])
    p.AddDecl("border-left-width", false, [css.Dim(2.0, "px")])
    p.AddDecl("border-top-style", false, [css.Kw("solid")])
    p.AddDecl("border-right-style", false, [css.Kw("solid")])
    p.AddDecl("border-bottom-style", false, [css.Kw("solid")])
    p.AddDecl("border-left-style", false, [css.Kw("solid")])
    p.AddDecl("border-top-color", false, [css.Hash("3366aa")])
    p.AddDecl("border-right-color", false, [css.Hash("3366aa")])
    p.AddDecl("border-bottom-color", false, [css.Hash("3366aa")])
    p.AddDecl("border-left-color", false, [css.Hash("3366aa")])
    p.AddDecl("border-top-left-radius", false, [css.Dim(10.0, "px"), css.Dim(10.0, "px")])
    p.AddDecl("border-top-right-radius", false, [css.Dim(10.0, "px"), css.Dim(10.0, "px")])
    p.AddDecl("border-bottom-right-radius", false, [css.Dim(10.0, "px"), css.Dim(10.0, "px")])
    p.AddDecl("border-bottom-left-radius", false, [css.Dim(10.0, "px"), css.Dim(10.0, "px")])
    p.AddDecl("box-shadow", false, [css.Int(0.0), css.Dim(4.0, "px"), css.Dim(8.0, "px"), css.Fn("rgba"), css.Int(0.0), css.Comma(), css.Int(0.0), css.Comma(), css.Int(0.0), css.Comma(), css.Num(0.25), css.Close()])
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("fff")])
    p.EndList(30)
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("ffeecc")])
    p.EndList(9)
    p.AddDecl("margin-top", false, [css.Int(0.0)])
    p.AddDecl("margin-right", false, [css.Int(0.0)])
    p.AddDecl("margin-bottom", false, [css.Dim(4.0, "px")])
    p.AddDecl("margin-left", false, [css.Int(0.0)])
    p.AddDecl("font-style", false, [css.Kw("italic")])
    p.AddDecl("font-variant-caps", false, [css.Kw("normal")])
    p.AddDecl("font-weight", false, [css.Kw("bold")])
    p.AddDecl("font-stretch", false, [css.Kw("normal")])
    p.AddDecl("font-size", false, [css.Dim(15.0, "px")])
    p.AddDecl("line-height", false, [css.Num(1.4)])
    p.AddDecl("font-family", false, [css.KwAs("georgia", "Georgia"), css.Comma(), css.Kw("serif")])
    p.AddDecl("color", false, [css.Fn("hsl"), css.Int(210.0), css.Pct(50.0), css.Pct(40.0), css.Close()])
    p.EndList(12)
    p.AddDecl("width", false, [css.Fn("calc"), css.Pct(100.0), css.Delim(45, true), css.Dim(2.0, "em"), css.Close()])
    p.AddVarDecl("--gap", "8px", false)
    p.AddVarDecl("gap", "var(--gap)", false)
    p.EndList(3)
    p.AddDecl("text-decoration-line", false, [css.Kw("underline")])
    p.AddDecl("text-decoration-style", false, [css.Kw("dotted")])
    p.AddDecl("text-decoration-color", false, [css.Kw("currentcolor")])
    p.AddDecl("text-decoration-thickness", false, [css.Kw("auto")])
    p.AddDecl("transition-property", false, [css.Kw("color")])
    p.AddDecl("transition-duration", false, [css.Dim(0.2, "s")])
    p.AddDecl("transition-timing-function", false, [css.Kw("ease-in-out")])
    p.AddDecl("transition-delay", false, [css.Dim(0.0, "s")])
    p.EndList(8)
    p.AddDecl("color", true, [css.Kw("red")])
    p.AddDecl("transform", false, [css.Fn("rotate"), css.Dim(45.0, "deg"), css.Close(), css.Fn("translate"), css.Dim(2.0, "px"), css.Comma(), css.Dim(3.0, "px"), css.Close()])
    p.EndList(2)
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("111")])
    p.AddDecl("color", false, [css.Hash("eee")])
    p.EndList(10)
    p.AddDecl("margin-left", false, [css.Dim(1.0, "em")])
    p.EndList(1)
    p.AddDecl("display", false, [css.Kw("flex")])
    p.AddDecl("row-gap", false, [css.Dim(12.0, "px")])
    p.AddDecl("column-gap", false, [css.Dim(12.0, "px")])
    p.AddDecl("padding-top", false, [css.Dim(16.0, "px")])
    p.AddDecl("padding-right", false, [css.Dim(16.0, "px")])
    p.AddDecl("padding-bottom", false, [css.Dim(16.0, "px")])
    p.AddDecl("padding-left", false, [css.Dim(16.0, "px")])
    p.AddDecl("background-image", false, [css.Fn("linear-gradient"), css.Kw("to"), css.Kw("right"), css.Comma(), css.Hash("f00"), css.Pct(0.0), css.Comma(), css.Hash("00f"), css.Pct(100.0), css.Close()])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Kw("transparent")])
    p.EndList(16)
    p.AddRule(0, 0, -1)
    p.AddRule(1, 1, -1)
    p.AddRule(2, 2, -1)
    p.AddRule(3, 3, -1)
    p.AddRule(4, 3, -1)
    p.AddRule(5, 4, 0)
    p.AddRule(7, 5, -1)
    p.AddRule(8, 6, -1)
    p.AddRule(9, 7, 1)
    p.AddRule(10, 8, -1)
    ret p
end

func add(els &: Vector<css.Element>, tag: str, parent: int, classes: str): int:
    mut e := css.NewElement("box", parent)
    e.tag = tag
    e.classes = classes
    els.push(e)
    ret els.len() - 1
end

func free_all(els &: Vector<css.Element>):
    repeat els.len() in i:
        mut x := els.ref(i)
        x.Free()
    end
    els.free()
end

func tree(els &: Vector<css.Element>):
    body := add(els, "body", -1, "")
    card := add(els, "div", body, "card")
    _h3 := add(els, "h3", card, "")
    p := add(els, "p", card, "")
    _a := add(els, "a", p, "")
    ul := add(els, "ul", body, "")
    _li1 := add(els, "li", ul, "")
    _li2 := add(els, "li", ul, "")
    _wide := add(els, "div", body, "wide")
    _plain := add(els, "div", body, "")
end

func show(label: str, a: css.Sheet, b: css.Sheet, n: int):
    props := ["display", "width", "padding-top", "margin-left", "margin-bottom", "border-top", "border-top-left-radius", "box-shadow", "background-color", "background-image", "color", "font-size", "font-family", "font-style", "font-weight", "line-height", "row-gap", "column-gap", "text-decoration-line", "transition-duration", "transform", "box-sizing"]
    mut same := 0
    mut diff := 0
    repeat n in i:
        sa := a.Style(i)
        sb := b.Style(i)
        repeat len(props) in k:
            va := css.ValueText(sa, props[k])
            vb := css.ValueText(sb, props[k])
            if va == vb:
                same++
            else:
                diff++
                println label, "differs", i, props[k], va, "/", vb
            end
        end
    end
    println label, "same", same, "different", diff
end

func main:
    mut p := css.NewProgram()
    base := compile(p)
    src_a := css.ProgramSource(p, "styles", "css")
    println "base list", base, "again", css.CompileDecls(p, "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)")
    println "empty list", css.CompileDecls(p, "  ")
    println "bad rule", css.CompileRule(p, "a[[", "color: red", "")
    _bad := css.CompileDecls(p, "colr: red; width: banana")
    println "errors", css.ProgramErrors(p)
    repeat css.ProgramErrors(p) in i:
        e := css.ProgramError(p, i)
        println " ", e
    end
    mut q := styles()
    src_b := css.ProgramSource(q, "styles", "css")
    println "source round trip", src_a == src_b, src_a.len() > 1000
    fa := css.ProgramSource(css.NewProgram(), "سبک ها", "سی اس اس")
    println "persian empty", fa.len() > 0, fa.includes("برنامه‌سبک"), fa.includes("برنامه سبک تازه")
    mut text_sheet := css.NewSheet()
    _a1 := text_sheet.AddRule("*", "box-sizing:border-box")
    _a2 := text_sheet.AddRule(".card", "padding:12px; border:2px solid #3366aa; border-radius:10px; box-shadow:0 4px 8px rgba(0,0,0,.25); background:#fff")
    _a3 := text_sheet.AddRule(".card:hover", "background:#ffeecc")
    _a4 := text_sheet.AddRule("h3, .title > b", "margin:0 0 4px; font: italic bold 15px/1.4 Georgia, serif; color: hsl(210 50% 40%)")
    _a5 := text_sheet.AddMediaRule("(max-width: 600px)", ".wide", "width: calc(100% - 2em); --gap: 8px; gap: var(--gap)")
    _a6 := text_sheet.AddRule("a:not(.x)", "text-decoration: underline dotted; transition: color .2s ease-in-out")
    _a7 := text_sheet.AddRule("p", "color: red !important; transform: rotate(45deg) translate(2px, 3px)")
    _a8 := text_sheet.AddCss(RULE_CSS)
    mut prog_sheet := css.SheetFromProgram(q)
    mut ea := Vector {} as Vector<css.Element>
    mut eb := Vector {} as Vector<css.Element>
    tree(ea)
    tree(eb)
    mut pa := ea.ref(9)
    pa.base = "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)"
    mut pb := eb.ref(9)
    pb.decl_base = base
    env := css.Env { width = 500.0, dark = true }
    _c1 := text_sheet.Compute(ea, env)
    _c2 := prog_sheet.Compute(eb, env)
    show("start", text_sheet, prog_sheet, ea.len())
    mut ha := ea.ref(1)
    ha.hovered = true
    mut hb := eb.ref(1)
    hb.hovered = true
    _r1 := text_sheet.Restyle(ea, 1)
    _r2 := prog_sheet.Restyle(eb, 1)
    show("hover", text_sheet, prog_sheet, ea.len())
    println "card hover", css.ValueText(prog_sheet.Style(1), "background-color")
    println "wide", css.ValueText(prog_sheet.Style(8), "width"), css.ValueText(prog_sheet.Style(8), "row-gap")
    w1 := css.DynDecl(q, "width", "120px")
    w2 := css.DynDecl(q, "width", "120px")
    println "dyn same id", w1 == w2, "bad", css.DynDecl(q, "width", "banana")
    mut pd := eb.ref(2)
    pd.decl_dyn.push(w1)
    println "synced", prog_sheet.AddProgram(q)
    _c3 := prog_sheet.Compute(eb, env)
    println "dyn width", css.ValueText(prog_sheet.Style(2), "width")
    free_all(ea)
    free_all(eb)
    text_sheet.Free()
    prog_sheet.Free()
    q.Free()
    p.Free()
end
