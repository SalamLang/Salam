import gui.css

func main:
    mut p := css.NewProgram()
    mut q := p
    first := css.CompileDecls(p, "color:red")
    println "first list: " + first
    p.Free()
    second := css.CompileDecls(q, "color:blue")
    println "after the original was freed, a copy compiles into a fresh program: " + second
    println "errors: " + css.ProgramErrors(q)
    q.Free()
end
