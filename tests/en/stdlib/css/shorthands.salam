import gui.css

func show(text: str):
    mut ds := css.ParseDeclarations(text)
    println text
    repeat ds.Len() in i:
        d := ds[i]
        if d.important:
            println "   ", d.name, "=", d.value, "!important"
        else:
            println "   ", d.name, "=", d.value
        end
    end
    css.FreeDeclarations(ds)
end

func main:
    show("margin: 1px 2px 3px")
    show("padding: 4px !important")
    show("inset: 0 auto")
    show("border: 2px dashed red")
    show("border-left: thick solid")
    show("border-width: 1px 2px; border-style: solid none; border-color: red green blue")
    show("border-radius: 10px 20px / 5px")
    show("outline: 2px solid #93c5fd")
    show("overflow: hidden auto")
    show("flex: 1")
    show("flex: 2 3 10%")
    show("flex: none")
    show("flex: auto")
    show("flex: 200px")
    show("flex-flow: column wrap")
    show("gap: 12px 1em")
    show("place-items: center end")
    show("place-content: space-between")
    show("background: url(x.png) center / cover no-repeat fixed padding-box #fff")
    show("background: linear-gradient(red, blue), #000")
    show("background-position: right 10px bottom 20px")
    show("font: bold 16px/1.4 Vazirmatn, sans-serif")
    show("font: 12px monospace")
    show("font: -webkit-small-control")
    show("list-style: none")
    show("list-style: square inside")
    show("text-decoration: underline wavy red 2px")
    show("text-decoration: none")
    show("transition: opacity 0.3s, transform 200ms ease-out 50ms")
    show("margin-inline: 4px 8px; padding-block: 2px")
    show("border-inline-start: 1px solid blue")
    show("margin: inherit")
    show("margin: var(--m)")
    show("--brand: #f00; color: var(--brand)")
    show("margin: 1px 2px 3px 4px 5px")
    show("border: 2px 3px solid")
    show("unknown-property: 1; color: red")
end
