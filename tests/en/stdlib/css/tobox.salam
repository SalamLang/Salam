import gui.css
import gui.cssbox

func len_of(l: cssbox.Length): str:
    ret "" + (l.kind as int) + ":" + l.value
end

func show(label: str, st: cssbox.Style):
    println label, "display", st.display, "position", st.position, "sizing", st.box_sizing
    println "  width", len_of(st.width), "height", len_of(st.height), "min", len_of(st.min_width), "max", len_of(st.max_width)
    println "  margin", len_of(st.margin.top), len_of(st.margin.right), len_of(st.margin.bottom), len_of(st.margin.left)
    println "  padding", len_of(st.padding.top), len_of(st.padding.left), "border", len_of(st.border.top), len_of(st.border.left)
    println "  inset", len_of(st.inset.top), len_of(st.inset.left), "flex", st.flex_direction, st.flex_wrap, st.flex_grow, st.flex_shrink, len_of(st.flex_basis)
    println "  align", st.justify_content, st.align_items, st.align_self, "gap", len_of(st.row_gap), len_of(st.column_gap), "order", st.order, "dir", st.direction, "overflow", st.overflow_x, st.overflow_y, "ratio", st.aspect_ratio
end

func main:
    mut sheet := css.NewSheet()
    defer sheet.Free()
    mut els := Vector {} as Vector<css.Element>
    els.push(css.NewElement("page", -1))
    mut a := css.NewElement("box", 0)
    a.base = "display: flex; flex-flow: row-reverse wrap; justify-content: space-between; align-items: center; gap: 10px 5%; padding: 1em 2%; border: 3px solid; width: 50%; max-width: 600px; min-height: 2rem; box-sizing: border-box; overflow: hidden; border-radius: 50% / 10px"
    els.push(a)
    mut b := css.NewElement("box", 1)
    b.base = "flex: 1 0 120px; order: 2; align-self: flex-end; margin: auto 10px; aspect-ratio: 4 / 3"
    els.push(b)
    mut c := css.NewElement("box", 1)
    c.base = "position: absolute; top: 5px; left: calc(50% - 20px); width: min(100%, 300px); direction: rtl"
    els.push(c)
    mut d := css.NewElement("span", 0)
    d.base = "width: 100px"
    els.push(d)
    mut f := css.NewElement("box", 0)
    f.base = "border-radius: 80px"
    els.push(f)
    _n := sheet.Compute(els, css.Env { width = 1000.0, height = 700.0 })
    show("flex container", css.ToBox(sheet.Style(1)))
    show("flex item", css.ToBox(sheet.Style(2)))
    show("absolute", css.ToBox(sheet.Style(3)))
    show("absolute resolved in 400x300", css.ToBoxIn(sheet.Style(3), 400.0, 300.0))
    show("inline", css.ToBox(sheet.Style(4)))
    mut tree := cssbox.Tree {}
    root := tree.AddNode(css.ToBox(sheet.Style(0)))
    box := tree.AddNode(css.ToBox(sheet.Style(1)))
    item := tree.AddNode(css.ToBox(sheet.Style(2)))
    tree.AddChild(root, box)
    tree.AddChild(box, item)
    tree.Compute(root, cssbox.Definite(1000.0), cssbox.Definite(700.0))
    lb := tree.Layout(box)
    li := tree.Layout(item)
    println "layout box", lb.x, lb.y, lb.width, lb.height, "item", li.x, li.y, li.width, li.height
    r := css.UsedRadii(sheet.Style(1), 100.0, 50.0)
    println "radii", r.top_left_x, r.top_left_y, r.bottom_right_x, r.bottom_right_y
    r2 := css.UsedRadii(sheet.Style(5), 100.0, 50.0)
    println "radii scaled", r2.top_left_x, r2.top_left_y, r2.top_right_x, r2.bottom_left_y
    println "needs basis", css.NeedsBasis(sheet.Style(1)), css.NeedsBasis(sheet.Style(3))
    repeat els.Len() in i:
        mut x := els.ref(i)
        x.Free()
    end
    els.Free()
end
