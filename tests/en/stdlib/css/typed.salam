import gui.css
import mem

func styles(): css.Program:
    mut p := css.NewProgram()
    p.AddTyped(css.PropertyId("display"), 0, [css.KwId(css.KeywordId("flex"))])
    p.AddTyped(css.PropertyId("margin-top"), 0, [css.DimId(1.5, css.KeywordId("em"))])
    p.AddTyped(css.PropertyId("width"), 0, [css.FnId(css.KeywordId("calc")), css.Pct(100.0), css.Delim(45, true), css.DimId(20.0, css.KeywordId("px")), css.Close()])
    p.AddTyped(css.PropertyId("color"), 2, [css.ColorValue(0x111111ff, 0xeeeeeeff, 1)])
    p.AddTyped(css.PropertyId("border-top-color"), 0, [css.KwId(css.KeywordId("currentcolor"))])
    p.AddTyped(css.PropertyId("background-color"), 0, [css.ColorValue(0x3366aa80, 0x3366aa80, 0)])
    p.EndList(6)
    ret p
end

func add(els &: Vector<css.Element>, tag: str, parent: int, classes: str): int:
    mut e := css.NewElement("box", parent)
    e.tag = tag
    e.classes = classes
    els.Push(e)
    ret els.Len() - 1
end

func free_all(els &: Vector<css.Element>):
    repeat els.Len() in i:
        mut x := els.Ref(i)
        x.Free()
    end
    els.Free()
end

func source_lines(decls: str):
    mut p := css.NewProgram()
    _id := css.CompileDecls(p, decls)
    src := css.ProgramSource(p, "s", "css")
    lines := src.Split("\n")
    repeat lines.Len() in i:
        if lines[i].Includes("AddTyped") or lines[i].Includes("AddVarDecl"):
            println lines[i]
        end
        mem.Free(lines[i] as void*)
    end
    lines.Free()
    mem.Free(src as void*)
    p.Free()
end

func scheme(css_text: str):
    mut p := css.NewProgram()
    _n := css.CompileCss(p, css_text)
    mut s := css.SheetFromProgram(p)
    mut els := Vector {} as Vector<css.Element>
    body := add(els, "body", -1, "")
    repeat 20:
        _x := add(els, "div", body, "plain")
    end
    _l := add(els, "div", body, "ld")
    _y := add(els, "button", body, "")
    _m := add(els, "div", body, "m")
    _c := s.Compute(els, css.Env {})
    println "light", css.ValueText(s.Style(21), "background-color"), css.ValueText(s.Style(22), "background-color"), css.ValueText(s.Style(23), "border-top-width"), css.ValueText(s.Style(1), "color")
    println "to dark restyled", s.SetColorScheme(els, true), "again", s.SetColorScheme(els, true)
    println "dark", css.ValueText(s.Style(21), "background-color"), css.ValueText(s.Style(22), "background-color"), css.ValueText(s.Style(23), "border-top-width"), css.ValueText(s.Style(1), "color")
    println "to light restyled", s.SetColorScheme(els, false)
    println "light", css.ValueText(s.Style(21), "background-color"), css.ValueText(s.Style(22), "background-color"), css.ValueText(s.Style(23), "border-top-width")
    free_all(els)
    s.Free()
    p.Free()
end

func gradient(decl: str):
    mut sheet := css.NewSheet()
    mut els := Vector {} as Vector<css.Element>
    mut e := css.NewElement("box", -1)
    e.base = decl
    els.Push(e)
    _c := sheet.Compute(els, css.Env {})
    l := sheet.Style(0).backgrounds[0]
    mut line := "" + l.stops.Len() + ":"
    each st in l.stops:
        c := css.ColorText(st.color)
        p := css.LenText(st.pos)
        line = line + " " + c + "@" + p
        mem.Free(c as void*)
        mem.Free(p as void*)
    end
    println decl
    println "   ", line
    free_all(els)
    sheet.Free()
end

func legacy():
    mut p := css.NewProgram()
    p.AddDecl("display", false, [css.Kw("block")])
    p.AddDecl("padding-top", false, [css.Dim(4.0, "px")])
    p.AddDecl("color", true, [css.Hash("3366aa")])
    p.EndList(3)
    mut sheet := css.SheetFromProgram(p)
    mut els := Vector {} as Vector<css.Element>
    root := add(els, "body", -1, "")
    mut el := css.NewElement("box", root)
    el.decl_base = 0
    els.Push(el)
    _c := sheet.Compute(els, css.Env {})
    st := sheet.Style(1)
    println "legacy", css.ValueText(st, "display"), css.ValueText(st, "padding-top"), css.ValueText(st, "color")
    free_all(els)
    sheet.Free()
    p.Free()
end

func main:
    println "ids", css.PropertyId("display"), css.PropertyId("color"), css.PropertyId("margin-top"), css.PropertyId("border-inline-start-color"), css.PropertyId("nope")
    pn := css.PropertyName(59)
    kn := css.KeywordName(css.KeywordId("flex"))
    println "names", pn, kn, css.KeywordId("flex"), css.KeywordId("px"), css.KeywordId("currentcolor"), css.KeywordId("no-such-word")
    mem.Free(pn as void*)
    mem.Free(kn as void*)
    piece := css.ColorValue(0x11223344, 0x55667788, 1)
    println "piece", piece.kind, piece.id, piece.color, piece.dark, piece.code, css.KwId(5).id, css.DimId(2.0, 7).id, css.FnId(9).id
    mut q := styles()
    mut sheet := css.SheetFromProgram(q)
    mut els := Vector {} as Vector<css.Element>
    root := add(els, "body", -1, "")
    mut el := css.NewElement("box", root)
    el.decl_base = 0
    els.Push(el)
    _c := sheet.Compute(els, css.Env { width = 400.0 })
    st := sheet.Style(1)
    println "typed", css.ValueText(st, "display"), css.ValueText(st, "margin-top"), css.ValueText(st, "width"), css.ValueText(st, "color"), css.ValueText(st, "border-top-color"), css.ValueText(st, "background-color")
    free_all(els)
    sheet.Free()
    q.Free()
    source_lines("width: calc(10px + 2in); rotate: 0.25turn; margin-left: 1.5pt; z-index: calc(2 * 3); padding-top: calc(1em + 2px)")
    source_lines("border: 1px solid color-mix(in oklch, red, blue); box-shadow: 0 2px 4px oklch(0.5 0.1 200 / 50%)")
    source_lines("color: light-dark(#111, #eee); background: Canvas; accent-color: AccentColor; outline-color: currentColor")
    source_lines("background-image: linear-gradient(in oklab to right, red, hsl(240 100% 50%)); color-scheme: light dark")
    source_lines("--c: red; color: var(--c)")
    scheme(`.plain{color:#123456} .ld{background:light-dark(white, #222)} button{background:ButtonFace} @media (prefers-color-scheme: dark){.m{border:1px solid red}}`)
    scheme(`:root{color-scheme:light dark} .plain{color:#123456} .ld{background:light-dark(white, #222)} button{background:ButtonFace} @media (prefers-color-scheme: dark){.m{border:1px solid red}}`)
    gradient("background-image: linear-gradient(red, blue)")
    gradient("background-image: linear-gradient(in oklab, red, blue)")
    gradient("background-image: linear-gradient(90deg, oklch(0.7 0.1 30), #00f)")
    gradient("background-image: linear-gradient(to right in oklch longer hue, red, blue 80%)")
    gradient("background-image: conic-gradient(from 90deg in hsl, red, lime)")
    legacy()
end
