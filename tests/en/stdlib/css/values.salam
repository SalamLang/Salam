import gui.css

func one(sheet &: css.Sheet, decls: str): css.ComputedStyle:
    mut els := Vector {} as Vector<css.Element>
    mut root := css.NewElement("page", -1)
    root.base = "font-size: 20px; color: #336699"
    els.push(root)
    mut e := css.NewElement("box", 0)
    e.base = decls
    els.push(e)
    _n := sheet.Compute(els, css.Env { width = 800.0, height = 600.0 })
    cs := sheet.Style(1)
    repeat els.Len() in i:
        mut x := els.ref(i)
        x.Free()
    end
    els.free()
    ret cs
end

func color(label: str, text: str):
    mut c := css.Color {}
    ok := css.ParseColor(text, c)
    println label, ok, css.ColorText(c)
end

func len(sheet &: css.Sheet, decl: str):
    cs := one(sheet, "width: " + decl)
    println decl, "=>", css.LenText(cs.width)
end

func main:
    mut sheet := css.NewSheet()
    defer sheet.Free()
    color("hex3", "#f80")
    color("hex4", "#f808")
    color("hex6", "#336699")
    color("hex8", "#33669980")
    color("rgb", "rgb(10, 20, 30)")
    color("rgba", "rgba(10, 20, 30, 0.5)")
    color("rgb pct", "rgb(100% 50% 0%)")
    color("rgb space", "rgb(10 20 30 / 25%)")
    color("hsl", "hsl(120, 100%, 50%)")
    color("hsla", "hsla(240 100% 50% / 0.5)")
    color("hwb", "hwb(0 0% 0%)")
    color("hwb grey", "hwb(90 60% 60%)")
    color("named", "rebeccapurple")
    color("transparent", "transparent")
    color("bad", "rgb(1, 2)")
    len(sheet, "10px")
    len(sheet, "2em")
    len(sheet, "1.5rem")
    len(sheet, "50%")
    len(sheet, "10vw")
    len(sheet, "10vh")
    len(sheet, "10vmin")
    len(sheet, "10vmax")
    len(sheet, "2ch")
    len(sheet, "2ex")
    len(sheet, "12pt")
    len(sheet, "1in")
    len(sheet, "2.54cm")
    len(sheet, "10mm")
    len(sheet, "calc(100% - 2em)")
    len(sheet, "calc(10px + 2 * 3px)")
    len(sheet, "calc((100% - 20px) / 2)")
    len(sheet, "min(100%, 24rem)")
    len(sheet, "max(10px, 1em)")
    len(sheet, "clamp(10px, 5vw, 30px)")
    len(sheet, "clamp(1rem, 50%, 40rem)")
    len(sheet, "fit-content")
    len(sheet, "max-content")
    m := one(sheet, "width: min(100%, 24rem)")
    println "resolve min at 300:", css.Resolve(m.width, 300.0), "at 600:", css.Resolve(m.width, 600.0)
    c2 := one(sheet, "width: calc(100% - 2em)")
    println "resolve calc at 200:", css.Resolve(c2.width, 200.0)
    cc := one(sheet, "border: 2px solid currentColor; background-color: color-mix(in srgb, red, blue)")
    println "currentColor", css.ColorText(cc.border_top.color), "color-mix", css.ColorText(cc.background_color)
    g := one(sheet, "background-image: linear-gradient(45deg, red, blue 40%, green); background-color: navy")
    l := g.backgrounds[0]
    println "linear", l.image, l.angle, l.stops.Len(), css.ColorText(l.stops[1].color), css.LenText(l.stops[1].pos), l.stops[0].has_pos, css.ColorText(g.background_color)
    g2 := one(sheet, "background-image: repeating-linear-gradient(to top right, #000 0 10px, #fff 10px 20px)")
    l2 := g2.backgrounds[0]
    println "repeating corner", l2.repeating, l2.to_x, l2.to_y, l2.stops.Len()
    g3 := one(sheet, "background: radial-gradient(circle 40px at 25% 75%, white, black), url(a.png) no-repeat right 10px top / 50% auto, #eee")
    println "layers", g3.backgrounds.Len(), css.ColorText(g3.background_color)
    r := g3.backgrounds[0]
    println "radial", r.image, r.shape, r.extent, css.LenText(r.radius_x), css.LenText(r.center_x), css.LenText(r.center_y)
    u := g3.backgrounds[1]
    println "url", u.image, u.url, u.repeat_x, u.repeat_y, css.LenText(u.position_x), css.LenText(u.position_y), css.LenText(u.size_w), css.LenText(u.size_h)
    g4 := one(sheet, "background-image: conic-gradient(from 90deg at 10px 20px, red 0deg, blue 0.5turn, red)")
    c4 := g4.backgrounds[0]
    println "conic", c4.image, c4.angle, css.LenText(c4.center_x), css.LenText(c4.stops[1].pos)
    sh := one(sheet, "box-shadow: 0 1px 2px rgba(0,0,0,.1), inset 0 0 0 1px #fff, 3px 3px red")
    repeat sh.box_shadows.Len() in i:
        s := sh.box_shadows[i]
        println "shadow", s.x, s.y, s.blur, s.spread, s.inset, css.ColorText(s.color)
    end
    ts := one(sheet, "text-shadow: 1px 1px 2px black, 0 0 1em blue")
    println "text shadows", ts.text_shadows.Len(), ts.text_shadows[1].blur
    tf := one(sheet, "transform: translate(10px, 50%) scale(2) rotate(45deg) skewX(10deg) matrix(1, 0, 0, 1, 5, 6); transform-origin: left top")
    repeat tf.transforms.Len() in i:
        tfn := tf.transforms[i]
        println "transform", tfn.kind, css.LenText(tfn.x), css.LenText(tfn.y), tfn.a, tfn.b, tfn.e, tfn.f
    end
    println "origin", css.LenText(tf.transform_origin_x), css.LenText(tf.transform_origin_y)
    mm := css.TransformMatrix(one(sheet, "transform: translate(10px, 20px) scale(2)"), 100.0, 50.0)
    println "matrix", mm.a, mm.b, mm.c, mm.d, mm.e, mm.f
    rt := css.TransformMatrix(one(sheet, "rotate: 90deg; transform-origin: 0 0"), 100.0, 50.0)
    println "rotate matrix", rt.a, rt.b, rt.c, rt.d
    tr := one(sheet, "transition: background 200ms ease-in-out, transform 0.1s steps(4, jump-start) 50ms")
    repeat tr.transitions.Len() in i:
        t := tr.transitions[i]
        println "transition", t.property, t.duration, t.delay, t.timing.kind, t.timing.x1, t.timing.steps, t.timing.step_position
    end
    println "ease at 0.5", css.EasingAt(css.Timing {}, 0.5)
    println "linear at 0.3", css.EasingAt(css.Timing { kind = css.TimingKind.Linear }, 0.3)
    println "steps at 0.3", css.EasingAt(css.Timing { kind = css.TimingKind.Steps, steps = 4 }, 0.3)
    f := one(sheet, "font: italic small-caps bold 12px/1.5 \"Vazirmatn\", Tahoma, sans-serif")
    println "font", f.font_style, f.small_caps, f.font_weight, f.font_size, f.line_height, f.line_height_factor, f.font_family
    fams := css.FontFamilies(f)
    println "families", fams.Len(), fams[0], fams[2]
    fams.free()
    f2 := one(sheet, "font-size: larger; font-weight: bolder; line-height: 150%; letter-spacing: 0.1em")
    println "relative font", f2.font_size, f2.font_weight, f2.line_height, f2.letter_spacing
    f3 := one(sheet, "font-family: Times New Roman, serif; font-size: x-large")
    println f3.font_family, f3.font_size
    v := one(sheet, "--gap: 12px; --brand: #ff0000; --pad: var(--gap); padding: var(--pad) 4px; color: var(--brand); margin: var(--missing, 7px); width: var(--nope)")
    println "var", css.LenText(v.padding_top), css.LenText(v.padding_right), css.ColorText(v.color), css.LenText(v.margin_left), css.LenText(v.width)
    url := one(sheet, "list-style: square inside url(\"dot.png\"); cursor: url(hand.cur) 4 4, pointer")
    println "list", url.list_style_type, url.list_style_position, url.list_style_image, url.cursor
    nums := one(sheet, "opacity: 50%; z-index: 7; order: -1; flex-grow: 2; aspect-ratio: 16 / 9")
    println "numbers", nums.opacity, nums.z_index, nums.z_auto, nums.order, nums.flex_grow, nums.aspect_ratio
    bad := one(sheet, "width: 10; height: -5px; color: notacolor; opacity: 0.5; opacity: banana")
    println "invalid dropped", css.LenText(bad.width), css.LenText(bad.height), css.ColorText(bad.color), bad.opacity
end
