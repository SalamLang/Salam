package harness

import gui.cssbox

func len_of(v: str): cssbox.Length:
    switch v:
        "auto":
            ret cssbox.Auto()
        end
        "min":
            ret cssbox.MinContent()
        end
        "max":
            ret cssbox.MaxContent()
        end
        "fit":
            ret cssbox.FitContent()
        end
        "stretch":
            ret cssbox.Stretch()
        end
        else:
        end
    end
    if v.ends_with("%"):
        ret cssbox.Percent(v.substr(0, v.len() - 1).to_float())
    end
    ret cssbox.Px(v.to_float())
end

func align_of(v: str): cssbox.Align:
    switch v:
        "fs":
            ret cssbox.Align.FlexStart
        end
        "fe":
            ret cssbox.Align.FlexEnd
        end
        "start":
            ret cssbox.Align.Start
        end
        "end":
            ret cssbox.Align.End
        end
        "center":
            ret cssbox.Align.Center
        end
        "baseline":
            ret cssbox.Align.Baseline
        end
        "stretch":
            ret cssbox.Align.Stretch
        end
        "sb":
            ret cssbox.Align.SpaceBetween
        end
        "sa":
            ret cssbox.Align.SpaceAround
        end
        "se":
            ret cssbox.Align.SpaceEvenly
        end
        "auto":
            ret cssbox.Align.Auto
        end
        else:
            ret cssbox.Align.Normal
        end
    end
    ret cssbox.Align.Normal
end

func overflow_of(v: str): cssbox.Overflow:
    switch v:
        "hidden":
            ret cssbox.Overflow.Hidden
        end
        "scroll":
            ret cssbox.Overflow.Scroll
        end
        "clip":
            ret cssbox.Overflow.Clip
        end
        else:
            ret cssbox.Overflow.Visible
        end
    end
    ret cssbox.Overflow.Visible
end

func display_of(v: str): cssbox.Display:
    switch v:
        "B":
            ret cssbox.Display.Block
        end
        "N":
            ret cssbox.Display.None
        end
        "R":
            ret cssbox.Display.FlowRoot
        end
        else:
            ret cssbox.Display.Flex
        end
    end
    ret cssbox.Display.Flex
end

func direction_of(v: str): cssbox.FlexDirection:
    switch v:
        "col":
            ret cssbox.FlexDirection.Column
        end
        "rr":
            ret cssbox.FlexDirection.RowReverse
        end
        "cr":
            ret cssbox.FlexDirection.ColumnReverse
        end
        else:
            ret cssbox.FlexDirection.Row
        end
    end
    ret cssbox.FlexDirection.Row
end

func apply(s &: cssbox.Style, k: str, v: str):
    switch k:
        "d":
            s.display = display_of(v)
            break
        end
        "p":
            if v == "abs":
                s.position = cssbox.Position.Absolute
            else v == "rel":
                s.position = cssbox.Position.Relative
            end
            break
        end
        "w":
            s.width = len_of(v)
            break
        end
        "h":
            s.height = len_of(v)
            break
        end
        "nw":
            s.min_width = len_of(v)
            break
        end
        "nh":
            s.min_height = len_of(v)
            break
        end
        "xw":
            s.max_width = len_of(v)
            break
        end
        "xh":
            s.max_height = len_of(v)
            break
        end
        "t":
            s.inset.top = len_of(v)
            break
        end
        "l":
            s.inset.left = len_of(v)
            break
        end
        "b":
            s.inset.bottom = len_of(v)
            break
        end
        "r":
            s.inset.right = len_of(v)
            break
        end
        "mt":
            s.margin.top = len_of(v)
            break
        end
        "ml":
            s.margin.left = len_of(v)
            break
        end
        "mb":
            s.margin.bottom = len_of(v)
            break
        end
        "mr":
            s.margin.right = len_of(v)
            break
        end
        "pt":
            s.padding.top = len_of(v)
            break
        end
        "pl":
            s.padding.left = len_of(v)
            break
        end
        "pb":
            s.padding.bottom = len_of(v)
            break
        end
        "pr":
            s.padding.right = len_of(v)
            break
        end
        "bt":
            s.border.top = len_of(v)
            break
        end
        "bl":
            s.border.left = len_of(v)
            break
        end
        "bb":
            s.border.bottom = len_of(v)
            break
        end
        "br":
            s.border.right = len_of(v)
            break
        end
        "cg":
            s.column_gap = len_of(v)
            break
        end
        "rg":
            s.row_gap = len_of(v)
            break
        end
        "ar":
            s.aspect_ratio = v.to_float()
            break
        end
        "ai":
            s.align_items = align_of(v)
            break
        end
        "as":
            s.align_self = align_of(v)
            break
        end
        "ac":
            s.align_content = align_of(v)
            break
        end
        "jc":
            s.justify_content = align_of(v)
            break
        end
        "fd":
            s.flex_direction = direction_of(v)
            break
        end
        "fw":
            if v == "wrap":
                s.flex_wrap = cssbox.FlexWrap.Wrap
            else v == "wr":
                s.flex_wrap = cssbox.FlexWrap.WrapReverse
            end
            break
        end
        "fg":
            s.flex_grow = v.to_float()
            break
        end
        "fs":
            s.flex_shrink = v.to_float()
            break
        end
        "fb":
            s.flex_basis = len_of(v)
            break
        end
        "ox":
            s.overflow_x = overflow_of(v)
            break
        end
        "oy":
            s.overflow_y = overflow_of(v)
            break
        end
        "sw":
            s.scrollbar_width = v.to_float()
            break
        end
        "dir":
            s.direction = v == "rtl" ? cssbox.Direction.Rtl : cssbox.Direction.Ltr
            break
        end
        "bs":
            s.box_sizing = v == "c" ? cssbox.BoxSizing.ContentBox : cssbox.BoxSizing.BorderBox
            break
        end
        else:
        end
    end
end

func ahem(text: str, mi: cssbox.MeasureInput): cssbox.MeasureOutput:
    words := text.split("|")
    defer words.free()
    mut minl := 0
    mut maxl := 0
    each w in words:
        if w.len() > minl:
            minl = w.len()
        end
        maxl += w.len()
    end
    mut iw := 0.0
    if mi.has_known_width:
        iw = mi.known_width
    else:
        switch mi.available_width.kind:
            cssbox.SpaceKind.MinContent:
                iw = (minl as f64) * 10.0
                break
            end
            cssbox.SpaceKind.MaxContent:
                iw = (maxl as f64) * 10.0
                break
            end
            cssbox.SpaceKind.Definite:
                iw = mi.available_width.value
                if iw > (maxl as f64) * 10.0:
                    iw = (maxl as f64) * 10.0
                end
            end
        end
    end
    if iw < (minl as f64) * 10.0:
        iw = (minl as f64) * 10.0
    end
    mut bh := 0.0
    if mi.has_known_height:
        bh = mi.known_height
    else:
        per := (iw / 10.0) as int
        mut lines := 1
        mut cur := 0
        each w in words:
            if cur + w.len() > per:
                if cur > 0:
                    lines++
                end
                cur = w.len()
            else:
                cur += w.len()
            end
        end
        bh = (lines as f64) * 10.0
    end
    ret cssbox.MeasuredWithBaseline(iw, bh, 8.0)
end

func space_of(v: str): cssbox.Space:
    if v == "max":
        ret cssbox.MaxContentSpace()
    end
    if v == "min":
        ret cssbox.MinContentSpace()
    end
    ret cssbox.Definite(v.to_float())
end

func near(a: f64, b: f64): bool:
    d := a - b
    ret d < 0.1 and d > -0.1
end

func run_case(name: str, nodes: Vector<str>, variant: str, nums: Vector<str>, vw: cssbox.Space, vh: cssbox.Space): bool:
    mut t := cssbox.Tree {}
    defer t.Free()
    mut stack := Vector {} as Vector<int>
    defer stack.free()
    content := variant.starts_with("c")
    rtl := variant.ends_with("r")
    each line in nodes:
        parts := line.split(" ")
        defer parts.free()
        depth := parts.get(1).to_int()
        mut st := cssbox.Style { display = cssbox.Display.Flex, box_sizing = content ? cssbox.BoxSizing.ContentBox : cssbox.BoxSizing.BorderBox, direction = rtl ? cssbox.Direction.Rtl : cssbox.Direction.Ltr }
        mut text := ""
        repeat parts.len() - 2 in k:
            kv := parts.get(k + 2)
            at := kv.indexOf("=")
            key := kv.substr(0, at)
            val := kv.substr(at + 1, kv.len() - at - 1)
            if key == "T":
                text = val
            else:
                apply(st, key, val)
            end
        end
        id := t.AddNode(st)
        if text.len() > 0:
            t.SetMeasure(id, (mi: cssbox.MeasureInput): ret ahem(text, mi) end)
        end
        until stack.len() > depth:
            _x := stack.pop()
        end
        if depth > 0:
            t.AddChild(stack.get(depth - 1), id)
        end
        stack.push(id)
    end
    t.Compute(0, vw, vh)
    mut ok := true
    repeat t.NodeCount() in id:
        mut l := t.Layout(id)
        if id > 0 and t.GetStyle(id).position == cssbox.Position.Absolute:
            mut cb := t.Parent(id)
            until cb > 0 and t.GetStyle(cb).position == cssbox.Position.Static:
                cb = t.Parent(cb)
            end
            cl := t.Layout(cb)
            l.x = l.abs_x - cl.abs_x
            l.y = l.abs_y - cl.abs_y
        end
        ex := nums.get(id * 4).to_float()
        ey := nums.get(id * 4 + 1).to_float()
        ew := nums.get(id * 4 + 2).to_float()
        eh := nums.get(id * 4 + 3).to_float()
        if not (near(l.x, ex) and near(l.y, ey) and near(l.width, ew) and near(l.height, eh)):
            ok = false
            println "FAIL", name, variant, "node", id, "got", l.x, l.y, l.width, l.height, "want", ex, ey, ew, eh
        end
    end
    ret ok
end

pub func Run(data: str): int:
    lines := data.split("\n")
    defer lines.free()
    mut fixtures := 0
    mut cases := 0
    mut failed := 0
    mut name := ""
    mut vw := cssbox.MaxContentSpace()
    mut vh := cssbox.MaxContentSpace()
    mut nodes := Vector {} as Vector<str>
    defer nodes.free()
    each line in lines:
        if line.len() < 3:
            continue
        end
        parts := line.split(" ")
        defer parts.free()
        tag := parts.get(0)
        if tag == "F":
            fixtures++
            name = parts.get(1)
            vw = space_of(parts.get(2))
            vh = space_of(parts.get(3))
            until nodes.len() > 0:
                _old := nodes.pop()
            end
        else tag == "N":
            nodes.push(line)
        else tag == "E":
            mut nums := Vector {} as Vector<str>
            repeat parts.len() - 2 in k:
                nums.push(parts.get(k + 2))
            end
            variants := parts.get(1).split(",")
            each v in variants:
                cases++
                if not run_case(name, nodes, v, nums, vw, vh):
                    failed++
                end
            end
            variants.free()
            nums.free()
        end
    end
    println "fixtures", fixtures, "cases", cases, "failed", failed
    ret failed
end
