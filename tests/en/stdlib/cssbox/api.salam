import gui.cssbox

func show(t: cssbox.Tree, label: str, id: int):
    l := t.Layout(id)
    println label, l.x, l.y, l.width, l.height, "abs", l.abs_x, l.abs_y, "scroll", l.scroll_width, l.scroll_height
end

func list3(a: int, b: int, c: int): Vector<int>:
    mut v := Vector {} as Vector<int>
    each x in [a, b, c]:
        if x >= 0:
            v.push(x)
        end
    end
    ret v
end

func text_of(width: f64, mi: cssbox.MeasureInput): cssbox.MeasureOutput:
    if mi.available_width.kind == cssbox.SpaceKind.MinContent:
        ret cssbox.Measured(width / 2.0, 36.0)
    end
    if mi.available_width.kind == cssbox.SpaceKind.Definite and mi.available_width.value < width:
        ret cssbox.Measured(mi.available_width.value, 36.0)
    end
    ret cssbox.Measured(width, 18.0)
end

func main:
    mut t := cssbox.Tree {}
    defer t.Free()
    root := t.AddNode(cssbox.Style { width = cssbox.Px(300.0), padding = cssbox.AllSides(cssbox.Px(10.0)) })
    row := t.AddNode(cssbox.Style { display = cssbox.Display.Flex, height = cssbox.Px(40.0), column_gap = cssbox.Px(5.0) })
    a := t.AddNode(cssbox.Style { width = cssbox.Px(50.0), order = 2 })
    b := t.AddNode(cssbox.Style { width = cssbox.Percent(20.0), order = 1 })
    c := t.AddNode(cssbox.Style { flex_grow = 1.0, margin = cssbox.SidesOf(cssbox.Auto(), cssbox.Px(0.0), cssbox.Auto(), cssbox.Px(0.0)), height = cssbox.Px(10.0) })
    kids := list3(a, b, c)
    t.SetChildren(row, kids)
    kids.Free()
    wrap := t.AddNode(cssbox.Style { display = cssbox.Display.Contents })
    ib := t.AddNode(cssbox.Style { display = cssbox.Display.InlineBlock, padding = cssbox.AllSides(cssbox.Px(5.0)), border = cssbox.AllSides(cssbox.Px(1.0)) })
    txt := t.AddNode(cssbox.Style {})
    t.SetMeasure(txt, (_mi: cssbox.MeasureInput): ret cssbox.MeasuredWithBaseline(80.0, 20.0, 15.0) end)
    t.AddChild(ib, txt)
    t.AddChild(wrap, ib)
    holder := t.AddNode(cssbox.Style { height = cssbox.Px(30.0), margin = cssbox.SidesOf(cssbox.Px(20.0), cssbox.Px(0.0), cssbox.Px(0.0), cssbox.Px(0.0)) })
    abs := t.AddNode(cssbox.Style { position = cssbox.Position.Absolute, inset = cssbox.SidesOf(cssbox.Auto(), cssbox.Px(0.0), cssbox.Auto(), cssbox.Auto()), width = cssbox.Px(10.0), height = cssbox.Px(10.0) })
    t.AddChild(holder, abs)
    rel := t.AddNode(cssbox.Style { position = cssbox.Position.Relative, height = cssbox.Px(20.0), inset = cssbox.SidesOf(cssbox.Px(3.0), cssbox.Auto(), cssbox.Auto(), cssbox.Px(4.0)) })
    inner := t.AddNode(cssbox.Style { position = cssbox.Position.Absolute, inset = cssbox.AllSides(cssbox.Px(2.0)) })
    t.AddChild(rel, inner)
    fixed := t.AddNode(cssbox.Style { position = cssbox.Position.Fixed, inset = cssbox.SidesOf(cssbox.Auto(), cssbox.Px(5.0), cssbox.Px(5.0), cssbox.Auto()), width = cssbox.Px(20.0), height = cssbox.Px(20.0) })
    scroller := t.AddNode(cssbox.Style { height = cssbox.Px(50.0), overflow_y = cssbox.Overflow.Scroll, scrollbar_width = 15.0, box_sizing = cssbox.BoxSizing.BorderBox, border = cssbox.AllSides(cssbox.Px(2.0)) })
    tall := t.AddNode(cssbox.Style { width = cssbox.Px(400.0), height = cssbox.Px(120.0) })
    t.AddChild(scroller, tall)
    mc := t.AddNode(cssbox.Style { width = cssbox.MaxContent() })
    mct := t.AddNode(cssbox.Style {})
    t.SetMeasure(mct, (mi: cssbox.MeasureInput): ret text_of(120.0, mi) end)
    t.AddChild(mc, mct)
    nc := t.AddNode(cssbox.Style { width = cssbox.MinContent() })
    nct := t.AddNode(cssbox.Style {})
    t.SetMeasure(nct, (mi: cssbox.MeasureInput): ret text_of(120.0, mi) end)
    t.AddChild(nc, nct)
    fc := t.AddNode(cssbox.Style { width = cssbox.FitContent(), aspect_ratio = 4.0 })
    fct := t.AddNode(cssbox.Style {})
    t.SetMeasure(fct, (mi: cssbox.MeasureInput): ret text_of(500.0, mi) end)
    t.AddChild(fc, fct)
    rtl := t.AddNode(cssbox.Style { display = cssbox.Display.Flex, direction = cssbox.Direction.Rtl, flex_wrap = cssbox.FlexWrap.Wrap, justify_content = cssbox.Align.SpaceBetween, align_items = cssbox.Align.Center, align_content = cssbox.Align.Center, height = cssbox.Px(60.0), min_height = cssbox.Px(10.0), max_width = cssbox.Px(250.0) })
    repeat 3 in i:
        cell := t.AddNode(cssbox.Style { width = cssbox.Px(90.0), height = cssbox.Px(10.0 + (i as f64) * 5.0), flex_shrink = 0.0, flex_basis = cssbox.Auto() })
        t.AddChild(rtl, cell)
    end
    col := t.AddNode(cssbox.Style { display = cssbox.Display.Flex, flex_direction = cssbox.FlexDirection.ColumnReverse, height = cssbox.Px(50.0), row_gap = cssbox.Px(4.0), align_items = cssbox.Align.FlexEnd })
    s1 := t.AddNode(cssbox.Style { width = cssbox.Px(30.0), height = cssbox.Px(10.0), align_self = cssbox.Align.Stretch })
    s2 := t.AddNode(cssbox.Style { width = cssbox.Px(30.0), flex_grow = 1.0, max_height = cssbox.Px(20.0), min_width = cssbox.Px(40.0) })
    s3 := t.AddNode(cssbox.Style { display = cssbox.Display.None, height = cssbox.Px(99.0) })
    ck := list3(s1, s2, s3)
    t.SetChildren(col, ck)
    ck.Free()
    st := t.AddNode(cssbox.Style { height = cssbox.Stretch(), max_height = cssbox.Auto() })
    mut all := Vector {} as Vector<int>
    each x in [row, wrap, holder, rel, fixed, scroller, mc, nc, fc, rtl, col, st]:
        all.push(x)
    end
    t.SetChildren(root, all)
    all.Free()
    t.Compute(root, cssbox.Definite(800.0), cssbox.Definite(600.0))
    println "nodes", t.NodeCount(), "children", t.ChildCount(root), "first", t.Child(root, 0), "parent", t.Parent(a), "missing", t.Child(root, 99)
    show(t, "root", root)
    show(t, "row", row)
    show(t, "a", a)
    show(t, "b", b)
    show(t, "c", c)
    show(t, "contents", wrap)
    show(t, "inline-block", ib)
    show(t, "text", txt)
    show(t, "holder", holder)
    show(t, "abs", abs)
    show(t, "rel", rel)
    show(t, "inner", inner)
    show(t, "fixed", fixed)
    show(t, "scroller", scroller)
    show(t, "tall", tall)
    show(t, "max-content", mc)
    show(t, "min-content", nc)
    show(t, "fit-content", fc)
    show(t, "rtl", rtl)
    repeat 3 in i:
        show(t, "rtl cell", t.Child(rtl, i))
    end
    show(t, "col", col)
    show(t, "s1", s1)
    show(t, "s2", s2)
    show(t, "s3", s3)
    show(t, "stretch", st)
    l := t.Layout(ib)
    println "ib baseline", l.has_baseline, l.baseline, "content", l.content_x, l.content_y, l.content_width, l.content_height
    println "ib padding", l.padding.top, l.padding.right, l.padding.bottom, l.padding.left, "border", l.border.top, l.border.right, l.border.bottom, l.border.left
    m := t.Layout(c)
    println "c margin", m.margin.top, m.margin.right, m.margin.bottom, m.margin.left
    sl := t.Layout(scroller)
    println "scroller sb", sl.scrollbar_width, sl.scrollbar_height, "content", sl.content_width, sl.content_height
    t.ResetCounters()
    t.Compute(root, cssbox.Definite(800.0), cssbox.Definite(600.0))
    println "unchanged calls", t.LayoutCalls(), t.MeasureCalls(), "dirty", t.IsDirty(root)
    t.MarkDirty(mct)
    println "after mark dirty", t.IsDirty(mct), t.IsDirty(root), t.IsDirty(a)
    t.Compute(root, cssbox.Definite(800.0), cssbox.Definite(600.0))
    println "one leaf calls", t.LayoutCalls(), t.MeasureCalls()
    t.ResetCounters()
    mut sty := t.GetStyle(a)
    sty.width = cssbox.Px(70.0)
    t.SetStyle(a, sty)
    t.Compute(root, cssbox.Definite(800.0), cssbox.Definite(600.0))
    show(t, "a wider", a)
    show(t, "c after", c)
    println "style change calls", t.LayoutCalls()
    t.ClearMeasure(txt)
    t.Compute(root, cssbox.Definite(500.0), cssbox.Definite(400.0))
    show(t, "ib cleared", ib)
    show(t, "fixed 500", fixed)
    t.SetRounding(false)
    t.Compute(root, cssbox.MaxContentSpace(), cssbox.MinContentSpace())
    show(t, "b unrounded", b)
    println "kinds", cssbox.Definite(1.0).kind == cssbox.SpaceKind.Definite, cssbox.MinContentSpace().kind == cssbox.SpaceKind.MinContent, cssbox.MaxContentSpace().kind == cssbox.SpaceKind.MaxContent
    println "lengths", cssbox.Stretch().kind == cssbox.LengthKind.Stretch, cssbox.Percent(5.0).value, cssbox.Auto().kind == cssbox.LengthKind.Auto
end
