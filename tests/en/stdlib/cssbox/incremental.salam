import gui.cssbox

func text_measure(n: int, mi: cssbox.MeasureInput): cssbox.MeasureOutput:
    full := (n as f64) * 7.0
    mut w := full
    if mi.available_width.kind == cssbox.SpaceKind.MinContent:
        w = 35.0
    else mi.available_width.kind == cssbox.SpaceKind.Definite and mi.available_width.value < full:
        w = mi.available_width.value
        if w < 35.0:
            w = 35.0
        end
    end
    lines := ((full / w) as int) + 1
    ret cssbox.MeasuredWithBaseline(w, (lines as f64) * 16.0, 12.0)
end

func main:
    mut t := cssbox.Tree {}
    defer t.Free()
    root := t.AddNode(cssbox.Style { display = cssbox.Display.Flex, flex_direction = cssbox.FlexDirection.Column, padding = cssbox.AllSides(cssbox.Px(8.0)) })
    mut leaf := 0
    repeat 50 in r:
        row := t.AddNode(cssbox.Style { display = cssbox.Display.Flex, flex_wrap = cssbox.FlexWrap.Wrap, column_gap = cssbox.Px(4.0), row_gap = cssbox.Px(2.0) })
        t.AddChild(root, row)
        repeat 100 in c:
            id := t.AddNode(cssbox.Style { flex_grow = 1.0, padding = cssbox.AllSides(cssbox.Px(2.0)) })
            n := 3 + (r * 7 + c * 3) % 11
            t.SetMeasure(id, (mi: cssbox.MeasureInput): ret text_measure(n, mi) end)
            t.AddChild(row, id)
            if r == 25 and c == 50:
                leaf = id
            end
        end
    end
    t.Compute(root, cssbox.Definite(1280.0), cssbox.Definite(800.0))
    println "nodes", t.NodeCount(), "first layout calls", t.LayoutCalls(), "measures", t.MeasureCalls()
    l := t.Layout(root)
    println "root", l.width, l.height
    t.ResetCounters()
    t.Compute(root, cssbox.Definite(1280.0), cssbox.Definite(800.0))
    println "unchanged calls", t.LayoutCalls(), "measures", t.MeasureCalls()
    t.SetMeasure(leaf, (mi: cssbox.MeasureInput): ret text_measure(40, mi) end)
    t.Compute(root, cssbox.Definite(1280.0), cssbox.Definite(800.0))
    println "one leaf calls", t.LayoutCalls(), "measures", t.MeasureCalls()
    ll := t.Layout(leaf)
    println "leaf", ll.x, ll.y, ll.width, ll.height
    t.ResetCounters()
    t.Compute(root, cssbox.Definite(1000.0), cssbox.Definite(800.0))
    println "resize calls", t.LayoutCalls(), "measures", t.MeasureCalls()
    println "root", t.Layout(root).width, t.Layout(root).height
end
