import gui.cssbox

func run_list(flex: bool, text: bool): int:
    mut t := cssbox.Tree {}
    defer t.Free()
    body := t.AddNode(cssbox.Style { width = cssbox.Px(300.0) })
    mut ls := cssbox.Style { height = cssbox.Px(200.0), overflow_x = cssbox.Overflow.Auto, overflow_y = cssbox.Overflow.Auto, border = cssbox.AllSides(cssbox.Px(1.0)) }
    if flex:
        ls.display = cssbox.Display.Flex
        ls.flex_direction = cssbox.FlexDirection.Column
    end
    list := t.AddNode(ls)
    t.AddChild(body, list)
    row := cssbox.Style { height = cssbox.Px(20.0), border = cssbox.SidesOf(cssbox.Px(0.0), cssbox.Px(0.0), cssbox.Px(1.0), cssbox.Px(0.0)) }
    repeat 2000:
        c := t.AddNode(row)
        if text:
            t.SetMeasure(c, (_mi: cssbox.MeasureInput): ret cssbox.Measured(100.0, 20.0) end)
        end
        t.AddChild(list, c)
    end
    t.Compute(body, cssbox.Definite(300.0), cssbox.Definite(240.0))
    first := t.Layout(list).scroll_height
    mut hover := row
    hover.padding = cssbox.AllSides(cssbox.Px(0.0))
    t.SetStyle(t.Child(list, 1000), hover)
    t.Compute(body, cssbox.Definite(300.0), cssbox.Definite(240.0))
    l := t.Layout(list)
    last := t.Layout(t.Child(list, 1999))
    println "flex", flex, "text", text, "scroll height", first, l.scroll_height, "client", l.content_height, "last row", last.y, last.height
    ret l.scroll_height as int
end

func main:
    _a := run_list(false, false)
    _b := run_list(false, true)
    _c := run_list(true, false)
    _d := run_list(true, true)
end
