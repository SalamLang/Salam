// Edge cases + malformed/ragged input for encoding.csv, complementing
// csv_value_demo.salam's happy-path multi-row round trip.

package main

import encoding.csv
import encoding.value
import testing
import os
import str

func main:
    // escaped double-quote ("") inside a quoted field
    fields1 := csv.ReadLine(`a,"she said ""hi""",c`)
    testing.AssertEqInt(fields1.len(), 3)
    testing.AssertEqStr(fields1.get(1)[0], `she said "hi"`)

    // WriteLine re-quotes a field containing a comma or a quote
    written := csv.WriteLine(fields1)
    testing.AssertTrue(str.Contains(written, `""hi""`))
    reparsed := csv.ReadLine(written)
    testing.AssertEqStr(reparsed.get(1)[0], `she said "hi"`)

    // a field that needs no quoting round trips byte-for-byte
    plain := csv.ReadLine("x,y,z")
    testing.AssertEqStr(csv.WriteLine(plain), "x,y,z")

    // empty field between two commas
    fields2 := csv.ReadLine("a,,c")
    testing.AssertEqInt(fields2.len(), 3)
    testing.AssertEqStr(fields2.get(1)[0], "")

    // trailing comma produces a trailing empty field
    fields3 := csv.ReadLine("a,b,")
    testing.AssertEqInt(fields3.len(), 3)
    testing.AssertEqStr(fields3.get(2)[0], "")

    // single empty line still yields one field (the empty string)
    fields4 := csv.ReadLine("")
    testing.AssertEqInt(fields4.len(), 1)
    testing.AssertEqStr(fields4.get(0)[0], "")

    // empty document -> zero rows
    empty_table := csv.ReadAll("")
    testing.AssertEqInt(empty_table.rows.len(), 0)

    // ragged rows (different column counts) round trip as-is - ReadAll does
    // not pad/truncate, each CSVRow just keeps whatever ReadLine produced
    ragged := csv.ReadAll("a,b,c\r\nx,y\r\np,q,r,s\r\n")
    testing.AssertEqInt(ragged.rows.len(), 3)
    testing.AssertEqInt(ragged.rows.get(0)[0].fields.len(), 3)
    testing.AssertEqInt(ragged.rows.get(1)[0].fields.len(), 2)
    testing.AssertEqInt(ragged.rows.get(2)[0].fields.len(), 4)

    // CSVOptions{header=false} - columns get positional "colN" keys instead
    // of a header row, and every row (including row 0) becomes data
    noHeaderText := "1,2\r\n3,4\r\n"
    v := csv.ToValueWith(noHeaderText, csv.CSVOptions { header = false })
    testing.AssertEqInt(value.ArrayLen(v), 2)
    first := value.ArrayGet(v, 0)
    testing.AssertEqStr(value.AsString(value.ObjectGet(first, "col0")), "1")
    testing.AssertEqStr(value.AsString(value.ObjectGet(first, "col1")), "2")

    backNoHeader := csv.FromValueWith(v, csv.CSVOptions { header = false })
    v2 := csv.ToValueWith(backNoHeader, csv.CSVOptions { header = false })
    testing.AssertTrue(value.Equal(v, v2))

    value.ValueFree(v)
    value.ValueFree(v2)

    os.Exit(testing.Summary())
end
