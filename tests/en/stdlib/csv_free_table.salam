package main

import encoding.csv

func main:
    try:
        mut table := csv.ReadAll("name,age\nada,36\ngrace,45\n")
        println table.rows.Len(), table.rows.get(1).fields.get(0), table.rows.get(2).fields.get(1)
        csv.FreeTable(table)
        println table.rows.Len()
        mut again := csv.ReadAll("x,y\r\n1,2\r\n")
        println csv.WriteAll(again) == "x,y\r\n1,2"
        csv.FreeTable(again)
        mut none := csv.ReadAll("")
        println none.rows.Len()
        csv.FreeTable(none)
    catch e:
        println e.ToStr()
    end
end
