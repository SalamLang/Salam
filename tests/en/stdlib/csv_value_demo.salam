package main

import encoding.csv
import encoding.value
import testing
import os

func main:
    text := "name,age\r\nAda,36\r\n\"Doe, John\",40\r\n"
    table := csv.ReadAll(text)
    testing.AssertEqInt(table.rows.len(), 3)
    testing.AssertEqStr(table.rows.get(0)[0].fields.get(0)[0], "name")
    testing.AssertEqStr(table.rows.get(2)[0].fields.get(0)[0], "Doe, John")

    back := csv.WriteAll(table)
    table2 := csv.ReadAll(back)
    testing.AssertEqInt(table2.rows.len(), 3)
    testing.AssertEqStr(table2.rows.get(2)[0].fields.get(0)[0], "Doe, John")

    v := csv.ToValue(text)
    testing.AssertEqInt(value.ArrayLen(v), 2)
    first := value.ArrayGet(v, 0)
    testing.AssertEqStr(value.AsString(value.ObjectGet(first, "name")), "Ada")
    // CSV cells decode as strings (no native typing) - AsInt only coerces
    // between Int/Float, not String, so callers needing a number convert
    // the string themselves; this checks the string form actually decoded.
    testing.AssertEqStr(value.AsString(value.ObjectGet(first, "age")), "36")
    second := value.ArrayGet(v, 1)
    testing.AssertEqStr(value.AsString(value.ObjectGet(second, "name")), "Doe, John")

    csvBack := csv.FromValue(v)
    v2 := csv.ToValue(csvBack)
    testing.AssertEqInt(value.ArrayLen(v2), 2)
    testing.AssertTrue(value.Equal(value.ArrayGet(v, 0), value.ArrayGet(v2, 0)))
    testing.AssertTrue(value.Equal(value.ArrayGet(v, 1), value.ArrayGet(v2, 1)))

    value.ValueFree(v)
    value.ValueFree(v2)

    os.Exit(testing.Summary())
end
