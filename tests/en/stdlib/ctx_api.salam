package main

import ctx
import sync

func main:
    root := ctx.Background()
    println "root deadline: ", ctx.Deadline(root)

    far := sync.NowMs() + 600000 as i64
    timed := ctx.WithDeadline(root, far)
    println "deadline kept: ", ctx.Deadline(timed) == far
    println "deadline done: ", ctx.IsDone(timed)
    println "deadline err: ", ctx.Err(timed)

    child := ctx.WithCancel(timed)
    println "inherited: ", ctx.Deadline(child) == far

    sooner := ctx.WithDeadline(child, far - 1000 as i64)
    println "nearest wins: ", ctx.Deadline(sooner) == far - 1000 as i64

    past := ctx.WithDeadline(root, sync.NowMs() - 10 as i64)
    println "past done: ", ctx.IsDone(past)
    println "past err: ", ctx.Err(past)
    println "past wait: ", ctx.Wait(past, 50 as i64)

    ctx.Cancel(child)
    println "cancel done: ", ctx.IsDone(child)
    println "cancel err: ", ctx.Err(child)
    println "parent unaffected: ", ctx.IsDone(timed)

    ctx.Free(past)
    ctx.Free(sooner)
    ctx.Free(child)
    ctx.Free(timed)
    ctx.Free(root)
end
