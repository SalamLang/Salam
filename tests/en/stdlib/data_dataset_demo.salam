package main


import data
import matrix
import tensor
import testing

func main:
    mut y := matrix.Matrix {}
    mut x := data.MakeClassification(100, 3, 4, 2.0, 5, y)
    mut ds := data.MatrixDataset {}
    ds.x = x
    ds.y = y
    testing.AssertEqInt(ds.len(), 100)

    mut it := ds.batches(32, true, 7)
    testing.AssertEqInt(it.batches_per_epoch(), 4)
    mut xb := matrix.Matrix {}
    mut yb := matrix.Matrix {}
    mut count := 0
    mut rows := 0
    mut last := 0
    mut seen := Vector {} as Vector<int>
    seen.zeros(100)
    until it.next(xb, yb):
        count += 1
        rows += xb.rows
        last = xb.rows
        testing.AssertEqInt(xb.cols, 3)
        testing.AssertEqInt(yb.cols, 1)
        repeat xb.rows with i:
            repeat 100 with r:
                if x.at(r, 0) == xb.at(i, 0) && x.at(r, 1) == xb.at(i, 1):
                    seen.set(r, seen.get(r) + 1)
                end
            end
        end
    end
    testing.AssertEqInt(count, 4)
    testing.AssertEqInt(rows, 100)
    testing.AssertEqInt(last, 4)
    mut once := true
    repeat 100 with r:
        if seen.get(r) != 1: once = false end
    end
    testing.AssertTrue(once)

    it.reset(0)
    it.next(xb, yb)
    mut first0 := matrix.Clone(xb)
    it.reset(1)
    it.next(xb, yb)
    testing.AssertFalse(matrix.AllClose(first0, xb, 0.000000001))
    it.reset(0)
    it.next(xb, yb)
    testing.AssertTrue(matrix.AllClose(first0, xb, 0.000000001))

    mut it2 := ds.batches(10, false, 0)
    it2.next(xb, yb)
    testing.AssertEqFloat(xb.at(0, 0), x.at(0, 0), 0.0)
    testing.AssertEqFloat(xb.at(9, 2), x.at(9, 2), 0.0)

    it2.reset(0)
    mut xt := tensor.Empty()
    mut labels := Vector {} as Vector<int>
    testing.AssertTrue(it2.next_tensor(xt, labels))
    testing.AssertEqInt(xt.dim(0), 10)
    testing.AssertEqInt(xt.dim(1), 3)
    testing.AssertEqInt(labels.len(), 10)
    testing.AssertEqInt(labels.get(3), y.at(3, 0) as int)
    testing.AssertEqFloat(xt.at2(4, 1), x.at(4, 1), 0.00001)

    mut xall := data.XTensor(x)
    testing.AssertEqInt(xall.dim(0), 100)
    mut yall := data.YLabels(y)
    testing.AssertEqInt(yall.len(), 100)
    testing.AssertEqInt(yall.get(5), 1)

    it.free()
    it2.free()
    ds.free()
    matrix.Free(xb)
    matrix.Free(yb)
    matrix.Free(first0)
    tensor.Free(xt)
    tensor.Free(xall)
    labels.free()
    yall.free()
    seen.free()

    ret testing.Summary()
end
