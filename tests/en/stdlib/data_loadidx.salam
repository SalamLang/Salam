package main

import archive
import compress
import data
import encoding.binary
import filepath
import mem
import os

func main:
    mut b := compress.NewByteBuf()
    binary.WriteU8(b, 0)
    binary.WriteU8(b, 0)
    binary.WriteU8(b, 8)
    binary.WriteU8(b, 2)
    binary.WriteU32BE(b, 3)
    binary.WriteU32BE(b, 2)
    repeat 6 in i:
        binary.WriteU8(b, i * 3)
    end
    dir := filepath.Join(os.TempDir(), "salam_data_loadidx")
    archive.EnsureDir(dir)
    plain := filepath.Join(dir, "plain-idx")
    packed := filepath.Join(dir, "packed-idx.gz")
    missing := filepath.Join(dir, "missing-idx")
    println archive.WriteBinaryFileBuf(plain, b)
    println archive.WriteBinaryFileBuf(packed, compress.GzipCompressBuf(b))
    mut ok := false
    m := data.LoadIdx(plain, ok)
    println ok, m.rows, m.cols, m.at(0, 0), m.at(1, 1), m.at(2, 1)
    g := data.LoadIdx(packed, ok)
    println ok, g.rows, g.cols, g.at(2, 1)
    _ := data.LoadIdx(missing, ok)
    println ok
    junk := compress.BufFromStr("not an idx file")
    bad := filepath.Join(dir, "bad-idx")
    println archive.WriteBinaryFileBuf(bad, junk)
    _ := data.LoadIdx(bad, ok)
    println ok
    os.RemoveAll(dir)
    mem.Free(dir as void*)
end
