import db
import db.sqlite

func main:
    d := sqlite.Open(":memory:")
    c := sqlite.Conn(d)

    mut setup := Vector {} as Vector<str>
    setup.push("CREATE TABLE t (a INTEGER, b REAL)")
    setup.push("INSERT INTO t VALUES (9000000000, 1.5)")
    setup.push("INSERT INTO t VALUES (2, 2.25)")
    println db.RunAll(c, setup)

    mut broken := Vector {} as Vector<str>
    broken.push("INSERT INTO t VALUES (3, 3.0)")
    broken.push("INSERT INTO missing VALUES (1)")
    broken.push("INSERT INTO t VALUES (4, 4.0)")
    println db.RunAll(c, broken)

    println db.QueryInt64(c, "SELECT MAX(a) FROM t")
    println db.QueryInt64(c, "SELECT a FROM missing")
    println db.QueryFloat(c, "SELECT SUM(b) FROM t WHERE a < 100")
    println db.QueryFloat(c, "SELECT b FROM missing")

    println db.QuoteLiteral("plain")
    println db.QuoteLiteral("it's")
    println db.QuoteLiteral("")
    println db.Run(c, "INSERT INTO t VALUES (5, " + db.QuoteLiteral("7") + ")")

    mut m := db.NewMigratorIn("schema_log")
    db.AddMigration(m, 1, "users", "CREATE TABLE users (id INTEGER PRIMARY KEY)", "DROP TABLE users")
    println db.EnsureTable(m, c)
    println db.QueryInt(c, "SELECT COUNT(*) FROM schema_log")
    println db.MigrateUp(m, c)
    println db.QueryInt(c, "SELECT COUNT(*) FROM schema_log")
    println db.SchemaVersion(m, c)
    db.FreeMigrator(m)

    mut p := db.NewPool(2)
    println db.Add(p, c)
    println db.Size(p)
    db.CloseAll(p)
    println db.Size(p), db.Idle(p)
    db.Free(p)
end
