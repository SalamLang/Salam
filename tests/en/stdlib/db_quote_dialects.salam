package main

import db
import db.mysql
import db.sql

const INPUT := "x\\' OR 1=1 -- "

func main:
    println "sqlite quote: " + db.QuoteLiteral(INPUT)
    println "mysql quote: " + mysql.Database {}.Quote(INPUT)
    println "mysql escape: " + mysql.Escape(mysql.Database {}, INPUT)
    println "mysql newline: " + mysql.Database {}.Quote("a\nb\r" + "c")
    println "sqlite backslash: " + sql.DialectNamed("sqlite").backslash_escape
    println "mysql backslash: " + sql.DialectNamed("mysql").backslash_escape
    println "postgres backslash: " + sql.DialectNamed("postgres").backslash_escape
    println "unknown backslash: " + sql.DialectNamed("mysql8").backslash_escape
    println "unknown name: " + sql.DialectNamed("mysql8").name
end
