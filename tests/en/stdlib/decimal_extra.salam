package main

import decimal
import testing

func expect(d: decimal.Dec, want: str):
    mut v := d
    testing.AssertEqStr(decimal.ToStr(v), want)
    v.Free()
end

func main:
    println "subtracting a plain integer"
    mut price := decimal.ParseOr("19.99")
    expect(decimal.SubInt(price, 5 as i64), "14.99")
    expect(decimal.SubInt(price, 0 as i64), "19.99")
    expect(decimal.SubInt(price, 20 as i64), "-0.01")
    expect(decimal.SubInt(price, 0 - 1 as i64), "20.99")
    mut whole := decimal.FromInt(10 as i64)
    expect(decimal.SubInt(whole, 3 as i64), "7")
    mut tiny := decimal.ParseOr("0.000001")
    expect(decimal.SubInt(tiny, 1 as i64), "-0.999999")
    mut sub := decimal.SubInt(price, 5 as i64)
    mut again := decimal.Add(sub, decimal.FromInt(5 as i64))
    testing.AssertTrue(decimal.Equals(again, price))
    sub.Free()
    again.Free()
    price.Free()
    whole.Free()
    tiny.Free()
    ret testing.Summary()
end
