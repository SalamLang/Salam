import dependency
import str

struct Cfg:
    pub dsn: str = ""
    pub n: int = 0
end

func level_name(i: int): str:
    ret "L" + str.FromInt(i)
end

func main:
    c := dependency.New()
    dependency.Value(c, "Cfg", Cfg { dsn = "db://x", n = 5 })
    mut cfg := Cfg {}
    println dependency.Get(c, "Cfg", cfg), cfg.dsn, cfg.n
    println dependency.Get(c, "Nope", cfg), dependency.Error(c)
    println dependency.Count(c)
    dependency.Close(c)

    deep := dependency.New()
    dependency.Value(deep, "L0", 1)
    repeat 1 to 200 in i:
        prev := level_name(i - 1)
        dependency.Provide(deep, level_name(i), prev, 0, (cx: dependency.Container):
            mut v := 0
            _ok := dependency.Get(cx, prev, v)
            ret v + 1
        end)
    end
    println dependency.Build(deep) == "" ? "sound" : "broken"
    mut top := 0
    println dependency.Get(deep, "L200", top), top
    built := dependency.Built(deep)
    println built.len(), built.get(0), built.get(200)
    built.free()
    dependency.Close(deep)

    loop := dependency.New()
    dependency.Provide(loop, "X", "", 0, (cx: dependency.Container):
        mut v := 0
        _ok := dependency.Get(cx, "X", v)
        ret v
    end)
    mut x := 0
    println dependency.Get(loop, "X", x), dependency.Error(loop)
    dependency.Close(loop)

    self := dependency.New()
    dependency.Provide(self, "S", "S", 0, (_c: dependency.Container): ret 1 end)
    println dependency.Build(self)
    dependency.Close(self)
end
