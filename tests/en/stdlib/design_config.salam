import layoutgen
import os
import str

func check(name: str, good: bool):
    if good:
        println "PASS " + name
    else:
        println "FAIL " + name
    end
end

func contains(text: str, piece: str): bool:
    ret text.Find(piece) >= 0
end

func main:
    base := os.TempDir() + "/salam_design_cfg_" + str.FromInt(os.Pid())
    os.Mkdir(base)
    os.Mkdir(base + "/site")
    os.Mkdir(base + "/site/pages")
    os.WriteFile(
        base + "/site/design.toml",
        "palette = \"brand\"\ntheme = \"dark\"\nfont-sans = \"Inter, sans-serif\"\nfont-url = \"https://fonts.googleapis.com/css2?family=Inter:wght@400;700\"\nfont-face = \"Brand+Sans /f/b.woff2 400 700\"\n\n[tokens]\ndark-ring = \"red\"\n\n[palette.brand]\nbase = \"zinc\"\nprimary = \"oklch(0.6 0.2 260)\"\ndark-primary = \"oklch(0.7 0.15 260)\"\n"
    )
    os.Chdir(base + "/site/pages")
    mut pg := layoutgen.Node {}
    pg.name = "page"
    pg.attrs = " data-tokens=\"radius: 2rem\""
    r1 := layoutgen.design_page(pg)
    check("custom palette primary", contains(r1.shared_css, "--primary:light-dark(oklch(0.6 0.2 260),oklch(0.7 0.15 260));"))
    check("base palette used", contains(r1.shared_css, "--background:light-dark(oklch(1 0 0),oklch(0.141 0.005 285.823))"))
    check("page token wins", contains(r1.shared_css, "--radius:2rem;"))
    check("config token", contains(r1.shared_css, "oklch(0.705 0.015 286.067),red"))
    check("config font", contains(r1.shared_css, "--ds-font-sans:Inter, sans-serif"))
    check("config theme", contains(r1.shared_css, ":root:not([data-theme]){color-scheme:dark}"))
    check("font face", contains(r1.shared_css, "@font-face{font-family:\"Brand Sans\";src:url(\"/f/b.woff2\") format(\"woff2\");font-weight:400 700;font-style:normal;font-display:swap}"))
    check("font link", contains(r1.head, "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;700\">"))
    check("preconnect", contains(r1.head, "https://fonts.gstatic.com"))
    pg.attrs = " data-tokens=\"font-sans: Georgia, serif\""
    r4 := layoutgen.design_page(pg)
    check("page font wins", contains(r4.shared_css, "--ds-font-sans:Georgia, serif") and not contains(r4.shared_css, "Inter, sans-serif"))
    pg.attrs = " data-palette=\"zinc\" data-design=\"none\""
    r2 := layoutgen.design_page(pg)
    check("page design none wins", r2.shared_css.Find("--primary") < 0)
    pg.attrs = " data-tokens=\"primry: red\""
    r3 := layoutgen.design_page(pg)
    check("unknown token warns", contains(r3.head, "salam-design-warning") and contains(r3.head, "unknown design token &#39;primry&#39;"))
    os.Chdir("/")
    os.Remove(base + "/site/design.toml")
    os.Rmdir(base + "/site/pages")
    os.Rmdir(base + "/site")
    os.Rmdir(base)
    conf := layoutgen.DsConfigParse("[package]\nname = \"x\"\n\n[design]\nthemes = \"dark\" # comment\n[deps]\nz = 1\n[design.palette.a]\nbase = \"slate\"\n", false)
    check("salam.toml design only", not contains(conf, "package") and not contains(conf, "deps"))
    check("salam.toml value", layoutgen.DsConfigValue(layoutgen.DsConfigBlock(conf, "design"), "themes") == "dark")
    check("salam.toml palette", layoutgen.DsConfigValue(layoutgen.DsConfigBlock(conf, "design.palette.a"), "base") == "slate")
end
