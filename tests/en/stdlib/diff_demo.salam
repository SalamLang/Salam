import text.diff

func show(lines: Vector<str>):
    each line in lines:
        println line
    end
end

func main:
    old := "one\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\n"
    fresh := "one\n2\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\neleven\n"

    a := diff.Lines(old)
    b := diff.Lines(fresh)
    defer a.Free()
    defer b.Free()
    println "lines", a.Len(), b.Len()

    println "context 1"
    one := diff.Unified(a, b, "old.txt", "new.txt", 1)
    show(one)
    one.Free()

    println "context 0"
    none := diff.Unified(a, b, "old.txt", "new.txt", 0)
    show(none)
    none.Free()

    print "text form:\n" + diff.UnifiedText(old, fresh, "a", "b", 3)
    println "same text:", diff.UnifiedText(old, old, "a", "b", 3).Len()

    ops := diff.Opcodes(a, b)
    each op in ops:
        println op.tag, op.a_start, op.a_stop, op.b_start, op.b_stop
    end
    ops.Free()

    println diff.Equal, diff.Replace, diff.Delete, diff.Insert

    println diff.Ratio(a, b)
    println diff.RatioText("abcd", "bcde")
    println diff.RatioText("", ""), diff.RatioText("abc", "xyz"), diff.RatioText("same", "same")

    groups := diff.GroupedOpcodes(a, b, 1)
    println "groups", groups.Len()
    each g in groups:
        g.Free()
    end
    groups.Free()

    x := diff.Lines("a\r\nb\r\n")
    println x.Len(), x.Get(0) + "|" + x.Get(1) + "|"
    x.Free()
end
