import text.diff
import str


func tag_name(t: int): str:
    switch t:
        diff.Equal:
            ret "equal"
        end
        diff.Replace:
            ret "replace"
        end
        diff.Delete:
            ret "delete"
        end
        else:
            ret "insert"
        end
    end
end

func ops_line(a: Vector<str>, b: Vector<str>): str:
    ops := diff.Opcodes(a, b)
    mut out := ""
    each op in ops:
        out = out + tag_name(op.tag) + "[" + str.FromInt(op.a_start as i64) + ":" + str.FromInt(op.a_stop as i64) + "," + str.FromInt(op.b_start as i64) + ":" + str.FromInt(op.b_stop as i64) + "] "
    end
    ops.free()
    ret out
end

func numbered(n: int, skip: int, word: str): str:
    mut out := ""
    repeat n in i:
        if i == skip:
            out = out + word + "\n"
        else:
            out = out + "line " + str.FromInt(i as i64) + "\n"
        end
    end
    ret out
end

func main:
    empty := diff.Lines("")
    one := diff.Lines("a")
    nl := diff.Lines("\n")
    two := diff.Lines("a\nb")
    crlf := diff.Lines("a\r\nb\r\n\r\n")
    println empty.len(), one.len(), nl.len(), two.len(), crlf.len()
    println "[" + nl.get(0) + "]", "[" + crlf.get(2) + "]"

    println "empty vs empty:", ops_line(empty, empty)
    println "empty vs two:", ops_line(empty, two)
    println "two vs empty:", ops_line(two, empty)
    println "same:", ops_line(two, two)
    x := diff.Lines("a\nb\nc")
    y := diff.Lines("x\ny\nz")
    println "all different:", ops_line(x, y)
    p := diff.Lines("a\nb\nc\nd")
    q := diff.Lines("a\nc\nd\ne")
    println "mixed:", ops_line(p, q)

    println "unified empty:", diff.Unified(empty, empty, "a", "b", 3).len()
    println "unified same:", diff.Unified(two, two, "a", "b", 3).len()
    print diff.UnifiedText("", "new\n", "a", "b", 3)
    print diff.UnifiedText("old\n", "", "a", "b", 3)
    print diff.UnifiedText("a\r\nb\r\n", "a\nb\n", "a", "b", 3).len()
    println ""
    print diff.UnifiedText("a\nb", "a\nc", "", "", 0)
    print diff.UnifiedText("a\nb\nc", "a\nb\nc\nd", "one", "two", 100)
    print diff.UnifiedText("a\nb\nc", "a\nb\nc\nd", "one", "two", 0 - 5)

    persian_old := "سلام\nدنیا\nخداحافظ\n"
    persian_new := "سلام\nجهان\nخداحافظ\n"
    print diff.UnifiedText(persian_old, persian_new, "قدیم", "جدید", 1)
    println diff.RatioText("سلام", "سلام"), diff.RatioText("سلام", "سلامت"), diff.RatioText("ab", "")

    println diff.Ratio(empty, empty), diff.Ratio(empty, two), diff.Ratio(two, two), diff.Ratio(x, y)

    big_a := diff.Lines(numbered(20000, 0 - 1, ""))
    big_b := diff.Lines(numbered(20000, 10000, "changed"))
    big := diff.Unified(big_a, big_b, "a", "b", 2)
    println "big:", big_a.len(), big.len()
    each l in big:
        println l
    end

    groups := diff.GroupedOpcodes(big_a, big_b, 3)
    println "big groups:", groups.len(), groups.get(0).len()
    each g in groups:
        g.free()
    end
    groups.free()
    equal_groups := diff.GroupedOpcodes(two, two, 3)
    println "equal groups:", equal_groups.len()
    equal_groups.free()
    none := diff.GroupedOpcodes(empty, empty, 3)
    println "empty groups:", none.len()
    none.free()
    big.free()
    big_a.free()
    big_b.free()
    empty.free()
    one.free()
    nl.free()
    two.free()
    crlf.free()
    x.free()
    y.free()
    p.free()
    q.free()
end
