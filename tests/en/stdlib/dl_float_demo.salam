import os.dl

func main:
    println "supported:", dl.Supported()
    if not dl.Supported():
        ret
    end
    lib := dl.OpenSelf()
    defer dl.Close(lib)
    mut m := lib
    if SALAM_OS_LINUX:
        m = dl.Open("libm.so.6")
    end
    none := [0 as size]
    println "pow:", dl.CallMixedF64(dl.Sym(m, "pow"), none[: 0], [2.0, 10.0])
    println "hypot:", dl.CallMixedF64(dl.Sym(m, "hypot"), none[: 0], [3.0, 4.0])
    println "ldexp:", dl.CallMixedF64(dl.Sym(m, "ldexp"), [3 as size], [1.5])
    println "lround:", dl.CallMixed(dl.Sym(m, "lround"), none[: 0], [2.6])
    println "labs:", dl.CallMixed(dl.Sym(lib, "labs"), [(0 - 7) as size], [0.0])
    println "null:", dl.CallMixed(null, none[: 0], [1.0]), dl.CallMixedF64(null, none[: 0], [1.0])
    println "too many:", dl.CallMixed(dl.Sym(lib, "labs"), [1 as size, 2, 3, 4, 5, 6, 7], [0.0])
end
