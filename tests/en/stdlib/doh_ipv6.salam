import net.doh

func main:
    cf := doh.Cloudflare6()
    gg := doh.Google6()
    q9 := doh.Quad96()
    println cf.addrs.get(0), cf.addrs.get(1)
    println gg.addrs.get(0), gg.addrs.get(1)
    println q9.addrs.get(0), q9.addrs.get(1)
    println cf.name, cf.host, gg.host, q9.host
    plain := doh.Cloudflare()
    both := doh.WithIPv6(plain)
    println plain.addrs.len(), both.addrs.len(), both.addrs.get(0), both.addrs.get(2)
    println doh.WithIPv6(doh.Google()).addrs.get(2), doh.WithIPv6(doh.Quad9()).addrs.get(2)
    println doh.WithIPv6(doh.CloudflareDoT()).addrs.len(), doh.WithIPv6(doh.NewPlain("lan", "192.0.2.1")).addrs.len()
end
