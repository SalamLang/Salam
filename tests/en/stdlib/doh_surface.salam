import mem
import compress
import net.dns
import net.doh
import net.udp
import sync

mut udp_port := 0
mut ready := sync.NewWaitGroup()

func udp_server():
    s := udp.Bind(0)
    udp_port = udp.Port(s)
    sync.Done(ready)
    buf := mem.Allocate(2048 as u64)
    mut fh := ""
    mut fp := 0
    until true:
        n := udp.ReceiveBytes(s, buf, 2048, fh, fp)
        if n >= 12:
            q := dns.Decode(buf, n)
            qn := q.questions.items.Get(0)
            mut recs := Vector {} as Vector<dns.Record>
            recs.Push(dns.Record { name = qn.name, rtype = dns.TypeA, rclass = 1, ttl = 100, data = "10.4.4.4" })
            mut out := doh.EncodeResponse(q.id, qn.name, qn.qtype, 0, recs)
            recs.Free()
            _x := udp.SendBytes(s, fh, fp, out.data, out.len)
            compress.BufFree(out)
        end
    end
end

func main:
    sync.Add(ready, 1 as i64)
    _t := spawn(udp_server)
    sync.Wait(ready)

    mut ip4 := compress.NewByteBuf()
    println doh.ParseIPv4("1.2.3.4", ip4), ip4.len
    mut ip6 := compress.NewByteBuf()
    println doh.ParseIPv6("2001:db8::1", ip6), ip6.len

    mut s := doh.Cloudflare()
    s = doh.WithBootstrap(s, "9.9.9.10")
    println s.addrs.Len()
    println doh.GoogleDoT().host, doh.Quad9DoT().host
    mut sh := doh.Shecan()
    mut s4 := doh.Server403()
    mut el := doh.Electro()
    mut rd := doh.Radar()
    println sh.Len(), s4.Len(), el.Len(), rd.Len()
    println sh.Get(0).addrs.Get(0), s4.Get(0).addrs.Get(0), el.Get(0).addrs.Get(0), rd.Get(0).addrs.Get(0)
    doh.FreeServers(sh)
    doh.FreeServers(s4)
    doh.FreeServers(el)
    doh.FreeServers(rd)

    mut plain := doh.NewPlain("local", "127.0.0.1")
    plain.port = udp_port
    mut r := doh.QueryAddr(plain, "127.0.0.1", "q.test", dns.TypeA, 2000)
    println r.ok, r.msg.answers.items.Get(0).data
    doh.FreeResponse(r)

    mut one := Vector {} as Vector<doh.Server>
    one.Push(plain)
    rs := doh.NewResolver(one)
    mut boot := Vector {} as Vector<doh.Server>
    boot.Push(plain)
    doh.SetBootstrap(rs, boot)
    doh.SetTTLLimits(rs, 20, 3600, 5)
    mut a := doh.Resolve(rs, "r.test", dns.TypeA)
    println a.ok, a.cached
    doh.FreeAnswer(a)
end
