import mem
import net.dns
import net.doh
import net.udp
import sync

mut mode := 0
mut ports := Vector {} as Vector<int>
mut ready := sync.NewWaitGroup()
mut server_port := 0

func send_copy(s: udp.Socket, host: str, port: int, src: void*, n: int, patch_at: int, patch_to: int):
    out := mem.Allocate(n as u64)
    mem.Copy(out, src, n as u64)
    p := out as u8*
    p[2] = ((p[2] as int) | 128) as u8
    if patch_at >= 0:
        p[patch_at] = patch_to as u8
    end
    udp.SendBytes(s, host, port, out, n)
    mem.Free(out)
end

func dns_server():
    s := udp.Bind(0)
    server_port = udp.Port(s)
    other := udp.Bind(0)
    sync.Done(ready)
    buf := mem.Allocate(1024 as u64)
    until true:
        mut fh := ""
        mut fp := 0
        n := udp.ReceiveBytes(s, buf, 1024, fh, fp)
        if n < 17: continue end
        ports.push(fp)
        b := buf as u8*
        if mode == 1:
            send_copy(s, fh, fp, buf, n, 1, ((b[1] as int) + 1) & 255)
        else mode == 2:
            send_copy(s, fh, fp, buf, n, 13, 122)
        else mode == 3:
            send_copy(s, fh, fp, buf, n, n - 3, 28)
        else mode == 4:
            send_copy(s, fh, fp, buf, n, 5, 0)
        else mode == 5:
            send_copy(other, fh, fp, buf, n, 1, ((b[1] as int) + 1) & 255)
            send_copy(other, fh, fp, buf, n, 0 - 1, 0)
        else mode == 7:
            send_copy(s, fh, fp, buf, n, 13, 122)
        else mode == 8:
            send_copy(s, fh, fp, buf, n, n - 3, 28)
        else mode == 9:
            send_copy(s, fh, fp, buf, n, 5, 0)
        else mode == 10:
            send_copy(s, fh, fp, buf, n, 1, ((b[1] as int) + 1) & 255)
        else mode == 6:
            send_copy(s, fh, fp, buf, n, 13, (b[13] as int) - 32)
            continue
        end
        if mode < 6:
            send_copy(s, fh, fp, buf, n, 0 - 1, 0)
        end
    end
end

func probe(label: str, srv: doh.Server, name: str, kind: int): bool:
    r := doh.Query(srv, name, kind, 1500)
    println label, r.ok, r.err
    ret r.ok
end

func main:
    sync.Add(ready, 1 as i64)
    _t := spawn(dns_server)
    sync.Wait(ready)
    mut srv := doh.NewPlain("mock", "127.0.0.1")
    srv.port = server_port

    mode = 0
    probe("honest reply", srv, "plain.test", dns.TypeA)
    mode = 1
    probe("a forged id first, then the real reply", srv, "idforge.test", dns.TypeA)
    mode = 2
    probe("a reply for another name first", srv, "namecheck.test", dns.TypeA)
    mode = 3
    probe("a reply for another type first", srv, "typecheck.test", dns.TypeA)
    mode = 4
    probe("a reply with no question first", srv, "noq.test", dns.TypeA)
    mode = 5
    probe("forged replies from another source port first", srv, "port.test", dns.TypeA)
    mode = 6
    probe("a reply with the name in upper case is accepted", srv, "case.test", dns.TypeA)
    mode = 7
    probe("only a reply for another name", srv, "onlyname.test", dns.TypeA)
    mode = 8
    probe("only a reply for another type", srv, "onlytype.test", dns.TypeA)
    mode = 9
    probe("only a reply with no question", srv, "onlynoq.test", dns.TypeA)
    mode = 10
    probe("only a reply with the wrong id", srv, "onlyid.test", dns.TypeA)
    mode = 0
    ports = Vector {} as Vector<int>
    repeat 12 in i:
        mode = 0
        doh.Query(srv, "p" + i + ".test", dns.TypeA, 1500)
    end
    mut seen := HashMap {} as HashMap<str, bool>
    mut high := true
    repeat ports.Len() in i:
        seen.put("" + ports[i], true)
        if ports[i] < 20000: high = false end
    end
    println "source ports are spread:", seen.size() >= 8, "and in the high range:", high
end
