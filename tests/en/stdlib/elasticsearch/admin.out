put pipeline: true
   PUT /_ingest/pipeline/clean
  body: {"processors":[{"lowercase":{"field":"tag"}}]}
get pipeline: {"clean":{"processors":[]}}
simulate: {"docs":[{"doc":{"_source":{"tag":"loud"}}}]}
   POST /_ingest/pipeline/clean/_simulate
  body: {"docs":[{"_source":{"tag":"LOUD"}}]}
delete pipeline: true
   DELETE /_ingest/pipeline/clean
create stream: true
   PUT /_data_stream/logs-web
stream: {"data_streams":[{"name":"logs-web","generation":2}]}
rollover: true
   POST /logs-web/_rollover
  body: {"conditions":{"max_age":"7d"}}
delete stream: true
   DELETE /_data_stream/logs-web
put policy: true
   PUT /_ilm/policy/month
  body: {"policy":{"phases":{"delete":{"min_age":"30d","actions":{"delete":{}}}}}}
get policy: {"month":{"policy":{}}}
delete policy: true
   DELETE /_ilm/policy/month
repository: true
   PUT /_snapshot/backups
  body: {"type":"fs","settings":{"location":"/mnt/backups"}}
snapshot: true
   PUT /_snapshot/backups/nightly?wait_for_completion=true
  body: {"indices":"books"}
snapshots: ["weekly", "nightly"]
restore: true
   POST /_snapshot/backups/nightly/_restore?wait_for_completion=true
  body: {"indices":"books","rename_pattern":"(.+)","rename_replacement":"restored-$1"}
delete snapshot: true
   DELETE /_snapshot/backups/nightly
delete repository: true
   DELETE /_snapshot/backups
cluster settings: true
   PUT /_cluster/settings
  body: {"persistent":{"indices.recovery.max_bytes_per_sec":"100mb"}}
settings: {"persistent":{"indices.recovery.max_bytes_per_sec":"100mb"},"transient":{}}
task id: node-1:42
   POST /books/_update_by_query?wait_for_completion=false
  body: {"query": {"match_all": {}}, "script": {"source": "ctx._source.views = 0", "lang": "painless"}}
task: node-1:42 true indices:data/write/update/byquery {"updated":120}
start delete: node-1:43
   POST /books/_delete_by_query?wait_for_completion=false
  body: {"query": {"term": {"status": "draft"}}}
cancel: true
   POST /_tasks/node-1:43/_cancel
start reindex: node-1:44
   POST /_reindex?wait_for_completion=false
  body: {"source":{"index":"books"},"dest":{"index":"books_v2"}}
template: true
   PUT /_scripts/by_author
  body: {"script": {"lang": "mustache", "source": {"query":{"term":{"author":"{{author}}"}},"size":"{{size}}"}}}
painless: true
   PUT /_scripts/bump
  body: {"script": {"lang": "painless", "source": "ctx._source.views += 1"}}
template search: 50
   POST /books/_search/template
  body: {"id": "by_author", "params": {"author":"saadi","size":5}}
delete script: true
   DELETE /_scripts/bump
async: true AS-1 true true 10
   POST /books/_async_search?keep_on_completion=true&wait_for_completion_timeout=1s
  body: {"query": {"match_all": {}}, "size": 1}
async done: false false 120 1
async delete: true
   DELETE /_async_search/AS-1
validate: true
   POST /books/_validate/query
  body: {"query": {"match": {"title": "kings"}}}
explain: {"matched":true,"explanation":{"value":1.2}}
   POST /books/_explain/1
  body: {"query": {"match": {"title": "kings"}}}
field caps: {"indices":["books"],"fields":{"title":{"text":{"type":"text"}}}}
   GET /books/_field_caps?fields=title,year
