import db.elasticsearch

func pair(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    ret v
end

func one(a: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    ret v
end

func main:
    println "match all:", elasticsearch.MatchAll()
    println "match none:", elasticsearch.MatchNone()
    println "match:", elasticsearch.Match("title", "persian poetry")
    println "match and:", elasticsearch.MatchAnd("title", "persian poetry")
    println "match fuzzy:", elasticsearch.MatchFuzzy("title", "shahname")
    println "phrase:", elasticsearch.MatchPhrase("title", "book of kings")
    println "phrase prefix:", elasticsearch.MatchPhrasePrefix("title", "book of k")
    println "multi match:", elasticsearch.MultiMatch("ferdowsi", pair("title^3", "body"))
    println "term:", elasticsearch.Term("status", "published")
    println "term int:", elasticsearch.TermInt("year", 1010 as i64)
    println "term bool:", elasticsearch.TermBool("in_stock", true)
    println "terms:", elasticsearch.Terms("tags", pair("epic", "classic"))
    println "range:", elasticsearch.Range("year", "900", "1500")
    println "open range:", elasticsearch.Range("price", "", "20")
    println "exclusive:", elasticsearch.RangeExclusive("published", "now-1y", "now")
    println "exists:", elasticsearch.FieldExists("isbn")
    println "prefix:", elasticsearch.Prefix("author", "ferd")
    println "wildcard:", elasticsearch.Wildcard("author", "f*si")
    println "regexp:", elasticsearch.Regexp("isbn", "97[89].*")
    println "fuzzy:", elasticsearch.Fuzzy("author", "ferdosi")
    println "ids:", elasticsearch.Ids(pair("1", "2"))
    println "query string:", elasticsearch.QueryString("title:(epic OR poem) AND year:[900 TO 1500]")
    println "simple:", elasticsearch.SimpleQueryString("epic +persian", one("title"))
    must := one(elasticsearch.Match("title", "poem"))
    filter := one(elasticsearch.Range("year", "900", ""))
    should := pair(elasticsearch.Term("tags", "epic"), elasticsearch.Term("tags", "lyric"))
    must_not := one(elasticsearch.Term("status", "draft"))
    println "bool:", elasticsearch.Bool(must, filter, should, must_not)
    println "should only:", elasticsearch.Bool(Vector {} as Vector<str>, Vector {} as Vector<str>, should, Vector {} as Vector<str>)
    println "and:", elasticsearch.And(must)
    println "or:", elasticsearch.Or(should)
    println "not:", elasticsearch.Not(elasticsearch.Term("status", "draft"))
    println "filtered:", elasticsearch.Filtered(elasticsearch.Match("title", "poem"), filter)
    println "constant score:", elasticsearch.ConstantScore(elasticsearch.Term("status", "published"))
    println "nested:", elasticsearch.Nested("reviews", elasticsearch.Range("reviews.stars", "4", ""))
    println "geo:", elasticsearch.GeoDistance("store", 35.6892, 51.389, "5km")
    mut vec := Vector {} as Vector<f64>
    vec.push(0.12)
    vec.push(-0.5)
    vec.push(0.75)
    println "knn:", elasticsearch.Knn("embedding", vec, 10, 100)
    println "sort:", elasticsearch.SortAsc("year"), elasticsearch.SortDesc("_score")
    println "highlight:", elasticsearch.Highlight(pair("title", "body"))
    println "add member:", elasticsearch.AddMember(elasticsearch.Match("title", "poem"), "boost", "2")
end
