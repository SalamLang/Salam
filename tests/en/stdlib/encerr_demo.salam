package main

import encoding.encerr
import testing
import os

func main:
    ok := encerr.NoError()
    testing.AssertEqInt(ok.kind, encerr.KindNone)
    testing.AssertFalse(encerr.IsError(ok))

    e1 := encerr.ErrUnexpectedEOF(12)
    testing.AssertEqInt(e1.kind, encerr.KindUnexpectedEOF)
    testing.AssertEqInt(e1.position, 12)
    testing.AssertTrue(encerr.IsError(e1))

    e2 := encerr.ErrUnexpectedToken("expected ','", 4)
    testing.AssertEqInt(e2.kind, encerr.KindUnexpectedToken)
    testing.AssertEqStr(e2.message, "expected ','")
    testing.AssertEqInt(e2.position, 4)
    testing.AssertTrue(encerr.IsError(e2))

    e3 := encerr.ErrTypeMismatch("string", 7)
    testing.AssertEqInt(e3.kind, encerr.KindTypeMismatch)
    testing.AssertEqStr(e3.message, "expected string")
    testing.AssertTrue(encerr.IsError(e3))

    e4 := encerr.NewError(encerr.KindCustom, "custom failure", 0 - 1)
    testing.AssertEqInt(e4.kind, encerr.KindCustom)
    testing.AssertEqStr(e4.message, "custom failure")
    testing.AssertEqInt(e4.position, 0 - 1)
    testing.AssertTrue(encerr.IsError(e4))

    os.Exit(testing.Summary())
end
