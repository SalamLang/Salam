package main

import compress
import encoding

func main:
    text := "salam"
    println encoding.Base64EncodeBytes(text as void*, text.len())
    println encoding.Base64EncodeBytes(text as void*, 3)
    println encoding.Base64EncodeBytes(text as void*, 0) == ""
    b := compress.BufFromStr("any bytes")
    println encoding.Base64EncodeBytes(b.data, b.len), encoding.Base64Decode(encoding.Base64EncodeBytes(b.data, b.len))
end
