package main

import compress
import encoding

func main:
    text := "salam"
    println encoding.Base64EncodeBytes(text as void*, text.Len())
    println encoding.Base64EncodeBytes(text as void*, 3)
    println encoding.Base64EncodeBytes(text as void*, 0) == ""
    b := compress.BufFromStr("any bytes")
    try:
        println encoding.Base64EncodeBytes(b.data, b.len),
            encoding.Base64Decode(encoding.Base64EncodeBytes(b.data, b.len))
    catch e:
        println e.ToStr()
    end
end
