package main

import encoding
import mem

func show(label: str, e: Error):
    println label + ": " + e.kind_name() + " | " + e.to_str() + " [offset " + e.offset + "]"
end

func base64(label: str, text: str):
    try:
        println label + ": ok [" + encoding.Base64Decode(text) + "]"
    catch e:
        show(label, e)
    end
end

func hex(label: str, text: str):
    try:
        println label + ": ok [" + encoding.HexDecode(text) + "]"
    catch e:
        show(label, e)
    end
end

func percent(label: str, text: str):
    try:
        println label + ": ok [" + encoding.URLDecode(text) + "]"
    catch e:
        show(label, e)
    end
end

func base64_errors():
    println "== Base64Decode =="
    base64("padded", "U2FsYW0h")
    base64("one '='", "U2FsYW0=")
    base64("no padding", "U2FsYW0")
    base64("line breaks", "U2Fs\r\nYW0h")
    base64("url-safe alphabet", "Pj4-Pz8_")
    base64("empty", "")
    base64("bad character", "U2Fs*W0h")
    base64("non-ASCII byte", "U2Fsسلام")
    base64("data after padding", "U2E=U2E=")
    base64("one character too many", "U2FsY")
    base64("padding in a full group", "U2Fs=")
    base64("missing padding", "Zg=")
    base64("too much padding", "Zm8==")
    base64("bad character on line 2", "U2Fs\nYW0!")
end

func base64_bytes_errors():
    println ""
    println "== Base64DecodeBytes =="
    buf := mem.AllocateZeroed(8 as u64)
    defer mem.Free(buf)
    try:
        n := encoding.Base64DecodeBytes("AAEC", buf, 8)
        println "fits: ok " + n + " bytes, first " + ((buf as u8*)[2] as int)
    catch e:
        show("fits", e)
    end
    try:
        _ := encoding.Base64DecodeBytes("U2FsYW0hIQ==", buf, 4)
    catch e:
        show("buffer too small", e)
    end
    try:
        _ := encoding.Base64DecodeBytes("AA*C", buf, 8)
    catch e:
        show("bad character", e)
    end
end

func hex_errors():
    println ""
    println "== HexDecode =="
    hex("lower case", "73616c616d")
    hex("upper case", "53414C414D")
    hex("odd length", "73616c616")
    hex("bad digit", "7361zz")
    hex("bad second digit", "736g")
    hex("space", "73 61")
end

func percent_errors():
    println ""
    println "== URLDecode =="
    percent("escapes and plus", "a%20b+c%2Fd")
    percent("cut short", "100%")
    percent("one digit left", "tea%2")
    percent("not hex", "a%zzb")
    percent("half hex", "a%4gb")
    try:
        mut total := 0
        each part in ["a%20b", "c+d", "50%25"]:
            total += encoding.URLDecode(part).len()
        end
        println "loop over good parts: " + total + " bytes"
    catch e:
        show("loop", e)
    end
end

func fallbacks():
    println ""
    println "== fallbacks =="
    n := try encoding.HexDecode("zz").len() catch 0 - 1
    println "length with a fallback: " + n
    b := mem.AllocateZeroed(4 as u64)
    got := try encoding.Base64DecodeBytes("AAAAAAAA", b, 4) catch 0
    println "bytes with a fallback: " + got
    mem.Free(b)
end

func main:
    base64_errors()
    base64_bytes_errors()
    hex_errors()
    percent_errors()
    fallbacks()
end
