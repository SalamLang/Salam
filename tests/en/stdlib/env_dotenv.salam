package main

import env
import fs.path
import io
import os

func main:
    p := path.Join(os.TempDir(), "salam_env_dotenv_api.env")
    os.Remove(p)
    io.WriteFile(p, "SALAM_DOTENV_A=first\nSALAM_DOTENV_B=second\n")
    env.Unset("SALAM_DOTENV_A")
    env.Set("SALAM_DOTENV_B", "preset")
    println "loaded: ", env.LoadDotEnv(p)
    println "A: ", env.Get("SALAM_DOTENV_A")
    println "B overridden: ", env.Get("SALAM_DOTENV_B")
    println "missing file: ", env.LoadDotEnv(path.Join(os.TempDir(), "salam_env_dotenv_missing.env"))
    os.Remove(p)
    env.Unset("SALAM_DOTENV_A")
    env.Unset("SALAM_DOTENV_B")
end
