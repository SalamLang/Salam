package main

import encoding.envfile

func strict(text: str):
    try:
        mut d := envfile.ParseStrict(text)
        println false, envfile.Len(d), envfile.Get(d, "B"), envfile.Get(d, "C")
        envfile.Free(d)
    catch e:
        println true, e.is(ErrorKind.Syntax), e.message, e.line
    end
end

func main:
    strict("A=1\nB=two\nC=\"three words\"\n")
    strict("A=1\nthis is not a pair\nB=2\n")
    strict("A=\"open\nB=2\n")
    mut lax := envfile.Parse("A=1\nthis is not a pair\nB=2\n")
    println envfile.Len(lax), envfile.Valid("A=1\nB=2\n"), envfile.Valid("A=1\nnope\n")
    envfile.Free(lax)
end
