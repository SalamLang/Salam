package main

import encoding.envfile

func main:
    try:
        mut good := envfile.ParseStrict("A=1\nB=two\nC=\"three words\"\n")
        println envfile.Len(good), envfile.Get(good, "B"), envfile.Get(good, "C")
        envfile.Free(good)
    catch e:
        println e.to_str()
    end
    try:
        mut bad := envfile.ParseStrict("A=1\nthis is not a pair\nB=2\n")
        println envfile.Len(bad)
        envfile.Free(bad)
    catch e:
        println e.is(ErrorKind.Syntax), e.message, e.offset, e.line, e.column
        println e.to_str()
    end
    try:
        mut open := envfile.ParseStrict("A=\"open\nB=2\n")
        println envfile.Len(open)
        envfile.Free(open)
    catch e:
        println e.kind_name(), e.message
    end
    mut lax := envfile.Parse("A=1\nthis is not a pair\nB=2\n")
    println envfile.Len(lax), envfile.Valid("A=1\nB=2\n"), envfile.Valid("A=1\nnope\n")
    envfile.Free(lax)
end
