package main

import encoding.encerr
import encoding.envfile

func main:
    mut err := encerr.NoError()
    good := envfile.ParseStrict("A=1\nB=two\nC=\"three words\"\n", err)
    println encerr.IsError(err), envfile.Len(good), envfile.Get(good, "B"), envfile.Get(good, "C")
    envfile.Free(good)
    bad := envfile.ParseStrict("A=1\nthis is not a pair\nB=2\n", err)
    println encerr.IsError(err), err.kind == encerr.KindUnexpectedToken, err.message, err.position
    envfile.Free(bad)
    open := envfile.ParseStrict("A=\"open\nB=2\n", err)
    println encerr.IsError(err), err.message
    envfile.Free(open)
    mut lax := envfile.Parse("A=1\nthis is not a pair\nB=2\n")
    println envfile.Len(lax), envfile.Valid("A=1\nB=2\n"), envfile.Valid("A=1\nnope\n")
    envfile.Free(lax)
end
