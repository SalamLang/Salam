package main

import error

func main:
    timeout := Error.New(ErrorKind.Timeout, "slow upstream")
    down := Error.New(ErrorKind.Unavailable, "service down")
    disk := Error.New(ErrorKind.Io, "disk hiccup")
    missing := Error.New(ErrorKind.NotFound, "no such key")

    println "timeout retryable: ", error.IsRetryable(timeout)
    println "unavailable retryable: ", error.IsRetryable(down)
    println "io retryable: ", error.IsRetryable(disk)
    println "not found retryable: ", error.IsRetryable(missing)

    policy := error.NewRetryPolicy(3, 100, 1000)
    println "retry attempt 1: ", error.ShouldRetry(policy, timeout, 1)
    println "retry attempt 2: ", error.ShouldRetry(policy, down, 2)
    println "retry attempt 3: ", error.ShouldRetry(policy, timeout, 3)
    println "never retry: ", error.ShouldRetry(policy, missing, 1)
end
