package main

import events

mut hits := 0

func main:
    e := events.New() as events.Emitter<int>
    mut ids := Vector {} as Vector<int>
    repeat 100:
        ids.push(events.On(e, "x", (ev: events.Event<int>): hits += ev.data end))
    end
    println "len", events.Len(e)
    println "calls", events.Emit(e, "x", 1)
    println "hits", hits
    println "off", events.Off(e, ids.get(50))
    println "calls", events.Emit(e, "x", 1)
    println "hits", hits
    ids.free()
    events.Free(e)
    ret 0
end
