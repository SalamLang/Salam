package main

import excel
import archive
import compress
import os
import str

// Filter buttons on a header row: <autoFilter> in the sheet, the hidden
// _xlnm._FilterDatabase name in the workbook, and the range read back; a
// wrapped two-line cell with its leading space kept; an empty cell keeps its style.
func main:
    mut book := excel.NewWorkbook()
    sh := book.add_sheet("O'Brien")
    repeat 3 in i:
        sh[0].set_string(0, i, ["id", "name", "price"][i])
        sh[0].set_int(1, i, i as i64)
    end
    sh[0].set_auto_filter(0, 0, 2, 2)
    wrapped := book.styles.get_or_add(excel.Style { wrap = true })
    sh[0].set_string(2, 0, " two\nlines")
    sh[0].set_style(2, 0, wrapped)
    sh[0].set_style(2, 1, wrapped)
    book.add_sheet("Plain")
    path := os.TempDir().concat("/salam_excel_autofilter_demo.xlsx")
    println "saved: ", excel.WriteXLSX(book, path)
    book.free()
    mut ok := false
    mut data := archive.ReadBinaryFile(path, ok)
    defer compress.BufFree(data)
    mut ok2 := false
    mut sb := archive.ZipExtractByName(data.data, data.len, "xl/worksheets/sheet1.xml", ok2)
    defer compress.BufFree(sb)
    mut wb := archive.ZipExtractByName(data.data, data.len, "xl/workbook.xml", ok2)
    defer compress.BufFree(wb)
    compress.BufPush(sb, 0)
    compress.BufPush(wb, 0)
    sheet := sb.data as str
    workbook := wb.data as str
    println "filter: ", str.Contains(sheet, `</sheetData><autoFilter ref="A1:C3"/>`)
    println "name: ", str.Contains(workbook, `<definedName name="_xlnm._FilterDatabase" localSheetId="0" hidden="1">&apos;O&apos;&apos;Brien&apos;!$A$1:$C$3</definedName>`)
    println "styled empty cell: ", str.Contains(sheet, `<c r="B3" s="`)
    println "one name: ", not str.Contains(workbook, `localSheetId="1"`)
    mut rok := false
    mut rerr := ""
    mut back := excel.Open(path, rok, rerr)
    println "read back: ", rok
    println "first: ".concat(back.sheet_at(0)[0].auto_filter).concat(", second: [").concat(back.sheet_at(1)[0].auto_filter).concat("]")
    cell := back.sheet_at(0)[0].get_cell(2, 0)
    println "text kept: ", cell.text == " two\nlines"
    println "wrap: ", back.styles.get(cell.style_id).wrap
    back.free()

    entries := archive.ZipList(data.data, data.len)
    mut inputs := Vector {} as Vector<archive.ZipFileInput>
    mut parts := Vector {} as Vector<compress.ByteBuf>
    each e in entries:
        mut eok := false
        mut part := archive.ZipExtractByName(data.data, data.len, e.name, eok)
        if e.name == "xl/styles.xml":
            compress.BufPush(part, 0)
            text := str.Replace(part.data as str, `wrapText="1"`, `wrapText="true"`)
            compress.BufFree(part)
            part = compress.NewByteBuf()
            compress.BufPushBytes(part, text as void*, text.len())
        end
        inputs.push(archive.ZipFileInput { name = e.name, data_ptr = part.data, data_len = part.len })
        parts.push(part)
    end
    path2 := os.TempDir().concat("/salam_excel_autofilter_true.xlsx")
    println "rewritten: ", archive.ZipCreateFile(inputs, path2)
    each part in parts: compress.BufFree(part) end
    mut tok := false
    mut terr := ""
    mut again := excel.Open(path2, tok, terr)
    tcell := again.sheet_at(0)[0].get_cell(2, 0)
    println "wrapText true: ", again.styles.get(tcell.style_id).wrap
    again.free()
    os.Remove(path2)

    mut book2 := excel.NewWorkbook()
    s2 := book2.add_sheet("S")
    s2[0].set_string(0, 0, "x")
    s2[0].auto_filter = "$A$1:$B$2"
    path3 := os.TempDir().concat("/salam_excel_autofilter_abs.xlsx")
    println "saved absolute: ", excel.WriteXLSX(book2, path3)
    book2.free()
    mut aok := false
    mut adata := archive.ReadBinaryFile(path3, aok)
    defer compress.BufFree(adata)
    mut wb2 := archive.ZipExtractByName(adata.data, adata.len, "xl/workbook.xml", aok)
    defer compress.BufFree(wb2)
    compress.BufPush(wb2, 0)
    workbook2 := wb2.data as str
    println "absolute range kept: ", str.Contains(workbook2, "!$A$1:$B$2</definedName>"), not str.Contains(workbook2, "$$")
    os.Remove(path3)
    os.Remove(path)
end
