package main

import excel
import filepath
import os

func main:
    dir := filepath.Join(os.TempDir(), "salam_excel_direct")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    mut book := excel.NewWorkbook()
    s := book.add_sheet("Totals")
    s.set_string(0, 0, "item")
    s.set_string(0, 1, "qty")
    s.set_string(1, 0, "tea")
    s.set_number(1, 1, 12.5)
    s.set_bool(2, 0, true)
    s.set_formula(2, 1, "B2*2", 25.0)
    book.add_sheet("Empty")

    ods := filepath.Join(dir, "direct.ods")
    xlsx := filepath.Join(dir, "direct.xlsx")
    println excel.WriteODS(book, ods), excel.WriteXLSX(book, xlsx)

    mut ok := false
    mut err := ""
    mut a := excel.ReadODS(ods, ok, err)
    println ok, a.sheet_count(), a.sheet_at(0).name, a.sheet_at(1).name
    t := a.sheet("Totals")
    println t.get_string(0, 0), t.get_string(1, 0), t.get_number(1, 1), t.get_bool(2, 0), t.get_formula(2, 1), t.row_count(), t.col_count()

    mut b := excel.ReadXLSX(xlsx, ok, err)
    println ok, b.sheet_count(), b.sheet_at(0).name
    u := b.sheet("Totals")
    println u.get_string(0, 1), u.get_string(1, 0), u.get_number(1, 1), u.get_bool(2, 0), u.get_formula(2, 1)

    missing := filepath.Join(dir, "none.ods")
    _ := excel.ReadODS(missing, ok, err)
    println ok, err != ""
    _ := excel.ReadXLSX(missing, ok, err)
    println ok, err != ""
    _ := excel.ReadXLSX(ods, ok, err)
    println ok
    _ := excel.ReadODS(xlsx, ok, err)
    println ok

    a.free()
    b.free()
    book.free()
    os.RemoveAll(dir)
end
