package main

import excel
import archive
import compress
import os
import str

// Sheet view (right-to-left, frozen header), column widths and borders in the
// written XLSX.
func main:
    mut book := excel.NewWorkbook()
    sh := book.add_sheet("Report")
    sh[0].rtl = true
    sh[0].set_string(0, 0, "Title")
    sh[0].merge_cells(0, 0, 0, 2)
    head := book.styles.get_or_add(excel.Style { bold = true, border = true, bg_color = "D9E1F2" })
    repeat 3 in i:
        sh[0].set_string(1, i, ["id", "a long customer name", "price"][i])
        sh[0].set_style(1, i, head)
    end
    sh[0].set_int(2, 0, 7 as i64)
    sh[0].auto_fit()
    sh[0].freeze(2, 0)
    path := os.TempDir().concat("/salam_excel_layout_demo.xlsx")
    println "saved: ", excel.WriteXLSX(book, path)
    book.free()
    mut ok := false
    mut data := archive.ReadBinaryFile(path, ok)
    defer compress.BufFree(data)
    println "opened: ", ok
    mut ok2 := false
    mut sb := archive.ZipExtractByName(data.data, data.len, "xl/worksheets/sheet1.xml", ok2)
    defer compress.BufFree(sb)
    mut stb := archive.ZipExtractByName(data.data, data.len, "xl/styles.xml", ok2)
    defer compress.BufFree(stb)
    compress.BufPush(sb, 0)
    compress.BufPush(stb, 0)
    sheet := sb.data as str
    styles := stb.data as str
    println "rtl: ", str.Contains(sheet, `rightToLeft="1"`)
    println "frozen: ", str.Contains(sheet, `ySplit="2" topLeftCell="A3"`)
    println "widths: ", str.Contains(sheet, `<col min="2" max="2" width="26" customWidth="1"/>`)
    println "border style: ", str.Contains(styles, `<left style="thin">`)
    println "header uses border: ", str.Contains(styles, `borderId="1"`)
    os.Remove(path)
end
