package main

import archive
import compress
import excel
import testing

const PATH := "tests/fixtures/excel/sample.xls"

func main(): int:
    mut file_ok := false
    mut file := archive.ReadBinaryFile(PATH, file_ok)
    testing.AssertTrue(file_ok)
    testing.AssertTrue(excel.IsXLS(file.data, file.len))
    testing.AssertEqInt(excel.DetectFormat(PATH), excel.FormatXLS)
    compress.BufFree(file)

    mut ok := false
    mut err := ""
    mut book := excel.Open(PATH, ok, err)
    testing.AssertTrue(ok)
    testing.AssertEqStr(err, "")
    testing.AssertEqInt(book.sheet_count(), 2)
    testing.AssertEqStr(book.sheets.get(0).name, "Data")
    testing.AssertEqStr(book.sheets.get(1).name, "Second")

    data := book.sheets.get(0)
    testing.AssertEqStr(data.get_string(0, 0), "Hello")
    testing.AssertEqFloat(data.get_number(0, 1), 42.0, 0.0001)
    testing.AssertEqFloat(data.get_number(0, 2), 3.5, 0.0001)
    testing.AssertTrue(data.get_bool(0, 3))
    testing.AssertEqInt(data.get_cell(0, 5).kind, excel.CellDate)
    testing.AssertEqStr(data.get_string(0, 5), "2020-01-02")
    testing.AssertEqStr(data.get_string(1, 0), "سلام")
    testing.AssertEqFloat(data.get_number(1, 1), 0.0 - 7.0, 0.0001)
    testing.AssertEqInt(data.get_string(1, 2).char_count(), 300)
    testing.AssertTrue(data.is_merged(2, 1))
    testing.AssertEqStr(data.get_string(2, 0), "merged")

    testing.AssertEqFloat(book.sheets.get(1).get_number(0, 0), 7.0, 0.0001)

    mut bad_ok := true
    mut bad_err := ""
    mut missing := excel.ReadXLS("tests/fixtures/excel/missing.xls", bad_ok, bad_err)
    testing.AssertFalse(bad_ok)
    testing.AssertTrue(bad_err.len() > 0)
    testing.AssertEqInt(missing.sheet_count(), 0)

    ret testing.Summary()
end
