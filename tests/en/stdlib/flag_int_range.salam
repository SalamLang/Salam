import flag

func attempt(args: Vector<str>):
    mut fs := flag.New("tool", "")
    flag.AddInt(fs, "port", "p", 8080, "port")
    ok := flag.Parse(fs, args)
    println ok, "[" + flag.Error(fs) + "]", flag.GetInt(fs, "port")
    flag.Free(fs)
end

func main:
    each case in [
        "--port=9223372036854775807", "--port=9223372036854775808", "--port=99999999999999999999",
        "--port=-9223372036854775808", "--port=-9223372036854775809", "--port=+5", "--port=12abc"
    ]:
        v := case.Split(" ")
        attempt(v)
        v.Free()
    end
end
