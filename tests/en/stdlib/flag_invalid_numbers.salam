import flag

func try(args: Vector<str>):
    mut fs := flag.New("tool", "")
    flag.AddInt(fs, "port", "p", 8080, "port")
    flag.AddFloat(fs, "ratio", "r", 1.0, "ratio")
    ok := flag.Parse(fs, args)
    println ok, "[" + flag.Error(fs) + "]", flag.GetInt(fs, "port"), flag.GetFloat(fs, "ratio")
    flag.Free(fs)
end

func main:
    each case in ["--port=abc", "--port ۸۰", "-r 2.5e1", "--ratio=x1", "--port=-3"]:
        v := case.split(" ")
        try(v)
        v.free()
    end
end
