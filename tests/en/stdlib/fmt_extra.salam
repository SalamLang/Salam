package main

import fmt
import io
import os
import filepath
import mem

func main:
    path := filepath.Join(os.TempDir(), "salam_fmt_extra.txt")
    defer mem.Free(path as void*)

    println "formatted writes to a file"
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push("Tehran")
    args.push(fmt.Int(37 as i64))
    f := os.Open(path, "wb")
    println fmt.Fprintf(f, "{} is {} degrees\n", args)
    println fmt.Fprintf(f, "no placeholders\n", args)
    mut empty := Vector {} as Vector<str>
    defer empty.free()
    println fmt.Fprintf(f, "plain text", empty)
    io.Close(f)
    print io.ReadFile(path)
    println ""
    println "---"
    println fmt.Sprintf("{} is {} degrees", args)
    os.Remove(path)
end
