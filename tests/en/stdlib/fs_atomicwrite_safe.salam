import fs
import io
import os

func main:
    path := "_atomic_target.txt"
    decoy := path + ".tmp"
    os.Remove(path)
    io.WriteFile(decoy, "keep me")
    println fs.AtomicWrite(path, "first")
    println io.ReadFile(path)
    println fs.AtomicWrite(path, "second")
    println io.ReadFile(path)
    println io.ReadFile(decoy)
    os.Remove(path)
    os.Remove(decoy)

    dir := "_atomic_dir"
    os.Mkdir(dir)
    println fs.AtomicWrite(dir, "data") < 0
    names := os.ListDir(".")
    mut leftovers := 0
    repeat names.Len() in i:
        n := names.Get(i)
        if n.StartsWith("_atomic_dir.") and n.EndsWith(".tmp"): leftovers++ end
    end
    println leftovers
    os.Remove(dir)
end
