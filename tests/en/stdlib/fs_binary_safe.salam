package main

import testing
import fs
import fs.path
import os
import os.error
import crypto

func main:
    p := path.Join(os.TempDir(), "salam_fs_binary_safe_en.bin")
    t := path.Join(os.TempDir(), "salam_fs_binary_safe_en.txt")
    e := path.Join(os.TempDir(), "salam_fs_binary_safe_en.empty")
    missing := path.Join(os.TempDir(), "salam_fs_binary_safe_en_missing.bin")
    os.Remove(missing)

    mut data := Vector {} as Vector<u8>
    defer data.Free()
    repeat 1000 in i:
        data.Push(((i * 7) % 256) as u8)
    end
    testing.AssertEqInt(fs.WriteAllBytes(p, data), 1000)
    testing.AssertEqInt64(fs.Size(p), 1000 as i64)

    back := fs.ReadAllBytes(p)
    defer back.Free()
    testing.AssertEqInt(back.Len(), 1000)
    mut same := true
    repeat 1000 in i:
        if back.Get(i) != data.Get(i): same = false end
    end
    testing.AssertTrue(same)

    testing.AssertEqStr(fs.Md5Hex(p), "de809ff794e91b68f9e91a2b7030bcb0")
    testing.AssertEqStr(fs.Sha1Hex(p), "38f3aa587f4aa04965a359f9151092759b3a4c2a")
    testing.AssertEqStr(
        fs.Sha256Hex(p), "89f4ff56a25dd1db06a4ce6033603775d705fb96f30f8693733fef602a1ca532"
    )
    testing.AssertEqStr(
        fs.Sha512Hex(p),
        "5c3d2be85b82f8ace3dbd4cf34e814cf68201a9f3e5730253ee42fd46fbe6db2e68ab158e76a103df431f3ad279d8fa3ff6b148e21ced56feb321a6d28d101f1"
    )

    testing.AssertTrue(fs.WriteText(t, "salam, files") >= 0)
    testing.AssertEqStr(fs.Md5Hex(t), crypto.Md5Hex("salam, files"))
    testing.AssertEqStr(fs.Sha1Hex(t), crypto.Sha1Hex("salam, files"))
    testing.AssertEqStr(fs.Sha256Hex(t), crypto.Sha256Hex("salam, files"))
    testing.AssertEqStr(fs.Sha512Hex(t), crypto.Sha512Hex("salam, files"))

    empty := Vector {} as Vector<u8>
    testing.AssertEqInt(fs.WriteAllBytes(e, empty), 0)
    testing.AssertTrue(fs.Exists(e))
    none := fs.ReadAllBytes(e)
    defer none.Free()
    testing.AssertEqInt(none.Len(), 0)
    testing.AssertEqStr(
        fs.Sha256Hex(e), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    )

    error.Clear()
    gone := fs.ReadAllBytes(missing)
    defer gone.Free()
    testing.AssertEqInt(gone.Len(), 0)
    testing.AssertTrue(error.HasError())
    testing.AssertEqInt(error.LastCode(), error.IOError)
    testing.AssertEqStr(error.LastMessage(), "read failed")
    testing.AssertEqStr(error.LastOperation(), "ReadAllBytes")
    testing.AssertEqStr(error.LastPath(), missing)
    testing.AssertEqInt(error.LastSystemCode(), 0)
    testing.AssertEqInt(error.Last().code, error.IOError)
    testing.AssertEqStr(fs.Sha256Hex(missing), "")
    testing.AssertEqStr(error.LastOperation(), "Sha256Hex")

    error.Set(error.FileNotFound, "gone", "Probe", "", 2)
    testing.AssertEqStr(error.Name(error.LastCode()), "FileNotFound")
    testing.AssertEqStr(error.Format(error.Last()), "FileNotFound: gone [op=Probe] [sys=2]")
    testing.AssertEqStr(error.DescribeLast(), "FileNotFound: gone [op=Probe] [sys=2]")
    error.Clear()
    testing.AssertFalse(error.HasError())

    if SALAM_OS_LINUX:
        proc := fs.ReadAllBytes("/proc/self/status")
        testing.AssertTrue(proc.Len() > 0)
        proc.Free()
    end

    fs.Delete(p)
    fs.Delete(t)
    fs.Delete(e)
    ret testing.Summary()
end
