package main

import testing
import fs.dir
import fs.file
import fs.path
import os.error
import os

func main:
    root := path.Join(os.TempDir(), "salam_dirtest2")
    moved := root.concat("_moved")
    copy_root := root.concat("_copy")
    dir.RemoveAll(root)
    dir.RemoveAll(moved)
    dir.RemoveAll(copy_root)

    testing.AssertEqInt(dir.MkdirAll(path.Join(root, "a/b/c")), 0)
    testing.AssertTrue(dir.Exists(root))
    testing.AssertTrue(dir.Exists(path.Join(root, "a/b/c")))
    testing.AssertFalse(dir.Exists(path.Join(os.TempDir(), "salam_no_such_dir_xyz")))
    testing.AssertFalse(dir.IsDir(path.Join(root, "a/x.txt")))

    testing.AssertEqInt(dir.Mkdir(path.Join(root, "single")), 0)
    testing.AssertTrue(dir.Exists(path.Join(root, "single")))
    testing.AssertEqInt(dir.Remove(path.Join(root, "single")), 0)
    testing.AssertFalse(dir.Exists(path.Join(root, "single")))

    error.Clear()
    testing.AssertEqInt(dir.Remove(path.Join(root, "a")), 0 - 1)
    testing.AssertTrue(error.HasError())

    file.WriteText(path.Join(root, "a/x.txt"), "12345")
    file.WriteText(path.Join(root, "a/b/y.txt"), "1234567890")

    all_entries := dir.List(root)
    testing.AssertEqInt(all_entries.len(), 1)
    testing.AssertEqStr(all_entries.get(0), "a")

    files := dir.Walk(root)
    testing.AssertEqInt(files.len(), 2)
    testing.AssertEqInt64(dir.Size(root), 15 as i64)

    dirs := dir.ListDirs(root)
    testing.AssertEqInt(dirs.len(), 1)

    lf := dir.ListFiles(path.Join(root, "a"))
    testing.AssertEqInt(lf.len(), 1)
    testing.AssertEqStr(lf.get(0), "x.txt")

    testing.AssertTrue(dir.ModTime(root) > 0)
    testing.AssertTrue(dir.Permissions(root) > 0)

    testing.AssertEqInt(dir.Copy(root, copy_root), 0)
    testing.AssertTrue(dir.Exists(copy_root))
    testing.AssertEqStr(file.ReadText(path.Join(copy_root, "a/x.txt")), "12345")
    testing.AssertEqStr(file.ReadText(path.Join(copy_root, "a/b/y.txt")), "1234567890")
    testing.AssertTrue(dir.Exists(root))

    testing.AssertEqInt(dir.Move(root, moved), 0)
    testing.AssertFalse(dir.Exists(root))
    testing.AssertTrue(dir.Exists(moved))
    testing.AssertEqStr(file.ReadText(path.Join(moved, "a/x.txt")), "12345")

    testing.AssertEqInt(dir.RemoveAll(moved), 0)
    testing.AssertFalse(dir.Exists(moved))
    testing.AssertEqInt(dir.RemoveAll(moved), 0)

    testing.AssertEqInt(dir.RemoveAll(copy_root), 0)
    testing.AssertFalse(dir.Exists(copy_root))

    os.Exit(testing.Summary())
end
