package main

import testing
import fs
import fs.file
import os

func size_of(i: fs.FileInfo): i64: ret i.size end

func found(i: file.FileInfo): bool: ret i.exists end

func main:
    dir := os.TempDir()
    p := dir + "/salam_fs_compat.txt"
    q := dir + "/salam_fs_compat_copy.txt"
    r := dir + "/salam_fs_compat_moved.txt"
    file.Delete(p)
    file.Delete(q)
    file.Delete(r)

    testing.AssertTrue(file.WriteText(p, "legacy") >= 0)
    testing.AssertEqStr(file.ReadText(p), fs.ReadText(p))
    testing.AssertEqStr(file.ReadAll(p), "legacy")
    testing.AssertEqInt(file.ReadLines(p).len(), 1)
    testing.AssertEqStr(file.ReadBytes(p, 3), "leg")
    testing.AssertTrue(file.Append(p, "!") >= 0)
    testing.AssertTrue(file.WriteBytes(q, "bytes") >= 0)
    testing.AssertEqInt(file.AtomicWrite(q, "atomic"), 0)
    f := file.Open(q, "rb")
    testing.AssertTrue(f != null)
    file.Close(f)

    testing.AssertEqInt(file.Copy(p, q), 0)
    testing.AssertTrue(file.Exists(q))
    testing.AssertEqInt(file.Move(q, r), 0)
    testing.AssertEqInt(file.Rename(r, q), 0)
    testing.AssertEqInt64(file.Size(q), 7 as i64)
    testing.AssertEqInt64(size_of(file.Stat(q)), fs.Size(q))
    testing.AssertTrue(found(fs.Stat(q)))
    testing.AssertEqInt64(file.ModTime(p), fs.ModTime(p))
    testing.AssertTrue(file.AccessedTime(p) > 0)
    testing.AssertTrue(file.CreatedTime(p) >= 0)
    testing.AssertEqInt(file.Chmod(p, 420), 0)
    testing.AssertEqInt(file.Permissions(p), fs.Permissions(p))
    testing.AssertEqStr(file.Extension(p), ".txt")
    testing.AssertEqStr(file.MimeType("x.json"), "application/json")
    testing.AssertEqStr(file.Md5Hex(p), fs.Md5Hex(p))
    testing.AssertEqStr(file.Sha1Hex(p), fs.Sha1Hex(p))
    testing.AssertEqStr(file.Sha256Hex(p), fs.Sha256Hex(p))
    testing.AssertEqStr(file.Sha512Hex(p), fs.Sha512Hex(p))
    testing.AssertEqInt(file.Delete(p), 0)
    testing.AssertEqInt(file.Delete(q), 0)
    testing.AssertFalse(fs.Exists(p))
    ret testing.Summary()
end
