package main

import testing
import fs
import fs.path
import os.error
import io
import os

func main:
    base := path.Join(os.TempDir(), "salam_filetest.txt")
    copy_path := path.Join(os.TempDir(), "salam_filetest_copy.txt")
    moved_path := path.Join(os.TempDir(), "salam_filetest_moved.txt")
    os.Remove(base)
    os.Remove(copy_path)
    os.Remove(moved_path)

    testing.AssertTrue(fs.WriteText(base, "hello salam") >= 0)
    testing.AssertEqStr(fs.ReadText(base), "hello salam")
    testing.AssertEqStr(fs.ReadAll(base), "hello salam")
    testing.AssertEqInt64(fs.Size(base), 11 as i64)
    testing.AssertTrue(fs.Exists(base))
    testing.AssertFalse(fs.Exists(path.Join(os.TempDir(), "salam_no_such_file.txt")))
    testing.AssertEqStr(fs.Extension(base), ".txt")
    testing.AssertEqStr(fs.MimeType(base), "text/plain")

    testing.AssertEqStr(fs.ReadBytes(base, 5), "hello")
    testing.AssertEqStr(fs.ReadBytes(base, 100), "hello salam")

    testing.AssertTrue(fs.Append(base, " again") >= 0)
    testing.AssertEqStr(fs.ReadText(base), "hello salam again")

    lines_path := path.Join(os.TempDir(), "salam_filetest_lines.txt")
    os.Remove(lines_path)
    fs.WriteText(lines_path, "one\ntwo\nthree")
    lines := fs.ReadLines(lines_path)
    testing.AssertEqInt(lines.Len(), 3)
    testing.AssertEqStr(lines.get(0), "one")
    testing.AssertEqStr(lines.get(1), "two")
    testing.AssertEqStr(lines.get(2), "three")
    fs.Delete(lines_path)

    testing.AssertTrue(fs.WriteBytes(base, "binary-ish") >= 0)
    testing.AssertEqStr(fs.ReadText(base), "binary-ish")

    testing.AssertEqInt(fs.Md5Hex(base).Len(), 32)
    testing.AssertEqInt(fs.Sha1Hex(base).Len(), 40)
    testing.AssertEqInt(fs.Sha256Hex(base).Len(), 64)
    testing.AssertEqInt(fs.Sha512Hex(base).Len(), 128)
    testing.AssertEqStr(fs.Md5Hex(base), fs.Md5Hex(base))
    testing.AssertNeStr(fs.Sha256Hex(base), fs.Sha1Hex(base))

    testing.AssertTrue(fs.ModTime(base) > 0)
    testing.AssertTrue(fs.AccessedTime(base) > 0)
    testing.AssertTrue(fs.CreatedTime(base) > 0)

    st := fs.Stat(base)
    testing.AssertTrue(st.exists)
    testing.AssertEqInt64(st.size, 10 as i64)
    testing.AssertTrue(st.mod_time > 0)
    missing_stat := fs.Stat(path.Join(os.TempDir(), "salam_no_such_file.txt"))
    testing.AssertFalse(missing_stat.exists)

    perm := fs.Permissions(base)
    testing.AssertTrue(perm > 0)
    testing.AssertEqInt(fs.Chmod(base, 438), 0)
    perm2 := fs.Permissions(base)
    testing.AssertTrue(perm2 > 0)

    testing.AssertEqInt(fs.Copy(base, copy_path), 0)
    testing.AssertTrue(fs.Exists(copy_path))
    testing.AssertEqStr(fs.ReadText(copy_path), fs.ReadText(base))

    testing.AssertEqInt(fs.Move(copy_path, moved_path), 0)
    testing.AssertFalse(fs.Exists(copy_path))
    testing.AssertTrue(fs.Exists(moved_path))
    testing.AssertEqInt(fs.Rename(moved_path, copy_path), 0)
    testing.AssertTrue(fs.Exists(copy_path))
    testing.AssertFalse(fs.Exists(moved_path))

    testing.AssertEqInt(fs.AtomicWrite(base, "atomically updated"), 0)
    testing.AssertEqStr(fs.ReadText(base), "atomically updated")

    f := fs.Open(base, "rb")
    testing.AssertNotNil(f as void*)
    chunk := io.Read(f, 10 as u64)
    testing.AssertEqStr(chunk, "atomically")
    fs.Close(f)

    error.Clear()
    missing := path.Join(os.TempDir(), "salam_truly_missing_xyz.txt")
    testing.AssertEqInt(fs.Delete(missing), 0 - 1)
    testing.AssertTrue(error.HasError())

    testing.AssertEqInt(fs.Delete(base), 0)
    testing.AssertFalse(fs.Exists(base))
    testing.AssertEqInt(fs.Delete(copy_path), 0)
    testing.AssertFalse(fs.Exists(copy_path))

    testing.AssertEqStr(fs.MimeType("x.json"), "application/json")
    testing.AssertEqStr(fs.MimeType("x.png"), "image/png")
    testing.AssertEqStr(fs.MimeType("x.PNG"), "image/png")
    testing.AssertEqStr(fs.MimeType("x.wasm"), "application/wasm")
    testing.AssertEqStr(fs.MimeType("x.unknownext"), "application/octet-stream")
    testing.AssertEqStr(fs.MimeType("noext"), "application/octet-stream")

    ret testing.Summary()
end
