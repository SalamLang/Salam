package main

import testing
import fs.file
import fs.path
import os.error
import io
import os

func main:
    base := path.Join(os.TempDir(), "salam_filetest.txt")
    copy_path := path.Join(os.TempDir(), "salam_filetest_copy.txt")
    moved_path := path.Join(os.TempDir(), "salam_filetest_moved.txt")
    os.Remove(base)
    os.Remove(copy_path)
    os.Remove(moved_path)

    testing.AssertTrue(file.WriteText(base, "hello salam") >= 0)
    testing.AssertEqStr(file.ReadText(base), "hello salam")
    testing.AssertEqStr(file.ReadAll(base), "hello salam")
    testing.AssertEqInt64(file.Size(base), 11 as i64)
    testing.AssertTrue(file.Exists(base))
    testing.AssertFalse(file.Exists(path.Join(os.TempDir(), "salam_no_such_file.txt")))
    testing.AssertEqStr(file.Extension(base), ".txt")
    testing.AssertEqStr(file.MimeType(base), "text/plain")

    testing.AssertEqStr(file.ReadBytes(base, 5), "hello")
    testing.AssertEqStr(file.ReadBytes(base, 100), "hello salam")

    testing.AssertTrue(file.Append(base, " again") >= 0)
    testing.AssertEqStr(file.ReadText(base), "hello salam again")

    lines_path := path.Join(os.TempDir(), "salam_filetest_lines.txt")
    os.Remove(lines_path)
    file.WriteText(lines_path, "one\ntwo\nthree")
    lines := file.ReadLines(lines_path)
    testing.AssertEqInt(lines.len(), 3)
    testing.AssertEqStr(lines.get(0), "one")
    testing.AssertEqStr(lines.get(1), "two")
    testing.AssertEqStr(lines.get(2), "three")
    file.Delete(lines_path)

    testing.AssertTrue(file.WriteBytes(base, "binary-ish") >= 0)
    testing.AssertEqStr(file.ReadText(base), "binary-ish")

    testing.AssertEqInt(file.Md5Hex(base).len(), 32)
    testing.AssertEqInt(file.Sha1Hex(base).len(), 40)
    testing.AssertEqInt(file.Sha256Hex(base).len(), 64)
    testing.AssertEqInt(file.Sha512Hex(base).len(), 128)
    testing.AssertEqStr(file.Md5Hex(base), file.Md5Hex(base))
    testing.AssertNeStr(file.Sha256Hex(base), file.Sha1Hex(base))

    testing.AssertTrue(file.ModTime(base) > 0)
    testing.AssertTrue(file.AccessedTime(base) > 0)
    testing.AssertTrue(file.CreatedTime(base) > 0)

    st := file.Stat(base)
    testing.AssertTrue(st.exists)
    testing.AssertEqInt64(st.size, 10 as i64)
    testing.AssertTrue(st.mod_time > 0)
    missing_stat := file.Stat(path.Join(os.TempDir(), "salam_no_such_file.txt"))
    testing.AssertFalse(missing_stat.exists)

    perm := file.Permissions(base)
    testing.AssertTrue(perm > 0)
    testing.AssertEqInt(file.Chmod(base, 438), 0)
    perm2 := file.Permissions(base)
    testing.AssertTrue(perm2 > 0)

    testing.AssertEqInt(file.Copy(base, copy_path), 0)
    testing.AssertTrue(file.Exists(copy_path))
    testing.AssertEqStr(file.ReadText(copy_path), file.ReadText(base))

    testing.AssertEqInt(file.Move(copy_path, moved_path), 0)
    testing.AssertFalse(file.Exists(copy_path))
    testing.AssertTrue(file.Exists(moved_path))
    testing.AssertEqInt(file.Rename(moved_path, copy_path), 0)
    testing.AssertTrue(file.Exists(copy_path))
    testing.AssertFalse(file.Exists(moved_path))

    testing.AssertEqInt(file.AtomicWrite(base, "atomically updated"), 0)
    testing.AssertEqStr(file.ReadText(base), "atomically updated")

    f := file.Open(base, "rb")
    testing.AssertNotNil(f as void*)
    chunk := io.Read(f, 10 as u64)
    testing.AssertEqStr(chunk, "atomically")
    file.Close(f)

    error.Clear()
    missing := path.Join(os.TempDir(), "salam_truly_missing_xyz.txt")
    testing.AssertEqInt(file.Delete(missing), 0 - 1)
    testing.AssertTrue(error.HasError())

    testing.AssertEqInt(file.Delete(base), 0)
    testing.AssertFalse(file.Exists(base))
    testing.AssertEqInt(file.Delete(copy_path), 0)
    testing.AssertFalse(file.Exists(copy_path))

    testing.AssertEqStr(file.MimeType("x.json"), "application/json")
    testing.AssertEqStr(file.MimeType("x.png"), "image/png")
    testing.AssertEqStr(file.MimeType("x.PNG"), "image/png")
    testing.AssertEqStr(file.MimeType("x.wasm"), "application/wasm")
    testing.AssertEqStr(file.MimeType("x.unknownext"), "application/octet-stream")
    testing.AssertEqStr(file.MimeType("noext"), "application/octet-stream")

    os.Exit(testing.Summary())
end
