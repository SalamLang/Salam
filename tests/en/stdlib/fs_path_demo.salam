package main

import testing
import fs.path
import os

func main:
    testing.AssertEqStr(path.Join("a", "b.txt"), "a/b.txt")
    testing.AssertEqStr(path.Join("", "b.txt"), "b.txt")
    testing.AssertEqStr(path.Join("a", ""), "a")
    testing.AssertEqStr(path.Join("a/", "b.txt"), "a/b.txt")
    testing.AssertEqStr(path.Join("a", "/b.txt"), "a/b.txt")

    p := path.Split("/a/b/c.txt")
    testing.AssertEqStr(p.dir, "/a/b")
    testing.AssertEqStr(p.base, "c.txt")
    p2 := path.Split("c.txt")
    testing.AssertEqStr(p2.dir, ".")
    testing.AssertEqStr(p2.base, "c.txt")
    p3 := path.Split("/")
    testing.AssertEqStr(p3.dir, "/")
    testing.AssertEqStr(p3.base, "/")

    testing.AssertEqStr(path.Normalize("a\\b\\c"), "a/b/c")
    testing.AssertEqStr(path.Ext("c.txt"), ".txt")
    testing.AssertEqStr(path.Ext("c"), "")
    testing.AssertEqStr(path.Ext(".gitignore"), "")
    testing.AssertEqStr(path.Stem("c.txt"), "c")
    testing.AssertEqStr(path.Basename("c.txt"), "c")
    testing.AssertEqStr(path.Dirname("/a/b/c.txt"), "/a/b")
    testing.AssertEqStr(path.Parent("/a/b/c.txt"), "/a/b")
    testing.AssertEqStr(path.Dirname("/a/b/c.txt"), path.Parent("/a/b/c.txt"))
    testing.AssertEqStr(path.Filename("/a/b/c.txt"), "c.txt")

    testing.AssertTrue(path.IsAbs("/a/b"))
    testing.AssertTrue(path.IsAbs("C:/a/b"))
    testing.AssertFalse(path.IsAbs("a/b"))
    testing.AssertFalse(path.IsAbs(""))

    testing.AssertEqStr(path.Clean("a/./b/../c"), "a/c")
    testing.AssertEqStr(path.Clean("a//b///c"), "a/b/c")
    testing.AssertEqStr(path.Clean("./a/b"), "a/b")
    testing.AssertEqStr(path.Clean("/a/../../b"), "/b")
    testing.AssertEqStr(path.Clean(""), ".")
    testing.AssertEqStr(path.Clean("."), ".")

    testing.AssertEqStr(path.Rel("/a/b/c", "/a/b/d/e.txt"), "../d/e.txt")
    testing.AssertEqStr(path.Rel("/a/b", "/a/b"), ".")
    testing.AssertEqStr(path.Rel("/a/b/c/d", "/a/b"), "../..")

    testing.AssertTrue(path.Validate("ok/path"))
    testing.AssertFalse(path.Validate(""))

    testing.AssertTrue(path.IsSafe("/a/b", "c/d.txt"))
    testing.AssertTrue(path.IsSafe("/a/b", "."))
    testing.AssertFalse(path.IsSafe("/a/b", "../../etc/passwd"))
    testing.AssertFalse(path.IsSafe("/a/b", "../bc/x"))
    testing.AssertFalse(path.IsSafe("/a/b", ""))

    testing.AssertTrue(path.Abs("x").len() > 0)
    testing.AssertTrue(path.IsAbs(path.Abs("x")))
    testing.AssertEqStr(path.Abs("/already/abs"), "/already/abs")

    os.Exit(testing.Summary())
end
