package main

import testing
import fs
import fs.path
import os

func want(mode: int): int:
    mut w := mode
    if SALAM_OS_WINDOWS:
        w = (mode & 0o200) != 0 ? 0o666 : 0o444
    end
    ret w
end

func main:
    p := path.Join(os.TempDir(), "salam_fs_perm_roundtrip_en.txt")
    missing := path.Join(os.TempDir(), "salam_fs_perm_roundtrip_en_missing.txt")
    os.Remove(missing)
    testing.AssertTrue(fs.WriteText(p, "x") >= 0)

    each mode in [0o640, 0o755, 0o600, 0o444, 0o644]:
        testing.AssertEqInt(fs.Chmod(p, mode), 0)
        got := fs.Permissions(p)
        testing.AssertEqInt(got, want(mode))
        testing.AssertEqInt(fs.Chmod(p, got), 0)
        testing.AssertEqInt(fs.Permissions(p), got)
        testing.AssertEqInt(fs.Stat(p).permissions, got)
    end

    info := fs.Stat(p)
    testing.AssertTrue(info.exists)
    testing.AssertEqInt64(info.size, 1 as i64)
    testing.AssertEqInt64(info.mod_time, fs.ModTime(p))
    testing.AssertTrue(info.mod_time > 0)
    testing.AssertTrue(info.accessed_time > 0)
    testing.AssertTrue(info.created_time >= 0)

    testing.AssertEqInt(fs.Permissions(missing), 0 - 1)
    testing.AssertEqInt64(fs.ModTime(missing), 0 - 1)
    testing.AssertEqInt64(fs.AccessedTime(missing), 0 - 1)
    testing.AssertEqInt64(fs.CreatedTime(missing), 0 - 1)
    testing.AssertEqInt(fs.Chmod(missing, 0o644), 0 - 1)
    testing.AssertFalse(fs.Stat(missing).exists)

    testing.AssertEqInt(fs.Delete(p), 0)
    ret testing.Summary()
end
