package main

import testing
import fs
import os

func main:
    dir := os.TempDir()
    a := dir + "/salam_fs_single_a.txt"
    b := dir + "/salam_fs_single_b.txt"
    c := dir + "/salam_fs_single_c.txt"
    fs.Delete(a)
    fs.Delete(b)
    fs.Delete(c)

    testing.AssertTrue(fs.WriteText(a, "one\ntwo\n") >= 0)
    testing.AssertEqStr(fs.ReadText(a), "one\ntwo\n")
    testing.AssertEqStr(fs.ReadAll(a), "one\ntwo\n")
    testing.AssertEqInt(fs.ReadLines(a).Len(), 2)
    testing.AssertTrue(fs.Append(a, "three\n") >= 0)
    testing.AssertEqInt(fs.ReadLines(a).Len(), 3)
    testing.AssertEqStr(fs.ReadBytes(a, 3), "one")
    testing.AssertTrue(fs.WriteBytes(b, "raw") >= 0)
    testing.AssertEqStr(fs.ReadText(b), "raw")
    testing.AssertEqInt(fs.AtomicWrite(b, "atomic"), 0)
    testing.AssertEqStr(fs.ReadText(b), "atomic")

    f := fs.Open(a, "rb")
    testing.AssertTrue(f != null)
    fs.Close(f)

    testing.AssertEqInt(fs.Copy(a, b), 0)
    testing.AssertEqStr(fs.ReadText(b), fs.ReadText(a))
    testing.AssertEqInt(fs.Move(b, c), 0)
    testing.AssertFalse(fs.Exists(b))
    testing.AssertTrue(fs.Exists(c))
    testing.AssertEqInt(fs.Rename(c, b), 0)
    testing.AssertEqInt(fs.Move(b, c), 0)
    testing.AssertEqStr(fs.Extension(c), ".txt")

    info := fs.Stat(c)
    testing.AssertTrue(info.exists)
    testing.AssertEqInt64(info.size, 14 as i64)
    testing.AssertTrue(fs.ModTime(c) > 0)
    testing.AssertEqInt64(fs.Size(c), info.size)
    testing.AssertEqInt(fs.Chmod(c, 420), 0)
    testing.AssertTrue(fs.Permissions(c) == 644 or fs.Permissions(c) == 666)
    testing.AssertTrue(fs.AccessedTime(c) > 0)
    testing.AssertTrue(fs.CreatedTime(c) >= 0)
    testing.AssertEqStr(fs.MimeType(c), "text/plain")
    testing.AssertEqStr(fs.Sha256Hex(a), fs.Sha256Hex(c))
    testing.AssertEqInt(fs.Sha1Hex(c).Len(), 40)
    testing.AssertEqInt(fs.Sha512Hex(c).Len(), 128)
    testing.AssertEqInt(fs.Md5Hex(c).Len(), 32)

    testing.AssertEqInt(fs.Delete(a), 0)
    testing.AssertEqInt(fs.Delete(c), 0)
    testing.AssertFalse(fs.Stat(a).exists)
    ret testing.Summary()
end
