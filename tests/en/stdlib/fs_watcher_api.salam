import fs.watcher
import io
import os
import str

func main:
    root := os.TempDir() + "/salam_watch_api_" + str.FromInt(os.Pid())
    os.RemoveAll(root)
    os.MkdirAll(root)
    io.WriteFile(root + "/a.txt", "one")
    mut w := watcher.New(root)
    println watcher.IsInitialized(w)
    watcher.Snapshot(w)
    println watcher.IsInitialized(w)
    println str.EndsWith(watcher.Root(w), "salam_watch_api_" + str.FromInt(os.Pid()))
    println str.Len(watcher.Backend(w)) > 0
    println watcher.IsNative(w) or str.Equals(watcher.Backend(w), "polling")
    mut idle := watcher.Poll(w)
    println idle.Len()
    watcher.FreeEvents(idle)
    io.WriteFile(root + "/b.txt", "two")
    mut seen := watcher.PollSleepMs(w, 10)
    println seen.Len()
    watcher.FreeEvents(seen)
    io.WriteFile(root + "/c.txt", "three")
    watcher.Reset(w)
    mut quiet := watcher.Poll(w)
    println quiet.Len()
    watcher.FreeEvents(quiet)
    watcher.Free(w)
    os.RemoveAll(root)
end
