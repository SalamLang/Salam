import fs.watcher
import io
import os
import str

func count(events &: Vector<watcher.Event>, kind: watcher.EventKind, suffix: str): int:
    mut n := 0
    repeat events.Len() in i:
        e := events.Get(i)
        if e.kind == kind and str.EndsWith(e.path, suffix):
            n++
        end
    end
    ret n
end

func main:
    root := os.TempDir() + "/salam_watch_ignore_" + str.FromInt(os.Pid())
    os.RemoveAll(root)
    os.MkdirAll(root + "/src")
    os.MkdirAll(root + "/node_modules")
    io.WriteFile(root + "/src/a.salam", "one")
    mut w := watcher.New(root)
    watcher.Ignore(w, "node_modules")
    watcher.IgnoreHidden(w)
    watcher.Snapshot(w)

    io.WriteFile(root + "/src/b.salam", "two")
    io.WriteFile(root + "/src/a.salam", "one more")
    io.WriteFile(root + "/node_modules/x.js", "x")
    io.WriteFile(root + "/.hidden", "h")
    io.WriteFile(root + "/src/a.salam.swp", "s")
    mut events := watcher.PollSettled(w, 50)
    println count(events, watcher.EventKind.Created, "b.salam")
    println count(events, watcher.EventKind.Modified, "a.salam")
    println count(events, watcher.EventKind.Created, "x.js")
    println count(events, watcher.EventKind.Created, ".hidden")
    println count(events, watcher.EventKind.Created, ".swp")
    watcher.FreeEvents(events)

    os.Remove(root + "/src/b.salam")
    mut gone := watcher.PollSettled(w, 50)
    println count(gone, watcher.EventKind.Deleted, "b.salam")
    watcher.FreeEvents(gone)
    mut quiet := watcher.PollSettled(w, 50)
    println quiet.Len()
    watcher.FreeEvents(quiet)
    watcher.Free(w)
    os.RemoveAll(root)
end
