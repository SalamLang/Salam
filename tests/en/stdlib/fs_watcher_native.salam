import fs.watcher
import io
import os
import str

func count(events &: Vector<watcher.Event>, kind: watcher.EventKind, suffix: str): int:
    mut n := 0
    repeat events.Len() in i:
        e := events.Get(i)
        if e.kind == kind and str.EndsWith(e.path, suffix):
            n++
        end
    end
    ret n
end

func main:
    root := os.TempDir() + "/salam_watch_native_" + str.FromInt(os.Pid())
    os.RemoveAll(root)
    os.MkdirAll(root)
    io.WriteFile(root + "/a.txt", "aaaa")
    mut w := watcher.New(root)
    watcher.Snapshot(w)

    io.WriteFile(root + "/b.txt", "new")
    println watcher.Wait(w, 300)
    mut ev1 := watcher.PollSettled(w, 30)
    println count(ev1, watcher.EventKind.Created, "b.txt")
    watcher.FreeEvents(ev1)

    os.MkdirAll(root + "/sub/deep")
    println watcher.Wait(w, 300)
    mut ev2 := watcher.PollSettled(w, 30)
    println count(ev2, watcher.EventKind.Created, "deep")
    watcher.FreeEvents(ev2)

    io.WriteFile(root + "/sub/deep/n.txt", "x")
    println watcher.Wait(w, 300)
    mut ev3 := watcher.PollSettled(w, 30)
    println count(ev3, watcher.EventKind.Created, "n.txt")
    watcher.FreeEvents(ev3)

    io.WriteFile(root + "/a.txt", "bbbb")
    println watcher.Wait(w, 300)
    mut ev4 := watcher.PollSettled(w, 30)
    println count(ev4, watcher.EventKind.Modified, "a.txt")
    watcher.FreeEvents(ev4)

    os.Remove(root + "/b.txt")
    println watcher.Wait(w, 300)
    mut ev5 := watcher.PollSettled(w, 30)
    println count(ev5, watcher.EventKind.Deleted, "b.txt")
    watcher.FreeEvents(ev5)

    watcher.Free(w)
    os.RemoveAll(root)
end
