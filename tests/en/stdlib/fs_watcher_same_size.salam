import fs.watcher
import io
import os
import time

func main:
    p := "_watch_same_size.txt"
    io.WriteFile(p, "aaaa")
    mut w := watcher.New(p)
    watcher.Snapshot(w)
    time.Sleep(1200)
    io.WriteFile(p, "bbbb")
    events := watcher.Poll(w)
    println events.Len()
    println events.Get(0).kind == watcher.EventKind.Modified
    os.Remove(p)
end
