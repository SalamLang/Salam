import fs.watcher
import io
import os
import str

func created(events &: Vector<watcher.Event>, suffix: str): int:
    mut n := 0
    repeat events.Len() in i:
        e := events.Get(i)
        if e.kind == watcher.EventKind.Created and str.EndsWith(e.path, suffix):
            n++
        end
    end
    ret n
end

func main:
    root := os.TempDir() + "/salam_watch_shared_" + str.FromInt(os.Pid())
    os.RemoveAll(root)
    os.MkdirAll(root + "/real")
    linked := os.Run("ln -s " + root + "/real " + root + "/alias") == 0
    mut w := watcher.New(root)
    watcher.Snapshot(w)
    if linked:
        os.Remove(root + "/alias")
    end
    mut first := watcher.PollSettled(w, 20)
    watcher.FreeEvents(first)
    io.WriteFile(root + "/real/new.txt", "x")
    println watcher.Wait(w, 500)
    mut seen := watcher.PollSettled(w, 20)
    println created(seen, "new.txt")
    watcher.FreeEvents(seen)
    watcher.Free(w)
    os.RemoveAll(root)
end
