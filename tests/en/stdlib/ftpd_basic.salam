package main

import ftpd
import ftp
import testing
import os
import fs
import fs.dir
import time
import sync

mut srv := ftpd.Server {}
mut ready := sync.NewWaitGroup()
mut root := "/tmp/opencode/ftpd_test_root"

func server_run():
    fs.dir.MkdirAll(root)
    mut cfg := ftpd.NewConfig()
    cfg.host = "127.0.0.1"
    cfg.port = 0
    cfg.root = root
    cfg.allow_anonymous = true
    cfg.passive_start = 45000
    cfg.passive_end = 45100
    srv = ftpd.New(cfg)
    ftpd.Listen(srv)
    sync.Done(ready)
    // serve a few sessions
    repeat 10 in i:
        ftpd.ServeOnce(srv)
    end
    ftpd.Close(srv)
end

func test_anonymous_basic():
    c := ftp.Dial("127.0.0.1", ftpd.Port(srv))
    testing.AssertTrue(ftp.Ok(c))
    testing.AssertTrue(ftp.Login(c, "anonymous", ""))
    testing.AssertEqStr(ftp.Pwd(c), "/")
    testing.AssertTrue(ftp.Write(c, "hello.txt", "hello salam"))
    testing.AssertEqStr(ftp.Read(c, "hello.txt"), "hello salam")
    testing.AssertTrue(ftp.Mkdir(c, "docs"))
    testing.AssertTrue(ftp.Cwd(c, "docs"))
    testing.AssertEqStr(ftp.Pwd(c), "/docs")
    testing.AssertTrue(ftp.Write(c, "note.txt", "note"))
    testing.AssertTrue(ftp.CdUp(c))
    names := ftp.NameList(c)
    testing.AssertTrue(names.len() >= 2)
    testing.AssertTrue(ftp.Delete(c, "hello.txt"))
    testing.AssertFalse(ftp.Exists(c, "hello.txt"))
    ftp.Close(c)
end

func main:
    fs.dir.RemoveAll(root)
    sync.Add(ready, 1 as i64)
    t := spawn(server_run)
    sync.Wait(ready)
    time.Sleep(50)
    test_anonymous_basic()
    join(t)
    fs.dir.RemoveAll(root)
    testing.Summary()
    ret 0
end
