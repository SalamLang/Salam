import filepath
import fs.dir
import fs
import os
import os.temp
import fs.path

func check(pattern: str, name: str):
    println pattern, name, filepath.Match(pattern, name)
end

func show(items: Vector<str>, root: str):
    each item in items:
        println item.substr(root.Len(), item.Len() - root.Len())
    end
    items.Free()
end

func main:
    check("*.py", "tool.py")
    check("*.py", "dir/tool.py")
    check("**/*.py", "tool.py")
    check("**/*.py", "a/b/tool.py")
    check("**/x", "ax")
    check("a/**", "a/b/c")
    check("a?c", "abc")
    check("a?c", "a/c")
    check("a[b-d]c", "acc")
    check("a[!b-d]c", "acc")
    check("a[^b-d]c", "aec")
    check("a\\*", "a*")
    check("*", "")
    check("[", "[")
    check("pi?ata", "piñata")
    check("lib*/**/*.so", "libx/a/b/c.so")
    println filepath.HasMeta("a/b.txt"), filepath.HasMeta("a/*.txt"), filepath.HasMeta("a[1]"), path.Match("*.salam", "x.salam")

    root := temp.Directory()
    defer temp.RemoveDir(root)
    os.MkdirAll(root + "/src/deep/deeper")
    os.MkdirAll(root + "/docs")
    names := ["src/a.c", "src/b.h", "src/deep/c.c", "src/deep/deeper/d.c", "docs/readme.md", "top.c"]
    each rel in names:
        fs.WriteText(root + "/" + rel, "x")
    end

    println "glob src/*.c"
    show(dir.Glob(root + "/src/*.c"), root)
    println "glob src/**/*.c"
    show(dir.Glob(root + "/src/**/*.c"), root)
    println "glob */*.?"
    show(dir.Glob(root + "/*/*.?"), root)
    println "glob nothing"
    show(dir.Glob(root + "/none/*.c"), root)
    println "glob literal"
    show(dir.Glob(root + "/top.c"), root)
    println "walk *.c"
    show(dir.WalkMatch(root, "*.c"), root)
    println "walk src/**/*.c"
    show(dir.WalkMatch(root, "src/**/*.c"), root)
    println "walk docs/*"
    show(dir.WalkMatch(root, "docs/*"), root)
end
