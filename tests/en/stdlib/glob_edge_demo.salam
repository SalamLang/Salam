import filepath
import fs.dir
import fs
import os
import os.temp
import fs.path

func check(pattern: str, name: str):
    println pattern + " ~ " + name, filepath.Match(pattern, name)
end

func show(items: Vector<str>, root: str):
    each item in items:
        println "  " + item.substr(root.Len(), item.Len() - root.Len())
    end
    println "  count", items.Len()
    items.free()
end

func main:
    println "empty and literal"
    check("", "")
    check("", "a")
    check("a", "")
    check("a", "a")
    check("a", "A")
    check("abc", "ab")
    check("ab", "abc")
    check("a.b", "a.b")
    check("a.b", "axb")

    println "star"
    check("*", "abc")
    check("*", "a/b")
    check("**", "a/b/c")
    check("a*", "a")
    check("*a", "ba")
    check("a*b*c", "aXbYc")
    check("a*b*c", "aXbY")
    check("**/a", "a")
    check("**/a", "x/y/a")
    check("a/**/b", "a/b")
    check("a/**/b", "a/x/y/b")
    check("a/**/b", "a/xb")
    check("a**b", "aXXb")
    check("a**b", "a/b")
    check("a/*/c", "a/b/c")
    check("a/*/c", "a/b/d/c")

    println "question"
    check("?", "a")
    check("?", "")
    check("?", "ab")
    check("??", "ab")
    check("a?c", "a/c")

    println "classes"
    check("[abc]", "b")
    check("[abc]", "d")
    check("[a-c]", "c")
    check("[a-c]", "d")
    check("[c-a]", "b")
    check("[!a]", "b")
    check("[!a]", "a")
    check("[^a]", "b")
    check("[a-]", "-")
    check("[]a]", "]")
    check("[a", "a")
    check("[a-c", "b")
    check("x[", "x")
    check("[a-cx-z]", "y")
    check("[0-9][0-9]", "42")
    check("[0-9][0-9]", "4x")
    check("[!0-9]*", "abc")
    check("[!0-9]*", "1bc")

    println "escapes"
    check("\\*", "*")
    check("\\*", "a")
    check("\\?", "?")
    check("a\\", "a")
    check("a\\", "a\\")
    check("\\[a]", "[a]")
    check("a\\/b", "a/b")

    println "unicode"
    check("?", "س")
    check("??", "س")
    check("سلام*", "سلام دنیا")
    check("س?ام", "سلام")
    check("[ب-ن]", "ل")
    check("[ب-ن]", "ا")
    check("*.txt", "سلام.txt")
    check("é", "é")
    check("?", "é")

    println "meta"
    println filepath.HasMeta(""), filepath.HasMeta("plain"), filepath.HasMeta("a/b/c.txt")
    println filepath.HasMeta("*"), filepath.HasMeta("a?"), filepath.HasMeta("[a]"), filepath.HasMeta("a\\b")
    println filepath.HasMeta("**"), filepath.HasMeta("a]"), filepath.HasMeta("a{b}"), filepath.HasMeta("!a")
    println path.HasMeta("x*"), path.HasMeta("x"), path.Match("[a-c]?", "b1"), path.Match("[a-c]?", "d1")

    root := temp.Directory()
    defer temp.RemoveDir(root)
    os.MkdirAll(root + "/sub/deep")
    os.MkdirAll(root + "/empty")
    names := [".hidden", "a.txt", "b.TXT", "سلام.txt", "سلام۲.txt", "sub/x.txt", "sub/y.c", "sub/deep/z.txt", "sub/.dot"]
    each rel in names:
        fs.WriteText(root + "/" + rel, "x")
    end

    println "glob"
    show(dir.Glob(root + "/*"), root)
    show(dir.Glob(root + "/.*"), root)
    show(dir.Glob(root + "/*.txt"), root)
    show(dir.Glob(root + "/*.[tT][xX][tT]"), root)
    show(dir.Glob(root + "/**"), root)
    show(dir.Glob(root + "/**/*.txt"), root)
    show(dir.Glob(root + "/sub/**/z.txt"), root)
    show(dir.Glob(root + "/sub/deep/../x.txt"), root)
    show(dir.Glob(root + "/s?b/*"), root)
    show(dir.Glob(root + "/empty/*"), root)
    show(dir.Glob(root + "/empty"), root)
    show(dir.Glob(root + "/missing"), root)
    show(dir.Glob(root + "/missing/*"), root)
    show(dir.Glob(root + "/a.txt/*"), root)
    show(dir.Glob(root + "//sub//x.txt"), root)
    show(dir.Glob(root + "/سلام*"), root)
    show(dir.Glob(root + "/سلام?.txt"), root)
    show(dir.Glob(root + "/*/*/*"), root)
    show(dir.Glob(""), root)

    println "walk"
    show(dir.WalkMatch(root, "*.txt"), root)
    show(dir.WalkMatch(root, "*.c"), root)
    show(dir.WalkMatch(root, "z.txt"), root)
    show(dir.WalkMatch(root, "sub/*"), root)
    show(dir.WalkMatch(root, "**/*.txt"), root)
    show(dir.WalkMatch(root, "sub/**"), root)
    show(dir.WalkMatch(root, "empty"), root)
    show(dir.WalkMatch(root, "*"), root)
    show(dir.WalkMatch(root + "/", "*.c"), root)
    show(dir.WalkMatch(root + "/sub", "*.txt"), root)
    show(dir.WalkMatch(root + "/missing", "*"), root)
    show(dir.WalkMatch(root, ""), root)
    show(dir.WalkMatch(root, "[a-"), root)
end
