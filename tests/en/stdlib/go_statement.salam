package main

import mem
import pool

mut total := null as i64*

func add(n: i64):
    atomic_add(total, n)
end

func slow_add(n: i64, extra: i64):
    atomic_add(total, n + extra)
end

func main:
    total = mem.AllocateZeroed(8 as u64) as i64*
    repeat 10 in i:
        go add((i + 1) as i64)
    end
    pool.GoWait()
    println "sum of 1..10: ", atomic_load(total)

    mut base := 100
    go slow_add(base as i64, 5 as i64)
    base = 0
    pool.GoWait()
    println "args copied when go ran: ", atomic_load(total)

    mut go := true
    until go:
        go = false
    end
    println "go still works as a name: ", go
    mem.Free(total as void*)
end
