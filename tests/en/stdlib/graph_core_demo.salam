package main

// std/graph, part 1: the graph object itself, the derived-graph operations,
// traversal, shortest paths and spanning trees.
//
// Every check is an assertion against a value that is known independently of
// this library: textbook example graphs whose answers are in the textbook
// (Dijkstra's own six-node example, the seven-node minimum spanning tree from
// Kruskal's paper), or identities that must hold for any correct
// implementation (the three spanning tree algorithms agreeing, Floyd-Warshall
// and Johnson and Dijkstra agreeing, a BFS layer count matching the
// eccentricity).

import graph
import testing
import os

func dijkstra_example(): graph.Graph:
    mut g := graph.NewDirected(6)
    g.add_weighted(0, 1, 7.0)
    g.add_weighted(0, 2, 9.0)
    g.add_weighted(0, 5, 14.0)
    g.add_weighted(1, 2, 10.0)
    g.add_weighted(1, 3, 15.0)
    g.add_weighted(2, 3, 11.0)
    g.add_weighted(2, 5, 2.0)
    g.add_weighted(3, 4, 6.0)
    g.add_weighted(5, 4, 9.0)
    ret g
end

func mst_example(): graph.Graph:
    mut g := graph.NewUndirected(7)
    g.add_weighted(0, 1, 7.0)
    g.add_weighted(0, 3, 5.0)
    g.add_weighted(1, 2, 8.0)
    g.add_weighted(1, 3, 9.0)
    g.add_weighted(1, 4, 7.0)
    g.add_weighted(2, 4, 5.0)
    g.add_weighted(3, 4, 15.0)
    g.add_weighted(3, 5, 6.0)
    g.add_weighted(4, 5, 8.0)
    g.add_weighted(4, 6, 9.0)
    g.add_weighted(5, 6, 11.0)
    ret g
end

func test_construction():
    println "-- construction"
    mut g := graph.NewUndirected(5)
    defer g.free()
    g.add_edge(0, 1)
    g.add_edge(1, 2)
    g.add_weighted(2, 3, 2.5)
    testing.AssertEqInt(g.order(), 5)
    testing.AssertEqInt(g.size(), 3)
    testing.AssertEqInt(g.degree(1), 2)
    testing.AssertEqInt(g.degree(4), 0)
    testing.AssertTrue(g.has_edge(1, 0))
    testing.AssertFalse(g.has_edge(0, 3))
    testing.AssertEqFloat(g.weight_between(2, 3), 2.5, 0.000001)
    // adding an edge past the end grows the node set
    g.add_edge(7, 8)
    testing.AssertEqInt(g.order(), 9)
    mut nb := g.neighbors(1)
    defer nb.free()
    testing.AssertEqInt(nb.len(), 2)
end

func test_directed():
    println "-- directed degrees"
    mut d := graph.NewDirected(3)
    defer d.free()
    d.add_edge(0, 1)
    d.add_edge(2, 1)
    testing.AssertEqInt(d.in_degree(1), 2)
    testing.AssertEqInt(d.out_degree(1), 0)
    testing.AssertEqInt(d.degree(1), 2)
    testing.AssertEqInt(d.out_degree(0), 1)
end

func test_operations():
    println "-- derived graphs"
    mut g := graph.NewUndirected(4)
    defer g.free()
    g.add_edge(0, 1)
    g.add_edge(1, 2)
    g.add_edge(2, 0)
    g.add_edge(0, 1)
    g.add_edge(3, 3)
    testing.AssertFalse(graph.IsSimple(g))
    testing.AssertEqInt(graph.SelfLoopCount(g), 1)
    testing.AssertEqInt(graph.ParallelEdgeCount(g), 1)
    mut s := graph.Simplify(g)
    defer s.free()
    testing.AssertEqInt(s.size(), 3)
    testing.AssertTrue(graph.IsSimple(s))
    // the complement of a triangle plus an isolated node joins that node to all
    mut c := graph.Complement(s)
    defer c.free()
    testing.AssertEqInt(c.size(), 3)
    // the line graph of a triangle is a triangle
    mut l := graph.LineGraph(s)
    defer l.free()
    testing.AssertEqInt(l.order(), 3)
    testing.AssertEqInt(l.size(), 3)
end

func test_subgraph():
    println "-- subgraphs"
    mut g := graph.NewUndirected(4)
    defer g.free()
    g.add_edge(0, 1)
    g.add_edge(1, 2)
    g.add_edge(2, 3)
    mut keep := Vector {} as Vector<bool>
    defer keep.free()
    keep.push(true)
    keep.push(true)
    keep.push(false)
    keep.push(true)
    mut sub := graph.Subgraph(g, keep)
    defer sub.free()
    testing.AssertEqInt(sub.order(), 3)
    testing.AssertEqInt(sub.size(), 1)
    mut t := graph.NewDirected(3)
    defer t.free()
    t.add_edge(0, 1)
    t.add_edge(1, 2)
    mut r := graph.Transpose(t)
    defer r.free()
    testing.AssertTrue(r.has_edge(1, 0))
    testing.AssertFalse(r.has_edge(0, 1))
end

func test_traversal():
    println "-- traversal"
    mut g := graph.NewUndirected(7)
    defer g.free()
    g.add_edge(0, 1)
    g.add_edge(0, 2)
    g.add_edge(1, 3)
    g.add_edge(2, 3)
    g.add_edge(4, 5)
    mut d := graph.BFS(g, 0)
    defer d.free()
    testing.AssertEqInt(d.get(0), 0)
    testing.AssertEqInt(d.get(3), 2)
    testing.AssertEqInt(d.get(5), graph.GRAPH_NONE)
    testing.AssertEqInt(graph.ComponentCount(g), 3)
    testing.AssertFalse(graph.IsConnected(g))
    mut sizes := graph.ComponentSizes(g)
    defer sizes.free()
    testing.AssertEqInt(sizes.get(0), 4)
    testing.AssertEqInt(sizes.get(1), 2)
    testing.AssertEqInt(sizes.get(2), 1)
    mut order := graph.DFSOrder(g, 0)
    defer order.free()
    testing.AssertEqInt(order.len(), 4)
    mut path := graph.HopPath(g, 0, 3)
    defer path.free()
    testing.AssertEqInt(path.len(), 3)
    testing.AssertEqInt(path.get(0), 0)
    testing.AssertEqInt(path.get(2), 3)
    testing.AssertEqInt(graph.HopDistance(g, 0, 5), graph.GRAPH_NONE)
end

func test_bipartite_and_cycles():
    println "-- bipartite and cycles"
    mut c4 := graph.CycleGraph(4)
    defer c4.free()
    testing.AssertTrue(graph.Bipartite(c4))
    mut c5 := graph.CycleGraph(5)
    defer c5.free()
    testing.AssertFalse(graph.Bipartite(c5))
    testing.AssertTrue(graph.HasCycle(c5))
    mut cyc := graph.FindCycle(c5)
    defer cyc.free()
    testing.AssertEqInt(cyc.len(), 5)
    mut tree := graph.PathGraph(5)
    defer tree.free()
    testing.AssertFalse(graph.HasCycle(tree))
end

func test_topological():
    println "-- topological order"
    mut dag := graph.NewDirected(5)
    defer dag.free()
    dag.add_edge(0, 1)
    dag.add_edge(0, 2)
    dag.add_edge(1, 3)
    dag.add_edge(2, 3)
    dag.add_edge(3, 4)
    mut order := Vector {} as Vector<int>
    defer order.free()
    testing.AssertTrue(graph.TopologicalSortLex(dag, order))
    testing.AssertEqInt(order.get(0), 0)
    testing.AssertEqInt(order.get(1), 1)
    testing.AssertEqInt(order.get(4), 4)
    testing.AssertTrue(graph.IsDAG(dag))
    dag.add_edge(4, 0)
    testing.AssertFalse(graph.IsDAG(dag))
    testing.AssertTrue(graph.HasCycle(dag))
end

func test_dijkstra():
    println "-- dijkstra"
    mut g := dijkstra_example()
    defer g.free()
    mut dist := graph.DijkstraDist(g, 0)
    defer dist.free()
    testing.AssertEqFloat(dist.get(1), 7.0, 0.000001)
    testing.AssertEqFloat(dist.get(2), 9.0, 0.000001)
    testing.AssertEqFloat(dist.get(3), 20.0, 0.000001)
    testing.AssertEqFloat(dist.get(4), 20.0, 0.000001)
    testing.AssertEqFloat(dist.get(5), 11.0, 0.000001)
    mut path := graph.ShortestPath(g, 0, 4)
    defer path.free()
    testing.AssertEqInt(path.len(), 4)
    testing.AssertEqInt(path.get(1), 2)
    testing.AssertEqInt(path.get(2), 5)
    testing.AssertEqFloat(graph.ShortestPathLength(g, 0, 4), 20.0, 0.000001)
end

func test_all_pairs():
    println "-- all pairs agree"
    mut g := dijkstra_example()
    defer g.free()
    mut fw := graph.FloydWarshall(g)
    defer fw.free()
    mut jo := graph.Johnson(g)
    defer jo.free()
    mut ok := true
    repeat g.order() with s:
        mut dist := graph.DijkstraDist(g, s)
        repeat g.order() with t:
            if graph.IsClose(dist.get(t), fw.at(s, t)) == false: ok = false end
            if graph.IsClose(dist.get(t), jo.at(s, t)) == false: ok = false end
        end
        dist.free()
    end
    testing.AssertMsg(ok, "dijkstra, floyd-warshall and johnson disagree")
    testing.AssertEqFloat(fw.at(4, 0), graph.GRAPH_INF, 1.0)
end

func test_floyd_path():
    println "-- floyd path reconstruction"
    mut g := dijkstra_example()
    defer g.free()
    mut nx := graph.NewIntMatrix(0, 0, 0)
    defer nx.free()
    mut fw := graph.FloydWarshallPaths(g, nx)
    defer fw.free()
    mut p := graph.FloydPath(nx, 0, 4)
    defer p.free()
    testing.AssertEqInt(p.len(), 4)
    testing.AssertEqInt(p.get(0), 0)
    testing.AssertEqInt(p.get(3), 4)
end

func test_negative_weights():
    println "-- bellman-ford and negative cycles"
    mut g := graph.NewDirected(4)
    defer g.free()
    g.add_weighted(0, 1, 4.0)
    g.add_weighted(1, 2, 0.0 - 3.0)
    g.add_weighted(2, 3, 2.0)
    mut dist := Vector {} as Vector<f64>
    defer dist.free()
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    testing.AssertTrue(graph.BellmanFord(g, 0, dist, parent))
    testing.AssertEqFloat(dist.get(3), 3.0, 0.000001)
    testing.AssertFalse(graph.HasNegativeCycle(g))
    // dijkstra refuses rather than answering wrongly
    mut d2 := Vector {} as Vector<f64>
    defer d2.free()
    testing.AssertFalse(graph.Dijkstra(g, 0, d2, parent))
    g.add_weighted(3, 1, 0.0 - 5.0)
    testing.AssertTrue(graph.HasNegativeCycle(g))
    mut nc := graph.FindNegativeCycle(g)
    defer nc.free()
    testing.AssertEqInt(nc.len(), 3)
end

func test_zero_one():
    println "-- 0-1 bfs"
    mut g := graph.NewDirected(4)
    defer g.free()
    g.add_weighted(0, 1, 0.0)
    g.add_weighted(1, 2, 1.0)
    g.add_weighted(0, 2, 1.0)
    g.add_weighted(2, 3, 0.0)
    mut dist := Vector {} as Vector<f64>
    defer dist.free()
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    testing.AssertTrue(graph.ZeroOneBFS(g, 0, dist, parent))
    testing.AssertEqFloat(dist.get(1), 0.0, 0.000001)
    testing.AssertEqFloat(dist.get(3), 1.0, 0.000001)
    g.add_weighted(0, 3, 5.0)
    testing.AssertFalse(graph.ZeroOneBFS(g, 0, dist, parent))
end

func test_astar():
    println "-- a star"
    mut g := graph.GridGraph(4, 4)
    defer g.free()
    mut h := Vector {} as Vector<f64>
    defer h.free()
    // manhattan distance to node 15 (row 3, column 3) is admissible on a grid
    repeat 16 with u:
        r := u / 4
        c := u % 4
        h.push(((3 - r) + (3 - c)) as f64)
    end
    mut p := graph.AStar(g, 0, 15, h)
    defer p.free()
    testing.AssertEqInt(p.len(), 7)
    testing.AssertEqInt(p.get(0), 0)
    testing.AssertEqInt(p.get(6), 15)
end

func test_k_shortest():
    println "-- k shortest"
    mut g := dijkstra_example()
    defer g.free()
    mut ks := graph.KShortestLengths(g, 0, 4, 3)
    defer ks.free()
    testing.AssertEqInt(ks.len(), 3)
    testing.AssertEqFloat(ks.get(0), 20.0, 0.000001)
    testing.AssertTrue(ks.get(1) >= ks.get(0))
    testing.AssertTrue(ks.get(2) >= ks.get(1))
end

func test_mst():
    println "-- spanning trees"
    mut g := mst_example()
    defer g.free()
    mut chosen := Vector {} as Vector<int>
    defer chosen.free()
    testing.AssertEqFloat(graph.Kruskal(g, chosen), 39.0, 0.000001)
    testing.AssertEqInt(chosen.len(), 6)
    mut parent := Vector {} as Vector<int>
    defer parent.free()
    testing.AssertEqFloat(graph.Prim(g, 0, parent), 39.0, 0.000001)
    mut b := Vector {} as Vector<int>
    defer b.free()
    testing.AssertEqFloat(graph.Boruvka(g, b), 39.0, 0.000001)
    testing.AssertTrue(graph.SpanningAgreement(g))
    mut mx := Vector {} as Vector<int>
    defer mx.free()
    testing.AssertEqFloat(graph.MaximumSpanningTree(g, mx), 59.0, 0.000001)
    mut t := graph.MinimumSpanningTree(g)
    defer t.free()
    testing.AssertEqInt(t.size(), 6)
    testing.AssertTrue(graph.IsConnected(t))
    testing.AssertTrue(graph.IsTree(t))
end

func test_forest():
    println "-- spanning forest of a disconnected graph"
    mut g := graph.NewUndirected(6)
    defer g.free()
    g.add_weighted(0, 1, 1.0)
    g.add_weighted(1, 2, 2.0)
    g.add_weighted(3, 4, 3.0)
    mut chosen := Vector {} as Vector<int>
    defer chosen.free()
    testing.AssertEqFloat(graph.Kruskal(g, chosen), 6.0, 0.000001)
    testing.AssertEqInt(chosen.len(), 3)
    mut f := graph.MinimumSpanningTree(g)
    defer f.free()
    testing.AssertTrue(graph.IsForest(f))
    testing.AssertFalse(graph.IsTree(f))
end

func main:
    println "std/graph: core, operations, traversal, paths, spanning trees"
    test_construction()
    test_directed()
    test_operations()
    test_subgraph()
    test_traversal()
    test_bipartite_and_cycles()
    test_topological()
    test_dijkstra()
    test_all_pairs()
    test_floyd_path()
    test_negative_weights()
    test_zero_one()
    test_astar()
    test_k_shortest()
    test_mst()
    test_forest()
    os.Exit(testing.Summary())
end
