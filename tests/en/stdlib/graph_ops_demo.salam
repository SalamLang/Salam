package main

import graph
import conv

func f(x: f64): str:
    if x < 0.00005 and x > 0.0 - 0.00005:
        ret "0"
    end
    ret conv.FormatFloatPrec(x, 4)
end

func show(label: str, v: Vector<int>):
    mut s := label
    repeat v.Len() in i:
        s = s.concat(" ").concat(conv.FormatInt(v.get(i) as i64))
    end
    println s
end

func showf(label: str, v: Vector<f64>):
    mut s := label
    repeat v.Len() in i:
        s = s.concat(" ").concat(f(v.get(i)))
    end
    println s
end

func sample(): graph.Graph:
    mut g := graph.NewUndirected(4)
    g.add_weighted(0, 1, 2.0)
    g.add_weighted(1, 2, 3.0)
    g.add_weighted(2, 3, 4.0)
    g.add_weighted(3, 3, 1.0)
    ret g
end

func main:
    mut v := Vector {} as Vector<int>
    graph.Iota(v, 5)
    show("iota", v)
    graph.ReverseInt(v)
    show("reversed", v)
    println graph.MaxInt(v), graph.SumInt(v)
    graph.FillInt(v, 3, 7)
    show("fill", v)
    mut fl := Vector {} as Vector<f64>
    graph.FillFloat(fl, 4, 0.5)
    println f(graph.SumFloat(fl))
    mut fb := Vector {} as Vector<bool>
    graph.FillBool(fb, 3, true)
    println fb.Len(), fb.get(2)
    v.Free()
    fl.Free()
    fb.Free()

    mut us := Vector {} as Vector<int>
    mut vs := Vector {} as Vector<int>
    us.push(0)
    us.push(1)
    vs.push(1)
    vs.push(2)
    mut fe := graph.FromEdges(3, us, vs, true)
    println fe.order(), fe.size(), fe.directed, fe.has_edge(1, 2), fe.has_edge(2, 1)
    us.Free()
    vs.Free()
    fe.Free()

    mut e0 := graph.EmptyGraph(3)
    println e0.order(), e0.size()
    e0.Free()

    mut ds := graph.NewDisjointSet(5)
    ds.union(0, 1)
    ds.union(3, 4)
    println ds.count(), ds.connected(0, 1), ds.connected(1, 3)
    ds.Free()

    mut g := sample()
    println g.size(), graph.HasSelfLoop(g), graph.TotalWeight(g)
    mut ns := graph.RemoveSelfLoops(g)
    println ns.size(), graph.HasSelfLoop(ns), graph.TotalWeight(ns)

    mut dir := graph.ToDirected(ns)
    println dir.directed, dir.size()
    mut und := graph.ToUndirected(dir)
    println und.directed, und.size()
    dir.Free()
    und.Free()

    mut keep := Vector {} as Vector<bool>
    keep.push(true)
    keep.push(true)
    keep.push(false)
    keep.push(true)
    mut map := Vector {} as Vector<int>
    mut sub := graph.SubgraphMap(ns, keep, map)
    println sub.order(), sub.size()
    show("map", map)
    sub.Free()
    map.Free()
    keep.Free()

    mut ek := Vector {} as Vector<bool>
    ek.push(true)
    ek.push(false)
    ek.push(true)
    mut es := graph.EdgeSubgraph(ns, ek)
    println es.order(), es.size(), es.has_edge(1, 2), es.has_edge(0, 1)
    es.Free()
    ek.Free()

    mut other := graph.NewUndirected(5)
    other.add_edge(0, 1)
    other.add_edge(3, 4)
    mut un := graph.Union(ns, other)
    println un.order(), un.size()
    mut du := graph.DisjointUnion(ns, other)
    println du.order(), du.size(), du.has_edge(5, 6)
    mut inter := graph.Intersection(ns, other)
    println inter.order(), inter.size(), inter.has_edge(0, 1)
    un.Free()
    du.Free()
    inter.Free()
    other.Free()
    ns.Free()
    g.Free()

    mut p := graph.PathGraph(3)
    mut a := graph.AdjacencyMatrix(p)
    mut w := graph.WeightMatrix(p)
    mut d := graph.DegreeMatrix(p)
    mut nl := graph.NormalizedLaplacian(p)
    println f(a.at(0, 1)), f(w.at(0, 1)), f(d.at(1, 1)), f(nl.at(0, 0)), f(nl.at(0, 1))
    mut id := graph.MatrixIdentity(3)
    mut prod := graph.MatrixMultiply(a, a)
    mut pw := graph.MatrixPower(a, 3)
    println f(id.trace()), f(prod.at(0, 0)), f(prod.at(0, 2)), f(pw.at(0, 1)), f(pw.at(1, 1))
    mut nm := graph.NewMatrix(2, 3)
    nm.set(1, 2, 4.5)
    println nm.rows, nm.cols, f(nm.at(1, 2))
    mut sq := graph.NewMatrix(2, 2)
    sq.set(0, 0, 2.0)
    sq.set(0, 1, 1.0)
    sq.set(1, 0, 1.0)
    sq.set(1, 1, 3.0)
    println f(graph.Determinant(sq))
    mut ev := graph.SymmetricEigenvalues(sq)
    showf("eig", ev)
    mut sp := graph.AdjacencySpectrum(p)
    showf("spectrum", sp)
    ev.Free()
    sp.Free()
    a.Free()
    w.Free()
    d.Free()
    nl.Free()
    id.Free()
    prod.Free()
    pw.Free()
    nm.Free()
    sq.Free()
    p.Free()
end
