package main

import graph
import conv

func f(x: f64): str:
    if x < 0.00005 and x > 0.0 - 0.00005:
        ret "0"
    end
    ret conv.FormatFloatPrec(x, 4)
end

func show(label: str, v: Vector<int>):
    mut s := label
    repeat v.Len() in i:
        s = s.Concat(" ").Concat(conv.FormatInt(v.Get(i) as i64))
    end
    println s
end

func showf(label: str, v: Vector<f64>):
    mut s := label
    repeat v.Len() in i:
        s = s.Concat(" ").Concat(f(v.Get(i)))
    end
    println s
end

func diamond(): graph.Graph:
    mut g := graph.NewDirected(5)
    g.add_edge(0, 1)
    g.add_edge(0, 2)
    g.add_edge(1, 3)
    g.add_edge(2, 3)
    g.add_edge(3, 4)
    ret g
end

func main:
    mut g := diamond()
    mut dist := Vector {} as Vector<int>
    mut parent := Vector {} as Vector<int>
    graph.BFSFrom(g, 0, dist, parent)
    show("dist", dist)
    show("parent", parent)
    mut path := graph.PathFromParents(parent, 0, 4)
    show("path", path)
    mut bo := graph.BFSOrder(g, 0)
    show("bfs", bo)
    mut po := graph.DFSPostOrder(g, 0)
    show("post", po)
    mut forest := graph.DFSForest(g)
    show("forest", forest)
    mut reach := graph.Reachable(g, 2)
    println reach.Get(0), reach.Get(3), reach.Get(4)
    println graph.ReachableCount(g, 0), graph.ReachableCount(g, 3), graph.ReachableCount(g, 4)
    dist.Free()
    parent.Free()
    path.Free()
    bo.Free()
    po.Free()
    forest.Free()
    reach.Free()

    mut order := Vector {} as Vector<int>
    println graph.TopologicalSort(g, order)
    show("topo", order)
    mut pc := graph.PathCounts(g, 0)
    showf("paths", pc)
    println graph.SCCCount(g)
    mut hops := graph.AllPairsHops(g)
    println hops.at(0, 4), hops.at(4, 0), hops.at(1, 2)
    hops.Free()
    mut icen := graph.InDegreeCentrality(g)
    mut ocen := graph.OutDegreeCentrality(g)
    showf("in", icen)
    showf("out", ocen)
    graph.ScaleToSum(icen)
    println f(graph.SumFloat(icen))
    icen.Free()
    ocen.Free()
    pc.Free()
    order.Free()

    mut cyc := graph.NewDirected(3)
    cyc.add_edge(0, 1)
    cyc.add_edge(1, 2)
    cyc.add_edge(2, 0)
    mut co := Vector {} as Vector<int>
    println graph.TopologicalSort(cyc, co)
    println graph.SCCCount(cyc)
    co.Free()
    cyc.Free()

    mut fnet := graph.FlowFromGraph(g)
    println f(graph.MaxFlow(fnet, 0, 4))
    fnet.Free()
    g.Free()

    mut sq := graph.CycleGraph(4)
    mut col := Vector {} as Vector<int>
    println graph.IsBipartite(sq, col)
    show("colors", col)
    mut ord := Vector {} as Vector<int>
    graph.Iota(ord, 4)
    mut gc := graph.GreedyColoring(sq, ord)
    show("greedy", gc)
    println graph.IsProperColoring(sq, gc)
    gc.Free()
    col.Free()
    ord.Free()
    mut tri := graph.CycleGraph(3)
    mut col3 := Vector {} as Vector<int>
    println graph.IsBipartite(tri, col3)
    col3.Free()
    tri.Free()

    println graph.Eccentricity(sq, 0)
    mut ecc := graph.EccentricityAll(sq)
    show("ecc", ecc)
    ecc.Free()
    println f(graph.AveragePathLength(sq))
    println f(graph.MSTWeight(sq))
    mut indep := graph.MaximumIndependentSet(sq)
    println indep.Len()
    indep.Free()
    mut tour := graph.TSPHeuristic(sq, 0)
    println tour.Len()
    show("tour", tour)
    tour.Free()
    sq.Free()

    mut w := graph.NewUndirected(4)
    w.add_weighted(0, 1, 1.5)
    w.add_weighted(1, 2, 2.5)
    w.add_weighted(2, 3, 3.0)
    println f(graph.WeightedDiameter(w))
    println f(graph.MSTWeight(w))
    mut star := graph.StarGraph(5)
    println f(graph.Assortativity(star))
    star.Free()
    w.Free()

    mut t := graph.PathGraph(4)
    mut tp := Vector {} as Vector<int>
    mut tord := Vector {} as Vector<int>
    graph.RootTree(t, 0, tp, tord)
    show("tparent", tp)
    show("torder", tord)
    println graph.TreeToString(t, 0)
    tp.Free()
    tord.Free()
    t.Free()
end
