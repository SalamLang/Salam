=== the schema this server serves ===
"A very small blog."
type Query {
  "The signed-in user, taken from the request context."
  me: User
  post(id: ID!): Post
  posts(first: Int = 10, status: Status = PUBLISHED): [Post!]!
  secret: String
}

type Mutation {
  publish(input: NewPost!): Post!
}

type User {
  id: ID!
  name: String!
  initials: String!
}

type Post {
  id: ID!
  title: String!
  status: Status!
  author: User!
  wordCount: Int!
}

enum Status {
  DRAFT
  PUBLISHED
}

input NewPost {
  title: String!
  body: String!
}

=== queries ===
a plain field:
  {"data": {"posts": [{"title": "Hello, world"}, {"title": "On compilers"}]}}
arguments, with the defaults left alone:
  {"data": {"posts": [{"id": "1", "status": "PUBLISHED", "title": "Hello, world"}, {"id": "3", "status": "PUBLISHED", "title": "On compilers"}]}}
overriding a default argument:
  {"data": {"posts": [{"title": "Notes to self"}]}}
limiting with first:
  {"data": {"posts": [{"title": "Hello, world"}]}}
a nested object and a derived field:
  {"data": {"post": {"author": {"initials": "AL", "name": "Ada Lovelace"}, "title": "Hello, world", "wordCount": 42}}}
a field that resolves to null:
  {"data": {"post": null}}
an alias:
  {"data": {"latest": [{"title": "Hello, world"}]}}
=== the context decides what a resolver can see ===
anonymous:
  {"data": {"me": null, "secret": null}, "errors": [{"locations": [{"column": 15, "line": 1}], "message": "you must be signed in to read this", "path": ["secret"]}]}
signed in:
  {"data": {"me": {"initials": "AL", "name": "Ada Lovelace"}, "secret": "42"}}
=== variables ===
a query with variables:
  {"data": {"post": {"title": "Hello, world"}}}
=== mutations ===
publishing a post:
  {"data": {"publish": {"id": "4", "title": "New", "wordCount": 3}}}
=== fragments and directives ===
a named fragment:
  {"data": {"posts": [{"id": "1", "title": "Hello, world"}, {"id": "3", "title": "On compilers"}]}}
@skip and @include:
  {"data": {"posts": [{"title": "Hello, world"}, {"title": "On compilers"}]}}
=== errors ===
a field that does not exist is refused before execution:
  {"errors": [{"locations": [{"column": 11, "line": 1}], "message": "cannot query field \"nope\" on type \"Post\""}]}
a missing required argument:
  {"errors": [{"locations": [{"column": 0, "line": 1}], "message": "field \"post\" requires argument \"id\""}, {"locations": [{"column": 3, "line": 1}], "message": "field \"post\" of type \"Post\" must have a selection set"}]}
an argument of the wrong type:
  {"errors": [{"locations": [{"column": 0, "line": 1}], "message": "argument \"first\" is invalid: Int cannot represent a non-numeric value"}]}
=== introspection: what any GraphQL client asks on connect ===
the root type names:
  {"data": {"__schema": {"mutationType": {"name": "Mutation"}, "queryType": {"name": "Query"}}}}
one type in detail:
  {"data": {"__type": {"fields": [{"name": "id", "type": {"kind": "NON_NULL", "ofType": {"name": "ID"}}}, {"name": "title", "type": {"kind": "NON_NULL", "ofType": {"name": "String"}}}, {"name": "status", "type": {"kind": "NON_NULL", "ofType": {"name": "Status"}}}, {"name": "author", "type": {"kind": "NON_NULL", "ofType": {"name": "User"}}}, {"name": "wordCount", "type": {"kind": "NON_NULL", "ofType": {"name": "Int"}}}], "kind": "OBJECT", "name": "Post"}}}
an enum's values:
  {"data": {"__type": {"enumValues": [{"name": "DRAFT"}, {"name": "PUBLISHED"}]}}}
=== transport details ===
a GET with the query in the URL: 200
  {"data": {"posts": [{"title": "Hello, world"}]}}
a mutation over GET is refused: 405
a malformed body: 400
  {"errors": [{"message": "request body is not valid JSON"}]}
=== reading a response as a client ===
title:    Hello, world
initials: AL
