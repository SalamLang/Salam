package main

// A worked example of std/graphql: a small blog API, from schema text to
// an HTTP response.
//
// It runs start to finish without opening a socket, because
// graphql.HandleHttp takes the parts of a request (method, content
// type, body, query string) and returns a status and a body. Mounting
// that on the real server is the four lines at the bottom of this file.
//
// The five things worth taking away:
//
//   1. the schema is ordinary SDL text, parsed at startup;
//   2. a resolver is a plain `func(slot: i64)` registered against one
//      field, reading its inputs through graphql.Arg* / graphql.Parent
//      and answering with graphql.Resolve*;
//   3. per-request state (here, the signed-in user) travels in the
//      context, not in a global;
//   4. a field that fails calls graphql.Fail, and the response carries
//      the message with the path to the field that produced it;
//   5. the same schema answers introspection, so any GraphQL client can
//      discover the API without being told about it.

import graphql
import encoding.value
import encoding.json
import encoding.encerr
import str

// ---- the schema ----

func schema_text(): str:
    ret "\"\"\"\nA very small blog.\n\"\"\"\n" +
        "type Query {\n" +
        "  \"The signed-in user, taken from the request context.\"\n" +
        "  me: User\n" +
        "  post(id: ID!): Post\n" +
        "  posts(first: Int = 10, status: Status = PUBLISHED): [Post!]!\n" +
        "  secret: String\n" +
        "}\n" +
        "\n" +
        "type Mutation {\n" +
        "  publish(input: NewPost!): Post!\n" +
        "}\n" +
        "\n" +
        "type User {\n" +
        "  id: ID!\n" +
        "  name: String!\n" +
        "  initials: String!\n" +
        "}\n" +
        "\n" +
        "type Post {\n" +
        "  id: ID!\n" +
        "  title: String!\n" +
        "  status: Status!\n" +
        "  author: User!\n" +
        "  wordCount: Int!\n" +
        "}\n" +
        "\n" +
        "enum Status {\n" +
        "  DRAFT\n" +
        "  PUBLISHED\n" +
        "}\n" +
        "\n" +
        "input NewPost {\n" +
        "  title: String!\n" +
        "  body: String!\n" +
        "}\n"
end

// ---- the data these resolvers stand in for ----

func mk_user(id: str, name: str): value.Value:
    mut u := value.NewValueObject()
    value.ObjectSet(u, "id", value.ValueString(id))
    value.ObjectSet(u, "name", value.ValueString(name))
    ret u
end

func mk_post(id: str, title: str, status: str, authorName: str, words: i64): value.Value:
    mut p := value.NewValueObject()
    value.ObjectSet(p, "id", value.ValueString(id))
    value.ObjectSet(p, "title", value.ValueString(title))
    value.ObjectSet(p, "status", value.ValueString(status))
    value.ObjectSet(p, "author", mk_user("u1", authorName))
    value.ObjectSet(p, "wordCount", value.ValueInt(words))
    ret p
end

// ---- resolvers ----

// The context is whatever the caller handed to HandleHttp, so a
// request-scoped value like the authenticated user needs no global.
func r_me(slot: i64):
    ctx := graphql.Context(slot)
    if !value.ObjectHas(ctx, "user"):
        graphql.ResolveNull(slot)
        ret
    end
    graphql.Resolve(slot, value.ObjectGet(ctx, "user"))
end

// A field with no resolver falls back to reading its own name off the
// parent object, so `id` and `name` on User need nothing registered.
// `initials` does, because it is derived rather than stored.
func r_initials(slot: i64):
    name := value.AsString(graphql.ParentField(slot, "name"))
    mut out := ""
    mut want := true
    mut i := 0
    until i < name.len():
        c := name.substr(i, 1)
        if c == " ":
            want = true
        else:
            if want:
                out = out + str.Upper(c)
                want = false
            end
        end
        i += 1
    end
    graphql.ResolveStr(slot, out)
end

func r_post(slot: i64):
    id := graphql.ArgStr(slot, "id")
    if id != "1":
        graphql.ResolveNull(slot)
        ret
    end
    graphql.Resolve(slot, mk_post("1", "Hello, world", "PUBLISHED", "Ada Lovelace", 42 as i64))
end

// Arguments arrive already coerced and defaulted, so `first` and
// `status` are always present even when the query omitted them.
func r_posts(slot: i64):
    first := graphql.ArgInt(slot, "first")
    status := graphql.ArgStr(slot, "status")
    mut all := value.NewValueArray()
    value.ArrayPush(all, mk_post("1", "Hello, world", "PUBLISHED", "Ada Lovelace", 42 as i64))
    value.ArrayPush(all, mk_post("2", "Notes to self", "DRAFT", "Ada Lovelace", 7 as i64))
    value.ArrayPush(all, mk_post("3", "On compilers", "PUBLISHED", "Grace Hopper", 900 as i64))
    mut out := value.NewValueArray()
    mut i := 0
    until i < value.ArrayLen(all):
        p := value.ArrayGet(all, i)
        i += 1
        if value.AsString(value.ObjectGet(p, "status")) != status: continue end
        if (value.ArrayLen(out) as i64) >= first: break end
        value.ArrayPush(out, p)
    end
    graphql.Resolve(slot, out)
end

// A resolver reports failure with graphql.Fail. Because `secret` is
// nullable the rest of the response survives; had it been `String!`
// the null would have propagated to its parent instead.
func r_secret(slot: i64):
    ctx := graphql.Context(slot)
    if !value.ObjectHas(ctx, "user"):
        graphql.Fail(slot, "you must be signed in to read this")
        ret
    end
    graphql.ResolveStr(slot, "42")
end

func r_publish(slot: i64):
    // `input` is a reserved word in Salam, so the argument's value is
    // bound to a differently named local; the GraphQL argument itself is
    // still called `input`, since it is only ever named by a string.
    inp := graphql.Arg(slot, "input")
    title := value.AsString(value.ObjectGet(inp, "title"))
    body := value.AsString(value.ObjectGet(inp, "body"))
    graphql.Resolve(slot, mk_post("4", title, "PUBLISHED", "Ada Lovelace", word_count(body)))
end

func word_count(s: str): i64:
    mut n := 0 as i64
    mut inWord := false
    mut i := 0
    until i < s.len():
        c := s.substr(i, 1)
        if c == " ":
            inWord = false
        else:
            if !inWord:
                n += 1
                inWord = true
            end
        end
        i += 1
    end
    ret n
end

func build_schema(): graphql.Schema:
    mut err := graphql.GqlError {}
    mut sch := graphql.ParseSchema(schema_text(), err)
    if err.message != "":
        println "schema error: " + graphql.ErrorString(err)
        ret sch
    end
    graphql.SetResolver(sch, "Query", "me", funcptr(r_me))
    graphql.SetResolver(sch, "Query", "post", funcptr(r_post))
    graphql.SetResolver(sch, "Query", "posts", funcptr(r_posts))
    graphql.SetResolver(sch, "Query", "secret", funcptr(r_secret))
    graphql.SetResolver(sch, "Mutation", "publish", funcptr(r_publish))
    graphql.SetResolver(sch, "User", "initials", funcptr(r_initials))
    ret sch
end

// ---- driving it like a server would ----

func anonymous(): value.Value: ret value.NewValueObject() end

func signed_in(): value.Value:
    mut ctx := value.NewValueObject()
    value.ObjectSet(ctx, "user", mk_user("u1", "Ada Lovelace"))
    ret ctx
end

// Responses are reprinted with their object keys sorted so this
// example's output is byte-for-byte reproducible. A real client would
// print res.body as it arrived; see gql_result.salam for why the
// unsorted order of a HashMap-backed value tree is not stable.
func stable(body: str): str:
    mut err := encerr.NoError()
    v := json.Decode(body, err)
    if encerr.IsError(err): ret body end
    mut opts := json.JSONOptions {}
    opts.sort_keys = true
    ret json.Encode(v, opts)
end

// One request in, one response out: exactly what an HTTP handler does.
func request(sch: graphql.Schema, label: str, body: str, ctx: value.Value):
    res := graphql.HandleHttp(sch, "POST", "application/json", body, "",
        value.NewValueObject(), ctx)
    println label
    println "  " + stable(res.body)
end

func query(sch: graphql.Schema, label: str, q: str, ctx: value.Value):
    request(sch, label, graphql.BuildQueryBody(q), ctx)
end

func main:
    mut sch := build_schema()

    println "=== the schema this server serves ==="
    println graphql.PrintSchema(sch)

    println "=== queries ==="
    query(sch, "a plain field:", "{ posts { title } }", anonymous())
    query(sch, "arguments, with the defaults left alone:",
        "{ posts { id title status } }", anonymous())
    query(sch, "overriding a default argument:",
        "{ posts(status: DRAFT) { title } }", anonymous())
    query(sch, "limiting with first:", "{ posts(first: 1) { title } }", anonymous())
    query(sch, "a nested object and a derived field:",
        `{ post(id: "1") { title author { name initials } wordCount } }`, anonymous())
    query(sch, "a field that resolves to null:", `{ post(id: "99") { title } }`, anonymous())
    query(sch, "an alias:", "{ latest: posts(first: 1) { title } }", anonymous())

    println "=== the context decides what a resolver can see ==="
    query(sch, "anonymous:", "{ me { name } secret }", anonymous())
    query(sch, "signed in:", "{ me { name initials } secret }", signed_in())

    println "=== variables ==="
    mut vars := value.NewValueObject()
    value.ObjectSet(vars, "id", value.ValueString("1"))
    request(sch, "a query with variables:",
        graphql.BuildRequestBody("query P($id: ID!) { post(id: $id) { title } }", "P", vars),
        anonymous())

    println "=== mutations ==="
    query(sch, "publishing a post:",
        `mutation { publish(input: {title: "New", body: "one two three"}) { id title wordCount } }`,
        signed_in())

    println "=== fragments and directives ==="
    query(sch, "a named fragment:",
        "{ posts { ...Card } } fragment Card on Post { id title }", anonymous())
    query(sch, "@skip and @include:",
        "{ posts { title status @include(if: false) } }", anonymous())

    println "=== errors ==="
    query(sch, "a field that does not exist is refused before execution:",
        "{ posts { nope } }", anonymous())
    query(sch, "a missing required argument:", "{ post }", anonymous())
    query(sch, "an argument of the wrong type:", "{ posts(first: \"lots\") { title } }", anonymous())

    println "=== introspection: what any GraphQL client asks on connect ==="
    query(sch, "the root type names:",
        "{ __schema { queryType { name } mutationType { name } } }", anonymous())
    query(sch, "one type in detail:",
        `{ __type(name: "Post") { name kind fields { name type { kind ofType { name } } } } }`,
        anonymous())
    query(sch, "an enum's values:",
        `{ __type(name: "Status") { enumValues { name } } }`, anonymous())

    println "=== transport details ==="
    getRes := graphql.HandleHttpSimple(sch, "GET", "", "",
        graphql.BuildRequestQueryString("{ posts(first: 1) { title } }", "", value.NewValueObject()))
    println "a GET with the query in the URL: " + int_str(getRes.status)
    println "  " + stable(getRes.body)

    mutOverGet := graphql.HandleHttpSimple(sch, "GET", "", "",
        graphql.BuildRequestQueryString(`mutation { publish(input: {title: "x", body: "y"}) { id } }`, "", value.NewValueObject()))
    println "a mutation over GET is refused: " + int_str(mutOverGet.status)

    bad := graphql.HandleHttpSimple(sch, "POST", "application/json", "{ this is not json", "")
    println "a malformed body: " + int_str(bad.status)
    println "  " + stable(bad.body)

    println "=== reading a response as a client ==="
    res := graphql.HandleHttpSimple(sch, "POST", "application/json",
        graphql.BuildQueryBody(`{ post(id: "1") { title author { initials } } }`), "")
    mut parsed := graphql.ParseResponse(res.body)
    post := graphql.ResponseField(parsed, "post")
    println "title:    " + value.AsString(value.ObjectGet(post, "title"))
    println "initials: " + value.AsString(value.ObjectGet(value.ObjectGet(post, "author"), "initials"))
    graphql.FreeClientResponse(parsed)

    // Mounting this on the real server is the whole integration:
    //
    //     import net.http
    //     import net.router
    //
    //     func gql_handler(h: i64):
    //         res := graphql.HandleHttpSimple(_schema, http.Ctx_method(h),
    //             http.Ctx_header(h, "Content-Type"), http.Ctx_body(h), "")
    //         http.Ctx_status(h, res.status)
    //         http.Ctx_json(h, res.body)
    //     end
    //
    //     router.Post(r, "/graphql", funcptr(gql_handler))
    //
    // std/graphql deliberately does not import net/http itself: linking a
    // package pulls in every extern its public functions reference, and a
    // program that only parses a schema should not need sockets.

    graphql.FreeSchema(sch)
    ret 0
end

func int_str(n: int): str:
    mut digits := ""
    mut v := n
    if v == 0: ret "0" end
    until v > 0:
        digits = "0123456789".substr(v % 10, 1) + digits
        v = v / 10
    end
    ret digits
end
