import grpc

func main:
    mut md := grpc.NewMetadata()
    println grpc.MDAdd(md, "x-trace", "t-42")
    println grpc.MDAdd(md, "X-Request.ID_2", "abc")
    println grpc.MDAdd(md, "bad key", "x")
    println grpc.MDAdd(md, "", "x")
    println grpc.MDAdd(md, "x-name", "سلام")
    println grpc.MDAdd(md, "x-evil", "a\r\nb: c")
    println grpc.MDAddBinary(md, "trace-bin", "\x01\x02")
    println grpc.MDAddBinary(md, "bad key-bin", "x")
    println grpc.MDCount(md), grpc.MDGet(md, "x-request.id_2")
end
