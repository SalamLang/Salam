import gui.color
import math

func r4(v: f64): f64:
    ret math.Round(v * 10000.0) / 10000.0 + 0.0
end

func channels(label: str, c: color.Color):
    println label, "=>", r4(c.r), r4(c.g), r4(c.b), r4(c.a), color.Css(c)
end

func parsed(text: str): color.Color:
    mut c := color.Color {}
    if not color.Parse(text, c):
        println "unexpected error:", color.Error(text)
    end
    ret c
end

func main:
    println "reference values"
    each text in ["lab(29.2345% 39.3825 20.0664)", "lch(52.2345% 72.2 56.2)", "oklab(40.101% 0.1147 0.0453)", "oklch(59.686% 0.15619 49.7694)", "hwb(194 0% 0%)", "color(display-p3 1 0 0)", "color(rec2020 0.5 0.3 0.2)", "color(prophoto-rgb 0.5 0.3 0.2)", "color(a98-rgb 0.5 0.3 0.2)", "color(xyz-d50 0.3 0.2 0.1)", "color(xyz-d65 0.3 0.2 0.1)", "color(srgb-linear 0.5 0.3 0.2)", "color(xyz-d65 0.9505 1 1.089)", "color(xyz-d50 0.9643 1 0.8251)", "lab(100 0 0)", "oklab(1 0 0)"]:
        channels(text, parsed(text))
    end
    println "constructors"
    channels("Rgb(51, 102, 170)", color.Rgb(51, 102, 170))
    channels("Rgba(51, 102, 170, 0.5)", color.Rgba(51, 102, 170, 0.5))
    channels("Hex(0x3366aa)", color.Hex(0x3366aa))
    channels("New(0.2, 0.4, 0.6, 1.0)", color.New(0.2, 0.4, 0.6, 1.0))
    channels("Hsl(210, 0.5, 0.4)", color.Hsl(210.0, 0.5, 0.4))
    channels("Hwb(194, 0, 0)", color.Hwb(194.0, 0.0, 0.0))
    channels("Lab(29.2345, 39.3825, 20.0664)", color.Lab(29.2345, 39.3825, 20.0664))
    channels("Lch(52.2345, 72.2, 56.2)", color.Lch(52.2345, 72.2, 56.2))
    channels("Oklab(0.40101, 0.1147, 0.0453)", color.Oklab(0.40101, 0.1147, 0.0453))
    channels("Oklch(0.59686, 0.15619, 49.7694)", color.Oklch(0.59686, 0.15619, 49.7694))
    channels("Cmyk(0, 0.4, 0.6, 0.1)", color.Cmyk(0.0, 0.4, 0.6, 0.1))
    channels("Current()", color.Current())
    println "argb"
    println "Argb red", color.Argb(parsed("red"))
    println "Argb #3366aa80", color.Argb(parsed("#3366aa80"))
    println "Argb transparent", color.Argb(parsed("transparent"))
    println "Argb current", color.Argb(color.Current())
    println "Argb clamps display-p3 red", color.Argb(parsed("color(display-p3 1 0 0)"))
    println "Argb clamps New(1.5, -0.5, 0.5, 2)", color.Argb(color.New(1.5, -0.5, 0.5, 2.0))
    channels("FromArgb(0xff3366aa)", color.FromArgb(0xff3366aa as u32))
    channels("FromArgb(0x803366aa)", color.FromArgb(0x803366aa as u32))
    channels("FromArgb(0)", color.FromArgb(0 as u32))
    println "round trips"
    each text in ["red", "#3366aa", "#3366aa80", "rgb(1 2 3 / 0.1)", "hsl(300, 76%, 72%)", "oklch(0.7 0.25 30)", "oklch(0.5 0.1 180)", "color(display-p3 1 0 0)", "color(rec2020 0.9 0.1 0.3 / 0.75)", "light dark(white, #333)", "light dark(current, color(display-p3 0 1 0))", "current", "transparent"]:
        c := parsed(text)
        css := color.Css(c)
        back := parsed(css)
        argb_same := color.Argb(c) == color.Argb(color.FromArgb(color.Argb(c)))
        println text, "=>", css, "=>", color.Css(back), color.Equal(c, back) or css == color.Css(back), argb_same
    end
    println "source"
    each text in ["red", "#3366aa80", "transparent", "current", "hsl(210, 50%, 40%)", "oklch(0.7 0.25 30)", "light dark(white, black)", "light dark(rgb(1 2 3 / 0.5), current)"]:
        println text, "=>", color.Source(parsed(text))
    end
end
