import gui.color
import math

func r4(v: f64): f64:
    ret math.Round(v * 10000.0) / 10000.0 + 0.0
end

func parsed(text: str): color.Color:
    mut c := color.Color {}
    if not color.Parse(text, c):
        println "unexpected error:", color.Error(text)
    end
    ret c
end

func main:
    red := parsed("red")
    blue := parsed("blue")
    white := parsed("white")
    black := parsed("black")
    println "mix"
    each t in [0.0, 0.25, 0.5, 0.75, 1.0, -1.0, 2.0]:
        println "Mix red blue", t, color.Css(color.Mix(red, blue, t))
    end
    each sp in ["oklab", "oklch", "lab", "lch", "srgb", "srgb linear", "srgb-linear", "hsl", "hwb", "xyz", "xyz d50", "display p3", "a98 rgb", "prophoto rgb", "rec2020", "unknown"]:
        println "MixIn red blue 0.5", sp, color.Css(color.MixIn(red, blue, 0.5, sp))
    end
    println "MixIn hue shorter arc", color.Css(color.MixIn(parsed("hsl(350, 100%, 50%)"), parsed("hsl(10, 100%, 50%)"), 0.5, "hsl"))
    println "MixIn grey keeps the other hue", color.Css(color.MixIn(parsed("grey"), parsed("oklch(0.6 0.2 140)"), 0.5, "oklch"))
    println "lerp"
    each t in [0.0, 0.1, 0.5, 0.9, 1.0]:
        println "Lerp white black", t, color.Css(color.Lerp(white, black, t))
    end
    println "Lerp overshoots", r4(color.Lerp(black, white, 1.1).r)
    println "Lerp transparent red 0.5", color.Css(color.Lerp(parsed("transparent"), red, 0.5))
    println "Lerp premultiplied", color.Css(color.Lerp(parsed("rgb(255 0 0 / 0.1)"), parsed("rgb(0 0 255 / 0.9)"), 0.5))
    println "Lerp current", color.Css(color.Lerp(color.Current(), red, 0.4)), color.Css(color.Lerp(color.Current(), red, 0.6))
    ld := parsed("light dark(white, black)")
    println "Lerp light dark", color.Css(color.Lerp(ld, red, 0.5))
    println "light dark"
    println "HasDark", color.HasDark(ld), color.HasDark(red)
    println "Light", color.Css(color.Light(ld)), "Dark", color.Css(color.Dark(ld))
    println "Dark without a dark variant", color.Css(color.Dark(red))
    println "LightDark", color.Css(color.LightDark(red, blue))
    println "LightDark of light darks", color.Css(color.LightDark(ld, parsed("light dark(red, green)")))
    println "accessibility"
    println "Luminance", r4(color.Luminance(white)), r4(color.Luminance(black)), r4(color.Luminance(red)), r4(color.Luminance(parsed("#777"))), r4(color.Luminance(parsed("#3366aa")))
    println "Contrast", r4(color.Contrast(white, black)), r4(color.Contrast(black, white)), r4(color.Contrast(parsed("#777"), white)), r4(color.Contrast(parsed("#3366aa"), white)), r4(color.Contrast(red, red))
    println "Lighten", color.Css(color.Lighten(parsed("#3366aa"), 0.1)), color.Css(color.Lighten(black, 2.0)), color.Css(color.Lighten(ld, 0.1))
    println "Darken", color.Css(color.Darken(parsed("#3366aa"), 0.1)), color.Css(color.Darken(white, 2.0)), color.Css(color.Darken(color.Current(), 0.1))
    println "helpers"
    println "WithAlpha", color.Css(color.WithAlpha(red, 0.5)), color.Css(color.WithAlpha(ld, 0.25))
    println "Equal", color.Equal(red, parsed("#f00")), color.Equal(red, parsed("#f01")), color.Equal(ld, parsed("light-dark(#fff, #000)")), color.Equal(color.Current(), parsed("current"))
    println "InGamut", color.InGamut(red), color.InGamut(parsed("color(display-p3 1 0 0)")), color.InGamut(parsed("light dark(white, color(rec2020 1 0 0))")), color.InGamut(color.Current())
end
