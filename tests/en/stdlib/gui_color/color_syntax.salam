import gui.color

func show(text: str):
    mut c := color.Color {}
    if color.Parse(text, c):
        println text, "=>", color.Css(c)
    else:
        println text, "error:", color.Error(text)
    end
end

func main:
    println "hex"
    each text in ["#fff", "#FFF", "#f008", "#3366aa", "#3366AA", "#3366aa80", "#۳۳۶۶aa", "  #abc  "]:
        show(text)
    end
    println "rgb"
    each text in ["rgb(51, 102, 170)", "rgb(51,102,170)", "rgba(51, 102, 170, 1)", "rgba(0, 0, 0, 0.25)", "rgba(0, 0, 0, 25%)", "rgb(20%, 40%, 66.6667%)", "rgb(51 102 170)", "rgb(51 102 170 / 0.5)", "rgb(51 102 170 / 50%)", "rgb(100% 0% 0% / 0.1)", "RGB(255, 0, 0)", "rgb(۵۱، ۱۰۲، ۱۷۰)", "rgba(۰، ۰، ۰، ۲۵٪)", "rgb(51.5, 102.4, 170)", "rgb(none 0 0)", "rgb(1e2, 0, 0)"]:
        show(text)
    end
    println "hsl and hwb"
    each text in ["hsl(210, 50%, 40%)", "hsla(210, 50%, 40%, 0.5)", "hsl(210 50% 40%)", "hsl(210 50 40)", "hsl(210deg 50% 40%)", "hsl(0.5833turn 50% 40%)", "hsl(3.6652rad 50% 40%)", "hsl(233.333grad 50% 40%)", "hsl(-150, 50%, 40%)", "hsl(570, 50%, 40%)", "hsl(120deg 100% 25%)", "hsl(۲۱۰، ۵۰٪، ۴۰٪)", "hsl(210DEG 50% 40%)", "hwb(194 0% 0%)", "hwb(194, 0%, 0%)", "hwb(0 50% 50%)", "hwb(0 70% 70%)", "hwb(120 20% 30% / 0.5)"]:
        show(text)
    end
    println "lab and lch"
    each text in ["lab(29.2345% 39.3825 20.0664)", "lab(29.2345, 39.3825, 20.0664)", "lab(52.2345% 40.1645 59.9971)", "lab(50 25% -25%)", "lch(52.2345% 72.2 56.2)", "lch(52.2345, 72.2, 56.2)", "lch(29.2345% 44.2 27)", "lch(50% 0 0)", "lab(100 0 0)", "lab(0 0 0)", "lab(50 20 30 / 0.4)"]:
        show(text)
    end
    println "oklab and oklch"
    each text in ["oklab(40.101% 0.1147 0.0453)", "oklab(0.40101, 0.1147, 0.0453)", "oklch(59.686% 0.15619 49.7694)", "oklch(0.59686, 0.15619, 49.7694)", "oklch(0.7 0.25 30)", "oklch(70% 62.5% 30)", "oklch(0.5 0.1 0.5turn)", "oklab(1 0 0)", "oklch(0.6 0.1 200 / 25%)"]:
        show(text)
    end
    println "cmyk"
    each text in ["cmyk(0, 40%, 60%, 10%)", "cmyk(0 0.4 0.6 0.1)", "cmyk(0, 0, 0, 0)", "cmyk(0, 0, 0, 1)", "cmyk(1, 0, 0, 0, 0.5)", "device cmyk(0 1 1 0)", "device-cmyk(0, 1, 1, 0)", "cmyk(۰، ۴۰٪، ۶۰٪، ۱۰٪)"]:
        show(text)
    end
    println "color()"
    each text in ["color(srgb, 0.2, 0.4, 0.6667)", "color(srgb 0.2 0.4 0.6667 / 0.5)", "color(srgb linear, 0.5, 0.3, 0.2)", "color(srgb-linear 0.5 0.3 0.2)", "color(display p3, 0.3, 0.6, 0.4)", "color(display-p3 1 0 0)", "color(Display-P3 0 1 0)", "color(a98 rgb, 0.5, 0.3, 0.2)", "color(a98-rgb 0.5 0.3 0.2)", "color(prophoto rgb, 0.5, 0.3, 0.2)", "color(prophoto-rgb 0.5 0.3 0.2)", "color(rec2020, 0.5, 0.3, 0.2)", "color(rec2020 1 0 0)", "color(xyz, 0.3, 0.2, 0.1)", "color(xyz d65, 0.3, 0.2, 0.1)", "color(xyz-d65 0.3 0.2 0.1)", "color(xyz d50, 0.3, 0.2, 0.1)", "color(xyz-d50 0.3 0.2 0.1)", "color(srgb, 50%, 25%, 100%)", "color(srgb 1.2 -0.1 0)"]:
        show(text)
    end
    println "mix"
    each text in ["mix(red, blue, 30%)", "mix(red, blue, 0.3)", "mix(red, blue)", "mix(red, blue, 0%)", "mix(red, blue, 100%)", "mix(red, blue, 50%, srgb)", "mix(red, blue, 50%, srgb linear)", "mix(red, blue, 50%, oklch)", "mix(red, blue, 50%, lch)", "mix(red, blue, 50%, lab)", "mix(red, blue, 50%, hsl)", "mix(red, blue, 50%, hwb)", "mix(red, blue, 50%, xyz)", "mix(red, blue, 50%, display p3)", "mix(red, transparent, 50%)", "mix(#3366aa, rgb(255 255 255 / 0.5), 25%)", "mix(mix(red, blue), white, 50%)", "ترکیب(قرمز، آبی، ۳۰٪)", "ترکیب رنگ(قرمز، آبی)"]:
        show(text)
    end
    println "light dark"
    each text in ["light dark(white, black)", "light-dark(white, black)", "light dark(#3366aa, rgb(200 220 255))", "light dark(current, white)", "light dark(light dark(red, green), blue)", "light dark(red, light dark(green, blue))", "mix(light dark(white, black), red, 50%)", "روشن تیره(سفید، سیاه)", "روشن‌تاریک(سفید، مشکی)"]:
        show(text)
    end
end
