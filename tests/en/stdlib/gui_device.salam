import gui.device

mut changes := 0

func state_name(s: device.PermissionState): str:
    if s == device.PermissionState.Granted:
        ret "granted"
    end
    if s == device.PermissionState.Denied:
        ret "denied"
    end
    ret "not asked"
end

func main:
    println "platform", device.Platform()
    println "can share", device.CanShare()
    println "share", device.Share("hello", "https://salamlang.ir")
    println "share url only", device.Share("", "https://salamlang.ir")
    println "share nothing", device.Share("", "")
    println "can vibrate", device.CanVibrate()
    println "vibrate", device.Vibrate(50)
    println "vibrate zero", device.Vibrate(0)
    println "haptic tap", device.Haptic(device.HapticKind.Tap)
    println "haptic heavy", device.Haptic(device.HapticKind.Heavy)
    println "haptic success", device.Haptic(device.HapticKind.Success)
    println "haptic failure", device.Haptic(device.HapticKind.Failure)
    println "camera", state_name(device.CheckPermission(device.Permission.Camera))
    println "location", state_name(device.CheckPermission(device.Permission.Location))
    println "request", device.RequestPermission(device.Permission.Notifications)
    device.Notify()
    device.OnChange((): changes++ end)
    device.Notify()
    device.Notify()
    println "changes", changes
    println "show", device.ShowNotification(1, "Title", "Body")
    println "show empty", device.ShowNotification(1, "", "")
    println "schedule", device.ScheduleNotification(2, "Title", "Body", 10)
    println "schedule now", device.ScheduleNotification(2, "Title", "Body", 0)
    println "cancel", device.CancelNotification(2)
    println "locate", device.RequestLocation()
    println "idle", device.LocationStatus() == device.LocationState.Idle
    here := device.LastLocation()
    println "here", here.latitude, here.longitude, here.accuracy
    println "pick", device.PickPhoto()
    println "take", device.TakePhoto()
    println "photo idle", device.PhotoStatus() == device.PhotoState.Idle
    println "photo path", device.LastPhoto().Len()
    println "data dir", device.DataDir().Len()
    println "cache dir", device.CacheDir().Len()
    println "documents dir", device.DocumentsDir().Len()
    println "temp dir", device.TempDir().Len()
    println "secure set", device.SecureSet("token", "abc")
    println "secure empty key", device.SecureSet("", "abc")
    println "secure get", device.SecureGet("token").Len()
    println "secure delete", device.SecureDelete("token")
    println "model", device.Model().Len()
    println "os", device.OSName().Len(), device.OSVersion().Len()
    println "language", device.Language().Len(), device.Languages().Len()
    println "zone", device.TimeZone().Len()
    println "density", device.ScreenDensity()
    println "app", device.AppVersion().Len(), device.BuildNumber()
    println "dark", device.IsDarkMode()
    println "battery", device.BatteryLevel(), device.IsCharging()
    println "network", device.Network() == device.NetworkKind.Offline
    device.OnOpenURL((url: str): changes += url.Len() end)
    device.Notify()
    println "launch url", device.LaunchURL().Len()
    println "settings", device.OpenSettings()
end
