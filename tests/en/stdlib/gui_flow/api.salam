import gui.flow

func show_len(name: str, l: flow.Len):
    println name, l.px, l.pct, l.kind
end

func main:
    show_len("Px", flow.Px(12.0))
    show_len("Pct", flow.Pct(0.5))
    show_len("PxPct", flow.PxPct(-8.0, 1.0))
    show_len("Auto", flow.Auto())
    show_len("Fill", flow.Fill())
    show_len("Fit", flow.Fit())
    show_len("MinContent", flow.MinContent())
    show_len("MaxContent", flow.MaxContent())
    show_len("NoLimit", flow.NoLimit())
    println "kinds", flow.LEN_FIXED, flow.LEN_AUTO, flow.LEN_FILL, flow.LEN_FIT, flow.LEN_MIN_CONTENT, flow.LEN_MAX_CONTENT, flow.LEN_NONE
    e := flow.All(flow.Px(4.0))
    println "All", e.top.px, e.end.px, e.bottom.px, e.start.px, e.left.kind, e.right.kind
    s := flow.Sides(flow.Px(1.0), flow.Px(2.0), flow.Px(3.0), flow.Px(4.0))
    println "Sides", s.top.px, s.end.px, s.bottom.px, s.start.px
    tl := flow.TrackLen(flow.Px(30.0))
    println "TrackLen", tl.min.px, tl.max.px, tl.fr
    tf := flow.TrackFr(2.0)
    println "TrackFr", tf.min.kind, tf.fr
    ta := flow.TrackAuto()
    println "TrackAuto", ta.min.kind, ta.max.kind
    tm := flow.TrackMinMax(flow.TrackLen(flow.Px(10.0)), flow.TrackFr(1.0))
    println "TrackMinMax", tm.min.px, tm.fr
    tfit := flow.TrackFit(flow.Px(80.0))
    println "TrackFit", tfit.max.px, tfit.fit
    mut inner := Vector {} as Vector<flow.Track>
    inner.push(tl)
    inner.push(tf)
    rp := flow.Repeat(flow.REPEAT_FILL, inner)
    println "Repeat", rp.count, rp.tracks.Len(), flow.REPEAT_FIT
    st := flow.FlowStyle {}
    println "defaults", st.layout, st.align, st.justify, st.align_content, st.grow, st.shrink, st.basis.kind, st.width.kind, st.max_width.kind, st.min_width.kind, st.visible, st.direction, st.column_span

    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, padding = flow.All(flow.Px(5.0)) })
    a := t.Add(root, flow.FlowStyle { width = flow.Px(20.0) })
    b := t.Add(root, flow.FlowStyle { width = flow.Px(30.0) })
    c := t.Add(b, flow.FlowStyle { height = flow.Px(10.0), margin = flow.All(flow.Px(3.0)) })
    println "valid", t.Valid(root), t.Valid(c), t.Valid(99), t.Valid(-1)
    println "count", t.Count(), "parent", t.Parent(c), t.Parent(root), "children", t.ChildCount(root), t.Child(root, 1), t.Child(root, 5)
    println "style", t.Style(a).width.px, t.Style(99).width.kind
    t.Layout(200.0, 100.0)
    println "c", t.X(c), t.Y(c), t.W(c), t.H(c), "abs", t.AbsX(c), t.AbsY(c), "baseline", t.Baseline(c)
    println "layer", t.Layer(c), "dirty", t.IsDirty(c)
    t.MarkDirty(c)
    println "marked", t.IsDirty(c), t.IsDirty(b), t.IsDirty(a)
    t.SetMeasure(a, (_id: int, _w: f64, _h: f64): ret flow.Size { w = 7.0, h = 9.0 } end)
    t.Layout(200.0, 100.0)
    println "measured", t.W(a), t.MeasureCalls() > 0
    t.ClearMeasure(a)
    t.Layout(200.0, 100.0)
    println "cleared", t.W(a)
    t.Move(c, root, 0)
    t.Move(root, c, 0)
    t.Layout(200.0, 100.0)
    println "moved", t.Child(root, 0), t.Parent(c), "cycle refused", t.Parent(root)
    t.Remove(b)
    println "removed", t.Valid(b), t.ChildCount(root), t.Count()
    t.SetScroll(root, 5.0, 5.0)
    println "scroll", t.ScrollX(root), t.ScrollY(root), t.ContentW(root), t.ContentH(root)
    order := t.PaintOrder(root)
    println "paint order", order.Len()
    calls := t.LayoutCalls()
    t.ResetCounters()
    println "counters", calls > 0, t.LayoutCalls(), t.MeasureCalls()
    println "invalid ids", t.X(-3), t.W(500), t.ChildCount(77), t.Parent(77)
    order.free()
    mut cols := Vector {} as Vector<flow.Track>
    cols.push(flow.TrackFr(1.0))
    cols.push(flow.TrackFr(1.0))
    g := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = cols })
    cols.free()
    cell := t.Add(g, flow.FlowStyle {})
    t.Add(g, flow.FlowStyle {})
    t.Layout(200.0, 100.0)
    println "grid keeps its own tracks", t.W(cell), t.Style(g).columns.Len()
    t.Free()
    println "freed", t.Count()
end
