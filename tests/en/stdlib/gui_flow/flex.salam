import gui.flow
import math

func r(v: f64): f64:
    x := math.Round(v * 100.0) / 100.0
    if x == 0.0:
        ret 0.0
    end
    ret x
end

func dump(t &: flow.Tree, id: int, depth: int):
    mut pad := ""
    repeat depth:
        pad += "  "
    end
    println pad + "#" + id, r(t.X(id)), r(t.Y(id)), r(t.W(id)), r(t.H(id))
    repeat t.ChildCount(id) in i:
        dump(t, t.Child(id, i), depth + 1)
    end
end

func box(w: f64, h: f64): flow.FlowStyle:
    ret flow.FlowStyle { width = flow.Px(w), height = flow.Px(h) }
end

func run(title: str, t &: flow.Tree, w: f64, h: f64):
    t.Layout(w, h)
    println "==", title
    dump(t, 0, 0)
end

func column_basics():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { padding = flow.All(flow.Px(10.0)), border = flow.All(flow.Px(2.0)), row_gap = flow.Px(4.0) })
    t.Add(root, flow.FlowStyle { height = flow.Px(30.0) })
    t.Add(root, flow.FlowStyle { height = flow.Px(20.0), width = flow.Px(50.0) })
    t.Add(root, flow.FlowStyle { height = flow.Px(10.0), margin = flow.Sides(flow.Px(5.0), flow.Px(7.0), flow.Px(3.0), flow.Px(6.0)) })
    t.Add(root, flow.FlowStyle { grow = 1.0 })
    run("column: stretch, padding, border, gap, margins, grow", t, 200.0, 200.0)
end

func row_grow_shrink():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(40.0) })
    t.Add(root, flow.FlowStyle { basis = flow.Px(100.0), grow = 1.0 })
    t.Add(root, flow.FlowStyle { basis = flow.Px(100.0), grow = 3.0 })
    t.Add(root, flow.FlowStyle { width = flow.Px(50.0) })
    run("row: grow by factor", t, 350.0, 100.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(40.0) })
    s.Add(sr, flow.FlowStyle { basis = flow.Px(200.0) })
    s.Add(sr, flow.FlowStyle { basis = flow.Px(100.0), shrink = 2.0 })
    s.Add(sr, flow.FlowStyle { basis = flow.Px(100.0), shrink = 0.0 })
    run("row: shrink weighted by basis", s, 300.0, 100.0)
end

func resolve_loop():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(20.0) })
    t.Add(root, flow.FlowStyle { basis = flow.Px(0.0), grow = 1.0, max_width = flow.Px(50.0) })
    t.Add(root, flow.FlowStyle { basis = flow.Px(0.0), grow = 1.0 })
    t.Add(root, flow.FlowStyle { basis = flow.Px(0.0), grow = 1.0, min_width = flow.Px(150.0) })
    run("row: max and min violations freeze and redistribute", t, 300.0, 100.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(20.0) })
    s.Add(sr, flow.FlowStyle { basis = flow.Px(100.0), grow = 0.25 })
    s.Add(sr, flow.FlowStyle { basis = flow.Px(100.0), grow = 0.25 })
    run("row: grow factors below one leave space", s, 400.0, 100.0)
    mut u := flow.NewTree()
    ur := u.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(20.0) })
    u.Add(ur, flow.FlowStyle { basis = flow.Px(200.0), min_width = flow.Px(180.0) })
    u.Add(ur, flow.FlowStyle { basis = flow.Px(200.0) })
    run("row: shrink with a min width", u, 300.0, 100.0)
end

func align_items():
    names := ["start", "center", "end", "stretch"]
    each i, a in [flow.ALIGN_START, flow.ALIGN_CENTER, flow.ALIGN_END, flow.ALIGN_STRETCH]:
        mut t := flow.NewTree()
        root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, align = a, height = flow.Px(100.0) })
        t.Add(root, flow.FlowStyle { width = flow.Px(30.0), height = flow.Px(20.0) })
        t.Add(root, flow.FlowStyle { width = flow.Px(30.0) })
        t.Add(root, flow.FlowStyle { width = flow.Px(30.0), height = flow.Px(40.0), align_self = flow.ALIGN_END })
        run("row align " + names[i], t, 200.0, 200.0)
    end
    mut c := flow.NewTree()
    cr := c.Add(-1, flow.FlowStyle { align = flow.ALIGN_CENTER })
    c.Add(cr, box(50.0, 10.0))
    c.Add(cr, flow.FlowStyle { height = flow.Px(10.0), max_width = flow.Px(80.0), align_self = flow.ALIGN_STRETCH })
    c.Add(cr, flow.FlowStyle { height = flow.Px(10.0), align_self = flow.ALIGN_START })
    run("column align center, self stretch with max, self start", c, 200.0, 200.0)
end

func justify():
    names := ["start", "center", "end", "between", "around", "evenly"]
    each i, j in [flow.ALIGN_START, flow.ALIGN_CENTER, flow.ALIGN_END, flow.ALIGN_BETWEEN, flow.ALIGN_AROUND, flow.ALIGN_EVENLY]:
        mut t := flow.NewTree()
        root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, justify = j, height = flow.Px(10.0), column_gap = flow.Px(10.0) })
        t.Add(root, box(40.0, 10.0))
        t.Add(root, box(40.0, 10.0))
        t.Add(root, box(40.0, 10.0))
        run("row justify " + names[i], t, 300.0, 100.0)
    end
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, justify = flow.ALIGN_AROUND, height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { width = flow.Px(150.0), height = flow.Px(10.0), shrink = 0.0 })
    t.Add(root, flow.FlowStyle { width = flow.Px(100.0), height = flow.Px(10.0), shrink = 0.0 })
    run("row justify around with negative free space centres", t, 200.0, 100.0)
end

func baseline():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, align = flow.ALIGN_BASELINE })
    a := t.Add(root, flow.FlowStyle { width = flow.Px(40.0) })
    t.SetMeasure(a, (_id: int, _w: f64, _h: f64): ret flow.Size { w = 40.0, h = 20.0, baseline = 16.0 } end)
    b := t.Add(root, flow.FlowStyle { width = flow.Px(40.0), padding = flow.Sides(flow.Px(10.0), flow.Px(0.0), flow.Px(0.0), flow.Px(0.0)) })
    t.SetMeasure(b, (_id: int, _w: f64, _h: f64): ret flow.Size { w = 40.0, h = 30.0, baseline = 24.0 } end)
    t.Add(root, box(40.0, 15.0))
    run("row baseline alignment", t, 300.0, 100.0)
    println "baseline", t.Baseline(root), t.Baseline(a), t.Baseline(b)
end

func auto_margins():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(60.0) })
    t.Add(root, box(40.0, 20.0))
    mut st := box(40.0, 20.0)
    st.margin.start = flow.Auto()
    t.Add(root, st)
    mut mid := box(40.0, 20.0)
    mid.margin = flow.All(flow.Auto())
    t.Add(root, mid)
    run("row auto margins push and centre", t, 300.0, 100.0)
end

func order_reverse():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { width = flow.Px(10.0), order = 2 })
    t.Add(root, flow.FlowStyle { width = flow.Px(20.0), order = -1 })
    t.Add(root, flow.FlowStyle { width = flow.Px(30.0) })
    run("row order", t, 100.0, 100.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, reverse = true, height = flow.Px(10.0), column_gap = flow.Px(5.0) })
    s.Add(sr, flow.FlowStyle { width = flow.Px(10.0) })
    s.Add(sr, flow.FlowStyle { width = flow.Px(20.0) })
    run("row reverse packs at the end", s, 100.0, 100.0)
    mut c := flow.NewTree()
    cr := c.Add(-1, flow.FlowStyle { reverse = true, justify = flow.ALIGN_END })
    c.Add(cr, flow.FlowStyle { height = flow.Px(10.0) })
    c.Add(cr, flow.FlowStyle { height = flow.Px(20.0) })
    run("column reverse with justify end", c, 50.0, 100.0)
end

func aspect():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { align = flow.ALIGN_START })
    t.Add(root, flow.FlowStyle { width = flow.Px(160.0), aspect_ratio = 16.0 / 9.0 })
    t.Add(root, flow.FlowStyle { height = flow.Px(50.0), aspect_ratio = 2.0 })
    t.Add(root, flow.FlowStyle { width = flow.Px(100.0), aspect_ratio = 1.0, max_height = flow.Px(40.0) })
    run("aspect ratio", t, 300.0, 300.0)
end

func auto_min():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle {})
    repeat 3 in i:
        mut st := flow.FlowStyle {}
        if i > 0:
            st.min_height = flow.Auto()
        end
        id := t.Add(root, st)
        t.SetMeasure(id, (_id: int, w: f64, _h: f64):
            mut lines := 1.0
            if w >= 0.0 and w < 100.0:
                lines = 3.0
            end
            ret flow.Size { w = 100.0, h = lines * 20.0, baseline = 15.0 }
        end)
    end
    run("column too short: default min 0 shrinks, min auto keeps the content height", t, 200.0, 50.0)
    mut rt := flow.NewTree()
    rr := rt.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW })
    repeat 2 in i:
        mut st := flow.FlowStyle {}
        if i == 1:
            st.min_width = flow.Auto()
        end
        id := rt.Add(rr, st)
        rt.SetMeasure(id, (_id: int, w: f64, _h: f64):
            if w < 0.0 or w >= 120.0:
                ret flow.Size { w = 120.0, h = 10.0 }
            end
            if w < 70.0:
                ret flow.Size { w = 70.0, h = 30.0 }
            end
            ret flow.Size { w = w, h = 20.0 }
        end)
    end
    run("row too narrow: min auto stops at the min content width", rt, 100.0, 50.0)
end

func main:
    column_basics()
    row_grow_shrink()
    resolve_loop()
    align_items()
    justify()
    baseline()
    auto_margins()
    order_reverse()
    aspect()
    auto_min()
end
