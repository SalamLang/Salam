import gui.flow
import math

func r(v: f64): f64:
    x := math.Round(v * 100.0) / 100.0
    if x == 0.0:
        ret 0.0
    end
    ret x
end

func dump(t &: flow.Tree, id: int, depth: int):
    mut pad := ""
    repeat depth:
        pad += "  "
    end
    println pad + "#" + id, r(t.X(id)), r(t.Y(id)), r(t.W(id)), r(t.H(id))
    repeat t.ChildCount(id) in i:
        dump(t, t.Child(id, i), depth + 1)
    end
end

func box(w: f64, h: f64): flow.FlowStyle:
    ret flow.FlowStyle { width = flow.Px(w), height = flow.Px(h) }
end

func run(title: str, t &: flow.Tree, w: f64, h: f64):
    t.Layout(w, h)
    println "==", title
    dump(t, 0, 0)
end
func tracks(a: flow.Track, b: flow.Track, c: flow.Track): Vector<flow.Track>:
    mut v := Vector {} as Vector<flow.Track>
    v.push(a)
    v.push(b)
    v.push(c)
    ret v
end

func one(a: flow.Track): Vector<flow.Track>:
    mut v := Vector {} as Vector<flow.Track>
    v.push(a)
    ret v
end

func text(t &: flow.Tree, parent: int, minw: f64, maxw: f64, h: f64): int:
    id := t.Add(parent, flow.FlowStyle {})
    t.SetMeasure(id, (_id: int, w: f64, _h: f64): ret flow.Size { w = w < 0.0 ? maxw : (w < minw ? minw : (w > maxw ? maxw : w)), h = h } end)
    ret id
end

func fixed_fr_percent():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = tracks(flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Pct(0.25)), flow.TrackFr(1.0)), rows = one(flow.TrackLen(flow.Px(30.0))), column_gap = flow.Px(10.0), row_gap = flow.Px(4.0) })
    repeat 5:
        t.Add(root, flow.FlowStyle {})
    end
    run("px, percent, fr and auto rows", t, 420.0, 300.0)
end

func intrinsic_tracks():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = tracks(flow.TrackLen(flow.MinContent()), flow.TrackLen(flow.MaxContent()), flow.TrackAuto()), align = flow.ALIGN_START })
    text(t, root, 30.0, 120.0, 10.0)
    text(t, root, 40.0, 90.0, 10.0)
    text(t, root, 20.0, 50.0, 10.0)
    run("min content, max content and auto columns", t, 400.0, 300.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = tracks(flow.TrackFit(flow.Px(60.0)), flow.TrackMinMax(flow.TrackLen(flow.Px(50.0)), flow.TrackFr(1.0)), flow.TrackMinMax(flow.TrackLen(flow.Px(30.0)), flow.TrackLen(flow.Px(80.0)))) })
    text(s, sr, 30.0, 120.0, 10.0)
    text(s, sr, 10.0, 10.0, 10.0)
    text(s, sr, 10.0, 10.0, 10.0)
    run("fit(60), minmax(50, 1fr), minmax(30, 80)", s, 200.0, 300.0)
    run("same grid squeezed", s, 120.0, 300.0)
end

func repeats():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = one(flow.Repeat(3, one(flow.TrackFr(1.0)))), auto_rows = flow.TrackLen(flow.Px(20.0)) })
    repeat 4:
        t.Add(root, flow.FlowStyle {})
    end
    run("repeat(3, 1fr), auto rows 20", t, 300.0, 300.0)
    mut f := flow.NewTree()
    fr := f.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = one(flow.Repeat(flow.REPEAT_FILL, one(flow.TrackLen(flow.Px(70.0))))), column_gap = flow.Px(10.0), auto_rows = flow.TrackLen(flow.Px(10.0)) })
    repeat 2:
        f.Add(fr, flow.FlowStyle {})
    end
    run("repeat(fill, 70) with gap 10 in 250", f, 250.0, 300.0)
    mut g := flow.NewTree()
    gr := g.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = one(flow.Repeat(flow.REPEAT_FIT, one(flow.TrackMinMax(flow.TrackLen(flow.Px(70.0)), flow.TrackFr(1.0))))), column_gap = flow.Px(10.0), auto_rows = flow.TrackLen(flow.Px(10.0)) })
    repeat 2:
        g.Add(gr, flow.FlowStyle {})
    end
    run("repeat(fit, minmax(70, 1fr)) collapses empty tracks", g, 250.0, 300.0)
end

func placement():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = tracks(flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Px(50.0))), auto_rows = flow.TrackLen(flow.Px(10.0)) })
    t.Add(root, flow.FlowStyle { column = 2, row = 2 })
    t.Add(root, flow.FlowStyle { column = -1, row_span = 2 })
    t.Add(root, flow.FlowStyle { column_span = 2 })
    t.Add(root, flow.FlowStyle { column_span = 2 })
    t.Add(root, flow.FlowStyle {})
    t.Add(root, flow.FlowStyle { row = 1 })
    t.Add(root, flow.FlowStyle { column = 4 })
    run("explicit lines, negative lines, spans, implicit column", t, 300.0, 300.0)
    mut d := flow.NewTree()
    dr := d.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, auto_flow = flow.AUTO_FLOW_ROW_DENSE, columns = tracks(flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Px(50.0))), auto_rows = flow.TrackLen(flow.Px(10.0)) })
    d.Add(dr, flow.FlowStyle {})
    d.Add(dr, flow.FlowStyle { column_span = 3 })
    d.Add(dr, flow.FlowStyle {})
    d.Add(dr, flow.FlowStyle {})
    run("dense fills the hole", d, 300.0, 300.0)
    mut c := flow.NewTree()
    cr := c.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, auto_flow = flow.AUTO_FLOW_COLUMN, rows = tracks(flow.TrackLen(flow.Px(10.0)), flow.TrackLen(flow.Px(10.0)), flow.TrackLen(flow.Px(10.0))), auto_columns = flow.TrackLen(flow.Px(40.0)) })
    repeat 5:
        c.Add(cr, flow.FlowStyle {})
    end
    run("auto flow column", c, 300.0, 300.0)
end

func alignment():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = tracks(flow.TrackLen(flow.Px(60.0)), flow.TrackLen(flow.Px(60.0)), flow.TrackLen(flow.Px(60.0))), rows = one(flow.TrackLen(flow.Px(40.0))), align = flow.ALIGN_CENTER })
    t.Add(root, box(20.0, 10.0))
    t.Add(root, flow.FlowStyle { height = flow.Px(10.0), justify_self = flow.ALIGN_END, width = flow.Px(20.0) })
    t.Add(root, flow.FlowStyle { align_self = flow.ALIGN_STRETCH, justify_self = flow.ALIGN_CENTER, width = flow.Px(20.0) })
    run("align center, justify self end and center", t, 300.0, 300.0)
    names := ["center", "end", "between", "around", "evenly"]
    each i, m in [flow.ALIGN_CENTER, flow.ALIGN_END, flow.ALIGN_BETWEEN, flow.ALIGN_AROUND, flow.ALIGN_EVENLY]:
        mut g := flow.NewTree()
        gr := g.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = tracks(flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Px(50.0))), auto_rows = flow.TrackLen(flow.Px(20.0)), justify = m, align_content = m, height = flow.Px(100.0) })
        repeat 4:
            g.Add(gr, flow.FlowStyle {})
        end
        run("grid content " + names[i], g, 250.0, 300.0)
    end
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = one(flow.TrackLen(flow.Px(50.0))), rows = tracks(flow.TrackAuto(), flow.TrackLen(flow.Px(20.0)), flow.TrackAuto()), align_content = flow.ALIGN_STRETCH, height = flow.Px(100.0) })
    repeat 3:
        s.Add(sr, flow.FlowStyle {})
    end
    run("align content stretch grows auto rows", s, 250.0, 300.0)
end

func baseline_rows():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = tracks(flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Px(50.0)), flow.TrackLen(flow.Px(50.0))), align = flow.ALIGN_BASELINE })
    a := t.Add(root, flow.FlowStyle {})
    t.SetMeasure(a, (_id: int, _w: f64, _h: f64): ret flow.Size { w = 10.0, h = 20.0, baseline = 15.0 } end)
    b := t.Add(root, flow.FlowStyle {})
    t.SetMeasure(b, (_id: int, _w: f64, _h: f64): ret flow.Size { w = 10.0, h = 30.0, baseline = 25.0 } end)
    t.Add(root, box(10.0, 8.0))
    run("baseline aligned row", t, 300.0, 300.0)
end

func main:
    fixed_fr_percent()
    intrinsic_tracks()
    repeats()
    placement()
    alignment()
    baseline_rows()
end
