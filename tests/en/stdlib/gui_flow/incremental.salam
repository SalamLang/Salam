import gui.flow
import math

func r(v: f64): f64:
    x := math.Round(v * 100.0) / 100.0
    if x == 0.0:
        ret 0.0
    end
    ret x
end

func dump(t &: flow.Tree, id: int, depth: int):
    mut pad := ""
    repeat depth:
        pad += "  "
    end
    println pad + "#" + id, r(t.X(id)), r(t.Y(id)), r(t.W(id)), r(t.H(id))
    repeat t.ChildCount(id) in i:
        dump(t, t.Child(id, i), depth + 1)
    end
end


func label(t &: flow.Tree, parent: int, chars: int): int:
    id := t.Add(parent, flow.FlowStyle {})
    t.SetMeasure(id, (_id: int, w: f64, _h: f64):
        full := (chars as f64) * 8.0
        if w < 0.0 or w >= full:
            ret flow.Size { w = full, h = 16.0, baseline = 12.0 }
        end
        lines := ((full / _max_one(w)) as int) + 1
        ret flow.Size { w = w, h = (lines as f64) * 16.0, baseline = 12.0 }
    end)
    ret id
end

func _max_one(v: f64): f64:
    if v < 8.0:
        ret 8.0
    end
    ret v
end

func counts(t &: flow.Tree, what: str):
    println what, "layout calls", t.LayoutCalls(), "measure calls", t.MeasureCalls()
    t.ResetCounters()
end

func main:
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { row_gap = flow.Px(2.0) })
    mut rows := Vector {} as Vector<int>
    mut first := Vector {} as Vector<int>
    repeat 100 in i:
        rw := t.Add(root, flow.FlowStyle { layout = flow.LAYOUT_ROW, column_gap = flow.Px(4.0), shrink = 0.0 })
        rows.push(rw)
        first.push(label(t, rw, 5 + i % 7))
        label(t, rw, 3)
        t.Add(rw, flow.FlowStyle { grow = 1.0 })
    end
    t.Layout(400.0, 300.0)
    counts(t, "first layout:")
    println "content height", t.ContentH(root)
    t.Layout(400.0, 300.0)
    counts(t, "same size again:")
    println "dirty after layout", t.IsDirty(root), t.IsDirty(first.get(50))
    leaf := first.get(50)
    mut st := t.Style(leaf)
    st.width = flow.Px(100.0)
    t.SetStyle(leaf, st)
    println "dirty path", t.IsDirty(leaf), t.IsDirty(rows.get(50)), t.IsDirty(root), "sibling row clean", not t.IsDirty(rows.get(49))
    t.Layout(400.0, 300.0)
    counts(t, "one leaf width changed:")
    dump(t, rows.get(50), 0)
    t.MarkDirty(first.get(10))
    t.Layout(400.0, 300.0)
    counts(t, "one text marked dirty:")
    t.Layout(300.0, 300.0)
    counts(t, "viewport resized:")
    t.Remove(rows.get(0))
    t.Layout(300.0, 300.0)
    counts(t, "first row removed:")
    println "children", t.ChildCount(root), "count", t.Count(), "first row now at", t.Y(rows.get(1))
    t.Move(rows.get(99), root, 0)
    t.Layout(300.0, 300.0)
    counts(t, "last row moved to the top:")
    println "moved row at", t.Y(rows.get(99)), "next at", t.Y(rows.get(1))
    n := t.Add(rows.get(5), flow.FlowStyle { width = flow.Px(10.0) })
    println "removed id reused", n == rows.get(0)
    t.Layout(300.0, 300.0)
    counts(t, "child added:")
    t.ClearMeasure(first.get(20))
    t.Layout(300.0, 300.0)
    counts(t, "measure cleared:")
    println "cleared leaf width", t.W(first.get(20))
end
