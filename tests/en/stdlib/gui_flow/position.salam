import gui.flow
import math

func r(v: f64): f64:
    x := math.Round(v * 100.0) / 100.0
    if x == 0.0:
        ret 0.0
    end
    ret x
end

func dump(t &: flow.Tree, id: int, depth: int):
    mut pad := ""
    repeat depth:
        pad += "  "
    end
    println pad + "#" + id, r(t.X(id)), r(t.Y(id)), r(t.W(id)), r(t.H(id))
    repeat t.ChildCount(id) in i:
        dump(t, t.Child(id, i), depth + 1)
    end
end

func box(w: f64, h: f64): flow.FlowStyle:
    ret flow.FlowStyle { width = flow.Px(w), height = flow.Px(h) }
end

func run(title: str, t &: flow.Tree, w: f64, h: f64):
    t.Layout(w, h)
    println "==", title
    dump(t, 0, 0)
end
func ins(top: flow.Len, trailing: flow.Len, bottom: flow.Len, leading: flow.Len): flow.Edges:
    ret flow.Sides(top, trailing, bottom, leading)
end

func absolute():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { padding = flow.All(flow.Px(10.0)), border = flow.All(flow.Px(5.0)), width = flow.Px(300.0), height = flow.Px(200.0) })
    t.Add(root, flow.FlowStyle { height = flow.Px(30.0) })
    t.Add(root, flow.FlowStyle { position = flow.POS_ABSOLUTE, inset = ins(flow.Px(10.0), flow.Auto(), flow.Auto(), flow.Px(20.0)), width = flow.Px(50.0), height = flow.Px(40.0) })
    t.Add(root, flow.FlowStyle { position = flow.POS_ABSOLUTE, inset = ins(flow.Px(10.0), flow.Px(10.0), flow.Px(10.0), flow.Px(10.0)) })
    t.Add(root, flow.FlowStyle { position = flow.POS_ABSOLUTE, inset = ins(flow.Auto(), flow.Px(0.0), flow.Px(0.0), flow.Auto()), width = flow.Pct(0.5), height = flow.Px(20.0) })
    mut c := flow.FlowStyle { position = flow.POS_ABSOLUTE, inset = flow.All(flow.Px(0.0)), width = flow.Px(60.0), height = flow.Px(30.0) }
    c.margin = flow.All(flow.Auto())
    t.Add(root, c)
    mut st := box(25.0, 25.0)
    st.position = flow.POS_ABSOLUTE
    t.Add(root, st)
    mut lr := flow.FlowStyle { position = flow.POS_ABSOLUTE, width = flow.Px(10.0), height = flow.Px(10.0) }
    lr.inset.left = flow.Px(1.0)
    lr.inset.top = flow.Px(2.0)
    t.Add(root, lr)
    run("absolute: insets, stretch between insets, percent, centred, static", t, 400.0, 400.0)
end

func fixed():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { padding = flow.All(flow.Px(20.0)) })
    inner := t.Add(root, flow.FlowStyle { height = flow.Px(50.0), padding = flow.All(flow.Px(7.0)) })
    f := t.Add(inner, flow.FlowStyle { position = flow.POS_FIXED, inset = ins(flow.Auto(), flow.Px(0.0), flow.Px(0.0), flow.Px(0.0)), height = flow.Px(30.0) })
    run("fixed: placed against the viewport", t, 300.0, 200.0)
    println "fixed abs", t.AbsX(f), t.AbsY(f)
    t.Layout(500.0, 250.0)
    println "after resize", t.AbsX(f), t.AbsY(f), t.W(f), t.H(f)
end

func sticky():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { height = flow.Px(100.0), overflow_y = flow.OVERFLOW_SCROLL })
    t.Add(root, flow.FlowStyle { height = flow.Px(40.0), shrink = 0.0 })
    mut hs := flow.FlowStyle { height = flow.Px(20.0), shrink = 0.0, position = flow.POS_STICKY }
    hs.inset.top = flow.Px(0.0)
    h := t.Add(root, hs)
    sect := t.Add(root, flow.FlowStyle { height = flow.Px(200.0), shrink = 0.0 })
    mut inner := flow.FlowStyle { height = flow.Px(10.0), position = flow.POS_STICKY }
    inner.inset.top = flow.Px(5.0)
    inner.inset.bottom = flow.Px(5.0)
    s2 := t.Add(sect, inner)
    t.Add(root, flow.FlowStyle { height = flow.Px(300.0), shrink = 0.0 })
    t.Layout(200.0, 100.0)
    println "content", t.ContentW(root), t.ContentH(root)
    each sy in [0.0, 30.0, 100.0, 250.0, 2000.0]:
        t.SetScroll(root, 0.0, sy)
        println "scroll", sy, "->", t.ScrollY(root), "header y", t.Y(h), "abs", t.AbsY(h), "inner y", t.Y(s2), "abs", t.AbsY(s2)
    end
end

func scroll():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, width = flow.Px(100.0), height = flow.Px(50.0), padding = flow.All(flow.Px(5.0)), border = flow.All(flow.Px(1.0)), overflow_x = flow.OVERFLOW_AUTO })
    a := t.Add(root, flow.FlowStyle { width = flow.Px(80.0), shrink = 0.0 })
    t.Add(root, flow.FlowStyle { width = flow.Px(80.0), shrink = 0.0, margin = flow.Sides(flow.Px(0.0), flow.Px(10.0), flow.Px(0.0), flow.Px(0.0)) })
    t.Layout(400.0, 400.0)
    println "content", t.ContentW(root), t.ContentH(root)
    t.SetScroll(root, 40.0, 10.0)
    println "scroll", t.ScrollX(root), t.ScrollY(root), "a at", t.X(a), t.Y(a)
    t.SetScroll(root, 500.0, 0.0)
    println "clamped", t.ScrollX(root), "a at", t.X(a)
    mut v := flow.NewTree()
    vr := v.Add(-1, flow.FlowStyle { width = flow.Px(100.0), height = flow.Px(50.0) })
    v.Add(vr, flow.FlowStyle { height = flow.Px(80.0), shrink = 0.0 })
    v.Layout(400.0, 400.0)
    v.SetScroll(vr, 0.0, 20.0)
    println "visible overflow does not scroll", v.ScrollY(vr), v.ContentH(vr)
end

func main:
    absolute()
    fixed()
    sticky()
    scroll()
end
