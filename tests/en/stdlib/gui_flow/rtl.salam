import gui.flow
import math

func r(v: f64): f64:
    x := math.Round(v * 100.0) / 100.0
    if x == 0.0:
        ret 0.0
    end
    ret x
end

func dump(t &: flow.Tree, id: int, depth: int):
    mut pad := ""
    repeat depth:
        pad += "  "
    end
    println pad + "#" + id, r(t.X(id)), r(t.Y(id)), r(t.W(id)), r(t.H(id))
    repeat t.ChildCount(id) in i:
        dump(t, t.Child(id, i), depth + 1)
    end
end

func box(w: f64, h: f64): flow.FlowStyle:
    ret flow.FlowStyle { width = flow.Px(w), height = flow.Px(h) }
end

func run(title: str, t &: flow.Tree, w: f64, h: f64):
    t.Layout(w, h)
    println "==", title
    dump(t, 0, 0)
end

func three(t &: flow.Tree, root: int):
    t.Add(root, box(30.0, 10.0))
    t.Add(root, box(40.0, 10.0))
    t.Add(root, box(50.0, 10.0))
end

func row_rtl():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, direction = flow.DIR_RTL, column_gap = flow.Px(5.0), height = flow.Px(10.0), padding = flow.Sides(flow.Px(0.0), flow.Px(0.0), flow.Px(0.0), flow.Px(8.0)) })
    three(t, root)
    run("rtl row starts at the right, padding start is on the right", t, 300.0, 100.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, direction = flow.DIR_RTL, reverse = true, height = flow.Px(10.0) })
    three(s, sr)
    run("rtl row reverse starts at the left", s, 300.0, 100.0)
    mut j := flow.NewTree()
    jr := j.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, direction = flow.DIR_RTL, justify = flow.ALIGN_END, height = flow.Px(10.0) })
    three(j, jr)
    run("rtl row justify end packs at the left", j, 300.0, 100.0)
end

func margins_rtl():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { direction = flow.DIR_RTL })
    mut m := flow.FlowStyle { height = flow.Px(10.0) }
    m.margin = flow.Sides(flow.Px(0.0), flow.Px(20.0), flow.Px(0.0), flow.Px(5.0))
    t.Add(root, m)
    mut p := flow.FlowStyle { height = flow.Px(10.0), width = flow.Px(50.0), align_self = flow.ALIGN_START }
    p.margin.left = flow.Px(3.0)
    t.Add(root, p)
    mut q := flow.FlowStyle { height = flow.Px(10.0), width = flow.Px(50.0), align_self = flow.ALIGN_END }
    q.margin.start = flow.Px(7.0)
    q.margin.right = flow.Px(1.0)
    t.Add(root, q)
    run("rtl column: start margin on the right, left and right stay physical", t, 200.0, 100.0)
end

func column_wrap_rtl():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { direction = flow.DIR_RTL, wrap = true, height = flow.Px(20.0), align = flow.ALIGN_START })
    three(t, root)
    run("rtl column wrap places columns from the right", t, 200.0, 100.0)
end

func grid_rtl():
    mut cols := Vector {} as Vector<flow.Track>
    cols.push(flow.TrackLen(flow.Px(40.0)))
    cols.push(flow.TrackLen(flow.Px(60.0)))
    cols.push(flow.TrackFr(1.0))
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, direction = flow.DIR_RTL, columns = cols, column_gap = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { height = flow.Px(10.0), width = flow.Px(20.0), justify_self = flow.ALIGN_START })
    t.Add(root, flow.FlowStyle { height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { height = flow.Px(10.0), column = -1 })
    run("rtl grid: column 1 on the right, justify start is right", t, 300.0, 100.0)
end

func flow_rtl():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_FLOW, direction = flow.DIR_RTL, width = flow.Px(100.0), height = flow.Fit() })
    three(t, root)
    run("rtl flow runs right to left", t, 200.0, 100.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_FLOW, direction = flow.DIR_RTL, text_align = flow.TEXT_LEFT, width = flow.Px(100.0), height = flow.Fit() })
    three(s, sr)
    run("rtl flow with text align left", s, 200.0, 100.0)
end

func stack_rtl():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_STACK, direction = flow.DIR_RTL, width = flow.Px(100.0), height = flow.Px(50.0) })
    t.Add(root, box(20.0, 20.0))
    t.Add(root, flow.FlowStyle { width = flow.Px(20.0), height = flow.Px(20.0), justify_self = flow.ALIGN_END })
    run("rtl stack start is right", t, 200.0, 100.0)
end

func absolute_rtl():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { direction = flow.DIR_RTL, width = flow.Px(200.0), height = flow.Px(100.0), padding = flow.All(flow.Px(10.0)) })
    mut a := flow.FlowStyle { position = flow.POS_ABSOLUTE, width = flow.Px(30.0), height = flow.Px(30.0) }
    a.inset.start = flow.Px(5.0)
    a.inset.top = flow.Px(5.0)
    t.Add(root, a)
    t.Add(root, flow.FlowStyle { position = flow.POS_ABSOLUTE, width = flow.Px(30.0), height = flow.Px(30.0) })
    mut b := flow.FlowStyle { position = flow.POS_ABSOLUTE, width = flow.Px(30.0), height = flow.Px(30.0) }
    b.inset.left = flow.Px(5.0)
    t.Add(root, b)
    run("rtl absolute: start inset from the right, static at the right", t, 300.0, 300.0)
end

func inherit():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { direction = flow.DIR_RTL })
    mid := t.Add(root, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(10.0) })
    t.Add(mid, box(10.0, 10.0))
    ltr := t.Add(root, flow.FlowStyle { layout = flow.LAYOUT_ROW, height = flow.Px(10.0), direction = flow.DIR_LTR })
    t.Add(ltr, box(10.0, 10.0))
    run("direction inherits from the parent", t, 100.0, 100.0)
    mut st := t.Style(root)
    st.direction = flow.DIR_LTR
    t.SetStyle(root, st)
    run("switching the root to ltr mirrors the subtree", t, 100.0, 100.0)
end

func scroll_rtl():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, direction = flow.DIR_RTL, width = flow.Px(100.0), height = flow.Px(20.0), overflow_x = flow.OVERFLOW_SCROLL })
    a := t.Add(root, flow.FlowStyle { width = flow.Px(80.0), shrink = 0.0 })
    t.Add(root, flow.FlowStyle { width = flow.Px(80.0), shrink = 0.0 })
    t.Layout(300.0, 300.0)
    println "rtl content", t.ContentW(root), "first at", t.X(a)
    t.SetScroll(root, -30.0, 0.0)
    println "scroll -30", t.ScrollX(root), "first at", t.X(a)
    t.SetScroll(root, 30.0, 0.0)
    println "scroll 30 clamps", t.ScrollX(root)
end

func main:
    row_rtl()
    margins_rtl()
    column_wrap_rtl()
    grid_rtl()
    flow_rtl()
    stack_rtl()
    absolute_rtl()
    inherit()
    scroll_rtl()
end
