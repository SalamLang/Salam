import gui.flow
import math

func r(v: f64): f64:
    x := math.Round(v * 100.0) / 100.0
    if x == 0.0:
        ret 0.0
    end
    ret x
end

func dump(t &: flow.Tree, id: int, depth: int):
    mut pad := ""
    repeat depth:
        pad += "  "
    end
    println pad + "#" + id, r(t.X(id)), r(t.Y(id)), r(t.W(id)), r(t.H(id))
    repeat t.ChildCount(id) in i:
        dump(t, t.Child(id, i), depth + 1)
    end
end

func box(w: f64, h: f64): flow.FlowStyle:
    ret flow.FlowStyle { width = flow.Px(w), height = flow.Px(h) }
end

func run(title: str, t &: flow.Tree, w: f64, h: f64):
    t.Layout(w, h)
    println "==", title
    dump(t, 0, 0)
end

func words(t &: flow.Tree, parent: int, style: flow.FlowStyle, count: int): int:
    id := t.Add(parent, style)
    t.SetMeasure(id, (_id: int, w: f64, _h: f64):
        mut per := count
        if w >= 0.0:
            per = ((w + 5.0) / 25.0) as int
            if per < 1:
                per = 1
            end
            if per > count:
                per = count
            end
        end
        lines := (count + per - 1) / per
        ret flow.Size { w = (per as f64) * 25.0 - 5.0, h = (lines as f64) * 10.0, baseline = 8.0 }
    end)
    ret id
end

func width_kinds():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { padding = flow.All(flow.Px(10.0)), align = flow.ALIGN_START })
    t.Add(root, flow.FlowStyle { width = flow.Px(120.0), height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { width = flow.Pct(0.5), height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { width = flow.PxPct(-20.0, 0.5), height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { width = flow.Fill(), height = flow.Px(10.0), margin = flow.Sides(flow.Px(0.0), flow.Px(30.0), flow.Px(0.0), flow.Px(10.0)) })
    words(t, root, flow.FlowStyle {}, 6)
    words(t, root, flow.FlowStyle { width = flow.Fit() }, 20)
    words(t, root, flow.FlowStyle { width = flow.MinContent() }, 6)
    words(t, root, flow.FlowStyle { width = flow.MaxContent() }, 20)
    run("len, percent, percent minus px, fill, auto, fit, min content, max content", t, 300.0, 400.0)
end

func min_max():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { align = flow.ALIGN_START })
    t.Add(root, flow.FlowStyle { width = flow.Px(500.0), max_width = flow.Pct(0.5), height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { width = flow.Px(5.0), min_width = flow.Px(40.0), height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { width = flow.Px(100.0), min_width = flow.Px(80.0), max_width = flow.Px(60.0), height = flow.Px(10.0) })
    t.Add(root, flow.FlowStyle { width = flow.Px(10.0), height = flow.Px(500.0), max_height = flow.Px(20.0) })
    t.Add(root, flow.FlowStyle { width = flow.Px(10.0), min_height = flow.Px(15.0) })
    words(t, root, flow.FlowStyle { max_width = flow.MinContent() }, 6)
    run("max percent, min over width, min wins over max, max height, min height, max min content", t, 300.0, 400.0)
end

func hidden():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, column_gap = flow.Px(10.0), height = flow.Px(20.0) })
    t.Add(root, box(30.0, 20.0))
    h := t.Add(root, flow.FlowStyle { width = flow.Px(30.0), visible = false })
    t.Add(h, box(10.0, 10.0))
    t.Add(root, box(30.0, 20.0))
    run("visible false takes no space and no gap", t, 200.0, 100.0)
end

func nested_percent():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { padding = flow.All(flow.Pct(0.05)) })
    a := t.Add(root, flow.FlowStyle { width = flow.Pct(0.5), height = flow.Pct(0.5), padding = flow.All(flow.Px(10.0)), align = flow.ALIGN_START })
    t.Add(a, flow.FlowStyle { width = flow.Pct(0.5), height = flow.Pct(0.25) })
    run("nested percent of the content box", t, 400.0, 400.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { height = flow.Fit(), align = flow.ALIGN_START })
    s.Add(sr, flow.FlowStyle { width = flow.Px(20.0), height = flow.Pct(0.5) })
    run("percent height of a content sized parent is auto", s, 400.0, 400.0)
end

func zero_and_overflow():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { padding = flow.All(flow.Px(30.0)) })
    t.Add(root, flow.FlowStyle { height = flow.Px(10.0) })
    run("viewport smaller than padding", t, 40.0, 0.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { width = flow.Px(0.0), height = flow.Px(0.0) })
    s.Add(sr, box(0.0, 0.0))
    s.Add(sr, flow.FlowStyle { width = flow.Px(10.0), height = flow.Px(10.0), padding = flow.All(flow.Px(8.0)) })
    run("zero sizes and padding larger than the box", s, 100.0, 100.0)
    mut o := flow.NewTree()
    oroot := o.Add(-1, flow.FlowStyle { height = flow.Px(50.0) })
    o.Add(oroot, flow.FlowStyle { height = flow.Px(40.0), shrink = 0.0 })
    o.Add(oroot, flow.FlowStyle { height = flow.Px(40.0), shrink = 0.0 })
    o.Add(oroot, flow.FlowStyle { width = flow.Px(300.0), height = flow.Px(10.0), shrink = 0.0 })
    run("children overflow a fixed column", o, 100.0, 100.0)
    println "content", o.ContentW(oroot), o.ContentH(oroot)
    mut n := flow.NewTree()
    nr := n.Add(-1, flow.FlowStyle { height = flow.Px(50.0) })
    n.Add(nr, flow.FlowStyle { height = flow.Px(40.0) })
    n.Add(nr, flow.FlowStyle { height = flow.Px(60.0), shrink = 2.0 })
    run("negative free space shrinks a column", n, 100.0, 100.0)
end

func text_in_row():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, align = flow.ALIGN_START })
    words(t, root, flow.FlowStyle { shrink = 1.0 }, 10)
    words(t, root, flow.FlowStyle {}, 4)
    run("two texts shrink in a narrow row", t, 200.0, 100.0)
    println "measures", t.MeasureCalls()
end

func main:
    width_kinds()
    min_max()
    hidden()
    nested_percent()
    zero_and_overflow()
    text_in_row()
end
