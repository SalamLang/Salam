import gui.flow
import math

func r(v: f64): f64:
    x := math.Round(v * 100.0) / 100.0
    if x == 0.0:
        ret 0.0
    end
    ret x
end

func dump(t &: flow.Tree, id: int, depth: int):
    mut pad := ""
    repeat depth:
        pad += "  "
    end
    println pad + "#" + id, r(t.X(id)), r(t.Y(id)), r(t.W(id)), r(t.H(id))
    repeat t.ChildCount(id) in i:
        dump(t, t.Child(id, i), depth + 1)
    end
end

func box(w: f64, h: f64): flow.FlowStyle:
    ret flow.FlowStyle { width = flow.Px(w), height = flow.Px(h) }
end

func run(title: str, t &: flow.Tree, w: f64, h: f64):
    t.Layout(w, h)
    println "==", title
    dump(t, 0, 0)
end
func words(t &: flow.Tree, parent: int, style: flow.FlowStyle, count: int): int:
    id := t.Add(parent, style)
    t.SetMeasure(id, (_id: int, w: f64, _h: f64):
        mut per := count
        if w >= 0.0:
            per = ((w + 5.0) / 25.0) as int
            if per < 1:
                per = 1
            end
            if per > count:
                per = count
            end
        end
        lines := (count + per - 1) / per
        ret flow.Size { w = (per as f64) * 25.0 - 5.0, h = (lines as f64) * 10.0, baseline = 8.0 }
    end)
    ret id
end

func glyph(t &: flow.Tree, parent: int, w: f64, h: f64, base: f64): int:
    id := t.Add(parent, flow.FlowStyle {})
    t.SetMeasure(id, (_id: int, _aw: f64, _ah: f64): ret flow.Size { w = w, h = h, baseline = base } end)
    ret id
end

func stack():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_STACK, padding = flow.All(flow.Px(10.0)), width = flow.Px(200.0), height = flow.Fit() })
    t.Add(root, flow.FlowStyle { width = flow.Fill(), height = flow.Px(80.0) })
    t.Add(root, flow.FlowStyle { width = flow.Px(50.0), height = flow.Px(20.0), justify_self = flow.ALIGN_END, align_self = flow.ALIGN_END })
    t.Add(root, flow.FlowStyle { width = flow.Px(40.0), height = flow.Px(40.0), justify_self = flow.ALIGN_CENTER, align_self = flow.ALIGN_CENTER, layer = 2 })
    t.Add(root, flow.FlowStyle { justify_self = flow.ALIGN_STRETCH, height = flow.Px(10.0), layer = -1 })
    words(t, root, flow.FlowStyle { align_self = flow.ALIGN_START }, 3)
    run("stack: one cell, later on top", t, 400.0, 400.0)
    print "paint order"
    each id in t.PaintOrder(root):
        print " ", id, "(", t.Layer(id), ")"
    end
    println ""
    mut c := flow.NewTree()
    cr := c.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_STACK, justify = flow.ALIGN_CENTER, align = flow.ALIGN_END, width = flow.Px(100.0), height = flow.Px(100.0) })
    c.Add(cr, box(20.0, 20.0))
    mut m := box(20.0, 20.0)
    m.margin = flow.All(flow.Auto())
    c.Add(cr, m)
    run("stack: container justify and align, auto margins centre", c, 400.0, 400.0)
end

func flow_layout():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_FLOW, width = flow.Px(100.0), height = flow.Fit(), column_gap = flow.Px(4.0), row_gap = flow.Px(2.0) })
    glyph(t, root, 30.0, 12.0, 10.0)
    glyph(t, root, 30.0, 20.0, 16.0)
    glyph(t, root, 30.0, 12.0, 10.0)
    glyph(t, root, 50.0, 12.0, 10.0)
    t.Add(root, flow.FlowStyle { width = flow.Px(20.0), height = flow.Px(6.0) })
    run("flow: wrap onto lines, baseline aligned", t, 400.0, 400.0)
    println "baseline", t.Baseline(root)
    names := ["start", "center", "end", "justify", "left", "right"]
    each i, ta in [flow.TEXT_START, flow.TEXT_CENTER, flow.TEXT_END, flow.TEXT_JUSTIFY, flow.TEXT_LEFT, flow.TEXT_RIGHT]:
        mut s := flow.NewTree()
        sr := s.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_FLOW, text_align = ta, width = flow.Px(100.0), height = flow.Fit() })
        glyph(s, sr, 30.0, 10.0, 8.0)
        glyph(s, sr, 30.0, 10.0, 8.0)
        glyph(s, sr, 30.0, 10.0, 8.0)
        glyph(s, sr, 30.0, 10.0, 8.0)
        run("flow text align " + names[i], s, 400.0, 400.0)
    end
    mut a := flow.NewTree()
    ar := a.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_FLOW, width = flow.Px(200.0), height = flow.Fit() })
    glyph(a, ar, 30.0, 30.0, 25.0)
    mut top := flow.FlowStyle { align_self = flow.ALIGN_START }
    top.margin = flow.Sides(flow.Px(0.0), flow.Px(5.0), flow.Px(0.0), flow.Px(5.0))
    g1 := a.Add(ar, top)
    a.SetMeasure(g1, (_id: int, _aw: f64, _ah: f64): ret flow.Size { w = 10.0, h = 10.0, baseline = 8.0 } end)
    g2 := a.Add(ar, flow.FlowStyle { align_self = flow.ALIGN_CENTER })
    a.SetMeasure(g2, (_id: int, _aw: f64, _ah: f64): ret flow.Size { w = 10.0, h = 10.0, baseline = 8.0 } end)
    g3 := a.Add(ar, flow.FlowStyle { align_self = flow.ALIGN_END })
    a.SetMeasure(g3, (_id: int, _aw: f64, _ah: f64): ret flow.Size { w = 10.0, h = 10.0, baseline = 8.0 } end)
    words(a, ar, flow.FlowStyle {}, 12)
    run("flow: self alignment in a line and a text leaf", a, 400.0, 400.0)
end

func main:
    stack()
    flow_layout()
end
