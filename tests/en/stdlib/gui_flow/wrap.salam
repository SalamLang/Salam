import gui.flow
import math

func r(v: f64): f64:
    x := math.Round(v * 100.0) / 100.0
    if x == 0.0:
        ret 0.0
    end
    ret x
end

func dump(t &: flow.Tree, id: int, depth: int):
    mut pad := ""
    repeat depth:
        pad += "  "
    end
    println pad + "#" + id, r(t.X(id)), r(t.Y(id)), r(t.W(id)), r(t.H(id))
    repeat t.ChildCount(id) in i:
        dump(t, t.Child(id, i), depth + 1)
    end
end

func box(w: f64, h: f64): flow.FlowStyle:
    ret flow.FlowStyle { width = flow.Px(w), height = flow.Px(h) }
end

func run(title: str, t &: flow.Tree, w: f64, h: f64):
    t.Layout(w, h)
    println "==", title
    dump(t, 0, 0)
end

func items(t &: flow.Tree, root: int, n: int, w: f64, h: f64):
    repeat n:
        t.Add(root, box(w, h))
    end
end

func row_wrap():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, wrap = true, column_gap = flow.Px(10.0), row_gap = flow.Px(5.0), align = flow.ALIGN_START })
    items(t, root, 5, 60.0, 20.0)
    run("row wrap into lines", t, 200.0, 200.0)
end

func align_content():
    names := ["start", "center", "end", "stretch", "between", "around", "evenly"]
    each i, ac in [flow.ALIGN_START, flow.ALIGN_CENTER, flow.ALIGN_END, flow.ALIGN_STRETCH, flow.ALIGN_BETWEEN, flow.ALIGN_AROUND, flow.ALIGN_EVENLY]:
        mut t := flow.NewTree()
        root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, wrap = true, align_content = ac, height = flow.Px(100.0) })
        t.Add(root, box(60.0, 20.0))
        t.Add(root, flow.FlowStyle { width = flow.Px(60.0) })
        t.Add(root, box(60.0, 10.0))
        run("align content " + names[i], t, 130.0, 200.0)
    end
end

func column_wrap():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { wrap = true, height = flow.Px(100.0), align = flow.ALIGN_START, column_gap = flow.Px(4.0) })
    items(t, root, 5, 30.0, 40.0)
    run("column wrap into columns", t, 200.0, 200.0)
    mut s := flow.NewTree()
    sr := s.Add(-1, flow.FlowStyle { wrap = true, max_height = flow.Px(90.0), height = flow.Fit(), align = flow.ALIGN_START })
    items(s, sr, 3, 30.0, 40.0)
    run("column wrap limited by max height", s, 200.0, 200.0)
end

func wrap_grow():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, wrap = true, height = flow.Fit() })
    repeat 3:
        t.Add(root, flow.FlowStyle { basis = flow.Px(80.0), grow = 1.0, height = flow.Px(10.0) })
    end
    run("wrapped items grow per line", t, 200.0, 200.0)
end

func wrap_reverse():
    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, wrap = true, reverse = true, height = flow.Fit() })
    items(t, root, 3, 80.0, 10.0)
    run("row wrap reverse", t, 200.0, 200.0)
end

func main:
    row_wrap()
    align_content()
    column_wrap()
    wrap_grow()
    wrap_reverse()
end
