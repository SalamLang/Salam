package main

import gui.reactive
import math

mut left := reactive.F64Prop {}
mut doubled := reactive.F64Prop {}
mut count := reactive.IntProp {}
mut tint := reactive.IntProp {}
mut hover := reactive.BoolProp {}
mut glow := reactive.F64Prop {}
mut frames := 0

func r4(v: f64): f64:
    ret math.Round(v * 10000.0) / 10000.0
end

func show_easing(name: str, e: reactive.Easing):
    println name, r4(e.At(0.0)), r4(e.At(0.25)), r4(e.At(0.5)), r4(e.At(0.75)), r4(e.At(1.0))
end

func check_easings():
    fb := reactive.Linear()
    show_easing("linear", reactive.ParseEasing("linear", fb))
    show_easing("ease", reactive.ParseEasing("ease", fb))
    show_easing("ease-in", reactive.ParseEasing("ease-in", fb))
    show_easing("ease-out", reactive.ParseEasing("ease-out", fb))
    show_easing("ease-in-out", reactive.ParseEasing("EASE-IN-OUT", fb))
    show_easing("cubic-bezier", reactive.ParseEasing("cubic-bezier(0.1, 0.7, 1.0, 0.1)", fb))
    show_easing("EaseIn()", reactive.EaseIn())
    show_easing("EaseOut()", reactive.EaseOut())
    show_easing("overshoot", reactive.CubicBezier(0.34, 1.56, 0.64, 1.0))
    show_easing("steps(4)", reactive.ParseEasing("steps(4)", fb))
    show_easing("steps(4, jump-start)", reactive.ParseEasing("steps(4, jump-start)", fb))
    show_easing("steps(4, jump-none)", reactive.ParseEasing("steps(4, jump-none)", fb))
    show_easing("steps(4, jump-both)", reactive.ParseEasing("steps(4, jump-both)", fb))
    show_easing("step-start", reactive.ParseEasing("step-start", fb))
    show_easing("step-end", reactive.ParseEasing("step-end", fb))
    bad := reactive.ParseEasing("cubic-bezier(2, 0, 0, 1)", reactive.Ease())
    println "bad x falls back to ease", bad.kind == reactive.EasingKind.CubicBezier, bad.x1
    junk := reactive.ParseEasing("wobble", fb)
    println "unknown falls back", junk.kind == reactive.EasingKind.Linear
end

func frame(t: i64):
    reactive.SetTime(t)
    println "t", t, "left", r4(left.Get()), "doubled", r4(doubled.Get()), "running", reactive.AnimationsRunning()
end

func check_animation():
    reactive.SetTime(0 as i64)
    left = reactive.NewF64(0.0).Name("left")
    left.Animate(reactive.Animation { duration = 1000, easing = reactive.EaseInOut() })
    doubled = reactive.NewF64(0.0)
    doubled.Bind((): ret left.Get() * 2.0 end)
    println "start", left.Get(), "running", reactive.AnimationsRunning()
    t := reactive.Track((): _v := doubled.Get() end, (): frames++ end)
    left.Set(100.0)
    println "after set", left.Get(), "running", reactive.AnimationsRunning(), "count", reactive.RunningAnimations()
    repeat 0 to 1000 by 250 in ms:
        _r := t.Refresh()
        frame(ms as i64)
    end
    println "frames requested", frames
    frame(1200 as i64)
    println "frames after the end", frames
    reactive.SetTime(2000 as i64)
    left.Set(0.0)
    frame(2000 as i64)
    frame(2500 as i64)
    left.Set(80.0)
    frame(2500 as i64)
    frame(3000 as i64)
    frame(3500 as i64)
    t.Free()
end

func check_clock():
    reactive.SetTime(5000 as i64)
    reactive.AdvanceTime(250 as i64)
    println "clock", reactive.Now()
    seen := reactive.NewI64(0 as i64)
    seen.Bind((): ret reactive.Now() / 1000 end)
    println "seconds", seen.Get()
    reactive.AdvanceTime(1000 as i64)
    println "seconds after a tick", seen.Get()
    seen.Free()
end

func check_int_and_delay():
    reactive.SetTime(10000 as i64)
    count = reactive.NewInt(0)
    count.Animate(reactive.Animation { duration = 400, delay = 100, easing = reactive.Steps(4, reactive.StepPosition.JumpEnd) })
    count.Set(8)
    repeat 0 to 600 by 100 in ms:
        reactive.SetTime(10000 as i64 + (ms as i64))
        println "count at", ms, count.Get()
    end
end

func check_color():
    reactive.SetTime(20000 as i64)
    tint = reactive.NewInt(0xFF000000 as int)
    tint.Animate(reactive.Animation { duration = 200, color = true })
    tint.Set(0x80FF8040 as int)
    repeat 0 to 200 by 100 in ms:
        reactive.SetTime(20000 as i64 + (ms as i64))
        println "tint at", ms, (tint.Get() as i64) & 0xFFFFFFFF
    end
end

func check_bound_target():
    reactive.SetTime(30000 as i64)
    hover = reactive.NewBool(false)
    glow = reactive.NewF64(0.0)
    glow.Bind((): ret hover.Get() ? 1.0 : 0.0 end)
    glow.Animate(reactive.Animation { duration = 100 })
    println "glow", glow.Get(), "has binding", glow.HasBinding()
    hover.Set(true)
    println "a change waiting to start counts as running", reactive.AnimationsRunning(), reactive.RunningAnimations()
    reactive.SetTime(30050 as i64)
    println "glow half way", r4(glow.Get())
    reactive.SetTime(30200 as i64)
    println "glow done", glow.Get(), "running", reactive.AnimationsRunning()
    glow.Set(0.25)
    reactive.SetTime(30250 as i64)
    println "set on an animated binding", r4(glow.Get()), "binding replaced", glow.HasBinding()
    hover.Set(false)
    reactive.SetTime(30400 as i64)
    println "hover no longer drives it", glow.Get()
end

func main:
    check_easings()
    check_animation()
    check_clock()
    check_int_and_delay()
    check_color()
    check_bound_target()
    left.Free()
    doubled.Free()
    count.Free()
    tint.Free()
    hover.Free()
    glow.Free()
    println "running at the end", reactive.RunningAnimations()
    reactive.Reset()
end
