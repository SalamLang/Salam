package main

import gui.reactive
import mem

mut width := reactive.IntProp {}
mut height := reactive.IntProp {}
mut area := reactive.IntProp {}
mut label := reactive.StrProp {}
mut use_width := reactive.BoolProp {}
mut pick := reactive.IntProp {}
mut runs := 0
mut fixed := reactive.IntProp {}
mut watched := reactive.IntProp {}
mut big := reactive.I64Prop {}

func show_error(label: str):
    e := reactive.LastError()
    println label, e
    mem.Free(e as void*)
end

func check_tracking():
    width = reactive.NewInt(3).Name("width")
    height = reactive.NewInt(4).Name("height")
    area = reactive.NewInt(0).Name("area")
    area.Bind((): ret width.Get() * height.Get() end)
    label = reactive.NewStr("").Name("label")
    label.Bind((): ret "area " + area.Get() end)
    println "area", area.Get(), label.Get()
    width.Set(10)
    println "area dirty", area.IsDirty(), "label dirty", label.IsDirty()
    println "area", area.Get(), label.Get()
    height.Set(4)
    println "same value keeps area clean", area.IsDirty()
end

func check_laziness():
    before := reactive.Evaluations()
    width.Set(1)
    width.Set(2)
    width.Set(3)
    println "evaluations after three sets", reactive.Evaluations() - before
    println "area", area.Get()
    println "evaluations after one read", reactive.Evaluations() - before
    println "area again", area.Get()
    println "evaluations after a second read", reactive.Evaluations() - before
end

func check_propagation():
    println "label before", label.Get()
    marks := reactive.DirtyMarks()
    width.Set(5)
    first := reactive.DirtyMarks() - marks
    width.Set(6)
    second := reactive.DirtyMarks() - marks - first
    println "marks on the first set", first
    println "marks on the second set", second
    println "label", label.Get()
end

func check_conditional():
    use_width = reactive.NewBool(true).Name("use width")
    pick = reactive.NewInt(0).Name("pick")
    pick.Bind(():
        runs++
        if use_width.Get():
            ret width.Get()
        end
        ret height.Get()
    end)
    println "pick", pick.Get()
    use_width.Set(false)
    println "pick", pick.Get()
    width.Set(99)
    println "width no longer read, pick dirty", pick.IsDirty()
    height.Set(7)
    println "height read now, pick dirty", pick.IsDirty(), pick.Get()
end

func check_set_removes_binding():
    println "area has binding", area.HasBinding()
    area.Set(1000)
    println "area has binding", area.HasBinding(), "area", area.Get()
    width.Set(2)
    println "area after width change", area.Get(), "label", label.Get()
    area.Bind((): ret width.Get() + 1 end)
    println "rebound area", area.Get(), "label", label.Get()
end

func check_constants():
    fixed = reactive.ConstInt(42)
    s := reactive.ConstStr("fixed")
    nodes := reactive.LiveNodes()
    edges := reactive.LiveEdges()
    doubled := reactive.NewInt(0)
    doubled.Bind((): ret fixed.Get() * 2 end)
    println "constant", fixed.Get(), s.Get(), "doubled", doubled.Get()
    println "nodes added", reactive.LiveNodes() - nodes
    println "edges added by reading a constant", reactive.LiveEdges() - edges
    fixed.Set(1)
    show_error("error")
    doubled.Free()
end

func check_peek():
    watched = reactive.NewInt(1)
    p := reactive.NewInt(0)
    p.Bind((): ret watched.Peek() + 100 end)
    println "peek", p.Get()
    watched.Set(2)
    println "untracked read leaves p clean", p.IsDirty(), p.Get()
    watched.Free()
    p.Free()
end

func check_types():
    big = reactive.NewI64(5000000000 as i64)
    half := reactive.NewI64(0 as i64)
    half.Bind((): ret big.Get() / 2 end)
    big.Set(7000000000 as i64)
    println "i64", half.Get(), reactive.ConstI64(9000000000 as i64).Get()
    println "constants", reactive.ConstF64(2.5).Get(), reactive.ConstBool(true).Get(), reactive.ConstBool(true).HasBinding()
    big.Free()
    half.Free()
end

func main:
    reactive.SetErrorPrinting(false)
    check_tracking()
    check_laziness()
    check_propagation()
    check_conditional()
    check_set_removes_binding()
    check_constants()
    check_peek()
    check_types()
    println "binding runs of pick", runs
    reactive.Reset()
    println "nodes after reset", reactive.LiveNodes()
end
