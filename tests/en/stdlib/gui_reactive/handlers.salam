package main

import gui.reactive

mut x := reactive.IntProp {}
mut y := reactive.IntProp {}
mut sum := reactive.IntProp {}
mut title := reactive.StrProp {}
mut redraws := 0
mut paints := 0
mut sum_calls := 0
mut title_calls := 0
mut seen := 0
mut first := reactive.IntProp {}
mut second := reactive.IntProp {}

func paint():
    paints++
    seen = sum.Get()
end

func check_tracker():
    x = reactive.NewInt(1).Name("x")
    y = reactive.NewInt(2).Name("y")
    sum = reactive.NewInt(0).Name("sum")
    sum.Bind((): ret x.Get() + y.Get() end)
    t := reactive.Track((): paint() end, (): redraws++ end)
    println "painted", paints, "seen", seen, "redraws", redraws
    x.Set(10)
    y.Set(20)
    println "after two sets: dirty", t.IsDirty(), "redraws", redraws, "paints", paints
    println "refresh ran", t.Refresh(), "seen", seen, "paints", paints
    println "refresh again ran", t.Refresh()
    x.Set(11)
    println "redraws", redraws, "dirty", t.IsDirty()
    t.Free()
    x.Set(12)
    println "freed tracker gets no call", redraws
    plain := reactive.Track((): seen = y.Get() end)
    y.Set(21)
    println "tracker without callback dirty", plain.IsDirty(), plain.Refresh(), seen
    plain.Free()
end

func check_handlers():
    title = reactive.NewStr("a")
    h1 := reactive.OnChange(sum, (): sum_calls++ end)
    h2 := reactive.OnChange(title, ():
        title_calls++
        println "  title is now", title.Get()
    end)
    x.Set(100)
    y.Set(200)
    x.Set(101)
    println "calls before running", sum_calls, "pending", reactive.PendingHandlers()
    println "handlers run", reactive.RunPendingHandlers(), "sum calls", sum_calls
    println "nothing pending", reactive.RunPendingHandlers()
    x.Set(101)
    println "same value runs nothing", reactive.RunPendingHandlers()
    x.Set(50)
    y.Set(251)
    println "bound value unchanged", sum.Get(), "runs", reactive.RunPendingHandlers(), "sum calls", sum_calls
    title.Set("b")
    title.Set("c")
    println "two sets, one call", reactive.RunPendingHandlers(), title_calls
    h1.Free()
    h2.Free()
end

func check_chain():
    first = reactive.NewInt(0)
    second = reactive.NewInt(0)
    h := reactive.OnChange(first, (): second.Set(first.Get() * 2) end)
    h2 := reactive.OnChange(second, (): println "  second is", second.Get() end)
    first.Set(4)
    println "chained handler runs", reactive.RunPendingHandlers()
    h.Free()
    h2.Free()
    first.Free()
    second.Free()
end

func check_batch():
    t := reactive.Track((): seen = x.Get() + y.Get() end, ():
        redraws++
        println "  redraw requested, in batch", reactive.InBatch()
    end)
    before := redraws
    reactive.BeginBatch()
    x.Set(1)
    y.Set(2)
    println "inside the batch the callback waits", redraws - before
    reactive.EndBatch()
    println "after the batch", redraws - before
    _r := t.Refresh()
    reactive.Batch(():
        x.Set(3)
        y.Set(4)
        x.Set(5)
    end)
    println "batch helper", redraws - before, "seen before refresh", seen
    _r2 := t.Refresh()
    println "seen after refresh", seen
    t.Free()
end

func main:
    check_tracker()
    check_handlers()
    check_chain()
    check_batch()
    x.Free()
    y.Free()
    sum.Free()
    title.Free()
    println "nodes left", reactive.LiveNodes(), "edges left", reactive.LiveEdges()
    reactive.Reset()
end
