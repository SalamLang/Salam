package main

import gui.reactive
import mem

mut a := reactive.IntProp {}
mut b := reactive.IntProp {}
mut c := reactive.IntProp {}
mut self_ref := reactive.F64Prop {}
mut counter := reactive.IntProp {}

func show_error(label: str):
    e := reactive.LastError()
    println label, e
    mem.Free(e as void*)
end

func check_cycle():
    a = reactive.NewInt(1).Name("width")
    b = reactive.NewInt(0).Name("min width")
    c = reactive.NewInt(0).Name("preferred width")
    b.Bind((): ret c.Get() + 1 end)
    c.Bind((): ret a.Get() + b.Get() end)
    println "value with the loop cut", b.Get()
    println "errors", reactive.ErrorCount()
    show_error("last error")
    a.Set(5)
    println "still answers", c.Get(), "errors", reactive.ErrorCount()
    c.Bind((): ret a.Get() * 2 end)
    println "loop removed", b.Get(), c.Get(), "errors", reactive.ErrorCount()
end

func check_self():
    self_ref = reactive.NewF64(1.5)
    self_ref.Bind((): ret self_ref.Get() + 1.0 end)
    println "self reference", self_ref.Get()
    show_error("last error")
end

func check_set_inside():
    counter = reactive.NewInt(0).Name("counter")
    counter.Bind(():
        counter.Set(7)
        ret 3
    end)
    println "set inside its binding", counter.Get()
    show_error("last error")
    counter.Free()
end

func main:
    check_cycle()
    check_self()
    check_set_inside()
    a.Free()
    b.Free()
    c.Free()
    self_ref.Free()
    reactive.Reset()
end
