package main

import gui.reactive

mut todos := reactive.ListModel {} as reactive.ListModel<Todo>
mut summary := reactive.StrProp {}
mut first_title := reactive.StrProp {}
mut origin := reactive.Prop {} as reactive.Prop<Point>
mut offset := reactive.IntProp {}
mut moved := reactive.Prop {} as reactive.Prop<Point>
mut events := 0

struct Todo:
    pub title: str = ""
    pub done: bool = false
end

struct Point:
    pub x: int = 0
    pub y: int = 0
end

func describe(ev: reactive.ModelEvent):
    events++
    mut name := "reset"
    if ev.kind == reactive.ModelChange.RowChanged:
        name = "row changed"
    else ev.kind == reactive.ModelChange.RowsInserted:
        name = "rows inserted"
    else ev.kind == reactive.ModelChange.RowsRemoved:
        name = "rows removed"
    end
    println "  event", name, "at", ev.index, "count", ev.count
end

func count_done(): int:
    mut n := 0
    repeat todos.Len() in i:
        if todos.Get(i).done:
            n++
        end
    end
    ret n
end

func check_model():
    todos = reactive.NewListModel() as reactive.ListModel<Todo>
    id := todos.Listen((ev: reactive.ModelEvent): describe(ev) end)
    summary = reactive.NewStr("")
    summary.Bind((): ret "" + count_done() + " of " + todos.Len() + " done" end)
    first_title = reactive.NewStr("")
    first_title.BindCopy((): ret todos.Len() > 0 ? todos.Get(0).title : "none" end)
    println summary.Get(), "|", first_title.Get()
    todos.Push(Todo { title = "write tests" })
    todos.Push(Todo { title = "write docs" })
    todos.Insert(0, Todo { title = "read the study", done = true })
    println summary.Get(), "|", first_title.Get()
    todos.Set(1, Todo { title = "write tests", done = true })
    println summary.Get()
    todos.Remove(0, 2)
    println summary.Get(), "|", first_title.Get()
    mut fresh := Vector {} as Vector<Todo>
    fresh.Push(Todo { title = "a" })
    fresh.Push(Todo { title = "b", done = true })
    todos.Replace(fresh)
    fresh.Free()
    println summary.Get(), "|", first_title.Get()
    h := todos.OnChange((): println "  model handler ran" end)
    todos.Set(0, Todo { title = "a", done = true })
    todos.Push(Todo { title = "c" })
    println "handlers run", reactive.RunPendingHandlers()
    todos.Unlisten(id)
    todos.Clear()
    println summary.Get(), "|", first_title.Get(), "| events", events
    h.Free()
end

func check_generic():
    origin = reactive.NewProp(Point { x = 1, y = 2 }).Name("origin")
    offset = reactive.NewInt(10)
    moved = reactive.NewProp(Point {})
    moved.Bind(():
        o := origin.Get()
        ret Point { x = o.x + offset.Get(), y = o.y }
    end)
    println "moved", moved.Get()
    offset.Set(20)
    println "moved", moved.Get()
    origin.Set(Point { x = 5, y = 6 })
    println "moved", moved.Get(), "bound", moved.HasBinding()
    h := moved.OnChange((): println "  moved changed" end)
    offset.Set(30)
    println "handlers run", reactive.RunPendingHandlers()
    moved.Set(Point { x = 0, y = 0 })
    println "set drops the binding", moved.HasBinding(), moved.Get()
    h.Free()
end

func main:
    check_model()
    check_generic()
    todos.Free()
    summary.Free()
    first_title.Free()
    origin.Free()
    offset.Free()
    moved.Free()
    println "nodes left", reactive.LiveNodes(), "edges left", reactive.LiveEdges()
    reactive.Reset()
end
