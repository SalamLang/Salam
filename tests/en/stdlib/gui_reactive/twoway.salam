package main

import gui.reactive
import mem

mut text := reactive.StrProp {}
mut field := reactive.StrProp {}
mut shout := reactive.StrProp {}
mut slider := reactive.F64Prop {}
mut spin := reactive.F64Prop {}
mut knob := reactive.F64Prop {}
mut base := reactive.F64Prop {}

func show_error(label: str):
    e := reactive.LastError()
    println label, e
    mem.Free(e as void*)
end

func check_strings():
    text = reactive.NewStr("hello").Name("model text")
    field = reactive.NewStr("").Name("input field")
    reactive.Link(text, field)
    println "linked", text.Get(), field.Get()
    shout = reactive.NewStr("")
    shout.Bind((): ret field.Get() + "!" end)
    println "shout", shout.Get()
    field.Set("typed")
    println "after typing", text.Get(), field.Get(), shout.Get()
    text.Set("reset")
    println "after model set", text.Get(), field.Get(), shout.Get()
    println "field keeps its two-way binding", field.HasBinding()
end

func check_three_way():
    slider = reactive.NewF64(0.5)
    spin = reactive.NewF64(0.0)
    knob = reactive.NewF64(0.0)
    reactive.Link(slider, spin)
    reactive.Link(spin, knob)
    println "three way", slider.Get(), spin.Get(), knob.Get()
    knob.Set(0.75)
    println "knob set", slider.Get(), spin.Get(), knob.Get()
    spin.Unlink()
    spin.Set(0.1)
    println "after unlink", slider.Get(), spin.Get(), knob.Get()
    slider.Set(0.2)
    println "slider set", slider.Get(), spin.Get(), knob.Get()
end

func check_bound_group():
    base = reactive.NewF64(2.0)
    a := reactive.NewF64(0.0)
    b := reactive.NewF64(0.0)
    a.Bind((): ret base.Get() * 10.0 end)
    reactive.Link(a, b)
    println "group follows the binding", a.Get(), b.Get()
    base.Set(3.0)
    println "base changed", a.Get(), b.Get()
    b.Set(1.5)
    println "set replaces the group binding", a.Get(), b.Get()
    base.Set(4.0)
    println "base no longer drives it", a.Get(), b.Get()
    a.Bind((): ret base.Get() + 0.5 end)
    println "bind on a member binds the group", a.Get(), b.Get()
    a.Free()
    b.Free()
end

func check_mismatch():
    i := reactive.NewInt(1)
    c := reactive.ConstInt(2)
    reactive.Link(i, c)
    show_error("error")
    i.Free()
end

func main:
    reactive.SetErrorPrinting(false)
    check_strings()
    check_three_way()
    check_bound_group()
    check_mismatch()
    text.Free()
    field.Free()
    shout.Free()
    slider.Free()
    spin.Free()
    knob.Free()
    base.Free()
    println "nodes left", reactive.LiveNodes(), "edges left", reactive.LiveEdges()
    reactive.Reset()
end
