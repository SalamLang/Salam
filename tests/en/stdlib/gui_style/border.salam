import gui.style

func check(name: str, text: str):
    p := style.PropByName(name)
    mut v := style.Value {}
    if not style.Parse(p, text, v):
        println name, "REJECTED", text
        ret
    end
    f := style.Format(p, v)
    mut w := style.Value {}
    again := style.Parse(p, f, w) and style.Css(p, v) == style.Css(p, w) and style.Format(p, w) == f
    println name, "|", text, "|", f, "|", style.Css(p, v), "|", again ? "round trip" : "DIFFERS"
end

func main:
    check("border", "1, solid, red")
    check("border", "red, 1, solid")
    check("border", "solid, red, 1")
    check("border", "dashed, 2, #3366aa")
    check("border", "dotted, blue")
    check("border", "3, double")
    check("border", "2")
