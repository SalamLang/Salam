import gui.style

func side_prop(name: str): bool:
    each pre in ["padding ", "margin ", "border top", "border bottom", "border start", "border end", "border left", "border right", "radius "]:
        if name.len() > pre.len() and name.substr(0, pre.len()) == pre:
            ret true
        end
        if name == pre:
            ret true
        end
    end
    ret false
end

func show(s: style.Style, names: str[]):
    each n in names:
        p := style.PropByName(n)
        println "   ", n, "=", style.Format(p, style.Get(s, p))
    end
end

func set(s &: style.Style, name: str, text: str):
    p := style.PropByName(name)
    mut v := style.Value {}
    if not style.Parse(p, text, v):
        println "bad", name, text
        ret
    end
    style.Set(s, p, v)
end

func main:
    box := style.Style {}
    println "-- defaults that differ from a box"
    each el in ["box", "page", "h1", "h2", "h3", "h4", "h5", "h6", "paragraph", "span", "bold", "italic", "code", "preformatted", "link", "small", "subscript", "mark", "deleted", "inserted", "abbreviation", "button", "input", "text area", "select", "checkbox", "radio", "image", "video", "list", "ordered list", "item", "table", "row", "cell", "header cell", "caption", "line", "form", "label", "nav", "header", "footer", "section", "article", "block quote", "field set", "progress", "پاراگراف", "دکمه", "p", "unknown thing"]:
        s := style.Default(el)
        mut diff := ""
        repeat style.PROP_COUNT in p:
            a := style.Format(p, style.Get(s, p))
            if not side_prop(style.PropName(p)) and a != style.Format(p, style.Get(box, p)):
                diff += "; " + style.PropName(p) + " = " + a
            end
        end
        println el + ":" + (diff == "" ? " same as box" : diff.substr(1, diff.len() - 1))
    end
    println "-- every example set then read back"
    repeat style.PROP_COUNT in p:
        mut s := style.Style {}
        info := style.Info(p)
        mut v := style.Value {}
        _ok := style.Parse(p, info.example, v)
        style.Set(s, p, v)
        println "  ", info.name, "=", info.example, "->", style.Format(p, style.Get(s, p))
    end
    println "-- shorthands and sides"
    mut s := style.Style {}
    set(s, "padding", "1, 2, 3, 4")
    set(s, "padding x", "10")
    show(s, ["padding", "padding start", "padding end", "padding left", "padding right"])
    set(s, "direction", "rtl")
    set(s, "padding left", "7")
    set(s, "margin right", "auto")
    set(s, "border left", "3, dashed, red")
    show(s, ["padding", "padding left", "margin", "border start", "border end", "border right"])
    set(s, "border", "1, solid, blue")
    set(s, "border top", "4, double, green")
    show(s, ["border top", "border bottom", "border width", "border color"])
    set(s, "radius", "8, 2")
    show(s, ["radius", "radius bottom end"])
    set(s, "overflow", "hidden")
    set(s, "overflow y", "scroll")
    show(s, ["overflow", "overflow x"])
    set(s, "background position", "bottom")
    set(s, "origin", "top")
    set(s, "scale", "2")
    set(s, "translate", "5")
    show(s, ["background position", "origin", "scale", "translate"])
    println "-- typed fields"
    mut t := style.Style {}
    set(t, "layout", "row")
    set(t, "gap", "8")
    set(t, "width", "100% - 20")
    set(t, "font weight", "bold")
    set(t, "line height", "20px")
    set(t, "transition", "[200, ease out], [1s, linear, 50]")
    set(t, "transition properties", "opacity, color")
    set(t, "font", "\"Vazirmatn\", sans")
    set(t, "shadow", "0, 2, 4, black")
    set(t, "background", "linear(90, red, blue), white")
    set(t, "columns", "repeat(2, 1fr), 100")
    println t.layout_kind == style.KW_ROW, t.gap_row.px, t.gap_column.px, t.width.len.pct, t.width.len.px, t.font_weight
    println t.line_height, t.line_height_len.px, t.transition.len(), t.transition.get(1).duration, t.transition.get(1).delay, t.transition.get(0).easing.kind == style.EASE_OUT
    println t.transition_props.len(), t.transition_props.get(0) == style.P_OPACITY, t.font.get(0), t.font.get(1)
    println t.shadow.len(), t.shadow.get(0).blur.px, t.background.len(), t.background.get(0).kind == style.PAINT_LINEAR, t.background.get(1).kind == style.PAINT_COLOR
    println t.columns.len(), t.columns.get(0).kind == style.TRACK_REPEAT, t.columns.get(0).count, t.columns.get(0).span, t.columns.get(1).len.fr
    println "-- inheritance"
    mut parent := style.Default("page")
    set(parent, "color", "#336699")
    set(parent, "font size", "20")
    set(parent, "direction", "rtl")
    set(parent, "padding", "30")
    set(parent, "cursor", "pointer")
    set(parent, "decoration", "underline")
    mut h := style.Default("h1")
    style.Inherit(parent, h)
    show(h, ["color", "font size", "direction", "padding", "cursor", "decoration", "font weight"])
    mut a := style.Default("link")
    style.Inherit(parent, a)
    show(a, ["color", "font size", "cursor"])
    mut p := style.Default("paragraph")
    style.Inherit(parent, p)
    set(p, "color", "black")
    show(p, ["color", "font size", "margin"])
    mut inh := ""
    repeat style.PROP_COUNT in i:
        if style.Inherited(i):
            inh += " " + style.PropName(i) + ","
        end
    end
    println "inherited:" + inh
end
