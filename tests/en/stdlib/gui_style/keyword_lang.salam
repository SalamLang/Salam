import gui.style

func main:
    println "row", style.KeywordLang("row")
    println "ردیف", style.KeywordLang("ردیف")
    println "center", style.KeywordLang("center")
    println "none", style.KeywordLang("none")
    println "nothing", style.KeywordLang("zzz not a word")
end
