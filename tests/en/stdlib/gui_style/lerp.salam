import gui.style

func lerp(name: str, a: str, b: str):
    p := style.PropByName(name)
    mut va := style.Value {}
    mut vb := style.Value {}
    if not style.Parse(p, a, va) or not style.Parse(p, b, vb):
        println "bad", name
        ret
    end
    mut line := name + ": " + a + " -> " + b + " |"
    each t in [0.0, 0.25, 0.5, 1.0]:
        line += " " + style.Format(p, style.Lerp(p, va, vb, t)) + " |"
    end
    println line
end

func main:
    lerp("width", "100", "200")
    lerp("width", "100%", "100% - 40")
    lerp("width", "50%", "10em")
    lerp("width", "auto", "200")
    lerp("padding", "0", "10, 20")
    lerp("margin", "0", "auto")
    lerp("opacity", "0", "1")
    lerp("font weight", "normal", "bold")
    lerp("color", "black", "white")
    lerp("color", "red", "blue")
    lerp("color", "current", "red")
    lerp("background", "white", "black")
    lerp("background", "linear(90, red, blue)", "linear(180, blue, red)")
    lerp("background", "linear(90, red, blue)", "radial(red, blue)")
    lerp("shadow", "none", "0, 4, 8, black")
    lerp("shadow", "0, 2, 4, red", "[0, 8, 16, blue], [0, 0, 2, black]")
    lerp("text shadow", "1, 1, red", "3, 3, 6, red")
    lerp("translate", "0", "100, 50")
    lerp("rotate", "0", "1turn")
    lerp("scale", "1", "2, 3")
    lerp("skew", "0", "20")
    lerp("radius", "0", "10")
    lerp("border", "1, solid, red", "5, solid, blue")
    lerp("border", "1, solid, red", "5, dashed, blue")
    lerp("blur", "0", "10")
    lerp("hue rotate", "0", "180")
    lerp("line height", "1", "2")
    lerp("letter spacing", "0", "0.1em")
    lerp("grow", "0", "1")
    lerp("layout", "row", "column")
    lerp("align", "start", "end")
    lerp("transition", "100", "200")
    println "-- easing"
    each name in ["linear", "ease", "ease in", "ease out", "ease in out", "ease(0.2, 0, 0, 1)", "steps(4)", "spring(170, 26)", "spring(100, 5)", "spring(100, 30)"]:
        mut v := style.Value {}
        _ok := style.Parse(style.P_TRANSITION, "100, " + name, v)
        e := v.items.Get(1).ease
        mut out := name + ":"
        each t in [0.0, 0.1, 0.25, 0.5, 0.75, 0.9, 1.0]:
            x := (style.EaseAt(e, t) * 10000.0 + 0.5) as int
            out += " " + x
        end
        println out
    end
end
