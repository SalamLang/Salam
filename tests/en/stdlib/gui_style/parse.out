padding = "8, 16" => 8, 16
color = "#3366aa" => #3366aa
margin = 0, auto => 0, auto
gap = 4, 8 => 4, 8
overflow = hidden, auto => hidden, auto
-- keywords in English and Persian
layout = grid => grid
layout = پشته => stack
align = Center => center
justify = میان => between
width = max   content => max content
width = کمینه محتوا => min content
cursor = not allowed => not allowed
cursor = غیرمجاز => not allowed
wrap = true => true
wrap = نادرست => false
font weight = 600 => 600
font weight = semibold => semibold
auto flow = row dense => row dense
direction = راست به چپ => rtl
-- colours
color = red => #ff0000
color = #fff => #ffffff
color = #3366aa80 => #3366aa80
color = rgb(51, 102, 170) => #3366aa
color = rgba(0, 0, 0, 0.25) => #00000040
color = hsl(210, 50%, 40%) => #336699
color = قرمز => #ff0000
color = current => current
color = light dark(white, black) => light dark(#ffffff, #000000)
border color = red, blue => #ff0000, #0000ff
-- composites in any order
border = 2, solid, #3366aa => 2, #3366aa
border = #3366aa, solid, 2 => 2, #3366aa
border = red, 1 => 1, #ff0000
border = dashed => 1, dashed
border = none => none
border = ۲، خط چین، آبی => 2, dashed, #0000ff
outline = 2, red => 2, #ff0000
-- groups
shadow = 0, 4, 8, black => 0, 4, 8, #000000
shadow = [0, 4, 8, black], [0, 1, 2, red] => [0, 4, 8, #000000], [0, 1, 2, #ff0000]
shadow = inset, 0, 0, 0, 2, #3366aa => 0, 0, 0, 2, #3366aa, inset
shadow = none => none
text shadow = 1, 1 => 1, 1
text shadow = [1, 1, red], [0, 0, 4, blue] => [1, 1, #ff0000], [0, 0, 4, #0000ff]
transition = 200ms, ease in out, 50ms => 200ms, ease in out, 50ms
transition = [200, linear], [1s, ease(0.2, 0, 0, 1), 100] => [200ms, linear], [1000ms, ease(0.2, 0, 0, 1), 100ms]
transition = 300, spring(170, 26) => 300ms, spring(170, 26)
transition = 300, steps(4) => 300ms, steps(4)
transition = ۲۰۰، نرم انتها => 200ms, ease out
transition properties = opacity, translate, background => opacity, translate, background
transition properties = شفافیت، رنگ => opacity, color
-- tracks
columns = 1fr, 1fr, 200 => 1fr, 1fr, 200
columns = repeat(3, 1fr) => repeat(3, 1fr)
columns = repeat(fill, minmax(120, 1fr)) => repeat(fill, minmax(120, 1fr))
columns = repeat(fit, 100, 2fr) => repeat(fit, 100, 2fr)
rows = auto, minmax(min content, 300), fit(50%) => auto, minmax(min content, 300), fit(50%)
columns = fr(2), auto => 2fr, auto
columns = چندبار(۲، سهم(۱)) => repeat(2, 1fr)
-- paints
background = #f5f5f5 => #f5f5f5
background = linear(90, red, blue) => linear(90, #ff0000, #0000ff)
background = linear(to bottom right, red 10%, blue 90%) => linear(to bottom right, #ff0000 10%, #0000ff 90%)
background = linear(0.25turn, red, yellow, blue) => linear(90, #ff0000, #ffff00, #0000ff)
background = radial(red, blue) => radial(#ff0000, #0000ff)
background = radial(circle, [20%, 30%], white, black) => radial(circle, [20%, 30%], #ffffff, #000000)
background = conic(45, red, blue) => conic(45, #ff0000, #0000ff)
background = image("photo.png"), #000 => image("photo.png"), #000000
background = خطی(۹۰، قرمز، آبی) => linear(90, #ff0000, #0000ff)
background = none => none
-- fonts and strings
font = "Vazirmatn", "Noto Sans", sans => "Vazirmatn", "Noto Sans", sans
font = Vazirmatn, mono => "Vazirmatn", mono
font = تک‌فاصله => mono
font features = "tnum" => "tnum"
aspect ratio = 16 / 9 => 1.7778
line height = 24px => 24px
line height = 1.4 => 1.4
-- errors
width =  -> width: the value is empty; expected a length, not negative, or auto, fill, fit, min content, max content, for example width = 50%
width = abc -> width: 'abc' is not valid; expected a length, not negative, or auto, fill, fit, min content, max content, for example width = 50%
width = -10 -> width: a negative length is not allowed; expected a length, not negative, or auto, fill, fit, min content, max content, for example width = 50%
width = 1fr -> width: fr is only for grid tracks; expected a length, not negative, or auto, fill, fit, min content, max content, for example width = 50%
width = 100%-20 -> width: '100%-20' is not valid; expected a length, not negative, or auto, fill, fit, min content, max content, for example width = 50%
width = 100% - -> width: a length is missing after + or -; expected a length, not negative, or auto, fill, fit, min content, max content, for example width = 50%
width = 12qq -> width: '12qq' is not valid; expected a length, not negative, or auto, fill, fit, min content, max content, for example width = 50%
width = 8 16 -> width: lengths are joined with + or -, and a list needs commas; expected a length, not negative, or auto, fill, fit, min content, max content, for example width = 50%
padding = 1, 2, 3, 4, 5 -> padding: too many values (at most 4); expected 1 to 4 lengths (top, end, bottom, start), not negative, for example padding = 8, 16
padding = 1,, 2 -> padding: an empty value between commas; expected 1 to 4 lengths (top, end, bottom, start), not negative, for example padding = 8, 16
padding = (1 -> padding: a bracket is not closed; expected 1 to 4 lengths (top, end, bottom, start), not negative, for example padding = 8, 16
opacity = 2 -> opacity: 2 is out of range; expected a number from 0 to 1 or a percent, for example opacity = 0.5
opacity = -0.5 -> opacity: -0.5 is out of range; expected a number from 0 to 1 or a percent, for example opacity = 0.5
opacity = 5px -> opacity: a plain number has no unit; expected a number from 0 to 1 or a percent, for example opacity = 0.5
font weight = 1001 -> font weight: 1001 is out of range; expected a number from 1 to 1000, or thin, light, normal, medium, semibold, bold, black, for example font weight = bold
font weight = heavy -> font weight: 'heavy' is not valid; expected a number from 1 to 1000, or thin, light, normal, medium, semibold, bold, black, for example font weight = bold
column span = 0 -> column span: 0 is out of range; expected a whole number from 1, for example column span = 2
column span = 1.5 -> column span: '1.5' is not valid; expected a whole number from 1, for example column span = 2
layout = flex -> layout: 'flex' is not valid; expected one of column, row, grid, stack, flow, for example layout = row
wrap = yes -> wrap: 'yes' is not valid; expected true or false, for example wrap = true
color = #12 -> color: column 1: '#12' has 2 hex digits; a hex colour has 3, 4, 6 or 8; expected a colour, for example color = #333333
color = notacolour -> color: 'notacolour' is not valid; expected a colour, for example color = #333333
border = 1, 2 -> border: two widths; expected a width, a style (solid, dashed, dotted, double, none) and a colour, in any order, for example border = 1, solid, #3366aa
border = solid, dashed -> border: two styles; expected a width, a style (solid, dashed, dotted, double, none) and a colour, in any order, for example border = 1, solid, #3366aa
border = -1, solid -> border: a negative width is not allowed; expected a width, a style (solid, dashed, dotted, double, none) and a colour, in any order, for example border = 1, solid, #3366aa
shadow = 4 -> shadow: a shadow has 2 to 4 lengths: x, y, blur and spread; expected x, y, blur, spread, a colour and inset, with [ ] around each shadow when there are several, or none, for example shadow = 0, 4, 8, #00000040
shadow = [0, 4, 8], 0, 1 -> shadow: put [ ] around every item when there are several; expected x, y, blur, spread, a colour and inset, with [ ] around each shadow when there are several, or none, for example shadow = 0, 4, 8, #00000040
shadow = 0, 4, -8 -> shadow: the blur cannot be negative; expected x, y, blur, spread, a colour and inset, with [ ] around each shadow when there are several, or none, for example shadow = 0, 4, 8, #00000040
text shadow = 0, 1, 2, 3 -> text shadow: a text shadow has 2 or 3 lengths: x, y and blur; expected x, y, blur and a colour, with [ ] around each shadow when there are several, or none, for example text shadow = 0, 1, 2, #00000080
transition = ease -> transition: a transition has a duration and maybe a delay; expected a duration, an easing and a delay, with [ ] around each transition when there are several, or none, for example transition = 200ms, ease out
transition = 200, 100, 50 -> transition: a transition has a duration and maybe a delay; expected a duration, an easing and a delay, with [ ] around each transition when there are several, or none, for example transition = 200ms, ease out
transition = 200, ease(2, 0, 0, 1) -> transition: the x values of ease must be from 0 to 1; expected a duration, an easing and a delay, with [ ] around each transition when there are several, or none, for example transition = 200ms, ease out
transition = 200, steps(0) -> transition: steps takes one whole number from 1, like steps(4); expected a duration, an easing and a delay, with [ ] around each transition when there are several, or none, for example transition = 200ms, ease out
transition properties = layout -> transition properties: 'layout' cannot be animated; expected all, or the names of properties that can be animated, for example transition properties = opacity, background
columns = repeat(0, 1fr) -> columns: the count of repeat is a whole number from 1, fill or fit; expected grid tracks: lengths, 1fr, auto, minmax(100, 1fr), fit(200) or repeat(3, 1fr), or none, auto, min content, max content, for example columns = 200, 1fr
columns = minmax(100) -> columns: minmax takes two sizes, like minmax(100, 1fr); expected grid tracks: lengths, 1fr, auto, minmax(100, 1fr), fit(200) or repeat(3, 1fr), or none, auto, min content, max content, for example columns = 200, 1fr
columns = repeat(2, repeat(2, 1fr)) -> columns: repeat cannot be inside repeat; expected grid tracks: lengths, 1fr, auto, minmax(100, 1fr), fit(200) or repeat(3, 1fr), or none, auto, min content, max content, for example columns = 200, 1fr
columns = none, 1fr -> columns: 'none' must be the only value; expected grid tracks: lengths, 1fr, auto, minmax(100, 1fr), fit(200) or repeat(3, 1fr), or none, auto, min content, max content, for example columns = 200, 1fr
columns = repeat(100000000, 1fr) -> columns: the count of repeat is at most 10000; expected grid tracks: lengths, 1fr, auto, minmax(100, 1fr), fit(200) or repeat(3, 1fr), or none, auto, min content, max content, for example columns = 200, 1fr
columns = repeat(10001, 1fr) -> columns: the count of repeat is at most 10000; expected grid tracks: lengths, 1fr, auto, minmax(100, 1fr), fit(200) or repeat(3, 1fr), or none, auto, min content, max content, for example columns = 200, 1fr
columns = repeat(5000, 1fr, 1fr), 100 -> columns: too many tracks (10001); at most 10000 after repeats are expanded; expected grid tracks: lengths, 1fr, auto, minmax(100, 1fr), fit(200) or repeat(3, 1fr), or none, auto, min content, max content, for example columns = 200, 1fr
columns = repeat(5000, 1fr, 1fr) => repeat(5000, 1fr, 1fr)
background = linear(90, red) -> background: a gradient needs at least two colours; expected colours, gradients like linear(90, red, blue) or image("photo.png"), the top layer first, or none, for example background = linear(90, #3366aa, white)
background = image(photo.png) -> background: image takes a path in quotes, like image("photo.png"); expected colours, gradients like linear(90, red, blue) or image("photo.png"), the top layer first, or none, for example background = linear(90, #3366aa, white)
background size = cover, 10 -> background size: 'cover' must be the only value; expected 1 or 2 lengths, not negative, or auto, cover, contain, for example background size = cover
font features = tnum -> font features: 'tnum' is not valid; expected strings like "tnum", or none, for example font features = "tnum", "ss01"
rotate = 10px -> rotate: '10px' is not valid; expected an angle in degrees, for example rotate = 45
aspect ratio = 1 / 0 -> aspect ratio: division by zero; expected a number above 0, or none, for example aspect ratio = 1.5
max lines = 0 -> max lines: 0 is out of range; expected a whole number from 1, or none, for example max lines = 2
padding = "8, " -> padding: an empty value between commas; expected 1 to 4 lengths (top, end, bottom, start), not negative, for example padding = 8, 16
