import gui.style

func ok(name: str, text: str):
    p := style.PropByName(name)
    mut v := style.Value {}
    if style.Parse(p, text, v):
        println name, "=", text, "=>", style.Format(p, v)
    else:
        println name, "=", text, "=> REJECTED:", style.Error(p, text)
    end
end

func bad(name: str, text: str):
    p := style.PropByName(name)
    e := style.Error(p, text)
    mut v := style.Value {}
    parsed := style.Parse(p, text, v)
    println name, "=", text, "->", parsed ? "ACCEPTED" : e
end

func main:
    println "-- numbers and units"
    ok("width", "120")
    ok("width", "1.5em")
    ok("width", "2rem")
    ok("width", "50vw")
    ok("height", "50vh")
    ok("width", "10vmin")
    ok("width", "10vmax")
    ok("width", "50%")
    ok("width", "px(12)")
    ok("width", "em(1.5)")
    ok("width", "percent(25)")
    ok("width", "پیکسل(۱۲)")
    ok("width", "۵۰٪")
    ok("font size", "۱٫۵em")
    ok("rotate", "45deg")
