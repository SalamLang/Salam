import gui.style

func kind_name(k: int): str:
    names := ["", "word", "bool", "number", "int", "length", "angle", "color", "paint", "tracks", "border", "shadow", "text shadow", "transition", "props", "fonts", "strings"]
    ret names[k]
end

func show(p: int, text: str):
    mut v := style.Value {}
    if not style.Parse(p, text, v):
        println "  FAIL", text, style.Error(p, text)
        ret
    end
    println "  " + text, "=>", style.Format(p, v), "|", style.Css(p, v)
end

func main:
    println "properties", style.PROP_COUNT, "keywords", style.KEYWORD_COUNT - 1
    repeat style.PROP_COUNT in p:
        info := style.Info(p)
        mut flags := ""
        if style.Inherited(p):
            flags += " inherited"
        end
        if style.Animatable(p):
            flags += " animatable"
        end
        same := style.PropByName(style.PropName(p)) == p and style.PropByName(style.PropFaName(p)) == p
        println p, style.PropName(p), "/", style.PropFaName(p), "/", kind_name(info.kind) + flags, "/ found", same
        if info.words != "":
            mut ws := ""
            each w in style.PropKeywords(p):
                ws += " " + style.KeywordName(w) + "=" + style.KeywordFaName(w)
            end
            println "  words" + ws
        end
        show(p, info.initial)
        show(p, info.example)
    end
    mut ok := 0
    repeat style.KEYWORD_COUNT - 1 in k:
        id := k + 1
        if style.KeywordByName(style.KeywordName(id)) == id and style.KeywordByName(style.KeywordFaName(id)) == id:
            ok++
        end
    end
    println "keywords found by en and fa name:", ok
    println style.PropByName("Min  Width"), style.PropByName("فضا"), style.PropByName("nope"), style.KeywordByName("nope")
end
