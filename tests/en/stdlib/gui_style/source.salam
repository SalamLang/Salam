import gui.style

func same(prop: int, built: style.Value, text: str):
    mut parsed := style.Value {}
    _ok := style.Parse(prop, text, parsed)
    a := style.Format(prop, built)
    println style.PropName(prop), "=", a, a == style.Format(prop, parsed) ? "matches" : "DIFFERS"
end

func back(prop: int, text: str): bool:
    mut v := style.Value {}
    if not style.Parse(prop, text, v):
        println "rejected", style.PropName(prop), text
        ret false
    end
    f := style.Format(prop, v)
    mut w := style.Value {}
    ok := style.Parse(prop, f, w) and style.Format(prop, w) == f and style.Css(prop, w) == style.Css(prop, v)
    if not ok:
        println "DIFFERS", style.PropName(prop), text, "->", f
    end
    ret ok
end

func main:
    repeat style.PROP_COUNT in p:
        info := style.Info(p)
        mut v := style.Value {}
        _ok := style.Parse(p, info.example, v)
        println info.name, "=", info.example
        println "   ", style.Source(p, v)
    end
    println "-- built by hand the way Source writes them"
    same(style.P_PADDING, style.One(style.OfLen(style.Px(8.0))).And(style.OfLen(style.Em(1.0))), "8, 1em")
    same(style.P_WIDTH, style.One(style.OfLen(style.Len { pct = 100.0, px = -20.0 })), "100% - 20")
    same(style.P_HEIGHT, style.One(style.OfLen(style.Vh(50.0))), "50vh")
    same(style.P_MAX_WIDTH, style.One(style.OfLen(style.Vw(80.0))), "80vw")
    same(style.P_MIN_WIDTH, style.One(style.OfLen(style.Vmin(10.0))), "10vmin")
    same(style.P_MIN_HEIGHT, style.One(style.OfLen(style.Vmax(10.0))), "10vmax")
    same(style.P_FONT_SIZE, style.One(style.OfLen(style.Rem(1.25))), "1.25rem")
    same(style.P_GAP, style.One(style.OfLen(style.Pct(5.0))), "5%")
    same(style.P_OPACITY, style.One(style.OfNum(0.5)), "0.5")
    same(style.P_ORDER, style.One(style.OfInt(-2)), "-2")
    same(style.P_WRAP, style.One(style.OfBool(true)), "true")
    same(style.P_ROTATE, style.One(style.OfAngle(30.0)), "30")
    same(style.P_LAYOUT, style.One(style.OfWord(style.KW_STACK)), "stack")
    same(style.P_COLOR, style.One(style.OfColor(style.ColorOf(1.0, 0.0, 0.0, 1.0))), "red")
    same(style.P_CARET, style.One(style.OfColor(style.CurrentColor())), "current")
    same(style.P_COLOR, style.One(style.OfColor(style.LightDark(style.ColorOf(1.0, 1.0, 1.0, 1.0), style.ColorOf(0.0, 0.0, 0.0, 1.0)))), "light dark(white, black)")
    same(style.P_FONT, style.One(style.OfStr("Vazirmatn")).And(style.OfWord(style.KW_SANS)), "\"Vazirmatn\", sans")
    same(style.P_BACKGROUND, style.One(style.OfPaint(style.Gradient(style.PAINT_LINEAR, 90.0, 0, false, style.Pct(50.0), style.Pct(50.0), false).AddStop(style.ColorOf(1.0, 0.0, 0.0, 1.0), style.Len {}, false).AddStop(style.ColorOf(0.0, 0.0, 1.0, 1.0), style.Pct(80.0), true))), "linear(90, red, blue 80%)")
    same(style.P_BACKGROUND, style.One(style.OfPaint(style.Image("a.png"))), "image(\"a.png\")")
    same(style.P_TRANSITION, style.One(style.OfTime(200.0)).And(style.OfEase(style.Easing { kind = style.EASE_OUT })).And(style.OfTime(0.0)).Then(style.OfTime(100.0)).And(style.OfEase(style.Easing { kind = style.EASE_STEPS, steps = 3 })).And(style.OfTime(10.0)), "[200, ease out], [100, steps(3), 10]")
    same(style.P_COLUMNS, style.One(style.OfTrack(style.Track { kind = style.TRACK_REPEAT, count = 2, span = 1 })).And(style.OfTrack(style.Track { len = style.Fr(1.0) })), "repeat(2, 1fr)")
    same(style.P_TRANSITION_PROPERTIES, style.One(style.OfProp(style.P_OPACITY)), "opacity")
    println style.Source(style.P_WIDTH, style.Value {})
    println "-- Format writes the shortest form that parses back"
    names := ["shadow", "shadow", "shadow", "shadow", "text shadow", "text shadow", "border", "border", "border", "border", "outline", "transition", "transition", "transition", "transition"]
    texts := ["0, 4, 8, 0, black", "[0, 4, 8, black], [0, 0, 0, 2, red, inset]", "0, 2", "1, 1, 0, 3", "0, 1, 0, current", "[1, 1, 2, red], [0, 0, 4]", "1, solid, current", "0, solid, current", "none", "2, dashed, red", "#3366aa, 3", "200ms, ease out, 0ms", "200, ease, 50", "[1s], [100, linear, 0]", "none"]
    repeat names.len() in i:
        p := style.PropByName(names[i])
        mut v := style.Value {}
        _ok := style.Parse(p, texts[i], v)
        println names[i], "=", texts[i], "->", style.Format(p, v), back(p, texts[i])
    end
    mut good := 0
    repeat style.PROP_COUNT in p:
        info := style.Info(p)
        if back(p, info.initial) and back(p, info.example):
            good++
        end
    end
    println "defaults and examples that parse back:", good, "of", style.PROP_COUNT
end
