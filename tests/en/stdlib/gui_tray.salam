import gui.tray
import gui.window
import gui.ui

mut wakes := 0

func kind_name(kind: tray.EventKind): str:
    if kind == tray.EventKind.Click:
        ret "click"
    end
    if kind == tray.EventKind.DoubleClick:
        ret "double click"
    end
    ret "menu"
end

func main:
    show := tray.NewItem("show", "Show")
    println "item", show.id, show.label, show.enabled, show.checked, show.separator
    auto := tray.CheckItem("auto", "Auto connect", true)
    println "check", auto.id, auto.label, auto.checked
    line := tray.Separator()
    println "separator", line.separator, line.id.Len()
    off := tray.Item { id = "off", label = "Off", enabled = false }
    println "disabled", off.enabled
    println "shown", tray.IsShown()
    tray.Hide()
    println "pending", tray.Pending()
    tray.SetWake((): wakes++ end)
    tray.Post(tray.Event { kind = tray.EventKind.Click })
    tray.Post(tray.Event { kind = tray.EventKind.Menu, id = "show" })
    tray.Post(tray.Event { kind = tray.EventKind.DoubleClick })
    println "pending", tray.Pending(), "wakes", wakes
    mut ev := tray.Event {}
    until tray.Take(ev):
        println "event", kind_name(ev.kind), ev.id
    end
    println "pending", tray.Pending(), "empty", tray.Take(ev)

    w := window.Open(window.Options { width = 200.0, height = 100.0, headless = true })
    println "visible", w.IsVisible()
    w.Hide()
    println "hidden", w.IsVisible(), w.IsOpen()
    w.Show()
    println "shown again", w.IsVisible()
    quiet := window.Open(window.Options { width = 10.0, height = 10.0, headless = true, visible = false })
    println "starts hidden", quiet.IsVisible()
    quiet.Show()
    println "now visible", quiet.IsVisible()

    ui.OnCloseRequest((): ret false end)
    ui.HideWindow()
    ui.ShowWindow()
    println "ui window", ui.WindowVisible()
end
