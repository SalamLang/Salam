import gui.typeset

func probe(p: typeset.Paragraph, l: typeset.TextLayout, offsets: Vector<int>):
    each off in offsets:
        down := typeset.CaretRect(p, l, typeset.TextPosition { offset = off })
        up := typeset.CaretRect(p, l, typeset.TextPosition { offset = off, upstream = true })
        println "caret", off, down.x, down.y, down.height, "up", up.x, up.y
    end
    mut x := -4.0
    print "hit"
    until x < l.width + 8.0:
        h := typeset.HitTest(p, l, x, 4.0)
        print " ", h.offset
        if h.upstream:
            print "u"
        end
        x += 5.0
    end
    println ""
end

func walk(p: typeset.Paragraph, l: typeset.TextLayout, right: bool, start: int, steps: int):
    mut pos := typeset.TextPosition { offset = start }
    print right ? "right" : "left"
    repeat steps:
        pos = typeset.MoveVisual(p, l, pos, right)
        print " ", pos.offset
        if pos.upstream:
            print "u"
        end
        print "/", pos.line
    end
    println ""
end

func selection(p: typeset.Paragraph, l: typeset.TextLayout, a: int, b: int):
    rects := typeset.SelectionRects(p, l, a, b)
    print "select ", a, "-", b, ":"
    each r in rects:
        print " [", r.x, " ", r.y, " ", r.width, " ", r.height, "]"
    end
    println ""
    rects.free()
end

func str_len(p: typeset.Paragraph): int:
    ret p.chars.get(p.chars.Len() - 1).offset + 1
end

func main:
    mut fc := typeset.NewFontCollection()
    typeset.AddFontFile(fc, "books/fonts/XB Zar.ttf")
    mut spans := Vector {} as Vector<typeset.TextSpan>
    spans.push(typeset.TextSpan { text = "ab سلام cd", families = "XB Zar", size = 20.0 })
    mut st := typeset.ParagraphStyle {}
    st.direction = typeset.TextDirLTR
    st.white_space = typeset.WhiteSpace.PreWrap
    mut p := typeset.NewParagraph(fc, spans, st)
    mut l := typeset.LayoutParagraph(p, fc, 0.0)
    println "ltr paragraph with an rtl word"
    mut offs := Vector {} as Vector<int>
    each o in [0, 1, 2, 3, 5, 7, 9, 11, 12, 13, 14]:
        offs.push(o)
    end
    probe(p, l, offs)
    walk(p, l, true, 0, 14)
    walk(p, l, false, 14, 14)
    selection(p, l, 1, 7)
    selection(p, l, 7, 1)
    selection(p, l, 5, 13)
    println "graphemes", typeset.NextGrapheme(p, 3), typeset.NextGrapheme(p, 4), typeset.PrevGrapheme(p, 5), typeset.PrevGrapheme(p, 0)
    println "words", typeset.NextWordEnd(p, 0), typeset.NextWordEnd(p, 2), typeset.PrevWordStart(p, 14), typeset.PrevWordStart(p, 7)
    typeset.FreeLayout(l)
    typeset.FreeParagraph(p)
    spans.free()
    mut fa := Vector {} as Vector<typeset.TextSpan>
    fa.push(typeset.TextSpan { text = "کتاب‌ها و دفترها روی میز ABC هستند", families = "XB Zar", size = 18.0 })
    mut st2 := typeset.ParagraphStyle {}
    st2.white_space = typeset.WhiteSpace.PreWrap
    mut q := typeset.NewParagraph(fc, fa, st2)
    mut ql := typeset.LayoutParagraph(q, fc, 90.0)
    println "rtl paragraph on", ql.lines.Len(), "lines"
    each lb in ql.lines:
        println "line", lb.start, lb.end, lb.top, lb.height
    end
    mut qo := Vector {} as Vector<int>
    mut at := 0
    until at < str_len(q):
        qo.push(at)
        at = typeset.NextGrapheme(q, at)
    end
    qo.push(at)
    probe(q, ql, qo)
    walk(q, ql, false, 0, 24)
    walk(q, ql, true, at, 24)
    selection(q, ql, 10, 40)
    h := typeset.HitTest(q, ql, 30.0, 40.0)
    println "second line hit", h.offset, h.line, h.upstream
    println "words", typeset.NextWordEnd(q, 0), typeset.PrevWordStart(q, 18), typeset.NextGrapheme(q, 6), typeset.PrevGrapheme(q, 8)
    typeset.FreeLayout(ql)
    typeset.FreeParagraph(q)
    fa.free()
    offs.free()
    qo.free()
    typeset.FreeFontCollection(fc)
end
