import gui.typeset
import archive
import compress

func check_font(path: str):
    mut ok := false
    mut f := typeset.LoadFont(path, ok)
    println "font", ok, typeset.FontValid(f), typeset.UnitsPerEm(f), typeset.NumGlyphs(f)
    println "names", typeset.FamilyName(f), "|", typeset.StyleName(f), "|", typeset.FullName(f), "|", typeset.NameString(f, 1)
    println "style", typeset.Weight(f), typeset.IsItalic(f)
    m := typeset.Metrics(f)
    println "metrics", m.units_per_em, m.ascent, m.descent, m.line_gap, m.x_height, m.cap_height, m.underline_position, m.underline_thickness
    println "pixels", typeset.ScaleFactor(f, 20.48), typeset.AscentPixels(f, 20.48), typeset.DescentPixels(f, 20.48), typeset.LineHeightPixels(f, 20.48)
    each cp in [0x41, 0x61, 0x0628, 0x06CC, 0x200C, 0x4E00]:
        g := typeset.GlyphIndex(f, cp)
        mut x0 := 0
        mut y0 := 0
        mut x1 := 0
        mut y1 := 0
        has := typeset.GlyphBox(f, g, x0, y0, x1, y1)
        println "cmap", cp, g, typeset.GlyphAdvance(f, g), typeset.GlyphHasOutline(f, g), has, x0, y0, x1, y1
    end
    println "kern", typeset.KernAdvance(f, typeset.GlyphIndex(f, 0x41), typeset.GlyphIndex(f, 0x56))
    typeset.FreeFont(f)
    println "freed", typeset.FontValid(f)
end

func check_bytes():
    mut ok := false
    mut buf := archive.ReadBinaryFile("books/fonts/XB Zar It.ttf", ok)
    println "bytes", ok, typeset.FaceCount(buf.data, buf.len), typeset.IsCFFFont(buf.data, buf.len)
    mut pok := false
    f := typeset.ParseFont(buf.data, buf.len, pok)
    println "parsed", pok, typeset.FamilyName(f), typeset.IsItalic(f)
    mut bad := false
    g := typeset.ParseFontIndex(buf.data, buf.len, 1, bad)
    println "index 1", bad, typeset.FontValid(g)
    mut fc := typeset.NewFontCollection()
    println "added bytes", typeset.AddFontBytes(fc, buf.data, buf.len)
    println "added font", typeset.AddFont(fc, f)
    println "faces", typeset.FaceCountIn(fc)
    typeset.FreeFontCollection(fc)
    compress.BufFree(buf)
    mut lok := false
    mut h := typeset.LoadFontIndex("books/fonts/XB Zar.ttf", 0, lok)
    println "load index", lok, typeset.FamilyName(h)
    typeset.FreeFont(h)
end

func check_collection():
    mut fc := typeset.NewFontCollection()
    println "file", typeset.AddFontFile(fc, "books/fonts/XB Zar.ttf"), typeset.AddFontFile(fc, "books/fonts/XB Zar Bd.ttf"), typeset.AddFontFile(fc, "books/fonts/DejaVuSansMono.ttf"), typeset.AddFontFile(fc, "books/fonts/missing.ttf")
    each face in fc.faces:
        println "face", face.family, face.style, face.weight, face.italic, face.loaded
    end
    println "find", typeset.FindFace(fc, "xb zar", 700, false), typeset.FindFace(fc, "XB Zar", 400, false), typeset.FindFace(fc, "XB Zar", 900, true), typeset.FindFace(fc, "Nope", 400, false)
    println "fallback", typeset.FaceForCodepoint(fc, "DejaVu Sans Mono, XB Zar", 400, false, 0x0628), typeset.FaceForCodepoint(fc, "DejaVu Sans Mono, XB Zar", 400, false, 0x41), typeset.FaceForCodepoint(fc, "monospace", 400, false, 0x06F1), typeset.FaceForCodepoint(fc, "XB Zar", 400, false, 0x4E00)
    f := typeset.FaceFont(fc, 1)
    println "face font", typeset.Weight(f), typeset.FontValid(typeset.FaceFont(fc, 9))
    typeset.FreeFontCollection(fc)
    mut dir := typeset.NewFontCollection()
    n := typeset.AddFontDir(dir, "books/fonts")
    println "dir", n > 90, typeset.FindFace(dir, "XM Yekan", 400, false) >= 0, typeset.FindFace(dir, "Latin Modern Mono", 400, false)
    typeset.FreeFontCollection(dir)
    dirs := typeset.SystemFontDirs()
    println "system dirs", dirs.Len() > 0
    dirs.free()
    mut sys := typeset.NewFontCollection()
    println "system fonts", typeset.AddSystemFonts(sys) >= 0
    typeset.FreeFontCollection(sys)
end

func main:
    check_font("books/fonts/XB Zar.ttf")
    check_font("books/fonts/XB Zar BdIt.ttf")
    check_font("books/fonts/DejaVuSansMono.ttf")
    check_bytes()
    check_collection()
end
