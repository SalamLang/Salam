import gui.typeset

func show(p &: typeset.Paragraph, fc &: typeset.FontCollection, w: f64):
    mut l := typeset.LayoutParagraph(p, fc, w)
    println "width", w, "size", l.width, l.height, "lines", l.lines.len(), "truncated", l.truncated
    each lb in l.lines:
        print "  line ", lb.start, "-", lb.end, " x=", lb.x, " w=", lb.width, " base=", lb.baseline, " h=", lb.height, " rtl=", lb.rtl, " hard=", lb.hard_break, " |"
        mut k := lb.run_start
        until k < lb.run_start + lb.run_count:
            r := l.runs.get(k)
            print " [", r.start, "-", r.end, " x=", r.x, " w=", r.width
            if r.rtl:
                print " rtl"
            end
            if r.ellipsis:
                print " ellipsis"
            end
            print " tag=", r.tag, " glyphs=", r.glyph_count, "]"
            k++
        end
        println ""
    end
    if l.glyphs.len() > 0:
        g := l.glyphs.get(0)
        println "  first glyph", g.id, g.x, g.y, g.cluster, g.advance
    end
    typeset.FreeLayout(l)
end

func para(fc &: typeset.FontCollection, spans: Vector<typeset.TextSpan>, st: typeset.ParagraphStyle, widths: Vector<f64>):
    mut p := typeset.NewParagraph(fc, spans, st)
    println "min", typeset.MinContentWidth(p), "max", typeset.MaxContentWidth(p), "runs", p.runs.len(), "glyphs", p.glyphs.len(), "chars", p.chars.len()
    each w in widths:
        show(p, fc, w)
    end
    typeset.FreeParagraph(p)
end

func main:
    mut fc := typeset.NewFontCollection()
    typeset.AddFontFile(fc, "books/fonts/XB Zar.ttf")
    typeset.AddFontFile(fc, "books/fonts/DejaVuSansMono.ttf")
    mut mixed := Vector {} as Vector<typeset.TextSpan>
    mixed.push(typeset.TextSpan { text = "سلام دنیا، این یک ", families = "XB Zar", size = 20.0, tag = 1 })
    mixed.push(typeset.TextSpan { text = "Hello World", families = "DejaVu Sans Mono", size = 16.0, tag = 2 })
    mixed.push(typeset.TextSpan { text = " آزمایش است.", families = "XB Zar", size = 20.0, tag = 3 })
    mut widths := Vector {} as Vector<f64>
    widths.push(0.0)
    widths.push(150.0)
    widths.push(80.0)
    println "mixed rtl"
    para(fc, mixed, typeset.ParagraphStyle {}, widths)
    p0 := typeset.NewParagraph(fc, mixed, typeset.ParagraphStyle {})
    println "span at", typeset.SpanAt(p0, 0), typeset.SpanAt(p0, 32), typeset.SpanAt(p0, 50), p0.span_starts.len()
    mut p1 := p0
    typeset.FreeParagraph(p1)
    mut one := Vector {} as Vector<f64>
    one.push(120.0)
    mut latin := Vector {} as Vector<typeset.TextSpan>
    latin.push(typeset.TextSpan { text = "The quick brown fox jumps over the lazy dog", families = "monospace", size = 10.0, line_height = 14.0 })
    each al in [typeset.TextAlign.Start, typeset.TextAlign.End, typeset.TextAlign.Center, typeset.TextAlign.Justify, typeset.TextAlign.Right]:
        mut st := typeset.ParagraphStyle {}
        st.align = al
        println "align", al
        para(fc, latin, st, one)
    end
    mut ell := typeset.ParagraphStyle {}
    ell.white_space = typeset.WhiteSpace.NoWrap
    ell.ellipsis = true
    println "nowrap ellipsis"
    para(fc, latin, ell, one)
    mut two := typeset.ParagraphStyle {}
    two.max_lines = 2
    two.ellipsis = true
    println "two lines"
    para(fc, latin, two, one)
    mut rtl_ell := Vector {} as Vector<typeset.TextSpan>
    rtl_ell.push(typeset.TextSpan { text = "این یک جمله بلند فارسی برای آزمودن سه نقطه است", families = "XB Zar", size = 16.0 })
    println "rtl ellipsis"
    para(fc, rtl_ell, ell, one)
    mut pre := Vector {} as Vector<typeset.TextSpan>
    pre.push(typeset.TextSpan { text = "  two  spaces\nnext   line\n", families = "monospace", size = 10.0 })
    each ws in [typeset.WhiteSpace.Normal, typeset.WhiteSpace.Pre, typeset.WhiteSpace.PreWrap]:
        mut st := typeset.ParagraphStyle {}
        st.white_space = ws
        println "white space", ws
        para(fc, pre, st, one)
    end
    mut long := Vector {} as Vector<typeset.TextSpan>
    long.push(typeset.TextSpan { text = "supercalifragilistic word", families = "monospace", size = 10.0, letter_spacing = 1.0 })
    mut narrow := Vector {} as Vector<f64>
    narrow.push(60.0)
    each ow in [typeset.OverflowWrap.Normal, typeset.OverflowWrap.Anywhere, typeset.OverflowWrap.BreakWord]:
        mut st := typeset.ParagraphStyle {}
        st.overflow_wrap = ow
        println "overflow wrap", ow
        para(fc, long, st, narrow)
    end
    mut zw := Vector {} as Vector<typeset.TextSpan>
    zw.push(typeset.TextSpan { text = "می‌خواهم کتاب‌ها را بخوانم", families = "XB Zar", size = 16.0, word_spacing = 4.0, line_height_scale = 2.0 })
    mut zws := Vector {} as Vector<f64>
    zws.push(70.0)
    println "zwnj words"
    para(fc, zw, typeset.ParagraphStyle {}, zws)
    mut ltr := typeset.ParagraphStyle {}
    ltr.direction = typeset.TextDirLTR
    println "forced ltr"
    para(fc, zw, ltr, zws)
    mixed.free()
    widths.free()
    one.free()
    latin.free()
    rtl_ell.free()
    pre.free()
    long.free()
    narrow.free()
    zw.free()
    zws.free()
    typeset.FreeFontCollection(fc)
end
