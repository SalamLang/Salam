import gui.typeset

func coverage_sum(m: typeset.GlyphMask): int:
    mut total := 0
    if m.data == null:
        ret 0
    end
    bp := m.data as u8*
    repeat m.height in y:
        repeat m.width in x:
            total += bp[y * m.stride + x] as int
        end
    end
    ret total
end

func show(f: typeset.Font, cp: int, size: f64, sub: int):
    mut m := typeset.RasterizeGlyph(f, typeset.GlyphIndex(f, cp), size, sub)
    println "mask", cp, size, sub, m.width, m.height, m.stride, m.left, m.top, coverage_sum(m), typeset.GlyphMaskHash(m)
    typeset.FreeGlyphMask(m)
end

func main:
    mut ok := false
    mut zar := typeset.LoadFont("books/fonts/XB Zar.ttf", ok)
    mut mono := typeset.LoadFont("books/fonts/DejaVuSansMono.ttf", ok)
    each cp in [0x41, 0x61, 0x67, 0x2E]:
        show(mono, cp, 16.0, 0)
    end
    repeat 4 in q:
        show(mono, 0x6F, 13.5, q)
    end
    each cp in [0x0634, 0x06AF, 0x0644, 0x06F4]:
        show(zar, cp, 24.0, 0)
    end
    show(zar, 0x20, 24.0, 0)
    show(zar, 0x0628, 0.0, 0)
    println "subpixel", typeset.SubpixelOf(10.0), typeset.SubpixelOf(10.3), typeset.SubpixelOf(10.6), typeset.SubpixelOf(-0.3), typeset.SubpixelOf(10.9)
    mut m := typeset.RasterizeGlyph(mono, typeset.GlyphIndex(mono, 0x61), 16.0, typeset.SubpixelOf(10.3))
    println "origin", typeset.GlyphOriginX(10.3, m), typeset.GlyphOriginY(20.4, m), typeset.GlyphOriginX(-0.3, m), typeset.GlyphOriginY(-3.6, m)
    typeset.FreeGlyphMask(m)
    mut cache := typeset.NewGlyphCache(1000)
    mut row := 0
    until row < 3:
        each cp in [0x61, 0x62, 0x63, 0x61, 0x64]:
            g := typeset.CachedGlyph(cache, mono, typeset.GlyphIndex(mono, cp), 16.0, 4.0 + (row as f64) * 0.25)
            print g.width, "x", g.height, " "
        end
        println "| hits", cache.hits, "misses", cache.misses, "bytes", cache.bytes, cache.bytes <= cache.capacity
        row++
    end
    typeset.FreeGlyphCache(cache)
    println "after free", cache.bytes
    mut o := typeset.TransformedOutline(mono, typeset.GlyphIndex(mono, 0x4F), 0.01, 0.0, 0.0, -0.01, 5.0, 20.0)
    println "outline", o.points.len(), o.ends.len()
    mut cov := typeset.OutlineCoverage(o, 40, 40)
    mut sum := 0.0
    each v in cov.values:
        sum += v
    end
    println "coverage", cov.x, cov.y, cov.width, cov.height, sum > 50.0, sum < 150.0
    typeset.FreeCoverageRows(cov)
    typeset.FreeOutline(o)
    typeset.FreeFont(zar)
    typeset.FreeFont(mono)
end
