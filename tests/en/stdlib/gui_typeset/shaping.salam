import gui.typeset

func show(f: typeset.Font, text: str, rtl: bool, lang: str):
    gs := typeset.ShapeText(f, text, rtl, "", lang)
    print text, " =>"
    each g in gs:
        print " ", g.id, ":", g.cluster, ":", g.x_advance
        if g.x_offset != 0 or g.y_offset != 0:
            print "@", g.x_offset, ",", g.y_offset
        end
    end
    println ""
    gs.free()
end

func main:
    mut ok := false
    mut zar := typeset.LoadFont("books/fonts/XB Zar.ttf", ok)
    mut mono := typeset.LoadFont("books/fonts/DejaVuSansMono.ttf", ok)
    println "joining"
    show(zar, "سلام دنیا", true, "fa")
    show(zar, "کتاب‌های من", true, "fa")
    show(zar, "می‌خواهم بروم", true, "fa")
    show(zar, "لا الله", true, "fa")
    show(zar, "بالله", true, "fa")
    show(zar, "فرهنگ", true, "fa")
    show(zar, "گفت‌وگو؟ (۱۲۳)", true, "fa")
    println "kerning"
    show(zar, "AVAWAY To", false, "en")
    show(zar, "office ffi", false, "en")
    show(zar, "دک رگ زک", true, "fa")
    println "marks"
    show(mono, "éä́", false, "")
    show(mono, "Åño", false, "")
    show(mono, "بِسْمِ اللَّهِ", true, "ar")
    show(zar, "مُحَمَّدٌ", true, "fa")
    show(mono, "سَلامٌ", true, "fa")
    println "legacy"
    println typeset.ShapeArabic("لا سلام")
    println typeset.IsRTLText("سلام"), typeset.IsRTLText("abc")
    println typeset.BaseDirection("abc سلام") == typeset.TextDirLTR, typeset.BaseDirection("سلام abc") == typeset.TextDirRTL
    println typeset.ToVisualOrder("abc سلام (x) 12", typeset.TextDirAuto)
    v := typeset.VisualCodepoints("سلام", typeset.TextDirAuto, true)
    each cp in v:
        print cp, " "
    end
    println ""
    v.free()
    typeset.FreeFont(zar)
    typeset.FreeFont(mono)
end
