import gui.ui
import gui.style
import os

mut hovered := 0

func patches(): Vector<ui.Patch>:
    mut all := ui.NoPatches()
    mut p := ui.NewPatch()
    mut v := style.Value {}
    if style.Parse(style.P_BACKGROUND, "#ff0000", v):
        p.Add(style.P_BACKGROUND, v)
    end
    println "patch", p.Len(), p.props.Len(), p.values.Len()
    all.Push(p)
    ret all
end

func view(b: ui.Builder):
    b.Title("Api")
    b.Lang("fa")
    b.Dir("rtl")
    b.Open("box")
    b.Id("one")
    b.Key("k")
    b.Attr("data-x", "1")
    b.BoolAttr("disabled", true)
    b.SetText(ui.STATE_BASE, style.P_WIDTH, "40")
    b.SetText(ui.STATE_BASE, style.P_HEIGHT, "20")
    b.Patch(ui.STATE_BASE, 0)
    mut v := style.Value {}
    if style.Parse(style.P_BACKGROUND, "#0000ff", v):
        b.Set(ui.STATE_HOVER, style.P_BACKGROUND, v)
    end
    b.On("click", (): hovered++ end)
    b.Close()
end

func interactive():
    o := ui.Options { width = 320.0, height = 200.0, title = "Api", resizable = false, headless = true, scale = 1.0, script = "" }
    ui.RunPageWith((): ret patches() end, (b: ui.Builder): view(b) end, o)
    ui.RunPage((): ret patches() end, (b: ui.Builder): view(b) end)
    println ui.Dump()
end

func main:
    println ui.DumpPage((): ret patches() end, (b: ui.Builder): view(b) end, 200, 100)
    mut c := ui.RenderPageScaled((): ret patches() end, (b: ui.Builder): view(b) end, 200, 100, 2.0)
    println "scaled", c.width, c.height
    p := c.Pixel(340, 20)
    println "pixel", p.r, p.g, p.b
    c.Free()
    println "states", ui.STATE_BASE, ui.STATE_HOVER, ui.STATE_FOCUS, ui.STATE_FOCUS_WITHIN, ui.STATE_ACTIVE, ui.STATE_DISABLED, ui.STATE_CHECKED, ui.STATE_INVALID, ui.STATE_PLACEHOLDER, ui.STATE_SELECTION
    args := os.Args()
    if args.Len() > 100:
        interactive()
    end
    args.Free()
end
