import gui.ui
import os
import filepath

mut clicks := 0
mut navigated := ""

func view(): str:
    ret `<!doctype html><html><head><title>Api</title><style>.on{color:rgb(200, 0, 0)}</style></head><body><p id="msg" class="on big">Clicks ` + clicks + `</p><button id="btn" onclick="hit()">Hit</button><a id="go" href="/elsewhere">go</a></body></html>`
end

func main:
    _f := ui.AddFontFile("books/fonts/XB Zar.ttf")
    println "font dir", ui.AddFontDir("books/fonts") > 0
    ui.Handle("hit", (): clicks++ end)
    ui.SetNavigator((url: str):
        navigated = url
        ret true
    end)
    ui.RunWith((): ret view() end, ui.Options { width = 300.0, height = 200.0, headless = true, script = `click #btn
click #btn
click #go
dump
quit` })
    println "clicks", clicks, "navigated", navigated
    ui.RunHtmlWith(`<p id="x">fixed</p>`, ui.Options { width = 200.0, height = 100.0, headless = true, script = "dump" })
    if os.Env("SALAM_WINDOW_BACKEND") == "headless" and os.Env("SALAM_UI_SCRIPT").Len() > 0:
        ui.Run((): ret view() end)
        ui.RunHtml(`<p>fixed</p>`)
    end
    _ok := ui.Start((): ret view() end, ui.Options { width = 300.0, height = 200.0, headless = true })
    msg := ui.ById("msg")
    println "exists", msg.Exists(), ui.ById("nope").Exists(), "tag", msg.Tag()
    msg.RemoveClass("on")
    msg.SetText("changed")
    _alive := ui.Step(0)
    println "text", msg.Text(), "class removed", not msg.HasClass("on"), msg.HasClass("big"), "red", msg.Style().color.r
    ui.ById("btn").Focus()
    ui.ById("btn").Click()
    ui.Refresh()
    _alive2 := ui.Step(0)
    println "after click", clicks, msg.Text(), "focused", ui.Dump().Includes("button#btn \"Hit\" focused")
    ui.Stop()
    p := ui.Measure(view(), 300, 200)
    println "measure", p.elements, p.parse_ms >= 0.0, p.style_ms >= 0.0, p.layout_ms >= 0.0, p.paint_ms >= 0.0
    path := filepath.Join(os.TempDir(), "gui_ui_api_test.png")
    println "png", ui.RenderPNG(view(), 120, 80, path), os.Exists(path)
    os.Remove(path)
    println "open empty url", ui.OpenUrl("")
end
