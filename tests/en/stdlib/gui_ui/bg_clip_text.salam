import gui.ui
import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println x, y, c.r, c.g, c.b
end

func main:
    _f := ui.AddFontFile("books/fonts/DejaVuSansMono.ttf")
    mut a := ui.Render(`<!doctype html><html><head><style>body{margin:0;background:#fff;font:40px/50px DejaVu Sans Mono}.t{background:linear-gradient(90deg,#f00,#00f);background-clip:text;color:transparent;width:200px;padding:5px}.v{background:linear-gradient(#ff0,#0ff) text,#333;color:rgba(0,0,0,0);width:200px}.w{background:#0a0;background-clip:text;color:transparent;width:200px}</style></head><body><div class="t">██ <span style="color:rgba(255,255,255,0.5)">█</span></div><div class="v">█ █</div><div class="w">█<b style="display:inline-block">█</b></div></body></html>`, 300, 200)
    println "clip text", a.Hash()
    probe(a, 10, 30)
    probe(a, 40, 30)
    probe(a, 70, 30)
    probe(a, 90, 30)
    probe(a, 10, 70)
    probe(a, 10, 100)
    probe(a, 30, 85)
    probe(a, 60, 85)
    probe(a, 10, 140)
    probe(a, 40, 140)
    probe(a, 150, 140)
    a.Free()
end
