import gui.ui
import gui.css
import str

const ROW := "display:flex;gap:12px;padding:16px;background:#f4f6fa"
const CARD := "padding:12px;border:2px solid #3366aa;border-radius:10px;box-shadow:0 4px 8px rgba(0,0,0,0.25);background:#ffffff"
const CARD_HOVER := "background:#ffeecc"
const BTN := "padding:8px 16px;border-radius:6px"
const BTN_HOVER := "background:#88aaff"

mut count := 0

func compile(p &: css.Program):
    _a := css.CompileDecls(p, ROW)
    _b := css.CompileDecls(p, CARD)
    _c := css.CompileDecls(p, CARD_HOVER)
    _d := css.CompileDecls(p, BTN)
    _e := css.CompileDecls(p, BTN_HOVER)
end

func styles(): css.Program:
    mut p := css.NewProgram()
    p.AddDecl("display", false, [css.Kw("flex")])
    p.AddDecl("row-gap", false, [css.Dim(12.0, "px")])
    p.AddDecl("column-gap", false, [css.Dim(12.0, "px")])
    p.AddDecl("padding-top", false, [css.Dim(16.0, "px")])
    p.AddDecl("padding-right", false, [css.Dim(16.0, "px")])
    p.AddDecl("padding-bottom", false, [css.Dim(16.0, "px")])
    p.AddDecl("padding-left", false, [css.Dim(16.0, "px")])
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("f4f6fa")])
    p.EndList(16)
    p.AddDecl("padding-top", false, [css.Dim(12.0, "px")])
    p.AddDecl("padding-right", false, [css.Dim(12.0, "px")])
    p.AddDecl("padding-bottom", false, [css.Dim(12.0, "px")])
    p.AddDecl("padding-left", false, [css.Dim(12.0, "px")])
    p.AddDecl("border-top-width", false, [css.Dim(2.0, "px")])
    p.AddDecl("border-right-width", false, [css.Dim(2.0, "px")])
    p.AddDecl("border-bottom-width", false, [css.Dim(2.0, "px")])
    p.AddDecl("border-left-width", false, [css.Dim(2.0, "px")])
    p.AddDecl("border-top-style", false, [css.Kw("solid")])
    p.AddDecl("border-right-style", false, [css.Kw("solid")])
    p.AddDecl("border-bottom-style", false, [css.Kw("solid")])
    p.AddDecl("border-left-style", false, [css.Kw("solid")])
    p.AddDecl("border-top-color", false, [css.Hash("3366aa")])
    p.AddDecl("border-right-color", false, [css.Hash("3366aa")])
    p.AddDecl("border-bottom-color", false, [css.Hash("3366aa")])
    p.AddDecl("border-left-color", false, [css.Hash("3366aa")])
    p.AddDecl("border-top-left-radius", false, [css.Dim(10.0, "px"), css.Dim(10.0, "px")])
    p.AddDecl("border-top-right-radius", false, [css.Dim(10.0, "px"), css.Dim(10.0, "px")])
    p.AddDecl("border-bottom-right-radius", false, [css.Dim(10.0, "px"), css.Dim(10.0, "px")])
    p.AddDecl("border-bottom-left-radius", false, [css.Dim(10.0, "px"), css.Dim(10.0, "px")])
    p.AddDecl("box-shadow", false, [css.Int(0.0), css.Dim(4.0, "px"), css.Dim(8.0, "px"), css.Fn("rgba"), css.Int(0.0), css.Comma(), css.Int(0.0), css.Comma(), css.Int(0.0), css.Comma(), css.Num(0.25), css.Close()])
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("ffffff")])
    p.EndList(30)
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("ffeecc")])
    p.EndList(9)
    p.AddDecl("padding-top", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-right", false, [css.Dim(16.0, "px")])
    p.AddDecl("padding-bottom", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-left", false, [css.Dim(16.0, "px")])
    p.AddDecl("border-top-left-radius", false, [css.Dim(6.0, "px"), css.Dim(6.0, "px")])
    p.AddDecl("border-top-right-radius", false, [css.Dim(6.0, "px"), css.Dim(6.0, "px")])
    p.AddDecl("border-bottom-right-radius", false, [css.Dim(6.0, "px"), css.Dim(6.0, "px")])
    p.AddDecl("border-bottom-left-radius", false, [css.Dim(6.0, "px"), css.Dim(6.0, "px")])
    p.EndList(8)
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("88aaff")])
    p.EndList(9)
    ret p
end

func html_view(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en" dir="ltr"><head><title>Cards</title><style>`)
    str.BufAppend(b, ".a{" + ROW + "}.card{" + CARD + "}.card:hover{" + CARD_HOVER + "}.b{" + BTN + "}.b:hover{" + BTN_HOVER + "}")
    str.BufAppend(b, `</style></head><body><div class="a" id="row">`)
    names := ["Tea", "Coffee", "Juice"]
    repeat 3 in i:
        str.BufAppend(b, `<div class="card" key="k` + i + `" id="c` + i + `"><h3>` + names[i] + `</h3><p>Fresh ` + names[i] + `</p></div>`)
    end
    str.BufAppend(b, `</div><button class="b" id="order" type="button" onclick="order()">Order ` + count + `</button>`)
    if count > 1:
        str.BufAppend(b, `<p id="many" style="width:` + (40 * count) + `px">Many</p>`)
    end
    str.BufAppend(b, `</body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func page(b: ui.Builder):
    b.Title("Cards")
    b.Lang("en")
    b.Dir("ltr")
    b.Open("div")
    b.Decls(0, -1, -1, -1)
    b.Id("row")
    names := ["Tea", "Coffee", "Juice"]
    repeat 3 in i:
        b.Open("div")
        b.Decls(1, 2, -1, -1)
        b.Class("card")
        b.Key("k" + i)
        b.Id("c" + i)
        b.Open("h3")
        b.Text(names[i])
        b.Close()
        b.Open("p")
        b.Text("Fresh " + names[i])
        b.Close()
        b.Close()
    end
    b.Close()
    b.Open("button")
    b.Decls(3, 4, -1, -1)
    b.Id("order")
    b.Attr("type", "button")
    b.BoolAttr("disabled", false)
    b.On("click", (): order() end)
    b.Text("Order " + count)
    b.Close()
    if count > 1:
        b.Open("p")
        b.Id("many")
        b.Dyn("width", (40 * count) + "px")
        b.Text("Many")
        b.Close()
    end
end

func order():
    count++
    ev := ui.CurrentEvent()
    println "order", count, ev.kind, ev.target
end

func main:
    mut p := css.NewProgram()
    compile(p)
    mut q := styles()
    println "source round trip", css.ProgramSource(p, "styles", "css") == css.ProgramSource(q, "styles", "css")
    p.Free()
    q.Free()
    steps := "dump\nhash\nhover #c1\nhash\nclick #order\nclick #order\ndump\nhash\nquit"
    println "html path"
    ui.Handle("order", (): order() end)
    ui.RunWith((): ret html_view() end, ui.Options { headless = true, width = 480.0, height = 320.0, script = steps })
    count = 0
    println "compiled path"
    ui.RunCompiledWith((): ret styles() end, (b: ui.Builder): page(b) end, ui.Options { headless = true, width = 480.0, height = 320.0, script = steps })
    count = 0
    if count > 99:
        ui.RunCompiled((): ret styles() end, (b: ui.Builder): page(b) end)
    end
    mut a := ui.Render(html_view(), 480, 320)
    mut c := ui.RenderCompiled((): ret styles() end, (b: ui.Builder): page(b) end, 480, 320)
    println "render same", a.Hash() == c.Hash(), a.width, c.height
    a.Free()
    c.Free()
end
