func html_view(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en" dir="ltr"><head><title>Cards</title><style>`)
    str.BufAppend(b, ".a{" + ROW + "}.card{" + CARD + "}.card:hover{" + CARD_HOVER + "}.b{" + BTN + "}.b:hover{" + BTN_HOVER + "}")
    str.BufAppend(b, `</style></head><body><div class="a" id="row">`)
    names := ["Tea", "Coffee", "Juice"]
    repeat 3 in i:
        str.BufAppend(b, `<div class="card" key="k` + i + `" id="c` + i + `"><h3>` + names[i] + `</h3><p>Fresh ` + names[i] + `</p></div>`)
    end
    str.BufAppend(b, `</div><button class="b" id="order" type="button" onclick="order()">Order ` + count + `</button>`)
    if count > 1:
        str.BufAppend(b, `<p id="many" style="width:` + (40 * count) + `px">Many</p>`)
    end
    str.BufAppend(b, `</body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func page(b: ui.Builder):
    b.Title("Cards")
    b.Lang("en")
    b.Dir("ltr")
    b.Open("div")
    b.Decls(0, -1, -1, -1)
    b.Id("row")
    names := ["Tea", "Coffee", "Juice"]
    repeat 3 in i:
        b.Open("div")
        b.Decls(1, 2, -1, -1)
        b.Class("card")
        b.Key("k" + i)
        b.Id("c" + i)
        b.Open("h3")
        b.Text(names[i])
        b.Close()
        b.Open("p")
        b.Text("Fresh " + names[i])
        b.Close()
        b.Close()
    end
    b.Close()
    b.Open("button")
    b.Decls(3, 4, -1, -1)
    b.Id("order")
    b.Attr("type", "button")
    b.BoolAttr("disabled", false)
    b.On("click", (): order() end)
    b.Text("Order " + count)
    b.Close()
    if count > 1:
        b.Open("p")
        b.Id("many")
        b.Dyn("width", (40 * count) + "px")
        b.Text("Many")
        b.Close()
    end
end

func order():
    count++
    ev := ui.CurrentEvent()
    println "order", count, ev.kind, ev.target
end

func main:
    mut p := css.NewProgram()
    compile(p)
    mut q := styles()
    println "source round trip", css.ProgramSource(p, "styles", "css") == css.ProgramSource(q, "styles", "css")
    p.Free()
    q.Free()
    steps := "dump\nhash\nhover #c1\nhash\nclick #order\nclick #order\ndump\nhash\nquit"
    println "html path"
    ui.Handle("order", (): order() end)
    ui.RunWith((): ret html_view() end, ui.Options { headless = true, width = 480.0, height = 320.0, script = steps })
    count = 0
    println "compiled path"
    ui.RunCompiledWith((): ret styles() end, (b: ui.Builder): page(b) end, ui.Options { headless = true, width = 480.0, height = 320.0, script = steps })
    count = 0
    if count > 99:
        ui.RunCompiled((): ret styles() end, (b: ui.Builder): page(b) end)
    end
    mut a := ui.Render(html_view(), 480, 320)
    mut c := ui.RenderCompiled((): ret styles() end, (b: ui.Builder): page(b) end, 480, 320)
    println "render same", a.Hash() == c.Hash(), a.width, c.height
    a.Free()
    c.Free()
end
