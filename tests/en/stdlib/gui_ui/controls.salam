import gui.ui

mut changes := ""
mut submitted := 0

func page(): str:
    ret `<!doctype html><html lang="en" dir="ltr"><head><title>Controls</title></head><body><form id="f" onsubmit="sent(event)"><label for="agree" id="agree-label">I agree</label><input id="agree" type="checkbox" onchange="changed(event)"><input id="r1" type="radio" name="size" value="s" checked><input id="r2" type="radio" name="size" value="m" onchange="changed(event)"><input id="q" type="text" placeholder="Search" value="start"><input id="pw" type="password"><input id="num" type="number"><select id="pick" onchange="changed(event)"><option value="a">Apple</option><option value="b">Banana</option><option value="c">Cherry</option></select><input id="vol" type="range" min="0" max="10" value="5"><textarea id="note" rows="3">line</textarea><button id="go">Send</button></form><details id="more"><summary id="sum">More</summary><p id="inside">Inside</p></details><progress value="7" max="10"></progress><meter value="0.25"></meter></body></html>`
end

func show(id: str):
    e := ui.ById(id)
    println id, "value", e.Value(), "checked", e.Checked()
end

func main:
    _f := ui.AddFontFile("books/fonts/XB Zar.ttf")
    ui.Handle("changed", ():
        ev := ui.CurrentEvent()
        changes += ev.target + "=" + ev.value + "/" + ev.checked + " "
    end)
    ui.Handle("sent", (): submitted++ end)
    _ok := ui.Start((): ret page() end, ui.Options { width = 700.0, height = 400.0, headless = true })
    ui.RunSteps(`click #agree-label
click #r2
click #q
key ctrl+a
type replaced
key shift+Left
key shift+Left
key Delete
click #pw
type secret
click #num
type 4x2
key Enter`)
    show("agree")
    show("r1")
    show("r2")
    show("q")
    show("pw")
    show("num")
    println "submitted", submitted
    ui.RunSteps(`click #pick
key Down
key Down
key Enter
click #vol
key Right
key Right
click #note
key End
key Enter
type more
click #sum
dump`)
    show("pick")
    show("vol")
    show("note")
    println "changes", changes
    ui.ById("q").SetValue("set from code")
    ui.ById("agree").SetChecked(false)
    ui.ById("more").SetAttr("title", "x")
    ui.ById("go").AddClass("primary")
    println "has class", ui.ById("go").HasClass("primary"), "attr", ui.ById("more").Attr("title")
    ui.RunSteps(`click #sum
click #go`)
    show("q")
    show("agree")
    println "submitted", submitted, "inside", ui.ById("inside").Rect().height
    ui.Stop()
end
