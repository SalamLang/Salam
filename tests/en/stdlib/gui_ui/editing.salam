import gui.ui

mut inputs := 0

func page(): str:
    ret `<!doctype html><html lang="en"><head><title>Editing</title><style>body{margin:0;font:16px sans-serif}textarea{width:120px;height:60px}input{width:100px}</style></head><body><input id="i" value="hello world wide web" oninput="changed()"><br><textarea id="t">one two three
four five six
seven eight nine
ten eleven twelve
thirteen</textarea><textarea id="w" wrap="off">a very long line that does not wrap at all</textarea><input id="p" value="سلام دنیا abc" dir="rtl"></body></html>`
end

func changed():
    inputs++
end

func check(label: str):
    partial := ui.Frame().Hash()
    ui.RepaintAll()
    full := ui.Frame().Hash()
    println label, "same", partial == full
end

func main:
    _f := ui.AddFontFile("books/fonts/XB Zar.ttf")
    ui.Handle("changed", (): changed() end)
    _ok := ui.Start((): ret page() end, ui.Options { width = 400.0, height = 240.0, headless = true })
    _alive := ui.Step(0)
    ui.RunSteps("click #i\nkey End\nsel\nkey shift+Left\nkey shift+Left\nsel\nwait 1000\ndblclick #i\nsel\nwait 1000\ntripleclick #i\nsel")
    check("input")
    ui.RunSteps("wait 1000\nclick #t\nkey ctrl+End\nsel\nkey Up\nkey Up\nsel\nkey Home\nsel\nkey shift+End\nsel\nwait 1000\ntripleclick #t\nsel")
    check("textarea")
    ui.RunSteps("wait 1000\nclick #t\nkey ctrl+Home\nsel\nscroll #t 40\nsel\nscroll #t 400\nsel")
    check("wheel")
    ui.RunSteps("wait 1000\nclick #w\nkey End\nsel\nkey Home\nsel")
    check("no wrap")
    ui.RunSteps("wait 1000\nclick #i\nkey End\nime سل\nsel\nime سلا\nsel")
    check("preedit")
    ui.RunSteps("commit سلام\nsel")
    println ui.ById("i").Value(), "inputs", inputs
    ui.RunSteps("wait 1000\nclick #p\nkey Home\nsel\nkey Left\nkey Left\nsel\nkey Right\nsel\nkey shift+Left\nsel\ntype ب\nsel")
    check("rtl")
    println ui.ById("p").Value()
    ui.RunSteps("wait 1000\ndrag 10 10 60 10\nsel")
    check("drag select")
    ui.Stop()
end
