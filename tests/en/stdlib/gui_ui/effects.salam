import gui.ui

mut n := 0

func page(): str:
    ret `<!doctype html><html lang="en"><head><title>Effects</title><style>body{margin:0;font:18px sans-serif}.bar{position:absolute;top:0;width:10px;height:300px;background:#000}.f{position:absolute;left:20px;top:20px;width:60px;height:40px;background:rgb(200,60,20)}.f:hover{filter:grayscale(1) blur(2px)}.d{position:absolute;left:120px;top:20px;width:60px;height:40px;background:#36c;filter:drop-shadow(4px 4px 3px rgba(0,0,0,.6))}.g{position:absolute;left:30px;top:100px;width:120px;height:60px;backdrop-filter:blur(3px);border-radius:8px}.t{position:absolute;left:200px;top:110px;text-shadow:2px 2px 2px #0a0,-1px 0 0 #f00}.o{position:absolute;left:220px;top:200px;width:60px;height:40px;outline:3px dotted #00f;outline-offset:5px;border:3px dashed #c00;border-radius:14px}</style></head><body><div class="bar" style="left:40px"></div><div class="bar" style="left:100px"></div><div class="f" id="f"></div><div class="d"></div><div class="g" id="g" onclick="hit()"></div><div class="t">Shadow ` + n + `</div><div class="o"></div></body></html>`
end

func hit():
    n++
end

func probe(x: int, y: int):
    c := ui.Frame().Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b
end

func check(label: str):
    partial := ui.Frame().Hash()
    ui.RepaintAll()
    full := ui.Frame().Hash()
    println label, "same", partial == full
end

func main:
    ui.Handle("hit", (): hit() end)
    _ok := ui.Start((): ret page() end, ui.Options { width = 360.0, height = 300.0, headless = true })
    _alive := ui.Step(0)
    probe(50, 40)
    probe(186, 64)
    probe(46, 130)
    probe(70, 130)
    probe(10, 200)
    ui.RunSteps("hover #f")
    check("hover filter")
    probe(50, 40)
    probe(22, 22)
    ui.RunSteps("click #g")
    check("click under backdrop")
    ui.RunSteps("move 350 290")
    check("leave")
    println "n", n
    ui.Stop()
end
