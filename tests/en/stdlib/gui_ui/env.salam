import gui.ui

mut seen_w := 0
mut seen_h := 0
mut seen_rtl := false

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func view(b: ui.Builder):
    b.Env((w: int, h: int, _dark: bool, _touch: bool, _reduced: bool, _contrast: bool, rtl: bool):
        seen_w = w
        seen_h = h
        seen_rtl = rtl
    end)
    b.Dir("rtl")
    b.Open("box")
    b.Id("a")
    b.Close()
end

func main:
    _d := ui.DumpPage((): ret none() end, (b: ui.Builder): view(b) end, 320, 200)
    println seen_w, seen_h, seen_rtl
    _e := ui.DumpPage((): ret none() end, (b: ui.Builder): view(b) end, 800, 600)
    println seen_w, seen_h, seen_rtl
end
