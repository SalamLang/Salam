import gui.ui

mut count := 0
mut typed := ""
mut keys := ""
mut log := ""
mut page := 1

func home(): str:
    ret `<!doctype html><html lang="en" dir="ltr"><head><title>Events</title><style>button{padding:4px 8px}button:hover{background:rgb(200, 220, 255)}button:focus{outline:2px solid blue}.big{font-size:20px}</style></head><body><h1 class="big" id="title">Count ` + count + `</h1><button id="inc" onclick="__sl_ev_1()">Add</button><button id="dec" onclick="window['dec one'](event)" ondblclick="dbl()">Less</button><input id="name" type="text" oninput="typed(event)" onkeydown="key(event)"><p id="echo">` + typed + `</p><div id="outer" onclick="outer()"><span id="inner">inner text</span></div><a id="ext" href="https://example.com/x">site</a> <a id="next" href="/second">next page</a><button id="last" tabindex="1">first in tab order</button></body></html>`
end

func second(): str:
    ret `<!doctype html><html><head><title>Second</title></head><body><p id="msg">second page</p><a id="back" href="/">back</a></body></html>`
end

func main:
    _f := ui.AddFontFile("books/fonts/XB Zar.ttf")
    ui.Handle("__sl_ev_1", (): count++ end)
    ui.Handle("dec one", ():
        count--
        log += "dec(" + ui.CurrentEvent().kind + "," + ui.CurrentEvent().target + ") "
    end)
    ui.Handle("dbl", (): log += "dbl " end)
    ui.Handle("typed", ():
        typed = ui.CurrentEvent().value
    end)
    ui.Handle("key", ():
        keys += ui.CurrentEvent().key + " "
    end)
    ui.Handle("outer", ():
        log += "outer(" + ui.CurrentEvent().target + ") "
    end)
    ui.SetUrlOpener((url: str): ret url.len() > 0 end)
    ui.Page("/second", (): ret second() end)
    ui.Page("/", (): ret home() end)
    ok := ui.Start((): ret home() end, ui.Options { width = 480.0, height = 320.0, headless = true })
    println "started", ok, ui.CurrentWindow().Title()
    ui.RunSteps(`click #inc
click #inc
click #inc
dump`)
    println "count", count
    ui.RunSteps(`hover #dec`)
    s := ui.ById("dec").Style()
    println "hover background", s.background_color.r, s.background_color.g, s.background_color.b
    ui.RunSteps(`click #dec
dblclick #dec
click #name
type salam
key Backspace
key Left
type X
focus`)
    println "count", count, "typed", typed, "keys", keys
    println "value", ui.ById("name").Value(), "echo", ui.ById("echo").Text()
    ui.RunSteps(`click #inner
key Tab
focus
key Tab
focus
key shift+Tab
focus
click #ext`)
    println "log", log
    urls := ui.OpenedUrls()
    println "opened", urls.len(), urls[0]
    ui.RunSteps(`click #next
dump
click #back`)
    println "title back", ui.ById("title").Text(), "frames", ui.FrameCount() > 0
    ui.Stop()
end
