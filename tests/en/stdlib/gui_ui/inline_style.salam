import gui.ui
import gui.css

mut wide := false

func styles(): css.Program:
    mut p := css.NewProgram()
    _a := css.CompileDecls(p, "width:50px;height:10px;background:#00f")
    _b := css.CompileDecls(p, "width:90px;height:12px")
    _c := css.CompileCss(p, "body{margin:0;font-size:0;line-height:0}#d{width:70px!important}div#x.k{width:80px;height:6px}#t{height:5px}")
    ret p
end

func page(b: ui.Builder):
    b.Open("div")
    b.Decls(0, 1, -1, -1)
    b.Id("a")
    b.Dyn("width", wide ? "30px" : "20px")
    b.Close()
    b.Open("div")
    b.Id("x")
    b.Class("k")
    b.Attr("style", "width:25px")
    b.Close()
    b.Open("div")
    b.Decls(0, -1, -1, -1)
    b.Id("d")
    b.Dyn("width", "15px")
    b.Close()
    b.Open("div")
    b.Id("t")
    b.On("click", (): wide = not wide end)
    b.Close()
end

func main:
    print ui.DumpHtml(`<!doctype html><html><head><style>body{margin:0;font-size:0;line-height:0}#a{width:50px;height:10px}div.box#b.x{width:60px!important;height:10px}.c{height:30px}div div#d.c{width:70px}.e{width:40px!important}</style></head><body><div id="a" style="width:20px;height:5px"></div><div id="b" class="box x" style="width:25px"></div><div class="c" style="height:8px;width:33px"></div><div><div id="d" class="c" style="width:12px;height:4px"></div></div><div class="e" style="width:15px!important;height:3px"></div><img width="44" height="6" style="width:22px"></body></html>`, 640, 480)
    steps := "dump\nhover #a\ndump\nclick #t\ndump\nquit"
    ui.RunCompiledWith((): ret styles() end, (b: ui.Builder): page(b) end, ui.Options { headless = true, width = 320.0, height = 200.0, script = steps })
end
