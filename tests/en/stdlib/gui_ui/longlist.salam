import gui.ui
import str

mut picked := -1

func page(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en"><head><title>List</title><style>body{margin:0}#list{height:200px;overflow:auto;border:1px solid #ccc}.it{height:20px;border-bottom:1px solid #eee}.it:hover{background:#eef}.sel{background:#fd8}</style></head><body><div id="list">`)
    repeat 2000 in i:
        str.BufAppend(b, `<div class="it` + (i == picked ? " sel" : "") + `" id="i` + i + `" onclick="pick()"></div>`)
    end
    str.BufAppend(b, `</div></body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func pick():
    t := ui.CurrentEvent().target
    picked = t.substr(1, t.len() - 1).to_int()
end

func check(label: str):
    partial := ui.Frame().Hash()
    ui.RepaintAll()
    full := ui.Frame().Hash()
    println label, "same", partial == full, "picked", picked
end

func main:
    ui.Handle("pick", (): pick() end)
    _ok := ui.Start((): ret page() end, ui.Options { width = 300.0, height = 240.0, headless = true })
    _alive := ui.Step(0)
    ui.RunSteps("move 100 50")
    check("hover")
    ui.RunSteps("scroll #list 400")
    check("scroll")
    ui.RunSteps("drag 100 15 100 15")
    check("click after scroll")
    ui.RunSteps("scroll #list 4000")
    check("scroll further")
    ui.RunSteps("drag 100 190 100 190")
    check("click last rows")
    ui.RunSteps("click #i5")
    check("script click")
    ui.Stop()
end
