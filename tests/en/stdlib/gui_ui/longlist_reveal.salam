import gui.ui
import str

mut picked := -1

func page(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en"><head><title>Rows</title><style>body{margin:0}#list{height:200px;overflow:auto;border:1px solid #ccc}.it{height:20px;border-bottom:1px solid #eee;font-size:12px}</style></head><body><div id="list">`)
    repeat 1000 in i:
        str.BufAppend(b, `<div class="it" tabindex="0" id="i` + i + `" onclick="pick()"><span id="s` + i + `">Row ` + i + `</span></div>`)
    end
    str.BufAppend(b, `</div></body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func pick():
    t := ui.CurrentEvent().target
    picked = t.substr(1, t.len() - 1).to_int()
    println "picked", picked
end

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func scroll():
    println "scrollTop", 1 - ui.ById("i0").Rect().y
end

func main:
    _f := ui.AddFontFile("books/fonts/DejaVuSansMono.ttf")
    ui.Handle("pick", (): pick() end)
    _ok := ui.Start((): ret page() end, ui.Options { width = 300.0, height = 240.0, headless = true })
    _s := ui.Step(0)
    show("i0")
    show("i500")
    show("s500")
    ui.ById("i500").Focus()
    _s2 := ui.Step(0)
    show("i500")
    scroll()
    ui.ById("i505").Focus()
    _s3 := ui.Step(0)
    scroll()
    ui.ById("i400").Focus()
    _s4 := ui.Step(0)
    scroll()
    ui.ById("i700").ScrollIntoView()
    _s5 := ui.Step(0)
    scroll()
    show("i700")
    ui.RunSteps("click #i900")
    scroll()
    ui.RunSteps("reveal #i20")
    scroll()
    ui.Stop()
end
