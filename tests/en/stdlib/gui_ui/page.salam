import gui.ui

func probe(label: str, x: int, y: int):
    c := ui.Frame().Pixel(x, y)
    println label, c.r, c.g, c.b
end

func main:
    _f := ui.AddFontFile("books/fonts/XB Zar.ttf")
    doc := `<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cards</title>
  <style>
.a { display: flex; gap: 12px; padding: 16px; background: #f4f6fa;  }
.card { padding: 12px; border: 2px solid #3366aa; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25); background: #ffffff;  }
.card:hover { background: #ffeecc;  }
.b { padding: 8px 16px; border-radius: 6px;  }
.b:hover { background: #88aaff;  }
  </style>
</head>
<body>
<div class="a" id="row">
  <div class="card">
    <h3>Tea</h3>
    <p>Fresh Tea</p>
  </div>
  <div class="card">
    <h3>Coffee</h3>
    <p>Fresh Coffee</p>
  </div>
  <div class="card">
    <h3>Juice</h3>
    <p>Fresh Juice</p>
  </div>
</div>
<button class="b" id="order">Order</button>
</body>
</html>`
    _ok := ui.StartHtml(doc, ui.Options { width = 420.0, height = 260.0, headless = true })
    _alive := ui.Step(0)
    print ui.Dump()
    first := ui.Frame().Hash()
    probe("card", 40, 40)
    probe("card border", 25, 60)
    probe("row background", 12, 12)
    probe("shadow below card", 60, 162)
    ui.RunSteps(`hover .card`)
    probe("hovered card", 40, 40)
    println "damage rects", ui.LastDamageCount()
    partial := ui.Frame().Hash()
    ui.RepaintAll()
    println "partial equals full", partial == ui.Frame().Hash()
    ui.RunSteps(`hover #order`)
    probe("card after leave", 40, 40)
    b := ui.ById("order").Rect()
    probe("hovered button", (b.x + 4.0) as int, (b.y + 4.0) as int)
    mut cv := ui.Render(doc, 420, 260)
    println "render equals first frame", cv.Hash() == first
    cv.Free()
    ui.Stop()
end
