import gui.ui
import gui.style

mut which := 0
mut step := 0

func sty(b: ui.Builder, key: str, value: str):
    b.SetText(ui.STATE_BASE, style.PropByName(key), value)
end

func pick(index: int, before: str, after: str): str:
    if step == 1 and which == index:
        ret after
    end
    ret before
end

func cell(b: ui.Builder, left: int, top: int, bg: str):
    b.Open("box")
    sty(b, "position", "absolute")
    sty(b, "left", "" + left)
    sty(b, "top", "" + top)
    sty(b, "width", "50")
    sty(b, "height", "40")
    sty(b, "background", bg)
end

func view(b: ui.Builder):
    b.Open("box")
    sty(b, "background", "#eeeeee")
    cell(b, 10, 10, pick(0, "#ff0000", "#0000ff"))
    b.Close()
    cell(b, 80, 10, "#ffffff")
    sty(b, "shadow", pick(1, "[4, 4, 6, 0, #00000080]", "[12, 10, 10, 2, #ff000080]"))
    b.Close()
    cell(b, 150, 10, "#ffffff")
    sty(b, "outline", pick(2, "2, solid, #ff0000", "6, dashed, #0000ff"))
    sty(b, "outline offset", "3")
    b.Close()
    cell(b, 220, 10, "#ffffff")
    sty(b, "blur", pick(3, "1", "6"))
    b.Open("box")
    sty(b, "width", "20")
    sty(b, "height", "20")
    sty(b, "background", "#00aa00")
    b.Close()
    b.Close()
    cell(b, 10, 80, "#008800")
    sty(b, "rotate", pick(4, "10", "40"))
    b.Close()
    cell(b, 80, 80, "#cc6600")
    sty(b, "opacity", pick(5, "1", "0.4"))
    b.Open("box")
    sty(b, "width", "20")
    sty(b, "height", "20")
    sty(b, "background", "#000000")
    b.Close()
    b.Close()
    cell(b, 150, 80, "linear(90, #ff0000, #0000ff)")
    b.Close()
    cell(b, 165, 90, "#ffffff40")
    sty(b, "backdrop blur", "4")
    sty(b, "radius", pick(6, "4", "16"))
    b.Close()
    cell(b, 220, 80, "#336699")
    sty(b, "scale", pick(7, "1", "1.5"))
    sty(b, "skew", pick(7, "0", "15"))
    b.Close()
    b.Open("paragraph")
    sty(b, "position", "absolute")
    sty(b, "left", "10")
    sty(b, "top", "140")
    sty(b, "text shadow", "[1, 1, 2, #00000080]")
    sty(b, "decoration", pick(8, "none", "underline"))
    b.Text(pick(8, "partial", "partial paint"))
    b.Close()
    b.Close()
end

func run(name: str, case: int, scale: f64):
    which = case
    step = 0
    np := (): ret ui.NoPatches() end
    vw := (b: ui.Builder): view(b) end
    opened := ui.OffscreenOpen(np, vw, 300, 180, scale)
    if opened == false:
        println "open failed"
    end
    step = 1
    area := ui.OffscreenUpdate(true)
    part := ui.OffscreenCanvas().Hash()
    ui.OffscreenRepaintAll()
    again := ui.OffscreenCanvas().Hash()
    ui.OffscreenClose()
    full := ui.RenderPageScaled(np, vw, 300, 180, scale)
    fh := full.Hash()
    full.Free()
    println name, scale, "damaged", area > 0, "same", part == fh, "repaint all", again == fh
end

func main:
    added := ui.AddFontFile("books/fonts/DejaVuSansMono.ttf")
    if added == 0:
        println "font missing"
    end
    println "missing dir", ui.AddFontDir("books/fonts/none")
    names := [
        "fill", "shadow", "outline", "blur child", "rotate", "opacity group", "backdrop",
        "scale skew", "text"
    ]
    repeat names.Len() in i:
        run(names[i], i, 1.0)
        run(names[i], i, 2.0)
    end
end
