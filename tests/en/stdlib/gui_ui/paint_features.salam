import gui.ui
import gui.style
import gui.paint

func sty(b: ui.Builder, key: str, value: str):
    b.SetText(ui.STATE_BASE, style.PropByName(key), value)
end

func cell(b: ui.Builder, left: int, top: int, bg: str):
    b.Open("box")
    sty(b, "position", "absolute")
    sty(b, "left", "" + left)
    sty(b, "top", "" + top)
    sty(b, "width", "40")
    sty(b, "height", "40")
    sty(b, "background", bg)
end

func view(b: ui.Builder):
    b.Open("box")
    sty(b, "background", "white")
    cell(b, 10, 10, "#ff0000")
    b.Close()
    cell(b, 60, 10, "linear(90, #000000, #ffffff)")
    b.Close()
    cell(b, 110, 10, "#00ff00")
    sty(b, "border", "5, solid, #0000ff")
    sty(b, "radius", "20")
    b.Close()
    cell(b, 160, 10, "#ffffff")
    sty(b, "shadow", "[10, 10, 0, 0, #000000]")
    b.Close()
    cell(b, 210, 10, "#ff0000")
    sty(b, "opacity", "0.5")
    b.Close()
    cell(b, 260, 10, "#ff0000")
    sty(b, "grayscale", "1")
    b.Close()
    cell(b, 10, 60, "#808080")
    sty(b, "blend", "multiply")
    b.Close()
    cell(b, 60, 60, "#00ff00")
    sty(b, "overflow", "hidden")
    b.Open("box")
    sty(b, "position", "absolute")
    sty(b, "left", "20")
    sty(b, "top", "20")
    sty(b, "width", "40")
    sty(b, "height", "40")
    sty(b, "background", "#ff0000")
    b.Close()
    b.Close()
    cell(b, 110, 60, "#ffffff")
    sty(b, "outline", "4, solid, #ff0000")
    sty(b, "outline offset", "2")
    b.Close()
    cell(b, 160, 60, "#0000ff")
    sty(b, "scale", "2")
    b.Close()
    cell(b, 230, 60, "#0000ff")
    sty(b, "translate", "20, 0")
    sty(b, "scale", "0.5")
    b.Close()
    cell(b, 290, 60, "#ffffff")
    sty(b, "border", "4, double, #000000")
    b.Close()
    cell(b, 10, 110, "#ffffff")
    sty(b, "shadow", "[0, 0, 0, 10, #ff0000, inset]")
    b.Close()
    b.Open("checkbox")
    sty(b, "position", "absolute")
    sty(b, "left", "60")
    sty(b, "top", "110")
    b.BoolAttr("checked", true)
    b.Close()
    b.Open("progress")
    sty(b, "position", "absolute")
    sty(b, "left", "90")
    sty(b, "top", "110")
    sty(b, "width", "100")
    sty(b, "height", "16")
    b.Attr("value", "0.5")
    b.Close()
    b.Close()
end

func probe(name: str, canvas: paint.Canvas, px: int, py: int):
    color := canvas.Pixel(px, py)
    println name, color.r, color.g, color.b, color.a
end

func main:
    np := (): ret ui.NoPatches() end
    vw := (b: ui.Builder): view(b) end
    canvas := ui.RenderPage(np, vw, 360, 160)
    probe("solid", canvas, 30, 30)
    probe("gradient left", canvas, 61, 30)
    probe("gradient right", canvas, 99, 30)
    probe("border", canvas, 112, 30)
    probe("radius corner", canvas, 111, 11)
    probe("shadow", canvas, 205, 25)
    probe("opacity", canvas, 230, 30)
    probe("grayscale", canvas, 280, 30)
    probe("multiply", canvas, 30, 80)
    probe("clip inside", canvas, 90, 90)
    probe("clip outside", canvas, 90, 105)
    probe("outline", canvas, 130, 57)
    probe("scale", canvas, 160, 100)
    probe("translate", canvas, 270, 80)
    probe("double outer", canvas, 290, 80)
    probe("double gap", canvas, 291, 80)
    probe("double inner", canvas, 293, 80)
    probe("inset shadow", canvas, 12, 130)
    probe("checkbox", canvas, 62, 112)
    probe("progress fill", canvas, 100, 118)
    probe("progress rest", canvas, 180, 118)
    canvas.Free()
end
