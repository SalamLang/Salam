import gui.ui

func main:
    _a := ui.AddFontFile("books/fonts/XB Zar.ttf")
    _b := ui.AddFontFile("books/fonts/DejaVuSansMono.ttf")
    doc := `<!DOCTYPE html>
<!-- a comment <p>not parsed</p> -->
<HTML lang='en' dir=ltr><head><meta charset="utf-8"><title>Parse &amp; test</title>
<style>p.x { color: red } td { padding: 2px }</style><script>if (a < b && c > d) {}</script></head>
<BODY>
<p class=x id="ents">a &amp; b &lt;c&gt; &quot;q&quot; &#1587;&#x644;&#x627;&#x645; x&nbsp;y &unknown; done</p>
<div id="ws">   many     spaces
  and lines   </div>
<pre id="pre">
  kept   spaces
second line</pre>
<p id="br">one<br>two<br/>three</p>
<img id="pic" alt="no file" width="40" height="20"><hr id="rule">
<input id="field" value="it's" disabled><input type="hidden" id="gone" value="x">
<table id="t"><tr><td>a</td><td>b</td></tr></table>
<section hidden id="h">hidden</section>
<p id="none" style="display:none">none</p>
<textarea id="ta">
first &amp; line</textarea>
</BODY></HTML>`
    print ui.DumpHtml(doc, 400, 600)
    println "fragment"
    print ui.DumpHtml(`<p id="a">no html or body</p><span>tail</span>`, 300, 100)
end
