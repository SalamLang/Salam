واردسازی رابط گرافیکی.رابط کاربری
واردسازی رشته

ناپایا n := 0

تابع page(): رشته:
    ناپایا b := رشته.سازنده()
    رشته.افزودن به بافر(b، `<!doctype html><html lang="en"><head><title>Partial</title><style>.card{border:1px solid #888;border-radius:6px;padding:6px;margin:4px;box-shadow:0 2px 3px rgba(0,0,0,.3)}.card:hover{background:#ffe;border-color:#c60}button{border-radius:4px}button:hover{background:rgb(180, 200, 255)}.list{display:flex;flex-wrap:wrap;gap:6px}.box{overflow:auto;height:60px;border:1px solid #ccc}</style></head><body><div class="list">`)
    تکرار 12 در i:
        رشته.افزودن به بافر(b، `<div class="card" id="c` + i + `">Card ` + i + `</div>`)
    پایان
    رشته.افزودن به بافر(b، `</div><p id="count">Clicked ` + n + ` times</p><button id="b" onclick="hit()">Hit</button><input id="t" value="abc"><div class="box" id="sc"><p>one</p><p>two</p><p>three</p><p>four</p></div></body></html>`)
    r := رشته.رشته بافر(b)
    رشته.آزادسازی بافر(b)
    برگشت r
پایان

تابع check(label: رشته):
    partial := رابط کاربری.قاب().Hash()
    count := رابط کاربری.شمار آسیب آخر()
    area := رابط کاربری.مساحت آسیب آخر()
    رابط کاربری.بازنگاری کامل()
    full := رابط کاربری.قاب().Hash()
    سرچاپ label، "rects"، count، "partial"، area کوچکتر 400 * 300، "same"، partial برابر full
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/XB Zar.ttf")
    رابط کاربری.ثبت رسیدگی("hit"، (): n++ پایان)
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { width = 400.0، height = 300.0، headless = درست })
    _alive := رابط کاربری.گام(0)
    رابط کاربری.اجرای گام ها(`hover #c3`)
    check("hover card")
    رابط کاربری.اجرای گام ها(`hover #c7`)
    check("hover other card")
    رابط کاربری.اجرای گام ها(`click #b`)
    check("click reruns view")
    رابط کاربری.اجرای گام ها(`click #t`)
    check("focus input")
    رابط کاربری.اجرای گام ها(`type xyz`)
    check("typing")
    رابط کاربری.اجرای گام ها(`scroll #sc 30`)
    check("scroll box")
    رابط کاربری.اجرای گام ها(`move 395 295`)
    check("leave")
    سرچاپ "count text"، رابط کاربری.با شناسه("count").متن عنصر()
    رابط کاربری.توقف()
پایان
