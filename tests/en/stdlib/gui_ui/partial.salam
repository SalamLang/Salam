import gui.ui
import str

mut n := 0

func page(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en"><head><title>Partial</title><style>.card{border:1px solid #888;border-radius:6px;padding:6px;margin:4px;box-shadow:0 2px 3px rgba(0,0,0,.3)}.card:hover{background:#ffe;border-color:#c60}button{border-radius:4px}button:hover{background:rgb(180, 200, 255)}.list{display:flex;flex-wrap:wrap;gap:6px}.box{overflow:auto;height:60px;border:1px solid #ccc}</style></head><body><div class="list">`)
    repeat 12 in i:
        str.BufAppend(b, `<div class="card" id="c` + i + `">Card ` + i + `</div>`)
    end
    str.BufAppend(b, `</div><p id="count">Clicked ` + n + ` times</p><button id="b" onclick="hit()">Hit</button><input id="t" value="abc"><div class="box" id="sc"><p>one</p><p>two</p><p>three</p><p>four</p></div></body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func check(label: str):
    partial := ui.Frame().Hash()
    count := ui.LastDamageCount()
    area := ui.LastDamageArea()
    ui.RepaintAll()
    full := ui.Frame().Hash()
    println label, "rects", count, "partial", area < 400 * 300, "same", partial == full
end

func main:
    _f := ui.AddFontFile("books/fonts/XB Zar.ttf")
    ui.Handle("hit", (): n++ end)
    _ok := ui.Start((): ret page() end, ui.Options { width = 400.0, height = 300.0, headless = true })
    _alive := ui.Step(0)
    ui.RunSteps(`hover #c3`)
    check("hover card")
    ui.RunSteps(`hover #c7`)
    check("hover other card")
    ui.RunSteps(`click #b`)
    check("click reruns view")
    ui.RunSteps(`click #t`)
    check("focus input")
    ui.RunSteps(`type xyz`)
    check("typing")
    ui.RunSteps(`scroll #sc 30`)
    check("scroll box")
    ui.RunSteps(`move 395 295`)
    check("leave")
    println "count text", ui.ById("count").Text()
    ui.Stop()
end
