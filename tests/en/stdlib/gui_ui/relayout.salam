import gui.ui
import str

mut count := 0

func page(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en"><head><title>Relayout</title><style>body{margin:8px}.grid{display:grid;grid-template-columns:repeat(4, 1fr);gap:6px}.c{padding:6px;border:1px solid #888}h3{margin:0;font-size:14px}p{margin:0}</style></head><body><p id="count">Count ` + count + `</p><div class="grid">`)
    repeat 40 in i:
        str.BufAppend(b, `<div class="c"><h3>Item ` + i + `</h3><p>Text for item ` + i + `</p></div>`)
    end
    str.BufAppend(b, `</div><table><tr><td>a</td><td>b</td></tr></table></body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func main:
    _f := ui.AddFontFile("books/fonts/DejaVuSansMono.ttf")
    _ok := ui.Start((): ret page() end, ui.Options { width = 640.0, height = 480.0, headless = true })
    _s := ui.Step(0)
    first := ui.LastLayoutCalls()
    println "first layout", first
    ui.Refresh()
    _s2 := ui.Step(0)
    println "same view again", ui.LastLayoutCalls()
    count = 7
    ui.Refresh()
    _s3 := ui.Step(0)
    println "one text changed", ui.LastLayoutCalls()
    count = 123456
    ui.Refresh()
    _s4 := ui.Step(0)
    println "text grew", ui.LastLayoutCalls()
    h := ui.Frame().Hash()
    mut full := ui.Render(page(), 640, 480)
    println "pixels equal a full layout", h == full.Hash()
    full.Free()
    ui.Stop()
end
