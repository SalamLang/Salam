import gui.ui
import gui.style
import gui.paint

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func setv(b: ui.Builder, prop: int, text: str):
    b.SetText(ui.STATE_BASE, prop, text)
end

func view(b: ui.Builder):
    b.Title("Cards")
    b.Open("box")
    b.Id("row")
    setv(b, style.P_LAYOUT, "row")
    setv(b, style.P_GAP, "10")
    setv(b, style.P_PADDING, "16")
    setv(b, style.P_BACKGROUND, "#f4f6fa")
    b.Open("box")
    b.Id("tea")
    setv(b, style.P_WIDTH, "100")
    setv(b, style.P_HEIGHT, "60")
    setv(b, style.P_BACKGROUND, "#ff0000")
    b.Close()
    b.Open("box")
    b.Id("coffee")
    setv(b, style.P_WIDTH, "100")
    setv(b, style.P_HEIGHT, "60")
    setv(b, style.P_BACKGROUND, "#0000ff")
    b.Close()
    b.Close()
end

func probe(c: paint.Canvas, label: str, x: int, y: int):
    p := c.Pixel(x, y)
    println label, p.r, p.g, p.b
end

func main:
    d := ui.DumpPage((): ret none() end, (b: ui.Builder): view(b) end, 400, 200)
    println d
    mut c := ui.RenderPage((): ret none() end, (b: ui.Builder): view(b) end, 400, 200)
    println "size", c.width, c.height
    probe(c, "padding", 4, 4)
    probe(c, "tea", 60, 40)
    probe(c, "gap", 121, 40)
    probe(c, "coffee", 180, 40)
    probe(c, "below", 60, 150)
    c.Free()
end
