import gui.ui

mut hits := 0
mut misses := 0

func page(): str:
    ret `<!doctype html><html lang="en"><head><title>Transforms</title><style>body{margin:0}#bg{position:absolute;left:0;top:0;width:400px;height:300px}#r{position:absolute;left:100px;top:50px;width:100px;height:20px;background:#36c;transform:rotate(90deg)}#s{position:absolute;left:220px;top:40px;width:60px;height:40px;background:#c63;border:4px dashed #222;border-radius:10px;transform:translate(10px,5px) scale(1.5) skewX(10deg);transform-origin:0 0;transition:transform 100ms linear}#s:hover{transform:rotate(45deg)}#m{position:absolute;left:40px;top:180px;width:80px;height:50px;background:#9c6;transform:matrix(1,0.2,-0.2,1,0,0);overflow:hidden}#m p{margin:0;width:200px;height:20px;background:#333}</style></head><body><div id="bg" onclick="miss()"></div><div id="r" onclick="hit()"></div><div id="s"></div><div id="m"><p></p></div></body></html>`
end

func hit():
    hits++
end

func miss():
    misses++
end

func check(label: str):
    partial := ui.Frame().Hash()
    ui.RepaintAll()
    full := ui.Frame().Hash()
    println label, "same", partial == full, "hits", hits, "misses", misses
end

func main:
    ui.Handle("hit", (): hit() end)
    ui.Handle("miss", (): miss() end)
    _ok := ui.Start((): ret page() end, ui.Options { width = 400.0, height = 300.0, headless = true })
    _alive := ui.Step(0)
    ui.RunSteps("drag 150 100 150 100")
    check("inside rotated")
    ui.RunSteps("drag 110 60 110 60")
    check("outside rotated")
    ui.RunSteps("click #r")
    check("script click")
    r := ui.ById("r").Rect()
    println "layout box", r.x, r.y, r.width, r.height
    ui.RunSteps("hover #s\nwait 50")
    check("half way")
    ui.RunSteps("wait 100")
    check("done")
    ui.RunSteps("move 5 5")
    check("back")
    ui.RunSteps("wait 200")
    check("rest")
    ui.Stop()
end
