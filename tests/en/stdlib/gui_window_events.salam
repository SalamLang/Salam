import gui.window

func show(e: window.Event):
    println e.kind as int, e.window, e.x, e.y, e.button as int, e.clicks, e.modifiers, e.delta_y, e.delta_mode as int, e.key as int, e.code, e.repeated, e.text, e.cursor
end

func drain():
    mut e := window.Poll()
    until e.kind != window.EventKind.None:
        show(e)
        e = window.Poll()
    end
end

func main:
    window.SetManualClock(true)
    w := window.Open(window.Options { title = "events", width = 200.0, height = 100.0, headless = true, scale = 1.5 })
    println "open", w.IsOpen(), w.IsHeadless(), w.Title(), w.ScaleFactor()
    println "size", w.Size()
    drain()
    println "focused", w.IsFocused()
    w.RequestRedraw()
    w.RequestRedraw()
    drain()
    window.Inject(window.Event { kind = window.EventKind.PointerEnter, window = w.id, x = 5.0, y = 6.0 })
    window.Inject(window.Event { kind = window.EventKind.PointerDown, window = w.id, x = 10.0, y = 12.0, button = window.MouseButton.Left })
    window.Inject(window.Event { kind = window.EventKind.PointerUp, window = w.id, x = 10.0, y = 12.0, button = window.MouseButton.Left })
    window.Advance(100)
    window.Inject(window.Event { kind = window.EventKind.PointerDown, window = w.id, x = 11.0, y = 12.0, button = window.MouseButton.Left })
    window.Advance(900)
    window.Inject(window.Event { kind = window.EventKind.PointerDown, window = w.id, x = 11.0, y = 12.0, button = window.MouseButton.Left })
    window.Inject(window.Event { kind = window.EventKind.PointerDown, window = w.id, x = 11.0, y = 12.0, button = window.MouseButton.Right })
    window.Inject(window.Event { kind = window.EventKind.Wheel, window = w.id, delta_y = 3.0, delta_mode = window.WheelMode.Line })
    drain()
    window.Inject(window.Event { kind = window.EventKind.KeyDown, window = w.id, key = window.Key.A, code = 38, modifiers = window.ModShift })
    window.Inject(window.Event { kind = window.EventKind.TextInput, window = w.id, text = "A", modifiers = window.ModShift })
    window.Inject(window.Event { kind = window.EventKind.KeyDown, window = w.id, key = window.Key.A, code = 38, modifiers = window.ModShift, repeated = true })
    window.Inject(window.Event { kind = window.EventKind.KeyUp, window = w.id, key = window.Key.A, code = 38 })
    window.Inject(window.Event { kind = window.EventKind.ImePreedit, window = w.id, text = "سل", cursor = 4 })
    window.Inject(window.Event { kind = window.EventKind.ImeCommit, window = w.id, text = "سلام" })
    drain()
    println "keys", window.Key.Escape as int, window.Key.F12 as int, window.Key.ContextMenu as int
    println "mods", window.ModShift | window.ModControl | window.ModAlt | window.ModSuper
    w.SetSize(300.0, 150.0)
    e := window.Poll()
    println "resized", e.kind == window.EventKind.Resized, e.width, e.height, e.physical_width, e.physical_height
    r := window.Poll()
    println "redraw after resize", r.kind == window.EventKind.RedrawRequested
    window.Inject(window.Event { kind = window.EventKind.ScaleChanged, window = w.id, scale = 2.0 })
    s := window.Poll()
    println "scale", s.scale, s.width, s.height, s.physical_width, w.ScaleFactor()
    drain()
    w.SetMinSize(250.0, 120.0)
    w.SetMaxSize(400.0, 200.0)
    w.SetSize(100.0, 900.0)
    println "clamped", w.Size()
    drain()
    w.SetCursor(window.Cursor.Text)
    println "cursor", w.CurrentCursor() as int
    w.SetImeRect(12.0, 30.0, 2.0, 18.0)
    println "ime", w.ImeRect()
    w.SetFullscreen(true)
    println "fullscreen", w.IsFullscreen()
    w.SetFullscreen(false)
    w.Minimize()
    w.Maximize()
    w.Restore()
    println "fullscreen", w.IsFullscreen()
    w.SetTitle("renamed")
    println "title", w.Title()
    println "scheme", window.CurrentColorScheme() as int
    window.Inject(window.Event { kind = window.EventKind.ColorSchemeChanged, scheme = window.ColorScheme.Dark })
    c := window.Poll()
    println "scheme changed", c.kind == window.EventKind.ColorSchemeChanged, window.CurrentColorScheme() == window.ColorScheme.Dark
    other := window.Open(window.Options { title = "second", width = 50.0, height = 40.0, headless = true, visible = false })
    println "windows", window.OpenWindows(), other.id
    window.Inject(window.Event { kind = window.EventKind.CloseRequested, window = other.id })
    window.Inject(window.Event { kind = window.EventKind.FocusOut, window = w.id })
    drain()
    other.Close()
    w.Focus()
    drain()
    println "after close", other.IsOpen(), window.OpenWindows(), other.Size(), other.Handle() == null
    window.Wake()
    println "wake", window.Poll().kind == window.EventKind.Wake
    w.Close()
    println "done", window.OpenWindows(), window.Wait(50).kind as int, window.Clock()
end
