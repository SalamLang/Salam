import gui.window

func main:
    w := window.Open(window.Options { title = "insets", width = 100.0, height = 80.0, headless = true, visible = false })
    println "start", window.SafeArea().top, window.SafeArea().bottom, window.KeyboardHeight(), window.TouchSeen()
    window.Inject(window.Event { kind = window.EventKind.InsetsChanged, inset_top = 24.0, inset_bottom = 16.0, inset_left = 2.0, inset_right = 3.0, keyboard = 250.0 })
    a := window.SafeArea()
    println "insets", a.top, a.right, a.bottom, a.left, window.KeyboardHeight()
    window.Inject(window.Event { kind = window.EventKind.PointerDown, window = w.id, pointer_kind = window.PointerKind.Touch, button = window.MouseButton.Left })
    println "touch", window.TouchSeen()
    w.Close()
end
