import gui.window
import mem

func fill(pixels: u32*, width: int, height: int, color: u32):
    repeat width * height in i:
        pixels[i] = color
    end
end

func checksum(w: window.Window, width: int, height: int): u32:
    mut sum := 0 as u32
    repeat height in y:
        repeat width in x:
            sum = sum * (31 as u32) + w.PixelAt(x, y)
        end
    end
    ret sum
end

func main:
    w := window.Open(window.Options { title = "present", width = 8.0, height = 6.0, headless = true })
    println "before", w.PresentCount(), w.PixelAt(0, 0)
    width := 8
    height := 6
    stride := width * 4
    pixels := mem.AllocateZeroed(((width * height) * 4) as u64) as u32*
    defer mem.Free(pixels as void*)
    repeat height in y:
        repeat width in x:
            pixels[y * width + x] = (0xFF000000 as u32) | ((x * 30) as u32 << 16) | ((y * 40) as u32 << 8)
        end
    end
    println "full", w.PresentAll(pixels as void*, width, height, stride), w.LastDamage(), w.LastDamageCount()
    println "pixels", w.PixelAt(0, 0), w.PixelAt(7, 5), w.ShownPixel(3, 2), w.PixelAt(8, 0), w.PixelAt(-1, 0)
    println "sum", checksum(w, width, height)
    fill(pixels, width, height, 0xFF102030 as u32)
    mut damage := Vector {} as Vector<window.Rect>
    defer damage.Free()
    damage.Push(window.Rect { x = 1, y = 1, width = 2, height = 2 })
    damage.Push(window.Rect { x = 6, y = 4, width = 10, height = 10 })
    damage.Push(window.Rect { x = -5, y = 0, width = 3, height = 3 })
    println "damage", w.Present(pixels as void*, width, height, stride, damage), w.LastDamage(), w.LastDamageCount()
    println "kept", w.PixelAt(0, 0), w.PixelAt(3, 3), w.PixelAt(5, 5)
    println "changed", w.PixelAt(1, 1), w.PixelAt(2, 2), w.PixelAt(7, 5), w.PixelAt(6, 4)
    println "sum", checksum(w, width, height)
    big := mem.AllocateZeroed(((10 * 4) * 4) as u64) as u32*
    defer mem.Free(big as void*)
    fill(big, 10, 4, 0x80402010 as u32)
    println "resized buffer", w.Present(big as void*, 4, 3, 40, damage), w.LastDamage(), w.PixelAt(3, 2), w.PixelAt(5, 0)
    println "bad", w.PresentAll(null, 4, 3, 16), w.PresentAll(big as void*, 4, 3, 8), w.PresentCount()
    println "icon", w.SetIcon(big as void*, 2, 2, 40), w.SetIcon(big as void*, 0, 2, 40)
    w.Close()
    println "closed", w.PresentAll(big as void*, 4, 3, 40), w.PixelAt(0, 0), w.PresentCount()
end
