import gui.window

func main:
    println "empty", window.SavedState().Len()
    window.SetSavedState("page=2")
    println "saved", window.SavedState()
    window.SetSavedState("page=3")
    println "again", window.SavedState()
    window.Inject(window.Event { kind = window.EventKind.Pause })
    window.Inject(window.Event { kind = window.EventKind.Resume })
    println "events",
        window.Poll().kind == window.EventKind.Pause,
        window.Poll().kind == window.EventKind.Resume
end
