import gui.window
import mem

func main:
    window.SetManualClock(true)
    println "clock", window.Clock()
    once := window.SetTimer(250, false)
    every := window.SetTimer(100, true)
    mut seen := 0
    until seen < 6:
        e := window.Wait(-1)
        if e.kind == window.EventKind.Timer:
            name := e.timer == once ? "once" : e.timer == every ? "every" : "?"
            println "timer", name, window.Clock()
            seen++
        end
    end
    window.ClearTimer(every)
    e := window.Wait(1000)
    println "after clear", e.kind as int, window.Clock()
    println "nothing left", window.Wait(-1).kind as int, window.Clock()
    window.Advance(40)
    println "advanced", window.Clock()
    window.SetManualClock(false)
    window.SetManualClock(true)
    println "restarted", window.Clock()
    window.Wake()
    window.Wake()
    println "woken", window.Wait(-1).kind == window.EventKind.Wake, window.Poll().kind as int
    println "set", window.SetClipboardText("سلام, clipboard")
    text := window.ClipboardText()
    println "clipboard", text
    mem.Free(text as void*)
    println "set again", window.SetClipboardText("")
    empty := window.ClipboardText()
    println "empty", empty.len()
    mem.Free(empty as void*)
    println "error", window.LastError().len()
end
