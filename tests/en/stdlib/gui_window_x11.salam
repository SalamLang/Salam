import gui.window
import mem
import time

func waker():
    time.Sleep(100)
    window.Wake()
end

func next_of(kind: window.EventKind): window.Event:
    repeat 200:
        e := window.Wait(50)
        if e.kind == kind:
            ret e
        end
    end
    ret window.Event {}
end

func main:
    w := window.Open(window.Options { title = "x11 readback", width = 64.0, height = 48.0, scale = 1.0 })
    println "open", w.IsOpen(), w.IsHeadless(), w.Handle() != null
    first := next_of(window.EventKind.RedrawRequested)
    println "redraw", first.physical_width, first.physical_height
    pixels := mem.AllocateZeroed(((64 * 48) * 4) as u64) as u32*
    defer mem.Free(pixels as void*)
    repeat 48 in y:
        repeat 64 in x:
            pixels[y * 64 + x] = (0xFF800000 as u32) | ((x as u32) << 8) | (y as u32)
        end
    end
    println "present", w.PresentAll(pixels as void*, 64, 48, 256)
    println "shown", w.ShownPixel(0, 0), w.ShownPixel(10, 20), w.ShownPixel(63, 47)
    println "same", w.ShownPixel(10, 20) == w.PixelAt(10, 20)
    repeat 64 * 48 in i:
        pixels[i] = 0xFF00FF00 as u32
    end
    mut damage := Vector {} as Vector<window.Rect>
    defer damage.Free()
    damage.Push(window.Rect { x = 4, y = 4, width = 8, height = 8 })
    println "damage", w.Present(pixels as void*, 64, 48, 256, damage)
    println "inside", w.ShownPixel(5, 5), "outside", w.ShownPixel(20, 20)
    w.SetSize(80.0, 60.0)
    r := next_of(window.EventKind.Resized)
    println "resized", r.width, r.height, w.Size()
    w.SetTitle("x11 readback, renamed")
    w.SetCursor(window.Cursor.Text)
    w.SetCursor(window.Cursor.Hidden)
    w.SetImeRect(4.0, 4.0, 2.0, 16.0)
    println "clipboard set", window.SetClipboardText("سلام from X11")
    text := window.ClipboardText()
    println "clipboard", text
    mem.Free(text as void*)
    timer := window.SetTimer(30, false)
    println "timer", next_of(window.EventKind.Timer).timer == timer
    thread := spawn(waker)
    println "wake", next_of(window.EventKind.Wake).kind == window.EventKind.Wake
    join(thread)
    w.Close()
    println "closed", w.IsOpen(), window.OpenWindows()
end
