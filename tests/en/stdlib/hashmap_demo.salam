package main

import testing
import collections
import conv

func test_basic():
    mut m := HashMap {} as HashMap<str, int>
    defer m.Free()
    testing.AssertTrue(m.IsEmpty())
    testing.AssertEqInt(m.Size(), 0)
    m.Put("one", 1)
    m.Put("two", 2)
    m.Insert("three", 3)
    testing.AssertEqInt(m.Size(), 3)
    testing.AssertFalse(m.IsEmpty())
    testing.AssertEqInt(m.Get("two"), 2)
    testing.AssertTrue(m.Has("one"))
    testing.AssertFalse(m.Has("four"))
    testing.AssertEqInt(m.Get("four"), 0)
end

func test_overwrite():
    mut m := HashMap {} as HashMap<str, int>
    defer m.Free()
    m.Put("k", 1)
    m.Put("k", 2)
    m.Put("k", 3)
    testing.AssertEqInt(m.Size(), 1)
    testing.AssertEqInt(m.Get("k"), 3)
end

func test_remove():
    mut m := HashMap {} as HashMap<str, int>
    defer m.Free()
    m.Put("a", 1)
    m.Put("b", 2)
    testing.AssertTrue(m.Remove("a"))
    testing.AssertEqInt(m.Size(), 1)
    testing.AssertFalse(m.Has("a"))
    testing.AssertFalse(m.Remove("a"))
    testing.AssertFalse(m.Remove("never there"))
    testing.AssertEqInt(m.Get("b"), 2)
    m.Put("a", 9)
    testing.AssertEqInt(m.Get("a"), 9)
    testing.AssertEqInt(m.Size(), 2)
end

func test_growth():
    mut m := HashMap {} as HashMap<str, int>
    defer m.Free()
    mut i := 0
    until i < 500:
        m.Put("key".Concat(conv.FormatInt(i as i64)), i)
        i++
    end
    testing.AssertEqInt(m.Size(), 500)
    testing.AssertEqInt(m.Get("key0"), 0)
    testing.AssertEqInt(m.Get("key250"), 250)
    testing.AssertEqInt(m.Get("key499"), 499)
    mut j := 0
    until j < 500:
        m.Remove("key".Concat(conv.FormatInt(j as i64)))
        j += 2
    end
    testing.AssertEqInt(m.Size(), 250)
    mut k := 1
    mut found := 0
    until k < 500:
        if m.Get("key".Concat(conv.FormatInt(k as i64))) == k: found++ end
        k += 2
    end
    testing.AssertEqInt(found, 250)
end

func test_iteration():
    mut m := HashMap {} as HashMap<str, int>
    defer m.Free()
    mut expected := 0
    mut i := 1
    until i < 51:
        m.Put("n".Concat(conv.FormatInt(i as i64)), i)
        expected += i
        i++
    end
    mut total := 0
    mut seen := 0
    it := m.Iter()
    until it.HasNext():
        total += it.Value()
        seen++
        it.Next()
    end
    testing.AssertEqInt(seen, 50)
    testing.AssertEqInt(total, expected)
    mut e := HashMap {} as HashMap<str, int>
    defer e.Free()
    mut count := 0
    eit := e.Iter()
    until eit.HasNext():
        count++
        eit.Next()
    end
    testing.AssertEqInt(count, 0)
end

func test_int_keys():
    mut m := HashMap {} as HashMap<int, str>
    defer m.Free()
    m.Put(1, "one")
    m.Put(2, "two")
    m.Put(1000000, "big")
    testing.AssertEqStr(m.Get(1), "one")
    testing.AssertEqStr(m.Get(1000000), "big")
    testing.AssertEqInt(m.Size(), 3)
    testing.AssertFalse(m.Has(7))
    testing.AssertEqStr(m.GetOr(7, "none"), "none")
    testing.AssertEqStr(m.GetOr(1, "none"), "one")
end

func test_runtime_keys():
    mut m := HashMap {} as HashMap<str, int>
    defer m.Free()
    src := "USER_NAME=max"
    m.Put(src.Substr(0, 9), 1)
    testing.AssertTrue(m.Has("USER_NAME"))
    testing.AssertEqInt(m.Get("USER_NAME"), 1)
    testing.AssertEqInt(m.Get("USER".Concat("_NAME")), 1)
end

func test_set():
    mut s := Set {} as Set<str>
    defer s.Free()
    testing.AssertTrue(s.IsEmpty())
    s.Add("a")
    s.Add("b")
    s.Add("a")
    testing.AssertEqInt(s.Size(), 2)
    testing.AssertTrue(s.Has("a"))
    testing.AssertFalse(s.Has("z"))
    testing.AssertTrue(s.Remove("a"))
    testing.AssertFalse(s.Remove("a"))
    testing.AssertEqInt(s.Size(), 1)
end

func test_counter():
    mut c := Counter {} as Counter<str>
    defer c.Free()
    c.Add("apple")
    c.Add("apple")
    c.Add("pear")
    c.add_n("apple", 3)
    testing.AssertEqInt(c.count("apple"), 5)
    testing.AssertEqInt(c.count("pear"), 1)
    testing.AssertEqInt(c.count("plum"), 0)
    testing.AssertEqInt(c.distinct(), 2)
end

func test_ordered_vs_hash():
    mut om := collections.OrderedMap {}
    defer om.Free()
    om.Set("zebra", "1")
    om.Set("apple", "2")
    om.Set("mango", "3")
    testing.AssertEqStr(om.KeyAt(0), "zebra")
    testing.AssertEqStr(om.KeyAt(1), "apple")
    testing.AssertEqStr(om.KeyAt(2), "mango")
    testing.AssertEqStr(om.Get("apple"), "2")
    om.Set("zebra", "9")
    testing.AssertEqStr(om.KeyAt(0), "zebra")
    testing.AssertEqStr(om.Get("zebra"), "9")
    testing.AssertEqInt(om.Len(), 3)
end

func main:
    test_basic()
    test_overwrite()
    test_remove()
    test_growth()
    test_iteration()
    test_int_keys()
    test_runtime_keys()
    test_set()
    test_counter()
    test_ordered_vs_hash()
    testing.Summary()
    ret 0
end
