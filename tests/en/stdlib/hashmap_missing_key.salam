import option

struct P:
    pub name: str = "def"
    pub n: int = 7
end

func main:
    mut m := HashMap {} as HashMap<str, str>
    println m.get("x") + "!", m.get("x").len()
    mut q := HashMap {} as HashMap<str, P>
    p := q.get("x")
    println p.n, p.name
    mut r := HashMap {} as HashMap<int, int>
    println r.get(5)
    o := option.None() as option.Option<str>
    println option.IsSome(o), option.UnwrapOr(o, "fallback")
end
