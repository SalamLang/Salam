import collections

func main:
    mut m := collections.HashMap {} as collections.HashMap<int, int>
    mut i := 0
    until i < 300000:
        m.Put(i, i)
        _r := m.Remove(i)
        i++
    end
    println m.Size(), m.cap <= 64
    mut j := 0
    until j < 1000:
        m.Put(j, j * 2)
        j++
    end
    j = 0
    until j < 1000:
        m.Put(j + 5000, j)
        _r := m.Remove(j)
        j++
    end
    ok := m.Size() == 1000 and m.Has(5999) and not m.Has(0) and m.Get(5999) == 999
    println m.Size(), ok, m.cap <= 8192
    m.Free()
end
