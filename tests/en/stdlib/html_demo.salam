import encoding.html

func main:
    println html.Unescape("a &lt; b &amp;&amp; c &gt; d &quot;x&quot; &apos;y&apos;")
    println html.Unescape("&#65;&#x42;&#X43; &#233; &#x1F600;")
    println html.Unescape("&copy; &copy &notit; &amp &bogus; &NotEqualTilde;")
    println html.Unescape("&#128; &#0; &#xD800; &#1; end&")
    println html.Unescape("no entities here")
    println html.Unescape("&lt;p&gt;r&eacute;sum&eacute; &mdash; &euro;5&lt;/p&gt;")
    println html.Escape(`<a href="x">it's & co</a>`)
    println html.EscapeText(`<a href="x">it's & co</a>`)
    println html.Unescape(html.Escape(`<b>"q" & 'r'</b>`))
end
