import encoding.html
import str

func main:
    println "[" + html.Unescape("") + "]", "[" + html.Escape("") + "]", "[" + html.EscapeText("") + "]"
    println html.Unescape("&amp;lt;"), html.Unescape(html.Unescape("&amp;lt;"))
    println html.Unescape("&LT; &Lt; &AMP; &amp;"), html.Unescape("&lt &gt &quot &amp")
    println html.Unescape("&nbsp;|").len(), html.Unescape("&#160;|").len()
    println html.Unescape("&#65 &#x41 &#65;&#66"), html.Unescape("&#x; &#; &#xg; &#12a;")
    println html.Unescape("&#1114111;").len(), html.Unescape("&#1114112;").len(), html.Unescape("&#99999999999999999999;").len()
    println html.Unescape("&#x110000; &#xFFFFFFFF;").len()
    println html.Unescape("&#13;&#10;").len(), html.Unescape("&#9;").len()
    println html.Unescape("&#150; &#8211; &#x80; &#x9f;")
    println html.Unescape("&#0;|&#xD800;|&#xDFFF;|&#xFFFE;").len()
    println html.Unescape("a & b && c &; &&amp;")
    println html.Unescape("&notin; &not; &noti; &notit;")
    println html.Unescape("&copy&copy; &reg &REG; &ampx; &amp;x")
    println html.Unescape("سلام &lt;دنیا&gt; &#1587;&#1604;&#1575;&#1605; &zwnj;|").len()
    println html.Escape("سلام <دنیا> & 'جهان'")
    println html.EscapeText("سلام <دنیا> & 'جهان' \"x\"")
    println html.Escape("\"\"''&&<<>>")
    println html.Escape("plain text 123"), html.EscapeText("plain text 123")
    println html.Escape("a\nb\tc\r"), html.Escape("é€").len()

    mut parts := Vector {} as Vector<str>
    repeat 5000:
        parts.push("<tag attr=\"v\">x & y</tag>")
    end
    long := str.Join(parts, "\n")
    parts.free()
    escaped := html.Escape(long)
    back := html.Unescape(escaped)
    println long.len(), escaped.len(), back == long
    text_only := html.EscapeText(long)
    println text_only.len(), html.Unescape(text_only) == long

    names := ["alpha", "beta", "hellip", "rarr", "hearts", "Aacute", "ouml", "szlig", "THORN", "frac12", "times", "deg"]
    each n in names:
        println n, html.Unescape("&" + n + ";").len(), html.Unescape("&" + n + ";") == "&" + n + ";"
    end
    println html.Unescape("&hellip;&rarr;&hearts;")
    println html.Unescape("&unknownthing; &x; &1;")
end
