package main

import testing
import net.httpd.conf

func sample(): str:
    mut t := "server:\n"
    t = t.Concat("    threads = auto\n")
    t = t.Concat("    max connections = 10000\n")
    t = t.Concat("    log: access = \"/var/log/a.log\" end\n")
    t = t.Concat("    upstream api:\n")
    t = t.Concat("        server: address = \"127.0.0.1:9001\" weight = 2 end\n")
    t = t.Concat("    end\n")
    t = t.Concat("    site:\n")
    t = t.Concat("        listen = 443 tls\n")
    t = t.Concat("        names = \"a.com www.a.com\"\n")
    t = t.Concat("        redirect = \"https://a.com$uri\" code = 301\n")
    t = t.Concat("        // a comment\n")
    t = t.Concat("        location \"/api/\": proxy = \"http://api\" timeout = 30s end\n")
    t = t.Concat("        location `~ \\.php$`: index = \"index.php\" end\n")
    t = t.Concat("    end\n")
    t = t.Concat("end\n")
    ret t
end

func test_structure():
    mut d := conf.Parse(sample())
    defer conf.Free(d)
    testing.AssertTrue(d.ok)
    server := conf.Find(d, conf.Root(), "server")
    testing.AssertTrue(server > 0)
    testing.AssertEqInt(conf.Count(d, server), 5)
    mc := conf.Find(d, server, "max connections")
    testing.AssertEqStr(conf.ValueText(d, mc, 0), "10000")
    up := conf.Find(d, server, "upstream api")
    testing.AssertTrue(up > 0)
    testing.AssertTrue(d.nodes.Get(up).block)
end

func test_values():
    mut d := conf.Parse(sample())
    defer conf.Free(d)
    server := conf.Find(d, conf.Root(), "server")
    site := conf.Find(d, server, "site")
    listen := conf.Find(d, site, "listen")
    testing.AssertEqInt(d.nodes.Get(listen).values.Len(), 2)
    testing.AssertEqStr(conf.ValueText(d, listen, 0), "443")
    testing.AssertEqStr(conf.ValueText(d, listen, 1), "tls")
    names := conf.Find(d, site, "names")
    testing.AssertEqStr(conf.ValueText(d, names, 0), "a.com www.a.com")
    redirect := conf.Find(d, site, "redirect")
    testing.AssertEqStr(conf.ValueText(d, redirect, 0), "https://a.com$uri")
    code := conf.Find(d, site, "code")
    testing.AssertEqStr(conf.ValueText(d, code, 0), "301")
end

func test_labels():
    mut d := conf.Parse(sample())
    defer conf.Free(d)
    server := conf.Find(d, conf.Root(), "server")
    site := conf.Find(d, server, "site")
    mut found := 0
    repeat conf.Count(d, site) in i:
        c := conf.ChildAt(d, site, i)
        n := d.nodes.Get(c)
        if n.block and n.labels.Len() == 1:
            found++
            if found == 1:
                testing.AssertEqStr(n.labels.Get(0), "/api/")
            else:
                testing.AssertEqStr(n.labels.Get(0), "~ \\.php$")
            end
        end
    end
    testing.AssertEqInt(found, 2)
end

func test_errors():
    mut a := conf.Parse("server:\n    site:\n")
    testing.AssertFalse(a.ok)
    testing.AssertContains(conf.ErrorText(a, "web.salam"), "missing 'end'")
    conf.Free(a)
    mut b := conf.Parse("server:\nend\nend\n")
    testing.AssertFalse(b.ok)
    testing.AssertEqInt(b.line, 3)
    conf.Free(b)
    mut c := conf.Parse("listen = \n")
    testing.AssertFalse(c.ok)
    conf.Free(c)
    mut e := conf.Parse("names = \"open\n")
    testing.AssertFalse(e.ok)
    testing.AssertContains(e.error, "unterminated string")
    conf.Free(e)
    mut f := conf.Parse("listen 80\n")
    testing.AssertFalse(f.ok)
    conf.Free(f)
end

func main:
    test_structure()
    test_values()
    test_labels()
    test_errors()
    testing.Summary()
    ret 0
end
