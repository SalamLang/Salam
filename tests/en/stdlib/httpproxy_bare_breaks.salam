import net.httpproxy

func main():
    good := httpproxy.ParseRequestHead("GET http://a.example/ HTTP/1.1\r\nHost: a.example\r\nX-A: 1\r\n\r\n")
    println "plain head", good.ok
    lf := httpproxy.ParseRequestHead("GET http://a.example/ HTTP/1.1\r\nHost: a.example\r\nX-A: 1\nContent-Length: 5\r\n\r\n")
    println "bare LF in a value", lf.ok, lf.err
    cr := httpproxy.ParseRequestHead("GET http://a.example/ HTTP/1.1\r\nHost: a.example\r\nX-A: 1\rX-B: 2\r\n\r\n")
    println "bare CR in a value", cr.ok, cr.err
    path := httpproxy.ParseRequestHead("GET http://a.example/x\nHost:evil HTTP/1.1\r\nHost: a.example\r\n\r\n")
    println "bare LF in the target", path.ok
    rs := httpproxy.ParseResponseHead("HTTP/1.1 200 OK\r\nX-A: 1\nSet-Cookie: s=1\r\n\r\n")
    println "bare LF in a response", rs.ok
    rok := httpproxy.ParseResponseHead("HTTP/1.1 200 OK\r\nX-A: 1\r\n\r\n")
    println "plain response", rok.ok
end
