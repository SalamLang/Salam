import net.httpproxy
import net.socks
import net.tcp
import net.tunnel
import str

mut seen_hosts := ""
mut origin_port := 0

func origin_conn(arg: i64):
    c := tcp.ConnFromFd(arg)
    mut buf := ""
    until buf.find("\r\n\r\n") < 0:
        d := tcp.Read(c, 4096)
        if d.Len() == 0: break end
        buf += d
    end
    h := httpproxy.ParseRequestHead(buf)
    body := "path " + h.target + " host " + httpproxy.HeaderGet(h, "host")
    tcp.Write(c, "HTTP/1.1 200 OK\r\nContent-Length: " + body.Len() + "\r\nConnection: close\r\n\r\n" + body)
    tcp.Close(c)
end

func origin_accept(arg: i64):
    srv := tcp.Server { fd = arg }
    until true:
        c := tcp.Accept(srv)
        if not tcp.ConnOk(c): break end
        socks.Go(origin_conn, c.fd as void*)
    end
end

func echo_conn(arg: i64):
    c := tcp.ConnFromFd(arg)
    until true:
        d := tcp.Read(c, 4096)
        if d.Len() == 0: break end
        tcp.Write(c, d)
    end
    tcp.Close(c)
end

func echo_accept(arg: i64):
    srv := tcp.Server { fd = arg }
    until true:
        c := tcp.Accept(srv)
        if not tcp.ConnOk(c): break end
        socks.Go(echo_conn, c.fd as void*)
    end
end

func show(label: str, r: httpproxy.Response):
    println label + ": ok=" + r.ok + " status=" + r.status + " body=[" + str.Replace(r.body, ":" + origin_port, ":PORT") + "] " + r.err
end

func tunnel_round(label: str, cl: httpproxy.Client, host: str, port: int):
    r := httpproxy.Connect(cl, host, port)
    println label + ": ok=" + r.ok + " status=" + r.status
    if r.ok:
        r.stream.Write("through the tunnel")
        println r.stream.Read(100)
        r.stream.Close()
    end
end

func main:
    probe := tcp.BindOn("::1", 0)
    if not tcp.Ok(probe):
        println "ipv6 unavailable"
        ret
    end
    tcp.CloseServer(probe)

    hp := httpproxy.SplitHostPort("[2001:db8::1]:8080", 80)
    println hp.ok, hp.host, hp.port, hp.has_port
    hp2 := httpproxy.SplitHostPort("[::1]", 443)
    println hp2.ok, hp2.host, hp2.port, hp2.has_port
    println httpproxy.SplitHostPort("::1:80", 80).ok, httpproxy.SplitHostPort("[::1", 80).ok, httpproxy.SplitHostPort("[::1]x", 80).ok
    u := httpproxy.ParseURL("http://user@[2001:db8::2]:8081/a/b?q=1")
    println u.ok, u.host, u.port, u.path
    u2 := httpproxy.ParseURL("https://[::1]/")
    println u2.ok, u2.host, u2.port

    os := tcp.BindOn("::1", 0)
    socks.Go(origin_accept, os.fd as void*)
    oport := tcp.Port(os)
    origin_port = oport
    es := tcp.BindOn("::1", 0)
    socks.Go(echo_accept, es.fd as void*)
    eport := tcp.Port(es)
    origin := "http://[::1]:" + oport

    mut cfg4 := httpproxy.NewServerConfig(0)
    httpproxy.AllowPrivate(cfg4, true)
    sv4 := httpproxy.Start(cfg4)
    println "v4 proxy up", sv4.ok
    cl4 := httpproxy.NewClient("127.0.0.1", sv4.port)
    show("absolute uri to [::1]", httpproxy.Get(cl4, origin + "/hello"))
    show("post to [::1]", httpproxy.Post(cl4, origin + "/echo", "text/plain", "x"))
    tunnel_round("connect [::1]", cl4, "::1", eport)
    conn := httpproxy.DialConn(cl4, "::1", eport)
    tcp.Write(conn, "dial conn")
    println tcp.Read(conn, 100)
    tcp.Close(conn)
    raw := tcp.Dial("127.0.0.1", sv4.port)
    tcp.Write(raw, "CONNECT [::1]:" + eport + " HTTP/1.1\r\nHost: [::1]:" + eport + "\r\n\r\n")
    println tcp.Read(raw, 200).substr(0, 15)
    tcp.Write(raw, "raw tunnel")
    println tcp.Read(raw, 100)
    tcp.Close(raw)
    free := tcp.FreePort()
    show("v6 upstream refused", httpproxy.Get(cl4, "http://[::1]:" + free + "/"))
    httpproxy.Stop(sv4)

    mut cfg6 := httpproxy.NewServerConfig(0)
    httpproxy.AllowPrivate(cfg6, true)
    cfg6.bind_host = "::1"
    cfg6.allow = (method: str, host: str, _port: int): seen_hosts += method + "@" + host + ";" ret true end
    sv6 := httpproxy.Start(cfg6)
    println "v6 proxy up", sv6.ok, sv6.host
    cl6 := httpproxy.NewClient("::1", sv6.port)
    show("via v6 proxy absolute uri", httpproxy.Get(cl6, origin + "/hello"))
    tunnel_round("via v6 proxy connect", cl6, "::1", eport)
    println seen_hosts
    httpproxy.Stop(sv6)

    mut cfgd := httpproxy.NewServerConfig(0)
    httpproxy.AllowPrivate(cfgd, true)
    cfgd.bind_host = "::"
    tunnel.PolicyAllowCidr(cfgd.policy, "::1/128")
    tunnel.PolicyAllowCidr(cfgd.policy, "127.0.0.0/8")
    svd := httpproxy.Start(cfgd)
    println "dual proxy up", svd.ok
    show("dual via v4", httpproxy.Get(httpproxy.NewClient("127.0.0.1", svd.port), origin + "/hello"))
    show("dual via v6", httpproxy.Get(httpproxy.NewClient("::1", svd.port), origin + "/hello"))
    httpproxy.Stop(svd)
end
