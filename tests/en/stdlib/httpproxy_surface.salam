import net.httpproxy
import net.tunnel

func main:
    p1 := tunnel.NewPipe()
    a1 := tunnel.PipeA(p1)
    b1 := tunnel.PipeB(p1)
    a1.Write("CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\n\r\n")
    mut inb := httpproxy.NewInbound(httpproxy.NewServerConfig(0))
    sess := inb.Handshake(b1)
    println sess.ok, sess.target.host, sess.target.port
    inb.Reply(b1, sess, true)
    println a1.Read(64).starts_with("HTTP/1.1 200")

    p2 := tunnel.NewPipe()
    a2 := tunnel.PipeA(p2)
    b2 := tunnel.PipeB(p2)
    b2.Write("HTTP/1.1 200 Connection established\r\n\r\n")
    mut conn := httpproxy.NewConnector(httpproxy.NewClient("10.0.0.1", 3128))
    println conn.Server().host, conn.Server().port
    println conn.Handshake(a2, tunnel.NewAddr("example.org", 443))
    println b2.Read(200).starts_with("CONNECT example.org:443")

    p3 := tunnel.NewPipe()
    a3 := tunnel.PipeA(p3)
    b3 := tunnel.PipeB(p3)
    b3.Write("HTTP/1.1 403 Forbidden\r\n\r\n")
    r := httpproxy.ClientHandshake(a3, httpproxy.NewClient("10.0.0.1", 3128), "example.org", 443)
    println r.ok

    p4 := tunnel.NewPipe()
    a4 := tunnel.PipeA(p4)
    b4 := tunnel.PipeB(p4)
    a4.Write("NONSENSE\r\n\r\n")
    httpproxy.Handle(httpproxy.NewServerConfig(0), b4)
    println a4.Read(64).starts_with("HTTP/1.1 400")

    mut bad := httpproxy.NewServerConfig(0)
    bad.bind_host = "203.0.113.1"
    println httpproxy.Serve(bad)
end
