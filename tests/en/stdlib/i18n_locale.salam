package main

import i18n
import os
import io
import env
import fs.path

func main:
    mut cat := i18n.New("en")
    i18n.Set(cat, "en", "hello", "Hello")
    println i18n.RawGet(cat, "en", "hello")
    println i18n.RawGet(cat, "fa", "hello").len()
    println i18n.RawGet(cat, "en", "missing").len()

    file := path.Join(os.TempDir(), "salam_i18n_locale_test.env")
    io.WriteFile(file, "bye=Goodbye\nthanks=Thank you\n")
    println i18n.LoadLocale(cat, "en", file)
    os.Remove(file)
    println i18n.RawGet(cat, "en", "bye")
    println i18n.T(cat, "en", "thanks")
    println i18n.Has(cat, "en", "bye")

    env.Set("SALAM_LOCALE", "fa_IR.UTF-8")
    println i18n.DetectLocale()
    env.Set("SALAM_LOCALE", "pt-BR")
    println i18n.DetectLocale()
    env.Set("SALAM_LOCALE", "DE")
    println i18n.DetectLocale()
    i18n.Free(cat)
end
