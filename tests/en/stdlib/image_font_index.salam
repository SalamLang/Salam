package main

import image
import compress
import archive
import testing
import os
import filepath

const UPEM := 1000
const NUM_GLYPHS := 4
const TTF_NUM_TABLES := 7

func be16(b &: compress.ByteBuf, v: int):
    compress.BufPush(b, (v >> 8) & 255)
    compress.BufPush(b, v & 255)
end

func be32(b &: compress.ByteBuf, v: int):
    be16(b, (v >> 16) & 0xFFFF)
    be16(b, v & 0xFFFF)
end

func pad4(n: int): int:
    ret ((n + 3) / 4) * 4
end

func pad_to4(b &: compress.ByteBuf):
    until (b.len % 4) != 0:
        compress.BufPush(b, 0)
    end
end

func build_glyph(xs &: Vector<int>, ys &: Vector<int>, ends &: Vector<int>): compress.ByteBuf:
    mut g := compress.NewByteBuf()
    n := xs.len()
    mut minx := xs.get(0)
    mut maxx := xs.get(0)
    mut miny := ys.get(0)
    mut maxy := ys.get(0)
    mut i := 1
    until i < n:
        if xs.get(i) < minx: minx = xs.get(i) end
        if xs.get(i) > maxx: maxx = xs.get(i) end
        if ys.get(i) < miny: miny = ys.get(i) end
        if ys.get(i) > maxy: maxy = ys.get(i) end
        i++
    end
    be16(g, ends.len())
    be16(g, minx & 0xFFFF)
    be16(g, miny & 0xFFFF)
    be16(g, maxx & 0xFFFF)
    be16(g, maxy & 0xFFFF)
    mut k := 0
    until k < ends.len():
        be16(g, ends.get(k))
        k++
    end
    be16(g, 0)
    mut p := 0
    until p < n:
        compress.BufPush(g, 1)
        p++
    end
    mut prev := 0
    mut a := 0
    until a < n:
        be16(g, (xs.get(a) - prev) & 0xFFFF)
        prev = xs.get(a)
        a++
    end
    prev = 0
    mut b := 0
    until b < n:
        be16(g, (ys.get(b) - prev) & 0xFFFF)
        prev = ys.get(b)
        b++
    end
    pad_to4(g)
    ret g
end

func push_pt(xs &: Vector<int>, ys &: Vector<int>, x: int, y: int):
    xs.push(x)
    ys.push(y)
end

func glyph_square(): compress.ByteBuf:
    mut xs := Vector {} as Vector<int>
    mut ys := Vector {} as Vector<int>
    mut ends := Vector {} as Vector<int>
    push_pt(xs, ys, 100, 0)
    push_pt(xs, ys, 700, 0)
    push_pt(xs, ys, 700, 700)
    push_pt(xs, ys, 100, 700)
    ends.push(3)
    out := build_glyph(xs, ys, ends)
    xs.free()
    ys.free()
    ends.free()
    ret out
end

func glyph_ring(): compress.ByteBuf:
    mut xs := Vector {} as Vector<int>
    mut ys := Vector {} as Vector<int>
    mut ends := Vector {} as Vector<int>
    push_pt(xs, ys, 100, 0)
    push_pt(xs, ys, 900, 0)
    push_pt(xs, ys, 900, 800)
    push_pt(xs, ys, 100, 800)
    ends.push(3)
    push_pt(xs, ys, 300, 200)
    push_pt(xs, ys, 300, 600)
    push_pt(xs, ys, 700, 600)
    push_pt(xs, ys, 700, 200)
    ends.push(7)
    out := build_glyph(xs, ys, ends)
    xs.free()
    ys.free()
    ends.free()
    ret out
end

func glyph_triangle(): compress.ByteBuf:
    mut xs := Vector {} as Vector<int>
    mut ys := Vector {} as Vector<int>
    mut ends := Vector {} as Vector<int>
    push_pt(xs, ys, 0, 0)
    push_pt(xs, ys, 800, 0)
    push_pt(xs, ys, 400, 800)
    ends.push(2)
    out := build_glyph(xs, ys, ends)
    xs.free()
    ys.free()
    ends.free()
    ret out
end

func build_head(): compress.ByteBuf:
    mut t := compress.NewByteBuf()
    be32(t, 0x00010000)
    be32(t, 0x00010000)
    be32(t, 0)
    be32(t, 0x5F0F3CF5)
    be16(t, 0)
    be16(t, UPEM)
    be32(t, 0)
    be32(t, 0)
    be32(t, 0)
    be32(t, 0)
    be16(t, 0)
    be16(t, 0)
    be16(t, 900)
    be16(t, 800)
    be16(t, 0)
    be16(t, 8)
    be16(t, 2)
    be16(t, 0)
    be16(t, 0)
    ret t
end

func build_maxp(): compress.ByteBuf:
    mut t := compress.NewByteBuf()
    be32(t, 0x00010000)
    be16(t, NUM_GLYPHS)
    mut i := 0
    until i < 13:
        be16(t, 0)
        i++
    end
    ret t
end

func build_hhea(): compress.ByteBuf:
    mut t := compress.NewByteBuf()
    be32(t, 0x00010000)
    be16(t, 800)
    be16(t, (0 - 200) & 0xFFFF)
    be16(t, 100)
    be16(t, 1000)
    be16(t, 0)
    be16(t, 0)
    be16(t, 900)
    be16(t, 1)
    be16(t, 0)
    be16(t, 0)
    mut i := 0
    until i < 4:
        be16(t, 0)
        i++
    end
    be16(t, 0)
    be16(t, NUM_GLYPHS)
    ret t
end

func build_hmtx(): compress.ByteBuf:
    mut t := compress.NewByteBuf()
    be16(t, 500)
    be16(t, 0)
    be16(t, 800)
    be16(t, 100)
    be16(t, 1000)
    be16(t, 100)
    be16(t, 900)
    be16(t, 0)
    ret t
end

func build_cmap(): compress.ByteBuf:
    mut t := compress.NewByteBuf()
    be16(t, 0)
    be16(t, 1)
    be16(t, 3)
    be16(t, 1)
    be32(t, 12)
    be16(t, 4)
    be16(t, 32)
    be16(t, 0)
    be16(t, 4)
    be16(t, 4)
    be16(t, 1)
    be16(t, 0)
    be16(t, 0x43)
    be16(t, 0xFFFF)
    be16(t, 0)
    be16(t, 0x41)
    be16(t, 0xFFFF)
    be16(t, (0 - 64) & 0xFFFF)
    be16(t, 1)
    be16(t, 0)
    be16(t, 0)
    ret t
end

func build_glyf(loca &: compress.ByteBuf): compress.ByteBuf:
    mut t := compress.NewByteBuf()
    be16(loca, 0)
    be16(loca, 0)
    mut sq := glyph_square()
    compress.BufPushBuf(t, sq)
    compress.BufFree(sq)
    be16(loca, t.len / 2)
    mut rg := glyph_ring()
    compress.BufPushBuf(t, rg)
    compress.BufFree(rg)
    be16(loca, t.len / 2)
    mut tr := glyph_triangle()
    compress.BufPushBuf(t, tr)
    compress.BufFree(tr)
    be16(loca, t.len / 2)
    ret t
end

func put_record(out &: compress.ByteBuf, tag: int, off: int, len: int):
    be32(out, tag)
    be32(out, 0)
    be32(out, off)
    be32(out, len)
end

func build_ttf(): compress.ByteBuf:
    mut loca := compress.NewByteBuf()
    mut glyf := build_glyf(loca)
    mut cmap := build_cmap()
    mut head := build_head()
    mut hhea := build_hhea()
    mut hmtx := build_hmtx()
    mut maxp := build_maxp()

    mut off := 12 + 16 * TTF_NUM_TABLES
    off_cmap := off
    off += pad4(cmap.len)
    off_glyf := off
    off += pad4(glyf.len)
    off_head := off
    off += pad4(head.len)
    off_hhea := off
    off += pad4(hhea.len)
    off_hmtx := off
    off += pad4(hmtx.len)
    off_loca := off
    off += pad4(loca.len)
    off_maxp := off

    mut out := compress.NewByteBuf()
    be32(out, 0x00010000)
    be16(out, TTF_NUM_TABLES)
    be16(out, 64)
    be16(out, 2)
    be16(out, 48)
    put_record(out, 0x636D6170, off_cmap, cmap.len)
    put_record(out, 0x676C7966, off_glyf, glyf.len)
    put_record(out, 0x68656164, off_head, head.len)
    put_record(out, 0x68686561, off_hhea, hhea.len)
    put_record(out, 0x686D7478, off_hmtx, hmtx.len)
    put_record(out, 0x6C6F6361, off_loca, loca.len)
    put_record(out, 0x6D617870, off_maxp, maxp.len)

    compress.BufPushBuf(out, cmap)
    pad_to4(out)
    compress.BufPushBuf(out, glyf)
    pad_to4(out)
    compress.BufPushBuf(out, head)
    pad_to4(out)
    compress.BufPushBuf(out, hhea)
    pad_to4(out)
    compress.BufPushBuf(out, hmtx)
    pad_to4(out)
    compress.BufPushBuf(out, loca)
    pad_to4(out)
    compress.BufPushBuf(out, maxp)
    pad_to4(out)

    compress.BufFree(cmap)
    compress.BufFree(glyf)
    compress.BufFree(head)
    compress.BufFree(hhea)
    compress.BufFree(hmtx)
    compress.BufFree(loca)
    compress.BufFree(maxp)
    ret out
end

func main:
    mut ttf := build_ttf()
    tmpdir := filepath.Join(os.TempDir(), "salam_font_index_test")
    os.MkdirAll(tmpdir)
    path := filepath.Join(tmpdir, "synthetic.ttf")
    testing.AssertTrue(archive.WriteBinaryFileBuf(path, ttf))

    mut ok := false
    mut f := image.LoadFontIndex(path, 0, ok)
    println "index 0 ok: ", ok
    println "index 0 valid: ", image.FontValid(f)
    println "units per em: ", image.UnitsPerEm(f)
    image.FreeFont(f)

    mut ok1 := true
    mut other := image.LoadFontIndex(path, 1, ok1)
    println "index 1 ok: ", ok1
    println "index 1 valid: ", image.FontValid(other)
    image.FreeFont(other)

    mut ok2 := true
    mut neg := image.LoadFontIndex(path, -1, ok2)
    println "negative index ok: ", ok2
    image.FreeFont(neg)

    mut ok3 := true
    mut gone := image.LoadFontIndex(filepath.Join(tmpdir, "absent.ttf"), 0, ok3)
    println "missing file ok: ", ok3
    image.FreeFont(gone)

    compress.BufFree(ttf)
    os.RemoveAll(tmpdir)
    ret testing.Summary()
end
