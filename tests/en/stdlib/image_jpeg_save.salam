package main

import image
import os
import filepath

func main:
    mut img := image.New(24, 16)
    repeat 16 in y:
        repeat 24 in x:
            image.SetPixel(img, x, y, image.RGB(x * 10, y * 14, 128))
        end
    end
    dir := filepath.Join(os.TempDir(), "salam_jpeg_save_test")
    os.MkdirAll(dir)
    path := filepath.Join(dir, "out.jpg")

    opts := image.JPEGOptions { quality = 95, subsample = false, comment = "saved" }
    println "saved: ", image.SaveJPEGOptions(img, path, opts)
    println "size positive: ", os.FileSize(path) > 0

    mut ok := false
    back := image.Open(path, ok)
    println "reopened: ", ok
    println "dimensions: ", back.width, "x", back.height
    println "close to original: ", image.MeanAbsError(img, back) < 8.0

    println "unwritable: ", image.SaveJPEGOptions(img, filepath.Join(dir, "no/such/dir/out.jpg"), opts)

    image.Free(back)
    image.Free(img)
    os.RemoveAll(dir)
end
