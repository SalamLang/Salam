package main

import os
import io
import str

func main:
    path := "io_example_out.txt"
    io.WriteFile(path, "the quick brown fox\njumps over\nthe lazy dog\n")
    text := io.ReadFile(path)
    lines := str.Split(str.Trim(text), "\n")
    defer lines.Free()
    println "read lines:"
    println str.Join(lines, " | ")
    words := str.Split(lines.get(0), " ")
    defer words.Free()
    print "first line has "
    print str.FromInt(words.Len() as i64)
    println " words"
    a := os.Args()
    defer a.Free()
    print "called with "
    print str.FromInt((a.Len() - 1) as i64)
    println " argument(s)"
    mut i := 1
    until i < a.Len():
        println a.get(i)
        i++
    end
    os.Remove(path)
end
