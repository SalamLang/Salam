package main

import io
import os
import filepath
import mem
import str

func main:
    dir := os.TempDir()
    path := filepath.Join(dir, "salam_io_extra.txt")
    defer mem.Free(path as void*)

    println "writing lines"
    mut lines := Vector {} as Vector<str>
    defer lines.free()
    lines.push("alpha")
    lines.push("beta")
    lines.push("gamma")
    println io.WriteLines(path, lines)
    println io.ReadFile(path) == "alpha\nbeta\ngamma\n"
    mut none := Vector {} as Vector<str>
    defer none.free()
    println io.WriteLines(path, none)
    println str.Len(io.ReadFile(path))
    println io.WriteLines(filepath.Join(dir, "salam_io_missing_dir/x.txt"), lines)

    println "reading lines and seeking"
    io.WriteLines(path, lines)
    f := os.Open(path, "rb")
    println io.Readline(f)
    println io.Readline(f)
    println io.Seek(f, 0, 0)
    println io.Readline(f)
    println io.Seek(f, 6, 0)
    println io.Read(f, 4 as u64)
    println io.Seek(f, 0 - 6, 2)
    println io.Readline(f)
    println io.Seek(f, 0, 0)
    println io.Seek(f, 2, 1)
    println io.Read(f, 3 as u64)
    io.Close(f)

    println "standard error"
    io.EPrint("warning: ")
    io.EPrint("")
    io.EPrintln("this goes to stderr")
    println "stdout stays clean"
    os.Remove(path)
end
