import io
import os

func show(label: str, path: str, text: str):
    io.WriteFile(path, text)
    lines := io.Lines(path)
    defer lines.Free()
    println label, lines.Len()
    repeat lines.Len() in i:
        println "[" + lines.Get(i) + "]"
    end
    os.Remove(path)
end

func main:
    p := "_io_lines_exact.txt"
    show("mixed", p, "\n  indented\nlast  \n\n")
    show("empty", p, "")
    show("one", p, "solo")
    show("trailing", p, "a\nb\n")
    show("crlf", p, "a\r\nb\r\n")
    missing := io.Lines("_io_lines_missing.txt")
    defer missing.Free()
    println "missing", missing.Len()
end
