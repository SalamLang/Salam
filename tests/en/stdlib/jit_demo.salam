import os.dl
import os.mmap

func code(): int[29]:
    ret [0x48, 0x89, 0xf8, 0x48, 0x01, 0xf0, 0x48, 0x01, 0xd0, 0x48, 0x01, 0xc8, 0x4c, 0x01, 0xc0, 0x4c, 0x01, 0xc8, 0x48, 0x03, 0x44, 0x24, 0x08, 0x48, 0x03, 0x44, 0x24, 0x10, 0xc3]
end

func main:
    println "protections", mmap.PROT_NONE, mmap.PROT_READ, mmap.PROT_WRITE, mmap.PROT_EXEC
    println "page size is a power of two:", mmap.PageSize() >= 4096 and (mmap.PageSize() & (mmap.PageSize() - 1)) == 0

    println "supported:", dl.Supported(), mmap.Supported()
    if not dl.Supported():
        ret
    end

    lib := dl.OpenSelf()
    println "self:", lib != null
    println "strlen:", dl.Sym(lib, "strlen") != null, "nothing:", dl.Sym(lib, "salam_no_such_symbol") == null
    s := "hello, world"
    println dl.Call(dl.Sym(lib, "strlen"), [(s as void*) as size])
    println dl.Call(dl.Sym(lib, "labs"), [(0 - 42) as size])
    println dl.Call(dl.Sym(lib, "strcmp"), [(s as void*) as size, (s as void*) as size])
    println dl.Call(null, [1 as size])
    none := [0 as size]
    println dl.Call(dl.Sym(lib, "getpid"), none[: 0]) > 0
    println dl.Close(lib)

    missing := dl.Open("libsalam-no-such-library.so.1")
    println "missing library:", missing == null, dl.Error().Len() > 0

    if SALAM_ARCH_X64:
        page := mmap.PageSize()
        mem1 := mmap.Alloc(page, mmap.PROT_READ | mmap.PROT_WRITE)
        println "mapped:", mem1 != null
        bytes := mem1 as u8*
        c := code()
        repeat 29 in i:
            bytes[i] = c[i] as u8
        end
        println "protect:", mmap.Protect(mem1, page, mmap.PROT_READ | mmap.PROT_EXEC)
        println "sum of eight arguments:", dl.Call(mem1, [1 as size, 2, 3, 4, 5, 6, 7, 8])
        println "free:", mmap.Free(mem1, page)
        println "zero size:", mmap.Alloc(0, mmap.PROT_READ) == null, mmap.Free(null, page)
    else:
        println "jit skipped"
    end
end
