import str
import encoding.json

func deep(n: int, open: str, close: str): str:
    mut sb := str.NewBuilder()
    repeat n:
        str.BufAppend(sb, open)
    end
    str.BufAppend(sb, "1")
    repeat n:
        str.BufAppend(sb, close)
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func main:
    println json.Valid(deep(100, "[", "]"))
    println json.Valid(deep(600, "[", "]"))
    println json.Valid(deep(1000000, "[", ""))
    println json.Has("{\"a\":" + deep(600, "[", "]") + "}", "a")
    println json.Has("{\"a\":" + deep(100, "[", "]") + "}", "a")
    println json.Indent(deep(1000000, "[", "")).Len() > 0
    println json.GetInt("{\"a\":123}", "a")
    println json.GetInt("{\"a\":-45}", "a")
    println json.GetInt("{\"a\":4294967296}", "a")
    println json.GetInt("{\"a\":-99999999999}", "a")
    println json.GetInt("{\"a\":2147483647}", "a")
    println json.GetInt("{\"a\":1.5}", "a")
end
