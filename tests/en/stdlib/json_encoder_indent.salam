package main

import encoding.json
import encoding.value

struct Point:
    pub x: int = 0
    pub y: int = 0
end

func main:
    mut arr := value.NewValueArray()
    value.ArrayPush(arr, value.ValueInt(1 as i64))
    value.ArrayPush(arr, value.ValueString("two"))
    mut enc := json.NewBufEncoderIndent("  ")
    enc.Encode(arr)
    println enc.String()
    mut flat := json.NewBufEncoder()
    flat.Encode(arr)
    println flat.String()
    mut tabs := json.NewBufEncoderIndent("\t")
    tabs.Encode(arr)
    println tabs.String().len() > flat.String().len()

    envelope := json.SchemaEnvelope(Point {})
    println json.SchemaMerge(envelope) == json.Schema(Point {})
    println json.SchemaMerge("{}")
    println json.Schema(Point {}).len() > 40
end
