package main

import encoding.json
import encoding.value
import encoding.msgpack
import encoding.envfile
import encoding.serde
import compress
import testing
import mem

struct Point:
    pub x: int = 0
    pub y: int = 0
end

struct Floats:
    pub a: f64 = 0.0
    pub b: f64 = 0.0
    pub c: f64 = 0.0
end

struct Chain:
    pub id: int = 0
    pub next: Chain* = null
end

func show(label: str, e: Error):
    mut line := label + ": " + e.kind_name() + " | " + e.to_str()
    if e.code != "":
        line = line + " [" + e.code + "]"
    end
    println line
end

func decode(label: str, text: str):
    try:
        v := json.Decode(text)
        println label + ": ok " + json.EncodeDefault(v)
        value.ValueFree(v)
    catch e:
        show(label, e)
    end
end

func unmarshal(label: str, text: str):
    mut p := Point {}
    try:
        json.Unmarshal(text, p)
        println label + ": ok " + json.Marshal(p)
    catch e:
        show(label, e)
    end
end

func unmarshal_lenient(label: str, text: str):
    mut p := Point {}
    try:
        json.UnmarshalLenient(text, p)
        println label + ": ok " + json.Marshal(p)
    catch e:
        show(label, e)
    end
end

func nested(depth: int): str:
    mut out := ""
    repeat depth:
        out = out.concat("[")
    end
    repeat depth:
        out = out.concat("]")
    end
    ret out
end

func dynamic_errors():
    println "== json.Decode =="
    decode("valid", `{"x":1,"y":[true,null]}`)
    decode("empty input", ``)
    decode("truncated array", `[1,2`)
    decode("truncated object", `{"a": 1,`)
    decode("missing value", `{"a": }`)
    decode("bad token", "{\n  \"a\": 1,\n  \"b\": tru\n}")
    decode("bad key", "[1,\n {x: 2}]")
    decode("trailing data", `{} {}`)
    decode("too deep", nested(600))
    try:
        v := json.Decode(nested(500))
        println "500 levels: ok, " + json.EncodeDefault(v).len() + " bytes"
        value.ValueFree(v)
    catch e:
        show("500 levels", e)
    end
end

func typed_errors():
    println ""
    println "== json.Unmarshal =="
    unmarshal("valid", `{"x":1,"y":2}`)
    unmarshal("type mismatch", `{"x":"1","y":2}`)
    unmarshal("missing key", `{"x":1}`)
    unmarshal("unknown key", `{"x":1,"y":2,"z":3}`)
    unmarshal("duplicate key", `{"x":1,"x":2,"y":3}`)
    unmarshal("truncated", `{"x":1,`)
    unmarshal("trailing data", `{"x":1,"y":2} tail`)
    unmarshal("not an object", `[1,2]`)
    unmarshal_lenient("lenient extra keys", `{"x":1,"x":2,"z":9}`)
    unmarshal_lenient("lenient truncated", `{"x":`)
end

func accessor_errors() throws:
    println ""
    println "== value accessors =="
    doc := try json.Decode(`{"name": "salam", "version": 6, "tags": ["a", "b"], "ok": true}`)
    defer value.ValueFree(doc)
    name := try doc.field("name")
    println "name: " + (try name.str())
    version := try doc.field("version")
    println "version: " + (try version.int())
    tags := try doc.field("tags")
    second := try tags.at(1)
    println "second tag: " + (try second.str())
    try:
        name.int()
    catch e:
        show("int of a string", e)
    end
    try:
        doc.field("license")
    catch e:
        show("missing key", e)
    end
    try:
        tags.at(5)
    catch e:
        show("index out of range", e)
    end
    try:
        tags.field("a")
    catch e:
        show("key of an array", e)
    end
    try:
        version.bool()
    catch e:
        show("bool of an int", e)
    end
    fallback := try doc.field("port") catch value.ValueInt(8080 as i64)
    println "port with a fallback: " + value.AsInt(fallback)
    parsed := try json.Decode(`{"broken"`) catch value.NewValueObject()
    println "fallback document keys: " + value.ObjectLen(parsed)
    value.ValueFree(fallback)
    value.ValueFree(parsed)
end

func stream_errors():
    println ""
    println "== JSONDecoder =="
    mut d := json.NewBufDecoder("{\"a\": 1}\n{\"b\": 2}\n{\"c\": }\n{\"d\": 4}")
    until d.More():
        try:
            v := d.Decode()
            println "document: " + json.EncodeDefault(v)
            value.ValueFree(v)
        catch e:
            show("bad document", e)
            break
        end
    end
end

func other_formats():
    println ""
    println "== other formats =="
    mut buf := compress.NewByteBuf()
    compress.BufPush(buf, 0x93)
    compress.BufPush(buf, 1)
    compress.BufPush(buf, 2)
    try:
        msgpack.Unmarshal(buf)
    catch e:
        show("msgpack truncated", e)
    end
    compress.BufFree(buf)

    try:
        mut doc := envfile.ParseStrict("A=1\nB=\"open\nC=3\n")
        envfile.Free(doc)
    catch e:
        show("envfile unterminated quote", e)
    end

    try:
        serde.TranscodeStrict(`{"a":1}`, "json", "nope")
    catch e:
        show("serde unknown format", e)
    end
end

func encoder_edges() throws:
    inf := 1.0 / 0.0
    f := Floats { a = 0.0 - inf, b = inf, c = 0.5 }
    text := json.Marshal(f)
    testing.AssertEqStr(text, `{"a":null,"b":null,"c":0.5}`)
    testing.AssertTrue(json.Valid(text))
    testing.AssertFalse(json.Valid(`{"a":}`))

    testing.AssertEqStr(json.Marshal(Chain { id = 3 }), `{"id":3,"next":null}`)
    cell := mem.Allocate(64 as u64)
    defer mem.Free(cell)
    tail := cell as Chain*
    tail[0] = Chain { id = 2, next = null }
    head := Chain { id = 1, next = tail }
    testing.AssertEqStr(json.Marshal(head), `{"id":1,"next":{"id":2,"next":null}}`)

    raw := "tab\there \"quoted\" \\ back"
    enc := json.Marshal(raw)
    testing.AssertTrue(json.Valid(enc))
    mut got := ""
    try json.Unmarshal(enc, got)
    testing.AssertEqStr(got, raw)

    v := try json.Decode(enc)
    testing.AssertEqStr(try v.str(), raw)
    value.ValueFree(v)
end

func main:
    dynamic_errors()
    typed_errors()
    try:
        accessor_errors()
    catch e:
        testing.AssertMsg(false, e.to_str())
    end
    stream_errors()
    other_formats()
    try:
        encoder_edges()
    catch e:
        testing.AssertMsg(false, e.to_str())
    end
    ret testing.Summary()
end
