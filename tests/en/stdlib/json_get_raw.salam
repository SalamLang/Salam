package main

import encoding.json

func main:
    text := "{\"name\":\"a \\\"b\\\"\",\"n\":7,\"list\":[1,\"x\"],\"o\":{\"k\":true}}"
    println json.GetRaw(text, "name")
    println json.GetRaw(text, "n")
    println json.GetRaw(text, "list")
    println json.GetRaw(text, "o")
    println json.GetRaw(text, "missing").Len()
    println json.Get(text, "name")
end
