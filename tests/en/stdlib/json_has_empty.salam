package main

import encoding.json

func main:
    text := "{\"a\":\"\",\"b\":\"x\",\"c\":null,\"d\":0,\"e\":false,\"f\":{},\"g\":[],\"o\":{\"inner\":1},\"s\":\"missing\"}"
    each key in ["a", "b", "c", "d", "e", "f", "g", "o", "s", "inner", "missing", ""]:
        println "[" + key + "]", json.Has(text, key)
    end
    println json.Has("", "a")
    println json.Has("[\"a\"]", "a")
    println json.Has("{\"a\"}", "a")
    println "[" + json.GetRaw(text, "a") + "]", json.Get(text, "a").Len()
    println json.GetPath(text, "o.inner")
end
