import encoding.json

func main:
    t := `{"hits":{"total":{"value":42,"relation":"eq"},"hits":[{"_id":"a","_source":{"z":1,"a":"x\"y"}},{"_id":"b","sort":[3,"q"]}]},"k.dot":1}`
    println json.GetPath(t, "hits.total.value")
    println json.GetPath(t, "hits.total.relation")
    println json.GetPath(t, "hits.hits.0._source")
    println json.GetPath(t, "hits.hits.0._source.a")
    println json.GetPath(t, "hits.hits.1.sort.1")
    println json.GetPath(t, "hits.hits.2")
    println json.GetPath(t, "nope.x")
    each it in json.Items(json.GetPath(t, "hits.hits")):
        println it
    end
    println json.Items("[]").len(), json.Items(" [ 1 , [2,3] , \"s\" ] ").len()
    println json.Unquote("\"a\\nb\""), json.Unquote("12")
end
