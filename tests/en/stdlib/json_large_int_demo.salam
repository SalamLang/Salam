package main

import encoding.json
import encoding.value
import encoding.encerr

func field(text: str, key: str): value.Value:
    mut err := encerr.EncodingError {}
    v := json.Decode(text, err)
    ret value.ObjectGet(v, key)
end

func main:
    doc := `{"ms": 1792113284491, "neg": -1792113284491, "max": 9223372036854775807, "min": -9223372036854775808, "small": 42, "huge": 92233720368547758070}`
    println value.AsInt(field(doc, "ms"))
    println value.AsInt(field(doc, "neg"))
    println value.AsInt(field(doc, "max"))
    println value.AsInt(field(doc, "min"))
    println value.AsInt(field(doc, "small"))
    huge := field(doc, "huge")
    println value.IsNumber(huge), huge.kind == value.KindFloat
    println field(doc, "max").kind == value.KindInt, field(doc, "min").kind == value.KindInt
    edge := `{"under": -9223372036854775809, "over": 9223372036854775808, "near": -9223372036854775800}`
    println field(edge, "under").kind == value.KindFloat, field(edge, "over").kind == value.KindFloat
    println field(edge, "near").kind == value.KindInt, value.AsInt(field(edge, "near"))
end
