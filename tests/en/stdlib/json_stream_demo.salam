package main

import encoding.json
import encoding.value
import testing
import fs
import fs.path
import os

func main:
    mut enc := json.NewBufEncoder()
    enc.Encode(value.ValueInt(1 as i64))
    enc.Encode(value.ValueString("two"))
    mut arr := value.NewValueArray()
    value.ArrayPush(arr, value.ValueInt(3 as i64))
    enc.Encode(arr)
    out := enc.String()
    testing.AssertTrue(out.len() > 0)

    mut dec := json.NewBufDecoder(out)
    mut count := 0
    mut lastWasArray := false
    until dec.More():
        v := try dec.Decode() catch value.ValueNull()
        lastWasArray = value.IsArray(v)
        count++
    end
    testing.AssertEqInt(count, 3)
    testing.AssertTrue(lastWasArray)
    testing.AssertFalse(dec.bad)

    p := path.Join(os.TempDir(), "salam_json_stream_test.ndjson")
    os.Remove(p)
    wf := fs.Open(p, "wb")
    mut fenc := json.NewEncoder(wf)
    fenc.Encode(value.ValueInt(10 as i64))
    fenc.Encode(value.ValueInt(20 as i64))
    fenc.Close()

    rf := fs.Open(p, "rb")
    mut fdec := json.NewDecoder(rf)
    mut fcount := 0
    mut sum := 0 as i64
    until fdec.More():
        v := try fdec.Decode() catch value.ValueNull()
        sum += value.AsInt(v)
        fcount++
    end
    testing.AssertEqInt(fcount, 2)
    testing.AssertEqInt64(sum, 30 as i64)
    fs.Close(rf)
    os.Remove(p)

    ret testing.Summary()
end
