package main

import encoding.json
import encoding.value
import testing
import str

func checks() throws:
    mut members := Vector {} as Vector<str>
    members.push(json.Member("name", "salam"))
    members.push(json.MemberInt("version", 2 as i64))
    members.push(json.MemberBool("active", true))
    members.push(json.MemberFloat("pi", 3.5))
    mut tagItems := Vector {} as Vector<str>
    tagItems.push(json.Str("a"))
    tagItems.push(json.Str("b"))
    members.push(json.MemberRaw("tags", json.Array(tagItems)))
    jsonText := json.Object(members)

    v := try json.Decode(jsonText)
    testing.AssertEqStr(value.AsString(value.ObjectGet(v, "name")), "salam")
    testing.AssertEqInt64(value.AsInt(value.ObjectGet(v, "version")), 2 as i64)
    testing.AssertTrue(value.AsBool(value.ObjectGet(v, "active")))
    testing.AssertEqFloat(value.AsFloat(value.ObjectGet(v, "pi")), 3.5, 0.0001)
    tags := value.ObjectGet(v, "tags")
    testing.AssertEqInt(value.ArrayLen(tags), 2)
    testing.AssertEqStr(value.AsString(value.ArrayGet(tags, 0)), "a")

    vNull := try json.Decode(`{"nothing": null}`)
    testing.AssertTrue(value.IsNull(value.ObjectGet(vNull, "nothing")))
    value.ObjectSet(v, "nothing", value.ValueNull())
    value.ValueFree(vNull)

    compact := json.EncodeDefault(v)
    v2 := try json.Decode(compact)
    testing.AssertTrue(value.Equal(v, v2))

    minified := json.Minify(jsonText)
    vMin := try json.Decode(minified)
    prettyA := json.Encode(vMin, json.JSONOptions { indent = "  " })
    prettyB := json.Indent(minified)
    testing.AssertTrue(str.Contains(prettyA, "\n"))
    vPA := try json.Decode(prettyA)
    vPB := try json.Decode(prettyB)
    testing.AssertTrue(value.Equal(vPA, vPB))
    value.ValueFree(vPA)
    value.ValueFree(vPB)

    noNull := json.Encode(v, json.JSONOptions { ignore_null = true })
    testing.AssertFalse(str.Contains(noNull, "nothing"))
    withNull := json.Encode(v, json.JSONOptions {})
    testing.AssertTrue(str.Contains(withNull, "nothing"))

    mut obj := value.NewValueObject()
    value.ObjectSet(obj, "z", value.ValueInt(1 as i64))
    value.ObjectSet(obj, "a", value.ValueInt(2 as i64))
    sorted := json.Encode(obj, json.JSONOptions { sort_keys = true })
    testing.AssertTrue(str.IndexOf(sorted, "a") < str.IndexOf(sorted, "z"))

    vEsc := try json.Decode("\"hi \\\"there\\\"\\n\"")
    testing.AssertEqStr(value.AsString(vEsc), "hi \"there\"\n")

    mut bad := false
    try:
        json.Decode(`{"a": }`)
    catch e:
        bad = e.is(ErrorKind.Syntax)
    end
    testing.AssertTrue(bad)

    value.ValueFree(v)
    value.ValueFree(v2)
    value.ValueFree(vMin)
    value.ValueFree(obj)
    value.ValueFree(vEsc)
end

func main:
    try:
        checks()
    catch e:
        testing.AssertMsg(false, e.to_str())
    end
    ret testing.Summary()
end
