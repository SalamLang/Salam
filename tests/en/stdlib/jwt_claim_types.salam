package main

import jwt

const SECRET := "claim-types-secret-kept-on-the-server"

func signed(payload_json: str): str:
    si := jwt.B64UrlEncode(`{"alg":"HS256","typ":"JWT"}`) + "." + jwt.B64UrlEncode(payload_json)
    ret si + "." + jwt.SignatureOf(si, jwt.JWT_HS256, SECRET)
end

func check(label: str, payload_json: str):
    mut o := jwt.DefaultOptions()
    o.now = 1700000000 as i64
    try:
        t := jwt.Verify(signed(payload_json), SECRET, o)
        println label + ": accepted valid=" + t.valid
    catch e:
        println label + ": rejected " + e.code + " path=" + e.path
    end
end

func main():
    check("numeric exp in the future", `{"exp":1700000600}`)
    check("numeric exp in the past", `{"exp":1}`)
    check("string exp", `{"exp":"1"}`)
    check("string exp in the future", `{"exp":"1700000600"}`)
    check("boolean exp", `{"exp":true}`)
    check("null exp", `{"exp":null}`)
    check("object exp", `{"exp":{}}`)
    check("string nbf", `{"nbf":"1"}`)
    check("string iat", `{"iat":"1"}`)
    check("no time claims", `{"sub":"u"}`)
    println "empty secret: " + jwt.IsValid(signed(`{"sub":"u"}`), "", jwt.DefaultOptions())
end
