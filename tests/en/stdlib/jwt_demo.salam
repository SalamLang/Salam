package main

// std/jwt end to end, including the HTTP-facing parts that can be tested
// without a live request.
//
// The signing tests pin whole tokens, not just "it round-trips". A JWS is
// only worth anything if another implementation agrees byte for byte, so the
// expected strings here were produced independently (PyJWT / hmac+base64url)
// and the canonical jwt.io HS256 token is verified as-is. A round-trip test
// alone would pass just as happily with two matching bugs.
//
// Every rejection path gets its own case, because a verifier that returns
// "invalid" for the wrong reason is a verifier that will one day return
// "valid" for the wrong reason.

import jwt
import crypto
import testing

const SECRET := "your-256-bit-secret"

// A fixed clock, so exp/nbf/iat cases are not a function of when the suite runs.
const NOW := 1600000000

func fixed_opts(): jwt.Options:
    mut o := jwt.DefaultOptions()
    o.now = NOW as i64
    ret o
end

// ---------------------------------------------------------------- base64url

func test_b64url():
    testing.AssertEqStr(jwt.B64UrlEncode(""), "")
    testing.AssertEqStr(jwt.B64UrlEncode("f"), "Zg")
    testing.AssertEqStr(jwt.B64UrlEncode("fo"), "Zm8")
    testing.AssertEqStr(jwt.B64UrlEncode("foo"), "Zm9v")
    testing.AssertEqStr(jwt.B64UrlEncode("foobar"), "Zm9vYmFy")
    // the two bytes that differ from standard base64: 0xFB 0xFF -> "+/" -> "-_"
    testing.AssertEqStr(jwt.B64UrlEncode(`{"alg":"HS256","typ":"JWT"}`), "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9")
    mut ok := false
    testing.AssertEqStr(jwt.B64UrlDecode("Zm9vYmFy", ok), "foobar")
    testing.AssertTrue(ok)
    testing.AssertEqStr(jwt.B64UrlDecode("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9", ok), `{"alg":"HS256","typ":"JWT"}`)
    testing.AssertTrue(ok)
    // padded, standard-alphabet and whitespace-carrying input is NOT base64url
    _r1 := jwt.B64UrlDecode("Zm9vYmFy=", ok)
    testing.AssertFalse(ok)
    _r2 := jwt.B64UrlDecode("ab+c", ok)
    testing.AssertFalse(ok)
    _r3 := jwt.B64UrlDecode("ab/c", ok)
    testing.AssertFalse(ok)
    _r4 := jwt.B64UrlDecode("Zm9v YmFy", ok)
    testing.AssertFalse(ok)
    // a lone trailing character cannot be a quantum
    _r5 := jwt.B64UrlDecode("Zm9vY", ok)
    testing.AssertFalse(ok)
end

// ---------------------------------------------------------------- claims

func test_claims_json():
    mut c := jwt.NewClaims()
    testing.AssertEqStr(jwt.ClaimsJSON(c), "{}")
    c.iss = "api.example.com"
    c.sub = "user-42"
    c.aud = "web"
    c.exp = 2000000000 as i64
    c.iat = 1000000000 as i64
    c.jti = "abc"
    jwt.SetStr(c, "role", "admin")
    jwt.SetBool(c, "mfa", true)
    jwt.SetInt(c, "level", 7 as i64)
    jwt.SetRaw(c, "scopes", `["read","write"]`)
    // registered claims first, in a fixed order, then custom ones as added
    testing.AssertEqStr(jwt.ClaimsJSON(c), `{"iss":"api.example.com","sub":"user-42","aud":"web","exp":2000000000,"iat":1000000000,"jti":"abc","role":"admin","mfa":true,"level":7,"scopes":["read","write"]}`)
end

func test_claims_registered_routing():
    // Set* with a registered name must land in the field, not append a
    // second copy of the key
    mut c := jwt.NewClaims()
    jwt.SetStr(c, "iss", "me")
    jwt.SetStr(c, "sub", "you")
    jwt.SetStr(c, "jti", "id")
    jwt.SetInt(c, "exp", 5 as i64)
    jwt.SetInt(c, "nbf", 4 as i64)
    jwt.SetInt(c, "iat", 3 as i64)
    testing.AssertEqStr(c.iss, "me")
    testing.AssertEqStr(c.sub, "you")
    testing.AssertEqStr(c.jti, "id")
    testing.AssertEqInt64(c.exp, 5 as i64)
    testing.AssertEqInt64(c.nbf, 4 as i64)
    testing.AssertEqInt64(c.iat, 3 as i64)
    testing.AssertEqStr(c.extra, "")
    testing.AssertEqStr(jwt.ClaimsJSON(c), `{"iss":"me","sub":"you","exp":5,"nbf":4,"iat":3,"jti":"id"}`)
end

func test_claims_escaping():
    mut c := jwt.NewClaims()
    jwt.SetStr(c, "name", `Ali "MAX" Base`)
    jwt.SetStr(c, "path", "C:\\tmp")
    jwt.SetStr(c, "lines", "a\nb")
    testing.AssertEqStr(jwt.ClaimsJSON(c), `{"name":"Ali \"MAX\" Base","path":"C:\\tmp","lines":"a\nb"}`)
end

// ---------------------------------------------------------------- signing

func test_sign_known_tokens():
    mut c := jwt.NewClaims()
    c.sub = "1234567890"
    jwt.SetStr(c, "name", "John Doe")
    jwt.SetInt(c, "iat", 1516239022 as i64)
    mut err := 0
    hs256 := jwt.SignHS256(c, SECRET, err)
    testing.AssertEqInt(err, JWT_OK_CODE())
    testing.AssertEqStr(hs256, "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwiaWF0IjoxNTE2MjM5MDIyLCJuYW1lIjoiSm9obiBEb2UifQ.LWG7yvgEiiKDUA2PmykvKGKMedYPyLWsLCcJR5pn-Kw")
    hs384 := jwt.SignHS384(c, SECRET, err)
    testing.AssertEqStr(hs384, "eyJhbGciOiJIUzM4NCIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwiaWF0IjoxNTE2MjM5MDIyLCJuYW1lIjoiSm9obiBEb2UifQ.oBbeSMWfiX9tiMhNSJeMDGXOJr7Ihg49HtLqx2VolvLx0AAyuFh_MeRgQ3IoGV9f")
    hs512 := jwt.SignHS512(c, SECRET, err)
    testing.AssertEqStr(hs512, "eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwiaWF0IjoxNTE2MjM5MDIyLCJuYW1lIjoiSm9obiBEb2UifQ.f1qJgj7FVIk1ATQPEgLgF913j9XQB7JBHJdU5QVNM0dPDNIzyOw73y2tCg0rWNkwU2T_j4tPrq35NMdZDh7AQQ")
    // a "kid" goes in the header, and changes it
    kidded := jwt.SignWithKid(c, jwt.JWT_HS256, "key-1", SECRET, err)
    mut e2 := 0
    t := jwt.Decode(kidded, e2)
    testing.AssertEqStr(t.kid, "key-1")
    testing.AssertEqStr(t.header_json, `{"alg":"HS256","typ":"JWT","kid":"key-1"}`)
end

func test_sign_rejects():
    mut c := jwt.NewClaims()
    c.sub = "x"
    mut err := 0
    testing.AssertEqStr(jwt.Sign(c, "RS256", SECRET, err), "")
    testing.AssertEqInt(err, jwt.JWT_ERR_ALG_UNSUPPORTED)
    testing.AssertEqStr(jwt.Sign(c, "none", SECRET, err), "")
    testing.AssertEqInt(err, jwt.JWT_ERR_ALG_UNSUPPORTED)
    // an empty secret would produce a token anyone can forge
    testing.AssertEqStr(jwt.SignHS256(c, "", err), "")
    testing.AssertEqInt(err, jwt.JWT_ERR_EMPTY_SECRET)
end

// ---------------------------------------------------------------- verifying

func test_verify_canonical():
    // The jwt.io sample token, signed elsewhere with the same secret.
    io := "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
    mut err := 0
    t := jwt.Verify(io, SECRET, fixed_opts(), err)
    testing.AssertEqInt(err, JWT_OK_CODE())
    testing.AssertTrue(t.valid)
    testing.AssertEqStr(t.alg, "HS256")
    testing.AssertEqStr(t.typ, "JWT")
    testing.AssertEqStr(t.claims.sub, "1234567890")
    testing.AssertEqInt64(t.claims.iat, 1516239022 as i64)
    testing.AssertEqStr(jwt.Str(t, "name"), "John Doe")
end

func test_verify_round_trip():
    mut c := jwt.NewClaims()
    c.iss = "api.example.com"
    c.sub = "user-42"
    c.aud = "web"
    c.exp = 2000000000 as i64
    jwt.SetStr(c, "role", "admin")
    jwt.SetBool(c, "mfa", true)
    jwt.SetInt(c, "level", 7 as i64)
    jwt.SetRaw(c, "scopes", `["read","write"]`)
    mut err := 0
    tok := jwt.SignHS256(c, SECRET, err)
    mut o := fixed_opts()
    o.issuer = "api.example.com"
    o.audience = "web"
    o.require_exp = true
    mut verr := 0
    t := jwt.Verify(tok, SECRET, o, verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
    testing.AssertTrue(t.valid)
    testing.AssertEqStr(jwt.Str(t, "role"), "admin")
    testing.AssertTrue(jwt.Bool(t, "mfa"))
    testing.AssertEqInt64(jwt.Int(t, "level"), 7 as i64)
    testing.AssertEqStr(jwt.Raw(t, "scopes"), `["read","write"]`)
    testing.AssertTrue(jwt.ListHas(t, "scopes", "write"))
    testing.AssertFalse(jwt.ListHas(t, "scopes", "delete"))
    testing.AssertTrue(jwt.Has(t, "role"))
    testing.AssertFalse(jwt.Has(t, "nope"))
    testing.AssertEqStr(jwt.Str(t, "nope"), "")
    testing.AssertEqInt64(jwt.Int(t, "nope"), 0 as i64)
    testing.AssertFalse(jwt.Bool(t, "nope"))
    // a claim that is an object comes back only as raw text
    testing.AssertEqStr(jwt.Str(t, "scopes"), "")
end

func test_verify_signature_failures():
    mut c := jwt.NewClaims()
    c.sub = "user-42"
    c.exp = 2000000000 as i64
    mut err := 0
    tok := jwt.SignHS256(c, SECRET, err)
    mut verr := 0
    // wrong key
    _t1 := jwt.Verify(tok, "not-the-secret", fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_SIGNATURE)
    // flipped last character of the signature
    mut tampered := tok.substr(0, tok.len() - 1)
    if tok.substr(tok.len() - 1, 1) == "A":
        tampered = tampered.concat("B")
    else:
        tampered = tampered.concat("A")
    end
    t2 := jwt.Verify(tampered, SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_SIGNATURE)
    testing.AssertFalse(t2.valid)
    // an empty secret can never verify anything
    _t3 := jwt.Verify(tok, "", fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_EMPTY_SECRET)
end

func test_verify_alg_attacks():
    mut verr := 0
    // "alg": "none" with an empty signature - the classic forgery
    none_tok := "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhZG1pbiJ9."
    t := jwt.Verify(none_tok, SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_ALG_UNSUPPORTED)
    testing.AssertFalse(t.valid)
    // an algorithm this build does not implement is refused, never guessed at
    rs_tok := "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiJ9.aaaa"
    _t2 := jwt.Verify(rs_tok, SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_ALG_UNSUPPORTED)
    // a real HS512 token offered to an HS256 verifier: the header does not
    // get to choose the algorithm
    mut c := jwt.NewClaims()
    c.sub = "user-42"
    c.exp = 2000000000 as i64
    mut err := 0
    tok512 := jwt.SignHS512(c, SECRET, err)
    _t3 := jwt.Verify(tok512, SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_ALG_MISMATCH)
    // ... and it verifies when the verifier is the one that asked for HS512
    mut o := jwt.OptionsFor(jwt.JWT_HS512)
    o.now = NOW as i64
    t4 := jwt.Verify(tok512, SECRET, o, verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
    testing.AssertTrue(t4.valid)
end

func test_verify_malformed():
    mut verr := 0
    _t1 := jwt.Verify("", SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_MALFORMED)
    _t2 := jwt.Verify("abc", SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_MALFORMED)
    _t3 := jwt.Verify("a.b", SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_MALFORMED)
    _t4 := jwt.Verify("a.b.c.d", SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_MALFORMED)
    _t5 := jwt.Verify(".b.c", SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_MALFORMED)
    // valid shape, but the header segment is not base64url
    _t6 := jwt.Verify("a+b.eyJzdWIiOiJ4In0.sig", SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_BAD_BASE64)
    // decodes, but the header is not a JSON object with an alg
    _t7 := jwt.Verify("eyJ4IjoxfQ.eyJzdWIiOiJ4In0.sig", SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_BAD_JSON)
end

func test_header_policy():
    mut verr := 0
    payload := jwt.B64UrlEncode(`{"sub":"x"}`)
    // "typ" is optional, and an OAuth2 access token spells it "at+jwt"
    testing.AssertTrue(signed_with_header(`{"alg":"HS256","typ":"at+jwt"}`, payload, verr))
    testing.AssertEqInt(verr, JWT_OK_CODE())
    testing.AssertTrue(signed_with_header(`{"alg":"HS256"}`, payload, verr))
    testing.AssertEqInt(verr, JWT_OK_CODE())
    testing.AssertTrue(signed_with_header(`{"alg":"HS256","typ":"jwt"}`, payload, verr))
    testing.AssertEqInt(verr, JWT_OK_CODE())
    // a JWE, or anything else pretending to be one of ours
    _bad := signed_with_header(`{"alg":"HS256","typ":"JOSE"}`, payload, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_TYPE)
    // "crit" names extensions a verifier must understand; this one
    // understands none, so it must refuse rather than ignore them
    _crit := signed_with_header(`{"alg":"HS256","typ":"JWT","crit":["exp"]}`, payload, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_ALG_UNSUPPORTED)
    // a claim carried twice is ambiguous, and two services reading the same
    // token would not have to agree on which copy wins
    _dup := signed_with_header(`{"alg":"HS256","typ":"JWT"}`, jwt.B64UrlEncode(`{"sub":"admin","sub":"guest"}`), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_BAD_JSON)
    _dup2 := signed_with_header(`{"alg":"HS256","typ":"JWT"}`, jwt.B64UrlEncode(`{"exp":9999999999,"exp":1}`), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_BAD_JSON)
    // a duplicated claim this package does not act on is the caller's problem
    testing.AssertTrue(signed_with_header(`{"alg":"HS256","typ":"JWT"}`, jwt.B64UrlEncode(`{"sub":"x","note":"a","note":"b"}`), verr))
    testing.AssertEqInt(verr, JWT_OK_CODE())
end

// Sign an arbitrary header + payload the way the package would, so header
// policy can be tested without a hand-computed signature.
func signed_with_header(header_json: str, payload_b64: str, err &: int): bool:
    si := jwt.B64UrlEncode(header_json).concat(".").concat(payload_b64)
    tok := si.concat(".").concat(jwt.SignatureOf(si, jwt.JWT_HS256, SECRET))
    mut o := fixed_opts()
    o.require_exp = false
    t := jwt.Verify(tok, SECRET, o, err)
    ret t.valid
end

func test_verify_time():
    mut c := jwt.NewClaims()
    c.sub = "user-42"
    c.exp = (NOW + 100) as i64
    c.nbf = (NOW - 100) as i64
    c.iat = (NOW - 100) as i64
    mut err := 0
    tok := jwt.SignHS256(c, SECRET, err)
    mut verr := 0
    _t0 := jwt.Verify(tok, SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
    // expired
    mut late := fixed_opts()
    late.now = (NOW + 101) as i64
    _t1 := jwt.Verify(tok, SECRET, late, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_EXPIRED)
    // ... and leeway forgives a small clock difference
    late.leeway = 60 as i64
    _t2 := jwt.Verify(tok, SECRET, late, verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
    // exp is exclusive: at exactly exp the token is done
    mut at_exp := fixed_opts()
    at_exp.now = (NOW + 100) as i64
    _t3 := jwt.Verify(tok, SECRET, at_exp, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_EXPIRED)
    // not yet valid
    mut early := fixed_opts()
    early.now = (NOW - 200) as i64
    _t4 := jwt.Verify(tok, SECRET, early, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_NOT_YET_VALID)
    // issued in the future: a token minted by a clock ahead of ours
    mut c2 := jwt.NewClaims()
    c2.iat = (NOW + 500) as i64
    tok2 := jwt.SignHS256(c2, SECRET, err)
    _t5 := jwt.Verify(tok2, SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_ISSUED_IN_FUTURE)
end

func test_verify_claim_policy():
    mut c := jwt.NewClaims()
    c.iss = "api.example.com"
    c.sub = "user-42"
    c.exp = 2000000000 as i64
    mut err := 0
    tok := jwt.SignHS256(c, SECRET, err)
    mut verr := 0
    mut o := fixed_opts()
    o.issuer = "other.example.com"
    _t1 := jwt.Verify(tok, SECRET, o, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_ISSUER)
    o = fixed_opts()
    o.subject = "user-9"
    _t2 := jwt.Verify(tok, SECRET, o, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_SUBJECT)
    o = fixed_opts()
    o.audience = "web"
    _t3 := jwt.Verify(tok, SECRET, o, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_AUDIENCE)
    o = fixed_opts()
    o.require_jti = true
    _t4 := jwt.Verify(tok, SECRET, o, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_MISSING_CLAIM)
    o = fixed_opts()
    o.require_sub = true
    _t5 := jwt.Verify(tok, SECRET, o, verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
end

func test_audience_forms():
    mut err := 0
    mut verr := 0
    // "aud" as an array is as legal as "aud" as a string
    mut c := jwt.NewClaims()
    c.exp = 2000000000 as i64
    jwt.SetRaw(c, "aud", `["web","mobile"]`)
    tok := jwt.SignHS256(c, SECRET, err)
    mut o := fixed_opts()
    o.audience = "mobile"
    t := jwt.Verify(tok, SECRET, o, verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
    testing.AssertTrue(jwt.HasAudience(t, "web"))
    testing.AssertTrue(jwt.HasAudience(t, "mobile"))
    testing.AssertFalse(jwt.HasAudience(t, "desktop"))
    o.audience = "desktop"
    _t2 := jwt.Verify(tok, SECRET, o, verr)
    testing.AssertEqInt(verr, jwt.JWT_ERR_AUDIENCE)
    // a single-string audience that merely looks like an array is not one
    mut c3 := jwt.NewClaims()
    c3.exp = 2000000000 as i64
    c3.aud = `["web"]`
    tok3 := jwt.SignHS256(c3, SECRET, err)
    t3 := jwt.Verify(tok3, SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
    testing.AssertFalse(jwt.HasAudience(t3, "web"))
    testing.AssertTrue(jwt.HasAudience(t3, `["web"]`))
end

func test_scopes():
    mut c := jwt.NewClaims()
    c.exp = 2000000000 as i64
    jwt.SetStr(c, "scope", "read write admin")
    mut err := 0
    tok := jwt.SignHS256(c, SECRET, err)
    mut verr := 0
    t := jwt.Verify(tok, SECRET, fixed_opts(), verr)
    testing.AssertTrue(jwt.HasScope(t, "read"))
    testing.AssertTrue(jwt.HasScope(t, "write"))
    testing.AssertTrue(jwt.HasScope(t, "admin"))
    // a prefix of a scope is not that scope
    testing.AssertFalse(jwt.HasScope(t, "adm"))
    testing.AssertFalse(jwt.HasScope(t, "read write"))
    testing.AssertFalse(jwt.HasScope(t, ""))
end

func test_unicode_round_trip():
    mut c := jwt.NewClaims()
    c.exp = 2000000000 as i64
    jwt.SetStr(c, "name", `Ali "MAX" Base`)
    jwt.SetStr(c, "fa", "سلام دنیا")
    jwt.SetStr(c, "lines", "a\nb\tc")
    jwt.SetStr(c, "win", "C:\\tmp")
    mut err := 0
    tok := jwt.SignHS256(c, SECRET, err)
    mut verr := 0
    t := jwt.Verify(tok, SECRET, fixed_opts(), verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
    testing.AssertEqStr(jwt.Str(t, "name"), `Ali "MAX" Base`)
    testing.AssertEqStr(jwt.Str(t, "fa"), "سلام دنیا")
    testing.AssertEqStr(jwt.Str(t, "lines"), "a\nb\tc")
    testing.AssertEqStr(jwt.Str(t, "win"), "C:\\tmp")
    // \uXXXX escapes produced by another encoder decode too
    mut e2 := 0
    esc := jwt.SignJSON(`{"a":"\u0633\u0644\u0627\u0645","b":"\u00e9","c":"\ud83d\ude00"}`, jwt.JWT_HS256, "", SECRET, e2)
    t2 := jwt.Decode(esc, e2)
    testing.AssertEqStr(jwt.Str(t2, "a"), "سلام")
    testing.AssertEqStr(jwt.Str(t2, "b"), "é")
    testing.AssertEqStr(jwt.Str(t2, "c"), "😀")
end

func test_decode_does_not_validate():
    // expired, wrong issuer, and Decode still hands it over - with valid false
    mut c := jwt.NewClaims()
    c.iss = "somebody-else"
    c.sub = "user-42"
    c.exp = 1 as i64
    mut err := 0
    tok := jwt.SignHS256(c, "a-different-secret", err)
    mut derr := 0
    t := jwt.Decode(tok, derr)
    testing.AssertEqInt(derr, JWT_OK_CODE())
    testing.AssertFalse(t.valid)
    testing.AssertEqStr(t.claims.sub, "user-42")
    testing.AssertEqStr(t.alg, "HS256")
    // IsValid is the same check as Verify, minus the token
    testing.AssertFalse(jwt.IsValid(tok, SECRET, fixed_opts()))
    mut c2 := jwt.NewClaims()
    c2.exp = 2000000000 as i64
    tok2 := jwt.SignHS256(c2, SECRET, err)
    testing.AssertTrue(jwt.IsValid(tok2, SECRET, fixed_opts()))
end

func test_error_text():
    testing.AssertEqStr(jwt.ErrorText(JWT_OK_CODE()), "ok")
    testing.AssertEqStr(jwt.ErrorText(jwt.JWT_ERR_SIGNATURE), "signature does not match")
    testing.AssertEqStr(jwt.ErrorText(jwt.JWT_ERR_EXPIRED), "token expired")
    testing.AssertEqStr(jwt.ErrorText(9999), "unknown error")
    testing.AssertTrue(jwt.IsSupportedAlg("HS256"))
    testing.AssertTrue(jwt.IsSupportedAlg("HS384"))
    testing.AssertTrue(jwt.IsSupportedAlg("HS512"))
    testing.AssertFalse(jwt.IsSupportedAlg("none"))
    testing.AssertFalse(jwt.IsSupportedAlg("RS256"))
    testing.AssertFalse(jwt.IsSupportedAlg("hs256"))
    testing.AssertEqInt(jwt.DigestSize("HS256"), 32)
    testing.AssertEqInt(jwt.DigestSize("HS384"), 48)
    testing.AssertEqInt(jwt.DigestSize("HS512"), 64)
    testing.AssertEqInt(jwt.DigestSize("RS256"), 0)
end

// ---------------------------------------------------------------- auth layer

func test_bearer_parsing():
    testing.AssertEqStr(jwt.ParseBearer("Bearer abc.def.ghi"), "abc.def.ghi")
    testing.AssertEqStr(jwt.ParseBearer("bearer abc"), "abc")
    testing.AssertEqStr(jwt.ParseBearer("BEARER abc"), "abc")
    testing.AssertEqStr(jwt.ParseBearer("Bearer    abc"), "abc")
    testing.AssertEqStr(jwt.ParseBearer("Basic abc"), "")
    testing.AssertEqStr(jwt.ParseBearer("Bearer"), "")
    testing.AssertEqStr(jwt.ParseBearer("Bearer "), "")
    testing.AssertEqStr(jwt.ParseBearer(""), "")
    testing.AssertEqStr(jwt.ParseBearer("Bearerabc"), "")
end

func test_guard_issue():
    mut g := jwt.NewGuard(SECRET)
    g.opts.issuer = "api.example.com"
    g.opts.audience = "web"
    mut err := 0
    tok := jwt.IssueFor(g, "user-42", 3600 as i64, err)
    testing.AssertEqInt(err, JWT_OK_CODE())
    mut verr := 0
    t := jwt.Verify(tok, SECRET, g.opts, verr)
    testing.AssertEqInt(verr, JWT_OK_CODE())
    testing.AssertTrue(t.valid)
    testing.AssertEqStr(t.claims.sub, "user-42")
    // Issue fills issuer and audience in from the guard's own policy, so the
    // token it mints is one the same guard will accept
    testing.AssertEqStr(t.claims.iss, "api.example.com")
    testing.AssertEqStr(t.claims.aud, "web")
    testing.AssertTrue(t.claims.exp > t.claims.iat)
    testing.AssertEqInt64(t.claims.exp - t.claims.iat, 3600 as i64)
    // a guard with no secret cannot mint anything
    broken := jwt.NewGuard("")
    mut e2 := 0
    testing.AssertEqStr(jwt.IssueFor(broken, "user-42", 60 as i64, e2), "")
    testing.AssertEqInt(e2, jwt.JWT_ERR_EMPTY_SECRET)
end

func test_guard_pair():
    g := jwt.NewGuard(SECRET)
    mut access := ""
    mut refresh := ""
    mut err := 0
    ok := jwt.IssuePair(g, "user-42", 900 as i64, 604800 as i64, access, refresh, err)
    testing.AssertTrue(ok)
    testing.AssertEqInt(err, JWT_OK_CODE())
    mut e1 := 0
    ta := jwt.Verify(access, SECRET, g.opts, e1)
    mut e2 := 0
    tr := jwt.Verify(refresh, SECRET, g.opts, e2)
    testing.AssertEqInt(e1, JWT_OK_CODE())
    testing.AssertEqInt(e2, JWT_OK_CODE())
    // the two are distinguishable, which is what stops a refresh token from
    // being spent as an access token
    testing.AssertEqStr(jwt.Str(ta, "kind"), "access")
    testing.AssertEqStr(jwt.Str(tr, "kind"), "refresh")
    testing.AssertTrue(tr.claims.jti.len() > 0)
    testing.AssertTrue(tr.claims.exp - ta.claims.exp > 0 as i64)
end

func test_password_and_secrets():
    hash := crypto.HashPassword("correct horse battery staple")
    testing.AssertTrue(crypto.VerifyPassword("correct horse battery staple", hash))
    testing.AssertFalse(crypto.VerifyPassword("Correct horse battery staple", hash))
    testing.AssertFalse(crypto.VerifyPassword("", hash))
    // the same password twice must not produce the same stored hash
    hash2 := crypto.HashPassword("correct horse battery staple")
    testing.AssertTrue(hash != hash2)
    testing.AssertTrue(crypto.VerifyPassword("correct horse battery staple", hash2))
    testing.AssertTrue(crypto.SecretEquals("abc", "abc"))
    testing.AssertFalse(crypto.SecretEquals("abc", "abd"))
    testing.AssertFalse(crypto.SecretEquals("abc", "abcd"))
    // crypto.SecretEquals is an EXACT constant-time compare, so two empty
    // strings are equal. That is the documented trap: an expected secret
    // that failed to load would match an empty candidate, and the guard
    // belongs at the call site rather than inside the primitive.
    testing.AssertTrue(crypto.SecretEquals("", ""))
    testing.AssertFalse(secret_ok("", ""))
    testing.AssertTrue(secret_ok("abc", "abc"))
    testing.AssertEqInt(crypto.RandomHex(32).len(), 64)
    testing.AssertTrue(crypto.RandomHex(32) != crypto.RandomHex(32))
end

// The call-site guard every secret comparison needs: an unset expected value
// must never match. See crypto.SecretEquals.
func secret_ok(given: str, expected: str): bool:
    if expected.len() == 0: ret false end
    ret crypto.SecretEquals(given, expected)
end

// jwt.JWT_OK is 0; wrapped so the assertions read as intent rather than as a
// bare literal.
pure func JWT_OK_CODE(): int:
    ret jwt.JWT_OK
end

func main:
    test_b64url()
    test_claims_json()
    test_claims_registered_routing()
    test_claims_escaping()
    test_sign_known_tokens()
    test_sign_rejects()
    test_verify_canonical()
    test_verify_round_trip()
    test_verify_signature_failures()
    test_verify_alg_attacks()
    test_verify_malformed()
    test_header_policy()
    test_verify_time()
    test_verify_claim_policy()
    test_audience_forms()
    test_scopes()
    test_unicode_round_trip()
    test_decode_does_not_validate()
    test_error_text()
    test_bearer_parsing()
    test_guard_issue()
    test_guard_pair()
    test_password_and_secrets()
    ret testing.Summary()
end
