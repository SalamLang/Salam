package main

import jwt
import crypto
import testing

const SECRET := "your-256-bit-secret"

const NOW := 1600000000

func fixed_opts(): jwt.Options:
    mut o := jwt.DefaultOptions()
    o.now = NOW as i64
    ret o
end

func code_of(token: str, secret: str, o: jwt.Options): str:
    try:
        _ := jwt.Verify(token, secret, o)
        ret ""
    catch e:
        ret e.code
    end
end

func sign_code(c: jwt.Claims, alg: str, secret: str): str:
    try:
        _ := jwt.Sign(c, alg, secret)
        ret ""
    catch e:
        ret e.code
    end
end

func b64_code(s: str): str:
    try:
        _ := jwt.B64UrlDecode(s)
        ret ""
    catch e:
        ret e.code
    end
end

func test_b64url() throws:
    testing.AssertEqStr(jwt.B64UrlEncode(""), "")
    testing.AssertEqStr(jwt.B64UrlEncode("f"), "Zg")
    testing.AssertEqStr(jwt.B64UrlEncode("fo"), "Zm8")
    testing.AssertEqStr(jwt.B64UrlEncode("foo"), "Zm9v")
    testing.AssertEqStr(jwt.B64UrlEncode("foobar"), "Zm9vYmFy")
    testing.AssertEqStr(jwt.B64UrlEncode(`{"alg":"HS256","typ":"JWT"}`), "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9")
    testing.AssertEqStr(try jwt.B64UrlDecode("Zm9vYmFy"), "foobar")
    testing.AssertEqStr(try jwt.B64UrlDecode("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"), `{"alg":"HS256","typ":"JWT"}`)
    testing.AssertEqStr(b64_code("Zm9vYmFy="), "jwt.bad_base64")
    testing.AssertEqStr(b64_code("ab+c"), "jwt.bad_base64")
    testing.AssertEqStr(b64_code("ab/c"), "jwt.bad_base64")
    testing.AssertEqStr(b64_code("Zm9v YmFy"), "jwt.bad_base64")
    testing.AssertEqStr(b64_code("Zm9vY"), "jwt.bad_base64")
end

func test_claims_json():
    mut c := jwt.NewClaims()
    testing.AssertEqStr(jwt.ClaimsJSON(c), "{}")
    c.iss = "api.example.com"
    c.sub = "user-42"
    c.aud = "web"
    c.exp = 2000000000 as i64
    c.iat = 1000000000 as i64
    c.jti = "abc"
    jwt.SetStr(c, "role", "admin")
    jwt.SetBool(c, "mfa", true)
    jwt.SetInt(c, "level", 7 as i64)
    jwt.SetRaw(c, "scopes", `["read","write"]`)
    testing.AssertEqStr(jwt.ClaimsJSON(c), `{"iss":"api.example.com","sub":"user-42","aud":"web","exp":2000000000,"iat":1000000000,"jti":"abc","role":"admin","mfa":true,"level":7,"scopes":["read","write"]}`)
end

func test_claims_registered_routing():
    mut c := jwt.NewClaims()
    jwt.SetStr(c, "iss", "me")
    jwt.SetStr(c, "sub", "you")
    jwt.SetStr(c, "jti", "id")
    jwt.SetInt(c, "exp", 5 as i64)
    jwt.SetInt(c, "nbf", 4 as i64)
    jwt.SetInt(c, "iat", 3 as i64)
    testing.AssertEqStr(c.iss, "me")
    testing.AssertEqStr(c.sub, "you")
    testing.AssertEqStr(c.jti, "id")
    testing.AssertEqInt64(c.exp, 5 as i64)
    testing.AssertEqInt64(c.nbf, 4 as i64)
    testing.AssertEqInt64(c.iat, 3 as i64)
    testing.AssertEqStr(c.extra, "")
    testing.AssertEqStr(jwt.ClaimsJSON(c), `{"iss":"me","sub":"you","exp":5,"nbf":4,"iat":3,"jti":"id"}`)
end

func test_claims_escaping():
    mut c := jwt.NewClaims()
    jwt.SetStr(c, "name", `Ali "MAX" Base`)
    jwt.SetStr(c, "path", "C:\\tmp")
    jwt.SetStr(c, "lines", "a\nb")
    testing.AssertEqStr(jwt.ClaimsJSON(c), `{"name":"Ali \"MAX\" Base","path":"C:\\tmp","lines":"a\nb"}`)
end

func test_sign_known_tokens() throws:
    mut c := jwt.NewClaims()
    c.sub = "1234567890"
    jwt.SetStr(c, "name", "John Doe")
    jwt.SetInt(c, "iat", 1516239022 as i64)
    hs256 := try jwt.SignHS256(c, SECRET)
    testing.AssertEqStr(hs256, "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwiaWF0IjoxNTE2MjM5MDIyLCJuYW1lIjoiSm9obiBEb2UifQ.LWG7yvgEiiKDUA2PmykvKGKMedYPyLWsLCcJR5pn-Kw")
    hs384 := try jwt.SignHS384(c, SECRET)
    testing.AssertEqStr(hs384, "eyJhbGciOiJIUzM4NCIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwiaWF0IjoxNTE2MjM5MDIyLCJuYW1lIjoiSm9obiBEb2UifQ.oBbeSMWfiX9tiMhNSJeMDGXOJr7Ihg49HtLqx2VolvLx0AAyuFh_MeRgQ3IoGV9f")
    hs512 := try jwt.SignHS512(c, SECRET)
    testing.AssertEqStr(hs512, "eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwiaWF0IjoxNTE2MjM5MDIyLCJuYW1lIjoiSm9obiBEb2UifQ.f1qJgj7FVIk1ATQPEgLgF913j9XQB7JBHJdU5QVNM0dPDNIzyOw73y2tCg0rWNkwU2T_j4tPrq35NMdZDh7AQQ")
    kidded := try jwt.SignWithKid(c, jwt.JWT_HS256, "key-1", SECRET)
    t := try jwt.Decode(kidded)
    testing.AssertEqStr(t.kid, "key-1")
    testing.AssertEqStr(t.header_json, `{"alg":"HS256","typ":"JWT","kid":"key-1"}`)
end

func test_sign_rejects():
    mut c := jwt.NewClaims()
    c.sub = "x"
    testing.AssertEqStr(sign_code(c, "RS256", SECRET), "jwt.bad_alg")
    testing.AssertEqStr(sign_code(c, "none", SECRET), "jwt.bad_alg")
    testing.AssertEqStr(sign_code(c, jwt.JWT_HS256, ""), "jwt.empty_secret")
    testing.AssertEqStr(sign_code(c, jwt.JWT_HS256, SECRET), "")
end

func test_verify_canonical() throws:
    io := "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
    t := try jwt.Verify(io, SECRET, fixed_opts())
    testing.AssertTrue(t.valid)
    testing.AssertEqStr(t.alg, "HS256")
    testing.AssertEqStr(t.typ, "JWT")
    testing.AssertEqStr(t.claims.sub, "1234567890")
    testing.AssertEqInt64(t.claims.iat, 1516239022 as i64)
    testing.AssertEqStr(jwt.Str(t, "name"), "John Doe")
end

func test_verify_round_trip() throws:
    mut c := jwt.NewClaims()
    c.iss = "api.example.com"
    c.sub = "user-42"
    c.aud = "web"
    c.exp = 2000000000 as i64
    jwt.SetStr(c, "role", "admin")
    jwt.SetBool(c, "mfa", true)
    jwt.SetInt(c, "level", 7 as i64)
    jwt.SetRaw(c, "scopes", `["read","write"]`)
    tok := try jwt.SignHS256(c, SECRET)
    mut o := fixed_opts()
    o.issuer = "api.example.com"
    o.audience = "web"
    o.require_exp = true
    t := try jwt.Verify(tok, SECRET, o)
    testing.AssertTrue(t.valid)
    testing.AssertEqStr(jwt.Str(t, "role"), "admin")
    testing.AssertTrue(jwt.Bool(t, "mfa"))
    testing.AssertEqInt64(jwt.Int(t, "level"), 7 as i64)
    testing.AssertEqStr(jwt.Raw(t, "scopes"), `["read","write"]`)
    testing.AssertTrue(jwt.ListHas(t, "scopes", "write"))
    testing.AssertFalse(jwt.ListHas(t, "scopes", "delete"))
    testing.AssertTrue(jwt.Has(t, "role"))
    testing.AssertFalse(jwt.Has(t, "nope"))
    testing.AssertEqStr(jwt.Str(t, "nope"), "")
    testing.AssertEqInt64(jwt.Int(t, "nope"), 0 as i64)
    testing.AssertFalse(jwt.Bool(t, "nope"))
    testing.AssertEqStr(jwt.Str(t, "scopes"), "")
end

func test_verify_signature_failures() throws:
    mut c := jwt.NewClaims()
    c.sub = "user-42"
    c.exp = 2000000000 as i64
    tok := try jwt.SignHS256(c, SECRET)
    testing.AssertEqStr(code_of(tok, "not-the-secret", fixed_opts()), "jwt.bad_signature")
    mut tampered := tok.Substr(0, tok.Len() - 1)
    if tok.Substr(tok.Len() - 1, 1) == "A":
        tampered = tampered.Concat("B")
    else:
        tampered = tampered.Concat("A")
    end
    testing.AssertEqStr(code_of(tampered, SECRET, fixed_opts()), "jwt.bad_signature")
    testing.AssertFalse(jwt.IsValid(tampered, SECRET, fixed_opts()))
    testing.AssertEqStr(code_of(tok, "", fixed_opts()), "jwt.empty_secret")
end

func test_verify_alg_attacks() throws:
    none_tok := "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhZG1pbiJ9."
    testing.AssertEqStr(code_of(none_tok, SECRET, fixed_opts()), "jwt.bad_alg")
    testing.AssertFalse(jwt.IsValid(none_tok, SECRET, fixed_opts()))
    rs_tok := "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiJ9.aaaa"
    testing.AssertEqStr(code_of(rs_tok, SECRET, fixed_opts()), "jwt.bad_alg")
    mut c := jwt.NewClaims()
    c.sub = "user-42"
    c.exp = 2000000000 as i64
    tok512 := try jwt.SignHS512(c, SECRET)
    testing.AssertEqStr(code_of(tok512, SECRET, fixed_opts()), "jwt.alg_mismatch")
    mut o := jwt.OptionsFor(jwt.JWT_HS512)
    o.now = NOW as i64
    t4 := try jwt.Verify(tok512, SECRET, o)
    testing.AssertTrue(t4.valid)
end

func test_verify_malformed():
    testing.AssertEqStr(code_of("", SECRET, fixed_opts()), "jwt.malformed")
    testing.AssertEqStr(code_of("abc", SECRET, fixed_opts()), "jwt.malformed")
    testing.AssertEqStr(code_of("a.b", SECRET, fixed_opts()), "jwt.malformed")
    testing.AssertEqStr(code_of("a.b.c.d", SECRET, fixed_opts()), "jwt.malformed")
    testing.AssertEqStr(code_of(".b.c", SECRET, fixed_opts()), "jwt.malformed")
    testing.AssertEqStr(code_of("a+b.eyJzdWIiOiJ4In0.sig", SECRET, fixed_opts()), "jwt.bad_base64")
    testing.AssertEqStr(code_of("eyJ4IjoxfQ.eyJzdWIiOiJ4In0.sig", SECRET, fixed_opts()), "jwt.bad_json")
end

func test_header_policy():
    payload := jwt.B64UrlEncode(`{"sub":"x"}`)
    testing.AssertEqStr(header_code(`{"alg":"HS256","typ":"at+jwt"}`, payload), "")
    testing.AssertEqStr(header_code(`{"alg":"HS256"}`, payload), "")
    testing.AssertEqStr(header_code(`{"alg":"HS256","typ":"jwt"}`, payload), "")
    testing.AssertEqStr(header_code(`{"alg":"HS256","typ":"JOSE"}`, payload), "jwt.bad_typ")
    testing.AssertEqStr(header_code(`{"alg":"HS256","typ":"JWT","crit":["exp"]}`, payload), "jwt.crit")
    testing.AssertEqStr(header_code(`{"alg":"HS256","typ":"JWT"}`, jwt.B64UrlEncode(`{"sub":"admin","sub":"guest"}`)), "jwt.bad_json")
    testing.AssertEqStr(header_code(`{"alg":"HS256","typ":"JWT"}`, jwt.B64UrlEncode(`{"exp":9999999999,"exp":1}`)), "jwt.bad_json")
    testing.AssertEqStr(header_code(`{"alg":"HS256","typ":"JWT"}`, jwt.B64UrlEncode(`{"sub":"x","note":"a","note":"b"}`)), "")
end

func header_code(header_json: str, payload_b64: str): str:
    si := jwt.B64UrlEncode(header_json).Concat(".").Concat(payload_b64)
    tok := si.Concat(".").Concat(jwt.SignatureOf(si, jwt.JWT_HS256, SECRET))
    mut o := fixed_opts()
    o.require_exp = false
    ret code_of(tok, SECRET, o)
end

func test_verify_time() throws:
    mut c := jwt.NewClaims()
    c.sub = "user-42"
    c.exp = (NOW + 100) as i64
    c.nbf = (NOW - 100) as i64
    c.iat = (NOW - 100) as i64
    tok := try jwt.SignHS256(c, SECRET)
    testing.AssertEqStr(code_of(tok, SECRET, fixed_opts()), "")
    mut late := fixed_opts()
    late.now = (NOW + 101) as i64
    testing.AssertEqStr(code_of(tok, SECRET, late), "jwt.expired")
    late.leeway = 60 as i64
    testing.AssertEqStr(code_of(tok, SECRET, late), "")
    mut at_exp := fixed_opts()
    at_exp.now = (NOW + 100) as i64
    testing.AssertEqStr(code_of(tok, SECRET, at_exp), "jwt.expired")
    mut early := fixed_opts()
    early.now = (NOW - 200) as i64
    testing.AssertEqStr(code_of(tok, SECRET, early), "jwt.not_yet_valid")
    mut c2 := jwt.NewClaims()
    c2.iat = (NOW + 500) as i64
    tok2 := try jwt.SignHS256(c2, SECRET)
    testing.AssertEqStr(code_of(tok2, SECRET, fixed_opts()), "jwt.issued_in_future")
end

func test_verify_claim_policy() throws:
    mut c := jwt.NewClaims()
    c.iss = "api.example.com"
    c.sub = "user-42"
    c.exp = 2000000000 as i64
    tok := try jwt.SignHS256(c, SECRET)
    mut o := fixed_opts()
    o.issuer = "other.example.com"
    testing.AssertEqStr(code_of(tok, SECRET, o), "jwt.bad_claim")
    o = fixed_opts()
    o.subject = "user-9"
    testing.AssertEqStr(code_of(tok, SECRET, o), "jwt.bad_claim")
    o = fixed_opts()
    o.audience = "web"
    testing.AssertEqStr(code_of(tok, SECRET, o), "jwt.bad_claim")
    o = fixed_opts()
    o.require_jti = true
    testing.AssertEqStr(code_of(tok, SECRET, o), "jwt.missing_claim")
    o = fixed_opts()
    o.require_sub = true
    testing.AssertEqStr(code_of(tok, SECRET, o), "")
end

func test_audience_forms() throws:
    mut c := jwt.NewClaims()
    c.exp = 2000000000 as i64
    jwt.SetRaw(c, "aud", `["web","mobile"]`)
    tok := try jwt.SignHS256(c, SECRET)
    mut o := fixed_opts()
    o.audience = "mobile"
    t := try jwt.Verify(tok, SECRET, o)
    testing.AssertTrue(jwt.HasAudience(t, "web"))
    testing.AssertTrue(jwt.HasAudience(t, "mobile"))
    testing.AssertFalse(jwt.HasAudience(t, "desktop"))
    o.audience = "desktop"
    testing.AssertEqStr(code_of(tok, SECRET, o), "jwt.bad_claim")
    mut c3 := jwt.NewClaims()
    c3.exp = 2000000000 as i64
    c3.aud = `["web"]`
    tok3 := try jwt.SignHS256(c3, SECRET)
    t3 := try jwt.Verify(tok3, SECRET, fixed_opts())
    testing.AssertFalse(jwt.HasAudience(t3, "web"))
    testing.AssertTrue(jwt.HasAudience(t3, `["web"]`))
end

func test_scopes() throws:
    mut c := jwt.NewClaims()
    c.exp = 2000000000 as i64
    jwt.SetStr(c, "scope", "read write admin")
    tok := try jwt.SignHS256(c, SECRET)
    t := try jwt.Verify(tok, SECRET, fixed_opts())
    testing.AssertTrue(jwt.HasScope(t, "read"))
    testing.AssertTrue(jwt.HasScope(t, "write"))
    testing.AssertTrue(jwt.HasScope(t, "admin"))
    testing.AssertFalse(jwt.HasScope(t, "adm"))
    testing.AssertFalse(jwt.HasScope(t, "read write"))
    testing.AssertFalse(jwt.HasScope(t, ""))
end

func test_unicode_round_trip() throws:
    mut c := jwt.NewClaims()
    c.exp = 2000000000 as i64
    jwt.SetStr(c, "name", `Ali "MAX" Base`)
    jwt.SetStr(c, "fa", "سلام دنیا")
    jwt.SetStr(c, "lines", "a\nb\tc")
    jwt.SetStr(c, "win", "C:\\tmp")
    tok := try jwt.SignHS256(c, SECRET)
    t := try jwt.Verify(tok, SECRET, fixed_opts())
    testing.AssertEqStr(jwt.Str(t, "name"), `Ali "MAX" Base`)
    testing.AssertEqStr(jwt.Str(t, "fa"), "سلام دنیا")
    testing.AssertEqStr(jwt.Str(t, "lines"), "a\nb\tc")
    testing.AssertEqStr(jwt.Str(t, "win"), "C:\\tmp")
    esc := try jwt.SignJSON(`{"a":"\u0633\u0644\u0627\u0645","b":"\u00e9","c":"\ud83d\ude00"}`, jwt.JWT_HS256, "", SECRET)
    t2 := try jwt.Decode(esc)
    testing.AssertEqStr(jwt.Str(t2, "a"), "سلام")
    testing.AssertEqStr(jwt.Str(t2, "b"), "é")
    testing.AssertEqStr(jwt.Str(t2, "c"), "😀")
end

func test_decode_does_not_validate() throws:
    mut c := jwt.NewClaims()
    c.iss = "somebody-else"
    c.sub = "user-42"
    c.exp = 1 as i64
    tok := try jwt.SignHS256(c, "a-different-secret")
    t := try jwt.Decode(tok)
    testing.AssertFalse(t.valid)
    testing.AssertEqStr(t.claims.sub, "user-42")
    testing.AssertEqStr(t.alg, "HS256")
    testing.AssertFalse(jwt.IsValid(tok, SECRET, fixed_opts()))
    mut c2 := jwt.NewClaims()
    c2.exp = 2000000000 as i64
    tok2 := try jwt.SignHS256(c2, SECRET)
    testing.AssertTrue(jwt.IsValid(tok2, SECRET, fixed_opts()))
end

func test_algorithms():
    testing.AssertTrue(jwt.IsSupportedAlg("HS256"))
    testing.AssertTrue(jwt.IsSupportedAlg("HS384"))
    testing.AssertTrue(jwt.IsSupportedAlg("HS512"))
    testing.AssertFalse(jwt.IsSupportedAlg("none"))
    testing.AssertFalse(jwt.IsSupportedAlg("RS256"))
    testing.AssertFalse(jwt.IsSupportedAlg("hs256"))
    testing.AssertEqInt(jwt.DigestSize("HS256"), 32)
    testing.AssertEqInt(jwt.DigestSize("HS384"), 48)
    testing.AssertEqInt(jwt.DigestSize("HS512"), 64)
    testing.AssertEqInt(jwt.DigestSize("RS256"), 0)
end

func test_bearer_parsing():
    testing.AssertEqStr(jwt.ParseBearer("Bearer abc.def.ghi"), "abc.def.ghi")
    testing.AssertEqStr(jwt.ParseBearer("bearer abc"), "abc")
    testing.AssertEqStr(jwt.ParseBearer("BEARER abc"), "abc")
    testing.AssertEqStr(jwt.ParseBearer("Bearer    abc"), "abc")
    testing.AssertEqStr(jwt.ParseBearer("Basic abc"), "")
    testing.AssertEqStr(jwt.ParseBearer("Bearer"), "")
    testing.AssertEqStr(jwt.ParseBearer("Bearer "), "")
    testing.AssertEqStr(jwt.ParseBearer(""), "")
    testing.AssertEqStr(jwt.ParseBearer("Bearerabc"), "")
end

func test_guard_issue() throws:
    mut g := jwt.NewGuard(SECRET)
    g.opts.issuer = "api.example.com"
    g.opts.audience = "web"
    tok := try jwt.IssueFor(g, "user-42", 3600 as i64)
    t := try jwt.Verify(tok, SECRET, g.opts)
    testing.AssertTrue(t.valid)
    testing.AssertEqStr(t.claims.sub, "user-42")
    testing.AssertEqStr(t.claims.iss, "api.example.com")
    testing.AssertEqStr(t.claims.aud, "web")
    testing.AssertTrue(t.claims.exp > t.claims.iat)
    testing.AssertEqInt64(t.claims.exp - t.claims.iat, 3600 as i64)
    broken := jwt.NewGuard("")
    mut code := ""
    try:
        _ := jwt.IssueFor(broken, "user-42", 60 as i64)
    catch e:
        code = e.code
    end
    testing.AssertEqStr(code, "jwt.empty_secret")
end

func test_guard_pair() throws:
    g := jwt.NewGuard(SECRET)
    mut access := ""
    mut refresh := ""
    try jwt.IssuePair(g, "user-42", 900 as i64, 604800 as i64, access, refresh)
    ta := try jwt.Verify(access, SECRET, g.opts)
    tr := try jwt.Verify(refresh, SECRET, g.opts)
    testing.AssertTrue(ta.valid)
    testing.AssertTrue(tr.valid)
    testing.AssertEqStr(jwt.Str(ta, "kind"), "access")
    testing.AssertEqStr(jwt.Str(tr, "kind"), "refresh")
    testing.AssertTrue(tr.claims.jti.Len() > 0)
    testing.AssertTrue(tr.claims.exp - ta.claims.exp > 0 as i64)
end

func test_password_and_secrets():
    hash := crypto.HashPassword("correct horse battery staple")
    testing.AssertTrue(crypto.VerifyPassword("correct horse battery staple", hash))
    testing.AssertFalse(crypto.VerifyPassword("Correct horse battery staple", hash))
    testing.AssertFalse(crypto.VerifyPassword("", hash))
    hash2 := crypto.HashPassword("correct horse battery staple")
    testing.AssertTrue(hash != hash2)
    testing.AssertTrue(crypto.VerifyPassword("correct horse battery staple", hash2))
    testing.AssertTrue(crypto.SecretEquals("abc", "abc"))
    testing.AssertFalse(crypto.SecretEquals("abc", "abz"))
    testing.AssertFalse(crypto.SecretEquals("abc", "abcd"))
    testing.AssertTrue(crypto.SecretEquals("", ""))
    testing.AssertFalse(secret_ok("", ""))
    testing.AssertTrue(secret_ok("abc", "abc"))
    testing.AssertEqInt(crypto.RandomHex(32).Len(), 64)
    testing.AssertTrue(crypto.RandomHex(32) != crypto.RandomHex(32))
end

func secret_ok(given: str, expected: str): bool:
    if expected.Len() == 0: ret false end
    ret crypto.SecretEquals(given, expected)
end

func main:
    try:
        test_b64url()
        test_claims_json()
        test_claims_registered_routing()
        test_claims_escaping()
        test_sign_known_tokens()
        test_sign_rejects()
        test_verify_canonical()
        test_verify_round_trip()
        test_verify_signature_failures()
        test_verify_alg_attacks()
        test_verify_malformed()
        test_header_policy()
        test_verify_time()
        test_verify_claim_policy()
        test_audience_forms()
        test_scopes()
        test_unicode_round_trip()
        test_decode_does_not_validate()
        test_algorithms()
        test_bearer_parsing()
        test_guard_issue()
        test_guard_pair()
        test_password_and_secrets()
    catch e:
        testing.AssertMsg(false, "unexpected error: " + e.ToStr())
    end
    ret testing.Summary()
end
