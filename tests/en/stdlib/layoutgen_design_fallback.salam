import layoutgen

func Page(name: str): layoutgen.Node:
    mut n := layoutgen.Node {}
    if name != "":
        n.attrs = " data-design=\"" + name + "\""
    end
    ret n
end

func Show(name: str):
    layoutgen.design_page(Page(name))
    println layoutgen.DsName() + " " + layoutgen.DsPick("acme", "S", "A") + " " + layoutgen.DsPick("acme", "S", "")
end

func main:
    Show("")
    Show("shadcn")
    Show("acme")
    Show("none")
end
