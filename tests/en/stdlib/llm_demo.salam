package main

// std/llm: SentencePiece and byte-level BPE tokenizers round-trip,
// the KV cache makes token-by-token decoding match one-shot decoding,
// sampling is seeded, and a hand-built GGUF loads back into a model
// that produces the same logits as the weights it was written from.

import archive
import compress
import encoding.binary
import filepath
import llm
import mem
import os
import str
import tensor
import testing

func put_str(b &: compress.ByteBuf, s: str):
    binary.WriteU64LE(b, s.len() as i64)
    compress.BufPushBytes(b, s as void*, s.len())
end

func kv_u32(b &: compress.ByteBuf, key: str, v: int):
    put_str(b, key)
    binary.WriteU32LE(b, 4)
    binary.WriteU32LE(b, v)
end

func kv_f32(b &: compress.ByteBuf, key: str, v: f64):
    put_str(b, key)
    binary.WriteU32LE(b, 6)
    binary.WriteF32(b, v, false)
end

func kv_str(b &: compress.ByteBuf, key: str, v: str):
    put_str(b, key)
    binary.WriteU32LE(b, 8)
    put_str(b, v)
end

func kv_strs(b &: compress.ByteBuf, key: str, vs &: Vector<str>):
    put_str(b, key)
    binary.WriteU32LE(b, 9)
    binary.WriteU32LE(b, 8)
    binary.WriteU64LE(b, vs.len() as i64)
    repeat vs.len() with i: put_str(b, vs.get(i)) end
end

func kv_f32s(b &: compress.ByteBuf, key: str, vs &: Vector<f64>):
    put_str(b, key)
    binary.WriteU32LE(b, 9)
    binary.WriteU32LE(b, 6)
    binary.WriteU64LE(b, vs.len() as i64)
    repeat vs.len() with i: binary.WriteF32(b, vs.get(i), false) end
end

func padded(n: int): int: ret ((n + 31) / 32) * 32 end

// A tensor info record with GGUF's innermost-first dims; returns the
// offset the next tensor starts at.
func tensor_info(b &: compress.ByteBuf, name: str, t &: tensor.Tensor, offset: int): int:
    put_str(b, name)
    binary.WriteU32LE(b, t.rank())
    mut i := t.rank() - 1
    until i >= 0:
        binary.WriteU64LE(b, t.dim(i) as i64)
        i -= 1
    end
    binary.WriteU32LE(b, 0)
    binary.WriteU64LE(b, offset as i64)
    ret offset + padded(4 * t.numel())
end

func tensor_data(b &: compress.ByteBuf, t &: tensor.Tensor):
    repeat t.numel() with k: binary.WriteF32(b, t.at(k), false) end
    until compress.BufLen(b) % 32 != 0: binary.WriteU8(b, 0) end
end

func spm_tokenizer(): llm.Tokenizer:
    mut t := llm.NewTokenizer(llm.TOK_SPM)
    _a := t.add_token("<unk>", 0.0)
    _b := t.add_token("<s>", 0.0)
    _c := t.add_token("</s>", 0.0)
    _d := t.add_token("\xE2\x96\x81", 0.0 - 1.0)
    _e := t.add_token("\xE2\x96\x81he", 0.0 - 2.0)
    _f := t.add_token("l", 0.0 - 3.0)
    _g := t.add_token("lo", 0.0 - 2.5)
    _h := t.add_token("\xE2\x96\x81hello", 0.0 - 1.5)
    _i := t.add_token("h", 0.0 - 4.0)
    _j := t.add_token("e", 0.0 - 4.0)
    _k := t.add_token("o", 0.0 - 4.0)
    _l := t.add_token("\xE2\x96\x81h", 0.0 - 3.0)
    _m := t.add_token("\xE2\x96\x81hel", 0.0 - 1.8)
    _n := t.add_token("\xE2\x96\x81hell", 0.0 - 1.6)
    repeat 256 with bb:
        hex := "0123456789ABCDEF"
        hi := str.Substr(hex, bb >> 4, 1)
        lo := str.Substr(hex, bb & 15, 1)
        name := "<0x" + hi + lo + ">"
        _o := t.add_token(name, 0.0 - 10.0)
        mem.Free(hi as void*)
        mem.Free(lo as void*)
        mem.Free(name as void*)
    end
    t.bos = 1
    t.eos = 2
    t.finish()
    ret t
end

func bpe_tokenizer(): llm.Tokenizer:
    mut t := llm.NewTokenizer(llm.TOK_BPE)
    _a := t.add_token("<|endoftext|>", 0.0)
    _b := t.add_token("\xC4\xA0", 0.0)       // "Ġ", the stand-in for a space
    _c := t.add_token("h", 0.0)
    _d := t.add_token("i", 0.0)
    _e := t.add_token("\xC4\xA0h", 0.0)
    _f := t.add_token("\xC4\xA0hi", 0.0)
    _g := t.add_token("!", 0.0)
    t.add_merge("\xC4\xA0", "h")
    t.add_merge("\xC4\xA0h", "i")
    t.eos = 0
    t.add_bos = false
    t.finish()
    ret t
end

func main:
    // ---- SentencePiece tokenizer ----
    mut spm := spm_tokenizer()
    mut ids := spm.encode("hello lo")
    testing.AssertEqInt(ids.len(), 4)
    testing.AssertEqInt(ids.get(0), 1)
    testing.AssertEqInt(ids.get(1), 7)
    testing.AssertEqInt(ids.get(2), 3)
    testing.AssertEqInt(ids.get(3), 6)
    text_a := spm.decode(ids)
    testing.AssertTrue(str.Equals(text_a, "hello lo"))
    mem.Free(text_a as void*)
    ids.free()
    // byte fallback for a character no token covers
    mut ids2 := spm.encode("\xC3\xA9")
    testing.AssertEqInt(ids2.len(), 4)
    testing.AssertEqInt(ids2.get(2), 14 + 0xC3)
    testing.AssertEqInt(ids2.get(3), 14 + 0xA9)
    text_b := spm.decode(ids2)
    testing.AssertTrue(str.Equals(text_b, "\xC3\xA9"))
    mem.Free(text_b as void*)
    ids2.free()
    spm.free()

    // ---- byte-level BPE tokenizer ----
    mut bpe := bpe_tokenizer()
    mut ids3 := bpe.encode(" hi hi!")
    testing.AssertEqInt(ids3.len(), 3)
    testing.AssertEqInt(ids3.get(0), 5)
    testing.AssertEqInt(ids3.get(1), 5)
    testing.AssertEqInt(ids3.get(2), 6)
    text_c := bpe.decode(ids3)
    testing.AssertTrue(str.Equals(text_c, " hi hi!"))
    mem.Free(text_c as void*)
    ids3.free()
    bpe.free()

    // ---- KV cache: incremental decoding matches one-shot ----
    mut cfg := llm.Config { vocab = 16, dim = 8, layers = 2, heads = 2, kv_heads = 1, ff = 16, ctx = 16 }
    mut m := llm.RandomModel(cfg, 7)
    mut cache := llm.NewKVCache(cfg)
    mut toks := Vector {} as Vector<int>
    toks.push(3)
    toks.push(1)
    toks.push(4)
    toks.push(1)
    toks.push(5)
    toks.push(9)
    mut full := llm.Forward(m, cache, toks)
    testing.AssertEqInt(full.dim(0), 6)
    testing.AssertEqInt(full.dim(1), 16)
    testing.AssertEqInt(cache.len, 6)
    cache.reset()
    mut one := Vector {} as Vector<int>
    one.push(0)
    mut all_close := true
    repeat 6 with i:
        one.set(0, toks.get(i))
        mut step := llm.Forward(m, cache, one)
        mut want := llm.LogitsRow(full, i)
        if !tensor.AllClose(step, want, 0.0001): all_close = false end
        if llm.Greedy(step, 0) != llm.Greedy(full, i): all_close = false end
        step.free()
        want.free()
    end
    testing.AssertTrue(all_close)
    testing.AssertEqInt(cache.len, 6)
    // the other rotary layout gives different numbers
    cfg.rope_kind = llm.ROPE_NEOX
    mut m2 := llm.RandomModel(cfg, 7)
    cache.reset()
    mut full2 := llm.Forward(m2, cache, toks)
    testing.AssertTrue(!tensor.AllClose(full, full2, 0.0001))
    full2.free()
    m2.free()
    // context overflow is refused
    cache.reset()
    cache.len = 15
    mut over := llm.Forward(m, cache, toks)
    testing.AssertTrue(over.is_empty())
    cache.reset()

    // ---- sampling ----
    mut greedy := llm.NewSampler(1)
    greedy.temperature = 0.0
    testing.AssertEqInt(greedy.sample(full, 5, one), llm.Greedy(full, 5))
    mut s1 := llm.NewSampler(5)
    s1.top_k = 3
    mut s2 := llm.NewSampler(5)
    s2.top_k = 3
    mut same := true
    mut in_range := true
    repeat 8 with r:
        a := s1.sample(full, r % 6, one)
        b := s2.sample(full, r % 6, one)
        if a != b: same = false end
        if a < 0 || a >= 16: in_range = false end
    end
    testing.AssertTrue(same)
    testing.AssertTrue(in_range)
    mut s3 := llm.NewSampler(9)
    s3.top_p = 0.5
    s3.repeat_penalty = 1.3
    p := s3.sample(full, 2, toks)
    testing.AssertTrue(p >= 0 && p < 16)
    full.free()
    // generation runs for max_new steps when nothing emits eos
    mut gen := llm.GenerateIds(m, cache, toks, 4, greedy, 0 - 1)
    testing.AssertEqInt(gen.len(), 4)
    testing.AssertEqInt(cache.len, 10)
    gen.free()
    one.free()
    cache.free()
    m.free()

    // ---- GGUF round trip ----
    mut gcfg := llm.Config { vocab = 8, dim = 4, layers = 1, heads = 2, kv_heads = 1, ff = 8, ctx = 8 }
    mut gm := llm.RandomModel(gcfg, 3)
    mut b := compress.NewByteBuf()
    compress.BufPushBytes(b, "GGUF" as void*, 4)
    binary.WriteU32LE(b, 3)
    binary.WriteU64LE(b, 11)   // tensors
    binary.WriteU64LE(b, 13)   // metadata pairs
    kv_str(b, "general.architecture", "llama")
    kv_u32(b, "llama.embedding_length", 4)
    kv_u32(b, "llama.block_count", 1)
    kv_u32(b, "llama.attention.head_count", 2)
    kv_u32(b, "llama.attention.head_count_kv", 1)
    kv_u32(b, "llama.feed_forward_length", 8)
    kv_u32(b, "llama.context_length", 8)
    kv_f32(b, "llama.attention.layer_norm_rms_epsilon", 0.00001)
    kv_str(b, "tokenizer.ggml.model", "llama")
    mut vocab := Vector {} as Vector<str>
    vocab.push("<unk>")
    vocab.push("<s>")
    vocab.push("</s>")
    vocab.push("\xE2\x96\x81")
    vocab.push("a")
    vocab.push("b")
    vocab.push("\xE2\x96\x81a")
    vocab.push("\xE2\x96\x81b")
    kv_strs(b, "tokenizer.ggml.tokens", vocab)
    mut scores := Vector {} as Vector<f64>
    repeat 8 with i: scores.push(0.0 - (i as f64)) end
    kv_f32s(b, "tokenizer.ggml.scores", scores)
    kv_u32(b, "tokenizer.ggml.bos_token_id", 1)
    kv_u32(b, "tokenizer.ggml.eos_token_id", 2)
    l0 := gm.layers.get(0)
    mut off := 0
    off = tensor_info(b, "token_embd.weight", gm.tok_embed, off)
    off = tensor_info(b, "output_norm.weight", gm.out_norm, off)
    off = tensor_info(b, "blk.0.attn_norm.weight", l0.attn_norm, off)
    off = tensor_info(b, "blk.0.attn_q.weight", l0.wq, off)
    off = tensor_info(b, "blk.0.attn_k.weight", l0.wk, off)
    off = tensor_info(b, "blk.0.attn_v.weight", l0.wv, off)
    off = tensor_info(b, "blk.0.attn_output.weight", l0.wo, off)
    off = tensor_info(b, "blk.0.ffn_norm.weight", l0.ffn_norm, off)
    off = tensor_info(b, "blk.0.ffn_gate.weight", l0.w_gate, off)
    off = tensor_info(b, "blk.0.ffn_up.weight", l0.w_up, off)
    off = tensor_info(b, "blk.0.ffn_down.weight", l0.w_down, off)
    testing.AssertTrue(off > 0)
    until compress.BufLen(b) % 32 != 0: binary.WriteU8(b, 0) end
    tensor_data(b, gm.tok_embed)
    tensor_data(b, gm.out_norm)
    tensor_data(b, l0.attn_norm)
    tensor_data(b, l0.wq)
    tensor_data(b, l0.wk)
    tensor_data(b, l0.wv)
    tensor_data(b, l0.wo)
    tensor_data(b, l0.ffn_norm)
    tensor_data(b, l0.w_gate)
    tensor_data(b, l0.w_up)
    tensor_data(b, l0.w_down)
    dir := filepath.Join(os.TempDir(), "salam_llm_test")
    archive.EnsureDir(dir)
    path := filepath.Join(dir, "tiny.gguf")
    testing.AssertTrue(archive.WriteBinaryFileBuf(path, b))
    compress.BufFree(b)
    vocab.free()
    scores.free()

    mut lm := llm.Model {}
    mut lt := llm.Tokenizer {}
    testing.AssertTrue(llm.LoadGgufModel(path, lm, lt))
    testing.AssertEqInt(lm.cfg.vocab, 8)
    testing.AssertEqInt(lm.cfg.dim, 4)
    testing.AssertEqInt(lm.cfg.heads, 2)
    testing.AssertEqInt(lm.cfg.kv_heads, 1)
    testing.AssertEqInt(lm.cfg.ff, 8)
    testing.AssertEqInt(lm.cfg.ctx, 8)
    testing.AssertEqInt(lm.cfg.rope_kind, llm.ROPE_NORMAL)
    testing.AssertTrue(lm.out_head.is_empty())
    testing.AssertEqInt(lt.size(), 8)
    testing.AssertEqInt(lt.bos, 1)
    testing.AssertEqInt(lt.eos, 2)
    mut pids := lt.encode("a b")
    testing.AssertEqInt(pids.len(), 3)
    testing.AssertEqInt(pids.get(1), 6)
    testing.AssertEqInt(pids.get(2), 7)
    text_d := lt.decode(pids)
    testing.AssertTrue(str.Equals(text_d, "a b"))
    mem.Free(text_d as void*)
    // same logits from the loaded weights
    mut c1 := llm.NewKVCache(gcfg)
    mut c2 := llm.NewKVCache(gcfg)
    mut la := llm.Forward(gm, c1, pids)
    mut lb := llm.Forward(lm, c2, pids)
    testing.AssertTrue(tensor.AllClose(la, lb, 0.00001))
    la.free()
    lb.free()
    // text in, text out, deterministic under greedy
    c1.reset()
    c2.reset()
    mut g1 := llm.GenerateIds(lm, c1, pids, 3, greedy, lt.eos)
    text1 := lt.decode(g1)
    mut c3 := llm.NewKVCache(gcfg)
    text2 := llm.Generate(lm, c3, lt, "a b", 3, greedy)
    testing.AssertTrue(str.Equals(text1, text2))
    mem.Free(text1 as void*)
    mem.Free(text2 as void*)
    testing.AssertTrue(g1.len() <= 3)
    g1.free()
    pids.free()
    c1.free()
    c2.free()
    c3.free()
    lm.free()
    lt.free()
    gm.free()

    ret testing.Summary()
end
