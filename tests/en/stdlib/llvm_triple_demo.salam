package main

import llvm.triple

func main:
    println triple.PointerBits("x86_64-unknown-linux-gnu")
    println triple.PointerBits("aarch64-apple-darwin")
    println triple.PointerBits("i686-unknown-linux-gnu")
    println triple.PointerBits("wasm32-unknown-wasi")
    println triple.PointerBits("msp430-none-elf")
    println triple.PointerBits("armv7-unknown-linux-gnueabihf")
    println triple.PointerBits("") == triple.PointerBits("unknown-thing")

    println triple.IsGlibc("x86_64-unknown-linux-gnu")
    println triple.IsGlibc("x86_64-unknown-linux-musl")
    println triple.IsGlibc("aarch64-apple-darwin")
    println triple.IsGlibc("x86_64-pc-windows-msvc")
    println triple.IsGlibc("wasm32-unknown-wasi")
    println triple.IsGlibc("")

    println triple.IsWindows("x86_64-pc-windows-msvc")
    println triple.IsWindows("x86_64-w64-mingw32")
    println triple.IsWindows("x86_64-unknown-linux-gnu")

    println triple.Datalayout("x86_64-unknown-linux-gnu")
    println triple.Datalayout("x86_64-pc-windows-msvc")
    println triple.Datalayout("x86_64-apple-darwin")
    println triple.Datalayout("aarch64-unknown-linux-gnu")
    println triple.Datalayout("aarch64-apple-darwin")
    println triple.Datalayout("i686-unknown-linux-gnu")
    println triple.Datalayout("riscv64-unknown-linux-gnu")
    println triple.Datalayout("armv7-unknown-linux-gnueabihf")
    println triple.Datalayout("armebv7-unknown-linux-gnueabihf")
    println triple.Datalayout("wasm32-unknown-wasi").Len()
    println triple.Datalayout("") == triple.HostDatalayout()
    println triple.HostDatalayout().Len() > 0
end
