package main

import log
import fs.path
import io
import str
import os

func vec(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push(a)
    v.Push(b)
    ret v
end

func main:
    log.ShowTime(false)
    log.SetLevel(log.LevelDebug)
    log.ToStdout()
    log.SetPrefix("app")

    println "format default: ", log.GetFormat()
    log.Debugf("loaded {} items", vec("3", "unused"))
    log.Errorf("failed {} on {}", vec("write", "disk"))
    log.Warnf("careful {}", vec("now", "unused"))
    log.Infof("hello {}", vec("world", "unused"))

    keys := vec("user", "role")
    vals := vec("ali", "admin user")
    log.DebugKV("debug kv", keys, vals)
    log.InfoKV("info kv", keys, vals)
    log.WarnKV("warn kv", keys, vals)
    log.ErrorKV("error kv", keys, vals)

    log.SetFormat(log.FormatJSON)
    println "format json: ", log.GetFormat()
    log.InfoKV("json kv", keys, vals)
    log.SetFormat(log.FormatText)

    dir := path.Join(os.TempDir(), "salam_log_api_test")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    file := path.Join(dir, "app.log")

    println "to file: ", log.ToFile(file)
    log.Info("into the file")
    log.WarnKV("file kv", keys, vals)
    log.CloseFile()
    log.Info("back on stdout")
    println "file content:"
    print io.ReadFile(file)

    log.SetRotation(60 as i64, 2)
    println "to file again: ", log.ToFile(file)
    repeat 6 in i:
        log.Infof("rotating line {}", vec(conv_str(i), "unused"))
    end
    log.CloseFile()
    println "rotated backup: ", os.Exists(file.Concat(".1"))
    println "second backup: ", os.Exists(file.Concat(".2"))
    println "no third backup: ", os.Exists(file.Concat(".3"))

    println "bad path: ", log.ToFile(path.Join(dir, "missing/sub/app.log"))
    os.RemoveAll(dir)
end

func conv_str(i: int): str:
    ret str.FromInt(i as i64)
end
