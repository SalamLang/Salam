package main

import log

func main:
    log.ShowTime(false)
    log.SetLevel(log.LevelDebug)
    log.ToStdout()
    log.SetPrefix("async")

    started := log.StartAsync(8 as i64)
    again := log.StartAsync(8 as i64)
    log.Debug("one")
    log.Info("two")
    log.Warn("three")
    log.Flush()
    running := log.IsAsync()

    log.StopAsync()
    stopped := log.IsAsync()

    restarted := log.StartAsync(2 as i64)
    log.Error("four")
    log.StopAsync()

    println "start:", started
    println "again:", again
    println "async:", running
    println "stopped:", stopped
    println "restart:", restarted
    println "done"
end
