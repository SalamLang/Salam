package main

import log
import mem
import io
import os
import str
import fs.path

struct Arg:
    pub id: i64 = 0
end

func worker(p: Arg*):
    a := p[0]
    mut i := 0 as i64
    until i < 100:
        log.Info("worker " + str.FromInt(a.id) + " line " + str.FromInt(i))
        i++
    end
end

func main:
    dir := path.Join(os.TempDir(), "salam_log_async_load")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    file := path.Join(dir, "app.log")

    log.ShowTime(false)
    log.SetLevel(log.LevelInfo)
    log.ToFile(file)
    log.StartAsync(16 as i64)

    mut threads := Vector {} as Vector<Arg*>
    mut ids := Vector {} as Vector<i64>
    repeat 4 in w:
        p := mem.MustAllocateZeroed(sizeof(Arg) as u64) as Arg*
        p[0] = Arg { id = w as i64 }
        threads.push(p)
        ids.push(spawn(worker, p))
    end
    repeat threads.Len() in i:
        join(ids.get(i))
    end
    log.StopAsync()
    log.CloseFile()

    text := io.ReadFile(file)
    lines := str.Split(str.TrimSuffix(text, "\n"), "\n")
    println "lines:", lines.Len()
    mut all := true
    repeat 4 in w:
        needle := "worker " + str.FromInt(w as i64) + " "
        mut count := 0
        each line in lines:
            if str.Contains(line, needle):
                count++
            end
        end
        println "worker", w, count
        if count != 100:
            all = false
        end
    end
    println "all:", all

    repeat threads.Len() in i:
        mem.Free(threads.get(i) as void*)
    end
    ids.free()
    threads.free()
    lines.free()
    os.RemoveAll(dir)
end
