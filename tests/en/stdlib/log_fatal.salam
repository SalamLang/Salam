package main

import log
import fs.path
import io
import os
import os.process

func main:
    dir := path.Join(os.TempDir(), "salam_log_fatal_test")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    file := path.Join(dir, "fatal.log")

    pid := process.Fork()
    if pid == 0:
        log.ShowTime(false)
        log.ToFile(file)
        log.Fatal("cannot continue")
    end
    if pid < 0:
        println "fork unavailable"
        os.RemoveAll(dir)
        ret 0
    end
    println "child exit: ", process.WaitPid(pid)
    print io.ReadFile(file)
    os.RemoveAll(dir)
    ret 0
end
