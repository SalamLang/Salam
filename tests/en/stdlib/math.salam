package mathx

pub func AbsI(n: int): int:
    if n < 0:
        ret 0 - n
    end
    ret n
end

pub func MaxI(a: int, b: int): int:
    if a > b:
        ret a
    end
    ret b
end

pub func Square(n: int): int:
    ret n * n
end
