import math
import matrix

func main:
    println math.Cbrt(27.0), math.Cbrt(-27.0), math.Cbrt(8.0) == 2.0, math.Cbrt(0.0), math.Cbrt(2.0)
    mut m := matrix.Full(1, 1, -8.0)
    println matrix.Cbrt(m).at(0, 0)
end
