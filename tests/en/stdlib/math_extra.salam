package main

import math

func near(x: f64): f64:
    ret math.Round(x * 1000000.0) / 1000000.0
end

func main:
    println "integers"
    println math.AbsI64(0 - 9000000000 as i64), math.AbsI64(9000000000 as i64), math.AbsI64(0 as i64)
    i64min := 0 - 9223372036854775807 as i64 - 1
    i32min := 0 - 2147483647 - 1
    println math.AbsI64(i64min), math.AbsI(i32min), math.AbsI(0 - 2147483647)

    println "gcd and lcm at the minimum"
    println math.GcdI64(i64min, 4), math.GcdI64(4, i64min), math.GcdI64(i64min, 0 - 1), math.GcdI64(i64min, 6)
    println math.GcdI64(i64min, i64min), math.GcdI64(i64min, 0), math.GcdI64(0 - 48, 18)
    println math.Gcd(i32min, 4), math.Gcd(4, i32min), math.Gcd(i32min, 0 - 1), math.Gcd(i32min, i32min)
    println math.Lcm(0 - 4, 6), math.Lcm(i32min, 2), math.Lcm(i32min, 3), math.Lcm(65536, 65537), math.Lcm(0, 5)
    println math.Factorial(20), math.Factorial(21), math.Factorial(0)

    println "angles"
    println near(math.Radians(180.0)), near(math.Radians(90.0)), near(math.Radians(0.0 - 45.0))
    println near(math.Degrees(math.PI)), near(math.Degrees(math.PI / 2.0)), near(math.Degrees(0.0))
    println near(math.Degrees(math.Radians(37.5)))

    println "atan2 by quadrant"
    println near(math.Atan2(1.0, 1.0)), near(math.Atan2(1.0, 0.0 - 1.0))
    println near(math.Atan2(0.0 - 1.0, 0.0 - 1.0)), near(math.Atan2(0.0 - 1.0, 1.0))
    println near(math.Degrees(math.Atan2(0.0, 0.0 - 1.0))), math.Atan2(0.0, 1.0)

    println "hypotenuse"
    println math.Hypot(3.0, 4.0), math.Hypot(0.0 - 3.0, 4.0), math.Hypot(0.0, 0.0)
    println near(math.Hypot(1.0, 1.0))

    println "clamping floats"
    println math.ClampF(5.5, 0.0, 10.0), math.ClampF(0.0 - 3.0, 0.0, 10.0), math.ClampF(42.0, 0.0, 10.0)
    println math.ClampF(0.0, 0.0, 0.0), math.ClampF(0.5, 0.0, 1.0)
end
