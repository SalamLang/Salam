package main

// std/matrix: the core type, its constructors and its accessors.

import matrix
import testing

func fill(m &: matrix.Matrix, base: f64):
    repeat m.count() with k: m.a.set(k, base + (k as f64)) end
end

func main:
    eps := 0.000000001

    // Zeros / Ones / Full
    mut z := matrix.Zeros(2, 3)
    testing.AssertEqInt(z.rows, 2)
    testing.AssertEqInt(z.cols, 3)
    testing.AssertEqInt(z.count(), 6)
    testing.AssertEqFloat(z.at(1, 2), 0.0, eps)

    mut o := matrix.Ones(2, 2)
    testing.AssertEqFloat(o.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(o.at(1, 1), 1.0, eps)

    mut f := matrix.Full(2, 2, 7.5)
    testing.AssertEqFloat(f.at(0, 1), 7.5, eps)

    // Eye and its offset form
    mut e := matrix.Eye(3)
    testing.AssertEqFloat(e.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(e.at(0, 1), 0.0, eps)
    testing.AssertTrue(e.is_square())

    mut eo := matrix.EyeOffset(3, 4, 1)
    testing.AssertEqFloat(eo.at(0, 1), 1.0, eps)
    testing.AssertEqFloat(eo.at(2, 3), 1.0, eps)
    testing.AssertEqFloat(eo.at(0, 0), 0.0, eps)

    // Accessors: at / set / add_at / mul_at / flat
    mut a := matrix.Zeros(2, 2)
    a.set(0, 0, 3.0)
    a.add_at(0, 0, 2.0)
    testing.AssertEqFloat(a.at(0, 0), 5.0, eps)
    a.mul_at(0, 0, 2.0)
    testing.AssertEqFloat(a.at(0, 0), 10.0, eps)
    a.set_flat(3, 4.0)
    testing.AssertEqFloat(a.flat(3), 4.0, eps)
    testing.AssertEqFloat(a.at(1, 1), 4.0, eps)

    // min_dim, is_empty, same_shape
    mut tall := matrix.Zeros(5, 2)
    testing.AssertEqInt(tall.min_dim(), 2)
    testing.AssertFalse(tall.is_empty())
    mut same := matrix.Zeros(5, 2)
    testing.AssertTrue(tall.same_shape(same))
    testing.AssertFalse(tall.same_shape(z))
    testing.AssertTrue(matrix.Zeros(0, 0).is_empty())

    // Diag builds from a vector, Diagonal reads one back
    mut dv := matrix.Zeros(1, 3)
    dv.set(0, 0, 1.0)
    dv.set(0, 1, 2.0)
    dv.set(0, 2, 3.0)
    mut d := matrix.Diag(dv.a)
    testing.AssertEqInt(d.rows, 3)
    testing.AssertEqFloat(d.at(1, 1), 2.0, eps)
    testing.AssertEqFloat(d.at(0, 1), 0.0, eps)

    // Clone is a deep copy, CopyInto reuses the destination
    mut src := matrix.Zeros(2, 2)
    fill(src, 1.0)
    mut cp := matrix.Clone(src)
    src.set(0, 0, 99.0)
    testing.AssertEqFloat(cp.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(src.at(0, 0), 99.0, eps)
    matrix.CopyInto(cp, src)
    testing.AssertEqFloat(cp.at(0, 0), 99.0, eps)

    // SetAll
    matrix.SetAll(cp, 2.5)
    testing.AssertEqFloat(cp.at(1, 1), 2.5, eps)

    // FromArray copies row-major
    mut fa := matrix.FromArray(2, 2, src.a)
    testing.AssertEqFloat(fa.at(0, 1), 2.0, eps)
    testing.AssertEqFloat(fa.at(1, 0), 3.0, eps)

    // Row and column vectors
    rv := matrix.RowVector(dv.a)
    testing.AssertEqInt(rv.rows, 1)
    testing.AssertEqInt(rv.cols, 3)
    cv := matrix.ColVector(dv.a)
    testing.AssertEqInt(cv.rows, 3)
    testing.AssertEqInt(cv.cols, 1)

    // Linspace hits both endpoints exactly
    mut ls := matrix.Linspace(0.0, 1.0, 5)
    testing.AssertEqInt(ls.cols, 5)
    testing.AssertEqFloat(ls.at(0, 0), 0.0, eps)
    testing.AssertEqFloat(ls.at(0, 2), 0.5, eps)
    testing.AssertEqFloat(ls.at(0, 4), 1.0, eps)
    testing.AssertEqInt(matrix.Linspace(3.0, 4.0, 1).cols, 1)

    // Arange is half-open and honours a negative step
    mut ar := matrix.Arange(0.0, 5.0, 2.0)
    testing.AssertEqInt(ar.cols, 3)
    testing.AssertEqFloat(ar.at(0, 2), 4.0, eps)
    mut ad := matrix.Arange(3.0, 0.0, 0.0 - 1.0)
    testing.AssertEqInt(ad.cols, 3)
    testing.AssertEqFloat(ad.at(0, 2), 1.0, eps)

    // Logspace: 10^0 .. 10^2
    mut lg := matrix.Logspace(0.0, 2.0, 3, 10.0)
    testing.AssertEqFloat(lg.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(lg.at(0, 1), 10.0, eps)
    testing.AssertEqFloat(lg.at(0, 2), 100.0, eps)

    // The advertised constants
    testing.AssertTrue(matrix.MAT_EPS > 0.0)
    testing.AssertTrue(matrix.MAT_TOL > matrix.MAT_EPS)
    testing.AssertTrue(matrix.MAT_INF > 1.0e200)

    ret testing.Summary()
end
