package main

import matrix
import testing

func mk(r: int, c: int, base: f64): matrix.Matrix:
    mut m := matrix.Zeros(r, c)
    repeat m.count() in k: m.a.Set(k, base + (k as f64)) end
    ret m
end

func at(m: matrix.Matrix, i: int, j: int): f64: ret m.at(i, j) end

func check_binary(eps: f64):
    mut a := mk(2, 2, 1.0)
    mut b := mk(2, 2, 5.0)
    testing.AssertEqFloat(at(matrix.Add(a, b), 0, 0), 6.0, eps)
    testing.AssertEqFloat(at(matrix.Add(a, b), 1, 1), 12.0, eps)
    testing.AssertEqFloat(at(matrix.Sub(b, a), 0, 0), 4.0, eps)
    testing.AssertEqFloat(at(matrix.MulElem(a, b), 1, 1), 32.0, eps)
    testing.AssertEqFloat(at(matrix.DivElem(b, a), 1, 1), 2.0, eps)

    mut zed := matrix.Zeros(2, 2)
    testing.AssertEqFloat(at(matrix.DivElem(a, zed), 0, 0), 0.0, eps)

    mut wrong := matrix.Zeros(3, 3)
    mut bad := matrix.Add(a, wrong)
    testing.AssertTrue(bad.IsEmpty())

    defer a.Free()
    defer b.Free()
    defer zed.Free()
    defer wrong.Free()
    defer bad.Free()
end

func check_scalar(eps: f64):
    mut a := mk(2, 2, 1.0)
    mut b := mk(2, 2, 5.0)
    testing.AssertEqFloat(at(matrix.Scale(a, 3.0), 1, 1), 12.0, eps)
    testing.AssertEqFloat(at(matrix.AddScalar(a, 10.0), 0, 0), 11.0, eps)
    testing.AssertEqFloat(at(matrix.SubScalar(a, 1.0), 0, 0), 0.0, eps)
    testing.AssertEqFloat(at(matrix.DivScalar(b, 5.0), 0, 0), 1.0, eps)
    testing.AssertEqFloat(at(matrix.Neg(a), 1, 1), 0.0 - 4.0, eps)
    defer a.Free()
    defer b.Free()
end

func check_in_place(eps: f64):
    mut a := mk(2, 2, 1.0)
    mut b := mk(2, 2, 5.0)
    mut ip := matrix.Clone(a)
    matrix.AddInPlace(ip, b)
    testing.AssertEqFloat(ip.at(0, 0), 6.0, eps)
    matrix.SubInPlace(ip, b)
    testing.AssertEqFloat(ip.at(0, 0), 1.0, eps)
    matrix.ScaleInPlace(ip, 2.0)
    testing.AssertEqFloat(ip.at(0, 0), 2.0, eps)
    matrix.AddScalarInPlace(ip, 1.0)
    testing.AssertEqFloat(ip.at(0, 0), 3.0, eps)
    matrix.NegInPlace(ip)
    testing.AssertEqFloat(ip.at(0, 0), 0.0 - 3.0, eps)

    mut minus := matrix.Full(2, 2, 0.0 - 1.0)
    matrix.MulElemInPlace(ip, minus)
    testing.AssertEqFloat(ip.at(0, 0), 3.0, eps)

    mut ax := matrix.Clone(a)
    matrix.AddScaled(ax, b, 2.0)
    testing.AssertEqFloat(ax.at(0, 0), 11.0, eps)
    testing.AssertEqFloat(at(matrix.Combine(a, 2.0, b, 0.0 - 1.0), 0, 0), 0.0 - 3.0, eps)

    defer a.Free()
    defer b.Free()
    defer ip.Free()
    defer ax.Free()
    defer minus.Free()
end

func check_pairwise(eps: f64):
    mut a := mk(2, 2, 1.0)
    mut three := matrix.Full(2, 2, 3.0)
    testing.AssertEqFloat(at(matrix.MaxElem(a, three), 0, 0), 3.0, eps)
    testing.AssertEqFloat(at(matrix.MaxElem(a, three), 1, 1), 4.0, eps)
    testing.AssertEqFloat(at(matrix.MinElem(a, three), 0, 0), 1.0, eps)
    testing.AssertEqFloat(at(matrix.MinElem(a, three), 1, 1), 3.0, eps)
    defer a.Free()
    defer three.Free()
end

func check_ufuncs(eps: f64):
    mut neg := matrix.Full(2, 2, 0.0 - 2.5)
    testing.AssertEqFloat(at(matrix.Abs(neg), 0, 0), 2.5, eps)
    testing.AssertEqFloat(at(matrix.Sign(neg), 0, 0), 0.0 - 1.0, eps)

    mut nine := matrix.Full(1, 1, 9.0)
    testing.AssertEqFloat(at(matrix.Sqrt(nine), 0, 0), 3.0, eps)
    mut three := matrix.Full(1, 1, 3.0)
    testing.AssertEqFloat(at(matrix.Square(three), 0, 0), 9.0, eps)

    mut zero := matrix.Zeros(1, 1)
    testing.AssertEqFloat(at(matrix.Exp(zero), 0, 0), 1.0, eps)
    testing.AssertEqFloat(at(matrix.Sin(zero), 0, 0), 0.0, eps)
    testing.AssertEqFloat(at(matrix.Cos(zero), 0, 0), 1.0, eps)
    testing.AssertEqFloat(at(matrix.Tan(zero), 0, 0), 0.0, eps)
    testing.AssertEqFloat(at(matrix.Sinh(zero), 0, 0), 0.0, eps)
    testing.AssertEqFloat(at(matrix.Cosh(zero), 0, 0), 1.0, eps)
    testing.AssertEqFloat(at(matrix.Tanh(zero), 0, 0), 0.0, eps)
    testing.AssertEqFloat(at(matrix.Asin(zero), 0, 0), 0.0, eps)
    testing.AssertEqFloat(at(matrix.Atan(zero), 0, 0), 0.0, eps)

    mut one := matrix.Full(1, 1, 1.0)
    testing.AssertEqFloat(at(matrix.Log(one), 0, 0), 0.0, eps)
    testing.AssertEqFloat(at(matrix.Acos(one), 0, 0), 0.0, eps)

    mut thousand := matrix.Full(1, 1, 1000.0)
    testing.AssertEqFloat(at(matrix.Log10(thousand), 0, 0), 3.0, eps)
    mut eight := matrix.Full(1, 1, 8.0)
    testing.AssertEqFloat(at(matrix.Log2(eight), 0, 0), 3.0, eps)
    mut c27 := matrix.Full(1, 1, 27.0)
    testing.AssertEqFloat(at(matrix.Cbrt(c27), 0, 0), 3.0, eps)

    defer neg.Free()
    defer nine.Free()
    defer three.Free()
    defer zero.Free()
    defer one.Free()
    defer thousand.Free()
    defer eight.Free()
    defer c27.Free()
end

func check_rounding(eps: f64):
    mut hi := matrix.Full(1, 1, 2.7)
    mut lo := matrix.Full(1, 1, 2.1)
    mut mid := matrix.Full(1, 1, 2.6)
    mut neg := matrix.Full(1, 1, 0.0 - 2.7)
    mut four := matrix.Full(1, 1, 4.0)
    mut zero := matrix.Zeros(1, 1)
    testing.AssertEqFloat(at(matrix.Floor(hi), 0, 0), 2.0, eps)
    testing.AssertEqFloat(at(matrix.Ceil(lo), 0, 0), 3.0, eps)
    testing.AssertEqFloat(at(matrix.Round(mid), 0, 0), 3.0, eps)
    testing.AssertEqFloat(at(matrix.Trunc(neg), 0, 0), 0.0 - 2.0, eps)
    testing.AssertEqFloat(at(matrix.Reciprocal(four), 0, 0), 0.25, eps)
    testing.AssertEqFloat(at(matrix.Reciprocal(zero), 0, 0), 0.0, eps)
    defer hi.Free()
    defer lo.Free()
    defer mid.Free()
    defer neg.Free()
    defer four.Free()
    defer zero.Free()
end

func check_pow_and_clip(eps: f64):
    mut base := mk(1, 3, 2.0)
    testing.AssertEqFloat(at(matrix.PowElem(base, 3.0), 0, 0), 8.0, eps)
    testing.AssertEqFloat(at(matrix.PowElem(base, 3.0), 0, 1), 27.0, eps)
    testing.AssertEqFloat(at(matrix.PowElem(base, 3.0), 0, 2), 64.0, eps)

    mut four := matrix.Full(1, 1, 4.0)
    testing.AssertEqFloat(at(matrix.PowElem(four, 0.5), 0, 0), 2.0, eps)

    mut ramp := mk(1, 5, 0.0)
    testing.AssertEqFloat(at(matrix.Clip(ramp, 1.0, 3.0), 0, 0), 1.0, eps)
    testing.AssertEqFloat(at(matrix.Clip(ramp, 1.0, 3.0), 0, 2), 2.0, eps)
    testing.AssertEqFloat(at(matrix.Clip(ramp, 1.0, 3.0), 0, 4), 3.0, eps)

    mut minus5 := matrix.Full(1, 1, 0.0 - 5.0)
    mut plus5 := matrix.Full(1, 1, 5.0)
    testing.AssertEqFloat(at(matrix.MaxScalar(minus5, 0.0), 0, 0), 0.0, eps)
    testing.AssertEqFloat(at(matrix.MinScalar(plus5, 0.0), 0, 0), 0.0, eps)

    mut dust := matrix.Full(2, 2, 1.0e-18)
    testing.AssertEqFloat(at(matrix.Chop(dust, 1.0e-12), 0, 0), 0.0, eps)

    defer base.Free()
    defer four.Free()
    defer ramp.Free()
    defer minus5.Free()
    defer plus5.Free()
    defer dust.Free()
end

func check_broadcast(eps: f64):
    mut base := mk(2, 3, 1.0)
    mut row := mk(1, 3, 10.0)
    mut col := mk(2, 1, 100.0)
    testing.AssertEqFloat(at(matrix.AddRowVector(base, row), 0, 0), 11.0, eps)
    testing.AssertEqFloat(at(matrix.AddRowVector(base, row), 1, 2), 18.0, eps)
    testing.AssertEqFloat(at(matrix.AddColVector(base, col), 0, 0), 101.0, eps)
    testing.AssertEqFloat(at(matrix.AddColVector(base, col), 1, 0), 105.0, eps)
    testing.AssertEqFloat(at(matrix.MulRowVector(base, row), 0, 0), 10.0, eps)
    testing.AssertEqFloat(at(matrix.MulRowVector(base, row), 1, 2), 72.0, eps)
    testing.AssertEqFloat(at(matrix.MulColVector(base, col), 1, 0), 404.0, eps)

    mut wrong := matrix.AddRowVector(base, col)
    testing.AssertTrue(wrong.IsEmpty())

    defer base.Free()
    defer row.Free()
    defer col.Free()
    defer wrong.Free()
end

func main:
    eps := 0.000000001
    check_binary(eps)
    check_scalar(eps)
    check_in_place(eps)
    check_pairwise(eps)
    check_ufuncs(eps)
    check_rounding(eps)
    check_pow_and_clip(eps)
    check_broadcast(eps)
    ret testing.Summary()
end
