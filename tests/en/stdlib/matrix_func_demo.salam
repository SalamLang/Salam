package main

// std/matrix: matrix functions, which are not the entrywise ones.

import matrix
import math
import testing

func check_expm_basics():
    // exp(0) = I
    mut z := matrix.Zeros(3, 3)
    mut e0 := matrix.Expm(z)
    testing.AssertTrue(matrix.IsIdentity(e0, 0.000000001))

    // For a diagonal matrix the exponential is entrywise on the diagonal
    mut d := matrix.Zeros(2, 2)
    d.set(0, 0, 1.0)
    d.set(1, 1, 0.0 - 2.0)
    mut ed := matrix.Expm(d)
    testing.AssertEqFloat(ed.at(0, 0), 2.718281828459045, 0.0000001)
    testing.AssertEqFloat(ed.at(1, 1), 0.1353352832366127, 0.0000001)
    testing.AssertEqFloat(ed.at(0, 1), 0.0, 0.0000001)

    // The matrix exponential is not the entrywise one
    mut a := matrix.Zeros(2, 2)
    a.set(0, 0, 1.0)
    a.set(0, 1, 1.0)
    a.set(1, 1, 1.0)
    mut me := matrix.Expm(a)
    mut ee := matrix.Exp(a)
    testing.AssertFalse(matrix.AllClose(me, ee, 0.0001))
    // exp([[1,1],[0,1]]) = e * [[1,1],[0,1]]
    testing.AssertEqFloat(me.at(0, 0), 2.718281828459045, 0.0000001)
    testing.AssertEqFloat(me.at(0, 1), 2.718281828459045, 0.0000001)
    testing.AssertEqFloat(me.at(1, 0), 0.0, 0.0000001)

    defer z.free()
    defer e0.free()
    defer d.free()
    defer ed.free()
    defer a.free()
    defer me.free()
    defer ee.free()
end

func check_expm_properties():
    // det(exp A) = exp(trace A), which holds for every square A
    mut a := matrix.RandomNormal(4, 4, 21)
    matrix.ScaleInPlace(a, 0.3)
    mut e := matrix.Expm(a)
    testing.AssertEqFloat(matrix.Det(e), math.Exp(matrix.Trace(a)), 0.000001)

    // exp(A) is always invertible, with exp(-A) as its inverse
    mut na := matrix.Neg(a)
    mut en := matrix.Expm(na)
    mut p := matrix.MatMul(e, en)
    testing.AssertTrue(matrix.IsIdentity(p, 0.000001))

    // A skew-symmetric generator exponentiates to a rotation
    mut k := matrix.Zeros(2, 2)
    k.set(0, 1, 0.0 - 1.5707963267948966)
    k.set(1, 0, 1.5707963267948966)
    mut rot := matrix.Expm(k)
    mut want := matrix.Rotation2D(1.5707963267948966)
    testing.AssertTrue(matrix.AllClose(rot, want, 0.000001))
    testing.AssertTrue(matrix.IsOrthogonal(rot, 0.000001))

    // The scaling and squaring path: a large norm still comes out right
    mut big := matrix.Eye(2)
    matrix.ScaleInPlace(big, 20.0)
    mut eb := matrix.Expm(big)
    testing.AssertEqFloat(eb.at(0, 0), math.Exp(20.0), 1.0)
    testing.AssertEqFloat(eb.at(0, 1), 0.0, 0.000001)

    defer a.free()
    defer e.free()
    defer na.free()
    defer en.free()
    defer p.free()
    defer k.free()
    defer rot.free()
    defer want.free()
    defer big.free()
    defer eb.free()
end

func check_sqrtm():
    // A symmetric positive definite matrix, where the answer is unambiguous
    mut a := matrix.Zeros(2, 2)
    a.set(0, 0, 5.0)
    a.set(0, 1, 4.0)
    a.set(1, 0, 4.0)
    a.set(1, 1, 5.0)
    mut s := matrix.Sqrtm(a)
    mut ss := matrix.MatMul(s, s)
    testing.AssertTrue(matrix.AllClose(ss, a, 0.000001))

    // It agrees with the eigenvalue route for this class
    mut se := matrix.SqrtSym(a)
    testing.AssertTrue(matrix.AllClose(s, se, 0.000001))

    // A nonsymmetric matrix with positive eigenvalues also has a square root
    mut b := matrix.Zeros(2, 2)
    b.set(0, 0, 4.0)
    b.set(0, 1, 1.0)
    b.set(1, 0, 2.0)
    b.set(1, 1, 3.0)
    mut sb := matrix.Sqrtm(b)
    mut sbb := matrix.MatMul(sb, sb)
    testing.AssertTrue(matrix.AllClose(sbb, b, 0.000001))

    // sqrt(I) is I
    mut e := matrix.Eye(3)
    mut se3 := matrix.Sqrtm(e)
    testing.AssertTrue(matrix.IsIdentity(se3, 0.000001))

    defer a.free()
    defer s.free()
    defer ss.free()
    defer se.free()
    defer b.free()
    defer sb.free()
    defer sbb.free()
    defer e.free()
    defer se3.free()
end

func check_sign():
    // Eigenvalues 5 and 2, both positive, so the sign is the identity
    mut a := matrix.Zeros(2, 2)
    a.set(0, 0, 4.0)
    a.set(0, 1, 1.0)
    a.set(1, 0, 2.0)
    a.set(1, 1, 3.0)
    mut s := matrix.MatrixSign(a)
    testing.AssertTrue(matrix.IsIdentity(s, 0.000001))

    // diag(2, -3): the sign has the matching signs on the diagonal, and its
    // trace counts positive minus negative eigenvalues.
    mut d := matrix.Zeros(2, 2)
    d.set(0, 0, 2.0)
    d.set(1, 1, 0.0 - 3.0)
    mut sd := matrix.MatrixSign(d)
    testing.AssertEqFloat(sd.at(0, 0), 1.0, 0.000001)
    testing.AssertEqFloat(sd.at(1, 1), 0.0 - 1.0, 0.000001)
    testing.AssertEqFloat(matrix.Trace(sd), 0.0, 0.000001)

    // The sign function squares to the identity
    mut sq := matrix.MatMul(sd, sd)
    testing.AssertTrue(matrix.IsIdentity(sq, 0.000001))

    defer a.free()
    defer s.free()
    defer d.free()
    defer sd.free()
    defer sq.free()
end

func check_polyeval():
    mut a := matrix.Zeros(2, 2)
    a.set(0, 0, 1.0)
    a.set(0, 1, 2.0)
    a.set(1, 0, 3.0)
    a.set(1, 1, 4.0)

    // p(x) = 2 + 0x + 1x^2, so p(A) = 2I + A^2
    mut c := matrix.Zeros(1, 3)
    c.set(0, 0, 2.0)
    c.set(0, 1, 0.0)
    c.set(0, 2, 1.0)
    mut p := matrix.PolyEval(a, c)
    mut aa := matrix.MatMul(a, a)
    mut want := matrix.Clone(aa)
    matrix.ShiftDiagonal(want, 2.0)
    testing.AssertTrue(matrix.AllClose(p, want, 0.000001))

    // The constant polynomial becomes a multiple of the identity, not a scalar
    mut k := matrix.Zeros(1, 1)
    k.set(0, 0, 7.0)
    mut pk := matrix.PolyEval(a, k)
    testing.AssertEqFloat(pk.at(0, 0), 7.0, 0.000001)
    testing.AssertEqFloat(pk.at(1, 1), 7.0, 0.000001)
    testing.AssertEqFloat(pk.at(0, 1), 0.0, 0.000001)

    // Cayley-Hamilton: p_A(A) is zero, so what comes back is only rounding
    mut ch := matrix.CayleyHamilton(a)
    testing.AssertTrue(matrix.IsZero(ch, 0.000001))

    // And for a bigger matrix too
    mut b := matrix.RandomNormal(5, 5, 8)
    mut chb := matrix.CayleyHamilton(b)
    testing.AssertTrue(matrix.NormMax(chb) < 0.0001)

    defer a.free()
    defer c.free()
    defer p.free()
    defer aa.free()
    defer want.free()
    defer k.free()
    defer pk.free()
    defer ch.free()
    defer b.free()
    defer chb.free()
end

func check_logm():
    // log and exp undo each other on a symmetric positive definite matrix
    mut a := matrix.RandomSPD(4, 31)
    mut l := matrix.LogmSym(a)
    testing.AssertFalse(l.is_empty())
    testing.AssertTrue(matrix.IsSymmetric(l, 0.000001))
    mut back := matrix.Expm(l)
    testing.AssertTrue(matrix.AllClose(back, a, 0.00001))

    // log(I) = 0
    mut e := matrix.Eye(3)
    mut le := matrix.LogmSym(e)
    testing.AssertTrue(matrix.IsZero(le, 0.000001))

    // A matrix with a nonpositive eigenvalue has no real symmetric logarithm
    mut neg := matrix.Eye(2)
    neg.set(1, 1, 0.0 - 1.0)
    mut none := matrix.LogmSym(neg)
    testing.AssertTrue(none.is_empty())

    defer a.free()
    defer l.free()
    defer back.free()
    defer e.free()
    defer le.free()
    defer neg.free()
    defer none.free()
end

func main:
    check_expm_basics()
    check_expm_properties()
    check_sqrtm()
    check_sign()
    check_polyeval()
    check_logm()
    ret testing.Summary()
end
