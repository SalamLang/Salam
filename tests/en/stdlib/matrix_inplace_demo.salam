package main

import matrix
import testing

func fill(m &: matrix.Matrix, base: f64):
    repeat m.count() with k: m.a.set(k, base + (k as f64)) end
end

func main:
    eps := 0.000000001

    mut a := matrix.Zeros(2, 3)
    fill(a, 1.0)
    mut b := matrix.Zeros(3, 2)
    fill(b, 2.0)

    mut ta := matrix.Transpose(a)
    mut ti := matrix.Zeros(3, 2)
    testing.AssertTrue(matrix.TransposeInto(a, ti))
    repeat ta.count() with k:
        testing.AssertEqFloat(ti.a.get(k), ta.a.get(k), eps)
    end

    mut ab := matrix.MatMul(a, b)
    mut mi := matrix.Zeros(2, 2)
    testing.AssertTrue(matrix.MatMulInto(a, b, mi))
    repeat ab.count() with k:
        testing.AssertEqFloat(mi.a.get(k), ab.a.get(k), eps)
    end

    testing.AssertTrue(matrix.MatMulInto(a, b, mi))
    repeat ab.count() with k:
        testing.AssertEqFloat(mi.a.get(k), ab.a.get(k), eps)
    end

    mut wrong := matrix.Zeros(3, 3)
    testing.AssertFalse(matrix.MatMulInto(a, b, wrong))
    testing.AssertFalse(matrix.TransposeInto(a, wrong))
    testing.AssertEqFloat(wrong.at(0, 0), 0.0, eps)

    testing.AssertFalse(matrix.MatMulInto(a, a, mi))

    mut big := matrix.Zeros(12, 12)
    fill(big, 0.5)
    mut bt := matrix.Transpose(big)
    mut prod := matrix.MatMul(big, bt)
    mut into := matrix.Zeros(12, 12)
    testing.AssertTrue(matrix.MatMulInto(big, bt, into))
    repeat prod.count() with k:
        testing.AssertEqFloat(into.a.get(k), prod.a.get(k), eps)
    end

    a.free()
    b.free()
    ta.free()
    ti.free()
    ab.free()
    mi.free()
    wrong.free()
    big.free()
    bt.free()
    prod.free()
    into.free()

    ret testing.Summary()
end
