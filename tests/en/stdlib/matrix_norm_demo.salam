package main

// std/matrix: norms, distances and condition numbers.

import matrix
import math
import testing

func mk(r: int, c: int, base: f64): matrix.Matrix:
    mut m := matrix.Zeros(r, c)
    repeat m.count() with k: m.a.set(k, base + (k as f64)) end
    ret m
end

func check_matrix_norms():
    // [[1,-2],[-3,4]]
    mut a := matrix.Zeros(2, 2)
    a.set(0, 0, 1.0)
    a.set(0, 1, 0.0 - 2.0)
    a.set(1, 0, 0.0 - 3.0)
    a.set(1, 1, 4.0)

    // sqrt(1+4+9+16) = sqrt(30)
    testing.AssertEqFloat(matrix.NormFrobenius(a), math.Sqrt(30.0), 0.000000001)
    // Largest absolute column sum: |1|+|-3| = 4, |-2|+|4| = 6
    testing.AssertEqFloat(matrix.Norm1(a), 6.0, 0.000000001)
    // Largest absolute row sum: 3 and 7
    testing.AssertEqFloat(matrix.NormInf(a), 7.0, 0.000000001)
    testing.AssertEqFloat(matrix.NormMax(a), 4.0, 0.000000001)

    // Every norm of the zero matrix is zero
    mut z := matrix.Zeros(3, 3)
    testing.AssertEqFloat(matrix.NormFrobenius(z), 0.0, 0.000000001)
    testing.AssertEqFloat(matrix.Norm1(z), 0.0, 0.000000001)
    testing.AssertEqFloat(matrix.NormInf(z), 0.0, 0.000000001)

    // The Frobenius norm of the identity is sqrt(n)
    mut e := matrix.Eye(9)
    testing.AssertEqFloat(matrix.NormFrobenius(e), 3.0, 0.000000001)
    testing.AssertEqFloat(matrix.Norm1(e), 1.0, 0.000000001)
    testing.AssertEqFloat(matrix.Norm2(e), 1.0, 0.000001)

    defer a.free()
    defer z.free()
    defer e.free()
end

func check_overflow_safety():
    // The scaling in NormFrobenius is what keeps these finite. Summing the
    // squares directly would overflow the first and underflow the second.
    mut big := matrix.Full(2, 2, 1.0e200)
    fb := matrix.NormFrobenius(big)
    testing.AssertTrue(fb > 0.0)
    testing.AssertFalse(math.IsInf(fb))
    testing.AssertEqFloat(fb / 1.0e200, 2.0, 0.000001)

    mut tiny := matrix.Full(2, 2, 1.0e-200)
    ft := matrix.NormFrobenius(tiny)
    testing.AssertTrue(ft > 0.0)
    testing.AssertEqFloat(ft / 1.0e-200, 2.0, 0.000001)

    defer big.free()
    defer tiny.free()
end

func check_norm_laws():
    mut a := mk(3, 3, 1.0)
    mut b := mk(3, 3, 2.0)

    // Absolute homogeneity: |cA| = |c| |A|
    mut s := matrix.Scale(a, 0.0 - 3.0)
    testing.AssertEqFloat(matrix.NormFrobenius(s), 3.0 * matrix.NormFrobenius(a), 0.0000001)
    testing.AssertEqFloat(matrix.Norm1(s), 3.0 * matrix.Norm1(a), 0.0000001)

    // The triangle inequality
    mut sum := matrix.Add(a, b)
    testing.AssertTrue(matrix.NormFrobenius(sum) <= matrix.NormFrobenius(a) + matrix.NormFrobenius(b) + 0.000001)
    testing.AssertTrue(matrix.NormInf(sum) <= matrix.NormInf(a) + matrix.NormInf(b) + 0.000001)

    // Submultiplicativity, which the three operator norms have and NormMax
    // does not
    mut p := matrix.MatMul(a, b)
    testing.AssertTrue(matrix.Norm1(p) <= matrix.Norm1(a) * matrix.Norm1(b) + 0.000001)
    testing.AssertTrue(matrix.NormInf(p) <= matrix.NormInf(a) * matrix.NormInf(b) + 0.000001)
    testing.AssertTrue(matrix.NormFrobenius(p) <= matrix.NormFrobenius(a) * matrix.NormFrobenius(b) + 0.000001)

    // The spectral norm is the tightest of them
    testing.AssertTrue(matrix.Norm2(a) <= matrix.NormFrobenius(a) + 0.000001)

    defer a.free()
    defer b.free()
    defer s.free()
    defer sum.free()
    defer p.free()
end

func check_vector_norms():
    // The 3-4-5 triangle
    mut v := matrix.Zeros(1, 2)
    v.set(0, 0, 3.0)
    v.set(0, 1, 0.0 - 4.0)
    testing.AssertEqFloat(matrix.VecNorm(v, 1.0), 7.0, 0.000001)
    testing.AssertEqFloat(matrix.VecNorm(v, 2.0), 5.0, 0.000001)
    testing.AssertEqFloat(matrix.VecNorm(v, 3.0), 4.497941445275415, 0.000001)
    // p <= 0 is read as the infinity norm
    testing.AssertEqFloat(matrix.VecNorm(v, 0.0), 4.0, 0.000001)
    // A large p converges to it
    testing.AssertEqFloat(matrix.VecNorm(v, 200.0), 4.0, 0.001)

    mut z := matrix.Zeros(1, 3)
    testing.AssertEqFloat(matrix.VecNorm(z, 2.0), 0.0, 0.000000001)

    defer v.free()
    defer z.free()
end

func check_distance_and_normalize():
    mut a := mk(2, 2, 1.0)
    mut b := mk(2, 2, 1.0)
    testing.AssertEqFloat(matrix.Distance(a, b), 0.0, 0.000000001)

    b.add_at(0, 0, 3.0)
    b.add_at(1, 1, 4.0)
    testing.AssertEqFloat(matrix.Distance(a, b), 5.0, 0.000000001)
    // Distance is symmetric
    testing.AssertEqFloat(matrix.Distance(b, a), 5.0, 0.000000001)
    // And undefined across shapes, reported as zero
    mut wrong := matrix.Zeros(3, 3)
    testing.AssertEqFloat(matrix.Distance(a, wrong), 0.0, 0.000000001)

    // Normalize gives unit Frobenius norm
    mut n := matrix.Normalize(a)
    testing.AssertEqFloat(matrix.NormFrobenius(n), 1.0, 0.000001)
    // A zero matrix is returned unchanged rather than divided by zero
    mut z := matrix.Zeros(2, 2)
    mut nz := matrix.Normalize(z)
    testing.AssertTrue(matrix.IsZero(nz, 0.0))

    // Row and column normalization give unit rows and columns
    mut r := mk(3, 3, 1.0)
    mut nr := matrix.NormalizeRows(r)
    repeat 3 with i:
        mut row := matrix.Row(nr, i)
        testing.AssertEqFloat(matrix.NormFrobenius(row), 1.0, 0.000001)
        row.free()
    end
    mut nc := matrix.NormalizeCols(r)
    repeat 3 with j:
        mut col := matrix.Col(nc, j)
        testing.AssertEqFloat(matrix.NormFrobenius(col), 1.0, 0.000001)
        col.free()
    end
    // A zero row stays zero
    mut withzero := matrix.Zeros(2, 2)
    withzero.set(0, 0, 3.0)
    withzero.set(0, 1, 4.0)
    mut nwz := matrix.NormalizeRows(withzero)
    testing.AssertEqFloat(nwz.at(0, 0), 0.6, 0.000001)
    testing.AssertEqFloat(nwz.at(1, 0), 0.0, 0.000001)

    defer a.free()
    defer b.free()
    defer wrong.free()
    defer n.free()
    defer z.free()
    defer nz.free()
    defer r.free()
    defer nr.free()
    defer nc.free()
    defer withzero.free()
    defer nwz.free()
end

func check_conditioning():
    // The identity is perfectly conditioned in every norm
    mut e := matrix.Eye(4)
    testing.AssertEqFloat(matrix.Cond1(e), 1.0, 0.000001)
    testing.AssertEqFloat(matrix.CondInf(e), 1.0, 0.000001)
    testing.AssertEqFloat(matrix.Cond2(e), 1.0, 0.000001)

    // Scaling a matrix does not change its condition number
    mut s := matrix.Scale(e, 1000.0)
    testing.AssertEqFloat(matrix.Cond2(s), 1.0, 0.000001)

    // diag(1, 100) has condition number exactly 100
    mut d := matrix.Eye(2)
    d.set(1, 1, 100.0)
    testing.AssertEqFloat(matrix.Cond2(d), 100.0, 0.000001)
    testing.AssertEqFloat(matrix.Cond1(d), 100.0, 0.000001)

    // A singular matrix has an infinite condition number in every norm
    mut sing := mk(3, 3, 1.0)
    testing.AssertTrue(matrix.Cond1(sing) >= matrix.MAT_INF)
    testing.AssertTrue(matrix.CondInf(sing) >= matrix.MAT_INF)
    testing.AssertTrue(matrix.Cond2(sing) > 1.0e15)

    // And a Hilbert matrix is the standard demonstration of a bad one
    mut h := matrix.Hilbert(5)
    testing.AssertTrue(matrix.Cond2(h) > 100000.0)
    testing.AssertTrue(matrix.Cond2(h) >= 1.0)

    defer e.free()
    defer s.free()
    defer d.free()
    defer sing.free()
    defer h.free()
end

func main:
    check_matrix_norms()
    check_overflow_safety()
    check_norm_laws()
    check_vector_norms()
    check_distance_and_normalize()
    check_conditioning()
    ret testing.Summary()
end
