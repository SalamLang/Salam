package main

// std/matrix: whole-matrix and per-axis reductions.

import matrix
import testing

func mk(r: int, c: int, base: f64): matrix.Matrix:
    mut m := matrix.Zeros(r, c)
    repeat m.count() with k: m.a.set(k, base + (k as f64)) end
    ret m
end

func check_whole(eps: f64):
    // [[1,2,3],[4,5,6]]
    mut a := mk(2, 3, 1.0)
    testing.AssertEqFloat(matrix.Sum(a), 21.0, eps)
    testing.AssertEqFloat(matrix.Mean(a), 3.5, eps)
    testing.AssertEqFloat(matrix.Prod(a), 720.0, eps)
    testing.AssertEqFloat(matrix.Min(a), 1.0, eps)
    testing.AssertEqFloat(matrix.Max(a), 6.0, eps)
    testing.AssertEqFloat(matrix.Range(a), 5.0, eps)
    testing.AssertEqFloat(matrix.Median(a), 3.5, eps)

    // Population variance of 1..6 is 35/12
    testing.AssertEqFloat(matrix.Var(a, false), 35.0 / 12.0, eps)
    // Sample variance is 3.5
    testing.AssertEqFloat(matrix.Var(a, true), 3.5, eps)
    testing.AssertEqFloat(matrix.Std(a, true) * matrix.Std(a, true), 3.5, eps)

    // Odd count takes the middle element
    mut odd := mk(1, 5, 1.0)
    testing.AssertEqFloat(matrix.Median(odd), 3.0, eps)

    mut neg := matrix.Full(2, 2, 0.0 - 7.0)
    testing.AssertEqFloat(matrix.MaxAbs(neg), 7.0, eps)

    // An empty matrix reduces without dividing by zero
    mut empty := matrix.Zeros(0, 0)
    testing.AssertEqFloat(matrix.Mean(empty), 0.0, eps)
    testing.AssertEqFloat(matrix.Sum(empty), 0.0, eps)

    a.free()
    odd.free()
    neg.free()
    empty.free()
end

func check_pairwise_sum(eps: f64):
    // Pairwise summation has to stay exact well past the 64-wide base case,
    // which is where a naive running total starts to drift.
    mut big := matrix.Full(1, 10000, 0.1)
    testing.AssertEqFloat(matrix.Sum(big), 1000.0, 0.0000001)
    testing.AssertEqFloat(matrix.Mean(big), 0.1, eps)
    big.free()
end

func check_argmin_argmax(eps: f64):
    mut a := mk(2, 3, 1.0)
    testing.AssertEqInt(matrix.ArgMin(a), 0)
    testing.AssertEqInt(matrix.ArgMax(a), 5)
    testing.AssertEqInt(matrix.IndexRow(a, 5), 1)
    testing.AssertEqInt(matrix.IndexCol(a, 5), 2)
    testing.AssertEqInt(matrix.IndexRow(a, 3), 1)
    testing.AssertEqInt(matrix.IndexCol(a, 3), 0)
    testing.AssertEqFloat(a.at(matrix.IndexRow(a, 4), matrix.IndexCol(a, 4)), 5.0, eps)
    a.free()
end

func check_axes(eps: f64):
    // [[1,2,3],[4,5,6]]
    mut a := mk(2, 3, 1.0)

    mut rs := matrix.RowSums(a)
    testing.AssertEqInt(rs.rows, 2)
    testing.AssertEqInt(rs.cols, 1)
    testing.AssertEqFloat(rs.at(0, 0), 6.0, eps)
    testing.AssertEqFloat(rs.at(1, 0), 15.0, eps)

    mut cs := matrix.ColSums(a)
    testing.AssertEqInt(cs.rows, 1)
    testing.AssertEqInt(cs.cols, 3)
    testing.AssertEqFloat(cs.at(0, 0), 5.0, eps)
    testing.AssertEqFloat(cs.at(0, 2), 9.0, eps)

    mut rm := matrix.RowMeans(a)
    testing.AssertEqFloat(rm.at(0, 0), 2.0, eps)
    testing.AssertEqFloat(rm.at(1, 0), 5.0, eps)

    mut cm := matrix.ColMeans(a)
    testing.AssertEqFloat(cm.at(0, 1), 3.5, eps)

    mut rmin := matrix.RowMins(a)
    testing.AssertEqFloat(rmin.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(rmin.at(1, 0), 4.0, eps)

    mut rmax := matrix.RowMaxs(a)
    testing.AssertEqFloat(rmax.at(1, 0), 6.0, eps)

    mut cmin := matrix.ColMins(a)
    testing.AssertEqFloat(cmin.at(0, 2), 3.0, eps)

    mut cmax := matrix.ColMaxs(a)
    testing.AssertEqFloat(cmax.at(0, 0), 4.0, eps)

    a.free()
    rs.free()
    cs.free()
    rm.free()
    cm.free()
    rmin.free()
    rmax.free()
    cmin.free()
    cmax.free()
end

func check_cumulative(eps: f64):
    mut a := mk(2, 3, 1.0)

    mut cr := matrix.CumSumRows(a)
    testing.AssertEqFloat(cr.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(cr.at(0, 1), 3.0, eps)
    testing.AssertEqFloat(cr.at(0, 2), 6.0, eps)
    testing.AssertEqFloat(cr.at(1, 2), 15.0, eps)

    mut cc := matrix.CumSumCols(a)
    testing.AssertEqFloat(cc.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(cc.at(1, 0), 5.0, eps)
    testing.AssertEqFloat(cc.at(1, 2), 9.0, eps)

    mut cp := matrix.CumProdRows(a)
    testing.AssertEqFloat(cp.at(0, 2), 6.0, eps)
    testing.AssertEqFloat(cp.at(1, 2), 120.0, eps)

    a.free()
    cr.free()
    cc.free()
    cp.free()
end

func check_predicates():
    mut a := mk(2, 3, 1.0)
    testing.AssertEqInt(matrix.CountNonZero(a), 6)
    testing.AssertTrue(matrix.Any(a))
    testing.AssertTrue(matrix.All(a))
    testing.AssertTrue(matrix.AllFinite(a))

    mut z := matrix.Zeros(2, 2)
    testing.AssertEqInt(matrix.CountNonZero(z), 0)
    testing.AssertFalse(matrix.Any(z))
    testing.AssertFalse(matrix.All(z))

    // One nonzero makes Any true but All false
    z.set(0, 0, 1.0)
    testing.AssertTrue(matrix.Any(z))
    testing.AssertFalse(matrix.All(z))
    testing.AssertEqInt(matrix.CountNonZero(z), 1)

    a.free()
    z.free()
end

func main:
    eps := 0.000000001
    check_whole(eps)
    check_pairwise_sum(eps)
    check_argmin_argmax(eps)
    check_axes(eps)
    check_cumulative(eps)
    check_predicates()
    ret testing.Summary()
end
