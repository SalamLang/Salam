package main


import matrix
import testing

func mk(r: int, c: int, base: f64): matrix.Matrix:
    mut m := matrix.Zeros(r, c)
    repeat m.count() with k: m.a.set(k, base + (k as f64)) end
    ret m
end

func check_rref():
    mut a := mk(3, 3, 1.0)
    mut r := matrix.RREF(a)
    testing.AssertEqFloat(r.at(0, 0), 1.0, 0.000001)
    testing.AssertEqFloat(r.at(0, 1), 0.0, 0.000001)
    testing.AssertEqFloat(r.at(0, 2), 0.0 - 1.0, 0.000001)
    testing.AssertEqFloat(r.at(1, 1), 1.0, 0.000001)
    testing.AssertEqFloat(r.at(1, 2), 2.0, 0.000001)
    testing.AssertEqFloat(r.at(2, 0), 0.0, 0.000001)
    testing.AssertEqFloat(r.at(2, 2), 0.0, 0.000001)

    mut e := matrix.Eye(3)
    mut spd := matrix.RandomSPD(3, 5)
    mut ri := matrix.RREF(spd)
    testing.AssertTrue(matrix.AllClose(ri, e, 0.000001))

    mut ref := matrix.RowEchelon(a)
    testing.AssertTrue(matrix.IsUpperTriangular(ref, 0.000001))

    defer a.free()
    defer r.free()
    defer e.free()
    defer spd.free()
    defer ri.free()
    defer ref.free()
end

func check_rank_and_pivots():
    mut a := mk(3, 3, 1.0)
    testing.AssertEqInt(matrix.RankExact(a), 2)
    testing.AssertEqInt(matrix.Nullity(a), 1)
    testing.AssertEqInt(matrix.RankExact(a) + matrix.Nullity(a), a.cols)
    testing.AssertEqInt(matrix.RankExact(a), matrix.MatrixRank(a, 0.0))

    mut piv := matrix.PivotColumns(a)
    testing.AssertEqInt(piv.cols, 2)
    testing.AssertEqFloat(piv.at(0, 0), 0.0, 0.000001)
    testing.AssertEqFloat(piv.at(0, 1), 1.0, 0.000001)

    mut e := matrix.Eye(4)
    testing.AssertEqInt(matrix.RankExact(e), 4)
    testing.AssertEqInt(matrix.Nullity(e), 0)

    mut z := matrix.Zeros(3, 3)
    testing.AssertEqInt(matrix.RankExact(z), 0)
    testing.AssertEqInt(matrix.Nullity(z), 3)

    defer a.free()
    defer piv.free()
    defer e.free()
    defer z.free()
end

func check_nullspace():
    mut a := mk(3, 3, 1.0)
    mut ns := matrix.NullSpaceExact(a)
    testing.AssertEqInt(ns.rows, 3)
    testing.AssertEqInt(ns.cols, 1)
    testing.AssertEqFloat(ns.at(0, 0), 1.0, 0.000001)
    testing.AssertEqFloat(ns.at(1, 0), 0.0 - 2.0, 0.000001)
    testing.AssertEqFloat(ns.at(2, 0), 1.0, 0.000001)

    mut an := matrix.MatMul(a, ns)
    testing.AssertTrue(matrix.IsZero(an, 0.000001))

    mut wide := mk(2, 4, 1.0)
    mut wns := matrix.NullSpaceExact(wide)
    testing.AssertEqInt(wns.cols, 2)
    mut wan := matrix.MatMul(wide, wns)
    testing.AssertTrue(matrix.IsZero(wan, 0.000001))

    mut e := matrix.Eye(3)
    mut none := matrix.NullSpaceExact(e)
    testing.AssertEqInt(none.cols, 0)

    defer a.free()
    defer ns.free()
    defer an.free()
    defer wide.free()
    defer wns.free()
    defer wan.free()
    defer e.free()
    defer none.free()
end

func check_column_space():
    mut a := mk(3, 3, 1.0)
    mut cs := matrix.ColumnSpaceExact(a)
    testing.AssertEqInt(cs.rows, 3)
    testing.AssertEqInt(cs.cols, 2)
    testing.AssertEqFloat(cs.at(0, 0), 1.0, 0.000001)
    testing.AssertEqFloat(cs.at(1, 0), 4.0, 0.000001)
    testing.AssertEqFloat(cs.at(0, 1), 2.0, 0.000001)

    defer a.free()
    defer cs.free()
end

func check_solve_general():
    mut a := matrix.Zeros(2, 2)
    a.set(0, 0, 2.0)
    a.set(0, 1, 1.0)
    a.set(1, 0, 1.0)
    a.set(1, 1, 3.0)
    mut b := matrix.Zeros(2, 1)
    b.set(0, 0, 5.0)
    b.set(1, 0, 10.0)
    testing.AssertTrue(matrix.IsConsistent(a, b))
    mut x := matrix.SolveGeneral(a, b)
    testing.AssertEqFloat(x.at(0, 0), 1.0, 0.000001)
    testing.AssertEqFloat(x.at(1, 0), 3.0, 0.000001)

    mut w := mk(2, 3, 1.0)
    mut wb := matrix.Zeros(2, 1)
    wb.set(0, 0, 6.0)
    wb.set(1, 0, 15.0)
    testing.AssertTrue(matrix.IsConsistent(w, wb))
    mut wx := matrix.SolveGeneral(w, wb)
    testing.AssertEqInt(wx.rows, 3)
    mut r := matrix.Residual(w, wx, wb)
    testing.AssertEqFloat(matrix.NormFrobenius(r), 0.0, 0.000001)

    mut ns := matrix.NullSpaceExact(w)
    mut alt := matrix.Add(wx, ns)
    mut r2 := matrix.Residual(w, alt, wb)
    testing.AssertEqFloat(matrix.NormFrobenius(r2), 0.0, 0.000001)

    mut sing := matrix.Zeros(2, 2)
    sing.set(0, 0, 1.0)
    sing.set(0, 1, 2.0)
    sing.set(1, 0, 2.0)
    sing.set(1, 1, 4.0)
    mut ib := matrix.Zeros(2, 1)
    ib.set(0, 0, 1.0)
    ib.set(1, 0, 5.0)
    testing.AssertFalse(matrix.IsConsistent(sing, ib))
    mut none := matrix.SolveGeneral(sing, ib)
    testing.AssertTrue(none.is_empty())

    defer a.free()
    defer b.free()
    defer x.free()
    defer w.free()
    defer wb.free()
    defer wx.free()
    defer r.free()
    defer ns.free()
    defer alt.free()
    defer r2.free()
    defer sing.free()
    defer ib.free()
    defer none.free()
end

func main:
    check_rref()
    check_rank_and_pivots()
    check_nullspace()
    check_column_space()
    check_solve_general()
    ret testing.Summary()
end
