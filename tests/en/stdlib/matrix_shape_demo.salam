package main

// std/matrix: reshaping, slicing and the elementary row operations.

import matrix
import testing

func mk(r: int, c: int, base: f64): matrix.Matrix:
    mut m := matrix.Zeros(r, c)
    repeat m.count() with k: m.a.set(k, base + (k as f64)) end
    ret m
end

func check_reshape(eps: f64):
    mut a := mk(2, 3, 1.0)
    mut r := matrix.Reshape(a, 3, 2)
    testing.AssertEqInt(r.rows, 3)
    testing.AssertEqInt(r.cols, 2)
    // Row-major reading order: 1 2 | 3 4 | 5 6
    testing.AssertEqFloat(r.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(r.at(0, 1), 2.0, eps)
    testing.AssertEqFloat(r.at(2, 1), 6.0, eps)

    mut bad := matrix.Reshape(a, 4, 4)
    testing.AssertTrue(bad.is_empty())

    mut fl := matrix.Flatten(a)
    testing.AssertEqInt(fl.rows, 1)
    testing.AssertEqInt(fl.cols, 6)
    testing.AssertEqFloat(fl.at(0, 5), 6.0, eps)

    mut fc := matrix.FlattenCol(a)
    testing.AssertEqInt(fc.rows, 6)
    testing.AssertEqInt(fc.cols, 1)

    a.free()
    r.free()
    bad.free()
    fl.free()
    fc.free()
end

func check_rows_cols(eps: f64):
    mut a := mk(3, 3, 1.0)
    mut r1 := matrix.Row(a, 1)
    testing.AssertEqInt(r1.rows, 1)
    testing.AssertEqInt(r1.cols, 3)
    testing.AssertEqFloat(r1.at(0, 0), 4.0, eps)
    testing.AssertEqFloat(r1.at(0, 2), 6.0, eps)

    mut c2 := matrix.Col(a, 2)
    testing.AssertEqInt(c2.rows, 3)
    testing.AssertEqInt(c2.cols, 1)
    testing.AssertEqFloat(c2.at(0, 0), 3.0, eps)
    testing.AssertEqFloat(c2.at(2, 0), 9.0, eps)

    // Out of range gives 0x0
    mut oob := matrix.Row(a, 9)
    testing.AssertTrue(oob.is_empty())

    // SetRow and SetCol accept either orientation, read flat
    mut z := matrix.Zeros(3, 3)
    matrix.SetRow(z, 0, r1)
    testing.AssertEqFloat(z.at(0, 1), 5.0, eps)
    matrix.SetCol(z, 2, c2)
    testing.AssertEqFloat(z.at(1, 2), 6.0, eps)

    a.free()
    r1.free()
    c2.free()
    oob.free()
    z.free()
end

func check_submatrix(eps: f64):
    mut a := mk(4, 4, 1.0)
    mut s := matrix.SubMatrix(a, 1, 1, 2, 2)
    testing.AssertEqInt(s.rows, 2)
    testing.AssertEqInt(s.cols, 2)
    testing.AssertEqFloat(s.at(0, 0), 6.0, eps)
    testing.AssertEqFloat(s.at(1, 1), 11.0, eps)

    // A window that runs off the edge is clipped, not refused
    mut clipped := matrix.SubMatrix(a, 2, 2, 10, 10)
    testing.AssertEqInt(clipped.rows, 2)
    testing.AssertEqInt(clipped.cols, 2)

    a.free()
    s.free()
    clipped.free()
end

func check_delete_insert(eps: f64):
    mut a := mk(3, 3, 1.0)

    mut dr := matrix.DeleteRow(a, 1)
    testing.AssertEqInt(dr.rows, 2)
    testing.AssertEqFloat(dr.at(1, 0), 7.0, eps)

    mut dc := matrix.DeleteCol(a, 0)
    testing.AssertEqInt(dc.cols, 2)
    testing.AssertEqFloat(dc.at(0, 0), 2.0, eps)

    // Minor strikes out one row and one column at once
    mut mn := matrix.Minor(a, 0, 0)
    testing.AssertEqInt(mn.rows, 2)
    testing.AssertEqInt(mn.cols, 2)
    testing.AssertEqFloat(mn.at(0, 0), 5.0, eps)
    testing.AssertEqFloat(mn.at(1, 1), 9.0, eps)

    mut v := matrix.Full(1, 3, 0.0)
    mut ir := matrix.InsertRow(a, 1, v)
    testing.AssertEqInt(ir.rows, 4)
    testing.AssertEqFloat(ir.at(1, 0), 0.0, eps)
    testing.AssertEqFloat(ir.at(2, 0), 4.0, eps)

    mut appended := matrix.InsertRow(a, 3, v)
    testing.AssertEqInt(appended.rows, 4)
    testing.AssertEqFloat(appended.at(3, 2), 0.0, eps)

    mut cv := matrix.Full(3, 1, 0.0)
    mut ic := matrix.InsertCol(a, 0, cv)
    testing.AssertEqInt(ic.cols, 4)
    testing.AssertEqFloat(ic.at(0, 0), 0.0, eps)
    testing.AssertEqFloat(ic.at(0, 1), 1.0, eps)

    a.free()
    dr.free()
    dc.free()
    mn.free()
    v.free()
    ir.free()
    appended.free()
    cv.free()
    ic.free()
end

func check_swaps(eps: f64):
    mut a := mk(3, 3, 1.0)
    matrix.SwapRows(a, 0, 2)
    testing.AssertEqFloat(a.at(0, 0), 7.0, eps)
    testing.AssertEqFloat(a.at(2, 0), 1.0, eps)
    matrix.SwapRows(a, 0, 2)
    testing.AssertEqFloat(a.at(0, 0), 1.0, eps)

    matrix.SwapCols(a, 0, 1)
    testing.AssertEqFloat(a.at(0, 0), 2.0, eps)
    testing.AssertEqFloat(a.at(0, 1), 1.0, eps)

    // Out of range and self-swaps are no-ops
    matrix.SwapRows(a, 0, 0)
    matrix.SwapRows(a, 0, 99)
    testing.AssertEqFloat(a.at(0, 0), 2.0, eps)

    a.free()
end

func check_diagonal(eps: f64):
    mut a := mk(3, 3, 1.0)
    mut d := matrix.Diagonal(a)
    testing.AssertEqInt(d.cols, 3)
    testing.AssertEqFloat(d.at(0, 0), 1.0, eps)
    testing.AssertEqFloat(d.at(0, 1), 5.0, eps)
    testing.AssertEqFloat(d.at(0, 2), 9.0, eps)

    // A rectangular matrix has min(rows, cols) diagonal entries
    mut wide := mk(2, 5, 1.0)
    mut wd := matrix.Diagonal(wide)
    testing.AssertEqInt(wd.cols, 2)

    mut up := matrix.DiagonalOffset(a, 1)
    testing.AssertEqInt(up.cols, 2)
    testing.AssertEqFloat(up.at(0, 0), 2.0, eps)
    testing.AssertEqFloat(up.at(0, 1), 6.0, eps)

    mut down := matrix.DiagonalOffset(a, 0 - 1)
    testing.AssertEqInt(down.cols, 2)
    testing.AssertEqFloat(down.at(0, 0), 4.0, eps)

    mut ones := matrix.Full(1, 3, 1.0)
    matrix.SetDiagonal(a, ones)
    testing.AssertEqFloat(a.at(1, 1), 1.0, eps)

    matrix.ShiftDiagonal(a, 2.0)
    testing.AssertEqFloat(a.at(0, 0), 3.0, eps)
    testing.AssertEqFloat(a.at(2, 2), 3.0, eps)
    // Off-diagonal entries are untouched by a diagonal shift
    testing.AssertEqFloat(a.at(0, 1), 2.0, eps)

    a.free()
    d.free()
    wide.free()
    wd.free()
    up.free()
    down.free()
    ones.free()
end

func main:
    eps := 0.000000001
    check_reshape(eps)
    check_rows_cols(eps)
    check_submatrix(eps)
    check_delete_insert(eps)
    check_swaps(eps)
    check_diagonal(eps)
    ret testing.Summary()
end
