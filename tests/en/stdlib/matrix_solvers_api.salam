package main

import matrix
import math

func rnd(v: f64): f64:
    ret math.Round(v * 1000.0) / 1000.0
end

func mk2(a: f64, b: f64, c: f64, d: f64): matrix.Matrix:
    mut m := matrix.Zeros(2, 2)
    m.Set(0, 0, a)
    m.Set(0, 1, b)
    m.Set(1, 0, c)
    m.Set(1, 1, d)
    ret m
end

func col(a: f64, b: f64): matrix.Matrix:
    mut m := matrix.Zeros(2, 1)
    m.Set(0, 0, a)
    m.Set(1, 0, b)
    ret m
end

func main:
    mut spd := mk2(4.0, 2.0, 2.0, 3.0)
    mut l := matrix.Cholesky(spd)
    mut rhs := col(10.0, 8.0)
    mut x := matrix.CholeskySolve(l, rhs)
    println "cholesky x: ", rnd(x.at(0, 0)), rnd(x.at(1, 0))
    mut wrong := matrix.Zeros(3, 1)
    mut none := matrix.CholeskySolve(l, wrong)
    println "cholesky mismatch: ", none.rows, none.cols

    mut tall := matrix.Zeros(3, 2)
    tall.Set(0, 0, 1.0)
    tall.Set(0, 1, 0.0)
    tall.Set(1, 0, 1.0)
    tall.Set(1, 1, 1.0)
    tall.Set(2, 0, 1.0)
    tall.Set(2, 1, 2.0)
    mut truth := col(1.0, 2.0)
    mut b := matrix.MatMul(tall, truth)
    mut f := matrix.QRDecompose(tall)
    mut qx := matrix.QRSolve(f, b)
    println "qr x: ", rnd(qx.at(0, 0)), rnd(qx.at(1, 0))
    mut short := matrix.Zeros(2, 1)
    mut qnone := matrix.QRSolve(f, short)
    println "qr mismatch: ", qnone.rows, qnone.cols

    mut sym := mk2(2.0, 1.0, 1.0, 2.0)
    mut es := matrix.EigValsAuto(sym)
    println "symmetric: ", es.ok, es.n
    lo := math.Min(es.re.at(0, 0), es.re.at(0, 1))
    hi := math.Max(es.re.at(0, 0), es.re.at(0, 1))
    println "symmetric values: ", rnd(lo), rnd(hi)
    println "symmetric imaginary zero: ", es.im.at(0, 0) == 0.0 and es.im.at(0, 1) == 0.0

    mut rot := mk2(0.0, -1.0, 1.0, 0.0)
    mut er := matrix.EigValsAuto(rot)
    println "rotation: ", er.ok, er.n
    println "rotation real zero: ", rnd(er.re.at(0, 0)), rnd(er.re.at(0, 1))
    println "rotation imaginary: ", rnd(math.Abs(er.im.at(0, 0))), rnd(math.Abs(er.im.at(0, 1)))

    es.Free()
    er.Free()
    qnone.Free()
    short.Free()
    qx.Free()
    f.Free()
    b.Free()
    truth.Free()
    tall.Free()
    none.Free()
    wrong.Free()
    x.Free()
    rhs.Free()
    l.Free()
    spd.Free()
    sym.Free()
    rot.Free()
end
