package main


import matrix
import math
import testing

func rowvec3(a: f64, b: f64, c: f64): matrix.Matrix:
    mut m := matrix.Zeros(1, 3)
    m.set(0, 0, a)
    m.set(0, 1, b)
    m.set(0, 2, c)
    ret m
end

func check_hilbert():
    mut h := matrix.Hilbert(4)
    testing.AssertEqFloat(h.at(0, 0), 1.0, 0.000000001)
    testing.AssertEqFloat(h.at(0, 1), 0.5, 0.000000001)
    testing.AssertEqFloat(h.at(2, 3), 1.0 / 6.0, 0.000000001)
    testing.AssertTrue(matrix.IsSymmetric(h, 0.0))
    testing.AssertTrue(matrix.IsPositiveDefinite(h, 0.000000001))
    testing.AssertTrue(matrix.IsHankel(h, 0.000000001))

    mut hi := matrix.HilbertInverse(4)
    testing.AssertEqFloat(hi.at(0, 0), 16.0, 0.000001)
    testing.AssertEqFloat(hi.at(0, 1), 0.0 - 120.0, 0.000001)
    testing.AssertEqFloat(hi.at(1, 1), 1200.0, 0.000001)
    mut p := matrix.MatMul(h, hi)
    testing.AssertTrue(matrix.IsIdentity(p, 0.0000001))

    mut h8 := matrix.Hilbert(8)
    testing.AssertTrue(matrix.Cond2(h8) > matrix.Cond2(h))
    testing.AssertTrue(matrix.Cond2(h8) > 1.0e9)

    defer h.free()
    defer hi.free()
    defer p.free()
    defer h8.free()
end

func check_vandermonde():
    mut nodes := rowvec3(1.0, 2.0, 3.0)
    mut v := matrix.Vandermonde(nodes, 3)
    testing.AssertEqInt(v.rows, 3)
    testing.AssertEqInt(v.cols, 3)
    testing.AssertEqFloat(v.at(0, 0), 1.0, 0.000000001)
    testing.AssertEqFloat(v.at(1, 1), 2.0, 0.000000001)
    testing.AssertEqFloat(v.at(2, 2), 9.0, 0.000000001)

    testing.AssertEqFloat(matrix.Det(v), 2.0, 0.000001)

    mut y := matrix.Zeros(3, 1)
    y.set(0, 0, 1.0)
    y.set(1, 0, 4.0)
    y.set(2, 0, 9.0)
    mut c := matrix.Solve(v, y)
    testing.AssertEqFloat(c.at(0, 0), 0.0, 0.000001)
    testing.AssertEqFloat(c.at(1, 0), 0.0, 0.000001)
    testing.AssertEqFloat(c.at(2, 0), 1.0, 0.000001)

    mut dup := rowvec3(1.0, 1.0, 2.0)
    mut vd := matrix.Vandermonde(dup, 3)
    testing.AssertEqFloat(matrix.Det(vd), 0.0, 0.000001)

    defer nodes.free()
    defer v.free()
    defer y.free()
    defer c.free()
    defer dup.free()
    defer vd.free()
end

func check_structured():
    mut col := rowvec3(1.0, 2.0, 3.0)
    mut row := rowvec3(1.0, 4.0, 5.0)
    mut t := matrix.Toeplitz(col, row)
    testing.AssertEqFloat(t.at(0, 0), 1.0, 0.000000001)
    testing.AssertEqFloat(t.at(0, 1), 4.0, 0.000000001)
    testing.AssertEqFloat(t.at(1, 0), 2.0, 0.000000001)
    testing.AssertEqFloat(t.at(2, 0), 3.0, 0.000000001)
    testing.AssertEqFloat(t.at(1, 1), 1.0, 0.000000001)
    testing.AssertTrue(matrix.IsToeplitz(t, 0.000000001))

    mut c := matrix.Circulant(col)
    testing.AssertEqFloat(c.at(0, 0), 1.0, 0.000000001)
    testing.AssertEqFloat(c.at(1, 0), 3.0, 0.000000001)
    testing.AssertEqFloat(c.at(1, 1), 1.0, 0.000000001)
    testing.AssertTrue(matrix.IsToeplitz(c, 0.000000001))

    mut p := matrix.Pascal(4)
    testing.AssertEqFloat(p.at(0, 0), 1.0, 0.000000001)
    testing.AssertEqFloat(p.at(1, 1), 2.0, 0.000000001)
    testing.AssertEqFloat(p.at(2, 2), 6.0, 0.000000001)
    testing.AssertEqFloat(p.at(3, 3), 20.0, 0.000000001)
    testing.AssertEqFloat(matrix.Det(p), 1.0, 0.000001)
    testing.AssertTrue(matrix.IsSymmetric(p, 0.0))
    testing.AssertTrue(matrix.IsPositiveDefinite(p, 0.000000001))

    defer col.free()
    defer row.free()
    defer t.free()
    defer c.free()
    defer p.free()
end

func check_companion():
    mut coeffs := rowvec3(2.0, 0.0 - 3.0, 1.0)
    mut c := matrix.Companion(coeffs)
    testing.AssertEqInt(c.rows, 2)
    testing.AssertEqInt(c.cols, 2)

    mut cp := matrix.CharPoly(c)
    testing.AssertEqFloat(cp.at(0, 0), 2.0, 0.000001)
    testing.AssertEqFloat(cp.at(0, 1), 0.0 - 3.0, 0.000001)
    testing.AssertEqFloat(cp.at(0, 2), 1.0, 0.000001)

    mut e := matrix.EigVals(c)
    lo := e.re.a.get(0)
    hi := e.re.a.get(1)
    testing.AssertEqFloat(lo + hi, 3.0, 0.000001)
    testing.AssertEqFloat(lo * hi, 2.0, 0.000001)

    defer coeffs.free()
    defer c.free()
    defer cp.free()
    defer e.free()
end

func check_geometry():
    mut r := matrix.Rotation2D(1.5707963267948966)
    mut x := matrix.Zeros(2, 1)
    x.set(0, 0, 1.0)
    mut y := matrix.MatVec(r, x)
    testing.AssertEqFloat(y.at(0, 0), 0.0, 0.000001)
    testing.AssertEqFloat(y.at(1, 0), 1.0, 0.000001)
    testing.AssertEqFloat(matrix.Det(r), 1.0, 0.000001)

    mut r30 := matrix.Rotation2D(0.5235987755982988)
    mut r90 := matrix.MatPow(r30, 3)
    testing.AssertTrue(matrix.AllClose(r90, r, 0.000001))

    repeat 3 with axis:
        mut a := matrix.Rotation3D(axis, 0.4)
        testing.AssertTrue(matrix.IsOrthogonal(a, 0.000001))
        testing.AssertEqFloat(matrix.Det(a), 1.0, 0.000001)
        a.free()
    end

    mut v := matrix.Zeros(3, 1)
    v.set(0, 0, 1.0)
    mut h := matrix.Householder(v)
    testing.AssertEqFloat(matrix.Det(h), 0.0 - 1.0, 0.000001)
    testing.AssertEqFloat(h.at(0, 0), 0.0 - 1.0, 0.000001)
    mut hh := matrix.MatMul(h, h)
    testing.AssertTrue(matrix.IsIdentity(hh, 0.000001))

    mut g := matrix.Givens(4, 1, 3, 0.6)
    testing.AssertTrue(matrix.IsOrthogonal(g, 0.000001))
    testing.AssertEqFloat(g.at(0, 0), 1.0, 0.000001)
    testing.AssertEqFloat(g.at(2, 2), 1.0, 0.000001)
    testing.AssertEqFloat(g.at(0, 1), 0.0, 0.000001)

    defer r.free()
    defer x.free()
    defer y.free()
    defer r30.free()
    defer r90.free()
    defer v.free()
    defer h.free()
    defer hh.free()
    defer g.free()
end

func check_random():
    mut a := matrix.Random(3, 3, 0.0, 1.0, 12345)
    mut b := matrix.Random(3, 3, 0.0, 1.0, 12345)
    testing.AssertTrue(matrix.AllClose(a, b, 0.0))

    mut c := matrix.Random(3, 3, 0.0, 1.0, 999)
    testing.AssertFalse(matrix.AllClose(a, c, 0.0))

    testing.AssertTrue(matrix.Min(a) >= 0.0)
    testing.AssertTrue(matrix.Max(a) < 1.0)
    mut scaled := matrix.Random(4, 4, 0.0 - 2.0, 2.0, 7)
    testing.AssertTrue(matrix.Min(scaled) >= 0.0 - 2.0)
    testing.AssertTrue(matrix.Max(scaled) < 2.0)

    mut n := matrix.RandomNormal(60, 60, 42)
    testing.AssertTrue(math.Abs(matrix.Mean(n)) < 0.1)
    testing.AssertTrue(matrix.Var(n, true) > 0.85)
    testing.AssertTrue(matrix.Var(n, true) < 1.15)

    mut sym := matrix.RandomSymmetric(5, 3)
    testing.AssertTrue(matrix.IsSymmetric(sym, 0.0))

    mut spd := matrix.RandomSPD(5, 3)
    testing.AssertTrue(matrix.IsSymmetric(spd, 0.000000001))
    testing.AssertTrue(matrix.IsPositiveDefinite(spd, 0.000000001))

    mut q := matrix.RandomOrthogonal(5, 3)
    testing.AssertTrue(matrix.IsOrthogonal(q, 0.000001))
    testing.AssertEqFloat(matrix.Det(q) * matrix.Det(q), 1.0, 0.000001)

    defer a.free()
    defer b.free()
    defer c.free()
    defer scaled.free()
    defer n.free()
    defer sym.free()
    defer spd.free()
    defer q.free()
end

func main:
    check_hilbert()
    check_vandermonde()
    check_structured()
    check_companion()
    check_geometry()
    check_random()
    ret testing.Summary()
end
