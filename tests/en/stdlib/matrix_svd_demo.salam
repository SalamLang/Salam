package main

import matrix
import testing

func mk(r: int, c: int, base: f64): matrix.Matrix:
    mut m := matrix.Zeros(r, c)
    repeat m.count() in k: m.a.Set(k, base + (k as f64)) end
    ret m
end

func rebuild(f &: matrix.SVD): matrix.Matrix:
    mut d := matrix.Diag(f.s.a)
    mut us := matrix.MatMul(f.u, d)
    r := matrix.MulTranspose(us, f.v)
    defer d.Free()
    defer us.Free()
    ret r
end

func check_square():
    mut a := mk(3, 3, 1.0)
    mut f := matrix.SVDecompose(a)
    testing.AssertTrue(f.ok)

    testing.AssertTrue(f.s.at(0, 0) >= f.s.at(0, 1))
    testing.AssertTrue(f.s.at(0, 1) >= f.s.at(0, 2))
    testing.AssertTrue(f.s.at(0, 2) >= 0.0)
    testing.AssertEqFloat(f.s.at(0, 0), 16.848103352614210, 0.000001)
    testing.AssertEqFloat(f.s.at(0, 1), 1.068369514554709, 0.000001)
    testing.AssertEqFloat(f.s.at(0, 2), 0.0, 0.000001)

    testing.AssertTrue(matrix.IsOrthogonal(f.u, 0.000001))
    testing.AssertTrue(matrix.IsOrthogonal(f.v, 0.000001))

    mut back := rebuild(f)
    testing.AssertTrue(matrix.AllClose(back, a, 0.000001))

    defer a.Free()
    defer f.Free()
    defer back.Free()
end

func check_shapes():
    mut tall := mk(5, 3, 1.0)
    mut ft := matrix.SVDecompose(tall)
    testing.AssertEqInt(ft.u.rows, 5)
    testing.AssertEqInt(ft.u.cols, 3)
    testing.AssertEqInt(ft.v.rows, 3)
    testing.AssertEqInt(ft.v.cols, 3)
    mut bt := rebuild(ft)
    testing.AssertTrue(matrix.AllClose(bt, tall, 0.000001))

    mut wide := mk(3, 5, 1.0)
    mut fw := matrix.SVDecompose(wide)
    testing.AssertEqInt(fw.u.rows, 3)
    testing.AssertEqInt(fw.v.rows, 5)
    mut bw := rebuild(fw)
    testing.AssertTrue(matrix.AllClose(bw, wide, 0.000001))

    mut d := matrix.Eye(3)
    d.Set(0, 0, 2.0)
    d.Set(1, 1, 0.0 - 5.0)
    d.Set(2, 2, 1.0)
    mut sv := matrix.SingularValues(d)
    testing.AssertEqFloat(sv.at(0, 0), 5.0, 0.000001)
    testing.AssertEqFloat(sv.at(0, 1), 2.0, 0.000001)
    testing.AssertEqFloat(sv.at(0, 2), 1.0, 0.000001)

    defer tall.Free()
    defer ft.Free()
    defer bt.Free()
    defer wide.Free()
    defer fw.Free()
    defer bw.Free()
    defer d.Free()
    defer sv.Free()
end

func check_rank():
    mut e := matrix.Eye(4)
    testing.AssertEqInt(matrix.MatrixRank(e, 0.0), 4)

    mut sing := mk(3, 3, 1.0)
    testing.AssertEqInt(matrix.MatrixRank(sing, 0.0), 2)

    mut z := matrix.Zeros(3, 3)
    testing.AssertEqInt(matrix.MatrixRank(z, 0.0), 0)

    mut u := mk(4, 1, 1.0)
    mut v := mk(1, 3, 1.0)
    mut o := matrix.Outer(u, v)
    testing.AssertEqInt(matrix.MatrixRank(o, 0.0), 1)

    mut wide := matrix.RandomNormal(3, 7, 11)
    testing.AssertEqInt(matrix.MatrixRank(wide, 0.0), 3)

    defer e.Free()
    defer sing.Free()
    defer z.Free()
    defer u.Free()
    defer v.Free()
    defer o.Free()
    defer wide.Free()
end

func check_pseudoinverse():
    mut a := matrix.Zeros(2, 2)
    a.Set(0, 0, 4.0)
    a.Set(0, 1, 7.0)
    a.Set(1, 0, 2.0)
    a.Set(1, 1, 6.0)
    mut p := matrix.PseudoInverse(a, 0.0)
    mut inv := matrix.Inverse(a)
    testing.AssertTrue(matrix.AllClose(p, inv, 0.000001))

    mut b := mk(3, 2, 1.0)
    mut pb := matrix.PseudoInverse(b, 0.0)
    testing.AssertEqInt(pb.rows, 2)
    testing.AssertEqInt(pb.cols, 3)

    mut bpb := matrix.MatMul(b, pb)
    mut c1 := matrix.MatMul(bpb, b)
    testing.AssertTrue(matrix.AllClose(c1, b, 0.000001))

    mut pbp := matrix.MatMul(pb, b)
    mut c2 := matrix.MatMul(pbp, pb)
    testing.AssertTrue(matrix.AllClose(c2, pb, 0.000001))

    testing.AssertTrue(matrix.IsSymmetric(bpb, 0.000001))
    testing.AssertTrue(matrix.IsSymmetric(pbp, 0.000001))

    defer a.Free()
    defer p.Free()
    defer inv.Free()
    defer b.Free()
    defer pb.Free()
    defer bpb.Free()
    defer c1.Free()
    defer pbp.Free()
    defer c2.Free()
end

func check_subspaces():
    mut a := mk(3, 3, 1.0)
    mut ns := matrix.NullSpace(a, 0.0)
    testing.AssertEqInt(ns.rows, 3)
    testing.AssertEqInt(ns.cols, 1)

    mut an := matrix.MatMul(a, ns)
    testing.AssertTrue(matrix.IsZero(an, 0.000001))
    testing.AssertTrue(matrix.IsOrthogonal(ns, 0.000001))

    mut cs := matrix.ColumnSpace(a, 0.0)
    testing.AssertEqInt(cs.cols, 2)
    testing.AssertTrue(matrix.IsOrthogonal(cs, 0.000001))

    testing.AssertEqInt(matrix.MatrixRank(a, 0.0) + ns.cols, a.cols)

    mut e := matrix.Eye(3)
    mut none := matrix.NullSpace(e, 0.0)
    testing.AssertEqInt(none.cols, 0)

    defer a.Free()
    defer ns.Free()
    defer an.Free()
    defer cs.Free()
    defer e.Free()
    defer none.Free()
end

func check_low_rank():
    mut a := mk(4, 4, 1.0)
    mut sv := matrix.SingularValues(a)
    mut r1 := matrix.LowRankApprox(a, 1)
    testing.AssertEqInt(matrix.MatrixRank(r1, 0.0), 1)
    mut diff := matrix.Sub(a, r1)
    testing.AssertEqFloat(matrix.Norm2(diff), sv.at(0, 1), 0.000001)

    mut full := matrix.LowRankApprox(a, 4)
    testing.AssertTrue(matrix.AllClose(full, a, 0.000001))

    mut over := matrix.LowRankApprox(a, 99)
    testing.AssertTrue(matrix.AllClose(over, a, 0.000001))

    defer a.Free()
    defer sv.Free()
    defer r1.Free()
    defer diff.Free()
    defer full.Free()
    defer over.Free()
end

func check_norms_from_svd():
    mut a := mk(3, 3, 1.0)
    mut sv := matrix.SingularValues(a)

    testing.AssertEqFloat(matrix.Norm2(a), sv.at(0, 0), 0.000001)

    mut total := 0.0
    repeat sv.count() in k: total += sv.a.Get(k) end
    testing.AssertEqFloat(matrix.NormNuclear(a), total, 0.000001)

    mut sq := 0.0
    repeat sv.count() in k: sq += sv.a.Get(k) * sv.a.Get(k) end
    frob_norm := matrix.NormFrobenius(a)
    testing.AssertEqFloat(frob_norm * frob_norm, sq, 0.00001)

    testing.AssertTrue(matrix.Cond2(a) > 1.0e15)

    mut q := matrix.RandomOrthogonal(4, 3)
    testing.AssertEqFloat(matrix.Cond2(q), 1.0, 0.000001)
    testing.AssertEqFloat(matrix.Norm2(q), 1.0, 0.000001)

    defer a.Free()
    defer sv.Free()
    defer q.Free()
end

func main:
    check_square()
    check_shapes()
    check_rank()
    check_pseudoinverse()
    check_subspaces()
    check_low_rank()
    check_norms_from_svd()
    ret testing.Summary()
end
