import db.meilisearch

include fake "../_fake.salam"

const PORT := 19820

func main:
    fake.On("GET", "/health", 200, `{"status":"available"}`)
    fake.On("GET", "/version", 200, `{"commitSha":"4c4c06b","commitDate":"2026-09-30T12:00:00Z","pkgVersion":"1.55.0"}`)
    fake.On("GET", "/stats", 200, `{"databaseSize":1048576,"usedDatabaseSize":524288,"lastUpdate":"2026-10-01T08:00:00Z","indexes":{"movies":{"numberOfDocuments":3,"isIndexing":false}}}`)
    if not fake.Start(PORT):
        println "the example server did not start"
        ret 1
    end

    c := meilisearch.New("127.0.0.1:" + PORT + "/", "masterKey")
    println "server: " + c.host
    mut err := meilisearch.Error {}

    if not meilisearch.IsHealthy(c):
        println "Meilisearch is not reachable"
        ret 1
    end
    println "health: " + meilisearch.Health(c, err)

    version := meilisearch.GetVersion(c, err)
    println "version: " + version.pkg_version + " (" + version.commit_sha + ")"

    stats := meilisearch.GetStats(c, err)
    println "database bytes: " + stats.database_size + ", in use: " + stats.used_database_size
    println "last update: " + stats.last_update

    app := meilisearch.WithAgent(c, "movie-shop/2.1")
    println "agent: " + app.agent
    quick := meilisearch.WithTimeout(c, 2000)
    println "timeout ms: " + quick.timeout_ms
    ret 0
end
