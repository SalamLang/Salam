import db.meilisearch

include fake "../_fake.salam"

const PORT := 19830

func main:
    fake.On("PATCH", "/chats/support/settings", 200, `{"source":"openAi","apiKey":"XXX...","prompts":{"system":"You help customers find movies."}}`)
    fake.On("GET", "/chats", 200, `{"results":[{"uid":"support"}],"offset":0,"limit":20,"total":1}`)
    fake.On("POST", "/chats/support/chat/completions", 200, "data: {\"choices\":[{\"delta\":{\"content\":\"Try Arrival.\"}}]}\n\ndata: [DONE]\n\n")
    fake.On("DELETE", "/chats/support", 204, ``)
    if not fake.Start(PORT):
        println "the example server did not start"
        ret 1
    end
    c := meilisearch.New("http://127.0.0.1:" + PORT, "masterKey")
    mut err := meilisearch.Error {}

    settings := `{"source": "openAi", "apiKey": "sk-your-key", "prompts": {"system": "You help customers find movies."}}`
    println "workspace: " + meilisearch.UpdateChatSettings(c, "support", settings, err)
    spaces := meilisearch.ListChatWorkspaces(c, 0, 20, err)
    println "workspaces: " + spaces.total + " (" + spaces.results.get(0) + ")"

    question := `{"model": "gpt-4o-mini", "stream": true, "messages": [{"role": "user", "content": "A smart film about aliens?"}]}`
    reply := meilisearch.ChatCompletion(c, "support", question, err)
    each line in reply.split("\n"):
        if line.len() > 0: println "stream: " + line end
    end
    println "workspace deleted: " + meilisearch.DeleteChatWorkspace(c, "support", err)
    ret 0
end
