import db.meilisearch

include fake "../_fake.salam"

const PORT := 19831

func main:
    fake.On("GET", "/indexes/ghost", 404, `{"message":"Index ` + "`ghost`" + ` not found.","code":"index_not_found","type":"invalid_request","link":"https://docs.meilisearch.com/errors#index_not_found"}`)
    fake.On("POST", "/dumps", 202, `{"taskUid":60,"indexUid":null,"status":"enqueued","type":"dumpCreation"}`)
    fake.On("POST", "/snapshots", 202, `{"taskUid":61,"indexUid":null,"status":"enqueued","type":"snapshotCreation"}`)
    fake.On("GET", "/experimental-features", 200, `{"metrics":false,"chatCompletions":false}`)
    fake.On("PATCH", "/experimental-features", 200, `{"metrics":true,"chatCompletions":false}`)
    fake.On("GET", "/metrics", 200, "meilisearch_index_count 2\n")
    fake.On("POST", "/logs/stderr", 204, ``)
    fake.On("GET", "/indexes", 200, `{"results":[],"offset":0,"limit":1,"total":0}`)
    if not fake.Start(PORT):
        println "the example server did not start"
        ret 1
    end
    c := meilisearch.New("http://127.0.0.1:" + PORT, "masterKey")
    mut err := meilisearch.Error {}

    meilisearch.GetIndex(c, "ghost", err)
    if not meilisearch.Ok(err):
        println meilisearch.ErrorString(err)
        println "status " + err.status + ", code " + err.code + ", type " + err.kind
        println "docs: " + err.link
    end

    down := meilisearch.New("http://127.0.0.1:1", "masterKey")
    meilisearch.Health(down, err)
    println "unreachable: " + err.code

    println "dump: " + meilisearch.CreateDump(c, err).kind
    println "snapshot: " + meilisearch.CreateSnapshot(c, err).kind
    println "features: " + meilisearch.GetExperimentalFeatures(c, err)
    println "features now: " + meilisearch.UpdateExperimentalFeatures(c, `{"metrics": true}`, err)
    println "metrics: " + meilisearch.GetMetrics(c, err).len() + " bytes"
    println "log level set: " + meilisearch.SetStderrLogs(c, "info", err)
    println "raw request: " + meilisearch.Request(c, "GET", "/indexes?limit=1", "", err)
    ret 0
end
