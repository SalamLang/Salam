  auth: Bearer searchKey
  type: application/json
  body: {"federation": {"limit": 10, "facetsByIndex": {"movies":["genre"]}, "mergeFacets": {"maxValuesPerFacet":10}}, "queries": [{"indexUid": "movies", "q": "up", "federationOptions": {"weight": 1.5}}, {"indexUid": "books", "q": "up", "federationOptions": {"remote": "ms-1"}}]}
