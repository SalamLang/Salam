import db.meilisearch

include fake "_fake.salam"

const PORT := 19805

struct Hit:
    pub id: int = 0
    pub title: str = ""
end

func dump(label: str, r: meilisearch.SearchResult):
    println label + ": " + fake.Last()
    println "  -> [" + r.index_uid + "] q=" + r.query + " hits=" + r.hits.len() + " took=" + r.processing_time_ms + " offset=" + r.offset + " limit=" + r.limit + " estimated=" + r.estimated_total_hits
    println "     page=" + r.page + " per_page=" + r.hits_per_page + " total_hits=" + r.total_hits + " total_pages=" + r.total_pages + " semantic=" + r.semantic_hit_count
    each h in r.hits:
        println "     " + h
    end
    if r.facet_distribution.len() > 0: println "     facets: " + r.facet_distribution end
    if r.facet_stats.len() > 0: println "     stats: " + r.facet_stats end
end

func main:
    fake.On("POST", "/indexes/movies/search", 200, `{"hits":[{"id":1,"title":"Up","_formatted":{"title":"<em>Up</em>"},"_rankingScore":0.98},{"id":2,"title":"Upgrade"}],"query":"up","processingTimeMs":3,"limit":20,"offset":0,"estimatedTotalHits":2,"facetDistribution":{"genre":{"Drama":3}},"facetStats":{"year":{"min":1990,"max":2020}}}`)
    fake.On("POST", "/indexes/movies/search", 200, `{"hits":[],"query":"","processingTimeMs":0,"hitsPerPage":5,"page":2,"totalHits":11,"totalPages":3,"semanticHitCount":4}`)
    fake.On("POST", "/indexes/movies/search", 200, `{"hits":[],"query":"x","processingTimeMs":0,"limit":20,"offset":0,"estimatedTotalHits":0}`)
    fake.On("POST", "/indexes/movies/search", 400, `{"message":"Attribute ` + "`genre`" + ` is not filterable.","code":"invalid_search_filter","type":"invalid_request","link":"https://docs.meilisearch.com/errors#invalid_search_filter"}`)
    fake.On("POST", "/multi-search", 200, `{"results":[{"indexUid":"movies","hits":[{"id":1}],"query":"up","processingTimeMs":1,"limit":20,"offset":0,"estimatedTotalHits":1},{"indexUid":"books","hits":[],"query":"up","processingTimeMs":0,"limit":3,"offset":0,"estimatedTotalHits":0}]}`)
    fake.On("POST", "/multi-search", 200, `{"hits":[{"id":1,"_federation":{"indexUid":"movies","queriesPosition":0}},{"id":9,"_federation":{"indexUid":"books","queriesPosition":1}}],"processingTimeMs":2,"limit":10,"offset":0,"estimatedTotalHits":2}`)
    fake.On("POST", "/indexes/movies/facet-search", 200, `{"facetHits":[{"value":"Drama","count":12},{"value":"Dream \"pop\"","count":3}],"facetQuery":"dr","processingTimeMs":1}`)
    fake.On("POST", "/indexes/movies/similar", 200, `{"hits":[{"id":3,"title":"Up 2"}],"id":"1","processingTimeMs":4,"limit":5,"offset":0,"estimatedTotalHits":1}`)
    if not fake.Start(PORT):
        println "fake server failed to start"
        ret 1
    end
    c := meilisearch.New("http://127.0.0.1:" + PORT, "searchKey")
    mut err := meilisearch.Error {}

    mut r := meilisearch.SearchRequest { query = "up", limit = 20, offset = 0, filter = "year > 1990", show_ranking_score = true }
    r.facets.push("genre")
    r.facets.push("year")
    r.attributes_to_highlight.push("title")
    r.highlight_pre_tag = "<em>"
    r.highlight_post_tag = "</em>"
    r.sort.push("year:desc")
    r.matching_strategy = meilisearch.MATCH_ALL
    res := meilisearch.Search(c, "movies", r, err)
    dump("search", res)
    mut hits := Vector {} as Vector<Hit>
    println "typed: " + meilisearch.HitsAs(res, hits, err) + " " + hits.len() + " " + hits.get(0).title + " " + hits.get(1).id

    mut full := meilisearch.SearchRequest { page = 2, hits_per_page = 5, crop_length = 10, crop_marker = "..", show_matches_position = true, show_ranking_score_details = true, ranking_score_threshold = 0.25, distinct = "studio", hybrid_embedder = "default", hybrid_semantic_ratio = 0.75, retrieve_vectors = true, media = `{"image":"cat.png"}`, extra = `{"showPerformanceDetails": true}` }
    full.attributes_to_retrieve.push("id")
    full.attributes_to_crop.push("overview")
    full.attributes_to_search_on.push("title")
    full.locales.push("fas")
    full.vector.push(0.5)
    full.vector.push(1.25)
    full.filter = `[["genre = Horror", "genre = Comedy"], "release_date > 795484800"]`
    dump("full", meilisearch.Search(c, "movies", full, err))

    dump("query", meilisearch.Query(c, "movies", "x", err))

    bad := meilisearch.Search(c, "movies", meilisearch.SearchRequest { filter = "genre = x" }, err)
    println "bad: " + bad.hits.len() + " " + meilisearch.ErrorString(err)

    mut queries := Vector {} as Vector<meilisearch.MultiQuery>
    queries.push(meilisearch.MultiQuery { index_uid = "movies", request = meilisearch.SearchRequest { query = "up" } })
    queries.push(meilisearch.MultiQuery { index_uid = "books", request = meilisearch.SearchRequest { query = "up", limit = 3 } })
    multi := meilisearch.MultiSearch(c, queries, err)
    println "multi: " + fake.Last()
    each m in multi:
        println "  -> " + m.index_uid + " hits=" + m.hits.len() + " limit=" + m.limit
    end

    mut fq := Vector {} as Vector<meilisearch.MultiQuery>
    fq.push(meilisearch.MultiQuery { index_uid = "movies", request = meilisearch.SearchRequest { query = "up" }, weight = 1.5 })
    fq.push(meilisearch.MultiQuery { index_uid = "books", request = meilisearch.SearchRequest { query = "up" }, remote = "ms-1" })
    fed := meilisearch.FederatedSearch(c, fq, meilisearch.Federation { limit = 10, facets_by_index = `{"movies":["genre"]}`, merge_facets = `{"maxValuesPerFacet":10}` }, err)
    dump("federated", fed)

    mut fr := meilisearch.FacetSearchRequest { facet_name = "genre", facet_query = "dr", query = "up", filter = "year > 1990", exhaustive_facet_count = true }
    fr.attributes_to_search_on.push("title")
    facets := meilisearch.FacetSearch(c, "movies", fr, err)
    println "facet: " + fake.Last()
    println "  -> " + facets.facet_query + " took=" + facets.processing_time_ms
    each f in facets.hits:
        println "     " + f.value + " = " + f.count
    end

    mut sr := meilisearch.SimilarRequest { id = "1", embedder = "default", limit = 5, filter = "year > 2000", show_ranking_score = true, ranking_score_threshold = 0.5 }
    sr.attributes_to_retrieve.push("title")
    dump("similar", meilisearch.SimilarDocuments(c, "movies", sr, err))
    ret 0
end
