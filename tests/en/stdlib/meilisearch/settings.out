all: {"displayedAttributes":["*"],"searchableAttributes":["*"],"rankingRules":["words","typo"]}
update all: PATCH /indexes/movies/settings
  auth: Bearer masterKey
  type: application/json
  body: {"rankingRules":["words"],"stopWords":["the"]}
  -> task 30 settingsUpdate
reset all: DELETE /indexes/movies/settings
  auth: Bearer masterKey
  -> task 30 settingsUpdate
ranking: <words><typo><proximity><attribute><sort><exactness><release_date:desc>
ranking: PUT /indexes/movies/settings/ranking-rules
  auth: Bearer masterKey
  type: application/json
  body: ["words", "release_date:desc"]
  -> task 30 settingsUpdate
ranking reset: DELETE /indexes/movies/settings/ranking-rules
  auth: Bearer masterKey
  -> task 30 settingsUpdate
filterable: <genre><{"attributePatterns":["year"],"features":{"facetSearch":false}}>
filterable: PUT /indexes/movies/settings/filterable-attributes
  auth: Bearer masterKey
  type: application/json
  body: ["genre", "year"]
  -> task 30 settingsUpdate
searchable: PUT /indexes/movies/settings/searchable-attributes
  auth: Bearer masterKey
  type: application/json
  body: ["genre", "year"]
  -> task 30 settingsUpdate
displayed: PUT /indexes/movies/settings/displayed-attributes
  auth: Bearer masterKey
  type: application/json
  body: ["genre", "year"]
  -> task 30 settingsUpdate
sortable: PUT /indexes/movies/settings/sortable-attributes
  auth: Bearer masterKey
  type: application/json
  body: ["genre", "year"]
  -> task 30 settingsUpdate
dictionary: PUT /indexes/movies/settings/dictionary
  auth: Bearer masterKey
  type: application/json
  body: ["genre", "year"]
  -> task 30 settingsUpdate
separators: PUT /indexes/movies/settings/separator-tokens
  auth: Bearer masterKey
  type: application/json
  body: ["genre", "year"]
  -> task 30 settingsUpdate
non separators reset: DELETE /indexes/movies/settings/non-separator-tokens
  auth: Bearer masterKey
  -> task 30 settingsUpdate
stop words: []
distinct: sku
distinct: PUT /indexes/movies/settings/distinct-attribute
  auth: Bearer masterKey
  type: application/json
  body: "sku"
  -> task 30 settingsUpdate
proximity: byWord
prefix: PUT /indexes/movies/settings/prefix-search
  auth: Bearer masterKey
  type: application/json
  body: "disabled"
  -> task 30 settingsUpdate
cutoff: -1
cutoff: PUT /indexes/movies/settings/search-cutoff-ms
  auth: Bearer masterKey
  type: application/json
  body: 150
  -> task 30 settingsUpdate
facet search: true
facet search: PUT /indexes/movies/settings/facet-search
  auth: Bearer masterKey
  type: application/json
  body: false
  -> task 30 settingsUpdate
synonyms: {"wolverine":["xmen","logan"]}
synonyms: PUT /indexes/movies/settings/synonyms
  auth: Bearer masterKey
  type: application/json
  body: {"logan":["wolverine"]}
  -> task 30 settingsUpdate
typo: PATCH /indexes/movies/settings/typo-tolerance
  auth: Bearer masterKey
  type: application/json
  body: {"minWordSizeForTypos":{"oneTypo":4}}
  -> task 30 settingsUpdate
pagination: PATCH /indexes/movies/settings/pagination
  auth: Bearer masterKey
  type: application/json
  body: {"maxTotalHits":5000}
  -> task 30 settingsUpdate
faceting: PATCH /indexes/movies/settings/faceting
  auth: Bearer masterKey
  type: application/json
  body: {"maxValuesPerFacet":200}
  -> task 30 settingsUpdate
embedders: PATCH /indexes/movies/settings/embedders
  auth: Bearer masterKey
  type: application/json
  body: {"default":{"source":"userProvided","dimensions":3}}
  -> task 30 settingsUpdate
localized: PUT /indexes/movies/settings/localized-attributes
  auth: Bearer masterKey
  type: application/json
  body: [{"attributePatterns":["*_fa"],"locales":["fas"]}]
  -> task 30 settingsUpdate
embedders reset: DELETE /indexes/movies/settings/embedders
  auth: Bearer masterKey
  -> task 30 settingsUpdate
generic: PATCH /indexes/movies/settings/pagination
  auth: Bearer masterKey
  type: application/json
  body: {"maxTotalHits":10}
  -> task 30 settingsUpdate
