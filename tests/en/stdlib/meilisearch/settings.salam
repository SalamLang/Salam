import db.meilisearch

include fake "_fake.salam"

const PORT := 19806

func show(label: str, t: meilisearch.TaskInfo, err: meilisearch.Error):
    println label + ": " + fake.Last()
    println "  -> task " + t.task_uid + " " + t.kind
    if not meilisearch.Ok(err):
        println "  error: " + meilisearch.ErrorString(err)
    end
end

func list(v: Vector<str>): str:
    mut out := ""
    each s in v:
        out = out + "<" + s + ">"
    end
    ret out
end

func main:
    queued := `{"taskUid":30,"indexUid":"movies","status":"enqueued","type":"settingsUpdate","enqueuedAt":"2025-01-02T03:04:05Z"}`
    base := "/indexes/movies/settings"
    fake.On("GET", base, 200, `{"displayedAttributes":["*"],"searchableAttributes":["*"],"rankingRules":["words","typo"]}`)
    fake.On("PATCH", base, 202, queued)
    fake.On("DELETE", base, 202, queued)
    fake.On("GET", base + "/ranking-rules", 200, `["words","typo","proximity","attribute","sort","exactness","release_date:desc"]`)
    fake.On("PUT", base + "/ranking-rules", 202, queued)
    fake.On("DELETE", base + "/ranking-rules", 202, queued)
    fake.On("GET", base + "/filterable-attributes", 200, `["genre",{"attributePatterns":["year"],"features":{"facetSearch":false}}]`)
    fake.On("PUT", base + "/filterable-attributes", 202, queued)
    fake.On("GET", base + "/stop-words", 200, `[]`)
    fake.On("PUT", base + "/searchable-attributes", 202, queued)
    fake.On("PUT", base + "/displayed-attributes", 202, queued)
    fake.On("PUT", base + "/sortable-attributes", 202, queued)
    fake.On("PUT", base + "/dictionary", 202, queued)
    fake.On("PUT", base + "/separator-tokens", 202, queued)
    fake.On("DELETE", base + "/non-separator-tokens", 202, queued)
    fake.On("GET", base + "/distinct-attribute", 200, `"sku"`)
    fake.On("PUT", base + "/distinct-attribute", 202, queued)
    fake.On("GET", base + "/proximity-precision", 200, `"byWord"`)
    fake.On("PUT", base + "/prefix-search", 202, queued)
    fake.On("GET", base + "/search-cutoff-ms", 200, `null`)
    fake.On("PUT", base + "/search-cutoff-ms", 202, queued)
    fake.On("GET", base + "/facet-search", 200, `true`)
    fake.On("PUT", base + "/facet-search", 202, queued)
    fake.On("GET", base + "/synonyms", 200, `{"wolverine":["xmen","logan"]}`)
    fake.On("PUT", base + "/synonyms", 202, queued)
    fake.On("PATCH", base + "/typo-tolerance", 202, queued)
    fake.On("PATCH", base + "/pagination", 202, queued)
    fake.On("PATCH", base + "/faceting", 202, queued)
    fake.On("PATCH", base + "/embedders", 202, queued)
    fake.On("PUT", base + "/localized-attributes", 202, queued)
    fake.On("DELETE", base + "/embedders", 202, queued)
    if not fake.Start(PORT):
        println "fake server failed to start"
        ret 1
    end
    c := meilisearch.New("http://127.0.0.1:" + PORT, "masterKey")
    mut err := meilisearch.Error {}

    println "all: " + meilisearch.GetSettings(c, "movies", err)
    show("update all", meilisearch.UpdateSettings(c, "movies", `{"rankingRules":["words"],"stopWords":["the"]}`, err), err)
    show("reset all", meilisearch.ResetSettings(c, "movies", err), err)

    println "ranking: " + list(meilisearch.GetRankingRules(c, "movies", err))
    mut rules := Vector {} as Vector<str>
    rules.push("words")
    rules.push("release_date:desc")
    show("ranking", meilisearch.UpdateRankingRules(c, "movies", rules, err), err)
    show("ranking reset", meilisearch.ResetRankingRules(c, "movies", err), err)

    println "filterable: " + list(meilisearch.GetFilterableAttributes(c, "movies", err))
    mut attrs := Vector {} as Vector<str>
    attrs.push("genre")
    attrs.push("year")
    show("filterable", meilisearch.UpdateFilterableAttributes(c, "movies", attrs, err), err)
    show("searchable", meilisearch.UpdateSearchableAttributes(c, "movies", attrs, err), err)
    show("displayed", meilisearch.UpdateDisplayedAttributes(c, "movies", attrs, err), err)
    show("sortable", meilisearch.UpdateSortableAttributes(c, "movies", attrs, err), err)
    show("dictionary", meilisearch.UpdateDictionary(c, "movies", attrs, err), err)
    show("separators", meilisearch.UpdateSeparatorTokens(c, "movies", attrs, err), err)
    show("non separators reset", meilisearch.ResetNonSeparatorTokens(c, "movies", err), err)
    println "stop words: [" + list(meilisearch.GetStopWords(c, "movies", err)) + "]"

    println "distinct: " + meilisearch.GetDistinctAttribute(c, "movies", err)
    show("distinct", meilisearch.UpdateDistinctAttribute(c, "movies", "sku", err), err)
    println "proximity: " + meilisearch.GetProximityPrecision(c, "movies", err)
    show("prefix", meilisearch.UpdatePrefixSearch(c, "movies", "disabled", err), err)
    println "cutoff: " + meilisearch.GetSearchCutoffMs(c, "movies", err)
    show("cutoff", meilisearch.UpdateSearchCutoffMs(c, "movies", 150, err), err)
    println "facet search: " + meilisearch.GetFacetSearch(c, "movies", err)
    show("facet search", meilisearch.UpdateFacetSearch(c, "movies", false, err), err)

    println "synonyms: " + meilisearch.GetSynonyms(c, "movies", err)
    show("synonyms", meilisearch.UpdateSynonyms(c, "movies", `{"logan":["wolverine"]}`, err), err)
    show("typo", meilisearch.UpdateTypoTolerance(c, "movies", `{"minWordSizeForTypos":{"oneTypo":4}}`, err), err)
    show("pagination", meilisearch.UpdatePagination(c, "movies", `{"maxTotalHits":5000}`, err), err)
    show("faceting", meilisearch.UpdateFaceting(c, "movies", `{"maxValuesPerFacet":200}`, err), err)
    show("embedders", meilisearch.UpdateEmbedders(c, "movies", `{"default":{"source":"userProvided","dimensions":3}}`, err), err)
    show("localized", meilisearch.UpdateLocalizedAttributes(c, "movies", `[{"attributePatterns":["*_fa"],"locales":["fas"]}]`, err), err)
    show("embedders reset", meilisearch.ResetEmbedders(c, "movies", err), err)

    show("generic", meilisearch.UpdateSetting(c, "movies", "pagination", `{"maxTotalHits":10}`, err), err)
    println "generic get: " + meilisearch.GetSetting(c, "movies", "synonyms", err)
    meilisearch.GetSetting(c, "movies", "chat", err)
    println "chat: " + err.code
    ret 0
end
