displayed-attributes: <title><year>
searchable-attributes: <title>
sortable-attributes: <year>
dictionary: <J.R.R.>
separator-tokens: <|>
non-separator-tokens: <#>
embedders: {"default":{"source":"userProvided"}}
faceting: {"maxValuesPerFacet":100}
localized-attributes: []
pagination: {"maxTotalHits":1000}
prefix-search: indexingTime
typo-tolerance: {"enabled":true}
chat: {"description":"movies"}
stop words: PUT /indexes/movies/settings/stop-words
  auth: Bearer masterKey
  type: application/json
  body: ["the", "a"]
  -> task 31 settingsUpdate
non separators: PUT /indexes/movies/settings/non-separator-tokens
  auth: Bearer masterKey
  type: application/json
  body: ["the", "a"]
  -> task 31 settingsUpdate
proximity: PUT /indexes/movies/settings/proximity-precision
  auth: Bearer masterKey
  type: application/json
  body: "byAttribute"
  -> task 31 settingsUpdate
chat: PATCH /indexes/movies/settings/chat
  auth: Bearer masterKey
  type: application/json
  body: {"description":"movies"}
  -> task 31 settingsUpdate
