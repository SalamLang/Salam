  auth: Bearer masterKey
  -> task 31 settingsUpdate
proximity-precision reset: DELETE /indexes/movies/settings/proximity-precision
  auth: Bearer masterKey
  -> task 31 settingsUpdate
search-cutoff-ms reset: DELETE /indexes/movies/settings/search-cutoff-ms
  auth: Bearer masterKey
