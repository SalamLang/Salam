network: {"self":"ms-0","remotes":{}}
network update: {"self":"ms-1","remotes":{}}
PATCH /network
  auth: Bearer masterKey
  type: application/json
  body: {"self":"ms-1"}
export: POST /export
  auth: Bearer masterKey
  type: application/json
  body: {"url":"http://other:7700"}
  -> task 32 export
