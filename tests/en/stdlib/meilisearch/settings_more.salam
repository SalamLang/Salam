import db.meilisearch

include fake "_fake.salam"

mut PORT := 0

func show(label: str, t: meilisearch.TaskInfo, err: meilisearch.Error):
    println label + ": " + fake.Last()
    println "  -> task " + t.task_uid + " " + t.kind
    if not meilisearch.Ok(err):
        println "  error: " + meilisearch.ErrorString(err)
    end
end

func list(v: Vector<str>): str:
    mut out := ""
    each s in v:
        out = out + "<" + s + ">"
    end
    ret out
end

func main:
    queued := `{"taskUid":31,"indexUid":"movies","status":"enqueued","type":"settingsUpdate","enqueuedAt":"2025-01-02T03:04:05Z"}`
    base := "/indexes/movies/settings"
    fake.On("DELETE", base + "/chat", 202, queued)
    fake.On("DELETE", base + "/dictionary", 202, queued)
    fake.On("DELETE", base + "/displayed-attributes", 202, queued)
    fake.On("DELETE", base + "/distinct-attribute", 202, queued)
    fake.On("DELETE", base + "/facet-search", 202, queued)
    fake.On("DELETE", base + "/faceting", 202, queued)
    fake.On("DELETE", base + "/filterable-attributes", 202, queued)
    fake.On("DELETE", base + "/localized-attributes", 202, queued)
    fake.On("DELETE", base + "/pagination", 202, queued)
    fake.On("DELETE", base + "/prefix-search", 202, queued)
    fake.On("DELETE", base + "/proximity-precision", 202, queued)
    fake.On("DELETE", base + "/search-cutoff-ms", 202, queued)
    fake.On("DELETE", base + "/searchable-attributes", 202, queued)
    fake.On("DELETE", base + "/separator-tokens", 202, queued)
    fake.On("DELETE", base + "/sortable-attributes", 202, queued)
    fake.On("DELETE", base + "/synonyms", 202, queued)
    fake.On("DELETE", base + "/typo-tolerance", 202, queued)
    fake.On("GET", base + "/displayed-attributes", 200, `["title","year"]`)
    fake.On("GET", base + "/searchable-attributes", 200, `["title"]`)
    fake.On("GET", base + "/sortable-attributes", 200, `["year"]`)
    fake.On("GET", base + "/dictionary", 200, `["J.R.R."]`)
    fake.On("GET", base + "/separator-tokens", 200, `["|"]`)
    fake.On("GET", base + "/non-separator-tokens", 200, `["#"]`)
    fake.On("GET", base + "/embedders", 200, `{"default":{"source":"userProvided"}}`)
    fake.On("GET", base + "/faceting", 200, `{"maxValuesPerFacet":100}`)
    fake.On("GET", base + "/localized-attributes", 200, `[]`)
    fake.On("GET", base + "/pagination", 200, `{"maxTotalHits":1000}`)
    fake.On("GET", base + "/prefix-search", 200, `"indexingTime"`)
    fake.On("GET", base + "/typo-tolerance", 200, `{"enabled":true}`)
    fake.On("GET", base + "/chat", 200, `{"description":"movies"}`)
    fake.On("PUT", base + "/stop-words", 202, queued)
    fake.On("PUT", base + "/non-separator-tokens", 202, queued)
    fake.On("PUT", base + "/proximity-precision", 202, queued)
    fake.On("PATCH", base + "/chat", 202, queued)
    fake.On("DELETE", base + "/stop-words", 202, queued)
    fake.On("DELETE", base + "/non-separator-tokens", 202, queued)
    fake.On("GET", "/network", 200, `{"self":"ms-0","remotes":{}}`)
    fake.On("PATCH", "/network", 200, `{"self":"ms-1","remotes":{}}`)
    fake.On("POST", "/export", 202, `{"taskUid":32,"indexUid":null,"status":"enqueued","type":"export","enqueuedAt":"2025-01-02T03:04:05Z"}`)
    PORT = fake.StartFree()
    if PORT == 0:
        println "fake server failed to start"
        ret 1
    end
    c := meilisearch.New("http://127.0.0.1:" + PORT, "masterKey")
    mut err := meilisearch.Error {}

    println "displayed-attributes: " + list(meilisearch.GetDisplayedAttributes(c, "movies", err))
    println "searchable-attributes: " + list(meilisearch.GetSearchableAttributes(c, "movies", err))
    println "sortable-attributes: " + list(meilisearch.GetSortableAttributes(c, "movies", err))
    println "dictionary: " + list(meilisearch.GetDictionary(c, "movies", err))
    println "separator-tokens: " + list(meilisearch.GetSeparatorTokens(c, "movies", err))
    println "non-separator-tokens: " + list(meilisearch.GetNonSeparatorTokens(c, "movies", err))
    println "embedders: " + meilisearch.GetEmbedders(c, "movies", err)
    println "faceting: " + meilisearch.GetFaceting(c, "movies", err)
    println "localized-attributes: " + meilisearch.GetLocalizedAttributes(c, "movies", err)
    println "pagination: " + meilisearch.GetPagination(c, "movies", err)
    println "prefix-search: " + meilisearch.GetPrefixSearch(c, "movies", err)
    println "typo-tolerance: " + meilisearch.GetTypoTolerance(c, "movies", err)
    println "chat: " + meilisearch.GetChat(c, "movies", err)
    mut words := Vector {} as Vector<str>
    words.push("the")
    words.push("a")
    show("stop words", meilisearch.UpdateStopWords(c, "movies", words, err), err)
    show("non separators", meilisearch.UpdateNonSeparatorTokens(c, "movies", words, err), err)
    show("proximity", meilisearch.UpdateProximityPrecision(c, "movies", "byAttribute", err), err)
    show("chat", meilisearch.UpdateChat(c, "movies", `{"description":"movies"}`, err), err)
    show("chat reset", meilisearch.ResetChat(c, "movies", err), err)
    show("dictionary reset", meilisearch.ResetDictionary(c, "movies", err), err)
    show("displayed-attributes reset", meilisearch.ResetDisplayedAttributes(c, "movies", err), err)
    show("distinct-attribute reset", meilisearch.ResetDistinctAttribute(c, "movies", err), err)
    show("facet-search reset", meilisearch.ResetFacetSearch(c, "movies", err), err)
    show("faceting reset", meilisearch.ResetFaceting(c, "movies", err), err)
    show("filterable-attributes reset", meilisearch.ResetFilterableAttributes(c, "movies", err), err)
    show("localized-attributes reset", meilisearch.ResetLocalizedAttributes(c, "movies", err), err)
    show("pagination reset", meilisearch.ResetPagination(c, "movies", err), err)
    show("prefix-search reset", meilisearch.ResetPrefixSearch(c, "movies", err), err)
    show("proximity-precision reset", meilisearch.ResetProximityPrecision(c, "movies", err), err)
    show("search-cutoff-ms reset", meilisearch.ResetSearchCutoffMs(c, "movies", err), err)
    show("searchable-attributes reset", meilisearch.ResetSearchableAttributes(c, "movies", err), err)
    show("separator-tokens reset", meilisearch.ResetSeparatorTokens(c, "movies", err), err)
    show("sortable-attributes reset", meilisearch.ResetSortableAttributes(c, "movies", err), err)
    show("synonyms reset", meilisearch.ResetSynonyms(c, "movies", err), err)
    show("typo-tolerance reset", meilisearch.ResetTypoTolerance(c, "movies", err), err)
    show("stop words reset", meilisearch.ResetSetting(c, "movies", "stop-words", err), err)
    println "network: " + meilisearch.GetNetwork(c, err)
    println "network update: " + meilisearch.UpdateNetwork(c, `{"self":"ms-1"}`, err)
    println fake.Last()
    show("export", meilisearch.Export(c, `{"url":"http://other:7700"}`, err), err)
    ret 0
end
