package main

import mem

func main:
    arr := mem.AllocateArray(4 as u64, 8 as u64) as i64*
    println "array allocated: ", arr != null
    println "array zeroed: ", arr[0] == 0 as i64 and arr[3] == 0 as i64
    arr[2] = 42 as i64
    println "array write: ", arr[2]
    println "zero count: ", mem.AllocateArray(0 as u64, 8 as u64) == null
    println "zero size: ", mem.AllocateArray(8 as u64, 0 as u64) == null
    println "overflow: ", mem.AllocateArray(0xFFFFFFFFFFFFFFFF as u64, 16 as u64) == null

    buf := mem.Allocate(8 as u64) as u8*
    repeat 8 in i:
        buf[i] = (i + 1) as u8
    end
    mem.MemMove((buf as u64 + 2 as u64) as void*, buf as void*, 4 as u64)
    println "overlapping move: ", buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6]
    println "same pointer: ", mem.MemMove(buf as void*, buf as void*, 4 as u64) == buf as void*
    println "zero length: ", mem.MemMove(buf as void*, arr as void*, 0 as u64) == buf as void*

    live := mem.LiveBytes()
    peak := mem.PeakBytes()
    println "peak covers live: ", peak >= live
    println "debug implies active: ", mem.IsMemDebug() == false or mem.MemDebugActive()
    println "asan implies active: ", mem.IsAsanActive() == false or mem.MemDebugActive()
    println "active is either: ", mem.MemDebugActive() == (mem.IsMemDebug() or mem.IsAsanActive())

    mem.Free(buf as void*)
    mem.Free(arr as void*)

    mut a := mem.NewArena(64 as u64)
    println "arena capacity: ", mem.ArenaCapacity(a)
    println "arena remaining: ", mem.ArenaRemaining(a)
    zeroed := mem.ArenaAllocZeroed(a, 10 as u64) as u8*
    println "zeroed block: ", zeroed != null and zeroed[0] == 0 as u8 and zeroed[9] == 0 as u8
    println "used rounds to 8: ", mem.ArenaUsed(a)
    println "remaining after: ", mem.ArenaRemaining(a)
    println "too big: ", mem.ArenaAlloc(a, 100 as u64) == null
    mem.ArenaReset(a)
    println "after reset used: ", mem.ArenaUsed(a)
    println "after reset remaining: ", mem.ArenaRemaining(a)
    mem.ArenaFree(a)

    mut p := mem.NewPool(20 as u64, 3 as u64)
    println "pool block size: ", mem.PoolBlockSize(p)
    println "pool capacity: ", mem.PoolCapacity(p)
    first := mem.PoolAlloc(p)
    mem.PoolAlloc(p)
    mem.PoolAlloc(p)
    println "pool exhausted: ", mem.PoolAlloc(p) == null
    mem.PoolFree(p, first)
    println "block reused: ", mem.PoolAlloc(p) == first
    mem.PoolDestroy(p)
end
