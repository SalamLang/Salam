import metatrader

include fake "_fake.salam"

const PORT := 19902

func main:
    fake.On("GET", "/account_info", 200, `{"login":12345,"balance":10000.5,"equity":10050.75,"currency":"USD","leverage":100,"trade_allowed":true,"server":"Demo-Server","company":"Demo Broker"}`)
    fake.On("GET", "/terminal_info", 200, `{"build":4530,"connected":true,"trade_allowed":true,"company":"MetaQuotes","name":"MetaTrader 5","language":"English"}`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    acc := metatrader.GetAccountInfo()
    println acc.login, acc.balance, acc.equity, acc.currency
    println acc.leverage, acc.trade_allowed, acc.server, acc.company

    term := metatrader.GetTerminalInfo()
    println term.build, term.connected, term.trade_allowed
    println term.company, term.name, term.language

    println metatrader.Ok()
end
