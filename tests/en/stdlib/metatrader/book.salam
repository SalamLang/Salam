import metatrader

include fake "_fake.salam"

const PORT := 19904

func main:
    fake.On("POST", "/market_book_add", 200, `{}`)
    fake.On("GET", "/market_book_get", 200, `[{"book_type":1,"price":1.0821,"volume":5,"volume_dbl":5.0}, {"book_type":0,"price":1.0823,"volume":3,"volume_dbl":3.0}]`)
    fake.On("POST", "/market_book_release", 200, `{}`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    println metatrader.MarketBookAdd("EURUSD")
    book := metatrader.MarketBookGet("EURUSD")
    println book.len()
    each e in book:
        println e.book_type, e.price, e.volume, e.volume_dbl
    end
    println metatrader.MarketBookRelease("EURUSD")
end
