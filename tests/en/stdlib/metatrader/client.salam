import metatrader
import str

include fake "_fake.salam"

mut PORT := 0

func main:
    fake.On("POST", "/initialize", 200, `{}`)
    fake.On("POST", "/login", 200, `{}`)
    fake.On("GET", "/version", 200, `{"terminal_version":500,"build":4530,"build_release_date":"Oct 1 2026"}`)
    fake.On("POST", "/shutdown", 200, `{}`)
    PORT = fake.StartFree()

    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)
    println str.Replace(metatrader.BridgeUrl(), ":" + PORT, ":PORT")

    println metatrader.Initialize()
    err := metatrader.LastError()
    println err.code, err.description
    println metatrader.IsConnected()
    println metatrader.Ok()

    println metatrader.Login(12345 as i64, "secret", "Demo-Server")
    println metatrader.IsConnected()

    ver := metatrader.Version()
    println ver.terminal_version, ver.build, ver.build_release_date

    metatrader.Shutdown()
    println metatrader.IsConnected()
end
