import metatrader

func main:
    println metatrader.TIMEFRAME_M1, metatrader.TIMEFRAME_M30, metatrader.TIMEFRAME_H1, metatrader.TIMEFRAME_H4
    println metatrader.TIMEFRAME_D1, metatrader.TIMEFRAME_W1, metatrader.TIMEFRAME_MN1

    println metatrader.ORDER_TYPE_BUY, metatrader.ORDER_TYPE_SELL, metatrader.ORDER_TYPE_BUY_LIMIT
    println metatrader.ORDER_TYPE_SELL_STOP_LIMIT, metatrader.ORDER_TYPE_CLOSE_BY

    println metatrader.TRADE_ACTION_DEAL, metatrader.TRADE_ACTION_PENDING, metatrader.TRADE_ACTION_SLTP
    println metatrader.TRADE_ACTION_MODIFY, metatrader.TRADE_ACTION_REMOVE, metatrader.TRADE_ACTION_CLOSE_BY

    println metatrader.ORDER_FILLING_FOK, metatrader.ORDER_FILLING_IOC, metatrader.ORDER_FILLING_RETURN
    println metatrader.ORDER_TIME_GTC, metatrader.ORDER_TIME_DAY, metatrader.ORDER_TIME_SPECIFIED

    println metatrader.POSITION_TYPE_BUY, metatrader.POSITION_TYPE_SELL
    println metatrader.DEAL_TYPE_BUY, metatrader.DEAL_TYPE_SELL, metatrader.DEAL_TYPE_BALANCE
    println metatrader.DEAL_ENTRY_IN, metatrader.DEAL_ENTRY_OUT, metatrader.DEAL_ENTRY_INOUT

    println metatrader.TRADE_RETCODE_DONE, metatrader.TRADE_RETCODE_REQUOTE, metatrader.TRADE_RETCODE_REJECT
    println metatrader.TRADE_RETCODE_NO_MONEY, metatrader.TRADE_RETCODE_MARKET_CLOSED
    println metatrader.TRADE_RETCODE_INVALID_STOPS, metatrader.TRADE_RETCODE_HEDGE_PROHIBITED

    println metatrader.BOOK_TYPE_SELL, metatrader.BOOK_TYPE_BUY, metatrader.BOOK_TYPE_SELL_MARKET, metatrader.BOOK_TYPE_BUY_MARKET
    println metatrader.COPY_TICKS_ALL, metatrader.COPY_TICKS_INFO, metatrader.COPY_TICKS_TRADE
    println metatrader.TICK_FLAG_BID, metatrader.TICK_FLAG_ASK, metatrader.TICK_FLAG_LAST, metatrader.TICK_FLAG_VOLUME

    println metatrader.SYMBOL_TRADE_MODE_DISABLED, metatrader.SYMBOL_TRADE_MODE_FULL
    println metatrader.SYMBOL_CALC_MODE_FOREX, metatrader.SYMBOL_CALC_MODE_CFD

    println metatrader.RES_S_OK, metatrader.RES_E_FAIL, metatrader.RES_E_INVALID_PARAMS
    println metatrader.RES_E_AUTH_FAILED, metatrader.RES_E_INTERNAL_FAIL, metatrader.RES_E_INTERNAL_FAIL_CONNECT
    println metatrader.RES_E_INTERNAL_FAIL_TIMEOUT

    println metatrader.DEFAULT_BRIDGE_URL
    println metatrader.DEFAULT_TIMEOUT_MS
end
