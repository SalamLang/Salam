import metatrader

include fake "_fake.salam"

const PORT := 19911

func report(label: str):
    err := metatrader.LastError()
    println label, metatrader.Ok(), err.code
end

func main:
    metatrader.SetBridgeUrl("http://127.0.0.1:19999")
    println metatrader.Initialize()
    report("no bridge running")

    fake.On("GET", "/account_info", 500, `{"error":"internal error"}`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    acc := metatrader.GetAccountInfo()
    println acc.login
    report("http 500")

    fake.On("GET", "/account_info", 200, `{"login":1}`)
    acc2 := metatrader.GetAccountInfo()
    println acc2.login
    report("recovered")
end
