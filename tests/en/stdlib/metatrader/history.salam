import metatrader

include fake "_fake.salam"

const PORT := 19910

func main:
    fake.On("GET", "/history_orders_total", 200, `1`)
    fake.On("GET", "/history_orders_get", 200, `[{"ticket":3001,"symbol":"EURUSD","order_type":0,"state":4,"volume_initial":1.0,"price_open":1.08}]`)
    fake.On("GET", "/history_deals_total", 200, `1`)
    fake.On("GET", "/history_deals_get", 200, `[{"ticket":4001,"order":3001,"symbol":"EURUSD","deal_type":0,"entry":0,"volume":1.0,"price":1.08,"profit":21.0,"commission":-0.7,"swap":0.0}]`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    println metatrader.HistoryOrdersTotal(0 as i64, 1800000000 as i64)
    ho := metatrader.HistoryOrdersGet(0 as i64, 1800000000 as i64)
    println ho.len()
    each o in ho:
        println o.ticket, o.symbol, o.order_type, o.state, o.volume_initial, o.price_open
    end
    println metatrader.HistoryOrdersGetGroup(0 as i64, 1800000000 as i64, "*").len(), fake.Last()
    println metatrader.HistoryOrdersGetTicket(3001 as i64).len(), fake.Last()
    println metatrader.HistoryOrdersGetPosition(3001 as i64).len(), fake.Last()

    println metatrader.HistoryDealsTotal(0 as i64, 1800000000 as i64)
    hd := metatrader.HistoryDealsGet(0 as i64, 1800000000 as i64)
    println hd.len()
    each d in hd:
        println d.ticket, d.order, d.symbol, d.deal_type, d.entry, d.volume, d.price, d.profit, d.commission
    end
    println metatrader.HistoryDealsGetGroup(0 as i64, 1800000000 as i64, "*").len(), fake.Last()
    println metatrader.HistoryDealsGetTicket(4001 as i64).len(), fake.Last()
    println metatrader.HistoryDealsGetPosition(3001 as i64).len(), fake.Last()
end
