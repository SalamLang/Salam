import metatrader

include fake "_fake.salam"

const PORT := 19907

func main:
    fake.On("GET", "/orders_total", 200, `2`)
    fake.On("GET", "/orders_get", 200, `[{"ticket":1001,"symbol":"EURUSD","order_type":0,"state":1,"volume_current":1.0,"price_open":1.08,"magic":7}, {"ticket":1002,"symbol":"GBPUSD","order_type":1,"state":1,"volume_current":2.0,"price_open":1.26,"magic":7}]`)
    fake.On("POST", "/order_calc_margin", 200, `108.5`)
    fake.On("POST", "/order_calc_profit", 200, `12.75`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    println metatrader.OrdersTotal()

    all := metatrader.OrdersGet()
    println all.len()
    each o in all:
        println o.ticket, o.symbol, o.order_type, o.state, o.volume_current, o.price_open, o.magic
    end

    bySymbol := metatrader.OrdersGetSymbol("EURUSD")
    println bySymbol.len(), fake.Last()

    byGroup := metatrader.OrdersGetGroup("*USD*")
    println byGroup.len(), fake.Last()

    byTicket := metatrader.OrdersGetTicket(1001 as i64)
    println byTicket.len(), fake.Last()

    margin := metatrader.OrderCalcMargin(metatrader.ORDER_TYPE_BUY, "EURUSD", 1.0, 1.08)
    println margin

    profit := metatrader.OrderCalcProfit(metatrader.ORDER_TYPE_BUY, "EURUSD", 1.0, 1.08, 1.09)
    println profit
end
