import metatrader

include fake "_fake.salam"

const PORT := 19909

func main:
    fake.On("GET", "/positions_total", 200, `1`)
    fake.On("GET", "/positions_get", 200, `[{"ticket":2001,"symbol":"EURUSD","position_type":0,"volume":1.0,"price_open":1.08,"price_current":1.0821,"profit":21.0,"swap":0.0,"magic":7}]`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    println metatrader.PositionsTotal()

    all := metatrader.PositionsGet()
    println all.len()
    each p in all:
        println p.ticket, p.symbol, p.position_type, p.volume, p.price_open, p.price_current, p.profit
    end

    println metatrader.PositionsGetSymbol("EURUSD").len(), fake.Last()
    println metatrader.PositionsGetGroup("*USD*").len(), fake.Last()
    println metatrader.PositionsGetTicket(2001 as i64).len(), fake.Last()
end
