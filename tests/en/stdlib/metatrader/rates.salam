import metatrader

include fake "_fake.salam"

const PORT := 19905

func main:
    fake.On("GET", "/copy_rates_from", 200, `[{"time":1700000000,"open":1.08,"high":1.081,"low":1.079,"close":1.0805,"tick_volume":150,"spread":2,"real_volume":0}, {"time":1700000060,"open":1.0805,"high":1.082,"low":1.0801,"close":1.0815,"tick_volume":132,"spread":2,"real_volume":0}]`)
    fake.On("GET", "/copy_rates_from_pos", 200, `[{"time":1700000000,"open":1.08,"high":1.081,"low":1.079,"close":1.0805,"tick_volume":150,"spread":2,"real_volume":0}]`)
    fake.On("GET", "/copy_rates_range", 200, `[{"time":1700000000,"open":1.08,"high":1.081,"low":1.079,"close":1.0805,"tick_volume":150,"spread":2,"real_volume":0}]`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    rates := metatrader.CopyRatesFrom("EURUSD", metatrader.TIMEFRAME_M1, 1700000000 as i64, 2)
    println rates.len()
    each r in rates:
        println r.time, r.open, r.high, r.low, r.close, r.tick_volume, r.spread
    end
    println fake.Last()

    rates2 := metatrader.CopyRatesFromPos("EURUSD", metatrader.TIMEFRAME_M1, 0, 1)
    println rates2.len()
    println fake.Last()

    rates3 := metatrader.CopyRatesRange("EURUSD", metatrader.TIMEFRAME_M1, 1700000000 as i64, 1700000100 as i64)
    println rates3.len()
    println fake.Last()
end
