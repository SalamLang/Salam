import metatrader

include fake "_fake.salam"

const PORT := 19903

func main:
    fake.On("GET", "/symbols_total", 200, `120`)
    fake.On("GET", "/symbols_get", 200, `[{"name":"EURUSD","digits":5,"bid":1.0821,"ask":1.0823}, {"name":"GBPUSD","digits":5,"bid":1.2601,"ask":1.2603}]`)
    fake.On("GET", "/symbol_info", 200, `{"name":"EURUSD","digits":5,"point":0.00001,"spread":2,"volume_min":0.01,"volume_max":500.0,"trade_contract_size":100000.0,"currency_base":"EUR","currency_profit":"USD"}`)
    fake.On("GET", "/symbol_info_tick", 200, `{"time":1700000000,"bid":1.0821,"ask":1.0823,"last":0.0,"volume":0,"flags":6}`)
    fake.On("POST", "/symbol_select", 200, `{}`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    println metatrader.SymbolsTotal()

    all := metatrader.SymbolsGet()
    println all.len(), all.get(0).name, all.get(1).name

    sym := metatrader.GetSymbolInfo("EURUSD")
    println sym.name, sym.digits, sym.point, sym.spread
    println sym.volume_min, sym.volume_max, sym.trade_contract_size
    println sym.currency_base, sym.currency_profit

    tick := metatrader.SymbolInfoTick("EURUSD")
    println tick.time, tick.bid, tick.ask, tick.flags

    println metatrader.SymbolSelect("EURUSD", true)
end
