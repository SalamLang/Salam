import metatrader

include fake "_fake.salam"

const PORT := 19906

func main:
    fake.On("GET", "/copy_ticks_from", 200, `[{"time":1700000000,"bid":1.0821,"ask":1.0823,"last":0.0,"volume":0,"time_msc":1700000000123,"flags":6,"volume_real":0.0}]`)
    fake.On("GET", "/copy_ticks_range", 200, `[{"time":1700000000,"bid":1.0821,"ask":1.0823,"last":0.0,"volume":0,"time_msc":1700000000123,"flags":6,"volume_real":0.0}, {"time":1700000001,"bid":1.0822,"ask":1.0824,"last":0.0,"volume":0,"time_msc":1700000001456,"flags":6,"volume_real":0.0}]`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    t1 := metatrader.CopyTicksFrom("EURUSD", 1700000000 as i64, 10, metatrader.COPY_TICKS_ALL)
    println t1.len()
    each t in t1:
        println t.time, t.bid, t.ask, t.time_msc, t.flags
    end

    t2 := metatrader.CopyTicksRange("EURUSD", 1700000000 as i64, 1700000002 as i64, metatrader.COPY_TICKS_ALL)
    println t2.len()
end
