import metatrader

include fake "_fake.salam"

const PORT := 19908

func main:
    fake.On("POST", "/order_check", 200, `{"retcode":0,"balance":10000.0,"equity":10000.0,"profit":0.0,"margin":108.5,"margin_free":9891.5,"margin_level":9216.0,"comment":"Done"}`)
    fake.On("POST", "/order_send", 200, `{"retcode":10009,"deal":55001,"order":66001,"volume":1.0,"price":1.0821,"bid":1.0820,"ask":1.0822,"comment":"Request executed"}`)
    fake.Start(PORT)
    metatrader.SetBridgeUrl("http://127.0.0.1:" + PORT)

    mut req := metatrader.TradeRequest {}
    req.action = metatrader.TRADE_ACTION_DEAL
    req.symbol = "EURUSD"
    req.volume = 1.0
    req.order_type = metatrader.ORDER_TYPE_BUY
    req.type_filling = metatrader.ORDER_FILLING_IOC
    req.type_time = metatrader.ORDER_TIME_GTC
    req.deviation = 20

    chk := metatrader.OrderCheck(req)
    println chk.retcode, chk.margin, chk.margin_free, chk.comment
    println fake.Last()

    snd := metatrader.OrderSend(req)
    println snd.retcode == metatrader.TRADE_RETCODE_DONE
    println snd.deal, snd.order, snd.volume, snd.price, snd.comment
end
