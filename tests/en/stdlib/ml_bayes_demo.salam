package main

// std/ml: Gaussian naive Bayes.

import data
import matrix
import ml
import testing

func main:
    mut y := matrix.Matrix {}
    mut x := data.MakeBlobs(300, 4, 3, 1.0, 41, y)

    mut nb := ml.GaussianNB {}
    testing.AssertTrue(nb.fit(x, y))
    testing.AssertEqInt(nb.n_classes, 4)
    testing.AssertEqInt(nb.means.rows, 4)
    testing.AssertEqInt(nb.means.cols, 3)
    testing.AssertTrue(nb.score(x, y) >= 0.95)

    // Class means sit near the empirical class centers; variances are
    // near the blob spread of 1.0
    mut sum0 := 0.0
    mut cnt0 := 0
    repeat x.rows with i:
        if y.at(i, 0) == 0.0:
            sum0 += x.at(i, 0)
            cnt0 += 1
        end
    end
    testing.AssertEqFloat(nb.means.at(0, 0), sum0 / (cnt0 as f64), 0.000001)
    testing.AssertTrue(nb.vars.at(0, 0) > 0.5)
    testing.AssertTrue(nb.vars.at(0, 0) < 1.6)
    // Balanced classes: every log prior is log(1/4)
    testing.AssertEqFloat(nb.log_priors.at(2, 0), 0.0 - 1.3862943611198906, 0.000001)

    // Posteriors are distributions; a training row's own class dominates
    mut pr := nb.predict_proba(x)
    mut sum_ok := true
    repeat pr.rows with i:
        mut s := 0.0
        repeat 4 with c: s += pr.at(i, c) end
        if s < 0.999999 || s > 1.000001: sum_ok = false end
    end
    testing.AssertTrue(sum_ok)

    // Generalization on a held-out split
    mut sp := ml.TrainTestSplit(x, y, 0.3, 5)
    mut nb2 := ml.GaussianNB {}
    testing.AssertTrue(nb2.fit(sp.x_train, sp.y_train))
    testing.AssertTrue(nb2.score(sp.x_test, sp.y_test) >= 0.9)

    // Errors
    mut fresh := ml.GaussianNB {}
    testing.AssertTrue(fresh.predict(x).is_empty())
    mut bad := matrix.Zeros(5, 1)
    testing.AssertFalse(fresh.fit(x, bad))

    nb.free()
    nb2.free()
    fresh.free()
    sp.free()
    matrix.Free(x)
    matrix.Free(y)
    matrix.Free(pr)
    matrix.Free(bad)

    ret testing.Summary()
end
