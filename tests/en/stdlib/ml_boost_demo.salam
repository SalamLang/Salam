package main

// std/ml: AdaBoost and gradient boosting.

import data
import math
import matrix
import ml
import testing

func main:
    // AdaBoost with stumps on moons: many weak learners beat one stump
    mut my := matrix.Matrix {}
    mut mx := data.MakeMoons(400, 0.2, 81, my)
    mut sp := ml.TrainTestSplit(mx, my, 0.25, 82)
    mut stump := ml.DecisionTree { max_depth = 1 }
    testing.AssertTrue(stump.fit(sp.x_train, sp.y_train))
    stump_acc := stump.score(sp.x_test, sp.y_test)
    mut ada := ml.AdaBoost { n_estimators = 60, seed = 5 }
    testing.AssertTrue(ada.fit(sp.x_train, sp.y_train))
    testing.AssertTrue(ada.ok)
    testing.AssertEqInt(ada.n_classes, 2)
    testing.AssertTrue(ada.trees.len() > 10)
    testing.AssertEqInt(ada.trees.len(), ada.alphas.len())
    ada_acc := ada.score(sp.x_test, sp.y_test)
    testing.AssertTrue(ada_acc > stump_acc)
    testing.AssertTrue(ada_acc >= 0.85)
    mut pr := ada.predict_proba(sp.x_test)
    testing.AssertEqInt(pr.cols, 2)
    testing.AssertEqFloat(pr.at(0, 0) + pr.at(0, 1), 1.0, 0.000001)

    // Multi-class AdaBoost (SAMME) on three blobs
    mut blob_y := matrix.Matrix {}
    mut blob_x := data.MakeBlobs(240, 3, 2, 1.5, 83, blob_y)
    mut ada3 := ml.AdaBoost { n_estimators = 40, max_depth = 2, seed = 6 }
    testing.AssertTrue(ada3.fit(blob_x, blob_y))
    testing.AssertEqInt(ada3.n_classes, 3)
    testing.AssertTrue(ada3.score(blob_x, blob_y) >= 0.9)

    // Gradient boosting, classification: accuracy climbs with rounds
    mut gb := ml.GradientBoosting { n_estimators = 60, learning_rate = 0.2, max_depth = 3 }
    testing.AssertTrue(gb.fit(sp.x_train, sp.y_train))
    testing.AssertEqInt(gb.n_classes, 2)
    testing.AssertEqInt(gb.trees.len(), 120)
    testing.AssertTrue(gb.score(sp.x_train, sp.y_train) >= 0.95)
    testing.AssertTrue(gb.score(sp.x_test, sp.y_test) >= 0.85)
    mut gpr := gb.predict_proba(sp.x_test)
    testing.AssertEqFloat(gpr.at(3, 0) + gpr.at(3, 1), 1.0, 0.000001)
    mut gb3 := ml.GradientBoosting { n_estimators = 30, learning_rate = 0.3, max_depth = 2 }
    testing.AssertTrue(gb3.fit(blob_x, blob_y))
    testing.AssertTrue(gb3.score(blob_x, blob_y) >= 0.9)

    // Gradient boosting, regression on a smooth curve
    mut xr := matrix.Zeros(200, 1)
    mut yr := matrix.Zeros(200, 1)
    repeat 200 with i:
        v := (i as f64) * 0.03
        xr.set(i, 0, v)
        yr.set(i, 0, math.Sin(v) + 0.2 * v)
    end
    mut gr := ml.GradientBoosting { n_estimators = 80, learning_rate = 0.2, max_depth = 3, regression = true }
    testing.AssertTrue(gr.fit(xr, yr))
    testing.AssertEqInt(gr.n_classes, 1)
    testing.AssertTrue(gr.score(xr, yr) > 0.98)
    mut q := matrix.Full(1, 1, 2.0)
    mut pq := gr.predict(q)
    want := math.Sin(2.0) + 0.4
    testing.AssertTrue(pq.at(0, 0) > want - 0.1)
    testing.AssertTrue(pq.at(0, 0) < want + 0.1)
    testing.AssertTrue(gr.predict_proba(xr).is_empty())

    // Errors
    mut fresh := ml.AdaBoost {}
    testing.AssertTrue(fresh.predict(mx).is_empty())
    mut one := matrix.Zeros(10, 1)
    mut xo := matrix.Zeros(10, 2)
    testing.AssertFalse(fresh.fit(xo, one))
    mut gfresh := ml.GradientBoosting {}
    testing.AssertTrue(gfresh.predict(mx).is_empty())

    stump.free()
    ada.free()
    ada3.free()
    gb.free()
    gb3.free()
    gr.free()
    fresh.free()
    gfresh.free()
    sp.free()
    matrix.Free(mx)
    matrix.Free(my)
    matrix.Free(pr)
    matrix.Free(blob_x)
    matrix.Free(blob_y)
    matrix.Free(gpr)
    matrix.Free(xr)
    matrix.Free(yr)
    matrix.Free(q)
    matrix.Free(pq)
    matrix.Free(one)
    matrix.Free(xo)

    ret testing.Summary()
end
