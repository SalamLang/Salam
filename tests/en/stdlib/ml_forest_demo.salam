package main

import data
import math
import matrix
import ai.ml
import testing

func main:
    mut my := matrix.Matrix {}
    mut mx := data.MakeMoons(400, 0.25, 71, my)
    mut sp := ml.TrainTestSplit(mx, my, 0.25, 72)
    mut rf := ml.RandomForest { n_trees = 40, max_depth = 8, seed = 3 }
    testing.AssertTrue(rf.Fit(sp.x_train, sp.y_train))
    testing.AssertTrue(rf.ok)
    testing.AssertEqInt(rf.trees.Len(), 40)
    testing.AssertEqInt(rf.n_classes, 2)
    testing.AssertTrue(rf.Score(sp.x_train, sp.y_train) >= 0.95)
    testing.AssertTrue(rf.Score(sp.x_test, sp.y_test) >= 0.88)
    mut pr := rf.PredictProba(sp.x_test)
    mut sums_ok := true
    repeat pr.rows in i:
        s := pr.at(i, 0) + pr.at(i, 1)
        if s < 0.999999 or s > 1.000001: sums_ok = false end
    end
    testing.AssertTrue(sums_ok)

    mut rfp := ml.RandomForest { n_trees = 40, max_depth = 8, seed = 3, workers = 4 }
    testing.AssertTrue(rfp.Fit(sp.x_train, sp.y_train))
    mut same := true
    repeat 40 in t:
        mut a := rf.trees.Get(t)
        mut b := rfp.trees.Get(t)
        if a.node_count() != b.node_count(): same = false end
        if a.node_count() > 0 and a.threshold.Get(0) != b.threshold.Get(0): same = false end
    end
    testing.AssertTrue(same)
    mut p1 := rf.Predict(sp.x_test)
    mut p2 := rfp.Predict(sp.x_test)
    testing.AssertTrue(matrix.AllClose(p1, p2, 0.0))

    mut cy := matrix.Matrix {}
    mut cx := data.MakeClassification(600, 6, 3, 2.5, 73, cy)
    mut csp := ml.TrainTestSplit(cx, cy, 0.3, 5)
    mut big := ml.RandomForest { n_trees = 100, max_depth = 12, seed = 9, workers = 0 - 1 }
    testing.AssertTrue(big.Fit(csp.x_train, csp.y_train))
    testing.AssertTrue(big.Score(csp.x_test, csp.y_test) >= 0.95)

    mut xr := matrix.Zeros(300, 2)
    mut yr := matrix.Zeros(300, 1)
    mut g := matrix.NewRng(74)
    repeat 300 in i:
        a := g.next_float() * 3.0
        b := g.next_float() * 3.0
        xr.Set(i, 0, a)
        xr.Set(i, 1, b)
        yr.Set(i, 0, math.Sin(a) + 0.5 * b)
    end
    mut rr := ml.RandomForest { n_trees = 30, criterion = ml.TREE_MSE, max_depth = 10, seed = 4 }
    testing.AssertTrue(rr.Fit(xr, yr))
    testing.AssertTrue(rr.is_regression())
    testing.AssertTrue(rr.Score(xr, yr) > 0.95)
    testing.AssertTrue(rr.PredictProba(xr).IsEmpty())

    mut fresh := ml.RandomForest {}
    testing.AssertTrue(fresh.Predict(mx).IsEmpty())
    mut none := ml.RandomForest { n_trees = 0 }
    testing.AssertFalse(none.Fit(mx, my))

    rf.Free()
    rfp.Free()
    big.Free()
    rr.Free()
    fresh.Free()
    none.Free()
    sp.Free()
    csp.Free()
    matrix.Free(mx)
    matrix.Free(my)
    matrix.Free(pr)
    matrix.Free(p1)
    matrix.Free(p2)
    matrix.Free(cx)
    matrix.Free(cy)
    matrix.Free(xr)
    matrix.Free(yr)

    ret testing.Summary()
end
