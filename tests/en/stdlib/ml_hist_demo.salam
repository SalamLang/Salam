package main

import data
import math
import matrix
import ai.ml
import testing

func main:
    mut my := matrix.Matrix {}
    mut mx := data.MakeMoons(400, 0.2, 81, my)
    mut sp := ml.TrainTestSplit(mx, my, 0.25, 82)
    mut hb := ml.HistGradientBoosting { n_estimators = 60, learning_rate = 0.2, max_depth = 4, min_samples_leaf = 5 }
    testing.AssertTrue(hb.Fit(sp.x_train, sp.y_train))
    testing.AssertTrue(hb.ok)
    testing.AssertEqInt(hb.n_classes, 2)
    testing.AssertEqInt(hb.trees.Len(), 120)
    testing.AssertTrue(hb.Score(sp.x_train, sp.y_train) >= 0.95)
    testing.AssertTrue(hb.Score(sp.x_test, sp.y_test) >= 0.85)
    mut pr := hb.PredictProba(sp.x_test)
    testing.AssertEqInt(pr.cols, 2)
    testing.AssertEqFloat(pr.at(3, 0) + pr.at(3, 1), 1.0, 0.000001)
    testing.AssertEqInt(hb.edges_start.Len(), 3)
    testing.AssertTrue(hb.edges_start.Get(1) - hb.edges_start.Get(0) < 255)
    testing.AssertTrue(hb.edges_start.Get(1) - hb.edges_start.Get(0) > 10)

    mut bly := matrix.Matrix {}
    mut blx := data.MakeBlobs(240, 3, 2, 1.5, 83, bly)
    mut hb3 := ml.HistGradientBoosting { n_estimators = 30, learning_rate = 0.3, max_depth = 3, max_bins = 16, min_samples_leaf = 5 }
    testing.AssertTrue(hb3.Fit(blx, bly))
    testing.AssertEqInt(hb3.n_classes, 3)
    testing.AssertEqInt(hb3.trees.Len(), 90)
    testing.AssertTrue(hb3.Score(blx, bly) >= 0.9)
    mut d := hb3.Decision(blx)
    testing.AssertEqInt(d.cols, 3)

    mut xr := matrix.Zeros(200, 2)
    mut yr := matrix.Zeros(200, 1)
    repeat 200 in i:
        v := (i as f64) * 0.03
        xr.Set(i, 0, v)
        xr.Set(i, 1, 7.0)
        yr.Set(i, 0, math.Sin(v) + 0.2 * v)
    end
    mut hr := ml.HistGradientBoosting { n_estimators = 80, learning_rate = 0.2, max_depth = 3, min_samples_leaf = 3, regression = true }
    testing.AssertTrue(hr.Fit(xr, yr))
    testing.AssertEqInt(hr.n_classes, 1)
    testing.AssertEqInt(hr.edges_start.Get(2) - hr.edges_start.Get(1), 0)
    testing.AssertTrue(hr.Score(xr, yr) > 0.98)
    mut q := matrix.Zeros(1, 2)
    q.Set(0, 0, 2.0)
    q.Set(0, 1, 7.0)
    mut pq := hr.Predict(q)
    testing.AssertTrue(math.Abs(pq.at(0, 0) - (math.Sin(2.0) + 0.4)) < 0.15)

    mut empty := ml.HistGradientBoosting {}
    mut none := empty.Predict(q)
    testing.AssertTrue(none.IsEmpty())
    testing.AssertTrue(not empty.Fit(q, yr))

    pr.Free()
    d.Free()
    q.Free()
    pq.Free()
    hb.Free()
    hb3.Free()
    hr.Free()
    empty.Free()
    sp.Free()
    mx.Free()
    my.Free()
    blx.Free()
    bly.Free()
    xr.Free()
    yr.Free()
    ret testing.Summary()
end
