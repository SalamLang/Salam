package main

import data
import matrix
import ai.ml
import testing

func main:
    mut y := matrix.Matrix {}
    mut x := data.MakeBlobs(300, 3, 3, 1.2, 101, y)
    mut sp := ml.TrainTestSplit(x, y, 0.3, 102)
    mut lda := ml.LDA {}
    testing.AssertTrue(lda.Fit(sp.x_train, sp.y_train))
    testing.AssertTrue(lda.ok)
    testing.AssertEqInt(lda.n_classes, 3)
    testing.AssertEqInt(lda.cov.rows, 3)
    testing.AssertTrue(lda.Score(sp.x_train, sp.y_train) >= 0.95)
    testing.AssertTrue(lda.Score(sp.x_test, sp.y_test) >= 0.93)
    testing.AssertTrue(lda.cov.at(0, 0) > 0.9)
    testing.AssertTrue(lda.cov.at(0, 0) < 2.0)
    mut pr := lda.PredictProba(sp.x_test)
    mut ok := true
    repeat pr.rows in i:
        s := pr.at(i, 0) + pr.at(i, 1) + pr.at(i, 2)
        if s < 0.999999 or s > 1.000001: ok = false end
    end
    testing.AssertTrue(ok)

    mut qda := ml.QDA {}
    testing.AssertTrue(qda.Fit(sp.x_train, sp.y_train))
    testing.AssertEqInt(qda.covs.Len(), 3)
    testing.AssertTrue(qda.Score(sp.x_test, sp.y_test) >= 0.9)

    mut xq := matrix.Zeros(400, 2)
    mut yq := matrix.Zeros(400, 1)
    mut g := matrix.NewRng(103)
    repeat 400 in i:
        if i % 2 == 0:
            xq.set(i, 0, 0.3 * g.next_normal())
            xq.set(i, 1, 0.3 * g.next_normal())
            yq.set(i, 0, 0.0)
        else:
            xq.set(i, 0, 3.0 * g.next_normal())
            xq.set(i, 1, 3.0 * g.next_normal())
            yq.set(i, 0, 1.0)
        end
    end
    mut q2 := ml.QDA {}
    testing.AssertTrue(q2.Fit(xq, yq))
    mut l2 := ml.LDA {}
    testing.AssertTrue(l2.Fit(xq, yq))
    testing.AssertTrue(q2.Score(xq, yq) >= 0.85)
    testing.AssertTrue(q2.Score(xq, yq) > l2.Score(xq, yq))

    mut fresh := ml.LDA {}
    testing.AssertTrue(fresh.Predict(x).IsEmpty())
    mut one := matrix.Zeros(10, 1)
    mut xo := matrix.Zeros(10, 2)
    testing.AssertFalse(fresh.Fit(xo, one))

    lda.Free()
    qda.Free()
    q2.Free()
    l2.Free()
    fresh.Free()
    sp.Free()
    matrix.Free(x)
    matrix.Free(y)
    matrix.Free(pr)
    matrix.Free(xq)
    matrix.Free(yq)
    matrix.Free(one)
    matrix.Free(xo)

    ret testing.Summary()
end
