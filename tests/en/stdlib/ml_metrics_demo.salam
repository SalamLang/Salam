package main

import math
import matrix
import ai.ml
import testing

func col(vals_in: Vector<f64>): matrix.Matrix:
    mut vals := vals_in
    ret matrix.ColVector(vals)
end

func main:
    eps := 0.000001

    mut yv := Vector {} as Vector<f64>
    mut pv := Vector {} as Vector<f64>
    yv.Push(1.0)
    pv.Push(1.0)
    yv.Push(1.0)
    pv.Push(1.0)
    yv.Push(1.0)
    pv.Push(1.0)
    yv.Push(1.0)
    pv.Push(0.0)
    yv.Push(0.0)
    pv.Push(1.0)
    yv.Push(0.0)
    pv.Push(0.0)
    yv.Push(0.0)
    pv.Push(0.0)
    yv.Push(0.0)
    pv.Push(0.0)
    mut y := col(yv)
    mut p := col(pv)

    testing.AssertEqFloat(ml.Accuracy(y, p), 6.0 / 8.0, eps)
    testing.AssertEqFloat(ml.Precision(y, p, 1.0), 3.0 / 4.0, eps)
    testing.AssertEqFloat(ml.Recall(y, p, 1.0), 3.0 / 4.0, eps)
    testing.AssertEqFloat(ml.F1(y, p, 1.0), 0.75, eps)
    testing.AssertEqFloat(ml.MacroF1(y, p, 2), 0.75, eps)

    mut cm := ml.ConfusionMatrix(y, p, 2)
    testing.AssertEqFloat(cm.at(1, 1), 3.0, eps)
    testing.AssertEqFloat(cm.at(0, 1), 1.0, eps)
    testing.AssertEqFloat(cm.at(1, 0), 1.0, eps)
    testing.AssertEqFloat(cm.at(0, 0), 3.0, eps)

    mut sv := Vector {} as Vector<f64>
    sv.Push(0.9)
    sv.Push(0.8)
    sv.Push(0.7)
    sv.Push(0.6)
    sv.Push(0.4)
    sv.Push(0.3)
    sv.Push(0.2)
    sv.Push(0.1)
    mut s := col(sv)
    testing.AssertEqFloat(ml.RocAuc(y, s), 1.0, eps)
    mut neg := matrix.Neg(s)
    testing.AssertEqFloat(ml.RocAuc(y, neg), 0.0, eps)
    s.Set(3, 0, 0.35)
    testing.AssertEqFloat(ml.RocAuc(y, s), 15.0 / 16.0, eps)
    mut tied := matrix.Full(8, 1, 0.5)
    testing.AssertEqFloat(ml.RocAuc(y, tied), 0.5, eps)

    mut proba := matrix.Zeros(2, 2)
    proba.Set(0, 0, 0.2)
    proba.Set(0, 1, 0.8)
    proba.Set(1, 0, 0.6)
    proba.Set(1, 1, 0.4)
    mut yl := matrix.Zeros(2, 1)
    yl.Set(0, 0, 1.0)
    yl.Set(1, 0, 0.0)
    want := 0.0 - (math.Log(0.8) + math.Log(0.6)) / 2.0
    testing.AssertEqFloat(ml.LogLoss(yl, proba), want, eps)
    proba.Set(1, 0, 0.0)
    testing.AssertTrue(ml.LogLoss(yl, proba) < 20.0)

    mut tv := Vector {} as Vector<f64>
    mut qv := Vector {} as Vector<f64>
    tv.Push(1.0)
    qv.Push(2.0)
    tv.Push(2.0)
    qv.Push(2.0)
    tv.Push(3.0)
    qv.Push(5.0)
    mut t := col(tv)
    mut q := col(qv)
    testing.AssertEqFloat(ml.MSE(t, q), (1.0 + 0.0 + 4.0) / 3.0, eps)
    testing.AssertEqFloat(ml.MAE(t, q), (1.0 + 0.0 + 2.0) / 3.0, eps)
    testing.AssertEqFloat(ml.RMSE(t, q), math.Sqrt(5.0 / 3.0), eps)
    testing.AssertEqFloat(ml.R2Score(t, q), 1.0 - 5.0 / 2.0, eps)
    testing.AssertEqFloat(ml.R2Score(t, t), 1.0, eps)

    testing.AssertEqFloat(ml.Accuracy(y, t), 0.0, eps)
    testing.AssertTrue(ml.ConfusionMatrix(y, t, 2).IsEmpty())

    matrix.Free(y)
    matrix.Free(p)
    matrix.Free(cm)
    matrix.Free(s)
    matrix.Free(neg)
    matrix.Free(tied)
    matrix.Free(proba)
    matrix.Free(yl)
    matrix.Free(t)
    matrix.Free(q)
    yv.Free()
    pv.Free()
    sv.Free()
    tv.Free()
    qv.Free()

    ret testing.Summary()
end
