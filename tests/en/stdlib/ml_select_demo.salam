package main

// std/ml: splits, folds, and cross-validation over callbacks.

import data
import matrix
import ml
import testing

// A stand-in estimator: predicts the majority class of the training
// labels for every test row.
func majority(ytr: matrix.Matrix, xte: matrix.Matrix): matrix.Matrix:
    nc := ml.CountClasses(ytr)
    mut counts := Vector {} as Vector<int>
    counts.zeros(nc)
    repeat ytr.rows with i:
        k := ytr.at(i, 0) as int
        counts.set(k, counts.get(k) + 1)
    end
    mut best := 0
    repeat nc with k:
        if counts.get(k) > counts.get(best): best = k end
    end
    counts.free()
    ret matrix.Full(xte.rows, 1, best as f64)
end

// The mean of the training targets, for the regression path.
func mean_pred(ytr: matrix.Matrix, xte: matrix.Matrix): matrix.Matrix:
    mut s := 0.0
    repeat ytr.rows with i: s += ytr.at(i, 0) end
    ret matrix.Full(xte.rows, 1, s / (ytr.rows as f64))
end

func main:
    eps := 0.000001

    mut y := matrix.Matrix {}
    mut x := data.MakeClassification(100, 3, 4, 2.0, 5, y)

    // TrainTestSplit: sizes, disjointness, determinism
    mut sp := ml.TrainTestSplit(x, y, 0.25, 9)
    testing.AssertEqInt(sp.x_test.rows, 25)
    testing.AssertEqInt(sp.x_train.rows, 75)
    testing.AssertEqInt(sp.y_test.rows, 25)
    testing.AssertEqInt(sp.x_train.cols, 3)
    mut sp2 := ml.TrainTestSplit(x, y, 0.25, 9)
    testing.AssertTrue(matrix.AllClose(sp.x_test, sp2.x_test, eps))
    mut sp3 := ml.TrainTestSplit(x, y, 0.25, 10)
    testing.AssertFalse(matrix.AllClose(sp.x_test, sp3.x_test, eps))
    // every row of x appears exactly once across the two halves
    mut total := 0.0
    repeat sp.x_train.rows with i: total += sp.x_train.at(i, 0) end
    repeat sp.x_test.rows with i: total += sp.x_test.at(i, 0) end
    mut want := 0.0
    repeat x.rows with i: want += x.at(i, 0) end
    testing.AssertEqFloat(total, want, 0.0001)

    // KFold: 100 rows into 3 folds are 34, 33, 33; every row tested once
    mut f := ml.KFold(100, 3, true, 1)
    testing.AssertEqInt(f.count(), 3)
    testing.AssertEqInt(f.test.get(0).len(), 34)
    testing.AssertEqInt(f.test.get(2).len(), 33)
    testing.AssertEqInt(f.train.get(0).len(), 66)
    mut seen := Vector {} as Vector<int>
    seen.zeros(100)
    repeat 3 with k:
        te := f.test.get(k)
        repeat te.len() with i: seen.set(te.get(i), seen.get(te.get(i)) + 1) end
    end
    mut once := true
    repeat 100 with i:
        if seen.get(i) != 1: once = false end
    end
    testing.AssertTrue(once)
    seen.free()
    // unshuffled folds are contiguous
    mut fc := ml.KFold(10, 5, false, 0)
    testing.AssertEqInt(fc.test.get(2).get(0), 4)
    testing.AssertEqInt(fc.test.get(2).get(1), 5)
    // too few rows: no folds
    testing.AssertEqInt(ml.KFold(3, 5, false, 0).count(), 0)

    // StratifiedKFold keeps 25 of each class spread 5 per fold
    mut sf := ml.StratifiedKFold(y, 5, 3)
    testing.AssertEqInt(sf.count(), 5)
    mut balanced := true
    repeat 5 with k:
        te := sf.test.get(k)
        testing.AssertEqInt(te.len(), 20)
        mut c0 := 0
        repeat te.len() with i:
            if y.at(te.get(i), 0) == 0.0: c0 += 1 end
        end
        if c0 != 5: balanced = false end
    end
    testing.AssertTrue(balanced)

    // CrossValScore with the majority predictor: balanced classes give
    // about 0.25 accuracy on every fold
    mut scores := ml.CrossValScore(
        (xtr: matrix.Matrix, ytr: matrix.Matrix, xte: matrix.Matrix): ret majority(ytr, xte) end,
        (a: matrix.Matrix, b: matrix.Matrix): ret ml.Accuracy(a, b) end,
        x, y, sf
    )
    testing.AssertEqInt(scores.len(), 5)
    m := ml.MeanScore(scores)
    testing.AssertTrue(m > 0.15)
    testing.AssertTrue(m < 0.35)

    // A regression pass through the same machinery
    mut ry := matrix.Matrix {}
    mut rw := matrix.Matrix {}
    mut rx := data.MakeRegression(60, 2, 0.1, 4, ry, rw)
    mut rf := ml.KFold(60, 4, true, 2)
    mut rscores := ml.CrossValScore(
        (xtr: matrix.Matrix, ytr: matrix.Matrix, xte: matrix.Matrix): ret mean_pred(ytr, xte) end,
        (a: matrix.Matrix, b: matrix.Matrix): ret ml.R2Score(a, b) end,
        rx, ry, rf
    )
    testing.AssertEqInt(rscores.len(), 4)
    // the mean predictor explains nothing: R2 at or below zero
    testing.AssertTrue(ml.MeanScore(rscores) <= 0.0001)

    sp.free()
    sp2.free()
    sp3.free()
    f.free()
    fc.free()
    sf.free()
    rf.free()
    scores.free()
    rscores.free()
    matrix.Free(x)
    matrix.Free(y)
    matrix.Free(rx)
    matrix.Free(ry)
    matrix.Free(rw)

    ret testing.Summary()
end
