package main

// std/ml: linear SVM by dual coordinate descent, kernel SVC by SMO.

import data
import matrix
import ml
import testing

func main:
    // Linear SVM separates two blobs perfectly and generalizes
    mut y2 := matrix.Matrix {}
    mut x2 := data.MakeClassification(200, 3, 2, 3.0, 91, y2)
    mut sp := ml.TrainTestSplit(x2, y2, 0.25, 92)
    mut lsvm := ml.LinearSVM { c = 1.0 }
    testing.AssertTrue(lsvm.fit(sp.x_train, sp.y_train))
    testing.AssertTrue(lsvm.ok)
    testing.AssertEqInt(lsvm.n_classes, 2)
    testing.AssertEqInt(lsvm.coef.cols, 1)
    testing.AssertTrue(lsvm.score(sp.x_train, sp.y_train) >= 0.97)
    testing.AssertTrue(lsvm.score(sp.x_test, sp.y_test) >= 0.95)
    // Margins have the right sign structure
    mut d := lsvm.decision(sp.x_test)
    mut pred := lsvm.predict(sp.x_test)
    mut agree := true
    repeat d.rows with i:
        if (d.at(i, 0) > 0.0) != (pred.at(i, 0) == 1.0): agree = false end
    end
    testing.AssertTrue(agree)

    // Three classes, one-versus-rest
    mut y3 := matrix.Matrix {}
    mut x3 := data.MakeBlobs(240, 3, 2, 1.0, 93, y3)
    mut lsvm3 := ml.LinearSVM { c = 0.5 }
    testing.AssertTrue(lsvm3.fit(x3, y3))
    testing.AssertEqInt(lsvm3.n_classes, 3)
    testing.AssertEqInt(lsvm3.coef.cols, 3)
    testing.AssertTrue(lsvm3.score(x3, y3) >= 0.95)

    // RBF SVC solves the moons, which no linear boundary can
    mut my := matrix.Matrix {}
    mut mx := data.MakeMoons(200, 0.15, 94, my)
    mut msp := ml.TrainTestSplit(mx, my, 0.25, 95)
    mut lin := ml.LinearSVM {}
    testing.AssertTrue(lin.fit(msp.x_train, msp.y_train))
    lin_acc := lin.score(msp.x_test, msp.y_test)
    mut svc := ml.SVC { c = 2.0, gamma = 2.0 }
    testing.AssertTrue(svc.fit(msp.x_train, msp.y_train))
    testing.AssertTrue(svc.ok)
    testing.AssertTrue(svc.n_support() > 0)
    testing.AssertTrue(svc.n_support() < msp.x_train.rows)
    svc_acc := svc.score(msp.x_test, msp.y_test)
    testing.AssertTrue(svc_acc >= 0.92)
    testing.AssertTrue(svc_acc > lin_acc)

    // Polynomial and linear kernels train too; linear kernel agrees
    // closely with the linear machine
    mut poly := ml.SVC { kernel = ml.KERNEL_POLY, degree = 3, gamma = 1.0 }
    testing.AssertTrue(poly.fit(msp.x_train, msp.y_train))
    testing.AssertTrue(poly.score(msp.x_test, msp.y_test) >= 0.85)
    mut ksvc := ml.SVC { kernel = ml.KERNEL_LINEAR, c = 1.0 }
    testing.AssertTrue(ksvc.fit(sp.x_train, sp.y_train))
    testing.AssertTrue(ksvc.score(sp.x_test, sp.y_test) >= 0.95)

    // Multi-class SVC
    mut svc3 := ml.SVC { c = 1.0 }
    testing.AssertTrue(svc3.fit(x3, y3))
    testing.AssertEqInt(svc3.n_classes, 3)
    testing.AssertTrue(svc3.score(x3, y3) >= 0.95)

    // Errors
    mut fresh := ml.LinearSVM {}
    testing.AssertTrue(fresh.predict(x2).is_empty())
    mut one := matrix.Zeros(10, 1)
    mut xo := matrix.Zeros(10, 2)
    testing.AssertFalse(fresh.fit(xo, one))
    mut sfresh := ml.SVC {}
    testing.AssertTrue(sfresh.decision(x2).is_empty())

    lsvm.free()
    lsvm3.free()
    lin.free()
    svc.free()
    poly.free()
    ksvc.free()
    svc3.free()
    fresh.free()
    sfresh.free()
    sp.free()
    msp.free()
    matrix.Free(x2)
    matrix.Free(y2)
    matrix.Free(d)
    matrix.Free(pred)
    matrix.Free(x3)
    matrix.Free(y3)
    matrix.Free(mx)
    matrix.Free(my)
    matrix.Free(one)
    matrix.Free(xo)

    ret testing.Summary()
end
