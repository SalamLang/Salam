// time.Mono* is the monotonic clock: it never runs backwards and never jumps
// when the wall clock is adjusted, so a difference of two readings is a valid
// elapsed time. The wall clock (time.Now*) is not usable for that: on Windows
// GetSystemTimeAsFileTime only updates every ~15.6 ms, so any region faster
// than that measured as exactly 0 before this clock existed.
//
// Nothing here asserts a specific duration; timings are machine-dependent.
// What it does assert is what was actually broken: sub-millisecond work must
// register as more than zero, and the clock must not go backwards.

package main

import testing
import time
import debug

func burn(n: int): int:
    mut i := 0
    mut s := 0
    until i < n:
        s = s + (i % 7)
        i += 1
    end
    ret s
end

func test_monotonic_is_positive():
    testing.AssertTrue(time.MonoNanos() > 0)
    testing.AssertTrue(time.MonoMicros() > 0)
    testing.AssertTrue(time.MonoMillis() >= 0)
end

func test_monotonic_never_goes_backwards():
    mut prev := time.MonoNanos()
    mut i := 0
    mut ok := true
    until i < 200:
        now := time.MonoNanos()
        if now < prev:
            ok = false
        end
        prev = now
        i += 1
    end
    testing.AssertMsg(ok, "monotonic clock went backwards")
end

// The regression this clock was added for: a short region must not measure 0.
func test_short_region_is_measurable():
    t0 := time.MonoNanos()
    _sink := burn(200000)
    elapsed := time.SinceNanos(t0)
    testing.AssertMsg(elapsed > 0, "sub-millisecond region measured as 0 ns")
end

func test_since_ms_matches_since_nanos():
    t0 := time.MonoNanos()
    _sink := burn(200000)
    ns := time.SinceNanos(t0)
    ms := time.SinceMs(t0)
    // SinceMs is read after SinceNanos, so it can only be larger.
    testing.AssertMsg(ms >= 0.0, "SinceMs went negative")
    testing.AssertMsg((ns as f64) / 1000000.0 <= ms + 1.0, "SinceMs and SinceNanos disagree")
end

// debug.StartTimer/StopTimer used to read the wall clock and returned 0.0 for
// anything under the Windows timer tick.
func test_debug_timer_is_measurable():
    debug.StartTimer("burn")
    _sink := burn(200000)
    ms := debug.StopTimer("burn")
    testing.AssertMsg(ms > 0.0, "debug.StopTimer measured a short region as 0.0 ms")
end

func test_debug_timer_unknown_is_zero():
    testing.AssertEqFloat(debug.StopTimer("never-started"), 0.0, 0.000001)
end

// The wall clock is still the right thing for a timestamp, and still works.
func test_wall_clock_still_works():
    testing.AssertTrue(time.NowNanos() > 0)
    testing.AssertTrue(time.Now() > 0)
end

func main:
    test_monotonic_is_positive()
    test_monotonic_never_goes_backwards()
    test_short_region_is_measurable()
    test_since_ms_matches_since_nanos()
    test_debug_timer_is_measurable()
    test_debug_timer_unknown_is_zero()
    test_wall_clock_still_works()
    testing.Summary()
end
