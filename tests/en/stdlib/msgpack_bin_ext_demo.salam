package main

import compress
import encoding.msgpack
import encoding.value
import testing

func main(): int throws:
    raw := "abc"
    mut bin := value.ValueBinary(raw as void*, raw.Len())
    mut packed := msgpack.Marshal(bin)
    mut got := try msgpack.Unmarshal(packed)
    testing.AssertTrue(value.IsBytes(got))
    testing.AssertEqStr(value.BytesToStr(got), "abc")
    testing.AssertEqInt(value.BytesLen(got), 3)

    mut bin2 := value.ValueBinaryStr("pq")
    testing.AssertEqInt(value.BytesLen(bin2), 2)
    testing.AssertEqInt(value.BytesGet(bin2, 0), 112)
    testing.AssertEqStr(value.BytesToStr(bin2), "pq")
    mut copy_buf := value.BytesToBuf(bin2)
    testing.AssertEqInt(copy_buf.len, 2)
    compress.BufFree(copy_buf)

    mut ext := value.ValueExt(0 - 5, "xy" as void*, 2)
    mut ext2 := value.ValueExtStr(7, "zw")
    testing.AssertEqInt(value.ExtDataLen(ext2), 2)
    testing.AssertEqInt(value.ExtDataGet(ext2, 0), 122)
    mut ext_buf := value.ExtDataToBuf(ext2)
    testing.AssertEqInt(ext_buf.len, 2)
    compress.BufFree(ext_buf)
    mut packed_ext := msgpack.Marshal(ext)
    mut got_ext := try msgpack.Unmarshal(packed_ext)
    testing.AssertTrue(value.IsExt(got_ext))
    testing.AssertEqInt(value.ExtType(got_ext), 0 - 5)
    testing.AssertEqStr(value.ExtDataToStr(got_ext), "xy")

    // bin8: 0xc4 0x03 0x00 0xff 0x41
    mut b1 := compress.NewByteBuf()
    compress.BufPush(b1, 0xc4)
    compress.BufPush(b1, 3)
    compress.BufPush(b1, 0)
    compress.BufPush(b1, 255)
    compress.BufPush(b1, 65)
    mut v1 := try msgpack.Unmarshal(b1)
    testing.AssertTrue(value.IsBytes(v1))
    testing.AssertEqInt(value.BytesLen(v1), 3)

    // fixext1: 0xd4 0x2a 0x7f (type 42, one byte)
    mut b2 := compress.NewByteBuf()
    compress.BufPush(b2, 0xd4)
    compress.BufPush(b2, 42)
    compress.BufPush(b2, 127)
    mut v2 := try msgpack.Unmarshal(b2)
    testing.AssertTrue(value.IsExt(v2))
    testing.AssertEqInt(value.ExtType(v2), 42)
    testing.AssertEqInt(value.ExtDataToStr(v2).Len(), 1)

    // ext8: 0xc7 0x01 0xff 0x09 (type -1, one byte)
    mut b3 := compress.NewByteBuf()
    compress.BufPush(b3, 0xc7)
    compress.BufPush(b3, 1)
    compress.BufPush(b3, 255)
    compress.BufPush(b3, 9)
    mut v3 := try msgpack.Unmarshal(b3)
    testing.AssertTrue(value.IsExt(v3))
    testing.AssertEqInt(value.ExtType(v3), 0 - 1)

    value.ValueFree(got)
    value.ValueFree(got_ext)
    value.ValueFree(v1)
    value.ValueFree(v2)
    value.ValueFree(v3)
    value.ValueFree(bin)
    value.ValueFree(bin2)
    value.ValueFree(ext)
    value.ValueFree(ext2)
    compress.BufFree(packed)
    compress.BufFree(packed_ext)
    compress.BufFree(b1)
    compress.BufFree(b2)
    compress.BufFree(b3)

    ret testing.Summary()
end
