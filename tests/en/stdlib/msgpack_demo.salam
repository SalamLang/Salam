package main

import encoding.msgpack
import encoding.value
import compress
import testing

func fails_with(b: compress.ByteBuf, kind: ErrorKind): bool:
    try:
        msgpack.Unmarshal(b)
    catch e:
        ret e.is(kind)
    end
    ret false
end

func roundtrip_int(n: i64) throws:
    mut b := msgpack.Marshal(value.ValueInt(n))
    v := try msgpack.Unmarshal(b)
    testing.AssertEqInt64(value.AsInt(v), n)
    compress.BufFree(b)
end

func checks() throws:
    mut huge := compress.NewByteBuf()
    each b in [221, 127, 255, 255, 255, 1, 2]:
        compress.BufPush(huge, b)
    end
    testing.AssertTrue(fails_with(huge, ErrorKind.UnexpectedEnd))
    compress.BufFree(huge)
    mut nest := compress.NewByteBuf()
    repeat 600:
        compress.BufPush(nest, 145)
    end
    compress.BufPush(nest, 1)
    testing.AssertTrue(fails_with(nest, ErrorKind.OutOfRange))
    compress.BufFree(nest)
    mut bn := msgpack.Marshal(value.ValueNull())
    vn := try msgpack.Unmarshal(bn)
    testing.AssertTrue(value.IsNull(vn))
    compress.BufFree(bn)

    mut bt := msgpack.Marshal(value.ValueBool(true))
    vt := try msgpack.Unmarshal(bt)
    testing.AssertTrue(value.IsBool(vt))
    testing.AssertTrue(value.AsBool(vt))
    compress.BufFree(bt)

    mut bf := msgpack.Marshal(value.ValueBool(false))
    vf := try msgpack.Unmarshal(bf)
    testing.AssertFalse(value.AsBool(vf))
    compress.BufFree(bf)

    try roundtrip_int(0 as i64)
    try roundtrip_int(127 as i64)
    try roundtrip_int(128 as i64)
    try roundtrip_int(255 as i64)
    try roundtrip_int(256 as i64)
    try roundtrip_int(65535 as i64)
    try roundtrip_int(65536 as i64)
    try roundtrip_int(0 - 1 as i64)
    try roundtrip_int(0 - 32 as i64)
    try roundtrip_int(0 - 33 as i64)
    try roundtrip_int(0 - 129 as i64)
    try roundtrip_int(4294967296 as i64)
    try roundtrip_int(0 - 9223372036854775807 as i64)

    mut bF := msgpack.Marshal(value.ValueFloat(3.5))
    vF := try msgpack.Unmarshal(bF)
    testing.AssertEqFloat(value.AsFloat(vF), 3.5, 0.0001)
    compress.BufFree(bF)

    s31 := "1234567890123456789012345678901"
    testing.AssertEqInt(s31.len(), 31)
    mut bS1 := msgpack.Marshal(value.ValueString(s31))
    testing.AssertEqInt(compress.BufLen(bS1), 32)
    vS1 := try msgpack.Unmarshal(bS1)
    testing.AssertEqStr(value.AsString(vS1), s31)
    compress.BufFree(bS1)

    s32 := "12345678901234567890123456789012"
    testing.AssertEqInt(s32.len(), 32)
    mut bS2 := msgpack.Marshal(value.ValueString(s32))
    testing.AssertEqInt(compress.BufLen(bS2), 34)
    vS2 := try msgpack.Unmarshal(bS2)
    testing.AssertEqStr(value.AsString(vS2), s32)
    compress.BufFree(bS2)

    mut arr := value.NewValueArray()
    value.ArrayPush(arr, value.ValueInt(1 as i64))
    value.ArrayPush(arr, value.ValueString("x"))
    value.ArrayPush(arr, value.ValueBool(true))
    mut bA := msgpack.Marshal(arr)
    mut vA := try msgpack.Unmarshal(bA)
    testing.AssertEqInt(value.ArrayLen(vA), 3)
    testing.AssertEqInt64(value.AsInt(value.ArrayGet(vA, 0)), 1 as i64)
    testing.AssertEqStr(value.AsString(value.ArrayGet(vA, 1)), "x")
    testing.AssertTrue(value.AsBool(value.ArrayGet(vA, 2)))
    compress.BufFree(bA)
    value.ValueFree(arr)
    value.ValueFree(vA)

    mut obj := value.NewValueObject()
    value.ObjectSet(obj, "name", value.ValueString("salam"))
    value.ObjectSet(obj, "n", value.ValueInt(42 as i64))
    mut outer := value.NewValueArray()
    value.ArrayPush(outer, obj)
    mut bO := msgpack.Marshal(outer)
    mut vO := try msgpack.Unmarshal(bO)
    testing.AssertEqInt(value.ArrayLen(vO), 1)
    inner := value.ArrayGet(vO, 0)
    testing.AssertEqStr(value.AsString(value.ObjectGet(inner, "name")), "salam")
    testing.AssertEqInt64(value.AsInt(value.ObjectGet(inner, "n")), 42 as i64)
    compress.BufFree(bO)
    value.ValueFree(outer)
    value.ValueFree(vO)

    mut extBuf := compress.NewByteBuf()
    compress.BufPush(extBuf, 0xd4)
    compress.BufPush(extBuf, 1)
    compress.BufPush(extBuf, 0)
    mut extVal := try msgpack.Unmarshal(extBuf)
    testing.AssertTrue(value.IsExt(extVal))
    testing.AssertEqInt(value.ExtType(extVal), 1)
    value.ValueFree(extVal)
    compress.BufFree(extBuf)
end

func main:
    try:
        checks()
    catch e:
        testing.AssertMsg(false, e.to_str())
    end
    ret testing.Summary()
end
