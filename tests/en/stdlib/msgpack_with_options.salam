package main

import compress
import encoding.encerr
import encoding.msgpack
import encoding.value

func main:
    long := "0123456789012345678901234567890123456789"
    compact := msgpack.MarshalWith(value.ValueString(long), msgpack.MsgpackOptions { use_str8 = true })
    wide := msgpack.MarshalWith(value.ValueString(long), msgpack.MsgpackOptions { use_str8 = false })
    println compress.BufLen(compact), compress.BufGet(compact, 0), compress.BufLen(wide), compress.BufGet(wide, 0)
    println compress.BufEquals(compact, msgpack.Marshal(value.ValueString(long)))

    mut err := encerr.NoError()
    back := msgpack.Unmarshal(wide, err)
    println encerr.IsError(err), value.AsString(back) == long

    mut raw := compress.NewByteBuf()
    each b in [146, 1, 163, 97, 98, 99]:
        compress.BufPush(raw, b)
    end
    v := msgpack.UnmarshalBytes(raw.data, raw.len, err)
    println encerr.IsError(err), value.IsArray(v), value.ArrayLen(v), value.AsInt(value.ArrayGet(v, 0)), value.AsString(value.ArrayGet(v, 1))
    _ := msgpack.UnmarshalBytes(raw.data, 3, err)
    println encerr.IsError(err)
    _ := msgpack.UnmarshalBytes(raw.data, 0, err)
    println encerr.IsError(err)
end
