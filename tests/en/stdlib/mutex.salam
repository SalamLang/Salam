package main

import sync

const THREADS := 4
const PER_THREAD := 20000

mut counter := 0
mut mu := sync.Mutex {}

func worker():
    repeat PER_THREAD:
        sync.Lock(mu)
        counter = counter + 1
        sync.Unlock(mu)
    end
end

func unguarded():
    repeat PER_THREAD:
        counter = counter + 1
    end
end

func run_locked():
    counter = 0
    t1 := spawn(worker)
    t2 := spawn(worker)
    t3 := spawn(worker)
    t4 := spawn(worker)
    join(t1)
    join(t2)
    join(t3)
    join(t4)
end

func run_unguarded():
    counter = 0
    u1 := spawn(unguarded)
    u2 := spawn(unguarded)
    u3 := spawn(unguarded)
    u4 := spawn(unguarded)
    join(u1)
    join(u2)
    join(u3)
    join(u4)
end

func main:
    mu = sync.NewMutex()
    want := THREADS * PER_THREAD

    println "lock returns  :", sync.Lock(mu)
    println "unlock returns:", sync.Unlock(mu)

    counter = 0
    unguarded()
    println "one thread    :", counter, "of", PER_THREAD

    run_locked()
    println "with lock     :", counter, "of", want

    run_unguarded()
    println "without lock  : at most", want, "->", counter <= want
    println "without lock  : made progress ->", counter > 0

    sync.Destroy(mu)
    println "destroyed"
    ret 0
end
