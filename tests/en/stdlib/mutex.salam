import sync

mut counter := 0
mut mu := sync.Mutex { }

func worker():
    repeat 20000:
        sync.Lock(mu)
        counter = counter + 1
        sync.Unlock(mu)
    end
end

func unguarded():
    repeat 20000:
        counter = counter + 1
    end
end

func main:
    mu = sync.NewMutex()
    t1 := spawn(worker)
    t2 := spawn(worker)
    t3 := spawn(worker)
    t4 := spawn(worker)
    join(t1)
    join(t2)
    join(t3)
    join(t4)
    println "with lock   :", counter, "(want 80000)"
    counter = 0
    u1 := spawn(unguarded)
    u2 := spawn(unguarded)
    u3 := spawn(unguarded)
    u4 := spawn(unguarded)
    join(u1)
    join(u2)
    join(u3)
    join(u4)
    println "without lock:", counter, "(want 80000, expect less)"
    ret 0
end
