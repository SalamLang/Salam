package main


import sync

const WORKERS := 4
const PER_WORKER := 250

mut items := Vector {} as Vector<int>
mut lock := sync.Mutex {}
mut wg := sync.WaitGroup {}
mut next_marker := 0

func take_marker(): int:
    sync.Lock(lock)
    mine := next_marker
    next_marker = next_marker + 1
    sync.Unlock(lock)
    ret mine
end

func worker():
    marker := take_marker()
    repeat PER_WORKER with i:
        sync.Lock(lock)
        items.push(marker * 1000 + i)
        sync.Unlock(lock)
    end
    sync.Done(wg)
end

func main:
    lock = sync.NewMutex()
    wg = sync.NewWaitGroup()
    defer items.free()

    sync.Add(wg, WORKERS as i64)
    t1 := spawn(worker)
    t2 := spawn(worker)
    t3 := spawn(worker)
    t4 := spawn(worker)
    sync.Wait(wg)
    join(t1)
    join(t2)
    join(t3)
    join(t4)

    println "markers taken :", next_marker
    println "length        :", items.len(), "of", WORKERS * PER_WORKER

    mut per_marker_ok := true
    mut strays := 0
    repeat WORKERS with m:
        mut seen := 0
        repeat items.len() with i:
            v := items.get(i)
            if v / 1000 == m: seen = seen + 1 end
        end
        if seen != PER_WORKER: per_marker_ok = false end
    end
    repeat items.len() with i:
        v := items.get(i)
        if v / 1000 >= WORKERS || v % 1000 >= PER_WORKER: strays = strays + 1 end
    end
    println "per worker ok :", per_marker_ok
    println "stray values  :", strays

    mut sum := 0
    repeat items.len() with i:
        sum = sum + items.get(i)
    end
    println "sum           :", sum

    sync.DestroyWaitGroup(wg)
    sync.Destroy(lock)
    ret 0
end
