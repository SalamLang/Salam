package main

import net.nats
import net.tcp
import encoding
import str
import conv

mut SRV := tcp.Server {}
mut kv_keys := Vector {} as Vector<str>
mut kv_vals := Vector {} as Vector<str>
mut kv_dels := Vector {} as Vector<bool>
mut created := ""
mut flow_replies := 0
mut acks := 0

struct Sess:
    pub c: tcp.Conn = tcp.Conn {}
    pub buf: str = ""
    pub alive: bool = true
    pub sids: Vector<int> = Vector {} as Vector<int>
    pub subjects: Vector<str> = Vector {} as Vector<str>
end

func fill(s &: Sess):
    chunk := tcp.Read(s.c, 65536)
    if chunk.len() == 0:
        s.alive = false
    else:
        s.buf += chunk
    end
end

func line(s &: Sess): str:
    until s.alive:
        at := s.buf.find("\r\n")
        if at >= 0:
            l := s.buf.substr(0, at)
            s.buf = s.buf.substr(at + 2, s.buf.len() - at - 2)
            ret l
        end
        fill(s)
    end
    ret ""
end

func bytes(s &: Sess, n: int): str:
    until s.alive:
        if s.buf.len() >= n + 2:
            d := s.buf.substr(0, n)
            s.buf = s.buf.substr(n + 2, s.buf.len() - n - 2)
            ret d
        end
        fill(s)
    end
    ret ""
end

func say(s &: Sess, text: str):
    _ := tcp.Write(s.c, text)
end

func sid_of(s &: Sess, subject: str): int:
    repeat s.sids.len() in i:
        if s.sids.get(i) > 0 and nats.SubjectMatches(s.subjects.get(i), subject):
            ret s.sids.get(i)
        end
    end
    ret 0
end

func answer(s &: Sess, reply: str, data: str):
    sid := sid_of(s, reply)
    if sid > 0:
        say(s, "MSG " + reply + " " + conv.FormatInt(sid as i64) + " " + conv.FormatInt(data.len() as i64) + "\r\n" + data + "\r\n")
    end
end

func last_index(key: str): int:
    mut found := 0 - 1
    repeat kv_keys.len() in i:
        if kv_keys.get(i) == key:
            found = i
        end
    end
    ret found
end

func push_to(s &: Sess, subject: str, reply: str, data: str):
    sid := sid_of(s, subject)
    say(s, "MSG orders.x " + conv.FormatInt(sid as i64) + " " + reply + " " + conv.FormatInt(data.len() as i64) + "\r\n" + data + "\r\n")
end

func publish_op(s &: Sess, subject: str, reply: str, hdr: str, data: str):
    if subject == "$JS.API.STREAM.CREATE.KV_cfg":
        created = data
        answer(s, reply, `{"config":{"name":"KV_cfg"}}`)
    else subject.starts_with("$KV.cfg."):
        kv_keys.push(subject)
        kv_vals.push(data)
        kv_dels.push(hdr.find("KV-Operation: DEL") >= 0)
        answer(s, reply, `{"stream":"KV_cfg","seq":` + conv.FormatInt(kv_keys.len() as i64) + "}")
    else subject == "$JS.API.STREAM.MSG.GET.KV_cfg":
        at := data.find("$KV.cfg.")
        key := data.substr(at, data.len() - at - 2)
        idx := last_index(key)
        if idx < 0:
            answer(s, reply, `{"error":{"code":404,"err_code":10037,"description":"no message found"}}`)
        else:
            mut body := `{"message":{"subject":"` + key + `","seq":` + conv.FormatInt((idx + 1) as i64) + `,"data":"` + encoding.Base64Encode(kv_vals.get(idx)) + `"`
            if kv_dels.get(idx):
                body += `,"hdrs":"` + encoding.Base64Encode("NATS/1.0\r\nKV-Operation: DEL\r\n\r\n") + `"`
            end
            answer(s, reply, body + "}}")
        end
    else subject == "$JS.API.CONSUMER.DURABLE.CREATE.ORDERS.push":
        created = data
        answer(s, reply, `{"name":"push"}`)
        hb := "NATS/1.0 100 FlowControl Request\r\n\r\n"
        sid := sid_of(s, "deliver.push")
        say(s, "HMSG deliver.push " + conv.FormatInt(sid as i64) + " $JS.FC.1 " + conv.FormatInt(hb.len() as i64) + " " + conv.FormatInt(hb.len() as i64) + "\r\n" + hb + "\r\n")
        push_to(s, "deliver.push", "$JS.ACK.ORDERS.push.1.1.1.0.0", "first")
        push_to(s, "deliver.push", "$JS.ACK.ORDERS.push.1.2.2.0.0", "second")
    else subject.starts_with("$JS.FC."):
        flow_replies++
    else subject.starts_with("$JS.ACK."):
        acks++
    else subject == "$test.acks":
        answer(s, reply, conv.FormatInt(acks as i64) + "/" + conv.FormatInt(flow_replies as i64))
    end
end

func serve():
    mut s := Sess {}
    s.c = tcp.Accept(SRV)
    say(s, `INFO {"server_id":"FAKE","version":"2.10.0","host":"127.0.0.1","port":4222,"headers":true,"max_payload":1048576,"proto":1,"jetstream":true}` + "\r\n")
    until s.alive:
        l := line(s)
        if l == "PING":
            say(s, "PONG\r\n")
        else l.starts_with("SUB "):
            a := str.Fields(l)
            s.subjects.push(a.get(1))
            s.sids.push(a.get(a.len() - 1).to_int())
        else l.starts_with("UNSUB "):
            a := str.Fields(l)
            repeat s.sids.len() in i:
                if s.sids.get(i) == a.get(1).to_int() and a.len() == 2:
                    s.sids.set(i, 0)
                end
            end
        else l.starts_with("PUB "):
            a := str.Fields(l)
            n := a.get(a.len() - 1).to_int()
            data := bytes(s, n)
            publish_op(s, a.get(1), a.len() == 4 ? a.get(2) : "", "", data)
        else l.starts_with("HPUB "):
            a := str.Fields(l)
            total := a.get(a.len() - 1).to_int()
            hl := a.get(a.len() - 2).to_int()
            blob := bytes(s, total)
            publish_op(s, a.get(1), a.len() == 5 ? a.get(2) : "", blob.substr(0, hl), blob.substr(hl, total - hl))
        end
    end
    tcp.Close(s.c)
end

func main:
    SRV = tcp.Bind(0)
    port := tcp.Port(SRV)
    t := spawn(serve)
    mut nc := nats.Connect("nats://127.0.0.1:" + conv.FormatInt(port as i64))

    println "-- key value"
    made := nats.KVCreate(nc, "cfg", 5, 1000)
    println "create:", made.ok, created.find(`"name": "KV_cfg"`) >= 0, created.find(`"$KV.cfg.>"`) >= 0, created.find(`"max_msgs_per_subject":5`) >= 0
    p1 := nats.KVPut(nc, "cfg", "color", "blue", 1000)
    println "put:", p1.ok, p1.seq, p1.stream
    p2 := nats.KVPut(nc, "cfg", "color", "green", 1000)
    println "put again:", p2.seq
    g := nats.KVGet(nc, "cfg", "color", 1000)
    println "get:", g.ok, g.found, g.value, g.revision
    miss := nats.KVGet(nc, "cfg", "nothing", 1000)
    println "missing:", miss.ok, miss.found, miss.err
    gone := nats.KVDelete(nc, "cfg", "color", 1000)
    println "delete:", gone.ok, gone.seq
    after := nats.KVGet(nc, "cfg", "color", 1000)
    println "after delete:", after.ok, after.found, after.deleted, after.err
    bad := nats.KVPut(nc, "cfg", "a b", "x", 1000)
    println "bad key:", bad.ok, bad.err

    println "-- push consumer"
    sub := nats.Subscribe(nc, "deliver.push")
    pc := nats.AddPushConsumer(nc, "ORDERS", "push", "orders.>", "deliver.push", "", 1000)
    println "consumer:", pc.ok, created.find(`"deliver_subject": "deliver.push"`) >= 0, created.find(`"flow_control":true`) >= 0
    mut m := nats.NextPush(nc, sub, 1000)
    println m.ok, m.data, nats.MsgSequence(m)
    nats.Ack(nc, m)
    m = nats.NextPush(nc, sub, 1000)
    println m.ok, m.data, nats.MsgSequence(m)
    nats.Ack(nc, m)
    none := nats.NextPush(nc, sub, 100)
    println none.ok, none.err
    tally := nats.Request(nc, "$test.acks", "", 1000)
    println "acks/flow replies:", tally.data
    nats.Close(nc)
    join(t)
    tcp.CloseServer(SRV)
end
