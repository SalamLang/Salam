package main

import net.nats
import net.tcp
import str
import conv

mut SRV := tcp.Server {}
mut trace := ""
mut stored := Vector {} as Vector<str>
mut acked := 0

struct Sess:
    pub c: tcp.Conn = tcp.Conn {}
    pub buf: str = ""
    pub alive: bool = true
    pub sids: Vector<int> = Vector {} as Vector<int>
    pub subjects: Vector<str> = Vector {} as Vector<str>
    pub queues: Vector<str> = Vector {} as Vector<str>
    pub maxes: Vector<int> = Vector {} as Vector<int>
    pub counts: Vector<int> = Vector {} as Vector<int>
    pub connect: str = ""
    pub no_resp: bool = false
end

func fill(s &: Sess):
    chunk := tcp.Read(s.c, 65536)
    if chunk.len() == 0:
        s.alive = false
    else:
        s.buf += chunk
    end
end

func line(s &: Sess): str:
    until s.alive:
        at := s.buf.find("\r\n")
        if at >= 0:
            l := s.buf.substr(0, at)
            s.buf = s.buf.substr(at + 2, s.buf.len() - at - 2)
            ret l
        end
        fill(s)
    end
    ret ""
end

func bytes(s &: Sess, n: int): str:
    until s.alive:
        if s.buf.len() >= n + 2:
            d := s.buf.substr(0, n)
            s.buf = s.buf.substr(n + 2, s.buf.len() - n - 2)
            ret d
        end
        fill(s)
    end
    ret ""
end

func say(s &: Sess, text: str):
    _ := tcp.Write(s.c, text)
end

func sid_of(s &: Sess, subject: str): int:
    repeat s.sids.len() in i:
        if s.sids.get(i) > 0 and nats.SubjectMatches(s.subjects.get(i), subject):
            ret s.sids.get(i)
        end
    end
    ret 0
end

func deliver(s &: Sess, subject: str, reply: str, hdr: str, data: str): int:
    mut n := 0
    mut groups := Vector {} as Vector<str>
    defer groups.free()
    repeat s.sids.len() in i:
        sid := s.sids.get(i)
        if sid > 0 and nats.SubjectMatches(s.subjects.get(i), subject):
            q := s.queues.get(i)
            mut skip := false
            if q != "":
                repeat groups.len() in j:
                    if groups.get(j) == q:
                        skip = true
                    end
                end
                groups.push(q)
            end
            if not skip:
                head := subject + " " + conv.FormatInt(sid as i64) + (reply != "" ? " " + reply : "")
                if hdr == "":
                    say(s, "MSG " + head + " " + conv.FormatInt(data.len() as i64) + "\r\n" + data + "\r\n")
                else:
                    say(s, "HMSG " + head + " " + conv.FormatInt(hdr.len() as i64) + " " + conv.FormatInt((hdr.len() + data.len()) as i64) + "\r\n" + hdr + data + "\r\n")
                end
                n += 1
                s.counts.set(i, s.counts.get(i) + 1)
                if s.maxes.get(i) > 0 and s.counts.get(i) >= s.maxes.get(i):
                    s.sids.set(i, 0)
                end
            end
        end
    end
    ret n
end

func answer(s &: Sess, reply: str, data: str):
    sid := sid_of(s, reply)
    if sid > 0:
        say(s, "MSG " + reply + " " + conv.FormatInt(sid as i64) + " " + conv.FormatInt(data.len() as i64) + "\r\n" + data + "\r\n")
    end
end

func js_reply(s &: Sess, subject: str, reply: str, data: str):
    if subject == "$JS.API.STREAM.CREATE.ORDERS":
        answer(s, reply, `{"type":"io.nats.jetstream.api.v1.stream_create_response","config":{"name":"ORDERS"}}`)
    else subject == "$JS.API.STREAM.INFO.ORDERS":
        st := `{"messages":` + conv.FormatInt(stored.len() as i64) + `,"bytes":10,"first_seq":1,"last_seq":` + conv.FormatInt(stored.len() as i64) + `,"consumer_count":1}`
        answer(s, reply, `{"config":{"name":"ORDERS"},"state":` + st + "}")
    else subject == "$JS.API.CONSUMER.DURABLE.CREATE.ORDERS.worker":
        answer(s, reply, `{"name":"worker"}`)
    else subject.starts_with("$JS.API.CONSUMER.MSG.NEXT.ORDERS.worker"):
        want := json_batch(data)
        mut sent := 0
        repeat stored.len() in i:
            if sent < want and stored.get(i) != "":
                seq := conv.FormatInt((i + 1) as i64)
                sid := sid_of(s, reply)
                body := stored.get(i)
                rp := "$JS.ACK.ORDERS.worker.1." + seq + "." + seq + ".0.0"
                say(s, "MSG orders.new " + conv.FormatInt(sid as i64) + " " + rp + " " + conv.FormatInt(body.len() as i64) + "\r\n" + body + "\r\n")
                sent += 1
            end
        end
        if sent == 0:
            hdr := "NATS/1.0 404 No Messages\r\n\r\n"
            say(s, "HMSG " + reply + " " + conv.FormatInt(sid_of(s, reply) as i64) + " " + conv.FormatInt(hdr.len() as i64) + " " + conv.FormatInt(hdr.len() as i64) + "\r\n" + hdr + "\r\n")
        end
    else:
        answer(s, reply, `{"error":{"code":503,"err_code":10039,"description":"jetstream not enabled"}}`)
    end
end

func json_batch(data: str): int:
    at := data.find(`"batch":`)
    if at < 0:
        ret 1
    end
    rest := data.substr(at + 8, data.len() - at - 8)
    mut end_at := rest.find(",")
    if end_at < 0:
        end_at = rest.find("}")
    end
    ret rest.substr(0, end_at).to_int()
end

func publish_op(s &: Sess, subject: str, reply: str, hdr: str, data: str):
    if subject == "$test.connect" and reply != "":
        answer(s, reply, s.connect)
        ret
    end
    if subject.starts_with("$JS.API.") and reply != "":
        js_reply(s, subject, reply, data)
        ret
    end
    if subject.starts_with("$JS.ACK."):
        acked += 1
        ret
    end
    if subject == "$test.acks" and reply != "":
        answer(s, reply, conv.FormatInt(acked as i64))
        ret
    end
    if subject.starts_with("orders.") and reply != "":
        stored.push(data)
        answer(s, reply, `{"stream":"ORDERS","seq":` + conv.FormatInt(stored.len() as i64) + "}")
        ret
    end
    if subject == "svc.echo" and reply != "":
        answer(s, reply, "re:" + data)
        ret
    end
    if subject == "silent":
        ret
    end
    got := deliver(s, subject, reply, hdr, data)
    if got == 0 and reply != "" and s.no_resp:
        h := "NATS/1.0 503\r\n\r\n"
        sid := sid_of(s, reply)
        if sid > 0:
            say(s, "HMSG " + reply + " " + conv.FormatInt(sid as i64) + " " + conv.FormatInt(h.len() as i64) + " " + conv.FormatInt(h.len() as i64) + "\r\n" + h + "\r\n")
        end
    end
end

func serve():
    mut s := Sess {}
    s.c = tcp.Accept(SRV)
    say(s, `INFO {"server_id":"FAKE","server_name":"fake","version":"2.10.0","host":"127.0.0.1","port":4222,"headers":true,"max_payload":1048576,"proto":1,"jetstream":true,"client_id":7}` + "\r\n")
    until s.alive:
        l := line(s)
        if l.starts_with("CONNECT "):
            s.connect = l.substr(8, l.len() - 8)
            s.no_resp = s.connect.find(`"no_responders": true`) >= 0
        else l == "PING":
            say(s, "PONG\r\n")
        else l.starts_with("SUB "):
            a := str.Fields(l)
            if a.len() == 4:
                s.subjects.push(a.get(1))
                s.queues.push(a.get(2))
                s.maxes.push(0)
                s.counts.push(0)
                s.sids.push(a.get(3).to_int())
            else:
                s.subjects.push(a.get(1))
                s.queues.push("")
                s.maxes.push(0)
                s.counts.push(0)
                s.sids.push(a.get(2).to_int())
            end
        else l.starts_with("UNSUB "):
            a := str.Fields(l)
            repeat s.sids.len() in i:
                if s.sids.get(i) == a.get(1).to_int():
                    if a.len() > 2:
                        s.maxes.set(i, a.get(2).to_int())
                    else:
                        s.sids.set(i, 0)
                    end
                end
            end
        else l.starts_with("PUB "):
            a := str.Fields(l)
            n := a.get(a.len() - 1).to_int()
            data := bytes(s, n)
            publish_op(s, a.get(1), a.len() == 4 ? a.get(2) : "", "", data)
        else l.starts_with("HPUB "):
            a := str.Fields(l)
            total := a.get(a.len() - 1).to_int()
            hl := a.get(a.len() - 2).to_int()
            blob := bytes(s, total)
            publish_op(s, a.get(1), a.len() == 5 ? a.get(2) : "", blob.substr(0, hl), blob.substr(hl, total - hl))
        end
    end
    tcp.Close(s.c)
end

func note(m: nats.Msg):
    trace += m.subject + "=" + m.data + ";"
end

func shout(m: nats.Msg): str:
    ret str.Upper(m.data)
end

func main:
    SRV = tcp.Bind(0)
    port := tcp.Port(SRV)
    t := spawn(serve)

    println "-- subjects and headers"
    println nats.ValidSubject("a.b.c"), nats.ValidSubject("a..b"), nats.ValidSubject("a b"), nats.ValidSubject(".a"), nats.ValidSubject("")
    println nats.SubjectMatches("a.*.c", "a.b.c"), nats.SubjectMatches("a.*", "a.b.c"), nats.SubjectMatches("a.>", "a.b.c"), nats.SubjectMatches("a.>", "a"), nats.SubjectMatches("a.b", "a.b")
    mut h := nats.NewHeader()
    nats.HeaderAdd(h, "Trace-Id", "abc")
    nats.HeaderAdd(h, "Tag", "one")
    nats.HeaderAdd(h, "Tag", "two")
    println nats.HeaderGet(h, "trace-id"), nats.HeaderValues(h, "TAG").len(), nats.HeaderHas(h, "nope")
    nats.HeaderSet(h, "Tag", "only")
    println nats.HeaderCount(h)
    enc := nats.HeaderEncode(h)
    println str.Replace(enc, "\r\n", "|")
    mut code := 0
    mut text := ""
    back := nats.HeaderParse("NATS/1.0 503 No Responders\r\nA: 1\r\nB: two words\r\n\r\n", code, text)
    println code, text, nats.HeaderGet(back, "b"), nats.HeaderCount(back)

    println "-- connect"
    mut opts := nats.DefaultOptions()
    opts.name = "tester"
    opts.user = "alice"
    opts.password = "pw"
    mut nc := nats.ConnectWith("nats://127.0.0.1:" + conv.FormatInt(port as i64), opts)
    println "connected:", nats.IsConnected(nc), "closed:", nats.IsClosed(nc)
    println "server:", nc.info.server_id, nc.info.version, nc.info.headers, nc.info.max_payload, nc.info.jetstream
    sent := nats.Request(nc, "$test.connect", "", 1000)
    println "connect has name:", sent.data.find(`"name": "tester"`) >= 0, "user:", sent.data.find(`"user": "alice"`) >= 0, "lang:", sent.data.find(`"lang": "salam"`) >= 0, "headers:", sent.data.find(`"headers": true`) >= 0

    println "-- pub/sub"
    sub := nats.Subscribe(nc, "greet.*")
    nats.Publish(nc, "greet.bob", "hello bob")
    nats.Publish(nc, "other", "ignored")
    mut m := nats.NextMsg(nc, sub, 1000)
    println m.ok, m.subject, m.data, m.reply == ""
    none := nats.NextMsg(nc, sub, 100)
    println none.ok, none.err
    mut hh := nats.NewHeader()
    nats.HeaderAdd(hh, "K", "v1")
    nats.HeaderAdd(hh, "K", "v2")
    nats.PublishHeaders(nc, "greet.hdr", hh, "with headers")
    m = nats.NextMsg(nc, sub, 1000)
    println m.ok, m.data, nats.HeaderValues(m.header, "k").len(), nats.HeaderGet(m.header, "K")
    nats.Publish(nc, "greet.multi", "line1\r\nline2\nline3")
    m = nats.NextMsg(nc, sub, 1000)
    println str.Replace(str.Replace(m.data, "\r\n", "|"), "\n", "/")
    mut big := ""
    repeat 2000:
        big += "0123456789abcdefghij0123456789abcdefghij"
    end
    nats.Publish(nc, "greet.big", big)
    m = nats.NextMsg(nc, sub, 2000)
    println "big:", m.ok, m.data.len(), m.data == big
    println "pending:", nats.Pending(nc, sub), "subs:", nats.SubscriptionCount(nc)

    println "-- queue, handler, replier"
    q1 := nats.QueueSubscribe(nc, "work", "pool")
    q2 := nats.QueueSubscribe(nc, "work", "pool")
    nats.Publish(nc, "work", "job1")
    nats.Publish(nc, "work", "job2")
    nats.Flush(nc, 1000)
    println "queue split:", nats.Pending(nc, q1) + nats.Pending(nc, q2), nats.Pending(nc, q2)
    nats.SubscribeHandler(nc, "events.>", "", (m: nats.Msg): note(m) end)
    nats.Publish(nc, "events.a.b", "x")
    nats.Publish(nc, "events.c", "y")
    nats.Flush(nc, 1000)
    println "handler trace:", trace
    nats.SubscribeReplier(nc, "svc.up", "", (m: nats.Msg): ret shout(m) end)
    mut r := nats.Request(nc, "svc.up", "quiet", 1000)
    println "replier:", r.ok, r.data
    nats.Flush(nc, 1000)

    println "-- request/reply"
    r = nats.Request(nc, "svc.echo", "ping", 1000)
    println r.ok, r.data
    r = nats.Request(nc, "nobody.home", "x", 1000)
    println r.ok, r.err
    r = nats.Request(nc, "silent", "x", 150)
    println r.ok, r.err
    inbox := nats.NewInbox(nc)
    println "inbox prefix:", inbox.starts_with("_INBOX."), inbox.len()
    rs := nats.Subscribe(nc, "ask")
    ri := nats.Subscribe(nc, "answers")
    nats.PublishRequest(nc, "ask", "answers", "question")
    ask := nats.NextMsg(nc, rs, 1000)
    println "ask:", ask.data, ask.reply
    nats.Respond(nc, ask, "42")
    reply_msg := nats.NextMsg(nc, ri, 1000)
    println "answer:", reply_msg.data

    println "-- unsubscribe"
    au := nats.Subscribe(nc, "auto")
    nats.AutoUnsubscribe(nc, au, 2)
    nats.Publish(nc, "auto", "1")
    nats.Publish(nc, "auto", "2")
    nats.Publish(nc, "auto", "3")
    nats.Flush(nc, 1000)
    println "auto:", nats.Delivered(nc, au), nats.Pending(nc, au), nats.IsValidSubscription(nc, au)
    nats.Unsubscribe(nc, sub)
    println "after unsub:", nats.IsValidSubscription(nc, sub)
    println "bad subject:", nats.Publish(nc, "a b", "x"), nc.err

    println "-- jetstream"
    subjects := Vector {} as Vector<str>
    subjects.push("orders.*")
    cr := nats.AddStream(nc, "ORDERS", subjects, 1000)
    println "stream:", cr.ok
    a1 := nats.JSPublish(nc, "orders.new", "order-1", 1000)
    a2 := nats.JSPublish(nc, "orders.new", "order-2", 1000)
    println "acks:", a1.ok, a1.stream, a1.seq, a2.seq, a2.duplicate
    info := nats.StreamInfo(nc, "ORDERS", 1000)
    println "info:", info.ok, info.messages, info.last_seq, info.consumers
    cc := nats.AddConsumer(nc, "ORDERS", "worker", "orders.*", 1000)
    println "consumer:", cc.ok
    batch := nats.Fetch(nc, "ORDERS", "worker", 5, 500)
    println "fetched:", batch.msgs.len(), batch.err == ""
    each fm in batch.msgs:
        println fm.data, nats.MsgSequence(fm)
        nats.Ack(nc, fm)
    end
    ak := nats.Request(nc, "$test.acks", "", 1000)
    println "acked:", ak.data
    missing := nats.JSRequest(nc, "STREAM.INFO.NOPE", "", 1000)
    println "error:", missing.ok, missing.code, missing.err

    println "-- limits"
    mut huge := ""
    repeat 20000:
        huge += "0123456789abcdefghij0123456789abcdefghij0123456789abcdefghij"
    end
    println "too big:", nats.Publish(nc, "big", huge), nc.err, nats.MaxPayload(nc)

    println "-- drain"
    nats.SubscribeHandler(nc, "last.*", "", (m: nats.Msg): note(m) end)
    nats.Publish(nc, "last.one", "bye")
    println "drained:", nats.Drain(nc, 1000)
    println "closed:", nats.IsClosed(nc), nats.IsConnected(nc)
    println "after drain:", trace.find("last.one=bye") >= 0
    println "publish when closed:", nats.Publish(nc, "x", "y"), nc.err
    nats.Close(nc)

    println "-- connect failure"
    dead := nats.Connect("nats://127.0.0.1:1")
    println dead.ok, nats.IsClosed(dead), nats.LastError(dead).starts_with("could not connect")
    bad := nats.Connect("ftp://host")
    println bad.ok, nats.LastError(bad)

    join(t)
    tcp.CloseServer(SRV)
end
