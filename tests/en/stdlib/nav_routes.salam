package main

import testing
import nav

func test_match():
    testing.AssertTrue(nav.Match("/", "/"))
    testing.AssertTrue(nav.Match("/", ""))
    testing.AssertFalse(nav.Match("/", "/a"))
    testing.AssertTrue(nav.Match("/users/:id", "/users/42"))
    testing.AssertTrue(nav.Match("/users/:id", "/users/42/"))
    testing.AssertFalse(nav.Match("/users/:id", "/users"))
    testing.AssertFalse(nav.Match("/users/:id", "/users/42/edit"))
    testing.AssertTrue(nav.Match("/users/:id?", "/users"))
    testing.AssertTrue(nav.Match("/docs/*", "/docs"))
    testing.AssertTrue(nav.Match("/docs/*", "/docs/a/b"))
    testing.AssertTrue(nav.Match("*", "/anything/at/all"))
    testing.AssertTrue(nav.Match("/درباره", "/درباره"))
    testing.AssertFalse(nav.Match("/about", "/About"))
end

func test_params():
    testing.AssertEqStr(nav.Param("/users/:id", "/users/42", "id"), "42")
    testing.AssertEqStr(nav.Param("/users/:id/posts/:post", "/users/7/posts/hello", "post"), "hello")
    testing.AssertEqStr(nav.Param("/users/:id?", "/users", "id"), "")
    testing.AssertEqStr(nav.Param("/files/*path", "/files/a/b.txt", "path"), "a/b.txt")
    testing.AssertEqStr(nav.Param("/files/*", "/files/x/y", "*"), "x/y")
    testing.AssertEqStr(nav.Param("/q/:term", "/q/a%2Fb%25c", "term"), "a/b%c")
    testing.AssertEqStr(nav.Param("/user/:name", "/user/علی", "name"), "علی")
    testing.AssertEqStr(nav.Param("/users/:id", "/other/1", "id"), "")
end

func test_query():
    testing.AssertEqStr(nav.Query("a=1&b=two", "b"), "two")
    testing.AssertEqStr(nav.Query("q=hello+world", "q"), "hello world")
    testing.AssertEqStr(nav.Query("x=1%262&y", "x"), "1&2")
    testing.AssertEqStr(nav.Query("flag&x=1", "flag"), "")
    testing.AssertEqStr(nav.Query("", "x"), "")
end

func test_paths():
    testing.AssertEqStr(nav.Normalize(""), "/")
    testing.AssertEqStr(nav.Normalize("a//b/./c/../d/"), "/a/b/d")
    testing.AssertEqStr(nav.Normalize("/../.."), "/")
    mut p := ""
    mut q := ""
    nav.SplitUrl("/s/x?k=v#top", p, q)
    testing.AssertEqStr(p, "/s/x")
    testing.AssertEqStr(q, "k=v")
    testing.AssertEqStr(nav.Resolve("/users/3", "edit"), "/users/3/edit")
    testing.AssertEqStr(nav.Resolve("/users/3", ".."), "/users")
    testing.AssertEqStr(nav.Resolve("/users/3?x=1", "/about?y=2"), "/about?y=2")
    testing.AssertEqStr(nav.Resolve("/users/3?x=1", "?page=2"), "/users/3?page=2")
    testing.AssertEqStr(nav.Href(true, "/app", "/users"), "#/users")
    testing.AssertEqStr(nav.Href(false, "/app/", "/users"), "/app/users")
    testing.AssertEqStr(nav.StripBase("/app", "/app/users/1"), "/users/1")
    testing.AssertEqStr(nav.StripBase("/app/", "/app"), "/")
    testing.AssertEqStr(nav.StripBase("", "/x/"), "/x")
    testing.AssertTrue(nav.IsInt("42"))
    testing.AssertTrue(nav.IsInt("-7"))
    testing.AssertFalse(nav.IsInt("4a"))
    testing.AssertFalse(nav.IsInt("-"))
end

func test_rank():
    testing.AssertTrue(nav.Rank("/users/new") > nav.Rank("/users/:id"))
    testing.AssertTrue(nav.Rank("/users/:id") > nav.Rank("/users/:id?"))
    testing.AssertTrue(nav.Rank("/docs/:x") > nav.Rank("/docs/*"))
    testing.AssertTrue(nav.Rank("/") > nav.Rank("*"))
end

func test_history():
    mut h := nav.NewHistory("/")
    testing.AssertFalse(nav.CanBack(h))
    nav.Push(h, "/a")
    nav.Push(h, "/b")
    testing.AssertEqStr(nav.Current(h), "/b")
    testing.AssertEqInt(nav.Depth(h), 3)
    testing.AssertTrue(nav.Back(h))
    testing.AssertEqStr(nav.Current(h), "/a")
    testing.AssertTrue(nav.CanForward(h))
    nav.Push(h, "/c")
    testing.AssertFalse(nav.CanForward(h))
    testing.AssertEqInt(nav.Depth(h), 3)
    nav.Replace(h, "/d")
    testing.AssertEqStr(nav.Current(h), "/d")
    testing.AssertTrue(nav.Back(h))
    testing.AssertTrue(nav.Back(h))
    testing.AssertFalse(nav.Back(h))
    testing.AssertTrue(nav.Forward(h))
    testing.AssertEqStr(nav.Current(h), "/a")
    nav.Reset(h, "/home")
    testing.AssertEqStr(nav.Current(h), "/home")
    testing.AssertEqInt(nav.Depth(h), 1)
end

func test_types():
    testing.AssertEqStr(nav.Unescape("a%2fb%3Dc%41"), "a/b=c%41")
    r := nav.Route { path = "/a", query = "x=1", pattern = "/:p" }
    testing.AssertEqStr(r.path + r.query + r.pattern, "/ax=1/:p")
    h := nav.NewHistory("/s")
    testing.AssertEqInt(h.entries.Len(), 1)
    testing.AssertEqInt(h.index, 0)
end

func main:
    test_types()
    test_match()
    test_params()
    test_query()
    test_paths()
    test_rank()
    test_history()
    testing.Summary()
    ret 0
end
