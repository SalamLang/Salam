import net.devreload
import str

func main:
    println devreload.Enabled()
    devreload.Init("e1", "")
    println devreload.Enabled()
    page := devreload.Inject("<html><head><title>t</title></head><body><p>x</p></body></html>")
    println str.Contains(page, "/__salam_hmr")
    println str.StartsWith(page, "<html><head><script data-salam-hmr>")
    println str.Contains(page, "</script></body></html>")
    println str.Contains(page, "<p>x</p><script data-salam-hmr>")
    bare := devreload.Inject("<p>no body</p>")
    println str.EndsWith(bare, "</script>")
    println str.Contains(devreload.Script(), "EventSource")
end
