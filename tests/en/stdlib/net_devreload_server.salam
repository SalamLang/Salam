import net.devreload
import net.http
import net.router
import str

func hmr(ctx: i64):
    devreload.Handler(ctx)
end

func main:
    println devreload.InitFromEnv()
    devreload.InitLocal("e9", "")
    mut r := router.NewRouter()
    router.Get(r, "/__salam_hmr", hmr)
    mut s := http.NewServer(0)
    http.Use(s, r)
    port := http.RunBackgroundPort(s)
    base := "http://127.0.0.1:" + str.FromInt(port as i64) + "/__salam_hmr"
    first := http.Get(base)
    println first.status
    println str.Contains(first.head, "text/event-stream")
    println str.Contains(first.body, "\"kind\":\"hello\"")
    devreload.Bump(1)
    other := http.RequestRaw("GET", base, "Last-Event-ID: other:0:0\r\n", "")
    println str.Contains(other.body, "\"kind\":\"reload\"")
    changed := http.RequestRaw("GET", base, "Last-Event-ID: e9:0:0\r\n", "")
    println str.Contains(changed.body, "\"kind\":\"css\"")
end
