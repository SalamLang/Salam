package main

import net.http.session
import testing

func check values():
    mut s := session.New()
    testing.AssertFalse(session.HasValue(s, "user"))
    session.SetValue(s, "user", "ali")
    session.SetValue(s, "role", "admin")
    testing.AssertTrue(session.HasValue(s, "user"))
    testing.AssertEqStr(session.Value(s, "user"), "ali")

    testing.AssertTrue(session.DeleteValue(s, "user"))
    testing.AssertFalse(session.DeleteValue(s, "user"))
    testing.AssertFalse(session.HasValue(s, "user"))
    testing.AssertTrue(session.HasValue(s, "role"))

    session.ClearValues(s)
    testing.AssertFalse(session.HasValue(s, "role"))
    testing.AssertEqStr(session.Value(s, "role"), "")
    session.Destroy(s.id)
end

func check cleanup():
    session.Configure("sid", 60, false, "Lax")
    fresh := session.New()
    mut stale := session.New()
    stale.last_seen = 1
    session.Save(stale)
    testing.AssertEqInt(session.CleanupExpired(), 1)
    testing.AssertEqInt(session.CleanupExpired(), 0)

    mut ok := false
    session.Get(fresh.id, ok)
    testing.AssertTrue(ok)
    mut gone := false
    session.Get(stale.id, gone)
    testing.AssertFalse(gone)
    session.Destroy(fresh.id)
end

func main:
    check values()
    check cleanup()
    ret testing.Summary()
end
