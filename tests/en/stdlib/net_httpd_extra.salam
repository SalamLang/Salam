package main

import net.httpd
import io
import os
import testing

func main:
    path := os.TempDir() + "/salam_httpd_extra.salam"
    io.WriteFile(path, "server:\n    site:\n        listen = 8081\n        names = \"alpha.test www.alpha.test\"\n    end\n    site:\n        listen = 8081\n        names = \"beta.test\"\n    end\nend\n")
    testing.AssertTrue(httpd.LoadFile(path))
    testing.AssertEqInt(httpd.ProblemCount(), 0)
    testing.AssertEqInt(httpd.SiteCount(), 2)
    testing.AssertEqStr(httpd.SiteNames(0), "alpha.test www.alpha.test")
    testing.AssertEqStr(httpd.SiteNames(1), "beta.test")
    testing.AssertEqInt(httpd.SiteFor("beta.test", 8081), 1)
    os.Remove(path)

    testing.AssertFalse(httpd.LoadFile(path))
    testing.AssertEqInt(httpd.ProblemCount(), 1)
    testing.AssertContains(httpd.ProblemAt(0), "cannot read the config file")
    testing.AssertEqInt(httpd.SiteCount(), 0)

    io.WriteFile(path, "server:\n    sit:\n    end\nend\n")
    testing.AssertFalse(httpd.LoadFile(path))
    testing.AssertTrue(httpd.ProblemCount() > 0)
    os.Remove(path)
    ret testing.Summary()
end
