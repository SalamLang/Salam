import net.http
import net.router
import net.tcp
import sync
import tls

mut port := 0

func hello(h: i64):
    http.Text(http.Ctx(h), "hello")
end

func serve():
    mut r := router.NewRouter()
    router.Get(r, "/", hello)
    mut s := http.NewServer(port)
    http.Use(s, r)
    http.RunTLS(s, "tests/fixtures/ssl/server.crt", "tests/fixtures/ssl/server.key")
end

func client(): tls.Conn:
    mut cfg := tls.NewConfig("localhost")
    cfg.insecure_skip_verify = true
    ret tls.Dial("127.0.0.1", port, cfg)
end

func main:
    port = tcp.FreePort()
    _ := spawn(serve)
    println tcp.WaitListening("127.0.0.1", port, 5000)
    repeat 3:
        mut quiet := client()
        println tls.ConnOk(quiet)
        tls.Close(quiet)
    end
    sync.SleepMs(100)
    mut c := client()
    println tls.ConnOk(c)
    tls.Write(c, "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
    mut got := ""
    mut part := tls.Read(c, 4096)
    until part.Len() > 0:
        got += part
        part = tls.Read(c, 4096)
    end
    tls.Close(c)
    println got.includes("HTTP/1.1 200")
    println got.includes("hello")
    ret 0
end
