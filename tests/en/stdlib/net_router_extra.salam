package main

import net.http
import net.router
import testing

func user(ctx: i64):
    http.Text(ctx, "user " + http.Param(ctx, "id"))
end

func nothing here(ctx: i64):
    http.SetStatus(ctx, 404)
    http.Text(ctx, "nothing at " + http.Path(ctx))
end

func check dispatch params():
    mut r := router.NewRouter()
    router.Get(r, "/users/:id/:tab", user)
    mut m := router.Dispatch(r, "GET", "/users/7/posts")
    testing.AssertTrue(m.matched)
    testing.AssertEqStr(router.ParamGet(m, "id"), "7")
    testing.AssertEqStr(router.ParamGet(m, "tab"), "posts")
    router.FreeMatch(m)
    testing.AssertTrue(m.matched)
    mut miss := router.Dispatch(r, "GET", "/nowhere")
    testing.AssertFalse(miss.matched)
    router.FreeMatch(miss)
end

func check unmatched route():
    mut r := router.NewRouter()
    router.Get(r, "/users/:id", user)
    router.SetFallback(r, nothing here)
    mut s := http.NewServer(23831)
    http.Use(s, r)
    testing.AssertTrue(http.RunBackground(s))

    hit := http.Get("http://127.0.0.1:23831/users/5")
    testing.AssertEqInt(http.Status(hit), 200)
    testing.AssertEqStr(http.Body(hit), "user 5")
    miss := http.Get("http://127.0.0.1:23831/elsewhere/x")
    testing.AssertEqInt(http.Status(miss), 404)
    testing.AssertEqStr(http.Body(miss), "nothing at /elsewhere/x")
end

func main:
    check dispatch params()
    check unmatched route()
    ret testing.Summary()
end
