import net.tun

func show(title: str, pl: tun.Plan):
    println "==", title
    each line in pl.up:
        println "up  ", line
    end
    each line in pl.down:
        println "down", line
    end
end

func main():
    routes := "Iface\tDestination\tGateway \tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT\n" +
        "wlan0\t00000000\t0101A8C0\t0003\t0\t0\t600\t00000000\t0\t0\t0\n" +
        "eth0\t00000000\t0100000A\t0003\t0\t0\t100\t00000000\t0\t0\t0\n" +
        "eth0\t0000000A\t00000000\t0001\t0\t0\t100\t00FFFFFF\t0\t0\t0\n"
    gw := tun.ParseLinuxRoutes(routes)
    println "linux gateway", gw.ok, gw.ip, gw.iface
    ppp := tun.ParseLinuxRoutes("Iface\tDestination\tGateway\tFlags\tRefCnt\tUse\tMetric\tMask\nppp0\t00000000\t00000000\t0001\t0\t0\t0\t00000000\n")
    println "point to point", ppp.ok, ppp.ip.Len(), ppp.iface
    println "no default", tun.ParseLinuxRoutes("Iface\tDestination\n").ok

    mac := tun.ParseMacRoute("   route to: default\ndestination: default\n       mask: default\n    gateway: 192.168.1.1\n  interface: en0\n      flags: <UP,GATEWAY,DONE,STATIC,PRCLONING>\n")
    println "mac gateway", mac.ok, mac.ip, mac.iface

    resolv := tun.ParseResolvers("# generated\nnameserver 192.168.1.1\nnameserver 192.168.1.1\nnameserver fe80::1\nsearch lan\n")
    println "resolvers", resolv.Len(), resolv[0]
    scutil := tun.ParseResolvers("resolver #1\n  nameserver[0] : 10.0.0.53\n  nameserver[1] : 1.1.1.1\n")
    println "scutil", scutil.Len(), scutil[0], scutil[1]

    println "names", tun.ValidName("salamtun"), tun.ValidName("utun9"), tun.ValidName("bad name"), tun.ValidName(""), tun.ValidName("waytoolonginterface")
    println "next", tun.NextAddress("172.19.0.1"), tun.NextAddress("10.0.0.255")

    mut hosts := Vector {} as Vector<str>
    hosts.Push("203.0.113.7")
    mut dns := Vector {} as Vector<str>
    dns.Push("192.168.1.1")
    dns.Push("8.8.8.8")
    dns.Push("10.0.0.53")
    opts := tun.Options { name = "salamtun" }
    lgw := tun.Gateway { ok = true, ip = "192.168.1.1", iface = "wlan0" }
    show("linux", tun.BuildPlan("linux", "salamtun", opts, lgw, hosts, dns, ""))
    mgw := tun.Gateway { ok = true, ip = "192.168.1.1", iface = "en0" }
    show("macos", tun.BuildPlan("macos", "utun7", opts, mgw, hosts, dns, ""))
    wgw := tun.Gateway { ok = true, ip = "192.168.1.1", iface = "Wi-Fi", index = 12 }
    show("windows", tun.BuildPlan("windows", "salamtun", opts, wgw, hosts, dns, "C:\\Program Files\\App\\app.exe"))
    bare := tun.Options { name = "t0", auto_route = false }
    show("linux no routes", tun.BuildPlan("linux", "t0", bare, lgw, hosts, dns, ""))
    show("unknown", tun.BuildPlan("plan9", "t0", opts, lgw, hosts, dns, ""))

    parts := tun.SplitCommand("netsh advfirewall firewall add rule name=x program=\"C:\\Program Files\\App\\app.exe\"")
    println "split", parts.Len(), parts[parts.Len() - 1]
end
