import mem
import net.tun
import net.tunnel

func main():
    av := tun.Available()
    println "availability explained", av.ok or av.reason.Len() > 0
    println "platform known", tun.Platform().Len() > 0
    gw := tun.DefaultGateway()
    println "gateway call", gw.ok or not gw.ok
    dns := tun.SystemResolvers()
    println "resolvers call", dns.Len() >= 0
    dns.Free()
    println "running before", tun.Running()

    s := tun.Start(tun.Options { address = "999.1.1.1", dialer = tunnel.Block() })
    println "bad start refused", s.ok, tun.LastError().Len() > 0, s.error == tun.LastError()
    st := tun.SessionStats(s)
    println "no stats", st.packets_in, st.connections
    tun.Stop(s)
    println "running after", tun.Running()

    dev := tun.OpenDevice("bad name!", 1500)
    println "bad device refused", dev.ok, dev.error.Len() > 0
    buf := mem.AllocateZeroed(64 as u64)
    println "closed device io", dev.Read(buf, 64, 10), dev.Write(buf, 20)
    dev.Close()
    mem.Free(buf)

    bd := tun.NewBypassDialer()
    println "bypass name", bd.Name(), bd.timeout_ms
    nowhere := tunnel.Addr {}
    c := bd.Dial(nowhere)
    println "invalid target", c.Ok()
    d := tun.Bypass()
    println "dyn bypass", d.Name()

    nat := tun.NewNat("172.19.0.1", "172.19.0.2", 7000, 0)
    println "nat port", nat.Port()
    pk := tun.BuildUdp4("10.0.0.2", 1, "10.0.0.1", 2, null, 0)
    p := pk.data as u8*
    p[8] = 1 as u8
    println "ttl edit breaks", tun.ChecksumsOk(pk.data, pk.len)
    tun.FinishChecksums(pk.data, pk.len)
    println "finish fixes", tun.ChecksumsOk(pk.data, pk.len)
    tun.FreePacket(pk)
    tun.FreeNat(nat)
    println "bad nat", tun.NewNat("x", "y", 1, 0).Port()
end
