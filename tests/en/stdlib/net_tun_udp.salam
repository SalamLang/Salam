import net.tun

func show(label: str, nat: tun.Nat, pk: tun.Packet):
    act := nat.Rewrite(pk.data, pk.len, 1000 as i64)
    println label, act == tun.action_udp, act == tun.action_dns, act == tun.action_drop
    tun.FreePacket(pk)
end

func main():
    payload := "ping"
    mut nat := tun.NewNat("172.19.0.1", "172.19.0.2", 5000, 600000)
    show(
        "off", nat, tun.BuildUdp4("172.19.0.1", 40000, "203.0.113.9", 3478, payload as void*, 4)
    )
    nat.udp = true
    show(
        "on", nat, tun.BuildUdp4("172.19.0.1", 40000, "203.0.113.9", 3478, payload as void*, 4)
    )
    show(
        "dns", nat, tun.BuildUdp4("172.19.0.1", 40000, "172.19.0.2", 53, payload as void*, 4)
    )
    show(
        "multicast",
        nat,
        tun.BuildUdp4("172.19.0.1", 40000, "224.0.0.251", 5353, payload as void*, 4)
    )
    opts := tun.Options {}
    println "default off", not opts.relay_udp, opts.udp_blocked.Len() == 0
end
