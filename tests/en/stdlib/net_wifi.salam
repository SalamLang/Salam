package main

import mem
import net.wifi

func sec(s: wifi.Security): str:
    ret wifi.SecurityName(s)
end

func show(label: str, s: wifi.Status):
    println label, wifi.StateName(s.state), s.interface, s.ssid, s.ssid_known, s.bssid, sec(s.security), s.signal, s.backend
end

func put32(p: void*, off: int, v: int):
    ((p as i64 + off as i64) as u32*)[0] = v as u32
end

func put8(p: void*, off: int, v: int):
    ((p as i64 + off as i64) as u8*)[0] = v as u8
end

func main:
    println "nm open", sec(wifi.SecurityFromNm(0, 0, 0))
    println "nm wep", sec(wifi.SecurityFromNm(1, 0, 0))
    println "nm wpa", sec(wifi.SecurityFromNm(1, 0x144, 0))
    println "nm wpa2", sec(wifi.SecurityFromNm(1, 0, 0x188))
    println "nm wpa3", sec(wifi.SecurityFromNm(1, 0, 0x488))
    println "nm wpa2/3 mixed", sec(wifi.SecurityFromNm(1, 0, 0x588))
    println "nm enterprise", sec(wifi.SecurityFromNm(1, 0, 0x288))
    println "nm suite-b", sec(wifi.SecurityFromNm(1, 0, 0x2000))
    println "nm owe", sec(wifi.SecurityFromNm(1, 0, 0x888))
    println "nm odd", sec(wifi.SecurityFromNm(1, 0, 0x8))

    println "win open", sec(wifi.SecurityFromWlan(1, 0, false))
    println "win wep", sec(wifi.SecurityFromWlan(1, 0x101, false))
    println "win wpa", sec(wifi.SecurityFromWlan(4, 2, false))
    println "win wpa2", sec(wifi.SecurityFromWlan(7, 4, false))
    println "win wpa3", sec(wifi.SecurityFromWlan(9, 4, false))
    println "win owe", sec(wifi.SecurityFromWlan(10, 4, false))
    println "win ent", sec(wifi.SecurityFromWlan(6, 4, false))
    println "win onex", sec(wifi.SecurityFromWlan(7, 4, true))
    println "win ihv", sec(wifi.SecurityFromWlan(200, 4, false))

    repeat 17 in code:
        print sec(wifi.SecurityFromMac(code)), ""
    end
    println ""

    println "dbm", wifi.SignalFromDbm(-30), wifi.SignalFromDbm(-52), wifi.SignalFromDbm(-100), wifi.SignalFromDbm(-120), wifi.SignalFromDbm(0)
    println "ssid", wifi.DecodeSsid("Sal\\xc3\\xa1m \\x41"), wifi.DecodeSsid("plain\\x4"), wifi.DecodeSsid("")

    dev := "phy#0\n\tInterface wlp2s0\n\t\tifindex 3\n\t\taddr 3c:22:fb:00:00:01\n\t\tssid Home\n\t\ttype managed\nphy#1\n\tInterface wlan1\n\t\ttype managed\n"
    names := wifi.ParseIwDev(dev)
    println "iw dev", names.Len(), names[0], names[1]
    names.Free()

    link := "Connected to AA:BB:CC:00:11:22 (on wlp2s0)\n\tSSID: Sal\\xc3\\xa1m Net\n\tfreq: 5180\n\tRX: 1234 bytes (10 packets)\n\tsignal: -61 dBm\n\ttx bitrate: 866.7 MBit/s\n"
    up := wifi.ParseIwLink(link, "wlp2s0")
    show("iw link", up)
    show("iw down", wifi.ParseIwLink("Not connected.\n", "wlan1"))

    scan := "BSS 11:11:11:11:11:11(on wlp2s0)\n\tcapability: ESS (0x0001)\n\tSSID: Free\nBSS aa:bb:cc:00:11:22(on wlp2s0) -- associated\n\tcapability: ESS Privacy ShortSlotTime (0x0411)\n\tSSID: Sal\\xc3\\xa1m Net\n\tRSN:\t * Version: 1\n\t\t * Group cipher: CCMP\n\t\t * Pairwise ciphers: CCMP\n\t\t * Authentication suites: PSK SAE\n\t\t * Capabilities: 16-PTKSA-RC 1-GTKSA-RC (0x000c)\nBSS 22:22:22:22:22:22(on wlp2s0)\n\tcapability: ESS Privacy (0x0011)\n\tWPA:\t * Version: 1\n\t\t * Authentication suites: PSK\n"
    println "scan assoc", sec(wifi.ParseIwScan(scan, "AA:BB:CC:00:11:22"))
    println "scan open", sec(wifi.ParseIwScan(scan, "11:11:11:11:11:11"))
    println "scan wpa", sec(wifi.ParseIwScan(scan, "22:22:22:22:22:22"))
    println "scan missing", sec(wifi.ParseIwScan(scan, "33:33:33:33:33:33"))
    wep := "BSS 44:44:44:44:44:44(on wlan0)\n\tcapability: ESS Privacy (0x0011)\n"
    println "scan wep", sec(wifi.ParseIwScan(wep, "44:44:44:44:44:44"))
    ent := "BSS 55:55:55:55:55:55(on wlan0)\n\tRSN:\t * Version: 1\n\t\t * Authentication suites: IEEE 802.1X\n"
    println "scan ent", sec(wifi.ParseIwScan(ent, "55:55:55:55:55:55"))

    buf := mem.AllocateZeroed(604 as u64)
    put32(buf, 0, 1)
    put32(buf, 520, 4)
    put8(buf, 524, 72)
    put8(buf, 525, 111)
    put8(buf, 526, 109)
    put8(buf, 527, 101)
    repeat 6 in i:
        put8(buf, 560 + i, 0xa0 + i)
    end
    put32(buf, 576, 77)
    put32(buf, 588, 1)
    put32(buf, 596, 7)
    put32(buf, 600, 4)
    show("wlan", wifi.ParseWlanConnection(buf, 604))
    put32(buf, 520, 0)
    hidden := wifi.ParseWlanConnection(buf, 604)
    show("wlan no ssid", hidden)
    println "wlan reason", hidden.reason
    show("wlan short", wifi.ParseWlanConnection(buf, 100))
    mem.Free(buf)

    mut trusted := Vector {} as Vector<str>
    trusted.Push("Home")
    trusted.Push("de:ad:be:ef:00:01")
    home := wifi.Status { state = wifi.State.Connected, ssid = "Home", ssid_known = true, security = wifi.Security.Wpa2 }
    cafe := wifi.Status { state = wifi.State.Connected, ssid = "Cafe", ssid_known = true, security = wifi.Security.Wpa2 }
    home_lower := wifi.Status { state = wifi.State.Connected, ssid = "home", ssid_known = true, security = wifi.Security.Wpa2 }
    blind := wifi.Status { state = wifi.State.Connected, security = wifi.Security.Wpa2 }
    blind_open := wifi.Status { state = wifi.State.Connected, security = wifi.Security.Open }
    blind_known_ap := wifi.Status { state = wifi.State.Connected, bssid = "DE:AD:BE:EF:00:01", security = wifi.Security.Open }
    wired := wifi.Status { state = wifi.State.Disconnected }
    none := wifi.Status { state = wifi.State.NoWifi }
    unknown := wifi.Status {}
    println "trust home", wifi.TrustName(wifi.Classify(home, trusted)), wifi.IsUntrusted(home, trusted)
    println "trust cafe", wifi.TrustName(wifi.Classify(cafe, trusted)), wifi.IsUntrusted(cafe, trusted)
    println "trust case", wifi.TrustName(wifi.Classify(home_lower, trusted))
    println "trust blind", wifi.TrustName(wifi.Classify(blind, trusted)), wifi.IsUntrusted(blind, trusted)
    println "trust blind open", wifi.TrustName(wifi.Classify(blind_open, trusted))
    println "trust blind known ap", wifi.TrustName(wifi.Classify(blind_known_ap, trusted))
    println "trust wired", wifi.TrustName(wifi.Classify(wired, trusted))
    println "trust none", wifi.TrustName(wifi.Classify(none, trusted))
    println "trust unknown", wifi.TrustName(wifi.Classify(unknown, trusted))
    trusted.Free()

    println "insecure", blind_open.IsInsecure(), blind.IsInsecure(), home.IsConnected(), wired.IsConnected()
    println "changed", wifi.Changed(home, home), wifi.Changed(home, cafe), wifi.Changed(home, wifi.Status { state = wifi.State.Connected, ssid = "Home", ssid_known = true, security = wifi.Security.Wpa2, signal = 10 })

    cur := wifi.Current()
    println "supported", wifi.Supported()
    println "current is a state", wifi.StateName(cur.state).Len() > 0
    all := wifi.Interfaces()
    println "interfaces are listed", all.Len() >= 0
    all.Free()
end
