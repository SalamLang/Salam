package main

import math
import nn
import tensor

func rnd(v: f64): f64:
    ret math.Round(v * 100.0) / 100.0
end

func spread(t: tensor.Tensor): f64:
    mean := tensor.MeanAll(t)
    mut sq := tensor.Square(t)
    v := tensor.MeanAll(sq) - mean * mean
    tensor.Free(sq)
    ret math.Sqrt(v)
end

func main:
    mut g := tensor.NewRng(7)
    limit := math.Sqrt(6.0 / 32.0)

    mut xu := tensor.Zeros2(64, 64)
    nn.XavierUniform(xu, 16, 16, g)
    println "xavier uniform bounded: ", tensor.MaxAll(xu) <= limit and tensor.MinAll(xu) >= 0.0 - limit
    println "xavier uniform spread: ", tensor.MaxAll(xu) - tensor.MinAll(xu) > limit
    println "xavier uniform centered: ", math.Abs(tensor.MeanAll(xu)) < 0.05

    mut xn := tensor.Zeros2(64, 64)
    nn.XavierNormal(xn, 16, 16, g)
    println "xavier normal std: ", rnd(spread(xn)), rnd(math.Sqrt(2.0 / 32.0))
    println "xavier normal centered: ", math.Abs(tensor.MeanAll(xn)) < 0.05

    kb := math.Sqrt(6.0 / 16.0)
    mut ku := tensor.Zeros2(64, 64)
    nn.KaimingUniform(ku, 16, g)
    println "kaiming uniform bounded: ", tensor.MaxAll(ku) <= kb and tensor.MinAll(ku) >= 0.0 - kb
    println "kaiming uniform spread: ", tensor.MaxAll(ku) - tensor.MinAll(ku) > kb
    println "kaiming uniform centered: ", math.Abs(tensor.MeanAll(ku)) < 0.05

    mut kn := tensor.Zeros2(64, 64)
    nn.KaimingNormal(kn, 16, g)
    println "kaiming normal std: ", rnd(spread(kn)), rnd(math.Sqrt(2.0 / 16.0))
    println "kaiming normal centered: ", math.Abs(tensor.MeanAll(kn)) < 0.05

    mut again := tensor.NewRng(7)
    mut xu2 := tensor.Zeros2(64, 64)
    nn.XavierUniform(xu2, 16, 16, again)
    println "same seed same values: ", tensor.SumAll(xu) == tensor.SumAll(xu2)

    tensor.Free(xu2)
    tensor.Free(kn)
    tensor.Free(ku)
    tensor.Free(xn)
    tensor.Free(xu)
end
