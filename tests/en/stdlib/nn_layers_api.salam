package main

import ai.autograd
import math
import ai.nn
import ai.tensor

func rnd(v: f64): f64:
    ret math.Round(v * 1000.0) / 1000.0
end

func main:
    mut ps := nn.ParamStore {}
    mut g := tensor.NewRng(11)

    full := nn.NewLinear(ps, "full", 3, 2, g)
    println "linear params: ", ps.count(), full.has_bias
    plain := nn.NewLinearNoBias(ps, "plain", 3, 2, g)
    println "no bias params: ", ps.count(), plain.has_bias
    println "no bias sizes: ", plain.in_features, plain.out_features
    println "no bias weight: ", ps.at(plain.w).name
    println "no bias slot: ", plain.b

    mut x := tensor.Zeros2(2, 3)
    x.set_at2(0, 0, 1.0)
    x.set_at2(0, 1, 2.0)
    x.set_at2(0, 2, 3.0)
    x.set_at2(1, 0, 0.0 - 1.0)
    mut tp := autograd.NewTape(1)
    y := autograd.Value(tp, plain.Forward(tp, ps, autograd.Input(tp, x)))
    mut wv := ps.at(plain.w).value
    mut want := tensor.MatMul(x, wv)
    mut worst := 0.0
    repeat 2 in r:
        repeat 2 in c:
            d := math.Abs(y.at2(r, c) - want.at2(r, c))
            if d > worst: worst = d end
        end
    end
    println "output shape: ", y.shape.get(0), y.shape.get(1)
    println "matches matmul: ", worst < 0.000001
    println "second row linear: ", rnd(y.at2(1, 0)), rnd(0.0 - ps.at(plain.w).value.at2(0, 0))

    gn := nn.NewGroupNorm(ps, "gn", 4, 2)
    println "group norm params: ", ps.count(), gn.groups
    println "gamma name: ", ps.at(gn.gamma).name
    println "beta name: ", ps.at(gn.beta).name
    mut img := tensor.Zeros4(1, 4, 1, 3)
    repeat 4 in ch:
        repeat 3 in k:
            img.data.data[ch * 3 + k] = ((ch + 1) * (k + 1)) as f32
        end
    end
    mut tp2 := autograd.NewTape(1)
    z := autograd.Value(tp2, gn.Forward(tp2, ps, autograd.Input(tp2, img)))
    mut sum0 := 0.0
    mut sum1 := 0.0
    repeat 6 in k:
        sum0 += z.data.data[k] as f64
        sum1 += z.data.data[6 + k] as f64
    end
    println "group means zero: ", math.Abs(sum0 / 6.0) < 0.001, math.Abs(sum1 / 6.0) < 0.001
    mut sq0 := 0.0
    repeat 6 in k:
        v := z.data.data[k] as f64
        sq0 += v * v
    end
    println "group variance: ", rnd(sq0 / 6.0)

    mut attn := nn.NewMultiHeadAttention(ps, "attn", 8, 2, 0.0, g)
    println "attention params: ", ps.count()
    println "attention shape: ", attn.dim, attn.heads, attn.causal
    println "projection name: ", ps.at(attn.wq.w).name, ps.at(attn.wo.w).name
    mut s := tensor.Shape2(6, 8)
    mut xa := tensor.RandUniform(s, 0.0 - 1.0, 1.0, 5)
    s.Free()
    mut tp3 := autograd.NewTape(1)
    out := autograd.Value(tp3, attn.Forward(tp3, ps, autograd.Input(tp3, xa), 2, 3))
    println "attention output: ", out.shape.get(0), out.shape.get(1)

    attn.causal = true
    mut xb := tensor.Clone(xa)
    xb.set_at2(2, 0, 9.0)
    mut tp4 := autograd.NewTape(1)
    ya := autograd.Value(tp4, attn.Forward(tp4, ps, autograd.Input(tp4, xa), 2, 3))
    yb := autograd.Value(tp4, attn.Forward(tp4, ps, autograd.Input(tp4, xb), 2, 3))
    mut early := true
    repeat 2 in t:
        repeat 8 in k:
            if ya.at2(t, k) != yb.at2(t, k): early = false end
        end
    end
    mut late := false
    repeat 8 in k:
        if ya.at2(2, k) != yb.at2(2, k): late = true end
    end
    println "causal ignores future: ", early
    println "causal sees present: ", late

    tp4.Free()
    tp3.Free()
    tp2.Free()
    tp.Free()
    tensor.Free(xb)
    tensor.Free(xa)
    tensor.Free(img)
    tensor.Free(want)
    tensor.Free(x)
    ps.Free()
end
