package main

import ai.autograd
import ai.nn
import ai.optim
import ai.tensor
import testing

struct Reverser:
    pub embed: nn.Embedding = nn.Embedding {}
    pub enc1: nn.TransformerEncoderLayer = nn.TransformerEncoderLayer {}
    pub enc2: nn.TransformerEncoderLayer = nn.TransformerEncoderLayer {}
    pub norm: nn.LayerNorm = nn.LayerNorm {}
    pub head: nn.Linear = nn.Linear {}

    pub func forward(tp &: autograd.Tape, ps &: nn.ParamStore, tokens &: Vector<int>, pos &: tensor.Tensor, batch: int, seq: int): int:
        mut h := this.embed.Forward(tp, ps, tokens)
        h = autograd.Add(tp, h, autograd.Input(tp, pos))
        h = this.enc1.Forward(tp, ps, h, batch, seq)
        h = this.enc2.Forward(tp, ps, h, batch, seq)
        h = this.norm.Forward(tp, ps, h)
        ret this.head.Forward(tp, ps, h)
    end
end

func main:
    vocab := 16
    seq := 8
    batch := 32
    dim := 32

    mut g := tensor.NewRng(5)
    mut tokens := Vector {} as Vector<int>
    mut targets := Vector {} as Vector<int>
    repeat batch * seq: tokens.push((g.next_float() * (vocab as f64)) as int) end
    repeat batch in b:
        repeat seq in t: targets.push(tokens.get(b * seq + (seq - 1 - t))) end
    end
    mut pos := nn.SinusoidalPositions(batch, seq, dim)

    mut ps := nn.ParamStore {}
    mut gi := tensor.NewRng(13)
    mut model := Reverser {}
    model.embed = nn.NewEmbedding(ps, "embed", vocab, dim, gi)
    model.enc1 = nn.NewTransformerEncoderLayer(ps, "enc1", dim, 4, 64, 0.0, gi)
    model.enc2 = nn.NewTransformerEncoderLayer(ps, "enc2", dim, 4, 64, 0.0, gi)
    model.norm = nn.NewLayerNorm(ps, "norm", dim)
    model.head = nn.NewLinear(ps, "head", dim, vocab, gi)
    mut opt := optim.Adam { lr = 0.003 }

    mut tp := autograd.NewTape(1)
    mut first_loss := 0.0
    mut last_loss := 0.0
    repeat 200 in step:
        tp.reset()
        ps.zero_grad()
        logits := model.Forward(tp, ps, tokens, pos, batch, seq)
        loss := autograd.CrossEntropyLogits(tp, logits, targets)
        lv := autograd.Value(tp, loss)
        if step == 0: first_loss = lv.at(0) end
        last_loss = lv.at(0)
        autograd.Backward(tp, loss)
        optim.ClipGradNorm(ps, 1.0)
        opt.Step(ps)
    end
    testing.AssertTrue(first_loss > 2.0)
    testing.AssertTrue(last_loss < 0.1)

    tp.reset()
    tp.training = false
    logits := model.Forward(tp, ps, tokens, pos, batch, seq)
    mut lv := autograd.Value(tp, logits)
    mut preds := tensor.ArgMaxAxis(lv, 1, false)
    mut hits := 0
    total := batch * seq
    repeat total in i:
        if (preds.at(i) as int) == targets.get(i): hits++ end
    end
    acc := (hits as f64) / (total as f64)
    testing.AssertTrue(acc >= 0.99)

    tp.Free()
    opt.Free()
    ps.Free()
    tensor.Free(pos)
    tensor.Free(preds)
    tokens.Free()
    targets.Free()

    ret testing.Summary()
end
