package fake

import str
import net.http
import net.router

mut _keys := Vector {} as Vector<str>
mut _codes := Vector {} as Vector<int>
mut _bodies := Vector {} as Vector<str>
mut _used := Vector {} as Vector<bool>
mut _last := ""
mut _headers := ""
mut _count := 0

func _handle(h: i64):
    ctx := http.Ctx(h)
    method := http.Method(ctx)
    path := http.Path(ctx)
    query := http.RawQuery(ctx)
    mut target := path
    if query.Len() > 0: target = path + "?" + query end
    _count++
    _last = method + " " + target
    ctype := http.Header(ctx, "Content-Type")
    if ctype.Len() > 0 and ctype != "application/json": _last = _last + "\n  type: " + ctype end
    body := http.Body(ctx)
    if body.Len() > 0: _last = _last + "\n  body: " + str.TrimRight(body) end
    _headers = ""
    each name in ["Authorization", "X-Amz-Date", "X-Amz-Content-Sha256", "X-Amz-Security-Token", "X-Opaque-Id", "User-Agent"]:
        v := http.Header(ctx, name)
        if v.Len() > 0: _headers = _headers + name + ": " + v + "\n" end
    end
    key := method + " " + path
    mut pick := -1
    repeat _keys.Len() in i:
        if pick < 0 and _keys.Get(i) == key and not _used.Get(i): pick = i end
    end
    if pick < 0:
        repeat _keys.Len() in i:
            if _keys.Get(i) == key: pick = i end
        end
    else:
        _used.Set(pick, true)
    end
    if pick < 0:
        http.SetStatus(ctx, 404)
        http.Json(ctx, `{"error":{"root_cause":[{"type":"resource_not_found_exception","reason":"no route for ` + key + `"}],"type":"resource_not_found_exception","reason":"no route for ` + key + `"},"status":404}`)
        ret
    end
    http.SetStatus(ctx, _codes.Get(pick))
    http.Json(ctx, _bodies.Get(pick))
end

pub func On(method: str, path: str, code: int, body: str):
    _keys.Push(method + " " + path)
    _codes.Push(code)
    _bodies.Push(body)
    _used.Push(false)
end

pub func Last(): str:
    ret _last
end

pub func Headers(): str:
    ret _headers
end

pub func Count(): int:
    ret _count
end

pub func StartFree(): int:
    mut r := router.NewRouter()
    router.Get(r, "/*", _handle)
    router.Post(r, "/*", _handle)
    router.Put(r, "/*", _handle)
    router.Patch(r, "/*", _handle)
    router.Delete(r, "/*", _handle)
    router.Head(r, "/*", _handle)
    mut s := http.NewServer(0)
    http.Use(s, r)
    ret http.RunBackgroundPort(s)
end
