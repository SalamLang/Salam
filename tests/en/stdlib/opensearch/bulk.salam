import str
import db.opensearch

include fake "_fake.salam"

const PORT := 19873

func main:
    fake.On("POST", "/_bulk", 200, `{"took":30,"errors":true,"items":[{"index":{"_index":"books","_id":"10","_version":1,"result":"created","status":201}},{"index":{"_index":"books","_id":"11","_version":1,"result":"created","status":201}},{"create":{"_index":"books","_id":"1","status":409,"error":{"type":"version_conflict_engine_exception","reason":"[1]: version conflict, document already exists (current version [3])"}}},{"update":{"_index":"books","_id":"10","_version":2,"result":"updated","status":200}},{"update":{"_index":"books","_id":"12","_version":1,"result":"created","status":201}},{"delete":{"_index":"books","_id":"404","_version":1,"result":"not_found","status":404}},{"update":{"_index":"books","_id":"777","status":404,"error":{"type":"document_missing_exception","reason":"[777]: document missing"}}}]}`)
    fake.On("POST", "/_bulk", 200, `{"took":2,"errors":false,"items":[{"index":{"_index":"books","_id":"13","_version":1,"result":"created","status":201}}]}`)
    fake.On("POST", "/_bulk", 413, `{"error":{"type":"illegal_argument_exception","reason":"request too large"},"status":413}`)
    if not fake.Start(PORT):
        println "fake server failed to start"
        ret 1
    end
    c := opensearch.Connect("http://127.0.0.1:19873")

    mut b := opensearch.NewBulk()
    opensearch.BulkIndex(b, "books", "10", "{\n  \"title\": \"Divan\",\n  \"author\": \"Hafez\"\n}")
    opensearch.BulkIndexRouted(b, "books", "11", "poetry", `{"title":"Rubaiyat","author":"Khayyam"}`)
    opensearch.BulkCreate(b, "books", "1", `{"title":"Shahnameh"}`)
    opensearch.BulkUpdate(b, "books", "10", `{"stock":4}`)
    opensearch.BulkUpsert(b, "books", "12", `{"title":"Bustan","author":"Saadi"}`)
    opensearch.BulkDelete(b, "books", "404")
    opensearch.BulkUpdate(b, "books", "777", `{"stock":1}`)
    println "actions:", opensearch.BulkLen(b), b.count, "lines:", b.lines.len()
    println "body:"
    print opensearch.BulkBody(b)

    res := opensearch.BulkSendWith(c, b, opensearch.REFRESH_WAIT_FOR)
    println "sent:", fake.Last().split("\n").get(0)
    println "result:", res.ok, res.status, res.took, res.errors, res.succeeded, res.failed
    println "error:", res.error
    each it in res.items:
        println "  item:", it.action, it.index, it.id, it.status, it.ok, it.result, it.version, it.error_type, it.error_reason
    end

    opensearch.BulkReset(b)
    println "after reset:", opensearch.BulkLen(b), opensearch.BulkBody(b).len()
    opensearch.BulkCreate(b, "books", "", `{"title":"Makhzan al-Asrar"}`)
    again := opensearch.BulkSend(c, b)
    println "second batch:", again.ok, again.succeeded, again.items.get(0).id
    println "sent:", fake.Last()
    tooBig := opensearch.BulkSend(c, b)
    println "rejected:", tooBig.ok, tooBig.status, tooBig.error
    opensearch.BulkFree(b)
    println "empty batch:", opensearch.BulkSend(c, opensearch.NewBulk()).ok

    parsed := opensearch.ParseBulk(`{"took":1,"errors":false,"items":[{"delete":{"_index":"a","_id":"x","result":"deleted","status":200,"_version":4}}]}`)
    println "parsed:", parsed.ok, parsed.took, parsed.items.get(0).action, parsed.items.get(0).version
    ret 0
end
