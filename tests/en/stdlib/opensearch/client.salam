import str
import db.opensearch

include fake "_fake.salam"

const PORT := 19870
const DEAD := 19871

func url(port: int): str:
    ret "http://127.0.0.1:" + str.FromInt(port as i64)
end

func main:
    fake.On("HEAD", "/", 200, "")
    fake.On("GET", "/", 200, `{"name":"node-1","cluster_name":"shop","cluster_uuid":"Q1w2E3","version":{"distribution":"opensearch","number":"2.17.1","build_type":"tar","lucene_version":"9.11.1","minimum_wire_compatibility_version":"7.10.0"},"tagline":"The OpenSearch Project: https://opensearch.org/"}`)
    fake.On("GET", "/_cluster/health", 503, `{"error":{"type":"cluster_block_exception","reason":"cluster is starting"},"status":503}`)
    fake.On("GET", "/_cluster/health", 200, `{"cluster_name":"shop","status":"green","timed_out":false,"number_of_nodes":3,"number_of_data_nodes":2,"active_primary_shards":4,"active_shards":8,"relocating_shards":0,"initializing_shards":0,"unassigned_shards":0,"number_of_pending_tasks":0,"active_shards_percent_as_number":100.0}`)
    fake.On("GET", "/books/_doc/missing", 404, `{"_index":"books","_id":"missing","found":false}`)
    fake.On("GET", "/plain", 500, `{"error":"something broke","status":500}`)
    fake.On("GET", "/denied", 403, `{"error":{"root_cause":[{"type":"security_exception","reason":"no permissions for [indices:data/read/get]"}],"type":"security_exception","reason":"no permissions for [indices:data/read/get]"},"status":403}`)
    fake.On("POST", "/_bulk", 200, `{"took":1,"errors":false,"items":[]}`)
    fake.On("GET", "/_count", 200, `{"count":7}`)
    fake.On("GET", "/proxy/_count", 200, `{"count":7}`)
    if not fake.Start(PORT):
        println "fake server failed to start"
        ret 1
    end

    mut cfg := opensearch.DefaultConfig()
    println "default nodes:", cfg.nodes
    cfg.nodes = Vector {} as Vector<str>
    cfg.nodes.push(url(DEAD) + ", " + url(PORT))
    cfg.username = "admin"
    cfg.password = "pa:ss"
    cfg.max_retries = 2
    cfg.timeout_ms = 5000
    cfg.headers.put("X-Opaque-Id", "shop-api")
    mut c := opensearch.NewClient(cfg)
    println "ok:", opensearch.Ok(c), opensearch.Nodes(c)
    println "auth header:", opensearch.AuthHeader(c), opensearch.EncodeBasic("admin", "pa:ss")

    println "ping:", opensearch.Ping(c)
    println "sent:", fake.Last()
    print fake.Headers()

    info := opensearch.GetInfo(c)
    println "info:", info.ok, info.name, info.cluster_name, info.cluster_uuid, info.version, info.distribution
    println "      ", info.build_type, info.lucene_version, info.minimum_wire_compatibility_version, info.tagline

    before := fake.Count()
    h := opensearch.ClusterHealth(c)
    println "health:", h.ok, h.status, h.nodes, h.data_nodes, h.active_shards, h.active_shards_percent
    println "requests for health (503 retried):", fake.Count() - before

    d := opensearch.Get(c, "books", "missing")
    println "missing doc:", d.found, d.error.len(), opensearch.Status(c)

    r := opensearch.Perform(c, "GET", "/plain", "")
    println "plain error:", r.ok, r.status, r.error
    r2 := opensearch.Perform(c, "GET", "/denied", "")
    println "typed error:", r2.status, r2.error_type
    println "client error:", opensearch.Error(c)
    println "error type:", opensearch.ErrorType(c)
    println "error reason:", opensearch.ErrorReason(c)

    nd := opensearch.PerformNdjson(c, "POST", "/_bulk", "{\"delete\":{\"_index\":\"books\",\"_id\":\"9\"}}\n")
    println "ndjson:", nd.ok, nd.body
    println "sent:", fake.Last()
    tx := opensearch.PerformText(c, "GET", "/_count", "", "text/plain")
    println "text:", tx.body
    opensearch.Close(c)
    println "closed:", opensearch.Ok(c), opensearch.Error(c)

    mut tok := opensearch.NewClient(opensearch.Config { bearer = "tok-123" })
    println "bearer:", opensearch.AuthHeader(tok), opensearch.Nodes(tok)
    opensearch.Close(tok)
    mut creds := opensearch.Connect("http://reader:secret@127.0.0.1:" + str.FromInt(PORT as i64))
    println "url credentials:", opensearch.AuthHeader(creds)
    opensearch.Close(creds)
    mut auth := opensearch.ConnectAuth(url(PORT), "writer", "pw")
    println "connect auth:", opensearch.Ping(auth)
    print fake.Headers()
    opensearch.Close(auth)
    mut demo := opensearch.ConnectInsecure("https://localhost:9200", "admin", "admin")
    println "insecure:", opensearch.Ok(demo), opensearch.Nodes(demo)
    opensearch.Close(demo)
    mut bad := opensearch.Connect("ftp://example.com")
    println "bad url:", opensearch.Ok(bad), opensearch.Error(bad)
    opensearch.Close(bad)

    mut aws := opensearch.ConnectAWS(url(PORT) + "/proxy", "eu-west-1", opensearch.SERVICE_AOSS, "AKIDEXAMPLE", "EXAMPLEKEY", "SESSIONTOKEN")
    opensearch.SetSigningTime(aws, 1700000000 as i64)
    println "aws count:", opensearch.Count(aws, "", "")
    println "sent:", fake.Last()
    headers := fake.Headers()
    println "signed:", str.Contains(headers, "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20231114/eu-west-1/aoss/aws4_request")
    println "has date:", str.Contains(headers, "X-Amz-Date: 20231114T221320Z"), "has token:", str.Contains(headers, "X-Amz-Security-Token: SESSIONTOKEN")
    opensearch.Close(aws)
    println "constants:", opensearch.VERSION, opensearch.DEFAULT_URL, opensearch.DEFAULT_PORT, opensearch.DEAD_NODE_MS, opensearch.SERVICE_ES
    ret 0
end
