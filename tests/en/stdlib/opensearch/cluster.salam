import db.opensearch

include fake "_fake.salam"

const PORT := 19877
const ACK := `{"acknowledged":true}`

func main:
    health := `{"cluster_name":"shop","status":"yellow","timed_out":false,"number_of_nodes":1,"number_of_data_nodes":1,"active_primary_shards":7,"active_shards":7,"relocating_shards":0,"initializing_shards":0,"unassigned_shards":5,"number_of_pending_tasks":0,"active_shards_percent_as_number":58.333333333333336}`
    fake.On("GET", "/_cluster/health", 200, health)
    fake.On("GET", "/_cluster/health/books", 200, health)
    fake.On("GET", "/_cluster/stats", 200, `{"cluster_name":"shop","indices":{"count":7,"docs":{"count":1042}},"nodes":{"count":{"total":1}}}`)
    fake.On("GET", "/_cluster/state/metadata", 200, `{"cluster_name":"shop","metadata":{"cluster_uuid":"Q1w2E3"}}`)
    fake.On("GET", "/_cluster/settings", 200, `{"persistent":{"cluster.routing.allocation.enable":"all"},"transient":{}}`)
    fake.On("PUT", "/_cluster/settings", 200, `{"acknowledged":true,"persistent":{"cluster.routing.allocation.enable":"all"},"transient":{}}`)
    fake.On("POST", "/_cluster/allocation/explain", 200, `{"index":"books","shard":0,"primary":false,"current_state":"unassigned","can_allocate":"no"}`)
    fake.On("GET", "/_nodes/os", 200, `{"_nodes":{"total":1},"cluster_name":"shop","nodes":{"n1":{"name":"node-1","os":{"name":"Linux","available_processors":6}}}}`)
    fake.On("GET", "/_nodes/stats/jvm", 200, `{"_nodes":{"total":1},"nodes":{"n1":{"jvm":{"mem":{"heap_used_percent":41}}}}}`)
    fake.On("GET", "/_nodes/hot_threads", 200, "::: {node-1}\n   Hot threads at 2026-10-16T12:00:00Z, interval=500ms")
    fake.On("GET", "/_cat/shards", 200, `[{"index":"books","shard":"0","prirep":"p","state":"STARTED"},{"index":"books","shard":"0","prirep":"r","state":"UNASSIGNED"}]`)
    fake.On("GET", "/_cat/nodes", 200, "ip        heap.percent name\n127.0.0.1           41 node-1\n")
    fake.On("GET", "/_cat/plugins", 200, `[{"name":"node-1","component":"opensearch-knn","version":"2.17.1.0"},{"name":"node-1","component":"opensearch-sql","version":"2.17.1.0"},{"name":"node-2","component":"opensearch-knn","version":"2.17.1.0"}]`)
    fake.On("GET", "/_tasks/n1:12345", 200, `{"completed":false,"task":{"node":"n1","id":12345,"type":"transport","action":"indices:data/write/reindex","description":"reindex from [books] to [books_v2]","status":{"total":1000,"created":250}}}`)
    fake.On("GET", "/_tasks/n1:12345", 200, `{"completed":true,"task":{"node":"n1","id":12345,"action":"indices:data/write/reindex","description":"reindex from [books] to [books_v2]","status":{"total":1000,"created":1000}},"response":{"took":5000,"created":1000,"failures":[]}}`)
    fake.On("GET", "/_tasks/n1:999", 200, `{"completed":true,"task":{"node":"n1","id":999,"action":"indices:data/write/update/byquery"},"error":{"type":"script_exception","reason":"runtime error"}}`)
    fake.On("POST", "/_tasks/n1:12345/_cancel", 200, `{"nodes":{}}`)
    fake.On("GET", "/_tasks", 200, `{"nodes":{"n1":{"tasks":{"n1:12345":{"action":"indices:data/write/reindex"}}}}}`)
    fake.On("PUT", "/_snapshot/backups", 200, ACK)
    fake.On("GET", "/_snapshot/backups", 200, `{"backups":{"type":"fs","settings":{"location":"/mnt/backups"}}}`)
    fake.On("POST", "/_snapshot/backups/_verify", 200, `{"nodes":{"n1":{"name":"node-1"}}}`)
    fake.On("PUT", "/_snapshot/backups/nightly-1", 200, `{"snapshot":{"snapshot":"nightly-1","uuid":"s1","indices":["books"],"state":"SUCCESS","shards":{"total":1,"failed":0,"successful":1}}}`)
    fake.On("PUT", "/_snapshot/backups/nightly-2", 202, `{"accepted":true}`)
    fake.On("GET", "/_snapshot/backups/nightly-1", 200, `{"snapshots":[{"snapshot":"nightly-1","state":"SUCCESS"}]}`)
    fake.On("GET", "/_snapshot/backups/_all", 200, `{"snapshots":[{"snapshot":"nightly-1","state":"SUCCESS"},{"snapshot":"nightly-2","state":"IN_PROGRESS"}]}`)
    fake.On("GET", "/_snapshot/backups/nightly-2/_status", 200, `{"snapshots":[{"snapshot":"nightly-2","state":"STARTED","stats":{"incremental":{"file_count":3}}}]}`)
    fake.On("POST", "/_snapshot/backups/nightly-1/_restore", 200, `{"snapshot":{"snapshot":"nightly-1","indices":["restored_books"],"shards":{"total":1,"failed":0,"successful":1}}}`)
    fake.On("DELETE", "/_snapshot/backups/nightly-1", 200, ACK)
    fake.On("DELETE", "/_snapshot/backups", 200, ACK)
    fake.On("PUT", "/_ingest/pipeline/clean", 200, ACK)
    fake.On("GET", "/_ingest/pipeline/clean", 200, `{"clean":{"description":"tidy incoming books","processors":[{"lowercase":{"field":"genre"}}]}}`)
    fake.On("POST", "/_ingest/pipeline/clean/_simulate", 200, `{"docs":[{"doc":{"_index":"_index","_id":"_id","_source":{"genre":"poetry","seen":true},"_ingest":{"timestamp":"2026-10-16T12:00:00Z"}}},{"doc":{"_index":"_index","_id":"_id","_source":{"genre":"epic","seen":true}}}]}`)
    fake.On("DELETE", "/_ingest/pipeline/clean", 200, ACK)
    fake.On("PUT", "/_scripts/double", 200, ACK)
    fake.On("GET", "/_scripts/double", 200, `{"_id":"double","found":true,"script":{"lang":"painless","source":"doc['stock'].value * 2"}}`)
    fake.On("PUT", "/_scripts/by_genre", 200, ACK)
    fake.On("GET", "/_scripts/by_genre", 200, `{"_id":"by_genre","found":true,"script":{"lang":"mustache","source":{"query":{"term":{"genre":"{{genre}}"}}}}}`)
    fake.On("DELETE", "/_scripts/double", 200, ACK)
    fake.On("DELETE", "/_scripts/by_genre", 200, ACK)
    if not fake.Start(PORT):
        println "fake server failed to start"
        ret 1
    end
    c := opensearch.Connect("http://127.0.0.1:19877")

    h := opensearch.ClusterHealth(c)
    println "health:", h.ok, h.cluster_name, h.status, h.timed_out, h.nodes, h.data_nodes, h.active_primary_shards
    println "  shards:", h.active_shards, h.relocating_shards, h.initializing_shards, h.unassigned_shards, h.pending_tasks, h.active_shards_percent
    w := opensearch.WaitForStatus(c, "books", "yellow", "30s")
    println "wait for yellow:", w.status, "sent:", fake.Last()
    println "stats:", opensearch.JsonPath(opensearch.ClusterStats(c), "indices.docs.count")
    println "state:", opensearch.JsonPath(opensearch.ClusterState(c, "metadata"), "metadata.cluster_uuid")
    println "put settings:", opensearch.PutClusterSettings(c, `{"cluster.routing.allocation.enable":"all"}`, "")
    println "  sent:", fake.Last()
    println "settings:", opensearch.GetClusterSettings(c)
    println "  sent:", fake.Last()
    println "allocation:", opensearch.JsonPath(opensearch.AllocationExplain(c, `{"index":"books","shard":0,"primary":false}`), "can_allocate")
    println "nodes info:", opensearch.JsonPath(opensearch.NodesInfo(c, "os"), "nodes.n1.os.available_processors")
    println "nodes stats:", opensearch.JsonPath(opensearch.NodesStats(c, "jvm"), "nodes.n1.jvm.mem.heap_used_percent")
    println "hot threads:", opensearch.HotThreads(c).split("\n").get(0)
    each row in opensearch.Cat(c, "shards?h=index,shard,prirep,state"):
        println "cat row:", opensearch.JsonPath(row, "index"), opensearch.JsonPath(row, "prirep"), opensearch.JsonPath(row, "state")
    end
    println "  sent:", fake.Last()
    print opensearch.CatText(c, "nodes")
    println "  sent:", fake.Last()
    println "plugins:", opensearch.Plugins(c)
    println "has knn:", opensearch.HasPlugin(c, "opensearch-knn"), "has ltr:", opensearch.HasPlugin(c, "opensearch-ltr")

    t := opensearch.GetTask(c, "n1:12345")
    println "task:", t.ok, t.id, t.completed, t.action, t.description
    println "  progress:", t.status
    done := opensearch.WaitTask(c, "n1:12345", "60s")
    println "waited:", done.completed, done.response, "sent:", fake.Last()
    failed := opensearch.GetTask(c, "n1:999")
    println "failed task:", failed.ok, failed.error
    println "cancel:", opensearch.CancelTask(c, "n1:12345"), fake.Last()
    println "running:", opensearch.ListTasks(c, "*reindex").len() > 0, fake.Last()

    println "repository:", opensearch.PutRepository(c, "backups", "fs", `{"location":"/mnt/backups","compress":true}`)
    println "  sent:", fake.Last()
    println "  get:", opensearch.JsonPath(opensearch.GetRepository(c, "backups"), "backups.type"), "verify:", opensearch.VerifyRepository(c, "backups")
    println "snapshot (waited):", opensearch.CreateSnapshot(c, "backups", "nightly-1", "books", true)
    println "  sent:", fake.Last()
    println "snapshot (background):", opensearch.CreateSnapshot(c, "backups", "nightly-2", "", false)
    println "  snapshots:", opensearch.Snapshots(c, "backups"), opensearch.JsonPath(opensearch.GetSnapshot(c, "backups", "nightly-1"), "snapshots.0.state")
    println "  status:", opensearch.JsonPath(opensearch.SnapshotStatus(c, "backups", "nightly-2"), "snapshots.0.state")
    println "restore:", opensearch.RestoreSnapshot(c, "backups", "nightly-1", `{"indices":"books","rename_pattern":"(.+)","rename_replacement":"restored_$1"}`, true)
    println "  sent:", fake.Last()
    println "cleanup:", opensearch.DeleteSnapshot(c, "backups", "nightly-1"), opensearch.DeleteRepository(c, "backups")

    mut procs := Vector {} as Vector<str>
    procs.push(opensearch.Processor("lowercase", `{"field":"genre"}`))
    procs.push(opensearch.Processor("set", `{"field":"seen","value":true}`))
    procs.push(opensearch.Processor("trim", ""))
    body := opensearch.Pipeline("tidy incoming books", procs)
    println "pipeline body:", body
    println "pipeline:", opensearch.PutPipeline(c, "clean", body), opensearch.JsonPath(opensearch.GetPipeline(c, "clean"), "clean.description")
    mut docs := Vector {} as Vector<str>
    docs.push(`{"genre":"POETRY"}`)
    docs.push(`{"genre":"Epic"}`)
    each out in opensearch.SimulatePipeline(c, "clean", docs):
        println "  simulated:", out
    end
    println "  sent:", fake.Last()
    println "drop pipeline:", opensearch.DeletePipeline(c, "clean")

    println "script:", opensearch.PutScript(c, "double", "doc['stock'].value * 2"), opensearch.GetScript(c, "double")
    println "  sent:", fake.Last()
    println "template:", opensearch.PutSearchTemplate(c, "by_genre", `{"query":{"term":{"genre":"{{genre}}"}}}`), opensearch.GetScript(c, "by_genre")
    println "cleanup:", opensearch.DeleteScript(c, "double"), opensearch.DeleteScript(c, "by_genre")
    ret 0
end
