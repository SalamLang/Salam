import db.opensearch

include fake "_fake.salam"

const PORT := 19876
const ACK := `{"acknowledged":true}`

func list(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    if b.len() > 0: v.push(b) end
    ret v
end

func show(label: str, value: bool):
    println label + ":", value
    println "  sent:", fake.Last()
end

func main:
    fake.On("PUT", "/books", 200, `{"acknowledged":true,"shards_acknowledged":true,"index":"books"}`)
    fake.On("PUT", "/books", 400, `{"error":{"root_cause":[{"type":"resource_already_exists_exception","reason":"index [books/x1] already exists"}],"type":"resource_already_exists_exception","reason":"index [books/x1] already exists"},"status":400}`)
    fake.On("PUT", "/logs-000001", 200, `{"acknowledged":true,"shards_acknowledged":true,"index":"logs-000001"}`)
    fake.On("HEAD", "/books", 200, "")
    fake.On("HEAD", "/nope", 404, "")
    fake.On("GET", "/books", 200, `{"books":{"aliases":{},"mappings":{"properties":{"title":{"type":"text"}}},"settings":{"index":{"number_of_shards":"1"}}}}`)
    fake.On("PUT", "/books/_mapping", 200, ACK)
    fake.On("GET", "/books/_mapping", 200, `{"books":{"mappings":{"dynamic":"strict","properties":{"isbn":{"type":"keyword"},"title":{"type":"text"}}}}}`)
    fake.On("PUT", "/books/_settings", 200, ACK)
    fake.On("GET", "/books/_settings", 200, `{"books":{"settings":{"index":{"refresh_interval":"5s","number_of_shards":"1"}}}}`)
    fake.On("GET", "/books/_settings/index.refresh_interval", 200, `{"books":{"settings":{"index.refresh_interval":"5s"}}}`)
    fake.On("POST", "/books/_refresh", 200, `{"_shards":{"total":2,"successful":1,"failed":0}}`)
    fake.On("POST", "/books/_flush", 200, `{"_shards":{"total":2,"successful":1,"failed":0}}`)
    fake.On("POST", "/books/_forcemerge", 200, `{"_shards":{"total":2,"successful":1,"failed":0}}`)
    fake.On("POST", "/books/_cache/clear", 200, `{"_shards":{"total":2,"successful":1,"failed":0}}`)
    fake.On("POST", "/books/_close", 200, `{"acknowledged":true,"shards_acknowledged":true,"indices":{"books":{"closed":true}}}`)
    fake.On("POST", "/books/_open", 200, `{"acknowledged":true,"shards_acknowledged":true}`)
    fake.On("PUT", "/books/_clone/books_copy", 200, `{"acknowledged":true,"shards_acknowledged":true,"index":"books_copy"}`)
    fake.On("PUT", "/books/_shrink/books_small", 200, `{"acknowledged":true,"shards_acknowledged":true,"index":"books_small"}`)
    fake.On("PUT", "/books/_split/books_big", 200, `{"acknowledged":true,"shards_acknowledged":true,"index":"books_big"}`)
    fake.On("GET", "/books/_stats", 200, `{"_all":{"primaries":{"docs":{"count":42,"deleted":0}}}}`)
    fake.On("PUT", "/books/_alias/library", 200, ACK)
    fake.On("PUT", "/books/_alias/poetry", 200, ACK)
    fake.On("HEAD", "/_alias/library", 200, "")
    fake.On("GET", "/books/_alias", 200, `{"books":{"aliases":{"library":{},"poetry":{"filter":{"term":{"genre":"poetry"}}}}}}`)
    fake.On("GET", "/_alias/library", 200, `{"books":{"aliases":{"library":{}}},"books_copy":{"aliases":{"library":{}}}}`)
    fake.On("DELETE", "/books/_alias/poetry", 200, ACK)
    fake.On("POST", "/_aliases", 200, ACK)
    fake.On("POST", "/_aliases", 200, ACK)
    fake.On("PUT", "/_index_template/logs", 200, ACK)
    fake.On("HEAD", "/_index_template/logs", 200, "")
    fake.On("GET", "/_index_template/logs", 200, `{"index_templates":[{"name":"logs","index_template":{"index_patterns":["logs-*"],"priority":10}}]}`)
    fake.On("DELETE", "/_index_template/logs", 200, ACK)
    fake.On("PUT", "/_component_template/base", 200, ACK)
    fake.On("GET", "/_component_template/base", 200, `{"component_templates":[{"name":"base","component_template":{"template":{"settings":{"number_of_shards":"1"}}}}]}`)
    fake.On("DELETE", "/_component_template/base", 200, ACK)
    fake.On("PUT", "/_data_stream/events-web", 200, ACK)
    fake.On("GET", "/_data_stream", 200, `{"data_streams":[{"name":"events-web","timestamp_field":{"name":"@timestamp"},"indices":[{"index_name":".ds-events-web-000001"}],"generation":1,"status":"GREEN","template":"events"}]}`)
    fake.On("DELETE", "/_data_stream/events-web", 200, ACK)
    fake.On("POST", "/logs/_rollover", 200, `{"acknowledged":true,"shards_acknowledged":true,"old_index":"logs-000001","new_index":"logs-000002","rolled_over":true,"dry_run":false,"conditions":{"[max_docs: 1000000]":true}}`)
    fake.On("POST", "/_analyze", 200, `{"tokens":[{"token":"salam","start_offset":0,"end_offset":5,"type":"<ALPHANUM>","position":0},{"token":"opensearch","start_offset":9,"end_offset":19,"type":"<ALPHANUM>","position":2}]}`)
    fake.On("POST", "/books/_analyze", 200, `{"tokens":[{"token":"کتاب","start_offset":0,"end_offset":4,"type":"<ALPHANUM>","position":0}]}`)
    fake.On("GET", "/_cat/indices/books*", 200, `[{"health":"green","status":"open","index":"books","uuid":"x1","pri":"1","rep":"1","docs.count":"42","docs.deleted":"3","store.size":"52301"},{"health":"yellow","status":"open","index":"books_copy","uuid":"x2","pri":"1","rep":"1","docs.count":"42","docs.deleted":"0","store.size":"50112"}]`)
    fake.On("DELETE", "/books_copy,books_small", 200, ACK)
    fake.On("DELETE", "/never-made", 404, `{"error":{"type":"index_not_found_exception","reason":"no such index [never-made]"},"status":404}`)
    if not fake.Start(PORT):
        println "fake server failed to start"
        ret 1
    end
    c := opensearch.Connect("http://127.0.0.1:19876")

    mut props := Vector {} as Vector<str>
    props.push(opensearch.Property("title", "text"))
    props.push(opensearch.PropertyWith("title_fa", "text", `{"analyzer":"persian"}`))
    props.push(opensearch.Property("genre", "keyword"))
    props.push(opensearch.PropertyWith("year", "integer", `{"index":true}`))
    println "properties:", opensearch.Properties(props)
    show("create with settings", opensearch.CreateIndexWith(c, "books", 1, 1, opensearch.Properties(props)))
    show("create again", opensearch.CreateIndex(c, "books", ""))
    println "  error:", opensearch.ErrorType(c)
    show("create with body", opensearch.CreateIndex(c, "logs-000001", `{"aliases":{"logs":{"is_write_index":true}}}`))
    println "exists:", opensearch.IndexExists(c, "books"), opensearch.IndexExists(c, "nope")
    println "get index:", opensearch.GetIndex(c, "books")

    show("put mapping", opensearch.PutMapping(c, "books", "{" + opensearch.Property("isbn", "keyword") + "}"))
    show("put mapping body", opensearch.PutMappingBody(c, "books", `{"dynamic":"strict"}`))
    mapping := opensearch.GetMapping(c, "books")
    println "mapping:", opensearch.JsonPath(mapping, "books.mappings.dynamic"), opensearch.JsonPath(mapping, "books.mappings.properties.isbn.type")
    show("put settings", opensearch.PutSettings(c, "books", `{"index":{"refresh_interval":"5s"}}`))
    println "settings:", opensearch.JsonPath(opensearch.GetSettings(c, "books"), "books.settings.index.number_of_shards")
    println "one setting:", opensearch.GetSetting(c, "books", "index.refresh_interval")
    println "maintenance:", opensearch.Refresh(c, "books"), opensearch.Flush(c, "books"), opensearch.ForceMerge(c, "books", 1), opensearch.ClearCache(c, "books")
    println "  last:", fake.Last()
    show("close", opensearch.CloseIndex(c, "books"))
    show("open", opensearch.OpenIndex(c, "books"))
    show("clone", opensearch.CloneIndex(c, "books", "books_copy", ""))
    show("shrink", opensearch.ShrinkIndex(c, "books", "books_small", `{"settings":{"index.number_of_shards":1}}`))
    show("split", opensearch.SplitIndex(c, "books", "books_big", `{"settings":{"index.number_of_shards":2}}`))
    println "stats docs:", opensearch.JsonPath(opensearch.IndexStats(c, "books"), "_all.primaries.docs.count")

    show("alias", opensearch.PutAlias(c, "books", "library"))
    show("filtered alias", opensearch.PutAliasFiltered(c, "books", "poetry", opensearch.Term("genre", "poetry"), true))
    println "alias exists:", opensearch.AliasExists(c, "library")
    println "aliases:", opensearch.GetAliases(c, "books")
    println "alias points at:", opensearch.AliasIndices(c, "library")
    show("drop alias", opensearch.DeleteAlias(c, "books", "poetry"))
    show("update aliases", opensearch.UpdateAliases(c, list(opensearch.AliasAction("add", "books_copy", "library"), opensearch.AliasAction("remove", "books", "library"))))
    show("swap alias", opensearch.SwapAlias(c, "library", "books_copy", "books"))

    tpl := opensearch.IndexTemplate(list("logs-*", ""), `{"number_of_replicas":0}`, "{" + opensearch.Property("message", "text") + "}", 10)
    println "template body:", tpl
    show("index template", opensearch.PutIndexTemplate(c, "logs", tpl))
    println "template exists:", opensearch.IndexTemplateExists(c, "logs"), opensearch.JsonPath(opensearch.GetIndexTemplate(c, "logs"), "index_templates.0.index_template.priority")
    show("component template", opensearch.PutComponentTemplate(c, "base", `{"template":{"settings":{"number_of_shards":1}}}`))
    println "component:", opensearch.JsonPath(opensearch.GetComponentTemplate(c, "base"), "component_templates.0.name")
    show("data stream", opensearch.CreateDataStream(c, "events-web"))
    println "data streams:", opensearch.DataStreams(c)
    println "rollover:", opensearch.Rollover(c, "logs", `{"max_docs":1000000,"max_age":"7d"}`)
    println "  sent:", fake.Last()
    println "analyze:", opensearch.Analyze(c, "", "standard", "Salam to OpenSearch")
    println "analyze persian:", opensearch.Analyze(c, "books", "persian", "کتاب‌ها")
    println "  sent:", fake.Last()
    each ix in opensearch.CatIndices(c, "books*"):
        println "cat:", ix.health, ix.status, ix.index, ix.uuid, ix.primaries, ix.replicas, ix.docs_count, ix.docs_deleted, ix.store_size
    end
    println "  sent:", fake.Last()
    println "cleanup:", opensearch.DeleteIndexTemplate(c, "logs"), opensearch.DeleteComponentTemplate(c, "base"), opensearch.DeleteDataStream(c, "events-web")
    show("delete two", opensearch.DeleteIndex(c, "books_copy,books_small"))
    show("delete if exists", opensearch.DeleteIndexIfExists(c, "never-made"))
    ret 0
end
