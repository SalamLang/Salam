import db.opensearch

func list(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    if b.len() > 0: v.push(b) end
    ret v
end

func main:
    println "full text:"
    println "  ", opensearch.MatchAll()
    println "  ", opensearch.MatchNone()
    println "  ", opensearch.Match("title", "book of kings")
    println "  ", opensearch.MatchAnd("title", "book of kings")
    println "  ", opensearch.MatchFuzzy("author", "ferdousi")
    println "  ", opensearch.MatchPhrase("title", "book of kings")
    println "  ", opensearch.MatchPhraseSlop("title", "book kings", 2)
    println "  ", opensearch.MatchPhrasePrefix("title", "book of ki")
    println "  ", opensearch.MatchBoolPrefix("title", "kings bo")
    println "  ", opensearch.MultiMatch("ferdowsi", list("title^2", "author"))
    println "  ", opensearch.MultiMatchType("persian epic", list("title", "summary"), "most_fields")
    println "  ", opensearch.QueryString("author:ferdowsi AND year:[1000 TO 1100]")
    println "  ", opensearch.QueryStringFields("epic poem", list("title", "summary"), "AND")
    println "  ", opensearch.SimpleQueryString("epic -modern", list("summary", ""))
    println "  ", opensearch.MoreLikeThis(list("summary", ""), "a long poem about the kings of Iran")

    println "exact values:"
    println "  ", opensearch.Term("genre", "epic")
    println "  ", opensearch.TermInt("year", 1010)
    println "  ", opensearch.TermBool("in_print", true)
    println "  ", opensearch.TermCaseInsensitive("genre", "Epic")
    println "  ", opensearch.Terms("genre", list("epic", "lyric"))
    mut years := Vector {} as Vector<i64>
    years.push(1010)
    years.push(1258)
    println "  ", opensearch.TermsInt("year", years)
    println "  ", opensearch.TermsLookup("genre", "readers", "u7", "likes")
    println "  ", opensearch.TermsSet("tags", list("persian", "classic"), "required_matches")
    println "  ", opensearch.FieldExists("isbn")
    println "  ", opensearch.Prefix("isbn", "978-964")
    println "  ", opensearch.Wildcard("isbn", "978-*-1")
    println "  ", opensearch.Regexp("isbn", "978-[0-9]+")
    println "  ", opensearch.Fuzzy("author", "sadi")
    println "  ", opensearch.Ids(list("1", "2"))

    println "ranges:"
    println "  ", opensearch.Range("published", "1000-01-01", "")
    println "  ", opensearch.RangeExclusive("price", "10", "20")
    println "  ", opensearch.RangeNum("price", 9.5, 19.99)
    println "  ", opensearch.RangeInt("stock", 1, 100)
    println "  ", opensearch.RangeOp("price", "lt", "5")
    println "  ", opensearch.DateRange("published", "now-30d/d", "now", "yyyy-MM-dd", "+03:30")

    println "compound:"
    mut b := opensearch.BoolQuery { minimum_should_match = "1", boost = 1.5 }
    b.must.push(opensearch.Match("summary", "kings"))
    b.filter.push(opensearch.Term("genre", "epic"))
    b.should.push(opensearch.Term("tags", "classic"))
    b.must_not.push(opensearch.Term("tags", "abridged"))
    println "  ", opensearch.BoolOf(b)
    println "  ", opensearch.Bool(list(opensearch.Match("t", "x"), ""), list(opensearch.Term("a", "1"), ""), Vector {} as Vector<str>, list(opensearch.Term("b", "2"), ""))
    println "  ", opensearch.And(list(opensearch.Term("genre", "epic"), opensearch.TermInt("year", 1010)))
    println "  ", opensearch.Or(list(opensearch.Term("genre", "epic"), opensearch.Term("genre", "lyric")))
    println "  ", opensearch.Not(opensearch.Term("genre", "prose"))
    println "  ", opensearch.Filtered(opensearch.Match("summary", "kings"), list(opensearch.RangeInt("year", 900, 1100), ""))
    println "  ", opensearch.ConstantScore(opensearch.Term("genre", "epic"), 2.0)
    println "  ", opensearch.DisMax(list(opensearch.Match("title", "kings"), opensearch.Match("summary", "kings")), 0.3)
    println "  ", opensearch.Boosting(opensearch.Match("summary", "kings"), opensearch.Term("tags", "abridged"), 0.2)
    println "  ", opensearch.Nested("reviews", opensearch.RangeInt("reviews.stars", 4, 5))
    println "  ", opensearch.HasChild("review", opensearch.TermInt("stars", 5))
    println "  ", opensearch.HasParent("book", opensearch.Term("genre", "epic"))

    println "scripts and scoring:"
    println "  ", opensearch.Script("doc['stock'].value > params.min", `{"min":2}`)
    println "  ", opensearch.ScriptQuery("doc['stock'].value > params.min", `{"min":2}`)
    println "  ", opensearch.ScriptScore(opensearch.Match("summary", "kings"), "_score * Math.log(2 + doc['sales'].value)", "")
    println "  ", opensearch.FunctionScore(opensearch.Match("summary", "kings"), list(opensearch.FieldValueFactor("sales", 1.2, "log1p"), ""), "sum", "multiply")

    println "geo:"
    println "  ", opensearch.GeoDistance("shop", 35.6892, 51.389, "10km")
    println "  ", opensearch.GeoBoundingBox("shop", 35.8, 51.2, 35.6, 51.6)

    println "vectors:"
    mut v := Vector {} as Vector<f64>
    v.push(0.12)
    v.push(-0.5)
    v.push(0.9)
    println "  ", opensearch.KnnVector(v)
    println "  ", opensearch.Knn("embedding", v, 10)
    println "  ", opensearch.KnnFiltered("embedding", v, 10, opensearch.Term("genre", "epic"))
    println "  ", opensearch.KnnRadial("embedding", v, 0.4)
    println "  ", opensearch.KnnMinScore("embedding", v, 0.75)
    println "  ", opensearch.Neural("embedding", "stories of ancient kings", "m-31", 5)
    println "  ", opensearch.NeuralSparse("sparse", "stories of ancient kings", "m-32")
    println "  ", opensearch.Hybrid(list(opensearch.Match("summary", "kings"), opensearch.Neural("embedding", "kings", "m-31", 5)))

    println "sorting, highlighting, suggesters:"
    println "  ", opensearch.SortAsc("year"), opensearch.SortDesc("sales"), opensearch.SortScore()
    println "  ", opensearch.SortGeo("shop", 35.6892, 51.389, "km")
    println "  ", opensearch.Highlight(list("title", "summary"))
    println "  ", opensearch.HighlightTags(list("summary", ""), "<mark>", "</mark>")
    println "  ", opensearch.Collapse("author")
    println "  ", opensearch.TermSuggest("fix", "shahname", "title")
    println "  ", opensearch.CompletionSuggest("auto", "shah", "title.complete", 5)

    println "json helpers:"
    println "  ", opensearch.AddMember(`{"size":0}`, "query", opensearch.MatchAll())
    println "  ", opensearch.AddMember("", "track_total_hits", "true")
    println "  ", opensearch.JsonPath(`{"a":{"b":[10,{"c":"deep"}]}}`, "a.b.1.c"), opensearch.JsonPath(`{"a":{"b":[10]}}`, "a.b.0")
    println "  ", opensearch.JsonPathRaw(`{"a":{"b":[10,{"c":"deep"}]}}`, "a.b"), opensearch.JsonPath(`{"a":1}`, "nope").len()
    println "  ", opensearch.JsonItems(`[1, "two", {"three": 3}, null]`).len()

    println "search bodies:"
    mut req := opensearch.SearchRequest { query = opensearch.BoolOf(b), from = 20, size = 10, track_total_hits = "true" }
    req.sort.push(opensearch.SortDesc("sales"))
    req.sort.push(opensearch.SortScore())
    req.source.push("title")
    req.source.push("author")
    req.source_excludes.push("summary")
    req.fields.push("published")
    req.docvalue_fields.push("year")
    req.highlight = opensearch.Highlight(list("summary", ""))
    req.post_filter = opensearch.Term("in_print", "true")
    req.collapse = opensearch.Collapse("author")
    req.suggest = opensearch.TermSuggest("fix", "shahname", "title")
    req.rescore = `{"window_size":50,"query":{"rescore_query":{"match_phrase":{"summary":"kings"}}}}`
    req.script_fields = `{"double_price":{"script":{"source":"doc['price'].value * 2"}}}`
    req.min_score = "0.5"
    req.timeout = "2s"
    req.track_scores = true
    req.explain = true
    req.version = true
    req.seq_no_primary_term = true
    req.ext = `{"generative_qa_parameters":{"llm_question":"Who wrote it?"}}`
    req.extra.push(`"profile":true`)
    println opensearch.SearchBody(req)
    after := opensearch.SearchRequest { query = opensearch.MatchAll(), size = 100, search_after = `[1700000000000,"b42"]`, pit_id = "46ToAwMDaWR4", pit_keep_alive = "2m", track_total_hits = "10000" }
    println opensearch.SearchBody(after)
    println opensearch.SearchBody(opensearch.SearchRequest { no_source = true, size = 0, track_total_hits = "false" })
    println opensearch.SearchBody(opensearch.SearchRequest {})
end
