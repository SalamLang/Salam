import db.opensearch

include fake "_fake.salam"

const PORT := 19875

func list(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    if b.len() > 0: v.push(b) end
    ret v
end

func hits(label: str, r: opensearch.SearchResult):
    println label + ":", r.ok, r.status, r.took, r.timed_out, r.total, r.total_relation, r.max_score, r.hits.len()
    if not r.ok: println "  error:", r.error end
    each h in r.hits:
        println "  hit:", h.index, h.id, h.score, h.source
        if h.sort.len() > 0: println "    sort:", h.sort end
        if h.highlight.len() > 0: println "    highlight:", h.highlight end
        if h.fields.len() > 0: println "    fields:", h.fields end
        if h.matched_queries.len() > 0: println "    matched:", h.matched_queries end
        if h.inner_hits.len() > 0: println "    inner hits:", h.inner_hits end
    end
end

func main:
    page1 := `{"_scroll_id":"DXF1ZXJ5QW5kRmV0Y2gBAA","took":3,"timed_out":false,"hits":{"total":{"value":3,"relation":"eq"},"max_score":1.0,"hits":[{"_index":"books","_id":"1","_score":1.0,"_source":{"title":"Shahnameh"},"sort":[1010]},{"_index":"books","_id":"2","_score":1.0,"_source":{"title":"Masnavi"},"sort":[1258]}]}}`
    page2 := `{"_scroll_id":"DXF1ZXJ5QW5kRmV0Y2gBAA","took":1,"timed_out":false,"hits":{"total":{"value":3,"relation":"eq"},"max_score":1.0,"hits":[{"_index":"books","_id":"3","_score":1.0,"_source":{"title":"Golestan"},"sort":[1259]}]}}`
    empty := `{"_scroll_id":"DXF1ZXJ5QW5kRmV0Y2gBAA","took":1,"timed_out":false,"hits":{"total":{"value":3,"relation":"eq"},"max_score":null,"hits":[]}}`
    fake.On("POST", "/books/_search", 200, `{"took":5,"timed_out":false,"_shards":{"total":1,"successful":1,"skipped":0,"failed":0},"hits":{"total":{"value":2,"relation":"eq"},"max_score":2.31,"hits":[{"_index":"books","_id":"1","_score":2.31,"_source":{"title":"Shahnameh","author":"Ferdowsi"},"highlight":{"title":["<em>Shahnameh</em>"]},"fields":{"year":[1010]},"matched_queries":["by_title"]},{"_index":"books","_id":"7","_score":0.42,"_source":{"title":"Shahnameh for children"},"inner_hits":{"reviews":{"hits":{"total":{"value":0,"relation":"eq"},"hits":[]}}}}]},"suggest":{"fix":[{"text":"shahname","offset":0,"length":8,"options":[{"text":"shahnameh","score":0.875,"freq":12}]}]}}`)
    fake.On("POST", "/books/_search", 200, page1)
    fake.On("POST", "/books/_search", 400, `{"error":{"root_cause":[{"type":"parsing_exception","reason":"unknown query [nope]"}],"type":"parsing_exception","reason":"unknown query [nope]"},"status":400}`)
    fake.On("POST", "/books,articles/_search", 200, `{"took":2,"timed_out":false,"hits":{"total":{"value":10000,"relation":"gte"},"max_score":1.0,"hits":[]}}`)
    fake.On("POST", "/_search", 200, `{"took":1,"timed_out":false,"hits":{"total":{"value":5,"relation":"eq"},"max_score":1.0,"hits":[]}}`)
    fake.On("POST", "/_search/scroll", 200, page2)
    fake.On("POST", "/_search/scroll", 200, empty)
    fake.On("DELETE", "/_search/scroll", 200, `{"succeeded":true,"num_freed":1}`)
    fake.On("POST", "/books/_search/point_in_time", 200, `{"pit_id":"o463QQEKYm9va3MWX1BhQjQ","_shards":{"total":1,"successful":1,"skipped":0,"failed":0},"creation_time":1760000000000}`)
    fake.On("POST", "/_search", 200, `{"pit_id":"o463QQEKYm9va3MWX1BhQjQ","took":2,"timed_out":false,"hits":{"total":{"value":2,"relation":"eq"},"max_score":null,"hits":[{"_index":"books","_id":"1","_score":null,"_source":{"title":"Shahnameh"},"sort":[1010,0]},{"_index":"books","_id":"2","_score":null,"_source":{"title":"Masnavi"},"sort":[1258,1]}]}}`)
    fake.On("POST", "/_search", 200, `{"pit_id":"o463QQEKYm9va3MWX1BhQjQ","took":1,"timed_out":false,"hits":{"total":{"value":2,"relation":"eq"},"max_score":null,"hits":[]}}`)
    fake.On("GET", "/_search/point_in_time/_all", 200, `{"pits":[{"pit_id":"o463QQEKYm9va3MWX1BhQjQ","creation_time":1760000000000,"keep_alive":120000}]}`)
    fake.On("DELETE", "/_search/point_in_time", 200, `{"pits":[{"successful":true,"pit_id":"o463QQEKYm9va3MWX1BhQjQ"}]}`)
    fake.On("DELETE", "/_search/point_in_time/_all", 200, `{"pits":[]}`)
    fake.On("POST", "/_msearch", 200, `{"took":4,"responses":[{"took":2,"timed_out":false,"hits":{"total":{"value":12,"relation":"eq"},"max_score":null,"hits":[]},"status":200},{"error":{"root_cause":[{"type":"index_not_found_exception","reason":"no such index [nope]"}],"type":"index_not_found_exception","reason":"no such index [nope]"},"status":404}]}`)
    fake.On("POST", "/books/_search/template", 200, `{"took":1,"timed_out":false,"hits":{"total":{"value":4,"relation":"eq"},"max_score":1.0,"hits":[]}}`)
    fake.On("POST", "/books/_search/template", 200, `{"took":1,"timed_out":false,"hits":{"total":{"value":9,"relation":"eq"},"max_score":1.0,"hits":[]}}`)
    fake.On("POST", "/_render/template", 200, `{"template_output":{"query":{"term":{"author":"Saadi"}}}}`)
    fake.On("POST", "/books/_explain/1", 200, `{"_index":"books","_id":"1","matched":true,"explanation":{"value":2.31,"description":"weight(title:shahnameh in 0)","details":[]}}`)
    fake.On("POST", "/books/_validate/query", 200, `{"_shards":{"total":1,"successful":1,"failed":0},"valid":true}`)
    fake.On("POST", "/books/_validate/query", 200, `{"_shards":{"total":1,"successful":1,"failed":0},"valid":false}`)
    fake.On("GET", "/books/_field_caps", 200, `{"indices":["books"],"fields":{"title":{"text":{"type":"text","searchable":true,"aggregatable":false}},"year":{"long":{"type":"long","searchable":true,"aggregatable":true}}}}`)
    fake.On("POST", "/books/_search", 200, `{"took":1,"timed_out":false,"hits":{"total":{"value":1,"relation":"eq"},"max_score":1.0,"hits":[]}}`)
    if not fake.Start(PORT):
        println "fake server failed to start"
        ret 1
    end
    c := opensearch.Connect("http://127.0.0.1:19875")

    mut req := opensearch.SearchRequest { query = `{"match":{"title":{"query":"shahname","_name":"by_title"}}}`, size = 5 }
    req.highlight = opensearch.Highlight(list("title", ""))
    req.fields.push("year")
    req.suggest = opensearch.TermSuggest("fix", "shahname", "title")
    r := opensearch.SearchWith(c, "books", req)
    println "sent:", fake.Last()
    hits("search", r)
    println "did you mean:", opensearch.Suggestions(r.suggest, "fix")
    println "raw response bytes:", r.raw.len() > 100

    mut first := opensearch.SearchRequest { query = opensearch.MatchAll(), size = 2 }
    first.sort.push(opensearch.SortAsc("year"))
    mut page := opensearch.SearchScroll(c, "books", first, "1m")
    println "scroll start sent:", fake.Last()
    mut seen := 0
    until page.hits.len() > 0:
        each h in page.hits:
            println "  scrolled:", h.id, h.source
        end
        seen += page.hits.len()
        page = opensearch.Scroll(c, page.scroll_id, "1m")
    end
    println "scroll total:", seen, "last sent:", fake.Last()
    println "clear scroll:", opensearch.ClearScroll(c, page.scroll_id)
    println "  sent:", fake.Last()

    bad := opensearch.SearchRaw(c, "books", `{"query":{"nope":{}}}`)
    hits("bad query", bad)
    println "error type:", opensearch.ErrorType(c)
    hits("two indices", opensearch.Search(c, "books,articles", opensearch.MatchAll()))
    hits("every index", opensearch.Search(c, "", opensearch.MatchAll()))

    pit := opensearch.CreatePit(c, "books", "2m")
    println "pit:", pit, "sent:", fake.Last()
    mut preq := opensearch.SearchRequest { query = opensearch.MatchAll(), size = 2, pit_id = pit, pit_keep_alive = "2m" }
    preq.sort.push(opensearch.SortAsc("year"))
    mut pp := opensearch.SearchWith(c, "books", preq)
    println "pit search sent:", fake.Last()
    until pp.hits.len() > 0:
        each h in pp.hits:
            println "  pit hit:", h.id, h.sort
        end
        preq.search_after = pp.hits.get(pp.hits.len() - 1).sort
        pp = opensearch.SearchWith(c, "books", preq)
    end
    println "next page asked with:", fake.Last()
    println "open pits:", opensearch.ListPits(c)
    println "delete pit:", opensearch.DeletePit(c, pit), fake.Last()
    println "delete all pits:", opensearch.DeleteAllPits(c)

    mut bodies := Vector {} as Vector<str>
    bodies.push(`{"query":{"term":{"author":"Saadi"}},"size":0}`)
    bodies.push("{\n  \"size\": 0\n}")
    each m in opensearch.MSearch(c, "books", bodies):
        println "msearch:", m.ok, m.status, m.total, m.error
    end
    println "  sent:", fake.Last()

    hits("stored template", opensearch.SearchTemplate(c, "books", "by_author", `{"author":"Saadi"}`))
    println "  sent:", fake.Last()
    hits("inline template", opensearch.SearchInlineTemplate(c, "books", `{"query":{"term":{"author":"{{author}}"}}}`, `{"author":"Saadi"}`))
    println "rendered:", opensearch.RenderTemplate(c, `{"query":{"term":{"author":"{{author}}"}}}`, `{"author":"Saadi"}`)
    println "explain:", opensearch.Explain(c, "books", "1", opensearch.Match("title", "shahnameh"))
    println "valid:", opensearch.Validate(c, "books", opensearch.MatchAll()), opensearch.Validate(c, "books", `{"nope":{}}`)
    println "field caps:", opensearch.FieldCaps(c, "books", list("title", "year"))
    println "  sent:", fake.Last()

    p := opensearch.SearchParams {
        routing = "poetry", preference = "_local", search_pipeline = "rerank", search_type = "dfs_query_then_fetch",
        request_cache = "true", allow_partial_search_results = "false", ignore_unavailable = true
    }
    hits("with url settings", opensearch.SearchParamsWith(c, "books", `{"size":0}`, p))
    println "  sent:", fake.Last()

    parsed := opensearch.ParseSearch(`{"took":7,"hits":{"total":42,"max_score":0.5,"hits":[{"_id":"old","_score":0.5,"_source":{}}]}}`)
    hits("old style total", parsed)
    ret 0
end
