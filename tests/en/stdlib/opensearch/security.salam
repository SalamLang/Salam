import db.opensearch

include fake "_fake.salam"

const PORT := 19881

func main:
    fake.On("GET", "/_plugins/_security/authinfo", 200, `{"user":"User [name=admin, backend_roles=[admin], requestedTenant=null]","user_name":"admin","backend_roles":["admin"],"roles":["own_index","all_access"],"tenants":{"global_tenant":true,"admin_tenant":true,"admin":true}}`)
    fake.On("GET", "/_plugins/_security/authinfo", 401, "Unauthorized")
    fake.On("GET", "/_plugins/_security/health", 200, `{"message":null,"mode":"strict","status":"UP"}`)
    fake.On("PUT", "/_plugins/_security/api/roles/books_reader", 201, `{"status":"CREATED","message":"'books_reader' created."}`)
    fake.On("GET", "/_plugins/_security/api/roles/books_reader", 200, `{"books_reader":{"reserved":false,"cluster_permissions":["cluster_composite_ops_ro"],"index_permissions":[{"index_patterns":["books*"],"allowed_actions":["read"]}]}}`)
    fake.On("PUT", "/_plugins/_security/api/internalusers/maryam", 201, `{"status":"CREATED","message":"'maryam' created."}`)
    fake.On("GET", "/_plugins/_security/api/internalusers/maryam", 200, `{"maryam":{"hash":"","reserved":false,"backend_roles":["librarian"],"attributes":{"team":"catalog"}}}`)
    fake.On("GET", "/_plugins/_security/api/internalusers", 200, `{"admin":{"reserved":true},"maryam":{"reserved":false},"reader":{"reserved":false}}`)
    fake.On("PUT", "/_plugins/_security/api/rolesmapping/books_reader", 201, `{"status":"CREATED","message":"'books_reader' created."}`)
    fake.On("GET", "/_plugins/_security/api/rolesmapping/books_reader", 200, `{"books_reader":{"users":["maryam"],"backend_roles":["librarian"]}}`)
    fake.On("PUT", "/_plugins/_security/api/account", 200, `{"status":"OK","message":"'maryam' updated."}`)
    fake.On("PUT", "/_plugins/_security/api/account", 403, `{"status":"FORBIDDEN","message":"Could not validate your current password."}`)
    fake.On("DELETE", "/_plugins/_security/api/rolesmapping/books_reader", 200, `{"status":"OK","message":"'books_reader' deleted."}`)
    fake.On("DELETE", "/_plugins/_security/api/internalusers/maryam", 200, `{"status":"OK","message":"'maryam' deleted."}`)
    fake.On("DELETE", "/_plugins/_security/api/roles/books_reader", 200, `{"status":"OK","message":"'books_reader' deleted."}`)
    if not fake.Start(PORT):
        println "fake server failed to start"
        ret 1
    end
    c := opensearch.ConnectAuth("http://127.0.0.1:19881", "admin", "Admin-Pass-1!")

    me := opensearch.WhoAmI(c)
    println "who am i:", me.ok, me.user, me.roles, me.backend_roles, me.tenants
    nobody := opensearch.WhoAmI(c)
    println "wrong password:", nobody.ok, nobody.error
    println "plugin status:", opensearch.SecurityHealth(c)

    mut cluster := Vector {} as Vector<str>
    cluster.push("cluster_composite_ops_ro")
    mut indices := Vector {} as Vector<str>
    indices.push("books*")
    mut actions := Vector {} as Vector<str>
    actions.push("read")
    role := opensearch.RoleBody(cluster, indices, actions)
    println "role body:", role
    println "role:", opensearch.PutRole(c, "books_reader", role), opensearch.JsonPath(opensearch.GetRole(c, "books_reader"), "index_permissions.0.index_patterns.0")

    mut backend := Vector {} as Vector<str>
    backend.push("librarian")
    println "user:", opensearch.PutUser(c, "maryam", "Strong-Pass-1!", backend, `{"team":"catalog"}`)
    println "  sent:", fake.Last()
    println "  stored:", opensearch.GetUser(c, "maryam")
    println "users:", opensearch.Users(c)
    mut users := Vector {} as Vector<str>
    users.push("maryam")
    println "mapping:", opensearch.PutRoleMapping(c, "books_reader", users, backend)
    println "  sent:", fake.Last()
    println "  stored:", opensearch.GetRoleMapping(c, "books_reader")
    println "change password:", opensearch.ChangePassword(c, "Strong-Pass-1!", "Stronger-Pass-2!")
    println "  sent:", fake.Last()
    println "wrong current password:", opensearch.ChangePassword(c, "guess", "x"), opensearch.Status(c), opensearch.Error(c)
    println "cleanup:", opensearch.DeleteRoleMapping(c, "books_reader"), opensearch.DeleteUser(c, "maryam"), opensearch.DeleteRole(c, "books_reader")
    ret 0
end
