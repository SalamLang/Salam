import db.opensearch

func show(headers: str):
    each line in headers.split("\r\n"):
        if line.len() > 0: println "  " + line end
    end
end

func main:
    println "AWS reference request (GET /, no body):"
    show(opensearch.SignRequest(
        "GET", "example.amazonaws.com", "/", "", "us-east-1", "service",
        "AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", "", 1440938160 as i64
    ))
    println "search on a domain, with a query string, a body and a session token:"
    show(opensearch.SignRequest(
        "POST", "search-books.eu-west-1.es.amazonaws.com", "/books/_search?size=5&q=title:shah", `{"query":{"match_all":{}}}`,
        "eu-west-1", opensearch.SERVICE_ES, "AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", "SESSIONTOKEN", 1700000000 as i64
    ))
    println "serverless collection:"
    show(opensearch.SignRequest(
        "PUT", "abc123.eu-west-1.aoss.amazonaws.com", "/books/_doc/1", `{"title":"Shahnameh"}`,
        "eu-west-1", opensearch.SERVICE_AOSS, "AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", "", 1700000000 as i64
    ))
end
