import db.opensearch

include fake "_fake.salam"

mut PORT := 0

func main:
    fake.On("POST", "/_plugins/_sql", 200, `title,year\nShahnameh,1010\n`)
    fake.On("POST", "/_plugins/_sql", 500, `{"error":"boom"}`)
    fake.On("POST", "/_plugins/_ppl", 200, `{"schema":[{"name":"genre","type":"string"}],"datarows":[["epic"]]}`)
    PORT = fake.StartFree()
    if PORT == 0:
        println "fake server failed to start"
        ret 1
    end
    c := opensearch.Connect("http://127.0.0.1:" + PORT)

    println opensearch.SqlFormat(c, "SELECT title, year FROM books", "csv")
    println "sql sent:", fake.Last()
    println "failed:", opensearch.SqlFormat(c, "SELECT 1", "json").len()

    println opensearch.PplFormat(c, "source=books | fields genre", "jdbc")
    println "ppl sent:", fake.Last()
    ret 0
end
