package main

import fs.path
import io
import os
import os.process

func main:
    dir := path.Join(os.TempDir(), "salam_os_api_test")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    file := path.Join(dir, "data.txt")
    io.WriteFile(file, "twelve bytes")
    println "file size: ", os.FileSize(file)
    println "missing size: ", os.FileSize(path.Join(dir, "absent.txt"))
    io.WriteFile(file, "")
    println "empty size: ", os.FileSize(file)
    io.WriteFile(file, "twelve bytes")

    start := os.Cwd()
    println "chdir into dir: ", os.Chdir(dir)
    println "relative file visible: ", os.Exists("data.txt")
    println "relative size: ", os.FileSize("data.txt")
    println "cwd changed: ", os.Cwd() != start
    println "chdir back: ", os.Chdir(start)
    println "cwd restored: ", os.Cwd() == start
    println "relative file gone: ", os.Exists("data.txt")
    println "chdir missing: ", os.Chdir(path.Join(dir, "absent")) != 0
    println "cwd unchanged after failure: ", os.Cwd() == start

    pid := process.Fork()
    if pid == 0:
        os.Abort()
    end
    if pid < 0:
        println "fork unavailable"
    else:
        println "abort status: ", process.WaitPid(pid)
    end
    os.RemoveAll(dir)
    ret 0
end
