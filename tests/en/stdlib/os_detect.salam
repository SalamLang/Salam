if SALAM_OS_WINDOWS:
    const PATH_SEP := "\\"
    const NULL_DEV := "NUL"
    const SO_EXT := ".dll"
else SALAM_OS_MAC:
    const PATH_SEP := "/"
    const NULL_DEV := "/dev/null"
    const SO_EXT := ".dylib"
else SALAM_OS_UNIX:
    const PATH_SEP := "/"
    const NULL_DEV := "/dev/null"
    const SO_EXT := ".so"
else:
    const PATH_SEP := "/"
    const NULL_DEV := "/dev/null"
    const SO_EXT := ".so"
end

func main:
    switch SALAM_OS:
        "windows":
            println "Running on Windows"
            break
        end
        "mac":
            println "Running on macOS"
            break
        end
        "linux":
            println "Running on Linux"
            break
        end
        "freebsd":
            println "Running on FreeBSD"
            break
        end
        "android":
            println "Running on Android"
            break
        end
        "wasm":
            println "Running on WebAssembly"
            break
        end
        else:
            println "Running on an unknown OS"
        end
    end
    switch SALAM_OS:
        "windows", "mac", "linux":
            println "OS string: " + SALAM_OS
            break
        end
    end
    switch SALAM_ARCH:
        "x64":
            println "Architecture: x86-64"
            break
        end
        "arm64":
            println "Architecture: AArch64"
            break
        end
        "x86":
            println "Architecture: x86 (32-bit)"
            break
        end
        "arm":
            println "Architecture: ARM (32-bit)"
            break
        end
        "wasm":
            println "Architecture: WebAssembly"
            break
        end
    end
    if SALAM_ARCH == "x64":
        println "64-bit x86 confirmed"
    end
    if SALAM_OS_UNIX:
        println "POSIX-compatible system"
    end
    if !SALAM_OS_WINDOWS:
        println "not Windows"
    end
    println "Path separator:", PATH_SEP
    println "Shared-library extension:", SO_EXT
end
