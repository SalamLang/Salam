package main

import testing
import os.error
import os

func main:
    testing.AssertFalse(error.HasError())
    testing.AssertEqInt(error.LastCode(), error.None)
    testing.AssertEqStr(error.LastMessage(), "")

    error.Set(error.FileNotFound, "no such file", "Open", "/tmp/x.txt", 2)
    testing.AssertTrue(error.HasError())
    testing.AssertEqInt(error.LastCode(), error.FileNotFound)
    testing.AssertEqStr(error.LastMessage(), "no such file")
    e := error.Last()
    testing.AssertEqInt(e.code, error.FileNotFound)
    testing.AssertEqStr(e.message, "no such file")
    testing.AssertEqStr(e.operation, "Open")
    testing.AssertEqStr(e.path, "/tmp/x.txt")
    testing.AssertEqInt(e.system_code, 2)

    error.Clear()
    testing.AssertFalse(error.HasError())
    testing.AssertEqInt(error.LastCode(), error.None)
    testing.AssertEqStr(error.LastMessage(), "")
    e2 := error.Last()
    testing.AssertEqStr(e2.operation, "")
    testing.AssertEqStr(e2.path, "")
    testing.AssertEqInt(e2.system_code, 0)

    error.Set(error.ProcessFailed, "spawn failed", "Start", "/bin/nope", 127)
    testing.AssertTrue(error.HasError())
    testing.AssertEqInt(error.LastCode(), error.ProcessFailed)
    testing.AssertEqStr(error.LastMessage(), "spawn failed")

    testing.AssertEqInt(error.None, 0)
    testing.AssertNeInt(error.FileNotFound, error.None)
    testing.AssertNeInt(error.PermissionDenied, error.FileNotFound)
    testing.AssertNeInt(error.AlreadyExists, error.PermissionDenied)
    testing.AssertNeInt(error.InvalidPath, error.AlreadyExists)
    testing.AssertNeInt(error.NotSupported, error.InvalidPath)
    testing.AssertNeInt(error.IOError, error.NotSupported)
    testing.AssertNeInt(error.Timeout, error.IOError)
    testing.AssertNeInt(error.ProcessFailed, error.Timeout)

    error.Clear()
    testing.AssertFalse(error.HasError())

    os.Exit(testing.Summary())
end
