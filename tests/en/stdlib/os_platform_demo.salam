package main

import testing
import os.platform
import os

func main:
    if SALAM_OS_WINDOWS:
        testing.AssertTrue(platform.IsWindows())
        testing.AssertEqStr(platform.OS(), "windows")
        testing.AssertFalse(platform.IsMac())
        testing.AssertFalse(platform.IsLinux())
        testing.AssertFalse(platform.IsBSD())
        testing.AssertFalse(platform.IsFreeBSD())
        testing.AssertFalse(platform.IsAndroid())
        testing.AssertFalse(platform.IsWasm())
    else SALAM_OS_MAC:
        testing.AssertTrue(platform.IsMac())
        testing.AssertEqStr(platform.OS(), "mac")
        testing.AssertFalse(platform.IsWindows())
        testing.AssertFalse(platform.IsLinux())
    else SALAM_OS_LINUX:
        testing.AssertTrue(platform.IsLinux())
        testing.AssertEqStr(platform.OS(), "linux")
        testing.AssertFalse(platform.IsWindows())
        testing.AssertFalse(platform.IsMac())
    end

    arch := platform.Arch()
    testing.AssertTrue(arch.len() > 0)
    if SALAM_ARCH_X64:
        testing.AssertTrue(platform.IsX64())
        testing.AssertEqStr(arch, "x64")
        testing.AssertFalse(platform.IsArm64())
        testing.AssertFalse(platform.IsX86())
        testing.AssertFalse(platform.IsArm())
    else SALAM_ARCH_ARM64:
        testing.AssertTrue(platform.IsArm64())
        testing.AssertEqStr(arch, "arm64")
    else SALAM_ARCH_X86:
        testing.AssertTrue(platform.IsX86())
        testing.AssertEqStr(arch, "x86")
    else SALAM_ARCH_ARM:
        testing.AssertTrue(platform.IsArm())
        testing.AssertEqStr(arch, "arm")
    end

    testing.AssertTrue(platform.CpuCount() > 0)
    testing.AssertEqInt(platform.CpuCount(), platform.CpuCount())

    os.Exit(testing.Summary())
end
