package main

import os.platform

func main:
    total := platform.TotalMemory()
    avail := platform.AvailableMemory()
    println "total known: ", total > 0
    println "available known or unsupported: ", avail == -1 or avail > 0
    println "available fits in total: ", avail == -1 or avail <= total
end
