import os
import os.process

func main:
    println "self", process.Alive(os.Pid())
    println "bad", process.Alive(0), process.Alive(-5), process.Alive(999999999)
    c := process.NewCommand("/bin/true")
    if process.IsElevated() and not process.IsElevated():
        println process.RunElevated(c.program, c.args, "test", 1000)
    end
    println "done", c.args.Len()
end
