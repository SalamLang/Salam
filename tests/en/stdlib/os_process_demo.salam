package main

import testing
import os.process
import os.error
import os

func main:
    mut silent_exe := ""
    silent_args := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        silent_exe = "C:\\Windows\\System32\\cmd.exe"
        silent_args.push("/c")
        silent_args.push("REM")
    else:
        silent_exe = "/bin/true"
    end

    mut p1 := process.Start(silent_exe, silent_args)
    testing.AssertTrue(p1.pid > 0)
    testing.AssertTrue(process.IsRunning(p1))
    code1 := process.Wait(p1)
    testing.AssertEqInt(code1, 0)
    testing.AssertFalse(process.IsRunning(p1))
    testing.AssertEqInt(process.ExitCode(p1), 0)
    testing.AssertEqInt(process.Pid(p1), p1.pid)
    testing.AssertFalse(process.IsRunning(p1))

    mut whoami_exe := ""
    whoami_args := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        whoami_exe = "C:\\Windows\\System32\\whoami.exe"
    else:
        whoami_exe = "/usr/bin/whoami"
    end

    mut p2 := process.StartCaptured(whoami_exe, whoami_args)
    testing.AssertTrue(p2.pid > 0)
    code2 := process.Wait(p2)
    testing.AssertEqInt(code2, 0)
    out := process.ReadStdout(p2)
    testing.AssertTrue(out.len() > 0)
    err2 := process.ReadStderr(p2)
    testing.AssertEqInt(err2.len(), 0)
    // Capture is file-backed, so the reads are repeatable and independent of
    // Wait; Cleanup is what actually drops the two temp files.
    testing.AssertEqInt(process.ReadStdout(p2).len(), out.len())
    process.Cleanup(p2)
    testing.AssertEqInt(process.ReadStdout(p2).len(), 0)

    mut fail_exe := ""
    fail_args := Vector {} as Vector<str>
    mut expected_fail_code := 0
    if SALAM_OS_WINDOWS:
        fail_exe = "C:\\Windows\\System32\\cmd.exe"
        fail_args.push("/c")
        fail_args.push("exit")
        fail_args.push("3")
        expected_fail_code = 3
    else:
        fail_exe = "/bin/false"
        expected_fail_code = 1
    end
    mut p3 := process.Start(fail_exe, fail_args)
    testing.AssertTrue(p3.pid > 0)
    code3 := process.Wait(p3)
    testing.AssertEqInt(code3, expected_fail_code)
    testing.AssertEqInt(process.ExitCode(p3), expected_fail_code)

    error.Clear()
    mut bad_exe := ""
    if SALAM_OS_WINDOWS:
        bad_exe = "C:\\Windows\\System32\\definitely_not_a_real_exe_xyz.exe"
    else:
        bad_exe = "/definitely/not/a/real/exe/xyz"
    end
    bad_args := Vector {} as Vector<str>
    p4 := process.Start(bad_exe, bad_args)
    testing.AssertTrue(p4.pid <= 0)
    testing.AssertFalse(process.IsRunning(p4))
    testing.AssertTrue(error.HasError())
    testing.AssertEqInt(error.LastCode(), error.ProcessFailed)

    mut long_exe := ""
    long_args := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        long_exe = "C:\\Windows\\System32\\PING.EXE"
        long_args.push("-n")
        long_args.push("30")
        long_args.push("127.0.0.1")
    else:
        long_exe = "/bin/sleep"
        long_args.push("30")
    end

    mut p5 := process.StartCaptured(long_exe, long_args)
    testing.AssertTrue(p5.pid > 0)
    testing.AssertTrue(process.IsRunning(p5))
    rc5 := process.Kill(p5)
    testing.AssertEqInt(rc5, 0)
    testing.AssertFalse(process.IsRunning(p5))
    process.Cleanup(p5)

    mut p6 := process.StartCaptured(long_exe, long_args)
    testing.AssertTrue(p6.pid > 0)
    rc6 := process.Terminate(p6)
    testing.AssertEqInt(rc6, 0)
    testing.AssertFalse(process.IsRunning(p6))
    process.Cleanup(p6)

    os.Exit(testing.Summary())
end
