package main

import os.process

func main:
    pid := process.Fork()
    if pid == 0:
        process.ExitNow(7)
    end
    if pid < 0:
        println "fork unavailable"
        ret 0
    end
    println "child exit:", process.WaitPid(pid)
    println "bad pid   :", process.WaitPid(0)
    ret 0
end
