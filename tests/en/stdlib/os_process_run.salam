package main

import os.process

if not SALAM_OS_WINDOWS:
    import mem
    import str
end

func args2(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push(a)
    v.Push(b)
    ret v
end

func show(label: str, r: process.RunResult):
    println label, "started", r.started, "exited", r.status.exited, "code", r.status.code, "signaled", r.status.signaled, "signal", r.status.signal, "timed_out", r.timed_out
end

func main:
    if SALAM_OS_WINDOWS:
        println "skipped on Windows"
    else:
        a1 := args2("-c", "echo out; echo err 1>&2; exit 3")
        mut r1 := process.RunTimeout("sh", a1, "", 5000)
        show("basic", r1)
        println "stdout", r1.stdout.Len(), "stderr", r1.stderr.Len()
        r1.Free()
        a1.Free()

        a2 := args2("-c", "tr a-z A-Z")
        mut r2 := process.RunTimeout("sh", a2, "shout this\n", 5000)
        show("filter", r2)
        println "reply", r2.stdout
        r2.Free()
        a2.Free()

        a3 := args2("-c", "head -c 1048576 /dev/zero | tr '\\0' 'x'; head -c 1048576 /dev/zero | tr '\\0' 'y' 1>&2")
        mut r3 := process.RunTimeout("sh", a3, "", 20000)
        show("big", r3)
        println "stdout bytes", r3.stdout.Len(), "stderr bytes", r3.stderr.Len()
        r3.Free()
        a3.Free()

        mut big := process.NewCommand("cat")
        mut sb := str.NewBuilder()
        repeat 2000:
            str.BufAppend(sb, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n")
        end
        text := str.BufStr(sb)
        str.BufFree(sb)
        mut r4 := process.RunCommand(big, text, 20000)
        show("echo", r4)
        println "round trip bytes", r4.stdout.Len(), r4.stdout == text
        r4.Free()
        big.Free()
        mem.Free(text as void*)

        a5 := args2("-c", "echo before; sleep 30; echo after")
        mut r5 := process.RunTimeout("sh", a5, "", 400)
        show("timeout", r5)
        println "partial", r5.stdout
        println "return code", r5.status.ReturnCode()
        r5.Free()
        a5.Free()

        mut r6 := process.RunTimeout("definitely-not-a-program-here", Vector {} as Vector<str>, "", 1000)
        show("missing", r6)
        r6.Free()

        a7 := args2("-c", "echo $MARK")
        mut c7 := process.NewCommand("sh")
        c7.args = a7
        c7.Env("MARK", "set")
        mut r7 := process.RunCommand(c7, "", 5000)
        show("command", r7)
        println "text", r7.stdout
        r7.Free()
        c7.Free()
        ret 0
    end
end
