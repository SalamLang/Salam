import str
import os
import os.secret
import crypto

func main:
    mut passed := true
    key := "probe-" + str.FromInt(os.Pid() as i64) + "-" + crypto.RandomHex(4)
    if secret.Available() and secret.Set("salam.test.secret", key, "first value"):
        passed = secret.Get("salam.test.secret", key) == "first value"
        passed = passed and secret.Set("salam.test.secret", key, "دوم")
        passed = passed and secret.Get("salam.test.secret", key) == "دوم"
        passed = passed and secret.Delete("salam.test.secret", key)
    end
    println "round trip", passed
    println "missing", secret.Get("salam.test.secret", key + "-missing").Len()
    println "delete missing", secret.Delete("salam.test.secret", key + "-missing")
end
