package main

import testing
import os.shell
import os

func main:
    mut exe := ""
    args := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        exe = "C:\\Windows\\System32\\whoami.exe"
    else:
        exe = "/usr/bin/whoami"
    end

    r := shell.Run(exe, args)
    testing.AssertEqInt(r.code, 0)
    testing.AssertTrue(r.out.len() > 0)
    testing.AssertEqInt(r.err.len(), 0)

    r2 := shell.Exec(exe)
    testing.AssertEqInt(r2.code, 0)
    testing.AssertTrue(r2.out.len() > 0)

    mut fail_cmd := ""
    mut expected_fail_code := 0
    if SALAM_OS_WINDOWS:
        fail_cmd = "C:\\Windows\\System32\\cmd.exe"
        expected_fail_code = 3
    else:
        fail_cmd = "/bin/false"
        expected_fail_code = 1
    end
    fail_args := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        fail_args.push("/c")
        fail_args.push("exit")
        fail_args.push("3")
    end
    r3 := shell.Run(fail_cmd, fail_args)
    testing.AssertEqInt(r3.code, expected_fail_code)

    mut bad_exe := ""
    if SALAM_OS_WINDOWS:
        bad_exe = "C:\\Windows\\System32\\definitely_not_a_real_exe_xyz.exe"
    else:
        bad_exe = "/definitely/not/a/real/exe/xyz"
    end
    bad_args := Vector {} as Vector<str>
    r4 := shell.Run(bad_exe, bad_args)
    testing.AssertEqInt(r4.code, 0 - 1)

    r5 := shell.Exec(bad_exe)
    testing.AssertEqInt(r5.code, 0 - 1)

    os.Exit(testing.Summary())
end
