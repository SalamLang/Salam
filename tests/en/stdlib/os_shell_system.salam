package main

import os.shell
import sync
import thread

const WORKERS := 4

mut failures := 0
mut lock := sync.Mutex {}

func worker():
    repeat 5:
        if shell.System("exit 0") != 0:
            sync.Lock(lock)
            failures += 1
            sync.Unlock(lock)
        end
    end
end

func main:
    println "exit 0        :", shell.System("exit 0")
    println "exit 3        :", shell.System("exit 3")
    println "missing cmd   :", shell.System("definitely_not_a_real_cmd_xyz 2>" + (SALAM_OS_WINDOWS ? "NUL" : "/dev/null")) != 0

    lock = sync.NewMutex()
    mut group := Vector {} as Vector<thread.Thread>
    defer group.free()
    repeat WORKERS:
        group = thread.Collect(group, spawn(worker))
    end
    thread.JoinAll(group)
    println "threaded fails:", failures
    sync.Destroy(lock)
    ret 0
end
