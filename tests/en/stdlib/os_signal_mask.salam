import testing
import mem
import os.signal

mut _child_blocked := false

func blocker():
    set := signal.NewWinchSet()
    if set == null: ret end
    _ := signal.Block(set)
    mem.Free(set)
    mask := signal.CurrentMask()
    _child_blocked = signal.IsSignal(mask, signal.WinchSignal)
    mem.Free(mask)
end

func test_mask_is_per_thread():
    before := signal.CurrentMask()
    testing.AssertNotNil(before)
    join(spawn(blocker))
    testing.AssertTrue(_child_blocked)
    after := signal.CurrentMask()
    testing.AssertNotNil(after)
    testing.AssertTrue(not signal.IsSignal(after, signal.WinchSignal))
    testing.AssertEqBool(signal.IsSignal(after, signal.WinchSignal), signal.IsSignal(before, signal.WinchSignal))
    testing.AssertEqBool(signal.IsSignal(after, 15), signal.IsSignal(before, 15))
    mem.Free(after)
    mem.Free(before)
end

func main:
    if SALAM_OS_WINDOWS:
        println "signals are POSIX only"
        ret 0
    else:
        test_mask_is_per_thread()
        ret testing.Summary()
    end
end
