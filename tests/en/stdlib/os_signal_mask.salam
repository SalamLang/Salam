// Proves the mask is the thread's business, not the process's: a child thread
// blocks SIGWINCH and the main thread must still see it unblocked. Under a
// process-wide sigprocmask the child's block shows up in main's mask and this
// fails; signal_test's inheritance test cannot catch that, because it blocks
// first and only ever looks at the child.

import testing
import mem

import os.signal

// Written by the blocker thread, read by main after join (which orders the
// two), so no locking is needed. It records what the child saw from inside,
// because only the child can report its own mask.
mut _child_blocked := false

func blocker():
    set := signal.NewWinchSet()
    if set == null: ret end
    _ := signal.Block(set)
    mem.Free(set)
    mask := signal.CurrentMask()
    _child_blocked = signal.IsSignal(mask, signal.WinchSignal)
    mem.Free(mask)
end

func test_mask_is_per_thread():
    before := signal.CurrentMask()
    testing.AssertNotNil(before)
    // The child exits with its own mask blocked, which is harmless: the mask
    // dies with the thread.
    join(spawn(blocker))
    testing.AssertTrue(_child_blocked)
    after := signal.CurrentMask()
    testing.AssertNotNil(after)
    // Main was never touched by the child's block, so SIGWINCH is not in its
    // mask: the mirror image of the child's own reading above.
    testing.AssertTrue(not signal.IsSignal(after, signal.WinchSignal))
    // And the mask is exactly what it was before the spawn.
    testing.AssertEqBool(signal.IsSignal(after, signal.WinchSignal), signal.IsSignal(before, signal.WinchSignal))
    testing.AssertEqBool(signal.IsSignal(after, 15), signal.IsSignal(before, 15))
    mem.Free(after)
    mem.Free(before)
end

func main:
    if SALAM_OS_WINDOWS:
        println "signals are POSIX only"
        ret 0
    else:
        test_mask_is_per_thread()
        ret testing.Summary()
    end
end
