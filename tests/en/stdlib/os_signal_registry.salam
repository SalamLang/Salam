import testing
import mem
import os.signal

extern:
    func sigaction(sig: int, act: void*, old: void*): int
end

func noop_a(_sig: int):
    _ := _sig
end

func noop_b(_sig: int):
    _ := _sig
end

func live_handler(sig: int): u64:
    buf := mem.AllocateZeroed(256 as u64)
    if buf == null: ret 0 end
    _ := sigaction(sig, null, buf)
    handler := (buf as u64*)[0]
    mem.Free(buf)
    ret handler
end

func test_refcount_round_trip():
    before := signal.CurrentMask()
    testing.AssertNotNil(before)
    first := signal.Install(signal.WinchSignal, &noop_a)
    testing.AssertNotNil(first)
    second := signal.Install(signal.WinchSignal, &noop_a)
    testing.AssertNotNil(second)
    testing.AssertTrue(first != second)
    testing.AssertTrue(signal.Restore(signal.WinchSignal, second))
    held := signal.CurrentMask()
    testing.AssertTrue(signal.IsSignal(held, signal.WinchSignal))
    testing.AssertTrue(live_handler(signal.WinchSignal) == (&noop_a) as u64)
    testing.AssertTrue(signal.Restore(signal.WinchSignal, first))
    after := signal.CurrentMask()
    testing.AssertEqBool(
        signal.IsSignal(after, signal.WinchSignal), signal.IsSignal(before, signal.WinchSignal)
    )
    testing.AssertEqInt64(live_handler(signal.WinchSignal) as i64, 0)
    testing.AssertTrue(signal.Restore(signal.WinchSignal, first))
    mem.Free(held)
    mem.Free(after)
    mem.Free(second)
    mem.Free(first)
    mem.Free(before)
end

func test_restore_order_is_free():
    first := signal.Install(signal.WinchSignal, &noop_a)
    testing.AssertNotNil(first)
    second := signal.Install(signal.WinchSignal, &noop_a)
    testing.AssertNotNil(second)
    testing.AssertTrue(signal.Restore(signal.WinchSignal, first))
    mid := signal.CurrentMask()
    testing.AssertTrue(signal.IsSignal(mid, signal.WinchSignal))
    mem.Free(mid)
    testing.AssertTrue(signal.Restore(signal.WinchSignal, second))
    after := signal.CurrentMask()
    testing.AssertTrue(not signal.IsSignal(after, signal.WinchSignal))
    testing.AssertEqInt64(live_handler(signal.WinchSignal) as i64, 0)
    testing.AssertTrue(signal.Restore(signal.WinchSignal, second))
    again := signal.CurrentMask()
    testing.AssertTrue(not signal.IsSignal(again, signal.WinchSignal))
    mem.Free(again)
    mem.Free(after)
    mem.Free(second)
    mem.Free(first)
end

func test_different_handler_refused():
    first := signal.Install(signal.WinchSignal, &noop_a)
    testing.AssertNotNil(first)
    second := signal.Install(signal.WinchSignal, &noop_b)
    testing.AssertTrue(second == null)
    testing.AssertTrue(live_handler(signal.WinchSignal) == (&noop_a) as u64)
    held := signal.CurrentMask()
    testing.AssertTrue(signal.IsSignal(held, signal.WinchSignal))
    testing.AssertTrue(signal.Restore(signal.WinchSignal, first))
    after := signal.CurrentMask()
    testing.AssertTrue(not signal.IsSignal(after, signal.WinchSignal))
    testing.AssertEqInt64(live_handler(signal.WinchSignal) as i64, 0)
    mem.Free(held)
    mem.Free(after)
    mem.Free(first)
end

func test_rebuild_after_zero():
    prev := signal.Install(signal.WinchSignal, &noop_a)
    testing.AssertNotNil(prev)
    if prev == null:
        ret
    end
    testing.AssertEqInt64((prev as u64*)[0] as i64, 0)
    testing.AssertTrue(signal.Restore(signal.WinchSignal, prev))
    mask := signal.CurrentMask()
    testing.AssertTrue(not signal.IsSignal(mask, signal.WinchSignal))
    mem.Free(mask)
    mem.Free(prev)
end

func main:
    if SALAM_OS_WINDOWS:
        println "signals are POSIX only"
        ret 0
    else:
        test_refcount_round_trip()
        test_restore_order_is_free()
        test_different_handler_refused()
        test_rebuild_after_zero()
        ret testing.Summary()
    end
end
