import testing
import mem
import time
import os.signal

func raiser():
    start := time.MonoNanos()
    mut spin := 0
    until time.MonoNanos() - start < (20000000 as i64):
        spin++
    end
    _ := spin
    _ := signal.WakeWinch()
end

func test_timeout_expires():
    set := signal.NewWinchSet()
    testing.AssertNotNil(set)
    out := mem.AllocateZeroed(8 as u64)
    testing.AssertNotNil(out)
    start := time.MonoNanos()
    status := signal.WaitTimeout(set, out, 100)
    elapsed := time.SinceMs(start)
    testing.AssertEqInt(status, signal.WaitTimedOut)
    testing.AssertTrue(elapsed >= 80.0)
    testing.AssertTrue(elapsed < 5000.0)
    testing.AssertEqInt((out as i32*)[0], 0)
    mem.Free(out)
    mem.Free(set)
end

func test_arrival_inside_bound():
    set := signal.NewWinchSet()
    testing.AssertNotNil(set)
    out := mem.AllocateZeroed(8 as u64)
    testing.AssertNotNil(out)
    a := spawn(raiser)
    start := time.MonoNanos()
    status := signal.WaitTimeout(set, out, 5000)
    elapsed := time.SinceMs(start)
    join(a)
    testing.AssertEqInt(status, signal.WaitArrived)
    testing.AssertEqInt((out as i32*)[0], signal.WinchSignal)
    testing.AssertTrue(elapsed < 4000.0)
    mem.Free(out)
    mem.Free(set)
end

func test_zero_is_a_probe():
    set := signal.NewWinchSet()
    testing.AssertNotNil(set)
    out := mem.AllocateZeroed(8 as u64)
    testing.AssertNotNil(out)
    (out as i32*)[0] = 99
    testing.AssertEqInt(signal.WaitTimeout(set, out, 0), signal.WaitTimedOut)
    testing.AssertEqInt((out as i32*)[0], 99)
    mem.Free(out)
    mem.Free(set)
end

func test_negative_bound_is_invalid():
    set := signal.NewWinchSet()
    testing.AssertNotNil(set)
    out := mem.AllocateZeroed(8 as u64)
    testing.AssertNotNil(out)
    testing.AssertEqInt(signal.WaitTimeout(set, out, -1), signal.WaitInvalid)
    testing.AssertEqInt((out as i32*)[0], 0)
    mem.Free(out)
    mem.Free(set)
end

func main:
    if SALAM_OS_WINDOWS:
        println "signals are POSIX only"
        ret 0
    else:
        signal.InstallWinchHandler()
        signal.BlockWinch()
        test_timeout_expires()
        test_arrival_inside_bound()
        test_zero_is_a_probe()
        test_negative_bound_is_invalid()
        ret testing.Summary()
    end
end
