package main

import testing
import os.temp
import fs.file
import fs.dir
import fs.path
import os

func main:
    f1 := temp.File()
    f2 := temp.File()
    testing.AssertTrue(f1.len() > 0)
    testing.AssertTrue(f2.len() > 0)
    testing.AssertNeStr(f1, f2)
    testing.AssertTrue(file.Exists(f1))
    testing.AssertTrue(file.Exists(f2))

    testing.AssertTrue(file.WriteText(f1, "temp payload") >= 0)
    testing.AssertEqStr(file.ReadText(f1), "temp payload")

    testing.AssertEqInt(temp.Remove(f1), 0)
    testing.AssertFalse(file.Exists(f1))
    testing.AssertEqInt(temp.Remove(f2), 0)
    testing.AssertFalse(file.Exists(f2))

    d1 := temp.Directory()
    d2 := temp.Directory()
    testing.AssertTrue(d1.len() > 0)
    testing.AssertTrue(d2.len() > 0)
    testing.AssertNeStr(d1, d2)
    testing.AssertTrue(dir.Exists(d1))
    testing.AssertTrue(dir.Exists(d2))

    inner := path.Join(d1, "inner.txt")
    file.WriteText(inner, "nested")
    testing.AssertEqStr(file.ReadText(inner), "nested")

    testing.AssertEqInt(temp.RemoveDir(d1), 0)
    testing.AssertFalse(dir.Exists(d1))
    testing.AssertEqInt(temp.RemoveDir(d2), 0)
    testing.AssertFalse(dir.Exists(d2))

    os.Exit(testing.Summary())
end
