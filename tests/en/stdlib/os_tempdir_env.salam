package main

import env
import os
import testing

func check(want: str):
    got := os.TempDir()
    testing.AssertEqStr(got, want)
end

func main:
    env.Set("TEMP", "")
    env.Set("TMP", "")
    env.Set("TMPDIR", "")
    check("/tmp")
    env.Set("TMPDIR", "/from/tmpdir")
    check("/from/tmpdir")
    env.Set("TMP", "/from/tmp")
    check("/from/tmp")
    env.Set("TEMP", "/from/temp")
    check("/from/temp")
    testing.Summary()
end
