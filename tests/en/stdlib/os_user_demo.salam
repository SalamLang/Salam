package main

import testing
import os.user
import os

func main:
    testing.AssertTrue(user.Username().len() > 0)
    testing.AssertTrue(user.HomeDir().len() > 0)
    testing.AssertTrue(user.ConfigDir().len() > 0)
    testing.AssertTrue(user.CacheDir().len() > 0)

    testing.AssertEqStr(user.Username(), user.Username())
    testing.AssertEqStr(user.HomeDir(), user.HomeDir())
    testing.AssertEqStr(user.ConfigDir(), user.ConfigDir())
    testing.AssertEqStr(user.CacheDir(), user.CacheDir())
    testing.AssertNeStr(user.ConfigDir(), user.CacheDir())

    if SALAM_OS_WINDOWS:
        testing.AssertEqInt(user.Uid(), 0 - 1)
        testing.AssertEqInt(user.Gid(), 0 - 1)
        testing.AssertEqInt(user.Uid(), user.Uid())
    else:
        testing.AssertTrue(user.Uid() >= 0)
        testing.AssertTrue(user.Gid() >= 0)
        testing.AssertEqInt(user.Uid(), user.Uid())
    end

    os.Exit(testing.Summary())
end
