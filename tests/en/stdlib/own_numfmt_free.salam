import str
import conv
import mem
import testing

func label(n: int): str:
    x := str.FromInt(n as i64)
    ret "n=" + x
end

func main:
    a := str.FromInt(-1234)
    b := str.FromFloat(3.25)
    c := conv.FormatHex(255 as u64)
    d := conv.FormatUint(18446744073709551615 as u64)
    testing.AssertEqStr(a, "-1234")
    testing.AssertEqStr(b, "3.25")
    testing.AssertEqStr(c, "ff")
    testing.AssertEqStr(d, "18446744073709551615")
    mem.Free(a as void*)
    mem.Free(b as void*)
    mem.Free(c as void*)
    mem.Free(d as void*)
    mut t := 0
    repeat 100 in i:
        t += str.Len("v" + str.FromInt(i as i64) + ":" + str.FromFloat(i as f64 + 0.5))
        l := label(i)
        t += str.Len(l)
        mem.Free(l as void*)
    end
    testing.AssertEqInt(t, 1170)
    testing.AssertEqInt(mem.LiveBytes() as int, 0)
    ret testing.Summary()
end
