import str
import testing

func same(a: str, b: str): bool:
    ret str.Equals(a, b)
end

func width(s: str): int:
    ret str.Len(s)
end

func has_prefix(ts: str, pn: str): bool:
    if str.StartsWith(ts, pn + "_"):
        ret true
    end
    ret false
end

func loop_total(n: int): int:
    mut t := 0
    repeat n in i:
        k := i % 2 == 0 ? "even" : "odd"
        if same("k" + k, "keven"):
            t++
        end
        t += width("ab" + k)
        t += width(k + k + "!")
        x := width("p" + k + "q")
        t += x
    end
    ret t
end

func tail_call(a: str, b: str): int:
    ret width(a + b)
end

func first_cond(a: str, b: str): int:
    if str.Len(a + b) > 4:
        ret 1
    end
    ret 0
end

func main:
    testing.AssertTrue(has_prefix("ab_cd", "ab"))
    testing.AssertFalse(has_prefix("ab_cd", "cd"))
    testing.AssertEqInt(loop_total(10), 195)
    testing.AssertEqInt(tail_call("abc", "de"), 5)
    testing.AssertEqInt(first_cond("abc", "de"), 1)
    testing.AssertEqInt(first_cond("a", "b"), 0)
    ret testing.Summary()
end
