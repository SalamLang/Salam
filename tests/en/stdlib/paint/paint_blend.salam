import gui.paint

func layer(mode: paint.BlendMode): u32:
    mut canvas := paint.NewCanvas(8, 8)
    canvas.Clear(paint.Rgb(200, 100, 50))
    canvas.BeginLayer(paint.RectOf(0.0, 0.0, 8.0, 8.0))
    canvas.FillRect(paint.RectOf(0.0, 0.0, 8.0, 8.0), paint.Rgb(100, 200, 150))
    chain := paint.FilterChain {}
    canvas.EndLayerBlend(chain, 1.0, mode)
    pixel := canvas.RawPixel(4, 4)
    canvas.Free()
    ret pixel
end

func main:
    println "normal", layer(paint.BlendMode.Normal)
    println "multiply", layer(paint.BlendMode.Multiply)
    println "screen", layer(paint.BlendMode.Screen)
    println "darken", layer(paint.BlendMode.Darken)
    println "lighten", layer(paint.BlendMode.Lighten)
    println "difference", layer(paint.BlendMode.Difference)
    println "exclusion", layer(paint.BlendMode.Exclusion)
    println "overlay", layer(paint.BlendMode.Overlay)
    println "hard light", layer(paint.BlendMode.HardLight)
    println "luminosity", layer(paint.BlendMode.Luminosity)
end
