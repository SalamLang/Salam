package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    mut b := paint.SolidBorder(4.0, paint.Rgb(0, 0, 200))
    b.left_color = paint.Rgb(200, 0, 0)
    b.left_width = 8.0
    b.bottom_width = 2.0
    cv.DrawBorder(paint.RectOf(2.0, 2.0, 28.0, 20.0), paint.Uniform(0.0), b)
    probe(cv, 4, 10)
    probe(cv, 16, 3)
    probe(cv, 16, 20)
    probe(cv, 28, 10)
    probe(cv, 16, 10)
    probe(cv, 3, 3)
    probe(cv, 9, 3)
    cv.DrawBorder(paint.RectOf(34.0, 2.0, 28.0, 20.0), paint.Uniform(8.0), paint.SolidBorder(3.0, paint.Rgba(0, 120, 0, 200)))
    probe(cv, 34, 2)
    probe(cv, 35, 4)
    probe(cv, 48, 3)
    probe(cv, 48, 12)
    probe(cv, 38, 6)
    mut d := paint.SolidBorder(2.0, paint.Rgb(0, 0, 0))
    d.top_style = paint.BorderStyle.Dashed
    d.bottom_style = paint.BorderStyle.Dotted
    d.left_style = paint.BorderStyle.None
    cv.DrawBorder(paint.RectOf(2.0, 26.0, 40.0, 20.0), paint.Uniform(0.0), d)
    mut top := ""
    repeat 40 in i:
        top += cv.Pixel(2 + i, 26).r < 128 ? "#" : "."
    end
    println "dashed", top
    mut bottom := ""
    repeat 40 in i:
        bottom += cv.Pixel(2 + i, 45).r < 128 ? "#" : "."
    end
    println "dotted", bottom
    probe(cv, 2, 36)
    cv.DrawOutline(paint.RectOf(48.0, 30.0, 10.0, 10.0), paint.Uniform(2.0), 2.0, 1.0, paint.Rgb(255, 100, 0))
    probe(cv, 46, 35)
    probe(cv, 45, 35)
    probe(cv, 47, 35)
    probe(cv, 48, 35)
    println "hash", cv.Hash()
    cv.Free()
end
