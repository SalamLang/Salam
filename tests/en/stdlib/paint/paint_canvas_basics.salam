package main

import gui.paint
import mem

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    println "size", cv.width, cv.height, cv.stride, cv.owned
    println "empty hash", cv.Hash()
    cv.Clear(paint.Rgb(255, 255, 255))
    probe(cv, 0, 0)
    cv.FillRect(paint.RectOf(4.0, 4.0, 20.0, 10.0), paint.Rgb(200, 30, 10))
    probe(cv, 10, 8)
    probe(cv, 3, 8)
    cv.FillRect(paint.RectOf(10.0, 6.0, 20.0, 10.0), paint.Rgba(0, 0, 255, 128))
    probe(cv, 12, 8)
    probe(cv, 26, 8)
    cv.FillRect(paint.RectOf(30.25, 20.5, 10.5, 6.75), paint.Rgb(0, 0, 0))
    probe(cv, 30, 22)
    probe(cv, 31, 20)
    probe(cv, 40, 22)
    probe(cv, 35, 27)
    println "premultiply", paint.Premultiply(paint.Rgba(255, 128, 0, 128))
    u := paint.Unpremultiply(paint.Premultiply(paint.Rgba(200, 100, 50, 77)))
    println "unpremultiply", u.r, u.g, u.b, u.a
    println "raw", cv.RawPixel(12, 8), cv.RawPixel(-1, 0), cv.RawPixel(64, 0)
    mut sub := cv.Sub(paint.IntRectOf(40, 30, 30, 30))
    println "sub", sub.width, sub.height, sub.owned
    sub.FillRect(paint.RectOf(0.0, 0.0, 4.0, 4.0), paint.Rgb(0, 200, 0))
    probe(cv, 41, 31)
    sub.Free()
    println "hash", cv.Hash()
    mem_buf := mem.AllocateZeroed((16 * 8 * 4) as u64)
    mut w := paint.WrapCanvas(mem_buf, 16, 8, 64)
    w.FillRoundedRect(paint.RectOf(0.0, 0.0, 16.0, 8.0), paint.Uniform(4.0), paint.Rgb(10, 20, 30))
    println "wrapped", w.owned, (mem_buf as u32*)[7 * 16 + 8], w.Hash()
    w.Free()
    mem.Free(mem_buf)
    bad := paint.WrapCanvas(null, 4, 4, 16)
    println "bad wrap", bad.width
    cv.Free()
    println "freed", cv.width
end
