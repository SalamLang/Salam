package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    b0 := cv.ClipBounds()
    println "clip", b0.x, b0.y, b0.width, b0.height
    cv.PushClip(paint.RectOf(8.0, 8.0, 20.0, 20.0))
    cv.PushClip(paint.RectOf(16.0, 0.0, 40.0, 40.0))
    b1 := cv.ClipBounds()
    println "nested", b1.x, b1.y, b1.width, b1.height
    cv.FillRect(paint.RectOf(0.0, 0.0, 64.0, 48.0), paint.Rgb(255, 0, 0))
    cv.PopClip()
    probe(cv, 10, 10)
    probe(cv, 16, 10)
    probe(cv, 27, 27)
    probe(cv, 28, 27)
    cv.PopClip()
    cv.PopClip()
    cv.PushRoundedClip(paint.RectOf(32.0, 4.0, 28.0, 28.0), paint.Uniform(14.0))
    cv.FillRect(paint.RectOf(0.0, 0.0, 64.0, 48.0), paint.Rgb(0, 0, 255))
    mut g := paint.LinearGradient(90.0)
    g.AddStop(0.0, paint.Rgb(0, 0, 0))
    g.AddStop(1.0, paint.Rgb(255, 255, 255))
    cv.FillGradient(paint.RectOf(40.0, 0.0, 30.0, 48.0), paint.Uniform(0.0), g)
    g.Free()
    cv.PopClip()
    probe(cv, 32, 4)
    probe(cv, 34, 8)
    probe(cv, 36, 7)
    probe(cv, 46, 18)
    probe(cv, 38, 18)
    probe(cv, 59, 31)
    cv.PushRoundedClip(paint.RectOf(4.0, 30.0, 24.0, 16.0), paint.Uniform(6.0))
    cv.PushRoundedClip(paint.RectOf(12.0, 30.0, 24.0, 16.0), paint.Uniform(6.0))
    cv.FillRect(paint.RectOf(0.0, 0.0, 64.0, 48.0), paint.Rgb(0, 150, 0))
    cv.PopClip()
    cv.PopClip()
    probe(cv, 12, 30)
    probe(cv, 20, 38)
    probe(cv, 27, 45)
    probe(cv, 5, 38)
    cv.PushClip(paint.RectOf(0.0, 0.0, 0.0, 0.0))
    cv.FillRect(paint.RectOf(0.0, 0.0, 64.0, 48.0), paint.Rgb(0, 0, 0))
    cv.PopClip()
    probe(cv, 0, 0)
    println "hash", cv.Hash()
    cv.Free()
end
