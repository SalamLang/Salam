package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func square(cv &: paint.Canvas, x: f64, y: f64, chain: paint.FilterChain):
    cv.BeginFilterLayer(paint.RectOf(x, y, 16.0, 16.0), chain)
    cv.FillRect(paint.RectOf(x, y, 16.0, 16.0), paint.Rgb(200, 60, 20))
    cv.EndLayerFiltered(chain, 1.0)
end

func one(kind: paint.FilterKind, amount: f64): paint.FilterChain:
    mut c := paint.FilterChain {}
    c.Add(paint.NewFilter(kind, amount))
    ret c
end

func main:
    mut cv := paint.NewCanvas(200, 80)
    cv.Clear(paint.Rgb(255, 255, 255))
    kinds := [paint.FilterKind.Brightness, paint.FilterKind.Contrast, paint.FilterKind.Grayscale, paint.FilterKind.Sepia, paint.FilterKind.Saturate, paint.FilterKind.HueRotate, paint.FilterKind.Invert, paint.FilterKind.Opacity]
    amounts := [1.5, 0.5, 1.0, 1.0, 2.0, 90.0, 1.0, 0.5]
    repeat 8 in i:
        mut c := one(kinds[i], amounts[i])
        square(cv, 4.0 + (i as f64) * 22.0, 4.0, c)
        probe(cv, 12 + i * 22, 12)
        c.Free()
    end
    mut blur := one(paint.FilterKind.Blur, 3.0)
    println "blur extent", blur.Extent(), "empty", blur.IsEmpty(), paint.FilterChain {}.IsEmpty()
    square(cv, 10.0, 40.0, blur)
    probe(cv, 18, 48)
    probe(cv, 10, 48)
    probe(cv, 6, 48)
    blur.Free()
    mut ds := paint.FilterChain {}
    ds.Add(paint.DropShadowFilter(4.0, 4.0, 2.0, paint.Rgba(0, 0, 0, 200)))
    println "shadow extent", ds.Extent()
    square(cv, 50.0, 40.0, ds)
    probe(cv, 58, 48)
    probe(cv, 68, 60)
    ds.Free()
    cv.FillRect(paint.RectOf(100.0, 40.0, 4.0, 30.0), paint.Rgb(0, 0, 0))
    cv.FillRect(paint.RectOf(112.0, 40.0, 4.0, 30.0), paint.Rgb(0, 0, 0))
    mut bd := one(paint.FilterKind.Blur, 2.0)
    bd.Add(paint.NewFilter(paint.FilterKind.Brightness, 1.2))
    cv.BackdropFilter(paint.RectOf(96.0, 44.0, 24.0, 20.0), paint.Uniform(6.0), bd)
    bd.Free()
    probe(cv, 102, 54)
    probe(cv, 108, 54)
    probe(cv, 102, 42)
    cv.FillRect(paint.RectOf(130.0, 40.0, 20.0, 30.0), paint.Rgb(0, 0, 0))
    mut inv := one(paint.FilterKind.Invert, 1.0)
    cv.BackdropFilter(paint.RectOf(124.0, 44.0, 32.0, 20.0), paint.Uniform(0.0), inv, 0.5)
    inv.Free()
    probe(cv, 126, 54)
    probe(cv, 140, 54)
    println "hash", cv.Hash()
    cv.Free()
end
