package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    mut g := paint.LinearGradient(90.0)
    g.AddStop(0.0, paint.Rgb(255, 0, 0))
    g.AddStop(-1.0, paint.Rgb(0, 255, 0))
    g.AddStop(1.0, paint.Rgb(0, 0, 255))
    cv.FillGradient(paint.RectOf(0.0, 0.0, 32.0, 8.0), paint.Uniform(0.0), g)
    probe(cv, 0, 4)
    probe(cv, 8, 4)
    probe(cv, 16, 4)
    probe(cv, 31, 4)
    g.Free()
    mut h := paint.LinearGradient(180.0)
    h.AddStop(0.5, paint.Rgb(0, 0, 0))
    h.AddStop(0.5, paint.Rgb(255, 255, 0))
    cv.FillGradient(paint.RectOf(34.0, 0.0, 28.0, 20.0), paint.Uniform(6.0), h)
    probe(cv, 48, 9)
    probe(cv, 48, 10)
    probe(cv, 34, 0)
    h.Free()
    mut rg := paint.RadialGradient(16.0, 14.0, 16.0, 14.0)
    rg.AddStop(0.0, paint.Rgb(255, 255, 255))
    rg.AddStop(1.0, paint.Rgba(0, 0, 0, 255))
    cv.FillGradient(paint.RectOf(0.0, 10.0, 32.0, 28.0), paint.Uniform(0.0), rg)
    probe(cv, 16, 24)
    probe(cv, 24, 24)
    probe(cv, 0, 10)
    rg.Free()
    sz := paint.RadialSize(40.0, 20.0, 10.0, 5.0, true, paint.RadialExtent.FarthestCorner)
    println "farthest corner", sz.x, sz.y
    sz2 := paint.RadialSize(40.0, 20.0, 10.0, 5.0, false, paint.RadialExtent.ClosestSide)
    println "closest side", sz2.x, sz2.y
    sz3 := paint.RadialSize(40.0, 20.0, 10.0, 5.0, true, paint.RadialExtent.FarthestSide)
    println "farthest side", sz3.x, sz3.y
    sz4 := paint.RadialSize(40.0, 20.0, 10.0, 5.0, true, paint.RadialExtent.ClosestCorner)
    println "closest corner", sz4.x, sz4.y
    mut cg := paint.ConicGradient(12.0, 12.0, 0.0)
    cg.AddStop(0.0, paint.Rgb(255, 0, 0))
    cg.AddStop(0.5, paint.Rgb(0, 0, 255))
    cg.AddStop(1.0, paint.Rgb(255, 0, 0))
    cv.FillGradient(paint.RectOf(36.0, 22.0, 24.0, 24.0), paint.Uniform(12.0), cg)
    probe(cv, 48, 24)
    probe(cv, 58, 34)
    probe(cv, 48, 44)
    cg.Free()
    mut rep := paint.LinearGradient(90.0)
    rep.repeating = true
    rep.AddStop(0.0, paint.Rgb(0, 0, 0))
    rep.AddStop(0.25, paint.Rgb(255, 255, 255))
    cv.FillGradient(paint.RectOf(0.0, 40.0, 32.0, 8.0), paint.Uniform(0.0), rep)
    probe(cv, 1, 44)
    probe(cv, 9, 44)
    probe(cv, 7, 44)
    rep.Free()
    mut empty := paint.LinearGradient(0.0)
    cv.FillGradient(paint.RectOf(0.0, 0.0, 64.0, 48.0), paint.Uniform(0.0), empty)
    empty.Free()
    println "hash", cv.Hash()
    cv.Free()
end
