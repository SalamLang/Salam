package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func checker(): paint.Canvas:
    mut src := paint.NewCanvas(4, 4)
    repeat 4 in y:
        repeat 4 in x:
            if (x + y) % 2 == 0:
                src.FillRect(paint.RectOf(x as f64, y as f64, 1.0, 1.0), paint.Rgb(255, 0, 0))
            else:
                src.FillRect(paint.RectOf(x as f64, y as f64, 1.0, 1.0), paint.Rgba(0, 0, 255, 128))
            end
        end
    end
    ret src
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    mut src := checker()
    cv.DrawImage(src, paint.RectOf(0.0, 0.0, 4.0, 4.0), 1.0)
    probe(cv, 0, 0)
    probe(cv, 1, 0)
    cv.DrawImage(src, paint.RectOf(8.0, 0.0, 16.0, 16.0), 1.0)
    probe(cv, 8, 0)
    probe(cv, 11, 2)
    probe(cv, 13, 2)
    cv.DrawImage(src, paint.RectOf(28.0, 0.0, 2.0, 2.0), 1.0)
    probe(cv, 28, 0)
    probe(cv, 29, 1)
    cv.DrawImage(src, paint.RectOf(32.0, 0.0, 8.0, 8.0), 0.5)
    probe(cv, 32, 0)
    cv.DrawImagePart(src, paint.IntRectOf(1, 0, 1, 1), paint.RectOf(42.0, 0.0, 6.0, 6.0), 1.0)
    probe(cv, 44, 3)
    cv.DrawImageTiled(src, paint.RectOf(0.0, 20.0, 30.0, 10.0), paint.RectOf(1.0, 20.0, 2.0, 2.0), 1.0)
    probe(cv, 0, 20)
    probe(cv, 1, 20)
    probe(cv, 2, 20)
    probe(cv, 29, 29)
    mut half := paint.ScaleImage(src, 2, 2)
    println "scaled", half.width, half.height
    c0 := half.Pixel(0, 0)
    println "scaled pixel", c0.r, c0.g, c0.b, c0.a
    half.Free()
    f1 := paint.FitImage(paint.ObjectFit.Contain, 200, 100, paint.RectOf(0.0, 0.0, 50.0, 50.0), 0.5, 0.5)
    println "contain", f1.x, f1.y, f1.width, f1.height
    f2 := paint.FitImage(paint.ObjectFit.Cover, 200, 100, paint.RectOf(0.0, 0.0, 50.0, 50.0), 0.5, 0.5)
    println "cover", f2.x, f2.y, f2.width, f2.height
    f3 := paint.FitImage(paint.ObjectFit.None, 20, 10, paint.RectOf(0.0, 0.0, 50.0, 50.0), 0.0, 1.0)
    println "none", f3.x, f3.y, f3.width, f3.height
    f4 := paint.FitImage(paint.ObjectFit.ScaleDown, 20, 10, paint.RectOf(0.0, 0.0, 50.0, 50.0), 0.5, 0.5)
    println "scale down", f4.x, f4.y, f4.width, f4.height
    f5 := paint.FitImage(paint.ObjectFit.Fill, 20, 10, paint.RectOf(1.0, 2.0, 50.0, 40.0), 0.5, 0.5)
    println "fill", f5.x, f5.y, f5.width, f5.height
    cv.PushRoundedClip(paint.RectOf(34.0, 30.0, 16.0, 16.0), paint.Uniform(8.0))
    cv.DrawImage(src, f5, 1.0)
    cv.PopClip()
    probe(cv, 34, 30)
    probe(cv, 42, 38)
    println "hash", cv.Hash()
    src.Free()
    cv.Free()
end
