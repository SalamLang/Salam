package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    cv.BeginLayer(paint.RectOf(0.0, 0.0, 30.0, 30.0))
    cv.FillRect(paint.RectOf(2.0, 2.0, 16.0, 16.0), paint.Rgb(255, 0, 0))
    cv.FillRect(paint.RectOf(10.0, 10.0, 16.0, 16.0), paint.Rgb(0, 0, 255))
    cv.EndLayer(0.5)
    probe(cv, 5, 5)
    probe(cv, 14, 14)
    probe(cv, 22, 22)
    cv.Translate(32.0, 0.0)
    cv.FillRoundedRect(paint.RectOf(2.0, 2.0, 12.0, 12.0), paint.Uniform(3.0), paint.Rgb(0, 150, 0))
    cv.PopTransform()
    probe(cv, 40, 8)
    probe(cv, 8, 40)
    t := paint.Translation(48.0, 8.0).Then(paint.Identity())
    cv.PushTransform(paint.Rotation(45.0).Then(t))
    cv.FillRect(paint.RectOf(-5.0, -5.0, 10.0, 10.0), paint.Rgb(0, 0, 0))
    cv.PopTransform()
    probe(cv, 48, 8)
    probe(cv, 48, 1)
    probe(cv, 54, 2)
    cv.PushTransform(paint.Scaling(2.0, 2.0))
    cv.FillRect(paint.RectOf(1.0, 16.0, 4.0, 4.0), paint.Rgb(200, 200, 0))
    cv.PopTransform()
    probe(cv, 2, 32)
    probe(cv, 9, 39)
    probe(cv, 10, 40)
    mut src := paint.NewCanvas(2, 2)
    src.Clear(paint.Rgb(0, 200, 200))
    cv.PushTransform(paint.Rotation(30.0).Then(paint.Translation(30.0, 34.0)))
    cv.DrawImage(src, paint.RectOf(0.0, 0.0, 10.0, 10.0), 1.0)
    cv.PopTransform()
    probe(cv, 28, 40)
    src.Free()
    p := paint.Rotation(90.0).Apply(paint.Point { x = 1.0, y = 0.0 })
    println "rotated", p.x, p.y
    s := paint.Scaling(2.0, 3.0).Then(paint.Translation(1.0, 1.0)).Apply(paint.Point { x = 1.0, y = 1.0 })
    println "scaled", s.x, s.y
    cv.BeginLayer(paint.RectOf(40.0, 30.0, 20.0, 16.0))
    cv.BeginLayer(paint.RectOf(40.0, 30.0, 10.0, 16.0))
    cv.FillRect(paint.RectOf(40.0, 30.0, 20.0, 16.0), paint.Rgb(0, 0, 0))
    cv.EndLayer(1.0)
    cv.EndLayer(0.25)
    probe(cv, 45, 35)
    probe(cv, 55, 35)
    println "hash", cv.Hash()
    cv.Free()
    mut m := paint.NewCanvas(20, 10)
    m.Clear(paint.Rgb(255, 255, 255))
    m.BeginLayer(paint.RectOf(0.0, 0.0, 20.0, 10.0))
    m.FillRect(paint.RectOf(0.0, 0.0, 20.0, 10.0), paint.Rgb(0, 0, 200))
    m.BeginLayer(paint.RectOf(0.0, 0.0, 20.0, 10.0))
    m.FillRect(paint.RectOf(0.0, 0.0, 5.0, 10.0), paint.Rgb(255, 255, 255))
    m.FillRect(paint.RectOf(10.0, 0.0, 5.0, 10.0), paint.Rgba(255, 255, 255, 128))
    m.EndLayerMasked(1.0)
    probe(m, 2, 5)
    probe(m, 7, 5)
    probe(m, 12, 5)
    m.Free()
end
