package main

import gui.paint
import mem

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    data := mem.AllocateZeroed((8 * 6) as u64)
    bytes := data as u8*
    repeat 6 in y:
        repeat 8 in x:
            bytes[y * 8 + x] = ((x * 36) % 256) as u8
        end
    end
    m := paint.Mask { data = data, width = 8, height = 6, stride = 8, left = 1, top = 5 }
    cv.DrawMask(m, 2, 2, paint.Rgb(0, 0, 0))
    probe(cv, 2, 2)
    probe(cv, 6, 3)
    probe(cv, 9, 7)
    cv.DrawGlyph(m, 20, 10, paint.Rgb(200, 0, 0))
    probe(cv, 21, 5)
    probe(cv, 28, 7)
    cv.PushClip(paint.RectOf(40.0, 0.0, 4.0, 48.0))
    cv.DrawMask(m, 38, 20, paint.Rgba(0, 0, 255, 255))
    cv.PopClip()
    probe(cv, 39, 22)
    probe(cv, 41, 22)
    probe(cv, 45, 22)
    cv.DrawMask(m, 60, 44, paint.Rgb(0, 0, 0))
    cv.DrawMask(m, -100, -100, paint.Rgb(0, 0, 0))
    println "hash", cv.Hash()
    mem.Free(data)
    cv.Free()
end
