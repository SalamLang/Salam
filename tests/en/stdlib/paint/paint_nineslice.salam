package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func source(): paint.Canvas:
    mut s := paint.NewCanvas(30, 30)
    s.Clear(paint.Rgb(0, 0, 255))
    s.FillRect(paint.RectOf(0.0, 0.0, 10.0, 10.0), paint.Rgb(255, 0, 0))
    s.FillRect(paint.RectOf(20.0, 0.0, 10.0, 10.0), paint.Rgb(0, 160, 0))
    s.FillRect(paint.RectOf(0.0, 20.0, 10.0, 10.0), paint.Rgb(255, 200, 0))
    s.FillRect(paint.RectOf(20.0, 20.0, 10.0, 10.0), paint.Rgb(0, 0, 0))
    s.FillRect(paint.RectOf(10.0, 0.0, 5.0, 10.0), paint.Rgb(255, 0, 255))
    s.FillRect(paint.RectOf(0.0, 10.0, 10.0, 5.0), paint.Rgb(0, 200, 200))
    s.FillRect(paint.RectOf(10.0, 10.0, 10.0, 10.0), paint.Rgb(128, 128, 128))
    ret s
end

func frame(cv &: paint.Canvas, src: paint.Canvas, x: f64, mode: paint.ImageRepeat, fill: bool):
    mut ns := paint.NineSlice { slice_top = 10.0, slice_right = 10.0, slice_bottom = 10.0, slice_left = 10.0 }
    ns.width_top = 8.0
    ns.width_right = 8.0
    ns.width_bottom = 8.0
    ns.width_left = 8.0
    ns.repeat_x = mode
    ns.repeat_y = mode
    ns.fill = fill
    cv.DrawNineSlice(src, paint.RectOf(x, 4.0, 50.0, 42.0), ns, 1.0)
end

func main:
    src := source()
    mut cv := paint.NewCanvas(240, 60)
    cv.Clear(paint.Rgb(255, 255, 255))
    frame(cv, src, 4.0, paint.ImageRepeat.Stretch, true)
    frame(cv, src, 62.0, paint.ImageRepeat.Repeat, false)
    frame(cv, src, 120.0, paint.ImageRepeat.Round, false)
    frame(cv, src, 178.0, paint.ImageRepeat.Space, false)
    probe(cv, 6, 6)
    probe(cv, 50, 6)
    probe(cv, 6, 42)
    probe(cv, 50, 42)
    probe(cv, 14, 6)
    probe(cv, 6, 16)
    probe(cv, 28, 24)
    probe(cv, 87, 6)
    probe(cv, 72, 6)
    probe(cv, 64, 24)
    probe(cv, 87, 24)
    probe(cv, 132, 6)
    probe(cv, 140, 6)
    probe(cv, 190, 6)
    probe(cv, 205, 24)
    over := paint.NineSlice { slice_top = 10.0, slice_right = 10.0, slice_bottom = 10.0, slice_left = 10.0, width_top = 30.0, width_right = 30.0, width_bottom = 30.0, width_left = 30.0 }
    mut small := paint.NewCanvas(40, 40)
    small.Clear(paint.Rgb(255, 255, 255))
    small.DrawNineSlice(src, paint.RectOf(0.0, 0.0, 40.0, 40.0), over, 0.5)
    probe(small, 5, 5)
    probe(small, 35, 35)
    probe(small, 20, 20)
    println "hash", cv.Hash(), small.Hash()
    small.Free()
    cv.Free()
end
