package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    mut tri := paint.NewPath()
    tri.MoveTo(2.0, 2.0)
    tri.LineTo(22.0, 2.0)
    tri.LineTo(2.0, 22.0)
    tri.Close()
    cv.FillPath(tri, paint.FillRule.NonZero, paint.Rgb(0, 0, 0))
    probe(cv, 4, 4)
    probe(cv, 11, 11)
    probe(cv, 12, 12)
    probe(cv, 20, 20)
    tri.Free()
    mut star := paint.NewPath()
    star.MoveTo(36.0, 2.0)
    star.LineTo(42.0, 22.0)
    star.LineTo(26.0, 9.0)
    star.LineTo(46.0, 9.0)
    star.LineTo(30.0, 22.0)
    star.Close()
    mut odd := paint.NewCanvas(64, 48)
    odd.Clear(paint.Rgb(255, 255, 255))
    cv.FillPath(star, paint.FillRule.NonZero, paint.Rgb(0, 0, 200))
    odd.FillPath(star, paint.FillRule.EvenOdd, paint.Rgb(0, 0, 200))
    probe(cv, 36, 13)
    probe(odd, 36, 13)
    probe(odd, 36, 6)
    println "even odd hash", odd.Hash()
    odd.Free()
    star.Free()
    mut curve := paint.NewPath()
    curve.MoveTo(48.0, 2.0)
    curve.QuadTo(62.0, 2.0, 62.0, 16.0)
    curve.CubicTo(56.0, 16.0, 50.0, 22.0, 48.0, 16.0)
    curve.Close()
    cv.FillPath(curve, paint.FillRule.NonZero, paint.Rgb(0, 140, 0))
    probe(cv, 55, 8)
    probe(cv, 61, 3)
    curve.Clear()
    curve.AddEllipse(12.0, 36.0, 10.0, 8.0)
    cv.FillPath(curve, paint.FillRule.NonZero, paint.Rgba(200, 0, 0, 255))
    probe(cv, 12, 36)
    probe(cv, 2, 36)
    probe(cv, 3, 29)
    curve.Clear()
    curve.AddRect(paint.RectOf(26.0, 28.0, 10.0, 10.0))
    curve.AddRoundedRect(paint.RectOf(28.0, 30.0, 6.0, 6.0), paint.Uniform(2.0))
    cv.FillPath(curve, paint.FillRule.EvenOdd, paint.Rgb(120, 0, 120))
    probe(cv, 27, 29)
    probe(cv, 31, 33)
    curve.Free()
    mut line := paint.NewPath()
    line.MoveTo(40.0, 30.0)
    line.LineTo(60.0, 30.0)
    line.LineTo(60.0, 44.0)
    cv.StrokePath(line, paint.Stroke { width = 4.0 }, paint.Rgb(0, 0, 0))
    probe(cv, 50, 28)
    probe(cv, 50, 32)
    probe(cv, 61, 29)
    probe(cv, 38, 30)
    line.Free()
    mut caps := paint.NewPath()
    caps.MoveTo(42.0, 38.0)
    caps.LineTo(52.0, 38.0)
    cv.StrokePath(caps, paint.Stroke { width = 4.0, cap = paint.LineCap.Round, join = paint.LineJoin.Round }, paint.Rgb(0, 100, 200))
    probe(cv, 40, 38)
    caps.Clear()
    caps.MoveTo(42.0, 44.0)
    caps.LineTo(52.0, 44.0)
    cv.StrokePath(caps, paint.Stroke { width = 2.0, cap = paint.LineCap.Square, join = paint.LineJoin.Bevel }, paint.Rgb(200, 100, 0))
    probe(cv, 41, 44)
    caps.Clear()
    caps.MoveTo(2.0, 46.0)
    caps.LineTo(62.0, 46.0)
    cv.StrokePath(caps, paint.Stroke { width = 2.0, dash = 4.0, gap = 2.0, dash_offset = 1.0 }, paint.Rgb(0, 0, 0))
    mut dashes := ""
    repeat 20 in i:
        dashes += cv.Pixel(2 + i, 46).r < 128 ? "#" : "."
    end
    println "dashes", dashes
    caps.Free()
    mut arc := paint.NewPath()
    arc.Arc(50.0, 22.0, 6.0, 6.0, 0.0, 180.0)
    cv.StrokePath(arc, paint.Stroke { width = 1.0, miter_limit = 2.0 }, paint.Rgb(255, 0, 0))
    probe(cv, 50, 27)
    arc.Free()
    println "hash", cv.Hash()
    cv.Free()
end
