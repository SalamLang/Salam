package main

import gui.paint
import ai.image
import os
import filepath

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    cv.DrawShadow(paint.RectOf(8.0, 8.0, 40.0, 24.0), paint.Uniform(8.0), paint.Shadow { offset_y = 3.0, blur = 6.0, color = paint.Rgba(0, 0, 0, 100) })
    cv.FillRoundedRect(paint.RectOf(8.0, 8.0, 40.0, 24.0), paint.Uniform(8.0), paint.Rgb(30, 110, 220))
    cv.DrawBorder(paint.RectOf(8.0, 8.0, 40.0, 24.0), paint.Uniform(8.0), paint.SolidBorder(2.0, paint.Rgb(10, 40, 90)))
    dir := filepath.Join(os.TempDir(), "salam_paint_png_demo")
    os.MkdirAll(dir)
    path := filepath.Join(dir, "box.png")
    println "saved", paint.SavePNG(cv, path)
    mut ok := false
    mut back := paint.LoadPNG(path, ok)
    println "loaded", ok, back.width, back.height
    println "same pixels", back.Hash() == cv.Hash()
    img := paint.ToImage(cv)
    println "image", img.width, img.height
    c := image.GetPixel(img, 20, 20)
    println "image pixel", c.r, c.g, c.b, c.a
    mut again := paint.FromImage(img)
    println "round trip", again.Hash() == cv.Hash()
    mut bad := false
    mut missing := paint.LoadPNG(filepath.Join(dir, "missing.png"), bad)
    println "missing", bad, missing.width
    mut copy := img
    image.Free(copy)
    again.Free()
    back.Free()
    missing.Free()
    cv.Free()
    os.RemoveAll(dir)
end
