package main

import gui.paint
import mem

func show(r: paint.Region):
    mut line := "count " + r.Count()
    repeat r.Count() in i:
        q := r.At(i)
        line += " [" + q.x + " " + q.y + " " + q.width + " " + q.height + "]"
    end
    println line
end

func scene(cv &: paint.Canvas, img: paint.Canvas, m: paint.Mask):
    cv.Clear(paint.Rgb(250, 250, 250))
    r := paint.RectOf(6.5, 5.25, 30.0, 20.0)
    cv.DrawShadow(r, paint.Uniform(6.0), paint.Shadow { offset_y = 2.0, blur = 5.0, color = paint.Rgba(0, 0, 0, 120) })
    mut g := paint.LinearGradient(120.0)
    g.AddStop(0.0, paint.Rgb(255, 160, 0))
    g.AddStop(1.0, paint.Rgb(80, 0, 200))
    cv.FillGradient(r, paint.Uniform(6.0), g)
    g.Free()
    mut b := paint.SolidBorder(2.0, paint.Rgb(20, 20, 80))
    b.top_color = paint.Rgb(200, 0, 0)
    cv.DrawBorder(r, paint.Uniform(6.0), b)
    cv.PushRoundedClip(paint.RectOf(30.0, 14.0, 30.0, 30.0), paint.Uniform(12.0))
    cv.DrawImage(img, paint.RectOf(28.0, 12.0, 34.0, 34.0), 0.9)
    cv.PopClip()
    cv.BeginLayer(paint.RectOf(0.0, 26.0, 40.0, 22.0))
    mut p := paint.NewPath()
    p.AddEllipse(14.0, 36.0, 12.0, 8.0)
    cv.FillPath(p, paint.FillRule.NonZero, paint.Rgb(0, 140, 60))
    cv.StrokePath(p, paint.Stroke { width = 1.5 }, paint.Rgb(0, 0, 0))
    p.Free()
    cv.DrawMask(m, 18, 32, paint.Rgb(255, 255, 255))
    cv.EndLayer(0.7)
    cv.DrawShadow(paint.RectOf(42.0, 2.0, 18.0, 10.0), paint.Uniform(3.0), paint.Shadow { blur = 3.0, color = paint.Rgba(0, 0, 200, 255), inset = true })
end

func main:
    mut reg := paint.Region {}
    println "empty", reg.IsEmpty()
    reg.Add(paint.IntRectOf(0, 0, 10, 10))
    reg.Add(paint.IntRectOf(2, 2, 4, 4))
    reg.Add(paint.IntRectOf(20, 0, 10, 10))
    reg.Add(paint.IntRectOf(0, 30, 10, 10))
    show(reg)
    reg.Add(paint.IntRectOf(22, 2, 10, 10))
    show(reg)
    reg.Add(paint.IntRectOf(-5, -5, 50, 50))
    show(reg)
    reg.Clear()
    reg.Add(paint.IntRectOf(5, 5, 5, 5))
    mut other := paint.Region {}
    other.Add(paint.IntRectOf(50, 50, 2, 2))
    other.Add(paint.IntRectOf(0, 0, 0, 5))
    reg.Union(other)
    show(reg)
    bb := reg.Bounds()
    println "bounds", bb.x, bb.y, bb.width, bb.height
    q := reg.At(7)
    println "out of range", q.width

    mut img := paint.NewCanvas(8, 8)
    repeat 8 in y:
        repeat 8 in x:
            img.FillRect(paint.RectOf(x as f64, y as f64, 1.0, 1.0), paint.Rgb(x * 32, y * 32, 128))
        end
    end
    data := mem.AllocateZeroed((6 * 6) as u64)
    repeat 36 in i:
        (data as u8*)[i] = ((i * 7) % 256) as u8
    end
    m := paint.Mask { data = data, width = 6, height = 6, stride = 6 }

    mut full := paint.NewCanvas(64, 48)
    scene(full, img, m)
    println "full", full.Hash()

    mut part := paint.NewCanvas(64, 48)
    mut damage := paint.Region {}
    damage.Add(paint.IntRectOf(10, 8, 30, 20))
    damage.Add(paint.IntRectOf(25, 18, 30, 22))
    part.SetRegion(damage)
    scene(part, img, m)
    mut r1 := paint.Region {}
    r1.Add(paint.IntRectOf(0, 0, 64, 8))
    r1.Add(paint.IntRectOf(0, 8, 10, 10))
    r1.Add(paint.IntRectOf(40, 8, 24, 10))
    part.SetRegion(r1)
    scene(part, img, m)
    mut r2 := paint.Region {}
    r2.Add(paint.IntRectOf(0, 18, 10, 10))
    r2.Add(paint.IntRectOf(55, 18, 9, 10))
    r2.Add(paint.IntRectOf(0, 28, 25, 12))
    part.SetRegion(r2)
    scene(part, img, m)
    mut r3 := paint.Region {}
    r3.Add(paint.IntRectOf(55, 28, 9, 12))
    r3.Add(paint.IntRectOf(0, 40, 64, 8))
    part.SetRegion(r3)
    scene(part, img, m)
    part.ClearRegion()
    println "partial", part.Hash()
    println "partial equals full", part.Hash() == full.Hash()

    mut only := paint.NewCanvas(64, 48)
    only.SetRegion(damage)
    scene(only, img, m)
    println "outside damage untouched", only.RawPixel(2, 2), only.RawPixel(60, 46)
    println "inside damage drawn", only.RawPixel(30, 20) == full.RawPixel(30, 20)

    only.Free()
    part.Free()
    full.Free()
    img.Free()
    mem.Free(data)
end
