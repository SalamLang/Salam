package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    cv.FillRoundedRect(paint.RectOf(2.0, 2.0, 28.0, 20.0), paint.Uniform(8.0), paint.Rgb(0, 0, 0))
    probe(cv, 2, 2)
    probe(cv, 3, 4)
    probe(cv, 4, 3)
    probe(cv, 5, 5)
    probe(cv, 16, 2)
    probe(cv, 16, 12)
    probe(cv, 29, 21)
    cv.FillRoundedRect(paint.RectOf(34.5, 2.5, 26.0, 20.0), paint.Corners(0.0, 12.0, 4.0, 20.0), paint.Rgb(0, 90, 200))
    probe(cv, 34, 2)
    probe(cv, 35, 3)
    probe(cv, 59, 3)
    probe(cv, 36, 21)
    big := paint.Radii { top_left_x = 40.0, top_left_y = 10.0, top_right_x = 40.0, top_right_y = 10.0, bottom_right_x = 10.0, bottom_right_y = 30.0, bottom_left_x = 10.0, bottom_left_y = 30.0 }
    r := paint.RectOf(4.0, 26.0, 40.0, 20.0)
    f := paint.FitRadii(r, big)
    println "fit", f.top_left_x, f.top_left_y, f.bottom_right_x, f.bottom_right_y
    cv.FillRoundedRect(r, big, paint.Rgba(200, 0, 0, 200))
    probe(cv, 4, 26)
    probe(cv, 24, 26)
    probe(cv, 24, 36)
    probe(cv, 5, 45)
    pill := paint.FitRadii(paint.RectOf(0.0, 0.0, 10.0, 4.0), paint.Uniform(100.0))
    println "pill", pill.top_left_x, pill.top_left_y
    cv.FillRoundedRect(paint.RectOf(48.0, 30.0, 12.0, 12.0), paint.Uniform(6.0), paint.Rgb(0, 160, 0))
    probe(cv, 54, 30)
    probe(cv, 54, 36)
    probe(cv, 49, 31)
    cv.FillRoundedRect(paint.RectOf(0.0, 0.0, 0.0, 10.0), paint.Uniform(2.0), paint.Rgb(0, 0, 0))
    println "hash", cv.Hash()
    cv.Free()
end
