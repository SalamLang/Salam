package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(64, 48)
    cv.Clear(paint.Rgb(255, 255, 255))
    r := paint.RectOf(8.0, 8.0, 20.0, 14.0)
    cv.DrawShadow(r, paint.Uniform(4.0), paint.Shadow { offset_x = 2.0, offset_y = 3.0, blur = 6.0, color = paint.Rgba(0, 0, 0, 200) })
    probe(cv, 18, 15)
    probe(cv, 18, 23)
    probe(cv, 18, 26)
    probe(cv, 18, 30)
    probe(cv, 30, 15)
    probe(cv, 4, 15)
    cv.DrawShadow(paint.RectOf(36.0, 4.0, 20.0, 12.0), paint.Uniform(0.0), paint.Shadow { spread = 2.0, color = paint.Rgb(0, 0, 200) })
    probe(cv, 35, 10)
    probe(cv, 34, 10)
    probe(cv, 33, 10)
    probe(cv, 40, 10)
    cv.FillRect(paint.RectOf(4.0, 30.0, 26.0, 14.0), paint.Rgb(240, 240, 240))
    cv.DrawShadow(paint.RectOf(4.0, 30.0, 26.0, 14.0), paint.Uniform(5.0), paint.Shadow { blur = 4.0, spread = 1.0, color = paint.Rgba(200, 0, 0, 255), inset = true })
    probe(cv, 4, 37)
    probe(cv, 6, 37)
    probe(cv, 17, 37)
    probe(cv, 3, 37)
    cv.DrawShadow(paint.RectOf(36.0, 30.0, 24.0, 14.0), paint.Uniform(3.0), paint.Shadow { offset_x = 3.0, color = paint.Rgba(0, 120, 0, 255), inset = true })
    probe(cv, 37, 37)
    probe(cv, 40, 37)
    probe(cv, 48, 37)
    cv.DrawShadow(r, paint.Uniform(0.0), paint.Shadow { color = paint.Rgba(0, 0, 0, 0) })
    println "hash", cv.Hash()
    cv.Free()
end
