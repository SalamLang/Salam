package main

import gui.paint

func probe(cv: paint.Canvas, x: int, y: int):
    c := cv.Pixel(x, y)
    println "(" + x + "," + y + ")", c.r, c.g, c.b, c.a
end

func main:
    mut cv := paint.NewCanvas(120, 90)
    cv.Clear(paint.Rgb(255, 255, 255))
    t := paint.Translation(-20.0, -15.0).Then(paint.Rotation(30.0)).Then(paint.Skewing(10.0, 0.0)).Then(paint.Translation(40.0, 40.0))
    println "identity", paint.Identity().IsIdentity(), t.IsIdentity()
    back := t.Invert().Apply(t.Apply(paint.Point { x = 7.0, y = 3.0 }))
    println "round trip", back.x > 6.999 and back.x < 7.001, back.y > 2.999 and back.y < 3.001
    box := paint.Rotation(90.0).MapRect(paint.RectOf(0.0, 0.0, 10.0, 4.0))
    println "mapped", box.x, box.y, box.width, box.height
    sk := paint.Skewing(45.0, 0.0).Apply(paint.Point { x = 0.0, y = 10.0 })
    println "skewed", sk.x, sk.y
    cv.PushTransform(t)
    cv.DrawShadow(paint.RectOf(0.0, 0.0, 40.0, 30.0), paint.Uniform(6.0), paint.Shadow { offset_x = 3.0, offset_y = 3.0, blur = 6.0, color = paint.Rgba(0, 0, 0, 120) })
    mut g := paint.LinearGradient(90.0)
    g.AddStop(0.0, paint.Rgb(255, 200, 0))
    g.AddStop(1.0, paint.Rgb(0, 120, 255))
    cv.FillGradient(paint.RectOf(0.0, 0.0, 40.0, 30.0), paint.Uniform(6.0), g)
    g.Free()
    mut b := paint.SolidBorder(3.0, paint.Rgb(200, 0, 0))
    b.left_color = paint.Rgb(0, 150, 0)
    cv.DrawBorder(paint.RectOf(0.0, 0.0, 40.0, 30.0), paint.Uniform(6.0), b)
    cv.PushRoundedClip(paint.RectOf(8.0, 8.0, 24.0, 14.0), paint.Uniform(4.0))
    cv.FillRect(paint.RectOf(-20.0, -20.0, 100.0, 100.0), paint.Rgba(0, 0, 255, 128))
    cv.PopClip()
    m := paint.Mask { data = "\xff\xff\xff\xff\xff\xff\xff\xff\xff" as void*, width = 3, height = 3, stride = 3 }
    cv.DrawMask(m, 2, 2, paint.Rgb(0, 0, 0))
    cv.PopTransform()
    probe(cv, 40, 40)
    probe(cv, 22, 40)
    probe(cv, 5, 5)
    probe(cv, 62, 60)
    mut d := paint.SolidBorder(4.0, paint.Rgb(0, 0, 200))
    d.top_style = paint.BorderStyle.Dashed
    d.right_style = paint.BorderStyle.Dashed
    d.bottom_style = paint.BorderStyle.Dotted
    d.left_style = paint.BorderStyle.Dotted
    cv.DrawBorder(paint.RectOf(70.0, 4.0, 46.0, 40.0), paint.Uniform(14.0), d)
    cv.DrawOutlineStyled(paint.RectOf(76.0, 56.0, 30.0, 20.0), paint.Uniform(4.0), 2.0, 3.0, paint.Rgb(0, 0, 0), paint.BorderStyle.Dashed)
    probe(cv, 73, 8)
    probe(cv, 93, 6)
    probe(cv, 72, 26)
    probe(cv, 72, 52)
    println "hash", cv.Hash()
    cv.Free()
end
