package main

import mem
import pool

mut squares := null as i64*
mut hits := null as i64*

func record(i: i64):
    squares[i] = i * i
    atomic_add(hits, 1 as i64)
end

func main:
    n := 200 as i64
    squares = mem.AllocateZeroed((n * 8 as i64) as u64) as i64*
    hits = mem.AllocateZeroed(8 as u64) as i64*
    pool.ParallelForAuto(n, (i: i64): record(i) end)
    mut total := 0 as i64
    repeat 200 in i:
        total += squares[i]
    end
    println "every index ran once: ", atomic_load(hits)
    println "sum of squares: ", total

    pool.ParallelForAuto(0 as i64, (i: i64): record(i) end)
    println "empty range ran nothing: ", atomic_load(hits)

    pool.ParallelForAuto(1 as i64, (i: i64): record(i) end)
    println "single item: ", atomic_load(hits)
    mem.Free(squares as void*)
    mem.Free(hits as void*)
end
