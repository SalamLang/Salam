package main

import pool

func fib(n: i64): i64:
    if n < 2:
        ret n
    end
    ret fib(n - 1) + fib(n - 2)
end

func greet(): str:
    ret "hello"
end

func main:
    p := pool.New(4 as i64, 16 as i64)
    a := pool.Async(p, (): ret fib(25 as i64) end)
    b := pool.Async(p, (): ret fib(20 as i64) end)
    c := pool.AsyncStr(p, (): ret greet() end)
    println "fib25: ", pool.Await(a)
    println "fib20: ", pool.Await(b)
    println "str: ", pool.AwaitStr(c)
    println "ready: ", pool.Ready(a)
    pool.Release(a)
    pool.Release(b)
    pool.Release(c)
    pool.Stop(p)
end
