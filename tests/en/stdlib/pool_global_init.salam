package main

import mem
import pool

mut workers := pool.NewElastic(2 as i64, 4 as i64, 8 as i64)
mut hits := null as i64*

func bump():
    atomic_add(hits, 1 as i64)
end

func main:
    hits = mem.AllocateZeroed(8 as u64) as i64*
    println "workers: ", pool.Workers(workers)
    repeat 10:
        pool.Submit(workers, (): bump() end)
    end
    pool.Wait(workers)
    println "hits: ", atomic_load(hits)
    pool.Stop(workers)
    mem.Free(hits as void*)
end
