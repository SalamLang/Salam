package main

import mem
import pool

mut hits := null as i64*

func job(i: int): str:
    if i == 7:
        ret "boom"
    end
    ret ""
end

func main:
    hits = mem.AllocateZeroed(8 as u64) as i64*
    repeat 50:
        pool.Go((): atomic_add(hits, 1 as i64) end)
    end
    pool.GoWait()
    println "go: ", atomic_load(hits)

    g := pool.NewGroup(3 as i64)
    repeat 20 in i:
        pool.GroupGo(g, (): ret job(i) end)
    end
    println "err: ", pool.GroupWait(g)
    println "failed: ", pool.GroupFailed(g)
    pool.GroupStop(g)
end
