package main

import pool

func main:
    squares := pool.Map(10 as i64, 4 as i64, (i: i64): ret i * i end)
    println "count: ", squares.Len()
    mut total := 0 as i64
    repeat squares.Len() in i:
        total += squares.Get(i)
    end
    println "sum: ", total
    println "first and last: ", squares.Get(0), squares.Get(9)
    println "empty: ", pool.Map(0 as i64, 4 as i64, (i: i64): ret i end).Len()
end
