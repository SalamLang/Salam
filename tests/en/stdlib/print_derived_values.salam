import testing

struct Point:
    pub name: str
    pub xs: int[2]
    pub w: f64
    pub ok: bool
    pub c: char
end

func main:
    println [1, 2, -3]
    p := Point { name = "a", xs = [4, 5], w = 1.5, ok = true, c = 'z' }
    println p
    mut v := Vector {} as Vector<Point>
    defer v.free()
    v.push(p)
    println v
    print [p, p]
    println ""
    printerrln ["e", "f"]
    m := [[1, 2], [3, 4]]
    println "m=", m, " end"
    testing.AssertEqInt(v.len(), 1)
    ret testing.Summary()
end
