package main

import encoding.protobuf
import testing
import os
import str

func main:
    src := `syntax = "proto3";
message Person {
  string name = 1;
  int32 age = 2;
  repeated string emails = 3;
}`
    mut ok := false
    out := protobuf.GenerateSingle(src, ok)
    testing.AssertTrue(ok)
    testing.AssertTrue(str.Contains(out, "pub struct Person:"))
    testing.AssertTrue(str.Contains(out, "pub name: str"))
    testing.AssertTrue(str.Contains(out, "pub age: i64"))
    testing.AssertTrue(str.Contains(out, "pub emails: Vector<str>"))
    testing.AssertTrue(str.Contains(out, "pub func MarshalPerson(m: Person): compress.ByteBuf:"))
    testing.AssertTrue(str.Contains(out, "pub func UnmarshalPerson(data: void*, n: int, ok &: bool): Person:"))

    os.Exit(testing.Summary())
end
