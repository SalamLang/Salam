package main

import encoding.protobuf
import testing
import str

func checks() throws:
    src := `syntax = "proto3";
message Person {
  string name = 1;
  int32 age = 2;
  repeated string emails = 3;
}`
    out := try protobuf.GenerateSingle(src)
    testing.AssertTrue(str.Contains(out, "pub struct Person:"))
    testing.AssertTrue(str.Contains(out, "pub name: str"))
    testing.AssertTrue(str.Contains(out, "pub age: i64"))
    testing.AssertTrue(str.Contains(out, "pub emails: Vector<str>"))
    testing.AssertTrue(str.Contains(out, "pub func MarshalPerson(m: Person): compress.ByteBuf:"))
    testing.AssertTrue(str.Contains(out, "pub func UnmarshalPerson(data: void*, n: int): Person throws:"))
    testing.AssertTrue(str.Contains(out, "out.name = protobuf.ReadLenPrefixedStr(r)"))
    testing.AssertTrue(str.Contains(out, "throw e.wrap(\"Person\")"))
    testing.AssertFalse(str.Contains(out, "ok &: bool"))

    mut failed := false
    try:
        protobuf.GenerateSingle("message Person {\n  string name = 1;\n  int32 age 2;\n}\n")
    catch e:
        failed = true
        testing.AssertEqStr(e.ToStr(), "protobuf: expected '=', found '2' (line 3, column 13)")
    end
    testing.AssertTrue(failed)
end

func main:
    try:
        checks()
    catch e:
        testing.AssertMsg(false, e.ToStr())
    end
    ret testing.Summary()
end
