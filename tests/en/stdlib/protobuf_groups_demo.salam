package main

import compress
import encoding.protobuf
import testing

func main(): int throws:
    mut buf := compress.NewByteBuf()
    protobuf.WriteStartGroup(buf, 1)
    protobuf.WriteTag(buf, 2, protobuf.WT_VARINT)
    protobuf.WriteVarint(buf, 42 as u64)
    protobuf.WriteStartGroup(buf, 3)
    protobuf.WriteTag(buf, 4, protobuf.WT_VARINT)
    protobuf.WriteVarint(buf, 7 as u64)
    protobuf.WriteEndGroup(buf, 3)
    protobuf.WriteEndGroup(buf, 1)
    protobuf.WriteTag(buf, 9, protobuf.WT_VARINT)
    protobuf.WriteVarint(buf, 1 as u64)

    mut r := compress.NewByteReader(buf.data, buf.len)
    mut num := 0
    mut wt := 0
    try protobuf.ReadTag(r, num, wt)
    testing.AssertEqInt(num, 1)
    testing.AssertEqInt(wt, protobuf.WT_START_GROUP)
    try protobuf.SkipFieldFor(r, num, wt)

    // The tag after the group is the next one to read.
    try protobuf.ReadTag(r, num, wt)
    testing.AssertEqInt(num, 9)
    testing.AssertEqInt(wt, protobuf.WT_VARINT)

    mut r2 := compress.NewByteReader(buf.data, buf.len - 2)
    try protobuf.ReadTag(r2, num, wt)
    try protobuf.SkipField(r2, wt)

    mut mismatch := compress.NewByteBuf()
    protobuf.WriteStartGroup(mismatch, 5)
    protobuf.WriteEndGroup(mismatch, 6)
    mut r3 := compress.NewByteReader(mismatch.data, mismatch.len)
    try protobuf.ReadTag(r3, num, wt)
    mut caught := Error {}
    try:
        protobuf.SkipFieldFor(r3, num, wt)
    catch e:
        caught = e
    end
    testing.AssertEqStr(caught.code, "protobuf.group_mismatch")

    mut cut := compress.NewByteBuf()
    protobuf.WriteStartGroup(cut, 7)
    protobuf.WriteTag(cut, 8, protobuf.WT_VARINT)
    protobuf.WriteVarint(cut, 3 as u64)
    mut r4 := compress.NewByteReader(cut.data, cut.len)
    try protobuf.ReadTag(r4, num, wt)
    caught = Error {}
    try:
        protobuf.SkipFieldFor(r4, num, wt)
    catch e:
        caught = e
    end
    testing.AssertEqStr(caught.code, "protobuf.truncated")

    compress.BufFree(buf)
    compress.BufFree(mismatch)
    compress.BufFree(cut)

    ret testing.Summary()
end
