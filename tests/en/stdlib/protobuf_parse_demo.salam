package main

import encoding.protobuf
import testing
import os

func main:
    src := `syntax = "proto3";
message Person {
  string name = 1;
  int32 age = 2;
  repeated string emails = 3;
}`
    mut ok := false
    f := protobuf.ParseFile(src, ok)
    testing.AssertTrue(ok)
    testing.AssertEqInt(f.messages.len(), 1)
    msg := f.messages.get(0)[0]
    testing.AssertEqStr(msg.name, "Person")
    testing.AssertEqInt(msg.fields.len(), 3)

    f0 := msg.fields.get(0)[0]
    testing.AssertEqStr(f0.name, "name")
    testing.AssertEqInt(f0.kind, protobuf.FK_STRING)
    testing.AssertEqInt(f0.number, 1)
    testing.AssertFalse(f0.repeated)

    f1 := msg.fields.get(1)[0]
    testing.AssertEqStr(f1.name, "age")
    testing.AssertEqInt(f1.kind, protobuf.FK_INT32)
    testing.AssertEqInt(f1.number, 2)

    f2 := msg.fields.get(2)[0]
    testing.AssertEqStr(f2.name, "emails")
    testing.AssertEqInt(f2.kind, protobuf.FK_STRING)
    testing.AssertEqInt(f2.number, 3)
    testing.AssertTrue(f2.repeated)

    // enum + nested message + oneof + map
    src2 := `message Outer {
  enum Status {
    UNKNOWN = 0;
    ACTIVE = 1;
  }
  message Inner {
    int32 x = 1;
  }
  oneof choice {
    string a = 1;
    int32 b = 2;
  }
  map<string, int32> counts = 3;
}`
    mut ok2 := false
    f_outer := protobuf.ParseFile(src2, ok2)
    testing.AssertTrue(ok2)
    testing.AssertEqInt(f_outer.messages.len(), 1)
    outer := f_outer.messages.get(0)[0]
    testing.AssertEqInt(outer.nestedEnums.len(), 1)
    testing.AssertEqStr(outer.nestedEnums.get(0)[0].name, "Status")
    testing.AssertEqInt(outer.nestedEnums.get(0)[0].values.len(), 2)
    testing.AssertEqStr(outer.nestedEnums.get(0)[0].values.get(1)[0].name, "ACTIVE")
    testing.AssertEqInt(outer.nestedEnums.get(0)[0].values.get(1)[0].number, 1)

    testing.AssertEqInt(outer.nestedMessages.len(), 1)
    testing.AssertEqStr(outer.nestedMessages.get(0)[0].name, "Inner")

    testing.AssertEqInt(outer.oneofs.len(), 1)
    testing.AssertEqStr(outer.oneofs.get(0)[0].name, "choice")
    testing.AssertEqInt(outer.oneofs.get(0)[0].fieldIndices.len(), 2)

    // map<string,int32> counts = 3 became a field with kind FK_MAP
    mut foundMap := false
    mut mi := 0
    until mi < outer.fields.len():
        of := outer.fields.get(mi)[0]
        if of.name == "counts":
            foundMap = true
            testing.AssertEqInt(of.kind, protobuf.FK_MAP)
            testing.AssertEqInt(of.keyKind, protobuf.FK_STRING)
            testing.AssertEqInt(of.mapValueKind, protobuf.FK_INT32)
        end
        mi += 1
    end
    testing.AssertTrue(foundMap)

    // malformed input is recovered from, not a hard crash, and ok=false
    mut ok3 := false
    protobuf.ParseFile(`message Bad { string x = ; }`, ok3)
    testing.AssertFalse(ok3)

    os.Exit(testing.Summary())
end
