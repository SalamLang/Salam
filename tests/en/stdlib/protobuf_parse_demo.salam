package main

import encoding.protobuf
import testing

func checks() throws:
    src := `syntax = "proto3";
message Person {
  string name = 1;
  int32 age = 2;
  repeated string emails = 3;
}`
    f := try protobuf.ParseFile(src)
    testing.AssertEqInt(f.messages.len(), 1)
    msg := f.messages.get(0)
    testing.AssertEqStr(msg.name, "Person")
    testing.AssertEqInt(msg.fields.len(), 3)

    f0 := msg.fields.get(0)
    testing.AssertEqStr(f0.name, "name")
    testing.AssertEqInt(f0.kind, protobuf.FK_STRING)
    testing.AssertEqInt(f0.number, 1)
    testing.AssertFalse(f0.repeated)

    f1 := msg.fields.get(1)
    testing.AssertEqStr(f1.name, "age")
    testing.AssertEqInt(f1.kind, protobuf.FK_INT32)
    testing.AssertEqInt(f1.number, 2)

    f2 := msg.fields.get(2)
    testing.AssertEqStr(f2.name, "emails")
    testing.AssertEqInt(f2.kind, protobuf.FK_STRING)
    testing.AssertEqInt(f2.number, 3)
    testing.AssertTrue(f2.repeated)

    src2 := `message Outer {
  enum Status {
    UNKNOWN = 0;
    ACTIVE = 1;
  }
  message Inner {
    int32 x = 1;
  }
  oneof choice {
    string a = 1;
    int32 b = 2;
  }
  map<string, int32> counts = 3;
}`
    f_outer := try protobuf.ParseFile(src2)
    testing.AssertEqInt(f_outer.messages.len(), 1)
    outer := f_outer.messages.get(0)
    testing.AssertEqInt(outer.nestedEnums.len(), 1)
    testing.AssertEqStr(outer.nestedEnums.get(0).name, "Status")
    testing.AssertEqInt(outer.nestedEnums.get(0).values.len(), 2)
    testing.AssertEqStr(outer.nestedEnums.get(0).values.get(1).name, "ACTIVE")
    testing.AssertEqInt(outer.nestedEnums.get(0).values.get(1).number, 1)

    testing.AssertEqInt(outer.nestedMessages.len(), 1)
    testing.AssertEqStr(outer.nestedMessages.get(0).name, "Inner")

    testing.AssertEqInt(outer.oneofs.len(), 1)
    testing.AssertEqStr(outer.oneofs.get(0).name, "choice")
    testing.AssertEqInt(outer.oneofs.get(0).fieldIndices.len(), 2)

    mut foundMap := false
    mut mi := 0
    until mi < outer.fields.len():
        of := outer.fields.get(mi)
        if of.name == "counts":
            foundMap = true
            testing.AssertEqInt(of.kind, protobuf.FK_MAP)
            testing.AssertEqInt(of.keyKind, protobuf.FK_STRING)
            testing.AssertEqInt(of.mapValueKind, protobuf.FK_INT32)
        end
        mi++
    end
    testing.AssertTrue(foundMap)

    mut failed := false
    try:
        protobuf.ParseFile(`message Bad { string x = ; }`)
    catch e:
        failed = true
        testing.AssertTrue(e.is(ErrorKind.Syntax))
        testing.AssertEqStr(e.code, "protobuf.unexpected_token")
        testing.AssertEqInt(e.line, 1)
        testing.AssertEqInt(e.column, 26)
    end
    testing.AssertTrue(failed)
end

func main:
    try:
        checks()
    catch e:
        testing.AssertMsg(false, e.to_str())
    end
    ret testing.Summary()
end
