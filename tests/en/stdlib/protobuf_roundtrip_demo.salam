package main

import encoding.protobuf
import compress
import testing

pub struct Person:
    pub name: str = ""
    pub age: i64 = 0 as i64
    pub emails: Vector<str> = Vector {}
end

pub func MarshalPerson(m: Person): compress.ByteBuf:
    mut buf := compress.NewByteBuf()
    if m.name.len() > 0:
        protobuf.WriteTag(buf, 1, protobuf.WT_LEN)
        protobuf.WriteLenPrefixedStr(buf, m.name)
    end
    if m.age != (0 as i64):
        protobuf.WriteTag(buf, 2, protobuf.WT_VARINT)
        protobuf.WriteVarint(buf, m.age as u64)
    end
    mut ri3 := 0
    until ri3 < m.emails.len():
        protobuf.WriteTag(buf, 3, protobuf.WT_LEN)
        protobuf.WriteLenPrefixedStr(buf, m.emails.get(ri3))
        ri3++
    end
    ret buf
end

pub func UnmarshalPerson(data: void*, n: int): Person throws:
    mut out := Person {}
    mut r := compress.NewByteReader(data, n)
    try:
        until compress.RdLeft(r) > 0:
            at := r.pos
            mut fnum := 0
            mut wtype := 0
            protobuf.ReadTag(r, fnum, wtype)
            if fnum == 1:
                if wtype != protobuf.WT_LEN:
                    throw Error.At(ErrorKind.TypeMismatch, "field 1 (name) has wire type " + wtype + ", expected " + protobuf.WT_LEN, at).with_code("protobuf.wire_type_mismatch").wrap("protobuf")
                end
                out.name = protobuf.ReadLenPrefixedStr(r)
            else fnum == 2:
                if wtype != protobuf.WT_VARINT:
                    throw Error.At(ErrorKind.TypeMismatch, "field 2 (age) has wire type " + wtype + ", expected " + protobuf.WT_VARINT, at).with_code("protobuf.wire_type_mismatch").wrap("protobuf")
                end
                out.age = protobuf.ReadVarint(r) as i64
            else fnum == 3:
                if wtype != protobuf.WT_LEN:
                    throw Error.At(ErrorKind.TypeMismatch, "field 3 (emails) has wire type " + wtype + ", expected " + protobuf.WT_LEN, at).with_code("protobuf.wire_type_mismatch").wrap("protobuf")
                end
                out.emails.push(protobuf.ReadLenPrefixedStr(r))
            else:
                protobuf.SkipField(r, wtype)
            end
        end
    catch e:
        throw e.wrap("Person")
    end
    ret out
end

pub func checks() throws:
    mut p := Person {}
    p.name = "Ada"
    p.age = 36 as i64
    p.emails.push("ada@example.com")
    p.emails.push("ada2@example.com")

    mut buf := MarshalPerson(p)
    p2 := try UnmarshalPerson(buf.data, buf.len)

    testing.AssertEqStr(p2.name, "Ada")
    testing.AssertEqInt64(p2.age, 36 as i64)
    testing.AssertEqInt(p2.emails.len(), 2)
    testing.AssertEqStr(p2.emails.get(0), "ada@example.com")
    testing.AssertEqStr(p2.emails.get(1), "ada2@example.com")

    empty := Person {}
    mut emptyBuf := MarshalPerson(empty)
    testing.AssertEqInt(compress.BufLen(emptyBuf), 0)
    roundEmpty := try UnmarshalPerson(emptyBuf.data, emptyBuf.len)
    testing.AssertEqStr(roundEmpty.name, "")
    testing.AssertEqInt64(roundEmpty.age, 0 as i64)

    mut extra := compress.NewByteBuf()
    protobuf.WriteTag(extra, 99, protobuf.WT_VARINT)
    protobuf.WriteVarint(extra, 12345 as u64)
    protobuf.WriteTag(extra, 1, protobuf.WT_LEN)
    protobuf.WriteLenPrefixedStr(extra, "Grace")
    p3 := try UnmarshalPerson(extra.data, extra.len)
    testing.AssertEqStr(p3.name, "Grace")

    mut failed := false
    try:
        UnmarshalPerson(buf.data, buf.len - 3)
    catch e:
        failed = true
        testing.AssertTrue(e.is(ErrorKind.UnexpectedEnd))
        testing.AssertEqStr(e.context, "Person: protobuf")
    end
    testing.AssertTrue(failed)

    compress.BufFree(buf)
    compress.BufFree(emptyBuf)
    compress.BufFree(extra)
end

func main:
    try:
        checks()
    catch e:
        testing.AssertMsg(false, e.to_str())
    end
    ret testing.Summary()
end
