package main

import encoding.protobuf

func main:
    src := `syntax = "proto3";
message Ping { string text = 1; }
message Pong { string text = 1; }
service Echo {
    rpc Once(Ping) returns (Pong);
    rpc Upload(stream Ping) returns (Pong);
    rpc Watch(Ping) returns (stream Pong);
    rpc Chat(stream Ping) returns (stream Pong);
}
`
    try:
        f := protobuf.ParseFile(src)
        println protobuf.ServiceCount(f), protobuf.ServiceNameAt(f, 0), protobuf.ServiceMethodCount(f, 0)
        println protobuf.ServiceMethodSignature(f, 0, 0)
        println protobuf.ServiceMethodSignature(f, 0, 1)
        println protobuf.ServiceMethodSignature(f, 0, 2)
        println protobuf.ServiceMethodSignature(f, 0, 3)
        println protobuf.ServiceMethodSignature(f, 0, 4) == "", protobuf.ServiceMethodSignature(f, 1, 0) == ""
        stubs := protobuf.GenerateServices(f)
        println stubs.len() > 0, stubs.includes("Echo"), stubs.includes("Upload"), stubs.includes("Chat")
        plain := protobuf.ParseFile("message Solo { int32 id = 1; }")
        println protobuf.GenerateServices(plain) == ""
    catch e:
        println e.to_str()
    end
    try:
        _ := protobuf.ParseFile("service Broken { rpc Go(Ping) returns Pong; }")
        println "parsed"
    catch e:
        println e.is(ErrorKind.Syntax), e.line, e.code
    end
end
