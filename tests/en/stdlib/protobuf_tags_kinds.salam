package main

import compress
import encoding.protobuf

func main:
    println protobuf.MakeTag(1, protobuf.WT_VARINT) as int, protobuf.MakeTag(2, protobuf.WT_LEN) as int, protobuf.MakeTag(15, protobuf.WT_FIXED32) as int

    println protobuf.FieldKindName(protobuf.FK_DOUBLE), protobuf.FieldKindName(protobuf.FK_SINT64), protobuf.FieldKindName(protobuf.FK_STRING), protobuf.FieldKindName(protobuf.FK_MAP), protobuf.FieldKindName(999)
    println protobuf.ScalarKindFromName("double") == protobuf.FK_DOUBLE, protobuf.ScalarKindFromName("bytes") == protobuf.FK_BYTES, protobuf.ScalarKindFromName("Widget"), protobuf.ScalarKindFromName(protobuf.FieldKindName(protobuf.FK_SFIXED32)) == protobuf.FK_SFIXED32

    mut buf := compress.NewByteBuf()
    protobuf.WriteLenPrefixedStr(buf, "hello")
    protobuf.WriteLenPrefixedStr(buf, "")
    mut r := compress.ReaderFromBuf(buf)
    mut ok := false
    first := protobuf.ReadLenPrefixedBuf(r, ok)
    println ok, compress.BufLen(first), compress.BufToStrUnsafe(first)
    second := protobuf.ReadLenPrefixedBuf(r, ok)
    println ok, compress.BufLen(second)
    third := protobuf.ReadLenPrefixedBuf(r, ok)
    println ok, compress.BufLen(third)

    mut cut := compress.NewByteBuf()
    compress.BufPush(cut, 9)
    compress.BufPush(cut, 97)
    mut rc := compress.ReaderFromBuf(cut)
    short := protobuf.ReadLenPrefixedBuf(rc, ok)
    println ok, compress.BufLen(short)
end
