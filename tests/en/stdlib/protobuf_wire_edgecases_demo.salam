package main

import encoding.protobuf
import compress
import testing

const V := 0
const TAG := 1
const F32 := 2
const F64 := 3
const FLT := 4
const DBL := 5
const LSTR := 6
const LBUF := 7

func read_kind(b: compress.ByteBuf, what: int): ErrorKind:
    mut r := compress.NewByteReader(b.data, b.len)
    mut fnum := 0
    mut wtype := 0
    try:
        if what == V:
            protobuf.ReadVarint(r)
        else what == TAG:
            protobuf.ReadTag(r, fnum, wtype)
        else what == F32:
            protobuf.ReadFixed32(r)
        else what == F64:
            protobuf.ReadFixed64(r)
        else what == FLT:
            protobuf.ReadFloat(r)
        else what == DBL:
            protobuf.ReadDouble(r)
        else what == LSTR:
            protobuf.ReadLenPrefixedStr(r)
        else:
            mut lb := protobuf.ReadLenPrefixedBuf(r)
            compress.BufFree(lb)
        end
    catch e:
        ret e.kind
    end
    ret ErrorKind.Internal
end

func skip_kind(b: compress.ByteBuf, wireType: int): ErrorKind:
    mut r := compress.NewByteReader(b.data, b.len)
    try:
        protobuf.SkipField(r, wireType)
    catch e:
        ret e.kind
    end
    ret ErrorKind.Internal
end

func checks() throws:
    mut bEmpty := compress.NewByteBuf()
    testing.AssertTrue(read_kind(bEmpty, V) == ErrorKind.UnexpectedEnd)
    testing.AssertTrue(read_kind(bEmpty, TAG) == ErrorKind.UnexpectedEnd)

    mut bTrunc := compress.NewByteBuf()
    compress.BufPush(bTrunc, 0x80)
    compress.BufPush(bTrunc, 0x80)
    testing.AssertTrue(read_kind(bTrunc, V) == ErrorKind.UnexpectedEnd)

    mut bOver := compress.NewByteBuf()
    repeat 10: compress.BufPush(bOver, 0xff) end
    compress.BufPush(bOver, 0)
    testing.AssertTrue(read_kind(bOver, V) == ErrorKind.OutOfRange)

    mut bMax := compress.NewByteBuf()
    protobuf.WriteVarint(bMax, 18446744073709551615 as u64)
    testing.AssertEqInt(compress.BufLen(bMax), 10)
    mut rMax := compress.NewByteReader(bMax.data, bMax.len)
    testing.AssertTrue((try protobuf.ReadVarint(rMax)) == (18446744073709551615 as u64))

    mut bShort := compress.NewByteBuf()
    compress.BufPush(bShort, 1)
    compress.BufPush(bShort, 2)
    testing.AssertTrue(read_kind(bShort, F32) == ErrorKind.UnexpectedEnd)
    testing.AssertTrue(read_kind(bShort, F64) == ErrorKind.UnexpectedEnd)
    testing.AssertTrue(read_kind(bShort, FLT) == ErrorKind.UnexpectedEnd)
    testing.AssertTrue(read_kind(bShort, DBL) == ErrorKind.UnexpectedEnd)

    mut bBadLen := compress.NewByteBuf()
    protobuf.WriteVarint(bBadLen, 100 as u64)
    compress.BufPush(bBadLen, 65)
    testing.AssertTrue(read_kind(bBadLen, LSTR) == ErrorKind.UnexpectedEnd)
    testing.AssertTrue(read_kind(bBadLen, LBUF) == ErrorKind.UnexpectedEnd)

    mut bWire := compress.NewByteBuf()
    protobuf.WriteTag(bWire, 1, 7)
    testing.AssertTrue(read_kind(bWire, TAG) == ErrorKind.Syntax)
    mut bZero := compress.NewByteBuf()
    protobuf.WriteTag(bZero, 0, protobuf.WT_VARINT)
    testing.AssertTrue(read_kind(bZero, TAG) == ErrorKind.Syntax)

    mut bAny := compress.NewByteBuf()
    compress.BufPush(bAny, 0)
    testing.AssertTrue(skip_kind(bAny, 3) == ErrorKind.Unsupported)
    testing.AssertTrue(skip_kind(bAny, 6) == ErrorKind.Syntax)
    testing.AssertTrue(skip_kind(bShort, protobuf.WT_FIXED64) == ErrorKind.UnexpectedEnd)
    testing.AssertTrue(skip_kind(bBadLen, protobuf.WT_LEN) == ErrorKind.UnexpectedEnd)

    mut bSkip := compress.NewByteBuf()
    protobuf.WriteFixed32(bSkip, 1 as u32)
    protobuf.WriteFixed64(bSkip, 2 as u64)
    protobuf.WriteLenPrefixedStr(bSkip, "skip-me")
    protobuf.WriteVarint(bSkip, 9 as u64)
    mut rSkip := compress.NewByteReader(bSkip.data, bSkip.len)
    try protobuf.SkipField(rSkip, protobuf.WT_FIXED32)
    testing.AssertEqInt(rSkip.pos, 4)
    try protobuf.SkipField(rSkip, protobuf.WT_FIXED64)
    testing.AssertEqInt(rSkip.pos, 12)
    try protobuf.SkipField(rSkip, protobuf.WT_LEN)
    testing.AssertEqInt(rSkip.pos, 20)
    tail := try protobuf.ReadVarint(rSkip)
    testing.AssertEqInt64(tail as i64, 9 as i64)

    compress.BufFree(bEmpty)
    compress.BufFree(bTrunc)
    compress.BufFree(bOver)
    compress.BufFree(bMax)
    compress.BufFree(bShort)
    compress.BufFree(bBadLen)
    compress.BufFree(bWire)
    compress.BufFree(bZero)
    compress.BufFree(bAny)
    compress.BufFree(bSkip)
end

func main:
    try:
        checks()
    catch e:
        testing.AssertMsg(false, e.to_str())
    end
    ret testing.Summary()
end
