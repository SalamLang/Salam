package main

import encoding.query
import testing
import os
import str

func main:
    // basic decode
    testing.AssertEqStr(query.Get("a=1&b=2&b=3", "a"), "1")
    all_b := query.GetAll("a=1&b=2&b=3", "b")
    testing.AssertEqInt(all_b.len(), 2)
    testing.AssertEqStr(all_b.get(0), "2")
    testing.AssertEqStr(all_b.get(1), "3")
    testing.AssertTrue(query.Has("a=1&b=2&b=3", "a"))
    testing.AssertFalse(query.Has("a=1&b=2&b=3", "z"))

    // leading '?'
    testing.AssertEqStr(query.Get("?a=1", "a"), "1")

    // bare key, empty value
    testing.AssertTrue(query.Has("flag", "flag"))
    testing.AssertEqStr(query.Get("flag", "flag"), "")
    testing.AssertEqStr(query.Get("a=", "a"), "")

    // '&&' skip
    m2 := query.Decode("a=1&&b=2")
    testing.AssertEqInt(query.Size(m2), 2)

    // empty / bare '?'
    m3 := query.Decode("")
    testing.AssertEqInt(query.Size(m3), 0)
    m4 := query.Decode("?")
    testing.AssertEqInt(query.Size(m4), 0)

    // '+' vs '%20' round trip under both settings
    testing.AssertEqStr(query.Get("q=a+b", "q"), "a b")
    optsNoPlus := query.QueryOptions { space_as_plus = false }
    mNoPlus := query.DecodeWith("q=a+b", optsNoPlus)
    testing.AssertEqStr(mNoPlus.data.get("q").items.get(0), "a+b")

    // encode round trip
    mut vals := query.NewQueryMap()
    query.Set(vals, "name", "salam lang")
    query.Add(vals, "tag", "x")
    query.Add(vals, "tag", "y")
    encoded := query.Encode(vals)
    decoded := query.Decode(encoded)
    testing.AssertEqStr(decoded.data.get("name").items.get(0), "salam lang")
    tagvals := decoded.data.get("tag").items
    testing.AssertEqInt(tagvals.len(), 2)

    // space_as_plus encode uses '+' not '%20'
    mut vals2 := query.NewQueryMap()
    query.Set(vals2, "q", "a b")
    enc2 := query.Encode(vals2)
    testing.AssertTrue(str.Contains(enc2, "+"))
    testing.AssertFalse(str.Contains(enc2, "%20"))

    os.Exit(testing.Summary())
end
