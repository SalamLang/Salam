// Edge cases for encoding.query, complementing query_demo.salam's happy-path
// decode/encode/round-trip coverage.

package main

import encoding.query
import testing
import os

func main:
    // a value containing '=' keeps everything after the first '=' verbatim
    testing.AssertEqStr(query.Get("expr=a=b=c", "expr"), "a=b=c")

    // percent-encoded non-ASCII bytes decode back to the original bytes
    // (percent-encoding is byte-oriented, not codepoint-aware, so a UTF-8
    // multi-byte sequence just round trips as its own byte sequence)
    encodedUnicode := "name=%C3%A9"
    testing.AssertEqStr(query.Get(encodedUnicode, "name"), `é`)

    // Set replaces any existing values for a key; Add appends alongside them
    mut m := query.NewQueryMap()
    query.Add(m, "tag", "a")
    query.Add(m, "tag", "b")
    testing.AssertEqInt(m.data.get("tag").items.len(), 2)
    query.Set(m, "tag", "only")
    testing.AssertEqInt(m.data.get("tag").items.len(), 1)
    testing.AssertEqStr(m.data.get("tag").items.get(0)[0], "only")

    // Size reflects distinct keys, not total values
    mut m2 := query.NewQueryMap()
    query.Add(m2, "a", "1")
    query.Add(m2, "a", "2")
    query.Add(m2, "b", "3")
    testing.AssertEqInt(query.Size(m2), 2)

    // a key with no '=' and no following '&' (bare trailing key)
    testing.AssertTrue(query.Has("a=1&bare", "bare"))
    testing.AssertEqStr(query.Get("a=1&bare", "bare"), "")

    // GetAll on a missing key returns an empty (not null) vector
    missing := query.GetAll("a=1", "nope")
    testing.AssertEqInt(missing.len(), 0)

    // reserved characters (&, =, +, %, space) survive an encode/decode round trip
    mut m3 := query.NewQueryMap()
    query.Set(m3, "k", "a&b=c+d%e f")
    roundTripped := query.Decode(query.Encode(m3))
    testing.AssertEqStr(roundTripped.data.get("k").items.get(0)[0], "a&b=c+d%e f")

    // an empty value for a key still counts as present with one empty item
    mut m4 := query.NewQueryMap()
    query.Add(m4, "empty", "")
    testing.AssertTrue(m4.data.has("empty"))
    testing.AssertEqInt(m4.data.get("empty").items.len(), 1)
    testing.AssertEqStr(m4.data.get("empty").items.get(0)[0], "")

    os.Exit(testing.Summary())
end
