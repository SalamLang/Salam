package main

import encoding.query
import testing

func run(): int throws:
    testing.AssertEqStr(query.Get("expr=a=b=c", "expr"), "a=b=c")

    encodedUnicode := "name=%C3%A9"
    testing.AssertEqStr(query.Get(encodedUnicode, "name"), `é`)

    mut m := query.NewQueryMap()
    query.Add(m, "tag", "a")
    query.Add(m, "tag", "b")
    testing.AssertEqInt(m.data.Get("tag").items.Len(), 2)
    query.Set(m, "tag", "only")
    testing.AssertEqInt(m.data.Get("tag").items.Len(), 1)
    testing.AssertEqStr(m.data.Get("tag").items.Get(0), "only")

    mut m2 := query.NewQueryMap()
    query.Add(m2, "a", "1")
    query.Add(m2, "a", "2")
    query.Add(m2, "b", "3")
    testing.AssertEqInt(query.Size(m2), 2)

    testing.AssertTrue(query.Has("a=1&bare", "bare"))
    testing.AssertEqStr(query.Get("a=1&bare", "bare"), "")

    missing := query.GetAll("a=1", "nope")
    testing.AssertEqInt(missing.Len(), 0)

    mut m3 := query.NewQueryMap()
    query.Set(m3, "k", "a&b=c+d%e f")
    roundTripped := try query.Decode(query.Encode(m3))
    testing.AssertEqStr(roundTripped.data.Get("k").items.Get(0), "a&b=c+d%e f")

    mut m4 := query.NewQueryMap()
    query.Add(m4, "empty", "")
    testing.AssertTrue(m4.data.Has("empty"))
    testing.AssertEqInt(m4.data.Get("empty").items.Len(), 1)
    testing.AssertEqStr(m4.data.Get("empty").items.Get(0), "")

    ret testing.Summary()
end

func main:
    try:
        ret run()
    catch e:
        println "unexpected error: " + e.ToStr()
        ret 1
    end
end
