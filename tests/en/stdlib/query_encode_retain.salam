package main

import encoding.query

func main:
    mut vals := query.NewQueryMap()
    query.Set(vals, "q", "a b")
    query.Add(vals, "tag", "x y")
    query.Add(vals, "tag", "z")
    println query.EncodeWith(vals, query.QueryOptions { space_as_plus = true })
    println query.EncodeWith(vals, query.QueryOptions { space_as_plus = false })
    println query.Encode(vals) == query.EncodeWith(vals, query.QueryOptions {})

    try:
        mut m := query.Decode("a=1&b=2&c=3&c=4&d=5")
        println query.Size(m)
        mut keep := Vector {} as Vector<str>
        keep.push("b")
        keep.push("c")
        keep.push("missing")
        query.Retain(m, keep)
        println query.Size(m), query.Encode(m)
        println query.Keys(m).Len(), query.Remove(m, "a"), query.Remove(m, "b")
        none := Vector {} as Vector<str>
        query.Retain(m, none)
        println query.Size(m), query.Encode(m) == ""
    catch e:
        println e.ToStr()
    end
    try:
        _ := query.Decode("a=%G1")
        println "decoded"
    catch e:
        println e.is(ErrorKind.Syntax), e.offset, e.ToStr()
    end
end
