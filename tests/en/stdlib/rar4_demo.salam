func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func show(label: str, a: compress.ByteBuf):
    mut es := archive.RarList(a.data, a.len)
    println label, es.Len()
    repeat es.Len() in i:
        e := es.Get(i)
        println " ", e.name, e.size, e.compressed_size, e.is_dir, e.method, e.crc32
    end
    archive.FreeEntries(es)
end

func get(a: compress.ByteBuf, name: str): int:
    mut st := 0
    mut out := archive.RarExtract(a.data, a.len, name, 0, st)
    println " ", name, out.len, compress.CRC32Buf(out), archive.RarStatusText(st)
    compress.BufFree(out)
    ret st
end

func main:
    mut low := unhex(LOWDIST)
    mut filt := unhex(FILTER)
    println archive.IsRar(low.data, low.len), archive.IsRar(filt.data, filt.len)
    show("lowdist", low)
    get(low, "lowdist-reset.bin")
    mut old15 := unhex(OLD15)
    mut old20 := unhex(OLD20)
    show("rar15", old15)
    get(old15, "FILE1.TXT")
    show("rar20", old20)
    get(old20, "file.txt")
    show("filter", filt)
    get(filt, "f2500.bin")
    mut bad := compress.BufClone(low)
    p := bad.data as u8*
    p[95] = ((p[95] as int) ^ 0x10) as u8
    println get(bad, "lowdist-reset.bin") != archive.RAR_OK
    compress.BufFree(bad)
    compress.BufFree(low)
    compress.BufFree(filt)
    compress.BufFree(old15)
    compress.BufFree(old20)
    ret 0
end
