func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func attempt(label: str, rar: compress.ByteBuf, password: str):
    mut arc := archive.RarOpen(rar.data, rar.len, password)
    mut es := archive.RarEntries(arc)
    println label, es.Len(), archive.RarStatusText(arc.status)
    repeat es.Len() in i:
        e := es.Get(i)
        mut out := archive.RarRead(arc, e.name, 0)
        println " ", e.name, e.size, out.len, compress.CRC32Buf(out), archive.RarStatusText(arc.status)
        compress.BufFree(out)
    end
    archive.FreeEntries(es)
    archive.RarClose(arc)
end

func main:
    mut p5d := unhex(P5DATA)
    mut p5h := unhex(P5HDR)
    mut p4h := unhex(P4HDR)
    mut p4s := unhex(P4SOLID)
    attempt("rar5 data, no password", p5d, "")
    attempt("rar5 data, wrong password", p5d, "nope")
    attempt("rar5 data", p5d, "secret")
    attempt("rar5 headers, no password", p5h, "")
    attempt("rar5 headers, wrong password", p5h, "nope")
    attempt("rar5 headers", p5h, "secret")
    attempt("rar4 headers, wrong password", p4h, "nope")
    attempt("rar4 headers", p4h, "password")
    attempt("rar4 solid", p4s, "password")
    attempt("rar4 solid, wrong password", p4s, "nope")

    dir := filepath.Join(os.TempDir(), "salam_rar_crypt")
    os.RemoveAll(dir)
    mut arc := archive.RarOpen(p5h.data, p5h.len, "secret")
    println archive.RarReadAll(arc, dir), archive.RarStatusText(arc.status)
    mut ok := false
    target := filepath.Join(dir, "n2.txt")
    mut back := archive.ReadBinaryFile(target, ok)
    println ok, back.len
    compress.BufFree(back)
    mem.Free(target as void*)
    archive.RarClose(arc)
    os.RemoveAll(dir)
    mem.Free(dir as void*)
    compress.BufFree(p5d)
    compress.BufFree(p5h)
    compress.BufFree(p4h)
    compress.BufFree(p4s)
    ret 0
end
