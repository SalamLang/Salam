65e4bc54209456fee611ceb6917103e3d867f6cd23dd2ac3a10d4b5bb773d895311d77565103050400
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func show(label: str, a: compress.ByteBuf):
    mut es := archive.RarList(a.data, a.len)
    println label, es.Len()
    repeat es.Len() in i:
        e := es.get(i)
        println " ", e.name, e.size, e.compressed_size, e.is_dir, e.method, e.crc32
    end
    archive.FreeEntries(es)
end

func get(a: compress.ByteBuf, name: str, max: int): int:
    mut st := 0
    mut out := archive.RarExtract(a.data, a.len, name, max, st)
    println " ", name, out.len, compress.CRC32Buf(out), archive.RarStatusText(st)
    compress.BufFree(out)
    ret st
end

func text_in(dir: str, name: str): str:
    path := filepath.Join(dir, name)
    defer mem.Free(path as void*)
    mut ok := false
    mut buf := archive.ReadBinaryFile(path, ok)
    defer compress.BufFree(buf)
    if not ok:
        ret str.Clone("missing")
    end
    ret compress.BufToStrUnsafe(buf)
end

func print_text(dir: str, name: str):
    t := text_in(dir, name)
    println t
    mem.Free(t as void*)
end

func exists_in(dir: str, name: str): bool:
    path := filepath.Join(dir, name)
    found := os.Exists(path)
    mem.Free(path as void*)
    ret found
end

func size_in(dir: str, name: str): i64:
    path := filepath.Join(dir, name)
    n := os.FileSize(path)
    mem.Free(path as void*)
    ret n
end

func main:
    mut solid := unhex(SOLID)
    mut filt := unhex(FILT)
    mut enc := unhex(ENC)
    mut empty1 := unhex(EMPTY1)
    println archive.IsRar(solid.data, solid.len), archive.IsRar(filt.data, filt.len), archive.IsRar(enc.data, 3)
    show("solid", solid)
    show("filters", filt)
    show("emptyfirst", empty1)
    println "extract"
    get(empty1, "b.txt", 0)
    get(empty1, "a.txt", 0)
    get(solid, "a.txt", 0)
    get(solid, "b.txt", 0)
    get(solid, "empty.txt", 0)
    get(solid, "none.txt", 0)
    get(solid, "a.txt", 10)
    get(filt, "code.bin", 0)
    get(filt, "audio.bin", 0)
    get(enc, "a.txt", 0)

    println "damaged"
    mut bad := compress.BufClone(solid)
    p := bad.data as u8*
    p[195] = ((p[195] as int) ^ 0x55) as u8
    println get(bad, "b.txt", 0) != archive.RAR_OK
    mut cut := compress.BufClone(filt)
    cut.len /= 2
    mut cut_list := archive.RarList(cut.data, cut.len)
    println cut_list.Len() <= 2, get(cut, "audio.bin", 0) != archive.RAR_OK
    archive.FreeEntries(cut_list)
    compress.BufFree(bad)
    compress.BufFree(cut)

    println "create"
    d1 := "hello rar world\n"
    d2 := "second file"
    mut files := Vector {} as Vector<archive.RarFileInput>
    files.push(archive.MakeRarFileInput("docs/", null, 0, true))
    files.push(archive.MakeRarFileInput("docs/hello.txt", d1 as void*, d1.Len(), false))
    mut f2 := archive.MakeRarFileInput("docs/second.txt", d2 as void*, d2.Len(), false)
    f2.mtime = 1700000000 as i64
    files.push(f2)
    files.push(archive.MakeRarFileInput("empty.txt", null, 0, false))
    files.push(archive.MakeRarFileInput("../escape.txt", d1 as void*, d1.Len(), false))
    mut made := archive.RarCreate(files)
    show("made", made)
    get(made, "docs/hello.txt", 0)
    get(made, "docs/second.txt", 0)
    mut ok := false
    mut small := archive.RarExtractByNameMax(made.data, made.len, "docs/hello.txt", 5, ok)
    println ok, small.len
    mut whole := archive.RarExtractByNameMax(made.data, made.len, "docs/hello.txt", 100, ok)
    println ok, whole.len
    disk := filepath.Join(os.TempDir(), "salam_rar_demo.rar")
    println archive.RarCreateFile(files, disk)
    mut back := archive.ReadBinaryFile(disk, ok)
    println ok, back.len == made.len
    compress.BufFree(small)
    compress.BufFree(whole)
    compress.BufFree(back)
    os.Remove(disk)
    mem.Free(disk as void*)

    dir := filepath.Join(os.TempDir(), "salam_rar_demo")
    os.RemoveAll(dir)
    mut st := 0
    n := archive.RarExtractAllStatus(made.data, made.len, dir, st)
    println n, archive.RarStatusText(st)
    print_text(dir, "docs/hello.txt")
    print_text(dir, "docs/second.txt")
    println exists_in(dir, "empty.txt"), exists_in(dir, "../escape.txt")
    println archive.RarExtractAll(filt.data, filt.len, dir), size_in(dir, "audio.bin")
    os.RemoveAll(dir)
    mem.Free(dir as void*)

    println "status"
    println archive.RarStatusText(archive.RAR_OK), "|", archive.RarStatusText(archive.RAR_UNSUPPORTED), "|", archive.RarStatusText(archive.RAR_BAD_CRC), "|", archive.RarStatusText(archive.RAR_MULTIVOLUME), "|", archive.RarStatusText(99)
    files.free()
    compress.BufFree(made)
    compress.BufFree(solid)
    compress.BufFree(filt)
    compress.BufFree(enc)
    compress.BufFree(empty1)
    ret 0
end
