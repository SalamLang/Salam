const ENC := """
526172211a070100f3e182eb0b0105070006010180808000fb515a5a5402033cc000049c04a48302096aa6c880030105
612e747874300100030fc6282f5b4204e4d8a9c859b359ec8e6efd923f3b337b5f6192cee0a6c46b89f6d74213dbd0e2
