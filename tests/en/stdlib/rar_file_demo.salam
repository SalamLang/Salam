func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func cat(a: str, b: str): str:
    ret filepath.Join(a, b)
end

func check(label: str, hex: str, dir: str):
    mut packed := unhex(hex)
    path := cat(dir, "a.rar")
    archive.WriteBinaryFileBuf(path, packed)
    mut rf := archive.RarFileOpen(path)
    println label, "open", rf.status, rf.streaming
    mut es := archive.RarFileEntries(rf)
    mut mem_list := archive.RarList(packed.data, packed.len)
    println " entries", es.Len(), mem_list.Len()
    out := cat(dir, "one.out")
    repeat es.Len() in i:
        e := es.Get(i)
        if e.is_dir:
            continue
        end
        st := archive.RarFileExtractTo(rf, e.name, out, 0 as i64, 0 as i64)
        mut mst := 0
        mut ok := false
        mut disk := archive.ReadBinaryFile(out, ok)
        mut want := archive.RarExtract(packed.data, packed.len, e.name, 0, mst)
        println " ", e.name, st, disk.len, compress.CRC32Buf(disk) == compress.CRC32Buf(want)
        compress.BufFree(disk)
        compress.BufFree(want)
    end
    println " cap", archive.RarFileExtractTo(rf, es.Get(0).name, out, 1 as i64, 0 as i64), archive.RarFileExtractTo(rf, "none", out, 0 as i64, 0 as i64)
    all := cat(dir, "all")
    os.RemoveAll(all)
    println " all", archive.RarFileExtractAll(rf, all, 0 as i64, 0 as i64)
    archive.FreeEntries(es)
    archive.FreeEntries(mem_list)
    archive.RarFileClose(rf)
    compress.BufFree(packed)
    mem.Free(path as void*)
    mem.Free(out as void*)
    mem.Free(all as void*)
end

func main:
    dir := cat(os.TempDir(), "salam_rar_file_demo")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    check("solid", SOLID, dir)
    check("filters", FILT, dir)
    check("rar4", LOWDIST, dir)
    path := cat(dir, "none.rar")
    mut missing := archive.RarFileOpen(path)
    println "missing", missing.status, archive.RarStatusText(missing.status)
    archive.RarFileClose(missing)
    mut junk := compress.BufFromStr("not a rar file at all")
    path2 := cat(dir, "junk.rar")
    archive.WriteBinaryFileBuf(path2, junk)
    mut bad := archive.RarFileOpen(path2)
    println "junk", bad.status
    archive.RarFileClose(bad)
    compress.BufFree(junk)
    os.RemoveAll(dir)
    mem.Free(dir as void*)
    mem.Free(path as void*)
    mem.Free(path2 as void*)
    ret 0
end
