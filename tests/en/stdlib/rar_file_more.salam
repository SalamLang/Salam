func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    mut i := 0
    until i < s.Len():
        v := nib(bp[i] as int)
        i++
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func save(dir: str, name: str, hex: str): str:
    mut b := unhex(hex)
    path := filepath.Join(dir, name)
    _ := archive.WriteBinaryFileBuf(path, b)
    compress.BufFree(b)
    ret path
end

func crc_of(path: str): i64:
    mut ok := false
    mut b := archive.ReadBinaryFile(path, ok)
    if not ok:
        ret -1
    end
    r := compress.CRC32Buf(b) as i64
    compress.BufFree(b)
    ret r
end

func crc_in(dir: str, name: str): i64:
    path := filepath.Join(dir, name)
    r := crc_of(path)
    mem.Free(path as void*)
    ret r
end

func exists_in(dir: str, name: str): bool:
    path := filepath.Join(dir, name)
    r := os.Exists(path)
    mem.Free(path as void*)
    ret r
end

func attempt(label: str, path: str, password: str, dir: str):
    mut rf := archive.RarFileOpenWith(path, password)
    mut es := archive.RarFileEntries(rf)
    println label, es.Len(), archive.RarStatusText(rf.status)
    dest := filepath.Join(dir, "one.bin")
    each e in es:
        st := archive.RarFileExtractTo(rf, e.name, dest, 0 as i64, 0 as i64)
        println " ", e.name, e.size, archive.RarStatusText(st), st == archive.RAR_OK ? crc_of(dest) : -1 as i64
        os.Remove(dest)
    end
    mem.Free(dest as void*)
    archive.FreeEntries(es)
    archive.RarFileClose(rf)
end

func unpack(rf &: archive.RarFile, dir: str, name: str): int:
    out := filepath.Join(dir, name)
    st := archive.RarFileExtractAll(rf, out, 0 as i64, 0 as i64)
    mem.Free(out as void*)
    ret st
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_rar_file_more")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    p5d := save(dir, "p5d.rar", P5DATA)
    p5h := save(dir, "p5h.rar", P5HDR)
    p4h := save(dir, "p4h.rar", P4HDR)
    attempt("data, no password", p5d, "", dir)
    attempt("data, wrong password", p5d, "nope", dir)
    attempt("data", p5d, "secret", dir)
    attempt("headers, no password", p5h, "", dir)
    attempt("headers, wrong password", p5h, "nope", dir)
    attempt("headers", p5h, "secret", dir)
    attempt("rar4 headers", p4h, "password", dir)

    mut rf := archive.RarFileOpenWith(p5h, "secret")
    println "extract all", archive.RarStatusText(unpack(rf, dir, "out"))
    out := filepath.Join(dir, "out")
    println crc_in(out, "n2.txt")
    archive.RarFileClose(rf)

    println "volumes"
    first := save(dir, "set.part01.rar", VOL1)
    p2 := save(dir, "set.part02.rar", VOL2)
    third := save(dir, "set.part03.rar", VOL3)
    mut one := archive.RarFileOpen(first)
    mut oes := archive.RarFileEntries(one)
    println "single volume", oes.Len(), archive.RarStatusText(one.status)
    archive.FreeEntries(oes)
    println "extract", archive.RarStatusText(unpack(one, dir, "single"))
    archive.RarFileClose(one)
    mut vf := archive.RarFileOpenVolumes(first, "")
    mut ves := archive.RarFileEntries(vf)
    println "set", ves.Len(), vf.vols.paths.Len(), archive.RarStatusText(vf.status)
    println "extract", archive.RarStatusText(unpack(vf, dir, "vout"))
    vout := filepath.Join(dir, "vout")
    each e in ves:
        println " ", e.name, e.size, crc_in(vout, e.name)
    end
    archive.FreeEntries(ves)
    archive.RarFileClose(vf)
    os.Remove(third)
    mut vm := archive.RarFileOpenVolumes(first, "")
    println "missing last", vm.vols.paths.Len(), archive.RarStatusText(unpack(vm, dir, "vmiss"))
    archive.RarFileClose(vm)

    println "links"
    sym := save(dir, "sym.rar", SYM5)
    mut sf := archive.RarFileOpen(sym)
    println archive.RarStatusText(unpack(sf, dir, "sym"))
    sout := filepath.Join(dir, "sym")
    println "link size", crc_in(sout, "data_link")
    println "outside kept out", exists_in(sout, "random_link")
    data := filepath.Join(sout, "data.txt")
    println "mode", fs.Permissions(data), "mtime", fs.ModTime(data)
    archive.RarFileClose(sf)
    mem.Free(data as void*)
    mem.Free(sout as void*)
    mem.Free(sym as void*)
    mem.Free(vout as void*)
    mem.Free(out as void*)
    mem.Free(p5d as void*)
    mem.Free(p5h as void*)
    mem.Free(p4h as void*)
    mem.Free(first as void*)
    mem.Free(p2 as void*)
    mem.Free(third as void*)
    os.RemoveAll(dir)
    mem.Free(dir as void*)
end
