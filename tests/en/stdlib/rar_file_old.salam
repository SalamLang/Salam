func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    mut i := 0
    until i < s.len():
        v := nib(bp[i] as int)
        i++
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func save(dir: str, name: str, hex: str): str:
    mut b := unhex(hex)
    path := filepath.Join(dir, name)
    _ := archive.WriteBinaryFileBuf(path, b)
    compress.BufFree(b)
    ret path
end

func crc_of(path: str): i64:
    mut ok := false
    mut b := archive.ReadBinaryFile(path, ok)
    if not ok:
        ret -1
    end
    r := compress.CRC32Buf(b) as i64
    compress.BufFree(b)
    ret r
end

func same(label: str, dir: str, hex: str, password: str):
    path := save(dir, "one.rar", hex)
    mut b := unhex(hex)
    mut arc := archive.RarOpen(b.data, b.len, password)
    mut rf := archive.RarFileOpenWith(path, password)
    mut es := archive.RarFileEntries(rf)
    dest := filepath.Join(dir, "one.bin")
    println label, es.len(), rf.streaming, archive.RarStatusText(rf.status)
    each e in es:
        if e.is_dir:
            continue
        end
        mut out := archive.RarRead(arc, e.name, 0)
        want := out.len > 0 ? compress.CRC32Buf(out) as i64 : -1
        compress.BufFree(out)
        st := archive.RarFileExtractTo(rf, e.name, dest, 0 as i64, 0 as i64)
        println " ", e.name, e.size, archive.RarStatusText(st), st == archive.RAR_OK ? crc_of(dest) == want : false
        os.Remove(dest)
    end
    archive.FreeEntries(es)
    archive.RarFileClose(rf)
    archive.RarClose(arc)
    compress.BufFree(b)
    os.Remove(path)
    mem.Free(path as void*)
    mem.Free(dest as void*)
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_rar_file_old")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    same("ppmd", dir, PPMD, "")
    same("rar15", dir, P15, "password")
    same("rar15 stored", dir, P15S, "password")
    same("rar20", dir, P20, "password")
    same("rar20 stored", dir, P20S, "password")
    same("rar15 wrong password", dir, P15, "nope")
    same("rar15 no password", dir, P15, "")
    same("old 1.5", dir, OLD15, "")
    same("old 2.0", dir, OLD20, "")
    same("filters", dir, FILTER, "")
    same("low distance reset", dir, LOWDIST, "")
    same("encrypted names", dir, P4HDR, "password")
    same("encrypted names, wrong", dir, P4HDR, "nope")
    same("encrypted solid", dir, P4SOLID, "password")

    println "volumes"
    first := save(dir, "set.part1.rar", SPLIT1)
    second := save(dir, "set.part2.rar", SPLIT2)
    mut vf := archive.RarFileOpenVolumes(first, "secret")
    mut ves := archive.RarFileEntries(vf)
    println "set", ves.len(), vf.vols.paths.len(), vf.streaming, archive.RarStatusText(vf.status)
    vdest := filepath.Join(dir, "big.out")
    println archive.RarStatusText(archive.RarFileExtractTo(vf, "big.txt", vdest, 0 as i64, 0 as i64)), crc_of(vdest)
    archive.FreeEntries(ves)
    archive.RarFileClose(vf)
    mut wrong := archive.RarFileOpenVolumes(first, "nope")
    println "wrong password", archive.RarStatusText(archive.RarFileExtractTo(wrong, "big.txt", vdest, 0 as i64, 0 as i64))
    archive.RarFileClose(wrong)

    println "links"
    sym := save(dir, "sym4.rar", SYM4)
    mut sf := archive.RarFileOpen(sym)
    sout := filepath.Join(dir, "sym4")
    println archive.RarStatusText(archive.RarFileExtractAll(sf, sout, 0 as i64, 0 as i64))
    link := filepath.Join(sout, "data_link")
    println "link size", crc_of(link)
    rl := filepath.Join(sout, "random_link")
    println "outside kept out", os.Exists(rl)
    mem.Free(rl as void*)
    archive.RarFileClose(sf)
    mem.Free(link as void*)
    mem.Free(sout as void*)
    mem.Free(sym as void*)
    mem.Free(vdest as void*)
    mem.Free(first as void*)
    mem.Free(second as void*)
    os.RemoveAll(dir)
    mem.Free(dir as void*)
end
