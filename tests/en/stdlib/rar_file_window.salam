package main

import archive
import compress
import filepath
import mem
import os

const TINY := """
526172211a0701003392b5e50a010506000501018080007acabd512302030b980004bc00a4830232846b8280030105662e7478740a0313db8cf16a0f9a5303c28d152442fc32dd8533941c3c1bfc4d87761d6cb033ef401d77565103050400
"""

const BIG := """
526172211a0701003392b5e50a01050600050101808000d22a2f602602030b98000480bcc1960ba4830232846b82807b0105662e7478740a0313db8cf16a0f9a5303c28d152442fc32dd8533941c3c1bfc4d87761d6cb033ef401d77565103050400
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    mut i := 0
    until i < s.Len():
        v := nib(bp[i] as int)
        i++
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func attempt(label: str, hex: str, memcap: i64):
    mut b := unhex(hex)
    path := filepath.Join(os.TempDir(), "salam_rar_window.rar")
    dest := filepath.Join(os.TempDir(), "salam_rar_window.out")
    _ := archive.WriteBinaryFileBuf(path, b)
    compress.BufFree(b)
    mut rf := archive.RarFileOpen(path)
    st := archive.RarFileExtractTo(rf, "f.txt", dest, 0 as i64, memcap)
    println label, st, archive.RarStatusText(st), st == archive.RAR_WINDOW_TOO_BIG, os.Exists(dest)
    archive.RarFileClose(rf)
    os.Remove(path)
    os.Remove(dest)
    mem.Free(path as void*)
    mem.Free(dest as void*)
end

func main:
    attempt("normal", TINY, 0 as i64)
    attempt("small memcap", TINY, 1000 as i64)
    attempt("4 GiB dictionary, short data", BIG, 0 as i64)
    println archive.ArchiveStatusText(archive.ARCHIVE_WINDOW_TOO_BIG)
end
