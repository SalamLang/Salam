func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    mut i := 0
    until i < s.Len():
        v := nib(bp[i] as int)
        i++
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func attempt(label: str, hex: str):
    mut b := unhex(hex)
    path := filepath.Join(os.TempDir(), "salam_rar_filter.rar")
    dest := filepath.Join(os.TempDir(), "salam_rar_filter.out")
    _ := archive.WriteBinaryFileBuf(path, b)
    mut arc := archive.RarOpen(b.data, b.len, "")
    mut es := archive.RarEntries(arc)
    mut mem_out := archive.RarRead(arc, "f.bin", 0)
    mut rf := archive.RarFileOpen(path)
    st := archive.RarFileExtractTo(rf, "f.bin", dest, 0 as i64, 0 as i64)
    mut ok := false
    mut got := archive.ReadBinaryFile(dest, ok)
    println label, es.Get(0).size, mem_out.len, archive.RarStatusText(st), got.len, compress.CRC32Buf(got) == compress.CRC32Buf(mem_out)
    compress.BufFree(got)
    compress.BufFree(mem_out)
    archive.FreeEntries(es)
    archive.RarFileClose(rf)
    archive.RarClose(arc)
    compress.BufFree(b)
    os.Remove(path)
    os.Remove(dest)
    mem.Free(path as void*)
    mem.Free(dest as void*)
end

func main:
    attempt("itanium", ITANIUM)
    attempt("rgb", RGB)
    attempt("e8", E8)
    attempt("e8e9", E8E9)
    attempt("delta", DELTA)
    attempt("audio", AUDIO)
    attempt("upcase", UPCASE)
end
