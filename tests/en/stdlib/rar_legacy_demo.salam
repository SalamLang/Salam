func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func read(label: str, hex: str, name: str, password: str):
    mut a := unhex(hex)
    mut arc := archive.RarOpen(a.data, a.len, password)
    mut out := archive.RarRead(arc, name, 0)
    println label, out.len, compress.CRC32Buf(out), archive.RarStatusText(arc.status)
    compress.BufFree(out)
    archive.RarClose(arc)
    compress.BufFree(a)
end

func main:
    read("ppmd", PPMD, "small_payload.txt", "")
    read("rar15", P15, "SECRET.TXT", "password")
    read("rar15 stored", P15S, "SECRET.TXT", "password")
    read("rar20", P20, "SECRET.TXT", "password")
    read("rar20 stored", P20S, "SECRET.TXT", "password")
    read("rar20 wrong", P20, "SECRET.TXT", "passw0rd")
    read("rar15 none", P15, "SECRET.TXT", "")
    mut v1 := unhex(SPLIT1)
    mut v2 := unhex(SPLIT2)
    mut vols := Vector {} as Vector<compress.ByteBuf>
    vols.push(v1)
    vols.push(v2)
    mut arc := archive.RarOpenVolumes(vols, "secret")
    mut out := archive.RarRead(arc, "big.txt", 0)
    println "split", out.len, compress.CRC32Buf(out)
    compress.BufFree(out)
    archive.RarClose(arc)
    mut bad := archive.RarOpenVolumes(vols, "nope")
    mut none := archive.RarRead(bad, "big.txt", 0)
    println "split wrong", none.len
    compress.BufFree(none)
    archive.RarClose(bad)
    vols.Free()
    compress.BufFree(v1)
    compress.BufFree(v2)
    ret 0
end
