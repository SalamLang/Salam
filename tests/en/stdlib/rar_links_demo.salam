5014300b00ffa1000072616e646f6d5f6c696e6b00b07ece882e2e2f72616e646f6d313233c43d7b00400700
"""


func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func extract(label: str, hex: str): str:
    mut a := unhex(hex)
    dir := filepath.Join(os.TempDir(), "salam_rar_links_" + label)
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    mut arc := archive.RarOpen(a.data, a.len, "")
    n := archive.RarReadAll(arc, dir)
    println label, n, archive.RarStatusText(arc.status)
    archive.RarClose(arc)
    compress.BufFree(a)
    ret dir
end

func read_size(path: str): int:
    mut ok := false
    mut b := archive.ReadBinaryFile(path, ok)
    if not ok:
        ret -1
    end
    n := b.len
    compress.BufFree(b)
    ret n
end

func size_in(dir: str, name: str): int:
    path := filepath.Join(dir, name)
    n := read_size(path)
    mem.Free(path as void*)
    ret n
end

func exists_in(dir: str, name: str): bool:
    path := filepath.Join(dir, name)
    found := os.Exists(path)
    mem.Free(path as void*)
    ret found
end

func isdir_in(dir: str, name: str): bool:
    path := filepath.Join(dir, name)
    found := os.IsDir(path)
    mem.Free(path as void*)
    ret found
end

func main:
    d := extract("sym5", SYM5)
    println "link size", size_in(d, "data_link")
    println "target outside kept out", exists_in(d, "random_link")
    data := filepath.Join(d, "data.txt")
    mode := fs.Permissions(data)
    mtime := fs.ModTime(data)
    println "mode", mode, "mtime", mtime
    mem.Free(data as void*)
    e := extract("evil", EVIL)
    up := filepath.Join(e, "up")
    println "dir made", isdir_in(e, "up"), size_in(up, "pwned.txt")
    parent := filepath.Join(e, "..")
    println "escaped", exists_in(parent, "pwned.txt")
    c := extract("dups", DUPS)
    println "copies", size_in(c, "stest1.txt"), size_in(c, "stest5.txt"), size_in(c, "stest9.txt")
    s := extract("sym4", SYM4)
    println "link size", size_in(s, "data_link")
    println "unsafe link made", exists_in(s, "random_link")
    mem.Free(d as void*)
    mem.Free(e as void*)
    mem.Free(up as void*)
    mem.Free(parent as void*)
    mem.Free(c as void*)
    mem.Free(s as void*)
    ret 0
end
