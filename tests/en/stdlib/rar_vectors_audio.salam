"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    mut i := 0
    until i < s.Len():
        v := nib(bp[i] as int)
        i++
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func show(label: str, hex: str):
    mut b := unhex(hex)
    mut arc := archive.RarOpen(b.data, b.len, "")
    mut es := archive.RarEntries(arc)
    println label, es.Len()
    each e in es:
        mut out := archive.RarRead(arc, e.name, 0)
        println " ", e.name, e.size, out.len, compress.CRC32Buf(out), archive.RarStatusText(arc.status)
        compress.BufFree(out)
    end
    archive.FreeEntries(es)
    archive.RarClose(arc)
    compress.BufFree(b)
end

func main:
    show("rar 2.0 audio blocks", AUDIO20)
    show("rar 3.0 audio filter", AUDIO30)
end
