func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func show(label: str, parts: Vector<str>, password: str):
    mut vols := Vector {} as Vector<compress.ByteBuf>
    repeat parts.Len() in i:
        vols.Push(unhex(parts.Get(i)))
    end
    mut arc := archive.RarOpenVolumes(vols, password)
    mut es := archive.RarEntries(arc)
    println label, es.Len(), archive.RarStatusText(arc.status)
    repeat es.Len() in i:
        e := es.Get(i)
        mut out := archive.RarRead(arc, e.name, 0)
        println " ", e.name, e.size, out.len, compress.CRC32Buf(out), archive.RarStatusText(arc.status)
        compress.BufFree(out)
    end
    archive.FreeEntries(es)
    archive.RarClose(arc)
    repeat vols.Len() in i:
        compress.BufFree(vols.Get(i))
    end
    vols.Free()
end

func one(label: str, hex: str, password: str):
    mut parts := Vector {} as Vector<str>
    parts.Push(hex)
    show(label, parts, password)
    parts.Free()
end

func main:
    println SOURCE_RAR202PSW
    one("rar 2.02 password", RAR202PSW, "password")
    one("rar 2.02 wrong password", RAR202PSW, "wrong")
    one("rar 2.02 no password", RAR202PSW, "")

    mut parts_LEG15_1 := Vector {} as Vector<str>
    parts_LEG15_1.Push(LEG15_1)
    parts_LEG15_1.Push(LEG15_2)
    parts_LEG15_1.Push(LEG15_3)
    show("rar 1.5 encrypted, 3 volumes", parts_LEG15_1, "secret")
    parts_LEG15_1.Free()

    mut parts_LEG15_2 := Vector {} as Vector<str>
    parts_LEG15_2.Push(LEG15_1)
    parts_LEG15_2.Push(LEG15_2)
    parts_LEG15_2.Push(LEG15_3)
    show("rar 1.5 encrypted, 3 volumes, wrong password", parts_LEG15_2, "wrong")
    parts_LEG15_2.Free()

    mut parts_LEG20_3 := Vector {} as Vector<str>
    parts_LEG20_3.Push(LEG20_1)
    parts_LEG20_3.Push(LEG20_2)
    parts_LEG20_3.Push(LEG20_3)
    show("rar 2.0 encrypted, 3 volumes", parts_LEG20_3, "secret")
    parts_LEG20_3.Free()

    mut parts_LEG20_4 := Vector {} as Vector<str>
    parts_LEG20_4.Push(LEG20_1)
    parts_LEG20_4.Push(LEG20_2)
    parts_LEG20_4.Push(LEG20_3)
    show("rar 2.0 encrypted, 3 volumes, wrong password", parts_LEG20_4, "wrong")
    parts_LEG20_4.Free()

    mut parts_LEG30_5 := Vector {} as Vector<str>
    parts_LEG30_5.Push(LEG30_1)
    parts_LEG30_5.Push(LEG30_2)
    parts_LEG30_5.Push(LEG30_3)
    show("rar 3.0 encrypted, 3 volumes, own salts", parts_LEG30_5, "secret")
    parts_LEG30_5.Free()

    mut parts_LEG30_6 := Vector {} as Vector<str>
    parts_LEG30_6.Push(LEG30_1)
    parts_LEG30_6.Push(LEG30_2)
    parts_LEG30_6.Push(LEG30_3)
    show("rar 3.0 encrypted, 3 volumes, own salts, wrong password", parts_LEG30_6, "wrong")
    parts_LEG30_6.Free()
    one("itanium filter", ITANIUM, "")
    one("rar 2.0 audio, 2 channels", AUDIO2, "")
    one("rar 2.0 audio, 4 channels", AUDIO4, "")
    one("rar 2.0 audio, 2 then 4 then 3 channels", AUDIOMIX, "")
end
