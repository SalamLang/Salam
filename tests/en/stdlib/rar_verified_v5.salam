func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func show(label: str, parts: Vector<str>, password: str):
    mut vols := Vector {} as Vector<compress.ByteBuf>
    repeat parts.Len() in i:
        vols.Push(unhex(parts.Get(i)))
    end
    mut arc := archive.RarOpenVolumes(vols, password)
    mut es := archive.RarEntries(arc)
    println label, es.Len(), archive.RarStatusText(arc.status)
    repeat es.Len() in i:
        e := es.Get(i)
        mut out := archive.RarRead(arc, e.name, 0)
        println " ", e.name, e.size, out.len, compress.CRC32Buf(out), archive.RarStatusText(arc.status)
        compress.BufFree(out)
    end
    archive.FreeEntries(es)
    archive.RarClose(arc)
    repeat vols.Len() in i:
        compress.BufFree(vols.Get(i))
    end
    vols.Free()
end

func one(label: str, hex: str, password: str):
    mut parts := Vector {} as Vector<str>
    parts.Push(hex)
    show(label, parts, password)
    parts.Free()
end

func main:
    one("rar 7 dictionary, 80 distance codes", V1, "")
    one("rar 7 dictionary, fractional size", V1FRAC, "")
    one("rar 7 dictionary, rar 5 coding", V1COMPAT, "")

    mut parts_DATAENC_7 := Vector {} as Vector<str>
    parts_DATAENC_7.Push(DATAENC_1)
    parts_DATAENC_7.Push(DATAENC_2)
    parts_DATAENC_7.Push(DATAENC_3)
    parts_DATAENC_7.Push(DATAENC_4)
    show("data encrypted, 4 volumes", parts_DATAENC_7, "secret")
    parts_DATAENC_7.Free()

    mut parts_DATAENC_8 := Vector {} as Vector<str>
    parts_DATAENC_8.Push(DATAENC_1)
    parts_DATAENC_8.Push(DATAENC_2)
    parts_DATAENC_8.Push(DATAENC_3)
    parts_DATAENC_8.Push(DATAENC_4)
    show("data encrypted, wrong password", parts_DATAENC_8, "wrong")
    parts_DATAENC_8.Free()

    mut parts_HDRENC_9 := Vector {} as Vector<str>
    parts_HDRENC_9.Push(HDRENC_1)
    parts_HDRENC_9.Push(HDRENC_2)
    parts_HDRENC_9.Push(HDRENC_3)
    parts_HDRENC_9.Push(HDRENC_4)
    parts_HDRENC_9.Push(HDRENC_5)
    show("headers encrypted, 5 volumes", parts_HDRENC_9, "secret")
    parts_HDRENC_9.Free()

    mut parts_HDRENC_10 := Vector {} as Vector<str>
    parts_HDRENC_10.Push(HDRENC_1)
