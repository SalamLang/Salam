package main

import regex

func show(label: str, e: Error):
    println label + ": " + e.kind_name() + " " + e.code + " @" + e.offset + " | " + e.to_str()
end

func compile(label: str, pattern: str):
    try:
        re := regex.Compile(pattern)
        println label + ": ok " + regex.Match(re, "2024-03-15 ada@example.com")
    catch e:
        show(label, e)
    end
end

func compile_errors():
    println "== regex.Compile =="
    compile("date", `^\d{4}-\d{2}-\d{2}`)
    compile("named groups", `(?P<user>\w+)@(?<host>[\w.]+)`)
    compile("empty", "")
    compile("unclosed group", `(\d+`)
    compile("unmatched paren", `\d+)`)
    compile("unclosed class", `[0-9`)
    compile("leading star", `*abc`)
    compile("plus after bar", `a|+b`)
    compile("lone backslash", `abc\`)
    compile("named group without end", `(?P<year\d+)`)
    compile("P without angle", `(?Pyear)`)
    compile("lookahead", `a(?=b)`)
    compile("repeat over 64", `a{65}`)
    compile("seventeen groups", `(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)(m)(n)(o)(p)(q)`)
    compile("same bad pattern again", `(\d+`)
    println "IsValid: " + regex.IsValid(`[0-9]+`) + " " + regex.IsValid(`[0-9`)
end

func helper_errors():
    println "== Str helpers =="
    try:
        println regex.MatchStr(`^[a-z]+$`, "salam")
        println regex.FindStr(`o`, "salam donya")
        println regex.ReplaceAllStr(`a`, "banana", "o")
        println regex.FindAllStr(`[0-9]+`, "a1 b22 c333")
        println regex.SplitStr(`-+`, "2025--09---29")
        println regex.ReplaceAllExpandStr(`(\w+)@(\w+)`, "ada@lovelace", `$2/$1`)
        println regex.Group(regex.FindMatchStr(`b+`, "aabbbc"), 0)
    catch e:
        show("unexpected", e)
    end
    try:
        println regex.FindAllStr(`[a-`, "abc")
    catch e:
        show("FindAllStr", e)
    end
    try:
        println regex.ReplaceStr(`(x`, "xyz", "-")
    catch e:
        show("ReplaceStr", e)
    end
    try:
        println regex.MatchStr(`?`, "a")
    catch e:
        show("MatchStr", e)
    end
end

func user_pattern(pattern: str): str throws:
    re := try regex.Compile(pattern)
    ret regex.ReplaceAll(re, "one two three", "_")
end

func main:
    compile_errors()
    helper_errors()
    println "== passing it on =="
    try:
        println user_pattern(`[o]`)
        println user_pattern(`[aeiou`)
    catch e:
        println e.wrap("search box").to_str()
    end
end
