package main

import regex
import str

func show(v: Vector<str>):
    mut out := Vector {} as Vector<str>
    defer out.free()
    each s in v:
        out.push("[" + s + "]")
    end
    println v.Len(), str.Join(out, "")
end

func run() throws:
    println "first match"
    pair := try regex.Compile("([a-z]+)@([a-z]+)")
    text := "ali@home, sara@work"
    m := regex.FindMatch(pair, text)
    println m.ok, m.start, m.stop, m.count
    println regex.Group(m, 0), regex.Group(m, 1), regex.Group(m, 2)
    none := regex.FindMatch(pair, "nothing here")
    println none.ok, none.start, none.count

    println "searching from an offset"
    second := regex.FindMatchFrom(pair, text, m.stop)
    println second.ok, second.start, second.stop
    println regex.Group(second, 1), regex.Group(second, 2)
    println regex.FindMatchFrom(pair, text, second.stop).ok
    println regex.FindMatchFrom(pair, text, 0).start
    println regex.FindMatchFrom(pair, text, 100).ok

    println "groups as a list"
    parts := regex.FindSubmatch(pair, text)
    show(parts)
    parts.free()
    gone := regex.FindSubmatch(pair, "nothing here")
    show(gone)
    gone.free()
    dated := try regex.Compile("(\\d+)-(\\d+)-(\\d+)")
    ymd := regex.FindSubmatch(dated, "released 2026-11-02 today")
    show(ymd)
    ymd.free()

    println "every match"
    words := regex.FindAll(try regex.Compile("[a-z]+"), "one, two; three")
    show(words)
    words.free()
    digits := regex.FindAll(try regex.Compile("\\d"), "a1b22c333")
    show(digits)
    digits.free()
    miss := regex.FindAll(try regex.Compile("\\d"), "letters only")
    show(miss)
    miss.free()

    println "templates"
    println regex.ReplaceExpand(pair, text, "$2:$1")
    println regex.ReplaceAllExpand(pair, text, "$2:$1")
    println regex.ReplaceAllExpand(pair, text, "<${1}>")
    println regex.ReplaceAllExpand(pair, text, "$$1")
    println regex.ReplaceExpand(pair, "nothing here", "$2:$1")
    named := try regex.Compile("(?P<user>[a-z]+)@(?P<host>[a-z]+)")
    println regex.ReplaceAllExpand(named, text, "${host}/${user}")
    println regex.ReplaceAllExpand(try regex.Compile("x*"), "abc", "-")
end

func main:
    try:
        run()
    catch e:
        println "unexpected error: " + e.ToStr()
    end
end
