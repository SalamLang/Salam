package main

// std/rpc end to end: the JSON-RPC 2.0 codec, the MessagePack-RPC codec,
// all three stream framings, the method registry and its dispatcher, and
// a real client/server pair talking over a loopback TCP socket.

import rpc
import encoding.value
import compress
import testing
import sync
import os

mut srv wg := sync.NewWaitGroup()
mut bound port := 0
mut server := rpc.NewServer(0, rpc.RPC_CODEC_JSON)

// ---- handlers ----------------------------------------------------------
//
// A handler takes a call slot, not the request: `callhandler` can only
// pass one i64, so arguments come in and the reply goes out through the
// slot. Named and positional parameters both reach the same code -
// rpc.CallParam* tries the object key first, then the array position.

func add(slot: i64):
    a := rpc.CallParamInt(slot, "a", 0)
    b := rpc.CallParamInt(slot, "b", 1)
    rpc.ReplyInt(slot, a + b)
end

func shout(slot: i64):
    rpc.ReplyStr(slot, rpc.CallParamStr(slot, "text", 0).upper())
end

func divide(slot: i64):
    denom := rpc.CallParamInt(slot, "b", 1)
    if denom == (0 as i64):
        rpc.FailInvalidParams(slot, "division by zero")
        ret
    end
    rpc.ReplyInt(slot, rpc.CallParamInt(slot, "a", 0) / denom)
end

// Deliberately replies nothing: the dispatcher must turn that into an
// internal error rather than leaving a client waiting forever.
func silent(_slot: i64):
    // Intentionally no reply; the dispatcher must synthesise the error.
    ret
end

func counter(slot: i64):
    rpc.ReplyBool(slot, true)
end

func serve loopback():
    rpc.Listen(server)
    bound port = rpc.Port(server)
    sync.Done(srv wg)
    rpc.ServeCount(server, 1)
end

// ---- checks ------------------------------------------------------------

func check json codec():
    mut ok := false
    req := rpc.JsonDecodeRequest("{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[2,40],\"id\":7}", ok)
    testing.AssertTrue(ok)
    testing.AssertEqStr(req.method, "add")
    testing.AssertEqInt64(req.msgid, 7 as i64)
    testing.AssertFalse(rpc.IsNotification(req))
    testing.AssertEqInt(rpc.ParamCount(req), 2)
    testing.AssertEqInt64(rpc.ParamInt(req, "a", 0), 2 as i64)

    // A string id must come back a string, not a coerced number.
    mut ok2 := false
    req2 := rpc.JsonDecodeRequest("{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"id\":\"abc\"}", ok2)
    testing.AssertTrue(ok2)
    testing.AssertTrue(value.IsString(req2.id))
    testing.AssertEqStr(value.AsString(req2.id), "abc")

    // No `id` member at all is a notification - distinct from id: null.
    mut ok3 := false
    req3 := rpc.JsonDecodeRequest("{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}", ok3)
    testing.AssertTrue(ok3)
    testing.AssertTrue(rpc.IsNotification(req3))

    // Wrong version, missing method, and non-structured params are all
    // Invalid Request / Invalid Params, not parse errors.
    bad := rpc.JsonDecodeBatch("{\"jsonrpc\":\"1.0\",\"method\":\"x\",\"id\":1}")
    testing.AssertEqInt(bad.items.get(0)[0].err_code, rpc.RPC_INVALID_REQUEST)
    bad2 := rpc.JsonDecodeBatch("{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"params\":5,\"id\":1}")
    testing.AssertEqInt(bad2.items.get(0)[0].err_code, rpc.RPC_INVALID_PARAMS)

    // Malformed JSON is a parse error at the payload level.
    broken := rpc.JsonDecodeBatch("{not json")
    testing.AssertFalse(broken.ok)
    testing.AssertEqInt(broken.err.code, rpc.RPC_PARSE_ERROR)
end

func check dispatch():
    reply := rpc.HandleText("{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[2,40],\"id\":1}")
    mut ok := false
    resp := rpc.JsonDecodeResponse(reply, ok)
    testing.AssertTrue(ok)
    testing.AssertFalse(resp.is_error)
    testing.AssertEqInt64(value.AsInt(resp.result), 42 as i64)

    // Named parameters reach the same handler.
    named := rpc.HandleText("{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":{\"a\":10,\"b\":5},\"id\":2}")
    mut ok2 := false
    resp2 := rpc.JsonDecodeResponse(named, ok2)
    testing.AssertTrue(ok2)
    testing.AssertEqInt64(value.AsInt(resp2.result), 15 as i64)

    missing := rpc.HandleText("{\"jsonrpc\":\"2.0\",\"method\":\"nope\",\"id\":3}")
    mut ok3 := false
    resp3 := rpc.JsonDecodeResponse(missing, ok3)
    testing.AssertTrue(resp3.is_error)
    testing.AssertEqInt(resp3.err.code, rpc.RPC_METHOD_NOT_FOUND)

    failed := rpc.HandleText("{\"jsonrpc\":\"2.0\",\"method\":\"divide\",\"params\":[1,0],\"id\":4}")
    mut ok4 := false
    resp4 := rpc.JsonDecodeResponse(failed, ok4)
    testing.AssertTrue(resp4.is_error)
    testing.AssertEqInt(resp4.err.code, rpc.RPC_INVALID_PARAMS)
    testing.AssertEqStr(resp4.err.message, "division by zero")

    // A handler that never replies is an internal error, never a hang.
    quiet := rpc.HandleText("{\"jsonrpc\":\"2.0\",\"method\":\"silent\",\"id\":5}")
    mut ok5 := false
    resp5 := rpc.JsonDecodeResponse(quiet, ok5)
    testing.AssertTrue(resp5.is_error)
    testing.AssertEqInt(resp5.err.code, rpc.RPC_INTERNAL_ERROR)

    // A notification produces no reply document at all.
    testing.AssertEqStr(rpc.HandleText("{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,1]}"), "")
end

func check batch():
    // Two calls and one notification: the reply array holds two entries.
    text := "[{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,2],\"id\":1}," +
        "{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[3,4]}," +
        "{\"jsonrpc\":\"2.0\",\"method\":\"shout\",\"params\":[\"salam\"],\"id\":2}]"
    out := rpc.HandleText(text)
    mut ok := false
    rs := rpc.JsonDecodeResponses(out, ok)
    testing.AssertTrue(ok)
    testing.AssertTrue(rs.is_batch)
    testing.AssertEqInt(rs.items.len(), 2)
    testing.AssertEqInt64(value.AsInt(rs.items.get(0)[0].result), 3 as i64)
    testing.AssertEqStr(value.AsString(rs.items.get(1)[0].result), "SALAM")

    // An entirely-notification batch gets nothing back.
    testing.AssertEqStr(rpc.HandleText("[{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,1]}]"), "")

    // An empty batch array is itself an Invalid Request.
    empty := rpc.HandleText("[]")
    mut ok2 := false
    resp := rpc.JsonDecodeResponse(empty, ok2)
    testing.AssertTrue(resp.is_error)
    testing.AssertEqInt(resp.err.code, rpc.RPC_INVALID_REQUEST)
end

func check reflection():
    testing.AssertTrue(rpc.HasMethod("add"))
    testing.AssertEqStr(rpc.MethodDoc("add"), "add two integers")
    listed := rpc.HandleText("{\"jsonrpc\":\"2.0\",\"method\":\"rpc.listMethods\",\"id\":1}")
    mut ok := false
    resp := rpc.JsonDecodeResponse(listed, ok)
    testing.AssertTrue(ok)
    testing.AssertTrue(value.IsArray(resp.result))
    testing.AssertEqInt(value.ArrayLen(resp.result), rpc.MethodCount())
end

func check framing():
    // Line framing: one message per newline, blank lines skipped.
    mut s := rpc.NewMemStream()
    rpc.FeedStr(s, "{\"a\":1}\n\n{\"b\":2}\n")
    mut ok := false
    testing.AssertEqStr(rpc.ReadFrameStr(s, rpc.RPC_FRAME_LINE, ok), "{\"a\":1}")
    testing.AssertTrue(ok)
    testing.AssertEqStr(rpc.ReadFrameStr(s, rpc.RPC_FRAME_LINE, ok), "{\"b\":2}")
    testing.AssertTrue(ok)
    rpc.ReadFrameStr(s, rpc.RPC_FRAME_LINE, ok)
    testing.AssertFalse(ok)
    rpc.FreeStream(s)

    // LSP framing: Content-Length plus a blank line, other headers ignored.
    mut h := rpc.NewMemStream()
    rpc.FeedStr(h, "Content-Length: 7\r\nContent-Type: application/json\r\n\r\n{\"a\":1}Content-Length: 7\r\n\r\n{\"b\":2}")
    mut hok := false
    testing.AssertEqStr(rpc.ReadFrameStr(h, rpc.RPC_FRAME_HEADER, hok), "{\"a\":1}")
    testing.AssertTrue(hok)
    testing.AssertEqStr(rpc.ReadFrameStr(h, rpc.RPC_FRAME_HEADER, hok), "{\"b\":2}")
    testing.AssertTrue(hok)
    rpc.FreeStream(h)

    // Length framing is binary-safe: a payload full of NUL bytes, which
    // a `str`-based reader would truncate at the first one, survives.
    mut raw := compress.NewByteBuf()
    compress.BufPush(raw, 1)
    compress.BufPush(raw, 0)
    compress.BufPush(raw, 0)
    compress.BufPush(raw, 2)
    mut framed := rpc.FrameEncode(rpc.RPC_FRAME_LENGTH, raw)
    testing.AssertEqInt(compress.BufLen(framed), 8)
    mut b := rpc.NewMemStream()
    rpc.FeedBuf(b, framed)
    mut bok := false
    mut got := rpc.ReadFrame(b, rpc.RPC_FRAME_LENGTH, bok)
    testing.AssertTrue(bok)
    testing.AssertEqInt(compress.BufLen(got), 4)
    testing.AssertEqInt(compress.BufGet(got, 3), 2)
    compress.BufFree(got)
    compress.BufFree(framed)
    compress.BufFree(raw)
    rpc.FreeStream(b)
end

func check msgpack codec():
    req := rpc.NewRequest("add", value.NewValueArray(), 11 as i64)
    value.ArrayPush(req.params, value.ValueInt(20 as i64))
    value.ArrayPush(req.params, value.ValueInt(22 as i64))
    mut wire := rpc.MsgpackEncodeRequest(req)
    // [0, 11, "add", [20, 22]] is 10 bytes of MessagePack.
    testing.AssertEqInt(compress.BufLen(wire), 10)
    mut reply := rpc.HandlePayload(rpc.RPC_CODEC_MSGPACK, wire)
    mut ok := false
    resp := rpc.MsgpackDecodeResponse(reply, ok)
    testing.AssertTrue(ok)
    testing.AssertFalse(resp.is_error)
    testing.AssertEqInt64(resp.msgid, 11 as i64)
    testing.AssertEqInt64(value.AsInt(resp.result), 42 as i64)
    compress.BufFree(wire)
    compress.BufFree(reply)

    // The default framing follows the codec: text is line-delimited,
    // binary gets an explicit length prefix.
    testing.AssertEqInt(rpc.CodecDefaultFraming(rpc.RPC_CODEC_JSON), rpc.RPC_FRAME_LINE)
    testing.AssertEqInt(rpc.CodecDefaultFraming(rpc.RPC_CODEC_MSGPACK), rpc.RPC_FRAME_LENGTH)
    testing.AssertEqStr(rpc.CodecName(rpc.RPC_CODEC_MSGPACK), "msgpack-rpc")
end

func check loopback():
    sync.Add(srv wg, 1 as i64)
    t := spawn(serve loopback)
    sync.Wait(srv wg)
    testing.AssertTrue(bound port > 0)

    mut c := rpc.DialClient("127.0.0.1", bound port, rpc.RPC_CODEC_JSON)
    testing.AssertTrue(rpc.ClientOk(c))

    mut args := Vector {} as Vector<value.Value>
    args.push(value.ValueInt(19 as i64))
    args.push(value.ValueInt(23 as i64))
    r1 := rpc.CallArgs(c, "add", args)
    testing.AssertFalse(rpc.IsErrorResponse(r1))
    testing.AssertEqInt64(rpc.ResultInt(r1), 42 as i64)

    mut args2 := Vector {} as Vector<value.Value>
    args2.push(value.ValueString("salam"))
    r2 := rpc.CallArgs(c, "shout", args2)
    testing.AssertEqStr(rpc.ResultStr(r2), "SALAM")

    r3 := rpc.CallNoParams(c, "counter")
    testing.AssertTrue(rpc.ResultBool(r3))

    r4 := rpc.CallNoParams(c, "does.not.exist")
    testing.AssertTrue(rpc.IsErrorResponse(r4))
    testing.AssertEqInt(rpc.ErrorCode(r4), rpc.RPC_METHOD_NOT_FOUND)

    // A notification is fire-and-forget: it must not consume a reply,
    // so the call right after it still lines up.
    testing.AssertTrue(rpc.Notify(c, "add", value.NewValueArray()))
    r5 := rpc.CallArgs(c, "add", args)
    testing.AssertEqInt64(rpc.ResultInt(r5), 42 as i64)

    rpc.CloseClient(c)
    join(t)
end

func main:
    rpc.RegisterDoc("add", add, "add two integers")
    rpc.RegisterDoc("shout", shout, "upper-case a string")
    rpc.RegisterDoc("divide", divide, "integer division")
    rpc.RegisterDoc("silent", silent, "replies with nothing")
    rpc.RegisterDoc("counter", counter, "always true")

    check json codec()
    check dispatch()
    check batch()
    check reflection()
    check framing()
    check msgpack codec()
    check loopback()

    os.Exit(testing.Summary())
end
