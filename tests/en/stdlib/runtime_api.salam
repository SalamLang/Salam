package main

import runtime
import str

func main:
    runtime.MarkStart()
    first := runtime.UptimeMs()
    println "uptime starts small: ", first >= 0 and first < 60000
    second := runtime.UptimeMs()
    println "uptime monotonic: ", second >= first
    secs := runtime.UptimeSeconds()
    println "seconds agree: ", secs * 1000.0 >= second as f64 and secs < 60.0
    runtime.MarkStart()
    println "mark keeps start: ", runtime.UptimeMs() >= second

    total := runtime.TotalMemory()
    avail := runtime.AvailableMemory()
    used := runtime.UsedMemory()
    println "total known: ", total > 0
    println "available same as platform: ", avail == -1 or avail > 0
    println "used known when available is: ", (avail == -1) == (used == -1)
    println "used not negative: ", used == -1 or used >= 0

    flags := runtime.BuildFlags()
    println "safe flag: ", runtime.IsSafeBuild() == str.Contains(flags, "safe")
    println "mem debug flag: ", runtime.IsMemDebugBuild() == str.Contains(flags, "mem_debug")
    println "asan flag: ", runtime.IsAsanBuild() == str.Contains(flags, "asan")
    println "release when none: ", (flags == "release") == (not runtime.IsSafeBuild() and not runtime.IsMemDebugBuild() and not runtime.IsAsanBuild())
end
