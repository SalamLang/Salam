package main

import encoding.serde
import encoding.value
import encoding.toml
import testing

func main:
    testing.AssertEqStr(serde.Detect(`{"a": 1}`), "json")
    testing.AssertEqStr(serde.Detect("a: 1\nb: 2\n"), "yaml")
    testing.AssertEqStr(serde.Detect("a = 1\nb = 2\n"), "toml")
    testing.AssertEqStr(serde.Detect("<root><a>1</a></root>"), "xml")
    testing.AssertEqStr(serde.Detect("a,b\n1,2\n3,4\n"), "csv")

    testing.AssertEqStr(serde.Detect(`{"a": 1}`), "json")

    original := "name = \"salam\"\nversion = 2\n"
    mut backToTOML := ""
    try:
        asJSON := serde.TranscodeStrict(original, "toml", "json")
        asYAML := serde.TranscodeStrict(asJSON, "json", "yaml")
        backToTOML = serde.TranscodeStrict(asYAML, "yaml", "toml")
    catch e:
        testing.AssertMsg(false, e.to_str())
    end

    v1 := toml.Decode(original)
    v2 := toml.Decode(backToTOML)
    testing.AssertTrue(value.Equal(v1, v2))

    testing.AssertEqStr(serde.Detect(""), "")

    mut rejected := false
    try:
        serde.TranscodeStrict(`{"a":1}`, "json", "nope")
    catch e:
        rejected = e.is(ErrorKind.InvalidArgument)
    end
    testing.AssertTrue(rejected)

    value.ValueFree(v1)
    value.ValueFree(v2)

    ret testing.Summary()
end
