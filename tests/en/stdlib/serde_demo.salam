package main

import encoding.serde
import encoding.value
import encoding.toml
import testing
import os

func main:
    // one sample per format
    testing.AssertEqStr(serde.Detect(`{"a": 1}`), "json")
    testing.AssertEqStr(serde.Detect("a: 1\nb: 2\n"), "yaml")
    testing.AssertEqStr(serde.Detect("a = 1\nb = 2\n"), "toml")
    testing.AssertEqStr(serde.Detect("<root><a>1</a></root>"), "xml")
    testing.AssertEqStr(serde.Detect("a,b\n1,2\n3,4\n"), "csv")

    // JSON-vs-YAML ordering edge case: a JSON snippet must detect as json,
    // not yaml, even though yaml's flow-value parser also accepts it
    testing.AssertEqStr(serde.Detect(`{"a": 1}`), "json")

    // Transcode chain: toml -> json -> yaml -> toml, structurally equal at the end
    original := "name = \"salam\"\nversion = 2\n"
    mut ok1 := false
    asJSON := serde.TranscodeStrict(original, "toml", "json", ok1)
    testing.AssertTrue(ok1)
    mut ok2 := false
    asYAML := serde.TranscodeStrict(asJSON, "json", "yaml", ok2)
    testing.AssertTrue(ok2)
    mut ok3 := false
    backToTOML := serde.TranscodeStrict(asYAML, "yaml", "toml", ok3)
    testing.AssertTrue(ok3)

    v1 := toml.Decode(original)
    v2 := toml.Decode(backToTOML)
    testing.AssertTrue(value.Equal(v1, v2))

    // unknown/empty input
    testing.AssertEqStr(serde.Detect(""), "")

    // Transcode with an unsupported format name fails cleanly
    mut okBad := true
    serde.TranscodeStrict(`{"a":1}`, "json", "nope", okBad)
    testing.AssertFalse(okBad)

    value.ValueFree(v1)
    value.ValueFree(v2)

    os.Exit(testing.Summary())
end
