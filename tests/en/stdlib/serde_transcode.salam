package main

import encoding.serde

func main:
    println serde.Transcode("{\"name\":\"salam\",\"year\":2024}", "json", "toml")
    println serde.Transcode("name = \"salam\"\nyear = 2024\n", "toml", "json")
    println serde.Transcode("name: salam\nyear: 2024\n", "yaml", "json")
    println serde.Transcode("{\"a\":1}", "json", "yaml")
    println serde.Transcode("{broken", "json", "yaml") == ""
    println serde.Transcode("{\"a\":1}", "nonsense", "json") == ""
    println serde.Transcode("{\"a\":1}", "json", "nonsense") == ""
end
