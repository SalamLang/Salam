func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func text(n: int): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    repeat n in i:
        line := "line " + str.FromInt(i as i64) + " of the salam archive test\n"
        compress.BufPushBytes(b, line as void*, line.len())
    end
    ret b
end

func noise(n: int): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    mut x := 12345 as i64
    repeat n:
        x = (x * (1103515245 as i64) + (12345 as i64)) & (0x7fffffff as i64)
        compress.BufPush(b, ((x >> 16) & (255 as i64)) as int)
    end
    ret b
end

func expected(name: str): compress.ByteBuf:
    if name == "sub/b.txt":
        ret text(700)
    end
    if name == "sub/deep/r.bin":
        ret noise(2000)
    end
    if name == "z.txt":
        ret compress.NewByteBuf()
    end
    ret compress.BufFromStr("hello\n")
end

func check(label: str, hex: str, dir: str):
    packed := unhex(hex)
    path := filepath.Join(dir, label + ".7z")
    archive.WriteBinaryFileBuf(path, packed)
    mut sf := archive.SevenZipOpenFile(path, "")
    entries := archive.SevenZipFileEntries(sf)
    println label, "open", sf.status, "entries", entries.len()
    repeat entries.len() in i:
        e := entries.get(i)
        println "  ", e.name, e.size, e.kind, e.link
    end
    out := filepath.Join(dir, label)
    st := archive.SevenZipFileExtractAll(sf, out, 0 as i64, 0 as i64)
    mut good := 0
    mut files := 0
    repeat entries.len() in i:
        e := entries.get(i)
        if e.kind == 0 and not e.is_dir:
            files++
            mut ok := false
            got := archive.ReadBinaryFile(filepath.Join(out, e.name), ok)
            if ok and compress.BufEquals(got, expected(e.name)):
                good++
            end
        end
    end
    println "  extract", st, "match", good, "of", files
    if label != "copy":
        one := filepath.Join(dir, label + "_one.bin")
        s1 := archive.SevenZipFileExtractTo(sf, "sub/b.txt", one, 0 as i64, 0 as i64)
        mut ok := false
        got := archive.ReadBinaryFile(one, ok)
        println "  one", s1, ok and compress.BufEquals(got, text(700))
        s2 := archive.SevenZipFileExtractTo(sf, "sub/b.txt", one, 100 as i64, 0 as i64)
        s3 := archive.SevenZipFileExtractTo(sf, "sub/b.txt", one, 0 as i64, 1000 as i64)
        s4 := archive.SevenZipFileExtractTo(sf, "nope.txt", one, 0 as i64, 0 as i64)
        println "  cap", s2, "memcap", s3, "missing", s4
    end
    archive.SevenZipFileClose(sf)
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_sevenzip_file_demo")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    check("lz2", F_LZ2, dir)
    check("lz1", F_LZ1, dir)
    check("dlt", F_DLT, dir)
    check("copy", F_COPY, dir)
    check("bz2", F_BZ2, dir)
    check("dfl", F_DFL, dir)
    check("swp", F_SWP, dir)
    check("lnk", F_LNK, dir)
    bad := filepath.Join(dir, "bad.7z")
    archive.WriteBinaryFileBuf(bad, compress.BufFromStr("not a seven zip archive at all, just text"))
    mut sf := archive.SevenZipOpenFile(bad, "")
    println "bad", sf.status, archive.SevenZipStatusText(sf.status)
    archive.SevenZipFileClose(sf)
    mut gone := archive.SevenZipOpenFile(filepath.Join(dir, "gone.7z"), "")
    println "gone", gone.status
    archive.SevenZipFileClose(gone)
    os.RemoveAll(dir)
end
