func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func show(label: str, hex: str):
    packed := unhex(hex)
    mut arc := archive.SevenZipOpen(packed.data, packed.len, "")
    entries := archive.SevenZipEntries(arc)
    listed := arc.status
    e := entries.get(0)
    data := archive.SevenZipRead(arc, e.name, 0)
    println label, e.name, "list", listed, "read", arc.status, "size", data.len, "crc", compress.CRC32(data.data, data.len), "method", e.method
end

func main:
    show("deflate64", D64)
    show("bcj2", BCJ2)
    show("riscv", RISCV)
    show("arm64", ARM64)
    show("swap2", SWAP2)
    show("swap4", SWAP4)
    stored := unhex("010300fcff616263")
    mut ok := false
    plain := compress.RawInflate64Max(stored.data, stored.len, 3, 100, ok)
    println "raw64", ok, plain.len
    sw := compress.BufFromStr("abcdefg")
    println "swap", compress.SwapDecode(sw.data, sw.len, 4), compress.BufToStrUnsafe(sw), compress.SwapDecode(sw.data, sw.len, 3)
end
