package main

import archive
import compress
import filepath
import mem
import os

func file_size(path: str): i64:
    mut ok := false
    mut b := archive.ReadBinaryFile(path, ok)
    if not ok:
        ret -1
    end
    n := b.len as i64
    compress.BufFree(b)
    ret n
end

func main:
    note := "caps and big entries"
    mut small := Vector {} as Vector<archive.SevenZipFileInput>
    small.Push(archive.MakeSevenZipFileInput("a.txt", note as void*, note.Len(), false))
    small.Push(archive.MakeSevenZipFileInput("dir/", null, 0, true))
    packed := archive.SevenZipCreate(small)

    mut arc := archive.SevenZipOpen(packed.data, packed.len, "")
    got := archive.SevenZipReadCap(arc, "a.txt", 0 as i64)
    println "read", arc.status, compress.BufToStrUnsafe(got) == note
    over := archive.SevenZipReadCap(arc, "a.txt", 5 as i64)
    println "cap", arc.status, over.len
    fits := archive.SevenZipReadCap(arc, "a.txt", note.Len() as i64)
    println "exact", arc.status, fits.len
    old := archive.SevenZipRead(arc, "a.txt", 5)
    println "old max", arc.status, old.len
    gone := archive.SevenZipReadCap(arc, "nope", 0 as i64)
    println "missing", arc.status, gone.len

    dir := filepath.Join(os.TempDir(), "salam_sz_nolimit_a")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    n := archive.SevenZipReadAllCap(arc, dir, 5 as i64, 0 as i64)
    println "all capped", n, arc.status, os.Exists(filepath.Join(dir, "a.txt"))
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    n2 := archive.SevenZipReadAllCap(arc, dir, 0 as i64, 0 as i64)
    println "all", n2, arc.status, file_size(filepath.Join(dir, "a.txt")), os.IsDir(filepath.Join(dir, "dir"))
    os.RemoveAll(dir)
    n3 := archive.SevenZipReadAll(arc, dir)
    println "old all", n3, arc.status
    os.RemoveAll(dir)
    es := archive.SevenZipEntriesOf(arc)
    println "entries", es.Len(), arc.status

    size := 1100000000
    big := mem.AllocateZeroed(size as u64)
    mut files := Vector {} as Vector<archive.SevenZipFileInput>
    files.Push(archive.MakeSevenZipFileInput("big.bin", big, size, false))
    mut bigpacked := archive.SevenZipCreateLevel(files, 0)
    mem.Free(big)
    println "big archive", bigpacked.len > size
    mut barc := archive.SevenZipOpen(bigpacked.data, bigpacked.len, "")
    refused := archive.SevenZipReadCap(barc, "big.bin", 1000000 as i64)
    println "big cap", barc.status, refused.len
    bdir := filepath.Join(os.TempDir(), "salam_sz_nolimit_b")
    os.RemoveAll(bdir)
    os.MkdirAll(bdir)
    bn := archive.SevenZipReadAll(barc, bdir)
    println "big all", bn, barc.status, file_size(filepath.Join(bdir, "big.bin")) == (size as i64)
    os.RemoveAll(bdir)
    compress.BufFree(bigpacked)
end
