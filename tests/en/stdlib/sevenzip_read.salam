const EMPTY := """
377abcaf271c00048d9bd50f0000000000000000000000000000000000000000
"""

const WORDS := ["salam", "compress", "xz", "lzma", "archive", "the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog", "stream", "block", "index"]
const NAMES := ["a.txt", "docs/b.bin", "docs/note.txt", "empty.txt", "فارسی.txt"]

mut pool_s := Vector {} as Vector<str>
mut pool_l := Vector {} as Vector<Vector<archive.Entry>>
mut pool_b := Vector {} as Vector<compress.ByteBuf>

func ks(s: str): str:
    pool_s.push(s)
    ret s
end

func kb(b: compress.ByteBuf): compress.ByteBuf:
    pool_b.push(b)
    ret b
end

func txt(b: compress.ByteBuf): str:
    ret ks(compress.BufToStrUnsafe(b))
end

func kl(v: Vector<archive.Entry>): Vector<archive.Entry>:
    pool_l.push(v)
    ret v
end

func release():
    repeat pool_l.Len() in i:
        mut v := pool_l.get(i)
        archive.FreeEntries(v)
    end
    pool_l.free()
    repeat pool_s.Len() in i:
        s := pool_s.get(i)
        if s.Len() > 0:
            mem.Free(s as void*)
        end
    end
    pool_s.free()
    repeat pool_b.Len() in i:
        mut b := pool_b.get(i)
        compress.BufFree(b)
    end
    pool_b.free()
end

func j(a: str, b: str): str:
    ret ks(filepath.Join(a, b))
end

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func lcg(x: i64): i64:
    ret (x * 1103515245 + 12345) & 0x7fffffff
end

func gen_text(n: int, seed: i64): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = lcg(x)
        w := WORDS[((x >> 8) % 16) as int]
        compress.BufPushBytes(out, w as void*, w.Len())
        if ((x >> 4) & 7) == 0:
            compress.BufPush(out, 10)
        else:
            compress.BufPush(out, 32)
        end
    end
    ret out
end

func push32(b &: compress.ByteBuf, v: i64):
    compress.BufPush(b, (v & 255) as int)
    compress.BufPush(b, ((v >> 8) & 255) as int)
    compress.BufPush(b, ((v >> 16) & 255) as int)
    compress.BufPush(b, ((v >> 24) & 255) as int)
end

func gen_x86(n: int, seed: i64): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = lcg(x)
        k := (x >> 8) % 4
        if k < 2:
            rel := ((x >> 10) % 2000) - 1000
            if k == 0:
                compress.BufPush(out, 232)
            else:
                compress.BufPush(out, 233)
            end
            push32(out, rel & 0xffffffff)
        else:
            c := 1 + ((x >> 10) % 4)
            repeat c:
                x = lcg(x)
                compress.BufPush(out, ((x >> 12) & 255) as int)
            end
        end
    end
    ret out
end

func expected(name: str): compress.ByteBuf:
    if name == "a.txt":
        ret gen_text(30, 1)
    end
    if name == "docs/b.bin":
        ret gen_x86(120, 3)
    end
    if name == "docs/note.txt":
        mut b := compress.NewByteBuf()
        repeat 3:
            compress.BufPushBytes(b, "Salam 7z\n" as void*, 9)
        end
        ret b
    end
    if name == "فارسی.txt":
        ret compress.BufFromStr("سلام")
    end
    ret compress.NewByteBuf()
end

func check(label: str, hex: str, password: str):
    packed := kb(unhex(hex))
    mut arc := archive.SevenZipOpen(packed.data, packed.len, password)
    entries := kl(archive.SevenZipEntries(arc))
    listed := arc.status
    mut same := 0
    mut method := -1
    repeat NAMES.Len() in i:
        name := NAMES[i]
        data := kb(archive.SevenZipRead(arc, name, 0))
        if arc.status == archive.SEVENZIP_OK and compress.BufEquals(data, kb(expected(name))):
            same++
        end
        repeat entries.Len() in k:
            if entries.get(k).name == name and entries.get(k).size > 0:
                method = entries.get(k).method
            end
        end
    end
    println label, "list", listed, "entries", entries.Len(), "files equal", same, "method", method
end

func status_of(hex: str, password: str, name: str): int:
    packed := kb(unhex(hex))
    mut arc := archive.SevenZipOpen(packed.data, packed.len, password)
    data := kb(archive.SevenZipRead(arc, name, 0))
    if data.len < 0:
        ret -1
    end
    ret arc.status
end

func status_of_buf(b: compress.ByteBuf, name: str): int:
    mut arc := archive.SevenZipOpen(b.data, b.len, "")
    data := kb(archive.SevenZipRead(arc, name, 0))
    if data.len < 0:
        ret -1
    end
    ret arc.status
end

func read_text(path: str): str:
    mut ok := false
    buf := kb(archive.ReadBinaryFile(path, ok))
    if not ok:
        ret ks(str.Clone("missing"))
    end
    ret txt(buf)
end

func main:
    println "== methods =="
    check("lzma2", LZMA2, "")
    check("lzma", LZMA, "")
    check("copy", COPY, "")
    check("ppmd", PPMD, "")
    check("bzip2", BZIP2, "")
    check("deflate", DEFLATE, "")
    check("not solid", NONSOLID, "")
    check("x86 filter + lzma2", BCJ, "")
    check("delta + lzma", DELTA, "")
    check("plain header", PLAINHDR, "")

    println "== listing =="
    lz := kb(unhex(LZMA2))
    println archive.IsSevenZip(lz.data, lz.len), archive.IsSevenZip(lz.data, 3), archive.IsSevenZip("Rar!" as void*, 4)
    mut st := 0
    mut list := kl(archive.SevenZipListStatus(lz.data, lz.len, st))
    println "status", st, "entries", list.Len()
    repeat list.Len() in i:
        e := list.get(i)
        println e.name, e.size, e.is_dir, e.kind, e.method, e.crc32, e.mtime, e.mode
    end
    list2 := kl(archive.SevenZipList(lz.data, lz.len))
    println list2.Len()

    println "== passwords =="
    check("encrypted data and names", ENC, "secret")
    check("encrypted data", ENCDATA, "secret")
    println "no password", status_of(ENC, "", "a.txt"), "wrong password", status_of(ENC, "nope", "a.txt")
    println "data only: no password", status_of(ENCDATA, "", "a.txt"), "wrong password", status_of(ENCDATA, "nope", "a.txt")
    enc := kb(unhex(ENCDATA))
    mut arc_enc := archive.SevenZipOpen(enc.data, enc.len, "")
    println "names without password", kl(archive.SevenZipEntries(arc_enc)).Len(), arc_enc.status

    println "== extract one =="
    mut ok := false
    one := kb(archive.SevenZipExtractByName(lz.data, lz.len, "docs/note.txt", ok))
    println ok, txt(one)
    big := kb(archive.SevenZipExtractByNameMax(lz.data, lz.len, "a.txt", 10, ok))
    println "max 10", ok, big.len
    fit := kb(archive.SevenZipExtractByNameMax(lz.data, lz.len, "a.txt", 176, ok))
    println "max 176", ok, fit.len
    mut code := 0
    nope := kb(archive.SevenZipExtract(lz.data, lz.len, "missing.txt", 0, code))
    println "missing", nope.len, code, archive.SevenZipStatusText(code)
    dirent := kb(archive.SevenZipExtract(lz.data, lz.len, "docs", 0, code))
    println "folder", code, dirent.len
    zero := kb(archive.SevenZipExtract(lz.data, lz.len, "empty.txt", 0, code))
    println "empty file", code, zero.len

    println "== extract all =="
    dir := j(os.TempDir(), "salam_sevenzip_read")
    os.RemoveAll(dir)
    println archive.SevenZipExtractAll(lz.data, lz.len, dir)
    println read_text(j(dir, "docs/note.txt")) == txt(kb(expected("docs/note.txt"))), os.Exists(j(dir, "empty_dir")), os.Exists(j(dir, "empty.txt"))
    println read_text(j(dir, "فارسی.txt"))
    os.RemoveAll(dir)
    enc_all := kb(unhex(ENC))
    mut arc_all := archive.SevenZipOpen(enc_all.data, enc_all.len, "secret")
    println "encrypted", archive.SevenZipReadAll(arc_all, dir), arc_all.status
    println read_text(j(dir, "docs/note.txt")) == txt(kb(expected("docs/note.txt")))
    os.RemoveAll(dir)
    ppm := kb(unhex(PPMD))
    println archive.SevenZipExtractAllStatus(ppm.data, ppm.len, dir, code), code
    os.RemoveAll(dir)

    println "== crafted archive =="
    cr := kb(unhex(CRAFT))
    clist := kl(archive.SevenZipListStatus(cr.data, cr.len, st))
    println "status", st, "entries", clist.Len()
    repeat clist.Len() in i:
        e := clist.get(i)
        println e.name, e.size, e.compressed_size, e.is_dir, e.crc32, e.mtime, e.mode
    end
    craft_dir := j(os.TempDir(), "salam_sevenzip_craft")
    escape := j(os.TempDir(), "escape.txt")
    os.Remove(escape)
    println archive.SevenZipExtractAllStatus(cr.data, cr.len, craft_dir, code), archive.SevenZipStatusText(code), os.Exists(escape)
    println read_text(j(craft_dir, "folder/second.txt")), os.Exists(j(craft_dir, "deleted.txt"))
    os.RemoveAll(craft_dir)
    empty := kb(unhex(EMPTY))
    elist := kl(archive.SevenZipListStatus(empty.data, empty.len, st))
    println "empty archive", st, elist.Len(), archive.SevenZipExtractAll(empty.data, empty.len, craft_dir)
    os.RemoveAll(craft_dir)

    println "== damaged =="
    mut sig := kb(unhex(LZMA2))
    compress.BufSet(sig, 0, 56)
    println "bad signature", kl(archive.SevenZipListStatus(sig.data, sig.len, st)).Len(), st
    mut crc := kb(unhex(LZMA2))
    compress.BufSet(crc, 9, compress.BufGet(crc, 9) ^ 1)
    println "start header crc", kl(archive.SevenZipListStatus(crc.data, crc.len, st)).Len(), st
    mut hdr := kb(unhex(LZMA2))
    compress.BufSet(hdr, hdr.len - 3, compress.BufGet(hdr, hdr.len - 3) ^ 16)
    println "header crc", kl(archive.SevenZipListStatus(hdr.data, hdr.len, st)).Len(), st
    cut := kb(unhex(LZMA2))
    cut.len /= 2
    println "truncated", kl(archive.SevenZipListStatus(cut.data, cut.len, st)).Len(), st
    println "tiny", kl(archive.SevenZipListStatus(cut.data, 10, st)).Len(), st
    mut copy := kb(unhex(COPY))
    compress.BufSet(copy, 36, compress.BufGet(copy, 36) ^ 1)
    mut bad_crc := 0
    repeat NAMES.Len() in i:
        if status_of_buf(copy, NAMES[i]) == archive.SEVENZIP_BAD_CRC:
            bad_crc++
        end
    end
    println "flipped data bit: files with a bad checksum", bad_crc
    mut lzd := kb(unhex(LZMA2))
    compress.BufSet(lzd, 40, compress.BufGet(lzd, 40) ^ 64)
    println "flipped compressed bit", status_of_buf(lzd, "a.txt") != archive.SEVENZIP_OK
    println archive.SevenZipStatusText(0), "|", archive.SevenZipStatusText(2), "|", archive.SevenZipStatusText(99)
    release()
end
