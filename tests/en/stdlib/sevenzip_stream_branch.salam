0301000c9388938800080a0195ecc5480000050119020000110d0064002e00620069006e000000140a01000e1a67c64e70dd
01150601002080a4810000
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func put(p: u8*, n: int, i: int, a: int, b: int, c: int, d: int):
    if i < n:
        p[i] = (a & 255) as u8
    end
    if i + 1 < n:
        p[i + 1] = (b & 255) as u8
    end
    if i + 2 < n:
        p[i + 2] = (c & 255) as u8
    end
    if i + 3 < n:
        p[i + 3] = (d & 255) as u8
    end
end

func content(n: int): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    repeat n in i:
        compress.BufPush(b, (i * 131 + (i >> 5) * 7 + (i >> 11)) & 255)
    end
    p := b.data as u8*
    repeat n in i:
        if i % 41 == 0:
            put(p, n, i, 0xE8, i * 3, i >> 3, 0)
            if i + 4 < n:
                p[i + 4] = 0 as u8
            end
        end
        if i % 64 == 8:
            put(p, n, i, i >> 6, 0, 0, 0x94)
        end
        if i % 64 == 16:
            put(p, n, i, i >> 2, i >> 5, i >> 9, 0xEB)
        end
        if i % 64 == 24:
            put(p, n, i, 0x48, i >> 4, i >> 7, ((i >> 2) & 0xFC) | 1)
        end
        if i % 64 == 32:
            put(p, n, i, i >> 3, 0xF0 | ((i >> 6) & 7), i >> 1, 0xF8 | ((i >> 8) & 7))
        end
        if i % 64 == 36:
            put(p, n, i, 0x40, (i >> 4) & 0x3F, i >> 2, i)
        end
        if i % 64 == 44:
            put(p, n, i, 0xEF, (i >> 1) & 0xF0, i >> 3, i >> 5)
        end
    end
    ret b
end

func check(label: str, hex: str, password: str, dir: str):
    mut packed := unhex(hex)
    zname := label + ".7z"
    path := filepath.Join(dir, zname)
    archive.WriteBinaryFileBuf(path, packed)
    compress.BufFree(packed)
    mut sf := archive.SevenZipOpenFile(path, password)
    println label, "open", sf.status
    if sf.status == 0:
        out := filepath.Join(dir, label + ".bin")
        st := archive.SevenZipFileExtractTo(sf, "d.bin", out, 0 as i64, 0 as i64)
        mut ok := false
        mut got := archive.ReadBinaryFile(out, ok)
        mut want := content(5000)
        println "  extract", st, "match", ok and compress.BufEquals(got, want)
        compress.BufFree(got)
        compress.BufFree(want)
        st2 := archive.SevenZipFileExtractTo(sf, "d.bin", out, 0 as i64, 1000 as i64)
        println "  memcap", st2
        os.Remove(out)
        mem.Free(out as void*)
    end
    archive.SevenZipFileClose(sf)
    mem.Free(zname as void*)
    mem.Free(path as void*)
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_sevenzip_stream_branch")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    check("x86", F_X86, "", dir)
    check("ppc", F_PPC, "", dir)
    check("ia64", F_IA64, "", dir)
    check("arm", F_ARM, "", dir)
    check("armt", F_ARMT, "", dir)
    check("sparc", F_SPARC, "", dir)
    check("arm64", F_ARM64, "", dir)
    check("riscv", F_RISCV, "", dir)
    check("x86_lzma", F_X86_LZMA, "", dir)
    check("delta", F_DELTA, "", dir)
    os.RemoveAll(dir)
    mem.Free(dir as void*)
end
