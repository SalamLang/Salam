package main

import sftpd
import testing

func test_config_and_listen():
    mut cfg := sftpd.NewConfig()
    cfg.host = "127.0.0.1"
    cfg.port = 0
    cfg.root = "/tmp"
    mut srv := sftpd.New(cfg)
    testing.AssertTrue(sftpd.Listen(srv))
    testing.AssertTrue(sftpd.Port(srv) > 0)
    sftpd.Close(srv)
end

func main:
    test_config_and_listen()
    testing.Summary()
    ret 0
end
