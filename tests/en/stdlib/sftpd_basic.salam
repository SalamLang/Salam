package main

import sftpd
import ssh
import io
import os
import testing

func test_config_and_listen():
    mut cfg := sftpd.NewConfig()
    cfg.host = "127.0.0.1"
    cfg.port = 0
    cfg.root = "/tmp"
    mut srv := sftpd.New(cfg)
    testing.AssertTrue(sftpd.Listen(srv))
    testing.AssertTrue(sftpd.Port(srv) > 0)
    sftpd.Close(srv)
end

func test_bad_host_key():
    bad := "salam_sftpd_bad_host_key"
    io.WriteFile(bad, "not a private key")
    testing.AssertFalse(ssh.HostKeyFileOk(bad))
    mut cfg := sftpd.NewConfig()
    cfg.host = "127.0.0.1"
    cfg.port = 0
    cfg.root = "/tmp"
    cfg.host_key_file = bad
    mut srv := sftpd.New(cfg)
    testing.AssertFalse(sftpd.Listen(srv))
    os.Remove(bad)
end

func main:
    test_config_and_listen()
    test_bad_host_key()
    testing.Summary()
    ret 0
end
