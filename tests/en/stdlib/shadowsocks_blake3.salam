    hash_case(31744, "62b6960e1a44bcc1eb1a611a8d6235b6b4b78f32e7abc4fb4c6cdcce94895c47")
    hash_case(102400, "bc3e3d41a1146b069abffad3c0d44860cf664390afce4d9661f7902e7943e085")
    keyed_case(0, "ec2a5638d4baeaf02a1d6e7e0985870fd048165cbbe156b5025dbdc0f02a5765")
    derive_case(0, "2cc39783c223154fea8dfb7c1b1660f2ac2dcbd1c1de8277b0b0dd39b7e50d7d")
    keyed_case(1, "1ac23c0d164289b9a5010881c47abf84f5b55fd42cf433e081270ef043ef54e1")
    derive_case(1, "b3e2e340a117a499c6cf2398a19ee0d29cca2bb7404c73063382693bf66cb06c")
    keyed_case(1023, "cbed171bd0a38cdb04c20e56173071b7312417023a815c248cb1de9471b882d3")
    derive_case(1023, "74a16c1c3d44368a86e1ca6df64be6a2f64cce8f09220787450722d85725dea5")
    keyed_case(1024, "d2eea11f359797623f7086dd44dac069e36087ef19ee5d59664050d9f93cad82")
    derive_case(1024, "7356cd7720d5b66b6d0697eb3177d9f8d73a4a5c5e968896eb6a689684302706")
    keyed_case(1025, "10df41d5cd14a3832f76ec8ef272c40c2e2015b8db04398dd25a14d52ebc318b")
    derive_case(1025, "effaa245f065fbf82ac186839a249707c3bddf6d3fdda22d1b95a3c970379bcb")
    keyed_case(3000, "b23c803123f2a71baf2fc561a21fdc566bdd8e0837372fc8e760d07e9b2040dd")
    derive_case(3000, "844b8ed1a526c0e973c8e0eedb3d85014e6166ac41fa2b8b9d4daf0f3eed6f38")
    d := pattern(1025)
    out := mem.AllocateZeroed(131 as u64)
    shadowsocks.Blake3Hash(d, 1025, out, 131)
    check("extended output 131 bytes", shadowsocks.HexOf(out, 131) == "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444f4c4a22b4b399155358a994e52bf255de60035742ec71bd08ac275a1b51cc6bfe332b0ef84b409108cda080e6269ed4b3e2c3f7d722aa4cdc98d16deb554e5627be8f955c98e1d5f9565a9194cad0c4285f93700062d9595adb992ae68ff12800ab67a")
    mem.Free(out)
    mem.Free(d)
    session_case(16, "8180421f8f56092ca7544a64ff852536")
    session_case(32, "374fca03e4dae7f998fd7e59c1edfcc8e3197f4db1c19ca1671be3b66a92ddda")
    println "failures", failures
    ret failures
end
