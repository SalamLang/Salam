package main

import net.shadowsocks
import mem

mut failures := 0

func check(name: str, ok: bool):
    if ok:
        println "PASS", name
    else:
        println "FAIL", name
        failures++
    end
end

func pattern(n: int): void*:
    d := mem.AllocateZeroed((n + 1) as u64)
    bp := d as u8*
    repeat n in i:
        bp[i] = (i % 251) as u8
    end
    ret d
end

func seq(start: int, n: int): void*:
    d := mem.AllocateZeroed((n + 1) as u64)
    bp := d as u8*
    repeat n in i:
        bp[i] = (start + i) as u8
    end
    ret d
end

func hash_case(n: int, want: str):
    d := pattern(n)
    out := mem.AllocateZeroed(32 as u64)
    shadowsocks.Blake3Hash(d, n, out, 32)
    check("hash len " + n, shadowsocks.HexOf(out, 32) == want)
    mem.Free(out)
    mem.Free(d)
end

func keyed_case(n: int, want: str):
    d := pattern(n)
    out := mem.AllocateZeroed(32 as u64)
    key := "whats the Elvish name for friend"
    shadowsocks.Blake3KeyedHash(key as void*, d, n, out, 32)
    check("keyed len " + n, shadowsocks.HexOf(out, 32) == want)
    mem.Free(out)
    mem.Free(d)
end

func derive_case(n: int, want: str):
    d := pattern(n)
    out := mem.AllocateZeroed(32 as u64)
    shadowsocks.Blake3DeriveKey("BLAKE3 2019-12-27 16:29:52 test vectors context", d, n, out, 32)
    check("derive len " + n, shadowsocks.HexOf(out, 32) == want)
    mem.Free(out)
    mem.Free(d)
end

func session_case(k: int, want: str):
    psk := seq(0, k)
    salt := seq(32, k)
    out := mem.AllocateZeroed(32 as u64)
    shadowsocks.Blake3SessionKey(psk, k, salt, k, out)
    check("ss2022 session key " + k, shadowsocks.HexOf(out, k) == want)
    mem.Free(out)
    mem.Free(psk)
    mem.Free(salt)
end

func main:
    hash_case(0, "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262")
    hash_case(1, "2d3adedff11b61f14c886e35afa036736dcd87a74d27b5c1510225d0f592e213")
    hash_case(63, "e9bc37a594daad83be9470df7f7b3798297c3d834ce80ba85d6e207627b7db7b")
    hash_case(64, "4eed7141ea4a5cd4b788606bd23f46e212af9cacebacdc7d1f4c6dc7f2511b98")
    hash_case(65, "de1e5fa0be70df6d2be8fffd0e99ceaa8eb6e8c93a63f2d8d1c30ecb6b263dee")
    hash_case(1023, "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11")
    hash_case(1024, "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7")
    hash_case(1025, "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444")
    hash_case(2048, "e776b6028c7cd22a4d0ba182a8bf62205d2ef576467e838ed6f2529b85fba24a")
    hash_case(2049, "5f4d72f40d7a5f82b15ca2b2e44b1de3c2ef86c426c95c1af0b6879522563030")
    hash_case(3072, "b98cb0ff3623be03326b373de6b9095218513e64f1ee2edd2525c7ad1e5cffd2")
