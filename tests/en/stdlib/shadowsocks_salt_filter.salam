import mem
import net.shadowsocks

func salt(seed: int): void*:
    p := mem.AllocateZeroed(32 as u64) as u8*
    repeat 32 in i:
        p[i] = ((seed * 31 + i) & 255) as u8
    end
    ret p as void*
end

func main():
    mut f := shadowsocks.NewSaltFilter(16)
    a := salt(1)
    b := salt(2)
    println "fresh salt not seen", shadowsocks.FilterSeen(f, a, 32)
    println "looking does not record", shadowsocks.FilterSeen(f, a, 32)
    println "first use accepted", shadowsocks.FilterCheck(f, a, 32)
    println "now seen", shadowsocks.FilterSeen(f, a, 32)
    println "replay refused", shadowsocks.FilterCheck(f, a, 32)
    println "other salt unaffected", shadowsocks.FilterSeen(f, b, 32)
    println "other salt accepted", shadowsocks.FilterCheck(f, b, 32)
    mem.Free(a)
    mem.Free(b)
end
