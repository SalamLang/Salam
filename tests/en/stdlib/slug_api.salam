import encoding.slug

func taken(s: str): bool:
    ret s == "post" or s == "post-2" or s == "post-3" or s == "post-5"
end

func yes(s: str): bool:
    ret s.Len() > 0
end

func main:
    println "transliterate"
    println slug.Transliterate("Привет, мир! Zürich 42", "")
    println slug.Transliterate("Müller Größe Ärger", "de")
    println slug.Transliterate("Müller Größe Ärger", "")
    println slug.Transliterate("سلام، دنیا؟ «خوب» ۱۲۳", "fa")
    println slug.Transliterate("مرحبا بكم في العالم", "ar")
    println slug.Transliterate("ПРИВЕТ Щука", "ru")
    println slug.Transliterate("ΕΛΛΑΔΑ Ελλάδα", "el")
    println slug.Transliterate("Hello, World! (ok) 100%", "en")
    println slug.Transliterate("日本 語 こんにちは 😀 end", "ja")
    println slug.Transliterate("", "")

    println "scripts"
    println slug.DetectScript("hello")
    println slug.DetectScript("Привет")
    println slug.DetectScript("Καλημέρα")
    println slug.DetectScript("سلام")
    println slug.DetectScript("שלום")
    println slug.DetectScript("नमस्ते")
    println slug.DetectScript("สวัสดี")
    println slug.DetectScript("こんにちは")
    println slug.DetectScript("カタカナ 日本語")
    println slug.DetectScript("안녕하세요")
    println slug.DetectScript("你好世界")
    println slug.DetectScript("12345 !!!")
    println slug.DetectScript("")
    println slug.DetectScript("abc defgh ф")
    println slug.DetectScript("a я я")

    println "numbered and unique"
    println slug.Numbered("post", 1, "-")
    println slug.Numbered("post", 2, "-")
    println slug.Numbered("post", 12, "_")
    println slug.Unique("fresh", (s: str): ret taken(s) end)
    println slug.Unique("post", (s: str): ret taken(s) end)
    println slug.UniqueWith("post", "_", (s: str): ret taken(s) end)
    println slug.UniqueWith("other", "_", (s: str): ret yes(s) end)

    println "validation"
    println slug.IsSlug("hello-world")
    println slug.IsSlug("hello")
    println slug.IsSlug("a1-b2-c3")
    println slug.IsSlug("")
    println slug.IsSlug("-hello")
    println slug.IsSlug("hello-")
    println slug.IsSlug("hello--world")
    println slug.IsSlug("Hello-World")
    println slug.IsSlug("hello_world")
    println slug.IsSlug("hello world")
    println slug.IsSlug("héllo")
    println slug.IsSlug(slug.Make("Any Title, here! ☺"))

    mut opt := slug.Options {}

    opt = slug.Snake()
    println slug.IsSlugWith("hello_world", opt)
    println slug.IsSlugWith("hello-world", opt)
    opt = slug.Unicode()
    println slug.IsSlugWith("سلام-دنیا", opt)
    println slug.IsSlugWith("Привет-мир", opt)
    println slug.IsSlugWith("привет-мир", opt)
    println slug.IsSlugWith("hello!", opt)
    opt = slug.DefaultOptions()
    opt.max_length = 5
    println slug.IsSlugWith("hello", opt)
    println slug.IsSlugWith("hello-w", opt)
    opt = slug.DefaultOptions()
    opt.lowercase = false
    println slug.IsSlugWith("Hello-World", opt)
    opt.collapse = false
    println slug.IsSlugWith("a--b", opt)
    opt.trim = false
    println slug.IsSlugWith("-a-", opt)
    opt = slug.Filename()
    println slug.IsSlugWith("Report_v1.2.pdf", opt)
    opt = slug.Identifier()
    println slug.IsSlugWith("9lives", opt)
    println slug.IsSlugWith("snake_case_1", opt)

    println "presets"
    text := "My Report: Q3 2026 (final).PDF"
    println slug.Make(text)
    println slug.MakeWith(text, slug.URL())
    println slug.MakeWith(text, slug.Filename())
    println slug.MakeWith(text, slug.Snake())
    println slug.MakeWith(text, slug.Identifier())
    println slug.MakeWith("9 lives of a cat", slug.Identifier())
    println slug.MakeWith("%%%", slug.Identifier())
    println slug.MakeWith("../etc/passwd", slug.Filename())
    println slug.MakeWith("..", slug.Filename())
    println slug.MakeWith("Привет мир", slug.Unicode())

    println "language hint"
    mut lopt := slug.Options {}
    lopt = slug.DefaultOptions()
    lopt.lang = "bg"
    println slug.MakeWith("България Щастие Дъжд", lopt)
    lopt.lang = "ru"
    println slug.MakeWith("България Щастие Дъжд", lopt)
    lopt.lang = "uk"
    println slug.MakeWith("Їжак Київ Юля Яблуко", lopt)
    lopt.lang = "pt-BR"
    println slug.MakeWith("Ação e coração & mais", lopt)
    lopt.lang = "NB"
    println slug.MakeWith("Åse og Øystein", lopt)
end
