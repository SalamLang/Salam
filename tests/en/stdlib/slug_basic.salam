import encoding.slug

func main:
    println slug.Make("Hello, World!")
    println slug.Make("  Leading and trailing   spaces  ")
    println slug.Make("Already-a-slug")
    println slug.Make("snake_case_and camelCase")
    println slug.Make("10 Tips & Tricks for 100% Better Code")
    println slug.Make("What's new in v2.0? (Release Notes)")
    println slug.Make("Café crème brûlée")
    println slug.Make("UPPER lower MiXeD")
    println slug.Make("a/b\\c|d:e;f")
    println slug.Make("user@example.com")
    println slug.Make("2026-11-18 release")
    println slug.Make("---")
    println slug.Make("")
    println slug.Make("x")
    println slug.Make("سلام دنیا")
    println slug.Make("Привет мир")
    println slug.Make("こんにちは")
    println slug.Make("한국어")
    println slug.Make("สวัสดี")
    println slug.Make("नमस्ते")
    println slug.Make("שלום")
    println slug.Make("Καλημέρα")
end
