import encoding.slug
import str

func show(label: str, s: str):
    println label + ":", "[" + s + "]"
end

func main:
    show("empty", slug.Make(""))
    show("spaces", slug.Make("     "))
    show("symbols", slug.Make("!@#$%^&*()_+-=[]{};':,./<>?"))
    show("emoji only", slug.Make("😀🎉❤️🚀"))
    show("emoji mixed", slug.Make("Launch 🚀 day 🎉 2026"))
    show("apostrophes", slug.Make("Don't Stop, it's Alice's \"Wonderland\" l’été"))
    show("tabs and newlines", slug.Make("one\ttwo\nthree\r\nfour"))
    show("digits", slug.Make("Route 66 -- 3.14 -- 1,000"))
    show("combining", slug.Make("Café naïve resumé"))
    show("zero width", slug.Make("zero​width‍join⁠er bom﻿mark"))
    show("direction marks", slug.Make("\u200fمرحبا\u200e hello \u202bworld\u202c"))
    show("nbsp", slug.Make("a b c　d"))
    show("invalid utf8", slug.Make("ok\xff\xfe bad\xc3 text \xe2\x82 end"))
    show("mixed scripts", slug.Make("Hello Привет مرحبا Γειά 你好 こんにちは"))
    show("persian in english", slug.Make("Salam سلام World"))
    show("digits in scripts", slug.Make("٣ ٤ ۵ ६ ๗ ３"))
    show("superscripts", slug.Make("x² y³ H₂O"))
    show("ligatures", slug.Make("ﬁnal ﬂow ﬃ"))
    show("currency", slug.Make("€5 £3 ¥100 ₹50 ₽20 ₺7"))

    long := str.Repeat("lorem ipsum dolor sit amet ", 20000)
    r := slug.Make(long)
    println "long input length", long.Len(), "slug length", r.Len()
    println "long starts", str.Substr(r, 0, 40)

    mut opt := slug.Options {}

    opt = slug.DefaultOptions()
    opt.max_length = 60
    r2 := slug.MakeWith(long, opt)
    println "long cut", r2.Len(), "[" + r2 + "]"

    word := str.Repeat("abcdefghij", 5000)
    r3 := slug.MakeWith(word, opt)
    println "one huge word", r3.Len()
    println "one huge word full", slug.Make(word).Len()

    uni := str.Repeat("سلام ", 3000)
    mut uopt := slug.Options {}
    uopt = slug.Unicode()
    uopt.max_length = 11
    show("unicode cut by characters", slug.MakeWith(uni, uopt))
    show("unicode cut inside word", slug.MakeWith("برنامه‌نویسی", uopt))
    uopt.max_length = 4
    show("unicode hard cut", slug.MakeWith("برنامهنویسی", uopt))

    opt = slug.DefaultOptions()
    opt.max_length = 10
    show("exact fit", slug.MakeWith("abcde fghij klm", opt))
    show("exact fit plus", slug.MakeWith("abcd fghij klm", opt))
    opt.max_length = 5
    show("first word too long", slug.MakeWith("extraordinary thing", opt))
    opt.max_length = 1
    show("one char", slug.MakeWith("zed alpha", opt))
end
