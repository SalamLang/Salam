import encoding.slug

func show(label: str, s: str):
    println label + ":", "[" + s + "]"
end

func main:
    text := "  The Quick, Brown Fox -- jumps over the lazy dog!  "
    show("default", slug.Make(text))

    mut opt := slug.Options {}

    opt = slug.DefaultOptions()
    opt.separator = "_"
    show("underscore", slug.MakeWith(text, opt))

    opt = slug.DefaultOptions()
    opt.separator = ""
    show("no separator", slug.MakeWith("a b c", opt))

    opt = slug.DefaultOptions()
    opt.separator = "--"
    show("long separator", slug.MakeWith("one two three", opt))

    opt = slug.DefaultOptions()
    opt.lowercase = false
    show("keep case", slug.MakeWith("Hello World FooBar", opt))

    opt = slug.DefaultOptions()
    opt.max_length = 20
    show("max 20", slug.MakeWith(text, opt))
    opt.max_length = 9
    show("max 9", slug.MakeWith(text, opt))
    opt.max_length = 3
    show("max 3 cuts a word", slug.MakeWith(text, opt))
    opt.max_length = 1000
    show("max large", slug.MakeWith(text, opt))

    opt = slug.DefaultOptions()
    opt.trim = false
    show("no trim", slug.MakeWith("--hello world--", opt))
    opt.collapse = false
    show("no collapse", slug.MakeWith("a  b -- c", opt))
    opt.trim = true
    show("trim only", slug.MakeWith("--a  b--", opt))

    opt = slug.DefaultOptions()
    opt.allow = "._"
    show("allow", slug.MakeWith("my file_name v1.2.txt", opt))
    opt.allow = "."
    show("allow trims ends", slug.MakeWith("...hidden.file...", opt))

    opt = slug.DefaultOptions()
    slug.AddStopWords(opt, "the a an of, over")
    show("stop words", slug.MakeWith(text, opt))
    show("only stop words", slug.MakeWith("The of A", opt))
    show("stop case", slug.MakeWith("An APPLE of Gold", opt))
    slug.FreeOptions(opt)

    opt = slug.DefaultOptions()
    slug.AddReplacement(opt, "C++", "cpp")
    slug.AddReplacement(opt, "C#", "csharp")
    slug.AddReplacement(opt, ".NET", "dotnet")
    show("replace", slug.MakeWith("C++ vs C# vs .NET", opt))
    slug.FreeOptions(opt)

    opt = slug.DefaultOptions()
    opt.symbols = false
    show("symbols off", slug.MakeWith("Tom & Jerry 50% @ home", opt))
    opt.symbols = true
    show("symbols on", slug.MakeWith("Tom & Jerry 50% @ home + you", opt))
    opt.lang = "de"
    show("german words", slug.MakeWith("Tom & Jerry 50% Müller", opt))
    opt.lang = "fa"
    show("persian words", slug.MakeWith("Tom & Jerry 50%", opt))

    opt = slug.DefaultOptions()
    opt.fallback = "untitled"
    show("fallback", slug.MakeWith("!!! ???", opt))
    show("fallback empty", slug.MakeWith("", opt))

    opt = slug.Unicode()
    show("unicode fa", slug.MakeWith("سلام دنیا، ۱۲۳ ك ي", opt))
    show("unicode ru", slug.MakeWith("Привет Мир!", opt))
    show("unicode latin", slug.MakeWith("Crème Brûlée Ñandú", opt))
    show("unicode han", slug.MakeWith("你好 世界", opt))
    opt.lowercase = false
    show("unicode keep case", slug.MakeWith("Привет Мир", opt))

    opt = slug.DefaultOptions()
    opt.keep_han = false
    show("han dropped", slug.MakeWith("abc 你好 def", opt))

    opt = slug.DefaultOptions()
    opt.lang = "de"
    show("lang de", slug.MakeWith("Über Straße Köln Märchen", opt))
    opt.lang = "da"
    show("lang da", slug.MakeWith("Århus Ærø Øl", opt))
    opt.lang = "sv"
    show("lang sv", slug.MakeWith("Åre Malmö Göteborg", opt))
    opt.lang = "ar"
    show("lang ar", slug.MakeWith("قطر ثلاثة", opt))
    opt.lang = "fa"
    show("lang fa", slug.MakeWith("قطر ثلاثة", opt))
end
