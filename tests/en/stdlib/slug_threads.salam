import encoding.slug
import atomic

mut bad := atomic.NewFlag(false)
mut done := atomic.NewI64(0 as i64)

func worker():
    texts := ["Hello, World! Ünïcödé", "سلام دنیا، خوب است", "Привет, мир! Щука", "Ελληνικά Καλημέρα", "こんにちは ラーメン 안녕하세요"]
    want := ["hello-world-unicode", "slam-dnya-khub-ast", "privet-mir-shchuka", "ellinika-kalimera", "konnichiha-ramen-annyeonghaseyo"]
    repeat 300 in round:
        repeat 5 in k:
            got := slug.Make(texts[k])
            if got != want[k]:
                atomic.Set(bad, true)
            end
        end
        if round % 100 == 0:
            opt := slug.URL()
            if slug.MakeWith("A B C", opt) != "a-b-c":
                atomic.Set(bad, true)
            end
        end
    end
    count := atomic.Add(done, 1 as i64)
    if count > 6:
        atomic.Set(bad, true)
    end
end

func main:
    t1 := spawn(worker)
    t2 := spawn(worker)
    t3 := spawn(worker)
    t4 := spawn(worker)
    t5 := spawn(worker)
    t6 := spawn(worker)
    join(t1)
    join(t2)
    join(t3)
    join(t4)
    join(t5)
    join(t6)
    println "workers finished", atomic.Load(done)
    println "mismatch found", atomic.Get(bad)
end
