import encoding.slug
import sync

mut lock := sync.NewMutex()
mut mismatches := 0
mut finished := 0

func worker():
    texts := ["Hello, World! Ünïcödé", "سلام دنیا، خوب است", "Привет, мир! Щука", "Ελληνικά Καλημέρα", "こんにちは ラーメン 안녕하세요"]
    want := ["hello-world-unicode", "slam-dnya-khub-ast", "privet-mir-shchuka", "ellinika-kalimera", "konnichiha-ramen-annyeonghaseyo"]
    mut bad := 0
    repeat 300 in round:
        repeat 5 in k:
            got := slug.Make(texts[k])
            if got != want[k]:
                bad++
            end
        end
        if round % 100 == 0:
            if slug.MakeWith("A B C", slug.URL()) != "a-b-c":
                bad++
            end
        end
    end
    sync.Lock(lock)
    mismatches += bad
    finished++
    sync.Unlock(lock)
end

func main:
    t1 := spawn(worker)
    t2 := spawn(worker)
    t3 := spawn(worker)
    t4 := spawn(worker)
    t5 := spawn(worker)
    t6 := spawn(worker)
    join(t1)
    join(t2)
    join(t3)
    join(t4)
    join(t5)
    join(t6)
    println "workers finished", finished
    println "mismatches", mismatches
    sync.Destroy(lock)
end
