-- escaping
quotes: ["evt","he said \"no\""]
   count=2 name=evt
   [0] he said "no"
backslash: ["evt","c:\\path\\to"]
   count=2 name=evt
   [0] c:\path\to
control characters: ["evt","line1\nline2\ttab"]
   count=2 name=evt
   [0] line1
line2	tab
unicode: ["evt","سلام دنیا"]
   count=2 name=evt
   [0] سلام دنیا
astral plane: ["evt","ok 😀 done"]
   count=2 name=evt
   [0] ok 😀 done
empty string: ["evt",""]
   count=2 name=evt
   [0] 
-- scalars
numbers: ["evt",0,-9007199254740991,2.5]
   count=4 name=evt
   [0] 0
   [1] -9007199254740991
   [2] 2.5
flags: ["evt",true,false,null]
   count=4 name=evt
   [0] true
   [1] false
   [2] null
-- structured
raw json: ["evt",{"id":7,"tags":["a","b"],"nested":{"deep":[1,[2,3]]}},[],null]
   count=4 name=evt
   [0] {"id":7,"tags":["a","b"],"nested":{"deep":[1,[2,3]]}}
   [1] []
   [2] null
-- no name, which is what an acknowledgement sends
[5,"ok"]
["evt"] []
count: 0
-- binary arguments become placeholders
["upload","file.bin",{"_placeholder":true,"num":0},{"_placeholder":true,"num":1}]
attachments: 2
second is placeholder 0: 0
third is placeholder 1: 1
copy survived: 1 0 2
-- typed reads and their fallbacks
int of 42, of "42", of 4.75: 42 42 4
float of 4.75, of 42: 4.75 42
bool of true, of "yes", of 42: true false true
text of an object: {"a":1}
out of range: [] 0
not an array: 0 []
bool of "true": true
big number sent as text: 9007199254740993
-- a value tree, for an argument that is an object
true true 1
