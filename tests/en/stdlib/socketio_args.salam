// Building and reading the argument list of a Socket.IO event.
//
// This is where a hand-rolled client goes wrong: an apostrophe in a chat
// message, a quote in a filename, a code point past the BMP - each one turns
// into a packet the server drops without saying why. Everything below is a
// round trip, so an argument that survives being written and read again is
// one the wire will carry.

import net.socketio
import encoding.value
import mem

func dump(label: str, a: socketio.Args):
    row := socketio.ArgsJSON(a, "evt")
    println label + ": " + row
    // The name is element 0; the arguments follow it.
    println "   count=" + socketio.ItemCount(row), "name=" + socketio.ItemStr(row, 0)
    mut i := 1
    until i < socketio.ItemCount(row):
        println "   [" + (i - 1) + "] " + socketio.ItemStr(row, i)
        i += 1
    end
end

func main:
    println "-- escaping"
    mut quotes := socketio.NewArgs()
    socketio.AddStr(quotes, `he said "no"`)
    dump("quotes", quotes)
    socketio.ArgsFree(quotes)

    mut backslash := socketio.NewArgs()
    socketio.AddStr(backslash, "c:\\path\\to")
    dump("backslash", backslash)
    socketio.ArgsFree(backslash)

    mut lines := socketio.NewArgs()
    socketio.AddStr(lines, "line1\nline2\ttab")
    dump("control characters", lines)
    socketio.ArgsFree(lines)

    mut fa := socketio.NewArgs()
    socketio.AddStr(fa, "سلام دنیا")
    dump("unicode", fa)
    socketio.ArgsFree(fa)

    mut emoji := socketio.NewArgs()
    socketio.AddStr(emoji, "ok \U0001F600 done")
    dump("astral plane", emoji)
    socketio.ArgsFree(emoji)

    mut blank := socketio.NewArgs()
    socketio.AddStr(blank, "")
    dump("empty string", blank)
    socketio.ArgsFree(blank)

    println "-- scalars"
    mut nums := socketio.NewArgs()
    socketio.AddInt(nums, 0)
    socketio.AddInt(nums, 0 - 9007199254740991)
    socketio.AddFloat(nums, 2.5)
    dump("numbers", nums)
    socketio.ArgsFree(nums)

    mut flags := socketio.NewArgs()
    socketio.AddBool(flags, true)
    socketio.AddBool(flags, false)
    socketio.AddNull(flags)
    dump("flags", flags)
    socketio.ArgsFree(flags)

    println "-- structured"
    mut raw := socketio.NewArgs()
    socketio.AddJSON(raw, `{"id":7,"tags":["a","b"],"nested":{"deep":[1,[2,3]]}}`)
    socketio.AddJSON(raw, "[]")
    // An empty fragment is written as null rather than producing a packet
    // with a hole in it.
    socketio.AddJSON(raw, "")
    dump("raw json", raw)
    socketio.ArgsFree(raw)

    println "-- no name, which is what an acknowledgement sends"
    mut plain := socketio.NewArgs()
    socketio.AddInt(plain, 5)
    socketio.AddStr(plain, "ok")
    println socketio.ArgsJSON(plain, "")
    socketio.ArgsFree(plain)

    mut none := socketio.NewArgs()
    println socketio.ArgsJSON(none, "evt"), socketio.ArgsJSON(none, "")
    println "count:", socketio.ArgsCount(none)
    socketio.ArgsFree(none)

    println "-- binary arguments become placeholders"
    buf := mem.Allocate(3 as u64)
    bp := buf as i8*
    bp[0] = 1 as i8
    bp[1] = 0 as i8
    bp[2] = 2 as i8
    mut b := socketio.NewArgs()
    socketio.AddStr(b, "file.bin")
    socketio.AddBytes(b, buf, 3)
    socketio.AddBinaryStr(b, "text-as-bytes")
    mem.Free(buf)
    body := socketio.ArgsJSON(b, "upload")
    println body
    println "attachments:", b.bins.len()
    println "second is placeholder 0:", socketio.PlaceholderNum(socketio.Item(body, 2))
    println "third is placeholder 1:", socketio.PlaceholderNum(socketio.Item(body, 3))
    // Args took its own copy, so freeing the caller's buffer above changed
    // nothing here.
    println "copy survived:", socketio.BytesAt(b.bins.get(0), 0), socketio.BytesAt(b.bins.get(0), 1), socketio.BytesAt(b.bins.get(0), 2)
    socketio.ArgsFree(b)

    println "-- typed reads and their fallbacks"
    row := `["n", 42, "42", 4.75, true, "yes", null, {"a":1}, "true", "9007199254740993"]`
    println "int of 42, of \"42\", of 4.75:", socketio.ItemInt(row, 1), socketio.ItemInt(row, 2), socketio.ItemInt(row, 3)
    println "float of 4.75, of 42:", socketio.ItemFloat(row, 3), socketio.ItemFloat(row, 1)
    println "bool of true, of \"yes\", of 42:", socketio.ItemBool(row, 4), socketio.ItemBool(row, 5), socketio.ItemBool(row, 1)
    // A non-string element read as text comes back as its JSON, so nothing
    // silently turns into "".
    println "text of an object:", socketio.ItemStr(row, 7)
    println "out of range:", "[" + socketio.ItemStr(row, 99) + "]", socketio.ItemInt(row, 99)
    println "not an array:", socketio.ItemCount("null"), "[" + socketio.Item("null", 0) + "]"
    // A number a server had to send as text, so as not to lose bits on the
    // way through JavaScript, still reads as a number.
    println "bool of \"true\":", socketio.ItemBool(row, 8)
    println "big number sent as text:", socketio.ItemInt(row, 9)

    println "-- a value tree, for an argument that is an object"
    mut v := socketio.ItemValue(row, 7)
    println value.IsObject(v), value.ObjectHas(v, "a"), value.AsInt(value.ObjectGet(v, "a"))
    value.ValueFree(v)
end
