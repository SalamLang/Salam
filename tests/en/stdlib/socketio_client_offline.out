-- defaults
path: /socket.io
transports is auto: true
reconnection: true attempts: 0
delay: 1000 max: 5000 jitter %: 50
timeout: 20000 auto_connect: true
queue: 256 ack_timeout: 0 retries: 0
trailing slash: true remember upgrade: false insecure: false
-- disconnect reasons are socket.io's own strings
io server disconnect
io client disconnect
ping timeout
transport close
transport error
parse error
-- a manager that is never dialled
open: false
options carried: false /custom/mount
origin: http://127.0.0.1:1 path normalised: /custom/mount query: room=7
namespace: /chat
connected: false disconnected: true active: false
id and sid are empty: true true
transport name before connecting: polling
-- Of is idempotent, and a name without a slash is corrected
same socket: true
namespace: /admin
kept verbatim: /admin/ distinct: true
namespaces open: 3
-- handlers, with nothing connected
listeners for tick: 2 true
listeners for boom: 1
listeners for nothing: 0 false
catch-alls: 2
after Off: 0 1
-- emits are held until there is a connection
reserved names refused: false false false
ordinary emit accepted: true
send() is the message event: true
buffered: 2
volatile dropped: false
still buffered: 2
outgoing catch-all saw: out:hello;out:message;out:cursor;
-- auth is set before the connect that carries it
auth starts empty: true
auth now: {"token":"t-1"}
-- manager settings can change on a live connection
false 3 250 900 10 1500
-- a handle that points at nothing answers rather than crashing
false false true /
false 0 0 0
true true
no client
false false no manager
survived
