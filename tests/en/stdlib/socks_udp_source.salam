import mem
import net.socks
import net.udp

func wrapped(port: int, text: str): Vector<u8>:
    mut hdr := socks.EncodeUDPHeader(socks.NewAddress("127.0.0.1", port), 0)
    p := text as u8*
    repeat text.Len() in i:
        hdr.push(p[i])
    end
    ret hdr
end

func waits(sink: udp.Socket, buf: void*): int:
    mut h := ""
    mut p := 0
    ret udp.ReceiveBytes(sink, buf, 256, h, p)
end

func main():
    sink := udp.Bind(0)
    udp.SetTimeout(sink, 700)
    sport := udp.Port(sink)
    buf := mem.Allocate(256 as u64)
    mut cfg := socks.NewServerConfig(0)
    socks.AllowPrivate(cfg, true)
    sv := socks.Start(cfg)
    cl := socks.NewClient("127.0.0.1", sv.port)
    u := socks.Associate(cl)
    println "associate", u.ok
    attacker := udp.BindOn("127.0.0.2", 0)
    pkt := wrapped(sport, "stolen")
    pb := mem.Allocate(pkt.Len() as u64) as u8*
    repeat pkt.Len() in i:
        pb[i] = pkt.get(i)
    end
    udp.SendBytes(attacker, u.relay_host, u.relay_port, pb as void*, pkt.Len())
    println "datagram from another address relayed", waits(sink, buf) > 0
    println "legitimate datagram", socks.UDPSend(u, "127.0.0.1", sport, "mine")
    println "legitimate datagram relayed", waits(sink, buf) > 0
    socks.CloseUDP(u)
    socks.Stop(sv)
end
