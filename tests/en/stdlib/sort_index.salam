package main

import sort
import str

func show(label: str, idx &: Vector<int>):
    mut line := ""
    repeat idx.len() in i:
        if i > 0: line = line + " " end
        line = line + str.FromInt(idx.get(i) as i64)
    end
    println label, line
end

func identity(n: int): Vector<int>:
    mut v := Vector {} as Vector<int>
    repeat n in i:
        v.push(i)
    end
    ret v
end

func main:
    mut keys := Vector {} as Vector<f64>
    keys.push(2.5)
    keys.push(0.5)
    keys.push(9.0)
    keys.push(-1.0)
    keys.push(4.0)

    mut idx := identity(5)
    sort.SortIndex(idx, keys)
    show("ascending: ", idx)
    println "keys untouched: ", keys.get(0), keys.get(3)

    mut desc := identity(5)
    sort.SortIndexDesc(desc, keys)
    show("descending: ", desc)

    mut many := Vector {} as Vector<f64>
    repeat 40 in i:
        many.push(((i * 17) % 40) as f64)
    end
    mut big := identity(40)
    sort.SortIndex(big, many)
    mut ordered := true
    repeat 39 in i:
        if many.get(big.get(i)) > many.get(big.get(i + 1)): ordered = false end
    end
    println "forty ascending: ", ordered, big.get(0), big.get(39)

    mut big_desc := identity(40)
    sort.SortIndexDesc(big_desc, many)
    mut reversed := true
    repeat 39 in i:
        if many.get(big_desc.get(i)) < many.get(big_desc.get(i + 1)): reversed = false end
    end
    println "forty descending: ", reversed, big_desc.get(0), big_desc.get(39)

    mut one := identity(1)
    sort.SortIndex(one, keys)
    show("single: ", one)
    mut none := Vector {} as Vector<int>
    sort.SortIndexDesc(none, keys)
    println "empty: ", none.len()

    mut sub := Vector {} as Vector<int>
    sub.push(4)
    sub.push(1)
    sub.push(3)
    sort.SortIndex(sub, keys)
    show("subset: ", sub)

    keys.free()
    many.free()
    idx.free()
    desc.free()
    big.free()
    big_desc.free()
    one.free()
    none.free()
    sub.free()
end
