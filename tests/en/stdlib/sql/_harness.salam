package harness

import str
import db.sql

func one_line(q: str): str:
    flat := str.Replace(q, "\n", " ")
    mut out := str.Replace(flat, "    ", " ")
    until str.Contains(out, "  "):
        shorter := str.Replace(out, "  ", " ")
        out = shorter
    end
    ret str.Trim(out)
end

func place(d: sql.Diag): str:
    ret str.FromInt(d.line as i64) + ":" + str.FromInt(d.col as i64)
end

@en "Show"
@fa "نمایش"
pub func Show(q: str, r: sql.Report):
    flat := one_line(q)
    if r.errors == 0 and r.warnings == 0:
        println "ok   " + flat
        ret
    end
    println "bad  " + flat
    mut i := 0
    until i < r.items.len():
        d := r.items.get(i)
        println "     " + d.code + " " + place(d) + " " + d.message
        if not str.IsEmpty(d.help):
            println "       help: " + d.help
        end
        i = i + 1
    end
end

@en "Lint"
@fa "بازبینی"
pub func Lint(q: str, d: sql.Dialect):
    mut r := sql.Lint(q, d)
    Show(q, r)
    sql.FreeReport(r)
end

@en "Check"
@fa "بررسی"
pub func Check(q: str, c: sql.Catalog):
    mut r := sql.Check(q, c)
    Show(q, r)
    sql.FreeReport(r)
end

@en "Describe"
@fa "شرح"
pub func Describe(q: str, c: sql.Catalog):
    mut a := sql.Analyze(q, c)
    println "query " + one_line(q)
    println "  " + sql.StmtKindName(a.kind) + " on " + (str.IsEmpty(a.table) ? "-" : a.table)
    mut i := 0
    until i < a.params.len():
        p := a.params.get(i)
        where := str.IsEmpty(p.column) ? "?" : p.table + "." + p.column
        head := "  param " + str.FromInt(p.ordinal as i64) + " " + p.marker + " " + where
        println head + " " + sql.SalamType(p.kind, p.not_null)
        i = i + 1
    end
    mut j := 0
    until j < a.results.len():
        c2 := a.results.get(j)
        name := str.IsEmpty(c2.name) ? "(expr)" : c2.name
        head := "  out " + str.FromInt(j as i64) + " " + name + " "
        println head + sql.SalamType(c2.kind, not c2.nullable)
        j = j + 1
    end
    if not a.ok:
        mut k := 0
        until k < a.report.items.len():
            d := a.report.items.get(k)
            println "  " + d.code + " " + place(d) + " " + d.message
            k = k + 1
        end
    end
    sql.FreeAnalysis(a)
end

@en "FillOut"
@fa "پرکردن و چاپ"
pub func FillOut(q: str, a: sql.Args, d: sql.Dialect):
    mut r := sql.Report {}
    out := sql.Fill(q, a, d, r)
    if r.errors == 0:
        println "=> " + out
    else:
        Show(q, r)
    end
    sql.FreeReport(r)
end

@en "Schema"
@fa "طرح"
pub func Schema(ddl: str, d: sql.Dialect): sql.Catalog:
    mut c := sql.NewCatalog(d)
    mut r := sql.Apply(c, ddl)
    if not r.ok:
        println "DDL PROBLEM"
        Show(ddl, r)
    end
    sql.FreeReport(r)
    ret c
end

@en "Tables"
@fa "جدول ها"
pub func Tables(c: sql.Catalog):
    mut i := 0
    until i < sql.TableCount(c):
        t := sql.TableName(c, i)
        print "table " + t + ":"
        mut j := 0
        until j < sql.ColumnCount(c, t):
            col := sql.ColumnAt(c, t, j)
            mut marks := ""
            if col.primary:
                marks = marks + "k"
            end
            if col.not_null:
                marks = marks + "!"
            end
            if col.has_default:
                marks = marks + "d"
            end
            if col.auto:
                marks = marks + "a"
            end
            if col.generated:
                marks = marks + "g"
            end
            print " " + col.name + ":" + sql.KindName(col.kind) + (str.IsEmpty(marks) ? "" : "/" + marks)
            j = j + 1
        end
        println ""
        i = i + 1
    end
end
