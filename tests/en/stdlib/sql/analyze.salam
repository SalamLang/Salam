import db.sql
import str

include h "_harness.salam"

const SCHEMA := """
    CREATE TABLE users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        email TEXT NOT NULL,
        name TEXT,
        age INTEGER
    );
    CREATE TABLE orders (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL, total REAL NOT NULL);
"""

func marks(q: str, d: sql.Dialect):
    mut v := sql.Placeholders(q, d)
    print str.FromInt(sql.ParamCount(q, d) as i64) + " ["
    mut i := 0
    until i < v.len():
        if i > 0:
            print " "
        end
        print v.get(i)
        i = i + 1
    end
    println "] " + q
    v.free()
end

func main:
    lite := sql.DialectOf(sql.SQLITE)
    pg := sql.DialectOf(sql.POSTGRES)
    mut c := h.Schema(SCHEMA, lite)
    mut cp := h.Schema("CREATE TABLE notes (id BIGSERIAL PRIMARY KEY, body TEXT NOT NULL, hits INT)", pg)

    println "-- counting the placeholders"
    marks("SELECT a FROM t WHERE b = ? AND c = ?", lite)
    marks("SELECT a FROM t WHERE b = '?' AND c = ?", lite)
    marks("SELECT a FROM t", lite)
    marks("SELECT a FROM t WHERE b = ?1 AND c = :name AND d = @other", lite)
    marks("SELECT a FROM t WHERE b = $1 AND c = $2", pg)
    marks("SELECT a FROM t WHERE data ? 'k'", pg)

    println ""
    println "-- what a statement takes and returns"
    h.Describe("SELECT id, name FROM users WHERE email = ? AND age > ?", c)
    h.Describe("SELECT COUNT(*) AS n FROM users", c)
    h.Describe("INSERT INTO users (email, name) VALUES (?, ?)", c)
    h.Describe("INSERT INTO users (email) VALUES (?) RETURNING id, email", c)
    h.Describe("UPDATE users SET name = ?, age = ? WHERE id = ?", c)
    h.Describe("DELETE FROM users WHERE id = ? RETURNING email", c)
    h.Describe("CREATE TABLE later (a INT)", c)
    h.Describe("SELECT id FROM users WHERE id IN (?, ?, ?)", c)
    h.Describe("SELECT id FROM users WHERE age BETWEEN ? AND ?", c)
    h.Describe("SELECT id FROM users WHERE ? = email", c)
    h.Describe("SELECT id FROM users u JOIN orders o ON o.user_id = u.id WHERE o.total > ?", c)
    h.Describe("VALUES (1, 'a')", c)
    h.Describe("SELECT id, body FROM notes WHERE id = $1 AND body = $2", cp)
    h.Describe("SELECT id FROM notes WHERE id = $2 AND hits = $1", cp)

    println ""
    println "-- placeholder numbering has to be complete"
    h.Describe("SELECT id FROM notes WHERE id = $1 AND body = $3", cp)
    h.Describe("SELECT id FROM notes WHERE id = $2", cp)

    println ""
    println "-- ordinals in ORDER BY and GROUP BY"
    h.Check("SELECT id, email FROM users ORDER BY 1", c)
    h.Check("SELECT id, email FROM users ORDER BY 2 DESC", c)
    h.Check("SELECT id, email FROM users ORDER BY 3", c)
    h.Check("SELECT id, email FROM users ORDER BY 0", c)
    h.Check("SELECT email, COUNT(*) FROM users GROUP BY 1", c)
    h.Check("SELECT email, COUNT(*) FROM users GROUP BY 7", c)
    h.Check("SELECT id FROM users ORDER BY email", c)

    println ""
    println "-- limits take numbers"
    h.Check("SELECT id FROM users LIMIT 10", c)
    h.Check("SELECT id FROM users LIMIT ?", c)
    h.Check("SELECT id FROM users LIMIT 'ten'", c)
    h.Check("SELECT id FROM users LIMIT 10 OFFSET 'two'", c)

    println ""
    println "-- subqueries have to be the right width"
    h.Check("SELECT id FROM users WHERE id IN (SELECT user_id FROM orders)", c)
    h.Check("SELECT id FROM users WHERE id IN (SELECT id, total FROM orders)", c)
    h.Check("SELECT id FROM users WHERE id = (SELECT MAX(id) FROM orders)", c)
    h.Check("SELECT id FROM users WHERE id = (SELECT id, total FROM orders)", c)
    h.Check("SELECT id FROM users WHERE (id, email) IN (SELECT id, total FROM orders)", c)
    h.Check("SELECT id FROM users u WHERE EXISTS (SELECT id, total FROM orders)", c)

    println ""
    println "-- one column, one name"
    h.Check("SELECT id AS x, email AS y FROM users", c)
    h.Check("SELECT id AS x, email AS x FROM users", c)
    h.Check("SELECT id, email AS id FROM users", c)
    h.Check("SELECT u.id, o.id FROM users u JOIN orders o ON o.user_id = u.id", c)

    println ""
    println "-- a column cannot be set twice"
    h.Check("UPDATE users SET name = ?, age = ? WHERE id = ?", c)
    h.Check("UPDATE users SET name = ?, name = ? WHERE id = ?", c)

    sql.FreeCatalog(c)
    sql.FreeCatalog(cp)
    ret 0
end
