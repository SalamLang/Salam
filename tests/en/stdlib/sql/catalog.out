-- types and column flags read out of the DDL
table users: id:int/k!da email:text/! name:text age:int/d rating:float paid:bool/!d picture:blob joined:time slug:text/g weird:float
count 1
has users yes, has orders no
users.email yes, users.nope no
columns 10, missing table 0
name of 0 users, out of range ''

-- keys that fill themselves in
table rowid_key: id:int/k!da v:text/!
table int_key: id:int/k! v:text/!
table text_key: slug:text/k! v:text/!
table table_key: x:int/k!da v:text/!
table pair_key: a:int/k! b:int/k! v:text
ok   INSERT INTO rowid_key (v) VALUES (?)
ok   INSERT INTO table_key (v) VALUES (?)
bad  INSERT INTO int_key (v) VALUES (?)
     SQL335 1:1 "id" is the primary key and this INSERT leaves it out
       help: sqlite stores NULL there unless the column is declared INTEGER PRIMARY KEY
bad  INSERT INTO text_key (v) VALUES (?)
     SQL335 1:1 "slug" is the primary key and this INSERT leaves it out
       help: sqlite stores NULL there unless the column is declared INTEGER PRIMARY KEY
table notes: id:int/k!da body:text/!
table marks: id:int/k!da at:time/!
table plain: id:int/k! label:text/!
ok   INSERT INTO notes (body) VALUES ($1)
ok   INSERT INTO marks (at) VALUES ($1)
bad  INSERT INTO plain (label) VALUES ($1)
     SQL315 1:1 "id" is NOT NULL with no default and this INSERT leaves it out
       help: add it to the column list and to every row

-- alter, applied in order
table t2: c:text d:float/!d e:int f:int g:int
ok   SELECT c, d, e, f, g FROM t2
bad  SELECT a FROM t2
     SQL311 1:8 no column named "a" in this statement
       help: did you mean "c"?
bad  SELECT c FROM t
     SQL317 1:15 no table named "t"
       help: did you mean "t2"?

-- views
table users: id:int/k!da email:text/! paid:int/!
table payers: id:unknown email:unknown
table named: a:unknown b:unknown
table wide:
ok   SELECT id, email FROM payers
bad  SELECT nope FROM payers
     SQL311 1:8 no column named "nope" in this statement
ok   SELECT a, b FROM named
ok   SELECT anything FROM wide

-- ddl the catalog rejects
bad  CREATE TABLE t (a INT); CREATE TABLE t (b INT)
     SQL301 1:38 table "t" is declared twice
       help: drop the earlier declaration, or add IF NOT EXISTS
bad  CREATE TABLE u (a INT, a TEXT)
     SQL302 1:24 column "a" is declared twice
bad  ALTER TABLE nope ADD COLUMN x INT
     SQL303 1:13 no table named "nope"
       help: the schema has no such table
bad  ALTER TABLE t ADD COLUMN a INT
     SQL302 1:26 column "a" is declared twice
bad  ALTER TABLE t DROP COLUMN nope
     SQL304 1:27 no column named "nope"
bad  ALTER TABLE t RENAME COLUMN nope TO other
     SQL304 1:29 no column named "nope"
bad  DROP TABLE nope
     SQL303 1:12 no table named "nope"
       help: add IF EXISTS when the table may not be there
ok   DROP TABLE IF EXISTS nope
ok   CREATE TABLE IF NOT EXISTS t (a INT)
