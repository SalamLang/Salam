import db.sql
import str

include h "_harness.salam"

func str_of(n: int): str:
    ret str.FromInt(n as i64)
end

func yes(b: bool): str:
    ret b ? "yes" : "no"
end

func report(c &: sql.Catalog, ddl: str):
    mut r := sql.Apply(c, ddl)
    h.Show(ddl, r)
    sql.FreeReport(r)
end

func main:
    lite := sql.DialectOf(sql.SQLITE)
    my := sql.DialectOf(sql.MYSQL)
    pg := sql.DialectOf(sql.POSTGRES)

    println "-- types and column flags read out of the DDL"
    mut c1 := h.Schema("""
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT NOT NULL UNIQUE,
            name VARCHAR(100),
            age INT DEFAULT 0,
            rating REAL,
            paid BOOLEAN NOT NULL DEFAULT 0,
            picture BLOB,
            joined TIMESTAMP,
            slug TEXT GENERATED ALWAYS AS (lower(email)) STORED,
            weird SOMETHINGELSE
        );
    """, lite)
    h.Tables(c1)
    println "count " + str_of(sql.TableCount(c1))
    println "has users " + yes(sql.HasTable(c1, "USERS")) + ", has orders " + yes(sql.HasTable(c1, "orders"))
    println "users.email " + yes(sql.HasColumn(c1, "users", "EMAIL")) + ", users.nope " + yes(sql.HasColumn(c1, "users", "nope"))
    println "columns " + str_of(sql.ColumnCount(c1, "users")) + ", missing table " + str_of(sql.ColumnCount(c1, "nope"))
    println "name of 0 " + sql.TableName(c1, 0) + ", out of range '" + sql.TableName(c1, 9) + "'"
    sql.FreeCatalog(c1)

    println ""
    println "-- keys that fill themselves in"
    mut c2 := h.Schema("""
        CREATE TABLE rowid_key (id INTEGER PRIMARY KEY, v TEXT NOT NULL);
        CREATE TABLE int_key (id INT PRIMARY KEY, v TEXT NOT NULL);
        CREATE TABLE text_key (slug TEXT PRIMARY KEY, v TEXT NOT NULL);
        CREATE TABLE table_key (x INTEGER, v TEXT NOT NULL, PRIMARY KEY (x));
        CREATE TABLE pair_key (a INT, b INT, v TEXT, PRIMARY KEY (a, b));
    """, lite)
    h.Tables(c2)
    h.Check("INSERT INTO rowid_key (v) VALUES (?)", c2)
    h.Check("INSERT INTO table_key (v) VALUES (?)", c2)
    h.Check("INSERT INTO int_key (v) VALUES (?)", c2)
    h.Check("INSERT INTO text_key (v) VALUES (?)", c2)
    sql.FreeCatalog(c2)

    mut c3 := h.Schema("""
        CREATE TABLE notes (id BIGSERIAL PRIMARY KEY, body TEXT NOT NULL);
        CREATE TABLE marks (id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, at TIMESTAMP NOT NULL);
        CREATE TABLE plain (id INTEGER PRIMARY KEY, label TEXT NOT NULL);
    """, pg)
    h.Tables(c3)
    h.Check("INSERT INTO notes (body) VALUES ($1)", c3)
    h.Check("INSERT INTO marks (at) VALUES ($1)", c3)
    h.Check("INSERT INTO plain (label) VALUES ($1)", c3)
    sql.FreeCatalog(c3)

    println ""
    println "-- alter, applied in order"
    mut c4 := h.Schema("""
        CREATE TABLE t (a INT NOT NULL, b VARCHAR(10)) ENGINE=InnoDB;
        ALTER TABLE t MODIFY COLUMN b VARCHAR(50) NOT NULL;
        ALTER TABLE t CHANGE b c TEXT;
        ALTER TABLE t ADD COLUMN d DECIMAL(8,2) NOT NULL DEFAULT 0 COMMENT 'money';
        ALTER TABLE t ADD INDEX ix (a);
        ALTER TABLE t ADD COLUMN IF NOT EXISTS e INT, ADD COLUMN IF NOT EXISTS f INT;
        ALTER TABLE t DROP COLUMN IF EXISTS never_there;
        ALTER TABLE t DROP COLUMN a, ADD COLUMN g INT;
        ALTER TABLE t RENAME TO t2;
    """, my)
    h.Tables(c4)
    h.Check("SELECT c, d, e, f, g FROM t2", c4)
    h.Check("SELECT a FROM t2", c4)
    h.Check("SELECT c FROM t", c4)
    sql.FreeCatalog(c4)

    println ""
    println "-- views"
    mut c5 := h.Schema("""
        CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT NOT NULL, paid INT NOT NULL);
        CREATE VIEW payers AS SELECT id, email FROM users WHERE paid = 1;
        CREATE VIEW named (a, b) AS SELECT id, email FROM users;
        CREATE VIEW wide AS SELECT * FROM users;
    """, lite)
    h.Tables(c5)
    h.Check("SELECT id, email FROM payers", c5)
    h.Check("SELECT nope FROM payers", c5)
    h.Check("SELECT a, b FROM named", c5)
    h.Check("SELECT anything FROM wide", c5)
    sql.FreeCatalog(c5)

    println ""
    println "-- ddl the catalog rejects"
    mut c6 := sql.NewCatalog(lite)
    report(c6, "CREATE TABLE t (a INT); CREATE TABLE t (b INT)")
    report(c6, "CREATE TABLE u (a INT, a TEXT)")
    report(c6, "ALTER TABLE nope ADD COLUMN x INT")
    report(c6, "ALTER TABLE t ADD COLUMN a INT")
    report(c6, "ALTER TABLE t DROP COLUMN nope")
    report(c6, "ALTER TABLE t RENAME COLUMN nope TO other")
    report(c6, "DROP TABLE nope")
    report(c6, "DROP TABLE IF EXISTS nope")
    report(c6, "CREATE TABLE IF NOT EXISTS t (a INT)")
    sql.FreeCatalog(c6)
    ret 0
end
