import db.sql

func main:
    lite := sql.DialectOf(sql.SQLITE)
    mut bad := sql.Lint("SELECT id FROM t WHERE", lite)
    println bad.errors, bad.items.Len()
    println sql.DiagText(bad.items.Get(0))
    sql.FreeReport(bad)

    mut cat := sql.NewCatalog(lite)
    mut ddl := sql.Apply(cat, "CREATE TABLE users (id INTEGER PRIMARY KEY);")
    sql.FreeReport(ddl)
    mut miss := sql.Check("SELECT nope FROM users", cat)
    println sql.DiagText(miss.items.Get(0))
    println sql.DiagText(miss.items.Get(0)) == sql.ReportText(miss)
    sql.FreeReport(miss)
    sql.FreeCatalog(cat)
end
