import db.sql

include h "_harness.salam"

func main:
    lite := sql.DialectOf(sql.SQLITE)
    my := sql.DialectOf(sql.MYSQL)
    maria := sql.DialectOf(sql.MARIADB)
    pg := sql.DialectOf(sql.POSTGRES)

    println "-- the dialect a name maps to"
    println sql.DialectNamed("sqlite").name + " " + sql.DialectNamed("mysql").name
    println sql.DialectNamed("mariadb").name + " " + sql.DialectNamed("postgresql").name
    println sql.DialectNamed("pgsql").name + " " + sql.DialectNamed("nothing-at-all").name

    println ""
    println "-- auto-increment, each engine's own spelling"
    h.Lint("CREATE TABLE t (id INTEGER PRIMARY KEY AUTOINCREMENT)", lite)
    h.Lint("CREATE TABLE t (id INT AUTO_INCREMENT PRIMARY KEY)", my)
    h.Lint("CREATE TABLE t (id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY)", pg)
    h.Lint("CREATE TABLE t (id INT AUTO_INCREMENT)", lite)
    h.Lint("CREATE TABLE t (id INT AUTOINCREMENT)", my)
    h.Lint("CREATE TABLE t (id INT AUTOINCREMENT)", pg)

    println ""
    println "-- upsert, each engine's own clause"
    h.Lint("INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING", lite)
    h.Lint("INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING", pg)
    h.Lint("INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = VALUES(a)", my)
    h.Lint("INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING", my)
    h.Lint("INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = 1", lite)

    println ""
    println "-- RETURNING"
    h.Lint("DELETE FROM t WHERE a = 1 RETURNING a", lite)
    h.Lint("DELETE FROM t WHERE a = 1 RETURNING a", pg)
    h.Lint("DELETE FROM t WHERE a = 1 RETURNING a", maria)
    h.Lint("DELETE FROM t WHERE a = 1 RETURNING a", my)

    println ""
    println "-- paging"
    h.Lint("SELECT a FROM t LIMIT 10 OFFSET 5", lite)
    h.Lint("SELECT a FROM t LIMIT 5, 10", my)
    h.Lint("SELECT a FROM t LIMIT 5, 10", lite)
    h.Lint("SELECT a FROM t LIMIT 5, 10", pg)
    h.Lint("SELECT a FROM t ORDER BY a OFFSET 10 FETCH FIRST 5 ROWS ONLY", pg)

    println ""
    println "-- matching and casting"
    h.Lint("SELECT a FROM t WHERE b ILIKE 'x%'", pg)
    h.Lint("SELECT a FROM t WHERE b ILIKE 'x%'", lite)
    h.Lint("SELECT a FROM t WHERE b ILIKE 'x%'", my)
    h.Lint("SELECT a::text FROM t", pg)
    h.Lint("SELECT a::text FROM t", lite)
    h.Lint("SELECT CAST(a AS TEXT) FROM t", my)
    h.Lint("SELECT a FROM t WHERE b REGEXP 'x'", my)

    println ""
    println "-- postgres operator family"
    h.Lint("SELECT a FROM t WHERE to_tsvector(b) @@ plainto_tsquery('x')", pg)
    h.Lint("SELECT a FROM t WHERE tags @> '{x}' OR '{y}' <@ tags", pg)
    h.Lint("SELECT a FROM t WHERE data ? 'k' AND data ?| '{a}' AND data ?& '{b}'", pg)
    h.Lint("SELECT data -> 'k', data ->> 'k', data #> '{a}', data #>> '{a}' FROM t", pg)
    h.Lint("SELECT a FROM t WHERE b ~ '^x' AND c !~* 'y'", pg)
    h.Lint("SELECT a FROM t WHERE b ^@ 'pre' ORDER BY v <-> '[1]'", pg)
    h.Lint("SELECT a FROM t WHERE tags @> '{x}'", lite)
    h.Lint("SELECT data #> '{a}' FROM t", my)
    h.Lint("SELECT a FROM t WHERE b ~ 'x'", lite)

    println ""
    println "-- engine-only statements"
    h.Lint("TRUNCATE TABLE t", my)
    h.Lint("TRUNCATE TABLE t", pg)
    h.Lint("TRUNCATE TABLE t", lite)
    h.Lint("PRAGMA journal_mode = WAL", lite)
    h.Lint("PRAGMA journal_mode = WAL", my)
    h.Lint("PRAGMA journal_mode = WAL", pg)

    println ""
    println "-- quoting that differs"
    h.Lint("SELECT `a` FROM `t`", my)
    h.Lint("SELECT `a` FROM `t`", lite)
    h.Lint("SELECT `a` FROM `t`", pg)
    h.Lint("CREATE TABLE t (a INT) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", my)
    h.Lint("CREATE TABLE t (a INT, b VARCHAR(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin)", my)
    h.Lint("CREATE TABLE t (a TEXT[], b TIMESTAMP WITH TIME ZONE, c NUMERIC(10,2))", pg)
    ret 0
end
