-- every kind of value
count 6
=> INSERT INTO t (a, b, c, d, e, f) VALUES (42, 2.5, 'plain', 1, 0, NULL)
=> INSERT INTO t (a, b, c, d, e, f) VALUES (42, 2.5, 'plain', TRUE, FALSE, NULL)
=> INSERT INTO t (a, b, c, d, e, f) VALUES (42, 2.5, 'plain', 1, 0, NULL)

-- quoting a value that fights back
=> SELECT a FROM t WHERE a = 'O''Brien' OR b = 'x'' OR ''1''=''1' OR c = 'a\b' OR d = 'line1
line2' OR e = ''
=> SELECT a FROM t WHERE a = 'O''Brien' OR b = 'x'' OR ''1''=''1' OR c = 'a\\b' OR d = 'line1
line2' OR e = ''
=> SELECT a FROM t WHERE a = 'O''Brien' OR b = 'x'' OR ''1''=''1' OR c = 'a\b' OR d = 'line1
line2' OR e = ''

-- a question mark that is not a placeholder
=> SELECT a FROM t WHERE note = '?' AND id = 7
=> SELECT a FROM t WHERE note = 'who? me?' AND id = 7
=> SELECT a FROM t -- is ? a thing
 WHERE id = 7
=> SELECT a FROM t /* ? */ WHERE id = 7
=> SELECT a FROM t WHERE data ? 'k' AND id = 7

-- reusing and reordering numbered placeholders
=> SELECT a FROM t WHERE x = 7 OR y = 7 OR z = 7
=> SELECT a FROM t WHERE x = 2 AND y = 1
=> SELECT a FROM t WHERE x = 1 AND y = 2 AND z = 1

-- when the count does not agree
bad  SELECT a FROM t WHERE x = ?
     SQL400 1:1 this query takes 1 values but got 2
       help: add or remove an argument so the two agree
bad  SELECT a FROM t WHERE x = ? AND y = ? AND z = ?
     SQL400 1:1 this query takes 3 values but got 2
       help: add or remove an argument so the two agree
bad  SELECT a FROM t
     SQL400 1:1 this query takes 0 values but got 2
       help: add or remove an argument so the two agree

-- what cannot be filled in
bad  SELECT a FROM t WHERE x = :name
     SQL401 1:27 a named placeholder cannot be filled in
       help: bind by position with ? or $1
bad  SELECT a FROM t WHERE x = @name
     SQL401 1:27 a named placeholder cannot be filled in
       help: bind by position with ? or $1
bad  SELECT 'unterminated
     SQL001 1:8 unterminated string literal
       help: close it with a matching quote
=> SELECT a FROM t

-- numbers come out in full
=> VALUES (0, -9223372036854775807, 0.1, 1000000)
