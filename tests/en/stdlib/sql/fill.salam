import db.sql
import str

include h "_harness.salam"

func str_of(n: int): str:
    ret str.FromInt(n as i64)
end

func main:
    lite := sql.DialectOf(sql.SQLITE)
    my := sql.DialectOf(sql.MYSQL)
    pg := sql.DialectOf(sql.POSTGRES)

    println "-- every kind of value"
    mut all := sql.NewArgs()
    sql.AddInt(all, 42 as i64)
    sql.AddFloat(all, 2.5)
    sql.AddText(all, "plain")
    sql.AddBool(all, true)
    sql.AddBool(all, false)
    sql.AddNull(all)
    println "count " + str_of(sql.ArgCount(all))
    h.FillOut("INSERT INTO t (a, b, c, d, e, f) VALUES (?, ?, ?, ?, ?, ?)", all, lite)
    h.FillOut("INSERT INTO t (a, b, c, d, e, f) VALUES ($1, $2, $3, $4, $5, $6)", all, pg)
    h.FillOut("INSERT INTO t (a, b, c, d, e, f) VALUES (?, ?, ?, ?, ?, ?)", all, my)
    sql.FreeArgs(all)

    println ""
    println "-- quoting a value that fights back"
    mut nasty := sql.NewArgs()
    sql.AddText(nasty, "O'Brien")
    sql.AddText(nasty, "x' OR '1'='1")
    sql.AddText(nasty, "a\\b")
    sql.AddText(nasty, "line1\nline2")
    sql.AddText(nasty, "")
    h.FillOut("SELECT a FROM t WHERE a = ? OR b = ? OR c = ? OR d = ? OR e = ?", nasty, lite)
    h.FillOut("SELECT a FROM t WHERE a = ? OR b = ? OR c = ? OR d = ? OR e = ?", nasty, my)
    h.FillOut("SELECT a FROM t WHERE a = $1 OR b = $2 OR c = $3 OR d = $4 OR e = $5", nasty, pg)
    sql.FreeArgs(nasty)

    println ""
    println "-- a question mark that is not a placeholder"
    mut one := sql.NewArgs()
    sql.AddInt(one, 7 as i64)
    h.FillOut("SELECT a FROM t WHERE note = '?' AND id = ?", one, lite)
    h.FillOut("SELECT a FROM t WHERE note = 'who? me?' AND id = ?", one, lite)
    h.FillOut("SELECT a FROM t -- is ? a thing\n WHERE id = ?", one, lite)
    h.FillOut("SELECT a FROM t /* ? */ WHERE id = ?", one, lite)
    h.FillOut("SELECT a FROM t WHERE data ? 'k' AND id = $1", one, pg)

    println ""
    println "-- reusing and reordering numbered placeholders"
    h.FillOut("SELECT a FROM t WHERE x = $1 OR y = $1 OR z = $1", one, pg)
    sql.FreeArgs(one)
    mut two := sql.NewArgs()
    sql.AddInt(two, 1 as i64)
    sql.AddInt(two, 2 as i64)
    h.FillOut("SELECT a FROM t WHERE x = $2 AND y = $1", two, pg)
    h.FillOut("SELECT a FROM t WHERE x = $1 AND y = $2 AND z = $1", two, pg)

    println ""
    println "-- when the count does not agree"
    h.FillOut("SELECT a FROM t WHERE x = ?", two, lite)
    h.FillOut("SELECT a FROM t WHERE x = ? AND y = ? AND z = ?", two, lite)
    h.FillOut("SELECT a FROM t", two, lite)
    sql.FreeArgs(two)

    println ""
    println "-- what cannot be filled in"
    mut none := sql.NewArgs()
    h.FillOut("SELECT a FROM t WHERE x = :name", none, lite)
    h.FillOut("SELECT a FROM t WHERE x = @name", none, lite)
    h.FillOut("SELECT 'unterminated", none, lite)
    h.FillOut("SELECT a FROM t", none, lite)
    sql.FreeArgs(none)

    println ""
    println "-- numbers come out in full"
    mut nums := sql.NewArgs()
    sql.AddInt(nums, 0 as i64)
    sql.AddInt(nums, 0 - 9223372036854775807 as i64)
    sql.AddFloat(nums, 0.1)
    sql.AddFloat(nums, 1000000.0)
    h.FillOut("VALUES (?, ?, ?, ?)", nums, lite)
    sql.FreeArgs(nums)
    ret 0
end
