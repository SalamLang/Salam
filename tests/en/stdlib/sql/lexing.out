-- strings and names that are accepted
ok   SELECT 'plain', 'it''s here' FROM t
ok   SELECT "quoted name" FROM "odd table"
ok   SELECT `back` FROM `ticked`
ok   SELECT [bracketed] FROM [t]
ok   SELECT "a string in mysql" FROM t
ok   SELECT $tag$ body with 'quotes' $tag$ FROM t
ok   SELECT $$ anonymous $$ FROM t
ok   SELECT x'4142', X'00ff' FROM t
ok   SELECT E'escaped\n' FROM t
ok   SELECT 'a\'b' FROM t

-- numbers
ok   SELECT 1, 2.5, 0xFF, 1e9, 1.5e-3, .5 FROM t

-- comments
ok   SELECT a -- trailing FROM t
ok   SELECT a /* inline */ , b FROM t
ok   SELECT a FROM t # mysql comment

-- placeholders
ok   SELECT a FROM t WHERE b = ? AND c = ?3
ok   SELECT a FROM t WHERE b = :name AND c = @other
ok   SELECT a FROM t WHERE b = $1 AND c = $2

-- lexical errors
bad  SELECT 'unterminated FROM t
     SQL001 1:8 unterminated string literal
       help: close it with a matching quote
bad  SELECT $tag$ never closed FROM t
     SQL001 1:8 unterminated dollar-quoted string
       help: close it with the same $tag$ it opened with
bad  SELECT /* never closed FROM t
     SQL002 1:8 unterminated block comment
       help: close the comment with */
     SQL105 1:30 expected a value, found the end of the statement
       help: a column name, a literal, a function call or a placeholder goes here
bad  SELECT "never closed FROM t
     SQL003 1:8 unterminated quoted name
       help: close the name with a matching quote
bad  SELECT a FROM t WHERE b = 1 \ 2
     SQL004 1:29 unexpected character in SQL
       help: remove it or quote it as part of a literal
     SQL115 1:31 unexpected '2' after the statement
       help: a statement ends at a ';'
bad  SELECT `back` FROM t
     SQL204 1:8 backtick names are not supported by postgres
       help: quote the name with " instead
     SQL204 1:13 backtick names are not supported by postgres
       help: quote the name with " instead

-- punctuation that is not SQL
bad  SELECT a، b FROM t
     SQL005 1:9 an Arabic comma '،' is not SQL punctuation
       help: write ',' instead
bad  SELECT a FROM t WHERE b = ۵
     SQL007 1:27 numbers in SQL have to be written with ASCII digits
       help: write 0 to 9 instead of the Persian or Arabic digits
bad  SELECT a FROM t WHERE b = ‘x’
     SQL008 1:27 this text is quoted with typographic quotes
       help: SQL strings are quoted with ' ... '
bad  SELECT a FROM t WHERE b = «x»
     SQL008 1:27 this text is quoted with typographic quotes
       help: SQL strings are quoted with ' ... '
bad  SELECT a FROM t WHERE b = 1
     SQL006 1:24 an invisible character is in this statement
       help: delete it: only a plain space separates words in SQL
bad  SELECT a FROM t WHERE b ؛ 1
     SQL005 1:25 an Arabic semicolon '؛' is not SQL punctuation
       help: write ';' instead

-- placeholder markers in the wrong engine
bad  SELECT a FROM t WHERE b = ?
     SQL201 1:27 '?' is not a placeholder in postgres
       help: postgres numbers its placeholders: $1, $2
bad  SELECT a FROM t WHERE b = $1
     SQL202 1:27 '$1' is not a placeholder in sqlite
       help: this driver binds by position with ?
bad  SELECT a FROM t WHERE b = :name
     SQL203 1:27 named placeholders are not supported by postgres
       help: bind by position instead
