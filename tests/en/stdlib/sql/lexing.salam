import db.sql

include h "_harness.salam"

func main:
    lite := sql.DialectOf(sql.SQLITE)
    my := sql.DialectOf(sql.MYSQL)
    pg := sql.DialectOf(sql.POSTGRES)

    println "-- strings and names that are accepted"
    h.Lint("SELECT 'plain', 'it''s here' FROM t", lite)
    h.Lint("SELECT \"quoted name\" FROM \"odd table\"", lite)
    h.Lint("SELECT `back` FROM `ticked`", my)
    h.Lint("SELECT [bracketed] FROM [t]", lite)
    h.Lint("SELECT \"a string in mysql\" FROM t", my)
    h.Lint("SELECT $tag$ body with 'quotes' $tag$ FROM t", pg)
    h.Lint("SELECT $$ anonymous $$ FROM t", pg)
    h.Lint("SELECT x'4142', X'00ff' FROM t", lite)
    h.Lint("SELECT E'escaped\\n' FROM t", pg)
    h.Lint("SELECT 'a\\'b' FROM t", my)

    println ""
    println "-- numbers"
    h.Lint("SELECT 1, 2.5, 0xFF, 1e9, 1.5e-3, .5 FROM t", lite)

    println ""
    println "-- comments"
    h.Lint("SELECT a -- trailing\n FROM t", lite)
    h.Lint("SELECT a /* inline */ , b FROM t", lite)
    h.Lint("SELECT a FROM t # mysql comment", my)

    println ""
    println "-- placeholders"
    h.Lint("SELECT a FROM t WHERE b = ? AND c = ?3", lite)
    h.Lint("SELECT a FROM t WHERE b = :name AND c = @other", lite)
    h.Lint("SELECT a FROM t WHERE b = $1 AND c = $2", pg)

    println ""
    println "-- lexical errors"
    h.Lint("SELECT 'unterminated FROM t", lite)
    h.Lint("SELECT $tag$ never closed FROM t", pg)
    h.Lint("SELECT /* never closed FROM t", lite)
    h.Lint("SELECT \"never closed FROM t", lite)
    h.Lint("SELECT a FROM t WHERE b = 1 \\ 2", lite)
    h.Lint("SELECT `back` FROM t", pg)

    println ""
    println "-- punctuation that is not SQL"
    h.Lint("SELECT a، b FROM t", lite)
    h.Lint("SELECT a FROM t WHERE b = ۵", lite)
    h.Lint("SELECT a FROM t WHERE b = ‘x’", lite)
    h.Lint("SELECT a FROM t WHERE b = «x»", lite)
    h.Lint("SELECT a FROM t WHERE b = 1", lite)
    h.Lint("SELECT a FROM t WHERE b ؛ 1", lite)

    println ""
    println "-- placeholder markers in the wrong engine"
    h.Lint("SELECT a FROM t WHERE b = ?", pg)
    h.Lint("SELECT a FROM t WHERE b = $1", lite)
    h.Lint("SELECT a FROM t WHERE b = :name", pg)
    ret 0
end
