import db.sql

func main:
    lite := sql.DialectOf(sql.SQLITE)
    mut en := sql.Lint("SELECT id FROM t WHERE", lite)
    println sql.DiagText(en.items.Get(0))
    sql.FreeReport(en)

    sql.SetMessageLanguage("fa")
    mut fa := sql.Lint("SELECT id FROM t WHERE", lite)
    println sql.DiagText(fa.items.Get(0))
    sql.FreeReport(fa)
    mut cat := sql.NewCatalog(lite)
    mut ddl := sql.Apply(cat, "CREATE TABLE users (id INTEGER PRIMARY KEY);")
    sql.FreeReport(ddl)
    mut miss := sql.Check("SELECT nope FROM users", cat)
    println sql.ReportText(miss)
    sql.FreeReport(miss)

    sql.SetMessageLanguage("en")
    mut back := sql.Check("SELECT nope FROM users", cat)
    println sql.ReportText(back)
    sql.FreeReport(back)
    sql.FreeCatalog(cat)
end
