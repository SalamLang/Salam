-- names that resolve
ok   SELECT id, email, name FROM users
ok   SELECT u.id, o.total FROM users u JOIN orders o ON o.user_id = u.id
ok   SELECT * FROM users
ok   SELECT u.* FROM users u
ok   SELECT "a b" FROM "odd name"
ok   SELECT main.users.id FROM main.users
ok   SELECT u.email, b.email FROM users u JOIN users b ON b.id = u.boss_id
ok   SELECT a FROM (SELECT id AS a FROM users) sub WHERE sub.a = 1
ok   WITH recent AS (SELECT id, total FROM orders) SELECT id FROM recent WHERE total > 1
ok   WITH a AS (SELECT id FROM users), b AS (SELECT id FROM a) SELECT id FROM b
ok   SELECT (SELECT COUNT(*) FROM orders o WHERE o.user_id = u.id) FROM users u
ok   SELECT id FROM users u WHERE EXISTS (SELECT 1 FROM orders WHERE user_id = u.id)
ok   SELECT id FROM users WHERE id IN (SELECT user_id FROM orders)
ok   SELECT id, total FROM users JOIN orders USING (id)
ok   UPDATE users SET name = ? WHERE id = ?
ok   INSERT INTO users (email, name) VALUES (?, ?)
ok   DELETE FROM orders WHERE user_id = ?
ok   CREATE INDEX ix ON users (email)

-- names that do not
bad  SELECT id FROM user
     SQL317 1:16 no table named "user"
       help: did you mean "users"?
bad  SELECT id, mail FROM users
     SQL311 1:12 no column named "mail" in this statement
       help: did you mean "email"?
bad  SELECT o.missing FROM orders o
     SQL311 1:10 "o" has no column "missing"
bad  SELECT x.id FROM users u
     SQL310 1:8 no table or alias named "x" in this statement
       help: did you mean "u"?
bad  SELECT nope FROM users
     SQL311 1:8 no column named "nope" in this statement
       help: did you mean "name"?
bad  SELECT id FROM users u JOIN orders o ON o.user_id = u.id
     SQL312 1:8 column "id" is in more than one table here
       help: qualify it, as in u.id
bad  SELECT u.id FROM users u JOIN users u ON 1 = 1
     SQL313 1:37 "u" is used twice in this FROM
       help: give one of them a different alias
     SQL312 1:10 column "id" is in more than one table here
       help: qualify it, as in u.id
bad  UPDATE users SET names = ? WHERE id = ?
     SQL311 1:18 "users" has no column "names"
       help: did you mean "name"?
bad  UPDATE nope SET a = 1 WHERE b = 2
     SQL317 1:8 no table named "nope"
bad  DELETE FROM nope WHERE id = 1
     SQL317 1:13 no table named "nope"
bad  INSERT INTO nope (a) VALUES (1)
     SQL317 1:13 no table named "nope"
bad  CREATE INDEX ix ON users (mail)
     SQL311 1:27 no column named "mail" in this statement
       help: did you mean "email"?
bad  CREATE INDEX ix ON nope (a)
     SQL317 1:20 no table named "nope"
bad  DROP TABLE nope
     SQL317 1:12 no table named "nope"
bad  TRUNCATE TABLE nope
     SQL212 1:1 sqlite has no TRUNCATE statement
       help: write DELETE FROM the_table instead
bad  ALTER TABLE nope ADD COLUMN x INT
     SQL317 1:13 no table named "nope"
bad  SELECT u.id FROM users u JOIN orders o USING (email)
     SQL333 1:47 the right side of this join has no column "email"
       help: USING needs the column on both sides; an ON condition can name them separately
bad  SELECT u.id FROM users u JOIN orders o USING (nope)
     SQL333 1:47 the left side of this join has no column "nope"
       help: USING needs the column on both sides; an ON condition can name them separately
bad  SELECT a.* FROM users u
     SQL310 1:8 no table or alias named "a" in this statement
       help: did you mean "u"?

-- what an insert must supply
bad  INSERT INTO users (email, name) VALUES (?)
     SQL314 1:40 this row has 1 values but 2 columns are expected
       help: the column list names 2 columns
bad  INSERT INTO users (email) VALUES (?, ?)
     SQL314 1:34 this row has 2 values but 1 columns are expected
       help: the column list names 1 columns
bad  INSERT INTO users VALUES (1, 'a')
     SQL314 1:26 this row has 2 values but 5 columns are expected
       help: "users" has 5 columns
bad  INSERT INTO users (name) VALUES (?)
     SQL315 1:1 "email" is NOT NULL with no default and this INSERT leaves it out
       help: add it to the column list and to every row
bad  INSERT INTO users (email, email) VALUES (?, ?)
     SQL316 1:27 column "email" is listed twice
bad  INSERT INTO users (email, nope) VALUES (?, ?)
     SQL311 1:27 "users" has no column "nope"
       help: did you mean "name"?
bad  INSERT INTO orders (id, user_id, total) SELECT 1, 2 FROM users
     SQL314 1:1 this SELECT returns 2 columns but 3 are expected
bad  INSERT INTO users (email) VALUES (?) ON CONFLICT (nope) DO NOTHING
     SQL311 1:51 "users" has no column "nope"
       help: did you mean "name"?
bad  INSERT INTO users (email) VALUES (?) ON CONFLICT (email) DO UPDATE SET names = ?
     SQL311 1:72 "users" has no column "names"
       help: did you mean "name"?
ok   INSERT INTO users (email) VALUES (?), (?), (?)

-- writes with nothing to narrow them
bad  DELETE FROM users
     SQL320 1:1 this DELETE has no WHERE clause and removes every row
       help: add a WHERE clause, or use TRUNCATE when that is what you mean
bad  UPDATE users SET name = ?
     SQL320 1:1 this UPDATE has no WHERE clause and changes every row
       help: add a WHERE clause, or say so in a comment
ok   DELETE FROM users WHERE 1 = 1

-- a generated column cannot be written
ok   INSERT INTO t (a) VALUES (?)
bad  INSERT INTO t (a, up) VALUES (?, ?)
     SQL318 1:19 column "up" is generated and cannot be written
       help: leave it out of the statement
bad  UPDATE t SET up = ? WHERE a = ?
     SQL318 1:14 column "up" is generated and cannot be written
       help: leave it out of the statement

-- set operations have to line up
ok   SELECT id FROM users UNION SELECT id FROM orders
bad  SELECT id FROM users UNION SELECT id, total FROM orders
     SQL323 1:22 the two sides of this set operation return 1 and 2 columns
       help: both sides have to return the same number of columns

-- with no schema nothing is resolved
ok   SELECT whatever FROM wherever WHERE nothing = 1
ok   SELECT whatever FROM wherever
