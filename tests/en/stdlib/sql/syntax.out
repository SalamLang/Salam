-- select shapes
ok   SELECT 1
ok   SELECT DISTINCT a, b FROM t
ok   SELECT ALL a FROM t
ok   SELECT t.*, u.a FROM t, u
ok   SELECT a AS x, b y, c FROM t
ok   SELECT a FROM t WHERE a IS NULL OR a IS NOT NULL
ok   SELECT a FROM t WHERE a IN (1, 2, 3) AND b NOT IN (SELECT c FROM u)
ok   SELECT a FROM t WHERE a BETWEEN 1 AND 9 AND b NOT BETWEEN 2 AND 3
ok   SELECT a FROM t WHERE a LIKE 'x%' ESCAPE '\' AND b GLOB 'y*'
ok   SELECT CASE a WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE '?' END FROM t
ok   SELECT CAST(a AS TEXT), COUNT(DISTINCT b) FROM t
ok   SELECT a FROM t GROUP BY a HAVING COUNT(*) > 1 ORDER BY a DESC NULLS LAST LIMIT 5 OFFSET 2
ok   SELECT a FROM t UNION SELECT b FROM u INTERSECT SELECT c FROM v EXCEPT SELECT d FROM w
ok   WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM n) SELECT x FROM n
ok   SELECT ROW_NUMBER() OVER (PARTITION BY a ORDER BY b) FROM t
ok   SELECT COUNT(*) FILTER (WHERE a > 1) FROM t
ok   VALUES (1, 2), (3, 4)

-- joins
ok   SELECT a FROM t INNER JOIN u ON u.id = t.id
ok   SELECT a FROM t LEFT OUTER JOIN u USING (id)
ok   SELECT a FROM t RIGHT JOIN u ON 1 = 1 FULL JOIN v ON 1 = 1
ok   SELECT a FROM t CROSS JOIN u
ok   SELECT a FROM t NATURAL JOIN u
ok   SELECT a FROM (SELECT 1 AS a) sub JOIN (t JOIN u ON 1 = 1) ON 1 = 1

-- writes
ok   INSERT INTO t (a, b) VALUES (1, 2), (3, 4)
ok   INSERT INTO t DEFAULT VALUES
ok   INSERT INTO t (a) SELECT b FROM u
ok   INSERT OR IGNORE INTO t (a) VALUES (1)
ok   INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING
ok   INSERT INTO t (a) VALUES (1) ON CONFLICT (a) WHERE a > 0 DO UPDATE SET a = excluded.a WHERE t.a < 9
ok   UPDATE t SET a = 1, b = DEFAULT WHERE id = 1
ok   UPDATE t SET a = 1 FROM u WHERE u.id = t.id
ok   DELETE FROM t WHERE id = 1
ok   DELETE FROM t USING u WHERE u.id = t.id
ok   DELETE FROM t WHERE id = 1 RETURNING a, b

-- ddl and transactions
ok   CREATE TABLE IF NOT EXISTS t (a INT)
ok   CREATE TEMP TABLE t AS SELECT 1 AS a
ok   CREATE UNIQUE INDEX IF NOT EXISTS i ON t (a, b) WHERE a > 0
ok   CREATE VIEW v (x) AS SELECT a FROM t
ok   ALTER TABLE t ADD COLUMN b TEXT
ok   ALTER TABLE t RENAME TO u
ok   ALTER TABLE t RENAME COLUMN a TO b
ok   DROP TABLE IF EXISTS t
ok   DROP INDEX i
ok   BEGIN TRANSACTION
ok   COMMIT
ok   ROLLBACK TO SAVEPOINT s
ok   EXPLAIN QUERY PLAN SELECT a FROM t
ok   PRAGMA foreign_keys = ON
ok   VACUUM
ok   SELECT a FROM t; SELECT b FROM u; DELETE FROM v WHERE id = 1

