import db.sql

include h "_harness.salam"

func main:
    lite := sql.DialectOf(sql.SQLITE)
    pg := sql.DialectOf(sql.POSTGRES)

    println "-- select shapes"
    h.Lint("SELECT 1", lite)
    h.Lint("SELECT DISTINCT a, b FROM t", lite)
    h.Lint("SELECT ALL a FROM t", lite)
    h.Lint("SELECT t.*, u.a FROM t, u", lite)
    h.Lint("SELECT a AS x, b y, c FROM t", lite)
    h.Lint("SELECT a FROM t WHERE a IS NULL OR a IS NOT NULL", lite)
    h.Lint("SELECT a FROM t WHERE a IN (1, 2, 3) AND b NOT IN (SELECT c FROM u)", lite)
    h.Lint("SELECT a FROM t WHERE a BETWEEN 1 AND 9 AND b NOT BETWEEN 2 AND 3", lite)
    h.Lint("SELECT a FROM t WHERE a LIKE 'x%' ESCAPE '\\' AND b GLOB 'y*'", lite)
    h.Lint("SELECT CASE a WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE '?' END FROM t", lite)
    h.Lint("SELECT CAST(a AS TEXT), COUNT(DISTINCT b) FROM t", lite)
    h.Lint("SELECT a FROM t GROUP BY a HAVING COUNT(*) > 1 ORDER BY a DESC NULLS LAST LIMIT 5 OFFSET 2", lite)
    h.Lint("SELECT a FROM t UNION SELECT b FROM u INTERSECT SELECT c FROM v EXCEPT SELECT d FROM w", lite)
    h.Lint("WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM n) SELECT x FROM n", lite)
    h.Lint("SELECT ROW_NUMBER() OVER (PARTITION BY a ORDER BY b) FROM t", lite)
    h.Lint("SELECT COUNT(*) FILTER (WHERE a > 1) FROM t", lite)
    h.Lint("VALUES (1, 2), (3, 4)", lite)

    println ""
    println "-- joins"
    h.Lint("SELECT a FROM t INNER JOIN u ON u.id = t.id", lite)
    h.Lint("SELECT a FROM t LEFT OUTER JOIN u USING (id)", lite)
    h.Lint("SELECT a FROM t RIGHT JOIN u ON 1 = 1 FULL JOIN v ON 1 = 1", lite)
    h.Lint("SELECT a FROM t CROSS JOIN u", lite)
    h.Lint("SELECT a FROM t NATURAL JOIN u", lite)
    h.Lint("SELECT a FROM (SELECT 1 AS a) sub JOIN (t JOIN u ON 1 = 1) ON 1 = 1", lite)

    println ""
    println "-- writes"
    h.Lint("INSERT INTO t (a, b) VALUES (1, 2), (3, 4)", lite)
    h.Lint("INSERT INTO t DEFAULT VALUES", lite)
    h.Lint("INSERT INTO t (a) SELECT b FROM u", lite)
    h.Lint("INSERT OR IGNORE INTO t (a) VALUES (1)", lite)
    h.Lint("INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING", lite)
    h.Lint("INSERT INTO t (a) VALUES (1) ON CONFLICT (a) WHERE a > 0 DO UPDATE SET a = excluded.a WHERE t.a < 9", lite)
    h.Lint("UPDATE t SET a = 1, b = DEFAULT WHERE id = 1", lite)
    h.Lint("UPDATE t SET a = 1 FROM u WHERE u.id = t.id", pg)
    h.Lint("DELETE FROM t WHERE id = 1", lite)
    h.Lint("DELETE FROM t USING u WHERE u.id = t.id", pg)
    h.Lint("DELETE FROM t WHERE id = 1 RETURNING a, b", lite)

    println ""
    println "-- ddl and transactions"
    h.Lint("CREATE TABLE IF NOT EXISTS t (a INT)", lite)
    h.Lint("CREATE TEMP TABLE t AS SELECT 1 AS a", lite)
    h.Lint("CREATE UNIQUE INDEX IF NOT EXISTS i ON t (a, b) WHERE a > 0", lite)
    h.Lint("CREATE VIEW v (x) AS SELECT a FROM t", lite)
    h.Lint("ALTER TABLE t ADD COLUMN b TEXT", lite)
    h.Lint("ALTER TABLE t RENAME TO u", lite)
    h.Lint("ALTER TABLE t RENAME COLUMN a TO b", lite)
    h.Lint("DROP TABLE IF EXISTS t", lite)
    h.Lint("DROP INDEX i", lite)
    h.Lint("BEGIN TRANSACTION", lite)
    h.Lint("COMMIT", lite)
    h.Lint("ROLLBACK TO SAVEPOINT s", lite)
    h.Lint("EXPLAIN QUERY PLAN SELECT a FROM t", lite)
    h.Lint("PRAGMA foreign_keys = ON", lite)
    h.Lint("VACUUM", lite)
    h.Lint("SELECT a FROM t; SELECT b FROM u; DELETE FROM v WHERE id = 1", lite)

    println ""
    println "-- syntax errors"
    h.Lint("SELECT FROM t", lite)
    h.Lint("SELECT a FROM", lite)
    h.Lint("SELECT a FROM t WHERE", lite)
    h.Lint("SELECT a FROM t WHERE a =", lite)
    h.Lint("SELECT a, FROM t", lite)
    h.Lint("INSERT INTO t (a VALUES (1)", lite)
    h.Lint("INSERT INTO t", lite)
    h.Lint("UPDATE t SET WHERE a = 1", lite)
    h.Lint("UPDATE t a = 1", lite)
    h.Lint("DELETE t WHERE a = 1", lite)
    h.Lint("SELECT a FROM t t2 t3", lite)
    h.Lint("SELECT CASE WHEN a THEN 1", lite)
    h.Lint("SELECT a FROM t GROUP a", lite)
    h.Lint("SELECT a FROM t LEFT u ON 1 = 1", lite)
    h.Lint("CREATE TABLE t (a INT", lite)
    h.Lint("CREATE TABLE t (a INT, PRIMARY KEY)", lite)
    h.Lint("CREATE TABLE t (a INT, FOREIGN KEY (a))", lite)
    h.Lint("CREATE TABLE t (a INT GENERATED)", lite)
    h.Lint("ALTER TABLE t RENAME COLUMN a b", lite)
    h.Lint("SELECT a FROM t WHERE a NOT 1", lite)
    h.Lint("WITH x SELECT 1", lite)
    h.Lint("WITH x AS (SELECT 1) DROP TABLE t", lite)
    ret 0
end
