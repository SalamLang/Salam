import db.sql

include h "_harness.salam"

const SCHEMA := """
    CREATE TABLE users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        email TEXT NOT NULL,
        name TEXT,
        age INTEGER,
        paid BOOLEAN NOT NULL DEFAULT 0,
        joined TIMESTAMP
    );
    CREATE TABLE orders (
        id INTEGER PRIMARY KEY,
        user_id INTEGER NOT NULL,
        total REAL NOT NULL,
        note TEXT
    );
"""

const PLAIN := """
    CREATE TABLE users (
        id INTEGER PRIMARY KEY,
        email TEXT NOT NULL,
        name TEXT,
        age INTEGER,
        paid BOOLEAN NOT NULL DEFAULT 0,
        joined TIMESTAMP
    );
    CREATE TABLE orders (
        id INTEGER PRIMARY KEY,
        user_id INTEGER NOT NULL,
        total REAL NOT NULL,
        note TEXT
    );
"""

func main:
    lite := sql.DialectOf(sql.SQLITE)
    my := sql.DialectOf(sql.MYSQL)
    pg := sql.DialectOf(sql.POSTGRES)
    mut c := h.Schema(SCHEMA, lite)
    mut cm := h.Schema(PLAIN, my)
    mut cp := h.Schema(PLAIN, pg)

    println "-- comparing a column with a value of the wrong shape"
    h.Check("SELECT id FROM users WHERE age = 30", c)
    h.Check("SELECT id FROM users WHERE age = '30'", c)
    h.Check("SELECT id FROM users WHERE age = '-3'", c)
    h.Check("SELECT id FROM orders WHERE total = '1.5'", c)
    h.Check("SELECT id FROM users WHERE age = 'thirty'", c)
    h.Check("SELECT id FROM orders WHERE total = 'free'", c)
    h.Check("SELECT id FROM users WHERE age = 'thirty'", cm)
    h.Check("SELECT id FROM users WHERE age = 'thirty'", cp)
    h.Check("SELECT id FROM users WHERE email = 'ann'", c)
    h.Check("SELECT id FROM users WHERE email = 5", c)
    h.Check("SELECT id FROM users WHERE email = 5", cp)
    h.Check("SELECT id FROM users WHERE age = ?", c)
    h.Check("SELECT id FROM users WHERE age IS NULL", c)

    println ""
    println "-- group by, what is allowed"
    h.Check("SELECT age, COUNT(*) FROM users GROUP BY age", c)
    h.Check("SELECT COUNT(*) FROM users GROUP BY age", c)
    h.Check("SELECT email, COUNT(*) FROM users GROUP BY id", c)
    h.Check("SELECT * FROM users GROUP BY id", c)
    h.Check("SELECT UPPER(email) FROM users GROUP BY email", c)
    h.Check("SELECT UPPER(email) FROM users GROUP BY UPPER(email)", c)
    h.Check("SELECT email FROM users GROUP BY 2", c)
    h.Check("SELECT MAX(email) FROM users GROUP BY age", c)
    h.Check("SELECT age + 1 FROM users GROUP BY age", c)
    h.Check("SELECT (SELECT COUNT(*) FROM orders) FROM users GROUP BY id", c)
    h.Check("SELECT u.email, COUNT(*) FROM users u JOIN orders o ON o.user_id = u.id GROUP BY u.id", c)

    println ""
    println "-- group by, what is not"
    h.Check("SELECT email, COUNT(*) FROM users GROUP BY age", c)
    h.Check("SELECT email, COUNT(*) FROM users GROUP BY age", cp)
    h.Check("SELECT o.total, COUNT(*) FROM users u JOIN orders o ON o.user_id = u.id GROUP BY u.id", c)
    h.Check("SELECT id, email FROM users GROUP BY age", c)

    println ""
    println "-- aggregates belong in HAVING"
    h.Check("SELECT age FROM users GROUP BY age HAVING COUNT(*) > 1", c)
    h.Check("SELECT age FROM users WHERE COUNT(*) > 1", c)
    h.Check("SELECT age FROM users WHERE id > (SELECT COUNT(*) FROM orders)", c)

    println ""
    println "-- the types a query gives back"
    h.Describe("SELECT id, email, name, age, paid, joined FROM users WHERE id = ?", c)
    h.Describe("SELECT COUNT(*), SUM(total), AVG(total), MIN(id), MAX(note), TOTAL(total) FROM orders", c)
    h.Describe("SELECT id, total FROM orders WHERE total > ? AND note = ?", c)
    h.Describe("SELECT u.id, o.total FROM users u LEFT JOIN orders o ON o.user_id = u.id", c)
    h.Describe("SELECT o.total, u.id FROM orders o RIGHT JOIN users u ON o.user_id = u.id", c)
    h.Describe("SELECT COALESCE(name, 'none') AS who, IFNULL(age, 0) AS years FROM users", c)
    h.Describe("SELECT CAST(age AS TEXT) AS txt, id * 2 AS doubled, total / 2 FROM orders, users", c)
    h.Describe("SELECT email || '!' AS shout, age > 1 AS big FROM users", c)
    h.Describe("SELECT CASE WHEN age > 1 THEN 'old' ELSE 'new' END AS band FROM users", c)
    h.Describe("SELECT * FROM users u JOIN orders o ON o.user_id = u.id", c)
    h.Describe("SELECT 1, 'text', 2.5, NULL, TRUE", c)

    sql.FreeCatalog(c)
    sql.FreeCatalog(cm)
    sql.FreeCatalog(cp)
    ret 0
end
