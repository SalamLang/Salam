package main

import db.sql
import testing

func first_code(r: sql.Report): str:
    if r.items.len() == 0:
        ret ""
    end
    ret r.items.get(0).code
end

func lint_code(q: str, d: sql.Dialect): str:
    mut r := sql.Lint(q, d)
    out := first_code(r)
    sql.FreeReport(r)
    ret out
end

func lint_ok(q: str, d: sql.Dialect): bool:
    mut r := sql.Lint(q, d)
    out := r.ok
    sql.FreeReport(r)
    ret out
end

func check_code(q: str, c: sql.Catalog): str:
    mut r := sql.Check(q, c)
    out := first_code(r)
    sql.FreeReport(r)
    ret out
end

func check_help(q: str, c: sql.Catalog): str:
    mut r := sql.Check(q, c)
    mut out := ""
    if r.items.len() > 0:
        out = r.items.get(0).help
    end
    sql.FreeReport(r)
    ret out
end

func check_ok(q: str, c: sql.Catalog): bool:
    mut r := sql.Check(q, c)
    out := r.errors == 0 and r.warnings == 0
    sql.FreeReport(r)
    ret out
end

func main:
    lite := sql.DialectOf(sql.SQLITE)
    my := sql.DialectOf(sql.MYSQL)
    pg := sql.DialectOf(sql.POSTGRES)
    testing.AssertEqStr(lite.name, "sqlite")
    testing.AssertEqStr(sql.DialectNamed("postgresql").name, "postgres")
    testing.AssertEqStr(sql.DialectNamed("nothing").name, "sqlite")

    testing.AssertTrue(lint_ok("SELECT id, name AS n FROM users u WHERE u.age BETWEEN ? AND ? ORDER BY name DESC LIMIT 10 OFFSET 5", lite))
    testing.AssertTrue(lint_ok("WITH t AS (SELECT id FROM a) SELECT COUNT(*) FROM t", lite))
    testing.AssertTrue(lint_ok("SELECT CASE WHEN a > 1 THEN 'x' ELSE 'y' END FROM t", lite))
    testing.AssertTrue(lint_ok("INSERT INTO t (a, b) VALUES (1, 2), (3, 4)", lite))
    testing.AssertTrue(lint_ok("SELECT a FROM t1 LEFT OUTER JOIN t2 USING (id) WHERE a IS NOT NULL", lite))
    testing.AssertTrue(lint_ok("SELECT x::text FROM t WHERE y ILIKE $1", pg))
    testing.AssertTrue(lint_ok("SELECT `a` FROM `t` WHERE b = \"text\" # a comment", my))
    testing.AssertTrue(lint_ok("CREATE TABLE t (id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT NOT NULL)", lite))
    testing.AssertTrue(lint_ok("SELECT $tag$body$tag$ FROM t", pg))
    testing.AssertTrue(lint_ok("INSERT INTO t (a) VALUES (?) ON DUPLICATE KEY UPDATE a = VALUES(a)", my))
    testing.AssertTrue(lint_ok("UPDATE t SET a = DEFAULT WHERE id = 1", lite))

    testing.AssertEqStr(lint_code("SELECT 'open FROM t", lite), "SQL001")
    testing.AssertEqStr(lint_code("SELECT /* open FROM t", lite), "SQL002")
    testing.AssertEqStr(lint_code("SELECT \"open FROM t", lite), "SQL003")
    testing.AssertEqStr(lint_code("SELECT a FROM t WHERE b = 1 \\ 2", lite), "SQL004")
    testing.AssertEqStr(lint_code("INSERT INTO t (a VALUES (1)", lite), "SQL101")
    testing.AssertEqStr(lint_code("UPDATE t SET WHERE a = 1", lite), "SQL102")
    testing.AssertEqStr(lint_code("SELECT FROM t", lite), "SQL105")
    testing.AssertEqStr(lint_code("SELECT a FROM t t2 t3", lite), "SQL115")

    testing.AssertEqStr(lint_code("SELECT a FROM t WHERE id = ?", pg), "SQL201")
    testing.AssertEqStr(lint_code("SELECT a FROM t WHERE id = $1", lite), "SQL202")
    testing.AssertEqStr(lint_code("SELECT a FROM `t`", pg), "SQL204")
    testing.AssertEqStr(lint_code("SELECT a FROM t WHERE b ILIKE 'x'", lite), "SQL205")
    testing.AssertEqStr(lint_code("SELECT a::text FROM t", my), "SQL206")
    testing.AssertEqStr(lint_code("SELECT a FROM t LIMIT 1, 2", pg), "SQL207")
    testing.AssertEqStr(lint_code("DELETE FROM t WHERE a = 1 RETURNING a", my), "SQL208")
    testing.AssertEqStr(lint_code("INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING", my), "SQL209")
    testing.AssertEqStr(lint_code("INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = 1", lite), "SQL210")
    testing.AssertEqStr(lint_code("CREATE TABLE t (id INT AUTO_INCREMENT)", lite), "SQL211")
    testing.AssertEqStr(lint_code("CREATE TABLE t (id INT AUTOINCREMENT)", pg), "SQL211")
    testing.AssertEqStr(lint_code("TRUNCATE TABLE t", lite), "SQL212")
    testing.AssertEqStr(lint_code("PRAGMA foreign_keys = ON", my), "SQL213")

    testing.AssertEqInt(sql.ParamCount("SELECT a FROM t WHERE b = ? AND c = ?", lite), 2)
    testing.AssertEqInt(sql.ParamCount("SELECT a FROM t WHERE b = '?'", lite), 0)
    mut marks := sql.Placeholders("SELECT a FROM t WHERE b = $1 AND c = $2", pg)
    testing.AssertEqInt(marks.len(), 2)
    testing.AssertEqStr(marks.get(0), "$1")
    testing.AssertEqStr(marks.get(1), "$2")
    marks.free()

    mut cat := sql.NewCatalog(lite)
    mut ddl := sql.Apply(cat, """
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT NOT NULL,
            name TEXT,
            age INTEGER DEFAULT 0,
            paid BOOLEAN NOT NULL DEFAULT 0,
            slug TEXT GENERATED ALWAYS AS (lower(email)) STORED
        );
        CREATE TABLE orders (
            id INTEGER PRIMARY KEY,
            user_id INTEGER NOT NULL,
            total REAL NOT NULL
        );
        ALTER TABLE orders ADD COLUMN note TEXT;
        CREATE VIEW payers AS SELECT id, email FROM users WHERE paid = 1;
    """)
    testing.AssertTrue(ddl.ok)
    sql.FreeReport(ddl)

    testing.AssertEqInt(sql.TableCount(cat), 3)
    testing.AssertTrue(sql.HasTable(cat, "USERS"))
    testing.AssertFalse(sql.HasTable(cat, "sessions"))
    testing.AssertTrue(sql.HasColumn(cat, "orders", "note"))
    testing.AssertEqInt(sql.ColumnCount(cat, "users"), 6)
    id_col := sql.ColumnAt(cat, "users", 0)
    testing.AssertEqStr(id_col.name, "id")
    testing.AssertEqInt(id_col.kind, sql.TYPE_INT)
    testing.AssertTrue(id_col.primary)
    testing.AssertTrue(id_col.not_null)
    testing.AssertTrue(id_col.auto)
    name_col := sql.ColumnAt(cat, "users", 2)
    testing.AssertEqInt(name_col.kind, sql.TYPE_TEXT)
    testing.AssertFalse(name_col.not_null)
    testing.AssertEqInt(sql.ColumnAt(cat, "users", 4).kind, sql.TYPE_BOOL)
    testing.AssertTrue(sql.ColumnAt(cat, "users", 5).generated)
    testing.AssertEqInt(sql.ColumnAt(cat, "orders", 2).kind, sql.TYPE_FLOAT)
    testing.AssertEqStr(sql.KindName(sql.TYPE_TEXT), "text")
    testing.AssertEqStr(sql.SalamType(sql.TYPE_INT, true), "i64")
    testing.AssertEqStr(sql.SalamType(sql.TYPE_TEXT, false), "option.Option<str>")

    testing.AssertTrue(check_ok("SELECT u.id, o.total FROM users u JOIN orders o ON o.user_id = u.id WHERE u.age > ?", cat))
    testing.AssertTrue(check_ok("WITH top AS (SELECT user_id, total FROM orders) SELECT user_id FROM top WHERE total > ?", cat))
    testing.AssertTrue(check_ok("INSERT INTO users (email, name) VALUES (?, ?) RETURNING id", cat))
    testing.AssertTrue(check_ok("SELECT COUNT(*) FROM orders o WHERE o.user_id IN (SELECT id FROM users WHERE email = ?)", cat))
    testing.AssertTrue(check_ok("SELECT id, email FROM payers WHERE id = ?", cat))
    testing.AssertTrue(check_ok("UPDATE users SET name = ? WHERE id = ?", cat))

    testing.AssertEqStr(check_code("SELECT id, emial FROM users", cat), "SQL311")
    testing.AssertEqStr(check_help("SELECT id, emial FROM users", cat), "did you mean \"email\"?")
    testing.AssertEqStr(check_code("SELECT id FROM user", cat), "SQL317")
    testing.AssertEqStr(check_help("SELECT id FROM user", cat), "did you mean \"users\"?")
    testing.AssertEqStr(check_code("SELECT o.missing FROM orders o", cat), "SQL311")
    testing.AssertEqStr(check_code("SELECT x.id FROM users u", cat), "SQL310")
    testing.AssertEqStr(check_code("SELECT id FROM users u JOIN orders o ON o.user_id = u.id", cat), "SQL312")
    testing.AssertEqStr(check_code("SELECT u.id FROM users u JOIN users u ON 1 = 1", cat), "SQL313")
    testing.AssertEqStr(check_code("INSERT INTO users (email, name) VALUES (?)", cat), "SQL314")
    testing.AssertEqStr(check_code("INSERT INTO users (name) VALUES (?)", cat), "SQL315")
    testing.AssertEqStr(check_code("INSERT INTO users (email, email) VALUES (?, ?)", cat), "SQL316")
    testing.AssertEqStr(check_code("INSERT INTO users (email, slug) VALUES (?, ?)", cat), "SQL318")
    testing.AssertEqStr(check_code("DELETE FROM users", cat), "SQL320")
    testing.AssertEqStr(check_code("SELECT id FROM users UNION SELECT id, email FROM users", cat), "SQL323")
    testing.AssertEqStr(check_code("DROP TABLE sessions", cat), "SQL317")
    testing.AssertEqStr(check_code("CREATE INDEX ix ON users (emial)", cat), "SQL311")

    mut a := sql.Analyze("SELECT id, name, age FROM users WHERE email = ? AND age > ?", cat)
    testing.AssertTrue(a.ok)
    testing.AssertEqInt(a.kind, sql.STMT_SELECT)
    testing.AssertEqStr(a.table, "users")
    testing.AssertEqStr(sql.StmtKindName(a.kind), "select")
    testing.AssertEqInt(a.params.len(), 2)
    testing.AssertEqStr(a.params.get(0).column, "email")
    testing.AssertEqInt(a.params.get(0).kind, sql.TYPE_TEXT)
    testing.AssertTrue(a.params.get(0).not_null)
    testing.AssertEqStr(a.params.get(1).column, "age")
    testing.AssertEqInt(a.params.get(1).ordinal, 2)
    testing.AssertEqInt(a.results.len(), 3)
    testing.AssertEqStr(a.results.get(0).name, "id")
    testing.AssertFalse(a.results.get(0).nullable)
    testing.AssertTrue(a.results.get(1).nullable)
    sql.FreeAnalysis(a)

    mut b := sql.Analyze("SELECT * FROM users u LEFT JOIN orders o ON o.user_id = u.id", cat)
    testing.AssertEqInt(b.results.len(), 10)
    testing.AssertEqStr(b.results.get(0).name, "id")
    testing.AssertFalse(b.results.get(0).nullable)
    testing.AssertEqStr(b.results.get(6).name, "id")
    testing.AssertTrue(b.results.get(6).nullable)
    sql.FreeAnalysis(b)

    mut c := sql.Analyze("INSERT INTO users (email, name) VALUES (?, ?) RETURNING id, email", cat)
    testing.AssertEqInt(c.kind, sql.STMT_INSERT)
    testing.AssertEqStr(c.table, "users")
    testing.AssertEqInt(c.params.len(), 2)
    testing.AssertEqStr(c.params.get(1).column, "name")
    testing.AssertFalse(c.params.get(1).not_null)
    testing.AssertEqInt(c.results.len(), 2)
    testing.AssertEqStr(c.results.get(1).name, "email")
    sql.FreeAnalysis(c)

    mut e := sql.Analyze("SELECT COUNT(*) AS n, MAX(total) AS top FROM orders", cat)
    testing.AssertEqInt(e.results.len(), 2)
    testing.AssertEqStr(e.results.get(0).name, "n")
    testing.AssertEqInt(e.results.get(0).kind, sql.TYPE_INT)
    testing.AssertFalse(e.results.get(0).nullable)
    testing.AssertEqInt(e.results.get(1).kind, sql.TYPE_FLOAT)
    sql.FreeAnalysis(e)

    mut pgcat := sql.NewCatalog(pg)
    mut pgddl := sql.Apply(pgcat, "CREATE TABLE notes (id BIGSERIAL PRIMARY KEY, body TEXT NOT NULL, tags TEXT[])")
    testing.AssertTrue(pgddl.ok)
    sql.FreeReport(pgddl)
    testing.AssertEqInt(sql.ColumnAt(pgcat, "notes", 0).kind, sql.TYPE_INT)
    testing.AssertTrue(check_ok("SELECT id, body FROM notes WHERE id = $1 AND body = $2", pgcat))
    mut gap := sql.Analyze("SELECT id FROM notes WHERE id = $1 AND body = $3", pgcat)
    testing.AssertFalse(gap.ok)
    testing.AssertEqStr(first_code(gap.report), "SQL319")
    testing.AssertEqInt(gap.params.len(), 2)
    testing.AssertEqInt(gap.params.get(1).ordinal, 3)
    sql.FreeAnalysis(gap)
    sql.FreeCatalog(pgcat)

    sql.FreeCatalog(cat)
    ret testing.Summary()
end
