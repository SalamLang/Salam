package main

import sshd
import testing

func test_config_and_listen():
    mut cfg := sshd.NewConfig()
    cfg.host = "127.0.0.1"
    cfg.port = 0
    sshd.AddUser(cfg, "alice", "secret", "/tmp")
    mut srv := sshd.New(cfg)
    testing.AssertTrue(sshd.Listen(srv))
    testing.AssertTrue(sshd.Port(srv) > 0)
    sshd.Close(srv)
end

func main:
    test_config_and_listen()
    testing.Summary()
    ret 0
end
