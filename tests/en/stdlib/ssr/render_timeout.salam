package main

import net.http
import net.router
import net.ssr
import net.internal.ssrpage
import env
import time
import testing

server func Slow(ms: int): int:
    time.Sleep(ms)
    ret ms
end

func render(c: i64):
    ssrpage.PageBegin()
    path := ssr.PagePath(c)
    mut wait := 0
    if path == "/slow":
        wait = 200
    end
    got := Slow(wait)
    calls := ssrpage.PageCalls()
    ssrpage.PageRespond(c, path, "/x", "<html><body>page " + got + "</body></html>", calls)
    ssrpage.PageEnd()
end

func main:
    __salam_register_server_funcs()
    _ok := env.Set("SALAM_RENDER_TIMEOUT_MS", "100")
    ssr.SetRender(render)
    mut r := router.NewRouter()
    ssr.Mount(r)
    mut s := http.NewServer(0)
    http.Use(s, r)
    port := http.RunBackgroundPort(s)
    base := "http://127.0.0.1:" + port

    slow := http.Get(base + "/slow")
    testing.AssertEqInt(http.Status(slow), 504)
    testing.AssertContains(http.Body(slow), "too long")

    fast := http.Get(base + "/fast")
    testing.AssertEqInt(http.Status(fast), 200)
    testing.AssertContains(http.Body(fast), "page 0")

    _ok2 := env.Set("SALAM_RENDER_TIMEOUT_MS", "0")
    unlimited := http.Get(base + "/slow")
    testing.AssertEqInt(http.Status(unlimited), 200)
    ret testing.Summary()
end
