package main

import str

func show(label: str, v: bool):
    println label, v
end

func main:
    println "methods"
    s := "salam donya"
    show("starts", s.starts_with("salam"))
    show("starts not", s.starts_with("donya"))
    show("starts empty", s.starts_with(""))
    show("starts equal", s.starts_with(s))
    show("starts longer", s.starts_with("salam donya!"))
    show("ends", s.ends_with("donya"))
    show("ends not", s.ends_with("salam"))
    show("ends empty", s.ends_with(""))
    show("ends equal", s.ends_with(s))
    show("ends longer", s.ends_with("!salam donya"))
    show("includes", s.includes("am do"))
    show("includes empty", s.includes(""))
    show("includes longer", s.includes("salam donya!"))
    show("empty starts empty", "".starts_with(""))
    show("empty ends empty", "".ends_with(""))
    show("empty includes empty", "".includes(""))
    show("empty starts a", "".starts_with("a"))
    show("empty ends a", "".ends_with("a"))
    show("empty includes a", "".includes("a"))
    show("fa starts", "سلام دنیا".starts_with("سلام"))
    show("fa ends", "سلام دنیا".ends_with("دنیا"))
    show("fa inner", "سلام دنیا".includes("م د"))
    show("fa half char", "سلام".starts_with("\xd8"))
    show("fa mismatch", "سلام".ends_with("دنیا"))
    show("case", "Salam".starts_with("salam"))
    show("repeat", "aaa".ends_with("aa"))
    show("overlap", "abab".includes("bab"))

    println "std funcs"
    show("StartsWith", str.StartsWith(s, "sal"))
    show("EndsWith", str.EndsWith(s, "nya"))
    show("StartsWith long", str.StartsWith("ab", "abc"))
    show("EndsWith long", str.EndsWith("ab", "abc"))
    show("StartsWith empty", str.StartsWith("", ""))

    println "fold"
    show("fold start", str.StartsWithFold("Salam Donya", "SALAM"))
    show("fold start no", str.StartsWithFold("Salam Donya", "DONYA"))
    show("fold start empty", str.StartsWithFold("Salam", ""))
    show("fold start long", str.StartsWithFold("Sa", "SALAM"))
    show("fold end", str.EndsWithFold("Salam Donya", "DONYA"))
    show("fold end no", str.EndsWithFold("Salam Donya", "SALAM"))
    show("fold end empty", str.EndsWithFold("Salam", ""))
    show("fold end long", str.EndsWithFold("ya", "DONYA"))
    show("fold sharp s", str.StartsWithFold("Stra\xc3\x9fe", "STRASS"))
    show("fold sharp s end", str.EndsWithFold("Stra\xc3\x9f", "ASS"))
    show("fold greek", str.StartsWithFold("\xce\x91\xce\xb2", "\xce\xb1"))
    show("fold fa", str.StartsWithFold("سلام دنیا", "سلام"))
    show("fold fa end", str.EndsWithFold("سلام دنیا", "دنیا"))

    println "any"
    mut ps := Vector {} as Vector<str>
    ps.push("http://")
    ps.push("https://")
    show("any start", str.StartsWithAny("https://x.org", ps))
    show("any start no", str.StartsWithAny("ftp://x.org", ps))
    show("any start empty", str.StartsWithAny("x", Vector {} as Vector<str>))
    mut ss := Vector {} as Vector<str>
    ss.push(".png")
    ss.push(".jpg")
    show("any end", str.EndsWithAny("a.jpg", ss))
    show("any end no", str.EndsWithAny("a.gif", ss))
    ss.push("")
    show("any end empty member", str.EndsWithAny("a.gif", ss))

    println "cut"
    mut ok := false
    r := str.CutPrefix("--name=x", "--", ok)
    println r, ok
    r2 := str.CutPrefix("name=x", "--", ok)
    println r2, ok
    r3 := str.CutSuffix("file.txt", ".txt", ok)
    println r3, ok
    r4 := str.CutSuffix("file.txt", ".md", ok)
    println r4, ok
    r5 := str.CutPrefix("abc", "abc", ok)
    println "[" + r5 + "]", ok
    r6 := str.CutSuffix("abc", "", ok)
    println r6, ok
    r7 := str.CutPrefix("سلام دنیا", "سلام ", ok)
    println r7, ok
end
