package main

import str
import mem

func show(label: str, v: bool):
    println label, v
end

func main:
    a := mem.MustAllocateZeroed(8 as u64) as i8*
    b := mem.MustAllocateZeroed(8 as u64) as i8*
    a[0] = 1 as i8
    a[1] = 0 as i8
    a[2] = 2 as i8
    a[3] = 0 as i8
    a[4] = 255 as i8
    b[0] = 1 as i8
    b[1] = 0 as i8
    b[2] = 2 as i8
    show("bytes start nul", str.StartsWithBytes(a as void*, 5, b as void*, 3))
    show("bytes start whole", str.StartsWithBytes(a as void*, 3, b as void*, 3))
    show("bytes start empty", str.StartsWithBytes(a as void*, 5, b as void*, 0))
    show("bytes start empty data", str.StartsWithBytes(a as void*, 0, b as void*, 0))
    show("bytes start long", str.StartsWithBytes(a as void*, 2, b as void*, 3))
    b[2] = 3 as i8
    show("bytes start differ after nul", str.StartsWithBytes(a as void*, 5, b as void*, 3))
    b[0] = 2 as i8
    b[1] = 0 as i8
    b[2] = 255 as i8
    show("bytes end", str.EndsWithBytes(a as void*, 5, (((b as void*) as i64 + 2) as void*), 1))
    b[0] = 0 as i8
    b[1] = 255 as i8
    show("bytes end nul", str.EndsWithBytes(a as void*, 5, b as void*, 2))
    show("bytes end empty", str.EndsWithBytes(a as void*, 5, b as void*, 0))
    show("bytes end long", str.EndsWithBytes(a as void*, 1, b as void*, 2))
    show("bytes negative", str.EndsWithBytes(a as void*, 5, b as void*, 0 - 1))
    mem.Free(a as void*)
    mem.Free(b as void*)
end
