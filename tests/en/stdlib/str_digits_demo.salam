package main

import testing
import str

func test_to_english():
    testing.AssertEqStr(str.ToEnglishDigits("۰۱۲۳۴۵۶۷۸۹"), "0123456789")
    testing.AssertEqStr(str.ToEnglishDigits("٠١٢٣٤٥٦٧٨٩"), "0123456789")
    testing.AssertEqStr(str.ToEnglishDigits("0123456789"), "0123456789")
    // Mixed scripts and non-digit text pass through untouched.
    testing.AssertEqStr(str.ToEnglishDigits("قیمت: ۱۲۳ تومان و 45 دلار و ٦٧ ریال"), "قیمت: 123 تومان و 45 دلار و 67 ریال")
end

func test_to_persian():
    testing.AssertEqStr(str.ToPersianDigits("0123456789"), "۰۱۲۳۴۵۶۷۸۹")
    testing.AssertEqStr(str.ToPersianDigits("٠١٢٣٤٥٦٧٨٩"), "۰۱۲۳۴۵۶۷۸۹")
end

func test_to_arabic():
    testing.AssertEqStr(str.ToArabicDigits("0123456789"), "٠١٢٣٤٥٦٧٨٩")
    testing.AssertEqStr(str.ToArabicDigits("۰۱۲۳۴۵۶۷۸۹"), "٠١٢٣٤٥٦٧٨٩")
end

func test_digit_value():
    testing.AssertEqInt(str.DigitValue(48), 0)     // '0'
    testing.AssertEqInt(str.DigitValue(1776), 0)   // '۰'
    testing.AssertEqInt(str.DigitValue(1785), 9)   // '۹'
    testing.AssertEqInt(str.DigitValue(1632), 0)   // '٠'
    testing.AssertEqInt(str.DigitValue(1641), 9)   // '٩'
    testing.AssertEqInt(str.DigitValue(65), 0 - 1) // 'A' is not a digit
end

func test_predicates():
    testing.AssertTrue(str.IsAnyDigit(48))
    testing.AssertTrue(str.IsAnyDigit(1776))
    testing.AssertTrue(str.IsPersianDigit(1776))
    testing.AssertFalse(str.IsPersianDigit(48))
    testing.AssertTrue(str.IsArabicDigit(1632))
    testing.AssertFalse(str.IsArabicDigit(1776))
    testing.AssertFalse(str.IsAnyDigit(65))
end

// Has*Digits looks for a digit of exactly that script, so a string full
// of some other script's digits (or none at all) must not match.
func test_has_digits():
    testing.AssertTrue(str.HasEnglishDigits("abc123"))
    testing.AssertFalse(str.HasEnglishDigits("abc"))
    testing.AssertFalse(str.HasEnglishDigits(""))

    testing.AssertTrue(str.HasPersianDigits("سلام ۱۲۳"))
    testing.AssertFalse(str.HasPersianDigits("سلام"))
    testing.AssertFalse(str.HasPersianDigits("42"))
    testing.AssertFalse(str.HasPersianDigits("٤٥٦"))

    testing.AssertTrue(str.HasArabicDigits("مرحبا ٤٥٦"))
    testing.AssertFalse(str.HasArabicDigits("مرحبا"))
    testing.AssertFalse(str.HasArabicDigits("42"))
    testing.AssertFalse(str.HasArabicDigits("۱۲۳"))
end

func main:
    test_to_english()
    test_to_persian()
    test_to_arabic()
    test_digit_value()
    test_predicates()
    test_has_digits()
    testing.Summary()
    ret 0
end
