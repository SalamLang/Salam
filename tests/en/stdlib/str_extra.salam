package main

import str

func main:
    println "byte ranges"
    println str.SubstrIn("hello world", 6, 5), str.SubstrIn("hello world", 0, 5), str.SubstrIn("hello", 2, 0)
    println str.SubstrIn("hello", 1, 0 - 3) == "", str.SubstrIn("abc", 0, 3)
    println str.SubstrIn("سلام", 0, 2) == "س"

    println "substr bounds outside the string"
    println str.SubstrIn("hello", 0 - 3, 3) == "hel", str.SubstrIn("hello", 10, 5) == ""
    println str.SubstrIn("hello", 2, 100) == "llo", str.SubstrIn("hello", 0 - 3, 100) == "hello"
    println str.Substr("hello", 0 - 3, 3) == "hel", str.Substr("hello", 10, 5) == ""
    println str.Substr("hello", 2, 100) == "llo", str.Substr("hello", 0 - 3, 100) == "hello"

    println "ascii classes"
    println str.IsAsciiLower(97), str.IsAsciiLower(122), str.IsAsciiLower(65), str.IsAsciiLower(48)
    println str.IsAsciiUpper(65), str.IsAsciiUpper(90), str.IsAsciiUpper(97), str.IsAsciiUpper(64)
    println str.IsAsciiAlnum(97), str.IsAsciiAlnum(65), str.IsAsciiAlnum(55), str.IsAsciiAlnum(45), str.IsAsciiAlnum(1587)
    println str.IsAsciiSpace(32), str.IsAsciiSpace(9), str.IsAsciiSpace(10), str.IsAsciiSpace(13), str.IsAsciiSpace(14), str.IsAsciiSpace(160)

    println "control characters"
    println str.IsControl(0), str.IsControl(10), str.IsControl(31), str.IsControl(127), str.IsControl(133)
    println str.IsControl(32), str.IsControl(65), str.IsControl(1587)

    println "utf8 lengths from the lead byte"
    println str.CharLen(65), str.CharLen(127), str.CharLen(192), str.CharLen(216), str.CharLen(224), str.CharLen(226), str.CharLen(240), str.CharLen(244)

    println "compatibility decomposition"
    println str.NFKD("abc") == "abc"
    println str.NFKD("ﬁ") == "fi"
    println str.NFKD("①") == "1"
    println str.NFKD("Ａ") == "A"
    println str.NFKD("é") == "é"
    println str.NFKD("x²") == "x2"
    println str.NFKD("") == ""
end
