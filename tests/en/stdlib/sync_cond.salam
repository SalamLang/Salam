package main

import sync
import thread

mut mu := sync.Mutex {}
mut cv := sync.CondVar {}
mut ready := false
mut seen := false

func waiter():
    sync.Lock(mu)
    until not ready:
        sync.WaitCond(cv, mu)
    end
    seen = true
    sync.Unlock(mu)
end

func main:
    sem := sync.NewSemaphore(2 as i64)
    println "first: ", sync.TryAcquire(sem)
    println "second: ", sync.TryAcquire(sem)
    println "empty: ", sync.TryAcquire(sem)
    sync.Release(sem)
    println "after release: ", sync.TryAcquire(sem)
    println "drained again: ", sync.TryAcquire(sem)
    sync.DestroySemaphore(sem)

    mu = sync.NewMutex()
    cv = sync.NewCondVar()

    sync.Lock(mu)
    timed_out := sync.WaitCondTimeout(cv, mu, 20 as i64)
    sync.Unlock(mu)
    println "timeout wake: ", timed_out

    t := thread.New(spawn(waiter))
    sync.Lock(mu)
    ready = true
    sync.Signal(cv)
    sync.Unlock(mu)
    thread.Join(t)
    println "waiter saw signal: ", seen

    sync.DestroyCondVar(cv)
    sync.Destroy(mu)
end
