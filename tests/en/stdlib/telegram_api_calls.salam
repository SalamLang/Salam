package main

import telegram.bot
import net.http
import net.router
import encoding.json
import str

mut PORT := 0
mut last_path := ""
mut last_query := ""
mut hits := 0

func handle(h: i64):
    ctx := http.Ctx(h)
    path := http.Path(ctx)
    query := http.RawQuery(ctx)
    last_path = path.Substr(0, path.Len())
    last_query = query.Substr(0, query.Len())
    hits++
    mut body := `{"ok":true,"result":"done"}`
    if last_path.EndsWith("/getUpdates"):
        body = `{"ok":true,"result":[{"update_id":5,"message":{"message_id":1,"text":"hi","chat":{"id":9,"type":"private"}}},{"update_id":6}]}`
    else last_path.EndsWith("/getFile"):
        body = `{"ok":true,"result":{"file_id":"F1","file_path":"photos/a.jpg"}}`
    else last_path.EndsWith("/getChat"):
        body = `{"ok":true,"result":{"id":-100,"type":"supergroup","title":"Dev"}}`
    else last_path.EndsWith("/getChatMember"):
        body = `{"ok":true,"result":{"status":"member","user":{"id":7}}}`
    end
    http.Json(ctx, body)
end

func q(key: str): str:
    mut found := ""
    parts := last_query.Split("&")
    repeat parts.Len() in i:
        kv := parts.Get(i)
        if kv.StartsWith(key + "="): found = kv.Substr(key.Len() + 1, kv.Len() - key.Len() - 1) end
    end
    ret found
end

func show(name: str, r: bot.ApiResponse):
    println name, bot.Ok(r), r.http_status, r.result.Len() > 0
    println "  path", last_path
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/*", handle)
    mut s := http.NewServer(0)
    http.Use(s, r)
    PORT = http.RunBackgroundPort(s)

    robot := bot.NewBot("123:ABC")
    bot.SetAPIBase("http://127.0.0.1:" + PORT + "/")
    chat := 42 as i64

    mut x := bot.GetUpdates(robot, 10, 5, 3)
    show("GetUpdates", x)
    println q("offset"), q("limit"), q("timeout")
    ups := bot.ParseUpdates(x.result)
    println ups.Len(), ups.Get(0).update_id, ups.Get(0).message.text, ups.Get(1).update_id

    x = bot.GetChat(robot, chat)
    show("GetChat", x)
    println q("chat_id"), json.Get(x.result, "title")

    x = bot.GetChatMember(robot, chat, 7)
    show("GetChatMember", x)
    println q("chat_id"), q("user_id"), json.Get(x.result, "status")

    x = bot.GetFile(robot, "AgAC")
    show("GetFile", x)
    println q("file_id")
    fp := json.Get(x.result, "file_path")
    println fp
    println str.Replace(bot.FileURL(robot, fp), ":" + PORT + "/", ":PORT/")

    x = bot.LeaveChat(robot, -100)
    show("LeaveChat", x)
    println q("chat_id")

    x = bot.SetWebhook(robot, "https://example.com/hook")
    show("SetWebhook", x)
    println q("url").Len() > 0, last_query.Includes("example.com")

    x = bot.DeleteMessage(robot, chat, 10)
    show("DeleteMessage", x)
    println q("chat_id"), q("message_id")

    x = bot.ForwardMessage(robot, chat, 43, 11)
    show("ForwardMessage", x)
    println q("chat_id"), q("from_chat_id"), q("message_id")

    x = bot.UnpinChatMessage(robot, chat, 10)
    show("UnpinChatMessage", x)
    println q("chat_id"), q("message_id")

    x = bot.AnswerInlineQuery(robot, "iq1", "[]")
    show("AnswerInlineQuery", x)
    println q("inline_query_id"), last_query.Includes("results=")

    x = bot.SendPhoto(robot, chat, "FILE1", "cap")
    show("SendPhoto", x)
    println q("chat_id"), q("photo"), q("caption")

    x = bot.SendDocument(robot, chat, "FILE2", "")
    show("SendDocument", x)
    println q("document"), q("caption").Len()

    x = bot.SendVideo(robot, chat, "FILE3", "")
    show("SendVideo", x)
    println q("video")

    x = bot.SendAudio(robot, chat, "FILE4", "")
    show("SendAudio", x)
    println q("audio")

    x = bot.SendVoice(robot, chat, "FILE5", "")
    show("SendVoice", x)
    println q("voice")

    x = bot.SendSticker(robot, chat, "FILE6")
    show("SendSticker", x)
    println q("chat_id"), q("sticker")

    x = bot.SendLocation(robot, chat, 35.5, 51.25)
    show("SendLocation", x)
    println q("latitude"), q("longitude")

    x = bot.SendContact(robot, chat, "+98912", "Ali")
    show("SendContact", x)
    println q("first_name"), last_query.Includes("phone_number=")

    println hits
end
