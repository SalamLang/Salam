package main

// std/tensor: the core type, its constructors and its accessors.

import matrix
import tensor
import testing

func main:
    eps := 0.000001

    // Zeros2 and the basic geometry
    mut z := tensor.Zeros2(2, 3)
    testing.AssertEqInt(z.rank(), 2)
    testing.AssertEqInt(z.dim(0), 2)
    testing.AssertEqInt(z.dim(1), 3)
    testing.AssertEqInt(z.numel(), 6)
    testing.AssertEqFloat(z.at(5), 0.0, eps)
    testing.AssertFalse(z.is_empty())

    // Ones / Full over an explicit shape vector
    mut s3 := tensor.Shape3(2, 2, 2)
    mut o := tensor.Ones(s3)
    testing.AssertEqInt(o.rank(), 3)
    testing.AssertEqInt(o.numel(), 8)
    testing.AssertEqFloat(o.at(7), 1.0, eps)
    mut f := tensor.Full(s3, 7.5)
    testing.AssertEqFloat(f.at(3), 7.5, eps)
    s3.free()

    // Scalar is a shape-[1] tensor, never rank 0
    mut sc := tensor.Scalar(4.25)
    testing.AssertEqInt(sc.rank(), 1)
    testing.AssertEqInt(sc.numel(), 1)
    testing.AssertEqFloat(sc.at(0), 4.25, eps)

    // Empty is the error sentinel
    testing.AssertTrue(tensor.Empty().is_empty())

    // Arange, flat accessors, add_at
    mut ar := tensor.Arange(5)
    testing.AssertEqFloat(ar.at(0), 0.0, eps)
    testing.AssertEqFloat(ar.at(4), 4.0, eps)
    ar.set_at(1, 9.5)
    testing.AssertEqFloat(ar.at(1), 9.5, eps)
    ar.add_at(1, 0.5)
    testing.AssertEqFloat(ar.at(1), 10.0, eps)

    // Rank-2 accessors
    mut m := tensor.Zeros2(2, 3)
    m.set_at2(1, 2, 6.5)
    testing.AssertEqFloat(m.at2(1, 2), 6.5, eps)
    testing.AssertEqFloat(m.at(5), 6.5, eps)

    // FromArray copies, and rejects a length mismatch
    mut buf := Vector {} as Vector<f32>
    buf.push(1.0 as f32)
    buf.push(2.0 as f32)
    buf.push(3.0 as f32)
    buf.push(4.0 as f32)
    mut s22 := tensor.Shape2(2, 2)
    mut fa := tensor.FromArray(s22, buf)
    testing.AssertEqFloat(fa.at2(1, 0), 3.0, eps)
    mut s31 := tensor.Shape2(3, 1)
    testing.AssertTrue(tensor.FromArray(s31, buf).is_empty())
    s31.free()
    buf.free()

    // Clone is a deep copy, CopyInto reuses the destination
    mut cp := tensor.Clone(fa)
    fa.set_at(0, 99.0)
    testing.AssertEqFloat(cp.at(0), 1.0, eps)
    tensor.CopyInto(cp, fa)
    testing.AssertEqFloat(cp.at(0), 99.0, eps)

    // SetAll
    tensor.SetAll(cp, 2.5)
    testing.AssertEqFloat(cp.at(3), 2.5, eps)

    // same_shape and SameShape
    testing.AssertTrue(fa.same_shape(cp))
    testing.AssertFalse(fa.same_shape(z))
    testing.AssertTrue(tensor.SameShape(fa, cp))

    // reshape_ keeps the buffer, refuses a bad count
    mut s41 := tensor.Shape2(4, 1)
    testing.AssertTrue(fa.reshape_(s41))
    testing.AssertEqInt(fa.dim(0), 4)
    testing.AssertEqInt(fa.dim(1), 1)
    mut s5 := tensor.Shape1(5)
    testing.AssertFalse(fa.reshape_(s5))
    testing.AssertEqInt(fa.rank(), 2)
    s41.free()
    s5.free()

    // ShapeString
    testing.AssertEqStr(tensor.ShapeString(z), "2x3")
    testing.AssertEqStr(tensor.ShapeString(tensor.Empty()), "empty")

    // The f64 bridge, both directions
    mut mm := tensor.ToMatrix(m)
    testing.AssertEqInt(mm.rows, 2)
    testing.AssertEqInt(mm.cols, 3)
    testing.AssertEqFloat(mm.at(1, 2), 6.5, eps)
    mut back := tensor.FromMatrix(mm)
    testing.AssertTrue(back.same_shape(m))
    testing.AssertEqFloat(back.at2(1, 2), 6.5, eps)
    mut rv := tensor.Arange(3)
    mut rm := tensor.ToMatrix(rv)
    testing.AssertEqInt(rm.rows, 1)
    testing.AssertEqInt(rm.cols, 3)
    testing.AssertEqFloat(rm.at(0, 2), 2.0, eps)
    matrix.Free(mm)
    matrix.Free(rm)

    // The advertised tolerance
    testing.AssertTrue(tensor.TSR_TOL > 0.0)

    tensor.Free(z)
    tensor.Free(o)
    tensor.Free(f)
    tensor.Free(sc)
    tensor.Free(ar)
    tensor.Free(m)
    s22.free()
    tensor.Free(fa)
    tensor.Free(cp)
    tensor.Free(back)
    tensor.Free(rv)

    ret testing.Summary()
end
