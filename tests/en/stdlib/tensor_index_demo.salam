package main

import ai.tensor
import testing

func main:
    mut col := tensor.Arange(3)
    mut s31 := tensor.Shape2(3, 1)
    testing.AssertTrue(col.Reshape(s31))
    s31.Free()
    mut row := tensor.Arange(4)
    mut s14 := tensor.Shape2(1, 4)
    testing.AssertTrue(row.Reshape(s14))
    s14.Free()
    mut bs := Vector {} as Vector<int>
    testing.AssertTrue(tensor.BroadcastShape(col, row, bs))
    testing.AssertEqInt(bs.Len(), 2)
    testing.AssertEqInt(bs.Get(0), 3)
    testing.AssertEqInt(bs.Get(1), 4)
    mut ec := tensor.Expand(col, bs)
    mut er := tensor.Expand(row, bs)
    testing.AssertEqFloat(ec.At2(2, 3), 2.0, 0.0)
    testing.AssertEqFloat(ec.At2(1, 0), 1.0, 0.0)
    testing.AssertEqFloat(er.At2(2, 3), 3.0, 0.0)
    testing.AssertEqFloat(er.At2(0, 1), 1.0, 0.0)
    mut flat := tensor.Arange(4)
    mut ef := tensor.Expand(flat, bs)
    testing.AssertTrue(tensor.Equal(ef, er))
    ef.Free()
    mut bad := tensor.Arange(5)
    mut bs2 := Vector {} as Vector<int>
    testing.AssertTrue(not tensor.BroadcastShape(bad, row, bs2))
    mut ebad := tensor.Expand(bad, bs)
    testing.AssertTrue(ebad.IsEmpty())
    bs2.Free()
    bad.Free()

    mut gt_at := tensor.Greater(col, row)
    testing.AssertEqInt(gt_at.Dim(0), 3)
    testing.AssertEqInt(gt_at.Dim(1), 4)
    testing.AssertEqFloat(tensor.SumAll(gt_at), 3.0, 0.0)
    testing.AssertEqFloat(gt_at.At2(2, 1), 1.0, 0.0)
    testing.AssertEqFloat(gt_at.At2(1, 1), 0.0, 0.0)
    mut ge := tensor.GreaterEqual(col, row)
    testing.AssertEqFloat(tensor.SumAll(ge), 6.0, 0.0)
    mut eq_mask := tensor.EqualMask(col, row)
    testing.AssertEqFloat(tensor.SumAll(eq_mask), 3.0, 0.0)
    mut ne := tensor.NotEqualMask(col, row)
    testing.AssertEqFloat(tensor.SumAll(ne), 9.0, 0.0)
    mut lt_at := tensor.Less(col, row)
    mut le := tensor.LessEqual(col, row)
    testing.AssertEqFloat(tensor.SumAll(lt_at), 6.0, 0.0)
    testing.AssertEqFloat(tensor.SumAll(le), 9.0, 0.0)
    mut gs := tensor.GreaterScalar(flat, 1.5)
    testing.AssertEqFloat(tensor.SumAll(gs), 2.0, 0.0)
    mut ls := tensor.LessScalar(flat, 1.5)
    testing.AssertEqFloat(tensor.SumAll(ls), 2.0, 0.0)
    mut es := tensor.EqualScalar(flat, 3.0)
    testing.AssertEqFloat(es.At(3), 1.0, 0.0)
    testing.AssertEqFloat(tensor.SumAll(es), 1.0, 0.0)

    mut zero := tensor.Scalar(0.0)
    mut w := tensor.Where(gt_at, ec, zero)
    testing.AssertEqInt(w.Dim(0), 3)
    testing.AssertEqFloat(w.At2(2, 0), 2.0, 0.0)
    testing.AssertEqFloat(w.At2(0, 3), 0.0, 0.0)
    testing.AssertEqFloat(tensor.SumAll(w), 5.0, 0.0)
    mut mf := tensor.MaskedFill(er, gs, 0.0 - 1.0)
    testing.AssertEqFloat(mf.At2(1, 3), 0.0 - 1.0, 0.0)
    testing.AssertEqFloat(mf.At2(1, 1), 1.0, 0.0)

    mut m := tensor.Arange(12)
    mut s34 := tensor.Shape2(3, 4)
    testing.AssertTrue(m.Reshape(s34))
    s34.Free()
    mut ids := Vector {} as Vector<int>
    ids.Push(2)
    ids.Push(0)
    ids.Push(2)
    mut rows := tensor.TakeRows(m, ids)
    testing.AssertEqInt(rows.Dim(0), 3)
    testing.AssertEqFloat(rows.At2(0, 1), 9.0, 0.0)
    testing.AssertEqFloat(rows.At2(1, 3), 3.0, 0.0)
    mut cols := tensor.IndexSelect(m, 1, ids)
    testing.AssertEqInt(cols.Dim(1), 3)
    testing.AssertEqFloat(cols.At2(1, 0), 6.0, 0.0)
    testing.AssertEqFloat(cols.At2(2, 1), 8.0, 0.0)
    ids.Push(9)
    mut oob := tensor.TakeRows(m, ids)
    testing.AssertTrue(oob.IsEmpty())
    ids.Free()

    mut idx := tensor.Zeros2(3, 2)
    idx.SetAt2(0, 0, 3.0)
    idx.SetAt2(0, 1, 0.0)
    idx.SetAt2(1, 0, 1.0)
    idx.SetAt2(1, 1, 1.0)
    idx.SetAt2(2, 0, 2.0)
    idx.SetAt2(2, 1, 3.0)
    mut g := tensor.Gather(m, 1, idx)
    testing.AssertEqInt(g.Dim(1), 2)
    testing.AssertEqFloat(g.At2(0, 0), 3.0, 0.0)
    testing.AssertEqFloat(g.At2(1, 1), 5.0, 0.0)
    testing.AssertEqFloat(g.At2(2, 1), 11.0, 0.0)
    mut idx0 := tensor.Zeros2(1, 4)
    idx0.SetAt2(0, 0, 2.0)
    idx0.SetAt2(0, 3, 1.0)
    mut g0 := tensor.Gather(m, 0, idx0)
    testing.AssertEqFloat(g0.At2(0, 0), 8.0, 0.0)
    testing.AssertEqFloat(g0.At2(0, 1), 1.0, 0.0)
    testing.AssertEqFloat(g0.At2(0, 3), 7.0, 0.0)

    mut dst := tensor.Zeros2(3, 4)
    mut sids := Vector {} as Vector<int>
    sids.Push(1)
    sids.Push(1)
    sids.Push(0)
    testing.AssertTrue(tensor.ScatterAddRows(dst, sids, rows))
    testing.AssertEqFloat(dst.At2(1, 1), 10.0, 0.0)
    testing.AssertEqFloat(dst.At2(0, 0), 8.0, 0.0)
    testing.AssertEqFloat(dst.At2(2, 0), 0.0, 0.0)
    mut oh := tensor.OneHot(sids, 3)
    testing.AssertEqInt(oh.Dim(0), 3)
    testing.AssertEqFloat(oh.At2(0, 1), 1.0, 0.0)
    testing.AssertEqFloat(oh.At2(2, 0), 1.0, 0.0)
    testing.AssertEqFloat(tensor.SumAll(oh), 3.0, 0.0)
    sids.Free()

    mut scores := tensor.Zeros2(2, 5)
    vals := [0.1, 0.9, 0.4, 0.7, 0.2, 5.0, 1.0, 3.0, 4.0, 2.0]
    repeat 10 in k: scores.SetAt(k, vals[k]) end
    mut tidx := tensor.Empty()
    mut tk := tensor.TopK(scores, 3, true, tidx)
    testing.AssertEqInt(tk.Dim(0), 2)
    testing.AssertEqInt(tk.Dim(1), 3)
    testing.AssertEqFloat(tk.At2(0, 0), 0.9, 0.000001)
    testing.AssertEqFloat(tk.At2(0, 1), 0.7, 0.000001)
    testing.AssertEqFloat(tk.At2(0, 2), 0.4, 0.000001)
    testing.AssertEqFloat(tidx.At2(0, 0), 1.0, 0.0)
    testing.AssertEqFloat(tidx.At2(0, 1), 3.0, 0.0)
    testing.AssertEqFloat(tk.At2(1, 0), 5.0, 0.0)
    testing.AssertEqFloat(tidx.At2(1, 0), 0.0, 0.0)
    mut bidx := tensor.Empty()
    mut bk := tensor.TopK(scores, 2, false, bidx)
    testing.AssertEqFloat(bk.At2(0, 0), 0.1, 0.000001)
    testing.AssertEqFloat(bk.At2(0, 1), 0.2, 0.000001)
    testing.AssertEqFloat(bidx.At2(1, 0), 1.0, 0.0)
    mut nidx := tensor.Empty()
    mut none_k := tensor.TopK(scores, 9, true, nidx)
    testing.AssertTrue(none_k.IsEmpty())

    mut ones := tensor.Zeros2(3, 3)
    tensor.SetAll(ones, 1.0)
    mut lo := tensor.Tril(ones, 0)
    testing.AssertEqFloat(tensor.SumAll(lo), 6.0, 0.0)
    testing.AssertEqFloat(lo.At2(0, 1), 0.0, 0.0)
    testing.AssertEqFloat(lo.At2(2, 0), 1.0, 0.0)
    mut up := tensor.Triu(ones, 1)
    testing.AssertEqFloat(tensor.SumAll(up), 3.0, 0.0)
    testing.AssertEqFloat(up.At2(0, 1), 1.0, 0.0)
    testing.AssertEqFloat(up.At2(1, 1), 0.0, 0.0)
    mut flat_tri := tensor.Tril(flat, 0)
    testing.AssertTrue(flat_tri.IsEmpty())

    mut cs := tensor.Cumsum(m, 1)
    testing.AssertEqFloat(cs.At2(0, 3), 0.0 + 1.0 + 2.0 + 3.0, 0.0)
    testing.AssertEqFloat(cs.At2(2, 0), 8.0, 0.0)
    mut cs0 := tensor.Cumsum(m, 0)
    testing.AssertEqFloat(cs0.At2(2, 1), 1.0 + 5.0 + 9.0, 0.0)
    testing.AssertTrue(tensor.Cumsum(m, 5).IsEmpty())

    scores.Free()
    tidx.Free()
    tk.Free()
    bidx.Free()
    bk.Free()
    nidx.Free()
    ones.Free()
    lo.Free()
    up.Free()
    cs.Free()
    cs0.Free()
    col.Free()
    row.Free()
    flat.Free()
    bs.Free()
    ec.Free()
    er.Free()
    gt_at.Free()
    ge.Free()
    eq_mask.Free()
    ne.Free()
    lt_at.Free()
    le.Free()
    gs.Free()
    ls.Free()
    es.Free()
    zero.Free()
    w.Free()
    mf.Free()
    m.Free()
    rows.Free()
    cols.Free()
    idx.Free()
    g.Free()
    idx0.Free()
    g0.Free()
    dst.Free()
    oh.Free()
    ret testing.Summary()
end
