package main

// std/tensor: seeded random fills.

import matrix
import tensor
import testing

// matrix.NewRng's first draw, so the two generators are compared against
// each other rather than against a hard-coded constant.
func matrix_first(seed: i64): f64:
    mut g := matrix.NewRng(seed)
    ret g.next_float()
end

func main:
    mut s := tensor.Shape2(50, 40)

    // Uniform: bounds respected, seed reproducible, mean near center
    mut u1 := tensor.RandUniform(s, 2.0, 3.0, 42)
    testing.AssertTrue(tensor.MinAll(u1) >= 2.0)
    testing.AssertTrue(tensor.MaxAll(u1) < 3.0)
    testing.AssertTrue(tensor.MeanAll(u1) > 2.4)
    testing.AssertTrue(tensor.MeanAll(u1) < 2.6)
    mut u2 := tensor.RandUniform(s, 2.0, 3.0, 42)
    testing.AssertTrue(tensor.Equal(u1, u2))
    mut u3 := tensor.RandUniform(s, 2.0, 3.0, 43)
    testing.AssertFalse(tensor.Equal(u1, u3))

    // The stream matches std/matrix's generator for the same seed
    mut g := tensor.NewRng(7)
    mg := matrix_first(7)
    testing.AssertEqFloat(g.next_float(), mg, 0.000000000001)

    // Normal: roughly centered, roughly unit spread
    mut nrm := tensor.RandNormal(s, 11)
    m := tensor.MeanAll(nrm)
    testing.AssertTrue(m > 0.0 - 0.1)
    testing.AssertTrue(m < 0.1)
    mut sq := tensor.Square(nrm)
    varr := tensor.MeanAll(sq)
    testing.AssertTrue(varr > 0.8)
    testing.AssertTrue(varr < 1.2)

    // Scaled fill through a threaded generator
    mut t := tensor.Zeros2(10, 10)
    mut g2 := tensor.NewRng(5)
    tensor.FillNormal(t, 100.0, 0.5, g2)
    tm := tensor.MeanAll(t)
    testing.AssertTrue(tm > 99.0)
    testing.AssertTrue(tm < 101.0)

    // Bernoulli: only zeros and ones, frequency near p
    mut mask := tensor.Zeros2(60, 50)
    mut g3 := tensor.NewRng(9)
    tensor.FillBernoulli(mask, 0.25, g3)
    mut only01 := true
    repeat mask.numel() with k:
        v := mask.at(k)
        if v != 0.0 && v != 1.0: only01 = false end
    end
    testing.AssertTrue(only01)
    frac := tensor.MeanAll(mask)
    testing.AssertTrue(frac > 0.2)
    testing.AssertTrue(frac < 0.3)

    // Derived seeds differ from the base and from each other
    testing.AssertTrue(tensor.DeriveSeed(1, 0) != tensor.DeriveSeed(1, 1))
    testing.AssertTrue(tensor.DeriveSeed(1, 0) != 1)

    s.free()
    tensor.Free(u1)
    tensor.Free(u2)
    tensor.Free(u3)
    tensor.Free(nrm)
    tensor.Free(sq)
    tensor.Free(t)
    tensor.Free(mask)

    ret testing.Summary()
end
