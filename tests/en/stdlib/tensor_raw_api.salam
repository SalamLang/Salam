package main

import math
import str
import tensor

func fill2(a: f64, b: f64, c: f64, d: f64): tensor.Tensor:
    mut t := tensor.Zeros2(2, 2)
    t.set_at2(0, 0, a)
    t.set_at2(0, 1, b)
    t.set_at2(1, 0, c)
    t.set_at2(1, 1, d)
    ret t
end

func row(t: tensor.Tensor, r: int): str:
    ret str.FromFloat(t.at2(r, 0)) + " " + str.FromFloat(t.at2(r, 1))
end

func main:
    mut x := fill2(8.0, 6.0, 4.0, 2.0)
    mut y := fill2(2.0, 3.0, 4.0, 1.0)
    mut out := tensor.Zeros2(2, 2)
    println "sub into: ", tensor.SubInto(x, y, out)
    println "sub row 0: ", row(out, 0)
    println "sub row 1: ", row(out, 1)
    println "div into: ", tensor.DivInto(x, y, out)
    println "div row 0: ", row(out, 0)
    println "div row 1: ", row(out, 1)
    mut wide := tensor.Zeros2(2, 3)
    println "sub shape mismatch: ", tensor.SubInto(x, wide, out)
    println "div shape mismatch: ", tensor.DivInto(x, y, wide)
    println "out untouched on mismatch: ", out.at2(0, 0)

    mut a := tensor.Zeros2(2, 3)
    mut b := tensor.Zeros2(3, 2)
    repeat 6 in k:
        a.data.data[k] = (k + 1) as f32
        b.data.data[k] = (6 - k) as f32
    end
    mut c := tensor.Zeros2(2, 2)
    tensor.GemmAcc(a.data.data, b.data.data, c.data.data, 2, 3, 2)
    println "gemm row 0: ", row(c, 0)
    println "gemm row 1: ", row(c, 1)
    tensor.GemmAcc(a.data.data, b.data.data, c.data.data, 2, 3, 2)
    println "gemm accumulated: ", row(c, 0), row(c, 1)
    mut want := tensor.MatMul(a, b)
    println "gemm matches matmul: ", want.at2(0, 0) * 2.0 == c.at2(0, 0) and want.at2(1, 1) * 2.0 == c.at2(1, 1)

    mut t := tensor.TransposeRaw(a.data.data, 2, 3)
    println "transpose shape: ", t.shape.get(0), t.shape.get(1)
    println "transpose values: ", t.at2(0, 0), t.at2(0, 1), t.at2(2, 0), t.at2(2, 1)

    mut g := tensor.NewRng(3)
    mut u := tensor.Zeros2(30, 30)
    tensor.FillUniform(u, 2.0, 5.0, g)
    println "uniform range: ", tensor.MinAll(u) >= 2.0 and tensor.MaxAll(u) < 5.0
    println "uniform spread: ", tensor.MaxAll(u) - tensor.MinAll(u) > 2.5
    println "uniform mean: ", math.Abs(tensor.MeanAll(u) - 3.5) < 0.2
    mut g2 := tensor.NewRng(3)
    mut u2 := tensor.Zeros2(30, 30)
    tensor.FillUniform(u2, 2.0, 5.0, g2)
    println "reproducible: ", tensor.SumAll(u) == tensor.SumAll(u2)
    mut point := tensor.Zeros2(3, 3)
    tensor.FillUniform(point, 1.5, 1.5, g)
    println "degenerate range: ", tensor.MinAll(point), tensor.MaxAll(point)

    tensor.Free(point)
    tensor.Free(u2)
    tensor.Free(u)
    tensor.Free(t)
    tensor.Free(want)
    tensor.Free(c)
    tensor.Free(b)
    tensor.Free(a)
    tensor.Free(wide)
    tensor.Free(out)
    tensor.Free(y)
    tensor.Free(x)
end
