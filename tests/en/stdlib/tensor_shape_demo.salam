package main

// std/tensor: reshape, squeeze, permute, slicing, concat, stack, pad.

import tensor
import testing

func iota(t &: tensor.Tensor):
    repeat t.numel() with k: t.set_at(k, k as f64) end
end

func main:
    eps := 0.000001

    // Reshape copies; reshape_ was covered in tensor_demo
    mut a := tensor.Zeros2(2, 6)
    iota(a)
    mut s34 := tensor.Shape2(3, 4)
    mut r := tensor.Reshape(a, s34)
    testing.AssertEqInt(r.dim(0), 3)
    testing.AssertEqFloat(r.at2(1, 0), 4.0, eps)
    a.set_at(0, 50.0)
    testing.AssertEqFloat(r.at(0), 0.0, eps)
    mut s5 := tensor.Shape1(5)
    testing.AssertTrue(tensor.Reshape(a, s5).is_empty())
    s5.free()
    s34.free()

    // Squeeze / Unsqueeze in place
    mut sq := tensor.Zeros3(1, 3, 1)
    tensor.SqueezeInPlace(sq)
    testing.AssertEqInt(sq.rank(), 1)
    testing.AssertEqInt(sq.dim(0), 3)
    tensor.UnsqueezeInPlace(sq, 0)
    testing.AssertEqInt(sq.rank(), 2)
    testing.AssertEqInt(sq.dim(0), 1)
    mut ones := tensor.Zeros2(1, 1)
    tensor.SqueezeInPlace(ones)
    testing.AssertEqInt(ones.rank(), 1)

    // Permute as a 2D transpose
    mut m := tensor.Zeros2(2, 3)
    iota(m)                                  // 0 1 2 / 3 4 5
    mut perm := Vector {} as Vector<int>
    perm.push(1)
    perm.push(0)
    mut mt := tensor.Permute(m, perm)
    testing.AssertEqInt(mt.dim(0), 3)
    testing.AssertEqInt(mt.dim(1), 2)
    testing.AssertEqFloat(mt.at2(0, 1), 3.0, eps)
    testing.AssertEqFloat(mt.at2(2, 0), 2.0, eps)
    perm.free()

    // Permute on rank 3, and a bad permutation is refused
    mut c := tensor.Zeros3(2, 3, 4)
    iota(c)
    mut p3 := Vector {} as Vector<int>
    p3.push(2)
    p3.push(0)
    p3.push(1)
    mut ct := tensor.Permute(c, p3)          // [4,2,3]
    testing.AssertEqInt(ct.dim(0), 4)
    testing.AssertEqInt(ct.dim(1), 2)
    testing.AssertEqInt(ct.dim(2), 3)
    // ct[i,j,k] = c[j,k,i]: spot check c[1,2,3] = 23 at ct[3,1,2]
    testing.AssertEqFloat(ct.at(3 * 6 + 1 * 3 + 2), 23.0, eps)
    p3.set(0, 0)
    p3.set(1, 0)
    p3.set(2, 1)
    testing.AssertTrue(tensor.Permute(c, p3).is_empty())
    p3.free()

    // SliceAxis0 and Narrow
    mut sl := tensor.SliceAxis0(m, 1, 1)     // row 1 of 2x3
    testing.AssertEqInt(sl.dim(0), 1)
    testing.AssertEqFloat(sl.at(0), 3.0, eps)
    testing.AssertTrue(tensor.SliceAxis0(m, 2, 1).is_empty())
    mut nw := tensor.Narrow(m, 1, 1, 2)      // cols 1..2
    testing.AssertEqInt(nw.dim(1), 2)
    testing.AssertEqFloat(nw.at2(0, 0), 1.0, eps)
    testing.AssertEqFloat(nw.at2(1, 1), 5.0, eps)

    // Concat along both axes
    mut cat0 := tensor.Concat2(m, m, 0)      // 4x3
    testing.AssertEqInt(cat0.dim(0), 4)
    testing.AssertEqFloat(cat0.at2(2, 0), 0.0, eps)
    mut cat1 := tensor.Concat2(m, m, 1)      // 2x6
    testing.AssertEqInt(cat1.dim(1), 6)
    testing.AssertEqFloat(cat1.at2(1, 3), 3.0, eps)
    mut tall := tensor.Zeros2(3, 2)
    testing.AssertTrue(tensor.Concat2(m, tall, 0).is_empty())

    // Stack2 adds a leading axis
    mut st := tensor.Stack2(m, mt)           // shapes differ -> empty
    testing.AssertTrue(st.is_empty())
    mut st2 := tensor.Stack2(m, m)
    testing.AssertEqInt(st2.rank(), 3)
    testing.AssertEqInt(st2.dim(0), 2)
    testing.AssertEqFloat(st2.at(6 + 4), 4.0, eps)

    // Pad2D puts zeros around the last two dims
    mut pd := tensor.Pad2D(m, 1, 0, 2, 1)    // 2x3 -> 3x6
    testing.AssertEqInt(pd.dim(0), 3)
    testing.AssertEqInt(pd.dim(1), 6)
    testing.AssertEqFloat(pd.at2(0, 2), 0.0, eps)
    testing.AssertEqFloat(pd.at2(1, 2), 0.0, eps)
    testing.AssertEqFloat(pd.at2(1, 3), 1.0, eps)
    testing.AssertEqFloat(pd.at2(2, 4), 5.0, eps)

    tensor.Free(a)
    tensor.Free(r)
    tensor.Free(sq)
    tensor.Free(ones)
    tensor.Free(m)
    tensor.Free(mt)
    tensor.Free(c)
    tensor.Free(ct)
    tensor.Free(sl)
    tensor.Free(nw)
    tensor.Free(cat0)
    tensor.Free(cat1)
    tensor.Free(tall)
    tensor.Free(st2)
    tensor.Free(pd)

    ret testing.Summary()
end
