package main

import testing

func main:
    testing.Reset()
    println "no filter selects all: ", testing.Selected("test_anything")

    testing.SetFilter("add")
    println "contains: ", testing.Selected("test_add_zero"), testing.Selected("test_sub")
    testing.SetFilter("^test_")
    println "prefix: ", testing.Selected("test_add"), testing.Selected("my_test_add")
    testing.SetFilter("zero$")
    println "suffix: ", testing.Selected("test_add_zero"), testing.Selected("test_zero_add")
    testing.SetFilter("^test_add$")
    println "exact: ", testing.Selected("test_add"), testing.Selected("test_add_zero")
    testing.SetFilter("")
    println "cleared: ", testing.Selected("whatever")

    testing.SetFormat("human")
    testing.SuiteStart("runner.salam")
    testing.Begin("test_pass", 1)
    testing.AssertEqInt(1 + 1, 2)
    testing.End()
    println "failed after pass: ", testing.Failed()

    testing.Begin("test_fail", 2)
    testing.AssertEqInt(1 + 1, 3)
    testing.End()
    println "passed: ", testing.Passed()
    println "failed: ", testing.Failed()

    testing.SetFormat("teamcity")
    testing.SuiteStart("tc.salam")
    testing.Begin("test_tc", 3)
    testing.AssertTrue(true)
    testing.End()
    testing.SetFormat("human")

    testing.Reset()
    println "after reset: ", testing.Passed(), testing.Failed()
end
