package main

import image
import str
import testing
import os

func cps_to_str(cps &: Vector<int>): str:
    mut b := str.NewBuilder()
    mut i := 0
    until i < cps.len():
        cp := cps.get(i)
        if cp < 0x80:
            str.BufAppendChar(b, cp)
        else if cp < 0x800:
            str.BufAppendChar(b, 0xC0 | (cp >> 6))
            str.BufAppendChar(b, 0x80 | (cp & 0x3F))
        else:
            str.BufAppendChar(b, 0xE0 | (cp >> 12))
            str.BufAppendChar(b, 0x80 | ((cp >> 6) & 0x3F))
            str.BufAppendChar(b, 0x80 | (cp & 0x3F))
        end
        i += 1
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

func check_shaping:
    mut e := Vector {} as Vector<int>

    e.push(0xFEB3)
    e.push(0xFEFC)
    e.push(0xFEE1)
    testing.AssertEqStr(image.ShapeArabic("سلام"), cps_to_str(e))
    e.clear()

    e.push(0xFE8D)
    e.push(0xFBFE)
    e.push(0xFEAE)
    e.push(0xFE8D)
    e.push(0xFEE5)
    testing.AssertEqStr(image.ShapeArabic("ایران"), cps_to_str(e))
    e.clear()

    e.push(0xFB58)
    e.push(0xFBFF)
    e.push(0xFEB8)
    e.push(0xFEAE)
    e.push(0xFED3)
    e.push(0xFE96)
    testing.AssertEqStr(image.ShapeArabic("پیشرفت"), cps_to_str(e))
    e.clear()

    e.push(0xFEE9)
    testing.AssertEqStr(image.ShapeArabic("ه"), cps_to_str(e))
    e.clear()

    e.push(0xFEFB)
    testing.AssertEqStr(image.ShapeArabic("لا"), cps_to_str(e))
    e.clear()

    e.push(0xFE91)
    e.push(0x064E)
    e.push(0xFE92)
    e.push(0xFE96)
    testing.AssertEqStr(image.ShapeArabic("بَبت"), cps_to_str(e))
    e.clear()

    testing.AssertEqStr(image.ShapeArabic("Salam 123!"), "Salam 123!")
    testing.AssertEqStr(image.ShapeArabic(""), "")
    testing.AssertEqStr(image.ShapeArabic("héllo Σαλάμ"), "héllo Σαλάμ")

    e.free()
end

func check_direction:
    testing.AssertTrue(image.IsRTLText("سلام"))
    testing.AssertTrue(image.IsRTLText("hello سلام"))
    testing.AssertFalse(image.IsRTLText("hello"))
    testing.AssertFalse(image.IsRTLText("123 456"))
    testing.AssertFalse(image.IsRTLText(""))

    testing.AssertEqInt(image.BaseDirection("سلام hello"), image.TextDirRTL)
    testing.AssertEqInt(image.BaseDirection("hello سلام"), image.TextDirLTR)
    testing.AssertEqInt(image.BaseDirection("123 سلام"), image.TextDirRTL)
    testing.AssertEqInt(image.BaseDirection("123"), image.TextDirLTR)
    testing.AssertEqInt(image.BaseDirection(""), image.TextDirLTR)
end

func check_visual_order:
    mut e := Vector {} as Vector<int>

    e.push(0xFEE1)
    e.push(0xFEFC)
    e.push(0xFEB3)
    testing.AssertEqStr(image.ToVisualOrder("سلام", image.TextDirAuto), cps_to_str(e))
    e.clear()

    e.push(0x61)
    e.push(0x62)
    e.push(0x20)
    e.push(0xFEE1)
    e.push(0xFEFC)
    e.push(0xFEB3)
    testing.AssertEqStr(image.ToVisualOrder("سلام ab", image.TextDirAuto), cps_to_str(e))
    e.clear()

    e.push(0x61)
    e.push(0x62)
    e.push(0x20)
    e.push(0xFEE1)
    e.push(0xFEFC)
    e.push(0xFEB3)
    testing.AssertEqStr(image.ToVisualOrder("سلام ab", image.TextDirRTL), cps_to_str(e))
    e.clear()

    e.push(0x31)
    e.push(0x32)
    e.push(0x33)
    e.push(0x20)
    e.push(0xFEE1)
    e.push(0xFEFC)
    e.push(0xFEB3)
    testing.AssertEqStr(image.ToVisualOrder("سلام 123", image.TextDirAuto), cps_to_str(e))
    e.clear()

    e.push(0x61)
    e.push(0x62)
    e.push(0x20)
    e.push(0xFEE1)
    e.push(0xFEFC)
    e.push(0xFEB3)
    testing.AssertEqStr(image.ToVisualOrder("ab سلام", image.TextDirAuto), cps_to_str(e))
    e.clear()

    e.push(0xFEE1)
    e.push(0xFEFC)
    e.push(0xFEB3)
    e.push(0x20)
    e.push(0x61)
    e.push(0x62)
    testing.AssertEqStr(image.ToVisualOrder("ab سلام", image.TextDirRTL), cps_to_str(e))
    e.clear()

    e.push(0x28)
    e.push(0xFEE1)
    e.push(0xFEFC)
    e.push(0xFEB3)
    e.push(0x29)
    testing.AssertEqStr(image.ToVisualOrder("(سلام)", image.TextDirAuto), cps_to_str(e))
    e.clear()

    e.push(0x06F1)
    e.push(0x06F8)
    e.push(0x3A)
    e.push(0x06F3)
    e.push(0x06F0)
    e.push(0x20)
    e.push(0xFE96)
    e.push(0xFECB)
    e.push(0xFE8E)
    e.push(0xFEB3)
    testing.AssertEqStr(image.ToVisualOrder("ساعت ۱۸:۳۰", image.TextDirAuto), cps_to_str(e))
    e.clear()

    e.push(0x31)
    e.push(0x2C)
    e.push(0x32)
    e.push(0x35)
    e.push(0x30)
    e.push(0x20)
    e.push(0x3A)
    e.push(0xFE96)
    e.push(0xFEE4)
    e.push(0xFBFF)
    e.push(0xFED7)
    testing.AssertEqStr(image.ToVisualOrder("قیمت: 1,250", image.TextDirAuto), cps_to_str(e))
    e.clear()

    e.push(0xFEE1)
    e.push(0xFEFC)
    e.push(0xFEB3)
    testing.AssertEqStr(image.ToVisualOrder("hello (سلام) 42 world", image.TextDirAuto), "hello (" + cps_to_str(e) + ") 42 world")
    e.clear()

    e.push(0x0662)
    e.push(0x0666)
    e.push(0x20)
    e.push(0x0664)
    e.push(0x0663)
    e.push(0x0666)
    testing.AssertEqStr(image.ToVisualOrder("ab ٤٣٦ ٢٦", image.TextDirAuto), "ab " + cps_to_str(e))
    testing.AssertFalse(image.IsRTLText("ab ٤٣٦ ٢٦"))
    e.clear()

    testing.AssertEqStr(image.ToVisualOrder("ab 436 26", image.TextDirAuto), "ab 436 26")

    testing.AssertEqStr(image.ToVisualOrder("Hello, world!", image.TextDirAuto), "Hello, world!")
    testing.AssertEqStr(image.ToVisualOrder("", image.TextDirAuto), "")
    testing.AssertEqStr(image.ToVisualOrder("Straße", image.TextDirLTR), "Straße")

    e.free()
end

func check_with_font:
    path := image.FindArabicFont()
    mut ok := false
    f := image.LoadFont(path, ok)
    testing.AssertTrue(!ok || str.Len(path) > 0)
    testing.AssertTrue(!ok || image.FontValid(f))

    mut st := image.TextStyle {}
    st.size = 32.0
    shaped_w := image.TextWidthStyled(f, "سلام", st)
    mut raw := image.TextStyle {}
    raw.size = 32.0
    raw.shape = false
    raw_w := image.TextWidthStyled(f, "سلام", raw)
    testing.AssertTrue(!ok || shaped_w > 0.0)
    testing.AssertTrue(!ok || raw_w > 0.0)
    testing.AssertTrue(!ok || shaped_w < raw_w)

    mut img := image.NewFilled(360, 90, image.RGB(255, 255, 255))
    image.DrawTextStyled(img, 10.0, 60.0, "سلام ایران ۱۴۰۴", image.RGB(0, 0, 0), f, st)
    mut ink := 0
    mut y := 0
    until y < img.height:
        mut x := 0
        until x < img.width:
            if image.Luminance(image.GetPixel(img, x, y)) < 128:
                ink += 1
            end
            x += 1
        end
        y += 1
    end
    testing.AssertTrue(!ok || ink > 100)
    mut big := image.TextStyle {}
    big.size = 64.0
    testing.AssertTrue(!ok || image.TextWidthStyled(f, "سلام", big) > shaped_w)
    image.Free(img)
    image.FreeFont(f)
end

func main:
    println "shaping"
    check_shaping()
    println "direction"
    check_direction()
    println "visual order"
    check_visual_order()
    println "with font"
    check_with_font()
    println "done"
    os.Exit(testing.Summary())
    ret 0
end
