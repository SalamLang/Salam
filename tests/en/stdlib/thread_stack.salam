package main

import thread

mut total := 0 as i64

func count(n: i64): i64:
    if n <= 0:
        ret 0
    end
    ret 1 + count(n - 1)
end

func work(_arg: void*):
    total = count(100000)
end

func main:
    t := thread.SpawnStack(work, null, (64 * 1024 * 1024) as u64)
    println "valid: ", thread.Valid(t)
    println "handle set: ", thread.Handle(t) != 0 as i64
    thread.Join(t)
    println "deep recursion: ", total

    total = 0 as i64
    d := thread.SpawnStack(work, null, 0 as u64)
    println "default stack valid: ", thread.Valid(d)
    thread.Join(d)
    println "default stack ran: ", total > 0 as i64
end
