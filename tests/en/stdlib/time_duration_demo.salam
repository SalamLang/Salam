package main

import testing
import time

func test_constructors_agree():
    testing.AssertEqInt64(time.Seconds(1).nanos(), 1000000000 as i64)
    testing.AssertEqInt64(time.Milliseconds(1000).nanos(), time.Seconds(1).nanos())
    testing.AssertEqInt64(time.Microseconds(1000000).nanos(), time.Seconds(1).nanos())
    testing.AssertEqInt64(time.Nanoseconds(1000000000).nanos(), time.Seconds(1).nanos())
    testing.AssertEqInt64(time.Minutes(1).nanos(), time.Seconds(60).nanos())
    testing.AssertEqInt64(time.Hours(1).nanos(), time.Minutes(60).nanos())
    testing.AssertEqInt64(time.Days(1).nanos(), time.Hours(24).nanos())
    testing.AssertEqInt64(time.ZeroDuration().nanos(), 0 as i64)
end

func test_accessors_convert_down():
    d := time.Milliseconds(1500)
    testing.AssertEqInt64(d.nanos(), 1500000000 as i64)
    testing.AssertEqInt64(d.micros(), 1500000 as i64)
    testing.AssertEqInt64(d.millis(), 1500 as i64)
    testing.AssertEqInt64(d.secs(), 1 as i64)
    testing.AssertEqFloat(d.seconds(), 1.5, 0.000001)
    testing.AssertEqFloat(time.Minutes(90).hours(), 1.5, 0.000001)
    testing.AssertEqFloat(time.Hours(36).days(), 1.5, 0.000001)
    testing.AssertEqFloat(time.Seconds(90).minutes(), 1.5, 0.000001)
end

func test_arithmetic():
    a := time.Seconds(30)
    b := time.Seconds(45)
    testing.AssertEqInt64(a.add(b).secs(), 75 as i64)
    testing.AssertEqInt64(a.sub(b).secs(), 0 - 15 as i64)
    testing.AssertEqInt64(a.mul(3).secs(), 90 as i64)
    testing.AssertEqInt64(b.div(3).secs(), 15 as i64)
    testing.AssertEqInt64(b.div(0).nanos(), 0 as i64)
    testing.AssertEqInt64(time.Minutes(5).ratio(time.Seconds(30)), 10 as i64)
    testing.AssertEqInt64(time.Minutes(5).ratio(time.ZeroDuration()), 0 as i64)
end

func test_sign_and_compare():
    neg := time.Seconds(0 - 30)
    testing.AssertTrue(neg.is_negative())
    testing.AssertFalse(neg.is_zero())
    testing.AssertTrue(time.ZeroDuration().is_zero())
    testing.AssertEqInt64(neg.abs().secs(), 30 as i64)
    testing.AssertEqInt64(neg.neg().secs(), 30 as i64)
    testing.AssertEqInt(time.Seconds(1).cmp(time.Seconds(2)), 0 - 1)
    testing.AssertEqInt(time.Seconds(2).cmp(time.Seconds(1)), 1)
    testing.AssertEqInt(time.Seconds(2).cmp(time.Seconds(2)), 0)
    testing.AssertTrue(time.Seconds(1).less(time.Seconds(2)))
    testing.AssertTrue(time.Seconds(2).equals(time.Milliseconds(2000)))
end

func test_truncate_and_round():
    d := time.Milliseconds(1750)
    testing.AssertEqInt64(d.truncate(time.Seconds(1)).millis(), 1000 as i64)
    testing.AssertEqInt64(d.round(time.Seconds(1)).millis(), 2000 as i64)
    testing.AssertEqInt64(time.Milliseconds(1250).round(time.Seconds(1)).millis(), 1000 as i64)
    testing.AssertEqInt64(time.Milliseconds(1500).round(time.Seconds(1)).millis(), 2000 as i64)
    testing.AssertEqInt64(time.Milliseconds(0 - 1500).round(time.Seconds(1)).millis(), 0 - 2000 as i64)
    testing.AssertEqInt64(time.Milliseconds(0 - 1750).truncate(time.Seconds(1)).millis(), 0 - 1000 as i64)
    testing.AssertEqInt64(d.truncate(time.ZeroDuration()).millis(), 1750 as i64)
    testing.AssertEqInt64(d.round(time.ZeroDuration()).millis(), 1750 as i64)
end

func test_format():
    testing.AssertEqStr(time.FormatDuration(time.ZeroDuration()), "0s")
    testing.AssertEqStr(time.FormatDuration(time.Nanoseconds(500)), "500ns")
    testing.AssertEqStr(time.FormatDuration(time.Nanoseconds(1500)), "1.5us")
    testing.AssertEqStr(time.FormatDuration(time.Microseconds(1500)), "1.5ms")
    testing.AssertEqStr(time.FormatDuration(time.Milliseconds(150)), "150ms")
    testing.AssertEqStr(time.FormatDuration(time.Milliseconds(1500)), "1.5s")
    testing.AssertEqStr(time.FormatDuration(time.Seconds(150)), "2m30s")
    testing.AssertEqStr(time.FormatDuration(time.Hours(1)), "1h0m0s")
    testing.AssertEqStr(time.FormatDuration(time.Minutes(90)), "1h30m0s")
    testing.AssertEqStr(time.FormatDuration(time.Seconds(0 - 150)), "-2m30s")
    testing.AssertEqStr(time.Milliseconds(1500).to_str(), "1.5s")
end

func dur_err(s: str): str:
    try:
        ret "ok " + time.ParseDuration(s).to_str()
    catch e:
        ret e.kind_name() + " " + e.code + " @" + e.offset
    end
end

func test_parse() throws:
    a := try time.ParseDuration("1h30m")
    testing.AssertEqInt64(a.nanos(), time.Minutes(90).nanos())

    b := try time.ParseDuration("-2.5s")
    testing.AssertEqInt64(b.millis(), 0 - 2500 as i64)

    c := try time.ParseDuration("150ms")
    testing.AssertEqInt64(c.millis(), 150 as i64)

    d := try time.ParseDuration("1h30m10.5s")
    testing.AssertEqInt64(d.millis(), 5410500 as i64)

    z := try time.ParseDuration("0")
    testing.AssertEqInt64(z.nanos(), 0 as i64)

    testing.AssertEqInt64((try time.ParseDuration("5us")).nanos(), time.Microseconds(5).nanos())
    testing.AssertEqInt64((try time.ParseDuration("5µs")).nanos(), time.Microseconds(5).nanos())
    testing.AssertEqInt64((try time.ParseDuration("2d")).nanos(), time.Days(2).nanos())
    testing.AssertEqInt64((try time.ParseDuration("+90s")).secs(), 90 as i64)
end

func test_parse_rejects():
    testing.AssertEqStr(dur_err(""), "unexpected end of input time.empty @0")
    testing.AssertEqStr(dur_err("bogus"), "syntax error time.syntax @0")
    testing.AssertEqStr(dur_err("100"), "unexpected end of input time.missing_unit @3")
    testing.AssertEqStr(dur_err("s"), "syntax error time.syntax @0")
    testing.AssertEqStr(dur_err("1x"), "syntax error time.bad_unit @1")
    testing.AssertEqStr(dur_err("1h 30m"), "syntax error time.bad_unit @1")
    testing.AssertEqStr(dur_err("-"), "unexpected end of input time.unexpected_end @1")
    testing.AssertEqStr(dur_err("1.s"), "syntax error time.syntax @2")
    testing.AssertEqStr(dur_err("1h30"), "unexpected end of input time.missing_unit @4")
    testing.AssertEqInt64(time.ParseDurationOr("nope", time.Seconds(7)).secs(), 7 as i64)
    testing.AssertEqInt64(time.ParseDurationOr("2m", time.Seconds(7)).secs(), 120 as i64)
end

func test_parse_rejects_overflow() throws:
    testing.AssertEqStr(dur_err("999999999999999999999h"), "out of range time.overflow @0")
    testing.AssertEqStr(dur_err("10000000000000s"), "out of range time.overflow @0")
    testing.AssertEqStr(dur_err("100000000000000000000000ns"), "out of range time.overflow @0")
    testing.AssertEqStr(dur_err("1000000000000d"), "out of range time.overflow @0")
    testing.AssertEqStr(dur_err("9223372036854775808ns"), "out of range time.overflow @0")
    testing.AssertEqStr(dur_err("9223372036854775807ns1ns"), "out of range time.overflow @21")
    top := try time.ParseDuration("9223372036854775807ns")
    testing.AssertEqInt64(top.nanos(), 9223372036854775807 as i64)
    big := try time.ParseDuration("2562047h")
    testing.AssertEqInt64(big.nanos(), 9223369200000000000 as i64)
    frac := try time.ParseDuration("0.999999999d")
    testing.AssertEqInt64(frac.nanos(), 86399999913600 as i64)
    testing.AssertEqInt64(time.ParseDurationOr("999999999999999999999h", time.Seconds(30)).secs(), 30 as i64)
end

func test_extreme_negative_value():
    lo := time.Nanoseconds(0 - 9223372036854775807 as i64).sub(time.Nanoseconds(1))
    testing.AssertTrue(lo.is_negative())
    testing.AssertEqStr(time.FormatDuration(lo), "-2562047h47m16.854775808s")
    testing.AssertEqInt64(lo.abs().nanos(), 9223372036854775807 as i64)
    testing.AssertEqInt64(lo.neg().nanos(), 9223372036854775807 as i64)
    testing.AssertFalse(lo.abs().is_negative())
    testing.AssertTrue(lo.round(time.Seconds(1)).is_negative())
    testing.AssertEqInt64(lo.round(time.Seconds(1)).nanos(), lo.truncate(time.Seconds(1)).nanos())
    testing.AssertEqStr(dur_err(time.FormatDuration(lo)), "out of range time.overflow @12")
end

func test_format_parse_roundtrip() throws:
    mut cases := Vector {} as Vector<i64>
    defer cases.free()
    cases.push(0 as i64)
    cases.push(500 as i64)
    cases.push(1500 as i64)
    cases.push(1500000 as i64)
    cases.push(1500000000 as i64)
    cases.push(150000000000 as i64)
    cases.push(5410500000000 as i64)
    cases.push(0 - 150000000000 as i64)
    repeat cases.len() in i:
        d := time.Nanoseconds(cases.get(i))
        back := try time.ParseDuration(time.FormatDuration(d))
        testing.AssertEqInt64(back.nanos(), d.nanos())
    end
end

func test_epoch_bridges():
    testing.AssertEqInt64(time.DurationBetween(1000 as i64, 400 as i64).secs(), 600 as i64)
    testing.AssertEqInt64(time.AddDuration(1000 as i64, time.Minutes(2)), 1120 as i64)
    testing.AssertEqInt64(time.AddDuration(1000 as i64, time.Milliseconds(1500)), 1001 as i64)
end

func main: int throws:
    test_constructors_agree()
    test_accessors_convert_down()
    test_arithmetic()
    test_sign_and_compare()
    test_truncate_and_round()
    test_format()
    try test_parse()
    test_parse_rejects()
    try test_parse_rejects_overflow()
    test_extreme_negative_value()
    try test_format_parse_roundtrip()
    test_epoch_bridges()
    testing.Summary()
    ret 0
end
