package main

import time

func show(label: str, e: Error):
    println label + ": " + e.kind_name() + " " + e.code + " | " + e.to_str()
end

func iso(label: str, text: str):
    try:
        println label + ": ok " + time.FormatISOUTC(time.ParseISO(text))
    catch e:
        show(label, e)
    end
end

func http(label: str, text: str):
    try:
        println label + ": ok " + time.FormatISOUTC(time.ParseHTTPDate(text))
    catch e:
        show(label, e)
    end
end

func layout(label: str, pattern: str, text: str):
    try:
        println label + ": ok " + time.FormatISOUTC(time.ParseFormat(pattern, text))
    catch e:
        show(label, e)
    end
end

func duration(label: str, text: str):
    try:
        println label + ": ok " + time.ParseDuration(text).to_str()
    catch e:
        show(label, e)
    end
end

func iso_errors():
    println "== time.ParseISO =="
    iso("full", "2024-03-15T14:30:45+03:30")
    iso("leap second", "2016-12-31T23:59:60Z")
    iso("end of day", "2024-03-15T24:00:00Z")
    iso("empty", "")
    iso("blank", "   ")
    iso("words", "tomorrow")
    iso("Persian digits", "۲۰۲۴-03-15")
    iso("slashes", "2024/03/15")
    iso("one digit month", "2024-3-15")
    iso("cut after month", "2024-03")
    iso("cut after hour", "2024-03-15T14")
    iso("bad separator", "2024-03-15_14:30:45Z")
    iso("month 13", "2024-13-01T00:00:00Z")
    iso("day 30 of February", "2024-02-30")
    iso("hour 25", "2024-03-15T25:00:00Z")
    iso("24 with minutes", "2024-03-15T24:30:00Z")
    iso("minute 61", "2024-03-15T14:61:00Z")
    iso("second 61", "2024-03-15T14:30:61Z")
    iso("offset too large", "2024-03-15T14:30:45+24:00")
    iso("empty fraction", "2024-03-15T14:30:45.Z")
    iso("text after the zone", "2024-03-15T14:30:45Z later")
end

func nanos_errors():
    println "== time.ParseISONanos =="
    try:
        println "fraction: ok " + time.ParseISONanos("2024-03-15T14:30:45.123456789Z")
    catch e:
        show("fraction", e)
    end
    try:
        println "year 2300: ok " + time.ParseISONanos("2300-01-01T00:00:00Z")
    catch e:
        show("year 2300", e)
    end
end

func http_errors():
    println "== time.ParseHTTPDate =="
    http("IMF", "Wed, 09 Jun 2021 10:18:14 GMT")
    http("RFC 850", "Wednesday, 09-Jun-21 10:18:14 GMT")
    http("asctime", "Wed Jun  9 10:18:14 2021")
    http("numeric zone", "Wed, 09 Jun 2021 12:18:14 +0200")
    http("empty", "")
    http("no day name", "09 Jun 2021 10:18:14 GMT")
    http("unknown month", "Wed, 09 Jux 2021 10:18:14 GMT")
    http("no time", "Wed, 09 Jun 2021")
    http("other zone", "Wed, 09 Jun 2021 10:18:14 PST")
    http("31 June", "Wed, 31 Jun 2021 10:18:14 GMT")
    http("text after the year", "Wed Jun  9 10:18:14 2021 GMT")
end

func layout_errors():
    println "== time.ParseFormat =="
    layout("day first", "%d/%m/%Y %H:%M %z", "20/03/2024 14:05 +0000")
    layout("month name", "%b %d %Y %Z", "Mar 20 2024 UTC")
    layout("wrong separator", "%d/%m/%Y", "20-03-2024")
    layout("cut short", "%d/%m/%Y", "20/03")
    layout("letters for digits", "%Y-%m-%d", "year-03-20")
    layout("month 13", "%d/%m/%Y", "20/13/2024")
    layout("unknown month name", "%b %Y", "Foo 2024")
    layout("extra text", "%Y", "2024 AD")
    layout("unknown directive", "%Q", "x")
    layout("lone percent", "%Y %", "2024 x")
end

func duration_errors():
    println "== time.ParseDuration =="
    duration("mixed", "1h15m30.5s")
    duration("negative", "-250ms")
    duration("zero", "0")
    duration("empty", "")
    duration("sign only", "-")
    duration("words", "ten minutes")
    duration("no unit", "90")
    duration("missing last unit", "1h30")
    duration("unknown unit", "5y")
    duration("space inside", "1h 30m")
    duration("dot without digits", "1.s")
    duration("too long", "9999999999h")
    println "Or forms: " + time.ParseDurationOr("soon", time.Seconds(5)).to_str() + " " + time.ParseISOOr("soon", 7)
end

func main:
    iso_errors()
    nanos_errors()
    http_errors()
    layout_errors()
    duration_errors()
end
