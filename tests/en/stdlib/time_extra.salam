package main

import env
import time
import testing

func main:
    env.Set("TZ", "UTC")

    println "fields in utc"
    e := 1710513045 as i64
    println time.YearUTC(e), time.MonthUTC(e), time.DayUTC(e)
    println time.HourUTC(e), time.MinuteUTC(e), time.SecondUTC(e)
    leap := 1709208000 as i64
    println time.YearUTC(leap), time.MonthUTC(leap), time.DayUTC(leap), time.HourUTC(leap)
    println time.YearUTC(0 as i64), time.MonthUTC(0 as i64), time.DayUTC(0 as i64), time.HourUTC(0 as i64)
    println time.MinuteUTC(0 as i64), time.SecondUTC(0 as i64)
    old := 0 - 86401 as i64
    println time.YearUTC(old), time.MonthUTC(old), time.DayUTC(old), time.HourUTC(old), time.MinuteUTC(old), time.SecondUTC(old)

    println "day of the year"
    println time.YearDay(e), time.YearDay(leap)
    println time.YearDay(1704110400 as i64), time.YearDay(1735646400 as i64)
    println time.YearDay(1735689599 as i64 - 43200 as i64)

    println "clock text"
    println time.FormatTime(e), time.FormatTime(0 as i64), time.FormatTime(86399 as i64)
    println time.FormatTime(e + 3600 as i64)

    println "date time values"
    dt := time.FromEpoch(e)
    println time.Epoch(dt), time.Epoch(time.FromEpoch(0 as i64)), time.Epoch(time.FromEpoch(0 - 5 as i64))
    now := time.NowDateTime()
    stamp := time.Epoch(now)
    testing.AssertTrue(stamp > 1700000000 as i64)
    testing.AssertTrue(time.DiffSeconds(time.Epoch(time.NowDateTime()), stamp) >= 0 as i64)
    testing.AssertTrue(time.DiffSeconds(time.Epoch(time.NowDateTime()), stamp) < 5 as i64)

    println "differences"
    println time.DiffSeconds(e + 90 as i64, e), time.DiffSeconds(e, e + 90 as i64), time.DiffSeconds(e, e)
    ahead := time.Until(time.Epoch(time.NowDateTime()) + 3600 as i64)
    println ahead > 3590 as i64, ahead <= 3600 as i64
    behind := time.Until(time.Epoch(time.NowDateTime()) - 60 as i64)
    println behind < 0 as i64, behind >= 0 - 65 as i64
    since := time.Since(time.Epoch(time.NowDateTime()) - 60 as i64)
    println since >= 60 as i64, since < 65 as i64

    println "fractional seconds"
    d := time.SecondsF(1.5)
    println d.ns, time.SecondsF(0.0).ns, time.SecondsF(0.000000001).ns
    println time.SecondsF(0.0 - 2.25).ns, time.SecondsF(86400.0).ns
    println time.FormatDuration(time.SecondsF(90.5))
    ret testing.Summary()
end
