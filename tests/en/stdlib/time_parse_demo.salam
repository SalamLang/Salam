package main

import testing
import time

func code_of(e: Error): str:
    ret e.kind_name() + " " + e.code + " @" + e.offset
end

func iso_err(s: str): str:
    try:
        ret "ok " + time.ParseISO(s)
    catch e:
        ret code_of(e)
    end
end

func http_err(s: str): str:
    try:
        ret "ok " + time.ParseHTTPDate(s)
    catch e:
        ret code_of(e)
    end
end

func format_err(layout: str, s: str): str:
    try:
        ret "ok " + time.ParseFormat(layout, s)
    catch e:
        ret code_of(e)
    end
end

func test_parse_iso_with_zone() throws:
    a := try time.ParseISO("2024-03-15T14:30:45Z")
    testing.AssertEqInt64(a, 1710513045 as i64)
    b := try time.ParseISO("2024-03-15T20:00:45+05:30")
    testing.AssertEqInt64(b, 1710513045 as i64)
    c := try time.ParseISO("2024-03-15T06:30:45-08:00")
    testing.AssertEqInt64(c, 1710513045 as i64)
    d := try time.ParseISO("2024-03-15T20:00:45+0530")
    testing.AssertEqInt64(d, 1710513045 as i64)
    e := try time.ParseISO("2024-03-15T15:30:45+01")
    testing.AssertEqInt64(e, 1710513045 as i64)
    f := try time.ParseISO("2024-03-15t14:30:45z")
    testing.AssertEqInt64(f, 1710513045 as i64)
    g := try time.ParseISO("  2024-03-15T14:30:45Z  ")
    testing.AssertEqInt64(g, 1710513045 as i64)
end

func test_parse_iso_shapes() throws:
    a := try time.ParseISO("2024-03-15T14:30Z")
    testing.AssertEqInt64(a, 1710513000 as i64)
    b := try time.ParseISO("2024-03-15T14:30:45.250Z")
    testing.AssertEqInt64(b, 1710513045 as i64)
    bn := try time.ParseISONanos("2024-03-15T14:30:45.250Z")
    testing.AssertEqInt64(bn, 1710513045250000000 as i64)
    c := try time.ParseISONanos("2024-03-15T14:30:45.000000001Z")
    testing.AssertEqInt64(c % 1000000000, 1 as i64)
    d := try time.ParseISONanos("2024-03-15T14:30:45,5Z")
    testing.AssertEqInt64(d % 1000000000, 500000000 as i64)
    e := try time.ParseISO("1969-07-20T20:17:40Z")
    testing.AssertEqInt64(e, 0 - 14182940 as i64)
    en := try time.ParseISONanos("1969-07-20T20:17:40.5Z")
    testing.AssertEqInt64(en, 0 - 14182939500000000 as i64)
    f := try time.ParseISO("2016-12-31T23:59:60Z")
    testing.AssertEqInt64(f, 1483228799 as i64)
    m := try time.ParseISO("2024-03-15T24:00:00Z")
    testing.AssertEqInt64(m, 1710547200 as i64)
end

func test_parse_iso_rejects():
    testing.AssertEqStr(iso_err(""), "unexpected end of input time.empty @0")
    testing.AssertEqStr(iso_err("   "), "unexpected end of input time.empty @0")
    testing.AssertEqStr(iso_err("nonsense"), "syntax error time.syntax @0")
    testing.AssertEqStr(iso_err("2024-13-01T00:00:00Z"), "out of range time.bad_month @5")
    testing.AssertEqStr(iso_err("2024-00-01"), "out of range time.bad_month @5")
    testing.AssertEqStr(iso_err("2024-03-32T00:00:00Z"), "out of range time.bad_day @8")
    testing.AssertEqStr(iso_err("2023-02-29"), "out of range time.bad_day @8")
    testing.AssertEqStr(iso_err("2024-03-15T25:00:00Z"), "out of range time.bad_hour @11")
    testing.AssertEqStr(iso_err("2024-03-15T24:30:00Z"), "out of range time.bad_hour @11")
    testing.AssertEqStr(iso_err("2024-03-15T14:61:00Z"), "out of range time.bad_minute @14")
    testing.AssertEqStr(iso_err("2024-03-15T14:30:61Z"), "out of range time.bad_second @17")
    testing.AssertEqStr(iso_err("2024-03-15T14:30:45Zjunk"), "syntax error time.trailing @20")
    testing.AssertEqStr(iso_err("2024-03-15T14:30:45+99:00"), "out of range time.bad_offset @19")
    testing.AssertEqStr(iso_err("2024-3-15T14:30:45Z"), "syntax error time.syntax @6")
    testing.AssertEqStr(iso_err("2024/03/15"), "syntax error time.syntax @4")
    testing.AssertEqStr(iso_err("2024-03-15T14:30:45.Z"), "syntax error time.syntax @20")
    testing.AssertEqStr(iso_err("2024-03"), "unexpected end of input time.unexpected_end @7")
    testing.AssertEqStr(iso_err("2024-03-15T14"), "unexpected end of input time.unexpected_end @13")
    testing.AssertEqStr(iso_err("  2024-13-01"), "out of range time.bad_month @7")
    testing.AssertEqInt64(time.ParseISOOr("bad", 42 as i64), 42 as i64)
    testing.AssertEqInt64(time.ParseISOOr("2024-03-15T14:30:45Z", 42 as i64), 1710513045 as i64)
    try:
        time.ParseISONanos("2400-01-01T00:00:00Z")
        testing.AssertTrue(false)
    catch e:
        testing.AssertEqStr(code_of(e), "out of range time.overflow @0")
    end
end

func test_parse_iso_in_offset() throws:
    a := try time.ParseISOIn("2024-03-15T20:00:45", 330)
    testing.AssertEqInt64(a, 1710513045 as i64)
    b := try time.ParseISOIn("2024-03-15T14:30:45Z", 330)
    testing.AssertEqInt64(b, 1710513045 as i64)
end

func test_parse_http_date() throws:
    want := 1623233894 as i64
    a := try time.ParseHTTPDate("Wed, 09 Jun 2021 10:18:14 GMT")
    testing.AssertEqInt64(a, want)
    b := try time.ParseHTTPDate("Wednesday, 09-Jun-21 10:18:14 GMT")
    testing.AssertEqInt64(b, want)
    c := try time.ParseHTTPDate("Wed Jun  9 10:18:14 2021")
    testing.AssertEqInt64(c, want)
    d := try time.ParseHTTPDate("Sun, 01-Jan-95 00:00:00 GMT")
    testing.AssertEqInt64(d, 788918400 as i64)
    e := try time.ParseHTTPDate("Wed, 09 Jun 2021 12:18:14 +0200")
    testing.AssertEqInt64(e, want)
    testing.AssertEqStr(http_err("Wed, 09 Xxx 2021 10:18:14 GMT"), "syntax error time.bad_month_name @8")
    testing.AssertEqStr(http_err(""), "unexpected end of input time.empty @0")
    testing.AssertEqStr(http_err("Wed, 09 Jun 2021 10:18:14 PST"), "syntax error time.syntax @26")
    testing.AssertEqStr(http_err("Wed, 09 Jun 2021"), "unexpected end of input time.unexpected_end @16")
    testing.AssertEqStr(http_err("Wed, 31 Jun 2021 10:18:14 GMT"), "out of range time.bad_day @5")
    testing.AssertEqStr(http_err("Wed Jun  9 10:18:14 2021 extra"), "syntax error time.trailing @24")
end

func test_parse_format() throws:
    a := try time.ParseFormat("%Y-%m-%dT%H:%M:%S%z", "2024-03-15T14:30:45Z")
    testing.AssertEqInt64(a, 1710513045 as i64)
    b := try time.ParseFormat("%d/%m/%Y %H:%M:%S %z", "15/03/2024 14:30:45 +0000")
    testing.AssertEqInt64(b, 1710513045 as i64)
    c := try time.ParseFormat("%b %d %Y %H:%M:%S %Z", "Mar 15 2024 14:30:45 UTC")
    testing.AssertEqInt64(c, 1710513045 as i64)
    d := try time.ParseFormat("%A, %B %d %Y %H:%M:%S %Z", "Friday, March 15 2024 14:30:45 GMT")
    testing.AssertEqInt64(d, 1710513045 as i64)
    e := try time.ParseFormat("%Y%m%d%H%M%S%z", "20240315143045Z")
    testing.AssertEqInt64(e, 1710513045 as i64)
    f := try time.ParseFormat("100%% %Y %z", "100% 2024 Z")
    testing.AssertEqInt64(f, 1704067200 as i64)
    g := try time.ParseFormat("%y-%m-%d %z", "24-03-15 Z")
    testing.AssertEqInt64(g, 1710460800 as i64)
    h := try time.ParseFormat("%H:%M:%S.%f %z", "00:00:00.125 Z")
    testing.AssertEqInt64(h, 0 as i64)
    testing.AssertEqStr(format_err("%Y-%m-%d", "2024/03/15"), "syntax error time.layout_mismatch @4")
    testing.AssertEqStr(format_err("%Y-%m-%d", "2024-03"), "unexpected end of input time.unexpected_end @7")
    testing.AssertEqStr(format_err("%Q", "x"), "invalid argument time.bad_layout @-1")
    testing.AssertEqStr(format_err("%Y %", "2024 x"), "invalid argument time.bad_layout @-1")
    testing.AssertEqStr(format_err("%Y", "2024junk"), "syntax error time.trailing @4")
    testing.AssertEqStr(format_err("%d/%m/%Y", "15/13/2024"), "out of range time.bad_month @3")
    testing.AssertEqStr(format_err("%b %Y", "Foo 2024"), "syntax error time.bad_month_name @0")
end

func test_roundtrip_every_formatter() throws:
    mut stamps := Vector {} as Vector<i64>
    defer stamps.Free()
    stamps.Push(0 as i64)
    stamps.Push(1710513045 as i64)
    stamps.Push(time.Now())
    stamps.Push(0 - 14182940 as i64)
    stamps.Push(2000000000 as i64)
    repeat stamps.Len() in i:
        e := stamps.Get(i)
        testing.AssertEqInt64(try time.ParseISO(time.FormatISO(e)), e)
        testing.AssertEqInt64(try time.ParseISO(time.Format(e)), e)
        testing.AssertEqInt64(try time.ParseISO(time.FormatRFC3339(e)), e)
        testing.AssertEqInt64(try time.ParseISO(time.FormatISOUTC(e)), e)
        testing.AssertEqInt64(try time.ParseHTTPDate(time.FormatHTTPDate(e)), e)
        r6 := try time.ParseISO(time.FormatDate(e))
        testing.AssertEqInt(time.Day(r6), time.Day(e))
    end
end

func test_utc_and_local_parts():
    testing.AssertEqInt64(time.FromUTCParts(2024, 3, 15, 14, 30, 45), 1710513045 as i64)
    testing.AssertEqInt64(time.FromUTCParts(1970, 1, 1, 0, 0, 0), 0 as i64)
    testing.AssertEqInt64(time.FromUTCParts(1969, 7, 20, 20, 17, 40), 0 - 14182940 as i64)
    testing.AssertEqStr(time.FormatISOUTC(time.FromUTCParts(2024, 3, 15, 14, 30, 45)), "2024-03-15T14:30:45Z")
    e := time.FromLocalParts(2024, 3, 15, 14, 30, 45)
    testing.AssertEqInt(time.Year(e), 2024)
    testing.AssertEqInt(time.Month(e), 3)
    testing.AssertEqInt(time.Day(e), 15)
    testing.AssertEqInt(time.Hour(e), 14)
    testing.AssertEqInt(time.Minute(e), 30)
    testing.AssertEqInt(time.Second(e), 45)
end

func test_local_offset_is_consistent():
    now := time.Now()
    off := time.LocalOffsetMinutesAt(now)
    testing.AssertTrue(off >= 0 - 720)
    testing.AssertTrue(off <= 840)
    local := time.FromUTCParts(time.Year(now), time.Month(now), time.Day(now), time.Hour(now), time.Minute(now), time.Second(now))
    testing.AssertEqInt64(local - now, (off as i64) * 60)
end

func main: int throws:
    try test_parse_iso_with_zone()
    try test_parse_iso_shapes()
    test_parse_iso_rejects()
    try test_parse_iso_in_offset()
    try test_parse_http_date()
    try test_parse_format()
    try test_roundtrip_every_formatter()
    test_utc_and_local_parts()
    test_local_offset_is_consistent()
    testing.Summary()
    ret 0
end
