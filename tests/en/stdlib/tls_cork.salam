import net.tcp
import sync
import tls

mut port := 0
mut server_flushed := false
mut ready := sync.NewWaitGroup()

func serve():
    srv := tcp.Bind(0)
    port = tcp.Port(srv)
    sync.Done(ready)
    c := tcp.Accept(srv)
    cfg := tls.NewServerConfig("tests/fixtures/ssl/server.crt", "tests/fixtures/ssl/server.key")
    mut conn := tls.WrapServer(c.fd, cfg)
    mut got := ""
    until got.len() < 10:
        part := tls.Read(conn, 64)
        if part.len() == 0:
            break
        end
        got += part
    end
    tls.Cork(conn)
    tls.Write(conn, "pong")
    tls.Write(conn, ":" + got)
    server_flushed = tls.Flush(conn)
    tls.Close(conn)
    tcp.CloseServer(srv)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(serve)
    sync.Wait(ready)
    mut cfg := tls.NewConfig("localhost")
    cfg.insecure_skip_verify = true
    mut c := tls.Dial("127.0.0.1", port, cfg)
    tls.Cork(c)
    tls.Write(c, "hello")
    tls.Write(c, "world")
    println tls.Flush(c)
    mut got := ""
    until got.len() < 15:
        part := tls.Read(c, 64)
        if part.len() == 0:
            break
        end
        got += part
    end
    println got
    tls.Close(c)
    println tls.Flush(c)
    join(t)
    println server_flushed
end
