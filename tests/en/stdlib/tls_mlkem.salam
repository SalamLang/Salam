import mem
import tls

func unhex(h: str): void*:
    n := h.len() / 2
    p := mem.AllocateZeroed((n + 1) as u64)
    bp := p as u8*
    digits := "0123456789abcdef"
    repeat n in i:
        a := digits.find(h.substr(2 * i, 1))
        b := digits.find(h.substr(2 * i + 1, 1))
        bp[i] = (a * 16 + b) as u8
    end
    ret p
end

func hex(p: void*, n: int): str:
    bp := p as u8*
    digits := "0123456789abcdef"
    mut s := ""
    repeat n in i:
        v := bp[i] as int
        s += digits.substr(v >> 4, 1) + digits.substr(v & 15, 1)
    end
    ret s
end

func main:
    out := mem.AllocateZeroed(300 as u64)
    msg := "abc"
    tls.Sha3256(msg as void*, 3, out)
    println "sha3-256:", hex(out, 32) == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"
    tls.Sha3512(msg as void*, 3, out)
    println "sha3-512:", hex(out, 64) == "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"
    tls.Shake128(msg as void*, 3, out, 200)
    println "shake128:", hex(out, 200) == ""
    tls.Shake256(msg as void*, 3, out, 100)
    println "shake256:", hex(out, 100) == "483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739d5a15bef186a5386c75744c0527e1faa9f8726e462a12a4feb06bd8801e751e41385141204f329979fd3047a13c5657724ada64d2470157b3cdc288620944d78dbcddbd9"
    big := mem.AllocateZeroed(500 as u64)
    repeat 500 in i:
        (big as u8*)[i] = ((i * 7) & 255) as u8
    end
    tls.Sha3256(big, 500, out)
    println "sha3-256 over four blocks:", hex(out, 32) == "c279a0598694be2d8a97f74ed733a55aa05012d6723186b1261dba7792aa4dfd"
    tls.Shake128(big, 300, out, 300)
    println "shake128 over several blocks:", hex(out, 300) == ""
    seed := unhex("0104070a0d101316191c1f2225282b2e3134373a3d404346494c4f5255585b5e6164676a6d707376797c7f8285888b8e9194979a9da0a3a6a9acafb2b5b8bbbe")
    ek := mem.AllocateZeroed(1184 as u64)
    tls.Mlkem768PublicKey(seed, ek)
    println "ml-kem-768 public key from the seed:", hex(ek, 1184) == ""
    ct := unhex("")
    ss := mem.AllocateZeroed(32 as u64)
    tls.Mlkem768Decapsulate(seed, ct, ss)
    println "decapsulation of a ciphertext made by another implementation:", hex(ss, 32) == "9383b70278abc5bf9c4e0ba1dc763dac6bf1df300c5c0ae3dc91b19a58659b09"
    m := mem.AllocateZeroed(32 as u64)
    repeat 32 in i:
        (m as u8*)[i] = (i * 5 + 9) as u8
    end
    ct2 := mem.AllocateZeroed(1088 as u64)
    ss2 := mem.AllocateZeroed(32 as u64)
    ok := tls.Mlkem768Encapsulate(ek, m, ct2, ss2)
    println "encapsulation:", ok, hex(ss2, 32) == "1815dfe162eed8db9482cd93071e953bf4a6d8e56077c1e884b1127e4b7d2420"
    back := mem.AllocateZeroed(32 as u64)
    tls.Mlkem768Decapsulate(seed, ct2, back)
    println "round trip:", hex(back, 32) == hex(ss2, 32)
    bad := unhex("")
    (bad as u8*)[100] = (((bad as u8*)[100] as int) ^ 1) as u8
    rej := mem.AllocateZeroed(32 as u64)
    tls.Mlkem768Decapsulate(seed, bad, rej)
    println "a damaged ciphertext gives the implicit rejection key:", hex(rej, 32) == "143215aa8f8cf340579aece8de259f642715a0d630654ffc671dc7f9c6ce9f28", hex(rej, 32) != hex(ss, 32)
end
