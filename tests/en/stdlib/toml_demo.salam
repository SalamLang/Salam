package main

import encoding.toml
import encoding.value
import testing

func main(): int throws:
    v1 := try toml.Decode("name = \"salam\"\nage = 5\npi = 3.5\nactive = true\n")
    testing.AssertEqStr(value.AsString(value.ObjectGet(v1, "name")), "salam")
    testing.AssertEqInt64(value.AsInt(value.ObjectGet(v1, "age")), 5 as i64)
    testing.AssertEqFloat(value.AsFloat(value.ObjectGet(v1, "pi")), 3.5, 0.0001)
    testing.AssertTrue(value.AsBool(value.ObjectGet(v1, "active")))

    v2 := try toml.Decode("# a comment\nhex = 0xFF\noct = 0o17\nbin = 0b101\n")
    testing.AssertEqInt64(value.AsInt(value.ObjectGet(v2, "hex")), 255 as i64)
    testing.AssertEqInt64(value.AsInt(value.ObjectGet(v2, "oct")), 15 as i64)
    testing.AssertEqInt64(value.AsInt(value.ObjectGet(v2, "bin")), 5 as i64)

    v3 := try toml.Decode("nums = [1, 2, 3]\npoint = { x = 1, y = 2 }\n")
    nums := value.ObjectGet(v3, "nums")
    testing.AssertEqInt(value.ArrayLen(nums), 3)
    testing.AssertEqInt64(value.AsInt(value.ArrayGet(nums, 1)), 2 as i64)
    point := value.ObjectGet(v3, "point")
    testing.AssertEqInt64(value.AsInt(value.ObjectGet(point, "x")), 1 as i64)

    v4 := try toml.Decode("[server]\nhost = \"localhost\"\nport = 8080\n\n[server.tls]\nenabled = true\n")
    server := value.ObjectGet(v4, "server")
    testing.AssertEqStr(value.AsString(value.ObjectGet(server, "host")), "localhost")
    tls := value.ObjectGet(server, "tls")
    testing.AssertTrue(value.AsBool(value.ObjectGet(tls, "enabled")))

    v5 := try toml.Decode("[[items]]\nname = \"a\"\n\n[[items]]\nname = \"b\"\n")
    items := value.ObjectGet(v5, "items")
    testing.AssertEqInt(value.ArrayLen(items), 2)
    testing.AssertEqStr(value.AsString(value.ObjectGet(value.ArrayGet(items, 0), "name")), "a")
    testing.AssertEqStr(value.AsString(value.ObjectGet(value.ArrayGet(items, 1), "name")), "b")

    encoded := try toml.Encode(v4)
    v4b := try toml.Decode(encoded)
    testing.AssertTrue(value.Equal(v4, v4b))

    testing.AssertTrue(toml.Valid(encoded))
    mut caught := Error {}
    try:
        toml.Decode("a = \n")
    catch e:
        caught = e
    end
    testing.AssertTrue(caught.is(ErrorKind.Syntax))
    testing.AssertEqStr(caught.code, "toml.expected_value")
    testing.AssertEqInt(caught.line, 1)
    testing.AssertEqInt(caught.column, 5)
    testing.AssertFalse(toml.Valid("a = \n"))

    value.ValueFree(v1)
    value.ValueFree(v2)
    value.ValueFree(v3)
    value.ValueFree(v4)
    value.ValueFree(v4b)
    value.ValueFree(v5)

    ret testing.Summary()
end
