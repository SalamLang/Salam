package main

import encoding.toml
import encoding.value

func show_failure(v: value.Value):
    try:
        text := toml.Encode(v)
        println "encoded", text
    catch e:
        println e.is(ErrorKind.Unsupported), e.code
        println e.to_str()
    end
end

func main:
    try:
        obj := toml.Decode("title = \"demo\"\nport = 8080\n[db]\nhost = \"local\"\n")
        text := toml.Encode(obj)
        println text
        println toml.Valid(text)
        println toml.Encode(value.NewValueObject()) == ""
    catch e:
        println e.to_str()
    end
    show_failure(value.ValueInt(5 as i64))
    show_failure(value.ValueString("loose"))
    show_failure(value.NewValueArray())
end
