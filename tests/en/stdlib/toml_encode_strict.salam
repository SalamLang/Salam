package main

import encoding.toml
import encoding.value

func main:
    mut ok := false
    obj := toml.DecodeStrict("title = \"demo\"\nport = 8080\n[db]\nhost = \"local\"\n", ok)
    println ok
    text := toml.EncodeStrict(obj, ok)
    println ok
    println text
    println toml.Valid(text)
    _ := toml.EncodeStrict(value.ValueInt(5 as i64), ok)
    println ok
    s := toml.EncodeStrict(value.ValueString("loose"), ok)
    println ok, s == ""
    _ := toml.EncodeStrict(value.NewValueArray(), ok)
    println ok
    println toml.EncodeStrict(value.NewValueObject(), ok) == "", ok
end
