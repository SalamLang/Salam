package main

import encoding.toml
import encoding.value
import str

func show(label: str, e: Error):
    mut line := label + ": " + e.kind_name() + " | " + e.ToStr()
    if e.code != "":
        line = line + " [" + e.code + "]"
    end
    println line
end

func decode(label: str, text: str):
    try:
        mut v := toml.Decode(text)
        println label + ": ok " + str.Replace(str.Trim(try toml.Encode(v)), "\n", "; ")
        value.ValueFree(v)
    catch e:
        show(label, e)
    end
end

func encode(label: str, v: value.Value):
    try:
        println label + ": ok " + toml.Encode(v)
    catch e:
        show(label, e)
    end
end

func nested(depth: int): str:
    mut out := "a = "
    repeat depth:
        out += "["
    end
    repeat depth:
        out += "]"
    end
    ret out + "\n"
end

func main:
    println "== toml.Decode =="
    decode("valid", "name = \"salam\"\n\n[server]\nport = 8080\n")
    decode("missing value", "name = \"salam\"\nport = \n")
    decode("missing equals", "name \"salam\"\n")
    decode("missing key", "= 1\n")
    decode("unclosed string", "a = 1\nb = \"text\n")
    decode("string at end", "a = 'text")
    decode("bad escape", "path = \"C:\\data\"\n")
    decode("bare word", "mode = fast\n")
    decode("bad number", "n = 1__0\n")
    decode("leading zero", "n = 007\n")
    decode("too big", "n = 9223372036854775808\n")
    decode("array comma", "a = [1 2]\n")
    decode("unclosed array", "a = [1, 2,\n  3\n")
    decode("inline table", "p = { x = 1 y = 2 }\n")
    decode("unclosed header", "[server\nport = 1\n")
    decode("two values", "a = 1 b = 2\n")
    decode("duplicate key", "a = 1\nb = 2\na = 3\n")
    decode("duplicate table", "[t]\nx = 1\n\n[t]\ny = 2\n")
    decode("not a table", "a = 1\n[a.b]\n")
    decode("array is not a table", "[[a]]\n[a]\n")
    decode("too deep", nested(600))
    try:
        deep := toml.Decode(nested(500))
        println "500 levels: ok, " + (try toml.Encode(deep)).len() + " bytes"
    catch e:
        show("500 levels", e)
    end
    decode("array of tables", "[[fruit]]\nname = \"apple\"\n[fruit.size]\ncm = 8\n")

    println ""
    println "== toml.Encode =="
    encode("not an object", value.ValueInt(1))
    mut o := value.NewValueObject()
    mut list := value.NewValueArray()
    value.ArrayPush(list, value.ValueInt(1))
    value.ArrayPush(list, value.ValueNull())
    mut inner := value.NewValueObject()
    value.ObjectSet(inner, "list", list)
    value.ObjectSet(o, "server", inner)
    encode("null in an array", o)
    value.ValueFree(o)

    println ""
    println "== toml.Valid =="
    println toml.Valid("a = 1\n"), toml.Valid("a = \n"), toml.Valid("a = 1\na = 2\n")

    println ""
    println "== fields =="
    try:
        toml.Decode("[db]\nhost = \"x\"\nport = eighty\n")
    catch e:
        println e.kind == ErrorKind.Syntax, e.code, e.context, e.line, e.column, e.offset
        println e.wrap("loading config").ToStr()
    end
end
