package main

import encoding.toml
import encoding.value
import testing

func main(): int throws:
    mut v := try toml.Decode("intro = \"\"\"\nline one\nline two\"\"\"\n")
    testing.AssertEqStr(value.AsString(value.ObjectGet(v, "intro")), "line one\nline two")

    mut v2 := try toml.Decode("quoted = \"\"\"a \"quote\" and \\u0633\\u0644\\u0627\\u0645\"\"\"\n")
    testing.AssertEqStr(value.AsString(value.ObjectGet(v2, "quoted")), "a \"quote\" and سلام")

    mut v3 := try toml.Decode("joined = \"\"\"one \\\n    two \\\n    three\"\"\"\n")
    testing.AssertEqStr(value.AsString(value.ObjectGet(v3, "joined")), "one two three")

    mut v4 := try toml.Decode("raw = '''\nC:\\Users\\ali\nno \\n escape'''\n")
    testing.AssertEqStr(value.AsString(value.ObjectGet(v4, "raw")), "C:\\Users\\ali\nno \\n escape")

    mut v5 := try toml.Decode("edge = \"\"\"a\"\"\"\"\n")
    testing.AssertEqStr(value.AsString(value.ObjectGet(v5, "edge")), "a\"")

    mut v6 := try toml.Decode("crlf = \"\"\"\r\nfirst\r\nsecond\r\n\"\"\"\r\n")
    testing.AssertEqStr(value.AsString(value.ObjectGet(v6, "crlf")), "first\nsecond\n")

    mut caught := Error {}
    try:
        toml.Decode("bad = \"\"\"never closed\n")
    catch e:
        caught = e
    end
    testing.AssertEqStr(caught.code, "toml.unterminated_string")
    testing.AssertFalse(toml.Valid("bad = '''never closed\n"))

    value.ValueFree(v)
    value.ValueFree(v2)
    value.ValueFree(v3)
    value.ValueFree(v4)
    value.ValueFree(v5)
    value.ValueFree(v6)

    ret testing.Summary()
end
