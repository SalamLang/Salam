import mem
import sync
import net.tcp
import net.transport

mut ready := sync.NewWaitGroup()
mut port := 0
mut want_n := 0
mut shared_l := transport.Listener {}
mut idle_result := 0
mut served := Vector {} as Vector<str>


func collect_server():
    repeat want_n:
        mut c := transport.Accept(shared_l)
        if transport.Ok(c):
            buf := mem.Allocate(64 as u64)
            n := transport.Read(c, buf, 64)
            transport.Write(c, buf, n)
            transport.Close(c)
            mem.Free(buf)
            served.Push("served")
        else:
            served.Push(c.err)
        end
    end
end

func slowloris_check():
    mut ss := transport.Settings {}
    ss.network = "ws"
    ss.path = "/slow"
    ss.handshake_timeout_ms = 1500
    l := transport.Listen(0, ss)
    p := transport.ListenerPort(l)
    slow := tcp.Dial("127.0.0.1", p)
    tcp.Write(slow, "GET /slow HTTP/1.1\r\nHost: x\r\n")
    shared_l = l
    want_n = 2
    t := spawn(collect_server)
    mut cs := transport.Settings {}
    cs.network = "ws"
    cs.path = "/slow"
    mut c := transport.Dial("127.0.0.1", p, cs)
    mut good := transport.Ok(c)
    if good:
        transport.Write(c, "ping" as void*, 4)
        back := mem.AllocateZeroed(8 as u64)
        good = transport.ReadFull(c, back, 4)
        mem.Free(back)
        transport.Close(c)
    end
    first := served.Len()
    join(t)
    println "slow client did not block a good one:", good, "served before the slow timeout:", first >= 1
    println "results:", served.Get(0), "/", served.Get(1)
    tcp.Close(slow)
    transport.CloseListener(l)
end

func flood_check():
    mut ss := transport.Settings {}
    ss.network = "ws"
    ss.handshake_timeout_ms = 1500
    ss.max_handshakes = 2
    l := transport.Listen(0, ss)
    p := transport.ListenerPort(l)
    shared_l = l
    want_n = 1
    t := spawn(collect_server)
    mut ready_c := transport.Dial("127.0.0.1", p, transport.Settings {})
    mut conns := Vector {} as Vector<tcp.Conn>
    repeat 5:
        conns.Push(tcp.Dial("127.0.0.1", p))
    end
    sync.SleepMs(300)
    mut dropped := 0
    repeat 5 in i:
        c := conns.Get(i)
        tcp.SetReadDeadline(c, 100)
        buf := mem.AllocateZeroed(16 as u64)
        n := tcp.ReadBytes(c, buf, 16)
        if n == 0:
            dropped++
        end
        mem.Free(buf)
        tcp.Close(c)
    end
    println "connections dropped over the handshake limit:", dropped >= 2
    if transport.Ok(ready_c):
        transport.Close(ready_c)
    end
    join(t)
    transport.CloseListener(l)
end

func idle_server():
    mut c := transport.Accept(shared_l)
    if transport.Ok(c):
        buf := mem.Allocate(16 as u64)
        n := transport.Read(c, buf, 16)
        idle_result = n
        mem.Free(buf)
        transport.Close(c)
    end
end

func idle_check():
    mut ss := transport.Settings {}
    ss.read_timeout_ms = 300
    ss.write_timeout_ms = 300
    idle_result = 99
    l := transport.Listen(0, ss)
    p := transport.ListenerPort(l)
    shared_l = l
    t := spawn(idle_server)
    mut c := transport.Dial("127.0.0.1", p, transport.Settings {})
    join(t)
    println "idle read ended without data:", idle_result <= 0
    transport.Close(c)
    transport.CloseListener(l)
end

func bind_check():
    plain := transport.Settings {}
    l := transport.Listen(0, plain)
    p := transport.ListenerPort(l)
    ok_lo := tcp.ConnOk(tcp.Dial("127.0.0.1", p))
    mut refused := true
    if SALAM_OS_LINUX:
        refused = not tcp.ConnOk(tcp.Dial("127.0.0.2", p))
    end
    println "default listener is loopback only:", ok_lo, refused
    transport.CloseListener(l)
    a := transport.ListenAll(0, plain)
    pa := transport.ListenerPort(a)
    mut open_all := true
    if SALAM_OS_LINUX:
        open_all = tcp.ConnOk(tcp.Dial("127.0.0.2", pa))
    end
    println "listen all accepts other addresses:", open_all
    transport.CloseListener(a)
    b := transport.ListenAt("127.0.0.1", 0, plain)
    println "listen at works:", transport.ListenerOk(b), transport.ListenerPort(b) > 0
    transport.CloseListener(b)
end

func main:
    bind_check()
    slowloris_check()
    flood_check()
    idle_check()
end
