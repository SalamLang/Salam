import mem
import net.transport

func main:
    l := transport.Listen(0, transport.Settings {})
    port := transport.ListenerPort(l)
    first := transport.Dial("127.0.0.1", port, transport.Settings {})
    mut second := transport.Dial("127.0.0.1", port, transport.Settings {})
    mut third := transport.Dial("127.0.0.1", port, transport.Settings {})
    mut a := transport.AcceptRaw(l)
    mut b := transport.AcceptRaw(l)
    mut c := transport.AcceptRaw(l)
    stream := transport.AsStream(first)
    stream.Close()
    stream.Close()
    println "first connection closed:", stream.Ok()
    mut reuse := transport.Dial("127.0.0.1", port, transport.Settings {})
    mut d := transport.AcceptRaw(l)
    stream.Close()
    stream.Close()
    msg := "still here"
    println "a closed stream closed again does not touch a newer connection:", transport.Write(reuse, msg as void*, msg.len())
    buf := mem.Allocate(32 as u64)
    n := transport.Read(d, buf, 32)
    println "the newer connection delivered", n, "bytes"
    mem.Free(buf)
    transport.Close(second)
    transport.Close(second)
    transport.Close(third)
    transport.Close(a)
    transport.Close(b)
    transport.Close(c)
    transport.Close(d)
    transport.Close(reuse)
    transport.CloseListener(l)
end
