import mem
import sync
import net.transport
import net.vless

const PUB := "IH8tyHx_SyHSCyaQgNTOvHYefAehmhpbMgkwFeAPnXY"
const PRIV := "QI3DpbA326sqI7QAAz13iSj6Jk9Q8UUvgkjlKZu2u2I"

mut ready := sync.NewWaitGroup()
mut port := 0
mut srv_settings := transport.Settings {}

func server():
    l := transport.Listen(0, srv_settings)
    port = transport.ListenerPort(l)
    sync.Done(ready)
    mut c := transport.Accept(l)
    if transport.Ok(c):
        buf := mem.Allocate(4096 as u64)
        n := transport.Read(c, buf, 4096)
        transport.Write(c, buf, n)
        transport.Close(c)
        mem.Free(buf)
    end
    transport.CloseListener(l)
end

func main:
    srv_settings.security = "reality"
    srv_settings.reality_server.private_key = PRIV
    srv_settings.reality_server.server_names = "front.example.com"
    srv_settings.reality_server.short_ids = "abcd1234"
    srv_settings.reality_server.dest = "127.0.0.1:1"
    sync.Add(ready, 1 as i64)
    t := spawn(server)
    sync.Wait(ready)
    mut cs := transport.Settings {}
    cs.security = "reality"
    cs.sni = "front.example.com"
    cs.reality.public_key = PUB
    cs.reality.short_id = "abcd1234"
    cs.reality.fingerprint = "chrome"
    mut c := transport.Dial("127.0.0.1", port, cs)
    mut good := transport.Ok(c)
    if good:
        transport.Write(c, "through reality" as void*, 15)
        back := mem.AllocateZeroed(32 as u64)
        good = transport.ReadFull(c, back, 15)
        transport.Close(c)
        mem.Free(back)
    end
    join(t)
    println "reality transport echo:", good

    l := vless.ParseLink("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h.example.com:443?encryption=none&security=reality&pbk=IH8tyHx_SyHSCyaQgNTOvHYefAehmhpbMgkwFeAPnXY&sid=abcd1234&spx=%2F&sni=front.example.com&fp=chrome&flow=xtls-rprx-vision&type=tcp#r")
    println "reality link:", l.ok, l.err, l.security, l.reality.public_key == PUB, l.reality.short_id, l.reality.fingerprint, l.flow
    s := vless.LinkSettings(l)
    println "reality settings:", s.security, s.reality.server_name, s.reality.short_id, s.tls
    again := vless.ParseLink(vless.FormatLink(l))
    println "reality round trip:", again.ok, again.reality.public_key == PUB, again.reality.short_id, again.sni, again.flow
    bad := vless.ParseLink("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h.example.com:443?security=reality&pbk=short&sid=ab")
    println "bad key refused:", bad.ok, bad.err
end
