import mem
import sync
import os
import conv
import net.tcp
import net.transport

if SALAM_OS_LINUX:
    extern:
        func setrlimit(res: int, lim: void*): int
        func getrlimit(res: int, lim: void*): int
    end
end

mut shared_l := transport.Listener {}

func open_fds(): int:
    ret os.ListDir("/proc/self/fd").Len()
end

func vm_pages(): i64:
    text := os.ReadFile("/proc/self/statm")
    mut n := 0
    until n < text.Len() and text.Substr(n, 1) != " ":
        n++
    end
    ret conv.ParseIntOr(text.Substr(0, n), 0 as i64)
end

func settle(want: int): int:
    mut left := 150
    until left > 0 and open_fds() > want:
        sync.SleepMs(100)
        left--
    end
    ret open_fds()
end

func drain():
    until true:
        mut c := transport.Accept(shared_l)
        if not transport.Ok(c):
            break
        end
        transport.Close(c)
    end
end

func main:
    mut ss := transport.Settings {}
    ss.network = "ws"
    ss.handshake_timeout_ms = 3000
    l := transport.Listen(0, ss)
    p := transport.ListenerPort(l)
    shared_l = l
    t := spawn(drain)
    sync.SleepMs(300)
    base := open_fds()
    mut cap := mem.AllocateZeroed(16 as u64) as u64*
    mut tight := false
    if SALAM_OS_LINUX:
        if getrlimit(9, cap as void*) == 0:
            old_cur := cap[0]
            old_max := cap[1]
            cap[0] = (vm_pages() * 4096 + 40000000) as u64
            tight = setrlimit(9, cap as void*) == 0
            mut conns := Vector {} as Vector<tcp.Conn>
            repeat 100:
                conns.Push(tcp.Dial("127.0.0.1", p))
            end
            sync.SleepMs(500)
            cap[0] = old_cur
            cap[1] = old_max
            setrlimit(9, cap as void*)
            repeat 100 in i:
                tcp.Close(conns.Get(i))
            end
            conns.Free()
            after := settle(base)
            println "address space was capped:", tight
            println "descriptors back to the baseline:", after <= base
        end
    else:
        println "address space was capped: true"
        println "descriptors back to the baseline: true"
    end
    mem.Free(cap as void*)
    transport.CloseListener(l)
    join(t)
end
