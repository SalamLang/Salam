import mem
import net.trojan
import net.tunnel
import compress

func text_of(p: void*, n: int): str:
    buf := mem.Allocate((n + 1) as u64)
    mem.Copy(buf, p, n as u64)
    (buf as u8*)[n] = 0 as u8
    ret buf as str
end

func main:
    conn := trojan.NewConnector("vpn.example.com", 443, "password")
    println conn.Name(), conn.Server().host, conn.Server().port

    pair := tunnel.NewPipe()
    a := tunnel.PipeA(pair)
    b := tunnel.PipeB(pair)
    println conn.Handshake(a, tunnel.NewAddr("example.com", 443))
    mut want := trojan.EncodeRequest("password", trojan.CmdConnect, "example.com", 443)
    buf := mem.Allocate(256 as u64)
    n := b.ReadBytes(buf, 256)
    println n, n == want.len, text_of(buf, n) == text_of(want.data, want.len)

    mut inb := trojan.NewInbound()
    trojan.InboundAddPassword(inb, "password")
    trojan.InboundAddPassword(inb, "other")
    println inb.Name()
    pair2 := tunnel.NewPipe()
    c := tunnel.PipeA(pair2)
    d := tunnel.PipeB(pair2)
    _w := d.Write(text_of(want.data, want.len) + "payload")
    sess := inb.Handshake(c)
    println sess.ok, sess.target.host, sess.target.port, sess.protocol, sess.command, sess.initial, sess.user.len()

    pair3 := tunnel.NewPipe()
    e := tunnel.PipeA(pair3)
    f := tunnel.PipeB(pair3)
    _w2 := f.Write("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    bad := inb.Handshake(e)
    println bad.ok, bad.error, bad.initial.len()

    pair4 := tunnel.NewPipe()
    g := tunnel.PipeA(pair4)
    h := tunnel.PipeB(pair4)
    wrong := trojan.EncodeRequest("nope", trojan.CmdConnect, "example.com", 443)
    _w3 := h.Write(text_of(wrong.data, wrong.len))
    bad2 := inb.Handshake(g)
    println bad2.ok, bad2.initial.len() == wrong.len
    compress.BufFree(want)
end
