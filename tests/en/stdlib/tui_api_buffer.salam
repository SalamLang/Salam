import tui

func main:
    mut buf := tui.NewBuffer(16, 5)
    buf.glyphs = tui.GlyphPolicy.Unicode
    area := buf.area()
    println "area", area.width, "x", area.height
    tui.DrawBorder(buf, area, tui.BorderStyle.Double, tui.StyleDefault, "box")
    buf.put_str(2, 1, "hi 中文", tui.Style { bold = true })
    buf.fill(tui.Rect { x = 2, y = 2, width = 5, height = 1 }, ".", tui.StyleDefault)
    buf.Set(9, 2, tui.Cell { ch = "*", style = tui.StyleDefault })
    tui.DrawBorderGlyphs(buf, tui.Rect { x = 10, y = 2, width = 5, height = 3 }, tui.GlyphsRounded(), tui.StyleDefault, "")
    repeat buf.height in y:
        println buf.row_text(y)
    end
    println "cell 2,1:", buf.Get(2, 1).ch, "wide head:", buf.Get(5, 1).ch
    println "frame bytes:", buf.ansi().Len() > 0, "changes:", buf.diff().Len() > 0
    buf.commit()
    println "after commit:", buf.diff().Len()
    buf.Clear()
    buf.resize(4, 1)
    println "resized", buf.width, buf.height, "full repaint:", buf.force_full
    println "glyph sets:", tui.GlyphsSingle().h, tui.GlyphsDouble().h, tui.GlyphsHeavy().h, tui.GlyphsASCII().h, tui.GlyphsMixed().tl
    println "ascii fallback:", tui.GlyphsFor(tui.BorderStyle.Rounded, tui.GlyphPolicy.ASCII).tl
    println "policy from env:", tui.DetectGlyphPolicy() == tui.DetectGlyphPolicy()
    _ := buf.focused
    _ := buf.clip
    buf.Free()
end
