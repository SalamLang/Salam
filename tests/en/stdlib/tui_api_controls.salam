import str
import term
import tui

mut submitted := ""
mut picked := -1
mut pressed := 0
mut toggled := false

func key(seq: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(seq) }
end

func main:
    mut buf := tui.NewBuffer(24, 5)

    mut pass := tui.NewInput()
    pass.masked = true
    pass.mask_glyph = "*"
    pass.max_length = 8
    pass.filter = (candidate: str): ret not str.Contains(candidate, " ") end
    pass.on_submit = (v: str):
        submitted = v
        ret true
    end
    pass.set_placeholder("password")
    pass.set_value("")
    pass.style = tui.StyleDefault
    pass.cursor_style = tui.Style { reverse = true }
    pass.placeholder_style = tui.Style { dim = true }
    pass.SetBounds(tui.Rect { x = 0, y = 0, width = 12, height = 1 })
    each c in ["s", " ", "e", "c"]:
        _ := pass.HandleEvent(key(c))
    end
    _ := pass.HandleEvent(key("\r"))
    println "input focusable:", pass.Focusable(), "value:", pass.Value(), "submitted:", submitted

    mut ok := tui.NewButton("OK")
    ok.on_click = (): pressed++ end
    ok.focus_style = tui.Style { bold = true }
    ok.style = tui.StyleDefault
    ok.disabled = false
    ok.SetBounds(tui.Rect { x = 0, y = 1, width = 8, height = 1 })
    _ := ok.HandleEvent(key(" "))
    println "button:", ok.label, ok.Focusable(), ok.Hits(), "pressed", pressed, "width", ok.PreferredSize(20).width

    mut wrap := tui.NewCheckbox("Wrap lines", false)
    wrap.on_toggle = (v: bool): toggled = v end
    wrap.box_style = tui.StyleDefault
    wrap.label_style = tui.StyleDefault
    wrap.disabled = false
    wrap.SetBounds(tui.Rect { x = 0, y = 2, width = 14, height = 1 })
    _ := wrap.HandleEvent(key(" "))
    wrap.set_checked(wrap.checked())
    println "checkbox:", wrap.label, wrap.checked(), toggled, wrap.Focusable(), wrap.Hits(), wrap.PreferredSize(20).width

    mut items := Vector {} as Vector<str>
    items.Push("red")
    items.Push("green")
    mut colors := tui.NewList(items)
    colors.on_select = (i: int): picked = i end
    colors.style = tui.StyleDefault
    colors.selected_style = tui.Style { reverse = true }
    colors.selected_unfocused_style = tui.Style { underline = true }
    colors.SetBounds(tui.Rect { x = 14, y = 0, width = 8, height = 2 })
    _ := colors.HandleEvent(key("j"))
    _ := colors.HandleEvent(key("\r"))
    println "list:", colors.selected_index(), colors.selected_item(), picked, colors.Focusable()

    pass.Render(buf, pass.Bounds())
    ok.Render(buf, ok.Bounds())
    wrap.Render(buf, wrap.Bounds())
    colors.Render(buf, colors.Bounds())
    repeat buf.height in y:
        println "|" + buf.row_text(y) + "|"
    end
    buf.Free()
end
