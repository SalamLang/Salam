import tui

mut calls := 0

func main:
    mut t := tui.NewText("first")
    t.set_text("second")
    println t.content
    t.set_source(():
        calls++
        ret "count " + calls
    end)
    mut buf := tui.NewBuffer(10, 1)
    t.SetBounds(tui.Rect { width = 10, height = 1 })
    t.Render(buf, t.Bounds())
    println buf.row_text(0)
    t.clear_source()
    buf.Clear()
    t.Render(buf, t.Bounds())
    println buf.row_text(0)
    buf.commit()
    buf.flush()
    buf.Free()

    mut g := tui.NewGrid(2, 2)
    i := g.Add(tui.BaseWidget {} as dyn tui.Widget)
    g.set_span(i, 2, 1)
    println "span", g.items.Get(i).row_span, g.items.Get(i).col_span

    mut s := tui.NewTerminalScreen(tui.BaseWidget {})
    println "screen fits buffer:", s.root.Bounds().width == s.buffer.width
    s.Close()
end
