import tui

struct Box:
    pub use tui.BaseWidget
    pub mark: str = "#"

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        buf.fill(bounds, this.mark, tui.StyleDefault)
    end
end

func box(mark: str): dyn tui.Widget:
    ret Box { mark = mark } as dyn tui.Widget
end

func size(kind: tui.SizeKind, cells: int, weight: int): tui.LayoutSize:
    ret tui.LayoutSize { kind = kind, cells = cells, weight = weight }
end

func main:
    a := box("a")
    b := box("b")
    c := box("c")
    d := box("d")
    e := box("e")
    f := box("f")

    mut top := tui.NewRow()
    top.set_gap(1)
    ia := top.add(a)
    ib := top.add(b)
    top.set_width(ia, size(tui.SizeKind.Fixed, 4, 0))
    top.set_width(ib, size(tui.SizeKind.Fill, 0, 1))
    toprow := top as dyn tui.Widget

    mut grid := tui.NewGrid(1, 2)
    ic := grid.add(c)
    id := grid.add(d)
    grid.set_cell(ic, 0, 0)
    grid.set_cell(id, 0, 1)
    gridw := grid as dyn tui.Widget

    mut stack := tui.NewStack()
    ie := stack.add(e)
    if2 := stack.add(f)
    stack.set_margin(if2, tui.NewInsets(0, 2, 0, 2))
    stack.set_align(ie, tui.CrossAlign.Stretch, tui.CrossAlign.Stretch)
    stackw := stack as dyn tui.Widget

    mut col := tui.NewColumn()
    col.set_padding(tui.UniformInsets(1))
    i1 := col.add(toprow)
    i2 := col.add(gridw)
    i3 := col.add(stackw)
    col.set_height(i1, size(tui.SizeKind.Fixed, 1, 0))
    col.set_height(i2, size(tui.SizeKind.Fixed, 2, 0))
    col.set_height(i3, size(tui.SizeKind.Fill, 0, 1))

    mut s := tui.NewScreen(col as dyn tui.Widget, 20, 8)
    defer s.close()
    each w in [toprow, a, b, gridw, c, d, stackw, e, f]:
        _ := s.add(tui.RootId, w)
    end
    s.draw()
    repeat s.buffer.height in y:
        println "|" + s.buffer.row_text(y) + "|"
    end

    mut sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(size(tui.SizeKind.Fixed, 3, 0))
    sizes.push(size(tui.SizeKind.Fill, 0, 2))
    sizes.push(size(tui.SizeKind.Pref, 0, 1))
    split := tui.SplitMain(12, sizes, 0)
    println "split 12:", split.get(0), split.get(1), split.get(2)
    tracks := tui.TrackSizes(10, 3)
    println "tracks 10/3:", tracks.get(0), tracks.get(1), tracks.get(2)
    inner := tui.InsetRect(tui.Rect { width = 10, height = 4 }, tui.NewInsets(1, 2, 1, 2))
    println "inset:", inner.x, inner.y, inner.width, inner.height
    fit := tui.FitRect(tui.Rect { x = 8, y = 0, width = 6, height = 2 }, tui.Rect { width = 10, height = 4 })
    println "fit:", fit.x, fit.width
    println "place:", tui.PlaceAxisSize(10, tui.CrossAlign.Center, 4), tui.PlaceAxisOffset(10, tui.CrossAlign.End, 4)
    m := tui.Measure { ok = true, extent = 3 }
    println "measure:", m.ok, m.extent, tui.Axis.X != tui.Axis.Y
    slot := col.items.get(1)
    println "slot span:", slot.row_span, slot.col_span, "rows/cols:", grid.rows, grid.cols, "gap:", top.gap, "pad:", col.pad.top
end
