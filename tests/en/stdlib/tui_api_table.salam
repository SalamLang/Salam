import term
import tui

func row(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    ret v
end

func main:
    mut t := tui.NewTable()
    _ := t.add_column(tui.TableColumn {})
    _ := t.add_column(tui.TableColumn {})
    t.set_column_width(0, tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 9 })
    t.set_column_align(1, tui.Alignment.Right)
    t.set_column_overflow(0, tui.CellOverflow.Ellipsis)
    t.set_pad_x(1)
    t.header = true
    t.rule = true
    t.header_style = tui.Style { bold = true }
    _ := t.add_row(row("Package", "Size"))
    _ := t.add_row(row("tui", "8956"))
    _ := t.add_row(row("os.signal", "976"))
    _ := t.add_row(row("encoding.json", "3100"))
    t.set_cell_align(3, 1, tui.Alignment.Left)
    pref := t.preferred_size(40)
    println "preferred height", pref.height
    mut buf := tui.NewBuffer(20, pref.height)
    t.set_bounds(buf.area())
    t.render(buf, buf.area())
    repeat buf.height in y:
        println "|" + buf.row_text(y) + "|"
    end
    println "columns", t.columns.Len(), "rows", t.rows.Len(), "focusable", t.focusable()
    buf.free()

    mut v := tui.NewTableView()
    _ := v.add_column(tui.TableColumn { width = tui.LayoutSize { kind = tui.SizeKind.Fill, weight = 1 }, overflow = tui.CellOverflow.Clip })
    repeat 10 in i:
        mut one := Vector {} as Vector<str>
        one.push("line " + i)
        _ := v.add_row(one)
    end
    v.set_bounds(tui.Rect { width = 12, height = 3 })
    down := tui.Event { kind = tui.KeyEvent, key = term.Key { code = term.KeyDown } }
    repeat 4:
        _ := v.handle_event(down)
    end
    println "selected", v.selected, "first visible", v.offset
end
