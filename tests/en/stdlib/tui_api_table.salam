import term
import tui

func row(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push(a)
    v.Push(b)
    ret v
end

func main:
    mut t := tui.NewTable()
    _ := t.AddColumn(tui.TableColumn {})
    _ := t.AddColumn(tui.TableColumn {})
    t.SetColumnWidth(0, tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 9 })
    t.SetColumnAlign(1, tui.Alignment.Right)
    t.SetColumnOverflow(0, tui.CellOverflow.Ellipsis)
    t.SetPadX(1)
    t.header = true
    t.rule = true
    t.header_style = tui.Style { bold = true }
    _ := t.AddRow(row("Package", "Size"))
    _ := t.AddRow(row("tui", "8956"))
    _ := t.AddRow(row("os.signal", "976"))
    _ := t.AddRow(row("encoding.json", "3100"))
    t.SetCellAlign(3, 1, tui.Alignment.Left)
    pref := t.PreferredSize(40)
    println "preferred height", pref.height
    mut buf := tui.NewBuffer(20, pref.height)
    t.SetBounds(buf.Area())
    t.Render(buf, buf.Area())
    repeat buf.height in y:
        println "|" + buf.RowText(y) + "|"
    end
    println "columns", t.columns.Len(), "rows", t.rows.Len(), "focusable", t.Focusable()
    buf.Free()

    mut v := tui.NewTableView()
    _ := v.AddColumn(tui.TableColumn { width = tui.LayoutSize { kind = tui.SizeKind.Fill, weight = 1 }, overflow = tui.CellOverflow.Clip })
    repeat 10 in i:
        mut one := Vector {} as Vector<str>
        one.Push("line " + i)
        _ := v.AddRow(one)
    end
    v.SetBounds(tui.Rect { width = 12, height = 3 })
    down := tui.Event { kind = tui.KeyEvent, key = term.Key { code = term.KeyDown } }
    repeat 4:
        _ := v.HandleEvent(down)
    end
    println "selected", v.selected, "first visible", v.offset
end
