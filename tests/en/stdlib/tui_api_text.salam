import tui

func main:
    lines := tui.WrapText("terminal user interfaces in Salam", 12)
    each line in lines:
        println "[" + line + "]"
    end
    size := tui.MeasureText("two\nlines", 20)
    println "measured", size.width, "x", size.height

    mut buf := tui.NewBuffer(20, 4)
    mut title := tui.NewText("centered")
    title.set_align(tui.Alignment.Center)
    title.set_style(tui.Style { bold = true })
    title.set_bounds(tui.Rect { x = 0, y = 0, width = 20, height = 1 })
    title.render(buf, title.bounds())
    mut rule := tui.NewSeparator()
    rule.set_bounds(tui.Rect { x = 0, y = 1, width = 20, height = 1 })
    rule.render(buf, rule.bounds())
    mut bar := tui.NewProgress()
    bar.set_max(200)
    bar.set_progress(50)
    bar.set_bounds(tui.Rect { x = 0, y = 2, width = 20, height = 1 })
    bar.render(buf, bar.bounds())
    mut long := tui.NewText("no wrap here at all")
    long.set_wrap(tui.WrapMode.None)
    long.set_bounds(tui.Rect { x = 0, y = 3, width = 10, height = 1 })
    buf.clip = long.bounds()
    long.render(buf, long.bounds())
    buf.clip = buf.area()
    repeat buf.height in y:
        println "|" + buf.row_text(y) + "|"
    end
    println "progress", bar.progress(), "preferred width", title.preferred_width()
    buf.free()
end
