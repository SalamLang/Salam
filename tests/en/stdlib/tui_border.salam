import env
import term
import testing
import tui

func test_single_box():
    mut b := tui.NewBuffer(8, 3)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 8, height = 3 }, tui.BorderStyle.Single, tui.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "┌──────┐")
    testing.AssertEqStr(b.row_text(1), "│      │")
    testing.AssertEqStr(b.row_text(2), "└──────┘")
    b.Free()
end

func test_double_box():
    mut b := tui.NewBuffer(8, 3)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 8, height = 3 }, tui.BorderStyle.Double, tui.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "╔══════╗")
    testing.AssertEqStr(b.row_text(1), "║      ║")
    testing.AssertEqStr(b.row_text(2), "╚══════╝")
    b.Free()
end

func test_rounded_box():
    mut b := tui.NewBuffer(8, 3)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 8, height = 3 }, tui.BorderStyle.Rounded, tui.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "╭──────╮")
    testing.AssertEqStr(b.row_text(1), "│      │")
    testing.AssertEqStr(b.row_text(2), "╰──────╯")
    b.Free()
end

func test_single_writes_eighteen_cells():
    mut b := tui.NewBuffer(8, 3)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 8, height = 3 }, tui.BorderStyle.Single, tui.Style {}, "")
    mut drawn := 0
    repeat 3 in y:
        repeat 8 in x:
            if b.get(x, y).ch != " ":
                drawn++
            end
        end
    end
    testing.AssertEqInt(drawn, 18)
    b.Free()
end

func test_none_is_noop():
    mut b := tui.NewBuffer(8, 3)
    b.fill(tui.Rect { x = 0, y = 0, width = 8, height = 3 }, "x", tui.StyleDefault)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 8, height = 3 }, tui.BorderStyle.None, tui.Style {}, "Title")
    testing.AssertEqStr(b.row_text(0), "xxxxxxxx")
    testing.AssertEqStr(b.row_text(2), "xxxxxxxx")
    b.Free()
end

func test_interior_untouched():
    mut b := tui.NewBuffer(8, 3)
    b.fill(tui.Rect { x = 0, y = 0, width = 8, height = 3 }, "x", tui.StyleDefault)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 8, height = 3 }, tui.BorderStyle.Single, tui.Style {}, "")
    testing.AssertEqStr(b.row_text(1), "│xxxxxx│")
    b.Free()
end

func test_title_exact_fit():
    mut b := tui.NewBuffer(10, 2)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 10, height = 2 }, tui.BorderStyle.Single, tui.Style {}, "Files")
    testing.AssertEqStr(b.row_text(0), "┌─ Files ┐")
    b.Free()
end

func test_title_truncates_right():
    mut b := tui.NewBuffer(10, 2)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 10, height = 2 }, tui.BorderStyle.Single, tui.Style {}, "Playback")
    testing.AssertEqStr(b.row_text(0), "┌─ Playb ┐")
    b.Free()
end

func test_title_truncates_long_name():
    mut b := tui.NewBuffer(13, 2)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 13, height = 2 }, tui.BorderStyle.Single, tui.Style {}, "nightly-build.log")
    testing.AssertEqStr(b.row_text(0), "┌─ nightly- ┐")
    b.Free()
end

func test_title_clips_on_cells():
    mut b := tui.NewBuffer(10, 2)
    defer b.Free()
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 10, height = 2 }, tui.BorderStyle.Single, tui.Style {}, "标题长")
    testing.AssertEqStr(b.row_text(0), "┌─ 标题 ─┐")
    testing.AssertEqInt(b.width, 10)
    testing.AssertEqStr(b.get(9, 0).ch, "┐")
end

func test_title_one_char_at_minimum_width():
