    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 2, height = 2 }, tui.BorderStyle.Single, tui.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "┌┐")
    testing.AssertEqStr(b.row_text(1), "└┘")
    b.Free()
end

