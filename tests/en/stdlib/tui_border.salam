func test_empty_rects_write_nothing():
    mut b := tui.NewBuffer(4, 2)
    b.fill(tui.Rect { x = 0, y = 0, width = 4, height = 2 }, "x", tui.StyleDefault)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 0, height = 2 }, tui.BorderStyle.Single, tui.Style {}, "")
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 2, height = 0 }, tui.BorderStyle.Single, tui.Style {}, "")
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = -1, height = 3 }, tui.BorderStyle.Single, tui.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "xxxx")
    testing.AssertEqStr(b.row_text(1), "xxxx")
    b.Free()
end

func test_clip_never_shifts():
    mut b := tui.NewBuffer(10, 3)
    tui.DrawBorder(b, tui.Rect { x = 6, y = 0, width = 8, height = 3 }, tui.BorderStyle.Single, tui.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "      ┌───")
    testing.AssertEqStr(b.row_text(1), "      │   ")
    testing.AssertEqStr(b.row_text(2), "      └───")
    b.Free()
end

func test_color_is_fg_only():
    mut b := tui.NewBuffer(8, 3)
    style := tui.Style { fg = tui.Color.Ansi(1), bold = true, italic = true }
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 8, height = 3 }, tui.BorderStyle.Single, style, "Title")
    want := tui.Style { fg = tui.Color.Ansi(1) }
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, want))
    testing.AssertTrue(tui.StyleEq(b.get(3, 0).style, want))
    testing.AssertTrue(tui.StyleEq(b.get(7, 2).style, want))
    b.Free()
end

func test_default_fg_writes_no_style():
    mut b := tui.NewBuffer(8, 3)
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 8, height = 3 }, tui.BorderStyle.Single, tui.Style {}, "")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.StyleDefault))
    b.Free()
end

func test_tier_lowers_frame_color():
    mut b := tui.NewBuffer(4, 3)
    defer b.Free()
    b.tier = tui.ColorTier.Ansi16
    style := tui.Style { fg = tui.Color.Rgb(255, 0, 0) }
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 4, height = 3 }, tui.BorderStyle.Single, style, "")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, style))
    testing.AssertTrue(tui.StyleEq(b.get(3, 0).style, style))
    testing.AssertTrue(tui.StyleEq(b.get(0, 2).style, style))
    seq_on := tui.StyleSgr(style, tui.ColorTier.Ansi16)
    seq_off := tui.StyleSgrOff(style, tui.ColorTier.Ansi16)
    want := term.SeqMoveTo(1, 1) + seq_on + "┌──┐" + term.SeqMoveTo(2, 1) + "│" + seq_off + "  " + seq_on + "│" + term.SeqMoveTo(3, 1) + "└──┘" + seq_off
    testing.AssertEqStr(b.ansi(), want)
    testing.AssertTrue(seq_on != tui.StyleSgr(style, tui.ColorTier.TrueColor))
end

func test_tier_off_drops_frame_color_keeps_shape():
    mut b := tui.NewBuffer(4, 3)
    defer b.Free()
    b.tier = tui.ColorTier.Off
    style := tui.Style { fg = tui.Color.Rgb(255, 0, 0) }
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 4, height = 3 }, tui.BorderStyle.Single, style, "")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, style))
    testing.AssertTrue(tui.StyleEq(b.get(1, 1).style, tui.StyleDefault))
    testing.AssertEqStr(b.row_text(0), "┌──┐")
    testing.AssertEqStr(b.row_text(1), "│  │")
    testing.AssertEqStr(b.row_text(2), "└──┘")
    want := term.SeqMoveTo(1, 1) + "┌──┐" + term.SeqMoveTo(2, 1) + "│  │" + term.SeqMoveTo(3, 1) + "└──┘"
    testing.AssertEqStr(b.ansi(), want)
end

func test_tier_never_changes_glyphs():
    mut full := tui.NewBuffer(4, 3)
    defer full.Free()
    mut low := tui.NewBuffer(4, 3)
    defer low.Free()
    low.tier = tui.ColorTier.Ansi16
    mut off := tui.NewBuffer(4, 3)
    defer off.Free()
    off.tier = tui.ColorTier.Off
    style := tui.Style { fg = tui.Color.Rgb(255, 0, 0) }
    tui.DrawBorder(full, tui.Rect { x = 0, y = 0, width = 4, height = 3 }, tui.BorderStyle.Single, style, "")
    tui.DrawBorder(low, tui.Rect { x = 0, y = 0, width = 4, height = 3 }, tui.BorderStyle.Single, style, "")
    tui.DrawBorder(off, tui.Rect { x = 0, y = 0, width = 4, height = 3 }, tui.BorderStyle.Single, style, "")
    repeat 3 in y:
        testing.AssertEqStr(low.row_text(y), full.row_text(y))
        testing.AssertEqStr(off.row_text(y), full.row_text(y))
    end
end

func ring(g: tui.BorderGlyphs, policy: tui.GlyphPolicy): str:
    mut b := tui.NewBuffer(6, 3)
    b.glyphs = policy
    tui.DrawBorderGlyphs(b, tui.Rect { x = 0, y = 0, width = 6, height = 3 }, g, tui.Style {}, "")
    out := b.row_text(0) + "/" + b.row_text(1) + "/" + b.row_text(2)
    b.Free()
    ret out
end

func test_glyph_set_rings():
    u := tui.GlyphPolicy.Unicode
    testing.AssertEqStr(ring(tui.GlyphsSingle(), u), "┌────┐/│    │/└────┘")
    testing.AssertEqStr(ring(tui.GlyphsDouble(), u), "╔════╗/║    ║/╚════╝")
    testing.AssertEqStr(ring(tui.GlyphsRounded(), u), "╭────╮/│    │/╰────╯")
    testing.AssertEqStr(ring(tui.GlyphsASCII(), u), "+----+/|    |/+----+")
    testing.AssertEqStr(ring(tui.GlyphsHeavy(), u), "┏━━━━┓/┃    ┃/┗━━━━┛")
    testing.AssertEqStr(ring(tui.GlyphsMixed(), u), "┍━━━━┑/│    │/┕━━━━┙")
end

func joined(g: tui.BorderGlyphs): str:
    ret g.t_down + g.t_up + g.t_right + g.t_left + g.cross
end

func test_glyph_set_junctions_and_weights():
    testing.AssertEqStr(joined(tui.GlyphsSingle()), "┬┴├┤┼")
    testing.AssertEqStr(joined(tui.GlyphsDouble()), "╦╩╠╣╬")
    testing.AssertEqStr(joined(tui.GlyphsRounded()), "┬┴├┤┼")
    testing.AssertEqStr(joined(tui.GlyphsASCII()), "+++++")
    testing.AssertEqStr(joined(tui.GlyphsHeavy()), "┳┻┣┫╋")
    testing.AssertEqStr(joined(tui.GlyphsMixed()), "┯┷┝┥┿")
    testing.AssertTrue(tui.GlyphsSingle().hw == tui.Weight.Light and tui.GlyphsSingle().vw == tui.Weight.Light)
    testing.AssertTrue(tui.GlyphsRounded().hw == tui.Weight.Light and tui.GlyphsASCII().vw == tui.Weight.Light)
    testing.AssertTrue(tui.GlyphsDouble().hw == tui.Weight.Double and tui.GlyphsDouble().vw == tui.Weight.Double)
    testing.AssertTrue(tui.GlyphsHeavy().hw == tui.Weight.Heavy and tui.GlyphsHeavy().vw == tui.Weight.Heavy)
    testing.AssertTrue(tui.GlyphsMixed().hw == tui.Weight.Heavy and tui.GlyphsMixed().vw == tui.Weight.Light)
end

func test_glyphs_for_selects_by_style_and_policy():
    u := tui.GlyphPolicy.Unicode
    a := tui.GlyphPolicy.ASCII
    testing.AssertEqStr(tui.GlyphsFor(tui.BorderStyle.Single, u).tl, "┌")
    testing.AssertEqStr(tui.GlyphsFor(tui.BorderStyle.Double, u).tl, "╔")
    testing.AssertEqStr(tui.GlyphsFor(tui.BorderStyle.Rounded, u).tl, "╭")
    testing.AssertEqStr(tui.GlyphsFor(tui.BorderStyle.None, u).tl, "")
    testing.AssertEqStr(tui.GlyphsFor(tui.BorderStyle.None, a).h, "")
    testing.AssertEqStr(tui.GlyphsFor(tui.BorderStyle.Single, a).tl, "+")
    testing.AssertEqStr(tui.GlyphsFor(tui.BorderStyle.Double, a).h, "-")
    testing.AssertEqStr(tui.GlyphsFor(tui.BorderStyle.Rounded, a).v, "|")
end

func test_border_inset_unchanged():
    testing.AssertEqInt(tui.BorderInset(tui.BorderStyle.None), 0)
    testing.AssertEqInt(tui.BorderInset(tui.BorderStyle.Single), 1)
    testing.AssertEqInt(tui.BorderInset(tui.BorderStyle.Double), 1)
    testing.AssertEqInt(tui.BorderInset(tui.BorderStyle.Rounded), 1)
end

func test_custom_glyphs_through_draw_border_glyphs():
    g := tui.BorderGlyphs { h = "~", v = "!", tl = "1", tr = "2", bl = "3", br = "4" }
    testing.AssertEqStr(ring(g, tui.GlyphPolicy.Unicode), "1~~~~2/!    !/3~~~~4")
end

func test_ascii_policy_overrides_every_style_and_custom_set():
    a := tui.GlyphPolicy.ASCII
    want := "+----+/|    |/+----+"
    custom := tui.BorderGlyphs { h = "~", v = "!", tl = "1", tr = "2", bl = "3", br = "4" }
    testing.AssertEqStr(ring(custom, a), want)
    testing.AssertEqStr(ring(tui.GlyphsHeavy(), a), want)
    mut styles := Vector {} as Vector<tui.BorderStyle>
    styles.push(tui.BorderStyle.Single)
    styles.push(tui.BorderStyle.Double)
    styles.push(tui.BorderStyle.Rounded)
    repeat styles.Len() in i:
        mut b := tui.NewBuffer(6, 3)
        b.glyphs = a
        tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 6, height = 3 }, styles.get(i), tui.Style {}, "")
        testing.AssertEqStr(b.row_text(0), "+----+")
        testing.AssertEqStr(b.row_text(1), "|    |")
        testing.AssertEqStr(b.row_text(2), "+----+")
        b.Free()
    end
end

func test_ascii_policy_title_and_degenerate_rects():
    mut b := tui.NewBuffer(10, 2)
    b.glyphs = tui.GlyphPolicy.ASCII
    tui.DrawBorder(b, tui.Rect { x = 0, y = 0, width = 10, height = 2 }, tui.BorderStyle.Double, tui.Style {}, "Hi")
    testing.AssertEqStr(b.row_text(0), "+- Hi ---+")
    testing.AssertEqStr(b.row_text(1), "+--------+")
    b.Free()
    mut h := tui.NewBuffer(5, 1)
    h.glyphs = tui.GlyphPolicy.ASCII
    tui.DrawBorder(h, tui.Rect { x = 0, y = 0, width = 5, height = 1 }, tui.BorderStyle.Single, tui.Style {}, "")
    testing.AssertEqStr(h.row_text(0), "-----")
    h.Free()
    mut v := tui.NewBuffer(1, 3)
    v.glyphs = tui.GlyphPolicy.ASCII
    tui.DrawBorder(v, tui.Rect { x = 0, y = 0, width = 1, height = 3 }, tui.BorderStyle.Single, tui.Style {}, "")
    testing.AssertEqStr(v.row_text(0) + v.row_text(1) + v.row_text(2), "|||")
    v.Free()
end

func test_detect_glyph_policy_precedence():
    env.Unset("SALAM_TUI_GLYPHS")
    env.Unset("LC_ALL")
    env.Unset("LC_CTYPE")
    env.Unset("LANG")
    env.Set("TERM", "xterm")
    testing.AssertTrue(tui.DetectGlyphPolicy() == tui.GlyphPolicy.Unicode)
    env.Set("SALAM_TUI_GLYPHS", "ascii")
    testing.AssertTrue(tui.DetectGlyphPolicy() == tui.GlyphPolicy.ASCII)
    env.Set("TERM", "dumb")
    env.Set("SALAM_TUI_GLYPHS", "unicode")
    testing.AssertTrue(tui.DetectGlyphPolicy() == tui.GlyphPolicy.Unicode)
    env.Unset("SALAM_TUI_GLYPHS")
    testing.AssertTrue(tui.DetectGlyphPolicy() == tui.GlyphPolicy.ASCII)
    env.Set("TERM", "xterm")
    env.Set("LANG", "C")
    testing.AssertTrue(tui.DetectGlyphPolicy() == tui.GlyphPolicy.ASCII)
    env.Set("LANG", "en_US.UTF-8")
    testing.AssertTrue(tui.DetectGlyphPolicy() == tui.GlyphPolicy.Unicode)
    env.Set("LC_ALL", "POSIX")
    testing.AssertTrue(tui.DetectGlyphPolicy() == tui.GlyphPolicy.ASCII)
    env.Unset("LC_ALL")
    env.Unset("LANG")
end

func test_buffer_glyphs_default_and_copy():
    mut b := tui.NewBuffer(2, 2)
    testing.AssertTrue(b.glyphs == tui.GlyphPolicy.Unicode)
    b.glyphs = tui.GlyphPolicy.ASCII
    c := b
    testing.AssertTrue(c.glyphs == tui.GlyphPolicy.ASCII)
    b.resize(3, 3)
    testing.AssertTrue(b.glyphs == tui.GlyphPolicy.ASCII)
    b.Free()
end

func main:
    test_single_box()
    test_double_box()
    test_rounded_box()
    test_single_writes_eighteen_cells()
    test_none_is_noop()
    test_interior_untouched()
    test_title_exact_fit()
    test_title_truncates_right()
    test_title_truncates_long_name()
    test_title_clips_on_cells()
    test_title_one_char_at_minimum_width()
    test_title_dropped_below_minimum_width()
    test_title_blank_is_absent()
    test_title_trimmed()
    test_height_one_is_horizontal_rule()
    test_one_by_one_is_horizontal_glyph()
    test_width_one_is_vertical_rule()
    test_two_by_two_has_corners_only()
    test_two_by_three_has_vertical_edges()
    test_three_by_two_has_horizontal_edges()
    test_empty_rects_write_nothing()
    test_clip_never_shifts()
    test_color_is_fg_only()
    test_default_fg_writes_no_style()
    test_tier_lowers_frame_color()
    test_tier_off_drops_frame_color_keeps_shape()
    test_tier_never_changes_glyphs()
    test_glyph_set_rings()
    test_glyph_set_junctions_and_weights()
    test_glyphs_for_selects_by_style_and_policy()
    test_border_inset_unchanged()
    test_custom_glyphs_through_draw_border_glyphs()
    test_ascii_policy_overrides_every_style_and_custom_set()
    test_ascii_policy_title_and_degenerate_rects()
    test_detect_glyph_policy_precedence()
    test_buffer_glyphs_default_and_copy()
    ret testing.Summary()
end
