import mem
import testing
import term
import tui

mut visits := Vector {} as Vector<str>

mut vanished := false

struct Tile:
    pub use tui.BaseWidget
    pub name: str = ""
    pub keys: int = 0

    pub func focusable(): bool:
        ret true
    end

    pub func handle_event(event: tui.Event): bool:
        visits.push(this.name)
        if event.is_char("k"):
            this.keys++
            ret true
        end
        ret false
    end

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        mut mark := " "
        if buf.focused:
            mark = "*"
        end
        buf.put_str(bounds.x, bounds.y, mark + this.name + this.keys, tui.StyleDefault)
    end
end

struct Shutter:
    pub use tui.BaseWidget
    pub shown: bool = true

    pub func visible(): bool:
        ret this.shown
    end
end

struct HiddenTile:
    pub use tui.BaseWidget

    pub func focusable(): bool:
        ret true
    end

    pub func visible(): bool:
        ret false
    end
end

struct Vanisher:
    pub use tui.BaseWidget

    pub func focusable(): bool:
        ret true
    end

    pub func visible(): bool:
        ret not vanished
    end
end

struct Toggle:
    pub use tui.BaseWidget
    pub live: bool* = null

    pub func focusable(): bool:
        ret this.live[0]
    end
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func trail(): str:
    mut out := ""
    each i, v in visits:
        if i > 0:
            out += ">"
        end
        out += v
    end
    visits.clear()
    ret out
end

func test_nearest_picks_smallest_gap():
    from := rect(0, 0, 4, 2)
    mut cs := Vector {} as Vector<tui.Rect>
    defer cs.Free()
    cs.push(rect(10, 0, 2, 2))
    cs.push(rect(6, 0, 2, 2))
    cs.push(rect(20, 0, 2, 2))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirRight), 1)
end

func test_nearest_requires_perpendicular_overlap():
    from := rect(0, 0, 4, 2)
    mut cs := Vector {} as Vector<tui.Rect>
    defer cs.Free()
    cs.push(rect(5, 2, 2, 2))
    cs.push(rect(4, 2, 1, 1))
    cs.push(rect(30, 1, 2, 5))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirRight), 2)
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirUp), -1)
end

func test_nearest_requires_lying_beyond_the_edge():
    from := rect(0, 0, 4, 2)
    mut cs := Vector {} as Vector<tui.Rect>
    defer cs.Free()
    cs.push(rect(3, 0, 4, 2))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirRight), -1)
    cs.push(rect(4, 1, 1, 1))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirRight), 1)
end

func test_nearest_tie_break_by_alignment():
    from := rect(0, 4, 4, 2)
    mut cs := Vector {} as Vector<tui.Rect>
    defer cs.Free()
    cs.push(rect(6, 0, 2, 6))
    cs.push(rect(6, 4, 2, 3))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirRight), 1)
end

func test_nearest_half_cell_alignment_is_exact():
    from := rect(0, 0, 2, 3)
    mut cs := Vector {} as Vector<tui.Rect>
    defer cs.Free()
    cs.push(rect(4, 1, 1, 2))
    cs.push(rect(4, 0, 1, 2))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirRight), 0)
end

func test_nearest_full_tie_keeps_earliest():
    from := rect(4, 4, 2, 2)
    mut cs := Vector {} as Vector<tui.Rect>
    defer cs.Free()
    cs.push(rect(0, 0, 0, 0))
    cs.push(rect(4, 0, 2, 2))
    cs.push(rect(4, 0, 2, 2))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirUp), 1)
end

func test_nearest_each_direction():
    from := rect(10, 10, 4, 4)
    mut cs := Vector {} as Vector<tui.Rect>
    defer cs.Free()
    cs.push(rect(10, 2, 4, 4))
    cs.push(rect(10, 16, 4, 4))
    cs.push(rect(2, 10, 4, 4))
    cs.push(rect(18, 10, 4, 4))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirUp), 0)
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirDown), 1)
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirLeft), 2)
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirRight), 3)
    testing.AssertEqInt(tui.Nearest(from, cs, 99), -1)
end

func test_nearest_negative_and_empty():
    from := rect(-10, -3, 3, 3)
    mut cs := Vector {} as Vector<tui.Rect>
    defer cs.Free()
    cs.push(rect(-5, -2, 2, 1))
    testing.AssertEqInt(tui.Nearest(from, cs, tui.DirRight), 0)
    testing.AssertEqInt(tui.Nearest(rect(-10, -3, 0, 3), cs, tui.DirRight), -1)
    mut empty := Vector {} as Vector<tui.Rect>
    defer empty.Free()
    empty.push(rect(-5, -2, 0, 0))
    testing.AssertEqInt(tui.Nearest(from, empty, tui.DirRight), -1)
end

func grid(): tui.Screen:
    mut s := tui.NewScreen(tui.BaseWidget {}, 8, 3)
    a := s.add(tui.RootId, Tile { name = "a" })
    b := s.add(tui.RootId, Tile { name = "b" })
    c := s.add(tui.RootId, Tile { name = "c" })
    d := s.add(tui.RootId, Tile { name = "d" })
    label := s.add(tui.RootId, tui.BaseWidget {})
    s.widget(a).SetBounds(rect(0, 0, 4, 1))
    s.widget(b).SetBounds(rect(4, 0, 4, 1))
    s.widget(c).SetBounds(rect(0, 1, 4, 1))
    s.widget(d).SetBounds(rect(4, 1, 4, 1))
    s.widget(label).SetBounds(rect(0, 2, 8, 1))
    ret s
end

func test_auto_focus_first_focusable():
    mut s := grid()
    defer s.close()
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertEqInt(s.focus_stack.Len(), 1)
end

func test_no_focusable_means_no_focus():
    mut s := tui.NewScreen(tui.BaseWidget {}, 4, 1)
    defer s.close()
    _ := s.add(tui.RootId, tui.BaseWidget {})
    testing.AssertEqInt(s.focused_id(), tui.NoWidget)
    testing.AssertFalse(s.focus_next())
    testing.AssertFalse(s.focus_right())
end

func test_linear_order_wraps_and_skips():
    mut s := grid()
    defer s.close()
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_next())
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 4)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertTrue(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 4)
end

func test_linear_from_nothing():
    mut s := grid()
    defer s.close()
    testing.AssertTrue(s.pop_focus())
    testing.AssertEqInt(s.focused_id(), tui.NoWidget)
    testing.AssertTrue(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 4)
    testing.AssertTrue(s.pop_focus())
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 1)
end

func test_single_focusable_cannot_move():
    mut s := tui.NewScreen(tui.BaseWidget {}, 4, 1)
    defer s.close()
    _ := s.add(tui.RootId, Tile { name = "x" })
    testing.AssertFalse(s.focus_next())
    testing.AssertFalse(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 1)
end

func test_spatial_moves():
    mut s := grid()
    defer s.close()
    testing.AssertTrue(s.focus_right())
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_down())
    testing.AssertEqInt(s.focused_id(), 4)
    testing.AssertTrue(s.focus_left())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertTrue(s.focus_up())
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertFalse(s.focus_up())
    testing.AssertFalse(s.focus_left())
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertTrue(s.focus_down())
    testing.AssertFalse(s.focus_down())
    testing.AssertEqInt(s.focused_id(), 3)
end

func test_explicit_focus_and_stack():
    mut s := grid()
    defer s.close()
    testing.AssertFalse(s.focus(5))
    testing.AssertFalse(s.focus(0))
    testing.AssertFalse(s.focus(42))
    testing.AssertTrue(s.focus(3))
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertEqInt(s.focus_stack.Len(), 1)
    testing.AssertTrue(s.push_focus(2))
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertEqInt(s.focus_stack.Len(), 2)
    testing.AssertTrue(s.pop_focus())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertFalse(s.push_focus(5))
    testing.AssertEqInt(s.focus_stack.Len(), 1)
    testing.AssertTrue(s.pop_focus())
    testing.AssertFalse(s.pop_focus())
end

func test_focus_change_queues_repaint_and_updates_field():
    mut s := grid()
    defer s.close()
    s.present()
    testing.AssertFalse(s.dirty)
    testing.AssertTrue(s.focus_next())
    testing.AssertFalse(s.dirty)
    testing.AssertEqInt(s.focused.Bounds().x, 4)
    testing.AssertEqInt(s.focused.Bounds().y, 0)
    _ := s.pop_focus()
    testing.AssertEqInt(s.focused.Bounds().width, 8)
end

func test_dispatch_goes_to_focused_widget():
    mut s := grid()
    defer s.close()
    k := tui.Event { kind = tui.KeyEvent, key = term.Decode("k") }
    testing.AssertTrue(s.focus(4))
    testing.AssertTrue(s.dispatch(k))
    testing.AssertTrue(s.dispatch(k))
    testing.AssertTrue(s.focus_left())
    testing.AssertTrue(s.dispatch(k))
    s.present()
    testing.AssertEqStr(s.buffer.row_text(1), "*c1  d2 ")
end

func test_dispatch_with_empty_stack_starts_at_root():
    mut s := grid()
    defer s.close()
    testing.AssertTrue(s.pop_focus())
    testing.AssertEqInt(s.focused_id(), tui.NoWidget)
    visits.clear()
    k := tui.Event { kind = tui.KeyEvent, key = term.Decode("k") }
    testing.AssertFalse(s.dispatch(k))
    testing.AssertEqStr(trail(), "")
end

func test_dispatch_routes_through_focus_stack():
    mut s := grid()
    defer s.close()
    k := tui.Event { kind = tui.KeyEvent, key = term.Decode("k") }
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertTrue(s.push_focus(2))
    visits.clear()
    testing.AssertTrue(s.dispatch(k))
    testing.AssertEqStr(trail(), "b")
    testing.AssertTrue(s.pop_focus())
    testing.AssertTrue(s.dispatch(k))
    testing.AssertEqStr(trail(), "a")
end

func test_dispatch_clears_focus_when_nothing_is_visible():
    vanished = false
    mut s := tui.NewScreen(tui.BaseWidget {}, 8, 1)
    defer s.close()
    id := s.add(tui.RootId, Vanisher {})
    s.widget(id).SetBounds(rect(0, 0, 2, 1))
    testing.AssertEqInt(s.focused_id(), id)
    vanished = true
    testing.AssertFalse(s.can_focus(id))
    k := tui.Event { kind = tui.KeyEvent, key = term.Decode("k") }
    testing.AssertFalse(s.dispatch(k))
    testing.AssertEqInt(s.focused_id(), tui.NoWidget)
    vanished = false
end

func test_focus_topmost_layer():
    mut s := tui.NewScreen(tui.BaseWidget {}, 8, 1)
    defer s.close()
    a := s.add(tui.RootId, Tile { name = "a" })
    b := s.add(tui.RootId, Tile { name = "b" })
    c := s.add(tui.RootId, Tile { name = "c" })
    d := s.add(tui.RootId, Tile { name = "d" })
    s.widget(a).SetBounds(rect(0, 0, 2, 1))
    s.widget(b).SetBounds(rect(2, 0, 2, 1))
    s.widget(c).SetBounds(rect(4, 0, 2, 1))
    s.widget(d).SetBounds(rect(6, 0, 2, 1))
    testing.AssertEqInt(a, 1)
    testing.AssertEqInt(b, 2)
    testing.AssertEqInt(c, 3)
    testing.AssertEqInt(d, 4)
    testing.AssertEqInt(s.focused_id(), 1)

    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertTrue(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 4)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 1)

    mut ids := Vector {} as Vector<int>
    defer ids.Free()
    ids.push(2)
    ids.push(3)
    s.raise(ids)
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus(4))
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 2)

    visits.clear()
    k := tui.Event { kind = tui.KeyEvent, key = term.Decode("k") }
    testing.AssertTrue(s.dispatch(k))
    testing.AssertEqStr(trail(), "b")

    testing.AssertTrue(s.focus_right())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertFalse(s.focus_right())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertTrue(s.focus_left())
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertFalse(s.focus_left())
    testing.AssertEqInt(s.focused_id(), 2)

    ids.clear()
    ids.push(0)
    s.raise(ids)
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 4)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 2)

    ids.clear()
    ids.push(0)
    s.unraise(ids)
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertTrue(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 2)

    ids.clear()
    ids.push(2)
    ids.push(3)
    s.unraise(ids)
    testing.AssertEqInt(s.focused_id(), 1)

    mut blank := tui.NewScreen(tui.BaseWidget {}, 1, 1)
    defer blank.close()
    testing.AssertEqInt(blank.focused_id(), tui.NoWidget)
    testing.AssertFalse(blank.focus_next())
    testing.AssertFalse(blank.focus_prev())
    testing.AssertFalse(blank.focus_up())
    testing.AssertFalse(blank.focus_down())
    testing.AssertFalse(blank.focus_left())
    testing.AssertFalse(blank.focus_right())
    testing.AssertEqInt(blank.focused_id(), tui.NoWidget)
end

func test_indicator_follows_focus():
    mut s := grid()
    defer s.close()
    s.present()
    testing.AssertEqStr(s.buffer.row_text(0), "*a0  b0 ")
    testing.AssertTrue(s.focus_right())
    s.present()
    testing.AssertEqStr(s.buffer.row_text(0), " a0 *b0 ")
end

func test_hidden_container_hides_its_subtree():
    mut shown := tui.NewScreen(tui.BaseWidget {}, 8, 1)
    defer shown.close()
    a1 := shown.add(tui.RootId, Tile { name = "a" })
    sh1 := shown.add(tui.RootId, Shutter { shown = true })
    b1 := shown.add(sh1, Tile { name = "b" })
    c1 := shown.add(tui.RootId, Tile { name = "c" })
    shown.widget(a1).SetBounds(rect(0, 0, 2, 1))
    shown.widget(sh1).SetBounds(rect(2, 0, 2, 1))
    shown.widget(b1).SetBounds(rect(2, 0, 2, 1))
    shown.widget(c1).SetBounds(rect(4, 0, 2, 1))
    testing.AssertEqInt(shown.focused_id(), a1)
    testing.AssertTrue(shown.can_focus(b1))
    testing.AssertTrue(shown.focus_next())
    testing.AssertEqInt(shown.focused_id(), b1)
    testing.AssertTrue(shown.focus_next())
    testing.AssertEqInt(shown.focused_id(), c1)
    testing.AssertTrue(shown.focus_next())
    testing.AssertEqInt(shown.focused_id(), a1)
    testing.AssertTrue(shown.focus_right())
    testing.AssertEqInt(shown.focused_id(), b1)
    testing.AssertTrue(shown.focus_right())
    testing.AssertEqInt(shown.focused_id(), c1)

    mut hidden := tui.NewScreen(tui.BaseWidget {}, 8, 1)
    defer hidden.close()
    a2 := hidden.add(tui.RootId, Tile { name = "a" })
    sh2 := hidden.add(tui.RootId, Shutter { shown = false })
    b2 := hidden.add(sh2, Tile { name = "b" })
    c2 := hidden.add(tui.RootId, Tile { name = "c" })
    hidden.widget(a2).SetBounds(rect(0, 0, 2, 1))
    hidden.widget(sh2).SetBounds(rect(2, 0, 2, 1))
    hidden.widget(b2).SetBounds(rect(2, 0, 2, 1))
    hidden.widget(c2).SetBounds(rect(4, 0, 2, 1))
    dh := hidden.add(tui.RootId, Shutter { shown = false })
    dv := hidden.add(dh, Shutter { shown = true })
    deep := hidden.add(dv, Tile { name = "d" })
    hidden.widget(dh).SetBounds(rect(6, 0, 2, 1))
    hidden.widget(dv).SetBounds(rect(6, 0, 2, 1))
    hidden.widget(deep).SetBounds(rect(6, 0, 2, 1))
    sf := hidden.add(tui.RootId, HiddenTile {})
    hidden.widget(sf).SetBounds(rect(6, 0, 2, 1))
    testing.AssertEqInt(hidden.focused_id(), a2)
    testing.AssertFalse(hidden.can_focus(b2))
    testing.AssertFalse(hidden.focus(b2))
    testing.AssertTrue(hidden.focus_next())
    testing.AssertEqInt(hidden.focused_id(), c2)
    testing.AssertTrue(hidden.focus_next())
    testing.AssertEqInt(hidden.focused_id(), a2)
    testing.AssertTrue(hidden.focus_prev())
    testing.AssertEqInt(hidden.focused_id(), c2)
    testing.AssertTrue(hidden.focus(a2))
    testing.AssertTrue(hidden.focus_right())
    testing.AssertEqInt(hidden.focused_id(), c2)
    testing.AssertTrue(hidden.focus_left())
    testing.AssertEqInt(hidden.focused_id(), a2)
    testing.AssertFalse(hidden.can_focus(deep))
    testing.AssertFalse(hidden.focus(deep))
    testing.AssertFalse(hidden.can_focus(sf))
    testing.AssertFalse(hidden.focus(sf))
end

func test_focus_leaves_a_widget_that_stops_being_focusable():
    flag := mem.AllocateZeroed(8 as u64) as bool*
    defer mem.Free(flag as void*)
    flag[0] = true
    mut s := tui.NewScreen(tui.BaseWidget {}, 20, 5)
    defer s.close()
    a := s.add(tui.RootId, Toggle { live = flag, rect = rect(0, 0, 4, 1) })
    b := s.add(tui.RootId, Tile { name = "b", rect = rect(0, 2, 4, 1) })
    testing.AssertEqInt(s.focused_id(), a)
    flag[0] = false
    _ := s.dispatch(tui.Event { kind = tui.TickEvent })
    testing.AssertEqInt(s.focused_id(), b)
    visits.clear()
end

func test_pop_focus_skips_an_entry_that_stopped_being_focusable():
    flag := mem.AllocateZeroed(8 as u64) as bool*
    defer mem.Free(flag as void*)
    flag[0] = true
    mut s := tui.NewScreen(tui.BaseWidget {}, 20, 5)
    defer s.close()
    a := s.add(tui.RootId, Toggle { live = flag, rect = rect(0, 0, 4, 1) })
    b := s.add(tui.RootId, Tile { name = "b", rect = rect(0, 2, 4, 1) })
    testing.AssertTrue(s.push_focus(b))
    flag[0] = false
    testing.AssertTrue(s.pop_focus())
    testing.AssertEqInt(s.focused_id(), b)
    testing.AssertTrue(s.focused_id() != a)
end

func main:
    test_nearest_picks_smallest_gap()
    test_nearest_requires_perpendicular_overlap()
    test_nearest_requires_lying_beyond_the_edge()
    test_nearest_tie_break_by_alignment()
    test_nearest_half_cell_alignment_is_exact()
    test_nearest_full_tie_keeps_earliest()
    test_nearest_each_direction()
    test_nearest_negative_and_empty()
    test_auto_focus_first_focusable()
    test_no_focusable_means_no_focus()
    test_linear_order_wraps_and_skips()
    test_linear_from_nothing()
    test_single_focusable_cannot_move()
    test_spatial_moves()
    test_explicit_focus_and_stack()
    test_focus_change_queues_repaint_and_updates_field()
    test_dispatch_goes_to_focused_widget()
    test_dispatch_with_empty_stack_starts_at_root()
    test_dispatch_routes_through_focus_stack()
    test_dispatch_clears_focus_when_nothing_is_visible()
    test_focus_topmost_layer()
    test_indicator_follows_focus()
    test_hidden_container_hides_its_subtree()
    visits.Free()
    test_focus_leaves_a_widget_that_stops_being_focusable()
    test_pop_focus_skips_an_entry_that_stopped_being_focusable()
    ret testing.Summary()
end
