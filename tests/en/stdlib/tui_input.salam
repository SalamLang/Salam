func test_render_width1():
    mut e := tui.NewInput()
    e.set_value("ab")
    mut b := tui.NewBuffer(1, 1)
    defer b.free()
    b.focused = true
    e.render(b, rect(0, 0, 1, 1))
    testing.AssertEqStr(b.row_text(0), " ")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.Style { reverse = true }))
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    e.render(b, rect(0, 0, 1, 1))
    testing.AssertEqStr(b.row_text(0), "b")
    testing.AssertEqInt(cursor_col(b, 1), 0)
