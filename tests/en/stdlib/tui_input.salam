func test_screen_dispatch_reaches_focused_input():
    mut s := tui.NewScreen(tui.BaseWidget {}, 24, 3)
    defer s.close()
    w := tui.NewInput() as dyn tui.Widget
    id := s.add(tui.RootId, w)
    s.widget(id).set_bounds(rect(0, 0, 24, 1))
    testing.AssertEqInt(s.focused_id(), id)
    testing.AssertTrue(s.dispatch(key("a")))
    mut probe := tui.NewBuffer(24, 1)
    defer probe.free()
    w.render(probe, rect(0, 0, 24, 1))
    testing.AssertEqStr(probe.get(0, 0).ch, "a")
    testing.AssertEqStr(probe.get(1, 0).ch, " ")
    s.present()
    testing.AssertEqStr(s.buffer.get(0, 0).ch, "a")
    testing.AssertTrue(tui.StyleEq(s.buffer.get(1, 0).style, tui.Style { reverse = true }))
end

func test_screen_unfocused_input_does_not_consume():
    mut s := tui.NewScreen(tui.BaseWidget {}, 24, 3)
    defer s.close()
    w := tui.NewInput() as dyn tui.Widget
    inlet := s.add(tui.RootId, w)
    s.widget(inlet).set_bounds(rect(0, 0, 24, 1))
    other := s.add(tui.RootId, Sink {})
    s.widget(other).set_bounds(rect(0, 1, 24, 1))
    testing.AssertTrue(s.focus(other))
    testing.AssertFalse(s.dispatch(key("a")))
    mut probe := tui.NewBuffer(24, 1)
    defer probe.free()
    w.render(probe, rect(0, 0, 24, 1))
    testing.AssertEqStr(probe.row_text(0), "                        ")
    s.present()
    testing.AssertEqStr(s.buffer.get(0, 0).ch, " ")
    cursor := tui.Style { reverse = true }
    mut reversed := false
    repeat 24 in x:
        if tui.StyleEq(s.buffer.get(x, 0).style, cursor):
            reversed = true
        end
    end
    testing.AssertFalse(reversed)
end

func test_unicode_codepoint_editing():
    reverse := tui.Style { reverse = true }
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(16, 1)
    defer b.free()
    b.focused = true
    testing.AssertTrue(e.handle_event(key("é")))
    testing.AssertEqStr(e.value(), "é")
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqStr(b.get(0, 0).ch, "é")
    testing.AssertTrue(tui.StyleEq(b.get(1, 0).style, reverse))
    testing.AssertTrue(e.handle_event(key("é")))
    testing.AssertEqStr(e.value(), "éé")
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertTrue(tui.StyleEq(b.get(2, 0).style, reverse))
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "é")
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "")
end

func rec_true(v: str): bool:
    submit_calls++
    submit_arg = v
    ret true
end

func rec_false(v: str): bool:
    submit_calls++
    submit_arg = v
    ret false
end

func clear_shared(): bool:
    submit_calls++
    shared.set_value("")
    ret false
end

func test_submit_true():
    submit_calls = 0
    mut e := tui.NewInput()
    e.on_submit = (v: str): ret rec_true(v) end
    e.set_value("hi")
    testing.AssertTrue(e.handle_event(key("\r")))
    testing.AssertEqInt(submit_calls, 1)
    testing.AssertEqStr(submit_arg, "hi")
    testing.AssertEqStr(e.value(), "hi")
end

func test_submit_false_bubbles():
    submit_calls = 0
    mut e := tui.NewInput()
    e.on_submit = (v: str): ret rec_false(v) end
    e.set_value("hi")
    testing.AssertFalse(e.handle_event(key("\r")))
    testing.AssertEqInt(submit_calls, 1)
    testing.AssertEqStr(e.value(), "hi")
end

func test_submit_empty_value():
    submit_calls = 0
    submit_arg = "unset"
    mut e := tui.NewInput()
    e.on_submit = (v: str): ret rec_true(v) end
    testing.AssertTrue(e.handle_event(key("\r")))
    testing.AssertEqInt(submit_calls, 1)
    testing.AssertEqStr(submit_arg, "")
end

func test_submit_only_on_enter():
    submit_calls = 0
    mut e := tui.NewInput()
    e.on_submit = (v: str): ret rec_true(v) end
    e.filter = (_c: str): ret false end
    _ := e.handle_event(key("a"))
    _ := e.handle_event(special(term.KeyBackspace))
    _ := e.handle_event(special(term.KeyLeft))
    _ := e.handle_event(special(term.KeyTab))
    testing.AssertEqInt(submit_calls, 0)
end

func test_submit_masked_gets_real_value():
    submit_arg = "unset"
    mut e := tui.NewInput()
    e.on_submit = (v: str): ret rec_true(v) end
    e.masked = true
    e.set_value("secret")
    _ := e.handle_event(key("\r"))
    testing.AssertEqStr(submit_arg, "secret")
end

func test_submit_clears_value_reclamps():
    submit_calls = 0
    shared = tui.NewInput()
    shared.on_submit = (_v: str): ret clear_shared() end
    shared.set_value("abcdefghij")
    mut buf := tui.NewBuffer(4, 1)
    defer buf.free()
    buf.focused = true
    shared.render(buf, rect(0, 0, 4, 1))
    testing.AssertFalse(shared.handle_event(key("\r")))
    testing.AssertEqInt(submit_calls, 1)
    testing.AssertEqStr(shared.value(), "")
    shared.render(buf, rect(0, 0, 4, 1))
    testing.AssertEqInt(cursor_col(buf, 4), 0)
    testing.AssertTrue(shared.handle_event(key("x")))
    testing.AssertEqStr(shared.value(), "x")
end

func bump(): bool:
    filter_calls++
    ret true
end

func digits_only(c: str): bool:
    repeat str.CharCount(c) in i:
        if not str.Contains("0123456789", str.CharSubstr(c, i, 1)):
            ret false
        end
    end
    ret true
end

func type_all(e: tui.Input, seq: str): tui.Input:
    mut m := e
    repeat str.CharCount(seq) in i:
        _ := m.handle_event(key(str.CharSubstr(seq, i, 1)))
    end
    ret m
end

func test_shaping_defaults():
    mut e := tui.NewInput()
    testing.AssertEqInt(e.max_length, 0)
    testing.AssertFalse(e.masked)
    testing.AssertEqStr(e.mask_glyph, "*")
    testing.AssertTrue(e.filter("anything"))
end

func test_max_length_rejects_and_consumes():
    mut e := tui.NewInput()
    e.max_length = 4
    e = type_all(e, "abcdef")
    testing.AssertEqStr(e.value(), "abcd")
    testing.AssertTrue(e.handle_event(key("z")))
    testing.AssertTrue(e.handle_event(special(term.KeySpace)))
    testing.AssertEqStr(e.value(), "abcd")
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "abc")
    testing.AssertTrue(e.handle_event(key("x")))
    testing.AssertEqStr(e.value(), "abcx")
end

func test_max_length_counts_glyphs():
    mut e := tui.NewInput()
    e.max_length = 2
    e = type_all(e, "éüa")
    testing.AssertEqStr(e.value(), "éü")
end

func test_set_value_truncates():
    mut e := tui.NewInput()
    e.max_length = 3
    e.set_value("abcdef")
    testing.AssertEqStr(e.value(), "abc")
    testing.AssertTrue(e.handle_event(key("z")))
    testing.AssertEqStr(e.value(), "abc")
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "ab")
    e.max_length = 0
    e.set_value("abcdef")
    testing.AssertEqStr(e.value(), "abcdef")
end

func test_filter_digits_only():
    mut e := tui.NewInput()
    e.filter = (c: str): ret digits_only(c) end
    e = type_all(e, "1a2 b3")
    testing.AssertEqStr(e.value(), "123")
    testing.AssertTrue(e.handle_event(key("x")))
    testing.AssertEqStr(e.value(), "123")
    testing.AssertTrue(e.handle_event(special(term.KeyLeft)))
    testing.AssertTrue(e.handle_event(key("x")))
    testing.AssertTrue(e.handle_event(key("9")))
    testing.AssertEqStr(e.value(), "1293")
end

func test_filter_insertions_only():
    mut e := tui.NewInput()
    e.filter = (_c: str): ret bump() end
    base := filter_calls
    e = type_all(e, "ab")
    testing.AssertEqInt(filter_calls, base + 2)
    _ := e.handle_event(special(term.KeyBackspace))
    _ := e.handle_event(special(term.KeyHome))
    _ := e.handle_event(special(term.KeyDelete))
    e.set_value("xyz")
    testing.AssertEqInt(filter_calls, base + 2)
end

func test_filter_after_max_length():
    mut e := tui.NewInput()
    e.max_length = 1
    e.filter = (_c: str): ret bump() end
    _ := e.handle_event(key("a"))
    base := filter_calls
    _ := e.handle_event(key("b"))
    testing.AssertEqInt(filter_calls, base)
end

func test_mask_frame_and_caret():
    reverse := tui.Style { reverse = true }
    mut e := tui.NewInput()
    e.masked = true
    e.set_value("1234")
    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    b.focused = true
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "****    ")
    testing.AssertEqStr(e.value(), "1234")
    testing.AssertTrue(tui.StyleEq(b.get(4, 0).style, reverse))
    _ := e.handle_event(special(term.KeyHome))
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.get(0, 0).ch, "*")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, reverse))
    _ := e.handle_event(special(term.KeyEnd))
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertTrue(tui.StyleEq(b.get(4, 0).style, reverse))
end

func test_mask_empty_shows_placeholder():
    mut e := tui.NewInput()
    e.masked = true
    e.set_placeholder("PIN")
    mut b := tui.NewBuffer(6, 1)
    defer b.free()
    e.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.row_text(0), "PIN   ")
end

func test_mask_glyph_variants():
    mut e := tui.NewInput()
    e.masked = true
    e.set_value("ab")
    mut b := tui.NewBuffer(4, 1)
    defer b.free()
    e.mask_glyph = ""
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "**  ")
    e.mask_glyph = "•"
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "••  ")
    e.mask_glyph = "#@"
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "##  ")
    e.mask_glyph = "•"
    b.glyphs = tui.GlyphPolicy.ASCII
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "**  ")
    e.mask_glyph = "#"
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "##  ")
end

func test_max_length_with_mask():
    mut e := tui.NewInput()
    e.max_length = 3
    e.masked = true
    e = type_all(e, "abcde")
    mut b := tui.NewBuffer(5, 1)
    defer b.free()
    e.render(b, rect(0, 0, 5, 1))
    testing.AssertEqStr(e.value(), "abc")
    testing.AssertEqStr(b.row_text(0), "***  ")
end

func test_mask_overflow_window():
    mut e := tui.NewInput()
    e.masked = true
    e.set_value("abcdefghij")
    mut b := tui.NewBuffer(4, 1)
    defer b.free()
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "*** ")
end

func cursor_cols(b: tui.Buffer, w: int): str:
    mut s := ""
    repeat w in x:
        if b.get(x, 0).style.reverse:
            s += str.FromInt(x)
        end
    end
    ret s
end

func test_masked_caret_counts_one_cell_per_glyph():
    mut wide := tui.NewInput()
    wide.masked = true
    wide.set_value("\u4e2d\u6587")
    mut b := tui.NewBuffer(8, 1)
    b.focused = true
    wide.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "**      ")
    testing.AssertEqStr(cursor_cols(b, 8), "2")
    b.free()

    mut zwnj := tui.NewInput()
    zwnj.masked = true
    zwnj.set_value("ab\u200Ccd")
    mut b2 := tui.NewBuffer(8, 1)
    b2.focused = true
    zwnj.render(b2, rect(0, 0, 8, 1))
    testing.AssertEqStr(b2.row_text(0), "*****   ")
    testing.AssertEqStr(cursor_cols(b2, 8), "5")
    b2.free()

    mut long := tui.NewInput()
    long.masked = true
    long.set_value("\u4e2d\u6587\u4e2d\u6587\u4e2d")
    mut b3 := tui.NewBuffer(4, 1)
    b3.focused = true
    long.render(b3, rect(0, 0, 4, 1))
    testing.AssertEqStr(b3.row_text(0), "*** ")
    testing.AssertEqStr(cursor_cols(b3, 4), "3")
    b3.free()
end

func test_wide_glyph_at_caret_scrolls_into_view():
    mut i := tui.NewInput()
    i.set_value("ab\u4e2d")
    testing.AssertTrue(i.handle_event(special(term.KeyLeft)))
    mut b := tui.NewBuffer(3, 1)
    b.focused = true
    i.render(b, rect(0, 0, 3, 1))
    testing.AssertEqStr(b.row_text(0), "b\u4e2d")
    testing.AssertEqStr(cursor_cols(b, 3), "12")
    b.free()
end

