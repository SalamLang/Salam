import testing
import str
import term
import tui

mut filter_calls := 0

mut submit_calls := 0
mut submit_arg := "unset"
mut shared := tui.NewInput()

struct Sink:
    pub use tui.BaseWidget

    pub func focusable(): bool:
        ret true
    end
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func key(seq: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(seq) }
end

func special(code: int): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Key { code = code } }
end

func test_defaults():
    mut e := tui.NewInput()
    testing.AssertTrue(e.focusable())
    testing.AssertEqStr(e.value(), "")
    testing.AssertEqStr(e.placeholder, "")
    testing.AssertTrue(tui.StyleEq(e.style, tui.StyleDefault))
    testing.AssertTrue(tui.StyleEq(e.cursor_style, tui.Style { reverse = true }))
    testing.AssertTrue(tui.StyleEq(e.placeholder_style, tui.Style { fg = tui.BrightBlack }))
end

func test_editing_append_printable():
    mut e := tui.NewInput()
    testing.AssertTrue(e.handle_event(key("a")))
    testing.AssertEqStr(e.value(), "a")
    testing.AssertTrue(e.handle_event(key("b")))
    testing.AssertEqStr(e.value(), "ab")
end

func test_editing_space_wire_shape():
    mut e := tui.NewInput()
    testing.AssertTrue(e.handle_event(key(" ")))
    testing.AssertEqStr(e.value(), " ")
    testing.AssertTrue(e.handle_event(special(term.KeySpace)))
    testing.AssertEqStr(e.value(), "  ")
end

func test_editing_backspace_sequence():
    mut e := tui.NewInput()
    e.set_value("ab")
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "a")
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "")
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "")
end

func test_editing_enter_consumed():
    mut e := tui.NewInput()
    e.set_value("hi")
    testing.AssertTrue(e.handle_event(key("\r")))
    testing.AssertEqStr(e.value(), "hi")
end

func test_editing_unhandled_keys_bubble():
    mut e := tui.NewInput()
    testing.AssertFalse(e.handle_event(key("\t")))
    testing.AssertFalse(e.handle_event(key("\x1b")))
    testing.AssertFalse(e.handle_event(key("\x1b[A")))
    testing.AssertFalse(e.handle_event(key("\x1b[B")))
    testing.AssertFalse(e.handle_event(key("\x1b[5~")))
    testing.AssertFalse(e.handle_event(key("\x1b[6~")))
    testing.AssertFalse(e.handle_event(key("\x1b[2~")))
    testing.AssertFalse(e.handle_event(key("\x1bOP")))
    testing.AssertFalse(e.handle_event(key("\x01")))
    testing.AssertFalse(e.handle_event(key("\x1b[1;5D")))
    testing.AssertFalse(e.handle_event(key("\x1b[3;5~")))
    testing.AssertFalse(e.handle_event(key("\x1b[3;3~")))
    testing.AssertFalse(e.handle_event(tui.Event { kind = tui.MouseEvent }))
    testing.AssertEqStr(e.value(), "")
end

func test_editing_navigation_consumed():
    mut e := tui.NewInput()
    testing.AssertTrue(e.handle_event(key("\x1b[3~")))
    testing.AssertTrue(e.handle_event(key("\x1b[H")))
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    testing.AssertTrue(e.handle_event(key("\x1b[C")))
    testing.AssertTrue(e.handle_event(key("\x1b[F")))
    testing.AssertEqStr(e.value(), "")
end

func cursor_col(b: tui.Buffer, w: int): int:
    reverse := tui.Style { reverse = true }
    mut found := -1
    repeat w in x:
        if tui.StyleEq(b.get(x, 0).style, reverse):
            found = x
        end
    end
    ret found
end

func test_caret_insert_mid_string():
    mut e := tui.NewInput()
    e.set_value("ac")
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    testing.AssertTrue(e.handle_event(key("b")))
    testing.AssertEqStr(e.value(), "abc")
    testing.AssertTrue(e.handle_event(special(term.KeySpace)))
    testing.AssertEqStr(e.value(), "ab c")
end

func test_caret_delete_and_backspace():
    mut e := tui.NewInput()
    e.set_value("abcd")
    testing.AssertTrue(e.handle_event(key("\x1b[3~")))
    testing.AssertEqStr(e.value(), "abcd")
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    testing.AssertTrue(e.handle_event(key("\x1b[3~")))
    testing.AssertEqStr(e.value(), "abd")
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "ad")
end

func test_caret_home_end_bounds():
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    b.focused = true
    e.set_value("abc")
    testing.AssertTrue(e.handle_event(key("\x1b[C")))
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqInt(cursor_col(b, 8), 3)
    testing.AssertTrue(e.handle_event(key("\x1b[H")))
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqInt(cursor_col(b, 8), 0)
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqInt(cursor_col(b, 8), 0)
    testing.AssertTrue(e.handle_event(key("\x1b[F")))
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqInt(cursor_col(b, 8), 3)
end

func test_caret_edit_trace():
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(16, 1)
    defer b.free()
    b.focused = true
    e.set_value("salam")
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    testing.AssertTrue(e.handle_event(key("x")))
    testing.AssertEqStr(e.value(), "saxlam")
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqInt(cursor_col(b, 16), 3)
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    testing.AssertEqStr(e.value(), "salam")
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqInt(cursor_col(b, 16), 2)
    testing.AssertTrue(e.handle_event(key("\x1b[3~")))
    testing.AssertEqStr(e.value(), "saam")
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqInt(cursor_col(b, 16), 2)
    testing.AssertTrue(e.handle_event(key("\x1b[F")))
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqInt(cursor_col(b, 16), 4)
    testing.AssertTrue(e.handle_event(key("\x1b[H")))
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqInt(cursor_col(b, 16), 0)
end

func test_caret_over_glyph_and_trailing_blank():
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    b.focused = true
    e.set_value("abc")
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.get(3, 0).ch, " ")
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqInt(cursor_col(b, 8), 2)
    testing.AssertEqStr(b.get(2, 0).ch, "c")
    testing.AssertEqStr(b.row_text(0), "abc     ")
    b.focused = false
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqInt(cursor_col(b, 8), -1)
    testing.AssertEqStr(b.row_text(0), "abc     ")
end

func test_window_moves_only_when_caret_leaves():
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(4, 1)
    defer b.free()
    b.focused = true
    e.set_value("abcdefgh")
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "fgh ")
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "fgh ")
    testing.AssertEqInt(cursor_col(b, 4), 2)
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "fgh ")
    testing.AssertEqInt(cursor_col(b, 4), 0)
    testing.AssertTrue(e.handle_event(key("\x1b[D")))
    e.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "efgh")
    testing.AssertEqInt(cursor_col(b, 4), 0)
end

func step(e &: tui.Input, b: tui.Buffer, seq: str):
    testing.AssertTrue(e.handle_event(key(seq)))
    e.render(b, rect(0, 0, 5, 1))
    c := cursor_col(b, 5)
    testing.AssertTrue(c >= 0 and c <= 4)
end

func test_caret_window_invariant():
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(5, 1)
    defer b.free()
    b.focused = true
    step(e, b, "a")
    step(e, b, "b")
    step(e, b, "c")
    step(e, b, "d")
    step(e, b, "e")
    step(e, b, "f")
    step(e, b, "g")
    step(e, b, "\x1b[D")
    step(e, b, "\x1b[D")
    step(e, b, "x")
    step(e, b, "\x1b[H")
    step(e, b, "\x1b[3~")
    step(e, b, "\x1b[F")
    step(e, b, "y")
    step(e, b, "\x7f")
    step(e, b, "\x1b[D")
    step(e, b, "\x1b[D")
    step(e, b, "\x1b[D")
    step(e, b, "\x1b[D")
    step(e, b, "\x1b[D")
    step(e, b, "\x1b[C")
    step(e, b, "\x1b[3~")
    step(e, b, "z")
    step(e, b, "\x1b[F")
    testing.AssertEqStr(e.value(), "bcdzxfg")
end

func test_getter_and_setters():
    mut e := tui.NewInput()
    e.set_value("hello")
    testing.AssertEqStr(e.value(), "hello")
    e.set_value("")
    testing.AssertEqStr(e.value(), "")
    e.set_placeholder("name")
    testing.AssertEqStr(e.value(), "")
end

func test_render_value_unfocused():
    mut b := tui.NewBuffer(16, 1)
    defer b.free()
    mut e := tui.NewInput()
    e.set_value("hello")
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqStr(b.get(0, 0).ch, "h")
    testing.AssertEqStr(b.get(4, 0).ch, "o")
    testing.AssertEqStr(b.get(5, 0).ch, " ")
    testing.AssertEqStr(b.row_text(0), "hello           ")
    testing.AssertTrue(tui.StyleEq(b.get(15, 0).style, tui.StyleDefault))
    cursor := tui.Style { reverse = true }
    mut reversed := false
    repeat 16 in x:
        if tui.StyleEq(b.get(x, 0).style, cursor):
            reversed = true
        end
    end
    testing.AssertFalse(reversed)
end

func test_render_cursor_default():
    reverse := tui.Style { reverse = true }
    mut e := tui.NewInput()
    e.set_value("hello")
    mut b := tui.NewBuffer(16, 1)
    defer b.free()
    b.focused = true
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqStr(b.get(5, 0).ch, " ")
    testing.AssertTrue(tui.StyleEq(b.get(5, 0).style, reverse))
    testing.AssertEqStr(b.row_text(0), "hello           ")

    mut empty := tui.NewInput()
    mut b2 := tui.NewBuffer(16, 1)
    defer b2.free()
    b2.focused = true
    empty.render(b2, rect(0, 0, 16, 1))
    testing.AssertEqStr(b2.get(0, 0).ch, " ")
    testing.AssertTrue(tui.StyleEq(b2.get(0, 0).style, reverse))
end

func test_render_placeholder_default():
    gray := tui.Style { fg = tui.BrightBlack }
    reverse := tui.Style { reverse = true }
    mut e := tui.NewInput()
    e.set_placeholder("Name")
    testing.AssertEqStr(e.value(), "")

    mut b := tui.NewBuffer(16, 1)
    defer b.free()
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertEqStr(b.row_text(0), "Name            ")
    testing.AssertEqStr(b.get(0, 0).ch, "N")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, gray))
    testing.AssertTrue(tui.StyleEq(b.get(3, 0).style, gray))
    testing.AssertTrue(tui.StyleEq(b.get(4, 0).style, tui.StyleDefault))

    mut b2 := tui.NewBuffer(16, 1)
    defer b2.free()
    b2.focused = true
    e.render(b2, rect(0, 0, 16, 1))
    testing.AssertEqStr(b2.get(0, 0).ch, "N")
    testing.AssertTrue(tui.StyleEq(b2.get(0, 0).style, reverse))
    testing.AssertTrue(tui.StyleEq(b2.get(1, 0).style, gray))
    testing.AssertEqStr(e.value(), "")
end

func test_render_default_fallbacks_from_fields():
    mut e := tui.NewInput()
    e.set_placeholder("Name")
    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    b.focused = true
    before := tui.SgrBuilds()
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqInt(tui.SgrBuilds() - before, 0)
    testing.AssertEqStr(b.get(0, 0).ch, "N")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.Style { reverse = true }))
    testing.AssertTrue(tui.StyleEq(b.get(1, 0).style, tui.Style { fg = tui.BrightBlack }))

    bold := tui.Style { bold = true }
    italic := tui.Style { italic = true }
    mut c := tui.NewInput()
    c.set_placeholder("Name")
    c.cursor_style = italic
    c.placeholder_style = bold
    mut b3 := tui.NewBuffer(8, 1)
    defer b3.free()
    b3.focused = true
    c.render(b3, rect(0, 0, 8, 1))
    testing.AssertTrue(tui.StyleEq(b3.get(0, 0).style, italic))
    testing.AssertTrue(tui.StyleEq(b3.get(1, 0).style, bold))
    c.cursor_style = tui.StyleDefault
    c.render(b3, rect(0, 0, 8, 1))
    testing.AssertTrue(tui.StyleEq(b3.get(0, 0).style, tui.StyleDefault))
end

func test_render_themed_styles():
    base := tui.Style { fg = tui.Black, bg = tui.White }
    gray := tui.Style { fg = tui.BrightBlack, bg = tui.White }
    reverse := tui.Style { reverse = true }
    mut b := tui.NewBuffer(16, 1)
    defer b.free()
    mut e := tui.NewInput()
    e.style = base
    e.set_value("hi")
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, base))
    testing.AssertTrue(tui.StyleEq(b.get(15, 0).style, base))
    testing.AssertFalse(tui.StyleEq(b.get(2, 0).style, reverse))
    b.focused = true
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, base))
    testing.AssertTrue(tui.StyleEq(b.get(2, 0).style, tui.StyleMerge(base, reverse)))

    mut p := tui.NewInput()
    p.style = base
    p.set_placeholder("Name")
    p.render(b, rect(0, 0, 16, 1))
    testing.AssertEqStr(b.get(0, 0).ch, "N")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.StyleMerge(base, reverse)))
    testing.AssertTrue(tui.StyleEq(b.get(1, 0).style, tui.StyleMerge(base, gray)))
    testing.AssertTrue(tui.StyleEq(b.get(4, 0).style, base))
end

func test_cursor_tracks_value_and_backspace():
    reverse := tui.Style { reverse = true }
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(16, 1)
    defer b.free()
    b.focused = true
    e.set_value("ab")
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertTrue(tui.StyleEq(b.get(2, 0).style, reverse))
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertTrue(tui.StyleEq(b.get(1, 0).style, reverse))
    testing.AssertTrue(e.handle_event(special(term.KeyBackspace)))
    e.render(b, rect(0, 0, 16, 1))
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, reverse))
end

func test_render_overflow_wide_value():
    mut e := tui.NewInput()
    e.set_value("abcdefghij")
    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "defghij ")
    b.focused = true
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "defghij ")
    testing.AssertTrue(tui.StyleEq(b.get(7, 0).style, tui.Style { reverse = true }))
end

func test_render_scroll_starts_at_boundary():
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    b.focused = true
    e.set_value("abcdefgh")
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "bcdefgh ")
    b.focused = false
    e.set_value("abcdefghi")
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "cdefghi ")
end

func test_render_window_follows_shrinking_value():
    mut e := tui.NewInput()
    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    e.set_value("abcdefghij")
    e.render(b, rect(0, 0, 8, 1))
    e.set_value("ab")
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "ab      ")
    e.set_value("abcdefghij")
    e.render(b, rect(0, 0, 8, 1))
    bs := special(term.KeyBackspace)
    e.handle_event(bs)
    e.handle_event(bs)
    e.handle_event(bs)
    e.handle_event(bs)
    e.handle_event(bs)
    e.handle_event(bs)
    e.handle_event(bs)
    e.handle_event(bs)
    e.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "ab      ")
end

