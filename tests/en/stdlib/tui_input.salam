    test_caret_delete_and_backspace()
    test_caret_home_end_bounds()
    test_caret_edit_trace()
    test_caret_over_glyph_and_trailing_blank()
    test_window_moves_only_when_caret_leaves()
    test_caret_window_invariant()
    test_getter_and_setters()
    test_render_value_unfocused()
    test_render_cursor_default()
    test_render_placeholder_default()
    test_render_themed_styles()
    test_cursor_tracks_value_and_backspace()
    test_render_overflow_wide_value()
    test_render_scroll_starts_at_boundary()
    test_render_wide_value_and_caret()
    test_render_window_follows_shrinking_value()
    test_render_width5_focused()
    test_render_width1()
    test_render_width0_draws_nothing()
