// Decode coverage for the keyboard path. Every sequence a terminal sends is
// built with term.Decode from its exact bytes and wrapped in a tui.Event,
// so these tests prove the delegation from basalam to std/term decodes special
// keys, function keys, and modifier flags correctly. No terminal is touched:
// the screen is never start()ed and stdin is never read.

import testing
import term

import tui

// A minimal root widget: the repeat test posts events and drains them through
// the channel without dispatching, so the root only has to satisfy the Widget
// interface (BaseWidget's defaults are enough).
struct Root:
    pub use tui.BaseWidget
end

func key(seq: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(seq) }
end

func test_escape_and_arrows():
    esc := key("\x1b")
    testing.AssertEqInt(esc.kind, tui.KeyEvent)
    testing.AssertEqInt(esc.key.code, term.KeyEscape)
    testing.AssertEqInt(key("\x1b[A").key.code, term.KeyUp)
    testing.AssertEqInt(key("\x1b[B").key.code, term.KeyDown)
    testing.AssertEqInt(key("\x1b[C").key.code, term.KeyRight)
    testing.AssertEqInt(key("\x1b[D").key.code, term.KeyLeft)
    testing.AssertTrue(key("\x1b[A").is_key(term.KeyUp))
end

func test_navigation():
    testing.AssertEqInt(key("\x1b[H").key.code, term.KeyHome)
    testing.AssertEqInt(key("\x1b[F").key.code, term.KeyEnd)
    testing.AssertEqInt(key("\x1b[2~").key.code, term.KeyInsert)
    testing.AssertEqInt(key("\x1b[3~").key.code, term.KeyDelete)
    testing.AssertEqInt(key("\x1b[5~").key.code, term.KeyPageUp)
    testing.AssertEqInt(key("\x1b[6~").key.code, term.KeyPageDown)
end

func test_function_keys():
    testing.AssertEqInt(key("\x1bOP").key.code, term.KeyF1)
    // std/term only exports KeyF1; F5 and F12 are KeyF1 + 4 and KeyF1 + 11.
    testing.AssertEqInt(key("\x1b[15~").key.code, term.KeyF1 + 4)
    testing.AssertEqInt(key("\x1b[24~").key.code, term.KeyF1 + 11)
end

func test_modifiers():
    shift_up := key("\x1b[1;2A")
    testing.AssertEqInt(shift_up.key.code, term.KeyUp)
    testing.AssertTrue(shift_up.key.shift)
    testing.AssertFalse(shift_up.key.ctrl)
    testing.AssertFalse(shift_up.key.alt)
    ctrl_right := key("\x1b[1;5C")
    testing.AssertEqInt(ctrl_right.key.code, term.KeyRight)
    testing.AssertTrue(ctrl_right.key.ctrl)
    alt_delete := key("\x1b[3;3~")
    testing.AssertEqInt(alt_delete.key.code, term.KeyDelete)
    testing.AssertTrue(alt_delete.key.alt)
end

func test_alt_char():
    q := key("\x1bq")
    testing.AssertEqInt(q.key.code, term.KeyChar)
    testing.AssertEqStr(q.key.ch, "q")
    testing.AssertTrue(q.key.alt)
    testing.AssertFalse(q.is_char("q"))
end

func test_space_and_backspace():
    space := key(" ")
    testing.AssertEqInt(space.key.code, term.KeySpace)
    testing.AssertEqStr(space.key.ch, " ")
    testing.AssertEqInt(key("\x7f").key.code, term.KeyBackspace)
    testing.AssertEqInt(key("\x08").key.code, term.KeyBackspace)
end

func test_repeated_keys_deliver_discrete_events():
    mut s := tui.NewScreen(Root {}, 8, 2)
    defer s.close()
    // A termlike key repeat arrives as repeated byte sequences. Post five
    // identical decoded keys, then close the channel (the screen is never
    // start()ed) so the drain loop terminates instead of blocking.
    testing.AssertTrue(s.post(key("\x1b[A")))
    testing.AssertTrue(s.post(key("\x1b[A")))
    testing.AssertTrue(s.post(key("\x1b[A")))
    testing.AssertTrue(s.post(key("\x1b[A")))
    testing.AssertTrue(s.post(key("\x1b[A")))
    s.stop()

    mut ev := tui.Event {}
    mut codes := Vector {} as Vector<int>
    defer codes.free()
    until s.next_event(ev):
        testing.AssertEqInt(ev.kind, tui.KeyEvent)
        codes.push(ev.key.code)
    end
    // Five discrete events, nothing coalesced, each the posted key, in order.
    testing.AssertEqInt(codes.len(), 5)
    repeat codes.len() in i:
        testing.AssertEqInt(codes.get(i), term.KeyUp)
    end
    // Nothing left after the drain.
    testing.AssertFalse(s.next_event(ev))
end

func main:
    test_escape_and_arrows()
    test_navigation()
    test_function_keys()
    test_modifiers()
    test_alt_char()
    test_space_and_backspace()
    test_repeated_keys_deliver_discrete_events()
    ret testing.Summary()
end
