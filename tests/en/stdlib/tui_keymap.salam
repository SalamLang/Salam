import sync
import testing
import term
import tui

mut seq_hits := 0

mut activate_hits := 0

struct Root:
    pub use tui.BaseWidget
end

struct Field:
    pub use tui.BaseWidget
    pub focus: bool = true

    pub func focusable(): bool:
        ret this.focus
    end
end

struct Grab:
    pub use tui.BaseWidget

    pub func handle_event(event: tui.Event): bool:
        ret event.is_char("r")
    end
end

struct TabGrab:
    pub use tui.BaseWidget

    pub func handle_event(event: tui.Event): bool:
        ret event.is_key(term.KeyTab)
    end
end

struct Activate:
    pub use tui.BaseWidget

    pub func focusable(): bool:
        ret true
    end

    pub func handle_event(event: tui.Event): bool:
        if event.is_key(term.KeyEnter) or event.is_key(term.KeySpace):
            activate_hits++
            ret true
        end
        ret false
    end
end

struct Rig:
    pub screens: Vector<tui.Screen> = Vector {}

    pub func open(w: int, h: int):
        this.screens.push(tui.NewScreen(Root {}, w, h))
    end

    pub func ptr(): tui.Screen*:
        ret this.screens.ref(0)
    end

    pub func add(parent: int, focus: bool): int:
        ret this.ptr()[0].add(parent, Field { focus = focus })
    end

    pub func focus(id: int): bool:
        ret this.ptr()[0].focus(id)
    end

    pub func focused(): int:
        ret this.ptr()[0].focused_id()
    end

    pub func release():
        this.ptr()[0].close()
        this.screens.free()
    end
end

func key(seq: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(seq) }
end

func action_focus(id: int): func (tui.Screen*, tui.Event) bool:
    ret (screen: tui.Screen*, _event: tui.Event): ret screen[0].focus(id) end
end

func focus_next_decline(screen: tui.Screen*): bool:
    _ := screen[0].focus_next()
    ret false
end

func act_next_decline(): func (tui.Screen*, tui.Event) bool:
    ret (screen: tui.Screen*, _event: tui.Event): ret focus_next_decline(screen) end
end

func act_next_consume(): func (tui.Screen*, tui.Event) bool:
    ret (screen: tui.Screen*, _event: tui.Event): ret screen[0].focus_next() end
end

func bump_seq(_screen: tui.Screen*, _event: tui.Event): bool:
    seq_hits++
    ret true
end

func count_action(): func (tui.Screen*, tui.Event) bool:
    ret (screen: tui.Screen*, event: tui.Event): ret bump_seq(screen, event) end
end

func vim_search_count(): func (tui.Screen*, tui.Event) bool:
    ret (screen: tui.Screen*, event: tui.Event): ret bump_seq(screen, event) end
end

func vim_search_decline(): func (tui.Screen*, tui.Event) bool:
    ret (_screen: tui.Screen*, _event: tui.Event): ret false end
end

func new_focus_map(id: int): tui.Keymap:
    mut km := tui.NewKeymap()
    km.bind(term.Decode("b"), action_focus(id))
    ret km
end

func swap_consume(screen: tui.Screen*, id: int): bool:
    screen[0].set_keymap(new_focus_map(id))
    ret true
end

func swap_decline(screen: tui.Screen*, id: int): bool:
    screen[0].set_keymap(new_focus_map(id))
    ret false
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func grid(): tui.Screen:
    mut s := tui.NewScreen(Root {}, 8, 3)
    a := s.add(tui.RootId, Field {})
    b := s.add(tui.RootId, Field {})
    c := s.add(tui.RootId, Field {})
    d := s.add(tui.RootId, Field {})
    s.widget(a).set_bounds(rect(0, 0, 4, 1))
    s.widget(b).set_bounds(rect(4, 0, 4, 1))
    s.widget(c).set_bounds(rect(0, 1, 4, 1))
    s.widget(d).set_bounds(rect(4, 1, 4, 1))
    ret s
end

func test_single_hit_and_miss():
    mut r := Rig {}
    defer r.release()
    r.open(20, 5)
    w1 := r.add(tui.RootId, true)
    w2 := r.add(tui.RootId, true)
    mut km := tui.NewKeymap()
    defer km.free()
    km.bind(term.Decode("a"), action_focus(w2))

    testing.AssertEqInt(r.focused(), w1)
    testing.AssertTrue(km.handle(r.ptr(), key("a")))
    testing.AssertEqInt(r.focused(), w2)
    testing.AssertFalse(km.handle(r.ptr(), key("b")))
    testing.AssertEqInt(r.focused(), w2)
end

func test_rebind_last_write_wins():
    mut r := Rig {}
    defer r.release()
    r.open(20, 5)
    r.add(tui.RootId, true)
    w2 := r.add(tui.RootId, true)
    w3 := r.add(tui.RootId, true)
    mut km := tui.NewKeymap()
    defer km.free()
    km.bind(term.Decode("a"), action_focus(w2))
    km.bind(term.Decode("a"), action_focus(w3))

    testing.AssertTrue(km.handle(r.ptr(), key("a")))
    testing.AssertEqInt(r.focused(), w3)
end

func test_unbind():
    mut r := Rig {}
    defer r.release()
    r.open(20, 5)
    w1 := r.add(tui.RootId, true)
    w2 := r.add(tui.RootId, true)
    mut km := tui.NewKeymap()
    defer km.free()
    km.bind(term.Decode("a"), action_focus(w2))
    km.unbind(term.Decode("a"))

    testing.AssertFalse(km.handle(r.ptr(), key("a")))
    testing.AssertEqInt(r.focused(), w1)
end

func test_unbind_for_drops_only_the_target_override():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    w2 := s.add(tui.RootId, Field {})
    t_global := s.add(tui.RootId, Field {})
    t_w1 := s.add(tui.RootId, Field {})
    t_w2 := s.add(tui.RootId, Field {})
    mut km := tui.NewKeymap()
    km.bind(term.Decode("x"), action_focus(t_global))
    km.bind_for(w1, term.Decode("x"), action_focus(t_w1))
    km.bind_for(w2, term.Decode("x"), action_focus(t_w2))
    s.set_keymap(km)

    testing.AssertTrue(s.focus(w1))
    testing.AssertTrue(s.dispatch(key("x")))
    testing.AssertEqInt(s.focused_id(), t_w1)
    s.keymap.unbind_for(w1, term.Decode("x"))
    testing.AssertTrue(s.focus(w1))
    testing.AssertTrue(s.dispatch(key("x")))
    testing.AssertEqInt(s.focused_id(), t_global)
    testing.AssertTrue(s.focus(w2))
    testing.AssertTrue(s.dispatch(key("x")))
    testing.AssertEqInt(s.focused_id(), t_w2)
end

func test_unbind_for_keeps_sibling_overrides():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    w2 := s.add(tui.RootId, Field {})
    t_w1 := s.add(tui.RootId, Field {})
    t_w2 := s.add(tui.RootId, Field {})
    mut km := tui.NewKeymap()
    km.bind_for(w1, term.Decode("y"), action_focus(t_w1))
    km.bind_for(w2, term.Decode("y"), action_focus(t_w2))
    s.set_keymap(km)

    s.keymap.unbind_for(w1, term.Decode("y"))
    testing.AssertTrue(s.focus(w2))
    testing.AssertTrue(s.dispatch(key("y")))
    testing.AssertEqInt(s.focused_id(), t_w2)
end

func test_unbind_for_missing_key_or_widget_is_inert():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    t1 := s.add(tui.RootId, Field {})
    s.keymap.unbind_for(w1, term.Decode("z"))
    testing.AssertFalse(s.dispatch(key("z")))

    s.keymap.bind(term.Decode("x"), action_focus(t1))
    s.keymap.unbind_for(w1, term.Decode("z"))
    s.keymap.unbind_for(99, term.Decode("x"))
    testing.AssertEqInt(s.focused_id(), w1)
    testing.AssertTrue(s.dispatch(key("x")))
    testing.AssertEqInt(s.focused_id(), t1)
end

func test_unbind_for_clears_pending_sequence():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    s.keymap.bind_seq("gg", count_action())
    seq_hits = 0

    testing.AssertFalse(s.dispatch(key("g")))
    testing.AssertEqInt(seq_hits, 0)
    s.keymap.unbind_for(w1, term.Decode("h"))
    testing.AssertFalse(s.dispatch(key("g")))
    testing.AssertEqInt(seq_hits, 0)
end

func test_unbind_for_then_rebind():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    t1 := s.add(tui.RootId, Field {})
    t2 := s.add(tui.RootId, Field {})
    mut km := tui.NewKeymap()
    km.bind_for(w1, term.Decode("x"), action_focus(t1))
    s.set_keymap(km)

    s.keymap.unbind_for(w1, term.Decode("x"))
    s.keymap.bind_for(w1, term.Decode("x"), action_focus(t2))
    testing.AssertTrue(s.focus(w1))
    testing.AssertTrue(s.dispatch(key("x")))
    testing.AssertEqInt(s.focused_id(), t2)
end

func test_unbind_for_seq_drops_only_the_target_override():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    w2 := s.add(tui.RootId, Field {})
    t_global := s.add(tui.RootId, Field {})
    t_w1 := s.add(tui.RootId, Field {})
    t_w2 := s.add(tui.RootId, Field {})
    mut km := tui.NewKeymap()
    km.bind_seq("jj", action_focus(t_global))
    km.bind_for_seq(w1, "jj", action_focus(t_w1))
    km.bind_for_seq(w2, "jj", action_focus(t_w2))
    s.set_keymap(km)

    testing.AssertTrue(s.focus(w1))
    testing.AssertFalse(s.dispatch(key("j")))
    testing.AssertTrue(s.dispatch(key("j")))
    testing.AssertEqInt(s.focused_id(), t_w1)
    s.keymap.unbind_for_seq(w1, "jj")
    testing.AssertTrue(s.focus(w1))
    testing.AssertFalse(s.dispatch(key("j")))
    testing.AssertTrue(s.dispatch(key("j")))
    testing.AssertEqInt(s.focused_id(), t_global)
    testing.AssertTrue(s.focus(w2))
    testing.AssertFalse(s.dispatch(key("j")))
    testing.AssertTrue(s.dispatch(key("j")))
    testing.AssertEqInt(s.focused_id(), t_w2)
end

func test_unbind_for_seq_missing_sequence_or_widget_is_inert():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    t1 := s.add(tui.RootId, Field {})
    s.keymap.unbind_for_seq(w1, "jj")
    testing.AssertFalse(s.dispatch(key("j")))
    testing.AssertFalse(s.dispatch(key("j")))

    s.keymap.bind_seq("jj", action_focus(t1))
    s.keymap.unbind_for_seq(w1, "qq")
    s.keymap.unbind_for_seq(99, "jj")
    testing.AssertEqInt(s.focused_id(), w1)
    testing.AssertFalse(s.dispatch(key("j")))
    testing.AssertTrue(s.dispatch(key("j")))
    testing.AssertEqInt(s.focused_id(), t1)
end

func test_unbind_for_seq_clears_pending_sequence():
