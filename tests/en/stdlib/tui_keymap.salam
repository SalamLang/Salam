func test_sequence_timeout_blocks_completion():
    mut r := Rig {}
    defer r.release()
    r.open(20, 5)
    r.add(tui.RootId, true)
    mut km := tui.NewKeymap()
    defer km.free()
    km.pending_timeout_ms = 50
    km.bind_seq("gg", count_action())
    seq_hits = 0

    testing.AssertFalse(km.handle(r.ptr(), key("g")))
    testing.AssertEqInt(seq_hits, 0)
    km.pending_since_ms = (sync.NowMs() - 5000) as int
    testing.AssertFalse(km.handle(r.ptr(), key("g")))
    testing.AssertEqInt(seq_hits, 0)
    testing.AssertTrue(km.handle(r.ptr(), key("g")))
    testing.AssertEqInt(seq_hits, 1)
end

func test_sequence_timeout_fresh_start_fires_single():
    mut r := Rig {}
    defer r.release()
    r.open(20, 5)
    r.add(tui.RootId, true)
    mut km := tui.NewKeymap()
    defer km.free()
    km.pending_timeout_ms = 50
    km.bind_seq("gg", count_action())
    km.bind(term.Decode("x"), count_action())
    seq_hits = 0

    testing.AssertFalse(km.handle(r.ptr(), key("g")))
    km.pending_since_ms = (sync.NowMs() - 5000) as int
    testing.AssertTrue(km.handle(r.ptr(), key("x")))
    testing.AssertEqInt(seq_hits, 1)
end

