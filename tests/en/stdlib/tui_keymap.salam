func test_deferral_fires_on_break():
    mut r := Rig {}
    defer r.release()
    r.open(20, 5)
    w1 := r.add(tui.RootId, true)
    w2 := r.add(tui.RootId, true)
    w3 := r.add(tui.RootId, true)
    mut km := tui.NewKeymap()
    defer km.free()
    km.bind(term.Decode("g"), action_focus(w2))
    km.bind_seq("gg", action_focus(w3))

    testing.AssertFalse(km.handle(r.ptr(), key("g")))
    testing.AssertEqInt(r.focused(), w1)
    testing.AssertTrue(km.handle(r.ptr(), key("g")))
    testing.AssertEqInt(r.focused(), w3)
    testing.AssertFalse(km.handle(r.ptr(), key("g")))
    testing.AssertTrue(km.handle(r.ptr(), key("x")))
    testing.AssertEqInt(r.focused(), w2)
end

