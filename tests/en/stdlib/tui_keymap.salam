end

func test_sequence_timeout_ignores_non_key_events():
    mut r := Rig {}
    defer r.release()
    r.open(20, 5)
    r.add(tui.RootId, true)
    mut km := tui.NewKeymap()
    defer km.free()
    km.pending_timeout_ms = 50
    km.bind_seq("gg", count_action())
    seq_hits = 0

    testing.AssertFalse(km.handle(r.ptr(), key("g")))
    km.pending_since_ms = (sync.NowMs() - 5000) as int
    testing.AssertFalse(km.handle(r.ptr(), tui.Event { kind = tui.TickEvent }))
    testing.AssertFalse(km.handle(r.ptr(), tui.Event { kind = tui.ResizeEvent, width = 21, height = 6 }))
    testing.AssertFalse(km.handle(r.ptr(), tui.Event { kind = tui.MouseEvent }))
    km.pending_since_ms = sync.NowMs() as int
    testing.AssertTrue(km.handle(r.ptr(), key("g")))
    testing.AssertEqInt(seq_hits, 1)
end

func test_widget_consumed_key_clears_pending_sequence():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    _ := s.add(tui.RootId, Activate {})
    s.keymap.bind_seq("gg", count_action())
    seq_hits = 0
    activate_hits = 0
    testing.AssertFalse(s.dispatch(key("g")))
    testing.AssertTrue(s.dispatch(tui.Event { kind = tui.KeyEvent, key = term.Key { code = term.KeyEnter } }))
    testing.AssertEqInt(activate_hits, 1)
    testing.AssertFalse(s.dispatch(key("g")))
    testing.AssertEqInt(seq_hits, 0)
    testing.AssertTrue(s.dispatch(key("g")))
    testing.AssertEqInt(seq_hits, 1)
end

func main:
    test_single_hit_and_miss()
    test_rebind_last_write_wins()
    test_unbind()
    test_unbind_for_drops_only_the_target_override()
    test_unbind_for_keeps_sibling_overrides()
    test_unbind_for_missing_key_or_widget_is_inert()
    test_unbind_for_clears_pending_sequence()
    test_unbind_for_then_rebind()
    test_unbind_for_seq_drops_only_the_target_override()
    test_unbind_for_seq_missing_sequence_or_widget_is_inert()
    test_unbind_for_seq_clears_pending_sequence()
    test_sequence_across_two_events()
    test_deferral_fires_on_break()
    test_mismatch_reprocesses_from_root()
    test_direct_two_key_sequence()
    test_nearest_scope_wins()
    test_outer_scope_beats_global()
    test_global_fallback_when_unscoped()
    test_scoped_only_outside_scope_misses()
    test_empty_map_is_inert()
    test_non_key_event_leaves_pending()
    test_space_is_not_ctrl_space()
    test_declined_mismatch_stops()
    test_declined_completion_stops()
    test_dispatch_empty_keymap_inert()
    test_dispatch_keymap_fallback()
    test_widget_consumption_beats_keymap()
    test_scoped_binding_through_dispatch()
    test_ctrl_c_with_pending_is_unconsumed()
    test_non_key_events_leave_pending()
    test_mode_switch_in_action_consumes()
    test_mode_switch_in_action_declines()
    test_run_with_tick_uses_keymap()
    test_default_keymap_tab_moves_next()
    test_default_keymap_arrows_move_spatially()
    test_default_keymap_not_installed_is_inert()
    test_default_keymap_widget_consumes_tab()
    test_default_keymap_only_five_bindings()
    test_default_keymap_fresh_per_call()
    test_default_keymap_set_keymap_and_replace()
    test_default_keymap_extend_rebind()
    test_backtab_decodes_to_an_unknown_key()
    test_backtab_binding_fires_through_dispatch()
    test_backtab_variants_are_distinct_keys()
    test_default_map_leaves_backtab_unbound()
    test_vim_preset_hjkl_moves_spatially()
    test_vim_preset_keeps_tab_and_arrows()
    test_vim_preset_gg_moves_to_the_top_of_the_column()
    test_vim_preset_gg_needs_both_keys()
    test_vim_preset_G_moves_to_the_bottom_of_the_column()
    test_vim_preset_esc_pops_one_level()
    test_vim_preset_esc_at_root_is_unconsumed()
    test_vim_preset_slash_runs_the_app_action()
    test_vim_preset_is_opt_in()
    test_vim_preset_widget_still_takes_enter_and_space()
    test_sequence_timeout_blocks_completion()
    test_sequence_timeout_fresh_start_fires_single()
    test_sequence_timeout_zero_never_expires()
    test_sequence_timeout_ignores_non_key_events()
    test_widget_consumed_key_clears_pending_sequence()
    ret testing.Summary()
end
