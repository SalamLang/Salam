    defer s.close()
    s.set_keymap(tui.NewDefaultKeymap())
    testing.AssertTrue(s.dispatch(key("\t")))
    testing.AssertEqInt(s.focused_id(), 2)
    s.set_keymap(tui.NewKeymap())
    testing.AssertFalse(s.dispatch(key("\t")))
end

