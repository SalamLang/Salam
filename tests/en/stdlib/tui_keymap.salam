func test_backtab_decodes_to_an_unknown_key():
    k := term.Decode("\x1b[Z")

    testing.AssertEqInt(k.code, term.KeyUnknown)
    testing.AssertFalse(k.shift)
    testing.AssertTrue(k.ch == "")
    testing.AssertTrue(k.raw == "\x1b[Z")
end

func test_backtab_binding_fires_through_dispatch():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    w2 := s.add(tui.RootId, Field {})
    mut km := tui.NewKeymap()
    km.bind(term.Decode("\x1b[Z"), action_focus(w2))
    s.set_keymap(km)

    testing.AssertEqInt(s.focused_id(), w1)
    testing.AssertTrue(s.dispatch(key("\x1b[Z")))
    testing.AssertEqInt(s.focused_id(), w2)
end

func test_backtab_variants_are_distinct_keys():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
    w3 := s.add(tui.RootId, Field {})
    w4 := s.add(tui.RootId, Field {})
    mut km := tui.NewKeymap()
    km.bind(term.Decode("\x1b[Z"), action_focus(w3))
    km.bind(term.Decode("\x1b[1;2Z"), action_focus(w4))
    s.set_keymap(km)

    testing.AssertFalse(term.Decode("\x1b[Z").shift)
    testing.AssertTrue(term.Decode("\x1b[1;2Z").shift)
    testing.AssertTrue(term.Decode("\x1b[1;2Z").raw != term.Decode("\x1b[Z").raw)

    testing.AssertEqInt(s.focused_id(), w1)
    testing.AssertTrue(s.dispatch(key("\x1b[Z")))
    testing.AssertEqInt(s.focused_id(), w3)
    testing.AssertTrue(s.focus(w1))
    testing.AssertTrue(s.dispatch(key("\x1b[1;2Z")))
    testing.AssertEqInt(s.focused_id(), w4)
end

func test_default_map_leaves_backtab_unbound():
    mut s := tui.NewScreen(Root {}, 20, 5)
    defer s.close()
    w1 := s.add(tui.RootId, Field {})
