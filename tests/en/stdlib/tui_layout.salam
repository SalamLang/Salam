    g.set_span(ip, 3, 4)
    g.set_cell(iq, -1, 0)
    g.set_span(iq, 2, 2)
    g.set_cell(ir, 0, -1)
    g.set_span(ir, 2, 2)
    g.set_cell(is, 1, 1)
    g.set_span(is, 5, 5)
    g.SetBounds(rect(3, 4, 8, 6))
