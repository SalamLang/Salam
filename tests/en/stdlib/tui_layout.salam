func test_screen_fit_root_recursion():
    root := tui.NewColumn()
    root.set_padding(tui.UniformInsets(1))
    a := leaf()
    mid := tui.NewRow()
    midd := mid as dyn tui.Widget
    b := leaf()
    _ := root.add(a)
    _ := root.add(midd)
    _ := root.add(b)

    scr := tui.NewScreen(root as dyn tui.Widget, 20, 10)
    _ := scr.add(tui.RootId, a)
    _ := scr.add(tui.RootId, midd)
    _ := scr.add(tui.RootId, b)
    checkRect(scr.widget(tui.RootId).bounds(), 0, 0, 20, 10)
    checkRect(a.bounds(), 1, 1, 18, 3)
    checkRect(midd.bounds(), 1, 4, 18, 3)
    checkRect(b.bounds(), 1, 7, 18, 2)

    scr.resize(20, 12)
    checkRect(scr.widget(tui.RootId).bounds(), 0, 0, 20, 12)
    checkRect(a.bounds(), 1, 1, 18, 4)
    checkRect(midd.bounds(), 1, 5, 18, 3)
    checkRect(b.bounds(), 1, 8, 18, 3)
end

func test_deep_column_row_grid_d():
    grid := tui.NewGrid(2, 3)
    gc := leaf()
    ga := leaf()
    gd := leaf()
    gb := leaf()
    igc := grid.add(gc)
    iga := grid.add(ga)
    igd := grid.add(gd)
    igb := grid.add(gb)
    grid.set_cell(igc, 1, 2)
    grid.set_margin(igc, tui.UniformInsets(1))
    grid.set_cell(iga, 0, 0)
    grid.set_cell(igd, 1, 0)
    grid.set_width(igd, fixedSize(5))
    grid.set_height(igd, fixedSize(2))
    grid.set_align(igd, tui.CrossAlign.End, tui.CrossAlign.Start)
    grid.set_cell(igb, 0, 1)
    grid.set_width(igb, fixedSize(6))
    grid.set_height(igb, fixedSize(3))
    grid.set_align(igb, tui.CrossAlign.Center, tui.CrossAlign.Center)
    gridd := grid as dyn tui.Widget

    row := tui.NewRow()
    s := leaf()
    is := row.add(s)
    row.set_width(is, fixedSize(15))
    ig := row.add(gridd)
    row.set_margin(ig, tui.UniformInsets(1))
    rowd := row as dyn tui.Widget

    root := tui.NewColumn()
    root.set_padding(tui.UniformInsets(1))
    h := leaf()
    f := leaf()
    ih := root.add(h)
    root.set_height(ih, fixedSize(3))
    _ := root.add(rowd)
    iff := root.add(f)
    root.set_height(iff, fixedSize(1))
    root.set_bounds(rect(0, 0, 60, 20))

    checkRect(h.bounds(), 1, 1, 58, 3)
    checkRect(rowd.bounds(), 1, 4, 58, 14)
    checkRect(s.bounds(), 1, 4, 15, 14)
    checkRect(gridd.bounds(), 17, 5, 41, 12)
    checkRect(gc.bounds(), 46, 12, 11, 4)
    checkRect(ga.bounds(), 17, 5, 14, 6)
    checkRect(gd.bounds(), 26, 11, 5, 2)
    checkRect(gb.bounds(), 35, 6, 6, 3)
    checkRect(f.bounds(), 1, 18, 58, 1)
end

