// Unit tests for the layout box arithmetic: FitRect, InsetRect, SplitMain,
// TrackSizes and the two axis-placement helpers. The cases are the spec's
// worked vectors, not a random sweep: the two padding vectors (uniform and
// per-side), the over-budget padding that must collapse to an empty rect
// anchored at the raw origin, a negative inset side that must clamp to 0, the
// three main-axis split vectors, the weighted-share vectors, the gap vectors,
// split with no Fill entries and with Fixed entries that exceed the length, a
// negative Fixed that clamps to 0, the grid track vectors, and the placement
// tables for Start/Center/End/Stretch plus the non-positive-avail edge (which
// behaves like Stretch). Rect normal form
// (never a negative dimension) is asserted directly on FitRect.
//
// The container smoke exercises the R1 recursion (a Column containing a Row
// is moved by one set_bounds), R5 packing, R10 grid cells including an
// out-of-range cell, R15 row and column spans, R11 stack overlap, R8 Pref
// through Text, a measurable container's natural cross extent, a Panel as a
// measured child of a Row and a Column with its border included in the
// reserved size (including a Panel whose own child is a Column), and an
// unmeasurable child that still fills the axis, R12
// empty propagation, and R13 idempotence. Main-axis Pref reserves a measured
// size and degrades to Fill weight 1 when it cannot measure. The full per-AC
// matrix is a later stage.

import mem
import testing

import tui

// Leaf is an invisible child widget: it satisfies Widget with the BaseWidget
// defaults (so it cannot measure and preferred_size returns the sentinel) and
// only stores the rect it is given. Sizer is the same but reports a fixed
// preferred size, so Pref and cross-axis alignment can be tested without
// depending on text wrapping.
struct Leaf:
    pub use tui.BaseWidget

    pub func render(buf: tui.Buffer, b: tui.Rect):
        _ := buf
        _ := b
    end
end

struct Sizer:
    pub use tui.BaseWidget

    pub w: int = 0
    pub h: int = 0

    pub func preferred_size(max_width: int): tui.Rect:
        _ := max_width
        ret tui.Rect { width = this.w, height = this.h }
    end

    pub func render(buf: tui.Buffer, b: tui.Rect):
        _ := buf
        _ := b
    end
end

// AssertMeasure measures normally but fails the test if the engine ever
// forwards a non-positive max_width: R8 says that is never forwarded, the
// axis resolves to 0 with no call.
// CountSizer reports a fixed preferred size and records each preferred_size
// call. calls[0] is the count; calls[1..] are the max_width values, in order.
// The pointer is shared with the dyn copy because an int* is not deep-copied.
struct CountSizer:
    pub use tui.BaseWidget

    pub w: int = 0
    pub h: int = 0
    pub calls: int* = null

    pub func preferred_size(max_width: int): tui.Rect:
        if this.calls != null:
            n := this.calls[0]
            if n < 8:
                this.calls[n + 1] = max_width
            end
            this.calls[0] = n + 1
        end
        ret tui.Rect { width = this.w, height = this.h }
    end

    pub func render(buf: tui.Buffer, b: tui.Rect):
        _ := buf
        _ := b
    end
end

// WrapSizer's height depends on max_width. A wide measure is one line; a
// narrow one wraps to three. calls is shared with the dyn copy. calls[0] is
// the count; calls[1..] are the max_width values, in order.
struct WrapSizer:
    pub use tui.BaseWidget

    pub calls: int* = null

    pub func preferred_size(max_width: int): tui.Rect:
        if this.calls != null:
            n := this.calls[0]
            if n < 8:
                this.calls[n + 1] = max_width
            end
            this.calls[0] = n + 1
        end
        mut h := 1
        if max_width < 16:
            h = 3
        end
        ret tui.Rect { width = 4, height = h }
    end

    pub func render(buf: tui.Buffer, b: tui.Rect):
        _ := buf
        _ := b
    end
end

struct AssertMeasure:
    pub use tui.BaseWidget

    pub func preferred_size(max_width: int): tui.Rect:
        testing.AssertTrue(max_width > 0)
        ret tui.Rect { width = 2, height = 1 }
    end

    pub func render(buf: tui.Buffer, b: tui.Rect):
        _ := buf
        _ := b
    end
end

struct OptOutSizer:
    pub use tui.BaseWidget
    pub w: int = 0
    pub h: int = 0

    pub func measure(axis: tui.Axis, max_width: int): tui.Measure:
        _ := axis
        _ := max_width
        ret tui.Measure { ok = false, extent = 0 }
    end

    pub func preferred_size(max_width: int): tui.Rect:
        _ := max_width
        ret tui.Rect { width = this.w, height = this.h }
    end
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

// Raw insets (negatives preserved) so the clamping in the helpers is the
// thing under test.
func ins(t: int, r: int, b: int, l: int): tui.Insets:
    ret tui.Insets { top = t, right = r, bottom = b, left = l }
end

func fillSize(): tui.LayoutSize:
    ret tui.LayoutSize { kind = tui.SizeKind.Fill }
end

func fillWeight(w: int): tui.LayoutSize:
    ret tui.LayoutSize { kind = tui.SizeKind.Fill, weight = w }
end

func prefWeight(w: int): tui.LayoutSize:
    ret tui.LayoutSize { kind = tui.SizeKind.Pref, weight = w }
end

func prefSize(): tui.LayoutSize:
    ret tui.LayoutSize { kind = tui.SizeKind.Pref }
end

func fixedSize(n: int): tui.LayoutSize:
    ret tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = n }
end

// A fresh invisible child each call, boxed as dyn Widget so the test keeps a
// reference to the same widget the container will move.
func leaf(): dyn tui.Widget:
    ret Leaf {} as dyn tui.Widget
end

func sizer(w: int, h: int): dyn tui.Widget:
    ret Sizer { w = w, h = h } as dyn tui.Widget
end

func keyed(): dyn tui.Widget:
    ret AssertMeasure {} as dyn tui.Widget
end

func text(s: str): dyn tui.Widget:
    ret tui.NewText(s) as dyn tui.Widget
end

func checkRect(r: tui.Rect, x: int, y: int, w: int, h: int):
    testing.AssertEqInt(r.x, x)
    testing.AssertEqInt(r.y, y)
    testing.AssertEqInt(r.width, w)
    testing.AssertEqInt(r.height, h)
end

func checkEmpty(r: tui.Rect):
    testing.AssertEqInt(r.width, 0)
    testing.AssertEqInt(r.height, 0)
end

func test_inset_uniform():
    r := tui.InsetRect(rect(0, 0, 80, 24), tui.UniformInsets(1))
    testing.AssertEqInt(r.x, 1)
    testing.AssertEqInt(r.y, 1)
    testing.AssertEqInt(r.width, 78)
    testing.AssertEqInt(r.height, 22)
end

func test_inset_margin():
    r := tui.InsetRect(rect(0, 0, 16, 9), ins(1, 2, 1, 2))
    testing.AssertEqInt(r.x, 2)
    testing.AssertEqInt(r.y, 1)
    testing.AssertEqInt(r.width, 12)
    testing.AssertEqInt(r.height, 7)
end

func test_inset_over_budget():
    // raw {6,7,-2,-4} clipped back inside {2,3,6,4} -> 0x0 at (6,7).
    r := tui.InsetRect(rect(2, 3, 6, 4), tui.UniformInsets(4))
    testing.AssertEqInt(r.x, 6)
    testing.AssertEqInt(r.y, 7)
    testing.AssertEqInt(r.width, 0)
    testing.AssertEqInt(r.height, 0)
    testing.AssertTrue(r.is_empty())
end

func test_inset_negative():
    // A negative side adds nothing: left -5 clamps to 0.
    r := tui.InsetRect(rect(0, 0, 10, 5), ins(0, 0, 0, -5))
    testing.AssertEqInt(r.x, 0)
    testing.AssertEqInt(r.y, 0)
    testing.AssertEqInt(r.width, 10)
    testing.AssertEqInt(r.height, 5)
    n := tui.NewInsets(-5, 2, -1, 0)
    testing.AssertEqInt(n.top, 0)
    testing.AssertEqInt(n.right, 2)
    testing.AssertEqInt(n.bottom, 0)
    testing.AssertEqInt(n.left, 0)
end

func test_inset_empty():
    r := tui.InsetRect(rect(0, 0, 0, 0), tui.UniformInsets(1))
    testing.AssertEqInt(r.x, 0)
    testing.AssertEqInt(r.y, 0)
    testing.AssertEqInt(r.width, 0)
    testing.AssertEqInt(r.height, 0)
end

func test_fit_rect():
    i := tui.FitRect(rect(0, 0, 4, 4), rect(2, 1, 5, 2))
    testing.AssertEqInt(i.x, 2)
    testing.AssertEqInt(i.y, 1)
    testing.AssertEqInt(i.width, 2)
    testing.AssertEqInt(i.height, 2)
end

func test_fit_rect_empty():
    // Disjoint: 0x0 at the nearest point of the box (10,10).
    e := tui.FitRect(rect(0, 0, 4, 4), rect(10, 10, 2, 2))
    testing.AssertEqInt(e.x, 10)
    testing.AssertEqInt(e.y, 10)
    testing.AssertEqInt(e.width, 0)
    testing.AssertEqInt(e.height, 0)
    testing.AssertTrue(e.is_empty())
    // A negative-dimension input never leaks a negative result.
    n := tui.FitRect(rect(0, 0, -3, 4), rect(0, 0, 5, 5))
    testing.AssertEqInt(n.width, 0)
    testing.AssertEqInt(n.height, 0)
    testing.AssertTrue(n.width >= 0 and n.height >= 0)
end

func test_split_equal():
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fillSize())
    sizes.push(fillSize())
    sizes.push(fillSize())
    r := tui.SplitMain(22, sizes, 0)
    testing.AssertEqInt(r.len(), 3)
    testing.AssertEqInt(r.get(0), 8)
    testing.AssertEqInt(r.get(1), 7)
    testing.AssertEqInt(r.get(2), 7)
    sizes.free()
    r.free()
end

func test_split_fixed():
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(10))
    sizes.push(fixedSize(5))
    sizes.push(fillSize())
    sizes.push(fillSize())
    sizes.push(fillSize())
    r := tui.SplitMain(43, sizes, 0)
    testing.AssertEqInt(r.len(), 5)
    testing.AssertEqInt(r.get(0), 10)
    testing.AssertEqInt(r.get(1), 5)
    testing.AssertEqInt(r.get(2), 10)
    testing.AssertEqInt(r.get(3), 9)
    testing.AssertEqInt(r.get(4), 9)
    sizes.free()
    r.free()
end

func test_split_remainder():
    sizes := Vector {} as Vector<tui.LayoutSize>
    repeat 5:
        sizes.push(fillSize())
    end
    r := tui.SplitMain(13, sizes, 0)
    testing.AssertEqInt(r.len(), 5)
    testing.AssertEqInt(r.get(0), 3)
    testing.AssertEqInt(r.get(1), 3)
    testing.AssertEqInt(r.get(2), 3)
    testing.AssertEqInt(r.get(3), 2)
    testing.AssertEqInt(r.get(4), 2)
    sizes.free()
    r.free()
end

func test_split_no_fill():
    // No Fill entries: the leftover stays unused.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(3))
    sizes.push(fixedSize(4))
    r := tui.SplitMain(20, sizes, 0)
    testing.AssertEqInt(r.len(), 2)
    testing.AssertEqInt(r.get(0), 3)
    testing.AssertEqInt(r.get(1), 4)
    sizes.free()
    r.free()
end

func test_split_over_budget():
    // Fixed 8 exceeds L=5: R = 0, so every Fill gets 0 and Fixed is not shrunk.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(8))
    sizes.push(fillSize())
    r := tui.SplitMain(5, sizes, 0)
    testing.AssertEqInt(r.get(0), 8)
    testing.AssertEqInt(r.get(1), 0)
    sizes.free()
    r.free()
end

func test_split_negative_fixed():
    // A negative Fixed clamps to 0 and does not reduce R.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(-5))
    sizes.push(fillSize())
    r := tui.SplitMain(10, sizes, 0)
    testing.AssertEqInt(r.get(0), 0)
    testing.AssertEqInt(r.get(1), 10)
    sizes.free()
    r.free()
end

func test_split_pref_counts_as_fill():
    // Arrange resolves a measured Pref to a Fixed reservation before calling
    // SplitMain. A null Pref becomes Fill weight 1. SplitMain itself does not
    // measure: an unresolved Pref stays in the weight pool (11, 10).
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(prefSize())
    sizes.push(fillSize())
    r := tui.SplitMain(21, sizes, 0)
    testing.AssertEqInt(r.get(0), 11)
    testing.AssertEqInt(r.get(1), 10)
    sizes.free()
    r.free()
end

func test_split_weights_2_1_1():
    // L=10, weights 2,1,1. Floors 5,2,2, one cell to the earliest tied leftover.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fillWeight(2))
    sizes.push(fillWeight(1))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(10, sizes, 0)
    testing.AssertEqInt(r.len(), 3)
    testing.AssertEqInt(r.get(0), 5)
    testing.AssertEqInt(r.get(1), 3)
    testing.AssertEqInt(r.get(2), 2)
    sizes.free()
    r.free()
end

func test_split_weights_1_2_3():
    // L=24, weights 1,2,3. Exact integers, no remainder.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fillWeight(1))
    sizes.push(fillWeight(2))
    sizes.push(fillWeight(3))
    r := tui.SplitMain(24, sizes, 0)
    testing.AssertEqInt(r.get(0), 4)
    testing.AssertEqInt(r.get(1), 8)
    testing.AssertEqInt(r.get(2), 12)
    sizes.free()
    r.free()
end

func test_split_weights_fixed_and_zero():
    // L=30, Fixed(6), weights 3,0,0,1. Shares 18,0,0,6. Zero still has a slot.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(6))
    sizes.push(fillWeight(3))
    sizes.push(fillWeight(0))
    sizes.push(fillWeight(0))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(30, sizes, 0)
    testing.AssertEqInt(r.len(), 5)
    testing.AssertEqInt(r.get(0), 6)
    testing.AssertEqInt(r.get(1), 18)
    testing.AssertEqInt(r.get(2), 0)
    testing.AssertEqInt(r.get(3), 0)
    testing.AssertEqInt(r.get(4), 6)
    sizes.free()
    r.free()
end

func test_split_weight_one_remainder():
    // L=28, three weight-1 Fills. Same rule as an equal split: 10,9,9.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fillSize())
    sizes.push(fillSize())
    sizes.push(fillSize())
    r := tui.SplitMain(28, sizes, 0)
    testing.AssertEqInt(r.get(0), 10)
    testing.AssertEqInt(r.get(1), 9)
    testing.AssertEqInt(r.get(2), 9)
    sizes.free()
    r.free()
end

func test_split_negative_weight():
    // A negative weight clamps to 0 and the slot is still returned.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fillWeight(-3))
    sizes.push(fillWeight(1))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(10, sizes, 0)
    testing.AssertEqInt(r.len(), 3)
    testing.AssertEqInt(r.get(0), 0)
    testing.AssertEqInt(r.get(1), 5)
    testing.AssertEqInt(r.get(2), 5)
    sizes.free()
    r.free()
end

func test_split_zero_weight_sum():
    // Every pool weight is 0. Pool sizes stay 0, Fixed stays nominal, R unused.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(4))
    sizes.push(fillWeight(0))
    sizes.push(fillWeight(-1))
    r := tui.SplitMain(15, sizes, 0)
    testing.AssertEqInt(r.get(0), 4)
    testing.AssertEqInt(r.get(1), 0)
    testing.AssertEqInt(r.get(2), 0)
    sizes.free()
    r.free()
    none := Vector {} as Vector<tui.LayoutSize>
    none.push(fillWeight(0))
    none.push(fillWeight(0))
    z := tui.SplitMain(15, none, 0)
    testing.AssertEqInt(z.len(), 2)
    testing.AssertEqInt(z.get(0), 0)
    testing.AssertEqInt(z.get(1), 0)
    none.free()
    z.free()
end

func test_split_fixed_overflow_weight():
    // Fixed overflow. R is 0, heavy Fill weights get 0, Fixed is not shrunk.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(8))
    sizes.push(fixedSize(8))
    sizes.push(fillWeight(5))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(12, sizes, 0)
    testing.AssertEqInt(r.get(0), 8)
    testing.AssertEqInt(r.get(1), 8)
    testing.AssertEqInt(r.get(2), 0)
    testing.AssertEqInt(r.get(3), 0)
    sizes.free()
    r.free()
end

func test_split_fixed_ignores_weight():
    // A Fixed child's weight is not part of the share.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 4, weight = 9 })
    sizes.push(fillWeight(1))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(10, sizes, 0)
    testing.AssertEqInt(r.get(0), 4)
    testing.AssertEqInt(r.get(1), 3)
    testing.AssertEqInt(r.get(2), 3)
    sizes.free()
    r.free()
end

func test_split_pref_weight():
    // Pref stays in the pool and its weight counts, same as Fill.
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(prefWeight(2))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(10, sizes, 0)
    testing.AssertEqInt(r.get(0), 7)
    testing.AssertEqInt(r.get(1), 3)
    sizes.free()
    r.free()
    zero := Vector {} as Vector<tui.LayoutSize>
    zero.push(prefWeight(0))
    zero.push(fillWeight(1))
    z := tui.SplitMain(10, zero, 0)
    testing.AssertEqInt(z.get(0), 0)
    testing.AssertEqInt(z.get(1), 10)
    zero.free()
    z.free()
end

func test_split_empty():
    empty := Vector {} as Vector<tui.LayoutSize>
    r := tui.SplitMain(10, empty, 0)
    testing.AssertEqInt(r.len(), 0)
    empty.free()
    r.free()
    one := Vector {} as Vector<tui.LayoutSize>
    one.push(fillSize())
    z := tui.SplitMain(0, one, 0)
    testing.AssertEqInt(z.len(), 1)
    testing.AssertEqInt(z.get(0), 0)
    one.free()
    z.free()
end

func test_tracks_uneven():
    r := tui.TrackSizes(41, 3)
    testing.AssertEqInt(r.len(), 3)
    testing.AssertEqInt(r.get(0), 14)
    testing.AssertEqInt(r.get(1), 14)
    testing.AssertEqInt(r.get(2), 13)
    r.free()
end

func test_tracks_even():
    r := tui.TrackSizes(12, 2)
    testing.AssertEqInt(r.get(0), 6)
    testing.AssertEqInt(r.get(1), 6)
    r.free()
end

func test_tracks_zero():
    z := tui.TrackSizes(0, 3)
    testing.AssertEqInt(z.len(), 3)
    testing.AssertEqInt(z.get(0), 0)
    testing.AssertEqInt(z.get(1), 0)
    testing.AssertEqInt(z.get(2), 0)
    z.free()
    n := tui.TrackSizes(5, 0)
    testing.AssertEqInt(n.len(), 0)
    n.free()
    nn := tui.TrackSizes(0, 0)
    testing.AssertEqInt(nn.len(), 0)
    nn.free()
end

func test_place_center_table():
    // avail 10, free 0..5 -> offset 0,0,1,1,2,2; the odd cell trails.
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 10), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 9), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 8), 1)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 7), 1)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 6), 2)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 5), 2)
    // Size is the natural size on a non-Stretch axis.
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.Center, 5), 5)
end

func test_place_start_end_stretch():
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Start, 4), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.Start, 4), 4)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.End, 4), 6)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.End, 4), 4)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 4), 3)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.Center, 4), 4)
    // Stretch ignores the natural size and fills the axis.
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Stretch, 99), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.Stretch, 99), 10)
end

func test_place_clamp():
    // natural above avail clamps down; below 0 clamps up.
    testing.AssertEqInt(tui.PlaceAxisSize(5, tui.CrossAlign.End, 9), 5)
    testing.AssertEqInt(tui.PlaceAxisOffset(5, tui.CrossAlign.End, 9), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(5, tui.CrossAlign.End, -2), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(5, tui.CrossAlign.End, -2), 5)
end

func test_place_nonpositive():
    // avail <= 0 behaves like Stretch: offset 0, size max(0, avail).
    testing.AssertEqInt(tui.PlaceAxisOffset(0, tui.CrossAlign.Center, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(0, tui.CrossAlign.Center, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(-3, tui.CrossAlign.Start, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(-3, tui.CrossAlign.Start, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(-3, tui.CrossAlign.Stretch, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(-3, tui.CrossAlign.Stretch, 3), 0)
end

func test_column_padding_recursion():
    col := tui.NewColumn()
    col.set_padding(tui.UniformInsets(1))
    a := leaf()
    b := leaf()
    c := leaf()
    _ := col.add(a)
    _ := col.add(b)
    _ := col.add(c)
    col.set_bounds(rect(0, 0, 80, 24))
    // content {1,1,78,22}; 22 = 3x7 + 1 -> 8, 7, 7.
    checkRect(a.bounds(), 1, 1, 78, 8)
    checkRect(b.bounds(), 1, 9, 78, 7)
    checkRect(c.bounds(), 1, 16, 78, 7)
end

func test_row_fixed_and_fill():
    row := tui.NewRow()
    a := leaf()
    b := leaf()
    c := leaf()
    d := leaf()
    e := leaf()
    ia := row.add(a)
    _ := row.add(b)
    _ := row.add(c)
    id := row.add(d)
    _ := row.add(e)
    row.set_width(ia, fixedSize(10))
    row.set_width(id, fixedSize(5))
    row.set_bounds(rect(0, 0, 43, 6))
    // F=15, R=28, m=3 -> base 9, rem 1; packed with no gaps.
    checkRect(a.bounds(), 0, 0, 10, 6)
    checkRect(b.bounds(), 10, 0, 10, 6)
    checkRect(c.bounds(), 20, 0, 9, 6)
    checkRect(d.bounds(), 29, 0, 5, 6)
    checkRect(e.bounds(), 34, 0, 9, 6)
end

func test_row_weighted_main():
    // Unequal main-axis weights produce unequal child rects. Cross axis stretches.
    row := tui.NewRow()
    a := leaf()
    b := leaf()
    c := leaf()
    ia := row.add(a)
    ib := row.add(b)
    ic := row.add(c)
    row.set_width(ia, fillWeight(2))
    row.set_width(ib, fillWeight(1))
    row.set_width(ic, fillWeight(1))
    row.set_bounds(rect(0, 0, 10, 3))
    checkRect(a.bounds(), 0, 0, 5, 3)
    checkRect(b.bounds(), 5, 0, 3, 3)
    checkRect(c.bounds(), 8, 0, 2, 3)
end

func test_row_weight_cross_ignored():
    // Width weights split the main axis. Height weights and Fixed weight do not.
    row := tui.NewRow()
    a := leaf()
    b := leaf()
    ia := row.add(a)
    ib := row.add(b)
    row.set_width(ia, fillWeight(2))
    row.set_width(ib, fillWeight(1))
    row.set_height(ia, tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 2, weight = 50 })
    row.set_height(ib, fillWeight(50))
    row.set_align(ia, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    row.set_bounds(rect(0, 0, 18, 6))
    checkRect(a.bounds(), 0, 2, 12, 2)
    checkRect(b.bounds(), 12, 0, 6, 6)
end

func test_row_zero_weight_visited():
    // A 0 or negative weight still places a 0x0 slot. The next child starts after it.
    row := tui.NewRow()
    f := leaf()
    a := leaf()
    b := leaf()
    c := leaf()
    d := leaf()
    ifx := row.add(f)
    ia := row.add(a)
    ib := row.add(b)
    ic := row.add(c)
    id := row.add(d)
    row.set_width(ifx, fixedSize(6))
    row.set_width(ia, fillWeight(3))
    row.set_width(ib, fillWeight(0))
    row.set_width(ic, fillWeight(-2))
    row.set_width(id, fillWeight(1))
    row.set_bounds(rect(0, 0, 30, 3))
    checkRect(f.bounds(), 0, 0, 6, 3)
    checkRect(a.bounds(), 6, 0, 18, 3)
    checkRect(b.bounds(), 24, 0, 0, 0)
    checkRect(c.bounds(), 24, 0, 0, 0)
    checkRect(d.bounds(), 24, 0, 6, 3)
end

func test_grid_ignores_weight():
    // Grid track sizes ignore weight. 10 columns and 2 tracks stay 5, 5.
    g := tui.NewGrid(1, 2)
    a := leaf()
    b := leaf()
    ia := g.add(a)
    ib := g.add(b)
    g.set_cell(ib, 0, 1)
    g.set_width(ia, fillWeight(9))
    g.set_width(ib, fillWeight(1))
    g.set_height(ia, fillWeight(4))
    g.set_height(ib, fillWeight(1))
    g.set_bounds(rect(0, 0, 10, 4))
    checkRect(a.bounds(), 0, 0, 5, 4)
    checkRect(b.bounds(), 5, 0, 5, 4)
end

func test_recursion_nested():
    inner := tui.NewRow()
    r0 := leaf()
    r1 := leaf()
    _ := inner.add(r0)
    _ := inner.add(r1)
    innerd := inner as dyn tui.Widget

    outer := tui.NewColumn()
    outer.set_padding(tui.UniformInsets(1))
    top := leaf()
    bottom := leaf()
    _ := outer.add(top)
    _ := outer.add(innerd)
    _ := outer.add(bottom)
    outer.set_bounds(rect(0, 0, 20, 10))
    // One set_bounds drives the whole subtree; content {1,1,18,8} -> 3,3,2.
    checkRect(top.bounds(), 1, 1, 18, 3)
    checkRect(innerd.bounds(), 1, 4, 18, 3)
    checkRect(bottom.bounds(), 1, 7, 18, 2)
    // inner content {1,4,18,3}; two fills of 18 -> 9, 9.
    checkRect(r0.bounds(), 1, 4, 9, 3)
    checkRect(r1.bounds(), 10, 4, 9, 3)
end

func test_idempotent():
    col := tui.NewColumn()
    col.set_padding(tui.UniformInsets(1))
    a := leaf()
    b := leaf()
    _ := col.add(a)
    _ := col.add(b)
    col.set_bounds(rect(0, 0, 11, 7))
    a1 := a.bounds()
    b1 := b.bounds()
    col.set_bounds(rect(0, 0, 11, 7))
    checkRect(a.bounds(), a1.x, a1.y, a1.width, a1.height)
    checkRect(b.bounds(), b1.x, b1.y, b1.width, b1.height)
end

func test_grid_cells():
    g := tui.NewGrid(2, 3)
    p := leaf()
    q := leaf()
    _ := g.add(p)
    iq := g.add(q)
    g.set_cell(iq, 1, 1)
    g.set_bounds(rect(0, 0, 12, 6))
    // cols 4,4,4; rows 3,3. p cell (0,0), q cell (1,1).
    checkRect(p.bounds(), 0, 0, 4, 3)
    checkRect(q.bounds(), 4, 3, 4, 3)
end

func test_grid_out_of_range():
    g := tui.NewGrid(2, 2)
    p := leaf()
    i := g.add(p)
    g.set_cell(i, 5, 5)
    g.set_bounds(rect(3, 4, 8, 6))
    // Out of range -> 0x0 at the content origin; the child is still placed.
    checkRect(p.bounds(), 3, 4, 0, 0)
end

func test_stack_overlap():
    st := tui.NewStack()
    st.set_padding(ins(1, 2, 1, 2))
    a := leaf()
    b := leaf()
    _ := st.add(a)
    ib := st.add(b)
    st.set_margin(ib, ins(1, 3, 2, 4))
    st.set_bounds(rect(0, 0, 30, 10))
    checkRect(a.bounds(), 2, 1, 26, 8)
    checkRect(b.bounds(), 6, 2, 19, 5)
end

func test_pref_cross_axis():
    row := tui.NewRow()
    ad := tui.NewText("hi") as dyn tui.Widget
    i := row.add(ad)
    row.set_width(i, fixedSize(6))
    row.set_align(i, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    row.set_bounds(rect(0, 0, 6, 9))
    // Main x fixed 6 -> box {0,0,6,9}; natural height 1 at width 6;
    // free 8 -> centre 4.
    checkRect(ad.bounds(), 0, 4, 6, 1)
end

func test_pref_end_alignment():
    row := tui.NewRow()
    a := sizer(3, 4)
    i := row.add(a)
    row.set_width(i, fixedSize(6))
    row.set_align(i, tui.CrossAlign.Stretch, tui.CrossAlign.End)
    row.set_bounds(rect(0, 0, 6, 9))
    // natural height 4; free 5 -> End offset 5.
    checkRect(a.bounds(), 0, 5, 6, 4)
end

func test_pref_container_yields_avail():
    outer := tui.NewRow()
    inner := tui.NewRow()
    s := sizer(3, 2)
    _ := inner.add(s)
    innerd := inner as dyn tui.Widget
    i := outer.add(innerd)
    outer.set_align(i, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    outer.set_bounds(rect(0, 0, 8, 5))
    // Inner Row measures: natural cross extent is the sizer's height 2.
    // free = 5 - 2, centre offset 1.
    checkRect(innerd.bounds(), 0, 1, 8, 2)
    checkRect(s.bounds(), 0, 1, 8, 2)

    // A Leaf cannot measure, so the inner Row cannot, and the cross axis fills.
    blank := tui.NewRow()
    leafc := leaf()
    _ := blank.add(leafc)
    blankd := blank as dyn tui.Widget
    outer2 := tui.NewRow()
    j := outer2.add(blankd)
    outer2.set_align(j, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    outer2.set_bounds(rect(0, 0, 8, 5))
    checkRect(blankd.bounds(), 0, 0, 8, 5)
    checkRect(leafc.bounds(), 0, 0, 8, 5)
end

func test_empty_content():
    col := tui.NewColumn()
    col.set_padding(tui.UniformInsets(1))
    a := leaf()
    _ := col.add(a)
    col.set_bounds(rect(0, 0, 0, 0))
    // R12: an empty content box gives every descendant an empty rect.
    checkRect(a.bounds(), 0, 0, 0, 0)
end

func test_slot_bad_index_ignored():
    row := tui.NewRow()
    a := leaf()
    _ := row.add(a)
    row.set_margin(5, tui.UniformInsets(2))
    row.set_width(-1, fixedSize(3))
    row.set_align(9, tui.CrossAlign.End, tui.CrossAlign.End)
    row.set_bounds(rect(0, 0, 4, 2))
