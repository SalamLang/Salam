func test_gap_zero_matches():
    row := tui.NewRow()
    row.set_gap(0)
    a := leaf()
    b := leaf()
    c := leaf()
    _ := row.add(a)
    _ := row.add(b)
    _ := row.add(c)
    row.set_bounds(rect(0, 0, 10, 2))
    checkRect(a.bounds(), 0, 0, 4, 2)
    checkRect(b.bounds(), 4, 0, 3, 2)
    checkRect(c.bounds(), 7, 0, 3, 2)
    weighted := tui.NewRow()
    weighted.set_gap(0)
    d := leaf()
    e := leaf()
    f := leaf()
    id := weighted.add(d)
    ie := weighted.add(e)
    ifx := weighted.add(f)
    weighted.set_width(id, fillWeight(2))
    weighted.set_width(ie, fillWeight(1))
    weighted.set_width(ifx, fillWeight(1))
    weighted.set_bounds(rect(0, 0, 10, 3))
    checkRect(d.bounds(), 0, 0, 5, 3)
    checkRect(e.bounds(), 5, 0, 3, 3)
    checkRect(f.bounds(), 8, 0, 2, 3)
end

func test_gap_zero_slot():
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fillSize())
    sizes.push(fixedSize(0))
    sizes.push(fillSize())
    parts := tui.SplitMain(20, sizes, 2)
    testing.AssertEqInt(parts.get(0), 8)
    testing.AssertEqInt(parts.get(1), 0)
    testing.AssertEqInt(parts.get(2), 8)
    sizes.free()
    parts.free()
    row := tui.NewRow()
    row.set_gap(2)
    a := leaf()
    b := leaf()
    c := leaf()
    ia := row.add(a)
    ib := row.add(b)
    ic := row.add(c)
    row.set_width(ia, fillSize())
    row.set_width(ib, fixedSize(0))
    row.set_width(ic, fillSize())
    row.set_bounds(rect(0, 0, 20, 3))
    checkRect(a.bounds(), 0, 0, 8, 3)
    checkRect(b.bounds(), 10, 0, 0, 0)
    checkRect(c.bounds(), 12, 0, 8, 3)
end

func test_gap_idempotent():
    row := tui.NewRow()
    row.set_gap(2)
    a := leaf()
    b := leaf()
    c := leaf()
    d := leaf()
    _ := row.add(a)
    _ := row.add(b)
    _ := row.add(c)
    _ := row.add(d)
    row.set_bounds(rect(0, 0, 20, 4))
    a1 := a.bounds()
    b1 := b.bounds()
    c1 := c.bounds()
    d1 := d.bounds()
    row.set_bounds(rect(0, 0, 20, 4))
    checkRect(a.bounds(), a1.x, a1.y, a1.width, a1.height)
    checkRect(b.bounds(), b1.x, b1.y, b1.width, b1.height)
    checkRect(c.bounds(), c1.x, c1.y, c1.width, c1.height)
    checkRect(d.bounds(), d1.x, d1.y, d1.width, d1.height)
end

func test_gap_cross_stretch():
    row := tui.NewRow()
    row.set_gap(4)
    a := leaf()
    b := leaf()
    _ := row.add(a)
    _ := row.add(b)
    row.set_bounds(rect(2, 3, 10, 7))
    checkRect(a.bounds(), 2, 3, 3, 7)
    checkRect(b.bounds(), 9, 3, 3, 7)
end

func test_draw_containers_smoke():
    root := tui.NewColumn()
    root.set_padding(tui.UniformInsets(1))
    t := text("hi")
    _ := root.add(t)
    scr := tui.NewScreen(root as dyn tui.Widget, 6, 3)
    _ := scr.add(tui.RootId, t)
    scr.draw()
    testing.AssertEqStr(scr.buffer.get(1, 1).ch, "h")
    testing.AssertEqStr(scr.buffer.get(2, 1).ch, "i")
    testing.AssertEqStr(scr.buffer.row_text(0), "      ")
end

func test_measure_opt_out_does_not_reuse_previous_memo():
    mut col := tui.NewColumn()
    a := sizer(5, 3)
    b := OptOutSizer { w = 5, h = 7 } as dyn tui.Widget
    ia := col.add(a)
    ib := col.add(b)
    col.set_height(ia, prefSize())
    col.set_height(ib, prefSize())
    col.set_bounds(rect(0, 0, 10, 20))
    checkRect(a.bounds(), 0, 0, 10, 3)
    checkRect(b.bounds(), 0, 3, 10, 7)
end

