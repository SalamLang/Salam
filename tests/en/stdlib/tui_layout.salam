func test_pref_column_text_i1():
    col := tui.NewColumn()
    t1 := text("hello wide world")
    t2 := text("hello wide world")
    t3 := text("hi")
    inner := tui.NewRow()
    inner_leaf := leaf()
    _ := inner.Add(inner_leaf)
    t4 := inner as dyn tui.Widget

    i1 := col.Add(t1)
    i2 := col.Add(t2)
    i3 := col.Add(t3)
    i4 := col.Add(t4)
    col.set_height(i1, fixedSize(3))
    col.set_align(i1, tui.CrossAlign.Center, tui.CrossAlign.Stretch)
    col.set_height(i2, fixedSize(3))
    col.set_align(i2, tui.CrossAlign.End, tui.CrossAlign.Stretch)
    col.set_height(i3, fixedSize(1))
    col.set_align(i3, tui.CrossAlign.Start, tui.CrossAlign.Stretch)
    col.set_height(i4, fixedSize(2))
    col.set_align(i4, tui.CrossAlign.Center, tui.CrossAlign.Stretch)
    col.SetBounds(rect(0, 0, 12, 10))
    checkRect(t1.Bounds(), 1, 0, 10, 3)
    checkRect(t2.Bounds(), 2, 3, 10, 3)
    checkRect(t3.Bounds(), 0, 6, 2, 1)
    checkRect(t4.Bounds(), 0, 7, 12, 2)
    checkRect(inner_leaf.Bounds(), 0, 7, 12, 2)
end

func test_pref_row_resolved_width_i2():
    row := tui.NewRow()
    a := text("one two three")
    b := text("x")
    ia := row.Add(a)
    ib := row.Add(b)
    row.set_width(ia, fixedSize(8))
    row.set_height(ia, prefSize())
    row.set_align(ia, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    row.set_align(ib, tui.CrossAlign.Stretch, tui.CrossAlign.End)
    row.SetBounds(rect(0, 0, 20, 6))
    checkRect(a.Bounds(), 0, 2, 8, 2)
    checkRect(b.Bounds(), 8, 5, 12, 1)
end

func test_pref_nonpositive_never_forwarded():
