    d := leaf()
    _ := raw.Add(c)
    _ := raw.Add(d)
    raw.gap = -8
    raw.SetBounds(rect(0, 0, 10, 3))
    checkRect(c.Bounds(), 0, 0, 5, 3)
    checkRect(d.Bounds(), 5, 0, 5, 3)
end

