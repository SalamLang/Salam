    checkRect(inner.slot.get(0).child.bounds(), 1, 1, 4, 2)
end

func test_normal_form_outputs():
    row := tui.NewRow()
    a := leaf()
    b := leaf()
    ia := row.add(a)
    ib := row.add(b)
    row.set_width(ia, fixedSize(30))
    row.set_margin(ib, tui.UniformInsets(5))
    row.set_bounds(rect(0, 0, 10, 4))
    ra := a.bounds()
    rb := b.bounds()
    testing.AssertTrue(ra.width >= 0 and ra.height >= 0)
    testing.AssertTrue(rb.width >= 0 and rb.height >= 0)
    testing.AssertTrue((ra.width > 0 and ra.height > 0) or (ra.width == 0 and ra.height == 0))
    testing.AssertTrue((rb.width > 0 and rb.height > 0) or (rb.width == 0 and rb.height == 0))
end

func test_row_gap_four_fill():
    sizes := Vector {} as Vector<tui.LayoutSize>
    repeat 4:
        sizes.push(fillSize())
    end
    parts := tui.SplitMain(20, sizes, 2)
    testing.AssertEqInt(parts.Len(), 4)
    testing.AssertEqInt(parts.get(0), 4)
    testing.AssertEqInt(parts.get(1), 4)
    testing.AssertEqInt(parts.get(2), 3)
    testing.AssertEqInt(parts.get(3), 3)
    sizes.free()
    parts.free()
    row := tui.NewRow()
    row.set_gap(2)
    a := leaf()
    b := leaf()
    c := leaf()
    d := leaf()
    _ := row.add(a)
    _ := row.add(b)
    _ := row.add(c)
    _ := row.add(d)
    row.set_bounds(rect(0, 0, 20, 4))
    checkRect(a.bounds(), 0, 0, 4, 4)
    checkRect(b.bounds(), 6, 0, 4, 4)
    checkRect(c.bounds(), 12, 0, 3, 4)
    checkRect(d.bounds(), 17, 0, 3, 4)
end

