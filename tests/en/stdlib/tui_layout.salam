func test_panel_nested_measure_budget():
    calls := mem.AllocateZeroed((9 as u64) * sizeof(int)) as int*
    mut inner := tui.Panel { border = tui.BorderStyle.Single }
    inner.Add(CountSizer { w = 1, h = 1, calls = calls } as dyn tui.Widget)
    mut outer := tui.Panel { border = tui.BorderStyle.Single }
    outer.Add(inner)
    got := outer.PreferredSize(6)
    testing.AssertEqInt(calls[0], 1)
    testing.AssertEqInt(calls[1], 2)
    testing.AssertEqInt(got.width, 5)
end

