func test_grid_span_clamp():
    g := tui.NewGrid(2, 3)
    a := leaf()
    b := leaf()
    c := leaf()
    ia := g.add(a)
    ib := g.add(b)
    ic := g.add(c)
    g.set_cell(ia, 0, 1)
    g.set_span(ia, 1, 5)
    g.set_cell(ib, 0, 2)
    g.set_span(ib, 1, -3)
    g.set_cell(ic, 1, 0)
    g.set_span(ic, 4, 1)
    testing.AssertEqInt(g.items.get(ia).col_span, 5)
    testing.AssertEqInt(g.items.get(ib).col_span, 1)
    testing.AssertEqInt(g.items.get(ic).row_span, 4)
    g.set_bounds(rect(0, 0, 10, 6))
    checkRect(a.bounds(), 4, 0, 6, 3)
    checkRect(b.bounds(), 7, 0, 3, 3)
    checkRect(c.bounds(), 0, 3, 4, 3)
end

func test_grid_span_nonpositive():
    g := tui.NewGrid(2, 3)
    a := leaf()
    b := leaf()
    c := leaf()
    d := leaf()
    ia := g.add(a)
    ib := g.add(b)
    ic := g.add(c)
    id := g.add(d)
    g.set_cell(ia, 0, 1)
    g.set_span(ia, 0, 0)
    g.set_cell(ib, 0, 2)
    g.set_span(ib, -2, -4)
    g.set_cell(ic, 1, 0)
    mut slot := g.items.get(ic)
    slot.row_span = 0
    slot.col_span = -3
    g.items.set(ic, slot)
    g.set_cell(id, 0, 0)
    g.set_span(id, 2, 2)
    g.set_span(-1, 9, 9)
    testing.AssertEqInt(g.items.get(ia).row_span, 1)
    testing.AssertEqInt(g.items.get(ia).col_span, 1)
    testing.AssertEqInt(g.items.get(ib).row_span, 1)
    testing.AssertEqInt(g.items.get(ib).col_span, 1)
    testing.AssertEqInt(g.items.get(id).row_span, 2)
    testing.AssertEqInt(g.items.get(id).col_span, 2)
    g.set_bounds(rect(0, 0, 21, 12))
    checkRect(a.bounds(), 7, 0, 7, 6)
    checkRect(b.bounds(), 14, 0, 7, 6)
    checkRect(c.bounds(), 0, 6, 7, 6)
    checkRect(d.bounds(), 0, 0, 14, 12)
end

