    ia := row.add(a)
    ib := row.add(b)
    _ := row.add(c)
    row.set_width(ia, prefSize())
    row.set_width(ib, prefSize())
    row.set_bounds(rect(0, 0, 20, 3))
    checkRect(a.bounds(), 0, 0, 16, 3)
