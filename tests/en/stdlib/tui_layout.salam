end

func test_row_pref_overflow_clip():
    row := tui.NewRow()
    a := sizer(10, 1)
    b := sizer(2, 1)
    c := leaf()
    d := leaf()
    ia := row.add(a)
    ib := row.add(b)
    ic := row.add(c)
    _ := row.add(d)
    row.set_width(ia, prefSize())
    row.set_width(ib, prefSize())
    row.set_width(ic, fixedSize(4))
    row.set_bounds(rect(0, 0, 10, 3))
    checkRect(a.bounds(), 0, 0, 10, 3)
    checkRect(b.bounds(), 10, 0, 0, 0)
    checkRect(c.bounds(), 10, 0, 0, 0)
    checkRect(d.bounds(), 10, 0, 0, 0)
end

func test_column_measured_pref():
    col := tui.NewColumn()
    inner := tui.NewRow()
    s := sizer(2, 3)
    _ := inner.add(s)
    innerd := inner as dyn tui.Widget
    one := sizer(1, 1)
    fill := leaf()
    i0 := col.add(innerd)
    i1 := col.add(one)
    _ := col.add(fill)
    col.set_height(i0, prefSize())
    col.set_height(i1, prefSize())
    col.set_bounds(rect(0, 0, 6, 9))
    checkRect(innerd.bounds(), 0, 0, 6, 3)
    checkRect(s.bounds(), 0, 0, 6, 3)
    checkRect(one.bounds(), 0, 3, 6, 1)
    checkRect(fill.bounds(), 0, 4, 6, 5)
end

func test_column_pref_measures_at_width():
    calls := mem.AllocateZeroed((4 as u64) * sizeof(int)) as int*
    child := WrapSizer { calls = calls } as dyn tui.Widget
    col := tui.NewColumn()
    i := col.add(child)
    col.set_height(i, prefSize())
    col.set_bounds(rect(0, 0, 8, 30))
    testing.AssertEqInt(calls[0], 1)
    testing.AssertEqInt(calls[1], 8)
    checkRect(child.bounds(), 0, 0, 8, 3)
    mem.Free(calls as void*)
end

func test_pref_weight_ignored_when_measured():
    row := tui.NewRow()
    a := sizer(6, 1)
    b := leaf()
    c := leaf()
    d := leaf()
    ia := row.add(a)
    ib := row.add(b)
    ic := row.add(c)
    id := row.add(d)
    row.set_width(ia, prefWeight(9))
    row.set_width(ib, fixedSize(4))
    row.set_width(ic, fillWeight(1))
    row.set_width(id, fillWeight(3))
    row.set_bounds(rect(0, 0, 20, 2))
    checkRect(a.bounds(), 0, 0, 6, 2)
    checkRect(b.bounds(), 6, 0, 4, 2)
    checkRect(c.bounds(), 10, 0, 3, 2)
    checkRect(d.bounds(), 13, 0, 7, 2)
end

func test_nested_pref_measure():
    outer := tui.NewRow()
    inner := tui.NewRow()
    inner.set_gap(2)
    a := sizer(4, 1)
    b := sizer(5, 1)
    ia := inner.add(a)
    ib := inner.add(b)
    inner.set_width(ia, prefSize())
    inner.set_width(ib, prefSize())
    innerd := inner as dyn tui.Widget
    fill := leaf()
    oi := outer.add(innerd)
    _ := outer.add(fill)
    outer.set_width(oi, prefSize())
    outer.set_bounds(rect(0, 0, 20, 4))
    checkRect(innerd.bounds(), 0, 0, 11, 4)
    checkRect(fill.bounds(), 11, 0, 9, 4)
    checkRect(a.bounds(), 0, 0, 4, 4)
    checkRect(b.bounds(), 6, 0, 5, 4)
end

func test_pref_grid_stack_null():
    row := tui.NewRow()
    g := tui.NewGrid(1, 1) as dyn tui.Widget
    a := leaf()
    ig := row.add(g)
    _ := row.add(a)
    row.set_width(ig, prefSize())
    row.set_bounds(rect(0, 0, 12, 2))
    checkRect(g.bounds(), 0, 0, 6, 2)
    checkRect(a.bounds(), 6, 0, 6, 2)

    rowf := tui.NewRow()
    gf := tui.NewGrid(1, 1) as dyn tui.Widget
    af := leaf()
    _ := rowf.add(gf)
    _ := rowf.add(af)
    rowf.set_bounds(rect(0, 0, 12, 2))
    checkRect(gf.bounds(), 0, 0, 6, 2)
    checkRect(af.bounds(), 6, 0, 6, 2)

    rows := tui.NewRow()
    st := tui.NewStack() as dyn tui.Widget
    b := leaf()
    is := rows.add(st)
    _ := rows.add(b)
    rows.set_width(is, prefSize())
    rows.set_bounds(rect(0, 0, 12, 2))
    checkRect(st.bounds(), 0, 0, 6, 2)
    checkRect(b.bounds(), 6, 0, 6, 2)
end

func test_measure_x_before_y():
    calls := mem.AllocateZeroed((9 as u64) * sizeof(int)) as int*
    a := CountSizer { w = 6, h = 2, calls = calls } as dyn tui.Widget
    row := tui.NewRow()
    i := row.add(a)
    row.set_width(i, prefSize())
    row.set_height(i, prefSize())
    row.set_align(i, tui.CrossAlign.Stretch, tui.CrossAlign.Start)
    row.set_bounds(rect(0, 0, 20, 10))
    testing.AssertEqInt(calls[0], 2)
    testing.AssertEqInt(calls[1], 20)
    testing.AssertEqInt(calls[2], 6)
    checkRect(a.bounds(), 0, 0, 6, 2)
    mem.Free(calls as void*)
end

func test_measure_memo_once():
    calls := mem.AllocateZeroed((4 as u64) * sizeof(int)) as int*
    child := CountSizer { w = 20, h = 1, calls = calls } as dyn tui.Widget
    inner := tui.NewRow()
    i := inner.add(child)
    inner.set_width(i, prefSize())
    outer := tui.NewRow()
    o := outer.add(inner as dyn tui.Widget)
    outer.set_width(o, prefSize())
    outer.set_bounds(rect(0, 0, 20, 4))
    testing.AssertEqInt(calls[0], 1)
    checkRect(child.bounds(), 0, 0, 20, 4)
    child.set_bounds(rect(3, 3, 1, 1))
    checkRect(child.bounds(), 3, 3, 1, 1)
    outer.set_bounds(rect(0, 0, 20, 4))
    testing.AssertEqInt(calls[0], 2)
    checkRect(child.bounds(), 0, 0, 20, 4)
    mem.Free(calls as void*)
end

