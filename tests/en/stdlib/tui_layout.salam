end

func test_row_pref_overflow_clip():
    row := tui.NewRow()
    a := sizer(10, 1)
    b := sizer(2, 1)
    c := leaf()
    d := leaf()
    ia := row.Add(a)
    ib := row.Add(b)
    ic := row.Add(c)
    _ := row.Add(d)
    row.set_width(ia, prefSize())
    row.set_width(ib, prefSize())
    row.set_width(ic, fixedSize(4))
    row.SetBounds(rect(0, 0, 10, 3))
