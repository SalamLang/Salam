    row2 := tui.NewRow()
    b := leaf()
    j := row2.Add(b)
    row2.set_width(j, prefSize())
    row2.SetBounds(rect(0, 0, 10, 4))
    checkRect(b.Bounds(), 0, 0, 10, 4)
end

func test_row_pref_then_fill():
