func test_grid_span_pref_exceeds():
    calls := mem.AllocateZeroed((9 as u64) * sizeof(int)) as int*
    a := CountSizer { w = 4, h = 20, calls = calls } as dyn tui.Widget
    b := sizer(30, 20)
    g := tui.NewGrid(2, 3)
    ia := g.Add(a)
    ib := g.Add(b)
    g.set_cell(ia, 0, 0)
    g.set_span(ia, 1, 2)
    g.set_width(ia, prefSize())
    g.set_height(ia, prefSize())
    g.set_align(ia, tui.CrossAlign.Center, tui.CrossAlign.End)
    g.set_cell(ib, 1, 1)
    g.set_span(ib, 1, 2)
    g.set_width(ib, prefSize())
    g.set_height(ib, prefSize())
    g.set_align(ib, tui.CrossAlign.Start, tui.CrossAlign.Start)
    g.SetBounds(rect(0, 0, 21, 12))
    testing.AssertEqInt(calls[0], 2)
    testing.AssertEqInt(calls[1], 14)
    testing.AssertEqInt(calls[2], 4)
    checkRect(a.Bounds(), 5, 0, 4, 6)
    checkRect(b.Bounds(), 7, 6, 14, 6)
    mem.Free(calls as void*)
end

