    c := leaf()
    d := leaf()
    _ := raw.add(c)
    _ := raw.add(d)
    raw.gap = -8
    raw.set_bounds(rect(0, 0, 10, 3))
    checkRect(c.bounds(), 0, 0, 5, 3)
    checkRect(d.bounds(), 5, 0, 5, 3)
end

