    plain := tui.SplitMain(20, sizes, 0)
    testing.AssertEqInt(gapped.get(0), 4)
    testing.AssertEqInt(gapped.get(1), 5)
    testing.AssertEqInt(plain.get(0), 4)
    testing.AssertEqInt(plain.get(1), 5)
    sizes.free()
    gapped.free()
    plain.free()
    row := tui.NewRow()
    row.set_gap(3)
    a := leaf()
    b := leaf()
    ia := row.add(a)
    ib := row.add(b)
    row.set_width(ia, fixedSize(4))
    row.set_width(ib, fixedSize(5))
    row.set_bounds(rect(0, 0, 20, 2))
    checkRect(a.bounds(), 0, 0, 4, 2)
    checkRect(b.bounds(), 7, 0, 5, 2)
end

