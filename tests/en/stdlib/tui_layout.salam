func test_center_column_nine_h1():
    col := tui.NewColumn()
    children := Vector {} as Vector<dyn tui.Widget>
    repeat 9 in i:
        w := i + 1
        l := leaf()
        idx := col.add(l)
        col.set_height(idx, fixedSize(1))
        col.set_width(idx, fixedSize(w))
        col.set_align(idx, tui.CrossAlign.Center, tui.CrossAlign.Stretch)
        children.push(l)
    end
    col.set_bounds(rect(0, 0, 10, 9))
    checkRect(children.get(0).bounds(), 4, 0, 1, 1)
    checkRect(children.get(1).bounds(), 4, 1, 2, 1)
    checkRect(children.get(2).bounds(), 3, 2, 3, 1)
    checkRect(children.get(3).bounds(), 3, 3, 4, 1)
    checkRect(children.get(4).bounds(), 2, 4, 5, 1)
    checkRect(children.get(5).bounds(), 2, 5, 6, 1)
    checkRect(children.get(6).bounds(), 1, 6, 7, 1)
    checkRect(children.get(7).bounds(), 1, 7, 8, 1)
    checkRect(children.get(8).bounds(), 0, 8, 9, 1)
    children.free()
end

func test_center_row_four_h2():
    row := tui.NewRow()
    v1 := leaf()
    v2 := leaf()
    v3 := leaf()
    v4 := leaf()
    i1 := row.add(v1)
    i2 := row.add(v2)
    i3 := row.add(v3)
    i4 := row.add(v4)
    row.set_height(i1, fixedSize(2))
    row.set_align(i1, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    row.set_height(i2, fixedSize(3))
    row.set_align(i2, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    row.set_height(i3, fixedSize(4))
    row.set_align(i3, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    row.set_height(i4, fixedSize(6))
    row.set_align(i4, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    row.set_bounds(rect(0, 0, 12, 7))
    checkRect(v1.bounds(), 0, 2, 3, 2)
    checkRect(v2.bounds(), 3, 2, 3, 3)
    checkRect(v3.bounds(), 6, 1, 3, 4)
    checkRect(v4.bounds(), 9, 0, 3, 6)
end

func test_pref_column_text_i1():
    col := tui.NewColumn()
    t1 := text("hello wide world")
    t2 := text("hello wide world")
    t3 := text("hi")
    inner := tui.NewRow()
    inner_leaf := leaf()
    _ := inner.add(inner_leaf)
    t4 := inner as dyn tui.Widget

    i1 := col.add(t1)
    i2 := col.add(t2)
    i3 := col.add(t3)
    i4 := col.add(t4)
    col.set_height(i1, fixedSize(3))
    col.set_align(i1, tui.CrossAlign.Center, tui.CrossAlign.Stretch)
    col.set_height(i2, fixedSize(3))
    col.set_align(i2, tui.CrossAlign.End, tui.CrossAlign.Stretch)
    col.set_height(i3, fixedSize(1))
    col.set_align(i3, tui.CrossAlign.Start, tui.CrossAlign.Stretch)
    col.set_height(i4, fixedSize(2))
    col.set_align(i4, tui.CrossAlign.Center, tui.CrossAlign.Stretch)
    col.set_bounds(rect(0, 0, 12, 10))
    checkRect(t1.bounds(), 1, 0, 10, 3)
    checkRect(t2.bounds(), 2, 3, 10, 3)
    checkRect(t3.bounds(), 0, 6, 2, 1)
    checkRect(t4.bounds(), 0, 7, 12, 2)
    checkRect(inner_leaf.bounds(), 0, 7, 12, 2)
end

func test_pref_row_resolved_width_i2():
    row := tui.NewRow()
    a := text("one two three")
    b := text("x")
    ia := row.add(a)
    ib := row.add(b)
    row.set_width(ia, fixedSize(8))
