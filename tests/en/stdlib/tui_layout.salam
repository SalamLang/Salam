func test_split_zero_weight_sum():
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(4))
    sizes.push(fillWeight(0))
    sizes.push(fillWeight(-1))
    r := tui.SplitMain(15, sizes, 0)
    testing.AssertEqInt(r.get(0), 4)
    testing.AssertEqInt(r.get(1), 0)
    testing.AssertEqInt(r.get(2), 0)
    sizes.free()
    r.free()
    none := Vector {} as Vector<tui.LayoutSize>
    none.push(fillWeight(0))
    none.push(fillWeight(0))
    z := tui.SplitMain(15, none, 0)
    testing.AssertEqInt(z.Len(), 2)
    testing.AssertEqInt(z.get(0), 0)
    testing.AssertEqInt(z.get(1), 0)
    none.free()
    z.free()
end

func test_split_fixed_overflow_weight():
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(fixedSize(8))
    sizes.push(fixedSize(8))
    sizes.push(fillWeight(5))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(12, sizes, 0)
    testing.AssertEqInt(r.get(0), 8)
    testing.AssertEqInt(r.get(1), 8)
    testing.AssertEqInt(r.get(2), 0)
    testing.AssertEqInt(r.get(3), 0)
    sizes.free()
    r.free()
end

func test_split_fixed_ignores_weight():
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 4, weight = 9 })
    sizes.push(fillWeight(1))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(10, sizes, 0)
    testing.AssertEqInt(r.get(0), 4)
    testing.AssertEqInt(r.get(1), 3)
    testing.AssertEqInt(r.get(2), 3)
    sizes.free()
    r.free()
end

func test_split_pref_weight():
    sizes := Vector {} as Vector<tui.LayoutSize>
    sizes.push(prefWeight(2))
    sizes.push(fillWeight(1))
    r := tui.SplitMain(10, sizes, 0)
    testing.AssertEqInt(r.get(0), 7)
    testing.AssertEqInt(r.get(1), 3)
    sizes.free()
    r.free()
    zero := Vector {} as Vector<tui.LayoutSize>
    zero.push(prefWeight(0))
    zero.push(fillWeight(1))
    z := tui.SplitMain(10, zero, 0)
    testing.AssertEqInt(z.get(0), 0)
    testing.AssertEqInt(z.get(1), 10)
    zero.free()
    z.free()
end

func test_split_empty():
    empty := Vector {} as Vector<tui.LayoutSize>
    r := tui.SplitMain(10, empty, 0)
    testing.AssertEqInt(r.Len(), 0)
    empty.free()
    r.free()
    one := Vector {} as Vector<tui.LayoutSize>
    one.push(fillSize())
    z := tui.SplitMain(0, one, 0)
    testing.AssertEqInt(z.Len(), 1)
    testing.AssertEqInt(z.get(0), 0)
    one.free()
    z.free()
end

func test_tracks_uneven():
    r := tui.TrackSizes(41, 3)
    testing.AssertEqInt(r.Len(), 3)
    testing.AssertEqInt(r.get(0), 14)
    testing.AssertEqInt(r.get(1), 14)
    testing.AssertEqInt(r.get(2), 13)
    r.free()
end

func test_tracks_even():
    r := tui.TrackSizes(12, 2)
    testing.AssertEqInt(r.get(0), 6)
    testing.AssertEqInt(r.get(1), 6)
    r.free()
end

func test_tracks_zero():
    z := tui.TrackSizes(0, 3)
    testing.AssertEqInt(z.Len(), 3)
    testing.AssertEqInt(z.get(0), 0)
    testing.AssertEqInt(z.get(1), 0)
    testing.AssertEqInt(z.get(2), 0)
    z.free()
    n := tui.TrackSizes(5, 0)
    testing.AssertEqInt(n.Len(), 0)
    n.free()
    nn := tui.TrackSizes(0, 0)
    testing.AssertEqInt(nn.Len(), 0)
    nn.free()
end

func test_place_center_table():
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 10), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 9), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 8), 1)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 7), 1)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 6), 2)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 5), 2)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.Center, 5), 5)
end

func test_place_start_end_stretch():
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Start, 4), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.Start, 4), 4)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.End, 4), 6)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.End, 4), 4)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Center, 4), 3)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.Center, 4), 4)
    testing.AssertEqInt(tui.PlaceAxisOffset(10, tui.CrossAlign.Stretch, 99), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(10, tui.CrossAlign.Stretch, 99), 10)
end

func test_place_clamp():
    testing.AssertEqInt(tui.PlaceAxisSize(5, tui.CrossAlign.End, 9), 5)
    testing.AssertEqInt(tui.PlaceAxisOffset(5, tui.CrossAlign.End, 9), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(5, tui.CrossAlign.End, -2), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(5, tui.CrossAlign.End, -2), 5)
end

func test_place_nonpositive():
    testing.AssertEqInt(tui.PlaceAxisOffset(0, tui.CrossAlign.Center, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(0, tui.CrossAlign.Center, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(-3, tui.CrossAlign.Start, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(-3, tui.CrossAlign.Start, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisOffset(-3, tui.CrossAlign.Stretch, 3), 0)
    testing.AssertEqInt(tui.PlaceAxisSize(-3, tui.CrossAlign.Stretch, 3), 0)
end

func test_column_padding_recursion():
    col := tui.NewColumn()
    col.set_padding(tui.UniformInsets(1))
    a := leaf()
    b := leaf()
    c := leaf()
    _ := col.add(a)
    _ := col.add(b)
    _ := col.add(c)
    col.set_bounds(rect(0, 0, 80, 24))
    checkRect(a.bounds(), 1, 1, 78, 8)
    checkRect(b.bounds(), 1, 9, 78, 7)
    checkRect(c.bounds(), 1, 16, 78, 7)
end

func test_row_fixed_and_fill():
    row := tui.NewRow()
    a := leaf()
    b := leaf()
    c := leaf()
    d := leaf()
    e := leaf()
    ia := row.add(a)
    _ := row.add(b)
    _ := row.add(c)
    id := row.add(d)
    _ := row.add(e)
    row.set_width(ia, fixedSize(10))
    row.set_width(id, fixedSize(5))
    row.set_bounds(rect(0, 0, 43, 6))
    checkRect(a.bounds(), 0, 0, 10, 6)
    checkRect(b.bounds(), 10, 0, 10, 6)
    checkRect(c.bounds(), 20, 0, 9, 6)
    checkRect(d.bounds(), 29, 0, 5, 6)
    checkRect(e.bounds(), 34, 0, 9, 6)
end

func test_row_weighted_main():
    row := tui.NewRow()
    a := leaf()
    b := leaf()
    c := leaf()
    ia := row.add(a)
    ib := row.add(b)
    ic := row.add(c)
    row.set_width(ia, fillWeight(2))
    row.set_width(ib, fillWeight(1))
    row.set_width(ic, fillWeight(1))
    row.set_bounds(rect(0, 0, 10, 3))
    checkRect(a.bounds(), 0, 0, 5, 3)
    checkRect(b.bounds(), 5, 0, 3, 3)
    checkRect(c.bounds(), 8, 0, 2, 3)
end

func test_row_weight_cross_ignored():
    row := tui.NewRow()
    a := leaf()
    b := leaf()
    ia := row.add(a)
    ib := row.add(b)
    row.set_width(ia, fillWeight(2))
    row.set_width(ib, fillWeight(1))
    row.set_height(ia, tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 2, weight = 50 })
    row.set_height(ib, fillWeight(50))
    row.set_align(ia, tui.CrossAlign.Stretch, tui.CrossAlign.Center)
    row.set_bounds(rect(0, 0, 18, 6))
    checkRect(a.bounds(), 0, 2, 12, 2)
    checkRect(b.bounds(), 12, 0, 6, 6)
end

func test_row_zero_weight_visited():
    row := tui.NewRow()
    f := leaf()
    a := leaf()
    b := leaf()
    c := leaf()
    d := leaf()
    ifx := row.add(f)
    ia := row.add(a)
    ib := row.add(b)
    ic := row.add(c)
    id := row.add(d)
    row.set_width(ifx, fixedSize(6))
    row.set_width(ia, fillWeight(3))
    row.set_width(ib, fillWeight(0))
    row.set_width(ic, fillWeight(-2))
    row.set_width(id, fillWeight(1))
    row.set_bounds(rect(0, 0, 30, 3))
    checkRect(f.bounds(), 0, 0, 6, 3)
    checkRect(a.bounds(), 6, 0, 18, 3)
    checkRect(b.bounds(), 24, 0, 0, 0)
    checkRect(c.bounds(), 24, 0, 0, 0)
    checkRect(d.bounds(), 24, 0, 6, 3)
end

func test_grid_ignores_weight():
    g := tui.NewGrid(1, 2)
    a := leaf()
    b := leaf()
    ia := g.add(a)
    ib := g.add(b)
    g.set_cell(ib, 0, 1)
    g.set_width(ia, fillWeight(9))
    g.set_width(ib, fillWeight(1))
    g.set_height(ia, fillWeight(4))
    g.set_height(ib, fillWeight(1))
    g.set_bounds(rect(0, 0, 10, 4))
    checkRect(a.bounds(), 0, 0, 5, 4)
    checkRect(b.bounds(), 5, 0, 5, 4)
end

func test_recursion_nested():
    inner := tui.NewRow()
    r0 := leaf()
    r1 := leaf()
    _ := inner.add(r0)
    _ := inner.add(r1)
    innerd := inner as dyn tui.Widget

    outer := tui.NewColumn()
    outer.set_padding(tui.UniformInsets(1))
    top := leaf()
    bottom := leaf()
    _ := outer.add(top)
    _ := outer.add(innerd)
    _ := outer.add(bottom)
    outer.set_bounds(rect(0, 0, 20, 10))
    checkRect(top.bounds(), 1, 1, 18, 3)
    checkRect(innerd.bounds(), 1, 4, 18, 3)
    checkRect(bottom.bounds(), 1, 7, 18, 2)
