func test_grid_span_out_of_range():
    g := tui.NewGrid(2, 2)
    p := leaf()
    q := leaf()
    r := leaf()
    s := leaf()
    ip := g.add(p)
    iq := g.add(q)
    ir := g.add(r)
    is := g.add(s)
    g.set_cell(ip, 5, 5)
    g.set_span(ip, 3, 4)
    g.set_cell(iq, -1, 0)
    g.set_span(iq, 2, 2)
    g.set_cell(ir, 0, -1)
    g.set_span(ir, 2, 2)
    g.set_cell(is, 1, 1)
    g.set_span(is, 5, 5)
    g.set_bounds(rect(3, 4, 8, 6))
