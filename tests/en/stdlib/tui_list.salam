func test_frame_f10_f11_empty_identical():
    empty := tui.NewList(Vector {} as Vector<str>)
    mut bf := frame(empty, 6, 2, true)
    defer bf.free()
    mut bu := frame(empty, 6, 2, false)
    defer bu.free()
    testing.AssertEqStr(bf.row_text(0), "      ")
    testing.AssertEqStr(bf.row_text(1), "      ")
    testing.AssertEqStr(bu.row_text(0), "      ")
    testing.AssertEqStr(bf.ansi(), bu.ansi())
end

