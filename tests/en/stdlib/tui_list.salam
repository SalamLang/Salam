func test_frame_f01_sel0_focused():
    mut b := frame(list_at(0, 3), 10, 3, true)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "inbox     ")
    testing.AssertEqStr(b.row_text(1), "drafts    ")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.Style { reverse = true }))
    testing.AssertTrue(tui.StyleEq(b.get(9, 0).style, tui.Style { reverse = true }))
    testing.AssertTrue(tui.StyleEq(b.get(0, 1).style, tui.StyleDefault))
end

func test_frame_f02_sel0_unfocused():
    unfocused := tui.Style { bg = tui.BrightBlack }
    mut b := frame(list_at(0, 3), 10, 3, false)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "inbox     ")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, unfocused))
    testing.AssertTrue(tui.StyleEq(b.get(9, 0).style, unfocused))
    testing.AssertTrue(tui.StyleEq(b.get(0, 1).style, tui.StyleDefault))
    want := term.SeqMoveTo(1, 1) + term.Sgr(100) + "inbox     " + term.SeqMoveTo(2, 1) + term.Sgr(49) + "drafts    " + term.SeqMoveTo(3, 1) + "sent      "
    testing.AssertEqStr(b.ansi(), want)
end

