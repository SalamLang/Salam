func test_seq_s04_jxk_enter():
    picks.clear()
    mut l := tui.NewList(items10())
    l.set_bounds(rect(0, 0, 10, 3))
    l.on_select = (i: int): picks.push(i) end
    testing.AssertTrue(l.handle_event(key("j")))
    testing.AssertFalse(l.handle_event(key("x")))
    testing.AssertTrue(l.handle_event(key("k")))
    testing.AssertTrue(l.handle_event(key("\r")))
    testing.AssertEqInt(l.selected_index(), 0)
    testing.AssertEqStr(l.selected_item(), "inbox")
    testing.AssertEqInt(picks.len(), 1)
    testing.AssertEqInt(picks.get(0), 0)
    mut b := frame(l, 10, 3, true)
    defer b.free()
    testing.AssertEqInt(start_from(items10(), b), 0)
end

func test_seq_s05_n4():
