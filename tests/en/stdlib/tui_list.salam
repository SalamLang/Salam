    testing.AssertTrue(tui.StyleEq(b.get(0, 3).style, tui.StyleDefault))
end

func test_frame_f13_f14_clip():
    mut v := Vector {} as Vector<str>
    v.push("basalam-widgets")
    v.push("second")
    l := tui.NewList(v)
    mut bf := frame(l, 8, 2, true)
    defer bf.free()
    testing.AssertEqStr(bf.row_text(0), "basalam-")
    testing.AssertEqStr(bf.get(7, 0).ch, "-")
    testing.AssertTrue(tui.StyleEq(bf.get(0, 0).style, tui.Style { reverse = true }))
    testing.AssertEqStr(bf.row_text(1), "second  ")
    testing.AssertTrue(tui.StyleEq(bf.get(0, 1).style, tui.StyleDefault))
    mut bu := frame(l, 8, 2, false)
    defer bu.free()
    testing.AssertEqStr(bu.row_text(0), "basalam-")
    testing.AssertTrue(tui.StyleEq(bu.get(0, 0).style, tui.Style { bg = tui.BrightBlack }))
end

