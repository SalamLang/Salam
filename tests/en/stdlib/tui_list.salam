import testing
import term
import tui

mut picks := Vector {} as Vector<int>

struct Sink:
    pub use tui.BaseWidget

    pub func focusable(): bool:
        ret true
    end
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func key(seq: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(seq) }
end

func items10(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("inbox")
    v.push("drafts")
    v.push("sent")
    v.push("archive")
    v.push("trash")
    v.push("spam")
    v.push("stars")
    v.push("notes")
    v.push("tasks")
    v.push("done")
    ret v
end

func items3(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("inbox")
    v.push("drafts")
    v.push("sent")
    ret v
end

func items4(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("inbox")
    v.push("drafts")
    v.push("sent")
    v.push("archive")
    ret v
end

func list_at(sel: int, h: int): tui.List:
    mut l := tui.NewList(items10())
    l.set_bounds(rect(0, 0, 10, h))
    repeat sel:
        _ := l.handle_event(key("j"))
    end
    ret l
end

func frame(l: tui.List, w: int, h: int, focused: bool): tui.Buffer:
    mut b := tui.NewBuffer(w, h)
    b.focused = focused
    mut ll := l
    ll.render(b, rect(0, 0, w, h))
    ret b
end

func refresh(l: tui.List, b: tui.Buffer):
    mut ll := l
    ll.render(b, rect(0, 0, b.width, b.height))
end

func start_from(items: Vector<str>, b: tui.Buffer): int:
    row := b.row_text(0)
    each i, it in items:
        if it != "" and row.find(it) == 0:
            ret i
        end
    end
    ret -1
end

func test_defaults_selection():
    mut l := tui.NewList(items3())
    testing.AssertTrue(l.focusable())
    testing.AssertEqInt(l.selected_index(), 0)
    testing.AssertEqStr(l.selected_item(), "inbox")
    testing.AssertTrue(tui.StyleEq(l.style, tui.StyleDefault))
    testing.AssertTrue(tui.StyleEq(l.selected_style, tui.Style { reverse = true }))
    testing.AssertTrue(tui.StyleEq(l.selected_unfocused_style, tui.Style { bg = tui.BrightBlack }))
    testing.AssertEqInt(l.preferred_size(80).width, -1)
    testing.AssertEqInt(l.preferred_size(80).height, -1)
end

func test_defaults_empty():
    mut e := tui.NewList(Vector {} as Vector<str>)
    testing.AssertTrue(e.focusable())
    testing.AssertEqInt(e.selected_index(), -1)
    testing.AssertEqStr(e.selected_item(), "")
end

func test_selection_replaces_base_style():
    mut l := tui.NewList(items3())
    l.set_bounds(rect(0, 0, 10, 3))
    l.style = tui.Style { fg = tui.Green }
    l.selected_style = tui.Style { reverse = true }
    mut b := frame(l, 10, 3, true)
    defer b.free()
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.Style { reverse = true }))
    testing.AssertTrue(tui.StyleEq(b.get(0, 1).style, tui.Style { fg = tui.Green }))
end

func test_nav_k01_j_inside_window():
    mut l := tui.NewList(items10())
    l.set_bounds(rect(0, 0, 10, 3))
    testing.AssertTrue(l.handle_event(key("j")))
    testing.AssertEqInt(l.selected_index(), 1)
    testing.AssertEqStr(l.selected_item(), "drafts")
    mut b := frame(l, 10, 3, true)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "inbox     ")
    testing.AssertTrue(tui.StyleEq(b.get(0, 1).style, tui.Style { reverse = true }))
end

