func test_nav_k22_k23_single_item():
    picks.clear()
    mut v := Vector {} as Vector<str>
    v.push("only")
    l := tui.NewList(v)
    l.set_bounds(rect(0, 0, 10, 3))
    l.on_select = (i: int): picks.push(i) end
    testing.AssertTrue(l.handle_event(key("j")))
    testing.AssertEqInt(l.selected_index(), 0)
    testing.AssertEqStr(l.selected_item(), "only")
    testing.AssertTrue(l.handle_event(key("k")))
    testing.AssertEqInt(l.selected_index(), 0)
    testing.AssertEqStr(l.selected_item(), "only")
    testing.AssertEqInt(picks.len(), 0)
    mut b := frame(l, 10, 3, true)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "only      ")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.Style { reverse = true }))
end

