func test_bubbling_k13_k20():
    picks.clear()
    mut l := tui.NewList(items10())
    l.set_bounds(rect(0, 0, 10, 3))
    l.on_select = (i: int): picks.push(i) end
    testing.AssertFalse(l.handle_event(key("x")))
    testing.AssertFalse(l.handle_event(key("\x1b[A")))
    testing.AssertFalse(l.handle_event(key("G")))
    testing.AssertFalse(l.handle_event(key("g")))
    testing.AssertFalse(l.handle_event(key("J")))
    testing.AssertFalse(l.handle_event(key("\t")))
    testing.AssertFalse(l.handle_event(key("\x1b[B")))
    testing.AssertFalse(l.handle_event(key(" ")))
    testing.AssertEqInt(l.selected_index(), 0)
    testing.AssertEqStr(l.selected_item(), "inbox")
    testing.AssertEqInt(picks.len(), 0)
    testing.AssertFalse(l.handle_event(tui.Event { kind = tui.TickEvent }))
    testing.AssertFalse(l.handle_event(tui.Event { kind = tui.ResizeEvent, width = 5, height = 5 }))
end

func test_mouse_not_consumed():
    seq := "\x1b[<0;3;2M"
    ev := tui.Event { kind = tui.MouseEvent, key = term.Key { raw = seq }, mouse = term.DecodeMouse(seq) }
    picks.clear()
    mut l := tui.NewList(items10())
    l.set_bounds(rect(0, 0, 10, 3))
    l.on_select = (i: int): picks.push(i) end
    testing.AssertFalse(l.handle_event(ev))
    testing.AssertEqInt(l.selected_index(), 0)
    testing.AssertEqInt(picks.len(), 0)
end

func test_screen_k21_consumes_without_focus():
    mut l := tui.NewList(items10())
    l.set_bounds(rect(0, 0, 10, 3))
    testing.AssertTrue(l.handle_event(key("j")))
    testing.AssertEqInt(l.selected_index(), 1)
end

func test_screen_focused_list_receives_j():
    mut s := tui.NewScreen(tui.BaseWidget {}, 12, 3)
    defer s.close()
    w := tui.NewList(items10()) as dyn tui.Widget
    id := s.add(tui.RootId, w)
    s.widget(id).set_bounds(rect(0, 0, 12, 3))
    testing.AssertEqInt(s.focused_id(), id)
    s.present()
    testing.AssertFalse(s.dirty)
    testing.AssertTrue(s.dispatch(key("j")))
    testing.AssertFalse(s.dirty)
    s.present()
    testing.AssertEqStr(s.buffer.row_text(1), "drafts      ")
    testing.AssertTrue(tui.StyleEq(s.buffer.get(0, 1).style, tui.Style { reverse = true }))
    testing.AssertTrue(tui.StyleEq(s.buffer.get(0, 0).style, tui.StyleDefault))
end

func test_screen_unfocused_list_does_not_consume():
    mut s := tui.NewScreen(tui.BaseWidget {}, 16, 2)
    defer s.close()
    w := tui.NewList(items10()) as dyn tui.Widget
    id := s.add(tui.RootId, w)
    s.widget(id).set_bounds(rect(0, 0, 16, 2))
    other := s.add(tui.RootId, Sink {})
    s.widget(other).set_bounds(rect(0, 1, 16, 1))
    testing.AssertTrue(s.focus(other))
    s.present()
    testing.AssertFalse(s.dirty)
    testing.AssertFalse(s.dispatch(key("j")))
    testing.AssertFalse(s.dirty)
    s.present()
    testing.AssertEqStr(s.buffer.row_text(0), "inbox           ")
    testing.AssertTrue(tui.StyleEq(s.buffer.get(0, 0).style, tui.Style { bg = tui.BrightBlack }))
end

func test_unicode_codepoint_clip():
    mut v := Vector {} as Vector<str>
    v.push("éééx")
    v.push("asdf")
    l := tui.NewList(v)
    testing.AssertTrue(l.focusable())
    mut b3 := frame(l, 3, 1, true)
    defer b3.free()
    testing.AssertEqStr(b3.row_text(0), "ééé")
    testing.AssertEqStr(b3.get(0, 0).ch, "é")
    testing.AssertTrue(tui.StyleEq(b3.get(0, 0).style, tui.Style { reverse = true }))
    mut b2 := frame(l, 2, 1, true)
    defer b2.free()
    testing.AssertEqStr(b2.row_text(0), "éé")
end

func test_unicode_cell_clip():
    mut v := Vector {} as Vector<str>
    v.push("中文字")
    l := tui.NewList(v)
    mut b := frame(l, 4, 1, true)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "中文")
    testing.AssertEqStr(b.get(0, 0).ch, "中")
    testing.AssertEqStr(b.get(1, 0).ch, "")
    testing.AssertEqStr(b.get(2, 0).ch, "文")
    testing.AssertEqStr(b.get(3, 0).ch, "")
end

func test_sgr_defaults_probe():
    mut lf := tui.NewList(items3())
    lf.set_bounds(rect(0, 0, 10, 3))
    mut bf := tui.NewBuffer(10, 3)
    defer bf.free()
    bf.focused = true
    before := tui.SgrBuilds()
    lf.render(bf, rect(0, 0, 10, 3))
    testing.AssertEqInt(tui.SgrBuilds() - before, 0)
    _ := bf.ansi()
    testing.AssertEqInt(tui.SgrBuilds() - before, 2)

    mut lc := tui.NewList(items3())
    lc.set_bounds(rect(0, 0, 10, 3))
    lc.selected_style = tui.Style { bold = true }
    mut bc := tui.NewBuffer(10, 3)
    defer bc.free()
    bc.focused = true
    lc.render(bc, rect(0, 0, 10, 3))
    testing.AssertTrue(tui.StyleEq(bc.get(0, 0).style, tui.Style { bold = true }))

    mut lp := tui.NewList(items3())
    lp.set_bounds(rect(0, 0, 10, 3))
    lp.selected_style = tui.StyleDefault
    mut bp := tui.NewBuffer(10, 3)
    defer bp.free()
    bp.focused = true
    lp.render(bp, rect(0, 0, 10, 3))
    testing.AssertTrue(tui.StyleEq(bp.get(0, 0).style, tui.StyleDefault))
end

func test_zero_value_list_selected_index():
    l := tui.List {}
    testing.AssertEqInt(l.selected_index(), -1)
    testing.AssertEqStr(l.selected_item(), "")
end

