func test_scroll_starts_and_invariant():
    mut l := tui.NewList(items10())
    l.set_bounds(rect(0, 0, 10, 3))
    mut b := tui.NewBuffer(10, 3)
    defer b.free()
    b.focused = true
    refresh(l, b)
    testing.AssertEqInt(start_from(items10(), b), 0)
    repeat 9 in step:
        _ := l.handle_event(key("j"))
        refresh(l, b)
        sel := l.selected_index()
        st := start_from(items10(), b)
        testing.AssertTrue(st >= 0)
        testing.AssertTrue(sel >= st)
        testing.AssertTrue(sel < st + 3)
        if step == 2:
            testing.AssertEqInt(sel, 3)
            testing.AssertEqInt(st, 1)
        end
        if step == 4:
            testing.AssertEqInt(sel, 5)
            testing.AssertEqInt(st, 3)
        end
        if step == 8:
            testing.AssertEqInt(sel, 9)
            testing.AssertEqInt(st, 7)
        end
    end
    repeat 3:
        _ := l.handle_event(key("k"))
    end
    refresh(l, b)
    testing.AssertEqInt(l.selected_index(), 6)
    testing.AssertEqInt(start_from(items10(), b), 6)
end

func test_scroll_from_start_jumps():
    a := list_at(3, 3)
    mut b1 := frame(a, 10, 3, true)
    defer b1.free()
    testing.AssertEqInt(start_from(items10(), b1), 1)
    c := list_at(5, 3)
    mut b2 := frame(c, 10, 3, true)
    defer b2.free()
    testing.AssertEqInt(start_from(items10(), b2), 3)
    d := list_at(9, 3)
    mut b3 := frame(d, 10, 3, true)
    defer b3.free()
    testing.AssertEqInt(start_from(items10(), b3), 7)
end

