func test_frame_f16_w4_h1():
    mut b := frame(list_at(2, 1), 4, 1, true)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "sent")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.Style { reverse = true }))
    seq_on := tui.StyleSgr(tui.Style { reverse = true }, tui.ColorTier.TrueColor)
    seq_off := tui.StyleSgrOff(tui.Style { reverse = true }, tui.ColorTier.TrueColor)
    want := term.SeqMoveTo(1, 1) + seq_on + "sent" + seq_off
    testing.AssertEqStr(b.ansi(), want)
end

