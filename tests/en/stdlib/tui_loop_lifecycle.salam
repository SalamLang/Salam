// Headless lifecycle and event-loop tests. No terminal is used: the screen is
// never start()ed (the only start() call is the post-close guard), so present()
// draws into the buffer without writing to the terminal. run() is driven to
// completion by an unconsumed Ctrl+C, which stops the loop, so run() always
// returns. Every event in the scripted loop goes through the real events
// channel (post / next_event), the real dispatch path, the keymap fallback,
// and the real draw path. A consumed event queues that widget's bounds and the
// next present repaints them; an unconsumed one changes nothing. The buffer is
// never touched after close(), which frees it.

import testing
import term

import tui

// Bumped by App.render, so a test can tell how many frames run() drew.
mut renders := 0

// Bumped by the scripted loop's button, so a click test reads a module
// global rather than trying to downcast the screen's dyn widget copy.
mut clicks := 0

// Root widget: paints "app" at the origin and counts every render.
struct App:
    pub use tui.BaseWidget

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        renders += 1
        buf.put_str(bounds.x, bounds.y, "app", tui.StyleDefault)
    end
end

// One cell that consumes "r" and flips its mark, so a key that run() delivers
// leaves a visible new glyph in the buffer.
struct Spot:
    pub use tui.BaseWidget
    pub mark: str = "a"

    pub func focusable(): bool:
        ret true
    end

    pub func handle_event(event: tui.Event): bool:
        if not event.is_char("r"):
            ret false
        end
        if this.mark == "a":
            this.mark = "b"
        else:
            this.mark = "a"
        end
        ret true
    end

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        buf.put_str(bounds.x, bounds.y, this.mark, tui.StyleDefault)
    end
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func key(seq: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(seq) }
end

// A key with no character payload, for Tab, Enter and friends.
func special(code: int): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Key { code = code } }
end

// A left-button press as the terminal reports it: SGR coordinates are
// 1-based, so cell (x, y) arrives as column x + 1, row y + 1.
func click(x: int, y: int): tui.Event:
    seq := "\x1b[<0;" + (x + 1) + ";" + (y + 1) + "M"
    ret tui.Event { kind = tui.MouseEvent, key = term.Key { raw = seq }, mouse = term.DecodeMouse(seq) }
end

// Posts ev, receives it, dispatches it. Returns dispatch's result.
// next_event blocks until an event arrives, so the post always comes first.
func pump(s &: tui.Screen, ev: tui.Event): bool:
    _ := s.post(ev)
    mut got := tui.Event {}
    _ := s.next_event(got)
    ret s.dispatch(got)
end

// The whole grid, row by row, rows joined with "|".
func frame(s &: tui.Screen): str:
    mut out := ""
    repeat s.buffer.height in y:
        if y > 0:
            out = out + "|"
        end
        out = out + s.buffer.row_text(y)
    end
    ret out
end

func test_new_screen_state():
    mut s := tui.NewScreen(tui.BaseWidget {}, 20, 8)
    defer s.close()
    testing.AssertFalse(s.running)
    testing.AssertEqInt(s.buffer.width, 20)
    testing.AssertEqInt(s.buffer.height, 8)
    testing.AssertEqInt(s.tree.count(), 1)
    testing.AssertEqInt(s.focused_id(), tui.NoWidget)
    b := s.root.bounds()
    testing.AssertEqInt(b.x, 0)
    testing.AssertEqInt(b.y, 0)
    testing.AssertEqInt(b.width, 20)
    testing.AssertEqInt(b.height, 8)
    testing.AssertTrue(s.dirty)
    testing.AssertFalse(s.mouse_motion)
end

// run() presents once, then stops on a Ctrl+C no widget consumed.
func test_run_exits_on_unconsumed_ctrl_c():
    mut s := tui.NewScreen(App {}, 20, 8)
    defer s.close()
    renders = 0
    testing.AssertTrue(s.post(key("\x03")))
    s.run()
    testing.AssertFalse(s.running)
    testing.AssertEqInt(renders, 1)
end

// run() delivers events to widgets: the focused Spot consumes "r" and
// repaints its cell, so the loop, not just dispatch, moved the state.
func test_run_consumed_key_changes_state():
    mut s := tui.NewScreen(tui.BaseWidget {}, 20, 8)
    defer s.close()
    spot := Spot {} as dyn tui.Widget
    id := s.add(tui.RootId, spot)
    s.widget(id).set_bounds(rect(0, 0, 1, 1))
    testing.AssertEqInt(s.focused_id(), id)
    testing.AssertTrue(s.post(key("r")))
    testing.AssertTrue(s.post(key("\x03")))
    s.run()
    testing.AssertFalse(s.running)
    testing.AssertEqStr(s.buffer.get(0, 0).ch, "b")
end

// close() stops the loop on its own. Nothing else is asserted: close frees
// the buffer and the channel.
func test_close_without_stop():
    mut s := tui.NewScreen(tui.BaseWidget {}, 4, 1)
    s.close()
    testing.AssertFalse(s.running)
end

// start() after close() returns on the closed guard and does not attach.
func test_start_after_close_is_a_noop():
    mut s := tui.NewScreen(tui.BaseWidget {}, 4, 1)
    s.close()
    s.start()
    testing.AssertFalse(s.running)
end

func test_scripted_event_loop():
    mut s := tui.NewScreen(App {}, 20, 8)
    defer s.close()
    s.set_keymap(tui.NewDefaultKeymap())
    clicks = 0

    inp := tui.NewInput() as dyn tui.Widget
    inbox := s.add(tui.RootId, inp)
    s.widget(inbox).set_bounds(rect(1, 1, 12, 1))

    box := tui.NewCheckbox("Wrap", false) as dyn tui.Widget
    wrapped := s.add(tui.RootId, box)
    s.widget(wrapped).set_bounds(rect(1, 3, 12, 1))

    mut btn := tui.NewButton("Run")
    btn.on_click = (): clicks += 1 end
    launch := s.add(tui.RootId, btn as dyn tui.Widget)
    s.widget(launch).set_bounds(rect(1, 4, 12, 1))

    // The input is always focusable and was added first, so it holds focus.
    testing.AssertEqInt(s.focused_id(), inbox)

    // 1. The focused input consumes printable characters. No downcast exists,
    // so the value is read off the frame the widget painted.
    testing.AssertTrue(pump(s, key("h")))
    testing.AssertTrue(pump(s, key("i")))
    s.present()
    testing.AssertEqStr(s.buffer.get(1, 1).ch, "h")
    testing.AssertEqStr(s.buffer.get(2, 1).ch, "i")

    // 2. No widget consumes Tab, so the keymap fallback runs focus_next and
    // dispatch reports the keymap's consumption.
    testing.AssertTrue(pump(s, special(term.KeyTab)))
    testing.AssertEqInt(s.focused_id(), wrapped)

    // 3. Space reaches the checkbox now that it holds focus.
    testing.AssertTrue(pump(s, key(" ")))
    s.present()
    testing.AssertEqStr(s.buffer.get(2, 3).ch, "x")

    // 4. Tab again, onto the button.
    testing.AssertTrue(pump(s, special(term.KeyTab)))
    testing.AssertEqInt(s.focused_id(), launch)

    // 5. Enter activates the focused button.
    testing.AssertTrue(pump(s, special(term.KeyEnter)))
    testing.AssertEqInt(clicks, 1)

    // 6. Tab wraps to the first focusable widget.
    testing.AssertTrue(pump(s, special(term.KeyTab)))
    testing.AssertEqInt(s.focused_id(), inbox)

    // 7. A click on the button centre activates it. Focus stays on the input:
    // clicks never move focus.
    testing.AssertTrue(pump(s, click(7, 4)))
    testing.AssertEqInt(clicks, 2)
    testing.AssertEqInt(s.focused_id(), inbox)

    // 8. A resize reallocates the buffer and refits the root, so the next
    // frame is a forced full repaint.
    testing.AssertFalse(pump(s, tui.Event { kind = tui.ResizeEvent, width = 24, height = 10 }))
    testing.AssertEqInt(s.buffer.width, 24)
    testing.AssertEqInt(s.buffer.height, 10)
    b := s.root.bounds()
    testing.AssertEqInt(b.x, 0)
    testing.AssertEqInt(b.y, 0)
    testing.AssertEqInt(b.width, 24)
    testing.AssertEqInt(b.height, 10)
    testing.AssertEqStr(s.buffer.diff(), s.buffer.ansi())
    s.present()
    s.buffer.commit()

    // 9. A tick is unconsumed outside run_with_tick and changes no state.
    testing.AssertFalse(pump(s, tui.Event { kind = tui.TickEvent }))
    testing.AssertFalse(s.running)

    // 10. An unconsumed Ctrl+C is the loop's stop rule, applied by hand.
    ev := key("\x03")
    consumed := pump(s, ev)
    testing.AssertFalse(consumed)
    if not consumed and ev.is_ctrl("c"):
        s.stop()
    end
    mut last := tui.Event {}
    testing.AssertFalse(s.next_event(last))
    testing.AssertFalse(s.running)

    testing.AssertEqStr(frame(s), "app                     | hi                     |                        | [x] Wrap               | [   Run    ]           |                        |                        |                        |                        |                        ")
end

func main:
    test_new_screen_state()
    test_run_exits_on_unconsumed_ctrl_c()
    test_run_consumed_key_changes_state()
    test_close_without_stop()
    test_start_after_close_is_a_noop()
    test_scripted_event_loop()
    ret testing.Summary()
end
