import testing
import term
import tui

mut visits := Vector {} as Vector<str>

struct Recorder:
    pub use tui.BaseWidget
    pub name: str = ""
    pub takes_mouse: bool = false
    pub takes_keys: bool = false
    pub can_focus: bool = false
    pub allow_hits: bool = true

    pub func handle_event(event: tui.Event): bool:
        visits.Push(this.name)
        if event.kind == tui.MouseEvent:
            ret this.takes_mouse
        end
        ret event.kind == tui.KeyEvent and this.takes_keys
    end

    pub func focusable(): bool:
        ret this.can_focus
    end

    pub func hits(): bool:
        ret this.allow_hits
    end
end

struct Shutter:
    pub use tui.BaseWidget
    pub shown: bool = true

    pub func visible(): bool:
        ret this.shown
    end
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func click(x: int, y: int): tui.Event:
    seq := "\x1b[<0;" + (x + 1) + ";" + (y + 1) + "M"
    ret tui.Event { kind = tui.MouseEvent, key = term.Key { raw = seq }, mouse = term.DecodeMouse(seq) }
end

func key(ch: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(ch) }
end

func trail(): str:
    mut out := ""
    each i, v in visits:
        if i > 0:
            out += ">"
        end
        out += v
    end
    visits.Clear()
    ret out
end

func build(): tui.Screen:
    mut s := tui.NewScreen(Recorder { name = "root" }, 20, 10)
    panel := s.Add(tui.RootId, Recorder { name = "panel", can_focus = true, takes_keys = true })
    child := s.Add(panel, Recorder { name = "child" })
    overlay := s.Add(tui.RootId, Recorder { name = "overlay" })
    s.widget(panel).SetBounds(rect(0, 0, 10, 5))
    s.widget(child).SetBounds(rect(2, 1, 4, 2))
    s.widget(overlay).SetBounds(rect(4, 1, 4, 3))
    ret s
end

func test_mouse_point_is_zero_based():
    testing.AssertEqInt(click(0, 0).mouse_point().x, 0)
    testing.AssertEqInt(click(0, 0).mouse_point().y, 0)
    testing.AssertEqInt(click(7, 3).mouse_point().x, 7)
    testing.AssertEqInt(click(7, 3).mouse_point().y, 3)
end

func test_hit_test_picks_topmost():
    mut s := build()
    defer s.Close()
    testing.AssertEqInt(s.hit_test(2, 1), 2)
    testing.AssertEqInt(s.hit_test(0, 0), 1)
    testing.AssertEqInt(s.hit_test(15, 8), tui.RootId)
    testing.AssertEqInt(s.hit_test(4, 1), 3)
    testing.AssertEqInt(s.hit_test(5, 2), 3)
    testing.AssertEqInt(s.hit_test(6, 1), 3)
    testing.AssertEqInt(s.hit_test(8, 1), 1)
    testing.AssertEqInt(s.hit_test(4, 3), 3)
    testing.AssertEqInt(s.hit_test(4, 4), 1)
end

func test_hit_test_outside_screen():
    mut s := build()
    defer s.Close()
    testing.AssertEqInt(s.hit_test(20, 0), tui.NoWidget)
    testing.AssertEqInt(s.hit_test(0, 10), tui.NoWidget)
    testing.AssertEqInt(s.hit_test(-1, -1), tui.NoWidget)
end

func test_hit_test_skips_empty_bounds():
    mut s := build()
    defer s.Close()
    ghost := s.Add(tui.RootId, Recorder { name = "ghost" })
    s.widget(ghost).SetBounds(rect(12, 5, 0, 3))
    testing.AssertEqInt(s.hit_test(12, 5), tui.RootId)
end

func test_hit_test_skips_hidden_subtree():
    mut s := tui.NewScreen(Recorder { name = "root" }, 20, 10)
    defer s.Close()
    top := s.Add(tui.RootId, Recorder { name = "top" })
    sh := s.Add(tui.RootId, Shutter { shown = false })
    kid := s.Add(sh, Recorder { name = "kid" })
    below := s.Add(tui.RootId, Recorder { name = "below" })
    s.widget(top).SetBounds(rect(0, 0, 10, 5))
    s.widget(sh).SetBounds(rect(0, 0, 10, 5))
    s.widget(kid).SetBounds(rect(0, 0, 10, 5))
    s.widget(below).SetBounds(rect(12, 0, 4, 1))
    testing.AssertEqInt(s.hit_test(1, 1), top)
    testing.AssertEqInt(s.hit_test(12, 0), below)

    mut shown := tui.NewScreen(Recorder { name = "root" }, 20, 10)
    defer shown.Close()
    top2 := shown.Add(tui.RootId, Recorder { name = "top" })
    sh2 := shown.Add(tui.RootId, Shutter { shown = true })
    kid2 := shown.Add(sh2, Recorder { name = "kid" })
    shown.widget(top2).SetBounds(rect(0, 0, 10, 5))
    shown.widget(sh2).SetBounds(rect(0, 0, 10, 5))
    shown.widget(kid2).SetBounds(rect(0, 0, 10, 5))
    testing.AssertEqInt(shown.hit_test(1, 1), kid2)
end

func test_click_on_child_reaches_child_first():
    mut s := build()
    defer s.Close()
    testing.AssertFalse(s.dispatch(click(2, 1)))
    testing.AssertEqStr(trail(), "child>panel>root")
end

func test_child_consumes_and_parent_never_sees():
    mut s := tui.NewScreen(Recorder { name = "root" }, 20, 10)
    defer s.Close()
    panel := s.Add(tui.RootId, Recorder { name = "panel", can_focus = true })
    child := s.Add(panel, Recorder { name = "child", takes_mouse = true })
    s.widget(panel).SetBounds(rect(0, 0, 10, 5))
    s.widget(child).SetBounds(rect(2, 1, 4, 2))
    testing.AssertTrue(s.dispatch(click(3, 2)))
    testing.AssertEqStr(trail(), "child")
    testing.AssertTrue(s.dirty)
end

func test_click_never_moves_focus():
    mut s := tui.NewScreen(Recorder { name = "root" }, 20, 10)
    defer s.Close()
    one := s.Add(tui.RootId, Recorder { name = "one", can_focus = true })
    two := s.Add(tui.RootId, Recorder { name = "two", can_focus = true })
    s.widget(one).SetBounds(rect(0, 0, 10, 5))
    s.widget(two).SetBounds(rect(10, 0, 10, 5))
    testing.AssertEqInt(s.focused_id(), one)
    testing.AssertFalse(s.dispatch(click(12, 2)))
    testing.AssertEqStr(trail(), "two>root")
    testing.AssertEqInt(s.focused_id(), one)
end

func test_click_outside_children_goes_to_root():
    mut s := tui.NewScreen(Recorder { name = "root", takes_mouse = true }, 20, 10)
    defer s.Close()
    panel := s.Add(tui.RootId, Recorder { name = "panel", can_focus = true })
    s.widget(panel).SetBounds(rect(0, 0, 10, 5))
    testing.AssertTrue(s.dispatch(click(15, 8)))
    testing.AssertEqStr(trail(), "root")
end

func test_click_with_nothing_under_cursor_falls_back_to_focus():
    mut s := build()
    defer s.Close()
    testing.AssertFalse(s.dispatch(click(30, 3)))
    testing.AssertEqStr(trail(), "panel>root")
end

func test_overlapping_siblings_later_wins():
    mut s := build()
    defer s.Close()
    testing.AssertFalse(s.dispatch(click(4, 1)))
    testing.AssertEqStr(trail(), "overlay>root")
end

func test_undecoded_mouse_report_falls_back_to_focus():
    mut s := build()
    defer s.Close()
    ev := tui.Event { kind = tui.MouseEvent }
    testing.AssertFalse(s.dispatch(ev))
    testing.AssertEqStr(trail(), "panel>root")
end

func test_raised_widget_beats_later_sibling():
    mut s := build()
    defer s.Close()
    mut ids := Vector {} as Vector<int>
    defer ids.Free()
    ids.Push(1)
    testing.AssertEqInt(s.focused_id(), 1)
    s.raise(ids)
    testing.AssertEqInt(s.hit_test(4, 1), 1)
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertFalse(s.dispatch(click(4, 1)))
    testing.AssertEqStr(trail(), "panel>root")
end

func test_one_raise_shares_one_stamp():
    mut s := build()
    defer s.Close()
    mut ids := Vector {} as Vector<int>
    defer ids.Free()
    ids.Push(2)
    ids.Push(1)
    s.raise(ids)
    testing.AssertEqInt(s.hit_test(4, 1), 2)
    testing.AssertEqInt(s.focused_id(), 1)
end

func test_hits_false_is_skipped():
    mut s := tui.NewScreen(Recorder { name = "w0", can_focus = true }, 10, 4)
    defer s.Close()
    w1 := s.Add(tui.RootId, Recorder { name = "w1", can_focus = true })
    w2 := s.Add(tui.RootId, Recorder { name = "w2", can_focus = true })
    w3 := s.Add(tui.RootId, Recorder { name = "w3", allow_hits = false })
    s.widget(w1).SetBounds(rect(2, 1, 4, 2))
    s.widget(w2).SetBounds(rect(0, 0, 10, 4))
    s.widget(w3).SetBounds(rect(6, 1, 4, 2))
    testing.AssertTrue(s.focus(w2))
    mut ids := Vector {} as Vector<int>
    defer ids.Free()
    ids.Push(w1)
    s.raise(ids)
    testing.AssertEqInt(s.focused_id(), w1)
    testing.AssertEqInt(s.hit_test(3, 2), w1)
    testing.AssertEqInt(s.hit_test(7, 2), w2)
    testing.AssertEqInt(s.hit_test(0, 0), w2)
    testing.AssertEqInt(s.hit_test(9, 9), tui.NoWidget)
    testing.AssertFalse(s.dispatch(click(7, 2)))
    testing.AssertEqStr(trail(), "w2>w0")
    testing.AssertEqInt(s.focused_id(), w1)
end

func test_keyboard_still_goes_to_focused_widget():
    mut s := build()
    defer s.Close()
    testing.AssertTrue(s.dispatch(key("a")))
    testing.AssertEqStr(trail(), "panel")
    testing.AssertEqInt(s.focused_id(), 1)
end

func test_tick_and_resize_stay_on_focus_path():
    mut s := build()
    defer s.Close()
    testing.AssertFalse(s.dispatch(tui.Event { kind = tui.TickEvent }))
    testing.AssertEqStr(trail(), "panel>root")
    testing.AssertFalse(s.dispatch(tui.Event { kind = tui.ResizeEvent, width = 30, height = 12 }))
    testing.AssertEqStr(trail(), "panel>root")
    testing.AssertEqInt(s.buffer.width, 30)
end

func test_release_report_decodes_and_routes():
    mut s := build()
    defer s.Close()
    seq := "\x1b[<0;3;2m"
    mouse := term.DecodeMouse(seq)
    testing.AssertTrue(mouse.ok)
    testing.AssertFalse(mouse.pressed)
    ev := tui.Event { kind = tui.MouseEvent, key = term.Key { raw = seq }, mouse = mouse }
    testing.AssertFalse(s.dispatch(ev))
    testing.AssertEqStr(trail(), "child>panel>root")
end

func test_motion_report_decodes_and_routes():
    mut s := build()
    defer s.Close()
    seq := "\x1b[<35;3;2M"
    mouse := term.DecodeMouse(seq)
    testing.AssertTrue(mouse.ok)
    testing.AssertTrue(mouse.motion)
    testing.AssertTrue(mouse.pressed)
    testing.AssertEqInt(mouse.button, 3)
    ev := tui.Event { kind = tui.MouseEvent, key = term.Key { raw = seq }, mouse = mouse }
    testing.AssertFalse(s.dispatch(ev))
    testing.AssertEqStr(trail(), "child>panel>root")
end

func main:
    test_mouse_point_is_zero_based()
    test_hit_test_picks_topmost()
    test_hit_test_outside_screen()
    test_hit_test_skips_empty_bounds()
    test_hit_test_skips_hidden_subtree()
    test_click_on_child_reaches_child_first()
    test_child_consumes_and_parent_never_sees()
    test_click_never_moves_focus()
    test_click_outside_children_goes_to_root()
    test_click_with_nothing_under_cursor_falls_back_to_focus()
    test_overlapping_siblings_later_wins()
    test_raised_widget_beats_later_sibling()
    test_one_raise_shares_one_stamp()
    test_hits_false_is_skipped()
    test_undecoded_mouse_report_falls_back_to_focus()
    test_keyboard_still_goes_to_focused_widget()
    test_tick_and_resize_stay_on_focus_path()
    test_release_report_decodes_and_routes()
    test_motion_report_decodes_and_routes()
    visits.Free()
    ret testing.Summary()
end
