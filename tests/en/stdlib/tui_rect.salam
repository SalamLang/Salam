import testing
import tui

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func pt(x: int, y: int): tui.Point:
    ret tui.Point { x = x, y = y }
end

func test_contains():
    r := rect(2, 3, 4, 2)
    testing.AssertTrue(r.Contains(pt(2, 3)))
    testing.AssertTrue(r.Contains(pt(5, 4)))
    testing.AssertFalse(r.Contains(pt(6, 3)))
    testing.AssertFalse(r.Contains(pt(2, 5)))
    testing.AssertFalse(r.Contains(pt(1, 3)))
    testing.AssertFalse(r.Contains(pt(2, 2)))
end

func test_contains_empty():
    testing.AssertFalse(rect(0, 0, 0, 0).Contains(pt(0, 0)))
    testing.AssertFalse(rect(0, 0, 0, 5).Contains(pt(0, 1)))
    testing.AssertFalse(rect(0, 0, 5, 0).Contains(pt(1, 0)))
    testing.AssertFalse(rect(0, 0, -3, 4).Contains(pt(-1, 1)))
    testing.AssertTrue(rect(0, 0, 0, 0).IsEmpty())
    testing.AssertTrue(rect(0, 0, -1, 1).IsEmpty())
    testing.AssertFalse(rect(0, 0, 1, 1).IsEmpty())
end

func test_contains_negative():
    r := rect(-5, -2, 3, 3)
    testing.AssertTrue(r.Contains(pt(-5, -2)))
    testing.AssertTrue(r.Contains(pt(-3, 0)))
    testing.AssertFalse(r.Contains(pt(-2, 0)))
    testing.AssertFalse(r.Contains(pt(-3, 1)))
end

func test_intersects():
    a := rect(0, 0, 4, 4)
    testing.AssertTrue(a.intersects(rect(3, 3, 4, 4)))
    testing.AssertTrue(a.intersects(rect(1, 1, 1, 1)))
    testing.AssertTrue(rect(1, 1, 1, 1).intersects(a))
    testing.AssertTrue(a.intersects(a))
    testing.AssertFalse(a.intersects(rect(10, 10, 2, 2)))
end

func test_intersects_touching():
    a := rect(0, 0, 4, 4)
    testing.AssertFalse(a.intersects(rect(4, 0, 2, 4)))
    testing.AssertFalse(a.intersects(rect(0, 4, 4, 2)))
    testing.AssertFalse(a.intersects(rect(4, 4, 1, 1)))
    testing.AssertFalse(rect(-2, 0, 2, 4).intersects(a))
end

func test_intersects_empty():
    a := rect(0, 0, 4, 4)
    testing.AssertFalse(a.intersects(rect(1, 1, 0, 0)))
    testing.AssertFalse(rect(1, 1, 0, 2).intersects(a))
    testing.AssertFalse(rect(1, 1, 0, 0).intersects(rect(1, 1, 0, 0)))
end

func test_intersects_negative():
    a := rect(-4, -4, 5, 5)
    testing.AssertTrue(a.intersects(rect(0, 0, 3, 3)))
    testing.AssertFalse(a.intersects(rect(1, 0, 3, 3)))
end

func test_intersection():
    i := rect(0, 0, 4, 4).intersection(rect(2, 1, 5, 2))
    testing.AssertEqInt(i.x, 2)
    testing.AssertEqInt(i.y, 1)
    testing.AssertEqInt(i.width, 2)
    testing.AssertEqInt(i.height, 2)
    none := rect(0, 0, 4, 4).intersection(rect(4, 0, 2, 2))
    testing.AssertTrue(none.IsEmpty())
end

func test_center():
    c := rect(0, 0, 3, 3).center()
    testing.AssertEqInt(c.x, 1)
    testing.AssertEqInt(c.y, 1)
    e := rect(0, 0, 4, 4).center()
    testing.AssertEqInt(e.x, 2)
    testing.AssertEqInt(e.y, 2)
    n := rect(-6, -4, 4, 2).center()
    testing.AssertEqInt(n.x, -4)
    testing.AssertEqInt(n.y, -3)
    one := rect(7, 9, 1, 1).center()
    testing.AssertEqInt(one.x, 7)
    testing.AssertEqInt(one.y, 9)
end

func test_edges():
    r := rect(2, 3, 4, 5)
    testing.AssertEqInt(r.right(), 6)
    testing.AssertEqInt(r.bottom(), 8)
end

func test_intersection_contained():
    inner := rect(2, 3, 4, 2)
    i := rect(0, 0, 10, 10).intersection(inner)
    testing.AssertEqInt(i.x, 2)
    testing.AssertEqInt(i.y, 3)
    testing.AssertEqInt(i.width, 4)
    testing.AssertEqInt(i.height, 2)
end

func test_intersection_symmetry():
    a := rect(0, 0, 4, 4)
    b := rect(2, 1, 5, 2)
    ab := a.intersection(b)
    ba := b.intersection(a)
    testing.AssertEqInt(ab.x, 2)
    testing.AssertEqInt(ab.y, 1)
    testing.AssertEqInt(ab.width, 2)
    testing.AssertEqInt(ab.height, 2)
    testing.AssertEqInt(ab.x, ba.x)
    testing.AssertEqInt(ab.y, ba.y)
    testing.AssertEqInt(ab.width, ba.width)
    testing.AssertEqInt(ab.height, ba.height)
end

func test_intersection_negative():
    i := rect(-5, -3, 4, 5).intersection(rect(-3, -1, 4, 4))
    testing.AssertEqInt(i.x, -3)
    testing.AssertEqInt(i.y, -1)
    testing.AssertEqInt(i.width, 2)
    testing.AssertEqInt(i.height, 3)
end

func test_intersection_no_overlap():
    none := rect(0, 0, 4, 4).intersection(rect(4, 0, 2, 2))
    testing.AssertEqInt(none.x, 0)
    testing.AssertEqInt(none.y, 0)
    testing.AssertEqInt(none.width, 0)
    testing.AssertEqInt(none.height, 0)
    testing.AssertTrue(none.IsEmpty())
end

func test_edges_edge_inputs():
    n := rect(-3, -4, 5, 2)
    testing.AssertEqInt(n.right(), 2)
    testing.AssertEqInt(n.bottom(), -2)
    z := rect(0, 0, 0, 0)
    testing.AssertEqInt(z.right(), 0)
    testing.AssertEqInt(z.bottom(), 0)
    d := rect(2, 3, -1, -2)
    testing.AssertEqInt(d.right(), 1)
    testing.AssertEqInt(d.bottom(), 1)
    w := rect(-5, -6, 0, 3)
    testing.AssertEqInt(w.right(), -5)
    testing.AssertEqInt(w.bottom(), -3)
end

func test_is_empty():
    testing.AssertTrue(rect(0, 0, 0, 5).IsEmpty())
    testing.AssertTrue(rect(0, 0, -1, 5).IsEmpty())
    testing.AssertTrue(rect(0, 0, 5, 0).IsEmpty())
    testing.AssertTrue(rect(0, 0, 5, -1).IsEmpty())
    testing.AssertTrue(rect(0, 0, -2, -2).IsEmpty())
    testing.AssertFalse(rect(0, 0, 1, 1).IsEmpty())
end

func test_boundary_negative():
    r := rect(-5, -2, 3, 3)
    testing.AssertTrue(r.Contains(pt(-3, -2)))
    testing.AssertFalse(r.Contains(pt(-2, -2)))
    testing.AssertTrue(r.Contains(pt(-5, 0)))
    testing.AssertFalse(r.Contains(pt(-5, 1)))
    testing.AssertTrue(r.intersects(rect(-3, 0, 1, 1)))
    testing.AssertFalse(r.intersects(rect(-2, 0, 1, 1)))
    testing.AssertTrue(r.intersects(rect(-5, 0, 1, 1)))
    testing.AssertFalse(r.intersects(rect(-5, 1, 1, 1)))
end

func main:
    test_contains()
    test_contains_empty()
    test_contains_negative()
    test_intersects()
    test_intersects_touching()
    test_intersects_empty()
    test_intersects_negative()
    test_intersection()
    test_center()
    test_edges()
    test_intersection_contained()
    test_intersection_symmetry()
    test_intersection_negative()
    test_intersection_no_overlap()
    test_edges_edge_inputs()
    test_is_empty()
    test_boundary_negative()
    ret testing.Summary()
end
