// Whole-frame snapshot tests for composed widget scenes. No terminal is used:
// the screen is never start()ed, so present() only paints into the buffer and
// every assertion reads that buffer. The text frames join the rows of the
// screen's buffer; one small literal ANSI frame pins styling that text cannot
// show.

import str
import testing

import tui

// Widget ids in scene(), fixed by add order.
SaveId := 3
WrapId := 4

// Draws "no" in reverse video through a widget of its own, so the ANSI
// snapshot pins a reverse cell next to a styled one.
struct RevText:
    pub use tui.BaseWidget
    pub text: str = ""

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        buf.put_str(bounds.x, bounds.y, this.text, tui.Style { reverse = true })
    end
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

// Joins every buffer row with "|", so a frame is one comparable string.
func frame(s: tui.Screen): str:
    mut out := ""
    repeat s.buffer.height in y:
        if y > 0:
            out += "|"
        end
        out += s.buffer.row_text(y)
    end
    ret out
end

// The composed scene shared by the snapshot tests: title, rule, button,
// checkbox, progress and status on a 24x6 screen.
func scene(): tui.Screen:
    mut s := tui.NewScreen(tui.BaseWidget {}, 24, 6)
    title := s.add(tui.RootId, tui.NewText("basalam") as dyn tui.Widget)
    s.widget(title).set_bounds(rect(1, 0, 10, 1))
    rule := s.add(tui.RootId, tui.NewSeparator() as dyn tui.Widget)
    s.widget(rule).set_bounds(rect(1, 1, 20, 1))
    save := s.add(tui.RootId, tui.NewButton("Save") as dyn tui.Widget)
    s.widget(save).set_bounds(rect(1, 2, 10, 1))
    wrap := s.add(tui.RootId, tui.NewCheckbox("Wrap", true) as dyn tui.Widget)
    s.widget(wrap).set_bounds(rect(12, 2, 10, 1))
    mut p := tui.NewProgress()
    p.set_progress(40)
    load := s.add(tui.RootId, p as dyn tui.Widget)
    s.widget(load).set_bounds(rect(1, 3, 20, 1))
    status := s.add(tui.RootId, tui.NewText("ready") as dyn tui.Widget)
    s.widget(status).set_bounds(rect(1, 4, 20, 1))
    ret s
end

func test_scene_frame_is_a_snapshot():
    mut s := scene()
    defer s.close()
    testing.AssertTrue(s.focus(SaveId))
    testing.AssertEqInt(s.focused_id(), SaveId)
    s.present()
    testing.AssertEqStr(frame(s), " basalam                | ────────────────────   | [  Save  ] [x] Wrap    | ######---------  40%   | ready                  |                        ")
end

// Focus must repaint style only, never shift a glyph.
func test_focus_changes_only_styles():
    mut s := scene()
    defer s.close()
    testing.AssertTrue(s.focus(SaveId))
    s.present()
    before := frame(s)
    save_style := s.buffer.get(1, 2).style
    wrap_style := s.buffer.get(12, 2).style
    testing.AssertFalse(tui.StyleEq(save_style, tui.StyleDefault))

    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), WrapId)
    s.present()
    testing.AssertEqStr(frame(s), before)
    testing.AssertTrue(tui.StyleEq(s.buffer.get(1, 2).style, tui.StyleDefault))
    testing.AssertFalse(tui.StyleEq(s.buffer.get(12, 2).style, tui.StyleDefault))
    testing.AssertFalse(tui.StyleEq(save_style, s.buffer.get(1, 2).style))
    testing.AssertFalse(tui.StyleEq(wrap_style, s.buffer.get(12, 2).style))
end

// A widget wider than the screen is cut at the buffer edge, not wrapped.
func test_clipped_widget_frame():
    mut s := tui.NewScreen(tui.BaseWidget {}, 12, 2)
    defer s.close()
    id := s.add(tui.RootId, tui.NewText("abcdefghijklmnop") as dyn tui.Widget)
    s.widget(id).set_bounds(rect(0, 0, 30, 1))
    s.present()

    testing.AssertEqInt(str.CharCount(s.buffer.row_text(0)), s.buffer.width)
    testing.AssertEqInt(str.CharCount(s.buffer.row_text(1)), s.buffer.width)
    testing.AssertEqStr(frame(s), "abcdefghijkl|            ")
end

// One literal 8x2 ANSI frame: bold and reverse survive into the bytes, and
// each style change is an off-then-on pair with no reset.
func test_ansi_frame_snapshot():
    mut s := tui.NewScreen(tui.BaseWidget {}, 8, 2)
    defer s.close()
    mut ok := tui.NewText("ok")
    ok.set_style(tui.Style { bold = true })
    oid := s.add(tui.RootId, ok as dyn tui.Widget)
    s.widget(oid).set_bounds(rect(0, 0, 2, 1))
    nid := s.add(tui.RootId, RevText { text = "no" } as dyn tui.Widget)
    s.widget(nid).set_bounds(rect(4, 0, 2, 1))
    s.present()

    testing.AssertEqStr(s.buffer.ansi(), "\x1b[1;1H\x1b[1mok\x1b[22m  \x1b[7mno\x1b[27m  \x1b[2;1H        ")
end

func main:
    test_scene_frame_is_a_snapshot()
    test_focus_changes_only_styles()
    test_clipped_widget_frame()
    test_ansi_frame_snapshot()
    ret testing.Summary()
end
