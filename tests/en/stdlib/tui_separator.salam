import testing
import term
import tui

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func key(seq: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(seq) }
end

func draw(s: tui.Separator, w: int, h: int): tui.Buffer:
    b := tui.NewBuffer(w, h)
    b.fill(rect(0, 0, w, h), "x", tui.StyleDefault)
    s.Render(b, rect(0, 0, w, h))
    ret b
end

func test_horizontal_paint():
    s := tui.NewSeparator()

    a := draw(s, 8, 1)
    defer a.Free()
    testing.AssertEqStr(a.row_text(0), "────────")

    b := draw(s, 8, 3)
    defer b.Free()
    testing.AssertEqStr(b.row_text(0), "────────")
    testing.AssertEqStr(b.row_text(1), "xxxxxxxx")
    testing.AssertEqStr(b.row_text(2), "xxxxxxxx")
end

func test_vertical_paint():
    mut s := tui.NewSeparator()
    s.set_orientation(tui.Orientation.Vertical)

    a := draw(s, 1, 4)
    defer a.Free()
    testing.AssertEqStr(a.Get(0, 0).ch, "│")
    testing.AssertEqStr(a.Get(0, 1).ch, "│")
    testing.AssertEqStr(a.Get(0, 2).ch, "│")
    testing.AssertEqStr(a.Get(0, 3).ch, "│")

    b := draw(s, 3, 3)
    defer b.Free()
    testing.AssertEqStr(b.row_text(0), "│xx")
    testing.AssertEqStr(b.row_text(1), "│xx")
    testing.AssertEqStr(b.row_text(2), "│xx")
end

func test_single_cell():
    h := tui.NewSeparator()
    a := draw(h, 1, 1)
    defer a.Free()
    testing.AssertEqStr(a.row_text(0), "─")

    mut v := tui.NewSeparator()
    v.set_orientation(tui.Orientation.Vertical)
    b := draw(v, 1, 1)
    defer b.Free()
    testing.AssertEqStr(b.row_text(0), "│")
end

func test_custom_rune():
    mut s := tui.NewSeparator()
    testing.AssertTrue(s.set_ch("="))
    a := draw(s, 5, 1)
    defer a.Free()
    testing.AssertEqStr(a.row_text(0), "=====")
end

func test_set_ch_rejects_wide():
    mut s := tui.NewSeparator()
    testing.AssertFalse(s.set_ch("中"))
    a := draw(s, 4, 1)
    defer a.Free()
    testing.AssertEqStr(a.row_text(0), "────")

    testing.AssertTrue(s.set_ch("-"))
    b := draw(s, 4, 1)
    defer b.Free()
    testing.AssertEqStr(b.row_text(0), "----")
end

func test_set_ch_rejects_zero_width_keeps_previous():
    mut s := tui.NewSeparator()
    testing.AssertTrue(s.set_ch("="))
    testing.AssertFalse(s.set_ch("​"))
    a := draw(s, 3, 1)
    defer a.Free()
    testing.AssertEqStr(a.row_text(0), "===")

    testing.AssertTrue(s.set_ch(""))
    b := draw(s, 3, 1)
    defer b.Free()
    testing.AssertEqStr(b.row_text(0), "───")
end

func test_zero_length_paints_nothing():
    s := tui.NewSeparator()
    b := tui.NewBuffer(4, 1)
    defer b.Free()
    b.fill(rect(0, 0, 4, 1), "x", tui.StyleDefault)
    before := b.row_text(0)
    s.Render(b, rect(0, 0, 0, 1))
    testing.AssertEqStr(b.row_text(0), before)
    testing.AssertEqStr(b.row_text(0), "xxxx")
end

func test_style_fg_and_bg():
    mut s := tui.NewSeparator()
    st := tui.Style { fg = tui.Green, bg = tui.Color.Ansi(4) }
    s.set_style(st)

    b := tui.NewBuffer(6, 3)
    defer b.Free()
    b.fill(rect(0, 0, 6, 3), "x", tui.StyleDefault)
    s.Render(b, rect(0, 0, 3, 3))
    testing.AssertTrue(tui.StyleEq(b.Get(0, 0).style, st))
    testing.AssertEqStr(b.Get(0, 0).ch, "─")

    testing.AssertTrue(tui.StyleEq(b.Get(1, 1).style, tui.Style { bg = tui.Color.Ansi(4) }))
    testing.AssertEqStr(b.Get(1, 1).ch, " ")

    testing.AssertEqStr(b.Get(4, 0).ch, "x")
    testing.AssertTrue(tui.StyleEq(b.Get(4, 0).style, tui.StyleDefault))
end

func test_style_fg_without_bg_leaves_off_line_cells():
    mut s := tui.NewSeparator()
    s.set_style(tui.Style { fg = tui.Green })
    b := tui.NewBuffer(4, 3)
    defer b.Free()
    b.fill(rect(0, 0, 4, 3), "x", tui.StyleDefault)
    s.Render(b, rect(0, 0, 4, 3))
    testing.AssertTrue(tui.StyleEq(b.Get(0, 0).style, tui.Style { fg = tui.Green }))
    testing.AssertEqStr(b.row_text(1), "xxxx")
    testing.AssertTrue(tui.StyleEq(b.Get(0, 1).style, tui.StyleDefault))
end

func test_style_bytes_at_emission():
    mut s := tui.NewSeparator()
    s.set_style(tui.Style { fg = tui.Green, bg = tui.Color.Ansi(4) })
    b := tui.NewBuffer(6, 3)
    defer b.Free()

    before := tui.SgrBuilds()
    s.Render(b, rect(0, 0, 6, 3))
    testing.AssertEqInt(tui.SgrBuilds() - before, 0)
    _ := b.ansi()
    testing.AssertEqInt(tui.SgrBuilds() - before, 4)

    mut u := tui.NewSeparator()
    u.set_style(tui.Style { fg = tui.Red })
    ub := tui.NewBuffer(4, 3)
    defer ub.Free()
    first := tui.SgrBuilds()
    u.Render(ub, rect(0, 0, 4, 3))
    testing.AssertEqInt(tui.SgrBuilds() - first, 0)
    _ := ub.ansi()
    testing.AssertEqInt(tui.SgrBuilds() - first, 2)
end

func test_predicates():
    mut s := tui.NewSeparator()
    testing.AssertFalse(s.Focusable())
    testing.AssertFalse(s.Hits())
    testing.AssertFalse(s.HandleEvent(key("q")))
    s.set_orientation(tui.Orientation.Vertical)
    testing.AssertFalse(s.Focusable())
    testing.AssertFalse(s.Hits())
    testing.AssertFalse(s.HandleEvent(key("q")))
end

func test_defaults():
    s := tui.NewSeparator()
    testing.AssertTrue(s.orientation == tui.Orientation.Horizontal)
    testing.AssertEqStr(s.ch, "")
    testing.AssertTrue(tui.StyleEq(s.style, tui.StyleDefault))
end

func test_preferred_size_and_measure():
    h := tui.NewSeparator()
    hp := h.PreferredSize(10)
    testing.AssertEqInt(hp.width, -1)
    testing.AssertEqInt(hp.height, 1)

    mut v := tui.NewSeparator()
    v.set_orientation(tui.Orientation.Vertical)
    vp := v.PreferredSize(10)
    testing.AssertEqInt(vp.width, 1)
    testing.AssertEqInt(vp.height, -1)

    hx := h.Measure(tui.Axis.X, 10)
    testing.AssertTrue(hx.ok)
    testing.AssertEqInt(hx.extent, 10)
    hy := h.Measure(tui.Axis.Y, 10)
    testing.AssertTrue(hy.ok)
    testing.AssertEqInt(hy.extent, 1)

    vx := v.Measure(tui.Axis.X, 10)
    testing.AssertTrue(vx.ok)
    testing.AssertEqInt(vx.extent, 1)
    vy := v.Measure(tui.Axis.Y, 10)
    testing.AssertTrue(vy.ok)
    testing.AssertEqInt(vy.extent, 10)
end

func test_ascii_policy_rune():
    mut b := tui.NewBuffer(3, 1)
    b.glyphs = tui.GlyphPolicy.ASCII
    tui.NewSeparator().Render(b, rect(0, 0, 3, 1))
    testing.AssertEqStr(b.row_text(0), "---")
    b.Free()
    mut v := tui.NewSeparator()
    v.set_orientation(tui.Orientation.Vertical)
    mut bv := tui.NewBuffer(1, 2)
    bv.glyphs = tui.GlyphPolicy.ASCII
    v.Render(bv, rect(0, 0, 1, 2))
    testing.AssertEqStr(bv.row_text(0) + bv.row_text(1), "||")
    bv.Free()
    mut c := tui.NewSeparator()
    testing.AssertTrue(c.set_ch("="))
    mut bc := tui.NewBuffer(2, 1)
    bc.glyphs = tui.GlyphPolicy.ASCII
    c.Render(bc, rect(0, 0, 2, 1))
    testing.AssertEqStr(bc.row_text(0), "==")
    bc.Free()
    testing.AssertTrue(c.set_ch("\u2550"))
    mut bd := tui.NewBuffer(2, 1)
    bd.glyphs = tui.GlyphPolicy.ASCII
    c.Render(bd, rect(0, 0, 2, 1))
    testing.AssertEqStr(bd.row_text(0), "--")
    bd.Free()
end

func main:
    test_horizontal_paint()
    test_vertical_paint()
    test_single_cell()
    test_custom_rune()
    test_set_ch_rejects_wide()
    test_set_ch_rejects_zero_width_keeps_previous()
    test_zero_length_paints_nothing()
    test_style_fg_and_bg()
    test_style_fg_without_bg_leaves_off_line_cells()
    test_style_bytes_at_emission()
    test_predicates()
    test_defaults()
    test_preferred_size_and_measure()
    test_ascii_policy_rune()
    ret testing.Summary()
end
