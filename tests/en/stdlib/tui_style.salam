import str
import testing
import term
import tui

func test_default_fields():
    s := tui.Style {}
    testing.AssertTrue(s.fg == tui.Color.Default)
    testing.AssertTrue(s.bg == tui.Color.Default)
    testing.AssertFalse(s.bold)
    testing.AssertFalse(s.dim)
    testing.AssertFalse(s.italic)
    testing.AssertFalse(s.underline)
    testing.AssertFalse(s.reverse)
    testing.AssertTrue(tui.StyleEq(s, tui.StyleDefault))
end

func test_partial_literal():
    s := tui.Style { bold = true }
    testing.AssertTrue(s.bold)
    testing.AssertTrue(s.fg == tui.Color.Default)
    testing.AssertFalse(s.italic)
    testing.AssertFalse(tui.StyleEq(s, tui.StyleDefault))
end

func test_border_inset():
    testing.AssertEqInt(tui.BorderInset(tui.BorderStyle.None), 0)
    testing.AssertEqInt(tui.BorderInset(tui.BorderStyle.Single), 1)
    testing.AssertEqInt(tui.BorderInset(tui.BorderStyle.Double), 1)
    testing.AssertEqInt(tui.BorderInset(tui.BorderStyle.Rounded), 1)
end

func test_merge_m1():
    got := tui.StyleMerge(tui.Style { fg = tui.Color.Ansi(2) }, tui.Style {})
    testing.AssertTrue(tui.StyleEq(got, tui.Style { fg = tui.Color.Ansi(2) }))
end

func test_merge_m2():
    got := tui.StyleMerge(tui.Style { fg = tui.Color.Ansi(2) }, tui.Style { fg = tui.Color.Ansi(1) })
    testing.AssertTrue(tui.StyleEq(got, tui.Style { fg = tui.Color.Ansi(1) }))
end

func test_merge_m3():
    parent := tui.Style { fg = tui.Color.Ansi(2), bg = tui.Color.Indexed(237) }
    got := tui.StyleMerge(parent, tui.Style { fg = tui.Color.Rgb(255, 135, 0) })
    want := tui.Style { fg = tui.Color.Rgb(255, 135, 0), bg = tui.Color.Indexed(237) }
    testing.AssertTrue(tui.StyleEq(got, want))
end

func test_merge_m4():
    got := tui.StyleMerge(tui.Style { bold = true }, tui.Style { italic = true })
    testing.AssertTrue(tui.StyleEq(got, tui.Style { bold = true, italic = true }))
end

func test_merge_m5_limitation():
    got := tui.StyleMerge(tui.Style { bold = true }, tui.Style {})
    testing.AssertTrue(tui.StyleEq(got, tui.Style { bold = true }))
end

func test_merge_m6_limitation():
    got := tui.StyleMerge(tui.Style { fg = tui.Color.Ansi(2) }, tui.Style { fg = tui.Color.Default })
    testing.AssertTrue(tui.StyleEq(got, tui.Style { fg = tui.Color.Ansi(2) }))
end

func test_merge_m7():
    got := tui.StyleMerge(tui.Style { dim = true }, tui.Style { bold = true })
    testing.AssertTrue(tui.StyleEq(got, tui.Style { bold = true, dim = true }))
end

func test_merge_m8():
    child := tui.Style { bg = tui.Color.Ansi(4), underline = true }
    got := tui.StyleMerge(tui.StyleDefault, child)
    testing.AssertTrue(tui.StyleEq(got, child))
end

func test_merge_m9_not_commutative():
    parent := tui.Style { fg = tui.Color.Ansi(1) }
    child := tui.Style { fg = tui.Color.Ansi(2) }
    testing.AssertTrue(tui.StyleEq(tui.StyleMerge(parent, child), tui.Style { fg = tui.Color.Ansi(2) }))
    testing.AssertTrue(tui.StyleEq(tui.StyleMerge(child, parent), tui.Style { fg = tui.Color.Ansi(1) }))
end

func test_merge_reverse():
    got := tui.StyleMerge(tui.StyleDefault, tui.Style { reverse = true })
    testing.AssertTrue(tui.StyleEq(got, tui.Style { reverse = true }))
    mixed := tui.StyleMerge(tui.Style { reverse = true }, tui.Style { bold = true })
    testing.AssertTrue(tui.StyleEq(mixed, tui.Style { bold = true, reverse = true }))
end

func test_merge_identity():
    s := tui.Style { fg = tui.Color.Ansi(2), bg = tui.Color.Indexed(237), bold = true }
    testing.AssertTrue(tui.StyleEq(tui.StyleMerge(tui.StyleDefault, s), s))
    testing.AssertTrue(tui.StyleEq(tui.StyleMerge(s, tui.StyleDefault), s))
end

func test_merge_m7_emits_bold_then_dim():
    got := tui.StyleMerge(tui.Style { dim = true }, tui.Style { bold = true })
    testing.AssertEqStr(tui.StyleSgr(got, tui.ColorTier.TrueColor), term.Sgr(term.StyleBold) + term.Sgr(term.StyleDim))
    testing.AssertEqStr(tui.StyleSgrOff(got, tui.ColorTier.TrueColor), term.Sgr(22))
end

func test_default_emits_nothing_at_every_tier():
    testing.AssertEqStr(tui.StyleSgr(tui.StyleDefault, tui.ColorTier.Off), "")
    testing.AssertEqStr(tui.StyleSgr(tui.StyleDefault, tui.ColorTier.Ansi16), "")
    testing.AssertEqStr(tui.StyleSgr(tui.StyleDefault, tui.ColorTier.Indexed256), "")
    testing.AssertEqStr(tui.StyleSgr(tui.StyleDefault, tui.ColorTier.TrueColor), "")
    testing.AssertEqStr(tui.StyleSgrOff(tui.StyleDefault, tui.ColorTier.Off), "")
    testing.AssertEqStr(tui.StyleSgrOff(tui.StyleDefault, tui.ColorTier.Ansi16), "")
    testing.AssertEqStr(tui.StyleSgrOff(tui.StyleDefault, tui.ColorTier.Indexed256), "")
    testing.AssertEqStr(tui.StyleSgrOff(tui.StyleDefault, tui.ColorTier.TrueColor), "")
end

func test_sgr_bold():
    s := tui.Style { bold = true }
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.TrueColor), term.Sgr(term.StyleBold))
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), term.Sgr(22))
end

func test_sgr_reverse_alone():
    s := tui.Style { reverse = true }
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.Off), term.Sgr(term.StyleReverse))
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.Ansi16), term.Sgr(term.StyleReverse))
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.Indexed256), term.Sgr(term.StyleReverse))
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.TrueColor), term.Sgr(term.StyleReverse))
end

func test_sgr_off_reverse_alone():
    s := tui.Style { reverse = true }
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.Off), term.Sgr(27))
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.Ansi16), term.Sgr(27))
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.Indexed256), term.Sgr(27))
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), term.Sgr(27))
end

func test_sgr_bold_then_reverse():
    s := tui.Style { bold = true, reverse = true }
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.TrueColor), term.Sgr(term.StyleBold) + term.Sgr(term.StyleReverse))
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), term.Sgr(22) + term.Sgr(27))
end

func test_sgr_fg_bold_truecolor():
    s := tui.Style { fg = tui.Color.Ansi(2), bold = true }
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.TrueColor), term.Sgr(term.StyleBold) + term.Sgr(term.FgGreen))
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), term.Sgr(22) + term.Sgr(term.FgDefault))
end

func test_sgr_all_attrs():
    s := tui.Style { bold = true, dim = true, italic = true, underline = true, reverse = true }
    attrs := term.Sgr(term.StyleBold) + term.Sgr(term.StyleDim) + term.Sgr(term.StyleItalic) + term.Sgr(term.StyleUnderline) + term.Sgr(term.StyleReverse)
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.Off), attrs)
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.TrueColor), attrs)
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), term.Sgr(22) + term.Sgr(23) + term.Sgr(24) + term.Sgr(27))
end

func test_sgr_colors_truecolor():
    s := tui.Style { fg = tui.Color.Rgb(255, 135, 0), bg = tui.Color.Indexed(237), underline = true }
    attrs := term.Sgr(term.StyleUnderline) + term.SeqFgRGB(255, 135, 0) + term.SeqBg256(237)
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.TrueColor), attrs)
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), term.Sgr(24) + term.Sgr(term.FgDefault) + term.Sgr(term.BgDefault))
end

func test_sgr_colors_indexed256():
    s := tui.Style { fg = tui.Color.Rgb(255, 135, 0), bg = tui.Color.Indexed(237), underline = true }
    attrs := term.Sgr(term.StyleUnderline) + term.SeqFg256(208) + term.SeqBg256(237)
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.Indexed256), attrs)
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.Indexed256), term.Sgr(24) + term.Sgr(term.FgDefault) + term.Sgr(term.BgDefault))
end

func test_sgr_colors_ansi16():
    s := tui.Style { fg = tui.Color.Rgb(255, 135, 0), bg = tui.Color.Indexed(237), underline = true }
    attrs := term.Sgr(term.StyleUnderline) + term.Sgr(term.FgYellow) + term.Sgr(term.BgBlack)
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.Ansi16), attrs)
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.Ansi16), term.Sgr(24) + term.Sgr(term.FgDefault) + term.Sgr(term.BgDefault))
end

func test_sgr_colors_off():
    s := tui.Style { fg = tui.Color.Rgb(255, 135, 0), bg = tui.Color.Indexed(237), underline = true }
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.Off), term.Sgr(term.StyleUnderline))
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.Off), term.Sgr(24))
end

func test_sgr_fg_default_skipped():
    s := tui.Style { fg = tui.Color.Ansi(1) }
    testing.AssertEqStr(tui.StyleSgr(s, tui.ColorTier.Off), "")
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.Off), "")
end

func test_sgr_off_bold_dim_single_22():
    s := tui.Style { bold = true, dim = true }
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), term.Sgr(22))
end

func test_sgr_off_order():
    s := tui.Style { bold = true, italic = true, underline = true, reverse = true, fg = tui.Color.Ansi(1), bg = tui.Color.Ansi(4) }
    want := term.Sgr(22) + term.Sgr(23) + term.Sgr(24) + term.Sgr(27) + term.Sgr(term.FgDefault) + term.Sgr(term.BgDefault)
    testing.AssertEqStr(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), want)
end

func test_eq_true():
    testing.AssertTrue(tui.StyleEq(tui.Style {}, tui.StyleDefault))
    a := tui.Style { fg = tui.Color.Ansi(1), bold = true }
    b := tui.Style { fg = tui.Color.Ansi(1), bold = true }
    testing.AssertTrue(tui.StyleEq(a, b))
end

func test_eq_false():
    testing.AssertFalse(tui.StyleEq(tui.Style { bold = true }, tui.Style {}))
    testing.AssertFalse(tui.StyleEq(tui.Style { dim = true }, tui.Style { bold = true }))
    testing.AssertFalse(tui.StyleEq(tui.Style { fg = tui.Color.Ansi(1) }, tui.Style { fg = tui.Color.Indexed(1) }))
    testing.AssertFalse(tui.StyleEq(tui.Style { fg = tui.Color.Rgb(255, 0, 0) }, tui.Style { fg = tui.Color.Indexed(196) }))
    testing.AssertFalse(tui.StyleEq(tui.Style { fg = tui.Color.Ansi(1) }, tui.Style {}))
    testing.AssertFalse(tui.StyleEq(tui.Style { reverse = true }, tui.StyleDefault))
    testing.AssertFalse(tui.StyleEq(tui.Style { bold = true, reverse = true }, tui.Style { bold = true }))
end

func test_eq_merge_results():
    m1 := tui.StyleMerge(tui.Style { bold = true }, tui.Style {})
    m2 := tui.StyleMerge(tui.Style {}, tui.Style { bold = true })
    testing.AssertFalse(tui.StyleEq(tui.Style {}, m1))
    testing.AssertTrue(tui.StyleEq(m1, m2))
end

func test_eq_implies_same_bytes():
    a := tui.Style { fg = tui.Color.Ansi(1), bold = true }
    b := tui.Style { fg = tui.Color.Ansi(1), bold = true }
    testing.AssertTrue(tui.StyleEq(a, b))
    testing.AssertEqStr(tui.StyleSgr(a, tui.ColorTier.TrueColor), tui.StyleSgr(b, tui.ColorTier.TrueColor))
    testing.AssertEqStr(tui.StyleSgr(a, tui.ColorTier.Indexed256), tui.StyleSgr(b, tui.ColorTier.Indexed256))
    testing.AssertEqStr(tui.StyleSgr(a, tui.ColorTier.Ansi16), tui.StyleSgr(b, tui.ColorTier.Ansi16))
    testing.AssertEqStr(tui.StyleSgr(a, tui.ColorTier.Off), tui.StyleSgr(b, tui.ColorTier.Off))
end

func test_eq_incomplete_at_off():
    a := tui.Style { fg = tui.Color.Ansi(1) }
    testing.AssertFalse(tui.StyleEq(a, tui.StyleDefault))
    testing.AssertEqStr(tui.StyleSgr(a, tui.ColorTier.Off), tui.StyleSgr(tui.StyleDefault, tui.ColorTier.Off))
end

func test_no_reset_in_output():
    s := tui.Style { fg = tui.Color.Ansi(1), bg = tui.Color.Rgb(1, 2, 3), bold = true, dim = true, italic = true, underline = true, reverse = true }
    testing.AssertFalse(str.Contains(tui.StyleSgr(s, tui.ColorTier.TrueColor), term.Reset))
    testing.AssertFalse(str.Contains(tui.StyleSgr(s, tui.ColorTier.Indexed256), term.Reset))
    testing.AssertFalse(str.Contains(tui.StyleSgr(s, tui.ColorTier.Ansi16), term.Reset))
    testing.AssertFalse(str.Contains(tui.StyleSgr(s, tui.ColorTier.Off), term.Reset))
    testing.AssertFalse(str.Contains(tui.StyleSgrOff(s, tui.ColorTier.TrueColor), term.Reset))
    testing.AssertFalse(str.Contains(tui.StyleSgrOff(s, tui.ColorTier.Indexed256), term.Reset))
    testing.AssertFalse(str.Contains(tui.StyleSgrOff(s, tui.ColorTier.Ansi16), term.Reset))
    testing.AssertFalse(str.Contains(tui.StyleSgrOff(s, tui.ColorTier.Off), term.Reset))
end

func test_sgr_builds_counts_emissions():
    before := tui.SgrBuilds()
    testing.AssertEqStr(tui.StyleSgr(tui.Style { bold = true }, tui.ColorTier.TrueColor), term.Sgr(term.StyleBold))
    testing.AssertEqInt(tui.SgrBuilds() - before, 1)
    testing.AssertEqStr(tui.StyleSgrOff(tui.Style { bold = true }, tui.ColorTier.TrueColor), term.Sgr(22))
    testing.AssertEqInt(tui.SgrBuilds() - before, 2)
    _ := tui.StyleSgr(tui.StyleDefault, tui.ColorTier.TrueColor)
    _ := tui.StyleSgrOff(tui.StyleDefault, tui.ColorTier.TrueColor)
    testing.AssertEqInt(tui.SgrBuilds() - before, 2)
end

func main:
    test_default_fields()
    test_partial_literal()
    test_border_inset()
    test_merge_m1()
    test_merge_m2()
    test_merge_m3()
    test_merge_m4()
    test_merge_m5_limitation()
    test_merge_m6_limitation()
    test_merge_m7()
    test_merge_m8()
    test_merge_m9_not_commutative()
    test_merge_reverse()
    test_merge_identity()
    test_merge_m7_emits_bold_then_dim()
    test_default_emits_nothing_at_every_tier()
    test_sgr_bold()
    test_sgr_reverse_alone()
    test_sgr_off_reverse_alone()
    test_sgr_bold_then_reverse()
    test_sgr_fg_bold_truecolor()
    test_sgr_all_attrs()
    test_sgr_colors_truecolor()
    test_sgr_colors_indexed256()
    test_sgr_colors_ansi16()
    test_sgr_colors_off()
    test_sgr_fg_default_skipped()
    test_sgr_off_bold_dim_single_22()
    test_sgr_off_order()
    test_eq_true()
    test_eq_false()
    test_eq_merge_results()
    test_eq_implies_same_bytes()
    test_eq_incomplete_at_off()
    test_no_reset_in_output()
    test_sgr_builds_counts_emissions()
    ret testing.Summary()
end
