    t.pad_x = 0
    t.add_column(fixed_col(2, tui.Alignment.Left))
    t.add_row(row1("中"))
    mut b := tui.NewBuffer(2, 1)
    mut tt := t
    tt.Render(b, rect(0, 0, 2, 1))
    testing.AssertEqStr(b.get(0, 0).ch, "中")
