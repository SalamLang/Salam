    t.pad_x = 0
    t.add_column(fixed_col(5, tui.Alignment.Left))
    t.add_row(row1("a"))
    t.set_cell_align(0, 0, tui.Alignment.Right)
    t.set_cell_align(0, 0, tui.Alignment.Center)
    testing.AssertEqStr(frame(t, 5, 1), "  a  ")
end

func test_centre_odd_slack_extra_cell_right():
