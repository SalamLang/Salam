func test_measure_auto_only():
    mut t := tui.NewTable()
    t.header = true
    t.add_column(pref_col(0, -1))
    t.add_column(pref_col(0, -1))
    t.add_row(row2("name", "qty"))
    t.add_row(row2("apple", "3"))
    t.add_row(row2("kiwi", "12"))
    testing.AssertEqInt(t.PreferredSize(0).width, 12)
    testing.AssertEqInt(t.PreferredSize(0).height, 4)
    testing.AssertEqInt(t.Measure(tui.Axis.X, 0).extent, 12)
    testing.AssertEqInt(t.Measure(tui.Axis.Y, 0).extent, 4)
    testing.AssertTrue(t.Measure(tui.Axis.X, 0).ok)
end

func test_measure_star_counts_zero_and_clamps():
