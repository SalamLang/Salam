func test_header_style_replaces_body_style():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.header = true
    t.add_column(fixed_col(3, tui.Alignment.Left))
    t.add_row(row1("H"))
    t.add_row(row1("b"))
    mut b := tui.NewBuffer(3, 3)
    mut tt := t
    tt.Render(b, rect(0, 0, 3, 3))
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.Style { bold = true }))
    testing.AssertTrue(tui.StyleEq(b.get(0, 2).style, tui.StyleDefault))
    b.Free()
end

func test_sgr_memo_probe():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.header = true
    t.add_column(fixed_col(4, tui.Alignment.Left))
    t.add_row(row1("H"))
    t.add_row(row1("b"))
    buf := tui.NewBuffer(4, 3)
    before := tui.SgrBuilds()
    t.Render(buf, rect(0, 0, 4, 3))
    testing.AssertEqInt(tui.SgrBuilds() - before, 0)
    _ := buf.ansi()
    testing.AssertEqInt(tui.SgrBuilds() - before, 2)
    t.header_style = tui.Style { fg = tui.Blue }
    t.Render(buf, rect(0, 0, 4, 3))
    testing.AssertEqInt(tui.SgrBuilds() - before, 2)
    _ := buf.ansi()
    testing.AssertEqInt(tui.SgrBuilds() - before, 4)
    buf.Free()
end

