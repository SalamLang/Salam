import str
import testing
import term
import tui

mut tv_calls := 0
mut tv_last := -1

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

func sp(n: int): str:
    ret str.Repeat(" ", n)
end

func dash(n: int): str:
    ret str.Repeat("─", n)
end

func row2(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    ret v
end

func row1(a: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    ret v
end

func row3(a: str, b: str, c: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    v.push(c)
    ret v
end

func fixed_col(n: int, a: tui.Alignment): tui.TableColumn:
    ret tui.TableColumn { width = tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = n }, align = a }
end

func pref_col(lo: int, hi: int): tui.TableColumn:
    ret tui.TableColumn { width = tui.LayoutSize { kind = tui.SizeKind.Pref }, min = lo, max = hi }
end

func key(seq: str): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Decode(seq) }
end

func frame(t: tui.Table, w: int, h: int): str:
    mut b := tui.NewBuffer(w, h)
    mut tt := t
    tt.Render(b, rect(0, 0, w, h))
    mut out := ""
    repeat h in y:
        if y > 0:
            out += "|"
        end
        out += b.row_text(y)
    end
    b.Free()
    ret out
end

func test_tb01_no_header_fixed_columns():
    mut t := tui.NewTable()
    t.pad_x = 0
    testing.AssertEqInt(t.add_column(fixed_col(4, tui.Alignment.Left)), 0)
    testing.AssertEqInt(t.add_column(fixed_col(6, tui.Alignment.Right)), 1)
    testing.AssertEqInt(t.add_row(row2("ab", "1")), 0)
    testing.AssertEqInt(t.add_row(row2("cdef", "22")), 1)
    testing.AssertEqStr(frame(t, 10, 2), "ab" + sp(7) + "1|cdef" + sp(4) + "22")
end

func test_tb02_header_and_rule():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.header = true
    t.add_column(fixed_col(6, tui.Alignment.Left))
    t.add_column(fixed_col(5, tui.Alignment.Right))
    t.add_row(row2("Name", "Qty"))
    t.add_row(row2("apple", "3"))
    t.add_row(row2("kiwi", "12"))
    testing.AssertEqStr(frame(t, 11, 4), "Name" + sp(4) + "Qty|" + dash(11) + "|apple" + sp(5) + "3|kiwi" + sp(5) + "12")
end

func test_ascii_rule_is_ascii():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.header = true
    t.add_column(fixed_col(5, tui.Alignment.Left))
    t.add_row(row1("H"))
    t.add_row(row1("a"))
    mut b := tui.NewBuffer(5, 3)
    b.glyphs = tui.GlyphPolicy.ASCII
    t.Render(b, rect(0, 0, 5, 3))
    testing.AssertEqStr(b.row_text(1), "-----")
    testing.AssertEqInt(str.Len(b.row_text(1)), 5)
    b.Free()
end

func test_tb03_mixed_alignment_pad1():
    mut t := tui.NewTable()
    t.header = true
    t.add_column(fixed_col(8, tui.Alignment.Left))
    t.add_column(fixed_col(7, tui.Alignment.Right))
    t.add_column(fixed_col(5, tui.Alignment.Center))
    t.add_row(row3("Item", "Price", "Tag"))
    t.add_row(row3("Tea", "4.50", "hot"))
    testing.AssertEqStr(frame(t, 20, 3), " Item" + sp(4) + "Price" + sp(2) + "Tag" + sp(1) + "|" + dash(20) + "| Tea" + sp(6) + "4.50" + sp(2) + "hot" + sp(1))
end

func test_tb04_clip():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.add_column(fixed_col(4, tui.Alignment.Left))
    t.add_column(fixed_col(3, tui.Alignment.Right))
    t.add_row(row2("Description", "ok"))
    testing.AssertEqStr(frame(t, 7, 1), "Desc ok")
end

func test_tb05_ellipsis():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.add_column(fixed_col(4, tui.Alignment.Left))
    t.add_column(fixed_col(3, tui.Alignment.Right))
    t.set_column_overflow(0, tui.CellOverflow.Ellipsis)
    t.add_row(row2("Description", "ok"))
    testing.AssertEqStr(frame(t, 7, 1), "Des… ok")
end

func test_tb06_header_only():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.header = true
    t.add_column(fixed_col(4, tui.Alignment.Left))
    t.add_column(fixed_col(6, tui.Alignment.Right))
    t.add_row(row2("Name", "Qty"))
    testing.AssertEqStr(frame(t, 10, 3), "Name" + sp(3) + "Qty|" + dash(10) + "|" + sp(10))
end

func test_tb07_no_rows_paints_nothing():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.add_column(fixed_col(4, tui.Alignment.Left))
    t.add_column(fixed_col(6, tui.Alignment.Right))
    testing.AssertEqStr(frame(t, 10, 2), sp(10) + "|" + sp(10))
    testing.AssertEqInt(t.PreferredSize(0).height, 0)
end

func test_tb08_narrow_clips_fixed_from_right():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.add_column(fixed_col(4, tui.Alignment.Left))
    t.add_column(fixed_col(6, tui.Alignment.Right))
    t.add_row(row2("ab", "1"))
    t.add_row(row2("cdef", "22"))
    testing.AssertEqInt(t.PreferredSize(0).width, 10)
    testing.AssertEqStr(frame(t, 6, 3), "ab   1|cdef22|" + sp(6))
end

func test_set_api_changes_render():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.add_column(tui.TableColumn {})
    t.add_column(fixed_col(2, tui.Alignment.Left))
    t.add_row(row2("a", "b"))
    testing.AssertEqInt(t.PreferredSize(0).width, 2)
    t.set_column_width(0, tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 3 })
    testing.AssertEqInt(t.PreferredSize(0).width, 5)
    t.set_column_width(9, tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 1 })
    t.set_column_align(0, tui.Alignment.Right)
    t.add_row(row2("a", "b"))
    testing.AssertEqStr(frame(t, 5, 1), "  ab ")
end

func test_pad_x_negative_clamps_to_zero():
    mut t := tui.NewTable()
    t.set_pad_x(-3)
    t.add_column(fixed_col(3, tui.Alignment.Left))
    t.add_row(row1("a"))
    testing.AssertEqStr(frame(t, 3, 1), "a  ")
end

func test_precedence_cell_over_column_over_default():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.add_column(fixed_col(5, tui.Alignment.Right))
    t.add_column(fixed_col(3, tui.Alignment.Left))
    t.add_row(row2("a", "b"))
    t.add_row(row2("c", "d"))
    t.set_cell_align(1, 0, tui.Alignment.Center)
    testing.AssertEqStr(frame(t, 8, 2), "    ab  |  c  d  ")
end

func test_cell_override_wins_again_when_set_twice():
