    t.add_column(tui.TableColumn {})
    t.add_column(fixed_col(7, tui.Alignment.Left))
    t.add_row(row2("a", "b"))
    testing.AssertEqInt(t.PreferredSize(0).width, 7)
    testing.AssertEqInt(t.PreferredSize(4).width, 4)
    testing.AssertEqInt(t.Measure(tui.Axis.X, 4).extent, 4)
end

