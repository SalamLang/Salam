    mut t := tui.NewTable()
    testing.AssertEqInt(t.PreferredSize(0).width, 0)
    testing.AssertEqInt(t.PreferredSize(0).height, 0)
end

func test_not_focusable_not_hit_not_consuming():
    mut t := tui.NewTable()
    t.add_column(fixed_col(2, tui.Alignment.Left))
    t.add_row(row1("x"))
    testing.AssertFalse(t.Focusable())
    testing.AssertFalse(t.Hits())
    testing.AssertFalse(t.HandleEvent(key("j")))
    testing.AssertFalse(t.HandleEvent(key("\r")))
end

func test_bounds_survive_set_bounds():
    mut t := tui.NewTable()
    t.SetBounds(rect(2, 1, 8, 3))
    testing.AssertEqInt(t.Bounds().x, 2)
    testing.AssertEqInt(t.Bounds().y, 1)
    testing.AssertEqInt(t.Bounds().width, 8)
    testing.AssertEqInt(t.Bounds().height, 3)
end

func test_rows_past_height_are_not_painted():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.add_column(fixed_col(2, tui.Alignment.Left))
    t.add_row(row1("r0"))
    t.add_row(row1("r1"))
    t.add_row(row1("r2"))
    t.add_row(row1("r3"))
    t.add_row(row1("r4"))
    mut b := tui.NewBuffer(2, 5)
    b.fill(rect(0, 0, 2, 5), "x", tui.StyleDefault)
    t.Render(b, rect(0, 0, 2, 3))
    mut out := ""
    repeat 5 in y:
        if y > 0:
            out += "|"
        end
        out += b.row_text(y)
    end
    b.Free()
    testing.AssertEqStr(out, "r0|r1|r2|xx|xx")
end

func tv(n: int, cw: int, header: bool): tui.TableView:
    mut t := tui.NewTableView()
    t.pad_x = 0
    t.header = header
    t.add_column(fixed_col(cw, tui.Alignment.Left))
    if header:
        t.add_row(row1("H"))
    end
    repeat n in i:
        t.add_row(row1("r" + str.FromInt(i)))
    end
    ret t
end

func tv_frame(t: tui.TableView, w: int, h: int): str:
    b := tui.NewBuffer(w, h)
    mut tt := t
    tt.SetBounds(rect(0, 0, w, h))
    tt.Render(b, rect(0, 0, w, h))
    mut out := ""
    repeat h in y:
        if y > 0:
            out += "|"
        end
        out += b.row_text(y)
    end
    b.Free()
    ret out
end

func thumb_rows(b: tui.Buffer, x: int, y0: int, h: int): str:
    mut out := ""
    repeat h in r:
        if b.get(x, y0 + r).ch == "█" or b.get(x, y0 + r).ch == "#":
            out += str.FromInt(r)
        end
    end
    ret out
end

func tv_check(t: tui.TableView, n: int, h: int):
    if n == 0:
        testing.AssertEqInt(t.selected, -1)
        testing.AssertEqInt(t.offset, 0)
        ret
    end
    testing.AssertTrue(t.selected >= 0 and t.selected < n)
    mut max_off := 0
    if n > h:
        max_off = n - h
    end
    testing.AssertTrue(t.offset >= 0 and t.offset <= max_off)
end

func test_tv_surface():
    t := tui.NewTableView()
    testing.AssertTrue(t.Focusable())
    testing.AssertTrue(t.Hits())
    testing.AssertEqInt(t.offset, 0)
    testing.AssertEqInt(t.selected, 0)
    testing.AssertFalse(t.activate(0))
    tb := tui.NewTable()
    testing.AssertFalse(tb.Focusable())
    testing.AssertFalse(tb.Hits())
end

func test_tv_fits_exactly_has_no_bar():
    t := tv(4, 4, false)
    testing.AssertEqStr(tv_frame(t, 5, 4), "r0   |r1   |r2   |r3   ")
end

func test_tv_one_row_over_reserves_bar():
    t := tv(5, 4, false)
    testing.AssertEqStr(tv_frame(t, 5, 4), "r0  █|r1  █|r2  █|r3  │")
end

func test_tv_mid_list_window_and_thumb():
    mut t := tv(10, 4, false)
    t.offset = 3
    testing.AssertEqStr(tv_frame(t, 5, 4), "r3  │|r4  █|r5  │|r6  │")
end

func test_tv_thumb_table():
    mut b := tui.NewBuffer(5, 10)
    mut t := tv(5, 4, false)
    t.offset = 1
    t.SetBounds(rect(0, 0, 5, 4))
    t.Render(b, rect(0, 0, 5, 4))
    testing.AssertEqStr(thumb_rows(b, 4, 0, 4), "123")
    b.Free()
    mut t2 := tv(10, 4, false)
    t2.offset = 6
    b = tui.NewBuffer(5, 10)
    t2.Render(b, rect(0, 0, 5, 4))
    testing.AssertEqStr(thumb_rows(b, 4, 0, 4), "3")
    b.Free()
    mut t3 := tv(100, 4, false)
    t3.offset = 96
    b = tui.NewBuffer(5, 10)
    t3.Render(b, rect(0, 0, 5, 4))
    testing.AssertEqStr(thumb_rows(b, 4, 0, 4), "3")
    b.Free()
    mut t4 := tv(100, 10, false)
    t4.offset = 45
    b = tui.NewBuffer(5, 10)
    t4.Render(b, rect(0, 0, 5, 10))
    testing.AssertEqStr(thumb_rows(b, 4, 0, 10), "4")
    b.Free()
end

func test_tv_ascii_bar():
    mut t := tv(5, 4, false)
    mut b := tui.NewBuffer(5, 4)
    b.glyphs = tui.GlyphPolicy.ASCII
    t.Render(b, rect(0, 0, 5, 4))
    testing.AssertEqStr(b.row_text(0), "r0  #")
    testing.AssertEqStr(b.row_text(3), "r3  |")
    b.Free()
end

func test_tv_key_trace():
    mut t := tv(10, 4, false)
    t.SetBounds(rect(0, 0, 5, 4))
    repeat 4:
        testing.AssertTrue(t.HandleEvent(key("\x1b[B")))
        tv_check(t, 10, 4)
    end
    testing.AssertEqInt(t.offset, 1)
    testing.AssertEqInt(t.selected, 4)
    testing.AssertTrue(t.HandleEvent(key("\x1b[6~")))
    testing.AssertEqInt(t.offset, 5)
    testing.AssertEqInt(t.selected, 8)
    testing.AssertTrue(t.HandleEvent(key("\x1b[6~")))
    testing.AssertEqInt(t.offset, 6)
    testing.AssertEqInt(t.selected, 9)
    testing.AssertTrue(t.HandleEvent(key("\x1b[B")))
    testing.AssertEqInt(t.selected, 9)
    testing.AssertTrue(t.HandleEvent(key("\x1b[5~")))
    testing.AssertEqInt(t.offset, 2)
    testing.AssertEqInt(t.selected, 5)
    tv_check(t, 10, 4)
    testing.AssertTrue(t.HandleEvent(key("\x1b[H")))
    testing.AssertEqInt(t.offset, 0)
    testing.AssertEqInt(t.selected, 0)
    testing.AssertTrue(t.HandleEvent(key("\x1b[A")))
    testing.AssertEqInt(t.selected, 0)
    testing.AssertTrue(t.HandleEvent(key("\x1b[F")))
    testing.AssertEqInt(t.offset, 6)
    testing.AssertEqInt(t.selected, 9)
    tv_check(t, 10, 4)
    testing.AssertFalse(t.HandleEvent(key("x")))
    testing.AssertFalse(t.HandleEvent(key("\t")))
end

func test_tv_cursor_scrolls_up_minimally():
    mut t := tv(10, 4, false)
    t.SetBounds(rect(0, 0, 5, 4))
    t.HandleEvent(key("\x1b[F"))
    repeat 4:
        t.HandleEvent(key("\x1b[A"))
    end
    testing.AssertEqInt(t.selected, 5)
    testing.AssertEqInt(t.offset, 5)
end

func test_tv_ascii_rule_is_ascii():
    t := tv(2, 4, true)
    mut b := tui.NewBuffer(5, 3)
    b.glyphs = tui.GlyphPolicy.ASCII
    mut tt := t
    tt.SetBounds(rect(0, 0, 5, 3))
    tt.Render(b, rect(0, 0, 5, 3))
    testing.AssertEqStr(b.row_text(1), "---- ")
    testing.AssertEqInt(str.Len(b.row_text(1)), 5)
    b.Free()
end

func test_tv_selected_after_render_without_rows():
    mut t := tui.NewTableView()
    t.add_column(fixed_col(4, tui.Alignment.Left))
    mut b := tui.NewBuffer(5, 3)
    t.SetBounds(rect(0, 0, 5, 3))
    t.Render(b, rect(0, 0, 5, 3))
    testing.AssertEqInt(t.selected, -1)
    mut t2 := tv(10, 4, false)
    t2.selected = 5
    t2.rows = Vector {} as Vector<Vector<str>>
    t2.SetBounds(rect(0, 0, 5, 3))
    t2.Render(b, rect(0, 0, 5, 3))
    testing.AssertEqInt(t2.selected, -1)
    b.Free()
end

func test_tv_pinned_header_and_rule():
    mut t := tv(6, 4, true)
    t.offset = 2
    testing.AssertEqStr(tv_frame(t, 5, 5), "H    |" + dash(4) + " |r2  │|r3  █|r4  │")
end

func test_tv_selected_outside_window_paints_no_reverse():
    mut t := tv(10, 4, false)
    t.offset = 5
    mut b := tui.NewBuffer(5, 4)
    b.focused = true
    t.Render(b, rect(0, 0, 5, 4))
    repeat 4 in y:
        repeat 5 in x:
            testing.AssertFalse(b.get(x, y).style.reverse)
            testing.AssertFalse(b.get(x, y).style.bold)
        end
    end
    testing.AssertEqInt(t.selected, 0)
    b.Free()
end

func test_tv_focused_reverse_unfocused_bold():
    mut t := tv(5, 4, true)
    t.selected = 1
    t.SetBounds(rect(0, 0, 5, 6))
    mut b := tui.NewBuffer(5, 6)
    b.focused = true
    t.Render(b, rect(0, 0, 5, 6))
    repeat 4 in x:
        testing.AssertTrue(b.get(x, 3).style.reverse)
        testing.AssertFalse(b.get(x, 2).style.reverse)
        testing.AssertFalse(b.get(x, 0).style.reverse)
    end
    testing.AssertFalse(b.get(4, 3).style.reverse)
    b.Free()
    b = tui.NewBuffer(5, 6)
    t.Render(b, rect(0, 0, 5, 6))
    repeat 4 in x:
        testing.AssertFalse(b.get(x, 3).style.reverse)
        testing.AssertTrue(b.get(x, 3).style.bold)
        testing.AssertFalse(b.get(x, 2).style.bold)
    end
    b.Free()
end

func test_tv_overflow_uses_column_width():
    mut t := tv(0, 4, false)
    t.set_column_overflow(0, tui.CellOverflow.Ellipsis)
    t.add_row(row1("abcdefgh"))
    t.add_row(row1("x"))
    testing.AssertEqStr(tv_frame(t, 5, 1), "abc…█")
    mut c := tv(0, 4, false)
    c.add_row(row1("abcdefgh"))
    c.add_row(row1("x"))
    testing.AssertEqStr(tv_frame(c, 5, 1), "abcd█")
end

func test_tv_paints_nothing_past_the_rect():
    mut t := tv(10, 4, false)
    mut b := tui.NewBuffer(5, 6)
    b.fill(rect(0, 0, 5, 6), "x", tui.StyleDefault)
    t.Render(b, rect(0, 0, 5, 4))
    testing.AssertEqStr(b.row_text(4), "xxxxx")
    testing.AssertEqStr(b.row_text(5), "xxxxx")
    b.Free()
end

func test_tv_activate():
    mut t := tv(3, 4, false)
    t.SetBounds(rect(0, 0, 5, 3))
    testing.AssertFalse(t.HandleEvent(key("\r")))
    t.activate = (row: int):
        tv_calls++
        tv_last = row
        ret true
    end
    t.HandleEvent(key("\x1b[B"))
    testing.AssertTrue(t.HandleEvent(key("\r")))
    testing.AssertEqInt(tv_calls, 1)
    testing.AssertEqInt(tv_last, 1)
    mut e := tv(0, 4, true)
    e.activate = (_row: int):
        tv_calls++
        ret true
    end
    testing.AssertFalse(e.HandleEvent(key("\r")))
    testing.AssertEqInt(tv_calls, 1)
    testing.AssertTrue(e.HandleEvent(key("\x1b[B")))
    testing.AssertEqInt(e.selected, -1)
    testing.AssertEqInt(e.offset, 0)
end

func test_tv_selected_row_keeps_wide_glyphs():
    mut t := tui.NewTableView()
    t.pad_x = 0
    t.add_column(fixed_col(6, tui.Alignment.Left))
    t.add_row(row1("\u4e2d\u6587ab"))
    t.add_row(row1("\u65e5\u672c"))
    mut b := tui.NewBuffer(6, 2)
    b.focused = true
    t.SetBounds(rect(0, 0, 6, 2))
    t.Render(b, rect(0, 0, 6, 2))
    testing.AssertEqStr(b.row_text(0), "\u4e2d\u6587ab")
    testing.AssertEqStr(b.row_text(1), "\u65e5\u672c  ")
    repeat 6 in x:
        testing.AssertTrue(b.get(x, 0).style.reverse)
        testing.AssertFalse(b.get(x, 1).style.reverse)
    end
    b.Free()
end

func test_ellipsis_is_ascii_under_ascii_policy():
    mut t := tui.NewTable()
    t.pad_x = 0
    t.add_column(fixed_col(4, tui.Alignment.Left))
    t.set_column_overflow(0, tui.CellOverflow.Ellipsis)
    t.add_row(row1("abcdefgh"))
    mut b := tui.NewBuffer(4, 1)
    b.glyphs = tui.GlyphPolicy.ASCII
    t.Render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "abc~")
    b.Free()
    mut u := tui.NewBuffer(4, 1)
    t.Render(u, rect(0, 0, 4, 1))
    testing.AssertEqStr(u.row_text(0), "abc\u2026")
    u.Free()
end

