// Tests for the pure text rules: greedy word-boundary wrapping with a
// grid-split fallback for over-long words, the break space being consumed,
// explicit "\n" paragraphs, unbounded widths, and the preferred-size
// arithmetic (width = longest line, height = line count).

import testing
import term

import tui

mut live_text := "initial"

// ---- WrapText ---------------------------------------------------------

func test_wrap_word_boundary():
    mut lines := tui.WrapText("the quick brown fox", 9)
    defer lines.free()
    testing.AssertEqInt(lines.len(), 2)
    testing.AssertEqStr(lines.get(0), "the quick")
    testing.AssertEqStr(lines.get(1), "brown fox")
end

func test_wrap_consumes_break_space():
    mut lines := tui.WrapText("aa bb", 3)
    defer lines.free()
    testing.AssertEqInt(lines.len(), 2)
    testing.AssertEqStr(lines.get(0), "aa")
    testing.AssertEqStr(lines.get(1), "bb")
end

func test_wrap_overlong_word_grid_split():
    mut lines := tui.WrapText("abcdefgh", 3)
    defer lines.free()
    testing.AssertEqInt(lines.len(), 3)
    testing.AssertEqStr(lines.get(0), "abc")
    testing.AssertEqStr(lines.get(1), "def")
    testing.AssertEqStr(lines.get(2), "gh")
end

func test_wrap_long_word_between_words():
    mut lines := tui.WrapText("ab abcdefgh cd", 4)
    defer lines.free()
    testing.AssertEqInt(lines.len(), 4)
    testing.AssertEqStr(lines.get(0), "ab")
    testing.AssertEqStr(lines.get(1), "abcd")
    testing.AssertEqStr(lines.get(2), "efgh")
    testing.AssertEqStr(lines.get(3), "cd")
end

func test_wrap_never_exceeds_width():
    mut lines := tui.WrapText("the quick brown fox jumps over the lazy dog", 7)
    defer lines.free()
    testing.AssertEqInt(lines.len(), 9)
    repeat lines.len() in i:
        testing.AssertTrue(term.Width(lines.get(i)) <= 7)
    end
end

func test_wrap_explicit_newlines():
    mut lines := tui.WrapText("a\nbb\nccc", 10)
    defer lines.free()
    testing.AssertEqInt(lines.len(), 3)
    testing.AssertEqStr(lines.get(0), "a")
    testing.AssertEqStr(lines.get(1), "bb")
    testing.AssertEqStr(lines.get(2), "ccc")
end

func test_wrap_paragraphs_wrap_alone():
    mut lines := tui.WrapText("hello world\nab", 6)
    defer lines.free()
    testing.AssertEqInt(lines.len(), 3)
    testing.AssertEqStr(lines.get(0), "hello")
    testing.AssertEqStr(lines.get(1), "world")
    testing.AssertEqStr(lines.get(2), "ab")
end

func test_wrap_unbounded():
    mut lines := tui.WrapText("a very long line here", 0)
    defer lines.free()
    testing.AssertEqInt(lines.len(), 1)
    testing.AssertEqStr(lines.get(0), "a very long line here")
    mut neg := tui.WrapText("x y z", -5)
    defer neg.free()
    testing.AssertEqInt(neg.len(), 1)
    testing.AssertEqStr(neg.get(0), "x y z")
end

func rect(x: int, y: int, w: int, h: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = w, height = h }
end

// ---- MeasureText ------------------------------------------------------

func test_measure_single_line():
    r := tui.MeasureText("hello", 10)
    testing.AssertEqInt(r.x, 0)
    testing.AssertEqInt(r.y, 0)
    testing.AssertEqInt(r.width, 5)
    testing.AssertEqInt(r.height, 1)
end

func test_measure_wrapped_longest_line():
    r := tui.MeasureText("aa bbbbb c", 6)
    testing.AssertEqInt(r.width, 5)
    testing.AssertEqInt(r.height, 3)
end

func test_measure_explicit_newlines():
    r := tui.MeasureText("hi\nthere\nx", 0)
    testing.AssertEqInt(r.width, 5)
    testing.AssertEqInt(r.height, 3)
    w := tui.MeasureText("hello world\nab", 6)
    testing.AssertEqInt(w.width, 5)
    testing.AssertEqInt(w.height, 3)
end

func test_measure_unbounded():
    r := tui.MeasureText("long single line", 0)
    testing.AssertEqInt(r.width, 16)
    testing.AssertEqInt(r.height, 1)
    neg := tui.MeasureText("aaa\nbbbbb", -3)
    testing.AssertEqInt(neg.width, 5)
    testing.AssertEqInt(neg.height, 2)
end

func test_measure_and_wrap_display_cells():
    testing.AssertEqInt(tui.MeasureText("中文", 0).width, 4)
    testing.AssertEqInt(tui.MeasureText("e\u0301", 0).width, 1)
    testing.AssertEqInt(tui.MeasureText("a\u200Bb", 0).width, 2)

    mut pair := tui.WrapText("中文", 4)
    defer pair.free()
    testing.AssertEqInt(pair.len(), 1)

    mut split := tui.WrapText("中文字", 4)
    defer split.free()
    testing.AssertEqInt(split.len(), 2)
    testing.AssertEqStr(split.get(0), "中文")
    testing.AssertEqStr(split.get(1), "字")

    mut mixed := tui.WrapText("a中b", 2)
    defer mixed.free()
    testing.AssertEqInt(mixed.len(), 3)
    testing.AssertEqStr(mixed.get(0), "a")
    testing.AssertEqStr(mixed.get(1), "中")
    testing.AssertEqStr(mixed.get(2), "b")

    mut narrow := tui.WrapText("中", 1)
    defer narrow.free()
    testing.AssertEqInt(narrow.len(), 1)
    testing.AssertEqStr(narrow.get(0), "中")
end

// ---- Text widget ------------------------------------------------------

func test_text_render_row():
    mut b := tui.NewBuffer(12, 1)
    defer b.free()
    mut t := tui.NewText("hello")
    t.render(b, rect(0, 0, 12, 1))
    testing.AssertEqStr(b.row_text(0), "hello       ")
end

func test_text_set_text_rerenders():
    mut b := tui.NewBuffer(10, 1)
    defer b.free()
    mut t := tui.NewText("aaaa")
    t.render(b, rect(0, 0, 10, 1))
    testing.AssertEqStr(b.row_text(0), "aaaa      ")
    t.set_text("bb")
    t.render(b, rect(0, 0, 10, 1))
    testing.AssertEqStr(b.row_text(0), "bb        ")
end

func test_text_alignment():
    mut b := tui.NewBuffer(9, 1)
    defer b.free()
    mut t := tui.NewText("abc")
    t.render(b, rect(0, 0, 9, 1))
    testing.AssertEqStr(b.row_text(0), "abc      ")
    t.set_align(tui.Alignment.Right)
    t.render(b, rect(0, 0, 9, 1))
    testing.AssertEqStr(b.row_text(0), "      abc")
    t.set_align(tui.Alignment.Center)
    t.render(b, rect(0, 0, 9, 1))
    testing.AssertEqStr(b.row_text(0), "   abc   ")
end

func test_text_wide_render_alignment():
    mut b := tui.NewBuffer(6, 1)
    defer b.free()
    mut t := tui.NewText("中文")
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.row_text(0), "中文  ")
    t.set_align(tui.Alignment.Center)
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.row_text(0), " 中文 ")
end

func test_table_and_text_share_display_cells():
    mut table := tui.NewTable()
    table.pad_x = 0
    table.add_column(tui.TableColumn { width = tui.LayoutSize { kind = tui.SizeKind.Fixed, cells = 4 } })
    mut row := Vector {} as Vector<str>
    row.push("中")
    table.add_row(row)

    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    mut rendered_table := table
    rendered_table.render(b, rect(0, 0, 4, 1))
    mut t := tui.NewText("中")
    t.render(b, rect(4, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "中  中  ")
end

func test_text_center_odd_slack_goes_right():
    mut b := tui.NewBuffer(8, 1)
    defer b.free()
    mut t := tui.NewText("abc")
    t.set_align(tui.Alignment.Center)
    // free = 8 - 3 = 5, floor 5 / 2 = 2, so the extra cell lands on the right.
    t.render(b, rect(0, 0, 8, 1))
    testing.AssertEqStr(b.row_text(0), "  abc   ")
end

func test_text_style_covers_box():
    mut b := tui.NewBuffer(6, 1)
    defer b.free()
    glyph := tui.Style { bold = true }
    pad := tui.StyleDefault
    mut t := tui.NewText("hi")
    t.set_style(tui.Style { bold = true })
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.get(0, 0).ch, "h")
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, glyph))
    testing.AssertTrue(tui.StyleEq(b.get(1, 0).style, glyph))
    // Under the pad rule a cell past the glyphs carries only the style's
    // background; for a bold-only style that is the default style.
    testing.AssertTrue(tui.StyleEq(b.get(5, 0).style, pad))
end

func test_text_wrap_none_clips_at_edge():
    mut b := tui.NewBuffer(4, 2)
    defer b.free()
    mut t := tui.NewText("ab\ncdefgh")
    t.set_wrap(tui.WrapMode.None)
    t.render(b, rect(0, 0, 4, 2))
    testing.AssertEqStr(b.row_text(0), "ab  ")
    testing.AssertEqStr(b.row_text(1), "cdef")
end

func test_text_clips_lines_taller_than_box():
    mut b := tui.NewBuffer(3, 1)
    defer b.free()
    mut t := tui.NewText("one two three")
    // Wrapped at 3: one / two / three, but the box is one row tall.
    t.render(b, rect(0, 0, 3, 1))
    testing.AssertEqStr(b.row_text(0), "one")
end

func test_text_preferred_size_and_width():
    mut t := tui.NewText("hello world")
    r := t.preferred_size(5)
    testing.AssertEqInt(r.x, 0)
    testing.AssertEqInt(r.y, 0)
    testing.AssertEqInt(r.width, 5)
    testing.AssertEqInt(r.height, 2)
    testing.AssertEqInt(t.preferred_width(), 11)
    t.set_text("ab")
    testing.AssertEqInt(t.preferred_width(), 2)
    testing.AssertEqInt(t.preferred_size(0).height, 1)
    mut wide := tui.NewText("中文")
    testing.AssertEqInt(wide.preferred_size(10).width, 4)
end

func test_text_degenerate_bounds_do_not_panic():
    mut b := tui.NewBuffer(4, 1)
    defer b.free()
    mut t := tui.NewText("hello")
    t.render(b, rect(0, 0, 0, 0))
    t.render(b, rect(0, 0, -3, -1))
    testing.AssertEqStr(b.row_text(0), "    ")
    testing.AssertFalse(t.focusable())
end

func test_text_source_renders_live_value():
    mut t := tui.NewText("")
    t.set_source((): ret live_text end)

    mut first := tui.NewBuffer(8, 1)
    defer first.free()
    t.render(first, rect(0, 0, 8, 1))
    testing.AssertEqStr(first.row_text(0), "initial ")

    live_text = "changed"
    mut second := tui.NewBuffer(8, 1)
    defer second.free()
    t.render(second, rect(0, 0, 8, 1))
    testing.AssertEqStr(second.row_text(0), "changed ")
end

func test_text_source_measure_and_precedence():
    mut t := tui.NewText("pushed")
    t.set_source((): ret "中文" end)
    testing.AssertEqInt(t.preferred_size(10).width, 4)
    testing.AssertEqInt(t.preferred_width(), 4)

    t.set_text("x")
    mut b := tui.NewBuffer(4, 1)
    defer b.free()
    t.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "x   ")

    t.set_text("pushed")
    live_text = "pulled"
    t.set_source((): ret live_text end)
    t.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "pull")
end

func test_text_clear_source_and_empty_source():
    mut t := tui.NewText("kept")
    t.set_source((): ret "other" end)
    t.clear_source()
    mut b := tui.NewBuffer(6, 1)
    defer b.free()
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.row_text(0), "kept  ")

    t.set_source((): ret "" end)
    size := t.preferred_size(10)
    testing.AssertEqInt(size.width, 0)
    testing.AssertEqInt(size.height, 0)
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.row_text(0), "      ")
end

// ---- AC1: static and dynamic text ------------------------------------

func test_text_dynamic_counter_sequence():
    mut b := tui.NewBuffer(6, 1)
    defer b.free()
    mut t := tui.NewText("9")
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.row_text(0), "9     ")
    // A one-cell value becoming a two-cell one: the old text is fully gone.
    t.set_text("10")
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.row_text(0), "10    ")
    t.set_text("9")
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqStr(b.row_text(0), "9     ")
end

// ---- AC2: alignment --------------------------------------------------

func test_text_align_center_odd_slack_13_in_20():
    mut b := tui.NewBuffer(20, 1)
    defer b.free()
    mut t := tui.NewText("thirteenchars")
    t.set_align(tui.Alignment.Center)
    // free = 7, floor(7 / 2) = 3, so 3 left and the extra cell on the right.
    t.render(b, rect(0, 0, 20, 1))
    testing.AssertEqStr(b.row_text(0), "   thirteenchars    ")
end

func test_text_align_center_even_slack_12_in_20():
    mut b := tui.NewBuffer(20, 1)
    defer b.free()
    mut t := tui.NewText("abcdefghijkl")
    t.set_align(tui.Alignment.Center)
    // free = 8, symmetric.
    t.render(b, rect(0, 0, 20, 1))
    testing.AssertEqStr(b.row_text(0), "    abcdefghijkl    ")
end

func test_text_align_right_free_one_and_center_free_one():
    mut b := tui.NewBuffer(20, 1)
    defer b.free()
    mut t := tui.NewText("abcdefghijklmnopqrs")
    t.set_align(tui.Alignment.Right)
    // free = 1: the line sits one column in.
    t.render(b, rect(0, 0, 20, 1))
    testing.AssertEqStr(b.row_text(0), " abcdefghijklmnopqrs")
    t.set_align(tui.Alignment.Center)
    // free = 1 centers to floor(1 / 2) = 0, the same as left.
    t.render(b, rect(0, 0, 20, 1))
    testing.AssertEqStr(b.row_text(0), "abcdefghijklmnopqrs ")
end

func test_text_align_center_every_wrapped_line():
    mut b := tui.NewBuffer(12, 5)
    defer b.free()
    mut t := tui.NewText("abcdefghij\nabcdefghijkl\nabcdefgh\nabcdefghijkl\nabcde")
    t.set_align(tui.Alignment.Center)
    t.render(b, rect(0, 0, 12, 5))
    // Artifact: lines of 10, 12, 8, 12, 5 in a 12-cell box give pads
    // 1, 0, 2, 0, 3 (the 5-cell line has free 7, padded 3 | 4).
    testing.AssertEqStr(b.row_text(0), " abcdefghij ")
    testing.AssertEqStr(b.row_text(1), "abcdefghijkl")
    testing.AssertEqStr(b.row_text(2), "  abcdefgh  ")
    testing.AssertEqStr(b.row_text(3), "abcdefghijkl")
    testing.AssertEqStr(b.row_text(4), "   abcde    ")
end

func test_text_align_overwide_clips_first_cells():
    mut b := tui.NewBuffer(4, 1)
    defer b.free()
    mut t := tui.NewText("abcdefgh")
    t.set_wrap(tui.WrapMode.None)
    // Artifact: len >= W puts offset = 0 for every alignment, so left, right,
    // and center all show the same first W cells (never the tail).
    t.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "abcd")
    t.set_align(tui.Alignment.Right)
    t.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "abcd")
    t.set_align(tui.Alignment.Center)
    t.render(b, rect(0, 0, 4, 1))
    testing.AssertEqStr(b.row_text(0), "abcd")
end

// ---- AC3: style ------------------------------------------------------

func test_text_style_foreground_and_background():
    mut b := tui.NewBuffer(4, 1)
    defer b.free()
    fg := tui.Style { fg = tui.Red }
    pad := tui.StyleDefault
    mut t := tui.NewText("hi")
    t.set_style(tui.Style { fg = tui.Red })
    t.render(b, rect(0, 0, 4, 1))
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, fg))
    testing.AssertTrue(tui.StyleEq(b.get(1, 0).style, fg))
    // A foreground never reaches the padding: the pad cell carries bg only.
    testing.AssertTrue(tui.StyleEq(b.get(3, 0).style, pad))

    mut b2 := tui.NewBuffer(4, 1)
    defer b2.free()
    bg := tui.Style { bg = tui.Blue }
    mut t2 := tui.NewText("hi")
    t2.set_style(tui.Style { bg = tui.Blue })
    t2.render(b2, rect(0, 0, 4, 1))
    testing.AssertTrue(tui.StyleEq(b2.get(0, 0).style, bg))
    testing.AssertEqStr(b2.get(2, 0).ch, " ")
    testing.AssertTrue(tui.StyleEq(b2.get(2, 0).style, bg))
end

func test_text_style_padding_on_wrapped_row():
    mut b := tui.NewBuffer(5, 2)
    defer b.free()
    pad := tui.StyleDefault
    mut t := tui.NewText("ab cde")
    t.set_style(tui.Style { bold = true })
    t.render(b, rect(0, 0, 5, 2))
    // Row 0 holds "ab" then blank padding cells the glyphs never touch.
    testing.AssertEqStr(b.row_text(0), "ab   ")
    testing.AssertEqStr(b.row_text(1), "cde  ")
    testing.AssertTrue(tui.StyleEq(b.get(4, 0).style, pad))
    testing.AssertTrue(tui.StyleEq(b.get(4, 1).style, pad))
end

func test_text_ansi_frame_carries_style():
    mut b := tui.NewBuffer(4, 1)
    defer b.free()
    glyph := tui.Style { bold = true }
    mut t := tui.NewText("hi")
    t.set_style(tui.Style { bold = true })
    t.render(b, rect(0, 0, 4, 1))
    // Glyphs carry the full style; the pad cells carry bg only (here nothing),
    // so the buffer leaves bold before the trailing spaces.
    seq_on := tui.StyleSgr(glyph, tui.ColorTier.TrueColor)
    seq_off := tui.StyleSgrOff(glyph, tui.ColorTier.TrueColor)
    want := term.SeqMoveTo(1, 1) + seq_on + "hi" + seq_off + "  "
    testing.AssertEqStr(b.ansi(), want)
end

// The tier is render context on the buffer: the cell keeps the
// Style, and a buffer pinned to Ansi16 emits the lowered ANSI foreground. A
// fresh buffer stays true colour (see the test above).
func test_text_tier_lowers_foreground():
    mut b := tui.NewBuffer(2, 1)
    defer b.free()
    b.tier = tui.ColorTier.Ansi16
    mut t := tui.NewText("hi")
    style := tui.Style { fg = tui.Color.Rgb(255, 0, 0) }
    t.set_style(style)
    t.render(b, rect(0, 0, 2, 1))
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, style))
    testing.AssertTrue(tui.StyleEq(b.get(1, 0).style, style))
    lowering := tui.FgSeqAt(tui.Color.Rgb(255, 0, 0), tui.ColorTier.Ansi16)
    want := term.SeqMoveTo(1, 1) + tui.StyleSgr(style, tui.ColorTier.Ansi16) + "hi" + tui.StyleSgrOff(style, tui.ColorTier.Ansi16)
    testing.AssertEqStr(b.ansi(), want)
    // Not vacuous: the same style at true colour is the 24-bit sequence.
    testing.AssertTrue(lowering != tui.FgSeqAt(tui.Color.Rgb(255, 0, 0), tui.ColorTier.TrueColor))
end

func test_text_tier_off_drops_colour():
    mut b := tui.NewBuffer(2, 1)
    defer b.free()
    b.tier = tui.ColorTier.Off
    mut t := tui.NewText("hi")
    t.set_style(tui.Style { fg = tui.Color.Rgb(255, 0, 0) })
    t.render(b, rect(0, 0, 2, 1))
    testing.AssertTrue(tui.StyleEq(b.get(0, 0).style, tui.Style { fg = tui.Color.Rgb(255, 0, 0) }))
    testing.AssertEqStr(b.row_text(0), "hi")
    // At Off the colour lowers away at emission; the glyphs stay.
    testing.AssertEqStr(b.ansi(), term.SeqMoveTo(1, 1) + "hi")

    // Attributes are not colours: bold still reaches the cell at Off.
    mut b2 := tui.NewBuffer(2, 1)
    defer b2.free()
    b2.tier = tui.ColorTier.Off
    mut t2 := tui.NewText("hi")
    t2.set_style(tui.Style { fg = tui.Color.Rgb(255, 0, 0), bold = true })
    t2.render(b2, rect(0, 0, 2, 1))
    testing.AssertEqStr(b2.ansi(), term.SeqMoveTo(1, 1) + term.Sgr(term.StyleBold) + "hi" + term.Sgr(22))
end

// After the typed-style migration: the widget builds nothing. A styled glyph run followed by
// default padding is one on and one off sequence when the buffer emits it.
func test_sgr_memo_probe():
    mut b := tui.NewBuffer(6, 1)
    defer b.free()
    mut t := tui.NewText("hi")
    t.set_style(tui.Style { fg = tui.Red })
    before := tui.SgrBuilds()
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqInt(tui.SgrBuilds() - before, 0)
    _ := b.ansi()
    testing.AssertEqInt(tui.SgrBuilds() - before, 2)
    t.set_style(tui.Style { fg = tui.Blue })
    t.render(b, rect(0, 0, 6, 1))
    testing.AssertEqInt(tui.SgrBuilds() - before, 2)
    _ := b.ansi()
    testing.AssertEqInt(tui.SgrBuilds() - before, 4)
end

// ---- AC4: wrapping within bounds -------------------------------------

func test_text_render_wrapped_rows():
    mut b := tui.NewBuffer(9, 2)
    defer b.free()
    mut t := tui.NewText("the quick brown fox")
    t.render(b, rect(0, 0, 9, 2))
    testing.AssertEqStr(b.row_text(0), "the quick")
    testing.AssertEqStr(b.row_text(1), "brown fox")
    // No emitted row exceeds the box width.
    testing.AssertTrue(term.Width(b.row_text(0)) <= 9)
    testing.AssertTrue(term.Width(b.row_text(1)) <= 9)
end

func test_text_render_clips_taller_content():
    mut b := tui.NewBuffer(3, 4)
    defer b.free()
    mut t := tui.NewText("one two three")
    // Wrapped at 3 this is one / two / three; the box is two rows tall.
    t.render(b, rect(0, 0, 3, 2))
    testing.AssertEqStr(b.row_text(0), "one")
    testing.AssertEqStr(b.row_text(1), "two")
    // Rows below the box are untouched (the box was filled, not the buffer).
    testing.AssertEqStr(b.row_text(2), "   ")
    testing.AssertEqStr(b.row_text(3), "   ")
end

func test_text_wrap_none_does_not_spill():
    mut b := tui.NewBuffer(6, 1)
    defer b.free()
    // Screen hands each widget a buffer clipped to its bounds; model that so
    // the cell just outside the box is the buffer's untouched default.
    b.clip = rect(0, 0, 4, 1)
    mut t := tui.NewText("abcdefgh")
    t.set_wrap(tui.WrapMode.None)
    t.render(b, rect(0, 0, 4, 1))
    // Exactly the first 4 codepoints; outside the box stays buffer default.
    testing.AssertEqStr(b.row_text(0), "abcd  ")
    testing.AssertEqStr(b.get(4, 0).ch, " ")
    testing.AssertTrue(tui.StyleEq(b.get(4, 0).style, tui.StyleDefault))
    testing.AssertTrue(tui.StyleEq(b.get(5, 0).style, tui.StyleDefault))
end

// ---- AC5: preferred size ---------------------------------------------

func test_text_preferred_single_line():
    t := tui.NewText("hi")
    r := t.preferred_size(10)
    testing.AssertEqInt(r.width, 2)
    testing.AssertEqInt(r.height, 1)
    testing.AssertEqInt(t.preferred_width(), 2)
end

func test_text_preferred_explicit_newlines():
    t := tui.NewText("hi\nthere\nx")
    r := t.preferred_size(0)
    testing.AssertEqInt(r.width, 5)
    testing.AssertEqInt(r.height, 3)
    testing.AssertEqInt(t.preferred_width(), 5)
end

func test_text_preferred_unbounded_negative():
    t := tui.NewText("aaa\nbbbbb")
    r := t.preferred_size(-3)
    testing.AssertEqInt(r.width, 5)
    testing.AssertEqInt(r.height, 2)
end


func test_wrap_keeps_spacing_of_a_fitting_line():
    mut t := tui.NewText("  a    b")
    mut b := tui.NewBuffer(10, 1)
    t.render(b, tui.Rect { width = 10, height = 1 })
    testing.AssertEqStr(b.row_text(0), "  a    b  ")
    b.free()
    lines := tui.WrapText("  a    b\nx  y", 10)
    testing.AssertEqInt(lines.len(), 2)
    testing.AssertEqStr(lines.get(0), "  a    b")
    testing.AssertEqStr(lines.get(1), "x  y")
    lines.free()
    tabs := tui.WrapText("a\tb", 10)
    testing.AssertEqStr(tabs.get(0), "a b")
    tabs.free()
end

