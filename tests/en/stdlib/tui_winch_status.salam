// The winch thread branches on the sign of WaitWinch's return: positive means
// a signal arrived, zero is Windows only, and a negative Wait* status means the
// wait did not run or failed and the thread backs off instead of spinning.
// This pins that contract, so a package release that renumbers the statuses
// fails here instead of silently turning the backoff into a spin. Only signs
// are asserted, never the numbers, so a harmless renumber still passes.

import testing
import os.signal

// No include of basalam: the library re-exports nothing from the signal
// package (CHANGELOG), so the contract is imported directly.

func main:
    testing.AssertMsg(signal.WinchSignal > 0, "an arrival must be positive")
    testing.AssertEqInt(signal.WaitTimedOut, 0)
    testing.AssertMsg(signal.WaitInvalid < 0, "WaitInvalid must be negative")
    testing.AssertMsg(signal.WaitFailed < 0, "WaitFailed must be negative")
    testing.AssertMsg(signal.WaitBusy < 0, "WaitBusy must be negative")
    ret testing.Summary()
end
