import mem
import net.tunnel

func load(bytes: Vector<int>): int:
    p := mem.Allocate((bytes.len() + 1) as u64) as u8*
    repeat bytes.len() in i:
        p[i] = bytes.get(i) as u8
    end
    names := Vector {} as Vector<str>
    n := tunnel.LoadGeoSiteDat(p as void*, bytes.len(), names)
    mem.Free(p as void*)
    ret n
end

func main():
    tunnel.ClearGeo()
    wrap := Vector {} as Vector<int>
    repeat 8:
        wrap.push(255)
    end
    wrap.push(127)
    mut a := Vector {} as Vector<int>
    a.push(10)
    repeat wrap.len() in i:
        a.push(wrap.get(i))
    end
    a.push(1)
    println "huge length", load(a)
    mut b := Vector {} as Vector<int>
    b.push(10)
    b.push(200)
    b.push(1)
    println "length past the end", load(b)
    mut c := Vector {} as Vector<int>
    c.push(10)
    println "length missing", load(c)
    mut d := Vector {} as Vector<int>
    d.push(10)
    d.push(6)
    d.push(10)
    d.push(2)
    d.push(105)
    d.push(114)
    d.push(18)
    d.push(0)
    println "valid entry", load(d)
end
