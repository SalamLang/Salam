package main

import net.tunnel
import encoding

mut failures := 0

func same(a: tunnel.Node, b: tunnel.Node): bool:
    ok := a.protocol == b.protocol and a.host == b.host and a.port == b.port and a.uuid == b.uuid and a.password == b.password and a.method == b.method and a.network == b.network and a.tls == b.tls and a.security == b.security and a.sni == b.sni and a.alpn == b.alpn and a.fingerprint == b.fingerprint and a.path == b.path and a.host_header == b.host_header and a.remark == b.remark and a.flow == b.flow and a.service_name == b.service_name and a.public_key == b.public_key and a.short_id == b.short_id and a.alter_id == b.alter_id and a.plugin == b.plugin
    ret ok
end

func roundtrip(name: str, link: str):
    n := tunnel.ParseLink(link)
    if not n.valid:
        println name, "parse failed:", n.error
        failures++
        ret
    end
    out := tunnel.NodeToLink(n)
    m := tunnel.ParseLink(out)
    if not m.valid or not same(n, m):
        println name, "round trip differs"
        println link
        println out
        failures++
        ret
    end
    out2 := tunnel.NodeToLink(m)
    if out != out2:
        println name, "writer not stable"
        failures++
        ret
    end
    println name, "ok", n.protocol, tunnel.NodeAddr(n).String(), n.network, n.security, n.remark
end

func main:
    vmess_json := `{"v":"2","ps":"سرور آلمان ۱","add":"de.example.com","port":"443","id":"b831381d-6324-4d53-ad4f-8cda48b30811","aid":"0","scy":"auto","net":"ws","type":"none","host":"cdn.example.com","path":"/ws?ed=2048","tls":"tls","sni":"cdn.example.com","alpn":"h2,http/1.1","fp":"chrome"}`
    vm := "vmess://" + encoding.Base64Encode(vmess_json)
    roundtrip("vmess-ws", vm)
    n := tunnel.ParseLink(vm)
    println n.uuid, n.alter_id, n.method, n.path, n.host_header, n.sni, n.alpn, n.fingerprint, n.tls

    roundtrip("vmess-tcp-num", "vmess://" + encoding.Base64Encode(`{"v":2,"ps":"plain","add":"1.2.3.4","port":8080,"id":"11111111-2222-3333-4444-555555555555","aid":64,"net":"tcp","type":"http","host":"a.com","path":"/","tls":""}`))
    roundtrip("vmess-grpc", "vmess://" + encoding.Base64Encode(`{"v":"2","ps":"g","add":"g.example.com","port":"443","id":"11111111-2222-3333-4444-555555555555","aid":"0","scy":"aes-128-gcm","net":"grpc","path":"svc","tls":"tls","sni":"g.example.com"}`))

    reality := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@203.0.113.9:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.microsoft.com&fp=chrome&pbk=AbCdEf-xyz_123&sid=6ba85179e30d4fc2&spx=%2F&type=tcp#Reality%20%D8%A2%D9%84%D9%85%D8%A7%D9%86"
    roundtrip("vless-reality", reality)
    r := tunnel.ParseLink(reality)
    println r.flow, r.public_key, r.short_id, r.spider_x, r.remark, r.tls
    println tunnel.NodeToLink(r) == "vless://b831381d-6324-4d53-ad4f-8cda48b30811@203.0.113.9:443?encryption=none&security=reality&sni=www.microsoft.com&fp=chrome&type=tcp&flow=xtls-rprx-vision&pbk=AbCdEf-xyz_123&sid=6ba85179e30d4fc2&spx=%2F#Reality%20%D8%A2%D9%84%D9%85%D8%A7%D9%86"
    roundtrip("vless-ws-tls-v6", "vless://b831381d-6324-4d53-ad4f-8cda48b30811@[2001:db8::7]:8443?encryption=none&security=tls&sni=v.example.com&type=ws&host=v.example.com&path=%2Fvless%3Fed%3D2048&alpn=h2%2Chttp%2F1.1&fp=firefox#v6")
    roundtrip("vless-grpc", "vless://b831381d-6324-4d53-ad4f-8cda48b30811@grpc.example.com:443?security=tls&type=grpc&serviceName=my%20svc&sni=grpc.example.com#grpc")
    roundtrip("vless-plain", "vless://b831381d-6324-4d53-ad4f-8cda48b30811@plain.example.com:80?type=tcp&security=none")

    roundtrip("trojan-ws", "trojan://p%40ss%3Aword@trj.example.org:443?security=tls&sni=trj.example.org&type=ws&host=trj.example.org&path=%2Ftrojan&alpn=h2#Trojan-WS")
    roundtrip("trojan-bare", "trojan://secret@trj2.example.org:2053#%D8%AA%D8%B1%D9%88%D8%AC%D8%A7%D9%86")
    t := tunnel.ParseLink("trojan://secret@trj2.example.org:2053")
    println t.security, t.tls, t.network, t.password

    sip := "ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@192.0.2.1:8388#Plain%20SS"
    roundtrip("ss-sip002", sip)
    s := tunnel.ParseLink(sip)
    println s.method, s.password, s.host, s.port
    println tunnel.NodeToLink(s) == sip
    legacy := "ss://" + encoding.Base64Encode("chacha20-ietf-poly1305:pw:123@ss.example.org:1080") + "#legacy"
    roundtrip("ss-legacy", legacy)
    l := tunnel.ParseLink(legacy)
    println l.method, l.password, l.host, l.port
    roundtrip("ss-plugin", "ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpwdzEyMw@ss.example.org:1080/?plugin=v2ray-plugin%3Bmode%3Dwebsocket%3Btls%3Bhost%3Dx.com#p")
    plain := tunnel.ParseLink("ss://aes-128-gcm:my%2Fpass@10.0.0.1:443#x")
    println plain.valid, plain.method, plain.password
    roundtrip("ss-v6", "ss://YWVzLTEyOC1nY206eA@[::1]:8388#loop")

    each bad in ["", "vmess://", "vmess://%%%", "vmess://" + encoding.Base64Encode("not json"), "vless://@host:1", "vless://id@host", "vless://id@host:99999", "trojan://pw@:443", "ss://", "ss://abc", "http://x", "ss://YWVzLTEyOC1nY206eA@host:abc"]:
        b := tunnel.ParseLink(bad)
        if b.valid:
            println "accepted", bad
            failures++
        end
    end

    one := "vless://11111111-2222-3333-4444-555555555555@a.com:443?security=tls#A"
    two := "trojan://pw@b.com:443#B"
    three := "ss://YWVzLTEyOC1nY206eA@c.com:1#C"
    sub1 := tunnel.ParseSubscription(encoding.Base64Encode(one + "\r\n" + two + "\n\nbogus line\n" + three + "\n"))
    println "sub base64", sub1.nodes.len(), sub1.skipped, tunnel.NodeLabel(sub1.nodes[0]), tunnel.NodeLabel(sub1.nodes[2])
    sub2 := tunnel.ParseSubscription(one + "\n# note\n" + two + "\nxx\n" + three)
    println "sub plain", sub2.nodes.len(), sub2.skipped, sub2.nodes[1].protocol
    sub3 := tunnel.ParseSubscription("")
    println "sub empty", sub3.nodes.len(), sub3.skipped
    println tunnel.PctDecode("%D8%B3%D9%84%D8%A7%D9%85+x%2"), tunnel.PctEncode("سلام a/b"), tunnel.PctDecode(tunnel.PctEncode("a b&c=d/é"))
    println tunnel.B64Decode("c2FsYW0"), tunnel.B64Decode("c2FsYW0="), tunnel.B64Decode("c2Fs\nYW0="), tunnel.B64EncodeUrl("subjects?_d>>"), tunnel.B64Decode("c3ViamVjdHM_X2Q-Pg")
    println "failures", failures
    ret failures
end
