import encoding
import net.tunnel
import net.vless
import net.vmess
import net.vpn

const UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"
const PBK := "Ah1AwxBG8mOMQ5zgUCSyb2TYOmrBfV8yi7cYOQm-1xQ"

func main:
    vl := "vless://" + UUID1 + "@[2001:db8::1]:8443?encryption=none&security=tls&sni=h.example.com&alpn=h2%2Chttp%2F1.1&type=grpc&serviceName=gsvc&mode=multi#v6grpc"
    n := tunnel.ParseLink(vl)
    println "vless:", n.valid, n.host, n.port, n.network, n.service_name, n.grpc_mode, n.alpn
    back := tunnel.ParseLink(tunnel.NodeToLink(n))
    println "link round trip:", back.valid, back.grpc_mode, back.service_name
    o := tunnel.OutboundFromNode(n, "p")
    println "outbound has multiMode:", o.stream_settings.includes("multiMode")
    again := tunnel.NodeFromOutbound(o)
    println "outbound round trip:", again.grpc_mode, again.service_name
    s := vpn.NodeSettings(n)
    println "settings:", s.network, s.service_name, s.grpc_mode
    gun := tunnel.ParseLink("vless://" + UUID1 + "@h.example.com:443?encryption=none&security=tls&type=grpc&serviceName=gsvc&mode=gun")
    println "gun stays empty:", gun.grpc_mode.len() == 0, vpn.NodeSettings(gun).grpc_mode
    vm := "vmess://" + encoding.Base64Encode(`{"v":"2","ps":"g","add":"vm.example.com","port":443,"id":"` + UUID1 + `","aid":0,"net":"grpc","type":"multi","path":"vmsvc","tls":"tls"}`)
    m := tunnel.ParseLink(vm)
    println "vmess:", m.valid, m.service_name, m.grpc_mode
    k := vmess.ParseLink(vm)
    println "vmess settings:", k.ok, vmess.LinkSettings(k).service_name, vmess.LinkSettings(k).grpc_mode
    println "vmess round trip:", tunnel.ParseLink(tunnel.NodeToLink(m)).grpc_mode
    re := vless.ParseLink("vless://" + UUID1 + "@203.0.113.7:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.microsoft.com&fp=chrome&pbk=" + PBK + "&sid=6ba85179e30d4fc2&spx=%2Fa%2Fb&alpn=h2%2Chttp%2F1.1&type=tcp")
    println "reality:", re.ok, re.reality.spider_x, re.reality.alpn
end
