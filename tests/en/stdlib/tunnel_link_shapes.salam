package main

import encoding
import net.tunnel
import net.shadowsocks

const UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"
const PBK := "Ah1AwxBG8mOMQ5zgUCSyb2TYOmrBfV8yi7cYOQm-1xQ"

func show(tag: str, n: tunnel.Node):
    println tag, n.valid, n.protocol, n.host, n.port, n.network, n.security, n.tls
    println "  ", n.uuid, n.password, n.method, n.alter_id, n.flow
    println "  ", n.sni, n.alpn, n.fingerprint, n.path, n.host_header, n.service_name, n.grpc_mode
    println "  ", n.public_key, n.short_id, n.spider_x, n.allow_insecure, n.plugin, n.remark
end

func main:
    show("reality-persian", tunnel.ParseLink("vless://" + UUID1 + "@203.0.113.9:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.microsoft.com&fp=chrome&pbk=" + PBK + "&sid=6ba85179e30d4fc2&spx=%2F&type=tcp#%D8%B3%D8%B1%D9%88%D8%B1%20%D8%A2%D9%84%D9%85%D8%A7%D9%86%20%DB%B1"))
    show("ipv6-host", tunnel.ParseLink("vless://" + UUID1 + "@[2001:db8::1]:8443?encryption=none&security=tls&sni=h.example.com&type=tcp#v6"))
    show("grpc-multi", tunnel.ParseLink("vless://" + UUID1 + "@g.example.com:443?encryption=none&security=tls&sni=g.example.com&type=grpc&serviceName=gsvc&mode=multi&authority=auth.example.com#g"))
    show("ws-insecure", tunnel.ParseLink("vless://" + UUID1 + "@w.example.com:443?encryption=none&security=tls&sni=w.example.com&type=ws&host=w.example.com&path=%2Fws%3Fed%3D2048&allowInsecure=1&alpn=http%2F1.1#ws"))
    show("httpupgrade", tunnel.ParseLink("vless://" + UUID1 + "@h.example.com:80?encryption=none&security=none&type=httpupgrade&host=h.example.com&path=%2Fup#hu"))
    show("trojan-pw", tunnel.ParseLink("trojan://p%40ss%3Aw%2Fd@t.example.com:443?security=tls&sni=t.example.com&type=ws&host=t.example.com&path=%2Ft#t"))
    show("trojan-grpc", tunnel.ParseLink("trojan://pw@t.example.com:443?security=tls&type=grpc&serviceName=tsvc&mode=multi#tg"))

    base := `"add":"vm.example.com","id":"` + UUID1 + `","net":"ws","host":"cdn.example.com","path":"/p","tls":"tls","ps":"vm"`
    show("vmess-num-port", tunnel.ParseLink("vmess://" + encoding.Base64Encode(`{"v":"2","port":443,"aid":0,` + base + `}`)))
    show("vmess-str-port", tunnel.ParseLink("vmess://" + encoding.Base64Encode(`{"v":"2","port":"8443","aid":"2",` + base + `}`)))
    raw := `{"v":"2","port":"443","aid":"0",` + base + `}`
    enc := encoding.Base64Encode(raw)
    show("vmess-padded", tunnel.ParseLink("vmess://" + enc))
    mut unpadded := enc
    until unpadded.len() > 0 and unpadded.substr(unpadded.len() - 1, 1) == "=":
        unpadded = unpadded.substr(0, unpadded.len() - 1)
    end
    show("vmess-unpadded", tunnel.ParseLink("vmess://" + unpadded))
    show("vmess-grpc-multi", tunnel.ParseLink("vmess://" + encoding.Base64Encode(`{"v":"2","ps":"g","add":"g.example.com","port":"443","id":"` + UUID1 + `","aid":"0","net":"grpc","type":"multi","path":"vsvc","tls":"tls","sni":"g.example.com"}`)))

    show("ss-sip002", tunnel.ParseLink("ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@192.0.2.1:8388#Plain%20SS"))
    show("ss-sip002-plugin", tunnel.ParseLink("ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpwdzEyMw@ss.example.org:1080/?plugin=obfs-local%3Bobfs%3Dhttp%3Bobfs-host%3Dwww.bing.com#p"))
    show("ss-legacy-v6", tunnel.ParseLink("ss://" + encoding.Base64Encode("aes-128-gcm:pw:123@[2001:db8::5]:1080") + "#legacy"))
    key := "AAECAwQFBgcICQoLDA0ODw=="
    link22 := "ss://2022-blake3-aes-128-gcm:" + tunnel.PctEncode(key) + "@198.51.100.4:8388#s22"
    show("ss-2022", tunnel.ParseLink(link22))
    show("ss-2022-multi", tunnel.ParseLink("ss://2022-blake3-aes-256-gcm:" + tunnel.PctEncode("AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=") + ":" + tunnel.PctEncode(key) + "@198.51.100.4:8388#m"))
    u := shadowsocks.ParseUri(link22)
    println "uri:", u.ok, u.method, u.password, u.host, u.port, u.tag
end
