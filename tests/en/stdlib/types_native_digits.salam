import types

func main:
    each s in ["۴۲", "-٣", "42", "۳٫۵", "3.5", "۱۲x", "true", ""]:
        println "[" + s + "]",
            types.IsInt(s),
            types.IsFloat(s),
            types.IsNumeric(s),
            types.KindName(types.KindOf(s))
    end
end
