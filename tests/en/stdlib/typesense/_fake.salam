package fake

import time
import net.http
import net.router

mut _keys := Vector {} as Vector<str>
mut _codes := Vector {} as Vector<int>
mut _bodies := Vector {} as Vector<str>
mut _used := Vector {} as Vector<bool>
mut _log := Vector {} as Vector<str>

func _handle(h: i64):
    ctx := http.Ctx(h)
    method := http.Method(ctx)
    path := http.Path(ctx)
    query := http.RawQuery(ctx)
    mut target := path
    if query.len() > 0: target = path + "?" + query end
    mut line := method + " " + target
    key := http.Header(ctx, "X-TYPESENSE-API-KEY")
    if key.len() > 0: line = line + "\n  key: " + key end
    ctype := http.Header(ctx, "Content-Type")
    if ctype.len() > 0: line = line + "\n  type: " + ctype end
    extra := http.Header(ctx, "X-Tenant")
    if extra.len() > 0: line = line + "\n  tenant: " + extra end
    body := http.Body(ctx)
    if body.len() > 0: line = line + "\n  body: " + body end
    _log.push(line)
    if path == "/slow":
        time.Sleep(1500)
    end
    route := method + " " + path
    mut pick := -1
    repeat _keys.len() in i:
        if pick < 0 and _keys.get(i) == route and not _used.get(i):
            pick = i
        end
    end
    if pick < 0:
        repeat _keys.len() in i:
            if _keys.get(i) == route: pick = i end
        end
    else:
        _used.set(pick, true)
    end
    if pick < 0:
        http.SetStatus(ctx, 404)
        http.Json(ctx, `{ "message": "Not Found"}`)
        ret
    end
    http.SetStatus(ctx, _codes.get(pick))
    http.Json(ctx, _bodies.get(pick))
end

pub func On(method: str, path: str, code: int, body: str):
    _keys.push(method + " " + path)
    _codes.push(code)
    _bodies.push(body)
    _used.push(false)
end

pub func Last(): str:
    if _log.len() == 0: ret "" end
    ret _log.get(_log.len() - 1)
end

pub func Count(): int:
    ret _log.len()
end

pub func Start(port: int): bool:
    mut r := router.NewRouter()
    router.Get(r, "/*", _handle)
    router.Post(r, "/*", _handle)
    router.Put(r, "/*", _handle)
    router.Patch(r, "/*", _handle)
    router.Delete(r, "/*", _handle)
    s := http.NewServer(port)
    http.Use(s, r)
    ret http.RunBackground(s)
end
