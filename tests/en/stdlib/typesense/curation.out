synonym json: {"id": "auto", "synonyms": ["auto"], "root": "car", "locale": "en", "symbols_to_index": ["+"]}
synonym set: PUT /synonym_sets/vehicles
  key: k
  type: application/json
  body: {"items": [{"id": "cars", "synonyms": ["car", "automobile"]}]}
  vehicles items=1
  item cars root= words=car,automobile locale= symbols=
  item auto root=car words=auto locale=en symbols=+
  set vehicles
  set colors
synonym item: PUT /synonym_sets/vehicles/items/auto
  key: k
  type: application/json
  body: {"synonyms": ["auto"], "root": "car"}
  auto car car 2
delete item: auto set: vehicles
legacy synonym: PUT /collections/books/synonyms/cars
  key: k
  type: application/json
  body: {"synonyms": ["car", "automobile"]}
  cars cars 1 cars
curation json: {"id": "pin", "rule": {"query": "car", "match": "exact", "filter_by": "brand:=x", "tags": ["spring"]}, "includes": [{"id": "3", "position": 1}, {"id": "5", "position": 2}], "excludes": [{"id": "9"}], "filter_by": "stock:>0", "sort_by": "price:asc", "replace_query": "automobile", "remove_matched_tokens": true, "stop_processing": false, "effective_from_ts": 100, "effective_to_ts": 200, "metadata": {"by":"ops"}}
minimal json: {"id": "m", "rule": {"query": "x", "match": "contains"}, "filter_curated_hits": true, "diversity":{}}
curation set: PUT /curation_sets/promos
  key: k
  type: application/json
  body: {"items": [{"id": "pin", "rule": {"query": "car", "match": "exact", "filter_by": "brand:=x", "tags": ["spring"]}, "includes": [{"id": "3", "position": 1}, {"id": "5", "position": 2}], "excludes": [{"id": "9"}], "filter_by": "stock:>0", "sort_by": "price:asc", "replace_query": "automobile", "remove_matched_tokens": true, "stop_processing": false, "effective_from_ts": 100, "effective_to_ts": 200, "metadata": {"by":"ops"}}]}
  promos items=1
  rule pin q=car match=exact rf=brand:=x tags=spring in=3@1,5@2 ex=9
    filter=stock:>0 sort=price:asc replace=automobile rm=true fch=false stop=false from=100 to=200 meta={"by":"ops"}
  sets=1
  rule pin q=car match=exact rf=brand:=x tags=spring in=3@1,5@2 ex=9
    filter=stock:>0 sort=price:asc replace=automobile rm=true fch=false stop=false from=100 to=200 meta={"by":"ops"}
curation item: PUT /curation_sets/promos/items/pin
  key: k
  type: application/json
  body: {"id": "pin", "rule": {"query": "car", "match": "exact", "filter_by": "brand:=x", "tags": ["spring"]}, "includes": [{"id": "3", "position": 1}, {"id": "5", "position": 2}], "excludes": [{"id": "9"}], "filter_by": "stock:>0", "sort_by": "price:asc", "replace_query": "automobile", "remove_matched_tokens": true, "stop_processing": false, "effective_from_ts": 100, "effective_to_ts": 200, "metadata": {"by":"ops"}}
  get=pin list=1
delete item: pin set: promos
  rule pin q=car match=exact rf=brand:=x tags=spring in=3@1,5@2 ex=9
    filter=stock:>0 sort=price:asc replace=automobile rm=true fch=false stop=false from=100 to=200 meta={"by":"ops"}
override: PUT /collections/books/overrides/pin
  key: k
  type: application/json
  body: {"id": "pin", "rule": {"query": "car", "match": "exact", "filter_by": "brand:=x", "tags": ["spring"]}, "includes": [{"id": "3", "position": 1}, {"id": "5", "position": 2}], "excludes": [{"id": "9"}], "filter_by": "stock:>0", "sort_by": "price:asc", "replace_query": "automobile", "remove_matched_tokens": true, "stop_processing": false, "effective_from_ts": 100, "effective_to_ts": 200, "metadata": {"by":"ops"}}
  get=pin list=1 delete=pin
preset: PUT /presets/listing
  key: k
  type: application/json
  body: {"value": {"query_by": "title", "per_page": 5}}
  listing {"per_page":5,"query_by":"title"}
raw preset: PUT /presets/listing
  key: k
  type: application/json
  body: {"value": {"searches":[]}}
  get={"per_page":5,"query_by":"title"}
  preset listing {"per_page":5}
  preset other {"searches":[]}
  delete=listing
stopwords: PUT /stopwords/common
  key: k
  type: application/json
  body: {"stopwords": ["the", "a"], "locale": "en"}
  common en the,a
  get=common a,the list=1 delete=common
stemming: true
stemming: POST /stemming/dictionaries/import?id=irregular
  key: k
  type: text/plain
  body: {"word":"people","root":"person"}
{"word":"geese","root":"goose"}
  geese -> goose
  people -> person
  list=irregular,plurals delete=irregular
