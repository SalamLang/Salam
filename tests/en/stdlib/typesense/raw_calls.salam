import db.typesense

include fake "_fake.salam"

mut PORT := 0

func show(label: str, err: typesense.Error):
    println label + ": " + fake.Last()
    if not typesense.Ok(err):
        println "  error: " + typesense.ErrorString(err)
    end
end

func main:
    fake.On("POST", "/analytics/rules", 200, `{"name":"pq","type":"popular_queries"}`)
    fake.On("POST", "/stemming/dictionaries/import", 200, `{"ok":true}`)
    fake.On("POST", "/multi_search", 200, `{"results":[{"found":1,"hits":[]},{"found":0,"hits":[]}]}`)
    PORT = fake.StartFree()
    if PORT == 0:
        println "fake server failed to start"
        ret 1
    end
    c := typesense.New("http://127.0.0.1:" + PORT, "xyz")
    mut err := typesense.Error {}

    println typesense.CreateAnalyticsRuleJSON(c, `{"name":"pq","type":"popular_queries","params":{"limit":10}}`, err)
    show("rule", err)

    println typesense.ImportStemmingJSONL(c, "plurals", `{"word":"people","root":"person"}` + "\n" + `{"word":"children","root":"child"}`, err)
    show("stemming", err)

    mut reqs := Vector {} as Vector<typesense.SearchRequest>
    reqs.push(typesense.SearchRequest { collection = "lib", params = typesense.NewSearch("dune", "title") })
    reqs.push(typesense.SearchRequest { collection = "lib", params = typesense.NewSearch("emma", "title") })
    println typesense.MultiSearchRaw(c, reqs, typesense.NewSearch("", "title"), err)
    show("multi", err)
    ret 0
end
