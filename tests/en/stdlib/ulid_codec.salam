package main

import encoding.ulid
import str

func show(label: str, r: ulid.Result):
    if r.ok:
        println label, "ok", ulid.String(r.id)
    else:
        println label, "error", r.err, ulid.ErrorText(r.err)
    end
end

func hex(b: Vector<u8>): str:
    digits := "0123456789abcdef"
    mut out := ""
    repeat b.Len() in i:
        code := b.Get(i) as int
        out = out + str.Substr(digits, code / 16, 1) + str.Substr(digits, code % 16, 1)
    end
    ret out
end

func main:
    spec := ulid.Parse("01ARYZ6S41TSV4RRFFQ69G5FAV")
    println spec.ok, ulid.Time(spec.id), ulid.String(spec.id)
    sb := ulid.Bytes(spec.id)
    defer sb.Free()
    println hex(sb)
    println ulid.MAX_TIME

    mx := ulid.Parse("7ZZZZZZZZZZZZZZZZZZZZZZZZZ")
    println mx.ok, ulid.Time(mx.id), ulid.String(mx.id)
    mb := ulid.Bytes(mx.id)
    defer mb.Free()
    println hex(mb)

    zero := ulid.Parse("00000000000000000000000000")
    println zero.ok, ulid.IsZero(zero.id), ulid.IsZero(spec.id)

    show("overflow", ulid.Parse("80000000000000000000000000"))
    show("overflow2", ulid.Parse("ZZZZZZZZZZZZZZZZZZZZZZZZZZ"))
    show("short", ulid.Parse("01ARYZ6S41TSV4RRFFQ69G5FA"))
    show("long", ulid.Parse("01ARYZ6S41TSV4RRFFQ69G5FAVV"))
    show("empty", ulid.Parse(""))
    show("u", ulid.Parse("01ARYZ6S41TSV4RRFFQ69G5FAU"))
    show("dash", ulid.Parse("01ARYZ6S41-SV4RRFFQ69G5FAV"))
    show("space", ulid.Parse("01ARYZ6S41 SV4RRFFQ69G5FAV"))
    show("utf8", ulid.Parse("01ARYZ6S41TSV4RRFFQ69G5Fé"))

    lower := ulid.Parse("01aryz6s41tsv4rrffq69g5fav")
    println lower.ok, ulid.Equal(lower.id, spec.id)
    alias := ulid.Parse("0OIL0000000000000000000000")
    plain := ulid.Parse("00110000000000000000000000")
    println alias.ok, ulid.Equal(alias.id, plain.id), ulid.String(alias.id)
    show("strict lower", ulid.ParseStrict("01aryz6s41tsv4rrffq69g5fav"))
    show("strict alias", ulid.ParseStrict("0OIL0000000000000000000000"))
    show("strict ok", ulid.ParseStrict("01ARYZ6S41TSV4RRFFQ69G5FAV"))
    println ulid.IsValid("01ARYZ6S41TSV4RRFFQ69G5FAV"), ulid.IsValid("nope")
    println ulid.String(ulid.ParseOr("nope", spec.id))

    mut seed := Vector {} as Vector<u8>
    defer seed.Free()
    repeat 10 in i:
        seed.Push((i + 1) as u8)
    end
    p := ulid.FromParts(1469918176385, seed)
    println p.ok, ulid.String(p.id)
    pb := ulid.Bytes(p.id)
    defer pb.Free()
    println hex(pb)
    pe := ulid.Entropy(p.id)
    defer pe.Free()
    println hex(pe)
    show("time neg", ulid.FromParts(-1, seed))
    show("time big", ulid.FromParts(281474976710656, seed))
    mut short := Vector {} as Vector<u8>
    defer short.Free()
    short.Push(1 as u8)
    show("entropy len", ulid.FromParts(5, short))

    back := ulid.FromBytes(pb)
    println back.ok, ulid.Equal(back.id, p.id)
    show("bytes len", ulid.FromBytes(short))
    uu := ulid.ToUUIDBytes(p.id)
    defer uu.Free()
    uback := ulid.FromUUIDBytes(uu)
    println uu.Len(), uback.ok, ulid.Equal(uback.id, p.id)

    mut times := Vector {} as Vector<i64>
    defer times.Free()
    times.Push(0 as i64)
    times.Push(1 as i64)
    times.Push(31 as i64)
    times.Push(32 as i64)
    times.Push(1000 as i64)
    times.Push(1469918176385 as i64)
    times.Push(ulid.MAX_TIME)
    mut sorted := true
    mut prev := ""
    repeat times.Len() in i:
        id := ulid.MinAt(times.Get(i))
        cur := ulid.String(id)
        round := ulid.Parse(cur)
        if not round.ok or not ulid.Equal(round.id, id) or ulid.Time(round.id) != times.Get(i):
            sorted = false
        end
        if i > 0 and str.Compare(prev, cur) >= 0:
            sorted = false
        end
        prev = cur
    end
    println "chronological order matches text order:", sorted
end
