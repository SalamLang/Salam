package main

import encoding.ulid

mut g_now := 0 as i64
mut g_entropy := 0 as i64

func fake_clock(): i64:
    ret g_now
end

func fake_entropy(): i64:
    ret g_entropy
end

func line(label: str, r: ulid.Result):
    if r.ok:
        println label, ulid.Time(r.id), ulid.String(r.id)
    else:
        println label, "error", ulid.ErrorText(r.err)
    end
end

func main:
    g_now = 1000
    g_entropy = 5
    g := ulid.NewGeneratorWith((): ret fake_clock() end, (): ret fake_entropy() end)
    defer ulid.Free(g)

    line("first", ulid.Next(g))
    line("same ms", ulid.Next(g))
    line("same ms", ulid.Next(g))
    g_now = 1001
    g_entropy = 9
    line("next ms", ulid.Next(g))
    g_now = 900
    line("clock back", ulid.Next(g))
    line("clock back", ulid.Next(g))
    last := ulid.Last(g)
    line("last", last)

    line("explicit", ulid.NextAt(g, 2000))
    line("explicit past", ulid.NextAt(g, 5))
    line("bad time", ulid.NextAt(g, -1))
    line("bad time", ulid.NextAt(g, ulid.MAX_TIME + 1))

    g_entropy = 1099511627775
    g_now = 5000
    line("max entropy", ulid.Next(g))
    line("rolled", ulid.Next(g))
    line("rolled", ulid.Next(g))

    lo := ulid.FromParts(7, Vector {} as Vector<u8>)
    println lo.ok

    mut seed := Vector {} as Vector<u8>
    defer seed.Free()
    repeat 10:
        seed.Push(255 as u8)
    end
    top := ulid.FromParts(100, seed)
    inc := ulid.Increment(top.id)
    println inc.ok, ulid.ErrorText(inc.err)
    mut seed2 := Vector {} as Vector<u8>
    defer seed2.Free()
    repeat 5:
        seed2.Push(0 as u8)
    end
    repeat 4:
        seed2.Push(255 as u8)
    end
    seed2.Push(254 as u8)
    carry := ulid.Increment(ulid.FromParts(100, seed2).id)
    println carry.ok, ulid.String(carry.id)
    mut seed3 := Vector {} as Vector<u8>
    defer seed3.Free()
    repeat 4:
        seed3.Push(0 as u8)
    end
    seed3.Push(255 as u8)
    repeat 5:
        seed3.Push(255 as u8)
    end
    carry2 := ulid.Increment(ulid.FromParts(100, seed3).id)
    println carry2.ok, ulid.String(carry2.id)

    g_now = ulid.MAX_TIME
    top2 := ulid.NewGeneratorWith((): ret fake_clock() end, (): ret fake_entropy() end)
    defer ulid.Free(top2)
    line("at max", ulid.Next(top2))
    line("max overflow", ulid.Next(top2))

    g_entropy = -1
    broken := ulid.NewGeneratorWith((): ret fake_clock() end, (): ret fake_entropy() end)
    defer ulid.Free(broken)
    line("no entropy", ulid.Next(broken))
    println ulid.Last(broken).ok
    g_entropy = 7
    g_now = 3
    line("recovered", ulid.Next(broken))

    g_now = 77
    g_entropy = 0
    b := ulid.NewGeneratorWith((): ret fake_clock() end, (): ret fake_entropy() end)
    defer ulid.Free(b)
    batch := ulid.Batch(b, 4)
    defer batch.Free()
    repeat batch.Len() in i:
        println ulid.String(batch.Get(i))
    end

    mn := ulid.MinAt(1469918176385)
    mxx := ulid.MaxAt(1469918176385)
    println ulid.String(mn), ulid.String(mxx)
    println ulid.Compare(mn, mxx), ulid.Compare(mxx, mn), ulid.Compare(mn, mn)
    println ulid.String(ulid.MinAt(-5)), ulid.String(ulid.MaxAt(ulid.MAX_TIME + 10))

    now := ulid.New()
    now2 := ulid.New()
    println ulid.Less(now, now2), ulid.String(now).Len(), ulid.NewString().Len()
    stamp := ulid.NewAt(1469918176385)
    println stamp.ok, ulid.Time(stamp.id), ulid.String(stamp.id).Len()
    println ulid.NewAt(-1).ok
    nb := ulid.NewBatch(50)
    defer nb.Free()
    mut ordered := nb.Len() == 50
    repeat nb.Len() - 1 in i:
        if not ulid.Less(nb.Get(i), nb.Get(i + 1)):
            ordered = false
        end
    end
    println "default batch strictly increasing:", ordered
    drift := ulid.Time(now) - ulid.Now()
    println drift > -5000 and drift < 5000
end
