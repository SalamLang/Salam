package main

import unicode

func main:
    println "general categories"
    println unicode.Category(65) == unicode.CatLu, unicode.Category(97) == unicode.CatLl
    println unicode.Category(0x1C5) == unicode.CatLt, unicode.Category(0x5D0) == unicode.CatLo
    println unicode.Category(48) == unicode.CatNd, unicode.Category(32) == unicode.CatZs
    println unicode.Category(0) == unicode.CatCc, unicode.Category(0x200C) == unicode.CatCf
    println unicode.Category(43) == unicode.CatSm, unicode.Category(36) == unicode.CatSc
    println unicode.Category(0x378) == unicode.CatCn, unicode.Category(0 - 1) == unicode.CatCn
    println unicode.Category(0x110000) == unicode.CatCn

    println "predicates"
    println unicode.IsControl(9), unicode.IsControl(0x7F), unicode.IsControl(0x85), unicode.IsControl(65)
    println unicode.IsSymbol(43), unicode.IsSymbol(36), unicode.IsSymbol(0x2603), unicode.IsSymbol(65), unicode.IsSymbol(46)
    println unicode.IsTitle(0x1C5), unicode.IsTitle(0x1F88), unicode.IsTitle(65), unicode.IsTitle(97)

    println "title case"
    println unicode.ToTitle(97), unicode.ToTitle(122), unicode.ToTitle(65), unicode.ToTitle(48)
    println unicode.ToTitle(0x1C6) == 0x1C5, unicode.ToTitle(0x1C4) == 0x1C5, unicode.ToTitle(0xE9) == 0xC9
    println unicode.ToTitle(0x5D0) == 0x5D0

    println "canonical decomposition"
    println unicode.DecompLen(65), unicode.DecompLen(0xE9), unicode.DecompLen(0x1E09)
    println unicode.DecompAt(0xE9, 0) == 0x65, unicode.DecompAt(0xE9, 1) == 0x301
    println unicode.DecompAt(0xE9, 2) == 0xE9, unicode.DecompAt(65, 0), unicode.DecompAt(0xE9, 0 - 1) == 0xE9
    println unicode.DecompLen(0xAC00), unicode.DecompLen(0xAC01), unicode.DecompAt(0xAC01, 2) == 0x11A8

    println "compatibility decomposition"
    println unicode.CompatDecompLen(0xFB01), unicode.CompatDecompAt(0xFB01, 0), unicode.CompatDecompAt(0xFB01, 1)
    println unicode.CompatDecompLen(0xB2), unicode.CompatDecompAt(0xB2, 0)
    println unicode.CompatDecompLen(65), unicode.CompatDecompAt(65, 0), unicode.CompatDecompAt(0xFB01, 5) == 0xFB01
    println unicode.CompatDecompLen(0xAC01), unicode.CompatDecompLen(0xE9)

    println "composition"
    println unicode.Compose(0x65, 0x301) == 0xE9, unicode.Compose(0x41, 0x30A) == 0xC5
    println unicode.Compose(0x65, 0x65), unicode.Compose(0x1100, 0x1161) == 0xAC00
    println unicode.Compose(0xAC00, 0x11A8) == 0xAC01, unicode.Compose(0xAC01, 0x11A8)

    println "grapheme break classes"
    println unicode.GraphemeBreak(13) == unicode.GcbCR, unicode.GraphemeBreak(10) == unicode.GcbLF
    println unicode.GraphemeBreak(0x301) == unicode.GcbExtend, unicode.GraphemeBreak(0x200D) == unicode.GcbZWJ
    println unicode.GraphemeBreak(0x1F1E6) == unicode.GcbRegionalIndicator, unicode.GraphemeBreak(65) == unicode.GcbOther
    println unicode.GraphemeBreak(0xAC00) == unicode.GcbLV, unicode.GraphemeBreak(0xAC01) == unicode.GcbLVT
    println unicode.GraphemeBreak(0x1100) == unicode.GcbL, unicode.GraphemeBreak(0x1161) == unicode.GcbV
    println unicode.GraphemeBreak(0x11A8) == unicode.GcbT, unicode.GraphemeBreak(0x1F600) == unicode.GcbExtendedPictographic
    println unicode.GraphemeBreak(0x600) == unicode.GcbPrepend, unicode.GraphemeBreak(0x903) == unicode.GcbSpacingMark

    println "conjunct breaks"
    println unicode.ConjunctBreak(0x915) == unicode.IncbConsonant, unicode.ConjunctBreak(0x94D) == unicode.IncbLinker
    println unicode.ConjunctBreak(0x93C) == unicode.IncbExtend, unicode.ConjunctBreak(65) == unicode.IncbNone

    println "paired brackets"
    println unicode.PairedBracketType(40) == unicode.PbtOpen, unicode.PairedBracketType(41) == unicode.PbtClose
    println unicode.PairedBracketType(65) == unicode.PbtNone, unicode.PairedBracketType(0x300C) == unicode.PbtOpen
    println unicode.PairedBracket(40), unicode.PairedBracket(41), unicode.PairedBracket(91), unicode.PairedBracket(93)
    println unicode.PairedBracket(123), unicode.PairedBracket(65), unicode.PairedBracket(0x300C) == 0x300D
end
