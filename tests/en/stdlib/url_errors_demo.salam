package main

import encoding.url
import encoding.query

func show(label: str, e: Error):
    println label + ": " + e.kind_name() + " | " + e.ToStr()
end

func parse(label: str, text: str):
    try:
        u := url.Parse(text)
        println label + ": ok scheme=" + u.scheme + " host=" + u.host + " port=" + u.port + " path=" + u.path
    catch e:
        show(label, e)
    end
end

func parse_errors():
    println "== url.Parse =="
    parse("full", "https://user:pw@example.com:8443/a%20b?q=1#top")
    parse("scheme-relative", "//cdn.example.com/app.js")
    parse("relative path", "../img/logo.png")
    parse("query only", "?page=2")
    parse("file URL", "file:///etc/hosts")
    parse("IPv6", "http://[2001:db8::1]:8080/")
    parse("empty port", "http://example.com:/x")
    parse("empty", "")
    parse("space", "http://example.com/a b")
    parse("bad scheme", "ht%tp://example.com/")
    parse("scheme starts with a digit", "1http://example.com/")
    parse("no scheme before ://", "://example.com/")
    parse("no host", "https:///path")
    parse("bad host", "http://exa<mple.com/")
    parse("bad port", "http://example.com:8o80/")
    parse("port too large", "http://example.com:70000/")
    parse("unclosed IPv6", "http://[::1/x")
    parse("bad IPv6", "http://[::1x]/")
    parse("text after IPv6", "http://[::1]x/")
    parse("bad escape in path", "http://example.com/a%zz")
    parse("cut escape in query", "http://example.com/?q=100%")
    parse("bad escape in fragment", "http://example.com/#%G1")
    parse("bad escape in userinfo", "http://us%er@example.com/")
    parse("bad escape in host", "http://exa%2mple.com/")
end

func helper_errors():
    println ""
    println "== helpers =="
    mut base := url.URL {}
    try:
        base = url.Parse("https://example.com/docs/guide/")
        println "join: " + url.String(url.Join(base, "../api?v=2#top"))
        println "join query only: " + url.String(url.Join(base, "?v=3"))
        _ := url.Join(base, "a%zz")
    catch e:
        show("join bad reference", e)
    end
    mut edited := base
    edited.path = "/menu%g9"
    try:
        _ := url.DecodedPath(edited)
    catch e:
        show("decoded path", e)
    end
    edited.userinfo = "ali%"
    try:
        _ := url.DecodedUserinfo(edited)
    catch e:
        show("decoded userinfo", e)
    end
    edited.raw_query = "a=1&b=%zz"
    try:
        _ := url.Query(edited)
    catch e:
        show("query", e)
    end
    try:
        url.SetParam(edited, "c", "3")
    catch e:
        show("set param", e)
    end
    try:
        _ := url.ParamNames(edited)
    catch e:
        show("param names", e)
    end
    try:
        _ := url.RemoveParam(edited, "a")
    catch e:
        show("remove param", e)
    end
    mut keep := Vector {} as Vector<str>
    defer keep.free()
    keep.push("a")
    try:
        url.KeepParams(edited, keep)
    catch e:
        show("keep params", e)
    end
end

func query_errors():
    println ""
    println "== query =="
    try:
        m := query.Decode("q=salam+lang&tag=a&tag=b")
        println "decode: " + query.Size(m) + " keys, q=" + query.Get("q=salam+lang", "q")
    catch e:
        show("decode", e)
    end
    try:
        _ := query.Decode("q=50%")
    catch e:
        show("decode cut escape", e)
    end
    try:
        _ := query.Decode("a=1&b%zz=2")
    catch e:
        show("decode bad key", e)
    end
    try:
        _ := query.DecodeWith("x=%4", query.QueryOptions { space_as_plus = false })
    catch e:
        show("decode with options", e)
    end
    println "lenient get: " + query.Get("q=50%&r=%zz%41", "q") + " " + query.Get("q=50%&r=%zz%41", "r")
    println "lenient has: " + query.Has("%zz=1", "%zz")
    println "lenient get all:", query.GetAll("t=%&t=%41", "t")
end

func main:
    parse_errors()
    helper_errors()
    query_errors()
end
