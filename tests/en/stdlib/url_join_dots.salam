import encoding.url

func main throw:
    base := try url.Parse("http://a/b/c/d;p?q")
    each r in [
        "g", "./g", "g/", "/./g", "../g", "..", "../", "../..", "../../g", "../../../g", ".", "./",
        "g/../h", "g/./h", "/a/b/../c", "g?y/./x#s", "?y", "#s", "g#s"
    ]:
        u := try url.Join(base, r)
        println r, "->", url.String(u)
    end
end
