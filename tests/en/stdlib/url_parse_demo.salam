package main

import testing
import encoding.url


func test_full_url():
    u := url.Parse("https://user:pw@shop.example.co.uk:8443/cart/item%20one?a=1&b=2#checkout")
    testing.AssertEqStr(u.scheme, "https")
    testing.AssertEqStr(u.userinfo, "user:pw")
    testing.AssertEqStr(u.host, "shop.example.co.uk")
    testing.AssertEqInt(u.port, 8443)
    testing.AssertEqStr(u.path, "/cart/item%20one")
    testing.AssertEqStr(url.DecodedPath(u), "/cart/item one")
    testing.AssertEqStr(u.raw_query, "a=1&b=2")
    testing.AssertEqStr(u.fragment, "checkout")
    testing.AssertEqStr(url.DecodedUserinfo(u), "user:pw")
    testing.AssertEqStr(url.HostPort(u), "shop.example.co.uk:8443")
    testing.AssertEqStr(url.Hostname(u), "shop.example.co.uk")
end

func test_minimal_urls():
    a := url.Parse("http://example.com")
    testing.AssertEqStr(a.scheme, "http")
    testing.AssertEqStr(a.host, "example.com")
    testing.AssertEqInt(a.port, 0)
    testing.AssertEqStr(a.path, "")
    testing.AssertEqStr(url.HostPort(a), "example.com")

    b := url.Parse("https://example.com/")
    testing.AssertEqStr(b.path, "/")

    c := url.Parse("/just/a/path?x=1")
    testing.AssertEqStr(c.scheme, "")
    testing.AssertEqStr(c.host, "")
    testing.AssertEqStr(c.path, "/just/a/path")
    testing.AssertEqStr(c.raw_query, "x=1")
end

func test_host_parts():
    a := url.Parse("https://www.example.com/x")
    testing.AssertEqStr(url.Subdomain(a), "www")
    testing.AssertEqStr(url.Domain(a), "example.com")
    testing.AssertEqStr(url.PublicSuffix(a), "com")

    b := url.Parse("https://example.com")
    testing.AssertEqStr(url.Subdomain(b), "")
    testing.AssertEqStr(url.Domain(b), "example.com")

    c := url.Parse("https://a.b.c.example.org/x")
    testing.AssertEqStr(url.Subdomain(c), "a.b.c")
    testing.AssertEqStr(url.Domain(c), "example.org")
    testing.AssertEqStr(url.PublicSuffix(c), "org")
end

func test_multi_label_suffix():
    a := url.Parse("https://example.co.uk/")
    testing.AssertEqStr(url.PublicSuffix(a), "co.uk")
    testing.AssertEqStr(url.Domain(a), "example.co.uk")
    testing.AssertEqStr(url.Subdomain(a), "")

    b := url.Parse("https://shop.example.co.uk/")
    testing.AssertEqStr(url.Domain(b), "example.co.uk")
    testing.AssertEqStr(url.Subdomain(b), "shop")

    c := url.Parse("https://a.b.example.com.au/")
    testing.AssertEqStr(url.PublicSuffix(c), "com.au")
    testing.AssertEqStr(url.Domain(c), "example.com.au")
    testing.AssertEqStr(url.Subdomain(c), "a.b")

    d := url.Parse("https://uk.example.com/")
    testing.AssertEqStr(url.PublicSuffix(d), "com")
    testing.AssertEqStr(url.Domain(d), "example.com")
    testing.AssertEqStr(url.Subdomain(d), "uk")
end

func test_hosts_without_domains():
    ip := url.Parse("http://192.168.1.10:8080/status")
    testing.AssertTrue(url.IsIP(ip))
    testing.AssertEqStr(url.Domain(ip), "192.168.1.10")
    testing.AssertEqStr(url.Subdomain(ip), "")
    testing.AssertEqStr(url.PublicSuffix(ip), "")
    testing.AssertEqInt(ip.port, 8080)

    v6 := url.Parse("http://[2001:db8::1]:9000/x")
    testing.AssertTrue(url.IsIP(v6))
    testing.AssertEqStr(v6.host, "2001:db8::1")
    testing.AssertEqInt(v6.port, 9000)
    testing.AssertEqStr(url.HostPort(v6), "[2001:db8::1]:9000")

    local := url.Parse("http://localhost:3000/")
    testing.AssertFalse(url.IsIP(local))
    testing.AssertEqStr(url.Domain(local), "localhost")
    testing.AssertEqStr(url.Subdomain(local), "")
    testing.AssertEqStr(url.PublicSuffix(local), "")

    named := url.Parse("http://a.b.c.d/")
    testing.AssertFalse(url.IsIP(named))
end

func test_labels():
    u := url.Parse("https://a.b.example.com/")
    ls := url.Labels(u)
    defer ls.free()
    testing.AssertEqInt(ls.len(), 4)
    testing.AssertEqStr(ls.get(0), "a")
    testing.AssertEqStr(ls.get(3), "com")
end

func test_string_roundtrip():
    raw := "https://user@example.com:8443/a/b?x=1&y=2#f"
    testing.AssertEqStr(url.String(url.Parse(raw)), raw)
    testing.AssertEqStr(url.String(url.Parse("http://example.com/")), "http://example.com/")
    testing.AssertEqStr(url.String(url.Parse("/local/path?q=1")), "/local/path?q=1")
    testing.AssertEqStr(url.String(url.Parse("https://[2001:db8::1]/x")), "https://[2001:db8::1]/x")
end

func test_join():
    base := url.Parse("https://example.com/docs/guide/intro.html")
    testing.AssertEqStr(url.String(url.Join(base, "/other")), "https://example.com/other")
    testing.AssertEqStr(url.String(url.Join(base, "next.html")), "https://example.com/docs/guide/next.html")
    testing.AssertEqStr(url.String(url.Join(base, "http://other.org/x")), "http://other.org/x")
    testing.AssertEqStr(url.String(url.Join(base, "//cdn.example.com/a.js")), "https://cdn.example.com/a.js")
    j := url.Join(url.Parse("https://example.com/a/b?old=1#frag"), "c")
    testing.AssertEqStr(j.raw_query, "")
    testing.AssertEqStr(j.fragment, "")
end

func main:
    test_full_url()
    test_minimal_urls()
    test_host_parts()
    test_multi_label_suffix()
    test_hosts_without_domains()
    test_labels()
    test_string_roundtrip()
    test_join()
    testing.Summary()
    ret 0
end
