import encoding.uuid
import mem

func main:
    id := uuid.MustParse("f81d4fae-7dec-11d0-a765-00a0c91e6bf6")
    buf := mem.Allocate(16 as u64)
    defer mem.Free(buf)
    uuid.ToBuffer(id, buf)
    p := buf as u8*
    println p[0], p[6], p[8], p[15]
    back := uuid.FromBuffer(buf)
    println uuid.Equal(back, id), back.to_str()
    println id.to_str() == uuid.String(id)
    println uuid.Nil().to_str()
    println uuid.Max().to_str()
    println id.hi == back.hi, id.lo == back.lo
    p[15] = 0 as u8
    other := uuid.FromBuffer(buf)
    println uuid.Equal(other, id)
    println other.to_str()
end
