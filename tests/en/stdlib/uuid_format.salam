import encoding.uuid

func show(label: str, r: uuid.ParseResult):
    if r.ok:
        println label, "ok", uuid.String(r.id)
    else:
        println label, "error", r.error
    end
end

func main:
    nil := uuid.Nil()
    mx := uuid.Max()
    println uuid.String(nil)
    println uuid.String(mx)
    println uuid.IsNil(nil), uuid.IsNil(mx), uuid.IsMax(mx), uuid.IsMax(nil)
    println uuid.Version(nil), uuid.Variant(nil) == uuid.VARIANT_NCS
    println uuid.Version(mx), uuid.Variant(mx) == uuid.VARIANT_FUTURE

    id := uuid.MustParse("F81D4FAE-7DEC-11D0-A765-00A0C91E6BF6")
    println id
    println uuid.Upper(id)
    println uuid.Compact(id)
    println uuid.Braced(id)
    println uuid.URN(id)
    println uuid.Version(id), uuid.Variant(id) == uuid.VARIANT_RFC
    println uuid.HasTime(id), uuid.UnixMillis(id)

    show("canonical", uuid.Parse("f81d4fae-7dec-11d0-a765-00a0c91e6bf6"))
    show("upper", uuid.Parse("F81D4FAE-7DEC-11D0-A765-00A0C91E6BF6"))
    show("compact", uuid.Parse("f81d4fae7dec11d0a76500a0c91e6bf6"))
    show("braced", uuid.Parse("{f81d4fae-7dec-11d0-a765-00a0c91e6bf6}"))
    show("urn", uuid.Parse("urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6"))
    show("urn upper", uuid.Parse("URN:UUID:F81D4FAE-7DEC-11D0-A765-00A0C91E6BF6"))
    show("empty", uuid.Parse(""))
    show("short", uuid.Parse("f81d4fae-7dec-11d0-a765"))
    show("long", uuid.Parse("f81d4fae-7dec-11d0-a765-00a0c91e6bf6ff"))
    show("bad hex", uuid.Parse("g81d4fae-7dec-11d0-a765-00a0c91e6bf6"))
    show("bad hyphen", uuid.Parse("f81d4fae_7dec-11d0-a765-00a0c91e6bf6"))
    show("moved hyphen", uuid.Parse("f81d4fa-e7dec-11d0-a765-00a0c91e6bf6"))
    show("one brace", uuid.Parse("{f81d4fae-7dec-11d0-a765-00a0c91e6bf6)"))
    show("bad urn", uuid.Parse("urn:uudi:f81d4fae-7dec-11d0-a765-00a0c91e6bf6"))
    show("spaces", uuid.Parse(" f81d4fae-7dec-11d0-a765-00a0c91e6bf6 "))
    println uuid.IsValid("f81d4fae7dec11d0a76500a0c91e6bf6"), uuid.IsValid("nope")
    println uuid.String(uuid.ParseOr("nope", mx))

    a := uuid.MustParse("00000000-0000-0000-0000-000000000001")
    b := uuid.MustParse("00000000-0000-0000-0000-000000000002")
    c := uuid.MustParse("00000000-0000-0001-0000-000000000000")
    d := uuid.MustParse("80000000-0000-0000-0000-000000000000")
    println uuid.Compare(a, b), uuid.Compare(b, a), uuid.Compare(a, a)
    println uuid.Less(b, c), uuid.Less(c, d), uuid.Less(d, a)
    println uuid.Equal(a, a), uuid.Equal(a, b)

    mut bytes := uuid.Bytes(id)
    println bytes.Len(), bytes.Get(0), bytes.Get(8), bytes.Get(15)
    back := uuid.FromBytes(bytes)
    println uuid.Equal(back, id)
    bytes.Pop()
    println uuid.IsNil(uuid.FromBytes(bytes))
    bytes.Free()
    println uuid.Byte(id, 0), uuid.Byte(id, 15), uuid.Byte(id, 16)

    println uuid.Version(uuid.MustParse("00000000-0000-1000-8000-000000000000"))
    println uuid.Variant(uuid.MustParse("00000000-0000-4000-c000-000000000000")) == uuid.VARIANT_MICROSOFT
    println uuid.Variant(uuid.MustParse("00000000-0000-4000-7000-000000000000")) == uuid.VARIANT_NCS
    println uuid.Variant(uuid.MustParse("00000000-0000-4000-bfff-000000000000")) == uuid.VARIANT_RFC
end
