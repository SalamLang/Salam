import encoding.uuid
import time

const COUNT := 5000

func unique_count(ids: Vector<uuid.UUID>): int:
    mut seen := HashMap {} as HashMap<str, int>
    defer seen.free()
    repeat ids.len() in i:
        seen.put(uuid.Compact(ids.get(i)), 1)
    end
    ret seen.size()
end

func all_sorted(ids: Vector<uuid.UUID>): bool:
    repeat ids.len() - 1 in i:
        if uuid.Compare(ids.get(i), ids.get(i + 1)) >= 0: ret false end
    end
    ret true
end

func main:
    mut v4 := uuid.Batch(COUNT)
    defer v4.free()
    mut good4 := true
    repeat v4.len() in i:
        u := v4.get(i)
        if uuid.Version(u) != 4 or uuid.Variant(u) != uuid.VARIANT_RFC: good4 = false end
        if uuid.String(u).len() != 36: good4 = false end
    end
    println "v4 count", v4.len(), "valid", good4, "unique", unique_count(v4) == COUNT
    println "new", uuid.Version(uuid.New()), uuid.NewString().len(), uuid.IsValid(uuid.NewString())

    before := time.NowMillis()
    mut v7 := uuid.BatchV7(COUNT)
    defer v7.free()
    after := time.NowMillis()
    mut good7 := true
    repeat v7.len() in i:
        u := v7.get(i)
        if uuid.Version(u) != 7 or uuid.Variant(u) != uuid.VARIANT_RFC: good7 = false end
    end
    first := uuid.UnixMillis(v7.get(0))
    println "v7 valid", good7, "unique", unique_count(v7) == COUNT, "sorted", all_sorted(v7)
    println "v7 time", first >= before, uuid.UnixMillis(v7.get(COUNT - 1)) <= after + 100
    println "v7 text sorted", uuid.String(v7.get(0)) < uuid.String(v7.get(COUNT - 1))

    mut v1 := Vector {} as Vector<uuid.UUID>
    defer v1.free()
    mut v6 := Vector {} as Vector<uuid.UUID>
    defer v6.free()
    repeat COUNT:
        v1.push(uuid.NewV1())
        v6.push(uuid.NewV6())
    end
    println "v1 unique", unique_count(v1) == COUNT, "version", uuid.Version(v1.get(0)), "variant", uuid.Variant(v1.get(0)) == uuid.VARIANT_RFC
    println "v6 unique", unique_count(v6) == COUNT, "version", uuid.Version(v6.get(0)), "sorted", all_sorted(v6)
    now_ns := time.NowNanos()
    drift := now_ns - uuid.UnixNanos(v1.get(0))
    println "v1 near now", drift >= 0 - 1000000000 and drift < 60000000000
    mut mono1 := true
    repeat COUNT - 1 in i:
        if uuid.Timestamp(v1.get(i)) >= uuid.Timestamp(v1.get(i + 1)): mono1 = false end
    end
    println "v1 timestamps increase", mono1
    println "v1 node", uuid.Node(v1.get(0)) == uuid.Node(v1.get(COUNT - 1)), uuid.Node(v1.get(0)) == uuid.NodeID()
    println "v1 multicast bit", (uuid.NodeID() >> 40) & 1
    println "v1 and v6 share node", uuid.Node(v1.get(0)) == uuid.Node(v6.get(0))
    own := uuid.NewV1WithNode(0x0123456789AB)
    println "v1 own node", uuid.Node(own) == 0x0123456789AB, uuid.Version(own)

    a := uuid.NewV4()
    b := uuid.NewV4()
    println "v4 differ", uuid.Equal(a, b), uuid.IsNil(a)
    m8 := uuid.NewV8(1 as u64, 2 as u64)
    println "v8", uuid.Version(m8), uuid.Variant(m8) == uuid.VARIANT_RFC
end
