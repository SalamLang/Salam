import encoding.uuid
import str

func main:
    id := uuid.MustParse("f81d4fae-7dec-11d0-a765-00a0c91e6bf6")
    println uuid.Base64URL(id)
    println uuid.Base32(id)
    println uuid.Base64URL(uuid.Nil()), uuid.Base64URL(uuid.Max())
    println uuid.Base32(uuid.Nil()), uuid.Base32(uuid.Max())

    r64 := uuid.FromBase64URL(uuid.Base64URL(id))
    println r64.ok, uuid.Equal(r64.id, id)
    r32 := uuid.FromBase32(uuid.Base32(id))
    println r32.ok, uuid.Equal(r32.id, id)
    up := uuid.FromBase32(str.Upper(uuid.Base32(id)))
    println up.ok, uuid.Equal(up.id, id)

    println uuid.FromBase64URL("short").error
    println uuid.FromBase64URL("+B1PruflEdCnZQCgyR5r9g").error
    println uuid.FromBase64URL("-B1PruflEdCnZQCgyR5r9h").error
    println uuid.FromBase32("!aodh4xpehaaizzfqpuunbhuvy").error
    println uuid.FromBase32("7aodh4xpehaaizzfqpuunbhuvz").error

    mut ok := true
    repeat 200:
        u := uuid.NewV4()
        a := uuid.FromBase64URL(uuid.Base64URL(u))
        b := uuid.FromBase32(uuid.Base32(u))
        c := uuid.Parse(uuid.Compact(u))
        d := uuid.Parse(uuid.URN(u))
        if not (a.ok and b.ok and c.ok and d.ok): ok = false end
        if not (uuid.Equal(a.id, u) and uuid.Equal(b.id, u) and uuid.Equal(c.id, u) and uuid.Equal(d.id, u)): ok = false end
        if uuid.Base64URL(u).len() != 22 or uuid.Base32(u).len() != 26: ok = false end
    end
    println "round trips", ok
end
