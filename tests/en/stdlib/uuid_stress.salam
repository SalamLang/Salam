import encoding.uuid
import mem
import pool

const THREADS := 8
const PER := 3000

mut slots := null as u64*
mut bad := null as i64*

func produce(t: int, kind: int):
    mut prev := uuid.Nil()
    repeat PER in i:
        mut u := uuid.Nil()
        if kind == 1:
            u = uuid.NewV1()
        else kind == 4:
            u = uuid.NewV4()
        else kind == 6:
            u = uuid.NewV6()
        else:
            u = uuid.NewV7()
        end
        at := (t * PER + i) * 2
        slots[at] = u.hi
        slots[at + 1] = u.lo
        if uuid.Version(u) != kind or uuid.Variant(u) != uuid.VARIANT_RFC:
            atomic_add(bad, 1 as i64)
        end
        if i > 0 and kind != 4:
            if kind == 1:
                if uuid.Timestamp(u) <= uuid.Timestamp(prev): atomic_add(bad, 1 as i64) end
            else:
                if uuid.Compare(prev, u) >= 0: atomic_add(bad, 1 as i64) end
            end
        end
        prev = u
    end
end

func run_kind(kind: int, label: str):
    repeat THREADS in t:
        go produce(t, kind)
    end
    pool.GoWait()
    mut seen := HashMap {} as HashMap<str, int>
    defer seen.free()
    repeat THREADS * PER in i:
        u := uuid.UUID { hi = slots[i * 2], lo = slots[i * 2 + 1] }
        seen.put(uuid.Compact(u), 1)
    end
    println label, "total", THREADS * PER, "unique", seen.size(), "violations", atomic_load(bad)
    atomic_store(bad, 0 as i64)
end

func main:
    slots = mem.Allocate((THREADS * PER * 16) as u64) as u64*
    bad = mem.AllocateZeroed(8 as u64) as i64*
    run_kind(4, "v4")
    run_kind(7, "v7")
    run_kind(1, "v1")
    run_kind(6, "v6")
    mem.Free(slots as void*)
    mem.Free(bad as void*)
end
