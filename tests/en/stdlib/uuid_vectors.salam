import encoding.uuid

func check(label: str, got: uuid.UUID, want: str):
    println label, uuid.String(got), uuid.String(got) == want
end

func main:
    dns := uuid.NamespaceDNS()
    url := uuid.NamespaceURL()
    oid := uuid.NamespaceOID()
    x500 := uuid.NamespaceX500()
    println dns
    println url
    println oid
    println x500

    check(
        "v3 dns www.example.com",
        uuid.NewV3(dns, "www.example.com"),
        "5df41881-3aed-3515-88a7-2f4a814cf09e"
    )
    check(
        "v5 dns www.example.com",
        uuid.NewV5(dns, "www.example.com"),
        "2ed6657d-e927-568b-95e1-2665a8aea6a2"
    )
    check(
        "v3 dns python.org", uuid.NewV3(dns, "python.org"), "6fa459ea-ee8a-3ca4-894e-db77e160355e"
    )
    check(
        "v5 dns python.org", uuid.NewV5(dns, "python.org"), "886313e1-3b8a-5372-9b90-0c9aee199e5d"
    )
    check("v3 url", uuid.NewV3(url, "http://python.org/"), "9fe8e8c4-aaa8-32a9-a55c-4535a88b748d")
    check("v5 url", uuid.NewV5(url, "http://python.org/"), "4c565f0d-3f5a-5890-b41b-20cf47701c5e")

    a := uuid.NewV5(dns, "salam")
    b := uuid.NewV5(dns, "salam")
    c := uuid.NewV5(url, "salam")
    d := uuid.NewV3(dns, "salam")
    println uuid.Equal(a, b), uuid.Equal(a, c), uuid.Equal(a, d)
    println uuid.Version(a), uuid.Version(d), uuid.Variant(a) == uuid.VARIANT_RFC
    empty := uuid.NewV5(dns, "")
    println empty
    println uuid.NewV5(oid, "1.3.6.1.4.1"), uuid.NewV3(x500, "cn=salam")

    v1 := uuid.FromV1Parts(0x1EC9414C232AB00, 0x33C8, 0x9F6BDECED846)
    check("v1", v1, "c232ab00-9414-11ec-b3c8-9f6bdeced846")
    v6 := uuid.FromV6Parts(0x1EC9414C232AB00, 0x33C8, 0x9F6BDECED846)
    check("v6", v6, "1ec9414c-232a-6b00-b3c8-9f6bdeced846")
    v7 := uuid.FromV7Parts(0x17F22E279B0, 0xCC3, 0x18C4DC0C0C07398F)
    check("v7", v7, "017f22e2-79b0-7cc3-98c4-dc0c0c07398f")
    v8 := uuid.FromV8Parts(0x2489E9AD2EE2, 0xE00, 0xEC932D5F69181C0)
    check("v8", v8, "2489e9ad-2ee2-8e00-8ec9-32d5f69181c0")
    println uuid.Version(v1), uuid.Version(v6), uuid.Version(v7), uuid.Version(v8)

    println uuid.Timestamp(v1), uuid.Timestamp(v6), uuid.Timestamp(v1) == uuid.Timestamp(v6)
    println uuid.UnixNanos(v1), uuid.UnixNanos(v6)
    println uuid.UnixMillis(v1), uuid.UnixMillis(v6), uuid.UnixMillis(v7)
    println uuid.ClockSequence(v1), uuid.ClockSequence(v6), uuid.Node(v1) == uuid.Node(v6)
    println uuid.HasTime(v1), uuid.HasTime(v6), uuid.HasTime(v7), uuid.HasTime(v8), uuid.HasTime(a)
    println uuid.UnixMillis(v8), uuid.UnixMillis(a), uuid.ClockSequence(v7), uuid.Node(v7)

    println uuid.FromV4Parts(0x919108F752D13320 as u64, 0x5BACF847DB4148A8 as u64)
    println uuid.NewV8(0x0123456789ABCDEF as u64, 0xFEDCBA9876543210 as u64)
    println uuid.Stamp(0 as u64, 0 as u64, 9)
end
