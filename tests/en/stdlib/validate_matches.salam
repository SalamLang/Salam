package main

import net.http.validate
import testing

func main:
    testing.AssertTrue(validate.Matches("ab-123", "^[a-z]+-[0-9]+$"))
    testing.AssertFalse(validate.Matches("ab_123", "^[a-z]+-[0-9]+$"))
    testing.AssertTrue(validate.Matches("2026-11-02", "^\\d{4}-\\d{2}-\\d{2}$"))
    testing.AssertFalse(validate.Matches("", "^.+$"))
    ret testing.Summary()
end
