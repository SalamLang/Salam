package main

import encoding.value

func main:
    mut items := Vector {} as Vector<value.Value>
    items.push(value.ValueInt(7 as i64))
    items.push(value.ValueString("x"))
    items.push(value.ValueBool(true))
    arr := value.ValueArray(items)
    println value.IsArray(arr), value.ArrayLen(arr), value.AsInt(value.ArrayGet(arr, 0)), value.AsString(value.ArrayGet(arr, 1)), value.AsBool(value.ArrayGet(arr, 2))
    mut fields := HashMap {} as HashMap<str, value.Value>
    fields.put("name", value.ValueString("salam"))
    fields.put("year", value.ValueInt(2024 as i64))
    obj := value.ValueObject(fields)
    println value.IsObject(obj), value.ObjectLen(obj), value.ObjectHas(obj, "name"), value.ObjectHas(obj, "none")
    println value.AsString(value.ObjectGet(obj, "name")), value.AsInt(value.ObjectGet(obj, "year"))
    keys := value.ObjectKeys(obj)
    println keys.len()
    empty := value.ValueArray(Vector {} as Vector<value.Value>)
    println value.ArrayLen(empty), value.ObjectLen(value.ValueObject(HashMap {} as HashMap<str, value.Value>))
end
