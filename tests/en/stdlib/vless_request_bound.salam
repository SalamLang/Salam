import mem
import net.tunnel
import net.transport
import net.vless

func request(domain_len: int): Vector<u8>:
    mut hdr := Vector {} as Vector<u8>
    hdr.push(0 as u8)
    repeat 16:
        hdr.push(7 as u8)
    end
    hdr.push(255 as u8)
    hdr.push(10 as u8)
    hdr.push(253 as u8)
    repeat 253:
        hdr.push(0 as u8)
    end
    hdr.push(1 as u8)
    hdr.push(1 as u8)
    hdr.push(187 as u8)
    hdr.push(2 as u8)
    hdr.push(domain_len as u8)
    repeat domain_len:
        hdr.push(65 as u8)
    end
    ret hdr
end

func feed(hdr: Vector<u8>): bool:
    p := tunnel.NewPipe()
    a := tunnel.PipeA(p)
    b := tunnel.PipeB(p)
    buf := mem.Allocate(hdr.Len() as u64) as u8*
    repeat hdr.Len() in i:
        buf[i] = hdr.get(i)
    end
    a.WriteBytes(buf as void*, hdr.Len())
    mem.Free(buf as void*)
    mut t := transport.FromStream(b, false)
    mut r := vless.Request {}
    ok := vless.ReadRequest(t, r)
    println "domain", r.addr.host.Len(), r.addr.port
    ret ok
end

func main():
    println "longest header with a 255 byte domain", feed(request(255))
    println "short domain", feed(request(11))
end
