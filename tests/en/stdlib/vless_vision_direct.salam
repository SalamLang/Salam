import net.transport
import net.vless

const UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"

func frame(v &: vless.Vision, text: str, cmd: int): transport.Bytes:
    mut p := transport.FromStr(text)
    f := vless.VisionPad(v, p.p, p.len, cmd, false)
    transport.FreeBytes(p)
    ret f
end

func main:
    id := transport.ParseUUID(UUID1)
    mut tx := vless.NewVision(id)
    mut rx := vless.NewVision(id)
    mut out := transport.NewBytes(64)
    f1 := frame(tx, "hello", vless.VisionContinue)
    f2 := frame(tx, "world", vless.VisionDirect)
    mut wire := transport.NewBytes(64)
    transport.PutBytes(wire, f1)
    transport.PutBytes(wire, f2)
    ok := vless.VisionUnpad(rx, wire.p, wire.len, out)
    println "unpadded:", ok, out.len, transport.ToHex(out)
    println "frame ends exactly at the end of the data:", rx.read_done, rx.command == vless.VisionDirect
    println "no switch before the reader runs:", rx.switched
    mut rx2 := vless.NewVision(id)
    mut out2 := transport.NewBytes(64)
    ok2 := vless.VisionUnpad(rx2, f1.p, f1.len, out2)
    println "a continue frame leaves the reader open:", ok2, rx2.read_done, out2.len
end
