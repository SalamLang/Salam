import mem
import str
import sync
import time
import net.transport
import net.vmess

const UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"
const UUID2 := "5783a3e7-e373-51cd-8642-c83782b807c5"

mut port := 0
mut ready := sync.NewWaitGroup()
mut srv_settings := transport.Settings {}
mut srv_count := 1
mut srv_log := ""
mut finished := sync.NewWaitGroup()

func check(label: str, got: transport.Bytes, want: str):
    println label, transport.ToHex(got) == want
end

func vectors():
    k := transport.FromHex("000102030405060708090a0b0c0d0e0f")
    pt := transport.FromHex("00112233445566778899aabbccddeeff")
    c := vmess.AES128Block(k, pt, false)
    check("aes-128 fips-197 encrypt", c, "69c4e0d86a7b0430d8cdb78070b4c55a")
    check("aes-128 fips-197 decrypt", vmess.AES128Block(k, c, true), "00112233445566778899aabbccddeeff")
    e := transport.NewBytes(1)
    check("shake128 empty, 32 bytes", vmess.Shake128(e, 32), "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26")
    abc := transport.FromStr("abc")
    long := transport.ToHex(vmess.Shake128(abc, 400))
    println "shake128 abc, start", long.substr(0, 64) == "5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8"
    println "shake128 abc, past one rate block", long.substr(700, 100) == "526b31002afbd1b4ebea69c8400c3deb4c1c35d6dbb75651b284076f5fde47b4a0586ee173e30bd4d08f2bc59c6114bdd745"
    println "crc32 check value", vmess.CRC32(transport.FromStr("123456789")) == 3421780262
    println "fnv1a check value", vmess.FNV1a(transport.FromStr("a")) == 3826002220
    uuid := transport.ParseUUID(UUID1)
    ck := vmess.CmdKey(uuid)
    check("cmd key", ck, "b50d916ac0cec067981af8e5f38a758f")
    none := transport.Bytes {}
    check("kdf one label", vmess.KDF(ck, "AES Auth ID Encryption", none, none), "1415ba74ca8b3d041a8f583fb4116315c589ae7b6e81765b601aa166c62871f7")
    a := transport.FromHex("0102030405060708090a0b0c0d0e0f10")
    b := transport.FromHex("1112131415161718")
    check("kdf three parts", vmess.KDF(ck, "VMess Header AEAD Key_Length", a, b), "870bcc37181146a588556ec38da75b67617a2654f1e844e903d1ac1e74ab1955")
    check("kdf label over one block", vmess.KDF(ck, "this label is deliberately longer than sixty four bytes so that the key hashing path runs", a, b), "307d54f82284a0f3a864e57f9f47122f68fb3317d510c51ad5560ea215c2332d")
    r4 := transport.FromHex("a1b2c3d4")
    aid := vmess.CreateAuthID(ck, 1700000000, r4)
    check("auth id", aid, "afabbebf298c2611f08228d760111288")
    mut ts := 0 as i64
    println "auth id opens", vmess.OpenAuthID(ck, aid, ts), ts == 1700000000
    other := vmess.CmdKey(transport.ParseUUID(UUID2))
    println "auth id rejects another user", not vmess.OpenAuthID(other, aid, ts)
    mut bent := transport.FromHex(transport.ToHex(aid))
    transport.Set8(bent, 3, transport.At(bent, 3) ^ 1)
    println "auth id rejects a flipped bit", not vmess.OpenAuthID(ck, bent, ts)
    data := transport.FromStr("hello vmess header payload")
    sealed := vmess.SealHeader(ck, data, 1700000000, r4, b)
    check("sealed header", sealed, "afabbebf298c2611f08228d7601112882879fbb74df2607ca6f7ced17d02b025c9af1112131415161718d6567a4475d5a6abbab6b2e77e020f182bd034fe14487022fd8ab25a67ce927cd6e84b757d00f152eef5")
    mut enc_len := transport.NewBytes(18)
    transport.PutRaw(enc_len, transport.BytesPtr(sealed, 16), 18)
    mut enc_hdr := transport.NewBytes(64)
    transport.PutRaw(enc_hdr, transport.BytesPtr(sealed, 42), sealed.len - 42)
    println "header length opens", vmess.OpenHeaderLength(ck, aid, enc_len, b)
    opened := vmess.OpenHeader(ck, aid, enc_hdr, b)
    println "header opens", opened.bad, transport.ToHex(opened) == transport.ToHex(data)
    transport.Set8(enc_hdr, 5, transport.At(enc_hdr, 5) ^ 0x80)
    println "tampered header rejected", vmess.OpenHeader(ck, aid, enc_hdr, b).bad
    transport.Set8(enc_len, 0, transport.At(enc_len, 0) ^ 1)
    println "tampered length rejected", vmess.OpenHeaderLength(ck, aid, enc_len, b)
end

func request_vectors():
    key := transport.FromHex("101112131415161718191a1b1c1d1e1f")
    iv := transport.FromHex("a0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    mut r := vmess.Request {}
    r.iv = iv
    r.key = key
    r.resp_v = 0x7b
    r.option = 5
    r.security = vmess.SecAES128GCM
    r.command = vmess.CmdTCP
    r.addr = transport.NewAddr("example.com", 443)
    plain := vmess.EncodeRequest(r)
    check("request header bytes", plain, "01a0a1a2a3a4a5a6a7a8a9aaabacadaeaf101112131415161718191a1b1c1d1e1f7b0503000101bb020b6578616d706c652e636f6dec702322")
    mut back := vmess.Request {}
    println "request decodes", vmess.DecodeRequest(plain, back), back.addr.host, back.addr.port, back.command, back.security, back.option
    mut bad := transport.FromHex(transport.ToHex(plain))
    transport.Set8(bad, 40, transport.At(bad, 40) ^ 1)
    mut again := vmess.Request {}
    println "request checksum catches a flip", not vmess.DecodeRequest(bad, again)
    r.addr = transport.NewAddr("2001:db8::7", 53)
    r.command = vmess.CmdUDP
    mut v6 := vmess.Request {}
    println "ipv6 udp request roundtrip", vmess.DecodeRequest(vmess.EncodeRequest(r), v6), v6.addr.host, v6.addr.kind, v6.command
    r.padding = 9
    mut padded := vmess.Request {}
    println "padded request roundtrip", vmess.DecodeRequest(vmess.EncodeRequest(r), padded), padded.padding
end

func chunk_vectors():
    key := transport.FromHex("101112131415161718191a1b1c1d1e1f")
    iv := transport.FromHex("a0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    mut parts := Vector {} as Vector<transport.Bytes>
    parts.push(transport.FromStr("hello vmess body"))
    parts.push(transport.FromStr("second chunk of data"))
    check("aes-gcm chunks, masked lengths", vmess.EncodeChunks(vmess.SecAES128GCM, 5, key, iv, parts, true), "4edd9483a48e14b9324f9956d75dd9bcfba59ec2760ad4edb6119ab00f419d71a6a039ff2b5015a054be7a4ad392b1352683ee7874717b2563149574c763381edec1cf2d947a0f7734bf992677b4723edcc5838b0e65e593550b")
    check("chacha20-poly1305 chunks", vmess.EncodeChunks(vmess.SecChaCha20Poly1305, 5, key, iv, parts, true), "4eddf25651e2e7bd5b735604cef2691376286a7e0bf0267aa682224fe5ad005062ef39ff591e1cd235bb543d5c5a70ad10fcf1ab6195fdd636a34b792a35fa44151d1262527aaca534bff3db191df96fa8d8f2d4b1865da92258")
    check("none chunks", vmess.EncodeChunks(vmess.SecNone, 5, key, iv, parts, true), "4eed68656c6c6f20766d65737320626f647939cf7365636f6e64206368756e6b206f66206461746134af")
    check("aes-gcm chunks, authenticated lengths", vmess.EncodeChunks(vmess.SecAES128GCM, 21, key, iv, parts, true), "41738983cfe7033fe27d7c77f3df8866aaa29483a48e14b9324f9956d75dd9bcfba59ec2760ad4edb6119ab00f419d71a6a0d67b5972e62ec3b41a9999895d3b11b062a82b5015a054be7a4ad392b1352683ee7874717b2563149574c763381edec1cf2d947a0f7773d271614077d313fc9d122c61cbf9c43f9d992677b4723edcc5838b0e65e593550b")
    check("aes-gcm chunks, plain lengths", vmess.EncodeChunks(vmess.SecAES128GCM, 1, key, iv, parts, true), "00209483a48e14b9324f9956d75dd9bcfba59ec2760ad4edb6119ab00f419d71a6a000242b5015a054be7a4ad392b1352683ee7874717b2563149574c763381edec1cf2d947a0f770010992677b4723edcc5838b0e65e593550b")
    parts.free()
end

func server():
    l := transport.Listen(0, srv_settings)
    port = transport.ListenerPort(l)
    sync.Done(ready)
    mut rf := vmess.NewReplayFilter()
    mut users := Vector {} as Vector<vmess.User>
    users.push(vmess.NewUser(UUID1))
    users.push(vmess.NewUser(UUID2))
    buf := mem.Allocate(65536 as u64)
    repeat srv_count:
        t := transport.Accept(l)
        if not transport.Ok(t):
            srv_log += "transport(" + t.err + ");"
            continue
        end
        mut c := vmess.Accept(t, users, rf)
        if c.ok:
            srv_log += "ok(" + c.user.substr(0, 8) + " " + c.req.addr.host + ":" + str.FromInt(c.req.addr.port as i64) + ");"
            until true:
                n := vmess.Read(c, buf, 65536)
                if n <= 0:
                    break
                end
                vmess.Write(c, buf, n)
            end
            vmess.Close(c)
        else:
            srv_log += "fail(" + c.err + ");"
        end
    end
    mem.Free(buf)
    transport.CloseListener(l)
    sync.Done(finished)
end

func start(ss: transport.Settings, count: int):
    srv_settings = ss
    srv_count = count
    srv_log = ""
    sync.Add(ready, 1 as i64)
    sync.Add(finished, 1 as i64)
    _t := spawn(server)
    sync.Wait(ready)
end

func pattern(n: int, seed: int): transport.Bytes:
    mut b := transport.NewBytes(n + 1)
    repeat n in i:
        transport.Put8(b, (i * 11 + seed) & 255)
    end
    ret b
end

func echo(label: str, cs: transport.Settings, uuid: str, sec: int, opt: int, host: str):
    t := transport.Dial("127.0.0.1", port, cs)
    if not transport.Ok(t):
        println label, "transport failed", t.err
        ret
    end
    mut c := vmess.Client(t, uuid, sec, opt, vmess.CmdTCP, transport.NewAddr(host, 8443))
    mut good := c.ok
    mut sent := 0
    mut sizes := Vector {} as Vector<int>
    sizes.push(5)
    sizes.push(1000)
    sizes.push(40000)
    repeat sizes.len() in i:
        n := sizes.get(i)
        mut out := pattern(n, i)
        back := mem.AllocateZeroed((n + 1) as u64)
        mut got := 0
        if not vmess.Write(c, out.p, n):
            good = false
        end
        until got < n:
            r := vmess.Read(c, ((back as i64) + (got as i64)) as void*, n - got)
            if r <= 0:
                good = false
                break
            end
            got += r
        end
        if got == n:
            bp := back as u8*
            repeat n in k:
                if (bp[k] as int) != ((k * 11 + i) & 255):
                    good = false
                    break
                end
            end
        end
        sent += n
        mem.Free(back)
        transport.FreeBytes(out)
    end
    sizes.free()
    vmess.Close(c)
    println label, "echo ok:", good, "bytes:", sent
end

func raw_header(cs: transport.Settings, uuid: str, ts: i64):
    mut t := transport.Dial("127.0.0.1", port, cs)
    mut r := vmess.Request {}
    r.iv = transport.FromHex("a0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    r.key = transport.FromHex("101112131415161718191a1b1c1d1e1f")
    r.resp_v = 9
    r.option = 5
    r.addr = transport.NewAddr("example.com", 443)
    plain := vmess.EncodeRequest(r)
    ck := vmess.CmdKey(transport.ParseUUID(uuid))
    sealed := vmess.SealHeader(ck, plain, ts, transport.FromHex("01020304"), transport.FromHex("0a0b0c0d0e0f1011"))
    transport.WriteBytes(t, sealed)
    sync.SleepMs(100)
    transport.Close(t)
end

func main:
    vectors()
    request_vectors()
    chunk_vectors()

    plain := transport.Settings {}
    start(plain, 7)
    echo("aes-128-gcm", plain, UUID1, vmess.SecAES128GCM, vmess.DefaultOption(vmess.SecAES128GCM), "example.com")
    echo("chacha20-poly1305", plain, UUID2, vmess.SecChaCha20Poly1305, vmess.DefaultOption(vmess.SecChaCha20Poly1305), "10.1.2.3")
    echo("none", plain, UUID1, vmess.SecNone, vmess.DefaultOption(vmess.SecNone), "2001:db8::1")
    echo("zero", plain, UUID1, vmess.SecZero, 0, "example.org")
    echo("aes-128-gcm padded", plain, UUID1, vmess.SecAES128GCM, 1 | 4 | 8, "padded.test")
    echo("aes-128-gcm authenticated length", plain, UUID2, vmess.SecAES128GCM, 1 | 4 | 16, "authlen.test")
    echo("chacha20 authenticated length and padding", plain, UUID1, vmess.SecChaCha20Poly1305, 1 | 4 | 8 | 16, "both.test")
    sync.Wait(finished)
    println "server saw", srv_log

    start(plain, 5)
    now := time.Now()
    echo("wrong user", plain, "00000000-0000-4000-8000-000000000001", vmess.SecAES128GCM, 5, "example.com")
    raw_header(plain, UUID1, now)
    raw_header(plain, UUID1, now)
    raw_header(plain, UUID1, now - (300 as i64))
    raw_header(plain, UUID2, now + (500 as i64))
    sync.Wait(finished)
    println "server saw", srv_log

    mut ws := transport.Settings {}
    ws.network = "ws"
    ws.path = "/vmess"
    start(ws, 1)
    echo("over websocket", ws, UUID1, vmess.SecAES128GCM, 5, "example.com")
    sync.Wait(finished)
    println "server saw", srv_log
end
