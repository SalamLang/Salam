import encoding
import net.vmess
import net.tunnel

func main:
    js := "{\"v\":\"2\",\"ps\":\"my node\",\"add\":\"example.com\",\"port\":\"443\",\"id\":\"b831381d-6324-4d53-ad4f-8cda48b30811\",\"aid\":\"0\",\"scy\":\"chacha20-poly1305\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"cdn.example.com\",\"path\":\"/ray?ed=2048\",\"tls\":\"tls\",\"sni\":\"front.example.com\",\"alpn\":\"h2,http/1.1\",\"fp\":\"chrome\"}"
    link := "vmess://" + encoding.Base64Encode(js)
    l := vmess.ParseLink(link)
    println "ok:", l.ok, l.err
    println l.remark, l.host, l.port, l.uuid, l.security, l.network, l.host_header, l.path, l.tls, l.sni, l.alpn, l.fingerprint
    s := vmess.LinkSettings(l)
    println "settings:", s.network, s.path, s.early_data, s.tls, s.sni, s.host
    println "security:", vmess.SecurityByName(l.security), vmess.SecurityByName("auto"), vmess.SecurityByName("zero"), vmess.SecurityByName("rc4"), vmess.SecurityName(vmess.SecNone)
    out := vmess.FormatLink(l)
    again := vmess.ParseLink(out)
    println "round trip:", again.ok, again.host == l.host, again.uuid == l.uuid, again.path == l.path, again.sni == l.sni, again.remark == l.remark
    n := tunnel.ParseLink(out)
    println "tunnel agrees:", n.valid, n.host == l.host, n.port == l.port, n.uuid == l.uuid, n.network == l.network
    g := vmess.ParseLink("vmess://" + encoding.Base64Encode("{\"add\":\"h.example.com\",\"port\":8443,\"id\":\"b831381d-6324-4d53-ad4f-8cda48b30811\",\"net\":\"grpc\",\"path\":\"svc\",\"tls\":\"tls\"}"))
    gs := vmess.LinkSettings(g)
    println "grpc:", g.ok, g.port, gs.network, gs.service_name
    bad := vmess.ParseLink("vmess://" + encoding.Base64Encode("{\"add\":\"\",\"port\":0,\"id\":\"x\"}"))
    println "bad:", bad.ok, bad.err
    junk := vmess.ParseLink("vmess://!!!")
    println "junk:", junk.ok, junk.err
    other := vmess.ParseLink("vless://x")
    println "other:", other.ok, other.err
    mut dflt := vmess.Link {}
    dflt.host = "a.example.com"
    dflt.uuid = "b831381d-6324-4d53-ad4f-8cda48b30811"
    d := vmess.ParseLink(vmess.FormatLink(dflt))
    println "defaults:", d.ok, d.port, d.security, d.network
end
