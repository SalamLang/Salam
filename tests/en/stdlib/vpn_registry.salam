package main

import net.tcp
import net.transport
import net.tunnel
import net.vpn

mut failures := 0

struct EchoProto:
    pub unused: int = 0

    pub func Name(): str:
        ret "hello"
    end

    pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
        line := tunnel.ReadUntil(s, "\n", 100)
        if line != "HELLO\n": ret tunnel.Session { error = "bad hello" } end
        ret tunnel.Session { ok = true, target = tunnel.NewAddr("127.0.0.1", 9), protocol = "hello" }
    end

    pub func Reply(s: dyn tunnel.Stream, _sess: tunnel.Session, ok: bool):
        if ok: s.Write("WELCOME\n") else:
            s.Write("NO\n") end
    end
end

struct HoldHandler:
    pub unused: int = 0

    pub func Handle(s: dyn tunnel.Stream, _sess: tunnel.Session):
        s.Write("WELCOME\n")
        s.Close()
    end
end

func expect(label: str, ok: bool):
    if not ok:
        println "FAIL", label
        failures++
    end
end

func registry():
    vpn.Register()
    each p in ["vless", "vmess", "trojan", "shadowsocks", "ss", "socks", "http", "freedom", "block"]:
        expect("outbound " + p, tunnel.HasOutbound(p))
    end
    each p in ["mixed", "socks", "http", "trojan", "vless", "vmess", "shadowsocks"]:
        expect("inbound " + p, tunnel.HasInbound(p))
    end
    println "outbound names:", tunnel.CreateOutbound(tunnel.OutboundConfig { protocol = "freedom" }).Name(), tunnel.CreateOutbound(tunnel.OutboundConfig { protocol = "nonsense" }).Name()
    node := tunnel.Node { protocol = "trojan", host = "example.org", port = 443, password = "pw", network = "tcp", tls = true, valid = true }
    println "dialer:", vpn.DialerFromNode(node).Name(), vpn.DialerFromNode(tunnel.Node { protocol = "nope" }).Name()
    println "vless dialer:", vpn.DialerFromNode(tunnel.Node { protocol = "vless" }).Name(), vpn.DialerFromNode(tunnel.Node { protocol = "ss" }).Name()
end

func settings():
    s := vpn.StreamSettings(`{"network":"ws","security":"tls","tlsSettings":{"serverName":"a.test","allowInsecure":true},"wsSettings":{"path":"/x","headers":{"Host":"h.test"}}}`)
    println "ws:", s.network, s.tls, s.sni, s.allow_insecure, s.path, s.host
    h := vpn.StreamSettings(`{"network":"httpupgrade","httpupgradeSettings":{"path":"/up"}}`)
    println "httpupgrade:", h.network, h.tls, h.path
    f := vpn.StreamSettings(`{"security":"tls","fragment":{"packets":"tlshello"}}`)
    println "fragment:", f.fragment, f.fragment_min > 0
    n := vpn.NodeSettings(tunnel.Node { network = "ws", tls = true, sni = "n.test", path = "/n" })
    println "node:", n.network, n.sni, n.path, n.fragment
    vpn.RegisterWith(vpn.Options { fragment = true })
    nf := vpn.NodeSettings(tunnel.Node { network = "tcp", tls = true, sni = "n.test" })
    println "node fragment:", nf.fragment
    vpn.Register()
end

func addrs():
    t := vpn.ToTunnelAddr(transport.NewAddr("example.org", 443))
    println "to tunnel:", t.String(), t.kind
    b := vpn.ToTransportAddr(tunnel.NewAddr("::1", 53))
    println "to transport:", b.host, b.port
end

func acceptor():
    srv := tunnel.ListenLocal(0)
    println "listening:", srv.Ok(), srv.Port() > 0
    tunnel.StartAccepting(srv, EchoProto {}, HoldHandler {})
    c := tunnel.DialTcp("127.0.0.1", srv.Port(), 3000)
    tunnel.WriteAll(c, "HELLO\n")
    println "reply:", tunnel.ReadUntil(c, "\n", 100)
    c.Close()
    bad := tunnel.DialTcp("127.0.0.1", srv.Port(), 3000)
    tunnel.WriteAll(bad, "BYE\n")
    println "rejected:", bad.Read(10).Len() == 0
    bad.Close()
    srv.Stop()
    again := tcp.Dial("127.0.0.1", srv.Port())
    println "after stop:", tcp.ConnOk(again)
    all := tunnel.ListenTcpOn("0.0.0.0", 0)
    println "explicit all-interfaces bind:", all.Ok()
    all.Stop()
end

func runner():
    cfg := tunnel.ParseConfig(`{"inbounds":[{"tag":"in","port":0,"protocol":"mixed"}],"outbounds":[{"tag":"direct","protocol":"freedom"}]}`)
    stats := tunnel.NewStats()
    ls := vpn.StartAll(cfg, stats)
    println "runner inbounds:", ls.Len(), vpn.Ok(ls[0]), ls[0].port > 0, ls[0].tag
    println "summary:", vpn.Summary(stats)
    vpn.Stop(ls[0])
    bad := tunnel.ParseConfig(`{"inbounds":[{"tag":"x","port":0,"protocol":"vless","settings":{"clients":[]},"streamSettings":{"security":"tls","tlsSettings":{"certificates":[{"certificateFile":"nope.pem","keyFile":"nope.key"}]}}}],"outbounds":[]}`)
    lb := vpn.StartAll(bad, stats)
    println "bad certificate listens:", vpn.Ok(lb[0])
end

func main:
    registry()
    settings()
    addrs()
    acceptor()
    runner()
    println "failures:", failures
end
