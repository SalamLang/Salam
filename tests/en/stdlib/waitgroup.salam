package main


import sync

const WORKERS := 4
const PER_WORKER := 2500

mut total := 0
mut lock := sync.Mutex {}
mut wg := sync.WaitGroup {}

func worker():
    repeat PER_WORKER:
        sync.Lock(lock)
        total = total + 1
        sync.Unlock(lock)
    end
    sync.Done(wg)
end

func main:
    lock = sync.NewMutex()
    wg = sync.NewWaitGroup()

    sync.Wait(wg)
    println "empty wait returns"

    sync.Add(wg, WORKERS as i64)
    t1 := spawn(worker)
    t2 := spawn(worker)
    t3 := spawn(worker)
    t4 := spawn(worker)

    sync.Wait(wg)
    println "after wait    :", total, "of", WORKERS * PER_WORKER
    println "all done      :", total == WORKERS * PER_WORKER

    join(t1)
    join(t2)
    join(t3)
    join(t4)
    println "joined"

    total = 0
    sync.Add(wg, 2 as i64)
    a := spawn(worker)
    b := spawn(worker)
    sync.Wait(wg)
    join(a)
    join(b)
    println "second batch  :", total, "of", 2 * PER_WORKER

    sync.DestroyWaitGroup(wg)
    sync.Destroy(lock)
    println "destroyed"
    ret 0
end
