package main

import webpush

func check(label: str, ok: bool):
    print label
    print ": "
    if ok:
        println "ok"
    else:
        println "FAIL"
    end
end

func rebuilt_keys():
    keys := webpush.GenerateKeys()
    again := webpush.KeysFrom(keys.public_key, keys.private_key)
    check("generated keys", keys.ok)
    check("keys rebuilt from strings", again.ok)
    check("public key kept", again.public_key == keys.public_key)
    check("private key kept", again.private_key == keys.private_key)
    check("empty public key rejected", not webpush.KeysFrom("", keys.private_key).ok)
    check("empty private key rejected", not webpush.KeysFrom(keys.public_key, "").ok)
    check("rejected keys sign nothing", webpush.VapidHeader(webpush.KeysFrom("", ""), "https://push.example.net", "mailto:ops@example.com") == "")
end

func vapid_now():
    keys := webpush.KeysFrom("BNp3Ldtz9dZ2TVhsqzzVV0Gv8bP1YZ6u9G0cNVmE0n1AgM2d5B5pE6mB7l2cJ0p1m1v3b3cqf6HvQZ4q1y0QxXQ", "")
    check("a missing private key has no header", webpush.VapidHeader(keys, "https://push.example.net", "mailto:ops@example.com") == "")
    real := webpush.GenerateKeys()
    mine := webpush.KeysFrom(real.public_key, real.private_key)
    header := webpush.VapidHeader(mine, "https://push.example.net", "mailto:ops@example.com")
    check("header starts with vapid", header.find("vapid t=") == 0)
    check("header carries the public key", header.find(", k=" + real.public_key) > 0)
    check("header has a three part token", header.find(".") > 0)
    check("no audience gives no header", webpush.VapidHeader(mine, "", "mailto:ops@example.com") == "")
    check("no subject gives no header", webpush.VapidHeader(mine, "https://push.example.net", "") == "")
end

func main:
    rebuilt_keys()
    vapid_now()
end
