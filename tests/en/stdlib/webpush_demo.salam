import webpush

func check(label: str, got: str, want: str):
    print label
    print ": "
    if got == want:
        println "ok"
    else:
        println "MISMATCH"
        print "  got  "
        println got
        print "  want "
        println want
    end
end

func rfc8291_subscription(): webpush.Subscription:
    ret webpush.Subscription {
        endpoint = "https://push.example.net/x",
        p256dh = "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4",
        auth = "BTBZMqHH6r4Tts7J_aSIgg"
    }
end

func encryption_vector():
    mut ok := false
    body := webpush.EncryptWith(rfc8291_subscription(),
        "When I grow up, I want to be a watermelon",
        "yfWPiYE-n46HLnH0KqZOF1fJJU3MYrct3AELtAQ-oRw",
        "DGv6ra1nlYgDCS1FRnbzlw", ok)
    print "encrypted: "
    println ok
    check("rfc 8291 body", body,
        "DGv6ra1nlYgDCS1FRnbzlwAAEABBBP4z9KsN6nGRTbVYI_c7VJSPQTBtkgcy27ml" +
        "mlMoZIIgDll6e3vCYLocInmYWAmS6TlzAC8wEqKK6PBru3jl7A_yl95bQpu6cVPT" +
        "pK4Mqgkf1CXztLVBSt2Ks3oZwbuwXPXLWyouBWLVWGNWQexSgSxsj_Qulcy4a-fN")
end

func freshness():
    sub := rfc8291_subscription()
    mut ok := false
    first := webpush.Encrypt(sub, "hello", ok)
    second := webpush.Encrypt(sub, "hello", ok)
    print "same payload seals differently: "
    println first != second && first.len() == second.len()
end

func vapid():
    keys := webpush.GenerateKeys()
    print "generated keys: "
    println keys.ok
    header := webpush.VapidHeaderAt(keys, "https://push.example.net",
        "mailto:ops@example.com", 1700000000 as i64)
    print "header shape: "
    println header.find("vapid t=") == 0 && header.find(", k=" + keys.public_key) > 0
    other := webpush.VapidHeaderAt(keys, "https://push.example.com",
        "mailto:ops@example.com", 1700000000 as i64)
    print "audience changes the token: "
    println header != other
end

func deterministic():
    keys := webpush.GenerateKeys()
    a := webpush.VapidHeaderAt(keys, "https://push.example.net", "mailto:a@b.c", 1700000000 as i64)
    b := webpush.VapidHeaderAt(keys, "https://push.example.net", "mailto:a@b.c", 1700000000 as i64)
    print "signatures are deterministic: "
    println a == b
end

func refusals():
    keys := webpush.GenerateKeys()
    mut ok := true
    _empty := webpush.EncryptWith(webpush.Subscription {}, "hi", "", "", ok)
    print "no subscription keys refused: "
    println !ok
    nowhere := webpush.Send(keys, webpush.Subscription {}, "hi",
        webpush.NewOptions("mailto:a@b.c"))
    print "no endpoint refused: "
    println !nowhere.ok && nowhere.error.len() > 0
    print "no subject refused: "
    println webpush.VapidHeaderAt(keys, "https://push.example.net", "", 1700000000 as i64).len() == 0
end

func main:
    encryption_vector()
    freshness()
    vapid()
    deterministic()
    refusals()
end
