import net.websocket
import sync

mut lock := sync.NewMutex()
mut failed := 0

func worker():
    repeat 200:
        mut c := websocket.DialWSSUnverified("127.0.0.1", 0, "/", "")
        mut d := websocket.DialWSSUnverified("127.0.0.1", 0, "/", "")
        if websocket.IsOpen(c) or websocket.IsOpen(d):
            sync.Lock(lock)
            failed += 1
            sync.Unlock(lock)
        end
        websocket.Close(c)
        websocket.Close(d)
    end
end

func main:
    mut workers := Vector {} as Vector<i64>
    repeat 8:
        workers.push(spawn(worker))
    end
    repeat workers.len() in i:
        join(workers.get(i))
    end
    println "open by mistake:", failed
end
