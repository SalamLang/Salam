import archive
import gui.webview.pack
import mem
import os

const SCRATCH := "pack_signed_scratch"
const KEY := "ir.example.notes"

func fake_program(): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    repeat 328:
        v.Push(0 as u8)
    end
    v.Set(0, 77 as u8)
    v.Set(1, 90 as u8)
    v.Set(60, 64 as u8)
    v.Set(64, 80 as u8)
    v.Set(65, 69 as u8)
    v.Set(88, 11 as u8)
    v.Set(89, 2 as u8)
    ret v
end

func put_u32(v &: Vector<u8>, at: int, value: int):
    repeat 4 in i:
        v.Set(at + i, ((value >> (i * 8)) & 255) as u8)
    end
end

func add_file(v &: Vector<u8>, path: str):
    size := os.FileSize(path)
    data := pack.ReadRange(path, 0 as i64, size)
    bytes := data as u8*
    repeat size as int in i:
        v.Push(bytes[i])
    end
    mem.Free(data)
end

func show(label: str, path: str):
    mut p := pack.Pack {}
    if not pack.Open(path, KEY, p):
        println label, ": no assets"
        ret
    end
    blob := p.Read("index.html")
    println label, ": ", p.Count(), " ", blob.data as str
end

func main:
    _a := os.MkdirAll(SCRATCH + "/www")
    _b := os.WriteFile(SCRATCH + "/www/index.html", "<p>hi</p>")
    _n := pack.PackDir(SCRATCH + "/www", SCRATCH + "/app.pack", KEY)
    program := SCRATCH + "/app.exe"
    repeat 8 in extra:
        mut v := fake_program()
        repeat extra:
            v.Push(0 as u8)
        end
        add_file(v, SCRATCH + "/app.pack")
        _w := archive.WriteBinaryFile(program, v.data as void*, v.Len())
        show("unsigned", program)
        until v.Len() % 8 != 0:
            v.Push(0 as u8)
        end
        start := v.Len()
        repeat 24:
            v.Push(65 as u8)
        end
        put_u32(v, 232, start)
        put_u32(v, 236, 24)
        _s := archive.WriteBinaryFile(program, v.data as void*, v.Len())
        show("signed", program)
    end
    base := fake_program()
    _p := archive.WriteBinaryFile(program, base.data as void*, base.Len())
    println "append: ", pack.AppendPack(program, SCRATCH + "/app.pack")
    show("appended", program)
    _r := os.RemoveAll(SCRATCH)
end
