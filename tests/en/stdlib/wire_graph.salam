import wire
import str

struct Cfg:
    pub dsn: str = ""
    pub n: int = 0
end

func level_name(i: int): str:
    ret "L" + str.FromInt(i)
end

func main:
    c := wire.New()
    wire.Value(c, "Cfg", Cfg { dsn = "db://x", n = 5 })
    mut cfg := Cfg {}
    println wire.Get(c, "Cfg", cfg), cfg.dsn, cfg.n
    println wire.Get(c, "Nope", cfg), wire.Error(c)
    println wire.Count(c)
    wire.Close(c)

    deep := wire.New()
    wire.Value(deep, "L0", 1)
    repeat 1 to 200 in i:
        prev := level_name(i - 1)
        wire.Provide(deep, level_name(i), prev, 0, (cx: wire.Container):
            mut v := 0
            _ok := wire.Get(cx, prev, v)
            ret v + 1
        end)
    end
    println wire.Build(deep) == "" ? "sound" : "broken"
    mut top := 0
    println wire.Get(deep, "L200", top), top
    built := wire.Built(deep)
    println built.len(), built.get(0), built.get(200)
    built.free()
    wire.Close(deep)

    loop := wire.New()
    wire.Provide(loop, "X", "", 0, (cx: wire.Container):
        mut v := 0
        _ok := wire.Get(cx, "X", v)
        ret v
    end)
    mut x := 0
    println wire.Get(loop, "X", x), wire.Error(loop)
    wire.Close(loop)

    self := wire.New()
    wire.Provide(self, "S", "S", 0, (_c: wire.Container): ret 1 end)
    println wire.Build(self)
    wire.Close(self)
end
