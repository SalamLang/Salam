package main


import mem
import sync

const JOBS := 100
const WORKERS := 4
const UNSET := 0 - 1

mut cursor := 0
mut lock := sync.Mutex {}
mut wg := sync.WaitGroup {}
mut results := null as i64*
mut taken := 0

func next_job(): int:
    sync.Lock(lock)
    mut mine := 0 - 1
    if cursor < JOBS:
        mine = cursor
        cursor = cursor + 1
        taken = taken + 1
    end
    sync.Unlock(lock)
    ret mine
end

func worker():
    until true:
        job := next_job()
        if job < 0: break end
        results[job] = (job * job) as i64
    end
    sync.Done(wg)
end

func main:
    lock = sync.NewMutex()
    wg = sync.NewWaitGroup()
    results = mem.Allocate((JOBS * 8) as u64) as i64*
    repeat JOBS with i:
        results[i] = UNSET as i64
    end

    sync.Add(wg, WORKERS as i64)
    t1 := spawn(worker)
    t2 := spawn(worker)
    t3 := spawn(worker)
    t4 := spawn(worker)
    sync.Wait(wg)
    join(t1)
    join(t2)
    join(t3)
    join(t4)

    println "jobs taken    :", taken, "of", JOBS
    println "cursor        :", cursor

    mut unwritten := 0
    mut wrong := 0
    mut sum := 0 as i64
    repeat JOBS with i:
        v := results[i]
        if v == UNSET as i64:
            unwritten = unwritten + 1
        else v != (i * i) as i64:
            wrong = wrong + 1
        end
        sum = sum + v
    end
    println "unwritten     :", unwritten
    println "wrong values  :", wrong
    println "sum of squares:", sum

    println "after drain   :", next_job()

    mem.Free(results as void*)
    sync.DestroyWaitGroup(wg)
    sync.Destroy(lock)
    ret 0
end
