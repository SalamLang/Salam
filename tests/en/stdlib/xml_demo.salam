package main

import encoding.xml
import encoding.value
import testing
import os

func main:
    mut ok := false
    doc := `<root id="1"><name>salam</name><tag>a</tag><tag>b</tag><empty/></root>`
    root := xml.DecodeStrict(doc, ok)
    testing.AssertTrue(ok)
    testing.AssertEqStr(root.tag, "root")
    testing.AssertEqStr(xml.Attr(root, "id"), "1")
    name := xml.Child(root, "name")
    testing.AssertTrue(xml.Found(name))
    testing.AssertEqStr(name.text, "salam")
    tags := xml.Children(root, "tag")
    testing.AssertEqInt(tags.items.len(), 2)
    testing.AssertEqStr(tags.items.get(0).text, "a")
    testing.AssertEqStr(tags.items.get(1).text, "b")
    empty := xml.Child(root, "empty")
    testing.AssertTrue(xml.Found(empty))
    testing.AssertEqInt(empty.children.len(), 0)

    notfound := xml.Child(root, "missing")
    testing.AssertFalse(xml.Found(notfound))

    // entity escape/unescape round trip
    esc := xml.EscapeText(`a & b < c > d`)
    testing.AssertEqStr(esc, "a &amp; b &lt; c &gt; d")
    testing.AssertEqStr(xml.UnescapeEntities(esc), `a & b < c > d`)

    // comment / CDATA handling
    doc2 := `<r><!-- a comment --><d><![CDATA[raw <text> here]]></d></r>`
    root2 := xml.Decode(doc2)
    d := xml.Child(root2, "d")
    testing.AssertTrue(xml.Found(d))
    testing.AssertEqStr(d.text, "raw <text> here")

    // direct NextToken walk - exact token sequence, independent of the tree builder
    mut tz := xml.NewXMLTokenizer(`<a x="1">hi<b/></a>`)
    t1 := xml.NextToken(tz)
    testing.AssertEqInt(t1.kind, xml.XMLTokStartElement)
    testing.AssertEqStr(t1.tag, "a")
    testing.AssertEqStr(t1.attrs.get("x"), "1")
    t2 := xml.NextToken(tz)
    testing.AssertEqInt(t2.kind, xml.XMLTokText)
    testing.AssertEqStr(t2.text, "hi")
    t3 := xml.NextToken(tz)
    testing.AssertEqInt(t3.kind, xml.XMLTokStartElement)
    testing.AssertEqStr(t3.tag, "b")
    t4 := xml.NextToken(tz)
    testing.AssertEqInt(t4.kind, xml.XMLTokEndElement)
    testing.AssertEqStr(t4.tag, "b")
    t5 := xml.NextToken(tz)
    testing.AssertEqInt(t5.kind, xml.XMLTokEndElement)
    testing.AssertEqStr(t5.tag, "a")
    t6 := xml.NextToken(tz)
    testing.AssertEqInt(t6.kind, xml.XMLTokEOF)

    // ToValue/FromValue bridge round trip
    v := xml.ToValue(root)
    testing.AssertEqStr(value.AsString(value.ObjectGet(v, "@id")), "1")
    back := xml.FromValue(v, "root")
    v2 := xml.ToValue(back)
    testing.AssertTrue(value.Equal(v, v2))

    // Encode round trip (self-closing empty element, nested children)
    encoded := xml.Encode(root)
    root3 := xml.Decode(encoded)
    testing.AssertTrue(value.Equal(xml.ToValue(root), xml.ToValue(root3)))

    value.ValueFree(v)
    value.ValueFree(v2)

    os.Exit(testing.Summary())
end
