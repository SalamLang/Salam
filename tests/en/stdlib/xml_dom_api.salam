package main

import encoding.xml

func main:
    src := "<lib id=\"1\" kind=\"a\"><book n=\"x\">Salam<i>bold</i> tail</book><book n=\"y\"/><!--c--></lib>"
    try:
        mut opts := xml.DefaultOptions()
        opts.keep_comments = false
        mut d := xml.ParseWith(src, opts)
        println xml.NodeCount(d)
        root := xml.Root(d)
        println xml.IsElement(d, root), xml.IsElement(d, xml.DocumentNode(d))
        mut kids := xml.ChildNodes(d, root)
        println kids.items.len()
        xml.FreeList(kids)
        mut els := xml.Elements(d, root)
        println els.items.len()
        first := els.items.get(0)
        println xml.IsElement(d, first), xml.NodeName(d, first), xml.NodeName(d, root)
        println xml.DirectText(d, first)
        println xml.AttributeCount(d, root), xml.AttributeCount(d, first)
        a := xml.AttributeAt(d, root, 1)
        println a.name, a.value
        mut up := xml.Ancestors(d, xml.FirstElementNamed(d, first, "i"))
        println up.items.len()
        xml.FreeList(up)
        xml.FreeList(els)

        mut keepc := xml.ParseWith(src, xml.DefaultOptions())
        println xml.NodeCount(keepc) - xml.NodeCount(d)
        xml.Free(keepc)

        try:
            mut bad := xml.ParseWith("<a><b></a>", opts)
            println xml.NodeCount(bad)
            xml.Free(bad)
        catch e:
            println e.is(ErrorKind.Syntax), e.line, e.column
            println e.ToStr()
        end

        mut nest := xml.Parse("<r><a><b>t</b></a></r>")
        println xml.WriteNodeIndent(nest, xml.FirstElementNamed(nest, xml.Root(nest), "a"), "  ")
        mut wopts := xml.DefaultWriteOptions()
        wopts.indent = "\t"
        wopts.declaration = true
        println xml.WriteWith(nest, wopts)

        xml.Free(nest)
        println xml.CanonicalNode(d, xml.ElementsNamed(d, root, "book").items.get(1))
        println xml.WriteWith(d, xml.DefaultWriteOptions()) == xml.Write(d)
        mut made := xml.NewDocument()
        r := xml.CreateElement(made, "msg")
        xml.Append(made, xml.DocumentNode(made), r)
        xml.Append(made, r, xml.CreateText(made, "a < b"))
        xml.Append(made, r, xml.CreateCData(made, "<raw>"))
        xml.Append(made, r, xml.CreateProcessingInstruction(made, "go", "now"))
        println xml.Write(made)
        xml.Free(made)

        mut ev := xml.Evaluate(d, root, "count(book)")
        println ev.kind == xml.ValueNumber, ev.number
        xml.FreeValue(ev)
        mut attrs := xml.Evaluate(d, root, "book/@n")
        println attrs.nodes.items.len()
        id := attrs.nodes.items.get(1)
        println xml.IsAttributeRef(id), xml.IsAttributeRef(first)
        ref := xml.ReferencedAttribute(d, id)
        println ref.name, ref.value
        println xml.AttributeRef(0) != 0 - 1, xml.IsAttributeRef(xml.AttributeRef(0))
        xml.FreeValue(attrs)
        println xml.NodeName(d, id)
        xml.Free(d)
    catch e:
        println e.ToStr()
    end
    try:
        mut doc := xml.Parse("<a/>")
        try:
            _ := xml.Evaluate(doc, xml.Root(doc), "count(")
            println "evaluated"
        catch e:
            println e.kind_name(), e.message
        end
        xml.Free(doc)
    catch e:
        println e.ToStr()
    end

    mut dtd := xml.ParseDTD("<!ELEMENT r (a)><!ELEMENT a EMPTY><!ATTLIST a id CDATA #IMPLIED><!ATTLIST a x CDATA \"1\">")
    println dtd.ok, xml.DeclaredElementCount(dtd), xml.DeclaredAttributeCount(dtd)
    xml.FreeDTD(dtd)
end
