package main

import encoding.xml
import testing
import os
import str

func main:
    testing.AssertTrue(xml.Valid(`<a><b>1</b></a>`))

    mut ok1 := true
    xml.DecodeStrict(`<a><b>1</b>`, ok1)
    testing.AssertFalse(ok1)
    testing.AssertFalse(xml.Valid(`<a><b>1</b>`))

    mut ok2 := true
    xml.DecodeStrict(`<a>1</a></a>`, ok2)
    testing.AssertFalse(ok2)

    mut ok3 := false
    root3 := xml.DecodeStrict("", ok3)
    testing.AssertTrue(ok3)
    testing.AssertFalse(xml.Found(root3))

    doc := `<?xml version="1.0"?><!DOCTYPE root><root><a>1</a></root>`
    mut ok4 := false
    root4 := xml.DecodeStrict(doc, ok4)
    testing.AssertTrue(ok4)
    testing.AssertEqStr(root4.tag, "root")
    a := xml.Child(root4, "a")
    testing.AssertEqStr(a.text, "1")

    mut ok5 := false
    root5 := xml.DecodeStrict(`<r><img src="x.png" width="10"/></r>`, ok5)
    testing.AssertTrue(ok5)
    img := xml.Child(root5, "img")
    testing.AssertTrue(xml.Found(img))
    testing.AssertEqStr(xml.Attr(img, "src"), "x.png")
    testing.AssertEqStr(xml.Attr(img, "width"), "10")
    testing.AssertFalse(xml.HasAttr(img, "height"))

    mut n := xml.NewXMLNode("root")
    child := xml.NewXMLNode("child")
    xml.AppendChild(n, child)
    indented := xml.EncodeIndent(n, "  ")
    testing.AssertTrue(str.Contains(indented, "\n"))
    testing.AssertTrue(str.Contains(indented, "  <child"))

    withDecl := xml.EncodeDeclaration(xml.NewXMLNode("root"))
    testing.AssertTrue(str.StartsWith(withDecl, "<?xml"))

    testing.AssertEqStr(xml.UnescapeEntities("&#65;&#x42;"), "AB")

    testing.AssertEqStr(xml.UnescapeEntities("a &foo; b"), "a &foo; b")

    escAttr := xml.EscapeAttr(`he said "hi" & left`)
    testing.AssertEqStr(escAttr, "he said &quot;hi&quot; &amp; left")

    os.Exit(testing.Summary())
end
