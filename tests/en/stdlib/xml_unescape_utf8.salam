import encoding.xml

func main:
    println xml.UnescapeEntities("&#1587;&#x644;&#1575;&#x645; &lt;ok&gt; &#65;")
    n := xml.Decode("<a>&#1587;&#x644;&#1575;&#x645;</a>")
    println n.text
end
