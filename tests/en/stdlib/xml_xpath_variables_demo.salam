package main

import encoding.xml
import testing

const SAMPLE := `<library>
  <book id="b1" lang="fa"><price>12.5</price></book>
  <book id="b2" lang="en"><price>8</price></book>
  <book id="b3" lang="en"><price>20</price></book>
</library>`

func main(): int throws:
    mut d := try xml.Parse(SAMPLE)
    mut vars := xml.XPathVariables {}
    vars.set_string("lang", "en")
    vars.set_number("min", 10.0)
    vars.set_boolean("wanted", true)

    testing.AssertEqFloat(try xml.SelectNumberWith(d, 0 - 1, "count(//book[@lang=$lang])", vars), 2.0, 0.0001)
    testing.AssertEqFloat(try xml.SelectNumberWith(d, 0 - 1, "count(//book[price > $min])", vars), 2.0, 0.0001)
    testing.AssertEqStr(try xml.SelectStringWith(d, 0 - 1, "//book[@id='b2']/@lang", vars), "en")
    testing.AssertTrue(try xml.SelectBooleanWith(d, 0 - 1, "$wanted", vars))
    testing.AssertEqInt(vars.IndexOf("lang"), 0)
    mut evaluated := try xml.EvaluateWith(d, 0 - 1, "$min + 1", vars)
    testing.AssertEqFloat(evaluated.number, 11.0, 0.0001)
    xml.FreeValue(evaluated)
    one := try xml.EvaluateWith(d, 0 - 1, "1", vars)
    vars.Set("one", one)
    testing.AssertTrue(try xml.SelectFirstWith(d, 0 - 1, "//book", vars) > 0)

    picked := try xml.SelectWith(d, 0 - 1, "//book[@lang=$lang]", vars)
    vars.set_nodes("picked", picked)
    testing.AssertEqFloat(try xml.SelectNumberWith(d, 0 - 1, "count($picked)", vars), 2.0, 0.0001)
    testing.AssertEqStr(try xml.SelectStringWith(d, 0 - 1, "$picked[1]/price", vars), "8")

    mut caught := Error {}
    try:
        xml.Select(d, 0 - 1, "$missing")
    catch e:
        caught = e
    end
    testing.AssertEqStr(caught.code, "xpath.unknown_variable")

    vars.Free()
    xml.Free(d)

    ret testing.Summary()
end
