8e6f0983c64412f630a11b9283cef29a46f70b9562cdad31d8d5b5f5f327dbcf74cf5346b05cea1484b3b928a33e65576b
091dcee4e2109fcf9ca8e942db59313b887caa11fb5969d3a66828139544946f39eab4118559f456dedfee3f62807a30b1
384ddb8bf5cb91c72cea23d32c874a942b29238af8e208e582f9801fabf024e4062ef26193e60a1c4cef054351417f55e6
b1187dc8977ffe779171
"""

const WORDS := ["salam", "compress", "xz", "lzma", "archive", "the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog", "stream", "block", "index"]

mut pool_s := Vector {} as Vector<str>
mut pool_b := Vector {} as Vector<compress.ByteBuf>

func ks(s: str): str:
    pool_s.push(s)
    ret s
end

func kb(b: compress.ByteBuf): compress.ByteBuf:
    pool_b.push(b)
    ret b
end

func release():
    repeat pool_s.Len() in i:
        s := pool_s.get(i)
        if s.Len() > 0:
            mem.Free(s as void*)
        end
    end
    pool_s.free()
    repeat pool_b.Len() in i:
        mut b := pool_b.get(i)
        compress.BufFree(b)
    end
    pool_b.free()
end

func j(a: str, b: str): str:
    ret ks(filepath.Join(a, b))
end

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex_raw(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func unhex(s: str): compress.ByteBuf:
    ret kb(unhex_raw(s))
end

func gen_text(n: int, seed: i64): compress.ByteBuf:
    ret kb(gen_text_raw(n, seed))
end

func lcg(x: i64): i64:
    ret (x * 1103515245 + 12345) & 0x7fffffff
end

func gen_text_raw(n: int, seed: i64): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = lcg(x)
        w := WORDS[((x >> 8) % 16) as int]
        compress.BufPushBytes(out, w as void*, w.Len())
        if ((x >> 4) & 7) == 0:
            compress.BufPush(out, 10)
        else:
            compress.BufPush(out, 32)
        end
    end
    ret out
end

func push32(b &: compress.ByteBuf, v: i64):
    compress.BufPush(b, (v & 255) as int)
    compress.BufPush(b, ((v >> 8) & 255) as int)
    compress.BufPush(b, ((v >> 16) & 255) as int)
    compress.BufPush(b, ((v >> 24) & 255) as int)
end

func gen_x86_raw(n: int, seed: i64): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = lcg(x)
        k := (x >> 8) % 4
        if k < 2:
            rel := ((x >> 10) % 2000) - 1000
            if k == 0:
                compress.BufPush(out, 232)
            else:
                compress.BufPush(out, 233)
            end
            push32(out, rel & 0xffffffff)
        else:
            c := 1 + ((x >> 10) % 4)
            repeat c:
                x = lcg(x)
                compress.BufPush(out, ((x >> 12) & 255) as int)
            end
        end
    end
    ret out
end

func gen_delta_raw(n: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    repeat n in i:
        push32(out, ((i * 5 + (i % 3)) as i64) & 0xffffffff)
    end
    ret out
end

func gen_big_raw(): compress.ByteBuf:
    mut out := gen_text_raw(800, 7)
    repeat 5000:
        compress.BufPushBytes(out, "abcdefgh12345678" as void*, 16)
    end
    repeat 30000:
        compress.BufPush(out, 0)
    end
    ret out
end

func gen_x86(n: int, seed: i64): compress.ByteBuf:
    ret kb(gen_x86_raw(n, seed))
end

func gen_delta(n: int): compress.ByteBuf:
    ret kb(gen_delta_raw(n))
end

func gen_big(): compress.ByteBuf:
    ret kb(gen_big_raw())
end

func same(label: str, ok: bool, got: compress.ByteBuf, want: compress.ByteBuf):
    println label, ok and compress.BufEquals(got, want), got.len
end

func xz_case(label: str, hex: str, want: compress.ByteBuf):
    packed := unhex(hex)
    mut ok := false
    got := kb(compress.XzDecompress(packed.data, packed.len, ok))
    same(label, ok, got, want)
end

func lzma_case(label: str, hex: str, want: compress.ByteBuf):
    packed := unhex(hex)
    mut ok := false
    got := kb(compress.LzmaDecompress(packed.data, packed.len, ok))
    same(label, ok, got, want)
end

func xz_bad(label: str, packed: compress.ByteBuf):
    mut ok := true
    got := kb(compress.XzDecompressBuf(packed, ok))
    println label, ok, got.len
end

func read_same(path: str, want: compress.ByteBuf): bool:
    mut ok := false
    got := kb(archive.ReadBinaryFile(path, ok))
    ret ok and compress.BufEquals(got, want)
end

func main:
    text := gen_text(40, 1)
    x86 := gen_x86(300, 3)
    delta := gen_delta(400)
    big := gen_big()

    println "== xz =="
    xz_case("crc64 -6", XZ_CRC64, text)
    xz_case("crc32", XZ_CRC32, text)
    xz_case("sha256 -1", XZ_SHA256, text)
    xz_case("no check -0", XZ_NONE, text)
    xz_case("extreme -9e", XZ_EXTREME, text)
    xz_case("several blocks", XZ_BLOCKS, text)
    xz_case("python sha256", XZ_PY, text)
    xz_case("7z -txz", XZ_7Z, text)

    println "== filters =="
    xz_case("x86 branch filter", XZ_X86, x86)
    xz_case("delta distance 4", XZ_DELTA, delta)
    xz_case("python x86 + lc1 lp2 pb0", XZ_PY_FILTERS, x86)

    println "== lzma =="
    mut ok := false
    packed := unhex(LZMA_XZ)
    got := kb(compress.LzmaDecompressBuf(packed, ok))
    same("xz --format=lzma", ok, got, text)
    lzma_case("python alone", LZMA_PY, text)
    lzma_case("python alone lc0 lp3 pb1", LZMA_PY_LC, text)

    mut known := kb(compress.BufClone(packed))
    repeat 8 in i:
        compress.BufSet(known, 5 + i, 0)
    end
    compress.BufSet(known, 5, text.len & 255)
    compress.BufSet(known, 6, (text.len >> 8) & 255)
    got2 := kb(compress.LzmaDecompressBuf(known, ok))
    same("known size in header", ok, got2, text)
    compress.BufSet(known, 5, (text.len + 1) & 255)
    got3 := kb(compress.LzmaDecompressBuf(known, ok))
    println "size larger than the data", ok, got3.len

    println "== raw =="
    raw1 := unhex(RAW_LZMA)
    props := unhex("5d00000100")
    got4 := kb(compress.LzmaRawDecompress(props.data, 5, raw1.data, raw1.len, text.len, 0, ok))
    same("raw lzma", ok, got4, text)
    raw2 := unhex(RAW_LZMA2)
    got5 := kb(compress.Lzma2RawDecompress(16, raw2.data, raw2.len, text.len, 0, ok))
    same("raw lzma2", ok, got5, text)
    got6 := kb(compress.Lzma2RawDecompress(16, raw2.data, raw2.len, -1, 0, ok))
    same("raw lzma2 unknown size", ok, got6, text)
    got7 := kb(compress.Lzma2RawDecompress(16, raw2.data, raw2.len, text.len + 5, 0, ok))
    println "raw lzma2 wrong size", ok, got7.len
    got8 := kb(compress.Lzma2RawDecompress(41, raw2.data, raw2.len, -1, 0, ok))
    println "raw lzma2 bad dictionary", ok, got8.len

    println "== bigger =="
    xz_case("xz 70 KB", XZ_BIG, big)
    bpk := unhex(LZMA_BIG)
    got9 := kb(compress.LzmaDecompressBuf(bpk, ok))
    same("lzma 70 KB", ok, got9, big)
    println "packed", unhex(XZ_BIG).len, "to", big.len

    println "== limits =="
    bx := unhex(XZ_BIG)
    lim1 := kb(compress.XzDecompressMax(bx.data, bx.len, big.len, ok))
    println "xz max exact", ok, lim1.len
    lim2 := kb(compress.XzDecompressMax(bx.data, bx.len, big.len - 1, ok))
    println "xz max one less", ok, lim2.len
    lim3 := kb(compress.XzDecompressMax(bx.data, bx.len, 100, ok))
    println "xz max 100", ok, lim3.len
    lim4 := kb(compress.LzmaDecompressMax(bpk.data, bpk.len, big.len, ok))
    println "lzma max exact", ok, lim4.len
    lim5 := kb(compress.LzmaDecompressMax(bpk.data, bpk.len, 100, ok))
    println "lzma max 100", ok, lim5.len

    println "== streams =="
    mut two := unhex_raw(XZ_CRC32)
    compress.BufPushBuf(two, unhex(XZ_SHA256))
    mut twice := compress.NewByteBuf()
    compress.BufPushBuf(twice, text)
    compress.BufPushBuf(twice, text)
    got10 := kb(compress.XzDecompressBuf(two, ok))
    same("two streams", ok, got10, twice)
    mut padded := unhex_raw(XZ_CRC32)
    repeat 8:
        compress.BufPush(padded, 0)
    end
    compress.BufPushBuf(padded, unhex(XZ_NONE))
    got11 := kb(compress.XzDecompressBuf(padded, ok))
    same("stream padding", ok, got11, twice)
    mut tail := unhex_raw(XZ_CRC32)
    repeat 3:
        compress.BufPush(tail, 0)
    end
    xz_bad("padding not a multiple of 4", tail)

    println "== damaged =="
    xz_bad("empty", kb(compress.NewByteBuf()))
    mut cut := unhex(XZ_SHA256)
    cut.len--
    xz_bad("truncated", cut)
    cut.len = 20
    xz_bad("cut inside block", cut)
    mut magic := unhex(XZ_CRC64)
    compress.BufSet(magic, 0, 0)
    xz_bad("bad magic", magic)
    mut flags := unhex(XZ_CRC64)
    compress.BufSet(flags, 7, 3)
    xz_bad("bad stream flags", flags)
    mut chk := unhex(XZ_SHA256)
    compress.BufSet(chk, 160, compress.BufGet(chk, 160) ^ 1)
    xz_bad("sha256 mismatch", chk)
    mut c32 := unhex(XZ_CRC32)
    compress.BufSet(c32, 156, compress.BufGet(c32, 156) ^ 128)
    xz_bad("crc32 mismatch", c32)
    mut body := unhex(XZ_CRC64)
    compress.BufSet(body, 30, compress.BufGet(body, 30) ^ 4)
    xz_bad("flipped data bit", body)
    mut hdr := unhex(XZ_CRC64)
    compress.BufSet(hdr, 13, compress.BufGet(hdr, 13) ^ 1)
    xz_bad("block header crc", hdr)
    mut foot := unhex(XZ_CRC64)
    compress.BufSet(foot, foot.len - 1, 0)
    xz_bad("bad footer magic", foot)
    mut alone := unhex(LZMA_XZ)
    alone.len -= 5
    got12 := kb(compress.LzmaDecompressBuf(alone, ok))
    println "truncated lzma", ok, got12.len
    mut hbad := unhex(LZMA_XZ)
    compress.BufSet(hbad, 0, 225)
    got13 := kb(compress.LzmaDecompressBuf(hbad, ok))
    println "bad lzma properties", ok, got13.len
    compress.BufSet(hbad, 0, 93)
    compress.BufSet(hbad, 4, 255)
    got14 := kb(compress.LzmaDecompressBuf(hbad, ok))
    println "lzma dictionary over the limit", ok, got14.len

    println "== files =="
    xz_path := j(os.TempDir(), "salam_xz_decode.xz")
    lzma_path := j(os.TempDir(), "salam_xz_decode.lzma")
    out_path := j(os.TempDir(), "salam_xz_decode.out")
    archive.WriteBinaryFileBuf(xz_path, unhex(XZ_BLOCKS))
    archive.WriteBinaryFileBuf(lzma_path, unhex(LZMA_XZ))
    println "xz file", archive.XzDecompressFile(xz_path, out_path), read_same(out_path, text)
    println "lzma file", archive.LzmaDecompressFile(lzma_path, out_path), read_same(out_path, text)
    println "xz file read as lzma", archive.LzmaDecompressFile(xz_path, out_path)
    println "missing file", archive.XzDecompressFile(j(os.TempDir(), "salam_xz_decode.out.missing"), out_path)
    os.Remove(xz_path)
    os.Remove(lzma_path)
    os.Remove(out_path)

    println "== filters directly =="
    d := unhex("01010101")
    println compress.DeltaDecode(d.data, d.len, 1), compress.BufGet(d, 0), compress.BufGet(d, 1), compress.BufGet(d, 2), compress.BufGet(d, 3)
    println compress.DeltaDecode(d.data, d.len, 0), compress.BcjDecode(99, d.data, d.len, 0), compress.BcjDecode(compress.BcjARM, d.data, d.len, 0)
    compress.BufFree(two)
    compress.BufFree(twice)
    compress.BufFree(padded)
    compress.BufFree(tail)
    release()
end
