package main

import archive
import compress
import filepath
import mem
import os

const SHA_XZ := "fd377a585a00000ae1fb0ca104c02df6012101160000000000000000644ebc90e000f500255d00399849da93e1a08327c57b49fecb1d2aba563d317e320cddb11c02036cbb12d618aee9200000000000f51d5a279901398c0ac2aafca6d72e61e6a11d65b31e2d850fc82eab385cce7f000161f601000000baca357fb6e9df1c02000000000a595a"
const DELTA_XZ := "fd377a585a000004e6d6b44604c131f6010301002101100000000000c75e57f4e000f500295d0039bb7d6f55efb6a1dd5db3c01adea843e18efdb4d462530e6cb20b072ad7117d6454628495320f200000000000e05d27053bcf197d00014df601000000f70f5b0fb1c467fb020000000004595a"

func cat(a: str, b: str): str:
    ret filepath.Join(a, b)
end

func hexval(c: int): int:
    if c >= 97:
        ret c - 87
    end
    ret c - 48
end

func from_hex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBufCap(s.Len() / 2)
    p := s as u8*
    mut i := 0
    until i + 1 < s.Len():
        compress.BufPush(b, hexval(p[i] as int) * 16 + hexval(p[i + 1] as int))
        i += 2
    end
    ret b
end

func collect(p: void*, n: int, c: void*): bool:
    compress.BufPushBytes((c as compress.ByteBuf*)[0], p, n)
    ret true
end

func run_sink(path: str, cap: i64, label: str):
    fp := compress.FileOpenRead(path)
    got := mem.AllocateZeroed(sizeof(compress.ByteBuf)) as compress.ByteBuf*
    got[0] = compress.NewByteBuf()
    mut sink := compress.SinkCallback(cap, (p: void*, n: int, c: void*): ret collect(p, n, c) end, got as void*)
    st := compress.XzFileToSink(fp, 0 as i64, compress.FileSize(fp), sink, 0 as i64)
    println label, st, sink.written, got[0].len
    compress.BufFree(got[0])
    mem.Free(got as void*)
    compress.FileClose(fp)
end

func main:
    root := cat(os.TempDir(), "salam_xz_stream_demo")
    os.RemoveAll(root)
    os.MkdirAll(root)
    mut sha := from_hex(SHA_XZ)
    mut delta := from_hex(DELTA_XZ)
    f1 := cat(root, "sha.xz")
    f2 := cat(root, "delta.xz")
    println archive.WriteBinaryFileBuf(f1, sha), archive.WriteBinaryFileBuf(f2, delta)
    run_sink(f1, 0 as i64, "sha256")
    run_sink(f2, 0 as i64, "delta")
    run_sink(f1, 100 as i64, "cap")
    (sha.data as u8*)[sha.len / 2] = 7 as u8
    f3 := cat(root, "bad.xz")
    println archive.WriteBinaryFileBuf(f3, sha)
    run_sink(f3, 0 as i64, "damaged")
    out := cat(root, "out.txt")
    println "file", archive.XzDecompressFileCap(f1, out, 0 as i64), os.FileSize(out)
    println "file cap", archive.XzDecompressFileCap(f1, out, 100 as i64), os.Exists(out)

    note := "hello xz tar"
    mut big := compress.NewByteBufCap(2000000)
    repeat 2000000 in i:
        compress.BufPush(big, 65 + ((i % 1000) * (i % 977)) % 23)
    end
    mut files := Vector {} as Vector<archive.TarFileInput>
    files.push(archive.MakeTarFileInput("a.txt", note as void*, note.Len(), false))
    files.push(archive.MakeTarFileInput("sub/big.bin", big.data, big.len, false))
    tar := cat(root, "t.tar")
    txz := cat(root, "t.tar.xz")
    println archive.TarCreateFile(files, tar), archive.XzCompressFile(tar, txz)
    dir := cat(root, "x")
    println "tar.xz", archive.TarXzFileExtractAll(txz, dir, 0 as i64)
    p1 := cat(dir, "a.txt")
    p2 := cat(dir, "sub/big.bin")
    println os.FileSize(p1), os.FileSize(p2)
    mut lst := 0
    mut es := archive.TarCompressedFileEntries(txz, archive.FormatTarXz, lst)
    println "list", lst, es.Len()
    archive.FreeEntries(es)
    dir2 := cat(root, "y")
    println "capped", archive.TarCompressedFileExtractAll(txz, archive.FormatTarXz, dir2, 100 as i64)
    files.free()
    compress.BufFree(big)
    compress.BufFree(sha)
    compress.BufFree(delta)
    os.RemoveAll(root)
    free_all(root, f1, f2, f3, out, tar, txz, dir, dir2, p1, p2)
    ret 0
end

func free_all(a: str, b: str, c: str, d: str, e: str, f: str, g: str, h: str, i: str, j: str, k: str):
    mem.Free(a as void*)
    mem.Free(b as void*)
    mem.Free(c as void*)
    mem.Free(d as void*)
    mem.Free(e as void*)
    mem.Free(f as void*)
    mem.Free(g as void*)
    mem.Free(h as void*)
    mem.Free(i as void*)
    mem.Free(j as void*)
    mem.Free(k as void*)
end
