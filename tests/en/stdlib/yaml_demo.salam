package main

import testing
import encoding.yaml
import encoding.value

func doc(): str:
    mut t := "app:\n"
    t = t.Concat("  name: myservice\n")
    t = t.Concat("  port: 8080\n")
    t = t.Concat("  debug: true\n")
    t = t.Concat("  ratio: 0.75\n")
    t = t.Concat("  tags:\n")
    t = t.Concat("    - alpha\n")
    t = t.Concat("    - beta\n")
    t = t.Concat("    - gamma\n")
    t = t.Concat("  db:\n")
    t = t.Concat("    host: localhost\n")
    t = t.Concat("    user: root\n")
    t = t.Concat("blank:\n")
    t = t.Concat("quoted: \"has: a colon\"\n")
    ret t
end

func test_scalars():
    t := doc()
    testing.AssertEqStr(yaml.Get(t, "app.name"), "myservice")
    testing.AssertEqInt(yaml.GetInt(t, "app.port"), 8080)
    testing.AssertTrue(yaml.GetBool(t, "app.debug"))
    testing.AssertEqFloat(yaml.GetFloat(t, "app.ratio"), 0.75, 0.0001)
    testing.AssertEqStr(yaml.Get(t, "quoted"), "has: a colon")
    testing.AssertEqStr(yaml.Get(t, "blank"), "")
    testing.AssertEqStr(yaml.Get(t, "app.nothing"), "")
end

func test_nested_and_sequences():
    t := doc()
    testing.AssertEqStr(yaml.Get(t, "app.db.host"), "localhost")
    testing.AssertEqStr(yaml.Get(t, "app.db.user"), "root")
    testing.AssertEqStr(yaml.Get(t, "app.tags[0]"), "alpha")
    testing.AssertEqStr(yaml.Get(t, "app.tags[1]"), "beta")
    testing.AssertEqStr(yaml.Get(t, "app.tags[2]"), "gamma")
    testing.AssertEqInt(yaml.Len(t, "app.tags"), 3)
    testing.AssertEqInt(yaml.Len(t, "app.db"), 2)
    testing.AssertEqInt(yaml.Len(t, "app.name"), 0 - 1)
end

func test_has_and_typeof():
    t := doc()
    testing.AssertTrue(yaml.Has(t, "app"))
    testing.AssertTrue(yaml.Has(t, "app.db.host"))
    testing.AssertFalse(yaml.Has(t, "app.db.password"))
    testing.AssertFalse(yaml.Has(t, "nope"))
    testing.AssertEqStr(yaml.TypeOf(t, "app"), "map")
    testing.AssertEqStr(yaml.TypeOf(t, "app.tags"), "list")
    testing.AssertEqStr(yaml.TypeOf(t, "app.name"), "string")
    testing.AssertEqStr(yaml.TypeOf(t, "app.port"), "int")
    testing.AssertEqStr(yaml.TypeOf(t, "app.ratio"), "float")
    testing.AssertEqStr(yaml.TypeOf(t, "app.debug"), "bool")
    testing.AssertEqStr(yaml.TypeOf(t, "missing"), "none")
end

func test_keys():
    t := doc()
    top := yaml.Keys(t, "")
    defer top.Free()
    testing.AssertEqInt(top.Len(), 3)
    testing.AssertEqStr(top.Get(0), "app")
    testing.AssertEqStr(top.Get(1), "blank")
    testing.AssertEqStr(top.Get(2), "quoted")

    inner := yaml.Keys(t, "app")
    defer inner.Free()
    testing.AssertEqInt(inner.Len(), 6)
    testing.AssertEqStr(inner.Get(0), "name")
    testing.AssertEqStr(inner.Get(5), "db")

    deep := yaml.Keys(t, "app.db")
    defer deep.Free()
    testing.AssertEqInt(deep.Len(), 2)

    seq := yaml.Keys(t, "app.tags")
    defer seq.Free()
    testing.AssertEqInt(seq.Len(), 0)
    scalar := yaml.Keys(t, "app.name")
    defer scalar.Free()
    testing.AssertEqInt(scalar.Len(), 0)
    gone := yaml.Keys(t, "not.here")
    defer gone.Free()
    testing.AssertEqInt(gone.Len(), 0)
end

func test_has_keys():
    t := doc()
    mut want := Vector {} as Vector<str>
    defer want.Free()
    want.Push("app")
    want.Push("quoted")
    testing.AssertTrue(yaml.HasKeys(t, want))
    want.Push("absent")
    testing.AssertFalse(yaml.HasKeys(t, want))
end

func test_valid_and_json():
    t := doc()
    testing.AssertTrue(yaml.Valid(t))
    testing.AssertTrue(yaml.Valid(""))
    json := yaml.ToJSON(t)
    testing.AssertContains(json, `"name"`)
    testing.AssertContains(json, `"myservice"`)
    testing.AssertContains(json, "8080")
end

func test_value_bridge():
    mut v := value.ValueNull()
    try:
        v = yaml.Decode(doc())
    catch e:
        testing.AssertMsg(false, e.ToStr())
    end
    testing.AssertTrue(value.IsObject(v))
    app := value.ObjectGet(v, "app")
    testing.AssertTrue(value.IsObject(app))
    testing.AssertEqStr(value.AsString(value.ObjectGet(app, "name")), "myservice")
    out := yaml.Encode(v)
    testing.AssertEqStr(yaml.Get(out, "app.name"), "myservice")
    testing.AssertEqInt(yaml.GetInt(out, "app.port"), 8080)
    testing.AssertEqStr(yaml.Get(out, "app.db.host"), "localhost")
end

func main:
    test_scalars()
    test_nested_and_sequences()
    test_has_and_typeof()
    test_keys()
    test_has_keys()
    test_valid_and_json()
    test_value_bridge()
    testing.Summary()
    ret 0
end
