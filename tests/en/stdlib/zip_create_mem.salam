package main

import archive
import compress
import filepath
import mem
import os

func make(n: int): compress.ByteBuf:
    mut out := compress.NewByteBufCap(n + 16)
    mut s := 4242 as i64
    mut i := 0
    until i < n:
        s = (s * 1103515245 + 12345) & 0x7fffffff
        v := ((s >> 16) & 255) as int
        if (i / 4096) % 3 == 0:
            compress.BufPush(out, v)
            i++
        else:
            run := 1 + (v & 15)
            repeat run:
                if i < n:
                    compress.BufPush(out, 97 + (v & 7))
                    i++
                end
            end
        end
    end
    ret out
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_zip_create_mem")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    mut b := make(700000)
    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.push(archive.MakeZipFileInput("store.bin", b.data, 5000, archive.ZipMethodStore))
    files.push(archive.MakeZipFileInputLevel("bz.bin", b.data, b.len, archive.ZipMethodBzip2, 9))
    files.push(archive.MakeZipFileInputLevel("zs.bin", b.data, b.len, archive.ZipMethodZstd, 5))
    files.push(archive.MakeZipFileInputLevel("lz.bin", b.data, b.len, archive.ZipMethodLzma, 6))
    files.push(archive.MakeZipFileInput("empty.bin", null, 0, archive.ZipMethodStore))
    mut deflated := Vector {} as Vector<archive.ZipFileInput>
    deflated.push(archive.MakeZipFileInput("deflate.bin", b.data, b.len, archive.ZipMethodDeflate))
    deflated.push(archive.MakeZipFileInput("empty.bin", null, 0, archive.ZipMethodDeflate))
    deflated.push(archive.MakeZipFileInput("small.bin", b.data, 3000, archive.ZipMethodDeflate))

    each wide in [false, true]:
        mut mem_zip := wide ? archive.ZipCreate64(files) : archive.ZipCreate(files)
        disk := filepath.Join(dir, "disk.zip")
        made := wide ? archive.ZipCreateFile64(files, disk) : archive.ZipCreateFile(files, disk)
        mut ok := false
        mut on_disk := archive.ReadBinaryFile(disk, ok)
        println "wide", wide, "file", made, "same bytes", compress.BufEquals(mem_zip, on_disk)
        compress.BufFree(on_disk)
        mut es := archive.ZipList(mem_zip.data, mem_zip.len)
        println "entries", es.Len()
        archive.FreeEntries(es)
        compress.BufFree(mem_zip)
    end

    mut checked := 0
    mut fz := archive.ZipCreate(deflated)
    println "deflate", archive.ZipVerify(fz.data, fz.len, checked), checked
    mut fes := archive.ZipList(fz.data, fz.len)
    println "deflate entries", fes.Len()
    archive.FreeEntries(fes)
    compress.BufFree(fz)
    deflated.free()

    mut locked := Vector {} as Vector<archive.ZipFileInput>
    locked.push(archive.MakeZipFileInputEncrypted("aes.bin", b.data, b.len, archive.ZipMethodDeflate, 6, "pw", archive.ZipEncAes256))
    locked.push(archive.MakeZipFileInputEncrypted("zc.bin", b.data, 100000, archive.ZipMethodZstd, 3, "pw", archive.ZipEncZipCrypto))
    mut lz := archive.ZipCreate(locked)
    println "encrypted", lz.len > 0
    lpath := filepath.Join(dir, "locked.zip")
    archive.WriteBinaryFileBuf(lpath, lz)
    compress.BufFree(lz)
    mut zf := archive.ZipOpenFile(lpath)
    archive.ZipFileSetPassword(zf, "pw")
    mut les := archive.ZipFileEntries(zf)
    each e in les:
        dest := filepath.Join(dir, "x_" + e.name)
        st := archive.ZipFileExtractTo(zf, e.name, dest, 0 as i64)
        println e.name, e.size, st, os.FileSize(dest) == e.size
        os.Remove(dest)
        mem.Free(dest as void*)
    end
    archive.FreeEntries(les)
    archive.ZipFileClose(zf)

    mut bad := Vector {} as Vector<archive.ZipFileInput>
    bad.push(archive.MakeZipFileInput("missing.bin", null, 5, archive.ZipMethodStore))
    println "bad input", archive.ZipCreate(bad).len
    files.free()
    locked.free()
    bad.free()
    os.RemoveAll(dir)
    compress.BufFree(b)
end
