package main

import archive
import compress
import filepath
import mem
import os

func hex_val(c: int): int:
    if c >= 97: ret c - 87 end
    ret c - 48
end

func unhex(h: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := h as u8*
    mut i := 0
    until i + 1 < h.len():
        compress.BufPush(b, hex_val(bp[i] as int) * 16 + hex_val(bp[i + 1] as int))
        i += 2
    end
    ret b
end

func main:
    z := unhex("")
    mut es := archive.ZipList(z.data, z.len)
    each e in es:
        println e.name, e.size, e.compressed_size, e.method
    end
    archive.FreeEntries(es)

    mut status := 0
    big := archive.ZipExtractVerified(z.data, z.len, "big.bin", 0, status)
    println "big", status, big.len, compress.CRC32Buf(big) == (3088058596 as u32)
    small := archive.ZipExtractVerified(z.data, z.len, "small.txt", 0, status)
    println "small", status, compress.BufToStrUnsafe(small) == "hello deflate64\n" * 3
    mut checked := 0
    println "verify", archive.ZipVerify(z.data, z.len, checked), checked
    capped := archive.ZipExtractVerified(z.data, z.len, "big.bin", 1000, status)
    println "capped", status, capped.len

    dir := filepath.Join(os.TempDir(), "salam_zip_deflate64")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    path := filepath.Join(dir, "d64.zip")
    println archive.WriteBinaryFileBuf(path, z)
    mut zf := archive.ZipOpenFile(path)
    println "open", zf.status, zf.count
    out := filepath.Join(dir, "big.out")
    println "file", archive.ZipFileExtractTo(zf, "big.bin", out, 0 as i64), os.FileSize(out)
    println "file cap", archive.ZipFileExtractTo(zf, "big.bin", out, 1000 as i64), os.Exists(out)
    all := filepath.Join(dir, "all")
    println "all", archive.ZipFileExtractAll(zf, all, 0 as i64)
    p := filepath.Join(all, "small.txt")
    println os.FileSize(p)
    archive.ZipFileClose(zf)

    bp := z.data as u8*
    bp[60] = ((bp[60] as int) ^ 0x55) as u8
    broken := archive.ZipExtractVerified(z.data, z.len, "big.bin", 0, status)
    println "broken", status != archive.ZIP_OK, broken.len
    println archive.ZipMethodDeflate64
    os.RemoveAll(dir)
    mem.Free(out as void*)
    mem.Free(all as void*)
    mem.Free(p as void*)
end
