func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func text(n: int): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    repeat n in i:
        line := "line " + str.FromInt(i as i64) + " of the salam zip test\n"
        compress.BufPushBytes(b, line as void*, line.len())
    end
    ret b
end

func noise(n: int): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    mut x := 12345 as i64
    repeat n:
        x = (x * (1103515245 as i64) + (12345 as i64)) & (0x7fffffff as i64)
        compress.BufPush(b, ((x >> 16) & (255 as i64)) as int)
    end
    ret b
end

func same(path: str, want: compress.ByteBuf): bool:
    mut ok := false
    got := archive.ReadBinaryFile(path, ok)
    ret ok and compress.BufEquals(got, want)
end

func check(label: str, hex: str, password: str, dir: str):
    path := filepath.Join(dir, label + ".zip")
    archive.WriteBinaryFileBuf(path, unhex(hex))
    mut zf := archive.ZipOpenFile(path)
    println label, "open", zf.status
    mut es := archive.ZipFileEntries(zf)
    repeat es.len() in i:
        println "  ", es.get(i).name, es.get(i).size, es.get(i).method
    end
    archive.FreeEntries(es)
    out := filepath.Join(dir, label)
    println "  no password", archive.ZipFileExtractAll(zf, out, 0 as i64)
    archive.ZipFileSetPassword(zf, "wrong")
    println "  wrong password", archive.ZipFileExtractTo(zf, "t.txt", filepath.Join(dir, "w.bin"), 0 as i64)
    archive.ZipFileSetPassword(zf, password)
    println "  all", archive.ZipFileExtractAll(zf, out, 0 as i64)
    println "  text", same(filepath.Join(out, "t.txt"), text(120)), "noise", same(filepath.Join(out, "n.bin"), noise(300))
    println "  cap", archive.ZipFileExtractTo(zf, "t.txt", filepath.Join(dir, "c.bin"), 100 as i64)
    archive.ZipFileClose(zf)
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_zip_methods_file_demo")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    check("classic", Z_CLASSIC, "pw123", dir)
    check("aes256", Z_AES256, "pw123", dir)
    check("aes128", Z_AES128, "pw123", dir)
    check("lzma", Z_LZMA, "", dir)
    check("deflate64", Z_D64, "", dir)
    check("bzip2", Z_BZ2, "", dir)
    println archive.ZipStatusText(archive.ZIP_BAD_PASSWORD)
    os.RemoveAll(dir)
end
