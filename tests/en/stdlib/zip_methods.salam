const WORDS := ["salam", "compress", "zstd", "lzma", "archive", "the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog", "stream", "block", "index"]

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func lcg(x: i64): i64:
    ret (x * 1103515245 + 12345) & 0x7fffffff
end

func gen_text(n: int, seed: i64): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = lcg(x)
        w := WORDS[((x >> 8) % 16) as int]
        compress.BufPushBytes(out, w as void*, w.Len())
        if ((x >> 4) & 7) == 0:
            compress.BufPush(out, 10)
        else:
            compress.BufPush(out, 32)
        end
    end
    ret out
end

func read_case(label: str, hex: str, dname: str, text: compress.ByteBuf):
    z := unhex(hex)
    mut checked := 0
    println label, "verify", archive.ZipVerify(z.data, z.len, checked), checked
    mut es := archive.ZipList(z.data, z.len)
    each e in es:
        println "  ", e.name, e.method, e.size
    end
    archive.FreeEntries(es)
    mut st := 0
    d := archive.ZipExtractVerified(z.data, z.len, dname, 0, st)
    println "  data", st, compress.BufEquals(d, text)
    n := archive.ZipExtractVerified(z.data, z.len, "note.txt", 0, st)
    println "  note", st, compress.BufToStrUnsafe(n).Trim()
    mut ok := false
    u := archive.ZipExtractByName(z.data, z.len, dname, ok)
    println "  by name", ok, compress.BufEquals(u, text)
end

func create_case(label: str, method: int, level: int, data: compress.ByteBuf, hex: str):
    mut files := Vector {} as Vector<archive.ZipFileInput>
    mut f1 := archive.MakeZipFileInputLevel("a/data.bin", data.data, data.len, method, level)
    f1.mtime = 1700000000 as i64
    files.Push(f1)
    note := compress.BufFromStr("hello zip methods\n")
    files.Push(archive.MakeZipFileInput("note.txt", note.data, note.len, method))
    files.Push(archive.MakeZipFileInput("empty.txt", null, 0, method))
    z := archive.ZipCreate(files)
    mut checked := 0
    mut st := 0
    d := archive.ZipExtractVerified(z.data, z.len, "a/data.bin", 0, st)
    mut es := archive.ZipList(z.data, z.len)
    println label, level, archive.ZipVerify(z.data, z.len, checked), checked, st, compress.BufEquals(d, data), es.Get(0).method, es.Get(1).method, es.Get(2).method, z.len < data.len
    archive.FreeEntries(es)
    if hex.Len() > 0:
        println "  same bytes as the checked file", compress.BufEquals(z, unhex(hex))
    end
end

func file_case(label: str, z: compress.ByteBuf, dname: str, text: compress.ByteBuf, root: str):
    path := filepath.Join(root, label + ".zip")
    archive.WriteBinaryFileBuf(path, z)
    mut zf := archive.ZipOpenFile(path)
    mut es := archive.ZipFileEntries(zf)
    println label, zf.status, zf.count, es.Len()
    archive.FreeEntries(es)
    out := filepath.Join(root, label + ".out")
    println "  to file", archive.ZipFileExtractTo(zf, dname, out, 0 as i64), read_same(out, text)
    println "  capped", archive.ZipFileExtractTo(zf, dname, out, 100 as i64)
    dir := filepath.Join(root, label)
    println "  all", archive.ZipFileExtractAll(zf, dir, 0 as i64), read_same(filepath.Join(dir, dname), text)
    archive.ZipFileClose(zf)
end

func read_same(path: str, want: compress.ByteBuf): bool:
    mut ok := false
    got := archive.ReadBinaryFile(path, ok)
    ret ok and compress.BufEquals(got, want)
end

func main:
    text := gen_text(60, 3)

    println "== zips made by other tools =="
    read_case("Info-ZIP bzip2", Z_INFOZIP_BZ2, "a/data.txt", text)
    read_case("7-Zip bzip2", Z_7Z_BZ2, "a/data.txt", text)
    read_case("7-Zip LZMA", Z_7Z_LZMA, "a/data.txt", text)
    read_case("Python bzip2", Z_PY_BZ2, "a/data.txt", text)
    read_case("Python LZMA", Z_PY_LZMA, "a/data.txt", text)
    read_case("Python zstd", Z_PY_ZSTD, "a/data.txt", text)

    println "== zips made here =="
    create_case("stored", 0, 0, text, "")
    create_case("deflate", 8, 0, text, "")
    create_case("bzip2", 12, 0, text, Z_OURS_12)
    create_case("lzma", 14, 0, text, Z_OURS_14)
    create_case("zstd", 93, 0, text, Z_OURS_93)
    create_case("bzip2", 12, 1, text, "")
    create_case("lzma", 14, 9, text, "")
    create_case("zstd", 93, 19, text, "")
    create_case("zstd", 93, 1, text, "")
    create_case("unknown method 99", 99, 0, text, "")
    create_case("method 9 asked for", 9, 0, text, "")
    big := gen_text(5000, 11)
    create_case("big bzip2", 12, 0, big, "")
    create_case("big lzma", 14, 0, big, "")
    create_case("big zstd", 93, 0, big, "")
    println "method codes", archive.ZipMethodStore, archive.ZipMethodDeflate, archive.ZipMethodBzip2, archive.ZipMethodLzma, archive.ZipMethodZstd

    println "== damage =="
    z := unhex(Z_OURS_14)
    mut checked := 0
    mut st := 0
    mut k := 0
    mut bad := 0
    until k < z.len:
        mut m := compress.BufClone(z)
        compress.BufSet(m, k, compress.BufGet(m, k) ^ 0x40)
        mut es := archive.ZipList(m.data, m.len)
        if es.Len() > 0:
            r := archive.ZipVerify(m.data, m.len, checked)
            if r != 0:
                bad++
            end
        end
        archive.FreeEntries(es)
        k += 3
    end
    println "lzma file, changed bytes caught:", bad > 20
    d := archive.ZipExtractVerified(unhex(Z_OURS_14).data, 503, "a/data.bin", 100, st)
    println "limit 100", st, d.len
    d2 := archive.ZipExtractVerified(unhex(Z_OURS_93).data, 536, "a/data.bin", 100, st)
    println "limit 100 zstd", st, d2.len
    d3 := archive.ZipExtractVerified(unhex(Z_OURS_12).data, 541, "a/data.bin", 100, st)
    println "limit 100 bzip2", st, d3.len
    mut zz := unhex(Z_OURS_93)
    compress.BufSet(zz, 40, compress.BufGet(zz, 40) ^ 255)
    d4 := archive.ZipExtractVerified(zz.data, zz.len, "a/data.bin", 0, st)
    println "zstd data changed", st, d4.len
    mut zb := unhex(Z_OURS_12)
    compress.BufSet(zb, 60, compress.BufGet(zb, 60) ^ 255)
    d5 := archive.ZipExtractVerified(zb.data, zb.len, "a/data.bin", 0, st)
    println "bzip2 data changed", st, d5.len

    println "== files on disk =="
    root := filepath.Join(os.TempDir(), "salam_zip_methods_test")
    os.RemoveAll(root)
    os.MkdirAll(root)
    file_case("bzip2", unhex(Z_OURS_12), "a/data.bin", text, root)
    file_case("lzma", unhex(Z_OURS_14), "a/data.bin", text, root)
    file_case("zstd", unhex(Z_OURS_93), "a/data.bin", text, root)
    file_case("python lzma", unhex(Z_PY_LZMA), "a/data.txt", text, root)
    os.RemoveAll(root)
end
