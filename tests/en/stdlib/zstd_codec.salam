d58055075c1ba02c063710c03950d5c1561668262c6d000401ae01351b20d80b4124f44d0317c12a0b2244c24c03de0b
48c380df087457009770600b3205423c006701aa7302738355006a0a7802807880d5024e6bc025c055092c03311a86b0
20854161067c06b82e783140c032642c039c06d88701a901a7010dbb70b206e41ce80960e1001e8eeab000060d58bd0c
2b04981610b0c6d5cc0035860805981ae055015207331b5025ceb5e38e012b1cc06cf0a3006303a60c78368889415712
7a0af03ad084035aad90d08057d8b055f9cf03a8ec3eaa85114a1d5eb8b911
"""

const WORDS := ["salam", "compress", "zstd", "lzma", "archive", "the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog", "stream", "block", "index"]

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func lcg(x: i64): i64:
    ret (x * 1103515245 + 12345) & 0x7fffffff
end

func gen_text(n: int, seed: i64): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = lcg(x)
        w := WORDS[((x >> 8) % 16) as int]
        compress.BufPushBytes(out, w as void*, w.Len())
        if ((x >> 4) & 7) == 0:
            compress.BufPush(out, 10)
        else:
            compress.BufPush(out, 32)
        end
    end
    ret out
end

func gen_mix(n: int, seed: i64, mask: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = lcg(x)
        compress.BufPush(out, ((x >> 12) & mask) as int)
    end
    ret out
end

func gen_skew(n: int, seed: i64): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut x := seed
    repeat n:
        x = lcg(x)
        r := (x >> 10) % 100
        mut c := 97 + ((x >> 4) % 26)
        if r < 40:
            c = 97
        else r < 60:
            c = 98
        else r < 75:
            c = 99
        else r < 85:
            c = 100
        end
        compress.BufPush(out, c as int)
    end
    ret out
end

func gen_big(): compress.ByteBuf:
    mut out := gen_text(800, 7)
    repeat 5000:
        compress.BufPushBytes(out, "abcdefgh12345678" as void*, 16)
    end
    repeat 140000:
        compress.BufPush(out, 0)
    end
    t2 := gen_text(300, 9)
    compress.BufPushBuf(out, t2)
    ret out
end

func same(label: str, ok: bool, got: compress.ByteBuf, want: compress.ByteBuf):
    println label, ok and compress.BufEquals(got, want), got.len
end

func dec_case(label: str, hex: str, want: compress.ByteBuf):
    packed := unhex(hex)
    mut ok := false
    got := compress.ZstdDecompress(packed.data, packed.len, ok)
    same(label, ok, got, want)
end

func status_of(packed: compress.ByteBuf, max: int): int:
    mut st := 0
    got := compress.ZstdDecompressEx(packed.data, packed.len, max, null, 0, st)
    if st == compress.ZstdOk:
        ret got.len
    end
    ret 0 - st
end

func round_trip(label: str, data: compress.ByteBuf, level: int):
    packed := compress.ZstdCompressLevel(data.data, data.len, level)
    mut ok := false
    got := compress.ZstdDecompress(packed.data, packed.len, ok)
    println label, level, ok and compress.BufEquals(got, data), packed.len < data.len
end

func main:
    t := gen_text(200, 5)
    big := gen_big()
    mix := gen_mix(6000, 3, 7)
    skew := gen_skew(5000, 11)
    random := gen_mix(3000, 13, 255)
    mut same_byte := compress.NewByteBuf()
    repeat 5000:
        compress.BufPush(same_byte, 65)
    end
    mut ok := false

    println "== reference zstd output =="
    dec_case("text -1", Z_TEXT_1, t)
    dec_case("text -3", Z_TEXT_3, t)
    dec_case("text -19", Z_TEXT_19, t)
    dec_case("text from a pipe (no size)", Z_TEXT_STREAM, t)
    dec_case("text --no-check", Z_TEXT_NOCHECK, t)
    dec_case("text --ultra -22", Z_TEXT_ULTRA, t)
    dec_case("text --fast=3", Z_TEXT_FAST, t)
    dec_case("three blocks -3", Z_BIG_3, big)
    dec_case("three blocks -19 from a pipe", Z_BIG_STREAM_19, big)
    dec_case("small alphabet -3", Z_MIX_3, mix)
    dec_case("small alphabet -19", Z_MIX_19, mix)
    dec_case("skewed letters -3", Z_SKEW_3, skew)
    dec_case("skewed letters from a pipe -1", Z_SKEW_STREAM_1, skew)
    dec_case("random bytes (raw blocks)", Z_RANDOM, random)
    dec_case("one repeated byte (RLE)", Z_SAME, same_byte)

    println "== frames made by hand =="
    empty := compress.NewByteBuf()
    dec_case("raw block", "28b52ffd2005290000" + "68656c6c6f", compress.BufFromStr("hello"))
    dec_case("RLE block", "28b52ffd20052b000078", compress.BufFromStr("xxxxx"))
    dec_case("empty frame", "28b52ffd2000010000", empty)
    dec_case("empty frame with checksum", "28b52ffd240001000099e9d851", empty)
    dec_case("window descriptor, no size", "28b52ffd0050290000" + "68656c6c6f", compress.BufFromStr("hello"))

    println "== several frames and skippable frames =="
    mut joined := unhex(Z_TEXT_3)
    skip := unhex("502a4d1805000000" + "0102030405")
    compress.BufPushBuf(joined, skip)
    p2 := unhex(Z_SAME)
    compress.BufPushBuf(joined, p2)
    mut want2 := compress.BufClone(t)
    compress.BufPushBuf(want2, same_byte)
    got2 := compress.ZstdDecompressBuf(joined, ok)
    same("frame, skippable, frame", ok, got2, want2)
    only_skip := unhex("5f2a4d1800000000")
    got3 := compress.ZstdDecompressBuf(only_skip, ok)
    println "only a skippable frame", ok, got3.len

    println "== dictionaries =="
    dict := unhex(Z_DICT)
    rawdict := gen_text(60, 321)
    dt := gen_text(30, 999)
    for_dict := unhex(Z_DICT_FRAME)
    got4 := compress.ZstdDecompressDict(for_dict.data, for_dict.len, dict.data, dict.len, ok)
    same("trained dictionary -3", ok, got4, dt)
    for_dict19 := unhex(Z_DICT_FRAME_19)
    got5 := compress.ZstdDecompressDict(for_dict19.data, for_dict19.len, dict.data, dict.len, ok)
    same("trained dictionary -19", ok, got5, dt)
    for_raw := unhex(Z_RAWDICT_FRAME)
    got6 := compress.ZstdDecompressDict(for_raw.data, for_raw.len, rawdict.data, rawdict.len, ok)
    same("raw content dictionary", ok, got6, dt)
    mut st := 0
    got7 := compress.ZstdDecompressEx(for_dict.data, for_dict.len, 0, null, 0, st)
    println "dictionary missing", st, compress.ZstdStatusText(st), got7.len
    got8 := compress.ZstdDecompressEx(for_dict.data, for_dict.len, 0, rawdict.data, rawdict.len, st)
    println "wrong dictionary", st, got8.len
    got9 := compress.ZstdDecompressEx(for_raw.data, for_raw.len, 0, dict.data, dict.len, st)
    println "raw dictionary frame with a trained dictionary", st, got9.len

    println "== limits and damage =="
    good := unhex(Z_TEXT_3)
    println "status of a good frame", status_of(good, 0)
    println "limit equal to the size", status_of(good, t.len)
    println "limit one byte short", status_of(good, t.len - 1)
    println "negative limit", status_of(good, -1)
    println "limit on a stream without a size", status_of(unhex(Z_TEXT_STREAM), 100)
    println "limit on RLE", status_of(unhex(Z_SAME), 4999)
    println "limit on three blocks", status_of(unhex(Z_BIG_3), 200000)
    println "empty input", status_of(empty, 0)
    println "three bytes", status_of(unhex("28b52f"), 0)
    println "bad magic", status_of(unhex("29b52ffd2000010000"), 0)
    println "reserved bit set", status_of(unhex("28b52ffd2800010000"), 0)
    println "reserved block type", status_of(unhex("28b52ffd2000070000"), 0)
    println "window too large", status_of(unhex("28b52ffd00ff290000" + "68656c6c6f"), 0)
    println "size field disagrees", status_of(unhex("28b52ffd2006290000" + "68656c6c6f"), 0)
    println "raw block cut short", status_of(unhex("28b52ffd2005290000" + "68656c"), 0)
    println "trailing garbage", status_of(unhex("28b52ffd2000010000" + "ff"), 0)
    println "skippable frame cut short", status_of(unhex("502a4d18ff000000" + "00"), 0)
    mut flip := unhex(Z_TEXT_3)
    compress.BufSet(flip, flip.len - 1, compress.BufGet(flip, flip.len - 1) ^ 1)
    println "checksum flipped", status_of(flip, 0)
    mut cut := 1
    mut cut_ok := 0
    until cut < good.len:
        mut part := compress.NewByteBufCap(cut)
        compress.BufPushBytes(part, good.data, cut)
        if status_of(part, 0) > 0:
            cut_ok++
        end
        cut += 7
    end
    println "truncated copies accepted", cut_ok
    mut hits := 0
    mut accepted := 0
    repeat good.len in i:
        mut mutated := compress.BufClone(good)
        compress.BufSet(mutated, i, compress.BufGet(mutated, i) ^ 0x55)
        if status_of(mutated, 100000) > 0:
            accepted++
        end
        hits++
    end
    println "single byte changes", hits, "accepted", accepted
    println compress.IsZstd(good.data, good.len), compress.IsZstd(skip.data, skip.len), compress.IsZstd(empty.data, empty.len), compress.IsZstd("PK\x03\x04" as void*, 4)
    println compress.ZstdStatusText(compress.ZstdErrFormat), "|", compress.ZstdStatusText(compress.ZstdErrChecksum), "|", compress.ZstdStatusText(99)

    println "== content size =="
    println compress.ZstdContentSize(good.data, good.len), compress.ZstdContentSize(unhex(Z_TEXT_STREAM).data, 20), compress.ZstdContentSize(unhex(Z_BIG_3).data, 40), compress.ZstdContentSize(empty.data, 0)

    println "== xxh64 =="
    println compress.XXH64Str("") == (0xef46db3751d8e999 as u64), compress.XXH64Str("abc") == (0x44bc2cf5ad770999 as u64)
    sums := [1770697714, 2860822014, 2127448296, 1127656488, 3228900281, 2128411440, 3555499798, 1299609460, 749844724, 2074167724]
    lens := [1, 7, 8, 31, 32, 33, 63, 64, 100, 1000]
    mut matches := 0
    repeat 10 in i:
        d := gen_mix(lens[i], 5, 255)
        h := compress.XXH64Buf(d) & (0xFFFFFFFF as u64)
        if h == (sums[i] as u64):
            matches++
        end
    end
    println "low 32 bits equal to the zstd checksum for 10 lengths:", matches
    println compress.XXH64Str("Salam") != compress.XXH64("Salam" as void*, 5, 1 as u64)

    println "== encoder =="
    round_trip("text", t, 1)
    round_trip("text", t, 3)
    round_trip("text", t, 9)
    round_trip("text", t, 19)
    round_trip("text", t, 22)
    round_trip("three blocks", big, 3)
    round_trip("three blocks", big, 12)
    round_trip("small alphabet", mix, 1)
    round_trip("small alphabet", mix, 19)
    round_trip("skewed letters", skew, 3)
    round_trip("skewed letters", skew, 15)
    round_trip("random bytes", random, 3)
    round_trip("one repeated byte", same_byte, 3)
    round_trip("empty", empty, 3)
    one := compress.BufFromStr("z")
    round_trip("one byte", one, 3)
    round_trip("stored", t, 0)
    round_trip("stored", big, -5)
    stored := compress.ZstdCompressLevel(t.data, t.len, 0)
    println "stored overhead", stored.len - t.len
    plain := compress.ZstdCompress(t.data, t.len)
    println "default level", plain.len, plain.len < t.len / 2
    nocheck := compress.ZstdCompressOpts(t.data, t.len, 3, false)
    println "without checksum is 4 bytes shorter", plain.len - nocheck.len
    got10 := compress.ZstdDecompressBuf(nocheck, ok)
    same("no checksum round trip", ok, got10, t)
    s_packed := compress.ZstdCompressStr("hello hello hello hello hello hello")
    got11 := compress.ZstdDecompressBuf(s_packed, ok)
    bufz := compress.ZstdCompressBuf(t)
    got12 := compress.ZstdDecompressMax(bufz.data, bufz.len, t.len, ok)
    same("buffer form and the exact limit", ok, got12, t)
    println "is zstd (buffer):", compress.IsZstdBuf(bufz), compress.IsZstdBuf(t)
    println "string round trip", ok, compress.BufToStrUnsafe(got11)
    println "content size of our frame", compress.ZstdContentSize(plain.data, plain.len), compress.ZstdContentSize(big.data, 0)
    bigz := compress.ZstdCompressLevel(big.data, big.len, 3)
    println "three blocks size", compress.ZstdContentSize(bigz.data, bigz.len), bigz.len < 4000
    println "same bytes as before", compress.BufEquals(plain, unhex(Z_OURS_TEXT_3))
    println "tiny frame", compress.BufEquals(compress.ZstdCompress("abc" as void*, 3), unhex("28b52ffd2403190000616263990977ad"))
    println "sizes", compress.ZstdCompressLevel(random.data, random.len, 3).len, compress.ZstdCompressLevel(same_byte.data, same_byte.len, 3).len

    println "== encoder output damaged =="
    mut mut_ok := 0
    repeat plain.len in i:
        mut mutated := compress.BufClone(plain)
        compress.BufSet(mutated, i, compress.BufGet(mutated, i) ^ 0x21)
        if status_of(mutated, 100000) > 0:
            mut_ok++
        end
    end
    println "accepted after a change", mut_ok
end
