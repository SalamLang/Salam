func arch_family(): str:
    switch SALAM_ARCH:
        "x64", "x86":
            ret "x86"
        end
        "arm64", "arm":
            ret "arm"
        end
        "wasm":
            ret "wasm"
        end
    end
    ret "other"
end

func main:
    println "os known:", SALAM_OS != ""
    println "windows flag agrees:", SALAM_OS_WINDOWS == (SALAM_OS == "windows")
    println "mac flag agrees:", SALAM_OS_MAC == (SALAM_OS == "mac")
    println "linux flag agrees:", SALAM_OS_LINUX == (SALAM_OS == "linux")
    family := arch_family()
    println "arch family known:", family != "other"
    unix_or_windows := SALAM_OS_UNIX || SALAM_OS_WINDOWS
    println "unix or windows:", unix_or_windows
    mut hits := 0
    repeat 3 with i:
        if SALAM_OS_WINDOWS || i >= 0:
            hits += 1
        end
    end
    println "runtime condition with a flag:", hits
end
