enum Shape:
    Circle, Square, Triangle
end

type Figure = Shape

func sides(s: Shape): int:
    switch s:
        Shape.Circle:
            ret 0
        end
        Shape.Square:
            ret 4
        end
        Shape.Triangle:
            ret 3
        end
    end
    ret 0 - 1
end

func round(f: Figure): bool:
    switch f:
        Figure.Circle:
            ret true
        end
        Shape.Square, Figure.Triangle:
            ret false
        end
    end
    ret false
end

func label(s: Shape): str:
    switch s:
        Shape.Circle:
            ret "circle"
        end
        else:
            ret "polygon"
        end
    end
    ret "?"
end

func main:
    println sides(Shape.Circle), sides(Shape.Square), sides(Figure.Triangle)
    println round(Figure.Circle), round(Shape.Square)
    println label(Shape.Circle), label(Figure.Triangle)
end
