func main:
    x := 2
    switch x:
        1:
            println "one"
        end
        2, 3:
            println "two or three"
            break
        end
        4:
            println "four (unreachable: prior case broke)"
        end
        else:
            println "other"
        end
    end

    // no break: execution falls through every case from the first match onward
    switch 1:
        1:
            println "fall-a"
        end
        2:
            println "fall-b"
        end
        else:
            println "fall-c"
        end
    end
end
