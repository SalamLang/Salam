const OP_ADD := 1
const OP_SUB := 2
const OP_NEG := -3
const OP_BIG := 5000000000 as i64

enum Dir:
    North, East, South, West
end

func run(op: int, x: int, y: int): int:
    switch op:
        OP_ADD:
            ret x + y
        end
        OP_SUB:
            ret x - y
        end
        OP_NEG:
            ret 0 - x
        end
        else:
            ret 0
        end
    end
end

func fall(n: int): str:
    mut s := ""
    switch n:
        1:
            s = s + "a"
        end
        2:
            s = s + "b"
            break
        end
        3:
            s = s + "c"
        end
    end
    ret s
end

func kind(c: char): str:
    switch c:
        'a', 'e', 'i', 'o', 'u':
            ret "vowel"
        end
        else:
            ret "other"
        end
    end
end

func turn(d: Dir): Dir:
    switch d:
        Dir.North:
            ret Dir.East
        end
        Dir.East:
            ret Dir.South
        end
        Dir.South:
            ret Dir.West
        end
        Dir.West:
            ret Dir.North
        end
    end
    ret Dir.North
end

func big(v: i64): str:
    switch v:
        OP_BIG:
            ret "big"
        end
        else:
            ret "small"
        end
    end
end

func main:
    println run(OP_ADD, 7, 5), run(OP_SUB, 7, 5), run(OP_NEG, 7, 5), run(9, 7, 5)
    println "[" + fall(1) + "]", "[" + fall(2) + "]", "[" + fall(3) + "]", "[" + fall(4) + "]"
    println kind('e'), kind('z')
    mut d := Dir.North
    mut steps := 0
    repeat 6 in i:
        d = turn(d)
        switch i:
            2:
                continue
            end
        end
        steps += 1
    end
    println d == Dir.South, steps
    println big(5000000000 as i64), big(5 as i64)
    mut total := 0 as i64
    repeat 100000 in k:
        total += run(k % 4, k, 3) as i64
    end
    println total
end
