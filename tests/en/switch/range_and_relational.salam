func main:
    switch 5:
        1 to 4:
            println "low"
        end
        5 to 9:
            println "mid"
            break
        end
        else:
            println "high"
        end
    end

    switch 20:
        > 10:
            println "big"
            break
        end
        else:
            println "small"
        end
    end

    switch 3:
        < 0:
            println "negative"
        end
        != 3:
            println "not three"
        end
        else:
            println "exactly three"
        end
    end
end
