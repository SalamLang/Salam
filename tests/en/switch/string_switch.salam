func main:
    name := "b"
    switch name:
        "a":
            println "letter a"
        end
        "b":
            println "letter b"
            break
        end
        "c":
            println "letter c"
        end
    end

    switch "zeta":
        "alpha" to "mike":
            println "early alphabet"
        end
        else:
            println "late alphabet"
        end
    end
end
