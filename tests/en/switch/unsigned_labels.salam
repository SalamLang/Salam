func classify(n: usize): str:
    switch n:
        0:
            ret "zero"
        end
        1, 2:
            ret "small"
        end
        3 to 9:
            ret "digit"
        end
        >= 1000:
            ret "huge"
        end
        else:
            ret "other"
        end
    end
end

func main:
    println classify(0 as usize)
    println classify(2 as usize)
    println classify(7 as usize)
    println classify(50 as usize)
    println classify((0 as usize) - (1 as usize))
    u := 200 as u8
    switch u:
        200:
            println "u8 ok"
            break
        end
        else:
            println "u8 bad"
        end
    end
    w := 5 as u64
    switch w:
        5:
            println "u64 ok"
        end
    end
end
