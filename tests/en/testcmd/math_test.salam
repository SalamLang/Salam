func add(a: int, b: int): int:
    ret a + b
end

func test_add():
    testing.AssertEqInt(add(2, 2), 4)
end

func test_add_negative():
    testing.AssertEqInt(add(0 - 2, 1), 0 - 1)
end

func test_broken():
    testing.AssertEqInt(add(2, 2), 5)
end
