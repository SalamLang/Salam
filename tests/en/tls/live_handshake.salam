// Live TLS 1.3 interop check.
//
// Known-answer vectors prove the primitives compute the right values. Only a
// real server proves the ClientHello is well formed, the transcript is fed the
// exact bytes, the key schedule agrees with someone else's implementation, and
// the record layer frames correctly.
//
// The badssl.com cases matter more than the successful fetches: a verifier that
// accepts everything passes every positive test. Each of those hosts serves a
// deliberately broken certificate and MUST be rejected.
//
// Requires network access, so it is not part of the offline vector suite.
//
//   salam build tests/en/tls/live_handshake.salam --output=/tmp/live && /tmp/live

package main

import tls
import os
import str
import io

