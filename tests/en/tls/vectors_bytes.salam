// std/tls known-answer self-tests.
//
// Must be run through the COMPILED backend (`salam build`), never `salam exec`:
// the interpreter does not implement unsigned wraparound and silently returns
// wrong answers for u32/u64 arithmetic, which would make every crypto vector
// here meaningless.

package main

import tls
import os

func main:
    os.Exit(tls.SelfTest())
end
