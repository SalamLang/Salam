// std/tls known-answer self-tests.
//
// HOW TO RUN -- both rules matter, and violating either produces a green result
// that means nothing:
//
//   rm -rf .salam-build
//   salam build tests/en/tls/vectors_bytes.salam --output=/tmp/tlstest
//   /tmp/tlstest        # exits 0 on success, else the failure count
//
//  1. Use the COMPILED backend. The interpreter now models integer width and
//     signedness correctly (u32/u64 wraparound, logical `>>`, unsigned `/`,
//     `%` and comparisons - see tests/en/exec/int_width_wrap.salam), so its
//     answers here are no longer wrong; it is simply far too slow for 282
//     crypto vectors and trips the interpreter's runaway-execution guard.
//  2. Clear `.salam-build` first. Its module cache has been observed serving a
//     stale `tls` object after the sources changed, so the suite reports on
//     code that is no longer on disk.
//
// The suite is a self-check, so treat it as one: after changing it, corrupt a
// single expected value on purpose and confirm the run reports exactly one
// failure and exits non-zero.

package main

import tls
import os

func main:
    os.Exit(tls.SelfTest())
end
