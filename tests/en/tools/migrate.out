== tests/en/tools/migrate_global.salam
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
page:
    title = "Global"
    font = system, sans margin = 1rem
    global: selector = ".note span" color = red end
    box:
        class = "note" color = #555
        button: padding = 4px, 12px radius = 6px content = "a" end
        button: padding = 4px, 12px radius = 6px content = "b" end
    end
end

