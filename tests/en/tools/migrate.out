== tests/en/tools/migrate_layout.salam
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

page:
    title = "Layout"
    box:
        class = "card" layout = column justify = between align = center gap = 12
        layout = row
        padding = 8px, 16px
        margin = 0, auto
        radius = 8px
        shadow = [0, 4px, 8px, rgb(0 0 0 / 25%)]
        font = "Tahoma", sans
        font size = 1.5rem
        width = 100%
        content = "x"
    end
end

exit 0
== tests/en/tools/migrate_text.salam
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

page:
    title = "Text"
    box: layer = 3 text align = "end" wrap text = false wrap = true grow = 1 shrink = 1 basis = auto transition = 0.2s, ease end
    box: cursor = pointer color = #333 italic = true decoration = strike end
    box: background = "var(--bg)" font size = "clamp(1rem, 4vw, 2rem)" layout = row end
end

