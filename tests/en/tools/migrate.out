صفحه:
    عنوان = "چیدمان"
    سراسری: گزینشگر = ".card" چیدمان = ستون چینش = میان تراز = وسط شکاف = 12 پایان
    جعبه:
        کلاس = "card"
        چیدمان = ردیف
        فضا = 8px، 16px
        گردی = 8px
        سایه = [0، 4px، 8px، "rgba(0، 0، 0، 0.25)"]
        قلم = "Tahoma"، ساده
        محتوا = "سلام"
    پایان
پایان

