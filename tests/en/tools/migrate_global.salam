page:
    title = "Global"
    global: selector = "body" font family = "system-ui, sans-serif" margin = "1rem" end
    global: selector = "button" padding = "4px 12px" border radius = 6px end
    global: selector = ".note" color = "#555" end
    global: selector = ".note span" color = red end
    box:
        class = "note"
        button: content = "a" end
        button: content = "b" end
    end
end
