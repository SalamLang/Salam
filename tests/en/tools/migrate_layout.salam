page:
    title = "Layout"
    global: selector = ".card" display = flex flex direction = column justify content = space-between align items = center gap = 12 end
    box:
        class = "card"
        display = flex
        padding = "8px 16px"
        margin = "0 auto"
        border radius = 8px
        box shadow = "0 4px 8px rgba(0, 0, 0, 0.25)"
        font family = "Tahoma, sans-serif"
        font size = "1.5rem"
        width = 100 %
        content = "x"
    end
end
