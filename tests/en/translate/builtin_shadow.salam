import mem

func atomic_add(a: i64, b: i64): i64:
    ret a + b + 1000
end

func strcmp(a: str, b: str): int:
    ret len(a) + len(b)
end

func main:
    println atomic_add(2 as i64, 3 as i64), strcmp("ab", "c")
    c := mem.AllocateZeroed(8 as u64) as i64*
    atomic_store(c, 41 as i64)
    println atomic_load(c), atomic_cas(c, 41 as i64, 42 as i64), atomic_load(c)
    mem.Free(c as void*)
end
