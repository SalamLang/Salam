import mem

link dynamic "m"

extern:
    func cos(x: f64): f64
end

mut g_cell := null as i64*

func work():
    atomic_add(g_cell, 1 as i64)
end

func main:
    g_cell = mem.AllocateZeroed(8 as u64) as i64*
    xs := [1, 2, 3]
    println len(xs), sizeof(i64), len("ab")
    println strcmp("a", "a"), char_code("A"), char_from_code(66)
    println lang() != "", env("SALAM_NOPE") == "", args().len() > 0
    if SALAM_OS_WINDOWS:
        println "win"
    else:
        println "other"
    end
    if defined(SALAM_OS_LINUX) or not defined(SALAM_OS_LINUX):
        println "def"
    end
    println SALAM_SAFE or not SALAM_SAFE
    println SALAM_ARCH_X64 or not SALAM_ARCH_X64, len(SALAM_VERSION) > 0
    t := spawn(work)
    join(t)
    println atomic_load(g_cell), cos(0.0), hash("x") > (0 as u64)
    mem.Free(g_cell as void*)
end
