const LIMIT := 3

func main:
    mut n := 0
    if SALAM_OS_WINDOWS:
        n = 1
    else n < LIMIT:
        n = 2
    end
    flag := n > 1 ? SALAM_SAFE or true : false
    until n < LIMIT:
        n += 1
    end
    println n, flag
end
