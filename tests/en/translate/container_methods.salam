package main

import matrix

struct Grid:
    pub cells: Vector<int>
    pub m: matrix.Matrix

    pub func done():
        this.cells.Free()
        this.m.Free()
    end
end

func trace(m: matrix.Matrix): f64:
    ret m.at(0, 0) + m.at(1, 1)
end

func drop(m: matrix.Matrix):
    mut owned := m
    owned.Free()
end

func main:
    mut v := Vector {} as Vector<int>
    v.Reserve(8)
    v.zeros(3)
    v.Set(1, 7)
    v.Push(9)
    println v.Get(1), v.Len(), v.IsEmpty()
    v.Clear()
    println v.Len(), v.IsEmpty()
    v.Free()
    mut h := HashMap {} as HashMap<str, int>
    h.Put("a", 1)
    println h.GetOr("a", 0), h.GetOr("b", 5), h.Size()
    h.Free()
    s := "Salam"
    println s.Lower(), s.Upper(), s.Repeat(2)
    mut total := 0
    each b in s.Bytes():
        total += b as int
    end
    println total
    mut m := matrix.Zeros(2, 2)
    m.Set(0, 0, 1.5)
    m.Set(1, 1, 2.5)
    println trace(m)
    mut g := Grid { cells = Vector {} as Vector<int>, m = matrix.Zeros(1, 1) }
    g.cells.Push(4)
    println g.cells.Len(), g.m.at(0, 0)
    g.done()
    drop(m)
end
