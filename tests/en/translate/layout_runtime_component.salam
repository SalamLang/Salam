component Card(title: str, n: int):
    box:
        padding = "8px"
        heading: size = 3 content = title end
        paragraph: content = "Count: " + n end
    end
end

layout Page(name: str):
    title = "Cards"
    Card: title = "Hello " + name n = 7 end
    Card: title = "Static" n = 1 end
end

func main:
    println Page("Sara")
    println Card("Alone", 3)
end
