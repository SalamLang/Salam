package main

import matrix

struct Bag:
    pub items: int = 0

    pub func clear(): int:
        ret this.items - this.items
    end

    pub func at(i: int): int:
        ret this.items + i
    end
end

func empty_bag(v: Bag): int:
    ret v.Clear() + v.at(1)
end

func bag_at(m: Bag): int:
    ret m.at(2)
end

func matrices():
    mut m := matrix.Zeros(2, 2)
    m.Set(0, 0, 2.5)
    owned := m // the same matrix
    println owned.at(0, 0)
    owned.Free()
end

func vectors():
    mut v := Vector {} as Vector<int>
    v.Push(1)
    v.Insert(0, 5)
    println v.Get(0), v.Len()
    mut other := v
    other.Clear()
    println other.Len()
    other.Free()
    mut h := HashMap {} as HashMap<str, int>
    h.Put("a", 1)
    h.Insert("b", 2)
    println h.Get("a"), h.Get("b"), h.Size()
    h.Free()
end

func main:
    println empty_bag(Bag { items = 3 }), bag_at(Bag { items = 4 })
    bag := Bag { items = 7 }
    twin := bag.Copy()
    println twin.at(0)
    matrices()
    vectors()
end
