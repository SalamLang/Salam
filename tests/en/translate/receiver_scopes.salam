package main

import matrix

struct Bag:
    pub items: int = 0

    pub func clear(): int:
        ret this.items - this.items
    end

    pub func at(i: int): int:
        ret this.items + i
    end
end

func empty_bag(v: Bag): int:
    ret v.clear() + v.at(1)
end

func bag_at(m: Bag): int:
    ret m.at(2)
end

func matrices():
    mut m := matrix.Zeros(2, 2)
    m.set(0, 0, 2.5)
    owned := m // the same matrix
    println owned.at(0, 0)
    owned.free()
end

func vectors():
    mut v := Vector {} as Vector<int>
    v.push(1)
    v.insert(0, 5)
    println v.get(0), v.Len()
    mut other := v
    other.clear()
    println other.Len()
    other.free()
    mut h := HashMap {} as HashMap<str, int>
    h.put("a", 1)
    h.insert("b", 2)
    println h.get("a"), h.get("b"), h.size()
    h.free()
end

func main:
    println empty_bag(Bag { items = 3 }), bag_at(Bag { items = 4 })
    bag := Bag { items = 7 }
    twin := bag.copy()
    println twin.at(0)
    matrices()
    vectors()
end
