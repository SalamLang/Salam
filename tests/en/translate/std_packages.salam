import str
import conv
import encoding.json
import net.httpx
import db
import db.elasticsearch

func main:
    println json.Valid(`{"a":[1,2]}`), json.GetPath(`{"a":[1,2]}`, "a.1")
    ep := httpx.ParseEndpoint("https://example.com:9243/x")
    println ep.host, ep.port, ep.secure
    println db.ELASTICSEARCH, str.FromInt(len("salam") as i64), conv.FormatBool(true)
    req := elasticsearch.SearchRequest { size = 2, query = elasticsearch.MatchAll() }
    println elasticsearch.SearchBody(req)
    aggs := `{"n":{"value":7.5}}`
    println elasticsearch.AggValueIn(aggs, "n")
    res := elasticsearch.ParseSearchResult(`{"took":1,"hits":{"total":{"value":2,"relation":"eq"},"hits":[{"_id":"a"},{"_id":"b"}]}}`)
    println res.total, res.hits.len(), res.hits.get(1).id
    println elasticsearch.DecodeCloudId("x:" + "aG9zdC5leGFtcGxlLmNvbTo5MjQzJGVzMSRraWI=")
    println char_code("A")
end
