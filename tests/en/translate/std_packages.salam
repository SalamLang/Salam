import str
import conv
import encoding.json
import net.http
import db
import db.sql

func main:
    println json.Valid(`{"a":[1,2]}`), json.GetPath(`{"a":[1,2]}`, "a.1")
    ep := http.ParseEndpoint("https://example.com:9243/x")
    println http.Host(ep), http.Port(ep), http.Secure(ep)
    println db.ELASTICSEARCH, str.FromInt(len("salam") as i64), conv.FormatBool(true)
    pg := sql.DialectNamed("postgres")
    println sql.ParamCount("SELECT a FROM t WHERE a = $1 AND b = $2", pg)
    marks := sql.Placeholders("SELECT a FROM t WHERE a = ? AND b = ?", sql.DialectNamed("mysql"))
    println marks.len(), marks.get(0)
    println char_code("A")
end
