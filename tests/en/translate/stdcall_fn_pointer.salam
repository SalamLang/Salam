if SALAM_OS_WINDOWS:
    extern:
        func GetModuleHandleA(name: str): void*
        func GetProcAddress(mod: void*, name: str): void*
    end

    func lookup(name: str): void*:
        ret GetProcAddress(GetModuleHandleA("kernel32.dll"), name)
    end
else:
    export:
        func sfp_muldiv(a: int, b: int, c: int): int:
            ret a * b / c
        end

        func sfp_sleep(ms: int):
            _ms := ms
        end
    end

    func lookup(name: str): void*:
        if name == "MulDiv":
            ret &sfp_muldiv
        end
        ret &sfp_sleep
    end
end

func work(n: int, seed: int, md: extern stdcall func (int, int, int) int, nap: extern stdcall func (int)): int:
    mut a := seed
    mut b := seed * 3 + 1
    mut c := seed * 7 + 2
    repeat n in i:
        nap(0)
        a += md(i, 6, 3)
        b ^= (a + i)
        c += b % 13
    end
    ret a + b + c
end

func main:
    md := lookup("MulDiv") as extern stdcall func (int, int, int) int
    nap := lookup("Sleep") as extern stdcall func (int)
    mut total := 0
    mut check := 0
    repeat 20 in k:
        total += work(50, k, md, nap) % 1000
        check += md(k + 1, 10, 5)
    end
    println "total", total, "check", check
    ret 0
end
