struct S:
    pub a: int = 0
    pub b: int = 0
    pub key: str = ""
    pub secret: str = ""
    pub type: str = "x"
    rule a needs b
    rule allornone(key, secret)
    rule oneof(a, secret)
    rule a == 5 needs key
    rule type == "y" needs key
end

func rule(x: int): int:
    ret x + 1
end

func main:
    println rule(1)
    s := S { secret = "s", key = "k", b = 3 }
    println s.b
end
