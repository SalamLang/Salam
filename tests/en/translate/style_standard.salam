page Card(n: int):
    box:
        content = "card " + n
        shadow = [0, 4, 8, black], [0, 1, 2, red]
        backdrop blur = 4
        cursor = pointer
        font weight = black
        hover color = blue
    end
end

func main:
    println Card(1)
end
