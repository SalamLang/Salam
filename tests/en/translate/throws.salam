func parse_port(text: str): int throw:
    if text == "":
        throw Error.New(ErrorKind.InvalidArgument, "empty port")
    end
    n := text.ToInt()
    if n > 65535:
        throw Error.At(ErrorKind.OutOfRange, "port too large", 0).WithCode("port.range")
    end
    ret n
end

func main:
    each text in ["80", "", "70000"]:
        try:
            println parse_port(text)
        catch e:
            println e.message, e.code, e.is(ErrorKind.OutOfRange)
            println e.Wrap("reading the config").ToStr()
        end
    end
    made := Error.New(ErrorKind.NotFound, "no such file")
    placed := made.WithPosition(4, 2, 3)
    println placed.line, placed.column, placed.KindName()
    port := try parse_port("") catch 8080
    println port
end
