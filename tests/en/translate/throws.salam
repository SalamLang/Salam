func parse port(text: str): int throws:
    if text == "":
        throw Error.New(ErrorKind.InvalidArgument, "empty port")
    end
    n := text.to_int()
    if n > 65535:
        throw Error.At(ErrorKind.OutOfRange, "port too large", 0).with_code("port.range")
    end
    ret n
end

func main:
    each text in ["80", "", "70000"]:
        try:
            println parse port(text)
        catch e:
            println e.message, e.code, e.is(ErrorKind.OutOfRange)
            println e.wrap("reading the config").to_str()
        end
    end
    made := Error.New(ErrorKind.NotFound, "no such file")
    placed := made.with_position(4, 2, 3)
    println placed.line, placed.column, placed.kind_name()
    port := try parse port("") catch 8080
    println port
end
