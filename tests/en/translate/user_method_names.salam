package main

interface Valued:
    func value(): int
end

struct Box:
    pub v: int = 0

    pub func value(): int:
        ret this.v
    end

    pub func len(): int:
        ret this.v + 1
    end

    pub func double(): int:
        ret this.value() * 2
    end
end

func show(x: dyn Valued):
    println x.value()
end

pub func free(n: int): int:
    ret n + 1
end

func main:
    b := Box { v = 3 }
    println b.value()
    println b.Len()
    println b.double()
    mut items := Vector {} as Vector<int>
    items.push(1)
    println items.Len()
    items.Free()
    text := "abc"
    println text.Len()
    println free(1)
    show(b as dyn Valued)
end
