page Page(name: str):
    box:
        padding = 8, 16
        border = 2, solid, #3366aa
        box shadow = [0, 4, 8, black], [0, 1, 2, red]
        width = 50%
        content = "Hi " + name
    end
end

func main:
    println Page("Sara")
    println 25% + 0.5, #fff
end
