struct P:
    pub x: int = 0
    pub y: int = 0
end

func same(a: int[3], b: int[3]): bool:
    ret a == b
end

func main:
    a := [1, 2, 3, 4]
    b := [1, 2, 3, 4]
    mut c := [1, 2, 3, 4]
    c[3] = 9
    println a == b, a != b, a == c, a != c
    g := [[1, 2], [3, 4]]
    h := [[1, 2], [3, 5]]
    println g == g, g == h
    ps := [P { x = 1 }, P { y = 2 }]
    qs := [P { x = 1 }, P { y = 2 }]
    println ps == qs
    names := ["ali", "sara"]
    println names == ["ali", "sara"], names == ["ali", "reza"]
    println same([1, 2, 3], [1, 2, 3])
    fs := [1.5, 2.5]
    println fs == [1.5, 2.5]
end
