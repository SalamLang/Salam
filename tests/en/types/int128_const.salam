const TOP := 1 as u128 << 127
const THIRD := TOP / 3
const REST := TOP % 7
const FLIP := ~TOP
const SIGNED_MIN := -170141183460469231731687303715884105728 as i128
const SIGNED_MAX := 170141183460469231731687303715884105727 as i128
const HALF := SIGNED_MIN / 2
const NEG_REM := (-7 as i128) % 3
const ASHR := SIGNED_MIN >> 126
const LSHR := TOP >> 126
const CMP_U := TOP > (1 as u128)
const CMP_S := SIGNED_MIN < (1 as i128)
const EQ := SIGNED_MAX == SIGNED_MAX
const WRAP_U := (0 as u128) - 1
const MUL_U := (1 as u128 << 64) * (1 as u128 << 63)
const MUL_S := (1 as i128 << 62) * -2
const MIX := (5 as i64) as i128 + (1 as i128 << 70)
const LOW := ((1 as u128 << 64) + 5) as i32
const FLOATED := (1 as u128 << 100) as f64
const FROM_FLOAT := 1.0e30 as i128
const PICK := EQ ? TOP : 0 as u128
const CHAIN := THIRD + REST + 1
mut g_table := [1 as u128 << 127, ~(1 as u128 << 127), (1 as u128 << 127) / 3]
mut g_signed := SIGNED_MIN

func main:
    println TOP, THIRD, REST
    println FLIP, SIGNED_MIN, SIGNED_MAX
    println HALF, NEG_REM, ASHR, LSHR
    println CMP_U, CMP_S, EQ
    println WRAP_U, MUL_U, MUL_S
    println MIX, LOW, FLOATED, FROM_FLOAT
    println PICK, CHAIN
    println g_table[0], g_table[1], g_table[2], g_signed
    g_signed += 1
    println g_signed
    local := TOP - 1
    println local, local == SIGNED_MAX as u128
end
