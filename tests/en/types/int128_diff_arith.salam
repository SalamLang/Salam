func show_u(x: u128, y: u128):
    println x + y, x - y, x * y
    println x & y, x | y, x ^ y
    println ~x, -x
    println x == y, x != y, x < y, x <= y, x > y, x >= y
    if y != 0:
        println x / y, x % y
    end
end

func show_i(x: i128, y: i128):
    println x + y, x - y, x * y
    println x & y, x | y, x ^ y
    println ~x, -x
    println x == y, x != y, x < y, x <= y, x > y, x >= y
    if y != 0:
        println x / y, x % y
    end
end

