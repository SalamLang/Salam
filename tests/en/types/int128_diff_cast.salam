func from_u(x: u128):
    println x as i8, x as i16, x as i32, x as u8, x as u16, x as u32
    println x as i128, x as bool
end

func from_i(x: i128):
    println x as i8, x as i16, x as i32, x as u8, x as u16, x as u32
    println x as u128, x as bool
end

func widen(a: i8, b: i16, c: i32, d: u8, e: u16, f: u32):
    println a as i128, b as i128, c as i128, d as i128, e as i128, f as i128
    println a as u128, b as u128, c as u128, d as u128, e as u128, f as u128
end

func main:
    from_u(0 as u128)
    from_i(0 as i128)
    from_u(1 as u128)
    from_i(1 as i128)
    from_u(127 as u128)
    from_i(127 as i128)
    from_u(128 as u128)
    from_i(128 as i128)
    from_u(255 as u128)
    from_i(255 as i128)
    from_u(256 as u128)
    from_i(256 as i128)
    from_u(32767 as u128)
    from_i(32767 as i128)
    from_u(32768 as u128)
    from_i(32768 as i128)
    from_u(65535 as u128)
    from_i(65535 as i128)
    from_u(65536 as u128)
    from_i(65536 as i128)
    from_u(2147483647 as u128)
    from_i(2147483647 as i128)
    from_u(2147483648 as u128)
    from_i(2147483648 as i128)
    from_u(4294967295 as u128)
    from_i(4294967295 as i128)
    from_u(4294967296 as u128)
    from_i(4294967296 as i128)
    from_u(9007199254740992 as u128)
    from_i(9007199254740992 as i128)
    from_u(170141183460469231731687303715884105727 as u128)
    from_i(170141183460469231731687303715884105727 as i128)
    from_u(170141183460469231731687303715884105728 as u128)
    from_i(-170141183460469231731687303715884105728 as i128)
    from_u(340282366920938463463374607431768211455 as u128)
    from_i(-1 as i128)
    from_u(295990755076957304699390954000840642031 as u128)
    from_i(-44291611843981158763983653430927569425 as i128)
    widen(-1 as i8, -1 as i16, -1 as i32, 255 as u8, 65535 as u16, 4294967295 as u32)
    widen(-128 as i8, -32768 as i16, -2147483648 as i32, 0 as u8, 0 as u16, 0 as u32)
    widen(127 as i8, 32767 as i16, 2147483647 as i32, 128 as u8, 32768 as u16, 2147483648 as u32)
end
