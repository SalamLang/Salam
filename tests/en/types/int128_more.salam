import mem
import core

const SCALE := 1000000000000000000000000 as i128

mut g_slot := Slot { v = 1 as u128 << 99 }

enum Tagged:
    Plain
    Big(v: u128)
    Pair(a: i128, b: i128)
end

interface Sized:
    func weight(extra: u128): u128
end

struct Slot:
    pub v: u128 = 0
    pub s: str = "x"
end

impl Sized on Slot:
    func weight(extra: u128): u128:
        ret this.v + extra
    end
end

struct Node:
    pub key: u128 = 0
    pub next: Node* = null
end

func apply(f: func (i128) i128, x: i128): i128:
    ret f(x)
end

func twice(x: i128): i128:
    ret x * 2
end

func defaulted(x: u128 = 340282366920938463463374607431768211455 as u128): u128:
    ret x
end

func describe(t: Tagged): str:
    ret match t:
        Tagged.Plain: "plain" end
        Tagged.Big(v): "big " + v end
        Tagged.Pair(a, b): "pair " + (a + b) end
    end
end

func either(flag: bool): u128 or str:
    if flag:
        x := 5 as u128
        ret x
    end
    ret "s"
end

func dyn_weight(d: dyn Sized): u128:
    ret d.weight(1 as u128 << 64)
end

func uses_ptr():
    p := mem.Allocate(sizeof(u128) * (4 as usize)) as u128*
    repeat 4 in i:
        p[i] = (i as u128 + 1) << 100
    end
    println p[3], p[2]
    mem.Free(p as void*)
end

func main:
    println describe(Tagged.Plain), describe(Tagged.Big(1 as u128 << 70)), describe(Tagged.Pair(-1, 1 as i128 << 80))
    println g_slot.v, g_slot.weight(1 as u128)
    println dyn_weight(g_slot)
    uses_ptr()
    println apply((x: i128): ret twice(x) end, SCALE), apply((x: i128): ret x - 1 end, SCALE)
    println defaulted(), defaulted(3 as u128)
    r := either(true)
    println match r:
        u128 v: "num " + v end
        str s: s end
    end
    h1 := mem.Allocate(sizeof(Node)) as Node*
    h1.key = 1 as u128 << 90
    h1.next = null
    n2 := Node { key = 2 as u128, next = h1 }
    println n2.next.key
    h1.key = 3 as u128
    println n2.next.key
    mem.Free(h1 as void*)
    arr := [Slot { v = 9 as u128 }, Slot { v = 8 as u128 }]
    println arr[1].v
    cp := arr[0]
    println cp.v == arr[0].v
    mut vs := Vector {} as Vector<Slot>
    vs.push(Slot { v = 1 as u128 << 127 })
    println vs.get(0).v
    mut rv := vs.ref(0)
    rv.v += 1
    println vs.get(0).v
    vs.free()
    o := core.Some(SCALE)
    println core.UnwrapOr(o, 0 as i128)
    mut total := 0 as i128
    fns := (d: i128):
        total += d
    end
    fns(SCALE)
    fns(SCALE)
    println total
    fx := 0.5 as f32
    println (fx as i128), (1.0e20 as f32) as u128
    println (SCALE as f32) == (SCALE as f64) as f32
    u16v := 65535 as u16
    println (u16v as u128) * (u16v as u128)
    println (true as u128) + (false as u128)
    c := 'A'
    println c as u128, (66 as u128) as char
    println (5 as i128) > (4 as i64) as i128
    mx := SCALE > 5 ? SCALE : 5
    println mx
    mut e := 0 as u128
    until e < 3 as u128:
        e++
    end
    println e
    defer println "done", SCALE
end
