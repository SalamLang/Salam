mut g := 1

func main:
    d := 0x80000000 as u32
    i := d as i32
    println i, i / (2 * g), i % (7 * g), i < 0, i >> (1 * g), i / 2, i % 7, i >> 1
    k := 4294967295 as u32
    j := k as i32
    println j, j >> (3 * g), j / (3 * g), j < 0, j * (2 * g), j >> 3, j / 3
    println k / 2, k % 10, k >> 4, k > (1 as u32), d / (3 as u32)
    b := 200 as u8
    sb := b as i8
    println sb, sb >> ((1 * g) as i8), sb / ((3 * g) as i8), sb < 0, sb >> 1, sb / 3, sb % 7
    println b / 3, b >> 1, b > (100 as u8), (sb as i32) * 2, (b as i32) * 2
    h := 40000 as u16
    sh := h as i16
    println sh, sh / 3, sh >> 2, sh % 1000, h / 3, h >> 2
end
