struct Pair<K, V>:
    pub a: K
    pub b: V
end

func show(d: Pair<Vector<Pair<str, int>>, bool>):
    println d.b, d.a.len()
    println d
end

func main:
    mut l := Vector {} as Vector<Pair<str, int>>
    l.push(Pair { a = "y", b = 2 } as Pair<str, int>)
    d := Pair { a = l, b = true } as Pair<Vector<Pair<str, int>>, bool>
    show(d)
end
