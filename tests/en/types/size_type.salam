 * Repository: https://github.com/SalamLang/Salam
 *
 */

struct Buf:
    pub cap: size = 0
    pub used: size = 0
end

func half(n: size): size:
    ret n / (2 as size)
end

func to_i(n: size): i64:
    ret n as i64
end

func main:
    a := 10 as size
    b := 3 as size
    println a
    println a + b
    println a - b
    println a * b
    println a / b
    println a % b
    println a > b
    println a == (10 as size)
    z := 0 as size
    wrap := z - (1 as size)
    println wrap
    println wrap > a
    println wrap / (2 as size)
    println wrap >> (60 as size)
    println (1 as size) << (40 as size)
    println half(a)
    println to_i(a)
    neg := -1
    println neg as size
    println wrap as i64
    println (a as i32) + 1
    println a as u64
    println a as f64
    println sizeof(i64)
    println sizeof(i64) * (2 as size)
    mut c := 0 as size
    c += 5 as size
    c -= 2 as size
    c *= 4 as size
    println c
    mut bf := Buf {}
    bf.cap = 64 as size
    bf.used = bf.cap - (1 as size)
    println bf.used
    mut v := Vector {} as Vector<size>
    v.push(7 as size)
    v.push(wrap)
    println v.get(0)
    println v.get(1)
    mut i := 0 as size
    mut total := 0 as size
    until i < (5 as size):
        total = total + i
        i = i + (1 as size)
    end
    println total
    arr := [1, 2, 3, 4]
    println arr[1 as size]
    switch a:
        10 as size:
            println "ten"
        end
        else:
            println "other"
        end
    end
    mut m := HashMap {} as HashMap<size, str>
    m.put(wrap, "max")
    println m.get(wrap)
end
