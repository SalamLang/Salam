page:
    title = "Counter app"
    count := 0
    header:
        background = #2563eb
        color = white
        padding = 24
        heading:
            size = 1
            content = "Counter app"
        end
    end
    box:
        padding = 20
        gap = 12
        paragraph:
            id = "text"
            content = "Count: " + count
        end
        button:
            id = "inc"
            background = #2563eb
            color = white
            padding = 10, 20
            hover background = #1d4ed8
            if count > 2:
                background = #16a34a
            end
            click = (): count++ println "count " + count end
            content = "Add one"
        end
    end
end
