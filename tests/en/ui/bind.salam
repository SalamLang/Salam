import gui.ui

mut name := ""
mut agree := false
mut form := Form { email = "" }
mut rows := [""]

struct Form:
    pub email: str
end

func clear():
    name = ""
    form.email = ""
end

func check():
    println "name [" + name + "], agree " + agree + ", email [" + form.email + "], row " + rows[0] + ", " + ui.ById("hello").Text() + ", field [" + ui.ById("name").Value() + "]"
end

page:
    title = "Bind"
    box:
        input: id = "name" bind = name end
        input: id = "agree" type = checkbox bind = agree end
        input: id = "email" type = "email" bind = form.email end
        input: id = "row" bind = rows[0] end
        paragraph: id = "hello" content = "Hello " + name end
        button: id = "clear" click = clear content = "Clear" end
        button: id = "check" click = check content = "Check" end
    end
end
