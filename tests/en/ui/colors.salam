mut clicks := 0

page:
    title = "Colors"
    box:
        id = "a"
        background = "light dark(#ffffff, #202020)"
        color = "oklch(0.5, 0.15, 250)"
        border color = "mix(red, blue, 50%)"
        content = "A"
    end
    box: id = "b" background = "light dark(white, #121212)" color = "light dark(black, white)" content = "B" end
    box: id = "c" color = "hsl(120, 100%, 25%)" border color = "lab(50, 20, -30)" content = "C" end
    box: id = "d" background = "color(display p3, 0.3, 0.6, 0.4)" color = "rgb(51, 102, 170)" content = "D" end
    button: id = "go" click = (): clicks++ println "clicked " + clicks end content = "Go" end
end
