mut clicks := 0

page:
    title = "Colors"
    global: selector = ":root" color scheme = "light dark" end
    box:
        id = "a"
        background color = "light-dark(#ffffff, #202020)"
        color = "oklch(0.5 0.15 250)"
        border = "2px solid color-mix(in oklab, red, blue)"
        content = "A"
    end
    box: id = "b" background color = "Canvas" color = "CanvasText" content = "B" end
    box: id = "c" color = "hsl(120 100% 25%)" border color = "lab(50 20 -30)" outline color = "currentColor" content = "C" end
    box: id = "d" background color = "color(display-p3 0.3 0.6 0.4)" color = "rgb(from #3366aa r g calc(b / 2))" content = "D" end
    button: id = "go" click = (): clicks++ println "clicked " + clicks end content = "Go" end
end
