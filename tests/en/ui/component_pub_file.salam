import gui.ui

mut hits := 0

func check():
    println ui.ById("hits").Text()
end

page:
    include = "_ui_vis.salam"
    box:
        Badge: name = "hits" value = hits end
        button: id = "hit" click = (): hits++ end content = "Hit" end
        button: id = "check" click = check content = "Check" end
    end
end
