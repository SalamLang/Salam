mut count := 0

func reset():
    count = 0
    println "reset to " + count
end

page:
    title = "Counter"
    box:
        heading: id = "label" content = "Count: " + count end
        button: id = "inc" click = (): count++ println "count is " + count end content = "+1" end
        button: id = "reset" click = reset content = "Reset" end
    end
end
