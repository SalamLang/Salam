mut shown := false

page:
    title = "Dialog"
    button:
        id = "outside"
        click = (): println "outside" end
        content = "Outside"
    end
    dialog:
        id = "a"
        open = true
        close = (): println "close a" end
        button:
            id = "inside"
            click = (): println "inside" end
            content = "Inside"
        end
    end
    button:
        id = "show"
        click = (): shown = true println "show" end
        content = "Show"
    end
    dialog:
        id = "c"
        open = shown
        close = (): shown = false println "close c" end
        paragraph:
            content = "third"
        end
    end
    dialog:
        id = "b"
        open = true
        close = (): println "close b" end
        paragraph:
            content = "second"
        end
    end
end
