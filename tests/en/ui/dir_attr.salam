import gui.ui

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func report():
    show("page_child")
    show("def")
    show("force_ltr")
    show("force_rtl")
    show("inner_in_ltr")
    show("auto_fa")
    show("auto_en")
    show("auto_fa_kid")
    show("auto_en_kid")
    show("style_dir")
    show("row1")
    show("row2")
end

page:
    title = "Dir"
    lang = "fa"
    box:
        id = "page_child"
        box:
            id = "def"
            width = 100
            height = 10
        end
        box:
            dir = "ltr"
            id = "force_ltr"
            box:
                id = "inner_in_ltr"
                width = 100
                height = 10
            end
        end
        box:
            dir = "rtl"
            id = "force_rtl"
            width = 300
            box:
                width = 100
                height = 10
            end
        end
        box:
            dir = "auto"
            id = "auto_fa"
            content = "سلام"
            box:
                id = "auto_fa_kid"
                width = 100
                height = 10
            end
        end
        box:
            dir = "auto"
            id = "auto_en"
            content = "hello"
            box:
                id = "auto_en_kid"
                width = 100
                height = 10
            end
        end
        box:
            id = "style_dir"
            direction = "ltr"
            box:
                width = 100
                height = 10
            end
        end
        box:
            layout = "row"
            id = "r"
            box:
                id = "row1"
                width = 60
                height = 10
            end
            box:
                id = "row2"
                width = 40
                height = 10
            end
        end
    end
    button:
        id = "report"
        click = report
        content = "Report"
    end
end
