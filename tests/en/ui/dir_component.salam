import gui.ui

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func report():
    show("plain")
    show("inside")
    show("auto_in")
end

component Slot(name: str):
    box:
        box:
            id = name
            width = 100
            height = 10
        end
    end
end

page:
    title = "Dir component"
    box:
        Slot:
            name = "plain"
        end
        box:
            dir = "rtl"
            Slot:
                name = "inside"
            end
        end
        box:
            dir = "auto"
            content = "سلام"
            Slot:
                name = "auto_in"
            end
        end
    end
    button:
        id = "report"
        click = report
        content = "Report"
    end
end
