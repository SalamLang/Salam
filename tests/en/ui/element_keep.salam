import gui.ui

mut ticks := 0
mut text := "old"
mut agree := false
mut rows := ["r1"]
mut note := "old"

func set():
    ui.ById("line").SetValue("mine")
    ui.ById("area").SetValue("mine")
    ui.ById("plain").SetChecked(true)
    ui.ById("fixed").SetChecked(false)
    ui.ById("linked").SetChecked(true)
    ui.ById("second").SetChecked(true)
    ui.ById("pick").SetValue("c")
end

func change():
    text = "new"
    agree = true
end

func back():
    agree = false
end

func hold():
    ui.ById("follow").SetValue("x")
end

func write():
    ui.ById("note-r1").SetValue("mine")
end

func rewrite():
    note = "newer"
end

func read():
    println "note " + ui.ById("note-r1").Value()
end

func empty():
    ui.ById("pick").SetValue("")
end

func picked():
    println "picked [" + ui.ById("pick").Value() + "]"
end

func show():
    println "ticks " + ticks + ", line " + ui.ById("line").Value() + ", area " +
        ui.ById("area").Value()
    println "plain",
        ui.ById("plain").Checked(),
        ui.ById("fixed").Checked(),
        ui.ById("linked").Checked(),
        ui.ById("first").Checked(),
        ui.ById("second").Checked()
    println "pick " + ui.ById("pick").Value() + ", follow " + ui.ById("follow").Value()
end

page:
    title = "Keep"
    box:
        input:
            id = "line"
            value = text
            title = "t" + ticks
        end
        input:
            id = "area"
            type = "textarea"
            value = text
            title = "t" + ticks
        end
        input:
            id = "plain"
            type = "checkbox"
            title = "t" + ticks
        end
        input:
            id = "fixed"
            type = "checkbox"
            checked = true
            title = "t" + ticks
        end
        input:
            id = "linked"
            type = "checkbox"
            checked = agree
            title = "t" + ticks
        end
        input:
            id = "first"
            type = "radio"
            name = "side"
            checked = true
            title = "t" + ticks
        end
        input:
            id = "second"
            type = "radio"
            name = "side"
            title = "t" + ticks
        end
        select:
            id = "pick"
            title = "t" + ticks
            option:
                value = "a"
                content = "A"
            end
            option:
                value = "b"
                selected = true
                content = "B"
            end
            option:
                value = "c"
                content = "C"
            end
        end
        select:
            id = "follow"
            title = "t" + ticks
            option:
                value = "x"
                content = "X"
            end
            option:
                value = "y"
                selected = agree
                content = "Y"
            end
        end
        paragraph:
            content = "ticks " + ticks
        end
    end
    list:
        each _, it in rows:
            item:
                key = it
                input:
                    id = "note-" + it
                    type = "textarea"
                    value = note
                end
            end
        end
    end
    button:
        id = "write"
        click = write
        content = "Write"
    end
    button:
        id = "rewrite"
        click = rewrite
        content = "Rewrite"
    end
    button:
        id = "read"
        click = read
        content = "Read"
    end
    button:
        id = "empty"
        click = empty
        content = "Empty"
    end
    button:
        id = "picked"
        click = picked
        content = "Picked"
    end
    button:
        id = "show"
        click = show
        content = "Show"
    end
    button:
        id = "set"
        click = set
        content = "Set"
    end
    button:
        id = "hold"
        click = hold
        content = "Hold"
    end
    button:
        id = "tick"
        click = (): ticks++ end
        content = "Tick"
    end
    button:
        id = "change"
        click = change
        content = "Change"
    end
    button:
        id = "back"
        click = back
        content = "Back"
    end
end
