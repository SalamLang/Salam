import gui.ui

mut hits := 0

func note(which: str):
    hits++
    println which + " " + hits
end

func open():
    note("open")
    ui.OpenUrl("#low")
end

func name():
    note("name")
end

func status():
    note("status")
end

func location():
    note("location")
end

func history():
    note("history")
end

func top():
    note("top")
end

func focus():
    note("focus")
    println "urls " + ui.OpenedUrls().Len()
end

func hooks():
    ui.OnPause((): note("pause") end)
    ui.KeyboardDismiss(true, false)
    ui.Invalidate()
    println "visible " + ui.WindowVisible() + " " + ui.ById("count").Text()
end

page:
    title = "Names"
    box:
        paragraph:
            id = "count"
            content = "hits " + hits
        end
        button:
            id = "b1"
            click = open
            content = "1"
        end
        button:
            id = "b2"
            click = name
            content = "2"
        end
        button:
            id = "b3"
            click = status
            content = "3"
        end
        button:
            id = "b4"
            click = location
            content = "4"
        end
        button:
            id = "b5"
            click = history
            content = "5"
        end
        button:
            id = "b6"
            click = top
            content = "6"
        end
        button:
            id = "b7"
            click = focus
            content = "7"
        end
        button:
            id = "b8"
            click = hooks
            content = "8"
        end
        paragraph:
            id = "low"
            content = "low"
        end
    end
end
