import gui.ui

mut ticks := 0
mut want := false

func tall(id: str): str:
    if ui.ById(id).Rect().height > 150.0:
        ret "open"
    end
    ret "shut"
end

func report():
    println "ticks " + ticks + ": user " + tall("user_box") + ", declared " + tall(
        "declared_box"
    ) + ", linked " + tall("linked_box") + ", modal " + tall("modal_box")
end

func loose():
    ui.ById("sel").SetValue("zz")
end

func force():
    ui.ById("modal_box").SetAttr("open", "true")
end

func picked():
    println "ticks " + ticks + ": sel [" + ui.ById("sel").Value() + "], listed [" +
        ui.ById("listed").Value() + "]"
end

page:
    title = "Open"
    box:
        button:
            id = "report"
            click = report
            content = "report"
        end
        button:
            id = "tick"
            click = (): ticks++ end
            content = "tick " + ticks
        end
        button:
            id = "flip"
            click = (): want = not want end
            content = "flip"
        end
        details:
            id = "user_box"
            summary:
                id = "user_sum"
                content = "user"
            end
            paragraph:
                id = "user"
                height = 200
                content = "user body " + ticks
            end
        end
        details:
            id = "declared_box"
            open = true
            summary:
                id = "declared_sum"
                content = "declared"
            end
            paragraph:
                id = "declared"
                height = 200
                content = "declared body " + ticks
            end
        end
        details:
            id = "linked_box"
            open = want
            summary:
                id = "linked_sum"
                content = "linked"
            end
            paragraph:
                id = "linked"
                height = 200
                content = "linked body " + ticks
            end
        end
        button:
            id = "force"
            click = force
            content = "force"
        end
        button:
            id = "loose"
            click = loose
            content = "loose"
        end
        button:
            id = "picked"
            click = picked
            content = "picked"
        end
        select:
            id = "sel"
            option:
                value = "a"
                content = "a"
            end
            option:
                value = "b"
                content = "b " + ticks
            end
        end
        select:
            id = "listed"
            size = 3
            option:
                value = "a"
                content = "a"
            end
            option:
                value = "b"
                selected = want
                content = "b " + ticks
            end
            option:
                value = "c"
                content = "c"
            end
        end
        dialog:
            id = "modal_box"
            open = want
            box:
                paragraph:
                    id = "modal"
                    height = 200
                    content = "modal body " + ticks
                end
                button:
                    id = "picked_inner"
                    click = picked
                    content = "picked"
                end
                button:
                    id = "inner_report"
                    click = report
                    content = "report"
                end
                button:
                    id = "inner_flip"
                    click = (): want = not want end
                    content = "flip"
                end
                button:
                    id = "inner_tick"
                    click = (): ticks++ end
                    content = "tick"
                end
            end
        end
    end
end
