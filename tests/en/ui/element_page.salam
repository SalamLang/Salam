import gui.ui

mut presses := 0
mut items := ["a", "b"]

func probe():
    fixed := ui.ById("fixed")
    name := ui.ById("name")
    agree := ui.ById("agree")
    println "exists",
        fixed.Exists(),
        ui.ById("nope").Exists(),
        ui.ByKey("b").Exists(),
        ui.ByKey("zz").Exists()
    println "tag", fixed.Tag(), ui.ById("wrap").Tag(), ui.ByKey("b").Tag(), name.Tag()
    println "text " + fixed.Text() + ", " + ui.ByKey("b").Text() + ", [" + ui.ById("nope").Text() +
        "]"
    fixed.SetText("changed")
    println "text " + fixed.Text()
    name.SetValue("Sam")
    println "value " + name.Value()
    println "checked", agree.Checked()
    agree.SetChecked(true)
    println "checked", agree.Checked()
    println "attr " + name.Attr("placeholder")
    name.SetAttr("placeholder", "name")
    println "attr " + name.Attr("placeholder")
    go := ui.ById("go")
    go.ScrollIntoView()
    r := go.Rect()
    println "rect", r.width > 0.0, r.height > 0.0
    go.Click()
    println "open", ui.OpenUrl("#go"), ui.OpenedUrls().Len()
    name.Focus()
end

func went():
    println "event " + ui.CurrentEvent().kind + " " + ui.CurrentEvent().target
end

func remove():
    println "value " + ui.ById("name").Value() + ", presses " + presses
end

func reset():
    presses = 0
end

page:
    title = "Element"
    box:
        id = "wrap"
        paragraph:
            id = "fixed"
            content = "fixed"
        end
        input:
            id = "name"
            placeholder = "who"
        end
        input:
            id = "agree"
            type = "checkbox"
        end
        list:
            each _, it in items:
                item:
                    key = it
                    content = "item " + it
                end
            end
        end
        paragraph:
            id = "count"
            content = "presses " + presses
        end
        button:
            id = "probe"
            click = probe
            content = "Probe"
        end
        button:
            id = "go"
            click = went
            content = "Go"
        end
        button:
            id = "press"
            click = (): presses++ end
            content = "Press"
        end
        button:
            id = "show"
            click = remove
            content = "Show"
        end
        button:
            id = "zero"
            click = reset
            content = "Zero"
        end
    end
end
