import gui.ui

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func report():
    show("cut")
    show("over")
end

page:
    title = "Ellipsis"
    box:
        paragraph:
            id = "cut"
            width = 120
            height = 30
            ellipsis = true
            content = "wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww"
        end
        paragraph:
            id = "over"
            width = 120
            height = 30
            wrap text = false
            content = "wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww"
        end
    end
    button:
        id = "report"
        click = report
        content = "Report"
    end
end
