page:
    title = "Hello"
    lang = "english"
    dir = "left to right"
    header:
        background = #2563eb
        color = "white"
        padding = 24px
        heading: size = 1 content = "Welcome" end
    end
    box:
        padding = 20px
        paragraph: id = "text" content = "Plain page with no main" end
        button: id = "go" click = (): println "clicked" end content = "Go" end
    end
end
