const BRAND := "#ff5c00"

page:
    title = "Env const"
    box:
        color = BRAND
        if compact:
            font size = 12
        end
        heading:
            id = "label"
            content = "constants first"
        end
        button:
            id = "say"
            click = (): println "ok" end
            content = "Say"
        end
    end
end
