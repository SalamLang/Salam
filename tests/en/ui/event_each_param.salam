import gui.ui

mut picked := ""
mut names := Vector {} as Vector<str>

func fill():
    names.Push("a")
    names.Push("b")
end

func check():
    println "picked " + picked
end

component item(name: str):
    box:
        button: id = "b-" + name click = (): picked = name end content = name end
    end
end

page:
    title = "Each parameter"
    box:
        button: id = "fill" click = fill content = "Fill" end
        button: id = "check" click = check content = "Check" end
        list:
            each n in names:
                item: name = n end
            end
        end
    end
end
