import gui.ui

mut saves := 0
mut seen := 0

func check():
    r := ui.ScopeRuns()
    println "runs " + (r - seen) + ", " + ui.ById("page").Text() + ", " + ui.ById("panel").Text() + ", " + ui.ById("bar").Text() + ", " + ui.ById("save").Text() + ", " + ui.ById("other").Text()
    seen = r
end

component Button(name: str):
    state presses := 0
    button: id = name click = (): presses++ emit("pressed", name) end content = name + " " + presses end
end

component Toolbar:
    state picked := "none"
    box:
        paragraph: id = "bar" content = "bar " + picked end
        Button: name = "save" on pressed = (n: str): picked = n end end
        Button:
            name = "quit"
            on pressed = (n: str):
                picked = n
                stop()
            end
        end
        Button: name = "help" end
    end
end

component Panel:
    state count := 0
    box:
        paragraph: id = "panel" content = "panel " + count end
        Toolbar: on pressed = (n: str): count++ println "panel got " + n end end
    end
end

component Other:
    state n := 0
    paragraph: id = "other" content = "other " + n end
end

page:
    title = "Events"
    on pressed = (n: str): saves++ println "page got " + n end
    paragraph: id = "page" content = "page " + saves end
    Panel: end
    Other: end
    button: id = "check" click = check content = "Check" end
end
