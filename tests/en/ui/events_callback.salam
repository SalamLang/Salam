import gui.ui

mut total := 0
mut seen := 0

func check():
    r := ui.ScopeRuns()
    println "runs " + (r - seen) + ", " + ui.ById("total").Text() + ", " + ui.ById("sum").Text() + ", " + ui.ById("a").Text() + ", " + ui.ById("b").Text() + ", " + ui.ById("solo").Text()
    seen = r
end

func record(v: int):
    println "record " + v
end

component Counter(name: str, change):
    state count := 0
    button: id = name click = (): count++ change(count) end content = name + " " + count end
end

component Pair(report: func (int)):
    state sum := 0
    box:
        paragraph: id = "sum" content = "sum " + sum end
        Counter:
            name = "a"
            change = (v: int):
                sum += v
                report(sum)
            end
        end
        Counter: name = "b" change = record end
    end
end

page:
    title = "Callbacks"
    paragraph: id = "total" content = "total " + total end
    Pair: report = (v: int): total = v end end
    Counter: name = "solo" end
    button: id = "check" click = check content = "Check" end
end
