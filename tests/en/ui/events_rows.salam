import gui.ui

mut groups := ["g1", "g2"]
mut rows := ["x", "y"]
mut picks := 0
mut seen := 0

func check():
    r := ui.ScopeRuns()
    println "runs " + (r - seen) + ", picks " + picks + ", " + ui.ById("g1").Text() + ", " + ui.ById("g2").Text()
    seen = r
end

component Row(group: str, name: str):
    hits := 0
    item: key = name id = group + "-" + name click = (): hits++ emit("picked", name + hits) end content = name + " " + hits end
end

component Group(name: str):
    picked := "-"
    box:
        id = name
        paragraph: content = name + " picked " + picked end
        list:
            each it in rows:
                Row: group = name name = it on picked = (v: str): picked = v end end
            end
        end
    end
end

page:
    title = "Rows"
    on picked = (): picks++ end
    each g in groups:
        Group: name = g end
    end
    button: id = "check" click = check content = "Check" end
end
