import gui.ui

mut picked := "none"

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func pick_g2():
    picked = "g2"
    println "picked g2"
end

func pick_c3():
    picked = "c3"
    println "picked c3"
end

func report():
    println "last picked " + picked
    show("grid")
    show("g1")
    show("g2")
    show("g3")
    show("g4")
    show("tab")
    show("c1")
    show("c2")
    show("c3")
    show("c4")
end

page:
    title = "Grid and table"
    box:
        id = "grid"
        layout = "grid"
        columns = 60, 1fr, 2fr
        gap = 4, 6
        width = 300
        box:
            id = "g1"
            height = 20
            column = 1
            column span = 2
            background = "teal"
        end
        box:
            id = "g2"
            height = 30
            row span = 2
            click = pick_g2
            background = "olive"
        end
        box:
            id = "g3"
            height = 10
            background = "navy"
        end
        box:
            id = "g4"
            height = 10
            background = "maroon"
        end
    end
    box:
        id = "tab"
        layout = "grid"
        columns = "auto", "auto", "auto"
        gap = 2
        box:
            id = "c1"
            width = 40
            height = 12
        end
        box:
            id = "c2"
            width = 70
            height = 20
            column span = 2
        end
        box:
            id = "c3"
            width = 10
            height = 10
            click = pick_c3
        end
        box:
            id = "c4"
            width = 30
            height = 10
        end
        box:
            width = 30
            height = 10
        end
    end
    button:
        id = "report"
        click = report
        content = "Report"
    end
end
