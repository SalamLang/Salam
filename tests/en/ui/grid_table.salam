import gui.ui

mut picked := "none"

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func pick_g2():
    picked = "g2"
    println "picked g2"
end

func pick_c3():
    picked = "c3"
    println "picked c3"
end

func report():
    println "last picked " + picked
    show("grid")
    show("g1")
    show("g2")
    show("g3")
    show("g4")
    show("tab")
    show("c1")
    show("c2")
    show("c3")
    show("c4")
end

page:
    title = "Grid and table"
    box:
        id = "grid"
        display = "grid"
        grid_template_columns = "60px 1fr 2fr"
        gap = "4px 6px"
        width = "300px"
        box: id = "g1" height = "20px" grid_column = "1 / 3" background = "teal" end
        box: id = "g2" height = "30px" grid_row = "span 2" click = pick_g2 background = "olive" end
        box: id = "g3" height = "10px" background = "navy" end
        box: id = "g4" height = "10px" background = "maroon" end
    end
    table:
        id = "tab"
        border_spacing = "2px"
        main:
            row:
                cell: id = "c1" padding = "0" box: width = "40px" height = "12px" end end
                cell: id = "c2" padding = "0" col_span = 2 box: width = "70px" height = "20px" end end
            end
            row:
                cell: id = "c3" padding = "0" click = pick_c3 box: width = "10px" height = "10px" end end
                cell: id = "c4" padding = "0" box: width = "30px" height = "10px" end end
                cell: padding = "0" box: width = "30px" height = "10px" end end
            end
        end
    end
    button: id = "report" click = report content = "Report" end
end
