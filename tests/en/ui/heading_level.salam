page:
    title = "Headings"
    heading: id = "one" content = "One" end
    heading: id = "two" size = 2 content = "Two" end
    heading: id = "three" level = 3 content = "Three" end
    h4: id = "four" content = "Four" end
    paragraph: id = "text" content = "Body" end
end
