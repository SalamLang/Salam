import gui.ui

func page(b: ui.Builder):
    b.Open("box")
    b.Id("root")
    b.Open("div")
    b.Id("bad")
    b.Open("button")
    b.Id("inner")
    b.Text("Hidden")
    b.Close()
    b.Close()
    b.Open("h2")
    b.Id("old")
    b.Text("Old")
    b.Close()
    b.Open("heading")
    b.Id("title")
    b.Attr("level", "2")
    b.Text("Title")
    b.Close()
    b.Open("جعبه")
    b.Id("fa")
    b.Close()
    b.Open("div")
    b.Close()
    b.Close()
end

func main:
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder): page(b) end)
end
