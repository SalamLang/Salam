mut picked := false
mut big := false

page:
    title = "If"
    button:
        id = "seg"
        background = "blue"
        color = "white"
        hover background = "navy"
        if picked:
            background = "orange"
            color = "black"
        end
        click = (): picked = not picked end
        content = "Seg"
    end
    button:
        id = "size"
        padding = 8
        if big:
            padding = 24
        end
        if picked and big:
            padding = 40
        end
        click = (): big = not big end
        content = "Size"
    end
    button:
        id = "alt"
        if big:
            color = "red"
        else if picked:
            color = "green"
        else:
            color = "gray"
        end
        content = "Alt"
    end
end
