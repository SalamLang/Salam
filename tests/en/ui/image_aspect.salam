import gui.ui

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.width, r.height
end

func report():
    show("natural")
    show("capped")
    show("tall")
    show("missing")
end

page:
    title = "Images"
    image:
        id = "natural"
        url = "tests/en/ui/wide.png"
    end
    image:
        id = "capped"
        url = "tests/en/ui/wide.png"
        max width = 30
    end
    image:
        id = "tall"
        url = "tests/en/ui/wide.png"
        height = 20
    end
    image:
        id = "missing"
        url = "tests/en/ui/none.png"
    end
    button:
        id = "report"
        click = report
        content = "Report"
    end
end
