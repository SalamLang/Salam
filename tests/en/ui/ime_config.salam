page:
    title = "Keyboard"
    form:
        submit = (): println "submit" end
        input:
            id = "user"
            enterkeyhint = "next"
            autocomplete = "username"
            autocapitalize = "off"
            placeholder = "User"
        end
        input:
            id = "pass"
            type = "password"
            enterkeyhint = "go"
            placeholder = "Password"
        end
    end
    input:
        id = "mail"
        type = "email"
    end
    input:
        id = "site"
        type = "url"
        enterkeyhint = "done"
    end
    input:
        id = "phone"
        type = "tel"
        autocomplete = "one-time-code"
    end
    input:
        id = "amount"
        type = "number"
    end
    input:
        id = "find"
        type = "search"
    end
    input:
        id = "pin"
        inputmode = "numeric"
        autocorrect = "off"
    end
    input:
        id = "none"
        inputmode = "none"
    end
    input:
        type = "textarea"
        id = "notes"
        autocapitalize = "words"
    end
end
