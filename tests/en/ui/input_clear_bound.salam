import gui.ui

mut draft := ""

func clear_it():
    draft = ""
end

func fill_it():
    draft = "abc"
end

func show():
    println "field [" + ui.ById("name").Value() + "] draft [" + draft + "]"
end

page:
    title = "Clear"
    box:
        input: id = "name" type = "text" value = draft input = (v: str):
            draft = v
        end end
        button: id = "clear" click = clear_it content = "Clear" end
        button: id = "fill" click = fill_it content = "Fill" end
        button: id = "show" click = show content = "Show" end
    end
end
