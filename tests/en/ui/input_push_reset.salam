import gui.ui

mut draft := ""
mut items: Vector<str>

func add():
    items.Push(draft)
    draft = ""
    println "items " + items.Len()
end

func show():
    println "first " + items[0]
    println "last " + items[items.Len() - 1]
end

page:
    title = "Push then reset"
    box:
        input: id = "name" type = "text" value = draft input = (v: str):
            draft = v
        end end
        button: id = "add" click = add content = "Add" end
        button: id = "show" click = show content = "Show" end
    end
end
