import gui.ui

mut note := ""

func check():
    area := ui.ById("note")
    month := ui.ById("month")
    println "note [" + note + "|" + area.Value() + "] hint " + area.Attr("placeholder")
    println "month [" + month.Value() + "] type " + month.Attr("type") + " tag " + month.Tag()
end

page:
    title = "Input types"
    box:
        input:
            id = "note"
            type = "textarea"
            rows = 3
            placeholder = "Write here"
            bind = note
        end
        input:
            id = "month"
            type = "month"
        end
        input:
            id = "widget"
            type = "my-widget"
        end
        button:
            id = "check"
            click = check
            content = "Check"
        end
    end
end
