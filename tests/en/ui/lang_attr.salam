import gui.ui

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func report():
    show("base")
    show("en_box")
    show("ar_box")
    show("nested")
    show("ltr_wins")
end

component Slot(name: str):
    box:
        id = name
        width = 100
        height = 10
    end
end

page:
    title = "Lang"
    lang = "fa"
    box:
        Slot:
            name = "base"
        end
        box:
            lang = "en"
            Slot:
                name = "en_box"
            end
        end
        box:
            lang = "ar"
            content = "text"
            Slot:
                name = "ar_box"
            end
        end
        box:
            lang = "fa"
            box:
                lang = "en"
                Slot:
                    name = "nested"
                end
            end
        end
        box:
            dir = "ltr"
            lang = "fa"
            Slot:
                name = "ltr_wins"
            end
        end
    end
    button:
        id = "report"
        click = report
        content = "Report"
    end
end
