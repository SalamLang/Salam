import gui.ui

mut count := 0

func main:
    ui.OnPause((): println "pause" end)
    ui.OnResume((): println "resume" end)
    ui.OnLowMemory((): println "low memory" end)
    ui.OnSaveState((): println "saving " + count ret "count=" + count end)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder): b.Open("button") b.Id("inc") b.On("click", (): count++ end) b.Text("+1") b.Close() end)
end
