import gui.ui

mut items := Vector {} as Vector<str>

func add():
    items.Push("task " + items.Len())
    println "items " + items.Len()
end

func check():
    if ui.ById("empty").Exists():
        println "empty shown: yes"
    else:
        println "empty shown: no"
    end
    println "row 2: " + ui.ById("row2").Text()
end

page:
    title = "List"
    box:
        button: id = "add" click = add content = "Add" end
        button: id = "check" click = check content = "Check" end
        if items.Len() == 0:
            paragraph: id = "empty" content = "Nothing yet" end
        end
        list:
            each i, it in items:
                item: id = "row" + i content = it color = i % 2 == 0 ? "crimson" : "navy" end
            end
        end
    end
end
