import gui.ui

mut names := Vector {} as Vector<str>

func fill():
    names.Push("a")
    names.Push("b")
end

func swap():
    first := names.Get(0)
    names.RemoveAt(0)
    names.Push(first)
end

func show():
    println ui.ById("t-a").Text() + ", " + ui.ById("t-b").Text()
end

component Counter(name: str):
    hits := 0
    item:
        id = "t-" + name
        content = name + " " + hits
        click = (): hits++ end
    end
end

page:
    box:
        button: id = "fill" click = fill content = "Fill" end
        button: id = "swap" click = swap content = "Swap" end
        button: id = "show" click = show content = "Show" end
        list:
            each _, it in names:
                Counter:
                    key = it
                    name = it
                end
            end
        end
    end
end
