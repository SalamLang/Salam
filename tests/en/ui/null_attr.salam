import gui.ui

struct Work:
    pub note: str?
    pub title: str?
end

mut work := Work { title = "T" }

func show():
    println "note [" + ui.ById("a").Attr("title") + "], text [" + ui.ById("a").Text() + "]"
end

func give():
    work.note = "hello"
end

func clear():
    work.note = null
    work.title = null
end

page:
    title = "Null"
    box:
        link:
            id = "a"
            url = "/x"
            title = work.note
            content = work.title
        end
        button:
            id = "show"
            content = "show"
            click = (): show() end
        end
        button:
            id = "give"
            content = "give"
            click = (): give() end
        end
        button:
            id = "clear"
            content = "clear"
            click = (): clear() end
        end
    end
end
