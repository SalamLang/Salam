page:
    title = "Page size"
    background = "red"
    if page.width >= 400 and page.height < 900:
        background = "green"
    end
    box:
        id = "nav"
        layout = "row"
        gap = 8
        if page.compact:
            layout = "column"
            gap = 2
        end
        box:
            id = "a"
            width = 40
            height = 20
        end
        box:
            id = "b"
            width = 40
            height = 20
        end
    end
    if page.width < 500:
        box:
            id = "small"
            width = 10
            height = 10
        end
    end
    if page.landscape:
        box:
            id = "wide"
            width = 30
            height = 10
        end
    end
end
