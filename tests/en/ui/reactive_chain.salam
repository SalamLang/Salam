import gui.ui

mut last := 0
mut lastn := 0

func check():
    r := ui.ScopeRuns()
    nn := ui.ScopeNodes()
    println "runs " + (r - last) + ", nodes " + (nn - lastn) + ", " + ui.ById("price").Text() + ", " + ui.ById("par").Text() + ", " + ui.ById("lab").Text()
    last = r
    lastn = nn
end

component Price(amount: int):
    paragraph: id = "price" content = "price " + amount end
end

component Shop:
    qty := 1
    note := ""
    odd := qty % 2
    label := "parity " + odd
    box:
        button: id = "more" click = (): qty++ end content = "more" end
        button: id = "two" click = (): qty += 2 end content = "two" end
        input: id = "note" type = "text" end
        button: id = "tick" click = (): note = note + "x" end content = "tick" end
        Price: amount = qty * 10 end
        paragraph: id = "par" content = "n " + note end
        paragraph: id = "lab" content = label end
    end
end

page:
    title = "Chain"
    box:
        button: id = "check" click = check content = "Check" end
        Shop: end
    end
end
