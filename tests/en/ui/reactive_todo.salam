import gui.ui

mut items := Vector {} as Vector<str>
mut last := 0
mut lastn := 0

func fill():
    repeat 1000 in i:
        items.Push("t" + i)
    end
end

func check():
    r := ui.ScopeRuns()
    nn := ui.ScopeNodes()
    println "runs " + (r - last) + ", nodes " + (nn - lastn) + ", " + ui.ById("t-t7").Text() +
        ", " + ui.ById("t-t8").Text()
    last = r
    lastn = nn
end

component Todo(name: str):
    done := 0
    item:
        key = name
        content = name + " " + done
        id = "t-" + name
        click = (): done = 1 - done end
    end
end

page:
    title = "Todo"
    box:
        button:
            id = "fill"
            click = fill
            content = "Fill"
        end
        button:
            id = "check"
            click = check
            content = "Check"
        end
        list:
            each it in items:
                Todo:
                    name = it
                end
            end
        end
    end
end
