func show():
    println page.route.path + " " + page.route.pattern
end

component Home:
    heading: content = "Home" end
end

component User(id: int):
    heading: content = "User " + id end
    button: id = "next" click = (): page.GoTo("/users/" + (id + 1)) end content = "Next" end
end

component Missing:
    heading: content = "Missing" end
end

routes:
    "/" : Home
    "/users/:id" : User
    "*" : Missing
end

page:
    title = "Routes"
    box:
        link: id = "to-user" to = "/users/1" content = "User" end
        button: id = "show" click = show content = "Show" end
        button: id = "back" click = (): page.Back() end content = "Back" end
        button: id = "bad" click = (): page.GoTo("/nope") end content = "Bad" end
        Outlet: end
    end
end
