func show():
    println page.route.path + " " + page.route.pattern
end

page:
    title = "Routes"
    box:
        link: id = "to-user" to = "/users/1" content = "User" end
        button: id = "show" click = show content = "Show" end
        button: id = "back" click = (): page.route.Back() end content = "Back" end
        button: id = "bad" click = (): page.route.GoTo("/nope") end content = "Bad" end
        Outlet: end
    end
end
