mut signed_in := false

func show():
    println route.path + " " + route.pattern
end

component Home:
    heading: content = "Home" end
end

component Admin:
    button:
        id = "signout"
        click = ():
            signed_in = false
        end
        content = "Sign out"
    end
end

component Login:
    button:
        id = "login"
        click = ():
            signed_in = true
            replace("/admin")
        end
        content = "Sign in"
    end
end

routes:
    "/" : Home
    "/admin" : Admin guard = signed_in redirect = "/login"
    "/login" : Login
end

page:
    title = "Guard"
    box:
        button: id = "show" click = show content = "Show" end
        button: id = "admin" click = (): go("/admin") end content = "Admin" end
        Outlet: end
    end
end
