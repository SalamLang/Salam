mut signed_in := false

func show():
    println page.route.path + " " + page.route.pattern
end

page:
    title = "Guard"
    box:
        button:
            id = "show"
            click = show
            content = "Show"
        end
        button:
            id = "admin"
            click = (): page.route.GoTo("/admin") end
            content = "Admin"
        end
        Outlet: end
    end
end
