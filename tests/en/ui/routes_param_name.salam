mut open_all := true

func show():
    println page.route.path + " " + page.Param("user_id") + " [" + page.Query("tab") + "]"
end

component Home:
    heading: content = "Home" end
end

component Profile:
    heading: content = "Profile" end
end

component Denied:
    heading: content = "Denied" end
end

routes:
    "/" : Home
    "/users/:user_id" : Profile guard = open_all redirect = "/denied"
    "/denied" : Denied
end

page:
    title = "Param"
    box:
        link: id = "ok" to = "/users/7?tab=posts" content = "Open" end
        link: id = "no" to = "/users/8?open=1" content = "Closed" end
        button: id = "show" click = show content = "Show" end
        Outlet: end
    end
end
