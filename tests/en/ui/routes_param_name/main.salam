mut open_all := true

func show():
    println page.route.path + " " + page.route.Param("user_id") + " [" + page.route.Query("tab") +
        "]"
end

page:
    title = "Param"
    box:
        link:
            id = "ok"
            to = "/users/7?tab=posts"
            content = "Open"
        end
        link:
            id = "no"
            to = "/users/8?open=1"
            content = "Closed"
        end
        button:
            id = "show"
            click = show
            content = "Show"
        end
        Outlet: end
    end
end
