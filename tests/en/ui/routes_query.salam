func show():
    println page.route.path + " [" + page.route.Param("id") + "] [" + page.route.Query("open") + "]"
end

component Home:
    heading: content = "Home" end
end

component Item(id: int):
    heading: content = "Item " + id end
end

routes:
    "/" : Home
    "/item/:id" : Item guard = page.route.Query("open") == "yes" redirect = "/"
end

page:
    title = "Query"
    box:
        button: id = "show" click = show content = "Show" end
        button: id = "open" click = (): page.GoTo("/item/7?open=yes") end content = "Open" end
        button: id = "shut" click = (): page.GoTo("/item/8") end content = "Shut" end
        Outlet: end
    end
end
