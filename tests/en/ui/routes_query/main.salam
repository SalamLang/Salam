func show():
    println page.route.path + " [" + page.route.Param("id") + "] [" + page.route.Query("open") + "]"
end

page:
    title = "Query"
    box:
        button:
            id = "show"
            click = show
            content = "Show"
        end
        button:
            id = "open"
            click = (): page.route.GoTo("/item/7?open=yes") end
            content = "Open"
        end
        button:
            id = "shut"
            click = (): page.route.GoTo("/item/8") end
            content = "Shut"
        end
        Outlet: end
    end
end
