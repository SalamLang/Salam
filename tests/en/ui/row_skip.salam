import gui.ui

mut ids := Vector {} as Vector<int>
mut labels := Vector {} as Vector<str>
mut selected := 0
mut seen_runs := 0
mut seen_skips := 0

func check():
    r := ui.ScopeRuns()
    k := ui.ScopeSkips()
    mut all := ""
    each _, rid in ids:
        all += ui.ById("r" + rid).Text() + ";"
    end
    println "runs " + (r - seen_runs) + ", skips " + (k - seen_skips) + ", " + all
    seen_runs = r
    seen_skips = k
end

func fill():
    each n in ["a", "b", "c", "d", "e"]:
        ids.Push(ids.Len() + 1)
        labels.Push(n)
    end
end

func relabel():
    labels.Set(2, "C")
end

func drop(rid: int):
    repeat ids.Len() in i:
        if ids.Get(i) == rid:
            ids.RemoveAt(i)
            labels.RemoveAt(i)
            ret
        end
    end
end

component Row(rid: int, label: str, sel: bool):
    item:
        key = rid
        id = "r" + rid
        content = label + (sel ? "*" : "")
        button:
            id = "s" + rid
            click = (): selected = rid end
            content = "pick"
        end
        button:
            id = "x" + rid
            click = (): drop(rid) end
            content = "x"
        end
    end
end

page:
    title = "Row skip"
    button:
        id = "fill"
        click = fill
        content = "Fill"
    end
    list:
        each i, rid in ids:
            Row:
                rid = rid
                label = labels.Get(i)
                sel = rid == selected
            end
        end
    end
    button:
        id = "relabel"
        click = relabel
        content = "Relabel"
    end
    button:
        id = "check"
        click = check
        content = "Check"
    end
end
