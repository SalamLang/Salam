import gui.ui

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func report():
    show("a")
    show("b")
end

page:
    title = "Input align"
    dir = "rtl"
    box:
        input:
            id = "a"
            width = 200
            value = "سلام"
        end
        input:
            id = "b"
            dir = "ltr"
            width = 200
            value = "abc"
        end
    end
    button:
        id = "report"
        click = report
        content = "Report"
    end
end
