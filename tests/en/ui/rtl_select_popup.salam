import gui.ui

func show(id: str):
    r := ui.ById(id).Rect()
    println id, r.x, r.y, r.width, r.height
end

func report():
    show("s")
end

page:
    title = "Select popup"
    dir = "rtl"
    box:
        select:
            id = "s"
            width = 200
            option:
                value = "a"
                content = "l"
            end
            option:
                value = "b"
                content = "l"
            end
        end
    end
    button:
        id = "report"
        click = report
        content = "Report"
    end
end
