import gui.ui

mut left := 0
mut right := 0
mut last := 0

func check():
    r := ui.ScopeRuns()
    println "runs " + (r - last) + ", " + ui.ById("left").Text() + ", " + ui.ById("right").Text()
    last = r
end

component Panel(name: str, value: int):
    box:
        heading: id = name content = name + " " + value end
        paragraph: content = "panel " + name end
    end
end

page:
    title = "Components"
    box:
        Panel: name = "left" value = left end
        Panel: name = "right" value = right end
        button: id = "incl" click = (): left++ end content = "Left" end
        button: id = "incr" click = (): right += 10 end content = "Right" end
        button: id = "check" click = check content = "Check" end
    end
end
