import gui.ui

mut count := 0
mut clicks := 0
mut last := 0

func check():
    r := ui.ScopeRuns()
    println "runs " + (r - last) + ", label " + ui.ById("label").Text()
    last = r
end

func noop():
    println "nothing changed"
end

page:
    title = "Scopes"
    box:
        heading: id = "label" content = "Count: " + count end
        button: id = "inc" click = (): count++ end content = "+1" end
        button: id = "noop" click = noop content = "Noop" end
        button: id = "tally" click = (): clicks++ end content = "Tally" end
        button: id = "check" click = check content = "Check" end
        paragraph: content = "Only the heading reads count." end
        list:
            item: content = "one" end
            item: content = "two" end
            item: content = "three" end
        end
    end
end
