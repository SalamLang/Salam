import gui.ui

mut count := 0

func show():
    println ui.ById("runs").Text() + ", " + ui.ById("count").Text()
end

page:
    title = "Invalidate"
    box:
        heading: id = "runs" content = "Runs: " + ui.ScopeRuns() end
        paragraph: id = "count" content = "Count: " + count end
        button: id = "inc" click = (): count++ end content = "+1" end
        button: id = "refresh" click = (): ui.Invalidate() end content = "Refresh" end
        button: id = "show" click = show content = "Show" end
    end
end
