import gui.ui

mut items := Vector {} as Vector<str>

func check():
    mut line := ""
    each it in items:
        if line.Len() > 0:
            line += ", "
        end
        line += ui.ById("hit-" + it).Text() + " [" + ui.ById("in-" + it).Value() + "]"
    end
    println line
end

func reverse_items():
    mut out := Vector {} as Vector<str>
    each it in items:
        out.insert(0, it)
    end
    items.clear()
    each it2 in out:
        items.push(it2)
    end
    out.Free()
end

component Row(name: str):
    hits := 0
    item:
        key = name
        id = "row-" + name
        button: id = "hit-" + name content = name + " " + hits click = (): hits++ end end
        input: id = "in-" + name type = "text" end
    end
end

page:
    title = "Keyed rows"
    box:
        button: id = "fill" click = (): items.push("a") items.push("b") items.push("c") end content = "Fill" end
        button: id = "rev" click = reverse_items content = "Reverse" end
        button: id = "front" click = (): items.insert(0, "z") end content = "Front" end
        button: id = "drop" click = (): items.remove_at(0) end content = "Drop" end
        button: id = "check" click = check content = "Check" end
        list:
            each it in items:
                Row: name = it end
            end
        end
    end
end
