import gui.ui

mut items := Vector {} as Vector<str>
mut selected := -1
mut last := 0

func check():
    r := ui.ScopeRuns()
    println "runs " + (r - last) + ", rows " + items.len() + ", row 1: " + ui.ById("row1").Text()
    last = r
end

page:
    title = "List"
    box:
        button: id = "add" click = (): items.push("task " + items.len()) end content = "Add" end
        button: id = "pick" click = (): selected = 1 end content = "Pick" end
        button: id = "check" click = check content = "Check" end
        list:
            each i, it in items:
                item: id = "row" + i content = it color = selected == i ? "crimson" : "navy" end
            end
        end
    end
end
