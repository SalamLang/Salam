import gui.ui

mut version := 0
mut last := 0

func check():
    r := ui.ScopeRuns()
    println "runs " + (r - last) + ", " + ui.ById("a").Text() + ", " + ui.ById("b").Text()
    last = r
end

component Counter(name: str, start: int):
    state count := start
    state label := "clicks"
    box:
        button: id = name click = (): count++ end content = name + " " + count + " " + label end
    end
end

page:
    title = "State"
    box:
        box:
            class = "v" + version
            Counter: name = "a" start = 0 end
            Counter: name = "b" start = 10 end
        end
        button: id = "bump" click = (): version++ end content = "Bump" end
        button: id = "check" click = check content = "Check" end
    end
end
