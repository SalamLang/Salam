import gui.ui

func check():
    mut line := "body " + ui.ById("A-body").Text() + ", rows"
    repeat 4 in i:
        line += " " + ui.ById("row" + i).Text()
    end
    println line
end

component Toggle(label: str):
    state open := false
    box:
        button: id = label + "-btn" click = (): open = not open end content = label end
        if open:
            paragraph: id = label + "-body" content = "Body of " + label end
        end
    end
end

component Todo:
    state items := Vector {} as Vector<str>
    state next := 0 as i64
    box:
        button: id = "add" click = (): items.push("t" + next) next += 1 end content = "Add" end
        button: id = "rot" click = (): items.insert(0, items.pop()) end content = "Rotate" end
        list:
            each i, it in items:
                item: key = it id = "row" + i content = it end
            end
        end
    end
end

page:
    title = "State operations"
    button: id = "check" click = check content = "Check" end
    Toggle: label = "A" end
    Todo: end
end
