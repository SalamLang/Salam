import gui.ui

mut touched := 0 as i64
mut hits := Vector {} as Vector<int>
mut notes := Vector {} as Vector<int>

func take(w: int): i64:
    mut t := 0 as i64
    if w == 0:
        t = touched
        touched = 0
    end
    ret t
end

func sites():
    ui.ScopeSite(1, 0, 0, 0)
    ui.ScopeSite(2, -1, 0, 0)
    ui.ScopeVars(2, 0, 1)
    ui.ScopeSite(3, -1, 0, 0)
    ui.ScopeVars(3, 0, 2)
    ui.ScopeDerive(0, (_k: int, m: int): ret m end)
end

func card(b: ui.Builder, name: str):
    b.Scope(1, (b: ui.Builder):
        k := b.Instance(0)
        if b.Fresh():
            hits.Push(0)
            notes.Push(0)
        end
        b.Open("box")
        b.Open("button")
        b.Id("hit-" + name)
        b.On("click", ():
            hits[k] += 1
            ui.TouchInstanceVars(0, k, 1)
        end)
        b.Text("hit")
        b.Close()
        b.Open("button")
        b.Id("note-" + name)
        b.On("click", ():
            notes[k] += 1
            ui.TouchInstanceVars(0, k, 2)
        end)
        b.Text("note")
        b.Close()
        b.Scope(2, (b: ui.Builder):
            b.Open("paragraph")
            b.Text("hits " + hits[k])
            b.Close()
        end)
        b.Scope(3, (b: ui.Builder):
            b.Open("paragraph")
            b.Text("notes " + notes[k])
            b.Close()
        end)
        b.Close()
    end)
end

func page(b: ui.Builder):
    b.Reactive(1, (w: int): ret take(w) end, (): sites() end)
    b.Open("div")
    card(b, "a")
    card(b, "b")
    b.Close()
end

func main:
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder): page(b) end)
    println "hits", hits[0], hits[1], "notes", notes[0], notes[1]
    println "scope runs", ui.ScopeRuns(), "nodes", ui.ScopeNodes()
end
