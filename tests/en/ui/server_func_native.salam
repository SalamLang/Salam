import net.http
import net.router
import net.ssr
import net.ssrclient
import encoding.json

mut total := 0
mut backend_port := 0
mut backend_ready := start_backend()

func answer_add(c: i64):
    args := ssr.Args(c)
    ssr.Ok(c, json.Marshal(json.GetInt(args, "a") + json.GetInt(args, "b")))
end

func answer_name(c: i64):
    args := ssr.Args(c)
    ssr.Ok(c, json.Str("hello " + json.Get(args, "name")))
end

func start_backend(): bool:
    ssr.Register("Add", answer_add)
    ssr.Register("Greet", answer_name)
    mut r := router.NewRouter()
    ssr.Mount(r)
    mut s := http.NewServer(0)
    http.Use(s, r)
    backend_port = http.RunBackgroundPort(s)
    ssrclient.SetServer("http://127.0.0.1:" + backend_port)
    ret backend_port > 0
end

server func Add(a: int, b: int): int:
    ret a + b + 1000
end

server func Greet(name: str): str:
    ret "the real body is not in the app " + name
end

page:
    title = "Server func"
    box:
        button: id = "add" click = (): total = Add(2, 40) println "total " + total end content = "Add" end
        button: id = "greet" click = (): println Greet("salam") end content = "Greet" end
    end
end
