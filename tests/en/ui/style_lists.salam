const GAP := 8

page:
    title = "Style lists"
    box:
        id = "a"
        padding = GAP, 16
        font = "Times New Roman", "serif"
        content = "A"
    end
    button:
        id = "b1"
        blur = (): println "blurred" end
        content = "B1"
    end
    box:
        id = "c"
        blur = 2
        content = "C"
    end
    box:
        id = "d"
        padding = 10%, 20%
        content = "D"
    end
    button:
        id = "b2"
        content = "B2"
    end
end
