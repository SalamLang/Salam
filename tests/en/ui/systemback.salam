import gui.ui

mut depth := 1

func main:
    ui.SetBack((): println "history back " + depth depth-- ret depth >= 0 end)
    ui.OnCloseRequest((): println "close request" ret true end)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder): b.Open("button") b.Text("x") b.Close() end)
    println "left"
end
