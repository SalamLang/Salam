import gui.ui

page:
    title = "Touch pinch"
    box:
        id = "area"
        height = 200
        pinch = (): ev := ui.CurrentEvent() println "pinch", ev.scale, ev.x, ev.y end
        pinchend = (): println "pinch end" end
        button:
            id = "b"
            height = 60
            click = (): println "tap" end
            contextmenu = (): println "long press" end
            content = "b"
        end
    end
end
