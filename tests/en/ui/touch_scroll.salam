mut taps := 0

page:
    title = "Touch scroll"
    box:
        box:
            id = "list"
            height = 100
            overflow = "auto"
            button:
                id = "b0"
                height = 40
                contextmenu = (): println "long press" end
                click = (): taps++ println "tap " + taps end
                content = "0"
            end
            button:
                id = "b1"
                height = 40
                click = (): taps++ println "tap " + taps end
                content = "1"
            end
            button:
                id = "b2"
                height = 40
                click = (): taps++ println "tap " + taps end
                content = "2"
            end
            button:
                id = "b3"
                height = 40
                click = (): taps++ println "tap " + taps end
                content = "3"
            end
            button:
                id = "b4"
                height = 40
                click = (): taps++ println "tap " + taps end
                content = "4"
            end
            button:
                id = "b5"
                height = 40
                click = (): taps++ println "tap " + taps end
                content = "5"
            end
        end
    end
end
