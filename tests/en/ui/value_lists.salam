page:
    title = "Values"
    box: id = "a" padding = 8, 16 border = 2, solid, #3366aa width = 50% content = "A" end
    box: id = "b" margin = 4, 8, 12, 16 background color = #fa0 content = "B" end
    button: id = "go" click = (): println "ratio " + 25% end content = "Go" end
end
