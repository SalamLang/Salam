import gui.ui

mut last := 0

func runs(): str:
    r := ui.ScopeRuns()
    d := r - last
    last = r
    ret "runs " + d
end

component Badge(value: int):
    text := "badge " + value
    paragraph: id = "badge" content = text end
end

component Pick(report):
    button: id = "pick" click = (): report(5) end content = "pick" end
end

component Panel(name: str):
    count := 0
    presses := 0
    title := name + " panel"
    box:
        paragraph: id = "title" content = title + " " + count end
        button: id = "inc" click = (): count++ end content = "+" end
        button:
            id = "quiet"
            click = ():
                presses++
                println "presses " + presses
            end
            content = "quiet"
        end
        Badge: value = count * 10 end
        Pick: report = (count: int): println "picked " + count end end
    end
end

page:
    total := 0
    label := "total " + total
    title = "Variables"
    paragraph: id = "total" content = label end
    button: id = "add" click = (): total += 2 end content = "add" end
    button: id = "check" click = (): println runs() + ", " + ui.ById("title").Text() + ", " + ui.ById("badge").Text() + ", " + ui.ById("total").Text() end content = "check" end
    Panel: name = "main" end
end
