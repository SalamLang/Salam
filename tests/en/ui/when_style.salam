mut active := false
mut big := false

page:
    title = "When"
    button:
        id = "seg"
        background = "blue"
        color = "white"
        hover background = "navy"
        when active:
            background = "orange"
            color = "black"
        end
        click = (): active = not active end
        content = "Seg"
    end
    button:
        id = "size"
        padding = 8
        when big:
            padding = 24
        end
        when active and big:
            padding = 40
        end
        click = (): big = not big end
        content = "Size"
    end
end
