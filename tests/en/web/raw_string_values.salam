// EXPECT: <p>say &quot;hi&quot;</p>
// EXPECT: <p title="a `b`">x</p>
component Quote(t):
    paragraph: content = "{t}" end
end
layout:
    Quote: t = `say "hi"` end
    paragraph: title = "a `b`" content = "x" end
end
