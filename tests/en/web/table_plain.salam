// EXPECT: <table>
// EXPECT: <tr>
// EXPECT: <td>x</td>
// EXPECT-NOT: <tbody
// EXPECT-NOT: <th
// EXPECT-NOT: <thead
layout:
    table:
        row:
            column: content = "x" end
        end
    end
end
