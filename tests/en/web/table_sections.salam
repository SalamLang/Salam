// EXPECT: <thead>
// EXPECT: <th>Name</th>
// EXPECT: <tbody>
// EXPECT: <td>Ali</td>
// EXPECT: <tfoot>
// EXPECT: <td>Total</td>
// EXPECT-NOT: <header
// EXPECT-NOT: <footer
// EXPECT-NOT: <main
layout:
    table:
        header:
            row:
                column: content = "Name" end
            end
        end
        main:
            row:
                column: content = "Ali" end
            end
        end
        footer:
            row:
                column: content = "Total" end
            end
        end
    end
end
