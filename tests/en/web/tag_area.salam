// EXPECT: <area
// EXPECT:  href="/a.html"
// EXPECT:  alt="x1"
// EXPECT:  coords="x1"
// EXPECT:  shape="default"
// EXPECT:  target="_blank"
// EXPECT:  download="x1"
// EXPECT:  rel="t1"
// EXPECT:  referrerpolicy="no-referrer"
// EXPECT:  ping="/a.html"
// EXPECT-NOT: />
layout:
    image map: name = "m1"
        area:
            url = "/a.html"
            alt = "x1"
            coords = "x1"
            shape = "default"
            target = "_blank"
            download = "x1"
            rel = "t1"
            referrer policy = "no-referrer"
            ping = "/a.html"
        end
    end
end
