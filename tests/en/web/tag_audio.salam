// EXPECT: <audio
// EXPECT:  src="/a.html"
// EXPECT:  crossorigin="anonymous"
// EXPECT:  preload="none"
// EXPECT:  autoplay
// EXPECT:  loop
// EXPECT:  muted
// EXPECT:  controls
layout:
    audio:
        url = "/a.html"
        crossorigin = "anonymous"
        preload = "none"
        autoplay = true
        loop = true
        muted = true
        controls = true
        content = "hello"
    end
end
