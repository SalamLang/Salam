// EXPECT: <button
// EXPECT:  form="target1"
// EXPECT:  formaction="/a.html"
// EXPECT:  formmethod="get"
// EXPECT:  formenctype="application/x-www-form-urlencoded"
// EXPECT:  formnovalidate
// EXPECT:  formtarget="_blank"
// EXPECT:  autofocus
// EXPECT:  popovertarget="target1"
// EXPECT:  popovertargetaction="toggle"
layout:
    box: id = "target1" end
    button:
        form = "target1"
        form action = "/a.html"
        form method = "get"
        form enctype = "application/x-www-form-urlencoded"
        form novalidate = true
        form target = "_blank"
        autofocus = true
        popover target = "target1"
        popover target action = "toggle"
        content = "hello"
    end
end
