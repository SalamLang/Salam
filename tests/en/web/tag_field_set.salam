// EXPECT: <fieldset
// EXPECT:  disabled
// EXPECT:  name="x1"
// EXPECT:  form="target1"
layout:
    box: id = "target1" end
    field set:
        disabled = true
        name = "x1"
        form = "target1"
        content = "hello"
    end
end
