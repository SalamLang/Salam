// EXPECT: <form
// EXPECT:  action="/a.html"
// EXPECT:  method="get"
// EXPECT:  enctype="application/x-www-form-urlencoded"
// EXPECT:  autocomplete="x1"
// EXPECT:  novalidate
// EXPECT:  accept-charset="utf-8"
// EXPECT:  target="_blank"
layout:
    form:
        action = "/a.html"
        method = "get"
        enctype = "application/x-www-form-urlencoded"
        autocomplete = "x1"
        novalidate = true
        accept charset = "utf-8"
        target = "_blank"
        content = "hello"
    end
end
