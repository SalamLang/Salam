// EXPECT: <img
// EXPECT:  src="/a.html"
// EXPECT:  srcset="/a.png 1x, /b.png 2x"
// EXPECT:  sizes="x1"
// EXPECT:  loading="lazy"
// EXPECT:  decoding="sync"
// EXPECT:  crossorigin="anonymous"
// EXPECT:  fetchpriority="high"
// EXPECT:  usemap="x1"
// EXPECT:  ismap
// EXPECT:  referrerpolicy="no-referrer"
layout:
    image:
        url = "/a.html"
        srcset = "/a.png 1x, /b.png 2x"
        sizes = "x1"
        loading = "lazy"
        decoding = "sync"
        crossorigin = "anonymous"
        fetch priority = "high"
        use map = "x1"
        ismap = true
        referrer policy = "no-referrer"
    end
end
