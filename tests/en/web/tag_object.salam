// EXPECT: <object
// EXPECT:  data="/a.html"
// EXPECT:  type="text/plain"
// EXPECT:  name="x1"
// EXPECT:  form="target1"
layout:
    box: id = "target1" end
    object:
        url = "/a.html"
        type = "text/plain"
        name = "x1"
        form = "target1"
        content = "hello"
    end
end
