// EXPECT: <option
// EXPECT:  value="x1"
// EXPECT:  selected
// EXPECT:  disabled
// EXPECT:  label="x1"
layout:
    select:
        option:
            value = "x1"
            selected = true
            disabled = true
            label = "x1"
            content = "hello"
        end
    end
end
