// EXPECT: <select
// EXPECT:  name="x1"
// EXPECT:  multiple
// EXPECT:  required
// EXPECT:  disabled
// EXPECT:  size="2"
// EXPECT:  autofocus
// EXPECT:  form="target1"
// EXPECT:  autocomplete="x1"
layout:
    box: id = "target1" end
    select:
        name = "x1"
        multiple = true
        required = true
        disabled = true
        size = "2"
        autofocus = true
        form = "target1"
        autocomplete = "x1"
    end
end
