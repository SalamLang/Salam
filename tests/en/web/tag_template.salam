// EXPECT: <template
// EXPECT:  shadowrootmode="open"
// EXPECT:  shadowrootdelegatesfocus
// EXPECT:  shadowrootclonable
// EXPECT:  shadowrootserializable
layout:
    template:
        shadowrootmode = "open"
        shadowrootdelegatesfocus = true
        shadowrootclonable = true
        shadowrootserializable = true
    end
end
