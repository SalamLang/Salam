// EXPECT: <textarea
// EXPECT:  name="x1"
// EXPECT:  rows="2"
// EXPECT:  cols="2"
// EXPECT:  maxlength="2"
// EXPECT:  minlength="2"
// EXPECT:  placeholder="x1"
// EXPECT:  readonly
// EXPECT:  required
// EXPECT:  disabled
// EXPECT:  wrap="soft"
// EXPECT:  autocomplete="x1"
// EXPECT:  autofocus
// EXPECT:  dirname="t1"
// EXPECT:  form="target1"
layout:
    box: id = "target1" end
    text area:
        name = "x1"
        rows = "2"
        cols = "2"
        maxlength = "2"
        minlength = "2"
        placeholder = "x1"
        readonly = true
        required = true
        disabled = true
        wrap = "soft"
        autocomplete = "x1"
        autofocus = true
        dirname = "t1"
        form = "target1"
        content = "hello"
    end
end
