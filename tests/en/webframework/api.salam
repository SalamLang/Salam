import encoding.json
import net.http
import net.router

func json ok(ctx: i64, body: str):
    http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
    http.Ctx_json(ctx, body)
end

func list users(ctx: i64):
    json ok(ctx, `[{"id":1,"name":"Ali"},{"id":2,"name":"Sara"}]`)
end

func get user(ctx: i64):
    id := http.Ctx_param(ctx, "id")
    if id == "1":
        json ok(ctx, `{"id":1,"name":"Ali","role":"admin"}`)
        ret
    end
    if id == "2":
        json ok(ctx, `{"id":2,"name":"Sara","role":"user"}`)
        ret
    end
    http.Ctx_status(ctx, 404)
    json ok(ctx, `{"error":"user not found"}`)
end

func create user(ctx: i64):
    body := http.Ctx_body(ctx)
    name := json.Get(body, "name")
    if name.len() == 0:
        http.Ctx_status(ctx, 400)
        json ok(ctx, `{"error":"name is required"}`)
        ret
    end
    http.Ctx_status(ctx, 201)
    json ok(ctx, `{"id":3,"name":"` + name + `","created":true}`)
end

func delete user(ctx: i64):
    id := http.Ctx_param(ctx, "id")
    json ok(ctx, `{"deleted":true,"id":` + id + "}")
end

func health(ctx: i64):
    json ok(ctx, `{"status":"healthy"}`)
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/api/users", funcptr(list users))
    router.Post(r, "/api/users", funcptr(create user))
    router.Get(r, "/api/users/:id", funcptr(get user))
    router.Delete(r, "/api/users/:id", funcptr(delete user))
    router.Get(r, "/health", funcptr(health))
    s := http.NewServer(8080)
    http.Use(s, r)
    http.Run(s)
end
