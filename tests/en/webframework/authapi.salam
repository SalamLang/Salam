import crypto
import jwt
import net.http
import net.router
import encoding.json

const ISSUER := "api.example.com"
const ACCESS_TTL := 900
const REFRESH_TTL := 604800

func secret(): str:
    ret "dev-only-secret-change-me"
end

func guard(): jwt.Guard:
    mut g := jwt.NewGuard(secret())
    g.opts.issuer = ISSUER
    g.opts.alg = jwt.JWT_HS256
    g.opts.leeway = 30 as i64
    g.opts.require_exp = true
    ret g
end

func send(ctx: i64, code: int, body: str):
    http.Ctx_status(ctx, code)
    http.Ctx_json(ctx, body)
end

func lookup_scope(user: str): str:
    if user == "ali": ret "read write admin" end
    if user == "sara": ret "read" end
    ret ""
end

func stored_hash(user: str): str:
    if user == "ali": ret crypto.HashPassword("salam") end
    if user == "sara": ret crypto.HashPassword("salam") end
    ret ""
end

func login(ctx: i64):
    body := http.Ctx_body(ctx)
    user := json.Get(body, "user")
    pass := json.Get(body, "pass")
    hash := stored_hash(user)
    if hash.len() == 0 || !crypto.VerifyPassword(pass, hash):
        send(ctx, 401, `{"error":"invalid credentials"}`)
        ret
    end
    mut c := jwt.NewClaims()
    c.sub = user
    jwt.SetStr(c, "scope", lookup_scope(user))
    jwt.SetStr(c, "kind", "access")
    mut err := 0
    access := jwt.Issue(guard(), c, ACCESS_TTL as i64, err)
    mut r := jwt.NewClaims()
    r.sub = user
    jwt.SetStr(r, "kind", "refresh")
    refresh_tok := jwt.Issue(guard(), r, REFRESH_TTL as i64, err)
    if err != jwt.JWT_OK:
        send(ctx, 500, `{"error":"could not issue token"}`)
        ret
    end
    send(ctx, 200, `{"access":"` + access + `","refresh":"` + refresh_tok + `","expires_in":900}`)
end

func refresh(ctx: i64):
    mut t := jwt.Token {}
    if !jwt.Require(ctx, guard(), t): ret end
    if jwt.Str(t, "kind") != "refresh":
        jwt.Forbidden(ctx, "not a refresh token")
        ret
    end
    mut c := jwt.NewClaims()
    c.sub = t.claims.sub
    jwt.SetStr(c, "scope", lookup_scope(t.claims.sub))
    jwt.SetStr(c, "kind", "access")
    mut err := 0
    access := jwt.Issue(guard(), c, ACCESS_TTL as i64, err)
    if err != jwt.JWT_OK:
        send(ctx, 500, `{"error":"could not issue token"}`)
        ret
    end
    send(ctx, 200, `{"access":"` + access + `","expires_in":900}`)
end

func me(ctx: i64):
    mut t := jwt.Token {}
    if !jwt.Require(ctx, guard(), t): ret end
    if jwt.Str(t, "kind") != "access":
        jwt.Forbidden(ctx, "not an access token")
        ret
    end
    send(ctx, 200, `{"sub":"` + t.claims.sub + `","scope":"` + jwt.Str(t, "scope") + `"}`)
end

func admin_stats(ctx: i64):
    mut t := jwt.Token {}
    if !jwt.RequireScope(ctx, guard(), "admin", t): ret end
    send(ctx, 200, `{"users":2,"requests":41231}`)
end

func user_settings(ctx: i64):
    id := http.Ctx_param(ctx, "id")
    mut t := jwt.Token {}
    if !jwt.RequireSubject(ctx, guard(), id, t): ret end
    send(ctx, 200, `{"id":"` + id + `","theme":"dark"}`)
end

func home(ctx: i64):
    mut err := 0
    t := jwt.Check(ctx, guard(), err)
    if err == jwt.JWT_OK:
        send(ctx, 200, `{"hello":"` + t.claims.sub + `"}`)
        ret
    end
    send(ctx, 200, `{"hello":"stranger"}`)
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/", home)
    router.Post(r, "/auth/login", login)
    router.Post(r, "/auth/refresh", refresh)
    router.Get(r, "/api/me", me)
    router.Get(r, "/api/admin/stats", admin_stats)
    router.Get(r, "/api/users/:id/settings", user_settings)
    mut s := http.NewServer(8080)
    http.Use(s, r)
    http.Run(s)
end
