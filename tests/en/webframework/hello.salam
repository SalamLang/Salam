import net.http
import net.router
func home(ctx: i64):
    http.Ctx_html(ctx, "<h1>Hello from Salam!</h1><p>A lightweight web framework.</p>")
end

func greet(ctx: i64):
    name := http.Ctx_param(ctx, "name")
    http.Ctx_html(ctx, "<h1>Hello, " + name + "!</h1>")
end

func ping(ctx: i64):
    http.Ctx_json(ctx, `{"status":"ok","message":"pong"}`)
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/", funcptr(home))
    router.Get(r, "/greet/:name", funcptr(greet))
    router.Get(r, "/ping", funcptr(ping))
    s := http.NewServer(8080)
    http.Use(s, r)
    http.Run(s)
end
