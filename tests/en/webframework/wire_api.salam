import net.http
import net.router
import wire

mut app := wire.New()

struct Config:
    pub greeting: str = ""
    pub port: int = 8080
end

struct Repo:
    pub cfg: Config = Config {}
    pub func Find(name: str): str:
        ret this.cfg.greeting + ", " + name
    end
end

struct Service:
    pub repo: Repo = Repo {}
    pub func Welcome(name: str): str:
        ret "<h1>" + this.repo.Find(name) + "</h1>"
    end
end

func welcome(ctx: i64):
    mut svc := Service {}
    if not wire.Get(app, "Service", svc):
        http.Json(ctx, `{"error":"service unavailable"}`)
        ret
    end
    http.Html(ctx, svc.Welcome(http.Param(ctx, "name")))
end

func wiring(): str:
    wire.Value(app, "Config", Config { greeting = "Hello", port = 8080 })
    wire.Provide(app, "Repo", "Config", Repo {}, (cx: wire.Container):
        mut c := Config {}
        _ok := wire.Get(cx, "Config", c)
        ret Repo { cfg = c }
    end)
    wire.Provide(app, "Service", "Repo", Service {}, (cx: wire.Container):
        mut r := Repo {}
        _ok := wire.Get(cx, "Repo", r)
        ret Service { repo = r }
    end)
    ret wire.Build(app)
end

func main:
    err := wiring()
    if err != "":
        println err
        ret 1
    end
    defer wire.Close(app)
    mut r := router.NewRouter()
    router.Get(r, "/welcome/:name", welcome)
    mut s := http.NewServer(8080)
    http.Use(s, r)
    http.Run(s)
end
