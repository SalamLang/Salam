// Links the dependency-free native/mock/cef_mock.c stand-in instead of the
// real CEF-backed shim - see std/webview/cef.salam's
// `if !SALAM_WEBVIEW_CEF_MOCK:` guard. Built once per test run (see
// run-tests.sh's "webview_cef" section) into
// $WORK/cefwork/.work/libsalam_webview_cef_mock.a; run-one-build.sh symlinks
// that directory to "ceftests" inside each job's working directory so the
// relative "-Lceftests/.work" below resolves. Mirrors tests/en/opencv/
// _linkmock.salam exactly.
package linkmock
link dynamic "-Lceftests/.work"
link dynamic "salam_webview_cef_mock"
