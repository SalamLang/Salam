// Drives every method of the CEF backend through the mock shim. What this
// actually proves is that cef.salam's extern ABI matches cef_shim.h and that
// the condcomp wiring selects the CEF backend over the native one - the mock
// opens no window.
import webview
import "_linkmock.salam"

func main:
    w := webview.Create()
    if w.IsClosed():
        println "create failed"
        ret
    end
    w.SetTitle("Salam on Chromium")
    w.SetSize(1024, 768, webview.HINT_FIXED)
    w.Navigate("https://salamlang.ir")
    w.SetHTML("<h1>hello</h1>")
    w.Eval("document.title")
    w.Init("window.salam = 1")
    w.Run()
    w.Destroy()
end
