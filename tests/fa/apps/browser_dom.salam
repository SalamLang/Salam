فراخوانی دام

گذرا تعداد_کلیک := 0

کارکرد نمایش اندازه():
    اطلاع := دام.پرسمان("#info")
    دام.تنظیم متن(اطلاع, "پنجره: " + دام.عرض پنجره() + " × " + دام.ارتفاع پنجره())
پایان

کارکرد آغازین:
    عنوان := دام.پرسمان("#title")
    دام.تنظیم متن(عنوان, "سلام در مرورگر")
    دام.تنظیم سبک(عنوان, "color", "#0a7f5f")

    دکمه := دام.با شناسه("btn")
    خروجی := دام.با شناسه("out")
    دام.هنگام رویداد(
        دکمه, "click", (): تعداد_کلیک = تعداد_کلیک + 1 دام.تنظیم متن(خروجی, "کلیک‌ها: " + تعداد_کلیک) پایان
    )

    دام.هنگام تغییر اندازه(
        (): نمایش اندازه() پایان
    )
    نمایش اندازه()

    جعبه := دام.بساز("div")
    دام.تنظیم متن(جعبه, "ساخته‌شده توسط سلام")
    دام.افزودن کلاس(جعبه, "card")
    دام.افزودن(دام.بدنه(), جعبه)
پایان
