واردسازی رابط گرافیکی.نمایش وب.نصب ساز رومیزی
واردسازی ورودی خروجی
واردسازی سیستم عامل

تابع ریشه:
    پوشه := سیستم عامل.پوشه موقت() + "/salam-bundle-engine-test-fa"
    سیستم عامل.ساخت پوشه ها(پوشه)
    مسیر := پوشه + "/salam.toml"
    ورودی خروجی.نوشتن پرونده(مسیر، "[app]\nid = \"com.example.a\"\nname = \"A\"\nengine = \"chromium\"\nruntime = \"cef\"\n")
    ناپایا ش := نصب ساز رومیزی.شناسنامه {}
    سرچاپ نصب ساز رومیزی.خواندن شناسنامه(مسیر، ش)، ش.موتور، ش.پوشه موتور
    سیستم عامل.حذف همه(پوشه)
پایان
