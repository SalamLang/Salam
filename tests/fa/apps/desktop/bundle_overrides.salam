واردسازی رابط گرافیکی.نمایش وب.نصب ساز رومیزی
واردسازی ورودی خروجی
واردسازی سیستم عامل

تابع ریشه:
    پوشه := سیستم عامل.پوشه موقت() + "/salam-bundle-overrides-test-fa"
    سیستم عامل.ساخت پوشه ها(پوشه)
    مسیر := پوشه + "/salam.toml"
    ورودی خروجی.نوشتن پرونده(
        مسیر،
        "[app]\nid = \"com.example.a\"\nname = \"A\"\n\n[windows]\nproduct = \"Product A\"\ncopyright = \"Example Ltd\"\nsubsystem = \"console\"\nmanifest = \"a.manifest\"\n\n[linux]\nproduct = \"Other\"\n"
    )
    ناپایا ش := نصب ساز رومیزی.شناسنامه {}
    سرچاپ نصب ساز رومیزی.خواندن شناسنامه(مسیر، ش)، ش.جایگزین ها.طول() بزرگتر 0، ش.زیرسامانه
    نصب ساز رومیزی.اعمال جایگزین ها(ش، "windows")
    سرچاپ ش.فرآورده، ش.حق نشر، ش.زیرسامانه، ش.مانیفست
    ناپایا ل := نصب ساز رومیزی.شناسنامه {}
    نصب ساز رومیزی.خواندن شناسنامه(مسیر، ل)
    نصب ساز رومیزی.اعمال جایگزین ها(ل، "linux")
    سرچاپ ل.فرآورده، ل.زیرسامانه
    سیستم عامل.حذف همه(پوشه)
پایان
