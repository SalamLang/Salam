واردسازی رابط گرافیکی.برنامه رومیزی

تابع نمایش دهید(نام: رشته، مقدار: رشته):
    سرچاپ نام + " = [" + مقدار + "]"
پایان

تابع ریشه:
    نمایش دهید("مبدا"، برنامه رومیزی.مبدا نشانی("https://Ai.SalamLang.ir:443/x?y#z"))
    نمایش دهید("خالی"، برنامه رومیزی.مبدا نشانی("about:blank"))
    نمایش دهید("فهرست"، برنامه رومیزی.مسیر امن دارایی("/"))
    نمایش دهید("بالا"، برنامه رومیزی.مسیر امن دارایی("/../راز"))
    برنامه رومیزی.آغاز(برنامه رومیزی.پیکربندی { شناسه = "ir.salamlang.logic" })
    ناپایا مجازها := وکتور {} برگردان وکتور<رشته>
    مجازها.بیفزا("ping")
    برنامه رومیزی.اجازه دادن("https://ai.salamlang.ir"، مجازها)
    سرچاپ برنامه رومیزی.مجاز است("https://ai.salamlang.ir"، "ping")
    سرچاپ برنامه رومیزی.مجاز است("https://evil.example"، "ping")
پایان
