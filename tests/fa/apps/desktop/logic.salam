واردسازی رابط گرافیکی.نمایش وب

تابع نمایش دهید(نام: رشته، مقدار: رشته):
    سرچاپ نام + " = [" + مقدار + "]"
پایان

تابع ریشه:
    نمایش دهید("مبدا"، نمایش وب.مبدا نشانی("https://Ai.SalamLang.ir:443/x?y#z"))
    نمایش دهید("خالی"، نمایش وب.مبدا نشانی("about:blank"))
    نمایش دهید("فهرست"، نمایش وب.مسیر امن دارایی("/"))
    نمایش دهید("بالا"، نمایش وب.مسیر امن دارایی("/../راز"))
    نمایش وب.آغاز(نمایش وب.پیکربندی { شناسه = "ir.salamlang.logic" })
    ناپایا مجازها := وکتور {} برگردان وکتور<رشته>
    مجازها.بیفزا("ping")
    نمایش وب.اجازه دادن("https://ai.salamlang.ir"، مجازها)
    سرچاپ نمایش وب.مجاز است("https://ai.salamlang.ir"، "ping")
    سرچاپ نمایش وب.مجاز است("https://evil.example"، "ping")
پایان
