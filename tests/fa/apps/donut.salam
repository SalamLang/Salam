// زبان: فارسی
//
// donut.c - چنبره‌ی چرخان اندی اسلون، برگردانده‌شده به سلام.
//
// نسخه‌ی اصلی یک صفحه کد سی مبهم است که یک چنبره را در بافری ۸۰ در ۲۲
// نویسه‌ای پیکسل‌بندی می‌کند و آن را تا ابد دوباره چاپ می‌کند. هر عدد جادویی
// این برنامه همان عدد donut.c است، فقط نام گرفته است؛ تنها تغییر عمدی
// راه‌اندازِ برنامه است: به جای حلقه‌ی بی‌پایان روی یک پایانه‌ی پاک‌شده،
// شمار ثابتی قاب چاپ می‌کنیم تا خروجی تکرارپذیر بماند.
//
// سطح، دایره‌ای به شعاع «شعاع کوچک» در صفحه‌ی ایکس-وای است که تا فاصله‌ی
// «شعاع بزرگ» جابه‌جا و با فی گرد محور وای چرخانده می‌شود. سپس با آ گرد محور
// ایکس و با ب گرد محور زد می‌چرخد، به اندازه‌ی «فاصله» از چشم دور می‌شود و
// روی صفحه تصویر می‌گردد.

واردکردن ریاضی
واردکردن رشته

// ---------------------------------------------------------------------------
// صفحه‌ی نمایش
// ---------------------------------------------------------------------------

ثابت پهنا := 80
ثابت بلندا := 22
ثابت خانهها := 1760 // پهنا × بلندا - همان b[1760] و z[1760] در donut.c

// نوار روشنایی، از کم‌نورترین تا پرنورترین: همان ".,-~:;=!*#$@" در donut.c
ثابت نوار := ".,-~:;=!*#$@"

// مرکز تصویر و مقیاس افقی و عمودی پیکسل. این دو ۲ به ۱ فرق دارند، چون یک
// خانه‌ی پایانه تقریبا دو برابر پهنایش بلند است؛ همین است که چنبره را گرد
// نگه می‌دارد و نمی‌گذارد تخم‌مرغی شود.
ثابت مرکزافقی := 40.0
ثابت مرکزعمودی := 12.0
ثابت مقیاسافقی := 30.0
ثابت مقیاسعمودی := 15.0

// ---------------------------------------------------------------------------
// هندسه
// ---------------------------------------------------------------------------

ثابت شعاعکوچک := 1.0 // شعاع مقطع دایره‌ای لوله
ثابت شعاعبزرگ := 2.0 // فاصله‌ی مبدا تا مرکز لوله
ثابت فاصله := 5.0 // فاصله‌ی چشم تا چنبره

ثابت گامتتا := 0.07 // گام روی مقطع
ثابت گامفی := 0.02 // گام گرد چنبره
ثابت دور := 6.28 // donut.c درست پیش از یک دور کامل ۲ پی می‌ایستد

// ---------------------------------------------------------------------------
// پویانمایی
// ---------------------------------------------------------------------------

ثابت گامآ := 0.04 // در donut.c: هر تیک A += 0.04 (چرخش گرد ایکس)
ثابت گامب := 0.02 // در donut.c: هر تیک B += 0.02 (چرخش گرد زد)
ثابت چرخش := 26.0 // شمار تیک‌ها میان قاب‌هایی که واقعا چاپ می‌کنیم
ثابت قابها := 6 // ۶ × ۲۶ × ۰٫۰۴ یک دور کامل گرد ایکس است

// ---------------------------------------------------------------------------
// بافرهای قاب - donut.c این دو را آرایه‌ی تخت نگه می‌دارد و ما هم همین کار را
// می‌کنیم. «روشنایی» برای هر خانه یک نمایه در «نوار» دارد، یا -۱ یعنی
// «اینجا چیزی کشیده نشده».
// ---------------------------------------------------------------------------

متغیر روشنایی: صحیح[خانهها]
متغیر عمق: اعشار۶۴[خانهها]

// همان memset(b, 32, 1760) و memset(z, 0, 7040) در donut.c
تابع پاکسازی:
    تکرار خانهها با i:
        روشنایی[i] = -1
        عمق[i] = 0.0
    تمام
تمام

// پیکسل‌بندی کل چنبره برای یک جفت زاویه‌ی چرخش، با بافر عمق تا نیمه‌ی نزدیک
// لوله نیمه‌ی دور را بپوشاند.
تابع ترسیم(زاویهآ: اعشار۶۴, زاویهب: اعشار۶۴):
    سینآ := ریاضی.سینوس(زاویهآ)
    کسینآ := ریاضی.کسینوس(زاویهآ)
    سینب := ریاضی.سینوس(زاویهب)
    کسینب := ریاضی.کسینوس(زاویهب)

    متغیر تتا := 0.0
    تاوقتی تتا < دور:
        سینت := ریاضی.سینوس(تتا)
        کسینت := ریاضی.کسینوس(تتا)

        // دایره‌ی مقطع، پیش از آنکه گرد محور وای جاروب شود
        دایرهافقی := شعاعبزرگ + شعاعکوچک * کسینت
        دایرهعمودی := شعاعکوچک * سینت

        متغیر فی := 0.0
        تاوقتی فی < دور:
            سینف := ریاضی.سینوس(فی)
            کسینف := ریاضی.کسینوس(فی)

            // وارون زد نقطه‌ی چرخیده. هرچه بزرگ‌تر، نزدیک‌تر به چشم؛ و دقیقا
            // همین است که آن را به کلید عمقِ زیر تبدیل می‌کند.
            وارونعمق := 1.0 / (سینف * دایرهافقی * سینآ + دایرهعمودی * کسینآ + فاصله)

            // زیرعبارت مشترکی که donut.c آن را t می‌نامد: مولفه‌ی وای‌گونه‌ی
            // نقطه، پس از اعمال آ
            میانی := سینف * دایرهافقی * کسینآ - دایرهعمودی * سینآ

            ایکس := (مرکزافقی + مقیاسافقی * وارونعمق * (کسینف * دایرهافقی * کسینب - میانی * سینب)) بعنوان صحیح
            وای := (مرکزعمودی + مقیاسعمودی * وارونعمق * (کسینف * دایرهافقی * سینب + میانی * کسینب)) بعنوان صحیح

            // ضرب داخلی بردار عمود بر سطح در راستای نور (۰، ۱، −۱)، ضرب در ۸
            // تا روی نوار ۱۲ پله‌ای بنشیند. منفی یعنی آن تکه پشت به نور دارد؛
            // donut.c آن را به صفر می‌چسباند.
            تابش := (8.0 * ((سینت * سینآ - سینف * کسینت * کسینآ) * کسینب - سینف * کسینت * سینآ - سینت * کسینآ - کسینف * کسینت * سینب)) بعنوان صحیح

            اگر وای > 0 && وای < بلندا && ایکس > 0 && ایکس < پهنا:
                جا := ایکس + پهنا * وای
                اگر وارونعمق > عمق[جا]:
                    عمق[جا] = وارونعمق
                    اگر تابش > 0:
                        روشنایی[جا] = تابش
                    وگرنه:
                        روشنایی[جا] = 0
                    تمام
                تمام
            تمام

            فی = فی + گامفی
        تمام

        تتا = تتا + گامتتا
    تمام
تمام

// همان حلقه‌ی putchar در donut.c. فاصله‌های انتهایی بریده می‌شوند تا مقایسه‌ی
// قاب‌ها آسان بماند.
تابع نمایش:
    تکرار بلندا با ردیف:
        متغیر خط := ""
        تکرار پهنا با ستون:
            نمایه := روشنایی[ردیف * پهنا + ستون]
            اگر نمایه < 0:
                خط = خط.پیوست(" ")
            وگرنه:
                خط = خط.پیوست(نوار.زیررشته(نمایه, 1))
            تمام
        تمام
        چاپ رشته.پیرایش راست(خط)
    تمام
تمام

تابع اصلی:
    تکرار قابها با ک:
        چاپ "-- قاب", ک
        پاکسازی()
        ترسیم((ک بعنوان اعشار۶۴) * گامآ * چرخش, (ک بعنوان اعشار۶۴) * گامب * چرخش)
        نمایش()
    تمام
تمام
