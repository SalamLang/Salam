واردسازی ریاضی
واردسازی رشته

پایا پهنا := 80
پایا بلندا := 22
پایا خانهها := 1760

پایا نوار := ".,-~:;=!*#$@"

پایا مرکزافقی := 40.0
پایا مرکزعمودی := 12.0
پایا مقیاسافقی := 30.0
پایا مقیاسعمودی := 15.0

پایا شعاعکوچک := 1.0
پایا شعاعبزرگ := 2.0
پایا فاصله := 5.0

پایا گامتتا := 0.07
پایا گامفی := 0.02
پایا دور := 6.28

پایا گامآ := 0.04
پایا گامب := 0.02
پایا چرخش := 26.0
پایا قابها := 6

ناپایا روشنایی: صحیح[خانهها]
ناپایا عمق: اعشار۶۴[خانهها]

روال پاکسازی:
    تکرار خانهها از i:
        روشنایی[i] = -1
        عمق[i] = 0.0
    پایان
پایان

روال ترسیم(زاویهآ: اعشار۶۴, زاویهب: اعشار۶۴):
    سینآ := ریاضی.سینوس(زاویهآ)
    کسینآ := ریاضی.کسینوس(زاویهآ)
    سینب := ریاضی.سینوس(زاویهب)
    کسینب := ریاضی.کسینوس(زاویهب)

    ناپایا تتا := 0.0
    تا تتا < دور:
        سینت := ریاضی.سینوس(تتا)
        کسینت := ریاضی.کسینوس(تتا)

        دایرهافقی := شعاعبزرگ + شعاعکوچک * کسینت
        دایرهعمودی := شعاعکوچک * سینت

        ناپایا فی := 0.0
        تا فی < دور:
            سینف := ریاضی.سینوس(فی)
            کسینف := ریاضی.کسینوس(فی)

            وارونعمق := 1.0 / (سینف * دایرهافقی * سینآ + دایرهعمودی * کسینآ + فاصله)

            میانی := سینف * دایرهافقی * کسینآ - دایرهعمودی * سینآ

            ایکس := (مرکزافقی + مقیاسافقی * وارونعمق * (کسینف * دایرهافقی * کسینب - میانی * سینب)) برگردان صحیح
            وای := (مرکزعمودی + مقیاسعمودی * وارونعمق * (کسینف * دایرهافقی * سینب + میانی * کسینب)) برگردان صحیح

            تابش := (8.0 * ((سینت * سینآ - سینف * کسینت * کسینآ) * کسینب - سینف * کسینت * سینآ - سینت * کسینآ - کسینف * کسینت * سینب)) برگردان صحیح

            اگر وای > 0 && وای < بلندا && ایکس > 0 && ایکس < پهنا:
                جا := ایکس + پهنا * وای
                اگر وارونعمق > عمق[جا]:
                    عمق[جا] = وارونعمق
                    اگر تابش > 0:
                        روشنایی[جا] = تابش
                    وگرنه:
                        روشنایی[جا] = 0
                    پایان
                پایان
            پایان

            فی = فی + گامفی
        پایان

        تتا = تتا + گامتتا
    پایان
پایان

روال نمایش:
    تکرار بلندا از ردیف:
        ناپایا خط := ""
        تکرار پهنا از ستون:
            نمایه := روشنایی[ردیف * پهنا + ستون]
            اگر نمایه < 0:
                خط = خط.پیوست(" ")
            وگرنه:
                خط = خط.پیوست(نوار.زیررشته(نمایه, 1))
            پایان
        پایان
        سرچاپ رشته.پیرایش راست(خط)
    پایان
پایان

روال ریشه:
    تکرار قابها از ک:
        سرچاپ "-- قاب", ک
        پاکسازی()
        ترسیم((ک برگردان اعشار۶۴) * گامآ * چرخش, (ک برگردان اعشار۶۴) * گامب * چرخش)
        نمایش()
    پایان
پایان
