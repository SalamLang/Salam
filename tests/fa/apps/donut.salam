/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

واردکردن ریاضی
واردکردن رشته

ثابت پهنا := 80
ثابت بلندا := 22
ثابت خانهها := 1760

ثابت نوار := ".,-~:;=!*#$@"

ثابت مرکزافقی := 40.0
ثابت مرکزعمودی := 12.0
ثابت مقیاسافقی := 30.0
ثابت مقیاسعمودی := 15.0

ثابت شعاعکوچک := 1.0
ثابت شعاعبزرگ := 2.0
ثابت فاصله := 5.0

ثابت گامتتا := 0.07
ثابت گامفی := 0.02
ثابت دور := 6.28

ثابت گامآ := 0.04
ثابت گامب := 0.02
ثابت چرخش := 26.0
ثابت قابها := 6

متغیر روشنایی: صحیح[خانهها]
متغیر عمق: اعشار۶۴[خانهها]

تابع پاکسازی:
    تکرار خانهها با i:
        روشنایی[i] = -1
        عمق[i] = 0.0
    تمام
تمام

تابع ترسیم(زاویهآ: اعشار۶۴, زاویهب: اعشار۶۴):
    سینآ := ریاضی.سینوس(زاویهآ)
    کسینآ := ریاضی.کسینوس(زاویهآ)
    سینب := ریاضی.سینوس(زاویهب)
    کسینب := ریاضی.کسینوس(زاویهب)

    متغیر تتا := 0.0
    تاوقتی تتا < دور:
        سینت := ریاضی.سینوس(تتا)
        کسینت := ریاضی.کسینوس(تتا)

        دایرهافقی := شعاعبزرگ + شعاعکوچک * کسینت
        دایرهعمودی := شعاعکوچک * سینت

        متغیر فی := 0.0
        تاوقتی فی < دور:
            سینف := ریاضی.سینوس(فی)
            کسینف := ریاضی.کسینوس(فی)

            وارونعمق := 1.0 / (سینف * دایرهافقی * سینآ + دایرهعمودی * کسینآ + فاصله)

            میانی := سینف * دایرهافقی * کسینآ - دایرهعمودی * سینآ

            ایکس := (مرکزافقی + مقیاسافقی * وارونعمق * (کسینف * دایرهافقی * کسینب - میانی * سینب)) بعنوان صحیح
            وای := (مرکزعمودی + مقیاسعمودی * وارونعمق * (کسینف * دایرهافقی * سینب + میانی * کسینب)) بعنوان صحیح

            تابش := (8.0 * ((سینت * سینآ - سینف * کسینت * کسینآ) * کسینب - سینف * کسینت * سینآ - سینت * کسینآ - کسینف * کسینت * سینب)) بعنوان صحیح

            اگر وای > 0 && وای < بلندا && ایکس > 0 && ایکس < پهنا:
                جا := ایکس + پهنا * وای
                اگر وارونعمق > عمق[جا]:
                    عمق[جا] = وارونعمق
                    اگر تابش > 0:
                        روشنایی[جا] = تابش
                    وگرنه:
                        روشنایی[جا] = 0
                    تمام
                تمام
            تمام

            فی = فی + گامفی
        تمام

        تتا = تتا + گامتتا
    تمام
تمام

تابع نمایش:
    تکرار بلندا با ردیف:
        متغیر خط := ""
        تکرار پهنا با ستون:
            نمایه := روشنایی[ردیف * پهنا + ستون]
            اگر نمایه < 0:
                خط = خط.پیوست(" ")
            وگرنه:
                خط = خط.پیوست(نوار.زیررشته(نمایه, 1))
            تمام
        تمام
        چاپ رشته.پیرایش راست(خط)
    تمام
تمام

تابع اصلی:
    تکرار قابها با ک:
        چاپ "-- قاب", ک
        پاکسازی()
        ترسیم((ک بعنوان اعشار۶۴) * گامآ * چرخش, (ک بعنوان اعشار۶۴) * گامب * چرخش)
        نمایش()
    تمام
تمام
