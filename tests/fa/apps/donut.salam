فراخوانی ریاضی
فراخوانی رشته


پایدار پهنا := 80
پایدار بلندا := 22
پایدار خانهها := 1760

پایدار نوار := ".,-~:;=!*#$@"

پایدار مرکزافقی := 40.0
پایدار مرکزعمودی := 12.0
پایدار مقیاسافقی := 30.0
پایدار مقیاسعمودی := 15.0


پایدار شعاعکوچک := 1.0
پایدار شعاعبزرگ := 2.0
پایدار فاصله := 5.0

پایدار گامتتا := 0.07
پایدار گامفی := 0.02
پایدار دور := 6.28


پایدار گامآ := 0.04
پایدار گامب := 0.02
پایدار چرخش := 26.0
پایدار قابها := 6


گذرا روشنایی: صحیح[خانهها]
گذرا عمق: اعشار۶۴[خانهها]

کارکرد پاکسازی:
    چرخه خانهها با i:
        روشنایی[i] = -1
        عمق[i] = 0.0
    پایان
پایان

کارکرد ترسیم(زاویهآ: اعشار۶۴, زاویهب: اعشار۶۴):
    سینآ := ریاضی.سینوس(زاویهآ)
    کسینآ := ریاضی.کسینوس(زاویهآ)
    سینب := ریاضی.سینوس(زاویهب)
    کسینب := ریاضی.کسینوس(زاویهب)

    گذرا تتا := 0.0
    تاهنگام تتا < دور:
        سینت := ریاضی.سینوس(تتا)
        کسینت := ریاضی.کسینوس(تتا)

        دایرهافقی := شعاعبزرگ + شعاعکوچک * کسینت
        دایرهعمودی := شعاعکوچک * سینت

        گذرا فی := 0.0
        تاهنگام فی < دور:
            سینف := ریاضی.سینوس(فی)
            کسینف := ریاضی.کسینوس(فی)

            وارونعمق := 1.0 / (سینف * دایرهافقی * سینآ + دایرهعمودی * کسینآ + فاصله)

            میانی := سینف * دایرهافقی * کسینآ - دایرهعمودی * سینآ

            ایکس := (مرکزافقی + مقیاسافقی * وارونعمق * (کسینف * دایرهافقی * کسینب - میانی * سینب)) برگردان صحیح
            وای := (مرکزعمودی + مقیاسعمودی * وارونعمق * (کسینف * دایرهافقی * سینب + میانی * کسینب)) برگردان صحیح

            تابش := (8.0 * ((سینت * سینآ - سینف * کسینت * کسینآ) * کسینب - سینف * کسینت * سینآ - سینت * کسینآ - کسینف * کسینت * سینب)) برگردان صحیح

            اگر وای > 0 && وای < بلندا && ایکس > 0 && ایکس < پهنا:
                جا := ایکس + پهنا * وای
                اگر وارونعمق > عمق[جا]:
                    عمق[جا] = وارونعمق
                    اگر تابش > 0:
                        روشنایی[جا] = تابش
                    وگرنه:
                        روشنایی[جا] = 0
                    پایان
                پایان
            پایان

            فی = فی + گامفی
        پایان

        تتا = تتا + گامتتا
    پایان
پایان

کارکرد نمایش:
    چرخه بلندا با ردیف:
        گذرا خط := ""
        چرخه پهنا با ستون:
            نمایه := روشنایی[ردیف * پهنا + ستون]
            اگر نمایه < 0:
                خط = خط.پیوست(" ")
            وگرنه:
                خط = خط.پیوست(نوار.زیررشته(نمایه, 1))
            پایان
        پایان
        چاپ رشته.پیرایش راست(خط)
    پایان
پایان

کارکرد آغازین:
    چرخه قابها با ک:
        چاپ "-- قاب", ک
        پاکسازی()
        ترسیم((ک برگردان اعشار۶۴) * گامآ * چرخش, (ک برگردان اعشار۶۴) * گامب * چرخش)
        نمایش()
    پایان
پایان
