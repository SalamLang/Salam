// زبان: فارسی
صفحه:
    عنوان = "برنامه‌ی من"
    زبان = "فارسی"
    جهت = "راست به چپ"
    سرصفحه:
        پس‌زمینه = "آبی"
        رنگ = "سفید"
        فاصله داخلی = "20px"
        سرتیتر: اندازه = 1 محتوا = "خوش آمدید" اندازه قلم = "32px" تمام
    تمام
    جعبه:
        محتوا = "این یک صفحه‌ی نمونه به زبان فارسی است."
        رنگ = "سیاه"
    تمام
تمام
