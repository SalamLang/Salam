پایدار تعداد := 200
پایدار طول := 700

کارکرد آغازین:
    گذرا رقم: صحیح[701]
    چرخه طول با i:
        رقم[i] = 2000
    پایان

    چاپ "پی تا", تعداد, "رقم (الگوریتم اسپیگات نامحدود):"

    گذرا ک := طول
    گذرا باقی := 0
    گذرا اول := درست
    تاهنگام ک > 0:
        گذرا د := 0
        گذرا نمایه := ک
        تاهنگام نمایه > 0:
            د = د + رقم[نمایه] * 10000
            ب := 2 * نمایه - 1
            رقم[نمایه] = د % ب
            د = د / ب
            نمایه = نمایه - 1
            اگر نمایه > 0:
                د = د * نمایه
            پایان
        پایان
        ایکس := باقی + د / 10000
        گذرا گروه: صحیح[4]
        گروه[0] = ایکس / 1000
        گروه[1] = (ایکس / 100) % 10
        گروه[2] = (ایکس / 10) % 10
        گروه[3] = ایکس % 10
        چرخه 4 با ج:
            بنویس گروه[ج]
            اگر اول:
                بنویس "."
                اول = نادرست
            پایان
        پایان
        باقی = د % 10000
        ک = ک - 14
    پایان
    چاپ ""
پایان
