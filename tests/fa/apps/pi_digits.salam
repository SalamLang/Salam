پایا تعداد := 200
پایا طول := 700

روال ریشه:
    ناپایا رقم: صحیح[701]
    تکرار طول از i:
        رقم[i] = 2000
    پایان

    سرچاپ "پی تا", تعداد, "رقم (الگوریتم اسپیگات نامحدود):"

    ناپایا ک := طول
    ناپایا باقی := 0
    ناپایا اول := درست
    تا ک > 0:
        ناپایا د := 0
        ناپایا نمایه := ک
        تا نمایه > 0:
            د = د + رقم[نمایه] * 10000
            ب := 2 * نمایه - 1
            رقم[نمایه] = د % ب
            د = د / ب
            نمایه = نمایه - 1
            اگر نمایه > 0:
                د = د * نمایه
            پایان
        پایان
        ایکس := باقی + د / 10000
        ناپایا گروه: صحیح[4]
        گروه[0] = ایکس / 1000
        گروه[1] = (ایکس / 100) % 10
        گروه[2] = (ایکس / 10) % 10
        گروه[3] = ایکس % 10
        تکرار 4 از ج:
            چاپ گروه[ج]
            اگر اول:
                چاپ "."
                اول = نادرست
            پایان
        پایان
        باقی = د % 10000
        ک = ک - 14
    پایان
    سرچاپ ""
پایان
