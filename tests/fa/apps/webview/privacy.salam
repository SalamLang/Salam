واردسازی رابط گرافیکی.نمایش وب

تابع ریشه():
    ناپایا نما := نمایش وب.ایجاد(نادرست)
    دیرکن نما.نابود کردن()

    نما.تنظیم عنوان("نمایش وب قفل‌شده")
    نما.تنظیم اندازه(800, 600, نمایش وب.بدون اشاره)

    نما.تنظیم منوی زمینه(نادرست)
    نما.تنظیم ابزار توسعه(نادرست)
    نما.تنظیم ترجمه(نادرست)

    اگر نما.ابزار توسعه فعال است():
        سرچاپ "ابزار توسعه باید غیرفعال باشد"
    پایان
    اگر نما.ترجمه فعال است():
        سرچاپ "ترجمه باید غیرفعال باشد"
    پایان

    نما.باز کردن ابزار توسعه()

    نما.تنظیم ابزار توسعه(درست)
    اگر وارونه نما.ابزار توسعه فعال است():
        سرچاپ "ابزار توسعه باید فعال باشد"
    پایان
    نما.باز کردن ابزار توسعه()

    نما.تنظیم اچ تی ام ال("<h1>قفل‌شده</h1>")
    نما.اجرا()
پایان
