روال ریشه:
    آ := [10, 20, 30, 40, 50, 60]
    ناپایا مجموع := 0
    تکرار 6 از i: مجموع = مجموع + آ[i] پایان
    میانگین := (مجموع برگردان اعشار۶۴) / 6.0
    سرچاپ "مجموع =", مجموع
    سرچاپ "میانگین =", میانگین
پایان
