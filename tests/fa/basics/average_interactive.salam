فراخوانی ورودی خروجی

کارکرد آغازین:
    گذرا مجموع := 0.0
    گذرا تعداد := 0
    گذرا پاسخ := "y"

    تاهنگام پاسخ == "y":
        بنویس "یک عدد وارد کنید: "
        خط := ورودی خروجی.بخوان ()
        عدد := خط.به اعشار()
        مجموع = مجموع + عدد
        تعداد = تعداد + 1
        بنویس "آیا می‌خواهید ادامه دهید؟ (y برای بله/n برای خیر): "
        پاسخ = ورودی خروجی.بخوان ().پیراست()
    پایان

    اگر تعداد > 0:
        میانگین := مجموع / (تعداد برگردان اعشار۶۴)
        چاپ "میانگین برابر است با:", میانگین
    وگرنه:
        چاپ "هیچ عددی وارد نشد."
    پایان
پایان
