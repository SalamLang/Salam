واردسازی ورودی خروجی

روال ریشه:
    ناپایا مجموع := 0.0
    ناپایا تعداد := 0
    ناپایا پاسخ := "y"

    تا پاسخ == "y":
        چاپ "یک عدد وارد کنید: "
        خط := ورودی خروجی.بخوان()
        عدد := خط.به اعشار()
        مجموع = مجموع + عدد
        تعداد = تعداد + 1
        چاپ "آیا می‌خواهید ادامه دهید؟ (y برای بله/n برای خیر): "
        پاسخ = ورودی خروجی.بخوان().پیراست()
    پایان

    اگر تعداد > 0:
        میانگین := مجموع / (تعداد برگردان اعشار۶۴)
        سرچاپ "میانگین برابر است با:", میانگین
    وگرنه:
        سرچاپ "هیچ عددی وارد نشد."
    پایان
پایان
