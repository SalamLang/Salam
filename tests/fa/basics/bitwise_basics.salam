// زبان: فارسی
تابع دودویی(ن: صحیح, پهنا: صحیح): رشته:
    متغیر س := ""
    متغیر نمایه := پهنا - 1
    تاوقتی نمایه >= 0:
        س = س + ((ن >> نمایه) & 1)
        نمایه = نمایه - 1
    تمام
    بازگشت س
تمام

تابع اصلی:
    الف := 12
    ب := 10

    چاپ "الف        =", الف, دودویی(الف, 8)
    چاپ "ب          =", ب, دودویی(ب, 8)
    چاپ "الف و ب    =", الف & ب, دودویی(الف & ب, 8)
    چاپ "الف یا ب   =", الف | ب, دودویی(الف | ب, 8)
    چاپ "الف یای ب  =", الف ^ ب, دودویی(الف ^ ب, 8)
    چاپ "نقیض الف   =", ~الف, دودویی(~الف, 8)

    چاپ "الف << 1   =", الف << 1, دودویی(الف << 1, 8)
    چاپ "الف << 2   =", الف << 2, دودویی(الف << 2, 8)
    چاپ "الف >> 1   =", الف >> 1, دودویی(الف >> 1, 8)
    چاپ "الف >> 2   =", الف >> 2, دودویی(الف >> 2, 8)

    چاپ "شیفت چپ یک برابر ضرب در دو است:", (الف << 1) == الف * 2
    چاپ "شیفت راست دو برابر تقسیم بر چهار است:", (الف >> 2) == الف / 4
تمام
