روال دودویی(ن: صحیح, پهنا: صحیح): رشته:
    ناپایا س := ""
    ناپایا نمایه := پهنا - 1
    تا نمایه >= 0:
        س = س + ((ن >> نمایه) & 1)
        نمایه = نمایه - 1
    پایان
    برگشت س
پایان

روال ریشه:
    الف := 12
    ب := 10

    سرچاپ "الف        =", الف, دودویی(الف, 8)
    سرچاپ "ب          =", ب, دودویی(ب, 8)
    سرچاپ "الف و ب    =", الف & ب, دودویی(الف & ب, 8)
    سرچاپ "الف یا ب   =", الف | ب, دودویی(الف | ب, 8)
    سرچاپ "الف یای ب  =", الف ^ ب, دودویی(الف ^ ب, 8)
    سرچاپ "نقیض الف   =", ~الف, دودویی(~الف, 8)

    سرچاپ "الف << 1   =", الف << 1, دودویی(الف << 1, 8)
    سرچاپ "الف << 2   =", الف << 2, دودویی(الف << 2, 8)
    سرچاپ "الف >> 1   =", الف >> 1, دودویی(الف >> 1, 8)
    سرچاپ "الف >> 2   =", الف >> 2, دودویی(الف >> 2, 8)

    سرچاپ "شیفت چپ یک برابر ضرب در دو است:", (الف << 1) == الف * 2
    سرچاپ "شیفت راست دو برابر تقسیم بر چهار است:", (الف >> 2) == الف / 4
پایان
