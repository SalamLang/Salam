ناپایا پیام := ""

ساختار نقطه:
    ایکس: صحیح
    ایگرگ: صحیح
پایان

تابع کارگر():
    پیام = "نخ کار کرد"
پایان

تابع ریشه:
    الف := [۱، ۲، ۳]
    سرچاپ طول(الف)
    سرچاپ اندازه(صحیح)، اندازه(نقطه)
    سرچاپ زبان()
    سرچاپ درهم("سلام") نابرابر ۰
    ر := نخ‌ساز(کارگر)
    نخ‌پیوند(ر)
    سرچاپ پیام
پایان
