ناپایا پیام := ""

ساختار نقطه:
    ایکس: صحیح
    ایگرگ: صحیح
پایان

روال کارگر():
    پیام = "نخ کار کرد"
پایان

روال ریشه:
    الف := [۱، ۲، ۳]
    سرچاپ طول(الف)
    سرچاپ اندازه‌گونه(صحیح)، اندازه‌گونه(نقطه)
    سرچاپ زبان()
    سرچاپ درهم("سلام") != ۰
    ر := نخ‌ساز(کارگر)
    نخ‌پیوند(ر)
    سرچاپ پیام
پایان
