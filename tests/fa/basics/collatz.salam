// زبان: فارسی
تابع اصلی:
    متغیر ن := 27
    متغیر گامها := 0
    چاپ "کولاتز از", ن
    تاوقتی ن != 1:
        اگر ن % 2 == 0: ن = ن / 2
        وگرنه:
            ن = 3 * ن + 1
        تمام
        گامها = گامها + 1
    تمام
    چاپ "در", گامها, "گام به ۱ رسید"
تمام
