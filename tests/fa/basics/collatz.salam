کارکرد آغازین:
    گذرا ن := 27
    گذرا گامها := 0
    چاپ "کولاتز از", ن
    تاهنگام ن != 1:
        اگر ن % 2 == 0: ن = ن / 2
        وگرنه:
            ن = 3 * ن + 1
        پایان
        گامها = گامها + 1
    پایان
    چاپ "در", گامها, "گام به ۱ رسید"
پایان
