روال ریشه:
    ناپایا ن := 27
    ناپایا گامها := 0
    سرچاپ "کولاتز از", ن
    تا ن != 1:
        اگر ن % 2 == 0: ن = ن / 2
        وگرنه:
            ن = 3 * ن + 1
        پایان
        گامها = گامها + 1
    پایان
    سرچاپ "در", گامها, "گام به ۱ رسید"
پایان
