// زبان: فارسی
تابع درجه(نمره: صحیح): رشته:
    اگر نمره >= 90:
        بازگشت "الف"
    وگرنه نمره >= 75:
        بازگشت "ب"
    وگرنه نمره >= 60:
        بازگشت "ج"
    وگرنه:
        بازگشت "مردود"
    تمام
تمام

تابع اصلی:
    چاپ درجه(95), درجه(80), درجه(65), درجه(40)
تمام
