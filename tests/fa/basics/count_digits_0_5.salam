واردسازی ورودی خروجی

تابع ریشه:
    سرچاپ "یک عدد وارد کنید:"
    عدد := ورودی خروجی.بخوان()
    ناپایا تعداد := 0

    تکرار عدد.طول() در i:
        حرف := عدد.زیررشته(i, 1)
        اگر حرف برابر "0" یا حرف برابر "5":
            تعداد++
        پایان
    پایان

    سرچاپ "تعداد رقم‌های ۰ و ۵:", تعداد
پایان
