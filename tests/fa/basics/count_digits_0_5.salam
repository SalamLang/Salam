واردسازی ورودی خروجی

روال ریشه:
    سرچاپ "یک عدد وارد کنید:"
    عدد := ورودی خروجی.بخوان()
    ناپایا تعداد := 0

    تکرار عدد.طول() از i:
        حرف := عدد.زیررشته(i, 1)
        اگر حرف == "0" یا حرف == "5":
            تعداد = تعداد + 1
        پایان
    پایان

    سرچاپ "تعداد رقم‌های ۰ و ۵:", تعداد
پایان
