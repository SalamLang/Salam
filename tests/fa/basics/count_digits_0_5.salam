فراخوانی ورودی خروجی

کارکرد آغازین:
    چاپ "یک عدد وارد کنید:"
    عدد := ورودی خروجی.بخوان ()
    گذرا تعداد := 0

    چرخه عدد.طول() با i:
        حرف := عدد.زیررشته(i, 1)
        اگر حرف == "0" یا حرف == "5":
            تعداد = تعداد + 1
        پایان
    پایان

    چاپ "تعداد رقم‌های ۰ و ۵:", تعداد
پایان
