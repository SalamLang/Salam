تابع به دودویی(ن: صحیح): رشته:
    اگر ن برابر 0: برگشت "0" پایان
    ناپایا ایکس := ن
    ناپایا بیتها := ""
    تا ایکس بزرگتر 0:
        بیتها = "" + (ایکس % 2) + بیتها
        ایکس /= 2
    پایان
    برگشت بیتها
پایان

تابع ریشه:
    اعداد := [0, 5, 10, 255]
    تکرار 4 در i:
        سرچاپ اعداد[i], "در مبنای دو =", به دودویی(اعداد[i])
    پایان
پایان
