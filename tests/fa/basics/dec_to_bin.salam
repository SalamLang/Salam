کارکرد به دودویی(ن: صحیح): رشته:
    اگر ن == 0: بازگشت "0" پایان
    گذرا ایکس := ن
    گذرا بیتها := ""
    تاهنگام ایکس > 0:
        بیتها = "" + (ایکس % 2) + بیتها
        ایکس = ایکس / 2
    پایان
    بازگشت بیتها
پایان

کارکرد آغازین:
    اعداد := [0, 5, 10, 255]
    چرخه 4 با i:
        چاپ اعداد[i], "در مبنای دو =", به دودویی(اعداد[i])
    پایان
پایان
