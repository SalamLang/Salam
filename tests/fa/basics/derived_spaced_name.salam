واردسازی کدگذاری.جیسون

ساختار محدودیت‌ها:
    @جیسون "max_upload"
    همگانی بیشترین بارگذاری: صحیح۶۴ = ۰
    @جیسون "code"
    همگانی کد: رشته = ""
پایان

تابع ریشه:
    ناپایا م := محدودیت‌ها {}
    تلاش:
        جیسون.واسریال سازی آسان گیر("{\"max_upload\": 5, \"code\": \"x\"}"، م)
        سرچاپ م.بیشترین بارگذاری، م.کد
    گرفتن خطا خ:
        سرچاپ "رد شد:"، خ.پیام
    پایان
پایان
