تابع جمع ارقام(ن: صحیح): صحیح:
    ناپایا ایکس := ن
    ناپایا مجموع := 0
    تا ایکس بزرگتر 0:
        مجموع += ایکس % 10
        ایکس /= 10
    پایان
    برگشت مجموع
پایان

تابع ریشه:
    سرچاپ "جمع ارقام ۱۲۳۴۵ =", جمع ارقام(12345)
    سرچاپ "جمع ارقام ۹۹ =", جمع ارقام(99)
پایان
