کارکرد توان(پایه: صحیح, نما: صحیح): صحیح:
    گذرا نتیجه := 1
    چرخه نما:
        نتیجه = نتیجه * پایه
    پایان
    بازگشت نتیجه
پایان

کارکرد بیشینه(الف: صحیح, ب: صحیح): صحیح:
    اگر الف > ب:
        بازگشت الف
    پایان
    بازگشت ب
پایان

کارکرد آغازین:
    چاپ "دو به توان ده:", توان(2, 10)
    چاپ "بیشینه:", بیشینه(توان(2, 4), توان(3, 2))
پایان
