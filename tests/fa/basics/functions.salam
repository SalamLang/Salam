تابع توان(پایه: صحیح, نما: صحیح): صحیح:
    ناپایا نتیجه := 1
    تکرار نما:
        نتیجه *= پایه
    پایان
    برگشت نتیجه
پایان

تابع بیشینه(الف: صحیح, ب: صحیح): صحیح:
    اگر الف بزرگتر ب:
        برگشت الف
    پایان
    برگشت ب
پایان

تابع ریشه:
    سرچاپ "دو به توان ده:", توان(2, 10)
    سرچاپ "بیشینه:", بیشینه(توان(2, 4), توان(3, 2))
پایان
