فراخوانی ورودی خروجی

کارکرد بمم(الف: صحیح, ب: صحیح): صحیح:
    گذرا ایکس := الف
    گذرا ایگرگ := ب

    تاهنگام ایگرگ != 0:
        ت := ایگرگ
        ایگرگ = ایکس % ایگرگ
        ایکس = ت
    پایان

    بازگشت ایکس
پایان

کارکرد آغازین:
    چرخه 10:
        بنویس "عدد اول: "

        الف := ورودی خروجی.بخوان ().به صحیح()
        بنویس "عدد دوم: "

        ب := ورودی خروجی.بخوان ().به صحیح()
        چاپ "ب.م.م", الف, "و", ب, "=", بمم(الف, ب)
    پایان
پایان
