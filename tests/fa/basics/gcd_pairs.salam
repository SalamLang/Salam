واردسازی ورودی خروجی

روال بمم(الف: صحیح, ب: صحیح): صحیح:
    ناپایا ایکس := الف
    ناپایا ایگرگ := ب

    تا ایگرگ != 0:
        ت := ایگرگ
        ایگرگ = ایکس % ایگرگ
        ایکس = ت
    پایان

    برگشت ایکس
پایان

روال ریشه:
    تکرار 10:
        چاپ "عدد اول: "

        الف := ورودی خروجی.بخوان().به صحیح()
        چاپ "عدد دوم: "

        ب := ورودی خروجی.بخوان().به صحیح()
        سرچاپ "ب.م.م", الف, "و", ب, "=", بمم(الف, ب)
    پایان
پایان
