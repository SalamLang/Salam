تابع بمم(الف: صحیح, ب: صحیح): صحیح:
    ناپایا ایکس := الف
    ناپایا ایگرگ := ب
    تا ایگرگ نابرابر 0:
        ت := ایگرگ
        ایگرگ = ایکس % ایگرگ
        ایکس = ت
    پایان
    برگشت ایکس
پایان

تابع کمم(الف: صحیح, ب: صحیح): صحیح: برگشت الف / بمم(الف, ب) * ب پایان

تابع ریشه:
    سرچاپ "ک.م.م ۴ و ۶ =", کمم(4, 6)
    سرچاپ "ک.م.م ۲۱ و ۶ =", کمم(21, 6)
پایان
