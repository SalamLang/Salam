کارکرد بمم(الف: صحیح, ب: صحیح): صحیح:
    گذرا ایکس := الف
    گذرا ایگرگ := ب
    تاهنگام ایگرگ != 0:
        ت := ایگرگ
        ایگرگ = ایکس % ایگرگ
        ایکس = ت
    پایان
    بازگشت ایکس
پایان

کارکرد کمم(الف: صحیح, ب: صحیح): صحیح: بازگشت الف / بمم(الف, ب) * ب پایان

کارکرد آغازین:
    چاپ "ک.م.م ۴ و ۶ =", کمم(4, 6)
    چاپ "ک.م.م ۲۱ و ۶ =", کمم(21, 6)
پایان
