روال کبیسه است(سال: صحیح): منطقی:
    اگر سال % 400 == 0: برگشت درست پایان
    اگر سال % 100 == 0: برگشت نادرست پایان
    برگشت سال % 4 == 0
پایان

روال ریشه:
    سالها := [1900, 2000, 2012, 2021, 2024]
    تکرار 5 از i:
        اگر کبیسه است(سالها[i]): سرچاپ سالها[i], "کبیسه است"
        وگرنه:
            سرچاپ سالها[i], "کبیسه نیست"
        پایان
    پایان
پایان
