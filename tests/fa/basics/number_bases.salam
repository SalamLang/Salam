بسته ریشه

تابع جفت(الف: صحیح، ب: صحیح): صحیح:
    برگشت الف * 1000 + ب
پایان

تابع ریشه:
    سرچاپ 0xA5
    سرچاپ 0x3C
    سرچاپ جفت(0xA5، 0x3C)
    سرچاپ جفت(0b1010، 0b11)
    سرچاپ جفت(0o17، 0o7)
    سرچاپ جفت(0XFF، 0B1)
    سرچاپ جفت(0O10، 0xA53C)
    آرایه := [0xA5، 0x3C، 0x01]
    سرچاپ جفت(آرایه[0]، آرایه[1])
    سرچاپ آرایه[2]
    سرچاپ 0xDEAD_BEEF
    سرچاپ 1_000_000
    سرچاپ جفت(0x7F، 0b0)
    آرایه۲ := [1.5f، 2.5f]
    سرچاپ آرایه۲[0]
    سرچاپ آرایه۲[1]
    سرچاپ 1.5f
    برگشت 0
پایان
