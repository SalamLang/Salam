کارکرد متقارن است(ن: صحیح): منطقی:
    گذرا ایکس := ن
    گذرا وارون := 0
    تاهنگام ایکس > 0:
        وارون = وارون * 10 + ایکس % 10
        ایکس = ایکس / 10
    پایان
    بازگشت وارون == ن
پایان

کارکرد آغازین:
    اعداد := [121, 123, 1221, 13]
    چرخه 4 با i:
        اگر متقارن است(اعداد[i]): چاپ اعداد[i], "متقارن است"
        وگرنه:
            چاپ اعداد[i], "متقارن نیست"
        پایان
    پایان
پایان
