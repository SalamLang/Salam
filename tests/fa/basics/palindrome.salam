تابع متقارن است(ن: صحیح): منطقی:
    ناپایا ایکس := ن
    ناپایا برعکس := 0
    تا ایکس بزرگتر 0:
        برعکس = برعکس * 10 + ایکس % 10
        ایکس /= 10
    پایان
    برگشت برعکس برابر ن
پایان

تابع ریشه:
    اعداد := [121, 123, 1221, 13]
    تکرار 4 در i:
        اگر متقارن است(اعداد[i]): سرچاپ اعداد[i], "متقارن است"
        وگرنه:
            سرچاپ اعداد[i], "متقارن نیست"
        پایان
    پایان
پایان
