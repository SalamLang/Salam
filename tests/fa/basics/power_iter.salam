روال توان(پایه: صحیح, نما: صحیح): صحیح:
    ناپایا نتیجه := 1
    تکرار نما: نتیجه = نتیجه * پایه پایان
    برگشت نتیجه
پایان

روال ریشه:
    تکرار 0 تا 8 از e:
        سرچاپ "۲ به توان", e, "=", توان(2, e)
    پایان
پایان
