// زبان: فارسی
تابع توان(پایه: صحیح, نما: صحیح): صحیح:
    متغیر نتیجه := 1
    تکرار نما با i: نتیجه = نتیجه * پایه تمام
    بازگشت نتیجه
تمام

تابع اصلی:
    تکرار 0 تا 8 با e:
        چاپ "۲ به توان", e, "=", توان(2, e)
    تمام
تمام
