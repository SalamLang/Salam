تابع توان(پایه: صحیح, نما: صحیح): صحیح:
    ناپایا نتیجه := 1
    تکرار نما: نتیجه *= پایه پایان
    برگشت نتیجه
پایان

تابع ریشه:
    تکرار 0 تا 8 در e:
        سرچاپ "۲ به توان", e, "=", توان(2, e)
    پایان
پایان
