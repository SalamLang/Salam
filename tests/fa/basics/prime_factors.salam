تابع ریشه:
    ن := 360
    ناپایا ایکس := ن
    ناپایا خط := ""
    ناپایا د := 2
    تا د * د کوچکتربرابر ایکس:
        تا ایکس % د برابر 0:
            خط = خط + د + " "
            ایکس /= د
        پایان
        د++
    پایان
    اگر ایکس بزرگتر 1: خط = خط + ایکس + " " پایان
    سرچاپ ن, "=", خط
پایان
