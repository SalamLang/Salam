کارکرد آغازین:
    ن := 360
    گذرا ایکس := ن
    گذرا خط := ""
    گذرا د := 2
    تاهنگام د * د <= ایکس:
        تاهنگام ایکس % د == 0:
            خط = خط + د + " "
            ایکس = ایکس / د
        پایان
        د = د + 1
    پایان
    اگر ایکس > 1: خط = خط + ایکس + " " پایان
    چاپ ن, "=", خط
پایان
