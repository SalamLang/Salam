روال ریشه:
    ن := 100
    ناپایا مجموع := 0
    تکرار 1 تا ن از i: مجموع = مجموع + i پایان
    فرمول := ن * (ن + 1) / 2
    سرچاپ "مجموع حلقه =", مجموع
    سرچاپ "مجموع فرمول =", فرمول
پایان
