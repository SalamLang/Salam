// زبان: فارسی
تابع اصلی:
    ن := 100
    متغیر مجموع := 0
    تکرار 1 تا ن با i: مجموع = مجموع + i تمام
    فرمول := ن * (ن + 1) / 2
    چاپ "مجموع حلقه =", مجموع
    چاپ "مجموع فرمول =", فرمول
تمام
