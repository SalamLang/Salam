روال فاکتوریل(ن: صحیح۶۴): صحیح۶۴:
    اگر ن <= 1:
        برگشت 1
    پایان
    برگشت ن * فاکتوریل(ن - 1)
پایان

روال فیبوناچی(ن: صحیح): صحیح:
    اگر ن < 2:
        برگشت ن
    پایان
    برگشت فیبوناچی(ن - 1) + فیبوناچی(ن - 2)
پایان

روال ریشه:
    سرچاپ فاکتوریل(10)
    سرچاپ فیبوناچی(10)
پایان
