کارکرد آغازین:
    چرخه 5:
        چاپ "تست"
    پایان

    تعداد := 3
    چرخه تعداد:
        بنویس "x"
    پایان
    چاپ ""

    چرخه 1 تا 5:
        بنویس "#"
    پایان
    چاپ ""

    چرخه 0 تا 100 گام 10:
        بنویس "."
    پایان
    چاپ ""
پایان
