روال ریشه:
    تکرار 5:
        سرچاپ "تست"
    پایان

    تعداد := 3
    تکرار تعداد:
        چاپ "x"
    پایان
    سرچاپ ""

    تکرار 1 تا 5:
        چاپ "#"
    پایان
    سرچاپ ""

    تکرار 0 تا 100 هر 10:
        چاپ "."
    پایان
    سرچاپ ""
پایان
