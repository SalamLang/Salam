// زبان: فارسی
تابع اصلی:
    تکرار 5:
        چاپ "تست"
    تمام

    تعداد := 3
    تکرار تعداد:
        بنویس "x"
    تمام
    چاپ ""

    تکرار 1 تا 5:
        بنویس "#"
    تمام
    چاپ ""

    تکرار 0 تا 100 گام 10:
        بنویس "."
    تمام
    چاپ ""
تمام
