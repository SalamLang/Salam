ساختار جدول:
    همگانی سطر: صحیح = 3
    همگانی ستون: صحیح = 2
پایان

ساختار تخته:
    همگانی اندازه: جدول = جدول {}
    همگانی کف: صحیح = 1
    همگانی سقف: صحیح = 4
    همگانی پرش: صحیح = 2
پایان

کارکرد آغازین:
    ج := جدول {}
    چرخه ج.سطر با شمارنده:
        بنویس شمارنده
    پایان
    چاپ ""

    ت := تخته {}
    چرخه ت.اندازه.ستون با ک:
        بنویس ک
    پایان
    چاپ ""

    چرخه ت.کف تا ت.سقف با م:
        بنویس م
    پایان
    چاپ ""

    چرخه ت.کف تا ت.سقف گام ت.پرش با ن:
        بنویس ن
    پایان
    چاپ ""
پایان
