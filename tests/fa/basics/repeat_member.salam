// زبان: فارسی
// کران حلقه که به دسترسی فیلد ختم می‌شود باید پیش از «با» متوقف شود،
// وگرنه نام عضو، متغیر شمارنده را در خود می‌بلعد.

ساختار جدول:
    عمومی سطر: صحیح = 3
    عمومی ستون: صحیح = 2
تمام

ساختار تخته:
    عمومی اندازه: جدول = جدول {}
    عمومی کف: صحیح = 1
    عمومی سقف: صحیح = 4
    عمومی پرش: صحیح = 2
تمام

تابع اصلی:
    ج := جدول {}
    تکرار ج.سطر با شمارنده:
        بنویس شمارنده
    تمام
    چاپ ""

    ت := تخته {}
    تکرار ت.اندازه.ستون با ک:
        بنویس ک
    تمام
    چاپ ""

    تکرار ت.کف تا ت.سقف با م:
        بنویس م
    تمام
    چاپ ""

    تکرار ت.کف تا ت.سقف گام ت.پرش با ن:
        بنویس ن
    تمام
    چاپ ""
تمام
