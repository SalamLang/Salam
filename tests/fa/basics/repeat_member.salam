ساختار جدول:
    همگانی سطر: صحیح = 3
    همگانی ستون: صحیح = 2
پایان

ساختار تخته:
    همگانی اندازه: جدول = جدول {}
    همگانی کف: صحیح = 1
    همگانی سقف: صحیح = 4
    همگانی پرش: صحیح = 2
پایان

روال ریشه:
    ج := جدول {}
    تکرار ج.سطر از شمارنده:
        چاپ شمارنده
    پایان
    سرچاپ ""

    ت := تخته {}
    تکرار ت.اندازه.ستون از ک:
        چاپ ک
    پایان
    سرچاپ ""

    تکرار ت.کف تا ت.سقف از م:
        چاپ م
    پایان
    سرچاپ ""

    تکرار ت.کف تا ت.سقف هر ت.پرش از ن:
        چاپ ن
    پایان
    سرچاپ ""
پایان
