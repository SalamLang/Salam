تابع ریشه:
    ناپایا مجموع := 0
    ناپایا ک := 0
    تکرار 1 تا 10:
        ک++
        مجموع += ک
    پایان
    چاپ "۱+۲+...+۱۰ = "
    سرچاپ مجموع

    ناپایا سطر := 0
    تکرار 1 تا 5:
        سطر++
        تکرار 1 تا سطر:
            چاپ "*"
        پایان
        سرچاپ ""
    پایان
پایان
