روال ریشه:
    ناپایا مجموع := 0
    ناپایا ک := 0
    تکرار 1 تا 10:
        ک = ک + 1
        مجموع = مجموع + ک
    پایان
    چاپ "۱+۲+...+۱۰ = "
    سرچاپ مجموع

    ناپایا سطر := 0
    تکرار 1 تا 5:
        سطر = سطر + 1
        تکرار 1 تا سطر:
            چاپ "*"
        پایان
        سرچاپ ""
    پایان
پایان
