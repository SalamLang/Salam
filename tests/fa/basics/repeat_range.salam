کارکرد آغازین:
    گذرا مجموع := 0
    گذرا ک := 0
    چرخه 1 تا 10:
        ک = ک + 1
        مجموع = مجموع + ک
    پایان
    بنویس "۱+۲+...+۱۰ = "
    چاپ مجموع

    گذرا سطر := 0
    چرخه 1 تا 5:
        سطر = سطر + 1
        چرخه 1 تا سطر:
            بنویس "*"
        پایان
        چاپ ""
    پایان
پایان
