روال ریشه:
    ناپایا زوج ها := 0
    تکرار 0 تا 20 هر 2:
        زوج ها = زوج ها + 1
    پایان
    چاپ "تعداد زوج‌ها در ۰ تا ۲۰: "
    سرچاپ زوج ها

    چاپ "مقیاس:"
    ناپایا نشانه := 0
    تکرار 0 تا 100 هر 10:
        چاپ " |"
        نشانه = نشانه + 1
    پایان
    سرچاپ ""
    چاپ "تعداد نشانه‌ها: "
    سرچاپ نشانه

    پایه := 3
    ناپایا ضرب ها := 0
    تکرار 0 تا 30 هر پایه * 5:
        ضرب ها = ضرب ها + 1
    پایان
    چاپ "۰ تا ۳۰ هر ۱۵ -> "
    سرچاپ ضرب ها
پایان
