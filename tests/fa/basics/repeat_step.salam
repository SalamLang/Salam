// زبان: فارسی
تابع اصلی:
    متغیر زوج ها := 0
    تکرار 0 تا 20 گام 2:
        زوج ها = زوج ها + 1
    تمام
    بنویس "تعداد زوج‌ها در ۰ تا ۲۰: "
    چاپ زوج ها

    بنویس "مقیاس:"
    متغیر نشانه := 0
    تکرار 0 تا 100 گام 10:
        بنویس " |"
        نشانه = نشانه + 1
    تمام
    چاپ ""
    بنویس "تعداد نشانه‌ها: "
    چاپ نشانه

    پایه := 3
    متغیر ضرب ها := 0
    تکرار 0 تا 30 گام پایه * 5:
        ضرب ها = ضرب ها + 1
    تمام
    بنویس "۰ تا ۳۰ هر ۱۵ -> "
    چاپ ضرب ها
تمام
