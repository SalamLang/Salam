کارکرد آغازین:
    گذرا زوج ها := 0
    چرخه 0 تا 20 گام 2:
        زوج ها = زوج ها + 1
    پایان
    بنویس "تعداد زوج‌ها در ۰ تا ۲۰: "
    چاپ زوج ها

    بنویس "مقیاس:"
    گذرا نشانه := 0
    چرخه 0 تا 100 گام 10:
        بنویس " |"
        نشانه = نشانه + 1
    پایان
    چاپ ""
    بنویس "تعداد نشانه‌ها: "
    چاپ نشانه

    پایه := 3
    گذرا ضرب ها := 0
    چرخه 0 تا 30 گام پایه * 5:
        ضرب ها = ضرب ها + 1
    پایان
    بنویس "۰ تا ۳۰ هر ۱۵ -> "
    چاپ ضرب ها
پایان
