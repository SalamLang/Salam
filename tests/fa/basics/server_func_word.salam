واردسازی شبکه.اچ تی تی پی

ساختار پایگاه:
    همگانی سرور: رشته = ""
    همگانی درگاه: صحیح = 0
پایان

ساختار کالا:
    همگانی نام: رشته = ""
    همگانی بها: اعشار۶۴ = 0.0
پایان

سرور تابع قیمت(شناسه: صحیح): اعشار۶۴?: اگر شناسه برابر 1: برگشت 2.5
پایان
برگشت پوچ
پایان

همگانی سرور تابع کالاها(برچسب: رشته): وکتور<کالا>: ناپایا خروجی := وکتور {} برگردان وکتور<کالا>
خروجی.بیفزا(کالا { نام = برچسب، بها = 1.5 })
برگشت خروجی
پایان

سرور تابع بگیر نام‌ها(پیش‌نام کاربر: رشته): رشته: برگشت پیش‌نام کاربر + " سلام"
پایان

تابع ریشه:
    سرور := "محلی"
    پ := پایگاه { سرور = سرور، درگاه = 80 }
    ناپایا خدمتگزار := اچ تی تی پی.سرور جدید(پ.درگاه)
    سرچاپ پ.سرور
    ق := قیمت(1)
    سرچاپ ق.موجود
    سرچاپ کالاها("قلم")[0].نام
    اچ تی تی پی.پنهان سازی توکن(خدمتگزار)
    سرچاپ پ.درگاه
    سرچاپ بگیر نام‌ها("علی")
پایان
