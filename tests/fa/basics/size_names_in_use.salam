ساختار کیسه:
    همگانی قلم: صحیح

    همگانی تابع اندازه(): صحیح:
        برگشت این.قلم
    پایان

    همگانی تابع اندازه‌گونه(): صحیح:
        برگشت این.قلم * 2
    پایان
پایان

تابع ریشه:
    ک := کیسه { قلم = 5 }
    اندازه := 3
    اندازه‌گونه := 4
    سرچاپ ک.اندازه()، ک.اندازه‌گونه()، اندازه، اندازه‌گونه
    سرچاپ اندازه(صحیح۳۲)، اندازه(کیسه)
پایان
