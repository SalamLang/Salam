روال جمع(نما: صحیح[:]): صحیح:
    ناپایا مجموع := 0
    تکرار len(نما) از i:
        مجموع = مجموع + نما[i]
    پایان
    برگشت مجموع
پایان

روال ریشه:
    داده := [1, 2, 3, 4, 5, 6, 7, 8]

    میانه := داده[2: 6]
    سرچاپ "میانه:", میانه[0], میانه[1], میانه[2], میانه[3]
    سرچاپ "طول میانه:", len(میانه)

    سرچاپ "سه عنصر نخست:", داده[: 3][0], داده[: 3][1], داده[: 3][2]
    سرچاپ "از اندیس ۵:", len(داده[5:])

    ناپایا دنباله := داده[6:]
    دنباله[0] = 70
    دنباله[1] = 80
    سرچاپ "داده پس از نوشتن از طریق برش:", داده[6], داده[7]

    سرچاپ "جمع کل   =", جمع(داده[:])
    سرچاپ "جمع میانه =", جمع(میانه)
پایان
