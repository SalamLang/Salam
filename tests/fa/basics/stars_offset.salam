واردسازی ورودی خروجی

تابع ریشه:
    ن := ورودی خروجی.بخوان().به صحیح()

    تکرار ن در i:
        ناپایا خط := ""

        اگر i % 2 برابر 0:
            خط = " "
        پایان

        تکرار ن:
            خط += "* "
        پایان
        سرچاپ خط
    پایان
پایان
