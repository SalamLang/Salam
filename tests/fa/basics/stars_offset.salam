// زبان: فارسی
واردکردن ورودی خروجی

تابع اصلی:
    ن := ورودی خروجی.بخوان ().به صحیح()

    تکرار ن با i:
        متغیر خط := ""

        اگر i % 2 == 0:
            خط = " "
        تمام

        تکرار ن با j:
            خط = خط + "* "
        تمام
        چاپ خط
    تمام
تمام
