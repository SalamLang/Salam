روال ریشه:
    ناپایا مجموع := 0
    ناپایا i := 1
    تا i <= 10:
        مجموع = مجموع + i
        i = i + 1
    پایان
    سرچاپ "مجموع ۱ تا ۱۰ برابر است با", مجموع
پایان
