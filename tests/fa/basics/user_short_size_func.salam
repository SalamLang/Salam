تابع اندازه(نام: رشته، ن: صحیح): صحیح:
    سرچاپ نام، ن
    برگشت ن * 2
پایان

تابع ریشه:
    جمع := اندازه("alpha"، 4) + اندازه("beta"، 5)
    سرچاپ جمع
    سرچاپ اندازه(صحیح۳۲)، اندازه(صحیح۶۴)
پایان
