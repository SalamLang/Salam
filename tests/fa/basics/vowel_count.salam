تابع ریشه:
    س := "azcbobobegghakl"
    ناپایا تعداد := 0

    تکرار س.طول() در i:
        ک := س.زیررشته(i, 1)
        اگر ک برابر "a" یا ک برابر "e" یا ک برابر "i" یا ک برابر "o" یا ک برابر "u":
            تعداد++
        پایان
    پایان

    سرچاپ "Number of vowels:", تعداد
پایان
