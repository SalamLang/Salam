کارکرد آغازین:
    عبارت := "salam azad multi platform"
    گذرا کلمات := عبارت.بشکاف(" ")
    گذرا سرنام := ""
    چرخه کلمات.طول() با i:
        ک := کلمات.بگیر(i)
        سرنام = سرنام + ک.زیررشته(0, 1)
    پایان
    چاپ عبارت, "->", سرنام
پایان
