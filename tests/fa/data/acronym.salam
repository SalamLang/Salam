تابع ریشه:
    عبارت := "salam azad multi platform"
    ناپایا کلمات := عبارت.بشکاف(" ")
    ناپایا سرنام := ""
    تکرار کلمات.طول() در i:
        ک := کلمات.بگیر(i)
        سرنام += ک.زیررشته(0, 1)
    پایان
    سرچاپ عبارت, "->", سرنام
پایان
