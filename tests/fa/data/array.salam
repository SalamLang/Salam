// زبان: فارسی
تابع اصلی:
    نمرات := [12, 18, 9, 20, 15] بعنوان صحیح[5]
    متغیر مجموع := 0
    تکرار 5 با i:
        مجموع = مجموع + نمرات[i]
    تمام
    چاپ "مجموع:", مجموع
    چاپ "میانگین:", مجموع / 5
تمام
