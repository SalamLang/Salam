کارکرد آغازین:
    نمرات := [12, 18, 9, 20, 15]
    گذرا مجموع := 0
    چرخه 5 با i:
        مجموع = مجموع + نمرات[i]
    پایان
    چاپ "مجموع:", مجموع
    چاپ "میانگین:", مجموع / 5
پایان
