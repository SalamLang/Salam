روال ریشه:
    نمرات := [12, 18, 9, 20, 15]
    ناپایا مجموع := 0
    تکرار 5 از i:
        مجموع = مجموع + نمرات[i]
    پایان
    سرچاپ "مجموع:", مجموع
    سرچاپ "میانگین:", مجموع / 5
پایان
