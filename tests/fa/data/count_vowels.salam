روال ریشه:
    س := "salam donya"
    ناپایا تعداد := 0
    تکرار س.طول() از i:
        ک := س.زیررشته(i, 1)
        اگر ک == "a" یا ک == "e" یا ک == "i" یا ک == "o" یا ک == "u":
            تعداد = تعداد + 1
        پایان
    پایان
    سرچاپ "تعداد مصوت‌ها در", س, "=", تعداد
پایان
