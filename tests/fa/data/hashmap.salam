// زبان: فارسی
تابع اصلی:
    متغیر سن ها := نگاشت {} بعنوان نگاشت<رشته, صحیح> سن ها.درج("سارا", 30)
    سن ها.درج("علی", 25)
    سن ها.درج("رضا", 40)
    چاپ "سن سارا:", سن ها.بگیر("سارا")
    چاپ "علی موجود است؟", سن ها.دارد("علی")
    چاپ "حسن موجود است؟", سن ها.دارد("حسن")
    چاپ "تعداد:", سن ها.اندازه()
تمام
