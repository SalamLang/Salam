// زبان: فارسی
واردکردن رشته

تابع اصلی:
    ثابت متن := "Salam Donya"
    چاپ "طول:", رشته.طول(متن)
    چاپ "بزرگ:", رشته.بزرگ(متن)
    چاپ "کوچک:", رشته.کوچک(متن)
    چاپ "وارونه:", رشته.وارونه("Salam")
    چاپ "پیوست:", رشته.پیوست("سلام ", "دنیا")
تمام
