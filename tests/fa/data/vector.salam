روال ریشه:
    ناپایا اعداد := وکتور {} برگردان وکتور<صحیح> تکرار 1 تا 5 از i: اعداد.بیفزا(i * i)
پایان
ناپایا مجموع := 0
ناپایا j := 0
تا j < اعداد.طول():
    مجموع = مجموع + اعداد.بگیر(j)
    j = j + 1
پایان
سرچاپ "تعداد:", اعداد.طول() برگردان صحیح۶۴
سرچاپ "مجموع مربع‌ها:", مجموع
پایان
