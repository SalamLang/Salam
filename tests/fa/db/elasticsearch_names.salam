واردسازی دیتابیس
واردسازی دیتابیس.الستیک سرچ

تابع فهرست(الف: رشته، ب: رشته): وکتور<رشته>:
    ناپایا ف := وکتور {} برگردان وکتور<رشته>
    ف.بیفزا(الف)
    ف.بیفزا(ب)
    برگشت ف
پایان

تابع ریشه:
    سرچاپ الستیک سرچ.تطبیق("عنوان"، "سلام دنیا")
    سرچاپ الستیک سرچ.یکی از شرط‌ها(فهرست(الستیک سرچ.واژه("برچسب"، "الف")، الستیک سرچ.بازه("سال"، "1400"، "1403")))
    سرچاپ الستیک سرچ.نقیض(الستیک سرچ.فیلد موجود("حذف"))
    ناپایا تجمیع‌ها := الستیک سرچ.افزودن تجمیع(""، "برچسب ها"، الستیک سرچ.تجمیع واژه‌ها("برچسب"، 3))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "میانگین"، الستیک سرچ.تجمیع میانگین("امتیاز"))
    سرچاپ تجمیع‌ها
    ناپایا د := الستیک سرچ.دسته‌ای تازه()
    الستیک سرچ.نمایه کردن دسته‌ای(د، "کتاب ها"، "۱"، `{"عنوان":"شاهنامه"}`)
    الستیک سرچ.حذف دسته‌ای(د، "کتاب ها"، "۲")
    سرچاپ الستیک سرچ.طول دسته‌ای(د)
    چاپ الستیک سرچ.بدنه دسته‌ای(د)
    ک := الستیک سرچ.اتصال با رمز("http://localhost:9200"، "کاربر"، "رمز")
    سرچاپ الستیک سرچ.معتبر(ک)، الستیک سرچ.سرآیند احراز(ک)
    سرچاپ الستیک سرچ.کدگشایی شناسه ابری("x:" + "aG9zdC5leGFtcGxlLmNvbTo5MjQzJGVzMSRraWI=")
    نتیجه := الستیک سرچ.تجزیه نتیجه جستجو(`{"took":1,"hits":{"total":{"value":1,"relation":"eq"},"hits":[{"_id":"۱","_score":2.5,"_source":{"عنوان":"شاهنامه"}}]},"aggregations":{"میانگین":{"value":4.5}}}`)
    سرچاپ نتیجه.total، نتیجه.hits.بگیر(0).id، نتیجه.hits.بگیر(0).source، الستیک سرچ.مقدار تجمیع(نتیجه، "میانگین")
    سرچاپ دیتابیس.الستیک سرچ
پایان
