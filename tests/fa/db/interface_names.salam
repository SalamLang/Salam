واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع گزارش(ا: dyn دیتابیس.اتصال):
    سرچاپ ا.نوع()، ا.معتبر()
    _ := ا.اجرا("CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    _ := ا.اجرا("INSERT INTO t (name) VALUES (" + ا.نقل قول("سلام") + ")")
    سرچاپ ا.شناسه آخرین درج()
    ت := ا.شروع تراکنش()
    _ := ت.اجرا("INSERT INTO t (name) VALUES ('x')")
    _ := ت.بازگردانی()
    ر := ا.پرسمان("SELECT id, name FROM t")
    تا ر.بعدی():
        سرچاپ ر.عدد صحیح(۰)، ر.متن(۱)، ر.نام ستون(۱)
    پایان
    _ := ر.بستن()
    _ := ا.بستن()
پایان

تابع ریشه:
    گزارش(اس کیو لایت.اتصال(اس کیو لایت.بازکردن(":memory:")))
    سرچاپ دیتابیس.نوع متن
پایان
