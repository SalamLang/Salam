واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    ک := میلیسرچ.جدید("127.0.0.1:7700/"، "کلید")
    سرچاپ ک.host، ک.api_key
    ناپایا خ := میلیسرچ.خطا {}
    سرچاپ میلیسرچ.موفق(خ)
    ت := میلیسرچ.توکن مستاجر("uid"، "secret"، ""، ۰، خ)
    سرچاپ ت.طول() > ۱۰۰
    خالی := میلیسرچ.کلاینت {}
    سرچاپ "[" + میلیسرچ.سلامت(خالی، خ) + "]"
    سرچاپ میلیسرچ.موفق(خ)، خ.code
    سرچاپ میلیسرچ.متن خطا(خ)
    سرچاپ میلیسرچ.سالم است(خالی)
    سرچاپ میلیسرچ.وضعیت موفق، میلیسرچ.تطبیق همه
    د := میلیسرچ.درخواست جستجو { query = "سلام"، limit = ۵ }
    سرچاپ د.query، د.limit، د.offset
پایان
