واردسازی دیتابیس
واردسازی دیتابیس.اپن سرچ

تابع فهرست(الف: رشته، ب: رشته): وکتور<رشته>:
    ناپایا ف := وکتور {} برگردان وکتور<رشته>
    ف.بیفزا(الف)
    ف.بیفزا(ب)
    برگشت ف
پایان

تابع ریشه:
    سرچاپ اپن سرچ.تطبیق("عنوان"، "سلام دنیا")
    سرچاپ اپن سرچ.یکی از شرط‌ها(فهرست(اپن سرچ.واژه("برچسب"، "الف")، اپن سرچ.بازه("سال"، "1400"، "1403")))
    سرچاپ اپن سرچ.نقیض(اپن سرچ.وجود فیلد("حذف"))
    ناپایا ب := وکتور {} برگردان وکتور<اعشار۶۴>
    ب.بیفزا(۰.۵)
    ب.بیفزا(۱.۰)
    سرچاپ اپن سرچ.نزدیک‌ترین همسایه‌ها("بردار"، ب، ۳)
    ناپایا تجمیع‌ها := اپن سرچ.افزودن تجمیع("{}"، "برچسب ها"، اپن سرچ.تجمیع واژه‌ها("برچسب"، ۳))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "میانگین"، اپن سرچ.تجمیع میانگین("امتیاز"))
    سرچاپ تجمیع‌ها
    ناپایا د := اپن سرچ.دسته‌ای تازه()
    اپن سرچ.نمایه‌سازی دسته‌ای(د، "کتاب ها"، "۱"، `{"عنوان":"شاهنامه"}`)
    اپن سرچ.حذف دسته‌ای(د، "کتاب ها"، "۲")
    سرچاپ اپن سرچ.اندازه دسته‌ای(د)
    چاپ اپن سرچ.بدنه دسته‌ای(د)
    اپن سرچ.آزادسازی دسته‌ای(د)
    ناپایا ک := اپن سرچ.اتصال با رمز("http://localhost:9200"، "کاربر"، "رمز")
    سرچاپ اپن سرچ.معتبر(ک)، اپن سرچ.سرآیند احراز(ک)، اپن سرچ.گره‌ها(ک)
    اپن سرچ.بستن(ک)
    نتیجه := اپن سرچ.تجزیه جستجو(`{"took":1,"hits":{"total":{"value":1,"relation":"eq"},"hits":[{"_id":"۱","_score":2.5,"_source":{"عنوان":"شاهنامه"}}]},"aggregations":{"میانگین":{"value":4.5}}}`)
    سرچاپ نتیجه.کل، نتیجه.نتایج.بگیر(0).شناسه، نتیجه.نتایج.بگیر(0).منبع، اپن سرچ.مقدار تجمیع(نتیجه.تجمیع‌ها، "میانگین")
    سرچاپ اپن سرچ.مسیر جیسون(`{"الف":{"ب":[1,"دو"]}}`، "الف.ب.1")
    سرچاپ اپن سرچ.سیاست حذف پس از("گزارش‌ها"، "7d"، فهرست("logs-*"، "app-*"))
    سرچاپ اپن سرچ.بدنه نقش(فهرست("cluster_monitor"، "indices_monitor")، فهرست("logs-*"، "app-*")، فهرست("read"، "search"))
    سرچاپ دیتابیس.اپن سرچ، اپن سرچ.نسخه کارخواه
پایان
