واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

تابع بساز(ک: تایپسنس.کلاینت، نام: رشته، عنوان‌ها: وکتور<رشته>، خ &: تایپسنس.خطا):
    ناپایا طرح := تایپسنس.طرح { name = نام }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    هر عنوان در عنوان‌ها:
        سندها.بیفزا(`{"title": "` + عنوان + `"}`)
    پایان
    _ := تایپسنس.درون ریزی سندها(ک، نام، سندها، تایپسنس.گزینه های نوشتن {}، خ)
پایان

تابع شمار(ک: تایپسنس.کلاینت، نام: رشته، خ &: تایپسنس.خطا): صحیح۶۴:
    برگشت تایپسنس.جستجو(ک، نام، تایپسنس.جستجوی جدید("*"، "")، خ).found
پایان

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف نام مستعار(ک، "fa_ex_alias_books"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_alias_books_v1"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_alias_books_v2"، خ)

    ناپایا نسخه۱ := وکتور {} برگردان وکتور<رشته>
    نسخه۱.بیفزا("بوف کور")
    نسخه۱.بیفزا("سووشون")
    بساز(ک، "fa_ex_alias_books_v1"، نسخه۱، خ)
    مستعار := تایپسنس.درج نام مستعار(ک، "fa_ex_alias_books"، "fa_ex_alias_books_v1"، خ)
    سرچاپ "نام مستعار:"، مستعار.name، "->"، مستعار.collection_name
    سرچاپ "کتاب‌ها از راه نام مستعار:"، شمار(ک، "fa_ex_alias_books"، خ)

    ناپایا نسخه۲ := وکتور {} برگردان وکتور<رشته>
    نسخه۲.بیفزا("بوف کور")
    نسخه۲.بیفزا("سووشون")
    نسخه۲.بیفزا("کلیدر")
    بساز(ک، "fa_ex_alias_books_v2"، نسخه۲، خ)
    _ := تایپسنس.درج نام مستعار(ک، "fa_ex_alias_books"، "fa_ex_alias_books_v2"، خ)
    سرچاپ "پس از جابه‌جایی:"، تایپسنس.دریافت نام مستعار(ک، "fa_ex_alias_books"، خ).collection_name
    سرچاپ "کتاب‌ها از راه نام مستعار:"، شمار(ک، "fa_ex_alias_books"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_alias_books_v1"، خ)
    سرچاپ "نسخه‌ی کهنه حذف شد و نام مستعار کار می‌کند:"، شمار(ک، "fa_ex_alias_books"، خ)

    ناپایا فهرست‌شده := نادرست
    هر م در تایپسنس.فهرست نام های مستعار(ک، خ):
        اگر م.name برابر "fa_ex_alias_books": فهرست‌شده = درست پایان
    پایان
    سرچاپ "در فهرست:"، فهرست‌شده
    سرچاپ "نام مستعار حذف شد:"، تایپسنس.حذف نام مستعار(ک، "fa_ex_alias_books"، خ).name
    _ := تایپسنس.دریافت نام مستعار(ک، "fa_ex_alias_books"، خ)
    سرچاپ "نام مستعار نیست:"، تایپسنس.پیدا نشد(خ)، "مجموعه مانده:"، تایپسنس.مجموعه وجود دارد(ک، "fa_ex_alias_books_v2"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_alias_books_v2"، خ)
پایان
