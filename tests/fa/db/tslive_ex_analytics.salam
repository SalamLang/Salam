واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف قاعده تحلیل(ک، "fa_ex_ana_clicks"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_ana_products"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_ana_products" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "popularity"، kind = تایپسنس.نوع عدد۳۲، optional = درست })
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "name": "چای سبز", "popularity": 0}`)
    سندها.بیفزا(`{"id": "2", "name": "چای سیاه", "popularity": 0}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_ana_products"، سندها، تایپسنس.گزینه های نوشتن {}، خ)

    قاعده := تایپسنس.قاعده تحلیل {
        name = "fa_ex_ana_clicks"، kind = تایپسنس.قاعده شمارنده، collection = "fa_ex_ana_products"، event_type = تایپسنس.رویداد کلیک،
        rule_tag = "fa_ex_ana"، params = `{"destination_collection": "fa_ex_ana_products", "counter_field": "popularity", "weight": 1}`
    }
    سرچاپ "جیسون قاعده:"، تایپسنس.جیسون قاعده تحلیل(قاعده)
    ساخته := تایپسنس.ساخت قاعده تحلیل(ک، قاعده، خ)
    سرچاپ "ساخته شد:"، ساخته.name، ساخته.kind، ساخته.event_type، تایپسنس.متن خطا(خ)
    سرچاپ "خواندن دوباره:"، تایپسنس.دریافت قاعده تحلیل(ک، "fa_ex_ana_clicks"، خ).collection
    سرچاپ "قاعده‌های برچسب‌دار:"، تایپسنس.فهرست قاعده های تحلیل(ک، "fa_ex_ana"، خ).طول()

    تکرار ۲:
        _ := تایپسنس.ارسال رویداد(ک، "fa_ex_ana_clicks"، تایپسنس.رویداد کلیک، `{"doc_id": "2", "user_id": "u1"}`، خ)
    پایان
    سرچاپ "کلیک فرستاده شد:"، تایپسنس.ارسال رویداد از جیسون(ک، `{"name": "fa_ex_ana_clicks", "event_type": "click", "data": {"doc_id": "1", "user_id": "u2"}}`، خ)
    سرچاپ "تخلیه شد:"، تایپسنس.تخلیه تحلیل(ک، خ)
    سرچاپ "وضعیت جیسون است:"، تایپسنس.وضعیت تحلیل(ک، خ).بیاب("{") برابر ۰

    ناپایا ج := تایپسنس.جستجوی جدید("چای"، "name")
    ج.sort_by = "popularity:desc"
    هر ی در تایپسنس.جستجو(ک، "fa_ex_ana_products"، ج، خ).hits:
        سرچاپ "  "، ی.document
    پایان
    تغییر := تایپسنس.درج قاعده تحلیل(ک، تایپسنس.قاعده تحلیل {
        name = "fa_ex_ana_clicks"، kind = تایپسنس.قاعده شمارنده، collection = "fa_ex_ana_products"، event_type = تایپسنس.رویداد کلیک،
        params = `{"destination_collection": "fa_ex_ana_products", "counter_field": "popularity", "weight": 5}`
    }، خ)
    سرچاپ "وزن عوض شد:"، تغییر.params.بیاب("\"weight\":5") بزرگتربرابر ۰
    سرچاپ "حذف شد:"، تایپسنس.حذف قاعده تحلیل(ک، "fa_ex_ana_clicks"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_ana_products"، خ)
پایان
