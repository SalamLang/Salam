واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    سرچاپ "تصویر لحظه‌ای:"، تایپسنس.ساخت تصویر لحظه ای(ک، "/tmp/salam-fa-ex-snapshot"، خ)، تایپسنس.متن خطا(خ)
    سرچاپ "حافظه‌ی نهان پاک شد:"، تایپسنس.پاک کردن حافظه نهان(ک، خ)
    سرچاپ "فشرده شد:"، تایپسنس.فشرده سازی پایگاه(ک، خ)
    سرچاپ "تغییرات طرح در جریان:"، تایپسنس.تغییرات طرح(ک، خ).طول()
    سرچاپ "گزارش درخواست کند:"، تایپسنس.تنظیم گزارش درخواست کند(ک، ۲۰۰۰، خ)
    سرچاپ "پیکربندی:"، تایپسنس.به‌روزرسانی پیکربندی(ک، `{"log-slow-requests-time-ms": -1}`، خ)
    سرچاپ "وضعیت:"، تایپسنس.وضعیت(ک، خ).state
پایان
