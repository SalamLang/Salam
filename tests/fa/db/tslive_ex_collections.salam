 * Repository: https://github.com/SalamLang/Salam
 *
 */

واردسازی سیستم عامل
واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_col_products"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_col_products_copy"، خ)

    ناپایا طرح := تایپسنس.طرح { نام = "fa_ex_col_products"، فیلد مرتب‌سازی پیش‌فرض = "price"، فیلدهای تودرتو = درست }
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "description"، نوع = تایپسنس.نوع متن، اختیاری = درست، میانوندی = درست })
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("brand"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("tags"، تایپسنس.نوع آرایه متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "price"، نوع = تایپسنس.نوع اعشاری، نمایه بازه‌ای = درست })
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "stock"، نوع = تایپسنس.نوع عدد۳۲، مرتب‌سازی = ۱ })
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "sku"، نوع = تایپسنس.نوع متن، نمایه = نادرست، اختیاری = درست })
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("in_stock"، تایپسنس.نوع بولی))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "added_at"، نوع = تایپسنس.نوع عدد۶۴، اختیاری = درست })
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "specs"، نوع = تایپسنس.نوع شیء، اختیاری = درست })
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "extra_.*"، نوع = تایپسنس.نوع خودکار، اختیاری = درست })
    طرح.جداکننده‌های واژه.بیفزا("-")
    طرح.نمادهای نمایه‌شده.بیفزا("+")
    طرح.فراداده = `{"team": "catalog"}`
    سرچاپ "طرح:"، تایپسنس.جیسون طرح(طرح)

    مجموعه := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    سرچاپ "ساخته شد:"، مجموعه.نام، تایپسنس.موفق(خ)، مجموعه.تعداد سندها، مجموعه.زمان ساخت بزرگتر ۰
    هر فیلد در مجموعه.فیلدها:
        سرچاپ "  فیلد"، فیلد.نام، فیلد.نوع، "دسته=" + فیلد.دسته‌بندی، "اختیاری=" + فیلد.اختیاری، "نمایه=" + فیلد.نمایه، "مرتب=" + فیلد.مرتب‌سازی
    پایان
    سرچاپ "جداکننده‌ها:"، رشته.بپیوند(مجموعه.جداکننده‌های واژه، ","), "نمادها:"، رشته.بپیوند(مجموعه.نمادهای نمایه‌شده، ",")، "فراداده:"، مجموعه.فراداده

    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    سرچاپ "ساخت دوباره:"، تایپسنس.تداخل دارد(خ)
    سرچاپ "وجود دارد:"، تایپسنس.مجموعه وجود دارد(ک، "fa_ex_col_products"، خ)، تایپسنس.مجموعه وجود دارد(ک، "fa_ex_col_nope"، خ)

    ناپایا پیدا := نادرست
    هر م در تایپسنس.فهرست مجموعه ها(ک، خ):
        اگر م.نام برابر "fa_ex_col_products": پیدا = درست پایان
    پایان
    سرچاپ "در فهرست:"، پیدا
    ناپایا بی‌فیلد := وکتور {} برگردان وکتور<رشته>
    بی‌فیلد.بیفزا("fields")
    سرچاپ "یکی در هر صفحه:"، تایپسنس.صفحه مجموعه ها(ک، ۰، ۱، بی‌فیلد، خ).طول()

    ناپایا افزوده := وکتور {} برگردان وکتور<تایپسنس.فیلد>
    افزوده.بیفزا(تایپسنس.فیلد دسته بندی("color"، تایپسنس.نوع متن))
    _ := تایپسنس.افزودن فیلدها(ک، "fa_ex_col_products"، افزوده، خ)
    سرچاپ "رنگ افزوده شد:"، تایپسنس.موفق(خ)
    ناپایا حذفی := وکتور {} برگردان وکتور<رشته>
    حذفی.بیفزا("sku")
    _ := تایپسنس.حذف فیلدها(ک، "fa_ex_col_products"، حذفی، خ)
    سرچاپ "sku حذف شد:"، تایپسنس.موفق(خ)
    _ := تایپسنس.تنظیم فراداده مجموعه(ک، "fa_ex_col_products"، `{"team": "search"}`، خ)
    بعدی := تایپسنس.دریافت مجموعه(ک، "fa_ex_col_products"، خ)
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    هر فیلد در بعدی.فیلدها:
        نام‌ها.بیفزا(فیلد.نام)
    پایان
    سرچاپ "فیلدهای کنونی:"، رشته.بپیوند(نام‌ها، ",")
    سرچاپ "فراداده‌ی کنونی:"، بعدی.فراداده

    _ := تایپسنس.ساخت سند(ک، "fa_ex_col_products"، `{"id": "1", "name": "کتری", "brand": "پارس", "tags": ["آشپزخانه"], "price": 19.5, "stock": 4, "in_stock": true, "color": "سفید"}`، خ)
    سرچاپ "سندها:"، تایپسنس.دریافت مجموعه(ک، "fa_ex_col_products"، خ).تعداد سندها
    رونوشت := تایپسنس.رونوشت مجموعه(ک، "fa_ex_col_products"، "fa_ex_col_products_copy"، خ)
    سرچاپ "رونوشت:"، رونوشت.نام، رونوشت.فیلدها.طول() برابر بعدی.فیلدها.طول()، رونوشت.تعداد سندها
    سرچاپ "خالی شد:"، تایپسنس.خالی کردن مجموعه(ک، "fa_ex_col_products"، خ)
    سرچاپ "حذف شد:"، تایپسنس.حذف مجموعه(ک، "fa_ex_col_products"، خ).نام، تایپسنس.حذف مجموعه(ک، "fa_ex_col_products_copy"، خ).نام
    _ := تایپسنس.دریافت مجموعه(ک، "fa_ex_col_products"، خ)
    سرچاپ "دیگر نیست:"، تایپسنس.پیدا نشد(خ)
پایان
