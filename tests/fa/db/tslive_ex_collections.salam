واردسازی سیستم عامل
واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_col_products"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_col_products_copy"، خ)

    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_col_products"، default_sorting_field = "price"، enable_nested_fields = درست }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "description"، kind = تایپسنس.نوع متن، optional = درست، infix = درست })
    طرح.fields.بیفزا(تایپسنس.فیلد دسته بندی("brand"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد دسته بندی("tags"، تایپسنس.نوع آرایه متن))
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "price"، kind = تایپسنس.نوع اعشاری، range_index = درست })
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "stock"، kind = تایپسنس.نوع عدد۳۲، sort = ۱ })
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "sku"، kind = تایپسنس.نوع متن، index = نادرست، optional = درست })
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("in_stock"، تایپسنس.نوع بولی))
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "added_at"، kind = تایپسنس.نوع عدد۶۴، optional = درست })
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "specs"، kind = تایپسنس.نوع شیء، optional = درست })
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "extra_.*"، kind = تایپسنس.نوع خودکار، optional = درست })
    طرح.token_separators.بیفزا("-")
    طرح.symbols_to_index.بیفزا("+")
    طرح.metadata = `{"team": "catalog"}`
    سرچاپ "طرح:"، تایپسنس.جیسون طرح(طرح)

    مجموعه := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    سرچاپ "ساخته شد:"، مجموعه.name، تایپسنس.موفق(خ)، مجموعه.num_documents، مجموعه.created_at بزرگتر ۰
    هر فیلد در مجموعه.fields:
        سرچاپ "  فیلد"، فیلد.name، فیلد.kind، "دسته=" + فیلد.facet، "اختیاری=" + فیلد.optional، "نمایه=" + فیلد.index، "مرتب=" + فیلد.sort
    پایان
    سرچاپ "جداکننده‌ها:"، رشته.بپیوند(مجموعه.token_separators، ","), "نمادها:"، رشته.بپیوند(مجموعه.symbols_to_index، ",")، "فراداده:"، مجموعه.metadata

    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    سرچاپ "ساخت دوباره:"، تایپسنس.تداخل دارد(خ)
    سرچاپ "وجود دارد:"، تایپسنس.مجموعه وجود دارد(ک، "fa_ex_col_products"، خ)، تایپسنس.مجموعه وجود دارد(ک، "fa_ex_col_nope"، خ)

    ناپایا پیدا := نادرست
    هر م در تایپسنس.فهرست مجموعه ها(ک، خ):
        اگر م.name برابر "fa_ex_col_products": پیدا = درست پایان
    پایان
    سرچاپ "در فهرست:"، پیدا
    ناپایا بی‌فیلد := وکتور {} برگردان وکتور<رشته>
    بی‌فیلد.بیفزا("fields")
    سرچاپ "یکی در هر صفحه:"، تایپسنس.صفحه مجموعه ها(ک، ۰، ۱، بی‌فیلد، خ).طول()

    ناپایا افزوده := وکتور {} برگردان وکتور<تایپسنس.فیلد>
    افزوده.بیفزا(تایپسنس.فیلد دسته بندی("color"، تایپسنس.نوع متن))
    _ := تایپسنس.افزودن فیلدها(ک، "fa_ex_col_products"، افزوده، خ)
    سرچاپ "رنگ افزوده شد:"، تایپسنس.موفق(خ)
    ناپایا حذفی := وکتور {} برگردان وکتور<رشته>
    حذفی.بیفزا("sku")
    _ := تایپسنس.حذف فیلدها(ک، "fa_ex_col_products"، حذفی، خ)
    سرچاپ "sku حذف شد:"، تایپسنس.موفق(خ)
    _ := تایپسنس.تنظیم فراداده مجموعه(ک، "fa_ex_col_products"، `{"team": "search"}`، خ)
    بعدی := تایپسنس.دریافت مجموعه(ک، "fa_ex_col_products"، خ)
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    هر فیلد در بعدی.fields:
        نام‌ها.بیفزا(فیلد.name)
    پایان
    سرچاپ "فیلدهای کنونی:"، رشته.بپیوند(نام‌ها، ",")
    سرچاپ "فراداده‌ی کنونی:"، بعدی.metadata

    _ := تایپسنس.ساخت سند(ک، "fa_ex_col_products"، `{"id": "1", "name": "کتری", "brand": "پارس", "tags": ["آشپزخانه"], "price": 19.5, "stock": 4, "in_stock": true, "color": "سفید"}`، خ)
    سرچاپ "سندها:"، تایپسنس.دریافت مجموعه(ک، "fa_ex_col_products"، خ).num_documents
    رونوشت := تایپسنس.رونوشت مجموعه(ک، "fa_ex_col_products"، "fa_ex_col_products_copy"، خ)
    سرچاپ "رونوشت:"، رونوشت.name، رونوشت.fields.طول() برابر بعدی.fields.طول()، رونوشت.num_documents
    سرچاپ "خالی شد:"، تایپسنس.خالی کردن مجموعه(ک، "fa_ex_col_products"، خ)
    سرچاپ "حذف شد:"، تایپسنس.حذف مجموعه(ک، "fa_ex_col_products"، خ).name، تایپسنس.حذف مجموعه(ک، "fa_ex_col_products_copy"، خ).name
    _ := تایپسنس.دریافت مجموعه(ک، "fa_ex_col_products"، خ)
    سرچاپ "دیگر نیست:"، تایپسنس.پیدا نشد(خ)
پایان
