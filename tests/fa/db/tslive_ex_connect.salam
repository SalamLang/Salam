// lang: fa
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

واردسازی سیستم عامل
واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    نشانی := تکه‌ها.بگیر(۰)
    کلید := تکه‌ها.بگیر(۱)
    ناپایا ک := تایپسنس.جدید(نشانی، کلید)
    دیرکن تایپسنس.آزادسازی(ک)
    ک.timeout_ms = ۵۰۰۰
    ک.retries = ۲
    ک.retry_interval_ms = ۵۰
    تایپسنس.افزودن سرصفحه(ک، "X-Request-Source"، "salam-example")
    ناپایا خ := تایپسنس.خطا {}

    سرچاپ "سالم:"، تایپسنس.سلامت(ک، خ)، تایپسنس.سالم است(ک)
    سرچاپ "نسخه معلوم است:"، رشته.طول(تایپسنس.نسخه سرور(ک، خ)) بزرگتر ۰
    سرچاپ "اشکال‌زدایی نسخه دارد:"، رشته.شامل است(تایپسنس.اشکال زدایی(ک، خ)، "version")
    وضع := تایپسنس.وضعیت(ک، خ)
    سرچاپ "وضعیت raft:"، وضع.state، وضع.queued_writes بزرگتربرابر ۰
    سرچاپ "آمار تاخیر دارد:"، رشته.شامل است(تایپسنس.آمار(ک، خ)، "latency_ms")
    سرچاپ "سنجه‌ها حافظه دارد:"، رشته.شامل است(تایپسنس.سنجه ها(ک، خ)، "typesense_memory")

    _ := تایپسنس.دریافت مجموعه(ک، "fa_ex_connect_missing"، خ)
    سرچاپ "مجموعه‌ی ناموجود:"، تایپسنس.پیدا نشد(خ)، خ.status، خ.kind
    سرچاپ تایپسنس.متن خطا(خ)

    ناپایا نادرست‌کلید := تایپسنس.جدید(نشانی، "wrong-key")
    دیرکن تایپسنس.آزادسازی(نادرست‌کلید)
    _ := تایپسنس.فهرست مجموعه ها(نادرست‌کلید، خ)
    سرچاپ "کلید نادرست:"، خ.status، خ.kind برابر تایپسنس.نوع اچ تی تی پی

    سرچاپ "درخواست خام:"، تایپسنس.درخواست(ک، "GET"، "/health"، ""، خ)

    ناپایا گره‌ها := وکتور {} برگردان وکتور<رشته>
    گره‌ها.بیفزا("http://127.0.0.1:1")
    گره‌ها.بیفزا(نشانی)
    ناپایا خوشه := تایپسنس.خوشه جدید(گره‌ها، کلید)
    دیرکن تایپسنس.آزادسازی(خوشه)
    خوشه.retry_interval_ms = ۰
    سرچاپ "خوشه سالم:"، تایپسنس.سلامت(خوشه، خ)
    سرچاپ "گره خاموش کنار رفت:"، وارونه تایپسنس.گره سالم است(خوشه، ۰)، تایپسنس.گره سالم است(خوشه، ۱)

    ناپایا نزدیک := تایپسنس.جدید(نشانی، کلید)
    دیرکن تایپسنس.آزادسازی(نزدیک)
    تایپسنس.تنظیم نزدیک‌ترین گره(نزدیک، "http://127.0.0.1:1")
    نزدیک.retry_interval_ms = ۰
    سرچاپ "نزدیک‌ترین گره خاموش، باز هم سالم:"، تایپسنس.سلامت(نزدیک، خ)، وارونه تایپسنس.گره سالم است(نزدیک، -۱)

    ناپایا دور := تایپسنس.جدید("http://127.0.0.1:1"، کلید)
    دیرکن تایپسنس.آزادسازی(دور)
    دور.retries = ۰
    سرچاپ "دسترس‌ناپذیر:"، تایپسنس.سلامت(دور، خ)، خ.kind برابر تایپسنس.نوع شبکه
پایان
