واردسازی سیستم عامل
واردسازی رشته
واردسازی کدگذاری.جیسون
واردسازی دیتابیس.تایپسنس

تابع شناسه‌ها(ن: تایپسنس.نتیجه جستجو): رشته:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    هر ی در ن.hits:
        ناپایا نشانه := ""
        اگر ی.curated: نشانه = "*" پایان
        خروجی.بیفزا(جیسون.دریافت(ی.document، "id") + نشانه)
    پایان
    برگشت رشته.بپیوند(خروجی، " ")
پایان

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_cur_phones"، خ)
    _ := تایپسنس.حذف دسته گزینش(ک، "fa_ex_cur_promos"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_cur_phones" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد دسته بندی("stock"، تایپسنس.نوع عدد۳۲))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "name": "گوشی ساده", "stock": 5}`)
    سندها.بیفزا(`{"id": "2", "name": "گوشی حرفه‌ای", "stock": 0}`)
    سندها.بیفزا(`{"id": "3", "name": "گوشی بزرگ", "stock": 3}`)
    سندها.بیفزا(`{"id": "4", "name": "قاب گوشی", "stock": 9}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_cur_phones"، سندها، تایپسنس.گزینه های نوشتن {}، خ)
    پرسش := تایپسنس.جستجوی جدید("گوشی"، "name")
    سرچاپ "ترتیب عادی:"، شناسه‌ها(تایپسنس.جستجو(ک، "fa_ex_cur_phones"، پرسش، خ))

    ناپایا سنجاق‌ها := وکتور {} برگردان وکتور<تایپسنس.سنجاق>
    سنجاق‌ها.بیفزا(تایپسنس.سنجاق { id = "3"، position = ۱ })
    ناپایا پنهان := وکتور {} برگردان وکتور<رشته>
    پنهان.بیفزا("4")
    ترویج := تایپسنس.قاعده گزینش {
        id = "promote-big"، query = "گوشی"، match_type = تایپسنس.تطابق دقیق، includes = سنجاق‌ها، excludes = پنهان،
        metadata = `{"banner": "تازه: گوشی بزرگ"}`
    }
    سرچاپ "قاعده:"، تایپسنس.جیسون گزینش(ترویج)
    ناپایا قاعده‌ها := وکتور {} برگردان وکتور<تایپسنس.قاعده گزینش>
    قاعده‌ها.بیفزا(ترویج)
    دسته := تایپسنس.درج دسته گزینش(ک، "fa_ex_cur_promos"، قاعده‌ها، خ)
    سرچاپ "دسته:"، دسته.name، دسته.items.طول()، دسته.items.بگیر(۰).includes.بگیر(۰).id
    _ := تایپسنس.به‌روزرسانی مجموعه(ک، "fa_ex_cur_phones"، `{"curation_sets": ["fa_ex_cur_promos"]}`، خ)
    ن := تایپسنس.جستجو(ک، "fa_ex_cur_phones"، پرسش، خ)
    سرچاپ "ترتیب گزینش‌شده:"، شناسه‌ها(ن)، "(* = جای‌گرفته با قاعده)"
    سرچاپ "فراداده‌ی قاعده برمی‌گردد:"، رشته.شامل است(ن.raw، "تازه: گوشی بزرگ")

    موجود := تایپسنس.قاعده گزینش { id = "in-stock"، query = "حرفه‌ای"، match_type = تایپسنس.تطابق شامل، filter_by = "stock:>0"، remove_matched_tokens = درست }
    _ := تایپسنس.درج قاعده دسته گزینش(ک، "fa_ex_cur_promos"، موجود، خ)
    سرچاپ "گوشی حرفه‌ای، فقط موجودها:"، تایپسنس.جستجو(ک، "fa_ex_cur_phones"، تایپسنس.جستجوی جدید("گوشی حرفه‌ای"، "name")، خ).found
    سرچاپ "قاعده‌ها:"، تایپسنس.فهرست قاعده های دسته گزینش(ک، "fa_ex_cur_promos"، خ).طول()، تایپسنس.دریافت قاعده دسته گزینش(ک، "fa_ex_cur_promos"، "in-stock"، خ).filter_by

    ناپایا خاموش := تایپسنس.جستجوی جدید("گوشی"، "name")
    تایپسنس.تنظیم پارامتر(خاموش، "enable_curations"، "false")
    سرچاپ "قاعده‌ها خاموش:"، شناسه‌ها(تایپسنس.جستجو(ک، "fa_ex_cur_phones"، خاموش، خ))
    ناپایا دستی := تایپسنس.پارامترهای جستجو { q = "گوشی"، query_by = "name"، hidden_hits = "1,2"، pinned_hits = "4:1" }
    تایپسنس.تنظیم پارامتر(دستی، "enable_curations"، "false")
    سرچاپ "سنجاق و پنهان در خود جستجو:"، شناسه‌ها(تایپسنس.جستجو(ک، "fa_ex_cur_phones"، دستی، خ))

    سرچاپ "قاعده حذف شد:"، تایپسنس.حذف قاعده دسته گزینش(ک، "fa_ex_cur_promos"، "in-stock"، خ)، "دسته‌ها:"، تایپسنس.فهرست دسته های گزینش(ک، خ).طول() بزرگتربرابر ۱
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_cur_phones"، خ)
    سرچاپ "دسته حذف شد:"، تایپسنس.حذف دسته گزینش(ک، "fa_ex_cur_promos"، خ)
پایان
