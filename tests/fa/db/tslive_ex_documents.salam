واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

ساختار کتاب:
    @json "id"
    همگانی شناسه: رشته = ""
    @json "title"
    همگانی عنوان: رشته = ""
    @json "author"
    همگانی نویسنده: رشته = ""
    @json "year"
    همگانی سال: صحیح = ۰
پایان

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_doc_books"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_doc_books" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "author"، kind = تایپسنس.نوع متن، optional = درست })
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "year"، kind = تایپسنس.نوع عدد۳۲، optional = درست })
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)

    سرچاپ "ساخت:"، تایپسنس.ساخت سند(ک، "fa_ex_doc_books"، `{"id": "1", "title": "بوف کور", "year": 1936}`، خ)
    _ := تایپسنس.ساخت سند(ک، "fa_ex_doc_books"، `{"id": "1", "title": "بوف کور"}`، خ)
    سرچاپ "ساخت دوباره:"، تایپسنس.تداخل دارد(خ)
    سرچاپ "درج:"، تایپسنس.درج سند(ک، "fa_ex_doc_books"، `{"id": "1", "title": "بوف کور", "author": "صادق هدایت", "year": 1936}`، خ)
    سرچاپ "به‌روزرسانی:"، تایپسنس.به‌روزرسانی سند(ک، "fa_ex_doc_books"، "1"، `{"year": 1937}`، خ)
    سرچاپ "جایگذاری تازه:"، تایپسنس.جایگذاری سند(ک، "fa_ex_doc_books"، `{"id": "2", "title": "سووشون"}`، خ)
    سرچاپ "جایگذاری روی موجود:"، تایپسنس.جایگذاری سند(ک، "fa_ex_doc_books"، `{"id": "2", "author": "سیمین دانشور"}`، خ)
    _ := تایپسنس.به‌روزرسانی سند(ک، "fa_ex_doc_books"، "2"، `{"year": "1969"}`، خ)
    سرچاپ "نوع نادرست:"، خ.status
    سرچاپ "تبدیل شد:"، تایپسنس.به‌روزرسانی سند با گزینه(ک، "fa_ex_doc_books"، "2"، `{"year": "1969"}`، تایپسنس.ناپاک تبدیل با رد، خ)
    سرچاپ "نوشتن با گزینه:"، تایپسنس.نمایه سازی سند(ک، "fa_ex_doc_books"، `{"id": "3", "title": "کلیدر", "year": "نامعلوم"}`، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش درج، dirty_values = تایپسنس.ناپاک تبدیل با کنار }، خ)

    سرچاپ "دریافت:"، تایپسنس.دریافت سند(ک، "fa_ex_doc_books"، "1"، خ)
    سرچاپ "وجود دارد:"، تایپسنس.سند وجود دارد(ک، "fa_ex_doc_books"، "1"، خ)، تایپسنس.سند وجود دارد(ک، "fa_ex_doc_books"، "99"، خ)

    ناپایا ب := کتاب {}
    اگر تایپسنس.دریافت سند به نوع(ک، "fa_ex_doc_books"، "1"، ب، خ):
        سرچاپ "ساختار:"، ب.عنوان، "از"، ب.نویسنده، "سال"، ب.سال
    پایان
    _ := تایپسنس.ساخت سند از نوع(ک، "fa_ex_doc_books"، کتاب { شناسه = "4"، عنوان = "جای خالی سلوچ"، نویسنده = "محمود دولت‌آبادی"، سال = ۱۹۷۹ }، خ)
    _ := تایپسنس.درج سند از نوع(ک، "fa_ex_doc_books"، کتاب { شناسه = "4"، عنوان = "جای خالی سلوچ"، نویسنده = "محمود دولت‌آبادی"، سال = ۱۹۸۰ }، خ)
    ناپایا ب۴ := کتاب {}
    _ := تایپسنس.دریافت سند به نوع(ک، "fa_ex_doc_books"، "4"، ب۴، خ)
    سرچاپ "از یک ساختار:"، ب۴.عنوان، ب۴.سال
    ناپایا یکی := کتاب {}
    سرچاپ "رمزگشایی:"، تایپسنس.رمزگشایی سند(`{"id": "9", "title": "شازده احتجاب", "year": 1969}`، یکی، خ)، یکی.عنوان، یکی.سال
    ناپایا نادرست‌سند := کتاب {}
    سرچاپ "رمزگشایی نادرست:"، تایپسنس.رمزگشایی سند(`{"year": "عدد نیست"}`، نادرست‌سند، خ)، خ.kind برابر تایپسنس.نوع رمزگشایی

    سرچاپ "حذف:"، تایپسنس.حذف سند(ک، "fa_ex_doc_books"، "3"، خ)
    _ := تایپسنس.حذف سند(ک، "fa_ex_doc_books"، "3"، خ)
    سرچاپ "حذف دوباره:"، تایپسنس.پیدا نشد(خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_doc_books"، خ)
پایان
