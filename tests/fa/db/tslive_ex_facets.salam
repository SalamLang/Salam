واردسازی سیستم عامل
واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_facet_shoes"، خ)
    ناپایا طرح := تایپسنس.طرح { نام = "fa_ex_facet_shoes" }
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("brand"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("colors"، تایپسنس.نوع آرایه متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("price"، تایپسنس.نوع عدد۳۲))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "name": "کفش کوه‌پیمایی سبک", "brand": "رهرو", "colors": ["مشکی", "قرمز"], "price": 90}`)
    سندها.بیفزا(`{"id": "2", "name": "کفش دویدن جاده", "brand": "رهرو", "colors": ["سفید"], "price": 120}`)
    سندها.بیفزا(`{"id": "3", "name": "کفش پیاده‌روی شهری", "brand": "گام", "colors": ["مشکی"], "price": 60}`)
    سندها.بیفزا(`{"id": "4", "name": "پوتین کوهستان", "brand": "کوه", "colors": ["قهوه‌ای", "مشکی"], "price": 150}`)
    سندها.بیفزا(`{"id": "5", "name": "صندل تابستانی", "brand": "گام", "colors": ["قهوه‌ای"], "price": 30}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_facet_shoes"، سندها، تایپسنس.گزینه های نوشتن {}، خ)

    ناپایا ج := تایپسنس.جستجوی جدید("*"، "")
    ج.فیلدهای دسته‌بندی = "brand,colors,price"
    ج.بیشترین مقدار دسته‌بندی = ۳
    ن := تایپسنس.جستجو(ک، "fa_ex_facet_shoes"، ج، خ)
    هر د در ن.دسته‌بندی‌ها:
        ناپایا تکه := وکتور {} برگردان وکتور<رشته>
        هر ش در د.شمارها:
            تکه.بیفزا(ش.مقدار + "=" + ش.تعداد)
        پایان
        سرچاپ د.نام فیلد + ":"، رشته.بپیوند(تکه، " ")
        اگر د.نام فیلد برابر "price":
            سرچاپ "  آمار:"، د.آمار
        پایان
    پایان

    ناپایا تنگ := تایپسنس.جستجوی جدید("*"، "")
    تنگ.فیلدهای دسته‌بندی = "brand"
    تنگ.پرسمان دسته‌بندی = "brand:ره"
    نت := تایپسنس.جستجو(ک، "fa_ex_facet_shoes"، تنگ، خ)
    سرچاپ "برندهایی که با ره آغاز می‌شوند:"، نت.دسته‌بندی‌ها.بگیر(۰).شمارها.بگیر(۰).مقدار، نت.دسته‌بندی‌ها.بگیر(۰).شمارها.بگیر(۰).برجسته‌شده

    ناپایا پالوده := تایپسنس.جستجوی جدید("کفش"، "name")
    پالوده.فیلتر = "colors:=[مشکی] && price:<100"
    پالوده.فیلدهای دسته‌بندی = "brand"
    نپ := تایپسنس.جستجو(ک، "fa_ex_facet_shoes"، پالوده، خ)
    سرچاپ "کفش مشکی زیر ۱۰۰:"، نپ.یافت‌شده، نپ.دسته‌بندی‌ها.بگیر(۰).شمارها.بگیر(۰).مقدار

    ناپایا گروهی := تایپسنس.جستجوی جدید("*"، "")
    گروهی.فیلدهای گروه‌بندی = "brand"
    گروهی.حد گروه = ۱
    گروهی.ترتیب = "price:asc"
    نگ := تایپسنس.جستجو(ک، "fa_ex_facet_shoes"، گروهی، خ)
    سرچاپ "گروه‌ها:"، نگ.یافت‌شده، "سندها:"، نگ.سندهای یافت‌شده
    هر گروه در نگ.گروه‌ها:
        سرچاپ "  ارزان‌ترینِ"، رشته.بپیوند(گروه.کلید، ",")، "از"، گروه.یافت‌شده، "->"، گروه.یافته‌ها.بگیر(۰).سند
    پایان
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_facet_shoes"، خ)
پایان
