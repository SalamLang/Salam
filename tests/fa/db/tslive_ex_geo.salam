واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_geo_cafes"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_geo_cafes" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("location"، تایپسنس.نوع نقطه جغرافیایی))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "name": "کافه نادری", "location": [35.7019, 51.4223]}`)
    سندها.بیفزا(`{"id": "2", "name": "چایخانه لاله‌زار", "location": [35.6990, 51.4180]}`)
    سندها.بیفزا(`{"id": "3", "name": "قهوه تجریش", "location": [35.8040, 51.4330]}`)
    سندها.بیفزا(`{"id": "4", "name": "برشتکاری اصفهان", "location": [32.6546, 51.6680]}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_geo_cafes"، سندها، تایپسنس.گزینه های نوشتن {}، خ)

    ناپایا نزدیک := تایپسنس.جستجوی جدید("*"، "")
    نزدیک.filter_by = "location:(35.7000, 51.4200, 2 km)"
    نزدیک.sort_by = "location(35.7000, 51.4200):asc"
    ن := تایپسنس.جستجو(ک، "fa_ex_geo_cafes"، نزدیک، خ)
    سرچاپ "تا ۲ کیلومتری میدان:"، ن.found
    هر ی در ن.hits:
        سرچاپ "  "، ی.document، ی.geo_distance_meters
    پایان

    ناپایا شهر := تایپسنس.جستجوی جدید("*"، "")
    شهر.filter_by = "location:(35.7000, 51.4200, 20 km)"
    سرچاپ "تا ۲۰ کیلومتر:"، تایپسنس.جستجو(ک، "fa_ex_geo_cafes"، شهر، خ).found

    ناپایا محدوده := تایپسنس.جستجوی جدید("*"، "")
    محدوده.filter_by = "location:(33.0, 51.0, 33.0, 52.5, 32.0, 52.5, 32.0, 51.0)"
    سرچاپ "درون محدوده‌ی اصفهان:"، تایپسنس.جستجو(ک، "fa_ex_geo_cafes"، محدوده، خ).hits.بگیر(۰).document
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_geo_cafes"، خ)
پایان
