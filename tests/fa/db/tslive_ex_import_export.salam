واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

ساختار فیلم:
    @جیسون "id"
    همگانی شناسه: رشته = ""
    @جیسون "title"
    همگانی عنوان: رشته = ""
    @جیسون "year"
    همگانی سال: صحیح = ۰
    @جیسون "rating"
    همگانی امتیاز: اعشار۶۴ = ۰.۰
پایان

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_imp_movies"، خ)
    ناپایا طرح := تایپسنس.طرح { نام = "fa_ex_imp_movies" }
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("year"، تایپسنس.نوع عدد۳۲))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("rating"، تایپسنس.نوع اعشاری))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)

    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<فیلم>
    فیلم‌ها.بیفزا(فیلم { شناسه = "1"، عنوان = "گاو"، سال = ۱۹۶۹، امتیاز = ۸.۵ })
    فیلم‌ها.بیفزا(فیلم { شناسه = "2"، عنوان = "خانه دوست کجاست"، سال = ۱۹۸۷، امتیاز = ۸.۳ })
    فیلم‌ها.بیفزا(فیلم { شناسه = "3"، عنوان = "باشو غریبه کوچک"، سال = ۱۹۸۹، امتیاز = ۸.۵ })
    ن := تایپسنس.درون ریزی از نوع(ک، "fa_ex_imp_movies"، فیلم‌ها، تایپسنس.گزینه های نوشتن { کنش = تایپسنس.کنش ساخت، بازگرداندن شناسه = درست }، خ)
    سرچاپ "ساختارها:"، ن.موفق، "نوشته شد،"، ن.ناموفق، "ناموفق، شناسه‌ها"، ن.شناسه‌ها.بگیر(۰)، ن.شناسه‌ها.بگیر(۱)، ن.شناسه‌ها.بگیر(۲)

    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا("{\n  \"id\": \"4\",\n  \"title\": \"جدایی نادر از سیمین\",\n  \"year\": 2011,\n  \"rating\": 8.3\n}")
    سندها.بیفزا(`{"id": "1", "title": "گاو", "year": 1969, "rating": 8.5}`)
    سندها.بیفزا(`{"id": "5", "title": "طعم گیلاس", "year": "دهه‌ی هفتاد", "rating": 7.9}`)
    ن۲ := تایپسنس.درون ریزی سندها(ک، "fa_ex_imp_movies"، سندها، تایپسنس.گزینه های نوشتن { کنش = تایپسنس.کنش ساخت، بازگرداندن سند = درست }، خ)
    سرچاپ "جیسون:"، ن۲.موفق، "نوشته شد،"، ن۲.ناموفق، "ناموفق"
    هر ناموفق در ن۲.خطاها:
        سرچاپ "  خط"، ناموفق.سطر، "کد"، ناموفق.کد، ناموفق.خطا
    پایان
    سرچاپ "  نخستین نوشته:"، ن۲.سندها.بگیر(۰)

    ن۳ := تایپسنس.درون ریزی جیسون خطی(ک، "fa_ex_imp_movies"، "{\"id\": \"5\", \"title\": \"طعم گیلاس\", \"year\": \"1997\", \"rating\": 7.9}\n{\"id\": \"2\", \"rating\": 8.4}"، تایپسنس.گزینه های نوشتن { کنش = تایپسنس.کنش جایگذاری، مقدارهای ناپاک = تایپسنس.ناپاک تبدیل با رد، اندازه دسته = ۱۰۰ }، خ)
    سرچاپ "جایگذاری خطی:"، ن۳.موفق، ن۳.ناموفق، ن۳.سطرها.طول()

    خط‌ها := تایپسنس.برون بری سندها(ک، "fa_ex_imp_movies"، تایپسنس.گزینه های برون بری { فیلتر = "year:<1990"، فیلدهای شامل = "id,title,year,rating" }، خ)
    سرچاپ "برون‌بری پیش از ۱۹۹۰:"، خط‌ها.طول()
    ناپایا کهنه‌ها := وکتور {} برگردان وکتور<فیلم>
    اگر تایپسنس.رمزگشایی سندها(خط‌ها، کهنه‌ها، خ):
        هر ف در کهنه‌ها:
            سرچاپ "  "، ف.عنوان، ف.سال، ف.امتیاز
        پایان
    پایان
    سرچاپ "جیسون خطی خالی نیست:"، تایپسنس.برون بری جیسون خطی(ک، "fa_ex_imp_movies"، تایپسنس.گزینه های برون بری { فیلدهای مستثنی = "rating" }، خ).طول() بزرگتر ۰

    سرچاپ "به‌روزرسانی با پالایه:"، تایپسنس.به‌روزرسانی با پالایه(ک، "fa_ex_imp_movies"، "rating:>=8.5"، `{"rating": 9.0}`، خ)
    سرچاپ "حذف با پالایه:"، تایپسنس.حذف با پالایه(ک، "fa_ex_imp_movies"، "year:<1980"، ۱۰، خ)
    سرچاپ "مانده:"، تایپسنس.جستجو(ک، "fa_ex_imp_movies"، تایپسنس.جستجوی جدید("*"، "")، خ).یافت‌شده
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_imp_movies"، خ)
پایان
