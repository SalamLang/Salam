واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

ساختار فیلم:
    @json "id"
    همگانی شناسه: رشته = ""
    @json "title"
    همگانی عنوان: رشته = ""
    @json "year"
    همگانی سال: صحیح = ۰
    @json "rating"
    همگانی امتیاز: اعشار۶۴ = ۰.۰
پایان

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_imp_movies"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_imp_movies" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد دسته بندی("year"، تایپسنس.نوع عدد۳۲))
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("rating"، تایپسنس.نوع اعشاری))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)

    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<فیلم>
    فیلم‌ها.بیفزا(فیلم { شناسه = "1"، عنوان = "گاو"، سال = ۱۹۶۹، امتیاز = ۸.۵ })
    فیلم‌ها.بیفزا(فیلم { شناسه = "2"، عنوان = "خانه دوست کجاست"، سال = ۱۹۸۷، امتیاز = ۸.۳ })
    فیلم‌ها.بیفزا(فیلم { شناسه = "3"، عنوان = "باشو غریبه کوچک"، سال = ۱۹۸۹، امتیاز = ۸.۵ })
    ن := تایپسنس.درون ریزی از نوع(ک، "fa_ex_imp_movies"، فیلم‌ها، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش ساخت، return_id = درست }، خ)
    سرچاپ "ساختارها:"، ن.success، "نوشته شد،"، ن.failed، "ناموفق، شناسه‌ها"، ن.ids.بگیر(۰)، ن.ids.بگیر(۱)، ن.ids.بگیر(۲)

    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا("{\n  \"id\": \"4\",\n  \"title\": \"جدایی نادر از سیمین\",\n  \"year\": 2011,\n  \"rating\": 8.3\n}")
    سندها.بیفزا(`{"id": "1", "title": "گاو", "year": 1969, "rating": 8.5}`)
    سندها.بیفزا(`{"id": "5", "title": "طعم گیلاس", "year": "دهه‌ی هفتاد", "rating": 7.9}`)
    ن۲ := تایپسنس.درون ریزی سندها(ک، "fa_ex_imp_movies"، سندها، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش ساخت، return_doc = درست }، خ)
    سرچاپ "جیسون:"، ن۲.success، "نوشته شد،"، ن۲.failed، "ناموفق"
    هر ناموفق در ن۲.errors:
        سرچاپ "  خط"، ناموفق.line، "کد"، ناموفق.code، ناموفق.error
    پایان
    سرچاپ "  نخستین نوشته:"، ن۲.documents.بگیر(۰)

    ن۳ := تایپسنس.درون ریزی جیسون خطی(ک، "fa_ex_imp_movies"، "{\"id\": \"5\", \"title\": \"طعم گیلاس\", \"year\": \"1997\", \"rating\": 7.9}\n{\"id\": \"2\", \"rating\": 8.4}"، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش جایگذاری، dirty_values = تایپسنس.ناپاک تبدیل با رد، batch_size = ۱۰۰ }، خ)
    سرچاپ "جایگذاری خطی:"، ن۳.success، ن۳.failed، ن۳.lines.طول()

    خط‌ها := تایپسنس.برون بری سندها(ک، "fa_ex_imp_movies"، تایپسنس.گزینه های برون بری { filter_by = "year:<1990"، include_fields = "id,title,year,rating" }، خ)
    سرچاپ "برون‌بری پیش از ۱۹۹۰:"، خط‌ها.طول()
    ناپایا کهنه‌ها := وکتور {} برگردان وکتور<فیلم>
    اگر تایپسنس.رمزگشایی سندها(خط‌ها، کهنه‌ها، خ):
        هر ف در کهنه‌ها:
            سرچاپ "  "، ف.عنوان، ف.سال، ف.امتیاز
        پایان
    پایان
    سرچاپ "جیسون خطی خالی نیست:"، تایپسنس.برون بری جیسون خطی(ک، "fa_ex_imp_movies"، تایپسنس.گزینه های برون بری { exclude_fields = "rating" }، خ).طول() بزرگتر ۰

    سرچاپ "به‌روزرسانی با پالایه:"، تایپسنس.به‌روزرسانی با پالایه(ک، "fa_ex_imp_movies"، "rating:>=8.5"، `{"rating": 9.0}`، خ)
    سرچاپ "حذف با پالایه:"، تایپسنس.حذف با پالایه(ک، "fa_ex_imp_movies"، "year:<1980"، ۱۰، خ)
    سرچاپ "مانده:"، تایپسنس.جستجو(ک، "fa_ex_imp_movies"، تایپسنس.جستجوی جدید("*"، "")، خ).found
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_imp_movies"، خ)
پایان
