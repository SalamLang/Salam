واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_join_books"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_join_authors"، خ)

    ناپایا نویسندگان := تایپسنس.طرح { name = "fa_ex_join_authors" }
    نویسندگان.fields.بیفزا(تایپسنس.فیلد { name = "name"، kind = تایپسنس.نوع متن، sort = ۱ })
    نویسندگان.fields.بیفزا(تایپسنس.فیلد دسته بندی("country"، تایپسنس.نوع متن))
    _ := تایپسنس.ساخت مجموعه(ک، نویسندگان، خ)
    ناپایا ن‌سندها := وکتور {} برگردان وکتور<رشته>
    ن‌سندها.بیفزا(`{"id": "a1", "name": "جین آستین", "country": "انگلستان"}`)
    ن‌سندها.بیفزا(`{"id": "a2", "name": "صادق هدایت", "country": "ایران"}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_join_authors"، ن‌سندها، تایپسنس.گزینه های نوشتن {}، خ)

    ناپایا کتاب‌ها := تایپسنس.طرح { name = "fa_ex_join_books" }
    کتاب‌ها.fields.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    کتاب‌ها.fields.بیفزا(تایپسنس.فیلد { name = "author_id"، kind = تایپسنس.نوع متن، reference = "fa_ex_join_authors.id" })
    _ := تایپسنس.ساخت مجموعه(ک، کتاب‌ها، خ)
    ناپایا ک‌سندها := وکتور {} برگردان وکتور<رشته>
    ک‌سندها.بیفزا(`{"id": "1", "title": "اما", "author_id": "a1"}`)
    ک‌سندها.بیفزا(`{"id": "2", "title": "ترغیب", "author_id": "a1"}`)
    ک‌سندها.بیفزا(`{"id": "3", "title": "بوف کور", "author_id": "a2"}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_join_books"، ک‌سندها، تایپسنس.گزینه های نوشتن {}، خ)
    _ := تایپسنس.ساخت سند(ک، "fa_ex_join_books"، `{"id": "4", "title": "شبح", "author_id": "a9"}`، خ)
    سرچاپ "نویسنده‌ی ناشناس پذیرفته نشد:"، خ.status

    ناپایا ایرانی := تایپسنس.جستجوی جدید("*"، "")
    ایرانی.filter_by = "$fa_ex_join_authors(country:=ایران)"
    ایرانی.include_fields = "title,$fa_ex_join_authors(name)"
    ن := تایپسنس.جستجو(ک، "fa_ex_join_books"، ایرانی، خ)
    سرچاپ "کتاب‌های نویسندگان ایرانی:"، ن.found
    هر ی در ن.hits:
        سرچاپ "  "، ی.document
    پایان

    ناپایا انگلیسی := تایپسنس.جستجوی جدید("*"، "")
    انگلیسی.filter_by = "$fa_ex_join_authors(country:=انگلستان)"
    انگلیسی.include_fields = "title,$fa_ex_join_authors(name,country)"
    انگلیسی.sort_by = "$fa_ex_join_authors(name:asc)"
    نا := تایپسنس.جستجو(ک، "fa_ex_join_books"، انگلیسی، خ)
    سرچاپ "کتاب‌های نویسندگان انگلیسی:"، نا.found، تایپسنس.متن خطا(خ)
    هر ی در نا.hits:
        سرچاپ "  "، ی.document
    پایان
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_join_books"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_join_authors"، خ)
پایان
