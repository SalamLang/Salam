واردسازی سیستم عامل
واردسازی کدگذاری
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    نشانی := تکه‌ها.بگیر(۰)
    ناپایا مدیر := تایپسنس.جدید(نشانی، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(مدیر)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(مدیر، "fa_ex_key_orders"، خ)
    ناپایا طرح := تایپسنس.طرح { نام = "fa_ex_key_orders" }
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("item"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("customer"، تایپسنس.نوع متن))
    _ := تایپسنس.ساخت مجموعه(مدیر، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "item": "چای", "customer": "sara"}`)
    سندها.بیفزا(`{"id": "2", "item": "قهوه", "customer": "sara"}`)
    سندها.بیفزا(`{"id": "3", "item": "چای", "customer": "reza"}`)
    _ := تایپسنس.درون ریزی سندها(مدیر، "fa_ex_key_orders"، سندها، تایپسنس.گزینه های نوشتن {}، خ)

    ناپایا مجموعه‌ها := وکتور {} برگردان وکتور<رشته>
    مجموعه‌ها.بیفزا("fa_ex_key_orders")
    جستجوگر := تایپسنس.کلید فقط جستجو(مدیر، "fa_ex_key search"، مجموعه‌ها، خ)
    سرچاپ "کلید جستجو:"، جستجوگر.کنش‌ها.بگیر(۰)، جستجوگر.مجموعه‌ها.بگیر(۰)، "مقدار کامل فقط یک بار:"، جستجوگر.مقدار.طول() بزرگتر ۲۰
    خوانده := تایپسنس.دریافت کلید(مدیر، جستجوگر.شناسه، خ)
    سرچاپ "خواندن دوباره:"، خوانده.توضیح، "مقدار پنهان:"، خوانده.مقدار.طول() برابر ۰، "پیشوند یکی است:"، خوانده.پیشوند مقدار برابر جستجوگر.مقدار.زیررشته(۰، ۴)
    ناپایا هست := نادرست
    هر م در تایپسنس.فهرست کلیدها(مدیر، خ):
        اگر م.شناسه برابر جستجوگر.شناسه: هست = درست پایان
    پایان
    سرچاپ "در فهرست:"، هست

    ناپایا مرورگر := تایپسنس.جدید(نشانی، جستجوگر.مقدار)
    دیرکن تایپسنس.آزادسازی(مرورگر)
    سرچاپ "جستجوی مرورگر:"، تایپسنس.جستجو(مرورگر، "fa_ex_key_orders"، تایپسنس.جستجوی جدید("چای"، "item")، خ).یافت‌شده
    _ := تایپسنس.ساخت سند(مرورگر، "fa_ex_key_orders"، `{"item": "کیک", "customer": "x"}`، خ)
    سرچاپ "نوشتن مرورگر:"، خ.وضعیت

    محدود := تایپسنس.کلید جستجوی محدود(جستجوگر.مقدار، تایپسنس.پارامترهای جستجو { فیلتر = "customer:=sara" }، ۰)
    سرچاپ "کلید محدود پالایه را دارد:"، کدگذاری.کدگشایی پایه۶۴(محدود).بیاب("customer:=sara") بزرگتر ۰
    ناپایا سارا := تایپسنس.جدید(نشانی، محدود)
    دیرکن تایپسنس.آزادسازی(سارا)
    سرچاپ "سارا می‌بیند:"، تایپسنس.جستجو(سارا، "fa_ex_key_orders"، تایپسنس.جستجوی جدید("*"، "")، خ).یافت‌شده، "سفارش"
    ناپایا ترفند := تایپسنس.جستجوی جدید("*"، "")
    ترفند.فیلتر = "customer:=reza"
    سرچاپ "و نمی‌تواند گسترده‌اش کند:"، تایپسنس.جستجو(سارا، "fa_ex_key_orders"، ترفند، خ).یافت‌شده
    خام := تایپسنس.ساخت کلید جستجوی محدود(جستجوگر.مقدار، `{"filter_by": "customer:=reza", "expires_at": 1}`)
    ناپایا منقضی := تایپسنس.جدید(نشانی، خام)
    دیرکن تایپسنس.آزادسازی(منقضی)
    _ := تایپسنس.جستجو(منقضی، "fa_ex_key_orders"، تایپسنس.جستجوی جدید("*"، "")، خ)
    سرچاپ "کلید محدود منقضی:"، خ.وضعیت

    ناپایا همه := وکتور {} برگردان وکتور<رشته>
    همه.بیفزا(تایپسنس.کنش کلید همه)
    دلخواه := تایپسنس.ساخت کلید(مدیر، تایپسنس.مشخصات کلید { توضیح = "fa_ex_key own value"، کنش‌ها = همه، مجموعه‌ها = مجموعه‌ها، مقدار = "fa-ex-key-chosen-value-123"، حذف خودکار = درست، زمان انقضا = ۴۱۰۲۴۴۴۸۰۰ }، خ)
    سرچاپ "مقدار دلخواه:"، دلخواه.مقدار، دلخواه.حذف خودکار، دلخواه.زمان انقضا
    سرچاپ "حذف شد:"، تایپسنس.حذف کلید(مدیر، جستجوگر.شناسه، خ) برابر جستجوگر.شناسه، تایپسنس.حذف کلید(مدیر، دلخواه.شناسه، خ) برابر دلخواه.شناسه
    _ := تایپسنس.جستجو(مرورگر، "fa_ex_key_orders"، تایپسنس.جستجوی جدید("چای"، "item")، خ)
    سرچاپ "کلید حذف‌شده دیگر کار نمی‌کند:"، خ.وضعیت
    _ := تایپسنس.حذف مجموعه(مدیر، "fa_ex_key_orders"، خ)
پایان
