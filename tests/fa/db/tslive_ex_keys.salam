واردسازی سیستم عامل
واردسازی کدگذاری
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    نشانی := تکه‌ها.بگیر(۰)
    ناپایا مدیر := تایپسنس.جدید(نشانی، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(مدیر)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(مدیر، "fa_ex_key_orders"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_key_orders" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("item"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد دسته بندی("customer"، تایپسنس.نوع متن))
    _ := تایپسنس.ساخت مجموعه(مدیر، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "item": "چای", "customer": "sara"}`)
    سندها.بیفزا(`{"id": "2", "item": "قهوه", "customer": "sara"}`)
    سندها.بیفزا(`{"id": "3", "item": "چای", "customer": "reza"}`)
    _ := تایپسنس.درون ریزی سندها(مدیر، "fa_ex_key_orders"، سندها، تایپسنس.گزینه های نوشتن {}، خ)

    ناپایا مجموعه‌ها := وکتور {} برگردان وکتور<رشته>
    مجموعه‌ها.بیفزا("fa_ex_key_orders")
    جستجوگر := تایپسنس.کلید فقط جستجو(مدیر، "fa_ex_key search"، مجموعه‌ها، خ)
    سرچاپ "کلید جستجو:"، جستجوگر.actions.بگیر(۰)، جستجوگر.collections.بگیر(۰)، "مقدار کامل فقط یک بار:"، جستجوگر.value.طول() بزرگتر ۲۰
    خوانده := تایپسنس.دریافت کلید(مدیر، جستجوگر.id، خ)
    سرچاپ "خواندن دوباره:"، خوانده.description، "مقدار پنهان:"، خوانده.value.طول() برابر ۰، "پیشوند یکی است:"، خوانده.value_prefix برابر جستجوگر.value.زیررشته(۰، ۴)
    ناپایا هست := نادرست
    هر م در تایپسنس.فهرست کلیدها(مدیر، خ):
        اگر م.id برابر جستجوگر.id: هست = درست پایان
    پایان
    سرچاپ "در فهرست:"، هست

    ناپایا مرورگر := تایپسنس.جدید(نشانی، جستجوگر.value)
    دیرکن تایپسنس.آزادسازی(مرورگر)
    سرچاپ "جستجوی مرورگر:"، تایپسنس.جستجو(مرورگر، "fa_ex_key_orders"، تایپسنس.جستجوی جدید("چای"، "item")، خ).found
    _ := تایپسنس.ساخت سند(مرورگر، "fa_ex_key_orders"، `{"item": "کیک", "customer": "x"}`، خ)
    سرچاپ "نوشتن مرورگر:"، خ.status

    محدود := تایپسنس.کلید جستجوی محدود(جستجوگر.value، تایپسنس.پارامترهای جستجو { filter_by = "customer:=sara" }، ۰)
    سرچاپ "کلید محدود پالایه را دارد:"، کدگذاری.کدگشایی پایه۶۴(محدود).بیاب("customer:=sara") بزرگتر ۰
    ناپایا سارا := تایپسنس.جدید(نشانی، محدود)
    دیرکن تایپسنس.آزادسازی(سارا)
    سرچاپ "سارا می‌بیند:"، تایپسنس.جستجو(سارا، "fa_ex_key_orders"، تایپسنس.جستجوی جدید("*"، "")، خ).found، "سفارش"
    ناپایا ترفند := تایپسنس.جستجوی جدید("*"، "")
    ترفند.filter_by = "customer:=reza"
    سرچاپ "و نمی‌تواند گسترده‌اش کند:"، تایپسنس.جستجو(سارا، "fa_ex_key_orders"، ترفند، خ).found
    خام := تایپسنس.ساخت کلید جستجوی محدود(جستجوگر.value، `{"filter_by": "customer:=reza", "expires_at": 1}`)
    ناپایا منقضی := تایپسنس.جدید(نشانی، خام)
    دیرکن تایپسنس.آزادسازی(منقضی)
    _ := تایپسنس.جستجو(منقضی، "fa_ex_key_orders"، تایپسنس.جستجوی جدید("*"، "")، خ)
    سرچاپ "کلید محدود منقضی:"، خ.status

    ناپایا همه := وکتور {} برگردان وکتور<رشته>
    همه.بیفزا(تایپسنس.کنش کلید همه)
    دلخواه := تایپسنس.ساخت کلید(مدیر، تایپسنس.مشخصات کلید { description = "fa_ex_key own value"، actions = همه، collections = مجموعه‌ها، value = "fa-ex-key-chosen-value-123"، autodelete = درست، expires_at = ۴۱۰۲۴۴۴۸۰۰ }، خ)
    سرچاپ "مقدار دلخواه:"، دلخواه.value، دلخواه.autodelete، دلخواه.expires_at
    سرچاپ "حذف شد:"، تایپسنس.حذف کلید(مدیر، جستجوگر.id، خ) برابر جستجوگر.id، تایپسنس.حذف کلید(مدیر، دلخواه.id، خ) برابر دلخواه.id
    _ := تایپسنس.جستجو(مرورگر، "fa_ex_key_orders"، تایپسنس.جستجوی جدید("چای"، "item")، خ)
    سرچاپ "کلید حذف‌شده دیگر کار نمی‌کند:"، خ.status
    _ := تایپسنس.حذف مجموعه(مدیر، "fa_ex_key_orders"، خ)
پایان
