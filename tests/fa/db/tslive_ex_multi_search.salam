واردسازی سیستم عامل
واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع بساز(ک: تایپسنس.کلاینت، نام: رشته، مقدارها: وکتور<رشته>، خ &: تایپسنس.خطا):
    _ := تایپسنس.حذف مجموعه(ک، نام، خ)
    ناپایا طرح := تایپسنس.طرح { name = نام }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    هر م در مقدارها:
        سندها.بیفزا(`{"title": "` + م + `"}`)
    پایان
    _ := تایپسنس.درون ریزی سندها(ک، نام، سندها، تایپسنس.گزینه های نوشتن {}، خ)
پایان

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    ناپایا کتاب‌ها := وکتور {} برگردان وکتور<رشته>
    کتاب‌ها.بیفزا("دریای خاموش")
    کتاب‌ها.بیفزا("دریا و ستاره‌ها")
    کتاب‌ها.بیفزا("آواز کوهستان")
    بساز(ک، "fa_ex_multi_books"، کتاب‌ها، خ)
    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<رشته>
    فیلم‌ها.بیفزا("گرگ دریا")
    فیلم‌ها.بیفزا("باد بیابان")
    بساز(ک، "fa_ex_multi_films"، فیلم‌ها، خ)

    ناپایا دوتایی := وکتور {} برگردان وکتور<تایپسنس.درخواست جستجو>
    دوتایی.بیفزا(تایپسنس.درخواست جستجو { collection = "fa_ex_multi_books"، params = تایپسنس.جستجوی جدید("دریا"، "") })
    دوتایی.بیفزا(تایپسنس.درخواست جستجو { collection = "fa_ex_multi_films"، params = تایپسنس.جستجوی جدید("دریا"، "") })
    ناپایا سه‌تایی := وکتور {} برگردان وکتور<تایپسنس.درخواست جستجو>
    هر د در دوتایی:
        سه‌تایی.بیفزا(د)
    پایان
    سه‌تایی.بیفزا(تایپسنس.درخواست جستجو { collection = "fa_ex_multi_missing"، params = تایپسنس.جستجوی جدید("دریا"، "") })
    ناپایا مشترک := تایپسنس.جستجوی جدید(""، "title")
    مشترک.per_page = ۵
    نتیجه‌ها := تایپسنس.جستجوی چندگانه(ک، سه‌تایی، مشترک، خ)
    سرچاپ "جستجوها:"، نتیجه‌ها.طول()، "درخواست موفق:"، تایپسنس.موفق(خ)
    هر ن در نتیجه‌ها:
        اگر ن.code نابرابر ۰:
            سرچاپ "  ناموفق:"، ن.code، ن.error
        وگرنه:
            سرچاپ "  پیدا شد:"، ن.found
        پایان
    پایان

    اج := تایپسنس.جستجوی اجتماع(ک، دوتایی، مشترک، خ)
    سرچاپ "اجتماع:"، اج.found، "یافته در یک فهرست"
    هر ی در اج.hits:
        سرچاپ "  "، ی.collection، "جستجوی"، ی.search_index، ی.document
    پایان

    ناپایا بلند := تایپسنس.جستجوی جدید("*"، "")
    بلند.filter_by = "title:[" + رشته.تکرار("چیزی شبیه این نیست,"، ۳۰۰) + "آواز کوهستان]"
    سرچاپ "پرسمان از سقف بلندتر است:"، تایپسنس.متن پرسمان جستجو(بلند).طول() بزرگتر تایپسنس.بیشینه پرسمان دریافت
    سرچاپ "پرسمان بلند هم کار می‌کند:"، تایپسنس.جستجو(ک، "fa_ex_multi_books"، بلند، خ).found
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_multi_books"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_multi_films"، خ)
پایان
