واردسازی سیستم عامل
واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_pre_notes"، خ)
    _ := تایپسنس.حذف پیش تنظیم(ک، "fa_ex_pre_listing"، خ)
    _ := تایپسنس.حذف کلمات توقف(ک، "fa_ex_pre_common"، خ)
    _ := تایپسنس.حذف واژه نامه ریشه یابی(ک، "fa_ex_pre_plurals"، خ)

    ناپایا ریشه‌ها := وکتور {} برگردان وکتور<تایپسنس.ریشه کلمه>
    ریشه‌ها.بیفزا(تایپسنس.ریشه کلمه { واژه = "کتب"، واژه پایه = "کتاب" })
    ریشه‌ها.بیفزا(تایپسنس.ریشه کلمه { واژه = "علوم"، واژه پایه = "علم" })
    سرچاپ "واژه‌نامه وارد شد:"، تایپسنس.درون ریزی واژه نامه ریشه یابی(ک، "fa_ex_pre_plurals"، ریشه‌ها، خ)
    واژه‌نامه := تایپسنس.دریافت واژه نامه ریشه یابی(ک، "fa_ex_pre_plurals"، خ)
    سرچاپ "واژه‌نامه:"، واژه‌نامه.شناسه، واژه‌نامه.واژه‌ها.طول()، "در فهرست:"، رشته.بپیوند(تایپسنس.فهرست واژه نامه های ریشه یابی(ک، خ)، ",").بیاب("fa_ex_pre_plurals") بزرگتربرابر ۰

    ناپایا طرح := تایپسنس.طرح { نام = "fa_ex_pre_notes" }
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "text"، نوع = تایپسنس.نوع متن، ریشه‌یابی = درست })
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "topic"، نوع = تایپسنس.نوع متن، واژه‌نامه ریشه‌یابی = "fa_ex_pre_plurals" })
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("score"، تایپسنس.نوع عدد۳۲))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "text": "the runner was running", "topic": "کتاب و کتابخانه", "score": 3}`)
    سندها.بیفزا(`{"id": "2", "text": "a quiet library", "topic": "تاریخ علم", "score": 9}`)
    سندها.بیفزا(`{"id": "3", "text": "the end", "topic": "شهر از دور", "score": 5}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_pre_notes"، سندها، تایپسنس.گزینه های نوشتن {}، خ)
    سرچاپ "ریشه‌یابی انگلیسی، runs پیدا می‌کند:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، تایپسنس.جستجوی جدید("runs"، "text")، خ).یافت‌شده
    سرچاپ "واژه‌نامه، کتب پیدا می‌کند:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، تایپسنس.جستجوی جدید("کتب"، "topic")، خ).یافت‌شده
    سرچاپ "واژه‌نامه، علوم پیدا می‌کند:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، تایپسنس.جستجوی جدید("علوم"، "topic")، خ).یافت‌شده

    ناپایا واژه‌ها := وکتور {} برگردان وکتور<رشته>
    واژه‌ها.بیفزا("و")
    واژه‌ها.بیفزا("از")
    توقف := تایپسنس.درج کلمات توقف(ک، "fa_ex_pre_common"، واژه‌ها، "fa"، خ)
    سرچاپ "کلمات توقف:"، توقف.شناسه، توقف.منطقه زبانی، توقف.کلمات توقف.طول()
    ناپایا با‌توقف := تایپسنس.جستجوی جدید("از"، "topic")
    سرچاپ "از، به‌عنوان یک واژه:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، با‌توقف، خ).یافت‌شده
    با‌توقف.کلمات توقف = "fa_ex_pre_common"
    سرچاپ "از، به‌عنوان کلمه‌ی توقف:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، با‌توقف، خ).یافت‌شده
    سرچاپ "دریافت:"، تایپسنس.دریافت کلمات توقف(ک، "fa_ex_pre_common"، خ).کلمات توقف.طول()

    ناپایا فهرستی := تایپسنس.جستجوی جدید(""، "topic")
    فهرستی.ترتیب = "score:desc"
    فهرستی.اندازه صفحه = ۱
    پیش := تایپسنس.درج پیش تنظیم جستجو(ک، "fa_ex_pre_listing"، فهرستی، خ)
    سرچاپ "پیش‌تنظیم:"، پیش.نام، پیش.مقدار
    ناپایا با‌پیش := تایپسنس.جستجوی جدید("*"، "")
    با‌پیش.پیش‌تنظیم = "fa_ex_pre_listing"
    سرچاپ "با پیش‌تنظیم:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، با‌پیش، خ).یافته‌ها.بگیر(۰).سند
    سرچاپ "پیش‌تنظیم خام:"، تایپسنس.درج پیش تنظیم(ک، "fa_ex_pre_listing"، `{"query_by": "topic", "per_page": 2}`، خ).مقدار
    سرچاپ "دریافت:"، تایپسنس.دریافت پیش تنظیم(ک، "fa_ex_pre_listing"، خ).مقدار

    ناپایا هست := نادرست
    هر م در تایپسنس.فهرست پیش تنظیم ها(ک، خ):
        اگر م.نام برابر "fa_ex_pre_listing": هست = درست پایان
    پایان
    سرچاپ "در فهرست:"، هست
    سرچاپ "حذف شد:"، تایپسنس.حذف پیش تنظیم(ک، "fa_ex_pre_listing"، خ)، تایپسنس.حذف کلمات توقف(ک، "fa_ex_pre_common"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_pre_notes"، خ)
    سرچاپ "واژه‌نامه حذف شد:"، تایپسنس.حذف واژه نامه ریشه یابی(ک، "fa_ex_pre_plurals"، خ)
پایان
