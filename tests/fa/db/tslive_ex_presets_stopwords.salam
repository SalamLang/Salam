واردسازی سیستم عامل
واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_pre_notes"، خ)
    _ := تایپسنس.حذف پیش تنظیم(ک، "fa_ex_pre_listing"، خ)
    _ := تایپسنس.حذف کلمات توقف(ک، "fa_ex_pre_common"، خ)
    _ := تایپسنس.حذف واژه نامه ریشه یابی(ک، "fa_ex_pre_plurals"، خ)

    ناپایا ریشه‌ها := وکتور {} برگردان وکتور<تایپسنس.ریشه کلمه>
    ریشه‌ها.بیفزا(تایپسنس.ریشه کلمه { word = "کتب"، root = "کتاب" })
    ریشه‌ها.بیفزا(تایپسنس.ریشه کلمه { word = "علوم"، root = "علم" })
    سرچاپ "واژه‌نامه وارد شد:"، تایپسنس.درون ریزی واژه نامه ریشه یابی(ک، "fa_ex_pre_plurals"، ریشه‌ها، خ)
    واژه‌نامه := تایپسنس.دریافت واژه نامه ریشه یابی(ک، "fa_ex_pre_plurals"، خ)
    سرچاپ "واژه‌نامه:"، واژه‌نامه.id، واژه‌نامه.words.طول()، "در فهرست:"، رشته.بپیوند(تایپسنس.فهرست واژه نامه های ریشه یابی(ک، خ)، ",").بیاب("fa_ex_pre_plurals") بزرگتربرابر ۰

    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_pre_notes" }
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "text"، kind = تایپسنس.نوع متن، stem = درست })
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "topic"، kind = تایپسنس.نوع متن، stem_dictionary = "fa_ex_pre_plurals" })
    طرح.fields.بیفزا(تایپسنس.فیلد دسته بندی("score"، تایپسنس.نوع عدد۳۲))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "text": "the runner was running", "topic": "کتاب و کتابخانه", "score": 3}`)
    سندها.بیفزا(`{"id": "2", "text": "a quiet library", "topic": "تاریخ علم", "score": 9}`)
    سندها.بیفزا(`{"id": "3", "text": "the end", "topic": "شهر از دور", "score": 5}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_pre_notes"، سندها، تایپسنس.گزینه های نوشتن {}، خ)
    سرچاپ "ریشه‌یابی انگلیسی، runs پیدا می‌کند:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، تایپسنس.جستجوی جدید("runs"، "text")، خ).found
    سرچاپ "واژه‌نامه، کتب پیدا می‌کند:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، تایپسنس.جستجوی جدید("کتب"، "topic")، خ).found
    سرچاپ "واژه‌نامه، علوم پیدا می‌کند:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، تایپسنس.جستجوی جدید("علوم"، "topic")، خ).found

    ناپایا واژه‌ها := وکتور {} برگردان وکتور<رشته>
    واژه‌ها.بیفزا("و")
    واژه‌ها.بیفزا("از")
    توقف := تایپسنس.درج کلمات توقف(ک، "fa_ex_pre_common"، واژه‌ها، "fa"، خ)
    سرچاپ "کلمات توقف:"، توقف.id، توقف.locale، توقف.stopwords.طول()
    ناپایا با‌توقف := تایپسنس.جستجوی جدید("از"، "topic")
    سرچاپ "از، به‌عنوان یک واژه:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، با‌توقف، خ).found
    با‌توقف.stopwords = "fa_ex_pre_common"
    سرچاپ "از، به‌عنوان کلمه‌ی توقف:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، با‌توقف، خ).found
    سرچاپ "دریافت:"، تایپسنس.دریافت کلمات توقف(ک، "fa_ex_pre_common"، خ).stopwords.طول()

    ناپایا فهرستی := تایپسنس.جستجوی جدید(""، "topic")
    فهرستی.sort_by = "score:desc"
    فهرستی.per_page = ۱
    پیش := تایپسنس.درج پیش تنظیم جستجو(ک، "fa_ex_pre_listing"، فهرستی، خ)
    سرچاپ "پیش‌تنظیم:"، پیش.name، پیش.value
    ناپایا با‌پیش := تایپسنس.جستجوی جدید("*"، "")
    با‌پیش.preset = "fa_ex_pre_listing"
    سرچاپ "با پیش‌تنظیم:"، تایپسنس.جستجو(ک، "fa_ex_pre_notes"، با‌پیش، خ).hits.بگیر(۰).document
    سرچاپ "پیش‌تنظیم خام:"، تایپسنس.درج پیش تنظیم(ک، "fa_ex_pre_listing"، `{"query_by": "topic", "per_page": 2}`، خ).value
    سرچاپ "دریافت:"، تایپسنس.دریافت پیش تنظیم(ک، "fa_ex_pre_listing"، خ).value

    ناپایا هست := نادرست
    هر م در تایپسنس.فهرست پیش تنظیم ها(ک، خ):
        اگر م.name برابر "fa_ex_pre_listing": هست = درست پایان
    پایان
    سرچاپ "در فهرست:"، هست
    سرچاپ "حذف شد:"، تایپسنس.حذف پیش تنظیم(ک، "fa_ex_pre_listing"، خ)، تایپسنس.حذف کلمات توقف(ک، "fa_ex_pre_common"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_pre_notes"، خ)
    سرچاپ "واژه‌نامه حذف شد:"، تایپسنس.حذف واژه نامه ریشه یابی(ک، "fa_ex_pre_plurals"، خ)
پایان
