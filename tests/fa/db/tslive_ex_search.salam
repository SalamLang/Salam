واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

ساختار کتاب:
    @json "id"
    همگانی شناسه: رشته = ""
    @json "title"
    همگانی عنوان: رشته = ""
    @json "author"
    همگانی نویسنده: رشته = ""
    @json "year"
    همگانی سال: صحیح = ۰
پایان

تابع بکار(ک: تایپسنس.کلاینت، خ &: تایپسنس.خطا):
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_search_books"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_search_books"، default_sorting_field = "year" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("author"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("year"، تایپسنس.نوع عدد۳۲))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا کتاب‌ها := وکتور {} برگردان وکتور<کتاب>
    کتاب‌ها.بیفزا(کتاب { شناسه = "1"، عنوان = "کلیدر"، نویسنده = "محمود دولت‌آبادی"، سال = ۱۹۸۴ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "2"، عنوان = "جای خالی سلوچ"، نویسنده = "محمود دولت‌آبادی"، سال = ۱۹۷۹ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "3"، عنوان = "روزگار سپری شده مردم سالخورده"، نویسنده = "محمود دولت‌آبادی"، سال = ۲۰۰۰ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "4"، عنوان = "سووشون"، نویسنده = "سیمین دانشور"، سال = ۱۹۶۹ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "5"، عنوان = "بوف کور"، نویسنده = "صادق هدایت"، سال = ۱۹۳۶ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "6"، عنوان = "شازده احتجاب"، نویسنده = "هوشنگ گلشیری"، سال = ۱۹۶۹ })
    _ := تایپسنس.درون ریزی از نوع(ک، "fa_ex_search_books"، کتاب‌ها، تایپسنس.گزینه های نوشتن {}، خ)
پایان

تابع نشان(برچسب: رشته، ن: تایپسنس.نتیجه جستجو):
    سرچاپ برچسب + ": پیدا شد"، ن.found، "از"، ن.out_of
    هر ی در ن.hits:
        سرچاپ "   "، ی.document
    پایان
پایان

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    بکار(ک، خ)

    نشان("دولت‌آبادی"، تایپسنس.جستجو(ک، "fa_ex_search_books"، تایپسنس.جستجوی جدید("دولت‌آبادی"، "author")، خ))
    نشان("غلط تایپی"، تایپسنس.جستجو(ک، "fa_ex_search_books"، تایپسنس.جستجوی جدید("سوشون"، "title")، خ))
    نشان("پیشوند"، تایپسنس.جستجو(ک، "fa_ex_search_books"، تایپسنس.جستجوی جدید("شاز"، "title")، خ))

    ناپایا پالایه := تایپسنس.جستجوی جدید("*"، "")
    پالایه.filter_by = "year:>=1960 && year:<1990"
    پالایه.sort_by = "year:asc"
    پالایه.include_fields = "title,year"
    نشان("پالایه و ترتیب"، تایپسنس.جستجو(ک، "fa_ex_search_books"، پالایه، خ))

    ناپایا وزن‌دار := تایپسنس.جستجوی جدید("دولت‌آبادی"، "title,author")
    وزن‌دار.query_by_weights = "2,1"
    وزن‌دار.per_page = ۲
    وزن‌دار.page = ۲
    وزن‌دار.sort_by = "_text_match:desc,year:desc"
    ن := تایپسنس.جستجو(ک، "fa_ex_search_books"، وزن‌دار، خ)
    سرچاپ "صفحه"، ن.page، "از"، ن.found، "نتیجه، کمتر از یک ثانیه:"، ن.search_time_ms کوچکتر ۱۰۰۰
    هر ی در ن.hits:
        سرچاپ "   "، ی.document
    پایان

    ناپایا برجسته‌ساز := تایپسنس.جستجوی جدید("خالی سلوچ"، "title")
    برجسته‌ساز.highlight_start_tag = "["
    برجسته‌ساز.highlight_end_tag = "]"
    نب := تایپسنس.جستجو(ک، "fa_ex_search_books"، برجسته‌ساز، خ)
    سرچاپ "برجسته:"، تایپسنس.برجسته(نب.hits.بگیر(۰)، "title")

    ناپایا سخت‌گیر := تایپسنس.جستجوی جدید("سوشون"، "title")
    سخت‌گیر.num_typos = "0"
    سرچاپ "بی غلط تایپی:"، تایپسنس.جستجو(ک، "fa_ex_search_books"، سخت‌گیر، خ).found
    ناپایا دقیق := تایپسنس.جستجوی جدید("کلیدر"، "title")
    تایپسنس.تنظیم پارامتر(دقیق، "prioritize_exact_match"، "true")
    دقیق.limit = ۱
    سرچاپ "تطابق دقیق اول:"، تایپسنس.جستجو(ک، "fa_ex_search_books"، دقیق، خ).hits.بگیر(۰).document

    ناپایا ساختارها := وکتور {} برگردان وکتور<کتاب>
    همه := تایپسنس.جستجو(ک، "fa_ex_search_books"، تایپسنس.جستجوی جدید("دولت‌آبادی"، "author")، خ)
    اگر تایپسنس.یافته ها به نوع(همه، ساختارها، خ):
        هر ب در ساختارها:
            سرچاپ "ساختار:"، ب.سال، ب.عنوان
        پایان
    پایان
    سرچاپ "متن پرسمان:"، تایپسنس.متن پرسمان جستجو(پالایه)
    سرچاپ "پاسخ خام نتیجه دارد:"، تایپسنس.جستجوی خام(ک، "fa_ex_search_books"، تایپسنس.جستجوی جدید("هدایت"، "author")، خ).طول() بزرگتر ۰

    _ := تایپسنس.جستجو(ک، "fa_ex_search_books"، تایپسنس.جستجوی جدید("x"، "missing_field")، خ)
    سرچاپ "فیلد ناموجود:"، تایپسنس.متن خطا(خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_search_books"، خ)
پایان
