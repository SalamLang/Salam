واردسازی سیستم عامل
واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع نام‌ها(ن: تایپسنس.نتیجه جستجو): رشته:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    هر ی در ن.hits:
        خروجی.بیفزا(ی.document)
    پایان
    برگشت رشته.بپیوند(خروجی، " ")
پایان

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_syn_shop"، خ)
    _ := تایپسنس.حذف دسته مترادف(ک، "fa_ex_syn_clothes"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_syn_shop" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "name": "کتانی آبی"}`)
    سندها.بیفزا(`{"id": "2", "name": "کفش ورزشی دویدن"}`)
    سندها.بیفزا(`{"id": "3", "name": "ژاکت پشمی"}`)
    _ := تایپسنس.درون ریزی سندها(ک، "fa_ex_syn_shop"، سندها، تایپسنس.گزینه های نوشتن {}، خ)
    بیاب := تایپسنس.جستجوی جدید("کتانی"، "name")
    سرچاپ "پیش از مترادف:"، تایپسنس.جستجو(ک، "fa_ex_syn_shop"، بیاب، خ).found

    ناپایا کفش‌ها := وکتور {} برگردان وکتور<رشته>
    کفش‌ها.بیفزا("کتانی")
    کفش‌ها.بیفزا("ورزشی")
    کفش‌ها.بیفزا("اسنیکر")
    ناپایا مترادف‌ها := وکتور {} برگردان وکتور<تایپسنس.مترادف>
    مترادف‌ها.بیفزا(تایپسنس.مترادف { id = "shoes"، synonyms = کفش‌ها })
    دسته := تایپسنس.درج دسته مترادف(ک، "fa_ex_syn_clothes"، مترادف‌ها، خ)
    سرچاپ "دسته:"، دسته.name، دسته.items.طول()، رشته.بپیوند(دسته.items.بگیر(۰).synonyms، ",")
    _ := تایپسنس.به‌روزرسانی مجموعه(ک، "fa_ex_syn_shop"، `{"synonym_sets": ["fa_ex_syn_clothes"]}`، خ)
    سرچاپ "پس از مترادف:"، نام‌ها(تایپسنس.جستجو(ک، "fa_ex_syn_shop"، بیاب، خ))

    ناپایا یکی := وکتور {} برگردان وکتور<رشته>
    یکی.بیفزا("پلیور")
    یک‌سویه := تایپسنس.درج مترادف دسته(ک، "fa_ex_syn_clothes"، تایپسنس.مترادف { id = "pullover"، root = "ژاکت"، synonyms = یکی }، خ)
    سرچاپ "یک‌سویه:"، یک‌سویه.root، "->"، رشته.بپیوند(یک‌سویه.synonyms، ",")
    سرچاپ "ژاکت باز هم پیدا می‌شود:"، تایپسنس.جستجو(ک، "fa_ex_syn_shop"، تایپسنس.جستجوی جدید("ژاکت"، "name")، خ).found
    سرچاپ "اقلام:"، تایپسنس.فهرست مترادف های دسته(ک، "fa_ex_syn_clothes"، خ).طول()، تایپسنس.دریافت مترادف دسته(ک، "fa_ex_syn_clothes"، "pullover"، خ).root

    ناپایا هست := نادرست
    هر م در تایپسنس.فهرست دسته های مترادف(ک، خ):
        اگر م.name برابر "fa_ex_syn_clothes": هست = درست پایان
    پایان
    سرچاپ "در فهرست:"، هست، تایپسنس.دریافت دسته مترادف(ک، "fa_ex_syn_clothes"، خ).items.طول()
    سرچاپ "جیسون:"، تایپسنس.جیسون مترادف(یک‌سویه)
    سرچاپ "قلم حذف شد:"، تایپسنس.حذف مترادف دسته(ک، "fa_ex_syn_clothes"، "pullover"، خ)
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_syn_shop"، خ)
    سرچاپ "دسته حذف شد:"، تایپسنس.حذف دسته مترادف(ک، "fa_ex_syn_clothes"، خ)
پایان
