واردسازی سیستم عامل
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    تکه‌ها := سیستم عامل.متغیر محیطی("SALAM_TEST_TYPESENSE").بشکاف(" ")
    ناپایا ک := تایپسنس.جدید(تکه‌ها.بگیر(۰)، تکه‌ها.بگیر(۱))
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_vec_items"، خ)
    ناپایا طرح := تایپسنس.طرح { name = "fa_ex_vec_items" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد بردار("embedding"، ۳))
    سرچاپ "فیلد بردار:"، تایپسنس.جیسون فیلد(طرح.fields.بگیر(۱))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"id": "1", "name": "سیب", "embedding": [0.9, 0.1, 0.0]}`)
    سندها.بیفزا(`{"id": "2", "name": "گلابی", "embedding": [0.8, 0.2, 0.1]}`)
    سندها.بیفزا(`{"id": "3", "name": "چکش", "embedding": [0.0, 0.1, 0.9]}`)
    سندها.بیفزا(`{"id": "4", "name": "آچار", "embedding": [0.1, 0.0, 0.8]}`)
    ن۰ := تایپسنس.درون ریزی سندها(ک، "fa_ex_vec_items"، سندها، تایپسنس.گزینه های نوشتن {}، خ)
    سرچاپ "وارد شد:"، ن۰.success

    ناپایا ج := تایپسنس.جستجوی جدید("*"، "")
    ج.vector_query = "embedding:([0.85, 0.15, 0.05], k: 2)"
    ج.exclude_fields = "embedding"
    ن := تایپسنس.جستجو(ک، "fa_ex_vec_items"، ج، خ)
    سرچاپ "نزدیک‌ترین‌ها به یک میوه:"، ن.found
    هر ی در ن.hits:
        سرچاپ "  "، ی.document، "نزدیک:"، ی.vector_distance کوچکتر ۰.۰۵
    پایان

    ناپایا مانند := تایپسنس.جستجوی جدید("*"، "")
    مانند.vector_query = "embedding:([], id: 3, k: 1)"
    مانند.exclude_fields = "embedding"
    سرچاپ "شبیه‌ترین به چکش:"، تایپسنس.جستجو(ک، "fa_ex_vec_items"، مانند، خ).hits.بگیر(۰).document

    ناپایا ترکیبی := تایپسنس.جستجوی جدید("آچار"، "name")
    ترکیبی.vector_query = "embedding:([0.05, 0.05, 0.85], k: 4)"
    ترکیبی.exclude_fields = "embedding"
    نت := تایپسنس.جستجو(ک، "fa_ex_vec_items"، ترکیبی، خ)
    سرچاپ "بهترین یافته‌ی ترکیبی:"، نت.hits.بگیر(۰).document، "اطلاعات ترکیبی دارد:"، نت.hits.بگیر(۰).hybrid_search_info.طول() بزرگتر ۰
    _ := تایپسنس.حذف مجموعه(ک، "fa_ex_vec_items"، خ)
پایان
