واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("127.0.0.1:8108/"، "کلید")
    دیرکن تایپسنس.آزادسازی(ک)
    سرچاپ ک.nodes.بگیر(۰)، ک.api_key، ک.retries
    ناپایا ط := تایپسنس.طرح { name = "کتاب ها"، default_sorting_field = "سال" }
    ط.fields.بیفزا(تایپسنس.فیلد جدید("عنوان"، تایپسنس.نوع متن))
    ط.fields.بیفزا(تایپسنس.فیلد دسته بندی("سال"، تایپسنس.نوع عدد۳۲))
    ط.fields.بیفزا(تایپسنس.فیلد بردار("بردار"، ۳))
    سرچاپ تایپسنس.جیسون طرح(ط)
    ناپایا ج := تایپسنس.جستجوی جدید("سلام دنیا"، "عنوان")
    ج.per_page = ۵
    تایپسنس.تنظیم پارامتر(ج، "prefix"، "false")
    سرچاپ تایپسنس.متن پرسمان جستجو(ج)
    سرچاپ تایپسنس.جیسون پارامترهای جستجو(ج)
    سرچاپ تایپسنس.ساخت کلید جستجوی محدود("RN23GFr1s6jQ9kgSNg2O7fYcAUXU7127"، `{"filter_by":"company_id:124","expires_at":1906054106}`)
    سرچاپ تایپسنس.کنش درج، تایپسنس.ناپاک تبدیل با رد، تایپسنس.کنش کلید جستجو، تایپسنس.تطابق دقیق
    ناپایا خالی := تایپسنس.خوشه جدید(وکتور {} برگردان وکتور<رشته>، "کلید")
    دیرکن تایپسنس.آزادسازی(خالی)
    ناپایا خ := تایپسنس.خطا {}
    سرچاپ تایپسنس.سلامت(خالی، خ)، تایپسنس.موفق(خ)، خ.kind
    سرچاپ تایپسنس.متن خطا(خ)
    سرچاپ تایپسنس.سالم است(خالی)، تایپسنس.پیدا نشد(خ)
پایان
