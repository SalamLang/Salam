//! حالت: برنامه | عنوان: فیزباز
// زبان: فارسی
تابع اصلی:
    تکرار 1 تا 15 با i:
        اگر i % 15 == 0: چاپ "فیزباز"
        وگرنه i % 3 == 0: چاپ "فیز"
        وگرنه i % 5 == 0: چاپ "باز"
        وگرنه:
            چاپ i
        تمام
    تمام
تمام
