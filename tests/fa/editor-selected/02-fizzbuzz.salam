تابع ریشه:
    تکرار 1 تا 15 در i:
        اگر i % 15 برابر 0: سرچاپ "فیزباز"
        وگرنه i % 3 برابر 0: سرچاپ "فیز"
        وگرنه i % 5 برابر 0: سرچاپ "باز"
        وگرنه:
            سرچاپ i
        پایان
    پایان
پایان
