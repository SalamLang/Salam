روال ریشه:
    تکرار 1 تا 15 از i:
        اگر i % 15 == 0: سرچاپ "فیزباز"
        وگرنه i % 3 == 0: سرچاپ "فیز"
        وگرنه i % 5 == 0: سرچاپ "باز"
        وگرنه:
            سرچاپ i
        پایان
    پایان
پایان
