تابع فاکتوریل(ن: صحیح): صحیح:
    اگر ن <= 1: برگشت 1 پایان
    برگشت ن * فاکتوریل(ن - 1)
پایان

تابع ریشه:
    تکرار 1 تا 6 در i:
        سرچاپ i, "! =", فاکتوریل(i)
    پایان
پایان
