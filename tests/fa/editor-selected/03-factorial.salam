کارکرد فاکتوریل(ن: صحیح): صحیح:
    اگر ن <= 1: بازگشت 1 پایان
    بازگشت ن * فاکتوریل(ن - 1)
پایان

کارکرد آغازین:
    چرخه 1 تا 6 با i:
        چاپ i, "! =", فاکتوریل(i)
    پایان
پایان
