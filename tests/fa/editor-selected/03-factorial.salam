//! حالت: برنامه | عنوان: فاکتوریل
// زبان: فارسی
تابع فاکتوریل(ن: صحیح): صحیح:
    اگر ن <= 1: بازگشت 1 تمام
    بازگشت ن * فاکتوریل(ن - 1)
تمام

تابع اصلی:
    تکرار 1 تا 6 با i:
        چاپ i, "! =", فاکتوریل(i)
    تمام
تمام
