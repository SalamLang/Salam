کارکرد فیب(ن: صحیح): صحیح:
    اگر ن < 2: بازگشت ن پایان
    بازگشت فیب(ن - 1) + فیب(ن - 2)
پایان

کارکرد آغازین:
    گذرا خط := ""
    چرخه 12 با i: خط = خط + فیب(i) + " " پایان
    چاپ "فیبوناچی:", خط
پایان
