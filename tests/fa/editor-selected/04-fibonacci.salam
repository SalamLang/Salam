روال فیب(ن: صحیح): صحیح:
    اگر ن < 2: برگشت ن پایان
    برگشت فیب(ن - 1) + فیب(ن - 2)
پایان

روال ریشه:
    ناپایا خط := ""
    تکرار 12 از i: خط = خط + فیب(i) + " " پایان
    سرچاپ "فیبوناچی:", خط
پایان
