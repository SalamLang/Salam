//! حالت: برنامه | عنوان: فیبوناچی
// زبان: فارسی
تابع فیب(ن: صحیح): صحیح:
    اگر ن < 2: بازگشت ن تمام
    بازگشت فیب(ن - 1) + فیب(ن - 2)
تمام

تابع اصلی:
    متغیر خط := ""
    تکرار 12 با i: خط = خط + فیب(i) + " " تمام
    چاپ "فیبوناچی:", خط
تمام
