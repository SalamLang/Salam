روال اول است(ن: صحیح): منطقی:
    اگر ن < 2: برگشت نادرست پایان
    ناپایا i := 2
    تا i * i <= ن:
        اگر ن % i == 0: برگشت نادرست پایان
        i = i + 1
    پایان
    برگشت درست
پایان

روال ریشه:
    ناپایا خط := ""
    تکرار 2 تا 30 از ن:
        اگر اول است(ن): خط = خط + ن + " " پایان
    پایان
    سرچاپ "اعداد اول تا ۳۰:", خط
پایان
