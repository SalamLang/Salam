کارکرد اول است(ن: صحیح): منطقی:
    اگر ن < 2: بازگشت نادرست پایان
    گذرا i := 2
    تاهنگام i * i <= ن:
        اگر ن % i == 0: بازگشت نادرست پایان
        i = i + 1
    پایان
    بازگشت درست
پایان

کارکرد آغازین:
    گذرا خط := ""
    چرخه 2 تا 30 با ن:
        اگر اول است(ن): خط = خط + ن + " " پایان
    پایان
    چاپ "اعداد اول تا ۳۰:", خط
پایان
