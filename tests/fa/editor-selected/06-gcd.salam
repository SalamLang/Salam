کارکرد بمم(الف: صحیح, ب: صحیح): صحیح:
    گذرا ایکس := الف
    گذرا ایگرگ := ب
    تاهنگام ایگرگ != 0:
        ت := ایگرگ
        ایگرگ = ایکس % ایگرگ
        ایکس = ت
    پایان
    بازگشت ایکس
پایان

کارکرد آغازین:
    چاپ "ب.م.م ۴۸ و ۳۶ =", بمم(48, 36)
    چاپ "ب.م.م ۱۷ و ۵ =", بمم(17, 5)
پایان
