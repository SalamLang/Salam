تابع بمم(الف: صحیح, ب: صحیح): صحیح:
    ناپایا ایکس := الف
    ناپایا ایگرگ := ب
    تا ایگرگ نابرابر 0:
        ت := ایگرگ
        ایگرگ = ایکس % ایگرگ
        ایکس = ت
    پایان
    برگشت ایکس
پایان

تابع ریشه:
    سرچاپ "ب.م.م ۴۸ و ۳۶ =", بمم(48, 36)
    سرچاپ "ب.م.م ۱۷ و ۵ =", بمم(17, 5)
پایان
