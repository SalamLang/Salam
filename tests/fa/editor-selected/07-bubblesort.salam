کارکرد آغازین:
    گذرا آ := [5, 2, 8, 1, 9, 3]
    چرخه 6 با i:
        چرخه 5 - i با ج:
            اگر آ[ج] > آ[ج + 1]:
                ت := آ[ج]
                آ[ج] = آ[ج + 1]
                آ[ج + 1] = ت
            پایان
        پایان
    پایان
    گذرا خط := ""
    چرخه 6 با ک: خط = خط + آ[ک] + " " پایان
    چاپ "مرتب‌شده:", خط
پایان
