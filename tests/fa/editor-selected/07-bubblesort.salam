تابع ریشه:
    ناپایا آ := [5, 2, 8, 1, 9, 3]
    تکرار 6 در i:
        تکرار 5 - i در ج:
            اگر آ[ج] > آ[ج + 1]:
                ت := آ[ج]
                آ[ج] = آ[ج + 1]
                آ[ج + 1] = ت
            پایان
        پایان
    پایان
    ناپایا خط := ""
    تکرار 6 در ک: خط = خط + آ[ک] + " " پایان
    سرچاپ "مرتب‌شده:", خط
پایان
