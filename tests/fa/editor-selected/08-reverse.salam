تابع ریشه:
    س := "Salam"
    ناپایا ر := ""
    ناپایا i := س.طول() - 1
    تا i بزرگتربرابر 0:
        ر = ر.پیوست(س.زیررشته(i, 1))
        i--
    پایان
    سرچاپ "وارونه‌ی", س, "می‌شود", ر
پایان
