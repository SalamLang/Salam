//! حالت: برنامه | عنوان: وارونه‌سازی رشته
// زبان: فارسی
تابع اصلی:
    س := "Salam"
    متغیر ر := ""
    متغیر i := س.طول() - 1
    تاوقتی i >= 0:
        ر = ر.پیوست(س.زیررشته(i, 1))
        i = i - 1
    تمام
    چاپ "وارونه‌ی", س, "می‌شود", ر
تمام
