کارکرد آغازین:
    متن := "گربه سگ گربه پرنده گربه"
    گذرا کلمات := متن.بشکاف(" ")
    گذرا آمار := نگاشت {} برگردان نگاشت<رشته, صحیح> چرخه کلمات.طول() با i: ک := کلمات.بگیر(i)
    اگر آمار.دارد(ک): آمار.درج(ک, آمار.بگیر(ک) + 1)
    وگرنه:
        آمار.درج(ک, 1)
    پایان
پایان
گذرا پیمایه := آمار.پیمایش()
تاهنگام پیمایه.داردبعدی():
    چاپ پیمایه.کلید(), "->", پیمایه.مقدار()
    پیمایه.بعدی()
پایان
پایان
