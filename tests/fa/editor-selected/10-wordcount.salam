روال ریشه:
    متن := "گربه سگ گربه پرنده گربه"
    ناپایا کلمات := متن.بشکاف(" ")
    ناپایا آمار := نگاشت {} برگردان نگاشت<رشته, صحیح> تکرار کلمات.طول() از i: ک := کلمات.بگیر(i)
    اگر آمار.دارد(ک): آمار.درج(ک, آمار.بگیر(ک) + 1)
    وگرنه:
        آمار.درج(ک, 1)
    پایان
پایان
ناپایا پیمایه := آمار.پیمایش()
تا پیمایه.داردبعدی():
    سرچاپ پیمایه.کلید(), "->", پیمایه.مقدار()
    پیمایه.بعدی()
پایان
پایان
