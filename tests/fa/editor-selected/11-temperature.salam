//! حالت: برنامه | عنوان: تبدیل دما
// زبان: فارسی
تابع اصلی:
    چاپ "سلسیوس به فارنهایت"
    تکرار 0 تا 40 گام 10 با س:
        ف := (س بعنوان اعشار۶۴) * 9.0 / 5.0 + 32.0
        چاپ س, "س =", ف, "ف"
    تمام
تمام
