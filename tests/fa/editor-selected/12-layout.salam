//! حالت: چیدمان | عنوان: صفحه‌ی وب
// زبان: فارسی
صفحه:
    عنوان = "برنامه‌ی من"
    زبان = "فارسی"
    جهت = "راست به چپ"
    سرصفحه:
        پس‌زمینه = "آبی"
        رنگ = "سفید"
        فاصله داخلی = "24px"
        سرتیتر: اندازه = 1 محتوا = "به سلام خوش آمدید" تمام
    تمام
    جعبه:
        فاصله داخلی = "20px"
        پاراگراف: محتوا = "این صفحه از کد سلام ساخته شده است." تمام
    تمام
تمام
