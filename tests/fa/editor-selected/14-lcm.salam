روال بمم(الف: صحیح, ب: صحیح): صحیح:
    ناپایا ایکس := الف
    ناپایا ایگرگ := ب
    تا ایگرگ != 0:
        ت := ایگرگ
        ایگرگ = ایکس % ایگرگ
        ایکس = ت
    پایان
    برگشت ایکس
پایان

روال کمم(الف: صحیح, ب: صحیح): صحیح: برگشت الف / بمم(الف, ب) * ب پایان

روال ریشه:
    سرچاپ "ک.م.م ۴ و ۶ =", کمم(4, 6)
    سرچاپ "ک.م.م ۲۱ و ۶ =", کمم(21, 6)
پایان
