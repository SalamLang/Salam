//! حالت: برنامه | عنوان: عدد متقارن
// زبان: فارسی
تابع متقارن است(ن: صحیح): منطقی:
    متغیر ایکس := ن
    متغیر وارون := 0
    تاوقتی ایکس > 0:
        وارون = وارون * 10 + ایکس % 10
        ایکس = ایکس / 10
    تمام
    بازگشت وارون == ن
تمام

تابع اصلی:
    اعداد := [121, 123, 1221, 13] بعنوان صحیح[4]
    تکرار 4 با i:
        اگر متقارن است(اعداد[i]): چاپ اعداد[i], "متقارن است"
        وگرنه:
            چاپ اعداد[i], "متقارن نیست"
        تمام
    تمام
تمام
