روال متقارن است(ن: صحیح): منطقی:
    ناپایا ایکس := ن
    ناپایا وارون := 0
    تا ایکس > 0:
        وارون = وارون * 10 + ایکس % 10
        ایکس = ایکس / 10
    پایان
    برگشت وارون == ن
پایان

روال ریشه:
    اعداد := [121, 123, 1221, 13]
    تکرار 4 از i:
        اگر متقارن است(اعداد[i]): سرچاپ اعداد[i], "متقارن است"
        وگرنه:
            سرچاپ اعداد[i], "متقارن نیست"
        پایان
    پایان
پایان
