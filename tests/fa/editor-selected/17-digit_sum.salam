کارکرد جمع ارقام(ن: صحیح): صحیح:
    گذرا ایکس := ن
    گذرا مجموع := 0
    تاهنگام ایکس > 0:
        مجموع = مجموع + ایکس % 10
        ایکس = ایکس / 10
    پایان
    بازگشت مجموع
پایان

کارکرد آغازین:
    چاپ "جمع ارقام ۱۲۳۴۵ =", جمع ارقام(12345)
    چاپ "جمع ارقام ۹۹ =", جمع ارقام(99)
پایان
