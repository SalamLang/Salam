روال جمع ارقام(ن: صحیح): صحیح:
    ناپایا ایکس := ن
    ناپایا مجموع := 0
    تا ایکس > 0:
        مجموع = مجموع + ایکس % 10
        ایکس = ایکس / 10
    پایان
    برگشت مجموع
پایان

روال ریشه:
    سرچاپ "جمع ارقام ۱۲۳۴۵ =", جمع ارقام(12345)
    سرچاپ "جمع ارقام ۹۹ =", جمع ارقام(99)
پایان
