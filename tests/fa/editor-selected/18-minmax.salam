روال ریشه:
    آ := [5, 9, 1, 7, 3, 8, 2]
    ناپایا کمینه := آ[0]
    ناپایا بیشینه := آ[0]
    تکرار 1 تا 7 - 1 از i:
        اگر آ[i] < کمینه: کمینه = آ[i] پایان
        اگر آ[i] > بیشینه: بیشینه = آ[i] پایان
    پایان
    سرچاپ "کمینه =", کمینه, "بیشینه =", بیشینه
پایان
