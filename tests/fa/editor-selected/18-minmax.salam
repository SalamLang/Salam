تابع ریشه:
    آ := [5, 9, 1, 7, 3, 8, 2]
    ناپایا کمینه := آ[0]
    ناپایا بیشینه := آ[0]
    تکرار 1 تا 7 - 1 در i:
        اگر آ[i] کوچکتر کمینه: کمینه = آ[i] پایان
        اگر آ[i] بزرگتر بیشینه: بیشینه = آ[i] پایان
    پایان
    سرچاپ "کمینه =", کمینه, "بیشینه =", بیشینه
پایان
