کارکرد آغازین:
    آ := [10, 20, 30, 40, 50, 60]
    گذرا مجموع := 0
    چرخه 6 با i: مجموع = مجموع + آ[i] پایان
    میانگین := (مجموع برگردان اعشار۶۴) / 6.0
    چاپ "مجموع =", مجموع
    چاپ "میانگین =", میانگین
پایان
