//! حالت: برنامه | عنوان: میانگین
// زبان: فارسی
تابع اصلی:
    آ := [10, 20, 30, 40, 50, 60] بعنوان صحیح[6]
    متغیر مجموع := 0
    تکرار 6 با i: مجموع = مجموع + آ[i] تمام
    میانگین := (مجموع بعنوان اعشار۶۴) / 6.0
    چاپ "مجموع =", مجموع
    چاپ "میانگین =", میانگین
تمام
