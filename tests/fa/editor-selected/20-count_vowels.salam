//! حالت: برنامه | عنوان: شمارش مصوت‌ها
// زبان: فارسی
تابع اصلی:
    س := "salam donya"
    متغیر تعداد := 0
    تکرار س.طول() با i:
        ک := س.زیررشته(i, 1)
        اگر ک == "a" یا ک == "e" یا ک == "i" یا ک == "o" یا ک == "u":
            تعداد = تعداد + 1
        تمام
    تمام
    چاپ "تعداد مصوت‌ها در", س, "=", تعداد
تمام
