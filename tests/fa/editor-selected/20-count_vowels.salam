تابع ریشه:
    س := "salam donya"
    ناپایا تعداد := 0
    تکرار س.طول() در i:
        ک := س.زیررشته(i, 1)
        اگر ک برابر "a" یا ک برابر "e" یا ک برابر "i" یا ک برابر "o" یا ک برابر "u":
            تعداد++
        پایان
    پایان
    سرچاپ "تعداد مصوت‌ها در", س, "=", تعداد
پایان
