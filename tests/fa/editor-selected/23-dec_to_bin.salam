روال به دودویی(ن: صحیح): رشته:
    اگر ن == 0: برگشت "0" پایان
    ناپایا ایکس := ن
    ناپایا بیتها := ""
    تا ایکس > 0:
        بیتها = "" + (ایکس % 2) + بیتها
        ایکس = ایکس / 2
    پایان
    برگشت بیتها
پایان

روال ریشه:
    اعداد := [0, 5, 10, 255]
    تکرار 4 از i:
        سرچاپ اعداد[i], "در مبنای دو =", به دودویی(اعداد[i])
    پایان
پایان
