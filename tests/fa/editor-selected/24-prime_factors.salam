روال ریشه:
    ن := 360
    ناپایا ایکس := ن
    ناپایا خط := ""
    ناپایا د := 2
    تا د * د <= ایکس:
        تا ایکس % د == 0:
            خط = خط + د + " "
            ایکس = ایکس / د
        پایان
        د = د + 1
    پایان
    اگر ایکس > 1: خط = خط + ایکس + " " پایان
    سرچاپ ن, "=", خط
پایان
