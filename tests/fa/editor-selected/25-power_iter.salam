کارکرد توان(پایه: صحیح, نما: صحیح): صحیح:
    گذرا نتیجه := 1
    چرخه نما: نتیجه = نتیجه * پایه پایان
    بازگشت نتیجه
پایان

کارکرد آغازین:
    چرخه 0 تا 8 با e:
        چاپ "۲ به توان", e, "=", توان(2, e)
    پایان
پایان
