//! حالت: برنامه | عنوان: حساب بانکی
// زبان: فارسی
ساختار حساب:
    عمومی موجودی: صحیح = 0
    عمومی تابع واریز(مبلغ: صحیح): این.موجودی = این.موجودی + مبلغ تمام
    عمومی تابع برداشت(مبلغ: صحیح):
        اگر مبلغ <= این.موجودی: این.موجودی = این.موجودی - مبلغ
        وگرنه:
            چاپ "موجودی کافی نیست"
        تمام
    تمام
تمام

تابع اصلی:
    متغیر ح := حساب { موجودی = 100 }
    ح.واریز(50)
    ح.برداشت(30)
    ح.برداشت(200)
    چاپ "موجودی =", ح.موجودی
تمام
