روال ریشه:
    ناپایا پشته := وکتور {} برگردان وکتور<صحیح> پشته.بیفزا(1)
    پشته.بیفزا(2)
    پشته.بیفزا(3)
    سرچاپ "اندازه =", پشته.طول() برگردان صحیح
    تا پشته.طول() > 0:
        سرچاپ "برداشت", پشته.دربیاور()
    پایان
    سرچاپ "اندازه =", پشته.طول() برگردان صحیح
پایان
