شمارش روز: دوشنبه, سه_شنبه, چهارشنبه, پنجشنبه, جمعه, شنبه, یکشنبه پایان

کارکرد آخرهفته_است(ر: روز): منطقی: بازگشت ر == روز.شنبه یا ر == روز.یکشنبه پایان

کارکرد آغازین:
    ر := روز.شنبه
    چاپ "شماره‌ی روز =", ر برگردان صحیح
    اگر آخرهفته_است(ر): چاپ "آخر هفته است"
    وگرنه:
        چاپ "روز کاری است"
    پایان
پایان
