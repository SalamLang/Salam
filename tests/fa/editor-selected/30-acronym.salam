//! حالت: برنامه | عنوان: سرنام
// زبان: فارسی
تابع اصلی:
    عبارت := "salam azad multi platform"
    متغیر کلمات := عبارت.بشکاف(" ")
    متغیر سرنام := ""
    تکرار کلمات.طول() با i:
        ک := کلمات.بگیر(i)[0]
        سرنام = سرنام + ک.زیررشته(0, 1)
    تمام
    چاپ عبارت, "->", سرنام
تمام
