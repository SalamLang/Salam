روال جذر(ایکس: اعشار۶۴): اعشار۶۴:
    اگر ایکس <= 0.0: برگشت 0.0 پایان
    ناپایا حدس := ایکس
    تکرار 20:
        حدس = (حدس + ایکس / حدس) / 2.0
    پایان
    برگشت حدس
پایان

روال ریشه:
    مقادیر := [2.0, 16.0, 50.0]
    تکرار 3 از i:
        سرچاپ "جذر", مقادیر[i], "تقریباً", جذر(مقادیر[i])
    پایان
پایان
