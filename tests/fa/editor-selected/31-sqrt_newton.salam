کارکرد جذر(ایکس: اعشار۶۴): اعشار۶۴:
    اگر ایکس <= 0.0: بازگشت 0.0 پایان
    گذرا حدس := ایکس
    چرخه 20:
        حدس = (حدس + ایکس / حدس) / 2.0
    پایان
    بازگشت حدس
پایان

کارکرد آغازین:
    مقادیر := [2.0, 16.0, 50.0]
    چرخه 3 با i:
        چاپ "جذر", مقادیر[i], "تقریباً", جذر(مقادیر[i])
    پایان
پایان
