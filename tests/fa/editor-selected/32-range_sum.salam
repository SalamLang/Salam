تابع ریشه:
    ن := 100
    ناپایا مجموع := 0
    تکرار 1 تا ن در i: مجموع += i پایان
    فرمول := ن * (ن + 1) / 2
    سرچاپ "مجموع حلقه =", مجموع
    سرچاپ "مجموع فرمول =", فرمول
پایان
