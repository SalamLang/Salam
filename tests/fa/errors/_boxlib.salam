package boxes

@en "Box"
@fa "جعبه"
pub struct Box<T>:
    @en "v"
    @fa "مقدار"
    pub v: T
    @en "Get"
    @fa "بگیر"
    pub func Get(): T:
        ret this.v
    end
end

@en "Wrap"
@fa "بپیچ"
pub func Wrap<T>(x: T): Box<T>:
    ret Box { v = x }
end
