// انتظار: خطا۰۱۲
// انتظار پیام: آرگومان ۱: نمی‌توان 'صحیح' را به 'سن' پاس داد ('سال ها' نام دیگری برای 'سن' است)
ساختار سن:
    همگانی تعداد سال: صحیح = 0
پایان

گونه سال‌ها = سن

تابع نمایش(a: سال‌ها): صحیح:
    برگشت a.تعداد سال
پایان

تابع ریشه:
    سرچاپ نمایش(5)
پایان
