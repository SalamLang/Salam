// انتظار: خطا۰۱۲
// انتظار-پیام: آرگومان ۱: نمی‌توان 'صحیح' را به 'Age' پاس داد ('Years' نام دیگری برای 'Age' است)
ساختار Age:
    همگانی years: صحیح = 0
پایان

گونه Years = Age

تابع show(a: Years): صحیح:
    برگشت a.years
پایان

تابع ریشه:
    سرچاپ show(5)
پایان
