// انتظار: خطا۰۲۱
// انتظار-پیام: آرایه‌ها باید گونه‌ی عضو و طول یکسان داشته باشند
روال ریشه:
    الف := [۱، ۲، ۳]
    ب := [۱، ۲]
    سرچاپ الف == ب
پایان
