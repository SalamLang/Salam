// انتظار: خطا۲۶۲
// انتظار پیام: آن را به شکل گریز
// انتظار نه: U+200F
تابع ریشه:
    // بازبینی ⁦شده⁩
    نقش := "کاربر‮"
    سرچاپ نقش، "نیم‌فاصله‏"
پایان
