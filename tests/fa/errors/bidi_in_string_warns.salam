// انتظار: U+202E
// پرچم: --log-level=warn
// انتظار پیام: آن را به شکل گریز
// انتظار نه: U+200F
// انتظار نه: خطا:
تابع ریشه:
    // بازبینی ⁦شده⁩
    نقش := "کاربر‮"
    سرچاپ نقش، "نیم‌فاصله‏"
پایان
