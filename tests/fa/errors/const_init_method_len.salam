// انتظار: خطا۱۶۷
// انتظار پیام: پایا 'ن' به مقداری نیاز دارد که هنگام ترجمه معلوم باشد
// انتظار نه: پایا 'ک'
پایا ج := جفت{الف = 1، ب = 2}
پایا ن := ج.Len()
پایا ک := "abc".طول()

ساختار جفت:
    همگانی الف: صحیح = 0
    همگانی ب: صحیح = 0
    همگانی تابع len(): صحیح:
        برگشت این.الف + این.ب
    پایان
پایان

تابع ریشه:
    سرچاپ ن، ک
پایان
