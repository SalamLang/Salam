// انتظار: خطا۰۰۲
// انتظار-پیام: نمی‌توان 'پویا شکل' را به 'صحیح' نسبت داد

میانجی شکل:
    تابع مساحت(): صحیح
پایان

ساختار مربع:
    همگانی ضلع: صحیح = ۰
    همگانی تابع مساحت(): صحیح: برگشت این.ضلع * این.ضلع پایان
پایان

تابع ریشه:
    ش := [مربع { ضلع = ۳ }] برگردان پویا شکل[۱]
    ناپایا ع := ۰
    ع = ش[۰]
    سرچاپ ع
پایان
