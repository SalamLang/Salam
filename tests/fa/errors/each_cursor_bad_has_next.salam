// انتظار: خطا۰۶۵
// انتظار-پیام: به 'طول()' و 'بگیر(ش: صحیح)' نیاز دارد
ساختار پیمایشگربد:
    همگانی جا: صحیح = ۰
    همگانی تابع داردبعدی(): صحیح: برگشت این.جا پایان
    همگانی تابع مقدار(): صحیح: برگشت این.جا پایان
    همگانی تابع بعدی(): این.جا = این.جا + ۱ پایان
پایان

ساختار نگهدار:
    همگانی ز: صحیح = ۰
    همگانی تابع پیمایش(): پیمایشگربد: برگشت پیمایشگربد { جا = این.ز } پایان
پایان

تابع ریشه:
    ن := نگهدار { ز = ۰ }
    هر ایکس در ن:
        سرچاپ ایکس
    پایان
پایان
