// انتظار: خطا۰۰۱
// انتظار-پیام: شناسه‌ی 'offset' در یک فایل فارسی باید فارسی باشد
// انتظار-پیام: نام فارسی آن 'جایگاه' است
واردسازی کدگذاری.جیسون

تابع ریشه:
    تلاش:
        _ := جیسون.کدگشایی("[1, 2")
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، خ.offset
    پایان
پایان
