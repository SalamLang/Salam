// انتظار: خطا۰۸۰
// انتظار پیام: همخوان ناقص روی جداشمار 'روز‌هفته': عضو(های) چهارشنبه پوشش داده نشده است
جداشمار روز‌هفته: دوشنبه، سه شنبه، چهارشنبه پایان

تابع ریشه:
    d := روز‌هفته.دوشنبه
    همخوان d:
        دوشنبه: سرچاپ "m" پایان
        سه شنبه: سرچاپ "t" پایان
    پایان
پایان
