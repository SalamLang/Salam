// انتظار: خطا۰۸۳
// انتظار پیام: بلوک 'درون‌داد:' که 'abs' را اعلان می‌کند باید همراه واردسازی‌ها، پیش از هر دستور سطح‌بالای دیگری بیاید
// انتظار نه: 'واردسازی' باید
ساختار نقطه:
    همگانی ایکس: صحیح = 0
پایان

درون‌داد:
    تابع abs(x: صحیح): صحیح
پایان

تابع ریشه:
    ن := نقطه{ایکس = -3}
    سرچاپ abs(ن.ایکس)
پایان
