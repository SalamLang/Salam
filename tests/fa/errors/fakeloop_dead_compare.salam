// انتظار: خطا۲۵۱
تابع ریشه:
    لیمیت := 3
    ناپایا ن := 0
    بیگ := 5
    تا بیگ کوچکتر لیمیت و لیمیت کوچکتر 0:
        ن++
    پایان
    تا لیمیت بزرگتر 10 یا لیمیت کوچکتر 0:
        ن++
    پایان
    سرچاپ ن
پایان
