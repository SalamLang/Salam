// انتظار: خطا۲۵۲
تابع ریشه:
    ن := 10
    ناپایا کل := 0
    ناپایا ی := 0
    تا ی کوچکتر ن:
        کل += ن
    پایان
    ی = ن
    سرچاپ کل
پایان
