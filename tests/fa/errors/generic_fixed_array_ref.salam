واردسازی کدگذاری.جیسون

// انتظار: خطا۰۹۸
// انتظار-نه: خطا۰۰۲
// انتظار-نه: خطا۰۶۹
تابع ریشه:
    ناپایا خروجی := [۰، ۰، ۰]
    تلاش:
        جیسون.واسریال سازی("[7,8,9]"، خروجی)
    گرفتن خطا خ:
        سرچاپ خ.پیام
    پایان
    سرچاپ خروجی[۰]
پایان
