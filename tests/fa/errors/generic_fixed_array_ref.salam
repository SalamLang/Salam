واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

// انتظار: خطا۰۹۸
// انتظار-نه: خطا۰۰۲
// انتظار-نه: خطا۰۶۹
تابع ریشه:
    ناپایا خروجی := [۰، ۰، ۰]
    ناپایا خطا := خطای کدگذاری.خطای کدگذاری {}
    شد := جیسون.واسریال سازی("[7,8,9]"، خروجی، خطا)
    سرچاپ شد، خروجی[۰]
پایان
