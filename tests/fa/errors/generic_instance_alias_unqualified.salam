// انتظار پیام: ساختار ناشناخته 'جعبه'
فراخوانی ک "_boxlib.salam"

تابع ریشه:
    ج := ک.بپیچ(۵)
    سرچاپ ج.بگیر()
    ز := جعبه { مقدار = ۹ }
    سرچاپ ز.مقدار
پایان
