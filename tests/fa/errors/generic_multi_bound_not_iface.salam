// انتظار: خطا۰۰۱
// انتظار-پیام: یک میانجی نیست
میانجی شکل:
    تابع مساحت(): اعشار۶۴
پایان

ساختار چیز:
    همگانی ن: صحیح = ۰
پایان

ساختار مکعب:
    همگانی ض: اعشار۶۴ = ۱.۰
    همگانی تابع مساحت(): اعشار۶۴: برگشت این.ض پایان
پایان

تابع نمایش<ت: شکل + چیز>(چیز۲: ت):
    سرچاپ چیز۲.مساحت()
پایان

تابع ریشه:
    نمایش(مکعب { ض = ۲.۰ })
پایان
