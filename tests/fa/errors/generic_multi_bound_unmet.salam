// انتظار: خطا۰۰۲
// انتظار-پیام: متد 'نام' موجود نیست
میانجی شکل:
    تابع مساحت(): اعشار۶۴
پایان

میانجی نامدار:
    تابع نام(): رشته
پایان

ساختار لکه:
    همگانی ش: اعشار۶۴ = ۱.۰
    همگانی تابع مساحت(): اعشار۶۴: برگشت این.ش پایان
پایان

تابع نمایش<ت: شکل + نامدار>(چیز: ت):
    سرچاپ چیز.مساحت()
پایان

تابع ریشه:
    نمایش(لکه { ش = ۲.۰ })
پایان
