// انتظار: خطا۰۰۲
// انتظار-پیام: نمی‌توان 'جفت<رشته، صحیح>' را به 'صحیح' نسبت داد
ساختار جفت<ک، م>:
    همگانی الف: ک
    همگانی ب: م
پایان

تابع ریشه:
    ج := جفت { الف = "x"، ب = ۱ } برگردان جفت<رشته، صحیح>
    ناپایا ن := ۰
    ن = ج
    سرچاپ ن
پایان
