// انتظار پیام: خودش را شامل می‌شود
میانجی الف:
    شامل ب
    تابع یک(): صحیح
پایان

میانجی ب:
    شامل الف
    تابع دو(): صحیح
پایان

تابع ریشه:
    سرچاپ ۱
پایان
