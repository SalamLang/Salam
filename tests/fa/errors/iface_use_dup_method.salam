// انتظار-پیام: بیش از یک میانجی با روش
میانجی الف:
    تابع یکسان(): صحیح
پایان

میانجی ب:
    تابع یکسان(): صحیح
پایان

میانجی پ:
    شامل الف
    شامل ب
پایان

تابع ریشه:
    سرچاپ ۱
پایان
