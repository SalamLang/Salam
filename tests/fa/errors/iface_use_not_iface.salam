// انتظار: خطا۰۰۱
// انتظار پیام: باید نام میانجی دیگری باشد
ساختار چیز:
    همگانی ن: صحیح = ۰
پایان

میانجی الف:
    شامل چیز
    تابع یک(): صحیح
پایان

تابع ریشه:
    سرچاپ ۱
پایان
