// انتظار: خطا۰۰۲
// انتظار-پیام: متد 'مساحت' موجود نیست
میانجی شکل:
    تابع مساحت(): اعشار۶۴
پایان

ساختار لکه:
    همگانی ش: اعشار۶۴ = ۱.۰
پایان

کاربست شکل بر لکه:
پایان

تابع ریشه:
    ل := لکه { ش = ۲.۰ }
    سرچاپ ل.ش
پایان
