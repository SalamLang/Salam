// انتظار: خطا۲۹۶
// انتظار پیام: 'ورودی' را نمی‌توان درون عبارت یا دستور دیگر به کار برد
// انتظار پیام: ابتدا پاسخ را در یک متغیر نگه دارید و بعد از آن استفاده کنید:
// انتظار پیام: پاسخ := ورودی "نام شما: "
// انتظار پیام: سرچاپ پاسخ
تابع سلام(کی: رشته): رشته:
    برگشت "سلام " + کی
پایان

تابع بپرس(): رشته:
    برگشت ورودی "بپرس: "
پایان

تابع ریشه:
    سرچاپ ورودی "نام شما: "
    سرچاپ "سلام " + ورودی "نام"
    اگر ورودی "x" برابر "y":
        سرچاپ "یکی"
    پایان
    پ := سلام(ورودی "کی: ")
پایان
