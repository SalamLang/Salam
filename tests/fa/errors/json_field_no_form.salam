// انتظار: خطا۰۰۲
// انتظار-پیام: با گونه‌ی 'صحیح[2]' شکل جیسون ندارد
واردسازی کدگذاری.جیسون

ساختار مسیر:
    همگانی نقطه‌ها: صحیح[۲] = [۱، ۲]
پایان

تابع ریشه:
    ناپایا م := مسیر {}
    تلاش:
        جیسون.واسریال سازی("{}"، م)
    گرفتن خطا خ:
        سرچاپ خ.پیام
    پایان
پایان
