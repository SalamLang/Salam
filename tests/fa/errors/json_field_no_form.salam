// انتظار: خطا۰۰۲
// انتظار-پیام: با گونه‌ی 'صحیح[2]' شکل جیسون ندارد
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

ساختار مسیر:
    همگانی نقطه‌ها: صحیح[۲] = [۱، ۲]
پایان

تابع ریشه:
    ناپایا م := مسیر {}
    ناپایا خ := خطای کدگذاری.بدون خطا()
    سرچاپ جیسون.واسریال سازی("{}"، م، خ)
پایان
