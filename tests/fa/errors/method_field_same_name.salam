// انتظار: خطا۰۲۷
// انتظار پیام: متد 'شمار' هم‌نام فیلد 'شمار' از 'شمارنده' است
ساختار شمارنده:
    شمار: صحیح = 0
    همگانی تابع شمار(): صحیح:
        برگشت این.شمار
    پایان
پایان

تابع ریشه:
    ش := شمارنده {}
    سرچاپ ش.شمار()
پایان
