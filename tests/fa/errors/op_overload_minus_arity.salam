// انتظار: خطا۰۱۲
// انتظار-پیام: یا پارامتری نمی‌گیرد
ساختار V:
    همگانی x: صحیح = 0
    همگانی تابع -(a: V، b: V): V:
        برگشت V { x = a.x - b.x }
    پایان
پایان

تابع ریشه:
    سرچاپ (V {}).x
پایان
