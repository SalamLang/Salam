// انتظار: خطا۰۱۲
// انتظار-پیام: فقط روی 'این'
ساختار V:
    همگانی ok: منطقی = درست
    همگانی روال وارونه (o: V): منطقی:
        برگشت o.ok
    پایان
پایان

روال ریشه:
    سرچاپ (V {}).ok
پایان
