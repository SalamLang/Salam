// انتظار: خطا۰۱۲
// انتظار پیام: فقط روی 'این'
ساختار V:
    همگانی ok: منطقی = درست
    همگانی تابع وارونه (o: V): منطقی:
        برگشت o.ok
    پایان
پایان

تابع ریشه:
    سرچاپ (V {}).ok
پایان
