// انتظار: کارور
// انتظار-پیام: تنها کارورهای خودِ زبان
ساختار V:
    همگانی x: صحیح = 0
    همگانی تابع ***(o: V): V:
        برگشت V { x = این.x * o.x }
    پایان
پایان

تابع ریشه:
    سرچاپ (V {}).x
پایان
