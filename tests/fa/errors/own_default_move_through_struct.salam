// انتظار: خطا۲۵۹
ساختار Box:
    همگانی v: وکتور<صحیح> = وکتور {}
پایان

تابع keep(store &: وکتور<Box>، v: وکتور<صحیح>):
    store.بیفزا(Box { v = v })
پایان

تابع ریشه:
    ناپایا store := وکتور {} برگردان وکتور<Box>
    ناپایا d := وکتور {} برگردان وکتور<صحیح>
    d.بیفزا(4)
    keep(store، d)
    سرچاپ d.طول()، store.طول()
پایان
