// انتظار: خطا۲۵۸
تابع ریشه:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    v.بیفزا(1)
    p := v.ارجاع(0)
    v.بیفزا(2)
    سرچاپ p[0]
    v.آزادکن()
پایان
