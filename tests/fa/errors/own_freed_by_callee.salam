// انتظار: خطا۱۳۹
// انتظار-پیام: 'name' پس از آزاد شدن حافظه‌اش در خط ۳۲ استفاده شده است
واردسازی حافظه
واردسازی رشته

تابع release(s: رشته):
    سرچاپ "releasing " + s
    حافظه.آزادسازی(s برگردان تهی*)
پایان

تابع forget(s: رشته):
    release(s)
پایان

تابع ریشه:
    name := "user-" + رشته.از عدد(42 برگردان صحیح۶۴)
    forget(name)
    سرچاپ name
پایان
