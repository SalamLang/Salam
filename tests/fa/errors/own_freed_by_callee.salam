// انتظار: خطا۱۳۹
// انتظار پیام: 'نام' پس از آزاد شدن حافظه‌اش در خط ۳۲ استفاده شده است
واردسازی حافظه
واردسازی رشته

تابع آزاد کردن(s: رشته):
    سرچاپ "releasing " + s
    حافظه.آزادسازی(s برگردان تهی*)
پایان

تابع فراموش کردن(s: رشته):
    آزاد کردن(s)
پایان

تابع ریشه:
    نام := "user-" + رشته.از عدد(42 برگردان صحیح۶۴)
    فراموش کردن(نام)
    سرچاپ نام
پایان
