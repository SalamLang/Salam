// انتظار: خطا۱۳۹
تابع destroy(v: وکتور<صحیح>):
    v.آزادکن()
پایان

تابع ریشه:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    v.بیفزا(1)
    destroy(v)
    سرچاپ v.بگیر(0)
پایان
