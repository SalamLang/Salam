// پرچم: --ownership=warn --log-level=warn
// انتظار: هشدار۱۴۲
واردسازی حافظه
واردسازی رشته

تابع show(c: منطقی، s: رشته):
    اگر c:
        حافظه.آزادسازی(s برگردان تهی*)
    پایان
    سرچاپ s
پایان

تابع ریشه:
    show(نادرست، "x" + رشته.از عدد(1 برگردان صحیح۶۴))
پایان
