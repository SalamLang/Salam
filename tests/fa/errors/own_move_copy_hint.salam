// پرچم: --ownership=warn --log-level=warn
// انتظار: هشدار۱۶۳
// انتظار پیام: پس هرجا هر دو لازم است از 'سبد.رونوشت()' استفاده کنید
// انتظار پیام: پیش از سپردن وکتور یا نگاشت یک کپی از آن بگیرید
تابع نگه(انبار &: وکتور<وکتور<صحیح>>، و۱: وکتور<صحیح>):
    انبار.بیفزا(و۱)
پایان

تابع ریشه:
    ناپایا انبار := وکتور {} برگردان وکتور<وکتور<صحیح>>
    ناپایا سبد := وکتور {} برگردان وکتور<صحیح>
    سبد.بیفزا(۴)
    نگه(انبار، سبد)
    سرچاپ سبد.طول()، انبار.طول()
پایان
