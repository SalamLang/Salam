// پرچم: --ownership=warn --log-level=warn
// انتظار: هشدار۱۶۳
تابع keep(store &: وکتور<وکتور<صحیح>>، v: وکتور<صحیح>):
    store.بیفزا(v)
پایان

تابع ریشه:
    ناپایا store := وکتور {} برگردان وکتور<وکتور<صحیح>>
    ناپایا d := وکتور {} برگردان وکتور<صحیح>
    d.بیفزا(4)
    keep(store، d)
    سرچاپ d.طول()، store.طول()
پایان
