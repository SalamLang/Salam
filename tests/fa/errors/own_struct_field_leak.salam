// انتظار: خطا۲۵۰
// انتظار پیام: «ک.نام» یک رشته‌ی تازه در حافظه دارد که هرگز آزاد نمی‌شود
ساختار کاربر:
    همگانی نام: رشته = ""
پایان

تابع بپرس(): کاربر:
    برگشت کاربر { نام = ورودی "نام: " }
پایان

تابع ریشه:
    ک := بپرس()
    سرچاپ ک.نام
پایان
