// انتظار: خطا۱۳۹
// انتظار-پیام: 'copy' پس از آزاد شدن حافظه‌اش در خط ۲۴ استفاده شده است
واردسازی حافظه
واردسازی رشته

تابع ریشه:
    name := "item-" + رشته.از عدد(7)
    copy := name
    حافظه.آزادسازی(name برگردان تهی*)
    سرچاپ copy
پایان
