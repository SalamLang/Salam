// انتظار: خطا۱۳۹
// انتظار پیام: 'رونوشت' پس از آزاد شدن حافظه‌اش در خط ۲۴ استفاده شده است
واردسازی حافظه
واردسازی رشته

تابع ریشه:
    نام := "item-" + رشته.از عدد(7)
    رونوشت := نام
    حافظه.آزادسازی(نام برگردان تهی*)
    سرچاپ رونوشت
پایان
