// انتظار: خطا۰۱۳
ناپایا جمع := 0

ناب تابع افزودن(مقدار: صحیح): صحیح:
    جمع += مقدار
    برگشت جمع
پایان

تابع ریشه:
    سرچاپ افزودن(2)
پایان
