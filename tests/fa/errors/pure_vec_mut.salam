// انتظار: خطا۰۱۲
ناب تابع پرکن(شمار: صحیح): صحیح:
    ناپایا مقدار := وکتور {} برگردان وکتور<صحیح> مقدار.بیفزا(شمار)
    برگشت مقدار.طول()
پایان

تابع ریشه:
    سرچاپ پرکن(3)
پایان
