// انتظار: خطا۰۱۳
// انتظار پیام: نمی‌تواند به فیلد 'شمار' از 'این' مقدار بدهد
ساختار شمارنده:
    همگانی شمار: صحیح = 0

    همگانی ناب تابع افزایش(): صحیح:
        این.شمار++
        برگشت این.شمار
    پایان
پایان

تابع ریشه:
    ناپایا ک := شمارنده { شمار = 1 }
    سرچاپ ک.افزایش()
پایان
