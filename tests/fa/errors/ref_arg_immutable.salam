// انتظار: خطا۰۱۳
// انتظار-پیام: نمی‌توان متغیر تغییرناپذیر 'ن' را به پارامتر ارجاعی 'ایکس' داد؛ آن را 'ناپایا' تعریف کنید
روال افزایش(ایکس &: صحیح):
    ایکس = ایکس + 1
پایان

روال ریشه:
    ن := 10
    افزایش(ن)
    سرچاپ ن
پایان
