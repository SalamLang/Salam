// انتظار: خطا۰۶۳
// انتظار-پیام: شمار تکرار باید یک عدد باشد، اما 'منطقی' دریافت شد
// انتظار-پیام: بنویسید 'تا <شرط>:'
// انتظار-پیام: بنویسید 'تکرار 10 در i:'
تابع ریشه:
    ناپایا ن := ۱
    تکرار ن <= ۱۰۰:
        ن += ۱
    پایان
    سرچاپ ن
پایان
