// انتظار: خطا۰۱۲
// انتظار-پیام: نمی‌توان برشی از 'الف' را برگرداند
روال ساخت(): صحیح[]:
    الف := [۱، ۲، ۳]
    برگشت الف[:]
پایان

روال ریشه:
    سرچاپ طول(ساخت())
پایان
