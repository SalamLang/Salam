// انتظار: خطا۰۱۲
// انتظار پیام: نمی‌توان برشی از 'الف' را برگرداند
تابع ساخت(): صحیح[]:
    الف := [۱، ۲، ۳]
    برگشت الف[:]
پایان

تابع ریشه:
    سرچاپ طول(ساخت())
پایان
