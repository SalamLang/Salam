// انتظار: خطا:
// انتظار-پیام: شناسه‌ی 'Self' در یک فایل فارسی باید فارسی باشد
// انتظار-پیام: نام فارسی آن 'خود' است
// انتظار-نه: گونه‌ی ناشناخته
ساختار Rect:
    همگانی w: اعشار۶۴ = 0.0
    همگانی ایستا تابع Of(width: اعشار۶۴): Self:
        برگشت Self { w = width }
    پایان
پایان

تابع ریشه:
    سرچاپ Rect.Of(2.0).w
پایان
