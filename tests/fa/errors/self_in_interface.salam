// انتظار: خطا۰۰۱
// انتظار-پیام: گونه ناشناخته 'خود'
میانجی همسان:
    تابع همتا(): خود
پایان

ساختار الف:
    همگانی ن: صحیح = ۰
    همگانی تابع همتا(): الف: برگشت الف { ن = این.ن } پایان
پایان

تابع ریشه:
    سرچاپ الف { ن = ۱ }.همتا().ن
پایان
