// انتظار: خطا۱۶۲
// انتظار پیام: 'ع = ع + ب' مجاز نیست: بنویسید 'ع += ب'
// انتظار پیام: 'ع = ب + ع' مجاز نیست: بنویسید 'ع += ب'
// انتظار پیام: 'ع = ع - ب' مجاز نیست: بنویسید 'ع -= ب'
// انتظار پیام: 'ع = ع * ب' مجاز نیست: بنویسید 'ع *= ب'
// انتظار پیام: 'ع = ع / ب' مجاز نیست: بنویسید 'ع /= ب'
// انتظار پیام: 'ع = ع % ب' مجاز نیست: بنویسید 'ع %= ب'
// انتظار پیام: 'ع = ع + ۲' مجاز نیست: بنویسید 'ع += ۲'
// انتظار پیام: 'ع = ع + ب * ۳' مجاز نیست: بنویسید 'ع += ب * ۳'
// انتظار پیام: 'این.مقدار = این.مقدار * ب' مجاز نیست: بنویسید 'این.مقدار *= ب'
// انتظار پیام: 'ر = ر + "ب"' مجاز نیست: بنویسید 'ر += "ب"'
// انتظار پیام: بنویسید 'ع += ب'
ساختار شمارنده:
    همگانی مقدار: صحیح = ۲
    همگانی تابع مقیاس(ب: صحیح):
        این.مقدار = این.مقدار * ب
    پایان
پایان

تابع ریشه:
    ناپایا ع := ۵
    ب := ۳
    ناپایا ر := "الف"
    ناپایا ش := شمارنده {}
    ع = ع + ب
    ع = ب + ع
    ع = ع - ب
    ع = ع * ب
    ع = ع / ب
    ع = ع % ب
    ع = ع + ۲
    ع = ع + ب * ۳
    ر = ر + "ب"
    ش.مقیاس(۳)
    سرچاپ ع، ر، ش.مقدار
پایان
