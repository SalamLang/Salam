// انتظار: خطا۱۶۲
// انتظار پیام: 'ع = ع + ۰' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'ع = ۰ + ع' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'ع = ع - ۰' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'ع = ع * ۱' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'ع = ۱ * ع' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'ع = ع / ۱' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'ع += ۰' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'ع *= ۱' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'ع = ع' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: 'این.مقدار = این.مقدار * ۱' کاری انجام نمی‌دهد: این دستور را بردارید
// انتظار پیام: این دستور را بردارید
ساختار شمارنده:
    همگانی مقدار: صحیح = ۰
    همگانی تابع نگه():
        این.مقدار = این.مقدار * ۱
    پایان
پایان

تابع ریشه:
    ناپایا ع := ۵
    ناپایا ش := شمارنده {}
    ع = ع + ۰
    ع = ۰ + ع
    ع = ع - ۰
    ع = ع * ۱
    ع = ۱ * ع
    ع = ع / ۱
    ع += ۰
    ع *= ۱
    ع = ع
    ش.نگه()
    سرچاپ ع، ش.مقدار
پایان
