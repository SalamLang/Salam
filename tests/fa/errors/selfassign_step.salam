// انتظار: خطا۱۶۲
// انتظار پیام: 'ع = ع + ۱' مجاز نیست: بنویسید 'ع++'
// انتظار پیام: 'ع = ۱ + ع' مجاز نیست: بنویسید 'ع++'
// انتظار پیام: 'ع += ۱' مجاز نیست: بنویسید 'ع++'
// انتظار پیام: 'ع = ع - ۱' مجاز نیست: بنویسید 'ع--'
// انتظار پیام: 'ع -= ۱' مجاز نیست: بنویسید 'ع--'
// انتظار پیام: 'ع -= -۱' مجاز نیست: بنویسید 'ع++'
// انتظار پیام: 'ع = ع - (-۱)' مجاز نیست: بنویسید 'ع++'
// انتظار پیام: 'ع = (ع) + ۱' مجاز نیست: بنویسید 'ع++'
// انتظار پیام: 'ع = ع + یک' مجاز نیست: بنویسید 'ع++'
// انتظار پیام: 'ف = ف + ۱.۰' مجاز نیست: بنویسید 'ف++'
// انتظار پیام: 'این.مقدار = این.مقدار + ۱' مجاز نیست: بنویسید 'این.مقدار++'
// انتظار پیام: 'این.مقدار = این.مقدار - ۱' مجاز نیست: بنویسید 'این.مقدار--'
// انتظار پیام: 'آ[۱] = آ[۱] + ۱' مجاز نیست: بنویسید 'آ[۱]++'
// انتظار پیام: 'آ[ع] -= ۱' مجاز نیست: بنویسید 'آ[ع]--'
// انتظار پیام: بنویسید 'ع++'
پایا یک := ۱

ساختار شمارنده:
    همگانی مقدار: صحیح = ۰
    همگانی تابع افزایش():
        این.مقدار = این.مقدار + ۱
        این.مقدار = این.مقدار - ۱
    پایان
پایان

تابع ریشه:
    ناپایا ع := ۱
    ناپایا ف := ۱.۵
    ناپایا آ := [۱، ۲، ۳]
    ناپایا ش := شمارنده {}
    ع = ع + ۱
    ع = ۱ + ع
    ع += ۱
    ع = ع - ۱
    ع -= ۱
    ع -= -۱
    ع = ع - (-۱)
    ع = (ع) + ۱
    ع = ع + یک
    ف = ف + ۱.۰
    آ[۱] = آ[۱] + ۱
    آ[ع] -= ۱
    ش.افزایش()
    سرچاپ ع، ف، آ[۰]، ش.مقدار
پایان
