سرور تابع یافتن(شناسه: صحیح): رشته:
    برگشت "الف"
پایان

سرور تابع یافتن(نام: رشته): رشته:
    برگشت نام
پایان

تابع ریشه:
    سرچاپ یافتن(1)
پایان
