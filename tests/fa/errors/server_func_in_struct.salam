// انتظار: خطا۲۸۷
// انتظار پیام: تابع سرور 'گرفتن' باید در سطح بالای فایل تعریف شود
ساختار فروشگاه:
    همگانی نام: رشته = ""
    سرور تابع گرفتن(این): رشته:
        برگشت این.نام
    پایان
پایان

تابع ریشه:
    ف := فروشگاه { نام = "الف" }
    سرچاپ ف.نام
پایان
