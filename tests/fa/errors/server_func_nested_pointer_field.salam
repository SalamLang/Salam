// انتظار: خطا۲۸۵
// انتظار پیام: تابع سرور 'بارگیری' نتیجه‌ای از نوع 'جعبه' دارد که از شبکه عبور نمی‌کند
ساختار جعبه:
    همگانی نام: رشته = ""
    همگانی خام: صحیح* = پوچ
پایان

سرور تابع بارگیری(شناسه: صحیح): جعبه:
    برگشت جعبه { نام = "الف" }
پایان

تابع ریشه:
    سرچاپ بارگیری(1).نام
پایان
