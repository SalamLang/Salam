// انتظار: خطا۱۵۹
// انتظار پیام: فیلد 'user' را تعیین کرده و این فیلد به 'pass' نیاز دارد
ساختار س:
    @en "user"
    @fa "کاربر"
    همگانی user: رشته = ""
    @en "pass"
    @fa "رمز"
    همگانی pass: رشته = ""
    قاعده کاربر نیازمند رمز
پایان

تابع ریشه:
    م := س { کاربر = "الف" }
    سرچاپ م.کاربر
پایان
