// انتظار: خطا۱۵۹
// انتظار پیام: مقدار ساختاری 'مشتری' فیلد 'کاربر' را تعیین کرده و این فیلد به 'رمز' نیاز دارد
// انتظار پیام: ساختار این قاعده را دارد: قاعده کاربر نیازمند رمز
ساختار مشتری:
    همگانی کاربر: رشته = ""
    همگانی رمز: رشته = ""
    قاعده کاربر نیازمند رمز
پایان

تابع ریشه:
    م := مشتری { کاربر = "الف" }
    سرچاپ م.کاربر
پایان
