// انتظار: خطا۱۶۰
// انتظار پیام: فیلد ناشناخته‌ی 'رمزز' در قاعده‌ی ساختار 'س'
ساختار س:
    همگانی کاربر: رشته = ""
    همگانی رمز: رشته = ""
    قاعده کاربر نیازمند رمزز
پایان

تابع ریشه:
    م := س {}
    سرچاپ م.کاربر
پایان
