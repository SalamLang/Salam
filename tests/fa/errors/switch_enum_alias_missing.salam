// انتظار: خطا۱۰۳
// انتظار-پیام: این اعضا را پوشش نمی‌دهد: Square
جداشمار Shape:
    Circle، Square
پایان

گونه Figure = Shape

تابع name(f: Figure): رشته:
    ترابرد f:
        Figure.Circle:
            برگشت "circle"
        پایان
    پایان
    برگشت "?"
پایان

تابع ریشه:
    سرچاپ name(Figure.Circle)
پایان
