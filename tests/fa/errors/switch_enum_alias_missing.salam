// انتظار: خطا۱۰۳
// انتظار پیام: این اعضا را پوشش نمی‌دهد: مربع
جداشمار شکل:
    دایره، مربع
پایان

گونه پیکره = شکل

تابع نام(f: پیکره): رشته:
    ترابرد f:
        پیکره.دایره:
            برگشت "circle"
        پایان
    پایان
    برگشت "?"
پایان

تابع ریشه:
    سرچاپ نام(پیکره.دایره)
پایان
