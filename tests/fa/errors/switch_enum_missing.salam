// انتظار: خطا۱۰۳
// انتظار پیام: ترابرد روی جداشمار 'رنگ' این اعضا را پوشش نمی‌دهد: سبز, آبی
جداشمار رنگ:
    سرخ، سبز، آبی
پایان

تابع نام(c: رنگ): رشته:
    ترابرد c:
        رنگ.سرخ:
            برگشت "red"
        پایان
    پایان
    برگشت "?"
پایان

تابع ریشه:
    سرچاپ نام(رنگ.سرخ)
پایان
