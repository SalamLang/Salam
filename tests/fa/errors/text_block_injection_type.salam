// انتظار: خطا۰۲۱
// انتظار-پیام: کارور '+' روی رشته نیازمند آن است که عملوند دیگر رشته، عدد، منطقی یا نویسه باشد (دریافت 'رشته' و 'نقطه')
ساختار نقطه:
    همگانی ایکس: صحیح = 0
پایان

تابع ریشه:
    ن := نقطه { ایکس = 1 }
    م := ```
        ن=${{ ن }}
        ```
    سرچاپ م
پایان
