// انتظار: ${{
// انتظار-پیام: جایگذاری ${{ بسته نشده است: آن را در همان خط با }} ببندید
روال ریشه:
    ن := 3
    م := ```
        ن=${{ ن + 1
        ```
    سرچاپ م
پایان
