// انتظار: خطا۲۳۷
// انتظار پیام: «خطادار» دیگر کلیدواژه نیست
تابع نصف(ن: صحیح): صحیح خطادار:
    اگر ن % ۲ نابرابر ۰:
        پرتاب خطا "فرد"
    پایان
    برگشت ن / ۲
پایان

تابع بررسی(ن: صحیح) خطادار:
    اگر ن کوچکتر ۰:
        پرتاب خطا "منفی"
    پایان
پایان

تابع ریشه خطادار:
    سرچاپ تلاش نصف(۸)
    بررسی(۱)
پایان
