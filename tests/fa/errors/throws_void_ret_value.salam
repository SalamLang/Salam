// انتظار: خطا۰۴۹
تابع ذخیره(ن: صحیح) خطادار:
    اگر ن < ۰:
        پرتاب خطا "منفی"
    پایان
    برگشت ن
پایان

تابع ریشه:
    تلاش:
        ذخیره(۱)
    گرفتن خطا خ:
        سرچاپ خ.پیام
    پایان
پایان
