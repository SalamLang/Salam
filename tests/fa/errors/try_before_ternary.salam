// انتظار: خطا۰۱۲
// انتظار پیام: '?' باید کل مقدار دستورش باشد
// انتظار نه: یک عبارت انتظار می‌رفت
جداشمار پاسخ:
    Ok(م: صحیح)
    Err(پیام: رشته)
پایان

تابع بگیر(ن: صحیح): پاسخ:
    برگشت پاسخ.Ok(ن)
پایان

تابع بکار(ن: صحیح): پاسخ:
    ا := بگیر(ن)? بزرگتر ۱ ? ۱ : ۲
    برگشت پاسخ.Ok(ا)
پایان

تابع ریشه:
    سرچاپ بکار(5)
پایان
