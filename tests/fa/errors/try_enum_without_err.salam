// انتظار: خطا۰۱۲
// انتظار پیام: گونه‌ی برگشتی این تابع، عضوی به نام 'Err' ندارد
// انتظار نه: double free
جداشمار پاسخ:
    Ok(م: صحیح)
    شکست(پیام: رشته)
پایان

تابع نیمه(ن: صحیح): پاسخ:
    اگر ن % 2 != 0:
        برگشت پاسخ.شکست("فرد")
    پایان
    برگشت پاسخ.Ok(ن / 2)
پایان

تابع چارک(ن: صحیح): پاسخ:
    ن۲ := نیمه(ن)?
    برگشت پاسخ.Ok(ن۲)
پایان

تابع ریشه:
    سرچاپ چارک(8)
پایان
