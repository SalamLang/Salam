// انتظار: خطا۰۱۲
// انتظار پیام: '?' باید کل مقدار دستورش باشد
// انتظار نه: expected an expression
جداشمار پاسخ:
    Ok(م: صحیح)
    Err(پیام: رشته)
پایان

تابع بگیر(ن: صحیح): پاسخ:
    اگر ن > 0:
        برگشت پاسخ.Ok(ن)
    پایان
    برگشت پاسخ.Err("منفی")
پایان

تابع بکار(ن: صحیح): پاسخ:
    اگر بگیر(ن)? > 1:
        سرچاپ "بزرگ"
    پایان
    برگشت پاسخ.Ok(1)
پایان

تابع ریشه:
    سرچاپ بکار(5)
پایان
