// انتظار: خطا۰۱۶
// انتظار پیام: '?' مقداری از جداشماری با عضوهای 'Ok' و 'Err' می‌خواهد، اما 'پاسخ' عضوی به نام 'Err' ندارد
// انتظار نه: __tryerr
جداشمار پاسخ:
    Ok(م: صحیح)
    شکست(پیام: رشته)
پایان

جداشمار نتیجه<ت، خ>:
    Ok(مقدار: ت)
    Err(خطا: خ)
پایان

تابع نیمه(ن: صحیح): پاسخ:
    برگشت پاسخ.Ok(ن / 2)
پایان

تابع چارک(ن: صحیح): نتیجه<صحیح، رشته>:
    ن۲ := نیمه(ن)?
    برگشت نتیجه.Ok(ن۲)
پایان

تابع ریشه:
    سرچاپ چارک(8)
پایان
