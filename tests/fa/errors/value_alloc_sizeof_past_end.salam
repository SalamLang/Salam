// انتظار: خطا۱۴۶
// انتظار پیام: 'پ'
واردسازی حافظه

تابع ریشه:
    پ := حافظه.تخصیص(اندازه‌گونه(صحیح۶۴) * ۴) برگردان صحیح۶۴*
    تکرار ۴ در شمار:
        پ[شمار] = شمار برگردان صحیح۶۴
    پایان
    پ[۴] = ۰ برگردان صحیح۶۴
    سرچاپ پ[۰]
    حافظه.آزادسازی(پ برگردان تهی*)
پایان
