// انتظار: خطا۱۴۶
// انتظار پیام: اندیس خارج از محدوده است: 'سیستم عامل.آرگومان‌ها().طول() + ۵' برابر دست‌کم ۵ است، اما 'عددها' ۳ عضو دارد
واردسازی سیستم عامل

تابع ریشه:
    عددها := [۱۰، ۲۰، ۳۰]
    سرچاپ عددها[سیستم عامل.آرگومان‌ها().طول() + ۵]
پایان
