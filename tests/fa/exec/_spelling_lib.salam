package spellinglib

pub struct Counter:
    pub n: int = 0

    pub func AddItem(k: int):
        this.n += k
    end
end

pub func ParseHeader(s: str): int:
    ret s.Len()
end

pub func Total(): int:
    ret 7
end

pub func total(): int:
    ret 70
end

pub func read_all(): int:
    ret 5
end
