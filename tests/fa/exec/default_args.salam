پایا قدم := 5

ساختار جعبه:
    همگانی پهنا: صحیح = 1
    همگانی بلندی: صحیح = 1
    همگانی نام: رشته = "جعبه"
    همگانی روال رشد(مقدار: صحیح = 2): صحیح:
        برگشت این.پهنا + مقدار
    پایان
پایان

روال مساحت(پهنا: صحیح, بلندی: صحیح = 2): صحیح:
    برگشت پهنا * بلندی
پایان

روال افزایش(پایه: صحیح, مقدار: صحیح = قدم): صحیح:
    برگشت پایه + مقدار
پایان

روال ریشه:
    سرچاپ مساحت(3)
    سرچاپ مساحت(3, 4)
    سرچاپ افزایش(10)
    سرچاپ افزایش(10, 1)
    اول := جعبه {}
    دوم := جعبه { پهنا = 4, بلندی = 5, نام = "پهن" }
    سرچاپ اول.پهنا, اول.بلندی, اول.نام
    سرچاپ دوم.پهنا, دوم.بلندی, دوم.نام
    سرچاپ اول.رشد()
    سرچاپ اول.رشد(3)
پایان
