پایدار قدم := 5

ساختار جعبه:
    همگانی پهنا: صحیح = 1
    همگانی بلندی: صحیح = 1
    همگانی نام: رشته = "جعبه"
    همگانی کارکرد رشد(مقدار: صحیح = 2): صحیح:
        بازگشت این.پهنا + مقدار
    پایان
پایان

کارکرد مساحت(پهنا: صحیح, بلندی: صحیح = 2): صحیح:
    بازگشت پهنا * بلندی
پایان

کارکرد افزایش(پایه: صحیح, مقدار: صحیح = قدم): صحیح:
    بازگشت پایه + مقدار
پایان

کارکرد آغازین:
    چاپ مساحت(3)
    چاپ مساحت(3, 4)
    چاپ افزایش(10)
    چاپ افزایش(10, 1)
    اول := جعبه {}
    دوم := جعبه { پهنا = 4, بلندی = 5, نام = "پهن" }
    چاپ اول.پهنا, اول.بلندی, اول.نام
    چاپ دوم.پهنا, دوم.بلندی, دوم.نام
    چاپ اول.رشد()
    چاپ اول.رشد(3)
پایان
