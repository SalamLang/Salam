تابع اجرا(ف: تابع ()):
    ف()
پایان

تابع ریشه:
    ناپایا ن := وکتور {} برگردان وکتور<صحیح>
    ن.بیفزا(۱)
    ن.بیفزا(۲)
    اجرا(():
        سرچاپ "a"
        هر x در ن:
            سرچاپ x
        پایان
        تکرار ۰ تا ۵ هر ۲ در ای:
            سرچاپ ای
        پایان
    پایان)
    ن.آزاد کن()
پایان
