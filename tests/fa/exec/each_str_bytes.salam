تابع شانزده(عدد: صحیح): رشته:
    رقم‌ها := "0123456789abcdef"
    برگشت رقم‌ها.زیررشته(عدد / 16، 1) + رقم‌ها.زیررشته(عدد % 16، 1)
پایان

تابع نمایش(متن: رشته): رشته:
    ناپایا خروجی := ""
    هر ب در متن.بایت ها():
        خروجی = خروجی + شانزده(ب برگردان صحیح) + " "
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    سرچاپ نمایش("AZ09")
    سرچاپ نمایش("سلام")
    سرچاپ نمایش("€👋")
    ناپایا سرآغاز := 0
    ناپایا جمع := 0
    ناپایا یکسان := درست
    متن := "Hi سلام 👋"
    هر ش، ب در متن.بایت‌ها():
        مقدار := ب برگردان صحیح
        جمع += مقدار
        اگر مقدار < 128 یا مقدار >= 192:
            سرآغاز += 1
        پایان
        اگر ب != متن[ش]:
            یکسان = نادرست
        پایان
    پایان
    سرچاپ "بایت:"، متن.طول()، "سرآغاز:"، سرآغاز، "نویسه:"، متن.شمارنویسه()، "جمع:"، جمع، "یکسان:"، یکسان
    ناپایا نخستین := -1
    هر ش، ب در "abc✓def".بایت ها():
        اگر (ب برگردان صحیح) >= 128:
            نخستین = ش
            بشکن
        پایان
    پایان
    سرچاپ "نخستین بایت غیراسکی:"، نخستین
پایان
