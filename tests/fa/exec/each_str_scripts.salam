تابع فهرست(برچسب: رشته، متن: رشته):
    ناپایا تکه‌ها := ""
    ناپایا پهنا := ""
    ناپایا شمار := 0
    هر ش، ح در متن:
        اگر ح != متن.نویسه شماره(ش):
            سرچاپ "ناجور در"، ش
        پایان
        تکه‌ها = تکه‌ها + ح + "|"
        پهنا = پهنا + ح.طول()
        شمار += 1
    پایان
    سرچاپ برچسب، شمار، متن.شمارنویسه()، متن.طول()، پهنا، تکه‌ها
پایان

تابع وارونه‌ساز(متن: رشته): رشته:
    ناپایا خروجی := ""
    هر ح در متن:
        خروجی = ح + خروجی
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    فهرست("انگلیسی"، "Salam!")
    فهرست("فارسی"، "سلام دنیا")
    فهرست("عربی"، "مرحبا")
    فهرست("چینی"، "你好世界")
    فهرست("ایموجی"، "👋🌍✨")
    فهرست("آمیخته"، "Hi سلام 123 ۱۲۳")
    فهرست("نیم‌فاصله"، "می‌روم")
    فهرست("خالی"، "")
    سرچاپ وارونه‌ساز("سلام")، وارونه‌ساز("abc")
    ناپایا دیده := 0
    هر ح در "سلام سلام":
        اگر ح == u'س':
            دیده += 1
        پایان
    پایان
    سرچاپ "سین:"، دیده
پایان
