واردسازی مجموعه ها

جداشمار رنگ:
    قرمز، سبز، آبی
پایان

جداشمار واژه:
    پایین = "low"، بالا = "high"
پایان

ساختار نشان‌دار:
    همگانی ر: رنگ
    همگانی ش: صحیح
پایان

تابع ریشه:
    ناپایا م := نگاشت {} برگردان نگاشت<رنگ، صحیح>
    م.قراردادن(رنگ.قرمز، 1)
    م.قراردادن(رنگ.قرمز، 2)
    م.قراردادن(رنگ.آبی، 3)
    سرچاپ م.اندازه()، م.دریافت(رنگ.قرمز)، م.دریافت(رنگ.آبی)، م.دارد(رنگ.سبز)
    سرچاپ م.حذف(رنگ.قرمز)، م.اندازه()، م.دارد(رنگ.قرمز)

    ناپایا س := مجموعه ها.مجموعه {} برگردان مجموعه ها.مجموعه<رنگ>
    س.افزودن(رنگ.سبز)
    س.افزودن(رنگ.سبز)
    س.افزودن(رنگ.آبی)
    سرچاپ س.اندازه()، س.دارد(رنگ.سبز)، س.دارد(رنگ.قرمز)

    ناپایا ک := نگاشت {} برگردان نگاشت<واژه، صحیح>
    ک.قراردادن(واژه.بالا، 5)
    ک.قراردادن(واژه.بالا، 6)
    سرچاپ ک.اندازه()، ک.دریافت(واژه.بالا)، ک.دارد(واژه.پایین)

    ناپایا ف := وکتور {} برگردان وکتور<رنگ>
    ف.افزودن(رنگ.آبی)
    ف.افزودن(رنگ.قرمز)
    سرچاپ ف.دریافت(0) برابر رنگ.آبی، ف.دریافت(1) برابر رنگ.قرمز، ف.دریافت(0) برابر رنگ.قرمز
    همخوان ف.دریافت(0):
        رنگ.قرمز: سرچاپ "red" پایان
        رنگ.سبز: سرچاپ "green" پایان
        رنگ.آبی: سرچاپ "blue" پایان
    پایان

    ت := نشان‌دار { ر = رنگ.آبی، ش = 7 }
    سرچاپ ت.ر برابر رنگ.آبی، ت.ش
پایان
