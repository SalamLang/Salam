واردسازی مجموعه ها

جداشمار شکل:
    نقطه، دایره(ر: صحیح)
پایان

جداشمار رنگ:
    قرمز، سبز
پایان

ساختار کلید:
    همگانی ر: رنگ
    همگانی ش: صحیح
پایان

تابع ریشه:
    ناپایا م := نگاشت {} برگردان نگاشت<شکل، صحیح>
    م.قراردادن(شکل.دایره(3)، 1)
    م.قراردادن(شکل.دایره(3)، 2)
    م.قراردادن(شکل.دایره(4)، 3)
    م.قراردادن(شکل.نقطه، 4)
    م.قراردادن(شکل.نقطه، 5)
    سرچاپ م.اندازه()، م.دریافت(شکل.دایره(3))، م.دریافت(شکل.نقطه)

    ناپایا ج := نگاشت {} برگردان نگاشت<کلید، صحیح>
    ج.قراردادن(کلید { ر = رنگ.سبز، ش = 1 }، 1)
    ج.قراردادن(کلید { ر = رنگ.سبز، ش = 1 }، 2)
    ج.قراردادن(کلید { ر = رنگ.قرمز، ش = 1 }، 3)
    سرچاپ ج.اندازه()، ج.دریافت(کلید { ر = رنگ.سبز، ش = 1 })

    ناپایا س := مجموعه ها.مجموعه {} برگردان مجموعه ها.مجموعه<کلید>
    س.افزودن(
        کلید { ر = رنگ.قرمز، ش = 2 }
    )
    س.افزودن(کلید { ر = رنگ.قرمز، ش = 2 })
    سرچاپ س.اندازه()، س.دارد(کلید { ر = رنگ.قرمز، ش = 2 })، س.دارد(کلید { ر = رنگ.سبز، ش = 2 })
پایان
