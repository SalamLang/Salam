تابع ریشه:
    سرچاپ متغیر‌محیطی("PATH") نابرابر ""
    نبود := متغیر‌محیطی("SALAM_ENV_BUILTIN_UNSET_VAR")
    سرچاپ طول(نبود)
    سرچاپ نبود برابر ""
پایان
