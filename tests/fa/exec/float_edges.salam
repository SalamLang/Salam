تابع نگهدار<گ>(مقدار: گ): گ:
    برگشت مقدار
پایان

تابع ضرب‌وجمع(ا: اعشار۶۴، ب: اعشار۶۴، ک: اعشار۶۴): اعشار۶۴:
    برگشت ا * ب + ک
پایان

تابع ریشه:
    ز := نگهدار(0.0)
    سرچاپ 0.0 - ز، -ز، -0.0، نگهدار(-0.0)، 1.0 / -ز
    سرچاپ 5e-324، نگهدار(5e-324)، نگهدار(-1e-320)، نگهدار(2.2250738585072014e-308)
    سرچاپ نگهدار(0.1) + نگهدار(0.2)، نگهدار(0.1) + نگهدار(0.2) برابر 0.3، نگهدار(0.3) - نگهدار(0.2)
    ناپایا جمع := 0.0
    تکرار 10:
        جمع += نگهدار(0.1)
    پایان
    سرچاپ جمع، نگهدار(1e21)، نگهدار(123.456)، نگهدار(1.0) / نگهدار(3.0)
    سرچاپ ضرب‌وجمع(نگهدار(0.1)، نگهدار(10.0)، نگهدار(-1.0))
پایان
