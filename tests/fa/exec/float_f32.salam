واردسازی حافظه
واردسازی ریاضی
واردسازی تبدیل.قالب عددی

ساختار نمونه:
    همگانی وزن: اعشار۳۲
    همگانی دقیق: اعشار۶۴
پایان

تابع نگهدار<گ>(مقدار: گ): گ:
    برگشت مقدار
پایان

تابع یک سوم(): اعشار۳۲:
    برگشت نگهدار(1.0 برگردان اعشار۳۲) / نگهدار(3.0 برگردان اعشار۳۲)
پایان

تابع ریشه:
    الف := نگهدار(0.1 برگردان اعشار۳۲)
    ب := نگهدار(0.2 برگردان اعشار۳۲)
    سرچاپ الف، ب، الف + ب، الف * ب، (الف + ب) برگردان اعشار۶۴
    س := نمونه { وزن = نگهدار(2.5 برگردان اعشار۳۲) / نگهدار(7.0 برگردان اعشار۳۲)، دقیق = نگهدار(2.5) / نگهدار(7.0) }
    سرچاپ س.وزن، س.دقیق
    ناپایا فهرست := وکتور {} برگردان وکتور<اعشار۳۲>
    فهرست.افزودن(نگهدار(0.3 برگردان اعشار۳۲))
    فهرست.افزودن(نگهدار(16777217.0) برگردان اعشار۳۲)
    سرچاپ فهرست.دریافت(0)، فهرست.دریافت(1)، یک سوم()
    پ := حافظه.تخصیص(8 برگردان طبیعی۶۴) برگردان اعشار۳۲*
    پ[0] = نگهدار(1.1 برگردان اعشار۳۲)
    سرچاپ پ[0]
    حافظه.آزادسازی(پ برگردان تهی*)
    سرچاپ "f32 " + الف + " " + یک سوم()، "f64 " + نگهدار(0.1) + " " + نگهدار(1e-7) + " " + نگهدار(1e21)
    سرچاپ قالب عددی.قالب اعشار۳۲(نگهدار(3.4028235e38 برگردان اعشار۳۲))، قالب عددی.قالب اعشار۳۲(نگهدار(1e-45 برگردان اعشار۳۲))
    سرچاپ نگهدار(3.4e38 برگردان اعشار۳۲) * نگهدار(10.0 برگردان اعشار۳۲)، نگهدار(0.0 برگردان اعشار۳۲) / نگهدار(0.0 برگردان اعشار۳۲)، -نگهدار(0.0 برگردان اعشار۳۲)
    سرچاپ نگهدار(120.0 برگردان اعشار۳۲)، نگهدار(5040.0 برگردان اعشار۳۲)، نگهدار(1e9 برگردان اعشار۳۲)، نگهدار(1e-5 برگردان اعشار۳۲)
    سرچاپ ریاضی.گردکردن(نگهدار(2.5))، ریاضی.گردکردن(نگهدار(-2.5))، ریاضی.گردکردن(نگهدار(0.49999999999999994))
    سرچاپ ریاضی.گردکردن(نگهدار(4503599627370497.0))، ریاضی.گردکردن(نگهدار(-0.5))، ریاضی.گردکردن(نگهدار(1.5))
پایان
