واردسازی تبدیل
واردسازی تبدیل.قالب عددی

تابع بررسی(برچسب: رشته، متن: رشته):
    ناپایا نتیجه := ""
    تلاش:
        نتیجه = "" + (تلاش تبدیل.تجزیه اعشار(متن))
    گرفتن خطا خ:
        نتیجه = "error " + خ.کد + " at " + خ.جایگاه
    پایان
    سرچاپ "[" + برچسب + "] scan " + قالب عددی.خواندن اعشار(متن) + ", parse " + نتیجه
پایان

تابع تکرارشده(تکه: رشته، تعداد: صحیح): رشته:
    ناپایا خروجی := ""
    تکرار تعداد:
        خروجی += تکه
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    متنها := [
        "1_000.5"، "1.5_5"، "1e1_0"، "-2_5e-1"، "1__0"، "_1"، "1_"، "1_.5"، "1._5"، "1e_5"، "1e+_5"،
        "1e5_"، "0x1p3"، "0x10"، "abc"، "12abc"، ""، "  "، "-"، "+"، "1e"، "."، "e5"، "  2.5  "،
        "1."، ".5"، "inf"، "-Infinity"، "nan"، "1e400"، "1e-400"، "۱_۰۰۰٫۵"، "۱۲٫۵"، "٣٤.٥"، "1٫5"،
        "۱_۲"، "1_۲"، "1e23"، "2.2250738585072011e-308"، "2.2250738585072012e-308"،
        "4.9406564584124654e-324"، "2.4703282292062327e-324"، "2.4703282292062328e-324"،
        "1.7976931348623157e308"، "1.7976931348623159e308"، "9007199254740993"،
        "9007199254740993.0000000001"، "9007199254740995"، "0.1"،
        "1.00000000000000011102230246251565404236316680908203125"،
        "1.00000000000000011102230246251565404236316680908203125000001"
    ]
    تکرار متنها.طول() در شماره:
        بررسی(متنها[شماره]، متنها[شماره])
    پایان
    نیمه := "1.00000000000000011102230246251565404236316680908203125"
    بررسی("half and 745 zeros"، نیمه + تکرارشده("0"، 745))
    بررسی("half, 744 zeros, 1"، نیمه + تکرارشده("0"، 744) + "1")
    بررسی("tie, 784 zeros"، "9007199254740993." + تکرارشده("0"، 784))
    بررسی("tie, 783 zeros, 1"، "9007199254740993." + تکرارشده("0"، 783) + "1")
    بررسی("800 digits grouped"، "1" + تکرارشده("_000"، 266) + "_0e-799")
    بررسی("800 digits grouped, fraction"، "0." + تکرارشده("142_857_"، 99) + "14e1_0")
پایان
