بسته ریشه

واردسازی قالب بندی

تابع نمایش(مقدار: اعشار۶۴، الگو: رشته):
    سرچاپ الگو + " [" + قالب بندی.عدد اعشار با الگو(مقدار، الگو) + "]"
پایان

تابع نمایش_صحیح(مقدار: صحیح۶۴، الگو: رشته):
    سرچاپ الگو + " [" + قالب بندی.عدد صحیح با الگو(مقدار، الگو) + "]"
پایان

تابع ریشه:
    سرچاپ "rounding of the exact binary value"
    نمایش(0.125، "%.2f")
    نمایش(0.375، "%.2f")
    نمایش(2.5، "%.0f")
    نمایش(3.5، "%.0f")
    نمایش(0.135، "%.2f")
    نمایش(2.675، "%.2f")
    نمایش(1.005، "%.2f")
    نمایش(0.9995، "%.3f")
    نمایش(9.9999995، "%g")
    نمایش(0.1، "%.20f")
    نمایش(0.3، "%.17g")
    نمایش(-0.0004، "%.3f")

    سرچاپ "conversions"
    نمایش(1234.5678، "%f")
    نمایش(1234.5678، "%e")
    نمایش(1234.5678، "%E")
    نمایش(1234.5678، "%g")
    نمایش(1234567.0، "%g")
    نمایش(1234567.0، "%G")
    نمایش(0.0001234، "%g")
    نمایش(0.00001234، "%g")
    نمایش(100.0، "%g")
    نمایش(100.0، "%#g")
    نمایش(1.5، "%.0e")
    نمایش(1.5، "%#.0e")
    نمایش(7.0، "%#.0f")
    نمایش(0.0، "%e")
    نمایش(0.0، "%g")
    نمایش(42.0، "")

    سرچاپ "flags and width"
    نمایش(3.14159، "%10.3f")
    نمایش(3.14159، "%-10.3f")
    نمایش(3.14159، "%+.2f")
    نمایش(3.14159، "% .2f")
    نمایش(-3.14159، "%010.2f")
    نمایش(3.14159، "%+010.2f")
    نمایش(-0.0، "%.1f")
    نمایش(-0.0، "%+g")
    نمایش(1.0، "%-+8.1f")

    سرچاپ "extremes"
    نمایش(1e300، "%e")
    نمایش(1e300، "%.3g")
    نمایش(1.7976931348623157e308، "%.17e")
    نمایش(2.2250738585072014e-308، "%.6e")
    نمایش(5e-324، "%.3e")
    نمایش(5e-324، "%g")
    نمایش(1e22، "%f")
    نمایش(1e23، "%.0f")

    سرچاپ "nan and inf"
    بزرگ := 1e308
    بی_نهایت := بزرگ * 10.0
    ناعدد := بی_نهایت - بی_نهایت
    نمایش(بی_نهایت، "%f")
    نمایش(-بی_نهایت، "%e")
    نمایش(بی_نهایت، "%+G")
    نمایش(ناعدد، "%F")
    نمایش(ناعدد، "% g")
    نمایش(بی_نهایت، "%08f")
    نمایش(-بی_نهایت، "%-8f")

    سرچاپ "integers"
    نمایش_صحیح(42 برگردان صحیح۶۴، "%d")
    نمایش_صحیح(42 برگردان صحیح۶۴، "%5d")
    نمایش_صحیح(42 برگردان صحیح۶۴، "%-5d")
    نمایش_صحیح(42 برگردان صحیح۶۴، "%05d")
    نمایش_صحیح(42 برگردان صحیح۶۴، "%+d")
    نمایش_صحیح(42 برگردان صحیح۶۴، "% d")
    نمایش_صحیح(-42 برگردان صحیح۶۴، "%05d")
    نمایش_صحیح(42 برگردان صحیح۶۴، "%.5d")
    نمایش_صحیح(42 برگردان صحیح۶۴، "%8.5d")
    نمایش_صحیح(42 برگردان صحیح۶۴، "%08.5d")
    نمایش_صحیح(0 برگردان صحیح۶۴، "%.0d")
    نمایش_صحیح(255 برگردان صحیح۶۴، "%x")
    نمایش_صحیح(255 برگردان صحیح۶۴، "%X")
    نمایش_صحیح(255 برگردان صحیح۶۴، "%#x")
    نمایش_صحیح(255 برگردان صحیح۶۴، "%#010x")
    نمایش_صحیح(0 برگردان صحیح۶۴، "%#x")
    نمایش_صحیح(-255 برگردان صحیح۶۴، "%x")
    نمایش_صحیح(8 برگردان صحیح۶۴، "%o")
    نمایش_صحیح(8 برگردان صحیح۶۴، "%#o")
    نمایش_صحیح(0 برگردان صحیح۶۴، "%#o")
    نمایش_صحیح(5 برگردان صحیح۶۴، "%b")
    نمایش_صحیح(5 برگردان صحیح۶۴، "%#b")
    نمایش_صحیح(-5 برگردان صحیح۶۴، "%08b")
    نمایش_صحیح(9007199254740991 برگردان صحیح۶۴، "%d")
    نمایش_صحیح(-9007199254740991 برگردان صحیح۶۴، "%x")
    نمایش_صحیح(7 برگردان صحیح۶۴، "%i")
    نمایش_صحیح(7 برگردان صحیح۶۴، "%lld")

    سرچاپ "persian digits in the spec"
    نمایش(3.14159، "%.۲f")
    نمایش_صحیح(7 برگردان صحیح۶۴، "%۰۴d")

    سرچاپ "bad specs"
    نمایش(1.0، "%d")
    نمایش_صحیح(1 برگردان صحیح۶۴، "%f")
    نمایش(1.0، "%.2fx")
    نمایش_صحیح(1 برگردان صحیح۶۴، "%q")
پایان
