<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>درود سارا</title><style>.a{color:green}</style></head><body><h1>خوش آمدی، سارا</h1><p>عدد شانس: 140</p><p class="a">بزرگ</p><ul><li>0: &lt;b&gt;</li><li>1: علی &amp; رضا</li></ul><input type="checkbox" checked></body></html>
<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>درود &lt;مینا&gt;</title><style>.a{color:green}</style></head><body><h1>خوش آمدی، &lt;مینا&gt;</h1><p>عدد شانس: 40</p><p>میانه</p><ul><li>0: &lt;b&gt;</li><li>1: علی &amp; رضا</li></ul><input type="checkbox"></body></html>
<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>درود رضا</title><style>.a{color:green}</style></head><body><h1>خوش آمدی، رضا</h1><p>عدد شانس: 6</p><p>کوچک</p><ul><li>0: &lt;b&gt;</li><li>1: علی &amp; رضا</li></ul><input type="checkbox"></body></html>
