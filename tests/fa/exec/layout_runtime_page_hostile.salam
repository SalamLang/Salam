واردسازی رشته

صفحه کارت(نام: رشته، مقصد_من: رشته):
    عنوان = "Card " + نام
    پاراگراف:
        عنوان = نام
        محتوا = نام
        قلم = نام
    پایان
    دکمه منوی نوار کناری:
        نشانی = مقصد_من
        محتوا = نام
    پایان
پایان

صفحه عددها(کامل: صحیح۶۴، کسر: اعشار۶۴، پرچم: منطقی):
    دکمه منوی نوار کناری:
        نشانی = کامل
        محتوا = "whole"
    پایان
    دکمه منوی نوار کناری:
        نشانی = کسر
        محتوا = "part"
    پایان
    دکمه منوی نوار کناری:
        نشانی = پرچم
        محتوا = "flag"
    پایان
پایان

تابع ریشه():
    متن := کارت(
        "</script></style><img src=x onerror=window.pwned=1>"، " \tjava\nscript:window.pwned=2"
    )
    سرچاپ رشته.شامل است(متن، "</script></style><img")
    سرچاپ رشته.شامل است(متن، "&lt;/script&gt;&lt;/style&gt;&lt;img")
    سرچاپ رشته.شامل است(متن، "<\\/script><\\/style>")
    سرچاپ رشته.شامل است(متن، "script:window.pwned=2")
    سرچاپ رشته.شامل است(متن، "href=\"#\"")
    سرچاپ رشته.شامل است(
        کارت("x"، "https://example.com/a?b=1&c=2")، "href=\"https://example.com/a?b=1&amp;c=2\""
    )
    عددی := عددها(7000000000، 2.5، درست)
    سرچاپ رشته.شامل است(عددی، "href=\"7000000000\"")
    سرچاپ رشته.شامل است(عددی، "href=\"2.5\"")
    سرچاپ رشته.شامل است(عددی، "href=\"true\"")
پایان
