واردسازی رشته

بخش Badge(label: رشته):
    جعبه:
        فاصله = 8
        اگر صفحه.فشرده:
            فاصله = 2
        پایان
        محتوا = label
    پایان
پایان

صفحه خانه(شمار: صحیح):
    Badge:
        label = «n » + شمار
    پایان
    جعبه:
        اگر صفحه.تیره:
            رنگ = "white"
        پایان
        محتوا = "x"
    پایان
پایان

تابع ریشه():
    متن := خانه(۳)
    سرچاپ رشته.شامل است(متن، "@media (width < 600px)")
    سرچاپ رشته.شامل است(متن، "@media (prefers-color-scheme: dark)")
    سرچاپ رشته.شامل است(متن، «n 3»)
پایان
