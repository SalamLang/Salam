جداشمار رنگ:
    قرمز،
    سبز،
    آبی
پایان

تابع دسته(ک: رنگ): رشته:
    برگشت همخوان ک:
        قرمز: "گرم" پایان
        سبز, آبی: "خنک" پایان
    پایان
پایان

تابع شرح(خ: صحیح): رشته:
    مقدار := همخوان خ:
        1: برگشت 42 پایان
        2: برگشت "شاخه-رشته" پایان
        وگرنه: برگشت درست پایان
    پایان
    برگشت همخوان مقدار:
        صحیح عس: "عدد:" + عس پایان
        رشته رس: "رشته:" + رس پایان
        منطقی بس: "منطقی:" + بس پایان
    پایان
پایان

تابع ریشه:
    سرچاپ دسته(رنگ.قرمز)
    سرچاپ دسته(رنگ.سبز)
    سرچاپ دسته(رنگ.آبی)

    ی := همخوان 2:
        1: "یک" پایان
        2: "دو" پایان
        وگرنه: "بسیار" پایان
    پایان
    سرچاپ ی

    سرچاپ شرح(1)
    سرچاپ شرح(2)
    سرچاپ شرح(99)

    ناپایا ن := 0
    تا ن < 3:
        همخوان ن:
            0: سرچاپ "صفر" پایان
            وگرنه:
                اگر ن == 2:
                    بشکن
                پایان
                سرچاپ "دیگر"
            پایان
        پایان
        ن = ن + 1
    پایان
    سرچاپ "تمام شد"
پایان
