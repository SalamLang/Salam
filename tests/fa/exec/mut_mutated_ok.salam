کارکرد آغازین:
    گذرا الف := 1
    الف = 2
    چاپ الف

    گذرا ب := 5
    اگر ب > 3:
        ب = 30
    پایان
    چاپ ب

    گذرا جمع := 0
    چرخه 4 با شمارنده:
        جمع += شمارنده
    پایان
    چاپ جمع

    گذرا پ := 9
    پ++
    چاپ پ
پایان
