تابع ریشه:
    ناپایا الف := 1
    الف = 2
    سرچاپ الف

    ناپایا ب := 5
    اگر ب بزرگتر 3:
        ب = 30
    پایان
    سرچاپ ب

    ناپایا جمع := 0
    تکرار 4 در شمارنده:
        جمع += شمارنده
    پایان
    سرچاپ جمع

    ناپایا پ := 9
    پ++
    سرچاپ پ
پایان
