بسته ریشه

واردسازی حافظه

درون‌داد:
    تابع strchr(text: رشته، c: صحیح): رشته
    تابع strncmp(a: رشته، b: رشته، n: اندازه مثبت): صحیح
    تابع strtol(text: رشته، stop: تهی*، base: صحیح): صحیح
    تابع pow(x: اعشار۶۴، y: اعشار۶۴): اعشار۶۴
    تابع atan2(y: اعشار۶۴، x: اعشار۶۴): اعشار۶۴
    تابع ldexp(x: اعشار۶۴، e: صحیح): اعشار۶۴
    تابع frexp(x: اعشار۶۴، e: صحیح*): اعشار۶۴
پایان

اگر سلام سیستم ویندوز:
    درون‌داد:
        تابع _abs64(x: صحیح۶۴): صحیح۶۴
        تابع _jn(n: صحیح، x: اعشار۶۴): اعشار۶۴
        تابع _snprintf(out: تهی*، size: اندازه مثبت، format: رشته، a: اعشار۶۴، b: صحیح، c: اعشار۶۴، d: صحیح، e: اعشار۶۴): صحیح
    پایان
وگرنه:
    درون‌داد:
        تابع llabs(x: صحیح۶۴): صحیح۶۴
        تابع jn(n: صحیح، x: اعشار۶۴): اعشار۶۴
        تابع tmpfile(): تهی*
        تابع fileno(fp: تهی*): صحیح
        تابع fclose(fp: تهی*): صحیح
        تابع modf(x: اعشار۶۴، whole &: اعشار۶۴): اعشار۶۴
    پایان
پایان

اگر سلام سیستم لینوکس:
    درون‌داد:
        تابع lseek64(fd: صحیح، offset: صحیح۶۴، whence: صحیح): صحیح۶۴
    پایان
وگرنه سلام سیستم مک:
    درون‌داد:
        تابع lseek(fd: صحیح، offset: صحیح۶۴، whence: صحیح): صحیح۶۴
    پایان
پایان

اگر وارونه (سلام سیستم ویندوز و سلام معماری ایکس۸۶):
    درون‌داد:
        تابع powf(x: اعشار۳۲، y: اعشار۳۲): اعشار۳۲
        تابع atan2f(y: اعشار۳۲، x: اعشار۳۲): اعشار۳۲
    پایان
پایان

اگر سلام سیستم ویندوز:
    تابع abs_ptr(): تهی*:
        برگشت &_abs64
    پایان

    تابع bessel_ptr(): تهی*:
        برگشت &_jn
    پایان

    تابع floats_on_stack():
        buf := حافظه.تخصیص صفرشده(64 برگردان طبیعی۶۴)
        f := (&_snprintf) برگردان درون‌داد تابع (تهی*، اندازه مثبت، رشته، اعشار۶۴، صحیح، اعشار۶۴، صحیح، اعشار۶۴) صحیح
        سرچاپ f(buf، 64 برگردان اندازه مثبت، "%.1f %d %.1f %d %.1f"، 1.5، 7، 2.5، 8، 3.5)
        سرچاپ buf برگردان رشته
        حافظه.آزادسازی(buf)
    پایان

    تابع wide_in_the_middle():
        سرچاپ 5
    پایان

    تابع ref_argument():
        سرچاپ 0.5، 2
    پایان
وگرنه:
    تابع abs_ptr(): تهی*:
        برگشت &llabs
    پایان

    تابع bessel_ptr(): تهی*:
        برگشت &jn
    پایان

    تابع floats_on_stack():
        سرچاپ 15
        سرچاپ "1.5 7 2.5 8 3.5"
    پایان

    تابع wide_in_the_middle():
        fp := tmpfile()
        اگر سلام سیستم لینوکس:
            seek := (&lseek64) برگردان درون‌داد تابع (صحیح، صحیح۶۴، صحیح) صحیح۶۴
            سرچاپ seek(fileno(fp)، 5 برگردان صحیح۶۴، 0)
        وگرنه:
            seek := (&lseek) برگردان درون‌داد تابع (صحیح، صحیح۶۴، صحیح) صحیح۶۴
            سرچاپ seek(fileno(fp)، 5 برگردان صحیح۶۴، 0)
        پایان
        fclose(fp)
    پایان

    تابع ref_argument():
        ناپایا whole := 0.0
        سرچاپ modf(2.5، whole)، whole
    پایان
پایان

اگر سلام سیستم ویندوز و سلام معماری ایکس۸۶:
    تابع single_floats():
        سرچاپ 1024، 785
    پایان
وگرنه:
    تابع single_floats():
        pw := (&powf) برگردان درون‌داد تابع (اعشار۳۲، اعشار۳۲) اعشار۳۲
        at := (&atan2f) برگردان درون‌داد تابع (اعشار۳۲، اعشار۳۲) اعشار۳۲
        سرچاپ pw(2.0 برگردان اعشار۳۲، 10.0 برگردان اعشار۳۲)، ((at(1.0 برگردان اعشار۳۲، 1.0 برگردان اعشار۳۲) برگردان اعشار۶۴) * 1000.0) برگردان صحیح
    پایان
پایان

تابع ریشه:
    sc := (&strchr) برگردان درون‌داد تابع (رشته، صحیح) رشته
    سرچاپ sc("hello"، 108)
    sn := (&strncmp) برگردان درون‌داد تابع (رشته، رشته، اندازه مثبت) صحیح
    سرچاپ sn("abcd"، "abcf"، 3 برگردان اندازه مثبت)، sn("abcd"، "abcf"، 4 برگردان اندازه مثبت) کوچکتر 0
    sl := (&strtol) برگردان درون‌داد تابع (رشته، تهی*، صحیح) صحیح
    سرچاپ sl("ff"، پوچ، 16)، sl("-12"، پوچ، 10)
    wa := abs_ptr() برگردان درون‌داد تابع (صحیح۶۴) صحیح۶۴
    سرچاپ wa(0 - (123456789012 برگردان صحیح۶۴))
    pw := (&pow) برگردان درون‌داد تابع (اعشار۶۴، اعشار۶۴) اعشار۶۴
    سرچاپ pw(2.0، 10.0)
    at := (&atan2) برگردان درون‌داد تابع (اعشار۶۴، اعشار۶۴) اعشار۶۴
    سرچاپ (at(1.0، 1.0) * 1000.0) برگردان صحیح
    le := (&ldexp) برگردان درون‌داد تابع (اعشار۶۴، صحیح) اعشار۶۴
    سرچاپ le(1.5، 4)
    fe := (&frexp) برگردان درون‌داد تابع (اعشار۶۴، صحیح*) اعشار۶۴
    ex := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح*
    سرچاپ fe(12.0، ex)، ex[0]
    حافظه.آزادسازی(ex برگردان تهی*)
    bj := bessel_ptr() برگردان درون‌داد تابع (صحیح، اعشار۶۴) اعشار۶۴
    سرچاپ (bj(2، 1.5) * 1000.0) برگردان صحیح
    single_floats()
    floats_on_stack()
    wide_in_the_middle()
    ref_argument()
پایان
