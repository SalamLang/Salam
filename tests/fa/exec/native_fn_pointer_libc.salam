بسته ریشه

واردسازی حافظه

اگر سلام سیستم لینوکس:
    درون‌داد:
        تابع abs(x: صحیح): صحیح
        تابع strlen(text: رشته): اندازه مثبت
        تابع sqrt(x: اعشار۶۴): اعشار۶۴
        تابع strtol(text: رشته، stop: تهی*، base: صحیح): صحیح
        تابع memset(out: تهی*، c: صحیح، n: اندازه مثبت): تهی*
        تابع pow(x: اعشار۶۴، y: اعشار۶۴): اعشار۶۴
        تابع ldexp(x: اعشار۶۴، e: صحیح): اعشار۶۴
        تابع powf(x: اعشار۳۲، y: اعشار۳۲): اعشار۳۲
        تابع modf(x: اعشار۶۴، whole &: اعشار۶۴): اعشار۶۴
        تابع socket(family: صحیح، kind: صحیح، proto: صحیح): صحیح
        تابع bind(fd: صحیح، addr: تهی*، addr_len: صحیح): صحیح
        تابع getsockname(fd: صحیح، addr: تهی*، addr_len: صحیح*): صحیح
        تابع sendto(fd: صحیح، data: رشته، n: اندازه مثبت، flags: صحیح، addr: تهی*، addr_len: صحیح): صحیح
        تابع recvfrom(fd: صحیح، out: تهی*، n: اندازه مثبت، flags: صحیح، addr: تهی*، addr_len: تهی*): صحیح
        تابع close(fd: صحیح): صحیح
    پایان

    تابع one_argument():
        ab := (&abs) برگردان درون‌داد تابع (صحیح) صحیح
        سرچاپ ab(0 - 7)
        sl := (&strlen) برگردان درون‌داد تابع (رشته) اندازه مثبت
        سرچاپ sl("hello")
        sq := (&sqrt) برگردان درون‌داد تابع (اعشار۶۴) اعشار۶۴
        سرچاپ sq(16.0)
    پایان

    تابع three_arguments():
        st := (&strtol) برگردان درون‌داد تابع (رشته، تهی*، صحیح) صحیح
        سرچاپ st("ff"، پوچ، 16)
        ms := (&memset) برگردان درون‌داد تابع (تهی*، صحیح، اندازه مثبت) تهی*
        buf := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
        ms(buf، 65، 3 برگردان اندازه مثبت)
        سرچاپ buf برگردان رشته
        حافظه.آزادسازی(buf)
    پایان

    تابع float_arguments():
        pw := (&pow) برگردان درون‌داد تابع (اعشار۶۴، اعشار۶۴) اعشار۶۴
        سرچاپ pw(2.0، 10.0)
        le := (&ldexp) برگردان درون‌داد تابع (اعشار۶۴، صحیح) اعشار۶۴
        سرچاپ le(1.5، 4)
        pf := (&powf) برگردان درون‌داد تابع (اعشار۳۲، اعشار۳۲) اعشار۳۲
        سرچاپ pf(2.0 برگردان اعشار۳۲، 10.0 برگردان اعشار۳۲)
    پایان

    تابع loopback_address(): تهی*:
        addr := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
        bytes := addr برگردان طبیعی۸*
        bytes[0] = 2 برگردان طبیعی۸
        bytes[4] = 127 برگردان طبیعی۸
        bytes[7] = 1 برگردان طبیعی۸
        برگشت addr
    پایان

    تابع six_arguments():
        fd := socket(2، 2، 0)
        addr := loopback_address()
        addr_len := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح*
        addr_len[0] = 16
        اگر fd کوچکتر 0 یا bind(fd، addr، 16) نابرابر 0 یا getsockname(fd، addr، addr_len) نابرابر 0:
            سرچاپ 5
            سرچاپ 5، "hello"
        وگرنه:
            so := (&sendto) برگردان درون‌داد تابع (صحیح، رشته، اندازه مثبت، صحیح، تهی*، صحیح) صحیح
            سرچاپ so(fd، "hello"، 5 برگردان اندازه مثبت، 0، addr، 16)
            rf := (&recvfrom) برگردان درون‌داد تابع (صحیح، تهی*، اندازه مثبت، صحیح، تهی*، تهی*) صحیح
            out := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
            سرچاپ rf(fd، out، 15 برگردان اندازه مثبت، 0، پوچ، پوچ)، out برگردان رشته
            حافظه.آزادسازی(out)
        پایان
        اگر fd بزرگتربرابر 0:
            close(fd)
        پایان
        حافظه.آزادسازی(addr_len برگردان تهی*)
        حافظه.آزادسازی(addr)
    پایان

    تابع by_reference():
        ناپایا whole := 0.0
        سرچاپ modf(2.5، whole)، whole
    پایان
وگرنه:
    تابع one_argument():
        سرچاپ 7
        سرچاپ 5
        سرچاپ 4
    پایان

    تابع three_arguments():
        سرچاپ 255
        سرچاپ "AAA"
    پایان

    تابع float_arguments():
        سرچاپ 1024
        سرچاپ 24
        سرچاپ 1024
    پایان

    تابع six_arguments():
        سرچاپ 5
        سرچاپ 5، "hello"
    پایان

    تابع by_reference():
        سرچاپ 0.5، 2
    پایان
پایان

تابع ریشه:
    one_argument()
    three_arguments()
    float_arguments()
    six_arguments()
    by_reference()
پایان
