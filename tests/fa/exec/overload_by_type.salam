ساختار جعبه:
    مقدار: رشته = «جعبه»

    همگانی تابع متن(): رشته:
        برگشت این.مقدار
    پایان
پایان

تابع نمایش(ع: صحیح): رشته:
    برگشت «عدد » + ع
پایان

تابع نمایش(ج: جعبه): رشته:
    برگشت «جعبه » + ج.متن()
پایان

تابع نمایش(ر: رشته): رشته:
    برگشت «رشته » + ر
پایان

تابع ریشه():
    سرچاپ نمایش(۳)
    سرچاپ نمایش(جعبه {})
    سرچاپ نمایش(«x»)
پایان
