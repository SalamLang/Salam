واردسازی کدگذاری.جیسون

فراخوانی پ "../general/_pkg_enum_lib.salam"

ساختار سند:
    همگانی ل: پ.لحن = پ.لحن.نرم
پایان

تابع ریشه:
    ناپایا س := سند {}
    تلاش:
        جیسون.واسریال سازی(`{"ل":"بلند"}`، س)
    گرفتن خطا خ:
        سرچاپ "خطا"، خ.پیام
    پایان
    سرچاپ س.ل برگردان صحیح
    سرچاپ جیسون.سریال سازی(س)
پایان
