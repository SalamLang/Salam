// زبان: فارسی
تابع اصلی:
    الف := 20
    ب := 6
    ج := 4

    چاپ الف - ب - ج
    چاپ الف - (ب - ج)
    چاپ الف - ب / ج
    چاپ الف - ب % ج
تمام
