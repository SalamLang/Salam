تابع ریشه:
    الف := 20
    ب := 6
    ج := 4

    سرچاپ الف / ب * ج
    سرچاپ الف / (ب * ج)
    سرچاپ الف % ب * ج
    سرچاپ الف % (ب * ج)
پایان
