// زبان: فارسی
تابع اصلی:
    الف := 2
    ب := 3
    ج := 4
    د := 5

    چاپ الف < ب && ج < د || الف > د
    چاپ الف < ب && (ج < د || الف > د)
    چاپ الف == ب || ج != د && الف < ب
تمام
