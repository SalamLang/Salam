// زبان: فارسی
تابع اصلی:
    الف := 2
    ب := 3
    ج := 4
    د := 5

    متغیر ر := نادرست
    ر = الف < ب || ج > د
    چاپ ر

    متغیر س := 0
    س = الف + ب * ج
    چاپ س
تمام
