روال ریشه:
    ب := 3
    ج := 4

    ناپایا ه := 5
    ه += ب * ج
    سرچاپ ه

    ناپایا ز := 2
    ز *= ب + ج
    سرچاپ ز

    ناپایا ح := 100
    ح -= ب * ج
    سرچاپ ح

    ناپایا خ := 100
    خ /= ب - 1
    سرچاپ خ

    ناپایا م := 10
    م %= ب + 1
    سرچاپ م

    ناپایا ن := 2.0
    ن ^^= ب - 1
    سرچاپ ن
پایان
