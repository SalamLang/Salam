کارکرد آغازین:
    ب := 3
    ج := 4

    گذرا ه := 5
    ه += ب * ج
    چاپ ه

    گذرا ز := 2
    ز *= ب + ج
    چاپ ز

    گذرا ح := 100
    ح -= ب * ج
    چاپ ح

    گذرا خ := 100
    خ /= ب - 1
    چاپ خ

    گذرا م := 10
    م %= ب + 1
    چاپ م

    گذرا ن := 2.0
    ن ^^= ب - 1
    چاپ ن
پایان
