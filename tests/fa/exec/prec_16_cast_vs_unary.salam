// زبان: فارسی
تابع اصلی:
    الف := 2

    چاپ 0 - الف بعنوان اعشار64
    چاپ (0 - الف) بعنوان اعشار64
    چاپ -الف بعنوان اعشار64
    چاپ (-الف) بعنوان اعشار64
تمام
