// زبان: فارسی
تابع اصلی:
    متغیر ن := 3
    چاپ -ن++
    چاپ ن

    متغیر م := 3
    چاپ -(--م)
    چاپ م

    ح := 2
    متغیر ک := 3
    چاپ ح ** ک++
    چاپ ک
تمام
