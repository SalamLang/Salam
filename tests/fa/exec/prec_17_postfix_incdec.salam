روال ریشه:
    ناپایا ن := 3
    سرچاپ -ن++
    سرچاپ ن

    ناپایا م := 3
    سرچاپ -(--م)
    سرچاپ م

    ح := 2
    ناپایا ک := 3
    سرچاپ ح ^^ ک++
    سرچاپ ک
پایان
