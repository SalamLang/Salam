کارکرد آغازین:
    گذرا ن := 3
    چاپ -ن++
    چاپ ن

    گذرا م := 3
    چاپ -(--م)
    چاپ م

    ح := 2
    گذرا ک := 3
    چاپ ح ^^ ک++
    چاپ ک
پایان
