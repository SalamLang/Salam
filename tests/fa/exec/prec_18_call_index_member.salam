ساختار جعبه:
    همگانی پهنا: صحیح
    همگانی بلندی: صحیح
پایان

روال دوبرابر(مقدار: صحیح): صحیح:
    برگشت مقدار * 2
پایان

روال ریشه:
    الف := 3
    ب := 4

    یک := جعبه { پهنا = 5, بلندی = 6 }
    سرچاپ یک.پهنا + یک.بلندی * 2
    سرچاپ دوبرابر(الف) + ب
    سرچاپ دوبرابر(الف + ب)

    اعداد := [10, 20, 30]
    سرچاپ اعداد[1] + اعداد[0] * 2
    سرچاپ -اعداد[0]
پایان
