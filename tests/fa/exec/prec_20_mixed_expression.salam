// زبان: فارسی
تابع اصلی:
    الف := 2
    ب := 3
    ج := 4
    د := 5

    چاپ الف + ب * ج ** 2 - د / 2 < 50 && !نادرست || الف == د
    چاپ الف + ب * ج ** 2 - د / 2
تمام
