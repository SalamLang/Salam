// زبان: فارسی
تابع اصلی:
    چاپ 1 | 2 & 3
    چاپ (1 | 2) & 3
    چاپ 12 ^ 10 & 6
    چاپ (12 ^ 10) & 6
    چاپ 1 << 4 + 1
    چاپ (1 << 4) + 1
    چاپ 96 >> 2 * 2
    چاپ (96 >> 2) * 2
    چاپ 1 << 2 | 1
    چاپ 3 & 1 << 2
    چاپ ~3 & 15
    چاپ ~(3 & 15)
    چاپ 1 << 3 > 4
    چاپ 16 >> 2 == 4
    چاپ ((5 & 4) != 0) && ((5 & 1) != 0)
تمام
