// زبان: فارسی
تابع نخست(ب: وکتور<صحیح>، پ: صحیح): صحیح:
    اگر ب.طول() برابر 0:
        برگشت پ
    پایان
    برگشت ب.بگیر(0)
پایان

تابع متفاوت(ب: وکتور<صحیح>، ک: صحیح): منطقی:
    برگشت ب.طول() برابر 0 یا ب.بگیر(ب.طول() - 1) نابرابر ک
پایان

تابع هردو(ب: وکتور<صحیح>): منطقی:
    برگشت ب.طول() بزرگتر 2 و ب.بگیر(2) برابر 7
پایان

تابع ریشه:
    ناپایا س := وکتور {} برگردان وکتور<صحیح>
    هر ک در [3، 3، 4، 4، 5]:
        اگر س.طول() برابر 0 یا س[0] نابرابر ک:
            س.بیفزا(ک)
        پایان
        اگر متفاوت(س، ک):
            س.بیفزا(ک)
        پایان
    پایان
    سرچاپ س.طول()، نخست(س، 9)، هردو(س)
    ناپایا تهی := وکتور {} برگردان وکتور<صحیح>
    سرچاپ نخست(تهی، 9)، متفاوت(تهی، 1)
    ناپایا ق := وکتور {} برگردان وکتور<صحیح>
    ق.بیفزا(1)
    ق.بیفزا(2)
    ناپایا ی := 0
    تا ی کوچکتر ق.طول():
        سرچاپ ق.بگیر(ی)
        ی++
    پایان
    س.آزاد()
    تهی.آزاد()
    ق.آزاد()
پایان
