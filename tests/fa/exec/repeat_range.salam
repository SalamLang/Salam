// زبان: فارسی
تابع اصلی:
    متغیر شمارنده := 0
    تکرار 1 تا 100 گام 10:
        شمارنده = شمارنده + 1
    تمام
    چاپ شمارنده

    متغیر ن := 0
    تکرار 1 تا 1000:
        ن = ن + 1
        اگر ن == 3:
            بشکن
        تمام
    تمام
    چاپ ن
تمام
