کارکرد آغازین:
    گذرا شمارنده := 0
    چرخه 1 تا 100 گام 10:
        شمارنده = شمارنده + 1
    پایان
    چاپ شمارنده

    گذرا ن := 0
    چرخه 1 تا 1000:
        ن = ن + 1
        اگر ن == 3:
            بشکن
        پایان
    پایان
    چاپ ن
پایان
