تابع ریشه:
    ناپایا شمارنده := 0
    تکرار 1 تا 100 هر 10:
        شمارنده++
    پایان
    سرچاپ شمارنده

    ناپایا ن := 0
    تکرار 1 تا 1000:
        ن++
        اگر ن == 3:
            بشکن
        پایان
    پایان
    سرچاپ ن
پایان
