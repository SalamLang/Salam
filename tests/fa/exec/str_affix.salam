تابع ریشه:
    س := "سلام دنیا"
    سرچاپ س.شروع با("سلام")
    سرچاپ س.شروع با("دنیا")
    سرچاپ س.ختم با("دنیا")
    سرچاپ س.دربردارد("م د")
    سرچاپ س.دربردارد("x")
پایان
