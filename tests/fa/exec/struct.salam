ساختار جعبه:
    مقدار: صحیح = 0
    همگانی تابع دوبرابر(): صحیح:
        برگشت این.مقدار * 2
    پایان
پایان

تابع ریشه:
    ج := جعبه { مقدار = 21 }
    سرچاپ ج.دوبرابر()
پایان
