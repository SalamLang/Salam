// زبان: فارسی
ساختار جعبه:
    مقدار: صحیح = 0
    عمومی تابع دوبرابر(): صحیح:
        بازگشت این.مقدار * 2
    تمام
تمام

تابع اصلی:
    ج := جعبه { مقدار = 21 }
    چاپ ج.دوبرابر()
تمام
