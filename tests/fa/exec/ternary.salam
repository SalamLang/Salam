روال دسته(ن: صحیح): رشته:
    برگشت ن < 0 ? "منفی" : ن == 0 ? "صفر" : "مثبت"
پایان

روال ریشه:
    ط := 7
    سرچاپ ط > 5 ؟ "بزرگ" : "کوچک"
    سرچاپ دسته(-4), دسته(0), دسته(9)
    سرچاپ درست ? نادرست ? 1 : 2 : 3
    ناپایا مجموع := 0
    تکرار 6 از شمارنده:
        مجموع += شمارنده % 2 == 0 ؟ شمارنده : 0
    پایان
    سرچاپ مجموع
پایان
