بسته ریشه

تابع depth(n: صحیح): صحیح:
    اگر n برابر 0:
        برگشت 0
    پایان
    برگشت 1 + depth(n - 1)
پایان

تابع work(_arg: تهی*):
    سرچاپ depth(150)
پایان

تابع ریشه:
    t := نخ‌ساز(work، پوچ)
    نخ‌پیوند(t)
    سرچاپ "done"
پایان
