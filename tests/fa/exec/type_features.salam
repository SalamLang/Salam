ساختار کیسه:
    همگانی چیزها: وکتور<صحیح> = وکتور {}
    همگانی تابع طول(): صحیح: برگشت این.چیزها.طول() پایان
    همگانی تابع بگیر(ش: صحیح): صحیح: برگشت این.چیزها.بگیر(ش) پایان
پایان

ساختار پیمایشگر:
    همگانی اکنون: صحیح = ۰
    همگانی پایانه: صحیح = ۰
    همگانی تابع داردبعدی(): منطقی: برگشت این.اکنون < این.پایانه پایان
    همگانی تابع مقدار(): صحیح: برگشت این.اکنون پایان
    همگانی تابع بعدی(): این.اکنون = این.اکنون + ۱ پایان
پایان

ساختار بازه:
    همگانی کم: صحیح = ۰
    همگانی زیاد: صحیح = ۰
    همگانی تابع پیمایش(): پیمایشگر: برگشت پیمایشگر { اکنون = این.کم، پایانه = این.زیاد } پایان
پایان

میانجی شکل:
    تابع مساحت(): اعشار۶۴
پایان

میانجی نامدار:
    تابع نام(): رشته
پایان

میانجی جسم:
    شامل شکل
    شامل نامدار
    تابع حجم(): اعشار۶۴
پایان

ساختار مکعب:
    همگانی ض: اعشار۶۴ = ۱.۰
    همگانی تابع مساحت(): اعشار۶۴: برگشت ۶.۰ * این.ض * این.ض پایان
    همگانی تابع نام(): رشته: برگشت "مکعب" پایان
    همگانی تابع حجم(): اعشار۶۴: برگشت این.ض * این.ض * این.ض پایان
    همگانی ایستا تابع از(ن: اعشار۶۴): خود: برگشت خود { ض = ن } پایان
پایان

کاربست جسم بر مکعب:
پایان

تابع نمایش<ت: شکل + نامدار>(چیز: ت):
    سرچاپ چیز.نام()، چیز.مساحت()
پایان

تابع بکش(چیز: پویا جسم):
    سرچاپ "پویا"، چیز.نام()، چیز.حجم()
پایان

تابع ریشه:
    ناپایا ک := کیسه {}
    ک.چیزها.بیفزا(۷)
    ک.چیزها.بیفزا(۹)
    هر ایکس در ک:
        سرچاپ "کیسه"، ایکس
    پایان
    ب := بازه { کم = ۲، زیاد = ۵ }
    هر گام در ب:
        سرچاپ "بازه"، گام
    پایان
    م := مکعب.از(۲.۰)
    نمایش(م)
    بکش(م برگردان پویا جسم)
پایان
