// زبان: فارسی
تابع اصلی:
    الف := u"A"
    یورو := u"€"
    چینی := u"中"
    ایموجی := u"😀"
    شکلک := u"\U0001F600"
    چاپ الف
    چاپ یورو
    چاپ چینی
    چاپ ایموجی
    چاپ شکلک
    چاپ "حرف: " + چینی
    چاپ الف + یورو
    متن := u"ص"
    چاپ متن
تمام
