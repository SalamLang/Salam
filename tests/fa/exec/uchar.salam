روال ریشه:
    الف := u"A"
    یورو := u"€"
    چینی := u"中"
    ایموجی := u"😀"
    شکلک := u"\U0001F600"
    سرچاپ الف
    سرچاپ یورو
    سرچاپ چینی
    سرچاپ ایموجی
    سرچاپ شکلک
    سرچاپ "حرف: " + چینی
    سرچاپ الف + یورو
    متن := u"ص"
    سرچاپ متن
پایان
