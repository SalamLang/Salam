ساختار جعبه:
    همگانی برچسب: رشته
    همگانی مقدار: گوناگون<صحیح, رشته, منطقی>
پایان

روال شرح(م: گوناگون<صحیح, رشته, منطقی>): رشته:
    برگشت همخوان م:
        صحیح ن => "عدد:" + ن
        رشته س => "رشته:" + س
        منطقی ب => "منطقی:" + ب
    پایان
پایان

روال ریشه:
    ناپایا خ := 42 برگردان گوناگون<صحیح, رشته, منطقی>
    سرچاپ شرح(خ)
    خ = "سلام"
    سرچاپ شرح(خ)
    خ = درست
    سرچاپ شرح(خ)

    ج := جعبه { برچسب = "الف", مقدار = 7 }
    سرچاپ ج.برچسب + ":" + شرح(ج.مقدار)
پایان
