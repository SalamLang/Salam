بسته لامبدا

واردسازی حافظه

همگانی ساختار جعبه<T>:
    همگانی مقدار: T

    همگانی تابع ساختن(): تابع () T*:
        داده := این.مقدار
        برگشت ():
            ب := حافظه.تخصیص(اندازه‌گونه(T)) برگردان T*
            ب[0] = داده
            برگشت ب
        پایان
    پایان
پایان

همگانی تابع نگه داشتن<T>(مقدار: T): تابع () T*:
    برگشت ():
        ب := حافظه.تخصیص(اندازه‌گونه(T)) برگردان T*
        ب[0] = مقدار
        برگشت ب
    پایان
پایان

همگانی تابع دوبار<T>(مقدار: T): صحیح:
    ت := ():
        ب := حافظه.تخصیص(اندازه‌گونه(T)) برگردان T*
        ب[0] = مقدار
        حافظه.آزادسازی(ب برگردان تهی*)
        برگشت 2
    پایان
    برگشت ت()
پایان
