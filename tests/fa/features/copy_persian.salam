ساختار کیسه:
    همگانی نام: رشته = ""
    همگانی اعداد: وکتور<صحیح> = وکتور {}
پایان

تابع ریشه:
    ناپایا ا := وکتور {} برگردان وکتور<صحیح>
    تکرار ۵ در i:
        ا.بیفزا(i * ۱۰)
    پایان
    ب := ا.رونوشت()
    ا.بنشان(۰، ۹۹)
    سرچاپ ب.بگیر(۰)، ب.طول()
    پ := ا.رونوشت(۱، ۲)
    سرچاپ پ.طول()، پ.بگیر(۱)
    ت := ا.رونوشت(-۱، ۵، -۲)
    سرچاپ ت.طول()، ت.بگیر(۲)
    ناپایا ک := کیسه {}
    ک.نام = "جعبه"
    ک.اعداد.بیفزا(۷)
    ک۲ := ک.رونوشت عمیق()
    ک.اعداد.بنشان(۰، ۸)
    سرچاپ ک۲.نام، ک۲.اعداد.بگیر(۰)
    ناپایا م := نگاشت {} برگردان نگاشت<رشته، صحیح>
    م.درج("الف"، ۱)
    م۲ := م.رونوشت()
    م.درج("الف"، ۲)
    سرچاپ م۲.بگیر("الف")
    سرچاپ "سلام دنیا".رونوشت(۰، ۸)
پایان
