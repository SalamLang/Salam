// زبان: فارسی
تابع ساخت شمارنده(): تابع () صحیح:
    متغیر ن := 0
    بازگشت ():
        ن = ن + 1
        بازگشت ن
    تمام
تمام

تابع اصلی:
    بعدی := ساخت شمارنده()
    چاپ بعدی(), بعدی(), بعدی(), بعدی()
تمام
