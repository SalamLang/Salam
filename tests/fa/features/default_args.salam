پایدار سلام := "سلام"

ساختار پیکربندی:
    همگانی میزبان: رشته = "localhost"
    همگانی درگاه: صحیح = 8080
    همگانی امن: منطقی = نادرست
پایان

کارکرد درود(نام: رشته, پیشوند: رشته = سلام, بار: صحیح = 1):
    چرخه بار:
        چاپ پیشوند, نام
    پایان
پایان

کارکرد توضیح(پ: پیکربندی):
    چاپ پ.میزبان, پ.درگاه, پ.امن
پایان

کارکرد آغازین:
    درود("سارا")
    درود("علی", "های")
    درود("مکس", "هی", 3)

    توضیح(پیکربندی {})
    توضیح(پیکربندی { درگاه = 9090 })
    توضیح(پیکربندی { میزبان = "example.com", امن = درست })
پایان
