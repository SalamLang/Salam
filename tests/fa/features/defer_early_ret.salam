// زبان: فارسی
تابع کار():
    تعلیق چاپ "۳. منبع آزاد شد"
    چاپ "۱. شروع کار"
    چاپ "۲. انجام کار"
تمام

تابع اصلی:
    کار()
    چاپ "۴. پایان برنامه"
تمام
