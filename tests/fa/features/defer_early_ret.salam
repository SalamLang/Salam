کارکرد کار():
    دیرکرد چاپ "۳. منبع آزاد شد"
    چاپ "۱. شروع کار"
    چاپ "۲. انجام کار"
پایان

کارکرد آغازین:
    کار()
    چاپ "۴. پایان برنامه"
پایان
