روال کار():
    دیرکن سرچاپ "۳. منبع آزاد شد"
    سرچاپ "۱. شروع کار"
    سرچاپ "۲. انجام کار"
پایان

روال ریشه:
    کار()
    سرچاپ "۴. پایان برنامه"
پایان
