میانجی شمارنده:
    تابع افزایش(): صحیح
    تابع جمع(): صحیح
پایان

ساختار شمار:
    همگانی ن: صحیح = ۰

    همگانی تابع افزایش(): صحیح:
        این.ن += ۱
        برگشت این.ن
    پایان

    همگانی تابع جمع(): صحیح:
        برگشت این.ن
    پایان
پایان

ساختار خدمت:
    همگانی نام: رشته = ""
    همگانی شمار: پویا شمارنده = شمار {}
پایان

تابع ریشه:
    ناپایا الف := خدمت { نام = "الف" }
    الف.شمار.افزایش()
    ب := الف.رونوشت عمیق()
    الف.شمار.افزایش()
    سرچاپ الف.شمار.جمع()، ب.شمار.جمع()
پایان
