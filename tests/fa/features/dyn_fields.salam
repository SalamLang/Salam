میانجی شکل:
    تابع مساحت(): صحیح
پایان

ساختار مربع:
    همگانی ضلع: صحیح = ۱
    همگانی تابع مساحت(): صحیح: برگشت این.ضلع * این.ضلع پایان
پایان

ساختار مستطیل:
    همگانی عرض: صحیح = ۱
    همگانی طول: صحیح = ۱
    همگانی تابع مساحت(): صحیح: برگشت این.عرض * این.طول پایان
پایان

ساختار جایگاه:
    همگانی نام: رشته = ""
    همگانی شکل: پویا شکل = مربع { ضلع = ۲ }
پایان

تابع ریشه:
    الف := جایگاه { نام = "الف" }
    ب := جایگاه { نام = "ب"، شکل = مستطیل { عرض = ۲، طول = ۵ } }
    ناپایا ج := جایگاه { نام = "ج" }
    ج.شکل = مربع { ضلع = ۳ }
    سرچاپ الف.شکل.مساحت()، ب.شکل.مساحت()، ج.شکل.مساحت()
    ج.شکل.آزادکن()
پایان
