ساختار رهرو:
    همگانی تابع جمع(گ: گامها): صحیح:
        ناپایا مجموع := ۰
        هر گام در گ:
            مجموع = مجموع + گام
        پایان
        برگشت مجموع
    پایان
    همگانی تابع نخست(س: سه): صحیح:
        هر ش، ایکس در س:
            اگر ش برابر ۰:
                برگشت ایکس
            پایان
        پایان
        برگشت ۰
    پایان
پایان

ساختار پیما:
    همگانی اکنون: صحیح = ۰
    همگانی پایانه: صحیح = ۰
    همگانی تابع داردبعدی:
        برگشت این.اکنون کوچکتر این.پایانه
    پایان
    همگانی تابع مقدار:
        برگشت این.اکنون * ۲
    پایان
    همگانی تابع بعدی():
        این.اکنون = این.اکنون + ۱
    پایان
پایان

ساختار گامها:
    همگانی زیاد: صحیح = ۰
    همگانی تابع پیمایش:
        برگشت پیما { پایانه = این.زیاد }
    پایان
پایان

ساختار سه:
    همگانی تابع طول:
        برگشت ۳
    پایان
    همگانی تابع بگیر(ش: صحیح):
        برگشت ش + ۱۰
    پایان
پایان

تابع ریشه:
    ر := رهرو {}
    سرچاپ "جمع"، ر.جمع(گامها { زیاد = ۴ })
    سرچاپ "نخست"، ر.نخست(سه {})
    گ := گامها { زیاد = ۳ }
    هر گام در گ:
        سرچاپ "گام"، گام
    پایان
پایان
