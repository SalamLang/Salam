ساختار کیسه:
    همگانی چیزها: وکتور<صحیح> = وکتور {}
    همگانی تابع طول(): صحیح: برگشت این.چیزها.طول() پایان
    همگانی تابع بگیر(ش: صحیح): صحیح: برگشت این.چیزها.بگیر(ش) پایان
پایان

ساختار پیمایشگر:
    همگانی اکنون: صحیح = ۰
    همگانی پایانه: صحیح = ۰
    همگانی تابع داردبعدی(): منطقی: برگشت این.اکنون < این.پایانه پایان
    همگانی تابع مقدار(): صحیح: برگشت این.اکنون پایان
    همگانی تابع بعدی(): این.اکنون = این.اکنون + ۱ پایان
پایان

ساختار بازه:
    همگانی کم: صحیح = ۰
    همگانی زیاد: صحیح = ۰
    همگانی تابع پیمایش(): پیمایشگر:
        برگشت پیمایشگر { اکنون = این.کم، پایانه = این.زیاد }
    پایان
پایان

تابع ریشه:
    ناپایا ک := کیسه {}
    ک.چیزها.بیفزا(۷)
    ک.چیزها.بیفزا(۹)
    هر ایکس در ک:
        سرچاپ "کیسه"، ایکس
    پایان
    هر ش، ایکس در ک:
        سرچاپ "نمایه"، ش، ایکس
    پایان

    ب := بازه { کم = ۲، زیاد = ۵ }
    هر گام در ب:
        سرچاپ "بازه"، گام
    پایان
پایان
