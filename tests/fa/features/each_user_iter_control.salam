ساختار کیسه:
    همگانی چیزها: وکتور<صحیح> = وکتور {}
    همگانی تابع طول(): صحیح: برگشت این.چیزها.طول() پایان
    همگانی تابع بگیر(ش: صحیح): صحیح: برگشت این.چیزها.بگیر(ش) پایان
پایان

ساختار پیمایشگر:
    همگانی اکنون: صحیح = ۰
    همگانی پایانه: صحیح = ۰
    همگانی تابع داردبعدی(): منطقی: برگشت این.اکنون < این.پایانه پایان
    همگانی تابع مقدار(): صحیح: برگشت این.اکنون پایان
    همگانی تابع بعدی(): این.اکنون = این.اکنون + ۱ پایان
پایان

ساختار بازه:
    همگانی زیاد: صحیح = ۰
    همگانی تابع پیمایش(): پیمایشگر: برگشت پیمایشگر { اکنون = ۰، پایانه = این.زیاد } پایان
پایان

تابع ریشه:
    ناپایا ک := کیسه {}
    ک.چیزها.بیفزا(۱)
    ک.چیزها.بیفزا(۲)
    ک.چیزها.بیفزا(۳)
    هر ایکس در ک:
        اگر ایکس == ۲:
            گذر
        پایان
        اگر ایکس == ۳:
            بشکن
        پایان
        سرچاپ "دنباله"، ایکس
    پایان
    ب := بازه { زیاد = ۴ }
    هر گام در ب:
        اگر گام == ۱:
            گذر
        پایان
        اگر گام == ۳:
            بشکن
        پایان
        سرچاپ "پیمایه"، گام
    پایان
    هر ایکس در ک:
        هر گام در ب:
            سرچاپ "تودرتو"، ایکس، گام
        پایان
    پایان
پایان
