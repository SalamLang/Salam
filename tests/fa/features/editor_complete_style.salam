فراخوانی "../../../editor/complete.salam"

تابع دارد(فهرست: رشته، وورد: رشته): منطقی:
    تکرار complete.Count(فهرست) در ی:
        اگر complete.Label(complete.Item(فهرست، ی)) برابر وورد:
            برگشت درست
        پایان
    پایان
    برگشت نادرست
پایان

تابع فهرستی(سرک: رشته، لانگ: رشته): رشته:
    پوس := سرک.طول()
    وس := complete.WordStart(سرک، پوس)
    برگشت complete.Build(سرک.زیررشته(وس، پوس - وس)، complete.Mode(سرک، پوس)، لانگ)
پایان

تابع ریشه:
    سرچاپ دارد(فهرستی("page:\n    box:\n        gap"، "en")، "gap")
    سرچاپ دارد(فهرستی("page:\n    box:\n        align"، "en")، "align content")
    سرچاپ دارد(فهرستی("page:\n    box:\n        align = c"، "en")، "center")
    سرچاپ دارد(فهرستی("page:\n    box:\n        align = c"، "en")، "stack")
    سرچاپ دارد(فهرستی("page:\n    box:\n        justify = "، "en")، "between")
    سرچاپ دارد(فهرستی("page:\n    box:\n        padding = 8, "، "en")، "8, 16")
    سرچاپ دارد(فهرستی("page:\n    box:\n        hover align = "، "en")، "center")
    سرچاپ دارد(فهرستی("func main:\n    gap = c"، "en")، "center")
پایان
