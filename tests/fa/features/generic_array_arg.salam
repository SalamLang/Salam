واردسازی کدگذاری.جیسون

ساختار شخص:
    همگانی نام: رشته = ""
    همگانی سن: صحیح = ۰
پایان

تابع توصیف<T>(م: T): رشته:
    برگشت جیسون.سریال سازی(م)
پایان

تابع همان<T>(م: T): T:
    برگشت م
پایان

تابع ریشه:
    اعداد := [
    ۱
    ۲
    ۳
    ۴
    ۵
    ]
    سرچاپ جیسون.سریال سازی(اعداد)
    سرچاپ جیسون.سریال سازی([«سلام»، "hi \"q\""، ""])
    سرچاپ جیسون.سریال سازی با تورفتگی([۱.۵، ۲.۰]، "  ")
    سرچاپ جیسون.سریال سازی([شخص { نام = «علی»، سن = ۳۰ }، شخص { نام = «سارا»، سن = ۲۵ }])
    سرچاپ توصیف([درست، نادرست])
    ب := همان(اعداد)
    سرچاپ ب.طول()، ب[۴]
پایان
