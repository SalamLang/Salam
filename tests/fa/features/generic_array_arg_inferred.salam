تابع یکی<T>(م: T): T: برگشت م پایان

تابع نگه‌دار<T>(م: T): T:
    برگشت م
پایان

تابع ریشه:
    سرچاپ یکی([۱، ۲])[۱]
    الف := نگه‌دار([۱۰، ۲۰، ۳۰])
    ب := نگه‌دار([۴۰، ۵۰، ۶۰])
    سرچاپ الف[۰]، الف[۲]، ب[۱]
    اعداد := [۷، ۸، ۹]
    ج := نگه‌دار(اعداد)
    سرچاپ ج.طول()، ج[۲]
پایان
