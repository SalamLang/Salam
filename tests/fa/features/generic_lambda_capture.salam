تابع دوبار<T>(م: T): T:
    برگشت م
پایان

تابع اجرا<T>(مقدار: T): T:
    ف := ():
        برگشت دوبار(مقدار)
    پایان
    برگشت ف()
پایان

تابع ریشه:
    سرچاپ اجرا(۷)
    سرچاپ اجرا("الف")
پایان
