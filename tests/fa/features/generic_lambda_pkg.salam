فراخوانی لامبدا "_genlam_pkg.salam"

تابع ریشه:
    نگه := لامبدا.نگه داشتن(7)
    الف := نگه()
    سرچاپ الف[0]
    سرچاپ لامبدا.دوبار(5)
    متن := لامبدا.نگه داشتن("هفت")
    ب := متن()
    سرچاپ ب[0]
    ج := لامبدا.جعبه { مقدار = 9 } برگردان لامبدا.جعبه<صحیح>
    سازنده := ج.ساختن()
    د := سازنده()
    سرچاپ د[0]
پایان
