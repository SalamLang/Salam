میانجی شکل:
    تابع مساحت(): اعشار۶۴
پایان

میانجی نامدار:
    تابع نام(): رشته
پایان

میانجی برچسبدار:
    تابع برچسب(): صحیح
پایان

ساختار مکعب:
    همگانی ض: اعشار۶۴ = ۱.۰
    همگانی تابع مساحت(): اعشار۶۴: برگشت ۶.۰ * این.ض * این.ض پایان
    همگانی تابع نام(): رشته: برگشت "مکعب" پایان
    همگانی تابع برچسب(): صحیح: برگشت ۷ پایان
پایان

تابع نمایش<ت: شکل + نامدار>(چیز: ت):
    سرچاپ چیز.نام()، چیز.مساحت()
پایان

تابع نمایش۳<ت: شکل + نامدار + برچسبدار>(چیز: ت):
    سرچاپ چیز.نام()، چیز.مساحت()، چیز.برچسب()
پایان

تابع ریشه:
    م := مکعب { ض = ۲.۰ }
    نمایش(م)
    نمایش۳(م)
پایان
