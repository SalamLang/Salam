// زبان: فارسی
تابع اعمال(ف: تابع (صحیح) صحیح, مقدار: صحیح): صحیح:
    بازگشت ف(مقدار)
تمام

تابع اصلی:
    دوبرابر := (ن: صحیح) => ن * 2
    مربع := (ن: صحیح) => ن * ن
    چاپ اعمال(دوبرابر, 21)
    چاپ اعمال(مربع, 9)
    چاپ دوبرابر(مربع(3))
تمام
