تابع اعمال(ف: تابع (صحیح) صحیح, مقدار: صحیح): صحیح:
    برگشت ف(مقدار)
پایان

تابع ریشه:
    دوبرابر := (ن: صحیح): برگشت ن * 2 پایان
    مربع := (ن: صحیح): برگشت ن * ن پایان
    سرچاپ اعمال(دوبرابر, 21)
    سرچاپ اعمال(مربع, 9)
    سرچاپ دوبرابر(مربع(3))
پایان
