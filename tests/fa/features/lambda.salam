روال اعمال(ف: روال (صحیح) صحیح, مقدار: صحیح): صحیح:
    برگشت ف(مقدار)
پایان

روال ریشه:
    دوبرابر := (ن: صحیح) => ن * 2
    مربع := (ن: صحیح) => ن * ن
    سرچاپ اعمال(دوبرابر, 21)
    سرچاپ اعمال(مربع, 9)
    سرچاپ دوبرابر(مربع(3))
پایان
