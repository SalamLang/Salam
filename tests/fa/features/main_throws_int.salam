تابع نصف(ن: صحیح): صحیح پرتاب خطا:
    اگر ن % ۲ نابرابر ۰:
        پرتاب خطا "عدد فرد: " + ن
    پایان
    برگشت ن / ۲
پایان

تابع ریشه(): صحیح پرتاب خطا:
    سرچاپ تلاش نصف(۱۰)
    تلاش:
        سرچاپ نصف(۷)
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
    پایان
    برگشت ۰
پایان
