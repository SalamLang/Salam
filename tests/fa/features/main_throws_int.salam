تابع نصف(ن: صحیح): صحیح خطادار:
    اگر ن % ۲ != ۰:
        پرتاب خطا "عدد فرد: " + ن
    پایان
    برگشت ن / ۲
پایان

تابع ریشه(): صحیح خطادار:
    سرچاپ تلاش نصف(۱۰)
    تلاش:
        سرچاپ نصف(۷)
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
    پایان
    برگشت ۰
پایان
