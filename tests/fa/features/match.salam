شمارش هفته:
    شنبه
    یکشنبه
    دوشنبه
    سه‌شنبه
    چهارشنبه
    پنجشنبه
    جمعه
پایان

کارکرد نوع_روز(ر: هفته): رشته:
    بازگشت برگزین ر:
        پنجشنبه, جمعه => "پایان هفته"
        وگرنه => "روز کاری"
    پایان
پایان

کارکرد نمره(امتیاز: صحیح): رشته:
    بازگشت برگزین امتیاز / 10:
        10, 9 => "الف"
        8 => "ب"
        7 => "ج"
        وگرنه => "مردود"
    پایان
پایان

کارکرد تحلیل(واژه: رشته): رشته:
    نتیجه := برگزین واژه:
        "پینگ": بازگشت 1 پایان
        "خروج": بازگشت درست پایان
        وگرنه: بازگشت واژه پایان
    پایان
    بازگشت برگزین نتیجه:
        صحیح کد => "کد " + کد
        منطقی پرچم => "پرچم " + پرچم
        رشته متن => "ناشناخته: " + متن
    پایان
پایان

کارکرد آغازین:
    چاپ نوع_روز(هفته.شنبه)
    چاپ نوع_روز(هفته.پنجشنبه)

    چاپ نمره(95)
    چاپ نمره(81)
    چاپ نمره(40)

    چاپ تحلیل("پینگ")
    چاپ تحلیل("خروج")
    چاپ تحلیل("سلام")
پایان
