جداشمار هفته:
    شنبه،
    یکشنبه،
    دوشنبه،
    سه‌شنبه،
    چهارشنبه،
    پنجشنبه،
    جمعه
پایان

روال نوع_روز(ر: هفته): رشته:
    برگشت همخوان ر:
        پنجشنبه, جمعه => "پایان هفته"
        وگرنه => "روز کاری"
    پایان
پایان

روال نمره(امتیاز: صحیح): رشته:
    برگشت همخوان امتیاز / 10:
        10, 9 => "الف"
        8 => "ب"
        7 => "ج"
        وگرنه => "مردود"
    پایان
پایان

روال تحلیل(واژه: رشته): رشته:
    نتیجه := همخوان واژه:
        "پینگ": برگشت 1 پایان
        "خروج": برگشت درست پایان
        وگرنه: برگشت واژه پایان
    پایان
    برگشت همخوان نتیجه:
        صحیح کد => "کد " + کد
        منطقی پرچم => "پرچم " + پرچم
        رشته متن => "ناشناخته: " + متن
    پایان
پایان

روال ریشه:
    سرچاپ نوع_روز(هفته.شنبه)
    سرچاپ نوع_روز(هفته.پنجشنبه)

    سرچاپ نمره(95)
    سرچاپ نمره(81)
    سرچاپ نمره(40)

    سرچاپ تحلیل("پینگ")
    سرچاپ تحلیل("خروج")
    سرچاپ تحلیل("سلام")
پایان
