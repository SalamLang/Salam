جداشمار هفته:
    شنبه،
    یکشنبه،
    دوشنبه،
    سه‌شنبه،
    چهارشنبه،
    پنجشنبه،
    جمعه
پایان

تابع نوع_روز(ر: هفته): رشته:
    برگشت همخوان ر:
        پنجشنبه, جمعه: "پایان هفته" پایان
        وگرنه: "روز کاری" پایان
    پایان
پایان

تابع نمره(امتیاز: صحیح): رشته:
    برگشت همخوان امتیاز / 10:
        10, 9: "الف" پایان
        8: "ب" پایان
        7: "ج" پایان
        وگرنه: "مردود" پایان
    پایان
پایان

تابع تحلیل(واژه: رشته): رشته:
    نتیجه := همخوان واژه:
        "پینگ": برگشت 1 پایان
        "خروج": برگشت درست پایان
        وگرنه: برگشت واژه پایان
    پایان
    برگشت همخوان نتیجه:
        صحیح کد: "کد " + کد پایان
        منطقی پرچم: "پرچم " + پرچم پایان
        رشته متن: "ناشناخته: " + متن پایان
    پایان
پایان

تابع ریشه:
    سرچاپ نوع_روز(هفته.شنبه)
    سرچاپ نوع_روز(هفته.پنجشنبه)

    سرچاپ نمره(95)
    سرچاپ نمره(81)
    سرچاپ نمره(40)

    سرچاپ تحلیل("پینگ")
    سرچاپ تحلیل("خروج")
    سرچاپ تحلیل("سلام")
پایان
