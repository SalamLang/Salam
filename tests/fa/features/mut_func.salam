ساختار شمارنده:
    عدد: صحیح = 0
    همگانی تابع مقدار(): صحیح:
        برگشت این.عدد
    پایان
    همگانی ناپایا تابع افزایش():
        این.عدد += 1
    پایان
پایان

تابع ریشه:
    ناپایا ش := شمارنده {}
    ش.افزایش()
    ش.افزایش()
    سرچاپ ش.مقدار()
پایان
