روال ریشه:
    ناپایا شمار := 0
    تکرار 3 از شاخص:
        شمار += شاخص
    پایان
    سرچاپ "جمع:", شمار

    ناپایا سطح := 1
    اگر شمار > 2:
        سطح = 2
    پایان
    سرچاپ "سطح:", سطح

    ناپایا ضربه := 9
    ضربه++
    سرچاپ "ضربه:", ضربه

    درود := "سلام"
    سرچاپ "تغییرناپذیر:", درود

    پایا سقف := 100
    سرچاپ "ثابت:", سقف
پایان
