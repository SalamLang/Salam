کارکرد آغازین:
    گذرا شمار := 0
    چرخه 3 با شاخص:
        شمار += شاخص
    پایان
    چاپ "جمع:", شمار

    گذرا سطح := 1
    اگر شمار > 2:
        سطح = 2
    پایان
    چاپ "سطح:", سطح

    گذرا ضربه := 9
    ضربه++
    چاپ "ضربه:", ضربه

    درود := "سلام"
    چاپ "تغییرناپذیر:", درود

    پایدار سقف := 100
    چاپ "ثابت:", سقف
پایان
