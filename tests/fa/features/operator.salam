ساختار بردار:
    همگانی ایکس: صحیح = 0
    همگانی وای: صحیح = 0
    همگانی روال کارور + (دیگری: بردار): بردار: برگشت بردار { ایکس = این.ایکس + دیگری.ایکس, وای = این.وای + دیگری.وای }
    پایان
    همگانی روال کارور == (دیگری: بردار): منطقی: برگشت این.ایکس == دیگری.ایکس و این.وای == دیگری.وای
    پایان
پایان

روال ریشه:
    الف := بردار { ایکس = 1, وای = 2 }
    ب := بردار { ایکس = 3, وای = 4 }
    ج := الف + ب
    سرچاپ ج.ایکس, ج.وای
    سرچاپ الف == ب
    سرچاپ ج == بردار { ایکس = 4, وای = 6 }
پایان
