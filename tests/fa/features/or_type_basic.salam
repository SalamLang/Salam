تابع شرح(ع: صحیح یا رشته یا منطقی): رشته:
    برگشت همخوان ع:
        صحیح ن: "صحیح " + ن پایان
        رشته ر: "رشته " + ر پایان
        منطقی ب: "منطقی " + (ب ? "درست" : "نادرست") پایان
    پایان
پایان

تابع ریشه:
    سرچاپ شرح(5)
    سرچاپ شرح("سلام")
    سرچاپ شرح(درست)
    سرچاپ شرح(نادرست)
پایان
