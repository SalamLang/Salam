ساختار سلول:
    همگانی م: صحیح یا رشته = 0
پایان

تابع برگزین(پ: منطقی): صحیح یا رشته:
    اگر پ:
        برگشت 7
    پایان
    برگشت "هیچ"
پایان

تابع نشان(ع: صحیح یا رشته): رشته:
    برگشت همخوان ع:
        صحیح ن: "ن=" + ن پایان
        رشته ر: "ر=" + ر پایان
    پایان
پایان

تابع ریشه:
    ناپایا س := سلول {}
    سرچاپ نشان(س.م)
    س.م = "سلام"
    سرچاپ نشان(س.م)
    س.م = 9
    سرچاپ نشان(س.م)

    سرچاپ نشان(برگزین(درست))
    سرچاپ نشان(برگزین(نادرست))

    ناپایا ع := 1 برگردان (صحیح یا رشته)
    سرچاپ نشان(ع)
    ع = "دو"
    سرچاپ نشان(ع)
پایان
