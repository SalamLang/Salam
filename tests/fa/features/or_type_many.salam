جداشمار رنگ:
    سرخ
    سبز
    کبود
پایان

تابع رسم(ع: صحیح یا اعشار64 یا رشته یا منطقی یا رنگ): رشته:
    برگشت همخوان ع:
        صحیح ن: "صحیح " + ن پایان
        اعشار64 ف: "اعشار " + ف پایان
        رشته ر: "رشته " + ر پایان
        منطقی ب: "منطقی " + (ب ? "درست" : "نادرست") پایان
        رنگ ک: "رنگ " + (ک برگردان صحیح) پایان
    پایان
پایان

تابع ریشه:
    سرچاپ رسم(1)
    سرچاپ رسم(2.5)
    سرچاپ رسم("ایکس")
    سرچاپ رسم(نادرست)
    سرچاپ رسم(رنگ.سبز)
پایان
