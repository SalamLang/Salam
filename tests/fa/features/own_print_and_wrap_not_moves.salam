ساختار Query:
    همگانی fields: وکتور<رشته> = وکتور {}
پایان

تابع count(q: Query): صحیح:
    برگشت q.fields.طول()
پایان

تابع ask(fields: وکتور<رشته>): صحیح:
    برگشت count(Query { fields = fields })
پایان

تابع ریشه:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    v.بیفزا(1)
    v.بیفزا(2)
    سرچاپ v
    سرچاپ v.طول()
    ناپایا f := وکتور {} برگردان وکتور<رشته>
    f.بیفزا("title")
    سرچاپ ask(f)
    سرچاپ ask(f)
    سرچاپ f.طول()
    v.آزادکن()
    f.آزادکن()
پایان
