واردسازی رشته

تابع label(n: صحیح): رشته:
    برگشت "n" + رشته.از عدد(n برگردان صحیح۶۴)
پایان

تابع wrap(s: رشته): رشته:
    برگشت "[" + s + "]"
پایان

تابع shout(s: رشته): رشته:
    برگشت s + "!"
پایان

تابع upto(n: صحیح): رشته:
    ناپایا out := ""
    تکرار n در i:
        out = out + label(i) + ","
    پایان
    برگشت out
پایان

تابع upto_plus(n: صحیح): رشته:
    ناپایا out := ""
    تکرار n در i:
        out += label(i)
        out += ";"
    پایان
    برگشت out
پایان

تابع fresh_start(n: صحیح): رشته:
    ناپایا out := "<" + label(0)
    تکرار n در i:
        out = out + رشته.از عدد(i برگردان صحیح۶۴)
    پایان
    برگشت out
پایان

تابع scoped(n: صحیح): صحیح:
    ناپایا out := ""
    تکرار n در i:
        out = out + label(i)
    پایان
    سرچاپ out
    برگشت رشته.طول(out)
پایان

تابع skips(n: صحیح): رشته:
    ناپایا out := ""
    تکرار n در i:
        اگر i برابر 1:
            گذر
        پایان
        اگر i برابر 4:
            بشکن
        پایان
        out = out + label(i)
    پایان
    برگشت out
پایان

تابع nested(): رشته:
    ناپایا out := ""
    تکرار 3 در i:
        تکرار 2 در j:
            out = out + رشته.از عدد(i برگردان صحیح۶۴) + رشته.از عدد(j برگردان صحیح۶۴) + " "
        پایان
    پایان
    برگشت out
پایان

تابع wrapped(n: صحیح): رشته:
    ناپایا s := "x"
    تکرار n:
        s = wrap(s)
    پایان
    برگشت s
پایان

تابع reset(): رشته:
    ناپایا out := ""
    تکرار 3 در i:
        out = out + label(i)
        اگر i برابر 1:
            out = ""
        پایان
    پایان
    برگشت out
پایان

تابع alias(): صحیح:
    ناپایا out := ""
    ناپایا saved := ""
    تکرار 3 در i:
        out = out + label(i)
        اگر i برابر 1:
            saved = out
        پایان
    پایان
    سرچاپ saved
    برگشت رشته.طول(saved) + رشته.طول(out)
پایان

تابع borrowed(s: رشته): رشته:
    ناپایا t := s
    تکرار 2:
        t = t + "+"
    پایان
    برگشت t
پایان

تابع by_ref(o &: رشته، n: صحیح):
    تکرار n در i:
        o = o + label(i)
    پایان
پایان

تابع arms(n: صحیح): رشته:
    ناپایا out := ""
    تکرار n در i:
        ترابرد i % 3:
            0:
                out = out + "a"
            پایان
            1:
                out += "b"
            پایان
            وگرنه:
                out = shout(out)
            پایان
        پایان
    پایان
    برگشت out
پایان

تابع unused_loop(n: صحیح): صحیح:
    ناپایا out := ""
    تکرار n:
        out = out + "z"
    پایان
    برگشت 0
پایان

تابع both(a: منطقی): رشته:
    ناپایا out := "start"
    اگر a:
        out = out + "-yes"
    وگرنه:
        out = out + "-no"
    پایان
    سرچاپ out
    out = out + "."
    سرچاپ رشته.طول(out)
    برگشت out
پایان

تابع chain(n: صحیح): رشته:
    اگر رشته.طول(label(n) + "x") برابر 99:
        برگشت "a"
    وگرنه رشته.طول(label(n) + "yy") برابر 4:
        برگشت "b"
    وگرنه رشته.طول(wrap(label(n))) بزرگتر 100:
        برگشت "c"
    وگرنه رشته.طول(shout(label(n) + "q")) برابر 7:
        برگشت "d"
    وگرنه:
        برگشت "e"
    پایان
پایان

تابع kept(): صحیح:
    ناپایا out := ""
    ناپایا seen := وکتور {} برگردان وکتور<رشته>
    تکرار 3:
        out = out + "k"
        seen.بیفزا(out)
    پایان
    out = out + "z"
    total := رشته.طول(out) + رشته.طول(seen.بگیر(0)) + رشته.طول(seen.بگیر(2))
    seen.آزادکن()
    برگشت total
پایان

تابع same_name(k: صحیح، n: صحیح): رشته:
    اگر k == 1:
        ناپایا out := "a["
        تکرار n در i:
            اگر i > 0: out = out + "," پایان
            out = out + "x"
        پایان
        برگشت out + "]"
    پایان
    اگر k == 2:
        ناپایا out := "b{"
        تکرار n در i:
            اگر i > 0: out = out + "," پایان
            out = out + "y"
        پایان
        برگشت out + "}"
    پایان
    برگشت "?"
پایان

تابع ریشه:
    سرچاپ upto(4)
    سرچاپ upto_plus(3)
    سرچاپ fresh_start(3)
    سرچاپ scoped(3)
    سرچاپ skips(7)
    سرچاپ nested()
    سرچاپ wrapped(3)
    سرچاپ reset()
    سرچاپ alias()
    lit := "lit"
    سرچاپ borrowed(lit)
    سرچاپ lit
    ناپایا acc := "r"
    by_ref(acc، 3)
    سرچاپ acc
    سرچاپ arms(7)
    سرچاپ unused_loop(5)
    سرچاپ both(درست)
    سرچاپ both(نادرست)
    سرچاپ upto(0)
    سرچاپ chain(0)
    سرچاپ chain(12)
    سرچاپ chain(123)
    سرچاپ chain(1234)
    سرچاپ kept()
    سرچاپ same_name(1، 3)
    سرچاپ same_name(2، 2)
    سرچاپ same_name(3، 0)
پایان
