واردسازی رشته

ناپایا شمار := 0
ناپایا نگه := ""

تابع تیک(): صحیح:
    شمار += 1
    برگشت شمار
پایان

تابع برچسب(n: صحیح): رشته:
    برگشت "n" + رشته.از عدد(n برگردان صحیح۶۴)
پایان

تابع نگاه(s: رشته): صحیح:
    برگشت رشته.طول(s)
پایان

تابع ذخیره(s: رشته): صحیح:
    نگه = s
    برگشت رشته.طول(s)
پایان

تابع جفت(a: صحیح، b: رشته): صحیح:
    برگشت a * 100 + رشته.طول(b)
پایان

تابع ترتیب(): صحیح:
    برگشت جفت(تیک()، "x" + رشته.از عدد((شمار * 1000) برگردان صحیح۶۴))
پایان

تابع تنبل(پرچم: منطقی، a: رشته): منطقی:
    برگشت پرچم و رشته.یکسان است(a + "!"، "ok!")
پایان

تابع انتخاب(پرچم: منطقی، a: رشته): صحیح:
    برگشت پرچم ? نگاه(a + "1") : نگاه(a + "22")
پایان

تابع ریشه:
    سرچاپ ترتیب()
    سرچاپ ترتیب()
    سرچاپ نگاه("ab" + برچسب(7))
    سرچاپ ذخیره("kept" + برچسب(1))
    سرچاپ نگه
    سرچاپ تنبل(نادرست، "ok")
    سرچاپ تنبل(درست، "ok")
    سرچاپ تنبل(درست، "no")
    سرچاپ انتخاب(درست، "q")
    سرچاپ انتخاب(نادرست، "q")
    اگر نگاه(برچسب(2) + برچسب(3)) برابر 4:
        سرچاپ "four"
    پایان
    سرچاپ نگه
پایان
