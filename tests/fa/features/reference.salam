کارکرد افزایش(ایکس &: صحیح):
    ایکس = ایکس + 1
پایان

کارکرد جابجایی(الف &: صحیح, ب &: صحیح):
    موقت := الف
    الف = ب
    ب = موقت
پایان

کارکرد آغازین:
    گذرا ن := 10
    افزایش(ن)
    افزایش(ن)
    چاپ "ن =", ن
    گذرا پ := 1
    گذرا ک := 2
    جابجایی(پ, ک)
    چاپ "پ =", پ, "ک =", ک
پایان
