تابع افزایش(ایکس &: صحیح):
    ایکس = ایکس + 1
پایان

تابع جابجایی(الف &: صحیح, ب &: صحیح):
    موقت := الف
    الف = ب
    ب = موقت
پایان

تابع ریشه:
    ناپایا ن := 10
    افزایش(ن)
    افزایش(ن)
    سرچاپ "ن =", ن
    ناپایا پ := 1
    ناپایا ک := 2
    جابجایی(پ, ک)
    سرچاپ "پ =", پ, "ک =", ک
پایان
