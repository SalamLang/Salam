ساختار گره:
    همگانی ارزش: صحیح = ۰
    همگانی تابع با(ن: صحیح): خود:
        برگشت خود { ارزش = ن }
    پایان
    همگانی ایستا تابع بساز(ن: صحیح): خود:
        برگشت خود { ارزش = ن * ۲ }
    پایان
پایان

تابع ریشه:
    گ := گره {}.با(۵)
    سرچاپ گ.ارزش
    سرچاپ گره.بساز(۴).ارزش
پایان
