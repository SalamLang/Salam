ساختار جانور:
    همگانی نام: رشته = ""
    همگانی روال معرفی(): رشته:
        برگشت "من " + این.نام + " هستم"
    پایان
پایان

ساختار سگ:
    همگانی شامل جانور
    همگانی نژاد: رشته = ""
    همگانی روال پارس(): رشته:
        برگشت این.نام + " پارس می‌کند"
    پایان
پایان

روال ریشه:
    س := سگ { نام = "رکس", نژاد = "شکاری" }
    سرچاپ س.معرفی()
    سرچاپ س.پارس()
    سرچاپ س.جانور.نام
پایان
