ساختار رنگ:
    همگانی سرخ: صحیح = 0
    همگانی سبز: صحیح = 0
    همگانی پایا بیشینه := 255
    همگانی ایستا تابع خاکستری(مقدار: صحیح): رنگ:
        برگشت رنگ { سرخ = مقدار, سبز = مقدار }
    پایان
    همگانی ایستا تابع سفید(): رنگ:
        برگشت رنگ.خاکستری(رنگ.بیشینه)
    پایان
    همگانی تابع جمع(): صحیح:
        برگشت این.سرخ + این.سبز
    پایان
پایان

تابع ریشه:
    الف := رنگ.خاکستری(10)
    سرچاپ الف.جمع()
    سرچاپ رنگ.سفید().سرخ
    سرچاپ رنگ.بیشینه
پایان
