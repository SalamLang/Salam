تابع ریشه:
    سن := 20
    سرچاپ سن بزرگتربرابر 18 ؟ "بزرگسال" : "خردسال"

    نمره := 74
    رتبه := نمره بزرگتربرابر 90 ؟ "الف" : نمره بزرگتربرابر 75 ؟ "ب" : نمره بزرگتربرابر 60 ؟ "ج" : "د"
    سرچاپ "رتبه:", رتبه

    ع := -8
    قدرمطلق := ع کوچکتر 0 ؟ -(ع) : ع
    سرچاپ "قدرمطلق:", قدرمطلق

    ناپایا شمار زوج := 0
    تکرار 10 در شمارنده:
        شمار زوج += شمارنده % 2 برابر 0 ؟ 1 : 0
    پایان
    سرچاپ "شمار زوج:", شمار زوج
پایان
