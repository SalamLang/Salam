روال ریشه:
    سن := 20
    سرچاپ سن >= 18 ؟ "بزرگسال" : "خردسال"

    نمره := 74
    رتبه := نمره >= 90 ؟ "الف" : نمره >= 75 ؟ "ب" : نمره >= 60 ؟ "ج" : "د"
    سرچاپ "رتبه:", رتبه

    ع := -8
    قدرمطلق := ع < 0 ؟ -(ع) : ع
    سرچاپ "قدرمطلق:", قدرمطلق

    ناپایا شمار زوج := 0
    تکرار 10 از شمارنده:
        شمار زوج += شمارنده % 2 == 0 ؟ 1 : 0
    پایان
    سرچاپ "شمار زوج:", شمار زوج
پایان
