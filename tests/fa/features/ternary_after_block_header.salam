تابع انتخاب(ن: صحیح): صحیح:
    اگر ن > 1 ? درست : نادرست:
        برگشت 1
    پایان
    برگشت 0
پایان

تابع ریشه:
    الف := 5
    اگر الف > 1:
        سرچاپ "بلوک"
    پایان
    ب := الف > 1 ? 10 : 20
    سرچاپ ب
    ج := الف > 9 ? الف > 3 ? 1 : 2 : 3
    سرچاپ ج
    سرچاپ انتخاب(5)
    سرچاپ انتخاب(0)
پایان
