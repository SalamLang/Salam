تابع ریشه:
    پرچم := درست
    _الف := پرچم ? (۱ برگردان صحیح?) : ۲ برگردان صحیح?
    سرچاپ "خوب"
    ایکس := (پرچم ?
        ۱ :
        ۲)
    سرچاپ ایکس
    ایگرگ := (پرچم ? ۳ :
        ۴)
    سرچاپ ایگرگ
پایان
