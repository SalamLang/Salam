تابع درگاه(متن: رشته): صحیح خطادار:
    اگر متن == "":
        پرتاب خطا خطا.جدید(نوع خطا.آرگومان نامعتبر، "درگاه خالی است")
    پایان
    ن := متن.به صحیح()
    اگر ن <= ۰:
        پرتاب خطا "درگاه باید مثبت باشد"
    پایان
    برگشت ن
پایان

تابع دوبرابر(متن: رشته): صحیح خطادار:
    د := تلاش درگاه(متن)
    برگشت د * ۲
پایان

تابع ذخیره(ن: صحیح) خطادار:
    دیرکن سرچاپ "پایان ذخیره " + ن
    اگر ن % ۲ == ۱:
        پرتاب خطا خطا.جدید(نوع خطا.ورودی خروجی، "ذخیره نشد")
    پایان
پایان

تابع ریشه:
    تلاش:
        سرچاپ دوبرابر("80")
        سرچاپ دوبرابر("")
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
        سرچاپ خ.است(نوع خطا.آرگومان نامعتبر)
    پایان
    جایگزین := تلاش درگاه("-1") گرفتن خطا ۸۰۸۰
    سرچاپ جایگزین
    هر ن در [2، 3، 4]:
        تلاش:
            ذخیره(ن)
            سرچاپ "ذخیره شد"، ن
        گرفتن خطا خ:
            سرچاپ خ.پیام، خ.نام نوع()
        پایان
    پایان
پایان
