تابع ریشه:
    الف := ۲ *
        ۳
    ب := ۲ **
        ۳
    ج := ۶ &
        ۳
    د := ۴ |
        ۱
    ه := ۵ ^
        ۱
    ش := ۱ <<
        ۴
    ز := ۶۴ >>
        ۲
    ناپایا ح := ۳
    ح *=
        ۴
    سرچاپ الف
    سرچاپ ب
    سرچاپ ج
    سرچاپ د
    سرچاپ ه
    سرچاپ ش
    سرچاپ ز
    سرچاپ ح
    ناپایا م := ۱۲
    م &=
        ۱۰
    م |=
        ۱
    م ^=
        ۳
    م <<=
        ۲
    م >>=
        ۱
    سرچاپ م
    ناپایا _ا: صحیح?
    سرچاپ م
پایان
