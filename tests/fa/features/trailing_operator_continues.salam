تابع ریشه:
    الف := ۲ *
        ۳
    ب := ۲ **
        ۳
    ج := ۶ &
        ۳
    د := ۴ |
        ۱
    ه := ۵ ^
        ۱
    و := ۱ <<
        ۴
    ز := ۶۴ >>
        ۲
    ناپایا ح := ۳
    ح *=
        ۴
    سرچاپ الف
    سرچاپ ب
    سرچاپ ج
    سرچاپ د
    سرچاپ ه
    سرچاپ و
    سرچاپ ز
    سرچاپ ح
پایان
