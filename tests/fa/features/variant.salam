ساختار خوانش:
    همگانی حسگر: رشته
    همگانی مقدار: صحیح یا اعشار64 یا رشته
پایان

تابع شرح(م: صحیح یا اعشار64 یا رشته): رشته:
    برگشت همخوان م:
        صحیح ن: "صحیح " + ن پایان
        اعشار64 ع: "اعشار " + ع پایان
        رشته خ: "خطا: " + خ پایان
    پایان
پایان

تابع ریشه:
    ناپایا نمونه := 21 برگردان (صحیح یا اعشار64 یا رشته)
    سرچاپ شرح(نمونه)

    نمونه = 21.5
    سرچاپ شرح(نمونه)

    نمونه = "حسگر خاموش است"
    سرچاپ شرح(نمونه)

    خوانشها := [
        خوانش { حسگر = "دما", مقدار = 21.5 }, خوانش { حسگر = "رطوبت", مقدار = 55 }, خوانش { حسگر = "فشار", مقدار = "حسگر خاموش است" }
    ]
    ناپایا ش := 0
    تا ش < 3:
        ک := خوانشها[ش]
        سرچاپ ک.حسگر + ": " + شرح(ک.مقدار)
        ش++
    پایان
پایان
