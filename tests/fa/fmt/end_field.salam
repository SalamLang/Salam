ساختار بازه:
  همگانی ابتدا: صحیح = ۰
    همگانی پایان: صحیح = ۰
  همگانی نام: رشته = ""
پایان

تابع پهنا(ب: بازه): صحیح:
    برگشت ب.پایان - ب.ابتدا
پایان

تابع ریشه:
    ناپایا ب := بازه { ابتدا = ۲، پایان = ۹، نام = "x" }
    ب.پایان++
    سرچاپ پهنا(ب)، ب.پایان، ب.نام
پایان
