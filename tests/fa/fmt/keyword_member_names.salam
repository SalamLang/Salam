واردسازی رشته

تابع ریشه:
    م := "سلام دنیا"
      سرچاپ رشته.شروع با(م، "سلام")، رشته.پایان با(م، "دنیا")
    اگر رشته.پایان با(م، "دنیا"):
        سرچاپ رشته.اندیس از (م، "دنیا"، ۰)
    پایان
    ناپایا ف := وکتور {} برگردان وکتور<صحیح>
    دیرکن ف.آزادکن()
    ف.بیفزا(۱)
    ف.بیفزا(۲)
    سرچاپ ف.حذف در  (۰)، ف
پایان
