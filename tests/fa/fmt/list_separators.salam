روال جمع(
    الف: صحیح
    ب: صحیح
): صحیح:
    برگشت الف + ب
پایان

روال ضرب(الف: صحیح، ب: صحیح): صحیح:
    برگشت الف * ب
پایان

روال ریشه:
    میوه‌ها := [
        "سیب"
        "انار"
        "انگور"
    ]
    عددها := [۱، ۲، ۳،]
    جدول := [
        [۱، ۲]
        [۳، ۴]
    ]
    قیمت کتاب := ۱۰
    تعداد := ۲
    سرچاپ میوه‌ها.طول()، عددها.طول()، جدول[۱][۰]
    سرچاپ جمع(
        قیمت کتاب
        تعداد
    )
    سرچاپ ضرب(۳، ۴)، جمع(۱، ۲،)
    سرچاپ جمع(
        ۱ +
            ۲
        ضرب(
            ۲
            ۳
        )
    )
پایان
