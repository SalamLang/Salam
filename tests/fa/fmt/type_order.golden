بسته ترتیبگونه

همگانی ساختار بوکس:
    همگانی مقدار: صحیح = 0
پایان

گونه شمار = صحیح

جداشمار حالت:
    فاست، سلوو
پایان

همگانی میانجی سیزید:
    تابع اندازه(): صحیح
پایان

کاربست سیزید بر بوکس:
    تابع اندازه(): صحیح:
        برگشت این.مقدار * 2
    پایان
پایان

تابع هیلپیر(): صحیح:
    برگشت 3
پایان

همگانی تابع اپی(): صحیح:
    برگشت هیلپیر()
پایان

تابع ریشه:
    ب := بوکس { مقدار = 21 }
    ن := ب.اندازه() برگردان شمار
    سرچاپ ن، اپی()، حالت.فاست نابرابر حالت.سلوو
پایان
