فراخوانی دام

ستون := 6
ردیف := 6
تعداد_خانه := 36
انواع_جواهر := 6

رنگ_جواهر := ["#ff6b6b", "#ffb35c", "#ffe066", "#7cf7a0", "#6ee7f5", "#c792ff"]
نماد_جواهر := ["●", "■", "▲", "◆", "★", "⬢"]

کاشی: صحیح[36]
تطبیق_شده: منطقی[36]
خانه_عنصر: صحیح۶۴[36]

گذرا هود := 0 برگردان صحیح۶۴
گذرا وضعیت_جعبه := 0 برگردان صحیح۶۴
گذرا پیام := 0 برگردان صحیح۶۴
گذرا ناحیه_بازی := 0 برگردان صحیح۶۴
گذرا پوشش := 0 برگردان صحیح۶۴
گذرا عنوان_پوشش := 0 برگردان صحیح۶۴
گذرا پیام_پوشش := 0 برگردان صحیح۶۴
گذرا دکمه_پوشش := 0 برگردان صحیح۶۴

گذرا سطح := 1
گذرا امتیاز_کل := 0
گذرا امتیاز_مرحله := 0
گذرا هدف_مرحله := 300
گذرا حرکت_باقی := 22
گذرا بهترین := 0
گذرا انتخاب_شده := -1
گذرا در_حال_پردازش := نادرست
گذرا ترکیب := 1

گذرا سواپ_الف := -1
گذرا سواپ_ب := -1
گذرا کاسکید_اولین := درست

کارکرد نمایش_هود():
    دام.تنظیم متن(هود, "سطح " + سطح + "   امتیاز_کل: " + امتیاز_کل + "   بهترین: " + بهترین)
    دام.تنظیم متن(وضعیت_جعبه, "هدف: " + امتیاز_مرحله + " / " + هدف_مرحله + "   حرکت: " + حرکت_باقی)
پایان

کارکرد رندر_خانه(ن: صحیح):
    عنصر := خانه_عنصر[ن]
    گونه := کاشی[ن]
    دام.تنظیم متن(عنصر, نماد_جواهر[گونه])
    اگر تطبیق_شده[ن]:
        دام.افزودن کلاس(عنصر, "درخشش")
        دام.تنظیم سبک(عنصر, "background", "#ffffff")
    وگرنه:
        دام.حذف کلاس(عنصر, "درخشش")
        دام.تنظیم سبک(عنصر, "background", رنگ_جواهر[گونه])
    پایان
    اگر ن == انتخاب_شده:
        دام.افزودن کلاس(عنصر, "انتخاب")
    وگرنه:
        دام.حذف کلاس(عنصر, "انتخاب")
    پایان
پایان

کارکرد رندر_تخته():
    چرخه تعداد_خانه با ن:
        رندر_خانه(ن)
    پایان
پایان

کارکرد مقدار_تصادفی_جواهر(): صحیح:
    بازگشت دام.تصادفی صحیح(انواع_جواهر) برگردان صحیح
پایان

کارکرد می_سازد_تطبیق_فوری(ن: صحیح, گونه: صحیح): منطقی:
    ستون_ن := ن % ستون
    ردیف_ن := ن / ستون
    اگر ستون_ن >= 2:
        اگر کاشی[ن - 1] == گونه && کاشی[ن - 2] == گونه: بازگشت درست پایان
    پایان
    اگر ردیف_ن >= 2:
        اگر کاشی[ن - ستون] == گونه && کاشی[ن - ستون * 2] == گونه: بازگشت درست پایان
    پایان
    بازگشت نادرست
پایان

کارکرد ساخت_تخته():
    چرخه تعداد_خانه با ن:
        گذرا گونه := مقدار_تصادفی_جواهر()
        گذرا تلاش := 0
        تاهنگام می_سازد_تطبیق_فوری(ن, گونه) && تلاش < 30:
            گونه = مقدار_تصادفی_جواهر()
            تلاش = تلاش + 1
        پایان
        کاشی[ن] = گونه
    پایان
پایان

کارکرد پاک_کردن_تطبیق_شده():
    چرخه تعداد_خانه با ن:
        تطبیق_شده[ن] = نادرست
    پایان
پایان

کارکرد پیدا_تطبیق_ها(): صحیح:
    پاک_کردن_تطبیق_شده()
    چرخه ردیف با ر:
        گذرا مقدار_جاری := کاشی[ر * ستون]
        گذرا طول_جاری := 1
        گذرا س := 1
        تاهنگام س < ستون:
            اگر کاشی[ر * ستون + س] == مقدار_جاری:
                طول_جاری = طول_جاری + 1
            وگرنه:
                اگر طول_جاری >= 3:
                    گذرا ک := س - طول_جاری
                    تاهنگام ک < س:
                        تطبیق_شده[ر * ستون + ک] = درست
                        ک = ک + 1
                    پایان
                پایان
                مقدار_جاری = کاشی[ر * ستون + س]
                طول_جاری = 1
            پایان
            س = س + 1
        پایان
        اگر طول_جاری >= 3:
            گذرا ک := ستون - طول_جاری
            تاهنگام ک < ستون:
                تطبیق_شده[ر * ستون + ک] = درست
                ک = ک + 1
            پایان
        پایان
    پایان
    چرخه ستون با س:
        گذرا مقدار_جاری := کاشی[س]
        گذرا طول_جاری := 1
        گذرا ر := 1
        تاهنگام ر < ردیف:
            اگر کاشی[ر * ستون + س] == مقدار_جاری:
                طول_جاری = طول_جاری + 1
            وگرنه:
                اگر طول_جاری >= 3:
                    گذرا ک := ر - طول_جاری
                    تاهنگام ک < ر:
                        تطبیق_شده[ک * ستون + س] = درست
                        ک = ک + 1
                    پایان
                پایان
                مقدار_جاری = کاشی[ر * ستون + س]
                طول_جاری = 1
            پایان
            ر = ر + 1
        پایان
        اگر طول_جاری >= 3:
            گذرا ک := ردیف - طول_جاری
            تاهنگام ک < ردیف:
                تطبیق_شده[ک * ستون + س] = درست
                ک = ک + 1
            پایان
        پایان
    پایان
    گذرا تعداد := 0
    چرخه تعداد_خانه با ن:
        اگر تطبیق_شده[ن]: تعداد = تعداد + 1 پایان
    پایان
    بازگشت تعداد
پایان

کارکرد سقوط_و_پرکردن():
    چرخه ستون با س:
        گذرا نوشتن := ردیف - 1
        گذرا ر := ردیف - 1
        تاهنگام ر >= 0:
            اگر !تطبیق_شده[ر * ستون + س]:
                اگر نوشتن != ر:
                    کاشی[نوشتن * ستون + س] = کاشی[ر * ستون + س]
                پایان
                نوشتن = نوشتن - 1
            پایان
            ر = ر - 1
        پایان
        تاهنگام نوشتن >= 0:
            کاشی[نوشتن * ستون + س] = مقدار_تصادفی_جواهر()
            نوشتن = نوشتن - 1
        پایان
    پایان
پایان

کارکرد انجام_سواپ():
    موقت := کاشی[سواپ_الف]
    کاشی[سواپ_الف] = کاشی[سواپ_ب]
    کاشی[سواپ_ب] = موقت
پایان

کارکرد پایان_حرکت():
    در_حال_پردازش = نادرست
    حرکت_باقی = حرکت_باقی - 1
    نمایش_هود()
    اگر امتیاز_مرحله >= هدف_مرحله:
        مرحله_کامل()
    وگرنه اگر حرکت_باقی <= 0:
        مرحله_ناموفق()
    پایان
پایان

کارکرد ادامه_فروپاشی():
    سقوط_و_پرکردن()
    پاک_کردن_تطبیق_شده()
    رندر_تخته()
    دام.تنظیم مهلت(
        (): ادامه_پردازش() پایان, 160
    )
پایان

کارکرد ادامه_پردازش():
    تعداد := پیدا_تطبیق_ها()
    اگر تعداد == 0:
        اگر کاسکید_اولین:
            انجام_سواپ()
            رندر_تخته()
            دام.صدا(160.0, 120.0)
            در_حال_پردازش = نادرست
        وگرنه:
            پایان_حرکت()
        پایان
        بازگشت
    پایان
    کاسکید_اولین = نادرست
    دلتا := تعداد * 10 * ترکیب
    امتیاز_مرحله = امتیاز_مرحله + دلتا
    امتیاز_کل = امتیاز_کل + دلتا
    اگر امتیاز_کل > بهترین:
        بهترین = امتیاز_کل
        دام.تنظیم عدد ذخیره("salam jewelmatch best", بهترین برگردان صحیح۶۴)
    پایان
    ترکیب = ترکیب + 1
    نمایش_هود()
    رندر_تخته()
    دام.صدا(500.0 + (ترکیب برگردان اعشار۶۴) * 40.0, 90.0)
    دام.تنظیم مهلت(
        (): ادامه_فروپاشی() پایان, 220
    )
پایان

کارکرد شروع_پردازش():
    در_حال_پردازش = درست
    ترکیب = 1
    کاسکید_اولین = درست
    انجام_سواپ()
    رندر_تخته()
    دام.تنظیم مهلت(
        (): ادامه_پردازش() پایان, 150
    )
پایان

کارکرد مجاور_است(الف: صحیح, ب: صحیح): منطقی:
    ستون_الف := الف % ستون
    ردیف_الف := الف / ستون
    ستون_ب := ب % ستون
    ردیف_ب := ب / ستون
    اگر ردیف_الف == ردیف_ب && (ستون_الف - ستون_ب == 1 || ستون_ب - ستون_الف == 1): بازگشت درست پایان
    اگر ستون_الف == ستون_ب && (ردیف_الف - ردیف_ب == 1 || ردیف_ب - ردیف_الف == 1): بازگشت درست پایان
    بازگشت نادرست
پایان

کارکرد کلیک_خانه(ن: صحیح):
    اگر در_حال_پردازش: بازگشت پایان
    اگر انتخاب_شده == -1:
        انتخاب_شده = ن
        رندر_خانه(ن)
        بازگشت
    پایان
    اگر ن == انتخاب_شده:
        انتخاب_شده = -1
        رندر_خانه(ن)
        بازگشت
    پایان
    اگر مجاور_است(انتخاب_شده, ن):
        قبلی := انتخاب_شده
        انتخاب_شده = -1
        رندر_خانه(قبلی)
        سواپ_الف = قبلی
        سواپ_ب = ن
        شروع_پردازش()
    وگرنه:
        قبلی := انتخاب_شده
        انتخاب_شده = ن
        رندر_خانه(قبلی)
        رندر_خانه(ن)
    پایان
پایان

کارکرد شروع_مرحله():
    امتیاز_مرحله = 0
    هدف_مرحله = 300 + (سطح - 1) * 200
    حرکت_باقی = 22 - (سطح - 1)
    اگر حرکت_باقی < 12: حرکت_باقی = 12 پایان
    انتخاب_شده = -1
    در_حال_پردازش = نادرست
    دام.تنظیم سبک(پوشش, "display", "none")
    دام.تنظیم سبک(ناحیه_بازی, "display", "block")
    ساخت_تخته()
    رندر_تخته()
    نمایش_هود()
    دام.تنظیم متن(پیام, "دو خانه مجاور را برای جابجایی انتخاب کن")
پایان

کارکرد مرحله_کامل():
    دام.تنظیم متن(عنوان_پوشش, "مرحله " + سطح + " کامل شد! 🎉")
    دام.تنظیم متن(پیام_پوشش, "امتیاز_مرحله: " + امتیاز_مرحله + " / " + هدف_مرحله)
    دام.تنظیم متن(دکمه_پوشش, "مرحله بعد")
    دام.تنظیم سبک(ناحیه_بازی, "display", "none")
    دام.تنظیم سبک(پوشش, "display", "block")
    دام.صدا(880.0, 220.0)
پایان

کارکرد مرحله_ناموفق():
    دام.تنظیم متن(عنوان_پوشش, "حرکت‌ها تمام شد!")
    دام.تنظیم متن(پیام_پوشش, "امتیاز_مرحله: " + امتیاز_مرحله + " / " + هدف_مرحله)
    دام.تنظیم متن(دکمه_پوشش, "تلاش دوباره")
    دام.تنظیم سبک(ناحیه_بازی, "display", "none")
    دام.تنظیم سبک(پوشش, "display", "block")
    دام.صدا(160.0, 260.0)
پایان

کارکرد کلیک_دکمه_پوشش():
    اگر امتیاز_مرحله >= هدف_مرحله:
        سطح = سطح + 1
    پایان
    شروع_مرحله()
پایان

کارکرد آغازین:
    هود = دام.با شناسه("hud")
    وضعیت_جعبه = دام.با شناسه("status")
    پیام = دام.با شناسه("msg")
    ناحیه_بازی = دام.با شناسه("play area")
    پوشش = دام.با شناسه("overlay")
    عنوان_پوشش = دام.با شناسه("overlay title")
    پیام_پوشش = دام.با شناسه("overlay msg")
    دکمه_پوشش = دام.با شناسه("overlay btn")
    بهترین = دام.دریافت عدد ذخیره("salam jewelmatch best") برگردان صحیح
    چرخه تعداد_خانه با ن:
        خانه_عنصر[ن] = دام.با شناسه("t" + ن)
        دام.هنگام رویداد(
            خانه_عنصر[ن], "click", (): کلیک_خانه(ن) پایان
        )
    پایان
    دام.هنگام رویداد(
        دکمه_پوشش, "click", (): کلیک_دکمه_پوشش() پایان
    )
    سطح = 1
    امتیاز_کل = 0
    شروع_مرحله()
پایان
