واردسازی دام

ستون := 6
ردیف := 6
تعداد خانه := 36
انواع جواهر := 6

رنگ جواهر := ["#ff6b6b", "#ffb35c", "#ffe066", "#7cf7a0", "#6ee7f5", "#c792ff"]
نماد جواهر := ["●", "■", "▲", "◆", "★", "⬢"]

کاشی: صحیح[36]
تطبیق شده: منطقی[36]
خانه عنصر: صحیح۶۴[36]

ناپایا هود := 0 برگردان صحیح۶۴
ناپایا وضعیت جعبه := 0 برگردان صحیح۶۴
ناپایا پیام := 0 برگردان صحیح۶۴
ناپایا ناحیه بازی := 0 برگردان صحیح۶۴
ناپایا پوشش := 0 برگردان صحیح۶۴
ناپایا عنوان پوشش := 0 برگردان صحیح۶۴
ناپایا پیام پوشش := 0 برگردان صحیح۶۴
ناپایا دکمه پوشش := 0 برگردان صحیح۶۴

ناپایا سطح := 1
ناپایا امتیاز کل := 0
ناپایا امتیاز مرحله := 0
ناپایا هدف مرحله := 300
ناپایا حرکت باقی := 22
ناپایا بهترین := 0
ناپایا انتخاب شده := -1
ناپایا پردازش جاری := نادرست
ناپایا ترکیب := 1

ناپایا سواپ الف := -1
ناپایا سواپ ب := -1
ناپایا کاسکید اولین := درست

تابع نمایش هود():
    دام.تنظیم متن(هود, "سطح " + سطح + "   امتیاز_کل: " + امتیاز کل + "   بهترین: " + بهترین)
    دام.تنظیم متن(وضعیت جعبه, "هدف: " + امتیاز مرحله + " / " + هدف مرحله + "   حرکت: " + حرکت باقی)
پایان

تابع رندر خانه(ن: صحیح):
    عنصر := خانه عنصر[ن]
    نوع := کاشی[ن]
    دام.تنظیم متن(عنصر, نماد جواهر[نوع])
    اگر تطبیق شده[ن]:
        دام.افزودن کلاس(عنصر, "درخشش")
        دام.تنظیم سبک(عنصر, "background", "#ffffff")
    وگرنه:
        دام.حذف کلاس(عنصر, "درخشش")
        دام.تنظیم سبک(عنصر, "background", رنگ جواهر[نوع])
    پایان
    اگر ن == انتخاب شده:
        دام.افزودن کلاس(عنصر, "انتخاب")
    وگرنه:
        دام.حذف کلاس(عنصر, "انتخاب")
    پایان
پایان

تابع رندر تخته():
    تکرار تعداد خانه در ن:
        رندر خانه(ن)
    پایان
پایان

تابع مقدار تصادفی جواهر(): صحیح:
    برگشت دام.تصادفی صحیح(انواع جواهر) برگردان صحیح
پایان

تابع تطبیق فوری ساخته می شود(ن: صحیح, نوع: صحیح): منطقی:
    ستون خانه := ن % ستون
    ردیف خانه := ن / ستون
    اگر ستون خانه >= 2:
        اگر کاشی[ن - 1] == نوع و کاشی[ن - 2] == نوع: برگشت درست پایان
    پایان
    اگر ردیف خانه >= 2:
        اگر کاشی[ن - ستون] == نوع و کاشی[ن - ستون * 2] == نوع: برگشت درست پایان
    پایان
    برگشت نادرست
پایان

تابع ساخت تخته():
    تکرار تعداد خانه در ن:
        ناپایا نوع := مقدار تصادفی جواهر()
        ناپایا کوشش := 0
        تا تطبیق فوری ساخته می شود(ن, نوع) و کوشش < 30:
            نوع = مقدار تصادفی جواهر()
            کوشش = کوشش + 1
        پایان
        کاشی[ن] = نوع
    پایان
پایان

تابع پاک کردن تطبیق شده():
    تکرار تعداد خانه در ن:
        تطبیق شده[ن] = نادرست
    پایان
پایان

تابع پیدا تطبیق ها(): صحیح:
    پاک کردن تطبیق شده()
    تکرار ردیف در ر:
        ناپایا مقدار جاری := کاشی[ر * ستون]
        ناپایا طول جاری := 1
        ناپایا س := 1
        تا س < ستون:
            اگر کاشی[ر * ستون + س] == مقدار جاری:
                طول جاری = طول جاری + 1
            وگرنه:
                اگر طول جاری >= 3:
                    ناپایا ک := س - طول جاری
                    تا ک < س:
                        تطبیق شده[ر * ستون + ک] = درست
                        ک = ک + 1
                    پایان
                پایان
                مقدار جاری = کاشی[ر * ستون + س]
                طول جاری = 1
            پایان
            س = س + 1
        پایان
        اگر طول جاری >= 3:
            ناپایا ک := ستون - طول جاری
            تا ک < ستون:
                تطبیق شده[ر * ستون + ک] = درست
                ک = ک + 1
            پایان
        پایان
    پایان
    تکرار ستون در س:
        ناپایا مقدار جاری := کاشی[س]
        ناپایا طول جاری := 1
        ناپایا ر := 1
        تا ر < ردیف:
            اگر کاشی[ر * ستون + س] == مقدار جاری:
                طول جاری = طول جاری + 1
            وگرنه:
                اگر طول جاری >= 3:
                    ناپایا ک := ر - طول جاری
                    تا ک < ر:
                        تطبیق شده[ک * ستون + س] = درست
                        ک = ک + 1
                    پایان
                پایان
                مقدار جاری = کاشی[ر * ستون + س]
                طول جاری = 1
            پایان
            ر = ر + 1
        پایان
        اگر طول جاری >= 3:
            ناپایا ک := ردیف - طول جاری
            تا ک < ردیف:
                تطبیق شده[ک * ستون + س] = درست
                ک = ک + 1
            پایان
        پایان
    پایان
    ناپایا تعداد := 0
    تکرار تعداد خانه در ن:
        اگر تطبیق شده[ن]: تعداد = تعداد + 1 پایان
    پایان
    برگشت تعداد
پایان

تابع سقوط همراه پرکردن():
    تکرار ستون در س:
        ناپایا نوشتن := ردیف - 1
        ناپایا ر := ردیف - 1
        تا ر >= 0:
            اگر وارونه تطبیق شده[ر * ستون + س]:
                اگر نوشتن != ر:
                    کاشی[نوشتن * ستون + س] = کاشی[ر * ستون + س]
                پایان
                نوشتن = نوشتن - 1
            پایان
            ر = ر - 1
        پایان
        تا نوشتن >= 0:
            کاشی[نوشتن * ستون + س] = مقدار تصادفی جواهر()
            نوشتن = نوشتن - 1
        پایان
    پایان
پایان

تابع انجام سواپ():
    موقت := کاشی[سواپ الف]
    کاشی[سواپ الف] = کاشی[سواپ ب]
    کاشی[سواپ ب] = موقت
پایان

تابع اتمام حرکت():
    پردازش جاری = نادرست
    حرکت باقی = حرکت باقی - 1
    نمایش هود()
    اگر امتیاز مرحله >= هدف مرحله:
        مرحله کامل()
    وگرنه اگر حرکت باقی <= 0:
        مرحله ناموفق()
    پایان
پایان

تابع ادامه فروپاشی():
    سقوط همراه پرکردن()
    پاک کردن تطبیق شده()
    رندر تخته()
    دام.تنظیم مهلت(
        (): ادامه پردازش() پایان, 160
    )
پایان

تابع ادامه پردازش():
    تعداد := پیدا تطبیق ها()
    اگر تعداد == 0:
        اگر کاسکید اولین:
            انجام سواپ()
            رندر تخته()
            دام.صدا(160.0, 120.0)
            پردازش جاری = نادرست
        وگرنه:
            اتمام حرکت()
        پایان
        برگشت
    پایان
    کاسکید اولین = نادرست
    دلتا := تعداد * 10 * ترکیب
    امتیاز مرحله = امتیاز مرحله + دلتا
    امتیاز کل = امتیاز کل + دلتا
    اگر امتیاز کل > بهترین:
        بهترین = امتیاز کل
        دام.تنظیم عدد ذخیره("salam jewelmatch best", بهترین برگردان صحیح۶۴)
    پایان
    ترکیب = ترکیب + 1
    نمایش هود()
    رندر تخته()
    دام.صدا(500.0 + (ترکیب برگردان اعشار۶۴) * 40.0, 90.0)
    دام.تنظیم مهلت(
        (): ادامه فروپاشی() پایان, 220
    )
پایان

تابع شروع پردازش():
    پردازش جاری = درست
    ترکیب = 1
    کاسکید اولین = درست
    انجام سواپ()
    رندر تخته()
    دام.تنظیم مهلت(
        (): ادامه پردازش() پایان, 150
    )
پایان

تابع مجاور است(الف: صحیح, ب: صحیح): منطقی:
    ستون الف := الف % ستون
    ردیف الف := الف / ستون
    ستون ب := ب % ستون
    ردیف ب := ب / ستون
    اگر ردیف الف == ردیف ب و (ستون الف - ستون ب == 1 یا ستون ب - ستون الف == 1): برگشت درست پایان
    اگر ستون الف == ستون ب و (ردیف الف - ردیف ب == 1 یا ردیف ب - ردیف الف == 1): برگشت درست پایان
    برگشت نادرست
پایان

تابع کلیک خانه(ن: صحیح):
    اگر پردازش جاری: برگشت پایان
    اگر انتخاب شده == -1:
        انتخاب شده = ن
        رندر خانه(ن)
        برگشت
    پایان
    اگر ن == انتخاب شده:
        انتخاب شده = -1
        رندر خانه(ن)
        برگشت
    پایان
    اگر مجاور است(انتخاب شده, ن):
        قبلی := انتخاب شده
        انتخاب شده = -1
        رندر خانه(قبلی)
        سواپ الف = قبلی
        سواپ ب = ن
        شروع پردازش()
    وگرنه:
        قبلی := انتخاب شده
        انتخاب شده = ن
        رندر خانه(قبلی)
        رندر خانه(ن)
    پایان
پایان

تابع شروع مرحله():
    امتیاز مرحله = 0
    هدف مرحله = 300 + (سطح - 1) * 200
    حرکت باقی = 22 - (سطح - 1)
    اگر حرکت باقی < 12: حرکت باقی = 12 پایان
    انتخاب شده = -1
    پردازش جاری = نادرست
    دام.تنظیم سبک(پوشش, "display", "none")
    دام.تنظیم سبک(ناحیه بازی, "display", "block")
    ساخت تخته()
    رندر تخته()
    نمایش هود()
    دام.تنظیم متن(پیام, "دو خانه مجاور را برای جابجایی انتخاب کن")
پایان

تابع مرحله کامل():
    دام.تنظیم متن(عنوان پوشش, "مرحله " + سطح + " کامل شد! 🎉")
    دام.تنظیم متن(پیام پوشش, "امتیاز_مرحله: " + امتیاز مرحله + " / " + هدف مرحله)
    دام.تنظیم متن(دکمه پوشش, "مرحله بعد")
    دام.تنظیم سبک(ناحیه بازی, "display", "none")
    دام.تنظیم سبک(پوشش, "display", "block")
    دام.صدا(880.0, 220.0)
پایان

تابع مرحله ناموفق():
    دام.تنظیم متن(عنوان پوشش, "حرکت‌ها تمام شد!")
    دام.تنظیم متن(پیام پوشش, "امتیاز_مرحله: " + امتیاز مرحله + " / " + هدف مرحله)
    دام.تنظیم متن(دکمه پوشش, "تلاش دوباره")
    دام.تنظیم سبک(ناحیه بازی, "display", "none")
    دام.تنظیم سبک(پوشش, "display", "block")
    دام.صدا(160.0, 260.0)
پایان

تابع کلیک دکمه پوشش():
    اگر امتیاز مرحله >= هدف مرحله:
        سطح = سطح + 1
    پایان
    شروع مرحله()
پایان

تابع ریشه:
    هود = دام.با شناسه("hud")
    وضعیت جعبه = دام.با شناسه("status")
    پیام = دام.با شناسه("msg")
    ناحیه بازی = دام.با شناسه("play-area")
    پوشش = دام.با شناسه("overlay")
    عنوان پوشش = دام.با شناسه("overlay-title")
    پیام پوشش = دام.با شناسه("overlay-msg")
    دکمه پوشش = دام.با شناسه("overlay-btn")
    بهترین = دام.دریافت عدد ذخیره("salam jewelmatch best") برگردان صحیح
    تکرار تعداد خانه در ن:
        خانه عنصر[ن] = دام.با شناسه("t" + ن)
        دام.هنگام رویداد(
            خانه عنصر[ن], "click", (): کلیک خانه(ن) پایان
        )
    پایان
    دام.هنگام رویداد(
        دکمه پوشش, "click", (): کلیک دکمه پوشش() پایان
    )
    سطح = 1
    امتیاز کل = 0
    شروع مرحله()
پایان
