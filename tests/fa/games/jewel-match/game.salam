واردسازی دام

ستون := 6
ردیف := 6
تعداد_خانه := 36
انواع_جواهر := 6

رنگ_جواهر := ["#ff6b6b", "#ffb35c", "#ffe066", "#7cf7a0", "#6ee7f5", "#c792ff"]
نماد_جواهر := ["●", "■", "▲", "◆", "★", "⬢"]

کاشی: صحیح[36]
تطبیق_شده: منطقی[36]
خانه_عنصر: صحیح۶۴[36]

ناپایا هود := 0 برگردان صحیح۶۴
ناپایا وضعیت_جعبه := 0 برگردان صحیح۶۴
ناپایا پیام := 0 برگردان صحیح۶۴
ناپایا ناحیه_بازی := 0 برگردان صحیح۶۴
ناپایا پوشش := 0 برگردان صحیح۶۴
ناپایا عنوان_پوشش := 0 برگردان صحیح۶۴
ناپایا پیام_پوشش := 0 برگردان صحیح۶۴
ناپایا دکمه_پوشش := 0 برگردان صحیح۶۴

ناپایا سطح := 1
ناپایا امتیاز_کل := 0
ناپایا امتیاز_مرحله := 0
ناپایا هدف_مرحله := 300
ناپایا حرکت_باقی := 22
ناپایا بهترین := 0
ناپایا انتخاب_شده := -1
ناپایا در_حال_پردازش := نادرست
ناپایا ترکیب := 1

ناپایا سواپ_الف := -1
ناپایا سواپ_ب := -1
ناپایا کاسکید_اولین := درست

روال نمایش_هود():
    دام.تنظیم متن(هود, "سطح " + سطح + "   امتیاز_کل: " + امتیاز_کل + "   بهترین: " + بهترین)
    دام.تنظیم متن(وضعیت_جعبه, "هدف: " + امتیاز_مرحله + " / " + هدف_مرحله + "   حرکت: " + حرکت_باقی)
پایان

روال رندر_خانه(ن: صحیح):
    عنصر := خانه_عنصر[ن]
    نوع := کاشی[ن]
    دام.تنظیم متن(عنصر, نماد_جواهر[نوع])
    اگر تطبیق_شده[ن]:
        دام.افزودن کلاس(عنصر, "درخشش")
        دام.تنظیم سبک(عنصر, "background", "#ffffff")
    وگرنه:
        دام.حذف کلاس(عنصر, "درخشش")
        دام.تنظیم سبک(عنصر, "background", رنگ_جواهر[نوع])
    پایان
    اگر ن == انتخاب_شده:
        دام.افزودن کلاس(عنصر, "انتخاب")
    وگرنه:
        دام.حذف کلاس(عنصر, "انتخاب")
    پایان
پایان

روال رندر_تخته():
    تکرار تعداد_خانه از ن:
        رندر_خانه(ن)
    پایان
پایان

روال مقدار_تصادفی_جواهر(): صحیح:
    برگشت دام.تصادفی صحیح(انواع_جواهر) برگردان صحیح
پایان

روال می_سازد_تطبیق_فوری(ن: صحیح, نوع: صحیح): منطقی:
    ستون_ن := ن % ستون
    ردیف_ن := ن / ستون
    اگر ستون_ن >= 2:
        اگر کاشی[ن - 1] == نوع && کاشی[ن - 2] == نوع: برگشت درست پایان
    پایان
    اگر ردیف_ن >= 2:
        اگر کاشی[ن - ستون] == نوع && کاشی[ن - ستون * 2] == نوع: برگشت درست پایان
    پایان
    برگشت نادرست
پایان

روال ساخت_تخته():
    تکرار تعداد_خانه از ن:
        ناپایا نوع := مقدار_تصادفی_جواهر()
        ناپایا تلاش := 0
        تا می_سازد_تطبیق_فوری(ن, نوع) && تلاش < 30:
            نوع = مقدار_تصادفی_جواهر()
            تلاش = تلاش + 1
        پایان
        کاشی[ن] = نوع
    پایان
پایان

روال پاک_کردن_تطبیق_شده():
    تکرار تعداد_خانه از ن:
        تطبیق_شده[ن] = نادرست
    پایان
پایان

روال پیدا_تطبیق_ها(): صحیح:
    پاک_کردن_تطبیق_شده()
    تکرار ردیف از ر:
        ناپایا مقدار_جاری := کاشی[ر * ستون]
        ناپایا طول_جاری := 1
        ناپایا س := 1
        تا س < ستون:
            اگر کاشی[ر * ستون + س] == مقدار_جاری:
                طول_جاری = طول_جاری + 1
            وگرنه:
                اگر طول_جاری >= 3:
                    ناپایا ک := س - طول_جاری
                    تا ک < س:
                        تطبیق_شده[ر * ستون + ک] = درست
                        ک = ک + 1
                    پایان
                پایان
                مقدار_جاری = کاشی[ر * ستون + س]
                طول_جاری = 1
            پایان
            س = س + 1
        پایان
        اگر طول_جاری >= 3:
            ناپایا ک := ستون - طول_جاری
            تا ک < ستون:
                تطبیق_شده[ر * ستون + ک] = درست
                ک = ک + 1
            پایان
        پایان
    پایان
    تکرار ستون از س:
        ناپایا مقدار_جاری := کاشی[س]
        ناپایا طول_جاری := 1
        ناپایا ر := 1
        تا ر < ردیف:
            اگر کاشی[ر * ستون + س] == مقدار_جاری:
                طول_جاری = طول_جاری + 1
            وگرنه:
                اگر طول_جاری >= 3:
                    ناپایا ک := ر - طول_جاری
                    تا ک < ر:
                        تطبیق_شده[ک * ستون + س] = درست
                        ک = ک + 1
                    پایان
                پایان
                مقدار_جاری = کاشی[ر * ستون + س]
                طول_جاری = 1
            پایان
            ر = ر + 1
        پایان
        اگر طول_جاری >= 3:
            ناپایا ک := ردیف - طول_جاری
            تا ک < ردیف:
                تطبیق_شده[ک * ستون + س] = درست
                ک = ک + 1
            پایان
        پایان
    پایان
    ناپایا تعداد := 0
    تکرار تعداد_خانه از ن:
        اگر تطبیق_شده[ن]: تعداد = تعداد + 1 پایان
    پایان
    برگشت تعداد
پایان

روال سقوط_و_پرکردن():
    تکرار ستون از س:
        ناپایا نوشتن := ردیف - 1
        ناپایا ر := ردیف - 1
        تا ر >= 0:
            اگر !تطبیق_شده[ر * ستون + س]:
                اگر نوشتن != ر:
                    کاشی[نوشتن * ستون + س] = کاشی[ر * ستون + س]
                پایان
                نوشتن = نوشتن - 1
            پایان
            ر = ر - 1
        پایان
        تا نوشتن >= 0:
            کاشی[نوشتن * ستون + س] = مقدار_تصادفی_جواهر()
            نوشتن = نوشتن - 1
        پایان
    پایان
پایان

روال انجام_سواپ():
    موقت := کاشی[سواپ_الف]
    کاشی[سواپ_الف] = کاشی[سواپ_ب]
    کاشی[سواپ_ب] = موقت
پایان

روال پایان_حرکت():
    در_حال_پردازش = نادرست
    حرکت_باقی = حرکت_باقی - 1
    نمایش_هود()
    اگر امتیاز_مرحله >= هدف_مرحله:
        مرحله_کامل()
    وگرنه اگر حرکت_باقی <= 0:
        مرحله_ناموفق()
    پایان
پایان

روال ادامه_فروپاشی():
    سقوط_و_پرکردن()
    پاک_کردن_تطبیق_شده()
    رندر_تخته()
    دام.تنظیم مهلت(
        (): ادامه_پردازش() پایان, 160
    )
پایان

روال ادامه_پردازش():
    تعداد := پیدا_تطبیق_ها()
    اگر تعداد == 0:
        اگر کاسکید_اولین:
            انجام_سواپ()
            رندر_تخته()
            دام.صدا(160.0, 120.0)
            در_حال_پردازش = نادرست
        وگرنه:
            پایان_حرکت()
        پایان
        برگشت
    پایان
    کاسکید_اولین = نادرست
    دلتا := تعداد * 10 * ترکیب
    امتیاز_مرحله = امتیاز_مرحله + دلتا
    امتیاز_کل = امتیاز_کل + دلتا
    اگر امتیاز_کل > بهترین:
        بهترین = امتیاز_کل
        دام.تنظیم عدد ذخیره("salam jewelmatch best", بهترین برگردان صحیح۶۴)
    پایان
    ترکیب = ترکیب + 1
    نمایش_هود()
    رندر_تخته()
    دام.صدا(500.0 + (ترکیب برگردان اعشار۶۴) * 40.0, 90.0)
    دام.تنظیم مهلت(
        (): ادامه_فروپاشی() پایان, 220
    )
پایان

روال شروع_پردازش():
    در_حال_پردازش = درست
    ترکیب = 1
    کاسکید_اولین = درست
    انجام_سواپ()
    رندر_تخته()
    دام.تنظیم مهلت(
        (): ادامه_پردازش() پایان, 150
    )
پایان

روال مجاور_است(الف: صحیح, ب: صحیح): منطقی:
    ستون_الف := الف % ستون
    ردیف_الف := الف / ستون
    ستون_ب := ب % ستون
    ردیف_ب := ب / ستون
    اگر ردیف_الف == ردیف_ب && (ستون_الف - ستون_ب == 1 || ستون_ب - ستون_الف == 1): برگشت درست پایان
    اگر ستون_الف == ستون_ب && (ردیف_الف - ردیف_ب == 1 || ردیف_ب - ردیف_الف == 1): برگشت درست پایان
    برگشت نادرست
پایان

روال کلیک_خانه(ن: صحیح):
    اگر در_حال_پردازش: برگشت پایان
    اگر انتخاب_شده == -1:
        انتخاب_شده = ن
        رندر_خانه(ن)
        برگشت
    پایان
    اگر ن == انتخاب_شده:
        انتخاب_شده = -1
        رندر_خانه(ن)
        برگشت
    پایان
    اگر مجاور_است(انتخاب_شده, ن):
        قبلی := انتخاب_شده
        انتخاب_شده = -1
        رندر_خانه(قبلی)
        سواپ_الف = قبلی
        سواپ_ب = ن
        شروع_پردازش()
    وگرنه:
        قبلی := انتخاب_شده
        انتخاب_شده = ن
        رندر_خانه(قبلی)
        رندر_خانه(ن)
    پایان
پایان

روال شروع_مرحله():
    امتیاز_مرحله = 0
    هدف_مرحله = 300 + (سطح - 1) * 200
    حرکت_باقی = 22 - (سطح - 1)
    اگر حرکت_باقی < 12: حرکت_باقی = 12 پایان
    انتخاب_شده = -1
    در_حال_پردازش = نادرست
    دام.تنظیم سبک(پوشش, "display", "none")
    دام.تنظیم سبک(ناحیه_بازی, "display", "block")
    ساخت_تخته()
    رندر_تخته()
    نمایش_هود()
    دام.تنظیم متن(پیام, "دو خانه مجاور را برای جابجایی انتخاب کن")
پایان

روال مرحله_کامل():
    دام.تنظیم متن(عنوان_پوشش, "مرحله " + سطح + " کامل شد! 🎉")
    دام.تنظیم متن(پیام_پوشش, "امتیاز_مرحله: " + امتیاز_مرحله + " / " + هدف_مرحله)
    دام.تنظیم متن(دکمه_پوشش, "مرحله بعد")
    دام.تنظیم سبک(ناحیه_بازی, "display", "none")
    دام.تنظیم سبک(پوشش, "display", "block")
    دام.صدا(880.0, 220.0)
پایان

روال مرحله_ناموفق():
    دام.تنظیم متن(عنوان_پوشش, "حرکت‌ها تمام شد!")
    دام.تنظیم متن(پیام_پوشش, "امتیاز_مرحله: " + امتیاز_مرحله + " / " + هدف_مرحله)
    دام.تنظیم متن(دکمه_پوشش, "تلاش دوباره")
    دام.تنظیم سبک(ناحیه_بازی, "display", "none")
    دام.تنظیم سبک(پوشش, "display", "block")
    دام.صدا(160.0, 260.0)
پایان

روال کلیک_دکمه_پوشش():
    اگر امتیاز_مرحله >= هدف_مرحله:
        سطح = سطح + 1
    پایان
    شروع_مرحله()
پایان

روال ریشه:
    هود = دام.با شناسه("hud")
    وضعیت_جعبه = دام.با شناسه("status")
    پیام = دام.با شناسه("msg")
    ناحیه_بازی = دام.با شناسه("play area")
    پوشش = دام.با شناسه("overlay")
    عنوان_پوشش = دام.با شناسه("overlay title")
    پیام_پوشش = دام.با شناسه("overlay msg")
    دکمه_پوشش = دام.با شناسه("overlay btn")
    بهترین = دام.دریافت عدد ذخیره("salam jewelmatch best") برگردان صحیح
    تکرار تعداد_خانه از ن:
        خانه_عنصر[ن] = دام.با شناسه("t" + ن)
        دام.هنگام رویداد(
            خانه_عنصر[ن], "click", (): کلیک_خانه(ن) پایان
        )
    پایان
    دام.هنگام رویداد(
        دکمه_پوشش, "click", (): کلیک_دکمه_پوشش() پایان
    )
    سطح = 1
    امتیاز_کل = 0
    شروع_مرحله()
پایان
