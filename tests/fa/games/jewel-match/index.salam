بخش کاشی(شناسه):
    دکمه:
        شناسه = شناسه
        محتوا = ""
        کلاس = "کاشی"
        نسبت ابعاد = "1"
        اندازه قلم = "clamp(18px,5.8vw,26px)"
        رنگ = "#1b1330"
        وزن قلم = "bold"
        پس‌زمینه = "#123028"
        کادر = "2px solid rgba(0,0,0,.25)"
        گردی کادر = "8px"
        کنش لمسی = "manipulation"
    پایان
پایان

چیدمان:
    زبان = "فارسی"
    جهت = "راست به چپ"
    عنوان = "جواهرجور"
    سراسری: اندازه جعبه = "border-box" پایان
    سراسری:
        گزینشگر = "body"
        حاشیه = "0"
        کمینه ارتفاع = "100dvh"
        نمایش = "flex"
        ترازعمودی = "center"
        چینش = "center"
        پس‌زمینه = "radial-gradient(circle at top,#0b2a24 0%,#04100d 70%)"
        رنگ = "#eafff4"
        خانواده قلم = "Vazirmatn,Tahoma,Arial,sans-serif"
        فاصله داخلی = "14px"
        رنگ برجسته لمس = "transparent"
    پایان
    سراسری:
        گزینشگر = ".کاشی"
        نشانگر = "pointer"
    پایان
    سراسری:
        گزینشگر = ".کاشی.انتخاب"
        کادر = "2px solid #ffffff"
        سایه کادر = "0 0 12px rgba(255,255,255,.85)"
    پایان
    سراسری:
        گزینشگر = ".کاشی.درخشش"
        کادر = "2px solid #ffffff"
        سایه کادر = "0 0 18px rgba(255,255,255,.95)"
        پس‌زمینه = "#ffffff"
    پایان
    جعبه:
        شناسه = "wrap"
        ترازمتن = "center"
        عرض = "100%"
        بیشینه عرض = "380px"
        سرتیتر:
            محتوا = "جواهرجور"
            رنگ = "#5cffb0"
            حاشیه = "6px 0 2px"
            اندازه قلم = "clamp(22px,6vw,32px)"
            سایه متن = "0 0 16px rgba(92,255,176,.4)"
        پایان
        پاراگراف:
            محتوا = "جواهرهای مجاور را جابجا کن و سه‌تایی بساز!"
            رنگ = "#9adfc4"
            اندازه قلم = "clamp(12px,3.4vw,14px)"
            حاشیه = "0 0 10px"
        پایان
        جعبه:
            شناسه = "play area"
            نمایش = "block"
            جعبه:
                شناسه = "hud"
                محتوا = "..."
                اندازه قلم = "clamp(12px,3.4vw,15px)"
                رنگ = "#9ee7ff"
                حاشیه = "4px 0"
            پایان
            جعبه:
                شناسه = "status"
                محتوا = "..."
                اندازه قلم = "clamp(12px,3.4vw,15px)"
                رنگ = "#ffd166"
                حاشیه = "0 0 8px"
            پایان
            جعبه:
                شناسه = "board"
                نمایش = "grid"
                ستون‌های شبکه = "repeat(6,1fr)"
                شکاف = "4px"
                عرض = "min(300px,92vw)"
                حاشیه = "0 auto"
                کاشی: شناسه = "t0" پایان
                کاشی: شناسه = "t1" پایان
                کاشی: شناسه = "t2" پایان
