            پایان
            پاراگراف:
                شناسه = "msg"
                محتوا = "دو خانه مجاور را برای جابجایی انتخاب کن"
                رنگ = "#bfeede"
                اندازه قلم = "clamp(12px,3.4vw,14px)"
                حاشیه بالا = "10px"
                کمینه ارتفاع = "1.6em"
            پایان
        پایان
        جعبه:
            شناسه = "overlay"
            نمایش = "none"
            ترازمتن = "center"
            فاصله داخلی = "18px"
            حاشیه = "10px 0"
            پس‌زمینه = "rgba(255,255,255,.04)"
            کادر = "1px solid rgba(255,255,255,.12)"
            گردی کادر = "16px"
            پاراگراف:
                شناسه = "overlay title"
                محتوا = "..."
                رنگ = "#5cffb0"
                وزن قلم = "bold"
                اندازه قلم = "clamp(19px,5.4vw,25px)"
