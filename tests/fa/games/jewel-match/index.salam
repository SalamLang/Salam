                شناسه = "overlay msg"
                محتوا = "..."
                رنگ = "#e7fff3"
                اندازه قلم = "clamp(13px,3.8vw,15px)"
                حاشیه = "0 0 14px"
            پایان
            دکمه:
                شناسه = "overlay btn"
                محتوا = "..."
                خانواده قلم = "Vazirmatn,Tahoma,Arial,sans-serif"
                اندازه قلم = "15px"
                رنگ = "#04100d"
                پس‌زمینه = "#5cffb0"
                کادر = "none"
                گردی کادر = "10px"
                فاصله داخلی = "10px 26px"
                کنش لمسی = "manipulation"
            پایان
        پایان
    پایان
    اسکریپت سفارشی: منبع = "game.salam" پایان
پایان
