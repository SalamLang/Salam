واردسازی دام

ناپایا هود := 0 برگردان صحیح۶۴
ناپایا پیام := 0 برگردان صحیح۶۴
ناپایا امتیاز := 0
ناپایا بهترین := 0
ناپایا زمان باقی := 30
ناپایا بازی روشن := نادرست
ناپایا خانه فعال := -1
ناپایا شمارنده ثانیه := 0 برگردان صحیح۶۴
ناپایا شمارنده موش := 0 برگردان صحیح۶۴

تابع نمایش هود():
    دام.تنظیم متن(هود, "امتیاز: " + امتیاز + "   زمان: " + زمان باقی + "   بهترین: " + بهترین)
پایان

تابع نمایش خانه(ن: صحیح):
    عنصر := دام.با شناسه("h" + ن)
    دام.تنظیم متن(عنصر, "🐹")
    دام.افزودن کلاس(عنصر, "فعال")
پایان

تابع پنهان خانه(ن: صحیح):
    عنصر := دام.با شناسه("h" + ن)
    دام.تنظیم متن(عنصر, "")
    دام.حذف کلاس(عنصر, "فعال")
پایان

تابع خاموش کردن همه():
    تکرار 9 در ن:
        پنهان خانه(ن)
    پایان
پایان

تابع موش جدید():
    اگر خانه فعال >= 0: پنهان خانه(خانه فعال) پایان
    خانه فعال = دام.تصادفی صحیح(9) برگردان صحیح
    نمایش خانه(خانه فعال)
پایان

تابع اتمام بازی():
    بازی روشن = نادرست
    دام.پاک کردن بازه(شمارنده ثانیه)
    دام.پاک کردن بازه(شمارنده موش)
    اگر خانه فعال >= 0:
        پنهان خانه(خانه فعال)
        خانه فعال = -1
    پایان
    اگر امتیاز > بهترین:
        بهترین = امتیاز
        دام.تنظیم عدد ذخیره("salam reaction best", بهترین برگردان صحیح۶۴)
    پایان
    دام.تنظیم متن(پیام, "پایان بازی! امتیاز نهایی: " + امتیاز + " - دوباره دکمه را بزنید")
    نمایش هود()
پایان

تابع تیک ثانیه():
    زمان باقی = زمان باقی - 1
    نمایش هود()
    اگر زمان باقی <= 0: اتمام بازی() پایان
پایان

تابع شروع بازی():
    اگر بازی روشن: برگشت پایان
    امتیاز = 0
    زمان باقی = 30
    بازی روشن = درست
    خاموش کردن همه()
    دام.تنظیم متن(پیام, "خانه‌های روشن را لمس کنید!")
    کارکرد تیک := ():
        تیک ثانیه()
    پایان
    شمارنده ثانیه = دام.تنظیم بازه(کارکرد تیک, 1000)
    کارکرد موش := ():
        موش جدید()
    پایان
    شمارنده موش = دام.تنظیم بازه(کارکرد موش, 700)
    موش جدید()
    نمایش هود()
پایان

تابع کلیک خانه(ن: صحیح):
    اگر بازی روشن و ن == خانه فعال:
        امتیاز = امتیاز + 1
        پنهان خانه(ن)
        خانه فعال = -1
        دام.صدا(880.0, 60.0)
        نمایش هود()
    پایان
پایان

تابع ریشه:
    هود = دام.با شناسه("hud")
    پیام = دام.با شناسه("msg")
    بهترین = دام.دریافت عدد ذخیره("salam reaction best") برگردان صحیح
    تکرار 9 در ن:
        دام.هنگام رویداد(
            دام.با شناسه("h" + ن), "click", (): کلیک خانه(ن) پایان
        )
    پایان
    دام.هنگام رویداد(
        دام.با شناسه("start"), "click", (): شروع بازی() پایان
    )
    نمایش هود()
پایان
