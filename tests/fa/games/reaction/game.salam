فراخوانی دام

گذرا هود := 0 برگردان صحیح۶۴
گذرا پیام := 0 برگردان صحیح۶۴
گذرا امتیاز := 0
گذرا بهترین := 0
گذرا زمان_باقی := 30
گذرا در_حال_اجرا := نادرست
گذرا خانه_فعال := -1
گذرا شمارنده_ثانیه := 0 برگردان صحیح۶۴
گذرا شمارنده_موش := 0 برگردان صحیح۶۴

کارکرد نمایش_هود():
    دام.تنظیم متن(هود, "امتیاز: " + امتیاز + "   زمان: " + زمان_باقی + "   بهترین: " + بهترین)
پایان

کارکرد نمایش_خانه(ن: صحیح):
    عنصر := دام.با شناسه("h" + ن)
    دام.تنظیم متن(عنصر, "🐹")
    دام.افزودن کلاس(عنصر, "فعال")
پایان

کارکرد پنهان_خانه(ن: صحیح):
    عنصر := دام.با شناسه("h" + ن)
    دام.تنظیم متن(عنصر, "")
    دام.حذف کلاس(عنصر, "فعال")
پایان

کارکرد خاموش_کردن_همه():
    چرخه 9 با ن:
        پنهان_خانه(ن)
    پایان
پایان

کارکرد موش_جدید():
    اگر خانه_فعال >= 0: پنهان_خانه(خانه_فعال) پایان
    خانه_فعال = دام.تصادفی صحیح(9) برگردان صحیح
    نمایش_خانه(خانه_فعال)
پایان

کارکرد پایان_بازی():
    در_حال_اجرا = نادرست
    دام.پاک کردن بازه(شمارنده_ثانیه)
    دام.پاک کردن بازه(شمارنده_موش)
    اگر خانه_فعال >= 0:
        پنهان_خانه(خانه_فعال)
        خانه_فعال = -1
    پایان
    اگر امتیاز > بهترین:
        بهترین = امتیاز
        دام.تنظیم عدد ذخیره("salam reaction best", بهترین برگردان صحیح۶۴)
    پایان
    دام.تنظیم متن(پیام, "پایان بازی! امتیاز نهایی: " + امتیاز + " - دوباره دکمه را بزنید")
    نمایش_هود()
پایان

کارکرد تیک_ثانیه():
    زمان_باقی = زمان_باقی - 1
    نمایش_هود()
    اگر زمان_باقی <= 0: پایان_بازی() پایان
پایان

کارکرد شروع_بازی():
    اگر در_حال_اجرا: بازگشت پایان
    امتیاز = 0
    زمان_باقی = 30
    در_حال_اجرا = درست
    خاموش_کردن_همه()
    دام.تنظیم متن(پیام, "خانه‌های روشن را لمس کنید!")
    تیک_تابع := ():
        تیک_ثانیه()
    پایان
    شمارنده_ثانیه = دام.تنظیم بازه(تیک_تابع, 1000)
    موش_تابع := ():
        موش_جدید()
    پایان
    شمارنده_موش = دام.تنظیم بازه(موش_تابع, 700)
    موش_جدید()
    نمایش_هود()
پایان

کارکرد کلیک_خانه(ن: صحیح):
    اگر در_حال_اجرا && ن == خانه_فعال:
        امتیاز = امتیاز + 1
        پنهان_خانه(ن)
        خانه_فعال = -1
        دام.صدا(880.0, 60.0)
        نمایش_هود()
    پایان
پایان

کارکرد آغازین:
    هود = دام.با شناسه("hud")
    پیام = دام.با شناسه("msg")
    بهترین = دام.دریافت عدد ذخیره("salam reaction best") برگردان صحیح
    چرخه 9 با ن:
        دام.هنگام رویداد(
            دام.با شناسه("h" + ن), "click", (): کلیک_خانه(ن) پایان
        )
    پایان
    دام.هنگام رویداد(
        دام.با شناسه("start"), "click", (): شروع_بازی() پایان
    )
    نمایش_هود()
پایان
