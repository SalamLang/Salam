واردسازی دام

نامها := ["سنگ", "کاغذ", "قیچی"]
شکلها := ["🪨", "📄", "✂️"]

ناپایا هود := 0 برگردان صحیح۶۴
ناپایا امتیازجعبه := 0 برگردان صحیح۶۴
ناپایا برد := 0
ناپایا باخت := 0
ناپایا مساوی := 0

روال نمایش امتیاز():
    دام.تنظیم متن(امتیازجعبه, "برد: " + برد + "   باخت: " + باخت + "   مساوی: " + مساوی)
پایان

روال بازی کن(انتخاب من: صحیح):
    انتخاب رایانه := دام.تصادفی صحیح(3) برگردان صحیح
    اختلاف := (انتخاب من - انتخاب رایانه + 3) % 3
    متن := "شما " + شکلها[انتخاب من] + " " + نامها[انتخاب من] + "  در برابر  رایانه " + شکلها[انتخاب رایانه] + " " + نامها[انتخاب رایانه]
    اگر اختلاف == 0:
        مساوی = مساوی + 1
        دام.تنظیم متن(هود, متن + "  →  مساوی شد")
        دام.صدا(340.0, 180.0)
    وگرنه اختلاف == 1:
        برد = برد + 1
        دام.تنظیم متن(هود, متن + "  →  شما بردید!")
        دام.صدا(720.0, 200.0)
    وگرنه:
        باخت = باخت + 1
        دام.تنظیم متن(هود, متن + "  →  رایانه برد!")
        دام.صدا(220.0, 220.0)
    پایان
    نمایش امتیاز()
پایان

روال ریشه:
    هود = دام.با شناسه("hud")
    امتیازجعبه = دام.با شناسه("score")
    دام.هنگام رویداد(
        دام.با شناسه("pick0"), "click", (): بازی کن(0) پایان
    )
    دام.هنگام رویداد(
        دام.با شناسه("pick1"), "click", (): بازی کن(1) پایان
    )
    دام.هنگام رویداد(
        دام.با شناسه("pick2"), "click", (): بازی کن(2) پایان
    )
    نمایش امتیاز()
پایان
