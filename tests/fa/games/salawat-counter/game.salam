واردسازی دام

ناپایا شمار := 0 برگردان صحیح۶۴
ناپایا شمارجعبه := 0 برگردان صحیح۶۴
ناپایا هودجعبه := 0 برگردان صحیح۶۴

روال نمایش شمار():
    دام.تنظیم متن(شمارجعبه, "" + شمار)
پایان

روال بررسی مرحله(مقدار: صحیح۶۴):
    اگر مقدار == 10:
        دام.تنظیم متن(هودجعبه, "🌟 آفرین! ۱۰ صلوات فرستادی")
        دام.صدا(660.0, 220.0)
    وگرنه مقدار == 33:
        دام.تنظیم متن(هودجعبه, "✨ ۳۳ صلوات؛ دلت روشن باد")
        دام.صدا(660.0, 220.0)
    وگرنه مقدار == 100:
        دام.تنظیم متن(هودجعبه, "🕊️ صد صلوات؛ فرشته‌ها برایت دعا می‌کنند")
        دام.صدا(780.0, 260.0)
    وگرنه مقدار == 313:
        دام.تنظیم متن(هودجعبه, "💫 ۳۱۳ صلوات؛ به یاد یاران امام زمان")
        دام.صدا(780.0, 260.0)
    وگرنه مقدار == 1000:
        دام.تنظیم متن(هودجعبه, "🎉 هزار صلوات؛ ماشاءالله")
        دام.صدا(880.0, 320.0)
    وگرنه:
        دام.تنظیم متن(هودجعبه, "صلوات " + مقدار + " ثبت شد")
    پایان
پایان

روال صلوات بفرست():
    شمار = شمار + 1
    دام.تنظیم عدد ذخیره("salam salawat count", شمار)
    نمایش شمار()
    بررسی مرحله(شمار)
    دام.صدا(520.0, 90.0)
پایان

روال بازنشانی کن():
    اگر دام.تایید("شمارنده صفر بشود؟"):
        شمار = 0
        دام.تنظیم عدد ذخیره("salam salawat count", شمار)
        دام.تنظیم متن(هودجعبه, "برای شروع لمس کن")
        نمایش شمار()
    پایان
پایان

روال ریشه:
    شمارجعبه = دام.با شناسه("count")
    هودجعبه = دام.با شناسه("hud")
    شمار = دام.دریافت عدد ذخیره("salam salawat count")
    نمایش شمار()
    دام.هنگام رویداد(
        دام.با شناسه("tapBtn"), "click", (): صلوات بفرست() پایان
    )
    دام.هنگام رویداد(
        دام.با شناسه("resetBtn"), "click", (): بازنشانی کن() پایان
    )
پایان
