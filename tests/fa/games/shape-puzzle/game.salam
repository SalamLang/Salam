واردسازی دام
واردسازی وب.بوم
واردسازی ریاضی

تاو := 6.283185307179586

نام شکل := [
    "دایره", "بیضی", "مثلث", "مربع", "مستطیل", "لوزی", "پنج‌ضلعی", "شش‌ضلعی", "هفت‌ضلعی", "هشت‌ضلعی", "ستاره"
]
اضلاع شکل := [0, 0, 3, 4, 4, 4, 5, 6, 7, 8, 5]
چندضلعی شاخص := [2, 3, 4, 5, 6, 7, 8, 9]
رنگ ها := [
    "#ff6b6b", "#ffb35c", "#ffe066", "#7cf7a0", "#6ee7f5", "#7c9bff", "#c792ff", "#ff8ad1", "#f4f6ff"
]

گزینه متن: رشته[4]
گزینه عنصر: صحیح۶۴[4]

ناپایا زمینه := 0 برگردان صحیح۶۴
ناپایا هود := 0 برگردان صحیح۶۴
ناپایا جان جعبه := 0 برگردان صحیح۶۴
ناپایا سوال جعبه := 0 برگردان صحیح۶۴
ناپایا نوار داخلی := 0 برگردان صحیح۶۴
ناپایا پیام := 0 برگردان صحیح۶۴
ناپایا ناحیه بازی := 0 برگردان صحیح۶۴
ناپایا پوشش := 0 برگردان صحیح۶۴
ناپایا پیام اتمام := 0 برگردان صحیح۶۴

عرض بوم := 260.0
ارتفاع بوم := 190.0

ناپایا امتیاز := 0
ناپایا بهترین := 0
ناپایا جان := 3
ناپایا دور := 0
ناپایا رکورد متوالی := 0
ناپایا بهترین متوالی := 0

ناپایا شکل جاری := 0
ناپایا حالت سوال := 0
ناپایا رنگ جاری := "#ffffff"
ناپایا چرخش جاری := 0.0
ناپایا پاسخ مطلوب := 0

ناپایا بازی فعال := نادرست
ناپایا زمان کل := 7000.0
ناپایا زمان باقی := 7000.0

تابع نمایش هود():
    ناپایا قلب := ""
    تکرار جان:
        قلب = قلب + "❤"
    پایان
    دام.تنظیم متن(هود, "امتیاز: " + امتیاز + "   بهترین: " + بهترین + "   دور: " + دور)
    دام.تنظیم متن(جان جعبه, قلب)
پایان

تابع رسم چندضلعی(شعاع: اعشار۶۴, تعداد: صحیح, چرخش: اعشار۶۴):
    بوم.شروع مسیر(زمینه)
    تکرار تعداد در ن:
        زاویه := چرخش + (ن برگردان اعشار۶۴) * تاو / (تعداد برگردان اعشار۶۴)
        ایکس := عرض بوم * 0.5 + شعاع * ریاضی.کسینوس(زاویه)
        ایگرگ := ارتفاع بوم * 0.5 + شعاع * ریاضی.سینوس(زاویه)
        اگر ن == 0:
            بوم.برو به(زمینه, ایکس, ایگرگ)
        وگرنه:
            بوم.خط به(زمینه, ایکس, ایگرگ)
        پایان
    پایان
    بوم.بستن مسیر(زمینه)
    بوم.پرکن(زمینه)
پایان

تابع رسم ستاره(شعاع بیرون: اعشار۶۴, شعاع درون: اعشار۶۴, چرخش: اعشار۶۴):
    بوم.شروع مسیر(زمینه)
    تکرار 10 در ن:
        شعاع := ن % 2 == 0 ? شعاع بیرون : شعاع درون
        زاویه := چرخش + (ن برگردان اعشار۶۴) * تاو / 10.0
        ایکس := عرض بوم * 0.5 + شعاع * ریاضی.کسینوس(زاویه)
        ایگرگ := ارتفاع بوم * 0.5 + شعاع * ریاضی.سینوس(زاویه)
        اگر ن == 0:
            بوم.برو به(زمینه, ایکس, ایگرگ)
        وگرنه:
            بوم.خط به(زمینه, ایکس, ایگرگ)
        پایان
    پایان
    بوم.بستن مسیر(زمینه)
    بوم.پرکن(زمینه)
پایان

تابع رسم لوزی(نیم عرض: اعشار۶۴, نیم ارتفاع: اعشار۶۴):
    مرکز ایکس := عرض بوم * 0.5
    مرکز ایگرگ := ارتفاع بوم * 0.5
    بوم.شروع مسیر(زمینه)
    بوم.برو به(زمینه, مرکز ایکس, مرکز ایگرگ - نیم ارتفاع)
    بوم.خط به(زمینه, مرکز ایکس + نیم عرض, مرکز ایگرگ)
    بوم.خط به(زمینه, مرکز ایکس, مرکز ایگرگ + نیم ارتفاع)
    بوم.خط به(زمینه, مرکز ایکس - نیم عرض, مرکز ایگرگ)
    بوم.بستن مسیر(زمینه)
    بوم.پرکن(زمینه)
پایان

تابع رسم بیضی(شعاع ایکس: اعشار۶۴, شعاع ایگرگ: اعشار۶۴):
    بوم.ذخیره وضعیت(زمینه)
    بوم.جابجایی مختصات(زمینه, عرض بوم * 0.5, ارتفاع بوم * 0.5)
    بوم.مقیاس(زمینه, شعاع ایکس / شعاع ایگرگ, 1.0)
    بوم.شروع مسیر(زمینه)
    بوم.کمان(زمینه, 0.0, 0.0, شعاع ایگرگ, 0.0, تاو)
    بوم.پرکن(زمینه)
    بوم.بازگردانی وضعیت(زمینه)
پایان

تابع رسم دایره(شعاع: اعشار۶۴):
    بوم.شروع مسیر(زمینه)
    بوم.کمان(زمینه, عرض بوم * 0.5, ارتفاع بوم * 0.5, شعاع, 0.0, تاو)
    بوم.پرکن(زمینه)
پایان

تابع رسم مستطیل(نیم عرض: اعشار۶۴, نیم ارتفاع: اعشار۶۴):
    بوم.پرکردن مستطیل(
        زمینه, عرض بوم * 0.5 - نیم عرض, ارتفاع بوم * 0.5 - نیم ارتفاع, نیم عرض * 2.0, نیم ارتفاع * 2.0
    )
پایان

تابع رسم():
    بوم.سبک پرشدگی(زمینه, "#0b0f2a")
    بوم.پرکردن مستطیل(زمینه, 0.0, 0.0, عرض بوم, ارتفاع بوم)
    بوم.سبک پرشدگی(زمینه, رنگ جاری)
    اگر شکل جاری == 0:
        رسم دایره(58.0)
    وگرنه اگر شکل جاری == 1:
        رسم بیضی(72.0, 46.0)
    وگرنه اگر شکل جاری == 2:
        رسم چندضلعی(62.0, 3, چرخش جاری - ریاضی.پی * 0.5)
    وگرنه اگر شکل جاری == 3:
        رسم مستطیل(50.0, 50.0)
    وگرنه اگر شکل جاری == 4:
        رسم مستطیل(68.0, 40.0)
    وگرنه اگر شکل جاری == 5:
        رسم لوزی(52.0, 68.0)
    وگرنه اگر شکل جاری == 6:
        رسم چندضلعی(60.0, 5, چرخش جاری - ریاضی.پی * 0.5)
    وگرنه اگر شکل جاری == 7:
        رسم چندضلعی(58.0, 6, چرخش جاری)
    وگرنه اگر شکل جاری == 8:
        رسم چندضلعی(58.0, 7, چرخش جاری - ریاضی.پی * 0.5)
    وگرنه اگر شکل جاری == 9:
        رسم چندضلعی(58.0, 8, چرخش جاری)
    وگرنه:
        رسم ستاره(60.0, 26.0, چرخش جاری - ریاضی.پی * 0.5)
    پایان
پایان

تابع نمایش گزینه ها():
    تکرار 4 در ن:
        دام.تنظیم متن(گزینه عنصر[ن], گزینه متن[ن])
        دام.حذف کلاس(گزینه عنصر[ن], "درست")
        دام.حذف کلاس(گزینه عنصر[ن], "غلط")
    پایان
پایان

تابع دور جدید():
    دور = دور + 1
    حالت سوال = دام.تصادفی صحیح(2) برگردان صحیح
    اگر حالت سوال == 0:
        شکل جاری = دام.تصادفی صحیح(11) برگردان صحیح
    وگرنه:
        شکل جاری = چندضلعی شاخص[دام.تصادفی صحیح(8) برگردان صحیح]
    پایان
    رنگ جاری = رنگ ها[دام.تصادفی صحیح(9) برگردان صحیح]
    اگر شکل جاری == 3 یا شکل جاری == 4 یا شکل جاری == 5:
        چرخش جاری = 0.0
    وگرنه:
        چرخش جاری = ریاضی.رادیان(دام.تصادفی صحیح(360) برگردان اعشار۶۴)
    پایان
    پاسخ مطلوب = دام.تصادفی صحیح(4) برگردان صحیح
    اگر حالت سوال == 0:
        دام.تنظیم متن(سوال جعبه, "نام این شکل چیست؟")
        ناپایا ش := 0
        ناپایا کوشش := 0
        تا ش < 4 و کوشش < 300:
            کوشش = کوشش + 1
            اگر ش == پاسخ مطلوب:
                گزینه متن[ش] = نام شکل[شکل جاری]
                ش = ش + 1
                گذر
            پایان
            ک := دام.تصادفی صحیح(11) برگردان صحیح
            اگر ک == شکل جاری: گذر پایان
            ناپایا تکراری := نادرست
            تکرار ش در م:
                اگر گزینه متن[م] == نام شکل[ک]: تکراری = درست پایان
            پایان
            اگر تکراری: گذر پایان
            گزینه متن[ش] = نام شکل[ک]
            ش = ش + 1
        پایان
    وگرنه:
        دام.تنظیم متن(سوال جعبه, "این شکل چند ضلع دارد؟")
        تعداد اضلاع واقعی := اضلاع شکل[شکل جاری]
        ناپایا ش := 0
        ناپایا کوشش := 0
        تا ش < 4 و کوشش < 300:
            کوشش = کوشش + 1
            اگر ش == پاسخ مطلوب:
                گزینه متن[ش] = "" + تعداد اضلاع واقعی
                ش = ش + 1
                گذر
            پایان
            ک := 3 + (دام.تصادفی صحیح(6) برگردان صحیح)
            اگر ک == تعداد اضلاع واقعی: گذر پایان
            ناپایا تکراری := نادرست
            تکرار ش در م:
                اگر گزینه متن[م] == "" + ک: تکراری = درست پایان
            پایان
            اگر تکراری: گذر پایان
            گزینه متن[ش] = "" + ک
            ش = ش + 1
        پایان
    پایان
پایان

تابع دور جدید همراه نمایش():
    اگر جان <= 0: برگشت پایان
    دور جدید()
    نمایش گزینه ها()
    زمان کل = 7000.0 - (دور برگردان اعشار۶۴) * 150.0
    اگر زمان کل < 3000.0: زمان کل = 3000.0 پایان
    زمان باقی = زمان کل
    دام.تنظیم متن(پیام, "شکل را بشناس!")
    بازی فعال = درست
پایان

تابع اتمام بازی():
    بازی فعال = نادرست
    اگر امتیاز > بهترین:
        بهترین = امتیاز
        دام.تنظیم عدد ذخیره("salam shapequiz best", بهترین برگردان صحیح۶۴)
    پایان
    دام.تنظیم متن(پیام اتمام, "امتیاز نهایی: " + امتیاز + "   بهترین رکورد پیاپی: " + بهترین متوالی)
    دام.تنظیم سبک(ناحیه بازی, "display", "none")
    دام.تنظیم سبک(پوشش, "display", "block")
    نمایش هود()
پایان

تابع کلیک گزینه(ن: صحیح):
    اگر وارونه بازی فعال: برگشت پایان
    بازی فعال = نادرست
    اگر ن == پاسخ مطلوب:
        رکورد متوالی = رکورد متوالی + 1
        اگر رکورد متوالی > بهترین متوالی: بهترین متوالی = رکورد متوالی پایان
        امتیاز = امتیاز + 10 + رکورد متوالی * 2
        دام.افزودن کلاس(گزینه عنصر[ن], "درست")
        دام.صدا(880.0, 90.0)
        دام.تنظیم متن(پیام, "درسته! 🎉")
    وگرنه:
        رکورد متوالی = 0
        جان = جان - 1
        دام.افزودن کلاس(گزینه عنصر[ن], "غلط")
        دام.افزودن کلاس(گزینه عنصر[پاسخ مطلوب], "درست")
        دام.صدا(180.0, 220.0)
        دام.تنظیم متن(پیام, "اشتباه بود! پاسخ درست: " + گزینه متن[پاسخ مطلوب])
    پایان
    نمایش هود()
    اگر جان <= 0:
        اتمام بازی()
        برگشت
    پایان
    دام.تنظیم مهلت(
        (): دور جدید همراه نمایش() پایان, 900
    )
پایان

تابع زمان تمام():
    اگر وارونه بازی فعال: برگشت پایان
    بازی فعال = نادرست
    رکورد متوالی = 0
    جان = جان - 1
    دام.افزودن کلاس(گزینه عنصر[پاسخ مطلوب], "درست")
    دام.صدا(140.0, 260.0)
    دام.تنظیم متن(پیام, "زمان تمام شد! پاسخ درست: " + گزینه متن[پاسخ مطلوب])
    نمایش هود()
    اگر جان <= 0:
        اتمام بازی()
        برگشت
    پایان
    دام.تنظیم مهلت(
        (): دور جدید همراه نمایش() پایان, 900
    )
پایان

تابع شروع بازی():
    امتیاز = 0
    جان = 3
    دور = 0
    رکورد متوالی = 0
    دام.تنظیم سبک(پوشش, "display", "none")
    دام.تنظیم سبک(ناحیه بازی, "display", "block")
    نمایش هود()
    دور جدید همراه نمایش()
پایان

تابع فریم(دلتا: اعشار۶۴):
    اگر بازی فعال:
        زمان باقی = زمان باقی - دلتا
        اگر زمان باقی <= 0.0:
            زمان باقی = 0.0
            زمان تمام()
        پایان
    پایان
    ناپایا درصد := (زمان باقی / زمان کل) * 100.0
    اگر درصد < 0.0: درصد = 0.0 پایان
    دام.تنظیم سبک(نوار داخلی, "width", درصد + "%")
    رسم()
پایان

تابع ریشه:
    زمینه = بوم.زمینه عنصر(دام.با شناسه("game"))
    هود = دام.با شناسه("hud")
    جان جعبه = دام.با شناسه("lives")
    سوال جعبه = دام.با شناسه("question")
    نوار داخلی = دام.با شناسه("bar-inner")
    پیام = دام.با شناسه("msg")
    ناحیه بازی = دام.با شناسه("play-area")
    پوشش = دام.با شناسه("overlay")
    پیام اتمام = دام.با شناسه("final-msg")
    بهترین = دام.دریافت عدد ذخیره("salam shapequiz best") برگردان صحیح
    تکرار 4 در ن:
        گزینه عنصر[ن] = دام.با شناسه("opt" + ن)
        دام.هنگام رویداد(
            گزینه عنصر[ن], "click", (): کلیک گزینه(ن) پایان
        )
    پایان
    دام.هنگام رویداد(
        دام.با شناسه("again"), "click", (): شروع بازی() پایان
    )
    شروع بازی()
    دام.چرخش فریم(
        (دلتا: اعشار۶۴): فریم(دلتا) پایان
    )
پایان
