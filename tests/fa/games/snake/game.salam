واردسازی دام
واردسازی وب.بوم
واردسازی وب.کلیدها

واحد := 20.0
ستون := 16
ردیف := 16
عرض بوم := 320.0
ارتفاع بوم := 320.0
گام مار := 110.0

دلتاایکس := [1, 0, -1, 0]
دلتاایگرگ := [0, 1, 0, -1]

بدنه ایکس: صحیح[257]
بدنه ایگرگ: صحیح[257]

ناپایا زمینه := 0 برگردان صحیح۶۴
ناپایا هود := 0 برگردان صحیح۶۴
ناپایا پیام := 0 برگردان صحیح۶۴
ناپایا طول := 4
ناپایا مسیر := 0
ناپایا مسیر بعدی := 0
ناپایا خوراک ایکس := 0
ناپایا خوراک ایگرگ := 0
ناپایا امتیاز := 0
ناپایا بهترین := 0
ناپایا وضعیت := 0
ناپایا زمان گذشته := 0.0
ناپایا لمس‌ایکس := 0.0
ناپایا لمس‌ایگرگ := 0.0

تابع نمایش امتیاز():
    دام.تنظیم متن(هود, "امتیاز: " + امتیاز + "   بهترین: " + بهترین)
پایان

تابع تصادفی خوراک():
    ناپایا کوشش := 0
    تا کوشش < 60:
        ایکس := دام.تصادفی صحیح(ستون برگردان صحیح۶۴) برگردان صحیح
        ایگرگ := دام.تصادفی صحیح(ردیف برگردان صحیح۶۴) برگردان صحیح
        ناپایا آزاد := درست
        تکرار طول در ن:
            اگر بدنه ایکس[ن] == ایکس و بدنه ایگرگ[ن] == ایگرگ: آزاد = نادرست پایان
        پایان
        اگر آزاد:
            خوراک ایکس = ایکس
            خوراک ایگرگ = ایگرگ
            برگشت
        پایان
        کوشش++
    پایان
پایان

تابع شروع():
    طول = 4
    مسیر = 0
    مسیر بعدی = 0
    امتیاز = 0
    زمان گذشته = 0.0
    وضعیت = 0
    تکرار طول در ن:
        بدنه ایکس[ن] = 7 - ن
        بدنه ایگرگ[ن] = 8
    پایان
    تصادفی خوراک()
    نمایش امتیاز()
    دام.تنظیم متن(پیام, "با کلیدهای جهت‌دار یا کشیدن انگشت حرکت کنید")
پایان

تابع اتمام بازی():
    وضعیت = 2
    اگر امتیاز > بهترین:
        بهترین = امتیاز
        دام.تنظیم عدد ذخیره("salam snake best", بهترین برگردان صحیح۶۴)
    پایان
    نمایش امتیاز()
    دام.تنظیم متن(پیام, "باختید! برای شروع دوباره ضربه بزنید یا Enter را فشار دهید")
پایان

تابع حرکت یک قدم():
    مسیر = مسیر بعدی
    تازه ایکس := بدنه ایکس[0] + دلتاایکس[مسیر]
    تازه ایگرگ := بدنه ایگرگ[0] + دلتاایگرگ[مسیر]
    اگر تازه ایکس < 0 یا تازه ایکس >= ستون یا تازه ایگرگ < 0 یا تازه ایگرگ >= ردیف:
        اتمام بازی()
        برگشت
    پایان
    ناپایا برخورد := نادرست
    تکرار طول در ن:
        اگر بدنه ایکس[ن] == تازه ایکس و بدنه ایگرگ[ن] == تازه ایگرگ: برخورد = درست پایان
    پایان
    اگر برخورد:
        اتمام بازی()
        برگشت
    پایان
    ناپایا ن := طول
    تا ن > 0:
        بدنه ایکس[ن] = بدنه ایکس[ن - 1]
        بدنه ایگرگ[ن] = بدنه ایگرگ[ن - 1]
        ن--
    پایان
    بدنه ایکس[0] = تازه ایکس
    بدنه ایگرگ[0] = تازه ایگرگ
    اگر تازه ایکس == خوراک ایکس و تازه ایگرگ == خوراک ایگرگ:
        اگر طول < 250: طول++ پایان
        امتیاز += 10
        دام.صدا(560.0, 40.0)
        نمایش امتیاز()
        تصادفی خوراک()
    پایان
پایان

تابع بخواه مسیر(د: صحیح):
    مخالف := (مسیر + 2) % 4
    اگر د != مخالف: مسیر بعدی = د پایان
پایان

تابع رسم():
    بوم.سبک پرشدگی(زمینه, "#040a06")
    بوم.پرکردن مستطیل(زمینه, 0.0, 0.0, عرض بوم, ارتفاع بوم)
    بوم.سبک پرشدگی(زمینه, "#ffcf5c")
    بوم.شروع مسیر(زمینه)
    بوم.کمان(
        زمینه, (خوراک ایکس برگردان اعشار۶۴) * واحد + واحد * 0.5, (خوراک ایگرگ برگردان اعشار۶۴) * واحد + واحد * 0.5, واحد * 0.36, 0.0, 6.283185307179586
    )
    بوم.پرکن(زمینه)
    تکرار طول در ن:
        رنگ := ن == 0 ? "#a8ffc0" : "#4fbf7a"
        بوم.سبک پرشدگی(زمینه, رنگ)
        بوم.شروع مسیر(زمینه)
        بوم.مستطیل گرد(
            زمینه, (بدنه ایکس[ن] برگردان اعشار۶۴) * واحد + 1.0, (بدنه ایگرگ[ن] برگردان اعشار۶۴) * واحد + 1.0, واحد - 2.0, واحد - 2.0, 5.0
        )
        بوم.پرکن(زمینه)
    پایان
    اگر وضعیت != 0:
        بوم.سبک پرشدگی(زمینه, "rgba(3,10,5,0.7)")
        بوم.پرکردن مستطیل(زمینه, 0.0, 0.0, عرض بوم, ارتفاع بوم)
        بوم.ترازبندی متن(زمینه, "center")
        بوم.قلم(زمینه, "bold 28px Vazirmatn, Tahoma, sans-serif")
        بوم.سبک پرشدگی(زمینه, "#ff8080")
        بوم.پرکردن متن(زمینه, "باختید", عرض بوم * 0.5, ارتفاع بوم * 0.5 - 8.0)
        بوم.قلم(زمینه, "15px Vazirmatn, Tahoma, sans-serif")
        بوم.سبک پرشدگی(زمینه, "#eafff0")
        بوم.پرکردن متن(
            زمینه, "برای شروع دوباره ضربه بزنید", عرض بوم * 0.5, ارتفاع بوم * 0.5 + 22.0
        )
    پایان
پایان

تابع فریم(دلتا: اعشار۶۴):
    اگر وضعیت == 0:
        اگر کلیدها.نگه داشته("ArrowRight"): بخواه مسیر(0) پایان
        اگر کلیدها.نگه داشته("ArrowDown"): بخواه مسیر(1) پایان
        اگر کلیدها.نگه داشته("ArrowLeft"): بخواه مسیر(2) پایان
        اگر کلیدها.نگه داشته("ArrowUp"): بخواه مسیر(3) پایان
        زمان گذشته += دلتا
        تا زمان گذشته >= گام مار و وضعیت == 0:
            زمان گذشته -= گام مار
            حرکت یک قدم()
        پایان
    وگرنه:
        اگر کلیدها.فشرده شد("Enter"): شروع() پایان
    پایان
    رسم()
پایان

تابع ریشه:
    زمینه = بوم.زمینه عنصر(دام.با شناسه("game"))
    هود = دام.با شناسه("hud")
    پیام = دام.با شناسه("msg")
    کلیدها.آماده سازی()
    گیمکنوس := دام.با شناسه("game")
    دام.هنگام رویداد جزئی(
        گیمکنوس, "touchstart", (رخداد: صحیح۶۴): لمس‌ایکس = دام.لمس افقی(رخداد) لمس‌ایگرگ = دام.لمس عمودی(رخداد) پایان
    )
    دام.هنگام رویداد جزئی(
        گیمکنوس, "touchend", (رخداد: صحیح۶۴): اگر وضعیت != 0: شروع() برگشت پایان دلتاایکس‌لمس := دام.لمس افقی(رخداد) - لمس‌ایکس دلتاایگرگ‌لمس := دام.لمس عمودی(رخداد) - لمس‌ایگرگ قدرایکس := دلتاایکس‌لمس < 0.0 ? 0.0 - دلتاایکس‌لمس : دلتاایکس‌لمس قدرایگرگ := دلتاایگرگ‌لمس < 0.0 ? 0.0 - دلتاایگرگ‌لمس : دلتاایگرگ‌لمس اگر قدرایکس > 16.0 یا قدرایگرگ > 16.0: اگر قدرایکس > قدرایگرگ: بخواه مسیر(دلتاایکس‌لمس > 0.0 ? 0 : 2) وگرنه: بخواه مسیر(دلتاایگرگ‌لمس > 0.0 ? 1 : 3) پایان پایان پایان
    )
    بهترین = دام.دریافت عدد ذخیره("salam snake best") برگردان صحیح
    شروع()
    دام.چرخش فریم(
        (دلتا: اعشار۶۴): فریم(دلتا) پایان
    )
پایان
