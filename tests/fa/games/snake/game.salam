 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

واردسازی دام
واردسازی وب.بوم
واردسازی وب.کلیدها

واحد := 20.0
ستون := 16
ردیف := 16
عرض_بوم := 320.0
ارتفاع_بوم := 320.0
گام_مار := 110.0

دلتاایکس := [1, 0, -1, 0]
دلتاایگرگ := [0, 1, 0, -1]

بدنه_ایکس: صحیح[257]
بدنه_ایگرگ: صحیح[257]

ناپایا زمینه := 0 برگردان صحیح۶۴
ناپایا هود := 0 برگردان صحیح۶۴
ناپایا پیام := 0 برگردان صحیح۶۴
ناپایا طول := 4
ناپایا مسیر := 0
ناپایا مسیر_بعدی := 0
ناپایا خوراک_ایکس := 0
ناپایا خوراک_ایگرگ := 0
ناپایا امتیاز := 0
ناپایا بهترین := 0
ناپایا وضعیت := 0
ناپایا زمان_گذشته := 0.0
ناپایا لمس_ایکس := 0.0
ناپایا لمس_ایگرگ := 0.0

روال نمایش_امتیاز():
    دام.تنظیم متن(هود, "امتیاز: " + امتیاز + "   بهترین: " + بهترین)
پایان

روال تصادفی_خوراک():
    ناپایا تلاش := 0
    تا تلاش < 60:
        ایکس := دام.تصادفی صحیح(ستون برگردان صحیح۶۴) برگردان صحیح
        ایگرگ := دام.تصادفی صحیح(ردیف برگردان صحیح۶۴) برگردان صحیح
        ناپایا آزاد := درست
        تکرار طول از ن:
            اگر بدنه_ایکس[ن] == ایکس && بدنه_ایگرگ[ن] == ایگرگ: آزاد = نادرست پایان
        پایان
        اگر آزاد:
            خوراک_ایکس = ایکس
            خوراک_ایگرگ = ایگرگ
            برگشت
        پایان
        تلاش = تلاش + 1
    پایان
پایان

روال شروع():
    طول = 4
    مسیر = 0
    مسیر_بعدی = 0
    امتیاز = 0
    زمان_گذشته = 0.0
    وضعیت = 0
    تکرار طول از ن:
        بدنه_ایکس[ن] = 7 - ن
        بدنه_ایگرگ[ن] = 8
    پایان
    تصادفی_خوراک()
    نمایش_امتیاز()
    دام.تنظیم متن(پیام, "با کلیدهای جهت‌دار یا کشیدن انگشت حرکت کنید")
پایان

روال پایان_بازی():
    وضعیت = 2
    اگر امتیاز > بهترین:
        بهترین = امتیاز
        دام.تنظیم عدد ذخیره("salam snake best", بهترین برگردان صحیح۶۴)
    پایان
    نمایش_امتیاز()
    دام.تنظیم متن(پیام, "باختید! برای شروع دوباره ضربه بزنید یا Enter را فشار دهید")
پایان

روال حرکت_یک_قدم():
    مسیر = مسیر_بعدی
    تازه_ایکس := بدنه_ایکس[0] + دلتاایکس[مسیر]
    تازه_ایگرگ := بدنه_ایگرگ[0] + دلتاایگرگ[مسیر]
    اگر تازه_ایکس < 0 || تازه_ایکس >= ستون || تازه_ایگرگ < 0 || تازه_ایگرگ >= ردیف:
        پایان_بازی()
        برگشت
    پایان
    ناپایا برخورد := نادرست
    تکرار طول از ن:
        اگر بدنه_ایکس[ن] == تازه_ایکس && بدنه_ایگرگ[ن] == تازه_ایگرگ: برخورد = درست پایان
    پایان
    اگر برخورد:
        پایان_بازی()
        برگشت
    پایان
    ناپایا ن := طول
    تا ن > 0:
        بدنه_ایکس[ن] = بدنه_ایکس[ن - 1]
        بدنه_ایگرگ[ن] = بدنه_ایگرگ[ن - 1]
        ن = ن - 1
    پایان
    بدنه_ایکس[0] = تازه_ایکس
    بدنه_ایگرگ[0] = تازه_ایگرگ
    اگر تازه_ایکس == خوراک_ایکس && تازه_ایگرگ == خوراک_ایگرگ:
        اگر طول < 250: طول = طول + 1 پایان
        امتیاز = امتیاز + 10
        دام.صدا(560.0, 40.0)
        نمایش_امتیاز()
        تصادفی_خوراک()
    پایان
پایان

روال بخواه_مسیر(د: صحیح):
    مخالف := (مسیر + 2) % 4
    اگر د != مخالف: مسیر_بعدی = د پایان
پایان

روال رسم():
    بوم.سبک پرشدگی(زمینه, "#040a06")
    بوم.پرکردن مستطیل(زمینه, 0.0, 0.0, عرض_بوم, ارتفاع_بوم)
    بوم.سبک پرشدگی(زمینه, "#ffcf5c")
    بوم.شروع مسیر(زمینه)
    بوم.کمان(
        زمینه, (خوراک_ایکس برگردان اعشار۶۴) * واحد + واحد * 0.5, (خوراک_ایگرگ برگردان اعشار۶۴) * واحد + واحد * 0.5, واحد * 0.36, 0.0, 6.283185307179586
    )
    بوم.پرکن(زمینه)
    تکرار طول از ن:
        رنگ := ن == 0 ? "#a8ffc0" : "#4fbf7a"
        بوم.سبک پرشدگی(زمینه, رنگ)
        بوم.شروع مسیر(زمینه)
        بوم.مستطیل گرد(
            زمینه, (بدنه_ایکس[ن] برگردان اعشار۶۴) * واحد + 1.0, (بدنه_ایگرگ[ن] برگردان اعشار۶۴) * واحد + 1.0, واحد - 2.0, واحد - 2.0, 5.0
        )
        بوم.پرکن(زمینه)
    پایان
    اگر وضعیت != 0:
        بوم.سبک پرشدگی(زمینه, "rgba(3,10,5,0.7)")
        بوم.پرکردن مستطیل(زمینه, 0.0, 0.0, عرض_بوم, ارتفاع_بوم)
        بوم.ترازبندی متن(زمینه, "center")
        بوم.قلم(زمینه, "bold 28px Vazirmatn, Tahoma, sans-serif")
        بوم.سبک پرشدگی(زمینه, "#ff8080")
        بوم.پرکردن متن(زمینه, "باختید", عرض_بوم * 0.5, ارتفاع_بوم * 0.5 - 8.0)
        بوم.قلم(زمینه, "15px Vazirmatn, Tahoma, sans-serif")
        بوم.سبک پرشدگی(زمینه, "#eafff0")
        بوم.پرکردن متن(
            زمینه, "برای شروع دوباره ضربه بزنید", عرض_بوم * 0.5, ارتفاع_بوم * 0.5 + 22.0
        )
    پایان
پایان

روال فریم(دلتا: اعشار۶۴):
    اگر وضعیت == 0:
        اگر کلیدها.نگه داشته("ArrowRight"): بخواه_مسیر(0) پایان
        اگر کلیدها.نگه داشته("ArrowDown"): بخواه_مسیر(1) پایان
        اگر کلیدها.نگه داشته("ArrowLeft"): بخواه_مسیر(2) پایان
        اگر کلیدها.نگه داشته("ArrowUp"): بخواه_مسیر(3) پایان
        زمان_گذشته = زمان_گذشته + دلتا
        تا زمان_گذشته >= گام_مار && وضعیت == 0:
            زمان_گذشته = زمان_گذشته - گام_مار
            حرکت_یک_قدم()
        پایان
    وگرنه:
        اگر کلیدها.فشرده شد("Enter"): شروع() پایان
    پایان
    رسم()
پایان

روال ریشه:
    زمینه = بوم.زمینه عنصر(دام.با شناسه("game"))
    هود = دام.با شناسه("hud")
    پیام = دام.با شناسه("msg")
    کلیدها.آماده سازی()
    گیمکنوس := دام.با شناسه("game")
    دام.هنگام رویداد جزئی(
        گیمکنوس, "touchstart", (رخداد: صحیح۶۴): لمس_ایکس = دام.لمس افقی(رخداد) لمس_ایگرگ = دام.لمس عمودی(رخداد) پایان
    )
    دام.هنگام رویداد جزئی(
        گیمکنوس, "touchend", (رخداد: صحیح۶۴): اگر وضعیت != 0: شروع() برگشت پایان دلتاایکس_لمس := دام.لمس افقی(رخداد) - لمس_ایکس دلتاایگرگ_لمس := دام.لمس عمودی(رخداد) - لمس_ایگرگ قدرایکس := دلتاایکس_لمس < 0.0 ? 0.0 - دلتاایکس_لمس : دلتاایکس_لمس قدرایگرگ := دلتاایگرگ_لمس < 0.0 ? 0.0 - دلتاایگرگ_لمس : دلتاایگرگ_لمس اگر قدرایکس > 16.0 || قدرایگرگ > 16.0: اگر قدرایکس > قدرایگرگ: بخواه_مسیر(دلتاایکس_لمس > 0.0 ? 0 : 2) وگرنه: بخواه_مسیر(دلتاایگرگ_لمس > 0.0 ? 1 : 3) پایان پایان پایان
    )
    بهترین = دام.دریافت عدد ذخیره("salam snake best") برگردان صحیح
    شروع()
    دام.چرخش فریم(
        (دلتا: اعشار۶۴): فریم(دلتا) پایان
    )
پایان
