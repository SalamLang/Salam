فراخوانی دام

خط := [0, 1, 2, 3, 4, 5, 6, 7, 8, 0, 3, 6, 1, 4, 7, 2, 5, 8, 0, 4, 8, 2, 4, 6]

مربع: صحیح[9]
گذرا هود := 0 برگردان صحیح۶۴
گذرا امتیازجعبه := 0 برگردان صحیح۶۴
گذرا پیام := 0 برگردان صحیح۶۴
گذرا نوبت := 1
گذرا تمام := نادرست
گذرا امتیاز ایکس := 0
گذرا امتیاز او := 0
گذرا امتیاز مساوی := 0

کارکرد نام(علامت: صحیح): رشته:
    اگر علامت == 1: بازگشت "X" پایان
    اگر علامت == 2: بازگشت "O" پایان
    بازگشت ""
پایان

کارکرد نمایش امتیاز():
    دام.تنظیم متن(
        امتیازجعبه, "X: " + امتیاز ایکس + "   O: " + امتیاز او + "   مساوی: " + امتیاز مساوی
    )
پایان

کارکرد پر است(): منطقی:
    چرخه 9 با ن:
        اگر مربع[ن] == 0: بازگشت نادرست پایان
    پایان
    بازگشت درست
پایان

کارکرد برنده بررسی(): صحیح:
    چرخه 8 با ن:
        الف := خط[ن * 3]
        ب := خط[ن * 3 + 1]
        پ := خط[ن * 3 + 2]
        اگر مربع[الف] != 0 && مربع[الف] == مربع[ب] && مربع[ب] == مربع[پ]:
            بازگشت مربع[الف]
        پایان
    پایان
    بازگشت 0
پایان

کارکرد بازنشانی():
    چرخه 9 با ن:
        مربع[ن] = 0
        دام.تنظیم متن(دام.با شناسه("c" + ن), "")
    پایان
    نوبت = 1
    تمام = نادرست
    دام.تنظیم متن(هود, "نوبت: X")
    دام.تنظیم متن(پیام, "خانه‌ای را انتخاب کنید")
پایان

کارکرد کلیک سلول(ن: صحیح):
    اگر تمام || مربع[ن] != 0: بازگشت پایان
    مربع[ن] = نوبت
    دام.تنظیم متن(دام.با شناسه("c" + ن), نام(نوبت))
    برنده := برنده بررسی()
    اگر برنده != 0:
        تمام = درست
        اگر برنده == 1:
            امتیاز ایکس = امتیاز ایکس + 1
            دام.تنظیم متن(پیام, "X برنده شد!")
        وگرنه:
            امتیاز او = امتیاز او + 1
            دام.تنظیم متن(پیام, "O برنده شد!")
        پایان
        دام.صدا(720.0, 200.0)
        نمایش امتیاز()
        بازگشت
    پایان
    اگر پر است():
        تمام = درست
        امتیاز مساوی = امتیاز مساوی + 1
        دام.تنظیم متن(پیام, "مساوی شد!")
        دام.صدا(340.0, 200.0)
        نمایش امتیاز()
        بازگشت
    پایان
    نوبت = نوبت == 1 ? 2 : 1
    دام.تنظیم متن(هود, "نوبت: " + نام(نوبت))
پایان

کارکرد آغازین:
    هود = دام.با شناسه("hud")
    امتیازجعبه = دام.با شناسه("score")
    پیام = دام.با شناسه("msg")
    چرخه 9 با ن:
        دام.هنگام رویداد(
            دام.با شناسه("c" + ن), "click", (): کلیک سلول(ن) پایان
        )
    پایان
    دام.هنگام رویداد(
        دام.با شناسه("again"), "click", (): بازنشانی() پایان
    )
    بازنشانی()
    نمایش امتیاز()
پایان
