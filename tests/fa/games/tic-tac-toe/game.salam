 *
 */

واردسازی دام

خط := [0, 1, 2, 3, 4, 5, 6, 7, 8, 0, 3, 6, 1, 4, 7, 2, 5, 8, 0, 4, 8, 2, 4, 6]

مربع: صحیح[9]
ناپایا هود := 0 برگردان صحیح۶۴
ناپایا امتیازجعبه := 0 برگردان صحیح۶۴
ناپایا پیام := 0 برگردان صحیح۶۴
ناپایا نوبت := 1
ناپایا تمام := نادرست
ناپایا امتیاز ایکس := 0
ناپایا امتیاز او := 0
ناپایا امتیاز مساوی := 0

روال نام(علامت: صحیح): رشته:
    اگر علامت == 1: برگشت "X" پایان
    اگر علامت == 2: برگشت "O" پایان
    برگشت ""
پایان

روال نمایش امتیاز():
    دام.تنظیم متن(
        امتیازجعبه, "X: " + امتیاز ایکس + "   O: " + امتیاز او + "   مساوی: " + امتیاز مساوی
    )
پایان

روال پر است(): منطقی:
    تکرار 9 از ن:
        اگر مربع[ن] == 0: برگشت نادرست پایان
    پایان
    برگشت درست
پایان

روال برنده بررسی(): صحیح:
    تکرار 8 از ن:
        الف := خط[ن * 3]
        ب := خط[ن * 3 + 1]
        پ := خط[ن * 3 + 2]
        اگر مربع[الف] != 0 && مربع[الف] == مربع[ب] && مربع[ب] == مربع[پ]:
            برگشت مربع[الف]
        پایان
    پایان
    برگشت 0
پایان

روال بازنشانی():
    تکرار 9 از ن:
        مربع[ن] = 0
        دام.تنظیم متن(دام.با شناسه("c" + ن), "")
    پایان
    نوبت = 1
    تمام = نادرست
    دام.تنظیم متن(هود, "نوبت: X")
    دام.تنظیم متن(پیام, "خانه‌ای را انتخاب کنید")
پایان

روال کلیک سلول(ن: صحیح):
    اگر تمام || مربع[ن] != 0: برگشت پایان
    مربع[ن] = نوبت
    دام.تنظیم متن(دام.با شناسه("c" + ن), نام(نوبت))
    برنده := برنده بررسی()
    اگر برنده != 0:
        تمام = درست
        اگر برنده == 1:
            امتیاز ایکس = امتیاز ایکس + 1
            دام.تنظیم متن(پیام, "X برنده شد!")
        وگرنه:
            امتیاز او = امتیاز او + 1
            دام.تنظیم متن(پیام, "O برنده شد!")
        پایان
        دام.صدا(720.0, 200.0)
        نمایش امتیاز()
        برگشت
    پایان
    اگر پر است():
        تمام = درست
        امتیاز مساوی = امتیاز مساوی + 1
        دام.تنظیم متن(پیام, "مساوی شد!")
        دام.صدا(340.0, 200.0)
        نمایش امتیاز()
        برگشت
    پایان
    نوبت = نوبت == 1 ? 2 : 1
    دام.تنظیم متن(هود, "نوبت: " + نام(نوبت))
پایان

روال ریشه:
    هود = دام.با شناسه("hud")
    امتیازجعبه = دام.با شناسه("score")
    پیام = دام.با شناسه("msg")
    تکرار 9 از ن:
        دام.هنگام رویداد(
            دام.با شناسه("c" + ن), "click", (): کلیک سلول(ن) پایان
        )
    پایان
    دام.هنگام رویداد(
        دام.با شناسه("again"), "click", (): بازنشانی() پایان
    )
    بازنشانی()
    نمایش امتیاز()
پایان
