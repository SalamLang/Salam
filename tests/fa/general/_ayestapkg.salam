@fa "شکل‌ها"
package shapes

@fa "نقطه"
pub struct Point:
    @fa "ایکس"
    pub x: int = 0
    @fa "برچسب"
    pub label: str = ""
    @fa "مبدا"
    pub static func Origin(): Point:
        ret Point { x = 0, label = "o" }
    end
    @fa "بیشینه"
    pub const MAX := 99
end

@fa "نام‌دار"
pub interface Named:
    @fa "نام"
    func Name(): str
end

impl Named on Point:
    @fa "نام"
    func Name(): str:
        ret "point-" + this.label
    end
end
