بسته پیمانه

همگانی میانجی شکل:
    تابع مساحت(): صحیح
پایان

همگانی ساختار مربع:
    همگانی ضلع: صحیح = ۰
    همگانی تابع مساحت(): صحیح: برگشت این.ضلع * این.ضلع پایان
پایان

همگانی ساختار سازنده:
    همگانی نشان: صحیح = ۱
    همگانی تابع بگیر(ش: پویا شکل): صحیح: برگشت این.نشان + ش.مساحت() پایان
    همگانی تابع نوشته(م: صحیح یا رشته): رشته: برگشت این.نشان + ":" + نما(م) پایان
    همگانی ایستا تابع سنجش(ش: پویا شکل): صحیح: برگشت ش.مساحت() پایان
    همگانی ایستا تابع برچسب(م: صحیح یا رشته): رشته: برگشت نما(م) پایان
پایان

همگانی ساختار نگهدار:
    همگانی شکلی: تابع (پویا شکل) صحیح
    همگانی مقداری: تابع (صحیح یا رشته) رشته
پایان

همگانی تابع مساحت‌از(ش: پویا شکل): صحیح:
    برگشت ش.مساحت()
پایان

همگانی تابع نما(م: صحیح یا رشته): رشته:
    برگشت همخوان م:
        صحیح ن: "عدد:" + ن پایان
        رشته س: "رشته:" + س پایان
    پایان
پایان

همگانی تابع پیش‌فرض‌متن(ک: صحیح, م: صحیح یا رشته = "پیش"): رشته:
    برگشت ک + "/" + نما(م)
پایان

همگانی تابع پیش‌فرض‌شکل(ک: صحیح, ش: پویا شکل = مربع { ضلع = ۳ }): صحیح:
    برگشت ک + ش.مساحت()
پایان

همگانی تابع عام‌شکل<ت>(_چیز: ت, ش: پویا شکل): صحیح:
    برگشت ش.مساحت()
پایان

همگانی تابع عام‌مقدار<ت>(_چیز: ت, م: صحیح یا رشته): رشته:
    برگشت نما(م)
پایان

همگانی تابع گزینش(ش: پویا شکل): رشته:
    برگشت "شکل:" + ش.مساحت()
پایان

همگانی تابع گزینش(الف: صحیح, م: صحیح یا رشته): رشته:
    برگشت "مقدار:" + الف + ":" + نما(م)
پایان

همگانی تابع شکلی‌بده(): تابع (پویا شکل) صحیح:
    برگشت (ش: پویا شکل): برگشت ش.مساحت() پایان
پایان

همگانی تابع مقداری‌بده(): تابع (صحیح یا رشته) رشته:
    برگشت (م: صحیح یا رشته): برگشت نما(م) پایان
پایان

همگانی تابع نگهدارساز(): نگهدار:
    برگشت نگهدار { شکلی = شکلی‌بده(), مقداری = مقداری‌بده() }
پایان

همگانی تابع پهن(ع: صحیح۱۲۸): رشته:
    برگشت "پهن:" + (ع برگردان صحیح۶۴)
پایان
