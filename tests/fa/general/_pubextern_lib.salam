@en "cstd"
@fa "سی‌استاندارد"
بسته cstd

درون‌داد:
    @en "div"
    @fa "تقسیم"
    همگانی تابع div(numer: صحیح، denom: صحیح): نتیجه
    @en "abs"
    @fa "قدرمطلق"
    همگانی تابع abs(x: صحیح): صحیح
پایان

@en "DivResult"
@fa "نتیجه"
همگانی ساختار DivResult:
    @en "quot"
    @fa "خارج‌قسمت"
    همگانی quot: صحیح = 0
    @en "rem"
    @fa "باقی‌مانده"
    همگانی rem: صحیح = 0
پایان
