تابع ریشه:
    اعداد := [2, 4, 6, 8, 10]
    ناپایا مجموع := 0
    ناپایا نمایه := 0
    تا نمایه کوچکتر طول(اعداد):
        مجموع += اعداد[نمایه]
        نمایه++
    پایان
    سرچاپ مجموع, طول(اعداد)
پایان
