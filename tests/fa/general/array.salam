کارکرد آغازین:
    اعداد := [2, 4, 6, 8, 10]
    گذرا مجموع := 0
    گذرا نمایه := 0
    تاهنگام نمایه < len(اعداد):
        مجموع = مجموع + اعداد[نمایه]
        نمایه = نمایه + 1
    پایان
    چاپ مجموع, len(اعداد)
پایان
