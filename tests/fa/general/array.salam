// زبان: فارسی
تابع اصلی:
    اعداد := [2, 4, 6, 8, 10] بعنوان صحیح[5]
    متغیر مجموع := 0
    متغیر نمایه := 0
    تاوقتی نمایه < len(اعداد):
        مجموع = مجموع + اعداد[نمایه]
        نمایه = نمایه + 1
    تمام
    چاپ مجموع, len(اعداد)
تمام
