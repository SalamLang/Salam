ساختار Box:
    همگانی items: وکتور<صحیح> = وکتور {}
پایان

تابع squares(n: صحیح): وکتور<صحیح>:
    ناپایا out := وکتور {} برگردان وکتور<صحیح>
    تکرار n در i:
        out.بیفزا(i * i)
    پایان
    برگشت out
پایان

تابع total(v: وکتور<صحیح>): صحیح:
    ناپایا t := 0
    هر x در v:
        t += x
    پایان
    برگشت t
پایان

تابع fill(v &: وکتور<صحیح>، n: صحیح):
    تکرار n در i:
        v.بیفزا(i)
    پایان
پایان

تابع counts(words: وکتور<رشته>): صحیح:
    ناپایا m := نگاشت {} برگردان نگاشت<رشته، صحیح>
    هر w در words:
        m.درج(w، m.دریافت با پیش فرض(w، 0) + 1)
    پایان
    برگشت m.اندازه()
پایان

تابع ریشه:
    ناپایا sum := 0
    تکرار 3 در r:
        s := squares(4 + r)
        sum += total(s)
        ناپایا tmp := وکتور {} برگردان وکتور<صحیح>
        fill(tmp، 5)
        sum += tmp.طول()
    پایان
    سرچاپ sum
    ناپایا kept := وکتور {} برگردان وکتور<صحیح>
    kept.بیفزا(7)
    b := Box { items = kept }
    سرچاپ b.items.بگیر(0)
    ناپایا manual := وکتور {} برگردان وکتور<صحیح>
    manual.بیفزا(1)
    دیرکن manual.آزادکن()
    ناپایا again := وکتور {} برگردان وکتور<صحیح>
    again.بیفزا(2)
    again = squares(2)
    سرچاپ again.طول()، manual.طول()
    ناپایا ws := وکتور {} برگردان وکتور<رشته>
    ws.بیفزا("a")
    ws.بیفزا("b")
    ws.بیفزا("a")
    سرچاپ counts(ws)
    ناپایا it := نگاشت {} برگردان نگاشت<رشته، صحیح>
    it.درج("k"، 1)
    هر k، val در it:
        سرچاپ k، val
    پایان
پایان
