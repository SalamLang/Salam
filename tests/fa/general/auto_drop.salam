ساختار جعبه:
    همگانی فهرست: وکتور<صحیح> = وکتور {}
پایان

تابع مربع ها(n: صحیح): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    تکرار n در i:
        خروجی.بیفزا(i * i)
    پایان
    برگشت خروجی
پایان

تابع جمع کل(v: وکتور<صحیح>): صحیح:
    ناپایا t := 0
    هر x در v:
        t += x
    پایان
    برگشت t
پایان

تابع پر کردن(v &: وکتور<صحیح>، n: صحیح):
    تکرار n در i:
        v.بیفزا(i)
    پایان
پایان

تابع شمارش(واژه ها: وکتور<رشته>): صحیح:
    ناپایا m := نگاشت {} برگردان نگاشت<رشته، صحیح>
    هر w در واژه ها:
        m.درج(w، m.دریافت با پیش فرض(w، 0) + 1)
    پایان
    برگشت m.اندازه()
پایان

تابع ریشه:
    ناپایا مجموع := 0
    تکرار 3 در r:
        s := مربع ها(4 + r)
        مجموع += جمع کل(s)
        ناپایا موقت := وکتور {} برگردان وکتور<صحیح>
        پر کردن(موقت، 5)
        مجموع += موقت.طول()
    پایان
    سرچاپ مجموع
    ناپایا ذخیره := وکتور {} برگردان وکتور<صحیح>
    ذخیره.بیفزا(7)
    b := جعبه { فهرست = ذخیره }
    سرچاپ b.فهرست.بگیر(0)
    ناپایا دستی := وکتور {} برگردان وکتور<صحیح>
    دستی.بیفزا(1)
    دیرکن دستی.آزادکن()
    ناپایا دوباره := وکتور {} برگردان وکتور<صحیح>
    دوباره.بیفزا(2)
    دوباره = مربع ها(2)
    سرچاپ دوباره.طول()، دستی.طول()
    ناپایا فهرست واژه := وکتور {} برگردان وکتور<رشته>
    فهرست واژه.بیفزا("a")
    فهرست واژه.بیفزا("b")
    فهرست واژه.بیفزا("a")
    سرچاپ شمارش(فهرست واژه)
    ناپایا جدول := نگاشت {} برگردان نگاشت<رشته، صحیح>
    جدول.درج("k"، 1)
    هر k، مقدار در جدول:
        سرچاپ k، مقدار
    پایان
پایان
