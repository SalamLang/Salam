تابع تعداد یک(ن: صحیح): صحیح:
    ناپایا ایکس := ن
    ناپایا شمار := 0
    تا ایکس نابرابر 0:
        ایکس &= (ایکس - 1)
        شمار++
    پایان
    برگشت شمار
پایان

تابع تعداد ساده(ن: صحیح): صحیح:
    ناپایا ایکس := ن
    ناپایا شمار := 0
    تا ایکس بزرگتر 0:
        شمار += (ایکس & 1)
        ایکس >>= 1
    پایان
    برگشت شمار
پایان

تابع توان دو(ن: صحیح): منطقی:
    برگشت ن نابرابر 0 و (ن & (ن - 1)) برابر 0
پایان

تابع زوج(ن: صحیح): منطقی:
    برگشت (ن & 1) برابر 0
پایان

تابع پایینترین(ن: صحیح): صحیح:
    برگشت ن & (0 - ن)
پایان

تابع قدرمطلق(ایکس: صحیح): صحیح:
    م := ایکس >> 31
    برگشت (ایکس + م) ^ م
پایان

تابع ریشه:
    ناپایا شمارها := ""
    تکرار 12 در نمایه:
        شمارها = شمارها + تعداد یک((1 << نمایه) - 1) + " "
    پایان
    سرچاپ شمارها

    ناپایا یکسان := درست
    ناپایا ک := 0
    تا ک کوچکتر 300:
        اگر تعداد یک(ک) نابرابر تعداد ساده(ک):
            یکسان = نادرست
        پایان
        ک++
    پایان
    سرچاپ "هر دو روش یکسانند:", یکسان

    سرچاپ تعداد یک(0), تعداد یک(255), تعداد یک(-1)

    ناپایا توانها := ""
    تکرار 10 در نمایه:
        توانها = توانها + توان دو(نمایه) + " "
    پایان
    سرچاپ توانها

    سرچاپ زوج(0), زوج(7), زوج(-8)
    سرچاپ پایینترین(12), پایینترین(8), پایینترین(0)
    سرچاپ قدرمطلق(7), قدرمطلق(-7), قدرمطلق(0)

    ناپایا پ := 0x1234
    ناپایا ق := 0xABCD
    پ ^= ق
    ق ^= پ
    پ ^= ق
    سرچاپ پ, ق
پایان
