// زبان: فارسی
تابع تعداد یک(ن: صحیح): صحیح:
    متغیر ایکس := ن
    متغیر شمار := 0
    تاوقتی ایکس != 0:
        ایکس = ایکس & (ایکس - 1)
        شمار = شمار + 1
    تمام
    بازگشت شمار
تمام

تابع تعداد ساده(ن: صحیح): صحیح:
    متغیر ایکس := ن
    متغیر شمار := 0
    تاوقتی ایکس > 0:
        شمار = شمار + (ایکس & 1)
        ایکس = ایکس >> 1
    تمام
    بازگشت شمار
تمام

تابع توان دو(ن: صحیح): منطقی:
    بازگشت ن != 0 && (ن & (ن - 1)) == 0
تمام

تابع زوج(ن: صحیح): منطقی:
    بازگشت (ن & 1) == 0
تمام

تابع پایینترین(ن: صحیح): صحیح:
    بازگشت ن & (0 - ن)
تمام

تابع قدرمطلق(ایکس: صحیح): صحیح:
    م := ایکس >> 31
    بازگشت (ایکس + م) ^ م
تمام

تابع اصلی:
    متغیر شمارها := ""
    تکرار 12 با نمایه:
        شمارها = شمارها + تعداد یک((1 << نمایه) - 1) + " "
    تمام
    چاپ شمارها

    متغیر یکسان := درست
    متغیر ک := 0
    تاوقتی ک < 300:
        اگر تعداد یک(ک) != تعداد ساده(ک):
            یکسان = نادرست
        تمام
        ک = ک + 1
    تمام
    چاپ "هر دو روش یکسانند:", یکسان

    چاپ تعداد یک(0), تعداد یک(255), تعداد یک(-1)

    متغیر توانها := ""
    تکرار 10 با نمایه:
        توانها = توانها + توان دو(نمایه) + " "
    تمام
    چاپ توانها

    چاپ زوج(0), زوج(7), زوج(-8)
    چاپ پایینترین(12), پایینترین(8), پایینترین(0)
    چاپ قدرمطلق(7), قدرمطلق(-7), قدرمطلق(0)

    // جابهجایی با یای انحصاری بدون متغیر کمکی
    متغیر پ := 0x1234
    متغیر ق := 0xABCD
    پ ^= ق
    ق ^= پ
    پ ^= ق
    چاپ پ, ق
تمام
