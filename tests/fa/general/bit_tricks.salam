 *
 */

روال تعداد یک(ن: صحیح): صحیح:
    ناپایا ایکس := ن
    ناپایا شمار := 0
    تا ایکس != 0:
        ایکس = ایکس & (ایکس - 1)
        شمار = شمار + 1
    پایان
    برگشت شمار
پایان

روال تعداد ساده(ن: صحیح): صحیح:
    ناپایا ایکس := ن
    ناپایا شمار := 0
    تا ایکس > 0:
        شمار = شمار + (ایکس & 1)
        ایکس = ایکس >> 1
    پایان
    برگشت شمار
پایان

روال توان دو(ن: صحیح): منطقی:
    برگشت ن != 0 && (ن & (ن - 1)) == 0
پایان

روال زوج(ن: صحیح): منطقی:
    برگشت (ن & 1) == 0
پایان

روال پایینترین(ن: صحیح): صحیح:
    برگشت ن & (0 - ن)
پایان

روال قدرمطلق(ایکس: صحیح): صحیح:
    م := ایکس >> 31
    برگشت (ایکس + م) ^ م
پایان

روال ریشه:
    ناپایا شمارها := ""
    تکرار 12 از نمایه:
        شمارها = شمارها + تعداد یک((1 << نمایه) - 1) + " "
    پایان
    سرچاپ شمارها

    ناپایا یکسان := درست
    ناپایا ک := 0
    تا ک < 300:
        اگر تعداد یک(ک) != تعداد ساده(ک):
            یکسان = نادرست
        پایان
        ک = ک + 1
    پایان
    سرچاپ "هر دو روش یکسانند:", یکسان

    سرچاپ تعداد یک(0), تعداد یک(255), تعداد یک(-1)

    ناپایا توانها := ""
    تکرار 10 از نمایه:
        توانها = توانها + توان دو(نمایه) + " "
    پایان
    سرچاپ توانها

    سرچاپ زوج(0), زوج(7), زوج(-8)
    سرچاپ پایینترین(12), پایینترین(8), پایینترین(0)
    سرچاپ قدرمطلق(7), قدرمطلق(-7), قدرمطلق(0)

    ناپایا پ := 0x1234
    ناپایا ق := 0xABCD
    پ ^= ق
    ق ^= پ
    پ ^= ق
    سرچاپ پ, ق
پایان
