کارکرد تعداد یک(ن: صحیح): صحیح:
    گذرا ایکس := ن
    گذرا شمار := 0
    تاهنگام ایکس != 0:
        ایکس = ایکس & (ایکس - 1)
        شمار = شمار + 1
    پایان
    بازگشت شمار
پایان

کارکرد تعداد ساده(ن: صحیح): صحیح:
    گذرا ایکس := ن
    گذرا شمار := 0
    تاهنگام ایکس > 0:
        شمار = شمار + (ایکس & 1)
        ایکس = ایکس >> 1
    پایان
    بازگشت شمار
پایان

کارکرد توان دو(ن: صحیح): منطقی:
    بازگشت ن != 0 && (ن & (ن - 1)) == 0
پایان

کارکرد زوج(ن: صحیح): منطقی:
    بازگشت (ن & 1) == 0
پایان

کارکرد پایینترین(ن: صحیح): صحیح:
    بازگشت ن & (0 - ن)
پایان

کارکرد قدرمطلق(ایکس: صحیح): صحیح:
    م := ایکس >> 31
    بازگشت (ایکس + م) ^ م
پایان

کارکرد آغازین:
    گذرا شمارها := ""
    چرخه 12 با نمایه:
        شمارها = شمارها + تعداد یک((1 << نمایه) - 1) + " "
    پایان
    چاپ شمارها

    گذرا یکسان := درست
    گذرا ک := 0
    تاهنگام ک < 300:
        اگر تعداد یک(ک) != تعداد ساده(ک):
            یکسان = نادرست
        پایان
        ک = ک + 1
    پایان
    چاپ "هر دو روش یکسانند:", یکسان

    چاپ تعداد یک(0), تعداد یک(255), تعداد یک(-1)

    گذرا توانها := ""
    چرخه 10 با نمایه:
        توانها = توانها + توان دو(نمایه) + " "
    پایان
    چاپ توانها

    چاپ زوج(0), زوج(7), زوج(-8)
    چاپ پایینترین(12), پایینترین(8), پایینترین(0)
    چاپ قدرمطلق(7), قدرمطلق(-7), قدرمطلق(0)

    گذرا پ := 0x1234
    گذرا ق := 0xABCD
    پ ^= ق
    ق ^= پ
    پ ^= ق
    چاپ پ, ق
پایان
