روال ریشه:
    الف := 12
    ب := 10
    سرچاپ الف & ب, الف | ب, الف ^ ب
    سرچاپ الف << 2, الف >> 1, ~الف
    ناپایا ف := 0
    ف |= 5
    ف &= 6
    ف ^= 1
    ف <<= 2
    ف >>= 1
    سرچاپ ف
    سرچاپ 1 | 2 & 3, 1 << 4 + 1
    ناپایا نقاب := 0xFF
    نقاب = نقاب & 0x0F
    سرچاپ نقاب, 0b1010 | 0b0101
پایان
