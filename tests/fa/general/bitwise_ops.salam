// زبان: فارسی
تابع اصلی:
    چاپ 0 & 0, 0 & 1, 1 & 0, 1 & 1
    چاپ 0 | 0, 0 | 1, 1 | 0, 1 | 1
    چاپ 0 ^ 0, 0 ^ 1, 1 ^ 0, 1 ^ 1
    چاپ ~0, ~1, ~127, ~(-1)

    الف := 0b1100
    ب := 0b1010
    چاپ الف & ب, الف | ب, الف ^ ب
    چاپ الف & ~ب, ~الف & ب

    ایکس := 0x5A5A
    چاپ ایکس & 0, ایکس & (-1), ایکس | 0, ایکس | (-1)
    چاپ ایکس ^ 0, ایکس ^ ایکس, (ایکس ^ (-1)) == ~ایکس

    چاپ ~(الف & ب) == (~الف | ~ب)
    چاپ ~(الف | ب) == (~الف & ~ب)

    م := 1234
    ن := 5678
    چاپ (م ^ ن) + ((م & ن) * 2) == م + ن
    چاپ (م | ن) + (م & ن)

    چاپ 0xFF & 0b11110000, 0b101 | 0x0A
تمام
