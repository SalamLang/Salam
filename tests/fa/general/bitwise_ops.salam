روال ریشه:
    سرچاپ 0 & 0, 0 & 1, 1 & 0, 1 & 1
    سرچاپ 0 | 0, 0 | 1, 1 | 0, 1 | 1
    سرچاپ 0 ^ 0, 0 ^ 1, 1 ^ 0, 1 ^ 1
    سرچاپ ~0, ~1, ~127, ~(-1)

    الف := 0b1100
    ب := 0b1010
    سرچاپ الف & ب, الف | ب, الف ^ ب
    سرچاپ الف & ~ب, ~الف & ب

    ایکس := 0x5A5A
    سرچاپ ایکس & 0, ایکس & (-1), ایکس | 0, ایکس | (-1)
    سرچاپ ایکس ^ 0, ایکس ^ ایکس, (ایکس ^ (-1)) == ~ایکس

    سرچاپ ~(الف & ب) == (~الف | ~ب)
    سرچاپ ~(الف | ب) == (~الف & ~ب)

    م := 1234
    ن := 5678
    سرچاپ (م ^ ن) + ((م & ن) * 2) == م + ن
    سرچاپ (م | ن) + (م & ن)

    سرچاپ 0xFF & 0b11110000, 0b101 | 0x0A
پایان
