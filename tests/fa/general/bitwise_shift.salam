روال چپ(ایکس: صحیح, ن: صحیح): صحیح:
    برگشت ایکس << ن
پایان

روال راست(ایکس: صحیح, ن: صحیح): صحیح:
    برگشت ایکس >> ن
پایان

روال ریشه:
    ناپایا خط := ""
    تکرار 16 از نمایه:
        خط = خط + (1 << نمایه) + " "
    پایان
    سرچاپ خط

    سرچاپ 3 << 0, 3 << 1, 3 << 4, 3 << 10
    سرچاپ (3 << 10) == 3 * 1024
    سرچاپ 1024 >> 0, 1024 >> 1, 1024 >> 4, 1024 >> 10
    سرچاپ -1 >> 1, -2 >> 1, -8 >> 2, -9 >> 1
    سرچاپ -1024 >> 4, -1024 / 16

    سرچاپ 1 << 4 + 1, (1 << 4) + 1
    سرچاپ 64 >> 2 + 1, (64 >> 2) + 1
    سرچاپ 1 << 3 > 4, 16 >> 2 == 4

    سرچاپ 1 << 2 | 1, 3 & 1 << 2, 6 ^ 1 << 1

    سرچاپ چپ(1, 30), راست(1073741824, 30)
    سرچاپ چپ(-1, 4), راست(-16, 4)

    ناپایا بستهبندی := 0
    بستهبندی = بستهبندی | (0xAB << 8)
    بستهبندی = بستهبندی | 0xCD
    سرچاپ بستهبندی, بستهبندی >> 8, بستهبندی & 0xFF

    ناپایا ف := 0
    ف |= 5
    ف &= 6
    ف ^= 1
    ف <<= 2
    ف >>= 1
    سرچاپ ف
پایان
