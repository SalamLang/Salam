// زبان: فارسی
تابع چپ(ایکس: صحیح, ن: صحیح): صحیح:
    بازگشت ایکس << ن
تمام

تابع راست(ایکس: صحیح, ن: صحیح): صحیح:
    بازگشت ایکس >> ن
تمام

تابع اصلی:
    متغیر خط := ""
    تکرار 16 با نمایه:
        خط = خط + (1 << نمایه) + " "
    تمام
    چاپ خط

    چاپ 3 << 0, 3 << 1, 3 << 4, 3 << 10
    چاپ (3 << 10) == 3 * 1024
    چاپ 1024 >> 0, 1024 >> 1, 1024 >> 4, 1024 >> 10
    چاپ -1 >> 1, -2 >> 1, -8 >> 2, -9 >> 1
    چاپ -1024 >> 4, -1024 / 16

    // شیفتها از + و - سستتر و از مقایسهها سفتترند
    چاپ 1 << 4 + 1, (1 << 4) + 1
    چاپ 64 >> 2 + 1, (64 >> 2) + 1
    چاپ 1 << 3 > 4, 16 >> 2 == 4

    // و از & ^ | سفتترند
    چاپ 1 << 2 | 1, 3 & 1 << 2, 6 ^ 1 << 1

    چاپ چپ(1, 30), راست(1073741824, 30)
    چاپ چپ(-1, 4), راست(-16, 4)

    متغیر بستهبندی := 0
    بستهبندی = بستهبندی | (0xAB << 8)
    بستهبندی = بستهبندی | 0xCD
    چاپ بستهبندی, بستهبندی >> 8, بستهبندی & 0xFF

    متغیر ف := 0
    ف |= 5
    ف &= 6
    ف ^= 1
    ف <<= 2
    ف >>= 1
    چاپ ف
تمام
