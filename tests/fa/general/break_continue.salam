روال ریشه:
    ناپایا مجموع := 0
    ناپایا نمایه := 0
    تا نمایه < 20:
        نمایه = نمایه + 1
        اگر نمایه % 2 == 0:
            گذر
        پایان
        اگر نمایه > 9:
            بشکن
        پایان
        مجموع = مجموع + نمایه
    پایان
    سرچاپ مجموع
پایان
