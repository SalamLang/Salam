روال ریشه:
    ناپایا مجموع := 0
    ناپایا آخرین := -1
    تکرار 100 از نمایه:
        اگر نمایه % 3 == 0: گذر پایان
        اگر مجموع > 10: بشکن پایان
        مجموع = مجموع + نمایه
        آخرین = نمایه
    پایان
    سرچاپ مجموع
    سرچاپ آخرین

    ناپایا شمارنده := 0
    تکرار 3:
        تکرار 3 از نمایه۲:
            اگر نمایه۲ == 2: بشکن پایان
            تکرار 3 از نمایه۳:
                اگر نمایه۳ == 1: گذر پایان
                شمارنده = شمارنده + 1
            پایان
        پایان
    پایان
    سرچاپ شمارنده

    ناپایا یافت شد := 0
    ناپایا یافت نمایه := -1
    ناپایا یافت نمایه۲ := -1
    تکرار 5 از نمایه:
        تکرار 5 از نمایه۲:
            اگر نمایه * نمایه۲ == 6:
                یافت شد = 1
                یافت نمایه = نمایه
                یافت نمایه۲ = نمایه۲
                بشکن
            پایان
        پایان
        اگر یافت شد == 1: بشکن پایان
    پایان
    سرچاپ یافت نمایه
    سرچاپ یافت نمایه۲

    ناپایا پردازش شده := 0
    ناپایا بودجه := 5
    تکرار 20:
        بودجه = بودجه - 1
        اگر بودجه < 0: بشکن پایان
        اگر بودجه % 2 == 0: گذر پایان
        پردازش شده = پردازش شده + 1
    پایان
    سرچاپ پردازش شده
پایان
