کارکرد آغازین:
    گذرا مجموع := 0
    گذرا آخرین := -1
    چرخه 100 با نمایه:
        اگر نمایه % 3 == 0: بگذر پایان
        اگر مجموع > 10: بشکن پایان
        مجموع = مجموع + نمایه
        آخرین = نمایه
    پایان
    چاپ مجموع
    چاپ آخرین

    گذرا شمارنده := 0
    چرخه 3:
        چرخه 3 با نمایه۲:
            اگر نمایه۲ == 2: بشکن پایان
            چرخه 3 با نمایه۳:
                اگر نمایه۳ == 1: بگذر پایان
                شمارنده = شمارنده + 1
            پایان
        پایان
    پایان
    چاپ شمارنده

    گذرا یافت شد := 0
    گذرا یافت نمایه := -1
    گذرا یافت نمایه۲ := -1
    چرخه 5 با نمایه:
        چرخه 5 با نمایه۲:
            اگر نمایه * نمایه۲ == 6:
                یافت شد = 1
                یافت نمایه = نمایه
                یافت نمایه۲ = نمایه۲
                بشکن
            پایان
        پایان
        اگر یافت شد == 1: بشکن پایان
    پایان
    چاپ یافت نمایه
    چاپ یافت نمایه۲

    گذرا پردازش شده := 0
    گذرا بودجه := 5
    چرخه 20:
        بودجه = بودجه - 1
        اگر بودجه < 0: بشکن پایان
        اگر بودجه % 2 == 0: بگذر پایان
        پردازش شده = پردازش شده + 1
    پایان
    چاپ پردازش شده
پایان
