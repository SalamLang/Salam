تابع ریشه:
    ناپایا مجموع := 0
    ناپایا آخرین := -1
    تکرار 100 در نمایه:
        اگر نمایه % 3 برابر 0: گذر پایان
        اگر مجموع بزرگتر 10: بشکن پایان
        مجموع += نمایه
        آخرین = نمایه
    پایان
    سرچاپ مجموع
    سرچاپ آخرین

    ناپایا شمارنده := 0
    تکرار 3:
        تکرار 3 در نمایه۲:
            اگر نمایه۲ برابر 2: بشکن پایان
            تکرار 3 در نمایه۳:
                اگر نمایه۳ برابر 1: گذر پایان
                شمارنده++
            پایان
        پایان
    پایان
    سرچاپ شمارنده

    ناپایا یافت شد := 0
    ناپایا یافت نمایه := -1
    ناپایا یافت نمایه۲ := -1
    تکرار 5 در نمایه:
        تکرار 5 در نمایه۲:
            اگر نمایه * نمایه۲ برابر 6:
                یافت شد = 1
                یافت نمایه = نمایه
                یافت نمایه۲ = نمایه۲
                بشکن
            پایان
        پایان
        اگر یافت شد برابر 1: بشکن پایان
    پایان
    سرچاپ یافت نمایه
    سرچاپ یافت نمایه۲

    ناپایا پردازش شده := 0
    ناپایا بودجه := 5
    تکرار 20:
        بودجه--
        اگر بودجه کوچکتر 0: بشکن پایان
        اگر بودجه % 2 برابر 0: گذر پایان
        پردازش شده++
    پایان
    سرچاپ پردازش شده
پایان
