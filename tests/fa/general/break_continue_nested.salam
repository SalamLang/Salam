کارکرد آغازین:
    گذرا شمارنده := 0
    چرخه 4 با نمایه:
        چرخه 4 با نمایه۲:
            اگر نمایه۲ == نمایه: بشکن پایان
            شمارنده = شمارنده + 1
        پایان
    پایان
    چاپ شمارنده

    گذرا مجموع := 0
    چرخه 3:
        چرخه 3 با نمایه۲:
            اگر نمایه۲ == 1: بگذر پایان
            مجموع = مجموع + 1
        پایان
    پایان
    چاپ مجموع

    گذرا برون := 0
    چرخه 3:
        برون = برون + 1
        چرخه 5:
            بشکن
        پایان
    پایان
    چاپ برون

    گذرا جمع کل := 0
    گذرا مقدار := 0
    تاهنگام مقدار < 3:
        مقدار = مقدار + 1
        چرخه 10 با نمایه۳:
            اگر نمایه۳ == 2: بشکن پایان
            جمع کل = جمع کل + 1
        پایان
    پایان
    چاپ جمع کل

    گذرا اصابت برون := 0
    گذرا اصابت درون := 0
    چرخه 3:
        اصابت برون = اصابت برون + 1
        چرخه 4 با نمایه۲:
            اگر نمایه۲ % 2 == 0: بگذر پایان
            اصابت درون = اصابت درون + 1
        پایان
    پایان
    چاپ اصابت برون
    چاپ اصابت درون
پایان
