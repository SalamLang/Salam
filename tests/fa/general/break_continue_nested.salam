روال ریشه:
    ناپایا شمارنده := 0
    تکرار 4 از نمایه:
        تکرار 4 از نمایه۲:
            اگر نمایه۲ == نمایه: بشکن پایان
            شمارنده = شمارنده + 1
        پایان
    پایان
    سرچاپ شمارنده

    ناپایا مجموع := 0
    تکرار 3:
        تکرار 3 از نمایه۲:
            اگر نمایه۲ == 1: گذر پایان
            مجموع = مجموع + 1
        پایان
    پایان
    سرچاپ مجموع

    ناپایا برون := 0
    تکرار 3:
        برون = برون + 1
        تکرار 5:
            بشکن
        پایان
    پایان
    سرچاپ برون

    ناپایا جمع کل := 0
    ناپایا مقدار := 0
    تا مقدار < 3:
        مقدار = مقدار + 1
        تکرار 10 از نمایه۳:
            اگر نمایه۳ == 2: بشکن پایان
            جمع کل = جمع کل + 1
        پایان
    پایان
    سرچاپ جمع کل

    ناپایا اصابت برون := 0
    ناپایا اصابت درون := 0
    تکرار 3:
        اصابت برون = اصابت برون + 1
        تکرار 4 از نمایه۲:
            اگر نمایه۲ % 2 == 0: گذر پایان
            اصابت درون = اصابت درون + 1
        پایان
    پایان
    سرچاپ اصابت برون
    سرچاپ اصابت درون
پایان
