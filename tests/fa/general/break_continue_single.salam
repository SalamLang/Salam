کارکرد آغازین:
    گذرا الف := 0
    چرخه 10 با نمایه:
        اگر نمایه == 5: بشکن پایان
        الف = الف + نمایه
    پایان
    چاپ الف

    گذرا ب := 0
    چرخه 10 با نمایه:
        اگر نمایه % 2 == 0: بگذر پایان
        ب = ب + نمایه
    پایان
    چاپ ب

    گذرا پ := 0
    گذرا نمایه۲ := 0
    تاهنگام نمایه۲ < 100:
        اگر نمایه۲ == 7: بشکن پایان
        پ = پ + 1
        نمایه۲ = نمایه۲ + 1
    پایان
    چاپ پ

    گذرا ت := 0
    گذرا نمایه۳ := 0
    تاهنگام نمایه۳ < 10:
        نمایه۳ = نمایه۳ + 1
        اگر نمایه۳ % 2 == 0: بگذر پایان
        ت = ت + 1
    پایان
    چاپ ت

    گذرا ث := 0
    چرخه 10:
        ث = ث + 1
        اگر ث == 3: بشکن پایان
    پایان
    چاپ ث

    گذرا ج := 0
    گذرا چ := 0
    چرخه 6:
        چ = چ + 1
        اگر چ % 3 == 0: بگذر پایان
        ج = ج + 1
    پایان
    چاپ ج
پایان
