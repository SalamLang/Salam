روال ریشه:
    ناپایا الف := 0
    تکرار 10 از نمایه:
        اگر نمایه == 5: بشکن پایان
        الف = الف + نمایه
    پایان
    سرچاپ الف

    ناپایا ب := 0
    تکرار 10 از نمایه:
        اگر نمایه % 2 == 0: گذر پایان
        ب = ب + نمایه
    پایان
    سرچاپ ب

    ناپایا پ := 0
    ناپایا نمایه۲ := 0
    تا نمایه۲ < 100:
        اگر نمایه۲ == 7: بشکن پایان
        پ = پ + 1
        نمایه۲ = نمایه۲ + 1
    پایان
    سرچاپ پ

    ناپایا ت := 0
    ناپایا نمایه۳ := 0
    تا نمایه۳ < 10:
        نمایه۳ = نمایه۳ + 1
        اگر نمایه۳ % 2 == 0: گذر پایان
        ت = ت + 1
    پایان
    سرچاپ ت

    ناپایا ث := 0
    تکرار 10:
        ث = ث + 1
        اگر ث == 3: بشکن پایان
    پایان
    سرچاپ ث

    ناپایا ج := 0
    ناپایا چ := 0
    تکرار 6:
        چ = چ + 1
        اگر چ % 3 == 0: گذر پایان
        ج = ج + 1
    پایان
    سرچاپ ج
پایان
