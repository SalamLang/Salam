روال متغیر‌محیطی(نام: رشته): رشته:
    برگشت "env:" + نام
پایان

روال فهرست‌پوشه(مسیر: رشته): صحیح:
    برگشت طول(مسیر) + 6
پایان

روال مقایسه‌رشته(a: رشته، b: رشته): صحیح:
    برگشت طول(a) * 10 + طول(b)
پایان

روال زبان(): رشته:
    برگشت "mine"
پایان

روال درهم(x: صحیح): صحیح:
    برگشت x * 2
پایان

روال کدنویسه(c: رشته): صحیح:
    برگشت طول(c) + 98
پایان

روال ریشه:
    سرچاپ متغیر‌محیطی("X")، فهرست‌پوشه("/")، مقایسه‌رشته("a"، "a")، زبان()، درهم(21)، کدنویسه("A")
پایان
