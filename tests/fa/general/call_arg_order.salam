تابع افزایش(n &: صحیح): صحیح:
    n += 1
    برگشت n
پایان

تابع جفت(a: صحیح، b: صحیح): صحیح:
    برگشت a * 10 + b
پایان

تابع سه تایی(a: صحیح، b: صحیح، c: صحیح): صحیح:
    برگشت a * 100 + b * 10 + c
پایان

تابع اعمال(f: تابع (صحیح) صحیح، x: صحیح): صحیح:
    برگشت f(x)
پایان

تابع ریشه:
    ناپایا c := 1
    سرچاپ جفت(c، افزایش(c))
    ناپایا d := 1
    سرچاپ جفت(d + 0، افزایش(d))
    ناپایا e := 1
    سرچاپ سه تایی(e، افزایش(e)، e)
    ناپایا f := 1
    سرچاپ اعمال((x: صحیح): برگشت x + f پایان، افزایش(f))
    ناپایا g := 5
    سرچاپ جفت(افزایش(g)، g)
پایان
