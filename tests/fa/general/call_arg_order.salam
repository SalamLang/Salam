تابع bump(n &: صحیح): صحیح:
    n += 1
    برگشت n
پایان

تابع pair(a: صحیح، b: صحیح): صحیح:
    برگشت a * 10 + b
پایان

تابع triple(a: صحیح، b: صحیح، c: صحیح): صحیح:
    برگشت a * 100 + b * 10 + c
پایان

تابع apply(f: تابع (صحیح) صحیح، x: صحیح): صحیح:
    برگشت f(x)
پایان

تابع ریشه:
    ناپایا c := 1
    سرچاپ pair(c، bump(c))
    ناپایا d := 1
    سرچاپ pair(d + 0، bump(d))
    ناپایا e := 1
    سرچاپ triple(e، bump(e)، e)
    ناپایا f := 1
    سرچاپ apply((x: صحیح): برگشت x + f پایان، bump(f))
    ناپایا g := 5
    سرچاپ pair(bump(g)، g)
پایان
