ناپایا g_keep := وکتور {} برگردان وکتور<تابع (صحیح) صحیح>

تابع apply(f: تابع (صحیح) صحیح، x: صحیح): صحیح:
    برگشت f(x)
پایان

تابع stash(f: تابع (صحیح) صحیح):
    g_keep.بیفزا(f)
پایان

تابع twice(f: تابع (صحیح) صحیح، x: صحیح): صحیح:
    برگشت apply(f، apply(f، x))
پایان

تابع bump(n &: صحیح): صحیح:
    n += 1
    برگشت n
پایان

تابع ریشه:
    ناپایا total := 0
    تکرار 4 در i:
        base := i * 3
        total += apply((x: صحیح): برگشت x + base پایان، 1)
    پایان
    k := 7
    stash((x: صحیح): برگشت x * k پایان)
    ناپایا c := 1
    total += apply((x: صحیح): برگشت x + c پایان، bump(c))
    سرچاپ total، g_keep.بگیر(0)(2)، twice((x: صحیح): برگشت x + k پایان، 1)
پایان
