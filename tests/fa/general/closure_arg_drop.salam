ناپایا نگه دارنده := وکتور {} برگردان وکتور<تابع (صحیح) صحیح>

تابع اعمال(f: تابع (صحیح) صحیح، x: صحیح): صحیح:
    برگشت f(x)
پایان

تابع ذخیره کردن(f: تابع (صحیح) صحیح):
    نگه دارنده.بیفزا(f)
پایان

تابع دو بار(f: تابع (صحیح) صحیح، x: صحیح): صحیح:
    برگشت اعمال(f، اعمال(f، x))
پایان

تابع افزایش(n &: صحیح): صحیح:
    n++
    برگشت n
پایان

تابع ریشه:
    ناپایا جمع کل := 0
    تکرار 4 در i:
        پایه := i * 3
        جمع کل += اعمال((x: صحیح): برگشت x + پایه پایان، 1)
    پایان
    k := 7
    ذخیره کردن((x: صحیح): برگشت x * k پایان)
    ناپایا c := 1
    افزوده := افزایش(c)
    جمع کل += اعمال((x: صحیح): برگشت x + c پایان، افزوده)
    سرچاپ جمع کل، نگه دارنده.بگیر(0)(2)، دو بار((x: صحیح): برگشت x + k پایان، 1)
پایان
