ناپایا g_keep := وکتور {} برگردان وکتور<تابع (صحیح) صحیح>

تابع apply(f: تابع (صحیح) صحیح، x: صحیح): صحیح:
    برگشت f(x)
پایان

تابع stash(f: تابع (صحیح) صحیح):
    g_keep.بیفزا(f)
پایان

تابع ریشه:
    ناپایا total := 0
    تکرار 3 در i:
        base := i * 10
        add := (x: صحیح): برگشت x + base پایان
        total += add(1)
        total += apply(add، 2)
    پایان
    k := 5
    kept := (x: صحیح): برگشت x * k پایان
    stash(kept)
    سرچاپ total، g_keep.بگیر(0)(3)
پایان
