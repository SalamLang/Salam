ناپایا نگه دارنده := وکتور {} برگردان وکتور<تابع (صحیح) صحیح>

تابع اعمال(f: تابع (صحیح) صحیح، x: صحیح): صحیح:
    برگشت f(x)
پایان

تابع ذخیره کردن(f: تابع (صحیح) صحیح):
    نگه دارنده.بیفزا(f)
پایان

تابع ریشه:
    ناپایا جمع کل := 0
    تکرار 3 در i:
        پایه := i * 10
        افزودن := (x: صحیح): برگشت x + پایه پایان
        جمع کل += افزودن(1)
        جمع کل += اعمال(افزودن، 2)
    پایان
    k := 5
    ذخیره شده := (x: صحیح): برگشت x * k پایان
    ذخیره کردن(ذخیره شده)
    سرچاپ جمع کل، نگه دارنده.بگیر(0)(3)
پایان
