// زبان: فارسی
/* یک توضیح بلوکی ساده
   در چند
   خط */
تابع اصلی:
    /* توضیح بلوکی پیش از دستور */
    چاپ 1
    چاپ /* توضیح بلوکی درون‌خطی */ 2
    /* توضیح بلوکی تودرتو:
       /* این توضیح درونی کاملاً دربرگرفته شده
          /* و یک سطح سوم هم */
       */
       هنوز درون توضیح بیرونی هستیم، چاپ 999 نباید اجرا شود
    */
    چاپ 3
تمام
