روال ریشه:
    سرچاپ سلام سیستم.طول() > 0
    سرچاپ سلام معماری.طول() > 0
    سرچاپ سلام نگارش.طول() > 0
    اگر تعریف‌شده(سلام سیستم یونیکس) یا تعریف‌شده(سلام سیستم ویندوز):
        سرچاپ "سیستم شناخته شد"
    پایان
    ناپایا شمار := ۰
    اگر سلام سیستم لینوکس: شمار += ۱ پایان
    اگر سلام سیستم مک: شمار += ۱ پایان
    اگر سلام سیستم ویندوز: شمار += ۱ پایان
    سرچاپ شمار >= ۱
    اگر سلام پاک‌ساز نشانی:
        سرچاپ "پاک‌ساز روشن"
    وگرنه:
        سرچاپ "پاک‌ساز خاموش"
    پایان
    اگر سلام اشکال‌زدایی حافظه:
        سرچاپ "اشکال‌زدایی روشن"
    وگرنه:
        سرچاپ "اشکال‌زدایی خاموش"
    پایان
    اگر سلام خودایستا یا سلام هسته:
        سرچاپ "بی‌میزبان"
    وگرنه:
        سرچاپ "میزبان‌دار"
    پایان
    اگر سلام سیستم وب‌اسمبلی:
        سرچاپ "وب‌اسمبلی"
    وگرنه:
        سرچاپ "بومی"
    پایان
    اگر سلام سیستم وب اسمبلی:
        سرچاپ "وب‌اسمبلی"
    وگرنه:
        سرچاپ "بومی"
    پایان
    سرچاپ سلام سيستم.طول() > 0
پایان
