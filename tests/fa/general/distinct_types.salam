گونه متر: صحیح
    تابع + (دیگری: متر): متر:
        برگشت ((این برگردان صحیح) + (دیگری برگردان صحیح) + 1000) برگردان متر
    پایان
    تابع *(k: صحیح): متر:
        برگشت ((این برگردان صحیح) * k) برگردان متر
    پایان
    تابع *(o: متر): صحیح:
        برگشت (این برگردان صحیح) * (o برگردان صحیح)
    پایان
    تابع -: متر:
        برگشت (0 - (این برگردان صحیح)) برگردان متر
    پایان
    تابع == (دیگری: متر): منطقی:
        برگشت (این برگردان صحیح) == (دیگری برگردان صحیح)
    پایان
    تابع کیلومتر: اعشار۶۴:
        برگشت (این برگردان اعشار۶۴) / 1000.0
    پایان
پایان

گونه پول: اعشار۶۴
    تابع + (o: پول): پول:
        برگشت ((این برگردان اعشار۶۴) + (o برگردان اعشار۶۴)) برگردان پول
    پایان
پایان

گونه فاصله = متر

گونه پرچم: منطقی
    تابع وارونه: پرچم:
        برگشت (این برگردان منطقی) برگردان پرچم
    پایان
پایان

تابع ریشه:
    a := 5 برگردان متر
    b := 7 برگردان متر
    سرچاپ (a + b) برگردان صحیح
    سرچاپ (a + 3) برگردان صحیح
    سرچاپ (3 + a) برگردان صحیح
    سرچاپ (a * 4) برگردان صحیح
    سرچاپ a * b
    سرچاپ (-a) برگردان صحیح
    سرچاپ a == b
    سرچاپ a != b
    سرچاپ a < b
    سرچاپ (b - a) برگردان صحیح
    سرچاپ (a * 400).کیلومتر()
    l := 2 برگردان فاصله
    سرچاپ (l + a) برگردان صحیح
    m := 1.5 برگردان پول
    سرچاپ (m + m) برگردان اعشار۶۴
    سرچاپ a
    ناپایا c := 5 برگردان متر
    c += b
    سرچاپ c
    c -= b
    سرچاپ c
    f := درست برگردان پرچم
    سرچاپ (وارونه f) برگردان منطقی
پایان
