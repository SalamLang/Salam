// lang: fa
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

گونه Meters: صحیح
    روال + (other: Meters): Meters:
        برگشت ((این برگردان صحیح) + (other برگردان صحیح) + 1000) برگردان Meters
    پایان
    روال *(k: صحیح): Meters:
        برگشت ((این برگردان صحیح) * k) برگردان Meters
    پایان
    روال *(o: Meters): صحیح:
        برگشت (این برگردان صحیح) * (o برگردان صحیح)
    پایان
    روال -: Meters:
        برگشت (0 - (این برگردان صحیح)) برگردان Meters
    پایان
    روال == (other: Meters): منطقی:
        برگشت (این برگردان صحیح) == (other برگردان صحیح)
    پایان
    روال km: اعشار۶۴:
        برگشت (این برگردان اعشار۶۴) / 1000.0
    پایان
پایان

گونه Money: اعشار۶۴
    روال + (o: Money): Money:
        برگشت ((این برگردان اعشار۶۴) + (o برگردان اعشار۶۴)) برگردان Money
    پایان
پایان

گونه Length = Meters

گونه Flag: منطقی
    روال !: Flag:
        برگشت (این برگردان منطقی) برگردان Flag
    پایان
پایان

روال ریشه:
    a := 5 برگردان Meters
    b := 7 برگردان Meters
    سرچاپ (a + b) برگردان صحیح
    سرچاپ (a + 3) برگردان صحیح
    سرچاپ (3 + a) برگردان صحیح
    سرچاپ (a * 4) برگردان صحیح
    سرچاپ a * b
    سرچاپ (-a) برگردان صحیح
    سرچاپ a == b
    سرچاپ a != b
    سرچاپ a < b
    سرچاپ (b - a) برگردان صحیح
    سرچاپ (a * 400).km()
    l := 2 برگردان Length
    سرچاپ (l + a) برگردان صحیح
    m := 1.5 برگردان Money
    سرچاپ (m + m) برگردان اعشار۶۴
    سرچاپ a
    ناپایا c := 5 برگردان Meters
    c += b
    سرچاپ c
    c -= b
    سرچاپ c
    f := درست برگردان Flag
    سرچاپ (!f) برگردان منطقی
پایان
