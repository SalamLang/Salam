واردسازی مجموعه ها
واردسازی مرتب سازی

تابع ریشه:
    ناپایا م := مجموعه ها.مجموعه {} برگردان مجموعه ها.مجموعه<صحیح>
    م.افزودن(۳)
    م.افزودن(۱)
    م.افزودن(۲)
    ناپایا اعضا := وکتور {} برگردان وکتور<صحیح>
    هر ایکس در م:
        اعضا.بیفزا(ایکس)
    پایان
    مرتب سازی.مرتب(اعضا)
    هر ایکس در اعضا:
        سرچاپ "مجموعه"، ایکس
    پایان

    ناپایا پ := مجموعه ها.پشته {} برگردان مجموعه ها.پشته<صحیح>
    پ.افزودن(۱)
    پ.افزودن(۲)
    هر ایکس در پ:
        سرچاپ "پشته"، ایکس
    پایان

    ناپایا ص := مجموعه ها.صف {} برگردان مجموعه ها.صف<صحیح>
    ص.وارد کردن(۱۰)
    ص.وارد کردن(۲۰)
    هر ایکس در ص:
        سرچاپ "صف"، ایکس
    پایان
پایان
