واردسازی کدگذاری.اکس‌ام‌ال
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.مقدار
واردسازی کدگذاری.نشانی وب
واردسازی کدگذاری.پرس‌وجو
واردسازی کدگذاری.تامل
واردسازی کدگذاری.دودویی
واردسازی فشرده سازی

تابع ریشه خطادار:
    ناپایا س := تلاش اکس‌ام‌ال.تجزیه("<a k=\"v\">متن</a>")
    ر := اکس‌ام‌ال.عنصر ریشه(س)
    سرچاپ اکس‌ام‌ال.نام(س، ر)، اکس‌ام‌ال.مقدار ویژگی(س، ر، "k")، اکس‌ام‌ال.مقدار(س، اکس‌ام‌ال.فرزند شماره(س، ر، ۰))
    اکس‌ام‌ال.آزادسازی(س)
    م := تلاش جیسون.کدگشایی(`{"a": [1, 2]}`) گرفتن خطا مقدار.مقدار تهی()
    سرچاپ جیسون.کدگذاری پیش فرض(م)، مقدار.طول آرایه(مقدار.مقدار کلید(م، "a"))
    ن := تلاش نشانی وب.تجزیه نشانی("https://x.ir/?q=1&p=2")
    سرچاپ پرس‌وجو.اندازه(تلاش نشانی وب.پرس‌وجو(ن))
    سرچاپ مقدار.به صحیح(مقدار.مقدار کلید(تلاش تامل.کدگشایی("n = 5\n")، "n"))
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    دودویی.نوشتن طبیعی۱۶ بزرگ‌انتها(ب، ۵۱۳)
    ناپایا خوان := فشرده سازی.خواننده از بافر(ب)
    سرچاپ دودویی.خواندن طبیعی۱۶ بزرگ‌انتها(خوان)
    فشرده سازی.آزادسازی بافر(ب)
پایان
