برون‌داد:
    روال demo_twice(x: صحیح): صحیح:
        برگشت x * 2
    پایان
    ناب روال demo_square(x: صحیح): صحیح:
        برگشت x * x
    پایان
    بی‌کاره روال demo_old(): صحیح:
        برگشت 1
    پایان
پایان

روال ریشه:
    سرچاپ demo_twice(21)
    سرچاپ demo_square(0 - 7)
    fp := (&demo_twice) برگردان درون‌داد روال (صحیح) صحیح
    سرچاپ fp(5)
پایان
