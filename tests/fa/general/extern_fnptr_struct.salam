        ناپایا r := Pair {}
        r.a = ((a.a برگردان صحیح۶۴) + (k برگردان صحیح۶۴)) برگردان صحیح۳۲
        r.b = ((a.b برگردان صحیح۶۴) + (k برگردان صحیح۶۴)) برگردان صحیح۳۲
        برگشت r
