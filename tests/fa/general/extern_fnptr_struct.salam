تابع cb_Big3(a: Big3، k: صحیح۳۲): Big3:
    ناپایا r := Big3 {}
    r.a = (a.a + (k برگردان صحیح۶۴))
    r.b = (a.b + (k برگردان صحیح۶۴))
    r.c = (a.c + (k برگردان صحیح۶۴))
