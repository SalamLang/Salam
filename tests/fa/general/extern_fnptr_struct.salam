    r.c = (a.c + b.c + (k برگردان صحیح۶۴) + g0 + g1 + g2 + g3 + g4 + (f0 برگردان صحیح۶۴) + (f1 برگردان صحیح۶۴) + (f2 برگردان صحیح۶۴) + (f3 برگردان صحیح۶۴) + (f4 برگردان صحیح۶۴) + (f5 برگردان صحیح۶۴) + (f6 برگردان صحیح۶۴))
