واردسازی تبدیل
واردسازی تبدیل.قالب عددی

تابع نمایش(متن: رشته):
    اول := تبدیل.قالب اعشار(متن.به اعشار())
    دوم := تبدیل.قالب اعشار(قالب عددی.خواندن اعشار(متن))
    سوم := تبدیل.قالب اعشار(تبدیل.تجزیه اعشار با پیش فرض(متن، -7.0))
    سرچاپ "[" + متن + "] " + اول + " " + دوم + " " + سوم
پایان

تابع ریشه پرتاب خطا:
    فهرست := [
        "nan"، "inf"، "-inf"، "+inf"، "infinity"، "-infinity"، "NaN"، "Inf"، "INF"، "INFINITY"،
        "-Infinity"، "nAn"، "+nan"، "nanx"، "infx"، "infinite"، "infinityx"، " inf"، "inf "، "\tinf"،
        "in"، "na"، "-in"، "2.5"، "-1e3"، "1e400"، "-1e400"، "1e-400"، "abc"، ""، "-"، "-abc"،
        "3.5x"، ".5"، "-.5e-1"، "-0"، "1e"، "1e+"، "0x10"، "-0x10"، "0x1.8p1"، "0X1P3"، "0x"، "۲.۵"،
        "-۳"، "٣.٥"، "٫٥"
    ]
    هر مورد در فهرست:
        نمایش(مورد)
    پایان
    سرچاپ تلاش تبدیل.تجزیه اعشار("inf")
    سرچاپ تلاش تبدیل.تجزیه اعشار("-Infinity")
    سرچاپ تلاش تبدیل.تجزیه اعشار("NaN")
    سرچاپ تلاش تبدیل.تجزیه اعشار("۲.۵")
پایان
