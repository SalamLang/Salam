فراخوانی ک "_boxlib.salam"

روال ریشه:
    ج := ک.بپیچ(۵)
    سرچاپ ج.بگیر()
    د := ک.بپیچ("س")
    سرچاپ د.مقدار
    ه := ک.جعبه { مقدار = ۷ } برگردان ک.جعبه<صحیح>
    سرچاپ ه.بگیر()
پایان
