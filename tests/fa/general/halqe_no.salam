تابع ریشه:
    نام := "سلام"
    ناپایا شمار := 0
    شمار++
    نامها := ["الف", "ب", "پ"]
    هر ن در نامها:
        اگر ن نابرابر "ب":
            سرچاپ ن
        پایان
    پایان
    تکرار 2:
        چاپ "خ"
    پایان
    سرچاپ ""
    تکرار 1 تا 5 هر 2 در شاخص:
        اگر شاخص بزرگتر 2:
            چاپ "ز"
        پایان
    پایان
    سرچاپ ""
    ناپایا ک := 0
    تا ک کوچکتر 3:
        چاپ "و"
        ک++
    پایان
    سرچاپ ""
    اگر شمار برابر 1:
        سرچاپ نام
    پایان
پایان
