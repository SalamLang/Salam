روال ریشه:
    نام := "سلام"
    ناپایا شمار := 0
    شمار = شمار + 1
    نامها := ["الف", "ب", "پ"]
    هر ن از نامها:
        اگر ن != "ب":
            سرچاپ ن
        پایان
    پایان
    تکرار 2:
        چاپ "خ"
    پایان
    سرچاپ ""
    تکرار 1 تا 5 هر 2 از شاخص:
        اگر شاخص > 2:
            چاپ "ز"
        پایان
    پایان
    سرچاپ ""
    ناپایا ک := 0
    تا ک < 3:
        چاپ "و"
        ک = ک + 1
    پایان
    سرچاپ ""
    اگر شمار == 1:
        سرچاپ نام
    پایان
پایان
