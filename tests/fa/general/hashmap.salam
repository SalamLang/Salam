// زبان: فارسی
تابع اصلی:
    متغیر م := نگاشت {} بعنوان نگاشت<صحیح, رشته> م.درج(1, "یک")
    م.درج(2, "دو")
    چاپ م.بگیر(1), م.بگیر(2)
    چاپ م.دارد(2), م.دارد(9)
    چاپ م.اندازه()
تمام
