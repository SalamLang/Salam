روال ریشه:
    ناپایا م := نگاشت {} برگردان نگاشت<صحیح, رشته> م.درج(1, "یک")
    م.درج(2, "دو")
    سرچاپ م.بگیر(1), م.بگیر(2)
    سرچاپ م.دارد(2), م.دارد(9)
    سرچاپ م.اندازه()
