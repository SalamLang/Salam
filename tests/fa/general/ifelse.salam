روال طبقه(ن: صحیح): رشته:
    اگر ن >= 90:
        برگشت "الف"
    وگرنه ن >= 70:
        برگشت "ب"
    وگرنه:
        برگشت "ج"
    پایان
پایان

روال ریشه:
    سرچاپ طبقه(95)
    سرچاپ طبقه(75)
    سرچاپ طبقه(40)
پایان
