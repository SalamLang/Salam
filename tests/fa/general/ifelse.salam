// زبان: فارسی
تابع طبقه(ن: صحیح): رشته:
    اگر ن >= 90:
        بازگشت "الف"
    وگرنه ن >= 70:
        بازگشت "ب"
    وگرنه:
        بازگشت "ج"
    تمام
تمام

تابع اصلی:
    چاپ طبقه(95)
    چاپ طبقه(75)
    چاپ طبقه(40)
تمام
