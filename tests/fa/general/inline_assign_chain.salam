تابع اجرا(ف: تابع (صحیح)):
    ف(۴)
پایان

تابع ریشه:
    ناپایا جمع کل := ۰
    ناپایا الف := ۰
    ناپایا ب := ۰
    اجرا((م: صحیح): الف = م ب = الف جمع کل += ب سرچاپ الف، ب، جمع کل پایان)
    الف = ۱ ب = الف جمع کل = ب
    سرچاپ الف، ب، جمع کل
پایان
