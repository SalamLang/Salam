واردسازی تبدیل
واردسازی رشته
واردسازی کدگذاری.جیسون

ساختار دفتر:
    همگانی شناسه: طبیعی۶۴ = 0
    همگانی مانده: صحیح۶۴ = 0
    همگانی شمار: صحیح = 0
پایان

تابع نگهدار<الف>(مقدار: الف): الف:
    برگشت مقدار
پایان

تابع آمیختن(حاصل: طبیعی۶۴، مقدار: طبیعی۶۴): طبیعی۶۴:
    برگشت (حاصل ^ مقدار) * (1099511628211 برگردان طبیعی۶۴)
پایان

تابع کل(فهرست: وکتور<صحیح۶۴>): صحیح۶۴:
    ناپایا جمع := 0 برگردان صحیح۶۴
    هر مقدار در فهرست:
        جمع += مقدار
    پایان
    برگشت جمع
پایان

تابع گسترش(منفی: صحیح): صحیح۶۴:
    برگشت منفی
پایان

تابع ریشه:
    بیشینه := نگهدار(9223372036854775807 برگردان صحیح۶۴)
    کمینه := نگهدار(-9223372036854775807 برگردان صحیح۶۴) - (1 برگردان صحیح۶۴)
    سرچاپ بیشینه + (1 برگردان صحیح۶۴)، کمینه - (1 برگردان صحیح۶۴)، بیشینه * (2 برگردان صحیح۶۴)
    سرچاپ نگهدار(3037000500 برگردان صحیح۶۴) * نگهدار(3037000500 برگردان صحیح۶۴)
    عدد := نگهدار(9007199254740993 برگردان صحیح۶۴)
    سرچاپ عدد،
        عدد + (2 برگردان صحیح۶۴)،
        عدد برابر عدد - (1 برگردان صحیح۶۴)،
        عدد بزرگتر (9007199254740992 برگردان صحیح۶۴)
    سرچاپ کمینه / نگهدار(-1 برگردان صحیح۶۴)،
        کمینه % نگهدار(-1 برگردان صحیح۶۴)،
        نگهدار(-7 برگردان صحیح۶۴) / (2 برگردان صحیح۶۴)،
        نگهدار(-7 برگردان صحیح۶۴) % (2 برگردان صحیح۶۴)
    سقف := نگهدار(18446744073709551615 برگردان طبیعی۶۴)
    سرچاپ سقف،
        سقف + (1 برگردان طبیعی۶۴)،
        نگهدار(0 برگردان طبیعی۶۴) - (1 برگردان طبیعی۶۴)،
        سقف / (3 برگردان طبیعی۶۴)،
        سقف % (1000 برگردان طبیعی۶۴)
    یک := نگهدار(1 برگردان صحیح۶۴)
    سرچاپ یک << (63 برگردان صحیح۶۴)،
        (یک << (63 برگردان صحیح۶۴)) >> (3 برگردان صحیح۶۴)،
        سقف >> (1 برگردان طبیعی۶۴)،
        یک << نگهدار(65 برگردان صحیح۶۴)
    سرچاپ بیشینه & نگهدار(-256 برگردان صحیح۶۴)،
        بیشینه ^ نگهدار(81985529216486895 برگردان صحیح۶۴)،
        ~عدد،
        سقف ^ (12297829382473034410 برگردان طبیعی۶۴)
    ناپایا حاصل := نگهدار(14695981039346656037 برگردان طبیعی۶۴)
    تکرار 10 در شمارنده:
        حاصل = آمیختن(حاصل، شمارنده برگردان طبیعی۶۴)
    پایان
    سرچاپ حاصل
    منفی := نگهدار(-5)
    سرچاپ منفی برگردان طبیعی۶۴،
        منفی برگردان صحیح۶۴،
        گسترش(منفی)،
        بیشینه برگردان صحیح۳۲،
        سقف برگردان طبیعی۸،
        بیشینه برگردان اعشار۶۴،
        عدد برگردان اعشار۳۲
    سرچاپ نگهدار(1e19) برگردان صحیح۶۴،
        نگهدار(-1e19) برگردان صحیح۶۴،
        نگهدار(1e20) برگردان طبیعی۶۴،
        نگهدار(-1.0) برگردان طبیعی۶۴،
        نگهدار(0.0 / 0.0) برگردان صحیح۶۴
    سرچاپ نگهدار(4611686018427387904.0) برگردان صحیح۶۴،
        سقف برگردان صحیح۶۴،
        کمینه برگردان طبیعی۶۴،
        (سقف برگردان صحیح۱۲۸) + 1،
        (نگهدار(1 برگردان صحیح۱۲۸) << 70) برگردان صحیح۶۴
    سرچاپ "p=" + عدد، "u=" + سقف، تبدیل.قالب عدد(کمینه)، تبدیل.قالب عدد بی علامت(سقف)
    سرچاپ تبدیل.تجزیه عدد با پیش فرض("-9223372036854775808"، 0 برگردان صحیح۶۴)،
        تبدیل.تجزیه عدد با پیش فرض("9007199254740993"، 0 برگردان صحیح۶۴)
    ناپایا نقشه := نگاشت {} برگردان نگاشت<صحیح۶۴، رشته>
    نقشه.قراردادن(عدد، "odd")
    نقشه.قراردادن(عدد - (1 برگردان صحیح۶۴)، "even")
    سرچاپ نقشه.دریافت(9007199254740993 برگردان صحیح۶۴)،
        نقشه.دریافت(9007199254740992 برگردان صحیح۶۴)،
        نقشه.دارد(عدد + (1 برگردان صحیح۶۴))
    نقشه.آزادسازی()
    ناپایا فهرست := وکتور {} برگردان وکتور<صحیح۶۴>
    فهرست.افزودن(بیشینه)
    فهرست.افزودن(نگهدار(2 برگردان صحیح۶۴))
    فهرست.افزودن(عدد)
    سرچاپ کل(فهرست)، فهرست.دریافت(2) - فهرست.دریافت(1)
    فهرست.آزادسازی()
    آرایه := [1، 2، 3، 4]
    اندیس := نگهدار(2 برگردان صحیح۶۴)
    سرچاپ آرایه[اندیس]
    ناپایا انباشته := 0 برگردان صحیح۶۴
    تکرار عدد تا عدد + (3 برگردان صحیح۶۴) در گام:
        انباشته += گام % (10 برگردان صحیح۶۴)
    پایان
    سرچاپ انباشته
    سند := دفتر { شناسه = سقف - (5 برگردان طبیعی۶۴)، مانده = کمینه + (7 برگردان صحیح۶۴)، شمار = 3 }
    متن := جیسون.سریال سازی(سند)
    سرچاپ رشته.شامل است(متن، "18446744073709551610")، رشته.شامل است(متن، "-9223372036854775801")
    ناپایا بازگشته := دفتر {}
    تلاش:
        جیسون.واسریال سازی(متن، بازگشته)
    گرفتن خطا اشکال:
        سرچاپ "err"، اشکال.پیام
    پایان
    سرچاپ بازگشته.شناسه برابر سند.شناسه، بازگشته.مانده، بازگشته.شمار
    سرچاپ درهم(عدد) برابر درهم(نگهدار(9007199254740993 برگردان صحیح۶۴))،
        درهم(عدد) برابر درهم(عدد - (1 برگردان صحیح۶۴))
    سرچاپ درهم(نگهدار(42 برگردان صحیح۶۴))، درهم(نگهدار("salam"))
پایان
