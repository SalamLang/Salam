واردسازی کدگذاری.جیسون

روال ریشه:
    سرچاپ جیسون.رشته جیسون(`hi "there"`)
    سرچاپ جیسون.عضو("name", "salam")
    سرچاپ جیسون.عضو عدد("age", 5)
    سرچاپ جیسون.عضو منطقی("ok", درست)
    سرچاپ جیسون.عضو اعشار("pi", 3.5)
    سرچاپ جیسون.عضو خام("raw", "[1, 2, 3]")

    ناپایا برچسبها := وکتور {} برگردان وکتور<رشته> برچسبها.بیفزا(جیسون.رشته جیسون("a"))
    برچسبها.بیفزا(جیسون.رشته جیسون("b"))
    برچسبها_جیسون := جیسون.آرایه(برچسبها)
    سرچاپ برچسبها_جیسون

    ناپایا نقطه := وکتور {} برگردان وکتور<رشته> نقطه.بیفزا(جیسون.عضو عدد("x", 1))
    نقطه.بیفزا(جیسون.عضو عدد("y", 2))
    نقطه_جیسون := جیسون.شیء(نقطه)
    سرچاپ نقطه_جیسون

    ناپایا سند := وکتور {} برگردان وکتور<رشته> سند.بیفزا(جیسون.عضو("name", "salam"))
    سند.بیفزا(جیسون.عضو عدد("version", 2))
    سند.بیفزا(جیسون.عضو منطقی("active", درست))
    سند.بیفزا(جیسون.عضو خام("tags", برچسبها_جیسون))
    سند.بیفزا(جیسون.عضو خام("point", نقطه_جیسون))
    سند.بیفزا(جیسون.عضو خام("empty_obj", جیسون.شیء(وکتور {} برگردان وکتور<رشته>)))
    سند.بیفزا(جیسون.عضو خام("empty_arr", جیسون.آرایه(وکتور {} برگردان وکتور<رشته>)))
    سند_جیسون := جیسون.شیء(سند)
    سرچاپ سند_جیسون

    سرچاپ جیسون.معتبر(سند_جیسون)
    سرچاپ جیسون.معتبر("{ not valid")
    سرچاپ جیسون.دریافت(سند_جیسون, "name")
    سرچاپ جیسون.دریافت عدد(سند_جیسون, "version")
    سرچاپ جیسون.دارد(سند_جیسون, "active")
    سرچاپ جیسون.دارد(سند_جیسون, "missing")

    سرچاپ جیسون.تورفتگی(سند_جیسون)
    سرچاپ جیسون.تورفتگی سفارشی(سند_جیسون, "    ")
    سرچاپ جیسون.تورفتگی چهار(سند_جیسون)
    سرچاپ جیسون.تورفتگی تب(سند_جیسون)

    سرچاپ جیسون.فشرده سازی(جیسون.تورفتگی(سند_جیسون)) == جیسون.فشرده سازی(سند_جیسون)
پایان
