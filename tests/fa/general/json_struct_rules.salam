واردسازی کدگذاری.جیسون

ساختار ورود:
    همگانی کاربر: رشته = ""
    همگانی رمز: رشته = ""
    همگانی توکن: رشته = ""
    قاعده کاربر نیازمند رمز
    قاعده فقط یکی(کاربر، توکن)
پایان

تابع نشان(متن: رشته):
    ناپایا ر := ورود { توکن = "" }
    تلاش:
        جیسون.واسریال سازی(متن، ر)
        سرچاپ "درست"، ر.کاربر، ر.توکن
    گرفتن خطا خ:
        سرچاپ "خطا"، خ.پیام
    پایان
پایان

تابع ریشه:
    نشان(`{"توکن":"ت"}`)
    نشان(`{"کاربر":"ک"}`)
    نشان(`{}`)
پایان
