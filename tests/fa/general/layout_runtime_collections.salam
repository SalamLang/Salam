صفحه خلاصه(نام‌ها: وکتور<رشته>، سن‌ها: نگاشت<رشته، صحیح>):
    طراحی = "شد سی ان"
    عنوان = «تعداد: » + نام‌ها.طول()
    اگر نام‌ها.طول() برابر ۰:
        پاراگراف:
            محتوا = «هنوز کسی نیست»
        پایان
    وگرنه:
        پاراگراف:
            محتوا = نام‌ها.اول() + « تا » + نام‌ها.آخر() + « / دومی: » + نام‌ها.دریافت(۱)
        پایان
    پایان
    پاراگراف:
        محتوا = «شناخته: » + سن‌ها.اندازه() + «، سارا: » + سن‌ها.دارد(«سارا») + «، علی: » + سن‌ها.دریافت(«علی»)
    پایان
    فهرست:
        هر _، نام در نام‌ها:
            مورد:
                محتوا = نام
            پایان
        پایان
    پایان
پایان

تابع ریشه():
    ناپایا ها := وکتور {} برگردان وکتور<رشته>
    ناپایا سن := نگاشت {} برگردان نگاشت<رشته، صحیح>
    سن.قراردادن(
        «علی»، ۳۰
    )
    سرچاپ خلاصه(ها، سن)
    ها.بیفزا(«علی»)
    ها.بیفزا(«<سارا>»)
    سرچاپ خلاصه(ها، سن)
    ها.آزادکن()
    سن.آزادسازی()
پایان
