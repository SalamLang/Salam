بخش کارت ساده(عنوان: رشته، شمار: صحیح):
    جعبه:
        فاصله داخلی = 8px
        سرتیتر:
            اندازه = ۳
            محتوا = عنوان
        پایان
        پاراگراف:
            محتوا = «تعداد: » + شمار
        پایان
    پایان
پایان

صفحه صفحه‌ی کارت‌ها(نام: رشته):
    طراحی = "شد سی ان"
    عنوان = «کارت‌ها»
    کارت‌ساده:
        عنوان = «سلام » + نام
        شمار = ۷
    پایان
    کارت‌ساده:
        عنوان = «ثابت»
        شمار = ۱
    پایان
پایان

تابع ریشه():
    سرچاپ صفحه‌ی کارت‌ها(«سارا»)
    سرچاپ کارت ساده(«تنها»، ۳)
پایان
