واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.داخلی.سوکت خام
واردسازی تصادفی
واردسازی رشته
واردسازی زمان
واردسازی شبکه.تی سی پی

ناپایا درگاه وب := 0

صفحه خوشامد(نام: رشته، بازدید: صحیح):
    عنوان = «سلام » + نام
    سرتیتر: اندازه = ۱ محتوا = «سلام، » + نام پایان
    پاراگراف: محتوا = «بازدید شماره‌ی » + بازدید پایان
پایان

تابع خانه کن(زمینه: صحیح۶۴):
    نام := اچ تی تی پی.پرسمان(زمینه, «name»)
    اچ تی تی پی.اچ تی ام ال(زمینه, خوشامد(نام، ۱ + تصادفی.عدد کمتر از ان(۹) برگردان صحیح))
پایان

تابع اجرای وب():
    ناپایا راهبر := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(راهبر, «/», خانه کن)
    ناپایا کارساز := اچ تی تی پی.سرور جدید(درگاه وب)
    اچ تی تی پی.استفاده(کارساز, راهبر)
    اچ تی تی پی.اجرا(کارساز)
پایان

تابع درخواست(مسیر: رشته): رشته:
    ناپایا سوکت := سوکت خام.اتصال(«127.0.0.1», درگاه وب)
    ناپایا کوشش := 0 برگردان صحیح۶۴
    تا وارونه سوکت خام.معتبر(سوکت) و کوشش کوچکتر 200:
        زمان.خواب(10)
        سوکت = سوکت خام.اتصال(«127.0.0.1», درگاه وب)
        کوشش++
    پایان
    اگر وارونه سوکت خام.معتبر(سوکت):
        برگشت «»
    پایان
    سوکت خام.ارسال(سوکت, «GET » + مسیر + « HTTP/1.0\r\nHost: localhost\r\n\r\n»)
    ناپایا پاسخ := ""
    ناپایا تکه := سوکت خام.دریافت(سوکت, 65536)
    تا تکه نابرابر "":
        پاسخ += تکه
        تکه = سوکت خام.دریافت(سوکت, 65536)
    پایان
    سوکت خام.بستن(سوکت)
    برگشت پاسخ
پایان

تابع ریشه:
    درگاه وب = تی سی پی.درگاه آزاد()
    _نخ := نخ‌ساز(اجرای وب)
    پ۱ := درخواست(«/?name=Ali»)
    سرچاپ رشته.شامل است(پ۱، «text/html»)
    سرچاپ رشته.شامل است(پ۱، «<title>سلام Ali</title>»)
    سرچاپ رشته.شامل است(پ۱، «<h1>سلام، Ali</h1>»)
    پ۲ := درخواست(«/?name=%3Cscript%3E»)
    سرچاپ رشته.شامل است(پ۲، «&lt;script&gt;»)
    سرچاپ رشته.شامل است(پ۲، «<script>»)
پایان
