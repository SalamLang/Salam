واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.داخلی.سوکت خام
واردسازی تصادفی
واردسازی رشته
واردسازی زمان

چیدمان خوشامد(نام: رشته، بازدید: صحیح):
    عنوان = «سلام » + نام
    سرتیتر: اندازه = ۱ محتوا = «سلام، » + نام پایان
    پاراگراف: محتوا = «بازدید شماره‌ی » + بازدید پایان
پایان

روال خانه کن(زمینه: صحیح۶۴):
    نام := اچ تی تی پی.پرسمان زمینه(زمینه, «name»)
    اچ تی تی پی.اچ تی ام ال زمینه(زمینه, خوشامد(نام، ۱ + تصادفی.عدد کمتر از ان(۹) برگردان صحیح))
پایان

روال اجرای وب():
    ناپایا راهبر := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(راهبر, «/», خانه کن)
    ناپایا کارساز := اچ تی تی پی.سرور جدید(19242)
    اچ تی تی پی.استفاده(کارساز, راهبر)
    اچ تی تی پی.اجرا(کارساز)
پایان

روال درخواست(مسیر: رشته): رشته:
    ناپایا سوکت := سوکت خام.اتصال(«127.0.0.1», 19242)
    ناپایا تلاش := 0 برگردان صحیح۶۴
    تا وارونه سوکت خام.معتبر(سوکت) و تلاش < 200:
        زمان.خواب(10)
        سوکت = سوکت خام.اتصال(«127.0.0.1», 19242)
        تلاش = تلاش + 1
    پایان
    اگر وارونه سوکت خام.معتبر(سوکت):
        برگشت «»
    پایان
    سوکت خام.ارسال(سوکت, «GET » + مسیر + « HTTP/1.0\r\nHost: localhost\r\n\r\n»)
    پاسخ := سوکت خام.دریافت(سوکت, 8192)
    سوکت خام.بستن(سوکت)
    برگشت پاسخ
پایان

روال ریشه:
    _نخ := نخ‌ساز(اجرای وب)
    پ۱ := درخواست(«/?name=Ali»)
    سرچاپ رشته.شامل است(پ۱، «text/html»)
    سرچاپ رشته.شامل است(پ۱، «<title>سلام Ali</title>»)
    سرچاپ رشته.شامل است(پ۱، «<h1>سلام، Ali</h1>»)
    پ۲ := درخواست(«/?name=%3Cscript%3E»)
    سرچاپ رشته.شامل است(پ۲، «&lt;script&gt;»)
    سرچاپ رشته.شامل است(پ۲، «<script>»)
پایان
