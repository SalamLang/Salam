ساختار کتاب:
    همگانی page_layout: رشته = ""
    همگانی layouts: صحیح = 0
پایان

تابع layout_name(b: کتاب): رشته:
    برگشت b.page_layout + "/" + b.layouts
پایان

تابع ریشه():
    b := کتاب { page_layout = "grid", layouts = 3 }
    my_layout := layout_name(b)
    سرچاپ my_layout
پایان
