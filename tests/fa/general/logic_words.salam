تابع check(a: منطقی، b: منطقی): رشته:
    اگر a و b:
        برگشت "both"
    وگرنه a یا b:
        برگشت "one"
    پایان
    برگشت "none"
پایان

تابع ریشه:
    سرچاپ check(درست، درست)
    سرچاپ check(درست، نادرست)
    سرچاپ check(نادرست، نادرست)
    x := 5
    سرچاپ وارونه (x > 3)
    سرچاپ وارونه نادرست و x == 5
    سرچاپ x > 1 و x < 10 یا x == 100
    اگر وارونه سلام هسته:
        سرچاپ "hosted"
    پایان
پایان
