// Same input, dispatched two ways, to show the real difference between
// match and switch.

جداشمار سطح:
    کم،
    متوسط،
    زیاد
پایان

// match: an EXPRESSION. Every arm must produce a value, no fallthrough
// between arms, and (for an enum subject) every member must be covered
// or you get a non-exhaustive warning/error.
تابع برچسب(v: سطح): رشته:
    برگشت همخوان v:
        کم: "quiet" پایان
        متوسط: "normal" پایان
        زیاد: "loud" پایان
    پایان
پایان

تابع ریشه:
    سرچاپ برچسب(سطح.کم)
    سرچاپ برچسب(سطح.متوسط)
    سرچاپ برچسب(سطح.زیاد)

    // switch: a STATEMENT. Labels can be ranges and relational tests,
    // not just literal/enum values, and a case falls through into the
    // next one unless it 'break's.
    تکرار 4 در امتیاز:
        ترابرد امتیاز:
            0 تا 1:
                سرچاپ امتیاز، "-> low band"
            پایان
            2، 3:
                سرچاپ امتیاز، "-> mid band"
                بشکن
            پایان
            > 3:
                سرچاپ امتیاز، "-> high band"
            پایان
        پایان
    پایان

    // fallthrough in action: matching '1' also runs the '2' and '3'
    // bodies because none of them 'break'.
    ترابرد 1:
        1:
            سرچاپ "case 1"
        پایان
        2:
            سرچاپ "case 2 (fallthrough)"
        پایان
        3:
            سرچاپ "case 3 (fallthrough)"
            بشکن
        پایان
        4:
            سرچاپ "case 4 (never reached: case 3 broke)"
        پایان
    پایان
پایان
