واردسازی حافظه

ساختار Empty:
    همگانی تابع مقدار(): صحیح:
        برگشت 1
    پایان
پایان

تابع ریشه:
    ناپایا items := وکتور {} برگردان وکتور<Empty>
    تکرار 100:
        items.بیفزا(Empty {})
    پایان
    سرچاپ items.طول()، items[99].مقدار()
    a := حافظه.تخصیص حتمی(16 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    a[1] = 7
    سرچاپ a[1]
    b := حافظه.تخصیص صفرشده حتمی(16 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    سرچاپ b[1]
    ناپایا c := حافظه.بازتخصیص حتمی(پوچ، 8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    c[0] = 5
    c = حافظه.بازتخصیص حتمی(c برگردان تهی*، 64 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    سرچاپ c[0]
    حافظه.آزادسازی(a برگردان تهی*)
    حافظه.آزادسازی(b برگردان تهی*)
    freed := حافظه.بازتخصیص حتمی(c برگردان تهی*، 0 برگردان طبیعی۶۴)
    حافظه.آزادسازی(freed)
    سرچاپ "done"
پایان
