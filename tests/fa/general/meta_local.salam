پایا ده := 10

ساختار مربع:
    همگانی ضلع: صحیح = 0
    همگانی تابع مساحت(): صحیح: برگشت این.ضلع * این.ضلع پایان
پایان

تابع دوبرابر(ع: صحیح): صحیح: برگشت ع * 2 پایان

تابع ریشه:
    ناپایا م := مربع { ضلع = 5 }
    سرچاپ م.مساحت()
    سرچاپ دوبرابر(ده)
پایان
