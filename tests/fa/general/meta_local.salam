ثابت ده := 10

// زبان: فارسی
ساختار مربع:
    عمومی ضلع: صحیح = 0
    عمومی تابع مساحت(): صحیح: بازگشت این.ضلع * این.ضلع تمام
تمام

تابع دوبرابر(ع: صحیح): صحیح: بازگشت ع * 2 تمام

تابع اصلی:
    متغیر م := مربع { ضلع = 5 }
    چاپ م.مساحت()
    چاپ دوبرابر(ده)
تمام
