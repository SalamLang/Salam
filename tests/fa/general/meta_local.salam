پایدار ده := 10

ساختار مربع:
    همگانی ضلع: صحیح = 0
    همگانی کارکرد مساحت(): صحیح: بازگشت این.ضلع * این.ضلع پایان
پایان

کارکرد دوبرابر(ع: صحیح): صحیح: بازگشت ع * 2 پایان

کارکرد آغازین:
    گذرا م := مربع { ضلع = 5 }
    چاپ م.مساحت()
    چاپ دوبرابر(ده)
پایان
