// زبان: فارسی
ساختار نقطه:
    عمومی ایکس: صحیح = 0
    عمومی وای: صحیح = 0
    عمومی تابع جمع(): صحیح: بازگشت این.ایکس + این.وای تمام
تمام

تابع اصلی:
    متغیر ن := نقطه { ایکس = 3, وای = 4 }
    چاپ ن.ایکس
    چاپ ن.جمع()
    چاپ lang()
تمام
