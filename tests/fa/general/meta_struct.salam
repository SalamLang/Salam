ساختار نقطه:
    همگانی ایکس: صحیح = 0
    همگانی وای: صحیح = 0
    همگانی کارکرد جمع(): صحیح: بازگشت این.ایکس + این.وای پایان
پایان

کارکرد آغازین:
    گذرا ن := نقطه { ایکس = 3, وای = 4 }
    چاپ ن.ایکس
    چاپ ن.جمع()
    چاپ lang()
پایان
