ساختار نقطه:
    همگانی ایکس: صحیح = 0
    همگانی وای: صحیح = 0
    همگانی روال جمع(): صحیح: برگشت این.ایکس + این.وای پایان
پایان

روال ریشه:
    ناپایا ن := نقطه { ایکس = 3, وای = 4 }
    سرچاپ ن.ایکس
    سرچاپ ن.جمع()
    سرچاپ lang()
پایان
