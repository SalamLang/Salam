ساختار نقطه:
    همگانی افقی: صحیح
    همگانی عمودی: صحیح
پایان

روال ریشه:
    اعداد := [1, 2, 3]
    اعداد[0] = 10
    اعداد[1]++
    سرچاپ اعداد[0]
    سرچاپ اعداد[1]

    پ := نقطه { افقی = 1, عمودی = 2 }
    پ.افقی = 99
    سرچاپ پ.افقی

    ناپایا عدد := 5
    عدد = 6
    سرچاپ عدد

    پایا ث := [7, 8, 9]
    سرچاپ ث[2]
پایان
