بسته ریشه

واردسازی شبکه.دی‌ان‌اس

تابع ریشه:
    سرچاپ دی‌ان‌اس.جستجو("127.0.0.1")
    servers := دی‌ان‌اس.کارگزارهای پیش‌فرض()
    سرچاپ servers.طول() بزرگتر 0
    سرچاپ servers.بگیر(0).طول() بزرگتر 0

    msg := دی‌ان‌اس.پرسش از کارگزار("no.such.host.invalid"، "example.com"، دی‌ان‌اس.نوع آ، 100)
    سرچاپ msg.شناسه
    سرچاپ msg.پاسخ‌ها.رکوردها.طول()
    سرچاپ msg.پرسش‌ها.پرسش‌ها.طول()

    سرچاپ دی‌ان‌اس.جستجوی معکوس("not-an-ip").طول()
پایان
