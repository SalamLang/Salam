بسته ریشه

واردسازی کدگذاری
واردسازی محیط
واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی
واردسازی تی ال اس

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا درگاه ساده := 0
ناپایا درگاه امن := 0
ناپایا دستور ورود := ""
ناپایا دستور اواث := ""
ناپایا دستور خروج := ""

تابع برچسب دستور(دستور: رشته): رشته:
    جای فاصله := دستور.بیاب(" ")
    اگر جای فاصله کوچکتر 0: برگشت دستور پایان
    برگشت دستور.زیررشته(0، جای فاصله)
پایان

تابع کارساز ساده():
    سرور := تی سی پی.پیوند(0)
    درگاه ساده = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان
    c := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "* OK mock imap ready\r\n")
        دستور ورود = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، برچسب دستور(دستور ورود) + " OK LOGIN done\r\n")
        دستور اواث = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، برچسب دستور(دستور اواث) + " OK authenticated\r\n")
        دستور خروج = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "* BYE\r\n" + برچسب دستور(دستور خروج) + " OK LOGOUT done\r\n")
        تی سی پی.بستن(c)
    پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع کارساز امن():
    سرور := تی سی پی.پیوند(0)
    درگاه امن = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان
    پیکربندی := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    s := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(s):
        ناپایا پیوند امن := تی ال اس.پوشش کارساز(s.توصیفگر، پیکربندی)
        اگر تی ال اس.اتصال معتبر(پیوند امن):
            تی ال اس.نوشتن(پیوند امن، "* OK tls imap ready\r\n")
            دستور := تی ال اس.خواندن(پیوند امن، 4096)
            تی ال اس.نوشتن(پیوند امن، "* BYE\r\n" + برچسب دستور(دستور) + " OK LOGOUT done\r\n")
        پایان
        تی ال اس.بستن اتصال(پیوند امن)
    پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    نخ ساده := نخ‌ساز(کارساز ساده)
    نخ امن := نخ‌ساز(کارساز امن)
    همگام سازی.انتظار(آماده)

    ناپایا c := پست الکترونیک.اتصال آی‌مپ("127.0.0.1"، درگاه ساده)
    سرچاپ c.سالم
    سرچاپ پست الکترونیک.ورود(c، "ali"، "secret")
    سرچاپ پست الکترونیک.ورود ایکس‌اواث۲(c، "ali@example.com"، "tok123")
    پست الکترونیک.خروج آی‌مپ(c)
    نخ‌پیوند(نخ ساده)
    سرچاپ دستور ورود.بیاب("A1 LOGIN") برابر 0
    سرچاپ دستور اواث.بیاب("A2 AUTHENTICATE XOAUTH2 ") برابر 0
    بلوک := رشته.پیرایش(دستور اواث.زیررشته(24، دستور اواث.طول() - 24))
    تلاش:
        کدگشایی شده := کدگذاری.کدگشایی پایه۶۴(بلوک)
        سرچاپ کدگشایی شده.بیاب("user=ali@example.com") برابر 0
        سرچاپ کدگشایی شده.بیاب("auth=Bearer tok123") بزرگتر 0
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    سرچاپ دستور خروج.بیاب("A3 LOGOUT") برابر 0

    محیط.تنظیم("SSL_CERT_FILE"، CERT)
    ناپایا s := پست الکترونیک.اتصال امن آی‌مپ("127.0.0.1"، درگاه امن)
    سرچاپ s.سالم
    سرچاپ s.امن
    پست الکترونیک.خروج آی‌مپ(s)
    نخ‌پیوند(نخ امن)
پایان
