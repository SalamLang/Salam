بسته ریشه

واردسازی کدگذاری
واردسازی محیط
واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی
واردسازی تی ال اس

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا plain_port := 0
ناپایا tls_port := 0
ناپایا login_cmd := ""
ناپایا oauth_cmd := ""
ناپایا logout_cmd := ""

تابع tag_of(cmd: رشته): رشته:
    sp := cmd.بیاب(" ")
    اگر sp کوچکتر 0: برگشت cmd پایان
    برگشت cmd.زیررشته(0، sp)
پایان

تابع plain_server():
    srv := تی سی پی.پیوند(0)
    plain_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان
    c := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "* OK mock imap ready\r\n")
        login_cmd = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، tag_of(login_cmd) + " OK LOGIN done\r\n")
        oauth_cmd = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، tag_of(oauth_cmd) + " OK authenticated\r\n")
        logout_cmd = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "* BYE\r\n" + tag_of(logout_cmd) + " OK LOGOUT done\r\n")
        تی سی پی.بستن(c)
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع tls_server():
    srv := تی سی پی.پیوند(0)
    tls_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان
    scfg := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    s := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(s):
        ناپایا tc := تی ال اس.پوشش کارساز(s.توصیفگر، scfg)
        اگر تی ال اس.اتصال معتبر(tc):
            تی ال اس.نوشتن(tc، "* OK tls imap ready\r\n")
            cmd := تی ال اس.خواندن(tc، 4096)
            تی ال اس.نوشتن(tc، "* BYE\r\n" + tag_of(cmd) + " OK LOGOUT done\r\n")
        پایان
        تی ال اس.بستن اتصال(tc)
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    t1 := نخ‌ساز(plain_server)
    t2 := نخ‌ساز(tls_server)
    همگام سازی.انتظار(ready)

    ناپایا c := پست الکترونیک.اتصال آی‌مپ("127.0.0.1"، plain_port)
    سرچاپ c.سالم
    سرچاپ پست الکترونیک.ورود(c، "ali"، "secret")
    سرچاپ پست الکترونیک.ورود ایکس‌اواث۲(c، "ali@example.com"، "tok123")
    پست الکترونیک.خروج آی‌مپ(c)
    نخ‌پیوند(t1)
    سرچاپ login_cmd.بیاب("A1 LOGIN") برابر 0
    سرچاپ oauth_cmd.بیاب("A2 AUTHENTICATE XOAUTH2 ") برابر 0
    blob := رشته.پیرایش(oauth_cmd.زیررشته(24، oauth_cmd.طول() - 24))
    decoded := کدگذاری.کدگشایی پایه۶۴(blob)
    سرچاپ decoded.بیاب("user=ali@example.com") برابر 0
    سرچاپ decoded.بیاب("auth=Bearer tok123") بزرگتر 0
    سرچاپ logout_cmd.بیاب("A3 LOGOUT") برابر 0

    محیط.تنظیم("SSL_CERT_FILE"، CERT)
    ناپایا s := پست الکترونیک.اتصال امن آی‌مپ("127.0.0.1"، tls_port)
    سرچاپ s.سالم
    سرچاپ s.امن
    پست الکترونیک.خروج آی‌مپ(s)
    نخ‌پیوند(t2)
پایان
