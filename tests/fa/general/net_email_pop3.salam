بسته ریشه

واردسازی محیط
واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی همگام سازی
واردسازی تی ال اس

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا درگاه ساده := 0
ناپایا درگاه امن := 0
ناپایا دیده شده := ""

تابع کارساز ساده():
    سرور := تی سی پی.پیوند(0)
    درگاه ساده = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان
    c := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "+OK mock pop3 ready\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK 2 messages\r\n1 120\r\n2 340\r\n.\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK 120 octets\r\nSubject: hi\r\n\r\nbody line\r\n..dotted\r\n.\r\n")
        دیده شده = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK deleted\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK bye\r\n")
        تی سی پی.بستن(c)
    پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع کارساز امن():
    سرور := تی سی پی.پیوند(0)
    درگاه امن = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان
    پیکربندی := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    s := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(s):
        ناپایا پیوند امن := تی ال اس.پوشش کارساز(s.توصیفگر، پیکربندی)
        اگر تی ال اس.اتصال معتبر(پیوند امن):
            تی ال اس.نوشتن(پیوند امن، "+OK tls pop3 ready\r\n")
            تی ال اس.خواندن(پیوند امن، 4096)
            تی ال اس.نوشتن(پیوند امن، "+OK bye\r\n")
        پایان
        تی ال اس.بستن اتصال(پیوند امن)
    پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    نخ ساده := نخ‌ساز(کارساز ساده)
    نخ امن := نخ‌ساز(کارساز امن)
    همگام سازی.انتظار(آماده)

    ناپایا c := پست الکترونیک.اتصال پاپ۳("127.0.0.1"، درگاه ساده)
    سرچاپ c.سالم
    سرچاپ پست الکترونیک.کاربر(c، "ali")
    سرچاپ پست الکترونیک.گذرواژه(c، "secret")
    فهرست := پست الکترونیک.فهرست پیام‌های پاپ۳(c)
    سرچاپ فهرست.طول()
    سرچاپ فهرست.بگیر(0)
    سرچاپ فهرست.بگیر(1)
    پیام := پست الکترونیک.دریافت پیام پاپ۳(c، 1)
    سرچاپ پیام.بیاب("Subject: hi") برابر 0
    سرچاپ پیام.بیاب("\r\n.dotted") بزرگتر 0
    سرچاپ پست الکترونیک.حذف(c، 1)
    سرچاپ دیده شده.بیاب("DELE 1") برابر 0
    پست الکترونیک.خروج پاپ۳(c)
    نخ‌پیوند(نخ ساده)

    محیط.تنظیم("SSL_CERT_FILE"، CERT)
    ناپایا s := پست الکترونیک.اتصال امن پاپ۳("127.0.0.1"، درگاه امن)
    سرچاپ s.سالم
    سرچاپ s.امن
    پست الکترونیک.خروج پاپ۳(s)
    نخ‌پیوند(نخ امن)
پایان
