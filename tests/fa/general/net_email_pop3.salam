بسته ریشه

واردسازی محیط
واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی همگام سازی
واردسازی تی ال اس

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا plain_port := 0
ناپایا tls_port := 0
ناپایا seen := ""

تابع plain_server():
    srv := تی سی پی.پیوند(0)
    plain_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان
    c := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "+OK mock pop3 ready\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK 2 messages\r\n1 120\r\n2 340\r\n.\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK 120 octets\r\nSubject: hi\r\n\r\nbody line\r\n..dotted\r\n.\r\n")
        seen = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK deleted\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "+OK bye\r\n")
        تی سی پی.بستن(c)
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع tls_server():
    srv := تی سی پی.پیوند(0)
    tls_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان
    scfg := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    s := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(s):
        ناپایا tc := تی ال اس.پوشش کارساز(s.توصیفگر، scfg)
        اگر تی ال اس.اتصال معتبر(tc):
            تی ال اس.نوشتن(tc، "+OK tls pop3 ready\r\n")
            تی ال اس.خواندن(tc، 4096)
            تی ال اس.نوشتن(tc، "+OK bye\r\n")
        پایان
        تی ال اس.بستن اتصال(tc)
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    t1 := نخ‌ساز(plain_server)
    t2 := نخ‌ساز(tls_server)
    همگام سازی.انتظار(ready)

    ناپایا c := پست الکترونیک.اتصال پاپ۳("127.0.0.1"، plain_port)
    سرچاپ c.سالم
    سرچاپ پست الکترونیک.کاربر(c، "ali")
    سرچاپ پست الکترونیک.گذرواژه(c، "secret")
    items := پست الکترونیک.فهرست پیام‌های پاپ۳(c)
    سرچاپ items.طول()
    سرچاپ items.بگیر(0)
    سرچاپ items.بگیر(1)
    msg := پست الکترونیک.دریافت پیام پاپ۳(c، 1)
    سرچاپ msg.بیاب("Subject: hi") برابر 0
    سرچاپ msg.بیاب("\r\n.dotted") بزرگتر 0
    سرچاپ پست الکترونیک.حذف(c، 1)
    سرچاپ seen.بیاب("DELE 1") برابر 0
    پست الکترونیک.خروج پاپ۳(c)
    نخ‌پیوند(t1)

    محیط.تنظیم("SSL_CERT_FILE"، CERT)
    ناپایا s := پست الکترونیک.اتصال امن پاپ۳("127.0.0.1"، tls_port)
    سرچاپ s.سالم
    سرچاپ s.امن
    پست الکترونیک.خروج پاپ۳(s)
    نخ‌پیوند(t2)
پایان
