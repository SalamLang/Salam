بسته ریشه

واردسازی کدگذاری
واردسازی محیط
واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی
واردسازی تی ال اس

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا درگاه احراز := 0
ناپایا درگاه استارت تی ال اس := 0
ناپایا درگاه امن := 0
ناپایا خط کاربر := ""
ناپایا خط گذرواژه := ""
ناپایا خط اواث := ""

تابع کارساز احراز():
    سرور := تی سی پی.پیوند(0)
    درگاه احراز = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان
    c := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "220 mock.smtp ready\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "250-mock.smtp\r\n250 AUTH LOGIN XOAUTH2\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "334 VXNlcm5hbWU6\r\n")
        خط کاربر = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "334 UGFzc3dvcmQ6\r\n")
        خط گذرواژه = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "235 Authentication successful\r\n")
        خط اواث = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "235 Authentication successful\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "221 bye\r\n")
        تی سی پی.بستن(c)
    پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع کارساز استارت تی ال اس():
    سرور := تی سی پی.پیوند(0)
    درگاه استارت تی ال اس = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان
    پیکربندی := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    c := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "220 mock.smtp ready\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "250-mock.smtp\r\n250 STARTTLS\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "220 go ahead\r\n")
        ناپایا پیوند امن := تی ال اس.پوشش کارساز(c.توصیفگر، پیکربندی)
        اگر تی ال اس.اتصال معتبر(پیوند امن):
            تی ال اس.خواندن(پیوند امن، 4096)
            تی ال اس.نوشتن(پیوند امن، "250 mock.smtp again\r\n")
            تی ال اس.خواندن(پیوند امن، 4096)
            تی ال اس.نوشتن(پیوند امن، "221 bye\r\n")
        پایان
        تی ال اس.بستن اتصال(پیوند امن)
    پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع کارساز امن():
    سرور := تی سی پی.پیوند(0)
    درگاه امن = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان
    پیکربندی := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    s := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(s):
        ناپایا پیوند امن := تی ال اس.پوشش کارساز(s.توصیفگر، پیکربندی)
        اگر تی ال اس.اتصال معتبر(پیوند امن):
            تی ال اس.نوشتن(پیوند امن، "220 tls.smtp ready\r\n")
            تی ال اس.خواندن(پیوند امن، 4096)
            تی ال اس.نوشتن(پیوند امن، "221 bye\r\n")
        پایان
        تی ال اس.بستن اتصال(پیوند امن)
    پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع کدگشایی متن(s: رشته): رشته:
    تلاش:
        برگشت کدگذاری.کدگشایی پایه۶۴(s)
    گرفتن خطا e:
        برگشت e.به رشته()
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 3 برگردان صحیح۶۴)
    نخ احراز := نخ‌ساز(کارساز احراز)
    نخ استارت := نخ‌ساز(کارساز استارت تی ال اس)
    نخ امن := نخ‌ساز(کارساز امن)
    همگام سازی.انتظار(آماده)

    ناپایا a := پست الکترونیک.اتصال اس‌ام‌تی‌پی("127.0.0.1"، درگاه احراز)
    سرچاپ a.سالم
    سرچاپ پست الکترونیک.سلام(a، "client.example")
    سرچاپ پست الکترونیک.ورود با احراز هویت(a، "ali"، "secret")
    سرچاپ کدگشایی متن(رشته.پیرایش(خط کاربر))
    سرچاپ کدگشایی متن(رشته.پیرایش(خط گذرواژه))
    سرچاپ پست الکترونیک.احراز هویت ایکس‌اواث۲(a، "ali@example.com"، "tok123")
    سرچاپ خط اواث.بیاب("AUTH XOAUTH2 ") برابر 0
    کدگشایی شده := کدگشایی متن(رشته.پیرایش(خط اواث.زیررشته(13، خط اواث.طول() - 13)))
    سرچاپ کدگشایی شده.بیاب("user=ali@example.com") برابر 0
    سرچاپ کدگشایی شده.بیاب("auth=Bearer tok123") بزرگتر 0
    پست الکترونیک.خروج اس‌ام‌تی‌پی(a)
    نخ‌پیوند(نخ احراز)

    محیط.تنظیم("SSL_CERT_FILE"، CERT)
    ناپایا b := پست الکترونیک.اتصال اس‌ام‌تی‌پی("127.0.0.1"، درگاه استارت تی ال اس)
    سرچاپ b.سالم
    سرچاپ b.امن
    سرچاپ پست الکترونیک.سلام(b، "client.example")
    سرچاپ پست الکترونیک.شروع تی‌ال‌اس(b، "127.0.0.1")
    سرچاپ b.امن
    سرچاپ پست الکترونیک.سلام(b، "client.example")
    پست الکترونیک.خروج اس‌ام‌تی‌پی(b)
    نخ‌پیوند(نخ استارت)

    ناپایا s := پست الکترونیک.اتصال امن اس‌ام‌تی‌پی("127.0.0.1"، درگاه امن)
    سرچاپ s.سالم
    سرچاپ s.امن
    پست الکترونیک.خروج اس‌ام‌تی‌پی(s)
    نخ‌پیوند(نخ امن)
پایان
