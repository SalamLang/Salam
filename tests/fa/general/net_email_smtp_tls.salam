بسته ریشه

واردسازی کدگذاری
واردسازی محیط
واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی
واردسازی تی ال اس

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا auth_port := 0
ناپایا starttls_port := 0
ناپایا tls_port := 0
ناپایا user_line := ""
ناپایا pass_line := ""
ناپایا oauth_line := ""

تابع auth_server():
    srv := تی سی پی.پیوند(0)
    auth_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان
    c := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "220 mock.smtp ready\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "250-mock.smtp\r\n250 AUTH LOGIN XOAUTH2\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "334 VXNlcm5hbWU6\r\n")
        user_line = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "334 UGFzc3dvcmQ6\r\n")
        pass_line = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "235 Authentication successful\r\n")
        oauth_line = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "235 Authentication successful\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "221 bye\r\n")
        تی سی پی.بستن(c)
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع starttls_server():
    srv := تی سی پی.پیوند(0)
    starttls_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان
    scfg := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    c := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "220 mock.smtp ready\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "250-mock.smtp\r\n250 STARTTLS\r\n")
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "220 go ahead\r\n")
        ناپایا tc := تی ال اس.پوشش کارساز(c.توصیفگر، scfg)
        اگر تی ال اس.اتصال معتبر(tc):
            تی ال اس.خواندن(tc، 4096)
            تی ال اس.نوشتن(tc، "250 mock.smtp again\r\n")
            تی ال اس.خواندن(tc، 4096)
            تی ال اس.نوشتن(tc، "221 bye\r\n")
        پایان
        تی ال اس.بستن اتصال(tc)
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع tls_server():
    srv := تی سی پی.پیوند(0)
    tls_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان
    scfg := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    s := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(s):
        ناپایا tc := تی ال اس.پوشش کارساز(s.توصیفگر، scfg)
        اگر تی ال اس.اتصال معتبر(tc):
            تی ال اس.نوشتن(tc، "220 tls.smtp ready\r\n")
            تی ال اس.خواندن(tc، 4096)
            تی ال اس.نوشتن(tc، "221 bye\r\n")
        پایان
        تی ال اس.بستن اتصال(tc)
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 3 برگردان صحیح۶۴)
    t1 := نخ‌ساز(auth_server)
    t2 := نخ‌ساز(starttls_server)
    t3 := نخ‌ساز(tls_server)
    همگام سازی.انتظار(ready)

    ناپایا a := پست الکترونیک.اتصال اس‌ام‌تی‌پی("127.0.0.1"، auth_port)
    سرچاپ a.سالم
    سرچاپ پست الکترونیک.سلام(a، "client.example")
    سرچاپ پست الکترونیک.ورود با احراز هویت(a، "ali"، "secret")
    سرچاپ کدگذاری.کدگشایی پایه۶۴(رشته.پیرایش(user_line))
    سرچاپ کدگذاری.کدگشایی پایه۶۴(رشته.پیرایش(pass_line))
    سرچاپ پست الکترونیک.احراز هویت ایکس‌اواث۲(a، "ali@example.com"، "tok123")
    سرچاپ oauth_line.بیاب("AUTH XOAUTH2 ") برابر 0
    decoded := کدگذاری.کدگشایی پایه۶۴(رشته.پیرایش(oauth_line.زیررشته(13، oauth_line.طول() - 13)))
    سرچاپ decoded.بیاب("user=ali@example.com") برابر 0
    سرچاپ decoded.بیاب("auth=Bearer tok123") بزرگتر 0
    پست الکترونیک.خروج اس‌ام‌تی‌پی(a)
    نخ‌پیوند(t1)

    محیط.تنظیم("SSL_CERT_FILE"، CERT)
    ناپایا b := پست الکترونیک.اتصال اس‌ام‌تی‌پی("127.0.0.1"، starttls_port)
    سرچاپ b.سالم
    سرچاپ b.امن
    سرچاپ پست الکترونیک.سلام(b، "client.example")
    سرچاپ پست الکترونیک.شروع تی‌ال‌اس(b، "127.0.0.1")
    سرچاپ b.امن
    سرچاپ پست الکترونیک.سلام(b، "client.example")
    پست الکترونیک.خروج اس‌ام‌تی‌پی(b)
    نخ‌پیوند(t2)

    ناپایا s := پست الکترونیک.اتصال امن اس‌ام‌تی‌پی("127.0.0.1"، tls_port)
    سرچاپ s.سالم
    سرچاپ s.امن
    پست الکترونیک.خروج اس‌ام‌تی‌پی(s)
    نخ‌پیوند(t3)
پایان
