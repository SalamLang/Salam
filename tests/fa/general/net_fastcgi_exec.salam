بسته ریشه

واردسازی حافظه
واردسازی شبکه.فست سی جی آی
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا fcgi_port := 0

تابع _rd8(p: تهی*، off: صحیح): صحیح:
    bp := p برگردان طبیعی۸ *
    برگشت bp[off] برگردان صحیح
پایان

تابع _at(p: تهی*، off: صحیح): تهی*:
    برگشت ((p برگردان صحیح۶۴) + (off برگردان صحیح۶۴)) برگردان تهی *
پایان

تابع _read_exact(c: تی سی پی.اتصال شبکه، p: تهی*، n: صحیح): صحیح:
    ناپایا got := 0
    تا got کوچکتر n:
        k := تی سی پی.خواندن بایت(c، _at(p، got)، n - got)
        اگر k کوچکتربرابر 0: برگشت got پایان
        got += k
    پایان
    برگشت got
پایان

تابع _bytes_str(p: تهی*، off: صحیح، n: صحیح): رشته:
    ناپایا sb := رشته.سازنده()
    تکرار n در i:
        رشته.افزودن نویسه به بافر(sb، _rd8(p، off + i))
    پایان
    r := رشته.رشته بافر(sb)
    رشته.آزادسازی بافر(sb)
    برگشت r
پایان

تابع _param_value(p: تهی*، total: صحیح، want: رشته): رشته:
    ناپایا cur := 0
    تا cur کوچکتر total:
        nl := _rd8(p، cur)
        vl := _rd8(p، cur + 1)
        cur += 2
        name := _bytes_str(p، cur، nl)
        cur += nl
        value := _bytes_str(p، cur، vl)
        cur += vl
        اگر رشته.یکسان است(name، want): برگشت value پایان
    پایان
    برگشت ""
پایان

تابع _send_rec(c: تی سی پی.اتصال شبکه، typ: صحیح، p: تهی*، n: صحیح):
    h := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    bp := h برگردان طبیعی۸ *
    bp[0] = 1 برگردان طبیعی۸
    bp[1] = typ برگردان طبیعی۸
    bp[2] = 0 برگردان طبیعی۸
    bp[3] = 1 برگردان طبیعی۸
    bp[4] = ((n >> 8) & 255) برگردان طبیعی۸
    bp[5] = (n & 255) برگردان طبیعی۸
    bp[6] = 0 برگردان طبیعی۸
    bp[7] = 0 برگردان طبیعی۸
    تی سی پی.نوشتن بایت(c، h، 8)
    اگر n بزرگتر 0: تی سی پی.نوشتن بایت(c، p، n) پایان
    حافظه.آزادسازی(h)
پایان

تابع _handle(c: تی سی پی.اتصال شبکه):
    hdr := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    pbuf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    body := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    ناپایا plen := 0
    ناپایا blen := 0
    ناپایا done := نادرست
    تا وارونه done:
        اگر _read_exact(c، hdr، 8) نابرابر 8: بشکن پایان
        typ := _rd8(hdr، 1)
        rec_len := (_rd8(hdr، 4) << 8) | _rd8(hdr، 5)
        pad := _rd8(hdr، 6)
        اگر rec_len بزرگتر 0:
            tmp := حافظه.تخصیص(rec_len برگردان طبیعی۶۴)
            _read_exact(c، tmp، rec_len)
            اگر typ برابر 4:
                حافظه.کپی(_at(pbuf، plen)، tmp، rec_len برگردان طبیعی۶۴)
                plen += rec_len
            وگرنه typ برابر 5:
                حافظه.کپی(_at(body، blen)، tmp، rec_len برگردان طبیعی۶۴)
                blen += rec_len
            پایان
            حافظه.آزادسازی(tmp)
        پایان
        اگر pad بزرگتر 0:
            skip := حافظه.تخصیص(pad برگردان طبیعی۶۴)
            _read_exact(c، skip، pad)
            حافظه.آزادسازی(skip)
        پایان
        اگر typ برابر 5 و rec_len برابر 0: done = درست پایان
    پایان
    method := _param_value(pbuf، plen، "REQUEST_METHOD")
    script := _param_value(pbuf، plen، "SCRIPT_NAME")
    sent := _bytes_str(body، 0، blen)
    head := "Status: 201 Created\r\nContent-Type: text/plain\r\nX-Fcgi: yes\r\n\r\n"
    payload := head + "method=" + method + ";script=" + script + ";body=" + sent
    warn := "warning\n"
    _send_rec(c، 7، warn برگردان تهی *، warn.طول())
    _send_rec(c، 6، payload برگردان تهی *، payload.طول())
    endrec := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    _send_rec(c، 3، endrec، 8)
    حافظه.آزادسازی(endrec)
    حافظه.آزادسازی(hdr)
    حافظه.آزادسازی(pbuf)
    حافظه.آزادسازی(body)
پایان

تابع backend():
    srv := تی سی پی.پیوند(0)
    fcgi_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان
    c1 := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(c1):
        _handle(c1)
        تی سی پی.بستن(c1)
    پایان
    c2 := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(c2): تی سی پی.بستن(c2) پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(backend)
    همگام سازی.انتظار(ready)

    ناپایا params := فست سی جی آی.پارامترهای جدید()
    فست سی جی آی.افزودن(params، "REQUEST_METHOD"، "POST")
    فست سی جی آی.افزودن(params، "SCRIPT_NAME"، "/app.php")
    سرچاپ params.آیتم ها.طول()

    c := فست سی جی آی.اتصال("127.0.0.1"، fcgi_port، 3000)
    سرچاپ تی سی پی.اتصال معتبر(c)
    payload := "name=ali"
    ناپایا r := فست سی جی آی.اجرا(c، params، payload برگردان تهی *، payload.طول()، 3000)
    سرچاپ r.موفق
    سرچاپ r.وضعیت
    سرچاپ r.اندازه
    سرچاپ r.سرصفحه ها.طول()
    سرچاپ _bytes_str(r.بدنه، 0، r.اندازه)
    سرچاپ r.سرصفحه ها.بگیر(0).نام
    سرچاپ r.سرصفحه ها.بگیر(1).مقدار
    فست سی جی آی.آزادسازی پاسخ(r)
    سرچاپ r.اندازه
    تی سی پی.بستن(c)

    c2 := فست سی جی آی.اتصال("127.0.0.1"، fcgi_port، 3000)
    ناپایا r2 := فست سی جی آی.اجرا(c2، params، پوچ، 0، 3000)
    سرچاپ r2.موفق
    سرچاپ r2.خطا.طول() > 0
    فست سی جی آی.آزادسازی پاسخ(r2)
    تی سی پی.بستن(c2)

    ناپایا r3 := فست سی جی آی.اجرا(تی سی پی.اتصال شبکه {}، params، پوچ، 0، 100)
    سرچاپ r3.موفق
    سرچاپ r3.خطا
    فست سی جی آی.آزادسازی پاسخ(r3)

    فست سی جی آی.آزادسازی(params)
    نخ‌پیوند(t)
پایان
