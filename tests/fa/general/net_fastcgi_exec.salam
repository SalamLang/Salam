بسته ریشه

واردسازی حافظه
واردسازی شبکه.فست سی جی آی
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی

ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا درگاه اف سی جی آی := 0

تابع _rd8(p: تهی*، جابجایی: صحیح): صحیح:
    بافر بایت := p برگردان طبیعی۸ *
    برگشت بافر بایت[جابجایی] برگردان صحیح
پایان

تابع _at(p: تهی*، جابجایی: صحیح): تهی*:
    برگشت ((p برگردان صحیح۶۴) + (جابجایی برگردان صحیح۶۴)) برگردان تهی *
پایان

تابع _read_exact(c: تی سی پی.اتصال شبکه، p: تهی*، n: صحیح): صحیح:
    ناپایا خوانده شده := 0
    تا خوانده شده کوچکتر n:
        k := تی سی پی.خواندن بایت(c، _at(p، خوانده شده)، n - خوانده شده)
        اگر k کوچکتربرابر 0: برگشت خوانده شده پایان
        خوانده شده += k
    پایان
    برگشت خوانده شده
پایان

تابع _bytes_str(p: تهی*، جابجایی: صحیح، n: صحیح): رشته:
    ناپایا سازنده متن := رشته.سازنده()
    تکرار n در i:
        رشته.افزودن نویسه به بافر(سازنده متن، _rd8(p، جابجایی + i))
    پایان
    r := رشته.رشته بافر(سازنده متن)
    رشته.آزادسازی بافر(سازنده متن)
    برگشت r
پایان

تابع _param_value(p: تهی*، جمع: صحیح، مطلوب: رشته): رشته:
    ناپایا جایگاه := 0
    تا جایگاه کوچکتر جمع:
        طول نام := _rd8(p، جایگاه)
        طول مقدار := _rd8(p، جایگاه + 1)
        جایگاه += 2
        نام := _bytes_str(p، جایگاه، طول نام)
        جایگاه += طول نام
        مقدار := _bytes_str(p، جایگاه، طول مقدار)
        جایگاه += طول مقدار
        اگر رشته.یکسان است(نام، مطلوب): برگشت مقدار پایان
    پایان
    برگشت ""
پایان

تابع _send_rec(c: تی سی پی.اتصال شبکه، نوع: صحیح، p: تهی*، n: صحیح):
    h := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    بافر بایت := h برگردان طبیعی۸ *
    بافر بایت[0] = 1 برگردان طبیعی۸
    بافر بایت[1] = نوع برگردان طبیعی۸
    بافر بایت[2] = 0 برگردان طبیعی۸
    بافر بایت[3] = 1 برگردان طبیعی۸
    بافر بایت[4] = ((n >> 8) & 255) برگردان طبیعی۸
    بافر بایت[5] = (n & 255) برگردان طبیعی۸
    بافر بایت[6] = 0 برگردان طبیعی۸
    بافر بایت[7] = 0 برگردان طبیعی۸
    تی سی پی.نوشتن بایت(c، h، 8)
    اگر n بزرگتر 0: تی سی پی.نوشتن بایت(c، p، n) پایان
    حافظه.آزادسازی(h)
پایان

تابع _handle(c: تی سی پی.اتصال شبکه):
    سرآیند رکورد := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    بافر پارامتر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    بدنه := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    ناپایا طول پارامتر := 0
    ناپایا طول بدنه := 0
    ناپایا تمام شده := نادرست
    تا وارونه تمام شده:
        اگر _read_exact(c، سرآیند رکورد، 8) نابرابر 8: بشکن پایان
        نوع := _rd8(سرآیند رکورد، 1)
        طول رکورد := (_rd8(سرآیند رکورد، 4) << 8) | _rd8(سرآیند رکورد، 5)
        طول حاشیه := _rd8(سرآیند رکورد، 6)
        اگر طول رکورد بزرگتر 0:
            موقت := حافظه.تخصیص(طول رکورد برگردان طبیعی۶۴)
            _read_exact(c، موقت، طول رکورد)
            اگر نوع برابر 4:
                حافظه.کپی(_at(بافر پارامتر، طول پارامتر)، موقت، طول رکورد برگردان طبیعی۶۴)
                طول پارامتر += طول رکورد
            وگرنه نوع برابر 5:
                حافظه.کپی(_at(بدنه، طول بدنه)، موقت، طول رکورد برگردان طبیعی۶۴)
                طول بدنه += طول رکورد
            پایان
            حافظه.آزادسازی(موقت)
        پایان
        اگر طول حاشیه بزرگتر 0:
            پرش := حافظه.تخصیص(طول حاشیه برگردان طبیعی۶۴)
            _read_exact(c، پرش، طول حاشیه)
            حافظه.آزادسازی(پرش)
        پایان
        اگر نوع برابر 5 و طول رکورد برابر 0: تمام شده = درست پایان
    پایان
    روش := _param_value(بافر پارامتر، طول پارامتر، "REQUEST_METHOD")
    اسکریپت := _param_value(بافر پارامتر، طول پارامتر، "SCRIPT_NAME")
    ارسال شده := _bytes_str(بدنه، 0، طول بدنه)
    سرآیند پاسخ := "Status: 201 Created\r\nContent-Type: text/plain\r\nX-Fcgi: yes\r\n\r\n"
    بار := سرآیند پاسخ + "method=" + روش + ";script=" + اسکریپت + ";body=" + ارسال شده
    هشدار := "warning\n"
    _send_rec(c، 7، هشدار برگردان تهی *، هشدار.طول())
    _send_rec(c، 6، بار برگردان تهی *، بار.طول())
    رکورد انتهایی := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    _send_rec(c، 3، رکورد انتهایی، 8)
    حافظه.آزادسازی(رکورد انتهایی)
    حافظه.آزادسازی(سرآیند رکورد)
    حافظه.آزادسازی(بافر پارامتر)
    حافظه.آزادسازی(بدنه)
پایان

تابع کارساز پشتیبان():
    سرور := تی سی پی.پیوند(0)
    درگاه اف سی جی آی = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان
    اتصال اول := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(اتصال اول):
        _handle(اتصال اول)
        تی سی پی.بستن(اتصال اول)
    پایان
    اتصال دوم := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(اتصال دوم): تی سی پی.بستن(اتصال دوم) پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(کارساز پشتیبان)
    همگام سازی.انتظار(آماده)

    ناپایا پارامترها := فست سی جی آی.پارامترهای جدید()
    فست سی جی آی.افزودن(پارامترها، "REQUEST_METHOD"، "POST")
    فست سی جی آی.افزودن(پارامترها، "SCRIPT_NAME"، "/app.php")
    سرچاپ پارامترها.آیتم ها.طول()

    c := فست سی جی آی.اتصال("127.0.0.1"، درگاه اف سی جی آی، 3000)
    سرچاپ تی سی پی.اتصال معتبر(c)
    بار := "name=ali"
    ناپایا r := فست سی جی آی.اجرا(c، پارامترها، بار برگردان تهی *، بار.طول()، 3000)
    سرچاپ r.موفق
    سرچاپ r.وضعیت
    سرچاپ r.اندازه
    سرچاپ r.سرصفحه ها.طول()
    سرچاپ _bytes_str(r.بدنه، 0، r.اندازه)
    سرچاپ r.سرصفحه ها.بگیر(0).نام
    سرچاپ r.سرصفحه ها.بگیر(1).مقدار
    فست سی جی آی.آزادسازی پاسخ(r)
    سرچاپ r.اندازه
    تی سی پی.بستن(c)

    اتصال دوم := فست سی جی آی.اتصال("127.0.0.1"، درگاه اف سی جی آی، 3000)
    ناپایا نتیجه دوم := فست سی جی آی.اجرا(اتصال دوم، پارامترها، پوچ، 0، 3000)
    سرچاپ نتیجه دوم.موفق
    سرچاپ نتیجه دوم.خطا.طول() > 0
    فست سی جی آی.آزادسازی پاسخ(نتیجه دوم)
    تی سی پی.بستن(اتصال دوم)

    ناپایا نتیجه سوم := فست سی جی آی.اجرا(تی سی پی.اتصال شبکه {}، پارامترها، پوچ، 0، 100)
    سرچاپ نتیجه سوم.موفق
    سرچاپ نتیجه سوم.خطا
    فست سی جی آی.آزادسازی پاسخ(نتیجه سوم)

    فست سی جی آی.آزادسازی(پارامترها)
    نخ‌پیوند(t)
پایان
