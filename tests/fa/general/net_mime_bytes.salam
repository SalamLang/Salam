بسته ریشه

واردسازی فشرده سازی
واردسازی کدگذاری.دودویی
واردسازی شبکه.مایم

تابع ریشه:
    ناپایا raw := فشرده سازی.بافر بایت جدید()
    دودویی.نوشتن طبیعی۸(raw، 0)
    دودویی.نوشتن طبیعی۸(raw، 255)
    دودویی.نوشتن طبیعی۸(raw، 10)
    دودویی.نوشتن طبیعی۸(raw، 0)
    دودویی.نوشتن طبیعی۸(raw، 7)

    ناپایا w := مایم.نویسنده چندبخشی جدید()
    مایم.نوشتن پرونده(w، "blob"، "data.bin"، "application/x-custom"، raw.داده، raw.طول)
    مایم.نوشتن پرونده(w، "pic"، "photo.png"، ""، raw.داده، 3)
    body := مایم.بستن نویسنده(w)

    parts := مایم.تجزیه چندبخشی(body.داده، body.طول، w.مرز)
    سرچاپ parts.اقلام.طول()
    p0 := parts.اقلام.بگیر(0)
    سرچاپ p0.نام
    سرچاپ p0.نام پرونده
    سرچاپ p0.نوع محتوا
    سرچاپ p0.بدنه.طول
    سرچاپ فشرده سازی.دریافت بایت(p0.بدنه، 0)
    سرچاپ فشرده سازی.دریافت بایت(p0.بدنه، 1)
    سرچاپ فشرده سازی.دریافت بایت(p0.بدنه، 3)
    سرچاپ فشرده سازی.دریافت بایت(p0.بدنه، 4)
    p1 := parts.اقلام.بگیر(1)
    سرچاپ p1.نام
    سرچاپ p1.نام پرونده
    سرچاپ p1.نوع محتوا
    سرچاپ p1.بدنه.طول
    سرچاپ فشرده سازی.دریافت بایت(p1.بدنه، 1)
پایان
