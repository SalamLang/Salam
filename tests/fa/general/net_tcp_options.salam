بسته ریشه

واردسازی محیط
واردسازی شبکه.تی سی پی
واردسازی همگام سازی
واردسازی تی ال اس

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا درگاه := 0

تابع کارساز():
    سرور := تی سی پی.پیوند(0)
    درگاه = تی سی پی.درگاه(سرور)
    همگام سازی.اتمام(آماده)
    اگر وارونه تی سی پی.معتبر(سرور): برگشت پایان

    c := تی سی پی.پذیرش(سرور)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 1024))
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 1024))
        تی سی پی.خواندن(c، 1024)
        تی سی پی.بستن(c)
    پایان

    پیکربندی سرور := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    تکرار 2:
        s := تی سی پی.پذیرش(سرور)
        اگر تی سی پی.اتصال معتبر(s):
            ناپایا اتصال امن := تی ال اس.پوشش کارساز(s.توصیفگر، پیکربندی سرور)
            اگر تی ال اس.اتصال معتبر(اتصال امن):
                تی ال اس.نوشتن(اتصال امن، "tls:" + تی ال اس.خواندن(اتصال امن، 1024))
            پایان
            تی ال اس.بستن اتصال(اتصال امن)
        پایان
    پایان
    تی سی پی.بستن سرور(سرور)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(کارساز)
    همگام سازی.انتظار(آماده)

    c := تی سی پی.شماره گیری با مهلت("127.0.0.1"، درگاه، 2000)
    سرچاپ تی سی پی.اتصال معتبر(c)
    تی سی پی.تنظیم زنده‌نگه‌داری(c، درست)
    تی سی پی.غیرفعال‌سازی نگل(c، درست)
    تی سی پی.تنظیم مهلت نوشتن(c، 2000)
    تی سی پی.تنظیم مهلت(c، 2000)

    تی سی پی.نوشتن(c، "one")
    سرچاپ تی سی پی.خواندن(c، 1024)

    همان := تی سی پی.اتصال از توصیف‌گر(c.توصیفگر)
    سرچاپ همان.توصیفگر برابر c.توصیفگر
    سرچاپ تی سی پی.اتصال معتبر(همان)
    تی سی پی.نوشتن(همان، "two")
    سرچاپ تی سی پی.خواندن(c، 1024)

    ناپایا استخر := تی سی پی.استخر جدید()
    سرچاپ تی سی پی.تعداد استخر(استخر)
    تی سی پی.بازگرداندن اتصال(استخر، "127.0.0.1"، درگاه، c، 1000 برگردان صحیح۶۴)
    سرچاپ تی سی پی.تعداد استخر(استخر)
    دوباره := تی سی پی.دریافت اتصال(استخر، "127.0.0.1"، درگاه، 2000 برگردان صحیح۶۴)
    سرچاپ دوباره.توصیفگر برابر c.توصیفگر
    سرچاپ تی سی پی.تعداد استخر(استخر)

    تی سی پی.تنظیم مهلت(دوباره، 100)
    سرچاپ تی سی پی.خواندن(دوباره، 1024).طول()
    تی سی پی.تنظیم مهلت(دوباره، 2000)
    تی سی پی.نوشتن(دوباره، "done")
    تی سی پی.بستن(دوباره)

    ساده := تی سی پی.شماره گیری("127.0.0.1"، درگاه)
    ناپایا پیکربندی := تی ال اس.پیکربندی جدید("127.0.0.1")
    پیکربندی.پرونده گواهی ریشه = CERT
    ناپایا ارتقایافته := تی سی پی.ارتقا به تی ال اس(ساده، پیکربندی)
    سرچاپ تی ال اس.اتصال معتبر(ارتقایافته)
    تی ال اس.نوشتن(ارتقایافته، "upgraded")
    سرچاپ تی ال اس.خواندن(ارتقایافته، 1024)
    تی ال اس.بستن اتصال(ارتقایافته)
    تی سی پی.بستن(ساده)

    محیط.تنظیم("SSL_CERT_FILE"، CERT)
    ناپایا اتصال مستقیم := تی سی پی.شماره گیری امن("127.0.0.1"، درگاه)
    سرچاپ تی ال اس.اتصال معتبر(اتصال مستقیم)
    تی ال اس.نوشتن(اتصال مستقیم، "dialed")
    سرچاپ تی ال اس.خواندن(اتصال مستقیم، 1024)
    تی ال اس.بستن اتصال(اتصال مستقیم)

    نخ‌پیوند(t)
پایان
