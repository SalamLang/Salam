بسته ریشه

واردسازی محیط
واردسازی شبکه.تی سی پی
واردسازی همگام سازی
واردسازی تی ال اس

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا port := 0

تابع server():
    srv := تی سی پی.پیوند(0)
    port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    اگر وارونه تی سی پی.معتبر(srv): برگشت پایان

    c := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 1024))
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 1024))
        تی سی پی.خواندن(c، 1024)
        تی سی پی.بستن(c)
    پایان

    scfg := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    تکرار 2:
        s := تی سی پی.پذیرش(srv)
        اگر تی سی پی.اتصال معتبر(s):
            ناپایا tc := تی ال اس.پوشش کارساز(s.توصیفگر، scfg)
            اگر تی ال اس.اتصال معتبر(tc):
                تی ال اس.نوشتن(tc، "tls:" + تی ال اس.خواندن(tc، 1024))
            پایان
            تی ال اس.بستن اتصال(tc)
        پایان
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)

    c := تی سی پی.شماره گیری با مهلت("127.0.0.1"، port، 2000)
    سرچاپ تی سی پی.اتصال معتبر(c)
    تی سی پی.تنظیم زنده‌نگه‌داری(c، درست)
    تی سی پی.غیرفعال‌سازی نگل(c، درست)
    تی سی پی.تنظیم مهلت نوشتن(c، 2000)
    تی سی پی.تنظیم مهلت(c، 2000)

    تی سی پی.نوشتن(c، "one")
    سرچاپ تی سی پی.خواندن(c، 1024)

    same := تی سی پی.اتصال از توصیف‌گر(c.توصیفگر)
    سرچاپ same.توصیفگر برابر c.توصیفگر
    سرچاپ تی سی پی.اتصال معتبر(same)
    تی سی پی.نوشتن(same، "two")
    سرچاپ تی سی پی.خواندن(c، 1024)

    ناپایا pool := تی سی پی.استخر جدید()
    سرچاپ تی سی پی.تعداد استخر(pool)
    تی سی پی.بازگرداندن اتصال(pool، "127.0.0.1"، port، c، 1000 برگردان صحیح۶۴)
    سرچاپ تی سی پی.تعداد استخر(pool)
    again := تی سی پی.دریافت اتصال(pool، "127.0.0.1"، port، 2000 برگردان صحیح۶۴)
    سرچاپ again.توصیفگر برابر c.توصیفگر
    سرچاپ تی سی پی.تعداد استخر(pool)

    تی سی پی.تنظیم مهلت(again، 100)
    سرچاپ تی سی پی.خواندن(again، 1024).طول()
    تی سی پی.تنظیم مهلت(again، 2000)
    تی سی پی.نوشتن(again، "done")
    تی سی پی.بستن(again)

    plain := تی سی پی.شماره گیری("127.0.0.1"، port)
    ناپایا cfg := تی ال اس.پیکربندی جدید("127.0.0.1")
    cfg.پرونده گواهی ریشه = CERT
    ناپایا up := تی سی پی.ارتقا به تی ال اس(plain، cfg)
    سرچاپ تی ال اس.اتصال معتبر(up)
    تی ال اس.نوشتن(up، "upgraded")
    سرچاپ تی ال اس.خواندن(up، 1024)
    تی ال اس.بستن اتصال(up)
    تی سی پی.بستن(plain)

    محیط.تنظیم("SSL_CERT_FILE"، CERT)
    ناپایا dt := تی سی پی.شماره گیری امن("127.0.0.1"، port)
    سرچاپ تی ال اس.اتصال معتبر(dt)
    تی ال اس.نوشتن(dt، "dialed")
    سرچاپ تی ال اس.خواندن(dt، 1024)
    تی ال اس.بستن اتصال(dt)

    نخ‌پیوند(t)
پایان
