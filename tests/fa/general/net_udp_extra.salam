بسته ریشه

واردسازی شبکه.یو دی پی

تابع ریشه:
    srv := یو دی پی.پیوند روی("127.0.0.1"، 0)
    سرچاپ یو دی پی.معتبر(srv)
    یو دی پی.تنظیم زمان انتظار(srv، 2000)
    srv_port := یو دی پی.درگاه(srv)
    سرچاپ srv_port بزرگتر 0

    c := یو دی پی.باز کردن()
    یو دی پی.تنظیم زمان انتظار(c، 2000)
    یو دی پی.فعال‌سازی پخش(c، درست)
    یو دی پی.فعال‌سازی پخش(c، نادرست)

    ناپایا got := یو دی پی.بسته {}
    ناپایا tries := 0
    تا got.داده.طول() برابر 0 و tries کوچکتر 5:
        یو دی پی.ارسال به(c، "127.0.0.1"، srv_port، "via-sendto")
        got = یو دی پی.دریافت(srv، 1024)
        tries += 1
    پایان
    سرچاپ got.داده
    سرچاپ got.میزبان فرستنده

    سرچاپ یو دی پی.پیوستن به گروه پخش(srv، "not-an-address")
    سرچاپ یو دی پی.ترک گروه پخش(srv، "not-an-address")
    joined := یو دی پی.پیوستن به گروه پخش(srv، "239.255.42.99")
    left := یو دی پی.ترک گروه پخش(srv، "239.255.42.99")
    سرچاپ left برابر joined
    سرچاپ یو دی پی.ترک گروه پخش(srv، "239.255.42.99")

    یو دی پی.بستن(c)
    یو دی پی.بستن(srv)
پایان
