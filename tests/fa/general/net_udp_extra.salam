بسته ریشه

واردسازی شبکه.یو دی پی

تابع ریشه:
    سرور := یو دی پی.پیوند روی("127.0.0.1"، 0)
    سرچاپ یو دی پی.معتبر(سرور)
    یو دی پی.تنظیم زمان انتظار(سرور، 2000)
    درگاه سرور := یو دی پی.درگاه(سرور)
    سرچاپ درگاه سرور بزرگتر 0

    c := یو دی پی.باز کردن()
    یو دی پی.تنظیم زمان انتظار(c، 2000)
    یو دی پی.فعال‌سازی پخش(c، درست)
    یو دی پی.فعال‌سازی پخش(c، نادرست)

    ناپایا دریافتی := یو دی پی.بسته {}
    ناپایا تلاش‌ها := 0
    تا دریافتی.داده.طول() برابر 0 و تلاش‌ها کوچکتر 5:
        یو دی پی.ارسال به(c، "127.0.0.1"، درگاه سرور، "via-sendto")
        دریافتی = یو دی پی.دریافت(سرور، 1024)
        تلاش‌ها += 1
    پایان
    سرچاپ دریافتی.داده
    سرچاپ دریافتی.میزبان فرستنده

    سرچاپ یو دی پی.پیوستن به گروه پخش(سرور، "not-an-address")
    سرچاپ یو دی پی.ترک گروه پخش(سرور، "not-an-address")
    پیوسته := یو دی پی.پیوستن به گروه پخش(سرور، "239.255.42.99")
    ترک‌شده := یو دی پی.ترک گروه پخش(سرور، "239.255.42.99")
    سرچاپ ترک‌شده برابر پیوسته
    سرچاپ یو دی پی.ترک گروه پخش(سرور، "239.255.42.99")

    یو دی پی.بستن(c)
    یو دی پی.بستن(سرور)
پایان
