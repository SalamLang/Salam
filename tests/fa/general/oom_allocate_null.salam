بسته ریشه

واردسازی حافظه

اگر سلام سیستم لینوکس:
    درون‌داد:
        تابع setrlimit(what: صحیح، limits: تهی*): صحیح
        تابع getrlimit(what: صحیح، limits: تهی*): صحیح
    پایان
پایان

ناپایا g_kept := 0 برگردان صحیح۶۴

تابع show(p: تهی*):
    g_kept = p برگردان صحیح۶۴
    سرچاپ g_kept برابر 0
پایان

اگر سلام سیستم لینوکس:
    تابع limit_memory(): منطقی:
        raw := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
        اگر getrlimit(9، raw) نابرابر 0:
            سرچاپ "cannot read the memory limit"
            برگشت نادرست
        پایان
        limits := raw برگردان اندازه مثبت*
        limits[0] = (64 * 1024 * 1024) برگردان اندازه مثبت
        اگر setrlimit(9، raw) نابرابر 0:
            سرچاپ "cannot set the memory limit"
            برگشت نادرست
        پایان
        برگشت درست
    پایان
وگرنه:
    تابع limit_memory(): منطقی:
        برگشت نادرست
    پایان
پایان

تابع ریشه:
    اگر سلام سیستم لینوکس:
        اگر وارونه limit_memory():
            برگشت
        پایان
        size := (1024 * 1024 * 1024) برگردان طبیعی۶۴
        show(حافظه.تخصیص(size))
        show(حافظه.تخصیص صفرشده(size))
        show(حافظه.تخصیص آرایه(size، 1 برگردان طبیعی۶۴))
        small := حافظه.تخصیص(16 برگردان طبیعی۶۴)
        show(حافظه.بازتخصیص(small، size))
        show(حافظه.تخصیص(16 برگردان طبیعی۶۴))
    وگرنه:
        سرچاپ درست
        سرچاپ درست
        سرچاپ درست
        سرچاپ درست
        سرچاپ نادرست
    پایان
پایان
