واردسازی حافظه

اگر سلام سیستم لینوکس:
    درون‌داد:
        تابع setrlimit(what: صحیح، limits: تهی*): صحیح
        تابع getrlimit(what: صحیح، limits: تهی*): صحیح
        تابع prctl(option: صحیح، value: طبیعی۶۴): صحیح
    پایان
وگرنه:
    درون‌داد:
        نابرگشت تابع exit(code: صحیح)
    پایان
پایان

ناپایا g_head := 0 برگردان صحیح۶۴

میانجی Shape:
    تابع area(): صحیح
پایان

ساختار Square:
    همگانی side: صحیح = 2

    همگانی تابع area(): صحیح:
        برگشت این.side * این.side
    پایان
پایان

نادرخط تابع area_of(s: پویا Shape): صحیح:
    برگشت s.area()
پایان


اگر سلام سیستم لینوکس:
    تابع limit_memory(): منطقی:
        raw := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
        اگر getrlimit(9، raw) نابرابر 0:
            سرچاپ "cannot read the memory limit"
            برگشت نادرست
        پایان
        limits := raw برگردان اندازه مثبت*
        limits[0] = (64 * 1024 * 1024) برگردان اندازه مثبت
        اگر setrlimit(9، raw) نابرابر 0:
            سرچاپ "cannot set the memory limit"
            برگشت نادرست
        پایان
        _dump := prctl(4، 0 برگردان طبیعی۶۴)
        برگشت درست
    پایان

    تابع exhaust(): منطقی:
        ناپایا size := (1024 * 1024) برگردان طبیعی۶۴
        ناپایا held := 0 برگردان طبیعی۶۴
        تا size بزرگتربرابر (8 برگردان طبیعی۶۴):
            ناپایا p := حافظه.تخصیص(size)
            تا p نابرابر پوچ:
                held += size
                اگر held بزرگتر ((256 * 1024 * 1024) برگردان طبیعی۶۴):
                    سرچاپ "the memory limit is not enforced"
                    برگشت نادرست
                پایان
                q := p برگردان صحیح۶۴*
                q[0] = g_head
                g_head = p برگردان صحیح۶۴
                p = حافظه.تخصیص(size)
            پایان
            size = size / (2 برگردان طبیعی۶۴)
        پایان
        برگشت درست
    پایان

    تابع run():
        اگر وارونه limit_memory():
            برگشت
        پایان
        سرچاپ "start"
        g_head = 0
        اگر وارونه exhaust():
            برگشت
        پایان
        سرچاپ area_of(Square { side = 3 } برگردان پویا Shape)
    پایان
وگرنه:
    تابع run():
        سرچاپ "start"
        نادرست‌سرچاپ "salam: out of memory"
        exit(134)
    پایان
پایان

تابع ریشه:
    run()
پایان
