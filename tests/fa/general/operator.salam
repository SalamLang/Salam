ساختار نقطه:
    همگانی ایکس: صحیح = 0
    همگانی وای: صحیح = 0
    همگانی کارکرد کنشگر + (دیگری: نقطه): نقطه: بازگشت نقطه { ایکس = این.ایکس + دیگری.ایکس, وای = این.وای + دیگری.وای }
    پایان
پایان

کارکرد آغازین:
    الف := نقطه { ایکس = 3, وای = 4 }
    ب := نقطه { ایکس = 1, وای = 2 }
    ج := الف + ب
    چاپ ج.ایکس, ج.وای
پایان
