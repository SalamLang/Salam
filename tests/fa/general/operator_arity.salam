ساختار Money:
    همگانی cents: صحیح = 0
    همگانی تابع -(): Money:
        برگشت Money { cents = 0 - این.cents }
    پایان
    همگانی تابع -(other: Money): Money:
        برگشت Money { cents = این.cents - other.cents }
    پایان
    همگانی تابع + (other: Money): Money:
        برگشت Money { cents = این.cents + other.cents }
    پایان
    همگانی تابع وارونه (): منطقی:
        برگشت این.cents == 0
    پایان
    همگانی تابع **(n: اعشار۶۴): اعشار۶۴:
        برگشت (این.cents برگردان اعشار۶۴) ** n
    پایان
پایان

تابع ریشه:
    a := Money { cents = 250 }
    b := Money { cents = 100 }
    سرچاپ (-a).cents
    سرچاپ (a - b).cents
    سرچاپ (a + (-b)).cents
    سرچاپ وارونه a
    سرچاپ وارونه Money {}
    سرچاپ b ** 2.0
    x := 7
    سرچاپ -(-x)
    سرچاپ x - (-3)
    ناپایا n := 1
    سرچاپ (n++) + 10
    سرچاپ n
پایان
