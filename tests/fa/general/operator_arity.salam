ساختار پول:
    همگانی سنت: صحیح = 0
    همگانی تابع -(): پول:
        برگشت پول { سنت = 0 - این.سنت }
    پایان
    همگانی تابع -(دیگری: پول): پول:
        برگشت پول { سنت = این.سنت - دیگری.سنت }
    پایان
    همگانی تابع + (دیگری: پول): پول:
        برگشت پول { سنت = این.سنت + دیگری.سنت }
    پایان
    همگانی تابع وارونه (): منطقی:
        برگشت این.سنت == 0
    پایان
    همگانی تابع **(n: اعشار۶۴): اعشار۶۴:
        برگشت (این.سنت برگردان اعشار۶۴) ** n
    پایان
پایان

تابع ریشه:
    a := پول { سنت = 250 }
    b := پول { سنت = 100 }
    سرچاپ (-a).سنت
    سرچاپ (a - b).سنت
    سرچاپ (a + (-b)).سنت
    سرچاپ وارونه a
    سرچاپ وارونه پول {}
    سرچاپ b ** 2.0
    x := 7
    سرچاپ -(-x)
    سرچاپ x - (-3)
    ناپایا n := 1
    سرچاپ (n++) + 10
    سرچاپ n
پایان
