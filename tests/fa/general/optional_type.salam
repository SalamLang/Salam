ساختار مشتری:
    همگانی میزبان: رشته
    همگانی درگاه: صحیح؟
    همگانی نام: رشته؟ = "ناشناس"
پایان

تابع یافتن(کلید: رشته): صحیح؟:
    اگر کلید == "الف":
        برگشت ۱
    پایان
    برگشت پوچ
پایان

تابع ریشه:
    الف := مشتری { میزبان = "x" }
    سرچاپ الف.درگاه.ندارد()، الف.نام.مقدار
    ناپایا ب := مشتری { میزبان = "y"، درگاه = ۸۰، نام = پوچ }
    سرچاپ ب.درگاه.مقدار، ب.نام.موجود
    ب.درگاه = پوچ
    سرچاپ ب.درگاه.یابرگردان(۵)
    سرچاپ یافتن("الف").بازکن()، یافتن("ب").دارد()
پایان
