تابع بپذیر<T>(مقدار: T؟): منطقی:
    برگشت مقدار.دارد()
پایان

تابع برگزین<T>(مقدار: T؟، جایگزین: T): T:
    برگشت مقدار.یابرگردان(جایگزین)
پایان

تابع ریشه:
    سرچاپ بپذیر(۱)، بپذیر("الف")
    سرچاپ برگزین(۵، ۱)، برگزین(پوچ، ۷)، برگزین("س"، "ت")
پایان
