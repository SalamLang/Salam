واردسازی حافظه
واردسازی رشته

تابع trim_slashes(p: رشته): رشته:
    ناپایا q := رشته.رونوشت(p)
    تا q.طول() بزرگتر 1 و رشته.پایان با(q، "/"):
        shorter := q.زیررشته(0، q.طول() - 1)
        حافظه.آزادسازی(q برگردان تهی*)
        q = shorter
    پایان
    برگشت q
پایان

تابع rows(n: صحیح): صحیح:
    ناپایا prev := وکتور {} برگردان وکتور<صحیح>
    prev.بیفزا(1)
    تکرار n در i:
        ناپایا cur := وکتور {} برگردان وکتور<صحیح>
        cur.بیفزا(1)
        تکرار prev.طول() - 1 در k:
            cur.بیفزا(prev.بگیر(k) + prev.بگیر(k + 1))
        پایان
        cur.بیفزا(1)
        prev.آزادکن()
        prev = cur
        اگر i کوچکتر 0:
            بشکن
        پایان
    پایان
    total := prev.طول()
    prev.آزادکن()
    برگشت total
پایان

تابع ریشه:
    t := trim_slashes("a/b///")
    سرچاپ t
    حافظه.آزادسازی(t برگردان تهی*)

    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    دیرکن v.آزادکن()
    v.بیفزا(1)
    v.آزادکن()
    v.بیفزا(2)
    v.بیفزا(3)
    first := v.ارجاع(0)
    سرچاپ first[0]، v.طول()

    ناپایا s := "x" + رشته.از عدد(1)
    حافظه.آزادسازی(s برگردان تهی*)
    s = "y" + رشته.از عدد(2)
    سرچاپ s
    حافظه.آزادسازی(s برگردان تهی*)

    سرچاپ rows(4)
پایان
