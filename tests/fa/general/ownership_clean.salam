واردسازی حافظه
واردسازی رشته

تابع حذف اسلش پایانی(p: رشته): رشته:
    ناپایا q := رشته.رونوشت(p)
    تا q.طول() بزرگتر 1 و رشته.پایان با(q، "/"):
        کوتاه‌شده := q.زیررشته(0، q.طول() - 1)
        حافظه.آزادسازی(q برگردان تهی*)
        q = کوتاه‌شده
    پایان
    برگشت q
پایان

تابع جمع ردیف‌ها(n: صحیح): صحیح:
    ناپایا قبلی := وکتور {} برگردان وکتور<صحیح>
    قبلی.بیفزا(1)
    تکرار n در i:
        ناپایا فعلی := وکتور {} برگردان وکتور<صحیح>
        فعلی.بیفزا(1)
        تکرار قبلی.طول() - 1 در k:
            فعلی.بیفزا(قبلی.بگیر(k) + قبلی.بگیر(k + 1))
        پایان
        فعلی.بیفزا(1)
        قبلی.آزادکن()
        قبلی = فعلی
        اگر i کوچکتر 0:
            بشکن
        پایان
    پایان
    جمع := قبلی.طول()
    قبلی.آزادکن()
    برگشت جمع
پایان

تابع ریشه:
    t := حذف اسلش پایانی("a/b///")
    سرچاپ t
    حافظه.آزادسازی(t برگردان تهی*)

    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    دیرکن v.آزادکن()
    v.بیفزا(1)
    v.آزادکن()
    v.بیفزا(2)
    v.بیفزا(3)
    اول := v.ارجاع(0)
    سرچاپ اول[0]، v.طول()

    ناپایا s := "x" + رشته.از عدد(1)
    حافظه.آزادسازی(s برگردان تهی*)
    s = "y" + رشته.از عدد(2)
    سرچاپ s
    حافظه.آزادسازی(s برگردان تهی*)

    سرچاپ جمع ردیف‌ها(4)
پایان
