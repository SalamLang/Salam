واردسازی رشته

درون‌داد:
    ناب تابع strstr(haystack: رشته، needle: رشته): رشته
پایان

ناپایا g_keep := وکتور {} برگردان وکتور<صحیح>

تابع tail(n: صحیح): رشته:
    s := "head-" + رشته.از عدد(n برگردان صحیح۶۴) + "-suffix-and-more-padding-text"
    برگشت strstr(s، "suffix")
پایان

تابع grow_keep(v &: وکتور<صحیح>):
    v.بیفزا(41)
    v.بیفزا(42)
    g_keep = v
پایان

تابع work():
    ناپایا tmp := وکتور {} برگردان وکتور<صحیح>
    grow_keep(tmp)
    سرچاپ tmp.طول()
پایان

تابع buffer(): صحیح*:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    v.بیفزا(11)
    v.بیفزا(22)
    برگشت v.داده
پایان

تابع ریشه:
    t := tail(7)
    work()
    p := buffer()
    ناپایا junk := وکتور {} برگردان وکتور<رشته>
    تکرار 64 در i:
        junk.بیفزا("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" + رشته.از عدد(i برگردان صحیح۶۴))
    پایان
    سرچاپ t
    سرچاپ g_keep.بگیر(0)، g_keep.بگیر(1)
    سرچاپ p[0]، p[1]
    سرچاپ junk.طول()
پایان
