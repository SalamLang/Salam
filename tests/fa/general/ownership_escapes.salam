واردسازی رشته

درون‌داد:
    ناب تابع strstr(کاه‌دان: رشته، نمونه: رشته): رشته
پایان

ناپایا نگه‌داشته := وکتور {} برگردان وکتور<صحیح>

تابع دنباله(n: صحیح): رشته:
    s := "head-" + رشته.از عدد(n برگردان صحیح۶۴) + "-suffix-and-more-padding-text"
    برگشت strstr(s، "suffix")
پایان

تابع رشد نگهدار(v &: وکتور<صحیح>):
    v.بیفزا(41)
    v.بیفزا(42)
    نگه‌داشته = v
پایان

تابع کار():
    ناپایا موقت := وکتور {} برگردان وکتور<صحیح>
    رشد نگهدار(موقت)
    سرچاپ موقت.طول()
پایان

تابع حافظه میانی(): صحیح*:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    v.بیفزا(11)
    v.بیفزا(22)
    برگشت v.داده
پایان

تابع ریشه:
    t := دنباله(7)
    کار()
    p := حافظه میانی()
    ناپایا زباله := وکتور {} برگردان وکتور<رشته>
    تکرار 64 در i:
        زباله.بیفزا("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" + رشته.از عدد(i برگردان صحیح۶۴))
    پایان
    سرچاپ t
    سرچاپ نگه‌داشته.بگیر(0)، نگه‌داشته.بگیر(1)
    سرچاپ p[0]، p[1]
    سرچاپ زباله.طول()
پایان
