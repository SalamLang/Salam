تابع ریشه:
    i := "5".به صحیح()
    v := وکتور {} برگردان وکتور<صحیح>
    v.بیفزا(1)
    سرچاپ "سطر یک"
    سرچاپ "سطر دو:"، v.طول()
    نادرست‌سرچاپ "به خطای استاندارد"
    سرچاپ "سطر سه"
    سرچاپ v.بگیر(i)
    سرچاپ "نرسیدنی"
پایان
