تابع ریشه:
    یک‌چهارم := ۲۵٪
    نیمه := 12.5%
    باقی := ۷%۳
    سهم‌ها := [۱۰٪، ۲۰٪، ۱۰۰٪]
    آبی := #3366aa
    سفید := #fff
    سرچاپ یک‌چهارم
    سرچاپ نیمه
    سرچاپ باقی
    سرچاپ سهم‌ها[1] + سهم‌ها[2]
    سرچاپ یک‌چهارم + 1.0
    سرچاپ آبی
    سرچاپ سفید.طول()
پایان
