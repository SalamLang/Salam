روال ریشه:
    ناپایا اعداد := وکتور {} برگردان وکتور<صحیح> اعداد.بیفزا(10)
    اعداد.بیفزا(20)
    اعداد.بیفزا(30)
    اعداد.بنشان(1, 99)
    سرچاپ "طول", اعداد.طول()
    سرچاپ "نخست", اعداد.بگیر(0)
    سرچاپ "میانه", اعداد.بگیر(1)
    سرچاپ "آخر", اعداد.دربیاور()
    ناپایا امتیاز := نگاشت {} برگردان نگاشت<رشته, صحیح> امتیاز.درج("الف", 3)
    امتیاز.درج("ب", 7)
    سرچاپ "اندازه", امتیاز.اندازه()
    سرچاپ "دارد-الف", امتیاز.دارد("الف")
    سرچاپ "بگیر-ب", امتیاز.بگیر("ب")
    سرچاپ "حذف", امتیاز.حذف("الف")
    سرچاپ "اندازه", امتیاز.اندازه()
    ناپایا مجموع := 0
    ناپایا پیمایه := امتیاز.پیمایش()
    تا پیمایه.داردبعدی():
        مجموع = مجموع + پیمایه.مقدار()
        پیمایه.بعدی()
    پایان
    سرچاپ "جمع", مجموع
    پایا متن := "salam,donya"
    سرچاپ "طول-متن", متن.طول()
    سرچاپ "بخش", متن.زیررشته(0, 5)
    سرچاپ "یافتن", متن.بیاب("donya")
    سرچاپ "پیوست", متن.پیوست("!")
    ناپایا قطعه ها := متن.بشکاف(",")
    سرچاپ "تعداد-بخش", قطعه ها.طول()
    سرچاپ "عدد", "۴۲ ".پیراست()
    سرچاپ "به‌صحیح", "42".به صحیح() + 1
پایان
