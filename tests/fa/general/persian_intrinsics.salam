کارکرد آغازین:
    گذرا اعداد := وکتور {} برگردان وکتور<صحیح> اعداد.بیفزا(10)
    اعداد.بیفزا(20)
    اعداد.بیفزا(30)
    اعداد.بنشان(1, 99)
    چاپ "طول", اعداد.طول()
    چاپ "نخست", اعداد.بگیر(0)
    چاپ "میانه", اعداد.بگیر(1)
    چاپ "آخر", اعداد.دربیاور()
    گذرا امتیاز := نگاشت {} برگردان نگاشت<رشته, صحیح> امتیاز.درج("الف", 3)
    امتیاز.درج("ب", 7)
    چاپ "اندازه", امتیاز.اندازه()
    چاپ "دارد-الف", امتیاز.دارد("الف")
    چاپ "بگیر-ب", امتیاز.بگیر("ب")
    چاپ "حذف", امتیاز.حذف("الف")
    چاپ "اندازه", امتیاز.اندازه()
    گذرا مجموع := 0
    گذرا پیمایه := امتیاز.پیمایش()
    تاهنگام پیمایه.داردبعدی():
        مجموع = مجموع + پیمایه.مقدار()
        پیمایه.بعدی()
    پایان
    چاپ "جمع", مجموع
    پایدار متن := "salam,donya"
    چاپ "طول-متن", متن.طول()
    چاپ "بخش", متن.زیررشته(0, 5)
    چاپ "یافتن", متن.بیاب("donya")
    چاپ "پیوست", متن.پیوست("!")
    گذرا بخش ها := متن.بشکاف(",")
    چاپ "تعداد-بخش", بخش ها.طول()
    چاپ "عدد", "۴۲ ".پیراست()
    چاپ "به‌صحیح", "42".به صحیح() + 1
پایان
