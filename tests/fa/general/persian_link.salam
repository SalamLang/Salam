پیوند پویا "sqlite3"
درون‌داد:
    تابع sqlite3_libversion(): رشته
پایان

تابع ریشه:
    مقدار := sqlite3_libversion()
    اگر مقدار نابرابر "":
        سرچاپ "sqlite linked"
    وگرنه:
        سرچاپ "no"
    پایان
پایان
