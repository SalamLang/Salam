// زبان: فارسی
پیوند پویا "sqlite3"
خارجی:
    تابع sqlite3_libversion(): رشته
تمام

تابع اصلی:
    مقدار := sqlite3_libversion()
    اگر مقدار != "":
        چاپ "sqlite linked"
    وگرنه:
        چاپ "no"
    تمام
تمام
