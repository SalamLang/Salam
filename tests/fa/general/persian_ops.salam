// زبان: فارسی
تابع اصلی:
    الف := درست
    ب := نادرست
    چاپ الف و ب, الف یا ب, !الف
    چاپ درست و درست, نادرست یا نادرست
    چاپ 10 ＋ 5, 10 － 3, 8 − 2
    مجموع := (2 ＋ 3) * 4 − 1
    چاپ مجموع
تمام
