فراخوانی پ "_pkg_enum_lib.salam"

جداشمار لحن:
    روشن، تیره، نرم، بلند
پایان

ساختار محلی:
    همگانی ل: پ.لحن = پ.لحن.بلند
    همگانی خود: لحن = لحن.بلند
پایان

تابع کمکی(): صحیح:
    برگشت ۲
پایان

تابع ریشه:
    ت := پ.تنظیم {}
    سرچاپ ت.ل برگردان صحیح، ت.ن، کمکی()
    سرچاپ پ.انتخاب()
    م := محلی {}
    سرچاپ م.ل برگردان صحیح، م.خود برگردان صحیح
پایان
