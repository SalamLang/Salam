واردسازی عبارت باقاعده

روال عنوان_را_بگیر(متن: رشته): رشته:
    اگر !عبارت باقاعده.تطبیقرشته("<title>.*</title>", متن):
        برگشت ""
    پایان
    گام۱ := عبارت باقاعده.جایگزینیرشته(".*<title>", متن, "")
    برگشت عبارت باقاعده.جایگزینیرشته("</title>.*", گام۱, "")
پایان

روال پیوندها_را_چاپ(متن: رشته):
    ناپایا باقی := متن
    ناپایا فعال := درست
    تا فعال:
        شاخص := عبارت باقاعده.یافتنرشته(`href="`, باقی)
        اگر شاخص < 0:
            فعال = نادرست
        وگرنه:
            بعد := شاخص + 6
            دنباله := باقی.زیررشته(بعد, باقی.طول() - بعد)
            انتها := عبارت باقاعده.یافتنرشته(`"`, دنباله)
            اگر انتها < 0:
                فعال = نادرست
            وگرنه:
                سرچاپ دنباله.زیررشته(0, انتها)
                جلو := بعد + انتها + 1
                باقی = باقی.زیررشته(جلو, باقی.طول() - جلو)
            پایان
        پایان
    پایان
پایان

روال ریشه:
    برگه := "<html><head><title>Salam Lang Docs</title></head><body>hi</body></html>"
    سرچاپ عنوان_را_بگیر(برگه)

    بدون_عنوان := "<html><body>no title here</body></html>"
    سرچاپ عنوان_را_بگیر(بدون_عنوان)

    پیوندها := `<a href="https://salamlang.org">Home</a><a href="https://salamlang.org/docs">Docs</a><a href="/about">About</a>`
    پیوندها_را_چاپ(پیوندها)

    ایمیل := "contact: ada@example.com or grace@example.org"
    سرچاپ عبارت باقاعده.تطبیقرشته("\\w+@\\w+\\.\\w+", ایمیل)
    سرچاپ عبارت باقاعده.یافتنرشته("@", ایمیل) > 0

    فقط_ارقام := عبارت باقاعده.جایگزینیهمهرشته("[0-9]", "room 42, floor 7", "")
    سرچاپ فقط_ارقام

    سیاسوی := "name,age,city"
    سرچاپ عبارت باقاعده.جایگزینیهمهرشته(",", سیاسوی, " | ")
پایان
