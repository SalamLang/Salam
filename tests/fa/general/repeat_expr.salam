تابع ریشه:
    ن := 2 + 3
    ناپایا مجموع := 0
    ناپایا نمایه := 0
    تکرار ن:
        نمایه++
        اگر نمایه برابر 4:
            بشکن
        پایان
        مجموع += نمایه
    پایان
    سرچاپ مجموع
پایان
