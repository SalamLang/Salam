تابع ریشه:
    ناپایا شمار := 0
    تکرار 3:
        تکرار 2:
            شمار++
        پایان
    پایان
    سرچاپ شمار
    منفی := -4
    تکرار منفی:
        سرچاپ "نباید چاپ شود"
    پایان
    سرچاپ "پایان"
پایان
