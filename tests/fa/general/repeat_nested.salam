کارکرد آغازین:
    گذرا شمار := 0
    چرخه 3:
        چرخه 2:
            شمار = شمار + 1
        پایان
    پایان
    چاپ شمار
    منفی := 0 - 4
    چرخه منفی:
        چاپ "نباید چاپ شود"
    پایان
    چاپ "پایان"
پایان
