// زبان: فارسی
تابع اصلی:
    متغیر شمار := 0
    تکرار 3:
        تکرار 2:
            شمار = شمار + 1
        تمام
    تمام
    چاپ شمار
    منفی := 0 - 4
    تکرار منفی:
        چاپ "نباید چاپ شود"
    تمام
    چاپ "پایان"
تمام
