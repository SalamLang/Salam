کارکرد آغازین:
    گذرا شمارنده := 0
    چرخه 10 تا 14:
        شمارنده = شمارنده + 1
    پایان
    چاپ شمارنده

    چرخه 5 تا 1:
        بنویس "پ"
    پایان
    چاپ ""

    چرخه 3 تا 3:
        چاپ "یکبار"
    پایان
پایان
