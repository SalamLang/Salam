// زبان: فارسی
تابع اصلی:
    متغیر شمارنده := 0
    تکرار 10 تا 14:
        شمارنده = شمارنده + 1
    تمام
    چاپ شمارنده

    تکرار 5 تا 1:
        بنویس "پ"
    تمام
    چاپ ""

    تکرار 3 تا 3:
        چاپ "یکبار"
    تمام
تمام
