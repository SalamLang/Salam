روال ریشه:
    ناپایا الف := 0
    تکرار 0 تا 10 هر 2:
        الف = الف + 1
    پایان
    سرچاپ الف

    ناپایا ب := 0
    تکرار 10 تا 100 هر 30:
        ب = ب + 1
    پایان
    سرچاپ ب
پایان
