// زبان: فارسی
تابع اصلی:
    متغیر الف := 0
    تکرار 0 تا 10 گام 2:
        الف = الف + 1
    تمام
    چاپ الف

    متغیر ب := 0
    تکرار 10 تا 100 گام 30:
        ب = ب + 1
    تمام
    چاپ ب
تمام
