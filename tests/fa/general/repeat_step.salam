کارکرد آغازین:
    گذرا الف := 0
    چرخه 0 تا 10 گام 2:
        الف = الف + 1
    پایان
    چاپ الف

    گذرا ب := 0
    چرخه 10 تا 100 گام 30:
        ب = ب + 1
    پایان
    چاپ ب
پایان
