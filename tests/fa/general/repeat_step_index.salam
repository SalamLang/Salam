تابع ریشه:
    ناپایا مجموع := 0
    تکرار 4 در ک:
        مجموع += ک
    پایان
    سرچاپ مجموع

    ناپایا برگزیده := 0
    تکرار 1 تا 10 هر 3 در ی:
        برگزیده += ی
    پایان
    سرچاپ برگزیده

    ناپایا گام‌ها := 0
    تکرار 0 تا 10 هر 5:
        گام‌ها++
    پایان
    سرچاپ گام‌ها

    ناپایا ن := 0
    تا ن < 3:
        ن++
    پایان
    سرچاپ ن

    سرچاپ مجموع، برگزیده

    فهرست := [1، 2، 3]
    ناپایا جمع := 0
    هر ع در فهرست:
        جمع += ع
    پایان
    سرچاپ جمع
    ورودی متن := "ورودی"
    سرچاپ ورودی متن
پایان
