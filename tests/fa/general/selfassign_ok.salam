ناپایا سراسری := ۱۰

ساختار نقطه:
    همگانی ایکس: صحیح = ۰
    همگانی تابع +(د: نقطه): نقطه:
        برگشت نقطه { ایکس = این.ایکس + د.ایکس + ۱۰۰ }
    پایان
پایان

ساختار جعبه:
    همگانی ن: صحیح = ۰
    همگانی تابع رشد():
        این.ن += ۲
        این.ن = این.ن + افزایش()
    پایان
پایان

تابع افزایش(): صحیح:
    سراسری += ۵
    برگشت ۱
پایان

تابع ریشه:
    ناپایا ع := ۱
    ب := ۴
    ناپایا ر := "میانه"
    پ := "پیش-"
    ناپایا آ := [۱۰، ۲۰، ۳۰]
    ع += ۲
    ع *= ۳
    ع = ب + ۱
    ع = ع * ب + ۳
    ع = ع + ب + ۳
    ع = ب - ع
    ع = ب % ۷
    ر = پ + ر
    آ[۰] = ب - آ[۰]
    ناپایا ن := نقطه { ایکس = ۱ }
    ن = ن + نقطه { ایکس = ۲ }
    ناپایا ج := جعبه {}
    ج.رشد()
    سرچاپ ع، ر، آ[۰]، سراسری، ن.ایکس، ج.ن
پایان
