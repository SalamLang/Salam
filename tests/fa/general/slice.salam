// زبان: فارسی
تابع اصلی:
    اعداد := [10, 20, 30, 40, 50] بعنوان صحیح[5]
    متغیر برش := اعداد[1: 4]
    چاپ len(برش)
    چاپ برش[0], برش[1], برش[2]
    برش[0] = 99
    چاپ اعداد[1]
    چاپ len(اعداد[:])
    پیشوند := اعداد[: 2]
    چاپ len(پیشوند), پیشوند[0], پیشوند[1]
تمام
