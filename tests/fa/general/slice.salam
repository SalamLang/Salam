تابع ریشه:
    اعداد := [10, 20, 30, 40, 50]
    ناپایا برش := اعداد[1: 4]
    سرچاپ طول(برش)
    سرچاپ برش[0], برش[1], برش[2]
    برش[0] = 99
    سرچاپ اعداد[1]
    سرچاپ طول(اعداد[:])
    پیشوند := اعداد[: 2]
    سرچاپ طول(پیشوند), پیشوند[0], پیشوند[1]
پایان
