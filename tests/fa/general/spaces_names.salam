ساختار شخص:
    همگانی نام کامل: رشته
    همگانی سن فعلی: صحیح
پایان

روال جمع دو عدد(عدد اول: صحیح, عدد دوم: صحیح): صحیح:
    برگشت عدد اول + عدد دوم
پایان

روال ریشه:
    نام من := "ali"
    نام_من := "underscore"
    سرچاپ نام من, نام_من
    ناپایا شمارنده اصلی := 0
    شمارنده اصلی += 5
    شمارنده اصلی += 3
    سرچاپ "counter", شمارنده اصلی
    سرچاپ "sum", جمع دو عدد(10, 20)
    فرد := شخص { نام کامل = "sara", سن فعلی = 30 }
    سرچاپ "person", فرد.نام کامل, فرد.سن فعلی
پایان
