واردسازی دیتابیس.اس کیو لایت

تابع run():
    db := اس کیو لایت.بازکردن(":memory:")
    اس کیو لایت.اجرا(db، "CREATE TABLE t(v INTEGER)")
    good := اس کیو لایت.پرسمان(db، "SELECT v FROM t")
    سرچاپ اس کیو لایت.دستور معتبر(good)
    اس کیو لایت.پایان(good)
    bad := اس کیو لایت.پرسمان(db، "SELECT v FROM missing")
    سرچاپ اس کیو لایت.دستور معتبر(bad)
    اس کیو لایت.بستن(db)
پایان

تابع ریشه:
    اگر اس کیو لایت.در دسترس():
        run()
    وگرنه:
        سرچاپ درست
        سرچاپ نادرست
    پایان
پایان
