واردسازی دیتابیس.اس کیو لایت

تابع آزمون():
    پایگاه := اس کیو لایت.بازکردن(":memory:")
    اس کیو لایت.اجرا(پایگاه، "CREATE TABLE t(v INTEGER)")
    پرسمان موجود := اس کیو لایت.پرسمان(پایگاه، "SELECT v FROM t")
    سرچاپ اس کیو لایت.دستور معتبر(پرسمان موجود)
    اس کیو لایت.پایان(پرسمان موجود)
    پرسمان ناموجود := اس کیو لایت.پرسمان(پایگاه، "SELECT v FROM missing")
    سرچاپ اس کیو لایت.دستور معتبر(پرسمان ناموجود)
    اس کیو لایت.بستن(پایگاه)
پایان

تابع ریشه:
    اگر اس کیو لایت.در دسترس():
        آزمون()
    وگرنه:
        سرچاپ درست
        سرچاپ نادرست
    پایان
پایان
