فراخوانی "_ayestapkg.salam"

روال نمایش نام(ن: dyn شکل‌ها.نام‌دار):
    سرچاپ ن.نام()
پایان

روال ریشه:
    ناپایا ن := شکل‌ها.نقطه.مبدا()
    ن.ایکس = شکل‌ها.نقطه.بیشینه
    سرچاپ ن.برچسب، ن.ایکس
    م := شکل‌ها.نقطه { ایکس = ۲، برچسب = "م" }
    سرچاپ م.برچسب، م.ایکس
    سرچاپ م.نام()
    نمایش نام(م)
پایان
