// زبان: فارسی
تابع اصلی:
    متن := "salam"
    متغیر شمار := 0
    تکرار 5 با نمایه:
        اگر متن[نمایه] == 'a': شمار = شمار + 1 تمام
    تمام
    چاپ شمار
تمام
