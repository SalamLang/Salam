واردسازی رشته

تابع ریشه:
    س := "سلام"
    سرچاپ رشته.برعکس(س)
    سرچاپ رشته.شمارنویسه(س)
    سرچاپ رشته.طول(س)
    سرچاپ رشته.برعکس("abc")
