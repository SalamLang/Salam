// زبان: فارسی
واردکردن رشته

تابع اصلی:
    س := "سلام"
    چاپ رشته.وارونه(س)
    چاپ رشته.شمارنویسه(س)
    چاپ رشته.طول(س)
    چاپ رشته.وارونه("abc")
تمام
