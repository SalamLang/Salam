تابع ریشه:
    s := "سلام hi 👋!"
    سرچاپ s.طول()، s.شمارنویسه()
    سرچاپ s.بیاب("hi")، s.بیاب نویسه("hi")
    سرچاپ s.زیررشته(0، 2)، s.زیررشته نویسه(0، 2)
    سرچاپ s.نویسه شماره(1)، s.نویسه شماره(8)
    سرچاپ "[" + s.نویسه شماره(10) + "]"
    سرچاپ s.زیررشته نویسه(5، 100)
    سرچاپ s.بیاب نویسه("👋")، s.بیاب نویسه("xyz")
    word := "درود"
    ناپایا out := ""
    تکرار word.شمارنویسه() در i:
        out = out + word.نویسه شماره(i) + "."
    پایان
    سرچاپ out
پایان
