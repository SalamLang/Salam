واردسازی رشته

تابع label(n: صحیح): رشته:
    head := "item-" + رشته.از عدد(n برگردان صحیح۶۴)
    برگشت head.طول() بزرگتر 3 ? "long" : "short"
پایان

تابع build(n: صحیح): رشته:
    برگشت "a" + رشته.از عدد(n برگردان صحیح۶۴) + "b" + n + "c" + درست + 'x'
پایان

تابع count(n: صحیح): صحیح:
    ناپایا total := 0
    تکرار n در i:
        line := "row " + i + ": " + (i * 2)
        اگر رشته.شروع با(line، "row"):
            total += line.طول()
        پایان
        سرچاپ line
    پایان
    برگشت total
پایان

تابع keep(n: صحیح): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    تکرار n در i:
        s := "k" + i
        v.بیفزا(s)
    پایان
    برگشت v
پایان

تابع ریشه:
    سرچاپ label(5)
    b := build(7)
    سرچاپ b
    سرچاپ count(3)
    ناپایا v := keep(3)
    سرچاپ v.بگیر(2)
    v.آزادکن()
    t := "x" + 1 + "y"
    ترابرد t:
        "x1y": سرچاپ "match" بشکن پایان
        وگرنه: سرچاپ "no" بشکن پایان
    پایان
پایان
