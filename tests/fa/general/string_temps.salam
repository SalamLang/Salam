واردسازی رشته

تابع برچسب(n: صحیح): رشته:
    سر := "item-" + رشته.از عدد(n برگردان صحیح۶۴)
    برگشت سر.طول() بزرگتر 3 ? "long" : "short"
پایان

تابع ساخت(n: صحیح): رشته:
    برگشت "a" + رشته.از عدد(n برگردان صحیح۶۴) + "b" + n + "c" + درست + 'x'
پایان

تابع شمارش(n: صحیح): صحیح:
    ناپایا جمع := 0
    تکرار n در i:
        خط := "row " + i + ": " + (i * 2)
        اگر رشته.شروع با(خط، "row"):
            جمع += خط.طول()
        پایان
        سرچاپ خط
    پایان
    برگشت جمع
پایان

تابع نگهداری(n: صحیح): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    تکرار n در i:
        s := "k" + i
        v.بیفزا(s)
    پایان
    برگشت v
پایان

تابع ریشه:
    سرچاپ برچسب(5)
    b := ساخت(7)
    سرچاپ b
    سرچاپ شمارش(3)
    ناپایا v := نگهداری(3)
    سرچاپ v.بگیر(2)
    v.آزادکن()
    t := "x" + 1 + "y"
    ترابرد t:
        "x1y": سرچاپ "match" بشکن پایان
        وگرنه: سرچاپ "no" بشکن پایان
    پایان
پایان
