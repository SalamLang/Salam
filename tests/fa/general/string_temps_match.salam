واردسازی رشته

تابع describe(n: صحیح): صحیح:
    r := همخوان n:
        1:
            s := "one-" + رشته.از عدد(n برگردان صحیح۶۴)
            سرچاپ s
            s.طول()
        پایان
        وگرنه:
            t := "many-" + رشته.از عدد(n برگردان صحیح۶۴)
            t.طول()
        پایان
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ describe(1)، describe(5)
پایان
