// زبان: فارسی
ساختار شمارنده:
    مقدار: صحیح = 0
    عمومی تابع افزایش():
        این.مقدار = این.مقدار + 1
    تمام
    عمومی تابع بگیر(): صحیح:
        بازگشت این.مقدار
    تمام
تمام

تابع اصلی:
    متغیر ش := شمارنده { مقدار = 5 }
    ش.افزایش()
    ش.افزایش()
    چاپ ش.بگیر()
تمام
