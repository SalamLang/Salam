ساختار سبد:
    همگانی اقلام: وکتور<رشته> = وکتور {}
    همگانی قیمت‌ها: نگاشت<رشته، صحیح> = نگاشت {}
پایان

تابع ریشه:
    ناپایا س := سبد {}
    س.اقلام.بیفزا("نان")
    س.قیمت‌ها.درج("نان"، ۵)
    سرچاپ س.اقلام.طول()، س.قیمت‌ها.اندازه()
پایان
