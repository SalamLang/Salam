جداشمار حالت:
    ساده، امن
پایان

ساختار س:
    همگانی با کلید: منطقی = نادرست
    همگانی کلید: رشته = ""
    همگانی روش: حالت = حالت.ساده
    همگانی گواهی: رشته = ""
    قاعده با کلید == درست نیازمند کلید
    قاعده روش برابر حالت.امن نیازمند گواهی
پایان

تابع ریشه:
    الف := س { با کلید = نادرست }
    سرچاپ الف.با کلید
    ب := س { با کلید = درست، کلید = "ک" }
    سرچاپ ب.کلید
    ج := س { روش = حالت.امن، گواهی = "گ" }
    سرچاپ ج.گواهی
پایان
