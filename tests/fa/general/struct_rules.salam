ساختار مشتری:
    همگانی میزبان: رشته
    همگانی قاعده: صحیح = ۱
    همگانی نام کاربر: رشته = ""
    همگانی رمز عبور: رشته = ""
    همگانی توکن: رشته = ""
    همگانی گواهی: رشته = ""
    همگانی کلید: رشته = ""
    همگانی الف: صحیح = ۰
    همگانی ب: صحیح = ۰
    قاعده نام کاربر نیازمند رمز عبور
    قاعده باهم(گواهی، کلید)
    قاعده دست کم یکی(نام کاربر، توکن)
    قاعده حداکثر یکی(الف، ب)
پایان

ساختار حالت:
    همگانی ساده: منطقی = نادرست
    همگانی راز: رشته = ""
    قاعده فقط‌یکی(ساده، راز)
پایان

تابع ریشه:
    م := مشتری { میزبان = "m"، نام کاربر = "u"، رمز عبور = "p"، گواهی = "c"، کلید = "k"، ب = ۲ }
    سرچاپ م.میزبان، م.نام کاربر، م.قاعده
    ن := مشتری { میزبان = "n"، توکن = "t" }
    سرچاپ ن.میزبان، ن.توکن
    سرچاپ حالت { راز = "s" }.راز
پایان
