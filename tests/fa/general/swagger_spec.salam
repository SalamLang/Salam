// زبان: فارسی
//
// سواگر به فارسی: مسیرها از مسیریاب خوانده می شوند و طرحواره ها از نوع داده،
// پس یک سند اوپن ای پی آی بدون نوشتن دستی هیچ طرحواره ای ساخته می شود.
واردکردن شبکه.مسیریاب شبکه
واردکردن شبکه.اچ تی تی پی شبکه.سواگر
واردکردن کدگذاری.جیسون

@doc "یک کار در فهرست"
ساختار کار:
    @doc "هنگام ساخته شدن داده می شود"
    عمومی شناسه: صحیح۶۴ = 0 بعنوان صحیح۶۴
    @doc "چه کاری باید انجام شود"
    عمومی عنوان: رشته = ""
    @json "" "omitempty"
    عمومی یادداشت: رشته = ""
تمام

ساختار درخواست:
    عمومی عنوان: رشته = ""
تمام

تابع فهرست کارها(_زمینه: صحیح۶۴): بازگشت تمام
تابع ساخت کار(_زمینه: صحیح۶۴): بازگشت تمام
تابع یک کار(_زمینه: صحیح۶۴): بازگشت تمام
تابع سلامت(_زمینه: صحیح۶۴): بازگشت تمام

تابع اصلی:
    متغیر مسیریاب := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.دریافت(مسیریاب, "/api/todos", فهرست کارها)
    مسیریاب شبکه.ارسال(مسیریاب, "/api/todos", ساخت کار)
    مسیریاب شبکه.دریافت(مسیریاب, "/api/todos/:id", یک کار)
    مسیریاب شبکه.دریافت(مسیریاب, "/health", سلامت)

    متغیر سند := سواگر.جدید("فهرست کارها", "۱.۰.۰")
    سواگر.توضیح(سند, "یک فهرست کار روی اچ تی تی پی")
    سواگر.سرور(سند, "http://127.0.0.1:8090", "محلی")
    سواگر.احراز هویت حامل(سند, "bearer", "JWT")

    // هر مسیری که مسیریاب دارد، چه توضیحی برایش نوشته شده باشد چه نه.
    سواگر.پویش(سند, مسیریاب)

    _الف := سواگر.در(سند, "GET", "/api/todos")
    سواگر.برچسب(سند, "کارها")
    سواگر.خلاصه(سند, "فهرست کارها")
    سواگر.پرسمان(سند, "status", "همه، باز یا انجام شده", نادرست)
    سواگر.برمی گرداند(سند, 200, "همه ی کارها", وکتور {} بعنوان وکتور<کار>)

    _ب := سواگر.در(سند, "POST", "/api/todos")
    سواگر.برچسب(سند, "کارها")
    سواگر.خلاصه(سند, "ساخت یک کار")
    سواگر.امن(سند, "bearer")
    سواگر.می پذیرد(سند, "کاری که ساخته می شود", درخواست {})
    سواگر.برمی گرداند(سند, 201, "کار، با شناسه اش", کار {})
    سواگر.برمی گرداند سرصفحه(سند, 201, "Location", "نشانی کار تازه")

    _پ := سواگر.در(سند, "GET", "/api/todos/:id")
    سواگر.برچسب(سند, "کارها")
    سواگر.پارامتر مسیر(سند, "id", "شناسه ی کار")
    سواگر.برمی گرداند(سند, 200, "خود کار", کار {})

    مشخصات := سواگر.مشخصات(سند)
    چاپ جیسون.معتبر(مشخصات)
    چاپ جیسون.دریافت(مشخصات, "openapi")

    مسیرها := جیسون.دریافت(مشخصات, "paths")
    کلیدها := جیسون.کلیدها(مسیرها)
    تعلیق کلیدها.آزادکن()
    تکرار کلیدها.طول() با ای:
        چاپ کلیدها.بگیر(ای)
    تمام

    طرحواره ها := جیسون.دریافت(جیسون.دریافت(مشخصات, "components"), "schemas")
    // توضیح فارسی از روی @doc به سند رسیده است.
    چاپ جیسون.دریافت(جیسون.دریافت(طرحواره ها, "کار"), "description")
    چاپ جیسون.دریافت(طرحواره ها, "کار")

    // آنچه در سند اشکال دارد، و آنچه فقط توضیح ندارد.
    مشکلات := سواگر.مشکلات(سند)
    تعلیق مشکلات.آزادکن()
    چاپ مشکلات.طول()
    بی توضیح := سواگر.توضیح داده نشده(سند)
    تعلیق بی توضیح.آزادکن()
    تکرار بی توضیح.طول() با ب:
        چاپ بی توضیح.بگیر(ب)
    تمام
    سواگر.آزاد سازی(سند)
تمام
