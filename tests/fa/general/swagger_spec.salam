واردسازی شبکه.مسیریاب شبکه
واردسازی شبکه.اچ تی تی پی شبکه.سواگر
واردسازی کدگذاری.جیسون

@doc "یک کار در فهرست"
ساختار کار:
    @doc "هنگام ساخته شدن داده می شود"
    همگانی شناسه: صحیح۶۴ = 0 برگردان صحیح۶۴
    @doc "چه کاری باید انجام شود"
    همگانی عنوان: رشته = ""
    @json "" "omitempty"
    همگانی یادداشت: رشته = ""
پایان

ساختار درخواست:
    همگانی عنوان: رشته = ""
پایان

روال فهرست کارها(_زمینه: صحیح۶۴): برگشت پایان
روال ساخت کار(_زمینه: صحیح۶۴): برگشت پایان
روال یک کار(_زمینه: صحیح۶۴): برگشت پایان
روال سلامت(_زمینه: صحیح۶۴): برگشت پایان

روال ریشه:
    ناپایا مسیریاب := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.دریافت(مسیریاب, "/api/todos", فهرست کارها)
    مسیریاب شبکه.ارسال(مسیریاب, "/api/todos", ساخت کار)
    مسیریاب شبکه.دریافت(مسیریاب, "/api/todos/:id", یک کار)
    مسیریاب شبکه.دریافت(مسیریاب, "/health", سلامت)

    ناپایا سند := سواگر.جدید("فهرست کارها", "۱.۰.۰")
    سواگر.توضیح(سند, "یک فهرست کار روی اچ تی تی پی")
    سواگر.سرور(سند, "http://127.0.0.1:8090", "محلی")
    سواگر.احراز هویت حامل(سند, "bearer", "JWT")

    سواگر.پویش(سند, مسیریاب)

    _الف := سواگر.در(سند, "GET", "/api/todos")
    سواگر.برچسب(سند, "کارها")
    سواگر.خلاصه(سند, "فهرست کارها")
    سواگر.پرسمان(سند, "status", "همه، باز یا انجام شده", نادرست)
    سواگر.برمی گرداند(سند, 200, "همه ی کارها", وکتور {} برگردان وکتور<کار>)

    _ب := سواگر.در(سند, "POST", "/api/todos")
    سواگر.برچسب(سند, "کارها")
    سواگر.خلاصه(سند, "ساخت یک کار")
    سواگر.امن(سند, "bearer")
    سواگر.می پذیرد(سند, "کاری که ساخته می شود", درخواست {})
    سواگر.برمی گرداند(سند, 201, "کار، با شناسه اش", کار {})
    سواگر.برمی گرداند سرصفحه(سند, 201, "Location", "نشانی کار تازه")

    _پ := سواگر.در(سند, "GET", "/api/todos/:id")
    سواگر.برچسب(سند, "کارها")
    سواگر.پارامتر مسیر(سند, "id", "شناسه ی کار")
    سواگر.برمی گرداند(سند, 200, "خود کار", کار {})

    مشخصات := سواگر.مشخصات(سند)
    سرچاپ جیسون.معتبر(مشخصات)
    سرچاپ جیسون.دریافت(مشخصات, "openapi")

    مسیرها := جیسون.دریافت(مشخصات, "paths")
    کلیدها := جیسون.کلیدها(مسیرها)
    دیرکن کلیدها.آزادکن()
    تکرار کلیدها.طول() از ای:
        سرچاپ کلیدها.بگیر(ای)
    پایان

    طرحواره ها := جیسون.دریافت(جیسون.دریافت(مشخصات, "components"), "schemas")
    سرچاپ جیسون.دریافت(جیسون.دریافت(طرحواره ها, "کار"), "description")
    سرچاپ جیسون.دریافت(طرحواره ها, "کار")

    مشکلات := سواگر.مشکلات(سند)
    دیرکن مشکلات.آزادکن()
    سرچاپ مشکلات.طول()
    بی توضیح := سواگر.توضیح داده نشده(سند)
    دیرکن بی توضیح.آزادکن()
    تکرار بی توضیح.طول() از ب:
        سرچاپ بی توضیح.بگیر(ب)
    پایان
    سواگر.آزاد سازی(سند)
پایان
