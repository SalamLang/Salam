بسته ریشه

واردسازی پایانه
واردسازی رشته
واردسازی محیط

تابع vis(s: رشته): رشته:
    برگشت رشته.جایگزینی(رشته.جایگزینی(s، "\x1b"، "<E>")، "\x07"، "<B>")
پایان

تابع show(label: رشته، s: رشته):
    سرچاپ label + " = " + vis(s)
پایان

تابع yn(b: منطقی): رشته:
    اگر b: برگشت "true" پایان
    برگشت "false"
پایان

تابع ریشه:
    پایانه.تنظیم حالت رنگ(پایانه.رنگ همیشه)
    show("dim"، پایانه.کم‌رنگ("x"))
    show("italic"، پایانه.کج("x"))
    show("blink"، پایانه.چشمک("x"))
    show("hidden"، پایانه.پنهان("x"))
    show("strike"، پایانه.خط‌خورده("x"))
    show("yellow"، پایانه.زرد("x"))
    show("magenta"، پایانه.ارغوانی("x"))
    show("cyan"، پایانه.فیروزه‌ای("x"))
    show("brightred"، پایانه.قرمز روشن("x"))
    show("brightgreen"، پایانه.سبز روشن("x"))
    show("brightyellow"، پایانه.زرد روشن("x"))
    show("brightmagenta"، پایانه.ارغوانی روشن("x"))
    show("brightcyan"، پایانه.فیروزه‌ای روشن("x"))
    show("brightwhite"، پایانه.سفید روشن("x"))
    show("ongreen"، پایانه.زمینه سبز("x"))
    show("onyellow"، پایانه.زمینه زرد("x"))
    show("onblue"، پایانه.زمینه آبی("x"))
    show("onmagenta"، پایانه.زمینه ارغوانی("x"))
    show("oncyan"، پایانه.زمینه فیروزه‌ای("x"))
    show("onwhite"، پایانه.زمینه سفید("x"))
    show("fg256"، پایانه.دنباله پیش‌زمینه۲۵۶(200))
    show("bg256"، پایانه.دنباله پس‌زمینه۲۵۶(17))
    show("fgrgb"، پایانه.دنباله پیش‌زمینه آراگابی(1، 2، 3))
    show("bgrgb"، پایانه.دنباله پس‌زمینه آراگابی(4، 5، 6))
    پایانه.تنظیم حالت رنگ(پایانه.رنگ خودکار)

    سرچاپ "tty-fd-matches = " + yn(پایانه.پایانه است(پایانه.شناسه خروجی) برابر پایانه.پایانه دارد())
    سرچاپ "tty-bad-fd = " + yn(پایانه.پایانه است(99))
    ct := محیط.دریافت("COLORTERM")
    سرچاپ "truecolor = " + yn(پایانه.رنگ کامل پشتیبانی می‌شود() برابر (ct برابر "truecolor" یا ct برابر "24bit"))
    t := محیط.دریافت("TERM")
    سرچاپ "256color = " + yn(پایانه.رنگ۲۵۶ پشتیبانی می‌شود() برابر (رشته.شامل است(t، "256color") یا ct.طول() بزرگتر 0))

    پایانه.نوشتن("emit:\n")
    پایانه.بالا(1)
    پایانه.نوشتن("\n")
    پایانه.پایین(2)
    پایانه.نوشتن("\n")
    پایانه.راست(3)
    پایانه.نوشتن("\n")
    پایانه.چپ(4)
    پایانه.نوشتن("\n")
    پایانه.خط بعد(2)
    پایانه.نوشتن("\n")
    پایانه.خط قبل(2)
    پایانه.نوشتن("\n")
    پایانه.ستون(5)
    پایانه.نوشتن("\n")
    پایانه.رفتن به(3، 4)
    پایانه.نوشتن("\n")
    پایانه.خانه()
    پایانه.نوشتن("\n")
    پایانه.ذخیره مکان‌نما()
    پایانه.نوشتن("\n")
    پایانه.بازیابی مکان‌نما()
    پایانه.نوشتن("\n")
    پایانه.پنهان‌سازی مکان‌نما()
    پایانه.نوشتن("\n")
    پایانه.نمایش مکان‌نما()
    پایانه.نوشتن("\n")
    پایانه.پاک‌سازی صفحه()
    پایانه.نوشتن("\n")
    پایانه.پاک‌سازی پیشینه()
    پایانه.نوشتن("\n")
    پایانه.پاک‌سازی خط()
    پایانه.نوشتن("\n")
    پایانه.پاک کردن انتهای خط()
    پایانه.نوشتن("\n")
    پایانه.پاک به پایین()
    پایانه.نوشتن("\n")
    پایانه.بازنشانی خط()
    پایانه.نوشتن("\n")
    پایانه.پیمایش بالا(1)
    پایانه.نوشتن("\n")
    پایانه.پیمایش پایین(1)
    پایانه.نوشتن("\n")
    پایانه.درج خط(2)
    پایانه.نوشتن("\n")
    پایانه.حذف خط(2)
    پایانه.نوشتن("\n")
    پایانه.تنظیم ناحیه پیمایش(1، 10)
    پایانه.نوشتن("\n")
    پایانه.بازنشانی ناحیه پیمایش()
    پایانه.نوشتن("\n")
    پایانه.ورود به صفحه جایگزین()
    پایانه.نوشتن("\n")
    پایانه.خروج از صفحه جایگزین()
    پایانه.نوشتن("\n")
    پایانه.فعال‌سازی موشواره()
    پایانه.نوشتن("\n")
    پایانه.غیرفعال‌سازی موشواره()
    پایانه.نوشتن("\n")
    پایانه.زنگ()
    پایانه.نوشتن("\n")
    پایانه.تنظیم عنوان("demo")
    پایانه.نوشتن("\n")
    پایانه.تخلیه()

    پایانه.تنظیم حالت رنگ(پایانه.بدون رنگ)
    ناپایا b := پایانه.نوار جدید(4، "job")
    b.پهنا = 8
    پایانه.تنظیم نوار(b، 2)
    پایانه.پایان نوار(b)

    ناپایا sp := پایانه.چرخنده جدید("wait")
    سرچاپ "frame-present = " + yn(پایانه.قاب چرخنده(sp).طول() بزرگتر 0)
    پایانه.تیک چرخنده(sp)
    پایانه.توقف چرخنده(sp، "spinner done")
    پایانه.آزادسازی چرخنده(sp)

    اگر پایانه.پایانه است(پایانه.شناسه ورودی) برابر نادرست:
        سرچاپ "key-ready = " + yn(پایانه.کلید آماده(0))
        سرچاپ "byte = " + رشته.از عدد(پایانه.خواندن بایت() برگردان صحیح۶۴)
        k := پایانه.خواندن کلید()
        سرچاپ "key-eof = " + yn(k.کد برابر پایانه.کلید انتهای ورودی)
        pw := پایانه.خواندن گذرواژه("password: ")
        سرچاپ "password-len = " + رشته.از عدد(pw.طول() برگردان صحیح۶۴)
    پایان

    پایانه.نوشتن خطا("to stderr\n")
    سرچاپ "done"
پایان
