// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی پایانه
واردسازی رشته
واردسازی محیط

تابع نمایان(s: رشته): رشته:
    برگشت رشته.جایگزینی(رشته.جایگزینی(s، "\x1b"، "<E>")، "\x07"، "<B>")
پایان

تابع نشان دادن(برچسب: رشته، s: رشته):
    سرچاپ برچسب + " = " + نمایان(s)
پایان

تابع پاسخ بلی خیر(b: منطقی): رشته:
    اگر b: برگشت "true" پایان
    برگشت "false"
پایان

تابع ریشه:
    پایانه.تنظیم حالت رنگ(پایانه.رنگ همیشه)
    نشان دادن("dim"، پایانه.کم‌رنگ("x"))
    نشان دادن("italic"، پایانه.کج("x"))
    نشان دادن("blink"، پایانه.چشمک("x"))
    نشان دادن("hidden"، پایانه.پنهان("x"))
    نشان دادن("strike"، پایانه.خط‌خورده("x"))
    نشان دادن("yellow"، پایانه.زرد("x"))
    نشان دادن("magenta"، پایانه.ارغوانی("x"))
    نشان دادن("cyan"، پایانه.فیروزه‌ای("x"))
    نشان دادن("brightred"، پایانه.قرمز روشن("x"))
    نشان دادن("brightgreen"، پایانه.سبز روشن("x"))
    نشان دادن("brightyellow"، پایانه.زرد روشن("x"))
    نشان دادن("brightmagenta"، پایانه.ارغوانی روشن("x"))
    نشان دادن("brightcyan"، پایانه.فیروزه‌ای روشن("x"))
    نشان دادن("brightwhite"، پایانه.سفید روشن("x"))
    نشان دادن("ongreen"، پایانه.زمینه سبز("x"))
    نشان دادن("onyellow"، پایانه.زمینه زرد("x"))
    نشان دادن("onblue"، پایانه.زمینه آبی("x"))
    نشان دادن("onmagenta"، پایانه.زمینه ارغوانی("x"))
    نشان دادن("oncyan"، پایانه.زمینه فیروزه‌ای("x"))
    نشان دادن("onwhite"، پایانه.زمینه سفید("x"))
    نشان دادن("fg256"، پایانه.دنباله پیش‌زمینه۲۵۶(200))
    نشان دادن("bg256"، پایانه.دنباله پس‌زمینه۲۵۶(17))
    نشان دادن("fgrgb"، پایانه.دنباله پیش‌زمینه آراگابی(1، 2، 3))
    نشان دادن("bgrgb"، پایانه.دنباله پس‌زمینه آراگابی(4، 5، 6))
    پایانه.تنظیم حالت رنگ(پایانه.رنگ خودکار)

    سرچاپ "tty-fd-matches = " + پاسخ بلی خیر(پایانه.پایانه است(پایانه.شناسه خروجی) برابر پایانه.پایانه دارد())
    سرچاپ "tty-bad-fd = " + پاسخ بلی خیر(پایانه.پایانه است(99))
    رنگ ترمینال := محیط.دریافت("COLORTERM")
    سرچاپ "truecolor = " + پاسخ بلی خیر(پایانه.رنگ کامل پشتیبانی می‌شود() برابر (رنگ ترمینال برابر "truecolor" یا رنگ ترمینال برابر "24bit"))
    t := محیط.دریافت("TERM")
    سرچاپ "256color = " + پاسخ بلی خیر(پایانه.رنگ۲۵۶ پشتیبانی می‌شود() برابر (رشته.شامل است(t، "256color") یا رنگ ترمینال.طول() بزرگتر 0))

    پایانه.نوشتن("emit:\n")
    پایانه.بالا(1)
    پایانه.نوشتن("\n")
    پایانه.پایین(2)
    پایانه.نوشتن("\n")
    پایانه.راست(3)
    پایانه.نوشتن("\n")
    پایانه.چپ(4)
    پایانه.نوشتن("\n")
    پایانه.خط بعد(2)
    پایانه.نوشتن("\n")
    پایانه.خط قبل(2)
    پایانه.نوشتن("\n")
    پایانه.ستون(5)
    پایانه.نوشتن("\n")
    پایانه.رفتن به(3، 4)
    پایانه.نوشتن("\n")
    پایانه.خانه()
    پایانه.نوشتن("\n")
    پایانه.ذخیره مکان‌نما()
    پایانه.نوشتن("\n")
    پایانه.بازیابی مکان‌نما()
    پایانه.نوشتن("\n")
    پایانه.پنهان‌سازی مکان‌نما()
    پایانه.نوشتن("\n")
    پایانه.نمایش مکان‌نما()
    پایانه.نوشتن("\n")
    پایانه.پاک‌سازی صفحه()
    پایانه.نوشتن("\n")
    پایانه.پاک‌سازی پیشینه()
    پایانه.نوشتن("\n")
    پایانه.پاک‌سازی خط()
    پایانه.نوشتن("\n")
    پایانه.پاک کردن انتهای خط()
    پایانه.نوشتن("\n")
    پایانه.پاک به پایین()
    پایانه.نوشتن("\n")
    پایانه.بازنشانی خط()
    پایانه.نوشتن("\n")
    پایانه.پیمایش بالا(1)
    پایانه.نوشتن("\n")
    پایانه.پیمایش پایین(1)
    پایانه.نوشتن("\n")
    پایانه.درج خط(2)
    پایانه.نوشتن("\n")
    پایانه.حذف خط(2)
    پایانه.نوشتن("\n")
    پایانه.تنظیم ناحیه پیمایش(1، 10)
    پایانه.نوشتن("\n")
    پایانه.بازنشانی ناحیه پیمایش()
    پایانه.نوشتن("\n")
    پایانه.ورود به صفحه جایگزین()
    پایانه.نوشتن("\n")
    پایانه.خروج از صفحه جایگزین()
    پایانه.نوشتن("\n")
    پایانه.فعال‌سازی موشواره()
    پایانه.نوشتن("\n")
    پایانه.غیرفعال‌سازی موشواره()
    پایانه.نوشتن("\n")
    پایانه.زنگ()
    پایانه.نوشتن("\n")
    پایانه.تنظیم عنوان("demo")
    پایانه.نوشتن("\n")
    پایانه.تخلیه()

    پایانه.تنظیم حالت رنگ(پایانه.بدون رنگ)
    ناپایا b := پایانه.نوار جدید(4، "job")
    b.پهنا = 8
    پایانه.تنظیم نوار(b، 2)
    پایانه.پایان نوار(b)

    ناپایا چرخنده := پایانه.چرخنده جدید("wait")
    سرچاپ "frame-present = " + پاسخ بلی خیر(پایانه.قاب چرخنده(چرخنده).طول() بزرگتر 0)
    پایانه.تیک چرخنده(چرخنده)
    پایانه.توقف چرخنده(چرخنده، "spinner done")
    پایانه.آزادسازی چرخنده(چرخنده)

    اگر پایانه.پایانه است(پایانه.شناسه ورودی) برابر نادرست:
        سرچاپ "key-ready = " + پاسخ بلی خیر(پایانه.کلید آماده(0))
        سرچاپ "byte = " + رشته.از عدد(پایانه.خواندن بایت() برگردان صحیح۶۴)
        کلید := پایانه.خواندن کلید()
        سرچاپ "key-eof = " + پاسخ بلی خیر(کلید.کد برابر پایانه.کلید انتهای ورودی)
        گذرواژه := پایانه.خواندن گذرواژه("password: ")
        سرچاپ "password-len = " + رشته.از عدد(گذرواژه.طول() برگردان صحیح۶۴)
    پایان

    پایانه.نوشتن خطا("to stderr\n")
    سرچاپ "done"
پایان
