تابع دسته(ن: صحیح): رشته:
    برگشت ن کوچکتر 0 ? "منفی" : ن برابر 0 ? "صفر" : "مثبت"
پایان

تابع ریشه:
    ط := 7
    سرچاپ ط بزرگتر 5 ؟ "بزرگ" : "کوچک"
    سرچاپ دسته(-4), دسته(0), دسته(9)
    سرچاپ درست ? نادرست ? 1 : 2 : 3
    ناپایا مجموع := 0
    تکرار 6 در شمارنده:
        مجموع += شمارنده % 2 برابر 0 ؟ شمارنده : 0
    پایان
    سرچاپ مجموع
پایان
