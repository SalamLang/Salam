پایا اندازه := 65536
پایا نسخه := "salam1"
پایا اشکال‌زدایی := نادرست

ساختار نقطه:
    همگانی ایکس: صحیح = 0
    همگانی ایگرگ: صحیح = 0
پایان

روال بلند(م: رشته): رشته:
    برگشت م.upper()
پایان

روال قاب(م: رشته): رشته:
    برگشت "[" + م + "]"
پایان

روال ریشه:
    نام := "علی"
    عدد := 7
    سرآیند := ```
        #define SALAM_OB_SZ ${{ اندازه }}
        #define HALF ${{اندازه / 2}}
        #define ABI "${{  نسخه  }}" debug=${{ اشکال‌زدایی }}
        static inline int nl(void) { return '\n' == 10; }
        ```
    سرچاپ سرآیند
    پیام := ```
        سلام ${{ نام }}، عدد=${{ عدد + 1 }} ${{ بلند("x") }} بزرگ=${{ عدد > 3 }}

            خط با تورفتگی
        نقطه=${{ نقطه { ایکس = 3، ایگرگ = 4 }.ایکس }} آکولاد=${{ «}}» }}
        پایان
        ```
    سرچاپ پیام
    گریز := ```
        متن: $${{ جایگذاری نمی‌شود }}
        ساده: $ {{a}} ${b} $$ }} {
        ```
    سرچاپ گریز
    سرچاپ قاب(```
        ${{ نام }} اول
        ```)
    سرچاپ "[" + ```
        بدون جایگذاری
        ``` + "]"
    سرچاپ ```
        چاپ مستقیم ${{ نام }}
        ```
    سرچاپ ```
        loud ${{ عدد }}
        ```.upper()
پایان
