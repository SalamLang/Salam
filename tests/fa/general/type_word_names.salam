گونه Bytes = اندازه

ساختار Buf:
    همگانی cap: صحیح = 0
    همگانی size: صحیح = 0
    همگانی len: صحیح = 0
    همگانی key: رشته = ""
پایان

روال grow(size: صحیح): صحیح:
    برگشت size * 2
پایان

روال half(n: اندازه): اندازه:
    برگشت n / (2 برگردان اندازه)
پایان

روال ریشه:
    size := 5
    total := size + grow(size)
    ناپایا b := Buf { size = total، key = "k" }
    b.cap = 64
    b.len = b.size / 3
    ناپایا m := نگاشت {} برگردان نگاشت<رشته، اندازه>
    m.درج("a"، 7 برگردان اندازه)
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    v.بیفزا(b.len)
    v.بیفزا(b.cap)
    w := 9 برگردان Bytes
    سرچاپ size، total، b.size، b.cap، b.len، b.key، v.طول()، v.بگیر(1)، m.بگیر("a")، half(w)
پایان
