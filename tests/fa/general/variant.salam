ساختار جعبه:
    همگانی برچسب: رشته
    همگانی مقدار: صحیح یا رشته یا منطقی
پایان

تابع شرح(م: صحیح یا رشته یا منطقی): رشته:
    برگشت همخوان م:
        صحیح ن: "عدد:" + ن پایان
        رشته س: "رشته:" + س پایان
        منطقی ب: "منطقی:" + ب پایان
    پایان
پایان

تابع ریشه:
    ناپایا خ := 42 برگردان (صحیح یا رشته یا منطقی)
    سرچاپ شرح(خ)
    خ = "سلام"
    سرچاپ شرح(خ)
    خ = درست
    سرچاپ شرح(خ)

    ج := جعبه { برچسب = "الف", مقدار = 7 }
    سرچاپ ج.برچسب + ":" + شرح(ج.مقدار)
پایان
