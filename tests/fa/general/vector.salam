کارکرد آغازین:
    گذرا بردار := وکتور {} برگردان وکتور<صحیح> دیرکرد بردار.آزادکن()
    گذرا نمایه := 0
    تاهنگام نمایه < 4:
        بردار.بیفزا(نمایه * 10)
        نمایه = نمایه + 1
    پایان
    چاپ بردار.طول()
    گذرا مجموع := 0
    نمایه = 0
    تاهنگام نمایه < بردار.طول():
        مجموع = مجموع + بردار.بگیر(نمایه)
        نمایه = نمایه + 1
    پایان
    چاپ مجموع
پایان
