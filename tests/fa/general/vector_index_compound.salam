ساختار خانه:
    همگانی عدد: صحیح = ۰
پایان

تابع ریشه():
    ناپایا شمار := وکتور {} برگردان وکتور<صحیح>
    تکرار ۴:
        شمار.بیفزا(۰)
    پایان
    ب := ۲
    شمار[ب + ۱] += ۵
    شمار[ب] -= ۲
    شمار[۱] += ۳
    شمار[۱] *= ۴
    شمار[۰] += شمار[۱]
    سرچاپ شمار[۰]، شمار[۱]، شمار[۲]، شمار[۳]
    ناپایا خانه ها := وکتور {} برگردان وکتور<خانه>
    خانه ها.بیفزا(خانه {})
    خانه ها[۰].عدد += ۷
    سرچاپ خانه ها[۰].عدد
پایان
