روال total(xs: وکتور<صحیح>): صحیح:
    ناپایا sum := 0
    تکرار xs.طول() در i:
        sum += xs.بگیر(i)
    پایان
    برگشت sum
پایان

روال add_twice(xs &: وکتور<صحیح>، v: صحیح):
    xs.بیفزا(v)
    xs.بیفزا(v)
پایان

روال evens(n: صحیح): وکتور<صحیح>:
    ناپایا out := وکتور {} برگردان وکتور<صحیح>
    تکرار n در i:
        اگر i % 2 == 0:
            out.بیفزا(i)
        پایان
    پایان
    برگشت out
پایان

روال longest(words: وکتور<رشته>): رشته:
    ناپایا best := ""
    تکرار words.طول() در i:
        اگر words.بگیر(i).طول() > best.طول():
            best = words.بگیر(i)
        پایان
    پایان
    برگشت best
پایان

روال ریشه:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    xs.بیفزا(4)
    add_twice(xs، 3)
    سرچاپ "total:"، total(xs)، "len:"، xs.طول()
    ev := evens(7)
    سرچاپ "evens:"، ev.طول()، total(ev)
    ناپایا words := وکتور {} برگردان وکتور<رشته>
    words.بیفزا("salam")
    words.بیفزا("hi")
    words.بیفزا("hello")
    سرچاپ "longest:"، longest(words)
پایان
