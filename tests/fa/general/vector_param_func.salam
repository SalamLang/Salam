تابع جمع کل(فهرست: وکتور<صحیح>): صحیح:
    ناپایا مجموع := 0
    تکرار فهرست.طول() در i:
        مجموع += فهرست.بگیر(i)
    پایان
    برگشت مجموع
پایان

تابع دو بار افزودن(فهرست &: وکتور<صحیح>، v: صحیح):
    فهرست.بیفزا(v)
    فهرست.بیفزا(v)
پایان

تابع اعداد زوج(n: صحیح): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    تکرار n در i:
        اگر i % 2 == 0:
            خروجی.بیفزا(i)
        پایان
    پایان
    برگشت خروجی
پایان

تابع بلندترین(واژه‌ها: وکتور<رشته>): رشته:
    ناپایا بهترین := ""
    تکرار واژه‌ها.طول() در i:
        اگر واژه‌ها.بگیر(i).طول() > بهترین.طول():
            بهترین = واژه‌ها.بگیر(i)
        پایان
    پایان
    برگشت بهترین
پایان

تابع ریشه:
    ناپایا فهرست := وکتور {} برگردان وکتور<صحیح>
    فهرست.بیفزا(4)
    دو بار افزودن(فهرست، 3)
    سرچاپ "total:"، جمع کل(فهرست)، "len:"، فهرست.طول()
    زوج‌ها := اعداد زوج(7)
    سرچاپ "evens:"، زوج‌ها.طول()، جمع کل(زوج‌ها)
    ناپایا واژه‌ها := وکتور {} برگردان وکتور<رشته>
    واژه‌ها.بیفزا("salam")
    واژه‌ها.بیفزا("hi")
    واژه‌ها.بیفزا("hello")
    سرچاپ "longest:"، بلندترین(واژه‌ها)
پایان
