واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.داخلی.سوکت خام
واردسازی رشته
واردسازی زمان

تابع دریافت کن(زمینه: صحیح۶۴): اچ تی تی پی.متن زمینه(زمینه, "GET-ok") پایان

تابع ارسال کن(زمینه: صحیح۶۴): اچ تی تی پی.متن زمینه(زمینه, "POST-ok") پایان

تابع جاگذار کن(زمینه: صحیح۶۴):
    اچ تی تی پی.متن زمینه(زمینه, "PUT-ok id=" + اچ تی تی پی.پارامتر زمینه(زمینه, "id"))
پایان

تابع حذف کن(زمینه: صحیح۶۴):
    اچ تی تی پی.متن زمینه(زمینه, "DELETE-ok id=" + اچ تی تی پی.پارامتر زمینه(زمینه, "id"))
پایان

تابع اجرای وب():
    ناپایا راهبر := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(راهبر, "/res", دریافت کن)
    مسیریاب.ارسال(راهبر, "/res", ارسال کن)
    مسیریاب.قراردادن(راهبر, "/res/:id", جاگذار کن)
    مسیریاب.حذف(راهبر, "/res/:id", حذف کن)
    کارساز := اچ تی تی پی.سرور جدید(19216)
    اچ تی تی پی.استفاده(کارساز, راهبر)
    اچ تی تی پی.اجرا(کارساز)
پایان

تابع درخواست(روش: رشته, مسیر: رشته): رشته:
    ناپایا سوکت := سوکت خام.اتصال("127.0.0.1", 19216)
    ناپایا تلاش := 0 برگردان صحیح۶۴
    تا وارونه سوکت خام.معتبر(سوکت) و تلاش < 200:
        زمان.خواب(10)
        سوکت = سوکت خام.اتصال("127.0.0.1", 19216)
        تلاش = تلاش + 1
    پایان
    اگر وارونه سوکت خام.معتبر(سوکت):
        برگشت ""
    پایان
    سوکت خام.ارسال(سوکت, روش + " " + مسیر + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
    پاسخ := سوکت خام.دریافت(سوکت, 8192)
    سوکت خام.بستن(سوکت)
    برگشت پاسخ
پایان

تابع ریشه:
    _نخ := نخ‌ساز(اجرای وب)

    سرچاپ رشته.شامل است(درخواست("GET", "/res"), "GET-ok")
    سرچاپ رشته.شامل است(درخواست("POST", "/res"), "POST-ok")

    سرچاپ رشته.شامل است(درخواست("PUT", "/res/7"), "PUT-ok id=7")
    سرچاپ رشته.شامل است(درخواست("DELETE", "/res/9"), "DELETE-ok id=9")

    سرچاپ رشته.شامل است(درخواست("PUT", "/res"), "404")
    سرچاپ رشته.شامل است(درخواست("GET", "/res/7"), "404")
پایان
