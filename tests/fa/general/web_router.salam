فراخوانی شبکه.اچ تی تی پی شبکه
فراخوانی شبکه.مسیریاب شبکه
فراخوانی شبکه.داخلی.سوکت خام شبکه
فراخوانی رشته
فراخوانی زمان

کارکرد دریافت کن(زمینه: صحیح۶۴): اچ تی تی پی شبکه.متن زمینه(زمینه, "GET-ok") پایان

کارکرد ارسال کن(زمینه: صحیح۶۴): اچ تی تی پی شبکه.متن زمینه(زمینه, "POST-ok") پایان

کارکرد جاگذار کن(زمینه: صحیح۶۴):
    اچ تی تی پی شبکه.متن زمینه(زمینه, "PUT-ok id=" + اچ تی تی پی شبکه.پارامتر زمینه(زمینه, "id"))
پایان

کارکرد حذف کن(زمینه: صحیح۶۴):
    اچ تی تی پی شبکه.متن زمینه(زمینه, "DELETE-ok id=" + اچ تی تی پی شبکه.پارامتر زمینه(زمینه, "id"))
پایان

کارکرد اجرای وب():
    گذرا مسیریاب := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.دریافت(مسیریاب, "/res", دریافت کن)
    مسیریاب شبکه.ارسال(مسیریاب, "/res", ارسال کن)
    مسیریاب شبکه.قراردادن(مسیریاب, "/res/:id", جاگذار کن)
    مسیریاب شبکه.حذف(مسیریاب, "/res/:id", حذف کن)
    کارساز := اچ تی تی پی شبکه.سرور جدید(19216)
    اچ تی تی پی شبکه.استفاده(کارساز, مسیریاب)
    اچ تی تی پی شبکه.اجرا(کارساز)
پایان

کارکرد درخواست(روش: رشته, مسیر: رشته): رشته:
    گذرا سوکت := سوکت خام شبکه.اتصال("127.0.0.1", 19216)
    گذرا تلاش := 0 برگردان صحیح۶۴
    تاهنگام !سوکت خام شبکه.معتبر(سوکت) و تلاش < 200:
        زمان.خواب(10)
        سوکت = سوکت خام شبکه.اتصال("127.0.0.1", 19216)
        تلاش = تلاش + 1
    پایان
    اگر !سوکت خام شبکه.معتبر(سوکت):
        بازگشت ""
    پایان
    سوکت خام شبکه.ارسال(سوکت, روش + " " + مسیر + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
    پاسخ := سوکت خام شبکه.دریافت(سوکت, 8192)
    سوکت خام شبکه.بستن(سوکت)
    بازگشت پاسخ
پایان

کارکرد آغازین:
    _نخ := spawn(اجرای وب)

    چاپ رشته.شامل است(درخواست("GET", "/res"), "GET-ok")
    چاپ رشته.شامل است(درخواست("POST", "/res"), "POST-ok")

    چاپ رشته.شامل است(درخواست("PUT", "/res/7"), "PUT-ok id=7")
    چاپ رشته.شامل است(درخواست("DELETE", "/res/9"), "DELETE-ok id=9")

    چاپ رشته.شامل است(درخواست("PUT", "/res"), "404")
    چاپ رشته.شامل است(درخواست("GET", "/res/7"), "404")
پایان
