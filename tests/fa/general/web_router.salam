// زبان: فارسی
واردکردن شبکه.اچ تی تی پی شبکه
واردکردن شبکه.مسیریاب شبکه
واردکردن شبکه.داخلی.سوکت خام شبکه
واردکردن رشته
واردکردن زمان

تابع دریافت کن(زمینه: صحیح۶۴): اچ تی تی پی شبکه.متن زمینه(زمینه, "GET-ok") تمام

تابع ارسال کن(زمینه: صحیح۶۴): اچ تی تی پی شبکه.متن زمینه(زمینه, "POST-ok") تمام

تابع جاگذار کن(زمینه: صحیح۶۴):
    اچ تی تی پی شبکه.متن زمینه(زمینه, "PUT-ok id=" + اچ تی تی پی شبکه.پارامتر زمینه(زمینه, "id"))
تمام

تابع حذف کن(زمینه: صحیح۶۴):
    اچ تی تی پی شبکه.متن زمینه(زمینه, "DELETE-ok id=" + اچ تی تی پی شبکه.پارامتر زمینه(زمینه, "id"))
تمام

تابع اجرای وب():
    متغیر مسیریاب := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.دریافت(مسیریاب, "/res", funcptr(دریافت کن))
    مسیریاب شبکه.ارسال(مسیریاب, "/res", funcptr(ارسال کن))
    مسیریاب شبکه.قراردادن(مسیریاب, "/res/:id", funcptr(جاگذار کن))
    مسیریاب شبکه.حذف(مسیریاب, "/res/:id", funcptr(حذف کن))
    کارساز := اچ تی تی پی شبکه.سرور جدید(19216)
    اچ تی تی پی شبکه.استفاده(کارساز, مسیریاب)
    اچ تی تی پی شبکه.اجرا(کارساز)
تمام

تابع درخواست(روش: رشته, مسیر: رشته): رشته:
    متغیر سوکت := سوکت خام شبکه.اتصال("127.0.0.1", 19216)
    متغیر تلاش := 0 بعنوان صحیح۶۴
    تاوقتی !سوکت خام شبکه.معتبر(سوکت) و تلاش < 200:
        زمان.خواب(10)
        سوکت = سوکت خام شبکه.اتصال("127.0.0.1", 19216)
        تلاش = تلاش + 1
    تمام
    اگر !سوکت خام شبکه.معتبر(سوکت):
        بازگشت ""
    تمام
    سوکت خام شبکه.ارسال(سوکت, روش + " " + مسیر + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
    پاسخ := سوکت خام شبکه.دریافت(سوکت, 8192)
    سوکت خام شبکه.بستن(سوکت)
    بازگشت پاسخ
تمام

تابع اصلی:
    _نخ := spawn(اجرای وب)

    چاپ رشته.شامل است(درخواست("GET", "/res"), "GET-ok")
    چاپ رشته.شامل است(درخواست("POST", "/res"), "POST-ok")

    چاپ رشته.شامل است(درخواست("PUT", "/res/7"), "PUT-ok id=7")
    چاپ رشته.شامل است(درخواست("DELETE", "/res/9"), "DELETE-ok id=9")

    چاپ رشته.شامل است(درخواست("PUT", "/res"), "404")
    چاپ رشته.شامل است(درخواست("GET", "/res/7"), "404")
تمام
