واردسازی شبکه.اچ تی تی پی شبکه
واردسازی شبکه.مسیریاب شبکه
واردسازی شبکه.اچ تی تی پی شبکه.اعتبارسنجی
واردسازی شبکه.اچ تی تی پی شبکه.میان افزار
واردسازی شبکه.داخلی.سوکت خام شبکه
واردسازی رشته
واردسازی زمان

روال بازتاب کن(زمینه: صحیح۶۴):
    بدنه := اچ تی تی پی شبکه.بدنه زمینه(زمینه)
    اچ تی تی پی شبکه.متن زمینه(زمینه, "got:" + بدنه)
پایان

روال پرسمان کن(زمینه: صحیح۶۴):
    نام := اچ تی تی پی شبکه.پرسمان زمینه(زمینه, "name")
    اچ تی تی پی شبکه.متن زمینه(زمینه, "hi " + نام)
پایان

روال امن کن(زمینه: صحیح۶۴):
    میان افزار.امن(زمینه)
    اچ تی تی پی شبکه.متن زمینه(زمینه, "secure")
پایان

روال هدایت کن(زمینه: صحیح۶۴):
    اچ تی تی پی شبکه.تغییرمسیر زمینه(زمینه, "/dest")
پایان

روال ثبت نام کن(زمینه: صحیح۶۴):
    ایمیل := اچ تی تی پی شبکه.فرم زمینه(زمینه, "email")
    اگر اعتبارسنجی.ایمیل است(ایمیل):
        اچ تی تی پی شبکه.متن زمینه(زمینه, "email-ok")
    وگرنه:
        اچ تی تی پی شبکه.وضعیت زمینه(زمینه, 400)
        اچ تی تی پی شبکه.متن زمینه(زمینه, "bad-email")
    پایان
پایان

روال اجرای وب():
    ناپایا مسیریاب := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.ارسال(مسیریاب, "/echo", بازتاب کن)
    مسیریاب شبکه.دریافت(مسیریاب, "/q", پرسمان کن)
    مسیریاب شبکه.دریافت(مسیریاب, "/sec", امن کن)
    مسیریاب شبکه.دریافت(مسیریاب, "/go", هدایت کن)
    مسیریاب شبکه.ارسال(مسیریاب, "/signup", ثبت نام کن)
    کارساز := اچ تی تی پی شبکه.سرور جدید(19215)
    اچ تی تی پی شبکه.استفاده(کارساز, مسیریاب)
    اچ تی تی پی شبکه.اجرا(کارساز)
پایان

روال ارسال خام(درخواست: رشته): رشته:
    ناپایا سوکت := سوکت خام شبکه.اتصال("127.0.0.1", 19215)
    ناپایا تلاش := 0 برگردان صحیح۶۴
    تا !سوکت خام شبکه.معتبر(سوکت) و تلاش < 200:
        زمان.خواب(10)
        سوکت = سوکت خام شبکه.اتصال("127.0.0.1", 19215)
        تلاش = تلاش + 1
    پایان
    اگر !سوکت خام شبکه.معتبر(سوکت):
        برگشت ""
    پایان
    سوکت خام شبکه.ارسال(سوکت, درخواست)
    پاسخ := سوکت خام شبکه.دریافت(سوکت, 8192)
    سوکت خام شبکه.بستن(سوکت)
    برگشت پاسخ
پایان

روال پست(مسیر: رشته, بدنه: رشته): رشته:
    درخواست := "POST " + مسیر + " HTTP/1.0\r\nHost: localhost\r\nContent-Length: " + رشته.از عدد(len(بدنه) برگردان صحیح۶۴) + "\r\n\r\n" + بدنه
    برگشت ارسال خام(درخواست)
پایان

روال گرفتن(مسیر: رشته): رشته:
    برگشت ارسال خام("GET " + مسیر + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
پایان

روال ریشه:
    _نخ := spawn(اجرای وب)

    نتیجه۱ := پست("/echo", "hello")
    سرچاپ رشته.شامل است(نتیجه۱, "got:hello")

    نتیجه۲ := گرفتن("/q?name=Sara")
    سرچاپ رشته.شامل است(نتیجه۲, "hi Sara")

    نتیجه۳ := گرفتن("/sec")
    سرچاپ رشته.شامل است(نتیجه۳, "X-Frame-Options: DENY")
    سرچاپ رشته.شامل است(نتیجه۳, "secure")

    نتیجه۴ := گرفتن("/go")
    سرچاپ رشته.شامل است(نتیجه۴, "302")
    سرچاپ رشته.شامل است(نتیجه۴, "Location: /dest")

    نتیجه۵ := پست("/signup", "email=a@b.com")
    سرچاپ رشته.شامل است(نتیجه۵, "email-ok")
    نتیجه۶ := پست("/signup", "email=nope")
    سرچاپ رشته.شامل است(نتیجه۶, "400")
    سرچاپ رشته.شامل است(نتیجه۶, "bad-email")
پایان
