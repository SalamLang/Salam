// زبان: فارسی
واردکردن شبکه.اچ تی تی پی شبکه
واردکردن شبکه.مسیریاب شبکه
واردکردن شبکه.اچ تی تی پی شبکه.اعتبارسنجی
واردکردن شبکه.اچ تی تی پی شبکه.میان افزار
واردکردن شبکه.داخلی.سوکت خام شبکه
واردکردن رشته
واردکردن زمان

تابع بازتاب کن(زمینه: صحیح۶۴):
    بدنه := اچ تی تی پی شبکه.بدنه زمینه(زمینه)
    اچ تی تی پی شبکه.متن زمینه(زمینه, "got:" + بدنه)
تمام

تابع پرسمان کن(زمینه: صحیح۶۴):
    نام := اچ تی تی پی شبکه.پرسمان زمینه(زمینه, "name")
    اچ تی تی پی شبکه.متن زمینه(زمینه, "hi " + نام)
تمام

تابع امن کن(زمینه: صحیح۶۴):
    میان افزار.امن(زمینه)
    اچ تی تی پی شبکه.متن زمینه(زمینه, "secure")
تمام

تابع هدایت کن(زمینه: صحیح۶۴):
    اچ تی تی پی شبکه.تغییرمسیر زمینه(زمینه, "/dest")
تمام

تابع ثبت نام کن(زمینه: صحیح۶۴):
    ایمیل := اچ تی تی پی شبکه.فرم زمینه(زمینه, "email")
    اگر اعتبارسنجی.ایمیل است(ایمیل):
        اچ تی تی پی شبکه.متن زمینه(زمینه, "email-ok")
    وگرنه:
        اچ تی تی پی شبکه.وضعیت زمینه(زمینه, 400)
        اچ تی تی پی شبکه.متن زمینه(زمینه, "bad-email")
    تمام
تمام

تابع اجرای وب():
    متغیر مسیریاب := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.ارسال(مسیریاب, "/echo", funcptr(بازتاب کن))
    مسیریاب شبکه.دریافت(مسیریاب, "/q", funcptr(پرسمان کن))
    مسیریاب شبکه.دریافت(مسیریاب, "/sec", funcptr(امن کن))
    مسیریاب شبکه.دریافت(مسیریاب, "/go", funcptr(هدایت کن))
    مسیریاب شبکه.ارسال(مسیریاب, "/signup", funcptr(ثبت نام کن))
    کارساز := اچ تی تی پی شبکه.سرور جدید(19215)
    اچ تی تی پی شبکه.استفاده(کارساز, مسیریاب)
    اچ تی تی پی شبکه.اجرا(کارساز)
تمام

تابع ارسال خام(درخواست: رشته): رشته:
    متغیر سوکت := سوکت خام شبکه.اتصال("127.0.0.1", 19215)
    متغیر تلاش := 0 بعنوان صحیح۶۴
    تاوقتی !سوکت خام شبکه.معتبر(سوکت) و تلاش < 200:
        زمان.خواب(10)
        سوکت = سوکت خام شبکه.اتصال("127.0.0.1", 19215)
        تلاش = تلاش + 1
    تمام
    اگر !سوکت خام شبکه.معتبر(سوکت):
        بازگشت ""
    تمام
    سوکت خام شبکه.ارسال(سوکت, درخواست)
    پاسخ := سوکت خام شبکه.دریافت(سوکت, 8192)
    سوکت خام شبکه.بستن(سوکت)
    بازگشت پاسخ
تمام

تابع پست(مسیر: رشته, بدنه: رشته): رشته:
    درخواست := "POST " + مسیر + " HTTP/1.0\r\nHost: localhost\r\nContent-Length: " + رشته.از عدد(len(بدنه) بعنوان صحیح۶۴) + "\r\n\r\n" + بدنه
    بازگشت ارسال خام(درخواست)
تمام

تابع گرفتن(مسیر: رشته): رشته:
    بازگشت ارسال خام("GET " + مسیر + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
تمام

تابع اصلی:
    _نخ := spawn(اجرای وب)

    نتیجه۱ := پست("/echo", "hello")
    چاپ رشته.شامل است(نتیجه۱, "got:hello")

    نتیجه۲ := گرفتن("/q?name=Sara")
    چاپ رشته.شامل است(نتیجه۲, "hi Sara")

    نتیجه۳ := گرفتن("/sec")
    چاپ رشته.شامل است(نتیجه۳, "X-Frame-Options: DENY")
    چاپ رشته.شامل است(نتیجه۳, "secure")

    نتیجه۴ := گرفتن("/go")
    چاپ رشته.شامل است(نتیجه۴, "302")
    چاپ رشته.شامل است(نتیجه۴, "Location: /dest")

    نتیجه۵ := پست("/signup", "email=a@b.com")
    چاپ رشته.شامل است(نتیجه۵, "email-ok")
    نتیجه۶ := پست("/signup", "email=nope")
    چاپ رشته.شامل است(نتیجه۶, "400")
    چاپ رشته.شامل است(نتیجه۶, "bad-email")
تمام
