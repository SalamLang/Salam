واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.اچ تی تی پی.اعتبارسنجی
واردسازی شبکه.اچ تی تی پی.میان افزار
واردسازی شبکه.داخلی.سوکت خام
واردسازی رشته
واردسازی زمان

روال بازتاب کن(زمینه: صحیح۶۴):
    بدنه := اچ تی تی پی.بدنه زمینه(زمینه)
    اچ تی تی پی.متن زمینه(زمینه, "got:" + بدنه)
پایان

روال پرسمان کن(زمینه: صحیح۶۴):
    نام := اچ تی تی پی.پرسمان زمینه(زمینه, "name")
    اچ تی تی پی.متن زمینه(زمینه, "hi " + نام)
پایان

روال امن کن(زمینه: صحیح۶۴):
    میان افزار.امن(زمینه)
    اچ تی تی پی.متن زمینه(زمینه, "secure")
پایان

روال هدایت کن(زمینه: صحیح۶۴):
    اچ تی تی پی.تغییرمسیر زمینه(زمینه, "/dest")
پایان

روال ثبت نام کن(زمینه: صحیح۶۴):
    ایمیل := اچ تی تی پی.فرم زمینه(زمینه, "email")
    اگر اعتبارسنجی.ایمیل است(ایمیل):
        اچ تی تی پی.متن زمینه(زمینه, "email-ok")
    وگرنه:
        اچ تی تی پی.وضعیت زمینه(زمینه, 400)
        اچ تی تی پی.متن زمینه(زمینه, "bad-email")
    پایان
پایان

روال اجرای وب():
    ناپایا راهبر := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(راهبر, "/echo", بازتاب کن)
    مسیریاب.دریافت(راهبر, "/q", پرسمان کن)
    مسیریاب.دریافت(راهبر, "/sec", امن کن)
    مسیریاب.دریافت(راهبر, "/go", هدایت کن)
    مسیریاب.ارسال(راهبر, "/signup", ثبت نام کن)
    کارساز := اچ تی تی پی.سرور جدید(19215)
    اچ تی تی پی.استفاده(کارساز, راهبر)
    اچ تی تی پی.اجرا(کارساز)
پایان

روال ارسال خام(درخواست: رشته): رشته:
    ناپایا سوکت := سوکت خام.اتصال("127.0.0.1", 19215)
    ناپایا تلاش := 0 برگردان صحیح۶۴
    تا وارونه سوکت خام.معتبر(سوکت) و تلاش < 200:
        زمان.خواب(10)
        سوکت = سوکت خام.اتصال("127.0.0.1", 19215)
        تلاش = تلاش + 1
    پایان
    اگر وارونه سوکت خام.معتبر(سوکت):
        برگشت ""
    پایان
    سوکت خام.ارسال(سوکت, درخواست)
    پاسخ := سوکت خام.دریافت(سوکت, 8192)
    سوکت خام.بستن(سوکت)
    برگشت پاسخ
پایان

روال پست(مسیر: رشته, بدنه: رشته): رشته:
    درخواست := "POST " + مسیر + " HTTP/1.0\r\nHost: localhost\r\nContent-Length: " + رشته.از عدد(طول(بدنه) برگردان صحیح۶۴) + "\r\n\r\n" + بدنه
    برگشت ارسال خام(درخواست)
پایان

روال گرفتن(مسیر: رشته): رشته:
    برگشت ارسال خام("GET " + مسیر + " HTTP/1.0\r\nHost: localhost\r\n\r\n")
پایان

روال ریشه:
    _نخ := نخ‌ساز(اجرای وب)

    نتیجه۱ := پست("/echo", "hello")
    سرچاپ رشته.شامل است(نتیجه۱, "got:hello")

    نتیجه۲ := گرفتن("/q?name=Sara")
    سرچاپ رشته.شامل است(نتیجه۲, "hi Sara")

    نتیجه۳ := گرفتن("/sec")
    سرچاپ رشته.شامل است(نتیجه۳, "X-Frame-Options: DENY")
    سرچاپ رشته.شامل است(نتیجه۳, "secure")

    نتیجه۴ := گرفتن("/go")
    سرچاپ رشته.شامل است(نتیجه۴, "302")
    سرچاپ رشته.شامل است(نتیجه۴, "Location: /dest")

    نتیجه۵ := پست("/signup", "email=a@b.com")
    سرچاپ رشته.شامل است(نتیجه۵, "email-ok")
    نتیجه۶ := پست("/signup", "email=nope")
    سرچاپ رشته.شامل است(نتیجه۶, "400")
    سرچاپ رشته.شامل است(نتیجه۶, "bad-email")
پایان
