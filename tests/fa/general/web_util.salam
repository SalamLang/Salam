// زبان: فارسی
واردکردن شبکه.اچ تی تی پی شبکه
واردکردن شبکه.مایم شبکه

تابع اصلی:
    چاپ اچ تی تی پی شبکه.رمزگشایی نشانی("a%20b") == "a b"
    چاپ اچ تی تی پی شبکه.رمزگشایی نشانی("a+b") == "a b"
    چاپ اچ تی تی پی شبکه.رمزگشایی نشانی("100%25") == "100%"
    چاپ اچ تی تی پی شبکه.رمزگشایی نشانی("name=Ali%20Reza") == "name=Ali Reza"
    چاپ اچ تی تی پی شبکه.رمزگشایی نشانی("plain") == "plain"

    چاپ مایم شبکه.پسوند مایم("html") == "text/html; charset=utf-8"
    چاپ مایم شبکه.پسوند مایم("css") == "text/css"
    چاپ مایم شبکه.پسوند مایم("js") == "application/javascript"
    چاپ مایم شبکه.پسوند مایم("png") == "image/png"
    چاپ مایم شبکه.پسوند مایم("unknownext") == "application/octet-stream"

    چاپ مایم شبکه.رده مایم("/assets/site.css") == "text/css"
    چاپ مایم شبکه.رده مایم("/img/logo.png") == "image/png"
    چاپ مایم شبکه.رده مایم("archive.tar.gz") == "application/octet-stream"
    چاپ مایم شبکه.رده مایم("noextension") == "application/octet-stream"

    چاپ مایم شبکه.متن وضعیت(200) == "OK"
    چاپ مایم شبکه.متن وضعیت(201) == "Created"
    چاپ مایم شبکه.متن وضعیت(404) == "Not Found"
    چاپ مایم شبکه.متن وضعیت(500) == "Internal Server Error"
    چاپ مایم شبکه.متن وضعیت(799) == "Unknown"

    چاپ اچ تی تی پی شبکه.نسخه سرور == "0.2.6"
تمام
