واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مایم

تابع ریشه:
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("a%20b") برابر "a b"
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("a+b") برابر "a b"
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("100%25") برابر "100%"
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("name=Ali%20Reza") برابر "name=Ali Reza"
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("plain") برابر "plain"

    سرچاپ مایم.پسوند مایم("html") برابر "text/html; charset=utf-8"
    سرچاپ مایم.پسوند مایم("css") برابر "text/css"
    سرچاپ مایم.پسوند مایم("js") برابر "application/javascript"
    سرچاپ مایم.پسوند مایم("png") برابر "image/png"
    سرچاپ مایم.پسوند مایم("unknownext") برابر "application/octet-stream"

    سرچاپ مایم.رده مایم("/assets/site.css") برابر "text/css"
    سرچاپ مایم.رده مایم("/img/logo.png") برابر "image/png"
    سرچاپ مایم.رده مایم("archive.tar.gz") برابر "application/octet-stream"
    سرچاپ مایم.رده مایم("noextension") برابر "application/octet-stream"

    سرچاپ مایم.متن وضعیت(200) برابر "OK"
    سرچاپ مایم.متن وضعیت(201) برابر "Created"
    سرچاپ مایم.متن وضعیت(404) برابر "Not Found"
    سرچاپ مایم.متن وضعیت(500) برابر "Internal Server Error"
    سرچاپ مایم.متن وضعیت(799) برابر "Unknown"

    سرچاپ اچ تی تی پی.نسخه سرور برابر سلام نگارش
پایان
