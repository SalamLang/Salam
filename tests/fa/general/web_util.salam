واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مایم

روال ریشه:
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("a%20b") == "a b"
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("a+b") == "a b"
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("100%25") == "100%"
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("name=Ali%20Reza") == "name=Ali Reza"
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("plain") == "plain"

    سرچاپ مایم.پسوند مایم("html") == "text/html; charset=utf-8"
    سرچاپ مایم.پسوند مایم("css") == "text/css"
    سرچاپ مایم.پسوند مایم("js") == "application/javascript"
    سرچاپ مایم.پسوند مایم("png") == "image/png"
    سرچاپ مایم.پسوند مایم("unknownext") == "application/octet-stream"

    سرچاپ مایم.رده مایم("/assets/site.css") == "text/css"
    سرچاپ مایم.رده مایم("/img/logo.png") == "image/png"
    سرچاپ مایم.رده مایم("archive.tar.gz") == "application/octet-stream"
    سرچاپ مایم.رده مایم("noextension") == "application/octet-stream"

    سرچاپ مایم.متن وضعیت(200) == "OK"
    سرچاپ مایم.متن وضعیت(201) == "Created"
    سرچاپ مایم.متن وضعیت(404) == "Not Found"
    سرچاپ مایم.متن وضعیت(500) == "Internal Server Error"
    سرچاپ مایم.متن وضعیت(799) == "Unknown"

    سرچاپ اچ تی تی پی.نسخه سرور == سلام نگارش
پایان
