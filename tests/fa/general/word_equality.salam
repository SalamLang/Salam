روال ریشه:
    الف := 3
    اگر الف برابر 3:
        سرچاپ "برابر"
    پایان
    اگر الف نابرابر 4:
        سرچاپ "نابرابر"
    پایان
    اگر الف برابر 4 یا الف نابرابر 3:
        سرچاپ "نه"
    وگرنه:
        سرچاپ "آری"
    پایان
    سرچاپ (الف برابر 3) و (الف نابرابر 5)
    نام := "سلام"
    سرچاپ نام برابر "سلام"، نام نابرابر "سلام"
    اگر (الف == 3) و (الف != 4):
        سرچاپ "نمادها"
    پایان
پایان
