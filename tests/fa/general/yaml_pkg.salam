واردسازی یامل

روال ریشه:
    سرچاپ یامل.رشته یامل(`hi "there"`)
    سرچاپ یامل.عضو("name", "salam")
    سرچاپ یامل.عضو عدد("age", 5)
    سرچاپ یامل.عضو منطقی("ok", درست)
    سرچاپ یامل.عضو اعشار("pi", 3.5)
    سرچاپ یامل.عضو خام("raw", "[1, 2, 3]")

    ناپایا برچسبها := وکتور {} برگردان وکتور<رشته>
    برچسبها.بیفزا(یامل.رشته یامل("a"))
    برچسبها.بیفزا(یامل.رشته یامل("b"))
    برچسبها_یامل := یامل.آرایه(برچسبها)
    سرچاپ برچسبها_یامل

    ناپایا نقطه := وکتور {} برگردان وکتور<رشته>
    نقطه.بیفزا(یامل.عضو عدد("x", 1))
    نقطه.بیفزا(یامل.عضو عدد("y", 2))
    نقطه_یامل := یامل.شیء(نقطه)
    سرچاپ نقطه_یامل

    ناپایا سند := وکتور {} برگردان وکتور<رشته>
    سند.بیفزا(یامل.عضو("name", "salam"))
    سند.بیفزا(یامل.عضو عدد("version", 2))
    سند.بیفزا(یامل.عضو منطقی("active", درست))
    سند.بیفزا(یامل.عضو خام("tags", برچسبها_یامل))
    سند.بیفزا(یامل.عضو خام("point", نقطه_یامل))
    سند_یامل := یامل.شیء(سند)
    سرچاپ سند_یامل

    بلوک := "name: salam\nversion: 2\nactive: true\ntags:\n  - a\n  - b\npoint:\n  x: 1\n  y: 2\n"
    سرچاپ یامل.تجزیه(بلوک)
    سرچاپ یامل.به جیسون(بلوک) == یامل.تجزیه(بلوک)

    سرچاپ یامل.معتبر(بلوک)
    سرچاپ یامل.معتبر("{ not: valid")
    سرچاپ یامل.معتبر("[1, 2")
    سرچاپ یامل.معتبر(`"unterminated`)

    سرچاپ یامل.دریافت(بلوک, "name")
    سرچاپ یامل.دریافت عدد(بلوک, "version")
    سرچاپ یامل.دریافت منطقی(بلوک, "active")
    سرچاپ یامل.دریافت(بلوک, "tags[0]")
    سرچاپ یامل.دریافت(بلوک, "tags[1]")
    سرچاپ یامل.دریافت عدد(بلوک, "point.x")
    سرچاپ یامل.دریافت عدد(بلوک, "point.y")
    سرچاپ یامل.دارد(بلوک, "point.y")
    سرچاپ یامل.دارد(بلوک, "missing")
    سرچاپ یامل.نوع(بلوک, "tags")
    سرچاپ یامل.نوع(بلوک, "point")
    سرچاپ یامل.نوع(بلوک, "name")
    سرچاپ یامل.نوع(بلوک, "version")
    سرچاپ یامل.نوع(بلوک, "missing")
    سرچاپ یامل.طول(بلوک, "tags")

    ناپایا نیازمند := وکتور {} برگردان وکتور<رشته>
    نیازمند.بیفزا("name")
    نیازمند.بیفزا("version")
    سرچاپ یامل.دارد کلیدها(بلوک, نیازمند)
    نیازمند.بیفزا("missing")
    سرچاپ یامل.دارد کلیدها(بلوک, نیازمند)

    جریان := "{a: 1, b: [1, 2, 3], c: {x: true, y: null}}"
    سرچاپ یامل.تجزیه(جریان)

    گیومه := "title: 'it''s here'\nurl: \"http://x:80/a#b\"\n"
    سرچاپ یامل.تجزیه(گیومه)

    بلوک_متن := "desc: |\n  line one\n  line two\nfolded: >\n  a b\n  c d\n"
    سرچاپ یامل.تجزیه(بلوک_متن)

    فهرست := "items:\n  - name: a\n    val: 1\n  - name: b\n    val: 2\n"
    سرچاپ یامل.تجزیه(فهرست)
    سرچاپ یامل.دریافت(فهرست, "items[1].name")
    سرچاپ یامل.دریافت عدد(فهرست, "items[0].val")

    چندسندی := "a: 1\n---\nb: 2\n"
    اسناد := یامل.تفکیک کردن اسناد(چندسندی)
    سرچاپ اسناد.طول()
    سرچاپ یامل.تجزیه(اسناد.بگیر(0))
    سرچاپ یامل.تجزیه(اسناد.بگیر(1))

    سرچاپ یامل.برونریزی(سند_یامل)
    سرچاپ یامل.برونریزی سفارشی(سند_یامل, "    ")
    سرچاپ یامل.برونریزی تب(سند_یامل)

    سرچاپ یامل.تجزیه(یامل.برونریزی(بلوک)) == یامل.تجزیه(بلوک)
پایان
