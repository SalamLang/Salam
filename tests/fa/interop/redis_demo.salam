واردسازی دیتابیس.ردیس

روال ریشه:
    ک := ردیس.اتصال("127.0.0.1", 6379)
    اگر ردیس.معتبر(ک):
        سرچاپ "اتصال به ردیس برقرار شد، پینگ:", ردیس.پینگ(ک)

        ردیس.تنظیم(ک, "salam:example:fa:greeting", "سلام از سلام")
        سرچاپ ردیس.دریافت(ک, "salam:example:fa:greeting")

        ردیس.حذف(ک, "salam:example:fa:visits")
        ردیس.افزایش(ک, "salam:example:fa:visits")
        ردیس.افزایش(ک, "salam:example:fa:visits")
        n := ردیس.افزایش(ک, "salam:example:fa:visits")
        سرچاپ "تعداد بازدید:", n

        ردیس.حذف(ک, "salam:example:fa:fruits")
        ردیس.افزودن به انتهای لیست(ک, "salam:example:fa:fruits", "سیب")
        ردیس.افزودن به انتهای لیست(ک, "salam:example:fa:fruits", "موز")
        ردیس.افزودن به انتهای لیست(ک, "salam:example:fa:fruits", "گیلاس")
        میوه ها := ردیس.بازه لیست(ک, "salam:example:fa:fruits", 0, 0 - 1)
        سرچاپ "میوه‌ها:"
        تکرار میوه ها.طول() از i:
            سرچاپ "  -", میوه ها.بگیر(i)
        پایان

        ردیس.حذف(ک, "salam:example:fa:greeting")
        ردیس.حذف(ک, "salam:example:fa:visits")
        ردیس.حذف(ک, "salam:example:fa:fruits")
        ردیس.بستن(ک)
    وگرنه:
        سرچاپ "اتصال به ردیس ممکن نشد:", ردیس.خطا(ک)
    پایان
پایان
