بسته ریشه

واردسازی تلگرام.بات

تابع ریشه:
    گفتگو := بات.تجزیه گفتگو(`{"id":-100123,"type":"supergroup","title":"Salam Dev","username":"salam_dev"}`)
    سرچاپ گفتگو.شناسه
    سرچاپ گفتگو.نوع
    سرچاپ گفتگو.عنوان
    سرچاپ گفتگو.نام کاربری
    سرچاپ بات.تجزیه گفتگو("").شناسه

    پیام := بات.تجزیه پیام(`{"message_id":7,"date":1700000001,"chat":{"id":55,"type":"private","first_name":"Sara","last_name":"K"},"from":{"id":55,"is_bot":false,"first_name":"Sara","language_code":"fa"},"text":"/ping now","reply_to_message":{"message_id":3,"from":{"id":9,"first_name":"Bot"}}}`)
    سرچاپ پیام.شناسه پیام
    سرچاپ پیام.زمان
    سرچاپ پیام.گفتگو.نام
    سرچاپ پیام.گفتگو.نام خانوادگی
    سرچاپ پیام.فرستنده.کد زبان
    سرچاپ پیام.متن
    سرچاپ پیام.پیام پاسخ‌داده‌شده.شناسه پیام
    سرچاپ پیام.پیام پاسخ‌داده‌شده.شناسه کاربر
    سرچاپ پیام.پیام پاسخ‌داده‌شده.نام کاربر

    پرسمان بازخوان := بات.تجزیه پرسمان بازخوان(`{"id":"cb1","from":{"id":55,"first_name":"Sara"},"message":{"message_id":8,"chat":{"id":55,"type":"private"}},"data":"yes"}`)
    سرچاپ پرسمان بازخوان.شناسه
    سرچاپ پرسمان بازخوان.کاربر.شناسه
    سرچاپ پرسمان بازخوان.پیام دارد
    سرچاپ پرسمان بازخوان.پیام.شناسه پیام
    سرچاپ پرسمان بازخوان.داده
    سرچاپ بات.تجزیه پرسمان بازخوان(`{"id":"cb2","data":"no"}`).پیام دارد

    پرسمان درون‌خطی := بات.تجزیه پرسمان درون خطی(`{"id":"iq1","from":{"id":77,"first_name":"Omid"},"query":"salam","offset":"10"}`)
    سرچاپ پرسمان درون‌خطی.شناسه
    سرچاپ پرسمان درون‌خطی.کاربر.نام
    سرچاپ پرسمان درون‌خطی.متن
    سرچاپ پرسمان درون‌خطی.جابجایی

    خام := `[{"update_id":1,"message":{"message_id":1,"chat":{"id":5,"type":"private"},"text":"a, b"}},{"update_id":2,"callback_query":{"id":"c","data":"d"}},{"update_id":3,"inline_query":{"id":"q","query":"x"}}]`
    بروزرسانی‌ها := بات.تجزیه بروزرسانی ها(خام)
    سرچاپ بروزرسانی‌ها.طول()
    سرچاپ بروزرسانی‌ها.بگیر(0).شناسه
    سرچاپ بروزرسانی‌ها.بگیر(0).پیام.متن
    سرچاپ بروزرسانی‌ها.بگیر(1).فشردن دکمه دارد
    سرچاپ بروزرسانی‌ها.بگیر(1).فشردن دکمه.داده
    سرچاپ بروزرسانی‌ها.بگیر(2).پرسمان درون‌خطی دارد
    سرچاپ بروزرسانی‌ها.بگیر(2).پرسمان درون‌خطی.متن
    سرچاپ بات.تجزیه بروزرسانی ها("[]").طول()

    b := بات.بات جدید("123:ABC")
    سرچاپ بات.پیوند فایل(b، "photos/file_1.jpg")

    سرچاپ بات.دکمه صفحه کلید("Yes")
    ناپایا ردیف := وکتور {} برگردان وکتور<رشته>
    ردیف.بیفزا(بات.دکمه صفحه کلید("Yes"))
    ردیف.بیفزا(بات.دکمه صفحه کلید("No"))
    ناپایا ردیف‌ها := وکتور {} برگردان وکتور<رشته>
    ردیف‌ها.بیفزا(بات.ردیف(ردیف))
    سرچاپ بات.صفحه کلید پاسخ(ردیف‌ها)
    سرچاپ بات.حذف صفحه کلید()
    سرچاپ بات.پاسخ اجباری()

    سرچاپ بات.پاسخ کنش گفتگو(55، "typing")
    سرچاپ بات.پاسخ ویرایش متن پیام(55، 8، "edited"، "")
    نشانه‌گذاری := بات.صفحه کلید درون خطی(ردیف‌ها)
    سرچاپ بات.پاسخ ویرایش متن پیام(55، 8، "edited"، نشانه‌گذاری)
پایان
