بسته ریشه

واردسازی تلگرام.بات

تابع ریشه:
    chat := بات.تجزیه گفتگو(`{"id":-100123,"type":"supergroup","title":"Salam Dev","username":"salam_dev"}`)
    سرچاپ chat.شناسه
    سرچاپ chat.نوع
    سرچاپ chat.عنوان
    سرچاپ chat.نام کاربری
    سرچاپ بات.تجزیه گفتگو("").شناسه

    msg := بات.تجزیه پیام(`{"message_id":7,"date":1700000001,"chat":{"id":55,"type":"private","first_name":"Sara","last_name":"K"},"from":{"id":55,"is_bot":false,"first_name":"Sara","language_code":"fa"},"text":"/ping now","reply_to_message":{"message_id":3,"from":{"id":9,"first_name":"Bot"}}}`)
    سرچاپ msg.شناسه پیام
    سرچاپ msg.زمان
    سرچاپ msg.گفتگو.نام
    سرچاپ msg.گفتگو.نام خانوادگی
    سرچاپ msg.فرستنده.کد زبان
    سرچاپ msg.متن
    سرچاپ msg.پیام پاسخ‌داده‌شده.شناسه پیام
    سرچاپ msg.پیام پاسخ‌داده‌شده.شناسه کاربر
    سرچاپ msg.پیام پاسخ‌داده‌شده.نام کاربر

    cq := بات.تجزیه پرسمان بازخوان(`{"id":"cb1","from":{"id":55,"first_name":"Sara"},"message":{"message_id":8,"chat":{"id":55,"type":"private"}},"data":"yes"}`)
    سرچاپ cq.شناسه
    سرچاپ cq.کاربر.شناسه
    سرچاپ cq.پیام دارد
    سرچاپ cq.پیام.شناسه پیام
    سرچاپ cq.داده
    سرچاپ بات.تجزیه پرسمان بازخوان(`{"id":"cb2","data":"no"}`).پیام دارد

    iq := بات.تجزیه پرسمان درون خطی(`{"id":"iq1","from":{"id":77,"first_name":"Omid"},"query":"salam","offset":"10"}`)
    سرچاپ iq.شناسه
    سرچاپ iq.کاربر.نام
    سرچاپ iq.متن
    سرچاپ iq.جابجایی

    raw := `[{"update_id":1,"message":{"message_id":1,"chat":{"id":5,"type":"private"},"text":"a, b"}},{"update_id":2,"callback_query":{"id":"c","data":"d"}},{"update_id":3,"inline_query":{"id":"q","query":"x"}}]`
    updates := بات.تجزیه بروزرسانی ها(raw)
    سرچاپ updates.طول()
    سرچاپ updates.بگیر(0).شناسه
    سرچاپ updates.بگیر(0).پیام.متن
    سرچاپ updates.بگیر(1).فشردن دکمه دارد
    سرچاپ updates.بگیر(1).فشردن دکمه.داده
    سرچاپ updates.بگیر(2).پرسمان درون‌خطی دارد
    سرچاپ updates.بگیر(2).پرسمان درون‌خطی.متن
    سرچاپ بات.تجزیه بروزرسانی ها("[]").طول()

    b := بات.بات جدید("123:ABC")
    سرچاپ بات.پیوند فایل(b، "photos/file_1.jpg")

    سرچاپ بات.دکمه صفحه کلید("Yes")
    ناپایا row := وکتور {} برگردان وکتور<رشته>
    row.بیفزا(بات.دکمه صفحه کلید("Yes"))
    row.بیفزا(بات.دکمه صفحه کلید("No"))
    ناپایا rows := وکتور {} برگردان وکتور<رشته>
    rows.بیفزا(بات.ردیف(row))
    سرچاپ بات.صفحه کلید پاسخ(rows)
    سرچاپ بات.حذف صفحه کلید()
    سرچاپ بات.پاسخ اجباری()

    سرچاپ بات.پاسخ کنش گفتگو(55، "typing")
    سرچاپ بات.پاسخ ویرایش متن پیام(55، 8، "edited"، "")
    markup := بات.صفحه کلید درون خطی(rows)
    سرچاپ بات.پاسخ ویرایش متن پیام(55، 8، "edited"، markup)
پایان
