// زبان: فارسی
تابع اصلی:
    الف := درست
    ب := نادرست
    چاپ الف && ب
    چاپ الف || ب
    چاپ !الف
    چاپ !ب
    چاپ (الف || ب) && !ب
    ایکس := 5
    چاپ ایکس > 0 && ایکس < 10
تمام
