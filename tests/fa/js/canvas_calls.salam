واردسازی دام
واردسازی وب.بوم

تابع ریشه:
    عنصر := دام.بساز("canvas")
    دام.تنظیم ویژگی(عنصر، "id"، "board")
    دام.تنظیم ویژگی(عنصر، "width"، "320")
    دام.تنظیم ویژگی(عنصر، "height"، "200")
    دام.افزودن(دام.بدنه()، عنصر)
    c := بوم.دریافت بوم("board")
    سرچاپ بوم.عرض(c)، بوم.ارتفاع(c)

    بوم.سبک پرشدگی(c، "#f5f0e6")
    سرچاپ دام.دریافت خاصیت رشته ای(c، "fillStyle")
    بوم.سبک خط(c، "#333")
    سرچاپ دام.دریافت خاصیت رشته ای(c، "strokeStyle")
    بوم.ضخامت خط(c، 2.5)
    سرچاپ دام.دریافت خاصیت عددی(c، "lineWidth")
    بوم.قلم(c، "16px Inter")
    سرچاپ دام.دریافت خاصیت رشته ای(c، "font")
    بوم.ترازبندی متن(c، "center")
    سرچاپ دام.دریافت خاصیت رشته ای(c، "textAlign")
    بوم.شفافیت(c، 0.5)
    سرچاپ دام.دریافت خاصیت عددی(c، "globalAlpha")

    بوم.پرکردن مستطیل(c، 0.0، 0.0، 10.0، 10.0)
    بوم.خط مستطیل(c، 1.0، 1.0، 8.0، 8.0)
    بوم.پاک کردن مستطیل(c، 2.0، 2.0، 4.0، 4.0)
    بوم.مستطیل گرد(c، 0.0، 0.0، 10.0، 10.0، 3.0)
    بوم.شروع مسیر(c)
    بوم.برو به(c، 0.0، 0.0)
    بوم.خط به(c، 5.0، 5.0)
    بوم.کمان(c، 5.0، 5.0، 2.0، 0.0، 6.28)
    بوم.بستن مسیر(c)
    بوم.پرکن(c)
    بوم.بکش(c)
    بوم.پرکردن متن(c، "hi"، 3.0، 3.0)
    بوم.ذخیره وضعیت(c)
    بوم.جابجایی مختصات(c، 1.0، 1.0)
    بوم.چرخش(c، 0.1)
    بوم.مقیاس(c، 2.0، 2.0)
    بوم.بازگردانی وضعیت(c)
    تصویر := دام.بارگذاری تصویر("logo.png")
    بوم.رسم تصویر(c، تصویر، 0.0، 0.0، 4.0، 4.0)

    فراخوانی‌ها := دام.دریافت خاصیت(c، "calls")
    هر نام در ["fillRect"، "strokeRect"، "clearRect"، "roundRect"، "beginPath"، "moveTo"، "lineTo"، "arc"، "closePath"، "fill"، "stroke"، "fillText"، "save"، "translate"، "rotate"، "scale"، "restore"، "drawImage"]:
        سرچاپ نام، دام.دریافت خاصیت عددی(فراخوانی‌ها، نام)
    پایان

    دیگری := دام.بساز("canvas")
    دومی := بوم.زمینه عنصر(دیگری)
    سرچاپ دام.دریافت خاصیت عددی(دام.دریافت خاصیت(دومی، "canvas")، "width")
    سرچاپ بوم.ارتفاع(دومی)
پایان
