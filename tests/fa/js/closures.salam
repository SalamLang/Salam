روال سازنده افزاینده(ن: صحیح): روال (صحیح) صحیح:
    برگشت (مقدار: صحیح) => مقدار + ن
پایان

روال ریشه:
    دوبرابر := (شمار: صحیح) => شمار * 2
    سرچاپ دوبرابر(21)
    افزاینده ده := سازنده افزاینده(10)
    سرچاپ افزاینده ده(5)
    ناپایا پایه := 100
    افزایش := ():
        پایه = پایه + 1
    پایان
    افزایش()
    افزایش()
    سرچاپ پایه
پایان
