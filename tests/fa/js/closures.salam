کارکرد سازنده افزاینده(ن: صحیح): کارکرد (صحیح) صحیح:
    بازگشت (مقدار: صحیح) => مقدار + ن
پایان

کارکرد آغازین:
    دوبرابر := (شمار: صحیح) => شمار * 2
    چاپ دوبرابر(21)
    افزاینده ده := سازنده افزاینده(10)
    چاپ افزاینده ده(5)
    گذرا پایه := 100
    افزایش := ():
        پایه = پایه + 1
    پایان
    افزایش()
    افزایش()
    چاپ پایه
پایان
