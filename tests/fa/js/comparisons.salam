// زبان: فارسی
تابع اصلی:
    چاپ 3 == 3
    چاپ 3 != 4
    چاپ 3 < 4
    چاپ 4 > 3
    چاپ 3 <= 3
    چاپ 4 >= 5
    چاپ "abc" == "abc"
    چاپ "abc" != "abd"
تمام
