واردسازی دام

تابع ریشه:
    عنصر := دام.بساز("span")
    دام.افزودن(دام.بدنه(), عنصر)
    دام.تنظیم ویژگی(عنصر, "data-role", "tag")
    سرچاپ دام.دریافت ویژگی(عنصر, "data-role")

    دام.افزودن کلاس(عنصر, "card")
    دام.افزودن کلاس(عنصر, "big")
    سرچاپ دام.دریافت ویژگی(عنصر, "class")

    دام.تعویض کلاس(عنصر, "big")
    سرچاپ دام.دریافت ویژگی(عنصر, "class")

    دام.تعویض کلاس(عنصر, "big")
    سرچاپ دام.دریافت ویژگی(عنصر, "class")

    دام.حذف کلاس(عنصر, "card")
    سرچاپ دام.دریافت ویژگی(عنصر, "class")
پایان
