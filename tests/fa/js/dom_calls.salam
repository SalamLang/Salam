واردسازی دام

ناپایا تیک‌ها := 0
ناپایا فعال‌شده := 0
ناپایا زمان‌سنج := 0 برگردان صحیح۶۴

تابع ریشه:
    سرچاپ دام.دریافت خاصیت عددی(دام.پنجره()، "innerWidth")
    دام.هشدار("hello")

    ریاضی := دام.سراسری("Math")
    سرچاپ دام.فراخوان(دام.سراسری("Date")، "now") بزرگتر 0
    سرچاپ دام.فراخوان یک(ریاضی، "abs"، 0.0 - 3.0)
    سرچاپ دام.فراخوان دو(ریاضی، "max"، 3.0، 9.0)
    سرچاپ دام.فراخوان سه(ریاضی، "min"، 5.0، 2.0، 8.0)
    سرچاپ دام.فراخوان چهار(ریاضی، "hypot"، 3.0، 4.0، 0.0، 0.0)

    نگه‌دار := ():
        فعال‌شده++
        سرچاپ "kept handler"
    پایان
    رفته := ():
        سرچاپ "removed handler ran"
    پایان
    تیک := ():
        تیک‌ها++
        سرچاپ "tick"، تیک‌ها
        اگر تیک‌ها برابر 3:
            دام.پاک کردن بازه(زمان‌سنج)
            سرچاپ "interval cleared"
        پایان
    پایان

    جعبه := دام.بساز("div")
    دام.تنظیم ویژگی(جعبه، "id"، "box")
    دام.افزودن(دام.بدنه()، جعبه)
    دام.فراخوان رشته دو(جعبه، "setAttribute"، "title"، "tip")
    سرچاپ دام.دریافت ویژگی(جعبه، "title")
    دام.تنظیم خاصیت(جعبه، "badge"، 42)
    سرچاپ دام.دریافت خاصیت عددی(جعبه، "badge")

    دکمه := دام.بساز("button")
    دام.تنظیم ویژگی(دکمه، "id"، "btn")
    دام.تنظیم ویژگی(دکمه، "data-autofire"، "click")
    دام.افزودن(دام.بدنه()، دکمه)
    دام.هنگام رویداد(دکمه، "click"، نگه‌دار)
    دام.هنگام رویداد(دکمه، "click"، رفته)
    دام.توقف رویداد(دکمه، "click"، رفته)
    دام.هنگام رویداد جزئی(
        دکمه، "click"، (رویداد: صحیح۶۴): سرچاپ "target:"، دام.دریافت ویژگی(دام.هدف رویداد(رویداد)، "id")
        دام.توقف انتشار(رویداد) پایان
    )

    دام.هنگام آماده(
        (): سرچاپ "ready" پایان
    )
    دام.رویداد پنجره(
        "resize"، (): سرچاپ "window resized" پایان
    )
    دام.رویداد جزئی پنجره(
        "resize"، (رویداد: صحیح۶۴): سرچاپ "window event:"، دام.دریافت خاصیت رشته ای(رویداد، "type") پایان
    )
    دام.درخواست فریم(
        (t: اعشار۶۴): سرچاپ "frame"، t پایان
    )

    تصویر := دام.بارگذاری تصویر("logo.png")
    سرچاپ دام.تصویر آماده(تصویر)
    دام.تنظیم خاصیت منطقی(تصویر، "complete"، درست)
    دام.تنظیم خاصیت عددی(تصویر، "naturalWidth"، 4.0)
    سرچاپ دام.تصویر آماده(تصویر)

    عنصر بوم := دام.بساز("canvas")
    دام.تنظیم ویژگی(عنصر بوم، "width"، "64")
    دام.افزودن(دام.بدنه()، عنصر بوم)
    زمینه ترسیم := دام.دریافت زمینه(عنصر بوم، "2d")
    سرچاپ دام.دریافت خاصیت عددی(دام.دریافت خاصیت(زمینه ترسیم، "canvas")، "width")

    زمان‌سنج = دام.تنظیم بازه(تیک، 5)
    لغوشده := دام.تنظیم مهلت(
        (): سرچاپ "cancelled timeout ran" پایان، 20
    )
    دام.پاک کردن مهلت(لغوشده)
    دام.تنظیم مهلت(
        (): سرچاپ "late timeout, clicks:"، فعال‌شده پایان، 200
    )
    سرچاپ "main done"
پایان
