واردسازی دام

ناپایا ticks := 0
ناپایا fired := 0
ناپایا timer := 0 برگردان صحیح۶۴

تابع ریشه:
    سرچاپ دام.دریافت خاصیت عددی(دام.پنجره()، "innerWidth")
    دام.هشدار("hello")

    math := دام.سراسری("Math")
    سرچاپ دام.فراخوان(دام.سراسری("Date")، "now") بزرگتر 0
    سرچاپ دام.فراخوان یک(math، "abs"، 0.0 - 3.0)
    سرچاپ دام.فراخوان دو(math، "max"، 3.0، 9.0)
    سرچاپ دام.فراخوان سه(math، "min"، 5.0، 2.0، 8.0)
    سرچاپ دام.فراخوان چهار(math، "hypot"، 3.0، 4.0، 0.0، 0.0)

    keep := ():
        fired = fired + 1
        سرچاپ "kept handler"
    پایان
    gone := ():
        سرچاپ "removed handler ran"
    پایان
    tick := ():
        ticks = ticks + 1
        سرچاپ "tick"، ticks
        اگر ticks برابر 3:
            دام.پاک کردن بازه(timer)
            سرچاپ "interval cleared"
        پایان
    پایان

    box := دام.بساز("div")
    دام.تنظیم ویژگی(box، "id"، "box")
    دام.افزودن(دام.بدنه()، box)
    دام.فراخوان رشته دو(box، "setAttribute"، "title"، "tip")
    سرچاپ دام.دریافت ویژگی(box، "title")
    دام.تنظیم خاصیت(box، "badge"، 42)
    سرچاپ دام.دریافت خاصیت عددی(box، "badge")

    btn := دام.بساز("button")
    دام.تنظیم ویژگی(btn، "id"، "btn")
    دام.تنظیم ویژگی(btn، "data-autofire"، "click")
    دام.افزودن(دام.بدنه()، btn)
    دام.هنگام رویداد(btn، "click"، keep)
    دام.هنگام رویداد(btn، "click"، gone)
    دام.توقف رویداد(btn، "click"، gone)
    دام.هنگام رویداد جزئی(
        btn، "click"، (ev: صحیح۶۴): سرچاپ "target:"، دام.دریافت ویژگی(دام.هدف رویداد(ev)، "id")
        دام.توقف انتشار(ev) پایان
    )

    دام.هنگام آماده(
        (): سرچاپ "ready" پایان
    )
    دام.رویداد پنجره(
        "resize"، (): سرچاپ "window resized" پایان
    )
    دام.رویداد جزئی پنجره(
        "resize"، (ev: صحیح۶۴): سرچاپ "window event:"، دام.دریافت خاصیت رشته ای(ev، "type") پایان
    )
    دام.درخواست فریم(
        (t: اعشار۶۴): سرچاپ "frame"، t پایان
    )

    img := دام.بارگذاری تصویر("logo.png")
    سرچاپ دام.تصویر آماده(img)
    دام.تنظیم خاصیت منطقی(img، "complete"، درست)
    دام.تنظیم خاصیت عددی(img، "naturalWidth"، 4.0)
    سرچاپ دام.تصویر آماده(img)

    canvas := دام.بساز("canvas")
    دام.تنظیم ویژگی(canvas، "width"، "64")
    دام.افزودن(دام.بدنه()، canvas)
    ctx := دام.دریافت زمینه(canvas، "2d")
    سرچاپ دام.دریافت خاصیت عددی(دام.دریافت خاصیت(ctx، "canvas")، "width")

    timer = دام.تنظیم بازه(tick، 5)
    cancelled := دام.تنظیم مهلت(
        (): سرچاپ "cancelled timeout ran" پایان، 20
    )
    دام.پاک کردن مهلت(cancelled)
    دام.تنظیم مهلت(
        (): سرچاپ "late timeout, clicks:"، fired پایان، 200
    )
    سرچاپ "main done"
پایان
