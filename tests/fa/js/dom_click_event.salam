واردسازی دام

ناپایا تعداد کلیک := 0

روال ریشه:
    دکمه := دام.بساز("button")
    دام.تنظیم ویژگی(دکمه, "id", "btn")
    دام.تنظیم ویژگی(دکمه, "data-autofire", "click")
    دام.افزودن(دام.بدنه(), دکمه)
    دام.هنگام رویداد(
        دکمه, "click", (): تعداد کلیک = تعداد کلیک + 1 سرچاپ "clicked" پایان
    )
    سرچاپ "before"
    سرچاپ تعداد کلیک
پایان
