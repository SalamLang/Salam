// زبان: فارسی
واردکردن دام

تابع اصلی:
    جعبه := دام.بساز("div")
    دام.تنظیم ویژگی(جعبه, "id", "box")
    دام.تنظیم متن(جعبه, "hello dom")
    دام.افزودن(دام.بدنه(), جعبه)

    یافته := دام.با شناسه("box")
    چاپ دام.دریافت متن(یافته)

    دام.تنظیم اچ تی ام ال(یافته, "<b>bold</b>")
    چاپ یافته != دام.بدنه()
تمام
