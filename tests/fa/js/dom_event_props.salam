// زبان: فارسی
واردکردن دام

تابع اصلی:
    عنصر := دام.بساز("div")
    دام.تنظیم ویژگی(عنصر, "id", "surface")
    دام.تنظیم ویژگی(عنصر, "data-autofire", "keydown")
    دام.تنظیم ویژگی(عنصر, "data-autofire-key", "Enter")
    دام.تنظیم ویژگی(عنصر, "data-autofire-x", "12")
    دام.تنظیم ویژگی(عنصر, "data-autofire-y", "34")
    دام.افزودن(دام.بدنه(), عنصر)
    دام.هنگام رویداد جزئی(
        عنصر, "keydown", (رویداد: صحیح۶۴): چاپ دام.کلید رویداد(رویداد) چاپ دام.رویداد افقی(رویداد) چاپ دام.رویداد عمودی(رویداد) دام.جلوگیری پیش فرض(رویداد) چاپ "handled" تمام
    )
    چاپ "ready"
تمام
