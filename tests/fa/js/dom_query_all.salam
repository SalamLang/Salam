واردسازی دام

روال ریشه:
    تکرار 3:
        مورد := دام.بساز("li")
        دام.تنظیم ویژگی(مورد, "class", "row")
        دام.تنظیم متن(مورد, "item")
        دام.افزودن(دام.بدنه(), مورد)
    پایان
    همه := دام.پرسمان همه(".row")
    سرچاپ دام.تعداد(همه)
    اولی := دام.عنصر شماره(همه, 0)
    سرچاپ دام.دریافت متن(اولی)
پایان
