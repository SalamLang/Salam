// زبان: فارسی
واردکردن دام

تابع اصلی:
    دام.تنظیم عدد ذخیره("count", 42)
    چاپ دام.دریافت عدد ذخیره("count")
    دام.تنظیم متن ذخیره("name", "salam")
    چاپ دام.دریافت متن ذخیره("name")
    چاپ دام.دریافت عدد ذخیره("missing")
    چاپ دام.دریافت متن ذخیره("missing") == ""
تمام
