فراخوانی دام

کارکرد آغازین:
    عنصر := دام.بساز("div")
    دام.افزودن(دام.بدنه(), عنصر)
    دام.تنظیم سبک(عنصر, "color", "red")
    دام.تنظیم سبک(عنصر, "font-size", "12px")
    چاپ دام.دریافت سبک(عنصر, "color")
    چاپ دام.دریافت سبک(عنصر, "font-size")
    دام.تنظیم سبک(عنصر, "color", "blue")
    چاپ دام.دریافت سبک(عنصر, "color")
پایان
