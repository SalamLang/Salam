// زبان: فارسی
واردکردن دام

تابع اصلی:
    ورودی := دام.بساز("input")
    دام.افزودن(دام.بدنه(), ورودی)
    دام.تنظیم مقدار(ورودی, "hello")
    چاپ دام.دریافت مقدار(ورودی)
    دام.تنظیم مقدار(ورودی, "world")
    چاپ دام.دریافت مقدار(ورودی)
تمام
