// زبان: فارسی
تابع اصلی:
    نامها := ["a", "b", "c"]
    هر ن در نامها:
        اگر ن != "b":
            چاپ ن
        تمام
    تمام
    اعداد := [10, 20, 30] بعنوان صحیح[3]
    متغیر جمع := 0
    هر ن در اعداد:
        جمع = جمع + ن
    تمام
    چاپ جمع
تمام
