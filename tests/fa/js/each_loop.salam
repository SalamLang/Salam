تابع ریشه:
    نامها := ["a", "b", "c"]
    هر ن در نامها:
        اگر ن != "b":
            سرچاپ ن
        پایان
    پایان
    اعداد := [10, 20, 30]
    ناپایا جمع := 0
    هر ن در اعداد:
        جمع = جمع + ن
    پایان
    سرچاپ جمع
پایان
