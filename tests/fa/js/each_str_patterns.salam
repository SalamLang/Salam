ساختار یادداشت:
    همگانی عنوان: رشته = ""
پایان

تابع واژه‌ها(متن: رشته): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    ناپایا جاری := ""
    هر ح در متن:
        اگر ح == " ":
            اگر جاری.طول() > 0:
                خروجی.بیفزا(جاری)
                جاری = ""
            پایان
            گذر
        پایان
        جاری = جاری + ح
    پایان
    اگر جاری.طول() > 0:
        خروجی.بیفزا(جاری)
    پایان
    برگشت خروجی
پایان

تابع فقط‌رقم(متن: رشته): رشته:
    همه := "0123456789۰۱۲۳۴۵۶۷۸۹"
    ناپایا خروجی := ""
    هر ح در متن:
        اگر همه.دربردارد(ح):
            خروجی = خروجی + ح
        پایان
    پایان
    برگشت خروجی
پایان

تابع نخستین‌غیراسکی(متن: رشته): صحیح:
    هر ش، ح در متن:
        اگر ح.طول() > 1:
            برگشت ش
        پایان
    پایان
    برگشت -1
پایان

تابع ریشه:
    فهرست := واژه‌ها("  سلام   دنیا  hello ")
    سرچاپ فهرست.طول()
    هر واژه در فهرست:
        چاپ "[" + واژه + "]"
    پایان
    سرچاپ ""
    ناپایا حرف‌ها := 0
    هر واژه در فهرست:
        هر _ در واژه:
            حرف‌ها += 1
        پایان
    پایان
    سرچاپ "حرف‌ها:"، حرف‌ها
    سرچاپ "رقم‌ها:"، فقط‌رقم("تلفن: ۰۲۱-۸۸۷۷ داخلی 42")
    سرچاپ "نخستین غیراسکی:"، نخستین‌غیراسکی("Hello سلام")، نخستین‌غیراسکی("plain")
    ناپایا رشته‌ی‌من := "abc"
    ناپایا دور := 0
    هر ح در رشته‌ی‌من:
        رشته‌ی‌من = رشته‌ی‌من + ح
        دور += 1
    پایان
    سرچاپ "عکس:"، رشته‌ی‌من، دور
    یاد := یادداشت { عنوان = "یادداشت" }
    ناپایا شمار := 0
    هر _ در یاد.عنوان:
        شمار += 1
    پایان
    سرچاپ "فیلد:"، شمار
    ناپایا نگار := نگاشت {} برگردان نگاشت<رشته، رشته>
    نگار.درج("fa"، "سلام")
    ناپایا کل := 0
    هر _، م در نگار:
        هر _ در م:
            کل += 1
        پایان
    پایان
    سرچاپ "مقدارهای نگاشت:"، کل
    ناپایا نگه := ""
    هر ش، ح در "a1b2c3":
        اگر ش % 2 == 1:
            گذر
        پایان
        اگر ش > 3:
            بشکن
        پایان
        نگه = نگه + ح
    پایان
    سرچاپ "نگه:"، نگه
پایان
