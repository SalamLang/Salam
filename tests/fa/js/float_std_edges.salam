واردسازی تبدیل
واردسازی کدگذاری.جیسون

ساختار خوانش:
    همگانی مقدار: اعشار۶۴ = 0.0
    همگانی شمار: صحیح = 0
پایان

تابع رمزگشایی(متن: رشته):
    ناپایا خوانده := خوانش {}
    تلاش:
        جیسون.واسریال سازی(متن، خوانده)
        سرچاپ "ok"، خوانده.مقدار، خوانده.شمار
    گرفتن خطا اشکال:
        سرچاپ "error"، اشکال.نوع برابر نوع خطا.خارج از بازه، اشکال.پیام
    پایان
پایان

تابع رمزگشایی مقدار(متن: رشته):
    تلاش:
        داده := جیسون.کدگشایی(متن)
        سرچاپ "ok"، جیسون.کدگذاری پیش فرض(داده)
    گرفتن خطا اشکال:
        سرچاپ "error"، اشکال.نوع برابر نوع خطا.خارج از بازه، اشکال.پیام
    پایان
پایان

تابع ریشه:
    صفر := 0.0
    ناعدد := صفر / صفر
    ناپایا جدول := نگاشت {} برگردان نگاشت<اعشار۶۴، صحیح>
    جدول.قراردادن(ناعدد، 3)
    جدول.قراردادن(ناعدد، 4)
    سرچاپ جدول.اندازه()، جدول.دریافت(ناعدد)، جدول.دارد(ناعدد)
    جدول.قراردادن(0.0، 1)
    جدول.قراردادن(-0.0، 2)
    جدول.قراردادن(-2.5، 5)
    جدول.قراردادن(12345.75، 6)
    جدول.قراردادن(-2.5، 7)
    سرچاپ جدول.اندازه()،
        جدول.دریافت(0.0)،
        جدول.دریافت(-0.0)،
        جدول.دریافت(-2.5)،
        جدول.دریافت(12345.75)
    سرچاپ جدول.حذف(ناعدد)، جدول.دارد(ناعدد)، جدول.اندازه()
    ناپایا جدولک := نگاشت {} برگردان نگاشت<اعشار۳۲، صحیح>
    صفرکوچک := 0.0 برگردان اعشار۳۲
    جدولک.قراردادن(صفرکوچک / صفرکوچک، 1)
    جدولک.قراردادن(صفرکوچک / صفرکوچک، 2)
    سرچاپ جدولک.اندازه()، جدولک.دریافت(صفرکوچک / صفرکوچک)

    سرچاپ تبدیل.قالب اعشار با دقت(1e21، 2)
    سرچاپ تبدیل.قالب اعشار با دقت(-1e22، 1)
    سرچاپ تبدیل.قالب اعشار با دقت(123456789012345678.0، 2)
    سرچاپ تبدیل.قالب اعشار با دقت(1e20، 0)
    سرچاپ تبدیل.قالب اعشار با دقت(12345.678، 15)
    سرچاپ تبدیل.قالب اعشار با دقت(1.5e30، 3).طول()
    سرچاپ تبدیل.قالب اعشار با دقت(0.000001، 3)
    سرچاپ تبدیل.قالب اعشار با دقت(0.125، 2)
    سرچاپ تبدیل.قالب اعشار با دقت(3.14159، 3)
    سرچاپ تبدیل.قالب اعشار با دقت(ناعدد، 2)،
        تبدیل.قالب اعشار با دقت(1.0 / صفر، 2)،
        تبدیل.قالب اعشار با دقت(-1.0 / صفر، 2)

    رمزگشایی(`{"مقدار": 1e400, "شمار": 1}`)
    رمزگشایی(`{"مقدار": -1e309, "شمار": 1}`)
    رمزگشایی(`{"مقدار": 1e-400, "شمار": 2}`)
    رمزگشایی(`{"مقدار": 1.5e300, "شمار": 3}`)
    رمزگشایی مقدار(`[1, 2.5, 1e400]`)
    رمزگشایی مقدار(`[1, 2.5, 1e-400]`)
پایان
