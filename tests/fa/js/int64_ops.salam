تابع عدد بزرگ(): صحیح۶۴:
    برگشت 1099511627776
پایان

تابع ریشه:
    یک := 1 برگردان صحیح۶۴
    سرچاپ یک << (40 برگردان صحیح۶۴)
    سرچاپ عدد بزرگ() >> (8 برگردان صحیح۶۴)
    سرچاپ (0 برگردان صحیح۶۴) - عدد بزرگ() >> (3 برگردان صحیح۶۴)
    سرچاپ عدد بزرگ() | (5 برگردان صحیح۶۴)
    سرچاپ (عدد بزرگ() + (255 برگردان صحیح۶۴)) & (4095 برگردان صحیح۶۴)
    سرچاپ عدد بزرگ() ^ (1099511627775 برگردان صحیح۶۴)
    سرچاپ ~عدد بزرگ()
    u := 3 برگردان طبیعی۶۴
    سرچاپ u + (5 برگردان طبیعی۶۴) - (7 برگردان طبیعی۶۴) == (1 برگردان طبیعی۶۴)
    سرچاپ (1 برگردان طبیعی۶۴) << (52 برگردان طبیعی۶۴)
    ناپایا w := 4503599627370495 برگردان طبیعی۶۴
    w &= 1099511627775 برگردان طبیعی۶۴
    سرچاپ w
    w |= 1 برگردان طبیعی۶۴ << (45 برگردان طبیعی۶۴)
    سرچاپ w
    w ^= 3 برگردان طبیعی۶۴
    سرچاپ w
    w <<= 2 برگردان طبیعی۶۴
    سرچاپ w
    w >>= 3 برگردان طبیعی۶۴
    سرچاپ w
    n := -5
    سرچاپ n برگردان صحیح۶۴
    سرچاپ (n برگردان صحیح۶۴) * عدد بزرگ()
    ناپایا x := 3 برگردان طبیعی۳۲
    x ^= 4294967295 برگردان طبیعی۳۲
    سرچاپ x
    x &= 2147483648 برگردان طبیعی۳۲
    سرچاپ x
    x |= 7 برگردان طبیعی۳۲
    سرچاپ x
    ناپایا y := 1 برگردان طبیعی۸
    y <<= 9 برگردان طبیعی۸
    سرچاپ y
    z := 7 برگردان اندازه مثبت
    سرچاپ z << (40 برگردان اندازه مثبت)
    s := 0 - 12
    سرچاپ s برگردان اندازه >> (1 برگردان اندازه)
پایان
