واردسازی کدگذاری.جیسون

ساختار نقطه:
    @جیسون "x"
    همگانی طول: اعشار۶۴ = 0.0
    @جیسون "y"
    همگانی عرض: اعشار۳۲ = 0.0 برگردان اعشار۳۲
    @جیسون "ys"
    همگانی عرضها: وکتور<اعشار۳۲> = وکتور {} برگردان وکتور<اعشار۳۲>
پایان

تابع نگهدار<گ>(مقدار: گ): گ:
    برگشت مقدار
پایان

تابع رمزگشایی(متن: رشته):
    ناپایا پ := نقطه {}
    تلاش:
        جیسون.واسریال سازی(متن، پ)
        سرچاپ "ok"، پ.عرض، جیسون.سریال سازی(پ)
    گرفتن خطا ی:
        سرچاپ "ERR"، ی.پیام
    پایان
پایان

تابع ریشه:
    ناپایا پ := نقطه { طول = نگهدار(0.1)، عرض = نگهدار(0.1 برگردان اعشار۳۲) }
    پ.عرضها.افزودن(نگهدار(1.5 برگردان اعشار۳۲))
    پ.عرضها.افزودن(نگهدار(3.4028234663852886e38) برگردان اعشار۳۲)
    پ.عرضها.افزودن(نگهدار(1e-45) برگردان اعشار۳۲)
    متن := جیسون.سریال سازی(پ)
    سرچاپ متن
    ناپایا برگشتی := نقطه {}
    تلاش:
        جیسون.واسریال سازی(متن، برگشتی)
    گرفتن خطا ی:
        سرچاپ "ERR"، ی.پیام
    پایان
    سرچاپ برگشتی.عرض برابر پ.عرض،
        برگشتی.عرضها.طول()،
        برگشتی.عرضها[1] برابر پ.عرضها[1]،
        برگشتی.عرضها[2] برابر پ.عرضها[2]
    رمزگشایی(`{"x":1,"y":0.30000001192092896,"ys":[]}`)
    رمزگشایی(`{"x":1,"y":3.4028235e38,"ys":[]}`)
    رمزگشایی(`{"x":1,"y":-3.4e38,"ys":[]}`)
    رمزگشایی(`{"x":1,"y":1e40,"ys":[]}`)
    رمزگشایی(`{"x":1,"y":-1e39,"ys":[]}`)
    رمزگشایی(`{"x":1,"y":2,"ys":[1,1e300]}`)
    رمزگشایی(`{"x":1,"y":1e-50,"ys":[]}`)
    پ.عرض = (نگهدار(1e30) برگردان اعشار۳۲) * (نگهدار(1e30) برگردان اعشار۳۲)
    سرچاپ جیسون.سریال سازی(پ)
    برگشتی.عرضها.آزادسازی()
    پ.عرضها.آزادسازی()
پایان
