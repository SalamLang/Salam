شمارش رنگ:
    قرمز
    سبز
    آبی
پایان

کارکرد دسته(ک: رنگ): رشته:
    بازگشت برگزین ک:
        قرمز => "گرم"
        سبز, آبی => "خنک"
    پایان
پایان

کارکرد شرح(خ: صحیح): رشته:
    مقدار := برگزین خ:
        1: بازگشت 42 پایان
        2: بازگشت "شاخه-رشته" پایان
        وگرنه: بازگشت درست پایان
    پایان
    بازگشت برگزین مقدار:
        صحیح عس => "عدد:" + عس
        رشته رس => "رشته:" + رس
        منطقی بس => "منطقی:" + بس
    پایان
پایان

کارکرد آغازین:
    چاپ دسته(رنگ.قرمز)
    چاپ دسته(رنگ.سبز)
    چاپ دسته(رنگ.آبی)

    ی := برگزین 2:
        1 => "یک"
        2 => "دو"
        وگرنه => "بسیار"
    پایان
    چاپ ی

    چاپ شرح(1)
    چاپ شرح(2)
    چاپ شرح(99)

    گذرا ن := 0
    تاهنگام ن < 3:
        برگزین ن:
            0: چاپ "صفر" پایان
            وگرنه:
                اگر ن == 2:
                    بشکن
                پایان
                چاپ "دیگر"
            پایان
        پایان
        ن = ن + 1
    پایان
    چاپ "تمام شد"
پایان
