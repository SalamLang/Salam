جداشمار رنگ:
    قرمز،
    سبز،
    آبی
پایان

روال دسته(ک: رنگ): رشته:
    برگشت همخوان ک:
        قرمز => "گرم"
        سبز, آبی => "خنک"
    پایان
پایان

روال شرح(خ: صحیح): رشته:
    مقدار := همخوان خ:
        1: برگشت 42 پایان
        2: برگشت "شاخه-رشته" پایان
        وگرنه: برگشت درست پایان
    پایان
    برگشت همخوان مقدار:
        صحیح عس => "عدد:" + عس
        رشته رس => "رشته:" + رس
        منطقی بس => "منطقی:" + بس
    پایان
پایان

روال ریشه:
    سرچاپ دسته(رنگ.قرمز)
    سرچاپ دسته(رنگ.سبز)
    سرچاپ دسته(رنگ.آبی)

    ی := همخوان 2:
        1 => "یک"
        2 => "دو"
        وگرنه => "بسیار"
    پایان
    سرچاپ ی

    سرچاپ شرح(1)
    سرچاپ شرح(2)
    سرچاپ شرح(99)

    ناپایا ن := 0
    تا ن < 3:
        همخوان ن:
            0: سرچاپ "صفر" پایان
            وگرنه:
                اگر ن == 2:
                    بشکن
                پایان
                سرچاپ "دیگر"
            پایان
        پایان
        ن = ن + 1
    پایان
    سرچاپ "تمام شد"
پایان
