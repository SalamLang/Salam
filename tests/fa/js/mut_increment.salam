// زبان: فارسی
تابع اصلی:
    متغیر مقدار := 0
    مقدار = مقدار + 1
    مقدار++
    مقدار += 5
    مقدار -= 2
    مقدار *= 3
    چاپ مقدار
    متغیر دیگر := 10
    دیگر--
    چاپ دیگر
تمام
