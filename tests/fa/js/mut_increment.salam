تابع ریشه:
    ناپایا مقدار := 0
    مقدار++
    مقدار++
    مقدار += 5
    مقدار -= 2
    مقدار *= 3
    سرچاپ مقدار
    ناپایا دیگر := 10
    دیگر--
    سرچاپ دیگر
پایان
