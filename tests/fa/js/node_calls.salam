واردسازی نود

تابع ریشه:
    سرچاپ نود.ویندوز است() برابر (نود.سکو() برابر "win32")

    ماژول فایل := نود.واردکردن("fs")
    صادرات‌ها := نود.صادرات()
    سرچاپ نود.بی‌مقدار است(صادرات‌ها)
    نود.تنظیم خاصیت رشته ای(صادرات‌ها، "name"، "demo")
    نود.تنظیم خاصیت عددی(صادرات‌ها، "count"، 3.0)
    نود.تنظیم خاصیت منطقی(صادرات‌ها، "ready"، درست)
    سرچاپ نود.دریافت خاصیت رشته ای(صادرات‌ها، "name")، نود.دریافت خاصیت عددی(صادرات‌ها، "count")، نود.دریافت خاصیت منطقی(صادرات‌ها، "ready")
    درونی := نود.شیء تازه()
    نود.تنظیم خاصیت عددی(درونی، "value"، 7.0)
    نود.تنظیم خاصیت(صادرات‌ها، "inner"، درونی)
    سرچاپ نود.دریافت خاصیت عددی(نود.دریافت خاصیت(صادرات‌ها، "inner")، "value")

    فهرست := نود.آرایه تازه()
    نود.افزودن رشته به آرایه(فهرست، "b")
    نود.افزودن رشته به آرایه(فهرست، "a")
    نود.افزودن رشته به آرایه(فهرست، "c")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان(فهرست، "reverse"))
    سرچاپ نود.تبدیل به منطقی(نود.فراخوان رشته یک(فهرست، "includes"، "a"))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان رشته دو(نود.سراسری("Math")، "hypot"، "3"، "4"))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان رشته سه(فهرست، "splice"، "0"، "1"، "z"))
    سرچاپ نود.تبدیل به رشته(فهرست)

    دیگری := نود.آرایه تازه()
    نود.افزودن به آرایه(دیگری، نود.سراسری("Math"))
    سرچاپ نود.دریافت خاصیت عددی(دیگری، "length")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با دو مقدار(نود.سراسری("Math")، "max"، نود.دریافت خاصیت(فهرست، "length")، نود.دریافت خاصیت(فهرست، "length")))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با سه مقدار(نود.سراسری("Math")، "min"، نود.دریافت خاصیت(فهرست، "length")، نود.دریافت خاصیت(فهرست، "length")، نود.دریافت خاصیت(فهرست، "length")))

    نود.تنظیم خاصیت به تابعی بدون آرگومان(
        صادرات‌ها، "ping"، (): سرچاپ "ping called" پایان
    )
    نود.فراخوان(صادرات‌ها، "ping")
    نود.تنظیم خاصیت به تابعی یک آرگومانی بازگشتی(
        صادرات‌ها، "double"، (x: صحیح۶۴): برگشت نود.فراخوان با یک مقدار(نود.سراسری("Math")، "abs"، x) پایان
    )
    سرچاپ نود.بی‌مقدار است(نود.دریافت خاصیت(صادرات‌ها، "double"))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان مقدار تابعی با یک آرگومان(نود.دریافت خاصیت(نود.سراسری("Math")، "abs")، نود.دریافت خاصیت(نود.سراسری("Number")، "NaN")))

    آرایه دو := نود.آرایه تازه()
    نود.افزودن رشته به آرایه(آرایه دو، "x")
    نود.افزودن رشته به آرایه(آرایه دو، "y")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با یک منطقی(نود.سراسری("JSON")، "stringify"، درست))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با مقدار سپس رشته(آرایه دو، "fill"، نود.دریافت خاصیت(آرایه دو، "length")، "z"))
    نود.فراخوان با تابعی یک آرگومانی(آرایه دو، "forEach"، (x: صحیح۶۴): سرچاپ "element:"، نود.تبدیل به رشته(x) پایان)
    نود.فراخوان با تابعی بدون آرگومان(نود.سراسری("process")، "nextTick"، (): سرچاپ "tick" پایان)
    گسیل‌گر := نود.ساخت(نود.دریافت خاصیت(نود.واردکردن("events")، "EventEmitter"))
    نود.فراخوان با رشته سپس تابعی بدون آرگومان(گسیل‌گر، "on"، "ping"، (): سرچاپ "pinged" پایان)
    نود.فراخوان رشته یک(گسیل‌گر، "emit"، "ping")
    نود.تنظیم خاصیت به تابعی یک آرگومانی(گسیل‌گر، "show"، (x: صحیح۶۴): سرچاپ "show:"، نود.تبدیل به رشته(x) پایان)
    نود.فراخوان مقدار تابعی با دو آرگومان(نود.دریافت خاصیت(گسیل‌گر، "show")، آرایه دو، آرایه دو)
    نود.فراخوان مقدار تابعی(نود.دریافت خاصیت(گسیل‌گر، "show"))
    تاریخ := نود.ساخت با چهار مقدار(نود.سراسری("Date")، نود.دریافت خاصیت(نود.سراسری("Number")، "EPSILON")، نود.دریافت خاصیت(نود.سراسری("Number")، "EPSILON")، نود.دریافت خاصیت(نود.سراسری("Number")، "EPSILON")، نود.دریافت خاصیت(نود.سراسری("Number")، "EPSILON"))
    سرچاپ نود.بی‌مقدار است(تاریخ)
    وعده := نود.وعده تازه((حل: صحیح۶۴، رد: صحیح۶۴): نود.فراخوان مقدار تابعی با یک آرگومان(حل، رد) پایان)
    سرچاپ نود.بی‌مقدار است(وعده)

    پایه := نود.پوشه موقت()
    سرچاپ پایه.طول() بزرگتر 0
    پوشه := نود.ساخت پوشه موقت(نود.پیوستن مسیر(پایه، "salam-node-"))
    پرونده := نود.پیوستن مسیر سه(پوشه، "sub"، "note.txt")
    سرچاپ نود.پوشه مسیر(پرونده) برابر نود.پیوستن مسیر(پوشه، "sub")
    نود.فراخوان با رشته سپس منطقی(ماژول فایل، "mkdirSync"، نود.پیوستن مسیر(پوشه، "sub")، درست)
    نود.نوشتن فایل(پرونده، "hello node")
    سرچاپ نود.خواندن فایل(پرونده)
    نود.حذف بازگشتی(پوشه)
    سرچاپ نود.تبدیل به منطقی(نود.فراخوان رشته یک(ماژول فایل، "existsSync"، پوشه))

    آرگومان‌ها := نود.آرایه تازه()
    نود.افزودن رشته به آرایه(آرگومان‌ها، "-e")
    نود.افزودن رشته به آرایه(آرگومان‌ها، "console.log('child ok')")
    نود.اجرای فایل فرزند(
        "node"، آرگومان‌ها، پایه، (ناموفق: منطقی، خروجی‌استاندارد: رشته، خروجی‌خطا: رشته): سرچاپ "child:"، ناموفق، خروجی‌استاندارد.طول()،
        خروجی‌خطا.طول()
        نود.اجرای فایل فرزند خام(
            "node"، آرگومان‌ها، پایه، (کد: صحیح۶۴، خروجی‌دو: رشته، خطای‌دو: رشته): سرچاپ "raw:"، نود.بی‌مقدار است(کد)،
            خروجی‌دو.طول()، خطای‌دو.طول() پایان
        ) پایان
    )
پایان
