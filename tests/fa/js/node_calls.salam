واردسازی نود

تابع ریشه:
    سرچاپ نود.ویندوز است() برابر (نود.سکو() برابر "win32")

    fsm := نود.واردکردن("fs")
    exp := نود.صادرات()
    سرچاپ نود.بی‌مقدار است(exp)
    نود.تنظیم خاصیت رشته ای(exp، "name"، "demo")
    نود.تنظیم خاصیت عددی(exp، "count"، 3.0)
    نود.تنظیم خاصیت منطقی(exp، "ready"، درست)
    سرچاپ نود.دریافت خاصیت رشته ای(exp، "name")، نود.دریافت خاصیت عددی(exp، "count")، نود.دریافت خاصیت منطقی(exp، "ready")
    inner := نود.شیء تازه()
    نود.تنظیم خاصیت عددی(inner، "value"، 7.0)
    نود.تنظیم خاصیت(exp، "inner"، inner)
    سرچاپ نود.دریافت خاصیت عددی(نود.دریافت خاصیت(exp، "inner")، "value")

    list := نود.آرایه تازه()
    نود.افزودن رشته به آرایه(list، "b")
    نود.افزودن رشته به آرایه(list، "a")
    نود.افزودن رشته به آرایه(list، "c")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان(list، "reverse"))
    سرچاپ نود.تبدیل به منطقی(نود.فراخوان رشته یک(list، "includes"، "a"))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان رشته دو(نود.سراسری("Math")، "hypot"، "3"، "4"))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان رشته سه(list، "splice"، "0"، "1"، "z"))
    سرچاپ نود.تبدیل به رشته(list)

    other := نود.آرایه تازه()
    نود.افزودن به آرایه(other، نود.سراسری("Math"))
    سرچاپ نود.دریافت خاصیت عددی(other، "length")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با دو مقدار(نود.سراسری("Math")، "max"، نود.دریافت خاصیت(list، "length")، نود.دریافت خاصیت(list، "length")))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با سه مقدار(نود.سراسری("Math")، "min"، نود.دریافت خاصیت(list، "length")، نود.دریافت خاصیت(list، "length")، نود.دریافت خاصیت(list، "length")))

    نود.تنظیم خاصیت به تابعی بدون آرگومان(
        exp، "ping"، (): سرچاپ "ping called" پایان
    )
    نود.فراخوان(exp، "ping")
    نود.تنظیم خاصیت به تابعی یک آرگومانی بازگشتی(
        exp، "double"، (x: صحیح۶۴): برگشت نود.فراخوان با یک مقدار(نود.سراسری("Math")، "abs"، x) پایان
    )
    سرچاپ نود.بی‌مقدار است(نود.دریافت خاصیت(exp، "double"))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان مقدار تابعی با یک آرگومان(نود.دریافت خاصیت(نود.سراسری("Math")، "abs")، نود.دریافت خاصیت(نود.سراسری("Number")، "NaN")))

    arr2 := نود.آرایه تازه()
    نود.افزودن رشته به آرایه(arr2، "x")
    نود.افزودن رشته به آرایه(arr2، "y")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با یک منطقی(نود.سراسری("JSON")، "stringify"، درست))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با مقدار سپس رشته(arr2، "fill"، نود.دریافت خاصیت(arr2، "length")، "z"))
    نود.فراخوان با تابعی یک آرگومانی(arr2، "forEach"، (x: صحیح۶۴): سرچاپ "element:"، نود.تبدیل به رشته(x) پایان)
    نود.فراخوان با تابعی بدون آرگومان(نود.سراسری("process")، "nextTick"، (): سرچاپ "tick" پایان)
    emitter := نود.ساخت(نود.دریافت خاصیت(نود.واردکردن("events")، "EventEmitter"))
    نود.فراخوان با رشته سپس تابعی بدون آرگومان(emitter، "on"، "ping"، (): سرچاپ "pinged" پایان)
    نود.فراخوان رشته یک(emitter، "emit"، "ping")
    نود.تنظیم خاصیت به تابعی یک آرگومانی(emitter، "show"، (x: صحیح۶۴): سرچاپ "show:"، نود.تبدیل به رشته(x) پایان)
    نود.فراخوان مقدار تابعی با دو آرگومان(نود.دریافت خاصیت(emitter، "show")، arr2، arr2)
    نود.فراخوان مقدار تابعی(نود.دریافت خاصیت(emitter، "show"))
    date := نود.ساخت با چهار مقدار(نود.سراسری("Date")، نود.دریافت خاصیت(نود.سراسری("Number")، "EPSILON")، نود.دریافت خاصیت(نود.سراسری("Number")، "EPSILON")، نود.دریافت خاصیت(نود.سراسری("Number")، "EPSILON")، نود.دریافت خاصیت(نود.سراسری("Number")، "EPSILON"))
    سرچاپ نود.بی‌مقدار است(date)
    promise := نود.وعده تازه((resolve: صحیح۶۴، reject: صحیح۶۴): نود.فراخوان مقدار تابعی با یک آرگومان(resolve، reject) پایان)
    سرچاپ نود.بی‌مقدار است(promise)

    base := نود.پوشه موقت()
    سرچاپ base.طول() بزرگتر 0
    dir := نود.ساخت پوشه موقت(نود.پیوستن مسیر(base، "salam-node-"))
    file := نود.پیوستن مسیر سه(dir، "sub"، "note.txt")
    سرچاپ نود.پوشه مسیر(file) برابر نود.پیوستن مسیر(dir، "sub")
    نود.فراخوان با رشته سپس منطقی(fsm، "mkdirSync"، نود.پیوستن مسیر(dir، "sub")، درست)
    نود.نوشتن فایل(file، "hello node")
    سرچاپ نود.خواندن فایل(file)
    نود.حذف بازگشتی(dir)
    سرچاپ نود.تبدیل به منطقی(نود.فراخوان رشته یک(fsm، "existsSync"، dir))

    args := نود.آرایه تازه()
    نود.افزودن رشته به آرایه(args، "-e")
    نود.افزودن رشته به آرایه(args، "console.log('child ok')")
    نود.اجرای فایل فرزند(
        "node"، args، base، (failed: منطقی، out: رشته، err: رشته): سرچاپ "child:"، failed، out.طول()،
        err.طول()
        نود.اجرای فایل فرزند خام(
            "node"، args، base، (code: صحیح۶۴، out2: رشته، err2: رشته): سرچاپ "raw:"، نود.بی‌مقدار است(code)،
            out2.طول()، err2.طول() پایان
        ) پایان
    )
پایان
