// زبان: فارسی
تابع اصلی:
    چاپ "hello"
    عدد := 42
    چاپ عدد
    ممیز := 3.5
    چاپ ممیز
    پرچم := درست
    چاپ پرچم
    چاپ نادرست
تمام
