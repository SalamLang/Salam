تابع ریشه:
    سرچاپ "hello"
    عدد := 42
    سرچاپ عدد
    ممیز := 3.5
    سرچاپ ممیز
    پرچم := درست
    سرچاپ پرچم
    سرچاپ نادرست
پایان
