تابع فاکتوریل(ن: صحیح): صحیح:
    اگر ن کوچکتربرابر 1:
        برگشت 1
    پایان
    برگشت ن * فاکتوریل(ن - 1)
پایان

تابع فیبوناچی(ن: صحیح): صحیح:
    اگر ن کوچکتر 2:
        برگشت ن
    پایان
    برگشت فیبوناچی(ن - 1) + فیبوناچی(ن - 2)
پایان

تابع ریشه:
    سرچاپ فاکتوریل(6)
    سرچاپ فیبوناچی(10)
پایان
