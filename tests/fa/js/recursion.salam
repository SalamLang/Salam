کارکرد فاکتوریل(ن: صحیح): صحیح:
    اگر ن <= 1:
        بازگشت 1
    پایان
    بازگشت ن * فاکتوریل(ن - 1)
پایان

کارکرد فیبوناچی(ن: صحیح): صحیح:
    اگر ن < 2:
        بازگشت ن
    پایان
    بازگشت فیبوناچی(ن - 1) + فیبوناچی(ن - 2)
پایان

کارکرد آغازین:
    چاپ فاکتوریل(6)
    چاپ فیبوناچی(10)
پایان
