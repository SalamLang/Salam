تابع ریشه:
    ناپایا ش := 0
    تکرار 4:
        ش++
    پایان
    سرچاپ ش

    ناپایا بالا := ""
    تکرار 1 تا 5 در ک:
        بالا += ک
    پایان
    سرچاپ بالا

    ناپایا پایین := ""
    تکرار 5 تا 1 در ک:
        پایین += ک
    پایان
    سرچاپ پایین
پایان
