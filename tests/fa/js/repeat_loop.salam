کارکرد آغازین:
    گذرا ش := 0
    چرخه 4:
        ش = ش + 1
    پایان
    چاپ ش

    گذرا بالا := ""
    چرخه 1 تا 5 با ک:
        بالا = بالا + ک
    پایان
    چاپ بالا

    گذرا پایین := ""
    چرخه 5 تا 1 با ک:
        پایین = پایین + ک
    پایان
    چاپ پایین
پایان
