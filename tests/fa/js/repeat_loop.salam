// زبان: فارسی
تابع اصلی:
    متغیر ش := 0
    تکرار 4:
        ش = ش + 1
    تمام
    چاپ ش

    متغیر بالا := ""
    تکرار 1 تا 5 با ک:
        بالا = بالا + ک
    تمام
    چاپ بالا

    متغیر پایین := ""
    تکرار 5 تا 1 با ک:
        پایین = پایین + ک
    تمام
    چاپ پایین
تمام
