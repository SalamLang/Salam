روال ریشه:
    ناپایا ش := 0
    تکرار 4:
        ش = ش + 1
    پایان
    سرچاپ ش

    ناپایا بالا := ""
    تکرار 1 تا 5 از ک:
        بالا = بالا + ک
    پایان
    سرچاپ بالا

    ناپایا پایین := ""
    تکرار 5 تا 1 از ک:
        پایین = پایین + ک
    پایان
    سرچاپ پایین
پایان
