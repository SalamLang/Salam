واردسازی ریاضی

تابع نگهدار<گ>(مقدار: گ): گ:
    برگشت مقدار
پایان

تابع ریشه:
    سرچاپ ریاضی.گردکردن(نگهدار(2.5))،
        ریاضی.گردکردن(نگهدار(-2.5))،
        ریاضی.گردکردن(نگهدار(3.5))،
        ریاضی.گردکردن(نگهدار(-3.5))
    سرچاپ ریاضی.گردکردن(نگهدار(0.5))،
        ریاضی.گردکردن(نگهدار(-0.5))،
        ریاضی.گردکردن(نگهدار(-0.4))،
        ریاضی.گردکردن(نگهدار(0.4))
    سرچاپ ریاضی.گردکردن(نگهدار(0.49999999999999994))، ریاضی.گردکردن(نگهدار(-0.49999999999999994))
    سرچاپ ریاضی.گردکردن(نگهدار(4503599627370497.0))، ریاضی.گردکردن(نگهدار(-4503599627370497.0))
    سرچاپ ریاضی.گردکردن(نگهدار(2.0))، ریاضی.گردکردن(نگهدار(-7.0))، ریاضی.گردکردن(نگهدار(1.0e300))
    سرچاپ ریاضی.گردکردن(نگهدار(-0.0))،
        ریاضی.گردکردن(نگهدار(0.0))،
        ریاضی.گردکردن(نگهدار(2.4999))،
        ریاضی.گردکردن(نگهدار(-2.5001))
    صفر := نگهدار(0.0)
    سرچاپ ریاضی.گردکردن(نگهدار(1.0) / صفر)،
        ریاضی.گردکردن(نگهدار(-1.0) / صفر)،
        ریاضی.گردکردن(صفر / صفر)
    سرچاپ ریاضی.گردکردن اعشار۳۲(نگهدار(2.5 برگردان اعشار۳۲))،
        ریاضی.گردکردن اعشار۳۲(نگهدار(-2.5 برگردان اعشار۳۲))،
        ریاضی.گردکردن اعشار۳۲(نگهدار(-0.25 برگردان اعشار۳۲))
    سرچاپ ریاضی.گردکردن اعشار۳۲(نگهدار(8388609.0 برگردان اعشار۳۲))،
        ریاضی.گردکردن اعشار۳۲(نگهدار(0.49999997 برگردان اعشار۳۲))
    سرچاپ ریاضی.گردکردن(2.5)، ریاضی.گردکردن(-2.5)، ریاضی.گردکردن(-0.4)
پایان
