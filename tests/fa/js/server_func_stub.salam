بسته ریشه

ساختار یتیم:
    همگانی id: صحیح = 0
    همگانی name: رشته = ""
    همگانی tags: وکتور<رشته> = وکتور {}
پایان

@en "Add"
سرور تابع افزودن(a: صحیح، b: صحیح): صحیح: سیکریت := "never-in-the-browser"
برگشت a + b + سیکریت.طول()
پایان

@en "Greet"
سرور تابع گرییت(name: رشته): رشته: برگشت "server says " + name
پایان

@en "Fetch"
سرور تابع فیتکه(id: صحیح): یتیم: برگشت یتیم { id = id }
پایان

@en "Stock"
سرور تابع ستوکک(sku: رشته): صحیح پرتاب خطا:
    پرتاب خطا "no stock for " + sku
پایان

تابع ریشه:
    سرچاپ افزودن(40، 2)
    سرچاپ گرییت("salam")
    یت := فیتکه(3)
    سرچاپ یت.name + " " + یت.tags.طول() + " " + یت.id
    تلاش:
        سرچاپ ستوکک("x1")
    گرفتن خطا ی:
        سرچاپ "caught " + ی.پیام
    پایان
پایان
