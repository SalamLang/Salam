بسته ریشه

ساختار یتیم:
    همگانی شناسه: صحیح = 0
    همگانی نام: رشته = ""
    همگانی تاگس: وکتور<رشته> = وکتور {}
پایان

سرور تابع افزودن(ا: صحیح، ب: صحیح): صحیح:
    سیکریت := "never-in-the-browser"
    برگشت ا + ب + سیکریت.طول()
پایان

سرور تابع گرییت(نام: رشته): رشته:
    برگشت "server says " + نام
پایان

سرور تابع فیتکه(شناسه: صحیح): یتیم:
    برگشت یتیم { شناسه = شناسه }
پایان

سرور تابع ستوکک(سکو: رشته): صحیح پرتاب خطا:
    پرتاب خطا "no stock for " + سکو
پایان

تابع ریشه:
    سرچاپ افزودن(40، 2)
    سرچاپ گرییت("salam")
    یت := فیتکه(3)
    سرچاپ یت.نام + " " + یت.تاگس.طول() + " " + یت.شناسه
    تلاش:
        سرچاپ ستوکک("x1")
    گرفتن خطا ی:
        سرچاپ "caught " + ی.پیام
    پایان
پایان
