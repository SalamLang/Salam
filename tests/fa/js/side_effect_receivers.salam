// زبان: فارسی
ناپایا شمار := 0
ناپایا ان := وکتور {} برگردان وکتور<صحیح>

تابع انبار(): وکتور<صحیح>:
    شمار++
    برگشت ان
پایان

تابع ریشه:
    ان.بیفزا(4)
    ان.بیفزا(5)
    ناپایا ی := انبار().پیمایش()
    ناپایا مجموع := 0
    تا ی.داردبعدی():
        مجموع += ی.مقدار()
        ی.بعدی()
    پایان
    سرچاپ مجموع، شمار
پایان
