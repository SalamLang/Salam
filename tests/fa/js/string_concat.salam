روال ریشه:
    متن := "foo" + "bar"
    سرچاپ متن
    سرچاپ "n=" + 7
    سرچاپ "pi=" + 3.5
    سرچاپ "ok=" + درست
    سرچاپ "x" + "y" + "z"
پایان
