// زبان: فارسی
تابع اصلی:
    الف := "foo" + "bar"
    چاپ الف
    چاپ "n=" + 7
    چاپ "pi=" + 3.5
    چاپ "ok=" + درست
    چاپ "x" + "y" + "z"
تمام
