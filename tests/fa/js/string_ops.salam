روال ریشه:
    س := "salam"
    سرچاپ س.طول()
    ناپایا شمار := 0
    تکرار 5 از ک:
        اگر س[ک] == 'a': شمار = شمار + 1 پایان
    پایان
    سرچاپ شمار
    سرچاپ س[0] == 's'
    سرچاپ س[4] == 'm'
پایان
