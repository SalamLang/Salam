تابع ریشه:
    س := "salam"
    سرچاپ س.طول()
    ناپایا شمار := 0
    تکرار 5 در ک:
        اگر س[ک] برابر 'a': شمار++ پایان
    پایان
    سرچاپ شمار
    سرچاپ س[0] برابر 's'
    سرچاپ س[4] برابر 'm'
پایان
