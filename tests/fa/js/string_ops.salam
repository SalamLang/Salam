// زبان: فارسی
تابع اصلی:
    س := "salam"
    چاپ س.طول()
    متغیر شمار := 0
    تکرار 5 با ک:
        اگر س[ک] == 'a': شمار = شمار + 1 تمام
    تمام
    چاپ شمار
    چاپ س[0] == 's'
    چاپ س[4] == 'm'
تمام
