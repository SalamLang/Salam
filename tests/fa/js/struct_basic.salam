ساختار شمارنده:
    مقدار: صحیح = 0
    همگانی کارکرد افزایش():
        این.مقدار = این.مقدار + 1
    پایان
    همگانی کارکرد بگیر(): صحیح:
        بازگشت این.مقدار
    پایان
پایان

کارکرد آغازین:
    گذرا ش := شمارنده { مقدار = 5 }
    ش.افزایش()
    ش.افزایش()
    چاپ ش.بگیر()
پایان
