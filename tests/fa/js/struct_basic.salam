ساختار شمارنده:
    مقدار: صحیح = 0
    همگانی تابع افزایش():
        این.مقدار = این.مقدار + 1
    پایان
    همگانی تابع بگیر(): صحیح:
        برگشت این.مقدار
    پایان
پایان

تابع ریشه:
    ناپایا ش := شمارنده { مقدار = 5 }
    ش.افزایش()
    ش.افزایش()
    سرچاپ ش.بگیر()
پایان
