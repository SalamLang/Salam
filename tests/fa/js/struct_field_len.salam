ساختار مسیر:
    همگانی طول: صحیح
    همگانی کلمه: صحیح
پایان

تابع افزایش(عدد &: صحیح):
    عدد++
پایان

تابع ریشه:
    ناپایا ت := مسیر {طول = 4، کلمه = 1}
    سرچاپ ت.طول
    افزایش(ت.طول)
    ت.طول += 10
    سرچاپ ت.طول
    سرچاپ ت.کلمه
پایان
