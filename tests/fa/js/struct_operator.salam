ساختار بردار۲:
    همگانی افقی: صحیح = 0
    همگانی عمودی: صحیح = 0
    همگانی روال کارور + (دیگر: بردار۲): بردار۲: برگشت بردار۲ { افقی = این.افقی + دیگر.افقی, عمودی = این.عمودی + دیگر.عمودی }
    پایان
    همگانی روال کارور == (دیگر: بردار۲): منطقی: برگشت این.افقی == دیگر.افقی && این.عمودی == دیگر.عمودی
    پایان
پایان

روال ریشه:
    الف := بردار۲ { افقی = 3, عمودی = 4 }
    ب := بردار۲ { افقی = 1, عمودی = 2 }
    ج := الف + ب
    سرچاپ ج.افقی
    سرچاپ ج.عمودی
    الف۲ := بردار۲ { افقی = 3, عمودی = 4 }
    سرچاپ الف == الف۲
    سرچاپ الف == ب
پایان
