تابع اولین منفی(فهرست: وکتور<صحیح>): صحیح:
    ناپایا یافته := 0 - 1
    تکرار فهرست.طول() در i:
        ترابرد فهرست.بگیر(i):
            0:
                گذر
            پایان
            < 0:
                یافته = i
                بشکن 2
            پایان
        پایان
    پایان
    برگشت یافته
پایان

تابع یافتن جفت(هدف: صحیح): رشته:
    ناپایا خروجی := "none"
    تکرار 5 در i:
        تکرار 5 در j:
            اگر i * j == هدف:
                خروجی = "" + i + "x" + j
                بشکن 2
            پایان
        پایان
    پایان
    برگشت خروجی
پایان

تابع عمیق(): رشته:
    ناپایا ردپا := ""
    ناپایا k := 0
    تا k < 10:
        k += 1
        ترابرد k:
            3:
                ترابرد درست:
                    درست:
                        ردپا += "exit@3"
                        بشکن 3
                    پایان
                پایان
            پایان
            وگرنه:
                ردپا += "" + k + ","
            پایان
        پایان
    پایان
    برگشت ردپا
پایان

تابع با اجرای تاخیری(): رشته:
    تکرار 2 در i:
        دیرکن سرچاپ "outer defer"، i
        تکرار 3 در j:
            دیرکن سرچاپ "inner defer"، i، j
            اگر j == 1:
                بشکن 2
            پایان
        پایان
    پایان
    برگشت "done"
پایان

تابع ریشه:
    ناپایا فهرست := وکتور {} برگردان وکتور<صحیح>
    فهرست.بیفزا(3)
    فهرست.بیفزا(0)
    فهرست.بیفزا(-4)
    فهرست.بیفزا(-9)
    سرچاپ "first negative at"، اولین منفی(فهرست)
    سرچاپ "pair for 6:"، یافتن جفت(6)، "pair for 99:"، یافتن جفت(99)
    سرچاپ "deep:"، عمیق()
    سرچاپ با اجرای تاخیری()
    ناپایا n := 0
    تا درست:
        n += 1
        اگر n == 3:
            بشکن 1
        پایان
    پایان
    سرچاپ "break 1 stopped at"، n
پایان
