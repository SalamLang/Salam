روال first_negative(xs: وکتور<صحیح>): صحیح:
    ناپایا found := 0 - 1
    تکرار xs.طول() در i:
        ترابرد xs.بگیر(i):
            0:
                گذر
            پایان
            < 0:
                found = i
                بشکن 2
            پایان
        پایان
    پایان
    برگشت found
پایان

روال find_pair(target: صحیح): رشته:
    ناپایا out := "none"
    تکرار 5 در i:
        تکرار 5 در j:
            اگر i * j == target:
                out = "" + i + "x" + j
                بشکن 2
            پایان
        پایان
    پایان
    برگشت out
پایان

روال deep(): رشته:
    ناپایا trace := ""
    ناپایا k := 0
    تا k < 10:
        k += 1
        ترابرد k:
            3:
                ترابرد درست:
                    درست:
                        trace += "exit@3"
                        بشکن 3
                    پایان
                پایان
            پایان
            وگرنه:
                trace += "" + k + ","
            پایان
        پایان
    پایان
    برگشت trace
پایان

روال with_defers(): رشته:
    تکرار 2 در i:
        دیرکن سرچاپ "outer defer"، i
        تکرار 3 در j:
            دیرکن سرچاپ "inner defer"، i، j
            اگر j == 1:
                بشکن 2
            پایان
        پایان
    پایان
    برگشت "done"
پایان

روال ریشه:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    xs.بیفزا(3)
    xs.بیفزا(0)
    xs.بیفزا(-4)
    xs.بیفزا(-9)
    سرچاپ "first negative at"، first_negative(xs)
    سرچاپ "pair for 6:"، find_pair(6)، "pair for 99:"، find_pair(99)
    سرچاپ "deep:"، deep()
    سرچاپ with_defers()
    ناپایا n := 0
    تا درست:
        n += 1
        اگر n == 3:
            بشکن 1
        پایان
    پایان
    سرچاپ "break 1 stopped at"، n
پایان
