تابع نمره(x: صحیح، نام: رشته): رشته:
    ترابرد درست:
        x < 0:
            برگشت "negative"
        پایان
        x == 0 یا نام == "zero":
            برگشت "zero"
        پایان
        x > 100:
            برگشت "huge"
        پایان
    پایان
    برگشت "normal"
پایان

تابع دسته(x: صحیح): رشته:
    کران پایین := 10
    ترابرد x:
        کران پایین - 10 تا کران پایین - 1:
            برگشت "single digit"
        پایان
        کران پایین تا کران پایین * 10 - 1:
            برگشت "double digit"
        پایان
    پایان
    برگشت "large"
پایان

تابع ریشه:
    سرچاپ نمره(-5، "")، نمره(0، "")، نمره(7، "zero")، نمره(500، "")، نمره(50، "")
    سرچاپ دسته(3)، دسته(42)، دسته(700)
پایان
