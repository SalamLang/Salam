روال grade(x: صحیح، name: رشته): رشته:
    ترابرد درست:
        x < 0:
            برگشت "negative"
        پایان
        x == 0 یا name == "zero":
            برگشت "zero"
        پایان
        x > 100:
            برگشت "huge"
        پایان
    پایان
    برگشت "normal"
پایان

روال bucket(x: صحیح): رشته:
    lo := 10
    ترابرد x:
        lo - 10 تا lo - 1:
            برگشت "single digit"
        پایان
        lo تا lo * 10 - 1:
            برگشت "double digit"
        پایان
    پایان
    برگشت "large"
پایان

روال ریشه:
    سرچاپ grade(-5، "")، grade(0، "")، grade(7، "zero")، grade(500، "")، grade(50، "")
    سرچاپ bucket(3)، bucket(42)، bucket(700)
پایان
