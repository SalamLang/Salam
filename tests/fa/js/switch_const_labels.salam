// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

پایا RED := 1
پایا GREEN := 2
پایا BLUE := 3
پایا BASE := 10
پایا NEXT := BASE + 1
پایا NEG := -1
پایا BIG := 5000000000 برگردان صحیح۶۴
پایا CMD_START := "start"
پایا CMD_HELP := "help"

جداشمار شکل:
    دایره، مربع، مثلث
پایان

ساختار پیکربندی:
    همگانی مدیر: رشته = "ali"
پایان

تابع نام رنگ(c: صحیح): رشته:
    ترابرد c:
        RED:
            برگشت "red"
        پایان
        GREEN، BLUE:
            برگشت "green or blue"
        پایان
    پایان
    برگشت "unknown"
پایان

تابع دسته‌بندی(x: صحیح): رشته:
    ترابرد x:
        NEG:
            برگشت "minus one"
        پایان
        BASE:
            برگشت "base"
        پایان
        NEXT:
            برگشت "next"
        پایان
        BASE + 2 تا BASE * 2:
            برگشت "teens"
        پایان
    پایان
    برگشت "other"
پایان

تابع فرمان(دستور: رشته): رشته:
    ترابرد دستور:
        CMD_START:
            برگشت "starting"
        پایان
        CMD_HELP:
            برگشت "helping"
        پایان
    پایان
    برگشت "unknown command"
پایان

تابع تعداد ضلع‌ها(s: شکل): صحیح:
    ترابرد s:
        شکل.دایره:
            برگشت 0
        پایان
        شکل.مربع:
            برگشت 4
        پایان
        شکل.مثلث:
            برگشت 3
        پایان
    پایان
    برگشت 0 - 1
پایان

تابع توصیف(n: صحیح): رشته:
    ترابرد n:
        1:
            پایا LABEL := "one"
            برگشت LABEL
        پایان
        2:
            پایا LABEL := "two"
            برگشت LABEL
        پایان
    پایان
    برگشت "many"
پایان

تابع ریشه:
    سرچاپ نام رنگ(1)، نام رنگ(3)، نام رنگ(9)
    سرچاپ دسته‌بندی(-1)، دسته‌بندی(10)، دسته‌بندی(11)، دسته‌بندی(15)، دسته‌بندی(50)
    سرچاپ فرمان("help")، فرمان("start")، فرمان("stop")
    عدد بزرگ := 5000000000 برگردان صحیح۶۴
    ترابرد عدد بزرگ:
        BIG:
            سرچاپ "big matched"
            بشکن
        پایان
    پایان
    سرچاپ تعداد ضلع‌ها(شکل.دایره)، تعداد ضلع‌ها(شکل.مربع)، تعداد ضلع‌ها(شکل.مثلث)
    مالک := "ali"
    حد := 3
    تنظیمات := پیکربندی {}
    کاربر := "ali"
    ترابرد کاربر:
        مالک:
            سرچاپ "matched a local"
            بشکن
        پایان
    پایان
    ترابرد حد:
        3:
            سرچاپ "matched a literal"
            بشکن
        پایان
    پایان
    ترابرد کاربر:
        تنظیمات.مدیر:
            سرچاپ "matched a field"
            بشکن
        پایان
    پایان
    سرچاپ توصیف(1)، توصیف(2)، توصیف(3)
پایان
