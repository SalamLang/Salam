تابع دسته(ن: صحیح): رشته:
    برگشت ن کوچکتر 0 ? "negative" : ن برابر 0 ? "zero" : "positive"
پایان

تابع ریشه:
    سرچاپ دسته(-4)
    سرچاپ دسته(0)
    سرچاپ دسته(9)
    ایکس := 7
    سرچاپ ایکس بزرگتر 5 ? "big" : "small"
پایان
