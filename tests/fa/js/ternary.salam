// زبان: فارسی
تابع دسته(ن: صحیح): رشته:
    بازگشت ن < 0 ? "negative" : ن == 0 ? "zero" : "positive"
تمام

تابع اصلی:
    چاپ دسته(-4)
    چاپ دسته(0)
    چاپ دسته(9)
    ایکس := 7
    چاپ ایکس > 5 ? "big" : "small"
تمام
