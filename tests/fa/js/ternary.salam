روال دسته(ن: صحیح): رشته:
    برگشت ن < 0 ? "negative" : ن == 0 ? "zero" : "positive"
پایان

روال ریشه:
    سرچاپ دسته(-4)
    سرچاپ دسته(0)
    سرچاپ دسته(9)
    ایکس := 7
    سرچاپ ایکس > 5 ? "big" : "small"
پایان
