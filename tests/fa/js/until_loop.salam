// زبان: فارسی
تابع اصلی:
    متغیر ک := 0
    متغیر جمع := 0
    تاوقتی ک < 5:
        جمع = جمع + ک
        ک = ک + 1
    تمام
    چاپ جمع
    چاپ ک
تمام
