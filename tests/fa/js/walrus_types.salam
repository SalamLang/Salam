روال ریشه:
    عدد := 7
    ممیز := 2.5
    متن := "hi"
    پرچم := نادرست
    سرچاپ عدد
    سرچاپ ممیز
    سرچاپ متن
    سرچاپ پرچم
    سرچاپ عدد + 1
    سرچاپ ممیز + 1.0
پایان
