// زبان: فارسی
تابع اصلی:
    عدد := 7
    ممیز := 2.5
    متن := "hi"
    پرچم := نادرست
    چاپ عدد
    چاپ ممیز
    چاپ متن
    چاپ پرچم
    چاپ عدد + 1
    چاپ ممیز + 1.0
تمام
