واردسازی وب.مرورگر

تابع پاسخ رسید(وضعیت: صحیح، متن: رشته):
    سرچاپ وضعیت، " "، متن
    مرورگر.درخواست(
        "GET"،
        "http://127.0.0.1:1/none"،
        ""،
        ""،
        2000،
        (کد: صحیح، بدنه: رشته):
        سرچاپ کد،
        " ["،
        بدنه،
        "]"
        مرورگر.ارسال جیسون(
            "http://127.0.0.1:1/none"،
            "{}"،
            2000،
            (نتیجه: صحیح، جواب: رشته):
            سرچاپ نتیجه،
            " "،
            جواب.طول()
            مرورگر.کپی متن("سلام"، (انجام: منطقی): سرچاپ انجام پایان)
            مرورگر.کپی متن("سلام")
            پایان
        )
        پایان
    )
پایان

تابع ریشه:
    سرچاپ "["، مرورگر.پارامتر نشانی("ref")، "]"
    مرورگر.دریافت("data:text/plain,hello"، 5000، (وضعیت: صحیح، متن: رشته): پاسخ رسید(وضعیت، متن) پایان)
پایان
