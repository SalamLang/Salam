// انتظار: <td
// انتظار:  colspan="2"
// انتظار:  rowspan="2"
// انتظار:  headers="target1"
چیدمان:
    جعبه: شناسه = "target1" پایان
    جدول:
        ردیف:
            ستون:
                پوشش ستون = "2"
                پوشش ردیف = "2"
                سرستون‌ها = "target1"
                محتوا = "متن"
            پایان
        پایان
    پایان
پایان
