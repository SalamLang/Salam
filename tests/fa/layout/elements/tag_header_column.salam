// انتظار: <th
// انتظار:  colspan="2"
// انتظار:  rowspan="2"
// انتظار:  headers="target1"
// انتظار:  scope="row"
// انتظار:  abbr="x1"
چیدمان:
    جعبه: شناسه = "target1" پایان
    جدول:
        سرصفحه:
            ردیف:
                ستون:
                    پوشش ستون = "2"
                    پوشش ردیف = "2"
                    سرستون‌ها = "target1"
                    دامنه = "ردیف"
                    کوته‌نوشت = "x1"
                    محتوا = "متن"
                پایان
            پایان
        پایان
    پایان
پایان
