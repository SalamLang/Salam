// انتظار: <select
// انتظار:  name="x1"
// انتظار:  multiple
// انتظار:  required
// انتظار:  disabled
// انتظار:  size="2"
// انتظار:  autofocus
// انتظار:  form="target1"
// انتظار:  autocomplete="x1"
چیدمان:
    جعبه: شناسه = "target1" پایان
    انتخاب:
        نام = "x1"
        چندتایی = درست
        الزامی = درست
        غیرفعال = درست
        اندازه = "2"
        تمرکز خودکار = درست
        فرم = "target1"
        تکمیل خودکار = "x1"
    پایان
پایان
