// انتظار: <textarea
// انتظار:  name="x1"
// انتظار:  rows="2"
// انتظار:  cols="2"
// انتظار:  maxlength="2"
// انتظار:  minlength="2"
// انتظار:  placeholder="x1"
// انتظار:  readonly
// انتظار:  required
// انتظار:  disabled
// انتظار:  wrap="soft"
// انتظار:  autocomplete="x1"
// انتظار:  autofocus
// انتظار:  dirname="t1"
// انتظار:  form="target1"
چیدمان:
    جعبه: شناسه = "target1" پایان
    متن بلند:
        نام = "x1"
        ردیف‌ها = "2"
        ستون‌ها = "2"
        بیشینه طول = "2"
        کمینه طول = "2"
        جانگهدار = "x1"
        فقط خواندنی = درست
        الزامی = درست
        غیرفعال = درست
        شکستن خط = "نرم"
        تکمیل خودکار = "x1"
        تمرکز خودکار = درست
        نام جهت = "t1"
        فرم = "target1"
        محتوا = "متن"
    پایان
پایان
