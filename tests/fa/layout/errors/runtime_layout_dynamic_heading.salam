// انتظار: خطا۱۳۲
// انتظار-پیام: باید هنگام ترجمه معلوم باشد
چیدمان تیتر(سطح: صحیح):
    سرتیتر: اندازه = سطح محتوا = «x» پایان
پایان

تابع ریشه():
    سرچاپ تیتر(۲)
پایان
