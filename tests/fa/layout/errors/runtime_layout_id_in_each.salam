// انتظار: خطا۱۳۴
// انتظار-پیام: شناسه‌ی ثابت 'row'
چیدمان ردیف‌ها(ها: وکتور<رشته>):
    هر ه در ها:
        جعبه: شناسه = «row» محتوا = ه پایان
    پایان
پایان

تابع ریشه():
    ها := وکتور {} برگردان وکتور<رشته>
    سرچاپ ردیف‌ها(ها)
پایان
