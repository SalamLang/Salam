// انتظار: خطا۰۱۲
// انتظار-پیام: 'دربیاور' را فراخوانی کند
چیدمان نام‌ها(ها: وکتور<رشته>):
    پاراگراف: محتوا = «تعداد: » + ها.طول() + « آخری: » + ها.برداشتن() پایان
پایان

روال ریشه():
    ناپایا ها := وکتور {} برگردان وکتور<رشته>
    ها.بیفزا(«الف»)
    سرچاپ نام‌ها(ها)
    ها.آزادکن()
پایان
