// انتظار: <title>سلام | خانه</title>
// انتظار: <div>شمار: 15</div>
// انتظار: width: 302px;
پایا پایه := ۱۰
پایا نام := «سلام»
پایا پهن := پایه * ۳۰ + ۲
چیدمان:
    عنوان = نام + « | خانه»
    جعبه: محتوا = «شمار: » + (پایه + ۵) پایان
    جعبه:
        محتوا = «پهن»
        عرض = پهن + «px»
    پایان
پایان
