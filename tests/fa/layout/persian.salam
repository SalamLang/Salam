// انتظار: color: blue
// زبان: فارسی
صفحه:
    عنوان = "سلام دنیا"
    جهت = "راست به چپ"
    جعبه:
        محتوا = "درود"
        رنگ = "آبی"
        پس‌زمینه = "سفید"
    تمام
تمام
