// انتظار: color: rgb(10 20 30 / 50%);
// انتظار: background-color: color-mix(in oklch, red 30%, blue);
// انتظار: border-color: light-dark(white, black);
// انتظار: outline-color: color(srgb 1 0 0);
چیدمان:
    جعبه:
        رنگ = "rgb(۱۰ ۲۰ ۳۰ / ۵۰٪)"
        رنگ پس‌زمینه = "ترکیب‌رنگ(درون oklch، قرمز ۳۰٪، آبی)"
        رنگ کادر = "روشن‌تاریک(سفید، سیاه)"
        رنگ دورخط = "رنگ(srgb ۱ ۰ ۰)"
    پایان
پایان
