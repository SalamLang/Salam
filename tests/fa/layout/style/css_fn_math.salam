چیدمان:
    جعبه:
        عرض = "محاسبه(۱۰۰٪ - ۲۰ پیکسل)"
        ارتفاع = "محدود(۲۰۰ پیکسل، ۵۰٪، ۸۰۰ پیکسل)"
        کمینه عرض = "کمینه(۱۰۰٪، ۶۰۰)"
        دگرگونی = "چرخش(محاسبه(۱۰ درجه * ۲))"
        بیشینه عرض = "گردکردن(بالا، ۳۳ پیکسل، ۱۰ پیکسل)"
    پایان
پایان
