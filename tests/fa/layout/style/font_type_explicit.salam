// انتظار: url("https://cdn.example.com/font?id=7") format("opentype")
// انتظار: font-weight: 100 900; font-style: italic;
// انتظار: unicode-range: U+0600-06FF, U+200C;
چیدمان:
    قلم:
        نام = «قلم من»
        منبع = «https://cdn.example.com/font?id=7»
        نوع = «otf»
        وزن = «100 900»
        سبک = «کج»
        بازه = «U+0600-06FF, U+200C»
    پایان
پایان
