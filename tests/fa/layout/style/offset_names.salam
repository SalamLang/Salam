// انتظار: offset-path: path('M0 0 L10 10');
// انتظار: offset-anchor: center;
// انتظار: offset-position: center;
// انتظار: offset-distance: 12px;
صفحه:
    جعبه:
        مسیر حرکت = "path('M0 0 L10 10')"
        لنگر حرکت = "وسط"
        موقعیت فاصله = "وسط"
        فاصله مسیر = "12 پیکسل"
    پایان
پایان
