صفحه:
    جعبه:
        فاصله = "4 پیکسل 8 پیکسل"
        فضا = "0 خودکار"
        فاصله بلوکی ابتدا = "2 پیکسل"
        فضا بلوکی انتها = "5 پیکسل"
        فاصله پیمایش ابتدا = "7 پیکسل"
        فضا پیمایش بالا = "9 پیکسل"
    پایان
پایان
