// زبان: فارسی
// EXPECT-WARNINGS: 0

تابع pick(a: صحیح، b: صحیح): صحیح:
    اگر a بزرگتربرابر 0 و b کوچکتربرابر 9:
        برگشت 1
    پایان
    اگر a بزرگتربرابر 10 و b کوچکتربرابر 99:
        برگشت 2
    پایان
    اگر a بزرگتربرابر 100 و b کوچکتربرابر 999:
        برگشت 3
    پایان
    اگر a بزرگتربرابر 1000 و b کوچکتربرابر 9999:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(5، 5)
پایان
