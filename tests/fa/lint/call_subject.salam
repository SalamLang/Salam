// زبان: فارسی
// EXPECT-WARNINGS: 0

تابع pick(xs: وکتور<صحیح>): صحیح:
    اگر xs.طول() برابر 1:
        برگشت 10
    پایان
    اگر xs.طول() برابر 2:
        برگشت 20
    پایان
    اگر xs.طول() برابر 3:
        برگشت 30
    پایان
    اگر xs.طول() برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    xs.بیفزا(1)
    xs.بیفزا(2)
    سرچاپ pick(xs)
پایان
