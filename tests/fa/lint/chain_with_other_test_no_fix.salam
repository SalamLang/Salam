// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 0

تابع pick(x: صحیح، y: صحیح): صحیح:
    ناپایا r := 0
    اگر x برابر 1:
        r = 10
    وگرنه x برابر 2:
        r = 20
    وگرنه x برابر 3:
        r = 30
    وگرنه x برابر 4:
        r = 40
    وگرنه y بزرگتر 0:
        r = 50
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ pick(3، 0)
پایان
