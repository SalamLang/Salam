// زبان: فارسی
// EXPECT-WARNINGS: 0

واردسازی رشته

پایا OC_NONE := 0 - 1
پایا OC_RODATA := 0
پایا OC_BSS := 1
پایا OC_INIT := 2
پایا OC_FINI := 3
پایا OC_INITARR := 4
پایا OC_FINIARR := 5
پایا OC_EHFRAME := 6
پایا OC_EXIDX := 7
پایا OC_TEXT := 8
پایا OC_DATA := 9
پایا OC_DATAREL := 10

ساختار پیوندگر:
    همگانی پرچم بخش‌ها: وکتور<صحیح۶۴> = وکتور {}
    همگانی رده بخش‌ها: وکتور<صحیح> = وکتور {}
    همگانی نام بخش‌ها: وکتور<صحیح> = وکتور {}
    همگانی پرونده بخش‌ها: وکتور<صحیح> = وکتور {}
    همگانی آغاز بازمکان بخش‌ها: وکتور<صحیح> = وکتور {}
    همگانی تعداد بازمکان بخش‌ها: وکتور<صحیح> = وکتور {}
    همگانی رده بازمکان‌ها: وکتور<صحیح> = وکتور {}
    همگانی برچسب پرونده‌ها: وکتور<رشته> = وکتور {}
    همگانی نام‌ها: وکتور<رشته> = وکتور {}
    همگانی پویا: منطقی = نادرست
پایان

تابع نام یکسان است(l &: پیوندگر، شناسه: صحیح، s: رشته): منطقی:
    برگشت رشته.یکسان است(l.نام‌ها.بگیر(شناسه)، s)
پایان

تابع نام شروع می‌شود(l &: پیوندگر، شناسه: صحیح، s: رشته): منطقی:
    برگشت رشته.شروع با(l.نام‌ها.بگیر(شناسه)، s)
پایان

تابع ثبت شکست(l &: پیوندگر، m: رشته):
    l.برچسب پرونده‌ها.بیفزا(m)
پایان

تابع دسته‌بندی(l &: پیوندگر، s: صحیح): صحیح:
    پرچم‌ها := l.پرچم بخش‌ها[s]
    اگر (پرچم‌ها & (2 برگردان صحیح۶۴)) برابر (0 برگردان صحیح۶۴):
        برگشت OC_NONE
    پایان
    رده := l.رده بخش‌ها[s]
    شناسه نام := l.نام بخش‌ها[s]
    اگر رده برابر 7:
        برگشت OC_NONE
    پایان
    اگر رده برابر 8:
        برگشت OC_BSS
    پایان
    اگر نام یکسان است(l، شناسه نام، ".init"):
        برگشت OC_INIT
    پایان
    اگر نام یکسان است(l، شناسه نام، ".fini"):
        برگشت OC_FINI
    پایان
    اگر رده برابر 14 یا نام شروع می‌شود(l، شناسه نام، ".init_array"):
        برگشت OC_INITARR
    پایان
    اگر رده برابر 15 یا نام شروع می‌شود(l، شناسه نام، ".fini_array"):
        برگشت OC_FINIARR
    پایان
    اگر رده برابر 16 یا نام شروع می‌شود(l، شناسه نام، ".preinit_array"):
        ثبت شکست(l، l.برچسب پرونده‌ها[l.پرونده بخش‌ها[s]] + ": .preinit_array is not supported yet")
        برگشت OC_NONE
    پایان
    اگر نام یکسان است(l، شناسه نام، ".eh_frame"):
        برگشت OC_EHFRAME
    پایان
    اگر رده برابر 0x70000001:
        برگشت OC_EXIDX
    پایان
    اگر (پرچم‌ها & (4 برگردان صحیح۶۴)) نابرابر (0 برگردان صحیح۶۴):
        برگشت OC_TEXT
    پایان
    اگر (پرچم‌ها & (1 برگردان صحیح۶۴)) نابرابر (0 برگردان صحیح۶۴):
        برگشت OC_DATA
    پایان
    اگر l.پویا:
        آغاز بازمکان := l.آغاز بازمکان بخش‌ها[s]
        تکرار l.تعداد بازمکان بخش‌ها[s] در k:
            اگر l.رده بازمکان‌ها[آغاز بازمکان + k] برابر 1:
                برگشت OC_DATAREL
            پایان
        پایان
    پایان
    برگشت OC_RODATA
پایان

تابع ریشه:
    ناپایا l := پیوندگر {}
    l.پرچم بخش‌ها.بیفزا(7 برگردان صحیح۶۴)
    l.رده بخش‌ها.بیفزا(8)
    l.نام بخش‌ها.بیفزا(0)
    l.پرونده بخش‌ها.بیفزا(0)
    l.آغاز بازمکان بخش‌ها.بیفزا(0)
    l.تعداد بازمکان بخش‌ها.بیفزا(0)
    l.نام‌ها.بیفزا(".bss")
    l.برچسب پرونده‌ها.بیفزا("a.o")
    سرچاپ دسته‌بندی(l، 0)
پایان
