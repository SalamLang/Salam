// زبان: فارسی
// ARGS: --switch-lint=warn --switch-lint-min=3
// EXPECT-WARNINGS: 0

واردسازی رشته

پایا OC_NONE := 0 - 1
پایا OC_RODATA := 0
پایا OC_BSS := 1
پایا OC_INIT := 2
پایا OC_FINI := 3
پایا OC_INITARR := 4
پایا OC_FINIARR := 5
پایا OC_EHFRAME := 6
پایا OC_EXIDX := 7
پایا OC_TEXT := 8
پایا OC_DATA := 9
پایا OC_DATAREL := 10

ساختار Nl:
    همگانی s_flags: وکتور<صحیح۶۴> = وکتور {}
    همگانی s_type: وکتور<صحیح> = وکتور {}
    همگانی s_name: وکتور<صحیح> = وکتور {}
    همگانی s_obj: وکتور<صحیح> = وکتور {}
    همگانی s_rel0: وکتور<صحیح> = وکتور {}
    همگانی s_nrel: وکتور<صحیح> = وکتور {}
    همگانی r_type: وکتور<صحیح> = وکتور {}
    همگانی o_label: وکتور<رشته> = وکتور {}
    همگانی names: وکتور<رشته> = وکتور {}
    همگانی dynamic: منطقی = نادرست
پایان

تابع name_is(l &: Nl، id: صحیح، s: رشته): منطقی:
    برگشت رشته.یکسان است(l.names.بگیر(id)، s)
پایان

تابع name_starts(l &: Nl، id: صحیح، s: رشته): منطقی:
    برگشت رشته.شروع با(l.names.بگیر(id)، s)
پایان

تابع nl_fail(l &: Nl، m: رشته):
    l.o_label.بیفزا(m)
پایان

تابع classify(l &: Nl، s: صحیح): صحیح:
    fl := l.s_flags[s]
    اگر (fl & (2 برگردان صحیح۶۴)) برابر (0 برگردان صحیح۶۴):
        برگشت OC_NONE
    پایان
    ty := l.s_type[s]
    nm := l.s_name[s]
    اگر ty برابر 7:
        برگشت OC_NONE
    پایان
    اگر ty برابر 8:
        برگشت OC_BSS
    پایان
    اگر name_is(l، nm، ".init"):
        برگشت OC_INIT
    پایان
    اگر name_is(l، nm، ".fini"):
        برگشت OC_FINI
    پایان
    اگر ty برابر 14 یا name_starts(l، nm، ".init_array"):
        برگشت OC_INITARR
    پایان
    اگر ty برابر 15 یا name_starts(l، nm، ".fini_array"):
        برگشت OC_FINIARR
    پایان
    اگر ty برابر 16 یا name_starts(l، nm، ".preinit_array"):
        nl_fail(l، l.o_label[l.s_obj[s]] + ": .preinit_array is not supported yet")
        برگشت OC_NONE
    پایان
    اگر name_is(l، nm، ".eh_frame"):
        برگشت OC_EHFRAME
    پایان
    اگر ty برابر 0x70000001:
        برگشت OC_EXIDX
    پایان
    اگر (fl & (4 برگردان صحیح۶۴)) نابرابر (0 برگردان صحیح۶۴):
        برگشت OC_TEXT
    پایان
    اگر (fl & (1 برگردان صحیح۶۴)) نابرابر (0 برگردان صحیح۶۴):
        برگشت OC_DATA
    پایان
    اگر l.dynamic:
        r0 := l.s_rel0[s]
        تکرار l.s_nrel[s] در k:
            اگر l.r_type[r0 + k] برابر 1:
                برگشت OC_DATAREL
            پایان
        پایان
    پایان
    برگشت OC_RODATA
پایان

تابع ریشه:
    ناپایا l := Nl {}
    l.s_flags.بیفزا(7 برگردان صحیح۶۴)
    l.s_type.بیفزا(8)
    l.s_name.بیفزا(0)
    l.s_obj.بیفزا(0)
    l.s_rel0.بیفزا(0)
    l.s_nrel.بیفزا(0)
    l.names.بیفزا(".bss")
    l.o_label.بیفزا("a.o")
    سرچاپ classify(l، 0)
پایان
