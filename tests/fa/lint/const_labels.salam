// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

پایا KIND_A := 1
پایا KIND_B := 2
پایا KIND_C := 3
پایا KIND_D := 0 - 1

تابع انتخاب(دسته: صحیح): صحیح:
    اگر دسته برابر KIND_A:
        برگشت 10
    پایان
    اگر KIND_B برابر دسته:
        برگشت 20
    پایان
    اگر دسته برابر KIND_C یا دسته برابر 9:
        برگشت 30
    پایان
    اگر دسته برابر KIND_D:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ انتخاب(3)
پایان
