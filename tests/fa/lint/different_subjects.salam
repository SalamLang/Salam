تابع pick(a: صحیح، b: صحیح): صحیح:
    اگر a برابر 1:
        برگشت 10
    پایان
    اگر b برابر 1:
        برگشت 20
    پایان
    اگر a برابر 2:
        برگشت 30
    پایان
    اگر b برابر 2:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(2، 1)
پایان
