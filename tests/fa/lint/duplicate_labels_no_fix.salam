پایا SAME_A := 5
پایا SAME_B := 5

تابع by_literal(x: صحیح): صحیح:
    اگر x برابر 1:
        برگشت 10
    پایان
    اگر x برابر 2:
        برگشت 20
    پایان
    اگر x برابر 1:
        برگشت 30
    پایان
    اگر x برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع by_const(x: صحیح): صحیح:
    اگر x برابر SAME_A:
        برگشت 10
    پایان
    اگر x برابر 2:
        برگشت 20
    پایان
    اگر x برابر SAME_B:
        برگشت 30
    پایان
    اگر x برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ by_literal(1)، by_const(5)
پایان
