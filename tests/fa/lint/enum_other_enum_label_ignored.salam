// زبان: فارسی
// EXPECT-WARNINGS: 0

جداشمار Color:
    Red،
    Green
پایان

جداشمار Shape:
    Round،
    Flat
پایان

تابع pick(c: Color، s: Shape): صحیح:
    اگر c برابر Color.Red:
        برگشت 1
    پایان
    اگر s برابر Shape.Round:
        برگشت 2
    پایان
    اگر c برابر Color.Green:
        برگشت 3
    پایان
    اگر s برابر Shape.Flat:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(Color.Red، Shape.Flat)
پایان
