// زبان: فارسی
// EXPECT-WARNINGS: 0

جداشمار رنگ:
    قرمز،
    سبز
پایان

جداشمار شکل:
    گرد،
    تخت
پایان

تابع انتخاب(c: رنگ، s: شکل): صحیح:
    اگر c برابر رنگ.قرمز:
        برگشت 1
    پایان
    اگر s برابر شکل.گرد:
        برگشت 2
    پایان
    اگر c برابر رنگ.سبز:
        برگشت 3
    پایان
    اگر s برابر شکل.تخت:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ انتخاب(رنگ.قرمز، شکل.تخت)
پایان
