// زبان: فارسی
// EXPECT-WARNINGS: 0

جداشمار Color:
    Red،
    Green،
    Blue،
    Black
پایان

تابع pick(c: Color): صحیح:
    اگر c برابر Color.Red:
        برگشت 1
    پایان
    اگر c برابر Color.Green:
        برگشت 2
    پایان
    اگر c برابر Color.Blue:
        برگشت 3
    پایان
    اگر c برابر Color.Black:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(Color.Blue)
پایان
