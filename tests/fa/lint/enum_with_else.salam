// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

جداشمار رنگ:
    قرمز،
    سبز،
    آبی،
    سیاه،
    سفید
پایان

تابع انتخاب(c: رنگ): صحیح:
    ناپایا r := 0
    اگر c برابر رنگ.قرمز:
        r = 1
    وگرنه c برابر رنگ.سبز:
        r = 2
    وگرنه c برابر رنگ.آبی:
        r = 3
    وگرنه c برابر رنگ.سیاه:
        r = 4
    وگرنه:
        r = 5
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ انتخاب(رنگ.آبی)
پایان
