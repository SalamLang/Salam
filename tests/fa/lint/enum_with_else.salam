// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

جداشمار Color:
    Red،
    Green،
    Blue،
    Black،
    White
پایان

تابع pick(c: Color): صحیح:
    ناپایا r := 0
    اگر c برابر Color.Red:
        r = 1
    وگرنه c برابر Color.Green:
        r = 2
    وگرنه c برابر Color.Blue:
        r = 3
    وگرنه c برابر Color.Black:
        r = 4
    وگرنه:
        r = 5
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ pick(Color.Blue)
پایان
