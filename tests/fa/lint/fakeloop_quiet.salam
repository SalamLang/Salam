// انتظار: ok
// انتظار-کد: ۰
// EXPECT-WARNINGS: 0
ناپایا گ توقف := نادرست

ساختار جوب:
    همگانی توقف: منطقی = نادرست
پایان

تابع سپین پارام(پرچم &: منطقی، ن &: صحیح):
    تا وارونه پرچم:
        ن++
        اگر ن بزرگتر 3:
            پرچم = درست
        پایان
    پایان
پایان

تابع وایت گلوبال(ن &: صحیح):
    تا وارونه گ توقف:
        ن++
        اگر ن بزرگتر 2:
            گ توقف = درست
        پایان
    پایان
پایان

تابع وایت فیلد(ج &: جوب، ن &: صحیح):
    تا وارونه ج.توقف:
        ن++
        ج.توقف = ن بزرگتر 2
    پایان
پایان

تابع با بریاک(): صحیح:
    ناپایا ن := 0
    تا درست:
        ن++
        اگر ن بزرگتر 4:
            بشکن
        پایان
    پایان
    برگشت ن
پایان

تابع با ریت(): صحیح:
    ناپایا ن := 0
    تا درست:
        ن++
        اگر ن بزرگتر 6:
            برگشت ن
        پایان
    پایان
پایان

تابع پرچم داخل بدنه(): صحیح:
    ناپایا گو := درست
    ناپایا ن := 0
    تا گو:
        ن++
        اگر ن بزرگتر 5:
            گو = نادرست
        پایان
    پایان
    برگشت ن
پایان

تابع پرچم با کالل(): صحیح:
    ناپایا گو := درست
    ناپایا ن := 0
    تا گو:
        ن++
        فینیسه لوکال(گو)
    پایان
    برگشت ن
پایان

تابع فینیسه لوکال(پرچم &: منطقی):
    پرچم = نادرست
پایان

تابع پرچم با لامبدا(لیمیت: صحیح): صحیح:
    ناپایا گو := درست
    ناپایا ن := 0
    توقف := ():
        گو = نادرست
    پایان
    تا گو:
        ن++
        اگر ن بزرگتر لیمیت:
            توقف()
        پایان
    پایان
    برگشت ن
پایان

تابع کوونتید(): صحیح:
    ناپایا ی := 0
    ناپایا کل := 0
    تا ی کوچکتر 4:
        کل += ی
        ی++
    پایان
    برگشت کل
پایان

تابع نیستید گذرواژه(): صحیح:
    ناپایا هیتس := 0
    ناپایا رووند := 0
    تا رووند کوچکتر 3:
        ناپایا یننیر := رووند برابر 0
        تا یننیر:
            هیتس++
            یننیر = نادرست
        پایان
        رووند++
    پایان
    برگشت هیتس
پایان

تابع لاتی پرچم(): صحیح:
    ناپایا ستالی := نادرست
    ناپایا رووند := 0
    ناپایا ن := 0
    تا رووند کوچکتر 3:
        تا ستالی:
            ن++
            بشکن
        پایان
        ستالی = درست
        رووند++
    پایان
    برگشت ن
پایان

تابع کارساز ستیلی(): صحیح:
    ناپایا ن := 0
    تا درست:
        ن = بعدی مقدار(ن)
        اگر ن بزرگتر 2:
            برگشت ن
        پایان
    پایان
پایان

تابع بعدی مقدار(ن: صحیح): صحیح:
    برگشت ن + 1
پایان

تابع ریشه:
    ناپایا توقف := نادرست
    ناپایا ا := 0
    وایت گلوبال(ا)
    سپین پارام(توقف، ا)
    ناپایا ج := جوب {}
    ج.توقف = نادرست
    وایت فیلد(ج، ا)
    سرچاپ با بریاک()، با ریت()، کوونتید()، نیستید گذرواژه()، لاتی پرچم()، کارساز ستیلی()
    سرچاپ پرچم داخل بدنه()، پرچم با کالل()
    اگر ا کوچکتر ۰:
        سرچاپ پرچم با لامبدا(۱)
    پایان
    سرچاپ "ok"
پایان
