// زبان: فارسی
تابع pick(c: نویسه): صحیح:
    ترابرد c:
        'a':
            برگشت 1
        پایان
        'b'، 'B':
            برگشت 2
        پایان
        'c':
            برگشت 3
        پایان
        'd':
            برگشت 4
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick('a')، pick('B')، pick('c')، pick('d')، pick('z')
پایان
