// زبان: فارسی
تابع pick(c: نویسه): صحیح:
    اگر c برابر 'a':
        برگشت 1
    پایان
    اگر c برابر 'b' یا c برابر 'B':
        برگشت 2
    پایان
    اگر c برابر 'c':
        برگشت 3
    پایان
    اگر c برابر 'd':
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick('a')، pick('B')، pick('c')، pick('d')، pick('z')
پایان
