// زبان: فارسی
پایا KIND_A := 1
پایا KIND_B := 2
پایا KIND_C := 3
پایا KIND_D := 0 - 1

تابع انتخاب(نوع: صحیح): صحیح:
    ترابرد نوع:
        KIND_A:
            برگشت 10
        پایان
        KIND_B:
            برگشت 20
        پایان
        KIND_C، 9:
            برگشت 30
        پایان
        KIND_D:
            برگشت 40
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ انتخاب(1)، انتخاب(2)، انتخاب(3)، انتخاب(9)، انتخاب(0 - 1)، انتخاب(7)
پایان
