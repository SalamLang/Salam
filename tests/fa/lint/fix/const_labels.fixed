// زبان: فارسی
پایا KIND_A := 1
پایا KIND_B := 2
پایا KIND_C := 3
پایا KIND_D := 0 - 1

تابع pick(kind: صحیح): صحیح:
    ترابرد kind:
        KIND_A:
            برگشت 10
        پایان
        KIND_B:
            برگشت 20
        پایان
        KIND_C، 9:
            برگشت 30
        پایان
        KIND_D:
            برگشت 40
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(1)، pick(2)، pick(3)، pick(9)، pick(0 - 1)، pick(7)
پایان
