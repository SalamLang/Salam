// زبان: فارسی
پایا KIND_A := 1
پایا KIND_B := 2
پایا KIND_C := 3
پایا KIND_D := 0 - 1

تابع pick(kind: صحیح): صحیح:
    اگر kind برابر KIND_A:
        برگشت 10
    پایان
    اگر KIND_B برابر kind:
        برگشت 20
    پایان
    اگر kind برابر KIND_C یا kind برابر 9:
        برگشت 30
    پایان
    اگر kind برابر KIND_D:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(1)، pick(2)، pick(3)، pick(9)، pick(0 - 1)، pick(7)
پایان
