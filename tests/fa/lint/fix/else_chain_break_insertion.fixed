// زبان: فارسی
تابع pick(x: صحیح): صحیح:
    ناپایا r := 0
    ترابرد x:
        1:
            r = 10
            بشکن
        پایان
        2:
            r = 20
            r += 1
            بشکن
        پایان
        3، 4:
            r = 30
            بشکن
        پایان
        5:
            r = 50
            بشکن
        پایان
        وگرنه:
            r = 99
        پایان
    پایان
    برگشت r + 1
پایان

تابع ریشه:
    سرچاپ pick(1)، pick(2)، pick(3)، pick(4)، pick(5)، pick(6)
پایان
