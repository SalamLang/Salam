// زبان: فارسی
جداشمار Level:
    Low،
    Mid،
    High،
    Top
پایان

تابع name(l: Level): رشته:
    ترابرد l:
        Level.Low:
            برگشت "low"
        پایان
        Level.Mid:
            برگشت "mid"
        پایان
        Level.High:
            برگشت "high"
        پایان
        Level.Top:
            برگشت "top"
        پایان
    پایان
    برگشت "?"
پایان

تابع ریشه:
    سرچاپ name(Level.Low)، name(Level.Mid)، name(Level.High)، name(Level.Top)
پایان
