// زبان: فارسی
جداشمار Level:
    Low،
    Mid،
    High،
    Top
پایان

تابع name(l: Level): رشته:
    اگر l برابر Level.Low:
        برگشت "low"
    پایان
    اگر l برابر Level.Mid:
        برگشت "mid"
    پایان
    اگر l برابر Level.High:
        برگشت "high"
    پایان
    اگر l برابر Level.Top:
        برگشت "top"
    پایان
    برگشت "?"
پایان

تابع ریشه:
    سرچاپ name(Level.Low)، name(Level.Mid)، name(Level.High)، name(Level.Top)
پایان
