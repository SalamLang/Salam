// زبان: فارسی
جداشمار سطح:
    پایین،
    میانی،
    بالا،
    اوج
پایان

تابع نام سطح(l: سطح): رشته:
    اگر l برابر سطح.پایین:
        برگشت "low"
    پایان
    اگر l برابر سطح.میانی:
        برگشت "mid"
    پایان
    اگر l برابر سطح.بالا:
        برگشت "high"
    پایان
    اگر l برابر سطح.اوج:
        برگشت "top"
    پایان
    برگشت "?"
پایان

تابع ریشه:
    سرچاپ نام سطح(سطح.پایین)، نام سطح(سطح.میانی)، نام سطح(سطح.بالا)، نام سطح(سطح.اوج)
پایان
