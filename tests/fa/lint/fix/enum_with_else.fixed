// زبان: فارسی
جداشمار رنگ:
    قرمز،
    سبز،
    آبی،
    سیاه،
    سفید
پایان

تابع انتخاب(c: رنگ): صحیح:
    ناپایا r := 0
    ترابرد c:
        رنگ.قرمز:
            r = 1
            بشکن
        پایان
        رنگ.سبز:
            r = 2
            بشکن
        پایان
        رنگ.آبی:
            r = 3
            بشکن
        پایان
        رنگ.سیاه:
            r = 4
            بشکن
        پایان
        وگرنه:
            r = 9
        پایان
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ انتخاب(رنگ.قرمز)، انتخاب(رنگ.سبز)، انتخاب(رنگ.آبی)، انتخاب(رنگ.سیاه)، انتخاب(رنگ.سفید)
پایان
