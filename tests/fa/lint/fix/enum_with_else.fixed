// زبان: فارسی
جداشمار Color:
    Red،
    Green،
    Blue،
    Black،
    White
پایان

تابع pick(c: Color): صحیح:
    ناپایا r := 0
    ترابرد c:
        Color.Red:
            r = 1
            بشکن
        پایان
        Color.Green:
            r = 2
            بشکن
        پایان
        Color.Blue:
            r = 3
            بشکن
        پایان
        Color.Black:
            r = 4
            بشکن
        پایان
        وگرنه:
            r = 9
        پایان
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ pick(Color.Red)، pick(Color.Green)، pick(Color.Blue)، pick(Color.Black)، pick(Color.White)
پایان
