// زبان: فارسی
جداشمار Color:
    Red،
    Green،
    Blue،
    Black،
    White
پایان

تابع pick(c: Color): صحیح:
    ناپایا r := 0
    اگر c برابر Color.Red:
        r = 1
    وگرنه c برابر Color.Green:
        r = 2
    وگرنه c برابر Color.Blue:
        r = 3
    وگرنه c برابر Color.Black:
        r = 4
    وگرنه:
        r = 9
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ pick(Color.Red)، pick(Color.Green)، pick(Color.Blue)، pick(Color.Black)، pick(Color.White)
پایان
