// زبان: فارسی
تابع نمره(امتیاز: صحیح): رشته:
    ناپایا g := "F"
    ترابرد امتیاز:
        >= 90:
            g = "A"
            بشکن
        پایان
        >= 80:
            g = "B"
            بشکن
        پایان
        >= 70:
            g = "C"
            بشکن
        پایان
        >= 60:
            g = "D"
        پایان
    پایان
    برگشت g
پایان

تابع ریشه:
    سرچاپ نمره(100)، نمره(90)، نمره(89)، نمره(80)، نمره(79)، نمره(70)، نمره(60)، نمره(59)، نمره(0)
پایان
