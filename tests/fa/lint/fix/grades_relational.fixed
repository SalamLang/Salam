// زبان: فارسی
تابع grade(score: صحیح): رشته:
    ناپایا g := "F"
    ترابرد score:
        >= 90:
            g = "A"
            بشکن
        پایان
        >= 80:
            g = "B"
            بشکن
        پایان
        >= 70:
            g = "C"
            بشکن
        پایان
        >= 60:
            g = "D"
        پایان
    پایان
    برگشت g
پایان

تابع ریشه:
    سرچاپ grade(100)، grade(90)، grade(89)، grade(80)، grade(79)، grade(70)، grade(60)، grade(59)، grade(0)
پایان
