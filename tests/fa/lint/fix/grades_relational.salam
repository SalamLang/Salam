// زبان: فارسی
تابع نمره(امتیاز: صحیح): رشته:
    ناپایا g := "F"
    اگر امتیاز بزرگتربرابر 90:
        g = "A"
    وگرنه امتیاز بزرگتربرابر 80:
        g = "B"
    وگرنه امتیاز بزرگتربرابر 70:
        g = "C"
    وگرنه امتیاز بزرگتربرابر 60:
        g = "D"
    پایان
    برگشت g
پایان

تابع ریشه:
    سرچاپ نمره(100)، نمره(90)، نمره(89)، نمره(80)، نمره(79)، نمره(70)، نمره(60)، نمره(59)، نمره(0)
پایان
