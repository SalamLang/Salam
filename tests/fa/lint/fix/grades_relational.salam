// زبان: فارسی
تابع grade(score: صحیح): رشته:
    ناپایا g := "F"
    اگر score بزرگتربرابر 90:
        g = "A"
    وگرنه score بزرگتربرابر 80:
        g = "B"
    وگرنه score بزرگتربرابر 70:
        g = "C"
    وگرنه score بزرگتربرابر 60:
        g = "D"
    پایان
    برگشت g
پایان

تابع ریشه:
    سرچاپ grade(100)، grade(90)، grade(89)، grade(80)، grade(79)، grade(70)، grade(60)، grade(59)، grade(0)
پایان
