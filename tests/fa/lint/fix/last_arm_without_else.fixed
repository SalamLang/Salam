// زبان: فارسی
تابع pick(x: صحیح): صحیح:
    ناپایا r := 0
    ترابرد x:
        1:
            r = 10
            بشکن
        پایان
        2:
            r = 20
            بشکن
        پایان
        3:
            r = 30
            بشکن
        پایان
        4:
            r = 40
        پایان
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ pick(1)، pick(2)، pick(3)، pick(4)، pick(5)
پایان
