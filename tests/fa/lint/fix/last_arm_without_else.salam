// زبان: فارسی
تابع pick(x: صحیح): صحیح:
    ناپایا r := 0
    اگر x برابر 1:
        r = 10
    وگرنه x برابر 2:
        r = 20
    وگرنه x برابر 3:
        r = 30
    وگرنه x برابر 4:
        r = 40
    پایان
    برگشت r
پایان

تابع ریشه:
    سرچاپ pick(1)، pick(2)، pick(3)، pick(4)، pick(5)
پایان
