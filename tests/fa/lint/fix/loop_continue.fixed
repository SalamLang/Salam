// زبان: فارسی
تابع انتخاب(فهرست: وکتور<صحیح>): صحیح:
    ناپایا n := 0
    هر v در فهرست:
        ترابرد v:
            1:
                n += 1
                گذر
            پایان
            2:
                n += 2
                گذر
            پایان
            3:
                n += 3
                گذر
            پایان
            4:
                n += 4
                گذر
            پایان
        پایان
        n += 100
    پایان
    برگشت n
پایان

تابع ریشه:
    ناپایا فهرست := وکتور {} برگردان وکتور<صحیح>
    فهرست.بیفزا(1)
    فهرست.بیفزا(4)
    فهرست.بیفزا(9)
    فهرست.بیفزا(2)
    سرچاپ انتخاب(فهرست)
پایان
