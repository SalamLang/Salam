// زبان: فارسی
تابع pick(xs: وکتور<صحیح>): صحیح:
    ناپایا n := 0
    هر v در xs:
        ترابرد v:
            1:
                n += 1
                گذر
            پایان
            2:
                n += 2
                گذر
            پایان
            3:
                n += 3
                گذر
            پایان
            4:
                n += 4
                گذر
            پایان
        پایان
        n += 100
    پایان
    برگشت n
پایان

تابع ریشه:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    xs.بیفزا(1)
    xs.بیفزا(4)
    xs.بیفزا(9)
    xs.بیفزا(2)
    سرچاپ pick(xs)
پایان
