// زبان: فارسی
تابع pick(fl: صحیح۶۴): صحیح:
    ترابرد (fl & (3 برگردان صحیح۶۴)):
        0 برگردان صحیح۶۴:
            برگشت 1
        پایان
        1 برگردان صحیح۶۴:
            برگشت 2
        پایان
        2 برگردان صحیح۶۴:
            برگشت 3
        پایان
        3 برگردان صحیح۶۴:
            برگشت 4
        پایان
    پایان
    برگشت 0
پایان

تابع pick_cast(k: طبیعی۸): صحیح:
    ترابرد (k برگردان صحیح):
        1:
            برگشت 10
        پایان
        2:
            برگشت 20
        پایان
        3:
            برگشت 30
        پایان
        4:
            برگشت 40
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(4 برگردان صحیح۶۴)، pick(5 برگردان صحیح۶۴)، pick(6 برگردان صحیح۶۴)، pick(7 برگردان صحیح۶۴)
    سرچاپ pick_cast(1 برگردان طبیعی۸)، pick_cast(4 برگردان طبیعی۸)، pick_cast(9 برگردان طبیعی۸)
پایان
