// زبان: فارسی
تابع pick(fl: صحیح۶۴): صحیح:
    اگر (fl & (3 برگردان صحیح۶۴)) برابر (0 برگردان صحیح۶۴):
        برگشت 1
    پایان
    اگر (fl & (3 برگردان صحیح۶۴)) برابر (1 برگردان صحیح۶۴):
        برگشت 2
    پایان
    اگر (fl & (3 برگردان صحیح۶۴)) برابر (2 برگردان صحیح۶۴):
        برگشت 3
    پایان
    اگر (fl & (3 برگردان صحیح۶۴)) برابر (3 برگردان صحیح۶۴):
        برگشت 4
    پایان
    برگشت 0
پایان

تابع pick_cast(k: طبیعی۸): صحیح:
    اگر (k برگردان صحیح) برابر 1:
        برگشت 10
    پایان
    اگر (k برگردان صحیح) برابر 2:
        برگشت 20
    پایان
    اگر (k برگردان صحیح) برابر 3:
        برگشت 30
    پایان
    اگر (k برگردان صحیح) برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(4 برگردان صحیح۶۴)، pick(5 برگردان صحیح۶۴)، pick(6 برگردان صحیح۶۴)، pick(7 برگردان صحیح۶۴)
    سرچاپ pick_cast(1 برگردان طبیعی۸)، pick_cast(4 برگردان طبیعی۸)، pick_cast(9 برگردان طبیعی۸)
پایان
