// زبان: فارسی
ساختار Item:
    همگانی kind: صحیح = 0
    همگانی tags: وکتور<صحیح> = وکتور {}
پایان

تابع by_field(it: Item): صحیح:
    ترابرد it.kind:
        1:
            برگشت 10
        پایان
        2:
            برگشت 20
        پایان
        3:
            برگشت 30
        پایان
        4:
            برگشت 40
        پایان
    پایان
    برگشت 0
پایان

تابع by_index(it &: Item، i: صحیح): صحیح:
    ترابرد it.tags[i]:
        1:
            برگشت 10
        پایان
        2:
            برگشت 20
        پایان
        3:
            برگشت 30
        پایان
        4:
            برگشت 40
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    ناپایا it := Item {}
    it.kind = 2
    it.tags.بیفزا(3)
    it.tags.بیفزا(4)
    سرچاپ by_field(it)، by_index(it، 0)، by_index(it، 1)
پایان
