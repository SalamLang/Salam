// زبان: فارسی
ساختار قلم:
    همگانی نوع: صحیح = 0
    همگانی برچسب‌ها: وکتور<صحیح> = وکتور {}
پایان

تابع انتخاب نوع(مورد: قلم): صحیح:
    ترابرد مورد.نوع:
        1:
            برگشت 10
        پایان
        2:
            برگشت 20
        پایان
        3:
            برگشت 30
        پایان
        4:
            برگشت 40
        پایان
    پایان
    برگشت 0
پایان

تابع انتخاب برچسب(مورد &: قلم، i: صحیح): صحیح:
    ترابرد مورد.برچسب‌ها[i]:
        1:
            برگشت 10
        پایان
        2:
            برگشت 20
        پایان
        3:
            برگشت 30
        پایان
        4:
            برگشت 40
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    ناپایا مورد := قلم {}
    مورد.نوع = 2
    مورد.برچسب‌ها.بیفزا(3)
    مورد.برچسب‌ها.بیفزا(4)
    سرچاپ انتخاب نوع(مورد)، انتخاب برچسب(مورد، 0)، انتخاب برچسب(مورد، 1)
پایان
