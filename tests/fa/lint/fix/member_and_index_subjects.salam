// زبان: فارسی
ساختار قلم:
    همگانی نوع: صحیح = 0
    همگانی برچسب‌ها: وکتور<صحیح> = وکتور {}
پایان

تابع انتخاب نوع(مورد: قلم): صحیح:
    اگر مورد.نوع برابر 1:
        برگشت 10
    پایان
    اگر مورد.نوع برابر 2:
        برگشت 20
    پایان
    اگر مورد.نوع برابر 3:
        برگشت 30
    پایان
    اگر مورد.نوع برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع انتخاب برچسب(مورد &: قلم، i: صحیح): صحیح:
    اگر مورد.برچسب‌ها[i] برابر 1:
        برگشت 10
    پایان
    اگر مورد.برچسب‌ها[i] برابر 2:
        برگشت 20
    پایان
    اگر مورد.برچسب‌ها[i] برابر 3:
        برگشت 30
    پایان
    اگر مورد.برچسب‌ها[i] برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    ناپایا مورد := قلم {}
    مورد.نوع = 2
    مورد.برچسب‌ها.بیفزا(3)
    مورد.برچسب‌ها.بیفزا(4)
    سرچاپ انتخاب نوع(مورد)، انتخاب برچسب(مورد، 0)، انتخاب برچسب(مورد، 1)
پایان
