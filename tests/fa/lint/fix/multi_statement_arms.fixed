// زبان: فارسی
تابع pick(x: صحیح): صحیح:
    ناپایا total := 0
    ترابرد x:
        1:
            total += 1

            total += 2
            برگشت total
        پایان
        2:
            تکرار 4 در i:
                اگر i برابر 2:
                    گذر
                پایان
                total += i
            پایان
            برگشت total
        پایان
        3:
            برگشت 300
        پایان
        4:
            دیرکن سرچاپ "deferred"
            برگشت 400
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(1)، pick(2)، pick(3)، pick(4)، pick(5)
پایان
