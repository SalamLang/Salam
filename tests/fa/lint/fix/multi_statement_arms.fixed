// زبان: فارسی
تابع انتخاب(x: صحیح): صحیح:
    ناپایا جمع کل := 0
    ترابرد x:
        1:
            جمع کل += 1

            جمع کل += 2
            برگشت جمع کل
        پایان
        2:
            تکرار 4 در i:
                اگر i برابر 2:
                    گذر
                پایان
                جمع کل += i
            پایان
            برگشت جمع کل
        پایان
        3:
            برگشت 300
        پایان
        4:
            دیرکن سرچاپ "deferred"
            برگشت 400
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ انتخاب(1)، انتخاب(2)، انتخاب(3)، انتخاب(4)، انتخاب(5)
پایان
