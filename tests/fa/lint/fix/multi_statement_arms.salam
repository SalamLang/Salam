// زبان: فارسی
تابع pick(x: صحیح): صحیح:
    ناپایا total := 0
    اگر x برابر 1:
        total += 1

        total += 2
        برگشت total
    پایان
    اگر x برابر 2:
        تکرار 4 در i:
            اگر i برابر 2:
                گذر
            پایان
            total += i
        پایان
        برگشت total
    پایان
    اگر x برابر 3:
        برگشت 300
    پایان
    اگر x برابر 4:
        دیرکن سرچاپ "deferred"
        برگشت 400
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(1)، pick(2)، pick(3)، pick(4)، pick(5)
پایان
