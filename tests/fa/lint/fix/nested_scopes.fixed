// زبان: فارسی
تابع انتخاب(فهرست: وکتور<صحیح>، y: صحیح): صحیح:
    ناپایا n := 0
    هر v در فهرست:
        اگر y بزرگتر 0:
            ترابرد v:
                1:
                    n++
                    بشکن
                پایان
                2:
                    n += 2
                    بشکن
                پایان
                3:
                    n += 3
                    بشکن
                پایان
                4:
                    n += 4
                پایان
            پایان
        پایان
    پایان
    f := (z: صحیح):
        ترابرد z:
            1:
                برگشت 10
            پایان
            2:
                برگشت 20
            پایان
            3:
                برگشت 30
            پایان
            4:
                برگشت 40
            پایان
        پایان
        برگشت 0
    پایان
    ترابرد y:
        1:
            برگشت n + f(y)
        پایان
        2:
            برگشت n + f(y)
        پایان
        3:
            برگشت n + f(y)
        پایان
        4:
            برگشت n + f(y)
        پایان
    پایان
    برگشت n
پایان

تابع ریشه:
    ناپایا فهرست := وکتور {} برگردان وکتور<صحیح>
    فهرست.بیفزا(2)
    فهرست.بیفزا(3)
    فهرست.بیفزا(9)
    سرچاپ انتخاب(فهرست، 1)، انتخاب(فهرست، 3)، انتخاب(فهرست، 4)، انتخاب(فهرست، 0)
پایان
