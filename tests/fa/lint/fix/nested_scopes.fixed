// زبان: فارسی
تابع pick(xs: وکتور<صحیح>، y: صحیح): صحیح:
    ناپایا n := 0
    هر v در xs:
        اگر y بزرگتر 0:
            ترابرد v:
                1:
                    n += 1
                    بشکن
                پایان
                2:
                    n += 2
                    بشکن
                پایان
                3:
                    n += 3
                    بشکن
                پایان
                4:
                    n += 4
                پایان
            پایان
        پایان
    پایان
    f := (z: صحیح):
        ترابرد z:
            1:
                برگشت 10
            پایان
            2:
                برگشت 20
            پایان
            3:
                برگشت 30
            پایان
            4:
                برگشت 40
            پایان
        پایان
        برگشت 0
    پایان
    ترابرد y:
        1:
            برگشت n + f(y)
        پایان
        2:
            برگشت n + f(y)
        پایان
        3:
            برگشت n + f(y)
        پایان
        4:
            برگشت n + f(y)
        پایان
    پایان
    برگشت n
پایان

تابع ریشه:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    xs.بیفزا(2)
    xs.بیفزا(3)
    xs.بیفزا(9)
    سرچاپ pick(xs، 1)، pick(xs، 3)، pick(xs، 4)، pick(xs، 0)
پایان
