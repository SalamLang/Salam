// زبان: فارسی
تابع pick(ty: صحیح): صحیح:
    ترابرد ty:
        7:
            برگشت 1
        پایان
        8:
            برگشت 2
        پایان
        9، 12:
            برگشت 3
        پایان
        11:
            برگشت 4
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(7)، pick(8)، pick(9)، pick(12)، pick(11)، pick(5)
پایان
