// زبان: فارسی
تابع pick(ty: صحیح): صحیح:
    اگر ty برابر 7:
        برگشت 1
    پایان
    اگر (ty) برابر (8):
        برگشت 2
    پایان
    اگر 9 برابر ty یا ty برابر 12:
        برگشت 3
    پایان
    اگر ty برابر 11:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(7)، pick(8)، pick(9)، pick(12)، pick(11)، pick(5)
پایان
