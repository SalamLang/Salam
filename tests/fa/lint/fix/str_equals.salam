// زبان: فارسی
واردسازی رشته

تابع pick(s: رشته): صحیح:
    اگر رشته.یکسان است(s، "red"):
        برگشت 1
    پایان
    اگر رشته.یکسان است(s، "green") یا رشته.یکسان است("lime"، s):
        برگشت 2
    پایان
    اگر s برابر "blue":
        برگشت 3
    پایان
    اگر رشته.یکسان است(s، "cyan"):
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick("red")، pick("lime")، pick("green")، pick("blue")، pick("cyan")، pick("pink")
پایان
