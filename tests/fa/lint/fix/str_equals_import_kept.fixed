// زبان: فارسی
واردسازی رشته

تابع pick(s: رشته): صحیح:
    ترابرد s:
        "red":
            برگشت 1
        پایان
        "green":
            برگشت 2
        پایان
        "blue":
            برگشت 3
        پایان
        "cyan":
            برگشت 4
        پایان
    پایان
    برگشت رشته.طول(s)
پایان

تابع ریشه:
    سرچاپ pick("red")، pick("cyan")، pick("pink")
پایان
