// زبان: فارسی
واردسازی رشته

تابع pick(s: رشته): صحیح:
    اگر رشته.یکسان است(s، "red"):
        برگشت 1
    پایان
    اگر رشته.یکسان است(s، "green"):
        برگشت 2
    پایان
    اگر رشته.یکسان است(s، "blue"):
        برگشت 3
    پایان
    اگر رشته.یکسان است(s، "cyan"):
        برگشت 4
    پایان
    برگشت رشته.طول(s)
پایان

تابع ریشه:
    سرچاپ pick("red")، pick("cyan")، pick("pink")
پایان
