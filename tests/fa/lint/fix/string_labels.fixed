// زبان: فارسی
تابع pick(s: رشته): صحیح:
    ترابرد s:
        "red":
            برگشت 1
        پایان
        "green"، "lime":
            برگشت 2
        پایان
        "blue":
            برگشت 3
        پایان
        "cyan":
            برگشت 4
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick("red")، pick("lime")، pick("green")، pick("cyan")، pick("pink")
پایان
