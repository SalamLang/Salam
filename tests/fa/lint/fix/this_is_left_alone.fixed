// زبان: فارسی
ساختار شمارنده:
    همگانی ن: صحیح = ۰
    همگانی تابع نام(ک: صحیح): رشته:
        ترابرد ک:
            ۱:
                برگشت "یک"
            پایان
            ۲:
                برگشت "دو"
            پایان
            ۳:
                برگشت "سه"
            پایان
            ۴:
                برگشت "چهار"
            پایان
        پایان
        برگشت "بسیار"
    پایان
    همگانی تابع افزایش(): صحیح:
        این.ن += ۱
        برگشت این.ن
    پایان
پایان

تابع ریشه:
    ناپایا ش := شمارنده {}
    سرچاپ ش.نام(۲)، ش.نام(۹)، ش.افزایش()، ش.افزایش()
پایان
