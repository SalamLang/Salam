// زبان: فارسی
ساختار شمارنده:
    همگانی ن: صحیح = ۰
    همگانی تابع نام(ک: صحیح): رشته:
        اگر ک برابر ۱:
            برگشت "یک"
        وگرنه ک برابر ۲:
            برگشت "دو"
        وگرنه ک برابر ۳:
            برگشت "سه"
        وگرنه ک برابر ۴:
            برگشت "چهار"
        پایان
        برگشت "بسیار"
    پایان
    همگانی تابع افزایش(): صحیح:
        این.ن++
        برگشت این.ن
    پایان
پایان

تابع ریشه:
    ناپایا ش := شمارنده {}
    سرچاپ ش.نام(۲)، ش.نام(۹)، ش.افزایش()، ش.افزایش()
پایان
