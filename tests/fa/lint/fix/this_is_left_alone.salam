// زبان: فارسی
ساختار شمارنده:
    همگانی ن: صحیح = ۰
    همگانی تابع نام(ک: صحیح): رشته:
        اگر ک == ۱:
            برگشت "یک"
        وگرنه ک == ۲:
            برگشت "دو"
        وگرنه ک == ۳:
            برگشت "سه"
        وگرنه ک == ۴:
            برگشت "چهار"
        پایان
        برگشت "بسیار"
    پایان
    همگانی تابع افزایش(): صحیح:
        این.ن += ۱
        برگشت این.ن
    پایان
پایان

تابع ریشه:
    ناپایا ش := شمارنده {}
    سرچاپ ش.نام(۲)، ش.نام(۹)، ش.افزایش()، ش.افزایش()
پایان
