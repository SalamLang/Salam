// زبان: فارسی
تابع pick(x: صحیح، y: صحیح): صحیح:
    ترابرد x:
        1:
            برگشت 10
        پایان
        2:
            برگشت 20
        پایان
        3:
            برگشت 30
        پایان
        4:
            برگشت 40
        پایان
    پایان
    سرچاپ "between"
    ترابرد y:
        1:
            برگشت 1
        پایان
        2:
            برگشت 2
        پایان
        3:
            برگشت 3
        پایان
        4:
            برگشت 4
        پایان
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(0، 3)، pick(2، 0)، pick(0، 0)
پایان
