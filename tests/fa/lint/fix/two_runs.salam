// زبان: فارسی
تابع pick(x: صحیح، y: صحیح): صحیح:
    اگر x برابر 1:
        برگشت 10
    پایان
    اگر x برابر 2:
        برگشت 20
    پایان
    اگر x برابر 3:
        برگشت 30
    پایان
    اگر x برابر 4:
        برگشت 40
    پایان
    سرچاپ "between"
    اگر y برابر 1:
        برگشت 1
    پایان
    اگر y برابر 2:
        برگشت 2
    پایان
    اگر y برابر 3:
        برگشت 3
    پایان
    اگر y برابر 4:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(0، 3)، pick(2، 0)، pick(0، 0)
پایان
