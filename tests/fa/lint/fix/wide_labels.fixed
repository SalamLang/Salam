// زبان: فارسی
پایا SHT_NULL := 0
پایا SHT_LOUSER := 0x80000000
پایا NEG := 0 - 5

تابع دسته(نوع: صحیح۶۴): صحیح:
    ترابرد نوع:
        7 برگردان صحیح۶۴:
            برگشت 1
        پایان
        0x70000001 برگردان صحیح۶۴:
            برگشت 2
        پایان
        NEG برگردان صحیح۶۴، SHT_NULL برگردان صحیح۶۴:
            برگشت 3
        پایان
        SHT_LOUSER:
            برگشت 4
        پایان
    پایان
    برگشت 0
پایان

تابع بزرگ(v: طبیعی۳۲): صحیح:
    ترابرد v:
        0x7FFFFFFF:
            برگشت 1
        پایان
        4000000000:
            برگشت 2
        پایان
        255:
            برگشت 3
        پایان
        0:
            برگشت 4
        پایان
    پایان
    برگشت 5
پایان

تابع ریشه:
    سرچاپ دسته(7 برگردان صحیح۶۴)، دسته(0x70000001 برگردان صحیح۶۴)، دسته(0 برگردان صحیح۶۴)، دسته(0x80000000 برگردان صحیح۶۴)، دسته(9 برگردان صحیح۶۴)
    سرچاپ بزرگ(0x7FFFFFFF برگردان طبیعی۳۲)، بزرگ(4000000000 برگردان طبیعی۳۲)، بزرگ(255 برگردان طبیعی۳۲)، بزرگ(0 برگردان طبیعی۳۲)، بزرگ(1 برگردان طبیعی۳۲)
پایان
