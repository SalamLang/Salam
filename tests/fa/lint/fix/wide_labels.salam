// زبان: فارسی
پایا SHT_NULL := 0
پایا SHT_LOUSER := 0x80000000
پایا NEG := 0 - 5

تابع دسته(نوع: صحیح۶۴): صحیح:
    اگر نوع برابر (7 برگردان صحیح۶۴):
        برگشت 1
    پایان
    اگر نوع برابر (0x70000001 برگردان صحیح۶۴):
        برگشت 2
    پایان
    اگر نوع برابر (NEG برگردان صحیح۶۴) یا نوع برابر (SHT_NULL برگردان صحیح۶۴):
        برگشت 3
    پایان
    اگر نوع برابر SHT_LOUSER:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع بزرگ(v: طبیعی۳۲): صحیح:
    اگر v برابر 0x7FFFFFFF:
        برگشت 1
    پایان
    اگر v برابر 4000000000:
        برگشت 2
    پایان
    اگر v برابر 255:
        برگشت 3
    پایان
    اگر v برابر 0:
        برگشت 4
    پایان
    برگشت 5
پایان

تابع ریشه:
    سرچاپ دسته(7 برگردان صحیح۶۴)، دسته(0x70000001 برگردان صحیح۶۴)، دسته(0 برگردان صحیح۶۴)، دسته(0x80000000 برگردان صحیح۶۴)، دسته(9 برگردان صحیح۶۴)
    سرچاپ بزرگ(0x7FFFFFFF برگردان طبیعی۳۲)، بزرگ(4000000000 برگردان طبیعی۳۲)، بزرگ(255 برگردان طبیعی۳۲)، بزرگ(0 برگردان طبیعی۳۲)، بزرگ(1 برگردان طبیعی۳۲)
پایان
