// زبان: فارسی
پایا SHT_NULL := 0
پایا SHT_LOUSER := 0x80000000
پایا NEG := 0 - 5

تابع kind(ty: صحیح۶۴): صحیح:
    اگر ty برابر (7 برگردان صحیح۶۴):
        برگشت 1
    پایان
    اگر ty برابر (0x70000001 برگردان صحیح۶۴):
        برگشت 2
    پایان
    اگر ty برابر (NEG برگردان صحیح۶۴) یا ty برابر (SHT_NULL برگردان صحیح۶۴):
        برگشت 3
    پایان
    اگر ty برابر SHT_LOUSER:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع big(v: طبیعی۳۲): صحیح:
    اگر v برابر 0x7FFFFFFF:
        برگشت 1
    پایان
    اگر v برابر 4000000000:
        برگشت 2
    پایان
    اگر v برابر 255:
        برگشت 3
    پایان
    اگر v برابر 0:
        برگشت 4
    پایان
    برگشت 5
پایان

تابع ریشه:
    سرچاپ kind(7 برگردان صحیح۶۴)، kind(0x70000001 برگردان صحیح۶۴)، kind(0 برگردان صحیح۶۴)، kind(0x80000000 برگردان صحیح۶۴)، kind(9 برگردان صحیح۶۴)
    سرچاپ big(0x7FFFFFFF برگردان طبیعی۳۲)، big(4000000000 برگردان طبیعی۳۲)، big(255 برگردان طبیعی۳۲)، big(0 برگردان طبیعی۳۲)، big(1 برگردان طبیعی۳۲)
پایان
