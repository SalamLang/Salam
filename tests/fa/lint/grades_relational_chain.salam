// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

تابع grade(score: صحیح): رشته:
    ناپایا g := "F"
    اگر score بزرگتربرابر 90:
        g = "A"
    وگرنه score بزرگتربرابر 80:
        g = "B"
    وگرنه score بزرگتربرابر 70:
        g = "C"
    وگرنه score بزرگتربرابر 60:
        g = "D"
    پایان
    برگشت g
پایان

تابع ریشه:
    سرچاپ grade(95)، grade(85)، grade(72)، grade(61)، grade(10)
پایان
