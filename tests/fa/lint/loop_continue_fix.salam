// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

تابع pick(xs: وکتور<صحیح>): صحیح:
    ناپایا n := 0
    هر v در xs:
        اگر v برابر 1:
            n += 1
            گذر
        پایان
        اگر v برابر 2:
            n += 2
            گذر
        پایان
        اگر v برابر 3:
            n += 3
            گذر
        پایان
        اگر v برابر 4:
            n += 4
            گذر
        پایان
        n += 100
    پایان
    برگشت n
پایان

تابع ریشه:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    xs.بیفزا(1)
    xs.بیفزا(4)
    xs.بیفزا(9)
    سرچاپ pick(xs)
پایان
