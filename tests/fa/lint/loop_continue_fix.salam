// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

تابع انتخاب(فهرست: وکتور<صحیح>): صحیح:
    ناپایا n := 0
    هر v در فهرست:
        اگر v برابر 1:
            n += 1
            گذر
        پایان
        اگر v برابر 2:
            n += 2
            گذر
        پایان
        اگر v برابر 3:
            n += 3
            گذر
        پایان
        اگر v برابر 4:
            n += 4
            گذر
        پایان
        n += 100
    پایان
    برگشت n
پایان

تابع ریشه:
    ناپایا فهرست := وکتور {} برگردان وکتور<صحیح>
    فهرست.بیفزا(1)
    فهرست.بیفزا(4)
    فهرست.بیفزا(9)
    سرچاپ انتخاب(فهرست)
پایان
