// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

تابع pick(fl: صحیح۶۴): صحیح:
    اگر (fl & (3 برگردان صحیح۶۴)) برابر (0 برگردان صحیح۶۴):
        برگشت 1
    پایان
    اگر (fl & (3 برگردان صحیح۶۴)) برابر (1 برگردان صحیح۶۴):
        برگشت 2
    پایان
    اگر (fl & (3 برگردان صحیح۶۴)) برابر (2 برگردان صحیح۶۴):
        برگشت 3
    پایان
    اگر (fl & (3 برگردان صحیح۶۴)) برابر (3 برگردان صحیح۶۴):
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(6 برگردان صحیح۶۴)
پایان
