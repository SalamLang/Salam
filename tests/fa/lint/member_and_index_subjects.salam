// زبان: فارسی
// EXPECT-WARNINGS: 2
// EXPECT-FIXES: 2

ساختار Item:
    همگانی kind: صحیح = 0
    همگانی tags: وکتور<صحیح> = وکتور {}
پایان

تابع by_field(it: Item): صحیح:
    اگر it.kind برابر 1:
        برگشت 10
    پایان
    اگر it.kind برابر 2:
        برگشت 20
    پایان
    اگر it.kind برابر 3:
        برگشت 30
    پایان
    اگر it.kind برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع by_index(it &: Item، i: صحیح): صحیح:
    اگر it.tags[i] برابر 1:
        برگشت 10
    پایان
    اگر it.tags[i] برابر 2:
        برگشت 20
    پایان
    اگر it.tags[i] برابر 3:
        برگشت 30
    پایان
    اگر it.tags[i] برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    ناپایا it := Item {}
    it.kind = 2
    it.tags.بیفزا(3)
    سرچاپ by_field(it)، by_index(it، 0)
پایان
