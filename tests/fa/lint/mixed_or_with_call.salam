// زبان: فارسی
// EXPECT-WARNINGS: 0

واردسازی رشته

تابع starts(s: رشته، p: رشته): منطقی:
    برگشت رشته.شروع با(s، p)
پایان

تابع pick(ty: صحیح، name: رشته): صحیح:
    اگر ty برابر 1 یا starts(name، "a"):
        برگشت 10
    پایان
    اگر ty برابر 2 یا starts(name، "b"):
        برگشت 20
    پایان
    اگر ty برابر 3 یا starts(name، "c"):
        برگشت 30
    پایان
    اگر ty برابر 4 یا starts(name، "d"):
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(3، "z")
پایان
