// زبان: فارسی
// EXPECT-WARNINGS: 3
// EXPECT-FIXES: 3

تابع pick(xs: وکتور<صحیح>، y: صحیح): صحیح:
    ناپایا n := 0
    هر v در xs:
        اگر y بزرگتر 0:
            اگر v برابر 1:
                n += 1
            وگرنه v برابر 2:
                n += 2
            وگرنه v برابر 3:
                n += 3
            وگرنه v برابر 4:
                n += 4
            پایان
        پایان
    پایان
    f := (z: صحیح):
        اگر z برابر 1:
            برگشت 10
        پایان
        اگر z برابر 2:
            برگشت 20
        پایان
        اگر z برابر 3:
            برگشت 30
        پایان
        اگر z برابر 4:
            برگشت 40
        پایان
        برگشت 0
    پایان
    اگر y برابر 1:
        برگشت n + f(y)
    پایان
    اگر y برابر 2:
        برگشت n + 2
    پایان
    اگر y برابر 3:
        برگشت n + 3
    پایان
    اگر y برابر 4:
        برگشت n + 4
    پایان
    برگشت n
پایان

تابع ریشه:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    xs.بیفزا(2)
    سرچاپ pick(xs، 1)
پایان
