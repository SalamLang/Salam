// زبان: فارسی
// EXPECT-WARNINGS: 0

تابع pick(x: صحیح): صحیح:
    اگر x نابرابر 1:
        برگشت 10
    پایان
    اگر x کوچکتر 2:
        برگشت 20
    پایان
    اگر x بزرگتربرابر 3 و x برابر 4:
        برگشت 30
    پایان
    اگر x بزرگتر 5:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(4)
پایان
