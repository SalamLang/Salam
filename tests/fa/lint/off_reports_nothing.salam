// زبان: فارسی
// ARGS: --switch-lint=off
// EXPECT-WARNINGS: 0

تابع pick(x: صحیح): صحیح:
    اگر x برابر 1:
        برگشت 10
    پایان
    اگر x برابر 2:
        برگشت 20
    پایان
    اگر x برابر 3:
        برگشت 30
    پایان
    اگر x برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(3)
پایان
