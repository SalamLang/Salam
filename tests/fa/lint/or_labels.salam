// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

تابع pick(x: صحیح): صحیح:
    اگر x برابر 1 یا x برابر 2:
        برگشت 10
    پایان
    اگر x برابر 3 یا x برابر 4 یا x برابر 5:
        برگشت 20
    پایان
    اگر x برابر 6:
        برگشت 30
    پایان
    اگر x برابر 7:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(5)
پایان
