// EXPECT-CODE: 163
// EXPECT-WARNINGS: 1
// EXPECT-MSG: 'مشترک' پس از جابه‌جا شدن بافرش
// EXPECT-NOT: 'فهرست' پس از
// EXPECT-NOT: 'کلمات' پس از
// EXPECT-NOT: 'سنین' پس از
// EXPECT-NOT: 'برچسب' پس از
تابع ریشه:
    ناپایا فهرست := وکتور {} برگردان وکتور<صحیح>
    فهرست.بیفزا(۱)
    الف := فهرست.رونوشت()
    فهرست.بیفزا(۲)
    سرچاپ الف.طول()، فهرست.طول()

    ناپایا کلمات := وکتور {} برگردان وکتور<رشته>
    کلمات.بیفزا("x")
    ب := کلمات.رونوشت عمیق()
    کلمات.بیفزا("y")
    سرچاپ ب.طول()، کلمات.طول()

    ناپایا سنین := نگاشت {} برگردان نگاشت<رشته، صحیح>
    سنین.درج("x"، ۱)
    پ := سنین.رونوشت()
    سنین.درج("y"، ۲)
    سرچاپ پ.اندازه()، سنین.اندازه()

    ناپایا برچسب := نگاشت {} برگردان نگاشت<رشته، رشته>
    برچسب.درج("x"، "1")
    ت := برچسب.رونوشت عمیق()
    برچسب.درج("y"، "2")
    سرچاپ ت.اندازه()، برچسب.اندازه()

    ناپایا مشترک := وکتور {} برگردان وکتور<صحیح>
    مشترک.بیفزا(۱)
    ث := مشترک
    مشترک.بیفزا(۲)
    سرچاپ ث.طول()، مشترک.طول()
پایان
