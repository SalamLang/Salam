// EXPECT-CODE: 143
// EXPECT-WARNINGS: 0
// EXPECT-NOT: ۱۴۲
تابع ریشه:
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    نام‌ها.بیفزا("a")
    نام‌ها.آزادکن()
    سرچاپ نام‌ها.طول()

    ناپایا دیده := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن دیده.آزادکن()
    دیده.درج("a"، ۱)
    سرچاپ دیده.اندازه()
    دیده.آزادکن()
پایان
