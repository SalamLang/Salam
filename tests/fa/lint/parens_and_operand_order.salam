// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

تابع pick(ty: صحیح): صحیح:
    اگر ty برابر 7:
        برگشت 1
    پایان
    اگر (ty) برابر (8):
        برگشت 2
    پایان
    اگر 9 برابر ty:
        برگشت 3
    پایان
    اگر ((ty)) برابر 10:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(9)
پایان
