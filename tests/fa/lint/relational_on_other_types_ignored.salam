// زبان: فارسی
// EXPECT-WARNINGS: 0

تابع by_float(f: اعشار۶۴): صحیح:
    اگر f کوچکتر 1.0:
        برگشت 1
    پایان
    اگر f کوچکتر 2.0:
        برگشت 2
    پایان
    اگر f کوچکتر 3.0:
        برگشت 3
    پایان
    اگر f کوچکتر 4.0:
        برگشت 4
    پایان
    برگشت 0
پایان

تابع by_text(s: رشته): صحیح:
    اگر s کوچکتر "d":
        برگشت 1
    پایان
    اگر s کوچکتر "h":
        برگشت 2
    پایان
    اگر s کوچکتر "m":
        برگشت 3
    پایان
    اگر s کوچکتر "s":
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ by_float(2.5)، by_text("k")
پایان
