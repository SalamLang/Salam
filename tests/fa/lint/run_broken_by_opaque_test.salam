// زبان: فارسی
// ARGS: --switch-lint=warn --switch-lint-min=2
// EXPECT-WARNINGS: 2
// EXPECT-FIXES: 2

تابع pick(x: صحیح، y: صحیح): صحیح:
    اگر x برابر 1:
        برگشت 10
    پایان
    اگر x برابر 2:
        برگشت 20
    پایان
    اگر y بزرگتر 0:
        برگشت 99
    پایان
    اگر x برابر 3:
        برگشت 30
    پایان
    اگر x برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(4، 0)
پایان
