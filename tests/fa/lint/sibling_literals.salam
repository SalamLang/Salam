// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1
// EXPECT-MSG: ۴ مقایسه‌ی پشت‌سرهم 'x' با مقدارهای ثابت را می‌شود با یک ترابرد نوشت
// EXPECT-MSG: آن‌ها را به‌صورت 'ترابرد x:' بنویسید و برای هر مقدار ثابت یک برچسب بگذارید

تابع pick(x: صحیح): صحیح:
    اگر x برابر 1:
        برگشت 10
    پایان
    اگر x برابر 2:
        برگشت 20
    پایان
    اگر x برابر 3:
        برگشت 30
    پایان
    اگر x برابر 4:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick(3)
پایان
