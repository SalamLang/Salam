// زبان: فارسی
// EXPECT-WARNINGS: 0

تابع pick(x: صحیح): صحیح:
    ناپایا y := x
    اگر y برابر 1:
        y = 2
    پایان
    اگر y برابر 2:
        y = 3
    پایان
    اگر y برابر 3:
        y = 4
    پایان
    اگر y برابر 4:
        y = 5
    پایان
    برگشت y
پایان

تابع ریشه:
    سرچاپ pick(1)
پایان
