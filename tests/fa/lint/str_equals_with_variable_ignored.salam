// زبان: فارسی
// EXPECT-WARNINGS: 0

واردسازی رشته

تابع pick(a: رشته، b: رشته): صحیح:
    اگر رشته.یکسان است(a، b):
        برگشت 1
    پایان
    اگر رشته.یکسان است(a، "x"):
        برگشت 2
    پایان
    اگر رشته.یکسان است(b، "y"):
        برگشت 3
    پایان
    اگر رشته.یکسان است(a، b + "!"):
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick("a"، "b")
پایان
