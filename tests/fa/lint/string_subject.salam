// زبان: فارسی
// EXPECT-WARNINGS: 1
// EXPECT-FIXES: 1

تابع pick(s: رشته): صحیح:
    اگر s برابر "red":
        برگشت 1
    پایان
    اگر s برابر "green" یا s برابر "lime":
        برگشت 2
    پایان
    اگر s برابر "blue":
        برگشت 3
    پایان
    اگر s برابر "cyan":
        برگشت 4
    پایان
    برگشت 0
پایان

تابع ریشه:
    سرچاپ pick("lime")
پایان
