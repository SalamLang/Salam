تابع طول(x: صحیح): صحیح:
    برگشت x * 10
پایان

تابع آرگومان‌ها(): صحیح:
    برگشت 5
پایان

تابع ریشه:
    سرچاپ طول(3)، آرگومان‌ها()
پایان
