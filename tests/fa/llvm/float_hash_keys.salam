تابع نگهدار<گ>(مقدار: گ): گ:
    برگشت مقدار
پایان

تابع ریشه:
    ز := نگهدار(0.0)
    نامعدد := ز / ز
    بینهایت := نگهدار(1.0) / ز
    سرچاپ درهم(نگهدار(0.0)) برابر درهم(نگهدار(-0.0))،
        درهم(نامعدد) برابر درهم(-نامعدد)،
        درهم(نامعدد) برابر درهم(بینهایت - بینهایت)
    سرچاپ درهم(نگهدار(1e300)) برابر درهم(نگهدار(1e300))،
        درهم(نگهدار(1e300)) نابرابر درهم(نگهدار(-1e300))
    سرچاپ درهم(نگهدار(0.5 برگردان اعشار۳۲)) برابر درهم(نگهدار(0.5 برگردان اعشار۳۲))،
        درهم(نگهدار(-0.0 برگردان اعشار۳۲)) برابر درهم(نگهدار(0.0 برگردان اعشار۳۲))
    ناپایا م := نگاشت {} برگردان نگاشت<اعشار۶۴، صحیح>
    دیرکن م.آزادسازی()
    م.قراردادن(نگهدار(1e300)، 6)
    م.قراردادن(نگهدار(-1e300)، 7)
    م.قراردادن(نگهدار(1e-300)، 8)
    م.قراردادن(نگهدار(0.0)، 9)
    م.قراردادن(نامعدد، 10)
    سرچاپ م.دارد(نگهدار(1e300))،
        م.دریافت(نگهدار(1e300))،
        م.دارد(نگهدار(-1e300))،
        م.دریافت(نگهدار(-1e300))
    سرچاپ م.دارد(نگهدار(1e-300))،
        م.دریافت(نگهدار(1e-300))،
        م.دریافت(نگهدار(-0.0))،
        م.دارد(نگهدار(-0.0))
    سرچاپ م.دارد(نگهدار(1e299))، م.دارد(نگهدار(2.5))
    م.قراردادن(نگهدار(-0.0)، 11)
    سرچاپ م.دریافت(نگهدار(0.0))
    سرچاپ م.حذف(نگهدار(1e300))، م.حذف(نگهدار(-0.0))، م.حذف(نگهدار(5.0))
    سرچاپ م.دارد(نگهدار(1e300))،
        م.دارد(نگهدار(0.0))،
        م.دریافت(نگهدار(-1e300))،
        م.دریافت(نگهدار(1e-300))
    تکرار 1 تا 200 در ی:
        م.قراردادن((ی برگردان اعشار۶۴) * 1e250، ی)
    پایان
    سرچاپ م.دریافت(نگهدار(1e250))، م.دریافت(نگهدار(100.0) * 1e250)، م.دریافت(نگهدار(-1e300))
    ناپایا نگاشت صحیح := نگاشت {} برگردان نگاشت<اعشار۶۴، صحیح>
    دیرکن نگاشت صحیح.آزادسازی()
    نگاشت صحیح.قراردادن(5، 1)
    ن := نگهدار(7)
    نگاشت صحیح.قراردادن(ن، 3)
    نگاشت صحیح.قراردادن(نگهدار(6.0)، 2)
    سرچاپ نگاشت صحیح.دریافت(نگهدار(5.0))،
        نگاشت صحیح.دارد(نگهدار(5.0))،
        نگاشت صحیح.دریافت(نگهدار(7.0))،
        نگاشت صحیح.دریافت(6)،
        نگاشت صحیح.دارد(6)
    ناپایا نگاشت۳۲ := نگاشت {} برگردان نگاشت<اعشار۳۲، رشته>
    دیرکن نگاشت۳۲.آزادسازی()
    نگاشت۳۲.قراردادن(نگهدار(0.1 برگردان اعشار۳۲)، "a")
    نگاشت۳۲.قراردادن(نگهدار(3.0e38) برگردان اعشار۳۲، "b")
    سرچاپ نگاشت۳۲.دریافت(نگهدار(0.1 برگردان اعشار۳۲))،
        نگاشت۳۲.دریافت(نگهدار(3.0e38) برگردان اعشار۳۲)،
        نگاشت۳۲.دارد(نگهدار(0.2 برگردان اعشار۳۲))
پایان
