پایا نیم := 7.5 % 2.0
پایا منفی := -7.5 % 2.0
پایا بی‌باقی := 6.0 % 3.0

گونه متر: اعشار۶۴
پایان

تابع نگهدار<گ>(مقدار: گ): گ:
    برگشت مقدار
پایان

تابع علامت صفر(عدد: اعشار۶۴): رشته:
    اگر 1.0 / عدد کوچکتر 0.0:
        برگشت "-0"
    پایان
    برگشت "+0"
پایان

تابع ریشه:
    سرچاپ نگهدار(7.5) % نگهدار(2.0)، نگهدار(-7.5) % نگهدار(2.0)، نگهدار(7.5) % نگهدار(-2.0)
    سرچاپ 7.5 % 2.0، نیم، منفی، بی‌باقی، -6.5 % 2.0
    ز := نگهدار(0.0)
    بینهایت := نگهدار(1.0) / ز
    سرچاپ نگهدار(5.0) % 0.0،
        نگهدار(5.0) % ز،
        بینهایت % نگهدار(2.0)،
        نگهدار(5.0) % بینهایت،
        نگهدار(-5.0) % بینهایت
    سرچاپ علامت صفر(نگهدار(-4.0) % نگهدار(2.0))، علامت صفر(نگهدار(4.0) % نگهدار(2.0))
    سرچاپ علامت صفر(نگهدار(-0.0) % نگهدار(3.0))، علامت صفر(-6.0 % 3.0)
    ن := نگهدار(3)
    سرچاپ نگهدار(10.5) % ن،
        نگهدار(10) % نگهدار(4.0)،
        نگهدار(7.5) % نگهدار(2 برگردان صحیح۶۴)،
        نگهدار(7.5) % نگهدار(2 برگردان طبیعی۶۴)
    ف := نگهدار(7.5 برگردان اعشار۳۲)
    سرچاپ ف % نگهدار(2.0 برگردان اعشار۳۲)،
        ف % ن،
        نگهدار(1.0 برگردان اعشار۳۲) % نگهدار(0.25 برگردان اعشار۳۲)
    گ := نگهدار(1.0 برگردان اعشار۳۲)
    سرچاپ گ % نگهدار(0.1 برگردان اعشار۳۲)، نگهدار(1.0) % نگهدار(0.1)، گ % 0.1، گ + 0.1
    ناپایا ه := گ
    ه %= 0.1
    سرچاپ ه
    ناپایا ا := نگهدار(17.25)
    ا %= 5.0
    سرچاپ ا
    ناپایا ب := نگهدار(-17.25 برگردان اعشار۳۲)
    ب %= نگهدار(5.0 برگردان اعشار۳۲)
    سرچاپ ب
    ناپایا ک := نگهدار(9.5)
    ک %= ن
    سرچاپ ک
    ناپایا آرایه := [نگهدار(10.5)، نگهدار(11.5)]
    آرایه[1] %= 4.0
    سرچاپ آرایه[0]، آرایه[1]
    م := نگهدار(7.5) برگردان متر
    د := نگهدار(2.0) برگردان متر
    سرچاپ (م % د) برگردان اعشار۶۴
    ناپایا جمع := 0.0
    تکرار 1 تا 10 در ی:
        جمع += ((ی برگردان اعشار۶۴) * 1.25) % 3.0
    پایان
    سرچاپ جمع
پایان
