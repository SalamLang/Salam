تابع ریشه:
    هر ح در "سلام":
        سرچاپ ح
    پایان
    هر ش، ح در "ab":
        سرچاپ ش، ح
    پایان
    ناپایا شمار := 0
    هر ح در "کتاب‌ها":
        اگر ح == "ا": شمار += 1 پایان
    پایان
    سرچاپ شمار
    هر ب در "Hi".بایت ها():
        سرچاپ ب برگردان صحیح
    پایان
    هر ش، ب در "ok".بایت‌ها():
        سرچاپ ش، ب برگردان صحیح
    پایان
پایان
