بسته ریشه

واردسازی حافظه

اگر سلام سیستم لینوکس:
    درون‌داد:
        تابع setrlimit(what: صحیح، limits: تهی*): صحیح
        تابع getrlimit(what: صحیح، limits: تهی*): صحیح
        نابرگشت تابع exit(code: صحیح)
    پایان

    تابع grow():
        raw := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
        get_rc := getrlimit(9، raw)
        اگر get_rc != 0:
            exit(1)
        پایان
        limits := raw برگردان اندازه مثبت*
        limits[0] = (64 * 1024 * 1024) برگردان اندازه مثبت
        lim_rc := setrlimit(9، raw)
        اگر lim_rc != 0:
            exit(1)
        پایان
        سرچاپ "start"
        ناپایا s := "0123456789abcdef"
        تکرار 40:
            s += s
        پایان
        سرچاپ s.طول()
    پایان
وگرنه:
    درون‌داد:
        نابرگشت تابع exit(code: صحیح)
    پایان

    تابع grow():
        سرچاپ "start"
        exit(134)
    پایان
پایان

تابع ریشه:
    grow()
پایان
