فراخوانی پی "../general/_pkgcoerce.salam"
فراخوانی ران "../general/_pkgcoerce_drv.salam"

ساختار مربع:
    همگانی ضلع: صحیح = ۰
    همگانی تابع مساحت(): صحیح: برگشت این.ضلع + ۱۰۰۰ پایان
پایان

تابع ریشه:
    سرچاپ پی.مساحت‌از(پی.مربع { ضلع = ۳ })
    سرچاپ پی.مساحت‌از(مربع { ضلع = ۱ })
    دارنده := پی.مربع { ضلع = ۷ } برگردان پویا پی.شکل
    سرچاپ پی.مساحت‌از(دارنده)

    سرچاپ پی.نما(۵)
    سرچاپ پی.نما("سلام")
    جعبه := ۸ برگردان (صحیح یا رشته)
    سرچاپ پی.نما(جعبه)

    سرچاپ پی.پیش‌فرض‌متن(۱)
    سرچاپ پی.پیش‌فرض‌متن(۱, ۲)
    سرچاپ پی.پیش‌فرض‌شکل(۱)
    سرچاپ پی.پیش‌فرض‌شکل(۱, پی.مربع { ضلع = ۱ })

    س := پی.سازنده { نشان = ۱۰ }
    سرچاپ س.بگیر(پی.مربع { ضلع = ۳ })
    سرچاپ س.نوشته(۴)
    سرچاپ س.نوشته("ق")

    سرچاپ پی.عام‌شکل(۱, پی.مربع { ضلع = ۳ })
    سرچاپ پی.عام‌مقدار(۱, ۴)
    سرچاپ پی.عام‌مقدار(۱, "ز")

    سرچاپ پی.گزینش(پی.مربع { ضلع = ۳ })
    سرچاپ پی.گزینش(۱, ۲)
    سرچاپ پی.گزینش(۱, "س")

    سرچاپ پی.سازنده.سنجش(پی.مربع { ضلع = ۳ })
    سرچاپ پی.سازنده.برچسب(۴)
    سرچاپ پی.سازنده.برچسب("ر")

    ت := پی.شکلی‌بده()
    سرچاپ ت(پی.مربع { ضلع = ۳ })
    م := پی.مقداری‌بده()
    سرچاپ م(۴)
    سرچاپ م("و")
    ن := پی.نگهدارساز()
    سرچاپ ن.شکلی(پی.مربع { ضلع = ۴ })
    سرچاپ ن.مقداری("ه")

    سرچاپ پی.پهن(۵)

    سرچاپ ران.اجرا(ران.حافظه { عدد = ۱ })
    سرچاپ ران.اجرا(ران.مربع‌ساز(۳))
    سرچاپ ران.اجرای‌پیش‌فرض(۱)
پایان
