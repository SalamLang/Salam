اگر سلام سیستم ویندوز:
    درون‌داد:
        تابع GetModuleHandleA(نام: رشته): تهی*
        تابع GetProcAddress(پیمانه: تهی*، نام: رشته): تهی*
    پایان

    تابع جستجو(نام: رشته): تهی*:
        برگشت GetProcAddress(GetModuleHandleA("kernel32.dll")، نام)
    پایان
وگرنه:
    برون‌داد:
        تابع sfp_muldiv(a: صحیح، b: صحیح، c: صحیح): صحیح:
            برگشت a * b / c
        پایان

        تابع sfp_sleep(زمان: صحیح):
            _ms := زمان
        پایان
    پایان

    تابع جستجو(نام: رشته): تهی*:
        اگر نام برابر "MulDiv":
            برگشت &sfp_muldiv
        پایان
        برگشت &sfp_sleep
    پایان
پایان

تابع کار(n: صحیح، بذر: صحیح، ضرب تقسیم: درون‌داد فراخوان استاندارد تابع (صحیح، صحیح، صحیح) صحیح، خواب: درون‌داد فراخوان استاندارد تابع (صحیح)): صحیح:
    ناپایا a := بذر
    ناپایا b := بذر * 3 + 1
    ناپایا c := بذر * 7 + 2
    تکرار n در i:
        خواب(0)
        a = a + ضرب تقسیم(i، 6، 3)
        b = b ^ (a + i)
        c = c + b % 13
    پایان
    برگشت a + b + c
پایان

تابع ریشه:
    ضرب تقسیم := جستجو("MulDiv") برگردان درون‌داد فراخوان استاندارد تابع (صحیح، صحیح، صحیح) صحیح
    خواب := جستجو("Sleep") برگردان درون‌داد فراخوان‌استاندارد تابع (صحیح)
    ناپایا جمع کل := 0
    ناپایا وارسی := 0
    تکرار 20 در k:
        جمع کل = جمع کل + کار(50، k، ضرب تقسیم، خواب) % 1000
        وارسی = وارسی + ضرب تقسیم(k + 1، 10، 5)
    پایان
    سرچاپ "total"، جمع کل، "check"، وارسی
    برگشت 0
پایان
