تابع بررسی(ن: صحیح): صحیح خطادار:
    اگر ن > ۱:
        پرتاب خطا "خیلی بزرگ: " + ن
    پایان
    برگشت ن
پایان

تابع ریشه:
    تلاش:
        سرچاپ بررسی(۱)
        سرچاپ بررسی(۵)
    گرفتن خطا خ:
        سرچاپ خ.نام نوع() + " " + خ.پیام
    پایان
پایان
