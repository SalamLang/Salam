// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع has(text: رشته، needle: رشته): رشته:
    اگر رشته.اندیس از(text، needle، 0) بزرگتربرابر 0:
        برگشت "yes"
    پایان
    برگشت "no"
پایان

تابع ریشه:
    ctx := ال ال وی ام.زمینه جدید()
    m := ال ال وی ام.ماژول جدید(ctx، "surface")
    b := ال ال وی ام.سازنده جدید(ctx)
    i1 := ال ال وی ام.نوع یک بیتی(ctx)
    i8 := ال ال وی ام.نوع هشت بیتی(ctx)
    i16 := ال ال وی ام.نوع شانزده بیتی(ctx)
    i32 := ال ال وی ام.نوع سی‌ودو بیتی(ctx)
    i64 := ال ال وی ام.نوع شصت‌وچهار بیتی(ctx)
    flt := ال ال وی ام.نوع اعشاری(ctx)
    dbl := ال ال وی ام.نوع اعشاری دقیق(ctx)
    void := ال ال وی ام.نوع تهی(ctx)
    ptr := ال ال وی ام.نوع اشاره‌گر(ctx)

    counter := ال ال وی ام.افزودن سراسری(m، i32، "counter")
    ال ال وی ام.تنظیم مقدار اولیه(counter، ال ال وی ام.ثابت صحیح(i32، 7 برگردان صحیح۶۴))
    ال ال وی ام.تنظیم ثابت سراسری(counter، درست)
    _table := ال ال وی ام.افزودن سراسری(m، ال ال وی ام.نوع آرایه(i8، 4 برگردان صحیح۶۴)، "table")

    ناپایا none := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    دیرکن none.آزادکن()
    bump_ty := ال ال وی ام.نوع تابعی(void، none، نادرست)
    bump := ال ال وی ام.افزودن تابعی(m، "bump"، bump_ty)
    entry := ال ال وی ام.افزودن بلوک(ctx، bump، "entry")
    ال ال وی ام.قرار دادن در انتها(b، entry)
    سرچاپ "insert block is entry:"، ال ال وی ام.بلوک درج(b).دسته برابر entry.دسته
    slot := ال ال وی ام.تخصیص پشته(b، i64، "slot")
    ال ال وی ام.ذخیره(b، ال ال وی ام.ثابت صحیح(i64، 100 برگردان صحیح۶۴)، slot)
    loaded := ال ال وی ام.بارگذاری(b، i64، slot، "loaded")
    quot := ال ال وی ام.تقسیم علامت‌دار(b، loaded، ال ال وی ام.ثابت صحیح(i64، 7 برگردان صحیح۶۴)، "quot")
    ال ال وی ام.ذخیره(b، quot، slot)
    ال ال وی ام.بازگشت تهی(b)

    ناپایا dnone := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    دیرکن dnone.آزادکن()
    half_ty := ال ال وی ام.نوع تابعی(dbl، dnone، نادرست)
    half := ال ال وی ام.افزودن تابعی(m، "half"، half_ty)
    hentry := ال ال وی ام.افزودن بلوک(ctx، half، "entry")
    ال ال وی ام.قرار دادن در انتها(b، hentry)
    ال ال وی ام.بازگشت(b، ال ال وی ام.ثابت اعشاری(dbl، 0.5))

    ناپایا main_params := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    دیرکن main_params.آزادکن()
    main_params.بیفزا(i32)
    main_params.بیفزا(ptr)
    main_ty := ال ال وی ام.نوع تابعی(i32، main_params، نادرست)
    main_fn := ال ال وی ام.افزودن تابعی(m، "main"، main_ty)
    mentry := ال ال وی ام.افزودن بلوک(ctx، main_fn، "entry")
    ال ال وی ام.قرار دادن در انتها(b، mentry)
    ال ال وی ام.بازگشت(b، ال ال وی ام.پارامتر(main_fn، 0))

    سرچاپ "named bump found:"، ال ال وی ام.تابع نام‌دار(m، "bump").دسته نابرابر پوچ
    سرچاپ "named nope found:"، ال ال وی ام.تابع نام‌دار(m، "nope").دسته نابرابر پوچ
    سرچاپ "unused types:"، i1.دسته نابرابر پوچ، i16.دسته نابرابر پوچ، flt.دسته نابرابر پوچ

    v := ال ال وی ام.بررسی(m)
    سرچاپ "verify:"، v.معتبر
    text := ال ال وی ام.ماژول به رشته(m)
    سرچاپ "global constant:"، has(text، "constant i32 7")
    سرچاپ "array global:"، has(text، "[4 x i8]")
    سرچاپ "alloca:"، has(text، "alloca i64")
    سرچاپ "sdiv:"، has(text، "sdiv i64")
    سرچاپ "double ret:"، has(text، "ret double 5.000000e-01")

    ال ال وی ام.مقداردهی اهداف()
    ال ال وی ام.مقداردهی اهداف()
    ال ال وی ام.تنظیم سه‌تایی هدف(m، "x86_64-unknown-linux-gnu")
    سرچاپ "triple:"، ال ال وی ام.سه‌تایی هدف(m)
    سرچاپ "default triple set:"، ال ال وی ام.سه‌تایی پیش‌فرض().طول() بزرگتر 0

    سرچاپ "levels:"، ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی صفر)، ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی یک)، ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی دو)، ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی سه)
    سرچاپ "pipelines:"، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی صفر).طول()، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی یک)، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی دو)، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی سه)

    tmr := ال ال وی ام.ماشین هدف جدید(""، ال ال وی ام.بهینه‌سازی دو، نادرست)
    اگر وارونه tmr.موفق:
        سرچاپ "no target machine: " + tmr.خطا
        برگشت
    پایان
    ال ال وی ام.تنظیم سه‌تایی هدف(m، ال ال وی ام.سه‌تایی پیش‌فرض())
    ال ال وی ام.اعمال آرایش داده(m، tmr.ماشین هدف)
    سرچاپ "datalayout applied:"، has(ال ال وی ام.ماژول به رشته(m)، "target datalayout")

    سرچاپ "jobs ok:"، ال ال وی ام.کارهای موازی() بزرگتربرابر 1
    سرچاپ "partitions ok:"، ال ال وی ام.بخش‌های موازی(m، 2) بزرگتربرابر 1

    tmp := سیستم عامل.پوشه موقت()
    prefix := tmp + "/salam_llvmapi_surface_par"
    pr := ال ال وی ام.بهینه‌سازی سپس تولید موازی(m، tmr.ماشین هدف، ال ال وی ام.بهینه‌سازی یک، 2، prefix)
    سرچاپ "parallel emit:"، pr.موفق، pr.پرونده‌های شیء.طول()
    هر o در pr.پرونده‌های شیء:
        اگر سیستم عامل.وجود دارد(o):
            سیستم عامل.حذف(o)
        پایان
    پایان

    bc_path := tmp + "/salam_llvmapi_surface.bc"
    br := ال ال وی ام.تولید بیت‌کد(m، bc_path)
    سرچاپ "bitcode:"، br.موفق، سیستم عامل.وجود دارد(bc_path)
    سیستم عامل.حذف(bc_path)

    ll_path := tmp + "/salam_llvmapi_surface.ll"
    ورودی خروجی.نوشتن پرونده(ll_path، text)
    parsed := ال ال وی ام.تجزیه آی آر(ll_path)
    سرچاپ "parse:"، parsed.موفق
    اگر parsed.موفق:
        سرچاپ "parsed main:"، ال ال وی ام.تابع نام‌دار(parsed.ماژول، "main").دسته نابرابر پوچ
        ال ال وی ام.آزادسازی ماژول(parsed.ماژول)
        ال ال وی ام.آزادسازی زمینه(parsed.زمینه)
    پایان
    bad := ال ال وی ام.تجزیه آی آر(tmp + "/salam_llvmapi_surface_missing.ll")
    سرچاپ "parse missing:"، bad.موفق

    ناپایا jit_args := وکتور {} برگردان وکتور<رشته>
    دیرکن jit_args.آزادکن()
    jit_args.بیفزا("prog")
    jit_args.بیفزا("one")
    jit_args.بیفزا("two")
    jr := ال ال وی ام.اجرای جیت با آرگومان(ll_path، jit_args)
    سرچاپ "jit args:"، jr.موفق، jr.مقدار برگشتی
    سیستم عامل.حذف(ll_path)

    obj_path := tmp + "/salam_llvmapi_surface.o"
    exe_path := tmp + "/salam_llvmapi_surface.exe"
    er := ال ال وی ام.تولید شیء(m، tmr.ماشین هدف، obj_path)
    سرچاپ "object:"، er.موفق
    opts := ال ال وی ام.تنظیمات پیش‌فرض()
    سرچاپ "options default:"، opts.سطح بهینه‌سازی، opts.سه‌تایی هدف.طول()، opts.ریشه سیستم.طول()
    lr := ال ال وی ام.پیوند خارجی(obj_path، exe_path، opts)
    سرچاپ "link external:"، lr.موفق
    سیستم عامل.حذف(obj_path)
    سیستم عامل.حذف(exe_path)

    ناپایا wasi := ال ال وی ام.تنظیمات پیش‌فرض()
    wasi.سه‌تایی هدف = "wasm32-unknown-wasi"
    سرچاپ "link wasi without sysroot:"، ال ال وی ام.پیوند وازی("missing.o"، "out.wasm"، wasi).موفق
    ناپایا elf := ال ال وی ام.تنظیمات پیش‌فرض()
    elf.سه‌تایی هدف = "x86_64-unknown-linux-musl"
    elf.ریشه سیستم = "no-such-sysroot"
    سرچاپ "link elf without sysroot:"، ال ال وی ام.پیوند ای ال اف("missing.o"، "out"، elf).موفق
    ناپایا mingw := ال ال وی ام.تنظیمات پیش‌فرض()
    mingw.سه‌تایی هدف = "x86_64-unknown-linux-gnu"
    سرچاپ "link mingw wrong triple:"، ال ال وی ام.پیوند مینگو("missing.o"، "out.exe"، mingw).موفق
    سرچاپ "auto no triple:"، ال ال وی ام.پیوند خودکار("missing.o"، "out"، ال ال وی ام.تنظیمات پیش‌فرض()).موفق
    ناپایا mac := ال ال وی ام.تنظیمات پیش‌فرض()
    mac.سه‌تایی هدف = "x86_64-apple-darwin"
    سرچاپ "auto darwin:"، ال ال وی ام.پیوند خودکار("missing.o"، "out"، mac).موفق
    ناپایا auto_elf := ال ال وی ام.تنظیمات پیش‌فرض()
    auto_elf.سه‌تایی هدف = "aarch64-unknown-linux-musl"
    auto_elf.ریشه سیستم = "no-such-sysroot"
    سرچاپ "auto musl:"، ال ال وی ام.پیوند خودکار("missing.o"، "out"، auto_elf).موفق

    سرچاپ "can link empty:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("")
    سرچاپ "can link darwin:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-apple-darwin")
    سرچاپ "can link glibc:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-unknown-linux-gnu")
    سرچاپ "can link mingw:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-w64-mingw32") برابر ال ال وی ام.ال ال دی در دسترس()
    سرچاپ "can link musl:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-unknown-linux-musl") برابر ال ال وی ام.ال ال دی در دسترس()
    host := ال ال وی ام.سه‌تایی پیوند میزبان()
    سرچاپ "host link triple sane:"، host.طول() برابر 0 یا has(host، "linux") برابر "yes" یا has(host، "mingw") برابر "yes"

    ال ال وی ام.آزادسازی ماشین هدف(tmr.ماشین هدف)
    ال ال وی ام.آزادسازی سازنده(b)
    ال ال وی ام.آزادسازی ماژول(m)
    ال ال وی ام.آزادسازی زمینه(ctx)
پایان
