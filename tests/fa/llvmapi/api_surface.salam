// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع شامل(متن: رشته، عبارت: رشته): رشته:
    اگر رشته.اندیس از(متن، عبارت، 0) بزرگتربرابر 0:
        برگشت "yes"
    پایان
    برگشت "no"
پایان

تابع ریشه:
    زمینه := ال ال وی ام.زمینه جدید()
    m := ال ال وی ام.ماژول جدید(زمینه، "surface")
    b := ال ال وی ام.سازنده جدید(زمینه)
    یک بیتی := ال ال وی ام.نوع یک بیتی(زمینه)
    هشت بیتی := ال ال وی ام.نوع هشت بیتی(زمینه)
    شانزده بیتی := ال ال وی ام.نوع شانزده بیتی(زمینه)
    سی‌ودو بیتی := ال ال وی ام.نوع سی‌ودو بیتی(زمینه)
    شصت‌وچهار بیتی := ال ال وی ام.نوع شصت‌وچهار بیتی(زمینه)
    اعشاری := ال ال وی ام.نوع اعشاری(زمینه)
    اعشاری دقیق := ال ال وی ام.نوع اعشاری دقیق(زمینه)
    نوع خالی := ال ال وی ام.نوع تهی(زمینه)
    اشاره‌گر := ال ال وی ام.نوع اشاره‌گر(زمینه)

    شمارنده := ال ال وی ام.افزودن سراسری(m، سی‌ودو بیتی، "counter")
    ال ال وی ام.تنظیم مقدار اولیه(شمارنده، ال ال وی ام.ثابت صحیح(سی‌ودو بیتی، 7 برگردان صحیح۶۴))
    ال ال وی ام.تنظیم ثابت سراسری(شمارنده، درست)
    _table := ال ال وی ام.افزودن سراسری(m، ال ال وی ام.نوع آرایه(هشت بیتی، 4 برگردان صحیح۶۴)، "table")

    ناپایا فهرست خالی := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    دیرکن فهرست خالی.آزادکن()
    نوع افزایش := ال ال وی ام.نوع تابعی(نوع خالی، فهرست خالی، نادرست)
    افزایش := ال ال وی ام.افزودن تابعی(m، "bump"، نوع افزایش)
    بلوک آغاز := ال ال وی ام.افزودن بلوک(زمینه، افزایش، "entry")
    ال ال وی ام.قرار دادن در انتها(b، بلوک آغاز)
    سرچاپ "insert block is entry:"، ال ال وی ام.بلوک درج(b).دسته برابر بلوک آغاز.دسته
    جایگاه := ال ال وی ام.تخصیص پشته(b، شصت‌وچهار بیتی، "slot")
    ال ال وی ام.ذخیره(b، ال ال وی ام.ثابت صحیح(شصت‌وچهار بیتی، 100 برگردان صحیح۶۴)، جایگاه)
    بارشده := ال ال وی ام.بارگذاری(b، شصت‌وچهار بیتی، جایگاه، "loaded")
    خارج قسمت := ال ال وی ام.تقسیم علامت‌دار(b، بارشده، ال ال وی ام.ثابت صحیح(شصت‌وچهار بیتی، 7 برگردان صحیح۶۴)، "quot")
    ال ال وی ام.ذخیره(b، خارج قسمت، جایگاه)
    ال ال وی ام.بازگشت تهی(b)

    ناپایا فهرست خالی دو := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    دیرکن فهرست خالی دو.آزادکن()
    نوع نیم := ال ال وی ام.نوع تابعی(اعشاری دقیق، فهرست خالی دو، نادرست)
    نیم := ال ال وی ام.افزودن تابعی(m، "half"، نوع نیم)
    بلوک آغاز نیم := ال ال وی ام.افزودن بلوک(زمینه، نیم، "entry")
    ال ال وی ام.قرار دادن در انتها(b، بلوک آغاز نیم)
    ال ال وی ام.بازگشت(b، ال ال وی ام.ثابت اعشاری(اعشاری دقیق، 0.5))

    ناپایا پارامترهای نقطه ورود := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    دیرکن پارامترهای نقطه ورود.آزادکن()
    پارامترهای نقطه ورود.بیفزا(سی‌ودو بیتی)
    پارامترهای نقطه ورود.بیفزا(اشاره‌گر)
    نوع نقطه ورود := ال ال وی ام.نوع تابعی(سی‌ودو بیتی، پارامترهای نقطه ورود، نادرست)
    نقطه ورود := ال ال وی ام.افزودن تابعی(m، "main"، نوع نقطه ورود)
    بلوک آغاز نقطه ورود := ال ال وی ام.افزودن بلوک(زمینه، نقطه ورود، "entry")
    ال ال وی ام.قرار دادن در انتها(b، بلوک آغاز نقطه ورود)
    ال ال وی ام.بازگشت(b، ال ال وی ام.پارامتر(نقطه ورود، 0))

    سرچاپ "named bump found:"، ال ال وی ام.تابع نام‌دار(m، "bump").دسته نابرابر پوچ
    سرچاپ "named nope found:"، ال ال وی ام.تابع نام‌دار(m، "nope").دسته نابرابر پوچ
    سرچاپ "unused types:"، یک بیتی.دسته نابرابر پوچ، شانزده بیتی.دسته نابرابر پوچ، اعشاری.دسته نابرابر پوچ

    v := ال ال وی ام.بررسی(m)
    سرچاپ "verify:"، v.معتبر
    متن := ال ال وی ام.ماژول به رشته(m)
    سرچاپ "global constant:"، شامل(متن، "constant i32 7")
    سرچاپ "array global:"، شامل(متن، "[4 x i8]")
    سرچاپ "alloca:"، شامل(متن، "alloca i64")
    سرچاپ "sdiv:"، شامل(متن، "sdiv i64")
    سرچاپ "double ret:"، شامل(متن، "ret double 5.000000e-01")

    ال ال وی ام.مقداردهی اهداف()
    ال ال وی ام.مقداردهی اهداف()
    ال ال وی ام.تنظیم سه‌تایی هدف(m، "x86_64-unknown-linux-gnu")
    سرچاپ "triple:"، ال ال وی ام.سه‌تایی هدف(m)
    سرچاپ "default triple set:"، ال ال وی ام.سه‌تایی پیش‌فرض().طول() بزرگتر 0

    سرچاپ "levels:"، ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی صفر)، ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی یک)، ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی دو)، ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی سه)
    سرچاپ "pipelines:"، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی صفر).طول()، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی یک)، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی دو)، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی سه)

    ماشین := ال ال وی ام.ماشین هدف جدید(""، ال ال وی ام.بهینه‌سازی دو، نادرست)
    اگر وارونه ماشین.موفق:
        سرچاپ "no target machine: " + ماشین.خطا
        برگشت
    پایان
    ال ال وی ام.تنظیم سه‌تایی هدف(m، ال ال وی ام.سه‌تایی پیش‌فرض())
    ال ال وی ام.اعمال آرایش داده(m، ماشین.ماشین هدف)
    سرچاپ "datalayout applied:"، شامل(ال ال وی ام.ماژول به رشته(m)، "target datalayout")

    سرچاپ "jobs ok:"، ال ال وی ام.کارهای موازی() بزرگتربرابر 1
    سرچاپ "partitions ok:"، ال ال وی ام.بخش‌های موازی(m، 2) بزرگتربرابر 1

    مسیر موقت := سیستم عامل.پوشه موقت()
    پیشوند := مسیر موقت + "/salam_llvmapi_surface_par"
    نتیجه موازی := ال ال وی ام.بهینه‌سازی سپس تولید موازی(m، ماشین.ماشین هدف، ال ال وی ام.بهینه‌سازی یک، 2، پیشوند)
    سرچاپ "parallel emit:"، نتیجه موازی.موفق، نتیجه موازی.پرونده‌های شیء.طول()
    هر o در نتیجه موازی.پرونده‌های شیء:
        اگر سیستم عامل.وجود دارد(o):
            سیستم عامل.حذف(o)
        پایان
    پایان

    مسیر بیت‌کد := مسیر موقت + "/salam_llvmapi_surface.bc"
    نتیجه بیت‌کد := ال ال وی ام.تولید بیت‌کد(m، مسیر بیت‌کد)
    سرچاپ "bitcode:"، نتیجه بیت‌کد.موفق، سیستم عامل.وجود دارد(مسیر بیت‌کد)
    سیستم عامل.حذف(مسیر بیت‌کد)

    مسیر آی آر := مسیر موقت + "/salam_llvmapi_surface.ll"
    ورودی خروجی.نوشتن پرونده(مسیر آی آر، متن)
    تجزیه شده := ال ال وی ام.تجزیه آی آر(مسیر آی آر)
    سرچاپ "parse:"، تجزیه شده.موفق
    اگر تجزیه شده.موفق:
        سرچاپ "parsed main:"، ال ال وی ام.تابع نام‌دار(تجزیه شده.ماژول، "main").دسته نابرابر پوچ
        ال ال وی ام.آزادسازی ماژول(تجزیه شده.ماژول)
        ال ال وی ام.آزادسازی زمینه(تجزیه شده.زمینه)
    پایان
    نتیجه خراب := ال ال وی ام.تجزیه آی آر(مسیر موقت + "/salam_llvmapi_surface_missing.ll")
    سرچاپ "parse missing:"، نتیجه خراب.موفق

    ناپایا آرگومان‌های جیت := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگومان‌های جیت.آزادکن()
    آرگومان‌های جیت.بیفزا("prog")
    آرگومان‌های جیت.بیفزا("one")
    آرگومان‌های جیت.بیفزا("two")
    نتیجه جیت := ال ال وی ام.اجرای جیت با آرگومان(مسیر آی آر، آرگومان‌های جیت)
    سرچاپ "jit args:"، نتیجه جیت.موفق، نتیجه جیت.مقدار برگشتی
    سیستم عامل.حذف(مسیر آی آر)

    مسیر شیء := مسیر موقت + "/salam_llvmapi_surface.o"
    مسیر اجرایی := مسیر موقت + "/salam_llvmapi_surface.exe"
    نتیجه شیء := ال ال وی ام.تولید شیء(m، ماشین.ماشین هدف، مسیر شیء)
    سرچاپ "object:"، نتیجه شیء.موفق
    تنظیمات := ال ال وی ام.تنظیمات پیش‌فرض()
    سرچاپ "options default:"، تنظیمات.سطح بهینه‌سازی، تنظیمات.سه‌تایی هدف.طول()، تنظیمات.ریشه سیستم.طول()
    نتیجه پیوند := ال ال وی ام.پیوند خارجی(مسیر شیء، مسیر اجرایی، تنظیمات)
    سرچاپ "link external:"، نتیجه پیوند.موفق
    سیستم عامل.حذف(مسیر شیء)
    سیستم عامل.حذف(مسیر اجرایی)

    ناپایا تنظیمات وازی := ال ال وی ام.تنظیمات پیش‌فرض()
    تنظیمات وازی.سه‌تایی هدف = "wasm32-unknown-wasi"
    سرچاپ "link wasi without sysroot:"، ال ال وی ام.پیوند وازی("missing.o"، "out.wasm"، تنظیمات وازی).موفق
    ناپایا تنظیمات ای ال اف := ال ال وی ام.تنظیمات پیش‌فرض()
    تنظیمات ای ال اف.سه‌تایی هدف = "x86_64-unknown-linux-musl"
    تنظیمات ای ال اف.ریشه سیستم = "no-such-sysroot"
    سرچاپ "link elf without sysroot:"، ال ال وی ام.پیوند ای ال اف("missing.o"، "out"، تنظیمات ای ال اف).موفق
    ناپایا تنظیمات مینگو := ال ال وی ام.تنظیمات پیش‌فرض()
    تنظیمات مینگو.سه‌تایی هدف = "x86_64-unknown-linux-gnu"
    سرچاپ "link mingw wrong triple:"، ال ال وی ام.پیوند مینگو("missing.o"، "out.exe"، تنظیمات مینگو).موفق
    سرچاپ "auto no triple:"، ال ال وی ام.پیوند خودکار("missing.o"، "out"، ال ال وی ام.تنظیمات پیش‌فرض()).موفق
    ناپایا تنظیمات مک := ال ال وی ام.تنظیمات پیش‌فرض()
    تنظیمات مک.سه‌تایی هدف = "x86_64-apple-darwin"
    سرچاپ "auto darwin:"، ال ال وی ام.پیوند خودکار("missing.o"، "out"، تنظیمات مک).موفق
    ناپایا تنظیمات خودکار := ال ال وی ام.تنظیمات پیش‌فرض()
    تنظیمات خودکار.سه‌تایی هدف = "aarch64-unknown-linux-musl"
    تنظیمات خودکار.ریشه سیستم = "no-such-sysroot"
    سرچاپ "auto musl:"، ال ال وی ام.پیوند خودکار("missing.o"، "out"، تنظیمات خودکار).موفق

    سرچاپ "can link empty:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("")
    سرچاپ "can link darwin:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-apple-darwin")
    سرچاپ "can link glibc:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-unknown-linux-gnu")
    سرچاپ "can link mingw:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-w64-mingw32") برابر ال ال وی ام.ال ال دی در دسترس()
    سرچاپ "can link musl:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-unknown-linux-musl") برابر ال ال وی ام.ال ال دی در دسترس()
    میزبان := ال ال وی ام.سه‌تایی پیوند میزبان()
    سرچاپ "host link triple sane:"، میزبان.طول() برابر 0 یا شامل(میزبان، "linux") برابر "yes" یا شامل(میزبان، "mingw") برابر "yes"

    ال ال وی ام.آزادسازی ماشین هدف(ماشین.ماشین هدف)
    ال ال وی ام.آزادسازی سازنده(b)
    ال ال وی ام.آزادسازی ماژول(m)
    ال ال وی ام.آزادسازی زمینه(زمینه)
پایان
