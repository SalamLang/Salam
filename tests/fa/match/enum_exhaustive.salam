جداشمار رنگ:
    قرمز،
    سبز،
    آبی
پایان

تابع نام رنگ(c: رنگ): رشته:
    برگشت همخوان c:
        قرمز: "warm" پایان
        سبز، آبی: "cool" پایان
    پایان
پایان

تابع ریشه:
    سرچاپ نام رنگ(رنگ.قرمز)
    سرچاپ نام رنگ(رنگ.سبز)
    سرچاپ نام رنگ(رنگ.آبی)
پایان
