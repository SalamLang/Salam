جداشمار Color:
    red،
    green،
    blue
پایان

روال name_of(c: Color): رشته:
    برگشت همخوان c:
        red => "warm"
        green، blue => "cool"
    پایان
پایان

روال ریشه:
    سرچاپ name_of(Color.red)
    سرچاپ name_of(Color.green)
    سرچاپ name_of(Color.blue)
پایان
