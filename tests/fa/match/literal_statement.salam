روال ریشه:
    تکرار 4 از n:
        همخوان n:
            0: سرچاپ "zero" پایان
            1، 2:
                سرچاپ "one or two"
            پایان
            وگرنه:
                سرچاپ "other"
            پایان
        پایان
    پایان
پایان
