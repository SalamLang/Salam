جداشمار وضعیت:
    منتظر، حال بسته‌بندی، ارسال‌شده
پایان

جداشمار شکل:
    دایره‌ی واحد،
    مربع بزرگ(ضلع: صحیح)
پایان

تابع برچسب(و۱: وضعیت): رشته:
    برگشت همخوان و۱:
        منتظر: "م" پایان
        وضعیت.حال بسته‌بندی: "ب" پایان
        ارسال‌شده: "ا" پایان
    پایان
پایان

تابع مساحت(ش: شکل): صحیح:
    همخوان ش:
        دایره‌ی واحد:
            برگشت ۱
        پایان
        مربع بزرگ(ن):
            برگشت ن * ن
        پایان
    پایان
    برگشت ۰
پایان

تابع ترابری(و۱: وضعیت): رشته:
    ترابرد و۱:
        وضعیت.حال بسته‌بندی:
            برگشت "س"
        پایان
        وگرنه:
            برگشت "-"
        پایان
    پایان
پایان

تابع ریشه:
    سرچاپ برچسب(وضعیت.منتظر)، برچسب(وضعیت.حال بسته‌بندی)، برچسب(وضعیت.ارسال‌شده)
    سرچاپ مساحت(شکل.دایره‌ی واحد)، مساحت(شکل.مربع بزرگ(۳))
    سرچاپ ترابری(وضعیت.حال بسته‌بندی)
    سرچاپ شکل.مربع بزرگ(۲)، شکل.مربع بزرگ(۲) == شکل.مربع بزرگ(۲)
پایان
