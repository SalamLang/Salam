تابع ریشه:
    تکرار 4 در n:
        همخوان n:
            0: سرچاپ "zero" پایان
            وگرنه:
                اگر n برابر 2:
                    بشکن
                پایان
                سرچاپ "other"، n
            پایان
        پایان
    پایان
    سرچاپ "done"
پایان
