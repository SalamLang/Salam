تابع کجا(نقطه: (صحیح، صحیح)): رشته:
    برگشت همخوان نقطه:
        (۰، ۰): "مبدأ" پایان
        (۰، وای): "روی محور وای " + وای پایان
        (ایکس، ۰): "روی محور ایکس " + ایکس پایان
        (ایکس، وای) اگر ایکس == وای: "قطر " + ایکس پایان
        وگرنه: "جای دیگر" پایان
    پایان
پایان

تابع ریشه:
    سرچاپ کجا((۰، ۰))
    سرچاپ کجا((۰، ۵))
    سرچاپ کجا((۷، ۰))
    سرچاپ کجا((۳، ۳))
    سرچاپ کجا((۱، ۲))
    همخوان (۱، "ب"):
        (۱، _):
            سرچاپ "یک"
        پایان
        وگرنه:
            سرچاپ "دیگر"
        پایان
    پایان
پایان
