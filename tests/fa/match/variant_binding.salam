روال describe(v: گوناگون<صحیح۳۲، اعشار۶۴، رشته>): رشته:
    برگشت همخوان v:
        صحیح۳۲ n => "int " + n
        اعشار۶۴ f => "float " + f
        رشته s => "text " + s
    پایان
پایان

روال ریشه:
    ناپایا sample := 21 برگردان گوناگون<صحیح۳۲، اعشار۶۴، رشته>
    سرچاپ describe(sample)
    sample = 21.5
    سرچاپ describe(sample)
    sample = "offline"
    سرچاپ describe(sample)
پایان
