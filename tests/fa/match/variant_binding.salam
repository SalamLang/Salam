تابع توصیف(v: صحیح۳۲ یا اعشار۶۴ یا رشته): رشته:
    برگشت همخوان v:
        صحیح۳۲ n: "int " + n پایان
        اعشار۶۴ f: "float " + f پایان
        رشته s: "text " + s پایان
    پایان
پایان

تابع ریشه:
    ناپایا نمونه := 21 برگردان (صحیح۳۲ یا اعشار۶۴ یا رشته)
    سرچاپ توصیف(نمونه)
    نمونه = 21.5
    سرچاپ توصیف(نمونه)
    نمونه = "offline"
    سرچاپ توصیف(نمونه)
پایان
