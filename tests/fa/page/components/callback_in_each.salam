// انتظار: pick-
// انتظار نه: E012
ناپایا انتخاب := ""

بخش ردیف(انتخابگر: تابع (رشته)، کد: رشته):
    دکمه:
        شناسه = "pick-" + کد
        محتوا = کد
        کلیک = ():
            انتخابگر(کد)
        پایان
    پایان
پایان

بخش ردیف‌ها:
    کدها := وکتور {} برگردان وکتور<رشته>
    جعبه:
        دکمه:
            کلیک = (): کدها.افزودن("a") کدها.افزودن("b") پایان
            محتوا = "add"
        پایان
        هر کد در کدها:
            ردیف:
                کد = کد
                انتخابگر = (ج: رشته):
                    انتخاب = ج
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    پاراگراف:
        محتوا = انتخاب
    پایان
    ردیف‌ها: پایان
پایان
