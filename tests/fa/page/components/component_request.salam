// انتظار: salamWsAt(1,${salamWsCur(1)});
// انتظار نه: E133
واردسازی دام
واردسازی وب.مرورگر

ناپایا معرف := مرورگر.پارامتر نشانی("ref")

بخش ردیف(نام: رشته):
    ناپایا پاسخ := "idle"
    مورد:
        دکمه:
            شناسه = "send-" + نام
            محتوا = نام + " " + پاسخ
            کلیک = ():
                مرورگر.ارسال جیسون(
                    "/echo"، "{}"، ۵۰۰۰، (وضعیت: صحیح، متن: رشته):
                    پاسخ = وضعیت + " " + متن
                    پایان
                )
            پایان
        پایان
        دکمه:
            شناسه = "later-" + نام
            محتوا = "later " + پاسخ
            کلیک = ():
                دام.تنظیم مهلت((): پاسخ = "late " + نام پایان، ۱۰۰)
            پایان
        پایان
        دکمه:
            محتوا = "copy"
            کلیک = (): مرورگر.کپی متن(نام، (انجام: منطقی): پاسخ = "copied " + انجام پایان) پایان
        پایان
    پایان
پایان

بخش ردیف ها:
    موارد := وکتور {} برگردان وکتور<رشته>
    بعدی := ۰
    جعبه:
        دکمه:
            شناسه = "add"
            کلیک = (): موارد.بیفزا("r" + بعدی) بعدی++ پایان
            محتوا = "Add " + معرف
        پایان
        فهرست:
            هر _، م در موارد:
                ردیف:
                    کلید = "row-" + م
                    نام = م
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "Requests"
    ردیف ها: پایان
پایان
