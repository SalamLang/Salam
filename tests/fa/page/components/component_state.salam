بخش شمارنده(نام: رشته، آغاز: صحیح):
    شمار := آغاز
    برچسب := "clicks"
    جعبه:
        دکمه: شناسه = نام کلیک = (): شمار++ پایان محتوا = نام + " " + شمار + " " + برچسب پایان
    پایان
پایان

صفحه:
    عنوان = "State"
    سرتیتر: محتوا = "Counters" پایان
    شمارنده: نام = "a" آغاز = ۰ پایان
    شمارنده: نام = "b" آغاز = ۱۰ پایان
پایان
