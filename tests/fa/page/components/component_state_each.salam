// انتظار: <!--salam:0--><!--/salam:0-->
// انتظار: salamWsSlot(1, `row-${
// انتظار: if (salamWsFresh()) {
// انتظار: salamWsAt(1,${salamWsCur(1)});
// انتظار: let __salam_ws_2 = [];
// انتظار: salamWsTouch(0);
// انتظار: var __salam_views = [__salam_view_0, null];
// انتظار: var __salam_inits = [__salam_init_0, null];
// انتظار نه: E133
بخش ردیف(نام: رشته):
    ضربه := ۰
    مورد: شناسه = "row-" + نام کلیک = (): ضربه++ پایان محتوا = نام + " " + ضربه پایان
پایان

بخش ردیف ها:
    موارد := وکتور {} برگردان وکتور<رشته>
    بعدی := ۰
    جعبه:
        دکمه: شناسه = "add" کلیک = (): موارد.بیفزا("r" + بعدی) بعدی++ پایان محتوا = "Add" پایان
        دکمه: شناسه = "rot" کلیک = (): موارد.درج(۰، موارد.دربیاور()) پایان محتوا = "Rotate" پایان
        فهرست:
            هر م در موارد:
                ردیف: نام = م پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "Rows"
    ردیف ها: پایان
پایان
