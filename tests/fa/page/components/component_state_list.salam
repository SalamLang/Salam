// انتظار: var __salam_inits = [__salam_init_0, __salam_init_1, __salam_init_2, __salam_init_3];
// انتظار نه: E133
بخش تاشو(برچسب: رشته):
    وضعیت باز := نادرست
    جعبه:
        دکمه: شناسه = برچسب + "-btn" کلیک = (): باز = وارونه باز پایان محتوا = برچسب پایان
        اگر باز:
            پاراگراف: شناسه = برچسب + "-body" محتوا = "Body of " + برچسب پایان
        پایان
    پایان
پایان

بخش کارها:
    وضعیت موارد := وکتور {} برگردان وکتور<رشته>
    وضعیت بعدی شماره := ۰
    جعبه:
        ورودی: شناسه = "todo-text" نوع = "text" پایان
        دکمه: شناسه = "todo-add" کلیک = (): موارد.بیفزا("t" + بعدی شماره) بعدی شماره++ پایان محتوا = "Add" پایان
        دکمه: شناسه = "todo-rot" کلیک = (): موارد.درج(۰، موارد.دربیاور()) پایان محتوا = "Rotate" پایان
        فهرست:
            شناسه = "todo-list"
            هر م در موارد:
                مورد: کلید = م محتوا = م پایان
            پایان
        پایان
    پایان
پایان

بخش درونی(نام: رشته):
    وضعیت ن := ۰
    دکمه: شناسه = نام کلیک = (): ن++ پایان محتوا = نام + " " + ن پایان
پایان

بخش بیرونی:
    وضعیت نمایان := درست
    وضعیت م := ۰
    جعبه:
        دکمه: شناسه = "outer-toggle" کلیک = (): نمایان = وارونه نمایان پایان محتوا = "toggle" پایان
        دکمه: شناسه = "outer-bump" کلیک = (): م++ پایان محتوا = "outer " + م پایان
        اگر نمایان:
            درونی: نام = "inner" پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "Rich"
    تاشو: برچسب = "A" پایان
    کارها: پایان
    بیرونی: پایان
پایان
