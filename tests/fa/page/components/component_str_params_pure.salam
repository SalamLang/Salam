بخش مدخل(مسیر: رشته، برچسب: رشته):
    پیوند:
        نشانی = "/" + مسیر
        محتوا = برچسب
    پایان
پایان

صفحه:
    مدخل:
        مسیر = "docs"
        برچسب = "Read the guide"
    پایان
پایان
