ناپایا open := نادرست

بخش Tag(shade: رشته):
    جعبه:
        اگر صفحه.تیره:
            پس‌زمینه = shade
        پایان
    پایان
پایان

بخش Card(title: رشته):
    جعبه:
        فاصله = 16
        اگر صفحه.فشرده:
            فاصله = 4
        پایان
        اگر صفحه.تیره:
            پس‌زمینه = "black"
            رنگ = "white"
        پایان
        پاراگراف:
            محتوا = title
        پایان
    پایان
پایان

صفحه:
    ناوبری:
        چیدمان = "ردیف"
        اگر صفحه.فشرده:
            چیدمان = "ستون"
        پایان
        اگر صفحه.فشرده و open:
            شکاف = 2
        پایان
        دکمه:
            کلیک = (): open = وارونه open پایان
            محتوا = "menu"
        پایان
    پایان
    جعبه:
        شناسه = "w"
        اگر صفحه.عریض:
            عرض = 300
        پایان
    پایان
    Card:
        title = "One"
    پایان
    Card:
        title = "Two"
    پایان
    Tag:
        shade = "red"
    پایان
    جعبه:
        فاصله = 16
        محتوا = "plain"
    پایان
    جعبه:
        کلاس = "card"
        فاصله = 8
        اگر صفحه.فشرده:
            فاصله = 2
        پایان
    پایان
    جعبه:
        کلاس = "card"
        فاصله = 8
        اگر صفحه.تیره:
            فاصله = 9
        پایان
    پایان
    سراسری:
        گزینشگر = "a:is(.x, .y)"
        اگر صفحه.تیره:
            اشاره رنگ = "blue"
        پایان
    پایان
    سراسری:
        گزینشگر = "p, span"
        اگر صفحه.تیره:
            اشاره رنگ = "red"
        پایان
    پایان
    جعبه:
        کلاس = "frame"
        فاصله = 1
        اگر صفحه.فشرده:
            فاصله = 0
        پایان
        رسانه:
            شرط = "print"
            اگر صفحه.تیره:
                رنگ = "gray"
            پایان
        پایان
    پایان
پایان
