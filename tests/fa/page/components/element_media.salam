// انتظار: salamWsStyle(1, 0, `${envx_compact && open ? "2" : ""}`)
ناپایا open := نادرست

بخش Tag(shade: رشته):
    جعبه:
        اگر صفحه.تیره:
            پس‌زمینه = shade
        پایان
    پایان
پایان

بخش Card(title: رشته):
    جعبه:
        فاصله = 16
        اگر صفحه.فشرده:
            فاصله = 4
        پایان
        اگر صفحه.تیره:
            پس‌زمینه = "black"
            رنگ = "white"
        پایان
        پاراگراف: محتوا = title پایان
    پایان
پایان

صفحه:
    ناوبری:
        چیدمان = ردیف
        اگر صفحه.فشرده:
            چیدمان = "ستون"
        پایان
        اگر صفحه.فشرده و open:
            شکاف = 2
        پایان
        دکمه: کلیک = (): open = وارونه open پایان محتوا = "menu" پایان
    پایان
    جعبه:
        شناسه = "w"
        اگر صفحه.عریض:
            عرض = 300
        پایان
    پایان
    Card: title = "One" پایان
    Card: title = "Two" پایان
    Tag: shade = "red" پایان
    جعبه: فاصله = 16 محتوا = "plain" پایان
پایان
