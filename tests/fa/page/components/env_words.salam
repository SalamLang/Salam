بخش نوار(برچسب: رشته):
    باز := نادرست
    ناوبری:
        شناسه = "bar"
        فاصله = 16
        رنگ = "black"
        اگر فشرده:
            فاصله = 4
        وگرنه اگر عریض:
            فاصله = 32
        پایان
        اگر تیره:
            رنگ = "white"
        پایان
        اگر لمسی و عرض صفحه کوچکتر ۵۰۰:
            شکاف = 12
        پایان
        اگر حرکت کم:
            گذار = «هیچ»
        پایان
        دکمه:
            شناسه = "toggle"
            کلیک = (): باز = وارونه باز پایان
            محتوا = برچسب
        پایان
    پایان
