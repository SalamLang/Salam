بخش گزینه(نام: رشته):
    مورد: شناسه = "p-" + نام کلیک = (): انتخاب = نام پایان محتوا = نام پایان
پایان

ناپایا انتخاب := ""

بخش ردیف ها:
    موارد := وکتور {} برگردان وکتور<رشته>
    جعبه:
        دکمه: شناسه = "add" کلیک = (): موارد.بیفزا("r1") موارد.بیفزا("r2") پایان محتوا = "Add" پایان
        فهرست:
            هر ر در موارد:
                گزینه: نام = ر پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "Each parameter"
    پاراگراف: محتوا = "picked " + انتخاب پایان
    ردیف ها: پایان
پایان
