// انتظار: })(__salam_ws_1);
// انتظار نه: E012
ناپایا کل := ۰

بخش شمارنده(نام: رشته، تغییر):
    شمار := ۰
    دکمه: شناسه = نام کلیک = (): شمار++ تغییر(شمار) پایان محتوا = نام + " " + شمار پایان
پایان

بخش جفت(گزارش: تابع (صحیح)):
    جمع := ۰
    جعبه:
        پاراگراف: شناسه = "sum" محتوا = "sum " + جمع پایان
        شمارنده:
            نام = "a"
            تغییر = (م: صحیح):
                جمع += م
                گزارش(جمع)
            پایان
        پایان
        شمارنده: نام = "b" تغییر = (م: صحیح): جمع += م * ۱۰ پایان پایان
    پایان
پایان

صفحه:
    عنوان = "Callbacks"
    پاراگراف: شناسه = "total" محتوا = "total " + کل پایان
    جفت: گزارش = (م: صحیح): کل = م پایان پایان
    شمارنده: نام = "solo" پایان
پایان
