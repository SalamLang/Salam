// انتظار: salamWsAt(1,${salamWsCur(1)});
// انتظار: __salam_ws_0[salamWsCur(0)] = _d9_85;
// انتظار: salamWsTouch(2);
// انتظار نه: E012
ناپایا گروه ها := ["g1"، "g2"]
ناپایا ردیف ها := ["x"، "y"]
ناپایا انتخاب ها := ۰

بخش ردیف(گروه: رشته، نام: رشته):
    وضعیت ضربه ها := ۰
    وضعیت برچسب := نام
    مورد: کلید = نام شناسه = گروه + "-" + نام کلیک = (): ضربه ها++ برانگیز("انتخاب شد"، برچسب + ضربه ها) پایان محتوا = نام + " " + ضربه ها پایان
پایان

بخش دسته(نام: رشته):
    وضعیت انتخاب := "-"
    جعبه:
        شناسه = نام
        پاراگراف: شناسه = نام + "-p" محتوا = نام + " picked " + انتخاب پایان
        فهرست:
            هر ی در ردیف ها:
                ردیف: گروه = نام نام = ی هنگام انتخاب شد = (م: رشته): انتخاب = م پایان پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "Rows"
    هنگام انتخاب شد = (): انتخاب ها++ پایان
    پاراگراف: شناسه = "picks" محتوا = "picks " + انتخاب ها پایان
    هر گ در گروه ها:
        دسته: نام = گ پایان
    پایان
پایان
