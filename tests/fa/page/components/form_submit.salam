تابع به خاطر بسپار():
    نشان := ۱
    سرچاپ نشان
پایان

بخش شمارنده(برچسب: رشته):
    نوشته := ""
    جعبه:
        فرم:
            شناسه = برچسب + "-form"
            ارسال = (): نوشته = "handled" پایان
            ورودی:
                نام = "q"
                برچسب دسترسی‌پذیری = "q"
            پایان
            دکمه:
                شناسه = برچسب + "-send"
                نوع = "ارسال"
                محتوا = "send"
            پایان
        پایان
        پاراگراف:
            شناسه = برچسب + "-out"
            محتوا = "typed " + نوشته
        پایان
    پایان
پایان

بخش ردیف ها:
    نام ها := وکتور {} برگردان وکتور<رشته>
    جعبه:
        دکمه:
            شناسه = "add"
            کلیک = (): نام ها.بیفزا("x") نام ها.بیفزا("y") پایان
            محتوا = "add"
        پایان
        هر _، نام در نام ها:
            جعبه:
                کلید = نام
                شمارنده: برچسب = نام پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    شمارنده: برچسب = "a" پایان
    شمارنده: برچسب = "b" پایان
    ردیف ها: پایان
    فرم:
        شناسه = "named"
        ارسال = به خاطر بسپار
        دکمه:
            شناسه = "named-send"
            نوع = "ارسال"
            محتوا = "named"
        پایان
    پایان
    فرم:
        شناسه = "native"
        مقصد ارسال = "native-target.html"
        ورودی:
            نام = "n"
            مقدار = "1"
            برچسب دسترسی‌پذیری = "n"
        پایان
        دکمه:
            شناسه = "native-send"
            نوع = "ارسال"
            محتوا = "native"
        پایان
    پایان
پایان
