ناپایا سیین := ""

تابع به‌روزرسانی متن(نوشته: رشته):
    سیین = نوشته
پایان

صفحه:
    عنوان = "Call"
    جعبه:
        ورودی: شناسه = "a" ورودی = به‌روزرسانی متن پایان
        ورودی: شناسه = "b" ورودی = به‌روزرسانی متن() پایان
    پایان
پایان
