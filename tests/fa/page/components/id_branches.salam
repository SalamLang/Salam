// انتظار: id="t"
ناپایا پهن := نادرست

صفحه:
    عنوان = "Branch ids"
    جعبه:
        شناسه = "x"
        اگر پهن:
            پاراگراف:
                شناسه = "t"
                محتوا = "a"
            پایان
        وگرنه:
            پاراگراف:
                شناسه = "t"
                محتوا = "b"
            پایان
        پایان
    پایان
پایان
