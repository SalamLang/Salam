// انتظار: salamWsStyle(61, 0, `${__salam_ws_0 ? "orange" : "blue"}`)
// انتظار: salamWsStyle(61, 1, `${__salam_ws_0 ? "red" : "navy"}`)
بخش بخشه(برچسب: رشته):
    برگزیده := نادرست
    دکمه:
        شناسه = "seg"
        پس‌زمینه = "blue"
        اشاره:
            پس‌زمینه = "navy"
        پایان
        اگر برگزیده:
            پس‌زمینه = "orange"
            اشاره:
                پس‌زمینه = "red"
            پایان
        پایان
        کلیک = (): برگزیده = وارونه برگزیده پایان
        محتوا = برچسب
    پایان
پایان

صفحه:
    عنوان = "If and state"
    بخشه: برچسب = "A" پایان
پایان
