// انتظار نه: salamWsStyle(38
// انتظار نه: __salam_ws_0 ? "red"
بخش بخشه(برچسب: رشته):
    برگزیده := نادرست
    دکمه:
        شناسه = "a"
        اگر نادرست:
            فاصله = 8
        پایان
        اگر برگزیده:
            رنگ = "red"
        پایان
        رنگ = "blue"
        کلیک = ():
            برگزیده = وارونه برگزیده
        پایان
        محتوا = برچسب
    پایان
پایان

صفحه:
    عنوان = "Edges"
    بخشه: برچسب = "A" پایان
پایان
