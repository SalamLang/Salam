// انتظار: <p>یادداشت سلام</p>
بخش پیوند یادداشت(متن: رشته):
    پاراگراف: محتوا = "یادداشت " + متن پایان
پایان

صفحه:
    عنوان = "پیوند"
    جعبه:
        پیوند یادداشت: متن = "سلام" پایان
    پایان
پایان
