// انتظار نه: E292
ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>

تابع پرکردن():
    نام‌ها.افزودن("a")
    نام‌ها.افزودن("b")
پایان

بخش ردیف(برچسب: رشته):
    مورد:
        محتوا = برچسب
    پایان
پایان

بخش کلیددار(کلید: رشته):
    مورد:
        محتوا = کلید
    پایان
پایان

بخش جفت(برچسب: رشته):
    واژه:
        محتوا = برچسب
    پایان
    شرح:
        محتوا = برچسب
    پایان
پایان

صفحه:
    دکمه:
        کلیک = پرکردن
        محتوا = "fill"
    پایان
    فهرست:
        هر ی، نام در نام‌ها:
            مورد:
                کلید = ی
                محتوا = نام
            پایان
        پایان
        هر یکی در نام‌ها:
            مورد: کلید = یکی محتوا = یکی پایان
        پایان
        هر کاربرد در نام‌ها:
            ردیف:
                کلید = "use-" + کاربرد
                برچسب = کاربرد
            پایان
        پایان
        هر خودی در نام‌ها:
            کلیددار:
                کلید = خودی
            پایان
        پایان
    پایان
    فهرست تعریف:
        هر جفتی در نام‌ها:
            جفت:
                کلید = جفتی
                برچسب = جفتی
            پایان
        پایان
    پایان
    جعبه:
        هر ج، شاخه در نام‌ها:
            اگر ج بزرگتر 0:
                تکه:
                    کلید = شاخه
                    محتوا = شاخه
                پایان
            وگرنه:
                پررنگ:
                    کلید = شاخه + "!"
                    محتوا = شاخه
                پایان
            پایان
        پایان
        هر گروه در نام‌ها:
            جعبه:
                کلید = گروه
                هر فرزند در نام‌ها:
                    تکه:
                        کلید = گروه + فرزند
                        محتوا = فرزند
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
