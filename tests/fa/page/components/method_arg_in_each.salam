// انتظار نه: E001
بخش حباب(کی: رشته، متن: رشته):
    جعبه:
        اگر کی برابر "me":
            پس‌زمینه = #2563eb
        پایان
        پاراگراف: محتوا = کی + ": " + متن پایان
    پایان
پایان

بخش گفتگو:
    نام‌ها := وکتور {} برگردان وکتور<رشته>
    سطرها := وکتور {} برگردان وکتور<رشته>
    جعبه:
        دکمه: شناسه = "add" کلیک = (): نام‌ها.بیفزا("me") سطرها.بیفزا("hi") پایان محتوا = "Add" پایان
        فهرست:
            هر ی، سطر در سطرها:
                مورد: کلید = ی
                    حباب: کی = نام‌ها.بگیر(ی) متن = سطر پایان
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "Method call in a component argument"
    گفتگو: پایان
پایان
