// انتظار: function __salam_view_0
// انتظار: سلام از یک تابع
تابع خوشامد(): رشته:
    برگشت "سلام از یک تابع"
پایان

بخش آغازگاه:
    نمونه := خوشامد()
    موردها := [1، 2]
    جعبه:
        پاراگراف: محتوا = نمونه پایان
        هر ردیف، شماره در موردها:
            پاراگراف:
                کلید = ردیف
                محتوا = "شماره " + شماره
            پایان
        پایان
    پایان
پایان

صفحه:
    آغازگاه: پایان
پایان
