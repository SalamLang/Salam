// انتظار: <!--salam:3--><!--/salam:3-->
// انتظار: salamWsTouch(2);
// انتظار: salamWsTouch(3);
// انتظار: function __salam_view_3() {
// انتظار: salamWsSlot(0,
// انتظار نه: E129
// انتظار نه: E133
ناپایا جمع := ۰
ناپایا نام ها := وکتور {} برگردان وکتور<رشته>

تابع افزایش():
    جمع++
    نام ها.بیفزا("n" + جمع)
پایان

بخش ردیف(نام: رشته):
    وضعیت ضربه := ۰
    مورد: کلید = نام کلیک = (): ضربه++ پایان محتوا = نام + " " + ضربه پایان
پایان

صفحه:
    عنوان = "Globals"
    پاراگراف: شناسه = "total" محتوا = "Total " + جمع پایان
    دکمه: شناسه = "bump" کلیک = افزایش محتوا = "Bump" پایان
    اگر جمع > ۲:
        پاراگراف: شناسه = "big" محتوا = "Big" پایان
    پایان
    فهرست:
        شناسه = "names"
        هر ن در نام ها:
            ردیف: نام = ن پایان
        پایان
    پایان
پایان
