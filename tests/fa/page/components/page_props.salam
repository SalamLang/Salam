// انتظار: @media (prefers-color-scheme: dark) { .a { color:#ffffff; } }
// انتظار: @media (width < 600px) and not (prefers-color-scheme: dark) { .a { font-size:14px; } }
// انتظار: @media (width >= 400px) and (height < 900px) { .a { background-color:#008000;background-image:none; } }
// انتظار: @media (width < 600px) or (prefers-color-scheme: dark) { .a { padding:4px; } }
// انتظار: salamWsStyle(0, 0, `${envx_compact ? "ستون" : "ردیف"}`)
// انتظار: salamWsStyle(1, 0, `${!envx_wide && envx_w > 300 ? "12" : ""}`)
// انتظار: function __salam_env_sync()
صفحه:
    عنوان = "Page props"
    پس‌زمینه = "red"
    اگر صفحه.عرض بزرگتربرابر ۴۰۰ و صفحه.ارتفاع کوچکتر ۹۰۰:
        پس‌زمینه = "green"
    پایان
    اگر صفحه.فشرده یا صفحه.تیره:
        فاصله = 4
    پایان
    اگر صفحه.تیره:
        رنگ = "white"
    وگرنه اگر صفحه.فشرده:
        اندازه قلم = 14
    پایان
    ناوبری:
        شناسه = "bar"
        چیدمان = ردیف
        اگر صفحه.فشرده:
            چیدمان = "ستون"
        پایان
        اگر وارونه صفحه.عریض و صفحه.عرض بزرگتر ۳۰۰:
            شکاف = 12
        پایان
        پیوند: نشانی = "/" محتوا = "خانه" پایان
    پایان
    اگر صفحه.عرض کوچکتر ۵۰۰:
        پاراگراف: شناسه = "small" محتوا = "small" پایان
    پایان
پایان
