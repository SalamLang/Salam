// انتظار: @media (width < 640px) { .b { padding:8px; } }
بخش کارت(ت: رشته):
    جعبه:
        فاصله = 32
        اگر صفحه.عرض کوچکتر ۶۴۰:
            فاصله = 8
        پایان
        پاراگراف: محتوا = ت پایان
    پایان
پایان

صفحه:
    عنوان = "پ"
    جعبه:
        شناسه = "outer"
        چیدمان = ردیف
        شکاف = 24
        اگر صفحه.عرض کوچکتر ۶۴۰:
            چیدمان = ستون
            شکاف = 4
        پایان
        کارت: ت = "a" پایان
    پایان
پایان
