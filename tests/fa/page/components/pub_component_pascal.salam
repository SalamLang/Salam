// انتظار: <h2>سلام</h2>
همگانی بخش کارت(عنوان):
    سرتیتر: اندازه = 2 محتوا = عنوان پایان
پایان
همگانی بخش Card2(عنوان):
    جعبه: محتوا = عنوان پایان
پایان
همگانی بخش Cardکارت(عنوان):
    جعبه: محتوا = عنوان پایان
پایان
صفحه:
    کارت: عنوان = "سلام" پایان
    Card2: عنوان = "x" پایان
    Cardکارت: عنوان = "y" پایان
پایان
