// انتظار: if (k === "transparent" || k === "شفاف") {
// انتظار نه: salamWsTouch(2)
ناپایا کلید := ""
ناپایا تیره := نادرست

تابع نشان(ن: رشته): منطقی:
    برگشت ن.کوچک().دربردارد(کلید)
پایان

صفحه:
    جعبه:
        پس زمینه = تیره ? "شفاف" : "#ff0000"
        ورودی:
            شناسه = "q"
            پیوند = کلید
        پایان
        اگر نشان("Abc"):
            پاراگراف:
                محتوا = "match"
            پایان
        پایان
    پایان
پایان
