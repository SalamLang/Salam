// انتظار: let __salam_ws_2 = 0;
// انتظار: salamWsTouch(0);
// انتظار: salamWsTouch(1);
// انتظار: salamWsTouch(2);
// انتظار: __salam_ws_1 = ((__salam_ws_1 + 1) | 0);
// انتظار: main panel ${__salam_ws_0}
// انتظار: badge ${((Math.imul(__salam_ws_0, 10)) | 0)} ${__salam_ws_2}
// انتظار: <!--salam:1--><!--/salam:1-->
// انتظار نه: salamWsTouch(3)
// انتظار نه: __salam_ws_3
بخش نشان(مقدار: صحیح):
    نوشته := "badge " + مقدار
    ضربه ها := ۰
    پاراگراف: شناسه = "badge" کلیک = (): ضربه ها++ پایان محتوا = نوشته + " " + ضربه ها پایان
پایان

بخش تابلو(نام: رشته):
    شمار := ۰
    دفعه فشار := ۰
    سرنویس := نام + " panel"
    جعبه:
        پاراگراف: شناسه = "title" محتوا = سرنویس + " " + شمار پایان
        دکمه: شناسه = "inc" کلیک = (): شمار++ پایان محتوا = "+" پایان
        دکمه: شناسه = "quiet" کلیک = (): دفعه فشار++ پایان محتوا = "quiet" پایان
        نشان: مقدار = شمار * ۱۰ پایان
    پایان
پایان

صفحه:
    کل := ۰
    برچسب := "total " + کل
    عنوان = "Variables"
    پاراگراف: شناسه = "total" محتوا = برچسب پایان
    دکمه: شناسه = "add" کلیک = (): کل += ۲ پایان محتوا = "add" پایان
    تابلو: نام = "main" پایان
پایان
