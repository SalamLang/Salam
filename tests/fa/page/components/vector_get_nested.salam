// انتظار: add
ناپایا متن‌ها := وکتور {} برگردان وکتور<رشته>

بخش خط(جای: صحیح):
    پاراگراف:
        محتوا = متن‌ها.بگیر(جای)
    پایان
پایان

بخش فهرست:
    شمار := ۰
    شاخص‌ها := وکتور {} برگردان وکتور<صحیح>
    جعبه:
        دکمه:
            کلیک = (): شمار++ شاخص‌ها.افزودن(شمار - ۱) متن‌ها.افزودن("x") پایان
            محتوا = "add"
        پایان
        اگر شمار بزرگتر ۰:
            هر _، جای در شاخص‌ها:
                خط:
                    جای = جای
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    فهرست: پایان
پایان
