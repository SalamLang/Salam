// انتظار: salamWsStyle(61, 0, `${__salam_ws_0 ? "orange" : "blue"}`)
// انتظار: salamWsStyle(114, 0, `${__salam_ws_0 ? "black" : "white"}`)
// انتظار: salamWsStyle(61, 1, `${__salam_ws_0 ? "red" : "navy"}`)
// انتظار: salamWsStyle(38, 0, `${__salam_ws_0 && __salam_ws_1 ? "40" : __salam_ws_1 ? "24" : "8"}`)
بخش بخشه(برچسب: رشته):
    برگزیده := نادرست
    بزرگ := نادرست
    دکمه:
        شناسه = "seg"
        پس‌زمینه = "blue"
        رنگ = "white"
        اشاره پس‌زمینه = "navy"
        فاصله = 8
        وقتی برگزیده:
            پس‌زمینه = "orange"
            رنگ = "black"
            اشاره پس‌زمینه = "red"
        پایان
        وقتی بزرگ:
            فاصله = 24
        پایان
        وقتی برگزیده و بزرگ:
            فاصله = 40
        پایان
        کلیک = ():
            برگزیده = وارونه برگزیده
            بزرگ = وارونه بزرگ
        پایان
        محتوا = برچسب
    پایان
پایان

صفحه:
    عنوان = "When"
    بخشه: برچسب = "A" پایان
پایان
