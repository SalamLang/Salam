صفحه:
    آواتار:
        اندازه = "بزرگ"
    پایان
    تصویر آواتار:
        نشانی = "a.png"
        جایگزین = "x"
    پایان
    جایگزین آواتار:
        محتوا = "CN"
    پایان
پایان
