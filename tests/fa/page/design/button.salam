// انتظار: <button data-variant="destructive" data-size="icon-lg">x &lt; y</button>
// انتظار: :where(button[data-size="icon-xs"])
صفحه:
    عنوان = "دکمه"
    دکمه:
        گونه = "خطرناک"
        اندازه = "آیکون بزرگ"
        محتوا = "x < y"
    پایان
پایان
