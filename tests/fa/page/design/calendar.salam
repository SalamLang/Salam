صفحه:
    طراحی = "شد سی ان"
    تقویم:
        شناسه = "c1"
        تقویم = "شمسی"
        شیوه انتخاب = "بازه"
        شروع هفته = ۶
        کمینه = "2026-01-01"
        روزهای غیرفعال = "5"
        مقدار = "2026-11-10/2026-11-16"
    پایان
    انتخابگر تاریخ:
        نام = "when"
        تقویم = "شمسی"
    پایان
پایان
