// انتظار: <input id="c1" type="checkbox" checked>
// انتظار: :where(input[type="radio"]:checked)::after
// انتظار: ::-webkit-slider-thumb
// انتظار: role="radiogroup" data-slot="radio-group"
صفحه:
    طراحی = "شد سی ان"
    جعبه:
        ورودی:
            شناسه = "c1"
            نوع = "تیک"
            تیک خورده = درست
        پایان
        گروه رادیویی:
            ورودی:
                نوع = "رادیویی"
                نام = "g"
            پایان
        پایان
        ورودی:
            نوع = "بازه"
        پایان
    پایان
پایان
