// انتظار: <div data-slot="command" id="c1">
// انتظار: <input type="text" data-slot="command-input" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Search">
// انتظار: data-slot="command-item" role="option" aria-selected="false" data-value="cal" data-keywords="date"
// انتظار: data-slot="command-group" role="group" data-heading="Tools"
// انتظار: <dialog data-slot="dialog" data-overlay data-command-dialog data-state="closed" aria-label="پالت فرمان" data-hotkey="k">
// انتظار: window.salamDsPick
صفحه:
    فرمان:
        شناسه = "c1"
    پایان
    ورودی فرمان:
        جانگهدار = "Search"
    پایان
    گروه فرمان:
        سرتیتر = "Tools"
    پایان
    گزینه فرمان:
        مقدار = "cal"
        کلمات کلیدی = "date"
        محتوا = "Calendar"
    پایان
    پنجره فرمان:
        کلید میانبر = "k"
    پایان
پایان
