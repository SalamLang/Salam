// انتظار: <a data-slot="item" data-variant="outline" data-size="sm" href="/x">
// انتظار: data-slot="item-title">نام</div>
// انتظار: data-slot="item-description">متن</p>
صفحه:
    مدخل:
        گونه = "خط دور"
        اندازه = "کوچک"
        نشانی = "/x"
    پایان
    عنوان مدخل:
        محتوا = "نام"
    پایان
    توضیح مدخل:
        محتوا = "متن"
    پایان
پایان
