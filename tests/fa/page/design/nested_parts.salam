// انتظار: <div data-slot="alert" role="alert"><div data-slot="alert-title">توجه</div></div>
صفحه:
    کارت:
        سربرگ کارت:
            عنوان کارت:
                محتوا = "طرح"
            پایان
            توضیح کارت:
                محتوا = "ماهانه"
            پایان
        پایان
        محتوای کارت:
            محتوا = "بدنه"
        پایان
    پایان
    هشدار:
        تیتر هشدار:
            محتوا = "توجه"
        پایان
    پایان
پایان
