صفحه:
    پنجره گفتگو:
        شناسه = "d1"
        بستن با کلیک بیرون = "نادرست"
        عنوان پنجره:
            محتوا = "T"
        پایان
    پایان
    پنجره هشدار:
        شناسه = "d2"
        تصویر هشدار:
            تکه:
                محتوا = "!"
            پایان
        پایان
    پایان
پایان
