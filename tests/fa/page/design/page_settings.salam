صفحه:
    عنوان = "توکن"
    طراحی = "شد سی ان"
    پوسته = "تاریک"
    پالت = "روی"
    توکن های طراحی = "primary: #123; dark primary: #fff"
    پاراگراف:
        محتوا = "x"
    پایان
