// انتظار: <div data-ds-off data-design="none">
// انتظار: <div data-slot="card" data-ds-on data-design="shadcn"><div data-slot="card-title" data-ds-on>Back on</div>
// انتظار: <div data-slot="card" data-ds-off><div data-slot="card-title" data-ds-off>Bare</div>
// انتظار: :where(:not([data-ds-off])):where([data-slot="card-title"]){font-weight:600
صفحه:
    عنوان = "Scope reenable"
    طراحی = "شد سی ان"
    جعبه:
        طراحی = "هیچ"
        کارت:
            طراحی = "شد سی ان"
            عنوان کارت:
                محتوا = "Back on"
            پایان
        پایان
        کارت:
            عنوان کارت:
                محتوا = "Bare"
            پایان
        پایان
    پایان
پایان
