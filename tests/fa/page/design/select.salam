// انتظار: data-slot="combobox" data-combobox data-state="closed" data-name="fw" data-clearable
// انتظار: <input type="hidden" data-slot="combobox-input-hidden" name="fw">
// انتظار: data-slot="combobox-item" role="option" aria-selected="false" data-value="next">Next.js
// انتظار: <button data-slot="select-trigger" type="button" data-size="sm"><span data-slot="select-value">Pick</span>
// انتظار: data-slot="select-item" role="option" aria-selected="false" data-value="a" data-disabled
// انتظار: [data-slot="select-trigger"][data-size="sm"]
صفحه:
    جعبه ترکیبی:
        نام = "fw"
        قابل پاک شدن = درست
    پایان
    گزینه جعبه ترکیبی:
        مقدار = "next"
        محتوا = "Next.js"
    پایان
    جعبه انتخاب:
        نام = "pick"
    پایان
    دکمه جعبه انتخاب:
        اندازه = "کوچک"
        محتوا = "Pick"
    پایان
    گزینه جعبه انتخاب:
        مقدار = "a"
        غیرفعال = درست
        محتوا = "A"
    پایان
پایان
