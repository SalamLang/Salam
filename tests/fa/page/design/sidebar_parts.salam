// انتظار: <button data-slot="sidebar-rail" type="button" tabindex="-1" aria-label="Toggle sidebar" title="Toggle sidebar"></button>
// انتظار: <ul data-slot="sidebar-menu-sub"><li data-slot="sidebar-menu-sub-item">
// انتظار: <a data-slot="sidebar-menu-sub-button" data-size="sm" href="#a" data-active>Alpha</a>
// انتظار: <li data-slot="sidebar-menu-item" data-open>
// انتظار: data-tooltip="Go home"
// انتظار: data-slot="sidebar-tooltip"
صفحه:
    پنل نوار کناری:
        لبه نوار کناری:
        پایان
        منوی نوار کناری:
            آیتم منوی نوار کناری:
                باز = درست
                دکمه منوی نوار کناری:
                    راهنمای دکمه = "Go home"
                    محتوا = "Home"
                پایان
                زیرمنوی نوار کناری:
                    آیتم زیرمنوی نوار کناری:
                        دکمه زیرمنوی نوار کناری:
                            اندازه = "کوچک"
                            نشانی = "#a"
                            فعال = درست
                            محتوا = "Alpha"
                        پایان
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
