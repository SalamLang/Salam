// انتظار: <body data-design="shadcn" data-theme="dark">
// انتظار: <div data-theme="light">
// انتظار: <div data-theme="auto">
// انتظار: :not(html,body).dark){background:var(--background);color:var(--foreground)}
صفحه:
    عنوان = "Theme element"
    طراحی = "شد سی ان"
    پوسته = «تاریک»
    جعبه:
        پوسته = «روشن»
        محتوا = "light"
    پایان
    جعبه:
        پوسته = «خودکار»
        محتوا = "auto"
    پایان
پایان
