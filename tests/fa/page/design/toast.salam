// انتظار: <ol data-slot="toaster" role="region" aria-label="اعلان‌ها" aria-live="polite" data-placement="top-center" data-closable>
// انتظار: data-toast="Saved" data-toast-description="Done" data-toast-variant="success"
// انتظار: window.salamToast
// انتظار: :where([data-slot="toaster"][data-placement="top-right"])
صفحه:
    اعلان ها:
        جانمایی = "بالا وسط"
        دکمه بستن = درست
    پایان
    دکمه:
        اعلان = "Saved"
        توضیح اعلان = "Done"
        گونه اعلان = "موفق"
        محتوا = "Save"
    پایان
پایان
