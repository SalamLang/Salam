// انتظار: ondragend="alert(1)"
// انتظار: onended="alert(7)"
// انتظار: ontransitionend="alert(5)"
صفحه:
    جعبه: اتمام کشیدن = "alert(1)" اتمام گذار = "alert(5)" محتوا = "x" پایان
    صدا: اتمام پخش = "alert(7)" پایان
پایان
