// انتظار: window["افزایش"] = _d8_a7_d9_81_d8_b2_d8_a7_db_8c_d8_b4;
واردسازی دام

تابع افزایش:
    دام.تنظیم متن(دام.با شناسه("نتیجه"), "کلیک شد")
پایان

صفحه:
    پاراگراف:
        شناسه = "نتیجه"
        محتوا = "سلام"
    پایان
    دکمه:
        کلیک = افزایش
        محتوا = "کلیک"
    پایان
پایان
