// انتظار: onclick="window[&#39;بروز رسانی&#39;]()"
// انتظار: window["بروز رسانی"] =
واردسازی دام

تابع بروز‌رسانی():
    دام.تنظیم متن(دام.با شناسه("نتیجه"), "یک")
پایان

صفحه:
    پاراگراف:
        شناسه = "نتیجه"
        محتوا = "-"
    پایان
    دکمه:
        کلیک = بروز‌رسانی
        محتوا = "بزن"
    پایان
پایان
