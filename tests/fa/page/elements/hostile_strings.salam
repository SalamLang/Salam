// انتظار: <title>T &lt;/title&gt;&lt;img src=x&gt;</title>
// انتظار: &lt;/script&gt;&lt;script&gt;window.pwned=1&lt;/script&gt;
// انتظار: <\/script><script>window.pwned=2<\/script>
// انتظار: <\/SCRIPT ><img src=x onerror=window.pwned=3>
// انتظار: <\!--<script>
// انتظار: x${پیام}<\/script><\!--<script>
// انتظار: salamWsUrl(
// انتظار نه: </script><script>window.pwned
// انتظار نه: </SCRIPT ><img
// انتظار: &lt;img src=x onerror=window.pwned=4&gt;
ناپایا پیام := "</script><script>window.pwned=2</script>"
ناپایا مقصد_من := "/start"

صفحه:
    عنوان = "T </title><img src=x>"
    پاراگراف:
        محتوا = "</script><script>window.pwned=1</script>"
    پایان
    پاراگراف:
        عنوان = پیام
        محتوا = پیام
    پایان
    پاراگراف:
        محتوا = "a\u0002<img src=x onerror=window.pwned=4>\u0003"
    پایان
    دکمه:
        کلیک = (): پیام = "</scr" + "ipt><script>window.pwned=2</scr" + "ipt></SCRIPT ><img src=x onerror=window.pwned=3><!" + "--<scr" + "ipt>" پایان
        محتوا = "go"
    پایان
    دکمه:
        کلیک = (): پیام = "x${پیام}</script><!--<script>" مقصد_من = پیام پایان
        محتوا = "template"
    پایان
    دکمه منوی نوار کناری:
        نشانی = مقصد_من
        محتوا = "side"
    پایان
پایان
