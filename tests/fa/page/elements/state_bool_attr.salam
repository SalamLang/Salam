// انتظار: if (flag)
// انتظار:  checked
// انتظار:  disabled
// انتظار:  selected
// انتظار:  required
// انتظار نه: salamWsHtml(`${flag}`)
// انتظار نه: salamWsHtml(`${sel === "a"}`)
ناپایا flag := نادرست
ناپایا sel := "a"

صفحه:
    عنوان = "State bool attributes"
    ورودی:
        نوع = "تیک"
        تیک خورده = flag
        الزامی = flag
        تغییر = (): flag = وارونه flag پایان
    پایان
    دکمه:
        غیرفعال = flag
        محتوا = "Go"
    پایان
    انتخاب:
        گزینه:
            مقدار = "a"
            انتخاب‌شده = (sel برابر "a")
            محتوا = "A"
        پایان
    پایان
پایان
