// انتظار: if (flag)
// انتظار:  hidden
// انتظار:  readonly
// انتظار:  open
// انتظار:  multiple
// انتظار نه: hidden="
// انتظار نه: salamWsHtml(`${flag}`)
ناپایا flag := نادرست

صفحه:
    عنوان = "More state bool attributes"
    پاراگراف:
        پنهان = flag
        محتوا = "x"
    پایان
    ورودی:
        نوع = "متن"
        فقط خواندنی = flag
        تغییر = (): flag = وارونه flag پایان
    پایان
    جزئیات:
        باز = flag
        محتوا = "more"
    پایان
    انتخاب:
        چندتایی = flag
        گزینه:
            مقدار = "a"
            محتوا = "A"
        پایان
    پایان
پایان
