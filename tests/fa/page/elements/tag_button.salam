// انتظار: <button
// انتظار:  form="target1"
// انتظار:  formaction="/a.html"
// انتظار:  formmethod="get"
// انتظار:  formenctype="application/x-www-form-urlencoded"
// انتظار:  formnovalidate
// انتظار:  formtarget="_blank"
// انتظار:  autofocus
// انتظار:  popovertarget="target1"
// انتظار:  popovertargetaction="toggle"
// انتظار:  command="x1"
// انتظار:  commandfor="target1"
صفحه:
    جعبه: شناسه = "target1" پایان
    دکمه:
        فرم = "target1"
        مقصد ارسال فرم = "/a.html"
        روش فرم = "دریافت"
        رمزگذاری فرم = "نشانی کدشده"
        بدون اعتبارسنجی فرم = درست
        هدف فرم = "پنجره جدید"
        تمرکز خودکار = درست
        هدف واشو = "target1"
        کنش واشو = "جابه‌جا"
        فرمان = "x1"
        هدف فرمان = "target1"
        محتوا = "متن"
    پایان
پایان
