// انتظار: <p>وب</p>
// انتظار: <span>بعد</span>
// انتظار نه: فقط بومی
صفحه:
    اگر سلام رابط وب:
        پاراگراف: محتوا = "وب" پایان
    وگرنه:
        پاراگراف: محتوا = "فقط بومی" پایان
    پایان
    جعبه:
        اگر سلام رابط بومی:
            تکه: محتوا = "فقط بومی" پایان
        پایان
        تکه: محتوا = "بعد" پایان
    پایان
پایان
