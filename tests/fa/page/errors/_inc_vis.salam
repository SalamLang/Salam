همگانی بخش قاب(برچسب):
    درونی: متن = برچسب پایان
پایان

بخش درونی(متن):
    جعبه: کلاس = "frame" محتوا = متن پایان
پایان

بخش انباری(برچسب):
    پاراگراف: محتوا = برچسب پایان
پایان
