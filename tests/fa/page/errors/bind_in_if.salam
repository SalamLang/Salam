// انتظار: ERROR
// انتظار پیام: 'پیوند' را نمی‌توان درون 'اگر' یا 'هر' به‌کار برد
ناپایا نام := ""
ناپایا بلند := نادرست

صفحه:
    عنوان = "Bind in if"
    ورودی:
        نوع = "متن"
        اگر بلند:
            پیوند = نام
        پایان
    پایان
پایان
