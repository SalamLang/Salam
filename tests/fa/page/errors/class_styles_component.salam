// انتظار: E136
// انتظار پیام: کلاس تولیدشده‌ی خودش را بگیرد
بخش برچسب(روشن: منطقی، نوشته: رشته):
    جعبه:
        کلاس = "tag"
        فاصله = 6
        اگر روشن:
            پس زمینه = "gold"
        وگرنه:
            پس زمینه = "gray"
        پایان
        محتوا = نوشته
    پایان
پایان

صفحه:
    عنوان = "Tags"
    برچسب:
        روشن = درست
        نوشته = "a"
    پایان
    برچسب:
        روشن = نادرست
        نوشته = "b"
    پایان
پایان
