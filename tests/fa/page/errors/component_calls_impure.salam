// انتظار: خطا۰۱۲
ناپایا شمار := 0

تابع بانگ(ی: صحیح): رشته:
    شمار++
    برگشت "n" + ی
پایان

بخش ردیف(ی: صحیح):
    پاراگراف:
        محتوا = بانگ(ی)
    پایان
پایان

صفحه:
    عنوان = "Impure"
    ردیف:
        ی = 3
    پایان
پایان
