// انتظار: E029
// انتظار پیام: component_state_row_type.salam:20:24
بخش شمارنده(برچسب متن: رشته):
    تعداد := ۰
    جعبه:
        دکمه:
            کلیک = (): تعداد.گمشده() پایان
            محتوا = برچسب متن + تعداد
        پایان
    پایان
پایان

ناپایا نام ها := ["a", "b"]

صفحه:
    هر ش، نام در نام ها:
        شمارنده:
            کلید = ش
            برچسب متن = نام
        پایان
    پایان
پایان
