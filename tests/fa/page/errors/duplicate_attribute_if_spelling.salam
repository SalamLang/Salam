// انتظار: خطا۱۱۴
// انتظار نه: مقدار نامعتبر برای
بخش کارت:
    روشن := نادرست
    جعبه:
        محتوا = "سلام"
        اگر روشن:
            وزن_قلم = 700
        پایان
        وزن قلم = 400
    پایان
پایان
صفحه:
    کارت: پایان
پایان
