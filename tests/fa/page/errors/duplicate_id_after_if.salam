// انتظار: E122
ناپایا پهن := نادرست

صفحه:
    اگر پهن:
        جعبه: شناسه = "t" پایان
    وگرنه:
        جعبه: شناسه = "u" پایان
    پایان
    جعبه: شناسه = "t" پایان
پایان
