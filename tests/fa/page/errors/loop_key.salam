// انتظار: E292
// انتظار پیام: «مورد» ردیفی از «هر» است و کلید ندارد
// انتظار پیام: بنویسید «هر ش، نام در ...:» و خط «کلید = ش» را درون «مورد:» اضافه کنید
// انتظار پیام: «ردیف فهرست» ردیفی از «هر» است و کلید ندارد
// انتظار پیام: این کلید نه متغیر و نه اندیس «هر» خود ('ثابت') را به کار نمی‌برد
ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>

بخش ردیف فهرست(عنوان: رشته):
    مورد:
        کلید = عنوان
        محتوا = عنوان
    پایان
پایان

صفحه:
    فهرست:
        هر نام در نام‌ها:
            مورد:
                محتوا = نام
            پایان
        پایان
        هر کاربرد در نام‌ها:
            ردیف فهرست:
                عنوان = کاربرد
            پایان
        پایان
        هر ثابت در نام‌ها:
            مورد:
                کلید = "ردیف"
                محتوا = ثابت
            پایان
        پایان
    پایان
پایان
