// پرچم: --ui=native --log-level=warn
// انتظار: هشدار۱۶۶
// انتظار پیام: 'متا' فراداده صفحه وب است و هدف بومی آن را نادیده می‌گیرد
صفحه:
    متا: نام = "description" محتوا = "برنامه یادداشت" پایان
    پاراگراف: محتوا = "سلام" پایان
پایان
