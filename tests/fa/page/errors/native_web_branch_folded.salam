// پرچم: --ui=native --log-level=warn
// انتظار: هشدار۱۶۶
// انتظار نه: خطا۱۶۵
صفحه:
    متا: نام = "description" محتوا = "برنامه یادداشت" پایان
    اگر سلام رابط وب:
        اسکریپت سفارشی: محتوا = "console.log(1)" پایان
    پایان
    جعبه:
        اگر سلام رابط بومی:
            پاراگراف: محتوا = "بومی" پایان
        وگرنه:
            قاب درونی: نشانی = "https://example.com" پایان
        پایان
    پایان
پایان
