// انتظار: E263
// انتظار پیام: بیش از سه پارامتر اختیاری با مقدار پیش‌فرض دارد
بخش راهنما(الف: رشته = "a"، ب: رشته = "b"، ج: رشته = "c"، د: رشته = "d"):
    پاراگراف: محتوا = الف + ب + ج + د پایان
پایان

مسیرها:
    "/docs/:الف?/:ب?/:ج?/:د?" : راهنما
پایان

صفحه:
    نمای مسیر: پایان
پایان
