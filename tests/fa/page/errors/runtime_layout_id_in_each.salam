// انتظار: خطا۱۳۴
// انتظار پیام: شناسه‌ی ثابت 'row'
صفحه ردیف‌ها(ها: وکتور<رشته>):
    هر ش، ه در ها:
        جعبه: کلید = ش شناسه = «row» محتوا = ه پایان
    پایان
پایان

تابع ریشه():
    ها := وکتور {} برگردان وکتور<رشته>
    سرچاپ ردیف‌ها(ها)
پایان
