// انتظار: خطا۰۱۲
// انتظار پیام: 'شانس'
واردسازی تصادفی

صفحه شانس(نام: رشته):
    پاراگراف: محتوا = نام + « گرفت » + تصادفی.عدد کمتر از ان(۱۰) پایان
پایان

تابع ریشه():
    سرچاپ شانس(«علی»)
پایان
