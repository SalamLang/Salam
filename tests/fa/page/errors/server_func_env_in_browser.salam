// انتظار: E286
// انتظار پیام: 'اپی باسی' در مرورگر اجرا می‌شود
واردسازی محیط

ناپایا کل := 0

تابع اپی باسی(): رشته:
    برگشت محیط.دریافت("SHOP_API")
پایان

سرور تابع قووتی(سکو: رشته): صحیح:
    برگشت سکو.طول() + اپی باسی().طول()
پایان

صفحه:
    سرور = "https://front.example.com"
    جعبه:
        دکمه: کلیک = (): کل = اپی باسی().طول() + قووتی("a1") پایان محتوا = "Get" پایان
        پاراگراف: محتوا = کل پایان
    پایان
پایان
