// انتظار: E289
// انتظار پیام: تابع سرور 'قووتی' از یک ساخت ایستا در دسترس است
ناپایا کل := 0

سرور تابع قووتی(سکو: رشته): صحیح:
    برگشت سکو.طول()
پایان

صفحه:
    جعبه:
        دکمه: کلیک = (): کل = قووتی("a1") پایان محتوا = "Get" پایان
        پاراگراف: محتوا = کل پایان
    پایان
پایان
