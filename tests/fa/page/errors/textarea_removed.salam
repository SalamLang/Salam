// انتظار: خطا۲۹۷
// انتظار پیام: عنصر «متن بلند» برداشته شد
// انتظار پیام: به‌جای آن «ورودی» را با نوع = "ناحیه متن" بنویسید
صفحه:
    فرم:
        متن بلند:
            نام = "bio"
            ردیف‌ها = 3
            محتوا = "hello"
        پایان
    پایان
پایان
