همگانی بخش فهرست:
    ناوبری:
        گزینه فهرست:
            مقصد = "/"
            برچسب = "خانه"
        پایان
        گزینه فهرست:
            مقصد = "/about"
            برچسب = "درباره"
        پایان
    پایان
پایان

بخش گزینه فهرست(مقصد: رشته، برچسب: رشته):
    پیوند:
        مقصد = مقصد
        اگر صفحه.مسیر.نشانی برابر مقصد:
            وزن قلم = 700
        پایان
        محتوا = برچسب
    پایان
پایان
