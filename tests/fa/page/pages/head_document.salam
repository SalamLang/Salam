// انتظار پایه: <html lang="fa" dir="rtl">
// انتظار: <title>برنامه من</title>
// انتظار: <meta name="author" content="علی">
// انتظار: <meta name="description" content="نان تازه">
// انتظار: <meta name="keywords" content="نان, نانوایی">
// انتظار: <meta name="theme-color" content="#2563eb">
// انتظار: <meta name="robots" content="noindex">
// انتظار: <link rel="canonical" href="https://shop.example/">
// انتظار: <link rel="icon" href="/icon.png">
// انتظار: <h1>خوش آمدید</h1>
// انتظار نه: <body title
// انتظار نه: <body lang
// انتظار نه: ="1"
صفحه:
    عنوان = "برنامه من"
    زبان = "فارسی"
    جهت = "راست به چپ"
    نویسنده = "علی"
    توضیح = "نان تازه"
    کلیدواژه‌ها = "نان, نانوایی"
    رنگ تم = #2563eb
    ربات‌ها = "noindex"
    نشانی اصلی = "https://shop.example/"
    نماد = "/icon.png"
    سرتیتر: اندازه = 1 محتوا = "خوش آمدید" پایان
پایان
