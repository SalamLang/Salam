// انتظار: <p lang="ar" dir="auto">
صفحه:
    عنوان = "Hello"
    زبان = "english"
    جهت = "right to left"
    پاراگراف:
        زبان = "persian"
        جهت = "left to right"
        محتوا = "a"
    پایان
    پاراگراف:
        زبان = "fa-IR"
        جهت = "auto"
        محتوا = "b"
    پایان
    پاراگراف:
        زبان = «عربی»
        جهت = «خودکار»
        محتوا = "c"
    پایان
پایان
