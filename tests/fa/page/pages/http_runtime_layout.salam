// انتظار: صفحه سرو شده
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

صفحه خوشامد(نام: رشته):
    عنوان = "سلام " + نام
    پاراگراف: محتوا = "سلام " + نام پایان
پایان

تابع خانه(زمینه: صحیح۶۴):
    اچ تی تی پی.اچ تی ام ال(زمینه، خوشامد(اچ تی تی پی.پرسمان(زمینه، "name")))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/"، خانه)
    ناپایا س := اچ تی تی پی.سرور جدید(۸۰۸۰)
    اچ تی تی پی.استفاده(س، م)
    اچ تی تی پی.اجرا(س)
پایان

صفحه:
    عنوان = "صفحه سرو شده"
    پاراگراف: محتوا = "صفحه‌ای کنار یک قالب زمان اجرا و بسته‌ی اچ تی تی پی." پایان
پایان
