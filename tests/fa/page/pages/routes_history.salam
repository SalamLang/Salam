// انتظار: <meta name="salam-router" content="history">
// انتظار: function __salam_route_pick(
ناپایا واردشده := نادرست

بخش خانه اصلی:
    سرتیتر: محتوا = "خانه" پایان
پایان

بخش کاربر(شناسه: صحیح):
    سرتیتر: محتوا = "کاربر " + شناسه پایان
    دکمه:
        شناسه = "next"
        کلیک = ():
            برو("/users/" + (شناسه + ۱))
        پایان
        محتوا = "بعدی"
    پایان
پایان

بخش مدیریت:
    پاراگراف: محتوا = "مدیریت" پایان
پایان

بخش ورود:
    دکمه:
        شناسه = "login"
        کلیک = ():
            واردشده = درست
            جایگزین‌کن("/admin")
        پایان
        محتوا = "ورود"
    پایان
پایان

بخش پیدانشد:
    پاراگراف: محتوا = "چیزی نیست: " + مسیر‌کنونی.نشانی پایان
پایان

مسیرها:
    "/" : خانه اصلی عنوان = "خانه"
    "/users/:شناسه" : کاربر
    "/admin" : مدیریت نگهبان = واردشده هدایت = "/login"
    "/login" : ورود
    "*" : پیدانشد
پایان

صفحه:
    عنوان = "مسیریاب"
    ناوبری:
        پیوند: مقصد = "/" محتوا = "خانه" پایان
        پیوند: مقصد = "/users/1" محتوا = "کاربر ۱" پایان
    پایان
    نمای مسیر: پایان
پایان
