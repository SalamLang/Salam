همگانی بخش کاربر(شناسه: صحیح):
    مسیر = "/users/:شناسه"
    سرتیتر: محتوا = "کاربر " + شناسه پایان
    دکمه:
        شناسه = "next"
        کلیک = ():
            صفحه.برو("/users/" + (شناسه + ۱))
        پایان
        محتوا = "بعدی"
    پایان
پایان
