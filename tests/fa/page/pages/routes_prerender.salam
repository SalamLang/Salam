// انتظار: <!--salam:0--><h1>خانه</h1><p id="count">شمار 3</p>
// انتظار: <meta name="salam-router" content="history">
ناپایا شمار := ۳

بخش خانه اصلی:
    سرتیتر: محتوا = "خانه" پایان
    پاراگراف: شناسه = "count" محتوا = "شمار " + شمار پایان
    دکمه: شناسه = "more" کلیک = (): شمار++ پایان محتوا = "بیشتر" پایان
پایان

بخش درباره:
    سرتیتر: محتوا = "درباره‌ی ما" پایان
پایان

مسیرها:
    "/" : خانه اصلی عنوان = "خانه"
    "/about" : درباره عنوان = "درباره"
پایان

صفحه:
    عنوان = "پیش‌ساخت"
    ناوبری:
        پیوند: مقصد = "/" محتوا = "خانه" پایان
        پیوند: مقصد = "/about" محتوا = "درباره" پایان
    پایان
    نمای مسیر: پایان
پایان
