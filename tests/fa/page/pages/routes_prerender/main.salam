// انتظار: <meta name="salam-router" content="history">
ناپایا شمار := ۳

صفحه:
    عنوان = "پیش‌ساخت"
    ناوبری:
        پیوند:
            مقصد = "/"
            محتوا = "خانه"
        پایان
        پیوند:
            مقصد = "/about"
            محتوا = "درباره"
        پایان
    پایان
    نمای مسیر: پایان
پایان
