// انتظار: <div><p>سلام از یک تابع</p></div><!--/salam:0-->
تابع خوشامد(): رشته:
    برگشت "سلام از یک تابع"
پایان

بخش آغازگاه:
    نمونه := خوشامد()
    جعبه:
        پاراگراف: محتوا = نمونه پایان
    پایان
پایان

صفحه:
    عنوان = "محاسبه"
    آغازگاه: پایان
    نمای مسیر: پایان
پایان
