بخش سربرگ‌سایت:
    باز := نادرست
    سرصفحه:
        دکمه:
            محتوا = باز ? "بستن" : "منو"
            کلیک = (): باز = وارونه باز پایان
        پایان
        اگر باز:
            پاراگراف: محتوا = "فهرست باز است" پایان
        پایان
    پایان
پایان

همگانی بخش چیدمان‌سایت:
    جعبه:
        سربرگ‌سایت: پایان
        نمای مسیر: پایان
    پایان
پایان
