بخش میوه(نام: رشته):
    برداشته := نادرست
    دکمه:
        محتوا = برداشته ? "برداشته شد" : نام
        کلیک = (): برداشته = درست پایان
    پایان
پایان

همگانی بخش صفحه‌خانه:
    عنوان = "خانه"
    میوه‌ها := ["سیب", "گلابی"]
    جعبه:
        هر ردیف، یکی در میوه‌ها:
            میوه: کلید = ردیف نام = یکی پایان
        پایان
    پایان
پایان
