بخش کارت(سو: رشته):
    جعبه:
        پس زمینه = پهن ? "#ffffff" : "#eeeeee"
        جهت متن = سو
        پاراگراف: محتوا = "کارت" پایان
    پایان
پایان

همگانی بخش صفحه‌خانه:
    عنوان = "خانه"
    دکمه:
        محتوا = "پهن کن"
        کلیک = (): پهن = درست پایان
    پایان
    کارت: سو = پهن ? "ltr" : "rtl" پایان
پایان
