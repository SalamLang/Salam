همگانی بخش صفحه‌خانه:
    عنوان = "خانه"
    پسندها := 0
    جعبه:
        دکمه:
            محتوا = "پسند " + پسندها
            کلیک = (): پسندها++ پایان
        پایان
    پایان
پایان
