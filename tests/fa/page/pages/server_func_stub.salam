// انتظار پایه: /_salam/fn/
// انتظار پایه: قووتی
// انتظار پایه: salam-server
// انتظار نه: sk-live-do-not-ship
// انتظار نه: vault-only-note
ناپایا کل := 0

تابع واولت نوتی(): رشته:
    برگشت "vault-only-note"
پایان

سرور تابع قووتی(سکو: رشته): صحیح: کلید := "sk-live-do-not-ship"
برگشت کلید.طول() + واولت نوتی().طول() + سکو.طول()
پایان

صفحه:
    سرور = "https://front.example.com"
    جعبه:
        دکمه:
            کلیک = (): کل = قووتی("a1") پایان
            محتوا = "Get"
        پایان
        پاراگراف:
            محتوا = کل
        پایان
    پایان
پایان
