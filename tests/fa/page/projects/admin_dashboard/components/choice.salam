همگانی بخش گزینه(عنوان کوتاه: رشته، فعال: منطقی، انتخاب):
    دکمه:
        کلاس = "choice"
        نوع = "دکمه"
        فاصله = 8، 14
        گردی = 999
        نشانگر = "اشاره"
        کادر = 1، توپر، #cfd5e2
        پس زمینه = #ffffff
        رنگ = #1b2333
        اگر فعال:
            پس زمینه = #2a49d8
            رنگ = #ffffff
            کادر = 1، توپر، #2a49d8
        پایان
        aria pressed = فعال ? "true" : "false"
        کلیک = انتخاب
        محتوا = عنوان کوتاه
    پایان
پایان
