همگانی بخش گزینه نقش(شناسه: صحیح، کد: رشته، عنوان کوتاه: رشته):
    دکمه:
        کلاس = "role-choice"
        نوع = "دکمه"
        فاصله = 8، 14
        گردی = 999
        نشانگر = "اشاره"
        کادر = 1، توپر، #cfd5e2
        پس زمینه = #ffffff
        رنگ = #1b2333
        اگر کاربران[جای کاربر(شناسه)].نقش برابر کد:
            پس زمینه = #2a49d8
            رنگ = #ffffff
            کادر = 1، توپر، #2a49d8
        پایان
        کلیک = ():
            تنظیم نقش کاربر(شناسه، کد)
        پایان
        محتوا = عنوان کوتاه
    پایان
پایان

همگانی بخش کلید فعال بودن(شناسه: صحیح):
    دکمه:
        کلاس = "active-toggle"
        نوع = "دکمه"
        فاصله = 8، 14
        گردی = 999
        نشانگر = "اشاره"
        کادر = 1، توپر، #cfd5e2
        پس زمینه = #ffffff
        رنگ = #1b2333
        اگر کاربران[جای کاربر(شناسه)].فعال:
            پس زمینه = #2a49d8
            رنگ = #ffffff
            کادر = 1، توپر، #2a49d8
        پایان
        کلیک = ():
            وارونه_ کردن فعال بودن(شناسه)
        پایان
        محتوا = کاربران[جای کاربر(شناسه)].فعال ? "حساب فعال است" : "حساب غیرفعال است"
    پایان
پایان
