همگانی بخش سرستون مرتب(عنوان کوتاه: رشته، ستون: رشته):
    دکمه:
        شناسه = "sort-" + ستون
        کادر = 0
        فاصله = 0
        پس زمینه = "شفاف"
        وزن قلم = 700
        اندازه قلم = 13
        رنگ = "#4a5570"
        نشانگر = "اشاره"
        کلیک = ():
            مرتب سازی(ستون)
        پایان
        محتوا = عنوان کوتاه + ((ستون مرتب برابر ستون) ? (صعودی ? " ▲" : " ▼") : "")
    پایان
پایان
