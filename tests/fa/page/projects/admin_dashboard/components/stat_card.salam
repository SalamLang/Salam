همگانی بخش کارت آمار(عنوان کوتاه: رشته، مقدار نشان: رشته، یادداشت: رشته):
    جعبه:
        فاصله = 18
        شکاف = 4
        گردی = 14
        پس زمینه = #ffffff
        کادر = 1، توپر، #e3e7ef
        پاراگراف:
            فضا = 0
            اندازه قلم = 13
            رنگ = #667089
            محتوا = عنوان کوتاه
        پایان
        پاراگراف:
            فضا = 0
            اندازه قلم = 28
            وزن قلم = 800
            محتوا = مقدار نشان
        پایان
        پاراگراف:
            فضا = 0
            اندازه قلم = 13
            رنگ = #1f8a4c
            محتوا = یادداشت
        پایان
    پایان
پایان
