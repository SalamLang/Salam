// انتظار: var __salam_rt_hash = true
// انتظار: function __salam_route_pick(
// انتظار: کنسول مدیریت
واردسازی دام

پایا سقف‌برگه := 5

ناپایا وارد شده := نادرست
ناپایا کاربر جاری := ""
ناپایا ایمیل ورود := ""
ناپایا گذرواژه ورود := ""
ناپایا خطای ورود := ""
ناپایا ستون مرتب := "name"
ناپایا صعودی := درست
ناپایا عبارت جستجو := ""
ناپایا فیلتر نقش := "all"
ناپایا شماره برگه := 0
ناپایا کاربران := کاربران نمونه()
ناپایا جای ذخیره شده := -1

ساختار کاربر:
    همگانی شناسه: صحیح
    همگانی نام: رشته
    همگانی ایمیل: رشته
    همگانی نقش: رشته
    همگانی فعال: منطقی
    همگانی هزینه: صحیح
پایان

تابع ساخت کاربر(شناسه: صحیح، نام: رشته، ایمیل: رشته، نقش: رشته، فعال: منطقی، هزینه: صحیح): کاربر:
    برگشت کاربر {شناسه = شناسه، نام = نام، ایمیل = ایمیل، نقش = نقش، فعال = فعال، هزینه = هزینه}
پایان

تابع کاربران نمونه(): وکتور<کاربر>:
    ناپایا مقدار := وکتور {} برگردان وکتور<کاربر>
    مقدار.افزودن(ساخت کاربر(1، "آدا لاولیس"، "ada@example.com"، "admin"، درست، 4200))
    مقدار.افزودن(ساخت کاربر(2، "گریس هاپر"، "grace@example.com"، "editor"، درست، 1850))
    مقدار.افزودن(ساخت کاربر(3، "آلن تورینگ"، "alan@example.com"، "viewer"، نادرست، 0))
    مقدار.افزودن(ساخت کاربر(4، "لینوس توروالدز"، "linus@example.com"، "editor"، درست، 910))
    مقدار.افزودن(ساخت کاربر(5، "مارگارت همیلتون"، "margaret@example.com"، "admin"، درست، 3100))
    مقدار.افزودن(ساخت کاربر(6، "دنیس ریچی"، "dennis@example.com"، "viewer"، درست، 260))
    مقدار.افزودن(ساخت کاربر(7، "باربارا لیسکوف"، "barbara@example.com"، "editor"، نادرست، 740))
    مقدار.افزودن(ساخت کاربر(8، "کن تامپسون"، "ken@example.com"، "viewer"، درست، 120))
    مقدار.افزودن(ساخت کاربر(9، "رادیا پرلمن"، "radia@example.com"، "editor"، درست، 2380))
    مقدار.افزودن(ساخت کاربر(10، "دونالد کنوث"، "donald@example.com"، "viewer"، درست، 505))
    مقدار.افزودن(ساخت کاربر(11، "فرانسیس آلن"، "frances@example.com"، "admin"، نادرست، 1500))
    مقدار.افزودن(ساخت کاربر(12، "تیم برنرز لی"، "tim@example.com"، "editor"، درست، 1975))
    برگشت مقدار
پایان

ناب تابع جای کاربر(شناسه: صحیح): صحیح:
    تکرار کاربران.طول() در ی:
        اگر کاربران[ی].شناسه برابر شناسه:
            برگشت ی
        پایان
    پایان
    برگشت -1
پایان

تابع ورود به سامانه():
    اگر ایمیل ورود.پیراست().طول() برابر 0 یا گذرواژه ورود.طول() برابر 0:
        خطای ورود = "ایمیل و گذرواژه را وارد کنید."
        برگشت
    پایان
    اگر گذرواژه ورود نابرابر "salam":
        خطای ورود = "گذرواژه درست نیست. سلام را امتحان کنید."
        برگشت
    پایان
    وارد شده = درست
    کاربر جاری = ایمیل ورود.پیراست()
    خطای ورود = ""
    گذرواژه ورود = ""
    صفحه.مسیر.هدایت("/")
پایان

تابع خروج از سامانه():
    وارد شده = نادرست
    کاربر جاری = ""
    صفحه.مسیر.هدایت("/login")
پایان

تابع مقدار ستون(کاربر ورودی_: کاربر، کلید: رشته): رشته:
    اگر کلید برابر "mail":
        برگشت کاربر ورودی_.ایمیل.کوچک()
    وگرنه کلید برابر "role":
        برگشت کاربر ورودی_.نقش
    وگرنه کلید برابر "spend":
        برگشت صفر پیش از عدد(کاربر ورودی_.هزینه)
    پایان
    برگشت کاربر ورودی_.نام.کوچک()
پایان

تابع صفر پیش از عدد(تعداد: صحیح): رشته:
    ناپایا رشته := "" + تعداد
    تا رشته.طول() بزرگتربرابر 9:
        رشته = "0" + رشته
    پایان
    برگشت رشته
پایان

تابع نمایش داده شود(کاربر ورودی_: کاربر): منطقی:
    اگر فیلتر نقش نابرابر "all" و کاربر ورودی_.نقش نابرابر فیلتر نقش:
        برگشت نادرست
    پایان
    عبارت := عبارت جستجو.پیراست().کوچک()
    اگر عبارت.طول() برابر 0:
        برگشت درست
    پایان
    برگشت کاربر ورودی_.نام.کوچک().دربردارد(عبارت) یا کاربر ورودی_.ایمیل.کوچک().دربردارد(عبارت)
پایان

تابع کاربران منطبق(): وکتور<صحیح>:
    ناپایا جای ها := وکتور {} برگردان وکتور<صحیح>
    تکرار کاربران.طول() در ی:
        اگر نمایش داده شود(کاربران[ی]):
            جای ها.افزودن(ی)
        پایان
    پایان
    تعداد := جای ها.طول()
    تکرار تعداد در الف:
        ناپایا بهترین := الف
        تکرار تعداد - الف در ک:
            ب := الف + ک
            کلید الف := مقدار ستون(کاربران[جای ها[بهترین]]، ستون مرتب)
            کلید ب := مقدار ستون(کاربران[جای ها[ب]]، ستون مرتب)
            جلوتر := صعودی ? کلید ب کوچکتر کلید الف : کلید ب بزرگتر کلید الف
            اگر جلوتر:
                بهترین = ب
            پایان
        پایان
        اگر بهترین نابرابر الف:
            موقت := جای ها[الف]
            جای ها[الف] = جای ها[بهترین]
            جای ها[بهترین] = موقت
        پایان
    پایان
    برگشت جای ها
پایان

تابع تعداد برگه ها(): صحیح:
    تعداد := کاربران منطبق().طول()
    اگر تعداد برابر 0:
        برگشت 1
    پایان
    برگشت (تعداد + سقف‌برگه - 1) / سقف‌برگه
پایان

تابع ردیف های برگه(): وکتور<صحیح>:
    همه := کاربران منطبق()
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    آغاز := شماره برگه * سقف‌برگه
    تکرار سقف‌برگه در ک:
        اگر آغاز + ک کوچکتر همه.طول():
            خروجی.افزودن(همه[آغاز + ک])
        پایان
    پایان
    برگشت خروجی
پایان

تابع تنظیم نقش کاربر(شناسه: صحیح، نقش: رشته):
    کاربران[جای کاربر(شناسه)].نقش = نقش
پایان

تابع وارونه_ کردن فعال بودن(شناسه: صحیح):
    جا := جای کاربر(شناسه)
    کاربران[جا].فعال = وارونه کاربران[جا].فعال
پایان

تابع مرتب سازی(کلید: رشته):
    اگر ستون مرتب برابر کلید:
        صعودی = وارونه صعودی
    وگرنه:
        ستون مرتب = کلید
        صعودی = درست
    پایان
    شماره برگه = 0
پایان

تابع تنظیم جستجو(مقدار: رشته):
    عبارت جستجو = مقدار
    شماره برگه = 0
پایان

تابع تنظیم نقش(مقدار: رشته):
    فیلتر نقش = مقدار
    شماره برگه = 0
پایان

تابع برگه قبلی():
    اگر شماره برگه بزرگتر 0:
        شماره برگه--
    پایان
پایان

تابع برگه بعدی():
    اگر شماره برگه کوچکتر تعداد برگه ها() - 1:
        شماره برگه++
    پایان
پایان

تابع جمع هزینه ها(): صحیح:
    ناپایا موقت := 0
    تکرار کاربران.طول() در ی:
        موقت += کاربران[ی].هزینه
    پایان
    برگشت موقت
پایان

تابع تعداد فعال ها(): صحیح:
    ناپایا ج := 0
    تکرار کاربران.طول() در ی:
        اگر کاربران[ی].فعال:
            ج++
        پایان
    پایان
    برگشت ج
پایان

تابع تعداد هر_ نقش(نقش: رشته): صحیح:
    ناپایا ج := 0
    تکرار کاربران.طول() در ی:
        اگر کاربران[ی].نقش برابر نقش:
            ج++
        پایان
    پایان
    برگشت ج
پایان

ناب تابع پول(تعداد: صحیح): رشته:
    برگشت تعداد + " دلار"
پایان

بخش پیوند ناوبری(آدرس: رشته، عنوان کوتاه: رشته):
    پیوند:
        مقصد = آدرس
        فاصله = 10، 14
        گردی = 10
        رنگ = "#c4cad8"
        تزیین متن = "هیچ"
        اشاره:
            پس زمینه = "#20283d"
        پایان
        محتوا = عنوان کوتاه
    پایان
پایان

همگانی بخش ردیف کاربر(جا: صحیح):
    ردیف:
        کلید = کاربران[جا].شناسه
        ستون:
            فاصله = 12، 14
            پیوند:
                مقصد = "/users/" + کاربران[جا].شناسه
                رنگ = "#2a49d8"
                وزن قلم = 600
                تزیین متن = "هیچ"
                محتوا = کاربران[جا].نام
            پایان
        پایان
        ستون:
            فاصله = 12، 14
            محتوا = کاربران[جا].ایمیل
        پایان
        ستون:
            فاصله = 12، 14
            محتوا = کاربران[جا].نقش
        پایان
        ستون:
            فاصله = 12، 14
            تکه:
                فاصله = 2، 10
                گردی = 999
                اندازه قلم = 12
                پس زمینه = کاربران[جا].فعال ? "#dcf5e6" : "#fbe4e4"
                رنگ = کاربران[جا].فعال ? "#14633a" : "#9a2b2b"
                محتوا = کاربران[جا].فعال ? "فعال" : "غیرفعال"
            پایان
        پایان
        ستون:
            فاصله = 12، 14
            ترازمتن = "راست"
            محتوا = پول(کاربران[جا].هزینه)
        پایان
    پایان
پایان

