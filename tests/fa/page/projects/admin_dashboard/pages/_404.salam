همگانی بخش ناپیدا:
    جعبه:
        شکاف = 12
        بیشینه عرض = 480
        فضا = 60، خودکار
        اگر وارد شده:
            سرتیتر:
                اندازه = 1
                محتوا = "صفحه پیدا نشد"
            پایان
            پیوند:
                مقصد = "/"
                محتوا = "بازگشت به نمای کلی"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "ورود لازم است"
            پایان
            پاراگراف:
                محتوا = "این صفحه ویژه کاربران واردشده است."
            پایان
            دکمه:
                شناسه = "gate-login"
                فاصله = 10، 16
                گردی = 10
                کادر = 0
                پس زمینه = "#2a49d8"
                رنگ = "#ffffff"
                کلیک = ():
                    صفحه.مسیر.برو("/login")
                پایان
                محتوا = "رفتن به صفحه ورود"
            پایان
        پایان
    پایان
پایان
