همگانی بخش نمای کلی:
    صفحه.نگهبان(وارد شده)
    عنوان = "نمای کلی"
    جعبه:
        شکاف = 20
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "نمای کلی"
        پایان
        جعبه:
            چیدمان = "شبکه"
            ستون‌ها = repeat(fit, minmax(190px, 1fr))
            شکاف = 16
            کارت آمار:
                عنوان کوتاه = "کاربران"
                مقدار نشان = "" + کاربران.طول()
                یادداشت = تعداد فعال ها() + " فعال"
            پایان
            کارت آمار:
                عنوان کوتاه = "درآمد"
                مقدار نشان = پول(جمع هزینه ها())
                یادداشت = "از ابتدا"
            پایان
            کارت آمار:
                عنوان کوتاه = "مدیران"
                مقدار نشان = "" + تعداد هر_ نقش("admin")
                یادداشت = "دسترسی کامل"
            پایان
            کارت آمار:
                عنوان کوتاه = "ویراستاران"
                مقدار نشان = "" + تعداد هر_ نقش("editor")
                یادداشت = "می تواند منتشر کند"
            پایان
        پایان
        جعبه:
            فاصله = 18
            گردی = 14
            پس زمینه = "#ffffff"
            کادر = 1، توپر، #e3e7ef
            شکاف = 8
            سرتیتر:
                اندازه = 3
                فضا = 0
                محتوا = "پیوندهای سریع"
            پایان
            پیوند:
                مقصد = "/users"
                محتوا = "مدیریت کاربران"
            پایان
        پایان
    پایان
پایان
