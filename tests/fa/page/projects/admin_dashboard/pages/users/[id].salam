بخش ویرایشگر کاربر(شناسه: صحیح):
    اگر جای کاربر(شناسه) کوچکتر 0:
        سرتیتر:
            اندازه = 1
            محتوا = "چنین کاربری نیست"
        پایان
    وگرنه:
        جعبه:
            شکاف = 16
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = کاربران[جای کاربر(شناسه)].نام
            پایان
            فرم:
                شناسه = "edit-form"
                فاصله = 22
                شکاف = 10
                گردی = 14
                پس زمینه = "#ffffff"
                کادر = 1، "توپر"، "#e3e7ef"
                ارسال = (ی: صحیح۶۴):
                    دام.جلوگیری پیش فرض(ی)
                    جای ذخیره شده = جای کاربر(شناسه)
                پایان
                برچسب:
                    برای = "edit-name"
                    وزن قلم = 600
                    محتوا = "نام"
                پایان
                ورودی:
                    شناسه = "edit-name"
                    فاصله = 10، 12
                    گردی = 10
                    کادر = 1، "توپر"، "#cfd5e2"
                    پیوند = کاربران[جای کاربر(شناسه)].نام
                پایان
                برچسب:
                    برای = "edit-mail"
                    وزن قلم = 600
                    محتوا = "ایمیل"
                پایان
                ورودی:
                    شناسه = "edit-mail"
                    نوع = "ایمیل"
                    فاصله = 10، 12
                    گردی = 10
                    کادر = 1، "توپر"، "#cfd5e2"
                    پیوند = کاربران[جای کاربر(شناسه)].ایمیل
                پایان
                پاراگراف:
                    فضا = 0
                    وزن قلم = 600
                    محتوا = "نقش"
                پایان
                جعبه:
                    چیدمان = "ردیف"
                    شکاف = 8
                    گزینه نقش:
                        شناسه = شناسه
                        کد = "admin"
                        عنوان کوتاه = "مدیر"
                    پایان
                    گزینه نقش:
                        شناسه = شناسه
                        کد = "editor"
                        عنوان کوتاه = "ویراستار"
                    پایان
                    گزینه نقش:
                        شناسه = شناسه
                        کد = "viewer"
                        عنوان کوتاه = "بیننده"
                    پایان
                پایان
                کلید فعال بودن:
                    شناسه = شناسه
                پایان
                پاراگراف:
                    شناسه = "saved"
                    فضا = 0
                    کمینه ارتفاع = 20
                    رنگ = "#1f8a4c"
                    محتوا = (جای ذخیره شده برابر جای کاربر(شناسه)) ? "ذخیره شد." : ""
                پایان
                دکمه:
                    شناسه = "save"
                    نوع = "ارسال"
                    فاصله = 12
                    گردی = 10
                    کادر = 0
                    پس زمینه = "#2a49d8"
                    رنگ = "#ffffff"
                    وزن قلم = 700
                    محتوا = "ذخیره تغییرات"
                پایان
            پایان
        پایان
    پایان
پایان

بخش پنل کاربر(شناسه: صحیح):
    جعبه:
        شکاف = 16
        بیشینه عرض = 560
        پیوند:
            مقصد = "/users"
            رنگ = "#2a49d8"
            محتوا = "بازگشت به کاربران"
        پایان
        ویرایشگر کاربر:
            شناسه = شناسه
        پایان
    پایان
پایان

همگانی بخش جزئیات کاربر(شناسه: صحیح):
    صفحه.نگهبان(وارد شده)
    مسیر = "/users/:شناسه"
    عنوان = "جزئیات کاربر"
    پنل کاربر:
        شناسه = شناسه
    پایان
پایان
