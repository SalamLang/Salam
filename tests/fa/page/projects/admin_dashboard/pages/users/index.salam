همگانی بخش فهرست کاربران:
    صفحه.نگهبان(وارد شده)
    عنوان = "کاربران"
    جعبه:
        شکاف = 16
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "کاربران"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 10
            شکستن خط = درست
            ورودی:
                شناسه = "search"
                نوع = "جستجو"
                رشد = 1
                کمینه عرض = 220
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#cfd5e2"
                جانگهدار = "جستجوی نام یا ایمیل"
                مقدار = عبارت جستجو
                ورودی = (مقدار: رشته):
                    تنظیم جستجو(مقدار)
                پایان
            پایان
            گزینه:
                عنوان کوتاه = "همه نقش ها"
                فعال = (فیلتر نقش برابر "all")
                انتخاب = ():
                    تنظیم نقش("all")
                پایان
            پایان
            گزینه:
                عنوان کوتاه = "مدیران"
                فعال = (فیلتر نقش برابر "admin")
                انتخاب = ():
                    تنظیم نقش("admin")
                پایان
            پایان
            گزینه:
                عنوان کوتاه = "ویراستاران"
                فعال = (فیلتر نقش برابر "editor")
                انتخاب = ():
                    تنظیم نقش("editor")
                پایان
            پایان
            گزینه:
                عنوان کوتاه = "بینندگان"
                فعال = (فیلتر نقش برابر "viewer")
                انتخاب = ():
                    تنظیم نقش("viewer")
                پایان
            پایان
        پایان
        جعبه:
            سرریز = "خودکار"
            گردی = 14
            پس زمینه = "#ffffff"
            کادر = 1، "توپر"، "#e3e7ef"
            جدول:
                عرض = 100%
                سرصفحه:
                    ردیف:
                        ستون:
                            سرستون = درست
                            فاصله = 12، 14
                            ترازمتن = "چپ"
                            سرستون مرتب:
                                عنوان کوتاه = "نام"
                                ستون = "name"
                            پایان
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 12، 14
                            ترازمتن = "چپ"
                            سرستون مرتب:
                                عنوان کوتاه = "ایمیل"
                                ستون = "mail"
                            پایان
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 12، 14
                            ترازمتن = "چپ"
                            سرستون مرتب:
                                عنوان کوتاه = "نقش"
                                ستون = "role"
                            پایان
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 12، 14
                            ترازمتن = "چپ"
                            محتوا = "وضعیت"
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 12، 14
                            ترازمتن = "راست"
                            سرستون مرتب:
                                عنوان کوتاه = "هزینه"
                                ستون = "spend"
                            پایان
                        پایان
                    پایان
                پایان
                اصلی:
                    هر _، جا در ردیف های برگه():
                        ردیف کاربر:
                            کلید = کاربران[جا].شناسه
                            جا = جا
                        پایان
                    پایان
                پایان
            پایان
            اگر کاربران منطبق().طول() برابر 0:
                پاراگراف:
                    شناسه = "empty"
                    فاصله = 20
                    رنگ = "#667089"
                    محتوا = "کاربری پیدا نشد."
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            تراز = "وسط"
            چینش = "میان"
            پاراگراف:
                شناسه = "count"
                فضا = 0
                رنگ = "#667089"
                محتوا = کاربران منطبق().طول() + " کاربر، صفحه " + (شماره برگه + 1) + " از " + تعداد برگه ها()
            پایان
            جعبه:
                چیدمان = "ردیف"
                شکاف = 8
                دکمه:
                    شناسه = "prev"
                    فاصله = 8، 14
                    گردی = 8
                    کادر = 1، "توپر"، "#cfd5e2"
                    پس زمینه = "#ffffff"
                    اگر شماره برگه برابر 0:
                        شفافیت = 0.4
                    پایان
                    aria disabled = (شماره برگه برابر 0) ? "true" : "false"
                    کلیک = برگه قبلی
                    محتوا = "قبلی"
                پایان
                دکمه:
                    شناسه = "next"
                    فاصله = 8، 14
                    گردی = 8
                    کادر = 1، "توپر"، "#cfd5e2"
                    پس زمینه = "#ffffff"
                    اگر شماره برگه بزرگتربرابر تعداد برگه ها() - 1:
                        شفافیت = 0.4
                    پایان
                    aria disabled = (شماره برگه بزرگتربرابر تعداد برگه ها() - 1) ? "true" : "false"
                    کلیک = برگه بعدی
                    محتوا = "بعدی"
                پایان
            پایان
        پایان
    پایان
پایان
