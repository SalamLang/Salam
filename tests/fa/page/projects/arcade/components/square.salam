همگانی بخش مربع(بازی: صحیح، خانه: صحیح، نماد: رشته، رنگ: صحیح):
    دکمه:
        کلاس = "square"
        نسبت ابعاد = 1
        کمینه عرض = 0
        اندازه قلم = 28
        وزن قلم = 700
        گردی = 10
        کادر = 0
        پس زمینه = #2a3045
        رنگ = #e8ebf4
        نشانگر = "اشاره"
        اگر رنگ برابر 1:
            پس زمینه = #3b4466
        پایان
        اگر رنگ برابر 2:
            پس زمینه = #2f9e6e
            رنگ = #ffffff
        پایان
        اگر رنگ برابر 3:
            پس زمینه = #d64550
            رنگ = #ffffff
        پایان
        اگر رنگ برابر 4:
            پس زمینه = #d9a441
            رنگ = #1c2030
        پایان
        کلیک = ():
            فشردن(بازی، خانه)
        پایان
        محتوا = نماد
    پایان
پایان
