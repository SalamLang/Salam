همگانی بخش نوار‌وضعیت(پیام: رشته، جزئیات: رشته، خوب: منطقی):
    جعبه:
        چیدمان = ردیف
        تراز = وسط
        چینش = میان
        فاصله = 10، 14
        گردی = 10
        پس زمینه = #1c2030
        پاراگراف:
            کلاس = "status"
            فضا = 0
            وزن قلم = 700
            اگر خوب:
                رنگ = #7ee2a8
            پایان
            محتوا = پیام
        پایان
        ریز:
            کلاس = "detail"
            شفافیت = 0.75
            محتوا = جزئیات
        پایان
    پایان
پایان
