// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش حافظه:
    عنوان = "حافظه"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "حافظه"
        پایان
        نوار‌وضعیت:
            پیام = برد‌حافظه() ? "همه جفت‌ها پیدا شد" : "جفت‌ها را پیدا کنید"
            جزئیات = "برگردان: " + برگردان‌ها + (بهترین‌برگردان بزرگتر 0 ? "، بهترین " + بهترین‌برگردان : "")
            خوب = برد‌حافظه()
        پایان
        جعبه:
            چیدمان = "شبکه"
            چندستونی = 4
            شکاف = 10
            هر ش، کارت در خانه‌های۱۲:
                مربع:
                    کلید = ش
                    بازی = 0
                    خانه = کارت
                    نماد = (رویه‌ها[کارت] برابر 0) ? "?" : نماد‌کارت(دسته‌کارت[کارت])
                    رنگ = رویه‌ها[کارت]
                پایان
            پایان
        پایان
        دکمه:
            شناسه = "again-memory"
            فاصله = 10، 20
            گردی = 10
            کادر = 0
            پس زمینه = "#ffd166"
            رنگ = "#1c2030"
            وزن قلم = 700
            نشانگر = "اشاره"
            کلیک = حافظه‌تازه
            محتوا = "بُر زدن و شروع دوباره"
        پایان
    پایان
پایان
