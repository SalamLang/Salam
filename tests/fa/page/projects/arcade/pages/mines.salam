همگانی بخش مین‌ها:
    عنوان = "مین‌یاب"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "مین‌یاب"
        پایان
        نوار‌وضعیت:
            پیام = انفجار ? "بوم! یک مین منفجر شد" : (برد‌مین() ? "میدان پاک شد" : "خانه‌های امن را باز کنید")
            جزئیات = "پرچم‌های مانده: " + پرچم‌مانده()
            خوب = برد‌مین()
        پایان
        جعبه:
            چیدمان = "شبکه"
            چندستونی = 6
            شکاف = 6
            هر خانه در خانه‌های۳۶:
                مربع:
                    بازی = 2
                    خانه = خانه
                    نماد = نماد‌مین(خانه)
                    رنگ = رنگ‌مین(خانه)
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 14
            دکمه:
                شناسه = "again-mines"
                فاصله = 10، 20
                گردی = 10
                کادر = 0
                پس زمینه = "#ffd166"
                رنگ = "#1c2030"
                وزن قلم = 700
                نشانگر = "اشاره"
                کلیک = مین‌تازه
                محتوا = "میدان تازه"
            پایان
            برچسب:
                چیدمان = "ردیف"
                تراز = "وسط"
                شکاف = 8
                ورودی:
                    شناسه = "flagging"
                    نوع = "تیک"
                    پیوند = حالت‌پرچم
                پایان
                تکه:
                    محتوا = "حالت پرچم (کلید f)"
                پایان
            پایان
        پایان
    پایان
پایان
