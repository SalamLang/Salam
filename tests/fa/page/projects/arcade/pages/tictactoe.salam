همگانی بخش دوز:
    عنوان = "دوز"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "دوز"
        پایان
        نوار‌وضعیت:
            پیام = وضعیت‌دوز()
            جزئیات = "ایکس " + برد‌ایکس + "  او " + برد‌او + "  مساوی " + مساوی‌ها
            خوب = دوز‌تمام()
        پایان
        جعبه:
            چیدمان = "شبکه"
            چندستونی = 3
            شکاف = 10
            هر ش، خانه در خانه‌های۹:
                مربع:
                    کلید = ش
                    بازی = 1
                    خانه = خانه
                    نماد = متن‌نشان(صفحه‌بازی[خانه])
                    رنگ = (صفحه‌بازی[خانه] برابر 0) ? 0 : 1
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 14
            دکمه:
                شناسه = "again-ttt"
                فاصله = 10، 20
                گردی = 10
                کادر = 0
                پس زمینه = "#ffd166"
                رنگ = "#1c2030"
                وزن قلم = 700
                نشانگر = "اشاره"
                کلیک = دور‌تازه
                محتوا = "دور تازه"
            پایان
            برچسب:
                چیدمان = "ردیف"
                تراز = "وسط"
                شکاف = 8
                ورودی:
                    شناسه = "cpu"
                    نوع = "تیک"
                    پیوند = برابر‌رایانه
                پایان
                تکه:
                    محتوا = "بازی با رایانه"
                پایان
            پایان
        پایان
        ریز:
            شفافیت = 0.7
            محتوا = "کلیدهای ۱ تا ۹ نشانه می‌گذارند."
        پایان
    پایان
پایان
