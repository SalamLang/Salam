همگانی بخش کارت‌نوشته(نامک: رشته، عنوان: رشته، چکیده: رشته، موضوع: رشته، تاریخ: رشته، دقیقه: صحیح):
    مقاله:
        فاصله = 18، 20
        گردی = 14
        پس زمینه = رنگ کارت()
        کادر = 1، توپر، رنگ خط()
        شکاف = 6
        گذار = 160ms
        اشاره:
            جابه‌جایی = 0، -2
        پایان
        جعبه:
            چیدمان = ردیف
            شکاف = 10
            تراز = وسط
            رنگ = رنگ کمرنگ()
            خانواده قلم = "Vazirmatn, Tahoma, sans-serif"
            اندازه قلم = 13
            پیوند:
                مقصد = "/tag/" + موضوع
                رنگ = رنگ تاکید()
                تزیین متن = هیچ
                وزن قلم = 600
                محتوا = موضوع
            پایان
            تکه:
                محتوا = تاریخ
            پایان
            تکه:
                کلاس = "minutes"
                محتوا = دقیقه + " دقیقه مطالعه"
            پایان
        پایان
        h2:
            فضا = 0
            اندازه قلم = 22
            پیوند:
                مقصد = "/post/" + نامک
                رنگ = رنگ نوشتار()
                تزیین متن = هیچ
                محتوا = عنوان
            پایان
        پایان
        پاراگراف:
            فضا = 0
            رنگ = رنگ کمرنگ()
            محتوا = چکیده
        پایان
    پایان
پایان
