همگانی بخش سربرگ‌سایت:
    سرصفحه:
        چیدمان = "ردیف"
        تراز = "وسط"
        چینش = "میان"
        شکستن خط = درست
        شکاف = 12
        فاصله = 16، 24
        پس زمینه = رنگ کارت()
        کادر پایین = 1، توپر، رنگ خط()
        پیوند:
            مقصد = "/"
            اندازه قلم = 22
            وزن قلم = 700
            رنگ = رنگ تاکید()
            تزیین متن = "هیچ"
            محتوا = "یادداشت‌های میدانی"
        پایان
        ناوبری:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 18
            خانواده قلم = "Vazirmatn, Tahoma, sans-serif"
            اندازه قلم = 15
            پیوند:
                مقصد = "/"
                رنگ = رنگ نوشتار()
                تزیین متن = "هیچ"
                محتوا = "نوشته‌ها"
            پایان
            پیوند:
                مقصد = "/about"
                رنگ = رنگ نوشتار()
                تزیین متن = "هیچ"
                محتوا = "درباره"
            پایان
            دکمه:
                شناسه = "theme"
                فاصله = 6، 12
                گردی = 999
                کادر = 1، توپر، رنگ خط()
                پس زمینه = "#00000000"
                رنگ = رنگ نوشتار()
                نشانگر = "اشاره"
                کلیک = (): تیره = وارونه تیره پایان
                محتوا = برچسب پوسته()
            پایان
        پایان
    پایان
پایان
