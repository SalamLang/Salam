همگانی بخش تراشه‌موضوع(برچسب: رشته، فعال: منطقی):
    دکمه:
        فاصله = 4، 12
        گردی = 999
        کادر = 1، توپر، رنگ خط()
        پس زمینه = #00000000
        رنگ = رنگ کمرنگ()
        خانواده قلم = "Vazirmatn, Tahoma, sans-serif"
        اندازه قلم = 14
        نشانگر = "اشاره"
        اگر فعال:
            پس زمینه = رنگ تاکید()
            کادر = 1، توپر، رنگ تاکید()
            رنگ = #ffffff
        پایان
        کلیک = (): موضوع فعال = برچسب برابر "همه" ? "" : برچسب پایان
        محتوا = برچسب
    پایان
پایان
