// انتظار: var __salam_rt_hash = true
// انتظار: یادداشت‌های میدانی
// انتظار نه: <meta name="salam-router"
پایا کلمه‌در‌دقیقه := 60

ناپایا تیره := نادرست
ناپایا کلیدواژه := ""
ناپایا موضوع فعال := ""

ساختار نوشته:
    همگانی نامک: رشته
    همگانی عنوان: رشته
    همگانی موضوع: رشته
    همگانی تاریخ: رشته
    همگانی چکیده: رشته
    همگانی متن: رشته
پایان

تابع نوشته‌ها(): وکتور<نوشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<نوشته>
    و_.افزودن(نوشته {
        نامک = "slow-mornings"
        عنوان = "ستایش صبح‌های آرام"
        موضوع = "زندگی"
        تاریخ = "2026-03-02"
        چکیده = "چرا ساعت اول روز بدون صفحه‌ی نمایش بهتر است."
        متن = "من قبلا پیش از آن که چشم‌هایم کامل باز شود سراغ گوشی می‌رفتم. حالا گوشی در اتاق دیگری می‌ماند تا چای دم کنم و کمی از پنجره بیرون را تماشا کنم. اتفاق بزرگی نیفتاد. فقط دیدم روز آرام‌تر شروع می‌شود و نگرانی‌های کوچک صبح، وقتی با یک استکان چای داغ در دست به سراغشان می‌روم، کوچک‌تر به نظر می‌رسند."
    })
    و_.افزودن(نوشته {
        نامک = "salam-first-page"
        عنوان = "اولین صفحه‌ام با سلام"
        موضوع = "برنامه‌نویسی"
        تاریخ = "2026-03-19"
        چکیده = "صفحه چند خط متن است که شبیه چیزی است که می‌سازد."
        متن = "صفحه در سلام مثل یک طرح کلی خوانده می‌شود. یک جعبه می‌نویسی، سرتیتری در آن می‌گذاری و به سرتیتر اندازه و چند کلمه می‌دهی. زبان قالب‌ساز تازه‌ای برای یادگیری نیست و مرحله‌ی ساخت پیچیده‌ای هم نیست. وقتی صفحه باید چیزی را به خاطر می‌سپرد، یک متغیر بالای فایل گذاشتم و هر جا که از آن استفاده می‌شد خودبه‌خود تازه شد. همان لحظه برایم جا افتاد و زبانه‌ی ویرایشگر دیگر را برای همیشه بستم."
    })
    و_.افزودن(نوشته {
        نامک = "market-lunch"
        عنوان = "ناهاری در بازار جمعه"
        موضوع = "غذا"
        تاریخ = "2026-04-07"
        چکیده = "نان، سبزی و غریبه‌ای که دستورش را بخشید."
        متن = "غرفه فقط یک میز بود با یک اجاق کوچک و دسته‌ای نان زیر پارچه. زنی که پشت میز بود توی هر نان سبزی، کمی پنیر و یک قاشق پیازچه‌ی ترشی می‌گذاشت. وقتی پرسیدم پیاز را چطور درست کرده، همه‌چیز را گفت: سرکه، یک پیمانه شکر و سه روز صبر. با یک شیشه از ترشی‌اش به خانه رفتم و همان شب امتحان کردم. دفعه‌ی اول خیلی ترش شد. دفعه‌ی دوم تقریبا درست بود. دفعه‌ی سوم فهمیدم چرا موقع پرسیدنم لبخند زد."
    })
    و_.افزودن(نوشته {
        نامک = "train-to-the-coast"
        عنوان = "قطار کند ساحل"
        موضوع = "زندگی"
        تاریخ = "2026-05-14"
        چکیده = "شش ساعت، یک صندلی کنار پنجره و هیچ برنامه‌ای."
        متن = "قطاری هست که شش ساعت طول می‌کشد تا به دریا برسد و اتوبوسی که سه ساعت. من قطار را انتخاب کردم. جایی بعد از تونل دوم دست از نگاه کردن به ساعت کشیدم و شروع کردم به شمردن باغ‌ها. از کنار مدرسه‌ای با درهای باز گذشتیم، از مزرعه‌ای آفتابگردان که همه به سمت اشتباه نگاه می‌کردند و از مردی که برای هر واگن دست تکان می‌داد انگار ما را می‌شناخت. رسیدن تقریبا ناامیدکننده بود، چون تازه به حرکت عادت کرده بودم."
    })
    و_.افزودن(نوشته {
        نامک = "state-without-fear"
        عنوان = "حالت بدون ترس"
        موضوع = "برنامه‌نویسی"
        تاریخ = "2026-06-01"
        چکیده = "حقیقت را در چند متغیر نگه دار و همه‌چیز را از آن بساز."
        متن = "بیشتر خطاهای برنامه‌های کوچک از دو نسخه‌ی یک واقعیت می‌آید. شمارنده‌ای در یک متغیر و شمارنده‌ای در یک برچسب که کسی فراموش کرده تازه‌اش کند. درمان این است که واقعیت را یک جا نگه داری و صفحه را تابعی از آن بنویسی. در سلام فهرست صفحه فقط یک هر روی یک وکتور است، فیلتر یک شرط است و شماره‌ی بالای صفحه یک فراخوانی است. وکتور را عوض کن تا بقیه خودبه‌خود بیایند. دیگر کدی نمی‌نویسم که چیزی را دوباره بکشد."
    })
    و_.افزودن(نوشته {
        نامک = "lentil-soup"
        عنوان = "تنها سوپ عدسی که لازم داری"
        موضوع = "غذا"
        تاریخ = "2026-06-22"
        چکیده = "یک قابلمه، ده دقیقه خرد کردن و غذای یک هفته."
        متن = "یک پیاز خرد شده را در روغن سرخ کن تا طلایی شود، بعد یک قاشق زیره و دو هویج رنده‌شده اضافه کن. یک پیمانه عدس قرمز و چهار پیمانه آب بریز و بگذار بیست دقیقه آرام بجوشد. نیمی را با غذاساز نرم کن، نیم دیگر را درشت بگذار و آخر سر آب لیمو و فلفل سیاه فراوان بزن. فردایش خوش‌مزه‌تر است و همین دلیل خوبی است که زیاد درست کنی."
    })
    برگشت و_
پایان

تابع موضوع‌ها(): وکتور<رشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<رشته>
    و_.افزودن("زندگی")
    و_.افزودن("برنامه‌نویسی")
    و_.افزودن("غذا")
    برگشت و_
پایان

تابع شمار کلمه(متن: رشته): صحیح:
    برگشت متن.پیراست().بشکاف(" ").طول()
پایان

تابع زمان مطالعه(ا: نوشته): صحیح:
    برگشت (شمار کلمه(ا.متن) + کلمه‌در‌دقیقه - 1) / کلمه‌در‌دقیقه
پایان

تابع قابل نمایش(ا: نوشته): منطقی:
    اگر موضوع فعال.طول() بزرگتر 0 و ا.موضوع نابرابر موضوع فعال:
        برگشت نادرست
    پایان
    اگر کلیدواژه.طول() برابر 0:
        برگشت درست
    پایان
    عبارت := کلیدواژه
    برگشت ا.عنوان.دربردارد(عبارت) یا ا.چکیده.دربردارد(عبارت)
پایان

تابع شمار نمایش(): صحیح:
    ناپایا ن := 0
    هر ا در نوشته‌ها():
        اگر قابل نمایش(ا):
            ن++
        پایان
    پایان
    برگشت ن
پایان

تابع یافتن نوشته(نامک: رشته): صحیح:
    تکرار نوشته‌ها().طول() در ی:
        اگر نوشته‌ها().بگیر(ی).نامک برابر نامک:
            برگشت ی
        پایان
    پایان
    برگشت -1
پایان

تابع رنگ صفحه(): رشته:
    اگر تیره:
        برگشت "#14161a"
    پایان
    برگشت "#faf8f4"
پایان

تابع رنگ نوشتار(): رشته:
    اگر تیره:
        برگشت "#e8e6e1"
    پایان
    برگشت "#24211c"
پایان

تابع رنگ کارت(): رشته:
    اگر تیره:
        برگشت "#1d2026"
    پایان
    برگشت "#ffffff"
پایان

تابع رنگ خط(): رشته:
    اگر تیره:
        برگشت "#2e323a"
    پایان
    برگشت "#e6e1d8"
پایان

تابع رنگ کمرنگ(): رشته:
    اگر تیره:
        برگشت "#9a9a94"
    پایان
    برگشت "#7a7468"
پایان

تابع رنگ تاکید(): رشته:
    اگر تیره:
        برگشت "#f0a35c"
    پایان
    برگشت "#b4531b"
پایان

تابع برچسب پوسته(): رشته:
    اگر تیره:
        برگشت "حالت روشن"
    پایان
    برگشت "حالت تاریک"
پایان

صفحه:
    حالت = "هش"
    عنوان = "یادداشت‌های میدانی"
    زبان = "fa"
    قلم = "Vazirmatn, Tahoma, serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = رنگ صفحه()
        رنگ = رنگ نوشتار()
        ارتفاع خط = 1.7
        گذار = 200ms
        سربرگ‌سایت: پایان
        اصلی:
            بیشینه عرض = 760
            فضا = 0، "خودکار"
            فاصله = 32، 20
            نمای مسیر: پایان
        پایان
        پاورقی:
            فاصله = 24، 20
            ترازمتن = "وسط"
            رنگ = رنگ کمرنگ()
            اندازه قلم = 14
            محتوا = "یادداشت‌های میدانی، نوشته‌شده با سلام"
        پایان
    پایان
پایان
