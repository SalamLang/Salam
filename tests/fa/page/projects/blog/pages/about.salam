همگانی بخش ابووت:
    عنوان = "درباره"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "درباره‌ی یادداشت‌های میدانی"
        پایان
        پاراگراف:
            محتوا = "یادداشت‌های میدانی یک وبلاگ شخصی کوچک است درباره‌ی روزهای آرام، غذای ساده و کدی که همین صفحه را می‌چرخاند."
        پایان
        پاراگراف:
            محتوا = "این یک برنامه‌ی تک‌صفحه‌ای است: هر نوشته یک مسیر دارد، کادر جستجو هنگام تایپ فیلتر می‌کند و کلید حالت تاریک رنگ همه‌ی بخش‌ها را با هم عوض می‌کند."
        پایان
        پاراگراف:
            رنگ = رنگ کمرنگ()
            محتوا = "فقط با زبان صفحه‌ی سلام نوشته شده است."
        پایان
    پایان
پایان
