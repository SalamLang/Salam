همگانی بخش خانه:
    عنوان = "یادداشت‌های میدانی"
    جعبه:
        شکاف = 18
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "تازه‌ترین نوشته‌ها"
        پایان
        ورودی:
            شناسه = "search"
            نوع = "جستجو"
            فاصله = 10، 14
            گردی = 12
            کادر = 1، توپر، رنگ خط()
            پس زمینه = رنگ کارت()
            رنگ = رنگ نوشتار()
            اندازه قلم = 16
            جانگهدار = "جستجو در نوشته‌ها"
            برچسب دسترسی‌پذیری = "جستجو در نوشته‌ها"
            پیوند = کلیدواژه
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 8
            تراشه‌موضوع:
                برچسب = "همه"
                فعال = (موضوع فعال.طول() برابر 0)
            پایان
            هر ش، ت در موضوع‌ها():
                تراشه‌موضوع:
                    کلید = ش
                    برچسب = ت
                    فعال = (موضوع فعال برابر ت)
                پایان
            پایان
        پایان
        پاراگراف:
            شناسه = "count"
            فضا = 0
            رنگ = رنگ کمرنگ()
            محتوا = شمار نمایش() + " از " + نوشته‌ها().طول() + " نوشته"
        پایان
        هر ش، ا در نوشته‌ها():
            اگر قابل نمایش(ا):
                کارت‌نوشته:
                    کلید = ش
                    نامک = ا.نامک
                    عنوان = ا.عنوان
                    چکیده = ا.چکیده
                    موضوع = ا.موضوع
                    تاریخ = ا.تاریخ
                    دقیقه = زمان مطالعه(ا)
                پایان
            پایان
        پایان
        اگر شمار نمایش() برابر 0:
            پاراگراف:
                شناسه = "empty"
                رنگ = رنگ کمرنگ()
                محتوا = "چیزی با این جستجو پیدا نشد."
            پایان
        پایان
    پایان
پایان
