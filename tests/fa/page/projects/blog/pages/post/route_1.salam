همگانی بخش صفحه‌نوشته(نامک: رشته):
    مسیر = "/post/:نامک"
    جا := یافتن نوشته(نامک)
    جعبه:
        شکاف = 14
        اگر جا بزرگتربرابر 0:
            پیوند:
                مقصد = "/"
                رنگ = رنگ تاکید()
                تزیین متن = "هیچ"
                محتوا = "بازگشت به همه‌ی نوشته‌ها"
            پایان
            سرتیتر:
                اندازه = 1
                فضا = 0
                ارتفاع خط = 1.2
                محتوا = نوشته‌ها()[جا].عنوان
            پایان
            جعبه:
                چیدمان = "ردیف"
                شکاف = 12
                تراز = "وسط"
                رنگ = رنگ کمرنگ()
                قلم = "Vazirmatn, Tahoma, sans-serif"
                اندازه قلم = 14
                پیوند:
                    مقصد = "/tag/" + نوشته‌ها()[جا].موضوع
                    رنگ = رنگ تاکید()
                    تزیین متن = "هیچ"
                    وزن قلم = 600
                    محتوا = نوشته‌ها()[جا].موضوع
                پایان
                زمان:
                    زمان دقیق = نوشته‌ها()[جا].تاریخ
                    محتوا = نوشته‌ها()[جا].تاریخ
                پایان
                تکه:
                    شناسه = "minutes"
                    محتوا = زمان مطالعه(نوشته‌ها()[جا]) + " دقیقه مطالعه"
                پایان
            پایان
            پاراگراف:
                اندازه قلم = 19
                ارتفاع خط = 1.8
                محتوا = نوشته‌ها()[جا].متن
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین نوشته‌ای نیست"
            پایان
            پیوند:
                مقصد = "/"
                رنگ = رنگ تاکید()
                محتوا = "بازگشت به همه‌ی نوشته‌ها"
            پایان
        پایان
    پایان
پایان
