همگانی بخش صفحه‌موضوع(نام: رشته):
    مسیر = "/tag/:نام"
    عنوان = "نوشته‌های موضوع " + نام
    جعبه:
        شکاف = 18
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "نوشته‌های موضوع " + نام
        پایان
        هر _، ا در نوشته‌ها():
            اگر ا.موضوع برابر نام:
                کارت‌نوشته:
                    نامک = ا.نامک
                    عنوان = ا.عنوان
                    چکیده = ا.چکیده
                    موضوع = ا.موضوع
                    تاریخ = ا.تاریخ
                    دقیقه = زمان مطالعه(ا)
                پایان
            پایان
        پایان
        پیوند:
            مقصد = "/"
            رنگ = رنگ تاکید()
            تزیین متن = "هیچ"
            محتوا = "همه‌ی نوشته‌ها"
        پایان
    پایان
پایان
