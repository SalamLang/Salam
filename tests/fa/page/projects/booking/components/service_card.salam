همگانی بخش کارت خدمت(جا: صحیح):
    دکمه:
        کلاس = "service"
        رشد = 1
        پایه = 0
        کمینه عرض = 220
        فاصله = 20
        شکاف = 6
        گردی = 16
        ترازمتن = چپ
        نشانگر = اشاره
        پس زمینه = #ffffff
        کادر = 2، توپر، #d4e6e6
        اشاره:
            کادر = 2، توپر، #0d6b6b
        پایان
        اگر خدمت برابر جا:
            کادر = 2، توپر، #0d6b6b
            پس زمینه = #e4f3f3
        پایان
        کلیک = ():
            انتخاب خدمت(جا)
        پایان
        قوی:
            اندازه قلم = 17
            محتوا = نام خدمت(جا)
        پایان
        تکه:
            رنگ = #4f6d72
            محتوا = دقیقه خدمت(جا) + " دقیقه"
        پایان
        تکه:
            اندازه قلم = 22
            وزن قلم = 800
            رنگ = #0d6b6b
            محتوا = "" + بهای خدمت(جا) + " دلار"
        پایان
    پایان
پایان
