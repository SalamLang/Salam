همگانی بخش دکمه ساعت(ساعت: رشته):
    دکمه:
        کلاس = "slot"
        فاصله = 10، 0
        گردی = 10
        نشانگر = اشاره
        کادر = 1، توپر، #b9d5d5
        پس زمینه = #ffffff
        رنگ = #123036
        aria disabled = گرفته شده است(روز انتخابی، ساعت) ? "true" : "false"
        اگر گرفته شده است(روز انتخابی، ساعت):
            پس زمینه = #e6eded
            رنگ = #9ab0b3
            نشانگر = وارونه اللووید
        پایان
        اگر ساعت انتخابی برابر ساعت:
            پس زمینه = #0d6b6b
            رنگ = #ffffff
            کادر = 1، توپر، #0d6b6b
        پایان
        کلیک = ():
            انتخاب ساعت(ساعت)
        پایان
        محتوا = ساعت
    پایان
پایان

همگانی بخش تراشه روز(فاصله: صحیح):
    دکمه:
        کلاس = "day"
        فاصله = 10، 14
        گردی = 12
        شکاف = 2
        ترازمتن = "وسط"
        نشانگر = "اشاره"
        کادر = 1، توپر، #b9d5d5
        پس زمینه = #ffffff
        رنگ = #123036
        اگر روز انتخابی برابر فاصله:
            پس زمینه = #0d6b6b
            رنگ = #ffffff
        پایان
        کلیک = ():
            انتخاب روز(فاصله)
        پایان
        ریز:
            محتوا = نام روز هفته(فاصله)
        پایان
        قوی:
            محتوا = شماره روز(فاصله)
        پایان
    پایان
پایان
