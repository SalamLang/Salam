// انتظار: var __salam_rt_hash = true
// انتظار: function __salam_route_pick(
// انتظار: آبشار آرام
واردسازی دام
واردسازی رشته
واردسازی تقویم

پایا سال‌مبنا := 2026
پایا ماه‌مبنا := 11
پایا روز‌مبنا := 24

ناپایا خدمت := 0 - 1
ناپایا روز انتخابی := 0
ناپایا ساعت انتخابی := ""
ناپایا مهمان := ""
ناپایا ایمیل := ""
ناپایا تلاش_ شد := نادرست
ناپایا رزروها := وکتور {} برگردان وکتور<رزرو>

ساختار رزرو:
    همگانی خدمت: صحیح
    همگانی روز رزرو: صحیح
    همگانی ساعت انتخابی: رشته
    همگانی مهمان: رشته
پایان

تابع نام خدمت(ی: صحیح): رشته:
    اگر ی برابر 0:
        برگشت "ماساژ عمیق"
    وگرنه ی برابر 1:
        برگشت "پاکسازی پوست"
    وگرنه ی برابر 2:
        برگشت "سونا و بخار"
    پایان
    برگشت "هیچ"
پایان

تابع دقیقه خدمت(ی: صحیح): صحیح:
    اگر ی برابر 0:
        برگشت 60
    وگرنه ی برابر 1:
        برگشت 45
    وگرنه ی برابر 2:
        برگشت 90
    پایان
    برگشت 0
پایان

تابع بهای خدمت(ی: صحیح): صحیح:
    اگر ی برابر 0:
        برگشت 95
    وگرنه ی برابر 1:
        برگشت 70
    وگرنه ی برابر 2:
        برگشت 40
    پایان
    برگشت 0
پایان

تابع ساعت خانه(ک: صحیح): رشته:
    ساعت عدد := 9 + ک / 2
    دقیقه := ک % 2 برابر 0 ? "00" : "30"
    برگشت (ساعت عدد کوچکتر 10 ? "0" : "") + ساعت عدد + ":" + دقیقه
پایان

تابع شماره روز جولیانی(فاصله: صحیح): صحیح۶۴:
    مبنا := تقویم.میلادی به روز ژولیانی(تقویم.تاریخ میلادی {سال = سال‌مبنا، ماه = ماه‌مبنا، روز = روز‌مبنا})
    برگشت مبنا + فاصله
پایان

تابع نام روز هفته(فاصله: صحیح): رشته:
    برگشت تقویم.نام روز هفته فارسی(تقویم.روز هفته(شماره روز جولیانی(فاصله)))
پایان

تابع نام ماه(دقیقه: صحیح): رشته:
    نام ها := [""، "ژانویه"، "فوریه"، "مارس"، "آوریل"، "مه"، "ژوئن"، "ژوئیه"، "اوت"، "سپتامبر"، "اکتبر"، "نوامبر"، "دسامبر"]
    برگشت نام ها[دقیقه]
پایان

تابع شماره روز(فاصله: صحیح): رشته:
    ج := تقویم.روز ژولیانی به جلالی(شماره روز جولیانی(فاصله))
    برگشت رشته.به رقم فارسی("" + ج.روز)
پایان

تابع برچسب روز(فاصله: صحیح): رشته:
    ج := تقویم.روز ژولیانی به جلالی(شماره روز جولیانی(فاصله))
    برگشت نام روز هفته(فاصله) + " " + رشته.به رقم فارسی("" + ج.روز) + " " + تقویم.نام ماه جلالی(ج.ماه)
پایان

تابع گرفته شده است(فاصله: صحیح، زمان: رشته): منطقی:
    تکرار رزروها.طول() در ی:
        اگر رزروها[ی].روز رزرو برابر فاصله و رزروها[ی].ساعت انتخابی برابر زمان:
            برگشت درست
        پایان
    پایان
    برگشت نادرست
پایان

تابع تعداد آزاد(فاصله: صحیح): صحیح:
    ناپایا باقی := 0
    تکرار 16 در ک:
        اگر وارونه گرفته شده است(فاصله، ساعت خانه(ک)):
            باقی++
        پایان
    پایان
    برگشت باقی
پایان

تابع انتخاب خدمت(ی: صحیح):
    خدمت = ی
    ساعت انتخابی = ""
    صفحه.مسیر.برو("/time")
پایان

تابع انتخاب روز(فاصله: صحیح):
    روز انتخابی = فاصله
    ساعت انتخابی = ""
پایان

تابع انتخاب ساعت(زمان: رشته):
    اگر وارونه گرفته شده است(روز انتخابی، زمان):
        ساعت انتخابی = زمان
    پایان
پایان

تابع رفتن به خلاصه():
    اگر ساعت انتخابی.طول() بزرگتر 0:
        صفحه.مسیر.برو("/summary")
    پایان
پایان

تابع آماده است(): منطقی:
    برگشت خدمت بزرگتربرابر 0 و ساعت انتخابی.طول() بزرگتر 0
پایان

تابع ایمیل درست_ است(): منطقی:
    برگشت ایمیل.دربردارد("@") و ایمیل.دربردارد(".")
پایان

تابع تایید():
    تلاش_ شد = درست
    اگر مهمان.پیراست().طول() برابر 0 یا وارونه ایمیل درست_ است():
        برگشت
    پایان
    رزروها.افزودن(رزرو {خدمت = خدمت، روز رزرو = روز انتخابی، ساعت انتخابی = ساعت انتخابی، مهمان = مهمان.پیراست()})
    مرجع := رزروها.طول() - 1
    خدمت = 0 - 1
    ساعت انتخابی = ""
    تلاش_ شد = نادرست
    صفحه.مسیر.هدایت("/done/" + مرجع)
پایان

بخش گام(عدد: صحیح، عنوان کوتاه: رشته، جاری: صحیح):
    جعبه:
        چیدمان = ردیف
        تراز = وسط
        شکاف = 8
        رنگ = #7e9a9d
        اگر جاری بزرگتربرابر عدد:
            رنگ = #123036
        پایان
        تکه:
            عرض = 26
            ارتفاع = 26
            گردی = 999
            ترازمتن = وسط
            ارتفاع خط = 26
            اندازه قلم = 13
            وزن قلم = 700
            پس زمینه = #c5dcdc
            اگر جاری بزرگتربرابر عدد:
                پس زمینه = #0d6b6b
            پایان
            رنگ = #ffffff
            محتوا = "" + عدد
        پایان
        تکه:
            اندازه قلم = 14
            محتوا = عنوان کوتاه
        پایان
    پایان
پایان

همگانی بخش گام ها(جاری: صحیح):
    ناوبری:
        کلاس = "steps"
        چیدمان = ردیف
        شکستن خط = درست
        شکاف = 22
        گام:
            عدد = 1
            عنوان کوتاه = "خدمت"
            جاری = جاری
        پایان
        گام:
            عدد = 2
            عنوان کوتاه = "روز و ساعت"
            جاری = جاری
        پایان
        گام:
            عدد = 3
            عنوان کوتاه = "تایید"
            جاری = جاری
        پایان
    پایان
پایان

تابع دنباله(عدد: صحیح): وکتور<صحیح>:
    ناپایا مقدار := وکتور {} برگردان وکتور<صحیح>
    تکرار عدد در ی:
        مقدار.افزودن(ی)
    پایان
    برگشت مقدار
پایان

صفحه:
    حالت = هش
    عنوان = "آبشار آرام"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, system-ui, sans-serif"
    پس زمینه = #f2f8f8
    رنگ = #123036
    سرصفحه:
        فاصله = 18، 32
        شکاف = 12
        پس زمینه = #ffffff
        کادر پایین = 1، توپر، #d4e6e6
        پیوند:
            مقصد = "/"
            اندازه قلم = 20
            وزن قلم = 800
            رنگ = #0d6b6b
            تزیین متن = هیچ
            محتوا = "آبشار آرام"
        پایان
    پایان
    اصلی:
        فاصله = 28، 32
        بیشینه عرض = 860
        فضا = 0، خودکار
        نمای مسیر: پایان
    پایان
پایان
