بخش پنل تایید(مرجع: صحیح):
    جعبه:
        شکاف = 12
        بیشینه عرض = 520
        اگر مرجع بزرگتربرابر رزروها.طول():
            سرتیتر:
                اندازه = 1
                محتوا = "چنین رزروی نیست"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = "رزرو شما ثبت شد"
            پایان
            پاراگراف:
                شناسه = "reference"
                فضا = 0
                اندازه قلم = 18
                محتوا = "کد پیگیری آ-" + (1000 + مرجع)
            پایان
            پاراگراف:
                شناسه = "details"
                فضا = 0
                محتوا = نام خدمت(رزروها[مرجع].خدمت) + ", " + برچسب روز(رزروها[مرجع].روز رزرو) + " ساعت " + رزروها[مرجع].ساعت انتخابی + " برای " + رزروها[مرجع].مهمان
            پایان
        پایان
        پیوند:
            مقصد = "/"
            رنگ = "#0d6b6b"
            محتوا = "رزرو دیگر"
        پایان
    پایان
پایان

همگانی بخش انجام شد(مرجع: صحیح):
    مسیر = "/done/:مرجع"
    عنوان = "ثبت شد"
    پنل تایید:
        مرجع = مرجع
    پایان
پایان
