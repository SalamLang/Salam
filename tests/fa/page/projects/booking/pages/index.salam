همگانی بخش انتخاب خدمت:
    عنوان = "یک خدمت انتخاب کنید"
    جعبه:
        شکاف = 18
        گام ها:
            جاری = 1
        پایان
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "یک خدمت انتخاب کنید"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 14
            کارت خدمت:
                جا = 0
            پایان
            کارت خدمت:
                جا = 1
            پایان
            کارت خدمت:
                جا = 2
            پایان
        پایان
        پاراگراف:
            شناسه = "booked-count"
            رنگ = "#4f6d72"
            محتوا = (رزروها.طول() برابر 0) ? "هنوز رزروی نیست." : رزروها.طول() + " رزرو تا اکنون."
        پایان
    پایان
پایان
