همگانی بخش خلاصه:
    صفحه.نگهبان(آماده است())
    عنوان = "تایید"
    فرم:
        شناسه = "confirm-form"
        شکاف = 12
        بیشینه عرض = 520
        ارسال = (رویداد: صحیح۶۴):
            دام.جلوگیری پیش فرض(رویداد)
            تایید()
        پایان
        گام ها:
            جاری = 3
        پایان
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "رزرو خود را تایید کنید"
        پایان
        جعبه:
            شناسه = "summary"
            فاصله = 18
            شکاف = 4
            گردی = 14
            پس زمینه = "#ffffff"
            کادر = 1، "توپر"، "#d4e6e6"
            قوی:
                محتوا = نام خدمت(خدمت)
            پایان
            تکه:
                محتوا = برچسب روز(روز انتخابی) + " ساعت " + ساعت انتخابی
            پایان
            تکه:
                رنگ = "#4f6d72"
                محتوا = دقیقه خدمت(خدمت) + " دقیقه، " + بهای خدمت(خدمت) + " دلار"
            پایان
        پایان
        برچسب:
            برای = "guest"
            وزن قلم = 600
            محتوا = "نام شما"
        پایان
        ورودی:
            شناسه = "guest"
            فاصله = 10، 12
            گردی = 10
            کادر = 1، "توپر"، "#b9d5d5"
            پیوند = مهمان
        پایان
        پاراگراف:
            شناسه = "guest-note"
            فضا = 0
            کمینه ارتفاع = 18
            رنگ = "#b3261e"
            محتوا = (تلاش_ شد و مهمان.پیراست().طول() برابر 0) ? "لطفا نام خود را بنویسید." : ""
        پایان
        برچسب:
            برای = "mail"
            وزن قلم = 600
            محتوا = "ایمیل"
        پایان
        ورودی:
            شناسه = "mail"
            نوع = ایمیل
            فاصله = 10، 12
            گردی = 10
            کادر = 1، "توپر"، "#b9d5d5"
            پیوند = ایمیل
        پایان
        پاراگراف:
            شناسه = "mail-note"
            فضا = 0
            کمینه ارتفاع = 18
            رنگ = "#b3261e"
            محتوا = (تلاش_ شد و وارونه ایمیل درست_ است()) ? "این شبیه نشانی ایمیل نیست." : ""
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 12
            تراز = "وسط"
            پیوند:
                مقصد = "/time"
                رنگ = "#0d6b6b"
                محتوا = "تغییر ساعت"
            پایان
            دکمه:
                شناسه = "confirm"
                نوع = "ارسال"
                فاصله = 12، 20
                گردی = 10
                کادر = 0
                پس زمینه = "#0d6b6b"
                رنگ = "#ffffff"
                وزن قلم = 700
                محتوا = "تایید رزرو"
            پایان
        پایان
    پایان
پایان
