همگانی بخش انتخاب زمان:
    صفحه.نگهبان(خدمت بزرگتربرابر 0)
    عنوان = "روز و ساعت"
    جعبه:
        شکاف = 18
        گام ها:
            جاری = 2
        پایان
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = نام خدمت(خدمت)
        پایان
        جعبه:
            شناسه = "days"
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 8
            هر روز در دنباله(7):
                تراشه روز:
                    فاصله = روز
                پایان
            پایان
        پایان
        پاراگراف:
            شناسه = "free"
            فضا = 0
            رنگ = "#4f6d72"
            محتوا = برچسب روز(روز انتخابی) + ": " + تعداد آزاد(روز انتخابی) + " ساعت آزاد"
        پایان
        جعبه:
            شناسه = "slots"
            چیدمان = "شبکه"
            ستون‌ها = repeat(fit, minmax(90px, 1fr))
            شکاف = 8
            هر ک در دنباله(16):
                دکمه ساعت:
                    ساعت = ساعت خانه(ک)
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 12
            تراز = "وسط"
            پیوند:
                مقصد = "/"
                رنگ = "#0d6b6b"
                محتوا = "بازگشت"
            پایان
            دکمه:
                شناسه = "to-summary"
                فاصله = 12، 20
                گردی = 10
                کادر = 0
                پس زمینه = "#0d6b6b"
                رنگ = "#ffffff"
                وزن قلم = 700
                اگر ساعت انتخابی.طول() برابر 0:
                    شفافیت = 0.4
                پایان
                aria disabled = (ساعت انتخابی.طول() برابر 0) ? "true" : "false"
                کلیک = رفتن به خلاصه
                محتوا = "ادامه"
            پایان
        پایان
    پایان
پایان
