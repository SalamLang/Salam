همگانی بخش حباب(منی: صحیح، نوشته: رشته، هنگام: رشته):
    جعبه:
        چیدمان = ردیف
        چینش = ابتدا
        اگر منی برابر 1:
            چینش = انتها
        پایان
        جعبه:
            بیشینه عرض = 70%
            فاصله = 8، 12
            گردی = 14
            پس زمینه = #ffffff
            رنگ = #1b2230
            سایه = 0، 1، 2، #0000001a
            اگر منی برابر 1:
                پس زمینه = #3d5afe
                رنگ = #ffffff
            پایان
            پاراگراف:
                فضا = 0
                ارتفاع خط = 1.4
                محتوا = نوشته
            پایان
            پاراگراف:
                فضا = 2، 0، 0، 0
                اندازه قلم = 11
                شفافیت = 0.7
                ترازمتن = انتها
                محتوا = هنگام
            پایان
        پایان
    پایان
پایان
