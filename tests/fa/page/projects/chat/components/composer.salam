همگانی بخش نوشتن‌پیام(id: صحیح):
    فرم:
        چیدمان = "ردیف"
        شکاف = 8
        فاصله = 12، 16
        پس زمینه = "#ffffff"
        کادر بالا = 1، توپر، #dde2eb
        ارسال = (رویداد: صحیح۶۴):
            دام.جلوگیری پیش فرض(رویداد)
            ارسال(id)
        پایان
        ورودی:
            id = "draft"
            رشد = 1
            فاصله = 10، 14
            گردی = 999
            کادر = 1، توپر، #ccd3e0
            اندازه قلم = 15
            جانگهدار = "پیام به " + نام‌گفتگو(id)
            پیوند = پیش‌نویس
        پایان
        دکمه:
            id = "send"
            نوع = ارسال
            فاصله = 10، 20
            گردی = 999
            کادر = 0
            پس زمینه = "#3d5afe"
            رنگ = "#ffffff"
            وزن قلم = 600
            نشانگر = "اشاره"
            محتوا = "ارسال"
        پایان
    پایان
پایان
