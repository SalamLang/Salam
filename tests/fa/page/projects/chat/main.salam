واردسازی دام

پایا گفتگوها := [0، 1، 2، 3]

ناپایا پیام‌گفتگو := بذر‌گفتگو()
ناپایا پیام‌من := بذر‌من()
ناپایا پیام‌متن := بذر‌متن()
ناپایا پیام‌زمان := بذر‌زمان()
ناپایا خوانده‌نشده := بذر‌خوانده‌نشده()
ناپایا پیش‌نویس := ""
ناپایا درحال‌نوشتن := -1
ناپایا ساعت‌شمار := 9 * 60 + 41
ناپایا تاخیر := 1200
ناپایا تیره := نادرست

تابع بذر‌گفتگو(): وکتور<صحیح>:
    ناپایا فهرست‌مقدار := وکتور {} برگردان وکتور<صحیح>
    فهرست‌مقدار.افزودن(0)
    فهرست‌مقدار.افزودن(0)
    فهرست‌مقدار.افزودن(1)
    فهرست‌مقدار.افزودن(2)
    فهرست‌مقدار.افزودن(2)
    فهرست‌مقدار.افزودن(3)
    برگشت فهرست‌مقدار
پایان

تابع بذر‌من(): وکتور<صحیح>:
    ناپایا فهرست‌مقدار := وکتور {} برگردان وکتور<صحیح>
    فهرست‌مقدار.افزودن(0)
    فهرست‌مقدار.افزودن(1)
    فهرست‌مقدار.افزودن(0)
    فهرست‌مقدار.افزودن(0)
    فهرست‌مقدار.افزودن(0)
    فهرست‌مقدار.افزودن(1)
    برگشت فهرست‌مقدار
پایان

تابع بذر‌متن(): وکتور<رشته>:
    ناپایا فهرست‌مقدار := وکتور {} برگردان وکتور<رشته>
    فهرست‌مقدار.افزودن("ناهار امروز سر قرارمونه؟")
    فهرست‌مقدار.افزودن("آره، ظهر همون جای همیشگی")
    فهرست‌مقدار.افزودن("اصلاح را فرستادم، لطفا ببین")
    فهرست‌مقدار.افزودن("عکس‌ها آماده‌ست")
    فهرست‌مقدار.افزودن("گذاشتمشون تو پوشه مشترک")
    فهرست‌مقدار.افزودن("ممنون، جمعه می‌بینمت")
    برگشت فهرست‌مقدار
پایان

تابع بذر‌زمان(): وکتور<صحیح>:
    ناپایا فهرست‌مقدار := وکتور {} برگردان وکتور<صحیح>
    فهرست‌مقدار.افزودن(8 * 60 + 12)
    فهرست‌مقدار.افزودن(8 * 60 + 15)
    فهرست‌مقدار.افزودن(9 * 60 + 2)
    فهرست‌مقدار.افزودن(9 * 60 + 30)
    فهرست‌مقدار.افزودن(9 * 60 + 31)
    فهرست‌مقدار.افزودن(7 * 60 + 50)
    برگشت فهرست‌مقدار
پایان

تابع بذر‌خوانده‌نشده(): وکتور<صحیح>:
    ناپایا فهرست‌مقدار := وکتور {} برگردان وکتور<صحیح>
    فهرست‌مقدار.افزودن(0)
    فهرست‌مقدار.افزودن(1)
    فهرست‌مقدار.افزودن(2)
    فهرست‌مقدار.افزودن(0)
    برگشت فهرست‌مقدار
پایان

ناب تابع نام‌گفتگو(شماره‌گفتگو: صحیح): رشته:
    اگر شماره‌گفتگو برابر 0:
        برگشت "مایا"
    وگرنه شماره‌گفتگو برابر 1:
        برگشت "لئو"
    وگرنه شماره‌گفتگو برابر 2:
        برگشت "نورا"
    پایان
    برگشت "سام"
پایان

ناب تابع دورقمی(عدد: صحیح): رشته:
    اگر عدد کوچکتر 10:
        برگشت "0" + عدد
    پایان
    برگشت "" + عدد
پایان

ناب تابع برچسب‌زمان(دقیقه‌ها: صحیح): رشته:
    برگشت دورقمی(دقیقه‌ها / 60 % 24) + ":" + دورقمی(دقیقه‌ها % 60)
پایان

ناب تابع پاسخ‌آماده(شماره‌گفتگو: صحیح، عدد: صحیح): رشته:
    باقی‌مانده := (شماره‌گفتگو + عدد) % 4
    اگر باقی‌مانده برابر 0:
        برگشت "عالیه"
    وگرنه باقی‌مانده برابر 1:
        برگشت "یک دقیقه صبر کن"
    وگرنه باقی‌مانده برابر 2:
        برگشت "خب، درسته"
    پایان
    برگشت "فردا حرف می‌زنیم"
پایان

ناب تابع آخرین‌متن(شماره‌گفتگو: صحیح): رشته:
    ناپایا شماره := پیام‌متن.طول() - 1
    تا شماره بزرگتربرابر 0:
        اگر پیام‌گفتگو[شماره] برابر شماره‌گفتگو:
            برگشت پیام‌متن[شماره]
        پایان
        شماره--
    پایان
    برگشت "هنوز پیامی نیست"
پایان

ناب تابع جمع‌خوانده‌نشده(): صحیح:
    ناپایا تکه := 0
    هر عدد در خوانده‌نشده:
        تکه += عدد
    پایان
    برگشت تکه
پایان

تابع افزودن‌پیام(شماره‌گفتگو: صحیح، منی: صحیح، نوشته: رشته):
    ساعت‌شمار++
    پیام‌گفتگو.بیفزا(شماره‌گفتگو)
    پیام‌من.بیفزا(منی)
    پیام‌متن.بیفزا(نوشته)
    پیام‌زمان.بیفزا(ساعت‌شمار)
پایان

تابع خواندن‌گفتگو(شماره‌گفتگو: صحیح):
    خوانده‌نشده[شماره‌گفتگو] = 0
پایان

تابع رسیدن‌پاسخ(شماره‌گفتگو: صحیح):
    افزودن‌پیام(شماره‌گفتگو، 0، پاسخ‌آماده(شماره‌گفتگو، پیام‌متن.طول()))
    اگر درحال‌نوشتن برابر شماره‌گفتگو:
        درحال‌نوشتن = -1
    پایان
    اگر صفحه.مسیر.نشانی نابرابر "/chat/" + شماره‌گفتگو:
        خوانده‌نشده[شماره‌گفتگو] = خوانده‌نشده[شماره‌گفتگو] + 1
    پایان
پایان

تابع ارسال(شماره‌گفتگو: صحیح):
    نوشته := پیش‌نویس.پیراست()
    اگر نوشته.طول() برابر 0:
        برگشت
    پایان
    افزودن‌پیام(شماره‌گفتگو، 1، نوشته)
    پیش‌نویس = ""
    درحال‌نوشتن = شماره‌گفتگو
    دام.تنظیم مهلت((): رسیدن‌پاسخ(شماره‌گفتگو) پایان، تاخیر)
پایان

همگانی بخش ردیف‌مخاطب(شماره: صحیح، فرد: رشته، خلاصه: رشته، شمار: صحیح، فعلی: منطقی):
    پیوند:
        to = "/chat/" + شماره
        چیدمان = ردیف
        تراز = وسط
        شکاف = 12
        فاصله = 10، 12
        گردی = 12
        رنگ = #1b2230
        اگر تیره:
            رنگ = #e6e9ef
        پایان
        تزیین متن = هیچ
        اشاره:
            پس زمینه = #eef1f6
        پایان
        اگر فعلی:
            پس زمینه = #e3e8ff
        پایان
        کلیک = ():
            خواندن‌گفتگو(شماره)
        پایان
        جعبه:
            عرض = 40
            ارتفاع = 40
            گردی = 50%
            پس زمینه = #3d5afe
            رنگ = #ffffff
            تراز = وسط
            چینش = وسط
            وزن قلم = 700
            محتوا = فرد.زیررشته(0، 1)
        پایان
        جعبه:
            رشد = 1
            کمینه عرض = 0
            پاراگراف:
                فضا = 0
                وزن قلم = 700
                محتوا = فرد
            پایان
            پاراگراف:
                فضا = 0
                اندازه قلم = 13
                شفافیت = 0.65
                سه‌نقطه = درست
                محتوا = خلاصه
            پایان
        پایان
        اگر شمار بزرگتر 0:
            تکه:
                کلاس = "badge"
                کمینه عرض = 22
                فاصله = 2، 7
                گردی = 999
                پس زمینه = #ff3d71
                رنگ = #ffffff
                اندازه قلم = 12
                وزن قلم = 700
                ترازمتن = وسط
                محتوا = شمار
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "گپ‌گاه"
    زبان = "fa"
    خانواده قلم = "Tahoma, system-ui, sans-serif"
    جعبه:
        چیدمان = ردیف
        کمینه ارتفاع = 100vh
        پس زمینه = #eef1f6
        رنگ = #1b2230
        اگر تیره:
            پس زمینه = #10141c
            رنگ = #e6e9ef
        پایان
        ناوبری:
            عرض = 280
            شکاف = 4
            فاصله = 16، 10
            پس زمینه = #ffffff
            کادر راست = 1، توپر، #dde2eb
            اگر تیره:
                پس زمینه = #181d28
                کادر راست = 1، توپر، #2a3140
            پایان
            جعبه:
                چیدمان = ردیف
                تراز = وسط
                چینش = میان
                فاصله = 4، 8، 10، 8
                پیوند:
                    to = "/"
                    اندازه قلم = 20
                    وزن قلم = 800
                    رنگ = #3d5afe
                    تزیین متن = هیچ
                    محتوا = "گپ‌گاه"
                پایان
                تکه:
                    id = "total"
                    اندازه قلم = 13
                    شفافیت = 0.7
                    محتوا = جمع‌خوانده‌نشده() + " خوانده‌نشده"
                پایان
            پایان
            هر شماره‌گفتگو در گفتگوها:
                ردیف‌مخاطب:
                    شماره = شماره‌گفتگو
                    فرد = نام‌گفتگو(شماره‌گفتگو)
                    خلاصه = آخرین‌متن(شماره‌گفتگو)
                    شمار = خوانده‌نشده[شماره‌گفتگو]
                    فعلی = (صفحه.مسیر.نشانی برابر "/chat/" + شماره‌گفتگو)
                پایان
            پایان
            پیوند:
                to = "/settings"
                فضا = 14، 0، 0، 0
                فاصله = 10، 12
                رنگ = #6b7385
                تزیین متن = هیچ
                محتوا = "تنظیمات"
            پایان
        پایان
        اصلی:
            رشد = 1
            نمای مسیر: پایان
        پایان
    پایان
پایان
