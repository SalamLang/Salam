 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش گفتگو(id: صحیح):
    عنوان = "گفتگو با " + نام‌گفتگو(id)
    جعبه:
        ارتفاع = 100vh
        اگر id کوچکتر 4:
            سرصفحه:
                فاصله = 14، 20
                پس زمینه = "#ffffff"
                کادر پایین = 1، توپر، #dde2eb
                سرتیتر:
                    اندازه = 2
                    فضا = 0
                    محتوا = نام‌گفتگو(id)
                پایان
                اگر درحال‌نوشتن برابر id:
                    ریز:
                        id = "typing"
                        شفافیت = 0.65
                        محتوا = "در حال نوشتن..."
                    پایان
                پایان
            پایان
            جعبه:
                رشد = 1
                سرریز = "خودکار"
                فاصله = 16، 20
                شکاف = 8
                هر ردیف‌پیام، تکه در پیام‌متن:
                    اگر پیام‌گفتگو[ردیف‌پیام] برابر id:
                        حباب:
                            منی = پیام‌من[ردیف‌پیام]
                            نوشته = تکه
                            هنگام = برچسب‌زمان(پیام‌زمان[ردیف‌پیام])
                        پایان
                    پایان
                پایان
            پایان
            نوشتن‌پیام:
                id = id
            پایان
        وگرنه:
            جعبه:
                فاصله = 40
                سرتیتر:
                    اندازه = 2
                    محتوا = "چنین گفتگویی نیست"
                پایان
            پایان
        پایان
    پایان
پایان
