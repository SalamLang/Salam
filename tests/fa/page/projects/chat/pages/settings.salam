همگانی بخش تنظیمات:
    عنوان = "تنظیمات"
    جعبه:
        فاصله = 32
        شکاف = 16
        بیشینه عرض = 480
        سرتیتر:
            اندازه = 1
            محتوا = "تنظیمات"
        پایان
        برچسب:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 10
            ورودی:
                شناسه = "dark"
                نوع = "تیک"
                پیوند = تیره
            پایان
            تکه:
                محتوا = "پوسته تیره"
            پایان
        پایان
        برچسب:
            شکاف = 6
            تکه:
                محتوا = "تاخیر پاسخ: " + تاخیر + " میلی‌ثانیه"
            پایان
            ورودی:
                شناسه = "delay"
                نوع = "بازه"
                کمینه = 200
                بیشینه = 4000
                گام = 200
                مقدار = تاخیر
                ورودی = (فهرست‌مقدار: رشته):
                    تاخیر = فهرست‌مقدار.به صحیح()
                پایان
            پایان
        پایان
    پایان
پایان
