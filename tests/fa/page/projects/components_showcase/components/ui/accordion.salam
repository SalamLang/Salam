همگانی بخش بخش‌آکاردئون(تیتر: رشته):
    باز := نادرست
    جعبه:
        کادر = 1، توپر، #e1e4f0
        گردی = 10
        پس زمینه = "#ffffff"
        دکمه:
            چیدمان = "ردیف"
            چینش = "میان"
            عرض = 100%
            فاصله = 12، 16
            کادر = 0
            پس زمینه = "شفاف"
            وزن قلم = 600
            نشانگر = "اشاره"
            کلیک = (): باز = وارونه باز پایان
            تکه:
                محتوا = تیتر
            پایان
            تکه:
                محتوا = باز ? "-" : "+"
            پایان
        پایان
        اگر باز:
            جعبه:
                فاصله = 0، 16، 14، 16
                content: پایان
            پایان
        پایان
    پایان
پایان
