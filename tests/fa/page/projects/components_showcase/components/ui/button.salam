همگانی بخش فشاردهنده(نوشته کلید: رشته، سبک: رشته، خاموش: منطقی، عمل: تابع ()):
    فشرده := نادرست
    دکمه:
        فاصله = 9، 18
        گردی = 10
        کادر = 1، "توپر"، "#3c4a8a"
        پس زمینه = #3c4a8a
        رنگ = #ffffff
        وزن قلم = 600
        نشانگر = "اشاره"
        گذار = 120ms
        اشاره:
            شفافیت = 0.88
        پایان
        اگر سبک برابر "soft":
            پس زمینه = #e3e7fb
            رنگ = #2b3770
        پایان
        اگر سبک برابر "outline":
            پس زمینه = #ffffff
            رنگ = #3c4a8a
        پایان
        اگر سبک برابر "danger":
            پس زمینه = #b42318
            رنگ کادر = #b42318
        پایان
        اگر فشرده:
            شفافیت = 0.7
        پایان
        اگر خاموش:
            شفافیت = 0.45
        پایان
        فشردن ماوس = (): فشرده = درست پایان
        رها کردن ماوس = (): فشرده = نادرست پایان
        خروج ماوس = (): فشرده = نادرست پایان
        غیرفعال = خاموش
        کلیک = عمل
        محتوا = نوشته کلید
    پایان
پایان
