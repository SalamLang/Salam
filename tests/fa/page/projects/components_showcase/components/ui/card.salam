همگانی بخش کارت(تیتر: رشته، یادداشت: رشته):
    بخش:
        شکاف = 8
        فاصله = 18
        گردی = 14
        پس زمینه = #ffffff
        کادر = 1، توپر، #e1e4f0
        سایه = 0، 2، 8، #1d223614
        سرتیتر:
            اندازه = 3
            محتوا = تیتر
        پایان
        اگر یادداشت نابرابر "":
            ریز:
                شفافیت = 0.65
                محتوا = یادداشت
            پایان
        پایان
        content: پایان
    پایان
پایان
