همگانی بخش پنجره تایید(نمایان: منطقی، تیتر: رشته):
    اگر نمایان:
        جعبه:
            موقعیت = ثابت
            فاصله از لبه = 0
            چیدمان = ستون
            تراز = وسط
            چینش = وسط
            پس زمینه = #0f1224aa
            کلیک = بستن پنجره
            پنجره گفتگو:
                شناسه = "kit-modal"
                باز = درست
                کلیک = (ی: صحیح۶۴): دام.توقف انتشار(ی) پایان
                عرض = 92%
                بیشینه عرض = 420
                فاصله = 22
                گردی = 16
                کادر = 0
                پس زمینه = #ffffff
                رنگ = #1d2236
                شکاف = 12
                سرتیتر:
                    اندازه = 3
                    محتوا = تیتر
                پایان
                content: پایان
                جعبه:
                    چیدمان = ردیف
                    شکاف = 8
                    چینش = انتها
                    فشاردهنده:
                        نوشته کلید = "انصراف"
                        سبک = "outline"
                        خاموش = نادرست
                        عمل = بستن پنجره
                    پایان
                    فشاردهنده:
                        نوشته کلید = "تایید"
                        سبک = "solid"
                        خاموش = نادرست
                        عمل = تایید پنجره
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
