همگانی بخش برگه زبانه(نام زبانه: رشته، نوشته کلید: رشته):
    دکمه:
        فاصله = 8، 16
        کادر = 0
        کادر پایین = 3، "توپر"، "#00000000"
        پس زمینه = "شفاف"
        رنگ = #5a6288
        نشانگر = "اشاره"
        اگر زبانه برابر نام زبانه:
            کادر پایین = 3، "توپر"، "#3c4a8a"
            رنگ = #1d2236
            وزن قلم = 700
        پایان
        کلیک = (): برگزین زبانه(نام زبانه) پایان
        محتوا = نوشته کلید
    پایان
پایان

همگانی بخش نوار زبانه:
    جعبه:
        چیدمان = "ردیف"
        شکاف = 4
        کادر پایین = 1، "توپر"، "#e1e4f0"
        content: پایان
    پایان
پایان
