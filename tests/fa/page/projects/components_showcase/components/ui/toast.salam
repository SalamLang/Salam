همگانی بخش پشته پیام:
    جعبه:
        موقعیت = "ثابت"
        پایین = 18
        راست = 18
        شکاف = 8
        هر شماره، ت در پیام‌ها:
            جعبه:
                کلید = شماره
                فاصله = 10، 16
                گردی = 10
                پس زمینه = "#1d2236"
                رنگ = "#ffffff"
                سایه = 0، 6، 18، #00000040
                محتوا = ت
            پایان
        پایان
    پایان
پایان
