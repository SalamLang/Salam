همگانی بخش نکته شناور(نکته: رشته):
    روی آن := نادرست
    تکه:
        چیدمان = ستون
        شکاف = 4
        ورود ماوس = (): روی آن = درست پایان
        خروج ماوس = (): روی آن = نادرست پایان
        content: پایان
        اگر روی آن:
            ریز:
                خود تراز = ابتدا
                فاصله = 3، 10
                گردی = 8
                پس زمینه = #1d2236
                رنگ = #ffffff
                محتوا = نکته
            پایان
        پایان
    پایان
پایان
