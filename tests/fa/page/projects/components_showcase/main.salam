                پایان
                پیوند:
                    مقصد = "/buttons"
                    فاصله = 6، 12
                    گردی = 8
                    تزیین متن = "هیچ"
                    رنگ = "#3c4a8a"
                    محتوا = "کلیدها"
                پایان
                پیوند:
                    مقصد = "/layout"
                    فاصله = 6، 12
                    گردی = 8
                    تزیین متن = "هیچ"
                    رنگ = "#3c4a8a"
                    محتوا = "ساختار"
                پایان
                پیوند:
                    مقصد = "/overlays"
                    فاصله = 6، 12
                    گردی = 8
                    تزیین متن = "هیچ"
                    رنگ = "#3c4a8a"
                    محتوا = "رویه‌ها"
                پایان
            پایان
        پایان
        اصلی:
            بیشینه عرض = 860
            فضا = 0، "خودکار"
            فاصله = 28
            نمای مسیر: پایان
        پایان
        پشته پیام: پایان
        پنجره تایید:
            نمایان = پنجره باز
            تیتر = "به کتابخانه افزوده شود؟"
            پاراگراف:
                محتوا = "این مورد روی همین دستگاه نگه داشته می‌شود."
            پایان
        پایان
    پایان
پایان
