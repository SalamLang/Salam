// انتظار: var __salam_rt_hash = true
// انتظار: کیت طراحی
// انتظار: باز کردن پنجره
// انتظار: در کتابخانه‌ات ذخیره شد
واردسازی دام

ناپایا پنجره باز := نادرست
ناپایا زبانه := "usage"
ناپایا پیام‌ها := وکتور {} برگردان وکتور<رشته>
ناپایا شمار تایید := 0

تابع حذف پیام():
    اگر پیام‌ها.طول() بزرگتر 0:
        پیام‌ها.حذف در(0)
    پایان
پایان

تابع بگو(خط پیام: رشته):
    پیام‌ها.افزودن(خط پیام)
    _ت := دام.تنظیم مهلت((): حذف پیام() پایان، 3000)
پایان

تابع نمایش پنجره():
    پنجره باز = درست
پایان

تابع بستن پنجره():
    پنجره باز = نادرست
پایان

تابع تایید پنجره():
    پنجره باز = نادرست
    شمار تایید++
    بگو("در کتابخانه‌ات ذخیره شد")
پایان

تابع برگزین زبانه(نام زبانه: رشته):
    زبانه = نام زبانه
پایان

صفحه:
    حالت = "هش"
