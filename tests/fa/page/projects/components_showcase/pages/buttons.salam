همگانی بخش صفحه‌فشاردهنده‌ها:
    عنوان = "کلیدها"
    خاموش := نادرست
    جعبه:
        شکاف = 16
        سرتیتر:
            اندازه = 1
            محتوا = "کلیدها"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 10
            شکستن خط = درست
            فشاردهنده:
                نوشته کلید = "پر"
                سبک = "solid"
                خاموش = خاموش
                عمل = (): بگو("کلید پر زده شد") پایان
            پایان
            فشاردهنده:
                نوشته کلید = "ملایم"
                سبک = "soft"
                خاموش = خاموش
                عمل = (): بگو("کلید ملایم زده شد") پایان
            پایان
            فشاردهنده:
                نوشته کلید = "لبه‌دار"
                سبک = "outline"
                خاموش = خاموش
                عمل = (): بگو("کلید لبه‌دار زده شد") پایان
            پایان
            فشاردهنده:
                نوشته کلید = "خطر"
                سبک = "danger"
                خاموش = خاموش
                عمل = (): بگو("کلید خطر زده شد") پایان
            پایان
        پایان
        برچسب:
            چیدمان = "ردیف"
            شکاف = 8
            ورودی:
                شناسه = "off"
                نوع = "تیک"
                تغییر = (): خاموش = وارونه خاموش پایان
            پایان
            تکه:
                محتوا = "خاموش کردن همه کلیدها"
            پایان
        پایان
    پایان
پایان
