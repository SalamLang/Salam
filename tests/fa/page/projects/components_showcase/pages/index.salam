همگانی بخش نمای کلی:
    عنوان = "کیت طراحی"
    جعبه:
        شکاف = 16
        سرتیتر:
            اندازه = 1
            محتوا = "کیت طراحی"
        پایان
        پاراگراف:
            محتوا = "قطعه‌های کوچکی که همه صفحه‌ها دوباره به کار می‌برند: کلید، کارت، پنجره، زبانه، آکاردئون، نکته شناور و پیام."
        پایان
        جعبه:
            چیدمان = شبکه
            چندستونی = "repeat(fill, minmax(240, 1fr))"
            شکاف = 14
            کارت:
                تیتر = "کلیدها"
                یادداشت = "چهار ظاهر و حالت خاموش"
                پیوند:
                    مقصد = "/buttons"
                    محتوا = "دیدن کلیدها"
                پایان
            پایان
            کارت:
                تیتر = "ساختار"
                یادداشت = "کارت، زبانه و آکاردئون"
                پیوند:
                    مقصد = "/layout"
                    محتوا = "دیدن بخش‌های ساختار"
                پایان
            پایان
            کارت:
                تیتر = "رویه‌ها"
                یادداشت = "پنجره، نکته شناور و پیام"
                پیوند:
                    مقصد = "/overlays"
                    محتوا = "دیدن رویه‌ها"
                پایان
            پایان
        پایان
        پاراگراف:
            محتوا = "موردهای تاییدشده تا الان: " + شمار تایید
        پایان
    پایان
پایان
