همگانی بخش صفحه‌ساختار:
    عنوان = "ساختار"
    جعبه:
        شکاف = 18
        سرتیتر:
            اندازه = 1
            محتوا = "ساختار"
        پایان
        نوار زبانه:
            برگه زبانه:
                نام زبانه = "usage"
                نوشته کلید = "کاربرد"
            پایان
            برگه زبانه:
                نام زبانه = "props"
                نوشته کلید = "ورودی‌ها"
            پایان
            برگه زبانه:
                نام زبانه = "notes"
                نوشته کلید = "نکته‌ها"
            پایان
        پایان
        اگر زبانه برابر "usage":
            پاراگراف:
                شناسه = "tab-usage"
                محتوا = "نام بخش را بنویس و ورودی‌هایش را پر کن. بدنه در جایگاه می‌رود."
            پایان
        پایان
        اگر زبانه برابر "props":
            پاراگراف:
                شناسه = "tab-props"
                محتوا = "کارت تیتر و یادداشت می‌گیرد. فشاردهنده نوشته، سبک، خاموش و عمل می‌گیرد."
            پایان
        پایان
        اگر زبانه برابر "notes":
            پاراگراف:
                شناسه = "tab-notes"
                محتوا = "بخش‌ها در پوشه components هستند و نیازی به include ندارند."
            پایان
        پایان
        جعبه:
            شکاف = 8
            بخش آکاردئون:
                تیتر = "چرا جایگاه؟"
                پاراگراف:
                    محتوا = "خط محتوا جای فرزندهای بخش را نشان می‌دهد."
                پایان
            پایان
            بخش آکاردئون:
                تیتر = "حالت کجاست؟"
                پاراگراف:
                    محتوا = "باز و بسته بودن در خود هر بخش است، زبانه‌ها یک متغیر مشترک دارند."
                پایان
            پایان
        پایان
    پایان
پایان
