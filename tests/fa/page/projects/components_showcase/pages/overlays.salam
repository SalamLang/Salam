همگانی بخش صفحه‌رویه‌ها:
    عنوان = "رویه‌ها"
    جعبه:
        شکاف = 16
        سرتیتر:
            اندازه = 1
            محتوا = "رویه‌ها"
        پایان
        جعبه:
            چیدمان = ردیف
            شکاف = 14
            تراز = وسط
            فشاردهنده:
                نوشته کلید = "باز کردن پنجره"
                سبک = "solid"
                خاموش = نادرست
                عمل = نمایش پنجره
            پایان
            فشاردهنده:
                نوشته کلید = "پیام"
                سبک = "soft"
                خاموش = نادرست
                عمل = (): بگو("سلام از یک پیام") پایان
            پایان
            نکته شناور:
                نکته = "نکته شناور با موشواره دیده می‌شود"
                قوی:
                    محتوا = "موشواره را بیاور"
                پایان
            پایان
        پایان
        پاراگراف:
            محتوا = "تایید شد " + شمار تایید + " بار."
        پایان
    پایان
پایان
