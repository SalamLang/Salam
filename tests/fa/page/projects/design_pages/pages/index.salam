همگانی بخش خانه:
    شمار := 0
    کارت:
        محتوای کارت:
            دکمه: گونه = "ثانویه" محتوا = "ذخیره" پایان
            ورودی: برچسب دسترسی‌پذیری = "نام" پایان
            نشان: گونه = "خط دور" محتوا = "نشان" پایان
        پایان
    پایان
    آکاردئون:
        نوع = "چندتایی"
        قابل بستن = درست
        بخش آکاردئون:
            مقدار = "1"
            دکمه آکاردئون:
                محتوا = "چرا"
            پایان
            محتوای آکاردئون:
                محتوا = "چون"
            پایان
        پایان
    پایان
    دکمه:
        گونه = "خطرناک"
        کلیک = (): شمار++ پایان
        محتوا = "کلیک " + شمار
    پایان
پایان
