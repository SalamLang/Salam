همگانی بخش بلوک‌سند(متن: رشته):
    اگر تیتری(متن):
        h2:
            شناسه = لنگر تیتر(متن)
            فضا = 28، 0، 8، 0
            اندازه قلم = 22
            محتوا = متن تیتر(متن)
        پایان
    وگرنه متن.شروع با("$ "):
        پیش‌قالب:
            فضا = 8، 0
            فاصله = 12، 16
            گردی = 10
            پس زمینه = "#0f1a2b"
            رنگ = "#e2f3ef"
            سرریز = "خودکار"
            خانواده قلم = "ui-monospace, Menlo, monospace"
            اندازه قلم = 14
            محتوا = متن.زیررشته(2، متن.طول())
        پایان
    وگرنه:
        پاراگراف:
            فضا = 8، 0
            محتوا = متن
        پایان
    پایان
پایان
