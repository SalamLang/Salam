همگانی بخش منوی‌اسناد:
    ناوبری:
        عرض = 250
        فاصله = 24، 16
        شکاف = 18
        کادر راست = 1، "توپر"، "#e4e7ee"
        برچسب دسترسی‌پذیری = "مستندات"
        هر شماره، س در دسته‌ها():
            جعبه:
                کلید = شماره
                شکاف = 4
                پاراگراف:
                    فضا = 0
                    اندازه قلم = 12
                    وزن قلم = 700
                    رنگ = "#6b7385"
                    دگرگونی متن = "بزرگ"
                    فاصله حروف = 0.06em
                    محتوا = عنوان دسته(س)
                پایان
                هر ردیف، د در سندها():
                    اگر د.دسته برابر س:
                        پیوند‌کناری:
                            کلید = ردیف
                            هدف = سند لینک(د)
                            برچسب = د.عنوان
                        پایان
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
