همگانی بخش گام‌پیمایی(جا: صحیح):
    ناوبری:
        چیدمان = "ردیف"
        چینش = "میان"
        شکاف = 12
        فضا = 36، 0، 0، 0
        برچسب دسترسی‌پذیری = "قبلی و بعدی"
        اگر جا بزرگتر 0:
            پیوند:
                شناسه = "prev"
                مقصد = نشانی سند(جا - 1)
                فاصله = 10، 16
                گردی = 10
                کادر = 1، توپر، #e4e7ee
                رنگ = "#1c2230"
                تزیین متن = "هیچ"
                محتوا = "قبلی: " + سندها().بگیر(جا - 1).عنوان
            پایان
        وگرنه:
            تکه: پایان
        پایان
        اگر جا + 1 کوچکتر سندها().طول():
            پیوند:
                شناسه = "next"
                مقصد = نشانی سند(جا + 1)
                فاصله = 10، 16
                گردی = 10
                کادر = 1، توپر، #e4e7ee
                رنگ = "#1c2230"
                تزیین متن = "هیچ"
                محتوا = "بعدی: " + سندها().بگیر(جا + 1).عنوان
            پایان
        پایان
    پایان
پایان
