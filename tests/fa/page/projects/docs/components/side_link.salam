همگانی بخش پیوند‌کناری(هدف: رشته، برچسب: رشته):
    پیوند:
        مقصد = هدف
        فاصله = 6، 10
        گردی = 8
        رنگ = #364054
        تزیین متن = "هیچ"
        اشاره:
            پس زمینه = "#f1f4f9"
        پایان
        اگر مسیر جاری(هدف):
            پس زمینه = #ccfbf1
            رنگ = #0f766e
            وزن قلم = 600
        پایان
        محتوا = برچسب
    پایان
پایان
