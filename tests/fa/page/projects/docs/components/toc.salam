همگانی بخش فهرست‌تیترها(جا: صحیح):
    اگر شمار تیترها(جا) بزرگتر 0:
        ناوبری:
            شناسه = "toc"
            فاصله = 12، 16
            گردی = 12
            پس زمینه = "#f6f8fb"
            شکاف = 4
            برچسب دسترسی‌پذیری = "در این صفحه"
            پاراگراف:
                فضا = 0
                اندازه قلم = 12
                وزن قلم = 700
                رنگ = "#6b7385"
                دگرگونی متن = "بزرگ"
                محتوا = "در این صفحه"
            پایان
            هر _، ب در بلوک‌های سند(جا):
                اگر تیتری(ب):
                    پیوند:
                        نشانی = "#" + لنگر تیتر(ب)
                        رنگ = "#0f766e"
                        تزیین متن = "هیچ"
                        اندازه قلم = 14
                        محتوا = متن تیتر(ب)
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
