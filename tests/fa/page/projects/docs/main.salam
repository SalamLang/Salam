// انتظار: <meta name="salam-router" content="history">
// انتظار: بادبادک
واردسازی رشته

پایا نام‌محصول := "بادبادک"

ساختار سند:
    همگانی دسته: رشته
    همگانی نامک: رشته
    همگانی عنوان: رشته
    همگانی متن: رشته
پایان

تابع ساختن سند(دسته: رشته، نامک: رشته، عنوان: رشته، متن: رشته): سند:
    برگشت سند { دسته = دسته نامک = نامک عنوان = عنوان متن = متن }
پایان

تابع سندها(): وکتور<سند>:
    ناپایا و_ := وکتور {} برگردان وکتور<سند>
    و_.افزودن(ساختن سند("start"، "intro"، "معرفی"،
        "بادبادک از یک پوشه‌ی پرونده‌های متنی یک پایگاه ایستا می‌سازد.\n# چه به دست می‌آورید\nساخت سریع، نشانی‌های تمیز و بدون هیچ محیط اجرایی برای ارسال.\n# برای چه کسانی است\nکسانی که بیشتر می‌نویسند تا پیکربندی کنند."))
    و_.افزودن(ساختن سند("start"، "install"، "نصب"،
        "بادبادک فقط یک پرونده است. آن را بگیرید، در مسیر برنامه‌ها بگذارید و نسخه را ببینید.\n# دریافت\nبسته‌ی مناسب سیستم خود را برگزینید.\n$ kite version\n# به‌روزرسانی\nهمین دستور را دوباره اجرا کنید تا همان‌جا تازه شود."))
    و_.افزودن(ساختن سند("guide"، "pages"، "نوشتن صفحه‌ها"،
        "هر پرونده‌ی پوشه‌ی محتوا یک صفحه می‌شود.\n# سرپرونده\nچند خط اول پرونده عنوان و تاریخ آن را نگه می‌دارد.\n$ title: Hello\n# پیوندها\nبا نام پرونده به صفحه‌های دیگر پیوند بدهید و بادبادک نشانی را درست می‌کند."))
    و_.افزودن(ساختن سند("guide"، "themes"، "پوسته‌ها"،
        "پوسته پوشه‌ای از قالب‌ها و سبک‌هاست.\n# انتخاب پوسته\nنام پوسته را در پرونده‌ی پیکربندی بنویسید.\n$ theme = \"paper\"\n# ساختن پوسته‌ی خودتان\nاز پوسته‌ی پیش‌فرض شروع کنید و هر بار یک قالب را عوض کنید."))
    و_.افزودن(ساختن سند("reference"، "config"، "پیکربندی"،
        "همه‌ی تنظیم‌ها در kite.toml ریشه‌ی پروژه هستند.\n# کلیدها\nکلیدها title و base و theme و out هستند.\n$ out = \"public\"\n# پیش‌فرض‌ها\nهر کلید پیش‌فرض دارد، پس پرونده‌ی خالی هم درست است."))
    و_.افزودن(ساختن سند("reference"، "cli"، "خط فرمان"،
        "خط فرمان سه دستور دارد.\n# build\nپایگاه را در پوشه‌ی خروجی می‌نویسد.\n$ kite build\n# serve\nپایگاه را نشان می‌دهد و با هر تغییر دوباره می‌سازد.\n# clean\nپوشه‌ی خروجی را پاک می‌کند."))
    برگشت و_
پایان

تابع عنوان دسته(دسته: رشته): رشته:
    اگر دسته برابر "start":
        برگشت "شروع کار"
    وگرنه دسته برابر "guide":
        برگشت "راهنما"
    پایان
    برگشت "مرجع"
پایان

تابع دسته‌ها(): وکتور<رشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<رشته>
    و_.افزودن("start")
    و_.افزودن("guide")
    و_.افزودن("reference")
    برگشت و_
پایان

تابع یافتن سند(دسته: رشته، نامک: رشته): صحیح:
    همه := سندها()
    تکرار همه.طول() در ی:
        د := همه.بگیر(ی)
        اگر د.دسته برابر دسته و د.نامک برابر نامک:
            برگشت ی
        پایان
    پایان
    برگشت -1
پایان

تابع مسیر جاری(هدف: رشته): منطقی:
    برگشت صفحه.مسیر.نشانی برابر هدف
پایان

تابع سند لینک(د: سند): رشته:
    برگشت "/docs/" + د.دسته + "/" + د.نامک
پایان

تابع نشانی سند(جا: صحیح): رشته:
    د := سندها().بگیر(جا)
    برگشت "/docs/" + د.دسته + "/" + د.نامک
پایان

تابع بلوک‌های سند(جا: صحیح): وکتور<رشته>:
    برگشت سندها().بگیر(جا).متن.بشکاف("\n")
پایان

تابع تیتری(بلوک: رشته): منطقی:
    برگشت بلوک.شروع با("# ")
پایان

تابع متن تیتر(بلوک: رشته): رشته:
    برگشت بلوک.زیررشته(2، بلوک.طول())
پایان

تابع لنگر تیتر(بلوک: رشته): رشته:
    برگشت رشته.جایگزینی(متن تیتر(بلوک).کوچک()، " "، "-")
پایان

تابع شمار تیترها(جا: صحیح): صحیح:
    ناپایا ن := 0
    هر ب در بلوک‌های سند(جا):
        اگر تیتری(ب):
            ن++
        پایان
    پایان
    برگشت ن
پایان

صفحه:
    عنوان = نام‌محصول + " | مستندات"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, Tahoma, sans-serif"
    پس زمینه = #ffffff
    رنگ = #1c2230
    ارتفاع خط = 1.65
    سرصفحه:
        چیدمان = ردیف
        تراز = وسط
        چینش = میان
        فاصله = 14، 24
        کادر پایین = 1، توپر، #e4e7ee
        موقعیت = چسبان
        بالا = 0
        پس زمینه = #ffffff
        پیوند:
            مقصد = "/"
            اندازه قلم = 20
            وزن قلم = 800
            رنگ = #0f766e
            تزیین متن = هیچ
            محتوا = نام‌محصول
        پایان
        ناوبری:
            چیدمان = ردیف
            شکاف = 18
            پیوند:
                مقصد = "/docs"
                رنگ = #1c2230
                تزیین متن = هیچ
                محتوا = "مستندات"
            پایان
            پیوند:
                مقصد = "/docs/reference/cli"
                رنگ = #1c2230
                تزیین متن = هیچ
                محتوا = "خط فرمان"
            پایان
        پایان
    پایان
    اصلی:
        نمای مسیر: پایان
    پایان
پایان
