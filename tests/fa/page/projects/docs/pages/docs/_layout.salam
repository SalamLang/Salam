همگانی بخش چیدمان‌اسناد:
    جعبه:
        چیدمان = "ردیف"
        شکستن خط = درست
        بیشینه عرض = 1200
        فضا = 0، خودکار
        منوی‌اسناد: پایان
        بخش:
            رشد = 1
            پایه = 0
            کمینه عرض = 320
            فاصله = 28، 32
            نمای مسیر: پایان
        پایان
    پایان
پایان
