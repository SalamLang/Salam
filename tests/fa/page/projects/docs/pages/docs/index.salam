همگانی بخش خانه‌ی‌اسناد:
    عنوان = "مستندات | " + نام‌محصول
    جعبه:
        شکاف = 14
        بیشینه عرض = 720
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "مستندات"
        پایان
        پاراگراف:
            فضا = 0
            محتوا = "همه‌چیز درباره‌ی " + نام‌محصول + "، از نصب اول تا آخرین کلید پیکربندی."
        پایان
        هر شماره، س در دسته‌ها():
            جعبه:
                کلید = شماره
                شکاف = 4
                h2:
                    فضا = 14، 0، 0، 0
                    اندازه قلم = 20
                    محتوا = عنوان دسته(س)
                پایان
                هر ی، د در سندها():
                    اگر د.دسته برابر س:
                        پیوند:
                            مقصد = نشانی سند(ی)
                            رنگ = "#0f766e"
                            محتوا = د.عنوان
                        پایان
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
