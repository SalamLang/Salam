همگانی بخش صفحه‌سند(دسته: رشته، نامک: رشته):
    مسیر = "/docs/:دسته/:نامک"
    جا := یافتن سند(دسته، نامک) برگردان صحیح
    اگر جا بزرگتربرابر 0:
        عنوان = سندها().بگیر(جا).عنوان + " | " + نام‌محصول
        مقاله:
            بیشینه عرض = 720
            پاراگراف:
                فضا = 0
                رنگ = "#6b7385"
                اندازه قلم = 14
                محتوا = عنوان دسته(دسته)
            پایان
            سرتیتر:
                اندازه = 1
                فضا = 4، 0، 12، 0
                محتوا = سندها().بگیر(جا).عنوان
            پایان
            فهرست‌تیترها:
                جا = جا
            پایان
            هر ب در بلوک‌های سند(جا):
                بلوک‌سند:
                    متن = ب
                پایان
            پایان
            گام‌پیمایی:
                جا = جا
            پایان
        پایان
    وگرنه:
        جعبه:
            شکاف = 10
            سرتیتر:
                اندازه = 1
                محتوا = "چنین صفحه‌ای در مستندات نیست"
            پایان
            پیوند:
                مقصد = "/docs"
                رنگ = "#0f766e"
                محتوا = "مرور مستندات"
            پایان
        پایان
    پایان
پایان
