همگانی بخش فرود:
    عنوان = نام‌محصول + " | مستندات"
    بخش:
        بیشینه عرض = 760
        فضا = 0، خودکار
        فاصله = 72، 24
        شکاف = 16
        ترازمتن = وسط
        سرتیتر:
            اندازه = 1
            فضا = 0
            اندازه قلم = 54
            محتوا = نام‌محصول
        پایان
        پاراگراف:
            فضا = 0
            اندازه قلم = 20
            رنگ = #4a5468
            محتوا = "جعبه‌ابزار کوچکی که یک پوشه‌ی متن را به پایگاه ایستای سریع تبدیل می‌کند."
        پایان
        جعبه:
            چیدمان = ردیف
            چینش = وسط
            شکاف = 12
            پیوند:
                مقصد = "/docs/start/intro"
                فاصله = 12، 22
                گردی = 12
                پس زمینه = #0f766e
                رنگ = #ffffff
                تزیین متن = هیچ
                وزن قلم = 600
                محتوا = "خواندن مستندات"
            پایان
            پیوند:
                مقصد = "/docs/start/install"
                فاصله = 12، 22
                گردی = 12
                کادر = 1، توپر، #cdd3de
                رنگ = #1c2230
                تزیین متن = هیچ
                محتوا = "نصب"
            پایان
        پایان
    پایان
پایان
