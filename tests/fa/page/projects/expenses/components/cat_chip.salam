همگانی بخش برچسب دسته(دسته: صحیح):
    دکمه:
        کلاس = "chip"
        نوع = «دکمه»
        فاصله = 5، 12
        گردی = 16
        کادر = 2، "توپر"، رنگ دسته(دسته)
        پس زمینه = (دسته برگزیده برابر دسته) ? رنگ دسته(دسته) : "#ffffff"
        رنگ = (دسته برگزیده برابر دسته) ? "#ffffff" : "#25221d"
        نشانگر = "اشاره"
        فشرده‌شده دسترسی‌پذیری = (دسته برگزیده برابر دسته)
        کلیک = (): دسته برگزیده = دسته پایان
        محتوا = نام دسته(دسته)
    پایان
پایان
