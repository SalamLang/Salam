همگانی بخش نمودار(ماه جاری: صحیح):
    جعبه:
        کلاس = "chart"
        شکاف = 8
        هر شماره، رده در دسته‌ها:
            جعبه:
                کلید = شماره
                کلاس = "bar-row"
                عرض = 100%
                چیدمان = "ردیف"
                تراز = "وسط"
                شکاف = 10
                تکه:
                    عرض = 64
                    محتوا = نام دسته(رده)
                پایان
                جعبه:
                    رشد = 1
                    کمینه عرض = 120
                    ارتفاع = 18
                    گردی = 9
                    پس زمینه = "#e8e5de"
                    جعبه:
                        کلاس = "bar"
                        ارتفاع = 18
                        گردی = 9
                        پس زمینه = رنگ دسته(رده)
                        عرض = سهم(رده، ماه جاری) + "%"
                    پایان
                پایان
                تکه:
                    کلاس = "bar-total"
                    عرض = 64
                    ترازمتن = «انتها»
                    محتوا = "$" + جمع دسته(رده، ماه جاری)
                پایان
            پایان
        پایان
    پایان
پایان
