واردسازی دام
همگانی بخش فرم هزینه:
    فرم:
        شکاف = 10
        فاصله = 14
        گردی = 14
        پس زمینه = "#ffffff"
        ارسال = (رخداد: صحیح۶۴):
            دام.جلوگیری پیش فرض(رخداد)
            افزودن هزینه()
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 8
            شکستن خط = درست
            ورودی:
                شناسه = "desc"
                رشد = 2
                کمینه عرض = 140
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#d8d4cb"
                جانگهدار = "برای چه بود؟"
                برچسب دسترسی‌پذیری = "شرح"
                پیوند = متن شرح
            پایان
            ورودی:
                شناسه = "amount"
                رشد = 1
                کمینه عرض = 90
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#d8d4cb"
                جانگهدار = "مبلغ"
                برچسب دسترسی‌پذیری = "مبلغ"
                پیوند = متن مبلغ
            پایان
            ورودی:
                شناسه = "month"
                عرض = 64
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#d8d4cb"
                برچسب دسترسی‌پذیری = "شماره‌ی ماه"
                پیوند = متن ماه
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 6
            شکستن خط = درست
            نقش = "group"
            برچسب دسترسی‌پذیری = "دسته"
            هر _، رده در دسته‌ها:
                برچسب دسته:
                    دسته = رده
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 12
            دکمه:
                شناسه = "add"
                نوع = «ارسال»
                فاصله = 10، 20
                گردی = 10
                کادر = 0
                پس زمینه = "#25221d"
                رنگ = "#ffffff"
                وزن قلم = 600
                نشانگر = "اشاره"
                محتوا = "ثبت هزینه"
            پایان
            اگر مشکل.طول() بزرگتر 0:
                تکه:
                    شناسه = "problem"
                    رنگ = "#b42318"
                    نقش = "alert"
                    محتوا = مشکل
                پایان
            پایان
        پایان
    پایان
پایان
