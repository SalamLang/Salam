همگانی بخش ردیف هزینه(جای: صحیح):
    مورد:
        کلاس = "entry"
        چیدمان = "row"
        تراز = "center"
        شکاف = 10
        فاصله = 10، 14
        گردی = 10
        پس زمینه = "#ffffff"
        جعبه:
            عرض = 10
            ارتفاع = 10
            گردی = 5
            پس زمینه = رنگ دسته(دسته‌بندی‌ها.بگیر(جای))
        پایان
        تکه:
            رشد = 1
            محتوا = شرح‌ها.بگیر(جای) + " (" + نام دسته(دسته‌بندی‌ها.بگیر(جای)) + ")"
        پایان
        تکه:
            کلاس = "amount"
            وزن قلم = 700
            محتوا = "$" + مبلغ‌ها.بگیر(جای)
        پایان
        دکمه:
            کلاس = "remove"
            کادر = 0
            پس زمینه = «شفاف»
            رنگ = "#8a857a"
            نشانگر = "pointer"
            برچسب دسترسی‌پذیری = "حذف"
            کلیک = (): حذف هزینه(جای) پایان
            محتوا = "×"
        پایان
    پایان
پایان
