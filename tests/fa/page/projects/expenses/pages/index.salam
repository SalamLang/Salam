همگانی بخش هزینه‌ها:
    عنوان = "فهرست"
    فرم هزینه: پایان
    جعبه:
        چیدمان = "ردیف"
        چینش = "میان"
        تراز = "وسط"
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "همه‌ی هزینه‌ها"
        پایان
        تکه:
            شناسه = "grand"
            وزن قلم = 700
            محتوا = "جمع: " + جمع ماه(0)
        پایان
    پایان
    اگر شرح‌ها.طول() برابر 0:
        پاراگراف:
            کلاس = "empty"
            شفافیت = 0.6
            محتوا = "هنوز هزینه‌ای ثبت نشده است."
        پایان
    وگرنه:
        فهرست:
            فاصله = 0
            فضا = 0
            شکاف = 6
            هر شماره، _ در شرح‌ها:
                ردیف هزینه:
                    کلید = شماره
                    جای = شماره
                پایان
            پایان
        پایان
    پایان
پایان
