همگانی بخش برگه ماه(ماه: صحیح):
    مسیر = "/month/:ماه"
    عنوان = "ماه"
    جعبه:
        شکاف = 12
        اگر ماه بزرگتربرابر 1 و ماه کوچکتربرابر 12:
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = نام ماه(ماه)
            پایان
            پاراگراف:
                شناسه = "month-total"
                فضا = 0
                محتوا = شمار ماه(ماه) + " هزینه، " + جمع ماه(ماه)
            پایان
            اگر شمار ماه(ماه) بزرگتر 0:
                پاراگراف:
                    شناسه = "top"
                    فضا = 0
                    محتوا = "پرخرج‌ترین دسته: " + نام دسته(دسته برتر(ماه))
                پایان
            پایان
            نمودار:
                ماه جاری = ماه
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین ماهی نیست"
            پایان
        پایان
        پیوند:
            مقصد = "/summary"
            محتوا = "بازگشت به خلاصه"
        پایان
    پایان
پایان
