همگانی بخش خلاصه:
    عنوان = "خلاصه"
    سرتیتر:
        اندازه = 1
        فضا = 0
        محتوا = "خلاصه"
    پایان
    پاراگراف:
        شناسه = "overall"
        فضا = 0
        محتوا = شمار ماه(0) + " هزینه، " + جمع ماه(0) + " تومان در مجموع"
    پایان
    نمودار:
        ماه جاری = 0
    پایان
    سرتیتر:
        اندازه = 2
        فضا = 0
        محتوا = "بر پایه‌ی ماه"
    پایان
    جعبه:
        چیدمان = "ردیف"
        شکاف = 6
        شکستن خط = درست
        هر کلید در ماه‌ها:
            اگر شمار ماه(کلید) بزرگتر 0:
                پیوند:
                    کلاس = "month-link"
                    مقصد = "/month/" + کلید
                    فاصله = 6، 12
                    گردی = 8
                    پس زمینه = "#e8e5de"
                    رنگ = "#25221d"
                    تزیین متن = «هیچ»
                    محتوا = نام ماه(کلید)
                پایان
            پایان
        پایان
    پایان
پایان
