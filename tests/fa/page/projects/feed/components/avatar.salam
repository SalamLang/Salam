همگانی بخش آواتار(nick: رشته):
    جعبه:
        عرض = 36
        ارتفاع = 36
        گردی = 50%
        تراز = "وسط"
        چینش = "وسط"
        رنگ = "#ffffff"
        وزن قلم = 700
        پس زمینه = #4a5bd8
        اگر nick برابر "bo":
            پس زمینه = #d8704a
        وگرنه nick برابر "cy":
            پس زمینه = #2f9e6e
        وگرنه nick برابر "you":
            پس زمینه = #8a4ad8
        پایان
        محتوا = nick.زیررشته(0، 1).بزرگ()
    پایان
پایان
