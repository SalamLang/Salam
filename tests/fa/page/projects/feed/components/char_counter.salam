همگانی بخش شمارنده‌حرف(مانده: صحیح):
    تکه:
        شناسه = "counter"
        وزن قلم = 600
        رنگ = #6b7385
        اگر مانده کوچکتر 20:
            رنگ = #d97706
        پایان
        اگر مانده کوچکتر 0:
            رنگ = #dc2626
        پایان
        محتوا = مانده
    پایان
پایان
