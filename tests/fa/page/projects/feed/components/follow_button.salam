همگانی بخش دکمه‌دنبال(nick: رشته، فعال: منطقی):
    دکمه:
        شناسه = "follow"
        فاصله = 8، 20
        گردی = 999
        کادر = 1، توپر، #4a5bd8
        پس زمینه = #4a5bd8
        رنگ = #ffffff
        وزن قلم = 600
        نشانگر = اشاره
        اگر فعال:
            پس زمینه = شفاف
            رنگ = #4a5bd8
        پایان
        کلیک = ():
            تغییر‌دنبال(nick)
        پایان
        محتوا = فعال ? "دنبال می‌کنید" : "دنبال کردن"
    پایان
پایان
