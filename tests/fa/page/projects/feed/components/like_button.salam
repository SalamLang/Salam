همگانی بخش دکمه‌پسند(پست: صحیح، جمع: صحیح، روشن: منطقی):
    دکمه:
        کلاس = "like"
        فاصله = 6، 12
        گردی = 999
        کادر = 1، توپر، #ccd2e0
        پس زمینه = شفاف
        نشانگر = "اشاره"
        اگر روشن:
            پس زمینه = #ffe3ea
            کادر = 1، توپر، #ff6b8b
            رنگ = #c2204a
        پایان
        کلیک = ():
            تغییر‌پسند(پست)
        پایان
        محتوا = (روشن ? "پسندیده " : "پسند ") + جمع
    پایان
پایان
