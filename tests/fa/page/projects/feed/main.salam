واردسازی دام

پایا شناسه‌ها := ["ada"، "bo"، "cy"]
پایا سقف := 140

ناپایا نویسنده‌پست := بذر‌نویسنده()
ناپایا متن‌پست := بذر‌متن()
ناپایا پسند‌پست := بذر‌پسند()
ناپایا پسندیده‌پست := بذر‌پسندیده()
ناپایا باز‌پست := بذر‌پسندیده()
ناپایا یادداشت‌پست := وکتور {} برگردان وکتور<صحیح>
ناپایا یادداشت‌متن := وکتور {} برگردان وکتور<رشته>
ناپایا دنبال‌شده := بذر‌دنبال()
ناپایا پیش‌نویس := ""
ناپایا مصرف‌شده := 0
ناپایا پاسخ‌نوشته := ""
ناپایا مشکل := ""
ناپایا شبانه := نادرست

تابع بذر‌نویسنده(): وکتور<رشته>:
    ناپایا انباشت := وکتور {} برگردان وکتور<رشته>
    انباشت.افزودن("ada")
    انباشت.افزودن("bo")
    انباشت.افزودن("ada")
    انباشت.افزودن("cy")
    انباشت.افزودن("bo")
    برگشت انباشت
پایان

تابع بذر‌متن(): وکتور<رشته>:
    ناپایا انباشت := وکتور {} برگردان وکتور<رشته>
    انباشت.افزودن("امروز مسیریاب را تحویل دادم. حالا نام فایل‌ها مسیر هستند.")
    انباشت.افزودن("اول قهوه، بعد کامپایلر.")
    انباشت.افزودن("تابع‌های کوچک، خطاهای کوچک.")
    انباشت.افزودن("کسی هفته بعد برای دورهمی سلام هست؟")
    انباشت.افزودن("دوباره مستندات صفحه را می‌خوانم، هنوز ترفند تازه پیدا می‌کنم.")
    برگشت انباشت
پایان

تابع بذر‌پسند(): وکتور<صحیح>:
    ناپایا انباشت := وکتور {} برگردان وکتور<صحیح>
    انباشت.افزودن(12)
    انباشت.افزودن(3)
    انباشت.افزودن(8)
    انباشت.افزودن(5)
    انباشت.افزودن(1)
    برگشت انباشت
پایان

تابع بذر‌پسندیده(): وکتور<صحیح>:
    ناپایا انباشت := وکتور {} برگردان وکتور<صحیح>
    انباشت.افزودن(0)
    انباشت.افزودن(0)
    انباشت.افزودن(0)
    انباشت.افزودن(0)
    انباشت.افزودن(0)
    برگشت انباشت
پایان

تابع بذر‌دنبال(): وکتور<صحیح>:
    ناپایا انباشت := وکتور {} برگردان وکتور<صحیح>
    انباشت.افزودن(0)
    انباشت.افزودن(1)
    انباشت.افزودن(0)
    برگشت انباشت
پایان

ناب تابع جایگاه‌شناسه(nick: رشته): صحیح:
    هر جایگاه، نامزد در شناسه‌ها:
        اگر نامزد برابر nick:
            برگشت جایگاه
        پایان
    پایان
    برگشت -1
پایان

ناب تابع درباره‌ی(nick: رشته): رشته:
    اگر nick برابر "ada":
        برگشت "اهل کامپایلر. اول آزمون می‌نویسد."
    وگرنه nick برابر "bo":
        برگشت "قهوه، دوچرخه و چیدمان صفحه."
    وگرنه nick برابر "cy":
        برگشت "برگزارکننده دورهمی ماهانه."
    پایان
    برگشت "اینجا کسی نیست"
پایان

ناب تابع پست‌های(nick: رشته): صحیح:
    ناپایا جمع := 0
    هر کسی در نویسنده‌پست:
        اگر کسی برابر nick:
            جمع++
        پایان
    پایان
    برگشت جمع
پایان

ناب تابع پاسخ‌های(پست: صحیح): صحیح:
    ناپایا جمع := 0
    هر هدف در یادداشت‌پست:
        اگر هدف برابر پست:
            جمع++
        پایان
    پایان
    برگشت جمع
پایان

ناب تابع دنبال‌کنندگان(nick: رشته): صحیح:
    جایگاه := جایگاه‌شناسه(nick)
    اگر جایگاه کوچکتر 0:
        برگشت 0
    پایان
    برگشت 20 + جایگاه * 7 + دنبال‌شده[جایگاه]
پایان

ناب تابع دنبال_می‌کنید(nick: رشته): منطقی:
    جایگاه := جایگاه‌شناسه(nick)
    اگر جایگاه کوچکتر 0:
        برگشت نادرست
    پایان
    برگشت دنبال‌شده[جایگاه] برابر 1
پایان

ناب تابع حرف‌مانده(): صحیح:
    برگشت سقف - مصرف‌شده
پایان

تابع تغییر‌پسند(پست: صحیح):
    اگر پسندیده‌پست[پست] برابر 1:
        پسندیده‌پست[پست] = 0
        پسند‌پست[پست] = پسند‌پست[پست] - 1
    وگرنه:
        پسندیده‌پست[پست] = 1
        پسند‌پست[پست] = پسند‌پست[پست] + 1
    پایان
پایان

تابع تغییر‌پاسخ‌ها(پست: صحیح):
    باز‌پست[پست] = 1 - باز‌پست[پست]
پایان

تابع تغییر‌دنبال(nick: رشته):
    جایگاه := جایگاه‌شناسه(nick)
    اگر جایگاه بزرگتربرابر 0:
        دنبال‌شده[جایگاه] = 1 - دنبال‌شده[جایگاه]
    پایان
پایان

تابع انتشار():
    پاک‌شده := پیش‌نویس.پیراست()
    اگر مصرف‌شده برابر 0 یا پاک‌شده.طول() برابر 0:
        مشکل = "اول چیزی بنویسید"
        برگشت
    پایان
    اگر مصرف‌شده بزرگتر سقف:
        مشکل = "این " + (مصرف‌شده - سقف) + " حرف بیشتر از حد است"
        برگشت
    پایان
    نویسنده‌پست.درج(0، "you")
    متن‌پست.درج(0، پاک‌شده)
    پسند‌پست.درج(0، 0)
    پسندیده‌پست.درج(0، 0)
    باز‌پست.درج(0، 0)
    تکرار یادداشت‌پست.طول() در جایگاه:
        یادداشت‌پست[جایگاه] = یادداشت‌پست[جایگاه] + 1
    پایان
    پیش‌نویس = ""
    مصرف‌شده = 0
    مشکل = ""
    صفحه.مسیر.برو("/")
پایان

تابع افزودن‌پاسخ(پست: صحیح):
    پاک‌شده := پاسخ‌نوشته.پیراست()
    اگر پاک‌شده.طول() برابر 0:
        برگشت
    پایان
    یادداشت‌پست.افزودن(پست)
    یادداشت‌متن.افزودن(پاک‌شده)
    پاسخ‌نوشته = ""
پایان

تابع فرستادن‌پاسخ(رویداد: صحیح۶۴، پست: صحیح):
    دام.جلوگیری پیش فرض(رویداد)
    افزودن‌پاسخ(پست)
پایان

تابع کلید‌نوشتن(رویداد: صحیح۶۴):
    نگه‌داشته := دام.دریافت خاصیت منطقی(رویداد، "ctrlKey") یا دام.دریافت خاصیت منطقی(رویداد، "metaKey")
    اگر نگه‌داشته و دام.کلید رویداد(رویداد) برابر "Enter":
        دام.جلوگیری پیش فرض(رویداد)
        انتشار()
    پایان
پایان

تابع نوشته‌شد(حروف: رشته):
    پیش‌نویس = حروف
    مصرف‌شده = دام.دریافت خاصیت عددی(دام.با شناسه("draft")، "textLength") برگردان صحیح
    مشکل = ""
پایان

همگانی بخش کارت‌پست(پست: صحیح، نویسنده: رشته، نوشتار: رشته، پسندها: صحیح، پسندیدی: صحیح، بازشده: صحیح):
    مقاله:
        شکاف = 10
        فاصله = 16
        گردی = 14
        پس زمینه = "#ffffff"
        کادر = 1، "توپر"، "#e3e6ee"
        اگر شبانه:
            پس زمینه = "#1b2130"
            کادر = 1، "توپر"، "#2c3548"
        پایان
        جعبه:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 10
            آواتار:
                nick = نویسنده
            پایان
            پیوند:
                to = "/u/" + نویسنده
                وزن قلم = 700
                رنگ = "#4a5bd8"
                تزیین متن = "هیچ"
                محتوا = "@" + نویسنده
            پایان
        پایان
        پاراگراف:
            فضا = 0
            ارتفاع خط = 1.5
            محتوا = نوشتار
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 8
            دکمه‌پسند:
                پست = پست
                جمع = پسندها
                روشن = (پسندیدی برابر 1)
            پایان
            دکمه:
                کلاس = "notes"
                فاصله = 6، 12
                گردی = 999
                کادر = 1، "توپر"، "#ccd2e0"
                پس زمینه = "شفاف"
                نشانگر = "اشاره"
                کلیک = ():
                    تغییر‌پاسخ‌ها(پست)
                پایان
                محتوا = "پاسخ‌ها " + پاسخ‌های(پست)
            پایان
        پایان
        اگر بازشده برابر 1:
            جعبه:
                شکاف = 6
                هر جایگاه، کسی در یادداشت‌پست:
                    اگر کسی برابر پست:
                        پاراگراف:
                            کلید = جایگاه
                            فضا = 0
                            فاصله = 6، 10
                            گردی = 10
                            پس زمینه = "#f1f3f9"
                            رنگ = "#1b2230"
                            محتوا = یادداشت‌متن[جایگاه]
                        پایان
                    پایان
                پایان
                فرم:
                    چیدمان = "ردیف"
                    شکاف = 6
                    ارسال = (رویداد: صحیح۶۴):
                        فرستادن‌پاسخ(رویداد، پست)
                    پایان
                    ورودی:
                        کلاس = "note-input"
                        رشد = 1
                        فاصله = 6، 10
                        گردی = 999
                        کادر = 1، "توپر"، "#ccd2e0"
                        جانگهدار = "پاسخ"
                        پیوند = پاسخ‌نوشته
                    پایان
                    دکمه:
                        نوع = "ارسال"
                        فاصله = 6، 14
                        گردی = 999
                        کادر = 0
                        پس زمینه = "#4a5bd8"
                        رنگ = "#ffffff"
                        نشانگر = "اشاره"
                        محتوا = "پاسخ"
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "جیک‌جیک"
    زبان = "fa"
    قلم = "Tahoma, system-ui, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = "#f4f5fa"
        رنگ = "#1b2230"
        اگر شبانه:
            پس زمینه = "#0f1320"
            رنگ = "#e6e9f2"
        پایان
        سرصفحه:
            چیدمان = "ردیف"
            تراز = "وسط"
            چینش = "میان"
            فاصله = 14، 24
            پس زمینه = "#4a5bd8"
            پیوند:
                to = "/"
                اندازه قلم = 22
                وزن قلم = 800
                رنگ = "#ffffff"
                تزیین متن = "هیچ"
                محتوا = "جیک‌جیک"
            پایان
            ناوبری:
                چیدمان = "ردیف"
                شکاف = 8
                پیوند:
                    to = "/compose"
                    فاصله = 8، 16
                    گردی = 999
                    پس زمینه = "#ffffff"
                    رنگ = "#4a5bd8"
                    وزن قلم = 600
                    تزیین متن = "هیچ"
                    محتوا = "پست تازه"
                پایان
                پیوند:
                    to = "/u/you"
                    فاصله = 8، 16
                    رنگ = "#ffffff"
                    تزیین متن = "هیچ"
                    محتوا = "نمایه"
                پایان
                دکمه:
                    شناسه = "night"
                    فاصله = 8، 12
                    گردی = 999
                    کادر = 1، "توپر"، "#ffffff"
                    پس زمینه = "شفاف"
                    رنگ = "#ffffff"
                    نشانگر = "اشاره"
                    کلیک = ():
                        شبانه = وارونه شبانه
                    پایان
                    محتوا = شبانه ? "روشن" : "تاریک"
                پایان
            پایان
        پایان
        اصلی:
            بیشینه عرض = 640
            عرض = 100%
            فضا = 0، "خودکار"
            فاصله = 20، 16
            نمای مسیر: پایان
        پایان
    پایان
پایان
