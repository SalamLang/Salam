همگانی بخش نوشتن:
    عنوان = "پست تازه"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "پست تازه"
        پایان
        جعبه:
            فشردن کلید = کلید‌نوشتن
            شکاف = 8
            ورودی:
                شناسه = "draft"
                نوع = "ناحیه متن"
                ردیف‌ها = 5
                فاصله = 12
                گردی = 12
                کادر = 1، "توپر"، "#ccd2e0"
                اندازه قلم = 16
                جانگهدار = "چه خبر؟ با Ctrl+Enter منتشر کنید."
                مقدار = پیش‌نویس
                ورودی = (حروف: رشته):
                    نوشته‌شد(حروف)
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            تراز = "وسط"
            چینش = "میان"
            شمارنده‌حرف:
                مانده = حرف‌مانده()
            پایان
            دکمه:
                شناسه = "post"
                فاصله = 10، 22
                گردی = 999
                کادر = 0
                پس زمینه = "#4a5bd8"
                رنگ = "#ffffff"
                وزن قلم = 600
                نشانگر = "اشاره"
                کلیک = انتشار
                محتوا = "انتشار"
            پایان
        پایان
        اگر مشکل.طول() بزرگتر 0:
            پاراگراف:
                شناسه = "problem"
                فضا = 0
                رنگ = "#dc2626"
                محتوا = مشکل
            پایان
        پایان
    پایان
پایان
