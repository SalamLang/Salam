همگانی بخش خط‌زمانی:
    عنوان = "جیک‌جیک"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "تازه‌ترین پست‌ها"
        پایان
        هر جایگاه، نگارنده در نویسنده‌پست:
            کارت‌پست:
                کلید = جایگاه
                پست = جایگاه
                نویسنده = نگارنده
                نوشتار = متن‌پست[جایگاه]
                پسندها = پسند‌پست[جایگاه]
                پسندیدی = پسندیده‌پست[جایگاه]
                بازشده = باز‌پست[جایگاه]
            پایان
        پایان
    پایان
پایان
