// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش نمایه(nick: رشته):
    عنوان = "@" + nick
    جعبه:
        شکاف = 14
        اگر جایگاه‌شناسه(nick) بزرگتربرابر 0 یا nick برابر "you":
            جعبه:
                چیدمان = "ردیف"
                تراز = "وسط"
                شکاف = 14
                آواتار:
                    nick = nick
                پایان
                جعبه:
                    رشد = 1
                    سرتیتر:
                        شناسه = "who"
                        اندازه = 2
                        فضا = 0
                        محتوا = "@" + nick
                    پایان
                    پاراگراف:
                        فضا = 0
                        شفافیت = 0.7
                        محتوا = درباره‌ی(nick)
                    پایان
                پایان
                اگر nick نابرابر "you":
                    دکمه‌دنبال:
                        nick = nick
                        فعال = (دنبال‌شده[جایگاه‌شناسه(nick)] برابر 1)
                    پایان
                پایان
            پایان
            پاراگراف:
                شناسه = "stats"
                فضا = 0
                محتوا = پست‌های(nick) + " پست، " + دنبال‌کنندگان(nick) + " دنبال‌کننده"
            پایان
            هر جایگاه، نگارنده در نویسنده‌پست:
                اگر نگارنده برابر nick:
                    کارت‌پست:
                        پست = جایگاه
                        نویسنده = نگارنده
                        نوشتار = متن‌پست[جایگاه]
                        پسندها = پسند‌پست[جایگاه]
                        پسندیدی = پسندیده‌پست[جایگاه]
                        بازشده = باز‌پست[جایگاه]
                    پایان
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 2
                محتوا = "چنین کاربری نیست"
            پایان
            پیوند:
                to = "/"
                محتوا = "بازگشت به خط زمانی"
            پایان
        پایان
    پایان
پایان
