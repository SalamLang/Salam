همگانی بخش فیلد فرم(نام نمایشی: رشته، کد فیلد: رشته، ایراد: رشته، نمایان: منطقی):
    جعبه:
        شکاف = 4
        برچسب:
            برای = کد فیلد
            وزن قلم = 600
            محتوا = نام نمایشی
        پایان
        content: پایان
        اگر نمایان و ایراد نابرابر "":
            ریز:
                شناسه = کد فیلد + "-error"
                رنگ = #b42318
                محتوا = ایراد
            پایان
        پایان
    پایان
پایان

همگانی بخش فیلد ساده(نام نمایشی: رشته، کد فیلد: رشته):
    جعبه:
        شکاف = 4
        برچسب:
            برای = کد فیلد
            وزن قلم = 600
            محتوا = نام نمایشی
        پایان
        content: پایان
    پایان
پایان

همگانی بخش پیام فرم(رده پیام: رشته، پیغام: رشته):
    جعبه:
        فاصله = 12، 16
        گردی = 10
        پس زمینه = #e7f6ec
        رنگ = #14532d
        اگر رده پیام برابر "error":
            پس زمینه = #fdecea
            رنگ = #7a1f12
        پایان
        محتوا = پیغام
    پایان
پایان

همگانی بخش ردیف خلاصه(کلید ردیف: رشته، مقدار ردیف: رشته):
    جعبه:
        چیدمان = ردیف
        شکاف = 12
        فاصله = 8، 0
        کادر پایین = 1، توپر، #d9dcf2
        قوی:
            عرض = 140
            محتوا = کلید ردیف
        پایان
        تکه:
            محتوا = (مقدار ردیف برابر "" ? "-" : مقدار ردیف)
        پایان
    پایان
پایان
