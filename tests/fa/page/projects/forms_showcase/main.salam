            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 16
            فاصله = 14، 28
            پس زمینه = "#2b2f77"
            قوی:
                رنگ = "#ffffff"
                اندازه قلم = 20
                محتوا = "هکاتون آخر هفته"
            پایان
            ناوبری:
                چیدمان = "ردیف"
                شکاف = 6
                پیوند:
                    مقصد = "/"
                    فاصله = 6، 12
                    گردی = 8
                    رنگ = "#dfe2ff"
                    تزیین متن = "هیچ"
                    محتوا = "درباره"
                پایان
                پیوند:
                    مقصد = "/register"
                    فاصله = 6، 12
                    گردی = 8
                    رنگ = "#dfe2ff"
                    تزیین متن = "هیچ"
                    محتوا = "ثبت‌نام"
                پایان
                اگر ثبت شد:
                    پیوند:
                        مقصد = "/review"
                        فاصله = 6، 12
                        گردی = 8
                        رنگ = "#dfe2ff"
                        تزیین متن = "هیچ"
                        محتوا = "ثبت‌نام شما"
                    پایان
                پایان
            پایان
        پایان
        اصلی:
            بیشینه عرض = 680
            فضا = 0، "خودکار"
            فاصله = 28
            نمای مسیر: پایان
        پایان
    پایان
