// انتظار: یک نشانی رایانامه درست بنویس
// انتظار: گذرواژه‌ها یکی نیستند
واردسازی دام

ناپایا نام کامل := ""
ناپایا رایانامه من := ""
ناپایا سن := ""
ناپایا رمز ورود := ""
ناپایا تکرار‌رمز := ""
ناپایا درباره من := ""
ناپایا شهر := ""
ناپایا بسته_ := "free"
ناپایا میزان تجربه := "5"
ناپایا روز شروع := ""
ناپایا نام رزومه := ""
ناپایا خبرنامه := نادرست
ناپایا قوانین := نادرست
ناپایا تلاش‌شد := نادرست
ناپایا ثبت شد := نادرست

تابع خطای نام(): رشته:
    اگر نام کامل.طول() کوچکتر 2:
        برگشت "نامت را بنویس (دست‌کم دو حرف)"
    پایان
    برگشت ""
پایان

تابع خطای رایانامه(): رشته:
    اگر وارونه (رایانامه من.دربردارد("@") و رایانامه من.دربردارد(".")) یا رایانامه من.طول() کوچکتر 6:
        برگشت "یک نشانی رایانامه درست بنویس"
    پایان
    برگشت ""
پایان

تابع خطای سن(): رشته:
    اگر سن.طول() برابر 0 یا سن.طول() بزرگتر 3:
        برگشت "سن عددی بین ۱۶ تا ۱۲۰ است"
    پایان
    عدد := سن.به صحیح()
    اگر عدد کوچکتر 16 یا عدد بزرگتر 120:
        برگشت "سن عددی بین ۱۶ تا ۱۲۰ است"
    پایان
    برگشت ""
پایان

تابع خطای رمز(): رشته:
    اگر رمز ورود.طول() کوچکتر 8:
        برگشت "دست‌کم هشت نویسه بنویس"
    پایان
    برگشت ""
پایان

تابع خطای‌تکرار(): رشته:
    اگر تکرار‌رمز نابرابر رمز ورود:
        برگشت "گذرواژه‌ها یکی نیستند"
    پایان
    برگشت ""
پایان

تابع خطای شهر(): رشته:
    اگر شهر برابر "":
        برگشت "شهر را انتخاب کن"
    پایان
    برگشت ""
پایان

تابع خطای قوانین(): رشته:
    اگر وارونه قوانین:
        برگشت "باید قوانین را بپذیری"
    پایان
    برگشت ""
پایان

تابع فرم‌درست‌است(): منطقی:
    برگشت خطای نام() برابر "" و خطای رایانامه() برابر "" و خطای سن() برابر "" و خطای رمز() برابر "" و خطای‌تکرار() برابر "" و خطای شهر() برابر "" و خطای قوانین() برابر ""
پایان

تابع شمار ایرادها(): صحیح:
    ناپایا عدد := 0
    اگر خطای نام() نابرابر "":
        عدد++
    پایان
    اگر خطای رایانامه() نابرابر "":
        عدد++
    پایان
    اگر خطای سن() نابرابر "":
        عدد++
    پایان
    اگر خطای رمز() نابرابر "":
        عدد++
    پایان
    اگر خطای‌تکرار() نابرابر "":
        عدد++
    پایان
    اگر خطای شهر() نابرابر "":
        عدد++
    پایان
    اگر خطای قوانین() نابرابر "":
        عدد++
    پایان
    برگشت عدد
پایان

تابع ثبت فرم(ی: صحیح۶۴):
    دام.جلوگیری پیش فرض(ی)
    تلاش‌شد = درست
    اگر فرم‌درست‌است():
        ثبت شد = درست
        صفحه.مسیر.برو("/review")
    پایان
پایان

تابع از نو():
    نام کامل = ""
    رایانامه من = ""
    سن = ""
    رمز ورود = ""
    تکرار‌رمز = ""
    درباره من = ""
    شهر = ""
    بسته_ = "free"
    میزان تجربه = "5"
    روز شروع = ""
    نام رزومه = ""
    خبرنامه = نادرست
    قوانین = نادرست
    تلاش‌شد = نادرست
    ثبت شد = نادرست
    صفحه.مسیر.برو("/register")
پایان

صفحه:
    حالت = "هش"
    عنوان = "هکاتون آخر هفته"
    زبان = "fa"
    قلم = "Vazirmatn, system-ui, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = "#f3f4fb"
        رنگ = "#1e2140"
