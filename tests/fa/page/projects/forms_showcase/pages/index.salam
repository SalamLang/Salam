همگانی بخش معرفی:
    عنوان = "هکاتون آخر هفته"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 1
            محتوا = "هکاتون آخر هفته"
        پایان
        پاراگراف:
            محتوا = "دو روز، یک ایده، گروه‌های کوچک. فرم را پر کن تا جایت را رزرو کنیم."
        پایان
        پیوند:
            مقصد = "/register"
            خود تراز = روز شروع
            فاصله = 10، 20
            گردی = 10
            پس زمینه = "#2b2f77"
            رنگ = "#ffffff"
            تزیین متن = "هیچ"
            محتوا = "همین حالا ثبت‌نام کن"
        پایان
        اگر ثبت شد:
            پیام فرم:
                رده پیام = "ok"
                پیغام = "ممنون " + نام کامل + "، ثبت‌نامت انجام شد."
            پایان
        پایان
    پایان
پایان
