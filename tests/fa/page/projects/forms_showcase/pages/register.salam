// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش صفحه‌ثبت‌نام:
    عنوان = "ثبت‌نام"
    فرم:
        شناسه = "signup"
        شکاف = 16
        ارسال = ثبت فرم
        سرتیتر:
            اندازه = 1
            محتوا = "ثبت‌نام"
        پایان
        اگر تلاش‌شد و شمار ایرادها() بزرگتر 0:
            پیام فرم:
                رده پیام = "error"
                پیغام = شمار ایرادها() + " فیلد نیاز به بررسی دارد"
            پایان
        پایان
        فیلد فرم:
            نام نمایشی = "نام و نام خانوادگی"
            کد فیلد = "name"
            ایراد = خطای نام()
            نمایان = تلاش‌شد
            ورودی:
                شناسه = "name"
                تکمیل خودکار = نام
                جانگهدار = "سارا احمدی"
                فاصله = 10، 12
                گردی = 8
                کادر = 1، توپر، #b8bce0
                پیوند = نام کامل
            پایان
        پایان
        فیلد فرم:
            نام نمایشی = "رایانامه"
            کد فیلد = "mail"
            ایراد = خطای رایانامه()
            نمایان = تلاش‌شد
            ورودی:
                شناسه = "mail"
                نوع = ایمیل
                تکمیل خودکار = رایانامه
                فاصله = 10، 12
                گردی = 8
                کادر = 1، توپر، #b8bce0
                پیوند = رایانامه من
            پایان
        پایان
        فیلد فرم:
            نام نمایشی = "سن"
            کد فیلد = "age"
            ایراد = خطای سن()
            نمایان = تلاش‌شد
            ورودی:
                شناسه = "age"
                نوع = عدد
                کمینه = 16
                بیشینه = 120
                فاصله = 10، 12
                گردی = 8
                کادر = 1، توپر، #b8bce0
                مقدار = سن
                ورودی = (و_: رشته): سن = و_ پایان
            پایان
        پایان
        فیلد فرم:
            نام نمایشی = "گذرواژه"
            کد فیلد = "secret"
            ایراد = خطای رمز()
            نمایان = تلاش‌شد
            ورودی:
                شناسه = "secret"
                نوع = گذرواژه
                تکمیل خودکار = "new-password"
                فاصله = 10، 12
                گردی = 8
                کادر = 1، توپر، #b8bce0
                پیوند = رمز ورود
            پایان
        پایان
        فیلد فرم:
            نام نمایشی = "تکرار گذرواژه"
            کد فیلد = "again"
            ایراد = خطای‌تکرار()
            نمایان = تلاش‌شد
            ورودی:
                شناسه = "again"
                نوع = گذرواژه
                تکمیل خودکار = "new-password"
                فاصله = 10، 12
                گردی = 8
                کادر = 1، توپر، #b8bce0
                پیوند = تکرار‌رمز
            پایان
        پایان
        فیلد فرم:
            نام نمایشی = "شهر"
            کد فیلد = "city"
            ایراد = خطای شهر()
            نمایان = تلاش‌شد
            انتخاب:
                شناسه = "city"
                فاصله = 10، 12
                گردی = 8
                تغییر = (و_: رشته): شهر = و_ پایان
                گزینه:
                    مقدار = ""
                    محتوا = "یک شهر انتخاب کن"
                پایان
                گروه گزینه:
                    برچسب = "شمال"
                    گزینه:
                        مقدار = "tehran"
                        محتوا = "تهران"
                    پایان
                    گزینه:
                        مقدار = "isfahan"
                        محتوا = "اصفهان"
                    پایان
                پایان
                گروه گزینه:
                    برچسب = "جنوب"
                    گزینه:
                        مقدار = "shiraz"
                        محتوا = "شیراز"
                    پایان
                پایان
            پایان
        پایان
        گروه فیلد:
            عنوان گروه:
                محتوا = "بلیت"
            پایان
            برچسب:
                چیدمان = ردیف
                شکاف = 8
                ورودی:
                    شناسه = "plan-free"
                    نوع = رادیویی
                    نام = "plan"
                    تیک خورده = (بسته_ برابر "free")
                    تغییر = (): بسته_ = "free" پایان
                پایان
                تکه:
                    محتوا = "رایگان (فقط کارگاه)"
                پایان
            پایان
            برچسب:
                چیدمان = ردیف
                شکاف = 8
                ورودی:
                    شناسه = "plan-pro"
                    نوع = رادیویی
                    نام = "plan"
                    تیک خورده = (بسته_ برابر "pro")
                    تغییر = (): بسته_ = "pro" پایان
                پایان
                تکه:
                    محتوا = "ویژه (کارگاه و شام)"
                پایان
            پایان
        پایان
        فیلد ساده:
            نام نمایشی = "تجربه: " + میزان تجربه + " از ۱۰"
            کد فیلد = "level"
            ورودی:
                شناسه = "level"
                نوع = بازه
                کمینه = 1
                بیشینه = 10
                مقدار = میزان تجربه
                ورودی = (و_: رشته): میزان تجربه = و_ پایان
            پایان
        پایان
        فیلد ساده:
            نام نمایشی = "روز شروع"
            کد فیلد = "start"
            ورودی:
                شناسه = "start"
                نوع = تاریخ
                فاصله = 8، 12
                گردی = 8
                کادر = 1، توپر، #b8bce0
                مقدار = روز شروع
                تغییر = (و_: رشته): روز شروع = و_ پایان
            پایان
        پایان
        فیلد ساده:
            نام نمایشی = "درباره‌ات (" + (200 - درباره من.طول()) + " نویسه مانده)"
            کد فیلد = "bio"
            ورودی:
                شناسه = "bio"
                نوع = ناحیه‌متن
                ردیف‌ها = 4
                بیشینه طول = 200
                فاصله = 10، 12
                گردی = 8
                کادر = 1، توپر، #b8bce0
                پیوند = درباره من
            پایان
        پایان
        فیلد ساده:
            نام نمایشی = "رزومه (اختیاری)" + (نام رزومه برابر "" ? "" : ": " + نام رزومه)
            کد فیلد = "cv"
            ورودی:
                شناسه = "cv"
                نوع = پرونده
                پذیرش = ".pdf,.txt"
                تغییر = ():
                    پرونده‌ها := دام.دریافت خاصیت(دام.با شناسه("cv")، "files")
                    اگر دام.تعداد(پرونده‌ها) بزرگتر 0:
                        نام رزومه = دام.دریافت خاصیت رشته ای(دام.عنصر شماره(پرونده‌ها، 0)، "name")
                    وگرنه:
                        نام رزومه = ""
                    پایان
                پایان
            پایان
        پایان
        برچسب:
            چیدمان = ردیف
            شکاف = 8
            ورودی:
                شناسه = "news"
                نوع = تیک
                پیوند = خبرنامه
            پایان
            تکه:
                محتوا = "برنامه را با رایانامه بفرستید"
            پایان
        پایان
        فیلد فرم:
            نام نمایشی = ""
            کد فیلد = "terms"
            ایراد = خطای قوانین()
            نمایان = تلاش‌شد
            برچسب:
                چیدمان = ردیف
                شکاف = 8
                ورودی:
                    شناسه = "terms"
                    نوع = تیک
                    پیوند = قوانین
                پایان
                تکه:
                    محتوا = "قوانین را می‌پذیرم"
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = ردیف
            شکاف = 10
            دکمه:
                شناسه = "send"
                نوع = ارسال
                فاصله = 12، 24
                گردی = 10
                کادر = 0
                پس زمینه = #2b2f77
                رنگ = #ffffff
                وزن قلم = 600
                غیرفعال:
                    شفافیت = 0.5
                پایان
                غیرفعال = (تلاش‌شد و وارونه فرم‌درست‌است())
                محتوا = "ارسال ثبت‌نام"
            پایان
            دکمه:
                شناسه = "clear"
                نوع = دکمه
                فاصله = 12، 20
                گردی = 10
                کادر = 1، توپر، #b8bce0
                پس زمینه = شفاف
                کلیک = از نو
                محتوا = "پاک کردن"
            پایان
        پایان
    پایان
پایان
