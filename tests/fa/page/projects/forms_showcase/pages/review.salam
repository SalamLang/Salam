همگانی بخش بازبینی:
    عنوان = "ثبت‌نام شما"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "ثبت‌نام شما"
        پایان
        اگر وارونه ثبت شد:
            پیام فرم:
                رده پیام = "error"
                پیغام = "هنوز چیزی ثبت نشده است."
            پایان
            پیوند:
                مقصد = "/register"
                محتوا = "رفتن به فرم"
            پایان
        وگرنه:
            ردیف خلاصه:
                کلید ردیف = "نام"
                مقدار ردیف = نام کامل
            پایان
            ردیف خلاصه:
                کلید ردیف = "رایانامه"
                مقدار ردیف = رایانامه من
            پایان
            ردیف خلاصه:
                کلید ردیف = "سن"
                مقدار ردیف = سن
            پایان
            ردیف خلاصه:
                کلید ردیف = "شهر"
                مقدار ردیف = شهر
            پایان
            ردیف خلاصه:
                کلید ردیف = "بلیت"
                مقدار ردیف = بسته_
            پایان
            ردیف خلاصه:
                کلید ردیف = "تجربه"
                مقدار ردیف = میزان تجربه + " از ۱۰"
            پایان
            ردیف خلاصه:
                کلید ردیف = "روز شروع"
                مقدار ردیف = روز شروع
            پایان
            ردیف خلاصه:
                کلید ردیف = "رزومه"
                مقدار ردیف = نام رزومه
            پایان
            ردیف خلاصه:
                کلید ردیف = "نامه برنامه"
                مقدار ردیف = خبرنامه ? "بله" : "خیر"
            پایان
            دکمه:
                شناسه = "again-btn"
                خود تراز = روز شروع
                فاصله = 10، 18
                گردی = 10
                کلیک = از نو
                محتوا = "ثبت‌نام نفر بعدی"
            پایان
        پایان
    پایان
پایان
