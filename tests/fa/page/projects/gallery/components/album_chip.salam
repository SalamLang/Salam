همگانی بخش تراشه‌آلبوم(آلبوم: صحیح، برچسب: رشته، برگزیده: منطقی):
    دکمه:
        کلاس = "chip"
        فاصله = 8، 16
        گردی = 999
        کادر = 1، "توپر"، "#c2410c"
        پس زمینه = شفاف
        رنگ = #c2410c
        نشانگر = "اشاره"
        اگر برگزیده:
            پس زمینه = #c2410c
            رنگ = #ffffff
        پایان
        کلیک = ():
            گزینش‌آلبوم(آلبوم)
        پایان
        محتوا = برچسب
    پایان
پایان
