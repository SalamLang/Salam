همگانی بخش دکمه‌دل(عکس: صحیح، روشن: منطقی):
    دکمه:
        کلاس = "heart"
        عرض = "پر"
        فاصله = 8
        کادر = 0
        کادر بالا = 1، توپر، #e2e5ea
        پس زمینه = "شفاف"
        رنگ = #6b7385
        نشانگر = "اشاره"
        اگر روشن:
            رنگ = #e11d48
        پایان
        کلیک = ():
            تغییر‌ستاره(عکس)
        پایان
        محتوا = روشن ? "♥ ذخیره شد" : "♡ ذخیره"
    پایان
پایان
