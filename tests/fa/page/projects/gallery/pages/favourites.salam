همگانی بخش برگزیده‌ها:
    عنوان = "برگزیده‌ها"
    جعبه:
        شکاف = 16
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "برگزیده‌ها"
        پایان
        اگر جمع‌ستاره() برابر 0:
            پاراگراف:
                id = "none"
                محتوا = "هنوز چیزی ذخیره نشده. روی یک عکس «ذخیره» را بزنید."
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 14
            هر _، عکس در عکس‌ها:
                اگر ستاره‌دار[عکس] برابر 1:
                    کاشی:
                        عکس = عکس
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
