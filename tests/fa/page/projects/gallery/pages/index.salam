همگانی بخش شبکه:
    عنوان = "نورگاه"
    جعبه:
        شکاف = 16
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "عکس‌ها"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 8
            تراشه‌آلبوم:
                آلبوم = -1
                برچسب = "همه"
                برگزیده = (آلبوم‌کنونی کوچکتر 0)
            پایان
            هر آلبوم در آلبوم‌ها:
                تراشه‌آلبوم:
                    آلبوم = آلبوم
                    برچسب = نام‌آلبوم(آلبوم)
                    برگزیده = (آلبوم‌کنونی برابر آلبوم)
                پایان
            پایان
        پایان
        پاراگراف:
            شناسه = "shown"
            فضا = 0
            شفافیت = 0.7
            محتوا = جمع‌نمایش() + " عکس"
        پایان
        اگر اخیر بزرگتربرابر 0:
            پاراگراف:
                شناسه = "recent"
                فضا = 0
                شفافیت = 0.7
                محتوا = "آخرین بازشده: " + عنوان‌عکس(اخیر)
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 14
            هر عکس در عکس‌ها:
                اگر نمایش‌داده(عکس):
                    کاشی:
                        عکس = عکس
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
