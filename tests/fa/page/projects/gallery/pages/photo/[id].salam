 */
همگانی بخش نمایشگر(id: صحیح):
    عنوان = عنوان‌عکس(id)
    جعبه:
        فشردن کلید = کلید‌مرور
        ترتیب جهش = 0
        id = "viewer"
        شکاف = 14
        اگر id بزرگتربرابر 0 و id کوچکتر 12:
            جعبه:
                چیدمان = "ردیف"
                تراز = "وسط"
                چینش = "میان"
                پیوند:
                    to = "/"
                    رنگ = "#c2410c"
                    تزیین متن = "هیچ"
                    محتوا = "بازگشت به شبکه"
                پایان
                ریز:
                    شفافیت = 0.65
                    محتوا = "کلیدها: چپ، راست، f برای ذخیره، Escape برای بستن"
                پایان
            پایان
            جعبه:
                ارتفاع = 340
                گردی = 20
                تراز = "وسط"
                چینش = "وسط"
                اندازه قلم = 140
                پس زمینه = رنگ‌عکس(id)
                محتوا = نماد‌عکس(id)
            پایان
            سرتیتر:
                id = "caption"
                اندازه = 2
                فضا = 0
                محتوا = عنوان‌عکس(id)
            پایان
            پاراگراف:
                فضا = 0
                شفافیت = 0.7
                محتوا = نام‌آلبوم(آلبوم‌عکس(id)) + " ، عکس " + (id + 1) + " از ۱۲"
            پایان
            جعبه:
                چیدمان = "ردیف"
                شکاف = 8
                پیوند:
                    id = "prev"
                    to = "/photo/" + همسایه(id، -1)
                    فاصله = 8، 16
                    گردی = 999
                    کادر = 1، توپر، #c2410c
                    رنگ = "#c2410c"
                    تزیین متن = "هیچ"
                    محتوا = "قبلی"
                پایان
                پیوند:
                    id = "next"
                    to = "/photo/" + همسایه(id، 1)
                    فاصله = 8، 16
                    گردی = 999
                    کادر = 1، توپر، #c2410c
                    رنگ = "#c2410c"
                    تزیین متن = "هیچ"
                    محتوا = "بعدی"
                پایان
                دکمه:
                    id = "star"
                    فاصله = 8، 16
                    گردی = 999
                    کادر = 0
                    پس زمینه = "#c2410c"
                    رنگ = "#ffffff"
                    نشانگر = "اشاره"
                    کلیک = ():
                        تغییر‌ستاره(id)
                    پایان
                    محتوا = (ستاره‌دار[id] برابر 1) ? "حذف از برگزیده‌ها" : "افزودن به برگزیده‌ها"
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 2
                محتوا = "چنین عکسی نیست"
            پایان
            پیوند:
                to = "/"
                محتوا = "بازگشت به شبکه"
            پایان
        پایان
    پایان
پایان
