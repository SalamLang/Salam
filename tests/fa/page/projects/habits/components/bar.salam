    جعبه:
        چیدمان = "row"
        تراز = "center"
        شکاف = 10
        تکه:
            عرض = 140
            محتوا = برچسب
        پایان
        جعبه:
            رشد = 1
            ارتفاع = 14
            گردی = 7
            پس زمینه = "#dbe7df"
            جعبه:
                کلاس = "fill"
                ارتفاع = 14
                گردی = 7
                پس زمینه = "#1f6f4a"
                عرض = مقدار + "%"
            پایان
        پایان
        تکه:
            کلاس = "pct"
            عرض = 44
            ترازمتن = «انتها»
            محتوا = مقدار + "%"
        پایان
    پایان
