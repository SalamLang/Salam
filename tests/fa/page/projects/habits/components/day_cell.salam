همگانی بخش خانه روز(مورد: صحیح، روز: صحیح):
    دکمه:
        کلاس = "cell"
        عرض = 36
        ارتفاع = 36
        گردی = 8
        کادر = 1، "solid"، "#b8cabf"
        نشانگر = "pointer"
        پس زمینه = انجام شده(مورد، روز) ? "#1f6f4a" : "#ffffff"
        رنگ = "#ffffff"
        برچسب دسترسی‌پذیری = نام‌ها.بگیر(مورد) + " " + نام روز(روز)
        فشرده‌شده دسترسی‌پذیری = انجام شده(مورد، روز)
        کلیک = (): تغییر روز(مورد، روز) پایان
        محتوا = انجام شده(مورد، روز) ? "✓" : ""
    پایان
پایان
