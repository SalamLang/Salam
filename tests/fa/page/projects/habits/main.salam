// انتظار: <meta name="salam-router" content="history">
// انتظار: عادت‌ها
// انتظار نه: var __salam_rt_hash = true
واردسازی دام

پایا روزها := [0، 1، 2، 3، 4، 5، 6]

ناپایا نام‌ها := بارگذاری نام‌ها()
ناپایا نشانه‌ها := بارگذاری نشانه‌ها()
ناپایا پیش‌نویس := ""
ناپایا مشکل := ""

تابع رکوردها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    خام := دام.دریافت متن ذخیره("habits.list")
    اگر خام.طول() برابر 0:
        خروجی.افزودن("نوشیدن آب\t1110110")
        خروجی.افزودن("خواندن ۲۰ صفحه\t0110000")
        خروجی.افزودن("پیاده‌روی\t1011100")
        برگشت خروجی
    پایان
    تکه‌ها := خام.بشکاف("\n")
    تکرار تکه‌ها.طول() در شماره:
        اگر تکه‌ها.بگیر(شماره).طول() بزرگتر 8:
            خروجی.افزودن(تکه‌ها.بگیر(شماره))
        پایان
    پایان
    برگشت خروجی
پایان

تابع بارگذاری نام‌ها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(سطرها.بگیر(شماره).بشکاف("\t").بگیر(0))
    پایان
    برگشت خروجی
پایان

تابع بارگذاری نشانه‌ها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(سطرها.بگیر(شماره).بشکاف("\t").بگیر(1))
    پایان
    برگشت خروجی
پایان

تابع ذخیره():
    ناپایا خروجی := ""
    تکرار نام‌ها.طول() در شماره:
        خروجی += نام‌ها.بگیر(شماره) + "\t" + نشانه‌ها.بگیر(شماره) + "\n"
    پایان
    دام.تنظیم متن ذخیره("habits.list"، خروجی)
پایان

تابع نام روز(روز: صحیح): رشته:
    اگر روز برابر 0:
        برگشت "شنبه"
    وگرنه روز برابر 1:
        برگشت "یکشنبه"
    وگرنه روز برابر 2:
        برگشت "دوشنبه"
    وگرنه روز برابر 3:
        برگشت "سه‌شنبه"
    وگرنه روز برابر 4:
        برگشت "چهارشنبه"
    وگرنه روز برابر 5:
        برگشت "پنجشنبه"
    پایان
    برگشت "جمعه"
پایان

تابع انجام شده(مورد: صحیح، روز: صحیح): منطقی:
    برگشت نشانه‌ها.بگیر(مورد).زیررشته(روز، 1) برابر "1"
پایان

تابع تغییر روز(مورد: صحیح، روز: صحیح):
    سطر := نشانه‌ها.بگیر(مورد)
    وارونه_ := انجام شده(مورد، روز) ? "0" : "1"
    نشانه‌ها.بنشان(مورد، سطر.زیررشته(0، روز) + وارونه_ + سطر.زیررشته(روز + 1، 7))
    ذخیره()
پایان

تابع جمع هفته(مورد: صحیح): صحیح:
    ناپایا عدد := 0
    تکرار 7 در روز:
        اگر انجام شده(مورد، روز):
            عدد++
        پایان
    پایان
    برگشت عدد
پایان

تابع بهترین رگه(مورد: صحیح): صحیح:
    ناپایا بهترین := 0
    ناپایا اجرا := 0
    تکرار 7 در روز:
        اگر انجام شده(مورد، روز):
            اجرا++
            اگر اجرا بزرگتر بهترین:
                بهترین = اجرا
            پایان
        وگرنه:
            اجرا = 0
        پایان
    پایان
    برگشت بهترین
پایان

تابع رگه کنونی(مورد: صحیح): صحیح:
    ناپایا اجرا := 0
    ناپایا روز := 6
    تا روز بزرگتربرابر 0 و وارونه انجام شده(مورد، روز):
        روز--
    پایان
    تا روز بزرگتربرابر 0 و انجام شده(مورد، روز):
        اجرا++
        روز--
    پایان
    برگشت اجرا
پایان

تابع درصد(مورد: صحیح): صحیح:
    برگشت جمع هفته(مورد) * 100 / 7
پایان

تابع جمع کل(): صحیح:
    ناپایا عدد := 0
    تکرار نام‌ها.طول() در مورد:
        عدد += جمع هفته(مورد)
    پایان
    برگشت عدد
پایان

تابع بهترین عادت(): صحیح:
    ناپایا جای := -1
    ناپایا بیشترین := -1
    تکرار نام‌ها.طول() در مورد:
        اگر جمع هفته(مورد) بزرگتر بیشترین:
            بیشترین = جمع هفته(مورد)
            جای = مورد
        پایان
    پایان
    برگشت جای
پایان

تابع افزودن عادت():
    پاک‌شده := پیش‌نویس.پیراست()
    اگر پاک‌شده.طول() برابر 0:
        مشکل = "برای عادت یک نام بنویسید"
        برگشت
    پایان
    اگر پاک‌شده.طول() بزرگتر 24:
        مشکل = "نام از ۲۴ نویسه بیشتر نشود"
        برگشت
    پایان
    تکرار نام‌ها.طول() در شماره:
        اگر نام‌ها.بگیر(شماره) برابر پاک‌شده:
            مشکل = "این عادت را از قبل دارید"
            برگشت
        پایان
    پایان
    نام‌ها.بیفزا(پاک‌شده)
    نشانه‌ها.بیفزا("0000000")
    پیش‌نویس = ""
    مشکل = ""
    ذخیره()
پایان

تابع حذف عادت(مورد: صحیح):
    نام‌ها.حذف‌در(مورد)
    نشانه‌ها.حذف‌در(مورد)
    ذخیره()
پایان

همگانی بخش جدول هفته:
    اگر نام‌ها.طول() برابر 0:
        پاراگراف:
            کلاس = "empty"
            محتوا = "هنوز عادتی ندارید. یکی اضافه کنید و رگه‌تان را شروع کنید."
        پایان
    وگرنه:
        جدول:
            عرض = 100%
            ادغام کادر = «جمع‌شده»
            سرصفحه:
                ردیف:
                    ستون:
                        محتوا = "عادت"
                    پایان
                    هر روز در روزها:
                        ستون:
                            محتوا = نام روز(روز)
                        پایان
                    پایان
                    ستون:
                        محتوا = "رگه"
                    پایان
                پایان
            پایان
            اصلی:
                هر مورد، نام در نام‌ها:
                    ردیف:
                        کلاس = "habit"
                        ستون:
                            پیوند:
                                مقصد = "/habit/" + مورد
                                رنگ = "#17251d"
                                محتوا = نام
                            پایان
                        پایان
                        هر روز در روزها:
                            ستون:
                                خانه روز:
                                    مورد = مورد
                                    روز = روز
                                پایان
                            پایان
                        پایان
                        ستون:
                            تکه:
                                کلاس = "streak"
                                محتوا = (رگه کنونی(مورد) + " روز" + (رگه کنونی(مورد) برابر 1 ? "" : ""))
                            پایان
                        پایان
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "عادت‌ها"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, Tahoma, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = "#f3f7f4"
        رنگ = "#17251d"
        نمای مسیر: پایان
    پایان
پایان
