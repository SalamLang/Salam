همگانی بخش قاب:
    سرصفحه:
        چیدمان = "row"
        تراز = "center"
        شکاف = 20
        فاصله = 14، 24
        پس زمینه = "#1f6f4a"
        رنگ = "#ffffff"
        تکه:
            اندازه قلم = 20
            وزن قلم = 800
            محتوا = "عادت‌ها"
        پایان
        ناوبری:
            چیدمان = "row"
            شکاف = 6
            گزینه قاب:
                راه = ""
                برچسب = "این هفته"
            پایان
            گزینه قاب:
                راه = "stats"
                برچسب = "آمار"
            پایان
        پایان
    پایان
    جعبه:
        بیشینه عرض = 760
        فضا = 0، "auto"
        فاصله = 20، 16
        شکاف = 16
        نمای مسیر: پایان
    پایان
پایان

بخش گزینه قاب(راه: رشته، برچسب: رشته):
    پیوند:
        مقصد = "/" + راه
        فاصله = 6، 12
        گردی = 8
        رنگ = "#ffffff"
        تزیین متن = «هیچ»
        اگر صفحه.مسیر.نشانی برابر "/" + راه:
            پس زمینه = "#17543a"
        پایان
        محتوا = برچسب
    پایان
پایان
