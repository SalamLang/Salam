همگانی بخش برگه عادت(کد: صحیح):
    مسیر = "/habit/:کد"
    عنوان = "عادت"
    جعبه:
        شکاف = 12
        فاصله = 18
        گردی = 14
        پس زمینه = "#ffffff"
        اگر کد کوچکتر نام‌ها.طول():
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = نام‌ها.بگیر(کد)
            پایان
            پاراگراف:
                شناسه = "best-streak"
                فضا = 0
                محتوا = "بهترین رگه: " + بهترین رگه(کد)
            پایان
            پاراگراف:
                شناسه = "week"
                فضا = 0
                محتوا = "انجام شده: " + جمع هفته(کد) + " از ۷ روز"
            پایان
            دکمه:
                شناسه = "remove"
                فاصله = 8، 14
                گردی = 10
                کادر = 0
                پس زمینه = "#fde7e4"
                رنگ = "#b42318"
                نشانگر = "اشاره"
                کلیک = ():
                    حذف عادت(کد)
                    صفحه.مسیر.برو("/")
                پایان
                محتوا = "پایان پیگیری"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین عادتی نیست"
            پایان
        پایان
        پیوند:
            مقصد = "/"
            محتوا = "بازگشت به هفته"
        پایان
    پایان
پایان
