// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش آمار:
    عنوان = "آمار"
    سرتیتر:
        اندازه = 1
        فضا = 0
        محتوا = "آمار"
    پایان
    پاراگراف:
        شناسه = "total"
        فضا = 0
        محتوا = "جمع انجام‌ها در این هفته: " + جمع کل()
    پایان
    اگر نام‌ها.طول() بزرگتر 0:
        پاراگراف:
            شناسه = "best"
            فضا = 0
            محتوا = "پیوسته‌ترین: " + نام‌ها.بگیر(بهترین عادت())
        پایان
        هر مورد، نام در نام‌ها:
            میله:
                کلید = مورد
                برچسب = نام
                مقدار = درصد(مورد)
            پایان
        پایان
    وگرنه:
        پاراگراف:
            محتوا = "هنوز چیزی برای سنجش نیست."
        پایان
    پایان
پایان
