همگانی بخش قرص موضوع(کلید: رشته):
    دکمه:
        فاصله = 6، 14
        گردی = 20
        کادر = 1، توپر، #8886
        پس زمینه = شفاف
        اگر موضوع برابر کلید:
            پس زمینه = #4a7cff
            رنگ = #ffffff
        پایان
        کلیک = (): موضوع = کلید پایان
        محتوا = ترجمه(کلید)
    پایان
پایان

همگانی بخش سلیقه پوسته(کلید: رشته):
    برچسب:
        چیدمان = ردیف
        شکاف = 8
        ورودی:
            شناسه = "theme-" + کلید
            نوع = رادیویی
            نام = "theme"
            تیک خورده = (پوسته فعلی() برابر کلید)
            تغییر = (): تنظیم پوسته(کلید) پایان
        پایان
        تکه:
            محتوا = ترجمه(کلید)
        پایان
    پایان
پایان

همگانی بخش تعویض زبان:
    جعبه:
        چیدمان = ردیف
        شکاف = 4
        دکمه:
            شناسه = "lang-en"
            فاصله = 4، 10
            گردی = 8
            کادر = 1، توپر، #8886
            پس زمینه = شفاف
            اگر وارونه فارسی است():
                پس زمینه = #4a7cff
                رنگ = #ffffff
            پایان
            کلیک = (): تنظیم زبان("en") پایان
            محتوا = "EN"
        پایان
        دکمه:
            شناسه = "lang-fa"
            فاصله = 4، 10
            گردی = 8
            کادر = 1، توپر، #8886
            پس زمینه = شفاف
            اگر فارسی است():
                پس زمینه = #4a7cff
                رنگ = #ffffff
            پایان
            کلیک = (): تنظیم زبان("fa") پایان
            محتوا = "FA"
        پایان
    پایان
پایان
