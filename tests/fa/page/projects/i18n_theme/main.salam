// انتظار: <meta name="salam-router" content="history">
// انتظار: localStorage
// انتظار: عبارت‌نامه
// انتظار: prefers-color-scheme
واردسازی دام

ناپایا زبان پیش‌فرض := "fa"
ناپایا کد زبان := دام.دریافت متن ذخیره("lang")
ناپایا پوسته := دام.دریافت متن ذخیره("theme")
ناپایا موضوع := "all"

تابع پوسته فعلی(): رشته:
    اگر پوسته برابر "dark" یا پوسته برابر "light":
        برگشت پوسته
    پایان
    برگشت "auto"
پایان

تابع زبان فعلی(): رشته:
    اگر کد زبان برابر "":
        برگشت زبان پیش‌فرض
    پایان
    برگشت کد زبان برابر "fa" ? "fa" : "en"
پایان

تابع فارسی است(): منطقی:
    برگشت زبان فعلی() برابر "fa"
پایان

تابع تنظیم زبان(کودی: رشته):
    کد زبان = کودی
    دام.تنظیم متن ذخیره("lang"، کودی)
پایان

تابع تنظیم پوسته(نام: رشته):
    پوسته = نام
    دام.تنظیم متن ذخیره("theme"، نام)
پایان

تابع دارک اکنون(): منطقی:
    برگشت پوسته برابر "dark"
پایان

تابع ترجمه(کلید: رشته): رشته:
    اگر فارسی است():
        اگر کلید برابر "title":
            برگشت "عبارت‌نامه"
        وگرنه کلید برابر "home":
            برگشت "عبارت‌ها"
        وگرنه کلید برابر "settings":
            برگشت "تنظیمات"
        وگرنه کلید برابر "about":
            برگشت "درباره"
        وگرنه کلید برابر "language":
            برگشت "زبان"
        وگرنه کلید برابر "theme":
            برگشت "پوسته"
        وگرنه کلید برابر "light":
            برگشت "روشن"
        وگرنه کلید برابر "dark":
            برگشت "تاریک"
        وگرنه کلید برابر "auto":
            برگشت "خودکار"
        وگرنه کلید برابر "all":
            برگشت "همه"
        وگرنه کلید برابر "greeting":
            برگشت "سلام"
        وگرنه کلید برابر "travel":
            برگشت "سفر"
        وگرنه کلید برابر "food":
            برگشت "غذا"
        وگرنه کلید برابر "saved":
            برگشت "ترجیح شما ذخیره شد"
        وگرنه کلید برابر "missing":
            برگشت "این عبارت پیدا نشد"
        پایان
    وگرنه:
        اگر کلید برابر "title":
            برگشت "Phrasebook"
        وگرنه کلید برابر "home":
            برگشت "Phrases"
        وگرنه کلید برابر "settings":
            برگشت "Settings"
        وگرنه کلید برابر "about":
            برگشت "About"
        وگرنه کلید برابر "language":
            برگشت "Language"
        وگرنه کلید برابر "theme":
            برگشت "Theme"
        وگرنه کلید برابر "light":
            برگشت "Light"
        وگرنه کلید برابر "dark":
            برگشت "Dark"
        وگرنه کلید برابر "auto":
            برگشت "Auto"
        وگرنه کلید برابر "all":
            برگشت "All"
        وگرنه کلید برابر "greeting":
            برگشت "Greeting"
        وگرنه کلید برابر "travel":
            برگشت "Travel"
        وگرنه کلید برابر "food":
            برگشت "Food"
        وگرنه کلید برابر "saved":
            برگشت "Your choice is saved"
        وگرنه کلید برابر "missing":
            برگشت "That phrase does not exist"
        پایان
    پایان
    برگشت کلید
پایان

تابع شماره عبارت‌ها(): وکتور<صحیح>:
    ناپایا و_ := وکتور {} برگردان وکتور<صحیح>
    و_.افزودن(0)
    و_.افزودن(1)
    و_.افزودن(2)
    و_.افزودن(3)
    و_.افزودن(4)
    و_.افزودن(5)
    برگشت و_
پایان

تابع موضوع عبارت(شماره: صحیح): رشته:
    اگر شماره کوچکتر 2:
        برگشت "greeting"
    وگرنه شماره کوچکتر 4:
        برگشت "travel"
    پایان
    برگشت "food"
پایان

تابع متن عبارت(شماره: صحیح): رشته:
    اگر فارسی است():
        اگر شماره برابر 0:
            برگشت "صبح بخیر"
        وگرنه شماره برابر 1:
            برگشت "خوشحالم که می‌بینمت"
        وگرنه شماره برابر 2:
            برگشت "ایستگاه قطار کجاست؟"
        وگرنه شماره برابر 3:
            برگشت "یک بلیت لطفا"
        وگرنه شماره برابر 4:
            برگشت "یک چای می‌خواهم"
        وگرنه شماره برابر 5:
            برگشت "صورتحساب لطفا"
        پایان
    وگرنه:
        اگر شماره برابر 0:
            برگشت "Good morning"
        وگرنه شماره برابر 1:
            برگشت "Nice to meet you"
        وگرنه شماره برابر 2:
            برگشت "Where is the train station?"
        وگرنه شماره برابر 3:
            برگشت "One ticket, please"
        وگرنه شماره برابر 4:
            برگشت "I would like a tea"
        وگرنه شماره برابر 5:
            برگشت "The bill, please"
        پایان
    پایان
    برگشت ""
پایان

تابع متن دیگر(شماره: صحیح): رشته:
    اگر فارسی است():
        اگر شماره برابر 0:
            برگشت "Good morning"
        وگرنه شماره برابر 1:
            برگشت "Nice to meet you"
        وگرنه شماره برابر 2:
            برگشت "Where is the train station?"
        وگرنه شماره برابر 3:
            برگشت "One ticket, please"
        وگرنه شماره برابر 4:
            برگشت "I would like a tea"
        وگرنه شماره برابر 5:
            برگشت "The bill, please"
        پایان
    وگرنه:
        اگر شماره برابر 0:
            برگشت "صبح بخیر"
        وگرنه شماره برابر 1:
            برگشت "خوشحالم که می‌بینمت"
        وگرنه شماره برابر 2:
            برگشت "ایستگاه قطار کجاست؟"
        وگرنه شماره برابر 3:
            برگشت "یک بلیت لطفا"
        وگرنه شماره برابر 4:
            برگشت "یک چای می‌خواهم"
        وگرنه شماره برابر 5:
            برگشت "صورتحساب لطفا"
        پایان
    پایان
    برگشت ""
پایان

تابع همین جاست(نام کوتاه: رشته): منطقی:
    برگشت صفحه.مسیر.نشانی برابر "/" + نام کوتاه
پایان

تابع نام منو(نام کوتاه: رشته): رشته:
    اگر نام کوتاه برابر "settings":
        برگشت ترجمه("settings")
    وگرنه نام کوتاه برابر "about":
        برگشت ترجمه("about")
    پایان
    برگشت ترجمه("home")
پایان

همگانی بخش ناوبر(نام کوتاه: رشته، نوشته ناو: رشته، فعال: منطقی):
    شمار ضربه := 0
    پیوند:
        کلیک = (): شمار ضربه++ پایان
        اگر شمار ضربه بزرگتر 0 و وارونه فعال:
            شفافیت = 0.85
        پایان
        مقصد = "/" + نام کوتاه
        فاصله = 6، 12
        گردی = 8
        تزیین متن = "هیچ"
        رنگ = "#3b5bdb"
        اشاره:
            پس زمینه = "#8883"
        پایان
        اگر فعال:
            پس زمینه = "#4a7cff33"
            وزن قلم = 700
        پایان
        محتوا = نوشته ناو
    پایان
پایان

همگانی بخش کارت عبارت(شماره: صحیح):
    شمار ضربه := 0
    پیوند:
        کلیک = (): شمار ضربه++ پایان
        مقصد = "/phrase/" + شماره
        چیدمان = "ستون"
        شکاف = 4
        فاصله = 14
        گردی = 12
        تزیین متن = "هیچ"
        کادر = 1، "توپر"، "#8883"
        اشاره:
            پس زمینه = "#8881"
        پایان
        تکه:
            اندازه قلم = 18
            محتوا = متن عبارت(شماره)
        پایان
        ریز:
            شفافیت = 0.65
            محتوا = ترجمه(موضوع عبارت(شماره)) + (شمار ضربه بزرگتر 0 ? " " + شمار ضربه : "")
        پایان
    پایان
پایان

صفحه:
    عنوان = "عبارت‌نامه"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, system-ui, sans-serif"
    جعبه:
        جهت = فارسی است() ? "rtl" : "ltr"
        زبان = زبان فعلی()
        کمینه ارتفاع = 100vh
        پس زمینه = "#fbfaf7"
        رنگ = "#232323"
        اگر پوسته فعلی() برابر "dark":
            پس زمینه = "#16181d"
            رنگ = "#ececec"
        پایان
        اگر پوسته فعلی() برابر "auto" و صفحه.تیره:
            پس زمینه = "#16181d"
            رنگ = "#ececec"
        پایان
        سرصفحه:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 16
            فاصله = 14، 24
            کادر پایین = 1، "توپر"، "#8884"
            قوی:
                اندازه قلم = 20
                محتوا = ترجمه("title")
            پایان
            ناوبری:
                چیدمان = "ردیف"
                شکاف = 8
                رشد = 1
                هر مورد در [""، "settings"، "about"]:
                    ناوبر:
                        نام کوتاه = مورد
                        نوشته ناو = نام منو(مورد)
                        فعال = همین جاست(مورد)
                    پایان
                پایان
            پایان
            تعویض زبان: پایان
        پایان
        اصلی:
            بیشینه عرض = 760
            فضا = 0، "خودکار"
            فاصله = 24
            Outlet: پایان
        پایان
    پایان
پایان
