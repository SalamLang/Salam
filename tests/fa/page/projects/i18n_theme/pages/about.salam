همگانی بخش درباره ما:
    عنوان = "درباره"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = ترجمه("about")
        پایان
        پاراگراف:
            محتوا = فارسی است() ? "این برنامه با زبان سلام نوشته شده و زبان و پوسته را در مرورگر نگه می‌دارد." : "This app is written in Salam and keeps your language and theme in the browser."
        پایان
        پاراگراف:
            شناسه = "dirnote"
            محتوا = فارسی است() ? "جهت صفحه: راست به چپ" : "Page direction: left to right"
        پایان
    پایان
پایان
