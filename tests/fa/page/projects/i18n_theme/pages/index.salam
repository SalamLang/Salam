همگانی بخش خانه عبارت‌ها:
    عنوان = "عبارت‌نامه"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 1
            محتوا = ترجمه("home")
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 8
            شکستن خط = درست
            قرص موضوع:
                کلید = "all"
            پایان
            قرص موضوع:
                کلید = "greeting"
            پایان
            قرص موضوع:
                کلید = "travel"
            پایان
            قرص موضوع:
                کلید = "food"
            پایان
        پایان
        هر شماره در شماره عبارت‌ها():
            اگر موضوع برابر "all" یا موضوع برابر موضوع عبارت(شماره):
                کارت عبارت:
                    شماره = شماره
                پایان
            پایان
        پایان
    پایان
پایان
