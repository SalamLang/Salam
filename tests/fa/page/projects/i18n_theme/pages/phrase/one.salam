همگانی بخش عبارت تکی(شماره: صحیح):
    مسیر = "/phrase/:شماره"
    عنوان = "عبارت"
    جعبه:
        شکاف = 12
        اگر شماره بزرگتربرابر 0 و شماره کوچکتر 6:
            سرتیتر:
                اندازه = 1
                محتوا = متن عبارت(شماره)
            پایان
            پاراگراف:
                جهت = "auto"
                شفافیت = 0.7
                محتوا = متن دیگر(شماره)
            پایان
            دکمه:
                شناسه = "again"
                خود تراز = "ابتدا"
                فاصله = 8، 14
                گردی = 10
                کلیک = (): صفحه.مسیر.عقب() پایان
                محتوا = ترجمه("home")
            پایان
        وگرنه:
            پاراگراف:
                محتوا = ترجمه("missing")
            پایان
        پایان
    پایان
پایان
