// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش تنظیمات برنامه:
    عنوان = "تنظیمات"
    جعبه:
        شکاف = 16
        سرتیتر:
            اندازه = 1
            محتوا = ترجمه("settings")
        پایان
        گروه فیلد:
            عنوان گروه:
                محتوا = ترجمه("language")
            پایان
            برچسب:
                چیدمان = ردیف
                شکاف = 8
                ورودی:
                    شناسه = "pick-en"
                    نوع = رادیویی
                    نام = "lang"
                    تیک خورده = (وارونه فارسی است())
                    تغییر = (): تنظیم زبان("en") پایان
                پایان
                تکه:
                    محتوا = "English"
                پایان
            پایان
            برچسب:
                چیدمان = ردیف
                شکاف = 8
                ورودی:
                    شناسه = "pick-fa"
                    نوع = رادیویی
                    نام = "lang"
                    تیک خورده = فارسی است()
                    تغییر = (): تنظیم زبان("fa") پایان
                پایان
                تکه:
                    محتوا = "فارسی"
                پایان
            پایان
        پایان
        گروه فیلد:
            عنوان گروه:
                محتوا = ترجمه("theme")
            پایان
            سلیقه پوسته:
                کلید = "light"
            پایان
            سلیقه پوسته:
                کلید = "dark"
            پایان
            سلیقه پوسته:
                کلید = "auto"
            پایان
        پایان
        پاراگراف:
            شناسه = "saved"
            شفافیت = 0.7
            محتوا = ترجمه("saved") + ": " + زبان فعلی() + " / " + پوسته فعلی()
        پایان
    پایان
پایان
