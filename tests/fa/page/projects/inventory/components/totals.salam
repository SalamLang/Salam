بخش شاخص(عنوان کوتاه: رشته، مقدار نشان: رشته، هشدار: منطقی):
    جعبه:
        رشد = 1
        پایه = 0
        کمینه عرض = 150
        فاصله = 14، 18
        گردی = 12
        پس زمینه = #ffffff
        کادر = 1، توپر، #e8dfcc
        اگر هشدار:
            پس زمینه = #fff1e0
        پایان
        پاراگراف:
            فضا = 0
            اندازه قلم = 12
            رنگ = #7a6e58
            محتوا = عنوان کوتاه
        پایان
        پاراگراف:
            فضا = 0
            اندازه قلم = 24
            وزن قلم = 800
            محتوا = مقدار نشان
        پایان
    پایان
پایان

همگانی بخش جمع ها:
    جعبه:
        چیدمان = ردیف
        شکستن خط = درست
        شکاف = 12
        شاخص:
            عنوان کوتاه = "کالاها"
            مقدار نشان = "" + کالاها.طول()
            هشدار = نادرست
        پایان
        شاخص:
            عنوان کوتاه = "واحد در انبار"
            مقدار نشان = "" + جمع واحدها()
            هشدار = نادرست
        پایان
        شاخص:
            عنوان کوتاه = "Stock amount"
            مقدار نشان = پول(ارزش انبار())
            هشدار = نادرست
        پایان
        شاخص:
            عنوان کوتاه = "موجودی کم"
            مقدار نشان = "" + تعداد کم موجود()
            هشدار = (تعداد کم موجود() بزرگتر 0)
        پایان
    پایان
پایان
