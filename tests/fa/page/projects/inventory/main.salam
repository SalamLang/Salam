// انتظار: var __salam_rt_hash = true
// انتظار: function __salam_route_pick(
// انتظار: انبارک
واردسازی دام

ناپایا کالاها := کالاهای نمونه()
ناپایا شناسه بعدی := 7
ناپایا جستجو := ""
ناپایا پیام := ""

ساختار کالا:
    همگانی شناسه: صحیح
    همگانی نام: رشته
    همگانی کد کالا: رشته
    همگانی موجودی: صحیح
    همگانی حد کم: صحیح
    همگانی بها: صحیح
پایان

تابع ساخت(شناسه: صحیح، نام: رشته، کد کالا: رشته، موجودی: صحیح، حد کم: صحیح، بها: صحیح): کالا:
    برگشت کالا {شناسه = شناسه، نام = نام، کد کالا = کد کالا، موجودی = موجودی، حد کم = حد کم، بها = بها}
پایان

تابع کالاهای نمونه(): وکتور<کالا>:
    ناپایا مقدار := وکتور {} برگردان وکتور<کالا>
    مقدار.افزودن(ساخت(1، "دانه اسپرسو یک کیلو"، "COF-001"، 24، 10، 1850))
    مقدار.افزودن(ساخت(2، "فیلتر کاغذی"، "COF-014"، 6، 12، 399))
    مقدار.افزودن(ساخت(3، "لیوان سرامیکی"، "MUG-210"، 48، 15، 725))
    مقدار.افزودن(ساخت(4، "کف ساز شیر"، "EQP-032"، 3، 5، 2990))
    مقدار.افزودن(ساخت(5، "کارت هدیه ۲۵"، "GFT-025"، 100، 20، 2500))
    مقدار.افزودن(ساخت(6، "ماگ سفری"، "MUG-305"، 14، 10، 1950))
    برگشت مقدار
پایان

تابع جای کالا(شناسه: صحیح): صحیح:
    تکرار کالاها.طول() در ی:
        اگر کالاها[ی].شناسه برابر شناسه:
            برگشت ی
        پایان
    پایان
    برگشت 0 - 1
پایان

تابع کم موجود است(پ: کالا): منطقی:
    برگشت پ.موجودی کوچکتربرابر پ.حد کم
پایان

تابع تعداد کم موجود(): صحیح:
    ناپایا باقی := 0
    تکرار کالاها.طول() در ی:
        اگر کم موجود است(کالاها[ی]):
            باقی++
        پایان
    پایان
    برگشت باقی
پایان

تابع جمع واحدها(): صحیح:
    ناپایا موقت := 0
    تکرار کالاها.طول() در ی:
        موقت += کالاها[ی].موجودی
    پایان
    برگشت موقت
پایان

تابع ارزش انبار(): صحیح:
    ناپایا موقت := 0
    تکرار کالاها.طول() در ی:
        موقت += کالاها[ی].موجودی * کالاها[ی].بها
    پایان
    برگشت موقت
پایان

تابع پول(بها: صحیح): رشته:
    باقی := بها % 100
    برگشت "" + (بها / 100) + "." + (باقی کوچکتر 10 ? "0" : "") + باقی + " دلار"
پایان

تابع عدد است(رشته: رشته): منطقی:
    اگر رشته.طول() برابر 0:
        برگشت نادرست
    پایان
    تکرار رشته.طول() در ی:
        نویسه := رشته.زیررشته(ی، 1)
        اگر نویسه کوچکتر "0" یا نویسه بزرگتر "9":
            برگشت نادرست
        پایان
    پایان
    برگشت درست
پایان

تابع منطبق است(پ: کالا): منطقی:
    عبارت := جستجو.پیراست().کوچک()
    اگر عبارت.طول() برابر 0:
        برگشت درست
    پایان
    برگشت پ.نام.کوچک().دربردارد(عبارت) یا پ.کد کالا.کوچک().دربردارد(عبارت)
پایان

تابع تعداد نمایش(): صحیح:
    ناپایا باقی := 0
    تکرار کالاها.طول() در ی:
        اگر منطبق است(کالاها[ی]):
            باقی++
        پایان
    پایان
    برگشت باقی
پایان

تابع ساخت کالا(نام: رشته، کد کالا: رشته، موجودی: رشته، حد کم: رشته، قیمت: رشته):
    درست_ است := نام.پیراست().طول() بزرگتر 0 و کد کالا.پیراست().طول() بزرگتربرابر 3 و عدد است(موجودی) و عدد است(حد کم) و عدد است(قیمت) و قیمت.به صحیح() بزرگتر 0
    اگر وارونه درست_ است:
        برگشت
    پایان
    کالاها.بیفزا(ساخت(شناسه بعدی، نام.پیراست()، کد کالا.پیراست().بزرگ()، موجودی.به صحیح()، حد کم.به صحیح()، قیمت.به صحیح() * 100))
    شناسه بعدی++
    پیام = "افزوده شد: " + نام.پیراست()
    صفحه.مسیر.برو("/")
پایان

تابع تنظیم عدد(جا: صحیح، فیلد: رشته، مقدار: رشته):
    اگر وارونه عدد است(مقدار):
        برگشت
    پایان
    اگر فیلد برابر "qty":
        کالاها[جا].موجودی = مقدار.به صحیح()
    وگرنه فیلد برابر "low":
        کالاها[جا].حد کم = مقدار.به صحیح()
    وگرنه:
        کالاها[جا].بها = مقدار.به صحیح() * 100
    پایان
    پیام = ""
پایان

تابع حذف کالا(شناسه: صحیح):
    جا := جای کالا(شناسه)
    اگر جا کوچکتر 0:
        برگشت
    پایان
    ناپایا ماندنی := وکتور {} برگردان وکتور<کالا>
    تکرار کالاها.طول() در ی:
        اگر ی نابرابر جا:
            ماندنی.افزودن(کالاها[ی])
        پایان
    پایان
    پیام = "حذف شد: " + کالاها[جا].نام
    کالاها = ماندنی
پایان

تابع تنظیم موجودی(شناسه: صحیح، تغییر: صحیح):
    جا := جای کالا(شناسه)
    اگر جا بزرگتربرابر 0 و کالاها[جا].موجودی + تغییر بزرگتربرابر 0:
        کالاها[جا].موجودی += تغییر
    پایان
پایان

بخش زبانه(آدرس: رشته، عنوان کوتاه: رشته):
    پیوند:
        مقصد = آدرس
        فاصله = 8، 14
        گردی = 999
        تزیین متن = "هیچ"
        رنگ = "#3a3226"
        محتوا = عنوان کوتاه
    پایان
پایان

همگانی بخش ردیف کالا(جا: صحیح):
    مورد:
        کلید = کالاها[جا].شناسه
        چیدمان = "ردیف"
        تراز = "وسط"
        شکاف = 12
        فاصله = 12، 16
        گردی = 12
        پس زمینه = "#ffffff"
        کادر = 1، "توپر"، "#e8dfcc"
        اگر کم موجود است(کالاها[جا]):
            پس زمینه = "#fff1e0"
            کادر = 1، "توپر"، "#f0b765"
        پایان
        جعبه:
            رشد = 1
            شکاف = 2
            پیوند:
                مقصد = "/edit/" + کالاها[جا].شناسه
                وزن قلم = 700
                رنگ = "#2c261c"
                تزیین متن = "هیچ"
                محتوا = کالاها[جا].نام
            پایان
            تکه:
                اندازه قلم = 12
                رنگ = "#7a6e58"
                محتوا = کالاها[جا].کد کالا + " , " + پول(کالاها[جا].بها)
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 6
            دکمه:
                کلاس = "minus"
                فاصله = 4، 10
                گردی = 8
                کادر = 1، "توپر"، "#d9cdb3"
                پس زمینه = "#ffffff"
                کلیک = ():
                    تنظیم موجودی(کالاها[جا].شناسه، 0 - 1)
                پایان
                محتوا = "-"
            پایان
            قوی:
                کلاس = "qty"
                کمینه عرض = 36
                ترازمتن = "وسط"
                محتوا = "" + کالاها[جا].موجودی
            پایان
            دکمه:
                کلاس = "plus"
                فاصله = 4، 10
                گردی = 8
                کادر = 1، "توپر"، "#d9cdb3"
                پس زمینه = "#ffffff"
                کلیک = ():
                    تنظیم موجودی(کالاها[جا].شناسه، 1)
                پایان
                محتوا = "+"
            پایان
        پایان
        اگر کم موجود است(کالاها[جا]):
            تکه:
                کلاس = "low"
                فاصله = 2، 10
                گردی = 999
                اندازه قلم = 12
                وزن قلم = 700
                پس زمینه = "#f0b765"
                رنگ = "#4a2c00"
                محتوا = "موجودی کم"
            پایان
        پایان
        دکمه:
            کلاس = "delete"
            فاصله = 6، 12
            گردی = 8
            کادر = 0
            پس زمینه = "#f6dcd8"
            رنگ = "#8a1c12"
            کلیک = ():
                حذف کالا(کالاها[جا].شناسه)
            پایان
            محتوا = "حذف"
        پایان
    پایان
پایان

تابع دنباله(تعداد: صحیح): وکتور<صحیح>:
    ناپایا مقدار := وکتور {} برگردان وکتور<صحیح>
    تکرار تعداد در ی:
        مقدار.افزودن(ی)
    پایان
    برگشت مقدار
پایان

همگانی بخش ردیف فرم(عنوان کوتاه: رشته، فیلد: رشته، یادداشت: رشته):
    جعبه:
        شکاف = 4
        برچسب:
            برای = فیلد
            وزن قلم = 600
            محتوا = عنوان کوتاه
        پایان
        content: پایان
        پاراگراف:
            شناسه = فیلد + "-note"
            فضا = 0
            کمینه ارتفاع = 18
            اندازه قلم = 13
            رنگ = "#b3261e"
            محتوا = یادداشت
        پایان
    پایان
پایان

همگانی بخش فرم کالا:
    نام := ""
    کد کالا := ""
    موجودی := ""
    حد کم := "5"
    قیمت := ""
    تلاش_ شد := نادرست
    فرم:
        شناسه = "new-form"
        بیشینه عرض = 520
        فاصله = 24
        شکاف = 8
        گردی = 16
        پس زمینه = "#ffffff"
        کادر = 1، "توپر"، "#e8dfcc"
        ارسال = (ی_2: صحیح۶۴):
            دام.جلوگیری پیش فرض(ی_2)
            تلاش_ شد = درست
            ساخت کالا(نام، کد کالا، موجودی، حد کم، قیمت)
        پایان
        ردیف فرم:
            عنوان کوتاه = "نام"
            فیلد = "new-name"
            یادداشت = (تلاش_ شد و نام.پیراست().طول() برابر 0) ? "برای کالا نامی بنویسید." : ""
            ورودی:
                شناسه = "new-name"
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#d9cdb3"
                پیوند = نام
            پایان
        پایان
        ردیف فرم:
            عنوان کوتاه = "کد کالا"
            فیلد = "new-sku"
            یادداشت = (تلاش_ شد و کد کالا.پیراست().طول() کوچکتر 3) ? "دست کم سه نویسه." : ""
            ورودی:
                شناسه = "new-sku"
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#d9cdb3"
                پیوند = کد کالا
            پایان
        پایان
        ردیف فرم:
            عنوان کوتاه = "موجودی"
            فیلد = "new-qty"
            یادداشت = (تلاش_ شد و وارونه عدد است(موجودی)) ? "عدد صحیح، صفر یا بیشتر." : ""
            ورودی:
                شناسه = "new-qty"
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#d9cdb3"
                پیوند = موجودی
            پایان
        پایان
        ردیف فرم:
            عنوان کوتاه = "کم موجود از"
            فیلد = "new-low"
            یادداشت = (تلاش_ شد و وارونه عدد است(حد کم)) ? "عدد صحیح، صفر یا بیشتر." : ""
            ورودی:
                شناسه = "new-low"
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#d9cdb3"
                پیوند = حد کم
            پایان
        پایان
        ردیف فرم:
            عنوان کوتاه = "قیمت به دلار"
            فیلد = "new-price"
            یادداشت = (تلاش_ شد و (وارونه عدد است(قیمت) یا قیمت.به صحیح() برابر 0)) ? "عدد صحیح بزرگتر از صفر." : ""
            ورودی:
                شناسه = "new-price"
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "توپر"، "#d9cdb3"
                پیوند = قیمت
            پایان
        پایان
        دکمه:
            شناسه = "new-save"
            نوع = "ارسال"
            فضا = 8، 0، 0، 0
            فاصله = 12
            گردی = 10
            کادر = 0
            پس زمینه = "#3a3226"
            رنگ = "#fffaf0"
            وزن قلم = 700
            محتوا = "افزودن کالا"
        پایان
    پایان
پایان

صفحه:
    حالت = "هش"
    عنوان = "انبارک"
    زبان = "fa"
    ظاهر سفارشی:
        محتوا = "nav a[aria-current=page] { background: #3a3226; color: #fffaf0; }"
    پایان
    قلم = "Vazirmatn, system-ui, sans-serif"
    پس زمینه = "#faf6ee"
    رنگ = "#2c261c"
    سرصفحه:
        چیدمان = "ردیف"
        تراز = "وسط"
        چینش = "میان"
        فاصله = 16، 32
        کادر پایین = 1، "توپر"، "#e8dfcc"
        پیوند:
            مقصد = "/"
            اندازه قلم = 20
            وزن قلم = 800
            رنگ = "#2c261c"
            تزیین متن = "هیچ"
            محتوا = "انبارک"
        پایان
        ناوبری:
            چیدمان = "ردیف"
            شکاف = 6
            زبانه:
                آدرس = "/"
                عنوان کوتاه = "کالاها"
            پایان
            زبانه:
                آدرس = "/new"
                عنوان کوتاه = "افزودن کالا"
            پایان
        پایان
    پایان
    اصلی:
        فاصله = 28، 32
        بیشینه عرض = 980
        فضا = 0، "خودکار"
        نمای مسیر: پایان
    پایان
پایان
