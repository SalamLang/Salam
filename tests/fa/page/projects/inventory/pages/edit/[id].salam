بخش پنل ویرایش(شناسه: صحیح):
    جعبه:
        شکاف = 14
        اگر جای کالا(شناسه) کوچکتر 0:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین کالایی نیست"
            پایان
            پیوند:
                مقصد = "/"
                محتوا = "بازگشت به کالاها"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = "ویرایش " + کالاها[جای کالا(شناسه)].نام
            پایان
            جعبه:
                بیشینه عرض = 520
                فاصله = 24
                شکاف = 8
                گردی = 16
                پس زمینه = "#ffffff"
                کادر = 1، "توپر"، "#e8dfcc"
                ردیف فرم:
                    عنوان کوتاه = "نام"
                    فیلد = "edit-name"
                    یادداشت = (کالاها[جای کالا(شناسه)].نام.پیراست().طول() برابر 0) ? "برای کالا نامی بنویسید." : ""
                    ورودی:
                        شناسه = "edit-name"
                        فاصله = 10، 12
                        گردی = 10
                        کادر = 1، "توپر"، "#d9cdb3"
                        پیوند = کالاها[جای کالا(شناسه)].نام
                    پایان
                پایان
                ردیف فرم:
                    عنوان کوتاه = "کد کالا"
                    فیلد = "edit-sku"
                    یادداشت = (کالاها[جای کالا(شناسه)].کد کالا.پیراست().طول() کوچکتر 3) ? "دست کم سه نویسه." : ""
                    ورودی:
                        شناسه = "edit-sku"
                        فاصله = 10، 12
                        گردی = 10
                        کادر = 1، "توپر"، "#d9cdb3"
                        پیوند = کالاها[جای کالا(شناسه)].کد کالا
                    پایان
                پایان
                ردیف فرم:
                    عنوان کوتاه = "موجودی"
                    فیلد = "edit-qty"
                    یادداشت = ""
                    ورودی:
                        شناسه = "edit-qty"
                        فاصله = 10، 12
                        گردی = 10
                        کادر = 1، "توپر"، "#d9cdb3"
                        مقدار = "" + کالاها[جای کالا(شناسه)].موجودی
                        ورودی = (مقدار: رشته):
                            تنظیم عدد(جای کالا(شناسه)، "qty"، مقدار)
                        پایان
                    پایان
                پایان
                ردیف فرم:
                    عنوان کوتاه = "کم موجود از"
                    فیلد = "edit-low"
                    یادداشت = ""
                    ورودی:
                        شناسه = "edit-low"
                        فاصله = 10، 12
                        گردی = 10
                        کادر = 1، "توپر"، "#d9cdb3"
                        مقدار = "" + کالاها[جای کالا(شناسه)].حد کم
                        ورودی = (مقدار: رشته):
                            تنظیم عدد(جای کالا(شناسه)، "low"، مقدار)
                        پایان
                    پایان
                پایان
                ردیف فرم:
                    عنوان کوتاه = "قیمت به دلار"
                    فیلد = "edit-price"
                    یادداشت = ""
                    ورودی:
                        شناسه = "edit-price"
                        فاصله = 10، 12
                        گردی = 10
                        کادر = 1، "توپر"، "#d9cdb3"
                        مقدار = "" + (کالاها[جای کالا(شناسه)].بها / 100)
                        ورودی = (مقدار: رشته):
                            تنظیم عدد(جای کالا(شناسه)، "price"، مقدار)
                        پایان
                    پایان
                پایان
                پیوند:
                    شناسه = "edit-done"
                    مقصد = "/"
                    فضا = 8، 0، 0، 0
                    فاصله = 12
                    گردی = 10
                    پس زمینه = "#3a3226"
                    رنگ = "#fffaf0"
                    تزیین متن = "هیچ"
                    ترازمتن = "وسط"
                    وزن قلم = 700
                    محتوا = "تمام"
                پایان
            پایان
        پایان
    پایان
پایان

همگانی بخش ویرایش کالا(شناسه: صحیح):
    مسیر = "/edit/:شناسه"
    عنوان = "ویرایش کالا"
    پنل ویرایش:
        شناسه = شناسه
    پایان
پایان
