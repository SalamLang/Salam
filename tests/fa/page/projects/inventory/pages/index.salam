همگانی بخش فهرست کالاها:
    عنوان = "کالاها"
    جعبه:
        شکاف = 16
        جمع ها: پایان
        اگر پیام.طول() بزرگتر 0:
            پاراگراف:
                شناسه = "flash"
                فضا = 0
                فاصله = 10، 14
                گردی = 10
                پس زمینه = #e7f3e4
                رنگ = #1f5a1a
                محتوا = پیام
            پایان
        پایان
        ورودی:
            شناسه = "search"
            نوع = جستجو
            فاصله = 10، 14
            گردی = 10
            کادر = 1، توپر، #d9cdb3
            جانگهدار = "جستجو با نام یا کد کالا"
            پیوند = جستجو
        پایان
        فهرست:
            شناسه = "products"
            شکاف = 8
            فاصله = 0
            هر جا در دنباله(کالاها.طول()):
                اگر منطبق است(کالاها[جا]):
                    ردیف کالا:
                        جا = جا
                    پایان
                پایان
            پایان
        پایان
        اگر تعداد نمایش() برابر 0:
            پاراگراف:
                شناسه = "none"
                رنگ = #7a6e58
                محتوا = "کالایی پیدا نشد."
            پایان
        پایان
    پایان
پایان
