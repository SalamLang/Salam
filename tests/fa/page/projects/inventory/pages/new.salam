همگانی بخش کالای تازه:
    عنوان = "افزودن کالا"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "افزودن یک کالا"
        پایان
        فرم کالا: پایان
    پایان
پایان
