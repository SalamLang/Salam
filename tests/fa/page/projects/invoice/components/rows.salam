همگانی بخش ردیف خواندنی(جا: صحیح):
    ردیف:
        ستون:
            فاصله = 10، 8
            محتوا = اقلام[جا].شرح
        پایان
        ستون:
            فاصله = 10، 8
            ترازمتن = راست
            محتوا = "" + اقلام[جا].تعداد
        پایان
        ستون:
            فاصله = 10، 8
            ترازمتن = راست
            محتوا = پول(اقلام[جا].بها)
        پایان
        ستون:
            فاصله = 10، 8
            ترازمتن = راست
            وزن قلم = 600
            محتوا = پول(اقلام[جا].تعداد * اقلام[جا].بها)
        پایان
    پایان
پایان

همگانی بخش ردیف ویرایشی(جا: صحیح):
    ردیف:
        ستون:
            فاصله = 10، 8
            محتوا = اقلام[جا].شرح
        پایان
        ستون:
            فاصله = 10، 8
            ترازمتن = راست
            محتوا = "" + اقلام[جا].تعداد
        پایان
        ستون:
            فاصله = 10، 8
            ترازمتن = راست
            محتوا = پول(اقلام[جا].بها)
        پایان
        ستون:
            فاصله = 10، 8
            ترازمتن = راست
            وزن قلم = 600
            محتوا = پول(اقلام[جا].تعداد * اقلام[جا].بها)
        پایان
        ستون:
            فاصله = 10، 8
            دکمه:
                کلاس = "remove"
                کادر = 0
                فاصله = 4، 10
                گردی = 6
                پس زمینه = #f6dcd8
                رنگ = #8a1c12
                کلیک = ():
                    حذف قلم(جا)
                پایان
                محتوا = "حذف"
            پایان
        پایان
    پایان
پایان
