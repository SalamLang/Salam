بخش ردیف جمع(عنوان کوتاه: رشته، مبلغ نشان: رشته، ردیف پررنگ: منطقی):
    جعبه:
        چیدمان = "ردیف"
        چینش = "میان"
        فاصله = 6، 0
        اگر ردیف پررنگ:
            وزن قلم = 800
            اندازه قلم = 18
            کادر بالا = 2، "توپر"، "#17212b"
            فضا = 6، 0، 0، 0
        پایان
        تکه:
            محتوا = عنوان کوتاه
        پایان
        تکه:
            کلاس = "amount"
            محتوا = مبلغ نشان
        پایان
    پایان
پایان

همگانی بخش خلاصه(شناسه خلاصه: رشته):
    جعبه:
        شناسه = شناسه خلاصه
        فضا = 0، 0، 0، خودکار
        کمینه عرض = 280
        ردیف جمع:
            عنوان کوتاه = "جمع جزء"
            مبلغ نشان = پول(جمع جزء())
            ردیف پررنگ = نادرست
        پایان
        اگر تخفیف بزرگتر 0:
            ردیف جمع:
                عنوان کوتاه = "تخفیف (" + تخفیف + "%)"
                مبلغ نشان = "-" + پول(مبلغ تخفیف())
                ردیف پررنگ = نادرست
            پایان
        پایان
        ردیف جمع:
            عنوان کوتاه = "مالیات (" + مالیات + "%)"
            مبلغ نشان = پول(مبلغ مالیات())
            ردیف پررنگ = نادرست
        پایان
        ردیف جمع:
            عنوان کوتاه = "مبلغ قابل پرداخت"
            مبلغ نشان = پول(جمع کل())
            ردیف پررنگ = درست
        پایان
    پایان
پایان
