// انتظار: var __salam_rt_hash = true
// انتظار: function __salam_route_pick(
// انتظار: سازنده فاکتور
واردسازی دام
واردسازی تقویم
واردسازی رشته

ناپایا مشتری := "بازرگانی نوید"
ناپایا شماره := "2026-014"
ناپایا تاریخ صدور := "2026-11-23"
ناپایا مالیات := 8
ناپایا تخفیف := 0
ناپایا شرح پیش نویس := ""
ناپایا تعداد پیش نویس := "1"
ناپایا قیمت پیش نویس := ""
ناپایا خطای افزودن := ""
ناپایا اقلام := اقلام نمونه()

ساختار قلم:
    همگانی شرح: رشته
    همگانی تعداد: صحیح
    همگانی بها: صحیح
پایان

تابع اقلام نمونه(): وکتور<قلم>:
    ناپایا مقدار := وکتور {} برگردان وکتور<قلم>
    مقدار.افزودن(قلم {شرح = "طراحی دوباره وب‌گاه"، تعداد = 1، بها = 240000})
    مقدار.افزودن(قلم {شرح = "میزبانی، ۱۲ ماه"، تعداد = 12، بها = 1500})
    مقدار.افزودن(قلم {شرح = "صفحه اضافه"، تعداد = 3، بها = 9000})
    برگشت مقدار
پایان

تابع سه رقم سه رقم(عدد: صحیح): رشته:
    رشته := "" + عدد
    ناپایا خروجی := ""
    تکرار رشته.طول() در ی:
        مانده := رشته.طول() - ی
        اگر ی بزرگتر 0 و مانده % 3 برابر 0:
            خروجی += ","
        پایان
        خروجی += رشته.زیررشته(ی، 1)
    پایان
    برگشت خروجی
پایان

تابع پول(بها: صحیح): رشته:
    باقی := بها % 100
    برگشت رشته.به رقم فارسی(سه رقم سه رقم(بها / 100) + "." + (باقی کوچکتر 10 ? "0" : "") + باقی) + " دلار"
پایان

تابع جمع جزء(): صحیح:
    ناپایا موقت := 0
    تکرار اقلام.طول() در ی:
        موقت += اقلام[ی].تعداد * اقلام[ی].بها
    پایان
    برگشت موقت
پایان

تابع مبلغ تخفیف(): صحیح:
    برگشت جمع جزء() * تخفیف / 100
پایان

تابع مبلغ مشمول(): صحیح:
    برگشت جمع جزء() - مبلغ تخفیف()
پایان

تابع مبلغ مالیات(): صحیح:
    برگشت مبلغ مشمول() * مالیات / 100
پایان

تابع جمع کل(): صحیح:
    برگشت مبلغ مشمول() + مبلغ مالیات()
پایان

تابع درصد مجاز(مقدار: رشته): صحیح:
    عدد := مقدار.به صحیح()
    اگر عدد کوچکتر 0:
        برگشت 0
    پایان
    اگر عدد بزرگتر 100:
        برگشت 100
    پایان
    برگشت عدد
پایان

تابع عدد است(رشته: رشته): منطقی:
    اگر رشته.طول() برابر 0:
        برگشت نادرست
    پایان
    تکرار رشته.طول() در ی:
        نویسه := رشته.زیررشته(ی، 1)
        اگر نویسه کوچکتر "0" یا نویسه بزرگتر "9":
            برگشت نادرست
        پایان
    پایان
    برگشت درست
پایان

تابع افزودن قلم():
    اگر شرح پیش نویس.پیراست().طول() برابر 0:
        خطای افزودن = "کار انجام شده را شرح دهید."
        برگشت
    پایان
    اگر وارونه عدد است(تعداد پیش نویس) یا تعداد پیش نویس.به صحیح() برابر 0:
        خطای افزودن = "تعداد باید عدد صحیح بزرگتر از صفر باشد."
        برگشت
    پایان
    اگر وارونه عدد است(قیمت پیش نویس) یا قیمت پیش نویس.به صحیح() برابر 0:
        خطای افزودن = "قیمت باید عدد صحیح بزرگتر از صفر باشد."
        برگشت
    پایان
    اقلام.بیفزا(قلم {شرح = شرح پیش نویس.پیراست()، تعداد = تعداد پیش نویس.به صحیح()، بها = قیمت پیش نویس.به صحیح() * 100})
    شرح پیش نویس = ""
    تعداد پیش نویس = "1"
    قیمت پیش نویس = ""
    خطای افزودن = ""
پایان

تابع حذف قلم(جا: صحیح):
    ناپایا ماندنی := وکتور {} برگردان وکتور<قلم>
    تکرار اقلام.طول() در ی:
        اگر ی نابرابر جا:
            ماندنی.افزودن(اقلام[ی])
        پایان
    پایان
    اقلام = ماندنی
پایان

تابع متن تاریخ(تاریخ میلادی: رشته): رشته:
    تکه ها := تاریخ میلادی.بشکاف("-")
    اگر تکه ها.طول() نابرابر 3:
        برگشت تاریخ میلادی
    پایان
    ج := تقویم.میلادی به جلالی(تقویم.تاریخ میلادی {سال = تکه ها[0].به صحیح()، ماه = تکه ها[1].به صحیح()، روز = تکه ها[2].به صحیح()})
    اگر ج.ماه کوچکتر 1 یا ج.ماه بزرگتر 12:
        برگشت تاریخ میلادی
    پایان
    نام ماه ها := [""، "فروردین"، "اردیبهشت"، "خرداد"، "تیر"، "مرداد"، "شهریور"، "مهر"، "آبان"، "آذر"، "دی"، "بهمن"، "اسفند"]
    برگشت رشته.به رقم فارسی("" + ج.روز + " " + نام ماه ها[ج.ماه] + " " + ج.سال)
پایان

تابع پرینت صفحه_():
    دام.فراخوان(دام.پنجره()، "print")
پایان

تابع دنباله(عدد: صحیح): وکتور<صحیح>:
    ناپایا مقدار := وکتور {} برگردان وکتور<صحیح>
    تکرار عدد در ی:
        مقدار.افزودن(ی)
    پایان
    برگشت مقدار
پایان

بخش زبانه(آدرس: رشته، عنوان کوتاه: رشته):
    پیوند:
        مقصد = آدرس
        فاصله = 8، 14
        گردی = 8
        تزیین متن = "هیچ"
        رنگ = "#23405c"
        محتوا = عنوان کوتاه
    پایان
پایان

صفحه:
    حالت = "هش"
    عنوان = "سازنده فاکتور"
    زبان = "fa"
    ظاهر سفارشی:
        محتوا = "nav a[aria-current=page] { background: #23405c; color: #ffffff; }"
    پایان
    خانواده قلم = "Vazirmatn, system-ui, sans-serif"
    پس زمینه = "#eef3f8"
    رنگ = "#17212b"
    سرصفحه:
        چیدمان = "ردیف"
        تراز = "وسط"
        چینش = "میان"
        فاصله = 14، 32
        پس زمینه = "#ffffff"
        کادر پایین = 1، "توپر"، "#d6e0ea"
        رسانه:
            شرط = "print"
            نمایش = "هیچ"
        پایان
        قوی:
            محتوا = "سازنده فاکتور"
        پایان
        ناوبری:
            چیدمان = "ردیف"
            شکاف = 6
            زبانه:
                آدرس = "/"
                عنوان کوتاه = "ویرایش"
            پایان
            زبانه:
                آدرس = "/invoice"
                عنوان کوتاه = "پیش نمایش"
            پایان
        پایان
    پایان
    اصلی:
        فاصله = 26، 32
        بیشینه عرض = 900
        فضا = 0، "خودکار"
        نمای مسیر: پایان
    پایان
پایان
