همگانی بخش ویرایشگر:
    عنوان = "ویرایش فاکتور"
    جعبه:
        شکاف = 18
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "فاکتور تازه"
        پایان
        جعبه:
            چیدمان = "شبکه"
            ستون‌ها = repeat(fit, minmax(200px, 1fr))
            شکاف = 12
            جعبه:
                شکاف = 4
                برچسب:
                    برای = "client"
                    وزن قلم = 600
                    محتوا = "مشتری"
                پایان
                ورودی:
                    شناسه = "client"
                    فاصله = 10، 12
                    گردی = 8
                    کادر = 1، "توپر"، "#c3d0de"
                    پیوند = مشتری
                پایان
            پایان
            جعبه:
                شکاف = 4
                برچسب:
                    برای = "number"
                    وزن قلم = 600
                    محتوا = "شماره فاکتور"
                پایان
                ورودی:
                    شناسه = "number"
                    فاصله = 10، 12
                    گردی = 8
                    کادر = 1، "توپر"، "#c3d0de"
                    پیوند = شماره
                پایان
            پایان
            جعبه:
                شکاف = 4
                برچسب:
                    برای = "issued"
                    وزن قلم = 600
                    محتوا = "تاریخ صدور"
                پایان
                ورودی:
                    شناسه = "issued"
                    نوع = "تاریخ"
                    فاصله = 10، 12
                    گردی = 8
                    کادر = 1، "توپر"، "#c3d0de"
                    مقدار = تاریخ صدور
                    ورودی = (مقدار: رشته):
                        تاریخ صدور = مقدار
                    پایان
                پایان
            پایان
        پایان
        جعبه:
            سرریز = "خودکار"
            گردی = 12
            پس زمینه = "#ffffff"
            کادر = 1، "توپر"، "#d6e0ea"
            جدول:
                عرض = 100%
                سرصفحه:
                    ردیف:
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            ترازمتن = "چپ"
                            محتوا = "شرح"
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            ترازمتن = "راست"
                            محتوا = "تعداد"
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            ترازمتن = "راست"
                            محتوا = "قیمت"
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            ترازمتن = "راست"
                            محتوا = "مبلغ"
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            محتوا = ""
                        پایان
                    پایان
                پایان
                اصلی:
                    هر ش، جا در دنباله(اقلام.طول()):
                        ردیف ویرایشی:
                            کلید = ش
                            جا = جا
                        پایان
                    پایان
                پایان
            پایان
        پایان
        فرم:
            شناسه = "add-form"
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 8
            تراز = "انتها"
            ارسال = (ی: صحیح۶۴):
                دام.جلوگیری پیش فرض(ی)
                افزودن قلم()
            پایان
            ورودی:
                شناسه = "desc"
                رشد = 3
                پایه = 0
                کمینه عرض = 180
                فاصله = 10، 12
                گردی = 8
                کادر = 1، "توپر"، "#c3d0de"
                جانگهدار = "شرح"
                پیوند = شرح پیش نویس
            پایان
            ورودی:
                شناسه = "qty"
                رشد = 1
                پایه = 0
                کمینه عرض = 70
                فاصله = 10، 12
                گردی = 8
                کادر = 1، "توپر"، "#c3d0de"
                جانگهدار = "تعداد"
                پیوند = تعداد پیش نویس
            پایان
            ورودی:
                شناسه = "price"
                رشد = 1
                پایه = 0
                کمینه عرض = 90
                فاصله = 10، 12
                گردی = 8
                کادر = 1، "توپر"، "#c3d0de"
                جانگهدار = "قیمت (تومان)"
                پیوند = قیمت پیش نویس
            پایان
            دکمه:
                شناسه = "add"
                نوع = "ارسال"
                فاصله = 10، 18
                گردی = 8
                کادر = 0
                پس زمینه = "#23405c"
                رنگ = "#ffffff"
                وزن قلم = 700
                محتوا = "افزودن قلم"
            پایان
        پایان
        پاراگراف:
            شناسه = "add-error"
            فضا = 0
            کمینه ارتفاع = 18
            رنگ = "#b3261e"
            محتوا = خطای افزودن
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 16
            شکستن خط = درست
            تراز = "انتها"
            جعبه:
                شکاف = 4
                برچسب:
                    برای = "tax"
                    وزن قلم = 600
                    محتوا = "مالیات ٪"
                پایان
                ورودی:
                    شناسه = "tax"
                    عرض = 90
                    فاصله = 10، 12
                    گردی = 8
                    کادر = 1، "توپر"، "#c3d0de"
                    مقدار = "" + مالیات
                    ورودی = (مقدار: رشته):
                        مالیات = درصد مجاز(مقدار)
                    پایان
                پایان
            پایان
            جعبه:
                شکاف = 4
                برچسب:
                    برای = "discount"
                    وزن قلم = 600
                    محتوا = "تخفیف ٪"
                پایان
                ورودی:
                    شناسه = "discount"
                    عرض = 90
                    فاصله = 10، 12
                    گردی = 8
                    کادر = 1، "توپر"، "#c3d0de"
                    مقدار = "" + تخفیف
                    ورودی = (مقدار: رشته):
                        تخفیف = درصد مجاز(مقدار)
                    پایان
                پایان
            پایان
            خلاصه:
                شناسه خلاصه = "summary"
            پایان
        پایان
        پیوند:
            شناسه = "preview"
            مقصد = "/invoice"
            فاصله = 12، 18
            گردی = 10
            پس زمینه = "#23405c"
            رنگ = "#ffffff"
            تزیین متن = "هیچ"
            ترازمتن = "وسط"
            وزن قلم = 700
            محتوا = "پیش نمایش فاکتور"
        پایان
    پایان
پایان
