 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش برگه چاپی:
    عنوان = "فاکتور " + شماره
    جعبه:
        شکاف = 18
        جعبه:
            چیدمان = "ردیف"
            شکاف = 10
            رسانه:
                شرط = "print"
                نمایش = "هیچ"
            پایان
            دکمه:
                شناسه = "print"
                فاصله = 10، 18
                گردی = 8
                کادر = 0
                پس زمینه = "#23405c"
                رنگ = "#ffffff"
                وزن قلم = 700
                کلیک = پرینت صفحه_
                محتوا = "چاپ"
            پایان
            پیوند:
                مقصد = "/"
                فاصله = 10، 14
                رنگ = "#23405c"
                محتوا = "بازگشت به ویرایش"
            پایان
        پایان
        مقاله:
            شناسه = "sheet"
            فاصله = 40
            شکاف = 24
            گردی = 8
            پس زمینه = "#ffffff"
            کادر = 1، توپر، #d6e0ea
            جعبه:
                چیدمان = "ردیف"
                چینش = "میان"
                تراز = "ابتدا"
                جعبه:
                    سرتیتر:
                        اندازه = 1
                        فضا = 0
                        محتوا = "فاکتور فروش"
                    پایان
                    پاراگراف:
                        شناسه = "inv-number"
                        فضا = 4، 0، 0، 0
                        رنگ = "#52627a"
                        محتوا = "شماره " + شماره
                    پایان
                پایان
                جعبه:
                    ترازمتن = "راست"
                    پاراگراف:
                        فضا = 0
                        وزن قلم = 700
                        محتوا = "استودیو سلام"
                    پایان
                    پاراگراف:
                        شناسه = "inv-date"
                        فضا = 4، 0، 0، 0
                        رنگ = "#52627a"
                        محتوا = "تاریخ: " + متن تاریخ(تاریخ صدور)
                    پایان
                پایان
            پایان
            جعبه:
                پاراگراف:
                    فضا = 0
                    اندازه قلم = 13
                    رنگ = "#52627a"
                    محتوا = "صورتحساب برای"
                پایان
                پاراگراف:
                    شناسه = "inv-client"
                    فضا = 0
                    اندازه قلم = 18
                    وزن قلم = 700
                    محتوا = مشتری
                پایان
            پایان
            جدول:
                عرض = 100%
                سرصفحه:
                    ردیف:
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            ترازمتن = "چپ"
                            محتوا = "شرح"
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            ترازمتن = "راست"
                            محتوا = "تعداد"
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            ترازمتن = "راست"
                            محتوا = "قیمت"
                        پایان
                        ستون:
                            سرستون = درست
                            فاصله = 10، 8
                            ترازمتن = "راست"
                            محتوا = "مبلغ"
                        پایان
                    پایان
                پایان
                اصلی:
                    هر جا در دنباله(اقلام.طول()):
                        ردیف خواندنی:
                            جا = جا
                        پایان
                    پایان
                پایان
            پایان
            خلاصه:
                شناسه خلاصه = "sheet-summary"
            پایان
        پایان
    پایان
پایان
