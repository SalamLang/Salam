همگانی بخش تراشه(کد: رشته):
    دکمه:
        کلاس = "chip"
        فاصله = 7، 14
        گردی = 999
        نشانگر = اشاره
        کادر = 1، توپر، #bcd3c5
        پس زمینه = #ffffff
        رنگ = #1c3d2e
        اگر فیلتر نوع برابر کد:
            پس زمینه = #1c3d2e
            رنگ = #ffffff
        پایان
        کلیک = ():
            فیلتر نوع = کد
        پایان
        محتوا = نام نوع(کد)
    پایان
پایان

همگانی بخش تراشه حداقل(مبلغ: صحیح، عنوان کوتاه: رشته):
    دکمه:
        کلاس = "minchip"
        فاصله = 7، 14
        گردی = 999
        نشانگر = اشاره
        کادر = 1، توپر، #bcd3c5
        پس زمینه = #ffffff
        رنگ = #1c3d2e
        اگر حداقل حقوق برابر مبلغ:
            پس زمینه = #1c3d2e
            رنگ = #ffffff
        پایان
        کلیک = ():
            حداقل حقوق = مبلغ
        پایان
        محتوا = عنوان کوتاه
    پایان
پایان
