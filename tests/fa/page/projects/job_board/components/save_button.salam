همگانی بخش دکمه ذخیره(شناسه: صحیح):
    دکمه:
        کلاس = "save"
        فاصله = 7، 12
        گردی = 8
        نشانگر = اشاره
        کادر = 1، توپر، #bcd3c5
        پس زمینه = #ffffff
        رنگ = #1c3d2e
        اگر ذخیره شده است(شناسه):
            پس زمینه = #1c3d2e
            رنگ = #ffffff
        پایان
        کلیک = ():
            تغییر ذخیره(شناسه)
        پایان
        محتوا = ذخیره شده است(شناسه) ? "ذخیره شد" : "ذخیره"
    پایان
پایان
