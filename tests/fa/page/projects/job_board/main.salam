// انتظار: var __salam_rt_hash = true
// انتظار: function __salam_route_pick(
// انتظار: پل استخدام
ناپایا شغل ها := شغل های نمونه()
ناپایا ذخیره ها := وکتور {} برگردان وکتور<صحیح>
ناپایا درخواست داده شده := وکتور {} برگردان وکتور<صحیح>
ناپایا جستجو := ""
ناپایا فیلتر نوع := "any"
ناپایا حداقل حقوق := 0
ناپایا تازه ها اول := درست

ساختار شغل:
    همگانی شناسه: صحیح
    همگانی عنوان شغل: رشته
    همگانی شرکت: رشته
    همگانی شهر: رشته
    همگانی نوع: رشته
    همگانی حقوق: صحیح
    همگانی روز انتشار: صحیح
    همگانی درباره: رشته
پایان

تابع ساخت شغل(شناسه: صحیح، عنوان شغل: رشته، شرکت: رشته، شهر: رشته، نوع: رشته، حقوق: صحیح، روز انتشار: صحیح، درباره: رشته): شغل:
    برگشت شغل {شناسه = شناسه، عنوان شغل = عنوان شغل، شرکت = شرکت، شهر = شهر، نوع = نوع، حقوق = حقوق، روز انتشار = روز انتشار، درباره = درباره}
پایان

تابع شغل های نمونه(): وکتور<شغل>:
    ناپایا مقدار := وکتور {} برگردان وکتور<شغل>
    مقدار.افزودن(ساخت شغل(1، "توسعه‌دهنده رابط کاربری"، "آزمایشگاه لومن"، "برلین"، "full"، 72، 2، "پیشخوان‌هایی بسازید که مشتریان ما هر روز به کار می‌برند."))
    مقدار.افزودن(ساخت شغل(2، "طراح محصول"، "هواپیمای کاغذی"، "دورکاری"، "remote"، 65، 5، "سامانه طراحی را به دست بگیرید و تغییرهای کوچک و دقیق منتشر کنید."))
    مقدار.افزودن(ساخت شغل(3، "کارشناس پشتیبانی"، "ابر بندر"، "لیسبون"، "part"، 28، 1، "به مشتریان پاسخ دهید، راهنما بنویسید و خطاها را گزارش کنید."))
    مقدار.افزودن(ساخت شغل(4، "مهندس سرور"، "آزمایشگاه لومن"، "برلین"، "full"، 85، 8، "رابط‌های برنامه‌نویسی را طراحی کنید و خط داده را سالم نگه دارید."))
    مقدار.افزودن(ساخت شغل(5، "تحلیلگر داده"، "قلم"، "دورکاری"، "remote"، 58، 3، "رویدادهای محصول را به پرسش‌های ارزشمند تبدیل کنید."))
    مقدار.افزودن(ساخت شغل(6، "مدیر دفتر"، "هواپیمای کاغذی"، "هامبورگ"، "part"، 30، 12، "دفتر را راه بیندازید و قهوه را همیشه آماده نگه دارید."))
    مقدار.افزودن(ساخت شغل(7، "مهندس دواپس"، "ابر بندر"، "دورکاری"، "remote"، 90، 4، "استقرار را خودکار کنید و تاخیر را کم نگه دارید."))
    برگشت مقدار
پایان

تابع جای شغل(شناسه: صحیح): صحیح:
    تکرار شغل ها.طول() در ی:
        اگر شغل ها[ی].شناسه برابر شناسه:
            برگشت ی
        پایان
    پایان
    برگشت 0 - 1
پایان

تابع ذخیره شده است(شناسه: صحیح): منطقی:
    تکرار ذخیره ها.طول() در ی:
        اگر ذخیره ها[ی] برابر شناسه:
            برگشت درست
        پایان
    پایان
    برگشت نادرست
پایان

تابع درخواست داده است(شناسه: صحیح): منطقی:
    تکرار درخواست داده شده.طول() در ی:
        اگر درخواست داده شده[ی] برابر شناسه:
            برگشت درست
        پایان
    پایان
    برگشت نادرست
پایان

تابع تغییر ذخیره(شناسه: صحیح):
    اگر ذخیره شده است(شناسه):
        ناپایا ماندنی := وکتور {} برگردان وکتور<صحیح>
        تکرار ذخیره ها.طول() در ی:
            اگر ذخیره ها[ی] نابرابر شناسه:
                ماندنی.افزودن(ذخیره ها[ی])
            پایان
        پایان
        ذخیره ها = ماندنی
    وگرنه:
        ذخیره ها.افزودن(شناسه)
    پایان
پایان

تابع درخواست دادن(شناسه: صحیح):
    اگر وارونه درخواست داده است(شناسه):
        درخواست داده شده.افزودن(شناسه)
    پایان
پایان

تابع نمایش داده شود(ج: شغل): منطقی:
    اگر فیلتر نوع نابرابر "any" و ج.نوع نابرابر فیلتر نوع:
        برگشت نادرست
    پایان
    اگر ج.حقوق کوچکتر حداقل حقوق:
        برگشت نادرست
    پایان
    عبارت := جستجو.پیراست().کوچک()
    اگر عبارت.طول() برابر 0:
        برگشت درست
    پایان
    برگشت ج.عنوان شغل.کوچک().دربردارد(عبارت) یا ج.شرکت.کوچک().دربردارد(عبارت) یا ج.شهر.کوچک().دربردارد(عبارت)
پایان

تابع منطبق ها(): وکتور<صحیح>:
    ناپایا جای ها := وکتور {} برگردان وکتور<صحیح>
    تکرار شغل ها.طول() در ی:
        اگر نمایش داده شود(شغل ها[ی]):
            جای ها.افزودن(ی)
        پایان
    پایان
    تعداد := جای ها.طول()
    تکرار تعداد در ا:
        ناپایا بهترین := ا
        تکرار تعداد - ا در ک:
            ب := ا + ک
            جلوتر := تازه ها اول ? شغل ها[جای ها[ب]].روز انتشار کوچکتر شغل ها[جای ها[بهترین]].روز انتشار : شغل ها[جای ها[ب]].حقوق بزرگتر شغل ها[جای ها[بهترین]].حقوق
            اگر جلوتر:
                بهترین = ب
            پایان
        پایان
        اگر بهترین نابرابر ا:
            موقت := جای ها[ا]
            جای ها[ا] = جای ها[بهترین]
            جای ها[بهترین] = موقت
        پایان
    پایان
    برگشت جای ها
پایان

ناب تابع نام نوع(ک: رشته): رشته:
    اگر ک برابر "full":
        برگشت "تمام وقت"
    وگرنه ک برابر "part":
        برگشت "پاره وقت"
    وگرنه ک برابر "remote":
        برگشت "دورکاری"
    پایان
    برگشت "همه"
پایان

ناب تابع متن سن آگهی(روزها: صحیح): رشته:
    اگر روزها برابر 1:
        برگشت "۱ روز پیش"
    پایان
    برگشت روزها + " روز پیش"
پایان

تابع شغل های ذخیره(): وکتور<صحیح>:
    ناپایا جای ها := وکتور {} برگردان وکتور<صحیح>
    تکرار شغل ها.طول() در ی:
        اگر ذخیره شده است(شغل ها[ی].شناسه):
            جای ها.افزودن(ی)
        پایان
    پایان
    برگشت جای ها
پایان

بخش زبانه(آدرس: رشته، عنوان کوتاه: رشته):
    پیوند:
        مقصد = "" + آدرس
        فاصله = 8، 14
        گردی = 999
        تزیین متن = هیچ
        رنگ = #1c3d2e
        محتوا = عنوان کوتاه
    پایان
پایان

همگانی بخش کارت شغل(جا: صحیح):
    مورد:
        کلید = شغل ها[جا].شناسه
        چیدمان = ردیف
        تراز = وسط
        شکاف = 14
        فاصله = 16، 18
        گردی = 14
        پس زمینه = #ffffff
        کادر = 1، توپر، #dbe8e0
        جعبه:
            رشد = 1
            شکاف = 3
            پیوند:
                کلاس = "job-title"
                مقصد = "/job/" + شغل ها[جا].شناسه
                اندازه قلم = 17
                وزن قلم = 700
                رنگ = #15261d
                تزیین متن = هیچ
                محتوا = شغل ها[جا].عنوان شغل
            پایان
            تکه:
                رنگ = #4d6657
                محتوا = شغل ها[جا].شرکت + "، " + شغل ها[جا].شهر
            پایان
            تکه:
                اندازه قلم = 13
                رنگ = #6f8678
                محتوا = نام نوع(شغل ها[جا].نوع) + "، " + متن سن آگهی(شغل ها[جا].روز انتشار)
            پایان
        پایان
        قوی:
            کلاس = "salary"
            رنگ = #1c3d2e
            محتوا = "" + شغل ها[جا].حقوق + " هزار"
        پایان
        دکمه ذخیره:
            شناسه = شغل ها[جا].شناسه
        پایان
    پایان
پایان

صفحه:
    حالت = هش
    عنوان = "پل استخدام"
    زبان = "fa"
    ظاهر سفارشی:
        محتوا = "nav a[aria-current=page] { background: #1c3d2e; color: #ffffff; }"
    پایان
    خانواده قلم = "Vazirmatn, system-ui, sans-serif"
    پس زمینه = #f4f8f5
    رنگ = #15261d
    سرصفحه:
        چیدمان = ردیف
        تراز = وسط
        چینش = میان
        فاصله = 16، 32
        پس زمینه = #ffffff
        کادر پایین = 1، توپر، #dbe8e0
        پیوند:
            مقصد = "/"
            اندازه قلم = 20
            وزن قلم = 800
            رنگ = #1c3d2e
            تزیین متن = هیچ
            محتوا = "پل استخدام"
        پایان
        ناوبری:
            چیدمان = ردیف
            شکاف = 6
            زبانه:
                آدرس = "/"
                عنوان کوتاه = "شغل‌ها"
            پایان
            زبانه:
                آدرس = "/saved"
                عنوان کوتاه = "ذخیره‌ها (" + ذخیره ها.طول() + ")"
            پایان
        پایان
    پایان
    اصلی:
        فاصله = 26، 32
        بیشینه عرض = 860
        فضا = 0، خودکار
        نمای مسیر: پایان
    پایان
