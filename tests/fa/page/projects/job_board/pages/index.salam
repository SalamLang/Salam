همگانی بخش فهرست شغل ها:
    عنوان = "شغل‌ها"
    جعبه:
        شکاف = 14
        ورودی:
            شناسه = "search"
            نوع = جستجو
            فاصله = 12، 16
            گردی = 12
            کادر = 1، "توپر"، "#bcd3c5"
            جانگهدار = "جستجوی عنوان، شرکت یا شهر"
            پیوند = جستجو
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 8
            تراز = "وسط"
            تراشه:
                کد = "any"
            پایان
            تراشه:
                کد = "full"
            پایان
            تراشه:
                کد = "part"
            پایان
            تراشه:
                کد = "remote"
            پایان
            تراشه حداقل:
                مبلغ = 0
                عنوان کوتاه = "هر حقوق"
            پایان
            تراشه حداقل:
                مبلغ = 50
                عنوان کوتاه = "۵۰ هزار به بالا"
            پایان
            تراشه حداقل:
                مبلغ = 70
                عنوان کوتاه = "۷۰ هزار به بالا"
            پایان
            دکمه:
                شناسه = "order"
                فاصله = 7، 12
                گردی = 8
                نشانگر = "اشاره"
                کادر = 1، "توپر"، "#bcd3c5"
                پس زمینه = "#ffffff"
                کلیک = ():
                    تازه ها اول = وارونه تازه ها اول
                پایان
                محتوا = تازه ها اول ? "تازه‌ترین‌ها اول" : "پرحقوق‌ترین‌ها اول"
            پایان
        پایان
        پاراگراف:
            شناسه = "count"
            فضا = 0
            رنگ = "#4d6657"
            محتوا = منطبق ها().طول() + " از " + شغل ها.طول() + " شغل"
        پایان
        فهرست:
            شناسه = "jobs"
            شکاف = 10
            فاصله = 0
            هر _، جا در منطبق ها():
                کارت شغل:
                    کلید = شغل ها[جا].شناسه
                    جا = جا
                پایان
            پایان
        پایان
        اگر منطبق ها().طول() برابر 0:
            پاراگراف:
                شناسه = "none"
                رنگ = "#4d6657"
                محتوا = "شغلی پیدا نشد. فیلتر دیگری را امتحان کنید."
            پایان
        پایان
    پایان
پایان
