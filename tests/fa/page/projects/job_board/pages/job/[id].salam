بخش پنل شغل(شناسه: صحیح):
    جعبه:
        شکاف = 14
        بیشینه عرض = 640
        پیوند:
            مقصد = "/"
            رنگ = "#1c3d2e"
            محتوا = "همه شغل‌ها"
        پایان
        اگر جای شغل(شناسه) کوچکتر 0:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین شغلی نیست"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = شغل ها[جای شغل(شناسه)].عنوان شغل
            پایان
            پاراگراف:
                شناسه = "meta"
                فضا = 0
                رنگ = "#4d6657"
                محتوا = شغل ها[جای شغل(شناسه)].شرکت + "، " + شغل ها[جای شغل(شناسه)].شهر + "، " + نام نوع(شغل ها[جای شغل(شناسه)].نوع) + " , $" + شغل ها[جای شغل(شناسه)].حقوق + " هزار"
            پایان
            پاراگراف:
                فضا = 0
                ارتفاع خط = 1.6
                محتوا = شغل ها[جای شغل(شناسه)].درباره
            پایان
            جعبه:
                چیدمان = "ردیف"
                شکاف = 10
                دکمه ذخیره:
                    شناسه = شناسه
                پایان
                دکمه:
                    شناسه = "apply"
                    فاصله = 10، 20
                    گردی = 8
                    کادر = 0
                    نشانگر = "اشاره"
                    پس زمینه = "#2d7a53"
                    رنگ = "#ffffff"
                    وزن قلم = 700
                    کلیک = ():
                        درخواست دادن(شناسه)
                    پایان
                    محتوا = درخواست داده است(شناسه) ? "درخواست فرستاده شد" : "همین حالا درخواست دهید"
                پایان
            پایان
        پایان
    پایان
پایان

همگانی بخش جزئیات شغل(شناسه: صحیح):
    مسیر = "/job/:شناسه"
    عنوان = "جزئیات شغل"
    پنل شغل:
        شناسه = شناسه
    پایان
پایان
