همگانی بخش شغل های ذخیره شده:
    عنوان = "شغل‌های ذخیره شده"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "شغل‌های ذخیره شده"
        پایان
        اگر ذخیره ها.طول() برابر 0:
            پاراگراف:
                شناسه = "saved-none"
                رنگ = #4d6657
                محتوا = "هنوز چیزی ذخیره نشده است. روی شغل دلخواه ذخیره را بزنید."
            پایان
        پایان
        فهرست:
            شناسه = "saved-jobs"
            شکاف = 10
            فاصله = 0
            هر جا در شغل های ذخیره():
                کارت شغل:
                    جا = جا
                پایان
            پایان
        پایان
    پایان
پایان
