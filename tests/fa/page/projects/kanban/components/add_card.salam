واردسازی دام
همگانی بخش فرم کارت:
    فرم:
        شکاف = 6
        ارسال = (رخداد: صحیح۶۴):
            دام.جلوگیری پیش فرض(رخداد)
            افزودن کارت()
        پایان
        جعبه:
            چیدمان = "row"
            شکاف = 8
            ورودی:
                شناسه = "title"
                رشد = 1
                بیشینه عرض = 420
                فاصله = 10، 12
                گردی = 10
                کادر = 1، "solid"، "#c5ccdb"
                جانگهدار = "عنوان کارت تازه"
                برچسب دسترسی‌پذیری = "عنوان کارت تازه"
                پیوند = پیش‌نویس
            پایان
            دکمه:
                شناسه = "add"
                نوع = «ارسال»
                فاصله = 0، 18
                گردی = 10
                کادر = 0
                پس زمینه = "#3157d5"
                رنگ = "#ffffff"
                وزن قلم = 600
                نشانگر = "pointer"
                محتوا = "افزودن کارت"
            پایان
        پایان
        اگر مشکل.طول() بزرگتر 0:
            پاراگراف:
                شناسه = "problem"
                فضا = 0
                رنگ = "#b42318"
                نقش = "alert"
                محتوا = مشکل
            پایان
        پایان
    پایان
پایان
