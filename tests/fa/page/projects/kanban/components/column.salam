همگانی بخش ستون تخته(ستون جاری: صحیح):
    بخش:
        کلاس = "column"
        رشد = 1
        کمینه عرض = 240
        شکاف = 10
        فاصله = 12
        گردی = 14
        پس زمینه = "#dde2ee"
        سرصفحه:
            چیدمان = "row"
            تراز = "center"
            چینش = "between"
            سرتیتر:
                اندازه = 3
                فضا = 0
                محتوا = نام ستون(ستون جاری)
            پایان
            تکه:
                کلاس = "count"
                فاصله = 2، 10
                گردی = 12
                پس زمینه = "#ffffff"
                اندازه قلم = 13
                محتوا = شمار ستون(ستون جاری)
            پایان
        پایان
        هر شماره، _ در عنوان‌ها:
            اگر ستون‌ها.بگیر(شماره) برابر ستون جاری:
                کاشی کارت:
                    جای = شماره
                پایان
            پایان
        پایان
    پایان
پایان
