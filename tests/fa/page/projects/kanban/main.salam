// انتظار: var __salam_rt_hash = true
// انتظار: کانبان
// انتظار نه: <meta name="salam-router"
واردسازی دام

ناپایا عنوان‌ها := بارگذاری عنوان‌ها()
ناپایا یادداشت‌ها := بارگذاری یادداشت‌ها()
ناپایا ستون‌ها := بارگذاری ستون‌ها()
ناپایا پیش‌نویس := ""
ناپایا مشکل := ""

تابع رکوردها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    خام := دام.دریافت متن ذخیره("kanban.cards")
    اگر خام.طول() برابر 0:
        خروجی.افزودن("0\tنوشتن یادداشت انتشار\tفهرست تغییرات لازم است")
        خروجی.افزودن("0\tبررسی درخواست‌های ادغام باز\t")
        خروجی.افزودن("1\tرفع آزمون ناپایدار\tفقط روی لینوکس دیده شد")
        خروجی.افزودن("2\tراه‌اندازی مخزن\tروز اول انجام شد")
        برگشت خروجی
    پایان
    تکه‌ها := خام.بشکاف("\n")
    تکرار تکه‌ها.طول() در شماره:
        اگر تکه‌ها.بگیر(شماره).طول() بزرگتر 2:
            خروجی.افزودن(تکه‌ها.بگیر(شماره))
        پایان
    پایان
    برگشت خروجی
پایان

تابع بخش_(خط: رشته، جای: صحیح): رشته:
    تکه‌ها := خط.بشکاف("\t")
    اگر جای کوچکتر تکه‌ها.طول():
        برگشت تکه‌ها.بگیر(جای)
    پایان
    برگشت ""
پایان

تابع بارگذاری عنوان‌ها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(بخش_(سطرها.بگیر(شماره)، 1))
    پایان
    برگشت خروجی
پایان

تابع بارگذاری یادداشت‌ها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(بخش_(سطرها.بگیر(شماره)، 2))
    پایان
    برگشت خروجی
پایان

تابع بارگذاری ستون‌ها(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        رده := بخش_(سطرها.بگیر(شماره)، 0)
        خروجی.افزودن(رده برابر "1" ? 1 : (رده برابر "2" ? 2 : 0))
    پایان
    برگشت خروجی
پایان

تابع ذخیره():
    ناپایا خروجی := ""
    تکرار عنوان‌ها.طول() در شماره:
        خروجی += ستون‌ها.بگیر(شماره) + "\t" + عنوان‌ها.بگیر(شماره) + "\t" + یادداشت‌ها.بگیر(شماره) + "\n"
    پایان
    دام.تنظیم متن ذخیره("kanban.cards"، خروجی)
پایان

تابع نام ستون(رده: صحیح): رشته:
    اگر رده برابر 0:
        برگشت "در انتظار"
    وگرنه رده برابر 1:
        برگشت "در دست انجام"
    پایان
    برگشت "انجام شده"
پایان

تابع شمار ستون(رده: صحیح): صحیح:
    ناپایا عدد := 0
    تکرار ستون‌ها.طول() در شماره:
        اگر ستون‌ها.بگیر(شماره) برابر رده:
            عدد++
        پایان
    پایان
    برگشت عدد
پایان

تابع افزودن کارت():
    پاک‌شده := پیش‌نویس.پیراست()
    اگر پاک‌شده.طول() برابر 0:
        مشکل = "کارت باید عنوان داشته باشد"
        برگشت
    پایان
    اگر پاک‌شده.بیاب("\t") بزرگتربرابر 0:
        مشکل = "در عنوان نمی‌توان از تب استفاده کرد"
        برگشت
    پایان
    عنوان‌ها.بیفزا(پاک‌شده)
    یادداشت‌ها.بیفزا("")
    ستون‌ها.بیفزا(0)
    پیش‌نویس = ""
    مشکل = ""
    ذخیره()
پایان

تابع جابه‌جایی کارت(شماره: صحیح، گام: صحیح):
    بعدی := ستون‌ها.بگیر(شماره) + گام
    اگر بعدی کوچکتر 0 یا بعدی بزرگتر 2:
        برگشت
    پایان
    ستون‌ها.بنشان(شماره، بعدی)
    ذخیره()
پایان

تابع حذف کارت(شماره: صحیح):
    عنوان‌ها.حذف‌در(شماره)
    یادداشت‌ها.حذف‌در(شماره)
    ستون‌ها.حذف‌در(شماره)
    ذخیره()
پایان

تابع ذخیره یادداشت‌ها():
    ذخیره()
پایان

همگانی بخش کاشی کارت(جای: صحیح):
    مقاله:
        کلاس = "card"
        شکاف = 8
        فاصله = 12
        گردی = 10
        پس زمینه = "#ffffff"
        سایه = 0، 1، 3، "#1c233318"
        پیوند:
            مقصد = "/card/" + جای
            رنگ = "#1c2333"
            وزن قلم = 600
            تزیین متن = «هیچ»
            محتوا = عنوان‌ها.بگیر(جای)
        پایان
        اگر یادداشت‌ها.بگیر(جای).طول() بزرگتر 0:
            پاراگراف:
                فضا = 0
                اندازه قلم = 13
                شفافیت = 0.65
                محتوا = یادداشت‌ها.بگیر(جای)
            پایان
        پایان
        جعبه:
            چیدمان = "row"
            شکاف = 6
            دکمه:
                کلاس = "left"
                فاصله = 4، 10
                گردی = 8
                کادر = 1، "solid"، "#c5ccdb"
                پس زمینه = "#ffffff"
                نشانگر = "pointer"
                برچسب دسترسی‌پذیری = "جابه‌جایی به چپ"
                غیرفعال = (ستون‌ها.بگیر(جای) برابر 0)
                کلیک = (): جابه‌جایی کارت(جای، -1) پایان
                محتوا = "<"
            پایان
            دکمه:
                کلاس = "right"
                فاصله = 4، 10
                گردی = 8
                کادر = 1، "solid"، "#c5ccdb"
                پس زمینه = "#ffffff"
                نشانگر = "pointer"
                برچسب دسترسی‌پذیری = "جابه‌جایی به راست"
                غیرفعال = (ستون‌ها.بگیر(جای) برابر 2)
                کلیک = (): جابه‌جایی کارت(جای، 1) پایان
                محتوا = ">"
            پایان
            دکمه:
                کلاس = "delete"
                فاصله = 4، 10
                گردی = 8
                کادر = 0
                پس زمینه = «شفاف»
                رنگ = "#b42318"
                نشانگر = "pointer"
                برچسب دسترسی‌پذیری = "حذف کارت"
                کلیک = (): حذف کارت(جای) پایان
                محتوا = "×"
            پایان
        پایان
    پایان
پایان

صفحه:
    حالت = هش
    عنوان = "کانبان"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, Tahoma, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = "#eef1f6"
        رنگ = "#1c2333"
        سرصفحه:
            چیدمان = "row"
            تراز = "center"
            چینش = "between"
            فاصله = 14، 24
            پس زمینه = "#1c2333"
            رنگ = "#ffffff"
            پیوند:
                مقصد = "/"
                رنگ = "#ffffff"
                اندازه قلم = 20
                وزن قلم = 800
                تزیین متن = «هیچ»
                محتوا = "کانبان"
            پایان
            تکه:
                شناسه = "total"
                شفافیت = 0.7
                محتوا = عنوان‌ها.طول() + " کارت"
            پایان
        پایان
        اصلی:
            فاصله = 20، 24
            شکاف = 16
            نمای مسیر: پایان
        پایان
    پایان
پایان
