همگانی بخش برگه کارت(کد: صحیح):
    مسیر = "/card/:کد"
    عنوان = "کارت"
    جعبه:
        شکاف = 12
        بیشینه عرض = 560
        فاصله = 18
        گردی = 14
        پس زمینه = "#ffffff"
        اگر کد کوچکتر عنوان‌ها.طول():
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = عنوان‌ها.بگیر(کد)
            پایان
            پاراگراف:
                شناسه = "where"
                فضا = 0
                محتوا = "ستون کنونی: " + نام ستون(ستون‌ها.بگیر(کد))
            پایان
            برچسب:
                شکاف = 4
                تکه:
                    محتوا = "یادداشت"
                پایان
                ورودی:
                    شناسه = "note"
                    فاصله = 10، 12
                    گردی = 10
                    کادر = 1، "توپر"، "#c5ccdb"
                    پیوند = یادداشت‌ها[کد]
                    تغییر = ذخیره یادداشت‌ها
                پایان
            پایان
            جعبه:
                چیدمان = "ردیف"
                شکاف = 8
                دکمه:
                    شناسه = "back-col"
                    فاصله = 8، 14
                    گردی = 10
                    نشانگر = "اشاره"
                    غیرفعال = (ستون‌ها.بگیر(کد) برابر 0)
                    کلیک = (): جابه‌جایی کارت(کد، -1) پایان
                    محتوا = "یک ستون به عقب"
                پایان
                دکمه:
                    شناسه = "next-col"
                    فاصله = 8، 14
                    گردی = 10
                    نشانگر = "اشاره"
                    غیرفعال = (ستون‌ها.بگیر(کد) برابر 2)
                    کلیک = (): جابه‌جایی کارت(کد، 1) پایان
                    محتوا = "یک ستون به جلو"
                پایان
                دکمه:
                    شناسه = "remove"
                    فاصله = 8، 14
                    گردی = 10
                    کادر = 0
                    پس زمینه = "#fde7e4"
                    رنگ = "#b42318"
                    نشانگر = "اشاره"
                    کلیک = ():
                        حذف کارت(کد)
                        صفحه.مسیر.برو("/")
                    پایان
                    محتوا = "حذف کارت"
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین کارتی نیست"
            پایان
        پایان
        پیوند:
            مقصد = "/"
            محتوا = "بازگشت به تخته"
        پایان
    پایان
پایان
