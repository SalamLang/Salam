همگانی بخش کلید‌صورتحساب:
    جعبه:
        چیدمان = "ردیف"
        چینش = "وسط"
        تراز = "وسط"
        شکاف = 12
        تکه:
            وزن قلم = سالانه ? 400 : 700
            محتوا = "ماهانه"
        پایان
        دکمه:
            کلاس = "billing"
            عرض = 52
            ارتفاع = 28
            گردی = 999
            کادر = 0
            فاصله = 3
            پس زمینه = سالانه ? "#4338ca" : "#c7cbe6"
            نشانگر = "اشاره"
            برچسب دسترسی‌پذیری = "صورتحساب سالانه"
            فشرده‌شده دسترسی‌پذیری = سالانه
            کلیک = (): سالانه = وارونه سالانه پایان
            تکه:
                نمایش = "بلوکی"
                عرض = 22
                ارتفاع = 22
                گردی = 999
                پس زمینه = "#ffffff"
                گذار = 160ms
                جابه‌جایی = سالانه ? "24px" : "0px"، 0
            پایان
        پایان
        تکه:
            وزن قلم = سالانه ? 700 : 400
            محتوا = "سالانه، " + تخفیف‌سالانه + "٪ تخفیف"
        پایان
    پایان
پایان
