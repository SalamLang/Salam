همگانی بخش چرخ‌نقل:
    بخش:
        کلاس = "carousel"
        شکاف = 14
        تراز = وسط
        ترازمتن = وسط
        بیشینه عرض = 640
        فضا = 0، خودکار
        برچسب دسترسی‌پذیری = "نظر مشتری‌ها"
        نقل قول بلند:
            شناسه = "quote"
            فضا = 0
            اندازه قلم = 22
            ارتفاع خط = 1.4
            محتوا = متن‌نقل(اسلاید)
        پایان
        پاراگراف:
            شناسه = "author"
            فضا = 0
            رنگ = #5b6280
            محتوا = گوینده‌نقل(اسلاید)
        پایان
        جعبه:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 14
            دکمه:
                شناسه = "prev"
                فاصله = 6، 14
                گردی = 999
                کادر = 1، توپر، #c7cbe6
                پس زمینه = #ffffff
                نشانگر = اشاره
                برچسب دسترسی‌پذیری = "نقل قبلی"
                کلیک = اسلاید‌قبل
                محتوا = "<"
            پایان
            تکه:
                شناسه = "position"
                رنگ = #5b6280
                محتوا = (اسلاید + 1) + " از " + شمار‌نقل‌ها()
            پایان
            دکمه:
                شناسه = "next"
                فاصله = 6، 14
                گردی = 999
                کادر = 1، توپر، #c7cbe6
                پس زمینه = #ffffff
                نشانگر = اشاره
                برچسب دسترسی‌پذیری = "نقل بعدی"
                کلیک = اسلاید‌بعد
                محتوا = ">"
            پایان
        پایان
    پایان
پایان
