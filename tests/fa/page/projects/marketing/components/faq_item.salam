همگانی بخش گزینه‌پرسش(جا: صحیح):
    جعبه:
        کلاس = "faq"
        کادر پایین = 1، توپر، #e1e4f2
        دکمه:
            کلاس = "question"
            عرض = 100%
            چیدمان = "ردیف"
            چینش = "میان"
            فاصله = 16، 4
            کادر = 0
            پس زمینه = "#00000000"
            رنگ = "#14213d"
            اندازه قلم = 17
            وزن قلم = 600
            ترازمتن = "ابتدا"
            نشانگر = "اشاره"
            باز شده دسترسی‌پذیری = (پرسش باز برابر جا)
            کلیک = (): تغییر‌پرسش(جا) پایان
            تکه:
                محتوا = فاق قویستیون(جا)
            پایان
            تکه:
                محتوا = (پرسش باز برابر جا) ? "-" : "+"
            پایان
        پایان
        اگر پرسش باز برابر جا:
            پاراگراف:
                کلاس = "answer"
                فضا = 0
                فاصله = 0، 4، 16، 4
                رنگ = "#4a5170"
                محتوا = پاسخ‌پرسش(جا)
            پایان
        پایان
    پایان
پایان
