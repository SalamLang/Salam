همگانی بخش خبرنامه:
    فرم:
        بدون اعتبارسنجی = درست
        شکاف = 10
        بیشینه عرض = 460
        فضا = 0، خودکار
        ارسال = (ی: صحیح۶۴):
            سوبمیت فورم(ی)
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 8
            ورودی:
                کلاس = "mail"
                نوع = "ایمیل"
                رشد = 1
                فاصله = 11، 14
                گردی = 10
                کادر = 1، "توپر"، "#c7cbe6"
                اندازه قلم = 16
                تکمیل خودکار = "email"
                برچسب دسترسی‌پذیری = "رایانامه‌ی شما"
                جانگهدار = "you@example.com"
                پیوند = نشانی مشترک
            پایان
            دکمه:
                کلاس = "join"
                نوع = "ارسال"
                فاصله = 11، 18
                گردی = 10
                کادر = 0
                پس زمینه = "#4338ca"
                رنگ = "#ffffff"
                وزن قلم = 600
                نشانگر = "اشاره"
                محتوا = "عضویت"
            پایان
        پایان
        اگر فرم‌فرستاده‌شد و خطای‌ایمیل().طول() بزرگتر 0:
            پاراگراف:
                کلاس = "error"
                فضا = 0
                رنگ = "#b91c1c"
                اندازه قلم = 14
                نقش = "الیرت"
                محتوا = خطای‌ایمیل()
            پایان
        پایان
    پایان
پایان
