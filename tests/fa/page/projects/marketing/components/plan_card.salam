همگانی بخش کارت‌طرح(طرح: صحیح):
    بخش:
        کلاس = "plan"
        فاصله = 24
        گردی = 18
        شکاف = 8
        پس زمینه = "#ffffff"
        کادر = 1، "توپر"، "#e1e4f2"
        اگر طرح برابر 1:
            کادر = 2، "توپر"، "#4338ca"
            سایه = 0، 16، 36، #4338ca24
        پایان
        h2:
            فضا = 0
            اندازه قلم = 20
            محتوا = طرح نام(طرح)
        پایان
        پاراگراف:
            فضا = 0
            رنگ = "#5b6280"
            محتوا = توضیح‌طرح(طرح)
        پایان
        پاراگراف:
            کلاس = "price"
            فضا = 8، 0، 0، 0
            اندازه قلم = 40
            وزن قلم = 800
            محتوا = "" + بهای‌نمایشی(طرح)
            تکه:
                اندازه قلم = 15
                وزن قلم = 400
                رنگ = "#5b6280"
                محتوا = " هزار تومان در ماه"
            پایان
        پایان
        پاراگراف:
            کلاس = "billed"
            فضا = 0
            رنگ = "#5b6280"
            اندازه قلم = 14
            محتوا = متن‌صورتحساب(طرح)
        پایان
        پیوند:
            مقصد = "/subscribe"
            فضا = 10، 0، 0، 0
            فاصله = 11، 16
            گردی = 12
            ترازمتن = "وسط"
            تزیین متن = "هیچ"
            وزن قلم = 600
            پس زمینه = (طرح برابر 1) ? "#4338ca" : "#eef0fb"
            رنگ = (طرح برابر 1) ? "#ffffff" : "#4338ca"
            محتوا = "انتخاب طرح " + طرح نام(طرح)
        پایان
    پایان
پایان
