// انتظار: <meta name="salam-router" content="history">
// انتظار: ریتم
واردسازی دام

پایا نام‌برند := "ریتم"
پایا تخفیف‌سالانه := 20

ناپایا سالانه := نادرست
ناپایا پرسش باز := -1
ناپایا اسلاید := 0
ناپایا نشانی مشترک := ""
ناپایا فرم‌فرستاده‌شد := نادرست

تابع نام‌طرح‌ها(): وکتور<رشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<رشته>
    و_.افزودن("فردی")
    و_.افزودن("تیمی")
    و_.افزودن("سازمانی")
    برگشت و_
پایان

تابع طرح نام(طرح: صحیح): رشته:
    برگشت نام‌طرح‌ها().بگیر(طرح)
پایان

تابع فاق قویستیون(جا: صحیح): رشته:
    برگشت پرسش‌ها().بگیر(جا)
پایان

تابع سوبمیت فورم(ی: صحیح۶۴):
    دام.جلوگیری پیش فرض(ی)
    عضویت()
پایان

تابع بهای‌ماهانه(طرح: صحیح): صحیح:
    اگر طرح برابر 0:
        برگشت 9
    وگرنه طرح برابر 1:
        برگشت 29
    پایان
    برگشت 79
پایان

تابع بهای‌نمایشی(طرح: صحیح): صحیح:
    اگر سالانه:
        برگشت بهای‌ماهانه(طرح) * (100 - تخفیف‌سالانه) / 100
    پایان
    برگشت بهای‌ماهانه(طرح)
پایان

تابع متن‌صورتحساب(طرح: صحیح): رشته:
    اگر سالانه:
        برگشت "صورتحساب سالانه، " + (بهای‌نمایشی(طرح) * 12) + " هزار تومان در سال"
    پایان
    برگشت "صورتحساب ماهانه"
پایان

تابع توضیح‌طرح(طرح: صحیح): رشته:
    اگر طرح برابر 0:
        برگشت "برای یک نفر که کارهای زیادی برای برنامه‌ریزی دارد."
    وگرنه طرح برابر 1:
        برگشت "تخته‌های مشترک برای تا ده نفر."
    پایان
    برگشت "بی‌شمار عضو، ورود یکپارچه و یک آدم واقعی پای تلفن."
پایان

تابع پرسش‌ها(): وکتور<رشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<رشته>
    و_.افزودن("آیا می‌توانم ریتم را رایگان امتحان کنم؟")
    و_.افزودن("بعدا می‌توانم طرحم را عوض کنم؟")
    و_.افزودن("پول را برمی‌گردانید؟")
    و_.افزودن("داده‌های من کجا نگهداری می‌شود؟")
    برگشت و_
پایان

تابع پاسخ‌پرسش(جا: صحیح): رشته:
    اگر جا برابر 0:
        برگشت "بله. هر طرح با سی روز رایگان شروع می‌شود و کارت نمی‌خواهد."
    وگرنه جا برابر 1:
        برگشت "هر زمان. بها از روز صورتحساب بعدی تغییر می‌کند."
    وگرنه جا برابر 2:
        برگشت "اگر ریتم به کارتان نیامد، تا شصت روز به ما بنویسید تا آخرین پرداخت را برگردانیم."
    پایان
    برگشت "در اتحادیه‌ی اروپا و رمزگذاری‌شده. می‌توانید همه‌چیز را به صورت یک پرونده بگیرید."
پایان

تابع تغییر‌پرسش(جا: صحیح):
    اگر پرسش باز برابر جا:
        پرسش باز = -1
    وگرنه:
        پرسش باز = جا
    پایان
پایان

تابع متن‌نقل(جا: صحیح): رشته:
    اگر جا برابر 0:
        برگشت "از هفته‌ای که به ریتم آمدیم دیگر کارها در گفتگو گم نشدند."
    وگرنه جا برابر 1:
        برگشت "اولین برنامه‌ریزی است که همه‌ی تیمم بی‌آن که بگویم باز می‌کنند."
    پایان
    برگشت "راه‌اندازی ده دقیقه طول کشید و کسی آموزش لازم نداشت."
پایان

تابع گوینده‌نقل(جا: صحیح): رشته:
    اگر جا برابر 0:
        برگشت "دانا، مدیر استودیو"
    وگرنه جا برابر 1:
        برگشت "مارکوس، مدیر مهندسی"
    پایان
    برگشت "پریا، عملیات"
پایان

تابع شمار‌نقل‌ها(): صحیح:
    برگشت 3
پایان

تابع اسلاید‌بعد():
    اسلاید = (اسلاید + 1) % شمار‌نقل‌ها()
پایان

تابع اسلاید‌قبل():
    اسلاید = (اسلاید + شمار‌نقل‌ها() - 1) % شمار‌نقل‌ها()
پایان

تابع خطای‌ایمیل(): رشته:
    اگر وارونه نشانی مشترک.دربردارد("@") یا وارونه نشانی مشترک.دربردارد("."):
        برگشت "یک نشانی رایانامه‌ی درست بنویسید."
    پایان
    برگشت ""
پایان

تابع عضویت():
    فرم‌فرستاده‌شد = درست
    اگر خطای‌ایمیل().طول() برابر 0:
        صفحه.مسیر.برو("/subscribed")
    پایان
پایان

صفحه:
    عنوان = نام‌برند + "، طرح‌هایی که همراهتان می‌مانند"
    زبان = "fa"
    پس زمینه = #ffffff
    رنگ = #14213d
    خانواده قلم = "Vazirmatn, Tahoma, sans-serif"
    ارتفاع خط = 1.6
    سرصفحه:
        چیدمان = ردیف
        تراز = وسط
        چینش = میان
        شکستن خط = درست
        شکاف = 10
        فاصله = 16، 5vw
        موقعیت = چسبان
        بالا = 0
        پس زمینه = #ffffffee
        پیوند:
            مقصد = "/"
            اندازه قلم = 22
            وزن قلم = 800
            رنگ = #4338ca
            تزیین متن = هیچ
            محتوا = نام‌برند
        پایان
        ناوبری:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 18
            پیوند:
                مقصد = "/pricing"
                رنگ = #14213d
                تزیین متن = هیچ
                محتوا = "قیمت‌ها"
            پایان
            پیوند:
                مقصد = "/faq"
                رنگ = #14213d
                تزیین متن = هیچ
                محتوا = "پرسش‌ها"
            پایان
            پیوند:
                مقصد = "/subscribe"
                فاصله = 8، 16
                گردی = 999
                پس زمینه = #4338ca
                رنگ = #ffffff
                تزیین متن = هیچ
                محتوا = "دریافت خبر"
            پایان
        پایان
    پایان
    اصلی:
        نمای مسیر: پایان
    پایان
    پاورقی:
        فاصله = 32، 5vw
        پس زمینه = #f4f5fb
        رنگ = #5b6280
        ترازمتن = وسط
        اندازه قلم = 14
        محتوا = نام‌برند + "، ساخته‌شده با سلام"
    پایان
پایان
