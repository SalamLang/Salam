همگانی بخش صفحه‌پرسش‌ها:
    عنوان = "پرسش‌ها | " + نام‌برند
    جعبه:
        فاصله = 48، 5vw
        بیشینه عرض = 720
        فضا = 0، خودکار
        سرتیتر:
            اندازه = 1
            محتوا = "پرسش‌های پرتکرار"
        پایان
        هر ی، _ در پرسش‌ها():
            گزینه‌پرسش:
                جا = ی
            پایان
        پایان
    پایان
پایان
