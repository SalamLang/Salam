همگانی بخش خانه:
    عنوان = نام‌برند + "، طرح‌هایی که همراهتان می‌مانند"
    جعبه:
        بخش:
            فاصله = 72، 5vw
            ترازمتن = "وسط"
            شکاف = 16
            پس زمینه = "#f1f1fb"
            سرتیتر:
                اندازه = 1
                فضا = 0
                اندازه قلم = 52
                ارتفاع خط = 1.1
                محتوا = "هفته را برنامه بریزید. آرامشتان را نگه دارید."
            پایان
            پاراگراف:
                فضا = 0، خودکار
                بیشینه عرض = 540
                اندازه قلم = 19
                رنگ = "#4a5170"
                محتوا = نام‌برند + " انبوه کارها را به هفته‌ای تبدیل می‌کند که واقعا تمام می‌شود."
            پایان
            جعبه:
                چیدمان = "ردیف"
                چینش = "وسط"
                شکاف = 12
                پیوند:
                    مقصد = "/pricing"
                    فاصله = 13، 24
                    گردی = 12
                    پس زمینه = "#4338ca"
                    رنگ = "#ffffff"
                    تزیین متن = "هیچ"
                    وزن قلم = 600
                    محتوا = "دیدن قیمت‌ها"
                پایان
                پیوند:
                    مقصد = "/faq"
                    فاصله = 13، 24
                    گردی = 12
                    کادر = 1، توپر، #c7cbe6
                    رنگ = "#14213d"
                    تزیین متن = "هیچ"
                    محتوا = "پرسش‌ها"
                پایان
            پایان
        پایان
        بخش:
            فاصله = 56، 5vw
            شکاف = 24
            سرتیتر:
                اندازه = 2
                فضا = 0
                ترازمتن = "وسط"
                محتوا = "طرح برای هر اندازه"
            پایان
            کلید‌صورتحساب: پایان
            جعبه:
                چیدمان = "شبکه"
                چندستونی = repeat (fit، minmax(240px، 1fr))
                شکاف = 20
                بیشینه عرض = 960
                فضا = 0، خودکار
                هر ی، _ در نام‌طرح‌ها():
                    کارت‌طرح:
                        طرح = ی
                    پایان
                پایان
            پایان
        پایان
        بخش:
            فاصله = 56، 5vw
            پس زمینه = "#f4f5fb"
            شکاف = 20
            سرتیتر:
                اندازه = 2
                فضا = 0
                ترازمتن = "وسط"
                محتوا = "محبوب تیم‌های کوچک"
            پایان
            چرخ‌نقل: پایان
        پایان
        بخش:
            فاصله = 56، 5vw
            شکاف = 12
            ترازمتن = "وسط"
            سرتیتر:
                اندازه = 2
                فضا = 0
                محتوا = "خبرهای محصول"
            پایان
            خبرنامه: پایان
        پایان
    پایان
پایان
