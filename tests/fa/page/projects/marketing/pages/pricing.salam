همگانی بخش قیمت‌ها:
    عنوان = "قیمت‌ها | " + نام‌برند
    جعبه:
        فاصله = 48، 5vw
        شکاف = 24
        سرتیتر:
            اندازه = 1
            فضا = 0
            ترازمتن = وسط
            محتوا = "قیمت‌های ساده"
        پایان
        کلید‌صورتحساب: پایان
        جعبه:
            چیدمان = شبکه
            چندستونی = repeat (fit، minmax(240px، 1fr))
            شکاف = 20
            بیشینه عرض = 960
            فضا = 0، خودکار
            هر ی، _ در نام‌طرح‌ها():
                کارت‌طرح:
                    طرح = ی
                پایان
            پایان
        پایان
    پایان
پایان
