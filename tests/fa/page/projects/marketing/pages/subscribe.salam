همگانی بخش صفحه‌اشتراک:
    عنوان = "عضویت | " + نام‌برند
    جعبه:
        فاصله = 64، 5vw
        شکاف = 16
        ترازمتن = وسط
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "در جریان بمانید"
        پایان
        پاراگراف:
            فضا = 0
            رنگ = #4a5170
            محتوا = "ماهی یک نامه‌ی کوتاه. بدون هرزنامه و هر زمان می‌توانید بروید."
        پایان
        خبرنامه: پایان
    پایان
پایان
