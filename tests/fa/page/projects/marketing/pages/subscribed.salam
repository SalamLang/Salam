همگانی بخش اشتراک‌انجام‌شد:
    عنوان = "خوش آمدید | " + نام‌برند
    جعبه:
        فاصله = 64، 5vw
        شکاف = 14
        ترازمتن = "وسط"
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "نامتان در فهرست است"
        پایان
        پاراگراف:
            شناسه = "confirmation"
            فضا = 0
            محتوا = "تاییدیه‌ای فرستادیم به " + نشانی مشترک + "."
        پایان
        پیوند:
            مقصد = "/"
            رنگ = "#4338ca"
            محتوا = "بازگشت به " + نام‌برند
        پایان
    پایان
پایان
