همگانی بخش نوار‌پیشرفت(درصد: صحیح):
    جعبه:
        کلاس = "bar"
        ارتفاع = 6
        گردی = 999
        پس زمینه = "#e4e2ee"
        سرریز = "پنهان"
        جعبه:
            کلاس = "fill"
            ارتفاع = 100%
            عرض = درصد + "%"
            پس زمینه = "#7c3aed"
            گذار = 300ms، خطی
        پایان
    پایان
پایان
