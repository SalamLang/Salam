همگانی بخش ردیف‌صف(شماره: صحیح، آهنگ: صحیح):
    جعبه:
        کلاس = "queued"
        چیدمان = "ردیف"
        تراز = "وسط"
        شکاف = 10
        فاصله = 10، 14
        گردی = 12
        پس زمینه = "#ffffff"
        کادر = 1، توپر، #e4e2ee
        تکه:
            وزن قلم = 700
            رنگ = "#7c3aed"
            محتوا = (شماره + 1) + "."
        پایان
        پاراگراف:
            فضا = 0
            رشد = 1
            محتوا = عنوان‌آهنگ(آهنگ) + " - " + هنرمند‌آهنگ(آهنگ)
        پایان
        دکمه:
            کلاس = "up"
            فاصله = 4، 10
            گردی = 999
            کادر = 1، توپر، #ccc9e0
            پس زمینه = "شفاف"
            نشانگر = "اشاره"
            کلیک = ():
                بالا‌بردن‌در‌صف(شماره)
            پایان
            محتوا = "بالا"
        پایان
        دکمه:
            کلاس = "remove"
            فاصله = 4، 10
            گردی = 999
            کادر = 1، توپر، #e11d48
            پس زمینه = "شفاف"
            رنگ = "#e11d48"
            نشانگر = "اشاره"
            کلیک = ():
                حذف‌از‌صف(شماره)
            پایان
            محتوا = "حذف"
        پایان
    پایان
پایان
