همگانی بخش کنترل‌پخش(اجرا: منطقی):
    جعبه:
        چیدمان = "ردیف"
        تراز = "وسط"
        چینش = "وسط"
        شکاف = 14
        دکمه:
            شناسه = "prev"
            فاصله = 10، 18
            گردی = 999
            کادر = 1، "توپر"، "#7c3aed"
            پس زمینه = "شفاف"
            رنگ = "#7c3aed"
            نشانگر = "اشاره"
            کلیک = آهنگ‌قبلی
            محتوا = "قبلی"
        پایان
        دکمه:
            شناسه = "play"
            فاصله = 12، 28
            گردی = 999
            کادر = 0
            پس زمینه = "#7c3aed"
            رنگ = "#ffffff"
            وزن قلم = 700
            نشانگر = "اشاره"
            کلیک = تغییر‌پخش
            محتوا = اجرا ? "توقف" : "پخش"
        پایان
        دکمه:
            شناسه = "next"
            فاصله = 10، 18
            گردی = 999
            کادر = 1، "توپر"، "#7c3aed"
            پس زمینه = "شفاف"
            رنگ = "#7c3aed"
            نشانگر = "اشاره"
            کلیک = آهنگ‌بعدی
            محتوا = "بعدی"
        پایان
    پایان
پایان
