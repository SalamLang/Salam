واردسازی دام

پایا آهنگ‌ها := [0، 1، 2، 3، 4، 5]

ناپایا آهنگ‌کنونی := 0
ناپایا سپری‌شده := 0
ناپایا درحال‌پخش := نادرست
ناپایا زمان‌سنج := 0 برگردان صحیح۶۴
ناپایا صف‌بعدی := وکتور {} برگردان وکتور<صحیح>
ناپایا بلندی := 70
ناپایا سریع := نادرست
ناپایا تکرار‌همه := درست

ناب تابع عنوان‌آهنگ(آهنگ: صحیح): رشته:
    اگر آهنگ برابر 0:
        برگشت "نویز صبحگاهی"
    وگرنه آهنگ برابر 1:
        برگشت "قایق‌های کاغذی"
    وگرنه آهنگ برابر 2:
        برگشت "رادیو جزر"
    وگرنه آهنگ برابر 3:
        برگشت "سیم مسی"
    وگرنه آهنگ برابر 4:
        برگشت "فانوس‌های آرام"
    پایان
    برگشت "آخرین قطار به خانه"
پایان

ناب تابع هنرمند‌آهنگ(آهنگ: صحیح): رشته:
    اگر آهنگ % 2 برابر 0:
        برگشت "موتورهای آرام"
    پایان
    برگشت "میرا دالتون"
پایان

ناب تابع طول‌آهنگ(آهنگ: صحیح): صحیح:
    اگر آهنگ برابر 0:
        برگشت 184
    وگرنه آهنگ برابر 1:
        برگشت 212
    وگرنه آهنگ برابر 2:
        برگشت 167
    وگرنه آهنگ برابر 3:
        برگشت 241
    وگرنه آهنگ برابر 4:
        برگشت 198
    پایان
    برگشت 223
پایان

ناب تابع دورقمی(عدد: صحیح): رشته:
    اگر عدد کوچکتر 10:
        برگشت "0" + عدد
    پایان
    برگشت "" + عدد
پایان

ناب تابع دقیقه‌ثانیه(ثانیه‌ها: صحیح): رشته:
    برگشت (ثانیه‌ها / 60) + ":" + دورقمی(ثانیه‌ها % 60)
پایان

ناب تابع درصد‌پیشرفت(): صحیح:
    برگشت سپری‌شده * 100 / طول‌آهنگ(آهنگ‌کنونی)
پایان

ناب تابع گام‌زمانی(): صحیح:
    اگر سریع:
        برگشت 10
    پایان
    برگشت 1
پایان

تابع آهنگ‌بعدی():
    سپری‌شده = 0
    اگر صف‌بعدی.طول() بزرگتر 0:
        آهنگ‌کنونی = صف‌بعدی[0]
        صف‌بعدی.حذف در(0)
    وگرنه تکرار‌همه:
        آهنگ‌کنونی = (آهنگ‌کنونی + 1) % 6
    پایان
پایان

تابع ضربان():
    سپری‌شده += گام‌زمانی()
    اگر سپری‌شده بزرگتربرابر طول‌آهنگ(آهنگ‌کنونی):
        آهنگ‌بعدی()
    پایان
پایان

تابع آغاز‌پخش():
    اگر وارونه درحال‌پخش:
        زمان‌سنج = دام.تنظیم بازه((): ضربان() پایان، 1000)
        درحال‌پخش = درست
    پایان
پایان

تابع توقف‌پخش():
    اگر درحال‌پخش:
        دام.پاک کردن بازه(زمان‌سنج)
        درحال‌پخش = نادرست
    پایان
پایان

تابع تغییر‌پخش():
    اگر درحال‌پخش:
        توقف‌پخش()
    وگرنه:
        آغاز‌پخش()
    پایان
پایان

تابع پخش‌آهنگ(آهنگ: صحیح):
    آهنگ‌کنونی = آهنگ
    سپری‌شده = 0
    آغاز‌پخش()
پایان

تابع آهنگ‌قبلی():
    اگر سپری‌شده بزرگتر 3:
        سپری‌شده = 0
    وگرنه:
        آهنگ‌کنونی = (آهنگ‌کنونی + 5) % 6
        سپری‌شده = 0
    پایان
پایان

تابع افزودن‌به‌صف(آهنگ: صحیح):
    صف‌بعدی.افزودن(آهنگ)
پایان

تابع حذف‌از‌صف(جایگاه: صحیح):
    صف‌بعدی.حذف در(جایگاه)
پایان

تابع بالا‌بردن‌در‌صف(جایگاه: صحیح):
    اگر جایگاه بزرگتر 0:
        بالایی := صف‌بعدی[جایگاه - 1]
        صف‌بعدی[جایگاه - 1] = صف‌بعدی[جایگاه]
        صف‌بعدی[جایگاه] = بالایی
    پایان
پایان

تابع رفتن‌به(نوشته: رشته):
    سپری‌شده = نوشته.به صحیح()
پایان

تابع تنظیم‌بلندی(نوشته: رشته):
    بلندی = نوشته.به صحیح()
پایان

تابع کلید‌قاب(رویداد: صحیح۶۴):
    کلید := دام.کلید رویداد(رویداد)
    اگر کلید برابر " ":
        دام.جلوگیری پیش فرض(رویداد)
        تغییر‌پخش()
    وگرنه کلید برابر "n":
        آهنگ‌بعدی()
    وگرنه کلید برابر "p":
        آهنگ‌قبلی()
    پایان
پایان

همگانی بخش ردیف‌آهنگ(آهنگ: صحیح، فعلی: منطقی):
    جعبه:
        کلاس = "track"
        چیدمان = "ردیف"
        تراز = "وسط"
        شکاف = 12
        فاصله = 10، 14
        گردی = 12
        پس زمینه = "#ffffff"
        کادر = 1، "توپر"، "#e4e2ee"
        اگر فعلی:
            کادر = 1، "توپر"، "#7c3aed"
            پس زمینه = "#f3edff"
        پایان
        دکمه:
            کلاس = "play"
            عرض = 36
            ارتفاع = 36
            گردی = 50%
            کادر = 0
            پس زمینه = "#7c3aed"
            رنگ = "#ffffff"
            نشانگر = "اشاره"
            کلیک = ():
                پخش‌آهنگ(آهنگ)
            پایان
            محتوا = (فعلی و درحال‌پخش) ? "||" : ">"
        پایان
        پیوند:
            to = "/track/" + آهنگ
            رشد = 1
            رنگ = "#1d1b2e"
            تزیین متن = "هیچ"
            وزن قلم = 600
            محتوا = عنوان‌آهنگ(آهنگ)
        پایان
        ریز:
            شفافیت = 0.65
            محتوا = هنرمند‌آهنگ(آهنگ)
        پایان
        ریز:
            شفافیت = 0.65
            محتوا = دقیقه‌ثانیه(طول‌آهنگ(آهنگ))
        پایان
        دکمه:
            کلاس = "queue-add"
            فاصله = 4، 10
            گردی = 999
            کادر = 1، "توپر"، "#7c3aed"
            پس زمینه = "شفاف"
            رنگ = "#7c3aed"
            نشانگر = "اشاره"
            کلیک = ():
                افزودن‌به‌صف(آهنگ)
            پایان
            محتوا = "+ صف"
        پایان
    پایان
پایان

صفحه:
    عنوان = "پژواک"
    زبان = "fa"
    قلم = "Tahoma, system-ui, sans-serif"
    جعبه:
        فشردن کلید = کلید‌قاب
        ترتیب جهش = 0
        کمینه ارتفاع = 100vh
        پس زمینه = "#f6f5fb"
        رنگ = "#1d1b2e"
        سرصفحه:
            چیدمان = "ردیف"
            تراز = "وسط"
            چینش = "میان"
            شکستن خط = درست
            شکاف = 10
            فاصله = 14، 28
            پس زمینه = "#1d1b2e"
            پیوند:
                to = "/"
                اندازه قلم = 22
                وزن قلم = 800
                رنگ = "#ffffff"
                تزیین متن = "هیچ"
                محتوا = "پژواک"
            پایان
            ناوبری:
                چیدمان = "ردیف"
                شکاف = 6
                پیوند:
                    to = "/"
                    فاصله = 8، 14
                    رنگ = "#d9d4f5"
                    تزیین متن = "هیچ"
                    محتوا = "کتابخانه"
                پایان
                پیوند:
                    to = "/now"
                    فاصله = 8، 14
                    رنگ = "#d9d4f5"
                    تزیین متن = "هیچ"
                    محتوا = "درحال پخش"
                پایان
                پیوند:
                    شناسه = "queue-link"
                    to = "/queue"
                    فاصله = 8، 14
                    گردی = 999
                    پس زمینه = "#7c3aed"
                    رنگ = "#ffffff"
                    تزیین متن = "هیچ"
                    محتوا = "صف (" + صف‌بعدی.طول() + ")"
                پایان
            پایان
        پایان
        اصلی:
            بیشینه عرض = 760
            عرض = 100%
            فضا = 0، "خودکار"
            فاصله = 20، 16، 110، 16
            نمای مسیر: پایان
        پایان
        پاورقی:
            شناسه = "mini"
            موقعیت = "ثابت"
            پایین = 0
            چپ = 0
            راست = 0
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 12
            فاصله = 10، 20
            پس زمینه = "#ffffff"
            کادر بالا = 1، "توپر"، "#e4e2ee"
            دکمه:
                شناسه = "toggle"
                عرض = 40
                ارتفاع = 40
                گردی = 50%
                کادر = 0
                پس زمینه = "#7c3aed"
                رنگ = "#ffffff"
                نشانگر = "اشاره"
                کلیک = تغییر‌پخش
                محتوا = درحال‌پخش ? "||" : ">"
            پایان
            جعبه:
                رشد = 1
                پاراگراف:
                    شناسه = "mini-title"
                    فضا = 0
                    وزن قلم = 700
                    محتوا = عنوان‌آهنگ(آهنگ‌کنونی)
                پایان
                نوار‌پیشرفت:
                    درصد = درصد‌پیشرفت()
                پایان
            پایان
            تکه:
                شناسه = "clock"
                محتوا = دقیقه‌ثانیه(سپری‌شده) + " / " + دقیقه‌ثانیه(طول‌آهنگ(آهنگ‌کنونی))
            پایان
        پایان
    پایان
پایان
