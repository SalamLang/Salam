همگانی بخش کتابخانه:
    عنوان = "پژواک"
    جعبه:
        شکاف = 10
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "کتابخانه"
        پایان
        هر آهنگ در آهنگ‌ها:
            ردیف‌آهنگ:
                آهنگ = آهنگ
                فعلی = (آهنگ برابر آهنگ‌کنونی)
            پایان
        پایان
    پایان
پایان
