همگانی بخش اکنون‌پخش:
    عنوان = "درحال پخش"
    جعبه:
        شکاف = 18
        تراز = وسط
        ترازمتن = وسط
        جعبه:
            عرض = 220
            ارتفاع = 220
            گردی = 24
            تراز = وسط
            چینش = وسط
            اندازه قلم = 80
            رنگ = #ffffff
            پس زمینه = #7c3aed
            محتوا = درحال‌پخش ? "♪" : "♫"
        پایان
        سرتیتر:
            id = "now-title"
            اندازه = 2
            فضا = 0
            محتوا = عنوان‌آهنگ(آهنگ‌کنونی)
        پایان
        پاراگراف:
            فضا = 0
            شفافیت = 0.7
            محتوا = هنرمند‌آهنگ(آهنگ‌کنونی)
        پایان
        جعبه:
            عرض = 100%
            بیشینه عرض = 420
            شکاف = 6
            ورودی:
                id = "seek"
                نوع = بازه
                کمینه = 0
                بیشینه = طول‌آهنگ(آهنگ‌کنونی)
                مقدار = سپری‌شده
                ورودی = (نوشته: رشته):
                    رفتن‌به(نوشته)
                پایان
            پایان
            جعبه:
                چیدمان = ردیف
                چینش = میان
                ریز:
                    id = "elapsed"
                    محتوا = دقیقه‌ثانیه(سپری‌شده)
                پایان
                ریز:
                    محتوا = دقیقه‌ثانیه(طول‌آهنگ(آهنگ‌کنونی))
                پایان
            پایان
        پایان
        کنترل‌پخش:
            اجرا = درحال‌پخش
        پایان
        برچسب:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 8
            ورودی:
                id = "fast"
                نوع = تیک
                پیوند = سریع
            پایان
            تکه:
                محتوا = "سرعت نمایشی (۱۰ برابر)"
            پایان
        پایان
        برچسب:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 8
            تکه:
                محتوا = "بلندی " + بلندی
            پایان
            ورودی:
                id = "volume"
                نوع = بازه
                کمینه = 0
                بیشینه = 100
                مقدار = بلندی
                ورودی = (نوشته: رشته):
                    تنظیم‌بلندی(نوشته)
                پایان
            پایان
        پایان
    پایان
پایان
