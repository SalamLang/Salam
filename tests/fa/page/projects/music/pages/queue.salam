همگانی بخش صف:
    عنوان = "Queue"
    جعبه:
        شکاف = 10
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "بعدی‌ها"
        پایان
        اگر صف‌بعدی.طول() برابر 0:
            پاراگراف:
                id = "empty"
                محتوا = "صف خالی است. بعد از آهنگ فعلی کتابخانه به ترتیب پخش می‌شود."
            پایان
        پایان
        هر شماره، آهنگ در صف‌بعدی:
            ردیف‌صف:
                شماره = شماره
                آهنگ = آهنگ
            پایان
        پایان
        پیوند:
            to = "/"
            رنگ = #7c3aed
            محتوا = "افزودن از کتابخانه"
        پایان
    پایان
پایان
