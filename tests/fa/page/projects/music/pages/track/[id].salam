همگانی بخش جزئیات(id: صحیح):
    عنوان = عنوان‌آهنگ(id)
    جعبه:
        شکاف = 12
        اگر id بزرگتربرابر 0 و id کوچکتر 6:
            پیوند:
                to = "/"
                رنگ = #7c3aed
                تزیین متن = هیچ
                محتوا = "بازگشت به کتابخانه"
            پایان
            سرتیتر:
                id = "detail-title"
                اندازه = 1
                فضا = 0
                محتوا = عنوان‌آهنگ(id)
            پایان
            پاراگراف:
                فضا = 0
                محتوا = هنرمند‌آهنگ(id) + " - " + دقیقه‌ثانیه(طول‌آهنگ(id))
            پایان
            جعبه:
                چیدمان = ردیف
                شکاف = 8
                دکمه:
                    id = "detail-play"
                    فاصله = 10، 22
                    گردی = 999
                    کادر = 0
                    پس زمینه = #7c3aed
                    رنگ = #ffffff
                    نشانگر = اشاره
                    کلیک = ():
                        پخش‌آهنگ(id)
                    پایان
                    محتوا = "پخش"
                پایان
                دکمه:
                    id = "detail-queue"
                    فاصله = 10، 22
                    گردی = 999
                    کادر = 1، توپر، #7c3aed
                    پس زمینه = شفاف
                    رنگ = #7c3aed
                    نشانگر = اشاره
                    کلیک = ():
                        افزودن‌به‌صف(id)
                    پایان
                    محتوا = "افزودن به صف"
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 2
                محتوا = "چنین آهنگی نیست"
            پایان
            پیوند:
                to = "/"
                محتوا = "بازگشت به کتابخانه"
            پایان
        پایان
    پایان
پایان
