// انتظار: var __salam_rt_hash = true
// انتظار نه: <meta name="salam-router"
ناپایا عنوان‌ها := عنوان‌های آغازین()
ناپایا متن‌ها := متن‌های آغازین()
ناپایا پیش‌نویس := ""
ناپایا تیره := نادرست

تابع عنوان‌های آغازین(): وکتور<رشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<رشته>
    و_.افزودن("خرید خانه")
    و_.افزودن("ایده‌ها")
    و_.افزودن("برنامه‌ی سفر")
    برگشت و_
پایان

تابع متن‌های آغازین(): وکتور<رشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<رشته>
    و_.افزودن("جو، لیمو، قهوه")
    و_.افزودن("یک برنامه‌ی یادداشت با سلام")
    و_.افزودن("قطار ساعت نه، موزه بعد از ناهار")
    برگشت و_
پایان

تابع افزودن یادداشت():
    اگر پیش‌نویس.طول() برابر 0:
        برگشت
    پایان
    عنوان‌ها.بیفزا("" + پیش‌نویس)
    متن‌ها.بیفزا("")
    پیش‌نویس = ""
    صفحه.مسیر.برو("/note/" + (عنوان‌ها.طول() - 1))
پایان

بخش برگه یادداشت(جای: صحیح، نام: رشته):
    پیوند:
        مقصد = "/note/" + جای
        فاصله = 10، 14
        گردی = 10
        رنگ = "#d6d9e0"
        تزیین متن = "هیچ"
        اشاره:
            پس زمینه = "#2a2f3a"
        پایان
        اگر صفحه.مسیر.نشانی برابر "/note/" + جای:
            پس زمینه = "#3b4252"
            رنگ = "#ffffff"
        پایان
        محتوا = نام
    پایان
پایان

همگانی بخش یادداشت(شناسه: صحیح):
    جعبه:
        شکاف = 14
        بیشینه عرض = 720
        اگر شناسه کوچکتر عنوان‌ها.طول():
            سرتیتر:
                اندازه = 1
                محتوا = عنوان‌ها[شناسه]
            پایان
            ورودی:
                شناسه = "body"
                عرض = 100%
                فاصله = 14
                گردی = 12
                کادر = 1، "توپر"، "#cfd4dd"
                اندازه قلم = 16
                ارتفاع خط = 1.6
                پیوند = متن‌ها[شناسه]
            پایان
            جعبه:
                چیدمان = "ردیف"
                تراز = "وسط"
                چینش = "میان"
                پاراگراف:
                    شفافیت = 0.6
                    محتوا = "هنگام نوشتن ذخیره می‌شود"
                پایان
                دکمه:
                    شناسه = "clear"
                    فاصله = 8، 14
                    گردی = 10
                    پس زمینه = "#e9ebf2"
                    کلیک = ():
                        متن‌ها[شناسه] = ""
                    پایان
                    محتوا = "پاک کردن"
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین یادداشتی نیست"
            پایان
        پایان
    پایان
پایان

صفحه:
    حالت = "هش"
    عنوان = "یادداشت‌ها"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, system-ui, sans-serif"
    جعبه:
        چیدمان = "ردیف"
        کمینه ارتفاع = 100vh
        پس زمینه = "#f5f6f8"
        رنگ = "#1d2230"
        اگر تیره:
            پس زمینه = "#12151c"
            رنگ = "#e8eaf0"
        پایان
        ناوبری:
            عرض = 240
            فاصله = 20، 12
            شکاف = 6
            پس زمینه = "#1b1f27"
            پیوند:
                مقصد = "/"
                فاصله = 6، 14
                اندازه قلم = 20
                وزن قلم = 800
                رنگ = "#ffffff"
                تزیین متن = "هیچ"
                محتوا = "یادداشت"
            پایان
            پیوند:
                مقصد = "/new"
                فضا = 8، 0
                فاصله = 10، 14
                گردی = 10
                پس زمینه = "#5b6cff"
                رنگ = "#ffffff"
                تزیین متن = "هیچ"
                وزن قلم = 600
                محتوا = "+ یادداشت تازه"
            پایان
            هر شماره، متن در عنوان‌ها:
                برگه یادداشت:
                    جای = شماره
                    نام = متن
                پایان
            پایان
            پیوند:
                مقصد = "/settings"
                فضا = 16، 0، 0، 0
                فاصله = 10، 14
                رنگ = "#9aa1ad"
                تزیین متن = "هیچ"
                محتوا = "تنظیمات"
            پایان
        پایان
        اصلی:
            رشد = 1
            فاصله = 36، 40
            نمای مسیر: پایان
        پایان
    پایان
پایان
