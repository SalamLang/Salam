همگانی بخش خوش‌آمد:
    عنوان = "یادداشت‌ها"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "یادداشت‌ها"
        پایان
        پاراگراف:
            شفافیت = 0.7
            محتوا = "یک یادداشت را از کنار انتخاب کنید یا یکی تازه بنویسید."
        پایان
    پایان
پایان
