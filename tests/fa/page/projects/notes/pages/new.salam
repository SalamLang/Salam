همگانی بخش یادداشت تازه:
    عنوان = "یادداشت تازه"
    جعبه:
        شکاف = 14
        بیشینه عرض = 520
        سرتیتر:
            اندازه = 1
            محتوا = "یادداشت تازه"
        پایان
        ورودی:
            شناسه = "draft"
            فاصله = 12، 14
            گردی = 12
            کادر = 1، توپر، #cfd4dd
            جانگهدار = "عنوان"
            پیوند = پیش‌نویس
        پایان
        دکمه:
            شناسه = "create"
            فاصله = 12، 18
            گردی = 12
            پس زمینه = #5b6cff
            رنگ = #ffffff
            وزن قلم = 600
            کلیک = افزودن یادداشت
            محتوا = "ساختن"
        پایان
    پایان
پایان
