همگانی بخش خانه روز(روز انتخابی: صحیح):
    دکمه:
        کلاس = "day"
        ارتفاع = 56
        گردی = 10
        کادر = (انتخاب برابر روز انتخابی) ? 2 : 1، "توپر"، (انتخاب برابر روز انتخابی) ? "#2d3a8c" : "#d6dbe8"
        پس زمینه = (انتخاب برابر روز انتخابی) ? "#e6eaff" : "#ffffff"
        نشانگر = "اشاره"
        فشرده‌شده دسترسی‌پذیری = (انتخاب برابر روز انتخابی)
        کلیک = (): انتخاب = روز انتخابی پایان
        تکه:
            وزن قلم = 600
            محتوا = روز انتخابی
        پایان
        اگر رویدادهای روز(روز انتخابی) بزرگتر 0:
            تکه:
                کلاس = "dot"
                اندازه قلم = 11
                رنگ = "#2d3a8c"
                محتوا = رویدادهای روز(روز انتخابی) + " رویداد"
            پایان
        پایان
    پایان
پایان
