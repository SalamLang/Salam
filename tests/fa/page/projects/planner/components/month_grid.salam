 *
 */
همگانی بخش جدول ماه:
    جعبه:
        شکاف = 10
        جعبه:
            چیدمان = "row"
            تراز = "center"
            چینش = "between"
            دکمه:
                شناسه = "prev"
                فاصله = 6، 12
                گردی = 8
                نشانگر = "pointer"
                برچسب دسترسی‌پذیری = "ماه قبل"
                کلیک = (): تغییر ماه(-1) پایان
                محتوا = "<"
            پایان
            سرتیتر:
                شناسه = "month-title"
                اندازه = 2
                فضا = 0
                محتوا = نام ماه(ماه جاری) + " " + سال جاری
            پایان
            دکمه:
                شناسه = "next"
                فاصله = 6، 12
                گردی = 8
                نشانگر = "pointer"
                برچسب دسترسی‌پذیری = "ماه بعد"
                کلیک = (): تغییر ماه(1) پایان
                محتوا = ">"
            پایان
        پایان
        جعبه:
            چیدمان = "grid"
            چندستونی = 7
            شکاف = 6
            هر شماره، هفته‌روز در روزها:
                تکه:
                    کلید = شماره
                    کلاس = "weekday"
                    ترازمتن = «وسط»
                    اندازه قلم = 13
                    شفافیت = 0.6
                    محتوا = نام روز هفته(هفته‌روز)
                پایان
            پایان
            هر شماره، _ در جاهای خالی():
                تکه:
                    کلید = شماره
                پایان
            پایان
            هر _، کلید در فهرست روزها():
                خانه روز:
                    روز انتخابی = کلید
                پایان
            پایان
        پایان
    پایان
پایان
