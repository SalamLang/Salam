// انتظار: var __salam_rt_hash = true
// انتظار: برنامه‌ریز
// انتظار نه: <meta name="salam-router"
واردسازی دام

پایا روزها := [0، 1، 2، 3، 4، 5، 6]

ناپایا سال جاری := 2026
ناپایا ماه جاری := 11
ناپایا انتخاب := 15
ناپایا روز رویدادها := بارگذاری روزها()
ناپایا ماه رویدادها := بارگذاری ماه رویدادها()
ناپایا سال رویدادها := بارگذاری سال رویدادها()
ناپایا عنوان رویدادها := بارگذاری عنوان‌ها()
ناپایا ساعت رویدادها := بارگذاری ساعت‌ها()
ناپایا متن عنوان := ""
ناپایا متن ساعت := ""
ناپایا مشکل := ""

تابع رکوردها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    خام := دام.دریافت متن ذخیره("planner.events")
    اگر خام.طول() برابر 0:
        خروجی.افزودن("2026\t11\t3\t09:30\tدندان‌پزشکی")
        خروجی.افزودن("2026\t11\t15\t12:30\tناهار تیم")
        خروجی.افزودن("2026\t11\t15\t18:00\tتماس با مادر")
        خروجی.افزودن("2026\t11\t28\t08:00\tموعد اجاره")
        خروجی.افزودن("2026\t12\t24\t19:00\tشام خانوادگی")
        برگشت خروجی
    پایان
    تکه‌ها := خام.بشکاف("\n")
    تکرار تکه‌ها.طول() در شماره:
        اگر تکه‌ها.بگیر(شماره).طول() بزرگتر 8:
            خروجی.افزودن(تکه‌ها.بگیر(شماره))
        پایان
    پایان
    برگشت خروجی
پایان

تابع خانه(خط: رشته، جای: صحیح): رشته:
    برگشت خط.بشکاف("\t").بگیر(جای)
پایان

تابع بارگذاری سال رویدادها(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(خانه(سطرها.بگیر(شماره)، 0).به صحیح())
    پایان
    برگشت خروجی
پایان

تابع بارگذاری ماه رویدادها(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(خانه(سطرها.بگیر(شماره)، 1).به صحیح())
    پایان
    برگشت خروجی
پایان

تابع بارگذاری روزها(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(خانه(سطرها.بگیر(شماره)، 2).به صحیح())
    پایان
    برگشت خروجی
پایان

تابع بارگذاری ساعت‌ها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(خانه(سطرها.بگیر(شماره)، 3))
    پایان
    برگشت خروجی
پایان

تابع بارگذاری عنوان‌ها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(خانه(سطرها.بگیر(شماره)، 4))
    پایان
    برگشت خروجی
پایان

تابع ذخیره():
    ناپایا خروجی := ""
    تکرار روز رویدادها.طول() در شماره:
        خروجی += سال رویدادها.بگیر(شماره) + "\t" + ماه رویدادها.بگیر(شماره) + "\t" + روز رویدادها.بگیر(شماره) + "\t" + ساعت رویدادها.بگیر(شماره) + "\t" + عنوان رویدادها.بگیر(شماره) + "\n"
    پایان
    دام.تنظیم متن ذخیره("planner.events"، خروجی)
پایان

تابع کبیسه است(سال: صحیح): منطقی:
    برگشت (سال % 4 برابر 0 و سال % 100 نابرابر 0) یا سال % 400 برابر 0
پایان

تابع روزهای ماه(سال: صحیح، ماه: صحیح): صحیح:
    اگر ماه برابر 2:
        برگشت کبیسه است(سال) ? 29 : 28
    پایان
    اگر ماه برابر 4 یا ماه برابر 6 یا ماه برابر 9 یا ماه برابر 11:
        برگشت 30
    پایان
    برگشت 31
پایان

تابع روز هفته(سال: صحیح، ماه: صحیح، روز: صحیح): صحیح:
    ناپایا سال تعدیل := سال
    اگر ماه کوچکتر 3:
        سال تعدیل = سال - 1
    پایان
    ت := "032503514624".زیررشته(ماه - 1، 1).به صحیح()
    برگشت (سال تعدیل + سال تعدیل / 4 - سال تعدیل / 100 + سال تعدیل / 400 + ت + روز) % 7
پایان

تابع جاهای خالی ابتدا(): صحیح:
    برگشت (روز هفته(سال جاری، ماه جاری، 1) + 6) % 7
پایان

تابع جاهای خالی(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    تکرار جاهای خالی ابتدا() در شماره:
        خروجی.افزودن(شماره)
    پایان
    برگشت خروجی
پایان

تابع فهرست روزها(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    تکرار روزهای ماه(سال جاری، ماه جاری) در شماره:
        خروجی.افزودن(شماره + 1)
    پایان
    برگشت خروجی
پایان

تابع نام ماه(ماه: صحیح): رشته:
    اگر ماه برابر 1:
        برگشت "ژانویه"
    وگرنه ماه برابر 2:
        برگشت "فوریه"
    وگرنه ماه برابر 3:
        برگشت "مارس"
    وگرنه ماه برابر 4:
        برگشت "آوریل"
    وگرنه ماه برابر 5:
        برگشت "مه"
    وگرنه ماه برابر 6:
        برگشت "ژوئن"
    وگرنه ماه برابر 7:
        برگشت "ژوئیه"
    وگرنه ماه برابر 8:
        برگشت "اوت"
    وگرنه ماه برابر 9:
        برگشت "سپتامبر"
    وگرنه ماه برابر 10:
        برگشت "اکتبر"
    وگرنه ماه برابر 11:
        برگشت "نوامبر"
    پایان
    برگشت "دسامبر"
پایان

تابع نام روز هفته(هفته‌روز: صحیح): رشته:
    اگر هفته‌روز برابر 0:
        برگشت "شنبه"
    وگرنه هفته‌روز برابر 1:
        برگشت "یکشنبه"
    وگرنه هفته‌روز برابر 2:
        برگشت "دوشنبه"
    وگرنه هفته‌روز برابر 3:
        برگشت "سه‌شنبه"
    وگرنه هفته‌روز برابر 4:
        برگشت "چهارشنبه"
    وگرنه هفته‌روز برابر 5:
        برگشت "پنجشنبه"
    پایان
    برگشت "جمعه"
پایان

تابع رویدادهای روز(روز: صحیح): صحیح:
    ناپایا عدد := 0
    تکرار روز رویدادها.طول() در شماره:
        اگر روز رویدادها.بگیر(شماره) برابر روز و ماه رویدادها.بگیر(شماره) برابر ماه جاری و سال رویدادها.بگیر(شماره) برابر سال جاری:
            عدد++
        پایان
    پایان
    برگشت عدد
پایان

تابع تغییر ماه(گام: صحیح):
    ناپایا ماه := ماه جاری + گام
    ناپایا سال := سال جاری
    اگر ماه کوچکتر 1:
        ماه = 12
        سال--
    پایان
    اگر ماه بزرگتر 12:
        ماه = 1
        سال++
    پایان
    ماه جاری = ماه
    سال جاری = سال
    انتخاب = 1
پایان

تابع افزودن رویداد():
    پاک‌شده := متن عنوان.پیراست()
    زمان := متن ساعت.پیراست()
    اگر پاک‌شده.طول() برابر 0:
        مشکل = "برای رویداد عنوان بنویسید"
        برگشت
    پایان
    اگر زمان.طول() نابرابر 5 یا زمان.زیررشته(2، 1) نابرابر ":":
        مشکل = "ساعت را به شکل ساعت:دقیقه بنویسید"
        برگشت
    پایان
    ساعت := زمان.زیررشته(0، 2).به صحیح()
    دقیقه := زمان.زیررشته(3، 5).به صحیح()
    اگر ساعت بزرگتر 23 یا دقیقه بزرگتر 59:
        مشکل = "چنین ساعتی وجود ندارد"
        برگشت
    پایان
    سال رویدادها.بیفزا(سال جاری)
    ماه رویدادها.بیفزا(ماه جاری)
    روز رویدادها.بیفزا(انتخاب)
    ساعت رویدادها.بیفزا(زمان)
    عنوان رویدادها.بیفزا(پاک‌شده)
    متن عنوان = ""
    متن ساعت = ""
    مشکل = ""
    ذخیره()
پایان

تابع حذف رویداد(شماره: صحیح):
    سال رویدادها.حذف‌در(شماره)
    ماه رویدادها.حذف‌در(شماره)
    روز رویدادها.حذف‌در(شماره)
    ساعت رویدادها.حذف‌در(شماره)
    عنوان رویدادها.حذف‌در(شماره)
    ذخیره()
پایان

تابع مهر زمانی(شماره: صحیح): صحیح:
    برگشت (سال رویدادها.بگیر(شماره) - 2020) * 100000000 + ماه رویدادها.بگیر(شماره) * 1000000 + روز رویدادها.بگیر(شماره) * 10000 + ساعت رویدادها.بگیر(شماره).زیررشته(0، 2).به صحیح() * 100 + ساعت رویدادها.بگیر(شماره).زیررشته(3، 5).به صحیح()
پایان

تابع ترتیب دستورکار(): وکتور<صحیح>:
    ناپایا ترتیب := وکتور {} برگردان وکتور<صحیح>
    تکرار روز رویدادها.طول() در شماره:
        ترتیب.افزودن(شماره)
    پایان
    تکرار ترتیب.طول() در الف:
        تکرار ترتیب.طول() - 1 - الف در ب:
            اگر مهر زمانی(ترتیب.دریافت(ب)) بزرگتر مهر زمانی(ترتیب.دریافت(ب + 1)):
                موقت := ترتیب.دریافت(ب)
                ترتیب.تنظیم(ب، ترتیب.دریافت(ب + 1))
                ترتیب.تنظیم(ب + 1، موقت)
            پایان
        پایان
    پایان
    برگشت ترتیب
پایان

همگانی بخش گزینه زبانه(راه: رشته، برچسب: رشته):
    پیوند:
        مقصد = "/" + راه
        فاصله = 6، 12
        گردی = 8
        رنگ = "#ffffff"
        تزیین متن = «هیچ»
        اگر صفحه.مسیر.نشانی برابر "/" + راه:
            پس زمینه = "#1f2a6b"
        پایان
        محتوا = برچسب
    پایان
پایان

همگانی بخش پنل روز:
    جعبه:
        شکاف = 10
        فاصله = 16
        گردی = 14
        پس زمینه = "#ffffff"
        سرتیتر:
            شناسه = "day-title"
            اندازه = 3
            فضا = 0
            محتوا = نام ماه(ماه جاری) + " " + انتخاب
        پایان
        اگر رویدادهای روز(انتخاب) برابر 0:
            پاراگراف:
                کلاس = "none"
                فضا = 0
                شفافیت = 0.6
                محتوا = "برنامه‌ای ثبت نشده است."
            پایان
        وگرنه:
            فهرست:
                فاصله = 0
                فضا = 0
                شکاف = 6
                هر شماره، _ در روز رویدادها:
                    اگر روز رویدادها.بگیر(شماره) برابر انتخاب و ماه رویدادها.بگیر(شماره) برابر ماه جاری و سال رویدادها.بگیر(شماره) برابر سال جاری:
                        مورد:
                            کلاس = "ev"
                            چیدمان = "row"
                            شکاف = 10
                            تکه:
                                وزن قلم = 700
                                محتوا = ساعت رویدادها.بگیر(شماره)
                            پایان
                            پیوند:
                                مقصد = "/event/" + شماره
                                رنگ = "#1d2433"
                                محتوا = عنوان رویدادها.بگیر(شماره)
                            پایان
                        پایان
                    پایان
                پایان
            پایان
        پایان
        فرم:
            شکاف = 8
            ارسال = (رخداد: صحیح۶۴):
                دام.جلوگیری پیش فرض(رخداد)
                افزودن رویداد()
            پایان
            جعبه:
                چیدمان = "row"
                شکاف = 8
                ورودی:
                    شناسه = "ev-title"
                    رشد = 1
                    فاصله = 8، 10
                    گردی = 8
                    کادر = 1، "solid"، "#d6dbe8"
                    جانگهدار = "عنوان رویداد"
                    برچسب دسترسی‌پذیری = "عنوان رویداد"
                    پیوند = متن عنوان
                پایان
                ورودی:
                    شناسه = "ev-time"
                    عرض = 80
                    فاصله = 8، 10
                    گردی = 8
                    کادر = 1، "solid"، "#d6dbe8"
                    جانگهدار = "ساعت:دقیقه"
                    برچسب دسترسی‌پذیری = "ساعت"
                    پیوند = متن ساعت
                پایان
                دکمه:
                    شناسه = "ev-add"
                    نوع = «ارسال»
                    فاصله = 0، 14
                    گردی = 8
                    کادر = 0
                    پس زمینه = "#2d3a8c"
                    رنگ = "#ffffff"
                    نشانگر = "pointer"
                    محتوا = "افزودن"
                پایان
            پایان
            اگر مشکل.طول() بزرگتر 0:
                پاراگراف:
                    شناسه = "problem"
                    فضا = 0
                    رنگ = "#b42318"
                    نقش = "alert"
                    محتوا = مشکل
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    حالت = "هش"
    عنوان = "برنامه‌ریز"
    زبان = "fa"
    قلم = "Vazirmatn, Tahoma, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = "#f4f6fb"
        رنگ = "#1d2433"
        سرصفحه:
            چیدمان = "row"
            تراز = "center"
            شکاف = 20
            فاصله = 14، 24
            پس زمینه = "#2d3a8c"
            رنگ = "#ffffff"
            تکه:
                اندازه قلم = 20
                وزن قلم = 800
                محتوا = "برنامه‌ریز"
            پایان
            ناوبری:
                چیدمان = "row"
                شکاف = 6
                گزینه زبانه:
                    راه = ""
                    برچسب = "ماه"
                پایان
                گزینه زبانه:
                    راه = "agenda"
                    برچسب = "دستورکار"
                پایان
            پایان
        پایان
        اصلی:
            بیشینه عرض = 860
            فضا = 0، "auto"
            فاصله = 20، 16
            شکاف = 16
            نمای مسیر: پایان
        پایان
    پایان
پایان
