همگانی بخش گمشده:
    عنوان = "پیدا نشد"
    سرتیتر:
        اندازه = 1
        محتوا = "این صفحه پیدا نشد"
    پایان
    پیوند:
        مقصد = "/"
        محتوا = "بازگشت به ماه"
    پایان
پایان
