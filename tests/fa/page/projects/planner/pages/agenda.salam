 *
 */
همگانی بخش دستورکار:
    عنوان = "دستورکار"
    سرتیتر:
        اندازه = 1
        فضا = 0
        محتوا = "دستورکار"
    پایان
    اگر روز رویدادها.طول() برابر 0:
        پاراگراف:
            کلاس = "empty"
            محتوا = "دستورکار شما خالی است."
        پایان
    وگرنه:
        فهرست:
            فاصله = 0
            فضا = 0
            شکاف = 6
            هر _، شماره در ترتیب دستورکار():
                مورد:
                    کلاس = "row"
                    چیدمان = "ردیف"
                    شکاف = 12
                    فاصله = 10، 14
                    گردی = 10
                    پس زمینه = "#ffffff"
                    تکه:
                        عرض = 120
                        محتوا = نام ماه(ماه رویدادها.بگیر(شماره)) + " " + روز رویدادها.بگیر(شماره)
                    پایان
                    تکه:
                        وزن قلم = 700
                        محتوا = ساعت رویدادها.بگیر(شماره)
                    پایان
                    پیوند:
                        مقصد = "/event/" + شماره
                        رنگ = "#1d2433"
                        محتوا = عنوان رویدادها.بگیر(شماره)
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
