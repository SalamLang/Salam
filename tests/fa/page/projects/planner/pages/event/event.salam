همگانی بخش برگه رویداد(کد: صحیح):
    مسیر = "/event/:کد"
    عنوان = "رویداد"
    جعبه:
        شکاف = 10
        فاصله = 18
        گردی = 14
        پس زمینه = "#ffffff"
        اگر کد کوچکتر روز رویدادها.طول():
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = عنوان رویدادها.بگیر(کد)
            پایان
            پاراگراف:
                شناسه = "when"
                فضا = 0
                محتوا = نام ماه(ماه رویدادها.بگیر(کد)) + " " + روز رویدادها.بگیر(کد) + ", " + سال رویدادها.بگیر(کد) + " ساعت " + ساعت رویدادها.بگیر(کد)
            پایان
            دکمه:
                شناسه = "remove"
                فاصله = 8، 14
                گردی = 10
                کادر = 0
                پس زمینه = "#fde7e4"
                رنگ = "#b42318"
                نشانگر = "اشاره"
                کلیک = ():
                    حذف رویداد(کد)
                    صفحه.مسیر.برو("/agenda")
                پایان
                محتوا = "حذف رویداد"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین رویدادی نیست"
            پایان
        پایان
        پیوند:
            مقصد = "/agenda"
            محتوا = "بازگشت به دستورکار"
        پایان
    پایان
پایان
