همگانی بخش ماه:
    عنوان = "ماه"
    جعبه:
        چیدمان = "row"
        شکاف = 16
        شکستن خط = درست
        جعبه:
            رشد = 2
            کمینه عرض = 320
            جدول ماه: پایان
        پایان
        جعبه:
            رشد = 1
            کمینه عرض = 260
            پنل روز: پایان
        پایان
    پایان
پایان
