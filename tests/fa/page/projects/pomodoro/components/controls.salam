// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش کنترل‌ها:
    جعبه:
        چیدمان = "ردیف"
        چینش = "وسط"
        شکاف = 10
        اگر اجراست:
            کنش:
                نام = "pause"
                برچسب = "توقف"
                اجرا = توقف زمان‌سنج
            پایان
        وگرنه:
            کنش:
                نام = "start"
                برچسب = (باقی برابر طول مرحله()) ? "شروع" : "ادامه"
                اجرا = شروع زمان‌سنج
            پایان
        پایان
        کنش:
            نام = "reset"
            برچسب = "از نو"
            اجرا = بازنشانی زمان‌سنج
        پایان
        کنش:
            نام = "skip"
            برچسب = "رد شدن"
            اجرا = رد کردن مرحله
        پایان
    پایان
پایان

بخش کنش(نام: رشته، برچسب: رشته، اجرا):
    دکمه:
        شناسه = نام
        فاصله = 10، 22
        گردی = 12
        کادر = 0
        پس زمینه = "#2a2320"
        رنگ = "#ffffff"
        وزن قلم = 600
        نشانگر = "اشاره"
        کلیک = اجرا
        محتوا = برچسب
    پایان
پایان
