همگانی بخش فیلد تمرکز(برچسب: رشته، راهنما: رشته):
    برچسب:
        شکاف = 4
        تکه:
            وزن قلم = 600
            محتوا = برچسب
        پایان
        ورودی:
            شناسه = "focus"
            فاصله = 10، 12
            گردی = 10
            کادر = 1، "توپر"، "#d9cfca"
            پیوند = متن تمرکز
        پایان
        تکه:
            اندازه قلم = 13
            شفافیت = 0.6
            محتوا = راهنما
        پایان
    پایان
پایان

همگانی بخش فیلد استراحت(برچسب: رشته، راهنما: رشته):
    برچسب:
        شکاف = 4
        تکه:
            وزن قلم = 600
            محتوا = برچسب
        پایان
        ورودی:
            شناسه = "break"
            فاصله = 10، 12
            گردی = 10
            کادر = 1، "توپر"، "#d9cfca"
            پیوند = متن استراحت
        پایان
        تکه:
            اندازه قلم = 13
            شفافیت = 0.6
            محتوا = راهنما
        پایان
    پایان
پایان
