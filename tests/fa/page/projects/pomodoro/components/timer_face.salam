همگانی بخش نمای زمان‌سنج:
    جعبه:
        شکاف = 6
        تراز = "وسط"
        فاصله = 28
        گردی = 24
        پس زمینه = "#ffffff"
        سایه = 0، 6، 24، "#2a232018"
        تکه:
            شناسه = "phase"
            اندازه قلم = 14
            وزن قلم = 700
            فاصله حروف = 2
            دگرگونی متن = «بزرگ»
            محتوا = استراحت است ? "استراحت" : "تمرکز"
        پایان
        تکه:
            شناسه = "clock"
            اندازه قلم = 72
            وزن قلم = 800
            ویژگی‌های قلم = "tnum"
            محتوا = متن ساعت(باقی)
        پایان
        پیشرفت:
            شناسه = "bar"
            عرض = 100%
            بیشینه = طول مرحله()
            مقدار = طول مرحله() - باقی
        پایان
    پایان
پایان
