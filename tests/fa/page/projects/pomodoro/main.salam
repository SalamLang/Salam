// انتظار: var __salam_rt_hash = true
// انتظار: پومودورو
// انتظار نه: <meta name="salam-router"
واردسازی دام

ناپایا دقیقه تمرکز := ذخیره‌شده("pomo.focus"، 25)
ناپایا دقیقه استراحت := ذخیره‌شده("pomo.break"، 5)
ناپایا متن تمرکز := "" + دقیقه تمرکز
ناپایا متن استراحت := "" + دقیقه استراحت
ناپایا پیام تنظیمات := ""
ناپایا استراحت است := نادرست
ناپایا اجراست := نادرست
ناپایا باقی := دقیقه تمرکز * 60
ناپایا شناسه زمان‌سنج := 0 برگردان صحیح۶۴
ناپایا نوع‌ها := بارگذاری نوع‌ها()
ناپایا دقیقه‌ها := بارگذاری دقیقه‌ها()

تابع ذخیره‌شده(کلید: رشته، پیش‌فرض: صحیح): صحیح:
    عدد := دام.دریافت متن ذخیره(کلید).به صحیح()
    برگشت عدد بزرگتر 0 ? عدد : پیش‌فرض
پایان

تابع رکوردها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    خام := دام.دریافت متن ذخیره("pomo.log")
    تکه‌ها := خام.بشکاف("\n")
    تکرار تکه‌ها.طول() در شماره:
        اگر تکه‌ها.بگیر(شماره).طول() بزرگتر 2:
            خروجی.افزودن(تکه‌ها.بگیر(شماره))
        پایان
    پایان
    برگشت خروجی
پایان

تابع بارگذاری نوع‌ها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(سطرها.بگیر(شماره).بشکاف("\t").بگیر(0))
    پایان
    برگشت خروجی
پایان

تابع بارگذاری دقیقه‌ها(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    سطرها := رکوردها()
    تکرار سطرها.طول() در شماره:
        خروجی.افزودن(سطرها.بگیر(شماره).بشکاف("\t").بگیر(1).به صحیح())
    پایان
    برگشت خروجی
پایان

تابع ذخیره تاریخچه():
    ناپایا خروجی := ""
    تکرار نوع‌ها.طول() در شماره:
        خروجی += نوع‌ها.بگیر(شماره) + "\t" + دقیقه‌ها.بگیر(شماره) + "\n"
    پایان
    دام.تنظیم متن ذخیره("pomo.log"، خروجی)
پایان

تابع دورقمی(عدد: صحیح): رشته:
    برگشت عدد کوچکتر 10 ? "0" + عدد : "" + عدد
پایان

تابع متن ساعت(ثانیه: صحیح): رشته:
    برگشت دورقمی(ثانیه / 60) + ":" + دورقمی(ثانیه % 60)
پایان

تابع طول مرحله(): صحیح:
    برگشت (استراحت است ? دقیقه استراحت : دقیقه تمرکز) * 60
پایان

تابع پایان_ مرحله():
    نوع‌ها.بیفزا(استراحت است ? "استراحت" : "تمرکز")
    دقیقه‌ها.بیفزا(استراحت است ? دقیقه استراحت : دقیقه تمرکز)
    ذخیره تاریخچه()
    استراحت است = وارونه استراحت است
    باقی = طول مرحله()
پایان

تابع تیک():
    اگر وارونه اجراست:
        برگشت
    پایان
    باقی--
    اگر باقی کوچکتربرابر 0:
        پایان_ مرحله()
    پایان
پایان

تابع شروع زمان‌سنج():
    اگر اجراست:
        برگشت
    پایان
    اجراست = درست
    شناسه زمان‌سنج = دام.تنظیم بازه((): تیک() پایان، 1000)
پایان

تابع توقف زمان‌سنج():
    اگر وارونه اجراست:
        برگشت
    پایان
    اجراست = نادرست
    دام.پاک کردن بازه(شناسه زمان‌سنج)
پایان

تابع بازنشانی زمان‌سنج():
    توقف زمان‌سنج()
    استراحت است = نادرست
    باقی = طول مرحله()
پایان

تابع رد کردن مرحله():
    استراحت است = وارونه استراحت است
    باقی = طول مرحله()
پایان

تابع ذخیره تنظیمات():
    ف := متن تمرکز.پیراست().به صحیح()
    ب := متن استراحت.پیراست().به صحیح()
    اگر ف کوچکتر 1 یا ف بزرگتر 90 یا ب کوچکتر 1 یا ب بزرگتر 30:
        پیام تنظیمات = "تمرکز ۱ تا ۹۰ دقیقه و استراحت ۱ تا ۳۰ دقیقه است"
        برگشت
    پایان
    دقیقه تمرکز = ف
    دقیقه استراحت = ب
    دام.تنظیم متن ذخیره("pomo.focus"، "" + ف)
    دام.تنظیم متن ذخیره("pomo.break"، "" + ب)
    اگر وارونه اجراست:
        باقی = طول مرحله()
    پایان
    پیام تنظیمات = "ذخیره شد"
پایان

تابع پاک کردن تاریخچه():
    نوع‌ها.پاک کردن()
    دقیقه‌ها.پاک کردن()
    ذخیره تاریخچه()
پایان

تابع جمع تمرکز(): صحیح:
    ناپایا عدد := 0
    تکرار نوع‌ها.طول() در شماره:
        اگر نوع‌ها.بگیر(شماره) برابر "تمرکز":
            عدد += دقیقه‌ها.بگیر(شماره)
        پایان
    پایان
    برگشت عدد
پایان

تابع شمار نشست‌های تمرکز(): صحیح:
    ناپایا عدد := 0
    تکرار نوع‌ها.طول() در شماره:
        اگر نوع‌ها.بگیر(شماره) برابر "تمرکز":
            عدد++
        پایان
    پایان
    برگشت عدد
پایان

همگانی بخش ردیف نشست(جای: صحیح):
    مورد:
        چیدمان = "ردیف"
        چینش = "میان"
        فاصله = 10، 14
        گردی = 10
        پس زمینه = "#ffffff"
        پیوند:
            مقصد = "/session/" + جای
            رنگ = "#2a2320"
            محتوا = "#" + (جای + 1) + " " + نوع‌ها.بگیر(جای)
        پایان
        تکه:
            محتوا = دقیقه‌ها.بگیر(جای) + " دقیقه"
        پایان
    پایان
پایان

صفحه:
    حالت = "هش"
    عنوان = "پومودورو"
    زبان = "fa"
    قلم = "Vazirmatn, Tahoma, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = استراحت است ? "#e8f3ee" : "#fbece8"
        رنگ = "#2a2320"
        نمای مسیر: پایان
    پایان
پایان
