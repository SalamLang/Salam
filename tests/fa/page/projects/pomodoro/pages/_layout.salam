همگانی بخش قاب:
    سرصفحه:
        چیدمان = "row"
        تراز = "center"
        چینش = "center"
        شکاف = 8
        فاصله = 16
        گزینه قاب:
            راه = ""
            برچسب = "زمان‌سنج"
        پایان
        گزینه قاب:
            راه = "history"
            برچسب = "تاریخچه"
        پایان
        گزینه قاب:
            راه = "settings"
            برچسب = "تنظیمات"
        پایان
    پایان
    جعبه:
        بیشینه عرض = 520
        فضا = 0، "auto"
        فاصله = 12، 16
        شکاف = 16
        نمای مسیر: پایان
    پایان
پایان

بخش گزینه قاب(راه: رشته، برچسب: رشته):
    پیوند:
        مقصد = "/" + راه
        فاصله = 8، 16
        گردی = 20
        تزیین متن = «هیچ»
        رنگ = "#2a2320"
        اگر صفحه.مسیر.نشانی برابر "/" + راه:
            پس زمینه = "#2a2320"
            رنگ = "#ffffff"
        پایان
        محتوا = برچسب
    پایان
پایان
