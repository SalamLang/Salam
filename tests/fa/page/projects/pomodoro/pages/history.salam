 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش تاریخچه:
    عنوان = "تاریخچه"
    سرتیتر:
        اندازه = 1
        فضا = 0
        محتوا = "تاریخچه"
    پایان
    پاراگراف:
        شناسه = "total"
        فضا = 0
        محتوا = جمع تمرکز() + " دقیقه تمرکز در " + شمار نشست‌های تمرکز() + " نشست"
    پایان
    اگر نوع‌ها.طول() برابر 0:
        پاراگراف:
            کلاس = "empty"
            شفافیت = 0.6
            محتوا = "هنوز نشستی نیست. یک دوره‌ی تمرکز را تمام کنید تا اینجا دیده شود."
        پایان
    وگرنه:
        فهرست:
            فاصله = 0
            فضا = 0
            شکاف = 6
            هر شماره، _ در نوع‌ها:
                ردیف نشست:
                    جای = شماره
                پایان
            پایان
        پایان
        دکمه:
            شناسه = "clear"
            فاصله = 8، 14
            گردی = 10
            کادر = 1، "توپر"، "#d9cfca"
            پس زمینه = "#ffffff"
            نشانگر = "اشاره"
            کلیک = پاک کردن تاریخچه
            محتوا = "پاک کردن تاریخچه"
        پایان
    پایان
پایان
