همگانی بخش خانه:
    عنوان = "زمان‌سنج"
    نمای زمان‌سنج: پایان
    کنترل‌ها: پایان
    پاراگراف:
        شناسه = "done"
        ترازمتن = «وسط»
        فضا = 0
        محتوا = شمار نشست‌های تمرکز() + " نشست تمرکز امروز"
    پایان
پایان
