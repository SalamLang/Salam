همگانی بخش نشست(عدد: صحیح):
    مسیر = "/session/:عدد"
    عنوان = "نشست"
    جعبه:
        شکاف = 8
        فاصله = 16
        گردی = 14
        پس زمینه = "#ffffff"
        اگر عدد کوچکتر نوع‌ها.طول():
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = "نشست " + (عدد + 1)
            پایان
            پاراگراف:
                شناسه = "detail"
                فضا = 0
                محتوا = نوع‌ها.بگیر(عدد) + ", " + دقیقه‌ها.بگیر(عدد) + " دقیقه"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین نشستی نیست"
            پایان
        پایان
        پیوند:
            مقصد = "/history"
            محتوا = "بازگشت به تاریخچه"
        پایان
    پایان
پایان
