واردسازی دام
همگانی بخش تنظیمات:
    عنوان = "تنظیمات"
    سرتیتر:
        اندازه = 1
        فضا = 0
        محتوا = "تنظیمات"
    پایان
    فرم:
        شکاف = 12
        ارسال = (رخداد: صحیح۶۴):
            دام.جلوگیری پیش فرض(رخداد)
            ذخیره تنظیمات()
        پایان
        فیلد تمرکز:
            برچسب = "دقیقه‌های تمرکز"
            راهنما = "بین ۱ تا ۹۰"
        پایان
        فیلد استراحت:
            برچسب = "دقیقه‌های استراحت"
            راهنما = "بین ۱ تا ۳۰"
        پایان
        دکمه:
            شناسه = "save"
            نوع = «ارسال»
            فاصله = 10، 18
            گردی = 10
            کادر = 0
            پس زمینه = "#2a2320"
            رنگ = "#ffffff"
            نشانگر = "pointer"
            محتوا = "ذخیره"
        پایان
        اگر پیام تنظیمات.طول() بزرگتر 0:
            پاراگراف:
                شناسه = "note"
                فضا = 0
                نقش = "status"
                محتوا = پیام تنظیمات
            پایان
        پایان
    پایان
پایان
