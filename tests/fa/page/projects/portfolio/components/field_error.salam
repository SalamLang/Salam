همگانی بخش خطای فیلد(پیام: رشته):
    اگر فرم‌ارسال‌شده و پیام.طول() بزرگتر 0:
        پاراگراف:
            کلاس = "error"
            فضا = 4، 0، 0، 0
            رنگ = #c0262d
            اندازه قلم = 14
            نقش = الیرت
            محتوا = پیام
        پایان
    پایان
پایان
