همگانی بخش پیوند‌ناوبری(هدف: رشته، برچسب: رشته):
    پیوند:
        مقصد = هدف
        فاصله = 8، 14
        گردی = 999
        رنگ = "#1b1d29"
        تزیین متن = "هیچ"
        اشاره:
            پس زمینه = "#eef0f7"
        پایان
        اگر مسیر جاری(هدف):
            پس زمینه = #eef0f7
            وزن قلم = 700
        پایان
        محتوا = برچسب
    پایان
پایان
