همگانی بخش نوار‌سایت:
    سرصفحه:
        چیدمان = ردیف
        تراز = وسط
        چینش = میان
        شکستن خط = درست
        شکاف = 12
        فاصله = 16، 24
        کادر پایین = 1، توپر، #e9eaf1
        پس زمینه = #ffffff
        پیوند:
            مقصد = "/"
            وزن قلم = 800
            اندازه قلم = 20
            رنگ = #1b1d29
            تزیین متن = هیچ
            محتوا = صاحب
        پایان
        ناوبری:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 8
            پیوند‌ناوبری:
                هدف = "/"
                برچسب = "کارها"
            پایان
            پیوند‌ناوبری:
                هدف = "/about"
                برچسب = "درباره"
            پایان
            پیوند:
                مقصد = "/contact"
                فاصله = 8، 16
                گردی = 999
                پس زمینه = #1b1d29
                رنگ = #ffffff
                تزیین متن = هیچ
                وزن قلم = 600
                محتوا = "تماس"
            پایان
        پایان
    پایان
پایان
