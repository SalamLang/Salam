همگانی بخش کارت‌کار(جا: صحیح):
    مقاله:
        گردی = 18
        پس زمینه = "#ffffff"
        کادر = 1، توپر، #e9eaf1
        سرریز = "پنهان"
        گذار = 180ms
        اشاره:
            جابه‌جایی = 0، -3
            سایه = 0، 14، 30، #1b1d2914
        پایان
        جعبه:
            ارتفاع = 120
            پس زمینه = کارها().بگیر(جا).رنگ کار
            تراز = "وسط"
            چینش = "وسط"
            رنگ = "#ffffff"
            اندازه قلم = 30
            وزن قلم = 800
            محتوا = کارها().بگیر(جا).عنوان
        پایان
        جعبه:
            فاصله = 16، 18
            شکاف = 4
            پاراگراف:
                فضا = 0
                رنگ = "#6b7080"
                اندازه قلم = 13
                محتوا = کارها().بگیر(جا).گونه + " / " + کارها().بگیر(جا).سال
            پایان
            پاراگراف:
                فضا = 0
                محتوا = کارها().بگیر(جا).چکیده
            پایان
            پیوند:
                مقصد = "/work/" + جا
                فضا = 8، 0، 0، 0
                رنگ = "#1b1d29"
                وزن قلم = 600
                محتوا = "دیدن پروژه"
            پایان
        پایان
    پایان
پایان
