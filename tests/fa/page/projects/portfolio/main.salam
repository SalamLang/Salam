// انتظار: <meta name="salam-router" content="history">
// انتظار: نیلوفر رادمهر
واردسازی دام

پایا صاحب := "نیلوفر رادمهر"
پایا کمینه‌پیام := 20

ناپایا نام فرستنده := ""
ناپایا رایانامه‌ی فرستنده := ""
ناپایا پیام فرستنده := ""
ناپایا فرم‌ارسال‌شده := نادرست

ساختار کار:
    همگانی عنوان: رشته
    همگانی گونه: رشته
    همگانی سال: صحیح
    همگانی رنگ کار: رشته
    همگانی چکیده: رشته
    همگانی داستان: رشته
پایان

تابع کارها(): وکتور<کار>:
    ناپایا و_ := وکتور {} برگردان وکتور<کار>
    و_.افزودن(کار {
        عنوان = "بندر"
        گونه = "برنامه‌ی موبایل"
        سال = 2026
        رنگ کار = "#2563eb"
        چکیده = "همراه جزر و مد و آب‌وهوا برای صاحبان قایق‌های کوچک."
        داستان = "بندر با یک برگه‌ی جدول چسبیده به دکل شروع شد. آن را به برنامه‌ای تبدیل کردم که جزر و مد بعدی، باد و فهرست کوتاهی از کارهای پیش از ترک اسکله را نشان می‌دهد. سخت‌ترین بخش کار، حذف قابلیت‌ها بود تا همه‌چیز در دسترس یک انگشت جا شود."
    })
    و_.افزودن(کار {
        عنوان = "کاغذراه"
        گونه = "وب‌سایت"
        سال = 2025
        رنگ کار = "#db2777"
        چکیده = "فروشگاه اینترنتی یک کارگاه خانوادگی لوازم‌التحریر."
        داستان = "کاغذراه دفترچه‌ها را در تعداد کم می‌فروشد، پس فروشگاه باید دست‌ساز به نظر می‌رسید و کند نمی‌بود. فهرست کالاها را در یک صفحه نگه داشتیم، توضیح هر کالا را با دست نوشتیم و موفقیت را با شمار کسانی سنجیدیم که برای دفترچه‌ی دوم برگشتند."
    })
    و_.افزودن(کار {
        عنوان = "قلم"
        گونه = "سامانه‌ی طراحی"
        سال = 2025
        رنگ کار = "#059669"
        چکیده = "مجموعه‌ی کوچکی از اجزا که چهار تیم از آن مشترکا استفاده می‌کنند."
        داستان = "قلم یازده جزء و یک صفحه قاعده است. چون چهار تیم چهار دکمه‌ی متفاوت می‌ساختند به وجود آمد. قاعده‌ها را با هم نوشتیم، عمدا مجموعه را کوچک نگه داشتیم و هر چیزی را که یک فصل کسی به کارش نبرد برداشتیم."
    })
    و_.افزودن(کار {
        عنوان = "فانوس"
        گونه = "داشبورد"
        سال = 2024
        رنگ کار = "#d97706"
        چکیده = "مصرف انرژی یک محله‌ی ۳۰۰ خانواری، یک‌نگاهی."
        داستان = "فانوس جدول بلند قرائت کنتورها را به یک عدد و یک رنگ تبدیل می‌کند. ساکنان گفتند فقط می‌خواهند بدانند این هفته از هفته‌ی قبل بهتر بوده یا نه، پس صفحه اول همین را می‌گوید."
    })
    برگشت و_
پایان

تابع شمار کارها(): صحیح:
    برگشت کارها().طول()
پایان

تابع خطای نام(): رشته:
    اگر نام فرستنده.پیراست().طول() برابر 0:
        برگشت "لطفا نامتان را بنویسید."
    پایان
    برگشت ""
پایان

تابع خطای رایانامه(): رشته:
    اگر وارونه رایانامه‌ی فرستنده.دربردارد("@") یا وارونه رایانامه‌ی فرستنده.دربردارد("."):
        برگشت "این شبیه نشانی رایانامه نیست."
    پایان
    برگشت ""
پایان

تابع خطای پیام(): رشته:
    اگر پیام فرستنده.پیراست().طول() کوچکتر کمینه‌پیام:
        برگشت "دست‌کم " + کمینه‌پیام + " نویسه بنویسید تا بدانم چطور کمک کنم."
    پایان
    برگشت ""
پایان

تابع فرم معتبر است(): منطقی:
    برگشت خطای نام().طول() برابر 0 و خطای رایانامه().طول() برابر 0 و خطای پیام().طول() برابر 0
پایان

تابع مسیر جاری(هدف: رشته): منطقی:
    برگشت صفحه.مسیر.نشانی برابر هدف
پایان

تابع فرستادن():
    فرم‌ارسال‌شده = درست
    اگر فرم معتبر است():
        صفحه.مسیر.برو("/thanks")
    پایان
پایان

تابع بازگشت به کارها():
    نام فرستنده = ""
    رایانامه‌ی فرستنده = ""
    پیام فرستنده = ""
    فرم‌ارسال‌شده = نادرست
    صفحه.مسیر.برو("/")
پایان

صفحه:
    عنوان = صاحب + "، طراح"
    زبان = "fa"
    پس زمینه = #fbfbfd
    رنگ = #1b1d29
    خانواده قلم = "Vazirmatn, Tahoma, sans-serif"
    ارتفاع خط = 1.6
    نوار‌سایت: پایان
    اصلی:
        بیشینه عرض = 960
        فضا = 0، خودکار
        فاصله = 32، 24
        نمای مسیر: پایان
    پایان
    پاورقی:
        فاصله = 32، 24
        ترازمتن = وسط
        رنگ = #6b7080
        اندازه قلم = 14
        محتوا = صاحب + "، از دی‌ماه پذیرای پروژه‌ی تازه است"
    پایان
پایان
