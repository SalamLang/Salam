همگانی بخش درباره:
    عنوان = "درباره‌ی " + صاحب
    جعبه:
        شکاف = 14
        بیشینه عرض = 640
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "درباره‌ی من"
        پایان
        پاراگراف:
            فضا = 0
            محتوا = "من نیلوفرم، طراحی که کد هم می‌نویسد. ده سال است با تیم‌های کوچکی کار می‌کنم که می‌خواهند نرم‌افزارشان آرام و روشن باشد."
        پایان
        پاراگراف:
            فضا = 0
            محتوا = "پروژه‌هایی را دوست دارم که آن سوی صفحه آدم واقعی دارد: صاحب یک قایق، یک لوازم‌التحریری، همسایه‌ای که قبض برقش را می‌خواند."
        پایان
        پیوند:
            مقصد = "/contact"
            رنگ = "#4f46e5"
            وزن قلم = 600
            محتوا = "از پروژه‌تان بگویید"
        پایان
    پایان
پایان
