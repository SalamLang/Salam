// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش تماس:
    عنوان = "تماس"
    جعبه:
        شکاف = 16
        بیشینه عرض = 520
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "گپ بزنیم"
        پایان
        فرم:
            بدون اعتبارسنجی = درست
            شکاف = 14
            ارسال = (ی: صحیح۶۴):
                دام.جلوگیری پیش فرض(ی)
                فرستادن()
            پایان
            جعبه:
                برچسب:
                    برای = "name"
                    وزن قلم = 600
                    محتوا = "نام شما"
                پایان
                ورودی:
                    شناسه = "name"
                    عرض = 100%
                    فاصله = 11، 14
                    گردی = 10
                    کادر = 1، توپر، #cfd2de
                    اندازه قلم = 16
                    تکمیل خودکار = "نام"
                    پیوند = نام فرستنده
                پایان
                خطای‌فیلد:
                    پیام = خطای نام()
                پایان
            پایان
            جعبه:
                برچسب:
                    برای = "email"
                    وزن قلم = 600
                    محتوا = "رایانامه"
                پایان
                ورودی:
                    شناسه = "email"
                    نوع = "ایمیل"
                    عرض = 100%
                    فاصله = 11، 14
                    گردی = 10
                    کادر = 1، توپر، #cfd2de
                    اندازه قلم = 16
                    تکمیل خودکار = "رایانامه"
                    پیوند = رایانامه‌ی فرستنده
                پایان
                خطای‌فیلد:
                    پیام = خطای رایانامه()
                پایان
            پایان
            جعبه:
                برچسب:
                    برای = "message"
                    وزن قلم = 600
                    محتوا = "روی چه کاری کار می‌کنید؟"
                پایان
                متن بلند:
                    شناسه = "message"
                    عرض = 100%
                    ردیف‌ها = 5
                    فاصله = 11، 14
                    گردی = 10
                    کادر = 1، توپر، #cfd2de
                    اندازه قلم = 16
                    پیوند = پیام فرستنده
                پایان
                پاراگراف:
                    فضا = 4، 0، 0، 0
                    رنگ = "#6b7080"
                    اندازه قلم = 13
                    محتوا = پیام فرستنده.پیراست().طول() + " از " + کمینه‌پیام + " نویسه"
                پایان
                خطای‌فیلد:
                    پیام = خطای پیام()
                پایان
            پایان
            دکمه:
                شناسه = "send"
                نوع = "ارسال"
                فاصله = 12، 20
                گردی = 12
                کادر = 0
                پس زمینه = "#4f46e5"
                رنگ = "#ffffff"
                وزن قلم = 600
                اندازه قلم = 16
                نشانگر = "اشاره"
                محتوا = "فرستادن پیام"
            پایان
        پایان
    پایان
پایان
