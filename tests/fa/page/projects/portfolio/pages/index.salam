همگانی بخش خانه:
    عنوان = صاحب + "، طراح"
    جعبه:
        شکاف = 28
        جعبه:
            شکاف = 10
            بیشینه عرض = 620
            پاراگراف:
                فضا = 0
                رنگ = "#4f46e5"
                وزن قلم = 700
                محتوا = "طراح محصول و برنامه‌نویس"
            پایان
            سرتیتر:
                اندازه = 1
                فضا = 0
                اندازه قلم = 44
                ارتفاع خط = 1.15
                محتوا = "نرم‌افزار آرام طراحی می‌کنم و خودم می‌سازمش."
            پایان
            پاراگراف:
                فضا = 0
                رنگ = "#4a4e60"
                اندازه قلم = 18
                محتوا = "چهار پروژه‌ی تازه، از یک برنامه‌ی جزر و مد تا یک سامانه‌ی طراحی. هر صفحه می‌گوید کار چطور انجام شد، نه فقط چه شکلی دارد."
            پایان
        پایان
        جعبه:
            چیدمان = "شبکه"
            چندستونی = repeat (fit، minmax(220px، 1fr))
            شکاف = 20
            هر ی، _ در کارها():
                کارت‌کار:
                    جا = ی
                پایان
            پایان
        پایان
    پایان
پایان
