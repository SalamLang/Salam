همگانی بخش سپاس:
    عنوان = "سپاس"
    جعبه:
        شکاف = 14
        بیشینه عرض = 520
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "سپاس، " + نام فرستنده.پیراست()
        پایان
        پاراگراف:
            فضا = 0
            محتوا = "پیامتان رسید. ظرف دو روز کاری پاسخ می‌دهم، به نشانی " + رایانامه‌ی فرستنده + "."
        پایان
        دکمه:
            شناسه = "again"
            فاصله = 10، 18
            گردی = 10
            کادر = 1، توپر، #cfd2de
            پس زمینه = #ffffff
            نشانگر = اشاره
            کلیک = بازگشت به کارها
            محتوا = "بازگشت به کارها"
        پایان
    پایان
پایان
