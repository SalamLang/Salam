همگانی بخش جزئیات‌کار(شناسه: صحیح):
    مسیر = "/work/:شناسه"
    جعبه:
        شکاف = 18
        بیشینه عرض = 720
        اگر شناسه کوچکتر شمار کارها():
            پیوند:
                مقصد = "/"
                رنگ = #4f46e5
                تزیین متن = هیچ
                محتوا = "همه‌ی کارها"
            پایان
            جعبه:
                ارتفاع = 200
                گردی = 18
                پس زمینه = کارها().بگیر(شناسه).رنگ کار
                تراز = وسط
                چینش = وسط
                رنگ = #ffffff
                اندازه قلم = 44
                وزن قلم = 800
                محتوا = کارها().بگیر(شناسه).عنوان
            پایان
            سرتیتر:
                اندازه = 1
                فضا = 0
                محتوا = کارها().بگیر(شناسه).عنوان
            پایان
            پاراگراف:
                فضا = 0
                رنگ = #6b7080
                محتوا = کارها().بگیر(شناسه).گونه + ", " + کارها().بگیر(شناسه).سال
            پایان
            پاراگراف:
                فضا = 0
                اندازه قلم = 18
                محتوا = کارها().بگیر(شناسه).داستان
            پایان
            جعبه:
                چیدمان = ردیف
                شکاف = 12
                اگر شناسه بزرگتر 0:
                    پیوند:
                        شناسه = "prev"
                        مقصد = "/work/" + (شناسه - 1)
                        رنگ = #1b1d29
                        محتوا = "قبلی: " + کارها().بگیر(شناسه - 1).عنوان
                    پایان
                پایان
                اگر شناسه + 1 کوچکتر شمار کارها():
                    پیوند:
                        شناسه = "next"
                        مقصد = "/work/" + (شناسه + 1)
                        رنگ = #1b1d29
                        محتوا = "بعدی: " + کارها().بگیر(شناسه + 1).عنوان
                    پایان
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین پروژه‌ای نیست"
            پایان
        پایان
    پایان
پایان
