همگانی بخش شمارش‌معکوس(مانده: صحیح، جمع: صحیح):
    جعبه:
        شکاف = 4
        جعبه:
            ارتفاع = 8
            گردی = 999
            پس زمینه = #e2e8f0
            سرریز = پنهان
            جعبه:
                کلاس = "countdown-fill"
                ارتفاع = 100%
                عرض = (مانده * 100 / جمع) + "%"
                پس زمینه = #4f46e5
                اگر مانده کوچکتربرابر 4:
                    پس زمینه = #dc2626
                پایان
                گذار = 900ms، خطی
            پایان
        پایان
        ریز:
            شناسه = "seconds"
            شفافیت = 0.7
            محتوا = مانده + " ثانیه مانده"
        پایان
    پایان
پایان
