همگانی بخش نقطه‌ها(رسیده: صحیح):
    جعبه:
        چیدمان = ردیف
        شکاف = 6
        هر نقطه در پرسش‌ها:
            جعبه:
                کلاس = "dot"
                عرض = 12
                ارتفاع = 12
                گردی = 50%
                پس زمینه = #cbd5e1
                اگر نقطه کوچکتر رسیده:
                    پس زمینه = #4f46e5
                پایان
                اگر نقطه برابر رسیده:
                    پس زمینه = #f59e0b
                پایان
            پایان
        پایان
    پایان
پایان
