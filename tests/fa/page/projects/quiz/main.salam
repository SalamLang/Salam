واردسازی دام

پایا پرسش‌ها := [0، 1، 2، 3، 4، 5]
پایا مهلت := 12

ناپایا گزینش‌ها := گزینش‌تازه()
ناپایا پرسش‌کنونی := 0
ناپایا ثانیه‌مانده := مهلت
ناپایا زمان‌سنج := 0 برگردان صحیح۶۴
ناپایا درحال‌اجرا := نادرست
ناپایا بازیکن := ""

تابع گزینش‌تازه(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    تکرار 6:
        خروجی.افزودن(-1)
    پایان
    برگشت خروجی
پایان

ناب تابع متن‌پرسش(پرسشک: صحیح): رشته:
    اگر پرسشک برابر 0:
        برگشت "کدام عنصر بزرگ‌ترین سرتیتر است؟"
    وگرنه پرسشک برابر 1:
        برگشت "کدام ویژگی به تصویر متن جایگزین می‌دهد؟"
    وگرنه پرسشک برابر 2:
        برگشت "کدام رویداد با هر کلید در یک کادر رخ می‌دهد؟"
    وگرنه پرسشک برابر 3:
        برگشت "کدام مقدار چیدمان فرزندان را در یک خط می‌گذارد؟"
    وگرنه پرسشک برابر 4:
        برگشت "فایل مسیر پویا چه شکلی دارد؟"
    پایان
    برگشت "کدام فایل برای نشانی‌های ناشناخته صفحه نشان می‌دهد؟"
پایان

ناب تابع متن‌گزینه(پرسشک: صحیح، گزینک: صحیح): رشته:
    اگر پرسشک برابر 0:
        برگشت گزینک برابر 0 ? "h6" : (گزینک برابر 1 ? "h1" : (گزینک برابر 2 ? "header" : "title"))
    وگرنه پرسشک برابر 1:
        برگشت گزینک برابر 0 ? "src" : (گزینک برابر 1 ? "title" : (گزینک برابر 2 ? "alt" : "href"))
    وگرنه پرسشک برابر 2:
        برگشت گزینک برابر 0 ? "input" : (گزینک برابر 1 ? "load" : (گزینک برابر 2 ? "click" : "scroll"))
    وگرنه پرسشک برابر 3:
        برگشت گزینک برابر 0 ? "stack" : (گزینک برابر 1 ? "grid" : (گزینک برابر 2 ? "flow" : "row"))
    وگرنه پرسشک برابر 4:
        برگشت گزینک برابر 0 ? "route.salam" : (گزینک برابر 1 ? "[id].salam" : (گزینک برابر 2 ? "id.salam" : "dynamic.salam"))
    پایان
    برگشت گزینک برابر 0 ? "_404.salam" : (گزینک برابر 1 ? "missing.salam" : (گزینک برابر 2 ? "error.salam" : "index.salam"))
پایان

ناب تابع پاسخ‌درست(پرسشک: صحیح): صحیح:
    اگر پرسشک برابر 0:
        برگشت 1
    وگرنه پرسشک برابر 1:
        برگشت 2
    وگرنه پرسشک برابر 2:
        برگشت 0
    وگرنه پرسشک برابر 3:
        برگشت 3
    وگرنه پرسشک برابر 4:
        برگشت 1
    پایان
    برگشت 0
پایان

ناب تابع نشان‌گزینه(پرسشک: صحیح، گزینک: صحیح): صحیح:
    اگر گزینش‌ها[پرسشک] کوچکتر 0:
        برگشت 0
    پایان
    اگر گزینک برابر پاسخ‌درست(پرسشک):
        برگشت 1
    پایان
    اگر گزینک برابر گزینش‌ها[پرسشک]:
        برگشت 2
    پایان
    برگشت 0
پایان

ناب تابع امتیاز(): صحیح:
    ناپایا جمع := 0
    هر رسیده، برگزیده در گزینش‌ها:
        اگر برگزیده برابر پاسخ‌درست(رسیده):
            جمع++
        پایان
    پایان
    برگشت جمع
پایان

ناب تابع پاسخ‌داده‌شده(): صحیح:
    ناپایا جمع := 0
    هر برگزیده در گزینش‌ها:
        اگر برگزیده بزرگتربرابر 0:
            جمع++
        پایان
    پایان
    برگشت جمع
پایان

ناب تابع داوری(): رشته:
    امتیازها := امتیاز()
    اگر امتیازها برابر 6:
        برگشت "بی‌نقص"
    وگرنه امتیازها بزرگتربرابر 4:
        برگشت "آفرین"
    وگرنه امتیازها بزرگتربرابر 2:
        برگشت "در مسیر درست"
    پایان
    برگشت "تمرین کنید"
پایان

تابع ضربان():
    اگر ثانیه‌مانده بزرگتر 0:
        ثانیه‌مانده--
    پایان
    اگر ثانیه‌مانده برابر 0 و گزینش‌ها[پرسش‌کنونی] کوچکتر 0:
        گزینش‌ها[پرسش‌کنونی] = 9
    پایان
پایان

تابع توقف‌ساعت():
    اگر درحال‌اجرا:
        دام.پاک کردن بازه(زمان‌سنج)
        درحال‌اجرا = نادرست
    پایان
پایان

تابع شروع‌آزمون():
    گزینش‌ها = گزینش‌تازه()
    پرسش‌کنونی = 0
    ثانیه‌مانده = مهلت
    اگر وارونه درحال‌اجرا:
        زمان‌سنج = دام.تنظیم بازه((): ضربان() پایان، 1000)
        درحال‌اجرا = درست
    پایان
    صفحه.مسیر.برو("/quiz/0")
پایان

تابع برگزیدن(پرسشک: صحیح، گزینک: صحیح):
    اگر پرسشک بزرگتربرابر 0 و پرسشک کوچکتر 6 و گزینش‌ها[پرسشک] کوچکتر 0:
        گزینش‌ها[پرسشک] = گزینک
    پایان
پایان

تابع رفتن‌به‌بعدی(پرسشک: صحیح):
    اگر پرسشک + 1 بزرگتربرابر 6:
        توقف‌ساعت()
        صفحه.مسیر.برو("/results")
    وگرنه:
        پرسش‌کنونی = پرسشک + 1
        ثانیه‌مانده = مهلت
        صفحه.مسیر.برو("/quiz/" + (پرسشک + 1))
    پایان
پایان

تابع کلید‌آزمون(رویداد: صحیح۶۴):
    کلید := دام.کلید رویداد(رویداد)
    اگر کلید برابر "1":
        برگزیدن(پرسش‌کنونی، 0)
    وگرنه کلید برابر "2":
        برگزیدن(پرسش‌کنونی، 1)
    وگرنه کلید برابر "3":
        برگزیدن(پرسش‌کنونی، 2)
    وگرنه کلید برابر "4":
        برگزیدن(پرسش‌کنونی، 3)
    وگرنه کلید برابر "Enter" و گزینش‌ها[پرسش‌کنونی] بزرگتربرابر 0:
        رفتن‌به‌بعدی(پرسش‌کنونی)
    پایان
پایان

همگانی بخش گزینه(پرسشک: صحیح، گزینک: صحیح، برچسب: رشته، نشان: صحیح):
    دکمه:
        کلاس = "choice"
        عرض = پر
        فضا = 5، 0
        فاصله = 12، 16
        ترازمتن = ابتدا
        اندازه قلم = 16
        گردی = 10
        کادر = 1، توپر، #cbd5e1
        پس زمینه = #ffffff
        نشانگر = اشاره
        اشاره:
            پس زمینه = #eef2ff
        پایان
        اگر نشان برابر 1:
            پس زمینه = #dcfce7
            کادر = 1، توپر، #16a34a
        پایان
        اگر نشان برابر 2:
            پس زمینه = #fee2e2
            کادر = 1، توپر، #dc2626
        پایان
        کلیک = ():
            برگزیدن(پرسشک، گزینک)
        پایان
        محتوا = (گزینک + 1) + ". " + برچسب
    پایان
پایان

صفحه:
    عنوان = "آزمونک"
    زبان = "fa"
    خانواده قلم = "Tahoma, system-ui, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = #f1f5f9
        رنگ = #0f172a
        سرصفحه:
            چیدمان = ردیف
            تراز = وسط
            چینش = میان
            فاصله = 14، 24
            پس زمینه = #4f46e5
            پیوند:
                to = "/"
                اندازه قلم = 22
                وزن قلم = 800
                رنگ = #ffffff
                تزیین متن = هیچ
                محتوا = "آزمونک"
            پایان
            پاراگراف:
                شناسه = "status"
                فضا = 0
                رنگ = #e0e7ff
                محتوا = پاسخ‌داده‌شده() + " از ۶ پاسخ داده شد"
            پایان
        پایان
        اصلی:
            بیشینه عرض = 620
            عرض = 100%
            فضا = 0، خودکار
            فاصله = 24، 16
            نمای مسیر: پایان
        پایان
    پایان
پایان
