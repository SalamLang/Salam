همگانی بخش پیدانشد:
    جعبه:
        شکاف = 10
        سرتیتر:
            اندازه = 2
            محتوا = "صفحه پیدا نشد"
        پایان
        پاراگراف:
            محتوا = "اینجا چیزی نیست: " + صفحه.مسیر.نشانی
        پایان
        پیوند:
            to = "/"
            محتوا = "بازگشت به آغاز"
        پایان
    پایان
پایان
