همگانی بخش خوشامد:
    عنوان = "آزمونک"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "آزمون مبانی وب"
        پایان
        پاراگراف:
            فضا = 0
            محتوا = "شش پرسش، هر کدام " + مهلت + " ثانیه. برای پاسخ ۱ تا ۴ و برای پرسش بعدی Enter را بزنید."
        پایان
        برچسب:
            شکاف = 6
            تکه:
                محتوا = "نام شما"
            پایان
            ورودی:
                شناسه = "player"
                فاصله = 10، 14
                گردی = 10
                کادر = 1، "توپر"، "#cbd5e1"
                اندازه قلم = 16
                جانگهدار = "ناشناس"
                پیوند = بازیکن
            پایان
        پایان
        دکمه:
            شناسه = "start"
            فاصله = 12، 24
            گردی = 10
            کادر = 0
            پس زمینه = "#4f46e5"
            رنگ = "#ffffff"
            وزن قلم = 700
            نشانگر = "اشاره"
            کلیک = شروع‌آزمون
            محتوا = "شروع آزمون"
        پایان
    پایان
پایان
