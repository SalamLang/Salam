 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش پرسش(num: صحیح):
    عنوان = "پرسش " + (num + 1)
    جعبه:
        فشردن کلید = کلید‌آزمون
        ترتیب جهش = 0
        شناسه = "quiz-box"
        شکاف = 12
        اگر num بزرگتربرابر 0 و num کوچکتر 6:
            جعبه:
                چیدمان = "ردیف"
                تراز = "وسط"
                چینش = "میان"
                نقطه‌ها:
                    رسیده = num
                پایان
                ریز:
                    شناسه = "counter"
                    محتوا = "پرسش " + (num + 1) + " از ۶"
                پایان
            پایان
            اگر گزینش‌ها[num] کوچکتر 0 و num برابر پرسش‌کنونی:
                شمارش‌معکوس:
                    مانده = ثانیه‌مانده
                    جمع = مهلت
                پایان
            پایان
            سرتیتر:
                شناسه = "prompt"
                اندازه = 2
                فضا = 0
                محتوا = متن‌پرسش(num)
            پایان
            هر گزینک در [0، 1، 2، 3]:
                گزینه:
                    پرسشک = num
                    گزینک = گزینک
                    برچسب = متن‌گزینه(num، گزینک)
                    نشان = نشان‌گزینه(num، گزینک)
                پایان
            پایان
            اگر گزینش‌ها[num] بزرگتربرابر 0:
                پاراگراف:
                    شناسه = "feedback"
                    فضا = 0
                    وزن قلم = 600
                    محتوا = (گزینش‌ها[num] برابر 9) ? "زمان تمام شد. پاسخ درست نشان داده شده." : ((گزینش‌ها[num] برابر پاسخ‌درست(num)) ? "درست" : "نه کاملا")
                پایان
                دکمه:
                    شناسه = "next"
                    فاصله = 10، 22
                    گردی = 10
                    کادر = 0
                    پس زمینه = "#4f46e5"
                    رنگ = "#ffffff"
                    نشانگر = "اشاره"
                    کلیک = ():
                        رفتن‌به‌بعدی(num)
                    پایان
                    محتوا = (num برابر 5) ? "دیدن نتیجه" : "پرسش بعدی"
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 2
                محتوا = "چنین پرسشی نیست"
            پایان
            پیوند:
                to = "/"
                محتوا = "بازگشت به آغاز"
            پایان
        پایان
    پایان
پایان
