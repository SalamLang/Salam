// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش نتیجه‌ها:
    عنوان = "نتیجه‌ها"
    جعبه:
        شکاف = 12
        اگر پاسخ‌داده‌شده() کوچکتر 6:
            سرتیتر:
                اندازه = 2
                فضا = 0
                محتوا = "آزمون هنوز تمام نشده"
            پایان
            پیوند:
                to = "/"
                محتوا = "از نو شروع کنید"
            پایان
        وگرنه:
            سرتیتر:
                شناسه = "final"
                اندازه = 1
                فضا = 0
                محتوا = (بازیکن.طول() بزرگتر 0 ? بازیکن : "شما") + " امتیاز گرفت: " + امتیاز() + " از ۶"
            پایان
            پاراگراف:
                شناسه = "verdict"
                فضا = 0
                اندازه قلم = 20
                محتوا = داوری()
            پایان
            فهرست:
                فاصله = 0
                هر رسیده، برگزیده در گزینش‌ها:
                    مورد:
                        کلاس = "review"
                        فاصله = 8، 12
                        فضا = 4، 0
                        گردی = 8
                        پس زمینه = #ffffff
                        محتوا = (برگزیده برابر پاسخ‌درست(رسیده) ? "درست: " : "نادرست: ") + متن‌پرسش(رسیده)
                    پایان
                پایان
            پایان
            جعبه:
                چیدمان = ردیف
                شکاف = 10
                دکمه:
                    شناسه = "retry"
                    فاصله = 10، 22
                    گردی = 10
                    کادر = 0
                    پس زمینه = #4f46e5
                    رنگ = #ffffff
                    نشانگر = اشاره
                    کلیک = شروع‌آزمون
                    محتوا = "دوباره تلاش کنید"
                پایان
                پیوند:
                    to = "/"
                    فاصله = 10، 22
                    رنگ = #4f46e5
                    محتوا = "بازگشت به آغاز"
                پایان
            پایان
        پایان
    پایان
پایان
