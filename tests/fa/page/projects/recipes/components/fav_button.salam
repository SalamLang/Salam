همگانی بخش دکمه‌برگزیده(دستور: صحیح):
    دکمه:
        کلاس = "fav"
        فاصله = 4، 10
        گردی = 999
        کادر = 1، "توپر"، "#f0e4d2"
        پس زمینه = #00000000
        اندازه قلم = 18
        نشانگر = "اشاره"
        برچسب دسترسی‌پذیری = برگزیده‌بودن(دستور) ? "حذف از برگزیده‌ها" : "افزودن به برگزیده‌ها"
        اگر برگزیده‌بودن(دستور):
            پس زمینه = #fee2e2
            کادر = 1، "توپر"، "#fca5a5"
        پایان
        کلیک = (): تغییر‌برگزیده(دستور) پایان
        محتوا = برگزیده‌بودن(دستور) ? "♥" : "♡"
    پایان
پایان
