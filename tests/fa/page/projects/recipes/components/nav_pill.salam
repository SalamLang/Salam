همگانی بخش گزینه‌ناوبری(هدف: رشته، برچسب: رشته):
    پیوند:
        مقصد = هدف
        فاصله = 7، 14
        گردی = 999
        رنگ = "#3a2a1a"
        تزیین متن = "هیچ"
        اشاره:
            پس زمینه = "#fdebd3"
        پایان
        اگر مسیر جاری(هدف):
            پس زمینه = #fdebd3
            وزن قلم = 700
        پایان
        محتوا = برچسب
    پایان
پایان
