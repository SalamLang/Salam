همگانی بخش کارت‌دستور(دستور: صحیح):
    مقاله:
        فاصله = 18
        گردی = 16
        پس زمینه = #ffffff
        کادر = 1، توپر، #f0e4d2
        شکاف = 8
        گذار = 160ms
        اشاره:
            جابه‌جایی = 0، -2
            سایه = 0، 12، 26، #3a2a1a14
        پایان
        جعبه:
            چیدمان = ردیف
            چینش = میان
            تراز = وسط
            تکه:
                اندازه قلم = 40
                محتوا = دستور شکلک(دستور)
            پایان
            دکمه‌برگزیده:
                دستور = دستور
            پایان
        پایان
        h2:
            فضا = 0
            اندازه قلم = 20
            پیوند:
                مقصد = "/recipe/" + دستور
                رنگ = #3a2a1a
                تزیین متن = هیچ
                محتوا = دستور عنوان(دستور)
            پایان
        پایان
        پاراگراف:
            فضا = 0
            رنگ = #8a7358
            اندازه قلم = 14
            محتوا = دستور خط(دستور)
        پایان
    پایان
پایان
