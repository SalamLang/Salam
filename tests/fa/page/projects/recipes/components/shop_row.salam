همگانی بخش ردیف‌خرید(قلم: رشته):
    نگه‌داشته := قلم
    مورد:
        کلید = قلم
        چیدمان = "ردیف"
        تراز = "وسط"
        شکاف = 10
        فاصله = 10، 14
        گردی = 10
        پس زمینه = "#ffffff"
        کادر = 1، "توپر"، "#f0e4d2"
        دکمه:
            کلاس = "tick"
            کادر = 0
            پس زمینه = "#00000000"
            فاصله = 0
            اندازه قلم = 20
            نشانگر = "اشاره"
            نقش = "کهیککبوکس"
            aria checked = علامت‌دارد(قلم)
            برچسب دسترسی‌پذیری = قلم
            کلیک = (): تغییر‌علامت(نگه‌داشته) پایان
            محتوا = علامت‌دارد(قلم) ? "☑" : "☐"
        پایان
        تکه:
            رنگ = علامت‌دارد(قلم) ? "#b8a58a" : "#3a2a1a"
            تزیین متن = علامت‌دارد(قلم) ? "خط خورده" : "هیچ"
            محتوا = قلم
        پایان
    پایان
پایان
