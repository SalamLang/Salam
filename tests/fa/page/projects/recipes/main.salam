// انتظار: var __salam_rt_hash = true
// انتظار: انبارک
پایا نام‌برند := "انبارک"

ناپایا پرس‌ها := 4
ناپایا برگزیده‌ها := وکتور {} برگردان وکتور<صحیح>
ناپایا فهرست‌خرید := وکتور {} برگردان وکتور<رشته>
ناپایا علامت‌خورده‌ها := وکتور {} برگردان وکتور<رشته>

ساختار دستور:
    همگانی عنوان: رشته
    همگانی شکلک: رشته
    همگانی دقیقه: صحیح
    همگانی پرس‌پایه: صحیح
    همگانی مواد: رشته
    همگانی مراحل: رشته
پایان

تابع دستورها(): وکتور<دستور>:
    ناپایا و_ := وکتور {} برگردان وکتور<دستور>
    و_.افزودن(دستور {
        عنوان = "آش عدس"
        شکلک = "🍲"
        دقیقه = 35
        پرس‌پایه = 4
        مواد = "300|گرم|عدس قرمز\n2|عدد|هویج\n1|عدد|پیاز\n1.5|لیتر|آب\n2|قاشق|روغن زیتون"
        مراحل = "پیاز خرد شده را در روغن سرخ کنید.\nهویج و عدس را اضافه کنید.\nآب را بریزید و بیست دقیقه بگذارید بجوشد.\nنیمی را نرم کنید و خوب نمک و ادویه بزنید."
    })
    و_.افزودن(دستور {
        عنوان = "نان تابه‌ای"
        شکلک = "🫓"
        دقیقه = 45
        پرس‌پایه = 6
        مواد = "500|گرم|آرد\n300|میلی‌لیتر|آب ولرم\n1|قاشق چایخوری|نمک\n1|قاشق|خمیرمایه"
        مراحل = "همه‌چیز را به خمیر نرم تبدیل کنید.\nسی دقیقه استراحت بدهید.\nنازک باز کنید و در تابه‌ی داغ بپزید."
    })
    و_.افزودن(دستور {
        عنوان = "ماکارونی گوجه"
        شکلک = "🍝"
        دقیقه = 20
        پرس‌پایه = 2
        مواد = "200|گرم|اسپاگتی\n400|گرم|گوجه‌فرنگی\n2|حبه|سیر\n3|قاشق|روغن زیتون"
        مراحل = "ماکارونی را در آب نمک‌دار بپزید.\nسیر و گوجه را سس کنید.\nبا کمی آب ماکارونی به هم بزنید."
    })
    و_.افزودن(دستور {
        عنوان = "فرنی توت"
        شکلک = "🥣"
        دقیقه = 10
        پرس‌پایه = 1
        مواد = "50|گرم|بلغور جو\n250|میلی‌لیتر|شیر\n100|گرم|توت\n1|قاشق چایخوری|عسل"
        مراحل = "بلغور و شیر را گرم کنید تا غلیظ شود.\nروی آن توت و عسل بریزید."
    })
    برگشت و_
پایان

تابع دستور شکلک(جا: صحیح): رشته:
    برگشت دستورها().بگیر(جا).شکلک
پایان

تابع دستور عنوان(جا: صحیح): رشته:
    برگشت دستورها().بگیر(جا).عنوان
پایان

تابع دستور خط(جا: صحیح): رشته:
    ر := دستورها().بگیر(جا)
    برگشت ر.دقیقه + " دقیقه، برای " + ر.پرس‌پایه
پایان

تابع مسیر جاری(هدف: رشته): منطقی:
    برگشت صفحه.مسیر.نشانی برابر هدف
پایان

تابع جزء‌سطر(خط: رشته، جا: صحیح): رشته:
    برگشت خط.بشکاف("|").بگیر(جا)
پایان

تابع سطرهای‌مواد(شناسه: صحیح): وکتور<رشته>:
    برگشت دستورها().بگیر(شناسه).مواد.بشکاف("\n")
پایان

تابع سطرهای‌مراحل(شناسه: صحیح): وکتور<رشته>:
    برگشت دستورها().بگیر(شناسه).مراحل.بشکاف("\n")
پایان

تابع مقدار‌مقیاس‌شده(خط: رشته، شناسه: صحیح): اعشار۶۴:
    برگشت جزء‌سطر(خط، 0).به اعشار() * پرس‌ها / دستورها().بگیر(شناسه).پرس‌پایه
پایان

تابع نمایش‌عدد(ع: اعشار۶۴): رشته:
    دهم‌ها := (ع * 10 + 0.5) برگردان صحیح
    بخش‌صحیح := دهم‌ها / 10
    باقیمانده := دهم‌ها % 10
    اگر باقیمانده برابر 0:
        برگشت "" + بخش‌صحیح
    پایان
    برگشت بخش‌صحیح + "." + باقیمانده
پایان

تابع متن‌ماده(خط: رشته، شناسه: صحیح): رشته:
    برگشت نمایش‌عدد(مقدار‌مقیاس‌شده(خط، شناسه)) + " " + جزء‌سطر(خط، 1) + " " + جزء‌سطر(خط، 2)
پایان

تابع برگزیده‌بودن(شناسه: صحیح): منطقی:
    هر ف در برگزیده‌ها:
        اگر ف برابر شناسه:
            برگشت درست
        پایان
    پایان
    برگشت نادرست
پایان

تابع تغییر‌برگزیده(شناسه: صحیح):
    اگر برگزیده‌بودن(شناسه):
        ناپایا باقی‌مانده := وکتور {} برگردان وکتور<صحیح>
        هر ف در برگزیده‌ها:
            اگر ف نابرابر شناسه:
                باقی‌مانده.افزودن(ف)
            پایان
        پایان
        برگزیده‌ها = باقی‌مانده
    وگرنه:
        برگزیده‌ها.افزودن(شناسه)
    پایان
پایان

تابع پرس‌بیشتر():
    اگر پرس‌ها کوچکتر 12:
        پرس‌ها++
    پایان
پایان

تابع پرس‌کمتر():
    اگر پرس‌ها بزرگتر 1:
        پرس‌ها--
    پایان
پایان

تابع اضافه‌کردن‌خرید(شناسه: صحیح):
    هر خط در سطرهای‌مواد(شناسه):
        فهرست‌خرید.افزودن(متن‌ماده(خط، شناسه))
    پایان
پایان

تابع علامت‌دارد(کالا: رشته): منطقی:
    هر ت در علامت‌خورده‌ها:
        اگر ت برابر کالا:
            برگشت درست
        پایان
    پایان
    برگشت نادرست
پایان

تابع تغییر‌علامت(کالا: رشته):
    اگر علامت‌دارد(کالا):
        ناپایا باقی‌مانده := وکتور {} برگردان وکتور<رشته>
        هر ت در علامت‌خورده‌ها:
            اگر ت نابرابر کالا:
                باقی‌مانده.افزودن(ت)
            پایان
        پایان
        علامت‌خورده‌ها = باقی‌مانده
    وگرنه:
        علامت‌خورده‌ها.افزودن(کالا)
    پایان
پایان

تابع پاک‌کردن‌فهرست():
    فهرست‌خرید = وکتور {} برگردان وکتور<رشته>
    علامت‌خورده‌ها = وکتور {} برگردان وکتور<رشته>
پایان

صفحه:
    حالت = "هش"
    عنوان = نام‌برند
    زبان = "fa"
    پس زمینه = "#fffaf2"
    رنگ = "#3a2a1a"
    قلم = "Vazirmatn, Tahoma, sans-serif"
    ارتفاع خط = 1.55
    سرصفحه:
        چیدمان = "ردیف"
        تراز = "وسط"
        چینش = "میان"
        شکستن خط = درست
        شکاف = 10
        فاصله = 14، 24
        پس زمینه = "#ffffff"
        کادر پایین = 1، "توپر"، "#f0e4d2"
        پیوند:
            مقصد = "/"
            اندازه قلم = 22
            وزن قلم = 800
            رنگ = "#c2410c"
            تزیین متن = "هیچ"
            محتوا = نام‌برند
        پایان
        ناوبری:
            چیدمان = "ردیف"
            شکاف = 8
            گزینه‌ناوبری:
                هدف = "/"
                برچسب = "دستورها"
            پایان
            گزینه‌ناوبری:
                هدف = "/favourites"
                برچسب = "برگزیده‌ها (" + برگزیده‌ها.طول() + ")"
            پایان
            گزینه‌ناوبری:
                هدف = "/shopping"
                برچسب = "خرید (" + فهرست‌خرید.طول() + ")"
            پایان
        پایان
    پایان
    اصلی:
        بیشینه عرض = 900
        فضا = 0، "خودکار"
        فاصله = 28، 20
        نمای مسیر: پایان
    پایان
پایان
