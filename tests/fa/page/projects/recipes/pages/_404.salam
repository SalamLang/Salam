همگانی بخش پیدانشد:
    عنوان = "پیدا نشد"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "صفحه پیدا نشد"
        پایان
        پیوند:
            مقصد = "/"
            رنگ = "#c2410c"
            محتوا = "بازگشت به دستورها"
        پایان
    پایان
پایان
