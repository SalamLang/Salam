همگانی بخش صفحه‌برگزیده‌ها:
    عنوان = "برگزیده‌ها"
    جعبه:
        شکاف = 18
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "برگزیده‌های شما"
        پایان
        اگر برگزیده‌ها.طول() برابر 0:
            پاراگراف:
                شناسه = "no-favourites"
                رنگ = #8a7358
                محتوا = "هنوز چیزی نیست. روی قلب یک دستور بزنید تا نزدیک بماند."
            پایان
        وگرنه:
            جعبه:
                چیدمان = شبکه
                چندستونی = repeat (fit، minmax(240px، 1fr))
                شکاف = 16
                هر ف در برگزیده‌ها:
                    کارت‌دستور:
                        دستور = ف
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
