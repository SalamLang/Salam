همگانی بخش خانه:
    عنوان = نام‌برند
    جعبه:
        شکاف = 18
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "غذاهای روزهای هفته"
        پایان
        پاراگراف:
            فضا = 0
            رنگ = "#8a7358"
            محتوا = "یکی را برگزینید، تعداد پرس را بگویید و مقدارها خودشان تنظیم می‌شوند."
        پایان
        جعبه:
            چیدمان = "شبکه"
            چندستونی = repeat (fit، minmax(240px، 1fr))
            شکاف = 16
            هر ی، _ در دستورها():
                کارت‌دستور:
                    کلید = ی
                    دستور = ی
                پایان
            پایان
        پایان
    پایان
پایان
