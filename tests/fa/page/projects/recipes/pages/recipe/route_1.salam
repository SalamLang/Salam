همگانی بخش صفحه‌دستور(شناسه: صحیح):
    مسیر = "/recipe/:شناسه"
    جعبه:
        شکاف = 16
        اگر شناسه کوچکتر دستورها().طول():
            پیوند:
                مقصد = "/"
                رنگ = "#c2410c"
                تزیین متن = "هیچ"
                محتوا = "همه‌ی دستورها"
            پایان
            جعبه:
                چیدمان = "ردیف"
                تراز = "وسط"
                چینش = "میان"
                سرتیتر:
                    اندازه = 1
                    فضا = 0
                    محتوا = دستورها().بگیر(شناسه).شکلک + " " + دستورها().بگیر(شناسه).عنوان
                پایان
                دکمه‌برگزیده:
                    دستور = شناسه
                پایان
            پایان
            پاراگراف:
                فضا = 0
                رنگ = "#8a7358"
                محتوا = دستورها().بگیر(شناسه).دقیقه + " دقیقه. مقدارهای زیر برای " + پرس‌ها + " پرس است."
            پایان
            گام‌شمار: پایان
            h2:
                فضا = 8، 0، 0، 0
                اندازه قلم = 20
                محتوا = "مواد لازم"
            پایان
            فهرست:
                شناسه = "ingredients"
                فضا = 0
                هر شماره، خط در سطرهای‌مواد(شناسه):
                    مورد:
                        کلید = شماره
                        فاصله = 4، 0
                        محتوا = متن‌ماده(خط، شناسه)
                    پایان
                پایان
            پایان
            دکمه:
                شناسه = "to-shopping"
                فاصله = 10، 16
                گردی = 10
                کادر = 0
                پس زمینه = "#c2410c"
                رنگ = "#ffffff"
                وزن قلم = 600
                نشانگر = "اشاره"
                کلیک = (): اضافه‌کردن‌خرید(شناسه) پایان
                محتوا = "افزودن به فهرست خرید"
            پایان
            h2:
                فضا = 8، 0، 0، 0
                اندازه قلم = 20
                محتوا = "طرز تهیه"
            پایان
            فهرست شماره‌دار:
                فضا = 0
                هر شماره، س در سطرهای‌مراحل(شناسه):
                    مورد:
                        کلید = شماره
                        فاصله = 4، 0
                        محتوا = س
                    پایان
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = "چنین دستوری نیست"
            پایان
        پایان
    پایان
پایان
