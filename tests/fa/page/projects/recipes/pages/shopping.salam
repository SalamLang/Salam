// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش صفحه‌خرید:
    عنوان = "فهرست خرید"
    جعبه:
        شکاف = 16
        بیشینه عرض = 560
        سرتیتر:
            اندازه = 1
            فضا = 0
            محتوا = "فهرست خرید"
        پایان
        اگر فهرست‌خرید.طول() برابر 0:
            پاراگراف:
                شناسه = "empty-list"
                رنگ = "#8a7358"
                محتوا = "فهرست خالی است. مواد یک دستور را از صفحه‌ی آن اضافه کنید."
            پایان
        وگرنه:
            فهرست:
                شناسه = "shopping-items"
                فضا = 0
                فاصله = 0
                شکاف = 6
                هر س در فهرست‌خرید:
                    ردیف‌خرید:
                        قلم = س
                    پایان
                پایان
            پایان
            دکمه:
                شناسه = "clear"
                فاصله = 9، 16
                گردی = 10
                کادر = 1، توپر، #e4d3b8
                پس زمینه = "#ffffff"
                نشانگر = "اشاره"
                کلیک = پاک‌کردن‌فهرست
                محتوا = "پاک کردن فهرست"
            پایان
        پایان
    پایان
پایان
