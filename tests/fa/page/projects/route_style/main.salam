// انتظار: href="#b"
بخش پیوند‌ناوبری(راه: رشته، برچسب: رشته):
    پیوند:
        مقصد = راه
        محتوا = برچسب
        رنگ = "#333333"
        اگر صفحه.مسیر.نشانی برابر "/" + راه:
            رنگ = "#ff0000"
        پایان
    پایان
پایان

صفحه:
    حالت = "هش"
    ناوبری:
        پیوند‌ناوبری:
            راه = "a"
            برچسب = "الف"
        پایان
        پیوند‌ناوبری:
            راه = "b"
            برچسب = "ب"
        پایان
        پیوند‌ناوبری:
            راه = "c"
            برچسب = "ج"
        پایان
    پایان
    نمای مسیر: پایان
پایان
