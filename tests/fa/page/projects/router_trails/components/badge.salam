همگانی بخش نشان سختی(رده سختی: رشته):
    تکه:
        خود تراز = ابتدا
        فاصله = 2، 10
        گردی = 20
        اندازه قلم = 13
        وزن قلم = 600
        پس زمینه = #cfe8cf
        رنگ = #174d26
        اگر رده سختی برابر "متوسط":
            پس زمینه = #f5e3b3
            رنگ = #6a4b00
        پایان
        اگر رده سختی برابر "سخت":
            پس زمینه = #f2c9c3
            رنگ = #7a1f12
        پایان
        محتوا = رده سختی
    پایان
پایان
